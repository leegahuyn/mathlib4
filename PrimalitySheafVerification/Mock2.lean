/-- Empty-context closure of every Checklist 6.1 field.  The indiscrete
topology is chosen only to provide a canonical open-set category; the concrete
polynomial DGA and every algebraic law above remain unchanged. -/
theorem checklist_6_1_unconditional :
    @Section61ActualGradedDifferentialFormsCertificate
      PUnit (⊥ : TopologicalSpace PUnit) := by
  letI : TopologicalSpace PUnit := ⊥
  exact section61_actualGradedDifferentialForms_certificate PUnit

/-! ### §F.1.4b — Checklist 6.2: paper-faithful connection and curvature

Definitions 16 and 17 of the paper repeat the same local construction.  The
following namespace provides one core definition on the actual graded DGA of
§F.1.4a; the two paper-numbered namespaces below are aliases of this core.
-/

namespace PaperFaithfulConnection

open PolynomialMatrixDifferentialForms

/-- Model fiber of the paper's rank-two complex gauge bundle. -/
abbrev EqModelFiber : Type := Fin 2 → ℂ

/-- The structure Lie algebra `𝔤 = gl₂(ℂ)` used by the concrete model. -/
abbrev GaugeLieAlgebra : Type := Matrix (Fin 2) (Fin 2) ℂ

/-- The actual trivial rank-two complex vector-bundle family over `X`. -/
abbrev EqFamily (X : Type u) [TopologicalSpace X] : X → Type :=
  Bundle.Trivial X EqModelFiber

/-- Total space `E_q` of the rank-two complex vector bundle. -/
abbrev EqBundle (X : Type u) [TopologicalSpace X] : Type u :=
  Bundle.TotalSpace EqModelFiber (EqFamily X)

/-- The bundle projection `E_q → X`. -/
def EqProjection {X : Type u} [TopologicalSpace X] : EqBundle X → X :=
  Bundle.TotalSpace.proj

@[simp] theorem EqProjection_mk {X : Type u} [TopologicalSpace X]
    (x : X) (v : EqModelFiber) :
    EqProjection (X := X) ⟨x, v⟩ = x :=
  rfl

/-- Mathlib's genuine vector-bundle instance for `E_q`. -/
theorem Eq_isVectorBundle (X : Type u) [TopologicalSpace X] :
    VectorBundle ℂ EqModelFiber (EqFamily X) :=
  inferInstance

/-- A geometric local section of `E_q` over an open set. -/
abbrev GeometricSection {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : Type u :=
  ∀ x : U, EqFamily X x.1

/-- In a fixed polynomial local frame, bundle-valued homogeneous forms are
columns of scalar homogeneous forms.  Degree zero is the coordinate type of
local bundle sections. -/
abbrev BundleForm {X : Type u} [TopologicalSpace X]
    (n : ℕ) (_U : TopologicalSpace.Opens X) : Type :=
  Fin 2 → ChartForm n

abbrev LocalFramedSection {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : Type :=
  BundleForm 0 U

/-- Polynomial differential forms with values in `gl₂(ℂ)`. -/
abbrev GValuedPolynomialForm (X : Type u) [TopologicalSpace X]
    (n : ℕ) (U : TopologicalSpace.Opens X) : Type :=
  Omega X n U

/-- Evaluation of a polynomial frame-coordinate section gives an actual
section of `E_q` once a local complex coordinate is fixed. -/
def toGeometricSection {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (coordinate : X → ℂ)
    (s : LocalFramedSection U) : GeometricSection U :=
  fun x i => Polynomial.eval (coordinate x.1) (s i).c0

@[simp] theorem toGeometricSection_apply {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (coordinate : X → ℂ)
    (s : LocalFramedSection U) (x : U) (i : Fin 2) :
    toGeometricSection coordinate s x i =
      Polynomial.eval (coordinate x.1) (s i).c0 :=
  rfl

/-- An actual local bundle section together with its polynomial coordinates in
a chosen local frame.  The equality field prevents the geometric section and
its coordinate representative from drifting apart. -/
structure PolynomialBundleSection {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (coordinate : X → ℂ) where
  geometric : GeometricSection U
  coordinates : LocalFramedSection U
  geometric_eq_coordinates :
    geometric = toGeometricSection coordinate coordinates

namespace PolynomialBundleSection

/-- Canonical actual section represented by supplied polynomial coordinates. -/
def ofCoordinates {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (coordinate : X → ℂ)
    (s : LocalFramedSection U) : PolynomialBundleSection (U := U) coordinate where
  geometric := toGeometricSection coordinate s
  coordinates := s
  geometric_eq_coordinates := rfl

@[simp] theorem ofCoordinates_geometric
    {X : Type u} [TopologicalSpace X] {U : TopologicalSpace.Opens X}
    (coordinate : X → ℂ) (s : LocalFramedSection U) :
    (ofCoordinates coordinate s).geometric = toGeometricSection coordinate s :=
  rfl

@[simp] theorem ofCoordinates_coordinates
    {X : Type u} [TopologicalSpace X] {U : TopologicalSpace.Opens X}
    (coordinate : X → ℂ) (s : LocalFramedSection U) :
    (ofCoordinates coordinate s).coordinates = s :=
  rfl

end PolynomialBundleSection

/-- Exterior derivative of a bundle-valued form, component by component. -/
noncomputable def vectorDifferential {X : Type u} [TopologicalSpace X]
    {n : ℕ} {U : TopologicalSpace.Opens X}
    (s : BundleForm n U) : BundleForm (n + 1) U :=
  fun i => differential (s i)

/-- Matrix/exterior action on a bundle-valued form. -/
noncomputable def matrixVectorWedge {X : Type u} [TopologicalSpace X]
    {p q : ℕ} {U : TopologicalSpace.Opens X}
    (A : Omega X p U) (s : BundleForm q U) : BundleForm (p + q) U :=
  fun i => ∑ j : Fin 2, wedge (A i j) (s j)

@[simp] theorem vectorDifferential_apply
    {X : Type u} [TopologicalSpace X] {n : ℕ}
    {U : TopologicalSpace.Opens X} (s : BundleForm n U) (i : Fin 2) :
    vectorDifferential s i = differential (s i) :=
  rfl

@[simp] theorem matrixVectorWedge_apply
    {X : Type u} [TopologicalSpace X] {p q : ℕ}
    {U : TopologicalSpace.Opens X} (A : Omega X p U)
    (s : BundleForm q U) (i : Fin 2) :
    matrixVectorWedge A s i = ∑ j : Fin 2, wedge (A i j) (s j) :=
  rfl

@[simp] theorem vectorDifferential_zero
    {X : Type u} [TopologicalSpace X] (n : ℕ)
    (U : TopologicalSpace.Opens X) :
    vectorDifferential (0 : BundleForm n U) = 0 := by
  funext i
  exact differential_zero n

theorem vectorDifferential_add
    {X : Type u} [TopologicalSpace X] {n : ℕ}
    {U : TopologicalSpace.Opens X} (s t : BundleForm n U) :
    vectorDifferential (s + t) =
      vectorDifferential s + vectorDifferential t := by
  funext i
  exact differential_add (s i) (t i)

@[simp] theorem vectorDifferential_squared
    {X : Type u} [TopologicalSpace X] {n : ℕ}
    {U : TopologicalSpace.Opens X} (s : BundleForm n U) :
    vectorDifferential (vectorDifferential s) = 0 := by
  funext i
  exact differential_squared (s i)

theorem matrixVectorWedge_add_left
    {X : Type u} [TopologicalSpace X] {p q : ℕ}
    {U : TopologicalSpace.Opens X} (A B : Omega X p U)
    (s : BundleForm q U) :
    matrixVectorWedge (A + B) s =
      matrixVectorWedge A s + matrixVectorWedge B s := by
  funext i
  simp [matrixVectorWedge, Fin.sum_univ_two, wedge_add_left] <;> abel

theorem matrixVectorWedge_add_right
    {X : Type u} [TopologicalSpace X] {p q : ℕ}
    {U : TopologicalSpace.Opens X} (A : Omega X p U)
    (s t : BundleForm q U) :
    matrixVectorWedge A (s + t) =
      matrixVectorWedge A s + matrixVectorWedge A t := by
  funext i
  simp [matrixVectorWedge, Fin.sum_univ_two, wedge_add_right] <;> abel

@[simp] theorem matrixVectorWedge_zero_right
    {X : Type u} [TopologicalSpace X] {p q : ℕ}
    {U : TopologicalSpace.Opens X} (A : Omega X p U) :
    matrixVectorWedge A (0 : BundleForm q U) = 0 := by
  funext i
  simp [matrixVectorWedge]

theorem matrixVectorWedge_assoc
    {X : Type u} [TopologicalSpace X] {p q r : ℕ}
    {U : TopologicalSpace.Opens X} (A : Omega X p U)
    (B : Omega X q U) (s : BundleForm r U) :
    GradedForm.cast (fun n => BundleForm n U) (Nat.add_assoc p q r)
        (matrixVectorWedge (matrixWedge A B) s) =
      matrixVectorWedge A (matrixVectorWedge B s) := by
  funext i
  simp [matrixVectorWedge, matrixWedge, Fin.sum_univ_two,
    GradedForm.cast_add, wedge_add_left, wedge_add_right, wedge_assoc] <;> abel

theorem vectorGradedLeibniz
    {X : Type u} [TopologicalSpace X] {p q : ℕ}
    {U : TopologicalSpace.Opens X} (A : Omega X p U)
    (s : BundleForm q U) :
    vectorDifferential (matrixVectorWedge A s) =
      GradedForm.cast (fun n => BundleForm n U)
          (GradedForm.succ_add_degree p q)
          (matrixVectorWedge (matrixDifferential A) s) +
        ((-1 : ℤ) ^ p) •
          GradedForm.cast (fun n => BundleForm n U)
            (GradedForm.add_succ_degree p q)
            (matrixVectorWedge A (vectorDifferential s)) := by
  funext i
  simp [vectorDifferential, matrixVectorWedge, Fin.sum_univ_two,
    differential_add, graded_leibniz, GradedForm.cast_add, smul_add] <;> abel

/-- Degree-one Leibniz rule in the exact form used by `∇²`. -/
theorem vectorLeibniz_one_zero
    {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (A : Omega X 1 U)
    (s : BundleForm 0 U) :
    vectorDifferential (matrixVectorWedge A s) =
      matrixVectorWedge (matrixDifferential A) s -
        matrixVectorWedge A (vectorDifferential s) := by
  funext i
  apply ChartForm.ext <;>
    simp [vectorDifferential, matrixVectorWedge, Fin.sum_univ_two,
      differential_add, graded_leibniz, sub_eq_add_neg] <;> abel

/-- The single core connection object underlying both paper definitions. -/
structure Core {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) where
  potential : Omega X 1 U

namespace Core

variable {X : Type u} [TopologicalSpace X]
variable {U : TopologicalSpace.Opens X}

/-- `𝔤 = gl₂(ℂ)`-valued homogeneous forms in the polynomial local frame. -/
abbrev GValuedForm (n : ℕ) : Type := GValuedPolynomialForm X n U

/-- The paper's local connection operator `∇ = d + A` on bundle sections. -/
noncomputable def nabla (C : Core U) (s : LocalFramedSection U) : BundleForm 1 U :=
  vectorDifferential s + matrixVectorWedge C.potential s

/-- Additive-operator packaging of `∇`. -/
noncomputable def nablaHom (C : Core U) : LocalFramedSection U →+ BundleForm 1 U where
  toFun := C.nabla
  map_zero' := by
    simp [nabla]
  map_add' := by
    intro s t
    rw [nabla, nabla, nabla, vectorDifferential_add,
      matrixVectorWedge_add_right]
    abel

/-- The same connection operator with an actual geometric bundle section as
input; computation proceeds through the section's certified local frame
coordinates. -/
noncomputable def nablaBundleSection (C : Core U) (coordinate : X → ℂ)
    (s : PolynomialBundleSection (U := U) coordinate) : BundleForm 1 U :=
  C.nabla s.coordinates

@[simp] theorem nablaBundleSection_formula (C : Core U)
    (coordinate : X → ℂ)
    (s : PolynomialBundleSection (U := U) coordinate) :
    C.nablaBundleSection coordinate s =
      vectorDifferential s.coordinates +
        matrixVectorWedge C.potential s.coordinates :=
  rfl

/-- Extension of `∇` to bundle-valued one-forms, needed to define `∇²`. -/
noncomputable def nablaOne (C : Core U) (s : BundleForm 1 U) : BundleForm 2 U :=
  vectorDifferential s + matrixVectorWedge C.potential s

/-- Core curvature formula, with codomain definitionally the actual
`gl₂(ℂ)`-valued degree-two form carrier. -/
noncomputable def curvature (C : Core U) : GValuedForm (X := X) (U := U) 2 :=
  matrixDifferential C.potential + matrixWedge C.potential C.potential

/-- Curvature acts on a local section by matrix/exterior multiplication. -/
noncomputable def curvatureAction (C : Core U) (s : LocalFramedSection U) : BundleForm 2 U :=
  matrixVectorWedge C.curvature s

/-- The square of the connection on a bundle section. -/
noncomputable def nablaSquared (C : Core U) (s : LocalFramedSection U) : BundleForm 2 U :=
  C.nablaOne (C.nabla s)

@[simp] theorem nabla_apply (C : Core U) (s : LocalFramedSection U) :
    C.nabla s = vectorDifferential s + matrixVectorWedge C.potential s :=
  rfl

@[simp] theorem nablaOne_apply (C : Core U) (s : BundleForm 1 U) :
    C.nablaOne s =
      vectorDifferential s + matrixVectorWedge C.potential s :=
  rfl

@[simp] theorem curvature_formula (C : Core U) :
    C.curvature =
      matrixDifferential C.potential + matrixWedge C.potential C.potential :=
  rfl

set_option maxHeartbeats 800000 in
theorem potential_action_assoc (C : Core U) (s : LocalFramedSection U) :
    matrixVectorWedge C.potential (matrixVectorWedge C.potential s) =
      matrixVectorWedge (matrixWedge C.potential C.potential) s := by
  funext i
  apply ChartForm.ext <;>
    simp [matrixVectorWedge, matrixWedge, Fin.sum_univ_two,
      wedge_add_left, wedge_add_right] <;> ring

/-- Paper equation `(∇^(q))² = dA_q + A_q ∧ A_q`, stated as equality
of operators acting on an arbitrary local bundle section. -/
theorem nablaSquared_eq_curvatureAction
    (C : Core U) (s : LocalFramedSection U) :
    C.nablaSquared s = C.curvatureAction s := by
  change
    vectorDifferential
          (vectorDifferential s + matrixVectorWedge C.potential s) +
        matrixVectorWedge C.potential
          (vectorDifferential s + matrixVectorWedge C.potential s) =
      matrixVectorWedge
        (matrixDifferential C.potential +
          matrixWedge C.potential C.potential) s
  rw [vectorDifferential_add, vectorDifferential_squared,
    vectorLeibniz_one_zero, matrixVectorWedge_add_right,
    matrixVectorWedge_add_left, C.potential_action_assoc s]
  abel

theorem nablaSquared_operator_eq_curvatureAction (C : Core U) :
    C.nablaSquared = C.curvatureAction := by
  funext s
  exact C.nablaSquared_eq_curvatureAction s

/-- Restriction of the core connection. -/
noncomputable def restrict (C : Core U) {V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    Core V where
  potential := restrictHom hVU C.potential

@[simp] theorem restrict_potential (C : Core U)
    {V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    (C.restrict hVU).potential = restrictHom hVU C.potential :=
  rfl

theorem curvature_restrict (C : Core U)
    {V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    (C.restrict hVU).curvature = restrictHom hVU C.curvature := by
  rw [curvature_formula, curvature_formula, restrict_potential,
    restrict_add, restrict_matrixDifferential]
  exact congrArg
    (fun T => matrixDifferential (restrictHom hVU C.potential) + T)
    (restrict_matrixWedge hVU C.potential C.potential).symm

/-- The result is not merely an untyped matrix expression: every entry is an
actual homogeneous degree-two scalar differential form. -/
theorem curvature_entry_is_twoForm (C : Core U) (i j : Fin 2) :
    ∃ ω : ChartForm 2, C.curvature i j = ω :=
  ⟨C.curvature i j, rfl⟩

end Core

/-! #### Local-frame changes -/

variable {X : Type u} [TopologicalSpace X]
variable {U : TopologicalSpace.Opens X}

/-- Identity endomorphism as a degree-zero matrix-valued form. -/
noncomputable def identityZeroForm : Omega X 0 U :=
  zeroFormMatrix (1 : Matrix (Fin 2) (Fin 2) Coeff)

@[simp] theorem matrixWedge_identity_right {n : ℕ} (A : Omega X n U) :
    matrixWedge A (identityZeroForm (X := X) (U := U)) = A := by
  refine Matrix.ext fun i k => ?_
  apply ChartForm.ext <;>
    fin_cases i <;> fin_cases k <;>
      simp [identityZeroForm, zeroFormMatrix, matrixWedge,
        Fin.sum_univ_two, zeroFormCoefficient, wedge, Matrix.one_apply]

theorem matrixWedge_identity_left_cast {n : ℕ} (A : Omega X n U) :
    GradedForm.cast (fun d => Omega X d U) (Nat.zero_add n)
        (matrixWedge (identityZeroForm (X := X) (U := U)) A) = A := by
  refine Matrix.ext fun i k => ?_
  apply ChartForm.ext <;>
    fin_cases i <;> fin_cases k <;>
      simp [identityZeroForm, zeroFormMatrix, matrixWedge,
        Fin.sum_univ_two, zeroFormCoefficient, wedge, Matrix.one_apply]

@[simp] theorem matrixWedge_identity_left_zero (A : Omega X 0 U) :
    matrixWedge (identityZeroForm (X := X) (U := U)) A = A := by
  simpa using matrixWedge_identity_left_cast A

@[simp] theorem matrixWedge_identity_left_one (A : Omega X 1 U) :
    matrixWedge (identityZeroForm (X := X) (U := U)) A = A := by
  simpa using matrixWedge_identity_left_cast A

@[simp] theorem matrixWedge_identity_left_two (A : Omega X 2 U) :
    matrixWedge (identityZeroForm (X := X) (U := U)) A = A := by
  simpa using matrixWedge_identity_left_cast A

@[simp] theorem matrixDifferential_identityZeroForm :
    matrixDifferential (identityZeroForm (X := X) (U := U)) = 0 := by
  refine Matrix.ext fun i k => ?_
  apply ChartForm.ext <;>
    fin_cases i <;> fin_cases k <;>
      simp [identityZeroForm, zeroFormMatrix, matrixDifferential,
        zeroFormCoefficient, differential]

theorem matrixWedge_neg_left {p q : ℕ}
    (A : Omega X p U) (B : Omega X q U) :
    matrixWedge (-A) B = -matrixWedge A B := by
  refine Matrix.ext fun i k => ?_
  apply ChartForm.ext <;>
    simp [matrixWedge, Fin.sum_univ_two, wedge] <;> ring

theorem matrixWedge_neg_right {p q : ℕ}
    (A : Omega X p U) (B : Omega X q U) :
    matrixWedge A (-B) = -matrixWedge A B := by
  refine Matrix.ext fun i k => ?_
  apply ChartForm.ext <;>
    simp [matrixWedge, Fin.sum_univ_two, wedge] <;> ring

/-- Degree-zero/degree-one Leibniz rule without reassociation casts. -/
theorem matrixLeibniz_zero_one (g : Omega X 0 U) (A : Omega X 1 U) :
    matrixDifferential (matrixWedge g A) =
      matrixWedge (matrixDifferential g) A +
        matrixWedge g (matrixDifferential A) := by
  simpa using matrixGradedLeibniz g A

/-- Degree-one/degree-zero Leibniz rule with its required minus sign. -/
theorem matrixLeibniz_one_zero (A : Omega X 1 U) (g : Omega X 0 U) :
    matrixDifferential (matrixWedge A g) =
      matrixWedge (matrixDifferential A) g -
        matrixWedge A (matrixDifferential g) := by
  simpa [sub_eq_add_neg] using matrixGradedLeibniz A g

/-- An invertible change of local frame, represented inside the degree-zero
part of the actual graded DGA. -/
structure LocalFrameChange where
  forward : Omega X 0 U
  inverse : Omega X 0 U
  inverse_forward : matrixWedge inverse forward = identityZeroForm
  forward_inverse : matrixWedge forward inverse = identityZeroForm

namespace LocalFrameChange

/-- Identity local frame change. -/
noncomputable def identity : LocalFrameChange (X := X) (U := U) where
  forward := identityZeroForm
  inverse := identityZeroForm
  inverse_forward := matrixWedge_identity_right _
  forward_inverse := matrixWedge_identity_right _

/-- Matrix conjugation of a connection one-form. -/
noncomputable def conjugateOne (g : LocalFrameChange (X := X) (U := U))
    (A : Omega X 1 U) : Omega X 1 U :=
  matrixWedge (matrixWedge g.inverse A) g.forward

/-- Matrix conjugation of a curvature two-form. -/
noncomputable def conjugateTwo (g : LocalFrameChange (X := X) (U := U))
    (F : Omega X 2 U) : Omega X 2 U :=
  matrixWedge (matrixWedge g.inverse F) g.forward

/-- Maurer-Cartan one-form `g⁻¹ dg`. -/
noncomputable def pureGauge (g : LocalFrameChange (X := X) (U := U)) : Omega X 1 U :=
  matrixWedge g.inverse (matrixDifferential g.forward)

/-- Paper local-frame transformation `A ↦ g⁻¹Ag + g⁻¹dg`. -/
noncomputable def transformPotential (g : LocalFrameChange (X := X) (U := U))
    (A : Omega X 1 U) : Omega X 1 U :=
  g.conjugateOne A + g.pureGauge

@[simp] theorem conjugateOne_formula
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    g.conjugateOne A = matrixWedge (matrixWedge g.inverse A) g.forward :=
  rfl

@[simp] theorem conjugateTwo_formula
    (g : LocalFrameChange (X := X) (U := U)) (F : Omega X 2 U) :
    g.conjugateTwo F = matrixWedge (matrixWedge g.inverse F) g.forward :=
  rfl

@[simp] theorem pureGauge_formula
    (g : LocalFrameChange (X := X) (U := U)) :
    g.pureGauge = matrixWedge g.inverse (matrixDifferential g.forward) :=
  rfl

@[simp] theorem transformPotential_formula
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    g.transformPotential A = g.conjugateOne A + g.pureGauge :=
  rfl

theorem conjugateTwo_add
    (g : LocalFrameChange (X := X) (U := U)) (F K : Omega X 2 U) :
    g.conjugateTwo (F + K) = g.conjugateTwo F + g.conjugateTwo K := by
  rw [conjugateTwo, conjugateTwo, conjugateTwo,
    matrixWedge_add_right, matrixWedge_add_left]

/-- Cancellation of a frame and its inverse in the middle of a product. -/
theorem cancel_middle_one
    (g : LocalFrameChange (X := X) (U := U)) (A B : Omega X 1 U) :
    matrixWedge (matrixWedge A g.forward) (matrixWedge g.inverse B) =
      matrixWedge A B := by
  have h₁ :
      matrixWedge (matrixWedge A g.forward) (matrixWedge g.inverse B) =
        matrixWedge A (matrixWedge g.forward (matrixWedge g.inverse B)) := by
    simpa using matrixWedge_assoc A g.forward (matrixWedge g.inverse B)
  have h₂ :
      matrixWedge g.forward (matrixWedge g.inverse B) =
        matrixWedge (matrixWedge g.forward g.inverse) B := by
    simpa using (matrixWedge_assoc g.forward g.inverse B).symm
  calc
    matrixWedge (matrixWedge A g.forward) (matrixWedge g.inverse B) =
        matrixWedge A (matrixWedge g.forward (matrixWedge g.inverse B)) := h₁
    _ = matrixWedge A (matrixWedge (matrixWedge g.forward g.inverse) B) := by
      rw [h₂]
    _ = matrixWedge A (matrixWedge identityZeroForm B) := by
      rw [g.forward_inverse]
    _ = matrixWedge A B := by rw [matrixWedge_identity_left_one]

/-- Differentiating `g⁻¹g = 1` derives the inverse-derivative identity. -/
theorem differential_inverse
    (g : LocalFrameChange (X := X) (U := U)) :
    matrixDifferential g.inverse =
      -(matrixWedge (matrixWedge g.inverse (matrixDifferential g.forward))
          g.inverse) := by
  have hproduct :
      matrixDifferential (matrixWedge g.inverse g.forward) =
        matrixWedge (matrixDifferential g.inverse) g.forward +
          matrixWedge g.inverse (matrixDifferential g.forward) := by
    simpa using matrixGradedLeibniz g.inverse g.forward
  have hsum :
      matrixWedge (matrixDifferential g.inverse) g.forward +
          matrixWedge g.inverse (matrixDifferential g.forward) = 0 := by
    calc
      matrixWedge (matrixDifferential g.inverse) g.forward +
          matrixWedge g.inverse (matrixDifferential g.forward) =
          matrixDifferential (matrixWedge g.inverse g.forward) := hproduct.symm
      _ = matrixDifferential identityZeroForm := by rw [g.inverse_forward]
      _ = 0 := matrixDifferential_identityZeroForm
  have hfirst :
      matrixWedge (matrixDifferential g.inverse) g.forward =
        -matrixWedge g.inverse (matrixDifferential g.forward) := by
    calc
      matrixWedge (matrixDifferential g.inverse) g.forward =
          (matrixWedge (matrixDifferential g.inverse) g.forward +
            matrixWedge g.inverse (matrixDifferential g.forward)) -
              matrixWedge g.inverse (matrixDifferential g.forward) := by
        abel
      _ = -matrixWedge g.inverse (matrixDifferential g.forward) := by
        rw [hsum]
        abel
  calc
    matrixDifferential g.inverse =
        matrixWedge (matrixDifferential g.inverse) identityZeroForm :=
      (matrixWedge_identity_right _).symm
    _ = matrixWedge (matrixDifferential g.inverse)
          (matrixWedge g.forward g.inverse) := by rw [g.forward_inverse]
    _ = matrixWedge
          (matrixWedge (matrixDifferential g.inverse) g.forward) g.inverse := by
      simpa using
        (matrixWedge_assoc (matrixDifferential g.inverse) g.forward g.inverse).symm
    _ = matrixWedge
          (-matrixWedge g.inverse (matrixDifferential g.forward)) g.inverse := by
      rw [hfirst]
    _ = -(matrixWedge
          (matrixWedge g.inverse (matrixDifferential g.forward)) g.inverse) :=
      matrixWedge_neg_left _ _

/-- Conjugation converts wedge multiplication into wedge multiplication of
the conjugated factors. -/
theorem conjugateOne_wedge
    (g : LocalFrameChange (X := X) (U := U)) (A B : Omega X 1 U) :
    matrixWedge (g.conjugateOne A) (g.conjugateOne B) =
      g.conjugateTwo (matrixWedge A B) := by
  have hB :
      g.conjugateOne B =
        matrixWedge g.inverse (matrixWedge B g.forward) := by
    unfold conjugateOne
    simpa using matrixWedge_assoc g.inverse B g.forward
  rw [hB]
  calc
    matrixWedge (g.conjugateOne A)
        (matrixWedge g.inverse (matrixWedge B g.forward)) =
        matrixWedge (matrixWedge g.inverse A) (matrixWedge B g.forward) := by
      exact g.cancel_middle_one (matrixWedge g.inverse A)
        (matrixWedge B g.forward)
    _ = matrixWedge
          (matrixWedge (matrixWedge g.inverse A) B) g.forward := by
      simpa using
        (matrixWedge_assoc (matrixWedge g.inverse A) B g.forward).symm
    _ = matrixWedge
          (matrixWedge g.inverse (matrixWedge A B)) g.forward := by
      rw [show matrixWedge (matrixWedge g.inverse A) B =
          matrixWedge g.inverse (matrixWedge A B) by
        simpa using matrixWedge_assoc g.inverse A B]
    _ = g.conjugateTwo (matrixWedge A B) := rfl

/-- Right cross term normalized by the middle cancellation `g g⁻¹ = 1`. -/
theorem conjugateOne_wedge_pureGauge
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    matrixWedge (g.conjugateOne A) g.pureGauge =
      matrixWedge (matrixWedge g.inverse A)
        (matrixDifferential g.forward) := by
  unfold conjugateOne pureGauge
  exact g.cancel_middle_one (matrixWedge g.inverse A)
    (matrixDifferential g.forward)

/-- The inverse-derivative term in the derivative of a conjugated one-form. -/
theorem inverseDerivative_conjugate_term
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    matrixWedge (matrixWedge (matrixDifferential g.inverse) A) g.forward =
      -matrixWedge g.pureGauge (g.conjugateOne A) := by
  have hnormalize :
      matrixWedge
          (matrixWedge
            (matrixWedge g.pureGauge g.inverse) A) g.forward =
        matrixWedge g.pureGauge (g.conjugateOne A) := by
    unfold conjugateOne
    calc
      matrixWedge
          (matrixWedge (matrixWedge g.pureGauge g.inverse) A) g.forward =
          matrixWedge
            (matrixWedge g.pureGauge (matrixWedge g.inverse A)) g.forward := by
        rw [show matrixWedge (matrixWedge g.pureGauge g.inverse) A =
            matrixWedge g.pureGauge (matrixWedge g.inverse A) by
          simpa using matrixWedge_assoc g.pureGauge g.inverse A]
      _ = matrixWedge g.pureGauge
            (matrixWedge (matrixWedge g.inverse A) g.forward) := by
        simpa using
          matrixWedge_assoc g.pureGauge (matrixWedge g.inverse A) g.forward
  calc
    matrixWedge (matrixWedge (matrixDifferential g.inverse) A) g.forward =
        matrixWedge
          (matrixWedge (-matrixWedge g.pureGauge g.inverse) A) g.forward := by
      rw [g.differential_inverse]
      unfold pureGauge
      rfl
    _ = -matrixWedge
          (matrixWedge (matrixWedge g.pureGauge g.inverse) A) g.forward := by
      rw [matrixWedge_neg_left, matrixWedge_neg_left]
    _ = -matrixWedge g.pureGauge (g.conjugateOne A) := by
      rw [hnormalize]

/-- The inverse-derivative term in the Maurer-Cartan calculation. -/
theorem inverseDerivative_differential_term
    (g : LocalFrameChange (X := X) (U := U)) :
    matrixWedge (matrixDifferential g.inverse)
        (matrixDifferential g.forward) =
      -matrixWedge g.pureGauge g.pureGauge := by
  have hnormalize :
      matrixWedge
          (matrixWedge g.pureGauge g.inverse)
          (matrixDifferential g.forward) =
        matrixWedge g.pureGauge g.pureGauge := by
    unfold pureGauge
    simpa using matrixWedge_assoc g.pureGauge g.inverse
      (matrixDifferential g.forward)
  calc
    matrixWedge (matrixDifferential g.inverse)
        (matrixDifferential g.forward) =
      matrixWedge (-matrixWedge g.pureGauge g.inverse)
        (matrixDifferential g.forward) := by
      rw [g.differential_inverse]
      unfold pureGauge
      rfl
    _ = -matrixWedge (matrixWedge g.pureGauge g.inverse)
        (matrixDifferential g.forward) := by
      rw [matrixWedge_neg_left]
    _ = -matrixWedge g.pureGauge g.pureGauge := by
      rw [hnormalize]

/-- Exterior derivative of the conjugated connection term. -/
theorem differential_conjugateOne
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    matrixDifferential (g.conjugateOne A) =
      g.conjugateTwo (matrixDifferential A) -
        matrixWedge g.pureGauge (g.conjugateOne A) -
        matrixWedge (g.conjugateOne A) g.pureGauge := by
  unfold conjugateOne
  calc
    matrixDifferential
        (matrixWedge (matrixWedge g.inverse A) g.forward) =
        matrixWedge
            (matrixDifferential (matrixWedge g.inverse A)) g.forward -
          matrixWedge (matrixWedge g.inverse A)
            (matrixDifferential g.forward) :=
      matrixLeibniz_one_zero (matrixWedge g.inverse A) g.forward
    _ = matrixWedge
          (matrixWedge (matrixDifferential g.inverse) A +
            matrixWedge g.inverse (matrixDifferential A)) g.forward -
          matrixWedge (matrixWedge g.inverse A)
            (matrixDifferential g.forward) := by
      rw [matrixLeibniz_zero_one]
    _ = (matrixWedge
            (matrixWedge (matrixDifferential g.inverse) A) g.forward +
          matrixWedge
            (matrixWedge g.inverse (matrixDifferential A)) g.forward) -
          matrixWedge (matrixWedge g.inverse A)
            (matrixDifferential g.forward) := by
      rw [matrixWedge_add_left]
    _ = -matrixWedge g.pureGauge (g.conjugateOne A) +
          g.conjugateTwo (matrixDifferential A) -
          matrixWedge (g.conjugateOne A) g.pureGauge := by
      rw [g.inverseDerivative_conjugate_term A,
        ← g.conjugateOne_wedge_pureGauge A]
      rfl
    _ = g.conjugateTwo (matrixDifferential A) -
          matrixWedge g.pureGauge (g.conjugateOne A) -
          matrixWedge (g.conjugateOne A) g.pureGauge := by
      abel

/-- Maurer-Cartan equation for the pure-gauge one-form. -/
theorem differential_pureGauge
    (g : LocalFrameChange (X := X) (U := U)) :
    matrixDifferential g.pureGauge =
      -matrixWedge g.pureGauge g.pureGauge := by
  unfold pureGauge
  calc
    matrixDifferential
        (matrixWedge g.inverse (matrixDifferential g.forward)) =
        matrixWedge (matrixDifferential g.inverse)
            (matrixDifferential g.forward) +
          matrixWedge g.inverse
            (matrixDifferential (matrixDifferential g.forward)) :=
      matrixLeibniz_zero_one g.inverse (matrixDifferential g.forward)
    _ = -matrixWedge g.pureGauge g.pureGauge +
          matrixWedge g.inverse (0 : Omega X 2 U) := by
      rw [g.inverseDerivative_differential_term,
        matrixDifferential_squared]
    _ = -matrixWedge g.pureGauge g.pureGauge := by
      have hz : matrixWedge g.inverse (0 : Omega X 2 U) = 0 := by
        refine Matrix.ext fun i k => ?_
        simp [matrixWedge]
      rw [hz, add_zero]

/-- Derivative expansion for the transformed connection potential. -/
theorem differential_transformPotential
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    matrixDifferential (g.transformPotential A) =
      g.conjugateTwo (matrixDifferential A) -
        matrixWedge g.pureGauge (g.conjugateOne A) -
        matrixWedge (g.conjugateOne A) g.pureGauge -
        matrixWedge g.pureGauge g.pureGauge := by
  rw [transformPotential, matrixDifferential_add,
    g.differential_conjugateOne A, g.differential_pureGauge]
  abel

/-- Bilinear expansion of the transformed potential squared. -/
theorem transformPotential_wedge_self
    (g : LocalFrameChange (X := X) (U := U)) (A : Omega X 1 U) :
    matrixWedge (g.transformPotential A) (g.transformPotential A) =
      matrixWedge (g.conjugateOne A) (g.conjugateOne A) +
        matrixWedge (g.conjugateOne A) g.pureGauge +
        matrixWedge g.pureGauge (g.conjugateOne A) +
        matrixWedge g.pureGauge g.pureGauge := by
  rw [transformPotential, matrixWedge_add_left,
    matrixWedge_add_right, matrixWedge_add_right]
  abel

/-- The connection represented in the changed local frame. -/
noncomputable def transformConnection
    (g : LocalFrameChange (X := X) (U := U)) (C : Core U) : Core U where
  potential := g.transformPotential C.potential

@[simp] theorem transformConnection_potential
    (g : LocalFrameChange (X := X) (U := U)) (C : Core U) :
    (g.transformConnection C).potential = g.transformPotential C.potential :=
  rfl

/-- Local-frame compatibility of curvature, exactly
`F(A^g) = g⁻¹ F(A) g`. -/
theorem curvature_transformConnection
    (g : LocalFrameChange (X := X) (U := U)) (C : Core U) :
    (g.transformConnection C).curvature = g.conjugateTwo C.curvature := by
  change
    matrixDifferential (g.transformPotential C.potential) +
        matrixWedge (g.transformPotential C.potential)
          (g.transformPotential C.potential) =
      g.conjugateTwo
        (matrixDifferential C.potential +
          matrixWedge C.potential C.potential)
  rw [g.differential_transformPotential C.potential,
    g.transformPotential_wedge_self C.potential,
    g.conjugateOne_wedge C.potential C.potential,
    g.conjugateTwo_add]
  abel

/-- Changed frame coordinates of a local bundle section. -/
noncomputable def transformSection
    (g : LocalFrameChange (X := X) (U := U))
    (s : LocalFramedSection U) : LocalFramedSection U :=
  matrixVectorWedge g.inverse s

/-- Forward frame action on section coordinates. -/
noncomputable def forwardSection
    (g : LocalFrameChange (X := X) (U := U))
    (s : LocalFramedSection U) : LocalFramedSection U :=
  matrixVectorWedge g.forward s

@[simp] theorem identityZeroForm_vectorAction
    (s : LocalFramedSection U) :
    matrixVectorWedge (identityZeroForm (X := X) (U := U)) s = s := by
  funext i
  apply ChartForm.ext <;>
    fin_cases i <;>
      simp [identityZeroForm, zeroFormMatrix, matrixVectorWedge,
        Fin.sum_univ_two, zeroFormCoefficient, wedge, Matrix.one_apply]

theorem forwardSection_transformSection
    (g : LocalFrameChange (X := X) (U := U))
    (s : LocalFramedSection U) :
    g.forwardSection (g.transformSection s) = s := by
  unfold forwardSection transformSection
  calc
    matrixVectorWedge g.forward (matrixVectorWedge g.inverse s) =
        matrixVectorWedge (matrixWedge g.forward g.inverse) s := by
      simpa using (matrixVectorWedge_assoc g.forward g.inverse s).symm
    _ = matrixVectorWedge identityZeroForm s := by rw [g.forward_inverse]
    _ = s := identityZeroForm_vectorAction s

theorem transformSection_forwardSection
    (g : LocalFrameChange (X := X) (U := U))
    (s : LocalFramedSection U) :
    g.transformSection (g.forwardSection s) = s := by
  unfold forwardSection transformSection
  calc
    matrixVectorWedge g.inverse (matrixVectorWedge g.forward s) =
        matrixVectorWedge (matrixWedge g.inverse g.forward) s := by
      simpa using (matrixVectorWedge_assoc g.inverse g.forward s).symm
    _ = matrixVectorWedge identityZeroForm s := by rw [g.inverse_forward]
    _ = s := identityZeroForm_vectorAction s

theorem cancel_middle_vector_two
    (g : LocalFrameChange (X := X) (U := U))
    (F : Omega X 2 U) (s : LocalFramedSection U) :
    matrixVectorWedge (matrixWedge F g.forward)
        (matrixVectorWedge g.inverse s) = matrixVectorWedge F s := by
  have h₁ :
      matrixVectorWedge (matrixWedge F g.forward)
          (matrixVectorWedge g.inverse s) =
        matrixVectorWedge F
          (matrixVectorWedge g.forward (matrixVectorWedge g.inverse s)) := by
    simpa using matrixVectorWedge_assoc F g.forward
      (matrixVectorWedge g.inverse s)
  have h₂ :
      matrixVectorWedge g.forward (matrixVectorWedge g.inverse s) =
        matrixVectorWedge (matrixWedge g.forward g.inverse) s := by
    simpa using (matrixVectorWedge_assoc g.forward g.inverse s).symm
  calc
    matrixVectorWedge (matrixWedge F g.forward)
        (matrixVectorWedge g.inverse s) =
        matrixVectorWedge F
          (matrixVectorWedge g.forward (matrixVectorWedge g.inverse s)) := h₁
    _ = matrixVectorWedge F
          (matrixVectorWedge (matrixWedge g.forward g.inverse) s) := by rw [h₂]
    _ = matrixVectorWedge F (matrixVectorWedge identityZeroForm s) := by
      rw [g.forward_inverse]
    _ = matrixVectorWedge F s := by rw [identityZeroForm_vectorAction]

/-- Operator-level frame compatibility of the curvature action on sections. -/
theorem curvatureAction_transformSection
    (g : LocalFrameChange (X := X) (U := U))
    (C : Core U) (s : LocalFramedSection U) :
    (g.transformConnection C).curvatureAction (g.transformSection s) =
      matrixVectorWedge g.inverse (C.curvatureAction s) := by
  rw [Core.curvatureAction, Core.curvatureAction,
    g.curvature_transformConnection C]
  unfold conjugateTwo transformSection
  calc
    matrixVectorWedge
        (matrixWedge (matrixWedge g.inverse C.curvature) g.forward)
        (matrixVectorWedge g.inverse s) =
        matrixVectorWedge (matrixWedge g.inverse C.curvature) s := by
      exact g.cancel_middle_vector_two (matrixWedge g.inverse C.curvature) s
    _ = matrixVectorWedge g.inverse (matrixVectorWedge C.curvature s) := by
      simpa using matrixVectorWedge_assoc g.inverse C.curvature s

end LocalFrameChange

end PaperFaithfulConnection

/-! #### The two paper definitions are aliases of one core -/

namespace Definition16

abbrev Eq (X : Type u) [TopologicalSpace X] : Type u :=
  PaperFaithfulConnection.EqBundle X

def EqToX {X : Type u} [TopologicalSpace X] : Eq X → X :=
  PaperFaithfulConnection.EqProjection

abbrev Connection {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : Type :=
  PaperFaithfulConnection.Core U

noncomputable def nabla {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (C : Connection U) :
    PaperFaithfulConnection.LocalFramedSection U →+
      PaperFaithfulConnection.BundleForm 1 U :=
  C.nablaHom

noncomputable def curvature {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (C : Connection U) :
    PolynomialMatrixDifferentialForms.Omega X 2 U :=
  C.curvature

end Definition16

namespace Definition17

abbrev Eq (X : Type u) [TopologicalSpace X] : Type u :=
  PaperFaithfulConnection.EqBundle X

def EqToX {X : Type u} [TopologicalSpace X] : Eq X → X :=
  PaperFaithfulConnection.EqProjection

abbrev Connection {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : Type :=
  PaperFaithfulConnection.Core U

noncomputable def nabla {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (C : Connection U) :
    PaperFaithfulConnection.LocalFramedSection U →+
      PaperFaithfulConnection.BundleForm 1 U :=
  C.nablaHom

noncomputable def curvature {X : Type u} [TopologicalSpace X]
    {U : TopologicalSpace.Opens X} (C : Connection U) :
    PolynomialMatrixDifferentialForms.Omega X 2 U :=
  C.curvature

end Definition17

theorem definitions16And17_bundle_alias_same
    (X : Type u) [TopologicalSpace X] :
    Definition16.Eq X = Definition17.Eq X :=
  rfl

theorem definitions16And17_connection_alias_same
    {X : Type u} [TopologicalSpace X] (U : TopologicalSpace.Opens X) :
    Definition16.Connection U = Definition17.Connection U :=
  rfl

theorem definitions16And17_nabla_same
    {X : Type u} [TopologicalSpace X] {U : TopologicalSpace.Opens X}
    (C : PaperFaithfulConnection.Core U) :
    Definition16.nabla C = Definition17.nabla C :=
  rfl

theorem definitions16And17_curvature_same
    {X : Type u} [TopologicalSpace X] {U : TopologicalSpace.Opens X}
    (C : PaperFaithfulConnection.Core U) :
    Definition16.curvature C = Definition17.curvature C :=
  rfl

namespace PaperFaithfulConnection.Core

/-- Zero potential, used only for the empty-context certification witness. -/
noncomputable def zero {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : PaperFaithfulConnection.Core U where
  potential := 0

@[simp] theorem zero_potential {X : Type u} [TopologicalSpace X]
    (U : TopologicalSpace.Opens X) : (zero U).potential = 0 :=
  rfl

end PaperFaithfulConnection.Core

/-- PR-facing certificate for every Checklist 6.2 clause. -/
structure Section62PaperFaithfulConnectionCertificate
    (X : Type u) [TopologicalSpace X] (U : TopologicalSpace.Opens X)
    (C : PaperFaithfulConnection.Core U)
    (g : PaperFaithfulConnection.LocalFrameChange (X := X) (U := U)) : Prop where
  vector_bundle_exists :
    VectorBundle ℂ PaperFaithfulConnection.EqModelFiber
      (PaperFaithfulConnection.EqFamily X)
  bundle_projection :
    ∀ (x : X) (v : PaperFaithfulConnection.EqModelFiber),
      PaperFaithfulConnection.EqProjection (X := X) ⟨x, v⟩ = x
  connection_operator_formula :
    ∀ s : PaperFaithfulConnection.LocalFramedSection U,
      C.nabla s =
        PaperFaithfulConnection.vectorDifferential s +
          PaperFaithfulConnection.matrixVectorWedge C.potential s
  connection_acts_on_actual_bundle_section :
    ∀ (coordinate : X → ℂ)
      (s : PaperFaithfulConnection.PolynomialBundleSection
        (U := U) coordinate),
      C.nablaBundleSection coordinate s =
        PaperFaithfulConnection.vectorDifferential s.coordinates +
          PaperFaithfulConnection.matrixVectorWedge C.potential s.coordinates
  covariant_square_is_curvature_action :
    ∀ s : PaperFaithfulConnection.LocalFramedSection U,
      C.nablaSquared s = C.curvatureAction s
  definition16_definition17_share_bundle :
    Definition16.Eq X = Definition17.Eq X
  definition16_definition17_share_connection :
    Definition16.Connection U = Definition17.Connection U
  definition16_definition17_share_nabla :
    Definition16.nabla C = Definition17.nabla C
  definition16_definition17_share_curvature :
    Definition16.curvature C = Definition17.curvature C
  curvature_restriction_compatible :
    ∀ {V : TopologicalSpace.Opens X} (hVU : V ≤ U),
      (C.restrict hVU).curvature =
        PolynomialMatrixDifferentialForms.restrictHom hVU C.curvature
  curvature_frame_compatible :
    (g.transformConnection C).curvature = g.conjugateTwo C.curvature
  curvature_action_frame_compatible :
    ∀ s : PaperFaithfulConnection.LocalFramedSection U,
      (g.transformConnection C).curvatureAction (g.transformSection s) =
        PaperFaithfulConnection.matrixVectorWedge g.inverse
          (C.curvatureAction s)
  frame_change_is_invertible_on_sections :
    (∀ s : PaperFaithfulConnection.LocalFramedSection U,
      g.forwardSection (g.transformSection s) = s) ∧
    (∀ s : PaperFaithfulConnection.LocalFramedSection U,
      g.transformSection (g.forwardSection s) = s)
  curvature_has_exact_g_valued_codomain :
    ∃ F : PaperFaithfulConnection.GValuedPolynomialForm X 2 U,
      C.curvature = F
  curvature_is_g_valued_two_form :
    ∀ i j : Fin 2,
      ∃ ω : PolynomialMatrixDifferentialForms.ChartForm 2,
        C.curvature i j = ω

theorem section62_paperFaithfulConnection_certificate
    (X : Type u) [TopologicalSpace X] (U : TopologicalSpace.Opens X)
    (C : PaperFaithfulConnection.Core U)
    (g : PaperFaithfulConnection.LocalFrameChange (X := X) (U := U)) :
    Section62PaperFaithfulConnectionCertificate X U C g := by
  exact
    { vector_bundle_exists := PaperFaithfulConnection.Eq_isVectorBundle X
      bundle_projection := PaperFaithfulConnection.EqProjection_mk
      connection_operator_formula := C.nabla_apply
      connection_acts_on_actual_bundle_section := C.nablaBundleSection_formula
      covariant_square_is_curvature_action := C.nablaSquared_eq_curvatureAction
      definition16_definition17_share_bundle :=
        definitions16And17_bundle_alias_same X
      definition16_definition17_share_connection :=
        definitions16And17_connection_alias_same U
      definition16_definition17_share_nabla :=
        definitions16And17_nabla_same C
      definition16_definition17_share_curvature :=
        definitions16And17_curvature_same C
      curvature_restriction_compatible := C.curvature_restrict
      curvature_frame_compatible := g.curvature_transformConnection C
      curvature_action_frame_compatible := g.curvatureAction_transformSection C
      frame_change_is_invertible_on_sections :=
        ⟨g.forwardSection_transformSection,
          g.transformSection_forwardSection⟩
      curvature_has_exact_g_valued_codomain := ⟨C.curvature, rfl⟩
      curvature_is_g_valued_two_form := C.curvature_entry_is_twoForm }

/-- Empty-context closure of all Checklist 6.2 fields. -/
theorem checklist_6_2_unconditional :
    @Section62PaperFaithfulConnectionCertificate
      PUnit (⊥ : TopologicalSpace PUnit) ⊤
      (PaperFaithfulConnection.Core.zero ⊤)
      (PaperFaithfulConnection.LocalFrameChange.identity
        (X := PUnit) (U := ⊤)) := by
  letI : TopologicalSpace PUnit := ⊥
  exact section62_paperFaithfulConnection_certificate PUnit ⊤
    (PaperFaithfulConnection.Core.zero ⊤)
    (PaperFaithfulConnection.LocalFrameChange.identity
      (X := PUnit) (U := ⊤))

/-! ### §F.1.5 — Definition 18 and Proposition 19: flat minimizers. -/

/-- Definition 18.  The flat sector is the subtype of fields whose curvature
vanishes.  No quotient, topology, or analytic existence assertion is built
into this definition. -/
def FlatSector (Aq : Type u) {Curvature : Type v} [Zero Curvature]
    (curvature : Aq → Curvature) : Type u :=
  { A : Aq // curvature A = 0 }

namespace FlatSector

variable {Aq : Type u} {Curvature : Type v} [Zero Curvature]
variable {curvature : Aq → Curvature}

@[simp] theorem curvature_eq_zero
    (A : FlatSector Aq curvature) : curvature A.1 = 0 :=
  A.2

@[simp] theorem mk_val (A : Aq) (hA : curvature A = 0) :
    (⟨A, hA⟩ : FlatSector Aq curvature).1 = A :=
  rfl

theorem nonempty_iff_exists_curvature_eq_zero :
    Nonempty (FlatSector Aq curvature) ↔ ∃ A : Aq, curvature A = 0 := by
  constructor
  · rintro ⟨A⟩
    exact ⟨A.1, A.2⟩
  · rintro ⟨A, hA⟩
    exact ⟨⟨A, hA⟩⟩

end FlatSector

/-- Abstract action decomposition from Definition 18.  The only structural
property of the curvature-energy term needed by Proposition 19 is that it
vanishes on the flat sector. -/
structure AbstractActionDecomposition
    (Aq : Type u) (Curvature : Type v) (Energy : Type w)
    [Zero Curvature] [AddMonoid Energy] where
  curvature : Aq → Curvature
  L : Aq → Energy
  curvatureEnergy : Aq → Energy
  M : Aq → Energy
  R : Aq → Energy
  action_decomposition :
    ∀ A : Aq, L A = curvatureEnergy A + M A + R A
  curvatureEnergy_zero_of_flat :
    ∀ {A : Aq}, curvature A = 0 → curvatureEnergy A = 0

namespace AbstractActionDecomposition

variable {Aq : Type u} {Curvature : Type v} {Energy : Type w}
variable [Zero Curvature] [AddMonoid Energy]
variable (D : AbstractActionDecomposition Aq Curvature Energy)

/-- The exact flat sector associated with the decomposition's curvature. -/
abbrev flatSector : Type u := FlatSector Aq D.curvature

/-- On a flat field, the action reduces definitionally through the supplied
decomposition to `M + R`. -/
theorem action_eq_M_add_R_of_flat (A : Aq)
    (hflat : D.curvature A = 0) :
    D.L A = D.M A + D.R A := by
  calc
    D.L A = D.curvatureEnergy A + D.M A + D.R A :=
      D.action_decomposition A
    _ = 0 + D.M A + D.R A := by
      rw [D.curvatureEnergy_zero_of_flat hflat]
    _ = D.M A + D.R A := by rw [zero_add]

theorem action_eq_M_add_R_on_flatSector
    (A : D.flatSector) :
    D.L A.1 = D.M A.1 + D.R A.1 :=
  D.action_eq_M_add_R_of_flat A.1 A.2

/-- A flat field with vanishing `M` and `R` has zero action. -/
theorem flatVacuum_action_eq_zero
    (A0 : D.flatSector)
    (hM0 : D.M A0.1 = 0) (hR0 : D.R A0.1 = 0) :
    D.L A0.1 = 0 := by
  calc
    D.L A0.1 = D.M A0.1 + D.R A0.1 :=
      D.action_eq_M_add_R_on_flatSector A0
    _ = 0 + 0 := by rw [hM0, hR0]
    _ = 0 := by rw [add_zero]

end AbstractActionDecomposition

/-- Purely order-theoretic global minimality.  This predicate supplies a
minimizer witness; it makes no claim that such a witness analytically exists. -/
def IsGlobalMinimizer
    {Aq : Type u} {Energy : Type w} [Preorder Energy]
    (L : Aq → Energy) (Astar : Aq) : Prop :=
  ∀ A : Aq, L Astar ≤ L A

/-- The exact hypotheses used in Proposition 19.  In particular, `Astar` and
its global-minimality proof are inputs, not outputs of an existence theorem. -/
structure Proposition19Hypotheses
    {Aq : Type u} {Curvature : Type v} {Energy : Type w}
    [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    (D : AbstractActionDecomposition Aq Curvature Energy)
    (Astar : Aq) : Prop where
  M_nonnegative : ∀ A : Aq, 0 ≤ D.M A
  R_nonnegative : ∀ A : Aq, 0 ≤ D.R A
  exists_flat_vacuum :
    ∃ A0 : D.flatSector, D.M A0.1 = 0 ∧ D.R A0.1 = 0
  Astar_global_minimizer : IsGlobalMinimizer D.L Astar
  Astar_is_flat : D.curvature Astar = 0

/-- Two nonnegative terms with zero sum vanish separately.  This is the sole
order-theoretic cancellation principle used in Proposition 19. -/
theorem two_nonnegative_terms_eq_zero
    {Energy : Type w} [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    {a b : Energy} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 0) :
    a = 0 ∧ b = 0 := by
  have ha_le_zero : a ≤ 0 := by
    calc
      a = a + 0 := (add_zero a).symm
      _ ≤ a + b := add_le_add_right hb a
      _ = 0 := hab
  have hb_le_zero : b ≤ 0 := by
    calc
      b = 0 + b := (zero_add b).symm
      _ ≤ a + b := add_le_add_left ha b
      _ = 0 := hab
  exact ⟨le_antisymm ha_le_zero ha, le_antisymm hb_le_zero hb⟩

namespace Proposition19Hypotheses

variable {Aq : Type u} {Curvature : Type v} {Energy : Type w}
variable [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
variable {D : AbstractActionDecomposition Aq Curvature Energy}
variable {Astar : Aq}

/-- A global minimizer has action at most the flat vacuum's zero action. -/
theorem minimizer_action_le_zero
    (H : Proposition19Hypotheses D Astar) : D.L Astar ≤ 0 := by
  rcases H.exists_flat_vacuum with ⟨A0, hM0, hR0⟩
  calc
    D.L Astar ≤ D.L A0.1 := H.Astar_global_minimizer A0.1
    _ = 0 := D.flatVacuum_action_eq_zero A0 hM0 hR0

/-- Flatness and nonnegativity force the minimizer's action to be nonnegative. -/
theorem minimizer_action_nonnegative
    (H : Proposition19Hypotheses D Astar) : 0 ≤ D.L Astar := by
  rw [D.action_eq_M_add_R_of_flat Astar H.Astar_is_flat]
  exact add_nonneg (H.M_nonnegative Astar) (H.R_nonnegative Astar)

theorem minimizer_action_eq_zero
    (H : Proposition19Hypotheses D Astar) : D.L Astar = 0 :=
  le_antisymm H.minimizer_action_le_zero H.minimizer_action_nonnegative

theorem minimizer_M_add_R_eq_zero
    (H : Proposition19Hypotheses D Astar) :
    D.M Astar + D.R Astar = 0 := by
  calc
    D.M Astar + D.R Astar = D.L Astar :=
      (D.action_eq_M_add_R_of_flat Astar H.Astar_is_flat).symm
    _ = 0 := H.minimizer_action_eq_zero

end Proposition19Hypotheses

/-- Proposition 19.  A supplied global minimizer in the flat sector has
vanishing effective mass and remainder.  The proof is purely order-theoretic
and does not assert analytic existence of minimizers. -/
theorem proposition19_M_and_R_vanish
    {Aq : Type u} {Curvature : Type v} {Energy : Type w}
    [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    {D : AbstractActionDecomposition Aq Curvature Energy}
    {Astar : Aq} (H : Proposition19Hypotheses D Astar) :
    D.M Astar = 0 ∧ D.R Astar = 0 :=
  two_nonnegative_terms_eq_zero
    (H.M_nonnegative Astar) (H.R_nonnegative Astar)
    H.minimizer_M_add_R_eq_zero

/-- Paper-facing alias for the massless-phase conclusion. -/
theorem proposition19_massless_phase
    {Aq : Type u} {Curvature : Type v} {Energy : Type w}
    [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    {D : AbstractActionDecomposition Aq Curvature Energy}
    {Astar : Aq} (H : Proposition19Hypotheses D Astar) :
    D.M Astar = 0 ∧ D.R Astar = 0 :=
  proposition19_M_and_R_vanish H

/-- PR-facing certificate for every Definition 18 and Proposition 19 clause. -/
structure Definition18AndProposition19Certificate
    {Aq : Type u} {Curvature : Type v} {Energy : Type w}
    [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    (D : AbstractActionDecomposition Aq Curvature Energy)
    (Astar : Aq) : Prop where
  flat_sector_characterization :
    ∀ A : FlatSector Aq D.curvature, D.curvature A.1 = 0
  flat_sector_nonempty_iff :
    Nonempty (FlatSector Aq D.curvature) ↔
      ∃ A : Aq, D.curvature A = 0
  action_decomposition :
    ∀ A : Aq, D.L A = D.curvatureEnergy A + D.M A + D.R A
  curvature_energy_zero_on_flat :
    ∀ {A : Aq}, D.curvature A = 0 → D.curvatureEnergy A = 0
  M_nonnegative : ∀ A : Aq, 0 ≤ D.M A
  R_nonnegative : ∀ A : Aq, 0 ≤ D.R A
  flat_vacuum_exists :
    ∃ A0 : FlatSector Aq D.curvature,
      D.M A0.1 = 0 ∧ D.R A0.1 = 0
  global_minimizer_is_input : IsGlobalMinimizer D.L Astar
  minimizer_is_flat : D.curvature Astar = 0
  mass_and_remainder_vanish : D.M Astar = 0 ∧ D.R Astar = 0

theorem definition18AndProposition19_certificate
    {Aq : Type u} {Curvature : Type v} {Energy : Type w}
    [Zero Curvature] [AddCommGroup Energy] [LinearOrder Energy] [IsOrderedAddMonoid Energy]
    (D : AbstractActionDecomposition Aq Curvature Energy)
    (Astar : Aq) (H : Proposition19Hypotheses D Astar) :
    Definition18AndProposition19Certificate D Astar := by
  exact
    { flat_sector_characterization := fun A => A.2
      flat_sector_nonempty_iff :=
        FlatSector.nonempty_iff_exists_curvature_eq_zero
      action_decomposition := D.action_decomposition
      curvature_energy_zero_on_flat := D.curvatureEnergy_zero_of_flat
      M_nonnegative := H.M_nonnegative
      R_nonnegative := H.R_nonnegative
      flat_vacuum_exists := H.exists_flat_vacuum
      global_minimizer_is_input := H.Astar_global_minimizer
      minimizer_is_flat := H.Astar_is_flat
      mass_and_remainder_vanish := proposition19_M_and_R_vanish H }

namespace TruncatedGaugeCovariantDGA

variable {X : Type u} [TopologicalSpace X]
variable {Ω : TopologicalSpace.Opens X → Type v}
variable [∀ U, Ring (Ω U)]

/-- Definition 18 specialized to the curvature from §F.1.3. -/
abbrev localFlatSector (G : TruncatedGaugeCovariantDGA X Ω)
    (U : TopologicalSpace.Opens X) : Type v :=
  FlatSector (Ω U)
    (fun A : Ω U => (G.toCurvatureAlgebra).curvature A)

end TruncatedGaugeCovariantDGA

/-- Proposition 20: global sections are equivalent to the equalizer of the two
restriction maps into the product of pairwise-overlap sections. -/
noncomputable def proposition20GlobalSectionsEquivEqualizer
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (hF : IsSheafLike F) {ι : Type u} (C : OpenCoverData X ι) :
    F.Section C.target ≃ F.CoverEqualizer C where
  toFun := F.globalToEqualizer C
  invFun := hF.glue C
  left_inv := by
    intro x
    apply hF.locality C
    intro i
    exact hF.glue_isGluing C (F.globalToEqualizer C x) i
  right_inv := by
    intro e
    apply F.coverEqualizer_ext
    intro i
    exact hF.glue_isGluing C e i

/-- Proposition 20 in the paper's whole-space notation:
`F(X)` is the equalizer of the two maps from local sections to overlap sections. -/
noncomputable def global_sections_equiv_equalizer
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (hF : IsSheafLike F) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i) :
    F.Section (⊤ : TopologicalSpace.Opens X) ≃
      F.GlobalSectionEqualizer U hcover :=
  proposition20GlobalSectionsEquivEqualizer F hF
    (OpenCoverData.wholeSpace U hcover)

/-- Propositional packaging of `global_sections_equiv_equalizer`. -/
theorem global_sections_equiv_equalizer_nonempty
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (hF : IsSheafLike F) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i) :
    Nonempty
      (F.Section (⊤ : TopologicalSpace.Opens X) ≃
        F.GlobalSectionEqualizer U hcover) :=
  ⟨global_sections_equiv_equalizer F hF U hcover⟩

/-- PR-facing certificate for every clause in Proposition 20's equalizer
description. -/
structure Proposition20EqualizerCertificate
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    {ι : Type u} (C : OpenCoverData X ι) : Prop where
  cover_condition : ∀ x : X, x ∈ C.target → ∃ i : ι, x ∈ C.piece i
  left_restriction_apply :
    ∀ (s : F.CoverSectionProduct C) (i j : ι),
      F.overlapRestrictionLeft C s (i, j) =
        F.res (C.overlap_le_left i j) (s i)
  right_restriction_apply :
    ∀ (s : F.CoverSectionProduct C) (i j : ι),
      F.overlapRestrictionRight C s (i, j) =
        F.res (C.overlap_le_right i j) (s j)
  equalizer_iff_overlap_compatibility :
    ∀ s : F.CoverSectionProduct C,
      s ∈ F.CoverEqualizerSet C ↔ F.CompatibleFamily C s
  equalizer_iff_pairwise_overlap :
    ∀ s : F.CoverSectionProduct C,
      s ∈ F.CoverEqualizerSet C ↔
        ∀ i j : ι,
          F.res (C.overlap_le_left i j) (s i) =
            F.res (C.overlap_le_right i j) (s j)
  global_restrictions_compatible :
    ∀ x : F.Section C.target,
      F.CompatibleFamily C (F.restrictToCover C x)
  gluing_exists :
    ∀ e : F.CoverEqualizer C,
      ∃ x : F.Section C.target, F.IsGluing C e.1 x
  gluing_unique :
    ∀ (e : F.CoverEqualizer C) {x y : F.Section C.target},
      F.IsGluing C e.1 x → F.IsGluing C e.1 y → x = y
  global_equalizer_equiv :
    Nonempty (F.Section C.target ≃ F.CoverEqualizer C)

theorem proposition20_equalizer_certificate
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (hF : IsSheafLike F) {ι : Type u} (C : OpenCoverData X ι) :
    Proposition20EqualizerCertificate F C := by
  exact
    { cover_condition := C.covers
      left_restriction_apply := F.overlapRestrictionLeft_apply C
      right_restriction_apply := F.overlapRestrictionRight_apply C
      equalizer_iff_overlap_compatibility :=
        F.mem_coverEqualizerSet_iff_compatible C
      equalizer_iff_pairwise_overlap :=
        F.mem_coverEqualizerSet_iff_pairwise_overlap C
      global_restrictions_compatible := F.restrictToCover_compatible C
      gluing_exists := fun e =>
        hF.gluing_exists C e.1 (F.coverEqualizer_compatible C e)
      gluing_unique := by
        intro e x y hx hy
        exact hF.gluing_unique C e.1
          (F.coverEqualizer_compatible C e) hx hy
      global_equalizer_equiv :=
        ⟨proposition20GlobalSectionsEquivEqualizer F hF C⟩ }

/-! ### §F.2 — q-gauge specialization and conservative curvature models. -/

/-- A small presheaf model over a preorder of opens/charts. -/
structure QGaugePresheaf (Open : Type u) [Preorder Open] where
  Field : Open → Type v
  res : ∀ {U V : Open}, U ≤ V → Field V → Field U
  res_id : ∀ (U : Open) (x : Field U), res (le_refl U) x = x
  res_comp :
    ∀ {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W) (x : Field W),
      res hUV (res hVW x) = res (le_trans hUV hVW) x

/-!
### §F.2.1 — Definition 11: the actual q-local-system objects

The paper writes `π([τ]) = |exp(2πiτ)|` on `Γ(2) \ ℍ`.  The first part below
checks this descent claim before using it.  It fails for the explicit element
`[[1,0],[2,1]] ∈ Γ(2)`, because that element changes the imaginary part of `i`
from `1` to `1/5`.  Consequently, no function on the full orbit quotient can
have the displayed representative formula.

The repaired Definition 11 object therefore lives directly over the radius
interval `(0,1)`.  For a fixed Hilbert-space operator datum its fibre is the
kernel of `Δ₁/₂ + V`; this kernel is independent of a choice of `τ`, transport
is the identity linear equivalence, and sections are genuinely locally
constant functions with values in that kernel.  The full sheaf axioms are
proved below rather than assumed.
-/

namespace Definition11

noncomputable section

open Matrix
open scoped MatrixGroups UpperHalfPlane

/-- The radius/modular-time base in Definition 11. -/
abbrev RadiusBase := Set.Ioo (0 : ℝ) 1

/-- Mathlib's actual complex upper half-plane. -/
abbrev H := ℍ

/-- The principal level-two congruence subgroup `Γ(2) ≤ SL(2,ℤ)`. -/
abbrev Gamma2 : Subgroup SL(2, ℤ) :=
  CongruenceSubgroup.Gamma 2

/-- The orbit quotient appearing literally in the paper. -/
abbrev Gamma2Quotient :=
  Quotient (MulAction.orbitRel Gamma2 H)

@[simp] theorem radiusBase_pos (r : RadiusBase) : 0 < (r : ℝ) :=
  r.2.1

@[simp] theorem radiusBase_lt_one (r : RadiusBase) : (r : ℝ) < 1 :=
  r.2.2

/-- The usual `q = exp(2πiτ)` parameter, using Mathlib's q-parameter API. -/
def qParameter (τ : H) : ℂ :=
  Function.Periodic.qParam 1 (τ : ℂ)

/-- The radius `|q|` before any attempted quotient descent. -/
def qRadius (τ : H) : ℝ :=
  ‖qParameter τ‖

/-- The standard formula `|q(τ)| = exp(-2π Im τ)`. -/
theorem qRadius_eq_exp_neg_two_pi_im (τ : H) :
    qRadius τ = Real.exp (-2 * Real.pi * τ.im) := by
  simp [qRadius, qParameter, Function.Periodic.norm_qParam]

theorem qRadius_pos (τ : H) : 0 < qRadius τ := by
  rw [qRadius_eq_exp_neg_two_pi_im]
  exact Real.exp_pos _

theorem qRadius_lt_one (τ : H) : qRadius τ < 1 := by
  simpa [qRadius, qParameter, Function.Periodic.qParam] using
    UpperHalfPlane.norm_exp_two_pi_I_lt_one τ

/-- The well-defined map from the upper half-plane itself to the radius base. -/
def qRadiusPoint (τ : H) : RadiusBase :=
  ⟨qRadius τ, qRadius_pos τ, qRadius_lt_one τ⟩

@[simp] theorem qRadiusPoint_val (τ : H) :
    (qRadiusPoint τ : ℝ) = qRadius τ :=
  rfl

/-- A canonical upper-half-plane representative of a prescribed radius. -/
def radiusRepresentative (r : RadiusBase) : H :=
  ⟨⟨0, -Real.log (r : ℝ) / (2 * Real.pi)⟩, by
    exact div_pos (neg_pos.mpr (Real.log_neg r.2.1 r.2.2))
      (mul_pos (by norm_num) Real.pi_pos)⟩

@[simp] theorem radiusRepresentative_im (r : RadiusBase) :
    (radiusRepresentative r).im =
      -Real.log (r : ℝ) / (2 * Real.pi) :=
  rfl

/-- The canonical representative has exactly the prescribed q-radius. -/
theorem qRadius_radiusRepresentative (r : RadiusBase) :
    qRadius (radiusRepresentative r) = (r : ℝ) := by
  rw [qRadius_eq_exp_neg_two_pi_im, radiusRepresentative_im]
  have htwoPi : (2 * Real.pi : ℝ) ≠ 0 :=
    mul_ne_zero (by norm_num) Real.pi_ne_zero
  have hexponent :
      -2 * Real.pi * (-Real.log (r : ℝ) / (2 * Real.pi)) =
        Real.log (r : ℝ) := by
    calc
      -2 * Real.pi * (-Real.log (r : ℝ) / (2 * Real.pi)) =
          (2 * Real.pi) * (Real.log (r : ℝ) / (2 * Real.pi)) := by
        ring
      _ = Real.log (r : ℝ) := mul_div_cancel₀ _ htwoPi
  rw [hexponent, Real.exp_log r.2.1]

@[simp] theorem qRadiusPoint_radiusRepresentative (r : RadiusBase) :
    qRadiusPoint (radiusRepresentative r) = r := by
  apply Subtype.ext
  exact qRadius_radiusRepresentative r

/-- Every radius in `(0,1)` has an explicit upper-half-plane representative. -/
theorem qRadiusPoint_surjective : Function.Surjective qRadiusPoint := by
  intro r
  exact ⟨radiusRepresentative r, qRadiusPoint_radiusRepresentative r⟩

/-- A concrete lower-unipotent element of the principal congruence subgroup. -/
def gammaLower : SL(2, ℤ) :=
  ⟨!![1, 0; 2, 1], by simp [Matrix.det_fin_two_of]⟩

theorem gammaLower_mem_Gamma2 : gammaLower ∈ Gamma2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  change (1 : ZMod 2) = 1 /\
    (0 : ZMod 2) = 0 /\
    (2 : ZMod 2) = 0 /\
    (1 : ZMod 2) = 1
  decide

/-- The same matrix bundled as an element of `Γ(2)`. -/
def gammaLowerInGamma2 : Gamma2 :=
  ⟨gammaLower, gammaLower_mem_Gamma2⟩

/-- The witness changes `Im(i)` from `1` to `1/5`. -/
theorem gammaLower_smul_I_im :
    (gammaLower • UpperHalfPlane.I).im = (1 / 5 : ℝ) := by
  rw [ModularGroup.im_smul_eq_div_normSq]
  have hdenom :
      UpperHalfPlane.denom
          (SpecialLinearGroup.toGL
            ((SpecialLinearGroup.map (Int.castRingHom ℝ)) gammaLower))
          (UpperHalfPlane.I : ℂ) = 2 * Complex.I + 1 := by
    rw [ModularGroup.denom_apply]
    norm_num [gammaLower]
  rw [hdenom, UpperHalfPlane.I_im]
  norm_num [Complex.normSq]

theorem gammaLowerInGamma2_smul_I_im :
    (gammaLowerInGamma2 • UpperHalfPlane.I).im = (1 / 5 : ℝ) := by
  change (gammaLower • UpperHalfPlane.I).im = (1 / 5 : ℝ)
  exact gammaLower_smul_I_im

/-- Therefore `|q|` is not invariant under the full `Γ(2)` deck action. -/
theorem qRadius_gammaLower_ne :
    qRadius (gammaLowerInGamma2 • UpperHalfPlane.I) ≠
      qRadius UpperHalfPlane.I := by
  have hlt : qRadius UpperHalfPlane.I <
      qRadius (gammaLowerInGamma2 • UpperHalfPlane.I) := by
    rw [qRadius_eq_exp_neg_two_pi_im,
      qRadius_eq_exp_neg_two_pi_im, gammaLowerInGamma2_smul_I_im,
      UpperHalfPlane.I_im, Real.exp_lt_exp]
    nlinarith [Real.pi_pos]
  exact ne_of_gt hlt

/-- Canonical projection to the orbit quotient. -/
def quotientMk (τ : H) : Gamma2Quotient :=
  Quotient.mk (MulAction.orbitRel Gamma2 H) τ

/-- Points related by a `Γ(2)` action have the same orbit class. -/
theorem quotientMk_smul (g : Gamma2) (τ : H) :
    quotientMk (g • τ) = quotientMk τ := by
  apply Quotient.sound
  exact ⟨g, rfl⟩

/-- Precise formulation of the paper's claimed quotient map. -/
def OriginalPiWellDefined : Prop :=
  ∃ π : Gamma2Quotient → RadiusBase,
    ∀ τ : H, π (quotientMk τ) = qRadiusPoint τ

/-- Mathematical audit of Definition 11: the displayed `π` does not descend to
`Γ(2) \ ℍ`.  This is an unconditional counterexample, not an analytic gap. -/
theorem originalPi_not_wellDefined : ¬ OriginalPiWellDefined := by
  rintro ⟨π, hπ⟩
  have hclass := quotientMk_smul gammaLowerInGamma2 UpperHalfPlane.I
  have hpoints :
      qRadiusPoint (gammaLowerInGamma2 • UpperHalfPlane.I) =
        qRadiusPoint UpperHalfPlane.I := by
    calc
      qRadiusPoint (gammaLowerInGamma2 • UpperHalfPlane.I) =
          π (quotientMk (gammaLowerInGamma2 • UpperHalfPlane.I)) :=
        (hπ _).symm
      _ = π (quotientMk UpperHalfPlane.I) := congrArg π hclass
      _ = qRadiusPoint UpperHalfPlane.I := hπ _
  exact qRadius_gammaLower_ne (congrArg Subtype.val hpoints)

end

end Definition11

/-! #### A genuine sheaf of locally constant maps -/

namespace LocallyConstantValueSheaf

variable {X : Type u} [TopologicalSpace X]
variable (F : Type v)

/-- Continuous inclusion between the subtype spaces of two nested opens. -/
def openInclusion {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    C(↥U, ↥V) where
  toFun x := ⟨x.1, hUV x.2⟩
  continuous_toFun := continuous_subtype_val.subtype_mk _

@[simp] theorem openInclusion_val
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) (x : U) :
    ((openInclusion hUV x : V) : X) = (x : X) :=
  rfl

/-- The presheaf assigning locally constant `F`-valued maps to every open. -/
def presheaf : PresheafLike X where
  Section U := LocallyConstant U F
  res hUV s := LocallyConstant.comap (openInclusion hUV) s
  res_id := by
    intro U s
    apply LocallyConstant.ext
    intro x
    rfl
  res_comp := by
    intro U V W hUV hVW s
    apply LocallyConstant.ext
    intro x
    rfl

@[simp] theorem presheaf_res_apply
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : (presheaf F).Section V) (x : U) :
    ((presheaf F).res hUV s).toFun x =
      s.toFun ⟨x.1, hUV x.2⟩ :=
  rfl

variable {F}

/-- A deterministic index of a cover member containing a target point. -/
noncomputable def coverIndex {ι : Type u} (C : OpenCoverData X ι)
    (x : C.target) : ι :=
  Classical.choose (C.covers x.1 x.2)

theorem coverIndex_mem {ι : Type u} (C : OpenCoverData X ι)
    (x : C.target) :
    x.1 ∈ C.piece (coverIndex C x) :=
  Classical.choose_spec (C.covers x.1 x.2)

/-- Pointwise gluing candidate selected from a covering chart. -/
noncomputable def glueFunction {ι : Type u} (C : OpenCoverData X ι)
    (s : (presheaf F).CoverSectionProduct C) (x : C.target) : F :=
  (s (coverIndex C x)).toFun ⟨x.1, coverIndex_mem C x⟩

/-- Cover compatibility makes the pointwise gluing candidate independent of
the selected chart. -/
theorem glueFunction_eq_section {ι : Type u} (C : OpenCoverData X ι)
    (s : (presheaf F).CoverSectionProduct C)
    (hs : (presheaf F).CompatibleFamily C s)
    (i : ι) (x : C.target) (hxi : x.1 ∈ C.piece i) :
    glueFunction C s x = (s i).toFun ⟨x.1, hxi⟩ := by
  let j := coverIndex C x
  have hxj : x.1 ∈ C.piece j := coverIndex_mem C x
  let z : ↥(C.piece j ⊓ C.piece i) := ⟨x.1, ⟨hxj, hxi⟩⟩
  have heq := congrArg (fun f => f.toFun z) (hs j i)
  change (s j).toFun ⟨x.1, hxj⟩ = (s i).toFun ⟨x.1, hxi⟩ at heq
  simpa [glueFunction, j] using heq

/-- Compatible locally constant maps glue to a locally constant map on the
target open.  Local constancy is proved using an open fibre of one chart and
chart-independence on the overlap. -/
noncomputable def glueSection {ι : Type u} (C : OpenCoverData X ι)
    (s : (presheaf F).CoverSectionProduct C)
    (hs : (presheaf F).CompatibleFamily C s) :
    (presheaf F).Section C.target where
  toFun := glueFunction C s
  isLocallyConstant := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro x
    let i := coverIndex C x
    have hxi : x.1 ∈ C.piece i := coverIndex_mem C x
    let xi : C.piece i := ⟨x.1, hxi⟩
    let A : Set (C.piece i) := (s i).toFun ⁻¹' {(s i).toFun xi}
    have hA : IsOpen A := by
      exact (IsLocallyConstant.iff_isOpen_fiber_apply.mp
        (s i).isLocallyConstant) xi
    have hAX : IsOpen (Subtype.val '' A) :=
      (C.piece i).isOpen.isOpenMap_subtype_val A hA
    let W : Set C.target := Subtype.val ⁻¹' (Subtype.val '' A)
    have hW : IsOpen W := hAX.preimage continuous_subtype_val
    have hxiA : xi ∈ A := by simp [A]
    have hxW : x ∈ W := by
      change x.1 ∈ Subtype.val '' A
      exact ⟨xi, hxiA, rfl⟩
    filter_upwards [hW.mem_nhds hxW] with y hy
    change glueFunction C s y = glueFunction C s x
    change y.1 ∈ Subtype.val '' A at hy
    obtain ⟨z, hzA, hzy⟩ := hy
    have hyi : y.1 ∈ C.piece i := by
      rw [← hzy]
      exact z.2
    have hz_eq : z = (⟨y.1, hyi⟩ : C.piece i) :=
      Subtype.ext hzy
    have hz_value : (s i).toFun z = (s i).toFun xi := by
      simpa [A] using hzA
    calc
      glueFunction C s y = (s i).toFun ⟨y.1, hyi⟩ :=
        glueFunction_eq_section C s hs i y hyi
      _ = (s i).toFun z := by rw [← hz_eq]
      _ = (s i).toFun xi := hz_value
      _ = glueFunction C s x :=
        (glueFunction_eq_section C s hs i x hxi).symm

/-- Locality for the locally constant value presheaf. -/
theorem locality {ι : Type u} (C : OpenCoverData X ι)
    {x y : (presheaf F).Section C.target}
    (hxy : ∀ i : ι,
      (presheaf F).res (C.piece_le_target i) x =
        (presheaf F).res (C.piece_le_target i) y) :
    x = y := by
  apply LocallyConstant.ext
  intro z
  let i := coverIndex C z
  have hzi : z.1 ∈ C.piece i := coverIndex_mem C z
  let zi : C.piece i := ⟨z.1, hzi⟩
  have heq := congrArg (fun f => f.toFun zi) (hxy i)
  change x.toFun z = y.toFun z at heq
  exact heq

/-- Existence of a gluing for every compatible family. -/
theorem gluing_exists {ι : Type u} (C : OpenCoverData X ι)
    (s : (presheaf F).CoverSectionProduct C)
    (hs : (presheaf F).CompatibleFamily C s) :
    ∃ x : (presheaf F).Section C.target,
      (presheaf F).IsGluing C s x := by
  refine ⟨glueSection C s hs, ?_⟩
  intro i
  apply LocallyConstant.ext
  intro x
  change glueFunction C s
      (⟨x.1, C.piece_le_target i x.2⟩ : C.target) = (s i).toFun x
  exact glueFunction_eq_section C s hs i
    ⟨x.1, C.piece_le_target i x.2⟩ x.2

/-- Uniqueness of gluing follows from locality. -/
theorem gluing_unique {ι : Type u} (C : OpenCoverData X ι)
    (s : (presheaf F).CoverSectionProduct C)
    (_hs : (presheaf F).CompatibleFamily C s)
    {x y : (presheaf F).Section C.target}
    (hx : (presheaf F).IsGluing C s x)
    (hy : (presheaf F).IsGluing C s y) :
    x = y := by
  apply locality C
  intro i
  exact (hx i).trans (hy i).symm

/-- Locally constant maps form a genuine sheaf for arbitrary indexed open
covers in the lightweight `PresheafLike` API. -/
theorem isSheaf : IsSheafLike (presheaf (X := X) F) :=
  { locality := locality (X := X) (F := F)
    gluing_exists := gluing_exists (X := X) (F := F)
    gluing_unique := gluing_unique (X := X) (F := F) }

end LocallyConstantValueSheaf

namespace Definition11

noncomputable section

/-- Exact analytic input type for Definition 11.  The weight-half Laplacian is
treated as an unbounded operator on a dense common domain, rather than being
incorrectly forced into the type of bounded continuous operators. -/
structure AnalyticData (V : Type v)
    [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V] where
  domain : Submodule ℂ V
  domain_dense : Dense (domain : Set V)
  weightHalfLaplacian : domain →ₗ[ℂ] V
  potentialOperator : domain →ₗ[ℂ] V

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

namespace AnalyticData

/-- The operator `Δ₁/₂ + V` on its common dense domain. -/
def totalOperator (D : AnalyticData V) : D.domain →ₗ[ℂ] V :=
  D.weightHalfLaplacian + D.potentialOperator

/-- Global zero-energy solution space of `Δ₁/₂ + V`. -/
def solutionSpace (D : AnalyticData V) : Submodule ℂ D.domain :=
  LinearMap.ker D.totalOperator

@[simp] theorem mem_solutionSpace_iff (D : AnalyticData V) (u : D.domain) :
    u ∈ D.solutionSpace ↔
      D.weightHalfLaplacian u + D.potentialOperator u = 0 := by
  rfl

end AnalyticData

/-- Corrected fibre `L(r)`: the kernel of the fixed geometric operator. -/
abbrev Fibre (D : AnalyticData V) (_r : RadiusBase) :=
  D.solutionSpace

/-- The representative-indexed spelling of the fibre.  The representative and
the proof `|q(τ)| = r` are parameters, but the resulting type is exactly the
global solution kernel and hence contains no hidden representative choice. -/
abbrev FibreAtRepresentative (D : AnalyticData V) (r : RadiusBase)
    (_τ : H) (_hτ : qRadiusPoint _τ = r) :=
  Fibre D r

/-- Canonical independence of the chosen upper-half-plane representative. -/
def representativeChange (D : AnalyticData V) (r : RadiusBase)
    (τ₁ τ₂ : H) (hτ₁ : qRadiusPoint τ₁ = r) (hτ₂ : qRadiusPoint τ₂ = r) :
    FibreAtRepresentative D r τ₁ hτ₁ ≃ₗ[ℂ]
      FibreAtRepresentative D r τ₂ hτ₂ :=
  LinearEquiv.refl ℂ _

@[simp] theorem representativeChange_apply (D : AnalyticData V)
    (r : RadiusBase) (τ₁ τ₂ : H)
    (hτ₁ : qRadiusPoint τ₁ = r) (hτ₂ : qRadiusPoint τ₂ = r)
    (u : FibreAtRepresentative D r τ₁ hτ₁) :
    representativeChange D r τ₁ τ₂ hτ₁ hτ₂ u = u :=
  rfl

/-- Flat transport between any two radius fibres in the corrected constant
solution local system. -/
def transport (D : AnalyticData V) (r s : RadiusBase) :
    Fibre D r ≃ₗ[ℂ] Fibre D s :=
  LinearEquiv.refl ℂ _

@[simp] theorem transport_apply (D : AnalyticData V) (r s : RadiusBase)
    (u : Fibre D r) : transport D r s u = u :=
  rfl

@[simp] theorem transport_refl (D : AnalyticData V) (r : RadiusBase) :
    transport D r r = LinearEquiv.refl ℂ (Fibre D r) :=
  rfl

theorem transport_trans (D : AnalyticData V) (r s t : RadiusBase) :
    (transport D r s).trans (transport D s t) = transport D r t :=
  rfl

/-- Sections of the corrected local system are locally constant maps into the
fixed solution kernel. -/
def localSectionPresheaf (D : AnalyticData V) : PresheafLike RadiusBase :=
  LocallyConstantValueSheaf.presheaf D.solutionSpace

/-- The corrected Definition 11 presheaf satisfies locality and unique gluing. -/
theorem localSectionPresheaf_isSheaf (D : AnalyticData V) :
    IsSheafLike (localSectionPresheaf D) :=
  LocallyConstantValueSheaf.isSheaf

/-- Every section is locally constant by construction. -/
theorem section_isLocallyConstant (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (localSectionPresheaf D).Section U) :
    IsLocallyConstant s.toFun :=
  s.isLocallyConstant

end


end Definition11

/-! ### §F.2.2 — Definitions 12–14: q-gauge variables and balanced equalizers. -/

/-- Generic interface consumed by Definitions 12–14.  The paper-facing,
non-placeholder instance is `Definition11.Lq` below; later constructions remain
polymorphic so they can also be tested against other certified local systems. -/
structure QLocalSystem (Open : Type u) [Preorder Open] where
  Fiber : Open → Type v
  res : ∀ {U V : Open}, U ≤ V → Fiber V → Fiber U
  res_id : ∀ (U : Open) (x : Fiber U), res (le_refl U) x = x
  res_comp :
    ∀ {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W) (x : Fiber W),
      res hUV (res hVW x) = res (le_trans hUV hVW) x

namespace Definition11

noncomputable section

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- The actual Definition 11 object in the legacy `QLocalSystem` interface. -/
def Lq (D : AnalyticData V) :
    QLocalSystem (TopologicalSpace.Opens RadiusBase) where
  Fiber U := (localSectionPresheaf D).Section U
  res hUV s := (localSectionPresheaf D).res hUV s
  res_id := (localSectionPresheaf D).res_id
  res_comp := (localSectionPresheaf D).res_comp

@[simp] theorem Lq_fiber (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase) :
    (Lq D).Fiber U = LocallyConstant U D.solutionSpace :=
  rfl

@[simp] theorem Lq_res_apply (D : AnalyticData V)
    {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W)
    (s : (Lq D).Fiber W) (x : U) :
    ((Lq D).res hUW s).toFun x = s.toFun ⟨x.1, hUW x.2⟩ :=
  rfl

theorem Lq_res_id (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase) (s : (Lq D).Fiber U) :
    (Lq D).res (le_refl U) s = s :=
  (Lq D).res_id U s

theorem Lq_res_comp (D : AnalyticData V)
    {U W Z : TopologicalSpace.Opens RadiusBase}
    (hUW : U ≤ W) (hWZ : W ≤ Z) (s : (Lq D).Fiber Z) :
    (Lq D).res hUW ((Lq D).res hWZ s) =
      (Lq D).res (le_trans hUW hWZ) s :=
  (Lq D).res_comp hUW hWZ s

/-- PR-facing certificate for every mathematically valid clause of Definition
11, together with the explicit obstruction to its invalid quotient formula. -/
structure Certificate (D : AnalyticData V) : Prop where
  base_interval : RadiusBase = Set.Ioo (0 : ℝ) 1
  upper_half_plane : H = _root_.UpperHalfPlane
  gamma_two : Gamma2 = CongruenceSubgroup.Gamma 2
  quotient_object :
    Gamma2Quotient = Quotient (MulAction.orbitRel Gamma2 H)
  q_radius_formula :
    ∀ τ : H, qRadius τ = Real.exp (-2 * Real.pi * τ.im)
  q_radius_in_base :
    ∀ τ : H, 0 < qRadius τ ∧ qRadius τ < 1
  representative_exists : Function.Surjective qRadiusPoint
  paper_pi_not_wellDefined : ¬ OriginalPiWellDefined
  common_domain_dense : Dense (D.domain : Set V)
  fibre_is_operator_kernel :
    ∀ (r : RadiusBase) (u : D.domain),
      u ∈ Fibre D r ↔
        D.weightHalfLaplacian u + D.potentialOperator u = 0
  representative_independence :
    ∀ (r : RadiusBase) (τ₁ τ₂ : H)
      (hτ₁ : qRadiusPoint τ₁ = r) (hτ₂ : qRadiusPoint τ₂ = r),
      Nonempty
        (FibreAtRepresentative D r τ₁ hτ₁ ≃ₗ[ℂ]
          FibreAtRepresentative D r τ₂ hτ₂)
  transport_identity :
    ∀ (r s : RadiusBase) (u : Fibre D r), transport D r s u = u
  transport_composition :
    ∀ r s t : RadiusBase,
      (transport D r s).trans (transport D s t) = transport D r t
  restriction_identity :
    ∀ (U : TopologicalSpace.Opens RadiusBase) (s : (Lq D).Fiber U),
      (Lq D).res (le_refl U) s = s
  restriction_composition :
    ∀ {U W Z : TopologicalSpace.Opens RadiusBase}
      (hUW : U ≤ W) (hWZ : W ≤ Z) (s : (Lq D).Fiber Z),
      (Lq D).res hUW ((Lq D).res hWZ s) =
        (Lq D).res (le_trans hUW hWZ) s
  every_section_locally_constant :
    ∀ (U : TopologicalSpace.Opens RadiusBase)
      (s : (localSectionPresheaf D).Section U),
      IsLocallyConstant s.toFun
  locally_constant_sheaf : IsSheafLike (localSectionPresheaf D)

/-- Unconditional Definition 11 certificate relative only to the explicit
Hilbert/operator datum `D`; no elliptic-regularity conclusion is assumed. -/
theorem certificate (D : AnalyticData V) : Certificate D :=
  { base_interval := rfl
    upper_half_plane := rfl
    gamma_two := rfl
    quotient_object := rfl
    q_radius_formula := qRadius_eq_exp_neg_two_pi_im
    q_radius_in_base := fun τ => ⟨qRadius_pos τ, qRadius_lt_one τ⟩
    representative_exists := qRadiusPoint_surjective
    paper_pi_not_wellDefined := originalPi_not_wellDefined
    common_domain_dense := D.domain_dense
    fibre_is_operator_kernel := fun _ => D.mem_solutionSpace_iff
    representative_independence := fun r τ₁ τ₂ hτ₁ hτ₂ =>
      ⟨representativeChange D r τ₁ τ₂ hτ₁ hτ₂⟩
    transport_identity := transport_apply D
    transport_composition := transport_trans D
    restriction_identity := Lq_res_id D
    restriction_composition := Lq_res_comp D
    every_section_locally_constant := section_isLocallyConstant D
    locally_constant_sheaf := localSectionPresheaf_isSheaf D }

end

end Definition11

/-- Abstract bundle/module of mock objects. -/
structure MockBundle (Open : Type u) [Preorder Open] where
  Section : Open → Type v
  res : ∀ {U V : Open}, U ≤ V → Section V → Section U
  res_id : ∀ (U : Open) (x : Section U), res (le_refl U) x = x
  res_comp :
    ∀ {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W) (x : Section W),
      res hUV (res hVW x) = res (le_trans hUV hVW) x

namespace MockBundle

/-- Expose a topological mock bundle through the lightweight sheaf API. -/
def toPresheafLike {X : Type u} [TopologicalSpace X]
    (M : MockBundle (TopologicalSpace.Opens X)) : PresheafLike X where
  Section := M.Section
  res := M.res
  res_id := M.res_id
  res_comp := M.res_comp

end MockBundle

/-- A mock bundle together with proved locality and unique gluing. -/
structure MockSheaf (X : Type u) [TopologicalSpace X] where
  toMockBundle : MockBundle.{u, u} (TopologicalSpace.Opens X)
  isSheaf : IsSheafLike
    (MockBundle.toPresheafLike (X := X) toMockBundle)

/-!
### The actual q-series sheaf `Mmock`

The paper's stalk notation `(f_r, S_r, G_r)` is represented by an actual triple
of complex coefficient sequences.  Evaluation uses `tsum`; convergence is a
`Summable` proposition.  The outside component is evaluated at `q⁻¹`, exactly
as in Proposition 12.  A certified germ carries both convergence on a common
annulus and the inside/outside identity, so those facts survive restriction and
gluing by construction rather than by an unstated analytic assumption.
-/

namespace Mmock

noncomputable section

/-- A normalized complex q-series, represented by its coefficient sequence.
Paper-level fractional prefactors and branch choices belong to the explicit
analytic realization supplied by `PaperAnalyticInput`. -/
abbrev QSeries := ℕ → ℂ

namespace QSeries

/-- The `n`th summand of a q-series at `q`. -/
def term (a : QSeries) (q : ℂ) (n : ℕ) : ℂ :=
  a n * q ^ n

/-- Convergence of the coefficient series at a complex parameter. -/
def ConvergesAt (a : QSeries) (q : ℂ) : Prop :=
  Summable (term a q)

/-- The value of a q-series, using Mathlib's topological infinite sum. -/
def sumAt (a : QSeries) (q : ℂ) : ℂ :=
  ∑' n : ℕ, term a q n

/-- The ordinary convergence region of a q-series. -/
def convergenceRegion (a : QSeries) : Set ℂ :=
  {q | a.ConvergesAt q}

/-- The region where the outside expression `G(q⁻¹)` is defined by a
convergent series. -/
def inverseConvergenceRegion (a : QSeries) : Set ℂ :=
  {q | q ≠ 0 ∧ a.ConvergesAt q⁻¹}

@[simp] theorem mem_convergenceRegion_iff (a : QSeries) (q : ℂ) :
    q ∈ a.convergenceRegion ↔ a.ConvergesAt q :=
  Iff.rfl

@[simp] theorem mem_inverseConvergenceRegion_iff (a : QSeries) (q : ℂ) :
    q ∈ a.inverseConvergenceRegion ↔ q ≠ 0 ∧ a.ConvergesAt q⁻¹ :=
  Iff.rfl

theorem zero_convergesAt (q : ℂ) :
    (0 : QSeries).ConvergesAt q := by
  change Summable (fun n : ℕ => (0 : ℂ) * q ^ n)
  simpa only [zero_mul] using
    (summable_zero : Summable (fun _ : ℕ => (0 : ℂ)))

@[simp] theorem zero_sumAt (q : ℂ) :
    (0 : QSeries).sumAt q = 0 := by
  simp [sumAt, term]

end QSeries

/-- A nonempty radial annulus crossing the unit circle.  This is the explicit
version of the paper's phrase "common annulus of convergence". -/
structure CommonAnnulus where
  inner : ℝ
  outer : ℝ
  inner_pos : 0 < inner
  inner_lt_one : inner < 1
  one_lt_outer : 1 < outer

namespace CommonAnnulus

/-- The complex points lying strictly between the two radii. -/
def carrier (A : CommonAnnulus) : Set ℂ :=
  {q | A.inner < ‖q‖ ∧ ‖q‖ < A.outer}

@[simp] theorem mem_carrier_iff (A : CommonAnnulus) (q : ℂ) :
    q ∈ A.carrier ↔ A.inner < ‖q‖ ∧ ‖q‖ < A.outer :=
  Iff.rfl

theorem inner_lt_outer (A : CommonAnnulus) : A.inner < A.outer :=
  lt_trans A.inner_lt_one A.one_lt_outer

theorem one_mem (A : CommonAnnulus) : (1 : ℂ) ∈ A.carrier := by
  change A.inner < ‖(1 : ℂ)‖ ∧ ‖(1 : ℂ)‖ < A.outer
  simpa using And.intro A.inner_lt_one A.one_lt_outer

theorem carrier_nonempty (A : CommonAnnulus) : A.carrier.Nonempty :=
  ⟨1, A.one_mem⟩

theorem ne_zero (A : CommonAnnulus) {q : ℂ} (hq : q ∈ A.carrier) :
    q ≠ 0 := by
  change A.inner < ‖q‖ ∧ ‖q‖ < A.outer at hq
  intro hq0
  subst q
  have hlt : A.inner < 0 := by simpa using hq.1
  exact (not_lt_of_ge A.inner_pos.le) hlt

end CommonAnnulus

/-- The paper's local q-series triple `(f_r, S_r, G_r)`. -/
structure SeriesTriple where
  inside : QSeries
  correction : QSeries
  outside : QSeries

/-- The unary-theta series fixed by the kernel and multiplier system. -/
structure KernelData where
  psi : QSeries

namespace SeriesTriple

/-- Convergence region of the inside series `f(q)`. -/
def insideConvergenceRegion (T : SeriesTriple) : Set ℂ :=
  T.inside.convergenceRegion

/-- Convergence region of the correction series `S(q)`. -/
def correctionConvergenceRegion (T : SeriesTriple) : Set ℂ :=
  T.correction.convergenceRegion

/-- Convergence region of the outside expression `G(q⁻¹)`. -/
def outsideConvergenceRegion (T : SeriesTriple) : Set ℂ :=
  T.outside.inverseConvergenceRegion

@[simp] theorem mem_insideConvergenceRegion_iff
    (T : SeriesTriple) (q : ℂ) :
    q ∈ T.insideConvergenceRegion ↔ T.inside.ConvergesAt q :=
  Iff.rfl

@[simp] theorem mem_correctionConvergenceRegion_iff
    (T : SeriesTriple) (q : ℂ) :
    q ∈ T.correctionConvergenceRegion ↔ T.correction.ConvergesAt q :=
  Iff.rfl

@[simp] theorem mem_outsideConvergenceRegion_iff
    (T : SeriesTriple) (q : ℂ) :
    q ∈ T.outsideConvergenceRegion ↔
      q ≠ 0 ∧ T.outside.ConvergesAt q⁻¹ :=
  Iff.rfl

end SeriesTriple

namespace KernelData

/-- Convergence region of the fixed unary-theta block `psi(q)`. -/
def psiConvergenceRegion (K : KernelData) : Set ℂ :=
  K.psi.convergenceRegion

@[simp] theorem mem_psiConvergenceRegion_iff
    (K : KernelData) (q : ℂ) :
    q ∈ K.psiConvergenceRegion ↔ K.psi.ConvergesAt q :=
  Iff.rfl

end KernelData

/-- Simultaneous convergence of `f(q)`, `psi(q)`, `S(q)`, and `G(q⁻¹)`. -/
def commonConvergenceRegion (K : KernelData) (T : SeriesTriple) : Set ℂ :=
  {q |
    q ∈ T.insideConvergenceRegion ∧
    q ∈ K.psiConvergenceRegion ∧
    q ∈ T.correctionConvergenceRegion ∧
    q ∈ T.outsideConvergenceRegion}

@[simp] theorem mem_commonConvergenceRegion_iff
    (K : KernelData) (T : SeriesTriple) (q : ℂ) :
    q ∈ commonConvergenceRegion K T ↔
      T.inside.ConvergesAt q ∧
      K.psi.ConvergesAt q ∧
      T.correction.ConvergesAt q ∧
      q ≠ 0 ∧ T.outside.ConvergesAt q⁻¹ :=
  Iff.rfl

/-- Proposition 12's series-level identity on a specified annulus. -/
def MatchesOn (K : KernelData) (T : SeriesTriple)
    (A : CommonAnnulus) : Prop :=
  ∀ ⦃q : ℂ⦄, q ∈ A.carrier →
    T.outside.sumAt q⁻¹ =
      (2 : ℂ) * K.psi.sumAt q - T.correction.sumAt q

/-- A stalk element of the actual `Mmock` sheaf.  All convergence and matching
obligations are data of the germ, not global assumptions. -/
structure CertifiedGerm (K : KernelData) where
  series : SeriesTriple
  annulus : CommonAnnulus
  annulus_converges :
    annulus.carrier ⊆ commonConvergenceRegion K series
  «matches» : MatchesOn K series annulus

namespace CertifiedGerm

variable {K : KernelData}

theorem common_convergence (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    q ∈ commonConvergenceRegion K g.series :=
  g.annulus_converges hq

theorem inside_converges (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    g.series.inside.ConvergesAt q :=
  (g.common_convergence hq).1

theorem psi_converges (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    K.psi.ConvergesAt q :=
  (g.common_convergence hq).2.1

theorem correction_converges (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    g.series.correction.ConvergesAt q :=
  (g.common_convergence hq).2.2.1

theorem outside_ne_zero (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) : q ≠ 0 :=
  (g.common_convergence hq).2.2.2.1

theorem outside_converges (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    g.series.outside.ConvergesAt q⁻¹ :=
  (g.common_convergence hq).2.2.2.2

theorem matching_identity (g : CertifiedGerm K) {q : ℂ}
    (hq : q ∈ g.annulus.carrier) :
    g.series.outside.sumAt q⁻¹ =
      (2 : ℂ) * K.psi.sumAt q - g.series.correction.sumAt q :=
  g.«matches» hq

/-- The matching equation determines the outside value pointwise once `psi`
and the correction value are fixed.  Analytic equality of coefficient series
would additionally require an identity theorem, which is not smuggled in here. -/
theorem outside_value_unique (g₁ g₂ : CertifiedGerm K) {q : ℂ}
    (hq₁ : q ∈ g₁.annulus.carrier)
    (hq₂ : q ∈ g₂.annulus.carrier)
    (hS : g₁.series.correction.sumAt q =
      g₂.series.correction.sumAt q) :
    g₁.series.outside.sumAt q⁻¹ =
      g₂.series.outside.sumAt q⁻¹ := by
  calc
    g₁.series.outside.sumAt q⁻¹ =
        (2 : ℂ) * K.psi.sumAt q -
          g₁.series.correction.sumAt q :=
      g₁.matching_identity hq₁
    _ = (2 : ℂ) * K.psi.sumAt q -
        g₂.series.correction.sumAt q :=
      congrArg (fun z : ℂ => (2 : ℂ) * K.psi.sumAt q - z) hS
    _ = g₂.series.outside.sumAt q⁻¹ :=
      (g₂.matching_identity hq₂).symm

end CertifiedGerm

/-- A concrete common annulus used by the unconditional zero-series model. -/
def zeroCommonAnnulus : CommonAnnulus where
  inner := (1 / 2 : ℝ)
  outer := 2
  inner_pos := by norm_num
  inner_lt_one := by norm_num
  one_lt_outer := by norm_num

/-- The fixed zero unary-theta kernel. -/
def zeroKernel : KernelData where
  psi := 0

/-- The zero inside, correction, and outside series. -/
def zeroSeriesTriple : SeriesTriple where
  inside := 0
  correction := 0
  outside := 0

/-- Fully constructed, assumption-free stalk data for the corrected zero-series
model. -/
def zeroCertifiedGerm : CertifiedGerm zeroKernel where
  series := zeroSeriesTriple
  annulus := zeroCommonAnnulus
  annulus_converges := by
    intro q hq
    exact
      ⟨QSeries.zero_convergesAt q,
        QSeries.zero_convergesAt q,
        QSeries.zero_convergesAt q,
        ⟨zeroCommonAnnulus.ne_zero hq,
          QSeries.zero_convergesAt q⁻¹⟩⟩
  «matches» := by
    intro q _hq
    simp [zeroKernel, zeroSeriesTriple]

/-- The radius interval on which the paper places `Mmock`. -/
abbrev RadiusBase := Definition11.RadiusBase

/-- A complex q-parameter lying on the circle of radius `r`. -/
abbrev RadiusPoint (r : RadiusBase) :=
  {q : ℂ // ‖q‖ = r.1}

/-- Local families `(f_r, S_r, G_r)` whose certified coefficient data are
locally constant in the radius variable. -/
abbrev LocalSection (K : KernelData)
    (U : TopologicalSpace.Opens RadiusBase) :=
  LocallyConstant U (CertifiedGerm K)

namespace LocalSection

variable {K : KernelData} {U : TopologicalSpace.Opens RadiusBase}

/-- The certified germ selected by a local section at radius `r`. -/
def germAt (s : LocalSection K U) (r : U) : CertifiedGerm K :=
  s r

/-- The inside coefficient series `f_r`. -/
def insideAt (s : LocalSection K U) (r : U) : QSeries :=
  (s.germAt r).series.inside

/-- The correction coefficient series `S_r`. -/
def correctionAt (s : LocalSection K U) (r : U) : QSeries :=
  (s.germAt r).series.correction

/-- The outside coefficient series `G_r`. -/
def outsideAt (s : LocalSection K U) (r : U) : QSeries :=
  (s.germAt r).series.outside

/-- The evaluated inside value `f_r(q)` at `|q| = r`. -/
def insideValueAtRadius (s : LocalSection K U) (r : U)
    (q : RadiusPoint r.1) : ℂ :=
  (s.insideAt r).sumAt q.1

/-- The evaluated correction value `S_r(q)` at `|q| = r`. -/
def correctionValueAtRadius (s : LocalSection K U) (r : U)
    (q : RadiusPoint r.1) : ℂ :=
  (s.correctionAt r).sumAt q.1

/-- The evaluated outside value `G_r(q⁻¹)` at `|q| = r`. -/
def outsideValueAtRadius (s : LocalSection K U) (r : U)
    (q : RadiusPoint r.1) : ℂ :=
  (s.outsideAt r).sumAt q.1⁻¹

@[simp] theorem germAt_apply (s : LocalSection K U) (r : U) :
    s.germAt r = s r :=
  rfl

@[simp] theorem insideAt_apply (s : LocalSection K U) (r : U) :
    s.insideAt r = (s r).series.inside :=
  rfl

@[simp] theorem correctionAt_apply (s : LocalSection K U) (r : U) :
    s.correctionAt r = (s r).series.correction :=
  rfl

@[simp] theorem outsideAt_apply (s : LocalSection K U) (r : U) :
    s.outsideAt r = (s r).series.outside :=
  rfl

theorem common_annulus_nonempty (s : LocalSection K U) (r : U) :
    (s r).annulus.carrier.Nonempty :=
  (s r).annulus.carrier_nonempty

theorem inside_converges (s : LocalSection K U) (r : U) {q : ℂ}
    (hq : q ∈ (s r).annulus.carrier) :
    (s.insideAt r).ConvergesAt q :=
  (s r).inside_converges hq

theorem psi_converges (s : LocalSection K U) (r : U) {q : ℂ}
    (hq : q ∈ (s r).annulus.carrier) :
    K.psi.ConvergesAt q :=
  (s r).psi_converges hq

theorem correction_converges (s : LocalSection K U) (r : U) {q : ℂ}
    (hq : q ∈ (s r).annulus.carrier) :
    (s.correctionAt r).ConvergesAt q :=
  (s r).correction_converges hq

theorem outside_converges (s : LocalSection K U) (r : U) {q : ℂ}
    (hq : q ∈ (s r).annulus.carrier) :
    (s.outsideAt r).ConvergesAt q⁻¹ :=
  (s r).outside_converges hq

/-- Every local family satisfies `G_r(q⁻¹) = 2 psi(q) - S_r(q)` on its
certified common annulus. -/
theorem matching_identity (s : LocalSection K U) (r : U) {q : ℂ}
    (hq : q ∈ (s r).annulus.carrier) :
    (s.outsideAt r).sumAt q⁻¹ =
      (2 : ℂ) * K.psi.sumAt q - (s.correctionAt r).sumAt q :=
  (s r).matching_identity hq

/-- Radius-indexed form of the paper's displayed matching identity. -/
theorem matching_at_radius (s : LocalSection K U) (r : U)
    (q : RadiusPoint r.1)
    (hq : q.1 ∈ (s r).annulus.carrier) :
    s.outsideValueAtRadius r q =
      (2 : ℂ) * K.psi.sumAt q.1 - s.correctionValueAtRadius r q :=
  (s r).matching_identity hq

end LocalSection

/-- The q-series presheaf underlying the actual `Mmock` sheaf. -/
def presheaf (K : KernelData) : PresheafLike RadiusBase :=
  LocallyConstantValueSheaf.presheaf (CertifiedGerm K)

@[simp] theorem presheaf_section (K : KernelData)
    (U : TopologicalSpace.Opens RadiusBase) :
    (presheaf K).Section U = LocalSection K U :=
  rfl

@[simp] theorem presheaf_res_apply (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (presheaf K).Section V) (r : U) :
    ((presheaf K).res hUV s).toFun r = s.toFun ⟨r.1, hUV r.2⟩ :=
  rfl

/-- Locality and unique gluing for the actual q-series presheaf. -/
theorem isSheaf (K : KernelData) : IsSheafLike (presheaf K) :=
  LocallyConstantValueSheaf.isSheaf (F := CertifiedGerm K)

/-- The actual q-series presheaf in the legacy `MockBundle` interface. -/
