/-- The exact image of the q-gauge embedding inside the connection carrier. -/
abbrev ZeroModelConnectionImage (U : Opens) :=
  {A : Proposition17And18FinalSpecialization.Connection U // A.2 = 0}

/-- The q-gauge field is not merely mapped into the connection carrier: it is
canonically equivalent to the precisely specified zero-DGA-component image. -/
def qGaugeEquivZeroModelConnectionImage (U : Opens) :
    Proposition20ActualQGaugeSpecialization.Aq U ≃
      ZeroModelConnectionImage U where
  toFun A := ⟨qGaugeToConnection_zeroModel A, rfl⟩
  invFun A := A.1.1
  left_inv A := rfl
  right_inv A := by
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · exact A.2.symm

theorem qGaugeToConnection_zeroModel_injective (U : Opens) :
    Function.Injective
      (qGaugeToConnection_zeroModel :
        Proposition20ActualQGaugeSpecialization.Aq U →
          Proposition17And18FinalSpecialization.Connection U) := by
  intro A B hAB
  exact congrArg Prod.fst hAB

/-- The embedding is a presheaf morphism at the level of section functions. -/
theorem qGaugeToConnection_zeroModel_restrict
    {U V : Opens} (hUV : U ≤ V)
    (A : Proposition20ActualQGaugeSpecialization.Aq V) :
    Proposition17And18FinalSpecialization.connectionPresheaf.res hUV
        (qGaugeToConnection_zeroModel A) =
      qGaugeToConnection_zeroModel
        (Proposition20ActualQGaugeSpecialization.AqPresheaf.res hUV A) := by
  apply Prod.ext
  · rfl
  · apply LocallyConstant.ext
    intro x
    rfl

/-- The chosen zero-DGA-component embedding has literal zero curvature. -/
theorem qGaugeToConnection_zeroModel_curvature_eq_zero
    {U : Opens} (A : Proposition20ActualQGaugeSpecialization.Aq U) :
    Proposition17And18FinalSpecialization.connectionCurvature
        (qGaugeToConnection_zeroModel A) = 0 := by
  apply LocallyConstant.ext
  intro x
  change
    PolynomialMatrixDifferentialForms.matrixDifferential
          (0 : Proposition17And18FinalSpecialization.FormFibre 1) +
        PolynomialMatrixDifferentialForms.matrixWedge
          (0 : Proposition17And18FinalSpecialization.FormFibre 1)
          (0 : Proposition17And18FinalSpecialization.FormFibre 1) = 0
  rw [PolynomialMatrixDifferentialForms.matrixDifferential_zero]
  apply Matrix.ext
  intro i j
  apply PolynomialMatrixDifferentialForms.ChartForm.ext <;>
    simp [PolynomialMatrixDifferentialForms.matrixWedge, Fin.sum_univ_two]

/-- Exact additional datum needed to identify a modular q-gauge one-form with
the polynomial-matrix DGA component used by the concrete curvature model.  The
