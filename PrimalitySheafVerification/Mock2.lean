/-! ### Checklist 6.3: admissible gauge transformations -/

namespace SmoothOneForm

/-- Pointwise addition of smooth Lie-algebra-valued one-forms. -/
def add (U : Opens) (A C : SmoothOneForm I_G G U) :
    SmoothOneForm I_G G U where
  toFun := fun τ => A τ + C τ
  smooth_toFun := A.smooth_toFun.add C.smooth_toFun

/-- Pointwise negation of a smooth Lie-algebra-valued one-form. -/
def neg (U : Opens) (A : SmoothOneForm I_G G U) :
    SmoothOneForm I_G G U where
  toFun := fun τ => -A τ
  smooth_toFun := A.smooth_toFun.neg

instance smoothOneFormAddCommGroup (U : Opens) :
    AddCommGroup (SmoothOneForm I_G G U) where
  zero := zero I_G G U
  add := add I_G G U
  neg := neg I_G G U
  nsmul := @nsmulRec (SmoothOneForm I_G G U)
    ⟨zero I_G G U⟩ ⟨add I_G G U⟩
  zsmul := @zsmulRec (SmoothOneForm I_G G U)
    ⟨zero I_G G U⟩ ⟨add I_G G U⟩ ⟨neg I_G G U⟩
    (@nsmulRec (SmoothOneForm I_G G U)
      ⟨zero I_G G U⟩ ⟨add I_G G U⟩)
  add_zero A := by
    apply ext_pointwise
    intro τ
    exact add_zero (A τ)
  zero_add A := by
    apply ext_pointwise
    intro τ
    exact zero_add (A τ)
  add_comm A C := by apply ext_pointwise; intro τ; exact add_comm _ _
  add_assoc A C D := by apply ext_pointwise; intro τ; exact add_assoc _ _ _
  neg_add_cancel A := by
    apply ext_pointwise
    intro τ
    exact neg_add_cancel (A τ)

@[simp] theorem add_apply (U : Opens) (A C : SmoothOneForm I_G G U)
    (τ : coverOpen U) : (A + C) τ = A τ + C τ :=
  rfl

@[simp] theorem neg_apply (U : Opens) (A : SmoothOneForm I_G G U)
    (τ : coverOpen U) : (-A) τ = -A τ :=
  rfl

theorem restrict_add {V U : Opens} (hVU : V ≤ U)
    (A C : SmoothOneForm I_G G U) :
    restrict I_G G hVU (A + C) =
      restrict I_G G hVU A + restrict I_G G hVU C := by
  apply ext_pointwise
  intro τ
  rfl

theorem restrict_neg {V U : Opens} (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U) :
    restrict I_G G hVU (-A) = -restrict I_G G hVU A := by
  apply ext_pointwise
  intro τ
  rfl

end SmoothOneForm

theorem deckPullback_add (γ : Gamma2) (U : Opens)
    (A C : SmoothOneForm I_G G U) :
    deckPullback I_G G γ U (A + C) =
      deckPullback I_G G γ U A + deckPullback I_G G γ U C := by
  apply SmoothOneForm.ext_pointwise
  intro τ
  apply ContinuousLinearMap.ext
  intro v
  rfl

theorem deckPullback_neg (γ : Gamma2) (U : Opens)
    (A : SmoothOneForm I_G G U) :
    deckPullback I_G G γ U (-A) = -deckPullback I_G G γ U A := by
  apply SmoothOneForm.ext_pointwise
  intro τ
  apply ContinuousLinearMap.ext
  intro v
  rfl

theorem equation62_add (U : Opens) (A C : SmoothOneForm I_G G U)
    (hA : Equation62 I_G G M U A)
    (hC : Equation62 I_G G M U C) :
    Equation62 I_G G M U (A + C) := by
  intro γ τ
  rw [show deckPullback I_G G γ U (A + C) =
      deckPullback I_G G γ U A + deckPullback I_G G γ U C by
    exact deckPullback_add I_G G γ U A C]
  change
    deckPullback I_G G γ U A τ + deckPullback I_G G γ U C τ =
      (M.automorphyFactor γ (τ : H) : ℂ) • (A τ + C τ)
  rw [hA γ τ, hC γ τ]
  exact (smul_add _ _ _).symm

theorem equation62_neg (U : Opens) (A : SmoothOneForm I_G G U)
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M U (-A) := by
  intro γ τ
  rw [show deckPullback I_G G γ U (-A) =
      -deckPullback I_G G γ U A by
    exact deckPullback_neg I_G G γ U A]
  change
    -deckPullback I_G G γ U A τ =
      (M.automorphyFactor γ (τ : H) : ℂ) • (-A τ)
  rw [hA γ τ]
  exact (smul_neg _ _).symm

/-- A genuinely smooth local gauge map `g : π⁻¹(U) → G`.  Its inverse is
the pointwise group inverse and is proved smooth below. -/
structure SmoothGaugeMap (U : Opens) where
  toFun : coverOpen U → G
  smooth_toFun : ContMDiff 𝓘(ℂ) I_G ∞ toFun

namespace SmoothGaugeMap

instance smoothGaugeMapCoeFun (U : Opens) : CoeFun (SmoothGaugeMap I_G G U)
    (fun _ => coverOpen U → G) :=
  ⟨SmoothGaugeMap.toFun⟩

@[ext] theorem ext {U : Opens} {g h : SmoothGaugeMap I_G G U}
    (hfun : g.toFun = h.toFun) : g = h := by
  cases g
  cases h
  cases hfun
  rfl

theorem ext_pointwise {U : Opens} {g h : SmoothGaugeMap I_G G U}
    (hfun : ∀ τ, g τ = h τ) : g = h :=
  SmoothGaugeMap.ext I_G G (funext hfun)

/-- Identity smooth gauge map. -/
noncomputable def identity (U : Opens) : SmoothGaugeMap I_G G U where
  toFun := fun _ => 1
  smooth_toFun := contMDiff_const

/-- A constant smooth gauge map.  These maps provide non-vacuous concrete
witnesses for the differential formulas below. -/
def constant (U : Opens) (a : G) : SmoothGaugeMap I_G G U where
  toFun := fun _ => a
  smooth_toFun := contMDiff_const

/-- Pointwise composition/product of smooth gauge maps. -/
def comp {U : Opens} (g h : SmoothGaugeMap I_G G U) :
    SmoothGaugeMap I_G G U where
  toFun := fun τ => g τ * h τ
  smooth_toFun := g.smooth_toFun.mul h.smooth_toFun

/-- Pointwise inverse of a smooth gauge map. -/
def inverse {U : Opens} (g : SmoothGaugeMap I_G G U) :
    SmoothGaugeMap I_G G U where
  toFun := fun τ => (g τ)⁻¹
  smooth_toFun := g.smooth_toFun.inv

/-- Restriction of a smooth gauge map. -/
noncomputable def restrict {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U) :
    SmoothGaugeMap I_G G V where
  toFun := g.toFun ∘ SmoothOneForm.coverInclusion hVU
  smooth_toFun := g.smooth_toFun.comp
    (SmoothOneForm.coverInclusion_contMDiff hVU)

@[simp] theorem identity_apply (U : Opens) (τ : coverOpen U) :
    identity I_G G U τ = 1 :=
  rfl

@[simp] theorem constant_apply (U : Opens) (a : G) (τ : coverOpen U) :
    constant I_G G U a τ = a :=
  rfl

@[simp] theorem comp_apply {U : Opens} (g h : SmoothGaugeMap I_G G U)
    (τ : coverOpen U) : comp I_G G g h τ = g τ * h τ :=
  rfl

@[simp] theorem inverse_apply {U : Opens} (g : SmoothGaugeMap I_G G U)
    (τ : coverOpen U) : inverse I_G G g τ = (g τ)⁻¹ :=
  rfl

/-- The pointwise inverse constructed above is genuinely smooth. -/
theorem inverse_smooth {U : Opens} (g : SmoothGaugeMap I_G G U) :
    ContMDiff 𝓘(ℂ) I_G ∞ (inverse I_G G g).toFun :=
  (inverse I_G G g).smooth_toFun

@[simp] theorem restrict_apply {V U : Opens} (hVU : V ≤ U)
    (g : SmoothGaugeMap I_G G U) (τ : coverOpen V) :
    restrict I_G G hVU g τ = g (SmoothOneForm.coverInclusion hVU τ) :=
  rfl

@[simp] theorem comp_identity_left {U : Opens} (g : SmoothGaugeMap I_G G U) :
    comp I_G G (identity I_G G U) g = g := by
  apply ext_pointwise
  intro τ
  simp

@[simp] theorem comp_identity_right {U : Opens} (g : SmoothGaugeMap I_G G U) :
    comp I_G G g (identity I_G G U) = g := by
  apply ext_pointwise
  intro τ
  simp

@[simp] theorem comp_constant (U : Opens) (a b : G) :
    comp I_G G (constant I_G G U a) (constant I_G G U b) =
      constant I_G G U (a * b) := by
  apply ext_pointwise
  intro τ
  rfl

@[simp] theorem inverse_constant (U : Opens) (a : G) :
    inverse I_G G (constant I_G G U a) = constant I_G G U a⁻¹ := by
  apply ext_pointwise
  intro τ
  rfl

@[simp] theorem inverse_comp {U : Opens} (g : SmoothGaugeMap I_G G U) :
    comp I_G G (inverse I_G G g) g = identity I_G G U := by
  apply ext_pointwise
  intro τ
  simp

@[simp] theorem comp_inverse {U : Opens} (g : SmoothGaugeMap I_G G U) :
    comp I_G G g (inverse I_G G g) = identity I_G G U := by
  apply ext_pointwise
  intro τ
  simp

@[simp] theorem restrict_identity {V U : Opens} (hVU : V ≤ U) :
    restrict I_G G hVU (identity I_G G U) = identity I_G G V := by
  apply ext_pointwise
  intro τ
  rfl

theorem restrict_comp {V U : Opens} (hVU : V ≤ U)
    (g h : SmoothGaugeMap I_G G U) :
    restrict I_G G hVU (comp I_G G g h) =
      comp I_G G (restrict I_G G hVU g) (restrict I_G G hVU h) := by
  apply ext_pointwise
  intro τ
  rfl

theorem restrict_inverse {V U : Opens} (hVU : V ≤ U)
    (g : SmoothGaugeMap I_G G U) :
    restrict I_G G hVU (inverse I_G G g) =
      inverse I_G G (restrict I_G G hVU g) := by
  apply ext_pointwise
  intro τ
  rfl

@[simp] theorem restrict_constant {V U : Opens} (hVU : V ≤ U) (a : G) :
    restrict I_G G hVU (constant I_G G U a) = constant I_G G V a := by
  apply ext_pointwise
  intro τ
  rfl

/-- Strict invariance under every deck transformation. -/
def DeckInvariant {U : Opens} (g : SmoothGaugeMap I_G G U) : Prop :=
  ∀ (γ : Gamma2) (τ : coverOpen U), g (coverDeckMap γ U τ) = g τ

/-- `ρ`-compatibility by conjugation on the pulled-back cover. -/
def RhoCompatible (ρ : Gamma2 →* G) {U : Opens}
    (g : SmoothGaugeMap I_G G U) : Prop :=
  ∀ (γ : Gamma2) (τ : coverOpen U),
    g (coverDeckMap γ U τ) = (ρ γ)⁻¹ * g τ * ρ γ

/-- Pointwise centrality; in this sector `g⁻¹ A g = A`. -/
def Central {U : Opens} (g : SmoothGaugeMap I_G G U) : Prop :=
  ∀ (τ : coverOpen U) (x : G), Commute (g τ) x

theorem deckInvariant_identity (U : Opens) :
    DeckInvariant I_G G (identity I_G G U) := by
  intro γ τ
  rfl

theorem deckInvariant_constant (U : Opens) (a : G) :
    DeckInvariant I_G G (constant I_G G U a) := by
  intro γ τ
  rfl

theorem deckInvariant_comp {U : Opens} {g h : SmoothGaugeMap I_G G U}
    (hg : DeckInvariant I_G G g) (hh : DeckInvariant I_G G h) :
    DeckInvariant I_G G (comp I_G G g h) := by
  intro γ τ
  rw [comp_apply, comp_apply, hg γ τ, hh γ τ]

theorem deckInvariant_inverse {U : Opens} {g : SmoothGaugeMap I_G G U}
    (hg : DeckInvariant I_G G g) : DeckInvariant I_G G (inverse I_G G g) := by
  intro γ τ
  rw [inverse_apply, inverse_apply, hg γ τ]

theorem deckInvariant_restrict {V U : Opens} (hVU : V ≤ U)
    {g : SmoothGaugeMap I_G G U} (hg : DeckInvariant I_G G g) :
    DeckInvariant I_G G (restrict I_G G hVU g) := by
  intro γ τ
  rw [restrict_apply, restrict_apply, coverInclusion_coverDeckMap]
  exact hg γ (SmoothOneForm.coverInclusion hVU τ)

theorem central_identity (U : Opens) : Central I_G G (identity I_G G U) := by
  intro τ x
  exact Commute.one_left x

theorem central_comp {U : Opens} {g h : SmoothGaugeMap I_G G U}
    (hg : Central I_G G g) (hh : Central I_G G h) : Central I_G G (comp I_G G g h) := by
  intro τ x
  exact (hg τ x).mul_left (hh τ x)

theorem central_inverse {U : Opens} {g : SmoothGaugeMap I_G G U}
    (hg : Central I_G G g) : Central I_G G (inverse I_G G g) := by
  intro τ x
  exact (hg τ x).inv_left

theorem central_restrict {V U : Opens} (hVU : V ≤ U)
    {g : SmoothGaugeMap I_G G U} (hg : Central I_G G g) :
    Central I_G G (restrict I_G G hVU g) := by
  intro τ x
  exact hg (SmoothOneForm.coverInclusion hVU τ) x

theorem rhoCompatible_identity (ρ : Gamma2 →* G) (U : Opens) :
    RhoCompatible I_G G ρ (identity I_G G U) := by
  intro γ τ
  simp

theorem rhoCompatible_comp (ρ : Gamma2 →* G) {U : Opens}
    {g h : SmoothGaugeMap I_G G U}
    (hg : RhoCompatible I_G G ρ g) (hh : RhoCompatible I_G G ρ h) :
    RhoCompatible I_G G ρ (comp I_G G g h) := by
  intro γ τ
  rw [comp_apply, comp_apply, hg γ τ, hh γ τ]
  group

theorem rhoCompatible_inverse (ρ : Gamma2 →* G) {U : Opens}
    {g : SmoothGaugeMap I_G G U} (hg : RhoCompatible I_G G ρ g) :
    RhoCompatible I_G G ρ (inverse I_G G g) := by
  intro γ τ
  rw [inverse_apply, inverse_apply, hg γ τ]
  group

theorem rhoCompatible_restrict (ρ : Gamma2 →* G)
    {V U : Opens} (hVU : V ≤ U) {g : SmoothGaugeMap I_G G U}
    (hg : RhoCompatible I_G G ρ g) :
    RhoCompatible I_G G ρ (restrict I_G G hVU g) := by
  intro γ τ
  rw [restrict_apply, restrict_apply, coverInclusion_coverDeckMap]
  exact hg γ (SmoothOneForm.coverInclusion hVU τ)

theorem rhoCompatible_of_deckInvariant_of_central
    (ρ : Gamma2 →* G) {U : Opens} {g : SmoothGaugeMap I_G G U}
    (hdeck : DeckInvariant I_G G g) (hcentral : Central I_G G g) :
    RhoCompatible I_G G ρ g := by
  intro γ τ
  rw [hdeck γ τ]
  have hcomm := hcentral τ (ρ γ)
  calc
    g τ = (ρ γ)⁻¹ * (ρ γ * g τ) := by simp
    _ = (ρ γ)⁻¹ * (g τ * ρ γ) := by rw [← hcomm.eq]
    _ = (ρ γ)⁻¹ * g τ * ρ γ := by rw [mul_assoc]

end SmoothGaugeMap

/-- The adjoint action on `𝔤 = T₁G`, defined as the manifold derivative at the
identity of the literal conjugation map `x ↦ a⁻¹xa`. -/
noncomputable def gaugeAdjointValue (a : G) :
    E_G →L[ℂ] E_G :=
  mfderiv I_G I_G (fun x : G => a⁻¹ * x * a) 1

/-- The pointwise left logarithmic derivative `g⁻¹dg`: first differentiate
`g`, then identify `T_gG` with `T₁G` by differentiating left multiplication by
`g⁻¹`.  This is the literal Maurer-Cartan value, not an uninterpreted symbol. -/
noncomputable def leftLogarithmicDerivativeValue {U : Opens}
    (g : SmoothGaugeMap I_G G U) (τ : coverOpen U) : OneFormValue I_G G :=
  (mfderiv I_G I_G (fun x : G => (g τ)⁻¹ * x) (g τ)).comp
    (mfderiv 𝓘(ℂ) I_G g.toFun τ)

/-- A central element has trivial adjoint action.  The proof unfolds the
conjugation map, identifies it with `id`, and differentiates that equality. -/
theorem gaugeAdjointValue_eq_id_of_central (a : G)
    (ha : ∀ x : G, Commute a x) :
    gaugeAdjointValue I_G G a =
      ContinuousLinearMap.id ℂ E_G := by
  have hconj : (fun x : G => a⁻¹ * x * a) = id := by
    funext x
    calc
      a⁻¹ * x * a = a⁻¹ * (x * a) := mul_assoc _ _ _
      _ = a⁻¹ * (a * x) := by rw [← (ha x).eq]
      _ = x := by simp
  unfold gaugeAdjointValue
  change
    mfderiv I_G I_G (fun x : G => a⁻¹ * x * a) 1 =
      ContinuousLinearMap.id ℂ (GaugeLieAlgebra I_G G)
  rw [mfderiv_congr hconj, mfderiv_id]

/-- Constant gauges have zero literal left logarithmic derivative. -/
@[simp] theorem leftLogarithmicDerivativeValue_constant (U : Opens)
    (a : G) (τ : coverOpen U) :
    leftLogarithmicDerivativeValue I_G G
      (SmoothGaugeMap.constant I_G G U a) τ = 0 := by
  change
    (mfderiv I_G I_G (fun x : G => a⁻¹ * x) a).comp
      (mfderiv 𝓘(ℂ) I_G (fun _ : coverOpen U => a) τ) = 0
  rw [mfderiv_const]
  exact ContinuousLinearMap.comp_zero _

/-- Certified differential calculus for the Maurer-Cartan term.  In addition
to the four functorial laws needed for admissibility closure, `maurerCartan_formula`
forces every assigned form to equal the literal manifold derivative above.
Thus an implementation cannot use an arbitrary zero form for nonconstant
gauges, and no equation-(6.2) preservation conclusion is stored here. -/
structure MaurerCartanCalculus where
  maurerCartan :
    ∀ (U : Opens), SmoothGaugeMap I_G G U → SmoothOneForm I_G G U
  maurerCartan_formula :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U) (τ : coverOpen U),
      maurerCartan U g τ = leftLogarithmicDerivativeValue I_G G g τ
  maurerCartan_identity :
    ∀ U : Opens,
      maurerCartan U (SmoothGaugeMap.identity I_G G U) = 0
  maurerCartan_comp :
    ∀ (U : Opens) (g h : SmoothGaugeMap I_G G U),
      SmoothGaugeMap.Central I_G G g → SmoothGaugeMap.Central I_G G h →
        maurerCartan U (SmoothGaugeMap.comp I_G G g h) =
          maurerCartan U g + maurerCartan U h
  maurerCartan_inverse :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      SmoothGaugeMap.Central I_G G g →
        maurerCartan U (SmoothGaugeMap.inverse I_G G g) =
          -maurerCartan U g
  maurerCartan_restrict :
    ∀ {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U),
      maurerCartan V (SmoothGaugeMap.restrict I_G G hVU g) =
        SmoothOneForm.restrict I_G G hVU (maurerCartan U g)

/-- Exact admissibility: centrality, `ρ`-compatibility of the smooth map, and
equation (6.2) for the Maurer-Cartan term itself.  No connection `A` occurs in
this definition, so preservation is not assumed circularly. -/
def GaugeAdmissible (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) (U : Opens) (g : SmoothGaugeMap I_G G U) : Prop :=
  SmoothGaugeMap.Central I_G G g ∧
    SmoothGaugeMap.RhoCompatible I_G G ρ g ∧
      Equation62 I_G G M U (D.maurerCartan U g)

namespace GaugeAdmissible

theorem identity (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) (U : Opens) :
    GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.identity I_G G U) := by
  refine ⟨SmoothGaugeMap.central_identity I_G G U,
    SmoothGaugeMap.rhoCompatible_identity I_G G ρ U, ?_⟩
  rw [D.maurerCartan_identity U]
  exact zero_covariant I_G G M U

theorem comp (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) {U : Opens} {g h : SmoothGaugeMap I_G G U}
    (hg : GaugeAdmissible I_G G M D ρ U g)
    (hh : GaugeAdmissible I_G G M D ρ U h) :
    GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.comp I_G G g h) := by
  refine ⟨SmoothGaugeMap.central_comp I_G G hg.1 hh.1,
    SmoothGaugeMap.rhoCompatible_comp I_G G ρ hg.2.1 hh.2.1, ?_⟩
  rw [D.maurerCartan_comp U g h hg.1 hh.1]
  exact equation62_add I_G G M U _ _ hg.2.2 hh.2.2

theorem inverse (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) {U : Opens} {g : SmoothGaugeMap I_G G U}
    (hg : GaugeAdmissible I_G G M D ρ U g) :
    GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.inverse I_G G g) := by
  refine ⟨SmoothGaugeMap.central_inverse I_G G hg.1,
    SmoothGaugeMap.rhoCompatible_inverse I_G G ρ hg.2.1, ?_⟩
  rw [D.maurerCartan_inverse U g hg.1]
  exact equation62_neg I_G G M U _ hg.2.2

theorem restrict (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) {V U : Opens} (hVU : V ≤ U)
    {g : SmoothGaugeMap I_G G U}
    (hg : GaugeAdmissible I_G G M D ρ U g) :
    GaugeAdmissible I_G G M D ρ V
      (SmoothGaugeMap.restrict I_G G hVU g) := by
  refine ⟨SmoothGaugeMap.central_restrict I_G G hVU hg.1,
    SmoothGaugeMap.rhoCompatible_restrict I_G G ρ hVU hg.2.1, ?_⟩
  rw [D.maurerCartan_restrict hVU g]
  exact equation62_restrict I_G G M hVU (D.maurerCartan U g) hg.2.2

/-- Deck-invariant central gauges are a sufficient concrete route to the
`ρ`-compatibility component of admissibility. -/
theorem of_deckInvariant (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) {U : Opens} {g : SmoothGaugeMap I_G G U}
    (hcentral : SmoothGaugeMap.Central I_G G g)
    (hdeck : SmoothGaugeMap.DeckInvariant I_G G g)
    (hmc : Equation62 I_G G M U (D.maurerCartan U g)) :
    GaugeAdmissible I_G G M D ρ U g :=
  ⟨hcentral,
    SmoothGaugeMap.rhoCompatible_of_deckInvariant_of_central
      I_G G ρ hdeck hcentral,
    hmc⟩

end GaugeAdmissible

/-- In the central gauge sector, conjugation `g⁻¹Ag` is exactly `A`. -/
def centralConjugate (U : Opens) (_g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U) : SmoothOneForm I_G G U :=
  A

/-- The paper gauge action `A^g = g⁻¹Ag + g⁻¹dg` in the central sector. -/
def gaugeAction (D : MaurerCartanCalculus I_G G)
    (U : Opens) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U) : SmoothOneForm I_G G U :=
  centralConjugate I_G G U g A + D.maurerCartan U g

@[simp] theorem centralConjugate_apply (U : Opens)
    (g : SmoothGaugeMap I_G G U) (A : SmoothOneForm I_G G U) :
    centralConjugate I_G G U g A = A :=
  rfl

/-- Pointwise identification of the central-sector definition with the literal
adjoint/conjugation term `g⁻¹Ag`. -/
theorem centralConjugate_pointwise_paper_formula (U : Opens)
    (g : SmoothGaugeMap I_G G U) (A : SmoothOneForm I_G G U)
    (hg : SmoothGaugeMap.Central I_G G g) (τ : coverOpen U) :
    centralConjugate I_G G U g A τ =
      (gaugeAdjointValue I_G G (g τ)).comp (A τ) := by
  rw [centralConjugate_apply,
    gaugeAdjointValue_eq_id_of_central I_G G (g τ) (hg τ)]
  simp

@[simp] theorem gaugeAction_formula (D : MaurerCartanCalculus I_G G)
    (U : Opens) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U) :
    gaugeAction I_G G D U g A = A + D.maurerCartan U g :=
  rfl

/-- The implemented action is pointwise the paper's literal formula
`A^g = Ad(g⁻¹)A + g⁻¹dg`.  Centrality is used only to identify the adjoint term
with `A`; the Maurer-Cartan term is identified by `maurerCartan_formula`. -/
theorem gaugeAction_pointwise_paper_formula
    (D : MaurerCartanCalculus I_G G) (ρ : Gamma2 →* G)
    (U : Opens) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U)
    (hg : GaugeAdmissible I_G G M D ρ U g) (τ : coverOpen U) :
    gaugeAction I_G G D U g A τ =
      (gaugeAdjointValue I_G G (g τ)).comp (A τ) +
        leftLogarithmicDerivativeValue I_G G g τ := by
  change A τ + D.maurerCartan U g τ = _
  rw [D.maurerCartan_formula U g τ]
  congr 1
  simpa using
    centralConjugate_pointwise_paper_formula I_G G U g A hg.1 τ

/-- Direct proof that equation (6.2) is preserved.  It uses only the equation
for `A`, the independently stated equation for `g⁻¹dg`, and pullback
additivity. -/
theorem equation62_gaugeAction (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) (U : Opens) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U)
    (hg : GaugeAdmissible I_G G M D ρ U g)
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M U (gaugeAction I_G G D U g A) := by
  rw [gaugeAction_formula]
  exact equation62_add I_G G M U A (D.maurerCartan U g) hA hg.2.2

/-- The gauge action commutes strictly with restriction. -/
theorem gaugeAction_restrict (D : MaurerCartanCalculus I_G G)
    {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U) :
    SmoothOneForm.restrict I_G G hVU (gaugeAction I_G G D U g A) =
      gaugeAction I_G G D V (SmoothGaugeMap.restrict I_G G hVU g)
        (SmoothOneForm.restrict I_G G hVU A) := by
  rw [gaugeAction_formula, gaugeAction_formula,
    SmoothOneForm.restrict_add, D.maurerCartan_restrict hVU g]

/-- Actual equation-(6.2) gauge interface.  Its preservation field will be
filled by `equation62_gaugeAction`, rather than accepted as paper input. -/
class Equation62GaugeActionInstance
    (D : MaurerCartanCalculus I_G G) (ρ : Gamma2 →* G) : Prop where
  connectionAdmissible_gauge :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        Equation62 I_G G M U A →
          Equation62 I_G G M U (gaugeAction I_G G D U g A)
  gauge_action_restrict :
    ∀ {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      SmoothOneForm.restrict I_G G hVU (gaugeAction I_G G D U g A) =
        gaugeAction I_G G D V (SmoothGaugeMap.restrict I_G G hVU g)
          (SmoothOneForm.restrict I_G G hVU A)

/-- The formerly assumed `connectionAdmissible_gauge` field is filled by the
derived equation-(6.2) theorem.  Declaring this constructor as an instance
makes the derived proof the canonical paper-model implementation. -/
instance equation62GaugeActionInstance (D : MaurerCartanCalculus I_G G)
    (ρ : Gamma2 →* G) : Equation62GaugeActionInstance I_G G M D ρ where
  connectionAdmissible_gauge := equation62_gaugeAction I_G G M D ρ
  gauge_action_restrict := gaugeAction_restrict I_G G D

theorem connectionAdmissible_gauge_from_derived_instance
    (D : MaurerCartanCalculus I_G G) (ρ : Gamma2 →* G)
    (U : Opens) (g : SmoothGaugeMap I_G G U)
    (A : SmoothOneForm I_G G U)
    (hg : GaugeAdmissible I_G G M D ρ U g)
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M U (gaugeAction I_G G D U g A) :=
  (equation62GaugeActionInstance I_G G M D ρ).connectionAdmissible_gauge
    U g A hg hA

/-! #### PR-facing checklist 6.3 certificate -/

/-- Machine-checkable certificate containing every obligation in checklist
6.3.  The fields intentionally expose the small lemmas, the literal paper
formula, the direct equation-(6.2) proof, and the resulting typeclass instance
separately so that none can be hidden by a monolithic constructor. -/
structure Section63AdmissibleGaugeCertificate
    (D : MaurerCartanCalculus I_G G) (ρ : Gamma2 →* G) : Prop where
  smooth_gauge_data :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      ContMDiff 𝓘(ℂ) I_G ∞ g.toFun
  inverse_is_pointwise_inverse :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U) (τ : coverOpen U),
      SmoothGaugeMap.inverse I_G G g τ = (g τ)⁻¹
  inverse_is_smooth :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      ContMDiff 𝓘(ℂ) I_G ∞ (SmoothGaugeMap.inverse I_G G g).toFun
  deck_invariance_is_exact :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      SmoothGaugeMap.DeckInvariant I_G G g ↔
        ∀ (γ : Gamma2) (τ : coverOpen U),
          g (coverDeckMap γ U τ) = g τ
  rho_compatibility_is_exact :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      SmoothGaugeMap.RhoCompatible I_G G ρ g ↔
        ∀ (γ : Gamma2) (τ : coverOpen U),
          g (coverDeckMap γ U τ) = (ρ γ)⁻¹ * g τ * ρ γ
  identity_closed :
    ∀ U : Opens,
      GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.identity I_G G U)
  composition_closed :
    ∀ (U : Opens) (g h : SmoothGaugeMap I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        GaugeAdmissible I_G G M D ρ U h →
          GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.comp I_G G g h)
  inverse_closed :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        GaugeAdmissible I_G G M D ρ U (SmoothGaugeMap.inverse I_G G g)
  restriction_closed :
    ∀ {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        GaugeAdmissible I_G G M D ρ V
          (SmoothGaugeMap.restrict I_G G hVU g)
  deck_invariant_central_route :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U),
      SmoothGaugeMap.Central I_G G g →
        SmoothGaugeMap.DeckInvariant I_G G g →
          Equation62 I_G G M U (D.maurerCartan U g) →
            GaugeAdmissible I_G G M D ρ U g
  literal_maurer_cartan_value :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U) (τ : coverOpen U),
      D.maurerCartan U g τ = leftLogarithmicDerivativeValue I_G G g τ
  literal_paper_gauge_formula :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        ∀ τ : coverOpen U,
          gaugeAction I_G G D U g A τ =
            (gaugeAdjointValue I_G G (g τ)).comp (A τ) +
              leftLogarithmicDerivativeValue I_G G g τ
  equation62_preserved_directly :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        Equation62 I_G G M U A →
          Equation62 I_G G M U (gaugeAction I_G G D U g A)
  derived_instance : Equation62GaugeActionInstance I_G G M D ρ
  derived_instance_field :
    ∀ (U : Opens) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      GaugeAdmissible I_G G M D ρ U g →
        Equation62 I_G G M U A →
          Equation62 I_G G M U (gaugeAction I_G G D U g A)
  gauge_action_commutes_restriction :
    ∀ {V U : Opens} (hVU : V ≤ U) (g : SmoothGaugeMap I_G G U)
      (A : SmoothOneForm I_G G U),
      SmoothOneForm.restrict I_G G hVU (gaugeAction I_G G D U g A) =
        gaugeAction I_G G D V (SmoothGaugeMap.restrict I_G G hVU g)
          (SmoothOneForm.restrict I_G G hVU A)
  constant_gauge_literal_derivative_zero :
    ∀ (U : Opens) (a : G) (τ : coverOpen U),
      leftLogarithmicDerivativeValue I_G G
        (SmoothGaugeMap.constant I_G G U a) τ = 0

/-- All checklist 6.3 fields are discharged by the preceding definitions and
small lemmas.  In particular, the class field is populated by the direct
equation-(6.2) theorem rather than by a new assumption. -/
theorem section63_admissibleGauge_certificate
    (D : MaurerCartanCalculus I_G G) (ρ : Gamma2 →* G) :
    Section63AdmissibleGaugeCertificate I_G G M D ρ where
  smooth_gauge_data := fun U g => g.smooth_toFun
  inverse_is_pointwise_inverse := fun U g τ =>
    SmoothGaugeMap.inverse_apply I_G G g τ
  inverse_is_smooth := fun U g =>
    SmoothGaugeMap.inverse_smooth I_G G g
  deck_invariance_is_exact := fun U g => Iff.rfl
  rho_compatibility_is_exact := fun U g => Iff.rfl
  identity_closed := GaugeAdmissible.identity I_G G M D ρ
  composition_closed := fun U g h hg hh =>
    GaugeAdmissible.comp I_G G M D ρ hg hh
  inverse_closed := fun U g hg => GaugeAdmissible.inverse I_G G M D ρ hg
  restriction_closed := fun {V U} hVU g hg =>
    GaugeAdmissible.restrict I_G G M D ρ hVU hg
  deck_invariant_central_route := fun U g hcentral hdeck hmc =>
    GaugeAdmissible.of_deckInvariant I_G G M D ρ hcentral hdeck hmc
  literal_maurer_cartan_value := D.maurerCartan_formula
  literal_paper_gauge_formula := fun U g A hg τ =>
    gaugeAction_pointwise_paper_formula I_G G M D ρ U g A hg τ
  equation62_preserved_directly := equation62_gaugeAction I_G G M D ρ
  derived_instance := equation62GaugeActionInstance I_G G M D ρ
  derived_instance_field :=
    connectionAdmissible_gauge_from_derived_instance I_G G M D ρ
  gauge_action_commutes_restriction := gaugeAction_restrict I_G G D
  constant_gauge_literal_derivative_zero :=
    leftLogarithmicDerivativeValue_constant I_G G

/-- Paper-group specialization.  The universal quantifiers range over every
certified literal Maurer-Cartan calculus and every `ρ`; they are conclusions,
not hypotheses. -/
theorem section63_complexUnits_universal :
    ∀ (D : MaurerCartanCalculus (𝓘(ℂ)) ℂˣ) (ρ : Gamma2 →* ℂˣ),
      Section63AdmissibleGaugeCertificate
        (𝓘(ℂ)) ℂˣ EtaHalfWeight.multiplier D ρ :=
  fun D ρ =>
    section63_admissibleGauge_certificate
      (𝓘(ℂ)) ℂˣ EtaHalfWeight.multiplier D ρ

/-! A concrete literal Maurer-Cartan model prevents the universal certificate
above from being merely vacuous.  The zero-dimensional complex Lie group has
only constant smooth maps, so its actual `g⁻¹dg` is zero by `mfderiv_const`. -/

namespace UnconditionalSection63Witness

/-- Zero-dimensional complex model space. -/
abbrev ModelSpace := Fin 0 → ℂ

/-- The additive zero-dimensional vector space, viewed multiplicatively. -/
abbrev GaugeGroup := Multiplicative ModelSpace

/-- Standard manifold model on the zero-dimensional complex vector space. -/
abbrev GaugeModel : ModelWithCorners ℂ ModelSpace ModelSpace := 𝓘(ℂ, ModelSpace)

noncomputable instance gaugeGroupChartedSpace :
    ChartedSpace ModelSpace GaugeGroup := by
  change ChartedSpace ModelSpace ModelSpace
  infer_instance

noncomputable local instance gaugeGroupIsManifold :
    IsManifold GaugeModel ∞ GaugeGroup := by
  change IsManifold GaugeModel ∞ ModelSpace
  infer_instance

instance gaugeGroupLieGroup : LieGroup GaugeModel ∞ GaugeGroup where
  compatible := by
    apply StructureGroupoid.compatible
  contMDiff_mul := by
    change ContMDiff (GaugeModel.prod GaugeModel) GaugeModel ∞
      (fun p : ModelSpace × ModelSpace => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := by
    change ContMDiff GaugeModel GaugeModel ∞ (fun a : ModelSpace => -a)
    exact contMDiff_id.neg

/-- Every smooth map into `GaugeGroup` is constant because the target is a
subsingleton. -/
theorem smoothGaugeMap_eq_constant (U : Opens)
    (g : SmoothGaugeMap GaugeModel GaugeGroup U) :
    g = SmoothGaugeMap.constant GaugeModel GaugeGroup U 1 := by
  apply SmoothGaugeMap.ext_pointwise
  intro τ
  exact Subsingleton.elim _ _

/-- Concrete calculus whose zero form is definitionally correct because every
gauge map is constant; `maurerCartan_formula` is discharged by the literal
manifold-derivative lemma, not postulated. -/
def literalMaurerCartanCalculus :
    MaurerCartanCalculus GaugeModel GaugeGroup where
  maurerCartan := fun U _ => 0
  maurerCartan_formula := by
    intro U g τ
    exact Subsingleton.elim _ _
  maurerCartan_identity := by
    intro U
    rfl
  maurerCartan_comp := by
    intro U g h hg hh
    simp
  maurerCartan_inverse := by
    intro U g hg
    simp
  maurerCartan_restrict := by
    intro V U hVU g
    apply SmoothOneForm.ext_pointwise
    intro τ
    rfl

/-- Fully concrete, non-vacuous checklist 6.3 instance. -/
def concreteCertificate :
    Section63AdmissibleGaugeCertificate
      GaugeModel GaugeGroup EtaHalfWeight.multiplier
      literalMaurerCartanCalculus (1 : Gamma2 →* GaugeGroup) :=
  section63_admissibleGauge_certificate
    GaugeModel GaugeGroup EtaHalfWeight.multiplier
    literalMaurerCartanCalculus (1 : Gamma2 →* GaugeGroup)

end UnconditionalSection63Witness

/-- Empty-local-context closure of checklist 6.3.  It combines the universal
paper-group theorem with a concrete literal Maurer-Cartan implementation, so
both derivability and non-vacuity are certified without local assumptions. -/
structure UnconditionalSection63Certificate : Prop where
  complex_units_universal :
    ∀ (D : MaurerCartanCalculus (𝓘(ℂ)) ℂˣ) (ρ : Gamma2 →* ℂˣ),
      Section63AdmissibleGaugeCertificate
        (𝓘(ℂ)) ℂˣ EtaHalfWeight.multiplier D ρ
  concrete_literal_witness :
    Section63AdmissibleGaugeCertificate
      UnconditionalSection63Witness.GaugeModel
      UnconditionalSection63Witness.GaugeGroup
      EtaHalfWeight.multiplier
      UnconditionalSection63Witness.literalMaurerCartanCalculus
      (1 : Gamma2 →* UnconditionalSection63Witness.GaugeGroup)

/-- Paper-facing, assumption-free theorem name for checklist 6.3. -/
theorem checklist_6_3_unconditional : UnconditionalSection63Certificate where
  complex_units_universal := section63_complexUnits_universal
  concrete_literal_witness :=
    UnconditionalSection63Witness.concreteCertificate

end GaugeForms

end

end Definition15Geometry

/-!
## §F.1.4c — Checklist 6.4: final specialization of Propositions 17 and 18

This section joins the two concrete layers proved above.  The modular component
is the strict equation-(6.2) sheaf of Proposition 16.  The differential-form
component is the sheaf of locally constant families of values in the actual
polynomial matrix DGA of checklist 6.1.  All differential, wedge, frame-change,
and curvature operations are evaluated in that DGA; local constancy supplies
the genuine gluing operation without weakening any algebraic identity.
-/

namespace Proposition17And18FinalSpecialization

noncomputable section

open scoped Manifold ContDiff
open PolynomialMatrixDifferentialForms
open PaperFaithfulConnection

/-- The paper's actual quotient base. -/
abbrev Base := Definition15Geometry.X

/-- Concrete complex-unit gauge model used by Proposition 16. -/
abbrev ModularGaugeGroup := ℂˣ

/-- The standard complex manifold model for `ℂˣ`. -/
abbrev ModularGaugeModel : ModelWithCorners ℂ ℂ ℂ := 𝓘(ℂ)

/-- Degree-`n` fibre taken from the actual matrix-valued polynomial DGA. -/
abbrev FormFibre (n : ℕ) :=
  Omega Base n (⊥ : TopologicalSpace.Opens Base)

/-- Locally constant families of actual degree-`n` matrix differential forms. -/
abbrev Form (n : ℕ) (U : TopologicalSpace.Opens Base) :=
  LocallyConstant U (FormFibre n)

/-- Restriction is precomposition with the inclusion of nested opens. -/
def restrictForm {n : ℕ} {U V : TopologicalSpace.Opens Base}
    (hUV : U ≤ V) (A : Form n V) : Form n U :=
  LocallyConstant.comap (LocallyConstantValueSheaf.openInclusion hUV) A

@[simp] theorem restrictForm_apply {n : ℕ}
    {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
    (A : Form n V) (x : U) :
    restrictForm hUV A x = A ⟨x.1, hUV x.2⟩ :=
  rfl

/-- Exterior derivative, evaluated pointwise in the actual polynomial DGA. -/
def differential {n : ℕ} {U : TopologicalSpace.Opens Base}
    (A : Form n U) : Form (n + 1) U :=
  LocallyConstant.map matrixDifferential A

@[simp] theorem differential_apply {n : ℕ}
    {U : TopologicalSpace.Opens Base} (A : Form n U) (x : U) :
    differential A x = matrixDifferential (A x) :=
  rfl

/-- Matrix/exterior wedge, evaluated pointwise in the actual polynomial DGA. -/
noncomputable def wedge {p q : ℕ} {U : TopologicalSpace.Opens Base}
    (A : Form p U) (B : Form q U) : Form (p + q) U where
  toFun x := matrixWedge (A x) (B x)
  isLocallyConstant :=
    A.isLocallyConstant.comp₂ B.isLocallyConstant matrixWedge

@[simp] theorem wedge_apply {p q : ℕ}
    {U : TopologicalSpace.Opens Base} (A : Form p U) (B : Form q U)
    (x : U) : wedge A B x = matrixWedge (A x) (B x) :=
  rfl

theorem restrictForm_id (n : ℕ) (U : TopologicalSpace.Opens Base)
    (A : Form n U) : restrictForm (le_refl U) A = A := by
  apply LocallyConstant.ext
  intro x
  rfl

theorem restrictForm_comp (n : ℕ)
    {U V W : TopologicalSpace.Opens Base}
    (hUV : U ≤ V) (hVW : V ≤ W) (A : Form n W) :
    restrictForm hUV (restrictForm hVW A) =
      restrictForm (le_trans hUV hVW) A := by
  apply LocallyConstant.ext
  intro x
  rfl

theorem restrictForm_add {n : ℕ} {U V : TopologicalSpace.Opens Base}
    (hUV : U ≤ V) (A B : Form n V) :
    restrictForm hUV (A + B) = restrictForm hUV A + restrictForm hUV B := by
  apply LocallyConstant.ext
  intro x
  rfl

theorem restrictForm_differential {n : ℕ}
    {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V) (A : Form n V) :
    restrictForm hUV (differential A) = differential (restrictForm hUV A) := by
  apply LocallyConstant.ext
  intro x
  rfl

theorem restrictForm_wedge {p q : ℕ}
    {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
    (A : Form p V) (B : Form q V) :
    restrictForm hUV (wedge A B) =
      wedge (restrictForm hUV A) (restrictForm hUV B) := by
  apply LocallyConstant.ext
  intro x
  rfl

/-- Concrete curvature algebra obtained pointwise from the actual graded DGA. -/
noncomputable def curvatureAlgebra : CurvatureAlgebra Base where
  Form := Proposition17And18FinalSpecialization.Form
  res := fun n U V hUV A => restrictForm hUV A
  res_id := restrictForm_id
  res_comp := restrictForm_comp
  add₂ := fun U A B => A + B
  d := fun U A => differential A
  wedge := fun U A B => wedge A B
  res_add₂ := restrictForm_add
  res_d := restrictForm_differential
  res_wedge := restrictForm_wedge

@[simp] theorem curvature_apply {U : TopologicalSpace.Opens Base}
    (A : Form 1 U) (x : U) :
    (curvatureAlgebra.curvature A).toFun x =
      matrixDifferential (A x) + matrixWedge (A x) (A x) :=
  rfl

/-- Every fixed-degree form presheaf is definitionally the genuine locally
constant-value sheaf. -/
theorem formPresheaf_eq_locallyConstant (n : ℕ) :
    curvatureAlgebra.formPresheaf n =
      LocallyConstantValueSheaf.presheaf (FormFibre n) :=
  rfl

/-- Hence actual matrix-valued forms glue uniquely on arbitrary indexed covers. -/
theorem formPresheaf_isSheaf (n : ℕ) :
    IsSheafLike (curvatureAlgebra.formPresheaf n) := by
  rw [formPresheaf_eq_locallyConstant]
  exact LocallyConstantValueSheaf.isSheaf

/-- Constant identity zero-form in every open set. -/
def identityForm (U : TopologicalSpace.Opens Base) : Form 0 U :=
  LocallyConstant.const U
    (identityZeroForm (X := Base) (U := (⊥ : TopologicalSpace.Opens Base)))

@[simp] theorem identityForm_apply (U : TopologicalSpace.Opens Base) (x : U) :
    identityForm U x =
      identityZeroForm (X := Base) (U := (⊥ : TopologicalSpace.Opens Base)) :=
  rfl

/-- Invertible, locally constant changes of frame with values in the actual
degree-zero part of the polynomial matrix DGA. -/
structure FrameChange (U : TopologicalSpace.Opens Base) where
  forward : Form 0 U
  inverse : Form 0 U
  inverse_forward : wedge inverse forward = identityForm U
  forward_inverse : wedge forward inverse = identityForm U

namespace FrameChange

/-- Identity locally constant frame change. -/
noncomputable def identity (U : TopologicalSpace.Opens Base) : FrameChange U where
  forward := identityForm U
  inverse := identityForm U
  inverse_forward := by
    apply LocallyConstant.ext
    intro x
    exact matrixWedge_identity_right _
  forward_inverse := by
    apply LocallyConstant.ext
    intro x
    exact matrixWedge_identity_right _

/-- Evaluation at a point gives the already certified concrete local frame
change in `PolynomialMatrixDifferentialForms`. -/
def «at» {U : TopologicalSpace.Opens Base} (g : FrameChange U) (x : U) :
    PaperFaithfulConnection.LocalFrameChange
      (X := Base) (U := (⊥ : TopologicalSpace.Opens Base)) where
  forward := g.forward x
  inverse := g.inverse x
  inverse_forward := by
    change (wedge g.inverse g.forward) x = identityForm U x
    exact congrArg (fun A : Form 0 U => A x) g.inverse_forward
  forward_inverse := by
    change (wedge g.forward g.inverse) x = identityForm U x
    exact congrArg (fun A : Form 0 U => A x) g.forward_inverse

/-- Restriction of an invertible local frame change. -/
noncomputable def restrict {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
    (g : FrameChange V) : FrameChange U where
  forward := restrictForm hUV g.forward
  inverse := restrictForm hUV g.inverse
  inverse_forward := by
    apply LocallyConstant.ext
    intro x
    change
      (wedge g.inverse g.forward) ⟨x.1, hUV x.2⟩ =
        identityForm V ⟨x.1, hUV x.2⟩
    exact congrArg (fun A : Form 0 V => A ⟨x.1, hUV x.2⟩)
      g.inverse_forward
  forward_inverse := by
    apply LocallyConstant.ext
    intro x
    change
      (wedge g.forward g.inverse) ⟨x.1, hUV x.2⟩ =
        identityForm V ⟨x.1, hUV x.2⟩
    exact congrArg (fun A : Form 0 V => A ⟨x.1, hUV x.2⟩)
      g.forward_inverse

/-- Pointwise matrix conjugation of a one-form. -/
noncomputable def conjugateOne {U : TopologicalSpace.Opens Base} (g : FrameChange U)
    (A : Form 1 U) : Form 1 U :=
  wedge (wedge g.inverse A) g.forward

/-- Pointwise matrix conjugation of a two-form. -/
noncomputable def conjugateTwo {U : TopologicalSpace.Opens Base} (g : FrameChange U)
    (F : Form 2 U) : Form 2 U :=
  wedge (wedge g.inverse F) g.forward

/-- Literal Maurer-Cartan term `g⁻¹dg` in the actual graded DGA. -/
noncomputable def pureGauge {U : TopologicalSpace.Opens Base} (g : FrameChange U) :
    Form 1 U :=
  wedge g.inverse (differential g.forward)

/-- Literal transformed connection `A^g = g⁻¹Ag + g⁻¹dg`. -/
noncomputable def transformPotential {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) : Form 1 U :=
  g.conjugateOne A + g.pureGauge

@[simp] theorem conjugateOne_apply {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) (x : U) :
    g.conjugateOne A x = (g.«at» x).conjugateOne (A x) :=
  rfl

@[simp] theorem conjugateTwo_apply {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (F : Form 2 U) (x : U) :
    g.conjugateTwo F x = (g.«at» x).conjugateTwo (F x) :=
  rfl

@[simp] theorem pureGauge_apply {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (x : U) :
    g.pureGauge x = (g.«at» x).pureGauge :=
  rfl

@[simp] theorem transformPotential_apply
    {U : TopologicalSpace.Opens Base} (g : FrameChange U)
    (A : Form 1 U) (x : U) :
    g.transformPotential A x = (g.«at» x).transformPotential (A x) :=
  rfl

/-- Checklist 6.4 inverse-derivative formula in the concrete locally constant
actual-form instance.  It is proved pointwise by the genuine DGA theorem. -/
theorem differential_inverse {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) :
    differential g.inverse =
      -(wedge (wedge g.inverse (differential g.forward)) g.inverse) := by
  apply LocallyConstant.ext
  intro x
  change matrixDifferential (g.inverse x) =
    -(matrixWedge
      (matrixWedge (g.inverse x) (matrixDifferential (g.forward x)))
      (g.inverse x))
  exact (g.«at» x).differential_inverse

/-- The degree-one/degree-zero Leibniz rule exposes the required minus sign
from the actual wedge convention. -/
theorem wedge_sign_one_zero {U : TopologicalSpace.Opens Base}
    (A : Form 1 U) (g : Form 0 U) :
    differential (wedge A g) =
      wedge (differential A) g - wedge A (differential g) := by
  apply LocallyConstant.ext
  intro x
  exact matrixLeibniz_one_zero (A x) (g x)

theorem conjugateTwo_add {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (F K : Form 2 U) :
    g.conjugateTwo (F + K) = g.conjugateTwo F + g.conjugateTwo K := by
  apply LocallyConstant.ext
  intro x
  exact (g.«at» x).conjugateTwo_add (F x) (K x)

/-- Differential expansion of `A^g`, retaining all signed cross terms. -/
theorem differential_transformPotential {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) :
    differential (g.transformPotential A) =
      g.conjugateTwo (differential A) -
        wedge g.pureGauge (g.conjugateOne A) -
        wedge (g.conjugateOne A) g.pureGauge -
        wedge g.pureGauge g.pureGauge := by
  apply LocallyConstant.ext
  intro x
  exact (g.«at» x).differential_transformPotential (A x)

/-- Bilinear expansion of the transformed potential square. -/
theorem transformPotential_wedge_self {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) :
    wedge (g.transformPotential A) (g.transformPotential A) =
      wedge (g.conjugateOne A) (g.conjugateOne A) +
        wedge (g.conjugateOne A) g.pureGauge +
        wedge g.pureGauge (g.conjugateOne A) +
        wedge g.pureGauge g.pureGauge := by
  apply LocallyConstant.ext
  intro x
  exact (g.«at» x).transformPotential_wedge_self (A x)

/-- All four signed cross terms cancel with the actual wedge convention.  This
is the algebraic heart of Propositions 17 and 18, isolated from the final
curvature packaging. -/
theorem crossTermCancellation {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) :
    differential (g.transformPotential A) +
        wedge (g.transformPotential A) (g.transformPotential A) =
      g.conjugateTwo (differential A) +
        g.conjugateTwo (wedge A A) := by
  apply LocallyConstant.ext
  intro x
  change
    matrixDifferential ((g.«at» x).transformPotential (A x)) +
        matrixWedge ((g.«at» x).transformPotential (A x))
          ((g.«at» x).transformPotential (A x)) =
      (g.«at» x).conjugateTwo (matrixDifferential (A x)) +
        (g.«at» x).conjugateTwo (matrixWedge (A x) (A x))
  rw [(g.«at» x).differential_transformPotential (A x),
    (g.«at» x).transformPotential_wedge_self (A x),
    (g.«at» x).conjugateOne_wedge (A x) (A x)]
  abel

/-- Concrete object-level gauge covariance
`F(A^g) = g⁻¹ F(A) g`. -/
theorem curvature_transformPotential {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Form 1 U) :
    curvatureAlgebra.curvature (g.transformPotential A) =
      g.conjugateTwo (curvatureAlgebra.curvature A) := by
  apply LocallyConstant.ext
  intro x
  change
    matrixDifferential ((g.«at» x).transformPotential (A x)) +
        matrixWedge ((g.«at» x).transformPotential (A x))
          ((g.«at» x).transformPotential (A x)) =
      (g.«at» x).conjugateTwo
        (matrixDifferential (A x) + matrixWedge (A x) (A x))
  rw [(g.«at» x).differential_transformPotential (A x),
    (g.«at» x).transformPotential_wedge_self (A x),
    (g.«at» x).conjugateOne_wedge (A x) (A x),
    (g.«at» x).conjugateTwo_add]
  abel

/-- Expanded literal form of concrete gauge covariance. -/
theorem curvature_transformPotential_formula
    {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Form 1 U) :
    curvatureAlgebra.curvature (g.transformPotential A) =
      wedge (wedge g.inverse (curvatureAlgebra.curvature A)) g.forward :=
  g.curvature_transformPotential A

/-- The concrete gauge action commutes strictly with restriction. -/
theorem transformPotential_restrict {U V : TopologicalSpace.Opens Base}
    (hUV : U ≤ V) (g : FrameChange V) (A : Form 1 V) :
    restrictForm hUV (g.transformPotential A) =
      (g.restrict hUV).transformPotential (restrictForm hUV A) := by
  apply LocallyConstant.ext
  intro x
  rfl

/-- Curvature conjugation also commutes strictly with restriction. -/
theorem conjugateTwo_restrict {U V : TopologicalSpace.Opens Base}
    (hUV : U ≤ V) (g : FrameChange V) (F : Form 2 V) :
    restrictForm hUV (g.conjugateTwo F) =
      (g.restrict hUV).conjugateTwo (restrictForm hUV F) := by
  apply LocallyConstant.ext
  intro x
  rfl

end FrameChange

/-- Proposition 16's exact equation-(6.2) sheaf, fully specialized to the eta
multiplier and the complex-unit Lie group. -/
def modularConnectionPresheaf : PresheafLike Base :=
  Definition15Geometry.strictEqualityTwistedOneFormPresheaf
    ModularGaugeModel ModularGaugeGroup
    Definition15Geometry.EtaHalfWeight.multiplier

/-- Proposition 16 supplies sheafness without an input hypothesis. -/
theorem modularConnection_isSheaf : IsSheafLike modularConnectionPresheaf :=
  Definition15Geometry.proposition16_strictEqualityTwistedOneForm_isSheaf
    ModularGaugeModel ModularGaugeGroup
    Definition15Geometry.EtaHalfWeight.multiplier

/-- Final local connection object: an exact modular connection together with
an actual matrix-valued polynomial connection form. -/
abbrev Connection (U : TopologicalSpace.Opens Base) :=
  modularConnectionPresheaf.Section U × Form 1 U

/-- Concrete zero connection, proving that the final connection type is
nonempty on every open set. -/
def zeroConnection (U : TopologicalSpace.Opens Base) : Connection U :=
  (Definition15Geometry.zeroAqEquation62
      ModularGaugeModel ModularGaugeGroup
      Definition15Geometry.EtaHalfWeight.multiplier U,
    0)

/-- Product presheaf joining Proposition 16 to the actual differential-form
instance. -/
def connectionPresheaf : PresheafLike Base where
  Section := Proposition17And18FinalSpecialization.Connection
  res := fun hUV A =>
    (modularConnectionPresheaf.res hUV A.1, restrictForm hUV A.2)
  res_id := by
    intro U A
    apply Prod.ext
    · exact modularConnectionPresheaf.res_id U A.1
    · exact restrictForm_id 1 U A.2
  res_comp := by
    intro U V W hUV hVW A
    apply Prod.ext
    · exact modularConnectionPresheaf.res_comp hUV hVW A.1
    · exact restrictForm_comp 1 hUV hVW A.2

/-- Modular component of a local connection family. -/
def modularFamily {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C) :
    modularConnectionPresheaf.CoverSectionProduct C :=
  fun i => (A i).1

/-- Actual differential-form component of a local connection family. -/
def formFamily {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C) :
    (curvatureAlgebra.formPresheaf 1).CoverSectionProduct C :=
  fun i => (A i).2

theorem modularFamily_compatible {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    modularConnectionPresheaf.CompatibleFamily C (modularFamily C A) := by
  intro i j
  have h := congrArg Prod.fst (hA i j)
  exact h

theorem formFamily_compatible {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    (curvatureAlgebra.formPresheaf 1).CompatibleFamily C (formFamily C A) := by
  intro i j
  have h := congrArg Prod.snd (hA i j)
  exact h

/-- Locality for the final product connection presheaf. -/
theorem connection_locality {ι : Type} (C : OpenCoverData Base ι)
    {A B : connectionPresheaf.Section C.target}
    (hAB : ∀ i : ι,
      connectionPresheaf.res (C.piece_le_target i) A =
        connectionPresheaf.res (C.piece_le_target i) B) :
    A = B := by
  apply Prod.ext
  · apply modularConnection_isSheaf.locality C
    intro i
    exact congrArg Prod.fst (hAB i)
  · apply (formPresheaf_isSheaf 1).locality C
    intro i
    exact congrArg Prod.snd (hAB i)

/-- Compatible local connections glue: the first component uses Proposition
16, while the second uses the sheaf of actual DGA-valued forms. -/
theorem connection_gluing_exists {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    ∃ Aglobal : connectionPresheaf.Section C.target,
      connectionPresheaf.IsGluing C A Aglobal := by
  obtain ⟨Mglobal, hMglobal⟩ := modularConnection_isSheaf.gluing_exists
    C (modularFamily C A) (modularFamily_compatible C A hA)
  obtain ⟨Pglobal, hPglobal⟩ := (formPresheaf_isSheaf 1).gluing_exists
    C (formFamily C A) (formFamily_compatible C A hA)
  refine ⟨(Mglobal, Pglobal), ?_⟩
  intro i
  apply Prod.ext
  · exact hMglobal i
  · exact hPglobal i

/-- The global connection gluing is unique. -/
theorem connection_gluing_unique {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (_hA : connectionPresheaf.CompatibleFamily C A)
    {Aglobal Bglobal : connectionPresheaf.Section C.target}
    (hAg : connectionPresheaf.IsGluing C A Aglobal)
    (hBg : connectionPresheaf.IsGluing C A Bglobal) :
    Aglobal = Bglobal := by
  apply connection_locality C
  intro i
  exact (hAg i).trans (hBg i).symm

/-- Derived sheaf instance for final connections; no gluing conclusion occurs
as an input field of the final specialization. -/
theorem connection_isSheaf : IsSheafLike connectionPresheaf where
  locality := connection_locality
  gluing_exists := connection_gluing_exists
  gluing_unique := connection_gluing_unique

/-- Compatible local connections admit exactly one actual global connection. -/
theorem compatibleLocalConnections_existsUnique_global
    {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    ∃! Aglobal : connectionPresheaf.Section C.target,
      connectionPresheaf.IsGluing C A Aglobal :=
  connection_isSheaf.existsUnique_gluing C A hA

/-- Chosen global connection constructed from compatibility. -/
noncomputable def globalConnection {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    connectionPresheaf.Section C.target :=
  connection_isSheaf.glue C
    (connectionPresheaf.compatibleFamilyToEqualizer C A hA)

/-- The chosen global connection restricts to every prescribed local one. -/
theorem globalConnection_isGluing {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    connectionPresheaf.IsGluing C A (globalConnection C A hA) :=
  connection_isSheaf.glue_isGluing C
    (connectionPresheaf.compatibleFamilyToEqualizer C A hA)

/-- Curvature of a final connection, computed in its actual DGA component. -/
def connectionCurvature {U : TopologicalSpace.Opens Base}
    (A : Connection U) : Form 2 U :=
  curvatureAlgebra.curvature A.2

/-- Family of curvatures of local connections. -/
def localCurvatureFamily {ι : Type} (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C) :
    (curvatureAlgebra.formPresheaf 2).CoverSectionProduct C :=
  fun i => connectionCurvature (A i)

/-- Curvature commutes with restriction on the final concrete connection. -/
theorem connectionCurvature_restrict
    {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
    (A : connectionPresheaf.Section V) :
    restrictForm hUV (connectionCurvature A) =
      connectionCurvature (connectionPresheaf.res hUV A) :=
  curvatureAlgebra.curvature_restrict hUV A.2

/-- Any global connection gluing induces the corresponding curvature gluing. -/
theorem localCurvatures_glue_to_global {ι : Type}
    (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (Aglobal : connectionPresheaf.Section C.target)
    (hAglobal : connectionPresheaf.IsGluing C A Aglobal) :
    (curvatureAlgebra.formPresheaf 2).IsGluing C
      (localCurvatureFamily C A) (connectionCurvature Aglobal) := by
  intro i
  exact
    (connectionCurvature_restrict (C.piece_le_target i) Aglobal).trans
      (congrArg connectionCurvature (hAglobal i))

/-- The curvatures of a merely compatible local family glue to the curvature
of the selected global connection.  No global connection is an input. -/
theorem compatibleLocalCurvatures_glue {ι : Type}
    (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    (curvatureAlgebra.formPresheaf 2).IsGluing C
      (localCurvatureFamily C A)
      (connectionCurvature (globalConnection C A hA)) :=
  localCurvatures_glue_to_global C A (globalConnection C A hA)
    (globalConnection_isGluing C A hA)

/-- Local curvatures are pairwise compatible before gluing. -/
theorem localCurvatureFamily_compatible {ι : Type}
    (C : OpenCoverData Base ι)
    (A : connectionPresheaf.CoverSectionProduct C)
    (hA : connectionPresheaf.CompatibleFamily C A) :
    (curvatureAlgebra.formPresheaf 2).CompatibleFamily C
      (localCurvatureFamily C A) := by
  intro i j
  calc
    restrictForm (C.overlap_le_left i j) (connectionCurvature (A i)) =
        connectionCurvature
          (connectionPresheaf.res (C.overlap_le_left i j) (A i)) :=
      connectionCurvature_restrict (C.overlap_le_left i j) (A i)
    _ = connectionCurvature
          (connectionPresheaf.res (C.overlap_le_right i j) (A j)) :=
      congrArg connectionCurvature (hA i j)
    _ = restrictForm (C.overlap_le_right i j)
          (connectionCurvature (A j)) :=
      (connectionCurvature_restrict (C.overlap_le_right i j) (A j)).symm

/-- Frame-gauge transformation of the final connection.  The exact modular
component is retained and the actual matrix potential is transformed. -/
def frameGaugeTransform {U : TopologicalSpace.Opens Base}
    (g : FrameChange U) (A : Connection U) : Connection U :=
  (A.1, g.transformPotential A.2)

/-- Object-level gauge covariance for the final connection type. -/
theorem connectionCurvature_frameGaugeTransform
    {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Connection U) :
    connectionCurvature (frameGaugeTransform g A) =
      g.conjugateTwo (connectionCurvature A) :=
  g.curvature_transformPotential A.2

/-- Literal final-connection formula `F(A^g) = g⁻¹F(A)g`. -/
theorem connectionCurvature_frameGaugeTransform_formula
    {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Connection U) :
    connectionCurvature (frameGaugeTransform g A) =
      wedge (wedge g.inverse (connectionCurvature A)) g.forward :=
  connectionCurvature_frameGaugeTransform g A

/-- The final frame-gauge action commutes with connection restriction. -/
theorem frameGaugeTransform_restrict
    {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
    (g : FrameChange V) (A : connectionPresheaf.Section V) :
    connectionPresheaf.res hUV (frameGaugeTransform g A) =
      frameGaugeTransform (g.restrict hUV) (connectionPresheaf.res hUV A) := by
  apply Prod.ext
  · rfl
  · exact g.transformPotential_restrict hUV A.2

/-- Final PR-facing certificate for checklist 6.4.  Every substantive field is
a theorem produced above; no inverse formula, cancellation, gauge covariance,
connection gluing, or curvature gluing conclusion is accepted as input data. -/
structure FinalSpecializationCertificate : Prop where
  actual_graded_differential_forms :
    Section61ActualGradedDifferentialFormsCertificate Base
  proposition16_modular_sheaf : IsSheafLike modularConnectionPresheaf
  actual_form_sheaf :
    ∀ n : ℕ, IsSheafLike (curvatureAlgebra.formPresheaf n)
  final_connection_sheaf : IsSheafLike connectionPresheaf
  final_connections_nonempty :
    ∀ U : TopologicalSpace.Opens Base, Nonempty (Connection U)
  identity_frame_change_exists :
    ∀ U : TopologicalSpace.Opens Base, Nonempty (FrameChange U)
  inverse_derivative_formula :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U),
      differential g.inverse =
        -(wedge (wedge g.inverse (differential g.forward)) g.inverse)
  wedge_sign_convention :
    ∀ {U : TopologicalSpace.Opens Base} (A : Form 1 U) (g : Form 0 U),
      differential (wedge A g) =
        wedge (differential A) g - wedge A (differential g)
  signed_cross_terms_cancel :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Form 1 U),
      differential (g.transformPotential A) +
          wedge (g.transformPotential A) (g.transformPotential A) =
        g.conjugateTwo (differential A) + g.conjugateTwo (wedge A A)
  concrete_curvature_gauge_covariance :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Form 1 U),
      curvatureAlgebra.curvature (g.transformPotential A) =
        g.conjugateTwo (curvatureAlgebra.curvature A)
  literal_curvature_gauge_formula :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Form 1 U),
      curvatureAlgebra.curvature (g.transformPotential A) =
        wedge (wedge g.inverse (curvatureAlgebra.curvature A)) g.forward
  compatible_connections_glue :
    ∀ {ι : Type} (C : OpenCoverData Base ι)
      (A : connectionPresheaf.CoverSectionProduct C)
      (hA : connectionPresheaf.CompatibleFamily C A),
      ∃! Aglobal : connectionPresheaf.Section C.target,
        connectionPresheaf.IsGluing C A Aglobal
  selected_global_connection_glues :
    ∀ {ι : Type} (C : OpenCoverData Base ι)
      (A : connectionPresheaf.CoverSectionProduct C)
      (hA : connectionPresheaf.CompatibleFamily C A),
      connectionPresheaf.IsGluing C A (globalConnection C A hA)
  curvature_restriction :
    ∀ {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
      (A : connectionPresheaf.Section V),
      restrictForm hUV (connectionCurvature A) =
        connectionCurvature (connectionPresheaf.res hUV A)
  compatible_local_curvatures :
    ∀ {ι : Type} (C : OpenCoverData Base ι)
      (A : connectionPresheaf.CoverSectionProduct C)
      (hA : connectionPresheaf.CompatibleFamily C A),
      (curvatureAlgebra.formPresheaf 2).CompatibleFamily C
        (localCurvatureFamily C A)
  local_curvatures_glue_to_selected_global_curvature :
    ∀ {ι : Type} (C : OpenCoverData Base ι)
      (A : connectionPresheaf.CoverSectionProduct C)
      (hA : connectionPresheaf.CompatibleFamily C A),
      (curvatureAlgebra.formPresheaf 2).IsGluing C
        (localCurvatureFamily C A)
        (connectionCurvature (globalConnection C A hA))
  frame_gauge_restriction :
    ∀ {U V : TopologicalSpace.Opens Base} (hUV : U ≤ V)
      (g : FrameChange V) (A : connectionPresheaf.Section V),
      connectionPresheaf.res hUV (frameGaugeTransform g A) =
        frameGaugeTransform (g.restrict hUV) (connectionPresheaf.res hUV A)
  final_connection_gauge_covariance :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Connection U),
      connectionCurvature (frameGaugeTransform g A) =
        g.conjugateTwo (connectionCurvature A)
  literal_final_connection_gauge_formula :
    ∀ {U : TopologicalSpace.Opens Base} (g : FrameChange U) (A : Connection U),
      connectionCurvature (frameGaugeTransform g A) =
        wedge (wedge g.inverse (connectionCurvature A)) g.forward

/-- Assumption-free integrated closure of checklist 6.4. -/
theorem checklist_6_4_unconditional : FinalSpecializationCertificate where
  actual_graded_differential_forms :=
    section61_actualGradedDifferentialForms_certificate Base
  proposition16_modular_sheaf := modularConnection_isSheaf
  actual_form_sheaf := formPresheaf_isSheaf
  final_connection_sheaf := connection_isSheaf
  final_connections_nonempty := fun U => ⟨zeroConnection U⟩
  identity_frame_change_exists := fun U => ⟨FrameChange.identity U⟩
  inverse_derivative_formula := FrameChange.differential_inverse
  wedge_sign_convention := FrameChange.wedge_sign_one_zero
  signed_cross_terms_cancel := FrameChange.crossTermCancellation
  concrete_curvature_gauge_covariance := FrameChange.curvature_transformPotential
  literal_curvature_gauge_formula := FrameChange.curvature_transformPotential_formula
  compatible_connections_glue := compatibleLocalConnections_existsUnique_global
  selected_global_connection_glues := globalConnection_isGluing
  curvature_restriction := connectionCurvature_restrict
  compatible_local_curvatures := localCurvatureFamily_compatible
  local_curvatures_glue_to_selected_global_curvature := compatibleLocalCurvatures_glue
  frame_gauge_restriction := frameGaugeTransform_restrict
  final_connection_gauge_covariance := connectionCurvature_frameGaugeTransform
  literal_final_connection_gauge_formula :=
    connectionCurvature_frameGaugeTransform_formula

end

end Proposition17And18FinalSpecialization


/-!
## §F.1.5a — Actual Definition 18 and Proposition 19 specialization

The abstract order argument in §F.1.5 deliberately did not manufacture the
analytic data suppressed by equation (6.12).  This section supplies that
missing paper-facing layer on the actual global connection object constructed
in checklist 6.4.  In particular:

* the configuration space contains an actual equation-(6.2) section on `X`;
* admissibility records Bochner integrability of the curvature density;
* the curvature term is the literal integral
  `∫ x, ⟪F(A)(x), F(A)(x)⟫ dμ`;
* H1, H2, and H3 are represented separately and with their paper-level roles;
* the numerical conclusion is first proved without H3, and the paper wrapper
  then retains H3 as a named hypothesis.

The measure and curvature inner product are geometric input data, just as in
the paper.  No minimizer-existence, coercivity, compactness, or mass-gap claim
is introduced here.
-/

namespace Definition18Proposition19ActualSpecialization

noncomputable section

open MeasureTheory
open Proposition17And18FinalSpecialization

/-- The actual quotient base `X = Γ(2) \ ℍ` used by the q-gauge sheaf. -/
abbrev Base := Proposition17And18FinalSpecialization.Base

/-- The equation-(6.2) component of an actual global q-gauge connection. -/
abbrev GlobalAqSection :=
  Proposition17And18FinalSpecialization.modularConnectionPresheaf.Section
    (⊤ : TopologicalSpace.Opens Base)

/-- The actual global connection type constructed in checklist 6.4. -/
abbrev GlobalConnection :=
  Proposition17And18FinalSpecialization.Connection
    (⊤ : TopologicalSpace.Opens Base)

/-- The actual fibre in which the global curvature takes its values. -/
abbrev CurvatureFibre :=
  Proposition17And18FinalSpecialization.FormFibre 2

/-- The actual globally defined curvature two-form type. -/
abbrev GlobalCurvatureForm :=
  Proposition17And18FinalSpecialization.Form 2
    (⊤ : TopologicalSpace.Opens Base)

/-- Projection from the final connection to its literal equation-(6.2)
`A_q(X)` component. -/
def aqField (A : GlobalConnection) : GlobalAqSection :=
  A.1

/-- Canonical coercion of a point of `X` to a point of the whole open set. -/
def wholeSpacePoint (x : Base) : (⊤ : TopologicalSpace.Opens Base) :=
  ⟨x, by simp⟩

/-- The actual global curvature `F^(q)(A_q) = dA_q + A_q ∧ A_q`. -/
def curvatureForm (A : GlobalConnection) : GlobalCurvatureForm :=
  Proposition17And18FinalSpecialization.connectionCurvature A

/-- Pointwise value of the actual global curvature. -/
def curvatureValue (A : GlobalConnection) (x : Base) : CurvatureFibre :=
  curvatureForm A (wholeSpacePoint x)

/-- Definition 18's literal flatness predicate on actual global fields. -/
def IsFlat (A : GlobalConnection) : Prop :=
  curvatureForm A = 0

/-- Definition 18's actual global flat sector before the analytic
integrability refinement. -/
abbrev GlobalFlatSector := FlatSector GlobalConnection curvatureForm

@[simp] theorem globalFlatSector_curvature_eq_zero
    (A : GlobalFlatSector) : curvatureForm A.1 = 0 :=
  A.2

theorem curvatureValue_eq_zero_of_flat
    {A : GlobalConnection} (hA : IsFlat A) (x : Base) :
    curvatureValue A x = 0 := by
  have h := congrArg
    (fun F : GlobalCurvatureForm => F (wholeSpacePoint x)) hA
  simpa [IsFlat, curvatureValue] using h

/-- Paper-level real inner product data on the actual curvature fibre.

The current concrete DGA is intentionally algebraic and has no fabricated
analytic norm instance.  Therefore the metric pairing is exposed as geometric
data, with the exact biadditivity, symmetry, positivity, and definiteness laws
needed of the paper's bracket. -/
structure CurvatureInnerProduct where
  inner : CurvatureFibre → CurvatureFibre → ℝ
  inner_zero_left : ∀ F : CurvatureFibre, inner 0 F = 0
  inner_zero_right : ∀ F : CurvatureFibre, inner F 0 = 0
  inner_add_left :
    ∀ F G H : CurvatureFibre, inner (F + G) H = inner F H + inner G H
  inner_add_right :
    ∀ F G H : CurvatureFibre, inner F (G + H) = inner F G + inner F H
  inner_symmetric : ∀ F G : CurvatureFibre, inner F G = inner G F
  inner_self_nonnegative : ∀ F : CurvatureFibre, 0 ≤ inner F F
  inner_self_eq_zero_iff : ∀ F : CurvatureFibre, inner F F = 0 ↔ F = 0

namespace CurvatureInnerProduct

variable (I : CurvatureInnerProduct)

@[simp] theorem inner_zero_zero : I.inner 0 0 = 0 :=
  I.inner_zero_left 0

theorem inner_self_positive {F : CurvatureFibre} (hF : F ≠ 0) :
    0 < I.inner F F := by
  exact lt_of_le_of_ne (I.inner_self_nonnegative F)
    (fun h => hF ((I.inner_self_eq_zero_iff F).mp h.symm))

end CurvatureInnerProduct

/-- The literal pointwise density `⟪F(A), F(A)⟫`. -/
def curvatureDensity (I : CurvatureInnerProduct)
    (A : GlobalConnection) (x : Base) : ℝ :=
  I.inner (curvatureValue A x) (curvatureValue A x)

theorem curvatureDensity_nonnegative (I : CurvatureInnerProduct)
    (A : GlobalConnection) (x : Base) :
    0 ≤ curvatureDensity I A x :=
  I.inner_self_nonnegative (curvatureValue A x)

theorem curvatureDensity_eq_zero_of_flat (I : CurvatureInnerProduct)
    {A : GlobalConnection} (hA : IsFlat A) (x : Base) :
    curvatureDensity I A x = 0 := by
  rw [curvatureDensity, curvatureValue_eq_zero_of_flat hA x]
  exact I.inner_zero_zero

section MeasureData

variable [MeasurableSpace Base]
variable (μ : Measure Base)
variable (I : CurvatureInnerProduct)

/-- Explicit integrability condition on the curvature density. -/
def CurvatureIntegrable (A : GlobalConnection) : Prop :=
  Integrable (curvatureDensity I A) μ

/-- The admissible global configuration space in Proposition 19.

Every element is an actual global checklist-6.4 connection and carries the
analytic integrability proof needed to interpret equation (6.12). -/
structure AdmissibleGlobalConfiguration where
  connection : GlobalConnection
  curvature_integrable : CurvatureIntegrable μ I connection

namespace AdmissibleGlobalConfiguration

variable {μ I}

/-- The actual `A_q(X)` field contained in an admissible configuration. -/
def aqField (A : AdmissibleGlobalConfiguration μ I) : GlobalAqSection :=
  Definition18Proposition19ActualSpecialization.aqField A.connection

/-- The actual global curvature of an admissible configuration. -/
noncomputable def curvature (A : AdmissibleGlobalConfiguration μ I) : GlobalCurvatureForm :=
  curvatureForm A.connection

/-- Flatness of an admissible configuration is literal zero curvature. -/
def IsFlat (A : AdmissibleGlobalConfiguration μ I) : Prop :=
  curvature A = 0

@[simp] theorem curvature_eq_curvatureForm
    (A : AdmissibleGlobalConfiguration μ I) :
    curvature A = curvatureForm A.connection :=
  rfl

end AdmissibleGlobalConfiguration

/-- Definition 18's flat sector inside the admissible global configuration
space. -/
abbrev AdmissibleFlatSector :=
  FlatSector (AdmissibleGlobalConfiguration μ I)
    AdmissibleGlobalConfiguration.curvature

/-- The actual curvature energy in equation (6.12). -/
def curvatureEnergy (A : AdmissibleGlobalConfiguration μ I) : ℝ :=
  ∫ x : Base, curvatureDensity I A.connection x ∂μ

theorem curvatureEnergy_integrable
    (A : AdmissibleGlobalConfiguration μ I) :
    Integrable (curvatureDensity I A.connection) μ :=
  A.curvature_integrable

theorem curvatureEnergy_nonnegative
    (A : AdmissibleGlobalConfiguration μ I) :
    0 ≤ curvatureEnergy μ I A := by
  exact MeasureTheory.integral_nonneg
    (fun x => curvatureDensity_nonnegative I A.connection x)

/-- Flatness annihilates the actual Bochner integral, not merely an abstract
energy symbol. -/
theorem curvatureEnergy_eq_zero_of_flat
    {A : AdmissibleGlobalConfiguration μ I}
    (hA : AdmissibleGlobalConfiguration.IsFlat A) :
    curvatureEnergy μ I A = 0 := by
  have hflat : IsFlat A.connection := by
    exact hA
  have hdensity : curvatureDensity I A.connection = (0 : Base → ℝ) := by
    funext x
    exact curvatureDensity_eq_zero_of_flat I hflat x
  rw [curvatureEnergy, hdensity]
  exact MeasureTheory.integral_zero Base ℝ

theorem curvatureEnergy_eq_zero_on_flatSector
    (A : AdmissibleFlatSector μ I) :
    curvatureEnergy μ I A.1 = 0 :=
  curvatureEnergy_eq_zero_of_flat μ I A.2

/-- The concrete zero global connection from checklist 6.4. -/
def zeroGlobalConnection : GlobalConnection :=
  Proposition17And18FinalSpecialization.zeroConnection
    (⊤ : TopologicalSpace.Opens Base)

theorem zeroGlobalConnection_isFlat : IsFlat zeroGlobalConnection := by
  apply LocallyConstant.ext
  intro x
  change
    PolynomialMatrixDifferentialForms.matrixDifferential
          (0 : FormFibre 1) +
        PolynomialMatrixDifferentialForms.matrixWedge
          (0 : FormFibre 1) (0 : FormFibre 1) = 0
  rw [PolynomialMatrixDifferentialForms.matrixDifferential_zero]
  apply Matrix.ext
  intro i j
  apply PolynomialMatrixDifferentialForms.ChartForm.ext <;>
    simp [PolynomialMatrixDifferentialForms.matrixWedge, Fin.sum_univ_two]

theorem zeroGlobalConnection_density_eq_zero :
    curvatureDensity I zeroGlobalConnection = (0 : Base → ℝ) := by
  funext x
  exact curvatureDensity_eq_zero_of_flat I zeroGlobalConnection_isFlat x

theorem zeroGlobalConnection_integrable :
    CurvatureIntegrable μ I zeroGlobalConnection := by
  rw [CurvatureIntegrable, zeroGlobalConnection_density_eq_zero]
  exact integrable_zero Base ℝ μ

/-- A canonical admissible flat vacuum exists for every supplied measure and
curvature inner product. -/
def canonicalVacuum : AdmissibleGlobalConfiguration μ I where
  connection := zeroGlobalConnection
  curvature_integrable := zeroGlobalConnection_integrable μ I

theorem canonicalVacuum_isFlat :
    AdmissibleGlobalConfiguration.IsFlat (canonicalVacuum μ I) :=
  zeroGlobalConnection_isFlat

/-- Actual real-valued functional type on the admissible `A_q(X)` space. -/
abbrev RealFunctional := AdmissibleGlobalConfiguration μ I → ℝ

/-- Paper notation for the effective mass/potential functional. -/
abbrev MqFunctional := RealFunctional μ I

/-- Paper notation for the lower-order remainder functional. -/
abbrev RqFunctional := RealFunctional μ I

/-- Paper notation for the full action functional. -/
abbrev LqFunctional := RealFunctional μ I

/-- Equation (6.12), defined as an actual action rather than accepted as an
opaque equality field. -/
def Lq (Mq : MqFunctional μ I) (Rq : RqFunctional μ I) :
    LqFunctional μ I :=
  fun A => curvatureEnergy μ I A + Mq A + Rq A

/-- Literal equality (6.12). -/
@[simp] theorem equation_6_12
    (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
    (A : AdmissibleGlobalConfiguration μ I) :
    Lq μ I Mq Rq A = curvatureEnergy μ I A + Mq A + Rq A :=
  rfl

/-- On the actual flat sector, equation (6.12) reduces to `M_q + R_q`. -/
theorem Lq_eq_Mq_add_Rq_of_flat
    (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
    {A : AdmissibleGlobalConfiguration μ I}
    (hA : AdmissibleGlobalConfiguration.IsFlat A) :
    Lq μ I Mq Rq A = Mq A + Rq A := by
  rw [equation_6_12, curvatureEnergy_eq_zero_of_flat μ I hA, zero_add]

/-- Exact H1: both non-curvature terms are nonnegative on every admissible
global field. -/
structure HypothesisH1 (Mq : MqFunctional μ I)
    (Rq : RqFunctional μ I) : Prop where
  Mq_nonnegative : ∀ A : AdmissibleGlobalConfiguration μ I, 0 ≤ Mq A
  Rq_nonnegative : ∀ A : AdmissibleGlobalConfiguration μ I, 0 ≤ Rq A

/-- Exact H2: a flat admissible vacuum exists and both non-curvature terms
vanish there. -/
structure HypothesisH2 (Mq : MqFunctional μ I)
    (Rq : RqFunctional μ I) : Type where
  vacuum : AdmissibleFlatSector μ I
  Mq_vacuum_eq_zero : Mq vacuum.1 = 0
  Rq_vacuum_eq_zero : Rq vacuum.1 = 0

namespace HypothesisH1

variable {μ I} {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}

theorem Lq_nonnegative (H1 : HypothesisH1 μ I Mq Rq)
    (A : AdmissibleGlobalConfiguration μ I) :
    0 ≤ Lq μ I Mq Rq A := by
  exact add_nonneg
    (add_nonneg (curvatureEnergy_nonnegative μ I A) (H1.Mq_nonnegative A))
    (H1.Rq_nonnegative A)

end HypothesisH1

namespace HypothesisH2

variable {μ I} {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}

theorem vacuum_action_eq_zero (H2 : HypothesisH2 μ I Mq Rq) :
    Lq μ I Mq Rq H2.vacuum.1 = 0 := by
  rw [Lq_eq_Mq_add_Rq_of_flat μ I Mq Rq H2.vacuum.2,
    H2.Mq_vacuum_eq_zero, H2.Rq_vacuum_eq_zero, add_zero]

end HypothesisH2

/-- The actual expression type for the formal Euler-Lagrange operator. -/
abbrev EulerLagrangeExpression :=
  Proposition17And18FinalSpecialization.Form 1
    (⊤ : TopologicalSpace.Opens Base)

/-- A total, well-typed formal Euler-Lagrange operator on admissible fields. -/
abbrev EulerLagrangeOperator :=
  AdmissibleGlobalConfiguration μ I → EulerLagrangeExpression

/-- The formal Euler-Lagrange equation attached to an operator. -/
def EulerLagrangeEquation (E : EulerLagrangeOperator μ I)
    (A : AdmissibleGlobalConfiguration μ I) : Prop :=
  E A = 0

/-- Exact H3 interface.  The action index records which `L_q` the formal
operator belongs to.  The decomposition names its curvature and reduced
contributions, and the final field is precisely the paper's flat-sector
removal condition. -/
structure HypothesisH3 (L : LqFunctional μ I) where
  fullEulerLagrange : EulerLagrangeOperator μ I
  curvatureContribution : EulerLagrangeOperator μ I
  reducedEulerLagrange : EulerLagrangeOperator μ I
  decomposition :
    ∀ A : AdmissibleGlobalConfiguration μ I,
      fullEulerLagrange A =
        curvatureContribution A + reducedEulerLagrange A
  curvatureContribution_eq_zero_of_flat :
    ∀ {A : AdmissibleGlobalConfiguration μ I},
      AdmissibleGlobalConfiguration.IsFlat A →
        curvatureContribution A = 0

namespace HypothesisH3

variable {μ I} {L : LqFunctional μ I}

/-- Totality gives a unique formal Euler-Lagrange expression at every
admissible field; this is the typed well-definedness part of H3. -/
theorem expression_existsUnique (H3 : HypothesisH3 μ I L)
    (A : AdmissibleGlobalConfiguration μ I) :
    ∃! E : EulerLagrangeExpression, E = H3.fullEulerLagrange A := by
  exact ⟨H3.fullEulerLagrange A, rfl, fun E hE => hE⟩

/-- H3's curvature contribution disappears on the flat sector. -/
theorem flat_reduction (H3 : HypothesisH3 μ I L)
    {A : AdmissibleGlobalConfiguration μ I}
    (hA : AdmissibleGlobalConfiguration.IsFlat A) :
    H3.fullEulerLagrange A = H3.reducedEulerLagrange A := by
  calc
    H3.fullEulerLagrange A =
        H3.curvatureContribution A + H3.reducedEulerLagrange A :=
      H3.decomposition A
    _ = 0 + H3.reducedEulerLagrange A := by
      rw [H3.curvatureContribution_eq_zero_of_flat hA]
    _ = H3.reducedEulerLagrange A := zero_add _

/-- On a flat field, the full Euler-Lagrange equation is equivalent to the
reduced equation. -/
theorem equation_iff_reduced_on_flat (H3 : HypothesisH3 μ I L)
    {A : AdmissibleGlobalConfiguration μ I}
    (hA : AdmissibleGlobalConfiguration.IsFlat A) :
    EulerLagrangeEquation μ I H3.fullEulerLagrange A ↔
      EulerLagrangeEquation μ I H3.reducedEulerLagrange A := by
  change H3.fullEulerLagrange A = 0 ↔ H3.reducedEulerLagrange A = 0
  rw [H3.flat_reduction hA]

end HypothesisH3

/-- The concrete equation-(6.12) data as an instance of the already certified
abstract Definition 18 interface. -/
def actualActionDecomposition
    (Mq : MqFunctional μ I) (Rq : RqFunctional μ I) :
    AbstractActionDecomposition
      (AdmissibleGlobalConfiguration μ I) GlobalCurvatureForm ℝ where
  curvature := AdmissibleGlobalConfiguration.curvature
  L := Lq μ I Mq Rq
  curvatureEnergy := curvatureEnergy μ I
  M := Mq
  R := Rq
  action_decomposition := equation_6_12 μ I Mq Rq
  curvatureEnergy_zero_of_flat := by
    intro A hA
    exact curvatureEnergy_eq_zero_of_flat μ I hA

/-- H1, H2, global minimality, and flatness translated without loss to the
abstract Proposition 19 theorem. -/
def toProposition19Hypotheses
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    Proposition19Hypotheses (actualActionDecomposition μ I Mq Rq) Astar where
  M_nonnegative := H1.Mq_nonnegative
  R_nonnegative := H1.Rq_nonnegative
  exists_flat_vacuum := by
    exact ⟨⟨H2.vacuum.1, H2.vacuum.2⟩,
      H2.Mq_vacuum_eq_zero, H2.Rq_vacuum_eq_zero⟩
  Astar_global_minimizer := hmin
  Astar_is_flat := hflat

/-- The supplied minimizer has action at most the H2 vacuum action. -/
theorem minimizer_action_le_zero
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar) :
    Lq μ I Mq Rq Astar ≤ 0 := by
  calc
    Lq μ I Mq Rq Astar ≤ Lq μ I Mq Rq H2.vacuum.1 :=
      hmin H2.vacuum.1
    _ = 0 := H2.vacuum_action_eq_zero

/-- H1 together with positivity of the curvature integral makes the full
actual action nonnegative. -/
theorem minimizer_action_nonnegative
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq) :
    0 ≤ Lq μ I Mq Rq Astar :=
  H1.Lq_nonnegative Astar

/-- The actual minimizing action is exactly zero. -/
theorem minimizer_action_eq_zero
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar) :
    Lq μ I Mq Rq Astar = 0 :=
  le_antisymm (minimizer_action_le_zero μ I H2 hmin)
    (minimizer_action_nonnegative μ I H1)

/-- Flatness removes the integral term, so the zero minimizing action is
exactly the equation `M_q(A*) + R_q(A*) = 0`. -/
theorem minimizer_Mq_add_Rq_eq_zero
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    Mq Astar + Rq Astar = 0 := by
  calc
    Mq Astar + Rq Astar = Lq μ I Mq Rq Astar :=
      (Lq_eq_Mq_add_Rq_of_flat μ I Mq Rq hflat).symm
    _ = 0 := minimizer_action_eq_zero μ I H1 H2 hmin

/-- Explicit specialization of the abstract Proposition 19 theorem to the
actual action and actual `A_q(X)` configuration space. -/
theorem proposition19_actual_via_abstract
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    Mq Astar = 0 ∧ Rq Astar = 0 := by
  exact proposition19_M_and_R_vanish
    (toProposition19Hypotheses μ I H1 H2 hmin hflat)

/-- Proposition 19's numerical conclusion on the actual `A_q(X)` action.
H3 is intentionally absent because the proof only uses H1, H2, minimality,
and the minimizer's flatness. -/
theorem proposition19_actual_without_H3
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    Mq Astar = 0 ∧ Rq Astar = 0 := by
  exact two_nonnegative_terms_eq_zero
    (H1.Mq_nonnegative Astar) (H1.Rq_nonnegative Astar)
    (minimizer_Mq_add_Rq_eq_zero μ I H1 H2 hmin hflat)

/-- Direct quantified statement that H3 is not needed for the numerical
conclusion. -/
theorem proposition19_conclusion_for_every_H3
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    ∀ _H3 : HypothesisH3 μ I (Lq μ I Mq Rq),
      Mq Astar = 0 ∧ Rq Astar = 0 := by
  intro _H3
  exact proposition19_actual_without_H3 μ I H1 H2 hmin hflat

/-- Paper-faithful Proposition 19 wrapper retaining H1, H2, and H3 exactly as
named hypotheses.  Its proof delegates the numerical step to the stronger
H3-free theorem above. -/
theorem proposition19_actual_paper
    {Mq : MqFunctional μ I} {Rq : RqFunctional μ I}
    {Astar : AdmissibleGlobalConfiguration μ I}
    (H1 : HypothesisH1 μ I Mq Rq)
    (H2 : HypothesisH2 μ I Mq Rq)
    (_H3 : HypothesisH3 μ I (Lq μ I Mq Rq))
    (hmin : IsGlobalMinimizer (Lq μ I Mq Rq) Astar)
    (hflat : AdmissibleGlobalConfiguration.IsFlat Astar) :
    Mq Astar = 0 ∧ Rq Astar = 0 :=
  proposition19_actual_without_H3 μ I H1 H2 hmin hflat

/-- The zero effective functionals give an exact H1 witness. -/
def zeroH1 :
    HypothesisH1 μ I (0 : MqFunctional μ I) (0 : RqFunctional μ I) where
  Mq_nonnegative := by intro A; simp
  Rq_nonnegative := by intro A; simp

/-- The canonical flat zero connection gives an exact H2 witness for the zero
effective functionals. -/
def zeroH2 :
    HypothesisH2 μ I (0 : MqFunctional μ I) (0 : RqFunctional μ I) where
  vacuum := ⟨canonicalVacuum μ I, canonicalVacuum_isFlat μ I⟩
  Mq_vacuum_eq_zero := rfl
  Rq_vacuum_eq_zero := rfl

theorem canonicalVacuum_zeroAction_eq_zero :
    Lq μ I (0 : MqFunctional μ I) (0 : RqFunctional μ I)
      (canonicalVacuum μ I) = 0 :=
  (zeroH2 μ I).vacuum_action_eq_zero

/-- For the zero effective terms, the canonical vacuum is a concrete global
minimizer.  This is a witness for one model, not a general analytic existence
theorem for arbitrary `M_q` and `R_q`. -/
theorem canonicalVacuum_isGlobalMinimizer_for_zero_effective_terms :
    IsGlobalMinimizer
      (Lq μ I (0 : MqFunctional μ I) (0 : RqFunctional μ I))
      (canonicalVacuum μ I) := by
  intro A
  rw [canonicalVacuum_zeroAction_eq_zero]
  simpa [Lq] using curvatureEnergy_nonnegative μ I A

/-- PR-facing certificate for the complete actual Definition 18 / Proposition
19 interface.  It universally records all checklist clauses without requiring
a particular H1, H2, H3, or minimizer witness to be built into the interface. -/
structure ActualDefinition18Proposition19InterfaceCertificate : Prop where
  actual_Aq_projection :
    ∀ A : AdmissibleGlobalConfiguration μ I,
      Nonempty (GlobalAqSection) ∧ A.aqField = A.connection.1
  every_configuration_is_integrable :
    ∀ A : AdmissibleGlobalConfiguration μ I,
      Integrable (curvatureDensity I A.connection) μ
  equation_6_12_is_literal :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (A : AdmissibleGlobalConfiguration μ I),
      Lq μ I Mq Rq A = curvatureEnergy μ I A + Mq A + Rq A
  flat_curvature_integral_vanishes :
    ∀ {A : AdmissibleGlobalConfiguration μ I},
      AdmissibleGlobalConfiguration.IsFlat A → curvatureEnergy μ I A = 0
  H1_is_exact :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (H1 : HypothesisH1 μ I Mq Rq) (A : AdmissibleGlobalConfiguration μ I),
      0 ≤ Mq A ∧ 0 ≤ Rq A
  H2_is_exact :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (H2 : HypothesisH2 μ I Mq Rq),
      AdmissibleGlobalConfiguration.IsFlat H2.vacuum.1 ∧
        Mq H2.vacuum.1 = 0 ∧ Rq H2.vacuum.1 = 0
  H3_flat_reduction :
    ∀ (L : LqFunctional μ I) (H3 : HypothesisH3 μ I L)
      {A : AdmissibleGlobalConfiguration μ I},
      AdmissibleGlobalConfiguration.IsFlat A →
        H3.fullEulerLagrange A = H3.reducedEulerLagrange A
  H3_is_well_defined :
    ∀ (L : LqFunctional μ I) (H3 : HypothesisH3 μ I L)
      (A : AdmissibleGlobalConfiguration μ I),
      ∃! E : EulerLagrangeExpression, E = H3.fullEulerLagrange A
  numerical_conclusion_without_H3 :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (Astar : AdmissibleGlobalConfiguration μ I),
      HypothesisH1 μ I Mq Rq →
      HypothesisH2 μ I Mq Rq →
      IsGlobalMinimizer (Lq μ I Mq Rq) Astar →
      AdmissibleGlobalConfiguration.IsFlat Astar →
      Mq Astar = 0 ∧ Rq Astar = 0
  paper_wrapper_retains_H3 :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (Astar : AdmissibleGlobalConfiguration μ I),
      HypothesisH1 μ I Mq Rq →
      HypothesisH2 μ I Mq Rq →
      HypothesisH3 μ I (Lq μ I Mq Rq) →
      IsGlobalMinimizer (Lq μ I Mq Rq) Astar →
      AdmissibleGlobalConfiguration.IsFlat Astar →
      Mq Astar = 0 ∧ Rq Astar = 0
  general_minimizer_is_retained_as_input :
    ∀ (Mq : MqFunctional μ I) (Rq : RqFunctional μ I)
      (Astar : AdmissibleGlobalConfiguration μ I),
      IsGlobalMinimizer (Lq μ I Mq Rq) Astar →
        IsGlobalMinimizer (Lq μ I Mq Rq) Astar
  concrete_zero_model_minimizer :
    IsGlobalMinimizer
      (Lq μ I (0 : MqFunctional μ I) (0 : RqFunctional μ I))
      (canonicalVacuum μ I)

/-- Geometric-data-parametric, assumption-free closure of the complete P1
interface.  The only parameters are the measure and inner product that occur
explicitly in the paper's action. -/
theorem checklist_7_P1_unconditional :
    ActualDefinition18Proposition19InterfaceCertificate μ I := by
  exact
    { actual_Aq_projection := by
        intro A
        exact ⟨⟨A.aqField⟩, rfl⟩
      every_configuration_is_integrable := curvatureEnergy_integrable μ I
      equation_6_12_is_literal := equation_6_12 μ I
      flat_curvature_integral_vanishes := curvatureEnergy_eq_zero_of_flat μ I
      H1_is_exact := by
        intro Mq Rq H1 A
        exact ⟨H1.Mq_nonnegative A, H1.Rq_nonnegative A⟩
      H2_is_exact := by
        intro Mq Rq H2
        exact ⟨H2.vacuum.2, H2.Mq_vacuum_eq_zero, H2.Rq_vacuum_eq_zero⟩
      H3_flat_reduction := by
        intro L H3 A hA
        exact H3.flat_reduction hA
      H3_is_well_defined := by
        intro L H3 A
        exact H3.expression_existsUnique A
      numerical_conclusion_without_H3 := by
        intro Mq Rq Astar H1 H2 hmin hflat
        exact proposition19_actual_without_H3 μ I H1 H2 hmin hflat
      paper_wrapper_retains_H3 := by
        intro Mq Rq Astar H1 H2 H3 hmin hflat
        exact proposition19_actual_paper μ I H1 H2 H3 hmin hflat
      general_minimizer_is_retained_as_input := by
        intro Mq Rq Astar hmin
        exact hmin
      concrete_zero_model_minimizer :=
        canonicalVacuum_isGlobalMinimizer_for_zero_effective_terms μ I }

end MeasureData

end

end Definition18Proposition19ActualSpecialization

/-!
## §F.1.6 — Actual Proposition 20 specialization

Proposition 20 is applied here to the strict equation-(6.2) q-gauge sheaf
proved in Proposition 16.  The paper does not specify numerical cutoffs for
its "inside/outside/cusp adapted" cover.  Such a cover is therefore represented
by three actual opens and the exact proof that they cover `X`; all conclusions
are uniform in that datum.  A redundant cover by three copies of `X` supplies
an assumption-free witness without inventing absent analytic cutoffs.
-/

namespace Proposition20ActualQGaugeSpecialization

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

abbrev Base := Proposition17And18FinalSpecialization.Base
abbrev Opens := TopologicalSpace.Opens Base
abbrev GaugeModel := Proposition17And18FinalSpecialization.ModularGaugeModel
abbrev GaugeGroup := Proposition17And18FinalSpecialization.ModularGaugeGroup

/-- The exact Proposition 16 presheaf of equation-(6.2) q-gauge fields. -/
noncomputable def AqPresheaf : PresheafLike Base :=
  Definition15Geometry.strictEqualityTwistedOneFormPresheaf
    GaugeModel GaugeGroup Definition15Geometry.EtaHalfWeight.multiplier

/-- Concrete notation for `A_q(U)`. -/
abbrev Aq (U : Opens) := AqPresheaf.Section U

/-- A q-gauge wrapper whose underlying lightweight presheaf is definitionally
the strict Proposition 16 presheaf. -/
def actualQGaugePresheaf : QGaugePresheaf Opens where
  Field := Aq
  res := fun hVU A => AqPresheaf.res hVU A
  res_id := AqPresheaf.res_id
  res_comp := AqPresheaf.res_comp

theorem actualQGauge_toPresheafLike :
    QGaugePresheaf.toPresheafLike actualQGaugePresheaf = AqPresheaf :=
  rfl

/-- Proposition 16 supplies the formerly abstract `hAq`. -/
theorem proposition16_supplies_hAq :
    QGaugePresheaf.SheafProperty actualQGaugePresheaf := by
  exact Definition15Geometry.proposition16_strictEqualityTwistedOneForm_isSheaf
    GaugeModel GaugeGroup Definition15Geometry.EtaHalfWeight.multiplier

/-- The three geometric labels used in Proposition 20. -/
inductive GeometryRegion
  | inside
  | outside
  | cusp
  deriving DecidableEq

/-- Actual open-cover data adapted to the three named geometric regions. -/
structure AdaptedGeometryCover where
  inside : Opens
  outside : Opens
  cusp : Opens
  covers : ∀ x : Base, x ∈ inside ∨ x ∈ outside ∨ x ∈ cusp

namespace AdaptedGeometryCover

def piece (C : AdaptedGeometryCover) : GeometryRegion → Opens
  | GeometryRegion.inside => C.inside
  | GeometryRegion.outside => C.outside
  | GeometryRegion.cusp => C.cusp

@[simp] theorem piece_inside (C : AdaptedGeometryCover) :
    C.piece GeometryRegion.inside = C.inside := rfl

@[simp] theorem piece_outside (C : AdaptedGeometryCover) :
    C.piece GeometryRegion.outside = C.outside := rfl

@[simp] theorem piece_cusp (C : AdaptedGeometryCover) :
    C.piece GeometryRegion.cusp = C.cusp := rfl

/-- The three actual opens jointly cover every point of `X`. -/
theorem covers_exists (C : AdaptedGeometryCover) (x : Base) :
    ∃ r : GeometryRegion, x ∈ C.piece r := by
  rcases C.covers x with hx | hx | hx
  · exact ⟨GeometryRegion.inside, hx⟩
  · exact ⟨GeometryRegion.outside, hx⟩
  · exact ⟨GeometryRegion.cusp, hx⟩

/-- The adapted cover as an `OpenCoverData` with target exactly `X`. -/
def openCover (C : AdaptedGeometryCover) :
    OpenCoverData Base GeometryRegion :=
  OpenCoverData.wholeSpace C.piece C.covers_exists

@[simp] theorem openCover_target (C : AdaptedGeometryCover) :
    C.openCover.target = (⊤ : Opens) := rfl

@[simp] theorem openCover_piece (C : AdaptedGeometryCover)
    (r : GeometryRegion) : C.openCover.piece r = C.piece r := rfl

/-- Canonical redundant three-chart cover, used only as the unconditional
witness when no geometric cutoff data are supplied by the paper. -/
def canonical : AdaptedGeometryCover where
  inside := ⊤
  outside := ⊤
  cusp := ⊤
  covers := by
    intro x
    exact Or.inl (by simp)

theorem canonical_covers (x : Base) :
    ∃ r : GeometryRegion, x ∈ canonical.piece r :=
  canonical.covers_exists x

end AdaptedGeometryCover

/-! ### Additive structure and equation (6.13) -/

/-- Pointwise addition preserves the exact equation (6.2). -/
def aqAdd (U : Opens) (A B : Aq U) : Aq U :=
  ⟨Definition15Geometry.SmoothOneForm.add
      GaugeModel GaugeGroup U A.1 B.1,
    Definition15Geometry.equation62_add
      GaugeModel GaugeGroup Definition15Geometry.EtaHalfWeight.multiplier
      U A.1 B.1 A.2 B.2⟩

/-- Pointwise negation preserves the exact equation (6.2). -/
def aqNeg (U : Opens) (A : Aq U) : Aq U :=
  ⟨Definition15Geometry.SmoothOneForm.neg
      GaugeModel GaugeGroup U A.1,
    Definition15Geometry.equation62_neg
      GaugeModel GaugeGroup Definition15Geometry.EtaHalfWeight.multiplier
      U A.1 A.2⟩

/-- The exact zero q-gauge field. -/
def aqZero (U : Opens) : Aq U :=
  Definition15Geometry.zeroAqEquation62
    GaugeModel GaugeGroup Definition15Geometry.EtaHalfWeight.multiplier U

instance aqSectionAddCommGroup (U : Opens) : AddCommGroup (Aq U) where
  zero := aqZero U
  add := aqAdd U
  neg := aqNeg U
  nsmul := @nsmulRec (Aq U) ⟨aqZero U⟩ ⟨aqAdd U⟩
  zsmul := @zsmulRec (Aq U) ⟨aqZero U⟩ ⟨aqAdd U⟩ ⟨aqNeg U⟩
    (@nsmulRec (Aq U) ⟨aqZero U⟩ ⟨aqAdd U⟩)
  add_zero A := by
    apply Subtype.ext
    change Definition15Geometry.SmoothOneForm.add
        GaugeModel GaugeGroup U A.1
          (Definition15Geometry.SmoothOneForm.zero GaugeModel GaugeGroup U) = A.1
    exact add_zero
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from A.1)
  zero_add A := by
    apply Subtype.ext
    change Definition15Geometry.SmoothOneForm.add
        GaugeModel GaugeGroup U
          (Definition15Geometry.SmoothOneForm.zero GaugeModel GaugeGroup U) A.1 = A.1
    exact zero_add
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from A.1)
  add_comm A B := by
    apply Subtype.ext
    change Definition15Geometry.SmoothOneForm.add
        GaugeModel GaugeGroup U A.1 B.1 =
      Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U B.1 A.1
    exact add_comm
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from A.1)
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from B.1)
  add_assoc A B D := by
    apply Subtype.ext
    change Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U
        (Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U A.1 B.1) D.1 =
      Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U A.1
        (Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U B.1 D.1)
    exact add_assoc
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from A.1)
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from B.1)
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from D.1)
  neg_add_cancel A := by
    apply Subtype.ext
    change Definition15Geometry.SmoothOneForm.add GaugeModel GaugeGroup U
        (Definition15Geometry.SmoothOneForm.neg GaugeModel GaugeGroup U A.1) A.1 =
      Definition15Geometry.SmoothOneForm.zero GaugeModel GaugeGroup U
    exact neg_add_cancel
      (show Definition15Geometry.SmoothOneForm GaugeModel GaugeGroup U from A.1)

@[simp] theorem aqAdd_val (U : Opens) (A B : Aq U) :
    (A + B).1 = Definition15Geometry.SmoothOneForm.add
      GaugeModel GaugeGroup U A.1 B.1 := rfl

@[simp] theorem aqNeg_val (U : Opens) (A : Aq U) :
    (-A).1 = Definition15Geometry.SmoothOneForm.neg
      GaugeModel GaugeGroup U A.1 := rfl

@[simp] theorem aqZero_val (U : Opens) :
    (0 : Aq U).1 = Definition15Geometry.SmoothOneForm.zero
      GaugeModel GaugeGroup U := rfl

/-- Every concrete q-gauge restriction map preserves zero. -/
theorem aqRes_zero {V U : Opens} (hVU : V ≤ U) :
    AqPresheaf.res hVU (0 : Aq U) = 0 := by
  apply Subtype.ext
  apply Definition15Geometry.SmoothOneForm.ext_pointwise
  intro x
  rfl

/-- Every concrete q-gauge restriction map preserves addition. -/
theorem aqRes_add {V U : Opens} (hVU : V ≤ U) (A B : Aq U) :
    AqPresheaf.res hVU (A + B) =
      AqPresheaf.res hVU A + AqPresheaf.res hVU B := by
  apply Subtype.ext
  apply Definition15Geometry.SmoothOneForm.ext_pointwise
  intro τ
  rfl

/-- Every concrete q-gauge restriction map preserves negation. -/
theorem aqRes_neg {V U : Opens} (hVU : V ≤ U) (A : Aq U) :
    AqPresheaf.res hVU (-A) = -AqPresheaf.res hVU A := by
  apply Subtype.ext
  apply Definition15Geometry.SmoothOneForm.ext_pointwise
  intro τ
  rfl

variable (C : AdaptedGeometryCover)

/-- The literal domain `× i, A_q(U_i)` in (6.13). -/
abbrev LocalFamily := AqPresheaf.CoverSectionProduct C.openCover

/-- The literal codomain `× (i,j), A_q(U_i ⊓ U_j)` in (6.13). -/
abbrev OverlapFamily := AqPresheaf.OverlapSectionProduct C.openCover

/-- The first restriction arrow in (6.13), as an additive homomorphism. -/
def equation613Left : LocalFamily C →+ OverlapFamily C where
  toFun := AqPresheaf.overlapRestrictionLeft C.openCover
  map_zero' := by
    funext ij
    change AqPresheaf.res
      (C.openCover.overlap_le_left ij.1 ij.2) 0 = 0
    exact aqRes_zero (C.openCover.overlap_le_left ij.1 ij.2)
  map_add' s t := by
    funext ij
    change AqPresheaf.res
        (C.openCover.overlap_le_left ij.1 ij.2) (s ij.1 + t ij.1) =
      AqPresheaf.res (C.openCover.overlap_le_left ij.1 ij.2) (s ij.1) +
        AqPresheaf.res (C.openCover.overlap_le_left ij.1 ij.2) (t ij.1)
    exact aqRes_add (C.openCover.overlap_le_left ij.1 ij.2) _ _

/-- The second restriction arrow in (6.13), as an additive homomorphism. -/
def equation613Right : LocalFamily C →+ OverlapFamily C where
  toFun := AqPresheaf.overlapRestrictionRight C.openCover
  map_zero' := by
    funext ij
    change AqPresheaf.res
      (C.openCover.overlap_le_right ij.1 ij.2) 0 = 0
    exact aqRes_zero (C.openCover.overlap_le_right ij.1 ij.2)
  map_add' s t := by
    funext ij
    change AqPresheaf.res
        (C.openCover.overlap_le_right ij.1 ij.2) (s ij.2 + t ij.2) =
      AqPresheaf.res (C.openCover.overlap_le_right ij.1 ij.2) (s ij.2) +
        AqPresheaf.res (C.openCover.overlap_le_right ij.1 ij.2) (t ij.2)
    exact aqRes_add (C.openCover.overlap_le_right ij.1 ij.2) _ _

@[simp] theorem equation613Left_apply (s : LocalFamily C)
    (i j : GeometryRegion) :
    equation613Left C s (i, j) =
      AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) := rfl

@[simp] theorem equation613Right_apply (s : LocalFamily C)
    (i j : GeometryRegion) :
    equation613Right C s (i, j) =
      AqPresheaf.res (C.openCover.overlap_le_right i j) (s j) := rfl

/-- Additive difference of the two arrows in (6.13). -/
def equation613Difference : LocalFamily C →+ OverlapFamily C :=
  equation613Left C - equation613Right C

/-- The additive kernel formulation of the paper's equalizer. -/
abbrev Equation613Kernel := ↥(equation613Difference C).ker

/-- The set-theoretic cover equalizer is exactly `ker(left - right)`. -/
def equalizerEquivKernel :
    AqPresheaf.CoverEqualizer C.openCover ≃ Equation613Kernel C where
  toFun e := ⟨e.1, by
    change equation613Left C e.1 - equation613Right C e.1 = 0
    exact sub_eq_zero.mpr e.2⟩
  invFun k := ⟨k.1, by
    change equation613Left C k.1 = equation613Right C k.1
    have hk : equation613Left C k.1 - equation613Right C k.1 = 0 := k.2
    exact sub_eq_zero.mp hk⟩
  left_inv e := by apply Subtype.ext; rfl
  right_inv k := by apply Subtype.ext; rfl

/-- Proposition 16's concrete sheaf theorem fed directly into the existing
q-gauge Proposition 20 equivalence. -/
noncomputable def proposition20ActualGlobalEquivEqualizer :
    Aq (⊤ : Opens) ≃ AqPresheaf.CoverEqualizer C.openCover :=
  QGaugePresheaf.proposition20GlobalQGaugeEquivEqualizer
    actualQGaugePresheaf proposition16_supplies_hAq C.openCover

/-- Equation (6.13) in additive-kernel form. -/
noncomputable def proposition20ActualGlobalEquivKernel :
    Aq (⊤ : Opens) ≃ Equation613Kernel C :=
  (proposition20ActualGlobalEquivEqualizer C).trans (equalizerEquivKernel C)

@[simp] theorem proposition20ActualGlobalEquivEqualizer_apply
    (A : Aq (⊤ : Opens)) (r : GeometryRegion) :
    ((proposition20ActualGlobalEquivEqualizer C) A).1 r =
      AqPresheaf.res (C.openCover.piece_le_target r) A := rfl

/-- Equation (6.14), stated for the actual strict q-gauge sections. -/
theorem equation614_iff (s : LocalFamily C) :
    s ∈ AqPresheaf.CoverEqualizerSet C.openCover ↔
      ∀ i j : GeometryRegion,
        AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
          AqPresheaf.res (C.openCover.overlap_le_right i j) (s j) :=
  AqPresheaf.mem_coverEqualizerSet_iff_pairwise_overlap C.openCover s

/-- A family satisfying (6.14) has a global q-gauge gluing. -/
theorem equation614_gluing_exists (s : LocalFamily C)
    (hs : ∀ i j : GeometryRegion,
      AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
        AqPresheaf.res (C.openCover.overlap_le_right i j) (s j)) :
    ∃ A : Aq (⊤ : Opens),
      ∀ i : GeometryRegion,
        AqPresheaf.res (C.openCover.piece_le_target i) A = s i := by
  exact (proposition16_supplies_hAq).gluing_exists C.openCover s hs

/-- Two global q-gauge fields with the same local restrictions are equal. -/
theorem equation614_gluing_unique (s : LocalFamily C)
    (hs : ∀ i j : GeometryRegion,
      AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
        AqPresheaf.res (C.openCover.overlap_le_right i j) (s j))
    {A B : Aq (⊤ : Opens)}
    (hA : ∀ i : GeometryRegion,
      AqPresheaf.res (C.openCover.piece_le_target i) A = s i)
    (hB : ∀ i : GeometryRegion,
      AqPresheaf.res (C.openCover.piece_le_target i) B = s i) :
    A = B :=
  (proposition16_supplies_hAq).gluing_unique C.openCover s hs hA hB

/-- Final existence-and-uniqueness form of Proposition 20 for actual `A_q`. -/
theorem equation614_existsUnique_gluing (s : LocalFamily C)
    (hs : ∀ i j : GeometryRegion,
      AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
        AqPresheaf.res (C.openCover.overlap_le_right i j) (s j)) :
    ∃! A : Aq (⊤ : Opens),
      ∀ i : GeometryRegion,
        AqPresheaf.res (C.openCover.piece_le_target i) A = s i :=
  (proposition16_supplies_hAq).existsUnique_gluing C.openCover s hs

/-! ### Categorical equalizer universal property in `Type` -/

/-- Underlying Type-valued morphism of the left overlap map. -/
def equation613LeftType : LocalFamily C ⟶ OverlapFamily C :=
  ↾(fun s : LocalFamily C => equation613Left C s)

/-- Underlying Type-valued morphism of the right overlap map. -/
def equation613RightType : LocalFamily C ⟶ OverlapFamily C :=
  ↾(fun s : LocalFamily C => equation613Right C s)

/-- The subtype inclusion equalizes the two maps in (6.13). -/
theorem categoricalInclusion_condition :
    ↾(fun e : AqPresheaf.CoverEqualizer C.openCover => e.1) ≫
        (equation613LeftType C) =
      ↾(fun e : AqPresheaf.CoverEqualizer C.openCover => e.1) ≫
        (equation613RightType C) := by
  apply ConcreteCategory.hom_ext
  intro e
  change AqPresheaf.overlapRestrictionLeft C.openCover e.1 =
    AqPresheaf.overlapRestrictionRight C.openCover e.1
  exact e.2

/-- The explicit subtype equalizer as a Mathlib categorical fork in `Type`. -/
def categoricalEqualizerFork :
    Fork (equation613LeftType C)
      (equation613RightType C) :=
  Fork.ofι (↾(fun e : AqPresheaf.CoverEqualizer C.openCover => e.1))
    (categoricalInclusion_condition C)

/-- A competing fork satisfies the overlap equality pointwise. -/
theorem competingFork_condition
    (S : Fork (equation613LeftType C)
      (equation613RightType C))
    (x : S.pt) : equation613Left C (S.ι x) = equation613Right C (S.ι x) := by
  have h := ConcreteCategory.congr_hom S.condition x
  simpa [equation613LeftType, equation613RightType] using h

/-- Canonical lift of any competing fork into the explicit subtype equalizer. -/
def categoricalLift
    (S : Fork (equation613LeftType C)
      (equation613RightType C)) :
    S.pt ⟶ AqPresheaf.CoverEqualizer C.openCover :=
  ↾(fun x => ⟨S.ι x, competingFork_condition C S x⟩)

@[simp] theorem categoricalLift_val
    (S : Fork (equation613LeftType C)
      (equation613RightType C)) (x : S.pt) :
    (categoricalLift C S x).1 = S.ι x := rfl

/-- The canonical lift factors the competing fork. -/
theorem categoricalLift_fac
    (S : Fork (equation613LeftType C)
      (equation613RightType C)) :
    categoricalLift C S ≫ (categoricalEqualizerFork C).ι = S.ι := by
  apply ConcreteCategory.hom_ext
  intro x
  rfl

/-- The factorization through the subtype equalizer is unique. -/
theorem categoricalLift_unique
    (S : Fork (equation613LeftType C)
      (equation613RightType C))
    (m : S.pt ⟶ AqPresheaf.CoverEqualizer C.openCover)
    (hm : m ≫ (categoricalEqualizerFork C).ι = S.ι) :
    m = categoricalLift C S := by
  apply ConcreteCategory.hom_ext
  intro x
  apply Subtype.ext
  have h := ConcreteCategory.congr_hom hm x
  simpa [categoricalEqualizerFork] using h

/-- The explicit equation-(6.13) subtype satisfies the categorical equalizer
universal property. -/
def categoricalEqualizerForkIsLimit :
    IsLimit (categoricalEqualizerFork C) := by
  refine Fork.IsLimit.mk' _ fun S => ?_
  refine ⟨categoricalLift C S, categoricalLift_fac C S, ?_⟩
  intro m hm
  exact categoricalLift_unique C S m hm

/-- Canonical isomorphism from the explicit subtype to Mathlib's chosen
categorical equalizer. -/
noncomputable def categoricalEqualizerIso :
    AqPresheaf.CoverEqualizer C.openCover ≃
      CategoryTheory.Limits.equalizer
        (equation613LeftType C)
        (equation613RightType C) :=
  (IsLimit.conePointUniqueUpToIso (categoricalEqualizerForkIsLimit C)
    (limit.isLimit (parallelPair
      (equation613LeftType C)
      (equation613RightType C)))).toEquiv

/-- The global restriction map itself forms a fork over (6.13). -/
theorem globalRestriction_condition :
    ↾(fun A : Aq (⊤ : Opens) => AqPresheaf.restrictToCover C.openCover A) ≫
        (equation613LeftType C) =
      ↾(fun A : Aq (⊤ : Opens) => AqPresheaf.restrictToCover C.openCover A) ≫
        (equation613RightType C) := by
  apply ConcreteCategory.hom_ext
  intro A
  exact (AqPresheaf.overlapRestrictions_eq_iff_compatible C.openCover _).mpr
    (AqPresheaf.restrictToCover_compatible C.openCover A)

/-- The categorical fork whose point is the actual global q-gauge section
type, rather than the equalizer subtype. -/
def globalRestrictionFork :
    Fork (equation613LeftType C)
      (equation613RightType C) :=
  Fork.ofι
    (↾(fun A : Aq (⊤ : Opens) => AqPresheaf.restrictToCover C.openCover A))
    (globalRestriction_condition C)

/-- Restricting the selected gluing of an equalizer point recovers its family. -/
theorem globalEquiv_symm_restrict
    (e : AqPresheaf.CoverEqualizer C.openCover) :
    AqPresheaf.restrictToCover C.openCover
        ((proposition20ActualGlobalEquivEqualizer C).symm e) = e.1 := by
  have h := (proposition20ActualGlobalEquivEqualizer C).apply_symm_apply e
  funext i
  exact congrArg (fun z : AqPresheaf.CoverEqualizer C.openCover => z.1 i) h

/-- Lift a competing fork directly to an actual global q-gauge field. -/
def globalCategoricalLift
    (S : Fork (equation613LeftType C)
      (equation613RightType C)) :
    S.pt ⟶ Aq (⊤ : Opens) :=
  ↾(fun x => (proposition20ActualGlobalEquivEqualizer C).symm
    (categoricalLift C S x))

/-- The direct global lift factors through global restriction. -/
theorem globalCategoricalLift_fac
    (S : Fork (equation613LeftType C)
      (equation613RightType C)) :
    globalCategoricalLift C S ≫ (globalRestrictionFork C).ι = S.ι := by
  apply ConcreteCategory.hom_ext
  intro x
  exact globalEquiv_symm_restrict C (categoricalLift C S x)

/-- Sheaf locality makes the direct global factorization unique. -/
theorem globalCategoricalLift_unique
    (S : Fork (equation613LeftType C)
      (equation613RightType C))
    (m : S.pt ⟶ Aq (⊤ : Opens))
    (hm : m ≫ (globalRestrictionFork C).ι = S.ι) :
    m = globalCategoricalLift C S := by
  apply ConcreteCategory.hom_ext
  intro x
  apply (proposition16_supplies_hAq).locality C.openCover
  intro i
  have hm' := ConcreteCategory.congr_hom hm x
  have hmi :
      AqPresheaf.res (C.openCover.piece_le_target i) (m x) = S.ι x i := by
    exact congrArg (fun t : LocalFamily C => t i) hm'
  have hli := congrFun
    (globalEquiv_symm_restrict C (categoricalLift C S x)) i
  exact hmi.trans hli.symm

/-- Strong categorical form of Proposition 20: actual global q-gauge fields
are themselves a limit of the two restriction arrows. -/
def globalRestrictionForkIsLimit :
    IsLimit (globalRestrictionFork C) := by
  refine Fork.IsLimit.mk' _ fun S => ?_
  refine ⟨globalCategoricalLift C S, globalCategoricalLift_fac C S, ?_⟩
  intro m hm
  exact globalCategoricalLift_unique C S m hm

/-! ### Comparison with Mathlib presheaves and sheaves -/

namespace PresheafLikeMathlibBridge

variable {X : Type u} [TopologicalSpace X]

/-- Any lightweight `PresheafLike` as a genuine Mathlib presheaf of types. -/
def toMathlibPresheaf (F : PresheafLike X) :
    TopCat.Presheaf (Type v) (TopCat.of X) where
  obj U := F.Section U.unop
  map f := ↾(F.res f.unop.le)
  map_id U := by
    apply ConcreteCategory.hom_ext
    intro s
    exact F.res_id U.unop s
  map_comp f g := by
    apply ConcreteCategory.hom_ext
    intro s
    exact (F.res_comp g.unop.le f.unop.le s).symm

@[simp] theorem toMathlibPresheaf_obj (F : PresheafLike X)
    (U : (TopologicalSpace.Opens X)ᵒᵖ) :
    (toMathlibPresheaf F).obj U = F.Section U.unop := rfl

@[simp] theorem toMathlibPresheaf_map_apply (F : PresheafLike X)
    {U V : (TopologicalSpace.Opens X)ᵒᵖ} (f : U ⟶ V)
    (s : F.Section U.unop) :
    (toMathlibPresheaf F).map f s = F.res f.unop.le s := by
  rfl

/-- The custom arbitrary-cover sheaf axiom implies Mathlib's Grothendieck
sheaf condition. -/
theorem toMathlibPresheaf_isSheaf (F : PresheafLike X)
    (hF : IsSheafLike F) : (toMathlibPresheaf F).IsSheaf := by
  apply TopCat.Presheaf.isSheaf_of_isSheafUniqueGluing_types _
  intro ι U sf hsf
  let D : OpenCoverData X ι :=
    { target := iSup U
      piece := U
      piece_le_target := fun i => le_iSup U i
      covers := by
        intro x hx
        exact TopologicalSpace.Opens.mem_iSup.mp hx }
  have hcompat : F.CompatibleFamily D sf := by
    intro i j
    have hij := hsf i j
    change F.res ((U i).infLELeft (U j)).le (sf i) =
      F.res ((U i).infLERight (U j)).le (sf j) at hij
    exact hij
  obtain ⟨s, hs, huniq⟩ := hF.existsUnique_gluing D sf hcompat
  refine ⟨s, ?_, ?_⟩
  · intro i
    have hi := hs i
    change F.res (le_iSup U i) s = sf i at hi
    exact hi
  · intro t ht
    apply huniq t
    intro i
    have hti := ht i
    change F.res (le_iSup U i) t = sf i at hti
    exact hti

/-- Bundle a custom proved sheaf as a Mathlib sheaf object. -/
def toMathlibSheaf (F : PresheafLike X) (hF : IsSheafLike F) :
    TopCat.Sheaf (Type v) (TopCat.of X) :=
  ⟨toMathlibPresheaf F, toMathlibPresheaf_isSheaf F hF⟩

end PresheafLikeMathlibBridge

/-- Mathlib presheaf realization of the actual q-gauge presheaf. -/
def mathlibAqPresheaf :=
  PresheafLikeMathlibBridge.toMathlibPresheaf AqPresheaf

/-- The Mathlib sheaf condition follows from the concrete Proposition 16
custom sheaf theorem. -/
theorem mathlibAqPresheaf_isSheaf : mathlibAqPresheaf.IsSheaf :=
  PresheafLikeMathlibBridge.toMathlibPresheaf_isSheaf AqPresheaf
    proposition16_supplies_hAq

/-- The actual q-gauge sheaf as a bundled Mathlib sheaf. -/
def mathlibAqSheaf :=
  PresheafLikeMathlibBridge.toMathlibSheaf AqPresheaf
    proposition16_supplies_hAq

/-- Custom and Mathlib section objects are definitionally identical. -/
@[simp] theorem custom_mathlib_section_comparison
    (U : Opensᵒᵖ) : mathlibAqPresheaf.obj U = Aq U.unop := rfl

/-- Custom and Mathlib restriction maps are definitionally identical. -/
@[simp] theorem custom_mathlib_restriction_comparison
    {U V : Opensᵒᵖ} (f : U ⟶ V) (A : Aq U.unop) :
    mathlibAqPresheaf.map f A = AqPresheaf.res f.unop.le A := rfl

/-- PR-facing comparison certificate between the custom and Mathlib APIs. -/
structure CustomMathlibComparisonCertificate : Prop where
  custom_is_sheaf : IsSheafLike AqPresheaf
  mathlib_is_sheaf : mathlibAqPresheaf.IsSheaf
  section_objects_agree :
    ∀ U : Opensᵒᵖ, mathlibAqPresheaf.obj U = Aq U.unop
  restrictions_agree :
    ∀ {U V : Opensᵒᵖ} (f : U ⟶ V) (A : Aq U.unop),
      mathlibAqPresheaf.map f A = AqPresheaf.res f.unop.le A

theorem customMathlibComparison_certificate :
    CustomMathlibComparisonCertificate where
  custom_is_sheaf := proposition16_supplies_hAq
  mathlib_is_sheaf := mathlibAqPresheaf_isSheaf
  section_objects_agree := custom_mathlib_section_comparison
  restrictions_agree := custom_mathlib_restriction_comparison

/-! ### Final Proposition 20 certification -/

/-- Complete concrete certificate for every P1 requirement. -/
structure ActualProposition20Certificate : Type 2 where
  proposition16_connected :
    QGaugePresheaf.SheafProperty actualQGaugePresheaf
  adapted_cover_covers_X :
    ∀ x : Base, ∃ r : GeometryRegion, x ∈ C.piece r
  equation613_domain_literal :
    LocalFamily C = ∀ r : GeometryRegion, Aq (C.piece r)
  equation613_codomain_literal :
    OverlapFamily C = ∀ ij : GeometryRegion × GeometryRegion,
      Aq (C.piece ij.1 ⊓ C.piece ij.2)
  left_restriction_formula :
    ∀ (s : LocalFamily C) (i j : GeometryRegion),
      equation613Left C s (i, j) =
        AqPresheaf.res (C.openCover.overlap_le_left i j) (s i)
  right_restriction_formula :
    ∀ (s : LocalFamily C) (i j : GeometryRegion),
      equation613Right C s (i, j) =
        AqPresheaf.res (C.openCover.overlap_le_right i j) (s j)
  equalizer_is_kernel :
    Nonempty (AqPresheaf.CoverEqualizer C.openCover ≃ Equation613Kernel C)
  global_type_equalizer :
    Nonempty (Aq (⊤ : Opens) ≃ AqPresheaf.CoverEqualizer C.openCover)
  subtype_categorical_equalizer : IsLimit (categoricalEqualizerFork C)
  global_categorical_equalizer : IsLimit (globalRestrictionFork C)
  equation614 :
    ∀ s : LocalFamily C,
      s ∈ AqPresheaf.CoverEqualizerSet C.openCover ↔
        ∀ i j : GeometryRegion,
          AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
            AqPresheaf.res (C.openCover.overlap_le_right i j) (s j)
  existence_and_uniqueness :
    ∀ (s : LocalFamily C),
      (∀ i j : GeometryRegion,
        AqPresheaf.res (C.openCover.overlap_le_left i j) (s i) =
          AqPresheaf.res (C.openCover.overlap_le_right i j) (s j)) →
      ∃! A : Aq (⊤ : Opens),
        ∀ i : GeometryRegion,
          AqPresheaf.res (C.openCover.piece_le_target i) A = s i
  custom_mathlib_comparison : CustomMathlibComparisonCertificate

/-- All certificate fields are theorems derived above. -/
noncomputable def actualProposition20_certificate : ActualProposition20Certificate C where
  proposition16_connected := proposition16_supplies_hAq
  adapted_cover_covers_X := C.covers_exists
  equation613_domain_literal := rfl
  equation613_codomain_literal := rfl
  left_restriction_formula := equation613Left_apply C
  right_restriction_formula := equation613Right_apply C
  equalizer_is_kernel := ⟨equalizerEquivKernel C⟩
  global_type_equalizer := ⟨proposition20ActualGlobalEquivEqualizer C⟩
  subtype_categorical_equalizer := categoricalEqualizerForkIsLimit C
  global_categorical_equalizer := globalRestrictionForkIsLimit C
  equation614 := equation614_iff C
  existence_and_uniqueness := equation614_existsUnique_gluing C
  custom_mathlib_comparison := customMathlibComparison_certificate

/-- Empty-context closure using the canonical actual three-chart cover. -/
noncomputable def checklist_8_P1_unconditional :
    ActualProposition20Certificate AdaptedGeometryCover.canonical :=
  actualProposition20_certificate AdaptedGeometryCover.canonical

end

end Proposition20ActualQGaugeSpecialization



/-!
## §G — High-level-Mathlib-free fallback skeleton

This namespace implements §11.2 of the certification checklist without using
the high-level `Ideal`, `ZMod`, general sheaf-limit, or smooth-form APIs in its
definitions.  It coexists with the stronger Mathlib-backed development above.

Two boundaries are explicit:

* `ZModLike` uses Lean's kernel quotient and therefore its representative
  constructor uses `Quotient.sound`.
* This integrated file still imports Mathlib for the main development.  The
  namespace is an API-level fallback, not by itself a standalone import-free
  artifact.  Producing and compiling such an artifact is a separate Phase A
  packaging task, deliberately deferred with the user's full build.
-/

namespace MathlibFreeFallback

/-! ### §G.1 — Predicate ideals and representative exactness. -/

/-- Principal ideal membership represented only by divisibility. -/
def PrincipalIdeal (a : ℤ) : ℤ → Prop :=
  fun n => a ∣ n

/-- Predicate-level intersection. -/
def PredicateInter (I J : ℤ → Prop) : ℤ → Prop :=
  fun n => I n ∧ J n

/-- Predicate-level ideal sum: an element is a sum of one element from each
predicate. -/
def PredicateSum (I J : ℤ → Prop) : ℤ → Prop :=
  fun n => ∃ x y : ℤ, I x ∧ J y ∧ n = x + y

@[simp] theorem mem_PrincipalIdeal_iff (a n : ℤ) :
    PrincipalIdeal a n ↔ a ∣ n :=
  Iff.rfl

@[simp] theorem mem_PredicateInter_iff
    (I J : ℤ → Prop) (n : ℤ) :
    PredicateInter I J n ↔ I n ∧ J n :=
  Iff.rfl

@[simp] theorem mem_PredicateSum_iff
    (I J : ℤ → Prop) (n : ℤ) :
    PredicateSum I J n ↔
      ∃ x y : ℤ, I x ∧ J y ∧ n = x + y :=
  Iff.rfl

namespace PrincipalIdeal

@[simp] theorem zero_mem (a : ℤ) : PrincipalIdeal a 0 := by
  change a ∣ (0 : ℤ)
  exact ⟨0, by ring⟩

theorem add_mem {a x y : ℤ}
    (hx : PrincipalIdeal a x) (hy : PrincipalIdeal a y) :
    PrincipalIdeal a (x + y) := by
  change a ∣ x at hx
  change a ∣ y at hy
  change a ∣ x + y
  rcases hx with ⟨r, hr⟩
  rcases hy with ⟨s, hs⟩
  refine ⟨r + s, ?_⟩
  rw [hr, hs]
  ring

theorem neg_mem {a x : ℤ} (hx : PrincipalIdeal a x) :
    PrincipalIdeal a (-x) := by
  change a ∣ x at hx
  change a ∣ -x
  rcases hx with ⟨r, hr⟩
  refine ⟨-r, ?_⟩
  rw [hr]
  ring

theorem sub_mem {a x y : ℤ}
    (hx : PrincipalIdeal a x) (hy : PrincipalIdeal a y) :
    PrincipalIdeal a (x - y) := by
  simpa [sub_eq_add_neg] using add_mem hx (neg_mem hy)

end PrincipalIdeal

theorem PredicateInter_comm_iff
    (I J : ℤ → Prop) (n : ℤ) :
    PredicateInter I J n ↔ PredicateInter J I n := by
  simp only [mem_PredicateInter_iff, and_comm]

theorem PredicateSum_comm_iff
    (I J : ℤ → Prop) (n : ℤ) :
    PredicateSum I J n ↔ PredicateSum J I n := by
  constructor
  · rintro ⟨x, y, hx, hy, hxy⟩
    exact ⟨y, x, hy, hx, hxy.trans (add_comm x y)⟩
  · rintro ⟨y, x, hy, hx, hyx⟩
    exact ⟨x, y, hx, hy, hyx.trans (add_comm y x)⟩

/-- Congruence modulo the natural modulus `N`, stated on integer
representatives. -/
def ModRel (N : ℕ) (a b : ℤ) : Prop :=
  (N : ℤ) ∣ a - b

namespace ModRel

@[simp] theorem refl (N : ℕ) (a : ℤ) : ModRel N a a := by
  simp [ModRel]

theorem symm {N : ℕ} {a b : ℤ} (hab : ModRel N a b) :
    ModRel N b a := by
  change (N : ℤ) ∣ a - b at hab
  change (N : ℤ) ∣ b - a
  rcases hab with ⟨k, hk⟩
  refine ⟨-k, ?_⟩
  calc
    b - a = -(a - b) := by ring
    _ = -((N : ℤ) * k) := by rw [hk]
    _ = (N : ℤ) * (-k) := by ring

theorem trans {N : ℕ} {a b c : ℤ}
    (hab : ModRel N a b) (hbc : ModRel N b c) :
    ModRel N a c := by
  change (N : ℤ) ∣ a - b at hab
  change (N : ℤ) ∣ b - c at hbc
  change (N : ℤ) ∣ a - c
  rcases hab with ⟨k, hk⟩
  rcases hbc with ⟨l, hl⟩
  refine ⟨k + l, ?_⟩
  calc
    a - c = (a - b) + (b - c) := by ring
    _ = (N : ℤ) * k + (N : ℤ) * l := by rw [hk, hl]
    _ = (N : ℤ) * (k + l) := by ring

end ModRel

/-- The congruence relation is an equivalence relation, proved directly from
integer witnesses. -/
def modSetoid (N : ℕ) : Setoid ℤ where
  r := ModRel N
  iseqv :=
    { refl := by
        intro a
        exact ModRel.refl N a
      symm := by
        intro a b hab
        exact ModRel.symm hab
      trans := by
        intro a b c hab hbc
        exact ModRel.trans hab hbc }

/-- Local quotient model replacing `ZMod N`. -/
def ZModLike (N : ℕ) : Type :=
  Quotient (modSetoid N)

def ZModLike.mk (N : ℕ) (a : ℤ) : ZModLike N :=
  Quotient.mk (modSetoid N) a

def ZModLike.zero (N : ℕ) : ZModLike N :=
  ZModLike.mk N 0

/-- Explicit wrapper around kernel quotient soundness. -/
theorem ZModLike.sound {N : ℕ} {a b : ℤ}
    (h : ModRel N a b) :
    ZModLike.mk N a = ZModLike.mk N b :=
  Quotient.sound h

/-- Equality of quotient constructors reflects the representative relation. -/
theorem ZModLike.exact {N : ℕ} {a b : ℤ}
    (h : ZModLike.mk N a = ZModLike.mk N b) :
    ModRel N a b :=
  Quotient.exact h

@[simp] theorem ZModLike.mk_eq_mk_iff {N : ℕ} {a b : ℤ} :
    ZModLike.mk N a = ZModLike.mk N b ↔ ModRel N a b :=
  ⟨ZModLike.exact, ZModLike.sound⟩

/-- Multiplication by an integer representative descends to the local
congruence quotient. -/
def ZModLike.mulLeft (M N : ℕ) : ZModLike N → ZModLike N :=
  Quotient.map (fun a : ℤ => (M : ℤ) * a) (by
    intro a b hab
    change (N : ℤ) ∣ a - b at hab
    change (N : ℤ) ∣ (M : ℤ) * a - (M : ℤ) * b
    rcases hab with ⟨k, hk⟩
    refine ⟨(M : ℤ) * k, ?_⟩
    calc
      (M : ℤ) * a - (M : ℤ) * b = (M : ℤ) * (a - b) := by ring
      _ = (M : ℤ) * ((N : ℤ) * k) := by rw [hk]
      _ = (N : ℤ) * ((M : ℤ) * k) := by ring)

@[simp] theorem ZModLike.mulLeft_mk (M N : ℕ) (a : ℤ) :
    ZModLike.mulLeft M N (ZModLike.mk N a) =
      ZModLike.mk N ((M : ℤ) * a) :=
  rfl

@[simp] theorem ZModLike.mulLeft_mk_eq_zero_iff
    (M N : ℕ) (a : ℤ) :
    ZModLike.mulLeft M N (ZModLike.mk N a) = ZModLike.zero N ↔
      ModRel N ((M : ℤ) * a) 0 := by
  change ZModLike.mk N ((M : ℤ) * a) = ZModLike.mk N 0 ↔
    ModRel N ((M : ℤ) * a) 0
  exact ZModLike.mk_eq_mk_iff

/-- Local cyclic Tor model: the kernel of multiplication by `M` on the
congruence quotient modulo `N`. -/
def Tor1CyclicModel (M N : ℕ) : Type :=
  {x : ZModLike N // ZModLike.mulLeft M N x = ZModLike.zero N}

@[simp] theorem Tor1CyclicModel_kernel_iff
    (M N : ℕ) (x : Tor1CyclicModel M N) :
    ZModLike.mulLeft M N x.1 = ZModLike.zero N :=
  x.2

/-- A representative satisfying the kernel congruence yields a local Tor
element.  `Quotient.sound` is the only quotient-soundness step. -/
def torElementOfRepresentative (M N : ℕ) (a : ℤ)
    (ha : ModRel N ((M : ℤ) * a) 0) : Tor1CyclicModel M N := by
  refine ⟨ZModLike.mk N a, ?_⟩
  change ZModLike.mk N ((M : ℤ) * a) = ZModLike.mk N 0
  exact ZModLike.sound ha

/-- Representative-level compatibility of two residue constraints. -/
def RepresentativeCompatible (M N a b : ℤ) : Prop :=
  ∃ x : ℤ,
    PrincipalIdeal M (x - a) ∧ PrincipalIdeal N (x - b)

/-- Representative-level kernel predicate for the comparison map. -/
def RepresentativeKernel (M N a b : ℤ) : Prop :=
  PrincipalIdeal (↑(Int.gcd M N) : ℤ) (a - b)

/-- Representative-level exactness, replacing quotient exactness in the
fallback model. -/
theorem representative_exactness_iff
    (M N a b : ℤ) :
    RepresentativeCompatible M N a b ↔ RepresentativeKernel M N a b := by
  simpa [RepresentativeCompatible, RepresentativeKernel, PrincipalIdeal] using
    (crt_solvable_iff M N a b)

theorem representativeKernel_of_compatible
    {M N a b : ℤ} (h : RepresentativeCompatible M N a b) :
    RepresentativeKernel M N a b :=
  (representative_exactness_iff M N a b).mp h

theorem representativeCompatible_of_kernel
    {M N a b : ℤ} (h : RepresentativeKernel M N a b) :
    RepresentativeCompatible M N a b :=
  (representative_exactness_iff M N a b).mpr h

/-! ### §G.2 — Direct finite-cover equalizer sheaf model. -/

/-- Data of global, local, and pairwise-overlap sections for a fixed finite
cover. -/
structure FiniteCoverSheafData (I : Type u) [Fintype I] where
  SectionGlobal : Type v
  SectionLocal : I → Type v
  SectionOverlap : I → I → Type v
  resGlobal : ∀ i : I, SectionGlobal → SectionLocal i
  resLeft : ∀ i j : I, SectionLocal i → SectionOverlap i j
  resRight : ∀ i j : I, SectionLocal j → SectionOverlap i j

namespace FiniteCoverSheafData

variable {I : Type u} [Fintype I]
variable (D : FiniteCoverSheafData.{u, v} I)

abbrev LocalFamily : Type (max u v) :=
  ∀ i : I, D.SectionLocal i

def Compatible (s : D.LocalFamily) : Prop :=
  ∀ i j : I, D.resLeft i j (s i) = D.resRight i j (s j)

abbrev Equalizer : Type (max u v) :=
  {s : D.LocalFamily // D.Compatible s}

def restrictGlobal (x : D.SectionGlobal) : D.LocalFamily :=
  fun i => D.resGlobal i x

end FiniteCoverSheafData

/-- Finite-cover locality and gluing axioms, stated without a general sheaf
category. -/
structure FiniteCoverSheafAxioms
    {I : Type u} [Fintype I] (D : FiniteCoverSheafData.{u, v} I) : Type (max u v) where
  global_compatible :
    ∀ x : D.SectionGlobal, D.Compatible (D.restrictGlobal x)
  locality :
    ∀ {x y : D.SectionGlobal},
      (∀ i : I, D.resGlobal i x = D.resGlobal i y) → x = y
  glue :
    ∀ s : D.LocalFamily, D.Compatible s → D.SectionGlobal
  glue_restrict :
    ∀ (s : D.LocalFamily) (hs : D.Compatible s) (i : I),
      D.resGlobal i (glue s hs) = s i

namespace FiniteCoverSheafAxioms

variable {I : Type u} [Fintype I]
variable {D : FiniteCoverSheafData.{u, v} I}

def globalToEqualizer (H : FiniteCoverSheafAxioms D)
    (x : D.SectionGlobal) : D.Equalizer :=
  ⟨D.restrictGlobal x, H.global_compatible x⟩

@[simp] theorem globalToEqualizer_val
    (H : FiniteCoverSheafAxioms D) (x : D.SectionGlobal) :
    (H.globalToEqualizer x).1 = D.restrictGlobal x :=
  rfl

/-- Gluing the restrictions of a global section returns that section. -/
theorem glue_restrictGlobal
    (H : FiniteCoverSheafAxioms D) (x : D.SectionGlobal) :
    H.glue (D.restrictGlobal x) (H.global_compatible x) = x := by
  apply H.locality
  intro i
  exact H.glue_restrict (D.restrictGlobal x)
    (H.global_compatible x) i

/-- Restricting a glued compatible family returns the original family. -/
theorem restrictGlobal_glue
    (H : FiniteCoverSheafAxioms D)
    (s : D.LocalFamily) (hs : D.Compatible s) :
    D.restrictGlobal (H.glue s hs) = s := by
  funext i
  exact H.glue_restrict s hs i

/-- Direct finite-cover sheaf theorem: global sections are equivalent to the
pointwise equalizer of the two overlap maps. -/
def globalSectionsEquivEqualizer
    (H : FiniteCoverSheafAxioms D) :
    D.SectionGlobal ≃ D.Equalizer where
  toFun := H.globalToEqualizer
  invFun := fun e => H.glue e.1 e.2
  left_inv := glue_restrictGlobal H
  right_inv := by
    intro e
    apply Subtype.ext
    exact restrictGlobal_glue H e.1 e.2

theorem global_sections_equalizer_nonempty
    (H : FiniteCoverSheafAxioms D) :
    Nonempty (D.SectionGlobal ≃ D.Equalizer) :=
  ⟨H.globalSectionsEquivEqualizer⟩

end FiniteCoverSheafAxioms

/-! ### §G.3 — Abstract forms, local covariance, and curvature. -/

/-- Abstract degree-indexed form presheaf over a preorder of opens. -/
structure AbstractFormSheaf (Open : Type u) [Preorder Open] where
  Form : ℕ → Open → Type v
  res : ∀ (n : ℕ) {U V : Open}, U ≤ V → Form n V → Form n U
  res_id :
    ∀ (n : ℕ) (U : Open) (A : Form n U),
      res n (le_refl U) A = A
  res_comp :
    ∀ (n : ℕ) {U V W : Open}
      (hUV : U ≤ V) (hVW : V ≤ W) (A : Form n W),
      res n hUV (res n hVW A) = res n (le_trans hUV hVW) A

/-- A local covariance predicate on one-forms. -/
def LocalCovariancePredicate
    {Open : Type u} [Preorder Open] (S : AbstractFormSheaf Open) :=
  ∀ U : Open, S.Form 1 U → Prop

/-- Restriction stability is the fallback form of Lemma 6.1. -/
structure RestrictionStableCovariance
    {Open : Type u} [Preorder Open] (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S) : Prop where
  restrict_stable :
    ∀ {U V : Open} (hUV : U ≤ V) (A : S.Form 1 V),
      Covariant V A → Covariant U (S.res 1 hUV A)

def CovariantOneForm
    {Open : Type u} [Preorder Open] (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S) (U : Open) :=
  {A : S.Form 1 U // Covariant U A}

def restrictCovariantOneForm
    {Open : Type u} [Preorder Open] {S : AbstractFormSheaf Open}
    {Covariant : LocalCovariancePredicate S}
    (H : RestrictionStableCovariance S Covariant)
    {U V : Open} (hUV : U ≤ V)
    (A : CovariantOneForm S Covariant V) :
    CovariantOneForm S Covariant U :=
  ⟨S.res 1 hUV A.1, H.restrict_stable hUV A.1 A.2⟩

@[simp] theorem restrictCovariantOneForm_val
    {Open : Type u} [Preorder Open] {S : AbstractFormSheaf Open}
    {Covariant : LocalCovariancePredicate S}
    (H : RestrictionStableCovariance S Covariant)
    {U V : Open} (hUV : U ≤ V)
    (A : CovariantOneForm S Covariant V) :
    (restrictCovariantOneForm H hUV A).1 = S.res 1 hUV A.1 :=
  rfl

@[simp] theorem restrictCovariantOneForm_property
    {Open : Type u} [Preorder Open] {S : AbstractFormSheaf Open}
    {Covariant : LocalCovariancePredicate S}
    (H : RestrictionStableCovariance S Covariant)
    {U V : Open} (hUV : U ≤ V)
    (A : CovariantOneForm S Covariant V) :
    Covariant U (S.res 1 hUV A.1) :=
  (restrictCovariantOneForm H hUV A).2

@[simp] theorem restrictCovariantOneForm_id
    {Open : Type u} [Preorder Open] {S : AbstractFormSheaf Open}
    {Covariant : LocalCovariancePredicate S}
    (H : RestrictionStableCovariance S Covariant)
    {U : Open} (A : CovariantOneForm S Covariant U) :
    restrictCovariantOneForm H (le_refl U) A = A := by
  apply Subtype.ext
  exact S.res_id 1 U A.1

theorem restrictCovariantOneForm_comp
    {Open : Type u} [Preorder Open] {S : AbstractFormSheaf Open}
    {Covariant : LocalCovariancePredicate S}
    (H : RestrictionStableCovariance S Covariant)
    {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W)
    (A : CovariantOneForm S Covariant W) :
    restrictCovariantOneForm H hUV
        (restrictCovariantOneForm H hVW A) =
      restrictCovariantOneForm H (le_trans hUV hVW) A := by
  apply Subtype.ext
  exact S.res_comp 1 hUV hVW A.1

/-- Abstract algebraic curvature operations and their restriction identities. -/
structure AbstractCurvatureOperations
    {Open : Type u} [Preorder Open] (S : AbstractFormSheaf Open) where
  add₂ : ∀ U : Open, S.Form 2 U → S.Form 2 U → S.Form 2 U
  d : ∀ U : Open, S.Form 1 U → S.Form 2 U
  wedge : ∀ U : Open, S.Form 1 U → S.Form 1 U → S.Form 2 U
  res_add₂ :
    ∀ {U V : Open} (hUV : U ≤ V) (α β : S.Form 2 V),
      S.res 2 hUV (add₂ V α β) =
        add₂ U (S.res 2 hUV α) (S.res 2 hUV β)
  res_d :
    ∀ {U V : Open} (hUV : U ≤ V) (A : S.Form 1 V),
      S.res 2 hUV (d V A) = d U (S.res 1 hUV A)
  res_wedge :
    ∀ {U V : Open} (hUV : U ≤ V) (A B : S.Form 1 V),
      S.res 2 hUV (wedge V A B) =
        wedge U (S.res 1 hUV A) (S.res 1 hUV B)

namespace AbstractCurvatureOperations

variable {Open : Type u} [Preorder Open]
variable {S : AbstractFormSheaf Open}
variable (C : AbstractCurvatureOperations S)

noncomputable def curvature {U : Open} (A : S.Form 1 U) : S.Form 2 U :=
  C.add₂ U (C.d U A) (C.wedge U A A)

@[simp] theorem curvature_formula {U : Open} (A : S.Form 1 U) :
    C.curvature A = C.add₂ U (C.d U A) (C.wedge U A A) :=
  rfl

theorem curvature_restrict
    {U V : Open} (hUV : U ≤ V) (A : S.Form 1 V) :
    S.res 2 hUV (C.curvature A) =
      C.curvature (S.res 1 hUV A) := by
  change
    S.res 2 hUV (C.add₂ V (C.d V A) (C.wedge V A A)) =
      C.add₂ U (C.d U (S.res 1 hUV A))
        (C.wedge U (S.res 1 hUV A) (S.res 1 hUV A))
  calc
    S.res 2 hUV (C.add₂ V (C.d V A) (C.wedge V A A)) =
        C.add₂ U (S.res 2 hUV (C.d V A))
          (S.res 2 hUV (C.wedge V A A)) :=
      C.res_add₂ hUV (C.d V A) (C.wedge V A A)
    _ = C.add₂ U (C.d U (S.res 1 hUV A))
          (C.wedge U (S.res 1 hUV A) (S.res 1 hUV A)) := by
      rw [C.res_d hUV A, C.res_wedge hUV A A]

end AbstractCurvatureOperations

/-! ### §G.4 — Fallback certification packages. -/

structure ArithmeticFallbackCertificate : Prop where
  principal_membership :
    ∀ a n : ℤ, PrincipalIdeal a n ↔ a ∣ n
  principal_add_closed :
    ∀ {a x y : ℤ}, PrincipalIdeal a x → PrincipalIdeal a y →
      PrincipalIdeal a (x + y)
  intersection_membership :
    ∀ (I J : ℤ → Prop) (n : ℤ),
      PredicateInter I J n ↔ I n ∧ J n
  sum_membership :
    ∀ (I J : ℤ → Prop) (n : ℤ),
      PredicateSum I J n ↔
        ∃ x y : ℤ, I x ∧ J y ∧ n = x + y
  representative_exactness :
    ∀ M N a b : ℤ,
      RepresentativeCompatible M N a b ↔ RepresentativeKernel M N a b
  quotient_soundness_is_explicit :
    ∀ (N : ℕ) (a b : ℤ),
      ModRel N a b → ZModLike.mk N a = ZModLike.mk N b
  quotient_exactness_is_explicit :
    ∀ (N : ℕ) (a b : ℤ),
      ZModLike.mk N a = ZModLike.mk N b → ModRel N a b
  tor_is_mulLeft_kernel :
    ∀ (M N : ℕ) (x : Tor1CyclicModel M N),
      ZModLike.mulLeft M N x.1 = ZModLike.zero N
  representative_tor_kernel :
    ∀ (M N : ℕ) (a : ℤ),
      ZModLike.mulLeft M N (ZModLike.mk N a) = ZModLike.zero N ↔
        ModRel N ((M : ℤ) * a) 0

theorem arithmeticFallback_certificate : ArithmeticFallbackCertificate := by
  exact
    { principal_membership := mem_PrincipalIdeal_iff
      principal_add_closed := PrincipalIdeal.add_mem
      intersection_membership := mem_PredicateInter_iff
      sum_membership := mem_PredicateSum_iff
      representative_exactness := representative_exactness_iff
      quotient_soundness_is_explicit := fun N a b h => ZModLike.sound h
      quotient_exactness_is_explicit := fun N a b h => ZModLike.exact h
      tor_is_mulLeft_kernel := Tor1CyclicModel_kernel_iff
      representative_tor_kernel := ZModLike.mulLeft_mk_eq_zero_iff }

structure FiniteCoverFallbackCertificate
    {I : Type u} [Fintype I] (D : FiniteCoverSheafData.{u, v} I)
    (H : FiniteCoverSheafAxioms D) : Prop where
  global_equalizer_equiv : Nonempty (D.SectionGlobal ≃ D.Equalizer)
  global_families_compatible :
    ∀ x : D.SectionGlobal, D.Compatible (D.restrictGlobal x)
  gluing_restricts :
    ∀ (s : D.LocalFamily) (hs : D.Compatible s) (i : I),
      D.resGlobal i (H.glue s hs) = s i
  gluing_global_inverse :
    ∀ x : D.SectionGlobal,
      H.glue (D.restrictGlobal x) (H.global_compatible x) = x
  restriction_gluing_inverse :
    ∀ (s : D.LocalFamily) (hs : D.Compatible s),
      D.restrictGlobal (H.glue s hs) = s

theorem finiteCoverFallback_certificate
    {I : Type u} [Fintype I] (D : FiniteCoverSheafData.{u, v} I)
    (H : FiniteCoverSheafAxioms D) :
    FiniteCoverFallbackCertificate D H := by
  exact
    { global_equalizer_equiv := H.global_sections_equalizer_nonempty
      global_families_compatible := H.global_compatible
      gluing_restricts := H.glue_restrict
      gluing_global_inverse := H.glue_restrictGlobal
      restriction_gluing_inverse := H.restrictGlobal_glue }

structure CovarianceFallbackCertificate
    {Open : Type u} [Preorder Open]
    (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S)
    (H : RestrictionStableCovariance S Covariant) : Prop where
  restriction_preserves_covariance :
    ∀ {U V : Open} (hUV : U ≤ V)
      (A : CovariantOneForm S Covariant V),
      Covariant U (S.res 1 hUV A.1)
  restricted_value :
    ∀ {U V : Open} (hUV : U ≤ V)
      (A : CovariantOneForm S Covariant V),
      (restrictCovariantOneForm H hUV A).1 = S.res 1 hUV A.1
  restriction_identity :
    ∀ {U : Open} (A : CovariantOneForm S Covariant U),
      restrictCovariantOneForm H (le_refl U) A = A
  restriction_composition :
    ∀ {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W)
      (A : CovariantOneForm S Covariant W),
      restrictCovariantOneForm H hUV
          (restrictCovariantOneForm H hVW A) =
        restrictCovariantOneForm H (le_trans hUV hVW) A

theorem covarianceFallback_certificate
    {Open : Type u} [Preorder Open]
    (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S)
    (H : RestrictionStableCovariance S Covariant) :
    CovarianceFallbackCertificate S Covariant H := by
  exact
    { restriction_preserves_covariance :=
        restrictCovariantOneForm_property H
      restricted_value := restrictCovariantOneForm_val H
      restriction_identity := restrictCovariantOneForm_id H
      restriction_composition := restrictCovariantOneForm_comp H }

structure CurvatureFallbackCertificate
    {Open : Type u} [Preorder Open]
    (S : AbstractFormSheaf Open) (C : AbstractCurvatureOperations S) : Prop where
  curvature_formula :
    ∀ {U : Open} (A : S.Form 1 U),
      C.curvature A = C.add₂ U (C.d U A) (C.wedge U A A)
  curvature_restriction :
    ∀ {U V : Open} (hUV : U ≤ V) (A : S.Form 1 V),
      S.res 2 hUV (C.curvature A) =
        C.curvature (S.res 1 hUV A)

theorem curvatureFallback_certificate
    {Open : Type u} [Preorder Open]
    (S : AbstractFormSheaf Open) (C : AbstractCurvatureOperations S) :
    CurvatureFallbackCertificate S C := by
  exact
    { curvature_formula := C.curvature_formula
      curvature_restriction := C.curvature_restrict }

/-- Single auditable package collecting every high-level-Mathlib-free fallback
layer.  All interface assumptions are parameters of the package. -/
structure FallbackCertificationBundle
    {I : Type u} [Fintype I]
    (D : FiniteCoverSheafData.{u, v} I) (HD : FiniteCoverSheafAxioms D)
    {Open : Type w} [Preorder Open]
    (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S)
    (HCov : RestrictionStableCovariance S Covariant)
    (C : AbstractCurvatureOperations S) : Prop where
  arithmetic : ArithmeticFallbackCertificate
  finiteCover : FiniteCoverFallbackCertificate D HD
  covariance : CovarianceFallbackCertificate S Covariant HCov
  curvature : CurvatureFallbackCertificate S C

theorem fallbackCertificationBundle
    {I : Type u} [Fintype I]
    (D : FiniteCoverSheafData.{u, v} I) (HD : FiniteCoverSheafAxioms D)
    {Open : Type w} [Preorder Open]
    (S : AbstractFormSheaf Open)
    (Covariant : LocalCovariancePredicate S)
    (HCov : RestrictionStableCovariance S Covariant)
    (C : AbstractCurvatureOperations S) :
    FallbackCertificationBundle D HD S Covariant HCov C := by
  exact
    { arithmetic := arithmeticFallback_certificate
      finiteCover := finiteCoverFallback_certificate D HD
      covariance := covarianceFallback_certificate S Covariant HCov
      curvature := curvatureFallback_certificate S C }

end MathlibFreeFallback

section Examples
example : Nat.gcd 12 9 = 3 := by norm_num
example : ¬ (∃ x : ℤ, (6:ℤ) ∣ (x - 1) ∧ (9:ℤ) ∣ (x - 0)) := by rw [crt_solvable_iff]; decide
end Examples

/-!
## §F.2.4 — Assumption-free nonzero models and analytic no-go results

The paper does not specify enough analytic data to construct its named
half-integral-weight Laplacian, potential, mock coefficients, Eichler integral,
or cusp transport.  Those particular objects therefore cannot honestly be
manufactured from prose.  This section proves two stronger facts that can be
certified without hidden inputs:

* all corrected interfaces have explicit nonzero models, so the earlier zero
  witnesses are not being used to make the formalization vacuous;
* literal paper claims that obstruct the requested interpretation are refuted
  by theorem: the quotient-radius map does not descend (proved above), the
  standard q-parameter never has norm greater than one on the upper
  half-plane, `Gamma(2)` cannot carry infinity to the cusp zero, and flatness
  alone does not select a unique transport.

The final certificate below keeps these positive constructions and no-go
results in one auditable proposition.
-/

namespace Definition11

noncomputable section

/-- The standard upper-half-plane q-parameter always lies in the open unit
disk. -/
theorem qParameter_norm_lt_one (tau : H) :
    ‖qParameter tau‖ < 1 := by
  simpa [qRadius] using qRadius_lt_one tau

/-- Consequently the paper's `|q| > 1` clause cannot use the same parameter
`q = exp(2*pi*i*tau)` with `tau` still in the upper half-plane. -/
theorem no_qParameter_outside_unitDisk :
    ¬ ∃ tau : H, 1 < ‖qParameter tau‖ := by
  rintro ⟨tau, htau⟩
  exact (not_lt_of_ge (qParameter_norm_lt_one tau).le) htau

/-- Every matrix in the principal level-two subgroup has odd, hence nonzero,
top-left entry. -/
theorem gamma2_topLeft_ne_zero (g : Gamma2) :
    (g.1 0 0 : ℤ) ≠ 0 := by
  intro hzero
  have hmod : ((g.1 0 0 : ℤ) : ZMod 2) = 1 :=
    (CongruenceSubgroup.Gamma_mem.mp g.2).1
  rw [hzero] at hmod
  norm_num at hmod

/-- No element of `Gamma(2)` sends the projective cusp at infinity to zero.
This is the concrete obstruction to Proposition 13's instruction to choose an
element of `Gamma(2)` carrying infinity to every cusp. -/
theorem gamma2_does_not_send_infinity_to_zero (g : Gamma2) :
    (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) • (OnePoint.infty : OnePoint ℝ) ≠
      ((0 : ℝ) : OnePoint ℝ) := by
  have ha : (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) 0 0 ≠ 0 := by
    change ((g.1 0 0 : ℤ) : ℝ) ≠ 0
    exact_mod_cast gamma2_topLeft_ne_zero g
  by_cases hc : (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) 1 0 = 0
  · simp [OnePoint.smul_infty_eq_ite, hc]
  · have hdiv :
        (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) 0 0 /
          (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) 1 0 ≠ 0 :=
      div_ne_zero ha hc
    rw [OnePoint.smul_infty_eq_ite, if_neg hc]
    intro h
    exact hdiv (OnePoint.coe_injective h)

theorem no_gamma2_sends_infinity_to_zero :
    ¬ ∃ g : Gamma2,
      (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ g.1) • (OnePoint.infty : OnePoint ℝ) =
        ((0 : ℝ) : OnePoint ℝ) := by
  rintro ⟨g, hg⟩
  exact gamma2_does_not_send_infinity_to_zero g hg

/-- A completely explicit dense-domain analytic datum on the one-dimensional
complex Hilbert space.  Both operators vanish, but its solution fibre is
nonzero. -/
def scalarAnalyticData : AnalyticData ℂ where
  domain := ⊤
  domain_dense := by
    simpa using (dense_univ : Dense (Set.univ : Set ℂ))
  weightHalfLaplacian := 0
  potentialOperator := 0

@[simp] theorem scalarAnalyticData_totalOperator :
    scalarAnalyticData.totalOperator = 0 := by
  ext u
  change (0 : ℂ) + 0 = 0
  simp

/-- Every vector in the scalar datum's dense domain solves the zero-energy
equation. -/
theorem scalarAnalyticData_solutionSpace :
    scalarAnalyticData.solutionSpace = ⊤ := by
  ext u
  simp [AnalyticData.solutionSpace, scalarAnalyticData_totalOperator]

/-- The scalar `z`, bundled as an actual element of every corrected fibre. -/
def scalarSolution (z : ℂ) (r : RadiusBase) :
    Fibre scalarAnalyticData r := by
  let u : scalarAnalyticData.domain :=
    ⟨z, by simp [scalarAnalyticData]⟩
  refine ⟨u, ?_⟩
  change u ∈ scalarAnalyticData.solutionSpace
  rw [scalarAnalyticData_solutionSpace]
  trivial

@[simp] theorem scalarSolution_value (z : ℂ) (r : RadiusBase) :
    ((scalarSolution z r).1 : ℂ) = z :=
  rfl

@[simp] theorem scalarSolution_radius_independent
    (z : ℂ) (r s : RadiusBase) :
    scalarSolution z r = scalarSolution z s :=
  rfl

theorem scalarSolution_ne_zero {z : ℂ} (hz : z ≠ 0)
    (r : RadiusBase) : scalarSolution z r ≠ 0 := by
  intro hzero
  have hvalue := congrArg
    (fun u : Fibre scalarAnalyticData r => (u.1 : ℂ)) hzero
  exact hz (by simpa using hvalue)

/-- Every radius fibre in the explicit scalar model contains a nonzero
solution. -/
theorem scalarFibre_exists_nonzero (r : RadiusBase) :
    ∃ u : Fibre scalarAnalyticData r, u ≠ 0 :=
  ⟨scalarSolution 1 r, scalarSolution_ne_zero one_ne_zero r⟩

/-- A two-dimensional complex Hilbert space used for a genuinely nonzero
operator with a nonzero kernel. -/
abbrev TwoComponentSpace := WithLp 2 (ℂ × ℂ)

/-- Projection onto the first coordinate, defined on the dense full domain. -/
def firstCoordinateOperator :
    (⊤ : Submodule ℂ TwoComponentSpace) →ₗ[ℂ] TwoComponentSpace where
  toFun u := WithLp.toLp 2 (u.1.ofLp.1, 0)
  map_add' x y := by
    apply WithLp.ofLp_injective 2
    ext <;> simp
  map_smul' c x := by
    apply WithLp.ofLp_injective 2
    ext <;> simp

@[simp] theorem firstCoordinateOperator_apply
    (u : (⊤ : Submodule ℂ TwoComponentSpace)) :
    firstCoordinateOperator u = WithLp.toLp 2 (u.1.ofLp.1, 0) :=
  rfl

/-- Unlike the scalar test datum, this corrected analytic datum has a
genuinely nonzero operator as well as a nonzero solution space. -/
def twoComponentAnalyticData : AnalyticData TwoComponentSpace where
  domain := ⊤
  domain_dense := by
    simpa using (dense_univ : Dense (Set.univ : Set TwoComponentSpace))
  weightHalfLaplacian := firstCoordinateOperator
  potentialOperator := 0

theorem firstCoordinateOperator_ne_zero :
    firstCoordinateOperator ≠ 0 := by
  intro hzero
  let e : (⊤ : Submodule ℂ TwoComponentSpace) :=
    ⟨WithLp.toLp 2 (1, 0), by simp⟩
  have hvalue := congrArg
    (fun T : (⊤ : Submodule ℂ TwoComponentSpace) →ₗ[ℂ]
        TwoComponentSpace => T e) hzero
  have hfirst := congrArg (fun z : TwoComponentSpace => z.ofLp.1) hvalue
  norm_num [e, firstCoordinateOperator] at hfirst

/-- The vertical unit vector lies in the kernel of the nonzero projection. -/
def verticalSolution (r : RadiusBase) :
    Fibre twoComponentAnalyticData r := by
  let u : twoComponentAnalyticData.domain :=
    ⟨WithLp.toLp 2 ((0 : ℂ), (1 : ℂ)), by simp [twoComponentAnalyticData]⟩
  refine ⟨u, ?_⟩
  change firstCoordinateOperator u + 0 = 0
  simp only [add_zero]
  apply WithLp.ofLp_injective 2
  ext <;> simp [firstCoordinateOperator, u]

theorem verticalSolution_ne_zero (r : RadiusBase) :
    verticalSolution r ≠ 0 := by
  intro hzero
  have hsecond := congrArg
    (fun u : Fibre twoComponentAnalyticData r =>
      ((u.1 : twoComponentAnalyticData.domain) : TwoComponentSpace).ofLp.2)
    hzero
  norm_num [verticalSolution] at hsecond

/-- A genuinely nonzero operator and a nonzero zero-energy solution coexist
in one completely explicit, assumption-free corrected datum. -/
theorem twoComponent_nontrivial_operator_and_solution (r : RadiusBase) :
    twoComponentAnalyticData.weightHalfLaplacian ≠ 0 ∧
      ∃ u : Fibre twoComponentAnalyticData r, u ≠ 0 :=
  ⟨firstCoordinateOperator_ne_zero,
    ⟨verticalSolution r, verticalSolution_ne_zero r⟩⟩

/-- Two concrete radii used to exhibit non-uniqueness of flat transport. -/
def halfRadius : RadiusBase :=
  ⟨(1 / 2 : ℝ), by norm_num, by norm_num⟩

def quarterRadius : RadiusBase :=
  ⟨(1 / 4 : ℝ), by norm_num, by norm_num⟩

theorem halfRadius_ne_quarterRadius : halfRadius ≠ quarterRadius := by
  intro h
  have hvalue := congrArg (fun r : RadiusBase => (r : ℝ)) h
  norm_num [halfRadius, quarterRadius] at hvalue

theorem quarterRadius_ne_halfRadius : quarterRadius ≠ halfRadius :=
  Ne.symm halfRadius_ne_quarterRadius

/-- The radius interval is path connected; this supplies an explicit path
class for the flat-transport counterexample below. -/
instance instPathConnectedSpaceRadiusBase : PathConnectedSpace RadiusBase :=
  isPathConnected_iff_pathConnectedSpace.mp
    ((convex_Ioo (0 : ℝ) 1).isPathConnected
      ⟨(1 / 2 : ℝ), by norm_num⟩)

/-- A selected path between the two concrete radii. -/
noncomputable def halfToQuarterPath : Path halfRadius quarterRadius :=
  PathConnectedSpace.somePath halfRadius quarterRadius

end

end Definition11

namespace Mmock

noncomputable section

namespace QSeries

/-- The q-series with constant value `c` and all positive coefficients zero. -/
def constantSeries (c : ℂ) : QSeries :=
  fun n => if n = 0 then c else 0

@[simp] theorem constantSeries_coeff_zero (c : ℂ) :
    constantSeries c 0 = c := by
  simp [constantSeries]

theorem constantSeries_hasSum (c q : ℂ) :
    HasSum (term (constantSeries c) q) c := by
  convert (hasSum_ite_eq (0 : ℕ) c) using 1
  funext n
  by_cases h : n = 0
  · subst n
    simp [term, constantSeries]
  · simp [term, constantSeries, h]

theorem constantSeries_convergesAt (c q : ℂ) :
    (constantSeries c).ConvergesAt q :=
  (constantSeries_hasSum c q).summable

@[simp] theorem constantSeries_sumAt (c q : ℂ) :
    (constantSeries c).sumAt q = c :=
  (constantSeries_hasSum c q).tsum_eq

theorem constantSeries_ne_zero {c : ℂ} (hc : c ≠ 0) :
    constantSeries c ≠ 0 := by
  intro hzero
  have hcoeff := congrFun hzero 0
  exact hc (by simpa using hcoeff)

/-- The one-term q-series `c*q^degree`. -/
def monomialSeries (degree : ℕ) (c : ℂ) : QSeries :=
  fun n => if n = degree then c else 0

@[simp] theorem monomialSeries_coeff_same (degree : ℕ) (c : ℂ) :
    monomialSeries degree c degree = c := by
  simp [monomialSeries]

theorem monomialSeries_coeff_ne {degree n : ℕ} (h : n ≠ degree)
    (c : ℂ) : monomialSeries degree c n = 0 := by
  simp [monomialSeries, h]

/-- A monomial q-series has a one-term sum at every complex parameter. -/
theorem monomialSeries_hasSum (degree : ℕ) (c q : ℂ) :
    HasSum (term (monomialSeries degree c) q) (c * q ^ degree) := by
  convert (hasSum_ite_eq degree (c * q ^ degree)) using 1
  funext n
  by_cases h : n = degree
  · subst n
    simp [term, monomialSeries]
  · simp [term, monomialSeries, h]

theorem monomialSeries_convergesAt (degree : ℕ) (c q : ℂ) :
    (monomialSeries degree c).ConvergesAt q :=
  (monomialSeries_hasSum degree c q).summable

@[simp] theorem monomialSeries_sumAt (degree : ℕ) (c q : ℂ) :
    (monomialSeries degree c).sumAt q = c * q ^ degree :=
  (monomialSeries_hasSum degree c q).tsum_eq

theorem monomialSeries_ne_zero {degree : ℕ} {c : ℂ} (hc : c ≠ 0) :
    monomialSeries degree c ≠ 0 := by
  intro hzero
  have hcoeff := congrFun hzero degree
  exact hc (by simpa using hcoeff)

@[simp] theorem degreeOneSeries_sumAt (c q : ℂ) :
    (monomialSeries 1 c).sumAt q = c * q := by
  simp

/-- Ordinary complex differentiation of the degree-one polynomial. -/
theorem degreeOne_hasDerivAt (c q : ℂ) :
    HasDerivAt (fun z : ℂ => c * z) c q :=
  hasDerivAt_const_mul c

/-- On degree-one q-series, the coefficient identity endomorphism is exactly
the logarithmic derivative `q*d/dq`. -/
theorem degreeOne_logDerivative_eq_sumAt (c q : ℂ) :
    q * deriv (fun z : ℂ => c * z) q =
      (monomialSeries 1 c).sumAt q := by
  rw [(degreeOne_hasDerivAt c q).deriv, degreeOneSeries_sumAt]
  ring

end QSeries

/-- A nonzero unary-theta test kernel whose q-series is the constant one. -/
def unitKernel : KernelData where
  psi := QSeries.constantSeries 1

/-- A nonzero triple satisfying the affine matching identity
`G = 2*psi - S` coefficientwise and pointwise. -/
def unitSeriesTriple : SeriesTriple where
  inside := QSeries.constantSeries 1
  correction := QSeries.constantSeries 1
  outside := QSeries.constantSeries 1

/-- An assumption-free, nonzero certified germ.  Every series is finite,
hence convergent on the entire complex plane, and matching is `1 = 2 - 1`. -/
def unitCertifiedGerm : CertifiedGerm unitKernel where
  series := unitSeriesTriple
  annulus := zeroCommonAnnulus
  annulus_converges := by
    intro q hq
    exact
      ⟨QSeries.constantSeries_convergesAt 1 q,
        QSeries.constantSeries_convergesAt 1 q,
        QSeries.constantSeries_convergesAt 1 q,
        ⟨zeroCommonAnnulus.ne_zero hq,
          QSeries.constantSeries_convergesAt 1 q⁻¹⟩⟩
  «matches» := by
    intro q _hq
    norm_num [unitKernel, unitSeriesTriple]

theorem unitKernel_psi_ne_zero : unitKernel.psi ≠ 0 := by
  simpa [unitKernel] using
    (QSeries.constantSeries_ne_zero (c := (1 : ℂ)) one_ne_zero)

theorem unitCertifiedGerm_inside_ne_zero :
    unitCertifiedGerm.series.inside ≠ 0 := by
  simpa [unitCertifiedGerm, unitSeriesTriple] using
    (QSeries.constantSeries_ne_zero (c := (1 : ℂ)) one_ne_zero)

theorem unitCertifiedGerm_correction_ne_zero :
    unitCertifiedGerm.series.correction ≠ 0 := by
  simpa [unitCertifiedGerm, unitSeriesTriple] using
    (QSeries.constantSeries_ne_zero (c := (1 : ℂ)) one_ne_zero)

theorem unitCertifiedGerm_outside_ne_zero :
    unitCertifiedGerm.series.outside ≠ 0 := by
  simpa [unitCertifiedGerm, unitSeriesTriple] using
    (QSeries.constantSeries_ne_zero (c := (1 : ℂ)) one_ne_zero)

/-- A nonconstant inside series with the same certified affine matching data.
The inside component is `q`; the kernel, correction, and outside components
remain the constant-one series, so matching is still `1 = 2 - 1`. -/
def degreeOneSeriesTriple : SeriesTriple where
  inside := QSeries.monomialSeries 1 1
  correction := QSeries.constantSeries 1
  outside := QSeries.constantSeries 1

def degreeOneCertifiedGerm : CertifiedGerm unitKernel where
  series := degreeOneSeriesTriple
  annulus := zeroCommonAnnulus
  annulus_converges := by
    intro q hq
    exact
      ⟨QSeries.monomialSeries_convergesAt 1 1 q,
        QSeries.constantSeries_convergesAt 1 q,
        QSeries.constantSeries_convergesAt 1 q,
        ⟨zeroCommonAnnulus.ne_zero hq,
          QSeries.constantSeries_convergesAt 1 q⁻¹⟩⟩
  «matches» := by
    intro q _hq
    norm_num [unitKernel, degreeOneSeriesTriple]

@[simp] theorem degreeOneCertifiedGerm_inside_sumAt (q : ℂ) :
    degreeOneCertifiedGerm.series.inside.sumAt q = q := by
  simp [degreeOneCertifiedGerm, degreeOneSeriesTriple]

theorem degreeOneCertifiedGerm_inside_ne_zero :
    degreeOneCertifiedGerm.series.inside ≠ 0 := by
  simpa [degreeOneCertifiedGerm, degreeOneSeriesTriple] using
    (QSeries.monomialSeries_ne_zero (degree := 1)
      (c := (1 : ℂ)) one_ne_zero)

/-- The inside function is genuinely nonconstant. -/
theorem degreeOneCertifiedGerm_inside_not_constant :
    ¬ ∀ q : ℂ,
      degreeOneCertifiedGerm.series.inside.sumAt q =
        degreeOneCertifiedGerm.series.inside.sumAt 0 := by
  intro hconstant
  have hone := hconstant 1
  norm_num [degreeOneCertifiedGerm_inside_sumAt] at hone

/-- The constant-one local section of the certified q-series sheaf.  On every
nonempty open its value is the nonzero germ constructed above. -/
def unitLocalSection (U : TopologicalSpace.Opens RadiusBase) :
    LocalSection unitKernel U :=
  LocallyConstant.const U unitCertifiedGerm

@[simp] theorem unitLocalSection_apply
    (U : TopologicalSpace.Opens RadiusBase) (r : U) :
    unitLocalSection U r = unitCertifiedGerm :=
  rfl

/-- The full Mmock structural certificate instantiated by nonzero data. -/
theorem unit_certificate : Certificate unitKernel :=
  certificate unitKernel

end

end Mmock

namespace Definition12Tensor

namespace MmockLinear

noncomputable section

open Mmock

/-- A constant q-series bundled with convergence on an arbitrary set. -/
def constantConvergentSeries (A : Set ℂ) (c : ℂ) :
    convergentSeries A :=
  ⟨QSeries.constantSeries c, fun q _hq =>
    QSeries.constantSeries_convergesAt c q⟩

/-- A raw variation with nonzero inside component and zero correction and
outside components. -/
def unitInsideVariationRaw (A : Set ℂ) : VariationRaw A :=
  ⟨constantConvergentSeries A 1, ⟨0, 0⟩⟩

/-- The raw unit-inside variation satisfies the homogeneous matching
condition because its two constrained components both vanish. -/
def unitInsideVariation (A : Set ℂ) : homogeneousVariation A :=
  ⟨unitInsideVariationRaw A,
    (mem_homogeneousVariation_iff A (unitInsideVariationRaw A)).2 (by
      intro q
      simp [unitInsideVariationRaw, variationOutside,
        variationCorrection])⟩

theorem unitInsideVariation_inside_coeff_zero (A : Set ℂ) :
    homogeneousInside (unitInsideVariation A) 0 = 1 :=
  by
    simp [homogeneousInside, variationInside, unitInsideVariation,
      unitInsideVariationRaw, constantConvergentSeries,
      QSeries.constantSeries]

/-- The certified homogeneous Mmock variation fibre is nontrivial for every
convergence set, including the common annulus used by the concrete germ. -/
theorem unitInsideVariation_ne_zero (A : Set ℂ) :
    unitInsideVariation A ≠ 0 := by
  intro hzero
  have hcoeff := congrArg
    (fun v : homogeneousVariation A => homogeneousInside v 0) hzero
  have hone : (1 : ℂ) = 0 := by
    calc
      (1 : ℂ) = homogeneousInside (unitInsideVariation A) 0 :=
        (unitInsideVariation_inside_coeff_zero A).symm
      _ = homogeneousInside (0 : homogeneousVariation A) 0 := hcoeff
      _ = 0 := by rfl
  exact one_ne_zero hone

/-- A degree-one inside series bundled with convergence on an arbitrary set. -/
def degreeOneConvergentSeries (A : Set ℂ) (c : ℂ) :
    convergentSeries A :=
  ⟨QSeries.monomialSeries 1 c, fun q _hq =>
    QSeries.monomialSeries_convergesAt 1 c q⟩

/-- The homogeneous variation represented by the degree-one inside polynomial
`c*q`; correction and outside variations vanish. -/
def degreeOneInsideVariationRaw (A : Set ℂ) (c : ℂ) : VariationRaw A :=
  ⟨degreeOneConvergentSeries A c, ⟨0, 0⟩⟩

def degreeOneInsideVariation (A : Set ℂ) (c : ℂ) :
    homogeneousVariation A :=
  ⟨degreeOneInsideVariationRaw A c,
    (mem_homogeneousVariation_iff A
      (degreeOneInsideVariationRaw A c)).2 (by
        intro q
        simp [degreeOneInsideVariationRaw, variationOutside,
          variationCorrection])⟩

@[simp] theorem degreeOneInsideVariation_sumAt
    (A : Set ℂ) (c q : ℂ) :
    (homogeneousInside (degreeOneInsideVariation A c)).sumAt q = c * q := by
  simp [homogeneousInside, variationInside, degreeOneInsideVariation,
    degreeOneInsideVariationRaw, degreeOneConvergentSeries]

theorem degreeOneInsideVariation_ne_zero (A : Set ℂ) {c : ℂ}
    (hc : c ≠ 0) : degreeOneInsideVariation A c ≠ 0 := by
  intro hzero
  have hvalue := congrArg
    (fun v : homogeneousVariation A => (homogeneousInside v).sumAt 1)
    hzero
  have hc0 : c = 0 := by
    calc
      c = (homogeneousInside (degreeOneInsideVariation A c)).sumAt 1 := by
        simpa using (degreeOneInsideVariation_sumAt A c 1).symm
      _ = (homogeneousInside (0 : homogeneousVariation A)).sumAt 1 := hvalue
      _ = 0 := by
        simp [homogeneousInside, variationInside]
  exact hc hc0

end


end MmockLinear

