end Definition13QCovariant

/-- Legacy Cartesian-pair carrier retained for compatibility.  This is not the
tensor product `Lq ⊗ Mmock`; the genuine Definition 12 object is
`Definition12Tensor.tensorPresheaf`. -/
structure QGaugeVariable {Open : Type u} [Preorder Open]
    (Lq : QLocalSystem Open) (Mmock : MockBundle Open) (U : Open) where
  localSystemPart : Lq.Fiber U
  mockPart : Mmock.Section U

/-- Compatibility alias for the legacy pair model `QLocalSystem × MockBundle`.
It is deliberately not advertised as a tensor product. -/
def qGaugeVariables {Open : Type u} [Preorder Open]
    (Lq : QLocalSystem Open) (Mmock : MockBundle Open) (U : Open) :=
  QGaugeVariable Lq Mmock U

namespace QGaugeVariable

variable {Open : Type u} [Preorder Open]
variable {Lq : QLocalSystem Open} {Mmock : MockBundle Open}

/-- Extensionality of the legacy Cartesian-pair model. -/
theorem ext {U : Open} {x y : qGaugeVariables Lq Mmock U}
    (hL : x.localSystemPart = y.localSystemPart)
    (hM : x.mockPart = y.mockPart) :
    x = y := by
  cases x
  cases y
  cases hL
  cases hM
  rfl

/-- Componentwise restriction of q-gauge variables. -/
noncomputable def restrict {U V : Open} (hUV : U ≤ V)
    (x : qGaugeVariables Lq Mmock V) : qGaugeVariables Lq Mmock U where
  localSystemPart := Lq.res hUV x.localSystemPart
  mockPart := Mmock.res hUV x.mockPart

@[simp] theorem restrict_localSystemPart {U V : Open} (hUV : U ≤ V)
    (x : qGaugeVariables Lq Mmock V) :
    (restrict hUV x).localSystemPart = Lq.res hUV x.localSystemPart :=
  rfl

@[simp] theorem restrict_mockPart {U V : Open} (hUV : U ≤ V)
    (x : qGaugeVariables Lq Mmock V) :
    (restrict hUV x).mockPart = Mmock.res hUV x.mockPart :=
  rfl

theorem restrict_id (U : Open) (x : qGaugeVariables Lq Mmock U) :
    restrict (le_refl U) x = x := by
  apply ext
  · exact Lq.res_id U x.localSystemPart
  · exact Mmock.res_id U x.mockPart

theorem restrict_comp {U V W : Open}
    (hUV : U ≤ V) (hVW : V ≤ W) (x : qGaugeVariables Lq Mmock W) :
    restrict hUV (restrict hVW x) = restrict (le_trans hUV hVW) x := by
  apply ext
  · exact Lq.res_comp hUV hVW x.localSystemPart
  · exact Mmock.res_comp hUV hVW x.mockPart

end QGaugeVariable

/-- The legacy Cartesian-pair q-gauge variables as a presheaf. -/
noncomputable def qGaugeVariablesPresheaf {Open : Type u} [Preorder Open]
    (Lq : QLocalSystem Open) (Mmock : MockBundle Open) :
    QGaugePresheaf Open where
  Field := qGaugeVariables Lq Mmock
  res := QGaugeVariable.restrict
  res_id := QGaugeVariable.restrict_id
  res_comp := QGaugeVariable.restrict_comp

/-- Legacy pair API instantiated with the actual q-series `Mmock` bundle.  See
`Definition12Tensor.actualGenuineTensorPresheaf` for the genuine tensor model. -/
def actualQGaugeVariables
    (Lq : QLocalSystem (TopologicalSpace.Opens Mmock.RadiusBase))
    (K : Mmock.KernelData) (U : TopologicalSpace.Opens Mmock.RadiusBase) :=
  qGaugeVariables Lq (Mmock.actualBundle K) U

/-- The existing pair-presheaf compatibility API with the actual `Mmock` sheaf
as its mock component. -/
noncomputable def actualQGaugeVariablesPresheaf
    (Lq : QLocalSystem (TopologicalSpace.Opens Mmock.RadiusBase))
    (K : Mmock.KernelData) :
    QGaugePresheaf (TopologicalSpace.Opens Mmock.RadiusBase) :=
  qGaugeVariablesPresheaf Lq (Mmock.actualBundle K)

@[simp] theorem actualQGaugeVariablesPresheaf_field
    (Lq : QLocalSystem (TopologicalSpace.Opens Mmock.RadiusBase))
    (K : Mmock.KernelData) (U : TopologicalSpace.Opens Mmock.RadiusBase) :
    (actualQGaugeVariablesPresheaf Lq K).Field U =
      actualQGaugeVariables Lq K U :=
  rfl

@[simp] theorem actualQGaugeVariables_restrict_mockPart
    {Lq : QLocalSystem (TopologicalSpace.Opens Mmock.RadiusBase)}
    {K : Mmock.KernelData}
    {U V : TopologicalSpace.Opens Mmock.RadiusBase} (hUV : U ≤ V)
    (x : actualQGaugeVariables Lq K V) :
    (QGaugeVariable.restrict
        (Lq := Lq) (Mmock := Mmock.actualBundle K) hUV x).mockPart =
      (Mmock.actualBundle K).res hUV x.mockPart :=
  rfl

namespace QGaugePresheaf

variable {Open : Type u} [Preorder Open] (Aq : QGaugePresheaf Open)

/-- Legacy endomorphism-target compatibility interface for Definition 13.
The corrected construction with codomain `Aq ⊗ Ω¹`, actual tensor maps,
Leibniz, and derived restriction naturality is
`Definition13QCovariant.Dq`. -/
structure QCovariantDerivative where
  Dq : ∀ U : Open, Aq.Field U → Aq.Field U
  radialPart : ∀ U : Open, Aq.Field U → Aq.Field U
  potentialPart : ∀ U : Open, Aq.Field U → Aq.Field U
  combine : ∀ U : Open, Aq.Field U → Aq.Field U → Aq.Field U
  local_formula :
    ∀ (U : Open) (A : Aq.Field U),
      Dq U A = combine U (radialPart U A) (potentialPart U A)
  restrict_Dq :
    ∀ {U V : Open} (hUV : U ≤ V) (A : Aq.Field V),
      Aq.res hUV (Dq V A) = Dq U (Aq.res hUV A)

theorem qCovariantDerivative_local_formula
    (D : Aq.QCovariantDerivative) (U : Open) (A : Aq.Field U) :
    D.Dq U A = D.combine U (D.radialPart U A) (D.potentialPart U A) :=
  D.local_formula U A

theorem qCovariantDerivative_restrict
    (D : Aq.QCovariantDerivative) {U V : Open}
    (hUV : U ≤ V) (A : Aq.Field V) :
    Aq.res hUV (D.Dq V A) = D.Dq U (Aq.res hUV A) :=
  D.restrict_Dq hUV A

/-- A natural morphism between set-valued q-gauge presheaves. -/
structure Morphism (A B : QGaugePresheaf Open) where
  app : ∀ U : Open, A.Field U → B.Field U
  naturality :
    ∀ {U V : Open} (hUV : U ≤ V) (s : A.Field V),
      B.res hUV (app V s) = app U (A.res hUV s)

@[simp] theorem Morphism.naturality_apply
    {A B : QGaugePresheaf Open} (f : Morphism A B)
    {U V : Open} (hUV : U ≤ V) (s : A.Field V) :
    B.res hUV (f.app V s) = f.app U (A.res hUV s) :=
  f.naturality hUV s

namespace Morphism

/-- Identity natural morphism of q-gauge presheaves. -/
def id (A : QGaugePresheaf Open) : Morphism A A where
  app := fun _ s => s
  naturality := by
    intro U V hUV s
    rfl

/-- Composition of natural q-gauge presheaf morphisms. -/
def comp {A B C : QGaugePresheaf Open}
    (f : Morphism A B) (g : Morphism B C) : Morphism A C where
  app := fun U s => g.app U (f.app U s)
  naturality := by
    intro U V hUV s
    rw [g.naturality, f.naturality]

@[simp] theorem id_app (A : QGaugePresheaf Open)
    (U : Open) (s : A.Field U) :
    (id A).app U s = s :=
  rfl

@[simp] theorem comp_app {A B C : QGaugePresheaf Open}
    (f : Morphism A B) (g : Morphism B C)
    (U : Open) (s : A.Field U) :
    (comp f g).app U s = g.app U (f.app U s) :=
  rfl

/-- Extensionality by the component functions; naturality proofs are
proof-irrelevant. -/
theorem ext {A B : QGaugePresheaf Open} {f g : Morphism A B}
    (h : ∀ (U : Open) (s : A.Field U), f.app U s = g.app U s) :
    f = g := by
  cases f with
  | mk fapp fnat =>
      cases g with
      | mk gapp gnat =>
          have happ : fapp = gapp := by
            funext U s
            exact h U s
          cases happ
          rfl

theorem id_comp {A B : QGaugePresheaf Open} (f : Morphism A B) :
    comp (id A) f = f := by
  apply ext
  intro U s
  rfl

theorem comp_id {A B : QGaugePresheaf Open} (f : Morphism A B) :
    comp f (id B) = f := by
  apply ext
  intro U s
  rfl

theorem comp_assoc {A B C D : QGaugePresheaf Open}
    (f : Morphism A B) (g : Morphism B C) (h : Morphism C D) :
    comp (comp f g) h = comp f (comp g h) := by
  apply ext
  intro U s
  rfl

end Morphism

/-- Definition 14: the pointwise equalizer of the inside and outside boundary
restriction morphisms. -/
def Eq {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) (U : Open) : Set (A.Field U) :=
  {s | res_in.app U s = res_out.app U s}

/-- Membership in the balanced equalizer is exactly equality of the two
boundary restrictions. -/
@[simp] theorem mem_Eq_iff {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) (U : Open) (s : A.Field U) :
    s ∈ Eq res_in res_out U ↔
      res_in.app U s = res_out.app U s :=
  Iff.rfl

/-- Naturality makes equalizer membership stable under restriction. -/
theorem Eq_restrict_mem {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) {U V : Open} (hUV : U ≤ V)
    (s : A.Field V) (hs : s ∈ Eq res_in res_out V) :
    A.res hUV s ∈ Eq res_in res_out U := by
  change res_in.app U (A.res hUV s) = res_out.app U (A.res hUV s)
  calc
    res_in.app U (A.res hUV s) = B.res hUV (res_in.app V s) :=
      (res_in.naturality hUV s).symm
    _ = B.res hUV (res_out.app V s) :=
      congrArg (fun t : B.Field V => B.res hUV t) hs
    _ = res_out.app U (A.res hUV s) :=
      res_out.naturality hUV s

/-- Restriction of a balanced equalizer section. -/
def balancedRestriction {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) {U V : Open} (hUV : U ≤ V)
    (s : ↥(Eq res_in res_out V)) : ↥(Eq res_in res_out U) :=
  ⟨A.res hUV s.1, Eq_restrict_mem res_in res_out hUV s.1 s.2⟩

@[simp] theorem balancedRestriction_val {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) {U V : Open} (hUV : U ≤ V)
    (s : ↥(Eq res_in res_out V)) :
    (balancedRestriction res_in res_out hUV s).1 = A.res hUV s.1 :=
  rfl

theorem balancedRestriction_id {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) (U : Open)
    (s : ↥(Eq res_in res_out U)) :
    balancedRestriction res_in res_out (le_refl U) s = s := by
  apply Subtype.ext
  exact A.res_id U s.1

theorem balancedRestriction_comp {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) {U V W : Open}
    (hUV : U ≤ V) (hVW : V ≤ W) (s : ↥(Eq res_in res_out W)) :
    balancedRestriction res_in res_out hUV
        (balancedRestriction res_in res_out hVW s) =
      balancedRestriction res_in res_out (le_trans hUV hVW) s := by
  apply Subtype.ext
  exact A.res_comp hUV hVW s.1

/-- The balanced equalizer sheaf model, constructed pointwise as Definition
14's equalizer.  At this layer it is represented by its underlying presheaf. -/
def balancedEqualizerSheaf {A B : QGaugePresheaf Open}
    (res_in res_out : Morphism A B) : QGaugePresheaf Open where
  Field U := ↥(Eq res_in res_out U)
  res := balancedRestriction res_in res_out
  res_id := balancedRestriction_id res_in res_out
  res_comp := balancedRestriction_comp res_in res_out

@[simp] theorem balancedEqualizerSheaf_field
    {A B : QGaugePresheaf Open} (res_in res_out : Morphism A B) (U : Open) :
    (balancedEqualizerSheaf res_in res_out).Field U =
      ↥(Eq res_in res_out U) :=
  rfl

@[simp] theorem balancedEqualizerSheaf_res_val
    {A B : QGaugePresheaf Open} (res_in res_out : Morphism A B)
    {U V : Open} (hUV : U ≤ V)
    (s : (balancedEqualizerSheaf res_in res_out).Field V) :
    ((balancedEqualizerSheaf res_in res_out).res hUV s).1 = A.res hUV s.1 :=
  rfl

/-- Integrated compatibility certificate for the legacy pair API followed by
Definitions 13–14, conditional on the displayed `Lq`, `Mmock`, and `D`.
`Mmock.actualBundle` supplies the proved q-series sheaf instance.  This
certificate does not identify the pair with Definition 12's tensor product;
that requires `Definition12Tensor.PairTensorEquivalenceData`.  It also does not
manufacture Proposition 14's nontrivial analytic connection:
`Proposition14.AnalyticInput` is that explicit boundary. -/
structure Definitions12To14Certificate
    (Lq : QLocalSystem Open) (Mmock : MockBundle Open)
    (D : QCovariantDerivative (qGaugeVariablesPresheaf Lq Mmock))
    {B : QGaugePresheaf Open}
    (res_in res_out : Morphism (qGaugeVariablesPresheaf Lq Mmock) B) : Prop where
  qGauge_restriction_localSystem :
    ∀ {U V : Open} (hUV : U ≤ V) (x : qGaugeVariables Lq Mmock V),
      (QGaugeVariable.restrict hUV x).localSystemPart =
        Lq.res hUV x.localSystemPart
  qGauge_restriction_mock :
    ∀ {U V : Open} (hUV : U ≤ V) (x : qGaugeVariables Lq Mmock V),
      (QGaugeVariable.restrict hUV x).mockPart = Mmock.res hUV x.mockPart
  qGauge_restriction_identity :
    ∀ (U : Open) (x : qGaugeVariables Lq Mmock U),
      QGaugeVariable.restrict (le_refl U) x = x
  qGauge_restriction_composition :
    ∀ {U V W : Open} (hUV : U ≤ V) (hVW : V ≤ W)
      (x : qGaugeVariables Lq Mmock W),
      QGaugeVariable.restrict hUV (QGaugeVariable.restrict hVW x) =
        QGaugeVariable.restrict (le_trans hUV hVW) x
  qCovariant_local_formula :
    ∀ (U : Open) (x : (qGaugeVariablesPresheaf Lq Mmock).Field U),
      D.Dq U x = D.combine U (D.radialPart U x) (D.potentialPart U x)
  qCovariant_restriction :
    ∀ {U V : Open} (hUV : U ≤ V)
      (x : (qGaugeVariablesPresheaf Lq Mmock).Field V),
      (qGaugeVariablesPresheaf Lq Mmock).res hUV (D.Dq V x) =
        D.Dq U ((qGaugeVariablesPresheaf Lq Mmock).res hUV x)
  balanced_membership_iff :
    ∀ (U : Open) (s : (qGaugeVariablesPresheaf Lq Mmock).Field U),
      s ∈ Eq res_in res_out U ↔ res_in.app U s = res_out.app U s
  balanced_restriction_stable :
    ∀ {U V : Open} (hUV : U ≤ V)
      (s : (qGaugeVariablesPresheaf Lq Mmock).Field V),
      s ∈ Eq res_in res_out V →
        (qGaugeVariablesPresheaf Lq Mmock).res hUV s ∈ Eq res_in res_out U

theorem definitions12To14_certificate
    (Lq : QLocalSystem Open) (Mmock : MockBundle Open)
    (D : QCovariantDerivative (qGaugeVariablesPresheaf Lq Mmock))
    {B : QGaugePresheaf Open}
    (res_in res_out : Morphism (qGaugeVariablesPresheaf Lq Mmock) B) :
    Definitions12To14Certificate Lq Mmock D res_in res_out := by
  exact
    { qGauge_restriction_localSystem :=
        QGaugeVariable.restrict_localSystemPart
      qGauge_restriction_mock := QGaugeVariable.restrict_mockPart
      qGauge_restriction_identity := QGaugeVariable.restrict_id
      qGauge_restriction_composition := QGaugeVariable.restrict_comp
      qCovariant_local_formula := D.local_formula
      qCovariant_restriction := D.restrict_Dq
      balanced_membership_iff := mem_Eq_iff res_in res_out
      balanced_restriction_stable := Eq_restrict_mem res_in res_out }

/-- The legacy pair/Definitions 13–14 certificate specialized to the proved
q-series `Mmock` sheaf. -/
theorem actualMmock_definitions12To14_certificate
    (Lq : QLocalSystem (TopologicalSpace.Opens Mmock.RadiusBase))
    (K : Mmock.KernelData)
    (D : QCovariantDerivative (actualQGaugeVariablesPresheaf Lq K))
    {B : QGaugePresheaf (TopologicalSpace.Opens Mmock.RadiusBase)}
    (res_in res_out : Morphism (actualQGaugeVariablesPresheaf Lq K) B) :
    Definitions12To14Certificate Lq (Mmock.actualBundle K) D
      res_in res_out :=
  definitions12To14_certificate Lq (Mmock.actualBundle K) D
    res_in res_out

/-- Abstract modular covariance data for q-gauge fields.  This structure stores
only the covariance predicate.  Lemma 6.1 is deliberately not a field. -/
structure ModularCovarianceData where
  Covariant : ∀ U : Open, Aq.Field U → Prop

/-- Restriction stability as a separate proposition.  Generic legacy APIs may
accept this proposition as an explicit hypothesis, while the geometric
Definition 15 layer proves it from equation (6.2). -/
abbrev ModularCovarianceRestrictionStable
    (MC : Aq.ModularCovarianceData) : Prop :=
  ∀ {U V : Open} (hUV : U ≤ V) {A : Aq.Field V},
    MC.Covariant V A → MC.Covariant U (Aq.res hUV A)

/-- The covariance proposition selected by `MC`. -/
def ModularCovariant (MC : Aq.ModularCovarianceData)
    (U : Open) (A : Aq.Field U) : Prop :=
  MC.Covariant U A

/-- Restriction transport for abstract q-gauge fields, parameterized by an
explicit proof rather than bundled into the covariance data. -/
theorem modularCovariance_restrict (MC : Aq.ModularCovarianceData)
    (hMC : Aq.ModularCovarianceRestrictionStable MC)
    {U V : Open} (hUV : U ≤ V) {A : Aq.Field V}
    (hA : ModularCovariant Aq MC V A) :
    ModularCovariant Aq MC U (Aq.res hUV A) :=
  hMC hUV hA

/-- Q-gauge fields satisfying a fixed modular covariance predicate form a
restriction-closed q-gauge subpresheaf. -/
def covariantQGaugePresheaf (MC : Aq.ModularCovarianceData)
    (hMC : Aq.ModularCovarianceRestrictionStable MC) :
    QGaugePresheaf Open where
  Field U := {A : Aq.Field U // MC.Covariant U A}
  res := fun hUV A =>
    ⟨Aq.res hUV A.1, hMC hUV A.2⟩
  res_id := by
    intro U A
    apply Subtype.ext
    exact Aq.res_id U A.1
  res_comp := by
    intro U V W hUV hVW A
    apply Subtype.ext
    exact Aq.res_comp hUV hVW A.1

@[simp] theorem covariantQGaugePresheaf_res_val
    (MC : Aq.ModularCovarianceData)
    (hMC : Aq.ModularCovarianceRestrictionStable MC)
    {U V : Open} (hUV : U ≤ V)
    (A : (covariantQGaugePresheaf Aq MC hMC).Field V) :
    ((covariantQGaugePresheaf Aq MC hMC).res hUV A).1 = Aq.res hUV A.1 :=
  rfl

/-- PR-facing certificate for Lemma 6.1 in the generic q-gauge interface. -/
structure Lemma61QGaugeCertificate (MC : Aq.ModularCovarianceData)
    (hMC : Aq.ModularCovarianceRestrictionStable MC) : Prop where
  predicate_restriction_stable :
    ∀ {U V : Open} (hUV : U ≤ V) {A : Aq.Field V},
      ModularCovariant Aq MC V A →
        ModularCovariant Aq MC U (Aq.res hUV A)
  covariant_subpresheaf_res_val :
    ∀ {U V : Open} (hUV : U ≤ V)
      (A : (covariantQGaugePresheaf Aq MC hMC).Field V),
      ((covariantQGaugePresheaf Aq MC hMC).res hUV A).1 = Aq.res hUV A.1

theorem lemma6_1_qGauge_certificate (MC : Aq.ModularCovarianceData)
    (hMC : Aq.ModularCovarianceRestrictionStable MC) :
    Lemma61QGaugeCertificate Aq MC hMC := by
  exact
    { predicate_restriction_stable := fun {U V} hUV {A} hA =>
        hMC hUV hA
      covariant_subpresheaf_res_val :=
        covariantQGaugePresheaf_res_val Aq MC hMC }

/-- Equalizer of two restrictions to an overlap. -/
structure BalancedPair (U V W : Open) (hWU : W ≤ U) (hWV : W ≤ V) where
  left : Aq.Field U
  right : Aq.Field V
  compatible : Aq.res hWU left = Aq.res hWV right

/-- Global q-gauge fields in the two-chart model are balanced pairs. -/
def GlobalQGaugeFields (U V W : Open) (hWU : W ≤ U) (hWV : W ≤ V) :=
  Aq.BalancedPair U V W hWU hWV

theorem global_qGaugeFields_equalizer (U V W : Open) (hWU : W ≤ U) (hWV : W ≤ V) :
    Aq.GlobalQGaugeFields U V W hWU hWV = Aq.BalancedPair U V W hWU hWV := rfl

section TopologicalSheaf

variable {X : Type u} [TopologicalSpace X]
variable (AqTop : QGaugePresheaf (TopologicalSpace.Opens X))

/-- Forget the q-gauge name and expose a topological q-gauge presheaf through
the abstract Proposition 20 interface. -/
def toPresheafLike : PresheafLike X where
  Section := AqTop.Field
  res := AqTop.res
  res_id := AqTop.res_id
  res_comp := AqTop.res_comp

/-- A separately proved q-gauge restriction theorem induces the general
restriction-stable covariance interface. -/
def modularCovarianceRestrictionStable
    (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC) :
    IsRestrictionStableCovariance (toPresheafLike AqTop) MC.Covariant where
  restrict_stable := hMC

/-- Restriction for topological q-gauge fields, routed through an explicitly
supplied proof of stability.  The exact Definition 15 specialization constructs
that proof by calculation. -/
theorem modularCovariance_restrict_abstract
    (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    {A : AqTop.Field V} (hA : MC.Covariant V A) :
    MC.Covariant U (AqTop.res hUV A) :=
  lemma6_1_covariance_restrict (toPresheafLike AqTop) MC.Covariant
    (modularCovarianceRestrictionStable AqTop MC hMC) hUV hA

/-- The general Lemma 6.1 certificate instantiated by a separately proved
q-gauge covariance restriction theorem. -/
theorem lemma6_1_topological_qGauge_certificate
    (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC) :
    Lemma61CovarianceCertificate (toPresheafLike AqTop) MC.Covariant
      (modularCovarianceRestrictionStable AqTop MC hMC) :=
  lemma6_1_covariance_certificate (toPresheafLike AqTop) MC.Covariant
    (modularCovarianceRestrictionStable AqTop MC hMC)

/-- The actual locality, gluing-existence, and gluing-uniqueness obligations for
a topological q-gauge presheaf. -/
abbrev SheafProperty := IsSheafLike (toPresheafLike AqTop)

/-- Locality of the selected modular covariance predicate. -/
abbrev IsLocalModularCovariance (MC : AqTop.ModularCovarianceData) :=
  IsLocalCovariance (toPresheafLike AqTop) MC.Covariant

/-- The topological q-gauge presheaf whose sections satisfy `MC.Covariant`. -/
noncomputable def modularCovariantAqPresheaf (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC) :
    PresheafLike X :=
  AqPresheaf (toPresheafLike AqTop) MC.Covariant
    (modularCovarianceRestrictionStable AqTop MC hMC)

/-- Proposition 16 specialized to topological q-gauge fields. -/
theorem prop16_qGauge_Aq_is_sheaf
    (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC)
    (hForms : SheafProperty AqTop)
    (hLocal : IsLocalModularCovariance AqTop MC) :
    IsSheafLike (modularCovariantAqPresheaf AqTop MC hMC) :=
  prop16_Aq_is_sheaf (toPresheafLike AqTop) MC.Covariant
    (modularCovarianceRestrictionStable AqTop MC hMC) hForms hLocal

/-- The full Proposition 16 certificate in q-gauge notation. -/
theorem prop16_qGauge_Aq_certificate
    (MC : AqTop.ModularCovarianceData)
    (hMC : AqTop.ModularCovarianceRestrictionStable MC)
    (hForms : SheafProperty AqTop)
    (hLocal : IsLocalModularCovariance AqTop MC) :
    Prop16AqSheafCertificate (toPresheafLike AqTop) MC.Covariant
      (modularCovarianceRestrictionStable AqTop MC hMC) :=
  prop16_Aq_sheaf_certificate (toPresheafLike AqTop) MC.Covariant
    (modularCovarianceRestrictionStable AqTop MC hMC) hForms hLocal

theorem sheaf_property_components (hAq : SheafProperty AqTop) :
    IsSheafLike (toPresheafLike AqTop) :=
  hAq

theorem sheaf_property_locality (hAq : SheafProperty AqTop)
    {ι : Type u} (C : OpenCoverData X ι)
    {x y : AqTop.Field C.target}
    (hxy : ∀ i : ι,
      AqTop.res (C.piece_le_target i) x =
        AqTop.res (C.piece_le_target i) y) :
    x = y :=
  hAq.locality C hxy

theorem sheaf_property_gluing_exists (hAq : SheafProperty AqTop)
    {ι : Type u} (C : OpenCoverData X ι)
    (s : (toPresheafLike AqTop).CoverSectionProduct C)
    (hs : (toPresheafLike AqTop).CompatibleFamily C s) :
    ∃ x : AqTop.Field C.target,
      (toPresheafLike AqTop).IsGluing C s x :=
  hAq.gluing_exists C s hs

theorem sheaf_property_gluing_unique (hAq : SheafProperty AqTop)
    {ι : Type u} (C : OpenCoverData X ι)
    (s : (toPresheafLike AqTop).CoverSectionProduct C)
    (hs : (toPresheafLike AqTop).CompatibleFamily C s)
    {x y : AqTop.Field C.target}
    (hx : (toPresheafLike AqTop).IsGluing C s x)
    (hy : (toPresheafLike AqTop).IsGluing C s y) :
    x = y :=
  hAq.gluing_unique C s hs hx hy

/-- Proposition 20 specialized to topological q-gauge fields. -/
noncomputable def proposition20GlobalQGaugeEquivEqualizer
    (hAq : SheafProperty AqTop) {ι : Type u} (C : OpenCoverData X ι) :
    AqTop.Field C.target ≃
      (toPresheafLike AqTop).CoverEqualizer C :=
  proposition20GlobalSectionsEquivEqualizer (toPresheafLike AqTop) hAq C

theorem proposition20_qGauge_certificate
    (hAq : SheafProperty AqTop) {ι : Type u} (C : OpenCoverData X ι) :
    Proposition20EqualizerCertificate (toPresheafLike AqTop) C :=
  proposition20_equalizer_certificate (toPresheafLike AqTop) hAq C

/-- The computational equivalence underlying the paper-level Proposition 20
statement for a cover of the whole q-gauge base space. -/
noncomputable def prop20GlobalQGaugeEqualizerEquiv
    (hAq : SheafProperty AqTop) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i) :
    AqTop.Field (⊤ : TopologicalSpace.Opens X) ≃
      (toPresheafLike AqTop).GlobalSectionEqualizer U hcover :=
  global_sections_equiv_equalizer (toPresheafLike AqTop) hAq U hcover

/-- Paper-level Proposition 20: global q-gauge fields are the equalizer of the
two local restriction maps. -/
theorem prop20_global_qGauge_equalizer
    (hAq : SheafProperty AqTop) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i) :
    Nonempty
      (AqTop.Field (⊤ : TopologicalSpace.Opens X) ≃
        (toPresheafLike AqTop).GlobalSectionEqualizer U hcover) :=
  ⟨prop20GlobalQGaugeEqualizerEquiv AqTop hAq U hcover⟩

/-- Paper-level iff form of the equalizer condition on all intersections
`Uᵢ ∩ Uⱼ`. -/
theorem prop20_global_qGauge_equalizer_iff
    {ι : Type u} (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i)
    (s : (toPresheafLike AqTop).GlobalCoverSectionProduct U hcover) :
    s ∈ (toPresheafLike AqTop).GlobalSectionEqualizerSet U hcover ↔
      ∀ i j : ι,
        AqTop.res ((OpenCoverData.wholeSpace U hcover).overlap_le_left i j)
            (s i) =
          AqTop.res ((OpenCoverData.wholeSpace U hcover).overlap_le_right i j)
            (s j) := by
  exact (toPresheafLike AqTop).global_family_mem_equalizer_iff_pairwise_overlap
    U hcover s

/-- Two global q-gauge sections with the same compatible local restrictions
are equal. -/
theorem prop20_global_qGauge_gluing_unique
    (hAq : SheafProperty AqTop) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i)
    (s : (toPresheafLike AqTop).GlobalCoverSectionProduct U hcover)
    (hs : (toPresheafLike AqTop).CompatibleFamily
      (OpenCoverData.wholeSpace U hcover) s)
    {x y : AqTop.Field (⊤ : TopologicalSpace.Opens X)}
    (hx : (toPresheafLike AqTop).IsGluing
      (OpenCoverData.wholeSpace U hcover) s x)
    (hy : (toPresheafLike AqTop).IsGluing
      (OpenCoverData.wholeSpace U hcover) s y) :
    x = y :=
  hAq.global_gluing_unique U hcover s hs hx hy

/-- Compatible local q-gauge data glue to exactly one global q-gauge field. -/
theorem prop20_global_qGauge_existsUnique_gluing
    (hAq : SheafProperty AqTop) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i)
    (s : (toPresheafLike AqTop).GlobalCoverSectionProduct U hcover)
    (hs : (toPresheafLike AqTop).CompatibleFamily
      (OpenCoverData.wholeSpace U hcover) s) :
    ∃! x : AqTop.Field (⊤ : TopologicalSpace.Opens X),
      (toPresheafLike AqTop).IsGluing
        (OpenCoverData.wholeSpace U hcover) s x :=
  hAq.global_existsUnique_gluing U hcover s hs

/-- Whole-space specialization of the Proposition 20 audit certificate. -/
theorem prop20_global_qGauge_certificate
    (hAq : SheafProperty AqTop) {ι : Type u}
    (U : ι → TopologicalSpace.Opens X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i) :
    Proposition20EqualizerCertificate (toPresheafLike AqTop)
      (OpenCoverData.wholeSpace U hcover) :=
  proposition20_qGauge_certificate AqTop hAq
    (OpenCoverData.wholeSpace U hcover)

/-!
### Legacy modular-covariance boundary

`ModularCovarianceData` now stores only an abstract covariance predicate.
Generic q-gauge constructions accept `ModularCovarianceRestrictionStable` as
a separate proof, so Lemma 6.1 is no longer silently bundled as input data.
The exact `Definition15Geometry` layer below defines `Γ(2) \ ℍ`, smooth
forms, deck pullback, and equation (6.2), then constructs this proof from the
pullback/restriction calculation.  Proposition 16 still requires the separate
locality and ambient-sheaf hypotheses appropriate to its own statement.
-/

end TopologicalSheaf

/-- Legacy q-connection interface: a section endomorphism commuting with
restriction.  Path transport and one-form data are deliberately supplied by
`Proposition14.AnalyticInput`, because this structure cannot express them. -/
structure QConnection where
  D : ∀ U : Open, Aq.Field U → Aq.Field U
  restrict_D :
    ∀ {U V : Open} (hUV : U ≤ V) (x : Aq.Field V),
      Aq.res hUV (D V x) = D U (Aq.res hUV x)

/-- Forget the local-formula decomposition and retain the existing connection
interface used by the curvature layer. -/
def QCovariantDerivative.toQConnection (Dq : Aq.QCovariantDerivative) :
    Aq.QConnection where
  D := Dq.Dq
  restrict_D := Dq.restrict_Dq

@[simp] theorem QCovariantDerivative.toQConnection_apply
    (Dq : Aq.QCovariantDerivative) (U : Open) (x : Aq.Field U) :
    (QCovariantDerivative.toQConnection Aq Dq).D U x = Dq.Dq U x :=
  rfl

/-- Curvature is the second covariant derivative in this elementary model. -/
def QCurvature (nabla : Aq.QConnection) (U : Open) (x : Aq.Field U) : Aq.Field U :=
  nabla.D U (nabla.D U x)

theorem curvature_restrict (nabla : Aq.QConnection) {U V : Open} (hUV : U ≤ V)
    (x : Aq.Field V) :
    Aq.res hUV (Aq.QCurvature nabla V x) =
      Aq.QCurvature nabla U (Aq.res hUV x) := by
  calc
    Aq.res hUV (nabla.D V (nabla.D V x))
        = nabla.D U (Aq.res hUV (nabla.D V x)) :=
          nabla.restrict_D hUV (nabla.D V x)
    _ = nabla.D U (nabla.D U (Aq.res hUV x)) := by
      rw [nabla.restrict_D hUV x]

/-- A gauge transformation compatible with restriction. -/
structure GaugeTransform where
  act : ∀ U : Open, Aq.Field U → Aq.Field U
  restrict_act :
    ∀ {U V : Open} (hUV : U ≤ V) (x : Aq.Field V),
      Aq.res hUV (act V x) = act U (Aq.res hUV x)

def GaugeCovariant (nabla : Aq.QConnection) (g : Aq.GaugeTransform) : Prop :=
  ∀ (U : Open) (x : Aq.Field U),
    nabla.D U (g.act U x) = g.act U (nabla.D U x)

theorem gauge_covariance_formula {nabla : Aq.QConnection} {g : Aq.GaugeTransform}
    (hg : Aq.GaugeCovariant nabla g) (U : Open) (x : Aq.Field U) :
    nabla.D U (g.act U x) = g.act U (nabla.D U x) := hg U x

/-- Legacy fixed-point sector for the elementary second-derivative model.
This predicate is `QCurvature x = x`, not Definition 18's zero-curvature
sector.  The paper-faithful subtype is `Mock2.FlatSector` in §F.1.5. -/
def FlatSector (nabla : Aq.QConnection) (U : Open) (x : Aq.Field U) : Prop :=
  Aq.QCurvature nabla U x = x

/-- Legacy assumption-packaging for the fixed-point sector above.  Its
vanishing fields assume the conclusion directly and are not the order-theoretic
proof of Proposition 19; use `Proposition19Hypotheses` and
`proposition19_M_and_R_vanish` for that result. -/
structure EffectiveMassFunctional (nabla : Aq.QConnection) where
  mass : ∀ U : Open, Aq.Field U → ℕ
  potential : ∀ U : Open, Aq.Field U → ℕ
  mass_vanishes_on_flat :
    ∀ {U : Open} {x : Aq.Field U}, Aq.FlatSector nabla U x → mass U x = 0
  potential_vanishes_on_flat :
    ∀ {U : Open} {x : Aq.Field U}, Aq.FlatSector nabla U x → potential U x = 0

theorem flat_sector_mass_vanishes {nabla : Aq.QConnection}
    (E : Aq.EffectiveMassFunctional nabla) {U : Open} {x : Aq.Field U}
    (hflat : Aq.FlatSector nabla U x) :
    E.mass U x = 0 := E.mass_vanishes_on_flat hflat

theorem flat_sector_potential_vanishes {nabla : Aq.QConnection}
    (E : Aq.EffectiveMassFunctional nabla) {U : Open} {x : Aq.Field U}
    (hflat : Aq.FlatSector nabla U x) :
    E.potential U x = 0 := E.potential_vanishes_on_flat hflat

end QGaugePresheaf

/-!
## §F.2.2.6 — Definition 14: actual boundary and equalizer sheaves

This section replaces the earlier abstract boundary morphisms by concrete
inside/outside traces on a fixed certified common annulus.  It also proves the
sheaf property of pointwise equalizers and connects the lightweight subtype
construction to Mathlib's categorical equalizer of `Type`-valued sheaves.
-/

namespace QGaugePresheaf

section EqualizerSheaf

variable {X : Type u} [TopologicalSpace X]
variable {A B : QGaugePresheaf (TopologicalSpace.Opens X)}

/-- Pointwise equalizers of set-valued sheaves are sheaves.  Gluing is first
performed in the ambient sheaf; locality in the boundary sheaf proves that the
glued section still equalizes the two natural transformations. -/
theorem balancedEqualizer_isSheaf
    (resIn resOut : Morphism A B)
    (hA : IsSheafLike (toPresheafLike A))
    (hB : IsSheafLike (toPresheafLike B)) :
    IsSheafLike (toPresheafLike (balancedEqualizerSheaf resIn resOut)) := by
  refine
    { locality := ?_
      gluing_exists := ?_
      gluing_unique := ?_ }
  · intro ι C x y hxy
    apply Subtype.ext
    apply hA.locality C
    intro i
    exact congrArg Subtype.val (hxy i)
  · intro ι C s hs
    let ambientFamily : (toPresheafLike A).CoverSectionProduct C :=
      fun i => (s i).1
    have ambientCompatible :
        (toPresheafLike A).CompatibleFamily C ambientFamily := by
      intro i j
      exact congrArg Subtype.val (hs i j)
    obtain ⟨x, hx⟩ :=
      hA.gluing_exists C ambientFamily ambientCompatible
    have hxBalanced : x ∈ Eq resIn resOut C.target := by
      change resIn.app C.target x = resOut.app C.target x
      apply hB.locality C
      intro i
      calc
        B.res (C.piece_le_target i) (resIn.app C.target x) =
            resIn.app (C.piece i)
              (A.res (C.piece_le_target i) x) :=
          resIn.naturality (C.piece_le_target i) x
        _ = resIn.app (C.piece i) (s i).1 :=
          congrArg (resIn.app (C.piece i)) (hx i)
        _ = resOut.app (C.piece i) (s i).1 := (s i).2
        _ = resOut.app (C.piece i)
              (A.res (C.piece_le_target i) x) :=
          congrArg (resOut.app (C.piece i)) (hx i).symm
        _ = B.res (C.piece_le_target i) (resOut.app C.target x) :=
          (resOut.naturality (C.piece_le_target i) x).symm
    refine ⟨⟨x, hxBalanced⟩, ?_⟩
    intro i
    apply Subtype.ext
    exact hx i
  · intro ι C s hs x y hx hy
    apply Subtype.ext
    let ambientFamily : (toPresheafLike A).CoverSectionProduct C :=
      fun i => (s i).1
    have ambientCompatible :
        (toPresheafLike A).CompatibleFamily C ambientFamily := by
      intro i j
      exact congrArg Subtype.val (hs i j)
    apply hA.gluing_unique C ambientFamily ambientCompatible
    · intro i
      exact congrArg Subtype.val (hx i)
    · intro i
      exact congrArg Subtype.val (hy i)

end EqualizerSheaf

end QGaugePresheaf

namespace Definition14Boundary

noncomputable section

open Mmock

abbrev RadiusBase := Definition11.RadiusBase
abbrev Opens := TopologicalSpace.Opens RadiusBase

/-- Certified mock germs whose common annulus is the fixed annulus `A`. -/
abbrev FixedAnnulusGerm (K : KernelData) (A : CommonAnnulus) :=
  {g : CertifiedGerm K // g.annulus = A}

/-- Points on the fixed common annulus. -/
abbrev BoundaryPoint (A : CommonAnnulus) :=
  {q : ℂ // q ∈ A.carrier}

/-- A boundary section stores both inside and outside complex traces on the
same certified annulus. -/
structure BoundaryDatum (A : CommonAnnulus) where
  inside : BoundaryPoint A → ℂ
  outside : BoundaryPoint A → ℂ

namespace BoundaryDatum

@[ext] theorem ext {A : CommonAnnulus} {x y : BoundaryDatum A}
    (hInside : x.inside = y.inside)
    (hOutside : x.outside = y.outside) : x = y := by
  cases x
  cases y
  cases hInside
  cases hOutside
  rfl

end BoundaryDatum

/-- The actual local q-gauge datum used by Definition 14: a corrected `Lq`
solution together with a certified mock germ on the fixed annulus. -/
structure GaugeDatum {V : Type v}
    [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]
    (D : Definition11.AnalyticData V) (K : KernelData)
    (A : CommonAnnulus) where
  localSystemPart : D.solutionSpace
  mockPart : FixedAnnulusGerm K A

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]
variable (D : Definition11.AnalyticData V) (K : KernelData)
variable (A : CommonAnnulus)

/-- The inside boundary map duplicates the inside value into the two boundary
slots. -/
def insideBoundaryDatum (x : GaugeDatum D K A) : BoundaryDatum A where
  inside q := x.mockPart.1.series.inside.sumAt q.1
  outside q := x.mockPart.1.series.inside.sumAt q.1

/-- The outside boundary map records both sides of the certified formula:
`2*psi(q)-S(q)` and the actual outside value `G(q⁻¹)`. -/
def outsideBoundaryDatum (x : GaugeDatum D K A) : BoundaryDatum A where
  inside q :=
    (2 : ℂ) * K.psi.sumAt q.1 -
      x.mockPart.1.series.correction.sumAt q.1
  outside q := x.mockPart.1.series.outside.sumAt q.1⁻¹

@[simp] theorem insideBoundaryDatum_inside_apply
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    (insideBoundaryDatum D K A x).inside q =
      x.mockPart.1.series.inside.sumAt q.1 :=
  rfl

@[simp] theorem insideBoundaryDatum_outside_apply
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    (insideBoundaryDatum D K A x).outside q =
      x.mockPart.1.series.inside.sumAt q.1 :=
  rfl

@[simp] theorem outsideBoundaryDatum_inside_apply
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    (outsideBoundaryDatum D K A x).inside q =
      (2 : ℂ) * K.psi.sumAt q.1 -
        x.mockPart.1.series.correction.sumAt q.1 :=
  rfl

@[simp] theorem outsideBoundaryDatum_outside_apply
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    (outsideBoundaryDatum D K A x).outside q =
      x.mockPart.1.series.outside.sumAt q.1⁻¹ :=
  rfl

/-- Membership in the fixed annulus transfers to the germ's certified
annulus. -/
theorem boundaryPoint_mem_germAnnulus
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    q.1 ∈ x.mockPart.1.annulus.carrier := by
  rw [x.mockPart.2]
  exact q.2

/-- The actual outside trace equals the completion-predicted trace. -/
theorem outside_eq_predicted
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    x.mockPart.1.series.outside.sumAt q.1⁻¹ =
      (2 : ℂ) * K.psi.sumAt q.1 -
        x.mockPart.1.series.correction.sumAt q.1 :=
  x.mockPart.1.matching_identity
    (boundaryPoint_mem_germAnnulus D K A x q)

/-- The two components stored by the outside boundary datum agree by the
certified matching identity. -/
theorem outsideBoundaryDatum_components_eq
    (x : GaugeDatum D K A) (q : BoundaryPoint A) :
    (outsideBoundaryDatum D K A x).inside q =
      (outsideBoundaryDatum D K A x).outside q :=
  (outside_eq_predicted D K A x q).symm

/-- Global compatibility means that the inside and actual outside
descriptions are values of one completed object on the common annulus. -/
def GloballyCompatible (x : GaugeDatum D K A) : Prop :=
  ∀ q : BoundaryPoint A,
    x.mockPart.1.series.inside.sumAt q.1 =
      x.mockPart.1.series.outside.sumAt q.1⁻¹

/-- Fibrewise equalizer membership is exactly global mock-completion
compatibility. -/
theorem insideBoundary_eq_outsideBoundary_iff
    (x : GaugeDatum D K A) :
    insideBoundaryDatum D K A x = outsideBoundaryDatum D K A x ↔
      GloballyCompatible D K A x := by
  constructor
  · intro h q
    exact congrArg (fun b : BoundaryDatum A => b.outside q) h
  · intro h
    apply BoundaryDatum.ext
    · funext q
      exact (h q).trans (outside_eq_predicted D K A x q)
    · funext q
      exact h q

/-- The locally constant q-gauge presheaf with a fixed fibre `F`. -/
def locallyConstantQGaugePresheaf (F : Type v) : QGaugePresheaf Opens where
  Field U := LocallyConstant U F
  res hUV s := LocallyConstant.comap
    (LocallyConstantValueSheaf.openInclusion hUV) s
  res_id := by
    intro U s
    apply LocallyConstant.ext
    intro x
    rfl
  res_comp := by
    intro U W Z hUW hWZ s
    apply LocallyConstant.ext
    intro x
    rfl

@[simp] theorem locallyConstantQGaugePresheaf_res_apply
    (F : Type v) {U W : Opens} (hUW : U ≤ W)
    (s : (locallyConstantQGaugePresheaf F).Field W) (x : U) :
    ((locallyConstantQGaugePresheaf F).res hUW s).toFun x =
      s.toFun ⟨x.1, hUW x.2⟩ :=
  rfl

theorem locallyConstantQGaugePresheaf_isSheaf (F : Type v) :
    IsSheafLike
      (QGaugePresheaf.toPresheafLike
        (locallyConstantQGaugePresheaf F)) :=
  LocallyConstantValueSheaf.isSheaf

/-- Definition 14's actual ambient q-gauge sheaf. -/
def Aq : QGaugePresheaf Opens :=
  locallyConstantQGaugePresheaf (GaugeDatum D K A)

/-- Definition 14's actual boundary sheaf `Bq`. -/
def Bq : QGaugePresheaf Opens :=
  locallyConstantQGaugePresheaf (BoundaryDatum A)

@[simp] theorem Aq_field (U : Opens) :
    (Aq D K A).Field U = LocallyConstant U (GaugeDatum D K A) :=
  rfl

@[simp] theorem Bq_field (U : Opens) :
    (Bq A).Field U = LocallyConstant U (BoundaryDatum A) :=
  rfl

theorem Aq_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike (Aq D K A)) :=
  locallyConstantQGaugePresheaf_isSheaf (GaugeDatum D K A)

theorem Bq_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike (Bq A)) :=
  locallyConstantQGaugePresheaf_isSheaf (BoundaryDatum A)

/-- Pointwise postcomposition of locally constant sections. -/
def mapSection {F : Type v} {G : Type w} (f : F → G) (U : Opens) :
    LocallyConstant U F → LocallyConstant U G :=
  LocallyConstant.map f

@[simp] theorem mapSection_apply {F : Type v} {G : Type w} (f : F → G)
    (U : Opens) (s : LocallyConstant U F) (x : U) :
    mapSection f U s x = f (s x) :=
  rfl

/-- A fibre map induces a natural morphism of locally constant sheaves. -/
def mapMorphism {F : Type v} {G : Type w} (f : F → G) :
    QGaugePresheaf.Morphism
      (locallyConstantQGaugePresheaf F)
      (locallyConstantQGaugePresheaf G) where
  app U := mapSection f U
  naturality := by
    intro U W hUW s
    apply LocallyConstant.ext
    intro x
    rfl

/-- The actual inside boundary natural transformation. -/
def resIn : QGaugePresheaf.Morphism (Aq D K A) (Bq A) :=
  mapMorphism (insideBoundaryDatum D K A)

/-- The actual outside boundary natural transformation using
`G(q⁻¹)=2*psi(q)-S(q)`. -/
def resOut : QGaugePresheaf.Morphism (Aq D K A) (Bq A) :=
  mapMorphism (outsideBoundaryDatum D K A)


/-- Universe-lifted boundary sheaf used only by the Mathlib categorical bridge. -/
def liftedBq : QGaugePresheaf.{0, v} Opens :=
  locallyConstantQGaugePresheaf (ULift.{v} (BoundaryDatum A))

theorem liftedBq_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike (liftedBq.{v} A)) :=
  locallyConstantQGaugePresheaf_isSheaf (ULift.{v} (BoundaryDatum A))

def liftedResIn :
    QGaugePresheaf.Morphism (Aq D K A) (liftedBq.{v} A) :=
  mapMorphism (fun x =>
    (ULift.up (insideBoundaryDatum D K A x) : ULift.{v} (BoundaryDatum A)))

def liftedResOut :
    QGaugePresheaf.Morphism (Aq D K A) (liftedBq.{v} A) :=
  mapMorphism (fun x =>
    (ULift.up (outsideBoundaryDatum D K A x) : ULift.{v} (BoundaryDatum A)))

@[simp] theorem resIn_apply (U : Opens) (s : (Aq D K A).Field U)
    (x : U) :
    ((resIn D K A).app U s).toFun x =
      insideBoundaryDatum D K A (s.toFun x) :=
  rfl

@[simp] theorem resOut_apply (U : Opens) (s : (Aq D K A).Field U)
    (x : U) :
    ((resOut D K A).app U s).toFun x =
      outsideBoundaryDatum D K A (s.toFun x) :=
  rfl

@[simp] theorem resIn_inside_apply
    (U : Opens) (s : (Aq D K A).Field U) (x : U)
    (q : BoundaryPoint A) :
    (((resIn D K A).app U s).toFun x).inside q =
      (s.toFun x).mockPart.1.series.inside.sumAt q.1 :=
  rfl

@[simp] theorem resIn_outside_apply
    (U : Opens) (s : (Aq D K A).Field U) (x : U)
    (q : BoundaryPoint A) :
    (((resIn D K A).app U s).toFun x).outside q =
      (s.toFun x).mockPart.1.series.inside.sumAt q.1 :=
  rfl

@[simp] theorem resOut_inside_apply
    (U : Opens) (s : (Aq D K A).Field U) (x : U)
    (q : BoundaryPoint A) :
    (((resOut D K A).app U s).toFun x).inside q =
      (2 : ℂ) * K.psi.sumAt q.1 -
        (s.toFun x).mockPart.1.series.correction.sumAt q.1 :=
  rfl

@[simp] theorem resOut_outside_apply
    (U : Opens) (s : (Aq D K A).Field U) (x : U)
    (q : BoundaryPoint A) :
    (((resOut D K A).app U s).toFun x).outside q =
      (s.toFun x).mockPart.1.series.outside.sumAt q.1⁻¹ :=
  rfl

/-- The actual `resOut` section carries equal predicted and actual outside
traces at every annulus point. -/
theorem resOut_components_eq
    (U : Opens) (s : (Aq D K A).Field U) (x : U)
    (q : BoundaryPoint A) :
    (((resOut D K A).app U s).toFun x).inside q =
      (((resOut D K A).app U s).toFun x).outside q :=
  outsideBoundaryDatum_components_eq D K A (s.toFun x) q

theorem resIn_naturality {U W : Opens} (hUW : U ≤ W)
    (s : (Aq D K A).Field W) :
    (Bq A).res hUW ((resIn D K A).app W s) =
      (resIn D K A).app U ((Aq D K A).res hUW s) :=
  (resIn D K A).naturality hUW s

theorem resOut_naturality {U W : Opens} (hUW : U ≤ W)
    (s : (Aq D K A).Field W) :
    (Bq A).res hUW ((resOut D K A).app W s) =
      (resOut D K A).app U ((Aq D K A).res hUW s) :=
  (resOut D K A).naturality hUW s

/-- Definition 14's pointwise balanced equalizer presheaf. -/
def EqSheaf : QGaugePresheaf Opens :=
  QGaugePresheaf.balancedEqualizerSheaf (resIn D K A) (resOut D K A)

@[simp] theorem EqSheaf_field (U : Opens) :
    (EqSheaf D K A).Field U =
      {s : (Aq D K A).Field U //
        (resIn D K A).app U s = (resOut D K A).app U s} :=
  rfl

/-- The actual balanced equalizer is a sheaf. -/
theorem EqSheaf_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike (EqSheaf D K A)) :=
  QGaugePresheaf.balancedEqualizer_isSheaf
    (resIn D K A) (resOut D K A) (Aq_isSheaf D K A) (Bq_isSheaf A)

/-- Sectionwise global completion compatibility. -/
def SectionGloballyCompatible {U : Opens} (s : (Aq D K A).Field U) : Prop :=
  ∀ x : U, GloballyCompatible D K A (s.toFun x)

/-- Global mock-completion compatibility is stable under restriction to a
smaller radius open. -/
theorem SectionGloballyCompatible.restrict
    {U W : Opens} (hUW : U ≤ W) (s : (Aq D K A).Field W)
    (hs : SectionGloballyCompatible D K A s) :
    SectionGloballyCompatible D K A ((Aq D K A).res hUW s) := by
  intro x
  exact hs ⟨x.1, hUW x.2⟩

/-- Balanced membership is exactly mock-completion compatibility at every
radius in the open set. -/
theorem mem_EqSheaf_iff_globalCompatible
    (U : Opens) (s : (Aq D K A).Field U) :
    s ∈ QGaugePresheaf.Eq (resIn D K A) (resOut D K A) U ↔
      SectionGloballyCompatible D K A s := by
  constructor
  · intro hs x
    apply (insideBoundary_eq_outsideBoundary_iff D K A (s.toFun x)).mp
    exact congrArg (fun t : (Bq A).Field U => t.toFun x) hs
  · intro hs
    apply LocallyConstant.ext
    intro x
    exact (insideBoundary_eq_outsideBoundary_iff D K A (s.toFun x)).mpr (hs x)

/-!
### Mathlib sheaf-category realization

The lightweight presheaf API above is convenient for explicit sectionwise
proofs.  The following bridge turns it into Mathlib's genuine category of
`Type`-valued sheaves.  We then prove the subtype equalizer's universal
property directly, rather than merely comparing its section types.
-/

namespace MathlibBridge

open CategoryTheory CategoryTheory.Limits Opposite

section Generic

variable {X : Type u} [TopologicalSpace X]

/-- A lightweight q-gauge presheaf as a genuine Mathlib presheaf of types. -/
def toMathlibPresheaf
    (P : QGaugePresheaf (TopologicalSpace.Opens X)) :
    TopCat.Presheaf (Type v) (TopCat.of X) where
  obj U := P.Field U.unop
  map f := TypeCat.ofHom (P.res f.unop.le)
  map_id U := by
    apply ConcreteCategory.ext_apply
    intro s
    exact P.res_id U.unop s
  map_comp f g := by
    apply ConcreteCategory.ext_apply
    intro s
    exact (P.res_comp g.unop.le f.unop.le s).symm

@[simp] theorem toMathlibPresheaf_obj
    (P : QGaugePresheaf (TopologicalSpace.Opens X))
    (U : (TopologicalSpace.Opens X)ᵒᵖ) :
    (toMathlibPresheaf P).obj U = P.Field U.unop :=
  rfl

@[simp] theorem toMathlibPresheaf_map_apply
    (P : QGaugePresheaf (TopologicalSpace.Opens X))
    {U W : (TopologicalSpace.Opens X)ᵒᵖ} (f : U ⟶ W)
    (s : P.Field U.unop) :
    (toMathlibPresheaf P).map f s = P.res f.unop.le s :=
  rfl

/-- A lightweight natural morphism as a Mathlib natural transformation. -/
def toMathlibNatTrans
    {P Q : QGaugePresheaf (TopologicalSpace.Opens X)}
    (φ : QGaugePresheaf.Morphism P Q) :
    toMathlibPresheaf P ⟶ toMathlibPresheaf Q where
  app U := TypeCat.ofHom (φ.app U.unop)
  naturality := by
    intro U W f
    apply ConcreteCategory.ext_apply
    intro s
    exact (φ.naturality f.unop.le s).symm

@[simp] theorem toMathlibNatTrans_app
    {P Q : QGaugePresheaf (TopologicalSpace.Opens X)}
    (φ : QGaugePresheaf.Morphism P Q)
    (U : (TopologicalSpace.Opens X)ᵒᵖ) (s : P.Field U.unop) :
    (toMathlibNatTrans φ).app U s = φ.app U.unop s :=
  rfl

/-- The explicit `IsSheafLike` cover axiom implies Mathlib's Grothendieck
topology sheaf condition for the associated type-valued presheaf. -/
theorem toMathlibPresheaf_isSheaf
    (P : QGaugePresheaf (TopologicalSpace.Opens X))
    (hP : IsSheafLike (QGaugePresheaf.toPresheafLike P)) :
    (toMathlibPresheaf P).IsSheaf := by
  apply TopCat.Presheaf.isSheaf_of_isSheafUniqueGluing_types _
  intro ι U sf hsf
  let C : OpenCoverData X ι :=
    { target := iSup U
      piece := U
      piece_le_target := fun i => le_iSup U i
      covers := by
        intro x hx
        exact TopologicalSpace.Opens.mem_iSup.mp hx }
  have hcompat :
      (QGaugePresheaf.toPresheafLike P).CompatibleFamily C sf := by
    intro i j
    change
      (toMathlibPresheaf P).map ((U i).infLELeft (U j)).op (sf i) =
        (toMathlibPresheaf P).map ((U i).infLERight (U j)).op (sf j)
    exact hsf i j
  obtain ⟨s, hs, huniq⟩ := hP.existsUnique_gluing C sf hcompat
  refine ⟨s, ?_, ?_⟩
  · intro i
    change P.res (le_iSup U i) s = sf i
    exact hs i
  · intro t ht
    apply huniq t
    intro i
    change P.res (le_iSup U i) t = sf i
    exact ht i

/-- Bundle a lightweight proved sheaf as a Mathlib sheaf object. -/
def toMathlibSheaf
    (P : QGaugePresheaf (TopologicalSpace.Opens X))
    (hP : IsSheafLike (QGaugePresheaf.toPresheafLike P)) :
    TopCat.Sheaf (Type v) (TopCat.of X) :=
  ⟨toMathlibPresheaf P, toMathlibPresheaf_isSheaf P hP⟩

/-- Bundle a lightweight natural morphism as a morphism of Mathlib sheaves. -/
def toMathlibSheafMorphism
    {P Q : QGaugePresheaf (TopologicalSpace.Opens X)}
    (φ : QGaugePresheaf.Morphism P Q)
    (hP : IsSheafLike (QGaugePresheaf.toPresheafLike P))
    (hQ : IsSheafLike (QGaugePresheaf.toPresheafLike Q)) :
    toMathlibSheaf P hP ⟶ toMathlibSheaf Q hQ :=
  ObjectProperty.homMk (toMathlibNatTrans φ)

@[simp] theorem toMathlibSheafMorphism_app
    {P Q : QGaugePresheaf (TopologicalSpace.Opens X)}
    (φ : QGaugePresheaf.Morphism P Q)
    (hP : IsSheafLike (QGaugePresheaf.toPresheafLike P))
    (hQ : IsSheafLike (QGaugePresheaf.toPresheafLike Q))
    (U : (TopologicalSpace.Opens X)ᵒᵖ) (s : P.Field U.unop) :
    (toMathlibSheafMorphism φ hP hQ).hom.app U s = φ.app U.unop s := by
  change (toMathlibNatTrans φ).app U s = _
  exact toMathlibNatTrans_app φ U s

end Generic

/-- The Mathlib sheaf category containing the actual Definition 14 objects. -/
abbrev ActualSheafCategory :=
  TopCat.Sheaf (Type v) (TopCat.of RadiusBase)

/-- The actual ambient q-gauge sheaf as a Mathlib sheaf object. -/
def mathlibAq : ActualSheafCategory.{v} :=
  toMathlibSheaf (Aq D K A) (Aq_isSheaf D K A)

/-- The actual inside/outside boundary sheaf as a Mathlib sheaf object. -/
def mathlibBq : ActualSheafCategory.{v} :=
  toMathlibSheaf (liftedBq.{v} A) (liftedBq_isSheaf.{v} A)

/-- The explicit subtype equalizer as a Mathlib sheaf object. -/
def mathlibEqSheaf : ActualSheafCategory.{v} :=
  toMathlibSheaf (EqSheaf D K A) (EqSheaf_isSheaf D K A)

/-- The actual inside restriction as a morphism in the Mathlib sheaf category. -/
def mathlibResIn : mathlibAq D K A ⟶ mathlibBq A :=
  toMathlibSheafMorphism (liftedResIn D K A)
    (Aq_isSheaf D K A) (liftedBq_isSheaf.{v} A)

/-- The actual outside restriction as a morphism in the Mathlib sheaf category. -/
def mathlibResOut : mathlibAq D K A ⟶ mathlibBq A :=
  toMathlibSheafMorphism (liftedResOut D K A)
    (Aq_isSheaf D K A) (liftedBq_isSheaf.{v} A)

/-- Inclusion of the pointwise subtype equalizer into the ambient sheaf. -/
def equalizerInclusion :
    QGaugePresheaf.Morphism (EqSheaf D K A) (Aq D K A) where
  app U s := s.1
  naturality := by
    intro U W hUW s
    rfl

@[simp] theorem equalizerInclusion_apply
    (U : Opens) (s : (EqSheaf D K A).Field U) :
    (equalizerInclusion D K A).app U s = s.1 :=
  rfl

/-- The subtype inclusion as a morphism of Mathlib sheaves. -/
def mathlibEqualizerInclusion :
    mathlibEqSheaf D K A ⟶ mathlibAq D K A :=
  toMathlibSheafMorphism (equalizerInclusion D K A)
    (EqSheaf_isSheaf D K A) (Aq_isSheaf D K A)

/-- The subtype inclusion equalizes the two actual boundary morphisms. -/
theorem mathlibEqualizerInclusion_condition :
    mathlibEqualizerInclusion D K A ≫ mathlibResIn D K A =
      mathlibEqualizerInclusion D K A ≫ mathlibResOut D K A := by
  apply CategoryTheory.Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  apply CategoryTheory.ConcreteCategory.ext_apply
  intro s
  change (liftedResIn D K A).app U.unop s.1 =
    (liftedResOut D K A).app U.unop s.1
  apply LocallyConstant.ext
  intro x
  exact congrArg ULift.up
    (congrArg (fun t : (Bq A).Field U.unop => t.toFun x) s.2)

/-- The fork whose point is the explicit subtype equalizer sheaf. -/
def mathlibSubtypeFork :
    Fork (mathlibResIn D K A) (mathlibResOut D K A) :=
  Fork.ofι (mathlibEqualizerInclusion D K A)
    (mathlibEqualizerInclusion_condition D K A)

/-- A fork condition, evaluated on one open and one section. -/
theorem fork_condition_apply
    (S : Fork (mathlibResIn D K A) (mathlibResOut D K A))
    (U : Opensᵒᵖ) (s : S.pt.obj.obj U) :
    (resIn D K A).app U.unop (S.ι.hom.app U s) =
      (resOut D K A).app U.unop (S.ι.hom.app U s) := by
  have h := congrArg
    (fun k : S.pt ⟶ mathlibBq A => k.hom.app U s) S.condition
  change
    (liftedResIn D K A).app U.unop (S.ι.hom.app U s) =
      (liftedResOut D K A).app U.unop (S.ι.hom.app U s) at h
  apply LocallyConstant.ext
  intro x
  have hx := congrArg (fun t => t.toFun x) h
  change ULift.up
      (insideBoundaryDatum D K A ((S.ι.hom.app U s).toFun x)) =
    ULift.up
      (outsideBoundaryDatum D K A ((S.ι.hom.app U s).toFun x)) at hx
  change insideBoundaryDatum D K A ((S.ι.hom.app U s).toFun x) =
    outsideBoundaryDatum D K A ((S.ι.hom.app U s).toFun x)
  exact congrArg (fun u : ULift.{v} (BoundaryDatum A) => u.down) hx

/-- Every competing fork has a canonical sectionwise lift into the subtype
equalizer. -/
def mathlibSubtypeLift
    (S : Fork (mathlibResIn D K A) (mathlibResOut D K A)) :
    S.pt ⟶ mathlibEqSheaf D K A :=
  ObjectProperty.homMk
    { app := fun U => TypeCat.ofHom fun s =>
        ⟨S.ι.hom.app U s, fork_condition_apply D K A S U s⟩
      naturality := by
        intro U W f
        apply CategoryTheory.ConcreteCategory.ext_apply
        intro s
        apply Subtype.ext
        change S.ι.hom.app W (S.pt.obj.map f s) =
          (mathlibAq D K A).obj.map f (S.ι.hom.app U s)
        exact CategoryTheory.ConcreteCategory.congr_hom
          (S.ι.hom.naturality f) s }

@[simp] theorem mathlibSubtypeLift_app_val
    (S : Fork (mathlibResIn D K A) (mathlibResOut D K A))
    (U : Opensᵒᵖ) (s : S.pt.obj.obj U) :
    ((mathlibSubtypeLift D K A S).hom.app U s).1 =
      S.ι.hom.app U s :=
  rfl

/-- The canonical lift factors the competing fork through the subtype
inclusion. -/
theorem mathlibSubtypeLift_fac
    (S : Fork (mathlibResIn D K A) (mathlibResOut D K A)) :
    mathlibSubtypeLift D K A S ≫ mathlibEqualizerInclusion D K A = S.ι := by
  apply CategoryTheory.Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  apply CategoryTheory.ConcreteCategory.ext_apply
  intro s
  rfl

/-- The sectionwise subtype lift is the unique factorization through the
subtype inclusion. -/
theorem mathlibSubtypeLift_unique
    (S : Fork (mathlibResIn D K A) (mathlibResOut D K A))
    (m : S.pt ⟶ mathlibEqSheaf D K A)
    (hm : m ≫ mathlibEqualizerInclusion D K A = S.ι) :
    m = mathlibSubtypeLift D K A S := by
  apply CategoryTheory.Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  apply CategoryTheory.ConcreteCategory.ext_apply
  intro s
  apply Subtype.ext
  have h := congrArg
    (fun k : S.pt ⟶ mathlibAq D K A => k.hom.app U s) hm
  change (m.hom.app U s).1 = S.ι.hom.app U s at h
  simpa only [mathlibSubtypeLift_app_val] using h

/-- The explicit subtype fork satisfies the categorical equalizer universal
property in Mathlib's category of sheaves. -/
def mathlibSubtypeForkIsLimit :
    IsLimit (mathlibSubtypeFork D K A) := by
  refine Fork.IsLimit.mk' _ fun S => ?_
  refine ⟨mathlibSubtypeLift D K A S,
    mathlibSubtypeLift_fac D K A S, ?_⟩
  intro m hm
  exact mathlibSubtypeLift_unique D K A S m hm


/-- The explicit subtype fork installs the required categorical equalizer. -/
noncomputable instance mathlibHasEqualizer :
    HasEqualizer (mathlibResIn D K A) (mathlibResOut D K A) :=
  HasLimit.mk
    { cone := mathlibSubtypeFork D K A
      isLimit := mathlibSubtypeForkIsLimit D K A }

/-- The current pointwise subtype equalizer sheaf is canonically isomorphic to
Mathlib's categorical equalizer in the sheaf category. -/
noncomputable def mathlibSubtypeEqualizerIso :
    mathlibEqSheaf D K A ≅
      equalizer (mathlibResIn D K A) (mathlibResOut D K A) :=
  IsLimit.conePointUniqueUpToIso
    (mathlibSubtypeForkIsLimit D K A)
    (limit.isLimit
      (parallelPair (mathlibResIn D K A) (mathlibResOut D K A)))

/-- The canonical isomorphism commutes with the equalizer inclusions. -/
@[reassoc] theorem mathlibSubtypeEqualizerIso_hom_comp_ι :
    (mathlibSubtypeEqualizerIso D K A).hom ≫
        equalizer.ι (mathlibResIn D K A) (mathlibResOut D K A) =
      mathlibEqualizerInclusion D K A := by
  exact IsLimit.conePointUniqueUpToIso_hom_comp
    (mathlibSubtypeForkIsLimit D K A)
    (limit.isLimit
      (parallelPair (mathlibResIn D K A) (mathlibResOut D K A)))
    WalkingParallelPair.zero

/-- The inverse canonical isomorphism also commutes with the equalizer
inclusions. -/
@[reassoc] theorem mathlibSubtypeEqualizerIso_inv_comp_inclusion :
    (mathlibSubtypeEqualizerIso D K A).inv ≫
        mathlibEqualizerInclusion D K A =
      equalizer.ι (mathlibResIn D K A) (mathlibResOut D K A) := by
  exact IsLimit.conePointUniqueUpToIso_inv_comp
    (mathlibSubtypeForkIsLimit D K A)
    (limit.isLimit
      (parallelPair (mathlibResIn D K A) (mathlibResOut D K A)))
    WalkingParallelPair.zero

end MathlibBridge

/-- PR-facing certificate collecting every unconditional Definition 14
obligation in one proposition. -/
structure Certificate
    (D : Definition11.AnalyticData V) (K : KernelData)
    (A : CommonAnnulus) : Prop where
  boundary_sections :
    ∀ U : Opens,
      (Bq A).Field U = LocallyConstant U (BoundaryDatum A)
  outside_matching :
    ∀ (x : GaugeDatum D K A) (q : BoundaryPoint A),
      x.mockPart.1.series.outside.sumAt q.1⁻¹ =
        (2 : ℂ) * K.psi.sumAt q.1 -
          x.mockPart.1.series.correction.sumAt q.1
  inside_component :
    ∀ (U : Opens) (s : (Aq D K A).Field U) (x : U),
      ((resIn D K A).app U s).toFun x =
        insideBoundaryDatum D K A (s.toFun x)
  outside_component :
    ∀ (U : Opens) (s : (Aq D K A).Field U) (x : U),
      ((resOut D K A).app U s).toFun x =
        outsideBoundaryDatum D K A (s.toFun x)
  outside_components_agree :
    ∀ (U : Opens) (s : (Aq D K A).Field U) (x : U)
      (q : BoundaryPoint A),
      (((resOut D K A).app U s).toFun x).inside q =
        (((resOut D K A).app U s).toFun x).outside q
  inside_natural :
    ∀ {U W : Opens} (hUW : U ≤ W) (s : (Aq D K A).Field W),
      (Bq A).res hUW ((resIn D K A).app W s) =
        (resIn D K A).app U ((Aq D K A).res hUW s)
  outside_natural :
    ∀ {U W : Opens} (hUW : U ≤ W) (s : (Aq D K A).Field W),
      (Bq A).res hUW ((resOut D K A).app W s) =
        (resOut D K A).app U ((Aq D K A).res hUW s)
  pointwise_equalizer :
    ∀ U : Opens,
      (EqSheaf D K A).Field U =
        {s : (Aq D K A).Field U //
          (resIn D K A).app U s = (resOut D K A).app U s}
  equalizer_is_sheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike (EqSheaf D K A))
  categorical_equalizer :
    Nonempty
      (MathlibBridge.mathlibEqSheaf D K A ≅
        CategoryTheory.Limits.equalizer
          (MathlibBridge.mathlibResIn D K A)
          (MathlibBridge.mathlibResOut D K A))
  balanced_iff_global_compatibility :
    ∀ (U : Opens) (s : (Aq D K A).Field U),
      s ∈ QGaugePresheaf.Eq (resIn D K A) (resOut D K A) U ↔
        SectionGloballyCompatible D K A s

/-- The complete unconditional Definition 14 certificate. -/
noncomputable def certificate : Certificate (D := D) (K := K) (A := A) where
  boundary_sections := Bq_field A
  outside_matching := outside_eq_predicted D K A
  inside_component := resIn_apply D K A
  outside_component := resOut_apply D K A
  outside_components_agree := resOut_components_eq D K A
  inside_natural := resIn_naturality D K A
  outside_natural := resOut_naturality D K A
  pointwise_equalizer := EqSheaf_field D K A
  equalizer_is_sheaf := EqSheaf_isSheaf D K A
  categorical_equalizer :=
    ⟨MathlibBridge.mathlibSubtypeEqualizerIso D K A⟩
  balanced_iff_global_compatibility :=
    mem_EqSheaf_iff_globalCompatible D K A

end

end Definition14Boundary

/-!
## §F.2.3 — Proposition 14: flat q-connection

The paper does not specify the associated `Hq` evolution equation, its
trajectory space, or analytic hypotheses implying existence and uniqueness.
The declarations below therefore separate the missing analytic input from its
formal consequences.  `HqEvolutionData` names the operator and solution
relation, while `HqEvolutionWellPosed` is the exact existence-and-uniqueness
boundary.  Flatness means factorisation through Mathlib's endpoint-preserving
path-homotopy quotient.

For the corrected constant-kernel local system of Definition 11, the operator
is the zero generator, solutions are constant trajectories, and every item in
the checklist is proved without an analytic assumption.
-/

namespace Proposition14

noncomputable section

open Definition11

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- A path in the radius interval from `r` to `s`. -/
abbrev RadiusPath (r s : RadiusBase) :=
  Path r s

/-- Endpoint-preserving path-homotopy classes in the radius interval. -/
abbrev RadiusPathClass (r s : RadiusBase) :=
  Path.Homotopic.Quotient r s

/-- The constant radius path. -/
def constantPath (r : RadiusBase) : RadiusPath r r :=
  Path.refl r

/-- Concatenation of composable radius paths. -/
def concatenatePath {r s t : RadiusBase}
    (γ : RadiusPath r s) (η : RadiusPath s t) : RadiusPath r t :=
  γ.trans η

/-- Projection of a radius path to its endpoint-preserving homotopy class. -/
def pathClass {r s : RadiusBase} (γ : RadiusPath r s) : RadiusPathClass r s :=
  Path.Homotopic.Quotient.mk γ

@[simp] theorem pathClass_constant (r : RadiusBase) :
    pathClass (constantPath r) = Path.Homotopic.Quotient.refl r :=
  rfl

@[simp] theorem pathClass_concatenate {r s t : RadiusBase}
    (γ : RadiusPath r s) (η : RadiusPath s t) :
    pathClass (concatenatePath γ η) = (pathClass γ).trans (pathClass η) :=
  rfl

theorem pathClass_eq_iff_homotopic {r s : RadiusBase}
    {γ η : RadiusPath r s} :
    pathClass γ = pathClass η ↔ Path.Homotopic γ η :=
  Path.Homotopic.Quotient.eq

/-- A fibre-valued trajectory along a radius path. -/
abbrev Trajectory (D : AnalyticData V) {r s : RadiusBase}
    (γ : RadiusPath r s) :=
  ∀ a : unitInterval, Fibre D (γ a)

/-- Analytic data omitted by the paper's phrase "the associated evolution
equation for `Hq`".  `SolvesHq γ u₀ u` is the exact solution predicate that an
analytic q-series development must instantiate. -/
structure HqEvolutionData (D : AnalyticData V) where
  Hq : ∀ r : RadiusBase, Fibre D r →ₗ[ℂ] Fibre D r
  SolvesHq :
    ∀ {r s : RadiusBase} (γ : RadiusPath r s),
      Fibre D r → Trajectory D γ → Prop
  initial_value :
    ∀ {r s : RadiusBase} (γ : RadiusPath r s)
      (u₀ : Fibre D r) {u : Trajectory D γ},
      SolvesHq γ u₀ u → u 0 = u₀

/-- Exact well-posedness hypothesis for the omitted `Hq` evolution problem. -/
structure HqEvolutionWellPosed {D : AnalyticData V}
    (E : HqEvolutionData D) : Prop where
  existsUnique_solution :
    ∀ {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r),
      ∃! u : Trajectory D γ, E.SolvesHq γ u₀ u

namespace HqEvolutionWellPosed

variable {D : AnalyticData V} {E : HqEvolutionData D}

theorem exists_solution (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    ∃ u : Trajectory D γ, E.SolvesHq γ u₀ u :=
  (W.existsUnique_solution γ u₀).exists

theorem solution_eq (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} {γ : RadiusPath r s} {u₀ : Fibre D r}
    {u v : Trajectory D γ}
    (hu : E.SolvesHq γ u₀ u) (hv : E.SolvesHq γ u₀ v) :
    u = v :=
  (W.existsUnique_solution γ u₀).unique hu hv

/-- The unique trajectory selected from a proved well-posedness witness. -/
noncomputable def solution (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    Trajectory D γ :=
  Classical.choose (W.exists_solution γ u₀)

theorem solution_spec (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    E.SolvesHq γ u₀ (W.solution γ u₀) :=
  Classical.choose_spec (W.exists_solution γ u₀)

@[simp] theorem solution_initial (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    W.solution γ u₀ 0 = u₀ :=
  E.initial_value γ u₀ (W.solution_spec γ u₀)

end HqEvolutionWellPosed

namespace HqEvolutionData

variable {D : AnalyticData V}

/-- Endpoint relation induced by an `Hq` solution trajectory. -/
def Endpoint (E : HqEvolutionData D) {r s : RadiusBase}
    (γ : RadiusPath r s) (u₀ : Fibre D r) (u₁ : Fibre D s) : Prop :=
  ∃ u : Trajectory D γ, E.SolvesHq γ u₀ u ∧ u 1 = u₁

end HqEvolutionData

theorem HqEvolutionWellPosed.endpoint_unique
    {D : AnalyticData V} {E : HqEvolutionData D}
    (W : HqEvolutionWellPosed E)
    {r s : RadiusBase} {γ : RadiusPath r s} {u₀ : Fibre D r}
    {u₁ u₂ : Fibre D s}
    (h₁ : E.Endpoint γ u₀ u₁) (h₂ : E.Endpoint γ u₀ u₂) :
    u₁ = u₂ := by
  obtain ⟨u, hu, hu₁⟩ := h₁
  obtain ⟨v, hv, hv₁⟩ := h₂
  have huv : u = v := W.solution_eq hu hv
  calc
    u₁ = u 1 := hu₁.symm
    _ = v 1 := congrFun huv 1
    _ = u₂ := hv₁

/-- The corrected Definition 11 evolution: zero generator and constant
trajectories in the fixed solution kernel. -/
def correctedEvolution (D : AnalyticData V) : HqEvolutionData D where
  Hq := fun _ => 0
  SolvesHq := fun _ u₀ u => ∀ a, u a = u₀
  initial_value := by
    intro r s γ u₀ u h
    exact h 0

@[simp] theorem correctedEvolution_Hq_apply (D : AnalyticData V)
    (r : RadiusBase) (u : Fibre D r) :
    (correctedEvolution D).Hq r u = 0 :=
  rfl

theorem correctedEvolution_solves_iff (D : AnalyticData V)
    {r s : RadiusBase} (γ : RadiusPath r s)
    (u₀ : Fibre D r) (u : Trajectory D γ) :
    (correctedEvolution D).SolvesHq γ u₀ u ↔ ∀ a, u a = u₀ :=
  Iff.rfl

/-- Existence and uniqueness for the corrected zero-generator evolution. -/
theorem correctedEvolutionWellPosed (D : AnalyticData V) :
    HqEvolutionWellPosed (correctedEvolution D) := by
  refine ⟨?_⟩
  intro r s γ u₀
  refine ⟨fun _ => u₀, ?_, ?_⟩
  · intro a
    rfl
  · intro u hu
    funext a
    exact hu a

/-- Parallel transport satisfying identity and composition on path-homotopy
classes.  Taking homotopy classes as input is the precise flatness definition
used in this formalization. -/
structure FlatTransport (D : AnalyticData V) where
  map :
    ∀ {r s : RadiusBase}, RadiusPathClass r s →
      Fibre D r ≃ₗ[ℂ] Fibre D s
  map_refl :
    ∀ r : RadiusBase,
      map (Path.Homotopic.Quotient.refl r) =
        LinearEquiv.refl ℂ (Fibre D r)
  map_trans :
    ∀ {r s t : RadiusBase}
      (γ : RadiusPathClass r s) (η : RadiusPathClass s t),
      map (γ.trans η) = (map γ).trans (map η)

namespace FlatTransport

variable {D : AnalyticData V}

/-- Transport along a raw path, obtained by projection to its homotopy class. -/
def alongPath (T : FlatTransport D) {r s : RadiusBase}
    (γ : RadiusPath r s) : Fibre D r ≃ₗ[ℂ] Fibre D s :=
  T.map (pathClass γ)

@[simp] theorem alongPath_constant (T : FlatTransport D) (r : RadiusBase) :
    T.alongPath (constantPath r) = LinearEquiv.refl ℂ (Fibre D r) := by
  exact T.map_refl r

theorem alongPath_concatenate (T : FlatTransport D)
    {r s t : RadiusBase} (γ : RadiusPath r s) (η : RadiusPath s t) :
    T.alongPath (concatenatePath γ η) =
      (T.alongPath γ).trans (T.alongPath η) := by
  exact T.map_trans (pathClass γ) (pathClass η)

theorem alongPath_eq_of_homotopic (T : FlatTransport D)
    {r s : RadiusBase} {γ η : RadiusPath r s}
    (h : Path.Homotopic γ η) :
    T.alongPath γ = T.alongPath η := by
  exact congrArg (fun q : RadiusPathClass r s => T.map q)
    (pathClass_eq_iff_homotopic.mpr h)

/-- Explicit flatness predicate for raw paths. -/
def IsFlat (T : FlatTransport D) : Prop :=
  ∀ {r s : RadiusBase} {γ η : RadiusPath r s},
    Path.Homotopic γ η → T.alongPath γ = T.alongPath η

theorem isFlat (T : FlatTransport D) : T.IsFlat :=
  fun h => T.alongPath_eq_of_homotopic h

/-- A flat transport realizes an evolution problem when its endpoint is the
endpoint of an evolution solution for every initial value and raw path. -/
def Realizes (T : FlatTransport D) (E : HqEvolutionData D) : Prop :=
  ∀ {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r),
    E.Endpoint γ u₀ (T.alongPath γ u₀)

theorem alongPath_eq_of_realizes
    {E : HqEvolutionData D} (W : HqEvolutionWellPosed E)
    {T₁ T₂ : FlatTransport D}
    (h₁ : T₁.Realizes E) (h₂ : T₂.Realizes E)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    T₁.alongPath γ u₀ = T₂.alongPath γ u₀ :=
  W.endpoint_unique (h₁ γ u₀) (h₂ γ u₀)

/-- Extensionality of flat transport by its action on every path class and
fibre element. -/
@[ext] theorem ext {T₁ T₂ : FlatTransport D}
    (h : ∀ {r s : RadiusBase} (γ : RadiusPathClass r s)
      (u : Fibre D r), T₁.map γ u = T₂.map γ u) :
    T₁ = T₂ := by
  cases T₁ with
  | mk map₁ refl₁ trans₁ =>
      cases T₂ with
      | mk map₂ refl₂ trans₂ =>
          congr 1
          funext r s γ
          apply LinearEquiv.ext
          intro u
          exact h (r := r) (s := s) γ u

/-- A well-posed evolution problem admits at most one realizing flat
transport. -/
theorem eq_of_realizes
    {E : HqEvolutionData D} (W : HqEvolutionWellPosed E)
    {T₁ T₂ : FlatTransport D}
    (h₁ : T₁.Realizes E) (h₂ : T₂.Realizes E) :
    T₁ = T₂ := by
  apply ext
  intro r s q u
  obtain ⟨γ, rfl⟩ := Path.Homotopic.Quotient.mk_surjective q
  exact alongPath_eq_of_realizes W h₁ h₂ γ u

end FlatTransport

/-- Canonical identity transport for the corrected constant-kernel local
system. -/
def canonicalFlatTransport (D : AnalyticData V) : FlatTransport D where
  map := fun {r s} _ => Definition11.transport D r s
  map_refl := Definition11.transport_refl D
  map_trans := by
    intro r s t γ η
    exact (Definition11.transport_trans D r s t).symm

@[simp] theorem canonicalFlatTransport_apply (D : AnalyticData V)
    {r s : RadiusBase} (γ : RadiusPathClass r s) (u : Fibre D r) :
    (canonicalFlatTransport D).map γ u = u :=
  rfl

/-- The canonical transport is exactly the endpoint map of the proved
zero-generator evolution. -/
theorem canonicalFlatTransport_realizes (D : AnalyticData V) :
    (canonicalFlatTransport D).Realizes (correctedEvolution D) := by
  intro r s γ u₀
  refine ⟨fun _ => u₀, ?_, ?_⟩
  · intro a
    rfl
  · rfl

end

end Proposition14

namespace Proposition14

noncomputable section

open Definition11

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- The Definition 11 local-system sections, presented in the legacy
`QGaugePresheaf` interface consumed by `QConnection`. -/
abbrev sectionGaugePresheaf (D : AnalyticData V) :
    QGaugePresheaf (TopologicalSpace.Opens RadiusBase) where
  Field U := LocallyConstant U D.solutionSpace
  res hUW s := (Definition11.Lq D).res hUW s
  res_id := (Definition11.Lq D).res_id
  res_comp := (Definition11.Lq D).res_comp

@[simp] theorem sectionGaugePresheaf_field (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase) :
    (sectionGaugePresheaf D).Field U = LocallyConstant U D.solutionSpace :=
  rfl

@[simp] theorem sectionGaugePresheaf_res_apply (D : AnalyticData V)
    {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W)
    (s : (sectionGaugePresheaf D).Field W) (x : U) :
    ((sectionGaugePresheaf D).res hUW s).toFun x =
      s.toFun ⟨x.1, hUW x.2⟩ :=
  rfl

theorem sectionGaugePresheaf_res_add (D : AnalyticData V)
    {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W)
    (x y : (sectionGaugePresheaf D).Field W) :
    (sectionGaugePresheaf D).res hUW (x + y) =
      (sectionGaugePresheaf D).res hUW x +
        (sectionGaugePresheaf D).res hUW y := by
  apply LocallyConstant.ext
  intro z
  rfl

theorem sectionGaugePresheaf_res_zero (D : AnalyticData V)
    {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W) :
    (sectionGaugePresheaf D).res hUW
        (0 : (sectionGaugePresheaf D).Field W) = 0 := by
  apply LocallyConstant.ext
  intro z
  rfl

/-- Legacy coefficient-only data for the paper's local formula
`d/d(log r) + A_q(t)`.  It is retained for Proposition 14 compatibility but is
not the corrected Definition 13 codomain; see
`Definition13QCovariant.Dq_localTrivialization`. -/
structure LocalFormulaData (D : AnalyticData V) where
  logRadialDerivative :
    ∀ U : TopologicalSpace.Opens RadiusBase,
      (sectionGaugePresheaf D).Field U →ₗ[ℂ]
        (sectionGaugePresheaf D).Field U
  connectionForm :
    ∀ U : TopologicalSpace.Opens RadiusBase,
      (sectionGaugePresheaf D).Field U →ₗ[ℂ]
        (sectionGaugePresheaf D).Field U
  logRadial_restrict :
    ∀ {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W)
      (s : (sectionGaugePresheaf D).Field W),
      (sectionGaugePresheaf D).res hUW (logRadialDerivative W s) =
        logRadialDerivative U ((sectionGaugePresheaf D).res hUW s)
  connectionForm_restrict :
    ∀ {U W : TopologicalSpace.Opens RadiusBase} (hUW : U ≤ W)
      (s : (sectionGaugePresheaf D).Field W),
      (sectionGaugePresheaf D).res hUW (connectionForm W s) =
        connectionForm U ((sectionGaugePresheaf D).res hUW s)

namespace LocalFormulaData

variable {D : AnalyticData V}

/-- Construction of `∇⁽q⁾` from its two local-formula summands. -/
def connection (L : LocalFormulaData D) :
    (sectionGaugePresheaf D).QConnection where
  D U s := L.logRadialDerivative U s + L.connectionForm U s
  restrict_D := by
    intro U W hUW s
    calc
      (sectionGaugePresheaf D).res hUW
          (L.logRadialDerivative W s + L.connectionForm W s) =
          (sectionGaugePresheaf D).res hUW (L.logRadialDerivative W s) +
            (sectionGaugePresheaf D).res hUW (L.connectionForm W s) :=
        sectionGaugePresheaf_res_add D hUW _ _
      _ = L.logRadialDerivative U ((sectionGaugePresheaf D).res hUW s) +
          L.connectionForm U ((sectionGaugePresheaf D).res hUW s) := by
        rw [L.logRadial_restrict, L.connectionForm_restrict]

@[simp] theorem connection_apply (L : LocalFormulaData D)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (sectionGaugePresheaf D).Field U) :
    L.connection.D U s =
      L.logRadialDerivative U s + L.connectionForm U s :=
  rfl

/-- The local-formula connection in the legacy coefficient-only interface. -/
def toQCovariantDerivative (L : LocalFormulaData D) :
    (sectionGaugePresheaf D).QCovariantDerivative where
  Dq := L.connection.D
  radialPart := fun U => L.logRadialDerivative U
  potentialPart := fun U => L.connectionForm U
  combine := fun _ x y => x + y
  local_formula := by
    intro U s
    rfl
  restrict_Dq := L.connection.restrict_D

@[simp] theorem toQCovariantDerivative_Dq_apply (L : LocalFormulaData D)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (sectionGaugePresheaf D).Field U) :
    L.toQCovariantDerivative.Dq U s = L.connection.D U s :=
  rfl

@[simp] theorem toQConnection (L : LocalFormulaData D) :
    QGaugePresheaf.QCovariantDerivative.toQConnection
        (sectionGaugePresheaf D) L.toQCovariantDerivative =
      L.connection :=
  rfl

end LocalFormulaData

/-- Extensionality for the legacy `QConnection` interface on the concrete
Definition 11 section presheaf. -/
theorem qConnection_ext (D : AnalyticData V)
    {conn₁ conn₂ : (sectionGaugePresheaf D).QConnection}
    (h : ∀ (U : TopologicalSpace.Opens RadiusBase)
      (s : (sectionGaugePresheaf D).Field U),
      conn₁.D U s = conn₂.D U s) :
    conn₁ = conn₂ := by
  cases conn₁ with
  | mk D₁ h₁ =>
      cases conn₂ with
      | mk D₂ h₂ =>
          have hD : D₁ = D₂ := by
            funext U s
            exact h U s
          cases hD
          rfl

/-- The displayed local formula determines its restriction-compatible
connection uniquely. -/
theorem LocalFormulaData.connection_unique {D : AnalyticData V}
    (L : LocalFormulaData D)
    (conn : (sectionGaugePresheaf D).QConnection)
    (h : ∀ (U : TopologicalSpace.Opens RadiusBase)
      (s : (sectionGaugePresheaf D).Field U),
      conn.D U s = L.logRadialDerivative U s + L.connectionForm U s) :
    conn = L.connection := by
  apply qConnection_ext D
  intro U s
  simpa using h U s

/-- Equivalence between equality with the constructed connection and the
paper's local formula. -/
theorem LocalFormulaData.connection_eq_iff_localFormula
    {D : AnalyticData V} (L : LocalFormulaData D)
    (conn : (sectionGaugePresheaf D).QConnection) :
    conn = L.connection ↔
      ∀ (U : TopologicalSpace.Opens RadiusBase)
        (s : (sectionGaugePresheaf D).Field U),
        conn.D U s = L.logRadialDerivative U s + L.connectionForm U s := by
  constructor
  · rintro rfl
    intro U s
    rfl
  · exact L.connection_unique conn

/-- The local formula for the corrected constant local system: both the
logarithmic radial derivative and the connection form vanish. -/
def zeroLocalFormula (D : AnalyticData V) : LocalFormulaData D where
  logRadialDerivative := fun _ => 0
  connectionForm := fun _ => 0
  logRadial_restrict := by
    intro U W hUW s
    exact sectionGaugePresheaf_res_zero D hUW
  connectionForm_restrict := by
    intro U W hUW s
    exact sectionGaugePresheaf_res_zero D hUW

/-- The corrected flat q-connection `∇⁽q⁾`. -/
def nablaQ (D : AnalyticData V) :
    (sectionGaugePresheaf D).QConnection :=
  (zeroLocalFormula D).connection

@[simp] theorem nablaQ_apply (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (sectionGaugePresheaf D).Field U) :
    (nablaQ D).D U s = 0 := by
  apply LocallyConstant.ext
  intro x
  simp [nablaQ, zeroLocalFormula, LocalFormulaData.connection]

theorem nablaQ_local_formula (D : AnalyticData V)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (sectionGaugePresheaf D).Field U) :
    (nablaQ D).D U s =
      (zeroLocalFormula D).logRadialDerivative U s +
        (zeroLocalFormula D).connectionForm U s :=
  rfl

/-- In the corrected constant-kernel model, the zero local formula has exactly
one restriction-compatible connection. -/
theorem nablaQ_existsUnique (D : AnalyticData V) :
    ∃! conn : (sectionGaugePresheaf D).QConnection,
      ∀ (U : TopologicalSpace.Opens RadiusBase)
        (s : (sectionGaugePresheaf D).Field U),
        conn.D U s = 0 := by
  refine ⟨nablaQ D, nablaQ_apply D, ?_⟩
  intro conn hConn
  apply qConnection_ext D
  intro U s
  calc
    conn.D U s = 0 := hConn U s
    _ = (nablaQ D).D U s := (nablaQ_apply D U s).symm

theorem nablaQ_eq_iff_zeroLocalFormula (D : AnalyticData V)
    (conn : (sectionGaugePresheaf D).QConnection) :
    conn = nablaQ D ↔
      ∀ (U : TopologicalSpace.Opens RadiusBase)
        (s : (sectionGaugePresheaf D).Field U),
        conn.D U s =
          (zeroLocalFormula D).logRadialDerivative U s +
            (zeroLocalFormula D).connectionForm U s :=
  (zeroLocalFormula D).connection_eq_iff_localFormula conn

/-- Legacy endomorphism-valued derivative instantiated by the corrected
Proposition 14 local formula. -/
def correctedQCovariantDerivative (D : AnalyticData V) :
    (sectionGaugePresheaf D).QCovariantDerivative :=
  (zeroLocalFormula D).toQCovariantDerivative

/-- Bridge from the concrete Proposition 14 derivative to the existing
abstract `QConnection` interface. -/
@[simp] theorem correctedQCovariantDerivative_toQConnection
    (D : AnalyticData V) :
    QGaugePresheaf.QCovariantDerivative.toQConnection
        (sectionGaugePresheaf D) (correctedQCovariantDerivative D) =
      nablaQ D :=
  rfl

/-- Complete analytic input required to interpret the paper's nontrivial
`Hq`.  The formal connection and all uniqueness results are derived from these
explicit fields; no field is installed as a global axiom. -/
structure AnalyticInput (D : AnalyticData V) where
  evolution : HqEvolutionData D
  wellPosed : HqEvolutionWellPosed evolution
  transport : FlatTransport D
  transport_realizes : transport.Realizes evolution
  localFormula : LocalFormulaData D

namespace AnalyticInput

variable {D : AnalyticData V}

/-- Connection reconstructed from the supplied local formula. -/
def connection (A : AnalyticInput D) :
    (sectionGaugePresheaf D).QConnection :=
  A.localFormula.connection

/-- Legacy coefficient-only derivative reconstructed from the same local
formula. -/
def covariantDerivative (A : AnalyticInput D) :
    (sectionGaugePresheaf D).QCovariantDerivative :=
  A.localFormula.toQCovariantDerivative

theorem evolution_existsUnique (A : AnalyticInput D)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    ∃! u : Trajectory D γ, A.evolution.SolvesHq γ u₀ u :=
  A.wellPosed.existsUnique_solution γ u₀

theorem transport_isFlat (A : AnalyticInput D) :
    A.transport.IsFlat :=
  A.transport.isFlat

/-- Well-posed evolution makes any realizing flat transport unique pointwise. -/
theorem transport_unique (A : AnalyticInput D)
    (T : FlatTransport D) (hT : T.Realizes A.evolution)
    {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r) :
    T.alongPath γ u₀ = A.transport.alongPath γ u₀ :=
  FlatTransport.alongPath_eq_of_realizes A.wellPosed
    hT A.transport_realizes γ u₀

theorem transport_unique_structure (A : AnalyticInput D)
    (T : FlatTransport D) (hT : T.Realizes A.evolution) :
    T = A.transport :=
  FlatTransport.eq_of_realizes A.wellPosed hT A.transport_realizes

theorem connection_local_formula (A : AnalyticInput D)
    (U : TopologicalSpace.Opens RadiusBase)
    (s : (sectionGaugePresheaf D).Field U) :
    A.connection.D U s =
      A.localFormula.logRadialDerivative U s +
        A.localFormula.connectionForm U s :=
  rfl

theorem connection_unique (A : AnalyticInput D)
    (conn : (sectionGaugePresheaf D).QConnection)
    (hConn : ∀ (U : TopologicalSpace.Opens RadiusBase)
      (s : (sectionGaugePresheaf D).Field U),
      conn.D U s = A.localFormula.logRadialDerivative U s +
        A.localFormula.connectionForm U s) :
    conn = A.connection :=
  A.localFormula.connection_unique conn hConn

@[simp] theorem covariantDerivative_toQConnection (A : AnalyticInput D) :
    QGaugePresheaf.QCovariantDerivative.toQConnection
        (sectionGaugePresheaf D) A.covariantDerivative = A.connection :=
  rfl

end AnalyticInput

/-- All analytic inputs are explicitly constructed for the corrected constant
kernel model. -/
def correctedAnalyticInput (D : AnalyticData V) : AnalyticInput D where
  evolution := correctedEvolution D
  wellPosed := correctedEvolutionWellPosed D
  transport := canonicalFlatTransport D
  transport_realizes := canonicalFlatTransport_realizes D
  localFormula := zeroLocalFormula D

@[simp] theorem correctedAnalyticInput_connection (D : AnalyticData V) :
    (correctedAnalyticInput D).connection = nablaQ D :=
  rfl

@[simp] theorem correctedAnalyticInput_covariantDerivative
    (D : AnalyticData V) :
    (correctedAnalyticInput D).covariantDerivative =
      correctedQCovariantDerivative D :=
  rfl

/-- PR-facing certificate for every Proposition 14 checklist clause in the
corrected model.  The separate `AnalyticInput` type is the exact boundary for
the paper's nontrivial, unspecified `Hq` evolution. -/
structure Certificate (D : AnalyticData V) : Prop where
  evolution_existsUnique :
    ∀ {r s : RadiusBase} (γ : RadiusPath r s) (u₀ : Fibre D r),
      ∃! u : Trajectory D γ,
        (correctedEvolution D).SolvesHq γ u₀ u
  transport_identity :
    ∀ r : RadiusBase,
      (canonicalFlatTransport D).alongPath (constantPath r) =
        LinearEquiv.refl ℂ (Fibre D r)
  transport_composition :
    ∀ {r s t : RadiusBase} (γ : RadiusPath r s) (η : RadiusPath s t),
      (canonicalFlatTransport D).alongPath (concatenatePath γ η) =
        ((canonicalFlatTransport D).alongPath γ).trans
          ((canonicalFlatTransport D).alongPath η)
  transport_homotopy_invariant :
    ∀ {r s : RadiusBase} {γ η : RadiusPath r s},
      Path.Homotopic γ η →
        (canonicalFlatTransport D).alongPath γ =
          (canonicalFlatTransport D).alongPath η
  flatness : (canonicalFlatTransport D).IsFlat
  transport_solves_evolution :
    (canonicalFlatTransport D).Realizes (correctedEvolution D)
  transport_unique :
    ∀ T : FlatTransport D,
      T.Realizes (correctedEvolution D) → T = canonicalFlatTransport D
  local_formula :
    ∀ (U : TopologicalSpace.Opens RadiusBase)
      (s : (sectionGaugePresheaf D).Field U),
      (nablaQ D).D U s =
        (zeroLocalFormula D).logRadialDerivative U s +
          (zeroLocalFormula D).connectionForm U s
  local_formula_equivalence :
    ∀ conn : (sectionGaugePresheaf D).QConnection,
      conn = nablaQ D ↔
        ∀ (U : TopologicalSpace.Opens RadiusBase)
          (s : (sectionGaugePresheaf D).Field U),
          conn.D U s =
            (zeroLocalFormula D).logRadialDerivative U s +
              (zeroLocalFormula D).connectionForm U s
  connection_existsUnique :
    ∃! conn : (sectionGaugePresheaf D).QConnection,
      ∀ (U : TopologicalSpace.Opens RadiusBase)
        (s : (sectionGaugePresheaf D).Field U),
        conn.D U s = 0
  qConnection_bridge :
    QGaugePresheaf.QCovariantDerivative.toQConnection
        (sectionGaugePresheaf D) (correctedQCovariantDerivative D) =
      nablaQ D

theorem certificate (D : AnalyticData V) : Certificate D :=
  { evolution_existsUnique :=
      (correctedEvolutionWellPosed D).existsUnique_solution
    transport_identity := (canonicalFlatTransport D).alongPath_constant
    transport_composition := (canonicalFlatTransport D).alongPath_concatenate
    transport_homotopy_invariant :=
      (canonicalFlatTransport D).alongPath_eq_of_homotopic
    flatness := (canonicalFlatTransport D).isFlat
    transport_solves_evolution := canonicalFlatTransport_realizes D
    transport_unique := fun T hT =>
      FlatTransport.eq_of_realizes (correctedEvolutionWellPosed D)
        hT (canonicalFlatTransport_realizes D)
    local_formula := nablaQ_local_formula D
    local_formula_equivalence := nablaQ_eq_iff_zeroLocalFormula D
    connection_existsUnique := nablaQ_existsUnique D
    qConnection_bridge := correctedQCovariantDerivative_toQConnection D }

end

end Proposition14

/-! ## §F.3 — Proposition 15: categorical SPT bridge skeleton. -/

/-- The indexing type used by the abstract local spectral profiles. -/
abbrev PrimeIndex : Type := {p : ℕ // Nat.Prime p}

@[simp] theorem PrimeIndex.isPrime (p : PrimeIndex) : Nat.Prime p.1 :=
  p.2

/-- Source objects for Proposition 15.  Each object contains an actual
pointwise balanced equalizer sheaf together with an abstract prime-indexed
spectral profile map.  The profile map is data: no analytic construction of
spectral coefficients is claimed in this categorical layer. -/
structure BalancedQGaugeSheafCategory
    (Open : Type u) [Preorder Open] where
  ambient : QGaugePresheaf.{u, v} Open
  boundary : QGaugePresheaf.{u, v} Open
  resIn : QGaugePresheaf.Morphism ambient boundary
  resOut : QGaugePresheaf.Morphism ambient boundary
  PrimeProfile : PrimeIndex → Type v
  primeIndexMap :
    ∀ U : Open,
      (QGaugePresheaf.balancedEqualizerSheaf resIn resOut).Field U →
        ∀ p : PrimeIndex, PrimeProfile p
  primeIndexMap_restrict :
    ∀ {U V : Open} (hUV : U ≤ V)
      (s : (QGaugePresheaf.balancedEqualizerSheaf resIn resOut).Field V)
      (p : PrimeIndex),
      primeIndexMap U
          ((QGaugePresheaf.balancedEqualizerSheaf resIn resOut).res hUV s) p =
        primeIndexMap V s p
  overlapM : ℕ
  overlapN : ℕ

namespace BalancedQGaugeSheafCategory

variable {Open : Type u} [Preorder Open]

/-- The source object's certified balanced equalizer presheaf. -/
abbrev balancedSheaf (X : BalancedQGaugeSheafCategory Open) :
    QGaugePresheaf Open :=
  QGaugePresheaf.balancedEqualizerSheaf X.resIn X.resOut

/-- Compatible source morphisms: natural on balanced sections, compatible
with every prime-indexed profile, and preserving the obstruction indices. -/
structure Hom (X Y : BalancedQGaugeSheafCategory Open) where
  sheafMap : QGaugePresheaf.Morphism X.balancedSheaf Y.balancedSheaf
  profileMap : ∀ p : PrimeIndex, X.PrimeProfile p → Y.PrimeProfile p
  profile_compatible :
    ∀ (U : Open) (s : X.balancedSheaf.Field U) (p : PrimeIndex),
      profileMap p (X.primeIndexMap U s p) =
        Y.primeIndexMap U (sheafMap.app U s) p
  overlapM_eq : X.overlapM = Y.overlapM
  overlapN_eq : X.overlapN = Y.overlapN

namespace Hom

def id (X : BalancedQGaugeSheafCategory Open) : Hom X X where
  sheafMap := QGaugePresheaf.Morphism.id X.balancedSheaf
  profileMap := fun _ x => x
  profile_compatible := by
    intro U s p
    rfl
  overlapM_eq := rfl
  overlapN_eq := rfl

def comp {X Y Z : BalancedQGaugeSheafCategory Open}
    (f : Hom X Y) (g : Hom Y Z) : Hom X Z where
  sheafMap := QGaugePresheaf.Morphism.comp f.sheafMap g.sheafMap
  profileMap := fun p x => g.profileMap p (f.profileMap p x)
  profile_compatible := by
    intro U s p
    calc
      g.profileMap p (f.profileMap p (X.primeIndexMap U s p)) =
          g.profileMap p
            (Y.primeIndexMap U (f.sheafMap.app U s) p) :=
        congrArg (g.profileMap p) (f.profile_compatible U s p)
      _ = Z.primeIndexMap U
            (g.sheafMap.app U (f.sheafMap.app U s)) p :=
        g.profile_compatible U (f.sheafMap.app U s) p
  overlapM_eq := f.overlapM_eq.trans g.overlapM_eq
  overlapN_eq := f.overlapN_eq.trans g.overlapN_eq

theorem ext {X Y : BalancedQGaugeSheafCategory Open} {f g : Hom X Y}
    (hSheaf : f.sheafMap = g.sheafMap)
    (hProfile : f.profileMap = g.profileMap) :
    f = g := by
  cases f
  cases g
  cases hSheaf
  cases hProfile
  rfl

end Hom

instance : Category (BalancedQGaugeSheafCategory Open) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp
  id_comp := by
    intro X Y f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.id_comp f.sheafMap
    · rfl
  comp_id := by
    intro X Y f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_id f.sheafMap
    · rfl
  assoc := by
    intro W X Y Z f g h
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_assoc
        f.sheafMap g.sheafMap h.sheafMap
    · rfl

end BalancedQGaugeSheafCategory

/-- Target objects for Proposition 15: presheaves equipped with local spectral
profiles indexed by actual natural primes and with the two obstruction indices
used by the SPT overlap model. -/
structure PrimalitySheafCategory
    (Open : Type u) [Preorder Open] where
  sheaf : QGaugePresheaf.{u, v} Open
  PrimeProfile : PrimeIndex → Type v
  localProfile :
    ∀ U : Open, sheaf.Field U → ∀ p : PrimeIndex, PrimeProfile p
  localProfile_restrict :
    ∀ {U V : Open} (hUV : U ≤ V) (s : sheaf.Field V) (p : PrimeIndex),
      localProfile U (sheaf.res hUV s) p = localProfile V s p
  overlapM : ℕ
  overlapN : ℕ

namespace PrimalitySheafCategory

variable {Open : Type u} [Preorder Open]

/-- Morphisms preserve both the sheaf restrictions and all prime profiles. -/
structure Hom (X Y : PrimalitySheafCategory Open) where
  sheafMap : QGaugePresheaf.Morphism X.sheaf Y.sheaf
  profileMap : ∀ p : PrimeIndex, X.PrimeProfile p → Y.PrimeProfile p
  profile_compatible :
    ∀ (U : Open) (s : X.sheaf.Field U) (p : PrimeIndex),
      profileMap p (X.localProfile U s p) =
        Y.localProfile U (sheafMap.app U s) p
  overlapM_eq : X.overlapM = Y.overlapM
  overlapN_eq : X.overlapN = Y.overlapN

namespace Hom

def id (X : PrimalitySheafCategory Open) : Hom X X where
  sheafMap := QGaugePresheaf.Morphism.id X.sheaf
  profileMap := fun _ x => x
  profile_compatible := by
    intro U s p
    rfl
  overlapM_eq := rfl
  overlapN_eq := rfl

def comp {X Y Z : PrimalitySheafCategory Open}
    (f : Hom X Y) (g : Hom Y Z) : Hom X Z where
  sheafMap := QGaugePresheaf.Morphism.comp f.sheafMap g.sheafMap
  profileMap := fun p x => g.profileMap p (f.profileMap p x)
  profile_compatible := by
    intro U s p
    calc
      g.profileMap p (f.profileMap p (X.localProfile U s p)) =
          g.profileMap p
            (Y.localProfile U (f.sheafMap.app U s) p) :=
        congrArg (g.profileMap p) (f.profile_compatible U s p)
      _ = Z.localProfile U
            (g.sheafMap.app U (f.sheafMap.app U s)) p :=
        g.profile_compatible U (f.sheafMap.app U s) p
  overlapM_eq := f.overlapM_eq.trans g.overlapM_eq
  overlapN_eq := f.overlapN_eq.trans g.overlapN_eq

theorem ext {X Y : PrimalitySheafCategory Open} {f g : Hom X Y}
    (hSheaf : f.sheafMap = g.sheafMap)
    (hProfile : f.profileMap = g.profileMap) :
    f = g := by
  cases f
  cases g
  cases hSheaf
  cases hProfile
  rfl

end Hom

instance : Category (PrimalitySheafCategory Open) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp
  id_comp := by
    intro X Y f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.id_comp f.sheafMap
    · rfl
  comp_id := by
    intro X Y f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_id f.sheafMap
    · rfl
  assoc := by
    intro W X Y Z f g h
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_assoc
        f.sheafMap g.sheafMap h.sheafMap
    · rfl

end PrimalitySheafCategory

/-!
### Proposition 15 certification boundary

The paper does not define the analytic construction assigning prime-local
spectral coefficients to a balanced q-gauge section.  Accordingly,
`BalancedQGaugeSheafCategory.primeIndexMap` is explicit input data.  The
functor below is canonical relative to that supplied map and certifies the
categorical skeleton: object and morphism behavior, the balanced equalizer,
    and the elementary Tor obstruction model.  It does not certify an analytic
spectral transform or identify this target with the undeclared category from
Paper 1.  Moreover, the paper-facing category names here bundle the lightweight
`QGaugePresheaf` API: equalizer compatibility is pointwise subtype
compatibility, not a theorem that `F` preserves every categorical limit, and
    Tor compatibility concerns the explicit cyclic `Tor1Model`.  Section §E.3
    proves an objectwise comparison with Mathlib's actual `Tor'₁`; this
    Proposition 15 skeleton still does not assert a natural isomorphism of full
    derived Tor functors.
-/

namespace Proposition15FunctorBridge

variable {Open : Type u} [Preorder Open]

/-- Proposition 15's functor, relative to the supplied abstract prime-index
maps on source objects. -/
def F :
    BalancedQGaugeSheafCategory Open ⥤ PrimalitySheafCategory Open where
  obj X :=
    { sheaf := X.balancedSheaf
      PrimeProfile := X.PrimeProfile
      localProfile := X.primeIndexMap
      localProfile_restrict := X.primeIndexMap_restrict
      overlapM := X.overlapM
      overlapN := X.overlapN }
  map f :=
    { sheafMap := f.sheafMap
      profileMap := f.profileMap
      profile_compatible := f.profile_compatible
      overlapM_eq := f.overlapM_eq
      overlapN_eq := f.overlapN_eq }
  map_id := by
    intro X
    apply PrimalitySheafCategory.Hom.ext
    · rfl
    · rfl
  map_comp := by
    intro X Y Z f g
    apply PrimalitySheafCategory.Hom.ext
    · rfl
    · rfl

/-- The explicitly constructed map preserves categorical identities. -/
theorem F_map_identity (X : BalancedQGaugeSheafCategory Open) :
    F.map (𝟙 X) = 𝟙 (F.obj X) :=
  F.map_id X

/-- The explicitly constructed map preserves categorical composition. -/
theorem F_map_composition
    {X Y Z : BalancedQGaugeSheafCategory Open}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    F.map (f ≫ g) = F.map f ≫ F.map g :=
  F.map_comp f g

@[simp] theorem F_obj_sheaf (X : BalancedQGaugeSheafCategory Open) :
    (F.obj X).sheaf = X.balancedSheaf :=
  rfl

/-- `F` preserves the relevant pointwise equalizer object itself. -/
theorem F_preserves_equalizer_object
    (X : BalancedQGaugeSheafCategory Open) :
    (F.obj X).sheaf =
      QGaugePresheaf.balancedEqualizerSheaf X.resIn X.resOut :=
  rfl

@[simp] theorem F_obj_PrimeProfile
    (X : BalancedQGaugeSheafCategory Open) (p : PrimeIndex) :
    (F.obj X).PrimeProfile p = X.PrimeProfile p :=
  rfl

/-- Object behavior in collection form: all prime-indexed profiles are copied
as one dependent profile family. -/
@[simp] theorem F_obj_profileCollection
    (X : BalancedQGaugeSheafCategory Open) (U : Open)
    (s : X.balancedSheaf.Field U) :
    (F.obj X).localProfile U s = X.primeIndexMap U s :=
  rfl

/-- Object behavior: a balanced q-gauge section is sent to its supplied local
spectral profile at every prime index. -/
@[simp] theorem F_obj_localProfile
    (X : BalancedQGaugeSheafCategory Open) (U : Open)
    (s : X.balancedSheaf.Field U) (p : PrimeIndex) :
    (F.obj X).localProfile U s p = X.primeIndexMap U s p :=
  rfl

theorem F_obj_localProfile_restrict
    (X : BalancedQGaugeSheafCategory Open)
    {U V : Open} (hUV : U ≤ V)
    (s : X.balancedSheaf.Field V) (p : PrimeIndex) :
    (F.obj X).localProfile U ((F.obj X).sheaf.res hUV s) p =
      (F.obj X).localProfile V s p :=
  (F.obj X).localProfile_restrict hUV s p

@[simp] theorem F_map_sheafMap
    {X Y : BalancedQGaugeSheafCategory Open} (f : X ⟶ Y) :
    (F.map f).sheafMap = f.sheafMap :=
  rfl

@[simp] theorem F_map_profileMap_apply
    {X Y : BalancedQGaugeSheafCategory Open} (f : X ⟶ Y)
    (p : PrimeIndex) (x : X.PrimeProfile p) :
    (F.map f).profileMap p x = f.profileMap p x :=
  rfl

/-- Morphism behavior: compatible source morphisms remain compatible with all
prime-indexed profiles after applying `F`. -/
theorem F_map_profile_compatible
    {X Y : BalancedQGaugeSheafCategory Open} (f : X ⟶ Y)
    (U : Open) (s : X.balancedSheaf.Field U) (p : PrimeIndex) :
    (F.map f).profileMap p ((F.obj X).localProfile U s p) =
      (F.obj Y).localProfile U ((F.map f).sheafMap.app U s) p :=
  (F.map f).profile_compatible U s p

theorem F_map_preserves_overlapM
    {X Y : BalancedQGaugeSheafCategory Open} (f : X ⟶ Y) :
    (F.obj X).overlapM = (F.obj Y).overlapM :=
  f.overlapM_eq

theorem F_map_preserves_overlapN
    {X Y : BalancedQGaugeSheafCategory Open} (f : X ⟶ Y) :
    (F.obj X).overlapN = (F.obj Y).overlapN :=
  f.overlapN_eq

/-- The source and target equalizer section types are definitionally the same
after applying `F`. -/
def F_equalizerEquiv
    (X : BalancedQGaugeSheafCategory Open) (U : Open) :
    X.balancedSheaf.Field U ≃ (F.obj X).sheaf.Field U :=
  Equiv.refl _

/-- `F` both preserves and reflects pointwise balanced-equalizer membership. -/
theorem F_equalizer_membership_iff
    (X : BalancedQGaugeSheafCategory Open) (U : Open)
    (s : X.ambient.Field U) :
    s ∈ QGaugePresheaf.Eq X.resIn X.resOut U ↔
      ∃ t : (F.obj X).sheaf.Field U, t.1 = s := by
  change s ∈ QGaugePresheaf.Eq X.resIn X.resOut U ↔
    ∃ t : ↥(QGaugePresheaf.Eq X.resIn X.resOut U), t.1 = s
  constructor
  · intro hs
    exact ⟨⟨s, hs⟩, rfl⟩
  · rintro ⟨t, rfl⟩
    exact t.2

theorem F_preserves_equalizer
    (X : BalancedQGaugeSheafCategory Open) (U : Open)
    (s : X.ambient.Field U)
    (hs : s ∈ QGaugePresheaf.Eq X.resIn X.resOut U) :
    ∃ t : (F.obj X).sheaf.Field U, t.1 = s :=
  (F_equalizer_membership_iff X U s).mp hs

theorem F_reflects_equalizer
    (X : BalancedQGaugeSheafCategory Open) (U : Open)
    (s : X.ambient.Field U)
    (hs : ∃ t : (F.obj X).sheaf.Field U, t.1 = s) :
    s ∈ QGaugePresheaf.Eq X.resIn X.resOut U :=
  (F_equalizer_membership_iff X U s).mpr hs

/-- Source obstruction group in the elementary cyclic Tor model. -/
abbrev SourceObstructionGroup (X : BalancedQGaugeSheafCategory Open) :=
  Tor1Model X.overlapM X.overlapN

/-- Target obstruction group in the same elementary cyclic Tor model. -/
abbrev TargetObstructionGroup (Y : PrimalitySheafCategory Open) :=
  Tor1Model Y.overlapM Y.overlapN

/-- Explicit Tor compatibility: `F` copies both overlap indices, so the source
and target obstruction groups are canonically additively equivalent. -/
def F_torCompatibility (X : BalancedQGaugeSheafCategory Open) :
    SourceObstructionGroup X ≃+ TargetObstructionGroup (F.obj X) :=
  AddEquiv.refl _

@[simp] theorem F_torCompatibility_apply
    (X : BalancedQGaugeSheafCategory Open)
    (x : SourceObstructionGroup X) :
    F_torCompatibility X x = x :=
  rfl

@[simp] theorem F_obstruction_gcd_compatibility
    (X : BalancedQGaugeSheafCategory Open) :
    Nat.gcd (F.obj X).overlapM (F.obj X).overlapN =
      Nat.gcd X.overlapM X.overlapN :=
  rfl

/-- PR-facing certificate for every categorical-skeleton clause of
Proposition 15. -/
structure Proposition15FunctorBridgeCertificate : Prop where
  abstract_prime_index_map_is_input :
    ∀ (X : BalancedQGaugeSheafCategory.{u, v} Open) (U : Open),
      ∃ primeIndexMap :
          X.balancedSheaf.Field U → ∀ p : PrimeIndex, X.PrimeProfile p,
        primeIndexMap = X.primeIndexMap U
  object_behavior :
    ∀ (X : BalancedQGaugeSheafCategory.{u, v} Open) (U : Open)
      (s : X.balancedSheaf.Field U) (p : PrimeIndex),
      (F.obj X).localProfile U s p = X.primeIndexMap U s p
  object_profile_collection :
    ∀ (X : BalancedQGaugeSheafCategory.{u, v} Open) (U : Open)
      (s : X.balancedSheaf.Field U),
      (F.obj X).localProfile U s = X.primeIndexMap U s
  object_profiles_restrict :
    ∀ (X : BalancedQGaugeSheafCategory.{u, v} Open)
      {U V : Open} (hUV : U ≤ V)
      (s : X.balancedSheaf.Field V) (p : PrimeIndex),
      (F.obj X).localProfile U ((F.obj X).sheaf.res hUV s) p =
        (F.obj X).localProfile V s p
  morphism_behavior :
    ∀ {X Y : BalancedQGaugeSheafCategory.{u, v} Open} (f : X ⟶ Y)
      (U : Open) (s : X.balancedSheaf.Field U) (p : PrimeIndex),
      (F.map f).profileMap p ((F.obj X).localProfile U s p) =
        (F.obj Y).localProfile U ((F.map f).sheafMap.app U s) p
  functor_identity :
    ∀ X : BalancedQGaugeSheafCategory.{u, v} Open,
      F.map (𝟙 X) = 𝟙 (F.obj X)
  functor_composition :
    ∀ {X Y Z : BalancedQGaugeSheafCategory.{u, v} Open}
      (f : X ⟶ Y) (g : Y ⟶ Z),
      F.map (f ≫ g) = F.map f ≫ F.map g
  equalizer_compatibility :
    ∀ (X : BalancedQGaugeSheafCategory.{u, v} Open) (U : Open)
      (s : X.ambient.Field U),
      s ∈ QGaugePresheaf.Eq X.resIn X.resOut U ↔
        ∃ t : (F.obj X).sheaf.Field U, t.1 = s
  equalizer_object_preserved :
    ∀ X : BalancedQGaugeSheafCategory.{u, v} Open,
      (F.obj X).sheaf =
        QGaugePresheaf.balancedEqualizerSheaf X.resIn X.resOut
  tor_compatibility :
    ∀ X : BalancedQGaugeSheafCategory.{u, v} Open,
      Nonempty
        (SourceObstructionGroup X ≃+
          TargetObstructionGroup (F.obj X))
  obstruction_indices_on_morphisms :
    ∀ {X Y : BalancedQGaugeSheafCategory.{u, v} Open} (f : X ⟶ Y),
      (F.obj X).overlapM = (F.obj Y).overlapM ∧
        (F.obj X).overlapN = (F.obj Y).overlapN

theorem proposition15_functorBridge_certificate :
    Proposition15FunctorBridgeCertificate.{u, v} (Open := Open) := by
  exact
    { abstract_prime_index_map_is_input := fun X U =>
        ⟨X.primeIndexMap U, rfl⟩
      object_behavior := F_obj_localProfile
      object_profile_collection := F_obj_profileCollection
      object_profiles_restrict := F_obj_localProfile_restrict
      morphism_behavior := F_map_profile_compatible
      functor_identity := F_map_identity
      functor_composition := F_map_composition
      equalizer_compatibility := F_equalizer_membership_iff
      equalizer_object_preserved := F_preserves_equalizer_object
      tor_compatibility := fun X => ⟨F_torCompatibility X⟩
      obstruction_indices_on_morphisms := fun f =>
        ⟨F_map_preserves_overlapM f, F_map_preserves_overlapN f⟩ }

end Proposition15FunctorBridge

/-- Minimal functorial bridge from balanced q-gauge data to an SPT obstruction
index.  The obstruction law points back to the gcd/Tor₁ block. -/
structure QGaugeSPTBridge (Open : Type u) [Preorder Open]
    (Aq : QGaugePresheaf Open) where
  overlapM : Open → ℕ
  overlapN : Open → ℕ
  obstruction : ∀ U : Open, Aq.Field U → ℕ
  obstruction_law :
    ∀ (U : Open) (x : Aq.Field U),
      obstruction U x = Nat.gcd (overlapM U) (overlapN U)

theorem bridge_obstruction_eq_gcd {Open : Type u} [Preorder Open]
    {Aq : QGaugePresheaf Open} (B : QGaugeSPTBridge Open Aq)
    (U : Open) (x : Aq.Field U) :
    B.obstruction U x = Nat.gcd (B.overlapM U) (B.overlapN U) :=
  B.obstruction_law U x

theorem bridge_obstruction_matches_Tor1 {Open : Type u} [Preorder Open]
    {Aq : QGaugePresheaf Open} (B : QGaugeSPTBridge Open Aq)
    (U : Open) (x : Aq.Field U) [NeZero (Nat.gcd (B.overlapM U) (B.overlapN U))] :
    Fintype.card (Tor1Model (B.overlapM U) (B.overlapN U)) = B.obstruction U x := by
  rw [Tor1Model_card, bridge_obstruction_eq_gcd]

/-!
## §F.4 — Definition 15 and Lemma 6.1: exact geometry behind equation (6.2)

The earlier `CovariancePredicate` API deliberately treated modular covariance
abstractly.  This section supplies the missing geometric data from §6.4.1 of
the paper.  In particular, the half-weight branch is not silently identified
with a character: a branch and a multiplier are separate data, and their
product is required to satisfy the genuine automorphy-factor cocycle.

The quotient `Γ(2) \ ℍ` has central isotropy, so we do not install an
unsupported smooth-manifold instance on the quotient.  The automorphic line
bundle is constructed by its standard associated-orbit quotient presentation;
twisted quotient forms are then defined by exact smooth descent data.
-/

namespace Definition15Geometry

noncomputable section

open Matrix
open scoped MatrixGroups UpperHalfPlane Manifold ContDiff

/-- The upper half-plane used in equation (6.2). -/
abbrev H := Definition11.H

/-- The actual deck group `Γ(2)`. -/
abbrev Gamma2 := Definition11.Gamma2

/-- The paper's base `X = Γ(2) \ ℍ`. -/
abbrev X := Definition11.Gamma2Quotient

/-- Open subsets of the quotient base. -/
abbrev Opens := TopologicalSpace.Opens X

/-- The canonical projection `π : ℍ → Γ(2) \ ℍ`. -/
def quotientMap : H → X :=
  Definition11.quotientMk

@[simp] theorem quotientMap_smul (γ : Gamma2) (τ : H) :
    quotientMap (γ • τ) = quotientMap τ := by
  exact Definition11.quotientMk_smul γ τ

/-- The quotient projection as a bundled continuous map. -/
def quotientMapContinuous : C(H, X) where
  toFun := quotientMap
  continuous_toFun := by
    change Continuous (@Quotient.mk' H (MulAction.orbitRel Gamma2 H))
    exact continuous_quotient_mk'

/-- The invariant open set `π⁻¹(U) ⊆ ℍ`. -/
def coverOpen (U : Opens) : TopologicalSpace.Opens H :=
  TopologicalSpace.Opens.comap quotientMapContinuous U

@[simp] theorem mem_coverOpen_iff (U : Opens) (τ : H) :
    τ ∈ coverOpen U ↔ quotientMap τ ∈ U :=
  Iff.rfl

theorem coverOpen_mono {V U : Opens} (hVU : V ≤ U) :
    coverOpen V ≤ coverOpen U := by
  intro τ hτ
  exact hVU hτ

/-- Paper notation: `V ⊆ U` implies `π⁻¹(V) ⊆ π⁻¹(U)`. -/
theorem piPreimage_subset {V U : Opens} (hVU : V ≤ U) :
    (coverOpen V : Set H) ⊆ (coverOpen U : Set H) :=
  coverOpen_mono hVU

/-- Every deck transformation preserves the pulled-back open set. -/
@[simp] theorem smul_mem_coverOpen_iff
    (U : Opens) (γ : Gamma2) (τ : H) :
    γ • τ ∈ coverOpen U ↔ τ ∈ coverOpen U := by
  change quotientMap (γ • τ) ∈ U ↔ quotientMap τ ∈ U
  rw [quotientMap_smul]

/-- Canonical real general-linear representative of an element of `Γ(2)`. -/
def gammaGL (γ : Gamma2) : GL (Fin 2) ℝ :=
  (γ.1 : GL (Fin 2) ℝ)

@[simp] theorem gammaGL_one : gammaGL (1 : Gamma2) = 1 := by
  change (((1 : SL(2, ℤ)) : GL (Fin 2) ℝ)) = 1
  simp

@[simp] theorem gammaGL_mul (γ δ : Gamma2) :
    gammaGL (γ * δ) = gammaGL γ * gammaGL δ := by
  change (((γ.1 * δ.1 : SL(2, ℤ)) : GL (Fin 2) ℝ)) =
    (γ.1 : GL (Fin 2) ℝ) * (δ.1 : GL (Fin 2) ℝ)
  simp

@[simp] theorem gammaGL_smul (γ : Gamma2) (τ : H) :
    gammaGL γ • τ = γ • τ := by
  rfl

/-- Every real representative of an element of `Γ(2)` has determinant one. -/
@[simp] theorem gammaGL_matrix_det (γ : Gamma2) :
    (gammaGL γ).val.det = 1 := by
  unfold gammaGL
  rw [← Matrix.GeneralLinearGroup.val_det_apply]
  norm_num

/-- In particular, the upper-half-plane action uses the holomorphic, rather
than conjugate-holomorphic, branch of Mathlib's `GL(2,R)` action. -/
theorem gammaGL_det_pos (γ : Gamma2) :
    0 < (gammaGL γ).det.val := by
  rw [Matrix.GeneralLinearGroup.val_det_apply, gammaGL_matrix_det]
  norm_num

/-- The exact `cτ+d` denominator in (6.1) and (6.2). -/
def denominator (γ : Gamma2) (τ : H) : ℂ :=
  UpperHalfPlane.denom (gammaGL γ) τ

/-- Unfolding identifies `denominator` literally with the lower-row expression
`c*tau+d`. -/
theorem denominator_eq_c_tau_add_d (γ : Gamma2) (τ : H) :
    denominator γ τ =
      ((gammaGL γ 1 0 : ℝ) : ℂ) * (τ : ℂ) +
        ((gammaGL γ 1 1 : ℝ) : ℂ) :=
  rfl

theorem denominator_ne_zero (γ : Gamma2) (τ : H) :
    denominator γ τ ≠ 0 :=
  UpperHalfPlane.denom_ne_zero (gammaGL γ) τ

@[simp] theorem denominator_one (τ : H) :
    denominator (1 : Gamma2) τ = 1 := by
  simp [denominator]

/-- The weight-one denominator cocycle underlying every half-weight branch. -/
theorem denominator_mul (γ δ : Gamma2) (τ : H) :
    denominator (γ * δ) τ =
      denominator γ (δ • τ) * denominator δ τ := by
  unfold denominator
  rw [gammaGL_mul]
  have h := UpperHalfPlane.denom_cocycle'
    (gammaGL γ) (gammaGL δ) τ
  have hsmul :
      UpperHalfPlane.smulAux (gammaGL δ) τ = δ • τ := by
    rfl
  rw [hsmul] at h
  simpa [UpperHalfPlane.σ, gammaGL_det_pos] using h

/-- The deck action is smooth; determinant one discharges Mathlib's positivity
hypothesis without any additional analytic assumption. -/
theorem deckAction_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun τ : H => γ • τ) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
    (fun τ : H => gammaGL γ • τ)
  exact UpperHalfPlane.contMDiff_smul (gammaGL_det_pos γ)

/-- `cτ+d`, bundled as a nonzero complex unit. -/
def denominatorUnit (γ : Gamma2) (τ : H) : ℂˣ :=
  Units.mk0 (denominator γ τ) (denominator_ne_zero γ τ)

@[simp] theorem denominatorUnit_val (γ : Gamma2) (τ : H) :
    ((denominatorUnit γ τ : ℂˣ) : ℂ) = denominator γ τ :=
  rfl

@[simp] theorem denominatorUnit_one (τ : H) :
    denominatorUnit (1 : Gamma2) τ = 1 := by
  apply Units.ext
  simp

theorem denominatorUnit_mul (γ δ : Gamma2) (τ : H) :
    denominatorUnit (γ * δ) τ =
      denominatorUnit γ (δ • τ) * denominatorUnit δ τ := by
  apply Units.ext
  simp [denominator_mul]

section DeckCalculusCanonicalNormedSpace

local instance (priority := 100000) canonicalNormedSpaceComplex :
    NormedSpace ℂ ℂ :=
  (RCLike.innerProductSpace : InnerProductSpace ℂ ℂ).toNormedSpace

/-- The complex derivative of the deck map, in the standard upper-half-plane
coordinate: `d(γτ)/dτ = (cτ+d)⁻²`. -/
def deckDerivative (γ : Gamma2) (τ : H) : ℂ :=
  denominator γ τ ^ (-2 : ℤ)

/-- The chosen scalar is the actual complex-coordinate derivative of the
Möbius deck map, not merely a formally assigned cocycle. -/
theorem deckDerivative_eq_coordinateDeriv (γ : Gamma2) (τ : H) :
    deckDerivative γ τ =
      deriv
        (fun z : ℂ =>
          ((gammaGL γ • UpperHalfPlane.ofComplex z : H) : ℂ))
        (τ : ℂ) := by
  symm
  simpa [deckDerivative, denominator, one_div] using
    (UpperHalfPlane.deriv_smul (g := gammaGL γ)
      (gammaGL_det_pos γ) τ)

@[simp] theorem deckDerivative_one (τ : H) :
    deckDerivative (1 : Gamma2) τ = 1 := by
  simp [deckDerivative]

theorem deckDerivative_mul (γ δ : Gamma2) (τ : H) :
    deckDerivative (γ * δ) τ =
      deckDerivative γ (δ • τ) * deckDerivative δ τ := by
  unfold deckDerivative
  rw [denominator_mul, mul_zpow]

theorem deckDerivative_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (deckDerivative γ) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
    (fun τ : H => (denominator γ τ ^ 2)⁻¹)
  simpa [denominator] using
    (UpperHalfPlane.contMDiff_denom_zpow (gammaGL γ) (-2))

/-- The tangent map of a deck transformation in the complex chart. -/
def deckTangent (γ : Gamma2) (τ : H) : ℂ →L[ℂ] ℂ :=
  deckDerivative γ τ • ContinuousLinearMap.id ℂ ℂ

@[simp] theorem deckTangent_apply
    (γ : Gamma2) (τ : H) (v : ℂ) :
    deckTangent γ τ v = deckDerivative γ τ * v := by
  simp [deckTangent, smul_eq_mul]

theorem deckTangent_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ, ℂ →L[ℂ] ℂ) ∞ (deckTangent γ) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ, ℂ →L[ℂ] ℂ) ∞
    (fun τ : H => deckDerivative γ τ • ContinuousLinearMap.id ℂ ℂ)
  exact (deckDerivative_contMDiff γ).smul contMDiff_const

@[simp] theorem deckTangent_one (τ : H) :
    deckTangent (1 : Gamma2) τ = ContinuousLinearMap.id ℂ ℂ := by
  apply ContinuousLinearMap.ext
  intro v
  simp

theorem deckTangent_mul (γ δ : Gamma2) (τ : H) :
    deckTangent (γ * δ) τ =
      (deckTangent γ (δ • τ)).comp (deckTangent δ τ) := by
  apply ContinuousLinearMap.ext
  intro v
  simp [deckDerivative_mul, mul_assoc]

end DeckCalculusCanonicalNormedSpace

/-- A globally smooth choice of `(cτ+d)⁻¹ᐟ²`.  The square law records the
branch, rather than pretending that half-integral powers are ordinary integer
powers. -/
structure HalfWeightBranch where
  value : Gamma2 → H → ℂˣ
  square :
    ∀ (γ : Gamma2) (τ : H),
      value γ τ ^ 2 = (denominatorUnit γ τ)⁻¹
  one : ∀ τ : H, value 1 τ = 1
  smooth :
    ∀ γ : Gamma2,
      ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun τ : H => (value γ τ : ℂ))

namespace HalfWeightBranch

variable (B : HalfWeightBranch)

theorem value_ne_zero (γ : Gamma2) (τ : H) :
    (B.value γ τ : ℂ) ≠ 0 :=
  (B.value γ τ).ne_zero

theorem square_coe (γ : Gamma2) (τ : H) :
    (B.value γ τ : ℂ) ^ 2 = (denominator γ τ)⁻¹ := by
  have h := congrArg (fun z : ℂˣ => (z : ℂ)) (B.square γ τ)
  simpa using h

/-- The failure of a chosen square-root branch to be multiplicative.  A genuine
half-weight multiplier compensates for exactly this unit. -/
def branchDefect (γ δ : Gamma2) (τ : H) : ℂˣ :=
  B.value γ (δ • τ) * B.value δ τ * (B.value (γ * δ) τ)⁻¹

@[simp] theorem branchDefect_one_left (δ : Gamma2) (τ : H) :
    B.branchDefect 1 δ τ = 1 := by
  simp [branchDefect, B.one]

@[simp] theorem branchDefect_one_right (γ : Gamma2) (τ : H) :
    B.branchDefect γ 1 τ = 1 := by
  simp [branchDefect, B.one]

@[simp] theorem value_one (τ : H) : B.value 1 τ = 1 :=
  B.one τ

end HalfWeightBranch

/-- A weight-one-half multiplier system.  Its cocycle law is stated in the
mathematically correct form: the multiplier cancels the branch defect so that
`ν(γ)(cτ+d)⁻¹ᐟ²` is a genuine automorphy factor. -/
structure MultiplierSystem (B : HalfWeightBranch) where
  nu : Gamma2 → ℂˣ
  nu_one : nu 1 = 1
  cocycle :
    ∀ (γ δ : Gamma2) (τ : H),
      nu (γ * δ) * B.value (γ * δ) τ =
        (nu γ * B.value γ (δ • τ)) *
          (nu δ * B.value δ τ)

namespace MultiplierSystem

variable {B : HalfWeightBranch} (M : MultiplierSystem B)

/-- The complete factor `ν(γ)(cτ+d)⁻¹ᐟ²`. -/
def automorphyFactor (γ : Gamma2) (τ : H) : ℂˣ :=
  M.nu γ * B.value γ τ

@[simp] theorem automorphyFactor_one (τ : H) :
    M.automorphyFactor (1 : Gamma2) τ = 1 := by
  simp [automorphyFactor, M.nu_one]

/-- The exact cocycle needed to iterate equation (6.2). -/
theorem automorphyFactor_mul (γ δ : Gamma2) (τ : H) :
    M.automorphyFactor (γ * δ) τ =
      M.automorphyFactor γ (δ • τ) * M.automorphyFactor δ τ :=
  M.cocycle γ δ τ

/-- Multiplier law isolated from the combined automorphy-factor cocycle.  It
shows explicitly that `nu` cancels the branch defect. -/
theorem nu_mul (γ δ : Gamma2) (τ : H) :
    M.nu (γ * δ) =
      M.nu γ * M.nu δ * B.branchDefect γ δ τ := by
  calc
    M.nu (γ * δ) =
        (M.nu (γ * δ) * B.value (γ * δ) τ) *
          (B.value (γ * δ) τ)⁻¹ := by simp
    _ = ((M.nu γ * B.value γ (δ • τ)) *
          (M.nu δ * B.value δ τ)) *
          (B.value (γ * δ) τ)⁻¹ := by
      rw [M.cocycle]
    _ = M.nu γ * M.nu δ * B.branchDefect γ δ τ := by
      unfold HalfWeightBranch.branchDefect
      ac_rfl

theorem automorphyFactor_ne_zero (γ : Gamma2) (τ : H) :
    (M.automorphyFactor γ τ : ℂ) ≠ 0 :=
  (M.automorphyFactor γ τ).ne_zero

theorem automorphyFactor_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
      (fun τ : H => (M.automorphyFactor γ τ : ℂ)) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
    (fun τ : H => (M.nu γ : ℂ) * (B.value γ τ : ℂ))
  exact contMDiff_const.mul (B.smooth γ)

end MultiplierSystem

/-!
### Assumption-free eta construction of the branch and multiplier

The generic API above is useful for downstream geometry, but the paper also
needs an actual branch/multiplier pair.  We construct one from the nonvanishing
Dedekind eta function.  The ratio

`eta(tau) / eta(gamma * tau)`

is already a genuine cocycle.  Its square differs from `(c*tau+d)^(-1)` by a
twelfth root of unity.  That residual root is continuous, hence constant on
the connected upper half-plane.  Taking one square root of the constant
residual produces `nu`; dividing the eta ratio by `nu` produces the required
smooth half-weight branch.
-/

namespace EtaHalfWeight

/-- Dedekind eta restricted to the upper half-plane. -/
noncomputable def etaValue (τ : H) : ℂ :=
  ModularForm.eta (τ : ℂ)

theorem etaValue_ne_zero (τ : H) : etaValue τ ≠ 0 :=
  ModularForm.eta_ne_zero τ.2

/-- Holomorphy of eta gives the full smoothness required by the manifold API. -/
theorem etaValue_contMDiff :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ etaValue := by
  intro τ
  rw [UpperHalfPlane.contMDiffAt_iff]
  have hDifferentiable :
      DifferentiableOn ℂ ModularForm.eta
        UpperHalfPlane.upperHalfPlaneSet :=
    fun z hz =>
      (ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet hz).differentiableWithinAt
  have hContDiffOn :
      ContDiffOn ℂ ∞ ModularForm.eta
        UpperHalfPlane.upperHalfPlaneSet :=
    hDifferentiable.contDiffOn
      UpperHalfPlane.isOpen_upperHalfPlaneSet
  have hContDiffAt :
      ContDiffAt ℂ ∞ ModularForm.eta (τ : ℂ) :=
    (hContDiffOn (τ : ℂ) τ.2).contDiffAt
      (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds τ.2)
  refine hContDiffAt.congr_of_eventuallyEq ?_
  filter_upwards
      [UpperHalfPlane.eventuallyEq_coe_comp_ofComplex τ.im_pos] with z hz
  change ModularForm.eta ((UpperHalfPlane.ofComplex z : H) : ℂ) =
    ModularForm.eta z
  simpa only [Function.comp_apply, id_eq] using
    congrArg ModularForm.eta hz

/-- The weight-twelve discriminant law, rewritten entirely in the denominator
notation used by equation (6.2). -/
theorem etaValue_pow_twentyFour_smul
    (γ : Gamma2) (τ : H) :
    etaValue (γ • τ) ^ 24 =
      denominator γ τ ^ 12 * etaValue τ ^ 24 := by
  have hmem :
      gammaGL γ ∈
        ((Matrix.SpecialLinearGroup.mapGL ℝ :
          SL(2, ℤ) →* GL (Fin 2) ℝ).range) := by
    exact ⟨γ.1, rfl⟩
  have hDelta :=
    SlashInvariantForm.slash_action_eqn''
      CuspForm.discriminant hmem τ
  have hact : gammaGL γ • τ = γ • τ := gammaGL_smul γ τ
  rw [hact] at hDelta
  simpa [etaValue, ModularForm.discriminant, denominator] using hDelta

/-- The eta quotient with the cocycle orientation used by `lineSmul`. -/
noncomputable def etaRatio (γ : Gamma2) (τ : H) : ℂ :=
  etaValue τ / etaValue (γ • τ)

theorem etaRatio_ne_zero (γ : Gamma2) (τ : H) :
    etaRatio γ τ ≠ 0 :=
  div_ne_zero (etaValue_ne_zero τ) (etaValue_ne_zero (γ • τ))

@[simp] theorem etaRatio_one (τ : H) :
    etaRatio (1 : Gamma2) τ = 1 := by
  simp [etaRatio, etaValue_ne_zero]

/-- The eta quotient is a genuine group cocycle before any branch is chosen. -/
theorem etaRatio_mul (γ δ : Gamma2) (τ : H) :
    etaRatio (γ * δ) τ =
      etaRatio γ (δ • τ) * etaRatio δ τ := by
  simp only [etaRatio, mul_smul]
  field_simp [etaValue_ne_zero] <;> ring

theorem etaRatio_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (etaRatio γ) := by
  exact etaValue_contMDiff.div₀
    (etaValue_contMDiff.comp (deckAction_contMDiff γ))
    (fun τ => etaValue_ne_zero (γ • τ))

/-- Unit-valued form of the eta cocycle. -/
noncomputable def etaRatioUnit (γ : Gamma2) (τ : H) : ℂˣ :=
  Units.mk0 (etaRatio γ τ) (etaRatio_ne_zero γ τ)

@[simp] theorem etaRatioUnit_val (γ : Gamma2) (τ : H) :
    ((etaRatioUnit γ τ : ℂˣ) : ℂ) = etaRatio γ τ :=
  rfl

@[simp] theorem etaRatioUnit_one (τ : H) :
    etaRatioUnit (1 : Gamma2) τ = 1 := by
  apply Units.ext
  simp

theorem etaRatioUnit_mul (γ δ : Gamma2) (τ : H) :
    etaRatioUnit (γ * δ) τ =
      etaRatioUnit γ (δ • τ) * etaRatioUnit δ τ := by
  apply Units.ext
  exact etaRatio_mul γ δ τ

/-- The residual between the squared eta cocycle and the weight-one
denominator. -/
noncomputable def etaResidual (γ : Gamma2) (τ : H) : ℂ :=
  etaRatio γ τ ^ 2 * denominator γ τ

theorem etaResidual_ne_zero (γ : Gamma2) (τ : H) :
    etaResidual γ τ ≠ 0 :=
  mul_ne_zero (pow_ne_zero 2 (etaRatio_ne_zero γ τ))
    (denominator_ne_zero γ τ)

theorem etaRatio_pow_twentyFour_mul_denominator_pow_twelve
    (γ : Gamma2) (τ : H) :
    etaRatio γ τ ^ 24 * denominator γ τ ^ 12 = 1 := by
  rw [etaRatio, div_pow, etaValue_pow_twentyFour_smul]
  field_simp [etaValue_ne_zero, denominator_ne_zero] <;> ring

/-- The residual is pointwise a twelfth root of unity. -/
theorem etaResidual_pow_twelve (γ : Gamma2) (τ : H) :
    etaResidual γ τ ^ 12 = 1 := by
  calc
    etaResidual γ τ ^ 12 =
        etaRatio γ τ ^ (2 * 12) * denominator γ τ ^ 12 := by
      rw [etaResidual, mul_pow, pow_mul]
    _ = etaRatio γ τ ^ 24 * denominator γ τ ^ 12 := by norm_num
    _ = 1 := etaRatio_pow_twentyFour_mul_denominator_pow_twelve γ τ

@[simp] theorem etaResidual_one (τ : H) :
    etaResidual (1 : Gamma2) τ = 1 := by
  simp [etaResidual]

theorem etaResidual_continuous (γ : Gamma2) :
    Continuous (etaResidual γ) := by
  change Continuous (fun τ : H =>
    etaRatio γ τ ^ 2 *
      UpperHalfPlane.denom (gammaGL γ) (τ : ℂ))
  exact ((etaRatio_contMDiff γ).continuous.pow 2).mul
    (UpperHalfPlane.contMDiff_denom (n := ∞) (gammaGL γ)).continuous

/-- Unit-valued residual, used to enter Mathlib's finite roots-of-unity type. -/
noncomputable def etaResidualUnit (γ : Gamma2) (τ : H) : ℂˣ :=
  Units.mk0 (etaResidual γ τ) (etaResidual_ne_zero γ τ)

@[simp] theorem etaResidualUnit_val (γ : Gamma2) (τ : H) :
    ((etaResidualUnit γ τ : ℂˣ) : ℂ) = etaResidual γ τ :=
  rfl

theorem etaResidualUnit_eq_ratio_sq_mul_denominator
    (γ : Gamma2) (τ : H) :
    etaResidualUnit γ τ =
      etaRatioUnit γ τ ^ 2 * denominatorUnit γ τ := by
  apply Units.ext
  rfl

theorem etaResidualUnit_pow_twelve (γ : Gamma2) (τ : H) :
    etaResidualUnit γ τ ^ 12 = 1 := by
  apply Units.ext
  exact etaResidual_pow_twelve γ τ

theorem etaResidualUnit_continuous (γ : Gamma2) :
    Continuous (etaResidualUnit γ) := by
  apply Units.continuous_iff.mpr
  constructor
  · change Continuous (etaResidual γ)
    exact etaResidual_continuous γ
  · change Continuous (fun τ => (etaResidual γ τ)⁻¹)
    exact (etaResidual_continuous γ).inv₀
      (etaResidual_ne_zero γ)

/-- The residual bundled as an element of the finite type of twelfth roots. -/
noncomputable def etaResidualRoot (γ : Gamma2) (τ : H) :
    rootsOfUnity 12 ℂ :=
  ⟨etaResidualUnit γ τ, etaResidualUnit_pow_twelve γ τ⟩

theorem etaResidualRoot_continuous (γ : Gamma2) :
    Continuous (etaResidualRoot γ) := by
  change Continuous (fun τ : H =>
    (⟨etaResidualUnit γ τ, etaResidualUnit_pow_twelve γ τ⟩ :
      rootsOfUnity 12 ℂ))
  exact (etaResidualUnit_continuous γ).subtype_mk
    (fun τ => etaResidualUnit_pow_twelve γ τ)

theorem etaResidualRoot_isLocallyConstant (γ : Gamma2) :
    IsLocallyConstant (etaResidualRoot γ) :=
  (IsLocallyConstant.iff_continuous (etaResidualRoot γ)).mpr
    (etaResidualRoot_continuous γ)

/-- Connectedness of the upper half-plane forces the finite residual root to
be independent of `tau`. -/
theorem etaResidual_eq_base (γ : Gamma2) (τ : H) :
    etaResidual γ τ = etaResidual γ UpperHalfPlane.I := by
  have hRoot :=
    (etaResidualRoot_isLocallyConstant γ).apply_eq_of_preconnectedSpace
      τ UpperHalfPlane.I
  have hCoe := congrArg
    (fun z : rootsOfUnity 12 ℂ => (((z : ℂˣ) : ℂ))) hRoot
  simpa [etaResidualRoot, etaResidualUnit] using hCoe

/-- The residual is smooth because connectedness makes it constant. -/
theorem etaResidual_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (etaResidual γ) := by
  have hfun : etaResidual γ =
      fun _ : H => etaResidual γ UpperHalfPlane.I := by
    funext τ
    exact etaResidual_eq_base γ τ
  rw [hfun]
  exact contMDiff_const

theorem etaResidualUnit_eq_base (γ : Gamma2) (τ : H) :
    etaResidualUnit γ τ = etaResidualUnit γ UpperHalfPlane.I := by
  apply Units.ext
  exact etaResidual_eq_base γ τ

/-- The chosen square root of the constant residual really squares to it. -/
theorem sqrt_etaResidual_sq (γ : Gamma2) :
    Complex.sqrt (etaResidual γ UpperHalfPlane.I) ^ 2 =
      etaResidual γ UpperHalfPlane.I := by
  simpa [Complex.sqrt] using
    (Complex.cpow_nat_inv_pow (etaResidual γ UpperHalfPlane.I)
      (by norm_num : (2 : ℕ) ≠ 0))

theorem sqrt_etaResidual_ne_zero (γ : Gamma2) :
    Complex.sqrt (etaResidual γ UpperHalfPlane.I) ≠ 0 := by
  intro hZero
  have hSquare := sqrt_etaResidual_sq γ
  rw [hZero, zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hSquare
  exact etaResidual_ne_zero γ UpperHalfPlane.I hSquare.symm

/-- Constant eta multiplier extracted from the residual at the base point `I`. -/
noncomputable def etaNu (γ : Gamma2) : ℂˣ :=
  Units.mk0 (Complex.sqrt (etaResidual γ UpperHalfPlane.I))
    (sqrt_etaResidual_ne_zero γ)

@[simp] theorem etaNu_one : etaNu (1 : Gamma2) = 1 := by
  apply Units.ext
  simp [etaNu]

theorem etaNu_square (γ : Gamma2) :
    etaNu γ ^ 2 = etaResidualUnit γ UpperHalfPlane.I := by
  apply Units.ext
  exact sqrt_etaResidual_sq γ

/-- The smooth square-root branch obtained by removing the constant multiplier
from the eta cocycle. -/
noncomputable def etaBranchValue (γ : Gamma2) (τ : H) : ℂˣ :=
  etaRatioUnit γ τ * (etaNu γ)⁻¹

@[simp] theorem etaBranchValue_one (τ : H) :
    etaBranchValue (1 : Gamma2) τ = 1 := by
  simp [etaBranchValue]

theorem etaBranchValue_square (γ : Gamma2) (τ : H) :
    etaBranchValue γ τ ^ 2 = (denominatorUnit γ τ)⁻¹ := by
  calc
    etaBranchValue γ τ ^ 2 =
        etaRatioUnit γ τ ^ 2 * ((etaNu γ)⁻¹) ^ 2 := by
      rw [etaBranchValue, mul_pow]
    _ = etaRatioUnit γ τ ^ 2 * (etaNu γ ^ 2)⁻¹ := by
      rw [inv_pow]
    _ = etaRatioUnit γ τ ^ 2 *
        (etaResidualUnit γ UpperHalfPlane.I)⁻¹ := by
      rw [etaNu_square]
    _ = etaRatioUnit γ τ ^ 2 * (etaResidualUnit γ τ)⁻¹ := by
      rw [etaResidualUnit_eq_base γ τ]
    _ = etaRatioUnit γ τ ^ 2 *
        (etaRatioUnit γ τ ^ 2 * denominatorUnit γ τ)⁻¹ := by
      rw [etaResidualUnit_eq_ratio_sq_mul_denominator]
    _ = (denominatorUnit γ τ)⁻¹ *
        (etaRatioUnit γ τ ^ 2 * (etaRatioUnit γ τ ^ 2)⁻¹) := by
      rw [_root_.mul_inv_rev]
      ac_rfl
    _ = (denominatorUnit γ τ)⁻¹ := by simp

theorem etaBranchValue_contMDiff (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
      (fun τ : H => (etaBranchValue γ τ : ℂ)) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
    (fun τ : H => etaRatio γ τ * ((etaNu γ : ℂˣ) : ℂ)⁻¹)
  exact (etaRatio_contMDiff γ).mul contMDiff_const

/-- A concrete globally smooth half-weight branch with no input hypotheses. -/
noncomputable def branch : HalfWeightBranch where
  value := etaBranchValue
  square := etaBranchValue_square
  one := etaBranchValue_one
  smooth := etaBranchValue_contMDiff

theorem etaNu_mul_branchValue (γ : Gamma2) (τ : H) :
    etaNu γ * branch.value γ τ = etaRatioUnit γ τ := by
  change etaNu γ * (etaRatioUnit γ τ * (etaNu γ)⁻¹) =
    etaRatioUnit γ τ
  calc
    etaNu γ * (etaRatioUnit γ τ * (etaNu γ)⁻¹) =
        etaRatioUnit γ τ * (etaNu γ * (etaNu γ)⁻¹) := by ac_rfl
    _ = etaRatioUnit γ τ := by simp

/-- The corresponding eta multiplier system.  Its cocycle proof is exactly the
already-proved eta-ratio cocycle. -/
noncomputable def multiplier : MultiplierSystem branch where
  nu := etaNu
  nu_one := etaNu_one
  cocycle := by
    intro γ δ τ
    simpa only [etaNu_mul_branchValue] using etaRatioUnit_mul γ δ τ

@[simp] theorem multiplier_automorphyFactor (γ : Gamma2) (τ : H) :
    multiplier.automorphyFactor γ τ = etaRatioUnit γ τ :=
  etaNu_mul_branchValue γ τ

theorem multiplier_automorphyFactor_ne_zero (γ : Gamma2) (τ : H) :
    (multiplier.automorphyFactor γ τ : ℂ) ≠ 0 :=
  (multiplier.automorphyFactor γ τ).ne_zero

theorem branch_multiplier_exists :
    ∃ B : HalfWeightBranch, Nonempty (MultiplierSystem B) :=
  ⟨branch, ⟨multiplier⟩⟩

/-- PR-facing certificate for the formerly implicit branch/multiplier
existence layer. -/
structure ConstructionCertificate : Prop where
  eta_nonvanishing : ∀ τ : H, etaValue τ ≠ 0
  eta_cocycle :
    ∀ (γ δ : Gamma2) (τ : H),
      etaRatioUnit (γ * δ) τ =
        etaRatioUnit γ (δ • τ) * etaRatioUnit δ τ
  residual_is_twelfth_root :
    ∀ (γ : Gamma2) (τ : H), etaResidual γ τ ^ 12 = 1
  residual_is_constant :
    ∀ (γ : Gamma2) (τ : H),
      etaResidual γ τ = etaResidual γ UpperHalfPlane.I
  branch_square :
    ∀ (γ : Gamma2) (τ : H),
      branch.value γ τ ^ 2 = (denominatorUnit γ τ)⁻¹
  branch_normalized : ∀ τ : H, branch.value 1 τ = 1
  branch_smooth :
    ∀ γ : Gamma2,
      ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun τ : H => (branch.value γ τ : ℂ))
  multiplier_normalized : multiplier.nu 1 = 1
  multiplier_cocycle :
    ∀ (γ δ : Gamma2) (τ : H),
      multiplier.nu (γ * δ) * branch.value (γ * δ) τ =
        (multiplier.nu γ * branch.value γ (δ • τ)) *
          (multiplier.nu δ * branch.value δ τ)
  automorphy_is_eta_ratio :
    ∀ (γ : Gamma2) (τ : H),
      multiplier.automorphyFactor γ τ = etaRatioUnit γ τ
  existence : ∃ B : HalfWeightBranch, Nonempty (MultiplierSystem B)

noncomputable def constructionCertificate : ConstructionCertificate where
  eta_nonvanishing := etaValue_ne_zero
  eta_cocycle := etaRatioUnit_mul
  residual_is_twelfth_root := etaResidual_pow_twelve
  residual_is_constant := etaResidual_eq_base
  branch_square := branch.square
  branch_normalized := branch.one
  branch_smooth := branch.smooth
  multiplier_normalized := multiplier.nu_one
  multiplier_cocycle := multiplier.cocycle
  automorphy_is_eta_ratio := multiplier_automorphyFactor
  existence := branch_multiplier_exists

end EtaHalfWeight

/-- The associated action on `ℍ × ℂ` defining `L_(1/2,ν)`. -/
def lineSmul {B : HalfWeightBranch} (M : MultiplierSystem B)
    (γ : Gamma2) (p : H × ℂ) : H × ℂ :=
  (γ • p.1, (M.automorphyFactor γ p.1 : ℂ) * p.2)

@[simp] theorem lineSmul_fst {B : HalfWeightBranch}
    (M : MultiplierSystem B) (γ : Gamma2) (p : H × ℂ) :
    (lineSmul M γ p).1 = γ • p.1 :=
  rfl

@[simp] theorem lineSmul_snd {B : HalfWeightBranch}
    (M : MultiplierSystem B) (γ : Gamma2) (p : H × ℂ) :
    (lineSmul M γ p).2 = (M.automorphyFactor γ p.1 : ℂ) * p.2 :=
  rfl

/-- Each automorphic line action map is smooth. -/
theorem lineSmul_contMDiff {B : HalfWeightBranch}
    (M : MultiplierSystem B) (γ : Gamma2) :
    ContMDiff ((𝓘(ℂ)).prod (𝓘(ℂ))) ((𝓘(ℂ)).prod (𝓘(ℂ))) ∞
      (lineSmul M γ) := by
  change ContMDiff ((𝓘(ℂ)).prod (𝓘(ℂ)))
    ((𝓘(ℂ)).prod (𝓘(ℂ))) ∞
      (fun p : H × ℂ =>
        (γ • p.1, (M.automorphyFactor γ p.1 : ℂ) * p.2))
  exact (((deckAction_contMDiff γ).comp contMDiff_fst).prodMk
    (((M.automorphyFactor_contMDiff γ).comp contMDiff_fst).mul
      contMDiff_snd))

@[simp] theorem lineSmul_one {B : HalfWeightBranch}
    (M : MultiplierSystem B) (p : H × ℂ) :
    lineSmul M 1 p = p := by
  ext <;> simp [lineSmul]

theorem lineSmul_mul {B : HalfWeightBranch}
    (M : MultiplierSystem B) (γ δ : Gamma2) (p : H × ℂ) :
    lineSmul M (γ * δ) p = lineSmul M γ (lineSmul M δ p) := by
  ext <;> simp [lineSmul, MultiplierSystem.automorphyFactor_mul,
    mul_smul, mul_assoc]

/-- The genuine group action whose orbit quotient is the automorphic line
bundle presentation. -/
def lineMulAction {B : HalfWeightBranch} (M : MultiplierSystem B) :
    MulAction Gamma2 (H × ℂ) where
  smul := lineSmul M
  one_smul := lineSmul_one M
  mul_smul := lineSmul_mul M

/-- Orbit relation for the associated line-bundle action. -/
def lineOrbitRel {B : HalfWeightBranch} (M : MultiplierSystem B) :
    Setoid (H × ℂ) := by
  letI : MulAction Gamma2 (H × ℂ) := lineMulAction M
  exact MulAction.orbitRel Gamma2 (H × ℂ)

/-- Total space of the quotient presentation of `L_(1/2,ν)`. -/
def AutomorphicLineBundleTotal {B : HalfWeightBranch}
    (M : MultiplierSystem B) : Type :=
  Quotient (lineOrbitRel M)

/-- Quotient map into the automorphic line-bundle total space. -/
def lineBundleMk {B : HalfWeightBranch} (M : MultiplierSystem B)
    (p : H × ℂ) : AutomorphicLineBundleTotal M :=
  Quotient.mk (lineOrbitRel M) p

/-- The quotient chart identifies exactly the points in one automorphic orbit. -/
@[simp] theorem lineBundleMk_lineSmul {B : HalfWeightBranch}
    (M : MultiplierSystem B) (γ : Gamma2) (p : H × ℂ) :
    lineBundleMk M (lineSmul M γ p) = lineBundleMk M p := by
  letI : MulAction Gamma2 (H × ℂ) := lineMulAction M
  apply Quotient.sound
  change lineSmul M γ p ∈ MulAction.orbit Gamma2 p
  exact ⟨γ, rfl⟩

/-- Projection of the associated quotient to `X = Γ(2) \ ℍ`. -/
def lineBundleProjection {B : HalfWeightBranch}
    (M : MultiplierSystem B) : AutomorphicLineBundleTotal M → X := by
  letI : MulAction Gamma2 (H × ℂ) := lineMulAction M
  refine Quotient.lift (fun p : H × ℂ => quotientMap p.1) ?_
  intro p q hpq
  change p ∈ MulAction.orbit Gamma2 q at hpq
  rcases hpq with ⟨γ, hγ⟩
  rw [← hγ]
  exact quotientMap_smul γ q.1

@[simp] theorem lineBundleProjection_mk {B : HalfWeightBranch}
    (M : MultiplierSystem B) (p : H × ℂ) :
    lineBundleProjection M (lineBundleMk M p) = quotientMap p.1 :=
  rfl

/-- Every base orbit has a point in the zero section of the quotient
presentation. -/
theorem lineBundleProjection_surjective {B : HalfWeightBranch}
    (M : MultiplierSystem B) :
    Function.Surjective (lineBundleProjection M) := by
  intro x
  refine Quotient.inductionOn x ?_
  intro τ
  exact ⟨lineBundleMk M (τ, 0), rfl⟩

/-- A bundle presentation records the exact total quotient, projection, and
quotient chart used by descent. -/
structure AutomorphicLineBundle where
  Total : Type
  projection : Total → X
  quotientChart : H × ℂ → Total
  projection_quotientChart :
    ∀ p : H × ℂ, projection (quotientChart p) = quotientMap p.1

/-- The automorphic line bundle `L_(1/2,ν)` in associated-quotient form. -/
def LHalfNu {B : HalfWeightBranch} (M : MultiplierSystem B) :
    AutomorphicLineBundle where
  Total := AutomorphicLineBundleTotal M
  projection := lineBundleProjection M
  quotientChart := lineBundleMk M
  projection_quotientChart := lineBundleProjection_mk M

/-- Fibre of the quotient presentation over a point of `X`. -/
def AutomorphicLineBundle.Fibre (L : AutomorphicLineBundle) (x : X) :=
  {z : L.Total // L.projection z = x}

/-! ### Complex Lie groups and smooth Lie-algebra-valued one-forms -/

section GaugeForms

universe uEG uHG uGG

variable {E_G : Type uEG} {H_G : Type uHG}
variable [NormedAddCommGroup E_G] [NormedSpace ℂ E_G] [CompleteSpace E_G]
variable [TopologicalSpace H_G]
variable (I_G : ModelWithCorners ℂ E_G H_G)
variable (G : Type uGG) [Group G] [TopologicalSpace G] [ChartedSpace H_G G]
variable [IsManifold I_G ∞ G] [LieGroup I_G ∞ G]

noncomputable local instance gaugeLieGroupMinSmoothness :
    LieGroup I_G (minSmoothness ℂ 3) G := by
  simpa using (inferInstance : LieGroup I_G (3 : ℕ∞ω) G)

/-- The Lie algebra `𝔤 = T₁G` of the selected complex Lie group. -/
abbrev GaugeLieAlgebra := GroupLieAlgebra I_G G

/-- The inferred Mathlib Lie-algebra structure on `T₁G`, exposed as named
data for auditing. -/
noncomputable def gaugeLieAlgebraStructure :
    LieAlgebra ℂ (GaugeLieAlgebra I_G G) :=
  inferInstance

/- `TangentSpace` hides the model-space norm from typeclass inference.
Transport the fixed chart-model structures locally without changing the API. -/
noncomputable local instance gaugeLieAlgebraNormedAddCommGroup :
    NormedAddCommGroup (GaugeLieAlgebra I_G G) := by
  change NormedAddCommGroup E_G
  infer_instance

noncomputable local instance gaugeLieAlgebraNormedSpace :
    NormedSpace ℂ (GaugeLieAlgebra I_G G) := by
  change NormedSpace ℂ E_G
  infer_instance

/-- Value of a `𝔤`-valued one-form in the complex chart of `ℍ`.
The public parameters are retained, while the representation is exposed as
its actual chart model so Mathlib can infer the canonical CLM structures. -/
abbrev OneFormValue
    (_I_G : ModelWithCorners ℂ E_G H_G) (_G : Type uGG) :=
  ℂ →L[ℂ] E_G

/-- Smooth `𝔤`-valued one-forms on the actual open submanifold `π⁻¹(U)`. -/
structure SmoothOneForm (U : Opens) where
  toFun : coverOpen U → OneFormValue I_G G
  smooth_toFun :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞ toFun

namespace SmoothOneForm

instance (U : Opens) : CoeFun (SmoothOneForm I_G G U)
    (fun _ => coverOpen U → OneFormValue I_G G) :=
  ⟨SmoothOneForm.toFun⟩

@[ext] theorem ext {U : Opens} {A B : SmoothOneForm I_G G U}
    (h : A.toFun = B.toFun) : A = B := by
  cases A
  cases B
  cases h
  rfl

theorem ext_pointwise {U : Opens} {A B : SmoothOneForm I_G G U}
    (h : ∀ τ : coverOpen U, A τ = B τ) : A = B :=
  SmoothOneForm.ext (I_G := I_G) (G := G) (funext h)

/-- The smooth zero one-form. -/
noncomputable def zero (U : Opens) : SmoothOneForm I_G G U where
  toFun := fun _ => 0
  smooth_toFun := by
    exact (contMDiff_const :
      ContMDiff 𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞
        (fun _ : coverOpen U => (0 : OneFormValue I_G G)))

@[simp] theorem zero_apply (U : Opens) (τ : coverOpen U) :
    zero I_G G U τ = 0 := by
  simp [zero]

/-- Inclusion `π⁻¹(V) ↪ π⁻¹(U)` for `V ⊆ U`. -/
def coverInclusion {V U : Opens} (hVU : V ≤ U) :
    coverOpen V → coverOpen U :=
  TopologicalSpace.Opens.inclusion (coverOpen_mono hVU)

@[simp] theorem coverInclusion_val {V U : Opens} (hVU : V ≤ U)
    (τ : coverOpen V) :
    ((coverInclusion hVU τ : coverOpen U) : H) = (τ : H) :=
  rfl

theorem coverInclusion_contMDiff {V U : Opens} (hVU : V ≤ U) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (coverInclusion hVU) :=
  contMDiff_inclusion (I := 𝓘(ℂ)) (coverOpen_mono hVU)

/-- Ordinary restriction of a smooth one-form. -/
noncomputable def restrict {V U : Opens} (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U) : SmoothOneForm I_G G V where
  toFun := A.toFun ∘ coverInclusion hVU
  smooth_toFun := A.smooth_toFun.comp (coverInclusion_contMDiff hVU)

@[simp] theorem restrict_apply {V U : Opens} (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U) (τ : coverOpen V) :
    restrict I_G G hVU A τ = A (coverInclusion hVU τ) :=
  rfl

@[simp] theorem restrict_id (U : Opens) (A : SmoothOneForm I_G G U) :
    restrict I_G G (le_refl U) A = A := by
  apply ext_pointwise
  intro τ
  rfl

theorem restrict_comp {W V U : Opens} (hWV : W ≤ V) (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U) :
    restrict I_G G hWV (restrict I_G G hVU A) =
      restrict I_G G (le_trans hWV hVU) A := by
  apply ext_pointwise
  intro τ
  rfl

end SmoothOneForm

/-- The deck action on the pulled-back open `π⁻¹(U)`. -/
def coverDeckMap (γ : Gamma2) (U : Opens) : coverOpen U → coverOpen U :=
  fun τ => ⟨γ • (τ : H), (smul_mem_coverOpen_iff U γ τ).mpr τ.2⟩

@[simp] theorem coverDeckMap_val (γ : Gamma2) (U : Opens)
    (τ : coverOpen U) :
    ((coverDeckMap γ U τ : coverOpen U) : H) = γ • (τ : H) :=
  rfl

@[simp] theorem coverDeckMap_one (U : Opens) (τ : coverOpen U) :
    coverDeckMap 1 U τ = τ := by
  apply Subtype.ext
  simp

theorem coverDeckMap_mul (γ δ : Gamma2) (U : Opens)
    (τ : coverOpen U) :
    coverDeckMap (γ * δ) U τ =
      coverDeckMap γ U (coverDeckMap δ U τ) := by
  apply Subtype.ext
  exact mul_smul γ δ (τ : H)

/-- Deck transformations commute with the inclusion
`π⁻¹(V) ↪ π⁻¹(U)`. -/
@[simp] theorem coverInclusion_coverDeckMap
    {V U : Opens} (hVU : V ≤ U) (γ : Gamma2) (τ : coverOpen V) :
    SmoothOneForm.coverInclusion hVU (coverDeckMap γ V τ) =
      coverDeckMap γ U (SmoothOneForm.coverInclusion hVU τ) := by
  apply Subtype.ext
  rfl

/-- Smoothness of the restricted deck map. -/
theorem coverDeckMap_contMDiff (γ : Gamma2) (U : Opens) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (coverDeckMap γ U) := by
  rw [← ContMDiff.subtypeVal_comp_iff]
  simpa [Function.comp_def, coverDeckMap] using
    ((deckAction_contMDiff γ).comp
      (contMDiff_subtype_val (I := 𝓘(ℂ))))

/-- Tangent map of a deck transformation, restricted to `π⁻¹(U)`. -/
def deckTangentOn (γ : Gamma2) (U : Opens) :
    coverOpen U → ℂ →L[ℂ] ℂ :=
  fun τ => deckTangent γ τ

theorem deckTangentOn_contMDiff (γ : Gamma2) (U : Opens) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ, ℂ →L[ℂ] ℂ) ∞ (deckTangentOn γ U) :=
  (deckTangent_contMDiff γ).comp
    (contMDiff_subtype_val (I := 𝓘(ℂ)))

/-- The usual pullback `γ* A`: evaluate at `γτ` and precompose with the
Möbius tangent map `(cτ+d)⁻²`. -/
def deckPullback (γ : Gamma2) (U : Opens)
    (A : SmoothOneForm I_G G U) : SmoothOneForm I_G G U where
  toFun := fun τ =>
    (A (coverDeckMap γ U τ)).comp (deckTangentOn γ U τ)
  smooth_toFun :=
    (A.smooth_toFun.comp (coverDeckMap_contMDiff γ U)).clm_comp
      (deckTangentOn_contMDiff γ U)

@[simp] theorem deckPullback_apply (γ : Gamma2) (U : Opens)
    (A : SmoothOneForm I_G G U) (τ : coverOpen U) (v : ℂ) :
    deckPullback I_G G γ U A τ v =
      A (coverDeckMap γ U τ) (deckDerivative γ τ * v) := by
  rfl

@[simp] theorem deckPullback_one (U : Opens)
    (A : SmoothOneForm I_G G U) :
    deckPullback I_G G 1 U A = A := by
  apply SmoothOneForm.ext_pointwise
  intro τ
  apply ContinuousLinearMap.ext
  intro v
  simp

/-- Pullback is contravariantly functorial. -/
theorem deckPullback_mul (γ δ : Gamma2) (U : Opens)
    (A : SmoothOneForm I_G G U) :
    deckPullback I_G G (γ * δ) U A =
      deckPullback I_G G δ U (deckPullback I_G G γ U A) := by
  apply SmoothOneForm.ext_pointwise
  intro τ
  apply ContinuousLinearMap.ext
  intro v
  simp [deckPullback_apply, coverDeckMap_mul, deckDerivative_mul,
    mul_assoc]

/-- Pullback commutes strictly with restriction. -/
theorem deckPullback_restrict {V U : Opens} (hVU : V ≤ U)
    (γ : Gamma2) (A : SmoothOneForm I_G G U) :
    SmoothOneForm.restrict I_G G hVU
        (deckPullback I_G G γ U A) =
      deckPullback I_G G γ V
        (SmoothOneForm.restrict I_G G hVU A) := by
  apply SmoothOneForm.ext_pointwise
  intro τ
  apply ContinuousLinearMap.ext
  intro v
  rfl

/-- Pointwise form of pullback/restriction commutation. -/
theorem deckPullback_restrict_apply
    {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
    (A : SmoothOneForm I_G G U) (τ : coverOpen V) :
    deckPullback I_G G γ V
        (SmoothOneForm.restrict I_G G hVU A) τ =
      deckPullback I_G G γ U A
        (SmoothOneForm.coverInclusion hVU τ) := by
  simpa using congrArg
    (fun C : SmoothOneForm I_G G V => C τ)
    (deckPullback_restrict I_G G hVU γ A).symm

/-! ### Equation (6.2), descent, and the concrete covariance predicate -/

variable {B : HalfWeightBranch} (M : MultiplierSystem B)

/-- Equation (6.2) itself, with no uninterpreted covariance predicate:
`γ* A_tilde = ν(γ)(cτ+d)⁻¹ᐟ² A_tilde` on `π⁻¹(U)`. -/
def Equation62 (U : Opens) (A : SmoothOneForm I_G G U) : Prop :=
  ∀ (γ : Gamma2) (τ : coverOpen U),
    deckPullback I_G G γ U A τ =
      (M.automorphyFactor γ (τ : H) : ℂ) • A τ

/-- Paper-facing name for the exact modular covariance condition. -/
def Covariant (U : Opens) (A : SmoothOneForm I_G G U) : Prop :=
  Equation62 I_G G M U A

theorem covariant_iff_equation62 (U : Opens)
    (A : SmoothOneForm I_G G U) :
    Covariant I_G G M U A ↔
      ∀ (γ : Gamma2) (τ : coverOpen U),
        deckPullback I_G G γ U A τ =
          (M.automorphyFactor γ (τ : H) : ℂ) • A τ :=
  Iff.rfl

/-- Vectorwise expansion of (6.2).  This exposes both the evaluation point
`gamma*tau` and the tangent factor `(c*tau+d)^(-2)`. -/
theorem equation62_iff_pointwise (U : Opens)
    (A : SmoothOneForm I_G G U) :
    Equation62 I_G G M U A ↔
      ∀ (γ : Gamma2) (τ : coverOpen U) (v : ℂ),
        A (coverDeckMap γ U τ) (deckDerivative γ τ * v) =
          (M.automorphyFactor γ (τ : H) : ℂ) • A τ v := by
  constructor
  · intro hA γ τ v
    simpa using congrArg
      (fun L : OneFormValue I_G G => L v) (hA γ τ)
  · intro hA γ τ
    apply ContinuousLinearMap.ext
    intro v
    simpa using hA γ τ v

/-- The zero form is an unconditional covariant section. -/
theorem zero_covariant (U : Opens) :
    Covariant I_G G M U (SmoothOneForm.zero I_G G U) := by
  intro γ τ
  apply ContinuousLinearMap.ext
  intro v
  simp

/-- The equation for a product deck transformation carries precisely the
product factor dictated by the multiplier cocycle. -/
theorem equation62_mul_consistent (U : Opens)
    (A : SmoothOneForm I_G G U)
    (hA : Equation62 I_G G M U A)
    (γ δ : Gamma2) (τ : coverOpen U) :
    deckPullback I_G G (γ * δ) U A τ =
      ((M.automorphyFactor γ (δ • (τ : H)) *
          M.automorphyFactor δ (τ : H) : ℂˣ) : ℂ) • A τ := by
  calc
    deckPullback I_G G (γ * δ) U A τ =
        (M.automorphyFactor (γ * δ) (τ : H) : ℂ) • A τ :=
      hA (γ * δ) τ
    _ = ((M.automorphyFactor γ (δ • (τ : H)) *
          M.automorphyFactor δ (τ : H) : ℂˣ) : ℂ) • A τ := by
      rw [M.automorphyFactor_mul]

/-- The left side of (6.2), after restriction to `π⁻¹(V)`. -/
theorem equation62_lhs_restrict
    {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
    (A : SmoothOneForm I_G G U) (τ : coverOpen V) :
    deckPullback I_G G γ V
        (SmoothOneForm.restrict I_G G hVU A) τ =
      deckPullback I_G G γ U A
        (SmoothOneForm.coverInclusion hVU τ) :=
  deckPullback_restrict_apply I_G G hVU γ A τ

/-- The right side of (6.2), after restriction to `π⁻¹(V)`. -/
theorem equation62_rhs_restrict
    {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
    (A : SmoothOneForm I_G G U) (τ : coverOpen V) :
    (M.automorphyFactor γ
        (SmoothOneForm.coverInclusion hVU τ : H) : ℂ) •
        A (SmoothOneForm.coverInclusion hVU τ) =
      (M.automorphyFactor γ (τ : H) : ℂ) •
        SmoothOneForm.restrict I_G G hVU A τ :=
  rfl

/-- Equation (6.2) survives ordinary restriction.  Both sides are reduced to
their values at the canonical inclusion `π⁻¹(V) ↪ π⁻¹(U)`; no restriction
stability hypothesis is used. -/
theorem equation62_restrict {V U : Opens} (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U)
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M V
      (SmoothOneForm.restrict I_G G hVU A) := by
  intro γ τ
  calc
    deckPullback I_G G γ V
        (SmoothOneForm.restrict I_G G hVU A) τ =
      deckPullback I_G G γ U A
        (SmoothOneForm.coverInclusion hVU τ) :=
      equation62_lhs_restrict I_G G hVU γ A τ
    _ = (M.automorphyFactor γ
          (SmoothOneForm.coverInclusion hVU τ : H) : ℂ) •
        A (SmoothOneForm.coverInclusion hVU τ) :=
      hA γ (SmoothOneForm.coverInclusion hVU τ)
    _ = (M.automorphyFactor γ (τ : H) : ℂ) •
        SmoothOneForm.restrict I_G G hVU A τ :=
      equation62_rhs_restrict I_G G M hVU γ A τ

/-- Smooth quotient forms twisted by `L_(1/2,ν)`, defined by their exact
descent datum on the cover. -/
structure QuotientTwistedOneForm (U : Opens) where
  lift : SmoothOneForm I_G G U
  descent : Equation62 I_G G M U lift

namespace QuotientTwistedOneForm

@[ext] theorem ext {U : Opens}
    {A C : QuotientTwistedOneForm I_G G M U}
    (h : A.lift = C.lift) : A = C := by
  cases A
  cases C
  cases h
  rfl

/-- Restriction of quotient descent data. -/
noncomputable def restrict {V U : Opens} (hVU : V ≤ U)
    (A : QuotientTwistedOneForm I_G G M U) :
    QuotientTwistedOneForm I_G G M V where
  lift := SmoothOneForm.restrict I_G G hVU A.lift
  descent := equation62_restrict I_G G M hVU A.lift A.descent

@[simp] theorem restrict_lift {V U : Opens} (hVU : V ≤ U)
    (A : QuotientTwistedOneForm I_G G M U) :
    (restrict I_G G M hVU A).lift =
      SmoothOneForm.restrict I_G G hVU A.lift :=
  rfl

@[simp] theorem restrict_id (U : Opens)
    (A : QuotientTwistedOneForm I_G G M U) :
    restrict I_G G M (le_refl U) A = A := by
  apply ext
  exact SmoothOneForm.restrict_id I_G G U A.lift

theorem restrict_comp {W V U : Opens} (hWV : W ≤ V) (hVU : V ≤ U)
    (A : QuotientTwistedOneForm I_G G M U) :
    restrict I_G G M hWV (restrict I_G G M hVU A) =
      restrict I_G G M (le_trans hWV hVU) A := by
  apply ext
  exact SmoothOneForm.restrict_comp I_G G hWV hVU A.lift

end QuotientTwistedOneForm

/-- Covariant lifted forms as a subtype. -/
def CovariantLift (U : Opens) :=
  {A : SmoothOneForm I_G G U // Equation62 I_G G M U A}

/-- Smooth quotient forms and covariant lifted forms are equivalent by descent. -/
def descentEquiv (U : Opens) :
    QuotientTwistedOneForm I_G G M U ≃ CovariantLift I_G G M U where
  toFun A := ⟨A.lift, A.descent⟩
  invFun A := ⟨A.1, A.2⟩
  left_inv A := by cases A; rfl
  right_inv A := by cases A; rfl

/-- The quotient descent records themselves form a presheaf. -/
def quotientFormPresheaf : PresheafLike X where
  Section U := QuotientTwistedOneForm I_G G M U
  res hVU A := QuotientTwistedOneForm.restrict I_G G M hVU A
  res_id := QuotientTwistedOneForm.restrict_id I_G G M
  res_comp := QuotientTwistedOneForm.restrict_comp I_G G M

@[simp] theorem descentEquiv_apply_val (U : Opens)
    (A : QuotientTwistedOneForm I_G G M U) :
    (descentEquiv I_G G M U A).1 = A.lift :=
  rfl

@[simp] theorem descentEquiv_symm_apply_lift (U : Opens)
    (A : CovariantLift I_G G M U) :
    ((descentEquiv I_G G M U).symm A).lift = A.1 :=
  rfl

/-- The zero quotient form supplies an unconditional inhabitant. -/
def zeroQuotientTwistedOneForm (U : Opens) :
    QuotientTwistedOneForm I_G G M U where
  lift := SmoothOneForm.zero I_G G U
  descent := zero_covariant I_G G M U

/-- Presheaf of all smooth lifted `𝔤`-valued one-forms. -/
abbrev liftedFormPresheaf : PresheafLike X where
  Section U := SmoothOneForm I_G G U
  res hVU A := SmoothOneForm.restrict I_G G hVU A
  res_id := SmoothOneForm.restrict_id I_G G
  res_comp := SmoothOneForm.restrict_comp I_G G

/-- The same smooth-form presheaf in the legacy q-gauge interface. -/
def liftedFormQGaugePresheaf : QGaugePresheaf Opens where
  Field U := SmoothOneForm I_G G U
  res hVU A := SmoothOneForm.restrict I_G G hVU A
  res_id := SmoothOneForm.restrict_id I_G G
  res_comp := SmoothOneForm.restrict_comp I_G G

@[simp] theorem liftedFormQGaugePresheaf_res
    {V U : Opens} (hVU : V ≤ U) (A : SmoothOneForm I_G G U) :
    (liftedFormQGaugePresheaf I_G G).res hVU A =
      SmoothOneForm.restrict I_G G hVU A :=
  rfl

/-- The q-gauge and general presheaf presentations are definitionally the same. -/
theorem liftedFormQGauge_toPresheafLike :
    QGaugePresheaf.toPresheafLike (liftedFormQGaugePresheaf I_G G) =
      liftedFormPresheaf I_G G :=
  rfl

/-- Equation (6.2) as an instance of the earlier abstract covariance API. -/
def equation62CovariancePredicate :
    CovariancePredicate (liftedFormPresheaf I_G G) :=
  fun U A => Equation62 I_G G M U A

/-- Modular covariance data now contains only equation (6.2), not Lemma 6.1. -/
def equation62ModularCovarianceData :
    QGaugePresheaf.ModularCovarianceData
      (liftedFormQGaugePresheaf I_G G) where
  Covariant := fun U A => Equation62 I_G G M U A

/-- Q-gauge restriction stability derived from the explicit calculation of both
sides of equation (6.2). -/
theorem equation62ModularCovarianceRestrictionStable :
    QGaugePresheaf.ModularCovarianceRestrictionStable
      (liftedFormQGaugePresheaf I_G G)
      (equation62ModularCovarianceData I_G G M) := by
  intro U V hVU A hA
  exact equation62_restrict I_G G M hVU A hA

/-- The exact `IsRestrictionStableCovariance` witness generated from the
preceding calculation through the generic q-gauge bridge. -/
def equation62RestrictionStable :
    IsRestrictionStableCovariance
      (liftedFormPresheaf I_G G)
      (equation62CovariancePredicate I_G G M) := by
  change IsRestrictionStableCovariance
    (QGaugePresheaf.toPresheafLike (liftedFormQGaugePresheaf I_G G))
    (equation62ModularCovarianceData I_G G M).Covariant
  exact QGaugePresheaf.modularCovarianceRestrictionStable
    (liftedFormQGaugePresheaf I_G G)
    (equation62ModularCovarianceData I_G G M)
    (equation62ModularCovarianceRestrictionStable I_G G M)

/-- Definition 15's exact section type in the pre-existing `Aq` interface. -/
abbrev AqEquation62 (U : Opens) :=
  Aq (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M) U

/-- The concrete q-gauge presheaf obtained from the literal equation (6.2). -/
def AqEquation62Presheaf : PresheafLike X :=
  AqPresheaf
    (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M)
    (equation62RestrictionStable I_G G M)

/-- Canonical zero section of the exact Definition 15 presheaf. -/
def zeroAqEquation62 (U : Opens) : AqEquation62 I_G G M U :=
  ⟨SmoothOneForm.zero I_G G U, zero_covariant I_G G M U⟩

@[simp] theorem zeroAqEquation62_val (U : Opens) :
    (zeroAqEquation62 I_G G M U).1 = SmoothOneForm.zero I_G G U :=
  rfl

/-- Exact descent equivalence, now with Definition 15's concrete `Aq` section
type as codomain. -/
def quotientTwistedOneFormEquivAq (U : Opens) :
    QuotientTwistedOneForm I_G G M U ≃ AqEquation62 I_G G M U :=
  descentEquiv I_G G M U

/-- The descent equivalence commutes with every restriction map. -/
theorem quotientTwistedOneFormEquivAq_natural
    {V U : Opens} (hVU : V ≤ U)
    (A : (quotientFormPresheaf I_G G M).Section U) :
    quotientTwistedOneFormEquivAq I_G G M V
        ((quotientFormPresheaf I_G G M).res hVU A) =
      (AqEquation62Presheaf I_G G M).res hVU
        (quotientTwistedOneFormEquivAq I_G G M U A) := by
  apply Subtype.ext
  rfl

/-- Paper-facing Lemma 6.1.  Its statement displays equation (6.2) and ordinary
restriction directly, while its proof consumes the derived covariance instance
above.  Restriction stability is not an input field of the modular data. -/
theorem lemma6_1
    {V U : Opens} (hVU : V ≤ U)
    {A : SmoothOneForm I_G G U}
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M V (SmoothOneForm.restrict I_G G hVU A) :=
  lemma6_1_covariance_restrict
    (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M)
    (equation62RestrictionStable I_G G M) hVU hA

/-- Backwards-compatible exact-geometry name for the proved Lemma 6.1. -/
theorem lemma6_1_exact
    {V U : Opens} (hVU : V ≤ U)
    {A : SmoothOneForm I_G G U}
    (hA : Equation62 I_G G M U A) :
    Equation62 I_G G M V (SmoothOneForm.restrict I_G G hVU A) :=
  lemma6_1 I_G G M hVU hA

/-- PR-facing certificate for every item of checklist §5.2. -/
structure Lemma61Certificate : Prop where
  pi_preimage_inclusion :
    ∀ {V U : Opens} (hVU : V ≤ U),
      (coverOpen V : Set H) ⊆ (coverOpen U : Set H)
  ordinary_restriction :
    ∀ {V U : Opens} (hVU : V ≤ U)
      (A : SmoothOneForm I_G G U) (τ : coverOpen V),
      SmoothOneForm.restrict I_G G hVU A τ =
        A (SmoothOneForm.coverInclusion hVU τ)
  deck_inclusion_natural :
    ∀ {V U : Opens} (hVU : V ≤ U) (γ : Gamma2) (τ : coverOpen V),
      SmoothOneForm.coverInclusion hVU (coverDeckMap γ V τ) =
        coverDeckMap γ U (SmoothOneForm.coverInclusion hVU τ)
  pullback_restriction :
    ∀ {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
      (A : SmoothOneForm I_G G U),
      SmoothOneForm.restrict I_G G hVU
          (deckPullback I_G G γ U A) =
        deckPullback I_G G γ V
          (SmoothOneForm.restrict I_G G hVU A)
  lhs_restriction_calculation :
    ∀ {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
      (A : SmoothOneForm I_G G U) (τ : coverOpen V),
      deckPullback I_G G γ V
          (SmoothOneForm.restrict I_G G hVU A) τ =
        deckPullback I_G G γ U A
          (SmoothOneForm.coverInclusion hVU τ)
  rhs_restriction_calculation :
    ∀ {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
      (A : SmoothOneForm I_G G U) (τ : coverOpen V),
      (M.automorphyFactor γ
          (SmoothOneForm.coverInclusion hVU τ : H) : ℂ) •
          A (SmoothOneForm.coverInclusion hVU τ) =
        (M.automorphyFactor γ (τ : H) : ℂ) •
          SmoothOneForm.restrict I_G G hVU A τ
  qGauge_stability_derived :
    QGaugePresheaf.ModularCovarianceRestrictionStable
      (liftedFormQGaugePresheaf I_G G)
      (equation62ModularCovarianceData I_G G M)
  covariance_instance_derived :
    IsRestrictionStableCovariance
      (liftedFormPresheaf I_G G)
      (equation62CovariancePredicate I_G G M)
  paper_facing_lemma :
    ∀ {V U : Opens} (hVU : V ≤ U)
      {A : SmoothOneForm I_G G U},
      Equation62 I_G G M U A →
        Equation62 I_G G M V (SmoothOneForm.restrict I_G G hVU A)

/-- Complete unconditional certificate for Lemma 6.1. -/
def lemma6_1_certificate : Lemma61Certificate I_G G M where
  pi_preimage_inclusion := piPreimage_subset
  ordinary_restriction := SmoothOneForm.restrict_apply I_G G
  deck_inclusion_natural := coverInclusion_coverDeckMap
  pullback_restriction := deckPullback_restrict I_G G
  lhs_restriction_calculation := equation62_lhs_restrict I_G G
  rhs_restriction_calculation := equation62_rhs_restrict I_G G M
  qGauge_stability_derived :=
    equation62ModularCovarianceRestrictionStable I_G G M
  covariance_instance_derived := equation62RestrictionStable I_G G M
  paper_facing_lemma := lemma6_1 I_G G M

/-!
### Proposition 16: strict-equality sheaf of twisted smooth one-forms

The gluing below is deliberately a sheaf gluing with literal equality on every
pairwise overlap.  It does not quotient sections by gauge equivalence and hence
does not claim to construct a gauge stack.
-/

/-- Restriction in the lifted smooth-form presheaf is ordinary restriction. -/
@[simp] theorem liftedFormPresheaf_res
    {V U : Opens} (hVU : V ≤ U) (A : SmoothOneForm I_G G U) :
    (liftedFormPresheaf I_G G).res hVU A =
      SmoothOneForm.restrict I_G G hVU A :=
  rfl

/-- Named identity law for the lifted smooth-form presheaf. -/
@[simp] theorem liftedFormPresheaf_res_id
    (U : Opens) (A : SmoothOneForm I_G G U) :
    (liftedFormPresheaf I_G G).res (le_refl U) A = A :=
  SmoothOneForm.restrict_id I_G G U A

/-- Named composition law for the lifted smooth-form presheaf. -/
theorem liftedFormPresheaf_res_comp
    {W V U : Opens} (hWV : W ≤ V) (hVU : V ≤ U)
    (A : SmoothOneForm I_G G U) :
    (liftedFormPresheaf I_G G).res hWV
        ((liftedFormPresheaf I_G G).res hVU A) =
      (liftedFormPresheaf I_G G).res (le_trans hWV hVU) A :=
  SmoothOneForm.restrict_comp I_G G hWV hVU A

/-- Restriction-stable smoothness of one-form-valued functions. -/
def strictSmoothOneFormPrelocalPredicate :
    TopCat.PrelocalPredicate.{uEG, 0}
      (fun _ : TopCat.of H => OneFormValue I_G G) where
  pred {U} f :=
    ContMDiff 𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞ f
  res {U V} i f hf :=
    hf.comp (contMDiff_inclusion i.le)

/-- The universe-polymorphic local smoothness predicate obtained by
sheafifying restriction-stable `ContMDiff`. -/
def strictSmoothOneFormLocalPredicate :
    TopCat.LocalPredicate.{uEG, 0}
      (fun _ : TopCat.of H => OneFormValue I_G G) :=
  (strictSmoothOneFormPrelocalPredicate I_G G).sheafify

/-- For a point over the target of a quotient-open cover, choose one cover
member containing its quotient point. -/
noncomputable def strictGlueIndex {iota : Type}
    (C : OpenCoverData X iota) (tau : coverOpen C.target) : iota :=
  Classical.choose
    (C.covers (quotientMap (tau : H)) tau.2)

/-- The chosen cover member really contains the lifted point. -/
theorem strictGlueIndex_mem {iota : Type}
    (C : OpenCoverData X iota) (tau : coverOpen C.target) :
    (tau : H) ∈ coverOpen (C.piece (strictGlueIndex C tau)) := by
  change quotientMap (tau : H) ∈ C.piece (strictGlueIndex C tau)
  exact Classical.choose_spec
    (C.covers (quotientMap (tau : H)) tau.2)

/-- The lifted point, regarded as a point of its chosen cover member. -/
def strictGluePoint {iota : Type}
    (C : OpenCoverData X iota) (tau : coverOpen C.target) :
    coverOpen (C.piece (strictGlueIndex C tau)) :=
  ⟨(tau : H), strictGlueIndex_mem C tau⟩

/-- A point lying in two lifted cover members determines a point of their
literal pairwise overlap. -/
def strictOverlapPoint {iota : Type}
    (C : OpenCoverData X iota) (i j : iota) (tau : H)
    (hi : tau ∈ coverOpen (C.piece i))
    (hj : tau ∈ coverOpen (C.piece j)) :
    coverOpen (C.piece i ⊓ C.piece j) := by
  refine ⟨tau, ?_⟩
  exact ⟨hi, hj⟩

/-- Strict overlap compatibility can be evaluated at any common lifted point.
This is the choice-independence lemma used by the pointwise gluing. -/
theorem strictCompatible_eval {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s)
    (i j : iota) (tau : H)
    (hi : tau ∈ coverOpen (C.piece i))
    (hj : tau ∈ coverOpen (C.piece j)) :
    s i ⟨tau, hi⟩ = s j ⟨tau, hj⟩ := by
  let z := strictOverlapPoint C i j tau hi hj
  have hz := congrArg
    (fun A : SmoothOneForm I_G G (C.piece i ⊓ C.piece j) => A z)
    (hs i j)
  change
    SmoothOneForm.restrict I_G G (C.overlap_le_left i j) (s i) z =
      SmoothOneForm.restrict I_G G (C.overlap_le_right i j) (s j) z at hz
  rw [SmoothOneForm.restrict_apply, SmoothOneForm.restrict_apply] at hz
  have hzi :
      SmoothOneForm.coverInclusion (C.overlap_le_left i j) z =
        (⟨tau, hi⟩ : coverOpen (C.piece i)) := by
    apply Subtype.ext
    rfl
  have hzj :
      SmoothOneForm.coverInclusion (C.overlap_le_right i j) z =
        (⟨tau, hj⟩ : coverOpen (C.piece j)) := by
    apply Subtype.ext
    rfl
  simpa only [hzi, hzj] using hz

/-- The pointwise candidate obtained by evaluating a compatible local family in
the chosen member of the cover. -/
noncomputable def strictGluedToFun {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C) :
    coverOpen C.target → OneFormValue I_G G :=
  fun tau => s (strictGlueIndex C tau) (strictGluePoint C tau)

/-- The pointwise candidate agrees with every local member that contains the
point, independently of the chosen index. -/
theorem strictGluedToFun_eq_of_mem {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s)
    (i : iota) (tau : coverOpen C.target)
    (hi : (tau : H) ∈ coverOpen (C.piece i)) :
    strictGluedToFun I_G G C s tau = s i ⟨(tau : H), hi⟩ := by
  change
    s (strictGlueIndex C tau) (strictGluePoint C tau) =
      s i ⟨(tau : H), hi⟩
  simpa only [strictGluePoint] using
    (strictCompatible_eval I_G G C s hs
      (strictGlueIndex C tau) i (tau : H)
      (strictGlueIndex_mem C tau) hi)

/-- On a lifted cover member, the pointwise candidate is exactly the original
smooth local section. -/
theorem strictGluedToFun_eq_on_piece {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s)
    (i : iota) (tau : coverOpen (C.piece i)) :
    strictGluedToFun I_G G C s
        (SmoothOneForm.coverInclusion (C.piece_le_target i) tau) =
      s i tau := by
  let tauU := SmoothOneForm.coverInclusion (C.piece_le_target i) tau
  have hmem : (tauU : H) ∈ coverOpen (C.piece i) := by
    change (tau : H) ∈ coverOpen (C.piece i)
    exact tau.2
  have h := strictGluedToFun_eq_of_mem I_G G C s hs i tauU hmem
  have hpoint :
      (⟨(tauU : H), hmem⟩ : coverOpen (C.piece i)) = tau := by
    apply Subtype.ext
    rfl
  calc
    strictGluedToFun I_G G C s
        (SmoothOneForm.coverInclusion (C.piece_le_target i) tau) =
        s i ⟨(tauU : H), hmem⟩ := by
      simpa only [tauU] using h
    _ = s i tau := congrArg (fun x => s i x) hpoint

/-- Smoothness of the pointwise gluing follows from Mathlib's local predicate:
near each point it is one of the supplied smooth local sections. -/
theorem strictGluedToFun_contMDiff {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞
      (strictGluedToFun I_G G C s) := by
  intro tau
  let i := strictGlueIndex C tau
  let tau_i : coverOpen (C.piece i) :=
    ⟨(tau : H), strictGlueIndex_mem C tau⟩
  have hlocal :
      ContMDiff 𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞
        (fun x : coverOpen (C.piece i) =>
          strictGluedToFun I_G G C s
            (SmoothOneForm.coverInclusion (C.piece_le_target i) x)) := by
    apply (s i).smooth_toFun.congr
    intro x
    exact strictGluedToFun_eq_on_piece I_G G C s hs i x
  have htau :
      SmoothOneForm.coverInclusion (C.piece_le_target i) tau_i = tau := by
    apply Subtype.ext
    rfl
  rw [← htau]
  have hpoint :
      ChartedSpace.LiftPropAt
        (ContDiffWithinAtProp
          𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞)
        (strictGluedToFun I_G G C s)
        (SmoothOneForm.coverInclusion (C.piece_le_target i) tau_i) := by
    change ChartedSpace.LiftPropAt
      (ContDiffWithinAtProp
        𝓘(ℂ) 𝓘(ℂ, OneFormValue I_G G) ∞)
      (strictGluedToFun I_G G C s)
      (Set.inclusion (coverOpen_mono (C.piece_le_target i)) tau_i)
    rw [(contDiffWithinAt_localInvariantProp
      (I := 𝓘(ℂ))
      (I' := 𝓘(ℂ, OneFormValue I_G G)) ∞).liftPropAt_iff_comp_inclusion
        (coverOpen_mono (C.piece_le_target i))]
    exact hlocal tau_i
  exact hpoint

/-- The actual smooth global one-form obtained from a strictly compatible local
family. -/
noncomputable def strictSmoothOneFormGlue {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s) :
    SmoothOneForm I_G G C.target where
  toFun := strictGluedToFun I_G G C s
  smooth_toFun := strictGluedToFun_contMDiff I_G G C s hs

/-- The constructed smooth global form restricts pointwise to each prescribed
local form. -/
@[simp] theorem strictSmoothOneFormGlue_restrict_apply {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s)
    (i : iota) (tau : coverOpen (C.piece i)) :
    SmoothOneForm.restrict I_G G (C.piece_le_target i)
        (strictSmoothOneFormGlue I_G G C s hs) tau =
      s i tau :=
  strictGluedToFun_eq_on_piece I_G G C s hs i tau

/-- The constructed smooth form is a gluing in the lightweight sheaf API. -/
theorem strictSmoothOneFormGlue_isGluing {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s) :
    (liftedFormPresheaf I_G G).IsGluing C s
      (strictSmoothOneFormGlue I_G G C s hs) := by
  intro i
  apply SmoothOneForm.ext_pointwise
  intro tau
  exact strictSmoothOneFormGlue_restrict_apply I_G G C s hs i tau

/-- Smooth forms are local: equality after restriction to every member of an
open cover implies global equality. -/
theorem strictSmoothOneForm_locality {iota : Type}
    (C : OpenCoverData X iota)
    {A D : (liftedFormPresheaf I_G G).Section C.target}
    (hAD : ∀ i : iota,
      (liftedFormPresheaf I_G G).res (C.piece_le_target i) A =
        (liftedFormPresheaf I_G G).res (C.piece_le_target i) D) :
    A = D := by
  apply SmoothOneForm.ext_pointwise
  intro tau
  let i := strictGlueIndex C tau
  let z := strictGluePoint C tau
  have hi := hAD i
  change
    SmoothOneForm.restrict I_G G (C.piece_le_target i) A =
      SmoothOneForm.restrict I_G G (C.piece_le_target i) D at hi
  have hz := congrArg
    (fun S : SmoothOneForm I_G G (C.piece i) => S z) hi
  rw [SmoothOneForm.restrict_apply, SmoothOneForm.restrict_apply] at hz
  have hpoint :
      SmoothOneForm.coverInclusion (C.piece_le_target i) z = tau := by
    apply Subtype.ext
    rfl
  simpa only [hpoint] using hz

/-- Every strictly compatible smooth local family has a smooth global gluing. -/
theorem strictSmoothOneForm_gluing_exists {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (hs : (liftedFormPresheaf I_G G).CompatibleFamily C s) :
    ∃ A : (liftedFormPresheaf I_G G).Section C.target,
      (liftedFormPresheaf I_G G).IsGluing C s A :=
  ⟨strictSmoothOneFormGlue I_G G C s hs,
    strictSmoothOneFormGlue_isGluing I_G G C s hs⟩

/-- A smooth global gluing of a strictly compatible family is unique. -/
theorem strictSmoothOneForm_gluing_unique {iota : Type}
    (C : OpenCoverData X iota)
    (s : (liftedFormPresheaf I_G G).CoverSectionProduct C)
    (_hs : (liftedFormPresheaf I_G G).CompatibleFamily C s)
    {A D : (liftedFormPresheaf I_G G).Section C.target}
    (hA : (liftedFormPresheaf I_G G).IsGluing C s A)
    (hD : (liftedFormPresheaf I_G G).IsGluing C s D) :
    A = D := by
  apply strictSmoothOneForm_locality I_G G C
  intro i
  exact (hA i).trans (hD i).symm

/-- Concrete sheaf witness for all smooth lifted `𝔤`-valued one-forms. -/
def strictSmoothOneFormIsSheaf :
    IsSheafLike (liftedFormPresheaf I_G G) where
  locality := strictSmoothOneForm_locality I_G G
  gluing_exists := strictSmoothOneForm_gluing_exists I_G G
  gluing_unique := strictSmoothOneForm_gluing_unique I_G G

/-- Equation (6.2) is pointwise local.  Its validity on every member of a
quotient-open cover implies its validity on the target open set. -/
theorem equation62_of_cover_restrictions {iota : Type}
    (C : OpenCoverData X iota)
    (A : SmoothOneForm I_G G C.target)
    (hA : ∀ i : iota,
      Equation62 I_G G M (C.piece i)
        (SmoothOneForm.restrict I_G G (C.piece_le_target i) A)) :
    Equation62 I_G G M C.target A := by
  intro gamma tau
  let i := strictGlueIndex C tau
  let z := strictGluePoint C tau
  have hpoint :
      SmoothOneForm.coverInclusion (C.piece_le_target i) z = tau := by
    apply Subtype.ext
    rfl
  calc
    deckPullback I_G G gamma C.target A tau =
        deckPullback I_G G gamma C.target A
          (SmoothOneForm.coverInclusion (C.piece_le_target i) z) := by
      rw [hpoint]
    _ = deckPullback I_G G gamma (C.piece i)
          (SmoothOneForm.restrict I_G G (C.piece_le_target i) A) z :=
      (equation62_lhs_restrict I_G G
        (C.piece_le_target i) gamma A z).symm
    _ = (M.automorphyFactor gamma (z : H) : ℂ) •
          SmoothOneForm.restrict I_G G (C.piece_le_target i) A z :=
      hA i gamma z
    _ = (M.automorphyFactor gamma
          (SmoothOneForm.coverInclusion (C.piece_le_target i) z : H) : ℂ) •
          A (SmoothOneForm.coverInclusion (C.piece_le_target i) z) :=
      (equation62_rhs_restrict I_G G M
        (C.piece_le_target i) gamma A z).symm
    _ = (M.automorphyFactor gamma (tau : H) : ℂ) • A tau := by
      rw [hpoint]

/-- Concrete locality instance for the covariance predicate defined by (6.2). -/
def equation62IsLocalCovariance :
    IsLocalCovariance
      (liftedFormPresheaf I_G G)
      (equation62CovariancePredicate I_G G M) where
  local_of_restrictions := by
    intro iota C A hA
    exact equation62_of_cover_restrictions I_G G M C A hA

/-- Any smooth gluing of covariant local lifts is covariant.  This is the
concrete geometric specialization of the abstract gluing lemma. -/
theorem strictGluedLift_covariant {iota : Type}
    (C : OpenCoverData X iota)
    (s : (AqEquation62Presheaf I_G G M).CoverSectionProduct C)
    (A : SmoothOneForm I_G G C.target)
    (hA : (liftedFormPresheaf I_G G).IsGluing C
      (Aq.underlyingFamily
        (liftedFormPresheaf I_G G)
        (equation62CovariancePredicate I_G G M)
        (equation62RestrictionStable I_G G M) C s) A) :
    Equation62 I_G G M C.target A :=
  Aq.glued_form_covariant
    (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M)
    (equation62RestrictionStable I_G G M)
    (equation62IsLocalCovariance I_G G M) C s A hA

/-- The explicitly selected strict smooth gluing of a compatible `Aq` family
satisfies equation (6.2). -/
theorem strictChosenGluedLift_covariant {iota : Type}
    (C : OpenCoverData X iota)
    (s : (AqEquation62Presheaf I_G G M).CoverSectionProduct C)
    (hs : (AqEquation62Presheaf I_G G M).CompatibleFamily C s) :
    Equation62 I_G G M C.target
      (strictSmoothOneFormGlue I_G G C
        (Aq.underlyingFamily
          (liftedFormPresheaf I_G G)
          (equation62CovariancePredicate I_G G M)
          (equation62RestrictionStable I_G G M) C s)
        (Aq.underlyingFamily_compatible
          (liftedFormPresheaf I_G G)
          (equation62CovariancePredicate I_G G M)
          (equation62RestrictionStable I_G G M) C s hs)) := by
  let t := Aq.underlyingFamily
    (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M)
    (equation62RestrictionStable I_G G M) C s
  let ht := Aq.underlyingFamily_compatible
    (liftedFormPresheaf I_G G)
    (equation62CovariancePredicate I_G G M)
    (equation62RestrictionStable I_G G M) C s hs
  apply strictGluedLift_covariant I_G G M C s
  exact strictSmoothOneFormGlue_isGluing I_G G C t ht

/-- Paper-facing name emphasizing that Proposition 16 constructs a sheaf with
strict overlap equality, not a quotient by gauge equivalence. -/
def strictEqualityTwistedOneFormPresheaf : PresheafLike X :=
  QGaugePresheaf.modularCovariantAqPresheaf
    (liftedFormQGaugePresheaf I_G G)
    (equation62ModularCovarianceData I_G G M)
    (equation62ModularCovarianceRestrictionStable I_G G M)

/-- Compatibility in the strict-equality model is literal equality of the two
restricted one-forms on every pairwise overlap. -/
def strictEqualityOverlapCompatibility {iota : Type}
    (C : OpenCoverData X iota)
    (s : (strictEqualityTwistedOneFormPresheaf I_G G M).CoverSectionProduct C) : Prop :=
  (strictEqualityTwistedOneFormPresheaf I_G G M).CompatibleFamily C s

/-- Expansion of the strict overlap API.  No gauge transformation witnesses or
2-morphisms occur in this statement. -/
theorem strictEqualityOverlapCompatibility_iff_literal {iota : Type}
    (C : OpenCoverData X iota)
    (s : (strictEqualityTwistedOneFormPresheaf I_G G M).CoverSectionProduct C) :
    strictEqualityOverlapCompatibility I_G G M C s ↔
      ∀ i j : iota,
        (strictEqualityTwistedOneFormPresheaf I_G G M).res
            (C.overlap_le_left i j) (s i) =
          (strictEqualityTwistedOneFormPresheaf I_G G M).res
            (C.overlap_le_right i j) (s j) :=
  Iff.rfl

/-- Proposition 16 for the actual equation-(6.2) q-gauge sheaf.  The theorem
has no sheafness or locality hypotheses: both concrete witnesses are supplied
by the preceding constructions. -/
theorem proposition16_strictEqualityTwistedOneForm_isSheaf :
    IsSheafLike (strictEqualityTwistedOneFormPresheaf I_G G M) :=
  QGaugePresheaf.prop16_qGauge_Aq_is_sheaf
    (liftedFormQGaugePresheaf I_G G)
    (equation62ModularCovarianceData I_G G M)
    (equation62ModularCovarianceRestrictionStable I_G G M)
    (strictSmoothOneFormIsSheaf I_G G)
    (equation62IsLocalCovariance I_G G M)

/-- PR-facing certificate for every concrete obligation in checklist §5.3. -/
structure Proposition16StrictEqualityCertificate : Prop where
  smooth_form_presheaf :
    ∀ U : Opens,
      (liftedFormPresheaf I_G G).Section U = SmoothOneForm I_G G U
  restriction_identity :
    ∀ (U : Opens) (A : SmoothOneForm I_G G U),
      (liftedFormPresheaf I_G G).res (le_refl U) A = A
  restriction_composition :
    ∀ {W V U : Opens} (hWV : W ≤ V) (hVU : V ≤ U)
      (A : SmoothOneForm I_G G U),
      (liftedFormPresheaf I_G G).res hWV
          ((liftedFormPresheaf I_G G).res hVU A) =
        (liftedFormPresheaf I_G G).res (le_trans hWV hVU) A
  smooth_locality :
    ∀ {iota : Type} (C : OpenCoverData X iota)
      {A D : (liftedFormPresheaf I_G G).Section C.target},
      (∀ i : iota,
        (liftedFormPresheaf I_G G).res (C.piece_le_target i) A =
          (liftedFormPresheaf I_G G).res (C.piece_le_target i) D) →
        A = D
  strict_smooth_gluing :
    ∀ {iota : Type} (C : OpenCoverData X iota)
      (s : (liftedFormPresheaf I_G G).CoverSectionProduct C),
      (liftedFormPresheaf I_G G).CompatibleFamily C s →
        ∃ A : (liftedFormPresheaf I_G G).Section C.target,
          (liftedFormPresheaf I_G G).IsGluing C s A
  covariance_pointwise_local :
    ∀ {iota : Type} (C : OpenCoverData X iota)
      (A : SmoothOneForm I_G G C.target),
      (∀ i : iota,
        Equation62 I_G G M (C.piece i)
          (SmoothOneForm.restrict I_G G (C.piece_le_target i) A)) →
        Equation62 I_G G M C.target A
  glued_lift_covariant :
    ∀ {iota : Type} (C : OpenCoverData X iota)
      (s : (AqEquation62Presheaf I_G G M).CoverSectionProduct C)
      (A : SmoothOneForm I_G G C.target),
      (liftedFormPresheaf I_G G).IsGluing C
          (Aq.underlyingFamily
            (liftedFormPresheaf I_G G)
            (equation62CovariancePredicate I_G G M)
            (equation62RestrictionStable I_G G M) C s) A →
        Equation62 I_G G M C.target A
  underlying_sheaf_instance :
    IsSheafLike (liftedFormPresheaf I_G G)
  covariance_local_instance :
    IsLocalCovariance
      (liftedFormPresheaf I_G G)
      (equation62CovariancePredicate I_G G M)
  concrete_strict_sheaf :
    IsSheafLike (strictEqualityTwistedOneFormPresheaf I_G G M)
  strict_overlap_is_literal :
    ∀ {iota : Type} (C : OpenCoverData X iota)
      (s : (strictEqualityTwistedOneFormPresheaf I_G G M).CoverSectionProduct C),
      strictEqualityOverlapCompatibility I_G G M C s ↔
        ∀ i j : iota,
          (strictEqualityTwistedOneFormPresheaf I_G G M).res
              (C.overlap_le_left i j) (s i) =
            (strictEqualityTwistedOneFormPresheaf I_G G M).res
              (C.overlap_le_right i j) (s j)

/-- Complete concrete certificate for Proposition 16 in the strict-equality
interpretation. -/
def proposition16_strictEquality_certificate :
    Proposition16StrictEqualityCertificate I_G G M where
  smooth_form_presheaf := fun _ => rfl
  restriction_identity := liftedFormPresheaf_res_id I_G G
  restriction_composition := liftedFormPresheaf_res_comp I_G G
  smooth_locality := strictSmoothOneForm_locality I_G G
  strict_smooth_gluing := strictSmoothOneForm_gluing_exists I_G G
  covariance_pointwise_local := equation62_of_cover_restrictions I_G G M
  glued_lift_covariant := strictGluedLift_covariant I_G G M
  underlying_sheaf_instance := strictSmoothOneFormIsSheaf I_G G
  covariance_local_instance := equation62IsLocalCovariance I_G G M
  concrete_strict_sheaf :=
    proposition16_strictEqualityTwistedOneForm_isSheaf I_G G M
  strict_overlap_is_literal :=
    strictEqualityOverlapCompatibility_iff_literal I_G G M

/-- PR-facing certificate for every item of checklist §5.1. -/
structure Certificate : Prop where
  quotient_base_exact : X = Definition11.Gamma2Quotient
  denominator_literal :
    ∀ (γ : Gamma2) (τ : H),
      denominator γ τ =
        ((gammaGL γ 1 0 : ℝ) : ℂ) * (τ : ℂ) +
          ((gammaGL γ 1 1 : ℝ) : ℂ)
  deck_derivative_literal :
    ∀ (γ : Gamma2) (τ : H),
      deckDerivative γ τ =
        deriv
          (fun z : ℂ =>
            ((gammaGL γ • UpperHalfPlane.ofComplex z : H) : ℂ))
          (τ : ℂ)
  lie_group_selected : Nonempty (LieGroup I_G ∞ G)
  lie_algebra_selected :
    Nonempty (LieAlgebra ℂ (GaugeLieAlgebra I_G G))
  smooth_forms_nonempty :
    ∀ U : Opens, Nonempty (SmoothOneForm I_G G U)
  multiplier_normalized : M.nu 1 = 1
  branch_square :
    ∀ (γ : Gamma2) (τ : H),
      (B.value γ τ : ℂ) ^ 2 = (denominator γ τ)⁻¹
  multiplier_branch_law :
    ∀ (γ δ : Gamma2) (τ : H),
      M.nu (γ * δ) =
        M.nu γ * M.nu δ * B.branchDefect γ δ τ
  automorphy_cocycle :
    ∀ (γ δ : Gamma2) (τ : H),
      M.automorphyFactor (γ * δ) τ =
        M.automorphyFactor γ (δ • τ) * M.automorphyFactor δ τ
  line_bundle_is_associated_quotient :
    (LHalfNu M).Total = AutomorphicLineBundleTotal M
  line_action_identity :
    ∀ p : H × ℂ, lineSmul M 1 p = p
  line_action_smooth :
    ∀ γ : Gamma2,
      ContMDiff ((𝓘(ℂ)).prod (𝓘(ℂ)))
        ((𝓘(ℂ)).prod (𝓘(ℂ))) ∞ (lineSmul M γ)
  line_action_composition :
    ∀ (γ δ : Gamma2) (p : H × ℂ),
      lineSmul M (γ * δ) p = lineSmul M γ (lineSmul M δ p)
  line_quotient_identifies_orbits :
    ∀ (γ : Gamma2) (p : H × ℂ),
      lineBundleMk M (lineSmul M γ p) = lineBundleMk M p
  line_bundle_projection_onto :
    Function.Surjective (lineBundleProjection M)
  pullback_identity :
    ∀ (U : Opens) (A : SmoothOneForm I_G G U),
      deckPullback I_G G 1 U A = A
  pullback_composition :
    ∀ (γ δ : Gamma2) (U : Opens) (A : SmoothOneForm I_G G U),
      deckPullback I_G G (γ * δ) U A =
        deckPullback I_G G δ U (deckPullback I_G G γ U A)
  pullback_restriction :
    ∀ {V U : Opens} (hVU : V ≤ U) (γ : Gamma2)
      (A : SmoothOneForm I_G G U),
      SmoothOneForm.restrict I_G G hVU
          (deckPullback I_G G γ U A) =
        deckPullback I_G G γ V
          (SmoothOneForm.restrict I_G G hVU A)
  descent_equivalence :
    ∀ U : Opens,
      Nonempty
        (QuotientTwistedOneForm I_G G M U ≃
          CovariantLift I_G G M U)
  descent_Aq_equivalence :
    ∀ U : Opens,
      Nonempty
        (QuotientTwistedOneForm I_G G M U ≃
          AqEquation62 I_G G M U)
  descent_restriction_natural :
    ∀ {V U : Opens} (hVU : V ≤ U)
      (A : (quotientFormPresheaf I_G G M).Section U),
      quotientTwistedOneFormEquivAq I_G G M V
          ((quotientFormPresheaf I_G G M).res hVU A) =
        (AqEquation62Presheaf I_G G M).res hVU
          (quotientTwistedOneFormEquivAq I_G G M U A)
  definition15_sections_nonempty :
    ∀ U : Opens,
      Nonempty ((AqEquation62Presheaf I_G G M).Section U)
  equation62_exact :
    ∀ (U : Opens) (A : SmoothOneForm I_G G U),
      Covariant I_G G M U A ↔
        ∀ (γ : Gamma2) (τ : coverOpen U),
          deckPullback I_G G γ U A τ =
            (M.automorphyFactor γ (τ : H) : ℂ) • A τ
  equation62_pointwise_exact :
    ∀ (U : Opens) (A : SmoothOneForm I_G G U),
      Equation62 I_G G M U A ↔
        ∀ (γ : Gamma2) (τ : coverOpen U) (v : ℂ),
          A (coverDeckMap γ U τ) (deckDerivative γ τ * v) =
            (M.automorphyFactor γ (τ : H) : ℂ) • A τ v
  restriction_stable :
    IsRestrictionStableCovariance
      (liftedFormPresheaf I_G G)
      (equation62CovariancePredicate I_G G M)

/-- Complete unconditional certification of the exact data in equation (6.2),
relative only to the multiplier/branch system explicitly fixed by the paper. -/
noncomputable def certificate : Certificate I_G G M where
  quotient_base_exact := rfl
  denominator_literal := denominator_eq_c_tau_add_d
  deck_derivative_literal := deckDerivative_eq_coordinateDeriv
  lie_group_selected := ⟨inferInstance⟩
  lie_algebra_selected := ⟨gaugeLieAlgebraStructure I_G G⟩
  smooth_forms_nonempty := fun U => ⟨SmoothOneForm.zero I_G G U⟩
  multiplier_normalized := M.nu_one
  branch_square := B.square_coe
  multiplier_branch_law := M.nu_mul
  automorphy_cocycle := M.automorphyFactor_mul
  line_bundle_is_associated_quotient := rfl
  line_action_identity := lineSmul_one M
  line_action_smooth := lineSmul_contMDiff M
  line_action_composition := lineSmul_mul M
