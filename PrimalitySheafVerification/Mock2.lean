namespace Definition13QCovariant

noncomputable section

/-- Explicit nonzero fibre operators: both the q-potential and logarithmic
derivative are identity maps.  Their types guarantee preservation of the
certified solution and homogeneous matching fibres.  This is a nonzero test
operator for the corrected interface; it is not claimed to be the paper's
undeclared analytic `q*d/dq` operator. -/
def identityFibreOperators (E F : ModuleCat ℂ) : FibreOperators E F where
  qPotential := LinearMap.id
  logDerivative := LinearMap.id

@[simp] theorem identityFibreOperators_qPotential_apply
    (E F : ModuleCat ℂ) (x : E) :
    (identityFibreOperators E F).qPotential x = x :=
  rfl

@[simp] theorem identityFibreOperators_logDerivative_apply
    (E F : ModuleCat ℂ) (x : F) :
    (identityFibreOperators E F).logDerivative x = x :=
  rfl

section ActualIdentity

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- The identity operators specialized to the actual Definition 11 and
Definition 12 fibres. -/
def identityActualFibreOperators
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    ActualFibreOperators D A :=
  identityFibreOperators (ActualLqFibre D) (ActualMmockFibre A)

/-- The full Definition 13 certificate instantiated without an operator input
argument. -/
theorem identityActual_certificate
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    Certificate (X := Definition11.RadiusBase)
      (ActualLqFibre D) (ActualMmockFibre A)
      (identityActualFibreOperators D A) :=
  actual_certificate D A (identityActualFibreOperators D A)

end ActualIdentity

/-- On the explicit scalar solution fibre, the identity q-potential is a
genuinely nonzero linear map. -/
theorem scalarIdentityActual_qPotential_ne_zero (A : Set ℂ) :
    (identityActualFibreOperators Definition11.scalarAnalyticData A).qPotential
      ≠ 0 := by
  intro hzero
  let u : ActualLqFibre Definition11.scalarAnalyticData :=
    Definition11.scalarSolution 1 Definition11.halfRadius
  have hvalue := congrArg
    (fun T : ActualLqFibre Definition11.scalarAnalyticData →ₗ[ℂ]
        ActualLqFibre Definition11.scalarAnalyticData => T u) hzero
  have hu : u = 0 := by
    simpa [identityActualFibreOperators, identityFibreOperators] using hvalue
  exact Definition11.scalarSolution_ne_zero one_ne_zero
    Definition11.halfRadius hu

/-! ### A genuine logarithmic derivative on the degree-one Mmock sector -/

/-- Coefficients of the degree-one inside variations `c*q`. -/
abbrev DegreeOneMmockFibre : ModuleCat ℂ :=
  ModuleCat.of ℂ ℂ

/-- On the degree-one sector, the identity coefficient map is the genuine
logarithmic derivative because `q*d(c*q)/dq = c*q`. -/
def degreeOneFibreOperators :
    FibreOperators
      (ActualLqFibre Definition11.scalarAnalyticData)
      DegreeOneMmockFibre where
  qPotential := LinearMap.id
  logDerivative := LinearMap.id

@[simp] theorem degreeOneFibreOperators_qPotential_apply
    (u : ActualLqFibre Definition11.scalarAnalyticData) :
    degreeOneFibreOperators.qPotential u = u :=
  rfl

@[simp] theorem degreeOneFibreOperators_logDerivative_apply (c : ℂ) :
    degreeOneFibreOperators.logDerivative c = c :=
  rfl

theorem degreeOne_qPotential_ne_zero :
    degreeOneFibreOperators.qPotential ≠ 0 := by
  intro hzero
  let u : ActualLqFibre Definition11.scalarAnalyticData :=
    Definition11.scalarSolution 1 Definition11.halfRadius
  have hvalue := congrArg
    (fun T : ActualLqFibre Definition11.scalarAnalyticData →ₗ[ℂ]
        ActualLqFibre Definition11.scalarAnalyticData => T u) hzero
  have hu : u = 0 := by
    simpa [degreeOneFibreOperators] using hvalue
  exact Definition11.scalarSolution_ne_zero one_ne_zero
    Definition11.halfRadius hu

theorem degreeOne_logDerivative_ne_zero :
    degreeOneFibreOperators.logDerivative ≠ 0 := by
  intro hzero
  have hvalue := congrArg (fun T : ℂ →ₗ[ℂ] ℂ => T 1) hzero
  norm_num [degreeOneFibreOperators] at hvalue

/-- The coefficient operator realizes the analytic logarithmic derivative and
lands in the certified homogeneous variation represented by `c*q`. -/
theorem degreeOne_logDerivative_realizes_certifiedVariation
    (A : Set ℂ) (c q : ℂ) :
    q * deriv (fun z : ℂ => c * z) q =
      (Definition12Tensor.MmockLinear.homogeneousInside
        (Definition12Tensor.MmockLinear.degreeOneInsideVariation A
          (degreeOneFibreOperators.logDerivative c))).sumAt q := by
  rw [degreeOneFibreOperators_logDerivative_apply]
  calc
    q * deriv (fun z : ℂ => c * z) q =
        (Mmock.QSeries.monomialSeries 1 c).sumAt q :=
      Mmock.QSeries.degreeOne_logDerivative_eq_sumAt c q
    _ = c * q := Mmock.QSeries.degreeOneSeries_sumAt c q
    _ = (Definition12Tensor.MmockLinear.homogeneousInside
          (Definition12Tensor.MmockLinear.degreeOneInsideVariation A c)).sumAt q :=
      (Definition12Tensor.MmockLinear.degreeOneInsideVariation_sumAt
        A c q).symm

/-- Definition 13's entire one-form-valued Dq package for the genuine
degree-one logarithmic derivative sector. -/
theorem degreeOneDq_certificate :
    Certificate (X := Definition11.RadiusBase)
      (ActualLqFibre Definition11.scalarAnalyticData)
      DegreeOneMmockFibre degreeOneFibreOperators :=
  certificate
    (X := Definition11.RadiusBase)
    (ActualLqFibre Definition11.scalarAnalyticData)
    DegreeOneMmockFibre degreeOneFibreOperators

end

