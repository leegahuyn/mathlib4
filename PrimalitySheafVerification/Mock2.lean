      Definition11.scalarAnalyticData Mmock.zeroCommonAnnulus.carrier).obj
    (⊤ : RadiusOpens)

/-- Base change that is available without inventing a map between the radius
interval and `X`: use the global tensor module as a constant presheaf on `X`. -/
def tensorGaugePresheafOverX_zeroModel : QGaugePresheaf Opens where
  Field := fun _ => ActualTensorGlobal
  res := fun _ s => s
  res_id := by
    intro U s
    rfl
  res_comp := by
    intro U V W hUV hVW s
    rfl

@[simp] theorem tensorGaugePresheafOverX_zeroModel_res
    {U V : Opens} (hUV : U ≤ V) (s : ActualTensorGlobal) :
    tensorGaugePresheafOverX_zeroModel.res hUV s = s :=
  rfl

/-- Canonical comparison available from the stated data: every tensor section
is sent to the exact zero solution of equation (6.2). -/
def tensorToActualQGauge_zeroModel :
    QGaugePresheaf.Morphism tensorGaugePresheafOverX_zeroModel
      Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf where
  app := fun U _ => Proposition20ActualQGaugeSpecialization.aqZero U
  naturality := by
    intro U V hUV s
    exact Proposition20ActualQGaugeSpecialization.aqRes_zero hUV

@[simp] theorem tensorToActualQGauge_zeroModel_apply (U : Opens)
    (s : tensorGaugePresheafOverX_zeroModel.Field U) :
    tensorToActualQGauge_zeroModel.app U s = Proposition20ActualQGaugeSpecialization.aqZero U :=
  rfl

theorem tensorToActualQGauge_zeroModel_natural
    {U V : Opens} (hUV : U ≤ V)
    (s : tensorGaugePresheafOverX_zeroModel.Field V) :
    Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf.res hUV
        (tensorToActualQGauge_zeroModel.app V s) =
      tensorToActualQGauge_zeroModel.app U
        (tensorGaugePresheafOverX_zeroModel.res hUV s) :=
  tensorToActualQGauge_zeroModel.naturality hUV s

/-- Uniqueness among natural morphisms having the stipulated zero components. -/
theorem tensorToActualQGauge_zeroModel_unique
    (f : QGaugePresheaf.Morphism tensorGaugePresheafOverX_zeroModel
      Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf)
    (hf : ∀ (U : Opens) (s : tensorGaugePresheafOverX_zeroModel.Field U),
      f.app U s = Proposition20ActualQGaugeSpecialization.aqZero U) :
    f = tensorToActualQGauge_zeroModel := by
  apply QGaugePresheaf.Morphism.ext
  intro U s
  exact hf U s

/-- Missing cross-base comparison data.  It specifies how global genuine
Definition-12 tensor sections are realized as a presheaf on `X`, followed by
a natural morphism to the modular q-gauge sheaf. -/
structure TensorToModularQGaugeBridge where
  source : QGaugePresheaf Opens
  realizeGlobal : ∀ U : Opens, ActualTensorGlobal → source.Field U
  realizeGlobal_natural :
    ∀ {U V : Opens} (hUV : U ≤ V) (s : ActualTensorGlobal),
      source.res hUV (realizeGlobal V s) = realizeGlobal U s
  comparison :
    QGaugePresheaf.Morphism source
      Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf

namespace TensorToModularQGaugeBridge

