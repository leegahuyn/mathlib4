/-!
## §H — Standalone Proposition 15 zero-profile supplement

The paper does not define `Sh(Eq)`, `Sh(P)`, or an analytic prime-local
spectral transform.  This section therefore fixes a complete standalone
elementary specification instead of treating an unspecified map as input.

* `ShEq X` is the category of proved pointwise equalizer sheaves on `X`.
* `ShP X` is the category of proved sheaves equipped with the canonical
  prime-residue profile constructed below.
* At a prime `p`, the local profile of a section `s` is `(s, 0 : ZMod p)`.
  It is characterized uniquely by its section component and its normalized
  prime-residue component, and restriction naturality is proved.
* The obstruction comparison uses Mathlib's actual derived `Tor'₁` on the
  source and the explicit multiplication-kernel object on the target.  The
  comparison is a natural isomorphism whose components are the nontrivial
  projective-resolution comparison from §E.3, not `AddEquiv.refl`.
-/

namespace Proposition15ActualFunctor

noncomputable section

open CategoryTheory CategoryTheory.Limits

abbrev Opens (X : Type u) [TopologicalSpace X] := TopologicalSpace.Opens X

/-- Precise standalone meaning of `Sh(Eq)`: an ambient sheaf, a boundary
sheaf, two restriction morphisms, and their pointwise equalizer. -/
structure ShEq (X : Type u) [TopologicalSpace X] where
  ambient : QGaugePresheaf.{u, v} (Opens X)
  boundary : QGaugePresheaf.{u, v} (Opens X)
  resIn : QGaugePresheaf.Morphism ambient boundary
  resOut : QGaugePresheaf.Morphism ambient boundary
  ambient_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike ambient)
  boundary_isSheaf :
    IsSheafLike (QGaugePresheaf.toPresheafLike boundary)

namespace ShEq

variable {X : Type u} [TopologicalSpace X]

/-- The source sheaf is constructed as the actual pointwise equalizer. -/
abbrev balancedSheaf (S : ShEq X) : QGaugePresheaf (Opens X) :=
  QGaugePresheaf.balancedEqualizerSheaf S.resIn S.resOut

/-- Pointwise equalizers of the two proved sheaves are again proved sheaves. -/
theorem balanced_isSheaf (S : ShEq X) :
    IsSheafLike (QGaugePresheaf.toPresheafLike S.balancedSheaf) :=
  QGaugePresheaf.balancedEqualizer_isSheaf
    S.resIn S.resOut S.ambient_isSheaf S.boundary_isSheaf

/-- A morphism in `Sh(Eq)` is a morphism of the entire parallel-pair diagram.
In particular, it acts on both the ambient and boundary sheaves and commutes
with the two boundary arrows. -/
structure Hom (S T : ShEq X) where
  ambientMap : QGaugePresheaf.Morphism S.ambient T.ambient
  boundaryMap : QGaugePresheaf.Morphism S.boundary T.boundary
  resIn_comm :
    ∀ (U : Opens X) (s : S.ambient.Field U),
      boundaryMap.app U (S.resIn.app U s) =
        T.resIn.app U (ambientMap.app U s)
  resOut_comm :
    ∀ (U : Opens X) (s : S.ambient.Field U),
      boundaryMap.app U (S.resOut.app U s) =
        T.resOut.app U (ambientMap.app U s)

namespace Hom

/-- A morphism of parallel-pair diagrams induces a natural morphism between
their pointwise equalizer sheaves. -/
def balancedMap {S T : ShEq X} (f : Hom S T) :
    QGaugePresheaf.Morphism S.balancedSheaf T.balancedSheaf where
  app := fun U s => ⟨f.ambientMap.app U s.1, by
    calc
      T.resIn.app U (f.ambientMap.app U s.1) =
          f.boundaryMap.app U (S.resIn.app U s.1) :=
        (f.resIn_comm U s.1).symm
      _ = f.boundaryMap.app U (S.resOut.app U s.1) :=
        congrArg (f.boundaryMap.app U) s.2
      _ = T.resOut.app U (f.ambientMap.app U s.1) :=
        f.resOut_comm U s.1⟩
  naturality := by
    intro U V hUV s
    apply Subtype.ext
    exact f.ambientMap.naturality hUV s.1

def id (S : ShEq X) : Hom S S where
  ambientMap := QGaugePresheaf.Morphism.id S.ambient
  boundaryMap := QGaugePresheaf.Morphism.id S.boundary
  resIn_comm := by
    intro U s
    rfl
  resOut_comm := by
    intro U s
    rfl

def comp {S T R : ShEq X} (f : Hom S T) (g : Hom T R) : Hom S R where
  ambientMap := QGaugePresheaf.Morphism.comp f.ambientMap g.ambientMap
  boundaryMap := QGaugePresheaf.Morphism.comp f.boundaryMap g.boundaryMap
  resIn_comm := by
    intro U s
    calc
      g.boundaryMap.app U
          (f.boundaryMap.app U (S.resIn.app U s)) =
          g.boundaryMap.app U
            (T.resIn.app U (f.ambientMap.app U s)) :=
        congrArg (g.boundaryMap.app U) (f.resIn_comm U s)
      _ = R.resIn.app U
          (g.ambientMap.app U (f.ambientMap.app U s)) :=
        g.resIn_comm U (f.ambientMap.app U s)
  resOut_comm := by
    intro U s
    calc
      g.boundaryMap.app U
          (f.boundaryMap.app U (S.resOut.app U s)) =
          g.boundaryMap.app U
            (T.resOut.app U (f.ambientMap.app U s)) :=
        congrArg (g.boundaryMap.app U) (f.resOut_comm U s)
      _ = R.resOut.app U
          (g.ambientMap.app U (f.ambientMap.app U s)) :=
        g.resOut_comm U (f.ambientMap.app U s)

@[simp] theorem balancedMap_id (S : ShEq X) :
    (id S).balancedMap = QGaugePresheaf.Morphism.id S.balancedSheaf := by
  apply QGaugePresheaf.Morphism.ext
  intro U s
  apply Subtype.ext
  rfl

@[simp] theorem balancedMap_comp {S T R : ShEq X}
    (f : Hom S T) (g : Hom T R) :
    (comp f g).balancedMap =
      QGaugePresheaf.Morphism.comp f.balancedMap g.balancedMap := by
  apply QGaugePresheaf.Morphism.ext
  intro U s
  apply Subtype.ext
  rfl

theorem ext {S T : ShEq X} {f g : Hom S T}
    (hAmbient : f.ambientMap = g.ambientMap)
    (hBoundary : f.boundaryMap = g.boundaryMap) : f = g := by
  cases f
  cases g
  cases hAmbient
  cases hBoundary
  rfl

end Hom

instance : Category (ShEq X) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp
  id_comp := by
    intro S T f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.id_comp f.ambientMap
    · exact QGaugePresheaf.Morphism.id_comp f.boundaryMap
  comp_id := by
    intro S T f
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_id f.ambientMap
    · exact QGaugePresheaf.Morphism.comp_id f.boundaryMap
  assoc := by
    intro S T R Q f g h
    apply Hom.ext
    · exact QGaugePresheaf.Morphism.comp_assoc
        f.ambientMap g.ambientMap h.ambientMap
    · exact QGaugePresheaf.Morphism.comp_assoc
        f.boundaryMap g.boundaryMap h.boundaryMap

end ShEq

/-- Standalone target category: a proved sheaf.  The paper's analytic spectral
profile is not encoded in this object; a clearly labelled zero-residue model
is constructed separately below. -/
structure ShP (X : Type u) [TopologicalSpace X] where
  sheaf : QGaugePresheaf.{u, v} (Opens X)
  isSheaf : IsSheafLike (QGaugePresheaf.toPresheafLike sheaf)

namespace ShP

variable {X : Type u} [TopologicalSpace X]

/-- Morphisms preserve the underlying sheaf and therefore all restrictions. -/
structure Hom (S T : ShP X) where
  sheafMap : QGaugePresheaf.Morphism S.sheaf T.sheaf

namespace Hom

def id (S : ShP X) : Hom S S where
  sheafMap := QGaugePresheaf.Morphism.id S.sheaf

def comp {S T R : ShP X} (f : Hom S T) (g : Hom T R) : Hom S R where
  sheafMap := QGaugePresheaf.Morphism.comp f.sheafMap g.sheafMap

theorem ext {S T : ShP X} {f g : Hom S T}
    (h : f.sheafMap = g.sheafMap) : f = g := by
  cases f
  cases g
  cases h
  rfl

end Hom

instance : Category (ShP X) where
  Hom := Hom
  id := Hom.id
  comp := Hom.comp
  id_comp := by
    intro S T f
    apply Hom.ext
    exact QGaugePresheaf.Morphism.id_comp f.sheafMap
  comp_id := by
    intro S T f
    apply Hom.ext
    exact QGaugePresheaf.Morphism.comp_id f.sheafMap
  assoc := by
    intro S T R Q f g h
    apply Hom.ext
    exact QGaugePresheaf.Morphism.comp_assoc
      f.sheafMap g.sheafMap h.sheafMap

end ShP

namespace ZeroPrimeLocalProfileModel

variable {X : Type u} [TopologicalSpace X]

/-- A local section together with its residue coordinate at the prime `p`. -/
abbrev Carrier (S : ShP X) (U : Opens X) (p : PrimeIndex) :=
  S.sheaf.Field U × ZMod p.1

/-- Restrict the section component and preserve the prime residue. -/
noncomputable def restrict (S : ShP X) {U V : Opens X} (hUV : U ≤ V)
    (p : PrimeIndex) : Carrier S V p → Carrier S U p :=
  fun x => (S.sheaf.res hUV x.1, x.2)

@[simp] theorem restrict_fst (S : ShP X) {U V : Opens X}
    (hUV : U ≤ V) (p : PrimeIndex) (x : Carrier S V p) :
    (restrict S hUV p x).1 = S.sheaf.res hUV x.1 := rfl

@[simp] theorem restrict_snd (S : ShP X) {U V : Opens X}
    (hUV : U ≤ V) (p : PrimeIndex) (x : Carrier S V p) :
    (restrict S hUV p x).2 = x.2 := rfl

theorem restrict_id (S : ShP X) (U : Opens X) (p : PrimeIndex)
    (x : Carrier S U p) : restrict S (le_refl U) p x = x := by
  apply Prod.ext
  · exact S.sheaf.res_id U x.1
  · rfl

theorem restrict_comp (S : ShP X) {U V W : Opens X}
    (hUV : U ≤ V) (hVW : V ≤ W) (p : PrimeIndex)
    (x : Carrier S W p) :
    restrict S hUV p (restrict S hVW p x) =
      restrict S (le_trans hUV hVW) p x := by
  apply Prod.ext
  · exact S.sheaf.res_comp hUV hVW x.1
  · rfl

/-- Synthetic zero-residue profile used only by the standalone model.  It is
not an identification with the paper's undeclared analytic spectral profile. -/
def localSpectralProfile (S : ShP X) (U : Opens X)
    (s : S.sheaf.Field U) (p : PrimeIndex) : Carrier S U p :=
  (s, 0)

@[simp] theorem localSpectralProfile_fst (S : ShP X) (U : Opens X)
    (s : S.sheaf.Field U) (p : PrimeIndex) :
    (localSpectralProfile S U s p).1 = s := rfl

@[simp] theorem localSpectralProfile_snd (S : ShP X) (U : Opens X)
    (s : S.sheaf.Field U) (p : PrimeIndex) :
    (localSpectralProfile S U s p).2 = 0 := rfl

/-- The construction commutes with every sheaf restriction. -/
theorem localSpectralProfile_restrict (S : ShP X)
    {U V : Opens X} (hUV : U ≤ V) (s : S.sheaf.Field V)
    (p : PrimeIndex) :
    restrict S hUV p (localSpectralProfile S V s p) =
      localSpectralProfile S U (S.sheaf.res hUV s) p :=
  rfl

/-- The two normalization equations characterize the constructed profile. -/
theorem localSpectralProfile_unique (S : ShP X) (U : Opens X)
    (s : S.sheaf.Field U) (p : PrimeIndex) (x : Carrier S U p)
    (hsection : x.1 = s) (hresidue : x.2 = 0) :
    x = localSpectralProfile S U s p := by
  apply Prod.ext
  · exact hsection
  · exact hresidue

/-- Existence and uniqueness gives the exact meaning of `canonical` inside
this zero-residue model only. -/
theorem existsUnique_normalized (S : ShP X) (U : Opens X)
    (s : S.sheaf.Field U) (p : PrimeIndex) :
    ∃! x : Carrier S U p, x.1 = s ∧ x.2 = 0 := by
  refine ⟨localSpectralProfile S U s p, ⟨rfl, rfl⟩, ?_⟩
  intro x hx
  exact localSpectralProfile_unique S U s p x hx.1 hx.2

/-- A target morphism induces a morphism of every prime-local profile. -/
def map {S T : ShP X} (f : S ⟶ T) (U : Opens X)
    (p : PrimeIndex) : Carrier S U p → Carrier T U p :=
  fun x => (f.sheafMap.app U x.1, x.2)

@[simp] theorem map_fst {S T : ShP X} (f : S ⟶ T)
    (U : Opens X) (p : PrimeIndex) (x : Carrier S U p) :
    (map f U p x).1 = f.sheafMap.app U x.1 := rfl

@[simp] theorem map_snd {S T : ShP X} (f : S ⟶ T)
    (U : Opens X) (p : PrimeIndex) (x : Carrier S U p) :
    (map f U p x).2 = x.2 := rfl

/-- Profile maps are natural with respect to restrictions. -/
theorem map_restrict {S T : ShP X} (f : S ⟶ T)
    {U V : Opens X} (hUV : U ≤ V) (p : PrimeIndex)
    (x : Carrier S V p) :
    restrict T hUV p (map f V p x) =
      map f U p (restrict S hUV p x) := by
  apply Prod.ext
  · exact f.sheafMap.naturality hUV x.1
  · rfl

/-- Morphisms preserve the internally constructed zero-residue profile. -/
theorem map_localSpectralProfile {S T : ShP X} (f : S ⟶ T)
    (U : Opens X) (s : S.sheaf.Field U) (p : PrimeIndex) :
    map f U p (localSpectralProfile S U s p) =
      localSpectralProfile T U (f.sheafMap.app U s) p :=
  rfl

theorem map_id (S : ShP X) (U : Opens X) (p : PrimeIndex)
    (x : Carrier S U p) : map (𝟙 S) U p x = x := by
  apply Prod.ext <;> rfl

theorem map_comp {S T R : ShP X} (f : S ⟶ T) (g : T ⟶ R)
    (U : Opens X) (p : PrimeIndex) (x : Carrier S U p) :
    map (f ≫ g) U p x = map g U p (map f U p x) := by
  apply Prod.ext <;> rfl

end ZeroPrimeLocalProfileModel

/-- Standalone equalizer-to-sheaf functor.  It constructs the target sheaf
from the source diagram and does not copy any `primeIndexMap` input field.
Identifying this category with the paper's `Sh(P)` remains separate data. -/
def F {X : Type u} [TopologicalSpace X] : ShEq X ⥤ ShP X where
  obj S := ⟨S.balancedSheaf, S.balanced_isSheaf⟩
  map f := ⟨f.balancedMap⟩
  map_id := by
    intro S
    apply ShP.Hom.ext
    change (ShEq.Hom.id S).balancedMap =
      QGaugePresheaf.Morphism.id S.balancedSheaf
    exact ShEq.Hom.balancedMap_id S
  map_comp := by
    intro S T R f g
    apply ShP.Hom.ext
    change (ShEq.Hom.comp f g).balancedMap =
      QGaugePresheaf.Morphism.comp f.balancedMap g.balancedMap
    exact ShEq.Hom.balancedMap_comp f g

@[simp] theorem F_obj_sheaf {X : Type u} [TopologicalSpace X]
    (S : ShEq X) : (F.obj S).sheaf = S.balancedSheaf := rfl

@[simp] theorem F_map_sheafMap {X : Type u} [TopologicalSpace X]
    {S T : ShEq X} (f : S ⟶ T) :
    (F.map f).sheafMap = f.balancedMap := rfl

theorem F_zeroProfile_is_constructed_model
    {X : Type u} [TopologicalSpace X]
    (S : ShEq X) (U : Opens X) (s : S.balancedSheaf.Field U)
    (p : PrimeIndex) :
    ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj S) U s p =
      (s, 0) :=
  rfl

theorem F_zeroProfile_restrict_model
    {X : Type u} [TopologicalSpace X]
    (S : ShEq X) {U V : Opens X} (hUV : U ≤ V)
    (s : S.balancedSheaf.Field V) (p : PrimeIndex) :
    ZeroPrimeLocalProfileModel.restrict (F.obj S) hUV p
        (ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj S) V s p) =
      ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj S) U
        (S.balancedSheaf.res hUV s) p :=
  ZeroPrimeLocalProfileModel.localSpectralProfile_restrict (F.obj S) hUV s p

theorem F_map_zeroProfile_natural_model
    {X : Type u} [TopologicalSpace X]
    {S T : ShEq X} (f : S ⟶ T) (U : Opens X)
    (s : S.balancedSheaf.Field U) (p : PrimeIndex) :
    ZeroPrimeLocalProfileModel.map (F.map f) U p
        (ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj S) U s p) =
      ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj T) U
        (f.balancedMap.app U s) p :=
  ZeroPrimeLocalProfileModel.map_localSpectralProfile (F.map f) U s p

/-! ### Source and target equalizer universal properties after evaluation -/

variable {X : Type u} [TopologicalSpace X]

/-- The two evaluated restriction maps as morphisms in the category of types. -/
def sourceResInType (S : ShEq X) (U : Opens X) :
    S.ambient.Field U ⟶ S.boundary.Field U :=
  ↾(S.resIn.app U)

def sourceResOutType (S : ShEq X) (U : Opens X) :
    S.ambient.Field U ⟶ S.boundary.Field U :=
  ↾(S.resOut.app U)

theorem sourceInclusion_condition (S : ShEq X) (U : Opens X) :
    ↾(fun e : S.balancedSheaf.Field U => e.1) ≫ sourceResInType S U =
      ↾(fun e : S.balancedSheaf.Field U => e.1) ≫ sourceResOutType S U := by
  apply ConcreteCategory.hom_ext
  intro e
  exact e.2

def sourceEqualizerFork (S : ShEq X) (U : Opens X) :
    Fork (sourceResInType S U) (sourceResOutType S U) :=
  Fork.ofι (↾(fun e : S.balancedSheaf.Field U => e.1))
    (sourceInclusion_condition S U)

theorem competingFork_condition (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U)) (x : T.pt) :
    S.resIn.app U (T.ι x) = S.resOut.app U (T.ι x) := by
  have h := ConcreteCategory.congr_hom T.condition x
  simpa [sourceResInType, sourceResOutType] using h

def sourceEqualizerLift (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U)) :
    T.pt ⟶ S.balancedSheaf.Field U :=
  ↾(fun x => ⟨T.ι x, competingFork_condition S U T x⟩)

theorem sourceEqualizerLift_fac (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U)) :
    sourceEqualizerLift S U T ≫ (sourceEqualizerFork S U).ι = T.ι := by
  apply ConcreteCategory.hom_ext
  intro x
  rfl

theorem sourceEqualizerLift_unique (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U))
    (m : T.pt ⟶ S.balancedSheaf.Field U)
    (hm : m ≫ (sourceEqualizerFork S U).ι = T.ι) :
    m = sourceEqualizerLift S U T := by
  apply ConcreteCategory.hom_ext
  intro x
  apply Subtype.ext
  change ((m ≫ (sourceEqualizerFork S U).ι) x) = T.ι x
  exact ConcreteCategory.congr_hom hm x

def sourceEqualizerForkIsLimit (S : ShEq X) (U : Opens X) :
    IsLimit (sourceEqualizerFork S U) := by
  refine Fork.IsLimit.mk' _ fun T => ?_
  refine ⟨sourceEqualizerLift S U T, sourceEqualizerLift_fac S U T, ?_⟩
  intro m hm
  exact sourceEqualizerLift_unique S U T m hm

/-- The target fork is rebuilt from `F.obj S`; its point is the constructed
target sheaf rather than a copied profile datum. -/
def targetEqualizerFork (S : ShEq X) (U : Opens X) :
    Fork (sourceResInType S U) (sourceResOutType S U) :=
  Fork.ofι (↾(fun e : (F.obj S).sheaf.Field U => e.1))
    (sourceInclusion_condition S U)

def targetEqualizerLift (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U)) :
    T.pt ⟶ (F.obj S).sheaf.Field U :=
  ↾(fun x => ⟨T.ι x, competingFork_condition S U T x⟩)

theorem targetEqualizerLift_fac (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U)) :
    targetEqualizerLift S U T ≫ (targetEqualizerFork S U).ι = T.ι := by
  apply ConcreteCategory.hom_ext
  intro x
  rfl

theorem targetEqualizerLift_unique (S : ShEq X) (U : Opens X)
    (T : Fork (sourceResInType S U) (sourceResOutType S U))
    (m : T.pt ⟶ (F.obj S).sheaf.Field U)
    (hm : m ≫ (targetEqualizerFork S U).ι = T.ι) :
    m = targetEqualizerLift S U T := by
  apply ConcreteCategory.hom_ext
  intro x
  apply Subtype.ext
  change ((m ≫ (targetEqualizerFork S U).ι) x) = T.ι x
  exact ConcreteCategory.congr_hom hm x

/-- The target fork has the equalizer universal property.  This is deliberately
not named `PreservesLimit`: `F` is a functor between the standalone sheaf
categories, whereas this fork lives in `Type` after evaluation at one open. -/
def targetEqualizerForkIsLimit (S : ShEq X) (U : Opens X) :
    IsLimit (targetEqualizerFork S U) := by
  refine Fork.IsLimit.mk' _ fun T => ?_
  refine ⟨targetEqualizerLift S U T, targetEqualizerLift_fac S U T, ?_⟩
  intro m hm
  exact targetEqualizerLift_unique S U T m hm

noncomputable def targetEqualizerIso (S : ShEq X) (U : Opens X) :
    (F.obj S).sheaf.Field U ≅
      equalizer (sourceResInType S U) (sourceResOutType S U) :=
  IsLimit.conePointUniqueUpToIso (targetEqualizerForkIsLimit S U)
    (limit.isLimit (parallelPair (sourceResInType S U) (sourceResOutType S U)))

/-! ### Fixed-parameter constant derived-Tor comparison model -/

/-- Constant source functor with value Mathlib's actual left-derived `Tor'₁`.
It does not claim that the obstruction object varies with a sheaf diagram. -/
def constantSourceTorFunctor_model (M N : ℕ) : ShEq X ⥤ ModuleCat ℤ where
  obj _ := Tor1ZDerivedComparison.MathlibTor1Z M N
  map _ := 𝟙 _
  map_id := by intro S; rfl
  map_comp := by intro S T R f g; simp

/-- Constant target functor with value the explicit multiplication-kernel
module obtained from the standard resolution. -/
def constantTargetTorFunctor_model (M N : ℕ) : ShP X ⥤ ModuleCat ℤ where
  obj _ := Tor1ZDerivedComparison.tor1CyclicModule M N
  map _ := 𝟙 _
  map_id := by intro S; rfl
  map_comp := by intro S T R f g; simp

/-- Natural isomorphism between the two constant functors, induced by the
actual projective-resolution comparison at every object.  This is a rigorous
fixed-parameter model, not the paper's unstated sheaf-dependent Tor law. -/
noncomputable def constantTorComparisonIso_model
    (M N : ℕ) (hM : M ≠ 0) :
    constantSourceTorFunctor_model (X := X) M N ≅
      F ⋙ constantTargetTorFunctor_model (X := X) M N :=
  NatIso.ofComponents
    (fun _ => Tor1ZDerivedComparison.mathlibTor1ZIsoCyclicModel M N hM)
    (by
      intro S T f
      simp [constantSourceTorFunctor_model, constantTargetTorFunctor_model])

@[simp] theorem constantTorComparisonIso_model_hom_app
    (M N : ℕ) (hM : M ≠ 0)
    (S : ShEq X) :
    (constantTorComparisonIso_model (X := X) M N hM).hom.app S =
      (Tor1ZDerivedComparison.mathlibTor1ZIsoCyclicModel M N hM).hom :=
  rfl

/-- The constant comparison commutes with every source morphism. -/
theorem constantTorNaturalitySquare_model (M N : ℕ) (hM : M ≠ 0)
    {S T : ShEq X} (f : S ⟶ T) :
    (constantSourceTorFunctor_model (X := X) M N).map f ≫
        (constantTorComparisonIso_model (X := X) M N hM).hom.app T =
      (constantTorComparisonIso_model (X := X) M N hM).hom.app S ≫
        (F ⋙ constantTargetTorFunctor_model (X := X) M N).map f :=
  (constantTorComparisonIso_model (X := X) M N hM).hom.naturality f

/-! ### Actual Definition 14 source object -/

abbrev Definition14Base := Definition11.RadiusBase
abbrev Definition14Opens := TopologicalSpace.Opens Definition14Base

/-- Definition 14's nontrivial inside/outside equalizer as an actual source
object of the standalone Proposition-15 category. -/
def definition14Source : ShEq Definition14Base where
  ambient := Definition14Boundary.Aq
    Definition11.scalarAnalyticData Mmock.unitKernel Mmock.zeroCommonAnnulus
  boundary := Definition14Boundary.Bq Mmock.zeroCommonAnnulus
  resIn := Definition14Boundary.resIn
    Definition11.scalarAnalyticData Mmock.unitKernel Mmock.zeroCommonAnnulus
  resOut := Definition14Boundary.resOut
    Definition11.scalarAnalyticData Mmock.unitKernel Mmock.zeroCommonAnnulus
  ambient_isSheaf := Definition14Boundary.Aq_isSheaf
    Definition11.scalarAnalyticData Mmock.unitKernel Mmock.zeroCommonAnnulus
  boundary_isSheaf :=
    Definition14Boundary.Bq_isSheaf Mmock.zeroCommonAnnulus

@[simp] theorem definition14Source_balancedSheaf :
    definition14Source.balancedSheaf =
      Definition14Boundary.EqSheaf
        Definition11.scalarAnalyticData Mmock.unitKernel
        Mmock.zeroCommonAnnulus :=
  rfl

theorem definition14Source_balanced_isSheaf :
    IsSheafLike
      (QGaugePresheaf.toPresheafLike definition14Source.balancedSheaf) :=
  definition14Source.balanced_isSheaf

/-- The internally profiled target of the actual Definition-14 equalizer. -/
def definition14Target : ShP Definition14Base :=
  F.obj definition14Source

theorem definition14Target_profile_is_constructed
    (U : Definition14Opens)
    (s : definition14Source.balancedSheaf.Field U) (p : PrimeIndex) :
    ZeroPrimeLocalProfileModel.localSpectralProfile
      definition14Target U s p = (s, 0) :=
  rfl

/-! ### Actual Proposition 20 source object -/

abbrev ActualBase := Proposition20ActualQGaugeSpecialization.Base
abbrev ActualOpens := Proposition20ActualQGaugeSpecialization.Opens

/-- The concrete Proposition 16 q-gauge sheaf presented as the equalizer of
its two identity maps.  This is a genuine `Sh(Eq)` object and does not require
new boundary assumptions. -/
def actualSource : ShEq.{0, 0} ActualBase where
  ambient := Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf
  boundary := Proposition20ActualQGaugeSpecialization.actualQGaugePresheaf
  resIn := QGaugePresheaf.Morphism.id _
  resOut := QGaugePresheaf.Morphism.id _
  ambient_isSheaf :=
    Proposition20ActualQGaugeSpecialization.proposition16_supplies_hAq
  boundary_isSheaf :=
    Proposition20ActualQGaugeSpecialization.proposition16_supplies_hAq

/-- Every actual q-gauge section is canonically the corresponding point of the
identity equalizer. -/
def actualAqEquivBalanced (U : ActualOpens) :
    Proposition20ActualQGaugeSpecialization.Aq U ≃
      actualSource.balancedSheaf.Field U where
  toFun A := ⟨A, rfl⟩
  invFun A := A.1
  left_inv A := rfl
  right_inv A := by apply Subtype.ext; rfl

@[simp] theorem actualAqEquivBalanced_apply (U : ActualOpens)
    (A : Proposition20ActualQGaugeSpecialization.Aq U) :
    (actualAqEquivBalanced U A).1 = A := rfl

theorem actualAqEquivBalanced_restrict {U V : ActualOpens}
    (hUV : U ≤ V) (A : Proposition20ActualQGaugeSpecialization.Aq V) :
    actualAqEquivBalanced U
        (Proposition20ActualQGaugeSpecialization.AqPresheaf.res hUV A) =
      actualSource.balancedSheaf.res hUV
        (actualAqEquivBalanced V A) := by
  apply Subtype.ext
  rfl

/-- Proposition 20 global fields are exactly the global sections of the actual
Proposition 15 source object. -/
def actualGlobalAqEquivSource :
    Proposition20ActualQGaugeSpecialization.Aq (⊤ : ActualOpens) ≃
      actualSource.balancedSheaf.Field (⊤ : ActualOpens) :=
  actualAqEquivBalanced (⊤ : ActualOpens)

/-- Kernel form of equation (6.13) transported all the way to the actual
Proposition 15 source object. -/
noncomputable def proposition20KernelEquivActualSource
    (C : Proposition20ActualQGaugeSpecialization.AdaptedGeometryCover) :
    Proposition20ActualQGaugeSpecialization.Equation613Kernel C ≃
      actualSource.balancedSheaf.Field (⊤ : ActualOpens) :=
  (Proposition20ActualQGaugeSpecialization.proposition20ActualGlobalEquivKernel C).symm.trans
    actualGlobalAqEquivSource

/-- The concrete target object produced from actual q-gauge fields. -/
def actualTarget : ShP ActualBase := F.obj actualSource

/-- PR-facing certificate for the standalone zero-profile supplement.  It
certifies every displayed theorem below, while deliberately not identifying
the supplement with the paper's analytic `Sh(P)` category. -/
structure StandaloneZeroProfileCertificate
    (M N : ℕ) (hM : M ≠ 0) : Prop where
  definition14_source_is_actual :
    definition14Source.balancedSheaf =
      Definition14Boundary.EqSheaf
        Definition11.scalarAnalyticData Mmock.unitKernel
        Mmock.zeroCommonAnnulus
  definition14_source_isSheaf :
    IsSheafLike
      (QGaugePresheaf.toPresheafLike definition14Source.balancedSheaf)
  definition14_profile_is_constructed :
    ∀ (U : Definition14Opens)
      (s : definition14Source.balancedSheaf.Field U) (p : PrimeIndex),
      ZeroPrimeLocalProfileModel.localSpectralProfile
        definition14Target U s p = (s, 0)
  source_is_balanced_equalizer :
    ∀ S : ShEq.{0, 0} ActualBase,
      S.balancedSheaf =
        QGaugePresheaf.balancedEqualizerSheaf S.resIn S.resOut
  profile_is_constructed :
    ∀ (S : ShEq.{0, 0} ActualBase) (U : ActualOpens)
      (s : S.balancedSheaf.Field U) (p : PrimeIndex),
      ZeroPrimeLocalProfileModel.localSpectralProfile
        (F.obj S) U s p = (s, 0)
  profile_is_canonical :
    ∀ (S : ShEq.{0, 0} ActualBase) (U : ActualOpens)
      (s : S.balancedSheaf.Field U) (p : PrimeIndex),
      ∃! x : ZeroPrimeLocalProfileModel.Carrier (F.obj S) U p,
        x.1 = s ∧ x.2 = 0
  profile_restriction_natural :
    ∀ (S : ShEq.{0, 0} ActualBase) {U V : ActualOpens} (hUV : U ≤ V)
      (s : S.balancedSheaf.Field V) (p : PrimeIndex),
      ZeroPrimeLocalProfileModel.restrict (F.obj S) hUV p
          (ZeroPrimeLocalProfileModel.localSpectralProfile
            (F.obj S) V s p) =
        ZeroPrimeLocalProfileModel.localSpectralProfile (F.obj S) U
          (S.balancedSheaf.res hUV s) p
  source_equalizer_universal :
    ∀ (S : ShEq.{0, 0} ActualBase) (U : ActualOpens),
      Nonempty (IsLimit (sourceEqualizerFork S U))
  target_equalizer_universal :
