/-! ### Explicit names for retained fallback layers -/

namespace FallbackAliases

/-- The cardinality-correct cyclic object retained as a model, not as the
definition of the actual derived functor. -/
abbrev Tor1Model_model (M N : ℕ) := Tor1Model M N

/-- The legacy Cartesian-pair q-gauge presheaf, explicitly marked as a model. -/
abbrev qGaugeVariablesPresheaf_model
    {Open : Type u} [Preorder Open]
    (L : QLocalSystem Open) (M : MockBundle Open) : QGaugePresheaf Open :=
  qGaugeVariablesPresheaf L M

/-- Generic equalizer theorem whose sheaf proof is supplied as an input. -/
noncomputable def proposition20GlobalSectionsEquivEqualizer_conditional
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (hF : IsSheafLike F) {iota : Type u} (C : OpenCoverData X iota) :
    F.Section C.target ≃ F.CoverEqualizer C :=
  proposition20GlobalSectionsEquivEqualizer F hF C

/-- Generic covariance-subtype sheaf theorem with all abstract hypotheses
shown in its type. -/
theorem prop16_Aq_is_sheaf_abstract
    {X : Type u} [TopologicalSpace X] (F : PresheafLike X)
    (Covariant : CovariancePredicate F)
    (hCov : IsRestrictionStableCovariance F Covariant)
    (hF : IsSheafLike F) (hLocal : IsLocalCovariance F Covariant) :
    IsSheafLike (AqPresheaf F Covariant hCov) :=
  prop16_Aq_is_sheaf F Covariant hCov hF hLocal

/-- The old Proposition-15 copied-profile functor, retained under a name that
cannot be mistaken for the constructed-profile functor. -/
abbrev proposition15CopiedProfileFunctor_model
    {Open : Type u} [Preorder Open] :
    BalancedQGaugeSheafCategory Open ⥤ PrimalitySheafCategory Open :=
  Proposition15FunctorBridge.F

/-- The old reflexive obstruction comparison, explicitly marked as a model. -/
def proposition15TorCompatibility_model
    {Open : Type u} [Preorder Open]
    (S : BalancedQGaugeSheafCategory Open) :
    Proposition15FunctorBridge.SourceObstructionGroup S ≃+
      Proposition15FunctorBridge.TargetObstructionGroup
        (Proposition15FunctorBridge.F.obj S) :=
  Proposition15FunctorBridge.F_torCompatibility S

end FallbackAliases

/-! ### Paper-to-Lean trace map -/

namespace PaperMap

/-- The three classifications required by checklist §15. -/
inductive Status
  | complete
  | paperAssumption
  | outOfScope
  deriving DecidableEq, Repr

/-- Whether a trace row concerns the actual object, a corrected actual object,
or an explicitly supplemental standalone specification. -/
inductive ObjectKind
  | actual
  | correctedActual
  | standaloneSpecification
  | abstractFallback
  deriving DecidableEq, Repr

/-- Build execution is deliberately delegated to the user's final full-file
build, as requested. -/
inductive BuildStatus
  | deferredToUser
  | passed
  | failed
  deriving DecidableEq, Repr

/-- Exactly one constructor for every required paper identifier. -/
inductive PaperItem
  | definition11
  | definition12
  | definition13
  | definition14
  | definition15
  | lemma61
  | definition16
  | definition17
  | definition18
  | proposition14
  | proposition15
  | proposition16
  | proposition17
  | proposition18
  | proposition19
  | proposition20
  | proposition21
  deriving DecidableEq, Repr

/-- Required columns of the paper-to-Lean audit table. -/
structure TraceRow where
  item : PaperItem
  paperId : String
  exactAssumptions : String
  leanDeclaration : String
  objectKind : ObjectKind
  conclusionIsInput : Bool
  build : BuildStatus
  axiomAuditDeclaration : String
  status : Status
  note : String
  deriving Repr

/-- Conservative final classification.  Proposition 14 remains a paper
assumption because the paper's nontrivial evolution is not specified and its
flatness-implies-uniqueness clause is refuted by the constructed sign gauge.
The explicit supplemental Proposition-15 specification is complete, but the
paper item remains an assumption until that supplement is identified with
Paper 1's undeclared primality category. -/
def classification : PaperItem → Status
  | .definition11 => .complete
  | .definition12 => .complete
  | .definition13 => .complete
  | .definition14 => .complete
  | .definition15 => .complete
  | .lemma61 => .complete
  | .definition16 => .complete
  | .definition17 => .complete
  | .definition18 => .complete
  | .proposition14 => .paperAssumption
  | .proposition15 => .paperAssumption
  | .proposition16 => .complete
  | .proposition17 => .complete
  | .proposition18 => .complete
  | .proposition19 => .complete
  | .proposition20 => .paperAssumption
  | .proposition21 => .complete

