namespace Proposition14

noncomputable section

open Definition11

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

namespace HqEvolutionData

/-- Replace the displayed generator while keeping the solution predicate
unchanged.  This construction exposes that the current paper-compatible API
does not yet state a differential equation relating `Hq` to `SolvesHq`. -/
def replaceGenerator {D : AnalyticData V} (E : HqEvolutionData D)
    (H : ∀ r : RadiusBase, Fibre D r →ₗ[ℂ] Fibre D r) :
    HqEvolutionData D where
  Hq := H
  SolvesHq := E.SolvesHq
  initial_value := E.initial_value

@[simp] theorem replaceGenerator_Hq_apply {D : AnalyticData V}
    (E : HqEvolutionData D)
    (H : ∀ r : RadiusBase, Fibre D r →ₗ[ℂ] Fibre D r)
    (r : RadiusBase) (u : Fibre D r) :
    (E.replaceGenerator H).Hq r u = H r u :=
  rfl

theorem replaceGenerator_solves_iff {D : AnalyticData V}
    (E : HqEvolutionData D)
    (H : ∀ r : RadiusBase, Fibre D r →ₗ[ℂ] Fibre D r)
    {r s : RadiusBase} (gamma : RadiusPath r s)
    (u0 : Fibre D r) (u : Trajectory D gamma) :
    (E.replaceGenerator H).SolvesHq gamma u0 u ↔
      E.SolvesHq gamma u0 u :=
  Iff.rfl

end HqEvolutionData

/-- Well-posedness is preserved by generator replacement because the current
solution predicate is independent of the displayed generator. -/
theorem HqEvolutionWellPosed.replaceGenerator
    {D : AnalyticData V} {E : HqEvolutionData D}
    (W : HqEvolutionWellPosed E)
    (H : ∀ r : RadiusBase, Fibre D r →ₗ[ℂ] Fibre D r) :
    HqEvolutionWellPosed (E.replaceGenerator H) :=
  ⟨W.existsUnique_solution⟩

/-- The corrected constant-trajectory relation equipped with a nonzero
identity generator. -/
def identityGeneratorEvolution (D : AnalyticData V) : HqEvolutionData D :=
  (correctedEvolution D).replaceGenerator (fun _ => LinearMap.id)

@[simp] theorem identityGeneratorEvolution_Hq_apply
    (D : AnalyticData V) (r : RadiusBase) (u : Fibre D r) :
    (identityGeneratorEvolution D).Hq r u = u :=
  rfl

theorem identityGeneratorEvolution_solves_iff
    (D : AnalyticData V) {r s : RadiusBase}
    (gamma : RadiusPath r s) (u0 : Fibre D r)
    (u : Trajectory D gamma) :
    (identityGeneratorEvolution D).SolvesHq gamma u0 u ↔
      ∀ a, u a = u0 :=
  Iff.rfl

theorem identityGeneratorEvolutionWellPosed (D : AnalyticData V) :
    HqEvolutionWellPosed (identityGeneratorEvolution D) :=
  (correctedEvolutionWellPosed D).replaceGenerator
    (fun _ => LinearMap.id)

/-- On a nonzero fibre the zero and identity generators are distinct. -/
theorem scalar_zero_and_identity_generators_distinct :
    (correctedEvolution scalarAnalyticData).Hq halfRadius ≠
      (identityGeneratorEvolution scalarAnalyticData).Hq halfRadius := by
  intro hgenerator
  let u : Fibre scalarAnalyticData halfRadius :=
    scalarSolution 1 halfRadius
  have hvalue := congrArg
    (fun T : Fibre scalarAnalyticData halfRadius →ₗ[ℂ]
        Fibre scalarAnalyticData halfRadius => T u) hgenerator
  have hu : (0 : Fibre scalarAnalyticData halfRadius) = u := by
    simpa [u] using hvalue
  exact scalarSolution_ne_zero one_ne_zero halfRadius hu.symm

/-- Nevertheless the two generators induce definitionally identical solution
relations in the current interface. -/
theorem scalar_zero_and_identity_same_solutions
    {r s : RadiusBase} (gamma : RadiusPath r s)
    (u0 : Fibre scalarAnalyticData r)
    (u : Trajectory scalarAnalyticData gamma) :
    (correctedEvolution scalarAnalyticData).SolvesHq gamma u0 u ↔
      (identityGeneratorEvolution scalarAnalyticData).SolvesHq gamma u0 u :=
  Iff.rfl

/-- Formal certificate that the present interface cannot by itself certify
the paper's phrase "evolution equation for Hq". -/
structure EvolutionInterfaceAudit : Prop where
  generators_distinct :
    (correctedEvolution scalarAnalyticData).Hq halfRadius ≠
      (identityGeneratorEvolution scalarAnalyticData).Hq halfRadius
  solution_relations_identical :
    ∀ {r s : RadiusBase} (gamma : RadiusPath r s)
      (u0 : Fibre scalarAnalyticData r)
      (u : Trajectory scalarAnalyticData gamma),
      (correctedEvolution scalarAnalyticData).SolvesHq gamma u0 u ↔
        (identityGeneratorEvolution scalarAnalyticData).SolvesHq gamma u0 u
  zero_generator_wellPosed :
    HqEvolutionWellPosed (correctedEvolution scalarAnalyticData)
  identity_generator_wellPosed :
    HqEvolutionWellPosed (identityGeneratorEvolution scalarAnalyticData)

theorem evolutionInterface_audit : EvolutionInterfaceAudit :=
  { generators_distinct := scalar_zero_and_identity_generators_distinct
    solution_relations_identical := scalar_zero_and_identity_same_solutions
    zero_generator_wellPosed :=
      correctedEvolutionWellPosed scalarAnalyticData
    identity_generator_wellPosed :=
      identityGeneratorEvolutionWellPosed scalarAnalyticData }

/-- Every radius-dependent choice of fibre gauge produces a flat transport by
the endpoint formula `G(r)^{-1} G(s)`. -/
def gaugeFlatTransport (D : AnalyticData V)
    (G : ∀ r : RadiusBase, Fibre D r ≃ₗ[ℂ] Fibre D r) :
    FlatTransport D where
  map := fun {r s} _ => (G r).symm.trans (G s)
  map_refl := by
    intro r
    apply LinearEquiv.ext
    intro u
    simp
  map_trans := by
    intro r s t gamma eta
    apply LinearEquiv.ext
    intro u
    simp

/-- A nonconstant gauge on the explicit scalar fibre: negation at radius
`1/2`, and the identity elsewhere. -/
noncomputable def scalarSignGauge (r : RadiusBase) :
    Fibre scalarAnalyticData r ≃ₗ[ℂ] Fibre scalarAnalyticData r := by
  classical
  exact if r = halfRadius then LinearEquiv.neg ℂ else LinearEquiv.refl ℂ _

@[simp] theorem scalarSignGauge_half :
    scalarSignGauge halfRadius = LinearEquiv.neg ℂ := by
  classical
  simp [scalarSignGauge]

@[simp] theorem scalarSignGauge_quarter :
    scalarSignGauge quarterRadius = LinearEquiv.refl ℂ _ := by
  classical
  simp [scalarSignGauge, quarterRadius_ne_halfRadius]

/-- The second, gauge-twisted flat transport on the nonzero scalar local
system. -/
def scalarSignFlatTransport : FlatTransport scalarAnalyticData :=
  gaugeFlatTransport scalarAnalyticData scalarSignGauge

@[simp] theorem scalarSignFlatTransport_halfToQuarter
    (u : Fibre scalarAnalyticData halfRadius) :
    scalarSignFlatTransport.alongPath halfToQuarterPath u = -u := by
  change scalarSignGauge quarterRadius
    ((scalarSignGauge halfRadius).symm u) = -u
  rw [scalarSignGauge_half, scalarSignGauge_quarter]
  simp [LinearEquiv.neg_apply]

@[simp] theorem scalarCanonicalFlatTransport_halfToQuarter
    (u : Fibre scalarAnalyticData halfRadius) :
    (canonicalFlatTransport scalarAnalyticData).alongPath
        halfToQuarterPath u = u :=
  rfl

theorem scalarSolution_one_ne_neg (r : RadiusBase) :
    scalarSolution 1 r ≠ -scalarSolution 1 r := by
  intro h
  have hvalue := congrArg
    (fun u : Fibre scalarAnalyticData r => (u.1 : ℂ)) h
  norm_num [scalarSolution] at hvalue

/-- Flatness alone does not imply the uniqueness claimed in Proposition 14:
the same nonzero constant local system admits two distinct flat transports.
The paper must specify an evolution equation and its relation to transport to
recover a valid uniqueness theorem. -/
theorem flatTransport_not_unique_from_flatness :
    canonicalFlatTransport scalarAnalyticData ≠ scalarSignFlatTransport := by
  intro htransport
  have hvalue := congrArg
    (fun T : FlatTransport scalarAnalyticData =>
      T.alongPath halfToQuarterPath
        (scalarSolution 1 halfRadius)) htransport
  have hneg :
      scalarSolution 1 quarterRadius = -scalarSolution 1 quarterRadius := by
    simpa [scalarSolution] using hvalue
  exact scalarSolution_one_ne_neg quarterRadius hneg

end

end Proposition14

