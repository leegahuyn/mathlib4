/-- The ordered paper map: one row for every required identifier. -/
def paperTrace : List TraceRow :=
  [ traceRow .definition11
  , traceRow .definition12
  , traceRow .definition13
  , traceRow .definition14
  , traceRow .definition15
  , traceRow .lemma61
  , traceRow .definition16
  , traceRow .definition17
  , traceRow .definition18
  , traceRow .proposition14
  , traceRow .proposition15
  , traceRow .proposition16
  , traceRow .proposition17
  , traceRow .proposition18
  , traceRow .proposition19
  , traceRow .proposition20
  , traceRow .proposition21 ]

@[simp] theorem traceRow_item (i : PaperItem) : (traceRow i).item = i := by
  cases i <;> rfl

@[simp] theorem traceRow_build (i : PaperItem) :
    (traceRow i).build = .deferredToUser := by
  cases i <;> rfl

theorem classification_total (i : PaperItem) :
    classification i = .complete ∨
      classification i = .paperAssumption ∨
      classification i = .outOfScope := by
  cases i <;> simp [classification]

theorem paperTrace_has_required_row_count : paperTrace.length = 17 :=
  rfl

theorem every_required_item_mem (i : PaperItem) :
    i ∈ paperTrace.map TraceRow.item := by
  cases i <;> simp [paperTrace]

theorem paperTrace_items_nodup :
    (paperTrace.map TraceRow.item).Nodup := by
  decide

/-- Machine-checkable certificate for the required paper map. -/
structure Certificate : Prop where
  row_identity : ∀ i : PaperItem, (traceRow i).item = i
  classifications_are_total : ∀ i : PaperItem,
    classification i = .complete ∨
      classification i = .paperAssumption ∨
      classification i = .outOfScope
  all_builds_deferred_as_requested : ∀ i : PaperItem,
    (traceRow i).build = .deferredToUser
  required_row_count : paperTrace.length = 17
  every_required_item_occurs :
    ∀ i : PaperItem, i ∈ paperTrace.map TraceRow.item
  no_required_item_is_duplicated :
    (paperTrace.map TraceRow.item).Nodup
  proposition14_boundary_visible :
    classification .proposition14 = .paperAssumption
  proposition15_paper_boundary_visible :
    classification .proposition15 = .paperAssumption
  proposition15_standalone_certificate :
    Proposition15ActualFunctor.StandaloneZeroProfileCertificate
      2 2 (by norm_num)
  proposition20_geometry_boundary_visible :
    classification .proposition20 = .paperAssumption

theorem certificate : Certificate where
  row_identity := traceRow_item
  classifications_are_total := classification_total
  all_builds_deferred_as_requested := traceRow_build
  required_row_count := paperTrace_has_required_row_count
  every_required_item_occurs := every_required_item_mem
  no_required_item_is_duplicated := paperTrace_items_nodup
  proposition14_boundary_visible := rfl
  proposition15_paper_boundary_visible := rfl
  proposition15_standalone_certificate :=
    Proposition15ActualFunctor.checklist_9_standalone_zeroProfile
  proposition20_geometry_boundary_visible := rfl

end PaperMap

