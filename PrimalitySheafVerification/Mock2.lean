/-- The corrected `Lq` solution fibre used in Definitions 12–13. -/
abbrev ActualLqFibre (D : Definition11.AnalyticData V) : ModuleCat ℂ :=
  ModuleCat.of ℂ D.solutionSpace

/-- The certified homogeneous `Mmock` variation fibre. -/
abbrev ActualMmockFibre (A : Set ℂ) : ModuleCat ℂ :=
  MmockLinear.variationModule A

/-- Exact analytic/operator input required for the nontrivial Definition 13
specialization. -/
abbrev ActualFibreOperators (D : Definition11.AnalyticData V) (A : Set ℂ) :=
  FibreOperators (ActualLqFibre D) (ActualMmockFibre A)

/-- The specialized codomain presheaf `Aq ⊗ Ω¹_(0,1)`. -/
def actualAqOmega1Presheaf (D : Definition11.AnalyticData V) (A : Set ℂ) :
    LinearPresheaf Definition11.RadiusBase :=
  tensorPresheaf (actualGenuineTensorPresheaf D A)
    (omega1Presheaf (X := Definition11.RadiusBase))

/-- The specialized codomain is literally the tensor of the genuine
Definition 12 presheaf with `Ω¹`. -/
theorem actualAqOmega1Presheaf_eq
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    actualAqOmega1Presheaf D A =
      tensorPresheaf (actualGenuineTensorPresheaf D A)
        (omega1Presheaf (X := Definition11.RadiusBase)) :=
  rfl

/-- Definition 13 specialized to the certified `Lq` and `Mmock` fibres. -/
def actualDq (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase) :
    (actualGenuineTensorPresheaf D A).obj U →ₗ[ℂ]
      (actualAqOmega1Presheaf D A).obj U :=
  Dq P U

@[simp] theorem actualDq_apply
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase)
    (z : (actualGenuineTensorPresheaf D A).obj U) :
    actualDq D A P U z = Dq P U z :=
  rfl

theorem actualDq_map_add
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase)
    (x y : (actualGenuineTensorPresheaf D A).obj U) :
    actualDq D A P U (x + y) =
      actualDq D A P U x + actualDq D A P U y :=
  Dq_map_add P U x y

theorem actualDq_map_smul
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase)
    (c : ℂ) (z : (actualGenuineTensorPresheaf D A).obj U) :
    actualDq D A P U (c • z) = c • actualDq D A P U z :=
  Dq_map_smul P U c z

/-- Specialized restriction naturality, inherited from the construction. -/
theorem actualDq_restrict
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    {U W : TopologicalSpace.Opens Definition11.RadiusBase} (hUW : U ≤ W)
    (z : (actualGenuineTensorPresheaf D A).obj W) :
    (actualAqOmega1Presheaf D A).res hUW (actualDq D A P W z) =
      actualDq D A P U ((actualGenuineTensorPresheaf D A).res hUW z) :=
  Dq_restrict P hUW z

/-- Specialized local formula `d/d(log r) + A_q(t)`. -/
theorem actualDq_localTrivialization
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase)
    (z : (actualGenuineTensorPresheaf D A).obj U) :
    actualDq D A P U z =
      tensorWithForm (dlogFrame U) (localCoefficient P U z) :=
  Dq_localTrivialization P U z

/-- Specialized full Leibniz rule. -/
theorem actualDq_leibniz
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A)
    (U : TopologicalSpace.Opens Definition11.RadiusBase)
    (f : ScalarSection U)
    (z : (actualGenuineTensorPresheaf D A).obj U) :
    actualDq D A P U
        (aqScalarAction (ActualLqFibre D) (ActualMmockFibre A) f z) =
      aqOmega1ScalarAction (ActualLqFibre D) (ActualMmockFibre A) f
          (actualDq D A P U z) +
        leibnizCorrection (ActualLqFibre D) (ActualMmockFibre A) f z :=
  Dq_leibniz P U f z

/-- Full Definition 13 certificate for the actual Definition 12 fibres. -/
theorem actual_certificate
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (P : ActualFibreOperators D A) :
    Certificate (X := Definition11.RadiusBase)
      (ActualLqFibre D) (ActualMmockFibre A) P :=
  certificate (X := Definition11.RadiusBase)
    (ActualLqFibre D) (ActualMmockFibre A) P

/-- Unconditional corrected flat/constant operator data. -/
def zeroActualFibreOperators
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    ActualFibreOperators D A :=
  zeroFibreOperators (ActualLqFibre D) (ActualMmockFibre A)

/-- The corrected flat/constant q-covariant derivative. -/
def correctedDq (D : Definition11.AnalyticData V) (A : Set ℂ)
    (U : TopologicalSpace.Opens Definition11.RadiusBase) :
    (actualGenuineTensorPresheaf D A).obj U →ₗ[ℂ]
      (actualAqOmega1Presheaf D A).obj U :=
  actualDq D A (zeroActualFibreOperators D A) U

/-- The corrected flat/constant instance satisfies the complete certificate. -/
theorem corrected_certificate
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    Certificate (X := Definition11.RadiusBase)
      (ActualLqFibre D) (ActualMmockFibre A)
      (zeroActualFibreOperators D A) :=
  actual_certificate D A (zeroActualFibreOperators D A)

