theorem restriction_preserves_inside_convergence (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (actualBundle K).Section V) (r : U) {q : ℂ}
    (hq : q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier) :
    (((actualBundle K).res hUV s).toFun r).series.inside.ConvergesAt q :=
  (((actualBundle K).res hUV s).toFun r).inside_converges hq

theorem restriction_preserves_psi_convergence (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (actualBundle K).Section V) (r : U) {q : ℂ}
    (hq : q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier) :
    K.psi.ConvergesAt q :=
  (((actualBundle K).res hUV s).toFun r).psi_converges hq

theorem restriction_preserves_correction_convergence (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (actualBundle K).Section V) (r : U) {q : ℂ}
    (hq : q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier) :
    (((actualBundle K).res hUV s).toFun r).series.correction.ConvergesAt q :=
  (((actualBundle K).res hUV s).toFun r).correction_converges hq

theorem restriction_preserves_outside_convergence (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (actualBundle K).Section V) (r : U) {q : ℂ}
    (hq : q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier) :
    (((actualBundle K).res hUV s).toFun r).series.outside.ConvergesAt q⁻¹ :=
  (((actualBundle K).res hUV s).toFun r).outside_converges hq

theorem restriction_preserves_matching (K : KernelData)
    {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
    (s : (actualBundle K).Section V) (r : U) {q : ℂ}
    (hq : q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier) :
    (((actualBundle K).res hUV s).toFun r).series.outside.sumAt q⁻¹ =
      (2 : ℂ) * K.psi.sumAt q -
        (((actualBundle K).res hUV s).toFun r).series.correction.sumAt q :=
  (((actualBundle K).res hUV s).toFun r).matching_identity hq

/-- Locality stated directly for actual q-series sections. -/
theorem locality (K : KernelData) {ι : Type}
    (C : OpenCoverData RadiusBase ι)
    {x y : (presheaf K).Section C.target}
    (hxy : ∀ i : ι,
      (presheaf K).res (C.piece_le_target i) x =
        (presheaf K).res (C.piece_le_target i) y) :
    x = y :=
  (isSheaf K).locality C hxy

/-- Every compatible local q-series family admits a gluing. -/
theorem gluing_exists (K : KernelData) {ι : Type}
    (C : OpenCoverData RadiusBase ι)
    (s : (presheaf K).CoverSectionProduct C)
    (hs : (presheaf K).CompatibleFamily C s) :
    ∃ x : (presheaf K).Section C.target,
      (presheaf K).IsGluing C s x :=
  (isSheaf K).gluing_exists C s hs

/-- A compatible q-series family has at most one gluing. -/
theorem gluing_unique (K : KernelData) {ι : Type}
    (C : OpenCoverData RadiusBase ι)
    (s : (presheaf K).CoverSectionProduct C)
    (hs : (presheaf K).CompatibleFamily C s)
    {x y : (presheaf K).Section C.target}
    (hx : (presheaf K).IsGluing C s x)
    (hy : (presheaf K).IsGluing C s y) :
    x = y :=
  (isSheaf K).gluing_unique C s hs hx hy

/-- Compatible local q-series data have exactly one gluing. -/
theorem existsUnique_gluing (K : KernelData) {ι : Type}
    (C : OpenCoverData RadiusBase ι)
    (s : (presheaf K).CoverSectionProduct C)
    (hs : (presheaf K).CompatibleFamily C s) :
    ∃! x : (presheaf K).Section C.target,
      (presheaf K).IsGluing C s x :=
  (isSheaf K).existsUnique_gluing C s hs

/-- An explicit local section of the unconditional zero-series sheaf. -/
def zeroLocalSection (U : TopologicalSpace.Opens RadiusBase) :
    LocalSection zeroKernel U :=
  LocallyConstant.const U zeroCertifiedGerm

@[simp] theorem zeroLocalSection_apply
    (U : TopologicalSpace.Opens RadiusBase) (r : U) :
    zeroLocalSection U r = zeroCertifiedGerm :=
  rfl

/-!
#### Analytic scope of Proposition 12/13 and Theorem 5.1

`CertifiedGerm` formalizes Proposition 12's exact series-level conclusion and
the sheaf consumes it without further assumptions.  The paper does not provide
coefficient formulas or estimates proving that its named nonzero series inhabit
this type.  It likewise does not define the cusp-transport functor, spectral
growth predicate, real-analytic completion predicate, or Eichler integral in a
form from which Proposition 13 and Theorem 5.1 can be derived in Lean.

The following structure is therefore the precise input boundary for those
nontrivial analytic assertions.  Its overlap identity is not a field: it is
derived below from the certified germ.  No field is installed as a global axiom.
-/

/-- Explicit analytic data needed to instantiate the paper's nontrivial
Proposition 12/13 and Theorem 5.1 claims. -/
structure PaperAnalyticInput (K : KernelData) where
  Cusp : Type u
  cuspKernel : Cusp → KernelData
  CuspTransport :
    ∀ a : Cusp,
      CertifiedGerm K → CertifiedGerm (cuspKernel a) → Prop
  SpectrallyControlledAtCusp :
    ∀ a : Cusp, CertifiedGerm (cuspKernel a) → Prop
  infinityData : CertifiedGerm K
  cuspData : ∀ a : Cusp, CertifiedGerm (cuspKernel a)
  proposition13_transport :
    ∀ a : Cusp, CuspTransport a infinityData (cuspData a)
  proposition13_growth :
    ∀ a : Cusp, SpectrallyControlledAtCusp a (cuspData a)
  CompletionDomain : Type v
  qParameter : CompletionDomain → ℂ
  completion : CompletionDomain → ℂ
  eichler : CompletionDomain → ℂ
  insideDomain : Set CompletionDomain
  outsideDomain : Set CompletionDomain
  overlapDomain : Set CompletionDomain
  overlap_subset_inside : overlapDomain ⊆ insideDomain
  overlap_subset_outside : overlapDomain ⊆ outsideDomain
  overlap_mem_annulus :
    ∀ τ : CompletionDomain, τ ∈ overlapDomain →
      qParameter τ ∈ infinityData.annulus.carrier
  theorem51_inside_formula :
    ∀ τ : CompletionDomain, τ ∈ insideDomain →
      completion τ =
        infinityData.series.inside.sumAt (qParameter τ) + eichler τ
  theorem51_outside_formula :
    ∀ τ : CompletionDomain, τ ∈ outsideDomain →
      completion τ =
        infinityData.series.outside.sumAt (qParameter τ)⁻¹ + eichler τ
  RealAnalyticCompletion : (CompletionDomain → ℂ) → Prop
  SpectrallyControlledCompletion : (CompletionDomain → ℂ) → Prop
  theorem51_realAnalytic : RealAnalyticCompletion completion
  theorem51_growth : SpectrallyControlledCompletion completion

namespace PaperAnalyticInput

variable {K : KernelData}

/-- Proposition 12's convergence conclusion for the supplied infinity germ. -/
theorem proposition12_common_convergence (A : PaperAnalyticInput K)
    {q : ℂ} (hq : q ∈ A.infinityData.annulus.carrier) :
    q ∈ commonConvergenceRegion K A.infinityData.series :=
  A.infinityData.common_convergence hq

/-- Proposition 12's inside/outside identity for the supplied infinity germ. -/
theorem proposition12_identity (A : PaperAnalyticInput K)
    {q : ℂ} (hq : q ∈ A.infinityData.annulus.carrier) :
    A.infinityData.series.outside.sumAt q⁻¹ =
      (2 : ℂ) * K.psi.sumAt q -
        A.infinityData.series.correction.sumAt q :=
  A.infinityData.matching_identity hq

/-- Every transported cusp datum carries the same certified form of the
inside/outside identity. -/
theorem proposition13_cusp_identity (A : PaperAnalyticInput K)
    (a : A.Cusp) {q : ℂ}
    (hq : q ∈ (A.cuspData a).annulus.carrier) :
    (A.cuspData a).series.outside.sumAt q⁻¹ =
      (2 : ℂ) * (A.cuspKernel a).psi.sumAt q -
        (A.cuspData a).series.correction.sumAt q :=
  (A.cuspData a).matching_identity hq

/-- Theorem 5.1(3), derived from the certified common-annulus property. -/
theorem theorem51_overlap_identity (A : PaperAnalyticInput K)
    {τ : A.CompletionDomain} (hτ : τ ∈ A.overlapDomain) :
    A.infinityData.series.outside.sumAt (A.qParameter τ)⁻¹ =
      (2 : ℂ) * K.psi.sumAt (A.qParameter τ) -
        A.infinityData.series.correction.sumAt (A.qParameter τ) :=
  A.infinityData.matching_identity (A.overlap_mem_annulus τ hτ)

/-- The two completion formulas force equality of their holomorphic values on
the overlap because the Eichler term is literally the same. -/
theorem theorem51_completion_overlap (A : PaperAnalyticInput K)
    {τ : A.CompletionDomain} (hτ : τ ∈ A.overlapDomain) :
    A.infinityData.series.inside.sumAt (A.qParameter τ) =
      A.infinityData.series.outside.sumAt (A.qParameter τ)⁻¹ := by
  have hin := A.theorem51_inside_formula τ (A.overlap_subset_inside hτ)
  have hout := A.theorem51_outside_formula τ (A.overlap_subset_outside hτ)
  exact add_right_cancel (hin.symm.trans hout)

end PaperAnalyticInput

/-- PR-facing certificate for every structural item in the `Mmock` checklist. -/
structure Certificate (K : KernelData) : Prop where
  common_annulus_nonempty :
    ∀ g : CertifiedGerm K, g.annulus.carrier.Nonempty
  all_series_converge :
    ∀ (g : CertifiedGerm K) {q : ℂ},
      q ∈ g.annulus.carrier →
        q ∈ commonConvergenceRegion K g.series
  inside_outside_identity :
    ∀ (g : CertifiedGerm K) {q : ℂ},
      q ∈ g.annulus.carrier →
        g.series.outside.sumAt q⁻¹ =
          (2 : ℂ) * K.psi.sumAt q - g.series.correction.sumAt q
  restriction_preserves_germ :
    ∀ {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
      (s : (actualBundle K).Section V) (r : U),
      ((actualBundle K).res hUV s).toFun r = s.toFun ⟨r.1, hUV r.2⟩
  restriction_preserves_convergence :
    ∀ {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
      (s : (actualBundle K).Section V) (r : U) {q : ℂ},
      q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier →
        q ∈ commonConvergenceRegion K
          (((actualBundle K).res hUV s).toFun r).series
  restriction_preserves_identity :
    ∀ {U V : TopologicalSpace.Opens RadiusBase} (hUV : U ≤ V)
      (s : (actualBundle K).Section V) (r : U) {q : ℂ},
      q ∈ (((actualBundle K).res hUV s).toFun r).annulus.carrier →
        (((actualBundle K).res hUV s).toFun r).series.outside.sumAt q⁻¹ =
          (2 : ℂ) * K.psi.sumAt q -
            (((actualBundle K).res hUV s).toFun r).series.correction.sumAt q
  actual_is_sheaf : IsSheafLike (presheaf K)
  legacy_bundle_bridge :
    MockBundle.toPresheafLike (actualBundle K) = presheaf K

/-- The actual q-series sheaf satisfies the complete structural checklist for
every fixed kernel datum. -/
theorem certificate (K : KernelData) : Certificate K :=
  { common_annulus_nonempty := by
      intro g
      exact g.annulus.carrier_nonempty
    all_series_converge := by
      intro g q hq
      exact g.common_convergence hq
    inside_outside_identity := by
      intro g q hq
      exact g.matching_identity hq
    restriction_preserves_germ := actualBundle_res_apply K
    restriction_preserves_convergence := by
      intro U V hUV s r q hq
      exact CertifiedGerm.common_convergence _ hq
    restriction_preserves_identity := restriction_preserves_matching K
    actual_is_sheaf := isSheaf K
    legacy_bundle_bridge := actualBundle_toPresheafLike K }

/-- The corrected zero-series model gives a completely assumption-free,
inhabited instance of every `Mmock` structure and theorem above. -/
theorem zero_model_inhabited : Nonempty (CertifiedGerm zeroKernel) :=
  ⟨zeroCertifiedGerm⟩

theorem zero_certificate : Certificate zeroKernel :=
  certificate zeroKernel

end

end Mmock

namespace Mmock

namespace QSeries

/-- Convergence is closed under addition of coefficient series. -/
theorem add_convergesAt {a b : QSeries} {q : ℂ}
    (ha : a.ConvergesAt q) (hb : b.ConvergesAt q) :
    (a + b).ConvergesAt q := by
  change Summable (fun n : ℕ => (a n + b n) * q ^ n)
  change Summable (fun n : ℕ => a n * q ^ n) at ha
  change Summable (fun n : ℕ => b n * q ^ n) at hb
  simpa only [add_mul] using ha.add hb

/-- Convergence is closed under complex scalar multiplication. -/
theorem smul_convergesAt (c : ℂ) {a : QSeries} {q : ℂ}
    (ha : a.ConvergesAt q) :
    (c • a).ConvergesAt q := by
  change Summable (fun n : ℕ => (c * a n) * q ^ n)
  change Summable (fun n : ℕ => a n * q ^ n) at ha
  simpa only [smul_eq_mul, mul_assoc] using
    (Summable.const_smul c ha)

/-- Evaluation is additive whenever both series converge. -/
theorem sumAt_add {a b : QSeries} {q : ℂ}
    (ha : a.ConvergesAt q) (hb : b.ConvergesAt q) :
    (a + b).sumAt q = a.sumAt q + b.sumAt q := by
  simpa [sumAt, term, add_mul] using ha.tsum_add hb

/-- Evaluation commutes with complex scalar multiplication on a convergent
series. -/
theorem sumAt_smul (c : ℂ) {a : QSeries} {q : ℂ}
    (ha : a.ConvergesAt q) :
    (c • a).sumAt q = c * a.sumAt q := by
  simpa [sumAt, term, smul_eq_mul, mul_assoc] using
    (Summable.tsum_const_smul c ha)

end QSeries

end Mmock

/-!
### Definition 12 with an actual tensor product

The legacy pair carrier remains available for compatibility, but it is not used
as the definition below.  Linear presheaves take values in `ModuleCat ℂ`, and
their pointwise tensor uses Mathlib's `TensorProduct` and `TensorProduct.map`.
-/

namespace Definition12Tensor

noncomputable section

open CategoryTheory

/-- A contravariant presheaf of complex modules on the open-set poset. -/
structure LinearPresheaf (X : Type u) [TopologicalSpace X] where
  obj : TopologicalSpace.Opens X → ModuleCat.{max u v} ℂ
  res :
    ∀ {U V : TopologicalSpace.Opens X}, U ≤ V → (obj V ⟶ obj U)
  res_id :
    ∀ (U : TopologicalSpace.Opens X) (s : obj U),
      (@res U U (le_refl U)) s = s
  res_comp :
    ∀ {U V W : TopologicalSpace.Opens X}
      (hUV : U ≤ V) (hVW : V ≤ W) (s : obj W),
      (@res U V hUV) ((@res V W hVW) s) =
        (@res U W (le_trans hUV hVW)) s

namespace LinearPresheaf

variable {X : Type u} [TopologicalSpace X]

/-- Forget linear structure while retaining the same sections and restriction
functions. -/
@[reducible] def toPresheafLike (F : LinearPresheaf X) : PresheafLike X where
  Section U := F.obj U
  res hUV s := F.res hUV s
  res_id := by
    intro U s
    exact F.res_id U s
  res_comp := by
    intro U V W hUV hVW s
    exact F.res_comp hUV hVW s

/-- Every restriction in a linear presheaf is an actual complex-linear map. -/
def restrictionLinear (F : LinearPresheaf X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    F.obj V →ₗ[ℂ] F.obj U :=
  (F.res hUV).hom

@[simp] theorem restrictionLinear_apply (F : LinearPresheaf X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : F.obj V) :
    F.restrictionLinear hUV s = F.res hUV s :=
  rfl

end LinearPresheaf

variable {X : Type u} [TopologicalSpace X]

/-- Linear restriction of locally constant module-valued functions. -/
def locallyConstantRestriction (E : ModuleCat.{v} ℂ)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    LocallyConstant V E →ₗ[ℂ] LocallyConstant U E where
  toFun s := LocallyConstant.comap
    (LocallyConstantValueSheaf.openInclusion hUV) s
  map_add' x y := by
    apply LocallyConstant.ext
    intro z
    rfl
  map_smul' c x := by
    apply LocallyConstant.ext
    intro z
    rfl

@[simp] theorem locallyConstantRestriction_apply (E : ModuleCat.{v} ℂ)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : LocallyConstant V E) (x : U) :
    locallyConstantRestriction E hUV s x = s ⟨x.1, hUV x.2⟩ :=
  rfl

theorem locallyConstantRestriction_id (E : ModuleCat.{v} ℂ)
    (U : TopologicalSpace.Opens X) :
    ModuleCat.ofHom (locallyConstantRestriction E (le_refl U)) =
      𝟙 (ModuleCat.of ℂ (LocallyConstant U E)) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro s
  apply LocallyConstant.ext
  intro x
  rfl

theorem locallyConstantRestriction_comp (E : ModuleCat.{v} ℂ)
    {U V W : TopologicalSpace.Opens X}
    (hUV : U ≤ V) (hVW : V ≤ W) :
    ModuleCat.ofHom (locallyConstantRestriction E hVW) ≫
        ModuleCat.ofHom (locallyConstantRestriction E hUV) =
      ModuleCat.ofHom
        (locallyConstantRestriction E (le_trans hUV hVW)) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro s
  apply LocallyConstant.ext
  intro x
  rfl

/-- The genuine linear presheaf of locally constant maps into a fixed complex
module. -/
def locallyConstantLinearPresheaf (E : ModuleCat.{v} ℂ) :
    LinearPresheaf X where
  obj U := ModuleCat.of ℂ (LocallyConstant U E)
  res hUV := ModuleCat.ofHom (locallyConstantRestriction E hUV)
  res_id U s := by rfl
  res_comp hUV hVW s := by rfl

@[simp] theorem locallyConstantLinearPresheaf_obj (E : ModuleCat.{v} ℂ)
    (U : TopologicalSpace.Opens X) :
    (locallyConstantLinearPresheaf E).obj U =
      ModuleCat.of ℂ (LocallyConstant U E) :=
  rfl

/-- The locally constant linear presheaf is a sheaf in the existing cover API. -/
theorem locallyConstantLinearPresheaf_isSheaf (E : ModuleCat.{v} ℂ) :
    IsSheafLike
      ((locallyConstantLinearPresheaf (X := X) E).toPresheafLike) := by
  change IsSheafLike (LocallyConstantValueSheaf.presheaf (X := X) E)
  exact LocallyConstantValueSheaf.isSheaf

section Lq

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- Definition 11's corrected local system lifted to complex modules and linear
restriction maps. -/
def lqLinearPresheaf (D : Definition11.AnalyticData V) :
    LinearPresheaf Definition11.RadiusBase :=
  locallyConstantLinearPresheaf (ModuleCat.of ℂ D.solutionSpace)

@[simp] theorem lqLinearPresheaf_obj
    (D : Definition11.AnalyticData V)
    (U : TopologicalSpace.Opens Definition11.RadiusBase) :
    (lqLinearPresheaf D).obj U =
      ModuleCat.of ℂ (LocallyConstant U D.solutionSpace) :=
  rfl

@[simp] theorem lqLinearPresheaf_res_apply
    (D : Definition11.AnalyticData V)
    {U W : TopologicalSpace.Opens Definition11.RadiusBase}
    (hUW : U ≤ W) (s : (lqLinearPresheaf D).obj W) (x : U) :
    (((lqLinearPresheaf D).res hUW s :
        LocallyConstant U D.solutionSpace).toFun x) =
      (s : LocallyConstant W D.solutionSpace).toFun ⟨x.1, hUW x.2⟩ :=
  rfl

noncomputable def lq_fibre_has_module (D : Definition11.AnalyticData V)
    (U : TopologicalSpace.Opens Definition11.RadiusBase) :
    Module ℂ ((lqLinearPresheaf D).obj U) :=
  inferInstance

theorem lq_restriction_isLinear (D : Definition11.AnalyticData V)
    {U W : TopologicalSpace.Opens Definition11.RadiusBase}
    (hUW : U ≤ W) :
    Nonempty
      ((lqLinearPresheaf D).obj W →ₗ[ℂ]
        (lqLinearPresheaf D).obj U) :=
  ⟨(lqLinearPresheaf D).restrictionLinear hUW⟩

end Lq

end

end Definition12Tensor

namespace Definition12Tensor

noncomputable section

namespace MmockLinear

open Mmock

/-- Q-series converging at every point of a specified set form a submodule. -/
def convergentSeries (A : Set ℂ) : Submodule ℂ Mmock.QSeries where
  carrier := {a | ∀ q : ℂ, q ∈ A → a.ConvergesAt q}
  zero_mem' := by
    intro q hq
    exact QSeries.zero_convergesAt q
  add_mem' := by
    intro a b ha hb q hq
    exact QSeries.add_convergesAt (ha q hq) (hb q hq)
  smul_mem' := by
    intro c a ha q hq
    exact QSeries.smul_convergesAt c (ha q hq)

/-- Outside q-series converging after `q ↦ q⁻¹` on a specified set. -/
def inverseConvergentSeries (A : Set ℂ) : Submodule ℂ Mmock.QSeries where
  carrier := {a | ∀ q : ℂ, q ∈ A → a.ConvergesAt q⁻¹}
  zero_mem' := by
    intro q hq
    exact QSeries.zero_convergesAt q⁻¹
  add_mem' := by
    intro a b ha hb q hq
    exact QSeries.add_convergesAt (ha q hq) (hb q hq)
  smul_mem' := by
    intro c a ha q hq
    exact QSeries.smul_convergesAt c (ha q hq)

@[simp] theorem mem_convergentSeries_iff (A : Set ℂ) (a : Mmock.QSeries) :
    a ∈ convergentSeries A ↔ ∀ q : ℂ, q ∈ A → a.ConvergesAt q :=
  Iff.rfl

@[simp] theorem mem_inverseConvergentSeries_iff
    (A : Set ℂ) (a : Mmock.QSeries) :
    a ∈ inverseConvergentSeries A ↔
      ∀ q : ℂ, q ∈ A → a.ConvergesAt q⁻¹ :=
  Iff.rfl

/-- Raw linear variations `(δf, δS, δG)` with the required convergence. -/
abbrev VariationRaw (A : Set ℂ) :=
  convergentSeries A ×
    convergentSeries A × inverseConvergentSeries A

def variationInside {A : Set ℂ} (x : VariationRaw A) : Mmock.QSeries :=
  x.1.1

def variationCorrection {A : Set ℂ} (x : VariationRaw A) : Mmock.QSeries :=
  x.2.1.1

def variationOutside {A : Set ℂ} (x : VariationRaw A) : Mmock.QSeries :=
  x.2.2.1

theorem variationInside_converges {A : Set ℂ} (x : VariationRaw A)
    {q : ℂ} (hq : q ∈ A) :
    (variationInside x).ConvergesAt q :=
  x.1.2 q hq

theorem variationCorrection_converges {A : Set ℂ} (x : VariationRaw A)
    {q : ℂ} (hq : q ∈ A) :
    (variationCorrection x).ConvergesAt q :=
  x.2.1.2 q hq

theorem variationOutside_converges {A : Set ℂ} (x : VariationRaw A)
    {q : ℂ} (hq : q ∈ A) :
    (variationOutside x).ConvergesAt q⁻¹ :=
  x.2.2.2 q hq

/-- Evaluation is linear on the submodule of series converging on `A`. -/
def evalLinear (A : Set ℂ) (q : A) : convergentSeries A →ₗ[ℂ] ℂ where
  toFun a := a.1.sumAt q.1
  map_add' a b :=
    QSeries.sumAt_add (a.2 q.1 q.2) (b.2 q.1 q.2)
  map_smul' c a :=
    QSeries.sumAt_smul c (a.2 q.1 q.2)

/-- Outside evaluation at `q⁻¹` is linear on its convergence submodule. -/
def inverseEvalLinear (A : Set ℂ) (q : A) :
    inverseConvergentSeries A →ₗ[ℂ] ℂ where
  toFun a := a.1.sumAt q.1⁻¹
  map_add' a b :=
    QSeries.sumAt_add (a.2 q.1 q.2) (b.2 q.1 q.2)
  map_smul' c a :=
    QSeries.sumAt_smul c (a.2 q.1 q.2)

/-- The homogeneous matching functional `δG(q⁻¹) + δS(q)`. -/
def homogeneousFunctional (A : Set ℂ) (q : A) : VariationRaw A →ₗ[ℂ] ℂ where
  toFun x := inverseEvalLinear A q x.2.2 + evalLinear A q x.2.1
  map_add' x y := by
    simp [add_assoc, add_left_comm, add_comm]
  map_smul' c x := by
    change
      (inverseEvalLinear A q) (c • x.2.2) +
          (evalLinear A q) (c • x.2.1) =
        c • ((inverseEvalLinear A q) x.2.2 +
          (evalLinear A q) x.2.1)
    rw [map_smul, map_smul]
    ring

/-- The complex module of convergent homogeneous variations.  This is the
linear tangent model to the affine equation `G = 2 psi - S`. -/
def homogeneousVariation (A : Set ℂ) : Submodule ℂ (VariationRaw A) :=
  ⨅ q : A, LinearMap.ker (homogeneousFunctional A q)

theorem mem_homogeneousVariation_iff (A : Set ℂ) (x : VariationRaw A) :
    x ∈ homogeneousVariation A ↔
      ∀ q : A,
        (variationOutside x).sumAt q.1⁻¹ +
          (variationCorrection x).sumAt q.1 = 0 := by
  simp [homogeneousVariation, homogeneousFunctional,
    inverseEvalLinear, evalLinear, variationOutside, variationCorrection]

/-- The homogeneous variation module as an object of `ModuleCat ℂ`. -/
def variationModule (A : Set ℂ) : ModuleCat ℂ :=
  ModuleCat.of ℂ (homogeneousVariation A)

def homogeneousInside {A : Set ℂ} (v : homogeneousVariation A) :
    Mmock.QSeries :=
  variationInside v.1

def homogeneousCorrection {A : Set ℂ} (v : homogeneousVariation A) :
    Mmock.QSeries :=
  variationCorrection v.1

def homogeneousOutside {A : Set ℂ} (v : homogeneousVariation A) :
    Mmock.QSeries :=
  variationOutside v.1

theorem homogeneousInside_converges {A : Set ℂ}
    (v : homogeneousVariation A) {q : ℂ} (hq : q ∈ A) :
    (homogeneousInside v).ConvergesAt q :=
  variationInside_converges v.1 hq

theorem homogeneousCorrection_converges {A : Set ℂ}
    (v : homogeneousVariation A) {q : ℂ} (hq : q ∈ A) :
    (homogeneousCorrection v).ConvergesAt q :=
  variationCorrection_converges v.1 hq

theorem homogeneousOutside_converges {A : Set ℂ}
    (v : homogeneousVariation A) {q : ℂ} (hq : q ∈ A) :
    (homogeneousOutside v).ConvergesAt q⁻¹ :=
  variationOutside_converges v.1 hq

theorem homogeneous_identity {A : Set ℂ}
    (v : homogeneousVariation A) (q : A) :
    (homogeneousOutside v).sumAt q.1⁻¹ +
      (homogeneousCorrection v).sumAt q.1 = 0 :=
  (mem_homogeneousVariation_iff A v.1).mp v.2 q

/-- A chosen origin turns the paper's affine family of matching germs into the
module of homogeneous variations. -/
structure AffineBase (K : Mmock.KernelData) where
  annulus : Mmock.CommonAnnulus
  germ : Mmock.CertifiedGerm K
  germ_annulus : germ.annulus = annulus

namespace AffineBase

variable {K : Mmock.KernelData}

/-- Translation of a homogeneous variation by the chosen matching germ. -/
def translateSeries (B : AffineBase K)
    (v : homogeneousVariation B.annulus.carrier) :
    Mmock.SeriesTriple where
  inside := B.germ.series.inside + homogeneousInside v
  correction := B.germ.series.correction + homogeneousCorrection v
  outside := B.germ.series.outside + homogeneousOutside v

/-- Translation by a homogeneous variation preserves convergence and restores
the affine matching equation. -/
def translate (B : AffineBase K)
    (v : homogeneousVariation B.annulus.carrier) :
    Mmock.CertifiedGerm K where
  series := B.translateSeries v
  annulus := B.annulus
  annulus_converges := by
    intro q hq
    have hqBase : q ∈ B.germ.annulus.carrier := by
      rw [B.germ_annulus]
      exact hq
    exact
      ⟨QSeries.add_convergesAt
          (B.germ.inside_converges hqBase)
          (homogeneousInside_converges v hq),
        B.germ.psi_converges hqBase,
        QSeries.add_convergesAt
          (B.germ.correction_converges hqBase)
          (homogeneousCorrection_converges v hq),
        ⟨B.annulus.ne_zero hq,
          QSeries.add_convergesAt
            (B.germ.outside_converges hqBase)
            (homogeneousOutside_converges v hq)⟩⟩
  «matches» := by
    intro q hq
    have hqBase : q ∈ B.germ.annulus.carrier := by
      rw [B.germ_annulus]
      exact hq
    have hBase := B.germ.matching_identity hqBase
    have hVariation := homogeneous_identity v ⟨q, hq⟩
    have hOutsideBase := B.germ.outside_converges hqBase
    have hOutsideVariation := homogeneousOutside_converges v hq
    have hCorrectionBase := B.germ.correction_converges hqBase
    have hCorrectionVariation := homogeneousCorrection_converges v hq
    have hVariation' :
        (homogeneousOutside v).sumAt q⁻¹ =
          -(homogeneousCorrection v).sumAt q := by
      calc
        (homogeneousOutside v).sumAt q⁻¹ =
            ((homogeneousOutside v).sumAt q⁻¹ +
              (homogeneousCorrection v).sumAt q) -
                (homogeneousCorrection v).sumAt q :=
          (add_sub_cancel_right _ _).symm
        _ = 0 - (homogeneousCorrection v).sumAt q := by
          rw [hVariation]
        _ = -(homogeneousCorrection v).sumAt q := zero_sub _
    change
      (B.germ.series.outside + homogeneousOutside v).sumAt q⁻¹ =
        (2 : ℂ) * K.psi.sumAt q -
          (B.germ.series.correction + homogeneousCorrection v).sumAt q
    rw [QSeries.sumAt_add hOutsideBase hOutsideVariation,
      QSeries.sumAt_add hCorrectionBase hCorrectionVariation,
      hBase, hVariation']
    ring

end AffineBase

/-- The linear Mmock presheaf of locally constant homogeneous variations. -/
def linearMmockPresheaf (A : Set ℂ) :
    LinearPresheaf Mmock.RadiusBase :=
  locallyConstantLinearPresheaf (variationModule A)

@[simp] theorem linearMmockPresheaf_obj (A : Set ℂ)
    (U : TopologicalSpace.Opens Mmock.RadiusBase) :
    (linearMmockPresheaf A).obj U =
      ModuleCat.of ℂ (LocallyConstant U (variationModule A)) :=
  rfl

@[simp] theorem linearMmockPresheaf_res_apply (A : Set ℂ)
    {U V : TopologicalSpace.Opens Mmock.RadiusBase} (hUV : U ≤ V)
    (s : (linearMmockPresheaf A).obj V) (x : U) :
    (((linearMmockPresheaf A).res hUV s :
        LocallyConstant U (variationModule A)).toFun x) =
      (s : LocallyConstant V (variationModule A)).toFun ⟨x.1, hUV x.2⟩ :=
  rfl

noncomputable def mmock_fibre_has_module (A : Set ℂ)
    (U : TopologicalSpace.Opens Mmock.RadiusBase) :
    Module ℂ ((linearMmockPresheaf A).obj U) :=
  inferInstance

theorem mmock_restriction_isLinear (A : Set ℂ)
    {U V : TopologicalSpace.Opens Mmock.RadiusBase} (hUV : U ≤ V) :
    Nonempty
      ((linearMmockPresheaf A).obj V →ₗ[ℂ]
        (linearMmockPresheaf A).obj U) :=
  ⟨(linearMmockPresheaf A).restrictionLinear hUV⟩

theorem linearMmockPresheaf_isSheaf (A : Set ℂ) :
    IsSheafLike (linearMmockPresheaf A).toPresheafLike :=
  Definition12Tensor.locallyConstantLinearPresheaf_isSheaf
    (X := Mmock.RadiusBase) (variationModule A)

end MmockLinear

/-! #### Genuine pointwise tensor presheaves -/

variable {X : Type u} [TopologicalSpace X]

namespace LinearPresheaf

/-- The identity restriction, viewed in the underlying category of complex
linear maps. -/
theorem restrictionLinear_id (F : LinearPresheaf X)
    (U : TopologicalSpace.Opens X) :
    F.restrictionLinear (le_refl U) = LinearMap.id := by
  apply LinearMap.ext
  intro s
  exact F.toPresheafLike.res_id U s

/-- Contravariant composition of restrictions, stated directly for the
underlying complex-linear maps. -/
theorem restrictionLinear_comp (F : LinearPresheaf X)
    {U V W : TopologicalSpace.Opens X}
    (hUV : U ≤ V) (hVW : V ≤ W) :
    (F.restrictionLinear hUV).comp (F.restrictionLinear hVW) =
      F.restrictionLinear (le_trans hUV hVW) := by
  apply LinearMap.ext
  intro s
  exact F.toPresheafLike.res_comp hUV hVW s

end LinearPresheaf

/-- An isomorphism of linear presheaves, including compatibility with every
restriction map. -/
structure LinearPresheafEquiv (F G : LinearPresheaf X) where
  app : ∀ U : TopologicalSpace.Opens X, F.obj U ≃ₗ[ℂ] G.obj U
  naturality :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) (s : F.obj V),
      app U (F.res hUV s) = G.res hUV (app V s)

namespace LinearPresheafEquiv

variable {F G H : LinearPresheaf X}

/-- Naturality of a linear-presheaf equivalence, exposed as a reusable lemma. -/
@[simp] theorem naturality_apply (e : LinearPresheafEquiv F G)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) (s : F.obj V) :
    e.app U (F.res hUV s) = G.res hUV (e.app V s) :=
  e.naturality hUV s

/-- The inverse of a linear-presheaf equivalence is again natural. -/
def symm (e : LinearPresheafEquiv F G) : LinearPresheafEquiv G F where
  app U := (e.app U).symm
  naturality := by
    intro U V hUV s
    apply (e.app U).injective
    rw [(e.app U).apply_symm_apply]
    rw [e.naturality hUV ((e.app V).symm s)]
    rw [(e.app V).apply_symm_apply]

/-- Composition of natural linear-presheaf equivalences. -/
def trans (e : LinearPresheafEquiv F G) (f : LinearPresheafEquiv G H) :
    LinearPresheafEquiv F H where
  app U := (e.app U).trans (f.app U)
  naturality := by
    intro U V hUV s
    change f.app U (e.app U (F.res hUV s)) =
      H.res hUV (f.app V (e.app V s))
    rw [e.naturality, f.naturality]

/-- A sheaf structure transports from the target of a natural fibrewise
linear equivalence to its source. -/
theorem isSheaf_of_equiv (e : LinearPresheafEquiv F G)
    (hG : IsSheafLike G.toPresheafLike) :
    IsSheafLike F.toPresheafLike where
  locality := by
    intro ι C x y hxy
    apply (e.app C.target).injective
    apply hG.locality C
    intro i
    change
      G.res (C.piece_le_target i) (e.app C.target x) =
        G.res (C.piece_le_target i) (e.app C.target y)
    rw [← e.naturality (C.piece_le_target i) x]
    rw [← e.naturality (C.piece_le_target i) y]
    exact congrArg (e.app (C.piece i)) (hxy i)
  gluing_exists := by
    intro ι C s hs
    let t : G.toPresheafLike.CoverSectionProduct C :=
      fun i => e.app (C.piece i) (s i)
    have ht : G.toPresheafLike.CompatibleFamily C t := by
      intro i j
      change
        G.res (C.overlap_le_left i j) (e.app (C.piece i) (s i)) =
          G.res (C.overlap_le_right i j) (e.app (C.piece j) (s j))
      rw [← e.naturality, ← e.naturality]
      exact congrArg (e.app (C.piece i ⊓ C.piece j)) (hs i j)
    obtain ⟨y, hy⟩ := hG.gluing_exists C t ht
    refine ⟨(e.app C.target).symm y, ?_⟩
    intro i
    apply (e.app (C.piece i)).injective
    calc
      e.app (C.piece i)
          (F.res (C.piece_le_target i) ((e.app C.target).symm y)) =
          G.res (C.piece_le_target i)
            (e.app C.target ((e.app C.target).symm y)) :=
        e.naturality (C.piece_le_target i) _
      _ = G.res (C.piece_le_target i) y := by
        rw [(e.app C.target).apply_symm_apply]
      _ = t i := hy i
      _ = e.app (C.piece i) (s i) := rfl
  gluing_unique := by
    intro ι C s _hs x y hx hy
    apply (e.app C.target).injective
    apply hG.locality C
    intro i
    calc
      G.res (C.piece_le_target i) (e.app C.target x) =
          e.app (C.piece i) (F.res (C.piece_le_target i) x) :=
        (e.naturality (C.piece_le_target i) x).symm
      _ = e.app (C.piece i) (s i) := congrArg (e.app (C.piece i)) (hx i)
      _ = e.app (C.piece i) (F.res (C.piece_le_target i) y) :=
        congrArg (e.app (C.piece i)) (hy i).symm
      _ = G.res (C.piece_le_target i) (e.app C.target y) :=
        e.naturality (C.piece_le_target i) y

/-- Sheafness is invariant under a natural fibrewise linear equivalence. -/
theorem isSheaf_iff (e : LinearPresheafEquiv F G) :
    IsSheafLike F.toPresheafLike ↔ IsSheafLike G.toPresheafLike :=
  ⟨fun hF => e.symm.isSheaf_of_equiv hF,
    fun hG => e.isSheaf_of_equiv hG⟩

end LinearPresheafEquiv

/-- Definition 12's section module on an open set: the actual algebraic tensor
product, not the legacy Cartesian pair. -/
abbrev TensorSection
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :=
  TensorProduct ℂ (L.obj U) (M.obj U)

/-- Restriction of tensor sections is the tensor product of the two linear
restriction maps. -/
def tensorRestriction
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    TensorSection L M V →ₗ[ℂ] TensorSection L M U :=
  TensorProduct.map (L.restrictionLinear hUV) (M.restrictionLinear hUV)

/-- `TensorProduct.map` restricts a pure tensor componentwise. -/
@[simp] theorem tensorRestriction_tmul
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (l : L.obj V) (m : M.obj V) :
    tensorRestriction L M hUV (l ⊗ₜ[ℂ] m) =
      L.res hUV l ⊗ₜ[ℂ] M.res hUV m :=
  rfl

/-- Identity restriction for the tensor product, at the linear-map level. -/
theorem tensorRestriction_id
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :
    tensorRestriction L M (le_refl U) = LinearMap.id := by
  change
    TensorProduct.map (L.restrictionLinear (le_refl U))
        (M.restrictionLinear (le_refl U)) =
      LinearMap.id
  rw [L.restrictionLinear_id U, M.restrictionLinear_id U]
  exact TensorProduct.map_id

/-- Contravariant composition for tensor restrictions, proved from
`TensorProduct.map_comp` and the two factor presheaf laws. -/
theorem tensorRestriction_comp
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V W : TopologicalSpace.Opens X}
    (hUV : U ≤ V) (hVW : V ≤ W) :
    (tensorRestriction L M hUV).comp (tensorRestriction L M hVW) =
      tensorRestriction L M (le_trans hUV hVW) := by
  change
    (TensorProduct.map (L.restrictionLinear hUV)
        (M.restrictionLinear hUV)).comp
          (TensorProduct.map (L.restrictionLinear hVW)
            (M.restrictionLinear hVW)) =
      TensorProduct.map (L.restrictionLinear (le_trans hUV hVW))
        (M.restrictionLinear (le_trans hUV hVW))
  rw [← TensorProduct.map_comp]
  rw [L.restrictionLinear_comp hUV hVW]
  rw [M.restrictionLinear_comp hUV hVW]

/-- The genuine pointwise tensor presheaf of two complex-linear presheaves. -/
def tensorPresheaf
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X) :
    LinearPresheaf.{u, max v w} X where
  obj U := ModuleCat.of.{max u (max v w), 0} ℂ (TensorSection L M U)
  res hUV := ModuleCat.ofHom (tensorRestriction L M hUV)
  res_id U s := by
    exact DFunLike.congr_fun (tensorRestriction_id L M U) s
  res_comp hUV hVW s := by
    exact DFunLike.congr_fun (tensorRestriction_comp L M hUV hVW) s

@[simp] theorem tensorPresheaf_obj
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :
    (tensorPresheaf L M).obj U = ModuleCat.of ℂ (TensorSection L M U) :=
  rfl

@[simp] theorem tensorPresheaf_res_hom
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    ((tensorPresheaf L M).res hUV).hom = tensorRestriction L M hUV :=
  rfl

@[simp] theorem tensorPresheaf_res_tmul
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (l : L.obj V) (m : M.obj V) :
    (tensorPresheaf L M).res hUV (l ⊗ₜ[ℂ] m) =
      L.res hUV l ⊗ₜ[ℂ] M.res hUV m :=
  rfl

/-- Every genuine tensor fibre carries its inferred complex-module structure. -/
noncomputable def tensor_fibre_has_module
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :
    Module ℂ ((tensorPresheaf L M).obj U) :=
  inferInstance

/-- Every genuine tensor restriction is represented by a complex-linear map. -/
theorem tensor_restriction_isLinear
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    Nonempty
      ((tensorPresheaf L M).obj V →ₗ[ℂ]
        (tensorPresheaf L M).obj U) :=
  ⟨(tensorPresheaf L M).restrictionLinear hUV⟩

/-- PR-facing certificate for the algebraic part of Definition 12. -/
structure GenuineTensorCertificate
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X) : Prop where
  fibre_module :
    ∀ U : TopologicalSpace.Opens X,
      Nonempty (Module ℂ ((tensorPresheaf L M).obj U))
  restriction_linear :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V),
      Nonempty
        ((tensorPresheaf L M).obj V →ₗ[ℂ]
          (tensorPresheaf L M).obj U)
  restriction_pure_tensor :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (l : L.obj V) (m : M.obj V),
      (tensorPresheaf L M).res hUV (l ⊗ₜ[ℂ] m) =
        L.res hUV l ⊗ₜ[ℂ] M.res hUV m
  restriction_identity :
    ∀ U : TopologicalSpace.Opens X,
      (tensorPresheaf L M).res (le_refl U) =
        𝟙 ((tensorPresheaf L M).obj U)
  restriction_composition :
    ∀ {U V W : TopologicalSpace.Opens X}
      (hUV : U ≤ V) (hVW : V ≤ W),
      (tensorPresheaf L M).res hVW ≫
          (tensorPresheaf L M).res hUV =
        (tensorPresheaf L M).res (le_trans hUV hVW)

/-- The generic genuine tensor presheaf satisfies every algebraic field of the
Definition 12 certificate without additional hypotheses. -/
theorem genuineTensor_certificate
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X) :
    GenuineTensorCertificate L M := by
  exact
    { fibre_module := fun U => ⟨tensor_fibre_has_module L M U⟩
      restriction_linear := tensor_restriction_isLinear L M
      restriction_pure_tensor := tensorPresheaf_res_tmul L M
      restriction_identity := by
        intro U
        ext s
        exact (tensorPresheaf L M).res_id U s
      restriction_composition := by
        intro U V W hUV hVW
        ext s
        exact (tensorPresheaf L M).res_comp hUV hVW s }

/-! #### The sheaf boundary for pointwise tensor products

The presheaf `U ↦ L(U) ⊗ M(U)` is not declared to be a sheaf.  For locally
constant systems the honest tensor sheaf has sections
`LocallyConstant U (E ⊗ F)`.  The canonical comparison below is always natural;
it yields sheafness of the pointwise tensor only when a supplied local
trivialization proves that comparison to be a fibrewise linear equivalence.
-/

/-- Pointwise tensoring of two locally constant functions is bilinear. -/
def pointwiseTensorBilinear (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :
    LocallyConstant U E →ₗ[ℂ]
      LocallyConstant U F →ₗ[ℂ]
        LocallyConstant U (TensorProduct ℂ E F) :=
  LinearMap.mk₂ ℂ
    (fun s t =>
      { toFun := fun x => s x ⊗ₜ[ℂ] t x
        isLocallyConstant :=
          s.isLocallyConstant.comp₂ t.isLocallyConstant
            (fun a b => a ⊗ₜ[ℂ] b) })
    (by
      intro s₁ s₂ t
      apply LocallyConstant.ext
      intro x
      change (s₁ x + s₂ x) ⊗ₜ[ℂ] t x =
        (s₁ x ⊗ₜ[ℂ] t x) + (s₂ x ⊗ₜ[ℂ] t x)
      exact TensorProduct.add_tmul (s₁ x) (s₂ x) (t x))
    (by
      intro c s t
      apply LocallyConstant.ext
      intro x
      change (c • s x) ⊗ₜ[ℂ] t x = c • (s x ⊗ₜ[ℂ] t x)
      exact (TensorProduct.smul_tmul' c (s x) (t x)).symm)
    (by
      intro s t₁ t₂
      apply LocallyConstant.ext
      intro x
      change s x ⊗ₜ[ℂ] (t₁ x + t₂ x) =
        (s x ⊗ₜ[ℂ] t₁ x) + (s x ⊗ₜ[ℂ] t₂ x)
      exact TensorProduct.tmul_add (s x) (t₁ x) (t₂ x))
    (by
      intro c s t
      apply LocallyConstant.ext
      intro x
      change s x ⊗ₜ[ℂ] (c • t x) = c • (s x ⊗ₜ[ℂ] t x)
      exact TensorProduct.tmul_smul c (s x) (t x))

/-- The canonical linear map from the pointwise tensor of section modules to
locally constant sections of the tensor-product fibre. -/
def pointwiseTensorComparison (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :
    TensorProduct ℂ (LocallyConstant U E) (LocallyConstant U F) →ₗ[ℂ]
      LocallyConstant U (TensorProduct ℂ E F) :=
  TensorProduct.lift (pointwiseTensorBilinear E F U)

/-- The canonical comparison has the expected value on a pure tensor at every
point of the open set. -/
@[simp] theorem pointwiseTensorComparison_tmul_apply
    (E F : ModuleCat ℂ) (U : TopologicalSpace.Opens X)
    (s : LocallyConstant U E) (t : LocallyConstant U F) (x : U) :
    pointwiseTensorComparison E F U (s ⊗ₜ[ℂ] t) x =
      s x ⊗ₜ[ℂ] t x :=
  rfl

/-- The raw pointwise tensor presheaf of two fixed-fibre locally constant
linear sheaves.  No sheaf claim is attached to this definition. -/
def locallyConstantPointwiseTensor (E F : ModuleCat ℂ) :
    LinearPresheaf X :=
  tensorPresheaf (locallyConstantLinearPresheaf E)
    (locallyConstantLinearPresheaf F)

/-- The honest locally constant tensor sheaf with fibre `E ⊗ F`. -/
def locallyConstantTensorSheaf (E F : ModuleCat ℂ) : LinearPresheaf X :=
  locallyConstantLinearPresheaf
    (ModuleCat.of ℂ (TensorProduct ℂ E F))

@[simp] theorem locallyConstantTensorSheaf_obj (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :
    (locallyConstantTensorSheaf E F).obj U =
      ModuleCat.of ℂ (LocallyConstant U (TensorProduct ℂ E F)) :=
  rfl

/-- The locally constant tensor target is unconditionally a sheaf. -/
theorem locallyConstantTensorSheaf_isSheaf (E F : ModuleCat ℂ) :
    IsSheafLike
      ((locallyConstantTensorSheaf (X := X) E F).toPresheafLike) :=
  Definition12Tensor.locallyConstantLinearPresheaf_isSheaf
    (X := X) (ModuleCat.of ℂ (TensorProduct ℂ E F))

/-- Naturality of the canonical comparison with respect to restriction. -/
theorem pointwiseTensorComparison_naturality
    (E F : ModuleCat ℂ) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    (pointwiseTensorComparison E F U).comp
        (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV) =
      (locallyConstantRestriction
          (ModuleCat.of ℂ (TensorProduct ℂ E F)) hUV).comp
        (pointwiseTensorComparison E F V) := by
  apply TensorProduct.ext'
  intro s t
  apply LocallyConstant.ext
  intro x
  rfl

/-- Elementwise form of naturality for the canonical tensor comparison. -/
theorem pointwiseTensorComparison_naturality_apply
    (E F : ModuleCat ℂ) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : (locallyConstantPointwiseTensor E F).obj V) :
    pointwiseTensorComparison E F U
        ((locallyConstantPointwiseTensor E F).res hUV z) =
      (locallyConstantTensorSheaf E F).res hUV
        (pointwiseTensorComparison E F V z) := by
  exact LinearMap.congr_fun
    (pointwiseTensorComparison_naturality E F hUV) z

/-- Explicit local-trivialization output.  This is deliberately additional
data: it says that the canonical comparison, characterized on pure tensors,
is a linear equivalence on every open set.  No such equivalence is postulated
for arbitrary pointwise tensor presheaves. -/
structure LocalTrivializationComparison (E F : ModuleCat ℂ) where
  app :
    ∀ U : TopologicalSpace.Opens X,
      (locallyConstantPointwiseTensor (X := X) E F).obj U ≃ₗ[ℂ]
        (locallyConstantTensorSheaf (X := X) E F).obj U
  app_tmul :
    ∀ (U : TopologicalSpace.Opens X)
      (s : LocallyConstant U E) (t : LocallyConstant U F) (x : U),
      ((app U (s ⊗ₜ[ℂ] t) :
          LocallyConstant U (TensorProduct ℂ E F)).toFun x) =
        s x ⊗ₜ[ℂ] t x

namespace LocalTrivializationComparison

variable {E F : ModuleCat ℂ}

/-- A local-trivialization comparison agrees with the canonical comparison on
all tensor sections, not merely on the displayed pure tensors. -/
theorem app_toLinearMap_eq (H : LocalTrivializationComparison E F)
    (U : TopologicalSpace.Opens X) :
    (H.app U).toLinearMap = pointwiseTensorComparison E F U := by
  apply TensorProduct.ext'
  intro s t
  apply LocallyConstant.ext
  intro x
  exact H.app_tmul U s t x

/-- The local-trivialization equivalences automatically commute with every
restriction because their underlying maps are the canonical comparison. -/
theorem naturality (H : LocalTrivializationComparison E F)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : (locallyConstantPointwiseTensor E F).obj V) :
    H.app U ((locallyConstantPointwiseTensor E F).res hUV z) =
      (locallyConstantTensorSheaf E F).res hUV (H.app V z) := by
  change
    (H.app U).toLinearMap
        (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV z) =
      locallyConstantRestriction
        (ModuleCat.of ℂ (TensorProduct ℂ E F)) hUV
          ((H.app V).toLinearMap z)
  rw [H.app_toLinearMap_eq U, H.app_toLinearMap_eq V]
  exact LinearMap.congr_fun
    (pointwiseTensorComparison_naturality E F hUV) z

/-- A local-trivialization comparison packages as an actual natural
linear-presheaf equivalence. -/
def toLinearPresheafEquiv
    (H : LocalTrivializationComparison (X := X) E F) :
    LinearPresheafEquiv
      (locallyConstantPointwiseTensor (X := X) E F)
      (locallyConstantTensorSheaf (X := X) E F) where
  app := H.app
  naturality := H.naturality

/-- Under the explicit local-trivialization comparison hypothesis, the
pointwise tensor presheaf is a sheaf. -/
theorem pointwiseTensor_isSheaf
    (H : LocalTrivializationComparison (X := X) E F) :
    IsSheafLike
      ((locallyConstantPointwiseTensor (X := X) E F).toPresheafLike) :=
  H.toLinearPresheafEquiv.isSheaf_of_equiv
    (locallyConstantTensorSheaf_isSheaf (X := X) E F)

end LocalTrivializationComparison

/-- Certificate recording the unconditional sheaf target and comparison map,
together with the precise additional hypothesis that upgrades the pointwise
tensor presheaf itself to a sheaf. -/
structure TensorSheafBoundaryCertificate (E F : ModuleCat ℂ) : Prop where
  tensor_target_isSheaf :
    IsSheafLike
      ((locallyConstantTensorSheaf (X := X) E F).toPresheafLike)
  comparison_on_pure_tensors :
    ∀ (U : TopologicalSpace.Opens X)
      (s : LocallyConstant U E) (t : LocallyConstant U F) (x : U),
      pointwiseTensorComparison (X := X) E F U (s ⊗ₜ[ℂ] t) x =
        s x ⊗ₜ[ℂ] t x
  comparison_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (z : (locallyConstantPointwiseTensor (X := X) E F).obj V),
      pointwiseTensorComparison (X := X) E F U
          ((locallyConstantPointwiseTensor (X := X) E F).res hUV z) =
        (locallyConstantTensorSheaf (X := X) E F).res hUV
          (pointwiseTensorComparison (X := X) E F V z)
  pointwise_isSheaf_under_local_trivialization :
    ∀ H : LocalTrivializationComparison (X := X) E F,
      IsSheafLike
        ((locallyConstantPointwiseTensor (X := X) E F).toPresheafLike)

/-- The pointwise/sheaf boundary is fully certified without asserting the
generally false unconditional sheafness of sectionwise tensor products. -/
theorem tensorSheafBoundary_certificate (E F : ModuleCat ℂ) :
    TensorSheafBoundaryCertificate (X := X) E F := by
  exact
    { tensor_target_isSheaf := locallyConstantTensorSheaf_isSheaf (X := X) E F
      comparison_on_pure_tensors :=
        pointwiseTensorComparison_tmul_apply (X := X) E F
      comparison_natural :=
        pointwiseTensorComparison_naturality_apply (X := X) E F
      pointwise_isSheaf_under_local_trivialization :=
        fun H => H.pointwiseTensor_isSheaf }

/-! #### Definition 12 specialized to the certified Lq and Mmock modules -/

section ActualTensor

variable {V : Type v}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- The genuine Definition 12 tensor presheaf for the corrected `Lq` solution
space and the homogeneous-variation model of `Mmock`. -/
def actualGenuineTensorPresheaf (D : Definition11.AnalyticData V)
    (A : Set ℂ) : LinearPresheaf Definition11.RadiusBase :=
  tensorPresheaf (lqLinearPresheaf D) (MmockLinear.linearMmockPresheaf A)

/-- Open-wise section module of the genuine Definition 12 tensor presheaf. -/
abbrev actualGenuineTensorSection (D : Definition11.AnalyticData V)
    (A : Set ℂ) (U : TopologicalSpace.Opens Definition11.RadiusBase) :=
  TensorSection (lqLinearPresheaf D) (MmockLinear.linearMmockPresheaf A) U

@[simp] theorem actualGenuineTensorPresheaf_obj
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    (U : TopologicalSpace.Opens Definition11.RadiusBase) :
    (actualGenuineTensorPresheaf D A).obj U =
      ModuleCat.of ℂ (actualGenuineTensorSection D A U) :=
  rfl

@[simp] theorem actualGenuineTensorPresheaf_res_tmul
    (D : Definition11.AnalyticData V) (A : Set ℂ)
    {U W : TopologicalSpace.Opens Definition11.RadiusBase} (hUW : U ≤ W)
    (l : (lqLinearPresheaf D).obj W)
    (m : (MmockLinear.linearMmockPresheaf A).obj W) :
    (actualGenuineTensorPresheaf D A).res hUW (l ⊗ₜ[ℂ] m) =
      (lqLinearPresheaf D).res hUW l ⊗ₜ[ℂ]
        (MmockLinear.linearMmockPresheaf A).res hUW m :=
  rfl

/-- The sheaf target associated with the genuine Definition 12 tensor. -/
def actualGenuineTensorSheaf (D : Definition11.AnalyticData V)
    (A : Set ℂ) : LinearPresheaf Definition11.RadiusBase :=
  locallyConstantTensorSheaf
    (ModuleCat.of ℂ D.solutionSpace) (MmockLinear.variationModule A)

/-- The actual locally constant tensor target is a proved sheaf. -/
theorem actualGenuineTensorSheaf_isSheaf
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    IsSheafLike (actualGenuineTensorSheaf D A).toPresheafLike :=
  locallyConstantTensorSheaf_isSheaf
    (ModuleCat.of ℂ D.solutionSpace) (MmockLinear.variationModule A)

/-- Algebraic Definition 12 certificate for the certified `Lq` and `Mmock`
linear presheaves. -/
theorem actualGenuineTensor_certificate
    (D : Definition11.AnalyticData V) (A : Set ℂ) :
    GenuineTensorCertificate (lqLinearPresheaf D)
      (MmockLinear.linearMmockPresheaf A) :=
  genuineTensor_certificate (lqLinearPresheaf D)
    (MmockLinear.linearMmockPresheaf A)

end ActualTensor

/-! #### The legacy pair and its conditional equivalence to tensor -/

/-- The Cartesian pair retained solely for compatibility with the older API. -/
abbrev PairSection
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :=
  L.obj U × M.obj U

/-- Componentwise complex-linear restriction on the legacy pair. -/
def pairRestriction
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    PairSection L M V →ₗ[ℂ] PairSection L M U where
  toFun s := (L.res hUV s.1, M.res hUV s.2)
  map_add' x y := by
    apply Prod.ext
    · exact (L.restrictionLinear hUV).map_add x.1 y.1
    · exact (M.restrictionLinear hUV).map_add x.2 y.2
  map_smul' c x := by
    apply Prod.ext
    · exact (L.restrictionLinear hUV).map_smul c x.1
    · exact (M.restrictionLinear hUV).map_smul c x.2

@[simp] theorem pairRestriction_fst
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : PairSection L M V) :
    (pairRestriction L M hUV s).1 = L.res hUV s.1 :=
  rfl

@[simp] theorem pairRestriction_snd
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : PairSection L M V) :
    (pairRestriction L M hUV s).2 = M.res hUV s.2 :=
  rfl

/-- Identity restriction for the legacy pair. -/
theorem pairRestriction_id
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :
    pairRestriction L M (le_refl U) = LinearMap.id := by
  apply LinearMap.ext
  intro s
  apply Prod.ext
  · exact L.toPresheafLike.res_id U s.1
  · exact M.toPresheafLike.res_id U s.2

/-- Contravariant composition for componentwise pair restriction. -/
theorem pairRestriction_comp
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V W : TopologicalSpace.Opens X}
    (hUV : U ≤ V) (hVW : V ≤ W) :
    (pairRestriction L M hUV).comp (pairRestriction L M hVW) =
      pairRestriction L M (le_trans hUV hVW) := by
  apply LinearMap.ext
  intro s
  apply Prod.ext
  · exact L.toPresheafLike.res_comp hUV hVW s.1
  · exact M.toPresheafLike.res_comp hUV hVW s.2

/-- The legacy Cartesian-pair presheaf, now honestly named and linearly
structured. -/
def pairPresheaf
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X) :
    LinearPresheaf.{u, max v w} X where
  obj U := ModuleCat.of.{max u (max v w), 0} ℂ (PairSection L M U)
  res hUV := ModuleCat.ofHom (pairRestriction L M hUV)
  res_id U s := by
    exact DFunLike.congr_fun (pairRestriction_id L M U) s
  res_comp hUV hVW s := by
    exact DFunLike.congr_fun (pairRestriction_comp L M hUV hVW) s

@[simp] theorem pairPresheaf_obj
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    (U : TopologicalSpace.Opens X) :
    (pairPresheaf L M).obj U = ModuleCat.of ℂ (PairSection L M U) :=
  rfl

@[simp] theorem pairPresheaf_res_apply
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : (pairPresheaf L M).obj V) :
    (pairPresheaf L M).res hUV s =
      (L.res hUV (show L.obj V from s.1),
        M.res hUV (show M.obj V from s.2)) :=
  rfl

/-- Additional hypotheses sufficient to identify the legacy pair with the
genuine tensor presheaf.  The data consist of forward and backward linear maps,
both inverse laws, and forward restriction naturality.  The actual
`LinearEquiv` is constructed below rather than assumed as a renamed field. -/
structure PairTensorEquivalenceData
    (L : LinearPresheaf.{u, v} X) (M : LinearPresheaf.{u, w} X) where
  pairToTensor :
    ∀ U : TopologicalSpace.Opens X,
      PairSection L M U →ₗ[ℂ] TensorSection L M U
  tensorToPair :
    ∀ U : TopologicalSpace.Opens X,
      TensorSection L M U →ₗ[ℂ] PairSection L M U
  left_inverse :
    ∀ (U : TopologicalSpace.Opens X) (s : PairSection L M U),
      tensorToPair U (pairToTensor U s) = s
  right_inverse :
    ∀ (U : TopologicalSpace.Opens X) (z : TensorSection L M U),
      pairToTensor U (tensorToPair U z) = z
  forward_naturality :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (s : PairSection L M V),
      pairToTensor U (pairRestriction L M hUV s) =
        tensorRestriction L M hUV (pairToTensor V s)

namespace PairTensorEquivalenceData

variable {L : LinearPresheaf.{u, v} X}
  {M : LinearPresheaf.{u, w} X}

/-- The two mutually inverse linear maps construct an actual fibrewise linear
equivalence. -/
def linearEquiv (H : PairTensorEquivalenceData L M)
    (U : TopologicalSpace.Opens X) :
    PairSection L M U ≃ₗ[ℂ] TensorSection L M U where
  toLinearMap := H.pairToTensor U
  invFun := H.tensorToPair U
  left_inv := H.left_inverse U
  right_inv := H.right_inverse U

@[simp] theorem tensorToPair_pairToTensor
    (H : PairTensorEquivalenceData L M)
    (U : TopologicalSpace.Opens X) (s : PairSection L M U) :
    H.tensorToPair U (H.pairToTensor U s) = s :=
  H.left_inverse U s

@[simp] theorem pairToTensor_tensorToPair
    (H : PairTensorEquivalenceData L M)
    (U : TopologicalSpace.Opens X) (z : TensorSection L M U) :
    H.pairToTensor U (H.tensorToPair U z) = z :=
  H.right_inverse U z

/-- The forward pair-to-tensor map commutes with restriction. -/
theorem pairToTensor_naturality (H : PairTensorEquivalenceData L M)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : PairSection L M V) :
    H.pairToTensor U (pairRestriction L M hUV s) =
      tensorRestriction L M hUV (H.pairToTensor V s) :=
  H.forward_naturality hUV s

/-- Naturality of the inverse tensor-to-pair map follows from forward
naturality and the two inverse identities. -/
theorem tensorToPair_naturality (H : PairTensorEquivalenceData L M)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : TensorSection L M V) :
    H.tensorToPair U (tensorRestriction L M hUV z) =
      pairRestriction L M hUV (H.tensorToPair V z) := by
  apply (H.linearEquiv U).injective
  change
    H.pairToTensor U
        (H.tensorToPair U (tensorRestriction L M hUV z)) =
      H.pairToTensor U
        (pairRestriction L M hUV (H.tensorToPair V z))
  rw [H.right_inverse U]
  rw [H.forward_naturality hUV (H.tensorToPair V z)]
  rw [H.right_inverse V]

/-- The explicit extra data yields an actual natural equivalence between the
pair presheaf and the tensor presheaf. -/
def toLinearPresheafEquiv (H : PairTensorEquivalenceData L M) :
    LinearPresheafEquiv (pairPresheaf L M) (tensorPresheaf L M) where
  app := H.linearEquiv
  naturality := H.forward_naturality

/-- Fibrewise statement of the actual pair/tensor linear equivalence. -/
def fibre_equiv (H : PairTensorEquivalenceData L M)
    (U : TopologicalSpace.Opens X) :
    PairSection L M U ≃ₗ[ℂ] TensorSection L M U :=
  H.linearEquiv U

/-- A sheaf structure can be transferred between the pair and tensor
presheaves only after the genuine natural equivalence data are supplied. -/
theorem pair_isSheaf_iff_tensor_isSheaf
    (H : PairTensorEquivalenceData L M) :
    IsSheafLike (pairPresheaf L M).toPresheafLike ↔
      IsSheafLike (tensorPresheaf L M).toPresheafLike :=
  H.toLinearPresheafEquiv.isSheaf_iff

end PairTensorEquivalenceData

/-- PR-facing audit certificate for a supplied, genuine pair/tensor
equivalence. -/
structure PairTensorEquivalenceCertificate
    {L : LinearPresheaf.{u, v} X} {M : LinearPresheaf.{u, w} X}
    (H : PairTensorEquivalenceData L M) : Prop where
  forward_inverse :
    ∀ (U : TopologicalSpace.Opens X) (s : PairSection L M U),
      H.tensorToPair U (H.pairToTensor U s) = s
  inverse_forward :
    ∀ (U : TopologicalSpace.Opens X) (z : TensorSection L M U),
      H.pairToTensor U (H.tensorToPair U z) = z
  forward_restriction_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (s : PairSection L M V),
      H.pairToTensor U (pairRestriction L M hUV s) =
        tensorRestriction L M hUV (H.pairToTensor V s)
  inverse_restriction_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (z : TensorSection L M V),
      H.tensorToPair U (tensorRestriction L M hUV z) =
        pairRestriction L M hUV (H.tensorToPair V z)

/-- Every supplied `PairTensorEquivalenceData` satisfies both inverse laws and
both naturality laws. -/
theorem pairTensorEquivalence_certificate
    {L : LinearPresheaf.{u, v} X} {M : LinearPresheaf.{u, w} X}
    (H : PairTensorEquivalenceData L M) :
    PairTensorEquivalenceCertificate H := by
  exact
    { forward_inverse := H.tensorToPair_pairToTensor
      inverse_forward := H.pairToTensor_tensorToPair
      forward_restriction_natural := H.pairToTensor_naturality
      inverse_restriction_natural := H.tensorToPair_naturality }

/-- Integrated certificate for every item in the corrected Definition 12
checklist.  It separates unconditional algebraic/sheaf-target facts from the
explicit extra data required to compare the retained pair API with tensor. -/
structure FullCertificate
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [CompleteSpace V] (D : Definition11.AnalyticData V) (A : Set ℂ) : Prop where
  lq_fibres_are_modules :
    ∀ U : TopologicalSpace.Opens Definition11.RadiusBase,
      Nonempty (Module ℂ ((lqLinearPresheaf D).obj U))
  mmock_fibres_are_modules :
    ∀ U : TopologicalSpace.Opens Mmock.RadiusBase,
      Nonempty (Module ℂ ((MmockLinear.linearMmockPresheaf A).obj U))
  lq_restrictions_are_linear :
    ∀ {U W : TopologicalSpace.Opens Definition11.RadiusBase} (hUW : U ≤ W),
      Nonempty
        ((lqLinearPresheaf D).obj W →ₗ[ℂ]
          (lqLinearPresheaf D).obj U)
  mmock_restrictions_are_linear :
    ∀ {U W : TopologicalSpace.Opens Mmock.RadiusBase} (hUW : U ≤ W),
      Nonempty
        ((MmockLinear.linearMmockPresheaf A).obj W →ₗ[ℂ]
          (MmockLinear.linearMmockPresheaf A).obj U)
  genuine_tensor_algebra :
    GenuineTensorCertificate (lqLinearPresheaf D)
      (MmockLinear.linearMmockPresheaf A)
  tensor_sheaf_boundary :
    TensorSheafBoundaryCertificate (X := Definition11.RadiusBase)
      (ModuleCat.of ℂ D.solutionSpace) (MmockLinear.variationModule A)
  actual_tensor_target_isSheaf :
    IsSheafLike (actualGenuineTensorSheaf D A).toPresheafLike
  pair_equivalence_under_explicit_data :
    ∀ H : PairTensorEquivalenceData (lqLinearPresheaf D)
      (MmockLinear.linearMmockPresheaf A),
      PairTensorEquivalenceCertificate H

/-- The integrated corrected Definition 12 certificate is constructed without
new axioms. -/
theorem full_certificate
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [CompleteSpace V] (D : Definition11.AnalyticData V) (A : Set ℂ) :
    FullCertificate D A := by
  exact
    { lq_fibres_are_modules := fun U => ⟨lq_fibre_has_module D U⟩
      mmock_fibres_are_modules := fun U =>
        ⟨MmockLinear.mmock_fibre_has_module A U⟩
      lq_restrictions_are_linear := lq_restriction_isLinear D
      mmock_restrictions_are_linear :=
        MmockLinear.mmock_restriction_isLinear A
      genuine_tensor_algebra := actualGenuineTensor_certificate D A
      tensor_sheaf_boundary := tensorSheafBoundary_certificate
        (X := Definition11.RadiusBase) (ModuleCat.of ℂ D.solutionSpace)
        (MmockLinear.variationModule A)
      actual_tensor_target_isSheaf := actualGenuineTensorSheaf_isSheaf D A
      pair_equivalence_under_explicit_data :=
        fun H => pairTensorEquivalence_certificate H }

end


end Definition12Tensor

/-!
## Definition 13: an actual q-covariant derivative with one-form codomain

The older `QGaugePresheaf.QCovariantDerivative` below is retained for API
compatibility.  The construction in this namespace has the paper's actual
codomain `Aq ⊗ Ω¹`, and its local formula and restriction law are theorems.
-/

namespace Definition13QCovariant

noncomputable section

open CategoryTheory
open Definition12Tensor

variable {X : Type u} [TopologicalSpace X]

/-! ### The logarithmic one-form calculus on the radius base -/

/-- Locally constant complex scalar functions on an open set. -/
abbrev ScalarSection (U : TopologicalSpace.Opens X) :=
  LocallyConstant U ℂ

/-- Coefficients of one-forms in the local frame `d(log r)`. -/
abbrev Omega1Section (U : TopologicalSpace.Opens X) :=
  LocallyConstant U ℂ

/-- The one-form module presheaf `Ω¹_(0,1)` in the logarithmic frame. -/
def omega1Presheaf : LinearPresheaf X :=
  locallyConstantLinearPresheaf (ModuleCat.of ℂ ℂ)

@[simp] theorem omega1Presheaf_obj (U : TopologicalSpace.Opens X) :
    (omega1Presheaf (X := X)).obj U =
      ModuleCat.of ℂ (Omega1Section U) :=
  rfl

/-- The logarithmic one-form presheaf is a genuine sheaf. -/
theorem omega1Presheaf_isSheaf :
    IsSheafLike (omega1Presheaf (X := X)).toPresheafLike :=
  locallyConstantLinearPresheaf_isSheaf (ModuleCat.of ℂ ℂ)

@[simp] theorem omega1Presheaf_res_apply
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (ω : (omega1Presheaf (X := X)).obj V) (x : U) :
    ((((omega1Presheaf (X := X)).res hUV ω :
        LocallyConstant U ℂ).toFun x)) =
      (ω : LocallyConstant V ℂ).toFun ⟨x.1, hUV x.2⟩ :=
  rfl

/-- The distinguished logarithmic frame `d(log r)`. -/
def dlogFrame (U : TopologicalSpace.Opens X) : Omega1Section U :=
  LocallyConstant.const U (1 : ℂ)

@[simp] theorem dlogFrame_apply (U : TopologicalSpace.Opens X) (x : U) :
    dlogFrame U x = 1 :=
  rfl

/-- The logarithmic frame is preserved by restriction. -/
theorem dlogFrame_restrict {U V : TopologicalSpace.Opens X} (hUV : U ≤ V) :
    (omega1Presheaf (X := X)).res hUV (dlogFrame V) = dlogFrame U := by
  apply LocallyConstant.ext
  intro x
  rfl

/-- On the locally constant scalar algebra, the logarithmic differential is
the zero complex-linear map.  Nontrivial q-series differentiation is supplied
separately on the `Mmock` fibre. -/
def logDifferential (U : TopologicalSpace.Opens X) :
    ScalarSection U →ₗ[ℂ] Omega1Section U :=
  0

@[simp] theorem logDifferential_apply
    (U : TopologicalSpace.Opens X) (f : ScalarSection U) :
    logDifferential U f = 0 :=
  rfl

/-- The scalar logarithmic differential commutes with restriction. -/
theorem logDifferential_restrict {U V : TopologicalSpace.Opens X}
    (hUV : U ≤ V) (f : ScalarSection V) :
    (omega1Presheaf (X := X)).res hUV (logDifferential V f) =
      logDifferential U
        ((locallyConstantLinearPresheaf (ModuleCat.of ℂ ℂ)).res hUV f) := by
  apply LocallyConstant.ext
  intro x
  rfl

/-- Leibniz rule for the locally constant scalar differential. -/
theorem logDifferential_leibniz (U : TopologicalSpace.Opens X)
    (f g : ScalarSection U) :
    logDifferential U (f * g) =
      f * logDifferential U g + g * logDifferential U f := by
  simp [logDifferential]

/-- Pointwise multiplication of a module-valued locally constant section by a
locally constant scalar. -/
def sectionScalarMul (E : ModuleCat ℂ) {U : TopologicalSpace.Opens X}
    (f : ScalarSection U) (s : LocallyConstant U E) :
    LocallyConstant U E where
  toFun x := f x • s x
  isLocallyConstant :=
    f.isLocallyConstant.comp₂ s.isLocallyConstant (fun c y => c • y)

@[simp] theorem sectionScalarMul_apply (E : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (s : LocallyConstant U E) (x : U) :
    sectionScalarMul E f s x = f x • s x :=
  rfl

/-- For fixed `f`, pointwise scalar multiplication is complex-linear in the
module-valued section. -/
def sectionScalarAction (E : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U) :
    LocallyConstant U E →ₗ[ℂ] LocallyConstant U E where
  toFun := sectionScalarMul E f
  map_add' s t := by
    apply LocallyConstant.ext
    intro x
    exact smul_add (f x) (s x) (t x)
  map_smul' c s := by
    apply LocallyConstant.ext
    intro x
    change f x • (c • s x) = c • (f x • s x)
    rw [smul_smul, smul_smul, mul_comm]

@[simp] theorem sectionScalarAction_apply (E : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (s : LocallyConstant U E) :
    sectionScalarAction E f s = sectionScalarMul E f s :=
  rfl

/-- Pointwise scalar multiplication is compatible with restriction. -/
theorem sectionScalarAction_restrict (E : ModuleCat ℂ)
    {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (f : ScalarSection V) (s : LocallyConstant V E) :
    (locallyConstantLinearPresheaf E).res hUV
        (sectionScalarAction E f s) =
      sectionScalarAction E
        ((locallyConstantLinearPresheaf (ModuleCat.of ℂ ℂ)).res hUV f)
        ((locallyConstantLinearPresheaf E).res hUV s) := by
  apply LocallyConstant.ext
  intro x
  rfl

/-! ### Fibre operators and one-form-valued factor connections -/

/-- A fixed fibre operator acts pointwise on locally constant sections. -/
def pointwiseOperator {E : ModuleCat ℂ} (T : E →ₗ[ℂ] E)
    (U : TopologicalSpace.Opens X) :
    LocallyConstant U E →ₗ[ℂ] LocallyConstant U E :=
  LocallyConstant.mapₗ ℂ T

@[simp] theorem pointwiseOperator_apply {E : ModuleCat ℂ}
    (T : E →ₗ[ℂ] E) (U : TopologicalSpace.Opens X)
    (s : LocallyConstant U E) (x : U) :
    pointwiseOperator T U s x = T (s x) :=
  rfl

/-- Pointwise fibre operators commute with restriction by construction. -/
theorem pointwiseOperator_restrict {E : ModuleCat ℂ}
    (T : E →ₗ[ℂ] E) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : LocallyConstant V E) :
    (locallyConstantLinearPresheaf E).res hUV (pointwiseOperator T V s) =
      pointwiseOperator T U ((locallyConstantLinearPresheaf E).res hUV s) := by
  apply LocallyConstant.ext
  intro x
  rfl

/-- Pointwise fibre operators are linear over locally constant scalars. -/
theorem pointwiseOperator_scalar {E : ModuleCat ℂ}
    (T : E →ₗ[ℂ] E) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (s : LocallyConstant U E) :
    pointwiseOperator T U (sectionScalarAction E f s) =
      sectionScalarAction E f (pointwiseOperator T U s) := by
  apply LocallyConstant.ext
  intro x
  exact T.map_smul (f x) (s x)

/-- Tensoring a module element with a fixed one-form is a complex-linear map. -/
def tensorWithForm {A : Type v} {B : Type w}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (ω : B) : A →ₗ[ℂ] TensorProduct ℂ A B where
  toFun a := a ⊗ₜ[ℂ] ω
  map_add' a b := TensorProduct.add_tmul a b ω
  map_smul' c a := (TensorProduct.smul_tmul' c a ω).symm

@[simp] theorem tensorWithForm_apply {A : Type v} {B : Type w}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (ω : B) (a : A) :
    tensorWithForm ω a = a ⊗ₜ[ℂ] ω :=
  rfl

/-- A fibre operator promoted to a one-form-valued connection in the frame
`d(log r)`. -/
def framedOperator {E : ModuleCat ℂ} (T : E →ₗ[ℂ] E)
    (U : TopologicalSpace.Opens X) :
    LocallyConstant U E →ₗ[ℂ]
      TensorSection (locallyConstantLinearPresheaf E)
        (omega1Presheaf (X := X)) U :=
  (tensorWithForm (dlogFrame U)).comp (pointwiseOperator T U)

@[simp] theorem framedOperator_apply {E : ModuleCat ℂ}
    (T : E →ₗ[ℂ] E) (U : TopologicalSpace.Opens X)
    (s : LocallyConstant U E) :
    framedOperator T U s =
      pointwiseOperator T U s ⊗ₜ[ℂ] dlogFrame U :=
  rfl

/-- The framed factor operator commutes with restriction; this is derived from
pointwise restriction and preservation of `d(log r)`. -/
theorem framedOperator_restrict {E : ModuleCat ℂ}
    (T : E →ₗ[ℂ] E) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : LocallyConstant V E) :
    tensorRestriction (locallyConstantLinearPresheaf E)
        (omega1Presheaf (X := X)) hUV (framedOperator T V s) =
      framedOperator T U ((locallyConstantLinearPresheaf E).res hUV s) := by
  change
    (locallyConstantRestriction E hUV (pointwiseOperator T V s)) ⊗ₜ[ℂ]
        (locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V)) =
      pointwiseOperator T U (locallyConstantRestriction E hUV s) ⊗ₜ[ℂ]
        dlogFrame U
  have hpoint :
      locallyConstantRestriction E hUV (pointwiseOperator T V s) =
        pointwiseOperator T U (locallyConstantRestriction E hUV s) := by
    apply LocallyConstant.ext
    intro x
    rfl
  have hframe :
      locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V) =
        dlogFrame U := by
    apply LocallyConstant.ext
    intro x
    rfl
  rw [hpoint, hframe]

/-- The paper-level fibre operators: the q-connection potential on `Lq` and
the logarithmic q-derivative on `Mmock`.  Supplying the second map directly on
the certified `Mmock` variation fibre makes convergence/matching preservation
part of its type rather than an unstated analytic assertion. -/
structure FibreOperators (E F : ModuleCat ℂ) where
  qPotential : E →ₗ[ℂ] E
  logDerivative : F →ₗ[ℂ] F

/-- The unconditional flat/constant operator data. -/
def zeroFibreOperators (E F : ModuleCat ℂ) : FibreOperators E F where
  qPotential := 0
  logDerivative := 0

/-- The one-form-valued q-connection on the `Lq` factor. -/
def nablaQFactor {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    LocallyConstant U E →ₗ[ℂ]
      TensorSection (locallyConstantLinearPresheaf E)
        (omega1Presheaf (X := X)) U :=
  framedOperator P.qPotential U

/-- The one-form-valued logarithmic derivative on the `Mmock` factor. -/
def dQFactor {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    LocallyConstant U F →ₗ[ℂ]
      TensorSection (locallyConstantLinearPresheaf F)
        (omega1Presheaf (X := X)) U :=
  framedOperator P.logDerivative U

@[simp] theorem nablaQFactor_apply {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (s : LocallyConstant U E) :
    nablaQFactor P U s =
      pointwiseOperator P.qPotential U s ⊗ₜ[ℂ] dlogFrame U :=
  rfl

@[simp] theorem dQFactor_apply {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (s : LocallyConstant U F) :
    dQFactor P U s =
      pointwiseOperator P.logDerivative U s ⊗ₜ[ℂ] dlogFrame U :=
  rfl

theorem nablaQFactor_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : LocallyConstant V E) :
    tensorRestriction (locallyConstantLinearPresheaf E)
        (omega1Presheaf (X := X)) hUV (nablaQFactor P V s) =
      nablaQFactor P U ((locallyConstantLinearPresheaf E).res hUV s) :=
  framedOperator_restrict P.qPotential hUV s

theorem dQFactor_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (s : LocallyConstant V F) :
    tensorRestriction (locallyConstantLinearPresheaf F)
        (omega1Presheaf (X := X)) hUV (dQFactor P V s) =
      dQFactor P U ((locallyConstantLinearPresheaf F).res hUV s) :=
  framedOperator_restrict P.logDerivative hUV s

/-! ### The two tensor summands and their sum -/

/-- The genuine q-gauge section module on `U`. -/
abbrev AqSection (E F : ModuleCat ℂ) (U : TopologicalSpace.Opens X) :=
  TensorProduct ℂ (LocallyConstant U E) (LocallyConstant U F)

/-- The required one-form-valued codomain `(Aq ⊗ Ω¹)(U)`. -/
abbrev AqOmega1Section (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :=
  TensorProduct ℂ (AqSection E F U) (Omega1Section U)

/-- The pointwise tensor presheaf underlying `Aq`. -/
def aqPresheaf (E F : ModuleCat ℂ) : LinearPresheaf X :=
  locallyConstantPointwiseTensor E F

/-- The actual codomain presheaf `Aq ⊗ Ω¹`. -/
def aqOmega1Presheaf (E F : ModuleCat ℂ) : LinearPresheaf X :=
  tensorPresheaf (aqPresheaf E F) (omega1Presheaf (X := X))

@[simp] theorem aqPresheaf_obj (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :
    (aqPresheaf E F).obj U = ModuleCat.of ℂ (AqSection E F U) :=
  rfl

@[simp] theorem aqOmega1Presheaf_obj (E F : ModuleCat ℂ)
    (U : TopologicalSpace.Opens X) :
    (aqOmega1Presheaf E F).obj U =
      ModuleCat.of ℂ (AqOmega1Section E F U) :=
  rfl

/-- Reorder `((L ⊗ Ω) ⊗ M)` as `((L ⊗ M) ⊗ Ω)`. -/
def leftTensorReassociate (L M O : ModuleCat ℂ) :
    TensorProduct ℂ (TensorProduct ℂ L O) M →ₗ[ℂ]
      TensorProduct ℂ (TensorProduct ℂ L M) O :=
  (TensorProduct.assoc ℂ L M O).symm.toLinearMap.comp
    ((TensorProduct.map
        (LinearMap.id : L →ₗ[ℂ] L)
        (TensorProduct.comm ℂ O M).toLinearMap).comp
      (TensorProduct.assoc ℂ L O M).toLinearMap)

@[simp] theorem leftTensorReassociate_tmul
    (L M O : ModuleCat ℂ) (l : L) (m : M) (ω : O) :
    leftTensorReassociate L M O ((l ⊗ₜ[ℂ] ω) ⊗ₜ[ℂ] m) =
      (l ⊗ₜ[ℂ] m) ⊗ₜ[ℂ] ω := by
  simp [leftTensorReassociate]

/-- Reassociate `L ⊗ (M ⊗ Ω)` as `(L ⊗ M) ⊗ Ω`. -/
def rightTensorReassociate (L M O : ModuleCat ℂ) :
    TensorProduct ℂ L (TensorProduct ℂ M O) →ₗ[ℂ]
      TensorProduct ℂ (TensorProduct ℂ L M) O :=
  (TensorProduct.assoc ℂ L M O).symm.toLinearMap

@[simp] theorem rightTensorReassociate_tmul
    (L M O : ModuleCat ℂ) (l : L) (m : M) (ω : O) :
    rightTensorReassociate L M O (l ⊗ₜ[ℂ] (m ⊗ₜ[ℂ] ω)) =
      (l ⊗ₜ[ℂ] m) ⊗ₜ[ℂ] ω := by
  simp [rightTensorReassociate]

/-- The actual linear map `∇⁽q⁾ ⊗ id`, with its codomain reassociated to
`Aq(U) ⊗ Ω¹(U)`. -/
def nablaTensorId {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqOmega1Section E F U :=
  (leftTensorReassociate
      (ModuleCat.of ℂ (LocallyConstant U E))
      (ModuleCat.of ℂ (LocallyConstant U F))
      (ModuleCat.of ℂ (Omega1Section U))).comp
    (TensorProduct.map (nablaQFactor P U)
      (LinearMap.id : LocallyConstant U F →ₗ[ℂ] LocallyConstant U F))

/-- The actual linear map `id ⊗ d_q`, with its codomain reassociated to
`Aq(U) ⊗ Ω¹(U)`. -/
def idTensorDq {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqOmega1Section E F U :=
  (rightTensorReassociate
      (ModuleCat.of ℂ (LocallyConstant U E))
      (ModuleCat.of ℂ (LocallyConstant U F))
      (ModuleCat.of ℂ (Omega1Section U))).comp
    (TensorProduct.map
      (LinearMap.id : LocallyConstant U E →ₗ[ℂ] LocallyConstant U E)
      (dQFactor P U))

@[simp] theorem nablaTensorId_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    nablaTensorId P U (l ⊗ₜ[ℂ] m) =
      (pointwiseOperator P.qPotential U l ⊗ₜ[ℂ] m) ⊗ₜ[ℂ]
        dlogFrame U := by
  change
    leftTensorReassociate
        (ModuleCat.of ℂ (LocallyConstant U E))
        (ModuleCat.of ℂ (LocallyConstant U F))
        (ModuleCat.of ℂ (Omega1Section U))
      ((nablaQFactor P U l) ⊗ₜ[ℂ] m) = _
  rw [nablaQFactor_apply, leftTensorReassociate_tmul]

@[simp] theorem idTensorDq_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    idTensorDq P U (l ⊗ₜ[ℂ] m) =
      (l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative U m) ⊗ₜ[ℂ]
        dlogFrame U := by
  change
    rightTensorReassociate
        (ModuleCat.of ℂ (LocallyConstant U E))
        (ModuleCat.of ℂ (LocallyConstant U F))
        (ModuleCat.of ℂ (Omega1Section U))
      (l ⊗ₜ[ℂ] dQFactor P U m) = _
  rw [dQFactor_apply, rightTensorReassociate_tmul]

/-- Definition 13: the sum `∇⁽q⁾ ⊗ id + id ⊗ d_q`, as an actual
complex-linear map with one-form codomain. -/
def Dq {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqOmega1Section E F U :=
  nablaTensorId P U + idTensorDq P U

/-- The constructed covariant derivative is definitionally the sum of the two
paper terms. -/
theorem Dq_eq_nablaTensorId_add_idTensorDq {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X) :
    Dq P U = nablaTensorId P U + idTensorDq P U :=
  rfl

@[simp] theorem Dq_apply {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (z : AqSection E F U) :
    Dq P U z = nablaTensorId P U z + idTensorDq P U z :=
  rfl

@[simp] theorem Dq_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    Dq P U (l ⊗ₜ[ℂ] m) =
      (pointwiseOperator P.qPotential U l ⊗ₜ[ℂ] m) ⊗ₜ[ℂ] dlogFrame U +
        (l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative U m) ⊗ₜ[ℂ]
          dlogFrame U := by
  rw [Dq_apply, nablaTensorId_tmul, idTensorDq_tmul]

/-- Complex additivity is inherited from the constructed linear map. -/
theorem Dq_map_add {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (x y : AqSection E F U) :
    Dq P U (x + y) = Dq P U x + Dq P U y :=
  (Dq P U).map_add x y

/-- Complex homogeneity is inherited from the constructed linear map. -/
theorem Dq_map_smul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (c : ℂ) (z : AqSection E F U) :
    Dq P U (c • z) = c • Dq P U z :=
  (Dq P U).map_smul c z

/-! ### The local trivialization coefficient `d/d(log r) + A_q(t)` -/

/-- The q-gauge-potential coefficient `A_q(t)` on `Aq(U)`. -/
def potentialCoefficient {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqSection E F U :=
  TensorProduct.map (pointwiseOperator P.qPotential U)
    (LinearMap.id : LocallyConstant U F →ₗ[ℂ] LocallyConstant U F)

/-- The logarithmic radial coefficient `d/d(log r)` on `Aq(U)`. -/
def logRadialCoefficient {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqSection E F U :=
  TensorProduct.map
    (LinearMap.id : LocallyConstant U E →ₗ[ℂ] LocallyConstant U E)
    (pointwiseOperator P.logDerivative U)

/-- The local coefficient operator in the paper's displayed order
`d/d(log r) + A_q(t)`. -/
def localCoefficient {E F : ModuleCat ℂ} (P : FibreOperators E F)
    (U : TopologicalSpace.Opens X) :
    AqSection E F U →ₗ[ℂ] AqSection E F U :=
  logRadialCoefficient P U + potentialCoefficient P U

@[simp] theorem potentialCoefficient_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    potentialCoefficient P U (l ⊗ₜ[ℂ] m) =
      pointwiseOperator P.qPotential U l ⊗ₜ[ℂ] m :=
  rfl

@[simp] theorem logRadialCoefficient_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    logRadialCoefficient P U (l ⊗ₜ[ℂ] m) =
      l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative U m :=
  rfl

@[simp] theorem localCoefficient_apply {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (z : AqSection E F U) :
    localCoefficient P U z =
      logRadialCoefficient P U z + potentialCoefficient P U z :=
  rfl

@[simp] theorem localCoefficient_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    localCoefficient P U (l ⊗ₜ[ℂ] m) =
      (l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative U m) +
        (pointwiseOperator P.qPotential U l ⊗ₜ[ℂ] m) := by
  rw [localCoefficient_apply, logRadialCoefficient_tmul,
    potentialCoefficient_tmul]

/-- Local-frame formula for `∇⁽q⁾ ⊗ id` on every tensor section. -/
theorem nablaTensorId_localTrivialization {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (z : AqSection E F U) :
    nablaTensorId P U z =
      tensorWithForm (dlogFrame U) (potentialCoefficient P U z) := by
  have hmap : nablaTensorId P U =
      (tensorWithForm (dlogFrame U)).comp (potentialCoefficient P U) := by
    apply TensorProduct.ext'
    intro l m
    rw [nablaTensorId_tmul, LinearMap.comp_apply, potentialCoefficient_tmul,
      tensorWithForm_apply]
  exact LinearMap.congr_fun hmap z

/-- Local-frame formula for `id ⊗ d_q` on every tensor section. -/
theorem idTensorDq_localTrivialization {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (z : AqSection E F U) :
    idTensorDq P U z =
      tensorWithForm (dlogFrame U) (logRadialCoefficient P U z) := by
  have hmap : idTensorDq P U =
      (tensorWithForm (dlogFrame U)).comp (logRadialCoefficient P U) := by
    apply TensorProduct.ext'
    intro l m
    rw [idTensorDq_tmul, LinearMap.comp_apply, logRadialCoefficient_tmul,
      tensorWithForm_apply]
  exact LinearMap.congr_fun hmap z

/-- Pure-tensor form of the local trivialization formula. -/
theorem Dq_localTrivialization_tmul {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    Dq P U (l ⊗ₜ[ℂ] m) =
      tensorWithForm (dlogFrame U)
        (localCoefficient P U (l ⊗ₜ[ℂ] m)) := by
  rw [Dq_tmul, tensorWithForm_apply, localCoefficient_tmul,
    TensorProduct.add_tmul]
  exact add_comm _ _

/-- Definition 13's local formula on every tensor section:
`Dq = (d/d(log r) + A_q(t)) · d(log r)`. -/
theorem Dq_localTrivialization {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (z : AqSection E F U) :
    Dq P U z =
      tensorWithForm (dlogFrame U) (localCoefficient P U z) := by
  have hmap : Dq P U =
      (tensorWithForm (dlogFrame U)).comp (localCoefficient P U) := by
    apply TensorProduct.ext'
    intro l m
    exact Dq_localTrivialization_tmul P U l m
  exact LinearMap.congr_fun hmap z

/-! ### Restriction naturality derived from the construction -/

/-- The potential coefficient commutes with restriction. -/
theorem potentialCoefficient_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqPresheaf E F).res hUV (potentialCoefficient P V z) =
      potentialCoefficient P U ((aqPresheaf E F).res hUV z) := by
  have hmap :
      (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV).comp
          (potentialCoefficient P V) =
        (potentialCoefficient P U).comp
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV) := by
    apply TensorProduct.ext'
    intro l m
    change
      TensorProduct.map
          (locallyConstantRestriction E hUV)
          (locallyConstantRestriction F hUV)
          (pointwiseOperator P.qPotential V l ⊗ₜ[ℂ] m) =
        pointwiseOperator P.qPotential U
            (locallyConstantRestriction E hUV l) ⊗ₜ[ℂ]
          (locallyConstantRestriction F hUV m)
    rw [TensorProduct.map_tmul]
    have hop := pointwiseOperator_restrict
      (X := X) P.qPotential hUV l
    change
      locallyConstantRestriction E hUV
          (pointwiseOperator P.qPotential V l) =
        pointwiseOperator P.qPotential U
          (locallyConstantRestriction E hUV l) at hop
    rw [hop]
  exact LinearMap.congr_fun hmap z

/-- The logarithmic radial coefficient commutes with restriction. -/
theorem logRadialCoefficient_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqPresheaf E F).res hUV (logRadialCoefficient P V z) =
      logRadialCoefficient P U ((aqPresheaf E F).res hUV z) := by
  have hmap :
      (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV).comp
          (logRadialCoefficient P V) =
        (logRadialCoefficient P U).comp
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV) := by
    apply TensorProduct.ext'
    intro l m
    change
      TensorProduct.map
          (locallyConstantRestriction E hUV)
          (locallyConstantRestriction F hUV)
          (l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative V m) =
        locallyConstantRestriction E hUV l ⊗ₜ[ℂ]
          pointwiseOperator P.logDerivative U
            (locallyConstantRestriction F hUV m)
    rw [TensorProduct.map_tmul]
    have hop := pointwiseOperator_restrict
      (X := X) P.logDerivative hUV m
    change
      locallyConstantRestriction F hUV
          (pointwiseOperator P.logDerivative V m) =
        pointwiseOperator P.logDerivative U
          (locallyConstantRestriction F hUV m) at hop
    rw [hop]
  exact LinearMap.congr_fun hmap z

/-- The complete local coefficient `d/d(log r) + A_q(t)` commutes with
restriction. -/
theorem localCoefficient_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqPresheaf E F).res hUV (localCoefficient P V z) =
      localCoefficient P U ((aqPresheaf E F).res hUV z) := by
  have hmap :
      (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV).comp
          (localCoefficient P V) =
        (localCoefficient P U).comp
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV) := by
    apply TensorProduct.ext'
    intro l m
    change
      TensorProduct.map
          (locallyConstantRestriction E hUV)
          (locallyConstantRestriction F hUV)
          ((l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative V m) +
            (pointwiseOperator P.qPotential V l ⊗ₜ[ℂ] m)) =
        (locallyConstantRestriction E hUV l ⊗ₜ[ℂ]
            pointwiseOperator P.logDerivative U
              (locallyConstantRestriction F hUV m)) +
          (pointwiseOperator P.qPotential U
              (locallyConstantRestriction E hUV l) ⊗ₜ[ℂ]
            locallyConstantRestriction F hUV m)
    rw [LinearMap.map_add, TensorProduct.map_tmul,
      TensorProduct.map_tmul]
    have hlog := pointwiseOperator_restrict
      (X := X) P.logDerivative hUV m
    change
      locallyConstantRestriction F hUV
          (pointwiseOperator P.logDerivative V m) =
        pointwiseOperator P.logDerivative U
          (locallyConstantRestriction F hUV m) at hlog
    have hpot := pointwiseOperator_restrict
      (X := X) P.qPotential hUV l
    change
      locallyConstantRestriction E hUV
          (pointwiseOperator P.qPotential V l) =
        pointwiseOperator P.qPotential U
          (locallyConstantRestriction E hUV l) at hpot
    rw [hlog, hpot]
  exact LinearMap.congr_fun hmap z

/-- Restriction naturality of `∇⁽q⁾ ⊗ id`, derived termwise. -/
theorem nablaTensorId_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqOmega1Presheaf E F).res hUV (nablaTensorId P V z) =
      nablaTensorId P U ((aqPresheaf E F).res hUV z) := by
  have hmap :
      (tensorRestriction (aqPresheaf E F)
          (omega1Presheaf (X := X)) hUV).comp
          (nablaTensorId P V) =
        (nablaTensorId P U).comp
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV) := by
    apply TensorProduct.ext'
    intro l m
    change
      TensorProduct.map
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV)
          (locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV)
          ((pointwiseOperator P.qPotential V l ⊗ₜ[ℂ] m) ⊗ₜ[ℂ]
            dlogFrame V) =
        ((pointwiseOperator P.qPotential U
              (locallyConstantRestriction E hUV l) ⊗ₜ[ℂ]
            locallyConstantRestriction F hUV m) ⊗ₜ[ℂ]
          dlogFrame U)
    have hpot := pointwiseOperator_restrict
      (X := X) P.qPotential hUV l
    change
      locallyConstantRestriction E hUV
          (pointwiseOperator P.qPotential V l) =
        pointwiseOperator P.qPotential U
          (locallyConstantRestriction E hUV l) at hpot
    have hframe := dlogFrame_restrict (X := X) hUV
    change
      locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V) =
        dlogFrame U at hframe
    change
      ((locallyConstantRestriction E hUV
          (pointwiseOperator P.qPotential V l) ⊗ₜ[ℂ]
        locallyConstantRestriction F hUV m) ⊗ₜ[ℂ]
          locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V)) =
        ((pointwiseOperator P.qPotential U
            (locallyConstantRestriction E hUV l) ⊗ₜ[ℂ]
          locallyConstantRestriction F hUV m) ⊗ₜ[ℂ] dlogFrame U)
    rw [hpot, hframe]
  exact LinearMap.congr_fun hmap z

/-- Restriction naturality of `id ⊗ d_q`, derived termwise. -/
theorem idTensorDq_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqOmega1Presheaf E F).res hUV (idTensorDq P V z) =
      idTensorDq P U ((aqPresheaf E F).res hUV z) := by
  have hmap :
      (tensorRestriction (aqPresheaf E F)
          (omega1Presheaf (X := X)) hUV).comp
          (idTensorDq P V) =
        (idTensorDq P U).comp
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV) := by
    apply TensorProduct.ext'
    intro l m
    change
      TensorProduct.map
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV)
          (locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV)
          ((l ⊗ₜ[ℂ] pointwiseOperator P.logDerivative V m) ⊗ₜ[ℂ]
            dlogFrame V) =
        ((locallyConstantRestriction E hUV l ⊗ₜ[ℂ]
            pointwiseOperator P.logDerivative U
              (locallyConstantRestriction F hUV m)) ⊗ₜ[ℂ]
          dlogFrame U)
    have hlog := pointwiseOperator_restrict
      (X := X) P.logDerivative hUV m
    change
      locallyConstantRestriction F hUV
          (pointwiseOperator P.logDerivative V m) =
        pointwiseOperator P.logDerivative U
          (locallyConstantRestriction F hUV m) at hlog
    have hframe := dlogFrame_restrict (X := X) hUV
    change
      locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V) =
        dlogFrame U at hframe
    change
      ((locallyConstantRestriction E hUV l ⊗ₜ[ℂ]
        locallyConstantRestriction F hUV
          (pointwiseOperator P.logDerivative V m)) ⊗ₜ[ℂ]
          locallyConstantRestriction (ModuleCat.of ℂ ℂ) hUV (dlogFrame V)) =
        ((locallyConstantRestriction E hUV l ⊗ₜ[ℂ]
          pointwiseOperator P.logDerivative U
            (locallyConstantRestriction F hUV m)) ⊗ₜ[ℂ] dlogFrame U)
    rw [hlog, hframe]
  exact LinearMap.congr_fun hmap z

/-- The constructed Definition 13 derivative commutes with restriction.  This
is a theorem derived from the two pointwise fibre operators and the logarithmic
frame, not a field of the derivative. -/
theorem Dq_restrict {E F : ModuleCat ℂ}
    (P : FibreOperators E F) {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
    (z : AqSection E F V) :
    (aqOmega1Presheaf E F).res hUV (Dq P V z) =
      Dq P U ((aqPresheaf E F).res hUV z) := by
  have hn := nablaTensorId_restrict (X := X) P hUV z
  have hi := idTensorDq_restrict (X := X) P hUV z
  change
    tensorRestriction (aqPresheaf E F) (omega1Presheaf (X := X)) hUV
        (nablaTensorId P V z + idTensorDq P V z) =
      nablaTensorId P U
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV z) +
        idTensorDq P U
          (tensorRestriction (locallyConstantLinearPresheaf E)
            (locallyConstantLinearPresheaf F) hUV z)
  change
    tensorRestriction (aqPresheaf E F) (omega1Presheaf (X := X)) hUV
        (nablaTensorId P V z) =
      nablaTensorId P U
        (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV z) at hn
  change
    tensorRestriction (aqPresheaf E F) (omega1Presheaf (X := X)) hUV
        (idTensorDq P V z) =
      idTensorDq P U
        (tensorRestriction (locallyConstantLinearPresheaf E)
          (locallyConstantLinearPresheaf F) hUV z) at hi
  calc
    _ = tensorRestriction (aqPresheaf E F) (omega1Presheaf (X := X)) hUV
          (nablaTensorId P V z) +
        tensorRestriction (aqPresheaf E F) (omega1Presheaf (X := X)) hUV
          (idTensorDq P V z) :=
      (tensorRestriction (aqPresheaf E F)
        (omega1Presheaf (X := X)) hUV).map_add _ _
    _ = _ := congrArg₂ (· + ·) hn hi

/-! ### Complex linearity and the full scalar Leibniz rule -/

/-- Locally constant scalars act on `Aq(U)` through its `Lq` factor. -/
def aqScalarAction (E F : ModuleCat ℂ) {U : TopologicalSpace.Opens X}
    (f : ScalarSection U) : AqSection E F U →ₗ[ℂ] AqSection E F U :=
  TensorProduct.map (sectionScalarAction E f)
    (LinearMap.id : LocallyConstant U F →ₗ[ℂ] LocallyConstant U F)

@[simp] theorem aqScalarAction_tmul (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (l : LocallyConstant U E) (m : LocallyConstant U F) :
    aqScalarAction E F f (l ⊗ₜ[ℂ] m) =
      sectionScalarAction E f l ⊗ₜ[ℂ] m :=
  rfl

/-- Scalar action on the one-form-valued codomain, through the `Aq` factor. -/
def aqOmega1ScalarAction (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U) :
    AqOmega1Section E F U →ₗ[ℂ] AqOmega1Section E F U :=
  TensorProduct.map (aqScalarAction E F f)
    (LinearMap.id : Omega1Section U →ₗ[ℂ] Omega1Section U)

@[simp] theorem aqOmega1ScalarAction_tmul (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (z : AqSection E F U) (ω : Omega1Section U) :
    aqOmega1ScalarAction E F f (z ⊗ₜ[ℂ] ω) =
      aqScalarAction E F f z ⊗ₜ[ℂ] ω :=
  rfl

/-- The Leibniz correction `z ⊗ dlog(f)`. -/
def leibnizCorrection (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U) :
    AqSection E F U →ₗ[ℂ] AqOmega1Section E F U :=
  tensorWithForm (logDifferential U f)

@[simp] theorem leibnizCorrection_apply (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (z : AqSection E F U) :
    leibnizCorrection E F f z = z ⊗ₜ[ℂ] logDifferential U f :=
  rfl

/-- In the locally constant scalar calculus the Leibniz correction vanishes. -/
@[simp] theorem leibnizCorrection_eq_zero (E F : ModuleCat ℂ)
    {U : TopologicalSpace.Opens X} (f : ScalarSection U)
    (z : AqSection E F U) :
    leibnizCorrection E F f z = 0 := by
  simp [leibnizCorrection]

/-- The potential coefficient is linear over locally constant scalars. -/
theorem potentialCoefficient_scalar {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (z : AqSection E F U) :
    potentialCoefficient P U (aqScalarAction E F f z) =
      aqScalarAction E F f (potentialCoefficient P U z) := by
  have hmap :
      (potentialCoefficient P U).comp (aqScalarAction E F f) =
        (aqScalarAction E F f).comp (potentialCoefficient P U) := by
    apply TensorProduct.ext'
    intro l m
    simp only [LinearMap.comp_apply, aqScalarAction_tmul,
      potentialCoefficient_tmul]
    rw [pointwiseOperator_scalar]
  exact LinearMap.congr_fun hmap z

/-- The logarithmic radial coefficient is linear over locally constant
scalars. -/
theorem logRadialCoefficient_scalar {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (z : AqSection E F U) :
    logRadialCoefficient P U (aqScalarAction E F f z) =
      aqScalarAction E F f (logRadialCoefficient P U z) := by
  have hmap :
      (logRadialCoefficient P U).comp (aqScalarAction E F f) =
        (aqScalarAction E F f).comp (logRadialCoefficient P U) := by
    apply TensorProduct.ext'
    intro l m
    rfl
  exact LinearMap.congr_fun hmap z

/-- The complete local coefficient is scalar-linear. -/
theorem localCoefficient_scalar {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (z : AqSection E F U) :
    localCoefficient P U (aqScalarAction E F f z) =
      aqScalarAction E F f (localCoefficient P U z) := by
  rw [localCoefficient_apply, logRadialCoefficient_scalar,
    potentialCoefficient_scalar]
  exact ((aqScalarAction E F f).map_add _ _).symm

/-- Scalar-linearity of the constructed derivative in the locally constant
calculus. -/
theorem Dq_scalar {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (z : AqSection E F U) :
    Dq P U (aqScalarAction E F f z) =
      aqOmega1ScalarAction E F f (Dq P U z) := by
  rw [Dq_localTrivialization, Dq_localTrivialization]
  rw [localCoefficient_scalar]
  rfl

/-- Full connection Leibniz rule
`Dq(fz) = f·Dq(z) + z ⊗ dlog(f)`. -/
theorem Dq_leibniz {E F : ModuleCat ℂ}
    (P : FibreOperators E F) (U : TopologicalSpace.Opens X)
    (f : ScalarSection U) (z : AqSection E F U) :
    Dq P U (aqScalarAction E F f z) =
      aqOmega1ScalarAction E F f (Dq P U z) +
        leibnizCorrection E F f z := by
  rw [Dq_scalar, leibnizCorrection_eq_zero, add_zero]

/-! ### Integrated Definition 13 certificate -/

/-- PR-facing certificate for the complete constructed Definition 13 API. -/
structure Certificate (E F : ModuleCat ℂ) (P : FibreOperators E F) : Prop where
  omega1_fibre_module :
    ∀ U : TopologicalSpace.Opens X,
      Nonempty (Module ℂ ((omega1Presheaf (X := X)).obj U))
  omega1_restriction_linear :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V),
      Nonempty
        ((omega1Presheaf (X := X)).obj V →ₗ[ℂ]
          (omega1Presheaf (X := X)).obj U)
  omega1_isSheaf :
    IsSheafLike (omega1Presheaf (X := X)).toPresheafLike
  scalar_differential_leibniz :
    ∀ (U : TopologicalSpace.Opens X) (f g : ScalarSection U),
      logDifferential U (f * g) =
        f * logDifferential U g + g * logDifferential U f
  nabla_tensor_id_linear :
    ∀ U : TopologicalSpace.Opens X,
      Nonempty (AqSection E F U →ₗ[ℂ] AqOmega1Section E F U)
  id_tensor_dq_linear :
    ∀ U : TopologicalSpace.Opens X,
      Nonempty (AqSection E F U →ₗ[ℂ] AqOmega1Section E F U)
  nabla_tensor_id_restriction_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (z : AqSection E F V),
      (aqOmega1Presheaf E F).res hUV (nablaTensorId P V z) =
        nablaTensorId P U ((aqPresheaf E F).res hUV z)
  id_tensor_dq_restriction_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (z : AqSection E F V),
      (aqOmega1Presheaf E F).res hUV (idTensorDq P V z) =
        idTensorDq P U ((aqPresheaf E F).res hUV z)
  Dq_has_correct_codomain :
    ∀ U : TopologicalSpace.Opens X,
      Nonempty
        ((aqPresheaf E F).obj U →ₗ[ℂ] (aqOmega1Presheaf E F).obj U)
  Dq_is_sum :
    ∀ U : TopologicalSpace.Opens X,
      Dq P U = nablaTensorId P U + idTensorDq P U
  complex_additivity :
    ∀ (U : TopologicalSpace.Opens X) (x y : AqSection E F U),
      Dq P U (x + y) = Dq P U x + Dq P U y
  complex_homogeneity :
    ∀ (U : TopologicalSpace.Opens X) (c : ℂ) (z : AqSection E F U),
      Dq P U (c • z) = c • Dq P U z
  scalar_leibniz :
    ∀ (U : TopologicalSpace.Opens X) (f : ScalarSection U)
      (z : AqSection E F U),
      Dq P U (aqScalarAction E F f z) =
        aqOmega1ScalarAction E F f (Dq P U z) +
          leibnizCorrection E F f z
  restriction_natural :
    ∀ {U V : TopologicalSpace.Opens X} (hUV : U ≤ V)
      (z : AqSection E F V),
      (aqOmega1Presheaf E F).res hUV (Dq P V z) =
        Dq P U ((aqPresheaf E F).res hUV z)
  local_trivialization_formula :
    ∀ (U : TopologicalSpace.Opens X) (z : AqSection E F U),
      Dq P U z =
        tensorWithForm (dlogFrame U) (localCoefficient P U z)

/-- Every field of the Definition 13 certificate is proved from the two fibre
linear maps; restriction and the local formula are not additional inputs. -/
theorem certificate (E F : ModuleCat ℂ) (P : FibreOperators E F) :
    Certificate (X := X) E F P := by
  exact
    { omega1_fibre_module := fun _ => ⟨inferInstance⟩
      omega1_restriction_linear := fun hUV =>
        ⟨(omega1Presheaf (X := X)).restrictionLinear hUV⟩
      omega1_isSheaf := omega1Presheaf_isSheaf
      scalar_differential_leibniz := logDifferential_leibniz
      nabla_tensor_id_linear := fun U => ⟨nablaTensorId P U⟩
      id_tensor_dq_linear := fun U => ⟨idTensorDq P U⟩
      nabla_tensor_id_restriction_natural := nablaTensorId_restrict P
      id_tensor_dq_restriction_natural := idTensorDq_restrict P
      Dq_has_correct_codomain := fun U => ⟨Dq P U⟩
      Dq_is_sum := Dq_eq_nablaTensorId_add_idTensorDq P
      complex_additivity := Dq_map_add P
      complex_homogeneity := Dq_map_smul P
      scalar_leibniz := Dq_leibniz P
      restriction_natural := Dq_restrict P
      local_trivialization_formula := Dq_localTrivialization P }

/-! ### Specialization to the certified Definition 12 fibres -/

section Actual

