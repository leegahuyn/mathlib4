/-! ## Consistency obstruction to certifying every literal PDF claim

The terminal ledgers above distinguish repaired theorems from literal PDF
claims.  That distinction cannot consistently be erased: several literal
claims are mutually incompatible with elementary real/complex analysis or
with the concrete `Gamma(2)` action.  The audit below separates five directly
displayed claims from three additional well-definedness obligations extracted
from the paper's analytic setup. -/

namespace LiteralPDFConsistencyAudit

/-- Five claims copied from explicit displayed proof steps or from the literal
`Gamma(2)` orbit assertion in Proposition 13. -/
inductive LiteralClaim
  | nearZeroPowerWindow
  | kloostermanTailOne
  | kloostermanTailHalf
  | rademacherDamping
  | gamma2CuspOrbit
  deriving DecidableEq, Repr

instance : Fintype LiteralClaim where
  elems := {.nearZeroPowerWindow, .kloostermanTailOne, .kloostermanTailHalf, .rademacherDamping, .gamma2CuspOrbit}
  complete := by
    intro x
    cases x <;> simp

/-- Exact proposition represented by each directly contradicted literal claim. -/
def literalStatement : LiteralClaim -> Prop
  | .nearZeroPowerWindow =>
      ∀ alpha : Real, alpha < -(1 / 2 : Real) ->
        IntegrableOn
          (fun y : Real => y ^ (alpha - (1 / 2 : Real))) (Set.Ioo 0 1)
  | .kloostermanTailOne =>
      ∀ epsilon : Real, 0 < epsilon ->
        Summable (fun n : Nat =>
          1 / abs ((n : Real) + 1) ^ (1 - epsilon))
  | .kloostermanTailHalf =>
      ∀ epsilon : Real, 0 < epsilon ->
        Summable (fun n : Nat =>
          1 / abs ((n : Real) + 1) ^ ((1 / 2 : Real) - epsilon))
  | .rademacherDamping =>
      CorrectedLemmas.CorrectedPropositions.RademacherControl.CitedDampingInequality
  | .gamma2CuspOrbit =>
      CorrectedLemmas.CorrectedPropositions.CuspTransport.CitedCuspClaim

/-- Every directly represented literal claim has a kernel-checked refutation. -/
theorem literalRefutation (c : LiteralClaim) : Not (literalStatement c) := by
  cases c with
  | nearZeroPowerWindow =>
      intro h
      exact
        (CorrectedLemmas.CuspConvergence.nearZero_beta_one_not_integrable
          (Y := 1) (α := (-1 : Real)) (by norm_num) (by norm_num))
          (h (-1) (by norm_num))
  | kloostermanTailOne =>
      intro h
      exact
        (CorrectedLemmas.KloostermanTail.not_summable_paper_tail_one
          (ε := (1 / 4 : Real)) (by norm_num))
          (h (1 / 4) (by norm_num))
  | kloostermanTailHalf =>
      intro h
      exact
        (CorrectedLemmas.KloostermanTail.not_summable_paper_tail_half
          (ε := (1 / 4 : Real)) (by norm_num))
          (h (1 / 4) (by norm_num))
  | rademacherDamping =>
      exact
        CorrectedLemmas.CorrectedPropositions.RademacherControl.not_CitedDampingInequality
  | gamma2CuspOrbit =>
      exact CorrectedLemmas.CorrectedPropositions.CuspTransport.not_CitedCuspClaim

theorem literalClaim_count : Fintype.card LiteralClaim = 5 := by
  decide

/-- Simultaneous proof of the five directly represented literal claims. -/
def AllLiteralClaims : Prop :=
  ∀ c : LiteralClaim, literalStatement c

/-- The directly represented literal claims cannot all be certified in a
consistent Lean environment. -/
theorem no_certification_of_selected_invalid_literalClaims :
    Not AllLiteralClaims := by
  intro h
  exact literalRefutation .rademacherDamping (h .rademacherDamping)

/-- Three additional analytic obligations extracted from the paper's
Rankin--Selberg, resolvent, and coordinate interpretations.  They are kept
separate because they are not verbatim displayed propositions. -/
inductive ExtractedObligation
  | rankinSelbergUniversalPowerModel
  | resolventHalfPlanePoleFree
  | sameChartExterior
  deriving DecidableEq, Repr

instance : Fintype ExtractedObligation where
  elems := {.rankinSelbergUniversalPowerModel, .resolventHalfPlanePoleFree, .sameChartExterior}
  complete := by
    intro x
    cases x <;> simp

/-- The paper's global symbol `q = exp(2*pi*i*tau)`, kept distinct from the
width-two local cusp coordinate used elsewhere in this file. -/
noncomputable def paperQ (tau : UpperHalfPlane) : Complex :=
  Function.Periodic.qParam (1 : Nat) (tau : Complex)

theorem norm_paperQ_lt_one (tau : UpperHalfPlane) :
    norm (paperQ tau) < 1 := by
  simpa only [paperQ] using UpperHalfPlane.norm_qParam_lt_one 1 tau

def obligationStatement : ExtractedObligation -> Prop
  | .rankinSelbergUniversalPowerModel =>
      CorrectedLemmas.CuspConvergence.CitedLemma31RankinSelbergInference
  | .resolventHalfPlanePoleFree =>
      ∀ s : Complex, 1 < s.re -> ∀ t : Real,
        CorrectedLemmas.MassUnfolding.rankinSelbergResolventDenominator s t ≠ 0
  | .sameChartExterior =>
      ∃ tau : UpperHalfPlane,
        1 < norm (paperQ tau)

theorem obligationRefutation (c : ExtractedObligation) :
    Not (obligationStatement c) := by
  cases c with
  | rankinSelbergUniversalPowerModel =>
      exact CorrectedLemmas.CuspConvergence.not_CitedLemma31RankinSelbergInference
  | resolventHalfPlanePoleFree =>
      exact CorrectedLemmas.MassUnfolding.not_all_re_gt_one_resolvents_poleFree
  | sameChartExterior =>
      rintro ⟨tau, htau⟩
      exact (not_lt_of_ge (le_of_lt (norm_paperQ_lt_one tau))) htau

theorem extractedObligation_count : Fintype.card ExtractedObligation = 3 := by
  decide

def AllExtractedObligations : Prop :=
  ∀ c : ExtractedObligation, obligationStatement c

theorem no_simultaneous_extractedObligations :
    Not AllExtractedObligations := by
  intro h
  exact obligationRefutation .sameChartExterior (h .sameChartExterior)

end LiteralPDFConsistencyAudit

/-! ## Certification boundary by definition

This module deliberately has no exported theorem claiming certification of the
paper.  Its exact boundary is:

* Definition 1 now uses Mathlib's concrete `dx dy / y²` hyperbolic measure and
  proves its `Γ(2)` invariance.  Because the genuine square-root extension has
  no group-homomorphic section, the corrected global law is defined directly
  on `GenuineGamma2Metaplectic.Element` using a circle-valued character.  Its
  total factor is continuous, nonvanishing, and satisfies the exact cocycle;
  pointwise and a.e. sections are closed under the complex linear operations,
  and the weight-one-half Petersson density is invariant.  A nonzero section
  forces the multiplier value at the chosen central `-I` lift to be `-I`;
  every character with a different phase admits only the zero section.  The
  standard theta covariance pairs for the genuine width-two translation and
  central lift are constructed explicitly and shown to lie in an
  inversion- and multiplication-closed covariance subgroup; phase uniqueness
  follows at every nonzero theta value.  An explicit nonzero value is proved at
  height `log 4 / π` from Mathlib's quantitative theta-tail bound.  Hence full
  covariance is reduced to the covariance-subgroup projection.  An explicit
  principal-half-power lift over `S T² S⁻¹`, a twelve-transition
  Reidemeister--Schreier proof that `Gamma(2)` is generated by `T²`,
  `S T² S⁻¹`, and `-I`, and the two-sheet deck classification prove that this
  projection is bijective.  The resulting standard unary-theta multiplier
  character, its global automorphy law, and its central value `-I` are therefore
  constructed unconditionally.  The PDF's separate inverse-square-root
  convention is also given its exact cocycle and invariant density
  `y⁻¹ᐟ²|u|²`; a concrete zero-cusp value refutes its printed unweighted
  pointwise density.  The six-cell polygon now carries actual restricted
  hyperbolic `Lp ℂ 2` spaces, with proved `y^(±1/4)` normalizations and
  representative-independent `MemLp.toLp` realizations for both conventions.
  Automorphy together with polygon square-integrability is an actual complex
  submodule; its realization is linear and injective.  The closure of its
  linear range is a closed complete Hilbert subspace, with the algebraic range
  proved dense in that closure.  Injectivity uses a countable family of chosen
  genuine lifts, measure-preserving pullback, and closed-polygon orbit coverage;
  it does not assume a group-homomorphic metaplectic section.
  A generic joint partial operator has a literal complete graph closure, proved
  equal to the transported graph of its closed operator whenever it is
  closable.  A concrete smooth automorphic core for the theta character,
  open/closed-boundary equivalence or reverse extension/gluing theorem, and
  closed differential Maass operators are still not supplied by the PDF.
  Consequently literal Definition 1 is retained
  as an erratum, while each corrected carrier and graph theorem is audited
  separately.
* Definition 2 has a continuous core/trial inclusion with dense range, a
  continuous trial/ambient inclusion, and both directions of the precise
  complex Fréchet--Riesz convention, including uniqueness and norm preservation.
  For the completed joint graph, the ambient Hilbert space maps anti-linearly
  and injectively into the continuous dual by `f ↦ (u ↦ ⟪f,u₀⟫)`; the exact
  Cauchy--Schwarz graph-norm bound is proved.
* Definition 3 proves actual width two, the exact height formulas
  `y`, `y / |z|²`, and `y / |z - 1|²`, pairwise disjointness of the three
  strict height-one horoballs, nonzero unit-disk-valued cusp parameters,
  closedness and exhaustion of the truncations, and distinct boundary values
  for the three scaling matrices.  For the explicit six-cell `closedPolygon`,
  mod-two coset completeness proves orbit coverage, the six labelled open
  cells are pairwise disjoint, `Γ(2)`-related interior points are equal, and
  pullback from Mathlib's standard modular truncation proves compactness.
  Explicit inverse-modular images of the three standard boundary curves,
  together with the three cusp-height curves, now give a finite regular
  piecewise-smooth boundary certificate for every truncation height.
* Definitions 4, 6, and 7 define a positive abstract spectral integral and the
  existential mass condition.  No uniform lower bound is derived for the
  paper's unspecified mock coefficient/scattering package; Section 5.3 later
  constructs one for a separate explicit Lebesgue/unit-coefficient model.
* Definition 5 proves the corrected conjugate-dual multiplier cancellation for
  its Hermitian scalar contraction and makes `Re(s) > 1` and integrability fields
  of every domain point.  Its Eisenstein series and contracted mock kernel remain
  abstract.  The later exact formula-(3.2) certificate and the
  generic finite-unfolding bridge apply only to a separate mass family carrying
  the displayed spectral identity or proper finite-stage identities; neither
  concrete certificate is constructed from the PDF.
* Definition 8 is a topological cusp-chart conjugation.  Its transformed measure
  is constructed by pushforward and satisfies exact integral and quadratic-`L²`
  change-of-variables identities.  A concrete holomorphic injective chart and
  closed PDE domain remain model obligations.
* Definitions 9 and 11 expose a chosen kernel trivialization, derive inverse and
  compositional transport, and identify every fiber linearly with the space of
  all flat global sections.  They do not prove constant rank for the operator
  proposed in the paper.
* Definition 10 records the generic convergent-series and continuation interface.
  A separate fixed Laurent-polynomial model now chooses radius, three coefficient
  sequences, exponent shifts, the independent exterior variable, and a
  nonconstant prototype explicitly; its `HasSum`, derivative, annular-domain,
  inverse-variable, continuation, and dictionary identities are proved before
  they are packaged into the interface.  The row nevertheless remains removed
  as a literal PDF definition because this verification model is not the unnamed
  mock/Eichler coefficient, shadow, and multiplier package asserted by the paper.
* Definitions 12--15 prove tensor-restriction functoriality, expose sheafification
  and equalizer universal properties, construct balanced restriction with identity
  and composition, relate the real radial base to `log q`, and derive covariant
  gluing uniquely from ordinary sheaf gluing rather than storing it as an
  assumption.  No concrete automorphic bundle is constructed from the paper's
  incomplete data.
* Definitions 16 and 17 type curvature relative to a possibly nonflat background,
  prove its elementary affine expansions, and prove preservation/reflection of
  flatness under compatible maps.  For Definition 18, nonnegative exact action
  components and a definite curvature energy force every zero-comparison minimizer
  to have zero curvature energy, mass, and remainder and hence to be flat.  The
  paper-specific exact action decomposition and minimizer existence remain input.
* The seven declarations retained from the supplied file keep their short names
  under the explicit `Elementary` and `ConditionalSkeleton` provenance namespaces.
  The first four are algebraic leaves; the final three are conditional on the
  decisive analytic identity or inequality passed to them.
* Corrected Lemma 1.1 proves dual restriction along an injective continuous
  compact-test inclusion with compatible pointwise realization.  Restriction
  is explicitly functorial and unital.  Its separate
  regular-density corollary is indexed by the actual Laplace, potential, and
  right-hand duals, derives the global integral equation from the weak equality,
  and uses explicit locality to restrict to the compact topological support.
  For densities of the paper's exact forms `A · conj(test)` and
  `B · conj(test)`, locality is derived automatically from the product form.
  It does not infer a density for a Sobolev Laplacian.
* Corrected Lemmas 1.2/2.1 prove a form-domain spectral-gap consequence on an
  explicit admissible subspace.  A genuine-group target package now identifies
  its form domain with the metaplectically correct Sobolev completion and
  obtains the squared Poincare estimate both on the chosen subspace and from
  explicit zero/residual orthogonality.  It removes the supremum
  of separately named zero/residual modes.  This chosen-subspace correction is
  stronger than, and not identified with, the PDF's literal retained-residual
  decomposition.  It also requires a normalized admissible mode, puts the
  smooth automorphic core in the operator domain, identifies the core quadratic
  form with the named raising/lowering Sobolev energies, and uses an exact
  raising/lowering energy identity.  Thus the target cannot be discharged by
  the zero subspace.  A corollary rewrites the final bound in the actual
  `sobolev.raisingEnergy` and `sobolev.loweringEnergy` names, although no
  concrete differential-Laplacian inhabitant of the self-adjoint/spectral
  package is constructed from the PDF.  The admissible subspace is proved
  equivalent to simultaneous orthogonality to the named zero and residual
  subspaces, so Lemmas 1.2 and 2.1 use the identical reduction and constant.
* Corrected Lemmas 1.3/2.2 prove ordered Abel convergence and a bound from a
  summable remainder certificate; the two PDF tail exponents are separately
  proved nonsummable.  The transform-linked form keeps the positive modulus,
  the full triple-gcd Weil majorant, and a pair-gcd factor in the final Abel-tail
  bound.  It now separately types (i) the local all-unit Mock-I sum with an
  intrinsic residue-class additive character and (ii) the genuine full-
