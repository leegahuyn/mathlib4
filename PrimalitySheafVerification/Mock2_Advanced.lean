/-! Each terminal removal is backed by a proposition in the kernel, rather
than only by a status label.  The proposition deliberately selects one decisive
failure from each conjunction-sized PDF block. -/

def KernelErratum : Claim → Prop
  | .item1_pp3_4 =>
      ¬ ∃ s : Gamma2Element →*
          CorrectedLemmas.GenuineGamma2Metaplectic.Element,
        Function.LeftInverse
          CorrectedLemmas.GenuineGamma2Metaplectic.toGamma2 s
  | .equations1_1_to_1_16 =>
      ∃ laplace raisingEnergy loweringEnergy
        raisingBoundary loweringBoundary : ℝ,
        laplace = -raisingEnergy + raisingBoundary ∧
        laplace = -loweringEnergy + loweringBoundary ∧
        laplace ≠ -(raisingEnergy + loweringEnergy) +
          (raisingBoundary + loweringBoundary)
  | .quotedQ2A_to_Q2F =>
      ¬ IntegrableOn (fun y : ℝ => y ^ (-1 : ℝ)) (Set.Ioo 0 1)
  | .equations1_17_to_1_24 =>
      ¬ ∃ C : ℝ, CorrectedLemmas.GlobalPoincare.PoincareEstimate
        (fun _ : ℂ => (0 : ℂ)) (fun _ : ℂ => (0 : ℂ)) C
  | .equations1_26_to_1_30 =>
      ¬ Summable
        (CorrectedLemmas.HalfOrderBessel.criticalModulusEnvelope 1)
  | .equations1_31_to_1_33 =>
      ¬ HMass
        (CorrectedLemmas.CorrectedPropositions.PositiveMassCriterion.zeroCoefficientFourierPositiveData
          1 (by norm_num)) 1
  | .equations2_1_to_2_4 =>
      ¬ Summable
        (CorrectedLemmas.HalfOrderBessel.criticalModulusEnvelope 1)
  | .pages23_to_25 =>
      CorrectedLemmas.MassUnfolding.rankinSelbergResolventDenominator
          (2 : ℂ) (Real.sqrt (2 * (2 - 1))) = 0
  | .equations3_1_to_3_6 =>
      (CorrectedLemmas.KuznetsovInterface.profileBesselConvention.scaleNormalization
          (2 : ℂ) (by norm_num)).transform (fun _ : ℝ => 1) 1 ≠
        CorrectedLemmas.KuznetsovInterface.profileBesselConvention.transform
          (fun _ : ℝ => 1) 1
  | .equations3_7_to_3_19 =>
      let a : ℕ → ℝ := fun n => if n = 0 then 1 else 0
      (∃ n, 0 < a n) ∧ ¬ Set.Infinite {n | 0 < a n}
  | .equations3_20_to_3_26 =>
      (0 : ℝ) = 0 ∧ 0 < (1 : ℝ) ∧ (0 : ℝ) ≠ 1
  | .equations4_1_to_4_9 =>
      ∃ f g : ℂ → ℂ,
        CorrectedLemmas.MockPrototypeUnderspecification.HolomorphicPrototypeAtRadius
            1 f ∧
        CorrectedLemmas.MockPrototypeUnderspecification.HolomorphicPrototypeAtRadius
            1 g ∧ f ≠ g
  | .equations4_10_to_4_27 =>
      ¬ CorrectedLemmas.CorrectedPropositions.RademacherControl.CitedDampingInequality
  | .equations4_28_to_4_29 =>
      ¬ ∃ τ : UpperHalfPlane,
        1 < ‖cuspQCoordinate Gamma2Cusp.infinity τ‖
  | .equations4_30_to_4_32 =>
      ∃ R₀ R₁ : ℂ × ℂ,
        R₀ ≠ R₁ ∧
        CorrectedLemmas.MockPrototypeUnderspecification.modelShadowDerivative R₀ = 0 ∧
        CorrectedLemmas.MockPrototypeUnderspecification.modelShadowDerivative R₁ = 0
  | .equation5_1 =>
      ¬ ∃ τ : UpperHalfPlane,
        1 < ‖cuspQCoordinate Gamma2Cusp.infinity τ‖
  | .equations6_1_to_6_18 =>
      ¬ ∃ s : Gamma2Element →*
          CorrectedLemmas.GenuineGamma2Metaplectic.Element,
        Function.LeftInverse
          CorrectedLemmas.GenuineGamma2Metaplectic.toGamma2 s

/-- Exhaustive proof-producing audit for all seventeen literal formula blocks. -/
theorem kernelErratum (c : Claim) : KernelErratum c := by
  cases c with
  | item1_pp3_4 =>
      exact CorrectedLemmas.ThetaGeneratorLift.no_groupHom_section_of_genuine_projection
  | equations1_1_to_1_16 =>
      exact CorrectedLemmas.GreenIdentityRepair.average_factorization_without_half_counterexample
  | quotedQ2A_to_Q2F =>
      exact CorrectedLemmas.CuspConvergence.inversePower_not_integrable_nearZero
        (by norm_num)
  | equations1_17_to_1_24 =>
      exact CorrectedLemmas.GlobalPoincare.unqualifiedPoincareSchema_false
  | equations1_26_to_1_30 =>
      exact CorrectedLemmas.HalfOrderBessel.not_summable_criticalModulusEnvelope
        (by norm_num)
  | equations1_31_to_1_33 =>
      exact
        CorrectedLemmas.CorrectedPropositions.PositiveMassCriterion.not_hMass_zeroCoefficientFourierPositiveData
          1 (by norm_num) 1
  | equations2_1_to_2_4 =>
      exact CorrectedLemmas.HalfOrderBessel.not_summable_criticalModulusEnvelope
        (by norm_num)
  | pages23_to_25 =>
      exact
        CorrectedLemmas.MassUnfolding.rankinSelbergResolventDenominator_eq_zero_at_real_pole
          2 (by norm_num)
  | equations3_1_to_3_6 =>
      exact CorrectedLemmas.KuznetsovInterface.normalization_choice_changes_transform
  | equations3_7_to_3_19 =>
      exact CorrectedLemmas.CorrectedPropositions.LowerGrowth.positiveActivity_not_infinite
  | equations3_20_to_3_26 =>
      exact ⟨rfl, by norm_num,
        CorrectedLemmas.MockConnectionErratum.parallelEnergy_ne_positiveShadow
          rfl (by norm_num)⟩
  | equations4_1_to_4_9 =>
      exact
        CorrectedLemmas.MockPrototypeUnderspecification.positiveRadius_does_not_determinePrototype
          1 (by norm_num)
  | equations4_10_to_4_27 =>
      exact CorrectedLemmas.CorrectedPropositions.RademacherControl.not_CitedDampingInequality
  | equations4_28_to_4_29 =>
      exact
        CorrectedLemmas.CorrectedPropositions.GlobalUnitCircleMatching.no_upperHalfPlane_exterior_q_region
          Gamma2Cusp.infinity
  | equations4_30_to_4_32 =>
      exact
        CorrectedLemmas.MockPrototypeUnderspecification.modelShadowEquation_has_distinctCorrections
          0
  | equation5_1 =>
      exact
        CorrectedLemmas.CorrectedPropositions.GlobalUnitCircleMatching.no_upperHalfPlane_exterior_q_region
          Gamma2Cusp.infinity
  | equations6_1_to_6_18 =>
      exact CorrectedLemmas.ThetaGeneratorLift.no_groupHom_section_of_genuine_projection

/-- Semantic evidence for every one of the seventeen formula-block rows.

The first conjunct records that the literal bundled block is honestly retained
as an erratum.  The second conjunct is the block-specific kernel proposition
from `KernelErratum`: depending on the row it is a concrete counterexample, a
proved divergence/nonexistence statement, or an exact normalization
obstruction.  In particular, no row is discharged by `True` or by the terminal
status label alone. -/
def ClaimEvidence (c : Claim) : Prop :=
  claimDisposition c = .removedWithErratum ∧ KernelErratum c

/-- Proof-producing semantic audit of all seventeen unnumbered formula blocks. -/
theorem claimEvidence (c : Claim) : ClaimEvidence c := by
  constructor
  · cases c <;> rfl
  · exact kernelErratum c

