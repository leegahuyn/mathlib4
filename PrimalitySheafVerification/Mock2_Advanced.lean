/-!
# Corrected foundations for the advanced Mock2 layer

This file integrates the previously supplied elementary Lean declarations with a
typed abstract-interface map for proposed corrections to Definitions 1--18 of
*Global Poincare Matching and
Kloosterman-Compatible Test Kernels for Half-Integral Weight Mock--Theta Gauge
Objects*.

The source paper does not determine concrete inhabitants of several analytic data
structures below.  This file independently constructs the genuine metaplectic
cover and the standard unary-theta multiplier from two explicit parabolic lifts,
the central lift, a `Gamma(2)` generation theorem, and a two-sheet fiber
classification.  The paper still does not prove the required Rankin--Selberg
integrability, produce its claimed positive continuous spectral measure with a
uniform lower bound, construct the closed automorphic Laplacian instance, or build
the bundle-valued gauge calculus.  Consequently the remaining inputs are honest
typed data, and unrepaired statements are not labelled as certified theorems.

The main repairs are:

* `Gamma2` is the principal congruence subgroup already defined by Mathlib;
* half-weight transformation is expressed by a branch-resolved cocycle;
* automorphy descends to representative-independent `AEEqFun` classes;
* graph completion uses literal `L²` product coordinates, and closability is
  isolated as the exact condition excluding nonzero vertical vectors;
* spectral mass uses positive `Measure` values and explicit integrability;
* every `q`-operator is local to a cusp chart with an actual inverse;
* the outside series has its own small variable rather than a fictitious second
  region of the upper half-plane;
* tensor sections are genuine tensor products, not pairs;
* balanced fields are a linear equalizer;
* gauge fields and curvature use compatible one-form and two-form types; and
* an effective mass is named only inside an exact action decomposition.
-/

set_option autoImplicit false

open scoped BigOperators Convolution FourierTransform Interval LinearPMap Pointwise
  RealInnerProductSpace
open Filter InnerProductSpace MeasureTheory Set Topology

namespace Mock2Adv

universe uSheafX uSheafE uSheafF uSheafG

noncomputable section

/-! ## 0. Concrete modular base and branch-resolved automorphy -/

/-- The principal level-two congruence subgroup of `SL(2, Z)`. -/
abbrev Gamma2 : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ) :=
  CongruenceSubgroup.Gamma 2

/-- Elements of the concrete group `Gamma(2)`. -/
abbrev Gamma2Element : Type := ↥Gamma2

/-- The restriction of the standard modular action to `Gamma(2)`. -/
noncomputable def gamma2Act
    (γ : Gamma2Element) (τ : UpperHalfPlane) : UpperHalfPlane :=
  (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) • τ

/-- The canonical hyperbolic measure `dx dy / y²` on the upper half-plane.

This is Mathlib's invariant volume instance, not an abstract measure parameter. -/
abbrev hyperbolicMeasure : Measure UpperHalfPlane :=
  (volume : Measure UpperHalfPlane)

/-- The concrete density formula for the hyperbolic measure. -/
theorem hyperbolicMeasure_def :
    hyperbolicMeasure =
      (volume.comap UpperHalfPlane.coe).withDensity fun z =>
        ENNReal.ofNNReal ((1 / NNReal.mk z.im z.im_pos.le) ^ 2) := by
  simpa only [hyperbolicMeasure] using UpperHalfPlane.volume_def

/-- Every element of `Γ(2)` preserves the concrete hyperbolic measure. -/
theorem gamma2Act_measurePreserving (γ : Gamma2Element) :
    MeasurePreserving (gamma2Act γ) hyperbolicMeasure hyperbolicMeasure := by
  change MeasurePreserving
    (fun τ : UpperHalfPlane =>
      ((Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ)
        (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ)) • τ)
    (volume : Measure UpperHalfPlane) (volume : Measure UpperHalfPlane)
  exact measurePreserving_smul
    ((Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ)
      (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ))
    (volume : Measure UpperHalfPlane)

@[simp]
theorem gamma2_smul_eq_gamma2Act
    (γ : Gamma2Element) (τ : UpperHalfPlane) :
    γ • τ = gamma2Act γ τ :=
  rfl

@[simp]
theorem gamma2Act_one (τ : UpperHalfPlane) : gamma2Act 1 τ = τ := by
  simp [gamma2Act]

@[simp]
theorem gamma2Act_mul (γ δ : Gamma2Element) (τ : UpperHalfPlane) :
    gamma2Act (γ * δ) τ = gamma2Act γ (gamma2Act δ τ) := by
  simp [gamma2Act, mul_smul]

/-- The width-two translation is an actual element of the principal
congruence subgroup `Γ(2)`. -/
theorem gamma2_T_two_mem :
    ModularGroup.T ^ (2 : ℤ) ∈ Gamma2 := by
  simpa [Gamma2] using
    CongruenceSubgroup.ModularGroup_T_pow_mem_Gamma
      (2 : ℤ) (2 : ℤ) (dvd_refl (2 : ℤ))

/-- The concrete parabolic translation in `Γ(2)`. -/
def gamma2TranslationTwo : Gamma2Element :=
  ⟨ModularGroup.T ^ (2 : ℤ), gamma2_T_two_mem⟩

@[simp]
theorem gamma2TranslationTwo_act (τ : UpperHalfPlane) :
    gamma2Act gamma2TranslationTwo τ = (2 : ℝ) +ᵥ τ := by
  simpa [gamma2Act, gamma2TranslationTwo] using
    UpperHalfPlane.modular_T_zpow_smul τ (2 : ℤ)

/-! ### Concrete standard unary theta input

This block uses Mathlib's actual one-variable Jacobi theta function.  It is a
genuine theorem layer for the standard theta input; it is deliberately kept
separate from the paper-specific level character and mock completion, whose
identification requires additional arithmetic data. -/

namespace ConcreteUnaryTheta

/-- The standard unary Jacobi theta function restricted to the upper half-plane. -/
noncomputable def theta (τ : UpperHalfPlane) : ℂ :=
  jacobiTheta (τ : ℂ)

/-- Exact invariance under the width-two translation `T²`. -/
theorem theta_T_sq (τ : UpperHalfPlane) :
    theta (ModularGroup.T ^ 2 • τ) = theta τ := by
  simpa [theta] using jacobiTheta_T_sq_smul τ

/-- The same `T²` law expressed through the concrete element of `Γ(2)`. -/
theorem theta_gamma2TranslationTwo (τ : UpperHalfPlane) :
    theta (gamma2Act gamma2TranslationTwo τ) = theta τ := by
  simpa [theta, gamma2Act, gamma2TranslationTwo] using
    jacobiTheta_T_sq_smul τ

/-- Exact `S`-transformation, including the principal complex square-root
factor used by Mathlib's Jacobi-theta normalization. -/
theorem theta_S (τ : UpperHalfPlane) :
    theta (ModularGroup.S • τ) =
      (-Complex.I * (τ : ℂ)) ^ (1 / 2 : ℂ) * theta τ := by
  simpa [theta] using jacobiTheta_S_smul τ

/-- The convergent natural-number expansion of the standard theta series. -/
theorem theta_eq_tsum_nat (τ : UpperHalfPlane) :
    theta τ = 1 + 2 * ∑' n : ℕ,
      Complex.exp
        (Real.pi * Complex.I * ((n : ℂ) + 1) ^ 2 * (τ : ℂ)) := by
  simpa [theta] using jacobiTheta_eq_tsum_nat τ.im_pos

/-- Absolute convergence is available independently of the `tsum` identity. -/
theorem theta_tail_summable (τ : UpperHalfPlane) :
    Summable (fun n : ℕ =>
      Complex.exp
        (Real.pi * Complex.I * ((n : ℂ) + 1) ^ 2 * (τ : ℂ))) :=
  (hasSum_nat_jacobiTheta τ.im_pos).summable

/-! #### A sharp Gaussian majorant

The geometric-series estimate supplied by `OneVariable` is optimal at the
infinite cusp but loses one power as `im τ → 0`.  For the finite-cusp cells we
instead compare the positive Gaussian tail with its half-line integral.  This
gives the sharp `O(y⁻¹ᐟ²)` bound needed by the weighted `L²` calculation. -/

/-- The `n`-th positive-frequency term in the natural-number theta expansion. -/
noncomputable def thetaTailTerm (τ : UpperHalfPlane) (n : ℕ) : ℂ :=
  Complex.exp
    (Real.pi * Complex.I * ((n : ℂ) + 1) ^ 2 * (τ : ℂ))

/-- The real Gaussian used to dominate the absolute theta series. -/
noncomputable def gaussianMajorant (y x : ℝ) : ℝ :=
  Real.exp (-(Real.pi * y) * x ^ 2)

/-- Exact norm of a positive-frequency theta term. -/
@[simp]
theorem norm_thetaTailTerm (τ : UpperHalfPlane) (n : ℕ) :
    ‖thetaTailTerm τ n‖ =
      gaussianMajorant τ.im ((n : ℝ) + 1) := by
  rw [thetaTailTerm, Complex.norm_exp, gaussianMajorant]
  congr 1
  rw [(by push_cast; ring :
    (Real.pi * Complex.I * ((n : ℂ) + 1) ^ 2 * (τ : ℂ)) =
      (Real.pi * ((n : ℝ) + 1) ^ 2 : ℝ) *
        ((τ : ℂ) * Complex.I)),
    Complex.re_ofReal_mul, Complex.mul_I_re]
  simp only [UpperHalfPlane.coe_im]
  ring

/-- The positive Gaussian tail is summable for every positive height. -/
theorem gaussianMajorant_nat_summable (τ : UpperHalfPlane) :
    Summable (fun n : ℕ =>
      gaussianMajorant τ.im ((n : ℝ) + 1)) := by
  have h := (theta_tail_summable τ).norm
  change Summable (fun n : ℕ => ‖thetaTailTerm τ n‖) at h
  simpa only [norm_thetaTailTerm] using h

/-- For positive height the Gaussian is antitone on the nonnegative axis. -/
theorem gaussianMajorant_antitoneOn_Ici (y : ℝ) (hy : 0 < y) :
    AntitoneOn (gaussianMajorant y) (Set.Ici 0) := by
  intro x hx z hz hxz
  change
    Real.exp (-(Real.pi * y) * z ^ 2) ≤
      Real.exp (-(Real.pi * y) * x ^ 2)
  apply Real.exp_le_exp.mpr
  have hsum : 0 ≤ x + z := add_nonneg hx hz
  have hdiff : 0 ≤ z - x := sub_nonneg.mpr hxz
  have hsq : x ^ 2 ≤ z ^ 2 := by
    nlinarith [mul_nonneg hdiff hsum]
  have hcoeff : 0 < Real.pi * y := mul_pos Real.pi_pos hy
  nlinarith [mul_nonneg hcoeff.le (sub_nonneg.mpr hsq)]

/-- Every finite positive Gaussian sum is bounded by the adjacent integral. -/
theorem sum_gaussianMajorant_le_intervalIntegral
    (y : ℝ) (hy : 0 < y) (N : ℕ) :
    (∑ n ∈ Finset.range N,
        gaussianMajorant y ((n : ℝ) + 1)) ≤
      ∫ x in (0 : ℝ)..(N : ℝ), gaussianMajorant y x := by
  have hanti : AntitoneOn (gaussianMajorant y)
      (Set.Icc (0 : ℝ) (0 + (N : ℝ))) :=
    (gaussianMajorant_antitoneOn_Ici y hy).mono <| by
      intro x hx
      exact hx.1
  simpa only [zero_add, Nat.cast_add, Nat.cast_one] using
    hanti.sum_le_integral

/-- A finite Gaussian interval is bounded by the full positive half-line. -/
theorem intervalIntegral_gaussianMajorant_le_Ioi
    (y : ℝ) (hy : 0 < y) (N : ℕ) :
    (∫ x in (0 : ℝ)..(N : ℝ), gaussianMajorant y x) ≤
      ∫ x in Set.Ioi (0 : ℝ), gaussianMajorant y x := by
  have hInt : IntegrableOn (gaussianMajorant y) (Set.Ioi (0 : ℝ)) := by
    change IntegrableOn (fun x : ℝ => Real.exp (-(Real.pi * y) * x ^ 2)) (Set.Ioi 0)
    exact integrableOn_Ioi_exp_neg_mul_sq_iff.mpr (mul_pos Real.pi_pos hy)
  rw [intervalIntegral.integral_of_le (Nat.cast_nonneg N)]
  exact setIntegral_mono_set hInt
    (Eventually.of_forall fun x => (Real.exp_pos _).le)
    (Eventually.of_forall fun _ hx => hx.1)

/-- Sharp half-line estimate for the positive-frequency Gaussian tail. -/
theorem tsum_gaussianMajorant_le_inv_sqrt (τ : UpperHalfPlane) :
    (∑' n : ℕ, gaussianMajorant τ.im ((n : ℝ) + 1)) ≤
      (Real.sqrt τ.im)⁻¹ / 2 := by
  have hs := gaussianMajorant_nat_summable τ
  apply le_of_tendsto' hs.hasSum.tendsto_sum_nat
  intro N
  calc
    (∑ n ∈ Finset.range N,
        gaussianMajorant τ.im ((n : ℝ) + 1))
        ≤ ∫ x in (0 : ℝ)..(N : ℝ), gaussianMajorant τ.im x :=
          sum_gaussianMajorant_le_intervalIntegral τ.im τ.im_pos N
    _ ≤ ∫ x in Set.Ioi (0 : ℝ), gaussianMajorant τ.im x :=
      intervalIntegral_gaussianMajorant_le_Ioi τ.im τ.im_pos N
    _ = Real.sqrt (Real.pi / (Real.pi * τ.im)) / 2 := by
      change (∫ x in Set.Ioi (0 : ℝ), Real.exp (-(Real.pi * τ.im) * x ^ 2)) = _
      rw [integral_gaussian_Ioi]
    _ = (Real.sqrt τ.im)⁻¹ / 2 := by
      have hratio : Real.pi / (Real.pi * τ.im) = τ.im⁻¹ := by
        calc
          Real.pi / (Real.pi * τ.im) = 1 / τ.im := by
            field_simp [Real.pi_pos.ne', τ.im_pos.ne']
          _ = τ.im⁻¹ := one_div τ.im
      rw [hratio, Real.sqrt_inv]

/-- Norm of the complex theta tail is bounded by the real Gaussian tail. -/
theorem norm_tsum_thetaTailTerm_le_gaussianMajorant
    (τ : UpperHalfPlane) :
    ‖∑' n : ℕ, thetaTailTerm τ n‖ ≤
      ∑' n : ℕ, gaussianMajorant τ.im ((n : ℝ) + 1) := by
  have hs := (theta_tail_summable τ).norm
  change Summable (fun n : ℕ => ‖thetaTailTerm τ n‖) at hs
  calc
    ‖∑' n : ℕ, thetaTailTerm τ n‖
        ≤ ∑' n : ℕ, ‖thetaTailTerm τ n‖ :=
      norm_tsum_le_tsum_norm hs
    _ = ∑' n : ℕ, gaussianMajorant τ.im ((n : ℝ) + 1) := by
      apply tsum_congr
      exact norm_thetaTailTerm τ

/-- Global sharp bound for the concrete unary theta function. -/
theorem norm_theta_le_one_add_inv_sqrt_im (τ : UpperHalfPlane) :
    ‖theta τ‖ ≤ 1 + (Real.sqrt τ.im)⁻¹ := by
  rw [theta_eq_tsum_nat]
  change
    ‖(1 : ℂ) + 2 * ∑' n : ℕ, thetaTailTerm τ n‖ ≤
      1 + (Real.sqrt τ.im)⁻¹
  calc
    ‖(1 : ℂ) + 2 * ∑' n : ℕ, thetaTailTerm τ n‖
        ≤ 1 + 2 * ‖∑' n : ℕ, thetaTailTerm τ n‖ := by
      simpa only [norm_one, norm_mul, Complex.norm_two] using
        (norm_add_le (1 : ℂ) (2 * ∑' n : ℕ, thetaTailTerm τ n))
    _ ≤ 1 + 2 *
        (∑' n : ℕ, gaussianMajorant τ.im ((n : ℝ) + 1)) := by
      gcongr
      exact norm_tsum_thetaTailTerm_le_gaussianMajorant τ
    _ ≤ 1 + 2 * ((Real.sqrt τ.im)⁻¹ / 2) := by
      gcongr
      exact tsum_gaussianMajorant_le_inv_sqrt τ
    _ = 1 + (Real.sqrt τ.im)⁻¹ := by ring

/-- The nonconstant part of the standard theta function has exponential decay
at the cusp infinity. -/
theorem theta_sub_one_exponentialDecay :
    (fun τ : ℂ => jacobiTheta τ - 1) =O[
      Filter.comap Complex.im Filter.atTop]
        (fun τ : ℂ => Real.exp (-Real.pi * τ.im)) :=
  isBigO_at_im_infty_jacobiTheta_sub_one

/-- The literal numerical window used in Item 1 has the concrete witness
`(α, β) = (-1, 1)`.  This theorem asserts only the window; it does not claim
that the same pair survives insertion of an Eisenstein growth factor. -/
def ParameterWindow (α β : ℝ) : Prop :=
  β = 1 ∧ α < -(1 / 2 : ℝ)

theorem parameterWindow_negOne_one :
    ParameterWindow (-1) 1 := by
  norm_num [ParameterWindow]

end ConcreteUnaryTheta

namespace ConcreteMellinGamma

/-- Positivity of the scale occurring in the paper's Mellin--Gamma integral. -/
theorem four_pi_mul_pos {m : ℝ} (hm : 0 < m) :
    0 < 4 * Real.pi * m :=
  mul_pos (mul_pos (by norm_num) Real.pi_pos) hm

/-- Direct specialization of Mathlib's Euler--Gamma integral before rewriting
the exponent. -/
theorem integral_raw {β m : ℝ} (hβ : 1 < β) (hm : 0 < m) :
    ∫ y : ℝ in Set.Ioi 0,
        y ^ ((β - 1) - 1) * Real.exp (-((4 * Real.pi * m) * y)) =
      (1 / (4 * Real.pi * m)) ^ (β - 1) * Real.Gamma (β - 1) :=
  Real.integral_rpow_mul_exp_neg_mul_Ioi
    (a := β - 1) (r := 4 * Real.pi * m)
    (sub_pos.mpr hβ) (four_pi_mul_pos hm)

/-- The exponent appearing after unfolding is exactly `β - 2`. -/
theorem beta_sub_one_sub_one (β : ℝ) :
    (β - 1) - 1 = β - 2 := by
  ring

/-- The exact Mellin--Gamma identity quoted in Q2.E, with every convergence
condition made explicit. -/
theorem integral_beta_sub_two {β m : ℝ} (hβ : 1 < β) (hm : 0 < m) :
    ∫ y : ℝ in Set.Ioi 0,
        y ^ (β - 2) * Real.exp (-((4 * Real.pi * m) * y)) =
      (1 / (4 * Real.pi * m)) ^ (β - 1) * Real.Gamma (β - 1) := by
  simpa only [beta_sub_one_sub_one] using integral_raw hβ hm

end ConcreteMellinGamma

/-! ### A branch-explicit metaplectic ambient group over `Γ(2)` -/

/-- A metaplectic element is an actual matrix together with its chosen
unit-valued branch function.  Multiplication below builds the cocycle law into
the group operation instead of postulating it for an unrelated scalar
character. -/
structure Gamma2Metaplectic where
  matrix : Gamma2Element
  factor : UpperHalfPlane → ℂˣ

namespace Gamma2Metaplectic

@[ext]
theorem ext {a b : Gamma2Metaplectic}
    (hmatrix : a.matrix = b.matrix)
    (hfactor : a.factor = b.factor) : a = b := by
  cases a
  cases b
  cases hmatrix
  cases hfactor
  rfl

def one : Gamma2Metaplectic where
  matrix := 1
  factor := fun _ => 1

def mul (a b : Gamma2Metaplectic) : Gamma2Metaplectic where
  matrix := a.matrix * b.matrix
  factor := fun τ => a.factor (gamma2Act b.matrix τ) * b.factor τ

def inv (a : Gamma2Metaplectic) : Gamma2Metaplectic where
  matrix := a.matrix⁻¹
  factor := fun τ => (a.factor (gamma2Act a.matrix⁻¹ τ))⁻¹

instance : One Gamma2Metaplectic := ⟨one⟩
instance : Mul Gamma2Metaplectic := ⟨mul⟩
instance : Inv Gamma2Metaplectic := ⟨inv⟩

@[simp]
theorem matrix_one : (1 : Gamma2Metaplectic).matrix = 1 := rfl

@[simp]
theorem matrix_mul (a b : Gamma2Metaplectic) :
    (a * b).matrix = a.matrix * b.matrix := rfl

@[simp]
theorem matrix_inv (a : Gamma2Metaplectic) :
    a⁻¹.matrix = a.matrix⁻¹ := rfl

@[simp]
theorem factor_one (τ : UpperHalfPlane) :
    (1 : Gamma2Metaplectic).factor τ = 1 := rfl

@[simp]
theorem factor_mul (a b : Gamma2Metaplectic) (τ : UpperHalfPlane) :
    (a * b).factor τ =
      a.factor (gamma2Act b.matrix τ) * b.factor τ := rfl

@[simp]
theorem factor_inv (a : Gamma2Metaplectic) (τ : UpperHalfPlane) :
    a⁻¹.factor τ =
      (a.factor (gamma2Act a.matrix⁻¹ τ))⁻¹ := rfl

instance : Group Gamma2Metaplectic :=
  Group.ofLeftAxioms
    (by
      intro a b c
      apply Gamma2Metaplectic.ext
      · simp only [matrix_mul, mul_assoc]
      · funext τ
        simp only [factor_mul, matrix_mul, gamma2Act_mul, mul_assoc])
    (by
      intro a
      apply Gamma2Metaplectic.ext
      · simp only [matrix_mul, matrix_one, one_mul]
      · funext τ
        simp only [factor_mul, factor_one, one_mul])
    (by
      intro a
      apply Gamma2Metaplectic.ext
      · simp [matrix_mul, matrix_inv]
      · funext τ
        have hact :
            gamma2Act a.matrix⁻¹ (gamma2Act a.matrix τ) = τ := by
          rw [← gamma2Act_mul]
          simp
        simp [factor_mul, factor_inv, hact])

/-- Forgetting the branch function is a genuine group homomorphism. -/
def toGamma2 : Gamma2Metaplectic →* Gamma2Element where
  toFun := matrix
  map_one' := matrix_one
  map_mul' := matrix_mul

end Gamma2Metaplectic

/-- A branch-resolved automorphy factor on the concrete group `Gamma(2)`.

The square-root branch and multiplier are deliberately represented by one unit-valued
factor satisfying the cocycle law.  Writing `(c * τ + d) ^ (-1 / 2)` without this
data would not define a global half-weight action. -/
structure HalfWeightAutomorphyFactor where
  factor : Gamma2Element → UpperHalfPlane → ℂˣ
  factor_one : ∀ τ, factor 1 τ = 1
  factor_mul : ∀ γ δ τ,
    factor (γ * δ) τ = factor γ (gamma2Act δ τ) * factor δ τ

/-- A fixed metaplectic lift is a group-homomorphic section of the concrete
matrix projection. -/
structure FixedGamma2MetaplecticLift where
  lift : Gamma2Element →* Gamma2Metaplectic
  matrix_lift : ∀ γ, (lift γ).matrix = γ

namespace FixedGamma2MetaplecticLift

/-- Extract the branch-resolved automorphy factor from a genuine fixed lift. -/
noncomputable def automorphyFactor
    (L : FixedGamma2MetaplecticLift) : HalfWeightAutomorphyFactor where
  factor := fun γ τ => (L.lift γ).factor τ
  factor_one := by
    intro τ
    rw [map_one]
    exact Gamma2Metaplectic.factor_one τ
  factor_mul := by
    intro γ δ τ
    rw [map_mul]
    simpa only [Gamma2Metaplectic.factor_mul, L.matrix_lift]

/-- The trivial branch gives a concrete section, useful as a normalization
check only.  It is not identified with the paper's weight-half theta lift. -/
def trivial : FixedGamma2MetaplecticLift where
  lift :=
    { toFun := fun γ =>
        { matrix := γ
          factor := fun _ => 1 }
      map_one' := by
        apply Gamma2Metaplectic.ext
        · rfl
        · funext τ
          rfl
      map_mul' := by
        intro γ δ
        apply Gamma2Metaplectic.ext
        · simp
        · funext τ
          simp }
  matrix_lift := fun _ => rfl

@[simp]
theorem trivial_automorphyFactor_factor
    (γ : Gamma2Element) (τ : UpperHalfPlane) :
    (trivial.automorphyFactor.factor γ τ : ℂ) = 1 :=
  rfl

end FixedGamma2MetaplecticLift

/-- Pointwise automorphy for a branch-resolved factor. -/
def IsAutomorphic (J : HalfWeightAutomorphyFactor)
    (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ γ τ, u (gamma2Act γ τ) = (J.factor γ τ : ℂ) * u τ

/-- Almost-everywhere automorphy, which is the completion-stable formulation. -/
def IsAEAutomorphic (J : HalfWeightAutomorphyFactor)
    (μ : Measure UpperHalfPlane) (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ γ, ∀ᵐ τ ∂μ, u (gamma2Act γ τ) = (J.factor γ τ : ℂ) * u τ

theorem IsAutomorphic.isAE
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {u : UpperHalfPlane → ℂ} (hu : IsAutomorphic J u) :
    IsAEAutomorphic J μ u := by
  intro γ
  exact Filter.Eventually.of_forall (hu γ)

theorem isAutomorphic_zero (J : HalfWeightAutomorphyFactor) :
    IsAutomorphic J (fun _ => 0) := by
  intro γ τ
  simp

theorem isAEAutomorphic_zero
    (J : HalfWeightAutomorphyFactor) (μ : Measure UpperHalfPlane) :
    IsAEAutomorphic J μ (fun _ => 0) :=
  (isAutomorphic_zero J).isAE

theorem IsAEAutomorphic.add
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {u v : UpperHalfPlane → ℂ}
    (hu : IsAEAutomorphic J μ u)
    (hv : IsAEAutomorphic J μ v) :
    IsAEAutomorphic J μ (u + v) := by
  intro γ
  filter_upwards [hu γ, hv γ] with τ huτ hvτ
  simp only [Pi.add_apply, huτ, hvτ, mul_add]

theorem IsAEAutomorphic.smul
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {u : UpperHalfPlane → ℂ}
    (hu : IsAEAutomorphic J μ u) (c : ℂ) :
    IsAEAutomorphic J μ (c • u) := by
  intro γ
  filter_upwards [hu γ] with τ hτ
  change c * u (gamma2Act γ τ) =
    (J.factor γ τ : ℂ) * (c * u τ)
  rw [hτ]
  ring

/-- The completion-stable automorphy law is itself a complex linear subspace of
function representatives.  Measurability is a separate analytic property. -/
def aeAutomorphicSubmodule
    (J : HalfWeightAutomorphyFactor)
    (μ : Measure UpperHalfPlane) :
    Submodule ℂ (UpperHalfPlane → ℂ) where
  carrier := {u | IsAEAutomorphic J μ u}
  zero_mem' := isAEAutomorphic_zero J μ
  add_mem' := fun hu hv => hu.add hv
  smul_mem' := fun c _ hu => hu.smul c

/-! ## Definition 1: corrected weighted automorphic Sobolev space -/

/-- Data needed to realize the weighted Sobolev norm on an ambient normed space.

`core` is intended to model the compactly supported smooth section core after a
Hermitian automorphic line bundle and its trivializations have been constructed.
The ambient norm is required to equal the sum of the three nonnegative energy
components.  Closedness of the
almost-everywhere equivariance locus is the exact property needed to pass to the
completion. -/
structure WeightedSobolevDatum
    (J : HalfWeightAutomorphyFactor) (μ : Measure UpperHalfPlane)
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  core : Submodule ℂ H
  toFunction : H →ₗ[ℂ] (UpperHalfPlane → ℂ)
  toFunction_injective : Function.Injective toFunction
  l2Energy : H → ℝ
  raisingEnergy : H → ℝ
  loweringEnergy : H → ℝ
  l2Energy_nonneg : ∀ u, 0 ≤ l2Energy u
  raisingEnergy_nonneg : ∀ u, 0 ≤ raisingEnergy u
  loweringEnergy_nonneg : ∀ u, 0 ≤ loweringEnergy u
  norm_sq_eq_energy : ∀ u,
    ‖u‖ ^ 2 = l2Energy u + raisingEnergy u + loweringEnergy u
  core_equivariant : ∀ u ∈ core, IsAutomorphic J (toFunction u)
  ae_equivariant_closed :
    IsClosed {u : H | IsAEAutomorphic J μ (toFunction u)}

/-- **Corrected Definition 1.** The weighted automorphic Sobolev space is the
topological closure of the smooth equivariant energy core. -/
def weightedAutomorphicSobolev
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : Submodule ℂ H :=
  M.core.topologicalClosure

/-- The smooth equivariant core embeds into its graph-norm completion. -/
theorem core_le_weightedAutomorphicSobolev
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    M.core ≤ weightedAutomorphicSobolev M :=
  M.core.le_topologicalClosure

/-- The corrected Sobolev completion is a closed linear subspace. -/
theorem isClosed_weightedAutomorphicSobolev
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    IsClosed (weightedAutomorphicSobolev M : Set H) :=
  M.core.isClosed_topologicalClosure

/-- Every element of the corrected completion still has an almost-everywhere
automorphic representative. -/
theorem weightedAutomorphicSobolev_ae
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H)
    (u : weightedAutomorphicSobolev M) :
    IsAEAutomorphic J μ (M.toFunction (u : H)) := by
  have hclosure :
      closure (↑M.core : Set H) ⊆
        {v : H | IsAEAutomorphic J μ (M.toFunction v)} :=
    closure_minimal
      (by
        intro v hv
        exact (M.core_equivariant v hv).isAE)
      M.ae_equivariant_closed
  apply hclosure
  change (u : H) ∈ M.core.topologicalClosure
  exact u.property

/-- The sum of the three stored graph-energy components. -/
def WeightedSobolevDatum.graphEnergy
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : H) : ℝ :=
  M.l2Energy u + M.raisingEnergy u + M.loweringEnergy u

@[simp]
theorem WeightedSobolevDatum.graphEnergy_eq_norm_sq
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : H) :
    M.graphEnergy u = ‖u‖ ^ 2 :=
  (M.norm_sq_eq_energy u).symm

theorem WeightedSobolevDatum.graphEnergy_nonneg
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : H) :
    0 ≤ M.graphEnergy u := by
  rw [M.graphEnergy_eq_norm_sq]
  positivity

@[simp]
theorem WeightedSobolevDatum.graphEnergy_eq_zero_iff
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : H) :
    M.graphEnergy u = 0 ↔ u = 0 := by
  rw [M.graphEnergy_eq_norm_sq]
  simp

theorem WeightedSobolevDatum.sqrt_graphEnergy_eq_norm
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : H) :
    Real.sqrt (M.graphEnergy u) = ‖u‖ := by
  rw [M.graphEnergy_eq_norm_sq, Real.sqrt_sq_eq_abs,
    abs_of_nonneg (norm_nonneg u)]

/-! ## Definition 2: trial, core, data, and pairing spaces -/

/-- The abstract core intended to receive compactly supported smooth sections. -/
abbrev CoreTestSpace
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : Type _ :=
  ↥M.core

/-- **Corrected Definition 2.** The trial space is Definition 1's closed subspace. -/
abbrev TrialSpace
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : Type _ :=
  ↥(weightedAutomorphicSobolev M)

noncomputable local instance trialSpaceComplete
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : CompleteSpace (TrialSpace M) :=
  (isClosed_weightedAutomorphicSobolev M).completeSpace_coe

/-- The core inclusion into the completed trial space. -/
def coreToTrial
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    CoreTestSpace M →L[ℂ] TrialSpace M :=
  M.core.subtypeL.codRestrict
    (weightedAutomorphicSobolev M)
    (fun u => M.core.le_topologicalClosure u.property)

@[simp]
theorem norm_coreToTrial
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (u : CoreTestSpace M) :
    ‖coreToTrial M u‖ = ‖u‖ :=
  rfl

theorem denseRange_coreToTrial
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    DenseRange (coreToTrial M) := by
  change DenseRange (Set.inclusion M.core.le_topologicalClosure)
  rw [denseRange_inclusion_iff]
  · intro x hx
    exact hx
  · intro x hx
    exact M.core.le_topologicalClosure hx

/-- We fix the convention that data are continuous complex-linear functionals in
the trial argument. -/
abbrev DataSpace
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : Type _ :=
  TrialSpace M →L[ℂ] ℂ

/-- The continuous inclusion of the trial space into its graph-norm ambient
Hilbert space. -/
def trialToAmbient
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) : TrialSpace M →L[ℂ] H :=
  (weightedAutomorphicSobolev M).subtypeL

@[simp]
theorem trialToAmbient_apply
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) (v : TrialSpace M) :
    trialToAmbient M v = (v : H) :=
  rfl

/-- The declared complex-dual convention is represented by the Mathlib Riesz
anti-linear isometry `u ↦ ⟪u, ·⟫`. -/
noncomputable def trialRiesz
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (u : TrialSpace M) : DataSpace M :=
  InnerProductSpace.toDualMap ℂ (TrialSpace M) u

/-- Every trial vector has an a.e.-automorphic function realization, and this
realization map is complex-linear.  No topology is imposed on the unrestricted
function codomain. -/
def trialToAEAutomorphic
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    TrialSpace M →ₗ[ℂ] aeAutomorphicSubmodule J μ :=
  (M.toFunction.comp
    (weightedAutomorphicSobolev M).subtype).codRestrict
      (aeAutomorphicSubmodule J μ)
      (fun u => weightedAutomorphicSobolev_ae M u)

theorem trialToAEAutomorphic_injective
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H) :
    Function.Injective (trialToAEAutomorphic M) := by
  intro u v huv
  apply Subtype.ext
  apply M.toFunction_injective
  have hfun := congrArg Subtype.val huv
  change M.toFunction (u : H) = M.toFunction (v : H) at hfun
  exact hfun

/-- The dual pairing under the declared complex-linear convention. -/
def dualPairing
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) (v : TrialSpace M) : ℂ :=
  f v

@[simp]
theorem dualPairing_trialRiesz
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (u v : TrialSpace M) :
    dualPairing (trialRiesz u) v = ⟪u, v⟫_ℂ :=
  rfl

theorem norm_trialRiesz
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (u : TrialSpace M) :
    ‖trialRiesz u‖ = ‖u‖ :=
  (InnerProductSpace.toDualMap ℂ (TrialSpace M)).norm_map u

theorem norm_dualPairing_le
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) (v : TrialSpace M) :
    ‖dualPairing f v‖ ≤ ‖f‖ * ‖v‖ :=
  f.le_opNorm v

/-- The unique Riesz representative under the convention
`f(v) = ⟪representative, v⟫`. -/
noncomputable def rieszRepresentative
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) : TrialSpace M :=
  (InnerProductSpace.toDual ℂ (TrialSpace M)).symm f

@[simp]
theorem dualPairing_eq_inner_rieszRepresentative
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) (v : TrialSpace M) :
    dualPairing f v = ⟪rieszRepresentative f, v⟫_ℂ := by
  simpa [dualPairing, rieszRepresentative] using
    (InnerProductSpace.toDual_symm_apply
      (𝕜 := ℂ) (E := TrialSpace M)
      (x := v) (y := f)).symm

@[simp]
theorem norm_rieszRepresentative
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) :
    ‖rieszRepresentative f‖ = ‖f‖ := by
  simpa [rieszRepresentative] using
    (InnerProductSpace.toDual ℂ (TrialSpace M)).symm.norm_map f

theorem rieszRepresentative_unique
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) (u : TrialSpace M)
    (hu : ∀ v, dualPairing f v = ⟪u, v⟫_ℂ) :
    u = rieszRepresentative f := by
  apply (InnerProductSpace.toDual ℂ (TrialSpace M)).injective
  ext v
  simp only [InnerProductSpace.toDual_apply_apply]
  exact (hu v).symm.trans
    (dualPairing_eq_inner_rieszRepresentative f v)

theorem existsUnique_rieszRepresentative
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) :
    ∃! u : TrialSpace M,
      ∀ v, dualPairing f v = ⟪u, v⟫_ℂ := by
  refine ⟨rieszRepresentative f,
    dualPairing_eq_inner_rieszRepresentative f, ?_⟩
  intro u hu
  exact rieszRepresentative_unique f u hu

/-! ## Definition 3: cusp-local truncation -/

/-- Three labels for the cusp representatives used by the proposed `Gamma(2)`
model.  Their orbit classification is a separate concrete certificate. -/
inductive Gamma2Cusp
  | infinity
  | zero
  | one
  deriving DecidableEq

instance : Fintype Gamma2Cusp where
  elems := {Gamma2Cusp.infinity, Gamma2Cusp.zero, Gamma2Cusp.one}
  complete := by
    intro k
    cases k <;> simp

@[simp]
theorem Gamma2Cusp.card_eq : Fintype.card Gamma2Cusp = 3 := by
  decide

namespace Gamma2Cusp

/-- The width attached to each cusp label.  Its agreement with Mathlib's
strict width for the corresponding scaling conjugate is proved below. -/
def width (_ : Gamma2Cusp) : ℕ := 2

/-- Scaling matrices in `SL(2, Z)`; they are not asserted to lie in `Gamma(2)`. -/
def scalingMatrix : Gamma2Cusp → Matrix.SpecialLinearGroup (Fin 2) ℤ
  | infinity => 1
  | zero => ModularGroup.S
  | one => ModularGroup.T * ModularGroup.S

@[simp]
theorem width_eq_two (κ : Gamma2Cusp) : width κ = 2 := by
  cases κ <;> rfl

theorem width_pos (κ : Gamma2Cusp) : 0 < width κ := by
  cases κ <;> decide

/-- Normality of `Γ(2)` identifies every conjugate by one of the chosen
integral scaling matrices with `Γ(2)` itself. -/
@[simp]
theorem conjGL_gamma2_scalingMatrix (κ : Gamma2Cusp) :
    CongruenceSubgroup.conjGL Gamma2 (scalingMatrix κ) = Gamma2 := by
  change CongruenceSubgroup.conjGL (CongruenceSubgroup.Gamma 2) _ =
    CongruenceSubgroup.Gamma 2
  rw [CongruenceSubgroup.conjGL_coe,
    CongruenceSubgroup.Gamma_cong_eq_self]

/-- The Mathlib strict width at infinity of every scaling conjugate is
actually two; it is no longer merely a paper-specified label. -/
@[simp]
theorem strictWidth_scaling_conjugate_eq_two (κ : Gamma2Cusp) :
    Subgroup.strictWidthInfty
      (CongruenceSubgroup.conjGL Gamma2 (scalingMatrix κ) :
        Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)) = 2 := by
  rw [conjGL_gamma2_scalingMatrix]
  exact CongruenceSubgroup.strictWidthInfty_Gamma 2

/-- The stored cusp width agrees with the actual strict width of the
corresponding scaling conjugate. -/
@[simp]
theorem strictWidth_scaling_conjugate_eq_width (κ : Gamma2Cusp) :
    Subgroup.strictWidthInfty
      (CongruenceSubgroup.conjGL Gamma2 (scalingMatrix κ) :
        Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)) = (width κ : ℝ) := by
  rw [strictWidth_scaling_conjugate_eq_two]
  simp [width]

end Gamma2Cusp

/-- Height after moving a cusp to infinity by its scaling matrix. -/
noncomputable def cuspHeight (κ : Gamma2Cusp) (τ : UpperHalfPlane) : ℝ :=
  (((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ : UpperHalfPlane)).im

/-- Every cusp height is continuous because the fixed `GL₂(ℝ)` action on the
upper half-plane and the imaginary-part map are continuous. -/
theorem continuous_cuspHeight (κ : Gamma2Cusp) :
    Continuous (cuspHeight κ) := by
  change Continuous (fun τ : UpperHalfPlane =>
    ((((Gamma2Cusp.scalingMatrix κ)⁻¹ :
        Matrix.SpecialLinearGroup (Fin 2) ℤ) :
        Matrix.GeneralLinearGroup (Fin 2) ℝ) • τ).im)
  exact UpperHalfPlane.continuous_im.comp (continuous_const_smul _)

theorem cuspHeight_pos (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    0 < cuspHeight κ τ :=
  UpperHalfPlane.im_pos _

/-! ### Concrete disjoint cusp horoballs

The three chosen scaling matrices permit a direct computation of the cusp
heights.  Thus disjointness at strict height greater than one is a theorem of
real arithmetic; it is not stored in a fundamental-domain certificate. -/

/-- At the cusp at infinity the scaled height is the ordinary height. -/
@[simp]
theorem cuspHeight_infinity (τ : UpperHalfPlane) :
    cuspHeight Gamma2Cusp.infinity τ = τ.im := by
  simp [cuspHeight, Gamma2Cusp.scalingMatrix]

/-- At the cusp zero the scaled height is `y / |z|²`. -/
@[simp]
theorem cuspHeight_zero (τ : UpperHalfPlane) :
    cuspHeight Gamma2Cusp.zero τ =
      τ.im / Complex.normSq (τ : ℂ) := by
  change ((ModularGroup.S⁻¹ • τ : UpperHalfPlane)).im =
    τ.im / Complex.normSq (τ : ℂ)
  rw [ModularGroup.S_inv, ModularGroup.SL_neg_smul,
    ModularGroup.im_smul_eq_div_normSq, ModularGroup.denom_S]

/-- At the cusp one the scaled height is `y / |z - 1|²`. -/
@[simp]
theorem cuspHeight_one (τ : UpperHalfPlane) :
    cuspHeight Gamma2Cusp.one τ =
      τ.im / Complex.normSq ((τ : ℂ) - 1) := by
  change (((ModularGroup.T * ModularGroup.S)⁻¹ • τ : UpperHalfPlane)).im =
    τ.im / Complex.normSq ((τ : ℂ) - 1)
  rw [mul_inv_rev, mul_smul, ModularGroup.S_inv,
    ModularGroup.SL_neg_smul, ModularGroup.im_smul_eq_div_normSq,
    ModularGroup.denom_S]
  have hT :
      (ModularGroup.T⁻¹ • τ : UpperHalfPlane) =
        (-1 : ℝ) +ᵥ τ := by
    rw [← zpow_neg_one ModularGroup.T]
    simpa only [Int.cast_neg, Int.cast_one] using
      (UpperHalfPlane.modular_T_zpow_smul τ (-1 : ℤ))
  rw [hT]
  simp [UpperHalfPlane.coe_vadd, sub_eq_add_neg, add_comm]

/-- The complex coordinate of an upper-half-plane point has positive squared
norm. -/
theorem normSq_coe_pos (τ : UpperHalfPlane) :
    0 < Complex.normSq (τ : ℂ) :=
  Complex.normSq_pos.mpr τ.ne_zero

/-- Translation by one does not meet zero in the upper half-plane, so its
squared norm is positive as well. -/
theorem normSq_sub_one_pos (τ : UpperHalfPlane) :
    0 < Complex.normSq ((τ : ℂ) - 1) := by
  apply Complex.normSq_pos.mpr
  intro h
  have him := congrArg Complex.im h
  simp at him
  exact τ.im_ne_zero him

/-- Height greater than one at zero gives the strict disk inequality
`|z|² < y`. -/
theorem normSq_lt_im_of_one_lt_cuspHeight_zero
    (τ : UpperHalfPlane)
    (h : 1 < cuspHeight Gamma2Cusp.zero τ) :
    Complex.normSq (τ : ℂ) < τ.im := by
  rw [cuspHeight_zero] at h
  have hm := (lt_div_iff₀ (normSq_coe_pos τ)).mp h
  simpa only [one_mul] using hm

/-- Height greater than one at one gives the strict disk inequality
`|z - 1|² < y`. -/
theorem normSq_sub_one_lt_im_of_one_lt_cuspHeight_one
    (τ : UpperHalfPlane)
    (h : 1 < cuspHeight Gamma2Cusp.one τ) :
    Complex.normSq ((τ : ℂ) - 1) < τ.im := by
  rw [cuspHeight_one] at h
  have hm := (lt_div_iff₀ (normSq_sub_one_pos τ)).mp h
  simpa only [one_mul] using hm

/-- The strict horoball based at one cusp label. -/
def strictCuspHoroball (κ : Gamma2Cusp) : Set UpperHalfPlane :=
  {τ | 1 < cuspHeight κ τ}

/-- The strict height-one horoballs at infinity and zero are disjoint. -/
theorem disjoint_strictCuspHoroball_infinity_zero :
    Disjoint (strictCuspHoroball Gamma2Cusp.infinity)
      (strictCuspHoroball Gamma2Cusp.zero) := by
  apply Set.disjoint_left.mpr
  intro tau hInf hZero
  have hy : 1 < tau.im := by
    simpa [strictCuspHoroball] using hInf
  have hd := normSq_lt_im_of_one_lt_cuspHeight_zero tau hZero
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re,
    UpperHalfPlane.coe_im] at hd
  nlinarith [mul_self_nonneg tau.re, mul_self_nonneg tau.im]

/-- The strict height-one horoballs at infinity and one are disjoint. -/
theorem disjoint_strictCuspHoroball_infinity_one :
    Disjoint (strictCuspHoroball Gamma2Cusp.infinity)
      (strictCuspHoroball Gamma2Cusp.one) := by
  apply Set.disjoint_left.mpr
  intro tau hInf hOne
  have hy : 1 < tau.im := by
    simpa [strictCuspHoroball] using hInf
  have hd := normSq_sub_one_lt_im_of_one_lt_cuspHeight_one tau hOne
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, Complex.one_re,
    Complex.one_im, sub_zero] at hd
  nlinarith [mul_self_nonneg (tau.re - 1), mul_self_nonneg tau.im]

/-- The two finite-cusp strict height-one horoballs are disjoint.  The final
contradiction is the sum-of-squares identity centered at `(1/2, 1/2)`. -/
theorem disjoint_strictCuspHoroball_zero_one :
    Disjoint (strictCuspHoroball Gamma2Cusp.zero)
      (strictCuspHoroball Gamma2Cusp.one) := by
  rw [Set.disjoint_left]
  intro τ h₀ h₁
  have hd₀ := normSq_lt_im_of_one_lt_cuspHeight_zero τ h₀
  have hd₁ := normSq_sub_one_lt_im_of_one_lt_cuspHeight_one τ h₁
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re,
    UpperHalfPlane.coe_im] at hd₀
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, Complex.one_re,
    Complex.one_im, sub_zero] at hd₁
  nlinarith [sq_nonneg (2 * τ.re - 1), sq_nonneg (2 * τ.im - 1)]

/-- The three concrete strict height-one cusp horoballs are pairwise disjoint. -/
theorem pairwise_disjoint_strictCuspHoroball :
    Pairwise (fun κ κ' => Disjoint (strictCuspHoroball κ) (strictCuspHoroball κ')) := by
  intro κ κ' hκκ'
  cases κ <;> cases κ'
  · exact (hκκ' rfl).elim
  · exact disjoint_strictCuspHoroball_infinity_zero
  · exact disjoint_strictCuspHoroball_infinity_one
  · exact disjoint_strictCuspHoroball_infinity_zero.symm
  · exact (hκκ' rfl).elim
  · exact disjoint_strictCuspHoroball_zero_one
  · exact disjoint_strictCuspHoroball_infinity_one.symm
  · exact disjoint_strictCuspHoroball_zero_one.symm
  · exact (hκκ' rfl).elim

/-- The cusp-local parameter of width two.

This is a function on a chosen cusp chart, not a global function on the quotient. -/
noncomputable def cuspQCoordinate (κ : Gamma2Cusp)
    (τ : UpperHalfPlane) : ℂ :=
  Complex.exp
    (((2 * Real.pi : ℝ) : ℂ) * Complex.I *
      (↑((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ) : ℂ) /
      (Gamma2Cusp.width κ : ℂ))

/-- The explicit cusp coordinate is Mathlib's periodic `q` parameter with the
proved cusp width. -/
theorem cuspQCoordinate_eq_qParam (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    cuspQCoordinate κ τ =
      Function.Periodic.qParam (Gamma2Cusp.width κ : ℝ)
        (↑((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ) : ℂ) := by
  cases κ <;>
    simp [cuspQCoordinate, Function.Periodic.qParam, Gamma2Cusp.width]

/-- A cusp coordinate never hits the deleted center of the punctured disk. -/
theorem cuspQCoordinate_ne_zero (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    cuspQCoordinate κ τ ≠ 0 := by
  unfold cuspQCoordinate
  exact Complex.exp_ne_zero _

/-- Every local cusp parameter lies strictly inside the unit disk. -/
theorem norm_cuspQCoordinate_lt_one (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    ‖cuspQCoordinate κ τ‖ < 1 := by
  rw [cuspQCoordinate_eq_qParam, Gamma2Cusp.width_eq_two]
  exact UpperHalfPlane.norm_qParam_lt_one 2
    ((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ)

/-- The natural target of every cusp-local `q` coordinate. -/
def puncturedUnitDisk : Set ℂ :=
  {q | q ≠ 0 ∧ ‖q‖ < 1}

theorem cuspQCoordinate_mem_puncturedUnitDisk
    (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    cuspQCoordinate κ τ ∈ puncturedUnitDisk :=
  ⟨cuspQCoordinate_ne_zero κ τ, norm_cuspQCoordinate_lt_one κ τ⟩

/-- **Corrected Definition 3.** Truncation removes all cusp regions above `Y`. -/
def truncatedFundamentalDomain (F : Set UpperHalfPlane) (Y : ℝ) :
    Set UpperHalfPlane :=
  F ∩ {τ | ∀ κ : Gamma2Cusp, cuspHeight κ τ ≤ Y}

/-- Truncation preserves closedness.  This is deliberately separate from
compactness, which still requires a concrete fundamental polygon. -/
theorem isClosed_truncatedFundamentalDomain
    {F : Set UpperHalfPlane} (hF : IsClosed F) (Y : ℝ) :
    IsClosed (truncatedFundamentalDomain F Y) := by
  rw [truncatedFundamentalDomain, Set.setOf_forall]
  exact hF.inter (isClosed_iInter fun κ =>
    isClosed_le (continuous_cuspHeight κ) continuous_const)

@[simp]
theorem mem_truncatedFundamentalDomain
    {F : Set UpperHalfPlane} {Y : ℝ} {τ : UpperHalfPlane} :
    τ ∈ truncatedFundamentalDomain F Y ↔
      τ ∈ F ∧ ∀ κ : Gamma2Cusp, cuspHeight κ τ ≤ Y :=
  Iff.rfl

theorem truncatedFundamentalDomain_subset
    (F : Set UpperHalfPlane) (Y : ℝ) :
    truncatedFundamentalDomain F Y ⊆ F := by
  intro τ hτ
  exact hτ.1

theorem truncatedFundamentalDomain_mono
    (F : Set UpperHalfPlane) {Y Z : ℝ} (hYZ : Y ≤ Z) :
    truncatedFundamentalDomain F Y ⊆ truncatedFundamentalDomain F Z := by
  intro τ hτ
  exact ⟨hτ.1, fun κ => (hτ.2 κ).trans hYZ⟩

/-- Set-theoretic exhaustion by the three cusp heights is automatic: for a fixed
point, take the maximum of its three finite heights. -/
theorem truncatedFundamentalDomain_eventually_mem
    (F : Set UpperHalfPlane) (τ : UpperHalfPlane) (hτ : τ ∈ F) :
    ∃ Y : ℝ, τ ∈ truncatedFundamentalDomain F Y := by
  let Y : ℝ :=
    max (cuspHeight Gamma2Cusp.infinity τ)
      (max (cuspHeight Gamma2Cusp.zero τ)
        (cuspHeight Gamma2Cusp.one τ))
  refine ⟨Y, hτ, ?_⟩
  intro κ
  cases κ with
  | infinity =>
      dsimp [Y]
      exact le_max_left _ _
  | zero =>
      dsimp [Y]
      exact (le_max_left _ _).trans (le_max_right _ _)
  | one =>
      dsimp [Y]
      exact (le_max_right _ _).trans (le_max_right _ _)

/-- The exhaustion can always be chosen above an arbitrary initial height. -/
theorem truncatedFundamentalDomain_eventually_mem_above
    (F : Set UpperHalfPlane) (Y0 : ℝ)
    (τ : UpperHalfPlane) (hτ : τ ∈ F) :
    ∃ Y, Y0 ≤ Y ∧ τ ∈ truncatedFundamentalDomain F Y := by
  obtain ⟨Y, hY⟩ := truncatedFundamentalDomain_eventually_mem F τ hτ
  refine ⟨max Y0 Y, le_max_left _ _, ?_⟩
  exact truncatedFundamentalDomain_mono F (le_max_right _ _) hY

/-- The increasing union of all truncations is the original domain. -/
theorem iUnion_truncatedFundamentalDomain (F : Set UpperHalfPlane) :
    (⋃ Y : ℝ, truncatedFundamentalDomain F Y) = F := by
  ext τ
  constructor
  · intro hτ
    obtain ⟨Y, hY⟩ := Set.mem_iUnion.mp hτ
    exact hY.1
  · intro hτ
    obtain ⟨Y, hY⟩ := truncatedFundamentalDomain_eventually_mem F τ hτ
    exact Set.mem_iUnion.mpr ⟨Y, hY⟩

/-- Every compact subset of the selected domain lies in one common truncation.
This is the compact-core input required for the variable truncation height in
Proposition 1. -/
theorem IsCompact.exists_truncationHeight
    {K F : Set UpperHalfPlane} (hK : IsCompact K) (hKF : K ⊆ F) :
    ∃ Y : ℝ, K ⊆ truncatedFundamentalDomain F Y := by
  obtain ⟨yInf, hyInf⟩ := hK.bddAbove_image
    (continuous_cuspHeight Gamma2Cusp.infinity).continuousOn
  obtain ⟨yZero, hyZero⟩ := hK.bddAbove_image
    (continuous_cuspHeight Gamma2Cusp.zero).continuousOn
  obtain ⟨yOne, hyOne⟩ := hK.bddAbove_image
    (continuous_cuspHeight Gamma2Cusp.one).continuousOn
  refine ⟨max yInf (max yZero yOne), ?_⟩
  intro τ hτ
  refine ⟨hKF hτ, ?_⟩
  intro κ
  cases κ with
  | infinity =>
      exact (hyInf ⟨τ, hτ, rfl⟩).trans (le_max_left _ _)
  | zero =>
      exact (hyZero ⟨τ, hτ, rfl⟩).trans
        ((le_max_left _ _).trans (le_max_right _ _))
  | one =>
      exact (hyOne ⟨τ, hτ, rfl⟩).trans
        ((le_max_right _ _).trans (le_max_right _ _))

/-- Compactness and exhaustion require a chosen admissible fundamental polygon;
they do not follow from an arbitrary set called a fundamental domain. -/
structure TruncationCertificate (F : Set UpperHalfPlane) (Y0 : ℝ) : Prop where
  compact : ∀ Y, Y0 ≤ Y → IsCompact (truncatedFundamentalDomain F Y)
  exhausts : ∀ τ ∈ F, ∃ Y, Y0 ≤ Y ∧ τ ∈ truncatedFundamentalDomain F Y

/-- Once compactness is established for a concrete fundamental polygon, the
exhaustion field of `TruncationCertificate` requires no additional hypothesis. -/
def truncationCertificateOfCompact
    (F : Set UpperHalfPlane) (Y0 : ℝ)
    (hcompact : ∀ Y, Y0 ≤ Y →
      IsCompact (truncatedFundamentalDomain F Y)) :
    TruncationCertificate F Y0 where
  compact := hcompact
  exhausts := truncatedFundamentalDomain_eventually_mem_above F Y0

/-! ## Definitions 4, 6, and 7: one abstract positive mass functional -/

/-- Concrete input types for the continuous spectral mass.

Each `spectralMeasure κ` is positive by its type.  Integrability is stored explicitly
so a nonintegrable Bochner integral cannot silently be interpreted as zero. -/
structure ContinuousSpectralData where
  test : ℝ → ℝ
  test_nonneg : ∀ t, 0 ≤ test t
  spectralMeasure : Gamma2Cusp → Measure ℝ
  coefficient : Gamma2Cusp → ℕ → ℝ → ℂ
  integrable : ∀ κ m,
    Integrable
      (fun t => test t * Complex.normSq (coefficient κ m t))
      (spectralMeasure κ)

/-- The contribution of one cusp to the continuous mass. -/
noncomputable def continuousMassAtCusp
    (D : ContinuousSpectralData) (κ : Gamma2Cusp) (m : ℕ) : ℝ :=
  ∫ t, D.test t * Complex.normSq (D.coefficient κ m t)
    ∂D.spectralMeasure κ

/-- **Corrected Definition 6.** Sum over every cusp; there is no free cusp
index and no unproved identification with a scattering logarithmic derivative. -/
noncomputable def massFunctional
    (D : ContinuousSpectralData) (m : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp, continuousMassAtCusp D κ m

theorem continuousMassAtCusp_nonneg
    (D : ContinuousSpectralData) (κ : Gamma2Cusp) (m : ℕ) :
    0 ≤ continuousMassAtCusp D κ m := by
  apply integral_nonneg
  intro t
  exact mul_nonneg (D.test_nonneg t)
    (Complex.normSq_nonneg (D.coefficient κ m t))

theorem massFunctional_nonneg
    (D : ContinuousSpectralData) (m : ℕ) :
    0 ≤ massFunctional D m := by
  unfold massFunctional
  exact Finset.sum_nonneg fun κ _ => continuousMassAtCusp_nonneg D κ m

/-- The pointwise nonnegative density whose integral is one cusp contribution. -/
def continuousMassDensity
    (D : ContinuousSpectralData)
    (κ : Gamma2Cusp) (m : ℕ) (t : ℝ) : ℝ :=
  D.test t * Complex.normSq (D.coefficient κ m t)

@[simp]
theorem continuousMassDensity_nonneg
    (D : ContinuousSpectralData)
    (κ : Gamma2Cusp) (m : ℕ) (t : ℝ) :
    0 ≤ continuousMassDensity D κ m t :=
  mul_nonneg (D.test_nonneg t)
    (Complex.normSq_nonneg _)

/-- Spectral parameters at which both the test and coefficient are active. -/
def spectralActivitySet
    (D : ContinuousSpectralData)
    (κ : Gamma2Cusp) (m : ℕ) : Set ℝ :=
  {t | D.test t ≠ 0 ∧ D.coefficient κ m t ≠ 0}

theorem support_continuousMassDensity
    (D : ContinuousSpectralData)
    (κ : Gamma2Cusp) (m : ℕ) :
    Function.support (continuousMassDensity D κ m) =
      spectralActivitySet D κ m := by
  ext t
  simp [Function.support, continuousMassDensity,
    spectralActivitySet, Complex.normSq_eq_zero]

/-- A cusp contribution is strictly positive exactly when its active spectral
set has positive measure. -/
theorem continuousMassAtCusp_pos_iff_activity
    (D : ContinuousSpectralData)
    (κ : Gamma2Cusp) (m : ℕ) :
    0 < continuousMassAtCusp D κ m ↔
      0 < D.spectralMeasure κ (spectralActivitySet D κ m) := by
  simpa [continuousMassAtCusp, continuousMassDensity,
    support_continuousMassDensity] using
    (integral_pos_iff_support_of_nonneg
      (continuousMassDensity_nonneg D κ m)
      (by
        change Integrable
          (fun t => D.test t * Complex.normSq (D.coefficient κ m t))
          (D.spectralMeasure κ)
        exact D.integrable κ m))

/-- The total mass is positive exactly when at least one cusp contribution is
positive. -/
theorem massFunctional_pos_iff
    (D : ContinuousSpectralData) (m : ℕ) :
    0 < massFunctional D m ↔
      ∃ κ : Gamma2Cusp, 0 < continuousMassAtCusp D κ m := by
  unfold massFunctional
  simpa using
    (Finset.sum_pos_iff_of_nonneg
      (s := Finset.univ)
      (f := fun κ => continuousMassAtCusp D κ m)
      (fun κ _ => continuousMassAtCusp_nonneg D κ m))

/-- Positive rescaling records the normalization of the spectral test
explicitly. -/
def ContinuousSpectralData.scaleTest
    (D : ContinuousSpectralData) (c : ℝ) (hc : 0 ≤ c) :
    ContinuousSpectralData where
  test := fun t => c * D.test t
  test_nonneg := fun t => mul_nonneg hc (D.test_nonneg t)
  spectralMeasure := D.spectralMeasure
  coefficient := D.coefficient
  integrable := by
    intro κ m
    simpa only [mul_assoc] using (D.integrable κ m).const_mul c

@[simp]
theorem continuousMassAtCusp_scaleTest
    (D : ContinuousSpectralData) (c : ℝ) (hc : 0 ≤ c)
    (κ : Gamma2Cusp) (m : ℕ) :
    continuousMassAtCusp (D.scaleTest c hc) κ m =
      c * continuousMassAtCusp D κ m := by
  simp [continuousMassAtCusp, ContinuousSpectralData.scaleTest,
    mul_assoc, integral_const_mul]

@[simp]
theorem massFunctional_scaleTest
    (D : ContinuousSpectralData) (c : ℝ) (hc : 0 ≤ c) (m : ℕ) :
    massFunctional (D.scaleTest c hc) m = c * massFunctional D m := by
  simp [massFunctional, Finset.mul_sum]

/-- A uniform strictly positive lower bound beginning at the fixed threshold `m0`.
It is a predicate, not a consequence of pointwise nonnegativity. -/
def MassConditionAt (D : ContinuousSpectralData) (ε : ℝ) (m0 : ℕ) : Prop :=
  0 < ε ∧ 1 ≤ m0 ∧ ∀ m, m0 ≤ m → ε ≤ massFunctional D m

/-- **Corrected Definitions 4 and 7.** The threshold is existential, as in the
paper's notation `H_mass(ε)`. -/
def HMass (D : ContinuousSpectralData) (ε : ℝ) : Prop :=
  ∃ m0, MassConditionAt D ε m0

/-- Raising the starting threshold preserves the same uniform mass bound. -/
theorem MassConditionAt.threshold_mono
    {D : ContinuousSpectralData} {ε : ℝ} {m₀ m₁ : ℕ}
    (h : MassConditionAt D ε m₀) (hm : m₀ ≤ m₁) :
    MassConditionAt D ε m₁ := by
  refine ⟨h.1, h.2.1.trans hm, ?_⟩
  intro m hm₁
  exact h.2.2 m (hm.trans hm₁)

/-- A positive smaller lower bound is inherited without changing the
threshold. -/
theorem MassConditionAt.weaken
    {D : ContinuousSpectralData} {ε ε' : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀) (hε' : 0 < ε') (hε : ε' ≤ ε) :
    MassConditionAt D ε' m₀ :=
  ⟨hε', h.2.1, fun m hm => hε.trans (h.2.2 m hm)⟩

/-- Positive test normalization rescales the certified lower bound by the same
factor. -/
theorem MassConditionAt.scaleTest
    {D : ContinuousSpectralData} {ε c : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀) (hc : 0 < c) :
    MassConditionAt (D.scaleTest c hc.le) (c * ε) m₀ := by
  refine ⟨mul_pos hc h.1, h.2.1, ?_⟩
  intro m hm
  rw [massFunctional_scaleTest]
  exact mul_le_mul_of_nonneg_left (h.2.2 m hm) hc.le

theorem HMass.scaleTest
    {D : ContinuousSpectralData} {ε c : ℝ}
    (h : HMass D ε) (hc : 0 < c) :
    HMass (D.scaleTest c hc.le) (c * ε) := by
  rcases h with ⟨m₀, hm₀⟩
  exact ⟨m₀, hm₀.scaleTest hc⟩

theorem MassConditionAt.mass_pos
    {D : ContinuousSpectralData} {ε : ℝ} {m0 m : ℕ}
    (h : MassConditionAt D ε m0) (hm : m0 ≤ m) :
    0 < massFunctional D m :=
  h.1.trans_le (h.2.2 m hm)

theorem HMass.exists_eventual_positive
    {D : ContinuousSpectralData} {ε : ℝ} (h : HMass D ε) :
    ∃ m0, 1 ≤ m0 ∧ ∀ m, m0 ≤ m → 0 < massFunctional D m := by
  obtain ⟨m0, hm⟩ := h
  exact ⟨m0, hm.2.1, fun m hm0 => hm.mass_pos hm0⟩

/-! ## Definition 5: Eisenstein--Rankin--Selberg integral -/

/-- Scalar invariance under the concrete `Γ(2)` action. -/
def IsGamma2Invariant (f : UpperHalfPlane → ℂ) : Prop :=
  ∀ γ τ, f (gamma2Act γ τ) = f τ

/-- The transformation law dual to `J` after complex conjugation.  It uses the
inverse of the full automorphy factor and does not assume that this factor has
unit complex norm. -/
def IsConjugateDualAutomorphic
    (J : HalfWeightAutomorphyFactor)
    (v : UpperHalfPlane → ℂ) : Prop :=
  ∀ γ τ,
    v (gamma2Act γ τ) =
      (starRingEnd ℂ) ((J.factor γ τ : ℂ)⁻¹) * v τ

/-- Hermitian scalar contraction of a section and a conjugate-dual section. -/
def hermitianContraction
    (u v : UpperHalfPlane → ℂ) : UpperHalfPlane → ℂ :=
  fun τ => u τ * (starRingEnd ℂ) (v τ)

/-- Pointwise unitarity of a branch-resolved automorphy factor.  This is the
precise extra fact needed when the two factors transform with the *same*
multiplier, as asserted in Item 1. -/
def IsUnitaryAutomorphyFactor (J : HalfWeightAutomorphyFactor) : Prop :=
  ∀ γ τ,
    (J.factor γ τ : ℂ) *
      (starRingEnd ℂ) (J.factor γ τ : ℂ) = 1

/-- Equal unitary multipliers cancel in the Hermitian product. -/
theorem hermitianContraction_invariant_of_sameMultiplier
    {J : HalfWeightAutomorphyFactor}
    (hJ : IsUnitaryAutomorphyFactor J)
    {u v : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic J u) (hv : IsAutomorphic J v) :
    IsGamma2Invariant (hermitianContraction u v) := by
  intro γ τ
  change
    u (gamma2Act γ τ) *
        (starRingEnd ℂ) (v (gamma2Act γ τ)) =
      u τ * (starRingEnd ℂ) (v τ)
  rw [hu γ τ, hv γ τ, map_mul]
  calc
    ((J.factor γ τ : ℂ) * u τ) *
        ((starRingEnd ℂ) (J.factor γ τ : ℂ) *
          (starRingEnd ℂ) (v τ)) =
      ((J.factor γ τ : ℂ) *
          (starRingEnd ℂ) (J.factor γ τ : ℂ)) *
        (u τ * (starRingEnd ℂ) (v τ)) := by ring
    _ = u τ * (starRingEnd ℂ) (v τ) := by
      rw [hJ γ τ, one_mul]

/-- Equal nonzero multipliers do not cancel without the unitary hypothesis. -/
theorem sameMultiplierScalarCancellation_requires_unitarity :
    ∃ j u v : ℂ, j ≠ 0 ∧
      (j * u) * (starRingEnd ℂ) (j * v) ≠
        u * (starRingEnd ℂ) v := by
  refine ⟨2, 1, 1, by norm_num, ?_⟩
  norm_num [starRingEnd_apply, Complex.star_def]

/-- The corrected multiplier-cancellation statement used by a scalar
Rankin--Selberg integrand. -/
theorem hermitianContraction_invariant
    {J : HalfWeightAutomorphyFactor}
    {u v : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic J u)
    (hv : IsConjugateDualAutomorphic J v) :
    IsGamma2Invariant (hermitianContraction u v) := by
  intro γ τ
  have ha : (J.factor γ τ : ℂ) ≠ 0 := Units.ne_zero _
  change
    u (gamma2Act γ τ) *
        (starRingEnd ℂ) (v (gamma2Act γ τ)) =
      u τ * (starRingEnd ℂ) (v τ)
  rw [hu γ τ, hv γ τ, map_mul, map_inv₀]
  have hstar :
      (starRingEnd ℂ) ((starRingEnd ℂ) (J.factor γ τ : ℂ)) =
        (J.factor γ τ : ℂ) := by
    simpa only [starRingEnd_apply] using
      (star_star (J.factor γ τ : ℂ))
  rw [map_inv₀, hstar]
  calc
    ((J.factor γ τ : ℂ) * u τ) *
        ((J.factor γ τ : ℂ)⁻¹ * (starRingEnd ℂ) (v τ)) =
      ((J.factor γ τ : ℂ) * (J.factor γ τ : ℂ)⁻¹) *
        (u τ * (starRingEnd ℂ) (v τ)) := by ring
    _ = u τ * (starRingEnd ℂ) (v τ) := by
      rw [mul_inv_cancel₀ ha, one_mul]

/-- Correct scalar data for an Eisenstein--Rankin--Selberg pairing.

`contractedMockKernel` is scalar-valued and is intended to be instantiated by a
quotient-invariant Hermitian contraction of sections with dual automorphy factors.
The present interface does not infer invariance from equal half-weight multipliers. -/
structure RankinSelbergData (X : Type*) [MeasurableSpace X] where
  measure : Measure X
  contractedMockKernel : X → ℂ
  eisenstein : Gamma2Cusp → ℂ → X → ℂ

/-- The complex pairing is linear in the contracted mock kernel and conjugate in
the Eisenstein entry. -/
def rankinSelbergIntegrand
    {X : Type*} [MeasurableSpace X] (D : RankinSelbergData X)
    (κ : Gamma2Cusp) (s : ℂ) (x : X) : ℂ :=
  D.contractedMockKernel x * (starRingEnd ℂ) (D.eisenstein κ s x)

/-- The exact convergence predicate for Definition 5. -/
def RankinSelbergConvergesAt
    {X : Type*} [MeasurableSpace X] (D : RankinSelbergData X)
    (κ : Gamma2Cusp) (s : ℂ) : Prop :=
  Integrable (rankinSelbergIntegrand D κ s) D.measure

/-- The corrected half-plane and genuine integrability requirement are kept in
one admissibility predicate. -/
def RankinSelbergAdmissibleAt
    {X : Type*} [MeasurableSpace X] (D : RankinSelbergData X)
    (κ : Gamma2Cusp) (s : ℂ) : Prop :=
  1 < s.re ∧ RankinSelbergConvergesAt D κ s

/-- The domain consists only of cusp/parameter pairs at which the defining
integrand is genuinely integrable. -/
def RankinSelbergDomain
    {X : Type*} [MeasurableSpace X] (D : RankinSelbergData X) : Type :=
  {p : Gamma2Cusp × ℂ |
    RankinSelbergAdmissibleAt D p.1 p.2}

theorem RankinSelbergDomain.re_gt_one
    {X : Type*} [MeasurableSpace X] {D : RankinSelbergData X}
    (p : RankinSelbergDomain D) :
    1 < p.1.2.re :=
  p.2.1

theorem RankinSelbergDomain.integrable
    {X : Type*} [MeasurableSpace X] {D : RankinSelbergData X}
    (p : RankinSelbergDomain D) :
    RankinSelbergConvergesAt D p.1.1 p.1.2 :=
  p.2.2

/-- **Corrected Definition 5.** A point in the domain carries the convergence
proof, so the integral cannot silently use the zero value assigned to a
nonintegrable Bochner integrand. -/
noncomputable def rankinSelbergIntegral
    {X : Type*} [MeasurableSpace X] (D : RankinSelbergData X)
    (p : RankinSelbergDomain D) : ℂ :=
  ∫ x, rankinSelbergIntegrand D p.1.1 p.1.2 x ∂D.measure

/-! ## Definition 8: cusp-local conjugation of operators -/

/-- A topological cusp chart includes open domains, a continuous inverse, and
agreement with the explicit local `q` formula.  Analyticity and operator-domain
regularity remain separate obligations in any concrete PDE instantiation. -/
structure CuspQChart (κ : Gamma2Cusp) where
  tauDomain : Set UpperHalfPlane
  qDomain : Set ℂ
  tau_open : IsOpen tauDomain
  q_open : IsOpen qDomain
  q_nonzero : ∀ q ∈ qDomain, q ≠ 0
  coord : {τ // τ ∈ tauDomain} ≃ₜ {q // q ∈ qDomain}
  coord_eq : ∀ τ : {τ // τ ∈ tauDomain},
    (coord τ : ℂ) = cuspQCoordinate κ (τ : UpperHalfPlane)

/-- Push a function through an actual coordinate equivalence. -/
def pushFunction {X Y A : Type*} (e : X ≃ Y) (u : X → A) : Y → A :=
  fun y => u (e.symm y)

/-- Pull a function back through an actual coordinate equivalence. -/
def pullFunction {X Y A : Type*} (e : X ≃ Y) (F : Y → A) : X → A :=
  fun x => F (e x)

@[simp]
theorem pullFunction_pushFunction
    {X Y A : Type*} (e : X ≃ Y) (u : X → A) :
    pullFunction e (pushFunction e u) = u := by
  funext x
  simp [pullFunction, pushFunction]

@[simp]
theorem pushFunction_pullFunction
    {X Y A : Type*} (e : X ≃ Y) (F : Y → A) :
    pushFunction e (pullFunction e F) = F := by
  funext y
  simp [pullFunction, pushFunction]

/-- Conjugate any operator by a genuine change of coordinates. -/
def conjugateOperator {X Y A : Type*} (e : X ≃ Y)
    (L : (X → A) → X → A) : (Y → A) → Y → A :=
  fun F => pushFunction e (L (pullFunction e F))

/-- **Corrected Definition 8.** The `q`-Laplacian is local to one cusp chart. -/
def qLaplacian {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (laplacian :
      ({τ // τ ∈ chart.tauDomain} → ℂ) →
        {τ // τ ∈ chart.tauDomain} → ℂ) :
    ({q // q ∈ chart.qDomain} → ℂ) →
      {q // q ∈ chart.qDomain} → ℂ :=
  conjugateOperator chart.coord.toEquiv laplacian

theorem qLaplacian_intertwines
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (laplacian :
      ({τ // τ ∈ chart.tauDomain} → ℂ) →
        {τ // τ ∈ chart.tauDomain} → ℂ)
    (u : {τ // τ ∈ chart.tauDomain} → ℂ) :
    qLaplacian chart laplacian (pushFunction chart.coord.toEquiv u) =
      pushFunction chart.coord.toEquiv (laplacian u) := by
  simp [qLaplacian, conjugateOperator]

/-- The inverse intertwining identity, stated on arbitrary `q`-side
functions. -/
theorem qLaplacian_pull_intertwines
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (laplacian :
      ({τ // τ ∈ chart.tauDomain} → ℂ) →
        {τ // τ ∈ chart.tauDomain} → ℂ)
    (F : {q // q ∈ chart.qDomain} → ℂ) :
    pullFunction chart.coord.toEquiv
        (qLaplacian chart laplacian F) =
      laplacian (pullFunction chart.coord.toEquiv F) := by
  simp [qLaplacian, conjugateOperator]

/-- The measure in a supplied `q` chart is constructed, rather than postulated,
as the pushforward of the tau-side measure. -/
noncomputable def CuspQChart.transformedMeasure
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain}) :
    Measure {q // q ∈ chart.qDomain} :=
  Measure.map chart.coord μ

/-- Exact change of variables for the transported chart measure. -/
theorem CuspQChart.integral_transformedMeasure
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain})
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (F : {q // q ∈ chart.qDomain} → E) :
    (∫ q, F q ∂chart.transformedMeasure μ) =
      ∫ τ, F (chart.coord τ) ∂μ := by
  simpa [CuspQChart.transformedMeasure] using
    (MeasureTheory.integral_map_equiv
      (μ := μ) chart.coord.toMeasurableEquiv F)

/-- The coordinate push preserves the quadratic `L²` integral for the
transported measure. -/
theorem CuspQChart.integral_normSq_pushFunction
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain})
    (u : {τ // τ ∈ chart.tauDomain} → ℂ) :
    (∫ q, Complex.normSq
        (pushFunction chart.coord.toEquiv u q)
        ∂chart.transformedMeasure μ) =
      ∫ τ, Complex.normSq (u τ) ∂μ := by
  rw [chart.integral_transformedMeasure]
  simp [pushFunction]

/-- The cusp coordinate itself preserves the source measure when the target is
equipped with the transported measure.  Thus measure preservation is derived
from `Measure.map`, rather than stored as an additional chart axiom. -/
theorem CuspQChart.coord_measurePreserving
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain}) :
    MeasurePreserving chart.coord μ (chart.transformedMeasure μ) where
  measurable := chart.coord.measurable
  map_eq := rfl

/-- The inverse cusp coordinate is measure preserving in the reverse
direction.  This uses bijectivity of the chart, not a separate Jacobian
assumption. -/
theorem CuspQChart.symm_measurePreserving
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain}) :
    MeasurePreserving chart.coord.symm (chart.transformedMeasure μ) μ where
  measurable := chart.coord.symm.measurable
  map_eq := by
    change Measure.map (⇑chart.coord.toMeasurableEquiv.symm)
      (Measure.map (⇑chart.coord.toMeasurableEquiv) μ) = μ
    exact MeasurableEquiv.map_symm_map
      (μ := μ) chart.coord.toMeasurableEquiv

/-- Exact `L^p` seminorm preservation under pushforward through a cusp chart.
Unlike the quadratic-integral corollary above, this holds simultaneously for
every exponent, including `0` and `∞`. -/
theorem CuspQChart.eLpNorm_pushFunction
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain})
    {E : Type*} [NormedAddCommGroup E]
    (p : ENNReal) (u : {τ // τ ∈ chart.tauDomain} → E) :
    eLpNorm (pushFunction chart.coord.toEquiv u) p
        (chart.transformedMeasure μ) =
      eLpNorm u p μ := by
  change
    eLpNorm (pushFunction chart.coord.toEquiv u) p
        (Measure.map (⇑chart.coord.toMeasurableEquiv) μ) =
      eLpNorm u p μ
  have h :=
    chart.coord.toMeasurableEquiv.measurableEmbedding.eLpNorm_map_measure
      (μ := μ) (g := pushFunction chart.coord.toEquiv u) (p := p)
  have hcomp :
      pushFunction chart.coord.toEquiv u ∘
          (⇑chart.coord.toMeasurableEquiv) = u := by
    funext x
    simp [pushFunction]
  simpa only [hcomp] using h

/-- `MemLp` is equivalent on the two sides of a cusp chart.  In particular,
transport cannot manufacture integrability by using Mathlib's default value
for a nonintegrable integral. -/
theorem CuspQChart.memLp_pushFunction_iff
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain})
    {E : Type*} [NormedAddCommGroup E]
    (p : ENNReal) (u : {τ // τ ∈ chart.tauDomain} → E) :
    MemLp (pushFunction chart.coord.toEquiv u) p
        (chart.transformedMeasure μ) ↔
      MemLp u p μ := by
  change
    MemLp (pushFunction chart.coord.toEquiv u) p
        (Measure.map (⇑chart.coord.toMeasurableEquiv) μ) ↔
      MemLp u p μ
  have h := chart.coord.toMeasurableEquiv.memLp_map_measure_iff
      (μ := μ) (g := pushFunction chart.coord.toEquiv u) (p := p)
  have hcomp :
      pushFunction chart.coord.toEquiv u ∘
          (⇑chart.coord.toMeasurableEquiv) = u := by
    funext x
    simp [pushFunction]
  simpa only [hcomp] using h

/-- The chart pushforward is a genuine linear isometric equivalence of `L^p`
spaces.  Its inverse is pullback along the forward coordinate. -/
noncomputable def CuspQChart.lpPushLinearIsometryEquiv
    {κ : Gamma2Cusp} (chart : CuspQChart κ)
    (μ : Measure {τ // τ ∈ chart.tauDomain})
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (p : ENNReal) [Fact (1 ≤ p)] :
    Lp E p μ ≃ₗᵢ[ℂ] Lp E p (chart.transformedMeasure μ) := by
  let hcoord := chart.coord_measurePreserving μ
  let hsymm := chart.symm_measurePreserving μ
  let forward :
      Lp E p μ →ₗᵢ[ℂ] Lp E p (chart.transformedMeasure μ) :=
    Lp.compMeasurePreservingₗᵢ ℂ chart.coord.symm hsymm
  let backward :
      Lp E p (chart.transformedMeasure μ) →ₗ[ℂ] Lp E p μ :=
    Lp.compMeasurePreservingₗ ℂ chart.coord hcoord
  refine LinearIsometryEquiv.ofLinearIsometry forward backward ?_ ?_
  · apply LinearMap.ext
    intro F
    have hcomp :=
      Lp.compMeasurePreserving_comp_apply
        (E := E) (p := p) F hcoord hsymm
    change
      (Lp.compMeasurePreserving (⇑chart.coord.symm) hsymm)
          ((Lp.compMeasurePreserving (⇑chart.coord) hcoord) F) = F
    have hfun : (chart.coord ∘ chart.coord.symm) = id := by
      funext x
      exact chart.coord.apply_symm_apply x
    simpa only [hfun, Lp.compMeasurePreserving_id_apply] using hcomp.symm
  · apply LinearMap.ext
    intro u
    have hcomp :=
      Lp.compMeasurePreserving_comp_apply
        (E := E) (p := p) u hsymm hcoord
    change
      (Lp.compMeasurePreserving (⇑chart.coord) hcoord)
          ((Lp.compMeasurePreserving (⇑chart.coord.symm) hsymm) u) = u
    have hfun : (chart.coord.symm ∘ chart.coord) = id := by
      funext x
      exact chart.coord.symm_apply_apply x
    simpa only [hfun, Lp.compMeasurePreserving_id_apply] using hcomp.symm

/-! ## Definitions 9 and 11: a kernel-family trivialization interface -/

/-- The real radial base.  It is not identified with a branch of complex `log q`. -/
abbrev RadialBase : Type := Set.Ioo (0 : ℝ) 1

/-- A kernel family with a chosen trivialization to one model fiber.

The trivialization is the substantive constant-rank/local-triviality input; transport
is derived from it below rather than postulated independently. -/
structure QLocalSystem
    (V Model : Type*)
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model] where
  operator : RadialBase → V →ₗ[ℂ] V
  trivialization : (r : RadialBase) → (operator r).ker ≃ₗ[ℂ] Model

/-- The fiber at radius `r`. -/
abbrev QLocalSystem.fiber
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) : Type _ :=
  ↥(L.operator r).ker

/-- Every fiber of a `QLocalSystem` is identified with its fixed model fiber by
the chosen constant-rank trivialization. -/
def QLocalSystem.fiberEquivModel
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) :
    L.fiber r ≃ₗ[ℂ] Model :=
  L.trivialization r

/-- Parallel transport induced by the selected trivialization. -/
def QLocalSystem.transport
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) :
    L.fiber r ≃ₗ[ℂ] L.fiber s :=
  (L.trivialization r).trans (L.trivialization s).symm

/-- Any two fibers are linearly equivalent, as a direct consequence of their
common identification with the model fiber. -/
def QLocalSystem.fiberEquivFiber
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) :
    L.fiber r ≃ₗ[ℂ] L.fiber s :=
  (L.fiberEquivModel r).trans (L.fiberEquivModel s).symm

@[simp]
theorem QLocalSystem.fiberEquivFiber_eq_transport
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) :
    L.fiberEquivFiber r s = L.transport r s :=
  rfl

@[simp]
theorem QLocalSystem.transport_refl
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) (x : L.fiber r) :
    L.transport r r x = x := by
  simp [QLocalSystem.transport]

theorem QLocalSystem.transport_trans
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s t : RadialBase) (x : L.fiber r) :
    L.transport s t (L.transport r s x) = L.transport r t x := by
  simp [QLocalSystem.transport]

@[simp]
theorem QLocalSystem.transport_back
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) (x : L.fiber r) :
    L.transport s r (L.transport r s x) = x := by
  rw [L.transport_trans r s r x, L.transport_refl r x]

@[simp]
theorem QLocalSystem.transport_symm
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) :
    (L.transport r s).symm = L.transport s r := by
  ext x
  simp [QLocalSystem.transport]

/-- Flat global sections for the transport determined by the chosen
trivialization. -/
def QLocalSystem.flatSections
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) :
    Submodule ℂ ((r : RadialBase) → L.fiber r) where
  carrier := {σ | ∀ r s, L.transport r s (σ r) = σ s}
  zero_mem' := by
    intro r s
    simp
  add_mem' := by
    intro σ τ hσ hτ r s
    change L.transport r s (σ r + τ r) = σ s + τ s
    rw [map_add, hσ r s, hτ r s]
  smul_mem' := by
    intro c σ hσ r s
    change L.transport r s (c • σ r) = c • σ s
    rw [map_smul, hσ r s]

/-- Evaluation at any radius identifies one fiber with the full space of flat
sections. -/
def QLocalSystem.fiberEquivFlatSections
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r₀ : RadialBase) :
    L.fiber r₀ ≃ₗ[ℂ] L.flatSections where
  toFun x :=
    ⟨fun r => L.transport r₀ r x,
      fun r s => L.transport_trans r₀ r s x⟩
  invFun σ := σ.1 r₀
  left_inv x := L.transport_refl r₀ x
  right_inv σ := by
    apply Subtype.ext
    funext r
    exact σ.2 r₀ r
  map_add' x y := by
    apply Subtype.ext
    funext r
    exact (L.transport r₀ r).map_add x y
  map_smul' c x := by
    apply Subtype.ext
    funext r
    exact (L.transport r₀ r).map_smul c x

/-- Evaluation at a radius followed by the chosen trivialization identifies all
flat sections with the fixed model fiber. -/
def QLocalSystem.flatSectionsEquivModel
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) :
    L.flatSections ≃ₗ[ℂ] Model :=
  (L.fiberEquivFlatSections r).symm.trans (L.fiberEquivModel r)

/-- Conversely, a model vector determines its unique flat section. -/
def QLocalSystem.modelEquivFlatSections
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) :
    Model ≃ₗ[ℂ] L.flatSections :=
  (L.flatSectionsEquivModel r).symm

@[simp]
theorem QLocalSystem.flatSectionsEquivModel_apply
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase)
    (σ : L.flatSections) :
    L.flatSectionsEquivModel r σ = L.trivialization r (σ.1 r) :=
  rfl

/-- Under finite-dimensionality of the model, every kernel fiber has exactly the
model's finite rank.  No separate finite-dimensional instance on the fiber is
installed globally. -/
theorem QLocalSystem.finrank_fiber_eq_model
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    [FiniteDimensional ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) :
    Module.finrank ℂ (L.fiber r) = Module.finrank ℂ Model :=
  LinearEquiv.finrank_eq (L.fiberEquivModel r)

/-- Hence finite rank is constant from fiber to fiber. -/
theorem QLocalSystem.finrank_fiber_eq_fiber
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    [FiniteDimensional ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase) :
    Module.finrank ℂ (L.fiber r) = Module.finrank ℂ (L.fiber s) :=
  LinearEquiv.finrank_eq (L.fiberEquivFiber r s)

/-- The space of flat sections has the same finite rank as the model fiber. -/
theorem QLocalSystem.finrank_flatSections_eq_model
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    [FiniteDimensional ℂ Model]
    (L : QLocalSystem V Model) (r : RadialBase) :
    Module.finrank ℂ L.flatSections = Module.finrank ℂ Model :=
  LinearEquiv.finrank_eq (L.flatSectionsEquivModel r)

/-- A fixed operator gives a constant example of the abstract interface.  It does
not instantiate the paper's proposed radius-dependent differential operator. -/
def QLocalSystem.constant
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (H : V →ₗ[ℂ] V) : QLocalSystem V H.ker where
  operator := fun _ => H
  trivialization := fun _ => LinearEquiv.refl ℂ H.ker

/-- **Corrected Definition 11.** The duplicate definition is an alias of
Definition 9 rather than a second incompatible object. -/
abbrev QLocalSystemDef11 := QLocalSystem

/-! ## Definition 10: convergent inside, correction, and outside series -/

/-- A power series with an explicit domain and a named sum.  Fractional powers,
when desired, must be handled by a separately chosen branch in a prefactor. -/
structure ConvergentQSeries where
  coefficient : ℕ → ℂ
  prefactor : ℂ → ℂ
  domain : Set ℂ
  domain_open : IsOpen domain
  domain_nonempty : domain.Nonempty
  value : ℂ → ℂ
  prefactor_differentiable : DifferentiableOn ℂ prefactor domain
  value_differentiable : DifferentiableOn ℂ value domain
  hasSum : ∀ q ∈ domain,
    HasSum
      (fun n => prefactor q * coefficient n * q ^ n)
      (value q)

theorem ConvergentQSeries.summable
    (S : ConvergentQSeries) {q : ℂ} (hq : q ∈ S.domain) :
    Summable (fun n => S.prefactor q * S.coefficient n * q ^ n) :=
  (S.hasSum q hq).summable

@[simp]
theorem ConvergentQSeries.tsum_eq_value
    (S : ConvergentQSeries) {q : ℂ} (hq : q ∈ S.domain) :
    (∑' n, S.prefactor q * S.coefficient n * q ^ n) = S.value q :=
  (S.hasSum q hq).tsum_eq

/-- **Corrected Definition 10.** The outside series is a series in an independent
small variable `w`; setting `w = q⁻¹` belongs to a later continuation theorem. -/
structure InsideOutsideSeriesData where
  inside : ConvergentQSeries
  correction : ConvergentQSeries
  outside : ConvergentQSeries
  prototype : ℂ → ℂ

/-- Explicit data for a proved continuation overlap.  No common annulus or
canonicity is inferred merely from the three coefficient sequences. -/
structure InsideOutsideMatch (D : InsideOutsideSeriesData) where
  overlap : Set ℂ
  overlap_open : IsOpen overlap
  overlap_nonempty : overlap.Nonempty
  insideVariable : ℂ → ℂ
  outsideVariable : ℂ → ℂ
  continuation : ℂ → ℂ
  insideVariable_differentiable : DifferentiableOn ℂ insideVariable overlap
  outsideVariable_differentiable : DifferentiableOn ℂ outsideVariable overlap
  continuation_differentiable : DifferentiableOn ℂ continuation overlap
  prototype_differentiable : DifferentiableOn ℂ D.prototype overlap
  inside_mem : ∀ z ∈ overlap, insideVariable z ∈ D.inside.domain
  correction_mem : ∀ z ∈ overlap, insideVariable z ∈ D.correction.domain
  outside_mem : ∀ z ∈ overlap, outsideVariable z ∈ D.outside.domain
  variable_inverse : ∀ z ∈ overlap,
    insideVariable z * outsideVariable z = 1
  inside_eq_continuation : ∀ z ∈ overlap,
    D.inside.value (insideVariable z) = continuation z
  outside_eq_continuation : ∀ z ∈ overlap,
    D.outside.value (outsideVariable z) = continuation z
  continuation_formula : ∀ z ∈ overlap,
    continuation z =
      2 * D.prototype z - D.correction.value (insideVariable z)

theorem InsideOutsideMatch.inside_eq_outside
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    {z : ℂ} (hz : z ∈ M.overlap) :
    D.inside.value (M.insideVariable z) =
      D.outside.value (M.outsideVariable z) :=
  (M.inside_eq_continuation z hz).trans
    (M.outside_eq_continuation z hz).symm

theorem InsideOutsideMatch.inside_dictionary
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    {z : ℂ} (hz : z ∈ M.overlap) :
    D.inside.value (M.insideVariable z) =
      2 * D.prototype z - D.correction.value (M.insideVariable z) :=
  (M.inside_eq_continuation z hz).trans
    (M.continuation_formula z hz)

theorem InsideOutsideMatch.outside_dictionary
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    {z : ℂ} (hz : z ∈ M.overlap) :
    D.outside.value (M.outsideVariable z) =
      2 * D.prototype z - D.correction.value (M.insideVariable z) :=
  (M.outside_eq_continuation z hz).trans
    (M.continuation_formula z hz)

theorem InsideOutsideMatch.insideVariable_ne_zero
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    {z : ℂ} (hz : z ∈ M.overlap) : M.insideVariable z ≠ 0 := by
  intro hzero
  have h := M.variable_inverse z hz
  rw [hzero, zero_mul] at h
  exact zero_ne_one h

theorem InsideOutsideMatch.outsideVariable_ne_zero
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    {z : ℂ} (hz : z ∈ M.overlap) : M.outsideVariable z ≠ 0 := by
  intro hzero
  have h := M.variable_inverse z hz
  rw [hzero, mul_zero] at h
  exact zero_ne_one h

/-! ## Definition 12: tensor presheaf and sheafification interface -/

/-- A concrete model of a complex-linear presheaf on the category of open sets.
All section spaces live inside one ambient module, which keeps restriction maps
fully typed without pretending that arbitrary subsets are chart domains. -/
structure LinearPresheaf
    (X : Type*) [TopologicalSpace X]
    (E : Type*) [AddCommGroup E] [Module ℂ E] where
  «section» : TopologicalSpace.Opens X → Submodule ℂ E
  restrict : ∀ {U V : TopologicalSpace.Opens X},
    V ≤ U → «section» U →ₗ[ℂ] «section» V
  restrict_id : ∀ (U : TopologicalSpace.Opens X) (s : «section» U),
    restrict (le_refl U) s = s
  restrict_comp : ∀ {U V W : TopologicalSpace.Opens X}
    (hVU : V ≤ U) (hWV : W ≤ V) (s : «section» U),
    restrict hWV (restrict hVU s) = restrict (hWV.trans hVU) s

/-- Unique gluing for the concrete open-set presheaf model. -/
structure IsLinearSheaf
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (P : LinearPresheaf X E) : Prop where
  locality : ∀ {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s t : P.section U),
    (∀ i, P.restrict (hVU i) s = P.restrict (hVU i) t) → s = t
  gluing : ∀ {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, P.section (V i)),
    (∀ i j,
      P.restrict inf_le_left (s i) = P.restrict inf_le_right (s j)) →
    ∃ u : P.section U, ∀ i, P.restrict (hVU i) u = s i

/-- A natural transformation between concrete linear presheaves. -/
structure LinearPresheafMorphism
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (P : LinearPresheaf X E) (Q : LinearPresheaf X F) where
  app : (U : TopologicalSpace.Opens X) → P.section U →ₗ[ℂ] Q.section U
  naturality : ∀ {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (s : P.section U),
    Q.restrict hVU (app U s) = app V (P.restrict hVU s)

/-- Objectwise sections of the tensor presheaf.  General elements are finite sums
of pure tensors; they are not represented by pairs. -/
abbrev TensorPresheafSection
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    (U : TopologicalSpace.Opens X) : Type _ :=
  TensorProduct ℂ (L.section U) (M.section U)

/-- Restriction on the objectwise tensor presheaf. -/
def tensorPresheafRestrict
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    TensorPresheafSection L M U →ₗ[ℂ] TensorPresheafSection L M V :=
  TensorProduct.map (L.restrict hVU) (M.restrict hVU)

@[simp]
theorem tensorPresheafRestrict_tmul
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (u : L.section U) (m : M.section U) :
    tensorPresheafRestrict L M hVU (u ⊗ₜ[ℂ] m) =
      L.restrict hVU u ⊗ₜ[ℂ] M.restrict hVU m := by
  simp [tensorPresheafRestrict]

@[simp]
theorem tensorPresheafRestrict_id
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    (U : TopologicalSpace.Opens X)
    (s : TensorPresheafSection L M U) :
    tensorPresheafRestrict L M (le_refl U) s = s := by
  have hmap :
      tensorPresheafRestrict L M (le_refl U) = LinearMap.id := by
    apply TensorProduct.ext'
    intro u m
    simp [tensorPresheafRestrict, L.restrict_id, M.restrict_id]
  exact DFunLike.congr_fun hmap s

@[simp]
theorem tensorPresheafRestrict_comp
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    {U V W : TopologicalSpace.Opens X}
    (hVU : V ≤ U) (hWV : W ≤ V)
    (s : TensorPresheafSection L M U) :
    tensorPresheafRestrict L M hWV
        (tensorPresheafRestrict L M hVU s) =
      tensorPresheafRestrict L M (hWV.trans hVU) s := by
  have hmap :
      (tensorPresheafRestrict L M hWV).comp
          (tensorPresheafRestrict L M hVU) =
        tensorPresheafRestrict L M (hWV.trans hVU) := by
    apply TensorProduct.ext'
    intro u m
    simp [tensorPresheafRestrict, L.restrict_comp, M.restrict_comp]
  exact DFunLike.congr_fun hmap s

/-- A natural map from the objectwise tensor restriction system to a linear
presheaf. -/
structure TensorPresheafMorphism
    {X E F G : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    [AddCommGroup G] [Module ℂ G]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F)
    (P : LinearPresheaf X G) where
  app : (U : TopologicalSpace.Opens X) →
    TensorPresheafSection L M U →ₗ[ℂ] P.section U
  naturality : ∀ {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (s : TensorPresheafSection L M U),
    P.restrict hVU (app U s) =
      app V (tensorPresheafRestrict L M hVU s)

/-- **Corrected Definition 12.** A sheafification candidate together with the
universal factorization property within this concrete fixed-ambient category.  A
concrete development must construct an inhabitant for its actual local-system and
mock-data presheaves. -/
structure QGaugeVariableSheaf
    (X : Type uSheafX) (E : Type uSheafE)
    (F : Type uSheafF) (G : Type uSheafG) [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    [AddCommGroup G] [Module ℂ G]
    (L : LinearPresheaf X E) (M : LinearPresheaf X F) where
  sheaf : LinearPresheaf X G
  sheaf_condition : IsLinearSheaf sheaf
  «include» : TensorPresheafMorphism L M sheaf
  factor : ∀ {G' : Type uSheafG} [AddCommGroup G'] [Module ℂ G']
    (T : LinearPresheaf X G'), IsLinearSheaf T →
      TensorPresheafMorphism L M T → LinearPresheafMorphism sheaf T
  factor_include : ∀ {G' : Type uSheafG} [AddCommGroup G'] [Module ℂ G']
    (T : LinearPresheaf X G') (hT : IsLinearSheaf T)
    (f : TensorPresheafMorphism L M T)
    (U : TopologicalSpace.Opens X) (s : TensorPresheafSection L M U),
    (factor (G' := G') T hT f).app U («include».app U s) = f.app U s
  factor_unique : ∀ {G' : Type uSheafG} [AddCommGroup G'] [Module ℂ G']
    (T : LinearPresheaf X G') (hT : IsLinearSheaf T)
    (f : TensorPresheafMorphism L M T)
    (g : LinearPresheafMorphism sheaf T),
    (∀ (U : TopologicalSpace.Opens X) (s : TensorPresheafSection L M U),
      g.app U («include».app U s) = f.app U s) →
    g = factor (G' := G') T hT f

/-- The sheafification field is exposed in its standard existence-and-uniqueness
form. -/
theorem QGaugeVariableSheaf.factor_existsUnique
    {X : Type uSheafX} {E : Type uSheafE}
    {F : Type uSheafF} {G : Type uSheafG} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    [AddCommGroup G] [Module ℂ G]
    {L : LinearPresheaf X E}
    {M : LinearPresheaf X F}
    (S : QGaugeVariableSheaf X E F G L M)
    {G' : Type uSheafG} [AddCommGroup G'] [Module ℂ G']
    (T : LinearPresheaf X G')
    (hT : IsLinearSheaf T)
    (f : TensorPresheafMorphism L M T) :
    ∃! g : LinearPresheafMorphism S.sheaf T,
      ∀ (U : TopologicalSpace.Opens X)
        (s : TensorPresheafSection L M U),
        g.app U (S.include.app U s) = f.app U s := by
  refine ⟨S.factor (G' := G') T hT f, ?_, ?_⟩
  · intro U s
    exact S.factor_include T hT f U s
  · intro g hg
    exact S.factor_unique T hT f g hg

/-! ## Definition 13: algebraic radial connection interface -/

/-- The real radial coordinate has a canonical real logarithm, viewed in
`ℂ`; no multivalued complex logarithm is being chosen. -/
def radialLog (r : RadialBase) : ℂ :=
  (Real.log (r : ℝ) : ℂ)

@[simp]
theorem complex_exp_radialLog (r : RadialBase) :
    Complex.exp (radialLog r) = (r : ℂ) := by
  rw [radialLog, ← Complex.ofReal_exp, Real.exp_log r.property.1]

@[simp]
theorem radialLog_re (r : RadialBase) :
    (radialLog r).re = Real.log (r : ℝ) := by
  simp [radialLog]

@[simp]
theorem radialLog_im (r : RadialBase) :
    (radialLog r).im = 0 := by
  simp [radialLog]

theorem radialLog_re_neg (r : RadialBase) :
    (radialLog r).re < 0 := by
  simpa [radialLog] using
    Real.log_neg r.property.1 r.property.2

/-- A derivation on the algebra of radial scalar functions.  A concrete analytic
model should replace the full function algebra by its chosen smooth or Sobolev
subalgebra and prove closure there. -/
structure RadialDerivation where
  toLinearMap : (RadialBase → ℂ) →ₗ[ℂ] (RadialBase → ℂ)
  map_one : toLinearMap 1 = 0
  leibniz : ∀ (f g : RadialBase → ℂ),
    toLinearMap (f * g) = toLinearMap f * g + f * toLinearMap g

/-- Every lawful radial derivation kills constant functions. -/
theorem RadialDerivation.map_const
    (D : RadialDerivation) (c : ℂ) :
    D.toLinearMap (fun _ => c) = 0 := by
  calc
    D.toLinearMap (fun _ => c) =
        D.toLinearMap (c • (1 : RadialBase → ℂ)) := by
      congr 1
      funext r
      simp
    _ = c • D.toLinearMap 1 := D.toLinearMap.map_smul c 1
    _ = 0 := by rw [D.map_one]; simp

/-- An algebraic one-dimensional connection in a radial trivialization.  The
codomain is identified with one-forms by the selected basis `dr`. -/
structure AlgebraicRadialConnection
    (scalarDerivative : RadialDerivation)
    (M : Type*) [AddCommGroup M] [Module ℂ M] where
  nabla : (RadialBase → M) →ₗ[ℂ] (RadialBase → M)
  leibniz : ∀ (f : RadialBase → ℂ) (s : RadialBase → M),
    nabla (fun r => f r • s r) =
      fun r => scalarDerivative.toLinearMap f r • s r + f r • nabla s r

@[simp]
theorem AlgebraicRadialConnection.nabla_zero
    {M : Type*} [AddCommGroup M] [Module ℂ M]
    {D : RadialDerivation}
    (C : AlgebraicRadialConnection D M) :
    C.nabla 0 = 0 :=
  C.nabla.map_zero

/-- Constant scalars contribute no derivative term. -/
theorem AlgebraicRadialConnection.nabla_const_smul
    {M : Type*} [AddCommGroup M] [Module ℂ M]
    {D : RadialDerivation}
    (C : AlgebraicRadialConnection D M)
    (c : ℂ) (s : RadialBase → M) :
    C.nabla (fun r => c • s r) =
      fun r => c • C.nabla s r := by
  have h := C.leibniz (fun _ => c) s
  rw [D.map_const c] at h
  simpa using h

/-- Typed algebraic core of the proposed correction to Definition 13.  A tensor
connection must itself obey Leibniz and agree with both component connections on
pointwise pure tensors.  No finite-generation claim is made for all sections. -/
structure AlgebraicTensorRadialConnection
    {L M : Type*}
    [AddCommGroup L] [Module ℂ L]
    [AddCommGroup M] [Module ℂ M]
    (scalarDerivative : RadialDerivation)
    (nablaL : AlgebraicRadialConnection scalarDerivative L)
    (nablaM : AlgebraicRadialConnection scalarDerivative M) where
  connection :
    AlgebraicRadialConnection scalarDerivative (TensorProduct ℂ L M)
  pure_tensor_rule : ∀ (u : RadialBase → L) (m : RadialBase → M),
    connection.nabla (fun r => u r ⊗ₜ[ℂ] m r) =
      fun r => nablaL.nabla u r ⊗ₜ[ℂ] m r +
        u r ⊗ₜ[ℂ] nablaM.nabla m r

/-- The zero-order tensor sum associated to two linear endomorphisms.  This useful
algebraic leaf is deliberately not called a connection. -/
def tensorSumLinearEndomorphism
    {L M : Type*}
    [AddCommGroup L] [Module ℂ L]
    [AddCommGroup M] [Module ℂ M]
    (nablaL : L →ₗ[ℂ] L) (nablaM : M →ₗ[ℂ] M) :
    TensorProduct ℂ L M →ₗ[ℂ] TensorProduct ℂ L M :=
  TensorProduct.map nablaL LinearMap.id +
    TensorProduct.map LinearMap.id nablaM

@[simp]
theorem tensorSumLinearEndomorphism_tmul
    {L M : Type*}
    [AddCommGroup L] [Module ℂ L]
    [AddCommGroup M] [Module ℂ M]
    (nablaL : L →ₗ[ℂ] L) (nablaM : M →ₗ[ℂ] M)
    (u : L) (m : M) :
    tensorSumLinearEndomorphism nablaL nablaM (u ⊗ₜ[ℂ] m) =
      nablaL u ⊗ₜ[ℂ] m + u ⊗ₜ[ℂ] nablaM m := by
  simp [tensorSumLinearEndomorphism]

/-! ## Definition 14: balanced equalizer -/

/-- The equalizer of two linear maps at one open set. -/
def balancedEqualizerAt
    {A B : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    (resIn resOut : A →ₗ[ℂ] B) : Submodule ℂ A :=
  (resIn - resOut).ker

@[simp]
theorem mem_balancedEqualizerAt_iff
    {A B : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    (resIn resOut : A →ₗ[ℂ] B) (a : A) :
    a ∈ balancedEqualizerAt resIn resOut ↔ resIn a = resOut a := by
  change resIn a - resOut a = 0 ↔ resIn a = resOut a
  exact sub_eq_zero

/-- The canonical inclusion of the linear equalizer. -/
def balancedEqualizerInclusion
    {A B : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    (resIn resOut : A →ₗ[ℂ] B) :
    balancedEqualizerAt resIn resOut →ₗ[ℂ] A :=
  (balancedEqualizerAt resIn resOut).subtype

theorem balancedEqualizerInclusion_condition
    {A B : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    (resIn resOut : A →ₗ[ℂ] B) :
    resIn.comp (balancedEqualizerInclusion resIn resOut) =
      resOut.comp (balancedEqualizerInclusion resIn resOut) := by
  apply LinearMap.ext
  intro s
  exact (mem_balancedEqualizerAt_iff _ _ _).1 s.property

/-- Every map equalized by `resIn` and `resOut` factors through the balanced
equalizer. -/
def balancedEqualizerLift
    {A B Z : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    [AddCommGroup Z] [Module ℂ Z]
    (resIn resOut : A →ₗ[ℂ] B)
    (f : Z →ₗ[ℂ] A)
    (h : resIn.comp f = resOut.comp f) :
    Z →ₗ[ℂ] balancedEqualizerAt resIn resOut where
  toFun z :=
    ⟨f z, (mem_balancedEqualizerAt_iff _ _ _).2 (by
      have hz := congrArg (fun k : Z →ₗ[ℂ] B => k z) h
      simpa only [LinearMap.comp_apply] using hz)⟩
  map_add' x y := by
    apply Subtype.ext
    exact f.map_add x y
  map_smul' c x := by
    apply Subtype.ext
    exact f.map_smul c x

@[simp]
theorem balancedEqualizerInclusion_comp_lift
    {A B Z : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    [AddCommGroup Z] [Module ℂ Z]
    (resIn resOut : A →ₗ[ℂ] B)
    (f : Z →ₗ[ℂ] A)
    (h : resIn.comp f = resOut.comp f) :
    (balancedEqualizerInclusion resIn resOut).comp
        (balancedEqualizerLift resIn resOut f h) = f := by
  apply LinearMap.ext
  intro z
  rfl

theorem balancedEqualizerLift_unique
    {A B Z : Type*}
    [AddCommGroup A] [Module ℂ A]
    [AddCommGroup B] [Module ℂ B]
    [AddCommGroup Z] [Module ℂ Z]
    (resIn resOut : A →ₗ[ℂ] B)
    (f : Z →ₗ[ℂ] A)
    (h : resIn.comp f = resOut.comp f)
    (g : Z →ₗ[ℂ] balancedEqualizerAt resIn resOut)
    (hg : (balancedEqualizerInclusion resIn resOut).comp g = f) :
    g = balancedEqualizerLift resIn resOut f h := by
  apply LinearMap.ext
  intro z
  apply Subtype.ext
  have hz := congrArg (fun k : Z →ₗ[ℂ] A => k z) hg
  change (g z : A) = f z at hz
  exact hz

/-- The objectwise component of the proposed correction to Definition 14: the
equalizer of two presheaf morphisms on an open set.  Naturality below proves that
restrictions preserve this submodule; a concrete equalizer-sheaf package remains a
model-level construction. -/
def balancedPresheafSection
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (U : TopologicalSpace.Opens X) : Submodule ℂ (P.section U) :=
  balancedEqualizerAt (resIn.app U) (resOut.app U)

theorem balancedPresheafSection_restrict
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (s : balancedPresheafSection resIn resOut U) :
    P.restrict hVU (s : P.section U) ∈
      balancedPresheafSection resIn resOut V := by
  apply (mem_balancedEqualizerAt_iff _ _ _).2
  have hs : resIn.app U (s : P.section U) =
      resOut.app U (s : P.section U) :=
    (mem_balancedEqualizerAt_iff _ _ _).1 s.property
  rw [← resIn.naturality hVU, ← resOut.naturality hVU, hs]

/-- Restriction as a genuine linear map between balanced-section spaces. -/
def balancedPresheafRestrict
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    balancedPresheafSection resIn resOut U →ₗ[ℂ]
      balancedPresheafSection resIn resOut V where
  toFun s :=
    ⟨P.restrict hVU (s : P.section U),
      balancedPresheafSection_restrict resIn resOut hVU s⟩
  map_add' s t := by
    apply Subtype.ext
    simpa using
      (P.restrict hVU).map_add
        (s : P.section U) (t : P.section U)
  map_smul' c s := by
    apply Subtype.ext
    simpa using
      (P.restrict hVU).map_smul c (s : P.section U)

@[simp]
theorem coe_balancedPresheafRestrict
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (s : balancedPresheafSection resIn resOut U) :
    ((balancedPresheafRestrict resIn resOut hVU s :
        balancedPresheafSection resIn resOut V) : P.section V) =
      P.restrict hVU (s : P.section U) :=
  rfl

@[simp]
theorem balancedPresheafRestrict_id
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (U : TopologicalSpace.Opens X)
    (s : balancedPresheafSection resIn resOut U) :
    balancedPresheafRestrict resIn resOut (le_refl U) s = s := by
  apply Subtype.ext
  change P.restrict (le_refl U) (s : P.section U) =
    (s : P.section U)
  exact P.restrict_id U (s : P.section U)

@[simp]
theorem balancedPresheafRestrict_comp
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    {U V W : TopologicalSpace.Opens X}
    (hVU : V ≤ U) (hWV : W ≤ V)
    (s : balancedPresheafSection resIn resOut U) :
    balancedPresheafRestrict resIn resOut hWV
        (balancedPresheafRestrict resIn resOut hVU s) =
      balancedPresheafRestrict resIn resOut
        (hWV.trans hVU) s := by
  apply Subtype.ext
  change
    P.restrict hWV (P.restrict hVU (s : P.section U)) =
      P.restrict (hWV.trans hVU) (s : P.section U)
  exact P.restrict_comp hVU hWV (s : P.section U)

/-- Locality for the objectwise equalizer.  Equality of balanced sections is
detected in the source sheaf because the equalizer inclusion is injective. -/
theorem balancedPresheafSection_locality
    {X : Type uSheafX} {E : Type uSheafE} {F : Type uSheafF}
    [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (hP : IsLinearSheaf P)
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s t : balancedPresheafSection resIn resOut U)
    (hlocal : ∀ i,
      balancedPresheafRestrict resIn resOut (hVU i) s =
        balancedPresheafRestrict resIn resOut (hVU i) t) :
    s = t := by
  apply Subtype.ext
  apply hP.locality (ι := ι) (U := U) V hVU hcover
  intro i
  exact congrArg Subtype.val (hlocal i)

/-- Compatible balanced local sections glue to a balanced global section.  The
source sheaf supplies the underlying glued section.  Naturality makes the two
images locally equal, and locality in the target sheaf promotes that equality
to the whole open set. -/
theorem balancedPresheafSection_gluing
    {X : Type uSheafX} {E : Type uSheafE} {F : Type uSheafF}
    [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (hP : IsLinearSheaf P) (hQ : IsLinearSheaf Q)
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, balancedPresheafSection resIn resOut (V i))
    (hcompat : ∀ i j,
      balancedPresheafRestrict resIn resOut inf_le_left (s i) =
        balancedPresheafRestrict resIn resOut inf_le_right (s j)) :
    ∃ u : balancedPresheafSection resIn resOut U,
      ∀ i, balancedPresheafRestrict resIn resOut (hVU i) u = s i := by
  have hcompatP : ∀ i j,
      P.restrict inf_le_left (s i : P.section (V i)) =
        P.restrict inf_le_right (s j : P.section (V j)) := by
    intro i j
    exact congrArg Subtype.val (hcompat i j)
  obtain ⟨u, hu⟩ := hP.gluing (ι := ι) (U := U) V hVU hcover
    (fun i => (s i : P.section (V i))) hcompatP
  have huBalanced :
      resIn.app U u = resOut.app U u := by
    apply hQ.locality V hVU hcover
    intro i
    rw [resIn.naturality (hVU i) u, resOut.naturality (hVU i) u, hu i]
    exact (mem_balancedEqualizerAt_iff _ _ _).1 (s i).property
  let uBalanced : balancedPresheafSection resIn resOut U :=
    ⟨u, (mem_balancedEqualizerAt_iff _ _ _).2 huBalanced⟩
  refine ⟨uBalanced, ?_⟩
  intro i
  apply Subtype.ext
  exact hu i

/-- The equalizer gluing furnished above is unique.  This is the usual sheaf
equalizer theorem, stated directly for the nested submodule section type so no
ambient-section coercion or noncanonical choice is hidden in the construction. -/
theorem balancedPresheafSection_existsUnique_gluing
    {X : Type uSheafX} {E : Type uSheafE} {F : Type uSheafF}
    [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (hP : IsLinearSheaf P) (hQ : IsLinearSheaf Q)
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, balancedPresheafSection resIn resOut (V i))
    (hcompat : ∀ i j,
      balancedPresheafRestrict resIn resOut inf_le_left (s i) =
        balancedPresheafRestrict resIn resOut inf_le_right (s j)) :
    ∃! u : balancedPresheafSection resIn resOut U,
      ∀ i, balancedPresheafRestrict resIn resOut (hVU i) u = s i := by
  obtain ⟨u, hu⟩ := balancedPresheafSection_gluing
    resIn resOut hP hQ V hVU hcover s hcompat
  refine ⟨u, hu, ?_⟩
  intro t ht
  exact balancedPresheafSection_locality
    resIn resOut hP V hVU hcover t u (fun i => (ht i).trans (hu i).symm)

/-- Sheaf certificate for the balanced equalizer restriction system.  It uses
the same locality and compatible-gluing interface as `IsLinearSheaf`, specialized
to the canonical nested equalizer submodules. -/
structure IsBalancedPresheafSheaf
    {X : Type uSheafX} {E : Type uSheafE} {F : Type uSheafF} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q) : Prop where
  locality : ∀ {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s t : balancedPresheafSection resIn resOut U),
    (∀ i,
      balancedPresheafRestrict resIn resOut (hVU i) s =
        balancedPresheafRestrict resIn resOut (hVU i) t) → s = t
  gluing : ∀ {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, balancedPresheafSection resIn resOut (V i)),
    (∀ i j,
      balancedPresheafRestrict resIn resOut inf_le_left (s i) =
        balancedPresheafRestrict resIn resOut inf_le_right (s j)) →
    ∃ u : balancedPresheafSection resIn resOut U,
      ∀ i, balancedPresheafRestrict resIn resOut (hVU i) u = s i

/-- Equalizers of two morphisms between linear sheaves are linear sheaves. -/
theorem balancedPresheaf_isSheaf
    {X E F : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
    (resIn resOut : LinearPresheafMorphism P Q)
    (hP : IsLinearSheaf P) (hQ : IsLinearSheaf Q) :
    IsBalancedPresheafSheaf resIn resOut where
  locality := balancedPresheafSection_locality resIn resOut hP
  gluing := balancedPresheafSection_gluing resIn resOut hP hQ

/-! ## Definition 15: endomorphism-valued gauge descent -/

/-- The algebraic type of an endomorphism-valued one-form in a fixed local
trivialization.  Smooth bundle sections supply this type pointwise. -/
abbrev EndValuedOneForm
    (Tangent Fiber : Type*)
    [AddCommGroup Tangent] [Module ℂ Tangent]
    [AddCommGroup Fiber] [Module ℂ Fiber] : Type _ :=
  Tangent →ₗ[ℂ] (Fiber →ₗ[ℂ] Fiber)

/-- Deck pullback and bundle-transition actions on an ambient module of
endomorphism-valued one-forms.  `transition` should be conjugation by the bundle
transition function, not scalar multiplication by a half-weight factor. -/
structure GaugeDescentAction
    (EndValuedOneForm : Type*)
    [AddCommGroup EndValuedOneForm] [Module ℂ EndValuedOneForm] where
  pullback : Gamma2Element →
    EndValuedOneForm →ₗ[ℂ] EndValuedOneForm
  transition : Gamma2Element →
    EndValuedOneForm →ₗ[ℂ] EndValuedOneForm
  pullback_one : ∀ A, pullback 1 A = A
  pullback_mul : ∀ γ δ A,
    pullback (γ * δ) A = pullback δ (pullback γ A)
  transition_one : ∀ A, transition 1 A = A
  transition_mul : ∀ γ δ A,
    transition (γ * δ) A = transition δ (transition γ A)

/-- Correct covariance condition for a lifted bundle-valued form. -/
def IsGaugeCovariant
    {EndValuedOneForm : Type*}
    [AddCommGroup EndValuedOneForm] [Module ℂ EndValuedOneForm]
    (D : GaugeDescentAction EndValuedOneForm)
    (A : EndValuedOneForm) : Prop :=
  ∀ γ, D.pullback γ A = D.transition γ A

/-- **Corrected Definition 15.** Covariant endomorphism-valued one-forms form a
complex submodule. -/
def qGaugeForms
    {EndValuedOneForm : Type*}
    [AddCommGroup EndValuedOneForm] [Module ℂ EndValuedOneForm]
    (D : GaugeDescentAction EndValuedOneForm) :
    Submodule ℂ EndValuedOneForm where
  carrier := {A | IsGaugeCovariant D A}
  zero_mem' := by
    intro γ
    simp [IsGaugeCovariant]
  add_mem' := by
    intro A B hA hB γ
    simp only [map_add]
    rw [hA γ, hB γ]
  smul_mem' := by
    intro c A hA γ
    simp only [map_smul]
    rw [hA γ]

/-- Pullback by a deck transformation is a linear equivalence; its inverse is
pullback by the inverse deck transformation. -/
def GaugeDescentAction.pullbackEquiv
    {E : Type*} [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentAction E) (γ : Gamma2Element) :
    E ≃ₗ[ℂ] E where
  toLinearMap := D.pullback γ
  invFun := D.pullback γ⁻¹
  left_inv A := by
    calc
      D.pullback γ⁻¹ (D.pullback γ A) =
          D.pullback (γ * γ⁻¹) A :=
        (D.pullback_mul γ γ⁻¹ A).symm
      _ = A := by simp [D.pullback_one]
  right_inv A := by
    calc
      D.pullback γ (D.pullback γ⁻¹ A) =
          D.pullback (γ⁻¹ * γ) A :=
        (D.pullback_mul γ⁻¹ γ A).symm
      _ = A := by simp [D.pullback_one]

/-- The transition action is likewise a linear equivalence. -/
def GaugeDescentAction.transitionEquiv
    {E : Type*} [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentAction E) (γ : Gamma2Element) :
    E ≃ₗ[ℂ] E where
  toLinearMap := D.transition γ
  invFun := D.transition γ⁻¹
  left_inv A := by
    calc
      D.transition γ⁻¹ (D.transition γ A) =
          D.transition (γ * γ⁻¹) A :=
        (D.transition_mul γ γ⁻¹ A).symm
      _ = A := by simp [D.transition_one]
  right_inv A := by
    calc
      D.transition γ (D.transition γ⁻¹ A) =
          D.transition (γ⁻¹ * γ) A :=
        (D.transition_mul γ⁻¹ γ A).symm
      _ = A := by simp [D.transition_one]

/-- Covariant forms are precisely the intersection of the kernels of all
pullback-minus-transition maps. -/
theorem qGaugeForms_eq_iInf_ker
    {E : Type*} [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentAction E) :
    qGaugeForms D =
      ⨅ γ : Gamma2Element, (D.pullback γ - D.transition γ).ker := by
  ext A
  simp [qGaugeForms, IsGaugeCovariant, sub_eq_zero]

/-- A map such as restriction that commutes with both descent actions. -/
structure GaugeDescentMorphism
    {E F : Type*}
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (D : GaugeDescentAction E) (D' : GaugeDescentAction F) where
  map : E →ₗ[ℂ] F
  pullback_comm : ∀ γ A,
    D'.pullback γ (map A) = map (D.pullback γ A)
  transition_comm : ∀ γ A,
    D'.transition γ (map A) = map (D.transition γ A)

theorem GaugeDescentMorphism.map_mem_qGaugeForms
    {E F : Type*}
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {D : GaugeDescentAction E} {D' : GaugeDescentAction F}
    (f : GaugeDescentMorphism D D') {A : E}
    (hA : A ∈ qGaugeForms D) :
    f.map A ∈ qGaugeForms D' := by
  intro γ
  rw [f.pullback_comm, hA γ, ← f.transition_comm]

/-- Open-set indexed gauge descent with restrictions commuting with both lawful
actions.  In a concrete bundle model, `transition` must additionally be proved to
be conjugation by the transition cocycle. -/
structure GaugeDescentSheaf
    (X : Type uSheafX) (E : Type uSheafE) [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E] where
  forms : LinearPresheaf X E
  sheaf_condition : IsLinearSheaf (X := X) (E := E) forms
  action : (U : TopologicalSpace.Opens X) →
    GaugeDescentAction (forms.section U)
  restriction : ∀ {U V : TopologicalSpace.Opens X} (hVU : V ≤ U),
    GaugeDescentMorphism (action U) (action V)
  restriction_eq : ∀ {U V : TopologicalSpace.Opens X} (hVU : V ≤ U),
    (restriction hVU).map = forms.restrict hVU

/-- Covariant gluing is a theorem: it follows from ordinary sheaf gluing and
the fact that restrictions commute with both descent actions. -/
theorem GaugeDescentSheaf.covariant_gluing
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, qGaugeForms (D.action (V i)))
    (hcompat : ∀ i j,
      D.forms.restrict inf_le_left
          (s i : D.forms.section (V i)) =
        D.forms.restrict inf_le_right
          (s j : D.forms.section (V j))) :
    ∃ u : qGaugeForms (D.action U), ∀ i,
      D.forms.restrict (hVU i)
          (u : D.forms.section U) =
        (s i : D.forms.section (V i)) := by
  rcases D.sheaf_condition.gluing V hVU hcover
      (fun i => (s i : D.forms.section (V i))) hcompat with
    ⟨u, hu⟩
  have hcov : u ∈ qGaugeForms (D.action U) := by
    intro γ
    apply D.sheaf_condition.locality V hVU hcover
    intro i
    calc
      D.forms.restrict (hVU i)
          ((D.action U).pullback γ u) =
          (D.restriction (hVU i)).map
            ((D.action U).pullback γ u) := by
        rw [D.restriction_eq (hVU i)]
      _ =
          (D.action (V i)).pullback γ
            ((D.restriction (hVU i)).map u) :=
        ((D.restriction (hVU i)).pullback_comm γ u).symm
      _ =
          (D.action (V i)).pullback γ
            (D.forms.restrict (hVU i) u) := by
        rw [D.restriction_eq (hVU i)]
      _ =
          (D.action (V i)).pullback γ
            (s i : D.forms.section (V i)) := by
        rw [hu i]
      _ =
          (D.action (V i)).transition γ
            (s i : D.forms.section (V i)) :=
        (s i).property γ
      _ =
          (D.action (V i)).transition γ
            (D.forms.restrict (hVU i) u) := by
        rw [hu i]
      _ =
          (D.action (V i)).transition γ
            ((D.restriction (hVU i)).map u) := by
        rw [D.restriction_eq (hVU i)]
      _ =
          (D.restriction (hVU i)).map
            ((D.action U).transition γ u) :=
        (D.restriction (hVU i)).transition_comm γ u
      _ =
          D.forms.restrict (hVU i)
            ((D.action U).transition γ u) := by
        rw [D.restriction_eq (hVU i)]
  refine ⟨⟨u, hcov⟩, ?_⟩
  intro i
  simpa using hu i

/-- Covariant gluing is unique because the underlying sheaf gluing is unique. -/
theorem GaugeDescentSheaf.covariant_gluing_existsUnique
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, qGaugeForms (D.action (V i)))
    (hcompat : ∀ i j,
      D.forms.restrict inf_le_left
          (s i : D.forms.section (V i)) =
        D.forms.restrict inf_le_right
          (s j : D.forms.section (V j))) :
    ∃! u : qGaugeForms (D.action U), ∀ i,
      D.forms.restrict (hVU i)
          (u : D.forms.section U) =
        (s i : D.forms.section (V i)) := by
  rcases D.covariant_gluing V hVU hcover s hcompat with
    ⟨u, hu⟩
  refine ⟨u, hu, ?_⟩
  intro v hv
  apply Subtype.ext
  apply D.sheaf_condition.locality V hVU hcover
  intro i
  exact (hv i).trans (hu i).symm

theorem GaugeDescentSheaf.restrict_mem_qGaugeForms
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (A : qGaugeForms (D.action U)) :
    D.forms.restrict hVU (A : D.forms.section U) ∈
      qGaugeForms (D.action V) := by
  rw [← D.restriction_eq hVU]
  exact (D.restriction hVU).map_mem_qGaugeForms A.property

/-! ### A concrete trivial-bundle section sheaf -/

namespace TrivialBundleSectionSheaf

variable {X : Type uSheafX} {Fiber : Type uSheafE} [TopologicalSpace X]
  [AddCommGroup Fiber] [Module ℂ Fiber]

/-- Set-theoretic sections of the trivial bundle over `U`, represented by global
functions extended by zero outside `U`.  Smoothness is a separate refinement. -/
def sections (U : TopologicalSpace.Opens X) :
    Submodule ℂ (X → Fiber) where
  carrier := {f | ∀ x, x ∉ U → f x = 0}
  zero_mem' := by
    intro x hx
    rfl
  add_mem' := by
    intro f g hf hg x hx
    simp [hf x hx, hg x hx]
  smul_mem' := by
    intro c f hf x hx
    simp [hf x hx]

/-- Restriction is pointwise cutoff to the smaller open set. -/
noncomputable def restrict {U V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    sections (X := X) (Fiber := Fiber) U →ₗ[ℂ]
      sections (X := X) (Fiber := Fiber) V := by
  classical
  refine
    { toFun := fun f =>
        ⟨fun x => if x ∈ V then (f : X → Fiber) x else 0,
          by
            intro x hx
            simp [hx]⟩
      map_add' := ?_
      map_smul' := ?_ }
  · intro f g
    apply Subtype.ext
    funext x
    by_cases hx : x ∈ V <;> simp [hx]
  · intro c f
    apply Subtype.ext
    funext x
    by_cases hx : x ∈ V <;> simp [hx]

local instance instDecidableMemOpens
    (x : X) (U : TopologicalSpace.Opens X) : Decidable (x ∈ U) :=
  Classical.propDecidable _

@[simp]
theorem restrict_apply
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (f : sections (X := X) (Fiber := Fiber) U) (x : X) :
    ((TrivialBundleSectionSheaf.restrict (X := X) (Fiber := Fiber) hVU f :
        sections (X := X) (Fiber := Fiber) V) : X → Fiber) x =
      if x ∈ V then (f : X → Fiber) x else 0 := by
  classical
  rfl

/-- Zero extension loses no local data: supported global representatives are
linearly equivalent to arbitrary functions on the open subtype. -/
noncomputable def sectionsEquivLocalFunctions
    (U : TopologicalSpace.Opens X) :
    sections (X := X) (Fiber := Fiber) U ≃ₗ[ℂ] (U → Fiber) := by
  classical
  refine
    { toFun := fun f x => (f : X → Fiber) x.1
      invFun := fun g =>
        ⟨fun x => if hx : x ∈ U then g ⟨x, hx⟩ else 0,
          by
            intro x hx
            simp [hx]⟩
      left_inv := by
        intro f
        apply Subtype.ext
        funext x
        by_cases hx : x ∈ U
        · simp [hx]
        · simp [hx, f.property x hx]
      right_inv := by
        intro g
        funext x
        simp [x.property]
      map_add' := by
        intro f g
        funext x
        rfl
      map_smul' := by
        intro c f
        funext x
        rfl }

/-- The concrete zero-extended trivial-bundle presheaf. -/
noncomputable def presheaf : LinearPresheaf X (X → Fiber) where
  «section» := sections (X := X) (Fiber := Fiber)
  restrict := fun {_ _} h =>
    TrivialBundleSectionSheaf.restrict (X := X) (Fiber := Fiber) h
  restrict_id := by
    intro U s
    apply Subtype.ext
    funext x
    by_cases hx : x ∈ U
    · simp [restrict, hx]
    · simp [restrict, hx, s.property x hx]
  restrict_comp := by
    intro U V W hVU hWV s
    apply Subtype.ext
    funext x
    by_cases hx : x ∈ W
    · have hxV : x ∈ V := hWV hx
      simp [restrict, hx, hxV]
    · simp [restrict, hx]

/-- Direct locality and gluing proof for the concrete trivial-bundle sections;
no sheaf law is passed as an input. -/
theorem isLinearSheaf :
    IsLinearSheaf (presheaf (X := X) (Fiber := Fiber)) where
  locality := by
    classical
    intro ι U V hVU hcover s t hlocal
    apply Subtype.ext
    funext x
    by_cases hxU : x ∈ U
    · obtain ⟨i, hxi⟩ :=
        TopologicalSpace.Opens.mem_iSup.mp (hcover hxU)
      have hvalue := congrArg
        (fun q : sections (V i) => (q : X → Fiber) x) (hlocal i)
      change
        (if x ∈ V i then (s : X → Fiber) x else 0) =
          (if x ∈ V i then (t : X → Fiber) x else 0) at hvalue
      simpa only [hxi, if_pos] using hvalue
    · exact (s.property x hxU).trans (t.property x hxU).symm
  gluing := by
    classical
    intro ι U V hVU hcover s hcompat
    change (i : ι) → sections (X := X) (Fiber := Fiber) (V i) at s
    choose index hindex using fun x : U =>
      TopologicalSpace.Opens.mem_iSup.mp (hcover x.property)
    let glued : X → Fiber := fun x =>
      if hx : x ∈ U then
        (s (index ⟨x, hx⟩) : X → Fiber) x
      else 0
    have hglued : glued ∈ sections U := by
      intro x hx
      simp [glued, hx]
    refine ⟨⟨glued, hglued⟩, ?_⟩
    intro i
    apply Subtype.ext
    funext x
    by_cases hxi : x ∈ V i
    · have hxU : x ∈ U := hVU i hxi
      let j : ι := index ⟨x, hxU⟩
      have hxj : x ∈ V j := by
        dsimp [j]
        exact hindex ⟨x, hxU⟩
      have hvalue := congrArg
        (fun q : sections (V j ⊓ V i) => (q : X → Fiber) x)
        (hcompat j i)
      have hji :
          (s j : X → Fiber) x = (s i : X → Fiber) x := by
        change
          ((TrivialBundleSectionSheaf.restrict
              (X := X) (Fiber := Fiber) inf_le_left (s j) :
              sections (X := X) (Fiber := Fiber) (V j ⊓ V i)) : X → Fiber) x =
            ((TrivialBundleSectionSheaf.restrict
              (X := X) (Fiber := Fiber) inf_le_right (s i) :
              sections (X := X) (Fiber := Fiber) (V j ⊓ V i)) : X → Fiber) x
          at hvalue
        rw [restrict_apply, restrict_apply] at hvalue
        simpa [hxj, hxi] using hvalue
      change
        (if x ∈ V i then glued x else 0) = (s i : X → Fiber) x
      simp only [hxi, if_pos, glued, hxU, j]
      exact hji
    · have hz : (s i : X → Fiber) x = 0 :=
        (s i).property x hxi
      change
        (if x ∈ V i then glued x else 0) = (s i : X → Fiber) x
      simpa only [hxi, if_false] using hz.symm

/-- Trivial descent acts identically on every concrete section space. -/
def trivialAction (U : TopologicalSpace.Opens X) :
    GaugeDescentAction (sections (X := X) (Fiber := Fiber) U) where
  pullback := fun _ => LinearMap.id
  transition := fun _ => LinearMap.id
  pullback_one := by
    intro A
    rfl
  pullback_mul := by
    intro γ δ A
    rfl
  transition_one := by
    intro A
    rfl
  transition_mul := by
    intro γ δ A
    rfl

/-- Concrete restriction commutes with the trivial descent action. -/
def restrictionMorphism
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    GaugeDescentMorphism
      (trivialAction (X := X) (Fiber := Fiber) U)
      (trivialAction (X := X) (Fiber := Fiber) V) where
  map := restrict hVU
  pullback_comm := by
    intro γ A
    rfl
  transition_comm := by
    intro γ A
    rfl

/-- A concrete gauge-descent sheaf on the trivial bundle. -/
def gaugeSheaf : GaugeDescentSheaf X (X → Fiber) where
  forms := presheaf
  sheaf_condition := isLinearSheaf
  action := trivialAction
  restriction := restrictionMorphism
  restriction_eq := by
    intro U V hVU
    rfl

@[simp]
theorem qGaugeForms_trivialAction (U : TopologicalSpace.Opens X) :
    qGaugeForms (trivialAction (X := X) (Fiber := Fiber) U) = ⊤ := by
  apply le_antisymm le_top
  intro s hs γ
  rfl

/-- Concrete specialization of Proposition 16. -/
theorem concrete_covariant_gluing_existsUnique
    {ι : Type uSheafX} {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i)
    (s : ∀ i, qGaugeForms
      ((gaugeSheaf (X := X) (Fiber := Fiber)).action (V i)))
    (hcompat : ∀ i j,
      (gaugeSheaf (X := X) (Fiber := Fiber)).forms.restrict inf_le_left
          (s i : (gaugeSheaf
            (X := X) (Fiber := Fiber)).forms.section (V i)) =
      (gaugeSheaf (X := X) (Fiber := Fiber)).forms.restrict inf_le_right
          (s j : (gaugeSheaf
            (X := X) (Fiber := Fiber)).forms.section (V j))) :
    ∃! u : qGaugeForms
        ((gaugeSheaf (X := X) (Fiber := Fiber)).action U),
      ∀ i,
        (gaugeSheaf (X := X) (Fiber := Fiber)).forms.restrict (hVU i)
            (u : (gaugeSheaf
              (X := X) (Fiber := Fiber)).forms.section U) =
          (s i : (gaugeSheaf
            (X := X) (Fiber := Fiber)).forms.section (V i)) :=
  (gaugeSheaf (X := X) (Fiber := Fiber)).covariant_gluing_existsUnique
    V hVU hcover s hcompat

end TrivialBundleSectionSheaf

/-! ## Definitions 16 and 17: typed connection and curvature -/

/-- The minimal two-step calculus needed to type `d A + A wedge A`.

The two summands now live in the same `TwoForm` type.  A concrete bundle model
must instantiate these with endomorphism- or adjoint-bundle-valued forms. -/
structure CurvatureCalculus
    (OneForm TwoForm : Type*)
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm] where
  backgroundCurvature : TwoForm
  d : OneForm →ₗ[ℂ] TwoForm
  wedge : OneForm →ₗ[ℂ] OneForm →ₗ[ℂ] TwoForm

/-- The affine coordinate of a local connection relative to a fixed background
connection.  It is deliberately called a perturbation, not a connection object. -/
abbrev ConnectionPerturbation (OneForm : Type*) := OneForm

/-- Curvature in the selected two-step calculus. -/
def curvature
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) (A : OneForm) : TwoForm :=
  C.backgroundCurvature + C.d A + C.wedge A A

@[simp]
theorem curvature_zero
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) :
    curvature C 0 = C.backgroundCurvature := by
  simp [curvature]

theorem curvature_add_expansion
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) (A B : OneForm) :
    curvature C (A + B) =
      C.backgroundCurvature + (C.d A + C.d B) +
        ((C.wedge A A + C.wedge A B) +
          (C.wedge B A + C.wedge B B)) := by
  simp [curvature]

theorem curvature_neg_expansion
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) (A : OneForm) :
    curvature C (-A) =
      C.backgroundCurvature - C.d A + C.wedge A A := by
  simp [curvature, sub_eq_add_neg]

theorem curvature_smul_expansion
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) (c : ℂ) (A : OneForm) :
    curvature C (c • A) =
      C.backgroundCurvature + c • C.d A +
        (c * c) • C.wedge A A := by
  simp [curvature, smul_smul]

/-- **Corrected Definitions 16 and 17.** The duplicate paper definition is the
same typed curvature construction, including the background curvature term. -/
def qCurvature
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm)
    (A : ConnectionPerturbation OneForm) : TwoForm :=
  curvature C A

/-- A restriction map compatible with exterior differentiation and wedge product. -/
structure CurvatureMorphism
    {OneForm₁ TwoForm₁ OneForm₂ TwoForm₂ : Type*}
    [AddCommGroup OneForm₁] [Module ℂ OneForm₁]
    [AddCommGroup TwoForm₁] [Module ℂ TwoForm₁]
    [AddCommGroup OneForm₂] [Module ℂ OneForm₂]
    [AddCommGroup TwoForm₂] [Module ℂ TwoForm₂]
    (C₁ : CurvatureCalculus OneForm₁ TwoForm₁)
    (C₂ : CurvatureCalculus OneForm₂ TwoForm₂) where
  mapOne : OneForm₁ →ₗ[ℂ] OneForm₂
  mapTwo : TwoForm₁ →ₗ[ℂ] TwoForm₂
  background_comm : mapTwo C₁.backgroundCurvature = C₂.backgroundCurvature
  d_comm : ∀ A, mapTwo (C₁.d A) = C₂.d (mapOne A)
  wedge_comm : ∀ A B,
    mapTwo (C₁.wedge A B) = C₂.wedge (mapOne A) (mapOne B)

theorem CurvatureMorphism.map_curvature
    {OneForm₁ TwoForm₁ OneForm₂ TwoForm₂ : Type*}
    [AddCommGroup OneForm₁] [Module ℂ OneForm₁]
    [AddCommGroup TwoForm₁] [Module ℂ TwoForm₁]
    [AddCommGroup OneForm₂] [Module ℂ OneForm₂]
    [AddCommGroup TwoForm₂] [Module ℂ TwoForm₂]
    {C₁ : CurvatureCalculus OneForm₁ TwoForm₁}
    {C₂ : CurvatureCalculus OneForm₂ TwoForm₂}
    (f : CurvatureMorphism C₁ C₂) (A : OneForm₁) :
    f.mapTwo (curvature C₁ A) = curvature C₂ (f.mapOne A) := by
  rw [curvature, curvature, map_add, map_add, f.background_comm,
    f.d_comm, f.wedge_comm]

/-! ## Definition 18: flat sector and exact effective action decomposition -/

/-- The flat sector of a typed curvature calculus. -/
def flatSector
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) : Set OneForm :=
  {A | curvature C A = 0}

theorem CurvatureMorphism.map_mem_flatSector
    {OneForm₁ TwoForm₁ OneForm₂ TwoForm₂ : Type*}
    [AddCommGroup OneForm₁] [Module ℂ OneForm₁]
    [AddCommGroup TwoForm₁] [Module ℂ TwoForm₁]
    [AddCommGroup OneForm₂] [Module ℂ OneForm₂]
    [AddCommGroup TwoForm₂] [Module ℂ TwoForm₂]
    {C₁ : CurvatureCalculus OneForm₁ TwoForm₁}
    {C₂ : CurvatureCalculus OneForm₂ TwoForm₂}
    (f : CurvatureMorphism C₁ C₂)
    {A : OneForm₁} (hA : A ∈ flatSector C₁) :
    f.mapOne A ∈ flatSector C₂ := by
  change curvature C₁ A = 0 at hA
  change curvature C₂ (f.mapOne A) = 0
  calc
    curvature C₂ (f.mapOne A) =
        f.mapTwo (curvature C₁ A) :=
      (f.map_curvature A).symm
    _ = 0 := by simp [hA]

theorem CurvatureMorphism.mem_flatSector_iff_of_injective
    {OneForm₁ TwoForm₁ OneForm₂ TwoForm₂ : Type*}
    [AddCommGroup OneForm₁] [Module ℂ OneForm₁]
    [AddCommGroup TwoForm₁] [Module ℂ TwoForm₁]
    [AddCommGroup OneForm₂] [Module ℂ OneForm₂]
    [AddCommGroup TwoForm₂] [Module ℂ TwoForm₂]
    {C₁ : CurvatureCalculus OneForm₁ TwoForm₁}
    {C₂ : CurvatureCalculus OneForm₂ TwoForm₂}
    (f : CurvatureMorphism C₁ C₂)
    (hinjective : Function.Injective f.mapTwo)
    (A : OneForm₁) :
    f.mapOne A ∈ flatSector C₂ ↔ A ∈ flatSector C₁ := by
  constructor
  · intro hA
    change curvature C₂ (f.mapOne A) = 0 at hA
    change curvature C₁ A = 0
    apply hinjective
    calc
      f.mapTwo (curvature C₁ A) =
          curvature C₂ (f.mapOne A) :=
        f.map_curvature A
      _ = 0 := hA
      _ = f.mapTwo 0 := by simp
  · exact f.map_mem_flatSector

/-- **Corrected Definition 18.** Effective mass is part of a supplied exact
decomposition; it is not canonical from an action alone. -/
structure EffectiveActionDecomposition
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    (C : CurvatureCalculus OneForm TwoForm) where
  action : OneForm → ℝ
  energyOfCurvature : TwoForm → ℝ
  energy_zero : energyOfCurvature 0 = 0
  mass : OneForm → ℝ
  remainder : OneForm → ℝ
  decomposition : ∀ A,
    action A = energyOfCurvature (curvature C A) + mass A + remainder A

theorem EffectiveActionDecomposition.mass_eq
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C) (A : OneForm) :
    D.mass A = D.action A -
      D.energyOfCurvature (curvature C A) - D.remainder A := by
  linarith [D.decomposition A]

theorem EffectiveActionDecomposition.remainder_eq
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C) (A : OneForm) :
    D.remainder A = D.action A -
      D.energyOfCurvature (curvature C A) - D.mass A := by
  linarith [D.decomposition A]

theorem EffectiveActionDecomposition.action_nonnegative
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (henergy : ∀ F, 0 ≤ D.energyOfCurvature F)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (A : OneForm) :
    0 ≤ D.action A := by
  rw [D.decomposition]
  exact add_nonneg
    (add_nonneg (henergy _) (hmass A))
    (hremainder A)

theorem EffectiveActionDecomposition.minimizer_action_eq_zero
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (henergy : ∀ F, 0 ≤ D.energyOfCurvature F)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (A A₀ : OneForm)
    (hA₀ : D.action A₀ = 0)
    (hmin : ∀ B, D.action A ≤ D.action B) :
    D.action A = 0 := by
  apply le_antisymm
  · calc
      D.action A ≤ D.action A₀ := hmin A₀
      _ = 0 := hA₀
  · exact D.action_nonnegative henergy hmass hremainder A

theorem EffectiveActionDecomposition.components_zero_of_action_zero
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (henergy : ∀ F, 0 ≤ D.energyOfCurvature F)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    {A : OneForm} (haction : D.action A = 0) :
    D.energyOfCurvature (curvature C A) = 0 ∧
      D.mass A = 0 ∧ D.remainder A = 0 := by
  have he := henergy (curvature C A)
  have hm := hmass A
  have hr := hremainder A
  have hsum :
      D.energyOfCurvature (curvature C A) +
          D.mass A + D.remainder A = 0 := by
    calc
      D.energyOfCurvature (curvature C A) +
          D.mass A + D.remainder A = D.action A :=
        (D.decomposition A).symm
      _ = 0 := haction
  constructor
  · linarith
  constructor <;> linarith

theorem EffectiveActionDecomposition.minimizer_components_zero
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (henergy : ∀ F, 0 ≤ D.energyOfCurvature F)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (A A₀ : OneForm)
    (hA₀ : D.action A₀ = 0)
    (hmin : ∀ B, D.action A ≤ D.action B) :
    D.energyOfCurvature (curvature C A) = 0 ∧
      D.mass A = 0 ∧ D.remainder A = 0 := by
  apply D.components_zero_of_action_zero henergy hmass hremainder
  exact D.minimizer_action_eq_zero
    henergy hmass hremainder A A₀ hA₀ hmin

theorem EffectiveActionDecomposition.minimizer_mem_flatSector
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (henergy : ∀ F, 0 ≤ D.energyOfCurvature F)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (hdefinite : ∀ F, D.energyOfCurvature F = 0 ↔ F = 0)
    (A A₀ : OneForm)
    (hA₀ : D.action A₀ = 0)
    (hmin : ∀ B, D.action A ≤ D.action B) :
    A ∈ flatSector C := by
  change curvature C A = 0
  apply (hdefinite (curvature C A)).1
  exact
    (D.minimizer_components_zero
      henergy hmass hremainder A A₀ hA₀ hmin).1

theorem action_eq_mass_add_remainder_of_flat
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C) {A : OneForm}
    (hA : A ∈ flatSector C) :
    D.action A = D.mass A + D.remainder A := by
  rw [D.decomposition, hA, D.energy_zero, zero_add]

/-- The usual zero-mass conclusion, split from the nontrivial existence of a
minimizer and a zero-action comparison field. -/
theorem flat_minimizer_mass_remainder_zero
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (A A0 : OneForm) (hflat : A ∈ flatSector C)
    (hA0 : D.action A0 = 0)
    (hmin : ∀ B, D.action A ≤ D.action B) :
    D.mass A = 0 ∧ D.remainder A = 0 := by
  have haction_le : D.action A ≤ 0 := by
    simpa [hA0] using hmin A0
  have hdecomp := action_eq_mass_add_remainder_of_flat D hflat
  constructor <;> linarith [hmass A, hremainder A]

/-! ## Genuine reusable proof leaves from the supplied file -/

namespace Elementary

/-- The scalar division leaf used after a genuine coercive estimate has been proved. -/
theorem poincare_of_coercive {u E c : ℝ} (hc : 0 < c)
    (h : c * u ^ 2 ≤ E) : u ^ 2 ≤ E / c := by
  exact (le_div_iff₀ hc).2 (by simpa [mul_comm] using h)

/-- Nonnegativity of a finite real weighted-square sum. -/
theorem mass_nonneg {ι : Type*} (s : Finset ι) (Phi rho : ι → ℝ)
    (hPhi : ∀ i ∈ s, 0 ≤ Phi i) :
    0 ≤ ∑ i ∈ s, Phi i * (rho i) ^ 2 := by
  apply Finset.sum_nonneg
  intro i hi
  exact mul_nonneg (hPhi i hi) (sq_nonneg _)

/-- Conjugation by a constant unit in a ring. -/
def gconj {R : Type*} [Ring R] (g : Rˣ) (A : R) : R :=
  (↑g⁻¹ : R) * A * (↑g : R)

theorem gconj_mul {R : Type*} [Ring R] (g : Rˣ) (A B : R) :
    gconj g A * gconj g B = gconj g (A * B) := by
  simp only [gconj, mul_assoc, Units.mul_inv_cancel_left]

/-- Constant ring conjugation preserves the ring commutator.  This is an algebraic
leaf, not the full differential-form gauge covariance theorem. -/
theorem gconj_commutator {R : Type*} [Ring R] (g : Rˣ) (A B : R) :
    gconj g A * gconj g B - gconj g B * gconj g A =
      gconj g (A * B - B * A) := by
  rw [gconj_mul, gconj_mul]
  simp only [gconj, mul_sub, sub_mul]

end Elementary

/-! ## Available foundational functional analysis -/

namespace FunctionalAnalysis

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem cauchy_schwarz (u v : E) :
    ‖⟪u, v⟫_ℝ‖ ≤ ‖u‖ * ‖v‖ :=
  norm_inner_le_norm u v

theorem dual_holder (f : E →L[ℝ] ℝ) (v : E) :
    ‖f v‖ ≤ ‖f‖ * ‖v‖ :=
  f.le_opNorm v

theorem lax_milgram [CompleteSpace E]
    (B : E →L[ℝ] E →L[ℝ] ℝ) (coercive : IsCoercive B) :
    ∃ phi : E ≃L[ℝ] E, ∀ v w : E, ⟪phi v, w⟫_ℝ = B v w :=
  ⟨coercive.continuousLinearEquivOfBilin,
    coercive.continuousLinearEquivOfBilin_apply⟩

end FunctionalAnalysis

/-! ## Explicitly conditional skeletons retained for provenance -/

namespace ConditionalSkeleton

/-- This only removes `epsilon` after the desired lower bound has already been
provided; it does not prove the mass-gap input. -/
theorem spectral_mass_gap {lambda0 epsilon : ℝ} (hepsilon : 0 < epsilon)
    (hmass : 1 / 4 + epsilon ≤ lambda0) : 1 / 4 < lambda0 := by
  linarith

/-- A direct contradiction from mutually inconsistent strict inequalities. -/
theorem step3_contradiction {lambda0 : ℝ}
    (hgap : 1 / 4 < lambda0) (hbad : lambda0 < 1 / 4) : False := by
  linarith

/-- A pointwise algebraic consequence of an assumed dictionary identity. -/
theorem inside_outside_value {Omega : Type*}
    (G Psi S : Omega → ℂ) (qinv q : Omega)
    (hdict : G qinv = 2 * Psi q - S q) (hPsi : Psi q = 0) :
    G qinv = -S q := by
  rw [hdict, hPsi]
  ring

end ConditionalSkeleton

/-! ## Corrected lemma layer: Lemmas 1.1--2.2 -/

namespace CorrectedLemmas

/-! ## Genuine square-root metaplectic ambient over `Gamma(2)`

The earlier `Gamma2Metaplectic` is the unrestricted semidirect product of a
matrix with an arbitrary unit-valued function.  The type below is separate:
its factor is required to square to the actual Moebius denominator.  We retain
continuity because Mathlib's fixed `GL₂(ℝ)` action is continuous and the square
relation proves that every factor is nonzero, so inversion is continuous.

No section of the projection is constructed here.  In particular, this block
does not assert the existence of a paper-specific theta multiplier or of a
fixed metaplectic lift of every element of `Gamma(2)`. -/

namespace GenuineGamma2Metaplectic

/-- The real general-linear matrix underlying an element of `Gamma(2)`. -/
noncomputable abbrev realMatrix (γ : Gamma2Element) :
    Matrix.GeneralLinearGroup (Fin 2) ℝ :=
  (Matrix.SpecialLinearGroup.mapGL
    (n := Fin 2) (R := ℤ) ℝ)
    (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ)

@[simp]
theorem realMatrix_one : realMatrix (1 : Gamma2Element) = 1 := by
  simp [realMatrix]

@[simp]
theorem realMatrix_mul (γ δ : Gamma2Element) :
    realMatrix (γ * δ) = realMatrix γ * realMatrix δ := by
  simp [realMatrix]

@[simp]
theorem realMatrix_inv (γ : Gamma2Element) :
    realMatrix γ⁻¹ = (realMatrix γ)⁻¹ := by
  simp [realMatrix]

/-- Coercing the concrete `Gamma(2)` action to `ℂ` gives the usual numerator
divided by denominator for the associated real matrix. -/
@[simp]
theorem coe_gamma2Act_eq_num_div_denom
    (γ : Gamma2Element) (τ : UpperHalfPlane) :
    (gamma2Act γ τ : ℂ) =
      UpperHalfPlane.num (realMatrix γ) τ /
        UpperHalfPlane.denom (realMatrix γ) τ := by
  simpa [gamma2Act, realMatrix, UpperHalfPlane.num,
    UpperHalfPlane.denom] using
    (UpperHalfPlane.coe_specialLinearGroup_apply
      (g := (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ)) τ)

/-- The actual denominator cocycle specialized to `Gamma(2)`. -/
theorem denom_cocycle
    (γ δ : Gamma2Element) (τ : UpperHalfPlane) :
    UpperHalfPlane.denom (realMatrix (γ * δ)) τ =
      UpperHalfPlane.denom (realMatrix γ) (gamma2Act δ τ) *
        UpperHalfPlane.denom (realMatrix δ) τ := by
  rw [realMatrix_mul]
  simpa only [coe_gamma2Act_eq_num_div_denom] using
    (UpperHalfPlane.denom_cocycle
      (realMatrix γ) (realMatrix δ)
      (z := (τ : ℂ)) τ.im_ne_zero)

/-- The concrete `Gamma(2)` action is continuous for every fixed matrix. -/
theorem continuous_gamma2Act (γ : Gamma2Element) :
    Continuous (gamma2Act γ) := by
  change Continuous (fun τ : UpperHalfPlane => realMatrix γ • τ)
  exact continuous_const_smul _

/-- A genuine metaplectic ambient element: its continuous factor is an actual
square root of the Moebius denominator at every point. -/
structure Element where
  matrix : Gamma2Element
  sqrtFactor : UpperHalfPlane → ℂ
  sqrtFactor_sq : ∀ τ,
    sqrtFactor τ ^ 2 =
      UpperHalfPlane.denom (realMatrix matrix) τ
  continuous_sqrtFactor : Continuous sqrtFactor

@[ext]
theorem ext {a b : Element}
    (hmatrix : a.matrix = b.matrix)
    (hsqrtFactor : a.sqrtFactor = b.sqrtFactor) : a = b := by
  cases a
  cases b
  cases hmatrix
  cases hsqrtFactor
  rfl

/-- The square-root relation and nonvanishing of the Moebius denominator force
the chosen factor to be nonzero everywhere. -/
theorem sqrtFactor_ne_zero (a : Element) (τ : UpperHalfPlane) :
    a.sqrtFactor τ ≠ 0 := by
  intro hzero
  apply UpperHalfPlane.denom_ne_zero (realMatrix a.matrix) τ
  rw [← a.sqrtFactor_sq τ, hzero]
  norm_num

/-- Taking norms in the defining square-root relation gives the exact
weight-one norm identity. -/
theorem norm_sqrtFactor_sq (a : Element) (τ : UpperHalfPlane) :
    ‖a.sqrtFactor τ‖ ^ 2 =
      ‖UpperHalfPlane.denom (realMatrix a.matrix) τ‖ := by
  rw [← norm_pow]
  exact congrArg norm (a.sqrtFactor_sq τ)

/-- The denominator norm-square is the fourth power of the norm of its chosen
square root. -/
theorem normSq_denom_eq_norm_sqrtFactor_pow_four
    (a : Element) (τ : UpperHalfPlane) :
    Complex.normSq
        (UpperHalfPlane.denom (realMatrix a.matrix) τ) =
      ‖a.sqrtFactor τ‖ ^ 4 := by
  rw [← a.sqrtFactor_sq τ, Complex.normSq_eq_norm_sq, norm_pow]
  ring

/-- Height transformation expressed entirely through the chosen square-root
factor.  This is the direct bridge to weighted Petersson-density calculations. -/
theorem im_gamma2Act_eq_div_norm_sqrtFactor_pow_four
    (a : Element) (τ : UpperHalfPlane) :
    (gamma2Act a.matrix τ).im =
      τ.im / ‖a.sqrtFactor τ‖ ^ 4 := by
  change (realMatrix a.matrix • τ).im =
    τ.im / ‖a.sqrtFactor τ‖ ^ 4
  rw [← normSq_denom_eq_norm_sqrtFactor_pow_four]
  simpa [realMatrix] using
    (UpperHalfPlane.im_smul_eq_div_normSq
      (realMatrix a.matrix) τ)

/-- The denominator of an inverse matrix is the reciprocal denominator at the
inverse-transformed point. -/
theorem inv_denom_eq_denom_inv
    (γ : Gamma2Element) (τ : UpperHalfPlane) :
    (UpperHalfPlane.denom
        (realMatrix γ) (gamma2Act γ⁻¹ τ))⁻¹ =
      UpperHalfPlane.denom (realMatrix γ⁻¹) τ := by
  apply (mul_eq_one_iff_inv_eq₀
    (UpperHalfPlane.denom_ne_zero
      (realMatrix γ) (gamma2Act γ⁻¹ τ))).mp
  rw [← denom_cocycle]
  simpa only [mul_inv_cancel, realMatrix_one] using
    (UpperHalfPlane.denom_one τ)

/-- Identity element in the genuine square-root ambient. -/
def one : Element where
  matrix := 1
  sqrtFactor := fun _ => 1
  sqrtFactor_sq := by
    intro τ
    simpa only [one_pow, realMatrix_one] using
      (UpperHalfPlane.denom_one τ).symm
  continuous_sqrtFactor := continuous_const

/-- Multiplication is the denominator cocycle product. -/
def mul (a b : Element) : Element where
  matrix := a.matrix * b.matrix
  sqrtFactor := fun τ =>
    a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ
  sqrtFactor_sq := by
    intro τ
    rw [mul_pow, a.sqrtFactor_sq, b.sqrtFactor_sq]
    exact (denom_cocycle a.matrix b.matrix τ).symm
  continuous_sqrtFactor :=
    (a.continuous_sqrtFactor.comp
      (continuous_gamma2Act b.matrix)).mul
      b.continuous_sqrtFactor

/-- Inversion uses the reciprocal branch at the inverse-transformed point. -/
def inv (a : Element) : Element where
  matrix := a.matrix⁻¹
  sqrtFactor := fun τ =>
    (a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹
  sqrtFactor_sq := by
    intro τ
    rw [inv_pow, a.sqrtFactor_sq, inv_denom_eq_denom_inv]
  continuous_sqrtFactor :=
    (a.continuous_sqrtFactor.comp
      (continuous_gamma2Act a.matrix⁻¹)).inv₀
      (fun τ => sqrtFactor_ne_zero a (gamma2Act a.matrix⁻¹ τ))

instance : One Element := ⟨one⟩
instance : Mul Element := ⟨mul⟩
instance : Inv Element := ⟨inv⟩

@[simp]
theorem matrix_one : (1 : Element).matrix = 1 := rfl

@[simp]
theorem matrix_mul (a b : Element) :
    (a * b).matrix = a.matrix * b.matrix := rfl

@[simp]
theorem matrix_inv (a : Element) :
    a⁻¹.matrix = a.matrix⁻¹ := rfl

@[simp]
theorem sqrtFactor_one (τ : UpperHalfPlane) :
    (1 : Element).sqrtFactor τ = 1 := rfl

@[simp]
theorem sqrtFactor_mul (a b : Element) (τ : UpperHalfPlane) :
    (a * b).sqrtFactor τ =
      a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ := rfl

@[simp]
theorem sqrtFactor_inv (a : Element) (τ : UpperHalfPlane) :
    a⁻¹.sqrtFactor τ =
      (a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹ := rfl

/-- Direct closure statement for multiplication, derived from the two input
square relations and the denominator cocycle. -/
theorem mul_sqrtFactor_sq
    (a b : Element) (τ : UpperHalfPlane) :
    (a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ) ^ 2 =
      UpperHalfPlane.denom (realMatrix (a.matrix * b.matrix)) τ := by
  rw [mul_pow, a.sqrtFactor_sq, b.sqrtFactor_sq]
  exact (denom_cocycle a.matrix b.matrix τ).symm

/-- Direct closure statement for inversion. -/
theorem inv_sqrtFactor_sq
    (a : Element) (τ : UpperHalfPlane) :
    (a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹ ^ 2 =
      UpperHalfPlane.denom (realMatrix a.matrix⁻¹) τ := by
  rw [inv_pow, a.sqrtFactor_sq, inv_denom_eq_denom_inv]

/-- The square-root-compatible ambient is a group.  No surjectivity of its
matrix projection is asserted. -/
instance : Group Element :=
  Group.ofLeftAxioms
    (by
      intro a b c
      apply ext
      · simp only [matrix_mul, mul_assoc]
      · funext τ
        simp only [sqrtFactor_mul, matrix_mul, gamma2Act_mul, mul_assoc])
    (by
      intro a
      apply ext
      · simp only [matrix_mul, matrix_one, one_mul]
      · funext τ
        simp only [sqrtFactor_mul, sqrtFactor_one, one_mul])
    (by
      intro a
      apply ext
      · simp [matrix_mul, matrix_inv]
      · funext τ
        have hact :
            gamma2Act a.matrix⁻¹ (gamma2Act a.matrix τ) = τ := by
          rw [← gamma2Act_mul]
          simp
        simp only [sqrtFactor_mul, sqrtFactor_inv, hact,
          sqrtFactor_one]
        exact inv_mul_cancel₀ (sqrtFactor_ne_zero a τ))

theorem group_mul_assoc (a b c : Element) :
    (a * b) * c = a * (b * c) :=
  mul_assoc a b c

theorem group_inv_mul (a : Element) :
    a⁻¹ * a = 1 := by
  simp

/-- Forgetting the square-root branch is a genuine group homomorphism.  It is
not claimed to be surjective and no section is supplied. -/
def toGamma2 : Element →* Gamma2Element where
  toFun := Element.matrix
  map_one' := matrix_one
  map_mul' := matrix_mul

@[simp]
theorem toGamma2_apply (a : Element) : toGamma2 a = a.matrix := rfl

theorem projection_preserves_mul (a b : Element) :
    toGamma2 (a * b) = toGamma2 a * toGamma2 b :=
  map_mul toGamma2 a b

/-! ### Two-sheet classification of every inhabited projection fiber -/

/-- Two genuine square-root factors over the same matrix differ pointwise by
a sign. -/
theorem sqrtFactor_pointwise_dichotomy_of_matrix_eq
    (a b : Element) (hab : a.matrix = b.matrix)
    (τ : UpperHalfPlane) :
    a.sqrtFactor τ = b.sqrtFactor τ ∨
      a.sqrtFactor τ = -b.sqrtFactor τ := by
  apply sq_eq_sq_iff_eq_or_eq_neg.mp
  calc
    a.sqrtFactor τ ^ 2 =
        UpperHalfPlane.denom (realMatrix a.matrix) τ :=
      a.sqrtFactor_sq τ
    _ = UpperHalfPlane.denom (realMatrix b.matrix) τ := by rw [hab]
    _ = b.sqrtFactor τ ^ 2 := (b.sqrtFactor_sq τ).symm

/-- Connectedness of the upper half-plane makes the pointwise sign global. -/
theorem sqrtFactor_eq_or_eq_neg_of_matrix_eq
    (a b : Element) (hab : a.matrix = b.matrix) :
    a.sqrtFactor = b.sqrtFactor ∨
      a.sqrtFactor = fun τ => -b.sqrtFactor τ := by
  let s : Set UpperHalfPlane :=
    {τ | a.sqrtFactor τ = b.sqrtFactor τ}
  have hclosed : IsClosed s :=
    isClosed_eq a.continuous_sqrtFactor b.continuous_sqrtFactor
  have hcompl :
      sᶜ = {τ | a.sqrtFactor τ = -b.sqrtFactor τ} := by
    ext τ
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq]
    constructor
    · intro hne
      exact
        (sqrtFactor_pointwise_dichotomy_of_matrix_eq a b hab τ).resolve_left hne
    · intro hneg heq
      exact (sqrtFactor_ne_zero b τ)
        (CharZero.eq_neg_self_iff.mp (heq.symm.trans hneg))
  have hopen : IsOpen s := isClosed_compl_iff.mp <| by
    rw [hcompl]
    exact isClosed_eq a.continuous_sqrtFactor
      b.continuous_sqrtFactor.neg
  rcases isClopen_iff.mp ⟨hclosed, hopen⟩ with hs | hs
  · right
    funext τ
    exact
      (sqrtFactor_pointwise_dichotomy_of_matrix_eq a b hab τ).resolve_left (by
        intro heq
        have hmem : τ ∈ s := heq
        simpa [hs] using hmem)
  · left
    funext τ
    have hmem : τ ∈ s := by
      rw [hs]
      exact Set.mem_univ τ
    exact hmem

/-- Projection equality is enough to invoke the global sign dichotomy. -/
theorem sqrtFactor_eq_or_eq_neg_of_projection_eq
    (a b : Element) (hab : toGamma2 a = toGamma2 b) :
    a.sqrtFactor = b.sqrtFactor ∨
      a.sqrtFactor = fun τ => -b.sqrtFactor τ := by
  apply sqrtFactor_eq_or_eq_neg_of_matrix_eq
  simpa only [toGamma2_apply] using hab

/-- The nontrivial deck element over the identity matrix. -/
def deckNeg : Element where
  matrix := 1
  sqrtFactor := fun _ => -1
  sqrtFactor_sq := by
    intro τ
    simpa only [neg_sq, one_pow, realMatrix_one] using
      (UpperHalfPlane.denom_one τ).symm
  continuous_sqrtFactor := continuous_const

@[simp]
theorem deckNeg_matrix : deckNeg.matrix = 1 := rfl

@[simp]
theorem deckNeg_sqrtFactor (τ : UpperHalfPlane) :
    deckNeg.sqrtFactor τ = -1 := rfl

@[simp]
theorem deckNeg_projection : toGamma2 deckNeg = 1 := rfl

/-- Multiplication by the deck involution flips the global square-root sign. -/
@[simp]
theorem deckNeg_mul_sqrtFactor (a : Element) (τ : UpperHalfPlane) :
    (deckNeg * a).sqrtFactor τ = -a.sqrtFactor τ := by
  rw [sqrtFactor_mul, deckNeg_sqrtFactor]
  ring

/-- The deck transformation is an involution. -/
@[simp]
theorem deckNeg_mul_self : deckNeg * deckNeg = 1 := by
  apply ext
  · simp only [matrix_mul, matrix_one, deckNeg_matrix, one_mul]
  · funext τ
    rw [deckNeg_mul_sqrtFactor, deckNeg_sqrtFactor,
      sqrtFactor_one]
    norm_num

/-- The deck involution is nontrivial. -/
theorem deckNeg_ne_one : deckNeg ≠ 1 := by
  intro h
  let τ : UpperHalfPlane := ⟨Complex.I, by simp⟩
  have hfactor := congrArg (fun a : Element => a.sqrtFactor τ) h
  rw [deckNeg_sqrtFactor, sqrtFactor_one] at hfactor
  norm_num at hfactor

/-- The deck involution is central in the genuine extension. -/
theorem deckNeg_central (a : Element) : deckNeg * a = a * deckNeg := by
  apply ext
  · simp only [matrix_mul, deckNeg_matrix, one_mul, mul_one]
  · funext τ
    rw [deckNeg_mul_sqrtFactor, sqrtFactor_mul, deckNeg_matrix,
      gamma2Act_one, deckNeg_sqrtFactor]
    ring

/-- Every inhabited fiber of the genuine projection consists of exactly two
global sign choices, related by the nontrivial deck involution. -/
theorem eq_or_eq_deckNeg_mul_of_projection_eq
    (a b : Element) (hab : toGamma2 a = toGamma2 b) :
    a = b ∨ a = deckNeg * b := by
  have hmatrix : a.matrix = b.matrix := by
    simpa only [toGamma2_apply] using hab
  rcases sqrtFactor_eq_or_eq_neg_of_matrix_eq a b hmatrix with h | h
  · exact Or.inl (ext hmatrix h)
  · right
    apply ext
    · simpa only [matrix_mul, deckNeg_matrix, one_mul] using hmatrix
    · funext τ
      rw [deckNeg_mul_sqrtFactor]
      exact congrFun h τ

end GenuineGamma2Metaplectic

/-! ## A concrete genuine lift of the width-two theta generator

This namespace constructs only the single element lying over `T²`.  It is not
a section on all of `Gamma(2)` and supplies no lift of any other generator. -/

namespace ThetaGeneratorLift

/-- The Moebius denominator of the width-two translation is exactly one.  This
is computed from the lower row of the concrete matrix `T²`. -/
theorem denom_gamma2TranslationTwo (τ : UpperHalfPlane) :
    UpperHalfPlane.denom
        (GenuineGamma2Metaplectic.realMatrix gamma2TranslationTwo) τ = 1 := by
  norm_num [GenuineGamma2Metaplectic.realMatrix,
    gamma2TranslationTwo, UpperHalfPlane.denom, pow_two,
    Matrix.mul_apply, Fin.sum_univ_two]

/-- The genuine square-root-compatible element over the concrete translation
`T²`, with the constant square root of its denominator. -/
noncomputable def translationTwoLift :
    GenuineGamma2Metaplectic.Element where
  matrix := gamma2TranslationTwo
  sqrtFactor := fun _ => 1
  sqrtFactor_sq := by
    intro τ
    simpa only [one_pow] using (denom_gamma2TranslationTwo τ).symm
  continuous_sqrtFactor := continuous_const

@[simp]
theorem translationTwoLift_matrix :
    translationTwoLift.matrix = gamma2TranslationTwo := rfl

@[simp]
theorem translationTwoLift_sqrtFactor (τ : UpperHalfPlane) :
    translationTwoLift.sqrtFactor τ = 1 := rfl

/-- The concrete lift projects to the width-two translation, not merely to an
abstractly equal matrix. -/
@[simp]
theorem translationTwoLift_projection :
    GenuineGamma2Metaplectic.toGamma2 translationTwoLift =
      gamma2TranslationTwo := rfl

/-- Nonvanishing of the concrete factor, also obtainable from the generic
denominator argument. -/
theorem translationTwoLift_sqrtFactor_ne_zero (τ : UpperHalfPlane) :
    translationTwoLift.sqrtFactor τ ≠ 0 := by
  exact GenuineGamma2Metaplectic.sqrtFactor_ne_zero translationTwoLift τ

/-- The concrete translation factor has unit complex norm. -/
@[simp]
theorem norm_translationTwoLift_sqrtFactor (τ : UpperHalfPlane) :
    ‖translationTwoLift.sqrtFactor τ‖ = 1 := by
  simp only [translationTwoLift_sqrtFactor, norm_one]

/-- Standard theta covariance for the genuinely lifted `T²` element.  The
proof uses the existing Jacobi-theta transformation theorem and the explicitly
computed square-root factor; it does not extend the lift to all of `Gamma(2)`. -/
theorem theta_translationTwoLift_covariance (τ : UpperHalfPlane) :
    ConcreteUnaryTheta.theta
        (gamma2Act
          (GenuineGamma2Metaplectic.toGamma2 translationTwoLift) τ) =
      translationTwoLift.sqrtFactor τ * ConcreteUnaryTheta.theta τ := by
  rw [translationTwoLift_projection, translationTwoLift_sqrtFactor, one_mul]
  exact ConcreteUnaryTheta.theta_gamma2TranslationTwo τ

/-! The central element below is another explicit inhabitant of the ambient.
It is not used to assert theta covariance: the raw square root `I` does not by
itself include the additional theta-multiplier phase needed at `-I`. -/

/-- The central matrix `-I` belongs to `Gamma(2)` because `-1 = 1` modulo two. -/
theorem negOne_mem_gamma2 :
    (-1 : Matrix.SpecialLinearGroup (Fin 2) ℤ) ∈ Gamma2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  norm_num
  change (-1 : ZMod 2) = 1
  decide

/-- The concrete central element `-I` of `Gamma(2)`. -/
def gamma2NegOne : Gamma2Element :=
  ⟨-1, negOne_mem_gamma2⟩

/-- The Moebius denominator of `-I` is the constant `-1`. -/
theorem denom_gamma2NegOne (τ : UpperHalfPlane) :
    UpperHalfPlane.denom
        (GenuineGamma2Metaplectic.realMatrix gamma2NegOne) τ = -1 := by
  simp [GenuineGamma2Metaplectic.realMatrix, gamma2NegOne,
    UpperHalfPlane.denom]

/-- A genuine ambient lift of central `-I`, using `I² = -1`.  This is still a
single element, not a global section of the matrix projection. -/
noncomputable def centralNegOneLift :
    GenuineGamma2Metaplectic.Element where
  matrix := gamma2NegOne
  sqrtFactor := fun _ => Complex.I
  sqrtFactor_sq := by
    intro τ
    rw [Complex.I_sq, denom_gamma2NegOne]
  continuous_sqrtFactor := continuous_const

@[simp]
theorem centralNegOneLift_projection :
    GenuineGamma2Metaplectic.toGamma2 centralNegOneLift = gamma2NegOne := rfl

@[simp]
theorem centralNegOneLift_sqrtFactor (τ : UpperHalfPlane) :
    centralNegOneLift.sqrtFactor τ = Complex.I := rfl

@[simp]
theorem norm_centralNegOneLift_sqrtFactor (τ : UpperHalfPlane) :
    ‖centralNegOneLift.sqrtFactor τ‖ = 1 := by
  simp only [centralNegOneLift_sqrtFactor, Complex.norm_I]

/-! ### The central obstruction to a global group-theoretic section

The square-root extension over `Gamma(2)` cannot be split by a group
homomorphism.  The obstruction is already visible over the central matrix
`-I`: every genuine square-root lift of that matrix has square-root factor
whose square is `-1`, whereas the identity lift has factor `1`.  Thus the
paper's desired fixed lift must be formulated as a multiplier/projective lift,
not as a homomorphic section of the raw square-root projection. -/

@[simp]
theorem gamma2NegOne_mul_self : gamma2NegOne * gamma2NegOne = 1 := by
  apply Subtype.ext
  simp [gamma2NegOne]

@[simp]
theorem gamma2NegOne_act (τ : UpperHalfPlane) :
    gamma2Act gamma2NegOne τ = τ := by
  simp [gamma2Act, gamma2NegOne]

/-- The factor of the square of *any* genuine lift over `-I` is `-1`.
This does not depend on choosing the explicit constant-`I` lift above. -/
theorem square_sqrtFactor_eq_neg_one_of_projection
    (a : GenuineGamma2Metaplectic.Element)
    (ha : GenuineGamma2Metaplectic.toGamma2 a = gamma2NegOne)
    (τ : UpperHalfPlane) :
    (a * a).sqrtFactor τ = -1 := by
  have hmatrix : a.matrix = gamma2NegOne := by
    simpa only [GenuineGamma2Metaplectic.toGamma2_apply] using ha
  have hdenom :
      UpperHalfPlane.denom
          (GenuineGamma2Metaplectic.realMatrix a.matrix) τ = -1 := by
    rw [hmatrix]
    exact denom_gamma2NegOne τ
  rw [GenuineGamma2Metaplectic.sqrtFactor_mul, hmatrix,
    gamma2NegOne_act]
  calc
    a.sqrtFactor τ * a.sqrtFactor τ = a.sqrtFactor τ ^ 2 :=
      (pow_two _).symm
    _ = UpperHalfPlane.denom
          (GenuineGamma2Metaplectic.realMatrix a.matrix) τ :=
      a.sqrtFactor_sq τ
    _ = -1 := hdenom

/-- No genuine lift over the central `-I` can have group-theoretic order two. -/
theorem square_ne_one_of_projection_negOne
    (a : GenuineGamma2Metaplectic.Element)
    (ha : GenuineGamma2Metaplectic.toGamma2 a = gamma2NegOne) :
    a * a ≠ 1 := by
  intro hsquare
  let τ : UpperHalfPlane := ⟨Complex.I, by simp⟩
  have hfactor := congrArg
    (fun b : GenuineGamma2Metaplectic.Element => b.sqrtFactor τ) hsquare
  rw [square_sqrtFactor_eq_neg_one_of_projection a ha τ,
    GenuineGamma2Metaplectic.sqrtFactor_one] at hfactor
  norm_num at hfactor

/-- **Unconditional non-splitting theorem.**  There is no group-homomorphic
section of the genuine square-root projection over all of `Gamma(2)`. -/
theorem no_groupHom_section_of_genuine_projection :
    ¬ ∃ s : Gamma2Element →* GenuineGamma2Metaplectic.Element,
      Function.LeftInverse GenuineGamma2Metaplectic.toGamma2 s := by
  rintro ⟨s, hs⟩
  let a : GenuineGamma2Metaplectic.Element := s gamma2NegOne
  have ha : GenuineGamma2Metaplectic.toGamma2 a = gamma2NegOne :=
    hs gamma2NegOne
  apply square_ne_one_of_projection_negOne a ha
  calc
    a * a = s (gamma2NegOne * gamma2NegOne) :=
      (map_mul s gamma2NegOne gamma2NegOne).symm
    _ = s 1 := by rw [gamma2NegOne_mul_self]
    _ = 1 := map_one s

end ThetaGeneratorLift

namespace GenuineHalfWeightDensity

open GenuineGamma2Metaplectic

/-- The pointwise Petersson density factor for a weight-one-half scalar. -/
noncomputable def density (τ : UpperHalfPlane) (u : ℂ) : ℝ :=
  Real.sqrt τ.im * ‖u‖ ^ 2

theorem density_nonneg (τ : UpperHalfPlane) (u : ℂ) :
    0 ≤ density τ u :=
  mul_nonneg (Real.sqrt_nonneg _) (sq_nonneg _)

/-- The square of the half-weight density avoids every square-root convention. -/
theorem density_sq (τ : UpperHalfPlane) (u : ℂ) :
    density τ u ^ 2 = τ.im * ‖u‖ ^ 4 := by
  unfold density
  rw [mul_pow, Real.sq_sqrt τ.im_pos.le]
  ring

/-- A circle-valued theta multiplier contributes no norm factor; the only
metric scaling is the genuine square root of the Moebius denominator. -/
theorem norm_covariantValue
    (a : GenuineGamma2Metaplectic.Element) (η : Circle)
    (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * a.sqrtFactor τ * u) :
    ‖u'‖ = ‖a.sqrtFactor τ‖ * ‖u‖ := by
  rw [hu', norm_mul, norm_mul, Circle.norm_coe, one_mul]

/-- Squared Petersson-density invariance, derived only from the denominator
square relation and the exact height transformation formula. -/
theorem im_mul_norm_pow_four_invariant
    (a : GenuineGamma2Metaplectic.Element) (η : Circle)
    (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * a.sqrtFactor τ * u) :
    (gamma2Act a.matrix τ).im * ‖u'‖ ^ 4 =
      τ.im * ‖u‖ ^ 4 := by
  rw [im_gamma2Act_eq_div_norm_sqrtFactor_pow_four a,
    norm_covariantValue a η τ u u' hu']
  have hp : ‖a.sqrtFactor τ‖ ≠ 0 :=
    norm_ne_zero_iff.mpr (sqrtFactor_ne_zero a τ)
  have hp4 : ‖a.sqrtFactor τ‖ ^ 4 ≠ 0 := pow_ne_zero 4 hp
  calc
    τ.im / ‖a.sqrtFactor τ‖ ^ 4 *
          (‖a.sqrtFactor τ‖ * ‖u‖) ^ 4 =
        (τ.im / ‖a.sqrtFactor τ‖ ^ 4 *
          ‖a.sqrtFactor τ‖ ^ 4) * ‖u‖ ^ 4 := by ring
    _ = τ.im * ‖u‖ ^ 4 := by
      rw [div_mul_cancel₀ τ.im hp4]

/-- Exact weight-one-half Petersson-density invariance.  This is the correct
multiplier cancellation: it uses the `y^(1/2)` factor and a circle-valued phase,
not the false claim that every nonzero automorphy factor has norm one. -/
theorem density_invariant
    (a : GenuineGamma2Metaplectic.Element) (η : Circle)
    (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * a.sqrtFactor τ * u) :
    density (gamma2Act a.matrix τ) u' = density τ u := by
  apply (sq_eq_sq₀
    (density_nonneg (gamma2Act a.matrix τ) u')
    (density_nonneg τ u)).mp
  rw [density_sq, density_sq]
  exact im_mul_norm_pow_four_invariant a η τ u u' hu'

end GenuineHalfWeightDensity

/-! ## Genuine half-weight automorphy on the metaplectic group

The raw square-root extension over `Gamma(2)` has no group-homomorphic
section, as proved above.  Consequently the correct global transformation law
is formulated directly on `GenuineGamma2Metaplectic.Element`.  A
circle-valued character supplies the multiplier phase, while `sqrtFactor`
supplies the genuine square root of the Moebius denominator. -/

namespace GenuineHalfWeightAutomorphy

open GenuineGamma2Metaplectic

/-- A genuine half-weight multiplier is a circle-valued character of the
genuine metaplectic group. -/
abbrev Multiplier :=
  GenuineGamma2Metaplectic.Element →* Circle

/-- The complete scalar automorphy factor: multiplier phase times the genuine
square root of the Moebius denominator. -/
def factor
    (ν : Multiplier)
    (a : GenuineGamma2Metaplectic.Element)
    (τ : UpperHalfPlane) : ℂ :=
  (ν a : ℂ) * a.sqrtFactor τ

@[simp]
theorem factor_one (ν : Multiplier) (τ : UpperHalfPlane) :
    factor ν 1 τ = 1 := by
  simp [factor]

/-- The genuine automorphy factor never vanishes. -/
theorem factor_ne_zero
    (ν : Multiplier)
    (a : GenuineGamma2Metaplectic.Element)
    (τ : UpperHalfPlane) :
    factor ν a τ ≠ 0 := by
  have hν : (ν a : ℂ) ≠ 0 := by
    intro hzero
    have hnorm : ‖(ν a : ℂ)‖ = 1 := Circle.norm_coe (ν a)
    rw [hzero, norm_zero] at hnorm
    norm_num at hnorm
  exact mul_ne_zero hν (sqrtFactor_ne_zero a τ)

/-- The genuine factor is continuous in the upper-half-plane variable. -/
theorem continuous_factor
    (ν : Multiplier)
    (a : GenuineGamma2Metaplectic.Element) :
    Continuous (factor ν a) := by
  change Continuous (fun τ : UpperHalfPlane =>
    (ν a : ℂ) * a.sqrtFactor τ)
  exact continuous_const.mul a.continuous_sqrtFactor

/-- Exact cocycle law with the action convention used by `gamma2Act`. -/
theorem factor_mul
    (ν : Multiplier)
    (a b : GenuineGamma2Metaplectic.Element)
    (τ : UpperHalfPlane) :
    factor ν (a * b) τ =
      factor ν a (gamma2Act b.matrix τ) * factor ν b τ := by
  change
    (ν (a * b) : ℂ) *
        (a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ) =
      ((ν a : ℂ) * a.sqrtFactor (gamma2Act b.matrix τ)) *
        ((ν b : ℂ) * b.sqrtFactor τ)
  rw [map_mul]
  change
    ((ν a : ℂ) * (ν b : ℂ)) *
        (a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ) =
      ((ν a : ℂ) * a.sqrtFactor (gamma2Act b.matrix τ)) *
        ((ν b : ℂ) * b.sqrtFactor τ)
  ring

/-- Pointwise genuine half-weight automorphy. -/
def IsAutomorphic
    (ν : Multiplier) (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ a τ,
    u (gamma2Act a.matrix τ) = factor ν a τ * u τ

/-- Completion-stable almost-everywhere genuine automorphy. -/
def IsAEAutomorphic
    (ν : Multiplier) (μ : Measure UpperHalfPlane)
    (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ a, ∀ᵐ τ ∂μ,
    u (gamma2Act a.matrix τ) = factor ν a τ * u τ

theorem IsAutomorphic.isAE
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u) :
    IsAEAutomorphic ν μ u := by
  intro a
  exact Filter.Eventually.of_forall (hu a)

theorem isAutomorphic_zero (ν : Multiplier) :
    IsAutomorphic ν (fun _ => 0) := by
  intro a τ
  simp

theorem IsAutomorphic.add
    {ν : Multiplier} {u v : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u) (hv : IsAutomorphic ν v) :
    IsAutomorphic ν (u + v) := by
  intro a τ
  simp only [Pi.add_apply, hu a τ, hv a τ, mul_add]

theorem IsAutomorphic.smul
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u) (c : ℂ) :
    IsAutomorphic ν (c • u) := by
  intro a τ
  change c * u (gamma2Act a.matrix τ) =
    factor ν a τ * (c * u τ)
  rw [hu a τ]
  ring

theorem isAEAutomorphic_zero
    (ν : Multiplier) (μ : Measure UpperHalfPlane) :
    IsAEAutomorphic ν μ (fun _ => 0) :=
  (isAutomorphic_zero ν).isAE

theorem IsAEAutomorphic.add
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {u v : UpperHalfPlane → ℂ}
    (hu : IsAEAutomorphic ν μ u)
    (hv : IsAEAutomorphic ν μ v) :
    IsAEAutomorphic ν μ (u + v) := by
  intro a
  filter_upwards [hu a, hv a] with τ huτ hvτ
  simp only [Pi.add_apply, huτ, hvτ, mul_add]

theorem IsAEAutomorphic.smul
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {u : UpperHalfPlane → ℂ}
    (hu : IsAEAutomorphic ν μ u) (c : ℂ) :
    IsAEAutomorphic ν μ (c • u) := by
  intro a
  filter_upwards [hu a] with τ huτ
  change c * u (gamma2Act a.matrix τ) =
    factor ν a τ * (c * u τ)
  rw [huτ]
  ring

/-- The a.e. genuine automorphy law is a complex linear subspace of function
representatives. -/
def aeAutomorphicSubmodule
    (ν : Multiplier) (μ : Measure UpperHalfPlane) :
    Submodule ℂ (UpperHalfPlane → ℂ) where
  carrier := {u | IsAEAutomorphic ν μ u}
  zero_mem' := isAEAutomorphic_zero ν μ
  add_mem' := fun hu hv => hu.add hv
  smul_mem' := fun c _ hu => hu.smul c

/-- Pointwise invariance of the correct weight-one-half Petersson density. -/
theorem IsAutomorphic.density_invariant
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (a : GenuineGamma2Metaplectic.Element)
    (τ : UpperHalfPlane) :
    GenuineHalfWeightDensity.density
        (gamma2Act a.matrix τ)
        (u (gamma2Act a.matrix τ)) =
      GenuineHalfWeightDensity.density τ (u τ) := by
  exact GenuineHalfWeightDensity.density_invariant
    a (ν a) τ (u τ) (u (gamma2Act a.matrix τ))
    (by simpa only [factor] using hu a τ)

/-- The Petersson-density identity also holds almost everywhere for an a.e.
automorphic representative. -/
theorem IsAEAutomorphic.ae_density_invariant
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {u : UpperHalfPlane → ℂ}
    (hu : IsAEAutomorphic ν μ u)
    (a : GenuineGamma2Metaplectic.Element) :
    ∀ᵐ τ ∂μ,
      GenuineHalfWeightDensity.density
          (gamma2Act a.matrix τ)
          (u (gamma2Act a.matrix τ)) =
        GenuineHalfWeightDensity.density τ (u τ) := by
  filter_upwards [hu a] with τ hτ
  exact GenuineHalfWeightDensity.density_invariant
    a (ν a) τ (u τ) (u (gamma2Act a.matrix τ))
    (by simpa only [factor] using hτ)

/-- At a fixed point, a nonzero automorphic value forces the complete factor
to equal one. -/
theorem factor_eq_one_of_fixed_point
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (a : GenuineGamma2Metaplectic.Element)
    (τ : UpperHalfPlane)
    (hfixed : gamma2Act a.matrix τ = τ)
    (huτ : u τ ≠ 0) :
    factor ν a τ = 1 := by
  have hcov := hu a τ
  rw [hfixed] at hcov
  have hc : factor ν a τ * u τ = 1 * u τ := by
    calc
      factor ν a τ * u τ = u τ := hcov.symm
      _ = 1 * u τ := by rw [one_mul]
  exact mul_right_cancel₀ huτ hc

/-- Every genuine lift over central `-I` fixes the base point, so a nonzero
automorphic value forces its complete factor to equal one. -/
theorem central_factor_eq_one_of_nonzero
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (a : GenuineGamma2Metaplectic.Element)
    (ha : GenuineGamma2Metaplectic.toGamma2 a =
      ThetaGeneratorLift.gamma2NegOne)
    (τ : UpperHalfPlane)
    (huτ : u τ ≠ 0) :
    factor ν a τ = 1 := by
  have hmatrix : a.matrix = ThetaGeneratorLift.gamma2NegOne := by
    simpa only [GenuineGamma2Metaplectic.toGamma2_apply] using ha
  apply factor_eq_one_of_fixed_point hu a τ
  · simpa only [hmatrix] using
      ThetaGeneratorLift.gamma2NegOne_act τ
  · exact huτ

/-- A nonzero automorphic value forces the multiplier to cancel the raw
central square-root phase `I`; its central value is therefore `-I`. -/
theorem centralNegOne_multiplier_value_of_nonzero
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (τ : UpperHalfPlane)
    (huτ : u τ ≠ 0) :
    (ν ThetaGeneratorLift.centralNegOneLift : ℂ) =
      -Complex.I := by
  have hf :
      factor ν ThetaGeneratorLift.centralNegOneLift τ = 1 :=
    central_factor_eq_one_of_nonzero
      hu ThetaGeneratorLift.centralNegOneLift
      ThetaGeneratorLift.centralNegOneLift_projection τ huτ
  have hphase :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) *
          Complex.I = 1 := by
    simpa only [factor,
      ThetaGeneratorLift.centralNegOneLift_sqrtFactor] using hf
  apply mul_right_cancel₀ Complex.I_ne_zero
  calc
    (ν ThetaGeneratorLift.centralNegOneLift : ℂ) * Complex.I =
        1 := hphase
    _ = (-Complex.I) * Complex.I := by
      rw [neg_mul, Complex.I_mul_I]
      norm_num

/-- A multiplier with the wrong central phase permits only a zero value at
every point of an automorphic section. -/
theorem value_eq_zero_of_bad_central_phase
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠
        -Complex.I)
    (τ : UpperHalfPlane) :
    u τ = 0 := by
  by_contra huτ
  exact hν
    (centralNegOne_multiplier_value_of_nonzero hu τ huτ)

/-- Global central-character obstruction: a bad phase makes the entire
automorphic section zero. -/
theorem eq_zero_of_bad_central_phase
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠
        -Complex.I) :
    u = 0 := by
  funext τ
  exact value_eq_zero_of_bad_central_phase hu hν τ

/-- The trivial character has the wrong central phase. -/
theorem one_multiplier_bad_central_phase :
    (((1 : Multiplier) ThetaGeneratorLift.centralNegOneLift : Circle) : ℂ) ≠
      -Complex.I := by
  change (1 : ℂ) ≠ -Complex.I
  intro h
  have him := congrArg Complex.im h
  norm_num at him

/-- A raw trivial multiplier on the genuine cover admits only the zero
automorphic section.  This is the concrete reason the theta phase cannot be
discarded. -/
theorem isAutomorphic_one_iff_eq_zero
    (u : UpperHalfPlane → ℂ) :
    IsAutomorphic (1 : Multiplier) u ↔ u = 0 := by
  constructor
  · intro hu
    exact eq_zero_of_bad_central_phase
      hu one_multiplier_bad_central_phase
  · rintro rfl
    exact isAutomorphic_zero (1 : Multiplier)

/-- For the positive-square-root convention, the total factor over the chosen
central `-I` lift is one exactly when the multiplier value is `-I`. -/
theorem centralNegOne_factor_eq_one_iff
    (ν : Multiplier) (τ : UpperHalfPlane) :
    factor ν ThetaGeneratorLift.centralNegOneLift τ = 1 ↔
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) = -Complex.I := by
  constructor
  · intro hf
    have hphase :
        (ν ThetaGeneratorLift.centralNegOneLift : ℂ) * Complex.I = 1 := by
      simpa only [factor,
        ThetaGeneratorLift.centralNegOneLift_sqrtFactor] using hf
    apply mul_right_cancel₀ Complex.I_ne_zero
    calc
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) * Complex.I = 1 := hphase
      _ = (-Complex.I) * Complex.I := by
        rw [neg_mul, Complex.I_mul_I]
        norm_num
  · intro hν
    rw [factor, ThetaGeneratorLift.centralNegOneLift_sqrtFactor, hν,
      neg_mul, Complex.I_mul_I]
    norm_num

theorem centralNegOne_factor_ne_one_of_bad_phase
    (ν : Multiplier)
    (hν : (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ -Complex.I)
    (τ : UpperHalfPlane) :
    factor ν ThetaGeneratorLift.centralNegOneLift τ ≠ 1 := by
  exact fun hf => hν ((centralNegOne_factor_eq_one_iff ν τ).1 hf)

/-! ### Direct theta-covariance pairs

The following submonoid records the locally verified generators of the standard
theta multiplier.  It contains the width-two translation and the central
`-I` lift with its indispensable phase.  Surjectivity is not used in this local
construction; it is proved later from the zero-cusp lift, the three-generator
theorem for `Gamma(2)`, and the two-sheet fiber classification. -/

/-- A genuine metaplectic element and a circle phase satisfy the standard
unary-theta covariance law. -/
def IsThetaCovariant
    (a : GenuineGamma2Metaplectic.Element) (η : Circle) : Prop :=
  ∀ τ : UpperHalfPlane,
    ConcreteUnaryTheta.theta (gamma2Act a.matrix τ) =
      (η : ℂ) * a.sqrtFactor τ * ConcreteUnaryTheta.theta τ

@[simp]
theorem isThetaCovariant_one :
    IsThetaCovariant (1 : GenuineGamma2Metaplectic.Element) (1 : Circle) := by
  intro τ
  simp only [GenuineGamma2Metaplectic.matrix_one, gamma2Act_one,
    Circle.coe_one, GenuineGamma2Metaplectic.sqrtFactor_one, one_mul]

/-- Theta-covariant pairs are closed under the genuine group product and
phase multiplication. -/
theorem IsThetaCovariant.mul
    {a b : GenuineGamma2Metaplectic.Element} {η ξ : Circle}
    (ha : IsThetaCovariant a η) (hb : IsThetaCovariant b ξ) :
    IsThetaCovariant (a * b) (η * ξ) := by
  intro τ
  calc
    ConcreteUnaryTheta.theta (gamma2Act (a * b).matrix τ) =
        ConcreteUnaryTheta.theta
          (gamma2Act a.matrix (gamma2Act b.matrix τ)) := by
      rw [GenuineGamma2Metaplectic.matrix_mul, gamma2Act_mul]
    _ = (η : ℂ) * a.sqrtFactor (gamma2Act b.matrix τ) *
          ConcreteUnaryTheta.theta (gamma2Act b.matrix τ) :=
      ha (gamma2Act b.matrix τ)
    _ = (η : ℂ) * a.sqrtFactor (gamma2Act b.matrix τ) *
          ((ξ : ℂ) * b.sqrtFactor τ * ConcreteUnaryTheta.theta τ) := by
      rw [hb τ]
    _ = ((η * ξ : Circle) : ℂ) * (a * b).sqrtFactor τ *
          ConcreteUnaryTheta.theta τ := by
      rw [Circle.coe_mul, GenuineGamma2Metaplectic.sqrtFactor_mul]
      ring

/-- Every circle phase is nonzero after coercion to `ℂ`. -/
theorem circle_coe_ne_zero (η : Circle) : (η : ℂ) ≠ 0 := by
  intro hzero
  have hnorm : ‖(η : ℂ)‖ = 1 := Circle.norm_coe η
  rw [hzero, norm_zero] at hnorm
  norm_num at hnorm

/-- Theta covariance is also closed under inversion.  This proof uses only
nonvanishing of the circle phase and of the genuine square-root factor. -/
theorem IsThetaCovariant.inv
    {a : GenuineGamma2Metaplectic.Element} {η : Circle}
    (ha : IsThetaCovariant a η) :
    IsThetaCovariant a⁻¹ η⁻¹ := by
  intro τ
  have hact :
      gamma2Act a.matrix (gamma2Act a.matrix⁻¹ τ) = τ := by
    rw [← gamma2Act_mul]
    simp
  have hcov := ha (gamma2Act a.matrix⁻¹ τ)
  rw [hact] at hcov
  have hη : (η : ℂ) ≠ 0 := circle_coe_ne_zero η
  have hs :
      a.sqrtFactor (gamma2Act a.matrix⁻¹ τ) ≠ 0 :=
    sqrtFactor_ne_zero a (gamma2Act a.matrix⁻¹ τ)
  change
    ConcreteUnaryTheta.theta (gamma2Act a.matrix⁻¹ τ) =
      ((η⁻¹ : Circle) : ℂ) *
        (a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹ *
          ConcreteUnaryTheta.theta τ
  rw [Circle.coe_inv, hcov]
  symm
  calc
    (η : ℂ)⁻¹ *
          (a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹ *
          ((η : ℂ) *
            a.sqrtFactor (gamma2Act a.matrix⁻¹ τ) *
            ConcreteUnaryTheta.theta (gamma2Act a.matrix⁻¹ τ)) =
        ((η : ℂ)⁻¹ * (η : ℂ)) *
          ((a.sqrtFactor (gamma2Act a.matrix⁻¹ τ))⁻¹ *
            a.sqrtFactor (gamma2Act a.matrix⁻¹ τ)) *
          ConcreteUnaryTheta.theta (gamma2Act a.matrix⁻¹ τ) := by ring
    _ = ConcreteUnaryTheta.theta (gamma2Act a.matrix⁻¹ τ) := by
      rw [inv_mul_cancel₀ hη, inv_mul_cancel₀ hs]
      simp

/-- Verified theta-covariant element/phase pairs form a submonoid. -/
def thetaCovariantSubmonoid :
    Submonoid (GenuineGamma2Metaplectic.Element × Circle) where
  carrier := {p | IsThetaCovariant p.1 p.2}
  one_mem' := isThetaCovariant_one
  mul_mem' := by
    rintro ⟨a, η⟩ ⟨b, ξ⟩ ha hb
    change IsThetaCovariant a η at ha
    change IsThetaCovariant b ξ at hb
    change IsThetaCovariant (a * b) (η * ξ)
    exact ha.mul hb

/-- In fact the verified covariance pairs form a subgroup; the submonoid
above is retained as the multiplication-only interface used by the generator
construction. -/
def thetaCovariantSubgroup :
    Subgroup (GenuineGamma2Metaplectic.Element × Circle) where
  carrier := {p | IsThetaCovariant p.1 p.2}
  one_mem' := isThetaCovariant_one
  mul_mem' := by
    rintro ⟨a, η⟩ ⟨b, ξ⟩ ha hb
    change IsThetaCovariant a η at ha
    change IsThetaCovariant b ξ at hb
    change IsThetaCovariant (a * b) (η * ξ)
    exact ha.mul hb
  inv_mem' := by
    rintro ⟨a, η⟩ ha
    change IsThetaCovariant a η at ha
    change IsThetaCovariant a⁻¹ η⁻¹
    exact ha.inv

/-- Projection of a verified theta-covariance pair to its genuine
metaplectic element. -/
def thetaCovariantProjection :
    thetaCovariantSubgroup →*
      GenuineGamma2Metaplectic.Element where
  toFun p := (p : GenuineGamma2Metaplectic.Element × Circle).1
  map_one' := rfl
  map_mul' := fun _ _ => rfl

/-- The width-two lifted translation has trivial theta phase. -/
theorem translationTwo_isThetaCovariant :
    IsThetaCovariant ThetaGeneratorLift.translationTwoLift (1 : Circle) := by
  intro τ
  simpa only [GenuineGamma2Metaplectic.toGamma2_apply,
    Circle.coe_one, one_mul] using
    ThetaGeneratorLift.theta_translationTwoLift_covariance τ

/-- The explicit circle element whose complex value is `-I`. -/
noncomputable def centralNegOnePhase : Circle := by
  refine ⟨-Complex.I, ?_⟩
  change -Complex.I ∈ Metric.sphere (0 : ℂ) 1
  exact (mem_sphere_zero_iff_norm).mpr (by
    simp only [norm_neg, Complex.norm_I])

@[simp]
theorem centralNegOnePhase_coe :
    (centralNegOnePhase : ℂ) = -Complex.I := rfl

/-- The lifted central `-I` becomes theta-covariant exactly after supplying
the missing phase `-I`. -/
theorem centralNegOne_isThetaCovariant :
    IsThetaCovariant ThetaGeneratorLift.centralNegOneLift
      centralNegOnePhase := by
  intro τ
  have hm :
      ThetaGeneratorLift.centralNegOneLift.matrix =
        ThetaGeneratorLift.gamma2NegOne := rfl
  rw [hm, ThetaGeneratorLift.gamma2NegOne_act,
    centralNegOnePhase_coe,
    ThetaGeneratorLift.centralNegOneLift_sqrtFactor]
  rw [neg_mul, Complex.I_mul_I]
  simp

/-- The circle phase `-1` attached to the nontrivial deck involution. -/
noncomputable def deckNegPhase : Circle := by
  refine ⟨(-1 : ℂ), ?_⟩
  change (-1 : ℂ) ∈ Metric.sphere (0 : ℂ) 1
  exact (mem_sphere_zero_iff_norm).mpr (by norm_num)

@[simp]
theorem deckNegPhase_coe : (deckNegPhase : ℂ) = -1 := rfl

/-- The nontrivial deck lift over the identity matrix is theta-covariant after
the compensating phase `-1`. -/
theorem deckNeg_isThetaCovariant :
    IsThetaCovariant GenuineGamma2Metaplectic.deckNeg deckNegPhase := by
  intro τ
  rw [GenuineGamma2Metaplectic.deckNeg_matrix, gamma2Act_one,
    deckNegPhase_coe, GenuineGamma2Metaplectic.deckNeg_sqrtFactor]
  ring

/-- A nonzero theta value makes the circle phase unique for a fixed genuine
metaplectic element. -/
theorem thetaPhase_unique_of_nonzero
    {a : GenuineGamma2Metaplectic.Element} {η ξ : Circle}
    (hη : IsThetaCovariant a η) (hξ : IsThetaCovariant a ξ)
    {τ : UpperHalfPlane} (hθ : ConcreteUnaryTheta.theta τ ≠ 0) :
    η = ξ := by
  apply Circle.coe_injective
  have htail :
      a.sqrtFactor τ * ConcreteUnaryTheta.theta τ ≠ 0 :=
    mul_ne_zero (sqrtFactor_ne_zero a τ) hθ
  exact mul_right_cancel₀ htail (by
    simpa only [mul_assoc] using (hη τ).symm.trans (hξ τ))

/-- In particular, the central phase is forced to be the explicit `-I`
whenever theta is nonzero at one point. -/
theorem centralNegOnePhase_unique_of_nonzero
    {η : Circle}
    (hη : IsThetaCovariant ThetaGeneratorLift.centralNegOneLift η)
    {τ : UpperHalfPlane} (hθ : ConcreteUnaryTheta.theta τ ≠ 0) :
    η = centralNegOnePhase :=
  thetaPhase_unique_of_nonzero hη centralNegOne_isThetaCovariant hθ

/-! ### An explicit nonzero theta value

The phase-uniqueness argument needs only one nonzero theta value.  We obtain
one directly from Mathlib's explicit geometric-series bound, at the height
`log 4 / π`, where the exponential parameter is exactly `1/4`. -/

noncomputable def thetaNonzeroHeight : ℝ :=
  Real.log 4 / Real.pi

theorem thetaNonzeroHeight_pos : 0 < thetaNonzeroHeight := by
  exact div_pos (Real.log_pos (by norm_num)) Real.pi_pos

noncomputable def thetaNonzeroPoint : UpperHalfPlane := by
  refine ⟨(thetaNonzeroHeight : ℂ) * Complex.I, ?_⟩
  simpa using thetaNonzeroHeight_pos

@[simp]
theorem thetaNonzeroPoint_im :
    thetaNonzeroPoint.im = thetaNonzeroHeight := by
  simp [thetaNonzeroPoint]

@[simp]
theorem exp_neg_pi_mul_thetaNonzeroPoint_im :
    Real.exp (-Real.pi * thetaNonzeroPoint.im) = (1 / 4 : ℝ) := by
  rw [thetaNonzeroPoint_im]
  have hpi : Real.pi ≠ 0 := Real.pi_pos.ne'
  have harg :
      -Real.pi * thetaNonzeroHeight = -Real.log 4 := by
    simp only [thetaNonzeroHeight]
    field_simp [hpi]
  rw [harg, Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 4)]
  norm_num

/-- The standard unary theta function is nonzero at the explicit point of
height `log 4 / π`. -/
theorem theta_nonzero_at_thetaNonzeroPoint :
    ConcreteUnaryTheta.theta thetaNonzeroPoint ≠ 0 := by
  have hbound :
      ‖ConcreteUnaryTheta.theta thetaNonzeroPoint - 1‖ ≤
        2 /
            (1 - Real.exp
              (-Real.pi * thetaNonzeroPoint.im)) *
          Real.exp (-Real.pi * thetaNonzeroPoint.im) := by
    change
      ‖jacobiTheta (thetaNonzeroPoint : ℂ) - 1‖ ≤
        2 / (1 - Real.exp (-Real.pi * (thetaNonzeroPoint : ℂ).im)) *
          Real.exp (-Real.pi * (thetaNonzeroPoint : ℂ).im)
    exact norm_jacobiTheta_sub_one_le thetaNonzeroPoint.im_pos
  rw [exp_neg_pi_mul_thetaNonzeroPoint_im] at hbound
  have hlt :
      ‖ConcreteUnaryTheta.theta thetaNonzeroPoint - 1‖ < 1 :=
    hbound.trans_lt (by norm_num)
  intro hzero
  have : (1 : ℝ) < 1 := by simpa [hzero] using hlt
  exact (lt_irrefl (1 : ℝ)) this

/-- Phase uniqueness makes the projection from the covariance subgroup
injective. -/
theorem thetaCovariantProjection_injective :
    Function.Injective thetaCovariantProjection := by
  intro p q hpq
  have hbase :
      (p : GenuineGamma2Metaplectic.Element × Circle).1 =
        (q : GenuineGamma2Metaplectic.Element × Circle).1 := by
    change
      (p : GenuineGamma2Metaplectic.Element × Circle).1 =
        (q : GenuineGamma2Metaplectic.Element × Circle).1 at hpq
    exact hpq
  have hq :
      IsThetaCovariant
        (p : GenuineGamma2Metaplectic.Element × Circle).1
        (q : GenuineGamma2Metaplectic.Element × Circle).2 := by
    rw [hbase]
    exact q.property
  have hphase :
      (p : GenuineGamma2Metaplectic.Element × Circle).2 =
        (q : GenuineGamma2Metaplectic.Element × Circle).2 :=
    thetaPhase_unique_of_nonzero p.property hq
      theta_nonzero_at_thetaNonzeroPoint
  apply Subtype.ext
  exact Prod.ext hbase hphase

/-- Exact remaining global existence obligation for the standard theta
multiplier: every genuine element admits some covariant circle phase. -/
def FullThetaCovariance : Prop :=
  ∀ a : GenuineGamma2Metaplectic.Element,
    ∃ η : Circle, IsThetaCovariant a η

/-- Full theta covariance is exactly surjectivity of the already injective
covariance-subgroup projection. -/
theorem fullThetaCovariance_iff_projection_surjective :
    FullThetaCovariance ↔
      Function.Surjective thetaCovariantProjection := by
  constructor
  · intro hfull a
    obtain ⟨η, hη⟩ := hfull a
    exact ⟨⟨(a, η), hη⟩, rfl⟩
  · intro hsurj a
    obtain ⟨p, hp⟩ := hsurj a
    refine ⟨(p : GenuineGamma2Metaplectic.Element × Circle).2, ?_⟩
    have hbase :
        (p : GenuineGamma2Metaplectic.Element × Circle).1 = a := by
      change (p : GenuineGamma2Metaplectic.Element × Circle).1 = a at hp
      exact hp
    have hpCov := p.property
    change IsThetaCovariant
      (p : GenuineGamma2Metaplectic.Element × Circle).1
      (p : GenuineGamma2Metaplectic.Element × Circle).2 at hpCov
    rw [← hbase]
    exact hpCov

theorem fullThetaCovariance_iff_projection_bijective :
    FullThetaCovariance ↔
      Function.Bijective thetaCovariantProjection := by
  constructor
  · intro hfull
    exact ⟨thetaCovariantProjection_injective,
      fullThetaCovariance_iff_projection_surjective.mp hfull⟩
  · intro hbij
    exact fullThetaCovariance_iff_projection_surjective.mpr hbij.2

/-- A chosen phase under full theta covariance.  Its multiplicativity will be
derived from phase uniqueness rather than stored as an extra assumption. -/
noncomputable def chosenThetaPhase
    (hfull : FullThetaCovariance)
    (a : GenuineGamma2Metaplectic.Element) : Circle :=
  Classical.choose (hfull a)

theorem chosenThetaPhase_covariant
    (hfull : FullThetaCovariance)
    (a : GenuineGamma2Metaplectic.Element) :
    IsThetaCovariant a (chosenThetaPhase hfull a) :=
  Classical.choose_spec (hfull a)

theorem chosenThetaPhase_one
    (hfull : FullThetaCovariance)
    {τ : UpperHalfPlane} (hθ : ConcreteUnaryTheta.theta τ ≠ 0) :
    chosenThetaPhase hfull 1 = 1 :=
  thetaPhase_unique_of_nonzero
    (chosenThetaPhase_covariant hfull 1)
    isThetaCovariant_one hθ

theorem chosenThetaPhase_mul
    (hfull : FullThetaCovariance)
    {τ : UpperHalfPlane} (hθ : ConcreteUnaryTheta.theta τ ≠ 0)
    (a b : GenuineGamma2Metaplectic.Element) :
    chosenThetaPhase hfull (a * b) =
      chosenThetaPhase hfull a * chosenThetaPhase hfull b :=
  thetaPhase_unique_of_nonzero
    (chosenThetaPhase_covariant hfull (a * b))
    ((chosenThetaPhase_covariant hfull a).mul
      (chosenThetaPhase_covariant hfull b)) hθ

/-- Full covariance plus one nonzero theta value constructs the genuine
circle-valued multiplier character; no character law is postulated. -/
noncomputable def thetaMultiplierOfFullCovariance
    (hfull : FullThetaCovariance)
    (τ : UpperHalfPlane) (hθ : ConcreteUnaryTheta.theta τ ≠ 0) :
    Multiplier where
  toFun := chosenThetaPhase hfull
  map_one' := chosenThetaPhase_one hfull hθ
  map_mul' := chosenThetaPhase_mul hfull hθ

/-- The constructed character makes the standard theta function genuinely
automorphic on the full metaplectic group. -/
theorem theta_isAutomorphic_of_fullCovariance
    (hfull : FullThetaCovariance)
    (τ₀ : UpperHalfPlane) (hθ : ConcreteUnaryTheta.theta τ₀ ≠ 0) :
    IsAutomorphic
      (thetaMultiplierOfFullCovariance hfull τ₀ hθ)
      ConcreteUnaryTheta.theta := by
  intro a τ
  change ConcreteUnaryTheta.theta (gamma2Act a.matrix τ) =
    (chosenThetaPhase hfull a : ℂ) * a.sqrtFactor τ *
      ConcreteUnaryTheta.theta τ
  exact chosenThetaPhase_covariant hfull a τ

/-- The central value of the constructed theta character is forced, not
chosen: it equals the explicit phase `-I`. -/
theorem thetaMultiplierOfFullCovariance_central_value
    (hfull : FullThetaCovariance)
    (τ₀ : UpperHalfPlane) (hθ : ConcreteUnaryTheta.theta τ₀ ≠ 0) :
    ((thetaMultiplierOfFullCovariance hfull τ₀ hθ)
        ThetaGeneratorLift.centralNegOneLift : ℂ) = -Complex.I :=
  centralNegOne_multiplier_value_of_nonzero
    (theta_isAutomorphic_of_fullCovariance hfull τ₀ hθ) τ₀ hθ

/-- Canonical genuine theta multiplier once the sole remaining full-covariance
existence statement has been proved. -/
noncomputable def thetaMultiplier
    (hfull : FullThetaCovariance) : Multiplier :=
  thetaMultiplierOfFullCovariance hfull thetaNonzeroPoint
    theta_nonzero_at_thetaNonzeroPoint

theorem theta_isAutomorphic
    (hfull : FullThetaCovariance) :
    IsAutomorphic (thetaMultiplier hfull) ConcreteUnaryTheta.theta :=
  theta_isAutomorphic_of_fullCovariance hfull thetaNonzeroPoint
    theta_nonzero_at_thetaNonzeroPoint

theorem thetaMultiplier_central_value
    (hfull : FullThetaCovariance) :
    (thetaMultiplier hfull ThetaGeneratorLift.centralNegOneLift : ℂ) =
      -Complex.I :=
  thetaMultiplierOfFullCovariance_central_value hfull thetaNonzeroPoint
    theta_nonzero_at_thetaNonzeroPoint

@[simp]
theorem translationTwo_pair_mem_thetaCovariantSubmonoid :
    (ThetaGeneratorLift.translationTwoLift, (1 : Circle)) ∈
      thetaCovariantSubmonoid :=
  translationTwo_isThetaCovariant

@[simp]
theorem centralNegOne_pair_mem_thetaCovariantSubmonoid :
    (ThetaGeneratorLift.centralNegOneLift, centralNegOnePhase) ∈
      thetaCovariantSubmonoid :=
  centralNegOne_isThetaCovariant

@[simp]
theorem translationTwo_pair_mem_thetaCovariantSubgroup :
    (ThetaGeneratorLift.translationTwoLift, (1 : Circle)) ∈
      thetaCovariantSubgroup :=
  translationTwo_isThetaCovariant

@[simp]
theorem centralNegOne_pair_mem_thetaCovariantSubgroup :
    (ThetaGeneratorLift.centralNegOneLift, centralNegOnePhase) ∈
      thetaCovariantSubgroup :=
  centralNegOne_isThetaCovariant

@[simp]
theorem deckNeg_pair_mem_thetaCovariantSubgroup :
    (GenuineGamma2Metaplectic.deckNeg, deckNegPhase) ∈
      thetaCovariantSubgroup :=
  deckNeg_isThetaCovariant

end GenuineHalfWeightAutomorphy

/-! ## The inverse-half-weight convention used literally in Definition 1

The concrete unary theta function above uses the positive square-root
convention.  Definition 1 of the PDF instead writes
`ν(γ) (cτ+d)⁻¹ᐟ²`.  These conventions cannot be identified by a circle-valued
multiplier because their absolute values differ.  The following independent
namespace constructs the literal inverse-square-root cocycle and its correct
Petersson density.  In particular, the invariant scalar density is
`y⁻¹ᐟ² |u|²`, not the unweighted `|u|²` appearing in the PDF's quotient
integral. -/

namespace GenuineInverseHalfWeightAutomorphy

open GenuineGamma2Metaplectic

abbrev Multiplier := GenuineHalfWeightAutomorphy.Multiplier

/-- Literal inverse-half-weight factor `ν(a) / sqrt(cτ+d)`. -/
noncomputable def factor
    (ν : Multiplier) (a : Element) (τ : UpperHalfPlane) : ℂ :=
  (ν a : ℂ) * (a.sqrtFactor τ)⁻¹

@[simp]
theorem factor_one (ν : Multiplier) (τ : UpperHalfPlane) :
    factor ν 1 τ = 1 := by
  simp [factor]

theorem factor_ne_zero
    (ν : Multiplier) (a : Element) (τ : UpperHalfPlane) :
    factor ν a τ ≠ 0 := by
  exact mul_ne_zero
    (GenuineHalfWeightAutomorphy.circle_coe_ne_zero (ν a))
    (inv_ne_zero (sqrtFactor_ne_zero a τ))

theorem continuous_factor (ν : Multiplier) (a : Element) :
    Continuous (factor ν a) := by
  exact continuous_const.mul
    (a.continuous_sqrtFactor.inv₀ (sqrtFactor_ne_zero a))

/-- Exact cocycle for the inverse-square-root convention. -/
theorem factor_mul
    (ν : Multiplier) (a b : Element) (τ : UpperHalfPlane) :
    factor ν (a * b) τ =
      factor ν a (gamma2Act b.matrix τ) * factor ν b τ := by
  change
    (ν (a * b) : ℂ) *
        (a.sqrtFactor (gamma2Act b.matrix τ) * b.sqrtFactor τ)⁻¹ =
      ((ν a : ℂ) * (a.sqrtFactor (gamma2Act b.matrix τ))⁻¹) *
        ((ν b : ℂ) * (b.sqrtFactor τ)⁻¹)
  rw [map_mul, Circle.coe_mul, mul_inv_rev]
  ring

/-- Pointwise inverse-half-weight automorphy. -/
def IsAutomorphic
    (ν : Multiplier) (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ a τ, u (gamma2Act a.matrix τ) = factor ν a τ * u τ

/-- Completion-stable inverse-half-weight automorphy. -/
def IsAEAutomorphic
    (ν : Multiplier) (μ : Measure UpperHalfPlane)
    (u : UpperHalfPlane → ℂ) : Prop :=
  ∀ a, ∀ᵐ τ ∂μ,
    u (gamma2Act a.matrix τ) = factor ν a τ * u τ

theorem IsAutomorphic.isAE
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u) (μ : Measure UpperHalfPlane) :
    IsAEAutomorphic ν μ u := by
  intro a
  exact Filter.Eventually.of_forall (hu a)

/-- Correct Petersson density for a field transforming by the inverse
square-root convention. -/
noncomputable def density (τ : UpperHalfPlane) (u : ℂ) : ℝ :=
  (Real.sqrt τ.im)⁻¹ * ‖u‖ ^ 2

theorem density_nonneg (τ : UpperHalfPlane) (u : ℂ) :
    0 ≤ density τ u :=
  mul_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) (sq_nonneg _)

theorem density_sq (τ : UpperHalfPlane) (u : ℂ) :
    density τ u ^ 2 = (τ.im)⁻¹ * ‖u‖ ^ 4 := by
  unfold density
  rw [mul_pow, inv_pow, Real.sq_sqrt τ.im_pos.le]
  ring

theorem norm_covariantValue
    (a : Element) (η : Circle) (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * (a.sqrtFactor τ)⁻¹ * u) :
    ‖u'‖ = ‖a.sqrtFactor τ‖⁻¹ * ‖u‖ := by
  rw [hu', norm_mul, norm_mul, Circle.norm_coe, one_mul, norm_inv]

/-- Squared inverse-weight density invariance, derived from the exact height
transformation and not postulated as a quotient-space axiom. -/
theorem inv_im_mul_norm_pow_four_invariant
    (a : Element) (η : Circle) (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * (a.sqrtFactor τ)⁻¹ * u) :
    (gamma2Act a.matrix τ).im⁻¹ * ‖u'‖ ^ 4 =
      τ.im⁻¹ * ‖u‖ ^ 4 := by
  rw [im_gamma2Act_eq_div_norm_sqrtFactor_pow_four a,
    norm_covariantValue a η τ u u' hu']
  have hs : ‖a.sqrtFactor τ‖ ≠ 0 :=
    norm_ne_zero_iff.mpr (sqrtFactor_ne_zero a τ)
  have hy : τ.im ≠ 0 := τ.im_pos.ne'
  field_simp [hs, hy]
  <;> ring

/-- Exact inverse-half-weight Petersson-density invariance. -/
theorem density_invariant
    (a : Element) (η : Circle) (τ : UpperHalfPlane) (u u' : ℂ)
    (hu' : u' = (η : ℂ) * (a.sqrtFactor τ)⁻¹ * u) :
    density (gamma2Act a.matrix τ) u' = density τ u := by
  apply (sq_eq_sq₀
    (density_nonneg (gamma2Act a.matrix τ) u')
    (density_nonneg τ u)).mp
  rw [density_sq, density_sq]
  exact inv_im_mul_norm_pow_four_invariant a η τ u u' hu'

/-- Automorphic inverse-half-weight sections have invariant corrected density. -/
theorem IsAutomorphic.density_invariant
    {ν : Multiplier} {u : UpperHalfPlane → ℂ}
    (hu : IsAutomorphic ν u) (a : Element) (τ : UpperHalfPlane) :
    density (gamma2Act a.matrix τ)
        (u (gamma2Act a.matrix τ)) = density τ (u τ) := by
  exact GenuineInverseHalfWeightAutomorphy.density_invariant
    a (ν a) τ (u τ)
    (u (gamma2Act a.matrix τ)) <| by
      simpa only [factor] using hu a τ

/-- A nonzero value can preserve the *unweighted* pointwise norm only when
the square-root denominator has norm one.  Thus plain `|u|² dμ` cannot be the
general quotient density for the PDF's inverse-half-weight law. -/
theorem sqrtFactor_norm_inv_eq_one_of_plainNormInvariant
    (a : Element) (η : Circle) (τ : UpperHalfPlane) (u u' : ℂ)
    (hu : u ≠ 0)
    (hu' : u' = (η : ℂ) * (a.sqrtFactor τ)⁻¹ * u)
    (hnorm : ‖u'‖ = ‖u‖) :
    ‖a.sqrtFactor τ‖⁻¹ = 1 := by
  have hmul : ‖a.sqrtFactor τ‖⁻¹ * ‖u‖ = 1 * ‖u‖ := by
    rw [← norm_covariantValue a η τ u u' hu', hnorm, one_mul]
  exact mul_right_cancel₀ (norm_ne_zero_iff.mpr hu) hmul

/-- Under the literal inverse-square-root convention, central compatibility is
the opposite phase: the chosen `-I` lift has total factor one exactly when the
multiplier value is `I`. -/
theorem centralNegOne_factor_eq_one_iff
    (ν : Multiplier) (τ : UpperHalfPlane) :
    factor ν ThetaGeneratorLift.centralNegOneLift τ = 1 ↔
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) = Complex.I := by
  constructor
  · intro hf
    have hphase :
        (ν ThetaGeneratorLift.centralNegOneLift : ℂ) * Complex.I⁻¹ = 1 := by
      simpa only [factor,
        ThetaGeneratorLift.centralNegOneLift_sqrtFactor] using hf
    apply mul_right_cancel₀ (inv_ne_zero Complex.I_ne_zero)
    calc
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) * Complex.I⁻¹ = 1 := hphase
      _ = Complex.I * Complex.I⁻¹ :=
        (mul_inv_cancel₀ Complex.I_ne_zero).symm
  · intro hν
    rw [factor, ThetaGeneratorLift.centralNegOneLift_sqrtFactor, hν]
    exact mul_inv_cancel₀ Complex.I_ne_zero

theorem centralNegOne_factor_ne_one_of_bad_phase
    (ν : Multiplier)
    (hν : (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ Complex.I)
    (τ : UpperHalfPlane) :
    factor ν ThetaGeneratorLift.centralNegOneLift τ ≠ 1 := by
  exact fun hf => hν ((centralNegOne_factor_eq_one_iff ν τ).1 hf)

end GenuineInverseHalfWeightAutomorphy

/-! ## Genuine weighted automorphic Sobolev completion

This is the metaplectically correct *typed interface* for Definition 1.  It
does not yet construct the hyperbolic `L²` quotient, smooth compact core, or
closed differential operators.  For supplied graph-norm Hilbert data, its
core is equivariant under the genuine group and the completion retains the
a.e. law because closedness of that locus is an explicit analytic obligation. -/

namespace GenuineWeightedSobolev

open GenuineHalfWeightAutomorphy

/-- Required graph-norm data for a future genuine weight-one-half automorphic
Sobolev construction.  In particular, `ae_equivariant_closed` is not derived
by this structure. -/
structure Datum
    (ν : Multiplier) (μ : Measure UpperHalfPlane)
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  core : Submodule ℂ H
  toFunction : H →ₗ[ℂ] (UpperHalfPlane → ℂ)
  toFunction_injective : Function.Injective toFunction
  l2Energy : H → ℝ
  raisingEnergy : H → ℝ
  loweringEnergy : H → ℝ
  l2Energy_nonneg : ∀ u, 0 ≤ l2Energy u
  raisingEnergy_nonneg : ∀ u, 0 ≤ raisingEnergy u
  loweringEnergy_nonneg : ∀ u, 0 ≤ loweringEnergy u
  norm_sq_eq_energy : ∀ u,
    ‖u‖ ^ 2 = l2Energy u + raisingEnergy u + loweringEnergy u
  core_equivariant :
    ∀ u ∈ core, GenuineInverseHalfWeightAutomorphy.IsAutomorphic ν (toFunction u)
  ae_equivariant_closed :
    IsClosed {u : H | GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic ν μ (toFunction u)}

/-- The genuine weighted automorphic Sobolev space is the closure of its
smooth equivariant energy core. -/
def space
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) : Submodule ℂ H :=
  M.core.topologicalClosure

theorem core_le_space
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :
    M.core ≤ space M :=
  M.core.le_topologicalClosure

theorem isClosed_space
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :
    IsClosed (space M : Set H) :=
  M.core.isClosed_topologicalClosure

/-- Every vector in the genuine graph-norm completion retains an a.e.
automorphic representative. -/
theorem space_ae
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : space M) :
    GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic ν μ (M.toFunction (u : H)) := by
  have hclosure :
      closure (↑M.core : Set H) ⊆
        {v : H | GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic ν μ (M.toFunction v)} :=
    closure_minimal
      (by
        intro v hv
        exact (M.core_equivariant v hv).isAE μ)
      M.ae_equivariant_closed
  apply hclosure
  rw [← Submodule.topologicalClosure_coe]
  exact u.property

/-- Smooth compact-core test vectors. -/
abbrev CoreTestSpace
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :=
  ↥M.core

/-- The completed genuine trial space. -/
abbrev TrialSpace
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :=
  ↥(space M)

/-- The canonical continuous inclusion of the smooth core into its closure. -/
def coreToTrial
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :
    CoreTestSpace M →L[ℂ] TrialSpace M :=
  M.core.subtypeL.codRestrict
    (space M) (fun u => M.core.le_topologicalClosure u.property)

/-- The smooth equivariant core is dense in the genuine trial space by its
definition as a topological closure. -/
theorem denseRange_coreToTrial
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) :
    DenseRange (coreToTrial M) := by
  change DenseRange (Set.inclusion M.core.le_topologicalClosure)
  rw [denseRange_inclusion_iff]
  · intro x hx
    exact hx
  · intro x hx
    exact M.core.le_topologicalClosure hx

/-- The sum of the three genuine graph-energy components. -/
def Datum.graphEnergy
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : H) : ℝ :=
  M.l2Energy u + M.raisingEnergy u + M.loweringEnergy u

@[simp]
theorem Datum.graphEnergy_eq_norm_sq
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : H) :
    M.graphEnergy u = ‖u‖ ^ 2 :=
  (M.norm_sq_eq_energy u).symm

theorem Datum.graphEnergy_nonneg
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : H) :
    0 ≤ M.graphEnergy u := by
  rw [M.graphEnergy_eq_norm_sq]
  positivity

@[simp]
theorem Datum.graphEnergy_eq_zero_iff
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : H) :
    M.graphEnergy u = 0 ↔ u = 0 := by
  rw [M.graphEnergy_eq_norm_sq]
  simp

theorem Datum.sqrt_graphEnergy_eq_norm
    {ν : Multiplier} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : Datum ν μ H) (u : H) :
    Real.sqrt (M.graphEnergy u) = ‖u‖ := by
  rw [M.graphEnergy_eq_norm_sq, Real.sqrt_sq_eq_abs,
    abs_of_nonneg (norm_nonneg u)]

end GenuineWeightedSobolev

namespace StartingIntegralIdentity

/-- Restriction of a dual vector to a continuously embedded test space. -/
def restrictDual
    {T V : Type*}
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (incl : T →L[ℂ] V) (f : V →L[ℂ] ℂ) : T →L[ℂ] ℂ :=
  f.comp incl

@[simp]
theorem restrictDual_apply
    {T V : Type*}
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (incl : T →L[ℂ] V) (f : V →L[ℂ] ℂ) (t : T) :
    restrictDual incl f t = f (incl t) :=
  rfl

/-- Restriction of distributions is functorial under composition of continuous
test-space inclusions.  This is the categorical content needed when a compact
test core is first included in a local trial space and then in the global one. -/
@[simp]
theorem restrictDual_comp
    {T U V : Type*}
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup U] [NormedSpace ℂ U]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (includeTU : T →L[ℂ] U) (includeUV : U →L[ℂ] V)
    (f : V →L[ℂ] ℂ) :
    restrictDual includeTU (restrictDual includeUV f) =
      restrictDual (includeUV.comp includeTU) f := by
  ext t
  rfl

/-- Restricting a distribution along the identity inclusion changes nothing. -/
@[simp]
theorem restrictDual_id
    {V : Type*}
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (f : V →L[ℂ] ℂ) :
    restrictDual (ContinuousLinearMap.id ℂ V) f = f := by
  ext v
  rfl

/-- A continuously embedded test space with compact support recorded in an
actual realization on the base space. -/
structure CompactTestInclusion
    (X T V : Type*) [TopologicalSpace X]
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V] where
  «include» : T →L[ℂ] V
  include_injective : Function.Injective «include»
  realization : V →ₗ[ℂ] (X → ℂ)
  testRealization : T →ₗ[ℂ] (X → ℂ)
  realization_include : ∀ t,
    realization («include» t) = testRealization t
  compact_support : ∀ t,
    HasCompactSupport (testRealization t)

/-- The abstract inclusion and the pointwise test realization commute. -/
@[simp]
theorem CompactTestInclusion.realization_include_apply
    {X T V : Type*} [TopologicalSpace X]
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (I : CompactTestInclusion X T V) (t : T) :
    I.realization (I.«include» t) = I.testRealization t :=
  I.realization_include t

/-- **Corrected Lemma 1.1, distributional form.** Equality of the weak
Laplacian-plus-potential with the datum in `V'` remains valid after restriction
to any continuously embedded test space.  Compact support is additional caller
data, used only by the regular-density corollary below. -/
theorem restrict_dual_equation
    {T V : Type*}
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (incl : T →L[ℂ] V)
    {laplace potential rhs : V →L[ℂ] ℂ}
    (hweak : laplace + potential = rhs) :
    restrictDual incl (laplace + potential) = restrictDual incl rhs :=
  congrArg (fun g : V →L[ℂ] ℂ => g.comp incl) hweak

/-- Compact-test specialization of corrected Lemma 1.1.  Compactness is
proof-carrying data in `CompactTestInclusion`, while the distributional
restriction equality itself remains functorial composition in `V'`. -/
theorem restrict_dual_equation_compact
    {X T V : Type*} [TopologicalSpace X]
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (I : CompactTestInclusion X T V)
    {laplace potential rhs : V →L[ℂ] ℂ}
    (hweak : laplace + potential = rhs) :
    restrictDual I.«include» (laplace + potential) =
      restrictDual I.«include» rhs :=
  restrict_dual_equation I.«include» hweak

theorem restricted_dual_pairing
    {T V : Type*}
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (incl : T →L[ℂ] V)
    {laplace potential rhs : V →L[ℂ] ℂ}
    (hweak : laplace + potential = rhs) (t : T) :
    restrictDual incl rhs t =
      restrictDual incl laplace t + restrictDual incl potential t := by
  rw [← hweak]
  simp [restrictDual]

/-- Regular integral representatives for the two *specific* dual summands in
Lemma 1.1.  The weak equation remains an external premise and the final
integral identity is derived below; it is not stored in this structure. -/
structure RegularDensityData
    (X V : Type*) [MeasurableSpace X]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (laplace potential rhs : V →L[ℂ] ℂ) where
  measure : Measure X
  kinetic : V →ₗ[ℂ] (X → ℂ)
  potentialDensity : V →ₗ[ℂ] (X → ℂ)
  kinetic_integrable : ∀ v, Integrable (kinetic v) measure
  potential_integrable : ∀ v,
    Integrable (potentialDensity v) measure
  laplace_eq_integral : ∀ v,
    laplace v = ∫ x, kinetic v x ∂measure
  potential_eq_integral : ∀ v,
    potential v = ∫ x, potentialDensity v x ∂measure

/-- The pointwise integral representation follows from the `V'` equation only
after regular representatives of both dual summands have been supplied. -/
theorem regular_density_equation
    {X V : Type*} [MeasurableSpace X]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    {laplace potential rhs : V →L[ℂ] ℂ}
    (D : RegularDensityData X V laplace potential rhs)
    (hweak : laplace + potential = rhs) (v : V) :
    rhs v =
      (∫ x, D.kinetic v x ∂D.measure) +
        (∫ x, D.potentialDensity v x ∂D.measure) := by
  calc
    rhs v = (laplace + potential) v := by rw [hweak]
    _ = laplace v + potential v := by
      rw [ContinuousLinearMap.add_apply]
    _ = (∫ x, D.kinetic v x ∂D.measure) +
          (∫ x, D.potentialDensity v x ∂D.measure) := by
      rw [D.laplace_eq_integral v, D.potential_eq_integral v]

/-- An integrand that vanishes off a set has the same global and restricted
Bochner integrals. -/
theorem integral_eq_setIntegral_of_zero_off
    {X E : Type*} [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {F : Set X} {f : X → E}
    (hzero : ∀ x, x ∉ F → f x = 0) :
    (∫ x, f x ∂μ) = ∫ x in F, f x ∂μ :=
  (setIntegral_eq_integral_of_forall_compl_eq_zero hzero).symm

/-- The tested-product densities occurring in the paper vanish automatically
where the test function vanishes. -/
theorem mul_star_eq_zero_of_test_eq_zero
    {X : Type*} (A φ : X → ℂ) {x : X}
    (hx : φ x = 0) :
    A x * (starRingEnd ℂ) (φ x) = 0 := by
  simp [hx]

/-- Integral-representation corollary to corrected Lemma 1.1.  A regular-density
equation restricts to a truncation when both tested integrands vanish off it. -/
theorem restrict_distributional_equation
    {X V : Type*} [MeasurableSpace X]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    {laplace potential rhs : V →L[ℂ] ℂ}
    (D : RegularDensityData X V laplace potential rhs)
    (hweak : laplace + potential = rhs)
    (F : Set X) (v : V)
    (hkinetic : ∀ x, x ∉ F → D.kinetic v x = 0)
    (hpotential : ∀ x, x ∉ F → D.potentialDensity v x = 0) :
    rhs v =
      (∫ x in F, D.kinetic v x ∂D.measure) +
        (∫ x in F, D.potentialDensity v x ∂D.measure) := by
  calc
    rhs v =
        (∫ x, D.kinetic v x ∂D.measure) +
          (∫ x, D.potentialDensity v x ∂D.measure) :=
      regular_density_equation D hweak v
    _ = (∫ x in F, D.kinetic v x ∂D.measure) +
          (∫ x in F, D.potentialDensity v x ∂D.measure) := by
      rw [integral_eq_setIntegral_of_zero_off hkinetic,
        integral_eq_setIntegral_of_zero_off hpotential]

/-- Compact-support specialization.  Locality of the two regular density
representatives with respect to the compatible pointwise test realization is
stated explicitly; compact support alone cannot imply it for arbitrary
densities. -/
theorem restrict_distributional_equation_compactSupport
    {X T V : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (I : CompactTestInclusion X T V)
    {laplace potential rhs : V →L[ℂ] ℂ}
    (D : RegularDensityData X V laplace potential rhs)
    (hweak : laplace + potential = rhs) (t : T)
    (hkinetic_local : ∀ x,
      I.testRealization t x = 0 → D.kinetic (I.«include» t) x = 0)
    (hpotential_local : ∀ x,
      I.testRealization t x = 0 →
        D.potentialDensity (I.«include» t) x = 0) :
    IsCompact (tsupport (I.testRealization t)) ∧
      rhs (I.«include» t) =
        (∫ x in tsupport (I.testRealization t),
          D.kinetic (I.«include» t) x ∂D.measure) +
        (∫ x in tsupport (I.testRealization t),
          D.potentialDensity (I.«include» t) x ∂D.measure) := by
  refine ⟨I.compact_support t, ?_⟩
  apply restrict_distributional_equation D hweak
  · intro x hx
    exact hkinetic_local x (image_eq_zero_of_notMem_tsupport hx)
  · intro x hx
    exact hpotential_local x (image_eq_zero_of_notMem_tsupport hx)

/-- Paper-facing regularity corollary for densities of the exact forms
`A · conj(test)` and `B · conj(test)`.  Once these product representations are
supplied, compact-test locality is derived rather than assumed separately. -/
theorem restrict_distributional_equation_compactSupport_of_product
    {X T V : Type*} [TopologicalSpace X] [MeasurableSpace X]
    [NormedAddCommGroup T] [NormedSpace ℂ T]
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    (I : CompactTestInclusion X T V)
    {laplace potential rhs : V →L[ℂ] ℂ}
    (D : RegularDensityData X V laplace potential rhs)
    (hweak : laplace + potential = rhs) (t : T)
    (A B : X → ℂ)
    (hkinetic : ∀ x,
      D.kinetic (I.«include» t) x =
        A x * (starRingEnd ℂ) (I.testRealization t x))
    (hpotential : ∀ x,
      D.potentialDensity (I.«include» t) x =
        B x * (starRingEnd ℂ) (I.testRealization t x)) :
    IsCompact (tsupport (I.testRealization t)) ∧
      rhs (I.«include» t) =
        (∫ x in tsupport (I.testRealization t),
          D.kinetic (I.«include» t) x ∂D.measure) +
        (∫ x in tsupport (I.testRealization t),
          D.potentialDensity (I.«include» t) x ∂D.measure) := by
  apply restrict_distributional_equation_compactSupport I D hweak t
  · intro x hx
    rw [hkinetic x]
    exact mul_star_eq_zero_of_test_eq_zero A (I.testRealization t) hx
  · intro x hx
    rw [hpotential x]
    exact mul_star_eq_zero_of_test_eq_zero B (I.testRealization t) hx

end StartingIntegralIdentity

namespace GlobalPoincare

/-- An unqualified norm Poincare estimate for two energy operators.  This
minimal schema is used only to state the zero-mode obstruction precisely. -/
def PoincareEstimate
    {H HR HL : Type*} [Norm H] [Norm HR] [Norm HL]
    (R : H → HR) (L : H → HL) (C : ℝ) : Prop :=
  ∀ u, ‖u‖ ≤ C * (‖R u‖ + ‖L u‖)

/-- Any common kernel vector in an unqualified Poincare estimate must vanish. -/
theorem PoincareEstimate.eq_zero_of_common_kernel
    {H HR HL : Type*}
    [NormedAddCommGroup H] [NormedAddCommGroup HR]
    [NormedAddCommGroup HL]
    {R : H → HR} {L : H → HL} {C : ℝ}
    (h : PoincareEstimate R L C) {u : H}
    (hR : R u = 0) (hL : L u = 0) : u = 0 := by
  have hu : ‖u‖ ≤ 0 := by
    simpa [PoincareEstimate, hR, hL] using h u
  exact norm_eq_zero.mp (le_antisymm hu (norm_nonneg _))

/-- A concrete countermodel to an unqualified full-space Poincare assertion:
zero/residual modes cannot be retained when both energy operators kill them. -/
theorem unqualifiedPoincareSchema_false :
    ¬ ∃ C : ℝ, PoincareEstimate
      (fun _ : ℂ => (0 : ℂ)) (fun _ : ℂ => (0 : ℂ)) C := by
  rintro ⟨C, hC⟩
  have h : (1 : ℂ) = 0 :=
    hC.eq_zero_of_common_kernel (u := (1 : ℂ)) rfl rfl
  norm_num at h

/-- A nonnegative self-adjoint, possibly unbounded operator. -/
structure NonnegativeSelfAdjointData
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  operator : H →ₗ.[ℂ] H
  selfAdjoint : IsSelfAdjoint operator
  nonnegative : ∀ u : operator.domain,
    0 ≤ Complex.re (inner ℂ (operator u) (u : H))

/-- A spectral-form representation on a quadratic-form domain.  General unbounded
spectral measures are not currently supplied by Mathlib, so constructing this
package is a concrete automorphic obligation rather than an implicit theorem. -/
structure SpectralMeasureData
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (S : NonnegativeSelfAdjointData H) where
  formDomain : Submodule ℂ H
  operatorDomain_le_formDomain : S.operator.domain ≤ formDomain
  measure : formDomain → Measure ℝ
  one_integrable : ∀ u, Integrable (fun _ : ℝ => (1 : ℝ)) (measure u)
  id_integrable : ∀ u, Integrable (fun lam : ℝ => lam) (measure u)
  mass_eq_norm_sq : ∀ u,
    (∫ _ : ℝ, (1 : ℝ) ∂measure u) = ‖(u : H)‖ ^ 2
  energy_eq_operator : ∀ u : S.operator.domain,
    (∫ lam : ℝ, lam ∂measure
      ⟨(u : H), operatorDomain_le_formDomain u.property⟩) =
      Complex.re (inner ℂ (S.operator u) (u : H))
  spectrum_nonnegative : ∀ u,
    ∀ᵐ lam ∂measure u, 0 ≤ lam

/-- A positive spectral lower bound on an explicit reduced form domain.  The
`excludedModes` field names the zero, residual, or continuous modes removed in
the application, and `orthogonal_to_excluded` records that removal rather than
hiding it in an impossible full-domain gap hypothesis. -/
structure SpectralGapData
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) where
  excludedModes : Submodule ℂ H
  admissible : Submodule ℂ M.formDomain
  orthogonal_to_excluded : ∀ u : admissible, ∀ v : excludedModes,
    inner ℂ (v : H) ((u.1 : M.formDomain) : H) = 0
  gap : ℝ
  gap_pos : 0 < gap
  lower_bound : ∀ u : admissible,
    ∀ᵐ lam ∂M.measure u.1, gap ≤ lam

noncomputable def SpectralMeasureData.energy
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (u : M.formDomain) : ℝ :=
  ∫ lam : ℝ, lam ∂M.measure u

/-- A raising/lowering factorization of the quadratic form. -/
structure RaisingLoweringData
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    {S : NonnegativeSelfAdjointData H} (M : SpectralMeasureData S)
    (HR HL : Type*)
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL] where
  raising : M.formDomain →ₗ[ℂ] HR
  lowering : M.formDomain →ₗ[ℂ] HL
  coefficient : ℝ
  coefficient_pos : 0 < coefficient
  energy_identity : ∀ u,
    coefficient * M.energy u =
      ‖raising u‖ ^ 2 + ‖lowering u‖ ^ 2

/-- Concrete target interface for the weight-half automorphic Laplacian.  It
ties the abstract self-adjoint operator and form domain to the corrected
automorphic Sobolev completion, and records zero and residual modes separately
before taking their common orthogonal complement. -/
structure HalfWeightAutomorphicLaplacianData
    (J : HalfWeightAutomorphyFactor) (μ : Measure UpperHalfPlane)
    (H HR HL : Type*)
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL] where
  sobolev : WeightedSobolevDatum J μ H
  laplacian : NonnegativeSelfAdjointData H
  spectral : SpectralMeasureData laplacian
  gapData : SpectralGapData spectral
  factorization : RaisingLoweringData spectral HR HL
  /-- Prevents the target package from being inhabited by a zero admissible
  subspace.  A concrete automorphic instance must exhibit an actual normalized
  mode after removal of the zero and residual spectrum. -/
  normalizedAdmissibleMode : ∃ a : gapData.admissible,
    ‖(a.1 : H)‖ = 1
  /-- Every smooth automorphic core vector lies in the closed Laplacian's
  operator domain. -/
  core_le_operatorDomain : ∀ u : sobolev.core,
    (u : H) ∈ laplacian.operator.domain
  /-- On the smooth automorphic core, the normalized operator quadratic form
  is exactly the sum of the two geometric energy components used to define the
  Sobolev norm.  Constructing this identity for the differential weight-half
  Laplacian is a concrete obligation. -/
  core_laplacian_energy : ∀ u : sobolev.core,
    factorization.coefficient * Complex.re
        (inner ℂ
          (laplacian.operator
            ⟨(u : H), core_le_operatorDomain u⟩)
          (u : H)) =
      sobolev.raisingEnergy (u : H) +
        sobolev.loweringEnergy (u : H)
  raisingEnergy_eq : ∀ u : spectral.formDomain,
    sobolev.raisingEnergy (u : H) =
      ‖factorization.raising u‖ ^ 2
  loweringEnergy_eq : ∀ u : spectral.formDomain,
    sobolev.loweringEnergy (u : H) =
      ‖factorization.lowering u‖ ^ 2
  formDomain_eq :
    spectral.formDomain = weightedAutomorphicSobolev sobolev
  zeroModes : Submodule ℂ H
  residualModes : Submodule ℂ H
  excludedModes_eq :
    gapData.excludedModes = zeroModes ⊔ residualModes
  admissible_of_mode_orthogonal : ∀ u : spectral.formDomain,
    (∀ v : zeroModes, inner ℂ (v : H) (u : H) = 0) →
    (∀ v : residualModes, inner ℂ (v : H) (u : H) = 0) →
    ∃ a : gapData.admissible,
      (a.1 : spectral.formDomain) = u

/-- Metaplectically correct target interface for the weight-one-half
automorphic Laplacian.  Unlike `HalfWeightAutomorphicLaplacianData`, this
package is defined directly over a genuine multiplier character and therefore
does not require a nonexistent group-homomorphic section over `Gamma(2)`. -/
structure GenuineHalfWeightAutomorphicLaplacianData
    (ν : GenuineHalfWeightAutomorphy.Multiplier)
    (μ : Measure UpperHalfPlane)
    (H HR HL : Type*)
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL] where
  sobolev : GenuineWeightedSobolev.Datum ν μ H
  laplacian : NonnegativeSelfAdjointData H
  spectral : SpectralMeasureData laplacian
  gapData : SpectralGapData spectral
  factorization : RaisingLoweringData spectral HR HL
  /-- The reduced spectral subspace contains an actual normalized mode. -/
  normalizedAdmissibleMode : ∃ a : gapData.admissible,
    ‖(a.1 : H)‖ = 1
  /-- Every smooth genuine-automorphic core vector belongs to the closed
  Laplacian's operator domain. -/
  core_le_operatorDomain : ∀ u : sobolev.core,
    (u : H) ∈ laplacian.operator.domain
  /-- The differential Laplacian form agrees on the smooth core with the two
  stored raising/lowering energy components. -/
  core_laplacian_energy : ∀ u : sobolev.core,
    factorization.coefficient * Complex.re
        (inner ℂ
          (laplacian.operator
            ⟨(u : H), core_le_operatorDomain u⟩)
          (u : H)) =
      sobolev.raisingEnergy (u : H) +
        sobolev.loweringEnergy (u : H)
  raisingEnergy_eq : ∀ u : spectral.formDomain,
    sobolev.raisingEnergy (u : H) =
      ‖factorization.raising u‖ ^ 2
  loweringEnergy_eq : ∀ u : spectral.formDomain,
    sobolev.loweringEnergy (u : H) =
      ‖factorization.lowering u‖ ^ 2
  formDomain_eq :
    spectral.formDomain = GenuineWeightedSobolev.space sobolev
  zeroModes : Submodule ℂ H
  residualModes : Submodule ℂ H
  excludedModes_eq :
    gapData.excludedModes = zeroModes ⊔ residualModes
  admissible_of_mode_orthogonal : ∀ u : spectral.formDomain,
    (∀ v : zeroModes, inner ℂ (v : H) (u : H) = 0) →
    (∀ v : residualModes, inner ℂ (v : H) (u : H) = 0) →
    ∃ a : gapData.admissible,
      (a.1 : spectral.formDomain) = u

/-- The genuine target package cannot hide a zero admissible form domain. -/
theorem GenuineHalfWeightAutomorphicLaplacianData.exists_nonzero_admissibleMode
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (D : GenuineHalfWeightAutomorphicLaplacianData ν μ H HR HL) :
    ∃ a : D.gapData.admissible, (a.1 : H) ≠ 0 := by
  rcases D.normalizedAdmissibleMode with ⟨a, ha⟩
  refine ⟨a, fun hzero => ?_⟩
  have : (0 : ℝ) = 1 := by simpa [hzero] using ha
  norm_num at this

/-- The weight-half target package is definitionally nonvacuous on its reduced
form domain. -/
theorem HalfWeightAutomorphicLaplacianData.exists_nonzero_admissibleMode
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (D : HalfWeightAutomorphicLaplacianData J μ H HR HL) :
    ∃ a : D.gapData.admissible, (a.1 : H) ≠ 0 := by
  rcases D.normalizedAdmissibleMode with ⟨a, ha⟩
  refine ⟨a, fun hzero => ?_⟩
  have : (0 : ℝ) = 1 := by simpa [hzero] using ha
  norm_num at this

/-- Every admissible mode is orthogonal to the explicitly named zero modes. -/
theorem HalfWeightAutomorphicLaplacianData.admissible_orthogonal_zeroModes
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (a : A.gapData.admissible) (v : A.zeroModes) :
    inner ℂ (v : H) ((a.1 : A.spectral.formDomain) : H) = 0 := by
  let w : A.gapData.excludedModes :=
    ⟨(v : H), by
      rw [A.excludedModes_eq]
      exact (le_sup_left : A.zeroModes ≤
        A.zeroModes ⊔ A.residualModes) v.property⟩
  exact A.gapData.orthogonal_to_excluded a w

/-- Every admissible mode is orthogonal to the explicitly named residual
modes as well. -/
theorem HalfWeightAutomorphicLaplacianData.admissible_orthogonal_residualModes
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (a : A.gapData.admissible) (v : A.residualModes) :
    inner ℂ (v : H) ((a.1 : A.spectral.formDomain) : H) = 0 := by
  let w : A.gapData.excludedModes :=
    ⟨(v : H), by
      rw [A.excludedModes_eq]
      exact (le_sup_right : A.residualModes ≤
        A.zeroModes ⊔ A.residualModes) v.property⟩
  exact A.gapData.orthogonal_to_excluded a w

/-- The reduced form domain is exactly the common orthogonal complement of
the zero and residual mode subspaces.  This closes the bookkeeping loop used
identically by Lemmas 1.2 and 2.1. -/
theorem HalfWeightAutomorphicLaplacianData.mem_admissible_iff_mode_orthogonal
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (u : A.spectral.formDomain) :
    u ∈ A.gapData.admissible ↔
      (∀ v : A.zeroModes, inner ℂ (v : H) (u : H) = 0) ∧
      (∀ v : A.residualModes, inner ℂ (v : H) (u : H) = 0) := by
  constructor
  · intro hu
    let a : A.gapData.admissible := ⟨u, hu⟩
    exact ⟨fun v => A.admissible_orthogonal_zeroModes a v,
      fun v => A.admissible_orthogonal_residualModes a v⟩
  · rintro ⟨hzero, hresidual⟩
    obtain ⟨a, ha⟩ :=
      A.admissible_of_mode_orthogonal u hzero hresidual
    rw [← ha]
    exact a.property

theorem NonnegativeSelfAdjointData.dense_domain
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (S : NonnegativeSelfAdjointData H) :
    Dense (S.operator.domain : Set H) :=
  S.selfAdjoint.dense_domain

theorem NonnegativeSelfAdjointData.form_nonnegative
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (S : NonnegativeSelfAdjointData H)
    (u : S.operator.domain) :
    0 ≤ Complex.re (inner ℂ (S.operator u) (u : H)) :=
  S.nonnegative u

/-- The measure-theoretic core of the spectral-gap estimate. -/
theorem gap_mul_integral_one_le_integral_id
    {μ : Measure ℝ} {gap : ℝ}
    (hone : Integrable (fun _ : ℝ => (1 : ℝ)) μ)
    (hid : Integrable (fun lam : ℝ => lam) μ)
    (hlower : ∀ᵐ lam ∂μ, gap ≤ lam) :
    gap * (∫ _ : ℝ, (1 : ℝ) ∂μ) ≤ ∫ lam : ℝ, lam ∂μ := by
  rw [← integral_const_mul gap (fun _ : ℝ => (1 : ℝ))]
  exact integral_mono_ae (hone.const_mul gap) hid <|
    hlower.mono fun lam hlam => by simpa using hlam

theorem spectral_gap_bound
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (u : G.admissible) :
    G.gap * ‖(u.1 : H)‖ ^ 2 ≤ M.energy u.1 := by
  simpa only [SpectralMeasureData.energy, ← M.mass_eq_norm_sq u.1] using
    gap_mul_integral_one_le_integral_id
      (M.one_integrable u.1) (M.id_integrable u.1) (G.lower_bound u)

/-- A nonzero vector in the reduced spectral subspace has strictly positive
energy.  This is the sharp zero-mode exclusion forced by a positive gap. -/
theorem SpectralGapData.energy_pos_of_ne_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (u : G.admissible) (hu : (u.1 : H) ≠ 0) :
    0 < M.energy u.1 := by
  have hnorm : 0 < ‖(u.1 : H)‖ := norm_pos_iff.mpr hu
  exact (mul_pos G.gap_pos (pow_pos hnorm 2)).trans_le
    (spectral_gap_bound M G u)

/-- Abstract Poincare inequality before any raising/lowering factorization is
chosen.  It is the direct consequence of a positive spectral gap for the
nonnegative self-adjoint form on the explicitly reduced subspace. -/
theorem spectral_globalPoincare_sq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (u : G.admissible) :
    ‖(u.1 : H)‖ ^ 2 ≤ M.energy u.1 / G.gap := by
  apply Elementary.poincare_of_coercive G.gap_pos
  exact spectral_gap_bound M G u

/-- The form-gap estimate with the chosen raising/lowering normalization. -/
theorem raisingLowering_gap_bound
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (F : RaisingLoweringData M HR HL) (u : G.admissible) :
    (F.coefficient * G.gap) * ‖(u.1 : H)‖ ^ 2 ≤
      ‖F.raising u.1‖ ^ 2 + ‖F.lowering u.1‖ ^ 2 := by
  calc
    (F.coefficient * G.gap) * ‖(u.1 : H)‖ ^ 2 =
        F.coefficient * (G.gap * ‖(u.1 : H)‖ ^ 2) := by ring
    _ ≤ F.coefficient * M.energy u.1 :=
      mul_le_mul_of_nonneg_left (spectral_gap_bound M G u)
        F.coefficient_pos.le
    _ = ‖F.raising u.1‖ ^ 2 + ‖F.lowering u.1‖ ^ 2 :=
      F.energy_identity u.1

/-- Squared form of the abstract global Poincare inequality. -/
theorem globalPoincare_sq
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (F : RaisingLoweringData M HR HL)
    (u : G.admissible) :
    ‖(u.1 : H)‖ ^ 2 ≤
      (‖F.raising u.1‖ ^ 2 + ‖F.lowering u.1‖ ^ 2) /
        (F.coefficient * G.gap) := by
  apply Elementary.poincare_of_coercive
    (mul_pos F.coefficient_pos G.gap_pos)
  exact raisingLowering_gap_bound M G F u

/-- Genuine-group chosen-subspace form of corrected Lemmas 1.2/2.1.  The
spectral argument is shared with the abstract theorem; the package now names
the correct metaplectic Sobolev completion. -/
theorem genuineHalfWeightAutomorphic_globalPoincare_sq
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : GenuineHalfWeightAutomorphicLaplacianData ν μ H HR HL)
    (u : A.gapData.admissible) :
    ‖((u.1 : A.spectral.formDomain) : H)‖ ^ 2 ≤
      (‖A.factorization.raising u.1‖ ^ 2 +
        ‖A.factorization.lowering u.1‖ ^ 2) /
        (A.factorization.coefficient * A.gapData.gap) :=
  globalPoincare_sq A.spectral A.gapData A.factorization u

/-- Orthogonal-complement formulation of the genuine-group Poincare bound. -/
theorem genuineHalfWeightAutomorphic_globalPoincare_sq_of_orthogonal
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : GenuineHalfWeightAutomorphicLaplacianData ν μ H HR HL)
    (u : A.spectral.formDomain)
    (hzero : ∀ v : A.zeroModes,
      inner ℂ (v : H) (u : H) = 0)
    (hresidual : ∀ v : A.residualModes,
      inner ℂ (v : H) (u : H) = 0) :
    ‖(u : H)‖ ^ 2 ≤
      (‖A.factorization.raising u‖ ^ 2 +
        ‖A.factorization.lowering u‖ ^ 2) /
        (A.factorization.coefficient * A.gapData.gap) := by
  obtain ⟨a, ha⟩ :=
    A.admissible_of_mode_orthogonal u hzero hresidual
  subst u
  exact globalPoincare_sq A.spectral A.gapData A.factorization a

/-- The genuine-group Poincare estimate in the geometric Sobolev energy
names stored by the corrected Definition 1 package. -/
theorem genuineHalfWeightAutomorphic_globalPoincare_sobolevEnergy_sq_of_orthogonal
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : GenuineHalfWeightAutomorphicLaplacianData ν μ H HR HL)
    (u : A.spectral.formDomain)
    (hzero : ∀ v : A.zeroModes,
      inner ℂ (v : H) (u : H) = 0)
    (hresidual : ∀ v : A.residualModes,
      inner ℂ (v : H) (u : H) = 0) :
    ‖(u : H)‖ ^ 2 ≤
      (A.sobolev.raisingEnergy (u : H) +
        A.sobolev.loweringEnergy (u : H)) /
        (A.factorization.coefficient * A.gapData.gap) := by
  simpa only [A.raisingEnergy_eq u, A.loweringEnergy_eq u] using
    genuineHalfWeightAutomorphic_globalPoincare_sq_of_orthogonal
      A u hzero hresidual

/-- **Chosen-subspace correction of Lemmas 1.2/2.1.** Any concrete
automorphic Laplacian package discharges the abstract Poincare theorem with the
same normalization on the supplied zero/residual-mode complement.  This is not
claimed to be the PDF's literal Eisenstein-orthogonal statement. -/
theorem halfWeightAutomorphic_globalPoincare_sq
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (u : A.gapData.admissible) :
    ‖((u.1 : A.spectral.formDomain) : H)‖ ^ 2 ≤
      (‖A.factorization.raising u.1‖ ^ 2 +
        ‖A.factorization.lowering u.1‖ ^ 2) /
        (A.factorization.coefficient * A.gapData.gap) :=
  globalPoincare_sq A.spectral A.gapData A.factorization u

/-- Full orthogonal-complement form for the two explicitly chosen mode
subspaces. -/
theorem halfWeightAutomorphic_globalPoincare_sq_of_orthogonal
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (u : A.spectral.formDomain)
    (hzero : ∀ v : A.zeroModes,
      inner ℂ (v : H) (u : H) = 0)
    (hresidual : ∀ v : A.residualModes,
      inner ℂ (v : H) (u : H) = 0) :
    ‖(u : H)‖ ^ 2 ≤
      (‖A.factorization.raising u‖ ^ 2 +
        ‖A.factorization.lowering u‖ ^ 2) /
        (A.factorization.coefficient * A.gapData.gap) := by
  obtain ⟨a, ha⟩ :=
    A.admissible_of_mode_orthogonal u hzero hresidual
  subst u
  exact globalPoincare_sq A.spectral A.gapData A.factorization a

/-- The same Poincare estimate in the actual Sobolev energy names carried by
the half-weight package, rather than only in the auxiliary factorization names. -/
theorem halfWeightAutomorphic_globalPoincare_sobolevEnergy_sq_of_orthogonal
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    (A : HalfWeightAutomorphicLaplacianData J μ H HR HL)
    (u : A.spectral.formDomain)
    (hzero : ∀ v : A.zeroModes,
      inner ℂ (v : H) (u : H) = 0)
    (hresidual : ∀ v : A.residualModes,
      inner ℂ (v : H) (u : H) = 0) :
    ‖(u : H)‖ ^ 2 ≤
      (A.sobolev.raisingEnergy (u : H) +
        A.sobolev.loweringEnergy (u : H)) /
        (A.factorization.coefficient * A.gapData.gap) := by
  simpa only [A.raisingEnergy_eq u, A.loweringEnergy_eq u] using
    halfWeightAutomorphic_globalPoincare_sq_of_orthogonal
      A u hzero hresidual

/-- Norm form with the sharp abstract factor `sqrt(coefficient * gap)`. -/
theorem sqrt_gap_mul_norm_le
    {H HR HL : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [NormedAddCommGroup HR] [NormedSpace ℂ HR]
    [NormedAddCommGroup HL] [NormedSpace ℂ HL]
    {S : NonnegativeSelfAdjointData H}
    (M : SpectralMeasureData S) (G : SpectralGapData M)
    (F : RaisingLoweringData M HR HL)
    (u : G.admissible) :
    Real.sqrt (F.coefficient * G.gap) * ‖(u.1 : H)‖ ≤
      ‖F.raising u.1‖ + ‖F.lowering u.1‖ := by
  apply (sq_le_sq₀
    (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _))
    (add_nonneg (norm_nonneg _) (norm_nonneg _))).mp
  calc
    (Real.sqrt (F.coefficient * G.gap) * ‖(u.1 : H)‖) ^ 2 =
        (F.coefficient * G.gap) * ‖(u.1 : H)‖ ^ 2 := by
      rw [mul_pow, Real.sq_sqrt
        (mul_nonneg F.coefficient_pos.le G.gap_pos.le)]
    _ ≤ ‖F.raising u.1‖ ^ 2 + ‖F.lowering u.1‖ ^ 2 :=
      raisingLowering_gap_bound M G F u
    _ ≤ (‖F.raising u.1‖ + ‖F.lowering u.1‖) ^ 2 := by
      nlinarith [mul_nonneg (norm_nonneg (F.raising u.1))
        (norm_nonneg (F.lowering u.1))]

/-- Chosen-subspace version corresponding to the duplicate Lemma 2.1. -/
def globalPoincare_sq_def2_1 := @globalPoincare_sq

end GlobalPoincare

namespace KloostermanTail

/-- Convergence of modulus-ordered partial sums.  This is weaker and more faithful
to Kuznetsov cancellation than absolute `Summable`. -/
def HasOrderedSum (f : ℕ → ℂ) (z : ℂ) : Prop :=
  Tendsto (fun N => Finset.sum (Finset.range (N + 1)) f) atTop (𝓝 z)

/-- A modulus-ordered series has at most one value. -/
theorem HasOrderedSum.unique
    {f : ℕ → ℂ} {z w : ℂ}
    (hz : HasOrderedSum f z) (hw : HasOrderedSum f w) : z = w :=
  tendsto_nhds_unique hz hw

def prefixSum (a : ℕ → ℂ) (N : ℕ) : ℂ :=
  Finset.sum (Finset.range (N + 1)) a

def abelRemainder (a b : ℕ → ℂ) (N : ℕ) : ℂ :=
  prefixSum a N * (b N - b (N + 1))

theorem prefixSum_succ (a : ℕ → ℂ) (N : ℕ) :
    prefixSum a (N + 1) = prefixSum a N + a (N + 1) := by
  simp [prefixSum, Finset.sum_range_succ]

/-- Finite Abel summation in the fixed modulus order. -/
theorem finite_summation_by_parts (a b : ℕ → ℂ) (N : ℕ) :
    Finset.sum (Finset.range (N + 1)) (fun n => a n * b n) =
      prefixSum a N * b N +
        Finset.sum (Finset.range N) (abelRemainder a b) := by
  induction N with
  | zero => simp [prefixSum, abelRemainder]
  | succ N ih =>
      rw [Finset.sum_range_succ, ih, Finset.sum_range_succ,
        prefixSum_succ]
      have hrem :
          (Finset.range N).sum (abelRemainder a b) =
            ∑ x ∈ Finset.range N,
              (prefixSum a x * b x - prefixSum a x * b (1 + x)) := by
        apply Finset.sum_congr rfl
        intro x hx
        unfold abelRemainder
        rw [Nat.add_comm]
        ring
      rw [hrem]
      unfold abelRemainder
      ring

/-- The missing analytic input in the paper's Kloosterman proof: controlled
prefix cancellation, summable weighted variation, and a vanishing Abel boundary. -/
structure AbelCancellationCertificate (a b : ℕ → ℂ) where
  prefixBound : ℕ → ℝ
  majorant : ℕ → ℝ
  prefixBound_nonneg : ∀ N, 0 ≤ prefixBound N
  majorant_nonneg : ∀ N, 0 ≤ majorant N
  prefix_norm_le : ∀ N, ‖prefixSum a N‖ ≤ prefixBound N
  weightedVariation_le : ∀ N,
    prefixBound N * ‖b N - b (N + 1)‖ ≤ majorant N
  majorant_summable : Summable majorant
  boundary_tends_zero :
    Tendsto (fun N => prefixSum a N * b N) atTop (𝓝 0)

theorem AbelCancellationCertificate.remainder_norm_le
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b) (N : ℕ) :
    ‖abelRemainder a b N‖ ≤ C.majorant N := by
  rw [abelRemainder, norm_mul]
  exact (mul_le_mul_of_nonneg_right (C.prefix_norm_le N)
    (norm_nonneg _)).trans (C.weightedVariation_le N)

theorem AbelCancellationCertificate.remainder_summable
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b) :
    Summable (abelRemainder a b) :=
  C.majorant_summable.of_norm_bounded C.remainder_norm_le

noncomputable def AbelCancellationCertificate.orderedValue
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b) : ℂ :=
  ∑' N, abelRemainder a b N

/-- The corrected ordered-sum conclusion obtained by Abel summation. -/
theorem AbelCancellationCertificate.hasOrderedSum
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b) :
    HasOrderedSum (fun n => a n * b n) C.orderedValue := by
  have hremainder :
      Tendsto
        (fun N => Finset.sum (Finset.range N) (abelRemainder a b))
        atTop (𝓝 C.orderedValue) :=
    C.remainder_summable.hasSum.tendsto_sum_nat
  simpa [HasOrderedSum, AbelCancellationCertificate.orderedValue,
    finite_summation_by_parts] using C.boundary_tends_zero.add hremainder

theorem AbelCancellationCertificate.norm_orderedValue_le
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b) :
    ‖C.orderedValue‖ ≤ ∑' N, C.majorant N := by
  apply tsum_of_norm_bounded C.majorant_summable.hasSum
  exact C.remainder_norm_le

/-- The summable majorant used after genuine Kuznetsov cancellation has supplied
decay strictly stronger than `c⁻¹`.  Index `n` represents modulus `n + 1`. -/
def pSeriesMajorant (δ : ℝ) (n : ℕ) : ℝ :=
  1 / |(n : ℝ) + 1| ^ (1 + δ)

theorem pSeriesMajorant_nonneg (δ : ℝ) (n : ℕ) :
    0 ≤ pSeriesMajorant δ n := by
  unfold pSeriesMajorant
  positivity

/-- The `c⁻¹⁺ε` tail used in the PDF cannot justify absolute convergence for
nonnegative `ε`. -/
theorem not_summable_paper_tail_one
    {ε : ℝ} (hε : 0 ≤ ε) :
    ¬Summable (fun n : ℕ =>
      1 / |(n : ℝ) + 1| ^ (1 - ε)) := by
  rw [Real.summable_one_div_nat_add_rpow]
  linarith

/-- The still weaker `c⁻¹ᐟ²⁺ε` duplicate tail is likewise divergent. -/
theorem not_summable_paper_tail_half
    {ε : ℝ} (hε : 0 ≤ ε) :
    ¬Summable (fun n : ℕ =>
      1 / |(n : ℝ) + 1| ^ ((1 / 2 : ℝ) - ε)) := by
  rw [Real.summable_one_div_nat_add_rpow]
  linarith

/-- Multiplying the first divergent comparison tail by a fixed nonzero
frequency/gcd factor cannot restore summability. -/
theorem not_summable_nonzero_mul_paper_tail_one
    {A ε : ℝ} (hA : A ≠ 0) (hε : 0 ≤ ε) :
    ¬ Summable (fun n : ℕ =>
      A * (1 / |(n : ℝ) + 1| ^ (1 - ε))) := by
  intro h
  apply not_summable_paper_tail_one hε
  have h' := h.mul_left A⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hA, one_mul] using h'

/-- The same obstruction for the still weaker duplicate tail. -/
theorem not_summable_nonzero_mul_paper_tail_half
    {A ε : ℝ} (hA : A ≠ 0) (hε : 0 ≤ ε) :
    ¬ Summable (fun n : ℕ =>
      A * (1 / |(n : ℝ) + 1| ^ ((1 / 2 : ℝ) - ε))) := by
  intro h
  apply not_summable_paper_tail_half hε
  have h' := h.mul_left A⁻¹
  simpa only [← mul_assoc, inv_mul_cancel₀ hA, one_mul] using h'

noncomputable def pSeriesConstant (δ : ℝ) : ℝ :=
  ∑' n : ℕ, pSeriesMajorant δ n

theorem pSeriesConstant_nonneg (δ : ℝ) :
    0 ≤ pSeriesConstant δ := by
  unfold pSeriesConstant
  exact tsum_nonneg fun n => pSeriesMajorant_nonneg δ n

theorem pSeriesMajorant_summable {δ : ℝ} (hδ : 0 < δ) :
    Summable (pSeriesMajorant δ) := by
  change Summable (fun n : ℕ => 1 / |(n : ℝ) + 1| ^ (1 + δ))
  exact (Real.summable_one_div_nat_add_rpow 1 (1 + δ)).2 (by linarith)

/-- A summable p-series bound for the Abel remainders bounds the value of the
same original modulus-ordered series. -/
theorem AbelCancellationCertificate.norm_orderedValue_le_pSeries
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b)
    {δ A : ℝ} (hδ : 0 < δ)
    (hmajorant : ∀ N,
      C.majorant N ≤ A * pSeriesMajorant δ N) :
    ‖C.orderedValue‖ ≤ A * pSeriesConstant δ := by
  unfold AbelCancellationCertificate.orderedValue pSeriesConstant
  apply tsum_of_norm_bounded
  · exact (pSeriesMajorant_summable hδ).hasSum.mul_left A
  · intro N
    exact (C.remainder_norm_le N).trans (hmajorant N)

/-- **Corrected Lemma 1.3.** Ordered Abel cancellation and a summable remainder
majorant jointly give convergence and a quantitative bound for the original
ordered kernel. -/
theorem orderedKernel_and_bound
    {a b : ℕ → ℂ} (C : AbelCancellationCertificate a b)
    {δ A : ℝ} (hδ : 0 < δ)
    (hmajorant : ∀ N,
      C.majorant N ≤ A * pSeriesMajorant δ N) :
    HasOrderedSum (fun n => a n * b n) C.orderedValue ∧
      ‖C.orderedValue‖ ≤ A * pSeriesConstant δ :=
  ⟨C.hasOrderedSum,
    C.norm_orderedValue_le_pSeries hδ hmajorant⟩

/-- **Corrected Lemma 2.2.** This paper duplicate is the same ordered Abel
theorem, not a second absolute-convergence argument. -/
def orderedKernel_and_bound_def2_2 := @orderedKernel_and_bound

/-- Optional absolute post-cancellation data.  The caller must put every
dependence on `m`, `n`, and gcd factors into `scale`; this structure does not
manufacture or erase that dependence. -/
structure DecayData where
  term : ℕ → ℕ → ℕ → ℂ
  margin : ℝ
  margin_pos : 0 < margin
  constant : ℝ
  constant_nonneg : 0 ≤ constant
  scale : ℕ → ℕ → ℝ
  scale_nonneg : ∀ m n, 0 ≤ scale m n
  term_bound : ∀ m n c,
    ‖term m n c‖ ≤ constant * scale m n * pSeriesMajorant margin c

noncomputable def geometricKernel (K : DecayData) (m n : ℕ) : ℂ :=
  ∑' c : ℕ, K.term m n c

theorem term_summable (K : DecayData) (m n : ℕ) :
    Summable (K.term m n) := by
  have hmajorant :=
    (pSeriesMajorant_summable K.margin_pos).mul_left
      (K.constant * K.scale m n)
  apply hmajorant.of_norm_bounded
  intro c
  simpa [mul_assoc] using K.term_bound m n c

/-- An optional absolute-tail corollary after cancellation has already supplied
pointwise decay stronger than `c⁻¹`.  This is not the paper's original
Kloosterman-series argument. -/
theorem norm_geometricKernel_le (K : DecayData) (m n : ℕ) :
    ‖geometricKernel K m n‖ ≤
      K.constant * K.scale m n * pSeriesConstant K.margin := by
  unfold geometricKernel pSeriesConstant
  exact tsum_of_norm_bounded
    ((pSeriesMajorant_summable K.margin_pos).hasSum.mul_left
      (K.constant * K.scale m n))
    (by
      intro c
      simpa [mul_assoc] using K.term_bound m n c)

end KloostermanTail

/-! ## Corrected lemma layer: Lemmas 3.1--3.4 -/

namespace CuspConvergence

/-- Growth exponent before multiplication by the hyperbolic density `y⁻²`. -/
def basicGrowth (α β : ℝ) : ℝ :=
  α + β + (1 / 2 : ℝ)

def eisensteinGrowth (σ : ℝ) : ℝ :=
  max σ (1 - σ)

def rankinSelbergGrowth (α β σ : ℝ) : ℝ :=
  basicGrowth α β + eisensteinGrowth σ

/-- Exponent of the resulting one-dimensional height density. -/
def densityExponent (growth : ℝ) : ℝ :=
  growth - 2

def cuspPowerDensity (growth y : ℝ) : ℝ :=
  y ^ densityExponent growth

theorem basic_window_beta_one {α : ℝ} :
    basicGrowth α 1 < 1 ↔ α < -(1 / 2 : ℝ) := by
  unfold basicGrowth
  constructor <;> intro h <;> linarith

theorem eisensteinGrowth_eq_self {σ : ℝ} (hσ : 1 / 2 ≤ σ) :
    eisensteinGrowth σ = σ := by
  rw [eisensteinGrowth, max_eq_left]
  linarith

theorem rankinSelberg_window_beta_one {α σ : ℝ} :
    rankinSelbergGrowth α 1 σ < 1 ↔
      α + eisensteinGrowth σ < -(1 / 2 : ℝ) := by
  unfold rankinSelbergGrowth basicGrowth
  constructor <;> intro h <;> linarith

/-- In the half-plane containing the usual Eisenstein line, the corrected
Rankin--Selberg window has no hidden `max`: it is `α + σ < -1/2`. -/
theorem rankinSelberg_window_beta_one_of_half_le
    {α σ : ℝ} (hσ : 1 / 2 ≤ σ) :
    rankinSelbergGrowth α 1 σ < 1 ↔
      α + σ < -(1 / 2 : ℝ) := by
  rw [rankinSelberg_window_beta_one,
    eisensteinGrowth_eq_self hσ]

/-- The exact power-tail criterion used at a cusp. -/
theorem cuspPowerDensity_integrable
    {Y growth : ℝ} (hY : 0 < Y) (hgrowth : growth < 1) :
    IntegrableOn (cuspPowerDensity growth) (Ioi Y) := by
  apply integrableOn_Ioi_rpow_of_lt
  · unfold densityExponent
    linarith
  · exact hY

theorem cuspPowerDensity_integrable_iff
    {Y growth : ℝ} (hY : 0 < Y) :
    IntegrableOn (cuspPowerDensity growth) (Ioi Y) ↔ growth < 1 := by
  change
    IntegrableOn (fun y : ℝ => y ^ (growth - 2)) (Ioi Y) ↔ growth < 1
  rw [integrableOn_Ioi_rpow_iff hY]
  constructor <;> intro h <;> linarith

/-- A polynomial cusp bound.  For the paper's mock object this requires, at every
cusp, a proof that the polar principal part is absent, subtracted, or regularized. -/
structure PowerMajorant (f : ℝ → ℂ) where
  cutoff : ℝ
  cutoff_pos : 0 < cutoff
  growth : ℝ
  growth_lt_one : growth < 1
  constant : ℝ
  constant_nonneg : 0 ≤ constant
  aestronglyMeasurable :
    AEStronglyMeasurable f (volume.restrict (Ioi cutoff))
  norm_le : ∀ y, y ∈ Ioi cutoff →
    ‖f y‖ ≤ constant * cuspPowerDensity growth y

/-- Power-tail leaf for corrected Lemma 3.1.  A genuine cusp majorant with
growth below one is integrable against the height variable. -/
theorem PowerMajorant.integrable
    {f : ℝ → ℂ} (B : PowerMajorant f) :
    IntegrableOn f (Ioi B.cutoff) := by
  have hmajor : IntegrableOn
      (fun y => B.constant * cuspPowerDensity B.growth y)
      (Ioi B.cutoff) :=
    (cuspPowerDensity_integrable B.cutoff_pos B.growth_lt_one).const_mul _
  apply Integrable.mono' hmajor B.aestronglyMeasurable
  filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with y hy
  exact B.norm_le y hy

/-- The finite-width cusp strip in local `(x, y)` coordinates. -/
def cuspStrip (κ : Gamma2Cusp) (Y : ℝ) : Set (ℝ × ℝ) :=
  Ioc 0 (Gamma2Cusp.width κ : ℝ) ×ˢ Ioi Y

theorem measurableSet_cuspStrip (κ : Gamma2Cusp) (Y : ℝ) :
    MeasurableSet (cuspStrip κ Y) := by
  simpa [cuspStrip] using
    (measurableSet_Ioc.prod measurableSet_Ioi)

/-- Passing from the height tail to a finite-width cusp strip preserves
integrability.  The coordinate order is `(x, y)`. -/
theorem cuspPowerDensity_integrableOn_strip
    {κ : Gamma2Cusp} {Y growth : ℝ}
    (hY : 0 < Y) (hgrowth : growth < 1) :
    IntegrableOn
      (fun z : ℝ × ℝ => cuspPowerDensity growth z.2)
      (cuspStrip κ Y) (volume.prod volume) := by
  rw [IntegrableOn, cuspStrip, ← Measure.prod_restrict]
  exact
    (cuspPowerDensity_integrable hY hgrowth).comp_snd
      (volume.restrict
        (Ioc 0 (Gamma2Cusp.width κ : ℝ)))

/-- Integrating the height majorant in `x` contributes exactly the cusp width. -/
theorem cuspPowerDensity_integral_strip
    {κ : Gamma2Cusp} {Y growth : ℝ}
    (hY : 0 < Y) (hgrowth : growth < 1) :
    (∫ z in cuspStrip κ Y,
        cuspPowerDensity growth z.2 ∂volume.prod volume) =
      (Gamma2Cusp.width κ : ℝ) *
        ∫ y in Ioi Y, cuspPowerDensity growth y := by
  have h := cuspPowerDensity_integrableOn_strip
    (κ := κ) (Y := Y) (growth := growth) hY hgrowth
  rw [cuspStrip] at h ⊢
  rw [setIntegral_prod _ h]
  change
    (∫ _x in Ioc 0 (Gamma2Cusp.width κ : ℝ),
      ∫ y in Ioi Y, cuspPowerDensity growth y) =
        (Gamma2Cusp.width κ : ℝ) *
          ∫ y in Ioi Y, cuspPowerDensity growth y
  rw [setIntegral_const]
  simp [Gamma2Cusp.width_eq_two]

/-- The scalar density `y⁻²` for hyperbolic area, represented relative to
Lebesgue product measure. -/
def hyperbolicDensity (z : ℝ × ℝ) : ℝ :=
  (z.2 ^ 2)⁻¹

def hyperbolicWeighted
    (f : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  hyperbolicDensity z • f z

/-- Bookkeeping for the treatment of a cusp principal part.  This tag by
itself proves no growth estimate. -/
inductive PrincipalPartStatus
  | provedAbsent
  | subtracted
  | regularized
  deriving DecidableEq

/-- Supplied polynomial estimates for already treated cusp-coordinate
numerators.  The analytically decisive fields are `aestronglyMeasurable` and
`norm_le`; `principalPartStatus` is metadata, not a regularization theorem. -/
structure AllCuspPowerEstimate
    (numerator : Gamma2Cusp → ℝ × ℝ → ℂ)
    (growth : ℝ) where
  principalPartStatus : Gamma2Cusp → PrincipalPartStatus
  cutoff : Gamma2Cusp → ℝ
  cutoff_pos : ∀ κ, 0 < cutoff κ
  constant : Gamma2Cusp → ℝ
  constant_nonneg : ∀ κ, 0 ≤ constant κ
  aestronglyMeasurable : ∀ κ,
    AEStronglyMeasurable
      (hyperbolicWeighted (numerator κ))
      ((volume.prod volume).restrict
        (cuspStrip κ (cutoff κ)))
  norm_le : ∀ κ z, z ∈ cuspStrip κ (cutoff κ) →
    ‖hyperbolicWeighted (numerator κ) z‖ ≤
      constant κ * cuspPowerDensity growth z.2

/-- **Corrected Lemma 3.1, all-cusp power leaf.** A supplied numerator
estimate below the critical exponent gives ordinary absolute integrability at
every labelled cusp, including finite width and hyperbolic density. -/
theorem AllCuspPowerEstimate.integrableAtEveryCusp
    {numerator : Gamma2Cusp → ℝ × ℝ → ℂ}
    {growth : ℝ}
    (D : AllCuspPowerEstimate numerator growth)
    (hgrowth : growth < 1) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (numerator κ))
      (cuspStrip κ (D.cutoff κ)) (volume.prod volume) := by
  intro κ
  have hmajor : IntegrableOn
      (fun z : ℝ × ℝ =>
        D.constant κ * cuspPowerDensity growth z.2)
      (cuspStrip κ (D.cutoff κ)) (volume.prod volume) :=
    (cuspPowerDensity_integrableOn_strip
      (κ := κ) (Y := D.cutoff κ) (growth := growth)
      (D.cutoff_pos κ) hgrowth).const_mul _
  apply Integrable.mono' hmajor (D.aestronglyMeasurable κ)
  filter_upwards
    [self_mem_ae_restrict
      (measurableSet_cuspStrip κ (D.cutoff κ))]
    with z hz
  exact D.norm_le κ z hz

/-! ### Cusp-indexed exponents and proof-carrying principal-part treatment -/

/-- A real exponent allowed to vary independently at each cusp. -/
abbrev CuspExponent := Gamma2Cusp → ℝ

def cuspBasicGrowth
    (α β : CuspExponent) : CuspExponent :=
  fun κ => basicGrowth (α κ) (β κ)

def cuspRankinSelbergGrowth
    (α β σ : CuspExponent) : CuspExponent :=
  fun κ => rankinSelbergGrowth (α κ) (β κ) (σ κ)

/-- Proof-carrying treatment of one cusp principal part.  In the subtracted or
regularized cases, `principalPart` is the complete pointwise counterterm.  In
the absent case it must actually vanish. -/
structure PrincipalPartTreatment
    (raw treated : ℝ × ℝ → ℂ) where
  status : PrincipalPartStatus
  principalPart : ℝ × ℝ → ℂ
  treatment_identity : ∀ z,
    raw z = treated z + principalPart z
  absent_zero :
    status = PrincipalPartStatus.provedAbsent →
      ∀ z, principalPart z = 0

/-- An absent principal part makes the raw and treated numerators identical. -/
theorem PrincipalPartTreatment.raw_eq_treated_of_absent
    {raw treated : ℝ × ℝ → ℂ}
    (P : PrincipalPartTreatment raw treated)
    (hstatus : P.status = PrincipalPartStatus.provedAbsent) :
    raw = treated := by
  funext z
  rw [P.treatment_identity z, P.absent_zero hstatus z, add_zero]

/-- All-cusp power data with cusp-dependent growth and an exact link from each
raw numerator to the treated numerator whose integrability is estimated. -/
structure CuspIndexedPowerEstimate
    (rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ)
    (growth : CuspExponent) where
  treatment : ∀ κ,
    PrincipalPartTreatment
      (rawNumerator κ) (treatedNumerator κ)
  cutoff : Gamma2Cusp → ℝ
  cutoff_pos : ∀ κ, 0 < cutoff κ
  constant : Gamma2Cusp → ℝ
  constant_nonneg : ∀ κ, 0 ≤ constant κ
  aestronglyMeasurable : ∀ κ,
    AEStronglyMeasurable
      (hyperbolicWeighted (treatedNumerator κ))
      ((volume.prod volume).restrict
        (cuspStrip κ (cutoff κ)))
  norm_le : ∀ κ z, z ∈ cuspStrip κ (cutoff κ) →
    ‖hyperbolicWeighted (treatedNumerator κ) z‖ ≤
      constant κ * cuspPowerDensity (growth κ) z.2

/-- Cusp-by-cusp form of corrected Lemma 3.1. -/
theorem CuspIndexedPowerEstimate.integrableAtEveryCusp
    {rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ}
    {growth : CuspExponent}
    (D : CuspIndexedPowerEstimate
      rawNumerator treatedNumerator growth)
    (hgrowth : ∀ κ, growth κ < 1) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (treatedNumerator κ))
      (cuspStrip κ (D.cutoff κ))
      (volume.prod volume) := by
  intro κ
  have hmajor : IntegrableOn
      (fun z : ℝ × ℝ =>
        D.constant κ * cuspPowerDensity (growth κ) z.2)
      (cuspStrip κ (D.cutoff κ))
      (volume.prod volume) :=
    (cuspPowerDensity_integrableOn_strip
      (κ := κ) (Y := D.cutoff κ) (growth := growth κ)
      (D.cutoff_pos κ) (hgrowth κ)).const_mul _
  apply Integrable.mono' hmajor (D.aestronglyMeasurable κ)
  filter_upwards
    [self_mem_ae_restrict
      (measurableSet_cuspStrip κ (D.cutoff κ))]
    with z hz
  exact D.norm_le κ z hz

/-- If every principal part is proved absent, the raw numerators themselves
are integrable; otherwise only the treated numerators are claimed integrable. -/
theorem CuspIndexedPowerEstimate.raw_integrableAtEveryCusp_of_absent
    {rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ}
    {growth : CuspExponent}
    (D : CuspIndexedPowerEstimate
      rawNumerator treatedNumerator growth)
    (hstatus : ∀ κ,
      (D.treatment κ).status = PrincipalPartStatus.provedAbsent)
    (hgrowth : ∀ κ, growth κ < 1) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (rawNumerator κ))
      (cuspStrip κ (D.cutoff κ))
      (volume.prod volume) := by
  intro κ
  rw [(D.treatment κ).raw_eq_treated_of_absent (hstatus κ)]
  exact D.integrableAtEveryCusp hgrowth κ

abbrev CuspIndexedBasicEstimate
    (rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ)
    (α β : CuspExponent) :=
  CuspIndexedPowerEstimate rawNumerator treatedNumerator
    (cuspBasicGrowth α β)

abbrev CuspIndexedRankinSelbergEstimate
    (rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ)
    (α β σ : CuspExponent) :=
  CuspIndexedPowerEstimate rawNumerator treatedNumerator
    (cuspRankinSelbergGrowth α β σ)

theorem cuspIndexedBasic_integrable
    {rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ}
    {α β : CuspExponent}
    (D : CuspIndexedBasicEstimate
      rawNumerator treatedNumerator α β)
    (hwindow : ∀ κ, α κ + β κ < 1 / 2) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (treatedNumerator κ))
      (cuspStrip κ (D.cutoff κ))
      (volume.prod volume) := by
  apply D.integrableAtEveryCusp
  intro κ
  unfold cuspBasicGrowth basicGrowth
  linarith [hwindow κ]

theorem cuspIndexedRankinSelberg_integrable
    {rawNumerator treatedNumerator :
      Gamma2Cusp → ℝ × ℝ → ℂ}
    {α β σ : CuspExponent}
    (D : CuspIndexedRankinSelbergEstimate
      rawNumerator treatedNumerator α β σ)
    (hwindow : ∀ κ,
      α κ + β κ + eisensteinGrowth (σ κ) < 1 / 2) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (treatedNumerator κ))
      (cuspStrip κ (D.cutoff κ))
      (volume.prod volume) := by
  apply D.integrableAtEveryCusp
  intro κ
  unfold cuspRankinSelbergGrowth rankinSelbergGrowth basicGrowth
  linarith [hwindow κ]

/-- Bare mock--theta product estimate, before an Eisenstein factor. -/
abbrev AllCuspBasicEstimate
    (numerator : Gamma2Cusp → ℝ × ℝ → ℂ)
    (α β : ℝ) :=
  AllCuspPowerEstimate numerator (basicGrowth α β)

/-- Estimate for a numerator already containing the Eisenstein factor; `σ`
denotes its real-part parameter. -/
abbrev AllCuspRankinSelbergEstimate
    (numerator : Gamma2Cusp → ℝ × ℝ → ℂ)
    (α β σ : ℝ) :=
  AllCuspPowerEstimate numerator
    (rankinSelbergGrowth α β σ)

theorem allCuspBasic_integrable
    {numerator : Gamma2Cusp → ℝ × ℝ → ℂ}
    {α β : ℝ}
    (D : AllCuspBasicEstimate numerator α β)
    (hwindow : α + β < 1 / 2) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (numerator κ))
      (cuspStrip κ (D.cutoff κ)) (volume.prod volume) := by
  apply D.integrableAtEveryCusp
  unfold basicGrowth
  linarith

theorem allCuspRankinSelberg_integrable
    {numerator : Gamma2Cusp → ℝ × ℝ → ℂ}
    {α β σ : ℝ}
    (D : AllCuspRankinSelbergEstimate numerator α β σ)
    (hwindow :
      α + β + eisensteinGrowth σ < 1 / 2) :
    ∀ κ, IntegrableOn
      (hyperbolicWeighted (numerator κ))
      (cuspStrip κ (D.cutoff κ)) (volume.prod volume) := by
  apply D.integrableAtEveryCusp
  unfold rankinSelbergGrowth basicGrowth
  linarith

/-- The paper's bare cusp estimate has the advertised exponent condition. -/
theorem basic_power_integrable
    {Y α β : ℝ} (hY : 0 < Y) (hαβ : α + β < 1 / 2) :
    IntegrableOn (cuspPowerDensity (basicGrowth α β)) (Ioi Y) := by
  apply cuspPowerDensity_integrable hY
  unfold basicGrowth
  linarith

/-- Adding the Eisenstein factor requires a strictly stronger window. -/
theorem rankinSelberg_power_integrable
    {Y α β σ : ℝ} (hY : 0 < Y)
    (hwindow : α + β + eisensteinGrowth σ < 1 / 2) :
    IntegrableOn
      (cuspPowerDensity (rankinSelbergGrowth α β σ)) (Ioi Y) := by
  apply cuspPowerDensity_integrable hY
  unfold rankinSelbergGrowth basicGrowth
  linarith

/-- Exact bare cusp window, including necessity. -/
theorem basic_power_integrable_iff
    {Y α β : ℝ} (hY : 0 < Y) :
    IntegrableOn (cuspPowerDensity (basicGrowth α β)) (Ioi Y) ↔
      α + β < 1 / 2 := by
  rw [cuspPowerDensity_integrable_iff hY]
  unfold basicGrowth
  constructor <;> intro h <;> linarith

/-- Exact Eisenstein--Rankin--Selberg cusp window, including necessity. -/
theorem rankinSelberg_power_integrable_iff
    {Y α β σ : ℝ} (hY : 0 < Y) :
    IntegrableOn
        (cuspPowerDensity (rankinSelbergGrowth α β σ)) (Ioi Y) ↔
      α + β + eisensteinGrowth σ < 1 / 2 := by
  rw [cuspPowerDensity_integrable_iff hY]
  unfold rankinSelbergGrowth basicGrowth
  constructor <;> intro h <;> linarith

/-- Concrete counterexample to the PDF's implication from the bare `β = 1`
window to convergence after inserting an Eisenstein factor: `α = -1` is in
the bare window, but `σ = 2` makes the Rankin--Selberg tail divergent. -/
theorem cited_basic_window_not_rankinSelberg_integrable
    {Y : ℝ} (hY : 0 < Y) :
    ¬ IntegrableOn
      (cuspPowerDensity (rankinSelbergGrowth (-1) 1 2)) (Ioi Y) := by
  rw [cuspPowerDensity_integrable_iff hY]
  norm_num [rankinSelbergGrowth, basicGrowth, eisensteinGrowth]

/-- The bare PDF power model converges at `α=-1, β=1`, while insertion of
the Eisenstein factor at `σ=2` makes the same model divergent. -/
theorem cited_basic_integrable_but_rankinSelberg_not
    {Y : ℝ} (hY : 0 < Y) :
    IntegrableOn
        (cuspPowerDensity (basicGrowth (-1) 1)) (Ioi Y) ∧
      ¬ IntegrableOn
        (cuspPowerDensity (rankinSelbergGrowth (-1) 1 2)) (Ioi Y) := by
  constructor
  · rw [basic_power_integrable_iff hY]
    norm_num
  · exact cited_basic_window_not_rankinSelberg_integrable hY

/-- Exact formal statement of the universal inference made after PDF
Lemma 3.1. -/
def CitedLemma31RankinSelbergInference : Prop :=
  ∀ (Y α σ : ℝ), 0 < Y → α < -(1 / 2 : ℝ) → 1 < σ →
    IntegrableOn
      (cuspPowerDensity (rankinSelbergGrowth α 1 σ)) (Ioi Y)

/-- The PDF's universal bare-window-to-Rankin--Selberg inference is false. -/
theorem not_CitedLemma31RankinSelbergInference :
    ¬ CitedLemma31RankinSelbergInference := by
  intro h
  have hbad := h 1 (-1) 2 (by norm_num) (by norm_num) (by norm_num)
  exact (cited_basic_window_not_rankinSelberg_integrable
    (Y := 1) (by norm_num)) hbad

/-- Correct `β=1` Rankin--Selberg condition in the half-plane `σ>1`. -/
theorem rankinSelberg_power_beta_one_integrable_iff_of_one_lt
    {Y α σ : ℝ} (hY : 0 < Y) (hσ : 1 < σ) :
    IntegrableOn
        (cuspPowerDensity (rankinSelbergGrowth α 1 σ)) (Ioi Y) ↔
      α + σ < -(1 / 2 : ℝ) := by
  rw [rankinSelberg_power_integrable_iff hY,
    eisensteinGrowth_eq_self (by linarith : 1 / 2 ≤ σ)]
  constructor <;> intro h <;> linarith

/-! ### Near-zero audit of the cited Mock-I input

The height-tail estimates above concern `y → ∞`.  They cannot be reused at
`y → 0` with the inequality reversed.  The exact local criterion is recorded
separately because the cited Mock-I argument uses the exponent `α - 1 / 2`
and asserts convergence in the opposite range.
-/

/-- At the lower endpoint, the Mock-I power `y^(α - 1/2)` is integrable
exactly when `α > -1/2`. -/
theorem nearZero_beta_one_integrable_iff
    {Y α : ℝ} (hY : 0 < Y) :
    IntegrableOn
        (fun y : ℝ => y ^ (α - (1 / 2 : ℝ)))
        (Ioo 0 Y) ↔
      -(1 / 2 : ℝ) < α := by
  rw [intervalIntegral.integrableOn_Ioo_rpow_iff hY]
  constructor <;> intro h <;> linarith

/-- Consequently, the range `α < -1/2` claimed in the cited Mock-I cusp
calculation gives non-integrability at zero, not convergence. -/
theorem nearZero_beta_one_not_integrable
    {Y α : ℝ} (hY : 0 < Y) (hα : α < -(1 / 2 : ℝ)) :
    ¬ IntegrableOn
        (fun y : ℝ => y ^ (α - (1 / 2 : ℝ)))
        (Ioo 0 Y) := by
  rw [nearZero_beta_one_integrable_iff hY]
  exact not_lt_of_ge hα.le

/-- The borderline inverse-power density appearing after the cited source
sets its Mellin parameter to one is not locally integrable at zero. -/
theorem inversePower_not_integrable_nearZero
    {Y : ℝ} (hY : 0 < Y) :
    ¬ IntegrableOn (fun y : ℝ => y ^ (-1 : ℝ)) (Ioo 0 Y) := by
  rw [intervalIntegral.integrableOn_Ioo_rpow_iff hY]
  norm_num

/-- The scalar normalization asserted to be nonzero in the cited Mock-I
regularization, written with `ε = β - 1`.  We use the complex Gamma function
only to reuse Mathlib's entire reciprocal-Gamma theorem; all other factors are
real casts. -/
noncomputable def citedMockOneNormalization (ε : ℝ) : ℂ :=
  ((((4 * Real.pi) ^ (-ε) : ℝ) : ℂ) *
      (Complex.Gamma (ε : ℂ))⁻¹) *
    (((2 * Real.pi) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)

/-- Reciprocal Gamma tends to zero at the origin.  Hence the cited
regularization cannot have the claimed finite nonzero limit. -/
theorem invGamma_tendsto_zero :
    Tendsto
        (fun ε : ℝ => (Complex.Gamma (ε : ℂ))⁻¹)
        (𝓝 0) (𝓝 0) := by
  have hcontinuous : Continuous (fun z : ℂ => (Complex.Gamma z)⁻¹) :=
    Complex.differentiable_one_div_Gamma.continuous
  have hzero : (Complex.Gamma (0 : ℂ))⁻¹ = 0 := by
    simpa using
      (Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one (0 : ℂ))
  convert
    (hcontinuous.tendsto (0 : ℂ)).comp
      (Complex.continuous_ofReal.tendsto (0 : ℝ))
    using 1 <;> simp [Function.comp_def, hzero]

/-- Exact limit of the Mock-I normalization: it is zero, rather than the
nonzero constant used later in that source. -/
theorem citedMockOneNormalization_tendsto_zero :
    Tendsto citedMockOneNormalization (𝓝 0) (𝓝 0) := by
  have hbase : (4 * Real.pi : ℝ) ≠ 0 := by positivity
  have hpowR :
      Tendsto (fun ε : ℝ => (4 * Real.pi : ℝ) ^ (-ε))
        (𝓝 0) (𝓝 1) := by
    convert
      ((Real.continuous_const_rpow hbase).comp continuous_neg).tendsto 0
      using 1 <;> simp [Function.comp_def]
  have hpowC :
      Tendsto
          (fun ε : ℝ => (((4 * Real.pi : ℝ) ^ (-ε) : ℝ) : ℂ))
          (𝓝 0) (𝓝 1) := by
    convert
      (Complex.continuous_ofReal.tendsto (1 : ℝ)).comp hpowR
      using 1 <;> rfl
  change Tendsto
    (fun ε : ℝ =>
      ((((4 * Real.pi) ^ (-ε) : ℝ) : ℂ) *
        (Complex.Gamma (ε : ℂ))⁻¹) *
          (((2 * Real.pi) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ))
    (𝓝 0) (𝓝 0)
  simpa using
    (hpowC.mul invGamma_tendsto_zero).mul_const
      (((2 * Real.pi) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)

/-- The missing global assembly data for Lemma 3.1.  The compact core and the
three labelled cusp regions must actually cover the global measured space; the
local strip estimates alone do not establish this. -/
structure GlobalCuspDecomposition
    (X : Type*) [MeasurableSpace X] [TopologicalSpace X]
    (μ : Measure X) (f : X → ℂ) where
  compactCore : Set X
  compactCore_isCompact : IsCompact compactCore
  cuspRegion : Gamma2Cusp → Set X
  covers : compactCore ∪ (⋃ κ, cuspRegion κ) = Set.univ
  core_integrable : IntegrableOn f compactCore μ
  cusp_integrable : ∀ κ, IntegrableOn f (cuspRegion κ) μ

/-- Global integrability assembled from a compact core and every labelled cusp.
Constructing `GlobalCuspDecomposition` requires the missing cusp-orbit and chart
coverage theorem. -/
theorem GlobalCuspDecomposition.integrable
    {X : Type*} [MeasurableSpace X] [TopologicalSpace X]
    {μ : Measure X} {f : X → ℂ}
    (C : GlobalCuspDecomposition X μ f) :
    Integrable f μ := by
  have hcusp : IntegrableOn f (⋃ κ, C.cuspRegion κ) μ :=
    integrableOn_finite_iUnion.mpr C.cusp_integrable
  have hall : IntegrableOn f
      (C.compactCore ∪ ⋃ κ, C.cuspRegion κ) μ :=
    C.core_integrable.union hcusp
  rw [C.covers] at hall
  simpa using hall

end CuspConvergence

namespace TentKernel

def profile (T t : ℝ) : ℝ :=
  max 0 (T - |t|)

/-- The centered interval indicator whose self-convolution is the tent. -/
def box (T t : ℝ) : ℝ :=
  (Icc (-T / 2) (T / 2)).indicator (fun _ => 1) t

theorem sub_mem_centered_iff (T x t : ℝ) :
    x - t ∈ Icc (-T / 2) (T / 2) ↔
      t ∈ Icc (x - T / 2) (x + T / 2) := by
  constructor
  · intro h
    constructor <;> linarith [h.1, h.2]
  · intro h
    constructor <;> linarith [h.1, h.2]

theorem box_mul_box_eq_overlapIndicator (T x : ℝ) :
    (fun t => box T t * box T (x - t)) =
      (Icc (-T / 2) (T / 2) ∩
        Icc (x - T / 2) (x + T / 2)).indicator (fun _ => 1) := by
  funext t
  by_cases ht : t ∈ Icc (-T / 2) (T / 2)
  · by_cases hs : t ∈ Icc (x - T / 2) (x + T / 2)
    · have hsub : x - t ∈ Icc (-T / 2) (T / 2) :=
        (sub_mem_centered_iff T x t).2 hs
      simp [box, ht, hs, hsub]
    · have hsub : x - t ∉ Icc (-T / 2) (T / 2) := by
        intro h
        exact hs ((sub_mem_centered_iff T x t).1 h)
      simp [box, ht, hs, hsub]
  · simp [box, ht]

theorem box_convolution_eq_overlapVolume (T x : ℝ) :
    (box T ⋆ box T) x =
      volume.real
        (Icc (-T / 2) (T / 2) ∩
          Icc (x - T / 2) (x + T / 2)) := by
  rw [MeasureTheory.convolution_lsmul]
  simp only [smul_eq_mul]
  rw [box_mul_box_eq_overlapIndicator]
  simpa using (integral_indicator_one (μ := volume)
    (measurableSet_Icc.inter measurableSet_Icc))

theorem overlapVolume_eq_profile (T x : ℝ) :
    volume.real
        (Icc (-T / 2) (T / 2) ∩
          Icc (x - T / 2) (x + T / 2)) =
      profile T x := by
  rw [Icc_inter_Icc, Real.volume_real_Icc]
  unfold profile
  by_cases hx : x ≤ 0
  · calc
      max (min (T / 2) (x + T / 2) - max (-T / 2) (x - T / 2)) 0 =
          max 0 (min (T / 2) (x + T / 2) - max (-T / 2) (x - T / 2)) :=
        max_comm _ _
      _ = max 0 (T - |x|) := congrArg (fun y : ℝ => max 0 y) (by
        rw [min_eq_right (by linarith), max_eq_left (by linarith), abs_of_nonpos hx]
        ring)
  · have hx0 : 0 ≤ x := le_of_not_ge hx
    calc
      max (min (T / 2) (x + T / 2) - max (-T / 2) (x - T / 2)) 0 =
          max 0 (min (T / 2) (x + T / 2) - max (-T / 2) (x - T / 2)) :=
        max_comm _ _
      _ = max 0 (T - |x|) := congrArg (fun y : ℝ => max 0 y) (by
        rw [min_eq_left (by linarith), max_eq_right (by linarith), abs_of_nonneg hx0]
        ring)

/-- Indicator convolution computation requested in Lemma 3.2. -/
theorem box_convolution_eq_profile (T : ℝ) :
    box T ⋆ box T = profile T := by
  funext x
  rw [box_convolution_eq_overlapVolume, overlapVolume_eq_profile]

theorem profile_nonneg (T t : ℝ) : 0 ≤ profile T t :=
  le_max_left _ _

/-- Point value used to normalize the tent test. -/
@[simp]
theorem profile_zero {T : ℝ} (hT : 0 ≤ T) :
    profile T 0 = T := by
  simp [profile, max_eq_right hT]

@[simp]
theorem profile_neg (T t : ℝ) : profile T (-t) = profile T t := by
  simp [profile]

theorem profile_eq_sub_abs {T t : ℝ} (h : |t| ≤ T) :
    profile T t = T - |t| := by
  rw [profile, max_eq_right (sub_nonneg.mpr h)]

theorem profile_eq_zero {T t : ℝ} (h : T ≤ |t|) :
    profile T t = 0 := by
  rw [profile, max_eq_left (sub_nonpos.mpr h)]

theorem support_profile {T : ℝ} (hT : 0 < T) :
    Function.support (profile T) = Ioo (-T) T := by
  ext t
  constructor
  · intro ht
    change profile T t ≠ 0 at ht
    have habs : |t| < T := by
      by_contra hnot
      exact ht (profile_eq_zero (le_of_not_gt hnot))
    exact abs_lt.mp habs
  · intro ht
    change profile T t ≠ 0
    rw [profile_eq_sub_abs (abs_lt.mpr ht).le]
    exact (sub_pos.mpr (abs_lt.mpr ht)).ne'

theorem tsupport_profile {T : ℝ} (hT : 0 < T) :
    tsupport (profile T) = Icc (-T) T := by
  rw [tsupport, support_profile hT, closure_Ioo (by linarith : -T ≠ T)]

theorem continuous_profile (T : ℝ) : Continuous (profile T) := by
  change Continuous (fun t : ℝ => max 0 (T - |t|))
  exact continuous_const.max (continuous_const.sub continuous_abs)

theorem hasCompactSupport_profile {T : ℝ} (hT : 0 < T) :
    HasCompactSupport (profile T) := by
  change IsCompact (tsupport (profile T))
  rw [tsupport_profile hT]
  exact isCompact_Icc

theorem integrable_profile {T : ℝ} (hT : 0 < T) :
    Integrable (profile T) :=
  (continuous_profile T).integrable_of_hasCompactSupport
    (hasCompactSupport_profile hT)

theorem profile_on_nonnegative
    {T t : ℝ} (ht : t ∈ Icc 0 T) :
    profile T t = T - t := by
  rw [profile_eq_sub_abs]
  · rw [abs_of_nonneg ht.1]
  · simpa [abs_of_nonneg ht.1] using ht.2

theorem profile_on_nonpositive
    {T t : ℝ} (ht : t ∈ Icc (-T) 0) :
    profile T t = T + t := by
  rw [profile_eq_sub_abs]
  · rw [abs_of_nonpos ht.2]
    ring
  · rw [abs_of_nonpos ht.2]
    linarith [ht.1]

/-- Half of the triangular area. -/
theorem integral_profile_right {T : ℝ} (hT : 0 ≤ T) :
    (∫ t in (0 : ℝ)..T, profile T t) = T ^ 2 / 2 := by
  calc
    (∫ t in (0 : ℝ)..T, profile T t) =
        ∫ t in (0 : ℝ)..T, (T - t) := by
      apply intervalIntegral.integral_congr
      intro t ht
      apply profile_on_nonnegative
      simpa [uIcc_of_le hT] using ht
    _ = T ^ 2 / 2 := by
      rw [intervalIntegral.integral_sub intervalIntegrable_const
        intervalIntegral.intervalIntegrable_id, intervalIntegral.integral_const,
        integral_id]
      simp only [smul_eq_mul]
      ring

theorem integral_profile_left {T : ℝ} (hT : 0 ≤ T) :
    (∫ t in (-T)..(0 : ℝ), profile T t) = T ^ 2 / 2 := by
  calc
    (∫ t in (-T)..(0 : ℝ), profile T t) =
        ∫ t in (-T)..(0 : ℝ), (T + t) := by
      apply intervalIntegral.integral_congr
      intro t ht
      apply profile_on_nonpositive
      simpa [uIcc_of_le (neg_nonpos.mpr hT)] using ht
    _ = T ^ 2 / 2 := by
      rw [intervalIntegral.integral_add intervalIntegrable_const
        intervalIntegral.intervalIntegrable_id, intervalIntegral.integral_const,
        integral_id]
      simp only [smul_eq_mul]
      ring

/-- **Corrected Lemma 3.2/3.3 area identity.** -/
theorem integral_profile {T : ℝ} (hT : 0 < T) :
    (∫ t : ℝ, profile T t) = T ^ 2 := by
  have hsupp : Function.support (profile T) ⊆ Ioc (-T) T := by
    rw [support_profile hT]
    intro t ht
    exact ⟨ht.1, ht.2.le⟩
  calc
    (∫ t : ℝ, profile T t) = ∫ t in (-T)..T, profile T t :=
      (intervalIntegral.integral_eq_integral_of_support_subset hsupp).symm
    _ = (∫ t in (-T)..(0 : ℝ), profile T t) +
        ∫ t in (0 : ℝ)..T, profile T t :=
      (intervalIntegral.integral_add_adjacent_intervals
        ((continuous_profile T).intervalIntegrable (-T) 0)
        ((continuous_profile T).intervalIntegrable 0 T)).symm
    _ = T ^ 2 := by
      rw [integral_profile_left hT.le, integral_profile_right hT.le]
      ring

theorem profile_ratio
    {T t : ℝ} (hT : 0 < T) (ht : |t| < T) :
    profile T t / T = 1 - |t| / T := by
  rw [profile_eq_sub_abs ht.le]
  field_simp [hT.ne'] <;> ring

theorem profile_ge_half
    {T t : ℝ} (hT : 0 < T) (ht : 2 * |t| ≤ T) :
    T / 2 ≤ profile T t := by
  have habs : |t| < T := by
    nlinarith [abs_nonneg t]
  rw [profile_eq_sub_abs habs.le]
  linarith

/-- The paper's stated localization hypothesis implies the half-height bound. -/
theorem profile_ge_half_of_two_abs_add_one_le
    {T t : ℝ} (h : 2 * |t| + 1 ≤ T) :
    T / 2 ≤ profile T t := by
  apply profile_ge_half
  · nlinarith [abs_nonneg t]
  · linarith

theorem integral_profile_right_tail
    {T a : ℝ} (ha : 0 ≤ a) (haT : a ≤ T) :
    (∫ t in a..T, profile T t) = (T - a) ^ 2 / 2 := by
  calc
    (∫ t in a..T, profile T t) = ∫ t in a..T, (T - t) := by
      apply intervalIntegral.integral_congr
      intro t ht
      apply profile_on_nonnegative
      rw [uIcc_of_le haT] at ht
      exact ⟨ha.trans ht.1, ht.2⟩
    _ = (T - a) ^ 2 / 2 := by
      rw [intervalIntegral.integral_sub intervalIntegrable_const
        intervalIntegral.intervalIntegrable_id, intervalIntegral.integral_const,
        integral_id]
      simp only [smul_eq_mul]
      ring

theorem integral_profile_left_tail
    {T a : ℝ} (ha : 0 ≤ a) (haT : a ≤ T) :
    (∫ t in (-T)..(-a), profile T t) = (T - a) ^ 2 / 2 := by
  calc
    (∫ t in (-T)..(-a), profile T t) =
        ∫ t in (-T)..(-a), (T + t) := by
      apply intervalIntegral.integral_congr
      intro t ht
      apply profile_on_nonpositive
      rw [uIcc_of_le (neg_le_neg haT)] at ht
      exact ⟨ht.1, ht.2.trans (neg_nonpos.mpr ha)⟩
    _ = (T - a) ^ 2 / 2 := by
      rw [intervalIntegral.integral_add intervalIntegrable_const
        intervalIntegral.intervalIntegrable_id, intervalIntegral.integral_const,
        integral_id]
      simp only [smul_eq_mul]
      ring

/-- The sum of the two oriented interval tails used in Lemma 3.3. -/
def tailArea (T a : ℝ) : ℝ :=
  (∫ t in (-T)..(-a), profile T t) + ∫ t in a..T, profile T t

theorem tailArea_eq
    {T a : ℝ} (ha : 0 ≤ a) (haT : a ≤ T) :
    tailArea T a = (T - a) ^ 2 := by
  rw [tailArea, integral_profile_left_tail ha haT,
    integral_profile_right_tail ha haT]
  ring

/-- The exact two-sided tail integral over the measurable set used in Lemma 3.3. -/
theorem setIntegral_profile_abs_ge
    {T a : ℝ} (hT : 0 < T) (ha : 0 ≤ a) (haT : a ≤ T) :
    (∫ t in {t : ℝ | a ≤ |t|}, profile T t) = (T - a) ^ 2 := by
  by_cases ha0 : a = 0
  · subst a
    have hset : {t : ℝ | (0 : ℝ) ≤ |t|} = Set.univ := by
      ext t
      simp
    rw [hset, MeasureTheory.setIntegral_univ]
    simpa using integral_profile hT
  have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
  have htail_measurable :
      MeasurableSet {t : ℝ | a ≤ |t|} :=
    (isClosed_le continuous_const continuous_abs).measurableSet
  have hbounded_subset :
      Icc (-T) (-a) ∪ Icc a T ⊆ {t : ℝ | a ≤ |t|} := by
    intro t ht
    rcases ht with ht | ht
    · have ht_nonpos : t ≤ 0 :=
        ht.2.trans (neg_nonpos.mpr ha)
      change a ≤ |t|
      rw [abs_of_nonpos ht_nonpos]
      linarith [ht.2]
    · have ht_nonneg : 0 ≤ t := ha.trans ht.1
      change a ≤ |t|
      rw [abs_of_nonneg ht_nonneg]
      exact ht.1
  have hvanish :
      ∀ t ∈ {t : ℝ | a ≤ |t|} \
        (Icc (-T) (-a) ∪ Icc a T),
        profile T t = 0 := by
    intro t ht
    apply profile_eq_zero
    by_contra hnot
    have habsT : |t| < T := lt_of_not_ge hnot
    apply ht.2
    by_cases ht_nonneg : 0 ≤ t
    · right
      constructor
      · simpa [abs_of_nonneg ht_nonneg] using ht.1
      · simpa [abs_of_nonneg ht_nonneg] using habsT.le
    · left
      have ht_nonpos : t ≤ 0 := (lt_of_not_ge ht_nonneg).le
      constructor
      · have hbound : -t ≤ T := by
          simpa [abs_of_nonpos ht_nonpos] using habsT.le
        linarith
      · have hlower : a ≤ -t := by
          simpa [abs_of_nonpos ht_nonpos] using ht.1
        linarith
  have hdisjoint :
      Disjoint (Icc (-T) (-a)) (Icc a T) := by
    rw [Set.disjoint_left]
    intro t ht_left ht_right
    linarith [ht_left.2, ht_right.1, ha_pos]
  have hleft_integral :
      (∫ t in Icc (-T) (-a), profile T t) =
        ∫ t in (-T)..(-a), profile T t := by
    rw [intervalIntegral.integral_of_le (neg_le_neg haT)]
    exact MeasureTheory.integral_Icc_eq_integral_Ioc
  have hright_integral :
      (∫ t in Icc a T, profile T t) =
        ∫ t in a..T, profile T t := by
    rw [intervalIntegral.integral_of_le haT]
    exact MeasureTheory.integral_Icc_eq_integral_Ioc
  calc
    (∫ t in {t : ℝ | a ≤ |t|}, profile T t) =
        ∫ t in Icc (-T) (-a) ∪ Icc a T, profile T t :=
      MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
        htail_measurable hbounded_subset hvanish
    _ = (∫ t in Icc (-T) (-a), profile T t) +
        ∫ t in Icc a T, profile T t :=
      MeasureTheory.setIntegral_union hdisjoint measurableSet_Icc
        (integrable_profile hT).integrableOn
        (integrable_profile hT).integrableOn
    _ = (∫ t in (-T)..(-a), profile T t) +
        ∫ t in a..T, profile T t := by
      rw [hleft_integral, hright_integral]
    _ = (T - a) ^ 2 := by
      rw [integral_profile_left_tail ha haT,
        integral_profile_right_tail ha haT]
      ring

/-- Integration leaf used in the direct Fourier calculation. -/
private theorem integral_affine_mul_cexp
    (A B c : ℂ) (hc : c ≠ 0) (a b : ℝ) :
    (∫ t in a..b,
      (A + B * (t : ℂ)) * Complex.exp (c * (t : ℂ))) =
      (A + B * (b : ℂ)) *
          (Complex.exp (c * (b : ℂ)) / c) -
      (A + B * (a : ℂ)) *
          (Complex.exp (c * (a : ℂ)) / c) -
      B * (((Complex.exp (c * (b : ℂ)) -
          Complex.exp (c * (a : ℂ))) / c) / c) := by
  have hu : ∀ x ∈ [[a, b]],
      HasDerivAt (fun y : ℝ => A + B * (y : ℂ)) B x := by
    intro x _
    convert
      ((((hasDerivAt_id (x : ℂ)).const_mul B).comp_ofReal).const_add A)
      using 1 <;> first | rfl | simp only [id_eq, mul_one]
  have hv : ∀ x ∈ [[a, b]],
      HasDerivAt
        (fun y : ℝ => Complex.exp (c * (y : ℂ)) / c)
        (Complex.exp (c * (x : ℂ))) x := by
    intro x _
    conv => congr
    rw [← mul_div_cancel_right₀
      (Complex.exp (c * (x : ℂ))) hc]
    apply ((Complex.hasDerivAt_exp _).comp x _).div_const c
    convert ((hasDerivAt_id (x : ℂ)).const_mul c).comp_ofReal
      using 1 <;> first | rfl | simp only [id_eq, mul_one]
  have hexp :
      IntervalIntegrable
        (fun x : ℝ => Complex.exp (c * (x : ℂ)))
        volume a b :=
    (by fun_prop :
      Continuous (fun x : ℝ => Complex.exp (c * (x : ℂ)))).intervalIntegrable a b
  rw [intervalIntegral.integral_mul_deriv_eq_deriv_mul
    hu hv intervalIntegrable_const hexp]
  rw [intervalIntegral.integral_const_mul,
    intervalIntegral.integral_div,
    integral_exp_mul_complex hc]

/-- Direct integral of the tent against a nonconstant complex exponential. -/
private theorem integral_cexp_mul_profile
    {T : ℝ} (hT : 0 < T) (c : ℂ) (hc : c ≠ 0) :
    (∫ t : ℝ,
      Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) =
      (Complex.exp (c * (T : ℂ)) +
        Complex.exp (c * (-T : ℂ)) - 2) / (c * c) := by
  have hsupp : Function.support
      (fun t : ℝ =>
        Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) ⊆
      Ioc (-T) T := by
    intro t ht
    have hp : profile T t ≠ 0 := by
      intro hp
      apply ht
      simp [hp]
    have htIoo : t ∈ Ioo (-T) T := by
      rw [← support_profile hT]
      exact hp
    exact ⟨htIoo.1, htIoo.2.le⟩
  have hphase : Continuous
      (fun t : ℝ => Complex.exp (c * (t : ℂ))) := by fun_prop
  have hprofile : Continuous (fun t : ℝ => (profile T t : ℂ)) :=
    Complex.continuous_ofReal.comp (continuous_profile T)
  have hcontinuous : Continuous
      (fun t : ℝ =>
        Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) :=
    hphase.mul hprofile
  have hleft :
      (∫ t in (-T)..(0 : ℝ),
        Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) =
      ∫ t in (-T)..(0 : ℝ),
        ((T : ℂ) + 1 * (t : ℂ)) * Complex.exp (c * (t : ℂ)) := by
    apply intervalIntegral.integral_congr
    intro t ht
    change Complex.exp (c * (t : ℂ)) * (profile T t : ℂ) =
      ((T : ℂ) + 1 * (t : ℂ)) * Complex.exp (c * (t : ℂ))
    rw [profile_on_nonpositive]
    · simp only [Complex.ofReal_add]
      ring
    · simpa [uIcc_of_le (neg_nonpos.mpr hT.le)] using ht
  have hright :
      (∫ t in (0 : ℝ)..T,
        Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) =
      ∫ t in (0 : ℝ)..T,
        ((T : ℂ) + (-1) * (t : ℂ)) * Complex.exp (c * (t : ℂ)) := by
    apply intervalIntegral.integral_congr
    intro t ht
    change Complex.exp (c * (t : ℂ)) * (profile T t : ℂ) =
      ((T : ℂ) + (-1) * (t : ℂ)) * Complex.exp (c * (t : ℂ))
    rw [profile_on_nonnegative]
    · simp only [Complex.ofReal_sub]
      ring
    · simpa [uIcc_of_le hT.le] using ht
  calc
    (∫ t : ℝ,
      Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) =
        ∫ t in (-T)..T,
          Complex.exp (c * (t : ℂ)) * (profile T t : ℂ) :=
      (intervalIntegral.integral_eq_integral_of_support_subset hsupp).symm
    _ = (∫ t in (-T)..(0 : ℝ),
          Complex.exp (c * (t : ℂ)) * (profile T t : ℂ)) +
        ∫ t in (0 : ℝ)..T,
          Complex.exp (c * (t : ℂ)) * (profile T t : ℂ) :=
      (intervalIntegral.integral_add_adjacent_intervals
        (hcontinuous.intervalIntegrable (-T) 0)
        (hcontinuous.intervalIntegrable 0 T)).symm
    _ = (Complex.exp (c * (T : ℂ)) +
          Complex.exp (c * (-T : ℂ)) - 2) / (c * c) := by
      rw [hleft, hright,
        integral_affine_mul_cexp (T : ℂ) 1 c hc (-T) 0,
        integral_affine_mul_cexp (T : ℂ) (-1) c hc 0 T]
      simp [hc]
      field_simp [hc] <;> ring

noncomputable def normalizedFourier
    (f : ℝ → ℂ) (ξ : ℝ) : ℂ :=
  ∫ t : ℝ,
    Complex.exp (((-2 * Real.pi * t * ξ : ℝ) : ℂ) * Complex.I) * f t

theorem normalizedFourier_eq_mathlib (f : ℝ → ℂ) (ξ : ℝ) :
    normalizedFourier f ξ = 𝓕 f ξ := by
  rw [normalizedFourier, Real.fourier_real_eq_integral_exp_smul]
  simp only [smul_eq_mul]

private theorem imaginary_exponential_ratio
    {d x : ℝ} (hd : d ≠ 0) :
    (Complex.exp (((-d * x : ℝ) : ℂ) * Complex.I) +
        Complex.exp (((d * x : ℝ) : ℂ) * Complex.I) - 2) /
        ((((-d : ℝ) : ℂ) * Complex.I) *
          (((-d : ℝ) : ℂ) * Complex.I)) =
      (2 : ℂ) * (1 - (Real.cos (d * x) : ℂ)) /
        ((d : ℂ) * (d : ℂ)) := by
  have hdC : (d : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hd
  have hnum :
      Complex.exp (((-d * x : ℝ) : ℂ) * Complex.I) +
          Complex.exp (((d * x : ℝ) : ℂ) * Complex.I) - 2 =
        (2 : ℂ) * ((Real.cos (d * x) : ℂ) - 1) := by
    rw [Complex.exp_mul_I, Complex.exp_mul_I]
    simp only [neg_mul, Complex.ofReal_mul, Complex.ofReal_neg,
      Complex.cos_neg, Complex.sin_neg,
      Complex.ofReal_cos, Complex.ofReal_sin]
    ring
  have hden :
      ((((-d : ℝ) : ℂ) * Complex.I) *
          (((-d : ℝ) : ℂ) * Complex.I)) =
        -((d : ℂ) * (d : ℂ)) := by
    rw [Complex.ofReal_neg]
    calc
      (-((d : ℂ)) * Complex.I) * (-((d : ℂ)) * Complex.I) =
          ((d : ℂ) * (d : ℂ)) * (Complex.I * Complex.I) := by ring
      _ = -((d : ℂ) * (d : ℂ)) := by
        rw [Complex.I_mul_I]
        ring
  rw [hnum, hden]
  field_simp [hdC]
  ring

/-- The real formula that is convenient at the zero frequency as well. -/
def fourierCosineProfile (T ξ : ℝ) : ℝ :=
  if ξ = 0 then T ^ 2
  else 2 * (1 - Real.cos (2 * Real.pi * T * ξ)) /
    (2 * Real.pi * ξ) ^ 2

theorem fourierCosineProfile_nonneg (T ξ : ℝ) :
    0 ≤ fourierCosineProfile T ξ := by
  by_cases hξ : ξ = 0
  · simp [fourierCosineProfile, hξ, sq_nonneg]
  · rw [fourierCosineProfile, if_neg hξ]
    exact div_nonneg
      (mul_nonneg zero_le_two (sub_nonneg.mpr (Real.cos_le_one _)))
      (sq_nonneg _)

theorem fourier_profile_eq_cosine_of_ne_zero
    {T ξ : ℝ} (hT : 0 < T) (hξ : ξ ≠ 0) :
    𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ =
      (fourierCosineProfile T ξ : ℂ) := by
  rw [← normalizedFourier_eq_mathlib]
  unfold normalizedFourier
  let d : ℝ := 2 * Real.pi * ξ
  let c : ℂ := ((-d : ℝ) : ℂ) * Complex.I
  have hd : d ≠ 0 := by
    dsimp [d]
    exact mul_ne_zero (mul_ne_zero two_ne_zero Real.pi_ne_zero) hξ
  have hc : c ≠ 0 := by
    dsimp [c]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (neg_ne_zero.mpr hd))
      Complex.I_ne_zero
  have hexponent (t : ℝ) :
      Complex.exp
          (((-2 * Real.pi * t * ξ : ℝ) : ℂ) * Complex.I) =
        Complex.exp (c * (t : ℂ)) := by
    congr 1
    dsimp [c, d]
    push_cast
    ring
  simp_rw [hexponent]
  rw [integral_cexp_mul_profile hT c hc]
  have hct :
      c * (T : ℂ) = (((-d * T : ℝ) : ℂ) * Complex.I) := by
    dsimp [c]
    push_cast
    ring
  have hcnegT :
      c * (-T : ℂ) = (((d * T : ℝ) : ℂ) * Complex.I) := by
    dsimp [c]
    push_cast
    ring
  rw [hct, hcnegT]
  dsimp only [c]
  rw [imaginary_exponential_ratio hd]
  rw [fourierCosineProfile, if_neg hξ]
  have harg : d * T = 2 * Real.pi * T * ξ := by
    dsimp [d]
    ring
  have hden : d * d = (2 * Real.pi * ξ) ^ 2 := by
    dsimp [d]
    ring
  have hreal :
      2 * (1 - Real.cos (d * T)) / (d * d) =
        2 * (1 - Real.cos (2 * Real.pi * T * ξ)) /
          (2 * Real.pi * ξ) ^ 2 := by
    rw [harg, hden]
  have hcast :
      (2 : ℂ) * (1 - (Real.cos (d * T) : ℂ)) /
          ((d : ℂ) * (d : ℂ)) =
        ((2 * (1 - Real.cos (d * T)) / (d * d) : ℝ) : ℂ) := by
    norm_cast
  rw [hcast]
  exact congrArg (fun r : ℝ => (r : ℂ)) hreal

theorem fourier_profile_eq_cosine_zero {T : ℝ} (hT : 0 < T) :
    𝓕 (fun t : ℝ => (profile T t : ℂ)) 0 =
      (fourierCosineProfile T 0 : ℂ) := by
  rw [← normalizedFourier_eq_mathlib]
  rw [fourierCosineProfile, if_pos rfl]
  simp only [normalizedFourier, mul_zero, Complex.ofReal_zero,
    zero_mul, Complex.exp_zero, one_mul]
  rw [integral_complex_ofReal, integral_profile hT]

/-- Mathlib-normalized Fourier transform of the tent in a manifestly real form. -/
theorem fourier_profile_eq_cosine
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ =
      (fourierCosineProfile T ξ : ℂ) := by
  by_cases hξ : ξ = 0
  · subst ξ
    exact fourier_profile_eq_cosine_zero hT
  · exact fourier_profile_eq_cosine_of_ne_zero hT hξ

/-- The usual squared-sinc form of the tent transform. -/
def fourierProfile (T ξ : ℝ) : ℝ :=
  (T * Real.sinc (Real.pi * T * ξ)) ^ 2

theorem fourierProfile_nonneg (T ξ : ℝ) :
    0 ≤ fourierProfile T ξ :=
  sq_nonneg _

theorem fourierCosineProfile_eq_fourierProfile
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    fourierCosineProfile T ξ = fourierProfile T ξ := by
  by_cases hξ : ξ = 0
  · subst ξ
    simp [fourierCosineProfile, fourierProfile]
  · have ha : Real.pi * T * ξ ≠ 0 :=
      mul_ne_zero (mul_ne_zero Real.pi_ne_zero hT.ne') hξ
    rw [fourierCosineProfile, if_neg hξ, fourierProfile,
      Real.sinc_of_ne_zero ha]
    have harg :
        2 * Real.pi * T * ξ = 2 * (Real.pi * T * ξ) := by ring
    rw [harg, Real.cos_two_mul_eq_one_sub]
    field_simp [Real.pi_ne_zero, hT.ne', hξ]
    ring

/-- **Corrected Lemma 3.2.** The actual complex Fourier transform is the
nonnegative real squared-sinc profile. -/
theorem fourier_profile_eq_fourierProfile
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ =
      (fourierProfile T ξ : ℂ) := by
  rw [fourier_profile_eq_cosine hT,
    fourierCosineProfile_eq_fourierProfile hT]

/-- The same exact formula in the normalization introduced explicitly above. -/
theorem normalizedFourier_profile_eq_fourierProfile
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    normalizedFourier (fun t : ℝ => (profile T t : ℂ)) ξ =
      (fourierProfile T ξ : ℂ) := by
  rw [normalizedFourier_eq_mathlib,
    fourier_profile_eq_fourierProfile hT]

theorem fourier_profile_im_eq_zero
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    (𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ).im = 0 := by
  rw [fourier_profile_eq_fourierProfile hT]
  simp

theorem fourier_profile_re_nonneg
    {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    0 ≤ (𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ).re := by
  rw [fourier_profile_eq_fourierProfile hT]
  simpa using fourierProfile_nonneg T ξ

/-- **Unconditional aggregate closure of corrected Lemma 3.2.**  The direct
convolution, support, topological support, and Fourier-positivity conclusions
are collected without a certificate structure. -/
theorem lemma32_correctedAndProved {T : ℝ} (hT : 0 < T) :
    box T ⋆ box T = profile T ∧
    (∀ t, 0 ≤ profile T t) ∧
    Function.support (profile T) = Ioo (-T) T ∧
    tsupport (profile T) = Icc (-T) T ∧
    ∀ ξ, 𝓕 (fun t : ℝ => (profile T t : ℂ)) ξ =
        (fourierProfile T ξ : ℂ) ∧ 0 ≤ fourierProfile T ξ := by
  refine ⟨box_convolution_eq_profile T, profile_nonneg T,
    support_profile hT, tsupport_profile hT, ?_⟩
  intro ξ
  exact ⟨fourier_profile_eq_fourierProfile hT ξ,
    fourierProfile_nonneg T ξ⟩

/-- **Unconditional aggregate closure of corrected Lemma 3.3.** -/
theorem lemma33_correctedAndProved
    {T t0 : ℝ} (hT : 0 < T) (ht0 : |t0| < T) :
    profile T t0 = T - |t0| ∧
    profile T t0 / T = 1 - |t0| / T ∧
    (∫ t : ℝ, profile T t) = T ^ 2 ∧
    (∫ t in {t : ℝ | |t0| ≤ |t|}, profile T t) =
      (T - |t0|) ^ 2 := by
  exact ⟨profile_eq_sub_abs ht0.le, profile_ratio hT ht0,
    integral_profile hT,
    setIntegral_profile_abs_ge hT (abs_nonneg t0) ht0.le⟩

end TentKernel

namespace KuznetsovInterface

def besselEnvelope (x : ℝ) : ℝ :=
  if x ≤ 1 then 1 else (Real.sqrt x)⁻¹

/-- The two-branch Bessel envelope is nonnegative on the whole real line. -/
theorem besselEnvelope_nonneg (x : ℝ) :
    0 ≤ besselEnvelope x := by
  unfold besselEnvelope
  split_ifs
  · exact zero_le_one
  · exact inv_nonneg.mpr (Real.sqrt_nonneg x)

/-- A Kuznetsov convention with its normalization made explicit.  The transform
below is not an arbitrary operation: it is the Bochner integral of the normalized
kernel against the spectral test function. -/
structure Convention where
  measure : Measure ℝ
  normalization : ℝ → ℂ
  kernel : ℝ → ℝ → ℂ
  /-- At some positive geometric argument the normalized kernel is not zero
  almost everywhere.  This single field excludes zero measure, zero
  normalization, and an a.e.-zero kernel without over-specifying point values. -/
  normalizedKernel_nontrivial : ∃ x : ℝ, 0 < x ∧
    ¬ ((fun t => normalization t * kernel t x) =ᵐ[measure]
      (fun _ : ℝ => (0 : ℂ)))

def Convention.normalizedKernel (K : Convention) (t x : ℝ) : ℂ :=
  K.normalization t * K.kernel t x

theorem Convention.measure_ne_zero (K : Convention) :
    K.measure ≠ 0 := by
  rcases K.normalizedKernel_nontrivial with ⟨x, hx, hnot⟩
  intro hzero
  apply hnot
  rw [hzero, MeasureTheory.aeEq_iff]
  simp

noncomputable def Convention.transform
    (K : Convention) (f : ℝ → ℝ) (x : ℝ) : ℂ :=
  ∫ t, (f t : ℂ) * K.normalizedKernel t x ∂K.measure

/-- Admissibility for the fixed convention is actual Bochner integrability of
every transformed kernel, rather than an unconstrained predicate. -/
def Convention.Admissible (K : Convention) (f : ℝ → ℝ) : Prop :=
  ∀ x, 0 < x → Integrable
    (fun t => (f t : ℂ) * K.normalizedKernel t x) K.measure

/-! A normalization is mathematical data, not harmless notation.  The next
construction and identity make its scalar ambiguity explicit. -/

/-- Rescale only the spectral normalization of a convention.  A nonzero
scalar preserves the required a.e. nontriviality. -/
noncomputable def Convention.scaleNormalization
    (K : Convention) (c : ℂ) (hc : c ≠ 0) : Convention where
  measure := K.measure
  normalization := fun t => c * K.normalization t
  kernel := K.kernel
  normalizedKernel_nontrivial := by
    rcases K.normalizedKernel_nontrivial with ⟨x, hx, hnot⟩
    refine ⟨x, hx, ?_⟩
    intro hscaled
    apply hnot
    filter_upwards [hscaled] with t ht
    have hproduct :
        c * (K.normalization t * K.kernel t x) = 0 := by
      simpa [Convention.normalizedKernel, mul_assoc] using ht
    exact (mul_eq_zero.mp hproduct).resolve_left hc

@[simp]
theorem Convention.scaleNormalization_normalizedKernel
    (K : Convention) (c : ℂ) (hc : c ≠ 0) (t x : ℝ) :
    (K.scaleNormalization c hc).normalizedKernel t x =
      c * K.normalizedKernel t x := by
  simp [Convention.scaleNormalization, Convention.normalizedKernel, mul_assoc]

/-- Rescaling the declared normalization rescales every transform by exactly
the same scalar. -/
theorem Convention.scaleNormalization_transform
    (K : Convention) (c : ℂ) (hc : c ≠ 0)
    (f : ℝ → ℝ) (x : ℝ) :
    (K.scaleNormalization c hc).transform f x = c * K.transform f x := by
  rw [Convention.transform, Convention.transform]
  simp_rw [Convention.scaleNormalization_normalizedKernel]
  change
    (∫ t, (f t : ℂ) * (c * K.normalizedKernel t x) ∂K.measure) =
      c * ∫ t, (f t : ℂ) * K.normalizedKernel t x ∂K.measure
  calc
    (∫ t, (f t : ℂ) * (c * K.normalizedKernel t x) ∂K.measure) =
        ∫ t, c * ((f t : ℂ) * K.normalizedKernel t x) ∂K.measure := by
      apply integral_congr_ae
      filter_upwards with t
      ring
    _ = c * ∫ t, (f t : ℂ) * K.normalizedKernel t x ∂K.measure := by
      rw [integral_const_mul]

/-- Leaf hypotheses for corrected Lemma 3.4.  In contrast with the PDF's phrase
"any admissible realization", this certificate asks only for integrability and a
pointwise estimate for the *normalized kernel*.  The transform envelope is proved
below from these leaves and the exact area of the tent. -/
structure TentCertificate (K : Convention) (T : ℝ) where
  T_pos : 0 < T
  measure_eq_volume : K.measure = volume
  constant : ℝ
  constant_pos : 0 < constant
  integrable : ∀ x, 0 < x →
    Integrable (fun t =>
      (TentKernel.profile T t : ℂ) * K.normalizedKernel t x) K.measure
  normalizedKernel_bound : ∀ x, 0 < x → ∀ t,
    ‖K.normalizedKernel t x‖ ≤ constant * besselEnvelope x

theorem TentCertificate.admissible
    {K : Convention} {T : ℝ} (C : TentCertificate K T) :
    K.Admissible (TentKernel.profile T) :=
  C.integrable

/-- The normalized integral transform of the raw tent has
the required `T²` envelope.  The `T²` factor is derived from
`∫ profile T = T²`; it is not stored as a conclusion-shaped field. -/
theorem TentCertificate.bound
    {K : Convention} {T : ℝ} (C : TentCertificate K T)
    (x : ℝ) (hx : 0 < x) :
    ‖K.transform (TentKernel.profile T) x‖ ≤
      C.constant * T ^ 2 * besselEnvelope x := by
  have hmajor : Integrable
      (fun t : ℝ =>
        (C.constant * besselEnvelope x) * TentKernel.profile T t)
        K.measure := by
    rw [C.measure_eq_volume]
    exact (TentKernel.integrable_profile C.T_pos).const_mul _
  have hpoint : ∀ t : ℝ,
      ‖(TentKernel.profile T t : ℂ) * K.normalizedKernel t x‖ ≤
        (C.constant * besselEnvelope x) * TentKernel.profile T t := by
    intro t
    have hprofile := TentKernel.profile_nonneg T t
    have hkernel := C.normalizedKernel_bound x hx t
    simpa [norm_mul, abs_of_nonneg hprofile, mul_comm, mul_left_comm,
      mul_assoc] using mul_le_mul_of_nonneg_left hkernel hprofile
  calc
    ‖K.transform (TentKernel.profile T) x‖ ≤
        ∫ t, ‖(TentKernel.profile T t : ℂ) *
          K.normalizedKernel t x‖ ∂K.measure := by
      simpa only [Convention.transform] using
        (norm_integral_le_integral_norm
          (μ := K.measure)
          (fun t : ℝ =>
            (TentKernel.profile T t : ℂ) *
              K.normalizedKernel t x))
    _ ≤ ∫ t,
        (C.constant * besselEnvelope x) * TentKernel.profile T t
        ∂K.measure :=
      integral_mono_ae (C.integrable x hx).norm hmajor
        (Eventually.of_forall hpoint)
    _ = (C.constant * besselEnvelope x) * T ^ 2 := by
      rw [C.measure_eq_volume, integral_const_mul,
        TentKernel.integral_profile C.T_pos]
    _ = C.constant * T ^ 2 * besselEnvelope x := by ring

theorem TentCertificate.small_argument
    {K : Convention} {T : ℝ} (C : TentCertificate K T)
    {x : ℝ} (hx : 0 < x) (hx1 : x ≤ 1) :
    ‖K.transform (TentKernel.profile T) x‖ ≤ C.constant * T ^ 2 := by
  simpa [besselEnvelope, hx1] using C.bound x hx

theorem TentCertificate.large_argument
    {K : Convention} {T : ℝ} (C : TentCertificate K T)
    {x : ℝ} (hx : 1 < x) :
    ‖K.transform (TentKernel.profile T) x‖ ≤
      C.constant * T ^ 2 * (Real.sqrt x)⁻¹ := by
  simpa [besselEnvelope, not_le.mpr hx] using C.bound x (zero_lt_one.trans hx)

/-- A smooth nonnegative member supported through domination by the raw tent.
The domination condition forces it to vanish wherever the tent vanishes. -/
structure SmoothTentMember (T : ℝ) where
  function : ℝ → ℝ
  even : Function.Even function
  smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) function
  compactSupport : HasCompactSupport function
  nonnegative : ∀ t, 0 ≤ function t
  le_profile : ∀ t, function t ≤ TentKernel.profile T t
  /-- Excludes the zero smooth approximant. -/
  positive_somewhere : ∃ t, 0 < function t

theorem SmoothTentMember.function_ne_zero
    {T : ℝ} (A : SmoothTentMember T) :
    A.function ≠ 0 := by
  rcases A.positive_somewhere with ⟨t, ht⟩
  intro hzero
  have : A.function t = 0 := congrFun hzero t
  linarith

/-- A nonzero smooth tent-dominated member at every positive scale.  Producing
an inhabitant is part of the concrete test-kernel construction. -/
structure SmoothTentFamily where
  member : ∀ T : ℝ, 0 < T → SmoothTentMember T

/-- A centered smooth bump whose support lies in `(-T / 2, T / 2)`. -/
noncomputable def smoothTentBump (T : ℝ) (hT : 0 < T) :
    ContDiffBump (0 : ℝ) where
  rIn := T / 4
  rOut := T / 2
  rIn_pos := by linarith
  rIn_lt_rOut := by linarith

/-- A nonzero smooth function dominated by the raw tent at scale `T`. -/
noncomputable def smoothTentBumpFunction
    (T : ℝ) (hT : 0 < T) : ℝ → ℝ :=
  fun t => (T / 2) * smoothTentBump T hT t

theorem smoothTentBumpFunction_even
    (T : ℝ) (hT : 0 < T) :
    Function.Even (smoothTentBumpFunction T hT) := by
  intro t
  simp only [smoothTentBumpFunction]
  rw [(smoothTentBump T hT).neg]

theorem smoothTentBumpFunction_smooth
    (T : ℝ) (hT : 0 < T) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (smoothTentBumpFunction T hT) := by
  unfold smoothTentBumpFunction
  exact contDiff_const.mul
    ((smoothTentBump T hT).contDiff (n := (⊤ : ℕ∞)))

theorem smoothTentBumpFunction_compactSupport
    (T : ℝ) (hT : 0 < T) :
    HasCompactSupport (smoothTentBumpFunction T hT) := by
  change HasCompactSupport
    ((T / 2 : ℝ) • (fun t : ℝ => smoothTentBump T hT t))
  exact (smoothTentBump T hT).hasCompactSupport.smul_left

theorem smoothTentBumpFunction_nonnegative
    (T : ℝ) (hT : 0 < T) (t : ℝ) :
    0 ≤ smoothTentBumpFunction T hT t := by
  unfold smoothTentBumpFunction
  exact mul_nonneg (half_pos hT).le
    ((smoothTentBump T hT).nonneg (x := t))

/-- The explicit smooth member has the same central height `T / 2` used in
the tent-localization lower bound. -/
theorem smoothTentBumpFunction_zero
    (T : ℝ) (hT : 0 < T) :
    smoothTentBumpFunction T hT 0 = T / 2 := by
  have hb : smoothTentBump T hT (0 : ℝ) = 1 := by
    apply (smoothTentBump T hT).one_of_mem_closedBall
    exact Metric.mem_closedBall_self
      (smoothTentBump T hT).rIn_pos.le
  simp only [smoothTentBumpFunction, hb, mul_one]

theorem smoothTentBumpFunction_pos_zero
    (T : ℝ) (hT : 0 < T) :
    0 < smoothTentBumpFunction T hT 0 := by
  rw [smoothTentBumpFunction_zero T hT]
  exact half_pos hT

/-- The concrete smooth member vanishes outside the strictly smaller central
window `|t| < T / 2`. -/
theorem smoothTentBumpFunction_eq_zero_of_half_le_abs
    (T : ℝ) (hT : 0 < T) (t : ℝ) (ht : T / 2 ≤ |t|) :
    smoothTentBumpFunction T hT t = 0 := by
  have hdist :
      (smoothTentBump T hT).rOut ≤ dist t (0 : ℝ) := by
    simpa only [smoothTentBump, Real.dist_0_eq_abs] using ht
  have hzero : smoothTentBump T hT t = 0 :=
    (smoothTentBump T hT).zero_of_le_dist hdist
  simp only [smoothTentBumpFunction, hzero, mul_zero]

/-- Exact point-support localization for the explicit smooth member. -/
theorem support_smoothTentBumpFunction_subset
    (T : ℝ) (hT : 0 < T) :
    Function.support (smoothTentBumpFunction T hT) ⊆
      Set.Ioo (-(T / 2)) (T / 2) := by
  intro t ht
  have habs : |t| < T / 2 := by
    by_contra hnot
    exact ht (smoothTentBumpFunction_eq_zero_of_half_le_abs
      T hT t (le_of_not_gt hnot))
  exact (abs_lt.mp habs)

theorem smoothTentBumpFunction_le_profile
    (T : ℝ) (hT : 0 < T) (t : ℝ) :
    smoothTentBumpFunction T hT t ≤ TentKernel.profile T t := by
  by_cases ht : |t| < T / 2
  · calc
      smoothTentBumpFunction T hT t =
          (T / 2) * smoothTentBump T hT t := rfl
      _ ≤ (T / 2) * 1 :=
        mul_le_mul_of_nonneg_left
          ((smoothTentBump T hT).le_one (x := t))
          (half_pos hT).le
      _ = T / 2 := by ring
      _ ≤ TentKernel.profile T t :=
        TentKernel.profile_ge_half hT (by linarith)
  · have hdist :
        (smoothTentBump T hT).rOut ≤ dist t (0 : ℝ) := by
      simpa only [smoothTentBump, Real.dist_0_eq_abs] using
        (le_of_not_gt ht)
    have hzero : smoothTentBump T hT t = 0 :=
      (smoothTentBump T hT).zero_of_le_dist hdist
    simpa only [smoothTentBumpFunction, hzero, mul_zero] using
      TentKernel.profile_nonneg T t

/-- The concrete nonzero smooth tent member at scale `T`. -/
noncomputable def bumpSmoothTentMember
    (T : ℝ) (hT : 0 < T) : SmoothTentMember T where
  function := smoothTentBumpFunction T hT
  even := smoothTentBumpFunction_even T hT
  smooth := smoothTentBumpFunction_smooth T hT
  compactSupport := smoothTentBumpFunction_compactSupport T hT
  nonnegative := smoothTentBumpFunction_nonnegative T hT
  le_profile := smoothTentBumpFunction_le_profile T hT
  positive_somewhere := ⟨0, smoothTentBumpFunction_pos_zero T hT⟩

/-- A concrete nonzero smooth tent-dominated member at every positive scale. -/
noncomputable def bumpSmoothTentFamily : SmoothTentFamily where
  member := fun T hT => bumpSmoothTentMember T hT

theorem smoothTentFamily_nonempty : Nonempty SmoothTentFamily :=
  ⟨bumpSmoothTentFamily⟩

/-! ### A smooth, tent-dominated autocorrelation with positive Fourier transform -/

/-- Fourier transform of conjugation-reflection for the real-line convention. -/
theorem fourier_conjneg (f : ℝ → ℂ) (ξ : ℝ) :
    𝓕 (conjneg f) ξ = (starRingEnd ℂ) (𝓕 f ξ) := by
  rw [Real.fourier_real_eq_integral_exp_smul,
    Real.fourier_real_eq_integral_exp_smul, ← integral_conj]
  conv_lhs => rw [← integral_neg_eq_self]
  apply integral_congr_ae
  filter_upwards with v
  simp only [conjneg_apply, neg_neg, smul_eq_mul, map_mul]
  have hexponent :
      (((-2 * Real.pi * (-v) * ξ : ℝ) : ℂ) * Complex.I) =
        (starRingEnd ℂ)
          (((-2 * Real.pi * v * ξ : ℝ) : ℂ) * Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  rw [hexponent, Complex.exp_conj]

/-- A smooth tent member together with an exact nonnegative-real Fourier
witness. -/
structure FourierPositiveSmoothTentMember (T : ℝ) where
  toSmoothTentMember : SmoothTentMember T
  fourier_nonnegative_real : ∀ ξ : ℝ, ∃ r : ℝ, 0 ≤ r ∧
    𝓕 (fun t : ℝ => (toSmoothTentMember.function t : ℂ)) ξ = (r : ℂ)

/-- A half-scale smooth member, hence supported in `(-T/4,T/4)`. -/
noncomputable def narrowSmoothTentFunction
    (T : ℝ) (hT : 0 < T) : ℝ → ℝ :=
  smoothTentBumpFunction (T / 2) (half_pos hT)

theorem narrowSmoothTentFunction_even
    (T : ℝ) (hT : 0 < T) :
    Function.Even (narrowSmoothTentFunction T hT) := by
  simpa only [narrowSmoothTentFunction] using
    smoothTentBumpFunction_even (T / 2) (half_pos hT)

theorem narrowSmoothTentFunction_smooth
    (T : ℝ) (hT : 0 < T) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (narrowSmoothTentFunction T hT) := by
  simpa only [narrowSmoothTentFunction] using
    smoothTentBumpFunction_smooth (T / 2) (half_pos hT)

theorem narrowSmoothTentFunction_compactSupport
    (T : ℝ) (hT : 0 < T) :
    HasCompactSupport (narrowSmoothTentFunction T hT) := by
  simpa only [narrowSmoothTentFunction] using
    smoothTentBumpFunction_compactSupport (T / 2) (half_pos hT)

theorem narrowSmoothTentFunction_nonnegative
    (T : ℝ) (hT : 0 < T) (t : ℝ) :
    0 ≤ narrowSmoothTentFunction T hT t := by
  simpa only [narrowSmoothTentFunction] using
    smoothTentBumpFunction_nonnegative (T / 2) (half_pos hT) t

theorem narrowSmoothTentFunction_pos_zero
    (T : ℝ) (hT : 0 < T) :
    0 < narrowSmoothTentFunction T hT 0 := by
  simpa only [narrowSmoothTentFunction] using
    smoothTentBumpFunction_pos_zero (T / 2) (half_pos hT)

theorem support_narrowSmoothTentFunction_subset
    (T : ℝ) (hT : 0 < T) :
    Function.support (narrowSmoothTentFunction T hT) ⊆
      Set.Ioo (-((T / 2) / 2)) ((T / 2) / 2) := by
  simpa only [narrowSmoothTentFunction] using
    support_smoothTentBumpFunction_subset (T / 2) (half_pos hT)

/-- Raw self-convolution of the narrower real even bump; it is therefore its
autocorrelation as well. -/
noncomputable def smoothTentAutocorrelationRaw
    (T : ℝ) (hT : 0 < T) : ℝ → ℝ :=
  narrowSmoothTentFunction T hT ⋆[ContinuousLinearMap.mul ℝ ℝ]
    narrowSmoothTentFunction T hT

theorem smoothTentAutocorrelationRaw_even
    (T : ℝ) (hT : 0 < T) :
    Function.Even (smoothTentAutocorrelationRaw T hT) := by
  intro x
  unfold smoothTentAutocorrelationRaw
  exact MeasureTheory.convolution_neg_of_neg_eq
    (L := ContinuousLinearMap.mul ℝ ℝ) (x := x)
    (Eventually.of_forall (narrowSmoothTentFunction_even T hT))
    (Eventually.of_forall (narrowSmoothTentFunction_even T hT))

theorem smoothTentAutocorrelationRaw_smooth
    (T : ℝ) (hT : 0 < T) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (smoothTentAutocorrelationRaw T hT) := by
  unfold smoothTentAutocorrelationRaw
  exact (narrowSmoothTentFunction_compactSupport T hT).contDiff_convolution_left
    (ContinuousLinearMap.mul ℝ ℝ)
    (narrowSmoothTentFunction_smooth T hT)
    (((narrowSmoothTentFunction_smooth T hT).continuous.integrable_of_hasCompactSupport
        (narrowSmoothTentFunction_compactSupport T hT)).locallyIntegrable)

theorem smoothTentAutocorrelationRaw_compactSupport
    (T : ℝ) (hT : 0 < T) :
    HasCompactSupport (smoothTentAutocorrelationRaw T hT) := by
  unfold smoothTentAutocorrelationRaw
  exact (narrowSmoothTentFunction_compactSupport T hT).convolution
    (ContinuousLinearMap.mul ℝ ℝ)
    (narrowSmoothTentFunction_compactSupport T hT)

theorem smoothTentAutocorrelationRaw_nonnegative
    (T : ℝ) (hT : 0 < T) (x : ℝ) :
    0 ≤ smoothTentAutocorrelationRaw T hT x := by
  rw [smoothTentAutocorrelationRaw, MeasureTheory.convolution_def]
  simp only [ContinuousLinearMap.mul_apply']
  exact integral_nonneg fun t =>
    mul_nonneg (narrowSmoothTentFunction_nonnegative T hT t)
      (narrowSmoothTentFunction_nonnegative T hT (x - t))

theorem support_smoothTentAutocorrelationRaw_subset
    (T : ℝ) (hT : 0 < T) :
    Function.support (smoothTentAutocorrelationRaw T hT) ⊆
      Set.Ioo (-(T / 2)) (T / 2) := by
  intro x hx
  have hx' : x ∈ Function.support
      (narrowSmoothTentFunction T hT ⋆[ContinuousLinearMap.mul ℝ ℝ]
        narrowSmoothTentFunction T hT) := by
    simpa only [smoothTentAutocorrelationRaw] using hx
  have hxsum : x ∈
      Function.support (narrowSmoothTentFunction T hT) +
        Function.support (narrowSmoothTentFunction T hT) :=
    MeasureTheory.support_convolution_subset
      (L := ContinuousLinearMap.mul ℝ ℝ) hx'
  rcases Set.mem_add.mp hxsum with ⟨u, hu, v, hv, huv⟩
  have hu' := support_narrowSmoothTentFunction_subset T hT hu
  have hv' := support_narrowSmoothTentFunction_subset T hT hv
  rw [← huv]
  constructor <;> linarith [hu'.1, hu'.2, hv'.1, hv'.2]

theorem smoothTentAutocorrelationRaw_pos_zero
    (T : ℝ) (hT : 0 < T) :
    0 < smoothTentAutocorrelationRaw T hT 0 := by
  rw [smoothTentAutocorrelationRaw, MeasureTheory.convolution_def]
  simp only [ContinuousLinearMap.mul_apply', zero_sub]
  have heven :
      (fun t : ℝ => narrowSmoothTentFunction T hT t *
        narrowSmoothTentFunction T hT (-t)) =
      (fun t : ℝ => narrowSmoothTentFunction T hT t *
        narrowSmoothTentFunction T hT t) := by
    funext t
    rw [narrowSmoothTentFunction_even T hT t]
  rw [heven]
  have hbcont : Continuous (narrowSmoothTentFunction T hT) :=
    (narrowSmoothTentFunction_smooth T hT).continuous
  have hbcomp : HasCompactSupport (narrowSmoothTentFunction T hT) :=
    narrowSmoothTentFunction_compactSupport T hT
  exact (hbcont.mul hbcont).integral_pos_of_hasCompactSupport_nonneg_nonzero
    (x := 0)
    (by
      change HasCompactSupport
        (narrowSmoothTentFunction T hT * narrowSmoothTentFunction T hT)
      exact hbcomp.mul_right (f' := narrowSmoothTentFunction T hT))
    (fun t => mul_nonneg
      (narrowSmoothTentFunction_nonnegative T hT t)
      (narrowSmoothTentFunction_nonnegative T hT t))
    (mul_ne_zero (narrowSmoothTentFunction_pos_zero T hT).ne'
      (narrowSmoothTentFunction_pos_zero T hT).ne')

/-- Casting the real autocorrelation gives the complex multiplication
convolution. -/
theorem ofReal_smoothTentAutocorrelationRaw_eq
    (T : ℝ) (hT : 0 < T) :
    (fun x : ℝ => (smoothTentAutocorrelationRaw T hT x : ℂ)) =
      (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) := by
  funext x
  rw [smoothTentAutocorrelationRaw,
    MeasureTheory.convolution_def, MeasureTheory.convolution_def]
  simp only [ContinuousLinearMap.mul_apply']
  rw [← integral_complex_ofReal]
  simp only [Complex.ofReal_mul]

/-- Exact nonnegative-real Fourier transform of the raw autocorrelation. -/
theorem fourier_smoothTentAutocorrelationRaw_eq_normSq
    (T : ℝ) (hT : 0 < T) (ξ : ℝ) :
    𝓕 (fun x : ℝ => (smoothTentAutocorrelationRaw T hT x : ℂ)) ξ =
      (Complex.normSq
        (𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ) : ℂ) := by
  have hbIntR : Integrable (narrowSmoothTentFunction T hT) :=
    (narrowSmoothTentFunction_smooth T hT).continuous.integrable_of_hasCompactSupport
      (narrowSmoothTentFunction_compactSupport T hT)
  have hbIntC : Integrable
      (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) :=
    hbIntR.ofReal
  rw [ofReal_smoothTentAutocorrelationRaw_eq T hT,
    Real.fourier_mul_convolution_eq hbIntC hbIntC ξ]
  let z : ℂ :=
    𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ
  change z * z = (Complex.normSq z : ℂ)
  have hconjneg :
      conjneg (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) =
        (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) := by
    funext x
    simp only [conjneg_apply, Complex.conj_ofReal]
    rw [narrowSmoothTentFunction_even T hT x]
  have hz : z = (starRingEnd ℂ) z := by
    dsimp only [z]
    calc
      𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ =
          𝓕 (conjneg
            (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ))) ξ := by
        rw [hconjneg]
      _ = (starRingEnd ℂ)
          (𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ) :=
        fourier_conjneg _ ξ
  calc
    z * z = z * (starRingEnd ℂ) z := congrArg (fun w : ℂ => z * w) hz
    _ = (Complex.normSq z : ℂ) := Complex.mul_conj z

/-- A chosen finite global norm bound for the raw compactly supported
autocorrelation. -/
noncomputable def smoothTentAutocorrelationBound
    (T : ℝ) (hT : 0 < T) : ℝ :=
  Classical.choose
    ((smoothTentAutocorrelationRaw_smooth T hT).continuous.bounded_above_of_compact_support
        (smoothTentAutocorrelationRaw_compactSupport T hT))

theorem norm_smoothTentAutocorrelationRaw_le_bound
    (T : ℝ) (hT : 0 < T) (x : ℝ) :
    ‖smoothTentAutocorrelationRaw T hT x‖ ≤
      smoothTentAutocorrelationBound T hT := by
  unfold smoothTentAutocorrelationBound
  exact (Classical.choose_spec
    ((smoothTentAutocorrelationRaw_smooth T hT).continuous.bounded_above_of_compact_support
        (smoothTentAutocorrelationRaw_compactSupport T hT))) x

theorem smoothTentAutocorrelationBound_nonnegative
    (T : ℝ) (hT : 0 < T) :
    0 ≤ smoothTentAutocorrelationBound T hT :=
  (norm_nonneg (smoothTentAutocorrelationRaw T hT 0)).trans
    (norm_smoothTentAutocorrelationRaw_le_bound T hT 0)

/-- Positive scale which puts the autocorrelation below height `T/2`. -/
noncomputable def smoothTentAutocorrelationScale
    (T : ℝ) (hT : 0 < T) : ℝ :=
  (T / 2) / (smoothTentAutocorrelationBound T hT + 1)

theorem smoothTentAutocorrelationScale_pos
    (T : ℝ) (hT : 0 < T) :
    0 < smoothTentAutocorrelationScale T hT := by
  unfold smoothTentAutocorrelationScale
  exact div_pos (half_pos hT)
    (by linarith [smoothTentAutocorrelationBound_nonnegative T hT])

theorem smoothTentAutocorrelation_scaled_le_half
    (T : ℝ) (hT : 0 < T) (x : ℝ) :
    smoothTentAutocorrelationScale T hT *
        smoothTentAutocorrelationRaw T hT x ≤ T / 2 := by
  have hraw : smoothTentAutocorrelationRaw T hT x ≤
      smoothTentAutocorrelationBound T hT :=
    (Real.le_norm_self _).trans
      (norm_smoothTentAutocorrelationRaw_le_bound T hT x)
  calc
    smoothTentAutocorrelationScale T hT *
        smoothTentAutocorrelationRaw T hT x ≤
        smoothTentAutocorrelationScale T hT *
          smoothTentAutocorrelationBound T hT :=
      mul_le_mul_of_nonneg_left hraw
        (smoothTentAutocorrelationScale_pos T hT).le
    _ ≤ T / 2 := by
      rw [smoothTentAutocorrelationScale, div_mul_eq_mul_div]
      apply (div_le_iff₀
        (by linarith [smoothTentAutocorrelationBound_nonnegative T hT])).2
      nlinarith [half_pos hT,
        smoothTentAutocorrelationBound_nonnegative T hT]

/-- Scaled smooth autocorrelation, now dominated by the raw tent. -/
noncomputable def fourierPositiveSmoothTentFunction
    (T : ℝ) (hT : 0 < T) : ℝ → ℝ :=
  fun x => smoothTentAutocorrelationScale T hT *
    smoothTentAutocorrelationRaw T hT x

theorem fourierPositiveSmoothTentFunction_even
    (T : ℝ) (hT : 0 < T) :
    Function.Even (fourierPositiveSmoothTentFunction T hT) := by
  intro x
  simp only [fourierPositiveSmoothTentFunction]
  rw [smoothTentAutocorrelationRaw_even T hT x]

theorem fourierPositiveSmoothTentFunction_smooth
    (T : ℝ) (hT : 0 < T) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fourierPositiveSmoothTentFunction T hT) := by
  unfold fourierPositiveSmoothTentFunction
  exact contDiff_const.mul (smoothTentAutocorrelationRaw_smooth T hT)

theorem fourierPositiveSmoothTentFunction_compactSupport
    (T : ℝ) (hT : 0 < T) :
    HasCompactSupport (fourierPositiveSmoothTentFunction T hT) := by
  change HasCompactSupport
    ((smoothTentAutocorrelationScale T hT) •
      smoothTentAutocorrelationRaw T hT)
  exact (smoothTentAutocorrelationRaw_compactSupport T hT).smul_left

theorem fourierPositiveSmoothTentFunction_nonnegative
    (T : ℝ) (hT : 0 < T) (x : ℝ) :
    0 ≤ fourierPositiveSmoothTentFunction T hT x := by
  unfold fourierPositiveSmoothTentFunction
  exact mul_nonneg (smoothTentAutocorrelationScale_pos T hT).le
    (smoothTentAutocorrelationRaw_nonnegative T hT x)

theorem fourierPositiveSmoothTentFunction_pos_zero
    (T : ℝ) (hT : 0 < T) :
    0 < fourierPositiveSmoothTentFunction T hT 0 := by
  unfold fourierPositiveSmoothTentFunction
  exact mul_pos (smoothTentAutocorrelationScale_pos T hT)
    (smoothTentAutocorrelationRaw_pos_zero T hT)

/-- Positivity at the origin and continuity give a quantitative positive floor
on one open interval about the origin. -/
theorem fourierPositiveSmoothTentFunction_localPositiveFloor
    (T : ℝ) (hT : 0 < T) :
    ∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
      ∀ t, |t| < δ →
        c ≤ fourierPositiveSmoothTentFunction T hT t := by
  have hzero := fourierPositiveSmoothTentFunction_pos_zero T hT
  have hnear :
      ∀ᶠ t in 𝓝 (0 : ℝ),
        fourierPositiveSmoothTentFunction T hT 0 / 2 <
          fourierPositiveSmoothTentFunction T hT t :=
    ((fourierPositiveSmoothTentFunction_smooth T hT).continuous.continuousAt).eventually_const_lt
      (half_lt_self hzero)
  rcases Metric.mem_nhds_iff.1 hnear with ⟨δ, hδ, hball⟩
  refine ⟨δ, fourierPositiveSmoothTentFunction T hT 0 / 2,
    hδ, half_pos hzero, ?_⟩
  intro t ht
  exact (hball (by
    simpa only [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs]
      using ht)).le

theorem fourierPositiveSmoothTentFunction_le_profile
    (T : ℝ) (hT : 0 < T) (x : ℝ) :
    fourierPositiveSmoothTentFunction T hT x ≤
      TentKernel.profile T x := by
  by_cases hx : |x| < T / 2
  · exact (smoothTentAutocorrelation_scaled_le_half T hT x).trans
      (TentKernel.profile_ge_half hT (by linarith))
  · have hrawzero : smoothTentAutocorrelationRaw T hT x = 0 := by
      by_contra hne
      have hxI := support_smoothTentAutocorrelationRaw_subset T hT hne
      exact hx (abs_lt.mpr hxI)
    rw [fourierPositiveSmoothTentFunction, hrawzero, mul_zero]
    exact TentKernel.profile_nonneg T x

/-- The scaled autocorrelation transform is an explicit nonnegative real
norm-square. -/
theorem fourier_fourierPositiveSmoothTentFunction_eq
    (T : ℝ) (hT : 0 < T) (ξ : ℝ) :
    𝓕 (fun x : ℝ => (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ =
      ((smoothTentAutocorrelationScale T hT *
        Complex.normSq
          (𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ) : ℝ) : ℂ) := by
  rw [← TentKernel.normalizedFourier_eq_mathlib
    (fun x : ℝ => (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ]
  calc
    TentKernel.normalizedFourier
          (fun x : ℝ => (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ =
        (smoothTentAutocorrelationScale T hT : ℂ) *
          TentKernel.normalizedFourier
            (fun x : ℝ => (smoothTentAutocorrelationRaw T hT x : ℂ)) ξ := by
      simp only [TentKernel.normalizedFourier, fourierPositiveSmoothTentFunction,
        Complex.ofReal_mul]
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with x
      ring
    _ = ((smoothTentAutocorrelationScale T hT *
          Complex.normSq
            (𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ) : ℝ) : ℂ) := by
      rw [TentKernel.normalizedFourier_eq_mathlib,
        fourier_smoothTentAutocorrelationRaw_eq_normSq T hT ξ,
        Complex.ofReal_mul]

/-- The explicit smooth autocorrelation test has real Fourier transform. -/
theorem fourier_fourierPositiveSmoothTentFunction_im_eq_zero
    (T : ℝ) (hT : 0 < T) (ξ : ℝ) :
    (𝓕 (fun x : ℝ =>
      (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ).im = 0 := by
  rw [fourier_fourierPositiveSmoothTentFunction_eq]
  simp

/-- The real Fourier transform of the explicit smooth test is nonnegative. -/
theorem fourier_fourierPositiveSmoothTentFunction_re_nonneg
    (T : ℝ) (hT : 0 < T) (ξ : ℝ) :
    0 ≤ (𝓕 (fun x : ℝ =>
      (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ).re := by
  rw [fourier_fourierPositiveSmoothTentFunction_eq]
  exact mul_nonneg (smoothTentAutocorrelationScale_pos T hT).le
    (Complex.normSq_nonneg _)

/-- The scaled Fourier-positive replacement retains the strict half-scale
support of its raw autocorrelation. -/
theorem support_fourierPositiveSmoothTentFunction_subset
    (T : ℝ) (hT : 0 < T) :
    Function.support (fourierPositiveSmoothTentFunction T hT) ⊆
      Ioo (-(T / 2)) (T / 2) := by
  intro x hx
  apply support_smoothTentAutocorrelationRaw_subset T hT
  change smoothTentAutocorrelationRaw T hT x ≠ 0
  intro hraw
  exact hx (by
    simp [fourierPositiveSmoothTentFunction, hraw])

/-- **Unconditional concrete replacement for corrected Lemma 3.4.**  This
asserts only properties proved directly for the explicit smooth
autocorrelation, without postulating a paper-specific Kuznetsov kernel. -/
theorem lemma34_smoothReplacement_correctedAndProved
    (T : ℝ) (hT : 0 < T) :
    Function.Even (fourierPositiveSmoothTentFunction T hT) ∧
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fourierPositiveSmoothTentFunction T hT) ∧
    HasCompactSupport (fourierPositiveSmoothTentFunction T hT) ∧
    Function.support (fourierPositiveSmoothTentFunction T hT) ⊆
      Ioo (-(T / 2)) (T / 2) ∧
    (∀ x, 0 ≤ fourierPositiveSmoothTentFunction T hT x ∧
      fourierPositiveSmoothTentFunction T hT x ≤
        TentKernel.profile T x) ∧
    0 < fourierPositiveSmoothTentFunction T hT 0 ∧
    ∀ ξ,
      (𝓕 (fun x : ℝ =>
        (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ).im = 0 ∧
      0 ≤ (𝓕 (fun x : ℝ =>
        (fourierPositiveSmoothTentFunction T hT x : ℂ)) ξ).re := by
  refine ⟨fourierPositiveSmoothTentFunction_even T hT,
    fourierPositiveSmoothTentFunction_smooth T hT,
    fourierPositiveSmoothTentFunction_compactSupport T hT,
    support_fourierPositiveSmoothTentFunction_subset T hT, ?_,
    fourierPositiveSmoothTentFunction_pos_zero T hT, ?_⟩
  · intro x
    exact ⟨fourierPositiveSmoothTentFunction_nonnegative T hT x,
      fourierPositiveSmoothTentFunction_le_profile T hT x⟩
  · intro ξ
    exact ⟨fourier_fourierPositiveSmoothTentFunction_im_eq_zero T hT ξ,
      fourier_fourierPositiveSmoothTentFunction_re_nonneg T hT ξ⟩

/-- A genuine nonzero smooth tent-dominated member with nonnegative Fourier
transform. -/
noncomputable def autocorrelationFourierPositiveSmoothTentMember
    (T : ℝ) (hT : 0 < T) : FourierPositiveSmoothTentMember T where
  toSmoothTentMember :=
    { function := fourierPositiveSmoothTentFunction T hT
      even := fourierPositiveSmoothTentFunction_even T hT
      smooth := fourierPositiveSmoothTentFunction_smooth T hT
      compactSupport := fourierPositiveSmoothTentFunction_compactSupport T hT
      nonnegative := fourierPositiveSmoothTentFunction_nonnegative T hT
      le_profile := fourierPositiveSmoothTentFunction_le_profile T hT
      positive_somewhere :=
        ⟨0, fourierPositiveSmoothTentFunction_pos_zero T hT⟩ }
  fourier_nonnegative_real := fun ξ =>
    ⟨smoothTentAutocorrelationScale T hT *
        Complex.normSq
          (𝓕 (fun x : ℝ => (narrowSmoothTentFunction T hT x : ℂ)) ξ),
      mul_nonneg (smoothTentAutocorrelationScale_pos T hT).le
        (Complex.normSq_nonneg _),
      fourier_fourierPositiveSmoothTentFunction_eq T hT ξ⟩

/-- An explicit Fourier-positive smooth member at every positive scale. -/
structure FourierPositiveSmoothTentFamily where
  member : ∀ T : ℝ, 0 < T → FourierPositiveSmoothTentMember T

noncomputable def autocorrelationFourierPositiveSmoothTentFamily :
    FourierPositiveSmoothTentFamily where
  member := fun T hT => autocorrelationFourierPositiveSmoothTentMember T hT

theorem fourierPositiveSmoothTentFamily_nonempty :
    Nonempty FourierPositiveSmoothTentFamily :=
  ⟨autocorrelationFourierPositiveSmoothTentFamily⟩

/-- A continuous spectral datum whose test is the explicit nonzero, even,
nonnegative, compactly supported smooth autocorrelation with nonnegative Fourier
transform constructed above.  Only coefficient integrability remains input. -/
noncomputable def fourierPositiveContinuousSpectralData
    (T : ℝ) (hT : 0 < T)
    (spectralMeasure : Gamma2Cusp → Measure ℝ)
    (coefficient : Gamma2Cusp → ℕ → ℝ → ℂ)
    (hint : ∀ κ m,
      Integrable
        (fun t =>
          fourierPositiveSmoothTentFunction T hT t *
            Complex.normSq (coefficient κ m t))
        (spectralMeasure κ)) :
    ContinuousSpectralData where
  test := fourierPositiveSmoothTentFunction T hT
  test_nonneg :=
    fourierPositiveSmoothTentFunction_nonnegative T hT
  spectralMeasure := spectralMeasure
  coefficient := coefficient
  integrable := hint

@[simp]
theorem fourierPositiveContinuousSpectralData_test_pos_zero
    (T : ℝ) (hT : 0 < T)
    (spectralMeasure : Gamma2Cusp → Measure ℝ)
    (coefficient : Gamma2Cusp → ℕ → ℝ → ℂ)
    (hint : ∀ κ m,
      Integrable
        (fun t =>
          fourierPositiveSmoothTentFunction T hT t *
            Complex.normSq (coefficient κ m t))
        (spectralMeasure κ)) :
    0 < (fourierPositiveContinuousSpectralData
      T hT spectralMeasure coefficient hint).test 0 :=
  fourierPositiveSmoothTentFunction_pos_zero T hT

def Convention.SmoothTransformIntegrable
    (K : Convention) (f : ℝ → ℝ) : Prop :=
  Function.Even f ∧ ContDiff ℝ (↑(⊤ : ℕ∞)) f ∧
    HasCompactSupport f ∧ K.Admissible f

/-- A `T`-independent normalized-kernel envelope.  Its single constant is
therefore uniform across the entire smooth tent-dominated family. -/
structure UniformKernelEnvelope (K : Convention) where
  measure_eq_volume : K.measure = volume
  constant : ℝ
  constant_nonneg : 0 ≤ constant
  normalizedKernel_aestronglyMeasurable : ∀ x, 0 < x →
    AEStronglyMeasurable (fun t => K.normalizedKernel t x) K.measure
  normalizedKernel_bound : ∀ x, 0 < x →
    ∀ᵐ t ∂K.measure,
      ‖K.normalizedKernel t x‖ ≤ constant * besselEnvelope x

/-- A fully concrete volume-measure convention whose normalized kernel is the
unit tent multiplied by the displayed Bessel envelope.  It is a verification
model for the interface, not an identification with the paper's Kuznetsov
kernel. -/
noncomputable def profileBesselConvention : Convention where
  measure := volume
  normalization := fun _ => 1
  kernel := fun t x =>
    (TentKernel.profile 1 t : ℂ) * (besselEnvelope x : ℂ)
  normalizedKernel_nontrivial := by
    refine ⟨1, zero_lt_one, ?_⟩
    intro hzero
    have hzero' :
        (fun t : ℝ => (TentKernel.profile 1 t : ℂ)) =ᵐ[volume]
          (fun _ : ℝ => (0 : ℂ)) := by
      simpa [besselEnvelope] using hzero
    have hbad : (1 : ℂ) = 0 := calc
      (1 : ℂ) = ∫ t : ℝ, (TentKernel.profile 1 t : ℂ) := by
        rw [integral_complex_ofReal,
          TentKernel.integral_profile (by norm_num)]
        norm_num
      _ = ∫ _t : ℝ, (0 : ℂ) := integral_congr_ae hzero'
      _ = 0 := by simp
    exact one_ne_zero hbad

/-- In the concrete verification convention, the constant test at geometric
argument one has transform exactly one.  The integrand is compactly supported
because the kernel contains the unit tent. -/
theorem profileBesselConvention_transform_one_at_one :
    profileBesselConvention.transform (fun _ : ℝ => 1) 1 = 1 := by
  simp only [Convention.transform, Convention.normalizedKernel,
    profileBesselConvention, one_mul]
  have hbessel : besselEnvelope 1 = 1 := by simp [besselEnvelope]
  rw [hbessel]
  simp only [Complex.ofReal_one, one_mul, mul_one]
  rw [integral_complex_ofReal,
    TentKernel.integral_profile (by norm_num)]
  norm_num

/-- Doubling only the declared normalization changes that same transform from
`1` to `2`; hence a trace formula must fix its normalization explicitly. -/
theorem doubledNormalization_transform_one_at_one :
    (profileBesselConvention.scaleNormalization (2 : ℂ) (by norm_num)).transform
        (fun _ : ℝ => 1) 1 = 2 := by
  rw [Convention.scaleNormalization_transform,
    profileBesselConvention_transform_one_at_one]
  norm_num

theorem normalization_choice_changes_transform :
    (profileBesselConvention.scaleNormalization (2 : ℂ) (by norm_num)).transform
        (fun _ : ℝ => 1) 1 ≠
      profileBesselConvention.transform (fun _ : ℝ => 1) 1 := by
  rw [doubledNormalization_transform_one_at_one,
    profileBesselConvention_transform_one_at_one]
  norm_num

/-- The concrete profile/Bessel convention carries a uniform kernel envelope
with constant one. -/
noncomputable def profileBesselUniformKernelEnvelope :
    UniformKernelEnvelope profileBesselConvention where
  measure_eq_volume := rfl
  constant := 1
  constant_nonneg := zero_le_one
  normalizedKernel_aestronglyMeasurable := by
    intro x hx
    simp only [profileBesselConvention, Convention.normalizedKernel, one_mul]
    change AEStronglyMeasurable
      (fun t : ℝ =>
        (TentKernel.profile 1 t : ℂ) * (besselEnvelope x : ℂ)) volume
    have hprofile : Integrable
        (fun t : ℝ => (TentKernel.profile 1 t : ℂ)) volume :=
      (TentKernel.integrable_profile (by norm_num)).ofReal
    have hkernel : Integrable
        (fun t : ℝ =>
          (TentKernel.profile 1 t : ℂ) * (besselEnvelope x : ℂ)) volume := by
      simpa only [mul_comm] using
        hprofile.const_mul (besselEnvelope x : ℂ)
    exact hkernel.aestronglyMeasurable
  normalizedKernel_bound := by
    intro x hx
    refine Filter.Eventually.of_forall ?_
    intro t
    have hprofile0 : 0 ≤ TentKernel.profile 1 t :=
      TentKernel.profile_nonneg 1 t
    have hprofile1 : TentKernel.profile 1 t ≤ 1 := by
      simp [TentKernel.profile]
    have hbessel : 0 ≤ besselEnvelope x := besselEnvelope_nonneg x
    simp only [profileBesselConvention, Convention.normalizedKernel, one_mul,
      norm_mul, Complex.norm_real, Real.norm_of_nonneg hprofile0,
      Real.norm_of_nonneg hbessel]
    simpa only [one_mul] using
      (mul_le_mul_of_nonneg_right hprofile1 hbessel)

theorem UniformKernelEnvelope.smoothTent_integrable
    {K : Convention} (U : UniformKernelEnvelope K)
    {T : ℝ} (hT : 0 < T) (A : SmoothTentMember T) :
    K.Admissible A.function := by
  intro x hx
  have hmajor : Integrable
      (fun t : ℝ =>
        (U.constant * besselEnvelope x) * TentKernel.profile T t)
      K.measure := by
    rw [U.measure_eq_volume]
    exact (TentKernel.integrable_profile hT).const_mul _
  apply hmajor.mono'
  · exact
      (Complex.continuous_ofReal.comp A.smooth.continuous).aestronglyMeasurable.mul
        (U.normalizedKernel_aestronglyMeasurable x hx)
  · filter_upwards [U.normalizedKernel_bound x hx] with t ht
    calc
      ‖(A.function t : ℂ) * K.normalizedKernel t x‖ =
          A.function t * ‖K.normalizedKernel t x‖ := by
        simp [norm_mul, abs_of_nonneg (A.nonnegative t)]
      _ ≤ A.function t * (U.constant * besselEnvelope x) :=
        mul_le_mul_of_nonneg_left ht (A.nonnegative t)
      _ ≤ TentKernel.profile T t *
          (U.constant * besselEnvelope x) :=
        mul_le_mul_of_nonneg_right (A.le_profile t)
          (mul_nonneg U.constant_nonneg (besselEnvelope_nonneg x))
      _ = (U.constant * besselEnvelope x) *
          TentKernel.profile T t := by ring

theorem UniformKernelEnvelope.smoothTent_transformIntegrable
    {K : Convention} (U : UniformKernelEnvelope K)
    {T : ℝ} (hT : 0 < T) (A : SmoothTentMember T) :
    K.SmoothTransformIntegrable A.function :=
  ⟨A.even, A.smooth, A.compactSupport,
    U.smoothTent_integrable hT A⟩

/-- **Corrected Lemma 3.4, smooth transform form.** The envelope follows from
smooth transform-integrability, tent domination, and the normalized kernel
estimate.  Holomorphic-strip and any further trace-formula conditions remain
separate properties of the concrete test family. -/
theorem UniformKernelEnvelope.smoothTent_bound
    {K : Convention} (U : UniformKernelEnvelope K)
    {T : ℝ} (hT : 0 < T) (A : SmoothTentMember T)
    (x : ℝ) (hx : 0 < x) :
    ‖K.transform A.function x‖ ≤
      U.constant * T ^ 2 * besselEnvelope x := by
  have hmajor : Integrable
      (fun t : ℝ =>
        (U.constant * besselEnvelope x) * TentKernel.profile T t)
        K.measure := by
    rw [U.measure_eq_volume]
    exact (TentKernel.integrable_profile hT).const_mul _
  have hpoint : ∀ᵐ t ∂K.measure,
      ‖(A.function t : ℂ) * K.normalizedKernel t x‖ ≤
        (U.constant * besselEnvelope x) * TentKernel.profile T t := by
    filter_upwards [U.normalizedKernel_bound x hx] with t ht
    calc
      ‖(A.function t : ℂ) * K.normalizedKernel t x‖ =
          A.function t * ‖K.normalizedKernel t x‖ := by
        simp [norm_mul, abs_of_nonneg (A.nonnegative t)]
      _ ≤ A.function t * (U.constant * besselEnvelope x) :=
        mul_le_mul_of_nonneg_left ht (A.nonnegative t)
      _ ≤ TentKernel.profile T t *
          (U.constant * besselEnvelope x) :=
        mul_le_mul_of_nonneg_right (A.le_profile t)
          (mul_nonneg U.constant_nonneg (besselEnvelope_nonneg x))
      _ = (U.constant * besselEnvelope x) *
          TentKernel.profile T t := by ring
  calc
    ‖K.transform A.function x‖ ≤
        ∫ t, (U.constant * besselEnvelope x) *
          TentKernel.profile T t ∂K.measure := by
      simpa only [Convention.transform] using
        norm_integral_le_of_norm_le hmajor hpoint
    _ = (U.constant * besselEnvelope x) * T ^ 2 := by
      rw [U.measure_eq_volume, integral_const_mul,
        TentKernel.integral_profile hT]
    _ = U.constant * T ^ 2 * besselEnvelope x := by ring

/-- The explicit Fourier-positive smooth family is governed by the same
uniform Kuznetsov envelope as every tent-dominated member. -/
theorem UniformKernelEnvelope.autocorrelationFourierPositiveSmoothTent_bound
    {K : Convention} (U : UniformKernelEnvelope K)
    {T x : ℝ} (hT : 0 < T) (hx : 0 < x) :
    ‖K.transform
        (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function x‖ ≤
      U.constant * T ^ 2 * besselEnvelope x :=
  U.smoothTent_bound hT
    (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember x hx

/-- The explicit Fourier-positive smooth family is genuinely admissible for
every convention carrying the stated uniform kernel envelope. -/
theorem UniformKernelEnvelope.autocorrelationFourierPositiveSmoothTent_transformIntegrable
    {K : Convention} (U : UniformKernelEnvelope K)
    {T : ℝ} (hT : 0 < T) :
    K.SmoothTransformIntegrable
      (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function :=
  U.smoothTent_transformIntegrable hT
    (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember

/-- Direct aggregate of admissibility and the normalized transform estimate
for the explicit Fourier-positive smooth replacement. -/
theorem UniformKernelEnvelope.autocorrelationFourierPositiveSmoothTent_admissibleAndBound
    {K : Convention} (U : UniformKernelEnvelope K)
    {T x : ℝ} (hT : 0 < T) (hx : 0 < x) :
    K.SmoothTransformIntegrable
        (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function ∧
      ‖K.transform
        (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function x‖ ≤
        U.constant * T ^ 2 * besselEnvelope x :=
  ⟨U.autocorrelationFourierPositiveSmoothTent_transformIntegrable hT,
    U.autocorrelationFourierPositiveSmoothTent_bound hT hx⟩

/-- The same explicit Fourier-positive smooth test simultaneously has a
quantitative positive window, satisfies the transform admissibility interface,
and obeys the uniform normalized-kernel estimate.  This keeps the Step-1 and
Step-3 test functions definitionally identical. -/
theorem UniformKernelEnvelope.autocorrelationFourierPositiveSmoothTent_localFloorAndKernelEnvelope
    {K : Convention} (U : UniformKernelEnvelope K)
    {T x : ℝ} (hT : 0 < T) (hx : 0 < x) :
    (∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
      ∀ t, |t| < δ →
        c ≤ fourierPositiveSmoothTentFunction T hT t) ∧
      K.SmoothTransformIntegrable
        (fourierPositiveSmoothTentFunction T hT) ∧
      ‖K.transform (fourierPositiveSmoothTentFunction T hT) x‖ ≤
        U.constant * T ^ 2 * besselEnvelope x := by
  refine ⟨fourierPositiveSmoothTentFunction_localPositiveFloor T hT, ?_⟩
  change
    K.SmoothTransformIntegrable
        (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function ∧
      ‖K.transform
        (autocorrelationFourierPositiveSmoothTentMember T hT).toSmoothTentMember.function x‖ ≤
        U.constant * T ^ 2 * besselEnvelope x
  exact U.autocorrelationFourierPositiveSmoothTent_admissibleAndBound hT hx

/-- Concrete specialization of the same-test certificate: no abstract
`UniformKernelEnvelope` argument remains. -/
theorem profileBesselConvention_sameTestCertificate
    {T x : ℝ} (hT : 0 < T) (hx : 0 < x) :
    (∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
      ∀ t, |t| < δ →
        c ≤ fourierPositiveSmoothTentFunction T hT t) ∧
      profileBesselConvention.SmoothTransformIntegrable
        (fourierPositiveSmoothTentFunction T hT) ∧
      ‖profileBesselConvention.transform
          (fourierPositiveSmoothTentFunction T hT) x‖ ≤
        T ^ 2 * besselEnvelope x := by
  simpa [profileBesselUniformKernelEnvelope] using
    (profileBesselUniformKernelEnvelope.autocorrelationFourierPositiveSmoothTent_localFloorAndKernelEnvelope
      hT hx)

/-- Uniform envelope for every scale in a supplied nonzero smooth family. -/
theorem UniformKernelEnvelope.smoothTentFamily_bound
    {K : Convention} (U : UniformKernelEnvelope K)
    (A : SmoothTentFamily) {T x : ℝ}
    (hT : 0 < T) (hx : 0 < x) :
    ‖K.transform (A.member T hT).function x‖ ≤
      U.constant * T ^ 2 * besselEnvelope x :=
  U.smoothTent_bound hT (A.member T hT) x hx

/-- Envelope consequence for the explicit nonzero bump family constructed
above.  Besides the paper-specific normalized-kernel envelope `U`, using this
particular bump family in a full Kuznetsov trace formula still requires its own
Fourier/localization proof.  The autocorrelation family above supplies a
separate Fourier-positive smooth alternative, but it too still needs whichever
holomorphic-strip and paper-normalization conditions the trace formula demands. -/
theorem UniformKernelEnvelope.bumpSmoothTent_bound
    {K : Convention} (U : UniformKernelEnvelope K)
    {T x : ℝ} (hT : 0 < T) (hx : 0 < x) :
    ‖K.transform (bumpSmoothTentMember T hT).function x‖ ≤
      U.constant * T ^ 2 * besselEnvelope x :=
  U.smoothTentFamily_bound bumpSmoothTentFamily hT hx

end KuznetsovInterface

namespace KuznetsovKloosterman

open KuznetsovInterface KloostermanTail

/-- The positive modulus represented by the zero-based Lean index `c`. -/
def modulus (c : ℕ) : ℕ :=
  c + 1

/-- Every zero-based series index represents a genuinely positive modulus. -/
instance modulus_neZero (c : ℕ) : NeZero (modulus c) where
  out := by simp [modulus]

/-- A convention-chosen unit-norm residue weight at `h / (c + 1)`.  This is the
finite arithmetic input used by the Mock-I formula; it is not, by itself, a
theta/eta multiplier system or a Γ(2) double-coset construction.  Unit norm
rules out the zero-weight toy instances present in the auxiliary Lean files. -/
structure UnitNormResidueWeight where
  value : (c : ℕ) → (ZMod (modulus c))ˣ → ℂ
  norm_one : ∀ c h, ‖value c h‖ = 1

/-- The inverse reduced residue, represented intrinsically by inversion in the
unit group of `ZMod (c + 1)`. -/
def inverseResidue (c : ℕ)
    (h : (ZMod (modulus c))ˣ) : ZMod (modulus c) :=
  ↑(h⁻¹)

/-- The phase argument as an intrinsic residue class.  This is the canonical
arithmetic object: no integer representative is chosen in its definition. -/
def phaseResidue (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) : ZMod (modulus c) :=
  (n : ZMod (modulus c)) * (h : ZMod (modulus c)) -
    (ℓ : ZMod (modulus c)) * inverseResidue c h

/-- One integer lift of `n h - ℓ h̄`, retained only to display the usual
complex exponential formula. -/
def phaseLift (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) : ℤ :=
  (n : ℤ) * ((h : ZMod (modulus c)).val : ℤ) -
    (ℓ : ℤ) * ((inverseResidue c h).val : ℤ)

/-- Casting the displayed lift back to `ZMod (c + 1)` recovers the intrinsic
residue phase. -/
theorem phaseLift_cast_eq_phaseResidue
    (ℓ n c : ℕ) (h : (ZMod (modulus c))ˣ) :
    ((phaseLift ℓ n c h : ℤ) : ZMod (modulus c)) =
      phaseResidue ℓ n c h := by
  simp only [phaseLift, phaseResidue, inverseResidue,
    Int.cast_sub, Int.cast_mul, Int.cast_natCast]
  rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]

/-- The canonical phase `exp (2π i (n h - ℓ h̄) / (c + 1))`, implemented by
Mathlib's standard primitive additive character of `ZMod (c + 1)`. -/
noncomputable def halfIntegralPhase (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) : ℂ :=
  ZMod.stdAddChar (phaseResidue ℓ n c h)

/-- Congruent choices of integer representatives give exactly the same
additive character. -/
theorem standardAdditivePhase_rep_independent
    (ℓ n c : ℕ) {a a' b b' : ℤ}
    (ha : a ≡ a' [ZMOD modulus c])
    (hb : b ≡ b' [ZMOD modulus c]) :
    ZMod.stdAddChar
        (((n : ℤ) * a - (ℓ : ℤ) * b : ℤ) : ZMod (modulus c)) =
      ZMod.stdAddChar
        (((n : ℤ) * a' - (ℓ : ℤ) * b' : ℤ) : ZMod (modulus c)) := by
  apply congrArg (ZMod.stdAddChar (N := modulus c))
  simp only [Int.cast_sub, Int.cast_mul]
  rw [(ZMod.intCast_eq_intCast_iff a a' (modulus c)).2 ha,
      (ZMod.intCast_eq_intCast_iff b b' (modulus c)).2 hb]

/-- Arbitrary lifts of `h` and `h⁻¹` evaluate to the intrinsic phase. -/
theorem halfIntegralPhase_eq_of_representatives
    (ℓ n c : ℕ) (h : (ZMod (modulus c))ˣ) (a b : ℤ)
    (ha : (a : ZMod (modulus c)) = (h : ZMod (modulus c)))
    (hb : (b : ZMod (modulus c)) = inverseResidue c h) :
    ZMod.stdAddChar
        (((n : ℤ) * a - (ℓ : ℤ) * b : ℤ) : ZMod (modulus c)) =
      halfIntegralPhase ℓ n c h := by
  rw [halfIntegralPhase]
  apply congrArg (ZMod.stdAddChar (N := modulus c))
  simp only [Int.cast_sub, Int.cast_mul, Int.cast_natCast, phaseResidue]
  rw [ha, hb]

theorem halfIntegralPhase_eq_exp (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) :
    halfIntegralPhase ℓ n c h =
      Complex.exp
        (2 * Real.pi * Complex.I *
          (phaseLift ℓ n c h : ℂ) / (modulus c : ℂ)) := by
  rw [halfIntegralPhase, ← phaseLift_cast_eq_phaseResidue]
  simpa using
    (ZMod.stdAddChar_coe
      (N := modulus c) (phaseLift ℓ n c h))

/-- Each additive phase has unit complex norm. -/
theorem norm_halfIntegralPhase (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) :
    ‖halfIntegralPhase ℓ n c h‖ = 1 := by
  rw [halfIntegralPhase, ZMod.stdAddChar_apply]
  exact Circle.norm_coe _

/-- The finite unit-residue twisted sum occurring in the local Mock-I formula.
Additional cusp-pair, scaling-matrix, shifted-frequency, and multiplier-cocycle
data are required before this can be called the Γ(2) Kloosterman sum. -/
noncomputable def halfIntegralUnitResidueSum
    (W : UnitNormResidueWeight) (ℓ n c : ℕ) : ℂ :=
  ∑ h : (ZMod (modulus c))ˣ,
    W.value c h * halfIntegralPhase ℓ n c h

/-- No summand in the finite generalized Kloosterman sum is a zero toy term.
The sum itself may of course vanish by genuine cancellation. -/
theorem norm_halfIntegralUnitResidueSummand
    (W : UnitNormResidueWeight) (ℓ n c : ℕ)
    (h : (ZMod (modulus c))ˣ) :
    ‖W.value c h * halfIntegralPhase ℓ n c h‖ = 1 := by
  rw [norm_mul, W.norm_one c h, norm_halfIntegralPhase, one_mul]

/-- The concrete map through which `Gamma(2)` acts on the real projective line. -/
noncomputable def gamma2BoundaryActionHom :
    Gamma2Element →*
      Matrix.GeneralLinearGroup (Fin 2) ℝ :=
  (Matrix.SpecialLinearGroup.mapGL
      (n := Fin 2) (R := ℤ) ℝ).comp Gamma2.subtype

/-- The boundary point represented by the existing scaling matrix. -/
noncomputable def gamma2CuspBoundaryPoint
    (κ : Gamma2Cusp) : OnePoint ℝ :=
  (Matrix.SpecialLinearGroup.mapGL
      (n := Fin 2) (R := ℤ) ℝ)
      (Gamma2Cusp.scalingMatrix κ) •
    (OnePoint.infty : OnePoint ℝ)

/-- The identity scaling represents the cusp at infinity. -/
@[simp]
theorem gamma2CuspBoundaryPoint_infinity :
    gamma2CuspBoundaryPoint .infinity =
      (OnePoint.infty : OnePoint ℝ) := by
  simp [gamma2CuspBoundaryPoint, Gamma2Cusp.scalingMatrix]

/-- The `S` scaling represents the boundary point zero. -/
@[simp]
theorem gamma2CuspBoundaryPoint_zero :
    gamma2CuspBoundaryPoint .zero = ((0 : ℝ) : OnePoint ℝ) := by
  simp [gamma2CuspBoundaryPoint, Gamma2Cusp.scalingMatrix,
    OnePoint.smul_infty_eq_ite, ModularGroup.coe_S]

/-- The `T S` scaling represents the boundary point one. -/
@[simp]
theorem gamma2CuspBoundaryPoint_one :
    gamma2CuspBoundaryPoint .one = ((1 : ℝ) : OnePoint ℝ) := by
  change
    (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ)
        (ModularGroup.T * ModularGroup.S) •
      (OnePoint.infty : OnePoint ℝ) = ((1 : ℝ) : OnePoint ℝ)
  rw [map_mul, mul_smul]
  have hS :
      (Matrix.SpecialLinearGroup.mapGL (n := Fin 2) (R := ℤ) ℝ)
          ModularGroup.S • (OnePoint.infty : OnePoint ℝ) =
        ((0 : ℝ) : OnePoint ℝ) := by
    rw [OnePoint.smul_infty_eq_ite]
    simp [ModularGroup.coe_S]
  rw [hS, OnePoint.smul_some_eq_ite]
  simp [ModularGroup.coe_T]

/-- The three chosen scaling matrices represent pairwise distinct boundary
points. -/
theorem gamma2CuspBoundaryPoint_injective :
    Function.Injective gamma2CuspBoundaryPoint := by
  intro κ lam h
  cases κ <;> cases lam <;> simp_all

/-- The full subgroup of `Gamma(2)` fixing the labelled boundary point. -/
noncomputable def gamma2CuspStabilizer
    (κ : Gamma2Cusp) : Subgroup Gamma2Element :=
  Subgroup.comap gamma2BoundaryActionHom
    (MulAction.stabilizer
      (Matrix.GeneralLinearGroup (Fin 2) ℝ)
      (gamma2CuspBoundaryPoint κ))

/-- A representative after applying the two chosen cusp scalings. -/
def scaledRepresentative
    (κ lam : Gamma2Cusp) (γ : Gamma2Element) :
    Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  (Gamma2Cusp.scalingMatrix κ)⁻¹ *
    (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) *
    Gamma2Cusp.scalingMatrix lam

def scaledLowerLeft
    (κ lam : Gamma2Cusp) (γ : Gamma2Element) : ℤ :=
  scaledRepresentative κ lam γ 1 0

def scaledLowerRight
    (κ lam : Gamma2Cusp) (γ : Gamma2Element) : ℤ :=
  scaledRepresentative κ lam γ 1 1

/-! ### The geometric modulus really descends

The next four lemmas use only the concrete boundary action and determinant-one
matrix algebra.  In particular, they do not construct a half-integral-weight
multiplier, a shifted additive character, finite double-coset fibers, or any
Kuznetsov cancellation estimate. -/

/-- An element of the full stabilizer of a labelled cusp becomes upper
triangular after conjugation by that cusp's chosen scaling matrix. -/
theorem scaledLowerLeft_self_eq_zero_of_mem_stabilizer
    (κ : Gamma2Cusp) (η : Gamma2Element)
    (hη : η ∈ gamma2CuspStabilizer κ) :
    scaledLowerLeft κ κ η = 0 := by
  have hfix :
      gamma2BoundaryActionHom η • gamma2CuspBoundaryPoint κ =
        gamma2CuspBoundaryPoint κ :=
    (MulAction.mem_stabilizer_iff.mp hη)
  let σR : Matrix.GeneralLinearGroup (Fin 2) ℝ :=
    (Matrix.SpecialLinearGroup.mapGL
      (n := Fin 2) (R := ℤ) ℝ) (Gamma2Cusp.scalingMatrix κ)
  have hfix' :
      gamma2BoundaryActionHom η •
          (σR • (OnePoint.infty : OnePoint ℝ)) =
        σR • (OnePoint.infty : OnePoint ℝ) := by
    simpa only [gamma2CuspBoundaryPoint, σR] using hfix
  have hscaled :
      (σR⁻¹ * gamma2BoundaryActionHom η * σR) •
          (OnePoint.infty : OnePoint ℝ) =
        (OnePoint.infty : OnePoint ℝ) := by
    calc
      (σR⁻¹ * gamma2BoundaryActionHom η * σR) •
          (OnePoint.infty : OnePoint ℝ) =
          σR⁻¹ •
            (gamma2BoundaryActionHom η •
              (σR • (OnePoint.infty : OnePoint ℝ))) := by
                simp only [mul_smul]
      _ = σR⁻¹ •
          (σR • (OnePoint.infty : OnePoint ℝ)) :=
        congrArg (fun z => σR⁻¹ • z) hfix'
      _ = (OnePoint.infty : OnePoint ℝ) := by
        exact inv_smul_smul σR (OnePoint.infty : OnePoint ℝ)
  have hmap :
      (Matrix.SpecialLinearGroup.mapGL
          (n := Fin 2) (R := ℤ) ℝ)
          (scaledRepresentative κ κ η) =
        σR⁻¹ * gamma2BoundaryActionHom η * σR := by
    simp [scaledRepresentative, σR, gamma2BoundaryActionHom]
  have hzeroReal :
      (((Matrix.SpecialLinearGroup.mapGL
          (n := Fin 2) (R := ℤ) ℝ)
          (scaledRepresentative κ κ η) :
            Matrix.GeneralLinearGroup (Fin 2) ℝ) 1 0) = 0 := by
    apply (OnePoint.smul_infty_eq_self_iff.mp ?_)
    rw [hmap]
    exact hscaled
  have hentry :
      ((scaledRepresentative κ κ η 1 0 : ℤ) : ℝ) = 0 := by
    simpa using hzeroReal
  change scaledRepresentative κ κ η 1 0 = 0
  exact_mod_cast hentry

/-- Scaling a double-coset product factors into the two self-cusp conjugates
and the original cusp-pair representative. -/
theorem scaledRepresentative_mul_factorization
    (κ lam : Gamma2Cusp) (a γ b : Gamma2Element) :
    scaledRepresentative κ lam (a * γ * b) =
      scaledRepresentative κ κ a *
        scaledRepresentative κ lam γ *
          scaledRepresentative lam lam b := by
  have hab :
      (((a * γ * b : Gamma2Element) :
          Matrix.SpecialLinearGroup (Fin 2) ℤ)) =
        (a : Matrix.SpecialLinearGroup (Fin 2) ℤ) *
          (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) *
            (b : Matrix.SpecialLinearGroup (Fin 2) ℤ) := rfl
  unfold scaledRepresentative
  rw [hab]
  simp only [mul_assoc, mul_inv_cancel_left]

/-- Left and right determinant-one upper-triangular factors can change the
lower-left entry only by signs, so its integer absolute value is unchanged. -/
theorem natAbs_lowerLeft_invariant_of_triangular_mul
    (L G R : Matrix.SpecialLinearGroup (Fin 2) ℤ)
    (hL : L 1 0 = 0) (hR : R 1 0 = 0) :
    Int.natAbs ((L * G * R) 1 0) = Int.natAbs (G 1 0) := by
  have hdetL : L 0 0 * L 1 1 = 1 := by
    have h := Matrix.SpecialLinearGroup.det_coe L
    rw [Matrix.det_fin_two] at h
    simpa only [hL, mul_zero, sub_zero] using h
  have hdetR : R 0 0 * R 1 1 = 1 := by
    have h := Matrix.SpecialLinearGroup.det_coe R
    rw [Matrix.det_fin_two] at h
    simpa only [hR, mul_zero, sub_zero] using h
  have hunitL : IsUnit (L 1 1) :=
    IsUnit.of_mul_eq_one (L 0 0) (by simpa [mul_comm] using hdetL)
  have hunitR : IsUnit (R 0 0) :=
    IsUnit.of_mul_eq_one (R 1 1) hdetR
  have hLsq : L 1 1 * L 1 1 = 1 := by
    simpa only [pow_two] using Int.isUnit_sq hunitL
  have hRsq : R 0 0 * R 0 0 = 1 := by
    simpa only [pow_two] using Int.isUnit_sq hunitR
  have hentry :
      (L * G * R) 1 0 = L 1 1 * G 1 0 * R 0 0 := by
    change ((L.1 * G.1) * R.1) 1 0 =
      L.1 1 1 * G.1 1 0 * R.1 0 0
    simp only [Matrix.mul_apply, Fin.sum_univ_two, hL, hR,
      zero_mul, zero_add, mul_zero, add_zero]
  rw [hentry, Int.natAbs_mul, Int.natAbs_mul]
  have hnatLsq : Int.natAbs (L 1 1) * Int.natAbs (L 1 1) = 1 := by
    simpa only [Int.natAbs_mul, Int.natAbs_one] using congrArg Int.natAbs hLsq
  have hnatRsq : Int.natAbs (R 0 0) * Int.natAbs (R 0 0) = 1 := by
    simpa only [Int.natAbs_mul, Int.natAbs_one] using congrArg Int.natAbs hRsq
  have hnatL : Int.natAbs (L 1 1) = 1 := by
    exact Nat.dvd_one.mp ⟨Int.natAbs (L 1 1), hnatLsq.symm⟩
  have hnatR : Int.natAbs (R 0 0) = 1 := by
    exact Nat.dvd_one.mp ⟨Int.natAbs (R 0 0), hnatRsq.symm⟩
  simp [hnatL, hnatR]

/-- The absolute scaled lower-left modulus is an actual invariant of the full
cusp-pair double-coset relation. -/
theorem natAbs_scaledLowerLeft_eq_of_doubleCoset
    (κ lam : Gamma2Cusp) (γ δ : Gamma2Element)
    (h : DoubleCoset.setoid
      (gamma2CuspStabilizer κ : Set Gamma2Element)
      (gamma2CuspStabilizer lam : Set Gamma2Element) γ δ) :
    Int.natAbs (scaledLowerLeft κ lam γ) =
      Int.natAbs (scaledLowerLeft κ lam δ) := by
  rcases (DoubleCoset.rel_iff.mp h) with
    ⟨a, ha, b, hb, rfl⟩
  change
    Int.natAbs (scaledRepresentative κ lam γ 1 0) =
      Int.natAbs (scaledRepresentative κ lam (a * γ * b) 1 0)
  rw [scaledRepresentative_mul_factorization]
  exact
    (natAbs_lowerLeft_invariant_of_triangular_mul
      (scaledRepresentative κ κ a)
      (scaledRepresentative κ lam γ)
      (scaledRepresentative lam lam b)
      (scaledLowerLeft_self_eq_zero_of_mem_stabilizer κ a ha)
      (scaledLowerLeft_self_eq_zero_of_mem_stabilizer lam b hb)).symm

/-- The genuine full-stabilizer cusp-pair double quotient. -/
abbrev Gamma2CuspPairClass
    (κ lam : Gamma2Cusp) : Type :=
  DoubleCoset.Quotient
    (gamma2CuspStabilizer κ : Set Gamma2Element)
    (gamma2CuspStabilizer lam : Set Gamma2Element)

/-- Data proving that the absolute modulus and the complete unit-norm
multiplier/phase summand descend to the full cusp-pair double quotient.

The term is complex-valued with explicit unit-norm and descent laws because the
incomplete PDF does not construct the character-compatible stabilizer,
theta/eta multiplier cocycle, or their compatibility with the shifted
frequencies. -/
structure Gamma2CuspPairKernel where
  shiftedFrequency : Gamma2Cusp → ℕ → ℚ
  representativeTerm :
    (κ lam : Gamma2Cusp) → ℚ → ℚ → Gamma2Element → ℂ
  /-- Excludes the zero-kernel toy model: a multiplier times an additive phase
  has unit complex norm before summation. -/
  representativeTerm_norm_one : ∀ κ lam m n γ,
    ‖representativeTerm κ lam
        (shiftedFrequency κ m)
        (shiftedFrequency lam n) γ‖ = 1
  modulus_respects_doubleCoset :
    ∀ κ lam γ δ,
      DoubleCoset.setoid
          (gamma2CuspStabilizer κ : Set Gamma2Element)
          (gamma2CuspStabilizer lam : Set Gamma2Element) γ δ →
        Int.natAbs (scaledLowerLeft κ lam γ) =
          Int.natAbs (scaledLowerLeft κ lam δ)
  term_respects_doubleCoset :
    ∀ κ lam m n γ δ,
      DoubleCoset.setoid
          (gamma2CuspStabilizer κ : Set Gamma2Element)
          (gamma2CuspStabilizer lam : Set Gamma2Element) γ δ →
        representativeTerm κ lam
            (shiftedFrequency κ m)
            (shiftedFrequency lam n) γ =
        representativeTerm κ lam
            (shiftedFrequency κ m)
            (shiftedFrequency lam n) δ

/-- A nonzero constant-unit witness that the concrete geometric modulus and a
unit-norm term can simultaneously descend to every cusp-pair quotient.

This is deliberately *not* identified with the paper's Kloosterman kernel: it
contains neither its shifted phase nor its theta/eta multiplier, and supplies
no finite-fiber or cancellation data. -/
def constantUnitGamma2CuspPairKernel : Gamma2CuspPairKernel where
  shiftedFrequency := fun _ m => (m : ℚ)
  representativeTerm := fun _ _ _ _ _ => 1
  representativeTerm_norm_one := by
    intro κ lam m n γ
    simp
  modulus_respects_doubleCoset := by
    intro κ lam γ δ h
    exact natAbs_scaledLowerLeft_eq_of_doubleCoset κ lam γ δ h
  term_respects_doubleCoset := by
    intro κ lam m n γ δ h
    rfl

/-- The absolute lower-left modulus descends to the double quotient. -/
noncomputable def gamma2CuspPairModulus
    (D : Gamma2CuspPairKernel)
    (κ lam : Gamma2Cusp)
    (q : Gamma2CuspPairClass κ lam) : ℕ :=
  Quotient.liftOn' q
    (fun γ => Int.natAbs (scaledLowerLeft κ lam γ))
    (fun γ δ h =>
      D.modulus_respects_doubleCoset κ lam γ δ h)

/-- The complete shifted-frequency summand descends to the double quotient. -/
noncomputable def gamma2CuspPairTerm
    (D : Gamma2CuspPairKernel)
    (κ lam : Gamma2Cusp) (m n : ℕ)
    (q : Gamma2CuspPairClass κ lam) : ℂ :=
  Quotient.liftOn' q
    (fun γ =>
      D.representativeTerm κ lam
        (D.shiftedFrequency κ m)
        (D.shiftedFrequency lam n) γ)
    (fun γ δ h =>
      D.term_respects_doubleCoset κ lam m n γ δ h)

/-- The descended double-coset summand still has unit norm. -/
theorem norm_gamma2CuspPairTerm
    (D : Gamma2CuspPairKernel)
    (κ lam : Gamma2Cusp) (m n : ℕ)
    (q : Gamma2CuspPairClass κ lam) :
    ‖gamma2CuspPairTerm D κ lam m n q‖ = 1 := by
  refine Quotient.inductionOn' q ?_
  intro γ
  change
    ‖D.representativeTerm κ lam
        (D.shiftedFrequency κ m)
        (D.shiftedFrequency lam n) γ‖ = 1
  exact D.representativeTerm_norm_one κ lam m n γ

/-- The actual double-coset fiber at positive indexed modulus `c + 1`. -/
def Gamma2CuspPairFiber
    (D : Gamma2CuspPairKernel)
    (κ lam : Gamma2Cusp) (c : ℕ) : Type :=
  {q : Gamma2CuspPairClass κ lam //
    gamma2CuspPairModulus D κ lam q = modulus c}

/-- Finiteness of every positive-modulus quotient fiber is explicit data. -/
structure Gamma2CuspPairFiniteData
    (D : Gamma2CuspPairKernel) where
  fiberFintype :
    ∀ κ lam c, Fintype (Gamma2CuspPairFiber D κ lam c)

/-- The finite sum over the genuine positive-modulus double-coset fiber. -/
noncomputable def gamma2CuspPairFiniteSum
    (D : Gamma2CuspPairKernel)
    (F : Gamma2CuspPairFiniteData D)
    (κ lam : Gamma2Cusp) (m n c : ℕ) : ℂ :=
  letI : Fintype (Gamma2CuspPairFiber D κ lam c) :=
    F.fiberFintype κ lam c
  ∑ q : Gamma2CuspPairFiber D κ lam c,
    gamma2CuspPairTerm D κ lam m n q.val

/-- The classical Kuznetsov argument `4π√(mn)/c`, with a positive indexed
modulus. -/
def modulusArgument (m n c : ℕ) : ℝ :=
  4 * Real.pi * Real.sqrt ((m : ℝ) * (n : ℝ)) / (modulus c : ℝ)

theorem modulusArgument_pos
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) (c : ℕ) :
    0 < modulusArgument m n c := by
  have hm' : 0 < (m : ℝ) := Nat.cast_pos.2 hm
  have hn' : 0 < (n : ℝ) := Nat.cast_pos.2 hn
  have hc' : 0 < (modulus c : ℝ) :=
    Nat.cast_pos.2 (by simp [modulus])
  exact div_pos
    (mul_pos (mul_pos (by norm_num) Real.pi_pos)
      (Real.sqrt_pos.2 (mul_pos hm' hn')))
    hc'

/-- The formal transform weight in the positive-modulus ordered series.  Division by
the modulus is part of the term and the normalized transform is evaluated at
the classical positive argument. -/
noncomputable def modulusWeight
    (K : Convention) (f : ℝ → ℝ) (m n c : ℕ) : ℂ :=
  K.transform f (modulusArgument m n c) /
    (modulus c : ℂ)

/-- The gcd-retaining Weil--Kohnen majorant.  It is deliberately kept
separate from the summable post-cancellation tail: this pointwise majorant is
not summable in the range claimed by the PDF. -/
def gcdWeilMajorant (A δ : ℝ) (m n c : ℕ) : ℝ :=
  A * (modulus c : ℝ) ^ ((1 / 2 : ℝ) + δ) *
    Real.sqrt ((Nat.gcd (Nat.gcd m n) (modulus c) : ℕ) : ℝ)

theorem gcdWeilMajorant_nonneg
    {A δ : ℝ} (hA : 0 ≤ A) (m n c : ℕ) :
    0 ≤ gcdWeilMajorant A δ m n c := by
  have hc : 0 ≤ (modulus c : ℝ) := Nat.cast_nonneg _
  exact mul_nonneg
    (mul_nonneg hA (Real.rpow_nonneg hc _))
    (Real.sqrt_nonneg _)

/-- The full three-variable Weil gcd always divides the retained frequency
pair gcd; it is never absorbed into a constant. -/
theorem tripleGcd_dvd_pairGcd (m n c : ℕ) :
    Nat.gcd (Nat.gcd m n) (modulus c) ∣ Nat.gcd m n :=
  Nat.gcd_dvd_left _ _

/-- Numerical version of `tripleGcd_dvd_pairGcd` for positive frequency. -/
theorem tripleGcd_le_pairGcd
    {m n : ℕ} (hm : 0 < m) (c : ℕ) :
    Nat.gcd (Nat.gcd m n) (modulus c) ≤ Nat.gcd m n :=
  Nat.le_of_dvd (Nat.gcd_pos_of_pos_left n hm)
    (tripleGcd_dvd_pairGcd m n c)

/-- The corresponding square-root factor is bounded by the explicit pair-gcd
factor kept in the final cancellation estimate. -/
theorem sqrt_tripleGcd_le_sqrt_pairGcd
    {m n : ℕ} (hm : 0 < m) (c : ℕ) :
    Real.sqrt
        ((Nat.gcd (Nat.gcd m n) (modulus c) : ℕ) : ℝ) ≤
      Real.sqrt ((Nat.gcd m n : ℕ) : ℝ) := by
  apply Real.sqrt_le_sqrt
  exact_mod_cast tripleGcd_le_pairGcd (n := n) hm c

/-- The pair-gcd factor retained in Lemma 2.2 is unbounded and therefore may
not be absorbed into a constant independent of `m,n`. -/
theorem pairGcd_unbounded (C : ℕ) :
    ∃ m n : ℕ, C < Nat.gcd m n := by
  exact ⟨C + 1, C + 1, by simp⟩

/-- Archimedean form of the same variable-factor obstruction. -/
theorem natCast_unbounded :
    ¬ ∃ C : ℝ, ∀ N : ℕ, (N : ℝ) ≤ C := by
  rintro ⟨C, hC⟩
  obtain ⟨N, hN⟩ := exists_nat_gt C
  exact (not_lt_of_ge (hC N)) hN

/-- Exact data needed to replace the divergent absolute-value proof of
Lemmas 1.3/2.2.  `weil_bound` retains the full gcd dependence.  The genuinely
summable `tail_bound` is imposed only on the Abel remainder produced by the
ordered cancellation certificate, never on the raw Kloosterman terms. -/
structure CancellationData
    (K : Convention) (f : ℝ → ℝ) (m n : ℕ) where
  m_pos : 0 < m
  n_pos : 0 < n
  transformAdmissible : K.Admissible f
  /-- The coefficient sequence at actual modulus `c + 1`. -/
  kloostermanSum : ℕ → ℂ
  weilConstant : ℝ
  weilConstant_nonneg : 0 ≤ weilConstant
  weilExponent : ℝ
  weilExponent_pos : 0 < weilExponent
  weil_bound : ∀ c,
    ‖kloostermanSum c‖ ≤
      gcdWeilMajorant weilConstant weilExponent m n c
  cancellation : AbelCancellationCertificate kloostermanSum
    (modulusWeight K f m n)
  tailConstant : ℝ
  tailConstant_nonneg : 0 ≤ tailConstant
  tailExponent : ℝ
  tailExponent_pos : 0 < tailExponent
  tail_bound : ∀ c,
    cancellation.majorant c ≤
      (tailConstant *
        Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
        pSeriesMajorant tailExponent c

/-- **Conditional Abel-cancellation replacement for Lemmas 1.3/2.2.** The supplied
coefficient series converges in positive-modulus order, and its value is
bounded by the summable Abel tail.  The raw gcd-dependent Weil estimate is
recorded in `CancellationData.weil_bound` but is not misused as an absolute
convergence argument. -/
theorem orderedKloosterman_and_bound
    {K : Convention} {f : ℝ → ℝ} {m n : ℕ}
    (D : CancellationData K f m n) :
    HasOrderedSum
        (fun c => D.kloostermanSum c * modulusWeight K f m n c)
        D.cancellation.orderedValue ∧
      ‖D.cancellation.orderedValue‖ ≤
        (D.tailConstant *
          Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
          pSeriesConstant D.tailExponent :=
  orderedKernel_and_bound D.cancellation D.tailExponent_pos D.tail_bound

/-- The explicit frequency scale which a paper-style constant is not allowed to
absorb. -/
def frequencyGrowth (ε : ℝ) (m n : ℕ) : ℝ :=
  (1 + (m : ℝ) * (n : ℝ)) ^ ((1 / 4 : ℝ) + ε)

theorem frequencyGrowth_nonneg (ε : ℝ) (m n : ℕ) :
    0 ≤ frequencyGrowth ε m n := by
  unfold frequencyGrowth
  exact Real.rpow_nonneg (by positivity) _

/-- Uniform-in-frequency cancellation data.  The common constant and common
tail exponent are outside the `(m,n)`-indexed package, so they cannot absorb
arbitrary frequency dependence. -/
structure UniformCancellationFamily
    (K : Convention) (f : ℝ → ℝ) (ε : ℝ) where
  epsilon_pos : 0 < ε
  constant : ℝ
  constant_nonneg : 0 ≤ constant
  tailExponent : ℝ
  tailExponent_pos : 0 < tailExponent
  data : ∀ m n, 0 < m → 0 < n → CancellationData K f m n
  tailExponent_eq : ∀ m n hm hn,
    (data m n hm hn).tailExponent = tailExponent
  tailConstant_le : ∀ m n hm hn,
    (data m n hm hn).tailConstant ≤
      constant * frequencyGrowth ε m n

/-- A genuinely uniform paper-style frequency bound, still retaining the
explicit pair-gcd factor rather than hiding it in the common constant. -/
theorem uniformOrderedKloosterman_and_bound
    {K : Convention} {f : ℝ → ℝ} {ε : ℝ}
    (U : UniformCancellationFamily K f ε)
    {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    HasOrderedSum
        (fun c =>
          (U.data m n hm hn).kloostermanSum c *
            modulusWeight K f m n c)
        (U.data m n hm hn).cancellation.orderedValue ∧
      ‖(U.data m n hm hn).cancellation.orderedValue‖ ≤
        ((U.constant * frequencyGrowth ε m n) *
          Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
          pSeriesConstant U.tailExponent := by
  let D := U.data m n hm hn
  change
    HasOrderedSum
        (fun c => D.kloostermanSum c * modulusWeight K f m n c)
        D.cancellation.orderedValue ∧
      ‖D.cancellation.orderedValue‖ ≤
        ((U.constant * frequencyGrowth ε m n) *
          Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
          pSeriesConstant U.tailExponent
  have h := orderedKloosterman_and_bound D
  refine ⟨h.1, h.2.trans ?_⟩
  rw [show D.tailExponent = U.tailExponent from
    U.tailExponent_eq m n hm hn]
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right
      (U.tailConstant_le m n hm hn) (Real.sqrt_nonneg _))
    (pSeriesConstant_nonneg U.tailExponent)

/-- A separate certificate identifying a coefficient sequence with the local
all-unit residue model.  This is intentionally not built into
`CancellationData`: a genuine cusp-pair fiber need not contain every unit
residue. -/
structure UnitResidueIdentification
    {K : Convention} {f : ℝ → ℝ} {m n : ℕ}
    (D : CancellationData K f m n) where
  residueWeight : UnitNormResidueWeight
  coefficient_eq :
    D.kloostermanSum =
      halfIntegralUnitResidueSum residueWeight m n

/-- A separate certificate identifying a coefficient sequence with the finite
sum over a genuine `Gamma(2)` cusp-pair double-coset fiber. -/
structure Gamma2CuspPairIdentification
    {K : Convention} {f : ℝ → ℝ} {m n : ℕ}
    (D : CancellationData K f m n) where
  kernel : Gamma2CuspPairKernel
  finiteData : Gamma2CuspPairFiniteData kernel
  sourceCusp : Gamma2Cusp
  targetCusp : Gamma2Cusp
  coefficient_eq :
    D.kloostermanSum =
      gamma2CuspPairFiniteSum kernel finiteData
        sourceCusp targetCusp m n

/-- The generic ordered cancellation theorem specialized to the genuine
double-coset-fiber coefficient sequence. -/
theorem orderedGamma2CuspPair_and_bound
    {K : Convention} {f : ℝ → ℝ} {m n : ℕ}
    (D : CancellationData K f m n)
    (I : Gamma2CuspPairIdentification D) :
    HasOrderedSum
        (fun c =>
          gamma2CuspPairFiniteSum I.kernel I.finiteData
              I.sourceCusp I.targetCusp m n c *
            modulusWeight K f m n c)
        D.cancellation.orderedValue ∧
      ‖D.cancellation.orderedValue‖ ≤
        (D.tailConstant *
          Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
          pSeriesConstant D.tailExponent := by
  simpa only [← I.coefficient_eq] using
    orderedKloosterman_and_bound D

/-- The same conditional Abel conclusion stated directly for the finite
unit-residue twisted sum, rather than through a free coefficient sequence.
The all-unit identification is a separate certificate and is not conflated
with the genuine cusp-pair quotient; analytic cancellation remains an explicit
input. -/
theorem orderedHalfIntegralUnitResidue_and_bound
    {K : Convention} {f : ℝ → ℝ} {m n : ℕ}
    (D : CancellationData K f m n)
    (I : UnitResidueIdentification D) :
    HasOrderedSum
        (fun c =>
          halfIntegralUnitResidueSum I.residueWeight m n c *
            modulusWeight K f m n c)
        D.cancellation.orderedValue ∧
      ‖D.cancellation.orderedValue‖ ≤
        (D.tailConstant *
          Real.sqrt ((Nat.gcd m n : ℕ) : ℝ)) *
          pSeriesConstant D.tailExponent := by
  simpa only [← I.coefficient_eq] using
    orderedKloosterman_and_bound D

end KuznetsovKloosterman

/-! ## Concrete finite arithmetic leaf: twisted Kloosterman sums

This namespace supplies the finite arithmetic object which is logically prior
to any Kuznetsov cancellation estimate.  Reduced residues are units of
`ZMod c`, inversion is therefore genuine unit-group inversion, and the
multiplier takes values in `Circle`.  In particular, unit norm is enforced by
the codomain rather than stored as a conclusion-shaped structure field. -/

namespace ConcreteTwistedKloosterman

/-- A reduced residue modulo `c`, represented intrinsically as a unit of
`ZMod c`. -/
abbrev UnitResidue (c : ℕ) := (ZMod c)ˣ

/-- A multiplier phase is explicitly circle-valued at every reduced residue.
There is no separate norm-one hypothesis. -/
abbrev MultiplierPhase (c : ℕ) := UnitResidue c → Circle

/-- The inverse residue is the value of the inverse in the unit group. -/
def inverseResidue {c : ℕ} (u : UnitResidue c) : ZMod c :=
  ↑(u⁻¹)

/-- The unit condition justifies the right-inverse identity in `ZMod c`. -/
@[simp]
theorem residue_mul_inverseResidue {c : ℕ} (u : UnitResidue c) :
    (u : ZMod c) * inverseResidue u = 1 := by
  simpa only [inverseResidue] using (Units.mul_inv u)

/-- The unit condition also justifies the left-inverse identity. -/
@[simp]
theorem inverseResidue_mul_residue {c : ℕ} (u : UnitResidue c) :
    inverseResidue u * (u : ZMod c) = 1 := by
  simpa only [inverseResidue] using (Units.inv_mul u)

/-- The intrinsic Kloosterman phase residue `m u + n u⁻¹`.  No integer lift is
chosen in this definition. -/
def phaseResidue {c : ℕ} (m n : ℤ) (u : UnitResidue c) : ZMod c :=
  (m : ZMod c) * (u : ZMod c) +
    (n : ZMod c) * inverseResidue u

/-- Any integer lifts of `u` and `u⁻¹` cast back to the intrinsic phase. -/
theorem phaseResidue_eq_of_lifts
    {c : ℕ} (m n : ℤ) (u : UnitResidue c) (a b : ℤ)
    (ha : (a : ZMod c) = (u : ZMod c))
    (hb : (b : ZMod c) = inverseResidue u) :
    ((m * a + n * b : ℤ) : ZMod c) = phaseResidue m n u := by
  simp only [Int.cast_add, Int.cast_mul, phaseResidue]
  rw [ha, hb]

/-- Congruent choices of both integer representatives have the same phase
residue.  This is the representative-independence statement before applying
the additive character. -/
theorem phaseResidue_lift_independent
    {c : ℕ} (m n : ℤ) {a a' b b' : ℤ}
    (ha : a ≡ a' [ZMOD c]) (hb : b ≡ b' [ZMOD c]) :
    ((m * a + n * b : ℤ) : ZMod c) =
      ((m * a' + n * b' : ℤ) : ZMod c) := by
  simp only [Int.cast_add, Int.cast_mul]
  rw [(ZMod.intCast_eq_intCast_iff a a' c).2 ha,
      (ZMod.intCast_eq_intCast_iff b b' c).2 hb]

/-- The standard primitive additive character evaluated at the intrinsic
Kloosterman phase. -/
noncomputable def additivePhase
    {c : ℕ} [NeZero c] (m n : ℤ) (u : UnitResidue c) : ℂ :=
  ZMod.stdAddChar (phaseResidue m n u)

/-- Integer lifts satisfying the unit and inverse-unit equations evaluate to
the intrinsic additive phase. -/
theorem additivePhase_eq_of_lifts
    {c : ℕ} [NeZero c] (m n : ℤ) (u : UnitResidue c) (a b : ℤ)
    (ha : (a : ZMod c) = (u : ZMod c))
    (hb : (b : ZMod c) = inverseResidue u) :
    ZMod.stdAddChar (((m * a + n * b : ℤ) : ZMod c)) =
      additivePhase m n u := by
  rw [additivePhase, phaseResidue_eq_of_lifts m n u a b ha hb]

/-- Applying the additive character preserves representative-independence. -/
theorem additivePhase_lift_independent
    {c : ℕ} [NeZero c] (m n : ℤ) {a a' b b' : ℤ}
    (ha : a ≡ a' [ZMOD c]) (hb : b ≡ b' [ZMOD c]) :
    ZMod.stdAddChar (((m * a + n * b : ℤ) : ZMod c)) =
      ZMod.stdAddChar (((m * a' + n * b' : ℤ) : ZMod c)) := by
  exact congrArg (ZMod.stdAddChar (N := c))
    (phaseResidue_lift_independent m n ha hb)

/-- Every standard additive phase has complex norm one. -/
theorem norm_additivePhase
    {c : ℕ} [NeZero c] (m n : ℤ) (u : UnitResidue c) :
    ‖additivePhase m n u‖ = 1 := by
  rw [additivePhase, ZMod.stdAddChar_apply]
  exact Circle.norm_coe _

/-- Circle-valued multiplier phases have unit complex norm by construction. -/
theorem norm_multiplierPhase
    {c : ℕ} (χ : MultiplierPhase c) (u : UnitResidue c) :
    ‖(χ u : ℂ)‖ = 1 :=
  Circle.norm_coe _

/-- One summand in the finite twisted Kloosterman sum. -/
noncomputable def twistedSummand
    {c : ℕ} [NeZero c] (χ : MultiplierPhase c)
    (m n : ℤ) (u : UnitResidue c) : ℂ :=
  (χ u : ℂ) * additivePhase m n u

/-- Every summand has norm one; this follows from the two explicit
circle-valued factors and uses no certificate field. -/
theorem norm_twistedSummand
    {c : ℕ} [NeZero c] (χ : MultiplierPhase c)
    (m n : ℤ) (u : UnitResidue c) :
    ‖twistedSummand χ m n u‖ = 1 := by
  rw [twistedSummand, norm_mul, norm_multiplierPhase,
    norm_additivePhase, one_mul]

/-- The actual finite twisted Kloosterman sum over every reduced residue
modulo the positive modulus `c`. -/
noncomputable def twistedKloostermanSum
    {c : ℕ} [NeZero c] (χ : MultiplierPhase c) (m n : ℤ) : ℂ :=
  ∑ u : UnitResidue c, twistedSummand χ m n u

/-- The elementary finite arithmetic bound: the norm of the sum is at most
the number of reduced residues. -/
theorem norm_twistedKloostermanSum_le_card
    {c : ℕ} [NeZero c] (χ : MultiplierPhase c) (m n : ℤ) :
    ‖twistedKloostermanSum χ m n‖ ≤
      (Fintype.card (UnitResidue c) : ℝ) := by
  unfold twistedKloostermanSum
  calc
    ‖∑ u : UnitResidue c, twistedSummand χ m n u‖
        ≤ ∑ u : UnitResidue c, ‖twistedSummand χ m n u‖ :=
      norm_sum_le _ _
    _ = ∑ _u : UnitResidue c, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro u _hu
      exact norm_twistedSummand χ m n u
    _ = (Fintype.card (UnitResidue c) : ℝ) := by simp

/-- The constant-one circle-valued multiplier. -/
def trivialMultiplierPhase (c : ℕ) : MultiplierPhase c :=
  fun _ => 1

/-- At modulus one the unique summand for the trivial multiplier is one. -/
@[simp]
theorem twistedSummand_trivialMultiplier_modulus_one
    (m n : ℤ) (u : UnitResidue 1) :
    twistedSummand (trivialMultiplierPhase 1) m n u = 1 := by
  have hphase : phaseResidue m n u = (0 : ZMod 1) :=
    Subsingleton.elim _ _
  simp [twistedSummand, trivialMultiplierPhase, additivePhase, hphase]

/-- Normalization at modulus one for the trivial multiplier. -/
@[simp]
theorem twistedKloostermanSum_trivialMultiplier_modulus_one
    (m n : ℤ) :
    twistedKloostermanSum (trivialMultiplierPhase 1) m n = 1 := by
  rw [twistedKloostermanSum, Fintype.sum_unique]
  exact twistedSummand_trivialMultiplier_modulus_one m n default

/-! ### Why a specific arithmetic multiplier theorem is indispensable

Circle-valuedness alone gives no square-root cancellation.  For any fixed
indices one can choose the inverse additive character as multiplier, making
every summand equal to one and saturating the elementary cardinality bound. -/

/-- The multiplier which cancels the intrinsic additive character pointwise. -/
noncomputable def cancellingMultiplierPhase
    {c : ℕ} [NeZero c] (m n : ℤ) : MultiplierPhase c :=
  fun u => (ZMod.toCircle (phaseResidue m n u))⁻¹

@[simp]
theorem twistedSummand_cancellingMultiplierPhase
    {c : ℕ} [NeZero c] (m n : ℤ) (u : UnitResidue c) :
    twistedSummand (cancellingMultiplierPhase m n) m n u = 1 := by
  simp [twistedSummand, cancellingMultiplierPhase, additivePhase,
    ZMod.stdAddChar_apply]

/-- The cancelling multiplier makes the twisted sum exactly the number of
reduced residues, embedded in `ℂ`. -/
theorem twistedKloostermanSum_cancellingMultiplierPhase
    {c : ℕ} [NeZero c] (m n : ℤ) :
    twistedKloostermanSum (cancellingMultiplierPhase (c := c) m n) m n =
      (Fintype.card (UnitResidue c) : ℂ) := by
  simp [twistedKloostermanSum]

/-- Consequently the trivial cardinality estimate is sharp for the class of
all circle-valued multiplier phases. -/
theorem norm_twistedKloostermanSum_cancellingMultiplierPhase
    {c : ℕ} [NeZero c] (m n : ℤ) :
    ‖twistedKloostermanSum (cancellingMultiplierPhase (c := c) m n) m n‖ =
      (Fintype.card (UnitResidue c) : ℝ) := by
  rw [twistedKloostermanSum_cancellingMultiplierPhase]
  simp

end ConcreteTwistedKloosterman

/-! ## Corrected lemma layer: Lemmas 3.5--3.8 -/

namespace MassUnfolding

/-- A measurable increasing exhaustion.  The union law is the exact hypothesis
needed to recover a global Bochner integral from finite truncations. -/
structure MeasurableExhaustion (X : Type*) [MeasurableSpace X] where
  set : ℕ → Set X
  measurable_set : ∀ n, MeasurableSet (set n)
  monotone_set : Monotone set
  covers : ⋃ n, set n = (Set.univ : Set X)

theorem MeasurableExhaustion.tendsto_setIntegral
    {X E : Type*} [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A : MeasurableExhaustion X) {μ : Measure X} {f : X → E}
    (hf : Integrable f μ) :
    Tendsto (fun n => ∫ x in A.set n, f x ∂μ) atTop
      (𝓝 (∫ x, f x ∂μ)) := by
  have hfi : IntegrableOn f (⋃ n, A.set n) μ := by
    rw [A.covers]
    simpa using hf
  simpa [A.covers] using
    (tendsto_setIntegral_of_monotone
      A.measurable_set A.monotone_set hfi)

/-- A genuinely truncated exhaustion: every stage has finite measure and leaves
a complement of positive measure.  These fields rule out using the final
integral itself, even up to a null set, as a constant "truncation". -/
structure ProperMeasurableExhaustion
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    extends MeasurableExhaustion X where
  finite_measure : ∀ n, μ (set n) ≠ (⊤ : ENNReal)
  proper_set : ∀ n, set n ≠ (Set.univ : Set X)
  positive_complement : ∀ n, 0 < μ ((set n)ᶜ)

/-- Spectral mass cut off by one measurable exhaustion at each cusp. -/
noncomputable def truncatedContinuousMassAtCusp
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m n : ℕ) : ℝ :=
  ∫ t in (A κ).set n,
    D.test t * Complex.normSq (D.coefficient κ m t)
    ∂D.spectralMeasure κ

noncomputable def truncatedMassFunctional
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m n : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp, truncatedContinuousMassAtCusp D A κ m n

theorem truncatedContinuousMassAtCusp_nonneg
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m n : ℕ) :
    0 ≤ truncatedContinuousMassAtCusp D A κ m n := by
  apply integral_nonneg
  intro t
  exact mul_nonneg (D.test_nonneg t)
    (Complex.normSq_nonneg (D.coefficient κ m t))

theorem truncatedMassFunctional_nonneg
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m n : ℕ) :
    0 ≤ truncatedMassFunctional D A m n := by
  unfold truncatedMassFunctional
  exact Finset.sum_nonneg fun κ _ =>
    truncatedContinuousMassAtCusp_nonneg D A κ m n

/-- Positive spectral truncations increase along an increasing exhaustion. -/
theorem monotone_truncatedContinuousMassAtCusp
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m : ℕ) :
    Monotone (fun n => truncatedContinuousMassAtCusp D A κ m n) := by
  intro i j hij
  unfold truncatedContinuousMassAtCusp
  apply setIntegral_mono_set (D.integrable κ m).integrableOn
  · exact Eventually.of_forall fun t =>
      mul_nonneg (D.test_nonneg t)
        (Complex.normSq_nonneg (D.coefficient κ m t))
  · exact Eventually.of_forall fun _ ht =>
      (A κ).monotone_set hij ht

/-- Finite cusp sums of the positive truncations are increasing as well. -/
theorem monotone_truncatedMassFunctional
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m : ℕ) :
    Monotone (fun n => truncatedMassFunctional D A m n) := by
  intro i j hij
  unfold truncatedMassFunctional
  exact Finset.sum_le_sum fun κ _ =>
    monotone_truncatedContinuousMassAtCusp D A κ m hij

/-- Each one-cusp truncation is bounded by the corresponding full positive
Plancherel mass. -/
theorem truncatedContinuousMassAtCusp_le
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m n : ℕ) :
    truncatedContinuousMassAtCusp D A κ m n ≤
      continuousMassAtCusp D κ m := by
  have hnonneg :
      0 ≤ᵐ[D.spectralMeasure κ]
        (fun t => D.test t *
          Complex.normSq (D.coefficient κ m t)) :=
    Eventually.of_forall fun t =>
      mul_nonneg (D.test_nonneg t)
        (Complex.normSq_nonneg (D.coefficient κ m t))
  simpa [truncatedContinuousMassAtCusp, continuousMassAtCusp] using
    (setIntegral_le_integral (s := (A κ).set n)
      (D.integrable κ m) hnonneg)

/-- Every finite spectral truncation lies between zero and the global mass. -/
theorem truncatedMassFunctional_le
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m n : ℕ) :
    truncatedMassFunctional D A m n ≤ massFunctional D m := by
  unfold truncatedMassFunctional massFunctional
  exact Finset.sum_le_sum fun κ _ =>
    truncatedContinuousMassAtCusp_le D A κ m n

theorem tendsto_truncatedContinuousMassAtCusp
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m : ℕ) :
    Tendsto (fun n => truncatedContinuousMassAtCusp D A κ m n)
      atTop (𝓝 (continuousMassAtCusp D κ m)) := by
  simpa [truncatedContinuousMassAtCusp, continuousMassAtCusp] using
    (A κ).tendsto_setIntegral (D.integrable κ m)

theorem tendsto_truncatedMassFunctional
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m : ℕ) :
    Tendsto (fun n => truncatedMassFunctional D A m n)
      atTop (𝓝 (massFunctional D m)) := by
  unfold truncatedMassFunctional massFunctional
  apply tendsto_finset_sum
  intro κ _
  exact tendsto_truncatedContinuousMassAtCusp D A κ m

/-- Reusable uniqueness bridge implementing the order
`finite truncation → exhaustion limit → global mass`. -/
theorem eq_mass_of_tendsto_and_eventually_eq_truncated
    {D : ContinuousSpectralData}
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m : ℕ) {f : ℕ → ℝ} {L : ℝ}
    (hf : Tendsto f atTop (𝓝 L))
    (hstage : ∀ᶠ n in atTop,
      f n = truncatedMassFunctional D A m n) :
    L = massFunctional D m :=
  tendsto_nhds_unique (hf.congr' hstage)
    (tendsto_truncatedMassFunctional D A m)

/-- The denominator appearing in the paper's displayed Rankin--Selberg
resolvent density. -/
def rankinSelbergResolventDenominator (s : ℂ) (t : ℝ) : ℂ :=
  s * (1 - s) + (t : ℂ) ^ 2

/-- The imaginary part of the displayed resolvent denominator is independent
of the real spectral variable.  This elementary identity makes pole avoidance
constructive instead of leaving its parameter range potentially empty. -/
theorem rankinSelbergResolventDenominator_im (s : ℂ) (t : ℝ) :
    (rankinSelbergResolventDenominator s t).im =
      s.im * (1 - 2 * s.re) := by
  simp [rankinSelbergResolventDenominator, pow_two] <;> ring

/-- Every nonreal parameter in the half-plane `Re(s) > 1` avoids every real
spectral pole of `s(1-s)+t²`. -/
theorem rankinSelbergResolventDenominator_ne_zero_of_re_gt_one_of_im_ne_zero
    {s : ℂ} (hs_re : 1 < s.re) (hs_im : s.im ≠ 0) (t : ℝ) :
    rankinSelbergResolventDenominator s t ≠ 0 := by
  have hlinear : 1 - 2 * s.re ≠ 0 := by
    intro h
    linarith
  intro hden
  have hproduct : s.im * (1 - 2 * s.re) = 0 := by
    rw [← rankinSelbergResolventDenominator_im s t]
    simpa only [Complex.zero_im] using congrArg Complex.im hden
  exact (mul_ne_zero hs_im hlinear) hproduct

/-- The nonreal hypothesis is essential: every real `σ > 1` has the explicit
real spectral pole `t = √(σ(σ-1))`. -/
theorem rankinSelbergResolventDenominator_eq_zero_at_real_pole
    (σ : ℝ) (hσ : 1 < σ) :
    rankinSelbergResolventDenominator (σ : ℂ)
      (Real.sqrt (σ * (σ - 1))) = 0 := by
  have hσ_nonneg : 0 ≤ σ := by linarith
  have hσ_sub_one_nonneg : 0 ≤ σ - 1 := by linarith
  have hrad : 0 ≤ σ * (σ - 1) :=
    mul_nonneg hσ_nonneg hσ_sub_one_nonneg
  apply Complex.ext <;>
    simp [rankinSelbergResolventDenominator, pow_two,
      Real.mul_self_sqrt hrad] <;>
    ring

theorem rankinSelbergRealParameter_has_pole
    (σ : ℝ) (hσ : 1 < σ) :
    ∃ t : ℝ, rankinSelbergResolventDenominator (σ : ℂ) t = 0 :=
  ⟨Real.sqrt (σ * (σ - 1)),
    rankinSelbergResolventDenominator_eq_zero_at_real_pole σ hσ⟩

/-- The PDF's bare half-plane condition `Re(s)>1` does not make every
resolvent denominator pole-free: the real parameter `s=2` is a counterexample. -/
theorem not_all_re_gt_one_resolvents_poleFree :
    ¬ ∀ s : ℂ, 1 < s.re → ∀ t : ℝ,
      rankinSelbergResolventDenominator s t ≠ 0 := by
  intro h
  exact (h (2 : ℂ) (by norm_num) _)
    (rankinSelbergResolventDenominator_eq_zero_at_real_pole
      2 (by norm_num))

/-- A proof-carrying admissible parameter for the unregularized displayed
Rankin--Selberg resolvent. -/
structure RankinSelbergPoleFreeParameter where
  parameter : ℂ
  parameter_re_gt_one : 1 < parameter.re
  denominator_ne_zero : ∀ t : ℝ,
    rankinSelbergResolventDenominator parameter t ≠ 0

/-- In the half-plane `Re(s) > 1`, a pole-free parameter is necessarily
nonreal. -/
theorem RankinSelbergPoleFreeParameter.parameter_im_ne_zero
    (P : RankinSelbergPoleFreeParameter) : P.parameter.im ≠ 0 := by
  intro him
  have hs : P.parameter = (P.parameter.re : ℂ) := by
    apply Complex.ext <;> simp [him]
  have hpole :=
    rankinSelbergResolventDenominator_eq_zero_at_real_pole
      P.parameter.re P.parameter_re_gt_one
  rw [← hs] at hpole
  exact P.denominator_ne_zero _ hpole

/-- Package any nonreal point of the right half-plane as a pole-free
resolvent parameter. -/
def RankinSelbergPoleFreeParameter.ofNonreal
    (s : ℂ) (hs_re : 1 < s.re) (hs_im : s.im ≠ 0) :
    RankinSelbergPoleFreeParameter where
  parameter := s
  parameter_re_gt_one := hs_re
  denominator_ne_zero := fun t =>
    rankinSelbergResolventDenominator_ne_zero_of_re_gt_one_of_im_ne_zero
      hs_re hs_im t

/-- The explicit vertical-line parameter `σ + iη`, represented by its real
and imaginary coordinates. -/
def rankinSelbergVerticalParameter (σ η : ℝ) : ℂ :=
  Complex.mk σ η

@[simp]
theorem rankinSelbergVerticalParameter_re (σ η : ℝ) :
    (rankinSelbergVerticalParameter σ η).re = σ := rfl

@[simp]
theorem rankinSelbergVerticalParameter_im (σ η : ℝ) :
    (rankinSelbergVerticalParameter σ η).im = η := rfl

theorem rankinSelbergVerticalParameter_eq_add_mul_I (σ η : ℝ) :
    rankinSelbergVerticalParameter σ η =
      (σ : ℂ) + (η : ℂ) * Complex.I := by
  simpa only [rankinSelbergVerticalParameter] using
    Complex.mk_eq_add_mul_I σ η

/-- Every vertical parameter with `σ > 1` and `η ≠ 0` is pole-free. -/
def rankinSelbergVerticalPoleFreeParameter
    (σ η : ℝ) (hσ : 1 < σ) (hη : η ≠ 0) :
    RankinSelbergPoleFreeParameter :=
  RankinSelbergPoleFreeParameter.ofNonreal
    (rankinSelbergVerticalParameter σ η)
    (by simpa using hσ) (by simpa using hη)

/-- The concrete admissible witness `s = 2 + i`. -/
def rankinSelbergConcretePoleFreeParameter :
    RankinSelbergPoleFreeParameter :=
  rankinSelbergVerticalPoleFreeParameter 2 1 (by norm_num) (by norm_num)

theorem rankinSelbergPoleFreeParameter_nonempty :
    Nonempty RankinSelbergPoleFreeParameter :=
  ⟨rankinSelbergConcretePoleFreeParameter⟩

/-- The precise nonlinear norm-square factor
`|F(t) / (s(1-s)+t^2)|^2` from the displayed spectral formula.  The external
`1/(4π)` normalization and scattering measure are deliberately not folded into
this pointwise function. -/
def rankinSelbergResolventDensity
    (F : ℝ → ℂ) (s : ℂ) (t : ℝ) : ℝ :=
  Complex.normSq (F t / rankinSelbergResolventDenominator s t)

/-- Nonnegativity of the totalized Lean expression.  The actual unregularized
spectral-formula certificate below separately requires a nonzero denominator
at every real spectral parameter. -/
theorem rankinSelbergResolventDensity_nonneg
    (F : ℝ → ℂ) (s : ℂ) (t : ℝ) :
    0 ≤ rankinSelbergResolventDensity F s t :=
  Complex.normSq_nonneg _

/-- A family keeps the paper's analytic object `R_m`, auxiliary weight `F_m`, and
the subsequently extracted real mass distinct.  Because the mass-test and
geometric extractions can be nonlinear, the PDF's unspecified maps are
represented by ordinary functions rather than falsely being declared
real-linear.  The actual resolvent density is modeled separately below, so it
is not silently identified with the coefficient-weighted mass test. -/
structure RankinSelbergMassFamily
    (X : Type*) [MeasurableSpace X] where
  measure : Measure X
  /-- The paper's geometric Rankin--Selberg object `R_m(s)`. -/
  rankinSelbergIntegrand : ℕ → ℂ → X → ℂ
  /-- The auxiliary spectral weight `F_m(t)`, kept distinct from `R_m`. -/
  auxiliaryWeight : ℕ → ℝ → ℂ
  /-- The unspecified operation by which the induced real mass weight is
  extracted from `F_m`; the PDF does not justify replacing this by `re F_m` or
  by evaluation at a chosen parameter. -/
  massTestExtraction : (ℝ → ℂ) → (ℝ → ℝ)
  /-- The paper only names an induced real mass extraction from the full
  `s ↦ R_m(s)` integrand and does not identify it with evaluation at a chosen
  parameter.  We therefore keep that extraction as an explicit nonlinear
  operation on the entire spectral-parameter family. -/
  massExtraction : (ℂ → X → ℂ) → (X → ℝ)
  /-- Cusp Fourier coefficients in the chosen Eisenstein normalization. -/
  cuspCoefficient : Gamma2Cusp → ℕ → ℝ → ℂ
  rawScatteringMeasure : Gamma2Cusp → Measure ℝ
  scatteringNormalization : NNReal
  scatteringNormalization_pos : 0 < scatteringNormalization
  /-- The normalized positive scattering/Plancherel measure at each cusp. -/
  scatteringMeasure : Gamma2Cusp → Measure ℝ
  scatteringMeasure_eq : ∀ κ,
    scatteringMeasure κ =
      scatteringNormalization • rawScatteringMeasure κ
  extractedMassIntegrand : ℕ → X → ℝ
  extractedMassIntegrand_eq : ∀ m,
    extractedMassIntegrand m =
      massExtraction (rankinSelbergIntegrand m)
  extractedMassIntegrable : ∀ m,
    Integrable (extractedMassIntegrand m) measure

def RankinSelbergMassFamily.Domain
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X) : Type :=
  {p : ℕ × ℂ |
    Integrable (R.rankinSelbergIntegrand p.1 p.2) R.measure}

noncomputable def RankinSelbergMassFamily.rankinSelbergObject
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X) (p : R.Domain) : ℂ :=
  ∫ x, R.rankinSelbergIntegrand p.1.1 p.1.2 x ∂R.measure

/-- The right-hand side of the paper's displayed formula (3.2), before any
identification with the distinct mass functional (3.3).  There is no additional
Fourier-coefficient square in this definition. -/
noncomputable def rankinSelbergResolventSpectralSide
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (traceDerivativeMeasure : Measure ℝ)
    (s : ℂ) (m : ℕ) : ℝ :=
  (1 / (4 * Real.pi)) *
    ∫ t, rankinSelbergResolventDensity (R.auxiliaryWeight m) s t
      ∂traceDerivativeMeasure

/-- Proof data for the actual displayed Rankin--Selberg identity (3.2).

The measure is positive by its type.  Its identification with the sum of the
raw cusp scattering measures, the exact `1/(4π)` normalization, the
half-plane parameter range, pole avoidance, both integrability statements, and
the global identity are all explicit. -/
structure RankinSelbergSpectralFormulaAtParameter
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X) where
  parameter : ℂ
  parameter_re_gt_one : 1 < parameter.re
  denominator_ne_zero : ∀ t : ℝ,
    rankinSelbergResolventDenominator parameter t ≠ 0
  traceDerivativeMeasure : Measure ℝ
  traceDerivativeMeasure_eq :
    traceDerivativeMeasure =
      ∑ κ : Gamma2Cusp, R.rawScatteringMeasure κ
  scatteringNormalization_eq :
    (R.scatteringNormalization : ℝ) = 1 / (4 * Real.pi)
  geometric_integrable : ∀ m, 1 ≤ m →
    Integrable (R.rankinSelbergIntegrand m parameter) R.measure
  spectral_integrable : ∀ m, 1 ≤ m →
    Integrable
      (fun t =>
        rankinSelbergResolventDensity (R.auxiliaryWeight m) parameter t)
      traceDerivativeMeasure
  formula : ∀ m (hm : 1 ≤ m),
    R.rankinSelbergObject
        ⟨(m, parameter), geometric_integrable m hm⟩ =
      (rankinSelbergResolventSpectralSide R
        traceDerivativeMeasure parameter m : ℂ)

/-- Forgetting the formula-specific analytic data retains its certified
pole-free parameter. -/
def RankinSelbergSpectralFormulaAtParameter.poleFreeParameter
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    (C : RankinSelbergSpectralFormulaAtParameter R) :
    RankinSelbergPoleFreeParameter where
  parameter := C.parameter
  parameter_re_gt_one := C.parameter_re_gt_one
  denominator_ne_zero := C.denominator_ne_zero

/-- The displayed formula (3.2) at the certified admissible parameter. -/
theorem RankinSelbergSpectralFormulaAtParameter.rankinSelbergObject_eq
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    (C : RankinSelbergSpectralFormulaAtParameter R)
    (m : ℕ) (hm : 1 ≤ m) :
    R.rankinSelbergObject
        ⟨(m, C.parameter), C.geometric_integrable m hm⟩ =
      (rankinSelbergResolventSpectralSide R
        C.traceDerivativeMeasure C.parameter m : ℂ) :=
  C.formula m hm

theorem RankinSelbergSpectralFormulaAtParameter.spectralSide_nonneg
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    (C : RankinSelbergSpectralFormulaAtParameter R) (m : ℕ) :
    0 ≤ rankinSelbergResolventSpectralSide R
      C.traceDerivativeMeasure C.parameter m := by
  unfold rankinSelbergResolventSpectralSide
  apply mul_nonneg
  · positivity
  · apply integral_nonneg
    intro t
    exact rankinSelbergResolventDensity_nonneg
      (R.auxiliaryWeight m) C.parameter t

noncomputable def RankinSelbergMassFamily.extractedMass
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X) (m : ℕ) : ℝ :=
  ∫ x, R.extractedMassIntegrand m x ∂R.measure

/-- The passage from the full `(s ↦ R_m(s))` family to the distinct
coefficient-weighted mass (3.3) is an extraction identity, not equality of one
chosen value `R_m(s)` with that mass. -/
structure RankinSelbergToMassCertificate
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData) where
  extracted_mass_eq : ∀ m, 1 ≤ m →
    R.extractedMass m = massFunctional D m

theorem RankinSelbergToMassCertificate.extractedMass_nonnegative
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (M : RankinSelbergToMassCertificate R D) (m : ℕ) (hm : 1 ≤ m) :
    0 ≤ R.extractedMass m := by
  rw [M.extracted_mass_eq m hm]
  exact massFunctional_nonneg D m

/-- A positive mass fixes the test normalization uniquely.  Thus formula
(3.2) cannot determine formula (3.3) without a genuine normalization and
extraction identification. -/
theorem mass_identification_normalization_unique
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData} {m : ℕ} {c : ℝ}
    (hc : 0 ≤ c) (hpos : 0 < massFunctional D m)
    (h₁ : R.extractedMass m = massFunctional D m)
    (h₂ : R.extractedMass m =
      massFunctional (D.scaleTest c hc) m) :
    c = 1 := by
  rw [massFunctional_scaleTest] at h₂
  have h := h₁.symm.trans h₂
  nlinarith

/-- Negative extracted mass is an unconditional obstruction to the claimed
positive mass-identification certificate. -/
theorem not_nonempty_toMassCertificate_of_negative
    {X : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData} {m : ℕ}
    (hm : 1 ≤ m) (hneg : R.extractedMass m < 0) :
    ¬ Nonempty (RankinSelbergToMassCertificate R D) := by
  rintro ⟨C⟩
  exact (not_lt_of_ge (C.extractedMass_nonnegative m hm)) hneg

/-- A separate finite mass-test expression, before identification with
`ContinuousSpectralData`.  This is not formula (3.2): it deliberately contains
the coefficient square of (3.3) and uses the raw scattering measure together
with its positive normalization. -/
noncomputable def rankinSelbergTruncatedMassAtCusp
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (κ : Gamma2Cusp) (m n : ℕ) : ℝ :=
  ∫ t in (A κ).set n,
    R.massTestExtraction (R.auxiliaryWeight m) t *
      Complex.normSq (R.cuspCoefficient κ m t)
    ∂(R.scatteringNormalization • R.rawScatteringMeasure κ)

noncomputable def rankinSelbergTruncatedMass
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m n : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp,
    rankinSelbergTruncatedMassAtCusp R D A κ m n

/-- Mass-test, coefficient, and scattering identifications transport the
separate truncated expression to the common positive mass. -/
theorem rankinSelbergTruncatedMass_eq
    {X : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData)
    (A : Gamma2Cusp → MeasurableExhaustion ℝ)
    (m n : ℕ)
    (hF : ∀ m t,
      R.massTestExtraction (R.auxiliaryWeight m) t =
        D.test t)
    (hρ : ∀ κ m t,
      R.cuspCoefficient κ m t = D.coefficient κ m t)
    (hμ : ∀ κ,
      R.scatteringMeasure κ = D.spectralMeasure κ) :
    rankinSelbergTruncatedMass R D A m n =
      truncatedMassFunctional D A m n := by
  unfold rankinSelbergTruncatedMass truncatedMassFunctional
  apply Finset.sum_congr rfl
  intro κ hκ
  unfold rankinSelbergTruncatedMassAtCusp
    truncatedContinuousMassAtCusp
  rw [← R.scatteringMeasure_eq κ, hμ κ]
  apply integral_congr_ae
  exact Eventually.of_forall fun t => by
    simpa only using congrArg
      (fun a => a * Complex.normSq (R.cuspCoefficient κ m t)) (hF m t) |>.trans
        (congrArg
          (fun a => D.test t * Complex.normSq a) (hρ κ m t))

/-- Proof data for a finite-stage Rankin--Selberg unfolding.  The geometric
integrand is first decomposed into an actual finite sum of integrable terms;
the finite sum/integral interchange is then proved by Mathlib, and only the
last identification with the truncated spectral expression remains model
specific.  Proper finite-measure stages prevent a constant-`univ` shortcut. -/
structure FiniteTruncatedUnfolding
    {X ι : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData) where
  geometric : ProperMeasurableExhaustion R.measure
  spectral : ∀ κ,
    ProperMeasurableExhaustion (D.spectralMeasure κ)
  auxiliaryWeight_identification : ∀ m t,
    R.massTestExtraction (R.auxiliaryWeight m) t =
      D.test t
  coefficient_identification : ∀ κ m t,
    R.cuspCoefficient κ m t = D.coefficient κ m t
  scattering_identification : ∀ κ,
    R.scatteringMeasure κ = D.spectralMeasure κ
  index : ℕ → Finset ι
  unfoldedTerm : ℕ → ℕ → ι → X → ℝ
  unfoldedTerm_integrable : ∀ n m i, i ∈ index n →
    IntegrableOn (unfoldedTerm n m i) (geometric.set n) R.measure
  pointwise_decomposition : ∀ n m,
    (fun x =>
      R.massExtraction (R.rankinSelbergIntegrand m) x) =ᵐ[
      R.measure.restrict (geometric.set n)]
      fun x => ∑ i ∈ index n, unfoldedTerm n m i x
  spectral_identification : ∀ n m,
    (∑ i ∈ index n,
      ∫ x in geometric.set n, unfoldedTerm n m i x ∂R.measure) =
      rankinSelbergTruncatedMass R D
        (fun κ => (spectral κ).toMeasurableExhaustion) m n

/-- The finite truncation identity is derived from the pointwise unfolding,
finite-sum Fubini step, and spectral identification leaves. -/
theorem FiniteTruncatedUnfolding.finiteIdentity
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : FiniteTruncatedUnfolding (ι := ι) R D) (n m : ℕ) :
    (∫ x in C.geometric.set n,
      R.extractedMassIntegrand m x ∂R.measure) =
      truncatedMassFunctional D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n := by
  calc
    (∫ x in C.geometric.set n,
        R.extractedMassIntegrand m x ∂R.measure) =
        ∫ x in C.geometric.set n,
          R.massExtraction (R.rankinSelbergIntegrand m) x
          ∂R.measure := by
      rw [R.extractedMassIntegrand_eq m]
    _ =
        ∫ x in C.geometric.set n,
          ∑ i ∈ C.index n, C.unfoldedTerm n m i x ∂R.measure :=
      integral_congr_ae (C.pointwise_decomposition n m)
    _ = ∑ i ∈ C.index n,
        ∫ x in C.geometric.set n,
          C.unfoldedTerm n m i x ∂R.measure :=
      integral_finset_sum (C.index n) (C.unfoldedTerm_integrable n m)
    _ = rankinSelbergTruncatedMass R D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n :=
      C.spectral_identification n m
    _ = truncatedMassFunctional D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n :=
      rankinSelbergTruncatedMass_eq R D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n
        C.auxiliaryWeight_identification
        C.coefficient_identification C.scattering_identification

/-- The geometric side of every certified finite unfolding stage is
nonnegative because it is identified with a finite positive spectral mass. -/
theorem FiniteTruncatedUnfolding.geometricStage_nonnegative
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : FiniteTruncatedUnfolding (ι := ι) R D) (n m : ℕ) :
    0 ≤ ∫ x in C.geometric.set n,
      R.extractedMassIntegrand m x ∂R.measure := by
  rw [C.finiteIdentity n m]
  exact truncatedMassFunctional_nonneg D
    (fun κ => (C.spectral κ).toMeasurableExhaustion) m n

/-- A product-kernel finite unfolding, exposing the actual Fubini step between
geometric and spectral integration.  The two identification fields are the
paper-specific geometric expansion and spectral coefficient collapse; Fubini
itself is proved below. -/
structure ProductFiniteTruncatedUnfolding
    {X ι : Type*} [MeasurableSpace X]
    (R : RankinSelbergMassFamily X)
    (D : ContinuousSpectralData) where
  geometric : ProperMeasurableExhaustion R.measure
  spectral : ∀ κ,
    ProperMeasurableExhaustion (D.spectralMeasure κ)
  geometric_sFinite : SFinite R.measure
  spectral_sFinite : ∀ κ, SFinite (D.spectralMeasure κ)
  auxiliaryWeight_identification : ∀ m t,
    R.massTestExtraction (R.auxiliaryWeight m) t =
      D.test t
  coefficient_identification : ∀ κ m t,
    R.cuspCoefficient κ m t = D.coefficient κ m t
  scattering_identification : ∀ κ,
    R.scatteringMeasure κ = D.spectralMeasure κ
  index : ℕ → Finset ι
  kernel : ℕ → ℕ → Gamma2Cusp → ι → X → ℝ → ℝ
  kernel_integrable : ∀ n m κ i, i ∈ index n →
    Integrable (Function.uncurry (kernel n m κ i))
      (R.measure.prod (D.spectralMeasure κ))
  geometric_identification : ∀ n m,
    (∫ x in geometric.set n,
      R.massExtraction (R.rankinSelbergIntegrand m) x ∂R.measure) =
      ∑ κ : Gamma2Cusp,
        ∑ i ∈ index n,
          ∫ x, ∫ t, kernel n m κ i x t
            ∂D.spectralMeasure κ ∂R.measure
  spectral_identification : ∀ n m,
    (∑ κ : Gamma2Cusp,
      ∑ i ∈ index n,
        ∫ t, ∫ x, kernel n m κ i x t
          ∂R.measure ∂D.spectralMeasure κ) =
      rankinSelbergTruncatedMass R D
        (fun κ => (spectral κ).toMeasurableExhaustion) m n

/-- The product-kernel finite identity is the composition
`finite truncation → Fubini → spectral collapse`. -/
theorem ProductFiniteTruncatedUnfolding.finiteIdentity
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : ProductFiniteTruncatedUnfolding (ι := ι) R D)
    (n m : ℕ) :
    (∫ x in C.geometric.set n,
      R.extractedMassIntegrand m x ∂R.measure) =
      truncatedMassFunctional D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n := by
  letI : SFinite R.measure := C.geometric_sFinite
  calc
    (∫ x in C.geometric.set n,
        R.extractedMassIntegrand m x ∂R.measure) =
        ∫ x in C.geometric.set n,
          R.massExtraction (R.rankinSelbergIntegrand m) x
          ∂R.measure := by
      rw [R.extractedMassIntegrand_eq m]
    _ =
        ∑ κ : Gamma2Cusp,
          ∑ i ∈ C.index n,
            ∫ x, ∫ t, C.kernel n m κ i x t
              ∂D.spectralMeasure κ ∂R.measure :=
      C.geometric_identification n m
    _ = ∑ κ : Gamma2Cusp,
        ∑ i ∈ C.index n,
          ∫ t, ∫ x, C.kernel n m κ i x t
            ∂R.measure ∂D.spectralMeasure κ := by
      apply Finset.sum_congr rfl
      intro κ _
      letI : SFinite (D.spectralMeasure κ) := C.spectral_sFinite κ
      apply Finset.sum_congr rfl
      intro i hi
      exact integral_integral_swap (C.kernel_integrable n m κ i hi)
    _ = rankinSelbergTruncatedMass R D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n :=
      C.spectral_identification n m
    _ = truncatedMassFunctional D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n :=
      rankinSelbergTruncatedMass_eq R D
        (fun κ => (C.spectral κ).toMeasurableExhaustion) m n
        C.auxiliaryWeight_identification
        C.coefficient_identification C.scattering_identification

/-- Product-kernel/Fubini finite stages inherit the same nonnegativity. -/
theorem ProductFiniteTruncatedUnfolding.geometricStage_nonnegative
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : ProductFiniteTruncatedUnfolding (ι := ι) R D)
    (n m : ℕ) :
    0 ≤ ∫ x in C.geometric.set n,
      R.extractedMassIntegrand m x ∂R.measure := by
  rw [C.finiteIdentity n m]
  exact truncatedMassFunctional_nonneg D
    (fun κ => (C.spectral κ).toMeasurableExhaustion) m n

/-- **Corrected Lemma 3.5 (generic limit bridge).** A concrete family of proper
finite unfolding identities determines the extracted global mass.  Constructing
this certificate from the paper's kernels remains a separate analytic task. -/
theorem unfolding_to_mass
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : FiniteTruncatedUnfolding (ι := ι) R D) (m : ℕ) :
    R.extractedMass m = massFunctional D m := by
  let spectralExhaustion : Gamma2Cusp → MeasurableExhaustion ℝ :=
    fun κ => (C.spectral κ).toMeasurableExhaustion
  have hgeometric :
      Tendsto
        (fun n => ∫ x in C.geometric.set n,
          R.extractedMassIntegrand m x ∂R.measure)
        atTop (𝓝 (R.extractedMass m)) := by
    simpa [RankinSelbergMassFamily.extractedMass] using
      C.geometric.toMeasurableExhaustion.tendsto_setIntegral
        (R.extractedMassIntegrable m)
  have hspectral :
      Tendsto
        (fun n => truncatedMassFunctional D spectralExhaustion m n)
        atTop (𝓝 (massFunctional D m)) :=
    tendsto_truncatedMassFunctional D spectralExhaustion m
  have hgeometric' :
      Tendsto
        (fun n => truncatedMassFunctional D spectralExhaustion m n)
        atTop (𝓝 (R.extractedMass m)) :=
    hgeometric.congr' <| Eventually.of_forall fun n => by
      simpa [spectralExhaustion] using C.finiteIdentity n m
  exact tendsto_nhds_unique hgeometric' hspectral

/-- **Corrected Lemma 3.5, explicit Fubini route.** Product-kernel finite
identities derived by `ProductFiniteTruncatedUnfolding.finiteIdentity` pass to
the global positive spectral mass along the two proper exhaustions. -/
theorem product_unfolding_to_mass
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : ProductFiniteTruncatedUnfolding (ι := ι) R D) (m : ℕ) :
    R.extractedMass m = massFunctional D m := by
  let spectralExhaustion : Gamma2Cusp → MeasurableExhaustion ℝ :=
    fun κ => (C.spectral κ).toMeasurableExhaustion
  have hgeometric :
      Tendsto
        (fun n => ∫ x in C.geometric.set n,
          R.extractedMassIntegrand m x ∂R.measure)
        atTop (𝓝 (R.extractedMass m)) := by
    simpa [RankinSelbergMassFamily.extractedMass] using
      C.geometric.toMeasurableExhaustion.tendsto_setIntegral
        (R.extractedMassIntegrable m)
  have hspectral :
      Tendsto
        (fun n => truncatedMassFunctional D spectralExhaustion m n)
        atTop (𝓝 (massFunctional D m)) :=
    tendsto_truncatedMassFunctional D spectralExhaustion m
  have hgeometric' :
      Tendsto
        (fun n => truncatedMassFunctional D spectralExhaustion m n)
        atTop (𝓝 (R.extractedMass m)) :=
    hgeometric.congr' <| Eventually.of_forall fun n => by
      simpa [spectralExhaustion] using C.finiteIdentity n m
  exact tendsto_nhds_unique hgeometric' hspectral

/-- **Corrected Lemma 3.7 (generic consequence).** An extracted mass with a
proper finite unfolding certificate is nonnegative. -/
theorem unfolded_mass_nonnegative
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : FiniteTruncatedUnfolding (ι := ι) R D) (m : ℕ) :
    0 ≤ R.extractedMass m := by
  rw [unfolding_to_mass C m]
  exact massFunctional_nonneg D m

theorem product_unfolded_mass_nonnegative
    {X ι : Type*} [MeasurableSpace X]
    {R : RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (C : ProductFiniteTruncatedUnfolding (ι := ι) R D) (m : ℕ) :
    0 ≤ R.extractedMass m := by
  rw [product_unfolding_to_mass C m]
  exact massFunctional_nonneg D m

end MassUnfolding

namespace Interchange

/-- Product integration is legitimate under absolute Bochner integrability. -/
theorem product_integral
    {X Y E : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {ν : Measure Y} [SFinite μ] [SFinite ν]
    (f : X × Y → E) (hf : Integrable f (μ.prod ν)) :
    (∫ z, f z ∂μ.prod ν) = ∫ x, ∫ y, f (x, y) ∂ν ∂μ :=
  integral_prod f hf

/-- The two iterated integrals may be interchanged under the same hypothesis. -/
theorem iterated_integral_swap
    {X Y E : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {ν : Measure Y} [SFinite μ] [SFinite ν]
    {f : X → Y → E} (hf : Integrable (Function.uncurry f) (μ.prod ν)) :
    (∫ x, ∫ y, f x y ∂ν ∂μ) = ∫ y, ∫ x, f x y ∂μ ∂ν :=
  integral_integral_swap hf

/-- A finite sum can be moved through a Bochner integral when every summand is
integrable. -/
theorem finite_sum_integral
    {ι X E : Type*} [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} (s : Finset ι) {f : ι → X → E}
    (hf : ∀ i ∈ s, Integrable (f i) μ) :
    (∫ x, ∑ i ∈ s, f i x ∂μ) = ∑ i ∈ s, ∫ x, f i x ∂μ :=
  integral_finset_sum s hf

/-- **Corrected Lemma 3.6.** Absolute summability of the integral norms is a
checkable Tonelli/Fubini certificate for exchanging an infinite sum and integral. -/
theorem sum_integral_interchange
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {f : ι → X → E}
    (hf : ∀ i, Integrable (f i) μ)
    (hsum : Summable fun i => ∫ x, ‖f i x‖ ∂μ) :
    (∑' i, ∫ x, f i x ∂μ) = ∫ x, ∑' i, f i x ∂μ :=
  integral_tsum_of_summable_integral_norm hf hsum

/-- A compact or one-point spectral variable cannot by itself control an
independent arithmetic index: the constant arithmetic comparison series still
diverges.  This is the unconditional obstruction to the PDF's compact-support
shortcut in Lemma 3.6. -/
theorem constant_arithmetic_series_not_summable :
    ¬ Summable (fun _ : ℕ => (1 : ℝ)) := by
  simpa [Real.rpow_zero] using
    (KloostermanTail.not_summable_paper_tail_one
      (ε := 1) (by norm_num))

/-- A single cusp/arithmetic majorant valid for every index `m`.  Its
integrated sum is summable independently of `m`, which is the missing uniform
input behind the compact-spectral-support sentence in the PDF. -/
structure UniformMajorant
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (μ : Measure X) (f : ℕ → ι → X → E) where
  majorant : ι → X → ℝ
  majorant_integrable : ∀ i, Integrable (majorant i) μ
  summable_integrals : Summable fun i => ∫ x, majorant i x ∂μ
  aestronglyMeasurable : ∀ m i, AEStronglyMeasurable (f m i) μ
  norm_le : ∀ m i, (fun x => ‖f m i x‖) ≤ᵐ[μ] majorant i

theorem UniformMajorant.integrable
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {f : ℕ → ι → X → E}
    (B : UniformMajorant μ f) (m : ℕ) (i : ι) :
    Integrable (f m i) μ :=
  Integrable.mono' (B.majorant_integrable i)
    (B.aestronglyMeasurable m i) (B.norm_le m i)

/-- Quantitative domination of each integral norm by the same
`m`-independent majorant term. -/
theorem UniformMajorant.integral_norm_le_majorant
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {f : ℕ → ι → X → E}
    (B : UniformMajorant μ f) (m : ℕ) (i : ι) :
    (∫ x, ‖f m i x‖ ∂μ) ≤ ∫ x, B.majorant i x ∂μ :=
  integral_mono_ae (B.integrable m i).norm
    (B.majorant_integrable i) (B.norm_le m i)

theorem UniformMajorant.summable_integral_norm
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {f : ℕ → ι → X → E}
    (B : UniformMajorant μ f) (m : ℕ) :
    Summable fun i => ∫ x, ‖f m i x‖ ∂μ := by
  apply B.summable_integrals.of_nonneg_of_le
  · intro i
    exact integral_nonneg fun x => norm_nonneg (f m i x)
  · intro i
    exact B.integral_norm_le_majorant m i

/-- **Corrected Lemma 3.6, uniform form.** The same explicit majorant proves
the sum/integral interchange for every arithmetic parameter `m`. -/
theorem UniformMajorant.sum_integral_interchange
    {ι X E : Type*} [Countable ι] [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {μ : Measure X} {f : ℕ → ι → X → E}
    (B : UniformMajorant μ f) (m : ℕ) :
    (∑' i, ∫ x, f m i x ∂μ) =
      ∫ x, ∑' i, f m i x ∂μ :=
  Interchange.sum_integral_interchange (B.integrable m)
    (B.summable_integral_norm m)

/-- A uniform majorant explicitly linked to the kernels occurring in a product
Rankin--Selberg unfolding.  The equality field prevents the infinite expansion
from living in an unrelated generic namespace. -/
structure LinkedProductKernelMajorant
    {ι X : Type*} [Countable ι] [MeasurableSpace X]
    {R : MassUnfolding.RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    (P : MassUnfolding.ProductFiniteTruncatedUnfolding (ι := ι) R D) where
  fullKernel : ℕ → ι → Gamma2Cusp → X → ℝ → ℝ
  /-- The finite arithmetic index sets form an actual exhaustion. -/
  index_mono : Monotone P.index
  index_covers : ∀ i, ∃ n, i ∈ P.index n
  finite_kernel_eq : ∀ n m κ i, i ∈ P.index n →
    P.kernel n m κ i = fullKernel m i κ
  majorant : ∀ κ,
    UniformMajorant
      (R.measure.prod (D.spectralMeasure κ))
      (fun m i => Function.uncurry (fullKernel m i κ))

/-- Every arithmetic index eventually occurs in every later finite stage. -/
theorem LinkedProductKernelMajorant.eventually_mem_index
    {ι X : Type*} [Countable ι] [MeasurableSpace X]
    {R : MassUnfolding.RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    {P : MassUnfolding.ProductFiniteTruncatedUnfolding (ι := ι) R D}
    (B : LinkedProductKernelMajorant P) (i : ι) :
    ∀ᶠ n in atTop, i ∈ P.index n := by
  obtain ⟨N, hiN⟩ := B.index_covers i
  filter_upwards [eventually_ge_atTop N] with n hn
  exact B.index_mono hn hiN

/-- Consequently each fixed finite-stage kernel eventually agrees with the
same full kernel controlled by the uniform majorant. -/
theorem LinkedProductKernelMajorant.eventually_kernel_eq_fullKernel
    {ι X : Type*} [Countable ι] [MeasurableSpace X]
    {R : MassUnfolding.RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    {P : MassUnfolding.ProductFiniteTruncatedUnfolding (ι := ι) R D}
    (B : LinkedProductKernelMajorant P)
    (m : ℕ) (κ : Gamma2Cusp) (i : ι) :
    ∀ᶠ n in atTop,
      P.kernel n m κ i = B.fullKernel m i κ :=
  (B.eventually_mem_index i).mono fun n hin =>
    B.finite_kernel_eq n m κ i hin

/-- At each fixed cusp, the linked majorant performs the infinite arithmetic-
index sum--product-integral interchange for the same kernel family. -/
theorem LinkedProductKernelMajorant.sum_integral_interchange
    {ι X : Type*} [Countable ι] [MeasurableSpace X]
    {R : MassUnfolding.RankinSelbergMassFamily X}
    {D : ContinuousSpectralData}
    {P : MassUnfolding.ProductFiniteTruncatedUnfolding (ι := ι) R D}
    (B : LinkedProductKernelMajorant P) (κ : Gamma2Cusp) (m : ℕ) :
    (∑' i, ∫ z,
        Function.uncurry (B.fullKernel m i κ) z
        ∂(R.measure.prod (D.spectralMeasure κ))) =
      ∫ z, ∑' i,
        Function.uncurry (B.fullKernel m i κ) z
        ∂(R.measure.prod (D.spectralMeasure κ)) :=
  (B.majorant κ).sum_integral_interchange m

/-! #### A genuinely infinite nonzero model for corrected Lemma 3.6

This example is deliberately independent of the paper's unspecified
arithmetic kernel.  The arithmetic index is all of `Nat`, every term is
nonzero, and its geometric majorant is the same summable geometric sequence.
The Dirac measure reduces the integral calculation to evaluation while leaving
the infinite sum genuine. -/

namespace ConcreteGeometricMajorant

/-- A parameter-independent geometric kernel on a one-point measured support. -/
def kernel (_m i : ℕ) (_x : ℝ) : ℝ :=
  ((1 : ℝ) / 2) ^ i

theorem kernel_nonnegative (m i : ℕ) (x : ℝ) :
    0 ≤ kernel m i x := by
  exact pow_nonneg (by norm_num) i

/-- Every arithmetic term is genuinely nonzero. -/
theorem kernel_ne_zero (m i : ℕ) (x : ℝ) :
    kernel m i x ≠ 0 := by
  simp [kernel]

theorem kernel_integrable (m i : ℕ) :
    Integrable (kernel m i) (Measure.dirac (0 : ℝ)) := by
  apply integrable_dirac
  simp [kernel]
  exact pos_iff_ne_zero.mpr (pow_ne_zero i (by norm_num))

/-- The kernel itself is an `m`-independent summable majorant. -/
noncomputable def uniformMajorant :
    UniformMajorant (Measure.dirac (0 : ℝ)) kernel where
  majorant := fun i x => kernel 0 i x
  majorant_integrable := fun i => kernel_integrable 0 i
  summable_integrals := by
    simpa [kernel] using summable_geometric_two
  aestronglyMeasurable := fun m i =>
    (kernel_integrable m i).aestronglyMeasurable
  norm_le := by
    intro m i
    exact Eventually.of_forall fun x => by
      have hi : 0 ≤ ((1 : ℝ) / 2) ^ i :=
        pow_nonneg (by norm_num) i
      simp [kernel, Real.norm_eq_abs, abs_of_nonneg hi]

/-- Corrected Lemma 3.6 on a concrete nonzero infinite family. -/
theorem tsum_integral_eq_integral_tsum (m : ℕ) :
    (∑' i : ℕ,
        ∫ x : ℝ, kernel m i x ∂Measure.dirac (0 : ℝ)) =
      ∫ x : ℝ, ∑' i : ℕ, kernel m i x
        ∂Measure.dirac (0 : ℝ) :=
  uniformMajorant.sum_integral_interchange m

/-- The sum of the integrals is the nonzero value `2`. -/
theorem tsum_integral_eq_two (m : ℕ) :
    (∑' i : ℕ,
        ∫ x : ℝ, kernel m i x ∂Measure.dirac (0 : ℝ)) = 2 := by
  simpa [kernel] using tsum_geometric_two

/-- The integral of the pointwise infinite sum has the same value `2`. -/
theorem integral_tsum_eq_two (m : ℕ) :
    (∫ x : ℝ, ∑' i : ℕ, kernel m i x
      ∂Measure.dirac (0 : ℝ)) = 2 := by
  rw [← tsum_integral_eq_integral_tsum m]
  exact tsum_integral_eq_two m

end ConcreteGeometricMajorant

end Interchange

namespace UniformActivity

/-- Every eventual positive mass condition forces an actually active
positive-measure spectral set at some cusp for each sufficiently large index. -/
theorem MassConditionAt.eventual_spectralActivity
    {D : ContinuousSpectralData} {ε : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀) :
    ∀ m, m₀ ≤ m → ∃ κ,
      0 < D.spectralMeasure κ (spectralActivitySet D κ m) := by
  intro m hm
  obtain ⟨κ, hκ⟩ :=
    (massFunctional_pos_iff D m).1 (h.mass_pos hm)
  exact ⟨κ,
    (continuousMassAtCusp_pos_iff_activity D κ m).1 hκ⟩

/-- A mass family tending to zero cannot satisfy a fixed strictly positive
eventual `HMass` threshold. -/
theorem not_hMass_of_tendsto_mass_zero
    (D : ContinuousSpectralData)
    (h0 : Tendsto (massFunctional D) atTop (𝓝 0))
    (ε : ℝ) :
    ¬ HMass D ε := by
  rintro ⟨m₀, hε, _, hlower⟩
  have hlt : ∀ᶠ m in atTop, massFunctional D m < ε :=
    (tendsto_order.1 h0).2 ε hε
  have hex : ∃ m, massFunctional D m < ε ∧ m₀ ≤ m :=
    (hlt.and (eventually_ge_atTop m₀)).exists
  rcases hex with ⟨m, hm_lt, hm_ge⟩
  exact (not_lt_of_ge (hlower m hm_ge)) hm_lt

/-- On a boundary layer of width `δ`, the normalized average of the raw tent
is only `δ/2`.  Hence raw activity on the full support cannot be converted to a
uniform tent-weighted lower bound without an interior positive test floor. -/
theorem normalized_right_tail_profile_average
    {T δ : ℝ} (hδ : 0 < δ) (hδT : δ ≤ T) :
    δ⁻¹ * (∫ t in (T - δ)..T, TentKernel.profile T t) =
      δ / 2 := by
  rw [TentKernel.integral_profile_right_tail
    (sub_nonneg.mpr hδT) (sub_le_self T hδ.le)]
  rw [show T - (T - δ) = δ by ring]
  field_simp [hδ.ne'] <;> ring

/-- Proof-carrying uniform activity on fixed spectral windows.  In particular,
pointwise nonvanishing is not silently upgraded to a uniform positive bound. -/
structure Data (D : ContinuousSpectralData) where
  window : Gamma2Cusp → Set ℝ
  window_measurable : ∀ κ, MeasurableSet (window κ)
  testFloor : ℝ
  testFloor_pos : 0 < testFloor
  test_lower : ∀ κ t, t ∈ window κ → testFloor ≤ D.test t
  coefficient_integrableOn : ∀ κ m,
    IntegrableOn
      (fun t => Complex.normSq (D.coefficient κ m t))
      (window κ) (D.spectralMeasure κ)
  activityFloor : ℝ
  activityFloor_pos : 0 < activityFloor
  threshold : ℕ
  threshold_pos : 1 ≤ threshold
  lowerActivity : ∀ m, threshold ≤ m →
    activityFloor ≤
      ∑ κ : Gamma2Cusp,
        ∫ t in window κ,
          Complex.normSq (D.coefficient κ m t)
          ∂D.spectralMeasure κ

/-- Raw fixed-window activity measured with Lebesgue `dt`, together with the
precise measure comparison needed to transfer it to the positive spectral
measure.  This keeps the two measures distinct instead of silently rewriting
the PDF's display. -/
structure LebesgueData (D : ContinuousSpectralData) where
  window : Gamma2Cusp → Set ℝ
  window_measurable : ∀ κ, MeasurableSet (window κ)
  testFloor : ℝ
  testFloor_pos : 0 < testFloor
  test_lower : ∀ κ t, t ∈ window κ → testFloor ≤ D.test t
  coefficient_integrableOn : ∀ κ m,
    IntegrableOn
      (fun t => Complex.normSq (D.coefficient κ m t))
      (window κ) (D.spectralMeasure κ)
  densityFloor : NNReal
  densityFloor_pos : 0 < densityFloor
  spectral_dominates_dt : ∀ κ,
    densityFloor • volume.restrict (window κ) ≤
      (D.spectralMeasure κ).restrict (window κ)
  activityFloor : ℝ
  activityFloor_pos : 0 < activityFloor
  threshold : ℕ
  threshold_pos : 1 ≤ threshold
  lowerLebesgueActivity : ∀ m, threshold ≤ m →
    activityFloor ≤
      ∑ κ : Gamma2Cusp,
        ∫ t in window κ,
          Complex.normSq (D.coefficient κ m t)

noncomputable def rawActivityForWindow
    (D : ContinuousSpectralData)
    (window : Gamma2Cusp → Set ℝ) (m : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp,
    ∫ t in window κ,
      Complex.normSq (D.coefficient κ m t)

noncomputable def rawWindowActivity
    {D : ContinuousSpectralData} (A : LebesgueData D) (m : ℕ) : ℝ :=
  rawActivityForWindow D A.window m

/-- A local, checkable route to a genuine uniform-in-`m` activity theorem:
one fixed positive-measure set at one cusp carries a uniform coefficient
floor.  This is substantially stronger than pointwise nonvanishing but weaker
and more reusable than assuming the final summed lower bound. -/
structure ActiveSetData (D : ContinuousSpectralData) where
  window : Gamma2Cusp → Set ℝ
  activeCusp : Gamma2Cusp
  activeSet : Set ℝ
  activeSet_measurable : MeasurableSet activeSet
  activeSet_subset : activeSet ⊆ window activeCusp
  activeSet_finite : volume activeSet ≠ (⊤ : ENNReal)
  activeSet_positive : 0 < volume.real activeSet
  coefficientFloor : ℝ
  coefficientFloor_pos : 0 < coefficientFloor
  threshold : ℕ
  threshold_pos : 1 ≤ threshold
  coefficient_integrableOn : ∀ κ m,
    IntegrableOn
      (fun t => Complex.normSq (D.coefficient κ m t))
      (window κ)
  coefficient_lower : ∀ m, threshold ≤ m → ∀ t ∈ activeSet,
    coefficientFloor ≤ Complex.normSq (D.coefficient activeCusp m t)

/-- A fixed positive-measure coefficient floor proves the requested raw
Lebesgue-window activity bound uniformly for all `m ≥ threshold`. -/
theorem ActiveSetData.lower_rawActivity
    {D : ContinuousSpectralData} (A : ActiveSetData D)
    (m : ℕ) (hm : A.threshold ≤ m) :
    A.coefficientFloor * volume.real A.activeSet ≤
      rawActivityForWindow D A.window m := by
  let f : Gamma2Cusp → ℝ → ℝ := fun κ t =>
    Complex.normSq (D.coefficient κ m t)
  have hactive : IntegrableOn
      (f A.activeCusp) A.activeSet :=
    (A.coefficient_integrableOn A.activeCusp m).mono_set
      A.activeSet_subset
  have hlower :
      A.coefficientFloor * volume.real A.activeSet ≤
        ∫ t in A.activeSet, f A.activeCusp t := by
    exact setIntegral_ge_of_const_le_real
      (μ := (volume : Measure ℝ))
      A.activeSet_measurable A.activeSet_finite
      (fun t ht => A.coefficient_lower m hm t ht) hactive
  have hsubset :
      (∫ t in A.activeSet, f A.activeCusp t) ≤
        ∫ t in A.window A.activeCusp, f A.activeCusp t := by
    apply setIntegral_mono_set
      (A.coefficient_integrableOn A.activeCusp m)
    · exact Eventually.of_forall fun t =>
        Complex.normSq_nonneg (D.coefficient A.activeCusp m t)
    · exact Eventually.of_forall fun t ht =>
        A.activeSet_subset ht
  have hsingle :
      (∫ t in A.window A.activeCusp, f A.activeCusp t) ≤
        ∑ κ : Gamma2Cusp, ∫ t in A.window κ, f κ t := by
    exact Finset.single_le_sum
      (f := fun κ : Gamma2Cusp =>
        ∫ t in A.window κ, f κ t)
      (fun κ _ => integral_nonneg fun t =>
        Complex.normSq_nonneg (D.coefficient κ m t))
      (Finset.mem_univ A.activeCusp)
  calc
    A.coefficientFloor * volume.real A.activeSet ≤
        ∫ t in A.activeSet, f A.activeCusp t := hlower
    _ ≤ ∫ t in A.window A.activeCusp, f A.activeCusp t := hsubset
    _ ≤ ∑ κ : Gamma2Cusp, ∫ t in A.window κ, f κ t := hsingle
    _ = rawActivityForWindow D A.window m := by
      rfl

/-- The active-set certificate yields strict raw activity, uniformly after its
threshold; mere pointwise nonvanishing would not suffice for this conclusion. -/
theorem ActiveSetData.rawActivity_pos
    {D : ContinuousSpectralData} (A : ActiveSetData D)
    (m : ℕ) (hm : A.threshold ≤ m) :
    0 < rawActivityForWindow D A.window m :=
  lt_of_lt_of_le
    (mul_pos A.coefficientFloor_pos A.activeSet_positive)
    (A.lower_rawActivity m hm)

/-- Assemble the raw-`dt`/spectral comparison package from the checkable
active-set theorem.  Thus `lowerLebesgueActivity` need not be assumed when a
uniform coefficient floor is available. -/
def LebesgueData.ofActiveSet
    {D : ContinuousSpectralData} (B : ActiveSetData D)
    (window_measurable : ∀ κ, MeasurableSet (B.window κ))
    {testFloor : ℝ} (testFloor_pos : 0 < testFloor)
    (test_lower : ∀ κ t, t ∈ B.window κ → testFloor ≤ D.test t)
    (coefficient_integrableOn : ∀ κ m,
      IntegrableOn
        (fun t => Complex.normSq (D.coefficient κ m t))
        (B.window κ) (D.spectralMeasure κ))
    {densityFloor : NNReal} (densityFloor_pos : 0 < densityFloor)
    (spectral_dominates_dt : ∀ κ,
      densityFloor • volume.restrict (B.window κ) ≤
        (D.spectralMeasure κ).restrict (B.window κ)) :
    LebesgueData D where
  window := B.window
  window_measurable := window_measurable
  testFloor := testFloor
  testFloor_pos := testFloor_pos
  test_lower := test_lower
  coefficient_integrableOn := coefficient_integrableOn
  densityFloor := densityFloor
  densityFloor_pos := densityFloor_pos
  spectral_dominates_dt := spectral_dominates_dt
  activityFloor := B.coefficientFloor * volume.real B.activeSet
  activityFloor_pos :=
    mul_pos B.coefficientFloor_pos B.activeSet_positive
  threshold := B.threshold
  threshold_pos := B.threshold_pos
  lowerLebesgueActivity := by
    intro m hm
    simpa [rawActivityForWindow] using B.lower_rawActivity m hm

theorem LebesgueData.densityFloor_mul_rawActivityAtCusp_le_spectral
    {D : ContinuousSpectralData} (A : LebesgueData D)
    (κ : Gamma2Cusp) (m : ℕ) :
    (A.densityFloor : ℝ) *
      (∫ t in A.window κ,
        Complex.normSq (D.coefficient κ m t)) ≤
      ∫ t in A.window κ,
        Complex.normSq (D.coefficient κ m t)
        ∂D.spectralMeasure κ := by
  have h := integral_mono_measure
    (A.spectral_dominates_dt κ)
    (Eventually.of_forall fun t =>
      Complex.normSq_nonneg (D.coefficient κ m t))
    (A.coefficient_integrableOn κ m)
  simpa only [integral_smul_nnreal_measure, NNReal.smul_def,
    smul_eq_mul] using h

theorem LebesgueData.densityFloor_mul_rawWindowActivity_le_spectral
    {D : ContinuousSpectralData} (A : LebesgueData D) (m : ℕ) :
    (A.densityFloor : ℝ) * rawWindowActivity A m ≤
      ∑ κ : Gamma2Cusp,
        ∫ t in A.window κ,
          Complex.normSq (D.coefficient κ m t)
          ∂D.spectralMeasure κ := by
  rw [rawWindowActivity, rawActivityForWindow, Finset.mul_sum]
  exact Finset.sum_le_sum fun κ _ =>
    A.densityFloor_mul_rawActivityAtCusp_le_spectral κ m

/-- Convert a genuine `dt` lower-activity theorem to the same-measure data
used by the positive Plancherel mass. -/
def LebesgueData.toSpectralData
    {D : ContinuousSpectralData} (A : LebesgueData D) : Data D where
  window := A.window
  window_measurable := A.window_measurable
  testFloor := A.testFloor
  testFloor_pos := A.testFloor_pos
  test_lower := A.test_lower
  coefficient_integrableOn := A.coefficient_integrableOn
  activityFloor := (A.densityFloor : ℝ) * A.activityFloor
  activityFloor_pos :=
    mul_pos (NNReal.coe_pos.2 A.densityFloor_pos)
      A.activityFloor_pos
  threshold := A.threshold
  threshold_pos := A.threshold_pos
  lowerActivity := by
    intro m hm
    calc
      (A.densityFloor : ℝ) * A.activityFloor ≤
          (A.densityFloor : ℝ) * rawWindowActivity A m :=
        mul_le_mul_of_nonneg_left (A.lowerLebesgueActivity m hm)
          (NNReal.coe_nonneg A.densityFloor)
      _ ≤ ∑ κ : Gamma2Cusp,
          ∫ t in A.window κ,
            Complex.normSq (D.coefficient κ m t)
            ∂D.spectralMeasure κ :=
        A.densityFloor_mul_rawWindowActivity_le_spectral m

/-- Direct assembly of same-measure spectral activity from a fixed active set,
a test floor, and a positive spectral-density floor. -/
def Data.ofActiveSet
    {D : ContinuousSpectralData} (B : ActiveSetData D)
    (window_measurable : ∀ κ, MeasurableSet (B.window κ))
    {testFloor : ℝ} (testFloor_pos : 0 < testFloor)
    (test_lower : ∀ κ t, t ∈ B.window κ → testFloor ≤ D.test t)
    (coefficient_integrableOn : ∀ κ m,
      IntegrableOn
        (fun t => Complex.normSq (D.coefficient κ m t))
        (B.window κ) (D.spectralMeasure κ))
    {densityFloor : NNReal} (densityFloor_pos : 0 < densityFloor)
    (spectral_dominates_dt : ∀ κ,
      densityFloor • volume.restrict (B.window κ) ≤
        (D.spectralMeasure κ).restrict (B.window κ)) :
    Data D :=
  (LebesgueData.ofActiveSet B window_measurable testFloor_pos
    test_lower coefficient_integrableOn densityFloor_pos
    spectral_dominates_dt).toSpectralData

noncomputable def windowActivity
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp,
    ∫ t in A.window κ,
      Complex.normSq (D.coefficient κ m t)
      ∂D.spectralMeasure κ

noncomputable def localizedActivity
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) : ℝ :=
  ∑ κ : Gamma2Cusp,
    ∫ t in A.window κ,
      A.testFloor * Complex.normSq (D.coefficient κ m t)
      ∂D.spectralMeasure κ

theorem windowActivity_nonneg
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) :
    0 ≤ windowActivity A m := by
  unfold windowActivity
  apply Finset.sum_nonneg
  intro κ _
  exact integral_nonneg fun t =>
    Complex.normSq_nonneg (D.coefficient κ m t)

theorem localizedActivity_nonneg
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) :
    0 ≤ localizedActivity A m := by
  unfold localizedActivity
  apply Finset.sum_nonneg
  intro κ _
  exact integral_nonneg fun t =>
    mul_nonneg A.testFloor_pos.le
      (Complex.normSq_nonneg (D.coefficient κ m t))

theorem localizedActivity_eq_testFloor_mul
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) :
    localizedActivity A m = A.testFloor * windowActivity A m := by
  unfold localizedActivity windowActivity
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro κ _
  exact integral_const_mul A.testFloor
    (fun t => Complex.normSq (D.coefficient κ m t))

theorem localizedActivityAtCusp_le
    {D : ContinuousSpectralData} (A : Data D)
    (κ : Gamma2Cusp) (m : ℕ) :
    (∫ t in A.window κ,
      A.testFloor * Complex.normSq (D.coefficient κ m t)
      ∂D.spectralMeasure κ) ≤
      continuousMassAtCusp D κ m := by
  have hfloor : IntegrableOn
      (fun t => A.testFloor * Complex.normSq (D.coefficient κ m t))
      (A.window κ) (D.spectralMeasure κ) :=
    (A.coefficient_integrableOn κ m).const_mul _
  have hfullOn : IntegrableOn
      (fun t => D.test t * Complex.normSq (D.coefficient κ m t))
      (A.window κ) (D.spectralMeasure κ) :=
    (D.integrable κ m).integrableOn
  have hlocal :
      (∫ t in A.window κ,
        A.testFloor * Complex.normSq (D.coefficient κ m t)
        ∂D.spectralMeasure κ) ≤
      ∫ t in A.window κ,
        D.test t * Complex.normSq (D.coefficient κ m t)
        ∂D.spectralMeasure κ := by
    apply setIntegral_mono_on hfloor hfullOn (A.window_measurable κ)
    intro t ht
    exact mul_le_mul_of_nonneg_right (A.test_lower κ t ht)
      (Complex.normSq_nonneg (D.coefficient κ m t))
  have hnonneg :
      0 ≤ᵐ[D.spectralMeasure κ]
        (fun t => D.test t * Complex.normSq (D.coefficient κ m t)) :=
    Eventually.of_forall fun t =>
      mul_nonneg (D.test_nonneg t)
        (Complex.normSq_nonneg (D.coefficient κ m t))
  exact hlocal.trans <| by
    simpa [continuousMassAtCusp] using
      (setIntegral_le_integral (s := A.window κ)
        (D.integrable κ m) hnonneg)

theorem localizedActivity_le_mass
    {D : ContinuousSpectralData} (A : Data D) (m : ℕ) :
    localizedActivity A m ≤ massFunctional D m := by
  unfold localizedActivity massFunctional
  exact Finset.sum_le_sum fun κ _ => localizedActivityAtCusp_le A κ m

/-- **Corrected Lemma 3.8.** A supplied uniform window-activity certificate gives
the paper's eventual mass lower bound, on the same positive spectral measures. -/
theorem massConditionAt
    {D : ContinuousSpectralData} (A : Data D) :
    MassConditionAt D
      (A.testFloor * A.activityFloor) A.threshold := by
  refine ⟨mul_pos A.testFloor_pos A.activityFloor_pos,
    A.threshold_pos, ?_⟩
  intro m hm
  calc
    A.testFloor * A.activityFloor ≤
        A.testFloor * windowActivity A m :=
      mul_le_mul_of_nonneg_left (A.lowerActivity m hm)
        A.testFloor_pos.le
    _ = localizedActivity A m :=
      (localizedActivity_eq_testFloor_mul A m).symm
    _ ≤ massFunctional D m := localizedActivity_le_mass A m

theorem hMass
    {D : ContinuousSpectralData} (A : Data D) :
    HMass D (A.testFloor * A.activityFloor) :=
  ⟨A.threshold, massConditionAt A⟩

/-- **Corrected Lemma 3.8, raw-`dt` transfer.** A uniform lower bound on the
literal Lebesgue-window activity implies the mass condition once the required
spectral-measure domination has been proved. -/
theorem massConditionAt_of_lebesgueActivity
    {D : ContinuousSpectralData} (A : LebesgueData D) :
    MassConditionAt D
      (A.testFloor *
        ((A.densityFloor : ℝ) * A.activityFloor)) A.threshold :=
  massConditionAt A.toSpectralData

theorem hMass_of_lebesgueActivity
    {D : ContinuousSpectralData} (A : LebesgueData D) :
    HMass D
      (A.testFloor *
        ((A.densityFloor : ℝ) * A.activityFloor)) :=
  ⟨A.threshold, massConditionAt_of_lebesgueActivity A⟩

/-- Fully composed active-set route to the eventual mass condition.  The lower
constant displays all three indispensable quantitative inputs. -/
theorem massConditionAt_ofActiveSet
    {D : ContinuousSpectralData} (B : ActiveSetData D)
    (window_measurable : ∀ κ, MeasurableSet (B.window κ))
    {testFloor : ℝ} (testFloor_pos : 0 < testFloor)
    (test_lower : ∀ κ t, t ∈ B.window κ → testFloor ≤ D.test t)
    (coefficient_integrableOn : ∀ κ m,
      IntegrableOn
        (fun t => Complex.normSq (D.coefficient κ m t))
        (B.window κ) (D.spectralMeasure κ))
    {densityFloor : NNReal} (densityFloor_pos : 0 < densityFloor)
    (spectral_dominates_dt : ∀ κ,
      densityFloor • volume.restrict (B.window κ) ≤
        (D.spectralMeasure κ).restrict (B.window κ)) :
    MassConditionAt D
      (testFloor * ((densityFloor : ℝ) *
        (B.coefficientFloor * volume.real B.activeSet)))
      B.threshold := by
  let A : Data D := Data.ofActiveSet B window_measurable
    testFloor_pos test_lower coefficient_integrableOn
    densityFloor_pos spectral_dominates_dt
  change MassConditionAt D (A.testFloor * A.activityFloor) A.threshold
  exact massConditionAt A

/-- Existential `HMass` form of the direct active-set theorem. -/
theorem hMass_ofActiveSet
    {D : ContinuousSpectralData} (B : ActiveSetData D)
    (window_measurable : ∀ κ, MeasurableSet (B.window κ))
    {testFloor : ℝ} (testFloor_pos : 0 < testFloor)
    (test_lower : ∀ κ t, t ∈ B.window κ → testFloor ≤ D.test t)
    (coefficient_integrableOn : ∀ κ m,
      IntegrableOn
        (fun t => Complex.normSq (D.coefficient κ m t))
        (B.window κ) (D.spectralMeasure κ))
    {densityFloor : NNReal} (densityFloor_pos : 0 < densityFloor)
    (spectral_dominates_dt : ∀ κ,
      densityFloor • volume.restrict (B.window κ) ≤
        (D.spectralMeasure κ).restrict (B.window κ)) :
    HMass D
      (testFloor * ((densityFloor : ℝ) *
        (B.coefficientFloor * volume.real B.activeSet))) :=
  ⟨B.threshold,
    massConditionAt_ofActiveSet B window_measurable testFloor_pos
      test_lower coefficient_integrableOn densityFloor_pos
      spectral_dominates_dt⟩

end UniformActivity

/-! ## Corrected Lemma 6.1: restriction stability -/

namespace RestrictionStability

/-- A subset preserved by the given left group action. -/
structure InvariantSubset
    (G X : Type*) [Group G] [MulAction G X] where
  carrier : Set X
  smul_mem : ∀ (g : G) {x : X}, x ∈ carrier → g • x ∈ carrier

namespace InvariantSubset

variable {G X : Type*} [Group G] [MulAction G X]

/-- Preimage of a quotient subset under an invariant map is an actual
invariant subset upstairs.  This models the paper's `π⁻¹(U)` domains directly. -/
def preimageOfInvariantMap
    {Q : Type*} (π : X → Q)
    (hπ : ∀ (g : G) (x : X), π (g • x) = π x)
    (V : Set Q) :
    InvariantSubset G X where
  carrier := π ⁻¹' V
  smul_mem := by
    intro g x hx
    change π (g • x) ∈ V
    rw [hπ g x]
    exact hx

/-- Inclusion of quotient subsets induces the required inclusion of invariant
preimages, with no additional covariance certificate. -/
theorem preimageOfInvariantMap_mono
    {Q : Type*} (π : X → Q)
    (hπ : ∀ (g : G) (x : X), π (g • x) = π x)
    {V U : Set Q} (hVU : V ⊆ U) :
    (preimageOfInvariantMap π hπ V).carrier ⊆
      (preimageOfInvariantMap π hπ U).carrier :=
  Set.preimage_mono hVU

/-- The actual point type of an invariant subset. -/
abbrev Point (U : InvariantSubset G X) : Type _ :=
  {x : X // x ∈ U.carrier}

/-- The action induced on the subtype of points. -/
def smulPoint (U : InvariantSubset G X) (g : G) (x : U.Point) :
    U.Point :=
  ⟨g • (x : X), U.smul_mem g x.property⟩

/-- Inclusion of a smaller invariant subtype into a larger one. -/
def inclusion (U V : InvariantSubset G X)
    (hVU : V.carrier ⊆ U.carrier) : V.Point → U.Point :=
  fun x => ⟨x, hVU x.property⟩

@[simp]
theorem inclusion_smulPoint
    (U V : InvariantSubset G X)
    (hVU : V.carrier ⊆ U.carrier) (g : G) (x : V.Point) :
    U.inclusion V hVU (V.smulPoint g x) =
      U.smulPoint g (U.inclusion V hVU x) := by
  apply Subtype.ext
  rfl

/-- Ordinary restriction is precomposition with subtype inclusion. -/
def ordinaryRestrict
    {E : Type*} (U V : InvariantSubset G X)
    (hVU : V.carrier ⊆ U.carrier) (s : U.Point → E) :
    V.Point → E :=
  fun x => s (U.inclusion V hVU x)

@[simp]
theorem ordinaryRestrict_apply
    {E : Type*} (U V : InvariantSubset G X)
    (hVU : V.carrier ⊆ U.carrier) (s : U.Point → E) (x : V.Point) :
    U.ordinaryRestrict V hVU s x = s (U.inclusion V hVU x) :=
  rfl

@[simp]
theorem ordinaryRestrict_id
    {E : Type*} (U : InvariantSubset G X) (s : U.Point → E) :
    U.ordinaryRestrict U (fun _ hx => hx) s = s := by
  funext x
  apply congrArg s
  apply Subtype.ext
  rfl

@[simp]
theorem ordinaryRestrict_comp
    {E : Type*} (U V W : InvariantSubset G X)
    (hVU : V.carrier ⊆ U.carrier)
    (hWV : W.carrier ⊆ V.carrier) (s : U.Point → E) :
    V.ordinaryRestrict W hWV (U.ordinaryRestrict V hVU s) =
      U.ordinaryRestrict W (fun _ hx => hVU (hWV hx)) s := by
  funext x
  apply congrArg s
  apply Subtype.ext
  rfl

end InvariantSubset

/-- Pointwise half-weight covariance on an invariant subset.  Unlike a constant
fiber representation, the automorphy factor explicitly depends on the base
point. -/
def IsHalfWeightEquivariantOn
    (J : HalfWeightAutomorphyFactor)
    (U : InvariantSubset Gamma2Element UpperHalfPlane)
    (s : U.Point → ℂ) : Prop :=
  ∀ (γ : Gamma2Element) (x : U.Point),
    s (U.smulPoint γ x) =
      (J.factor γ (x : UpperHalfPlane) : ℂ) * s x

/-- Proof-carrying half-weight sections on an invariant subset. -/
abbrev HalfWeightEquivariantSection
    (J : HalfWeightAutomorphyFactor)
    (U : InvariantSubset Gamma2Element UpperHalfPlane) :=
  {s : U.Point → ℂ // IsHalfWeightEquivariantOn J U s}

/-- Basepoint-dependent half-weight covariance survives ordinary restriction. -/
theorem IsHalfWeightEquivariantOn.restrict
    {J : HalfWeightAutomorphyFactor}
    {U : InvariantSubset Gamma2Element UpperHalfPlane}
    {s : U.Point → ℂ} (hs : IsHalfWeightEquivariantOn J U s)
    (V : InvariantSubset Gamma2Element UpperHalfPlane)
    (hVU : V.carrier ⊆ U.carrier) :
    IsHalfWeightEquivariantOn J V (U.ordinaryRestrict V hVU s) := by
  intro γ x
  change
    s (U.inclusion V hVU (V.smulPoint γ x)) =
      (J.factor γ (x : UpperHalfPlane) : ℂ) *
        s (U.inclusion V hVU x)
  rw [InvariantSubset.inclusion_smulPoint]
  exact hs γ (U.inclusion V hVU x)

/-- Ordinary restriction lifted to actual half-weight equivariant sections. -/
def HalfWeightEquivariantSection.restrict
    {J : HalfWeightAutomorphyFactor}
    {U : InvariantSubset Gamma2Element UpperHalfPlane}
    (s : HalfWeightEquivariantSection J U)
    {V : InvariantSubset Gamma2Element UpperHalfPlane}
    (hVU : V.carrier ⊆ U.carrier) :
    HalfWeightEquivariantSection J V :=
  ⟨U.ordinaryRestrict V hVU s.1,
    IsHalfWeightEquivariantOn.restrict s.2 V hVU⟩

@[simp]
theorem HalfWeightEquivariantSection.restrict_apply
    {J : HalfWeightAutomorphyFactor}
    {U V : InvariantSubset Gamma2Element UpperHalfPlane}
    (s : HalfWeightEquivariantSection J U)
    (hVU : V.carrier ⊆ U.carrier) (x : V.Point) :
    (s.restrict hVU).1 x = s.1 (U.inclusion V hVU x) :=
  rfl

/-- Half-weight, basepoint-dependent form of corrected Lemma 6.1. -/
theorem HalfWeightEquivariantSection.restriction_covariance
    {J : HalfWeightAutomorphyFactor}
    {U V : InvariantSubset Gamma2Element UpperHalfPlane}
    (s : HalfWeightEquivariantSection J U)
    (hVU : V.carrier ⊆ U.carrier)
    (γ : Gamma2Element) (x : V.Point) :
    (s.restrict hVU).1 (V.smulPoint γ x) =
      (J.factor γ (x : UpperHalfPlane) : ℂ) *
        (s.restrict hVU).1 x :=
  (s.restrict hVU).2 γ x

@[simp]
theorem HalfWeightEquivariantSection.restrict_id
    {J : HalfWeightAutomorphyFactor}
    {U : InvariantSubset Gamma2Element UpperHalfPlane}
    (s : HalfWeightEquivariantSection J U) :
    s.restrict (V := U) (fun _ hx => hx) = s := by
  apply Subtype.ext
  exact InvariantSubset.ordinaryRestrict_id U s.1

@[simp]
theorem HalfWeightEquivariantSection.restrict_comp
    {J : HalfWeightAutomorphyFactor}
    {U V W : InvariantSubset Gamma2Element UpperHalfPlane}
    (s : HalfWeightEquivariantSection J U)
    (hVU : V.carrier ⊆ U.carrier)
    (hWV : W.carrier ⊆ V.carrier) :
    (s.restrict hVU).restrict hWV =
      s.restrict (V := W) (fun _ hx => hVU (hWV hx)) := by
  apply Subtype.ext
  exact InvariantSubset.ordinaryRestrict_comp U V W hVU hWV s.1

/-- Pointwise equivariance for a complex-linear fiber representation. -/
def IsPointwiseEquivariant
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    (ρ : G →* Module.End ℂ E) (U : InvariantSubset G X)
    (s : U.Point → E) : Prop :=
  ∀ (g : G) (x : U.Point),
    s (U.smulPoint g x) = ρ g (s x)

/-- Equivariant sections are ordinary functions on the invariant subtype, with
pointwise covariance as their only extra property. -/
abbrev PointwiseEquivariantSection
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    (ρ : G →* Module.End ℂ E) (U : InvariantSubset G X) :=
  {s : U.Point → E // IsPointwiseEquivariant ρ U s}

/-- Equivariance survives ordinary restriction; no restriction-commutation field
is assumed. -/
theorem IsPointwiseEquivariant.restrict
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E} {U : InvariantSubset G X}
    {s : U.Point → E} (hs : IsPointwiseEquivariant ρ U s)
    (V : InvariantSubset G X) (hVU : V.carrier ⊆ U.carrier) :
    IsPointwiseEquivariant ρ V (U.ordinaryRestrict V hVU s) := by
  intro g x
  change
    s (U.inclusion V hVU (V.smulPoint g x)) =
      ρ g (s (U.inclusion V hVU x))
  rw [InvariantSubset.inclusion_smulPoint]
  exact hs g (U.inclusion V hVU x)

/-- Ordinary restriction lifted to proof-carrying equivariant sections. -/
def PointwiseEquivariantSection.restrict
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E} {U : InvariantSubset G X}
    (s : PointwiseEquivariantSection ρ U)
    {V : InvariantSubset G X} (hVU : V.carrier ⊆ U.carrier) :
    PointwiseEquivariantSection ρ V :=
  ⟨U.ordinaryRestrict V hVU s.1,
    IsPointwiseEquivariant.restrict s.2 V hVU⟩

@[simp]
theorem PointwiseEquivariantSection.restrict_apply
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E} {U V : InvariantSubset G X}
    (s : PointwiseEquivariantSection ρ U)
    (hVU : V.carrier ⊆ U.carrier) (x : V.Point) :
    (s.restrict hVU).1 x = s.1 (U.inclusion V hVU x) :=
  rfl

/-- Pointwise form of corrected Lemma 6.1. -/
theorem PointwiseEquivariantSection.restriction_covariance
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E} {U V : InvariantSubset G X}
    (s : PointwiseEquivariantSection ρ U)
    (hVU : V.carrier ⊆ U.carrier) (g : G) (x : V.Point) :
    (s.restrict hVU).1 (V.smulPoint g x) =
      ρ g ((s.restrict hVU).1 x) :=
  (s.restrict hVU).2 g x

@[simp]
theorem PointwiseEquivariantSection.restrict_id
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E} {U : InvariantSubset G X}
    (s : PointwiseEquivariantSection ρ U) :
    s.restrict (V := U) (fun _ hx => hx) = s := by
  apply Subtype.ext
  exact InvariantSubset.ordinaryRestrict_id U s.1

@[simp]
theorem PointwiseEquivariantSection.restrict_comp
    {G X E : Type*}
    [Group G] [MulAction G X]
    [AddCommGroup E] [Module ℂ E]
    {ρ : G →* Module.End ℂ E}
    {U V W : InvariantSubset G X}
    (s : PointwiseEquivariantSection ρ U)
    (hVU : V.carrier ⊆ U.carrier)
    (hWV : W.carrier ⊆ V.carrier) :
    (s.restrict hVU).restrict hWV =
      s.restrict (V := W) (fun _ hx => hVU (hWV hx)) := by
  apply Subtype.ext
  exact InvariantSubset.ordinaryRestrict_comp U V W hVU hWV s.1

/-- A descent-compatible ambient map restricts to a linear map on covariant
gauge forms. -/
def GaugeDescentMorphism.onCovariantForms
    {E F : Type*}
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {D : GaugeDescentAction E} {D' : GaugeDescentAction F}
    (f : GaugeDescentMorphism D D') :
    qGaugeForms D →ₗ[ℂ] qGaugeForms D' where
  toFun A := ⟨f.map (A : E), f.map_mem_qGaugeForms A.property⟩
  map_add' A B := by
    apply Subtype.ext
    simpa using f.map.map_add (A : E) (B : E)
  map_smul' c A := by
    apply Subtype.ext
    simpa using f.map.map_smul c (A : E)

@[simp]
theorem GaugeDescentMorphism.coe_onCovariantForms
    {E F : Type*}
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    {D : GaugeDescentAction E} {D' : GaugeDescentAction F}
    (f : GaugeDescentMorphism D D') (A : qGaugeForms D) :
    ((GaugeDescentMorphism.onCovariantForms f A : qGaugeForms D') : F) =
      f.map (A : E) :=
  rfl

/-- Restriction on the covariant submodules. -/
def GaugeDescentSheaf.qGaugeRestrict
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U) :
    qGaugeForms (D.action U) →ₗ[ℂ] qGaugeForms (D.action V) :=
  GaugeDescentMorphism.onCovariantForms (D.restriction hVU)

@[simp]
theorem GaugeDescentSheaf.coe_qGaugeRestrict
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {U V : TopologicalSpace.Opens X} (hVU : V ≤ U)
    (A : qGaugeForms (D.action U)) :
    ((GaugeDescentSheaf.qGaugeRestrict D hVU A :
        qGaugeForms (D.action V)) : D.forms.section V) =
      D.forms.restrict hVU (A : D.forms.section U) := by
  change (D.restriction hVU).map (A : D.forms.section U) = _
  rw [D.restriction_eq hVU]

/-- Identity restriction on covariant forms. -/
theorem GaugeDescentSheaf.qGaugeRestrict_id
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    (U : TopologicalSpace.Opens X)
    (A : qGaugeForms (D.action U)) :
    GaugeDescentSheaf.qGaugeRestrict D (le_refl U) A = A := by
  apply Subtype.ext
  rw [GaugeDescentSheaf.coe_qGaugeRestrict D]
  simpa using D.forms.restrict_id U (A : D.forms.section U)

/-- Sheaf-level composition consequence.  Covariance membership is supplied by
the `GaugeDescentMorphism` restriction field; the unconditional ordinary-
restriction content of corrected Lemma 6.1 is proved above. -/
theorem GaugeDescentSheaf.qGaugeRestrict_comp
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    (D : GaugeDescentSheaf X E)
    {U V W : TopologicalSpace.Opens X}
    (hVU : V ≤ U) (hWV : W ≤ V)
    (A : qGaugeForms (D.action U)) :
    GaugeDescentSheaf.qGaugeRestrict D hWV
        (GaugeDescentSheaf.qGaugeRestrict D hVU A) =
      GaugeDescentSheaf.qGaugeRestrict D (hWV.trans hVU) A := by
  apply Subtype.ext
  simp only [GaugeDescentSheaf.coe_qGaugeRestrict D]
  simpa using D.forms.restrict_comp hVU hWV
    (A : D.forms.section U)

end RestrictionStability

/-! ## Corrected proposition layer: Propositions 1--21

The propositions in the source PDF mix valid functional-analytic leaves with
several false implications and several objects that are never constructed.  The
declarations below make that boundary executable.  A literal claim is retained
only when its hypotheses determine its conclusion.  Otherwise we prove a
countermodel or an exact obstruction and state the strongest corrected theorem
that follows from explicitly typed data.
-/

namespace CorrectedPropositions

/-! ### Proposition 1: dual norm identities and variable truncation -/

namespace DualNorm

/-- The dual norm is the supremum on the closed unit ball. -/
theorem dualNorm_eq_sSup_closedUnitBall
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) :
    sSup ((fun v : TrialSpace M => ‖dualPairing f v‖) ''
      Metric.closedBall (0 : TrialSpace M) 1) = ‖f‖ := by
  simpa only [dualPairing] using
    (ContinuousLinearMap.sSup_unitClosedBall_eq_norm f)

/-- The equivalent unit-sphere formula for the dual norm. -/
theorem dualNorm_eq_sSup_unitSphere
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) :
    sSup ((fun v : TrialSpace M => ‖dualPairing f v‖) ''
      Metric.sphere (0 : TrialSpace M) 1) = ‖f‖ := by
  simpa only [dualPairing] using
    (ContinuousLinearMap.sSup_sphere_eq_norm f)

/-- The operator norm is also the supremum of the homogeneous dual ratio over
all nonzero test vectors. -/
theorem dualNorm_eq_sSup_nonzeroRatio
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) :
    sSup ((fun v : TrialSpace M => ‖dualPairing f v‖ / ‖v‖) ''
      {v : TrialSpace M | v ≠ 0}) = ‖f‖ := by
  have hsets :
      ((fun v : TrialSpace M => ‖dualPairing f v‖ / ‖v‖) ''
          {v : TrialSpace M | v ≠ 0}) =
        ((fun v : TrialSpace M => ‖dualPairing f v‖) ''
          Metric.sphere (0 : TrialSpace M) 1) := by
    ext r
    constructor
    · rintro ⟨v, hv, rfl⟩
      let w : TrialSpace M := ((‖v‖⁻¹ : ℝ) : ℂ) • v
      have hvnorm : ‖v‖ ≠ 0 := norm_ne_zero_iff.mpr hv
      refine ⟨w, ?_, ?_⟩
      · rw [Metric.mem_sphere, dist_zero_right]
        simp only [w, norm_smul, Complex.norm_real,
          Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg v)),
          inv_mul_cancel₀ hvnorm]
      · simp only [w, dualPairing, map_smul, norm_smul,
          Complex.norm_real,
          Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg v))]
        rw [div_eq_mul_inv]
        exact mul_comm _ _
    · rintro ⟨v, hv, rfl⟩
      have hvnorm : ‖v‖ = 1 := by
        simpa only [Metric.mem_sphere, dist_zero_right] using hv
      have hvzero : v ≠ 0 := by
        intro hvzero
        subst v
        simpa using hvnorm
      refine ⟨v, hvzero, ?_⟩
      simpa only [hvnorm, div_one]
  rw [hsets, dualNorm_eq_sSup_unitSphere f]

/-- Every nonzero-vector ratio is bounded by the operator norm. -/
theorem dualRatio_le_opNorm
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] {M : WeightedSobolevDatum J μ H}
    (f : DataSpace M) (v : TrialSpace M) :
    ‖dualPairing f v‖ / ‖v‖ ≤ ‖f‖ := by
  simpa only [dualPairing] using f.ratio_le_opNorm v

/-- A truncation level may depend on the test vector.  If the tested density is
supported in that vector's truncation and every truncation lies in the ambient
domain, then the ambient and truncated set integrals agree.  This is the
support-sensitive replacement for the fixed-`Y` step in Proposition 1. -/
theorem setIntegral_eq_variableTruncation
    {X E V : Type*} [MeasurableSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure X) (ambient : Set X) (truncation : ℝ → Set X)
    (density : V → X → E) (level : V → ℝ)
    (htruncation : ∀ v, truncation (level v) ⊆ ambient)
    (hsupport : ∀ v x, x ∉ truncation (level v) → density v x = 0) :
    ∀ v,
      (∫ x in ambient, density v x ∂mu) =
        ∫ x in truncation (level v), density v x ∂mu := by
  intro v
  have hzeroAmbient : ∀ x, x ∉ ambient → density v x = 0 := by
    intro x hx
    exact hsupport v x (fun hxTruncation => hx (htruncation v hxTruncation))
  calc
    (∫ x in ambient, density v x ∂mu) = ∫ x, density v x ∂mu :=
      (StartingIntegralIdentity.integral_eq_setIntegral_of_zero_off
        hzeroAmbient).symm
    _ = ∫ x in truncation (level v), density v x ∂mu :=
      StartingIntegralIdentity.integral_eq_setIntegral_of_zero_off (hsupport v)

/-- **Corrected formula (1.5).** Compact support in the selected fundamental
domain supplies one common truncation height, and support then identifies the
ambient integral with the integral over that truncation. -/
theorem setIntegral_eq_compactCoreTruncation
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (mu : Measure UpperHalfPlane)
    {K F : Set UpperHalfPlane}
    (hK : IsCompact K) (hKF : K ⊆ F)
    (density : UpperHalfPlane → E)
    (hsupport : ∀ x, x ∉ K → density x = 0) :
    ∃ Y : ℝ,
      (∫ x in F, density x ∂mu) =
        ∫ x in truncatedFundamentalDomain F Y, density x ∂mu := by
  obtain ⟨Y, hKY⟩ :=
    Mock2Adv.IsCompact.exists_truncationHeight hK hKF
  refine ⟨Y, ?_⟩
  exact setIntegral_eq_variableTruncation
    mu F (truncatedFundamentalDomain F)
    (fun _ : Unit => density) (fun _ => Y)
    (fun _ => truncatedFundamentalDomain_subset F Y)
    (fun _ x hx => hsupport x (fun hxK => hx (hKY hxK)))
    Unit.unit

/-- A fixed truncation cannot replace the whole integral without a support
hypothesis.  The one-point measure gives a concrete counterexample. -/
theorem fixedTruncation_withoutSupport_false :
    (∫ _ : ℝ, (1 : ℂ) ∂Measure.dirac 0) ≠
      ∫ x in (∅ : Set ℝ), (1 : ℂ) ∂Measure.dirac 0 := by
  simp

end DualNorm

/-! ### Propositions 2--4: spectral and mass-gap errata -/

namespace SpectralMassGap

/-- A nonnegative discrete term and a lower-bounded continuous term lower-bound
their sum.  This is the valid ordered-ring leaf of the spectral argument. -/
theorem spectralSide_lower_of_mass
    {ε discrete continuous total : ℝ}
    (hdiscrete : 0 ≤ discrete) (hcontinuous : ε ≤ continuous)
    (htotal : total = discrete + continuous) :
    ε ≤ total := by
  linarith

/-- A real parameterization `lam = 1/4 + t²` cannot represent an exceptional
eigenvalue below `1/4`. -/
theorem no_real_spectralParameter_below_quarter
    {lam : ℝ} (hlam : lam < 1 / 4) :
    ¬ ∃ t : ℝ, lam = 1 / 4 + t ^ 2 := by
  rintro ⟨t, rfl⟩
  nlinarith [sq_nonneg t]

/-- A Poincare estimate does not force any unrelated coefficient family to be
active.  This is a concrete countermodel to the extraction used in Proposition 2. -/
theorem poincare_does_not_force_coefficient_activity :
    ∃ (R L : ℂ → ℂ) (ρ : ℕ → ℂ → ℂ) (u : ℂ),
      GlobalPoincare.PoincareEstimate R L 1 ∧
      u ≠ 0 ∧ ∀ m, ρ m u = 0 := by
  refine ⟨id, (fun _ => 0), (fun _ _ => 0), 1, ?_, by norm_num, by simp⟩
  intro z
  simp [GlobalPoincare.PoincareEstimate]

/-- A fixed positive lower bound is perfectly compatible with a polynomially
growing upper bound.  Thus the comparison in the PDF has the wrong direction. -/
theorem fixedLower_polynomialUpper_consistent :
    ∃ lower upper : ℕ → ℝ,
      (∀ m, 1 ≤ lower m) ∧
      (∀ m, lower m ≤ upper m) ∧
      (∀ m, upper m = (m : ℝ) + 1) := by
  refine ⟨(fun _ => 1), (fun m => (m : ℝ) + 1), ?_, ?_, ?_⟩
  · intro m
    norm_num
  · intro m
    have hm : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
    linarith
  · intro m
    rfl

/-- The correct exponent comparison: a strictly larger real power, with a
positive leading constant, eventually dominates any nonnegative multiple of a
smaller real power. -/
theorem rpow_eventually_dominates
    {A B a b : ℝ} (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a) :
    ∀ᶠ x : ℝ in atTop, B * x ^ b < A * x ^ a := by
  have hratio :
      ∀ᶠ x : ℝ in atTop, B / A < x ^ (a - b) :=
    (tendsto_rpow_atTop (sub_pos.mpr hab)).eventually_gt_atTop (B / A)
  filter_upwards [eventually_gt_atTop (0 : ℝ), hratio] with x hx hBA
  have hpow : 0 < x ^ b := Real.rpow_pos_of_pos hx b
  have hscaled : B < x ^ (a - b) * A :=
    (div_lt_iff₀ hA).1 hBA
  calc
    B * x ^ b < (x ^ (a - b) * A) * x ^ b :=
      mul_lt_mul_of_pos_right hscaled hpow
    _ = A * (x ^ b * x ^ (a - b)) := by ring
    _ = A * x ^ (b + (a - b)) := by
      rw [← Real.rpow_add hx]
    _ = A * x ^ a := by ring_nf

/-- Natural indices inherit the same genuine exponent comparison. -/
theorem nat_rpow_eventually_dominates
    {A B a b : ℝ} (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a) :
    ∀ᶠ m : ℕ in atTop,
      B * (m : ℝ) ^ b < A * (m : ℝ) ^ a :=
  tendsto_natCast_atTop_atTop.eventually
    (rpow_eventually_dominates hA hB hab)

end SpectralMassGap

namespace PositiveMassCriterion

/-- A concrete nonvacuous positive spectral model: the unit tent is tested at a
Dirac spectral point and every cusp coefficient is one.  This verifies that the
corrected mass interface admits unconditional positive examples. -/
noncomputable def unitCoefficientDiracData : ContinuousSpectralData where
  test := TentKernel.profile 1
  test_nonneg := TentKernel.profile_nonneg 1
  spectralMeasure := fun _ => Measure.dirac 0
  coefficient := fun _ _ _ => 1
  integrable := by
    intro κ m
    exact integrable_dirac (by simp)

@[simp]
theorem continuousMassAtCusp_unitCoefficientDiracData
    (κ : Gamma2Cusp) (m : ℕ) :
    continuousMassAtCusp unitCoefficientDiracData κ m = 1 := by
  simp [continuousMassAtCusp, unitCoefficientDiracData,
    TentKernel.profile]

@[simp]
theorem massFunctional_unitCoefficientDiracData (m : ℕ) :
    massFunctional unitCoefficientDiracData m = 3 := by
  simp [massFunctional, nsmul_eq_mul]

/-- The concrete model satisfies the mass condition uniformly from index one. -/
theorem hMass_unitCoefficientDiracData :
    HMass unitCoefficientDiracData 1 := by
  refine ⟨1, by norm_num, by norm_num, ?_⟩
  intro m hm
  simp

/-- A concrete mass model using the very same smooth Fourier-positive test as
the Step-1/Step-3 certificate, with unit coefficients and Dirac spectral
measure. -/
noncomputable def unitCoefficientFourierPositiveDiracData
    (T : ℝ) (hT : 0 < T) : ContinuousSpectralData :=
  KuznetsovInterface.fourierPositiveContinuousSpectralData
    T hT (fun _ => Measure.dirac 0) (fun _ _ _ => 1) (by
      intro κ m
      exact integrable_dirac (by simp))

@[simp]
theorem continuousMassAtCusp_unitCoefficientFourierPositiveDiracData
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m : ℕ) :
    continuousMassAtCusp
        (unitCoefficientFourierPositiveDiracData T hT) κ m =
      KuznetsovInterface.fourierPositiveSmoothTentFunction T hT 0 := by
  simp [continuousMassAtCusp,
    unitCoefficientFourierPositiveDiracData,
    KuznetsovInterface.fourierPositiveContinuousSpectralData]

@[simp]
theorem massFunctional_unitCoefficientFourierPositiveDiracData
    (T : ℝ) (hT : 0 < T) (m : ℕ) :
    massFunctional (unitCoefficientFourierPositiveDiracData T hT) m =
      3 * KuznetsovInterface.fourierPositiveSmoothTentFunction T hT 0 := by
  simp [massFunctional, nsmul_eq_mul]

/-- The smooth Fourier-positive concrete model satisfies a uniform positive
mass condition with its actual central test value as lower constant. -/
theorem hMass_unitCoefficientFourierPositiveDiracData
    (T : ℝ) (hT : 0 < T) :
    HMass (unitCoefficientFourierPositiveDiracData T hT)
      (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT 0) := by
  have hpositive :=
    KuznetsovInterface.fourierPositiveSmoothTentFunction_pos_zero T hT
  refine ⟨1, hpositive, by norm_num, ?_⟩
  intro m hm
  rw [massFunctional_unitCoefficientFourierPositiveDiracData]
  nlinarith

/-- One concrete smooth Fourier-positive test simultaneously supplies positive
mass, a local positive window, transform-integrability, and the normalized
kernel estimate. -/
theorem sameSmoothTest_massAndTransformCertificate
    (T x : ℝ) (hT : 0 < T) (hx : 0 < x) :
    HMass (unitCoefficientFourierPositiveDiracData T hT)
        (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT 0) ∧
      (∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
        ∀ t, |t| < δ →
          c ≤ KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t) ∧
      KuznetsovInterface.profileBesselConvention.SmoothTransformIntegrable
        (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ∧
      ‖KuznetsovInterface.profileBesselConvention.transform
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) x‖ ≤
        T ^ 2 * KuznetsovInterface.besselEnvelope x :=
  ⟨hMass_unitCoefficientFourierPositiveDiracData T hT,
    KuznetsovInterface.profileBesselConvention_sameTestCertificate hT hx⟩

/-- A nonzero smooth Fourier-positive test and a positive spectral measure still
give zero mass when every coefficient is zero. -/
noncomputable def zeroCoefficientFourierPositiveData
    (T : ℝ) (hT : 0 < T) : ContinuousSpectralData :=
  KuznetsovInterface.fourierPositiveContinuousSpectralData
    T hT (fun _ => (volume : Measure ℝ)) (fun _ _ _ => 0) (by
      intro κ m
      simp)

@[simp]
theorem massFunctional_zeroCoefficientFourierPositiveData
    (T : ℝ) (hT : 0 < T) (m : ℕ) :
    massFunctional (zeroCoefficientFourierPositiveData T hT) m = 0 := by
  simp [zeroCoefficientFourierPositiveData,
    KuznetsovInterface.fourierPositiveContinuousSpectralData,
    massFunctional, continuousMassAtCusp]

/-- Positivity of the test and of the ambient measure alone cannot imply a
strict eventual mass lower bound. -/
theorem not_hMass_zeroCoefficientFourierPositiveData
    (T : ℝ) (hT : 0 < T) (ε : ℝ) :
    ¬ HMass (zeroCoefficientFourierPositiveData T hT) ε := by
  rintro ⟨m₀, hε, _, hlower⟩
  have hle : ε ≤ 0 := by
    simpa using hlower m₀ le_rfl
  linarith

/-- Even a unitary constant scalar has zero logarithmic derivative.  Unitarity
therefore does not imply the strict positivity asserted in Propositions 3--4. -/
theorem constantUnitary_logDerivative_zero (z : ℂ) :
    ‖(1 : ℂ)‖ = 1 ∧
      deriv (fun _ : ℂ => (1 : ℂ)) z * (1 : ℂ)⁻¹ = 0 := by
  simp

end PositiveMassCriterion

/-! ### Propositions 5--7: a valid smooth test and quantitative activity -/

namespace CommonTestFamily

/-- The raw tent is not differentiable at its peak, so it is not itself the
smooth Kuznetsov test claimed by the paper. -/
theorem not_differentiableAt_profile_zero
    {T : ℝ} (hT : 0 < T) :
    ¬ DifferentiableAt ℝ (TentKernel.profile T) 0 := by
  intro h
  have heq : TentKernel.profile T =ᶠ[𝓝 0]
      (fun t : ℝ => T - |t|) := by
    filter_upwards [Ioo_mem_nhds (neg_lt_zero.mpr hT) hT] with t ht
    exact TentKernel.profile_eq_sub_abs (abs_lt.mpr ht).le
  have hsub : DifferentiableAt ℝ (fun t : ℝ => T - |t|) 0 :=
    (h.hasDerivAt.congr_of_eventuallyEq heq.symm).differentiableAt
  apply not_differentiableAt_abs_zero
  have hdiff :
      DifferentiableAt ℝ (fun t : ℝ => T - (T - |t|)) 0 :=
    (differentiableAt_const (c := T)).sub hsub
  convert hdiff using 1
  funext t
  ring

/-- No strictly positive floor exists on the full topological support of the
tent, since the tent vanishes at both boundary points. -/
theorem no_positive_profile_floor_on_tsupport
    {T : ℝ} (hT : 0 < T) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ t ∈ tsupport (TentKernel.profile T),
        c ≤ TentKernel.profile T t := by
  rintro ⟨c, hc, hfloor⟩
  have hTmem : T ∈ tsupport (TentKernel.profile T) := by
    rw [TentKernel.tsupport_profile hT]
    exact ⟨by linarith, le_rfl⟩
  have hb := hfloor T hTmem
  have hz : TentKernel.profile T T = 0 :=
    TentKernel.profile_eq_zero (by simp [abs_of_pos hT])
  rw [hz] at hb
  linarith

/-- The corrected active-set mass condition also lower-bounds a total spectral
quantity after adding any nonnegative discrete contribution. -/
theorem fullSpectral_lower_of_massCondition
    {D : ContinuousSpectralData} {ε : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀)
    (discrete total : ℕ → ℝ)
    (hdiscrete : ∀ m, 0 ≤ discrete m)
    (htotal : ∀ m, total m = discrete m + massFunctional D m) :
    ∀ m, m₀ ≤ m → ε ≤ total m := by
  intro m hm
  rw [htotal m]
  linarith [h.2.2 m hm, hdiscrete m]

end CommonTestFamily

/-! ### Corollaries 3.1--3.3: corrected mass insertion

The PDF calls Corollaries 3.1 and 3.2 "nonconditional mass gaps", but both
statements assume (or merely repeat) the eventual continuous-mass lower bound.
They do not mention the automorphic Laplacian and therefore cannot be spectral
gap theorems.  The first two results below expose the actual conclusion and
make the duplicate corollary a direct consequence of the quantitative
uniform-activity theorem.

For Corollary 3.3 the two sides of Kuznetsov are kept distinct.  The spectral
side is `discrete + continuous`, whereas the geometric side is
`diagonal/main + off-diagonal`.  A single positive normalization factor is
recorded in every displayed identity, so no hidden convention can be changed
between the continuous-mass identification and the trace formula. -/

namespace Section54CorollaryRepair

/-- **Corrected Corollary 3.1.**  `HMass D ε` gives an eventual lower bound for
the continuous mass functional.  This deliberately has no "Laplacian gap" in
its name or conclusion. -/
theorem corollary31_eventualContinuousMassLower
    {D : ContinuousSpectralData} {ε : ℝ}
    (h : HMass D ε) :
    0 < ε ∧ ∀ᶠ m : ℕ in atTop, ε ≤ massFunctional D m := by
  rcases h with ⟨m₀, hm⟩
  refine ⟨hm.1, ?_⟩
  filter_upwards [eventually_ge_atTop m₀] with m hthreshold
  exact hm.2.2 m hthreshold

/-- The corrected Corollary 3.1 also implies eventual strict positivity, but
only for the continuous mass appearing in its hypothesis. -/
theorem corollary31_eventualContinuousMassPositive
    {D : ContinuousSpectralData} {ε : ℝ}
    (h : HMass D ε) :
    ∀ᶠ m : ℕ in atTop, 0 < massFunctional D m := by
  rcases corollary31_eventualContinuousMassLower h with ⟨hε, hlower⟩
  filter_upwards [hlower] with m hm
  exact hε.trans_le hm

/-- **Corrected Corollary 3.2.**  This is the pointwise form of the uniform
continuous-mass lower bound proved by `UniformActivity.massConditionAt`; it is
not a second analytic criterion. -/
theorem corollary32_uniformContinuousMassLower_atIndex
    {D : ContinuousSpectralData} (A : UniformActivity.Data D)
    {m : ℕ} (hm : A.threshold ≤ m) :
    A.testFloor * A.activityFloor ≤ massFunctional D m :=
  (UniformActivity.massConditionAt A).2.2 m hm

/-- Eventual form of corrected Corollary 3.2, obtained through Corollary 3.1
from the very same Proposition-6 activity certificate. -/
theorem corollary32_eventualContinuousMassLower
    {D : ContinuousSpectralData} (A : UniformActivity.Data D) :
    0 < A.testFloor * A.activityFloor ∧
      ∀ᶠ m : ℕ in atTop,
        A.testFloor * A.activityFloor ≤ massFunctional D m :=
  corollary31_eventualContinuousMassLower (UniformActivity.hMass A)

/-- An explicit positive normalization used by a Kuznetsov identity.  Keeping
it as data prevents the discrete, continuous, and geometric sides from being
silently written in different conventions. -/
structure KuznetsovNormalization where
  factor : ℝ
  factor_pos : 0 < factor

/-- The `1/(4π)` *continuous Rankin--Selberg Plancherel* normalization displayed
on pp. 24--25.  This definition alone makes no assertion about the normalization
of the full Mock1 Kuznetsov formula. -/
noncomputable def rankinSelbergPlancherelNormalization :
    KuznetsovNormalization where
  factor := (4 * Real.pi)⁻¹
  factor_pos := by
    exact inv_pos.mpr
      (mul_pos (show (0 : ℝ) < 4 by norm_num) Real.pi_pos)

@[simp]
theorem rankinSelbergPlancherelNormalization_factor :
    rankinSelbergPlancherelNormalization.factor =
      (4 * Real.pi)⁻¹ :=
  rfl

/-- Proof-carrying normalized Kuznetsov identity at `m = n`.

The spectral and geometric decompositions are separate fields.  In particular,
the diagonal term is not incorrectly inserted as an additional summand on the
spectral side.  The continuous identification is exactly the corrected
positive mass functional, including its sum over all cusps. -/
structure KuznetsovSpectralIdentity
    (D : ContinuousSpectralData) (N : KuznetsovNormalization) where
  rawDiscrete : ℕ → ℝ
  rawContinuous : ℕ → ℝ
  rawDiagonalMain : ℕ → ℝ
  rawOffDiagonal : ℕ → ℝ
  spectralSide : ℕ → ℝ
  geometricSide : ℕ → ℝ
  rawDiscrete_nonneg : ∀ m, 0 ≤ rawDiscrete m
  rawDiagonalMain_nonneg : ∀ m, 0 ≤ rawDiagonalMain m
  continuous_identification : ∀ m,
    N.factor * rawContinuous m = massFunctional D m
  spectral_decomposition : ∀ m,
    spectralSide m = N.factor * (rawDiscrete m + rawContinuous m)
  geometric_decomposition : ∀ m,
    geometricSide m = N.factor * (rawDiagonalMain m + rawOffDiagonal m)
  trace_identity : ∀ m, spectralSide m = geometricSide m

/-- An actual discrete spectral series at `m = n`.  Its summability field
ensures that `tsum` denotes the value of a convergent series rather than the
default value assigned to a nonsummable family. -/
structure DiscreteSpectralSeries (D : ContinuousSpectralData) where
  Mode : Type
  spectralParameter : Mode → ℝ
  coefficient : Mode → ℕ → ℂ
  summable_series : ∀ m, Summable (fun j : Mode =>
    Complex.normSq (coefficient j m) * D.test (spectralParameter j))

/-- One diagonal discrete summand
`‖ρ_j(m)‖² Φ(t_j)` in the corrected real normalization. -/
noncomputable def DiscreteSpectralSeries.term
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (j : S.Mode) (m : ℕ) : ℝ :=
  Complex.normSq (S.coefficient j m) * D.test (S.spectralParameter j)

theorem DiscreteSpectralSeries.term_nonneg
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (j : S.Mode) (m : ℕ) :
    0 ≤ S.term j m :=
  mul_nonneg (Complex.normSq_nonneg (S.coefficient j m))
    (D.test_nonneg (S.spectralParameter j))

theorem DiscreteSpectralSeries.summable_term
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (m : ℕ) :
    Summable (fun j : S.Mode => S.term j m) := by
  simpa only [DiscreteSpectralSeries.term] using S.summable_series m

/-- The full discrete contribution as a genuinely convergent infinite sum. -/
noncomputable def DiscreteSpectralSeries.contribution
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (m : ℕ) : ℝ :=
  ∑' j : S.Mode, S.term j m

theorem DiscreteSpectralSeries.contribution_hasSum
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (m : ℕ) :
    HasSum (fun j : S.Mode => S.term j m) (S.contribution m) :=
  (S.summable_term m).hasSum

/-- Discrete positivity is derived term-by-term from `normSq ≥ 0` and the
nonnegative test, rather than stored as a conclusion-shaped field. -/
theorem DiscreteSpectralSeries.contribution_nonneg
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    (m : ℕ) :
    0 ≤ S.contribution m := by
  unfold DiscreteSpectralSeries.contribution
  exact tsum_nonneg fun j => S.term_nonneg j m

/-! The diagonal isolation step used in (3.9) is an elementary theorem about
an actually summable nonnegative series.  We prove it here rather than storing
`selected term ≤ total contribution` in the Kuznetsov certificate. -/

namespace NonnegativeSummableSeries

/-- The sum of all terms except one selected index, written with an `ite` so
that it does not require a separate equivalence with a complement subtype. -/
noncomputable def complement
    {ι : Type*} [DecidableEq ι] (f : ι → ℝ) (i₀ : ι) : ℝ :=
  ∑' i, if i = i₀ then 0 else f i

/-- Exact selected-term/complement decomposition of a genuinely summable real
series.  This is Mathlib's `Summable.tsum_eq_add_tsum_ite` with the complement
given a stable project-local name. -/
theorem tsum_eq_term_add_complement
    {ι : Type*} [DecidableEq ι] (f : ι → ℝ)
    (hf : Summable f) (i₀ : ι) :
    (∑' i, f i) = f i₀ + complement f i₀ := by
  simpa only [complement] using hf.tsum_eq_add_tsum_ite i₀

/-- A complement of a pointwise nonnegative series is nonnegative. -/
theorem complement_nonneg
    {ι : Type*} [DecidableEq ι] (f : ι → ℝ)
    (hf : ∀ i, 0 ≤ f i) (i₀ : ι) :
    0 ≤ complement f i₀ := by
  unfold complement
  apply tsum_nonneg
  intro i
  by_cases hi : i = i₀
  · simp [hi]
  · simpa only [hi, if_false] using hf i

/-- Every term of a summable nonnegative real series is bounded by its total
sum.  No conclusion-shaped lower-bound field is used. -/
theorem term_le_tsum
    {ι : Type*} [DecidableEq ι] (f : ι → ℝ)
    (hsum : Summable f) (hf : ∀ i, 0 ≤ f i) (i₀ : ι) :
    f i₀ ≤ ∑' i, f i := by
  rw [tsum_eq_term_add_complement f hsum i₀]
  exact le_add_of_nonneg_right (complement_nonneg f hf i₀)

end NonnegativeSummableSeries

/-- The complementary discrete contribution obtained by deleting one selected
spectral mode from the genuine diagonal series. -/
noncomputable def DiscreteSpectralSeries.complementaryContribution
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    [DecidableEq S.Mode] (j₀ : S.Mode) (m : ℕ) : ℝ :=
  NonnegativeSummableSeries.complement (fun j => S.term j m) j₀

/-- Exact decomposition of the discrete diagonal contribution into a selected
mode and all remaining modes. -/
theorem DiscreteSpectralSeries.contribution_eq_term_add_complementary
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    [DecidableEq S.Mode] (j₀ : S.Mode) (m : ℕ) :
    S.contribution m =
      S.term j₀ m + S.complementaryContribution j₀ m := by
  simpa only [DiscreteSpectralSeries.contribution,
    DiscreteSpectralSeries.complementaryContribution] using
    NonnegativeSummableSeries.tsum_eq_term_add_complement
      (fun j => S.term j m) (S.summable_term m) j₀

/-- The remaining diagonal modes still contribute nonnegatively. -/
theorem DiscreteSpectralSeries.complementaryContribution_nonneg
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    [DecidableEq S.Mode] (j₀ : S.Mode) (m : ℕ) :
    0 ≤ S.complementaryContribution j₀ m := by
  exact NonnegativeSummableSeries.complement_nonneg
    (fun j => S.term j m) (fun j => S.term_nonneg j m) j₀

/-- Genuine lowest/selected-mode isolation for (3.9): any one nonnegative
diagonal summand is at most the full convergent discrete contribution. -/
theorem DiscreteSpectralSeries.term_le_contribution
    {D : ContinuousSpectralData} (S : DiscreteSpectralSeries D)
    [DecidableEq S.Mode] (j₀ : S.Mode) (m : ℕ) :
    S.term j₀ m ≤ S.contribution m := by
  exact NonnegativeSummableSeries.term_le_tsum
    (fun j => S.term j m) (S.summable_term m)
      (fun j => S.term_nonneg j m) j₀

/-- Strengthened normalized identity whose discrete contribution is the
explicit summable Fourier-coefficient series above. -/
structure SeriesKuznetsovSpectralIdentity
    (D : ContinuousSpectralData) (N : KuznetsovNormalization) where
  discreteSeries : DiscreteSpectralSeries D
  rawContinuous : ℕ → ℝ
  rawDiagonalMain : ℕ → ℝ
  rawOffDiagonal : ℕ → ℝ
  spectralSide : ℕ → ℝ
  geometricSide : ℕ → ℝ
  rawDiagonalMain_nonneg : ∀ m, 0 ≤ rawDiagonalMain m
  continuous_identification : ∀ m,
    N.factor * rawContinuous m = massFunctional D m
  spectral_decomposition : ∀ m,
    spectralSide m =
      N.factor * (discreteSeries.contribution m + rawContinuous m)
  geometric_decomposition : ∀ m,
    geometricSide m = N.factor * (rawDiagonalMain m + rawOffDiagonal m)
  trace_identity : ∀ m, spectralSide m = geometricSide m

/-- Normalized form of the corrected lowest-mode isolation (3.9).  Once the
series-valued Kuznetsov decomposition identifies its continuous part with the
positive mass, a selected diagonal mode plus that mass is bounded by the full
spectral side.  The selected-mode inequality itself is proved from `Summable`.
-/
theorem SeriesKuznetsovSpectralIdentity.selectedMode_add_mass_le_spectralSide
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : SeriesKuznetsovSpectralIdentity D N)
    [DecidableEq K.discreteSeries.Mode]
    (j₀ : K.discreteSeries.Mode) (m : ℕ) :
    N.factor * K.discreteSeries.term j₀ m + massFunctional D m ≤
      K.spectralSide m := by
  rw [K.spectral_decomposition m, mul_add,
    K.continuous_identification m]
  simpa only [add_comm] using
    (add_le_add_right
      (mul_le_mul_of_nonneg_left
        (K.discreteSeries.term_le_contribution j₀ m) N.factor_pos.le)
      (massFunctional D m))

/-- Forget only the construction of the discrete term.  Its required
nonnegativity is discharged by `DiscreteSpectralSeries.contribution_nonneg`. -/
noncomputable def SeriesKuznetsovSpectralIdentity.toKuznetsovSpectralIdentity
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : SeriesKuznetsovSpectralIdentity D N) :
    KuznetsovSpectralIdentity D N where
  rawDiscrete := K.discreteSeries.contribution
  rawContinuous := K.rawContinuous
  rawDiagonalMain := K.rawDiagonalMain
  rawOffDiagonal := K.rawOffDiagonal
  spectralSide := K.spectralSide
  geometricSide := K.geometricSide
  rawDiscrete_nonneg := K.discreteSeries.contribution_nonneg
  rawDiagonalMain_nonneg := K.rawDiagonalMain_nonneg
  continuous_identification := K.continuous_identification
  spectral_decomposition := K.spectral_decomposition
  geometric_decomposition := K.geometric_decomposition
  trace_identity := K.trace_identity

/-- The normalized discrete contribution. -/
noncomputable def KuznetsovSpectralIdentity.normalizedDiscrete
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) : ℝ :=
  N.factor * K.rawDiscrete m

/-- The normalized continuous contribution. -/
noncomputable def KuznetsovSpectralIdentity.normalizedContinuous
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) : ℝ :=
  N.factor * K.rawContinuous m

/-- The normalized geometric diagonal/main term. -/
noncomputable def KuznetsovSpectralIdentity.normalizedDiagonalMain
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) : ℝ :=
  N.factor * K.rawDiagonalMain m

/-- The normalized geometric off-diagonal term. -/
noncomputable def KuznetsovSpectralIdentity.normalizedOffDiagonal
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) : ℝ :=
  N.factor * K.rawOffDiagonal m

theorem KuznetsovSpectralIdentity.normalizedDiscrete_nonneg
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    0 ≤ K.normalizedDiscrete m :=
  mul_nonneg N.factor_pos.le (K.rawDiscrete_nonneg m)

theorem KuznetsovSpectralIdentity.normalizedDiagonalMain_nonneg
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    0 ≤ K.normalizedDiagonalMain m :=
  mul_nonneg N.factor_pos.le (K.rawDiagonalMain_nonneg m)

@[simp]
theorem KuznetsovSpectralIdentity.normalizedContinuous_eq_mass
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    K.normalizedContinuous m = massFunctional D m :=
  K.continuous_identification m

/-- Exact normalized spectral decomposition `S = S_disc + E`. -/
theorem KuznetsovSpectralIdentity.spectralSide_eq_discrete_add_mass
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    K.spectralSide m =
      K.normalizedDiscrete m + massFunctional D m := by
  calc
    K.spectralSide m =
        N.factor * (K.rawDiscrete m + K.rawContinuous m) :=
      K.spectral_decomposition m
    _ = K.normalizedDiscrete m + K.normalizedContinuous m := by
      rw [mul_add]
      rfl
    _ = K.normalizedDiscrete m + massFunctional D m := by
      rw [K.normalizedContinuous_eq_mass]

/-- Exact normalized geometric decomposition `G = diagonal/main + off-diagonal`. -/
theorem KuznetsovSpectralIdentity.geometricSide_eq_diagonal_add_offDiagonal
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    K.geometricSide m =
      K.normalizedDiagonalMain m + K.normalizedOffDiagonal m := by
  calc
    K.geometricSide m =
        N.factor * (K.rawDiagonalMain m + K.rawOffDiagonal m) :=
      K.geometric_decomposition m
    _ = K.normalizedDiagonalMain m + K.normalizedOffDiagonal m := by
      rw [mul_add]
      rfl

/-- Discrete positivity inserts the continuous mass into the full spectral
side: this is the ordered-ring core of `S ≥ E`. -/
theorem KuznetsovSpectralIdentity.continuousMass_le_spectralSide
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (K : KuznetsovSpectralIdentity D N) (m : ℕ) :
    massFunctional D m ≤ K.spectralSide m := by
  rw [K.spectralSide_eq_discrete_add_mass]
  exact le_add_of_nonneg_left (K.normalizedDiscrete_nonneg m)

/-- **Corrected Corollary 3.3.**  With one explicit normalization and an exact
Kuznetsov identity, a genuine mass condition gives
`ε ≤ E(m,m) ≤ S(m,m)`.  The final two conjuncts retain the trace identity and
its diagonal/main-term decomposition instead of conflating the two sides. -/
theorem corollary33_insertionIntoNormalizedSpectralSum
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    {ε : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀)
    (K : KuznetsovSpectralIdentity D N) :
    ∀ m, m₀ ≤ m →
      ε ≤ massFunctional D m ∧
      massFunctional D m ≤ K.spectralSide m ∧
      K.spectralSide m = K.geometricSide m ∧
      K.geometricSide m =
        K.normalizedDiagonalMain m + K.normalizedOffDiagonal m := by
  intro m hm
  exact ⟨h.2.2 m hm,
    K.continuousMass_le_spectralSide m,
    K.trace_identity m,
    K.geometricSide_eq_diagonal_add_offDiagonal m⟩

/-- Corollary 3.3 specialized to the literal `1/(4π)` normalization printed in
the Rankin--Selberg continuous term.  The argument `K` is deliberately still
required: only such a certificate proves that the *other* raw terms have been
converted to this same convention.  Thus this theorem does not infer a Mock1
normalization from the Rankin--Selberg display alone. -/
theorem corollary33_rankinSelbergPlancherelNormalization
    {D : ContinuousSpectralData} {ε : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀)
    (K : KuznetsovSpectralIdentity D
      rankinSelbergPlancherelNormalization) :
    ∀ m, m₀ ≤ m →
      ε ≤ massFunctional D m ∧
      massFunctional D m ≤ K.spectralSide m ∧
      K.spectralSide m = K.geometricSide m ∧
      K.geometricSide m =
        K.normalizedDiagonalMain m + K.normalizedOffDiagonal m :=
  corollary33_insertionIntoNormalizedSpectralSum h K

/-- Strengthened Corollary 3.3 in which discrete nonnegativity is proved from
the convergent series `∑' j, ‖ρ_j(m)‖² Φ(t_j)` rather than supplied as a field. -/
theorem corollary33_ofDiscreteSpectralSeries
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    {ε : ℝ} {m₀ : ℕ}
    (h : MassConditionAt D ε m₀)
    (K : SeriesKuznetsovSpectralIdentity D N) :
    ∀ m, m₀ ≤ m →
      ε ≤ massFunctional D m ∧
      massFunctional D m ≤ K.spectralSide m ∧
      K.spectralSide m = K.geometricSide m ∧
      K.geometricSide m =
        N.factor * K.rawDiagonalMain m +
          N.factor * K.rawOffDiagonal m := by
  intro m hm
  have hcontinuous :
      massFunctional D m ≤ K.spectralSide m := by
    rw [K.spectral_decomposition m, mul_add,
      K.continuous_identification m]
    exact le_add_of_nonneg_left
      (mul_nonneg N.factor_pos.le
        (K.discreteSeries.contribution_nonneg m))
  have hgeometric :
      K.geometricSide m =
        N.factor * K.rawDiagonalMain m +
          N.factor * K.rawOffDiagonal m := by
    calc
      K.geometricSide m =
          N.factor * (K.rawDiagonalMain m + K.rawOffDiagonal m) :=
        K.geometric_decomposition m
      _ = N.factor * K.rawDiagonalMain m +
          N.factor * K.rawOffDiagonal m :=
        mul_add _ _ _
  exact ⟨h.2.2 m hm, hcontinuous, K.trace_identity m, hgeometric⟩

/-- Direct Proposition-6-to-Corollary-3.3 pipeline.  Corollary 3.2 contributes
no extra analytic assumption. -/
theorem corollary33_ofUniformActivity
    {D : ContinuousSpectralData} {N : KuznetsovNormalization}
    (A : UniformActivity.Data D)
    (K : KuznetsovSpectralIdentity D N) :
    ∀ m, A.threshold ≤ m →
      A.testFloor * A.activityFloor ≤ massFunctional D m ∧
      massFunctional D m ≤ K.spectralSide m ∧
      K.spectralSide m = K.geometricSide m ∧
      K.geometricSide m =
        K.normalizedDiagonalMain m + K.normalizedOffDiagonal m :=
  corollary33_insertionIntoNormalizedSpectralSum
    (UniformActivity.massConditionAt A) K

end Section54CorollaryRepair

/-! ### Propositions 2--7: unconditional dependency closure and a volume model

The paper's three inputs in Proposition 2 do not by themselves connect a low
eigenvalue to Fourier-coefficient growth.  The first two theorems below isolate
the exact missing comparison: a positive lower power with exponent `a` is
incompatible with a nonnegative upper power with smaller exponent `b`.  The
mass term is inserted with its certified positive constant before that
comparison is used.

The second half of the block is a fully concrete, non-Dirac realization of
Propositions 3--7.  Its spectral measure is Lebesgue measure, its coefficient
is identically one, and its test is the same smooth Fourier-positive
autocorrelation used by the concrete transform convention.  Thus positivity
comes from an actual open interval of positive Lebesgue measure, not from a
stored lower-bound field or from an atom chosen at the origin. -/

namespace AnalyticP2P7Completion

/-- A genuine exponent separation is the quantitative comparison missing from
the proof outline of Proposition 2. -/
theorem eventual_power_bounds_incompatible
    {spectral : ℕ → ℝ} {A B a b : ℝ}
    (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a)
    (hlower : ∀ᶠ m : ℕ in atTop,
      A * (m : ℝ) ^ a ≤ spectral m)
    (hupper : ∀ᶠ m : ℕ in atTop,
      spectral m ≤ B * (m : ℝ) ^ b) :
    False := by
  have hdominates :=
    SpectralMassGap.nat_rpow_eventually_dominates hA hB hab
  obtain ⟨m, hdom, hmLower, hmUpper⟩ :=
    (hdominates.and (hlower.and hupper)).exists
  exact (not_lt_of_ge (hmLower.trans hmUpper)) hdom

/-- A coefficient lower-growth estimate and the mass condition combine
additively on the full spectral side.  This is stronger than merely discarding
the nonnegative mass term. -/
theorem eventual_spectral_lower_of_discreteGrowth_and_mass
    {D : ContinuousSpectralData} {ε A a : ℝ} {m₀ : ℕ}
    (hMass : MassConditionAt D ε m₀)
    (discrete spectral : ℕ → ℝ)
    (hspectral : ∀ m,
      spectral m = discrete m + massFunctional D m)
    (hDiscreteGrowth : ∀ᶠ m : ℕ in atTop,
      A * (m : ℝ) ^ a ≤ discrete m) :
    ∀ᶠ m : ℕ in atTop,
      A * (m : ℝ) ^ a + ε ≤ spectral m := by
  filter_upwards [hDiscreteGrowth, eventually_ge_atTop m₀] with m hgrowth hm₀
  rw [hspectral m]
  linarith [hMass.2.2 m hm₀]

/-- **Corrected mass-gap criterion.**  Besides the mass condition and the
spectral decomposition, this theorem explicitly requires the implication from
a putative bad eigenvalue to a coefficient lower-growth estimate, as well as a
geometric upper estimate with a strictly smaller exponent.  No conclusion is
extracted from positivity alone. -/
theorem spectralGap_of_powerSeparation
    {D : ContinuousSpectralData}
    {ε A B a b lam base : ℝ} {m₀ : ℕ}
    (hMass : MassConditionAt D ε m₀)
    (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a)
    (discrete spectral : ℕ → ℝ)
    (hspectral : ∀ m,
      spectral m = discrete m + massFunctional D m)
    (hbad_implies_growth : lam < base + ε →
      ∀ᶠ m : ℕ in atTop,
        A * (m : ℝ) ^ a ≤ discrete m)
    (hgeometric : ∀ᶠ m : ℕ in atTop,
      spectral m ≤ B * (m : ℝ) ^ b) :
    base + ε ≤ lam := by
  by_contra hgap
  have hbad : lam < base + ε := lt_of_not_ge hgap
  have hwithMass :=
    eventual_spectral_lower_of_discreteGrowth_and_mass
      hMass discrete spectral hspectral (hbad_implies_growth hbad)
  have hlower : ∀ᶠ m : ℕ in atTop,
      A * (m : ℝ) ^ a ≤ spectral m := by
    filter_upwards [hwithMass] with m hm
    calc
      A * (m : ℝ) ^ a ≤ A * (m : ℝ) ^ a + ε :=
        le_add_of_nonneg_right hMass.1.le
      _ ≤ spectral m := hm
  exact (eventual_power_bounds_incompatible hA hB hab hlower hgeometric).elim

/-- Quarter-base specialization matching the numerical form of Proposition 2. -/
theorem spectralGap_aboveQuarter_of_powerSeparation
    {D : ContinuousSpectralData}
    {ε A B a b lam : ℝ} {m₀ : ℕ}
    (hMass : MassConditionAt D ε m₀)
    (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a)
    (discrete spectral : ℕ → ℝ)
    (hspectral : ∀ m,
      spectral m = discrete m + massFunctional D m)
    (hbad_implies_growth : lam < 1 / 4 + ε →
      ∀ᶠ m : ℕ in atTop,
        A * (m : ℝ) ^ a ≤ discrete m)
    (hgeometric : ∀ᶠ m : ℕ in atTop,
      spectral m ≤ B * (m : ℝ) ^ b) :
    1 / 4 + ε ≤ lam :=
  spectralGap_of_powerSeparation (base := 1 / 4)
    hMass hA hB hab discrete spectral hspectral
      hbad_implies_growth hgeometric

/-- The Poincare estimate, spectral decomposition, trace identity, polynomial
geometric bound, and positive mass condition permit a numerical model with a
parameter below `1/4 + ε`.  All displayed mass/spectral/geometric quantities
are linked; the parameter remains unconstrained precisely because the three
paper inputs contain no relation from it to coefficient growth.  Hence the
missing implication in `spectralGap_of_powerSeparation` is logically
indispensable. -/
theorem proposition2_threeInputSkeleton_countermodel :
    ∃ (R L : ℂ → ℂ) (D : ContinuousSpectralData)
      (discrete spectral geometric polynomialUpper : ℕ → ℝ)
      (lam ε : ℝ),
      GlobalPoincare.PoincareEstimate R L 1 ∧
      HMass D ε ∧
      (∀ m, 0 ≤ discrete m) ∧
      (∀ m, spectral m = discrete m + massFunctional D m) ∧
      (∀ m, spectral m = geometric m) ∧
      (∀ m, |geometric m| ≤ polynomialUpper m) ∧
      (∀ m, polynomialUpper m = (m : ℝ) + 3) ∧
      lam < 1 / 4 + ε := by
  refine ⟨id, (fun _ => 0), PositiveMassCriterion.unitCoefficientDiracData,
    (fun _ => 0), (fun _ => 3), (fun _ => 3),
    (fun m => (m : ℝ) + 3), 0, 1, ?_,
    PositiveMassCriterion.hMass_unitCoefficientDiracData,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z
    simp [GlobalPoincare.PoincareEstimate]
  · intro m
    norm_num
  · intro m
    simp [PositiveMassCriterion.massFunctional_unitCoefficientDiracData]
  · intro m
    rfl
  · intro m
    have hthree : |(3 : ℝ)| = 3 := abs_of_nonneg (by norm_num)
    rw [hthree]
    exact le_add_of_nonneg_left (Nat.cast_nonneg m)
  · intro m
    rfl
  · norm_num

/-- The same smooth Fourier-positive test used by the concrete transform
convention, now paired with Lebesgue spectral measure and unit coefficients. -/
noncomputable def smoothVolumeUnitData
    (T : ℝ) (hT : 0 < T) : ContinuousSpectralData :=
  KuznetsovInterface.fourierPositiveContinuousSpectralData
    T hT (fun _ => volume) (fun _ _ _ => 1) (by
      intro κ m
      have hcontinuous : Continuous
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) :=
        (KuznetsovInterface.fourierPositiveSmoothTentFunction_smooth T hT).continuous
      have htest : Integrable
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) :=
        hcontinuous.integrable_of_hasCompactSupport
          (KuznetsovInterface.fourierPositiveSmoothTentFunction_compactSupport
            T hT)
      simpa using htest)

@[simp]
theorem smoothVolumeUnitData_test
    (T : ℝ) (hT : 0 < T) :
    (smoothVolumeUnitData T hT).test =
      KuznetsovInterface.fourierPositiveSmoothTentFunction T hT :=
  rfl

@[simp]
theorem smoothVolumeUnitData_spectralMeasure
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) :
    (smoothVolumeUnitData T hT).spectralMeasure κ = volume :=
  rfl

@[simp]
theorem smoothVolumeUnitData_coefficient
    (T : ℝ) (hT : 0 < T)
    (κ : Gamma2Cusp) (m : ℕ) (t : ℝ) :
    (smoothVolumeUnitData T hT).coefficient κ m t = 1 :=
  rfl

/-- In the volume model one cusp contribution is literally the Lebesgue
integral of the common smooth test. -/
@[simp]
theorem continuousMassAtCusp_smoothVolumeUnitData_eq_integral
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m : ℕ) :
    continuousMassAtCusp (smoothVolumeUnitData T hT) κ m =
      ∫ t : ℝ,
        KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t := by
  simp [continuousMassAtCusp]

/-- There are exactly three cusp labels, so the total concrete mass is three
times the same positive Lebesgue integral. -/
@[simp]
theorem massFunctional_smoothVolumeUnitData_eq_three_mul_integral
    (T : ℝ) (hT : 0 < T) (m : ℕ) :
    massFunctional (smoothVolumeUnitData T hT) m =
      3 * (∫ t : ℝ,
        KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t) := by
  simp [massFunctional, nsmul_eq_mul]

/-- The local positivity theorem supplies an actual positive-volume activity
interval.  On that interval the spectral density is exactly the positive
Lebesgue density one. -/
theorem exists_positiveVolume_activityInterval
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m : ℕ) :
    ∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
      Ioo (-δ) δ ⊆
        spectralActivitySet (smoothVolumeUnitData T hT) κ m ∧
      (1 : NNReal) • volume.restrict (Ioo (-δ) δ) =
        ((smoothVolumeUnitData T hT).spectralMeasure κ).restrict
          (Ioo (-δ) δ) := by
  obtain ⟨δ, c, hδ, hc, hfloor⟩ :=
    KuznetsovInterface.fourierPositiveSmoothTentFunction_localPositiveFloor
      T hT
  refine ⟨δ, c, hδ, hc, ?_, ?_⟩
  · intro t ht
    have habs : |t| < δ := abs_lt.2 ht
    have hpositive :
        0 < KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t :=
      hc.trans_le (hfloor t habs)
    change
      KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t ≠ 0 ∧
        (1 : ℂ) ≠ 0
    exact ⟨hpositive.ne', one_ne_zero⟩
  · rw [smoothVolumeUnitData_spectralMeasure]
    simp

/-- The active spectral set in the volume model has strictly positive measure
for every cusp and every index. -/
theorem spectralActivitySet_smoothVolumeUnitData_pos
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m : ℕ) :
    0 < (smoothVolumeUnitData T hT).spectralMeasure κ
      (spectralActivitySet (smoothVolumeUnitData T hT) κ m) := by
  obtain ⟨δ, c, hδ, hc, hsubset, hdensity⟩ :=
    exists_positiveVolume_activityInterval T hT κ m
  change 0 < (volume : Measure ℝ)
    (spectralActivitySet (smoothVolumeUnitData T hT) κ m)
  calc
    0 < (volume : Measure ℝ) (Ioo (-δ) δ) := by
      simp [hδ]
    _ ≤ (volume : Measure ℝ)
        (spectralActivitySet (smoothVolumeUnitData T hT) κ m) :=
      measure_mono hsubset

/-- Every cusp contribution is strictly positive in the concrete volume
model. -/
theorem continuousMassAtCusp_smoothVolumeUnitData_pos
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m : ℕ) :
    0 < continuousMassAtCusp (smoothVolumeUnitData T hT) κ m :=
  (continuousMassAtCusp_pos_iff_activity
    (smoothVolumeUnitData T hT) κ m).2
      (spectralActivitySet_smoothVolumeUnitData_pos T hT κ m)

/-- Since the coefficient is independent of `m`, every cusp mass is exactly
independent of the arithmetic index. -/
theorem continuousMassAtCusp_smoothVolumeUnitData_index_independent
    (T : ℝ) (hT : 0 < T) (κ : Gamma2Cusp) (m n : ℕ) :
    continuousMassAtCusp (smoothVolumeUnitData T hT) κ m =
      continuousMassAtCusp (smoothVolumeUnitData T hT) κ n := by
  simp only [continuousMassAtCusp_smoothVolumeUnitData_eq_integral]

/-- The full cusp sum is likewise independent of the arithmetic index. -/
theorem massFunctional_smoothVolumeUnitData_index_independent
    (T : ℝ) (hT : 0 < T) (m n : ℕ) :
    massFunctional (smoothVolumeUnitData T hT) m =
      massFunctional (smoothVolumeUnitData T hT) n := by
  simp only [massFunctional_smoothVolumeUnitData_eq_three_mul_integral]

/-- The total continuous mass is strictly positive, with no activity
hypothesis stored in the data. -/
theorem massFunctional_smoothVolumeUnitData_pos
    (T : ℝ) (hT : 0 < T) (m : ℕ) :
    0 < massFunctional (smoothVolumeUnitData T hT) m :=
  (massFunctional_pos_iff (smoothVolumeUnitData T hT) m).2
    ⟨Gamma2Cusp.infinity,
      continuousMassAtCusp_smoothVolumeUnitData_pos
        T hT Gamma2Cusp.infinity m⟩

/-- **Concrete Propositions 3, 4, 6, and 7.**  The actual mass at index zero is
a strictly positive uniform lower constant for all indices from one onward. -/
theorem massConditionAt_smoothVolumeUnitData
    (T : ℝ) (hT : 0 < T) :
    MassConditionAt (smoothVolumeUnitData T hT)
      (massFunctional (smoothVolumeUnitData T hT) 0) 1 := by
  refine ⟨massFunctional_smoothVolumeUnitData_pos T hT 0,
    by norm_num, ?_⟩
  intro m hm
  rw [massFunctional_smoothVolumeUnitData_index_independent T hT 0 m]

theorem hMass_smoothVolumeUnitData
    (T : ℝ) (hT : 0 < T) :
    HMass (smoothVolumeUnitData T hT)
      (massFunctional (smoothVolumeUnitData T hT) 0) :=
  ⟨1, massConditionAt_smoothVolumeUnitData T hT⟩

/-- Concrete Step-1 spectral lower bound for the same smooth test: adding any
nonnegative discrete spectrum preserves the explicit continuous-mass floor. -/
theorem fullSpectral_lower_smoothVolumeUnitData
    (T : ℝ) (hT : 0 < T)
    (discrete spectral : ℕ → ℝ)
    (hdiscrete : ∀ m, 0 ≤ discrete m)
    (hspectral : ∀ m,
      spectral m = discrete m +
        massFunctional (smoothVolumeUnitData T hT) m) :
    ∀ m, 1 ≤ m →
      massFunctional (smoothVolumeUnitData T hT) 0 ≤ spectral m :=
  CommonTestFamily.fullSpectral_lower_of_massCondition
    (massConditionAt_smoothVolumeUnitData T hT)
    discrete spectral hdiscrete hspectral

/-- One theorem packages the genuinely identical test used in Propositions
3--7: it has the concrete volume-model mass condition, every directly proved
smooth/Fourier property, a positive local floor, transform admissibility, and
the normalized-kernel estimate. -/
theorem propositions3to7_sameSmoothTest_completeCertificate
    (T x : ℝ) (hT : 0 < T) (hx : 0 < x) :
    MassConditionAt (smoothVolumeUnitData T hT)
        (massFunctional (smoothVolumeUnitData T hT) 0) 1 ∧
      (Function.Even
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ∧
        ContDiff ℝ (↑(⊤ : ℕ∞))
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ∧
        HasCompactSupport
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ∧
        Function.support
            (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ⊆
          Ioo (-(T / 2)) (T / 2) ∧
        (∀ t,
          0 ≤ KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t ∧
          KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t ≤
            TentKernel.profile T t) ∧
        0 < KuznetsovInterface.fourierPositiveSmoothTentFunction T hT 0 ∧
        ∀ ξ,
          (𝓕 (fun t : ℝ =>
            (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t : ℂ)) ξ).im = 0 ∧
          0 ≤ (𝓕 (fun t : ℝ =>
            (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t : ℂ)) ξ).re) ∧
      (∃ δ c : ℝ, 0 < δ ∧ 0 < c ∧
        ∀ t, |t| < δ →
          c ≤ KuznetsovInterface.fourierPositiveSmoothTentFunction T hT t) ∧
      KuznetsovInterface.profileBesselConvention.SmoothTransformIntegrable
        (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) ∧
      ‖KuznetsovInterface.profileBesselConvention.transform
          (KuznetsovInterface.fourierPositiveSmoothTentFunction T hT) x‖ ≤
        T ^ 2 * KuznetsovInterface.besselEnvelope x := by
  exact ⟨massConditionAt_smoothVolumeUnitData T hT,
    KuznetsovInterface.lemma34_smoothReplacement_correctedAndProved T hT,
    KuznetsovInterface.profileBesselConvention_sameTestCertificate hT hx⟩

/-! ### A closed nontrivial Corollary 3.3 verification model

The definitions below are deliberately labelled a *verification model*.  They
do not claim to be the paper's unstated Mock-I arithmetic Kuznetsov formula.
Their purpose is narrower and fully formal: the already constructed smooth
Lebesgue-spectrum datum is combined with one genuinely positive discrete mode,
and every side of a normalized spectral/geometric identity is then defined and
proved equal.  Consequently the corrected Corollary 3.3 interface has a closed,
nonvacuous inhabitant; it is not merely a theorem conditional on an arbitrary
`KuznetsovSpectralIdentity` parameter. -/

namespace Corollary33VerificationModel

/-- A closed member of the smooth-volume family, with width `T = 1`. -/
noncomputable def spectralData : ContinuousSpectralData :=
  smoothVolumeUnitData 1 (by norm_num)

/-- The positive mass condition of the closed width-one model. -/
theorem massCondition :
    MassConditionAt spectralData (massFunctional spectralData 0) 1 := by
  simpa only [spectralData] using
    (massConditionAt_smoothVolumeUnitData 1 (by norm_num))

/-- The concrete lower mass used below is strictly positive. -/
theorem continuousMassFloor_pos :
    0 < massFunctional spectralData 0 :=
  massCondition.1

/-- Unit normalization for the verification identity.  This is intentionally
not identified with the paper's `1/(4π)` Rankin--Selberg convention. -/
def normalization : Section54CorollaryRepair.KuznetsovNormalization where
  factor := 1
  factor_pos := by norm_num

@[simp]
theorem normalization_factor : normalization.factor = 1 :=
  rfl

/-- A one-mode diagonal spectral series.  Its coefficient is one and its
spectral parameter is zero, so its single term is the positive central value of
the common smooth Fourier-positive test. -/
noncomputable def discreteSeries :
    Section54CorollaryRepair.DiscreteSpectralSeries spectralData where
  Mode := Fin 1
  spectralParameter := fun _ => 0
  coefficient := fun _ _ => 1
  summable_series := by
    intro m
    exact Summable.of_finite

/-- Exact value of the sole discrete term before summation. -/
@[simp]
theorem discreteSeries_term (m : ℕ) :
    discreteSeries.term (0 : Fin 1) m = spectralData.test 0 := by
  simp [Section54CorollaryRepair.DiscreteSpectralSeries.term,
    discreteSeries]

/-- The selected discrete term is genuinely positive; the verification model
therefore does not obtain Corollary 3.3 by setting the discrete spectrum to
zero. -/
theorem discreteSeries_term_pos (m : ℕ) :
    0 < discreteSeries.term (0 : Fin 1) m := by
  rw [discreteSeries_term]
  simpa only [spectralData, smoothVolumeUnitData_test] using
    (KuznetsovInterface.fourierPositiveSmoothTentFunction_pos_zero
      1 (by norm_num))

/-- Positivity of the whole convergent discrete series follows from the actual
selected-mode inequality, rather than from a stored conclusion-shaped field. -/
theorem discreteSeries_contribution_pos (m : ℕ) :
    0 < discreteSeries.contribution m := by
  classical
  exact (discreteSeries_term_pos m).trans_le
    (discreteSeries.term_le_contribution (0 : Fin 1) m)

/-- A fully closed series-valued spectral/geometric identity.  The diagonal
main term is the convergent one-mode series and the off-diagonal verification
term is the already constructed continuous mass.  Both sides are consequently
the same explicit sum. -/
noncomputable def seriesIdentity :
    Section54CorollaryRepair.SeriesKuznetsovSpectralIdentity
      spectralData normalization where
  discreteSeries := discreteSeries
  rawContinuous := fun m => massFunctional spectralData m
  rawDiagonalMain := fun m => discreteSeries.contribution m
  rawOffDiagonal := fun m => massFunctional spectralData m
  spectralSide := fun m =>
    discreteSeries.contribution m + massFunctional spectralData m
  geometricSide := fun m =>
    discreteSeries.contribution m + massFunctional spectralData m
  rawDiagonalMain_nonneg := by
    intro m
    exact discreteSeries.contribution_nonneg m
  continuous_identification := by
    intro m
    simp only [normalization_factor, one_mul]
  spectral_decomposition := by
    intro m
    simp only [normalization_factor, one_mul]
  geometric_decomposition := by
    intro m
    simp only [normalization_factor, one_mul]
  trace_identity := by
    intro m
    rfl

/-- The ordinary proof-carrying identity obtained from the stronger
series-valued certificate. -/
noncomputable def identity :
    Section54CorollaryRepair.KuznetsovSpectralIdentity
      spectralData normalization :=
  seriesIdentity.toKuznetsovSpectralIdentity

/-- The normalized discrete part of the closed identity is strictly positive
at every arithmetic index. -/
theorem normalizedDiscrete_pos (m : ℕ) :
    0 < identity.normalizedDiscrete m := by
  change 0 < normalization.factor * discreteSeries.contribution m
  simpa only [normalization_factor, one_mul] using
    discreteSeries_contribution_pos m

/-- The selected positive mode plus the continuous mass is bounded by the
closed spectral side.  This is the nontrivial one-mode form of (3.9). -/
theorem selectedMode_add_mass_le_spectralSide (m : ℕ) :
    spectralData.test 0 + massFunctional spectralData m ≤
      seriesIdentity.spectralSide m := by
  classical
  have h := seriesIdentity.selectedMode_add_mass_le_spectralSide
    (0 : Fin 1) m
  have hterm :
      seriesIdentity.discreteSeries.term (0 : Fin 1) m =
        spectralData.test 0 := by
    change discreteSeries.term (0 : Fin 1) m = spectralData.test 0
    exact discreteSeries_term m
  rw [hterm, normalization_factor, one_mul] at h
  exact h

/-- **Closed corrected Corollary 3.3.**  No spectral datum, normalization, mass
condition, or trace identity remains as an input: all are the concrete objects
constructed above. -/
theorem corollary33_conclusion :
    ∀ m, 1 ≤ m →
      massFunctional spectralData 0 ≤ massFunctional spectralData m ∧
      massFunctional spectralData m ≤ identity.spectralSide m ∧
      identity.spectralSide m = identity.geometricSide m ∧
      identity.geometricSide m =
        identity.normalizedDiagonalMain m +
          identity.normalizedOffDiagonal m :=
  Section54CorollaryRepair.corollary33_insertionIntoNormalizedSpectralSum
    massCondition identity

/-- Nonvacuity-strengthened closed conclusion: the same Corollary 3.3 chain is
accompanied by strict positivity of its normalized discrete contribution. -/
theorem corollary33_nontrivial_conclusion :
    ∀ m, 1 ≤ m →
      0 < massFunctional spectralData 0 ∧
      0 < identity.normalizedDiscrete m ∧
      massFunctional spectralData 0 ≤ massFunctional spectralData m ∧
      massFunctional spectralData m ≤ identity.spectralSide m ∧
      identity.spectralSide m = identity.geometricSide m ∧
      identity.geometricSide m =
        identity.normalizedDiagonalMain m +
          identity.normalizedOffDiagonal m := by
  intro m hm
  exact ⟨continuousMassFloor_pos, normalizedDiscrete_pos m,
    corollary33_conclusion m hm⟩

end Corollary33VerificationModel

end AnalyticP2P7Completion

/-! ### Propositions 8--14: growth, compactness, dictionaries, and transport -/

namespace LowerGrowth

/-- A finite mean-square lower bound has an actual pointwise witness.  The
normalizing factor is written in cross-multiplied form, avoiding division by a
possibly empty block. -/
theorem exists_pointwise_of_meanSquareBlock
    {α : Type*} (s : Finset α) (hs : s.Nonempty)
    (energy : α → ℝ) (L : ℝ)
    (hmean : L * (s.card : ℝ) ≤ ∑ i ∈ s, energy i) :
    ∃ i ∈ s, L ≤ energy i := by
  classical
  by_contra hnone
  have hlt : ∀ i ∈ s, energy i < L := by
    intro i hi
    exact lt_of_not_ge (fun hLi => hnone ⟨i, hi, hLi⟩)
  have hsum : (∑ i ∈ s, energy i) < ∑ _i ∈ s, L := by
    apply Finset.sum_lt_sum
    · intro i hi
      exact (hlt i hi).le
    · rcases hs with ⟨i, hi⟩
      exact ⟨i, hi, hlt i hi⟩
  have hconst : (∑ _i ∈ s, L) = (s.card : ℝ) * L := by
    simp
  rw [hconst] at hsum
  exact (not_lt_of_ge hmean) (by simpa [mul_comm] using hsum)

/-- Mean-square activity on pairwise disjoint nonempty blocks yields an
injective sequence of genuinely active indices.  This is the precise
average-to-pointwise extraction missing from the paper. -/
theorem exists_injective_pointwiseMeanSquareSelection
    (blocks : ℕ → Finset ℕ)
    (hne : ∀ k, (blocks k).Nonempty)
    (hdisjoint : Set.Pairwise Set.univ fun i j =>
      Disjoint (blocks i) (blocks j))
    (coefficient floor : ℕ → ℝ)
    (hmean : ∀ k : ℕ,
      floor k * ((blocks k).card : ℝ) ≤
        ∑ m ∈ blocks k, coefficient m ^ 2) :
    ∃ g : ℕ → ℕ,
      Function.Injective g ∧
        ∀ k, g k ∈ blocks k ∧
          floor k ≤ coefficient (g k) ^ 2 := by
  classical
  have hwitness : ∀ k, ∃ m ∈ blocks k,
      floor k ≤ coefficient m ^ 2 := fun k =>
    exists_pointwise_of_meanSquareBlock
      (blocks k) (hne k) (fun m => coefficient m ^ 2) (floor k) (hmean k)
  choose g hgmem hglower using hwitness
  refine ⟨g, ?_, fun k => ⟨hgmem k, hglower k⟩⟩
  intro i j hij
  by_contra hneij
  have hblocks : Disjoint (blocks i) (blocks j) :=
    hdisjoint (Set.mem_univ i) (Set.mem_univ j) hneij
  have hgj : g i ∈ blocks j := by
    rw [hij]
    exact hgmem j
  exact (Finset.disjoint_left.mp hblocks) (hgmem i) hgj

/-- Power-shaped mean-square growth gives an injective sequence whose selected
coefficients satisfy that same explicit power lower profile. -/
theorem exists_injective_powerLowerSelection
    (blocks : ℕ → Finset ℕ)
    (hne : ∀ k, (blocks k).Nonempty)
    (hdisjoint : Set.Pairwise Set.univ fun i j =>
      Disjoint (blocks i) (blocks j))
    (coefficient : ℕ → ℝ) (A a : ℝ)
    (hmean : ∀ k : ℕ,
      (A * (k : ℝ) ^ a) * ((blocks k).card : ℝ) ≤
        ∑ m ∈ blocks k, coefficient m ^ 2) :
    ∃ g : ℕ → ℕ,
      Function.Injective g ∧
        ∀ k, g k ∈ blocks k ∧
          A * (k : ℝ) ^ a ≤ coefficient (g k) ^ 2 :=
  exists_injective_pointwiseMeanSquareSelection blocks hne hdisjoint
    coefficient (fun k => A * (k : ℝ) ^ a) hmean

/-- If the disjoint blocks are linearly localized, the extracted active indices
inherit an explicit two-sided linear bound in addition to the power lower
profile.  Thus the selected index map has the advertised `Θ(k)` shape, up to
the displayed additive constant. -/
theorem exists_injective_powerLowerSelection_withLinearIndexBounds
    (blocks : ℕ → Finset ℕ)
    (hne : ∀ k, (blocks k).Nonempty)
    (hdisjoint : Set.Pairwise Set.univ fun i j =>
      Disjoint (blocks i) (blocks j))
    (coefficient : ℕ → ℝ) (A a : ℝ) (C D : ℕ)
    (hindex : ∀ (k m : ℕ), m ∈ blocks k →
      k ≤ m ∧ m ≤ C * k + D)
    (hmean : ∀ k : ℕ,
      (A * (k : ℝ) ^ a) * ((blocks k).card : ℝ) ≤
        ∑ m ∈ blocks k, coefficient m ^ 2) :
    ∃ g : ℕ → ℕ,
      Function.Injective g ∧
        ∀ k,
          g k ∈ blocks k ∧
          k ≤ g k ∧
          g k ≤ C * k + D ∧
          A * (k : ℝ) ^ a ≤ coefficient (g k) ^ 2 := by
  rcases exists_injective_powerLowerSelection
      blocks hne hdisjoint coefficient A a hmean with
    ⟨g, hginjective, hg⟩
  refine ⟨g, hginjective, ?_⟩
  intro k
  rcases hg k with ⟨hgmem, hglower⟩
  rcases hindex k (g k) hgmem with ⟨hgindexLower, hgindexUpper⟩
  exact ⟨hgmem, hgindexLower, hgindexUpper, hglower⟩

/-- Absorb the additive localization error once `k ≥ 1`. -/
theorem linearIndexUpper_absorbAdditiveConstant
    (g : ℕ → ℕ) (C D k : ℕ) (hk : 1 ≤ k)
    (hupper : g k ≤ C * k + D) :
    g k ≤ (C + D) * k := by
  have hD : D ≤ D * k := by
    simpa using Nat.mul_le_mul_left D hk
  calc
    g k ≤ C * k + D := hupper
    _ ≤ C * k + D * k := Nat.add_le_add_left hD _
    _ = (C + D) * k := (Nat.add_mul C D k).symm

/-- The literal `g(k) = Θ(k)` conclusion for the real casts of the selected
indices. -/
theorem linearIndexBounds_isTheta
    (g : ℕ → ℕ) (C D : ℕ)
    (hlower : ∀ k : ℕ, k ≤ g k)
    (hupper : ∀ k : ℕ, g k ≤ C * k + D) :
    Asymptotics.IsTheta Filter.atTop
      (fun k : ℕ => (g k : ℝ)) (fun k : ℕ => (k : ℝ)) := by
  refine Asymptotics.IsBigO.antisymm ?_ ?_
  · refine Asymptotics.IsBigO.of_bound (((C + D : ℕ) : ℝ)) ?_
    rw [Filter.eventually_atTop]
    refine ⟨1, ?_⟩
    intro k hk
    have hNat : g k ≤ (C + D) * k :=
      linearIndexUpper_absorbAdditiveConstant g C D k hk (hupper k)
    have hReal : (g k : ℝ) ≤ (((C + D) * k : ℕ) : ℝ) := by
      exact_mod_cast hNat
    simpa only [norm_natCast, Nat.cast_mul] using hReal
  · refine Asymptotics.IsBigO.of_bound 1
      (Filter.Eventually.of_forall fun k => ?_)
    have hReal : (k : ℝ) ≤ (g k : ℝ) := by
      exact_mod_cast hlower k
    simpa only [norm_natCast, one_mul] using hReal

/-- Transfer the extracted `k`-power lower bound to the selected index `g k`.
The normalization loss is the explicit factor `(C+D)^a`. -/
theorem reindexedPowerLower_eventually
    (g : ℕ → ℕ) (coefficient : ℕ → ℝ)
    (A a : ℝ) (C D : ℕ)
    (hA : 0 ≤ A) (ha : 0 ≤ a) (hCD : 0 < C + D)
    (hupper : ∀ k : ℕ, g k ≤ C * k + D)
    (hlower : ∀ k : ℕ,
      A * (k : ℝ) ^ a ≤ coefficient (g k) ^ 2) :
    ∀ᶠ k in Filter.atTop,
      (A / (((C + D : ℕ) : ℝ) ^ a)) * ((g k : ℝ) ^ a) ≤
        coefficient (g k) ^ 2 := by
  have hKpos : 0 < ((C + D : ℕ) : ℝ) := by
    exact_mod_cast hCD
  rw [Filter.eventually_atTop]
  refine ⟨1, ?_⟩
  intro k hk
  have hNat : g k ≤ (C + D) * k :=
    linearIndexUpper_absorbAdditiveConstant g C D k hk (hupper k)
  have hReal : (g k : ℝ) ≤ ((C + D : ℕ) : ℝ) * (k : ℝ) := by
    exact_mod_cast hNat
  have hquot :
      (g k : ℝ) / ((C + D : ℕ) : ℝ) ≤ (k : ℝ) := by
    apply (div_le_iff₀ hKpos).2
    simpa only [mul_comm] using hReal
  have hquot_nonneg :
      0 ≤ (g k : ℝ) / ((C + D : ℕ) : ℝ) :=
    div_nonneg (Nat.cast_nonneg _) hKpos.le
  have hpow := Real.rpow_le_rpow hquot_nonneg hquot ha
  have hnormalized :
      A * (((g k : ℝ) / ((C + D : ℕ) : ℝ)) ^ a) ≤
        coefficient (g k) ^ 2 :=
    (mul_le_mul_of_nonneg_left hpow hA).trans (hlower k)
  calc
    (A / (((C + D : ℕ) : ℝ) ^ a)) * ((g k : ℝ) ^ a) =
        A * (((g k : ℝ) ^ a) / (((C + D : ℕ) : ℝ) ^ a)) := by
      ring
    _ = A * (((g k : ℝ) / ((C + D : ℕ) : ℝ)) ^ a) := by
      rw [Real.div_rpow (Nat.cast_nonneg _) hKpos.le a]
    _ ≤ coefficient (g k) ^ 2 := hnormalized

/-- Nonempty linearly localized blocks force a positive multiplicative
localization constant. -/
theorem linearLocalizationConstant_pos
    (blocks : ℕ → Finset ℕ) (hne : ∀ k, (blocks k).Nonempty)
    (C D : ℕ)
    (hindex : ∀ (k m : ℕ), m ∈ blocks k →
      k ≤ m ∧ m ≤ C * k + D) :
    0 < C + D := by
  rcases hne 1 with ⟨m, hm⟩
  have hb := hindex 1 m hm
  have hone : 1 ≤ C + D := by
    simpa using hb.1.trans hb.2
  exact lt_of_lt_of_le Nat.zero_lt_one hone

/-- **Full repaired Proposition 8.** Mean-square extraction gives an injective
selection, literal `g(k)=Θ(k)`, the original `k`-power lower profile, and a
strictly positive lower profile reindexed by `g(k)`. -/
theorem exists_injective_powerLowerSelection_withAsymptotics
    (blocks : ℕ → Finset ℕ)
    (hne : ∀ k, (blocks k).Nonempty)
    (hdisjoint : Set.Pairwise Set.univ fun i j =>
      Disjoint (blocks i) (blocks j))
    (coefficient : ℕ → ℝ) (A a : ℝ) (C D : ℕ)
    (hA : 0 < A) (ha : 0 ≤ a)
    (hindex : ∀ (k m : ℕ), m ∈ blocks k →
      k ≤ m ∧ m ≤ C * k + D)
    (hmean : ∀ k : ℕ,
      (A * (k : ℝ) ^ a) * ((blocks k).card : ℝ) ≤
        ∑ m ∈ blocks k, coefficient m ^ 2) :
    ∃ g : ℕ → ℕ,
      Function.Injective g ∧
      Asymptotics.IsTheta Filter.atTop
        (fun k : ℕ => (g k : ℝ)) (fun k : ℕ => (k : ℝ)) ∧
      (∀ k,
        g k ∈ blocks k ∧ k ≤ g k ∧ g k ≤ C * k + D ∧
          A * (k : ℝ) ^ a ≤ coefficient (g k) ^ 2) ∧
      ∃ B : ℝ, 0 < B ∧
        ∀ᶠ k in Filter.atTop,
          B * ((g k : ℝ) ^ a) ≤ coefficient (g k) ^ 2 := by
  have hCD : 0 < C + D :=
    linearLocalizationConstant_pos blocks hne C D hindex
  rcases exists_injective_powerLowerSelection_withLinearIndexBounds
      blocks hne hdisjoint coefficient A a C D hindex hmean with
    ⟨g, hginjective, hg⟩
  have htheta :
      Asymptotics.IsTheta Filter.atTop
        (fun k : ℕ => (g k : ℝ)) (fun k : ℕ => (k : ℝ)) :=
    linearIndexBounds_isTheta g C D
      (fun k => (hg k).2.1) (fun k => (hg k).2.2.1)
  let B : ℝ := A / (((C + D : ℕ) : ℝ) ^ a)
  have hKpos : 0 < ((C + D : ℕ) : ℝ) := by
    exact_mod_cast hCD
  have hB : 0 < B := by
    dsimp [B]
    exact div_pos hA (Real.rpow_pos_of_pos hKpos a)
  refine ⟨g, hginjective, htheta, hg, B, hB, ?_⟩
  dsimp [B]
  exact reindexedPowerLower_eventually g coefficient A a C D
    hA.le ha hCD (fun k => (hg k).2.2.1)
      (fun k => (hg k).2.2.2)

/-- A valid pointwise lower-growth theorem.  Every quantitative input that the
PDF attempted to extract from an average is explicit in the statement. -/
theorem pointwiseLowerGrowth
    (spectral error coefficient growth : ℕ → ℝ)
    (testValue coefficientFloor testFloor ε : ℝ)
    (hcoefficientFloor : 0 ≤ coefficientFloor)
    (htestFloor : 0 ≤ testFloor)
    (htest : testFloor ≤ testValue)
    (hgrowth : ∀ m, 0 ≤ growth m)
    (hdecomp : ∀ m,
      spectral m = testValue * coefficient m ^ 2 + error m)
    (hmass : ∀ m, ε ≤ error m)
    {active : Set ℕ}
    (hcoefficient : ∀ m ∈ active,
      coefficientFloor * growth m ≤ coefficient m ^ 2) :
    ∀ m ∈ active,
      testFloor * coefficientFloor * growth m + ε ≤ spectral m := by
  intro m hm
  have hcg : 0 ≤ coefficientFloor * growth m :=
    mul_nonneg hcoefficientFloor (hgrowth m)
  have htestValue : 0 ≤ testValue := htestFloor.trans htest
  calc
    testFloor * coefficientFloor * growth m + ε =
        testFloor * (coefficientFloor * growth m) + ε := by ring
    _ ≤ testValue * (coefficientFloor * growth m) + ε := by
      nlinarith [mul_le_mul_of_nonneg_right htest hcg]
    _ ≤ testValue * coefficient m ^ 2 + ε := by
      simpa only [add_comm] using
        (add_le_add_right
          (mul_le_mul_of_nonneg_left (hcoefficient m hm) htestValue) ε)
    _ ≤ testValue * coefficient m ^ 2 + error m := by
      nlinarith [hmass m]
    _ = spectral m := (hdecomp m).symm

/-- Positive activity may have finite support; it cannot be upgraded to
infinitely many active dyadic blocks. -/
theorem positiveActivity_not_infinite :
    let a : ℕ → ℝ := fun n => if n = 0 then 1 else 0
    (∃ n, 0 < a n) ∧ ¬ Set.Infinite {n | 0 < a n} := by
  dsimp
  refine ⟨⟨0, by norm_num⟩, ?_⟩
  have hset :
      {n : ℕ | 0 < (if n = 0 then (1 : ℝ) else 0)} = {0} := by
    ext n
    by_cases hn : n = 0 <;> simp [hn]
  rw [hset]
  simp

end LowerGrowth

namespace StepThree

/-- Once genuine lower and upper bounds have been proved, the trace-formula
comparison gives the desired contradiction. -/
theorem comparisonContradiction
    {spectral geometric lower upper : ℝ}
    (htrace : |spectral| = |geometric|)
    (hgeometric : |geometric| ≤ upper)
    (hdominates : upper < lower)
    (hlower : lower ≤ spectral) : False := by
  have hle : lower ≤ upper := calc
    lower ≤ spectral := hlower
    _ ≤ |spectral| := le_abs_self spectral
    _ = |geometric| := htrace
    _ ≤ upper := hgeometric
  exact (not_le_of_gt hdominates) hle

/-- The exponent gap itself supplies the domination step on any infinite active
set; it is not accepted as a separate premise.  This is the corrected abstract
Step-3 theorem. -/
theorem noTraceComparison_of_infinite_powerGap
    (active : Set ℕ) (hinfinite : active.Infinite)
    (spectral geometric : ℕ → ℝ) {A B a b : ℝ}
    (hA : 0 < A) (hB : 0 ≤ B) (hab : b < a)
    (htrace : ∀ m ∈ active, |spectral m| = |geometric m|)
    (hupper : ∀ m ∈ active,
      |geometric m| ≤ B * (m : ℝ) ^ b)
    (hlower : ∀ m ∈ active,
      A * (m : ℝ) ^ a ≤ spectral m) : False := by
  have hdom := SpectralMassGap.nat_rpow_eventually_dominates hA hB hab
  rw [Filter.eventually_atTop] at hdom
  obtain ⟨N, hN⟩ := hdom
  obtain ⟨m, hm, hNm⟩ := hinfinite.exists_gt N
  exact comparisonContradiction
    (htrace m hm) (hupper m hm) (hN m hNm.le) (hlower m hm)

end StepThree

namespace JacobiDictionary

/-- An additive splitting is not canonical without a specified projection or
polar-part construction. -/
theorem additiveSplitting_not_unique :
    ∃ finite₁ polar₁ finite₂ polar₂ : ℂ,
      (0 : ℂ) = finite₁ + polar₁ ∧
      0 = finite₂ + polar₂ ∧
      (finite₁, polar₁) ≠ (finite₂, polar₂) := by
  refine ⟨0, 0, 1, -1, by ring, by ring, ?_⟩
  norm_num

/-- Two outside partners satisfying the same actual dictionary on the same set
are equal there.  This is uniqueness, not an existence construction. -/
theorem outsideDictionary_uniqueOn
    {Ω : Type*} (U : Set Ω) (outside₁ outside₂ prototype correction : Ω → ℂ)
    (h₁ : ∀ q ∈ U,
      outside₁ q = 2 * prototype q - correction q)
    (h₂ : ∀ q ∈ U,
      outside₂ q = 2 * prototype q - correction q) :
    Set.EqOn outside₁ outside₂ U := by
  intro q hq
  exact (h₁ q hq).trans (h₂ q hq).symm

/-- Defining the prototype as half of `outside + correction` makes the displayed
dictionary tautological; the identity alone supplies no analytic continuation. -/
theorem tautologicalDictionary
    {Ω : Type*} (outside correction : Ω → ℂ) (q : Ω) :
    outside q =
      2 * ((outside q + correction q) / 2) - correction q := by
  ring

/-! A genuinely canonical finite/polar splitting needs extra structure.  An
idempotent projection is the minimal algebraic datum that makes both parts and
their uniqueness theorem determined rather than chosen post hoc. -/

/-- A specified idempotent linear projection selecting the finite part. -/
structure SplitProjection
    (R J : Type*) [CommRing R] [AddCommGroup J] [Module R J] where
  toLinearMap : J →ₗ[R] J
  idempotent : toLinearMap.comp toLinearMap = toLinearMap

namespace SplitProjection

variable {R J : Type*} [CommRing R] [AddCommGroup J] [Module R J]

/-- The finite part selected by the projection. -/
def finitePart (P : SplitProjection R J) (φ : J) : J :=
  P.toLinearMap φ

/-- The complementary polar part. -/
def polarPart (P : SplitProjection R J) (φ : J) : J :=
  φ - P.finitePart φ

@[simp]
theorem finitePart_add_polarPart (P : SplitProjection R J) (φ : J) :
    P.finitePart φ + P.polarPart φ = φ := by
  simp [finitePart, polarPart]

@[simp]
theorem finitePart_fixed (P : SplitProjection R J) (φ : J) :
    P.finitePart (P.finitePart φ) = P.finitePart φ := by
  exact LinearMap.congr_fun P.idempotent φ

@[simp]
theorem finitePart_polarPart (P : SplitProjection R J) (φ : J) :
    P.finitePart (P.polarPart φ) = 0 := by
  change P.toLinearMap (φ - P.toLinearMap φ) = 0
  rw [map_sub]
  have hidem := LinearMap.congr_fun P.idempotent φ
  change P.toLinearMap (P.toLinearMap φ) = P.toLinearMap φ at hidem
  rw [hidem, sub_self]

theorem polarPart_mem_ker (P : SplitProjection R J) (φ : J) :
    P.polarPart φ ∈ LinearMap.ker P.toLinearMap := by
  change P.toLinearMap (P.polarPart φ) = 0
  exact P.finitePart_polarPart φ

/-- The selected decomposition is the unique decomposition whose finite term is
fixed by the projector and whose polar term belongs to its kernel. -/
theorem decomposition_unique
    (P : SplitProjection R J) (φ finite polar : J)
    (hsum : finite + polar = φ)
    (hfinite : P.finitePart finite = finite)
    (hpolar : P.finitePart polar = 0) :
    finite = P.finitePart φ ∧ polar = P.polarPart φ := by
  have hselected : P.finitePart φ = finite := by
    change P.toLinearMap φ = finite
    change P.toLinearMap finite = finite at hfinite
    change P.toLinearMap polar = 0 at hpolar
    rw [← hsum, map_add, hfinite, hpolar, add_zero]
  constructor
  · exact hselected.symm
  · rw [polarPart, hselected]
    exact (eq_sub_iff_add_eq).2 (by simpa [add_comm] using hsum)

/-- Explicit product model: the first summand is finite and the second is
polar.  This is a concrete unconditional inhabitant of the repaired splitting
interface. -/
def product
    {A B : Type*}
    [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] :
    SplitProjection R (A × B) where
  toLinearMap :=
    { toFun := fun x => (x.1, 0)
      map_add' := by
        intro x y
        simp
      map_smul' := by
        intro c x
        simp }
  idempotent := by
    apply LinearMap.ext
    intro x
    rfl

@[simp]
theorem product_finitePart
    {A B : Type*}
    [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B]
    (a : A) (b : B) :
    (product (R := R)).finitePart (a, b) = (a, 0) :=
  rfl

@[simp]
theorem product_polarPart
    {A B : Type*}
    [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B]
    (a : A) (b : B) :
    (product (R := R)).polarPart (a, b) = (0, b) := by
  simp [polarPart]

/-- In the explicit product model both requested components are recovered by
the same canonical projection/complement operation. -/
theorem product_recovers_both_components
    {A B : Type*}
    [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B]
    (a : A) (b : B) :
    (product (R := R)).finitePart (a, b) = (a, 0) ∧
      (product (R := R)).polarPart (a, b) = (0, b) := by
  simp

end SplitProjection

end JacobiDictionary

namespace RademacherControl

/-- The damping inequality used in the PDF is false. -/
def CitedDampingInequality : Prop :=
  ∀ n N : ℕ, 0 < n → n ≤ N →
    Real.sqrt (n : ℝ) ≤ (n : ℝ) / Real.sqrt (N : ℝ)

theorem not_CitedDampingInequality :
    ¬ CitedDampingInequality := by
  intro h
  have hbad := h 1 4 (by norm_num) (by norm_num)
  have hsqrt4 : Real.sqrt (((4 : ℕ) : ℝ)) = 2 := by
    calc
      Real.sqrt (((4 : ℕ) : ℝ)) = Real.sqrt ((2 : ℝ) ^ 2) := by norm_num
      _ = |(2 : ℝ)| := Real.sqrt_sq_eq_abs 2
      _ = 2 := abs_of_nonneg (by norm_num)
  rw [hsqrt4] at hbad
  norm_num at hbad

/-- The exact inequality has the opposite direction from the one printed in
the PDF: if `0 < n ≤ N`, then `n / sqrt N ≤ sqrt n`. -/
theorem correctedDampingInequality
    (n N : ℕ) (hn : 0 < n) (hnN : n ≤ N) :
    (n : ℝ) / Real.sqrt (N : ℝ) ≤ Real.sqrt (n : ℝ) := by
  have hN : 0 < N := lt_of_lt_of_le hn hnN
  have hNcast : 0 < (N : ℝ) := by exact_mod_cast hN
  apply (div_le_iff₀ (Real.sqrt_pos.2 hNcast)).2
  have hn0 : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
  have hsqrt : Real.sqrt (n : ℝ) ≤ Real.sqrt (N : ℝ) := by
    apply Real.sqrt_le_sqrt
    exact_mod_cast hnN
  calc
    (n : ℝ) = Real.sqrt (n : ℝ) * Real.sqrt (n : ℝ) :=
      (Real.mul_self_sqrt hn0).symm
    _ ≤ Real.sqrt (n : ℝ) * Real.sqrt (N : ℝ) :=
      mul_le_mul_of_nonneg_left hsqrt (Real.sqrt_nonneg _)

/-- Consequently the damping contribution supplies a lower comparison for the
printed exponent, not the upper comparison used in the PDF. -/
theorem correctedDampingExponentDirection
    (A r : ℝ) (hr : 0 ≤ r) (n N : ℕ) (hn : 0 < n) (hnN : n ≤ N) :
    A * Real.sqrt (n : ℝ) - r * Real.sqrt (n : ℝ) ≤
      A * Real.sqrt (n : ℝ) - r * ((n : ℝ) / Real.sqrt (N : ℝ)) := by
  have hmul :
      r * ((n : ℝ) / Real.sqrt (N : ℝ)) ≤
        r * Real.sqrt (n : ℝ) :=
    mul_le_mul_of_nonneg_left (correctedDampingInequality n N hn hnN) hr
  exact sub_le_sub_left hmul _

/-- Nonnegative summable coefficient energies uniformly bound every finite
Rademacher partial energy. -/
theorem partialEnergy_le_total
    (a : ℕ → ℝ) (ha : ∀ n, 0 ≤ a n)
    (hs : Summable a) (N : ℕ) :
    (∑ n ∈ Finset.range (N + 1), a n) ≤ ∑' n, a n :=
  hs.sum_le_tsum (Finset.range (N + 1)) (fun n _ => ha n)

/-- A summable nonnegative scalar majorant gives a uniform graph-norm bound for
every finite Rademacher partial sum. -/
theorem norm_partialSum_le_totalMajorant
    {H : Type*} [NormedAddCommGroup H]
    (term : ℕ → H) (majorant : ℕ → ℝ)
    (hmajorant : Summable majorant)
    (hmajorant_nonneg : ∀ n, 0 ≤ majorant n)
    (hterm : ∀ n, ‖term n‖ ≤ majorant n)
    (N : ℕ) :
    ‖∑ n ∈ Finset.range N, term n‖ ≤ ∑' n, majorant n := by
  calc
    ‖∑ n ∈ Finset.range N, term n‖
        ≤ ∑ n ∈ Finset.range N, ‖term n‖ := norm_sum_le _ _
    _ ≤ ∑ n ∈ Finset.range N, majorant n :=
      Finset.sum_le_sum (fun n _ => hterm n)
    _ ≤ ∑' n, majorant n :=
      hmajorant.sum_le_tsum (Finset.range N)
        (fun n _ => hmajorant_nonneg n)

/-- The majorant also supplies actual convergence in the ambient Banach space;
this is the corrected analytic content needed before any compactness claim. -/
theorem summable_of_summable_normMajorant
    {H : Type*} [NormedAddCommGroup H] [CompleteSpace H]
    (term : ℕ → H) (majorant : ℕ → ℝ)
    (hmajorant : Summable majorant)
    (hterm : ∀ n, ‖term n‖ ≤ majorant n) :
    Summable term :=
  hmajorant.of_norm_bounded hterm

/-- If every Rademacher term lies in the smooth automorphic core, then the
absolutely convergent series lies in the closed weighted Sobolev completion.
Thus automorphy is preserved almost everywhere by the completion theorem. -/
theorem rademacherSeries_mem_weightedAutomorphicSobolev
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H)
    (term : ℕ → H)
    (hterm_core : ∀ n, term n ∈ M.core)
    (hterm_summable : Summable term) :
    (∑' n, term n) ∈ weightedAutomorphicSobolev M := by
  apply M.core.isClosed_topologicalClosure.mem_of_tendsto
    hterm_summable.hasSum.tendsto_sum_nat
  exact Filter.Eventually.of_forall (fun N =>
    M.core.le_topologicalClosure
      (M.core.sum_mem (fun n _ => hterm_core n)))

/-- Fully assembled corrected Rademacher-tail conclusion from one scalar
majorant: convergence, membership in the weighted Sobolev space, and the
almost-everywhere half-weight automorphy law. -/
theorem rademacherSeries_converges_in_H1_and_isAEAutomorphic
    {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (M : WeightedSobolevDatum J μ H)
    (term : ℕ → H) (majorant : ℕ → ℝ)
    (hterm_core : ∀ n, term n ∈ M.core)
    (hmajorant : Summable majorant)
    (hterm : ∀ n, ‖term n‖ ≤ majorant n) :
    ∃ u : weightedAutomorphicSobolev M,
      (u : H) = ∑' n, term n ∧
      IsAEAutomorphic J μ (M.toFunction (u : H)) := by
  have hs : Summable term :=
    summable_of_summable_normMajorant term majorant hmajorant hterm
  let u : weightedAutomorphicSobolev M :=
    ⟨∑' n, term n,
      rademacherSeries_mem_weightedAutomorphicSobolev M term hterm_core hs⟩
  exact ⟨u, rfl, weightedAutomorphicSobolev_ae M u⟩

/-- A uniformly bounded sequence becomes relatively compact in a weaker target
whenever the embedding into that target is a compact operator.  This is the
abstract Rellich-shaped replacement for the false `H¹` precompactness claim. -/
theorem strongCompactness_of_compactEmbedding
    {H L : Type*}
    [NormedAddCommGroup H] [NormedSpace ℂ H]
    [NormedAddCommGroup L] [NormedSpace ℂ L]
    (embedding : H →L[ℂ] L) (hcompact : IsCompactOperator embedding)
    (tail : ℕ → H) {C : ℝ} (hbound : ∀ n, ‖tail n‖ ≤ C) :
    IsCompact (closure (Set.range fun n => embedding (tail n))) := by
  have hbounded : Bornology.IsBounded (Set.range tail) := by
    rw [isBounded_iff_forall_norm_le]
    exact ⟨C, by
      rintro x ⟨n, rfl⟩
      exact hbound n⟩
  have himage :
      IsCompact (closure (embedding '' Set.range tail)) :=
    IsCompactOperator.isCompact_closure_image_of_bounded
      (f := embedding.toLinearMap) hcompact hbounded
  have hrange :
      Set.range (fun n => embedding (tail n)) =
        embedding '' Set.range tail := by
    ext x
    constructor
    · rintro ⟨n, rfl⟩
      exact ⟨tail n, ⟨n, rfl⟩, rfl⟩
    · rintro ⟨y, ⟨n, rfl⟩, rfl⟩
      exact ⟨n, rfl⟩
  rw [hrange]
  exact himage

/-- A uniformly separated sequence cannot have compact closure.  Therefore a
boundedness estimate alone cannot establish strong precompactness. -/
theorem separatedSequence_not_relativelyCompact
    {E : Type*} [PseudoMetricSpace E]
    (u : ℕ → E)
    (hsep : ∀ {m n}, m ≠ n → 1 ≤ dist (u m) (u n)) :
    ¬ IsCompact (closure (Set.range u)) := by
  intro hcompact
  have hmem : ∀ n, u n ∈ closure (Set.range u) :=
    fun n => subset_closure ⟨n, rfl⟩
  rcases hcompact.tendsto_subseq hmem with
    ⟨x, hx, φ, hφ, hlim⟩
  have hcauchy : CauchySeq (u ∘ φ) := hlim.cauchySeq
  rcases (Metric.cauchySeq_iff.1 hcauchy 1 zero_lt_one) with
    ⟨N, hN⟩
  have hdist := hN N le_rfl (N + 1) (Nat.le_succ N)
  have hne : φ N ≠ φ (N + 1) :=
    hφ.injective.ne (Nat.ne_of_lt (Nat.lt_succ_self N))
  exact (not_lt_of_ge (hsep hne)) hdist

end RademacherControl

/-! ### Corrected fixed-cusp-height summability

The height `C₁ / √N` used in (4.19)--(4.23) does not give the displayed
uniform damping: for `n ≤ N` the cited comparison between `n / √N` and `√n`
has the opposite direction.  At a fixed positive cusp height the correct
majorant has a genuinely linear negative exponent.  The elementary absorption
estimate below turns every `exp (A * √n - r * n)` into a constant multiple of
`exp (-(r / 2) * n)`, to which Mathlib's polynomially weighted exponential
summability theorem applies directly. -/

namespace FixedCuspHeightRademacher

/-- The explicit Young-inequality constant used to absorb square-root growth
into half of a positive linear damping term. -/
def sqrtAbsorptionConstant (A r : ℝ) : ℝ :=
  A ^ 2 / (2 * r)

/-- Quantitative square-root absorption.  This is the corrected elementary
inequality needed at a fixed cusp height. -/
theorem sqrtGrowth_le_halfLinear_add_constant
    (A : ℝ) {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    A * Real.sqrt x ≤
      (r / 2) * x + sqrtAbsorptionConstant A r := by
  have hsqrt_sq : (Real.sqrt x) ^ 2 = x := Real.sq_sqrt hx
  have htwoR : 0 < 2 * r := mul_pos (by norm_num) hr
  have hmul :
      (A * Real.sqrt x) * (2 * r) ≤ r ^ 2 * x + A ^ 2 := by
    nlinarith [sq_nonneg (r * Real.sqrt x - A), hsqrt_sq]
  have hdiv :
      A * Real.sqrt x ≤ (r ^ 2 * x + A ^ 2) / (2 * r) :=
    (le_div_iff₀ htwoR).2 hmul
  calc
    A * Real.sqrt x ≤ (r ^ 2 * x + A ^ 2) / (2 * r) := hdiv
    _ = (r / 2) * x + sqrtAbsorptionConstant A r := by
      unfold sqrtAbsorptionConstant
      field_simp [hr.ne']
      <;> ring

/-- Existence form of square-root absorption, with a nonnegative constant and
uniform quantification over the nonnegative real axis. -/
theorem exists_nonnegative_sqrtAbsorptionConstant
    (A : ℝ) {r : ℝ} (hr : 0 < r) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ x : ℝ, 0 ≤ x → A * Real.sqrt x ≤ (r / 2) * x + C := by
  refine ⟨sqrtAbsorptionConstant A r, ?_, ?_⟩
  · simpa [sqrtAbsorptionConstant] using
      div_nonneg (sq_nonneg A) (mul_nonneg (by norm_num) hr.le)
  · intro x hx
    exact sqrtGrowth_le_halfLinear_add_constant A hr hx

/-- After subtracting the full linear damping, square-root growth leaves at
most a constant plus a negative half-linear exponent. -/
theorem sqrtGrowth_sub_linear_le
    (A : ℝ) {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    A * Real.sqrt x - r * x ≤
      sqrtAbsorptionConstant A r - (r / 2) * x := by
  have h := sqrtGrowth_le_halfLinear_add_constant A hr hx
  linarith

/-- Exponential form of the fixed-height majorization. -/
theorem exp_sqrtGrowth_sub_linear_le
    (A : ℝ) {r x : ℝ} (hr : 0 < r) (hx : 0 ≤ x) :
    Real.exp (A * Real.sqrt x - r * x) ≤
      Real.exp (sqrtAbsorptionConstant A r) *
        Real.exp (-(r / 2) * x) := by
  calc
    Real.exp (A * Real.sqrt x - r * x) ≤
        Real.exp (sqrtAbsorptionConstant A r - (r / 2) * x) :=
      Real.exp_le_exp.mpr (sqrtGrowth_sub_linear_le A hr hx)
    _ = Real.exp (sqrtAbsorptionConstant A r) *
        Real.exp (-(r / 2) * x) := by
      rw [show sqrtAbsorptionConstant A r - (r / 2) * x =
          sqrtAbsorptionConstant A r + (-(r / 2) * x) by ring,
        Real.exp_add]

/-- Every fixed polynomial weight remains summable against square-root growth
and a positive linear cusp damping.  This is the reusable corrected analytic
leaf replacing the invalid variable-height comparison in (4.21). -/
theorem summable_pow_mul_exp_sqrtGrowth_sub_linear
    (A r : ℝ) (hr : 0 < r) (k : ℕ) :
    Summable (fun n : ℕ =>
      (n : ℝ) ^ k *
        Real.exp (A * Real.sqrt (n : ℝ) - r * (n : ℝ))) := by
  have hbase :
      Summable (fun n : ℕ =>
        (n : ℝ) ^ k * Real.exp (-(r / 2) * (n : ℝ))) := by
    simpa only using
      (Real.summable_pow_mul_exp_neg_nat_mul k (half_pos hr))
  have hmajor :
      Summable (fun n : ℕ =>
        Real.exp (sqrtAbsorptionConstant A r) *
          ((n : ℝ) ^ k * Real.exp (-(r / 2) * (n : ℝ)))) :=
    Summable.mul_left (Real.exp (sqrtAbsorptionConstant A r)) hbase
  refine hmajor.of_nonneg_of_le (fun _ => by positivity) ?_
  intro n
  have hexp := exp_sqrtGrowth_sub_linear_le
    (A := A) (r := r) (x := (n : ℝ)) hr (by positivity)
  calc
    (n : ℝ) ^ k *
          Real.exp (A * Real.sqrt (n : ℝ) - r * (n : ℝ)) ≤
        (n : ℝ) ^ k *
          (Real.exp (sqrtAbsorptionConstant A r) *
            Real.exp (-(r / 2) * (n : ℝ))) :=
      mul_le_mul_of_nonneg_left hexp (by positivity)
    _ = Real.exp (sqrtAbsorptionConstant A r) *
        ((n : ℝ) ^ k * Real.exp (-(r / 2) * (n : ℝ))) := by
      ring

/-- A squared first derivative contributes an additional factor `n²`; it is
still summable at every fixed positive cusp height. -/
theorem summable_firstDerivativeEnergyWeight
    (A r : ℝ) (hr : 0 < r) (k : ℕ) :
    Summable (fun n : ℕ =>
      (n : ℝ) ^ (k + 2) *
        Real.exp (A * Real.sqrt (n : ℝ) - r * (n : ℝ))) :=
  summable_pow_mul_exp_sqrtGrowth_sub_linear A r hr (k + 2)

/-- A squared second derivative contributes an additional factor `n⁴`; this
weight is likewise absorbed by fixed positive linear damping. -/
theorem summable_secondDerivativeEnergyWeight
    (A r : ℝ) (hr : 0 < r) (k : ℕ) :
    Summable (fun n : ℕ =>
      (n : ℝ) ^ (k + 4) *
        Real.exp (A * Real.sqrt (n : ℝ) - r * (n : ℝ))) :=
  summable_pow_mul_exp_sqrtGrowth_sub_linear A r hr (k + 4)

end FixedCuspHeightRademacher

namespace AnalyticContinuation

/-- Once an actual overlap and inside realization have been supplied, the
continuation field stored by `InsideOutsideMatch` is unique on that overlap. -/
theorem continuation_uniqueOnOverlap
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    (F : ℂ → ℂ)
    (hF : ∀ z ∈ M.overlap,
      D.inside.value (M.insideVariable z) = F z) :
    Set.EqOn F M.continuation M.overlap := by
  intro z hz
  exact (hF z hz).symm.trans (M.inside_eq_continuation z hz)

/-! The preceding theorem only reads a match already stored in
`InsideOutsideMatch`.  The next group supplies the missing analytic uniqueness
argument itself: both realizations are analytic on one open annulus and agree on
a subset accumulating at an interior point. -/

/-- The common open annulus on which the inside and outside realizations are
both required to be analytic. -/
def openComplexAnnulus (r R : ℝ) : Set ℂ :=
  Metric.ball 0 R \ Metric.closedBall 0 r

theorem isOpen_openComplexAnnulus (r R : ℝ) :
    IsOpen (openComplexAnnulus r R) :=
  Metric.isOpen_ball.sdiff Metric.isClosed_closedBall

/-- A centered complex annulus is preconnected.  It is represented as the
pointwise scalar product of an interval of radii and the complex unit sphere. -/
theorem isPreconnected_openComplexAnnulus
    (r R : ℝ) (hr : 0 ≤ r) :
    IsPreconnected (openComplexAnnulus r R) := by
  have hsphere :
      IsPreconnected (Metric.sphere (0 : ℂ) 1) := by
    apply isPreconnected_sphere
    simp [Complex.rank_real_complex]
  have hprod :
      IsPreconnected
        (Set.Ioo r R ×ˢ Metric.sphere (0 : ℂ) 1) :=
    isPreconnected_Ioo.prod hsphere
  have himage :
      IsPreconnected
        ((fun p : ℝ × ℂ => p.1 • p.2) ''
          (Set.Ioo r R ×ˢ Metric.sphere (0 : ℂ) 1)) :=
    hprod.image _
      (continuous_fst.smul continuous_snd).continuousOn
  have hshell :
      ((fun p : ℝ × ℂ => p.1 • p.2) ''
          (Set.Ioo r R ×ˢ Metric.sphere (0 : ℂ) 1)) =
        openComplexAnnulus r R := by
    rw [Set.image_prod]
    change
      Set.Ioo r R • Metric.sphere (0 : ℂ) 1 =
        openComplexAnnulus r R
    simpa [openComplexAnnulus] using
      (Ioo_smul_sphere_zero
        (E := ℂ) (a := r) (b := R) (r := 1) hr one_pos)
  rw [hshell] at himage
  exact himage

/-- Identity theorem on a common complex annulus.  The agreement set lies in
that annulus and has an interior accumulation point. -/
theorem analyticOn_eqOn_openComplexAnnulus_of_accumulation
    {r R : ℝ} (hr : 0 ≤ r)
    {f g : ℂ → ℂ} {Z : Set ℂ}
    (hZ : Z ⊆ openComplexAnnulus r R)
    (hf : AnalyticOn ℂ f (openComplexAnnulus r R))
    (hg : AnalyticOn ℂ g (openComplexAnnulus r R))
    {z₀ : ℂ} (hz₀ : z₀ ∈ openComplexAnnulus r R)
    (hfg : Set.EqOn f g Z)
    (hacc : z₀ ∈ closure (Z \ {z₀})) :
    Set.EqOn f g (openComplexAnnulus r R) := by
  have hf' :
      AnalyticOnNhd ℂ f (openComplexAnnulus r R) :=
    (isOpen_openComplexAnnulus r R).analyticOn_iff_analyticOnNhd.mp hf
  have hg' :
      AnalyticOnNhd ℂ g (openComplexAnnulus r R) :=
    (isOpen_openComplexAnnulus r R).analyticOn_iff_analyticOnNhd.mp hg
  have haccCommon :
      z₀ ∈ closure
        ((openComplexAnnulus r R ∩ {z | f z = g z}) \ {z₀}) := by
    exact
      (closure_mono (by
        rintro z ⟨hzZ, hzne⟩
        exact ⟨⟨hZ hzZ, hfg hzZ⟩, hzne⟩)) hacc
  have haccEq :
      z₀ ∈ closure ({z | f z = g z} \ {z₀}) := by
    exact
      (closure_mono (by
        rintro z ⟨hz, hzne⟩
        exact ⟨hz.2, hzne⟩)) haccCommon
  exact hf'.eqOn_of_preconnected_of_mem_closure hg'
    (isPreconnected_openComplexAnnulus r R hr) hz₀ haccEq

/-- A proof-carrying analytic continuation of one fixed kernel/completion. -/
structure AnnularKernelContinuation
    (kernel : ℂ → ℂ) (sample : Set ℂ) (r R : ℝ) where
  value : ℂ → ℂ
  analyticOn :
    AnalyticOn ℂ value (openComplexAnnulus r R)
  sample_subset :
    sample ⊆ openComplexAnnulus r R
  agrees_kernel :
    Set.EqOn value kernel sample

/-- Two analytic continuations produced from the same kernel on the same
accumulating sample are identical throughout the common annulus. -/
theorem AnnularKernelContinuation.eqOn_of_accumulation
    {kernel : ℂ → ℂ} {sample : Set ℂ} {r R : ℝ}
    (F G : AnnularKernelContinuation kernel sample r R)
    (hr : 0 ≤ r)
    {z₀ : ℂ} (hz₀ : z₀ ∈ openComplexAnnulus r R)
    (hacc : z₀ ∈ closure (sample \ {z₀})) :
    Set.EqOn F.value G.value (openComplexAnnulus r R) := by
  refine analyticOn_eqOn_openComplexAnnulus_of_accumulation
    hr F.sample_subset F.analyticOn G.analyticOn hz₀ ?_ hacc
  intro z hz
  exact (F.agrees_kernel hz).trans (G.agrees_kernel hz).symm

theorem AnnularKernelContinuation.eq_of_mem
    {kernel : ℂ → ℂ} {sample : Set ℂ} {r R : ℝ}
    (F G : AnnularKernelContinuation kernel sample r R)
    (hr : 0 ≤ r)
    {z₀ z : ℂ}
    (hz₀ : z₀ ∈ openComplexAnnulus r R)
    (hacc : z₀ ∈ closure (sample \ {z₀}))
    (hz : z ∈ openComplexAnnulus r R) :
    F.value z = G.value z :=
  F.eqOn_of_accumulation G hr hz₀ hacc hz

end AnalyticContinuation

/-! ### Theorem 5.1: corrected matching across the unit circle

The statement on p.49 cannot use two disjoint regions of the upper half-plane
as though they were overlapping `q`-domains.  We instead keep the outside
series as a germ in its own small variable `w`, pull it back by `w = q⁻¹`
only on a punctured annulus, and state the matching and its boundary-value
consequence there.

There is also a necessary algebraic correction.  The printed completion uses
the *same* `+ S⋆` term in both charts, so that term cancels on an overlap.
Consequently completion matching is equivalent to `f(q) = G(q⁻¹)`.  Combining
this with (5.1), `G(q⁻¹) = 2 Ψ(q) - S(q)`, forces the missing compatibility
`f(q) = 2 Ψ(q) - S(q)`.  This condition is proved necessary and sufficient
below; it is not hidden in continuation data. -/

namespace GlobalUnitCircleMatching

/-- Pull an independently defined exterior germ back to the `q`-plane by the
inverse coordinate. -/
def exteriorPullback (G : ℂ → ℂ) (q : ℂ) : ℂ :=
  G q⁻¹

/-- The holomorphic side of the inside/outside dictionary (5.1). -/
def dictionaryCore (Psi S : ℂ → ℂ) (q : ℂ) : ℂ :=
  2 * Psi q - S q

/-- The completed expression in the interior chart.  Here `Sstar` is an
already chosen single-valued representative in that `q`-chart; this definition
does not manufacture the paper's `τ`-dependent Eichler integral. -/
def insideCompletion (f Sstar : ℂ → ℂ) (q : ℂ) : ℂ :=
  f q + Sstar q

/-- The completed expression obtained from the independent exterior germ. -/
def outsideCompletion (G Sstar : ℂ → ℂ) (q : ℂ) : ℂ :=
  exteriorPullback G q + Sstar q

/-- The exact compatibility between the interior series and the theta-block
dictionary that is absent from the printed statement. -/
def InsideDictionaryCompatibility
    (f S Psi : ℂ → ℂ) (q : ℂ) : Prop :=
  f q = dictionaryCore Psi S q

/-- Since the same Eichler term is added in both charts, completed matching is
equivalent to equality of the two holomorphic cores.  No regularity of
`Sstar` is needed for this cancellation. -/
theorem insideCompletion_eq_outsideCompletion_iff
    (f G Sstar : ℂ → ℂ) (q : ℂ) :
    insideCompletion f Sstar q = outsideCompletion G Sstar q ↔
      f q = exteriorPullback G q := by
  constructor
  · intro h
    exact add_right_cancel h
  · intro h
    dsimp [insideCompletion, outsideCompletion]
    rw [h]

/-- Set-level cancellation of the common correction. -/
theorem insideCompletion_eqOn_outsideCompletion_iff
    (f G Sstar : ℂ → ℂ) (A : Set ℂ) :
    Set.EqOn (insideCompletion f Sstar) (outsideCompletion G Sstar) A ↔
      Set.EqOn f (exteriorPullback G) A := by
  constructor
  · intro h q hq
    exact (insideCompletion_eq_outsideCompletion_iff f G Sstar q).mp (h hq)
  · intro h q hq
    exact (insideCompletion_eq_outsideCompletion_iff f G Sstar q).mpr (h hq)

/-- The dictionary relation and completed matching force the missing
`f = 2 Ψ - S` relation. -/
theorem insideDictionaryCompatibility_of_completedMatching_of_dictionary
    (f G S Sstar Psi : ℂ → ℂ) (q : ℂ)
    (hdict : exteriorPullback G q = dictionaryCore Psi S q)
    (hmatch : insideCompletion f Sstar q =
      outsideCompletion G Sstar q) :
    InsideDictionaryCompatibility f S Psi q := by
  change f q = dictionaryCore Psi S q
  exact
    ((insideCompletion_eq_outsideCompletion_iff f G Sstar q).mp hmatch).trans
      hdict

/-- Conversely, the missing inside/dictionary compatibility together with
(5.1) is sufficient for completed matching. -/
theorem completedMatching_of_insideDictionaryCompatibility_of_dictionary
    (f G S Sstar Psi : ℂ → ℂ) (q : ℂ)
    (hdict : exteriorPullback G q = dictionaryCore Psi S q)
    (hcompat : InsideDictionaryCompatibility f S Psi q) :
    insideCompletion f Sstar q = outsideCompletion G Sstar q := by
  apply (insideCompletion_eq_outsideCompletion_iff f G Sstar q).mpr
  change f q = dictionaryCore Psi S q at hcompat
  exact hcompat.trans hdict.symm

/-- Pointwise necessary-and-sufficient algebraic audit of `f`, `G`, `S⋆`,
`S`, and `Psi`.  The `S⋆` term cancels exactly. -/
theorem completedMatching_iff_insideDictionaryCompatibility_of_dictionary
    (f G S Sstar Psi : ℂ → ℂ) (q : ℂ)
    (hdict : exteriorPullback G q = dictionaryCore Psi S q) :
    insideCompletion f Sstar q = outsideCompletion G Sstar q ↔
      InsideDictionaryCompatibility f S Psi q :=
  ⟨insideDictionaryCompatibility_of_completedMatching_of_dictionary
      f G S Sstar Psi q hdict,
    completedMatching_of_insideDictionaryCompatibility_of_dictionary
      f G S Sstar Psi q hdict⟩

/-- (5.1) alone says nothing about the independently specified inside series.
This concrete countermodel witnesses the missing hypothesis. -/
theorem dictionaryRelation_does_not_force_insideCompatibility :
    ∃ (f G S Psi : ℂ → ℂ) (q : ℂ),
      exteriorPullback G q = dictionaryCore Psi S q ∧
        ¬ InsideDictionaryCompatibility f S Psi q := by
  refine ⟨(fun _ ↦ 1), (fun _ ↦ 0), (fun _ ↦ 0), (fun _ ↦ 0), 1, ?_, ?_⟩
  · norm_num [exteriorPullback, dictionaryCore]
  · norm_num [InsideDictionaryCompatibility, dictionaryCore]

/-- The pre-existing inside/outside match does give matching completions with
the common `+ S⋆` term, for an arbitrary correction function. -/
theorem InsideOutsideMatch.completedMatching
    {D : InsideOutsideSeriesData} (M : InsideOutsideMatch D)
    (Sstar : ℂ → ℂ) {z : ℂ} (hz : z ∈ M.overlap)
    : D.inside.value (M.insideVariable z) + Sstar z =
        D.outside.value (M.outsideVariable z) + Sstar z := by
  rw [M.inside_eq_outside hz]

/-- Every genuine upper-half-plane cusp coordinate has norm strictly less
than one.  Thus the literal `|q| > 1` region in the same cusp chart is
impossible, rather than a second upper-half-plane domain. -/
theorem cuspQCoordinate_not_exterior
    (κ : Gamma2Cusp) (τ : UpperHalfPlane) :
    ¬ 1 < ‖cuspQCoordinate κ τ‖ :=
  not_lt_of_ge (le_of_lt (norm_cuspQCoordinate_lt_one κ τ))

theorem no_upperHalfPlane_exterior_q_region (κ : Gamma2Cusp) :
    ¬ ∃ τ : UpperHalfPlane, 1 < ‖cuspQCoordinate κ τ‖ := by
  rintro ⟨τ, hτ⟩
  exact cuspQCoordinate_not_exterior κ τ hτ

/-- A precise version of “bounded along every radial segment”. -/
def BoundedAlongEveryRadialSegment (F : ℂ → ℂ) : Prop :=
  ∀ (ζ : ℂ) (a b : ℝ), ∃ C : ℝ, 0 ≤ C ∧
    ∀ t ∈ Set.Icc a b, ‖F (Complex.ofReal t * ζ)‖ ≤ C

/-- Holomorphicity plus boundedness on radial segments does not imply
vanishing: the constant-one function is a formal counterexample to the proof
step on p.49. -/
theorem holomorphic_boundedAlongRadialSegments_not_force_zero :
    ∃ F : ℂ → ℂ,
      AnalyticOn ℂ F Set.univ ∧
        BoundedAlongEveryRadialSegment F ∧ F 0 ≠ 0 := by
  refine ⟨(fun _ ↦ 1), analyticOn_const, ?_, by norm_num⟩
  intro ζ a b
  refine ⟨1, zero_le_one, ?_⟩
  intro t ht
  norm_num

/-- The unit circle, used only as a boundary in the `q`-chart. -/
def complexUnitCircle : Set ℂ :=
  {q | ‖q‖ = 1}

/-- Boundary values are restrictions of an annular extension to the unit
circle.  They are not asserted to be radial limits of the original disk series;
no global logarithm or second upper-half-plane region is used. -/
def boundaryValue (F : ℂ → ℂ) : complexUnitCircle → ℂ :=
  fun q ↦ F q.1

/-- If `r < 1 < R`, the unit circle lies inside the common open annulus. -/
theorem complexUnitCircle_subset_openComplexAnnulus
    {r R : ℝ} (hr : r < 1) (hR : 1 < R) :
    complexUnitCircle ⊆ AnalyticContinuation.openComplexAnnulus r R := by
  intro q hq
  change ‖q‖ = 1 at hq
  constructor
  · simpa [Metric.mem_ball, dist_zero_right, hq] using hR
  · simpa [Metric.mem_closedBall, dist_zero_right, hq] using
      (not_le_of_gt hr)

/-- Every point of an annulus with nonnegative inner radius is nonzero. -/
theorem ne_zero_of_mem_openComplexAnnulus
    {r R : ℝ} (hr : 0 ≤ r) {q : ℂ}
    (hq : q ∈ AnalyticContinuation.openComplexAnnulus r R) :
    q ≠ 0 := by
  intro hzero
  apply hq.2
  rw [hzero]
  simpa [Metric.mem_closedBall] using hr

/-- The natural domain of the independent small exterior variable `w=q⁻¹`. -/
def exteriorVariableDomain (r R : ℝ) : Set ℂ :=
  (fun q : ℂ ↦ q⁻¹) ''
    AnalyticContinuation.openComplexAnnulus r R

/-- Analyticity of an exterior germ on its own variable domain pulls back to
analyticity on the punctured `q`-annulus. -/
theorem analyticOn_exteriorPullback
    {G : ℂ → ℂ} {r R : ℝ} (hr : 0 ≤ r)
    (hG : AnalyticOn ℂ G (exteriorVariableDomain r R)) :
    AnalyticOn ℂ (exteriorPullback G)
      (AnalyticContinuation.openComplexAnnulus r R) := by
  have hinv : AnalyticOn ℂ (fun q : ℂ ↦ q⁻¹)
      (AnalyticContinuation.openComplexAnnulus r R) :=
    analyticOn_inv.mono
      (fun _ hq ↦ ne_zero_of_mem_openComplexAnnulus hr hq)
  have hmaps : Set.MapsTo (fun q : ℂ ↦ q⁻¹)
      (AnalyticContinuation.openComplexAnnulus r R)
      (exteriorVariableDomain r R) := by
    intro q hq
    exact ⟨q, hq, rfl⟩
  change AnalyticOn ℂ (fun q : ℂ => G q⁻¹)
    (AnalyticContinuation.openComplexAnnulus r R)
  exact hG.comp hinv hmaps

/-- Completed agreement on an accumulating sample determines equality of the
analytic inside core and the pulled-back exterior germ on the whole annulus.
The common correction is cancelled before the identity theorem, so it need not
be holomorphic or even continuous. -/
theorem core_eqOn_annulus_of_completed_sample
    {r R : ℝ} (hr : 0 ≤ r)
    {f G Sstar : ℂ → ℂ} {sample : Set ℂ} {q₀ : ℂ}
    (hf : AnalyticOn ℂ f
      (AnalyticContinuation.openComplexAnnulus r R))
    (hG : AnalyticOn ℂ G (exteriorVariableDomain r R))
    (hsample : sample ⊆ AnalyticContinuation.openComplexAnnulus r R)
    (hq₀ : q₀ ∈ AnalyticContinuation.openComplexAnnulus r R)
    (hacc : q₀ ∈ closure (sample \ {q₀}))
    (hcompleted :
      Set.EqOn (insideCompletion f Sstar) (outsideCompletion G Sstar)
        sample) :
    Set.EqOn f (exteriorPullback G)
      (AnalyticContinuation.openComplexAnnulus r R) := by
  exact
    AnalyticContinuation.analyticOn_eqOn_openComplexAnnulus_of_accumulation
      hr hsample hf (analyticOn_exteriorPullback hr hG) hq₀
      ((insideCompletion_eqOn_outsideCompletion_iff f G Sstar sample).mp
        hcompleted)
      hacc

/-- Analyticity of `Psi` and `S` gives analyticity of the dictionary core. -/
theorem analyticOn_dictionaryCore
    {Psi S : ℂ → ℂ} {A : Set ℂ}
    (hPsi : AnalyticOn ℂ Psi A) (hS : AnalyticOn ℂ S A) :
    AnalyticOn ℂ (dictionaryCore Psi S) A := by
  have htwo : AnalyticOn ℂ (fun q : ℂ ↦ (2 : ℂ) * Psi q) A :=
    analyticOn_const.mul hPsi
  change AnalyticOn ℂ (fun q : ℂ => 2 * Psi q - S q) A
  exact htwo.sub hS

/-- The actual analytic-continuation step: agreement of the exterior pullback
and dictionary core on an accumulating sample determines their equality on the
whole common annulus. -/
theorem dictionary_eqOn_annulus_of_accumulation
    {r R : ℝ} (hr : 0 ≤ r)
    {G Psi S : ℂ → ℂ} {sample : Set ℂ} {q₀ : ℂ}
    (hG : AnalyticOn ℂ G (exteriorVariableDomain r R))
    (hPsi : AnalyticOn ℂ Psi
      (AnalyticContinuation.openComplexAnnulus r R))
    (hS : AnalyticOn ℂ S
      (AnalyticContinuation.openComplexAnnulus r R))
    (hsample : sample ⊆ AnalyticContinuation.openComplexAnnulus r R)
    (hq₀ : q₀ ∈ AnalyticContinuation.openComplexAnnulus r R)
    (hacc : q₀ ∈ closure (sample \ {q₀}))
    (hagrees : Set.EqOn (exteriorPullback G) (dictionaryCore Psi S)
      sample) :
    Set.EqOn (exteriorPullback G) (dictionaryCore Psi S)
      (AnalyticContinuation.openComplexAnnulus r R) := by
  exact
    AnalyticContinuation.analyticOn_eqOn_openComplexAnnulus_of_accumulation
      hr hsample (analyticOn_exteriorPullback hr hG)
      (analyticOn_dictionaryCore hPsi hS) hq₀ hagrees hacc

/-- Equality on an annulus containing the unit circle gives equality of the
corresponding boundary-value functions. -/
theorem boundaryValue_eq_of_eqOn_openComplexAnnulus
    {r R : ℝ} (hr : r < 1) (hR : 1 < R)
    {F H : ℂ → ℂ}
    (hFH : Set.EqOn F H
      (AnalyticContinuation.openComplexAnnulus r R)) :
    boundaryValue F = boundaryValue H := by
  funext q
  exact hFH (complexUnitCircle_subset_openComplexAnnulus hr hR q.property)

/-- **Corrected Theorem 5.1 (annular continuation and boundary matching).**

The exterior object is a germ in an independent variable.  An honest identity
theorem first cancels the common, possibly non-holomorphic `Sstar` on an
accumulating sample and continues the analytic cores `f` and `G(q⁻¹)` across a
connected annulus.  It independently continues (5.1), thereby proving the
missing `f = 2 Psi - S` compatibility.  Adding the same `Sstar` back then gives
completed matching and equality of cusp-chart boundary values on `|q|=1`.

No spectral growth conclusion is inferred here: that requires independent cusp
estimates and is not a consequence of analytic continuation.  Likewise the
analytic extensions and the two accumulating-sample agreements are explicit
inputs: constructing them from the paper's theta kernel is a separate existence
theorem, not smuggled into this matching implication. -/
theorem correctedTheorem5_1_annularMatching
    {r R : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (h1R : 1 < R)
    {f G S Sstar Psi : ℂ → ℂ}
    {sample : Set ℂ} {q₀ : ℂ}
    (hf : AnalyticOn ℂ f
      (AnalyticContinuation.openComplexAnnulus r R))
    (hG : AnalyticOn ℂ G (exteriorVariableDomain r R))
    (hPsi : AnalyticOn ℂ Psi
      (AnalyticContinuation.openComplexAnnulus r R))
    (hS : AnalyticOn ℂ S
      (AnalyticContinuation.openComplexAnnulus r R))
    (hsample : sample ⊆ AnalyticContinuation.openComplexAnnulus r R)
    (hq₀ : q₀ ∈ AnalyticContinuation.openComplexAnnulus r R)
    (hacc : q₀ ∈ closure (sample \ {q₀}))
    (hcompletedSample :
      Set.EqOn (insideCompletion f Sstar) (outsideCompletion G Sstar)
        sample)
    (hdictionarySample :
      Set.EqOn (exteriorPullback G) (dictionaryCore Psi S)
      sample)
    : Set.EqOn f (exteriorPullback G)
        (AnalyticContinuation.openComplexAnnulus r R) ∧
      Set.EqOn (exteriorPullback G) (dictionaryCore Psi S)
        (AnalyticContinuation.openComplexAnnulus r R) ∧
      Set.EqOn f (dictionaryCore Psi S)
        (AnalyticContinuation.openComplexAnnulus r R) ∧
      Set.EqOn (insideCompletion f Sstar) (outsideCompletion G Sstar)
        (AnalyticContinuation.openComplexAnnulus r R) ∧
      boundaryValue (insideCompletion f Sstar) =
        boundaryValue (outsideCompletion G Sstar) := by
  have hcore : Set.EqOn f (exteriorPullback G)
      (AnalyticContinuation.openComplexAnnulus r R) :=
    core_eqOn_annulus_of_completed_sample
      hr0 hf hG hsample hq₀ hacc hcompletedSample
  have hdict : Set.EqOn (exteriorPullback G) (dictionaryCore Psi S)
      (AnalyticContinuation.openComplexAnnulus r R) :=
    dictionary_eqOn_annulus_of_accumulation
      hr0 hG hPsi hS hsample hq₀ hacc hdictionarySample
  have hcompat : Set.EqOn f (dictionaryCore Psi S)
      (AnalyticContinuation.openComplexAnnulus r R) := by
    intro q hq
    exact (hcore hq).trans (hdict hq)
  have hcompleted :
      Set.EqOn (insideCompletion f Sstar) (outsideCompletion G Sstar)
        (AnalyticContinuation.openComplexAnnulus r R) := by
    intro q hq
    exact (insideCompletion_eq_outsideCompletion_iff f G Sstar q).mpr
      (hcore hq)
  exact ⟨hcore, hdict, hcompat, hcompleted,
    boundaryValue_eq_of_eqOn_openComplexAnnulus hr1 h1R hcompleted⟩

/-! #### A closed nonconstant verification model

The theorem above is universally quantified because the paper does not supply
the analytic extensions that its argument needs.  The following model is not
claimed to be the paper's mock-theta datum.  It is a completely explicit
verification instance showing that the corrected hypotheses are jointly
satisfiable by nonconstant analytic functions and that the conclusion has
genuine content.

On `1 / 2 < ‖q‖ < 2` take the inside Laurent function `q⁻¹`, the exterior
polynomial germ `G(w) = w`, and `Psi = S = q⁻¹`.  Then
`G(q⁻¹) = q⁻¹ = 2 Psi(q) - S(q)`.  The common correction `q²` is
deliberately nonzero, so its cancellation is also exercised. -/

namespace HalfTwoVerificationModel

abbrev innerRadius : ℝ := 1 / 2
abbrev outerRadius : ℝ := 2

def sample : Set ℂ :=
  AnalyticContinuation.openComplexAnnulus innerRadius outerRadius

def basePoint : ℂ := 1

def inside (q : ℂ) : ℂ := q⁻¹

def exterior (w : ℂ) : ℂ := w

def psi (q : ℂ) : ℂ := q⁻¹

def shadow (q : ℂ) : ℂ := q⁻¹

def correction (q : ℂ) : ℂ := q ^ 2

@[simp]
theorem exteriorPullback_eq_inside (q : ℂ) :
    exteriorPullback exterior q = inside q :=
  rfl

@[simp]
theorem dictionaryCore_eq_inside (q : ℂ) :
    dictionaryCore psi shadow q = inside q := by
  simp only [dictionaryCore, psi, shadow, inside]
  ring

theorem inside_analytic :
    AnalyticOn ℂ inside sample := by
  change AnalyticOn ℂ (fun q : ℂ ↦ q⁻¹)
    (AnalyticContinuation.openComplexAnnulus innerRadius outerRadius)
  exact analyticOn_inv.mono
    (fun _ hq ↦ ne_zero_of_mem_openComplexAnnulus
      (r := innerRadius) (R := outerRadius) (by norm_num [innerRadius]) hq)

theorem exterior_analytic :
    AnalyticOn ℂ exterior
      (exteriorVariableDomain innerRadius outerRadius) := by
  change AnalyticOn ℂ (fun w : ℂ => w)
    (exteriorVariableDomain innerRadius outerRadius)
  exact analyticOn_id

theorem psi_analytic :
    AnalyticOn ℂ psi sample := by
  change AnalyticOn ℂ (fun q : ℂ => q⁻¹) sample
  exact inside_analytic

theorem shadow_analytic :
    AnalyticOn ℂ shadow sample := by
  change AnalyticOn ℂ (fun q : ℂ => q⁻¹) sample
  exact inside_analytic

theorem correction_analytic :
    AnalyticOn ℂ correction sample := by
  change AnalyticOn ℂ (fun q : ℂ => q ^ 2) sample
  exact (analyticOn_id : AnalyticOn ℂ (fun q : ℂ => q) sample).pow 2

theorem correction_ne_zero_at_basePoint : correction basePoint ≠ 0 := by
  norm_num [correction, basePoint]

theorem sample_subset :
    sample ⊆ AnalyticContinuation.openComplexAnnulus innerRadius outerRadius :=
  fun _ hq ↦ hq

theorem basePoint_mem : basePoint ∈ sample := by
  change (1 : ℂ) ∈
    Metric.ball 0 (2 : ℝ) \ Metric.closedBall 0 (1 / 2 : ℝ)
  constructor <;>
    norm_num [Metric.mem_ball, Metric.mem_closedBall, dist_zero_right]

theorem negOne_mem : (-1 : ℂ) ∈ sample := by
  change (-1 : ℂ) ∈
    Metric.ball 0 (2 : ℝ) \ Metric.closedBall 0 (1 / 2 : ℝ)
  constructor <;>
    norm_num [Metric.mem_ball, Metric.mem_closedBall, dist_zero_right]

/-- The full annulus is a non-discrete agreement sample.  This direct metric
proof records an explicit nearby point and does not appeal to an unstated
"open sets have no isolated points" principle. -/
theorem basePoint_mem_closure_diff_singleton :
    basePoint ∈ closure (sample \ {basePoint}) := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  let δ : ℝ := min (ε / 2) (1 / 4)
  have hδpos : 0 < δ := by
    dsimp [δ]
    exact lt_min (by linarith) (by norm_num)
  have hδleQuarter : δ ≤ 1 / 4 := min_le_right _ _
  have hδltε : δ < ε := by
    calc
      δ ≤ ε / 2 := min_le_left _ _
      _ < ε := by linarith
  let z : ℂ := ((1 + δ : ℝ) : ℂ)
  have hnonneg : 0 ≤ 1 + δ := by linarith
  have hnorm : ‖z‖ = 1 + δ := by
    dsimp [z]
    rw [Complex.norm_real, Real.norm_of_nonneg hnonneg]
  have hsub : z - basePoint = (δ : ℂ) := by
    dsimp [z, basePoint]
    push_cast
    ring
  have hdist : dist z basePoint = δ := by
    rw [dist_eq_norm, hsub, Complex.norm_real,
      Real.norm_of_nonneg (le_of_lt hδpos)]
  have hdist' : dist basePoint z = δ := by
    rw [dist_comm]
    exact hdist
  have hzmem : z ∈ sample := by
    change z ∈
      Metric.ball 0 (2 : ℝ) \ Metric.closedBall 0 (1 / 2 : ℝ)
    constructor
    · rw [Metric.mem_ball, dist_zero_right, hnorm]
      linarith
    · rw [Metric.mem_closedBall, dist_zero_right, hnorm]
      linarith
  have hzneq : z ≠ basePoint := by
    intro hz
    rw [hz, dist_self] at hdist
    linarith
  refine ⟨z, ⟨hzmem, ?_⟩, ?_⟩
  · simpa only [Set.mem_singleton_iff] using hzneq
  · simpa only [Metric.mem_ball, hdist, hdist'] using hδltε

theorem completedAgreement_on_sample :
    Set.EqOn (insideCompletion inside correction)
      (outsideCompletion exterior correction) sample := by
  intro q _
  exact (insideCompletion_eq_outsideCompletion_iff
    inside exterior correction q).mpr (exteriorPullback_eq_inside q).symm

theorem dictionaryAgreement_on_sample :
    Set.EqOn (exteriorPullback exterior)
      (dictionaryCore psi shadow) sample := by
  intro q _
  exact (exteriorPullback_eq_inside q).trans
    (dictionaryCore_eq_inside q).symm

/-- The inside Laurent function is nonconstant even after restricting to the
common annulus. -/
theorem inside_nonconstant_on_sample :
    ∃ q₁ ∈ sample, ∃ q₂ ∈ sample, inside q₁ ≠ inside q₂ := by
  refine ⟨(1 : ℂ), ?_, (-1 : ℂ), ?_, ?_⟩
  · simpa only [basePoint] using basePoint_mem
  · exact negOne_mem
  · norm_num [inside]

theorem one_mem_exteriorVariableDomain :
    (1 : ℂ) ∈ exteriorVariableDomain innerRadius outerRadius := by
  change (1 : ℂ) ∈ (fun q : ℂ ↦ q⁻¹) '' sample
  refine ⟨(1 : ℂ), ?_, ?_⟩
  · simpa only [basePoint] using basePoint_mem
  · norm_num

theorem negOne_mem_exteriorVariableDomain :
    (-1 : ℂ) ∈ exteriorVariableDomain innerRadius outerRadius := by
  change (-1 : ℂ) ∈ (fun q : ℂ ↦ q⁻¹) '' sample
  exact ⟨(-1 : ℂ), negOne_mem, by norm_num⟩

/-- The exterior polynomial germ is likewise nonconstant on its actual
independent-variable domain. -/
theorem exterior_nonconstant_on_domain :
    ∃ w₁ ∈ exteriorVariableDomain innerRadius outerRadius,
      ∃ w₂ ∈ exteriorVariableDomain innerRadius outerRadius,
        exterior w₁ ≠ exterior w₂ := by
  exact ⟨(1 : ℂ), one_mem_exteriorVariableDomain,
    (-1 : ℂ), negOne_mem_exteriorVariableDomain, by norm_num [exterior]⟩

def MatchingConclusion : Prop :=
  Set.EqOn inside (exteriorPullback exterior) sample ∧
    Set.EqOn (exteriorPullback exterior) (dictionaryCore psi shadow) sample ∧
    Set.EqOn inside (dictionaryCore psi shadow) sample ∧
    Set.EqOn (insideCompletion inside correction)
      (outsideCompletion exterior correction) sample ∧
    boundaryValue (insideCompletion inside correction) =
      boundaryValue (outsideCompletion exterior correction)

theorem annularMatching : MatchingConclusion := by
  exact correctedTheorem5_1_annularMatching
    (r := innerRadius) (R := outerRadius)
    (f := inside) (G := exterior) (S := shadow)
    (Sstar := correction) (Psi := psi) (sample := sample)
    (q₀ := basePoint)
    (by norm_num [innerRadius])
    (by norm_num [innerRadius])
    (by norm_num [outerRadius])
    inside_analytic exterior_analytic psi_analytic shadow_analytic
    sample_subset basePoint_mem basePoint_mem_closure_diff_singleton
    completedAgreement_on_sample dictionaryAgreement_on_sample

/-- Closed proof object for the explicit verification model.  All hypotheses
of corrected Theorem 5.1 and its full five-part conclusion occur as fields, and
nonconstancy is witnessed at two points of the annulus. -/
structure Certificate : Prop where
  nonconstant :
    ∃ q₁ ∈ sample, ∃ q₂ ∈ sample, inside q₁ ≠ inside q₂
  exteriorNonconstant :
    ∃ w₁ ∈ exteriorVariableDomain innerRadius outerRadius,
      ∃ w₂ ∈ exteriorVariableDomain innerRadius outerRadius,
        exterior w₁ ≠ exterior w₂
  analyticInside : AnalyticOn ℂ inside sample
  analyticExterior : AnalyticOn ℂ exterior
    (exteriorVariableDomain innerRadius outerRadius)
  analyticPsi : AnalyticOn ℂ psi sample
  analyticShadow : AnalyticOn ℂ shadow sample
  analyticCorrection : AnalyticOn ℂ correction sample
  correctionNonzero : correction basePoint ≠ 0
  sampleContained :
    sample ⊆ AnalyticContinuation.openComplexAnnulus innerRadius outerRadius
  basePointInSample : basePoint ∈ sample
  accumulation : basePoint ∈ closure (sample \ {basePoint})
  completedSample :
    Set.EqOn (insideCompletion inside correction)
      (outsideCompletion exterior correction) sample
  dictionarySample :
    Set.EqOn (exteriorPullback exterior)
      (dictionaryCore psi shadow) sample
  conclusion : MatchingConclusion

theorem certificate : Certificate where
  nonconstant := inside_nonconstant_on_sample
  exteriorNonconstant := exterior_nonconstant_on_domain
  analyticInside := inside_analytic
  analyticExterior := exterior_analytic
  analyticPsi := psi_analytic
  analyticShadow := shadow_analytic
  analyticCorrection := correction_analytic
  correctionNonzero := correction_ne_zero_at_basePoint
  sampleContained := sample_subset
  basePointInSample := basePoint_mem
  accumulation := basePoint_mem_closure_diff_singleton
  completedSample := completedAgreement_on_sample
  dictionarySample := dictionaryAgreement_on_sample
  conclusion := annularMatching

end HalfTwoVerificationModel

end GlobalUnitCircleMatching

namespace CuspTransport

/-- The top-left entry of a matrix in `Γ(2)` is odd, hence nonzero. -/
theorem gamma2_topLeft_ne_zero (γ : Gamma2Element) :
    γ.1 0 0 ≠ 0 := by
  have haMod : ((γ.1 0 0 : ℤ) : ZMod 2) = 1 :=
    (CongruenceSubgroup.Gamma_mem.mp γ.property).1
  intro ha
  rw [ha] at haMod
  norm_num at haMod

/-- No deck transformation in `Γ(2)` sends infinity to the labelled cusp zero. -/
theorem gamma2_does_not_send_infinity_to_zero
    (γ : Gamma2Element) :
    KuznetsovKloosterman.gamma2BoundaryActionHom γ •
        (OnePoint.infty : OnePoint ℝ) ≠
      ((0 : ℝ) : OnePoint ℝ) := by
  have haR :
      (KuznetsovKloosterman.gamma2BoundaryActionHom γ) 0 0 ≠ 0 := by
    change (((γ.1 0 0 : ℤ) : ℝ)) ≠ 0
    exact_mod_cast gamma2_topLeft_ne_zero γ
  rw [OnePoint.smul_infty_eq_ite]
  split_ifs with hc
  · simp
  · simpa using div_ne_zero haR hc

/-- The group-orbit assertion used by Proposition 13. -/
def CitedCuspClaim : Prop :=
  ∀ κ : Gamma2Cusp, ∃ γ : Gamma2Element,
    KuznetsovKloosterman.gamma2BoundaryActionHom γ •
        (OnePoint.infty : OnePoint ℝ) =
      KuznetsovKloosterman.gamma2CuspBoundaryPoint κ

/-- The cited orbit assertion is false already at the cusp zero. -/
theorem not_CitedCuspClaim : ¬ CitedCuspClaim := by
  intro h
  obtain ⟨γ, hγ⟩ := h .zero
  rw [KuznetsovKloosterman.gamma2CuspBoundaryPoint_zero] at hγ
  exact gamma2_does_not_send_infinity_to_zero γ hγ

/-- Correct transport uses an ambient scaling matrix.  Its conjugated subgroup
is again `Γ(2)`, and its strict cusp width is exactly two. -/
theorem scalingMatrix_conjugation_and_width (κ : Gamma2Cusp) :
    CongruenceSubgroup.conjGL Gamma2 (Gamma2Cusp.scalingMatrix κ) = Gamma2 ∧
      Subgroup.strictWidthInfty
        (CongruenceSubgroup.conjGL Gamma2
          (Gamma2Cusp.scalingMatrix κ) :
          Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)) = 2 :=
  ⟨Gamma2Cusp.conjGL_gamma2_scalingMatrix κ,
    Gamma2Cusp.strictWidth_scaling_conjugate_eq_two κ⟩

/-- Complete corrected cusp-scaling certificate: the ambient scaling matrix
represents the labelled boundary point, normalizes `Γ(2)`, and gives strict
width two.  No element of `Γ(2)` itself is incorrectly required to move one
cuspidal orbit to another. -/
theorem ambientScalingMatrix_transportCertificate (κ : Gamma2Cusp) :
    (Matrix.SpecialLinearGroup.mapGL
        (n := Fin 2) (R := ℤ) ℝ)
        (Gamma2Cusp.scalingMatrix κ) •
          (OnePoint.infty : OnePoint ℝ) =
        KuznetsovKloosterman.gamma2CuspBoundaryPoint κ ∧
      CongruenceSubgroup.conjGL Gamma2
          (Gamma2Cusp.scalingMatrix κ) = Gamma2 ∧
      Subgroup.strictWidthInfty
          (CongruenceSubgroup.conjGL Gamma2
            (Gamma2Cusp.scalingMatrix κ) :
            Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)) = 2 := by
  refine ⟨rfl, ?_⟩
  exact scalingMatrix_conjugation_and_width κ

end CuspTransport

namespace FlatQTransport

/-- A connection on sections of the radius-dependent kernel fibers.  The
Leibniz rule is stated before any trivialization is used, so the result is an
operator on the actual dependent family rather than merely on a model fiber. -/
structure DependentRadialConnection
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (D : RadialDerivation) where
  nabla :
    ((r : RadialBase) → L.fiber r) →ₗ[ℂ]
      ((r : RadialBase) → L.fiber r)
  leibniz : ∀ (f : RadialBase → ℂ)
      (s : (r : RadialBase) → L.fiber r),
    nabla (fun r => f r • s r) =
      fun r => D.toLinearMap f r • s r + f r • nabla s r

/-- Pull a chosen model-fiber connection back through the selected
constant-rank trivialization. -/
def QLocalSystem.connectionOfTrivialization
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (D : RadialDerivation)
    (C : AlgebraicRadialConnection D Model) :
    DependentRadialConnection L D where
  nabla :=
    { toFun := fun s r =>
        (L.trivialization r).symm
          (C.nabla (fun q => L.trivialization q (s q)) r)
      map_add' := by
        intro s t
        funext r
        have hfun :
            (fun q => L.trivialization q ((s + t) q)) =
              (fun q => L.trivialization q (s q)) +
                (fun q => L.trivialization q (t q)) := by
          funext q
          simp
        rw [hfun, map_add]
        simpa only [Pi.add_apply, map_add]
      map_smul' := by
        intro c s
        funext r
        have hfun :
            (fun q => L.trivialization q ((c • s) q)) =
              c • (fun q => L.trivialization q (s q)) := by
          funext q
          simp
        rw [hfun, map_smul]
        simpa only [Pi.smul_apply, RingHom.id_apply, map_smul] }
  leibniz := by
    intro f s
    funext r
    apply (L.trivialization r).injective
    change
      L.trivialization r
          ((L.trivialization r).symm
            (C.nabla
              (fun q => L.trivialization q (f q • s q)) r)) =
        L.trivialization r
          (D.toLinearMap f r • s r +
            f r • (L.trivialization r).symm
              (C.nabla (fun q => L.trivialization q (s q)) r))
    simpa only [map_add, map_smul,
      LinearEquiv.apply_symm_apply] using
        congrFun (C.leibniz f
          (fun q => L.trivialization q (s q))) r

/-- Compatibility means that a dependent connection becomes the selected model
connection in the chosen kernel trivialization. -/
def DependentRadialConnection.TrivializationCompatible
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    {L : QLocalSystem V Model} {D : RadialDerivation}
    (A : DependentRadialConnection L D)
    (C : AlgebraicRadialConnection D Model) : Prop :=
  ∀ s r,
    L.trivialization r (A.nabla s r) =
      C.nabla (fun q => L.trivialization q (s q)) r

/-- The pullback connection is compatible with its defining trivialization. -/
theorem QLocalSystem.connectionOfTrivialization_compatible
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (D : RadialDerivation)
    (C : AlgebraicRadialConnection D Model) :
    (QLocalSystem.connectionOfTrivialization L D C).TrivializationCompatible C := by
  intro s r
  exact LinearEquiv.apply_symm_apply (L.trivialization r) _

/-- Two connections represented by the same model connection in the same
trivialization are equal. -/
theorem DependentRadialConnection.eq_of_trivializationCompatible
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    {L : QLocalSystem V Model} {D : RadialDerivation}
    {C : AlgebraicRadialConnection D Model}
    (A B : DependentRadialConnection L D)
    (hA : A.TrivializationCompatible C)
    (hB : B.TrivializationCompatible C) :
    A = B := by
  have hnabla : A.nabla = B.nabla := by
    apply LinearMap.ext
    intro s
    funext r
    apply (L.trivialization r).injective
    exact (hA s r).trans (hB s r).symm
  cases A
  cases B
  cases hnabla
  rfl

/-- **Corrected Proposition 14.** A constant-rank kernel family with a chosen
trivialization and a chosen model connection has a uniquely determined pulled-
back connection among all connections compatible with those choices. -/
theorem QLocalSystem.connectionOfTrivialization_unique
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (D : RadialDerivation)
    (C : AlgebraicRadialConnection D Model)
    (A : DependentRadialConnection L D)
    (hA : A.TrivializationCompatible C) :
    A = QLocalSystem.connectionOfTrivialization L D C :=
  DependentRadialConnection.eq_of_trivializationCompatible A
    (QLocalSystem.connectionOfTrivialization L D C)
    hA (QLocalSystem.connectionOfTrivialization_compatible L D C)

/-- The zero derivation on radial scalar functions. -/
def zeroRadialDerivation : RadialDerivation where
  toLinearMap := 0
  map_one := by simp
  leibniz := by
    intro f g
    simp

/-- A zero connection over the zero radial derivation. -/
def zeroRadialConnection :
    AlgebraicRadialConnection zeroRadialDerivation ℂ where
  nabla := 0
  leibniz := by
    intro f s
    ext r
    simp [zeroRadialDerivation]

/-- The identity endomorphism is another lawful connection-like operator over
the same zero radial derivation. -/
def identityRadialConnection :
    AlgebraicRadialConnection zeroRadialDerivation ℂ where
  nabla := LinearMap.id
  leibniz := by
    intro f s
    ext r
    simp [zeroRadialDerivation]

/-- Direct nonuniqueness of the current radial-connection interface.  Thus a
constant-rank kernel or elliptic regularity cannot select a canonical connection
without an additional normalization or evolution equation. -/
theorem zeroRadialConnection_ne_identityRadialConnection :
    zeroRadialConnection ≠ identityRadialConnection := by
  intro h
  let r : RadialBase := ⟨(1 / 2 : ℝ), by norm_num, by norm_num⟩
  have hvalue := congrArg
    (fun C : AlgebraicRadialConnection zeroRadialDerivation ℂ =>
      C.nabla (fun _ => (1 : ℂ)) r) h
  have hzeroOne : (0 : ℂ) = 1 := by
    simpa [zeroRadialConnection, identityRadialConnection] using hvalue
  exact zero_ne_one hzeroOne

/-- The underlying scalar endomorphism space already has two distinct points.
Consequently an operator family alone cannot determine a unique connection-like
endomorphism without a chosen trivialization, PDE, or normalization. -/
theorem scalarEndomorphismSpace_not_subsingleton :
    ¬ Subsingleton (Module.End ℂ ℂ) := by
  intro h
  have hzeroId :
      (0 : Module.End ℂ ℂ) = (LinearMap.id : Module.End ℂ ℂ) :=
    Subsingleton.elim _ _
  have hvalue := congrArg (fun f : Module.End ℂ ℂ => f 1) hzeroId
  norm_num at hvalue

/-- Parallel transport is unique after a kernel trivialization has been chosen.
This is not canonical uniqueness from the operator family alone. -/
theorem QLocalSystem.transport_unique_of_trivialization
    {V Model : Type*}
    [AddCommGroup V] [Module ℂ V]
    [AddCommGroup Model] [Module ℂ Model]
    (L : QLocalSystem V Model) (r s : RadialBase)
    (T : L.fiber r ≃ₗ[ℂ] L.fiber s)
    (hT : ∀ x,
      L.trivialization s (T x) = L.trivialization r x) :
    T = L.transport r s := by
  apply LinearEquiv.ext
  intro x
  apply (L.trivialization s).injective
  rw [hT x]
  simp [QLocalSystem.transport]

end FlatQTransport

/-! ### Propositions 15--20: sheaf, curvature, minimizers, and equalizers -/

namespace SheafBridge

/-- Without a specified target object, even an object map need not exist.  This
small obstruction prevents an undefined cross-paper assignment from being
silently called a canonical functor. -/
theorem noUniversalObjectMap :
    ¬ Nonempty (PUnit → Empty) := by
  rintro ⟨f⟩
  exact (f PUnit.unit).elim

end SheafBridge

namespace OperatorGaugeCurvature

/-- Conjugation of an endomorphism by a linear change of frame. -/
def conjugateEndomorphism
    {R V : Type*} [CommSemiring R]
    [AddCommMonoid V] [Module R V]
    (g : V ≃ₗ[R] V) (A : Module.End R V) : Module.End R V :=
  g.symm.toLinearMap.comp (A.comp g.toLinearMap)

@[simp]
theorem conjugateEndomorphism_apply
    {R V : Type*} [CommSemiring R]
    [AddCommMonoid V] [Module R V]
    (g : V ≃ₗ[R] V) (A : Module.End R V) (v : V) :
    conjugateEndomorphism g A v = g.symm (A (g v)) :=
  rfl

/-- Conjugation respects composition. -/
theorem conjugateEndomorphism_comp
    {R V : Type*} [CommSemiring R]
    [AddCommMonoid V] [Module R V]
    (g : V ≃ₗ[R] V) (A B : Module.End R V) :
    conjugateEndomorphism g (A.comp B) =
      (conjugateEndomorphism g A).comp
        (conjugateEndomorphism g B) := by
  ext v
  simp [conjugateEndomorphism]

/-- Conjugation is additive in the endomorphism. -/
theorem conjugateEndomorphism_add
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (g : V ≃ₗ[R] V) (A B : Module.End R V) :
    conjugateEndomorphism g (A + B) =
      conjugateEndomorphism g A + conjugateEndomorphism g B := by
  ext v
  simp [conjugateEndomorphism]

/-- Curvature of a pure covariant operator is its square. -/
def operatorCurvature
    {R V : Type*} [CommSemiring R]
    [AddCommMonoid V] [Module R V]
    (A : Module.End R V) : Module.End R V :=
  A.comp A

/-- The fully typed operator form of gauge covariance:
`(g⁻¹ A g)² = g⁻¹ A² g`. -/
theorem operatorCurvature_conjugate
    {R V : Type*} [CommSemiring R]
    [AddCommMonoid V] [Module R V]
    (g : V ≃ₗ[R] V) (A : Module.End R V) :
    operatorCurvature (conjugateEndomorphism g A) =
      conjugateEndomorphism g (operatorCurvature A) := by
  simpa [operatorCurvature] using
    (conjugateEndomorphism_comp g A A).symm

/-- The operator incarnation of the inhomogeneous term `g⁻¹ d g - d` in a
variable gauge transformation.  Here `d` acts on the full section space, so a
nonconstant gauge is represented by a linear equivalence that need not commute
with `d`. -/
def gaugeDerivativeTerm
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d : Module.End R V) (g : V ≃ₗ[R] V) : Module.End R V :=
  conjugateEndomorphism g d - d

/-- Gauge transform of the connection potential relative to the fixed
background differential `d`: `Aᵍ = g⁻¹(d+A)g-d`. -/
def variableGaugePotential
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d : Module.End R V) (g : V ≃ₗ[R] V)
    (A : Module.End R V) : Module.End R V :=
  conjugateEndomorphism g (d + A) - d

/-- The transformed potential splits as the homogeneous conjugate of `A` plus
the inhomogeneous derivative term. -/
theorem variableGaugePotential_eq
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d : Module.End R V) (g : V ≃ₗ[R] V)
    (A : Module.End R V) :
    variableGaugePotential d g A =
      conjugateEndomorphism g A + gaugeDerivativeTerm d g := by
  rw [variableGaugePotential, gaugeDerivativeTerm,
    conjugateEndomorphism_add]
  abel

/-- Adding the fixed background differential recovers the conjugated full
connection operator. -/
theorem background_add_variableGaugePotential
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d : Module.End R V) (g : V ≃ₗ[R] V)
    (A : Module.End R V) :
    d + variableGaugePotential d g A =
      conjugateEndomorphism g (d + A) := by
  simp only [variableGaugePotential]
  abel

/-- Curvature of a connection potential is the square of its full covariant
operator `d+A`. -/
def connectionCurvature
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d A : Module.End R V) : Module.End R V :=
  operatorCurvature (d + A)

/-- **Corrected Proposition 17.** Full variable-gauge covariance in the
endomorphism-valued connection model.  The inhomogeneous term is derived from
the conjugated background differential rather than omitted or postulated. -/
theorem connectionCurvature_variableGauge
    {R V : Type*} [CommRing R]
    [AddCommGroup V] [Module R V]
    (d : Module.End R V) (g : V ≃ₗ[R] V)
    (A : Module.End R V) :
    connectionCurvature d (variableGaugePotential d g A) =
      conjugateEndomorphism g (connectionCurvature d A) := by
  rw [connectionCurvature, background_add_variableGaugePotential]
  exact operatorCurvature_conjugate g (d + A)

/-- A nonzero additive correction cannot be erased from a homogeneous
conjugation formula.  The next theorem supplies the stronger genuine
derivative-term witness. -/
theorem nonzeroAdditiveCorrection_cannot_be_dropped :
    ∃ (g : ℂ ≃ₗ[ℂ] ℂ) (A B : Module.End ℂ ℂ),
      B ≠ 0 ∧
        conjugateEndomorphism g A + B ≠ conjugateEndomorphism g A := by
  have hid : (LinearMap.id : Module.End ℂ ℂ) ≠ 0 := by
    intro h
    have hvalue := congrArg (fun f : Module.End ℂ ℂ => f 1) h
    norm_num at hvalue
  refine ⟨LinearEquiv.refl ℂ ℂ, 0, LinearMap.id, hid, ?_⟩
  intro h
  have hvalue := congrArg (fun f : Module.End ℂ ℂ => f 1) h
  norm_num [conjugateEndomorphism] at hvalue

/-- A genuine variable gauge can have a nonzero derivative term.  On
`ℂ × ℂ`, take the first-coordinate projection and conjugate it by the factor
swap; the resulting commutator is already nonzero on `(1,0)`. -/
theorem exists_nonzero_gaugeDerivativeTerm :
    ∃ (d : Module.End ℂ (ℂ × ℂ))
      (g : (ℂ × ℂ) ≃ₗ[ℂ] (ℂ × ℂ)),
      gaugeDerivativeTerm d g ≠ 0 := by
  let d : Module.End ℂ (ℂ × ℂ) :=
    (LinearMap.inl ℂ ℂ ℂ).comp (LinearMap.fst ℂ ℂ ℂ)
  let g : (ℂ × ℂ) ≃ₗ[ℂ] (ℂ × ℂ) :=
    LinearEquiv.prodComm ℂ ℂ ℂ
  refine ⟨d, g, ?_⟩
  intro hzero
  have hvalue := congrArg
    (fun T : Module.End ℂ (ℂ × ℂ) =>
      T ((1, 0) : ℂ × ℂ)) hzero
  have hfirst := congrArg (fun z : ℂ × ℂ => z.1) hvalue
  have hbad : (-1 : ℂ) = 0 := by
    simpa [gaugeDerivativeTerm, conjugateEndomorphism, d, g,
      LinearEquiv.prodComm_apply, LinearMap.inl_apply] using hfirst
  norm_num at hbad

end OperatorGaugeCurvature

namespace FlatMinimizer

/-- A flat comparison field with zero mass and remainder has zero action. -/
theorem EffectiveActionDecomposition.action_eq_zero_of_flat_vacuum
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C) {A₀ : OneForm}
    (hflat₀ : A₀ ∈ flatSector C)
    (hmass₀ : D.mass A₀ = 0)
    (hremainder₀ : D.remainder A₀ = 0) :
    D.action A₀ = 0 := by
  calc
    D.action A₀ = D.mass A₀ + D.remainder A₀ :=
      action_eq_mass_add_remainder_of_flat D hflat₀
    _ = 0 := by rw [hmass₀, hremainder₀, add_zero]

/-- A globally minimizing flat field is massless when a flat zero-mass vacuum
exists and both remaining action components are nonnegative. -/
theorem EffectiveActionDecomposition.flat_minimizer_massless_of_vacuum
    {OneForm TwoForm : Type*}
    [AddCommGroup OneForm] [Module ℂ OneForm]
    [AddCommGroup TwoForm] [Module ℂ TwoForm]
    {C : CurvatureCalculus OneForm TwoForm}
    (D : EffectiveActionDecomposition C)
    (hmass : ∀ A, 0 ≤ D.mass A)
    (hremainder : ∀ A, 0 ≤ D.remainder A)
    (A A₀ : OneForm)
    (hflat : A ∈ flatSector C)
    (hflat₀ : A₀ ∈ flatSector C)
    (hmass₀ : D.mass A₀ = 0)
    (hremainder₀ : D.remainder A₀ = 0)
    (hmin : ∀ B, D.action A ≤ D.action B) :
    D.mass A = 0 ∧ D.remainder A = 0 :=
  flat_minimizer_mass_remainder_zero D hmass hremainder A A₀ hflat
    (EffectiveActionDecomposition.action_eq_zero_of_flat_vacuum
      D hflat₀ hmass₀ hremainder₀) hmin

end FlatMinimizer

namespace GlobalEqualizer

/-- Compatible local covariant fields on an open cover.  This is the correct
set-level equalizer when no ambient additive product has been chosen. -/
def CompatibleGaugeFamily
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type*} (D : GaugeDescentSheaf X E)
    (V : ι → TopologicalSpace.Opens X) : Type _ :=
  {s : ∀ i, qGaugeForms (D.action (V i)) //
    ∀ i j,
      D.forms.restrict inf_le_left
          (s i : D.forms.section (V i)) =
        D.forms.restrict inf_le_right
          (s j : D.forms.section (V j))}

/-- The sheaf law identifies every compatible local family with a unique
global covariant field. -/
theorem compatibleGaugeFamily_existsUniqueGlobal
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type uSheafX} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i)
    (s : CompatibleGaugeFamily D V) :
    ∃! u : qGaugeForms (D.action U), ∀ i,
      D.forms.restrict (hVU i)
          (u : D.forms.section U) =
        (s.1 i : D.forms.section (V i)) := by
  simpa only using
    D.covariant_gluing_existsUnique (ι := ι) (U := U)
      V hVU hcover (fun i => s.1 i) (fun i j => s.2 i j)

/-- Restriction of a global covariant gauge form to a compatible family on a
cover. -/
def restrictionToCompatibleGaugeFamily
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type*} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (u : qGaugeForms (D.action U)) :
    CompatibleGaugeFamily D V := by
  refine ⟨fun i =>
    ⟨D.forms.restrict (hVU i) (u : D.forms.section U),
      D.restrict_mem_qGaugeForms (hVU i) u⟩, ?_⟩
  intro i j
  change
    D.forms.restrict inf_le_left
        (D.forms.restrict (hVU i) (u : D.forms.section U)) =
      D.forms.restrict inf_le_right
        (D.forms.restrict (hVU j) (u : D.forms.section U))
  calc
    _ = D.forms.restrict (inf_le_left.trans (hVU i))
          (u : D.forms.section U) :=
      D.forms.restrict_comp (hVU i) inf_le_left _
    _ = D.forms.restrict (inf_le_right.trans (hVU j))
          (u : D.forms.section U) :=
      congrArg
        (fun h : V i ⊓ V j ≤ U =>
          D.forms.restrict h (u : D.forms.section U))
        (Subsingleton.elim _ _)
    _ = _ :=
      (D.forms.restrict_comp (hVU j) inf_le_right _).symm

@[simp]
theorem coe_restrictionToCompatibleGaugeFamily_apply
    {X E : Type*} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type*} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (u : qGaugeForms (D.action U)) (i : ι) :
    ((restrictionToCompatibleGaugeFamily D V hVU u).1 i :
        D.forms.section (V i)) =
      D.forms.restrict (hVU i) (u : D.forms.section U) :=
  rfl

/-- Locality makes restriction to a cover injective. -/
theorem restrictionToCompatibleGaugeFamily_injective
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type uSheafX} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i) :
    Function.Injective (restrictionToCompatibleGaugeFamily D V hVU) := by
  intro u v huv
  apply Subtype.ext
  apply D.sheaf_condition.locality V hVU hcover
  intro i
  have hi := congrArg
    (fun s : CompatibleGaugeFamily D V =>
      (s.1 i : D.forms.section (V i))) huv
  simpa only [coe_restrictionToCompatibleGaugeFamily_apply] using hi

/-- Unique gauge gluing makes restriction to a cover surjective. -/
theorem restrictionToCompatibleGaugeFamily_surjective
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type uSheafX} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i) :
    Function.Surjective (restrictionToCompatibleGaugeFamily D V hVU) := by
  intro s
  rcases compatibleGaugeFamily_existsUniqueGlobal D V hVU hcover s with
    ⟨u, hu, _⟩
  refine ⟨u, ?_⟩
  apply Subtype.ext
  funext i
  apply Subtype.ext
  simpa only [coe_restrictionToCompatibleGaugeFamily_apply] using hu i

/-- Restriction to an open cover is bijective onto compatible covariant
families. -/
theorem restrictionToCompatibleGaugeFamily_bijective
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type uSheafX} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i) :
    Function.Bijective (restrictionToCompatibleGaugeFamily D V hVU) :=
  ⟨restrictionToCompatibleGaugeFamily_injective D V hVU hcover,
    restrictionToCompatibleGaugeFamily_surjective D V hVU hcover⟩

/-- **Corrected Proposition 20.** Global covariant sections are exactly
compatible local covariant sections on the cover. -/
noncomputable def globalGaugeFormsEquivCompatibleGaugeFamily
    {X : Type uSheafX} {E : Type uSheafE} [TopologicalSpace X]
    [AddCommGroup E] [Module ℂ E]
    {ι : Type uSheafX} (D : GaugeDescentSheaf X E)
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U)
    (hcover : U ≤ ⨆ i, V i) :
    qGaugeForms (D.action U) ≃ CompatibleGaugeFamily D V :=
  Equiv.ofBijective
    (restrictionToCompatibleGaugeFamily D V hVU)
    (restrictionToCompatibleGaugeFamily_bijective D V hVU hcover)

/-- Concrete Proposition 20 for the directly constructed trivial-bundle gauge
sheaf. -/
noncomputable def trivialBundleGlobalSectionsEquivCompatibleGaugeFamily
    {X : Type uSheafX} {Fiber : Type uSheafE}
    {ι : Type uSheafX} [TopologicalSpace X]
    [AddCommGroup Fiber] [Module ℂ Fiber]
    {U : TopologicalSpace.Opens X}
    (V : ι → TopologicalSpace.Opens X)
    (hVU : ∀ i, V i ≤ U) (hcover : U ≤ ⨆ i, V i) :
    qGaugeForms
        ((TrivialBundleSectionSheaf.gaugeSheaf
          (X := X) (Fiber := Fiber)).action U) ≃
      CompatibleGaugeFamily
        (TrivialBundleSectionSheaf.gaugeSheaf
          (X := X) (Fiber := Fiber)) V :=
  globalGaugeFormsEquivCompatibleGaugeFamily
    (TrivialBundleSectionSheaf.gaugeSheaf
      (X := X) (Fiber := Fiber)) V hVU hcover

end GlobalEqualizer

/-! ### Proposition 21: lcm kernel, generalized CRT, and the cyclic Tor model -/

namespace CRTTorBridge

/-- The actual Mathlib derived-functor target for the cyclic Tor computation.
Mathlib's `Tor` derives the second variable. -/
abbrev ActualCyclicTorOne (M N : ℕ) : ModuleCat ℤ :=
  (((CategoryTheory.Tor (ModuleCat ℤ) 1).obj
      (ModuleCat.of ℤ (ZMod M))).obj
    (ModuleCat.of ℤ (ZMod N)))

/-- Being divisible by both moduli is exactly divisibility by their lcm. -/
theorem commonMultiple_iff_lcm_dvd (M N n : ℕ) :
    (M ∣ n ∧ N ∣ n) ↔ Nat.lcm M N ∣ n := by
  constructor
  · rintro ⟨hM, hN⟩
    exact Nat.lcm_dvd hM hN
  · intro h
    exact ⟨(Nat.dvd_lcm_left M N).trans h,
      (Nat.dvd_lcm_right M N).trans h⟩

/-- The comparison map from integers to the two residue groups. -/
def comparisonMap (M N : ℕ) : ℤ →+ ZMod M × ZMod N :=
  (Int.castAddHom (ZMod M)).prod (Int.castAddHom (ZMod N))

@[simp]
theorem comparisonMap_apply (M N : ℕ) (z : ℤ) :
    comparisonMap M N z = ((z : ZMod M), (z : ZMod N)) :=
  rfl

/-- The integer kernel is the intersection ideal, equivalently the kernel of
reduction modulo `lcm M N`. -/
theorem comparisonMap_ker (M N : ℕ) :
    (comparisonMap M N).ker =
      (Int.castAddHom (ZMod (Nat.lcm M N))).ker := by
  ext z
  simp only [AddMonoidHom.mem_ker, comparisonMap_apply, Prod.mk_eq_zero,
    Int.coe_castAddHom, ZMod.intCast_zmod_eq_zero_iff_dvd]
  constructor
  · rintro ⟨hM, hN⟩
    exact Int.coe_lcm_dvd hM hN
  · intro h
    exact ⟨(Int.ofNat_dvd.mpr (Nat.dvd_lcm_left M N)).trans h,
      (Int.ofNat_dvd.mpr (Nat.dvd_lcm_right M N)).trans h⟩

/-- Multiplication by the lcm, as the left map in the generalized CRT
complex. -/
def lcmMultiplicationMap (M N : ℕ) : ℤ →+ ℤ :=
  AddMonoidHom.mulLeft (Nat.lcm M N : ℤ)

@[simp]
theorem lcmMultiplicationMap_apply (M N : ℕ) (z : ℤ) :
    lcmMultiplicationMap M N z = (Nat.lcm M N : ℤ) * z :=
  rfl

/-- The leading lcm-multiplication map is injective in the nondegenerate regime
needed to prepend `0` to the CRT complex. -/
theorem lcmMultiplicationMap_injective
    (M N : ℕ) (hlcm : Nat.lcm M N ≠ 0) :
    Function.Injective (lcmMultiplicationMap M N) := by
  intro x y hxy
  exact mul_left_cancel₀ (Int.ofNat_ne_zero.mpr hlcm) <| by
    simpa only [lcmMultiplicationMap_apply] using hxy

/-- Exactness at the integer term of the generalized CRT complex. -/
theorem lcmMultiplicationMap_comparisonMap_exact (M N : ℕ) :
    Function.Exact (lcmMultiplicationMap M N) (comparisonMap M N) := by
  intro z
  constructor
  · intro hz
    have hzmem : z ∈ (comparisonMap M N).ker :=
      (AddMonoidHom.mem_ker).2 hz
    rw [comparisonMap_ker M N] at hzmem
    have hzero : ((z : ℤ) : ZMod (Nat.lcm M N)) = 0 := by
      simpa only [AddMonoidHom.mem_ker, Int.coe_castAddHom] using hzmem
    have hdvd : (Nat.lcm M N : ℤ) ∣ z :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd z (Nat.lcm M N)).mp hzero
    rcases hdvd with ⟨k, hk⟩
    refine ⟨k, ?_⟩
    simpa only [lcmMultiplicationMap_apply] using hk.symm
  · rintro ⟨k, rfl⟩
    have hzero :
        ((lcmMultiplicationMap M N k : ℤ) :
          ZMod (Nat.lcm M N)) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd
        (lcmMultiplicationMap M N k) (Nat.lcm M N)).2 ⟨k, rfl⟩
    have hmem :
        lcmMultiplicationMap M N k ∈
          (Int.castAddHom (ZMod (Nat.lcm M N))).ker := by
      simpa only [AddMonoidHom.mem_ker, Int.coe_castAddHom] using hzero
    rw [← comparisonMap_ker M N] at hmem
    exact (AddMonoidHom.mem_ker).1 hmem

/-- Generalized CRT: a pair of residues has a simultaneous representative
exactly when it agrees modulo the gcd. -/
theorem compatible_iff_exists_crt (M N a b : ℕ) :
    a ≡ b [MOD Nat.gcd N M] ↔
      ∃ x, x ≡ a [MOD N] ∧ x ≡ b [MOD M] := by
  constructor
  · intro h
    exact ⟨Nat.chineseRemainder' h,
      (Nat.chineseRemainder' h).property⟩
  · rintro ⟨x, hxN, hxM⟩
    exact
      (Nat.ModEq.of_dvd (Nat.gcd_dvd_left N M) hxN).symm.trans
        (Nat.ModEq.of_dvd (Nat.gcd_dvd_right N M) hxM)

/-- The generalized-CRT obstruction: two residues must agree modulo
`gcd M N`. -/
def crtObstructionMap (M N : ℕ) :
    ZMod M × ZMod N →+ ZMod (Nat.gcd M N) where
  toFun x :=
    ZMod.castHom (Nat.gcd_dvd_left M N) (ZMod (Nat.gcd M N)) x.1 -
      ZMod.castHom (Nat.gcd_dvd_right M N) (ZMod (Nat.gcd M N)) x.2
  map_zero' := by simp
  map_add' x y := by
    change
      ZMod.castHom (Nat.gcd_dvd_left M N) (ZMod (Nat.gcd M N))
          (x.1 + y.1) -
        ZMod.castHom (Nat.gcd_dvd_right M N) (ZMod (Nat.gcd M N))
          (x.2 + y.2) =
      (ZMod.castHom (Nat.gcd_dvd_left M N) (ZMod (Nat.gcd M N)) x.1 -
        ZMod.castHom (Nat.gcd_dvd_right M N) (ZMod (Nat.gcd M N)) x.2) +
      (ZMod.castHom (Nat.gcd_dvd_left M N) (ZMod (Nat.gcd M N)) y.1 -
        ZMod.castHom (Nat.gcd_dvd_right M N) (ZMod (Nat.gcd M N)) y.2)
    rw [map_add, map_add]
    abel

@[simp]
theorem crtObstructionMap_apply
    (M N : ℕ) (x : ZMod M × ZMod N) :
    crtObstructionMap M N x =
      ZMod.castHom (Nat.gcd_dvd_left M N) (ZMod (Nat.gcd M N)) x.1 -
        ZMod.castHom (Nat.gcd_dvd_right M N) (ZMod (Nat.gcd M N)) x.2 :=
  rfl

/-- Generalized CRT exactness at the middle term.  The proof works for all
natural moduli, including `M = 0` or `N = 0`, by using integer representatives
and Bézout's identity rather than finite-cardinality arguments. -/
theorem comparisonMap_crtObstructionMap_exact (M N : ℕ) :
    Function.Exact (comparisonMap M N) (crtObstructionMap M N) := by
  rintro ⟨a, b⟩
  constructor
  · intro h
    obtain ⟨za, rfl⟩ := ZMod.intCast_surjective a
    obtain ⟨zb, rfl⟩ := ZMod.intCast_surjective b
    have hzero :
        ((za - zb : ℤ) : ZMod (Nat.gcd M N)) = 0 := by
      change
        (ZMod.cast (za : ZMod M) : ZMod (Nat.gcd M N)) -
          (ZMod.cast (zb : ZMod N) : ZMod (Nat.gcd M N)) = 0 at h
      rw [ZMod.cast_intCast (Nat.gcd_dvd_left M N),
        ZMod.cast_intCast (Nat.gcd_dvd_right M N)] at h
      rw [Int.cast_sub]
      exact h
    have hdvd : (Nat.gcd M N : ℤ) ∣ za - zb :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd
        (za - zb) (Nat.gcd M N)).mp hzero
    rcases hdvd with ⟨k, hk⟩
    let z : ℤ := za - (M : ℤ) * Nat.gcdA M N * k
    have hzM : (z : ZMod M) = (za : ZMod M) := by
      apply (ZMod.intCast_eq_intCast_iff_dvd_sub z za M).2
      refine ⟨Nat.gcdA M N * k, ?_⟩
      dsimp [z]
      ring
    have hzN : (z : ZMod N) = (zb : ZMod N) := by
      apply (ZMod.intCast_eq_intCast_iff_dvd_sub z zb N).2
      refine ⟨-(Nat.gcdB M N * k), ?_⟩
      dsimp [z]
      calc
        zb - (za - (M : ℤ) * Nat.gcdA M N * k) =
            -(za - zb) + (M : ℤ) * Nat.gcdA M N * k := by
              ring
        _ = -((Nat.gcd M N : ℤ) * k) +
              (M : ℤ) * Nat.gcdA M N * k := by
              rw [hk]
        _ = (N : ℤ) * (-(Nat.gcdB M N * k)) := by
              rw [Nat.gcd_eq_gcd_ab]
              ring
    refine ⟨z, ?_⟩
    rw [comparisonMap_apply]
    exact Prod.ext hzM hzN
  · rintro ⟨z, hz⟩
    rw [← hz]
    change
      (ZMod.cast (z : ZMod M) : ZMod (Nat.gcd M N)) -
        (ZMod.cast (z : ZMod N) : ZMod (Nat.gcd M N)) = 0
    rw [ZMod.cast_intCast (Nat.gcd_dvd_left M N),
      ZMod.cast_intCast (Nat.gcd_dvd_right M N)]
    exact sub_self _

/-- The terminal generalized-CRT obstruction map is surjective, including for
degenerate moduli. -/
theorem crtObstructionMap_surjective (M N : ℕ) :
    Function.Surjective (crtObstructionMap M N) := by
  intro c
  obtain ⟨a, ha⟩ :=
    ZMod.castHom_surjective (Nat.gcd_dvd_left M N) c
  refine ⟨(a, 0), ?_⟩
  simpa [crtObstructionMap] using ha

/-- Kernel form of the same generalized CRT compatibility condition. -/
theorem simultaneousKernel_iff_lcm
    (M N n : ℕ) :
    (n ≡ 0 [MOD M] ∧ n ≡ 0 [MOD N]) ↔
      n ≡ 0 [MOD Nat.lcm M N] := by
  simp only [Nat.modEq_zero_iff_dvd]
  exact commonMultiple_iff_lcm_dvd M N n

/-- Multiplication by `M` in the standard two-term cyclic presentation. -/
def cyclicResolutionDifferential (M : ℕ) : ℤ →+ ℤ :=
  AddMonoidHom.mulLeft (M : ℤ)

/-- The standard augmentation from the free rank-one module to `ZMod M`. -/
def cyclicResolutionAugmentation (M : ℕ) : ℤ →+ ZMod M :=
  Int.castAddHom (ZMod M)

@[simp]
theorem cyclicResolutionDifferential_apply (M : ℕ) (z : ℤ) :
    cyclicResolutionDifferential M z = (M : ℤ) * z :=
  rfl

@[simp]
theorem cyclicResolutionAugmentation_apply (M : ℕ) (z : ℤ) :
    cyclicResolutionAugmentation M z = (z : ZMod M) :=
  rfl

/-- The first differential is injective exactly in the nondegenerate regime
needed for the standard two-term free resolution. -/
theorem cyclicResolutionDifferential_injective
    (M : ℕ) (hM : M ≠ 0) :
    Function.Injective (cyclicResolutionDifferential M) := by
  intro x y hxy
  apply mul_left_cancel₀ (Int.ofNat_ne_zero.mpr hM)
  simpa [cyclicResolutionDifferential] using hxy

/-- Exactness at the middle free rank-one term of the cyclic presentation. -/
theorem cyclicResolution_exact (M : ℕ) :
    Function.Exact (cyclicResolutionDifferential M)
      (cyclicResolutionAugmentation M) := by
  intro z
  constructor
  · intro hz
    have hzero : ((z : ℤ) : ZMod M) = 0 := by
      simpa [cyclicResolutionAugmentation] using hz
    have hdvd : (M : ℤ) ∣ z :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd z M).mp hzero
    rcases hdvd with ⟨k, hk⟩
    refine ⟨k, ?_⟩
    simpa [cyclicResolutionDifferential] using hk.symm
  · rintro ⟨k, rfl⟩
    have hzero : (((M : ℤ) * k : ℤ) : ZMod M) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd ((M : ℤ) * k) M).2
        ⟨k, rfl⟩
    simpa [cyclicResolutionDifferential,
      cyclicResolutionAugmentation] using hzero

/-- The cyclic presentation terminates in a surjective augmentation. -/
theorem cyclicResolutionAugmentation_surjective (M : ℕ) :
    Function.Surjective (cyclicResolutionAugmentation M) :=
  ZMod.intCast_surjective

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped ZeroObject

/-- The zero tail used by the two-term free complex. -/
def cyclicFreeSuccessor {X₀ X₁ : ModuleCat ℤ} (f : X₁ ⟶ X₀) :
    Σ' (X₂ : ModuleCat ℤ) (d : X₂ ⟶ X₁), d ≫ f = 0 :=
  ⟨0, 0, by simp⟩

/-- The explicit chain complex `... → 0 → ℤ --N→ ℤ`. -/
def cyclicFreeComplex (N : ℕ) : ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.mk' (ModuleCat.of ℤ ℤ) (ModuleCat.of ℤ ℤ)
    (ModuleCat.ofHom (cyclicResolutionDifferential N).toIntLinearMap)
    cyclicFreeSuccessor

@[simp]
theorem cyclicFreeComplex_d_one_zero (N : ℕ) :
    (cyclicFreeComplex N).d 1 0 =
      ModuleCat.ofHom (cyclicResolutionDifferential N).toIntLinearMap := by
  exact ChainComplex.mk'_d_1_0 _ _ _ _

@[simp]
theorem cyclicFreeComplex_d_succ_succ (N n : ℕ) :
    (cyclicFreeComplex N).d (n + 2) (n + 1) = 0 := by
  simp [cyclicFreeComplex, ChainComplex.mk'_d, cyclicFreeSuccessor] <;> rfl

theorem cyclicFreeComplex_isZero_succ_succ (N n : ℕ) :
    IsZero ((cyclicFreeComplex N).X (n + 2)) := by
  refine IsZero.of_iso (isZero_zero _) ?_
  simpa [cyclicFreeComplex, cyclicFreeSuccessor] using
    (ChainComplex.mk'XIso (ModuleCat.of ℤ ℤ) (ModuleCat.of ℤ ℤ)
      (ModuleCat.ofHom (cyclicResolutionDifferential N).toIntLinearMap)
      cyclicFreeSuccessor n)

theorem cyclicFreeComplex_d_comp_augmentation (N : ℕ) :
    (cyclicFreeComplex N).d 1 0 ≫
      ModuleCat.ofHom
        (cyclicResolutionAugmentation N).toIntLinearMap = 0 := by
  rw [cyclicFreeComplex_d_one_zero]
  apply ModuleCat.hom_ext
  ext
  change cyclicResolutionAugmentation N
      (cyclicResolutionDifferential N 1) = 0
  exact (cyclicResolution_exact N _).2 ⟨1, rfl⟩

/-- Augmentation of the explicit free complex to the cyclic module. -/
noncomputable def cyclicFreeAugmentation (N : ℕ) :
    cyclicFreeComplex N ⟶
      (ChainComplex.single₀ (ModuleCat ℤ)).obj
        (ModuleCat.of ℤ (ZMod N)) :=
  (ChainComplex.toSingle₀Equiv _ _).symm
    ⟨ModuleCat.ofHom
        (cyclicResolutionAugmentation N).toIntLinearMap,
      cyclicFreeComplex_d_comp_augmentation N⟩

@[simp]
theorem cyclicFreeAugmentation_f_zero (N : ℕ) :
    (cyclicFreeAugmentation N).f 0 =
      ModuleCat.ofHom
        (cyclicResolutionAugmentation N).toIntLinearMap := by
  unfold cyclicFreeAugmentation
  rfl

/-- The degree-zero short complex underlying the cyclic presentation. -/
def cyclicPresentationShortComplex (N : ℕ) :
    ShortComplex (ModuleCat ℤ) :=
  ShortComplex.moduleCatMk
    (cyclicResolutionDifferential N).toIntLinearMap
    (cyclicResolutionAugmentation N).toIntLinearMap
    (by
      ext z
      simp [cyclicResolutionDifferential,
        cyclicResolutionAugmentation])

theorem cyclicPresentationShortComplex_exact (N : ℕ) :
    (cyclicPresentationShortComplex N).Exact := by
  apply (ShortComplex.moduleCat_exact_iff _).2
  intro z hz
  exact (cyclicResolution_exact N z).1 hz

theorem cyclicPresentationShortComplex_epi (N : ℕ) :
    Epi (cyclicPresentationShortComplex N).g := by
  apply (ModuleCat.epi_iff_surjective _).2
  intro z
  exact cyclicResolutionAugmentation_surjective N z

theorem cyclicFreeComplex_exactAt_succ
    (N : ℕ) (hN : N ≠ 0) (n : ℕ) :
    (cyclicFreeComplex N).ExactAt (n + 1) := by
  cases n with
  | zero =>
      rw [HomologicalComplex.exactAt_iff' _ 2 1 0
        (by simp) (by simp)]
      apply
        (ShortComplex.exact_iff_mono _
          (cyclicFreeComplex_d_succ_succ N 0)).2
      change Mono ((cyclicFreeComplex N).d 1 0)
      rw [cyclicFreeComplex_d_one_zero]
      exact (ModuleCat.mono_iff_injective _).2
        (cyclicResolutionDifferential_injective N hN)
  | succ n =>
      rw [HomologicalComplex.exactAt_iff' _ (n + 3) (n + 2) (n + 1)
        (by simp) (by simp)]
      exact ShortComplex.exact_of_isZero_X₂ _
        (cyclicFreeComplex_isZero_succ_succ N n)

theorem intRankOne_projective : Projective (ModuleCat.of ℤ ℤ) := by
  infer_instance

theorem cyclicFreeComplex_projective (N n : ℕ) :
    Projective ((cyclicFreeComplex N).X n) := by
  obtain _ | _ | n := n
  · simpa [cyclicFreeComplex] using intRankOne_projective
  · simpa [cyclicFreeComplex] using intRankOne_projective
  · exact (cyclicFreeComplex_isZero_succ_succ N n).projective

theorem cyclicFreeAugmentation_quasiIsoAt_zero (N : ℕ) :
    QuasiIsoAt (cyclicFreeAugmentation N) 0 := by
  rw [ChainComplex.quasiIsoAt₀_iff,
    ShortComplex.quasiIso_iff_of_zeros']
  · refine (ShortComplex.exact_and_epi_g_iff_of_iso ?_).2
      ⟨cyclicPresentationShortComplex_exact N,
        cyclicPresentationShortComplex_epi N⟩
    exact ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
      (by
        simp only [Category.id_comp, Category.comp_id]
        exact (cyclicFreeComplex_d_one_zero N).symm)
      (by
        simp only [Category.id_comp, Category.comp_id]
        exact (cyclicFreeAugmentation_f_zero N).symm)
  all_goals rfl

theorem cyclicFreeAugmentation_quasiIsoAt_succ
    (N : ℕ) (hN : N ≠ 0) (n : ℕ) :
    QuasiIsoAt (cyclicFreeAugmentation N) (n + 1) := by
  rw [quasiIsoAt_iff_exactAt']
  · exact cyclicFreeComplex_exactAt_succ N hN n
  · exact ChainComplex.exactAt_succ_single_obj _ _

/-- The explicit two-term projective resolution of `ZMod N`, valid for
nonzero `N`. -/
noncomputable def cyclicProjectiveResolution
    (N : ℕ) (hN : N ≠ 0) :
    ProjectiveResolution (ModuleCat.of ℤ (ZMod N)) where
  complex := cyclicFreeComplex N
  projective := cyclicFreeComplex_projective N
  π := cyclicFreeAugmentation N
  quasiIso := by
    rw [quasiIso_iff]
    intro n
    cases n with
    | zero => exact cyclicFreeAugmentation_quasiIsoAt_zero N
    | succ n => exact cyclicFreeAugmentation_quasiIsoAt_succ N hN n

/-- Tensoring by the first cyclic factor; Mathlib `Tor` derives the second. -/
abbrev cyclicTensorFunctor (M : ℕ) : ModuleCat ℤ ⥤ ModuleCat ℤ :=
  (tensoringLeft (ModuleCat ℤ)).obj (ModuleCat.of ℤ (ZMod M))

/-- The explicit cyclic resolution after applying the tensor functor. -/
abbrev tensorCyclicResolutionComplex (M N : ℕ) :
    ChainComplex (ModuleCat ℤ) ℕ :=
  ((cyclicTensorFunctor M).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
    (cyclicFreeComplex N)

/-- Literal Mathlib `CategoryTheory.Tor` is the first homology of the mapped
explicit projective resolution. -/
noncomputable def actualCyclicTorOneIsoTensorHomology
    (M N : ℕ) (hN : N ≠ 0) :
    ActualCyclicTorOne M N ≅
      (tensorCyclicResolutionComplex M N).homology 1 := by
  change
    (((cyclicTensorFunctor M).leftDerived 1).obj
      (ModuleCat.of ℤ (ZMod N))) ≅ _
  exact
    (cyclicProjectiveResolution N hN).isoLeftDerivedObj
      (cyclicTensorFunctor M) 1

/-- The explicit `X₂ → X₁ → X₀` short complex in degree one after tensoring. -/
abbrev tensorCyclicShortComplex (M N : ℕ) :
    ShortComplex (ModuleCat ℤ) :=
  (tensorCyclicResolutionComplex M N).sc' 2 1 0

/-- The incoming degree-two object remains zero after the additive tensor
functor. -/
theorem tensorCyclicShortComplex_isZero_X₁ (M N : ℕ) :
    IsZero (tensorCyclicShortComplex M N).X₁ := by
  change IsZero
    ((cyclicTensorFunctor M).obj ((cyclicFreeComplex N).X 2))
  exact (cyclicTensorFunctor M).map_isZero
    (cyclicFreeComplex_isZero_succ_succ N 0)

/-- Hence the map from boundaries into cycles is zero. -/
theorem tensorCyclicShortComplex_toCycles_eq_zero (M N : ℕ) :
    (tensorCyclicShortComplex M N).moduleCatToCycles = 0 := by
  letI : Subsingleton (tensorCyclicShortComplex M N).X₁ :=
    ModuleCat.subsingleton_of_isZero
      (tensorCyclicShortComplex_isZero_X₁ M N)
  ext x
  have hx : x = 0 := Subsingleton.elim _ _
  subst x
  simp

/-- There are no degree-one boundaries. -/
theorem tensorCyclicShortComplex_boundaryRange_eq_bot (M N : ℕ) :
    LinearMap.range
      (tensorCyclicShortComplex M N).moduleCatToCycles = ⊥ := by
  rw [tensorCyclicShortComplex_toCycles_eq_zero,
    LinearMap.range_zero]

/-- First homology is the kernel of the outgoing mapped differential. -/
noncomputable def tensorCyclicHomologyIsoDifferentialKernel
    (M N : ℕ) :
    (tensorCyclicResolutionComplex M N).homology 1 ≅
      ModuleCat.of ℤ
        (LinearMap.ker (tensorCyclicShortComplex M N).g.hom) :=
  (tensorCyclicResolutionComplex M N).homologyIsoSc'
      2 1 0 (by simp) (by simp) ≪≫
    (tensorCyclicShortComplex M N).moduleCatHomologyIso ≪≫
    ((LinearMap.range
      (tensorCyclicShortComplex M N).moduleCatToCycles).quotEquivOfEqBot
        (tensorCyclicShortComplex_boundaryRange_eq_bot M N)).toModuleIso

/-- The raw kernel of multiplication by `M` on `ZMod N`.  When `M ≠ 0`, this is
the degree-one kernel obtained by tensoring the standard two-term free
resolution of `ZMod M` with `ZMod N`. -/
def CyclicTorOneModel (M N : ℕ) : AddSubgroup (ZMod N) :=
  (nsmulAddMonoidHom M : ZMod N →+ ZMod N).ker

/-- Raw `H₁` kernel in the orientation obtained by resolving the first cyclic
factor.  The name deliberately says `KernelModel`, not derived `Tor`. -/
abbrev FirstVariableCyclicKernelModel (M N : ℕ) :=
  CyclicTorOneModel M N

/-- Raw kernel in Mathlib's `Tor` orientation, where the second cyclic factor is
the variable resolved by the left-derived functor. -/
abbrev SecondVariableCyclicKernelModel (M N : ℕ) :=
  CyclicTorOneModel N M

/-- The comparison object for upgrading the raw kernel calculation to a
theorem about Mathlib's derived `CategoryTheory.Tor`.  It is inhabited below
from the explicit projective resolution whenever the resolved modulus is
nonzero. -/
def ActualCyclicTorOneSecondKernelComparison (M N : ℕ) : Prop :=
  Nonempty
    (ActualCyclicTorOne M N ≅
      ModuleCat.of ℤ (SecondVariableCyclicKernelModel M N))

/-- Multiplication by `N` on the first cyclic factor, as an `ℤ`-linear map. -/
def cyclicNsmulLinearMap (N M : ℕ) : ZMod M →ₗ[ℤ] ZMod M :=
  (nsmulAddMonoidHom N : ZMod M →+ ZMod M).toIntLinearMap

/-- The free-resolution differential is scalar multiplication by `N`. -/
theorem cyclicResolutionDifferential_morphism_eq_zsmul_id (N : ℕ) :
    ModuleCat.ofHom (cyclicResolutionDifferential N).toIntLinearMap =
      (N : ℤ) • 𝟙 (ModuleCat.of ℤ ℤ) := by
  ext z
  simp [cyclicResolutionDifferential, smul_eq_mul]

/-- The concrete target endomorphism is the same scalar multiple of identity. -/
theorem cyclicNsmul_morphism_eq_zsmul_id (N M : ℕ) :
    ModuleCat.ofHom (cyclicNsmulLinearMap N M) =
      (N : ℤ) • 𝟙 (ModuleCat.of ℤ (ZMod M)) := by
  ext x
  simp [cyclicNsmulLinearMap]

/-- Right unitor for tensoring the cyclic module with the free rank-one
module. -/
abbrev tensorCyclicRightUnitor (M : ℕ) :
    (cyclicTensorFunctor M).obj (ModuleCat.of ℤ ℤ) ≅
      ModuleCat.of ℤ (ZMod M) :=
  ρ_ (ModuleCat.of ℤ (ZMod M))

/-- The mapped outgoing differential is again `N` times identity. -/
theorem tensorCyclicShortComplex_g_eq_zsmul_id (M N : ℕ) :
    (tensorCyclicShortComplex M N).g =
      (N : ℤ) • 𝟙 ((tensorCyclicShortComplex M N).X₂) := by
  change
    (cyclicTensorFunctor M).map ((cyclicFreeComplex N).d 1 0) = _
  rw [cyclicFreeComplex_d_one_zero,
    cyclicResolutionDifferential_morphism_eq_zsmul_id]
  change
    (cyclicTensorFunctor M).map
        ((N : ℤ) • 𝟙 (ModuleCat.of ℤ ℤ)) =
      (N : ℤ) • 𝟙 ((cyclicTensorFunctor M).obj (ModuleCat.of ℤ ℤ))
  rw [Functor.map_zsmul]
  exact congrArg (fun f => (N : ℤ) • f)
    ((cyclicTensorFunctor M).map_id (ModuleCat.of ℤ ℤ))

/-- The right unitor intertwines the mapped differential and concrete
`N`-multiplication. -/
theorem tensorCyclicShortComplex_g_unitor_comm (M N : ℕ) :
    (tensorCyclicShortComplex M N).g ≫
        (tensorCyclicRightUnitor M).hom =
      (tensorCyclicRightUnitor M).hom ≫
        ModuleCat.ofHom (cyclicNsmulLinearMap N M) := by
  rw [tensorCyclicShortComplex_g_eq_zsmul_id,
    cyclicNsmul_morphism_eq_zsmul_id]
  change
    ((N : ℤ) • 𝟙 ((cyclicTensorFunctor M).obj (ModuleCat.of ℤ ℤ))) ≫
        (tensorCyclicRightUnitor M).hom =
      (tensorCyclicRightUnitor M).hom ≫
        ((N : ℤ) • 𝟙 (ModuleCat.of ℤ (ZMod M)))
  rw [Preadditive.zsmul_comp, Category.id_comp,
    Preadditive.comp_zsmul, Category.comp_id]

/-- Transport kernels through a conjugating linear equivalence. -/
def linearEquivKerOfComm
    {R A B : Type*} [Semiring R]
    [AddCommMonoid A] [Module R A]
    [AddCommMonoid B] [Module R B]
    (e : A ≃ₗ[R] B) (f : A →ₗ[R] A) (g : B →ₗ[R] B)
    (h : e.toLinearMap.comp f = g.comp e.toLinearMap) :
    LinearMap.ker f ≃ₗ[R] LinearMap.ker g where
  toFun x := ⟨e x, by
    calc
      g (e x) = e (f x) := (LinearMap.congr_fun h x).symm
      _ = e 0 := congrArg e x.property
      _ = 0 := map_zero e⟩
  invFun y := ⟨e.symm y, by
    apply e.injective
    calc
      e (f (e.symm y)) = g (e (e.symm y)) :=
        LinearMap.congr_fun h (e.symm y)
      _ = g y := by rw [e.apply_symm_apply]
      _ = 0 := y.property
      _ = e 0 := (map_zero e).symm⟩
  left_inv x := Subtype.ext (e.symm_apply_apply x)
  right_inv y := Subtype.ext (e.apply_symm_apply y)
  map_add' x y := Subtype.ext (e.map_add x y)
  map_smul' r x := Subtype.ext (e.map_smul r x)

/-- The linear-map kernel and the pre-existing additive kernel model are
identical. -/
def cyclicNsmulKernelLinearEquiv (N M : ℕ) :
    LinearMap.ker (cyclicNsmulLinearMap N M) ≃ₗ[ℤ]
      CyclicTorOneModel N M where
  toFun x := ⟨x, by
    have hx := x.property
    change cyclicNsmulLinearMap N M x = 0 at hx
    change N • (x : ZMod M) = 0
    exact hx⟩
  invFun x := ⟨x, by
    have hx := x.property
    change N • (x : ZMod M) = 0 at hx
    change cyclicNsmulLinearMap N M x = 0
    exact hx⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The mapped differential kernel is the raw cyclic kernel model. -/
noncomputable def tensorCyclicDifferentialKernelLinearEquiv (M N : ℕ) :
    LinearMap.ker (tensorCyclicShortComplex M N).g.hom ≃ₗ[ℤ]
      CyclicTorOneModel N M :=
  (linearEquivKerOfComm
    (tensorCyclicRightUnitor M).toLinearEquiv
    (tensorCyclicShortComplex M N).g.hom
    (cyclicNsmulLinearMap N M)
    (ModuleCat.hom_ext_iff.mp
      (tensorCyclicShortComplex_g_unitor_comm M N))).trans
    (cyclicNsmulKernelLinearEquiv N M)

/-- Literal derived Tor compared with the correct second-variable raw kernel. -/
noncomputable def actualCyclicTorOneIsoSecondKernel
    (M N : ℕ) (hN : N ≠ 0) :
    ActualCyclicTorOne M N ≅
      ModuleCat.of ℤ (SecondVariableCyclicKernelModel M N) :=
  actualCyclicTorOneIsoTensorHomology M N hN ≪≫
    tensorCyclicHomologyIsoDifferentialKernel M N ≪≫
    (tensorCyclicDifferentialKernelLinearEquiv M N).toModuleIso

/-- The previously explicit comparison obligation is inhabited for every
nonzero resolved modulus. -/
theorem actualCyclicTorOneSecondKernelComparison_of_ne_zero
    (M N : ℕ) (hN : N ≠ 0) :
    ActualCyclicTorOneSecondKernelComparison M N :=
  ⟨actualCyclicTorOneIsoSecondKernel M N hN⟩

@[simp]
theorem mem_cyclicTorOneModel (M N : ℕ) (x : ZMod N) :
    x ∈ CyclicTorOneModel M N ↔ (M : ZMod N) * x = 0 := by
  simp [CyclicTorOneModel, nsmul_eq_mul]

/-- The nonzero-modulus hypothesis in the finite cyclic classification is
essential.  At modulus zero the resolution kernel for multiplication by two is
subsingleton, whereas `ZMod (gcd 2 0) = ZMod 2` is not. -/
theorem noCyclicTorOneModelEquiv_zeroModulus :
    ¬ Nonempty
      (CyclicTorOneModel 2 0 ≃+ ZMod (Nat.gcd 2 0)) := by
  rintro ⟨e⟩
  have hsource : Subsingleton (CyclicTorOneModel 2 0) := by
    constructor
    intro x y
    apply Subtype.ext
    have hxMul : (2 : ZMod 0) * (x : ZMod 0) = 0 :=
      (mem_cyclicTorOneModel 2 0 (x : ZMod 0)).mp x.property
    have hyMul : (2 : ZMod 0) * (y : ZMod 0) = 0 :=
      (mem_cyclicTorOneModel 2 0 (y : ZMod 0)).mp y.property
    have htwo : (2 : ZMod 0) ≠ 0 := by
      intro h
      have hdiv : 0 ∣ 2 := (ZMod.natCast_eq_zero_iff 2 0).mp h
      norm_num at hdiv
    have hx : (x : ZMod 0) = 0 :=
      (eq_zero_or_eq_zero_of_mul_eq_zero hxMul).resolve_left htwo
    have hy : (y : ZMod 0) = 0 :=
      (eq_zero_or_eq_zero_of_mul_eq_zero hyMul).resolve_left htwo
    exact hx.trans hy.symm
  letI : Subsingleton (CyclicTorOneModel 2 0) := hsource
  letI : Subsingleton (ZMod (Nat.gcd 2 0)) :=
    Equiv.subsingleton.symm e.toEquiv
  have hbad : Nat.gcd 2 0 = 1 :=
    ZMod.one_eq_zero_iff.mp
      (Subsingleton.elim (1 : ZMod (Nat.gcd 2 0)) 0)
  norm_num at hbad

/-- The finite raw multiplication kernel has exactly `gcd M N` elements. -/
theorem natCard_cyclicTorOneModel (M N : ℕ) [NeZero N] :
    Nat.card (CyclicTorOneModel M N) = Nat.gcd M N := by
  change Nat.card
      ((nsmulAddMonoidHom M : ZMod N →+ ZMod N).ker) = _
  calc
    _ = (Nat.card (ZMod N)).gcd M :=
      IsAddCyclic.card_nsmulAddMonoidHom_ker (ZMod N) M
    _ = Nat.gcd N M := by rw [Nat.card_zmod]
    _ = Nat.gcd M N := Nat.gcd_comm N M

/-- The two finite raw kernel orientations are noncanonically additively
equivalent.  This is not a `Tor ≅ Tor'` natural isomorphism. -/
noncomputable def cyclicKernelModelSwapAddEquiv
    (M N : ℕ) [NeZero M] [NeZero N] :
    CyclicTorOneModel M N ≃+ CyclicTorOneModel N M :=
  addEquivOfAddCyclicCardEq <| by
    calc
      Nat.card (CyclicTorOneModel M N) = Nat.gcd M N :=
        natCard_cyclicTorOneModel M N
      _ = Nat.gcd N M := Nat.gcd_comm M N
      _ = Nat.card (CyclicTorOneModel N M) :=
        (natCard_cyclicTorOneModel N M).symm

/-- Noncanonical additive classification of the finite raw multiplication
kernel.  The word `model` is deliberate: its free-resolution interpretation
additionally requires `M ≠ 0`, and comparison with `CategoryTheory.Tor` requires
a separate resolution-to-derived-functor isomorphism. -/
noncomputable def cyclicTorOneModelAddEquiv
    (M N : ℕ) [NeZero N] :
    CyclicTorOneModel M N ≃+ ZMod (Nat.gcd M N) :=
  addEquivOfAddCyclicCardEq <| by
    rw [natCard_cyclicTorOneModel, Nat.card_zmod]

/-- Proposition-valued packaging of the general noncanonical additive
classification. -/
theorem cyclicTorOneModel_existsAddEquiv
    (M N : ℕ) [NeZero N] :
    Nonempty (CyclicTorOneModel M N ≃+ ZMod (Nat.gcd M N)) :=
  ⟨cyclicTorOneModelAddEquiv M N⟩

/-- Classification of the raw cyclic kernel aligned with Mathlib's
second-variable `Tor` orientation. -/
noncomputable def secondVariableCyclicKernelAddEquiv
    (M N : ℕ) [NeZero M] :
    SecondVariableCyclicKernelModel M N ≃+
      ZMod (Nat.gcd M N) := by
  change CyclicTorOneModel N M ≃+ ZMod (Nat.gcd M N)
  rw [Nat.gcd_comm M N]
  exact cyclicTorOneModelAddEquiv N M

/-- Once the explicit derived-functor/kernel comparison has actually been
constructed, the raw kernel classification composes with it to give the desired
gcd object.  The comparison is an explicit argument, not a hidden field. -/
noncomputable def actualCyclicTorOneIsoGcd_ofComparison
    (M N : ℕ) [NeZero M]
    (hcomparison : ActualCyclicTorOneSecondKernelComparison M N) :
    ActualCyclicTorOne M N ≅
      ModuleCat.of ℤ (ZMod (Nat.gcd M N)) :=
  (Classical.choice hcomparison).trans
    (secondVariableCyclicKernelAddEquiv M N).toIntLinearEquiv.toModuleIso

/-- The derived cyclic `Tor₁` group is the cyclic group of gcd order when both
cyclic moduli are nonzero.  The hypotheses exclude the `ZMod 0 = ℤ`
degeneracies, for which the displayed gcd formula is false. -/
noncomputable def actualCyclicTorOneIsoGcd
    (M N : ℕ) (hM : M ≠ 0) (hN : N ≠ 0) :
    ActualCyclicTorOne M N ≅
      ModuleCat.of ℤ (ZMod (Nat.gcd M N)) := by
  letI : NeZero M := ⟨hM⟩
  exact actualCyclicTorOneIsoGcd_ofComparison M N
    (actualCyclicTorOneSecondKernelComparison_of_ne_zero M N hN)

/-- Proposition-valued form of the derived cyclic gcd classification. -/
theorem actualCyclicTorOneIsoGcd_exists
    (M N : ℕ) (hM : M ≠ 0) (hN : N ≠ 0) :
    Nonempty
      (ActualCyclicTorOne M N ≅
        ModuleCat.of ℤ (ZMod (Nat.gcd M N))) :=
  ⟨actualCyclicTorOneIsoGcd M N hM hN⟩

/-- If the resolved modulus is zero, multiplication by that modulus has the
entire ambient cyclic group as its kernel.  Thus this raw kernel cannot be the
homology of the usual two-term cyclic free resolution without a nonzero
resolved-modulus hypothesis. -/
@[simp]
theorem cyclicTorOneModel_zero_resolved (N : ℕ) :
    CyclicTorOneModel 0 N = ⊤ := by
  ext x
  simp [CyclicTorOneModel]

/-- Prime-power specialization of the raw kernel classification appearing in
the PDF. -/
noncomputable def primePowerCyclicTorOneModelAddEquiv
    (M p k : ℕ) (hp : p.Prime) :
    CyclicTorOneModel M (p ^ k) ≃+
      ZMod (Nat.gcd M (p ^ k)) := by
  letI : NeZero (p ^ k) := ⟨pow_ne_zero k hp.ne_zero⟩
  exact cyclicTorOneModelAddEquiv M (p ^ k)

/-- Proposition-valued packaging of the prime-power cyclic-model equivalence. -/
theorem primePowerCyclicTorOneModel_existsAddEquiv
    (M p k : ℕ) (hp : p.Prime) :
    Nonempty
      (CyclicTorOneModel M (p ^ k) ≃+
        ZMod (Nat.gcd M (p ^ k))) :=
  ⟨primePowerCyclicTorOneModelAddEquiv M p k hp⟩

/-- The literal prime-power derived-Tor formula requested in Proposition 21. -/
noncomputable def primePowerActualCyclicTorOneIsoGcd
    (M p k : ℕ) (hM : M ≠ 0) (hp : p.Prime) :
    ActualCyclicTorOne M (p ^ k) ≅
      ModuleCat.of ℤ (ZMod (Nat.gcd M (p ^ k))) :=
  actualCyclicTorOneIsoGcd M (p ^ k) hM (pow_ne_zero k hp.ne_zero)

/-- Proposition-valued packaging of the literal prime-power derived-Tor
classification. -/
theorem primePowerActualCyclicTorOneIsoGcd_exists
    (M p k : ℕ) (hM : M ≠ 0) (hp : p.Prime) :
    Nonempty
      (ActualCyclicTorOne M (p ^ k) ≅
        ModuleCat.of ℤ (ZMod (Nat.gcd M (p ^ k)))) :=
  ⟨primePowerActualCyclicTorOneIsoGcd M p k hM hp⟩

end CRTTorBridge

end CorrectedPropositions

end CorrectedLemmas

namespace CorrectedLemmas

/-! ### A non-atomic concrete unfolding model for corrected Lemmas 3.5 and 3.7

The generic finite-unfolding interfaces above are useful only after their
geometric and spectral identification fields have actually been constructed.
The model below does so over Lebesgue measure.  Its test is the same nonzero
smooth Fourier-positive test used by the concrete mass model, every cusp
coefficient is one, and every finite stage is a genuine bounded interval.
In particular, neither the measure, the product kernel, nor the resulting mass
is zero. -/

namespace MassUnfolding.ConcreteSmoothVolumeUnfolding

/-- The symmetric bounded intervals form a proper Lebesgue exhaustion of the
real line.  Every finite stage has finite measure and leaves a positive-measure
open interval in its complement. -/
def symmetricRealExhaustion :
    ProperMeasurableExhaustion (volume : Measure ℝ) where
  set n := Icc (-(n : ℝ)) (n : ℝ)
  measurable_set := fun _ => measurableSet_Icc
  monotone_set := by
    intro m n hmn x hx
    constructor
    · exact (neg_le_neg (Nat.cast_le.mpr hmn)).trans hx.1
    · exact hx.2.trans (Nat.cast_le.mpr hmn)
  covers := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_Icc, Set.mem_univ, iff_true]
    obtain ⟨n, hn⟩ := exists_nat_ge |x|
    exact ⟨n, (neg_le_of_abs_le hn), (le_of_abs_le hn)⟩
  finite_measure := by
    intro n
    simp [Real.volume_Icc]
  proper_set := by
    intro n h
    have hx : (n : ℝ) + 1 ∈ Icc (-(n : ℝ)) (n : ℝ) := by
      rw [h]
      exact Set.mem_univ _
    exact (not_le_of_gt (lt_add_one (n : ℝ))) hx.2
  positive_complement := by
    intro n
    have hsubset :
        Ioc ((n : ℝ) + 1) ((n : ℝ) + 2) ⊆
          (Icc (-(n : ℝ)) (n : ℝ))ᶜ := by
      intro x hx
      simp only [Set.mem_compl_iff, Set.mem_Icc, not_and_or]
      exact Or.inr (not_le_of_gt ((lt_add_one (n : ℝ)).trans hx.1))
    have hpos :
        0 < (volume : Measure ℝ)
          (Ioc ((n : ℝ) + 1) ((n : ℝ) + 2)) := by
      simp [Real.volume_Ioc]
    exact hpos.trans_le (measure_mono hsubset)

/-- The common nonzero smooth test. -/
noncomputable def smoothTest (T : ℝ) (hT : 0 < T) : ℝ → ℝ :=
  KuznetsovInterface.fourierPositiveSmoothTentFunction T hT

theorem smoothTest_integrable (T : ℝ) (hT : 0 < T) :
    Integrable (smoothTest T hT) volume := by
  have hcontinuous : Continuous (smoothTest T hT) :=
    (KuznetsovInterface.fourierPositiveSmoothTentFunction_smooth T hT).continuous
  exact hcontinuous.integrable_of_hasCompactSupport
    (KuznetsovInterface.fourierPositiveSmoothTentFunction_compactSupport T hT)

/-- The already constructed non-atomic positive spectral data, renamed inside
the unfolding namespace. -/
noncomputable def spectralData (T : ℝ) (hT : 0 < T) :
    ContinuousSpectralData :=
  CorrectedPropositions.AnalyticP2P7Completion.smoothVolumeUnitData T hT

@[simp]
theorem spectralData_test (T : ℝ) (hT : 0 < T) :
    (spectralData T hT).test = smoothTest T hT := rfl

@[simp]
theorem spectralData_measure (T : ℝ) (hT : 0 < T)
    (k : Gamma2Cusp) :
    (spectralData T hT).spectralMeasure k = volume := rfl

@[simp]
theorem spectralData_coefficient (T : ℝ) (hT : 0 < T)
    (k : Gamma2Cusp) (m : ℕ) (t : ℝ) :
    (spectralData T hT).coefficient k m t = 1 := rfl

/-- A compactly supported probability density used only to expose a genuine
product-Fubini step. -/
def unitIntervalDensity (x : ℝ) : ℝ :=
  (Ioc (0 : ℝ) 1).indicator (fun _ => (1 : ℝ)) x

theorem unitIntervalDensity_integrable :
    Integrable unitIntervalDensity volume := by
  exact (integrable_indicator_iff measurableSet_Ioc).2
    (integrableOn_const (by simp [Real.volume_Ioc]))

@[simp]
theorem integral_unitIntervalDensity :
    (∫ x : ℝ, unitIntervalDensity x) = 1 := by
  change (∫ x : ℝ, (Ioc (0 : ℝ) 1).indicator (fun _ => (1 : ℝ)) x) = 1
  rw [integral_indicator measurableSet_Ioc]
  simp [Real.volume_Ioc]

/-- Restriction of the smooth test to one proper spectral stage. -/
def stageTest (T : ℝ) (hT : 0 < T) (n : ℕ) (t : ℝ) : ℝ :=
  (Icc (-(n : ℝ)) (n : ℝ)).indicator (smoothTest T hT) t

theorem stageTest_integrable (T : ℝ) (hT : 0 < T) (n : ℕ) :
    Integrable (stageTest T hT n) volume := by
  exact (integrable_indicator_iff measurableSet_Icc).2
    (smoothTest_integrable T hT).integrableOn

@[simp]
theorem integral_stageTest (T : ℝ) (hT : 0 < T) (n : ℕ) :
    (∫ t : ℝ, stageTest T hT n t) =
      ∫ t in Icc (-(n : ℝ)) (n : ℝ), smoothTest T hT t := by
  change
    (∫ t : ℝ, (Icc (-(n : ℝ)) (n : ℝ)).indicator
      (smoothTest T hT) t) = _
  rw [integral_indicator measurableSet_Icc]

/-- A concrete nonzero Rankin--Selberg mass family.  The geometric extraction
is the sum of the three identical cusp densities. -/
noncomputable def rankinSelbergFamily (T : ℝ) (hT : 0 < T) :
    RankinSelbergMassFamily ℝ where
  measure := volume
  rankinSelbergIntegrand := fun _ _ x =>
    ((3 * smoothTest T hT x : ℝ) : ℂ)
  auxiliaryWeight := fun _ t => (smoothTest T hT t : ℂ)
  massTestExtraction := fun F t => (F t).re
  massExtraction := fun K x => (K 0 x).re
  cuspCoefficient := fun _ _ _ => 1
  rawScatteringMeasure := fun _ => volume
  scatteringNormalization := 1
  scatteringNormalization_pos := by norm_num
  scatteringMeasure := fun _ => volume
  scatteringMeasure_eq := by
    intro k
    simp
  extractedMassIntegrand := fun _ x => 3 * smoothTest T hT x
  extractedMassIntegrand_eq := by
    intro m
    funext x
    simp
  extractedMassIntegrable := by
    intro m
    exact (smoothTest_integrable T hT).const_mul 3

@[simp]
theorem rankinSelbergFamily_massTest (T : ℝ) (hT : 0 < T)
    (m : ℕ) (t : ℝ) :
    (rankinSelbergFamily T hT).massTestExtraction
        ((rankinSelbergFamily T hT).auxiliaryWeight m) t =
      (spectralData T hT).test t := rfl

@[simp]
theorem rankinSelbergFamily_coefficient (T : ℝ) (hT : 0 < T)
    (k : Gamma2Cusp) (m : ℕ) (t : ℝ) :
    (rankinSelbergFamily T hT).cuspCoefficient k m t =
      (spectralData T hT).coefficient k m t := rfl

@[simp]
theorem rankinSelbergFamily_scatteringMeasure
    (T : ℝ) (hT : 0 < T) (k : Gamma2Cusp) :
    (rankinSelbergFamily T hT).scatteringMeasure k =
      (spectralData T hT).spectralMeasure k := rfl

/-- Every geometric stage is three copies of the same nonnegative cusp test. -/
theorem geometricStage_eq_three_mul (T : ℝ) (hT : 0 < T)
    (n m : ℕ) :
    (∫ x in symmetricRealExhaustion.set n,
      (rankinSelbergFamily T hT).massExtraction
        ((rankinSelbergFamily T hT).rankinSelbergIntegrand m) x
        ∂(rankinSelbergFamily T hT).measure) =
      3 * ∫ t in Icc (-(n : ℝ)) (n : ℝ), smoothTest T hT t := by
  simp [symmetricRealExhaustion, rankinSelbergFamily, integral_const_mul]

/-- The concrete truncated spectral mass is the same three-cusp integral. -/
theorem truncatedMass_eq_three_mul (T : ℝ) (hT : 0 < T)
    (n m : ℕ) :
    rankinSelbergTruncatedMass
        (rankinSelbergFamily T hT) (spectralData T hT)
        (fun _ => symmetricRealExhaustion.toMeasurableExhaustion) m n =
      3 * ∫ t in Icc (-(n : ℝ)) (n : ℝ), smoothTest T hT t := by
  simp [rankinSelbergTruncatedMass, rankinSelbergTruncatedMassAtCusp,
    rankinSelbergFamily, spectralData, smoothTest, symmetricRealExhaustion,
    Gamma2Cusp.card_eq, nsmul_eq_mul]

/-- Direct finite-sum unfolding.  Its decomposition and spectral collapse are
proved by reducing both sides to the same three-cusp set integral. -/
noncomputable def finiteUnfolding (T : ℝ) (hT : 0 < T) :
    FiniteTruncatedUnfolding
      (ι := Gamma2Cusp) (rankinSelbergFamily T hT) (spectralData T hT) where
  geometric := symmetricRealExhaustion
  spectral := fun _ => symmetricRealExhaustion
  auxiliaryWeight_identification := rankinSelbergFamily_massTest T hT
  coefficient_identification := rankinSelbergFamily_coefficient T hT
  scattering_identification := rankinSelbergFamily_scatteringMeasure T hT
  index := fun _ => Finset.univ
  unfoldedTerm := fun _ _ _ x => smoothTest T hT x
  unfoldedTerm_integrable := by
    intro n m k hk
    exact (smoothTest_integrable T hT).integrableOn
  pointwise_decomposition := by
    intro n m
    filter_upwards [] with x
    simp [rankinSelbergFamily, Gamma2Cusp.card_eq, nsmul_eq_mul]
  spectral_identification := by
    intro n m
    rw [truncatedMass_eq_three_mul T hT n m]
    simp [rankinSelbergFamily, symmetricRealExhaustion,
      Gamma2Cusp.card_eq, nsmul_eq_mul]

/-- The finite-stage identity contains a nonempty three-cusp sum. -/
theorem finiteIdentity (T : ℝ) (hT : 0 < T) (n m : ℕ) :
    (∫ x in (finiteUnfolding T hT).geometric.set n,
      (rankinSelbergFamily T hT).extractedMassIntegrand m x
        ∂(rankinSelbergFamily T hT).measure) =
      truncatedMassFunctional (spectralData T hT)
        (fun k => ((finiteUnfolding T hT).spectral k).toMeasurableExhaustion)
        m n :=
  (finiteUnfolding T hT).finiteIdentity n m

/-- Global corrected Lemma 3.5 for the direct finite model. -/
theorem finiteUnfolding_to_mass (T : ℝ) (hT : 0 < T) (m : ℕ) :
    (rankinSelbergFamily T hT).extractedMass m =
      massFunctional (spectralData T hT) m :=
  unfolding_to_mass (finiteUnfolding T hT) m

/-- The separable nonzero product kernel used by the explicit Fubini model. -/
def productKernel (T : ℝ) (hT : 0 < T)
    (n m : ℕ) (k : Gamma2Cusp) (_ : PUnit) (x t : ℝ) : ℝ :=
  unitIntervalDensity x * stageTest T hT n t

theorem productKernel_integrable (T : ℝ) (hT : 0 < T)
    (n m : ℕ) (k : Gamma2Cusp) (i : PUnit) :
    Integrable (Function.uncurry (productKernel T hT n m k i))
      ((volume : Measure ℝ).prod volume) :=
  unitIntervalDensity_integrable.mul_prod (stageTest_integrable T hT n)

theorem productKernel_iterated_geometric (T : ℝ) (hT : 0 < T)
    (n m : ℕ) (k : Gamma2Cusp) (i : PUnit) :
    (∫ x : ℝ, ∫ t : ℝ, productKernel T hT n m k i x t) =
      ∫ t in Icc (-(n : ℝ)) (n : ℝ), smoothTest T hT t := by
  simp [productKernel, integral_const_mul, integral_mul_const]

theorem productKernel_iterated_spectral (T : ℝ) (hT : 0 < T)
    (n m : ℕ) (k : Gamma2Cusp) (i : PUnit) :
    (∫ t : ℝ, ∫ x : ℝ, productKernel T hT n m k i x t) =
      ∫ t in Icc (-(n : ℝ)) (n : ℝ), smoothTest T hT t := by
  simp [productKernel, integral_const_mul, integral_mul_const]

/-- Product-kernel finite unfolding with an actual non-atomic Fubini swap. -/
noncomputable def productUnfolding (T : ℝ) (hT : 0 < T) :
    ProductFiniteTruncatedUnfolding
      (ι := PUnit) (rankinSelbergFamily T hT) (spectralData T hT) where
  geometric := symmetricRealExhaustion
  spectral := fun _ => symmetricRealExhaustion
  geometric_sFinite := by
    change SFinite (volume : Measure ℝ)
    infer_instance
  spectral_sFinite := by
    intro k
    change SFinite (volume : Measure ℝ)
    infer_instance
  auxiliaryWeight_identification := rankinSelbergFamily_massTest T hT
  coefficient_identification := rankinSelbergFamily_coefficient T hT
  scattering_identification := rankinSelbergFamily_scatteringMeasure T hT
  index := fun _ => Finset.univ
  kernel := productKernel T hT
  kernel_integrable := by
    intro n m k i hi
    exact productKernel_integrable T hT n m k i
  geometric_identification := by
    intro n m
    rw [geometricStage_eq_three_mul T hT n m]
    simp [rankinSelbergFamily, spectralData,
      productKernel_iterated_geometric, Gamma2Cusp.card_eq,
      nsmul_eq_mul]
  spectral_identification := by
    intro n m
    rw [truncatedMass_eq_three_mul T hT n m]
    simp [rankinSelbergFamily, spectralData,
      productKernel_iterated_spectral, Gamma2Cusp.card_eq,
      nsmul_eq_mul]

/-- The explicit product finite identity is derived through Mathlib's Fubini
theorem by `ProductFiniteTruncatedUnfolding.finiteIdentity`. -/
theorem productFiniteIdentity (T : ℝ) (hT : 0 < T) (n m : ℕ) :
    (∫ x in (productUnfolding.{0} T hT).geometric.set n,
      (rankinSelbergFamily T hT).extractedMassIntegrand m x
        ∂(rankinSelbergFamily T hT).measure) =
      truncatedMassFunctional (spectralData T hT)
        (fun k => ((productUnfolding.{0} T hT).spectral k).toMeasurableExhaustion)
        m n :=
  (productUnfolding.{0} T hT).finiteIdentity n m

/-- Global corrected Lemma 3.5 through the explicit product/Fubini route. -/
theorem productUnfolding_to_mass (T : ℝ) (hT : 0 < T) (m : ℕ) :
    (rankinSelbergFamily T hT).extractedMass m =
      massFunctional (spectralData T hT) m :=
  MassUnfolding.product_unfolding_to_mass (productUnfolding.{0} T hT) m

/-- The product kernel is genuinely nonzero already at the first stage. -/
theorem productKernel_pos_at_center (T : ℝ) (hT : 0 < T)
    (m : ℕ) (k : Gamma2Cusp) :
    0 < productKernel T hT 1 m k PUnit.unit (1 / 2) 0 := by
  have hx : (2 : ℝ)⁻¹ ∈ Ioc 0 1 := by norm_num
  have ht : (0 : ℝ) ∈ Icc (-(1 : ℝ)) 1 := by norm_num
  simpa [productKernel, unitIntervalDensity, hx, stageTest, ht, smoothTest] using
    KuznetsovInterface.fourierPositiveSmoothTentFunction_pos_zero T hT

/-- Corrected Lemma 3.7 is strictly positive in this model, not merely
nonnegative by a zero-kernel shortcut. -/
theorem extractedMass_pos (T : ℝ) (hT : 0 < T) (m : ℕ) :
    0 < (rankinSelbergFamily T hT).extractedMass m := by
  rw [productUnfolding_to_mass T hT m]
  exact
    CorrectedPropositions.AnalyticP2P7Completion.massFunctional_smoothVolumeUnitData_pos
      T hT m

theorem extractedMass_nonnegative (T : ℝ) (hT : 0 < T) (m : ℕ) :
    0 ≤ (rankinSelbergFamily T hT).extractedMass m :=
  (extractedMass_pos T hT m).le

end MassUnfolding.ConcreteSmoothVolumeUnfolding

/-! ### Equations (1.6)--(1.8): Green-identity arithmetic repairs

The analytic integration-by-parts theorem is a separate paper-specific
obligation.  The lemmas in this namespace isolate the exact ordered-field
arithmetic that must be used once its two factorization identities have been
proved.  In particular, averaging two equal representations divides *both*
their energy and boundary contributions by two, and moving a boundary term
across an equality changes its sign.
-/

namespace GreenIdentityRepair

/-- If one quantity has two representations, their arithmetic mean is still
that quantity.  This is the scalar leaf used when the raising and lowering
factorizations are averaged. -/
theorem eq_average_of_eq_of_eq
    {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    {x a b : R} (ha : x = a) (hb : x = b) :
    x = (a + b) / 2 := by
  subst a
  subst b
  ring

/-- Correct averaging of the raising and lowering Green identities.  The
factor `1/2` applies to both energy terms and both boundary terms. -/
theorem average_factorization_identity
    {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    {laplace raisingEnergy loweringEnergy
      raisingBoundary loweringBoundary : R}
    (hraising : laplace = -raisingEnergy + raisingBoundary)
    (hlowering : laplace = -loweringEnergy + loweringBoundary) :
    laplace =
      -((raisingEnergy + loweringEnergy) / 2) +
        (raisingBoundary + loweringBoundary) / 2 := by
  calc
    laplace =
        ((-raisingEnergy + raisingBoundary) +
          (-loweringEnergy + loweringBoundary)) / 2 :=
      eq_average_of_eq_of_eq hraising hlowering
    _ = -((raisingEnergy + loweringEnergy) / 2) +
          (raisingBoundary + loweringBoundary) / 2 := by
      ring

/-- Omitting the averaging factor is already false for two identical scalar
factorizations: `-1 = -1` does not become `-1 = -2`. -/
theorem average_factorization_without_half_counterexample :
    ∃ laplace raisingEnergy loweringEnergy
      raisingBoundary loweringBoundary : ℝ,
      laplace = -raisingEnergy + raisingBoundary ∧
      laplace = -loweringEnergy + loweringBoundary ∧
      laplace ≠
        -(raisingEnergy + loweringEnergy) +
          (raisingBoundary + loweringBoundary) := by
  refine ⟨-1, 1, 1, 0, 0, ?_, ?_, ?_⟩ <;> norm_num

/-- Exact boundary-sign equivalence in an ordered ring. -/
theorem energy_add_boundary_eq_rhs_iff
    {R : Type*} [Ring R] [LinearOrder R] [IsStrictOrderedRing R]
    {energy boundary rhs : R} :
    energy + boundary = rhs ↔ energy = rhs - boundary := by
  constructor
  · intro h
    calc
      energy = (energy + boundary) - boundary := by simp
      _ = rhs - boundary := congrArg (fun t : R => t - boundary) h
  · intro h
    calc
      energy + boundary = (rhs - boundary) + boundary :=
        congrArg (fun t : R => t + boundary) h
      _ = rhs := by simp

/-- Moving the boundary contribution to the right-hand side introduces a
minus sign. -/
theorem energy_eq_rhs_sub_boundary
    {R : Type*} [Ring R] [LinearOrder R] [IsStrictOrderedRing R]
    {energy boundary rhs : R}
    (hidentity : energy + boundary = rhs) :
    energy = rhs - boundary :=
  energy_add_boundary_eq_rhs_iff.mp hidentity

/-- Concrete counterexample to the paper's `energy = rhs + boundary` rewrite.
Here `1 + 1 = 2`, whereas `1 ≠ 2 + 1`. -/
theorem paper_plusBoundaryRewrite_counterexample :
    ∃ energy boundary rhs : ℝ,
      energy + boundary = rhs ∧ energy ≠ rhs + boundary := by
  exact ⟨1, 1, 2, by norm_num, by norm_num⟩

end GreenIdentityRepair

namespace WeakVariationalRepair

/-- A Gårding lower bound becomes coercive after adding a shift at least as
large as its negative part. -/
theorem shiftedCoercive_of_garding
    {energy normSq negativePart shift coercivity : ℝ}
    (hnorm : 0 ≤ normSq)
    (hnegative : negativePart ≤ shift)
    (hGarding : coercivity * normSq ≤
      energy + negativePart * normSq) :
    coercivity * normSq ≤ energy + shift * normSq := by
  have hmul : negativePart * normSq ≤ shift * normSq :=
    mul_le_mul_of_nonneg_right hnegative hnorm
  linarith

/-- If the negative part is already nonpositive, the original form itself is
coercive; no shift-removal argument is needed. -/
theorem unshiftedCoercive_of_nonpositive_negativePart
    {energy normSq negativePart coercivity : ℝ}
    (hnorm : 0 ≤ normSq)
    (hnegative : negativePart ≤ 0)
    (hGarding : coercivity * normSq ≤
      energy + negativePart * normSq) :
    coercivity * normSq ≤ energy := by
  have hmul : negativePart * normSq ≤ 0 :=
    mul_nonpos_of_nonpos_of_nonneg hnegative hnorm
  linarith

/-- The scalar inequality behind the usual Lax--Milgram a priori estimate. -/
theorem norm_le_inv_mul_of_coercive_bound
    {coercivity solutionNorm rhsNorm : ℝ}
    (hcoercivity : 0 < coercivity)
    (hsolution : 0 ≤ solutionNorm)
    (hrhs : 0 ≤ rhsNorm)
    (hbound : coercivity * solutionNorm * solutionNorm ≤
      rhsNorm * solutionNorm) :
    solutionNorm ≤ coercivity⁻¹ * rhsNorm := by
  by_cases hzero : solutionNorm = 0
  · subst solutionNorm
    exact mul_nonneg (inv_nonneg.mpr hcoercivity.le) hrhs
  · have hsolutionPos : 0 < solutionNorm :=
      lt_of_le_of_ne hsolution (Ne.symm hzero)
    have hlinear : coercivity * solutionNorm ≤ rhsNorm := by
      nlinarith [hbound]
    have hdiv : solutionNorm ≤ rhsNorm / coercivity := by
      apply (le_div_iff₀ hcoercivity).2
      simpa [mul_comm] using hlinear
    simpa [div_eq_mul_inv, mul_comm] using hdiv

/-- A solved shifted equation does not in general solve the unshifted equation.
The concrete data are `A = 0`, `lambda = 1`, `u = f = 1`. -/
theorem undoShift_false :
    ∃ (A : ℝ → ℝ) (lambda u f : ℝ),
      A u + lambda * u = f ∧ A u ≠ f := by
  refine ⟨(fun _ => 0), 1, 1, 1, ?_, ?_⟩ <;> norm_num

end WeakVariationalRepair

namespace MockConnectionErratum

/-- A pointwise parallel section has zero pointwise covariant-derivative
energy. -/
theorem parallelDerivative_normSq_eq_zero
    {E : Type*} [SeminormedAddCommGroup E]
    {nablaSection : E} (hparallel : nablaSection = 0) :
    ‖nablaSection‖ ^ 2 = 0 := by
  simp [hparallel]

/-- Consequently a parallel derivative energy cannot equal a strictly positive
shadow mass. -/
theorem parallelEnergy_ne_positiveShadow
    {derivativeEnergy shadowMass : ℝ}
    (hparallel : derivativeEnergy = 0)
    (hshadow : 0 < shadowMass) :
    derivativeEnergy ≠ shadowMass := by
  intro h
  linarith

/-- In a truncated identity, zero derivative energy forces the boundary term
to be the negative of the shadow term, rather than allowing both to be positive. -/
theorem boundary_eq_neg_shadow_of_parallel
    {shadow boundary : ℝ}
    (hidentity : 0 = shadow + boundary) :
    boundary = -shadow := by
  linarith

/-- A vanishing boundary limit is incompatible with a fixed positive shadow
mass in an identity whose derivative energy is identically zero. -/
theorem no_zeroBoundary_positiveShadow
    {shadow boundary : ℝ}
    (hshadow : 0 < shadow)
    (hboundary : boundary = 0)
    (hidentity : 0 = shadow + boundary) : False := by
  linarith

end MockConnectionErratum

namespace WidthTwoFourier

/-- The Fourier mode compatible with a cusp of width two. -/
noncomputable def mode (k : ℤ) (x : ℝ) : ℂ :=
  Complex.exp ((k : ℂ) * Real.pi * Complex.I * x)

/-- Exact orthogonality of a nonzero integral frequency on one width-two
horocycle. -/
theorem integral_mode (k : ℤ) :
    (∫ x : ℝ in (0 : ℝ)..2, mode k x) =
      if k = 0 then 2 else 0 := by
  by_cases hk : k = 0
  · subst k
    simp [mode]
  · rw [if_neg hk]
    have hkC : (k : ℂ) ≠ 0 := by
      exact_mod_cast hk
    have hpi : (Real.pi : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
    have hc : (k : ℂ) * Real.pi * Complex.I ≠ 0 :=
      mul_ne_zero (mul_ne_zero hkC hpi) Complex.I_ne_zero
    unfold mode
    rw [integral_exp_mul_complex hc]
    have hexp :
        Complex.exp
            (((k : ℂ) * Real.pi * Complex.I) * (2 : ℝ)) = 1 := by
      have htwo : (((2 : ℝ) : ℂ)) = (2 : ℂ) := by norm_num
      rw [htwo]
      rw [show
        ((k : ℂ) * Real.pi * Complex.I) * (2 : ℂ) =
          (k : ℂ) * (2 * Real.pi * Complex.I) by ring]
      exact Complex.exp_int_mul_two_pi_mul_I k
    rw [hexp]
    simp

/-- Kronecker orthogonality for two integer frequencies. -/
theorem integral_frequencyDifference (m n : ℤ) :
    (∫ x : ℝ in (0 : ℝ)..2, mode (m - n) x) =
      if m = n then 2 else 0 := by
  simpa [sub_eq_zero] using integral_mode (m - n)

/-- A finite Fourier polynomial on a width-two horocycle. -/
noncomputable def finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) (x : ℝ) : ℂ :=
  ∑ k ∈ s, a k * mode k x

/-- Every width-two Fourier mode is continuous in the horocycle variable. -/
theorem continuous_mode (k : ℤ) : Continuous (mode k) := by
  have hlinear : Continuous (fun x : ℝ =>
      ((k : ℂ) * (Real.pi : ℂ) * Complex.I) * (x : ℂ)) :=
    continuous_const.mul Complex.continuous_ofReal
  exact Complex.continuous_exp.comp hlinear

/-- A finite width-two Fourier polynomial is continuous. -/
theorem continuous_finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) :
    Continuous (finitePolynomial s a) := by
  unfold finitePolynomial
  exact continuous_finset_sum s fun k _ =>
    continuous_const.mul (continuous_mode k)

/-- Conjugating one mode and multiplying by another produces the difference
frequency required by `integral_frequencyDifference`. -/
theorem conj_mode_mul_mode (m n : ℤ) (x : ℝ) :
    star (mode n x) * mode m x = mode (m - n) x := by
  simp only [mode]
  have hstar :
      star (Complex.exp ((n : ℂ) * Real.pi * Complex.I * (x : ℂ))) =
        Complex.exp
          (star ((n : ℂ) * Real.pi * Complex.I * (x : ℂ))) := by
    simpa using
      (Complex.exp_conj
        ((n : ℂ) * Real.pi * Complex.I * (x : ℂ))).symm
  have harg :
      star ((n : ℂ) * Real.pi * Complex.I * (x : ℂ)) =
        -((n : ℂ) * Real.pi * Complex.I * (x : ℂ)) := by
    change (starRingEnd ℂ)
      ((n : ℂ) * Real.pi * Complex.I * (x : ℂ)) =
        -((n : ℂ) * Real.pi * Complex.I * (x : ℂ))
    rw [map_mul, map_mul]
    simp <;> ring
  rw [hstar, harg, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- One matrix coefficient in the finite norm-square expansion. -/
noncomputable def crossTerm
    (a : ℤ → ℂ) (n m : ℤ) (x : ℝ) : ℂ :=
  star (a n) * a m * mode (m - n) x

/-- Every cross term is continuous, hence interval-integrable. -/
theorem continuous_crossTerm
    (a : ℤ → ℂ) (n m : ℤ) :
    Continuous (crossTerm a n m) := by
  unfold crossTerm
  exact continuous_const.mul (continuous_mode (m - n))

theorem intervalIntegrable_crossTerm
    (a : ℤ → ℂ) (n m : ℤ) :
    IntervalIntegrable (crossTerm a n m) volume 0 2 :=
  (continuous_crossTerm a n m).intervalIntegrable 0 2

/-- Exact integral of one cross term. -/
theorem integral_crossTerm
    (a : ℤ → ℂ) (n m : ℤ) :
    (∫ x : ℝ in (0 : ℝ)..2, crossTerm a n m x) =
      star (a n) * a m *
        (if m = n then (2 : ℂ) else 0) := by
  unfold crossTerm
  rw [intervalIntegral.integral_const_mul,
    integral_frequencyDifference]

/-- Pointwise double-sum expansion of the Hermitian square of a finite Fourier
polynomial. -/
theorem conj_finitePolynomial_mul_finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) (x : ℝ) :
    star (finitePolynomial s a x) * finitePolynomial s a x =
      ∑ n ∈ s, ∑ m ∈ s, crossTerm a n m x := by
  unfold finitePolynomial
  change
    (starRingEnd ℂ) (∑ k ∈ s, a k * mode k x) *
        (∑ k ∈ s, a k * mode k x) = _
  rw [map_sum]
  simp only [map_mul]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro n hn
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  unfold crossTerm
  calc
    (star (a n) * star (mode n x)) *
          (a m * mode m x) =
        (star (a n) * a m) *
          (star (mode n x) * mode m x) := by ring
    _ = star (a n) * a m * mode (m - n) x := by
      rw [conj_mode_mul_mode]

/-- Termwise integration of the finite double sum. -/
theorem integral_crossTerm_sum
    (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x : ℝ in (0 : ℝ)..2,
        ∑ n ∈ s, ∑ m ∈ s, crossTerm a n m x) =
      ∑ n ∈ s, ∑ m ∈ s,
        star (a n) * a m *
          (if m = n then (2 : ℂ) else 0) := by
  calc
    (∫ x : ℝ in (0 : ℝ)..2,
        ∑ n ∈ s, ∑ m ∈ s, crossTerm a n m x) =
        ∑ n ∈ s,
          ∫ x : ℝ in (0 : ℝ)..2, ∑ m ∈ s, crossTerm a n m x := by
      apply intervalIntegral.integral_finset_sum
      intro n hn
      exact (continuous_finset_sum s fun m _ =>
        continuous_crossTerm a n m).intervalIntegrable 0 2
    _ = ∑ n ∈ s, ∑ m ∈ s,
        ∫ x : ℝ in (0 : ℝ)..2, crossTerm a n m x := by
      apply Finset.sum_congr rfl
      intro n hn
      apply intervalIntegral.integral_finset_sum
      intro m hm
      exact intervalIntegrable_crossTerm a n m
    _ = ∑ n ∈ s, ∑ m ∈ s,
        star (a n) * a m *
          (if m = n then (2 : ℂ) else 0) := by
      apply Finset.sum_congr rfl
      intro n hn
      apply Finset.sum_congr rfl
      intro m hm
      exact integral_crossTerm a n m

/-- Orthogonality removes every off-diagonal term in the integrated finite
Hermitian square. -/
theorem integratedCrossTerms_eq_diagonal
    (s : Finset ℤ) (a : ℤ → ℂ) :
    (∑ n ∈ s, ∑ m ∈ s,
        star (a n) * a m *
          (if m = n then (2 : ℂ) else 0)) =
      ∑ n ∈ s, (2 : ℂ) * (Complex.normSq (a n) : ℂ) := by
  apply Finset.sum_congr rfl
  intro n hn
  calc
    (∑ m ∈ s,
        star (a n) * a m *
          (if m = n then (2 : ℂ) else 0)) =
        star (a n) * a n *
          (if n = n then (2 : ℂ) else 0) := by
      apply Finset.sum_eq_single_of_mem n hn
      intro m hm hmn
      simp [hmn]
    _ = star (a n) * a n * 2 := by simp
    _ = (2 : ℂ) * (Complex.normSq (a n) : ℂ) := by
      rw [Complex.normSq_eq_conj_mul_self]
      ac_rfl

/-- Complex-valued finite Parseval identity. -/
theorem integral_conj_mul_finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x : ℝ in (0 : ℝ)..2,
        star (finitePolynomial s a x) *
          finitePolynomial s a x) =
      ∑ k ∈ s, (2 : ℂ) * (Complex.normSq (a k) : ℂ) := by
  calc
    (∫ x : ℝ in (0 : ℝ)..2,
        star (finitePolynomial s a x) *
          finitePolynomial s a x) =
        ∫ x : ℝ in (0 : ℝ)..2,
          ∑ n ∈ s, ∑ m ∈ s, crossTerm a n m x := by
      apply intervalIntegral.integral_congr
      intro x hx
      exact conj_finitePolynomial_mul_finitePolynomial s a x
    _ = ∑ n ∈ s, ∑ m ∈ s,
        star (a n) * a m *
          (if m = n then (2 : ℂ) else 0) :=
      integral_crossTerm_sum s a
    _ = ∑ k ∈ s, (2 : ℂ) * (Complex.normSq (a k) : ℂ) :=
      integratedCrossTerms_eq_diagonal s a

/-- Real norm-square form of finite Parseval on a width-two horocycle. -/
theorem integral_normSq_finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x : ℝ in (0 : ℝ)..2,
        Complex.normSq (finitePolynomial s a x)) =
      2 * ∑ k ∈ s, Complex.normSq (a k) := by
  apply Complex.ofReal_injective
  calc
    ((∫ x : ℝ in (0 : ℝ)..2,
        Complex.normSq (finitePolynomial s a x) : ℝ) : ℂ) =
        ∫ x : ℝ in (0 : ℝ)..2,
          (Complex.normSq (finitePolynomial s a x) : ℂ) :=
      intervalIntegral.integral_ofReal.symm
    _ = ∫ x : ℝ in (0 : ℝ)..2,
        star (finitePolynomial s a x) *
          finitePolynomial s a x := by
      apply intervalIntegral.integral_congr
      intro x hx
      exact Complex.normSq_eq_conj_mul_self
    _ = ∑ k ∈ s, (2 : ℂ) * (Complex.normSq (a k) : ℂ) :=
      integral_conj_mul_finitePolynomial s a
    _ = ((2 * ∑ k ∈ s, Complex.normSq (a k) : ℝ) : ℂ) := by
      push_cast
      rw [Finset.mul_sum]

/-- The requested width-two finite Parseval identity in squared-norm notation. -/
theorem integral_norm_sq_finitePolynomial
    (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x : ℝ in (0 : ℝ)..2,
        ‖finitePolynomial s a x‖ ^ 2) =
      2 * ∑ k ∈ s, ‖a k‖ ^ 2 := by
  simpa only [Complex.normSq_eq_norm_sq] using
    integral_normSq_finitePolynomial s a

end WidthTwoFourier

end CorrectedLemmas

namespace CorrectedLemmas.CorrectedPropositions.CRTTorBridge

/-- The generalized CRT complex is exact from the leading integer copy through
the gcd obstruction, with injective first map in the nondegenerate regime and
surjective final map.  This packages (6.15)--(6.17) without storing any of the
four conclusions as structure fields. -/
theorem generalizedCRT_exactPackage
    (M N : ℕ) (hlcm : Nat.lcm M N ≠ 0) :
    Function.Injective (lcmMultiplicationMap M N) ∧
      Function.Exact (lcmMultiplicationMap M N) (comparisonMap M N) ∧
      Function.Exact (comparisonMap M N) (crtObstructionMap M N) ∧
      Function.Surjective (crtObstructionMap M N) :=
  ⟨lcmMultiplicationMap_injective M N hlcm,
    lcmMultiplicationMap_comparisonMap_exact M N,
    comparisonMap_crtObstructionMap_exact M N,
    crtObstructionMap_surjective M N⟩

end CorrectedLemmas.CorrectedPropositions.CRTTorBridge

/-! ### A graph-norm completion constructed from the actual graph map

This construction is the non-circular functional-analytic core required by
strategy B.  The three energy terms are coordinates of an `L²` product.  Thus
the graph-norm identity is a theorem of the product norm, rather than a field
stored in a certificate.  The completed space is literally the closure of the
graph range in a complete Hilbert space. -/

namespace CorrectedLemmas.ConcreteGraphCompletion

universe uV u0 uR uL

variable {V : Type uV} {H0 : Type u0} {HR : Type uR} {HL : Type uL}
variable [AddCommGroup V] [Module ℂ V]
variable [NormedAddCommGroup H0] [InnerProductSpace ℂ H0] [CompleteSpace H0]
variable [NormedAddCommGroup HR] [InnerProductSpace ℂ HR] [CompleteSpace HR]
variable [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] [CompleteSpace HL]

/-- The `L²` product containing the raising and lowering derivatives. -/
abbrev DerivativeAmbient (HR : Type uR) (HL : Type uL)
    [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
    [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] : Type (max uR uL) :=
  WithLp 2 (HR × HL)

/-- The Hilbert graph ambient for `u ↦ (u, Ru, Lu)`. -/
abbrev GraphAmbient (H0 : Type u0) (HR : Type uR) (HL : Type uL)
    [NormedAddCommGroup H0] [InnerProductSpace ℂ H0]
    [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
    [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] :
    Type (max u0 uR uL) :=
  WithLp 2 (H0 × DerivativeAmbient HR HL)

/-- The derivative pair as an actual linear map into an `L²` product. -/
def derivativeMap (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) :
    V →ₗ[ℂ] DerivativeAmbient HR HL :=
  (WithLp.linearEquiv 2 ℂ (HR × HL)).symm.toLinearMap.comp (R.prod L)

/-- The actual graph map `u ↦ (u, Ru, Lu)`. -/
def graphMap (ι : V →ₗ[ℂ] H0) (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) :
    V →ₗ[ℂ] GraphAmbient H0 HR HL :=
  (WithLp.linearEquiv 2 ℂ (H0 × DerivativeAmbient HR HL)).symm.toLinearMap.comp
    (ι.prod (derivativeMap R L))

@[simp]
theorem derivativeMap_fst
    (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    (derivativeMap R L u).fst = R u :=
  rfl

@[simp]
theorem derivativeMap_snd
    (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    (derivativeMap R L u).snd = L u :=
  rfl

@[simp]
theorem graphMap_fst
    (ι : V →ₗ[ℂ] H0) (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    (graphMap ι R L u).fst = ι u :=
  rfl

@[simp]
theorem graphMap_snd_fst
    (ι : V →ₗ[ℂ] H0) (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    (graphMap ι R L u).snd.fst = R u :=
  rfl

@[simp]
theorem graphMap_snd_snd
    (ι : V →ₗ[ℂ] H0) (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    (graphMap ι R L u).snd.snd = L u :=
  rfl

/-- The graph norm is exactly the sum of the value, raising, and lowering
energies.  No norm identity is assumed. -/
theorem graphMap_norm_sq
    (ι : V →ₗ[ℂ] H0) (R : V →ₗ[ℂ] HR) (L : V →ₗ[ℂ] HL) (u : V) :
    ‖graphMap ι R L u‖ ^ 2 =
      ‖ι u‖ ^ 2 + ‖R u‖ ^ 2 + ‖L u‖ ^ 2 := by
  calc
    ‖graphMap ι R L u‖ ^ 2 =
        ‖(graphMap ι R L u).fst‖ ^ 2 +
          ‖(graphMap ι R L u).snd‖ ^ 2 :=
      WithLp.prod_norm_sq_eq_of_L2 _
    _ = ‖ι u‖ ^ 2 + (‖R u‖ ^ 2 + ‖L u‖ ^ 2) := by
      rw [WithLp.prod_norm_sq_eq_of_L2]
      simp only [graphMap_fst, graphMap_snd_fst, graphMap_snd_snd]
    _ = ‖ι u‖ ^ 2 + ‖R u‖ ^ 2 + ‖L u‖ ^ 2 := by
      ring

/-- Operators on the algebraic core.  Faithfulness is stated only for the
actual graph map and is used to embed the original core into its completion. -/
structure CoreOperators where
  value : V →ₗ[ℂ] H0
  raising : V →ₗ[ℂ] HR
  lowering : V →ₗ[ℂ] HL
  graph_injective : Function.Injective (graphMap value raising lowering)

/-- The algebraic graph as a linear subspace of the complete Hilbert ambient. -/
def graphCore (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    Submodule ℂ (GraphAmbient H0 HR HL) :=
  LinearMap.range (graphMap D.value D.raising D.lowering)

/-- The weighted graph Sobolev space is the literal topological closure of the
algebraic graph. -/
def graphSobolev (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    Submodule ℂ (GraphAmbient H0 HR HL) :=
  (graphCore D).topologicalClosure

theorem graphCore_le_graphSobolev
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    graphCore D ≤ graphSobolev D :=
  (graphCore D).le_topologicalClosure

theorem isClosed_graphSobolev
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    IsClosed (graphSobolev D : Set (GraphAmbient H0 HR HL)) :=
  (graphCore D).isClosed_topologicalClosure

/-- The original algebraic core embeds linearly and faithfully into the graph
completion. -/
def algebraicCoreToGraphSobolev
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    V →ₗ[ℂ] graphSobolev D :=
  (graphMap D.value D.raising D.lowering).codRestrict
    (graphSobolev D) fun u =>
      graphCore_le_graphSobolev D ⟨u, rfl⟩

theorem algebraicCoreToGraphSobolev_injective
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    Function.Injective (algebraicCoreToGraphSobolev D) := by
  intro u v huv
  apply D.graph_injective
  exact congrArg Subtype.val huv

/-- The graph subspace itself includes continuously into its completion. -/
def graphCoreToGraphSobolev
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    graphCore D →L[ℂ] graphSobolev D :=
  (graphCore D).subtypeL.codRestrict
    (graphSobolev D) (fun u => graphCore_le_graphSobolev D u.property)

/-- The algebraic graph is dense in the graph completion by construction. -/
theorem denseRange_graphCoreToGraphSobolev
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) :
    DenseRange (graphCoreToGraphSobolev D) := by
  change DenseRange (Set.inclusion (graphCore_le_graphSobolev D))
  rw [denseRange_inclusion_iff]
  · intro x hx
    exact hx
  · intro x hx
    exact graphCore_le_graphSobolev D hx

/-- The exact graph-energy identity specialized to the operators in `D`. -/
theorem algebraicCore_graphEnergy
    (D : CoreOperators (V := V) (H0 := H0) (HR := HR) (HL := HL)) (u : V) :
    ‖(algebraicCoreToGraphSobolev D u : GraphAmbient H0 HR HL)‖ ^ 2 =
      ‖D.value u‖ ^ 2 + ‖D.raising u‖ ^ 2 + ‖D.lowering u‖ ^ 2 :=
  graphMap_norm_sq D.value D.raising D.lowering u

end CorrectedLemmas.ConcreteGraphCompletion

/-! ### Closable joint graphs and faithful graph-norm completion

The closure of an arbitrary algebraic graph need not remain the graph of an
operator: a nonzero vertical vector `(0, r, l)` can occur.  The precise missing
analytic condition is closability of the joint partial operator `(R,L)`.  The
following general layer proves that closability eliminates vertical vectors,
makes the value-coordinate embedding faithful, and leaves the raising and
lowering maps as honest bounded coordinate maps on the graph completion.

For the eventual Maass specialization, closability is obtained from the
integration-by-parts identity by the final theorem of this block: a densely
defined formal adjoint supplies a closed adjoint extension. -/

namespace CorrectedLemmas.ClosableGraphBridge

universe u0 uR uL

variable {H0 : Type u0} {HR : Type uR} {HL : Type uL}
variable [NormedAddCommGroup H0] [InnerProductSpace ℂ H0] [CompleteSpace H0]
variable [NormedAddCommGroup HR] [InnerProductSpace ℂ HR] [CompleteSpace HR]
variable [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] [CompleteSpace HL]

abbrev DerivativeAmbient :=
  ConcreteGraphCompletion.DerivativeAmbient HR HL

abbrev GraphAmbient :=
  ConcreteGraphCompletion.GraphAmbient H0 HR HL

/-- A common algebraic core for the raising and lowering operators.  Density is
recorded separately from the integration-by-parts identity so that neither
analytic obligation can be hidden in a graph-norm equality. -/
structure CommonCoreOperators where
  core : Submodule ℂ H0
  raising : core →ₗ[ℂ] HR
  lowering : core →ₗ[ℂ] HL
  dense_core : Dense (core : Set H0)

/-- The pair `(R,L)` as one partial operator on its literal common domain. -/
def CommonCoreOperators.jointPMap
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) :
    H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL) where
  domain := D.core
  toFun := ConcreteGraphCompletion.derivativeMap D.raising D.lowering

@[simp]
theorem CommonCoreOperators.jointPMap_domain
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) :
    D.jointPMap.domain = D.core :=
  rfl

@[simp]
theorem CommonCoreOperators.jointPMap_fst
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL))
    (u : D.jointPMap.domain) :
    (D.jointPMap u).fst = D.raising u :=
  rfl

@[simp]
theorem CommonCoreOperators.jointPMap_snd
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL))
    (u : D.jointPMap.domain) :
    (D.jointPMap u).snd = D.lowering u :=
  rfl

theorem CommonCoreOperators.dense_jointPMap_domain
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) :
    Dense (D.jointPMap.domain : Set H0) := by
  simpa only [CommonCoreOperators.jointPMap_domain] using D.dense_core

/-- Forget the outer `L²` wrapper without changing the product topology. -/
def graphCoordinateEquiv :
    GraphAmbient (H0 := H0) (HR := HR) (HL := HL) ≃L[ℂ]
      H0 × DerivativeAmbient (HR := HR) (HL := HL) :=
  WithLp.prodContinuousLinearEquiv 2 ℂ H0
    (DerivativeAmbient (HR := HR) (HL := HL))

/-- The graph of a joint partially defined derivative, transported to the
three-coordinate `L²` graph ambient. -/
def transportedGraph
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    Submodule ℂ (GraphAmbient (H0 := H0) (HR := HR) (HL := HL)) :=
  T.graph.comap
    (graphCoordinateEquiv (H0 := H0) (HR := HR) (HL := HL)).toLinearMap

/-- Literal graph-norm completion of the algebraic joint graph. -/
def graphCompletion
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    Submodule ℂ (GraphAmbient (H0 := H0) (HR := HR) (HL := HL)) :=
  (transportedGraph T).topologicalClosure

@[simp]
theorem mem_transportedGraph_iff
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (z : GraphAmbient (H0 := H0) (HR := HR) (HL := HL)) :
    z ∈ transportedGraph T ↔ (z.fst, z.snd) ∈ T.graph :=
  Iff.rfl

/-- The graph completion is closed by construction. -/
theorem isClosed_graphCompletion
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    IsClosed (graphCompletion T :
      Set (GraphAmbient (H0 := H0) (HR := HR) (HL := HL))) :=
  (transportedGraph T).isClosed_topologicalClosure

/-- Transport of a closed operator graph remains closed. -/
theorem isClosed_transportedGraph_of_isClosed
    {T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)}
    (hT : T.IsClosed) :
    IsClosed (transportedGraph T :
      Set (GraphAmbient (H0 := H0) (HR := HR) (HL := HL))) := by
  change IsClosed
    ((graphCoordinateEquiv (H0 := H0) (HR := HR) (HL := HL)) ⁻¹'
      (T.graph : Set (H0 × DerivativeAmbient (HR := HR) (HL := HL))))
  exact (show IsClosed (T.graph :
    Set (H0 × DerivativeAmbient (HR := HR) (HL := HL))) from hT).preimage
      (graphCoordinateEquiv (H0 := H0) (HR := HR) (HL := HL)).continuous

/-- The algebraic graph is contained in the graph of the closure. -/
theorem transportedGraph_le_closureGraph
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    transportedGraph T ≤ transportedGraph T.closure := by
  intro z hz
  change (z.fst, z.snd) ∈ T.graph at hz
  change (z.fst, z.snd) ∈ T.closure.graph
  exact LinearPMap.le_graph_of_le T.le_closure hz

/-- Closability forces the whole graph completion into the graph of the closed
joint derivative. -/
theorem graphCompletion_le_closureGraph
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    graphCompletion T ≤ transportedGraph T.closure := by
  exact (transportedGraph T).topologicalClosure_minimal
    (transportedGraph_le_closureGraph T)
    (isClosed_transportedGraph_of_isClosed hT.closure_isClosed)

/-- The transported graph completion is exactly the graph of the closed
operator `T.closure`.  No additional core assumption is needed: Mathlib's
closure is defined by closing the original graph, and the coordinate change is
a homeomorphism. -/
theorem graphCompletion_eq_transportedClosureGraph
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    graphCompletion T = transportedGraph T.closure := by
  apply SetLike.ext'
  change
    closure
        ((graphCoordinateEquiv
          (H0 := H0) (HR := HR) (HL := HL)) ⁻¹'
            (T.graph : Set
              (H0 × DerivativeAmbient (HR := HR) (HL := HL)))) =
      (graphCoordinateEquiv
        (H0 := H0) (HR := HR) (HL := HL)) ⁻¹'
          (T.closure.graph : Set
            (H0 × DerivativeAmbient (HR := HR) (HL := HL)))
  rw [← hT.graph_closure_eq_closure_graph]
  exact
    ((graphCoordinateEquiv
      (H0 := H0) (HR := HR) (HL := HL)).preimage_closure
        (T.graph : Set
          (H0 × DerivativeAmbient (HR := HR) (HL := HL)))).symm

/-- Membership in the completed graph is literal membership in the graph of
the closed operator, expanded into its domain and value components. -/
theorem mem_graphCompletion_iff_closureDomain
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable)
    (z : GraphAmbient (H0 := H0) (HR := HR) (HL := HL)) :
    z ∈ graphCompletion T ↔
      ∃ hz : z.fst ∈ T.closure.domain,
        z.snd = T.closure ⟨z.fst, hz⟩ := by
  rw [graphCompletion_eq_transportedClosureGraph T hT]
  change (z.fst, z.snd) ∈ T.closure.graph ↔ _
  constructor
  · intro hz
    have hx : z.fst ∈ T.closure.domain :=
      LinearPMap.mem_domain_of_mem_graph hz
    exact ⟨hx, (LinearPMap.image_iff hx).mpr hz⟩
  · rintro ⟨hx, hval⟩
    exact (LinearPMap.image_iff hx).mp hval

/-- A completed graph vector lies in the literal graph of `T.closure`. -/
theorem graphCompletion_mem_closureGraph
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) (u : graphCompletion T) :
    (u.1.fst, u.1.snd) ∈ T.closure.graph := by
  have hu :
      (u.1 : GraphAmbient (H0 := H0) (HR := HR) (HL := HL)) ∈
        transportedGraph T.closure := by
    rw [← graphCompletion_eq_transportedClosureGraph T hT]
    exact u.2
  exact (mem_transportedGraph_iff T.closure u.1).mp hu

/-- Parametrize the closed graph by the actual closed-operator domain. -/
def closureDomainGraphPoint
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (x : T.closure.domain) :
    GraphAmbient (H0 := H0) (HR := HR) (HL := HL) :=
  (graphCoordinateEquiv
    (H0 := H0) (HR := HR) (HL := HL)).symm
      ((x : H0), T.closure x)

@[simp]
theorem closureDomainGraphPoint_fst
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (x : T.closure.domain) :
    (closureDomainGraphPoint T x).fst = (x : H0) := by
  simp [closureDomainGraphPoint, graphCoordinateEquiv]

@[simp]
theorem closureDomainGraphPoint_snd
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (x : T.closure.domain) :
    (closureDomainGraphPoint T x).snd = T.closure x := by
  simp [closureDomainGraphPoint, graphCoordinateEquiv]

theorem closureDomainGraphPoint_mem_graphCompletion
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) (x : T.closure.domain) :
    closureDomainGraphPoint T x ∈ graphCompletion T := by
  rw [graphCompletion_eq_transportedClosureGraph T hT]
  apply (mem_transportedGraph_iff T.closure _).2
  simpa using T.closure.mem_graph x

/-- Value-coordinate map into the actual domain of the closed operator. -/
def graphCompletionToClosureDomain
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    graphCompletion T →ₗ[ℂ] T.closure.domain where
  toFun u :=
    ⟨u.1.fst, LinearPMap.mem_domain_of_mem_graph
      (graphCompletion_mem_closureGraph T hT u)⟩
  map_add' _ _ := by
    apply Subtype.ext
    rfl
  map_smul' _ _ := by
    apply Subtype.ext
    rfl

/-- Graph embedding of the actual closed domain.  This map is algebraic, not
continuous for the inherited domain norm of a generally unbounded operator. -/
def closureDomainToGraphCompletion
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    T.closure.domain →ₗ[ℂ] graphCompletion T where
  toFun x := ⟨closureDomainGraphPoint T x,
    closureDomainGraphPoint_mem_graphCompletion T hT x⟩
  map_add' x y := by
    apply Subtype.ext
    apply (graphCoordinateEquiv
      (H0 := H0) (HR := HR) (HL := HL)).injective
    simp [closureDomainGraphPoint, LinearPMap.map_add]
  map_smul' c x := by
    apply Subtype.ext
    apply (graphCoordinateEquiv
      (H0 := H0) (HR := HR) (HL := HL)).injective
    simp [closureDomainGraphPoint, LinearPMap.map_smul]

/-- Algebraic identification with the actual domain of `T.closure`, carrying
the graph norm on the left. -/
def graphCompletionEquivClosureDomain
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    graphCompletion T ≃ₗ[ℂ] T.closure.domain where
  toLinearMap := graphCompletionToClosureDomain T hT
  invFun := closureDomainToGraphCompletion T hT
  left_inv u := by
    apply Subtype.ext
    apply (graphCoordinateEquiv
      (H0 := H0) (HR := HR) (HL := HL)).injective
    apply Prod.ext
    · simp [closureDomainToGraphCompletion,
        graphCompletionToClosureDomain, graphCoordinateEquiv]
    · simp only [closureDomainToGraphCompletion, LinearMap.coe_mk,
        AddHom.coe_mk, closureDomainGraphPoint_snd]
      exact ((LinearPMap.image_iff
        (graphCompletionToClosureDomain T hT u).property).mpr
          (graphCompletion_mem_closureGraph T hT u)).symm
  right_inv x := by
    apply Subtype.ext
    simp [closureDomainToGraphCompletion,
      graphCompletionToClosureDomain]

/-- The completed joint graph has no nonzero vertical vector. -/
theorem graphCompletion_vertical_eq_zero
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable)
    {z : GraphAmbient (H0 := H0) (HR := HR) (HL := HL)}
    (hz : z ∈ graphCompletion T) (hz0 : z.fst = 0) :
    z = 0 := by
  have hz' := graphCompletion_le_closureGraph T hT hz
  change (z.fst, z.snd) ∈ T.closure.graph at hz'
  have hsnd : z.snd = 0 :=
    T.closure.graph_fst_eq_zero_snd hz' hz0
  apply (graphCoordinateEquiv
    (H0 := H0) (HR := HR) (HL := HL)).injective
  change (z.fst, z.snd) = (0, 0)
  exact Prod.ext hz0 hsnd

/-- Hence the value coordinate faithfully determines a completed graph
vector. -/
theorem graphCompletion_fst_injective
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    Function.Injective
      (fun u : graphCompletion T =>
        (u.1 : GraphAmbient (H0 := H0) (HR := HR) (HL := HL)).fst) := by
  intro u v huv
  apply Subtype.ext
  have hmem : (u.1 - v.1) ∈ graphCompletion T :=
    sub_mem u.2 v.2
  have hfst : (u.1 - v.1).fst = 0 := by
    change u.1.fst - v.1.fst = 0
    exact sub_eq_zero.mpr huv
  exact sub_eq_zero.mp
    (graphCompletion_vertical_eq_zero T hT hmem hfst)

/-- Continuous value-coordinate projection from the graph completion into its
ambient Hilbert space. -/
def valueProjection
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    graphCompletion T →L[ℂ] H0 :=
  (WithLp.fstL 2 ℂ H0 (DerivativeAmbient (HR := HR) (HL := HL))).comp
    (graphCompletion T).subtypeL

/-- The value projection is injective as soon as the joint derivative is
closable.  No inverse-continuity claim is made for its range with the ambient
norm. -/
theorem valueProjection_injective
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) :
    Function.Injective (valueProjection T) := by
  intro u v huv
  apply graphCompletion_fst_injective T hT
  change u.1.fst = v.1.fst at huv
  exact huv

/-- The closed joint derivative as the second graph coordinate. -/
def derivativeProjection
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    graphCompletion T →L[ℂ]
      DerivativeAmbient (HR := HR) (HL := HL) :=
  (WithLp.sndL 2 ℂ H0 (DerivativeAmbient (HR := HR) (HL := HL))).comp
    (graphCompletion T).subtypeL

/-- The graph derivative coordinate is the actual closed-operator value. -/
theorem derivativeProjection_eq_closure_apply
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) (u : graphCompletion T) :
    derivativeProjection T u =
      T.closure (graphCompletionEquivClosureDomain T hT u) := by
  change u.1.snd = _
  apply (LinearPMap.image_iff
    (graphCompletionEquivClosureDomain T hT u).property).mpr
  change (u.1.fst, u.1.snd) ∈ T.closure.graph
  exact graphCompletion_mem_closureGraph T hT u

/-- Closed raising operator on the graph completion. -/
def raisingProjection
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    graphCompletion T →L[ℂ] HR :=
  (WithLp.fstL 2 ℂ HR HL).comp (derivativeProjection T)

/-- Closed lowering operator on the graph completion. -/
def loweringProjection
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL)) :
    graphCompletion T →L[ℂ] HL :=
  (WithLp.sndL 2 ℂ HR HL).comp (derivativeProjection T)

/-- The three graph energies are coordinate norms for every completed
vector. -/
theorem graphCompletion_norm_sq
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (u : graphCompletion T) :
    ‖u‖ ^ 2 =
      ‖valueProjection T u‖ ^ 2 + ‖raisingProjection T u‖ ^ 2 +
        ‖loweringProjection T u‖ ^ 2 := by
  calc
    ‖u‖ ^ 2 = ‖u.1.fst‖ ^ 2 + ‖u.1.snd‖ ^ 2 :=
      WithLp.prod_norm_sq_eq_of_L2 u.1
    _ = ‖u.1.fst‖ ^ 2 +
        (‖u.1.snd.fst‖ ^ 2 + ‖u.1.snd.snd‖ ^ 2) := by
      rw [WithLp.prod_norm_sq_eq_of_L2]
    _ = ‖valueProjection T u‖ ^ 2 + ‖raisingProjection T u‖ ^ 2 +
        ‖loweringProjection T u‖ ^ 2 := by
      change ‖u.1.fst‖ ^ 2 +
          (‖u.1.snd.fst‖ ^ 2 + ‖u.1.snd.snd‖ ^ 2) =
        ‖u.1.fst‖ ^ 2 + ‖u.1.snd.fst‖ ^ 2 +
          ‖u.1.snd.snd‖ ^ 2
      ring

/-- The inverse domain parametrization carries the literal two-coordinate
graph norm. -/
theorem norm_sq_closureDomainToGraphCompletion
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) (x : T.closure.domain) :
    ‖closureDomainToGraphCompletion T hT x‖ ^ 2 =
      ‖(x : H0)‖ ^ 2 + ‖T.closure x‖ ^ 2 := by
  change ‖closureDomainGraphPoint T x‖ ^ 2 = _
  rw [WithLp.prod_norm_sq_eq_of_L2]
  simp

/-- Expanded raising/lowering form of the same closed-domain graph norm. -/
theorem norm_sq_closureDomainToGraphCompletion_threeTerms
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hT : T.IsClosable) (x : T.closure.domain) :
    ‖closureDomainToGraphCompletion T hT x‖ ^ 2 =
      ‖(x : H0)‖ ^ 2 + ‖(T.closure x).fst‖ ^ 2 +
        ‖(T.closure x).snd‖ ^ 2 := by
  rw [norm_sq_closureDomainToGraphCompletion T hT x,
    WithLp.prod_norm_sq_eq_of_L2]
  ring

/-- The ambient value coordinate is contractive for the graph norm. -/
theorem norm_valueProjection_le
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (u : graphCompletion T) :
    ‖valueProjection T u‖ ≤ ‖u‖ := by
  nlinarith [graphCompletion_norm_sq T u,
    sq_nonneg ‖raisingProjection T u‖,
    sq_nonneg ‖loweringProjection T u‖,
    norm_nonneg (valueProjection T u), norm_nonneg u]

/-- The ambient Hilbert vector `f` defines the actual continuous data
functional `u ↦ ⟪f, u₀⟫` on the completed graph space. -/
noncomputable def ambientToData
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (f : H0) : graphCompletion T →L[ℂ] ℂ :=
  (InnerProductSpace.toDualMap ℂ H0 f).comp (valueProjection T)

@[simp]
theorem ambientToData_apply
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (f : H0) (u : graphCompletion T) :
    ambientToData T f u = ⟪f, valueProjection T u⟫_ℂ :=
  rfl

@[simp]
theorem ambientToData_add
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (f g : H0) :
    ambientToData T (f + g) =
      ambientToData T f + ambientToData T g := by
  apply ContinuousLinearMap.ext
  intro u
  change ⟪f + g, valueProjection T u⟫_ℂ =
    ⟪f, valueProjection T u⟫_ℂ +
      ⟪g, valueProjection T u⟫_ℂ
  exact inner_add_left f g (valueProjection T u)

/-- The ambient-to-data Riesz embedding is conjugate-linear in the ambient
vector, fixing the anti-dual convention explicitly. -/
@[simp]
theorem ambientToData_smul
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (c : ℂ) (f : H0) :
    ambientToData T (c • f) =
      (starRingEnd ℂ c) • ambientToData T f := by
  apply ContinuousLinearMap.ext
  intro u
  change ⟪c • f, valueProjection T u⟫_ℂ =
    (starRingEnd ℂ c) * ⟪f, valueProjection T u⟫_ℂ
  exact inner_smul_left f (valueProjection T u) c

/-- Cauchy--Schwarz together with graph-coordinate contractivity gives the
literal `L² → V'` pairing bound. -/
theorem norm_ambientToData_apply_le
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (f : H0) (u : graphCompletion T) :
    ‖ambientToData T f u‖ ≤ ‖f‖ * ‖u‖ := by
  calc
    ‖ambientToData T f u‖ = ‖⟪f, valueProjection T u⟫_ℂ‖ := rfl
    _ ≤ ‖f‖ * ‖valueProjection T u‖ := norm_inner_le_norm _ _
    _ ≤ ‖f‖ * ‖u‖ :=
      mul_le_mul_of_nonneg_left (norm_valueProjection_le T u)
        (norm_nonneg f)

/-- Density of the value-coordinate range makes the ambient-to-data pairing
faithful. -/
theorem ambientToData_injective_of_denseRange
    (T : H0 →ₗ.[ℂ] DerivativeAmbient (HR := HR) (HL := HL))
    (hDense : DenseRange (valueProjection T)) :
    Function.Injective (ambientToData T) := by
  intro f g hfg
  apply (InnerProductSpace.toDualMap ℂ H0).injective
  apply ContinuousLinearMap.ext_on
    (hDense.mono Submodule.subset_span)
  intro x hx
  rcases hx with ⟨u, rfl⟩
  simpa only [InnerProductSpace.toDualMap_apply_apply,
    ambientToData_apply] using
      congrArg (fun L : graphCompletion T →L[ℂ] ℂ => L u) hfg

/-- A dense common core sits in the value projection of its completed joint
graph; hence that projection has dense range. -/
theorem CommonCoreOperators.denseRange_valueProjection_jointPMap
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) :
    DenseRange (valueProjection D.jointPMap) := by
  apply D.dense_core.mono
  intro x hx
  let xd : D.jointPMap.domain :=
    ⟨x, by
      rw [CommonCoreOperators.jointPMap_domain]
      exact hx⟩
  let z : GraphAmbient (H0 := H0) (HR := HR) (HL := HL) :=
    (graphCoordinateEquiv
      (H0 := H0) (HR := HR) (HL := HL)).symm
        (x, D.jointPMap xd)
  have hz : z ∈ transportedGraph D.jointPMap := by
    apply (mem_transportedGraph_iff D.jointPMap z).2
    simpa [z, graphCoordinateEquiv] using D.jointPMap.mem_graph xd
  let uz : graphCompletion D.jointPMap :=
    ⟨z, (transportedGraph D.jointPMap).le_topologicalClosure hz⟩
  refine ⟨uz, ?_⟩
  change z.fst = x
  simp [z, graphCoordinateEquiv]

/-- The concrete `H₀ → V'` map attached to a dense common graph core is
injective. -/
theorem CommonCoreOperators.ambientToData_injective
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) :
    Function.Injective (ambientToData D.jointPMap) :=
  ambientToData_injective_of_denseRange D.jointPMap
    D.denseRange_valueProjection_jointPMap

/-- A densely defined formal adjoint gives a closed extension, hence
closability.  This is the functional-analytic output of the Maass
integration-by-parts identities. -/
theorem isClosable_of_formalAdjoint_dense
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    [CompleteSpace F]
    {T : H0 →ₗ.[ℂ] F} {S : F →ₗ.[ℂ] H0}
    (h : T.IsFormalAdjoint S)
    (hS : Dense (S.domain : Set F)) :
    T.IsClosable := by
  rw [LinearPMap.isClosable_iff_exists_closed_extension]
  exact ⟨S.adjoint, S.adjoint_isClosed hS,
    h.symm.le_adjoint hS⟩

/-- Exact proof obligations produced by the geometric integration-by-parts
calculation for a particular common core. -/
structure FormalAdjointCertificate
    (D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)) where
  adjoint : DerivativeAmbient (HR := HR) (HL := HL) →ₗ.[ℂ] H0
  dense_adjoint_domain : Dense (adjoint.domain :
    Set (DerivativeAmbient (HR := HR) (HL := HL)))
  integrationByParts : D.jointPMap.IsFormalAdjoint adjoint

/-- A completed integration-by-parts certificate closes the joint Maass-type
operator and therefore makes its graph completion faithfully determined by the
value projection. -/
theorem FormalAdjointCertificate.jointPMap_isClosable
    {D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)}
    (C : FormalAdjointCertificate D) :
    D.jointPMap.IsClosable :=
  isClosable_of_formalAdjoint_dense
    C.integrationByParts C.dense_adjoint_domain

/-- Certificate-specialized injectivity of the completed value projection. -/
theorem FormalAdjointCertificate.valueProjection_injective
    {D : CommonCoreOperators (H0 := H0) (HR := HR) (HL := HL)}
    (C : FormalAdjointCertificate D) :
    Function.Injective (valueProjection D.jointPMap) :=
  ClosableGraphBridge.valueProjection_injective
    D.jointPMap C.jointPMap_isClosable

end CorrectedLemmas.ClosableGraphBridge

/-! ### Pure-jet audit of the PDF's Maass identities

The displayed differential identities can be checked before any Sobolev or
domain question arises.  A two-jet records exactly the values used by the
first-order compositions.  Evaluating the claimed identities on the height
function `f(x,y)=y` shows that the PDF's Laplacian is missing the drift term
`-k y ∂_y`; the unweighted formal-adjoint claim also fails.  These are finite
algebraic counterexamples, not appeals to an unavailable spectral theorem. -/

namespace CorrectedLemmas.MaassJetAudit

structure Jet1 where
  value : ℂ
  dx : ℂ
  dy : ℂ

structure Jet2 extends Jet1 where
  dxx : ℂ
  dxy : ℂ
  dyx : ℂ
  dyy : ℂ

/-- `2 i ∂_z f + k y⁻¹ f = i f_x + f_y + k y⁻¹ f`. -/
def raiseValue (k y : ℝ) (J : Jet1) : ℂ :=
  Complex.I * J.dx + J.dy + ((k / y : ℝ) : ℂ) * J.value

/-- `-2 i y² ∂_{bar z} f = -i y² f_x + y² f_y`. -/
def lowerValue (y : ℝ) (J : Jet1) : ℂ :=
  -Complex.I * ((y ^ 2 : ℝ) : ℂ) * J.dx +
    ((y ^ 2 : ℝ) : ℂ) * J.dy

/-- First jet of `R_k f`, obtained by the product rule. -/
def raiseJet (k y : ℝ) (J : Jet2) : Jet1 where
  value := raiseValue k y J.toJet1
  dx := Complex.I * J.dxx + J.dxy +
    ((k / y : ℝ) : ℂ) * J.dx
  dy := Complex.I * J.dyx + J.dyy +
    ((k / y : ℝ) : ℂ) * J.dy -
    ((k / y ^ 2 : ℝ) : ℂ) * J.value

/-- First jet of `L_k f`; the formula is independent of the label `k`. -/
def lowerJet (y : ℝ) (J : Jet2) : Jet1 where
  value := lowerValue y J.toJet1
  dx := -Complex.I * ((y ^ 2 : ℝ) : ℂ) * J.dxx +
    ((y ^ 2 : ℝ) : ℂ) * J.dxy
  dy := -Complex.I *
      (((2 * y : ℝ) : ℂ) * J.dx +
        ((y ^ 2 : ℝ) : ℂ) * J.dyx) +
    ((2 * y : ℝ) : ℂ) * J.dy + ((y ^ 2 : ℝ) : ℂ) * J.dyy

/-- The paper's displayed `-Δ_k`, which omits the `k y f_y` drift. -/
def paperMinusLaplacian (k y : ℝ) (J : Jet2) : ℂ :=
  ((y ^ 2 : ℝ) : ℂ) * (J.dxx + J.dyy) -
    Complex.I * ((k * y : ℝ) : ℂ) * J.dx

/-- Two-jet of the height coordinate `f(x,y)=y`. -/
def heightJet (y : ℝ) : Jet2 where
  value := (y : ℂ)
  dx := 0
  dy := 1
  dxx := 0
  dxy := 0
  dyx := 0
  dyy := 0

/-- At `k=1/2`, `y=1`, the claimed
`-Δ_k = L_{k+2} R_k + k` reads `0 = 1/2`. -/
theorem paper_left_factorization_fails_at_height :
    paperMinusLaplacian (1 / 2 : ℝ) 1 (heightJet 1) ≠
      lowerValue 1 (raiseJet (1 / 2 : ℝ) 1 (heightJet 1)) +
        (((1 / 2 : ℝ) : ℂ) * (heightJet 1).value) := by
  norm_num [paperMinusLaplacian, lowerValue, raiseJet, raiseValue,
    heightJet]

/-- The second displayed factorization `-Δ_k = R_{k-2} L_k` fails on the
same height jet. -/
theorem paper_right_factorization_fails_at_height :
    paperMinusLaplacian (1 / 2 : ℝ) 1 (heightJet 1) ≠
      raiseValue ((1 / 2 : ℝ) - 2) 1
        (lowerJet 1 (heightJet 1)) := by
  norm_num [paperMinusLaplacian, raiseValue, lowerJet, lowerValue,
    heightJet]

/-- Formal expression obtained by integration by parts when both source and
target use the unweighted hyperbolic density `y⁻² dx dy`. -/
def sameHyperbolicFormalAdjointRaise (k y : ℝ) (J : Jet1) : ℂ :=
  Complex.I * J.dx - J.dy +
    (((k + 2) / y : ℝ) : ℂ) * J.value

def constantJet : Jet1 :=
  ⟨1, 0, 0⟩

/-- Consequently `(R_k)∗ = -L_{k+2}` is false when both sides are interpreted
in the PDF's single unweighted hyperbolic `L²` space. -/
theorem unweighted_adjoint_claim_fails_at_constant :
    sameHyperbolicFormalAdjointRaise (1 / 2 : ℝ) 1 constantJet ≠
      -lowerValue 1 constantJet := by
  norm_num [sameHyperbolicFormalAdjointRaise, lowerValue, constantJet]

/-- The missing term is nonzero already on the height jet. -/
theorem missing_heightDrift_nonzero :
    (((1 / 2 : ℝ) * 1 : ℝ) : ℂ) * (heightJet 1).dy ≠ 0 := by
  norm_num [heightJet]

/-- At height one this is the divergence of
`(i f conj(g) y⁻², f conj(g) y⁻²)`; the `-2` term is the derivative of the
hyperbolic density. -/
def hyperbolicGreenDivergenceAtOne (F G : Jet1) : ℂ :=
  Complex.I *
      (F.dx * (starRingEnd ℂ) G.value +
        F.value * (starRingEnd ℂ) G.dx) +
    (F.dy * (starRingEnd ℂ) G.value +
      F.value * (starRingEnd ℂ) G.dy) -
    2 * F.value * (starRingEnd ℂ) G.value

/-- Exact pointwise Green identity for the true same-hyperbolic-measure
formal differential adjoint. -/
theorem raise_sub_trueAdjoint_eq_divergence_at_one
    (k : ℝ) (F G : Jet1) :
    raiseValue k 1 F * (starRingEnd ℂ) G.value -
        F.value * (starRingEnd ℂ)
          (sameHyperbolicFormalAdjointRaise k 1 G) =
      hyperbolicGreenDivergenceAtOne F G := by
  apply Complex.ext <;>
    simp [raiseValue, sameHyperbolicFormalAdjointRaise,
      hyperbolicGreenDivergenceAtOne] <;> ring

/-- Replacing the true adjoint by `-L` leaves the nonzero zeroth-order
residual `(k+2) f conj(g)`. -/
theorem raise_sub_negLower_eq_divergence_add_residual_at_one
    (k : ℝ) (F G : Jet1) :
    raiseValue k 1 F * (starRingEnd ℂ) G.value -
        F.value * (starRingEnd ℂ) (-lowerValue 1 G) =
      hyperbolicGreenDivergenceAtOne F G +
        (((k + 2 : ℝ) : ℂ) * F.value *
          (starRingEnd ℂ) G.value) := by
  apply Complex.ext <;>
    simp [raiseValue, lowerValue, hyperbolicGreenDivergenceAtOne] <;>
    ring

/-- Raising expression after conjugation by the Petersson factor
`u ↦ y^(k/2)u`. -/
def unitaryRaiseValue (k y : ℝ) (J : Jet1) : ℂ :=
  (y : ℂ) * (Complex.I * J.dx + J.dy) +
    ((k / 2 : ℝ) : ℂ) * J.value

/-- Lowering expression in the same hyperbolic `L²` normalization. -/
def unitaryLowerValue (k y : ℝ) (J : Jet1) : ℂ :=
  (y : ℂ) * (-Complex.I * J.dx + J.dy) -
    ((k / 2 : ℝ) : ℂ) * J.value

/-- Formal differential adjoint of the unitary-normalized raising
expression. -/
def sameHyperbolicFormalAdjointUnitaryRaise
    (k y : ℝ) (J : Jet1) : ℂ :=
  Complex.I * (y : ℂ) * J.dx - (y : ℂ) * J.dy +
    (((k / 2 + 1 : ℝ) : ℂ) * J.value)

/-- The normalized differential expressions have the expected shifted
formal-adjoint relation exactly. -/
theorem formalAdjointUnitaryRaise_eq_negUnitaryLower
    (k y : ℝ) (J : Jet1) :
    sameHyperbolicFormalAdjointUnitaryRaise k y J =
      -unitaryLowerValue (k + 2) y J := by
  apply Complex.ext <;>
    simp [sameHyperbolicFormalAdjointUnitaryRaise,
      unitaryLowerValue] <;> ring

end CorrectedLemmas.MaassJetAudit

/-! ### Pointwise Maass operators on smooth representatives

Derivatives are deliberately taken over `ℝ`: Maass forms are not assumed
holomorphic.  `UpperHalfPlane.ofComplex` is used only to choose a total local
extension; every theorem exposing an actual derivative carries a
`HasRealFDerivAt` witness at the interior point.  No derivative is applied
directly to an `AEEqFun` class. -/

namespace CorrectedLemmas.PointwiseMaass

/-- Total local extension used to invoke real Fréchet differentiation. -/
def localExtension (f : UpperHalfPlane → ℂ) : ℂ → ℂ :=
  fun z => f (UpperHalfPlane.ofComplex z)

@[simp]
theorem localExtension_at
    (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) :
    localExtension f (τ : ℂ) = f τ := by
  simpa [localExtension] using
    congrArg f (UpperHalfPlane.ofComplex_apply τ)

def realDifferential
    (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ →L[ℝ] ℂ :=
  fderiv ℝ (localExtension f) (τ : ℂ)

def partialX (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  realDifferential f τ 1

def partialY (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  realDifferential f τ Complex.I

def wirtingerZ (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  (1 / 2 : ℂ) * (partialX f τ - Complex.I * partialY f τ)

def wirtingerBar (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  (1 / 2 : ℂ) * (partialX f τ + Complex.I * partialY f τ)

/-- Pointwise raising formula from the PDF. -/
def raising
    (k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  2 * Complex.I * wirtingerZ f τ +
    ((k / τ.im : ℝ) : ℂ) * f τ

/-- Pointwise lowering formula.  The weight label is retained to expose its
source and target weights even though it does not occur in the expression. -/
def lowering
    (_k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  -2 * Complex.I * ((τ.im ^ 2 : ℝ) : ℂ) * wirtingerBar f τ

/-- Exact regularity witness for a chosen real derivative. -/
def HasRealFDerivAt
    (f : UpperHalfPlane → ℂ) (D : ℂ →L[ℝ] ℂ)
    (τ : UpperHalfPlane) : Prop :=
  HasFDerivAt (localExtension f) D (τ : ℂ)

theorem partialX_eq_of_hasRealFDerivAt
    {f : UpperHalfPlane → ℂ} {D : ℂ →L[ℝ] ℂ}
    {τ : UpperHalfPlane} (h : HasRealFDerivAt f D τ) :
    partialX f τ = D 1 := by
  rw [partialX, realDifferential, h.fderiv]

theorem partialY_eq_of_hasRealFDerivAt
    {f : UpperHalfPlane → ℂ} {D : ℂ →L[ℝ] ℂ}
    {τ : UpperHalfPlane} (h : HasRealFDerivAt f D τ) :
    partialY f τ = D Complex.I := by
  rw [partialY, realDifferential, h.fderiv]

theorem wirtinger_sum
    (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) :
    wirtingerZ f τ + wirtingerBar f τ = partialX f τ := by
  apply Complex.ext <;>
    simp [wirtingerZ, wirtingerBar] <;> ring

theorem wirtinger_sub
    (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) :
    wirtingerZ f τ - wirtingerBar f τ =
      -Complex.I * partialY f τ := by
  apply Complex.ext <;>
    simp [wirtingerZ, wirtingerBar] <;> ring

theorem raising_eq_realCoordinates
    (k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) :
    raising k f τ =
      Complex.I * partialX f τ + partialY f τ +
        ((k / τ.im : ℝ) : ℂ) * f τ := by
  apply Complex.ext <;>
    simp [raising, wirtingerZ] <;> ring

theorem lowering_eq_realCoordinates
    (k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) :
    lowering k f τ =
      -Complex.I * ((τ.im ^ 2 : ℝ) : ℂ) * partialX f τ +
        ((τ.im ^ 2 : ℝ) : ℂ) * partialY f τ := by
  apply Complex.ext <;>
    simp [lowering, wirtingerBar] <;> ring

/-- Raising operator after conjugating the weight-`k` Petersson norm to the
plain hyperbolic `L²` norm. -/
def unitaryRaising
    (k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  (τ.im : ℂ) * (Complex.I * partialX f τ + partialY f τ) +
    ((k / 2 : ℝ) : ℂ) * f τ

/-- Lowering operator in the same unitary normalization. -/
def unitaryLowering
    (k : ℝ) (f : UpperHalfPlane → ℂ) (τ : UpperHalfPlane) : ℂ :=
  (τ.im : ℂ) * (-Complex.I * partialX f τ + partialY f τ) -
    ((k / 2 : ℝ) : ℂ) * f τ

@[simp]
theorem unitaryRaising_zero (k : ℝ) (τ : UpperHalfPlane) :
    unitaryRaising k (fun _ => 0) τ = 0 := by
  have hzero :
      fderiv ℝ (localExtension (fun _ : UpperHalfPlane => (0 : ℂ)))
        (τ : ℂ) = 0 := by
    have hfun : localExtension (fun _ : UpperHalfPlane => (0 : ℂ)) =
        fun _ : ℂ => (0 : ℂ) := by
      rfl
    rw [hfun]
    simp
  unfold unitaryRaising partialX partialY realDifferential
  rw [hzero]
  simp

@[simp]
theorem unitaryLowering_zero (k : ℝ) (τ : UpperHalfPlane) :
    unitaryLowering k (fun _ => 0) τ = 0 := by
  have hzero :
      fderiv ℝ (localExtension (fun _ : UpperHalfPlane => (0 : ℂ)))
        (τ : ℂ) = 0 := by
    have hfun : localExtension (fun _ : UpperHalfPlane => (0 : ℂ)) =
        fun _ : ℂ => (0 : ℂ) := by
      rfl
    rw [hfun]
    simp
  unfold unitaryLowering partialX partialY realDifferential
  rw [hzero]
  simp

end CorrectedLemmas.PointwiseMaass

/-! ### Closed-form half-order modified Bessel kernel

Only the order `1/2` used by the displayed Rademacher series is needed here.
The definition is the elementary closed form, so its sign and exponential
envelope require no unavailable general Bessel-function library. -/

namespace CorrectedLemmas.HalfOrderBessel

/-- The real closed form `I_{1/2}(x) = sqrt(2/(πx)) sinh(x)` on `x > 0`.
The total definition is retained at nonpositive inputs, while every analytic
theorem below states its positive-domain hypothesis explicitly. -/
noncomputable def besselIHalf (x : ℝ) : ℝ :=
  Real.sqrt (2 / (Real.pi * x)) * Real.sinh x

/-- The elementary exponential upper bound for the hyperbolic sine. -/
theorem sinh_le_half_exp (x : ℝ) :
    Real.sinh x ≤ Real.exp x / 2 := by
  rw [Real.sinh_eq]
  linarith [Real.exp_pos (-x)]

/-- Positivity of the exact half-order kernel on its analytic domain. -/
theorem besselIHalf_pos {x : ℝ} (hx : 0 < x) :
    0 < besselIHalf x := by
  unfold besselIHalf
  exact mul_pos
    (Real.sqrt_pos.2
      (div_pos (by norm_num) (mul_pos Real.pi_pos hx)))
    (Real.sinh_pos_iff.2 hx)

theorem besselIHalf_nonneg {x : ℝ} (hx : 0 ≤ x) :
    0 ≤ besselIHalf x := by
  unfold besselIHalf
  exact mul_nonneg (Real.sqrt_nonneg _)
    (Real.sinh_nonneg_iff.2 hx)

/-- Direct large-argument envelope used when splitting a Rademacher sum. -/
theorem besselIHalf_le_expEnvelope (x : ℝ) :
    besselIHalf x ≤
      Real.sqrt (2 / (Real.pi * x)) * (Real.exp x / 2) := by
  unfold besselIHalf
  exact mul_le_mul_of_nonneg_left (sinh_le_half_exp x)
    (Real.sqrt_nonneg _)

/-- The matching lower comparison near zero follows from `x ≤ sinh x` for
nonnegative `x`. -/
theorem sqrtPrefactor_mul_self_le_besselIHalf
    {x : ℝ} (hx : 0 ≤ x) :
    Real.sqrt (2 / (Real.pi * x)) * x ≤ besselIHalf x := by
  unfold besselIHalf
  exact mul_le_mul_of_nonneg_left
    (Real.self_le_sinh_iff.2 hx) (Real.sqrt_nonneg _)

/-- The critical modulus envelope forced by a square-root Kloosterman estimate
and the small-argument half-order kernel. -/
def criticalModulusEnvelope (A : ℝ) (n : ℕ) : ℝ :=
  A * (1 / |(n : ℝ) + 1| ^ (1 : ℝ))

/-- A nonzero critical `c⁻¹` envelope is not summable.  Consequently the
pointwise Weil bound plus the half-order closed form cannot, by itself, prove
absolute convergence of the displayed modulus series. -/
theorem not_summable_criticalModulusEnvelope
    {A : ℝ} (hA : A ≠ 0) :
    ¬ Summable (criticalModulusEnvelope A) := by
  change ¬ Summable
    (fun n : ℕ => A * (1 / |(n : ℝ) + 1| ^ (1 : ℝ)))
  simpa only [sub_zero] using
    (CorrectedLemmas.KloostermanTail.not_summable_nonzero_mul_paper_tail_one
      (A := A) (ε := 0) hA (le_refl 0))

/-- Any genuine positive decay margin beyond the critical exponent is
summable; this is the numerical threshold demanded of a cancellation theorem. -/
theorem summable_with_positiveMargin {δ : ℝ} (hδ : 0 < δ) :
    Summable (CorrectedLemmas.KloostermanTail.pSeriesMajorant δ) :=
  CorrectedLemmas.KloostermanTail.pSeriesMajorant_summable hδ

/-- The extra quarter-power in the PDF's conclusion cannot be absorbed into a
constant independent of the arithmetic parameters. -/
theorem no_uniformConstant_absorbs_quarterPower :
    ¬ ∃ C : ℝ, ∀ x : ℝ, 1 ≤ x →
      x ^ (1 / 2 : ℝ) ≤ C * x ^ (1 / 4 : ℝ) := by
  rintro ⟨C, hC⟩
  have hC_one := hC 1 le_rfl
  have hC_nonneg : 0 ≤ C := by
    have : 1 ≤ C := by simpa using hC_one
    linarith
  have hdom :=
    CorrectedLemmas.CorrectedPropositions.SpectralMassGap.rpow_eventually_dominates
      (A := (1 : ℝ)) (B := C) (a := (1 / 2 : ℝ)) (b := (1 / 4 : ℝ))
      (by norm_num) hC_nonneg (by norm_num)
  obtain ⟨x, hx, hx1⟩ :=
    (hdom.and (eventually_ge_atTop (1 : ℝ))).exists
  have hupper := hC x hx1
  have hlower : C * x ^ (1 / 4 : ℝ) < x ^ (1 / 2 : ℝ) := by
    simpa only [one_mul] using hx
  exact (not_lt_of_ge hupper) hlower

end CorrectedLemmas.HalfOrderBessel

/-! ### Concrete finite Rademacher truncations

The modulus index below is `c + 1`, so the Kloosterman sum is never evaluated
at modulus zero.  All coefficient objects in this namespace are finite sums.
No infinite coefficient, limiting value, or convergence certificate is stored
as data. -/

namespace CorrectedLemmas.ConcreteRademacherTruncation

/-- The positive modulus attached to the zero-based truncation index `c`. -/
def positiveModulus (c : ℕ) : ℕ := c + 1

theorem positiveModulus_pos (c : ℕ) : 0 < positiveModulus c := by
  simp [positiveModulus]

theorem positiveModulus_cast_pos (c : ℕ) :
    0 < (positiveModulus c : ℝ) := by
  exact_mod_cast positiveModulus_pos c

instance positiveModulus_neZero (c : ℕ) : NeZero (positiveModulus c) :=
  ⟨Nat.ne_of_gt (positiveModulus_pos c)⟩

/-- A multiplier is supplied independently at each positive modulus.  This is
input data, not a bundled assertion about any infinite coefficient. -/
abbrev MultiplierFamily :=
  (c : ℕ) →
    ConcreteTwistedKloosterman.MultiplierPhase (positiveModulus c)

/-- The actual twisted Kloosterman sum at modulus `c + 1`. -/
noncomputable def positiveModulusKloosterman
    (χ : MultiplierFamily) (m n : ℤ) (c : ℕ) : ℂ := by
  letI : NeZero (positiveModulus c) :=
    NeZero.of_pos (positiveModulus_pos c)
  exact ConcreteTwistedKloosterman.twistedKloostermanSum (χ c) m n

/-- The cardinality bound is inherited from the concrete finite residue sum,
with positivity of `c + 1` discharged locally. -/
theorem norm_positiveModulusKloosterman_le_card
    (χ : MultiplierFamily) (m n : ℤ) (c : ℕ) :
    ‖positiveModulusKloosterman χ m n c‖ ≤
      (Fintype.card
        (ConcreteTwistedKloosterman.UnitResidue (positiveModulus c)) : ℝ) := by
  letI : NeZero (positiveModulus c) :=
    NeZero.of_pos (positiveModulus_pos c)
  change
    ‖ConcreteTwistedKloosterman.twistedKloostermanSum (χ c) m n‖ ≤ _
  exact
    ConcreteTwistedKloosterman.norm_twistedKloostermanSum_le_card
      (χ c) m n

/-- The positive-scale half-order Bessel argument at modulus `c + 1`. -/
def kernelArgument (A : ℝ) (c : ℕ) : ℝ :=
  A / (positiveModulus c : ℝ)

theorem kernelArgument_nonneg {A : ℝ} (hA : 0 ≤ A) (c : ℕ) :
    0 ≤ kernelArgument A c := by
  exact div_nonneg hA (positiveModulus_cast_pos c).le

theorem kernelArgument_pos {A : ℝ} (hA : 0 < A) (c : ℕ) :
    0 < kernelArgument A c := by
  exact div_pos hA (positiveModulus_cast_pos c)

/-- The real scalar weight `I_{1/2}(A/(c+1))/(c+1)` occurring in one
Rademacher modulus term. -/
noncomputable def kernelWeight (A : ℝ) (c : ℕ) : ℝ :=
  HalfOrderBessel.besselIHalf (kernelArgument A c) /
    (positiveModulus c : ℝ)

theorem kernelWeight_nonneg {A : ℝ} (hA : 0 ≤ A) (c : ℕ) :
    0 ≤ kernelWeight A c := by
  exact div_nonneg
    (HalfOrderBessel.besselIHalf_nonneg
      (kernelArgument_nonneg hA c))
    (positiveModulus_cast_pos c).le

/-- The direct exponential Bessel envelope, including the `1/(c+1)`
normalization of the Rademacher term. -/
noncomputable def besselEnvelopeWeight (A : ℝ) (c : ℕ) : ℝ :=
  (Real.sqrt
      (2 / (Real.pi * kernelArgument A c)) *
      (Real.exp (kernelArgument A c) / 2)) /
    (positiveModulus c : ℝ)

theorem kernelWeight_le_besselEnvelopeWeight (A : ℝ) (c : ℕ) :
    kernelWeight A c ≤ besselEnvelopeWeight A c := by
  unfold kernelWeight besselEnvelopeWeight
  exact
    (div_le_div_iff_of_pos_right (positiveModulus_cast_pos c)).2
      (HalfOrderBessel.besselIHalf_le_expEnvelope
        (kernelArgument A c))

/-- One concrete modulus term: the actual finite twisted Kloosterman sum
multiplied by the half-order Bessel weight. -/
noncomputable def rademacherTerm
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ) (c : ℕ) : ℂ :=
  (kernelWeight A c : ℂ) * positiveModulusKloosterman χ m n c

/-- The coefficient truncated before modulus index `C`, hence over the
positive moduli `1, ..., C`. -/
noncomputable def coefficientTruncation
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ) (C : ℕ) : ℂ :=
  ∑ c ∈ Finset.range C, rademacherTerm χ m n A c

/-- The tuned finite main part selects precisely the terms with both
`c < C` and `c < tune`. -/
noncomputable def tunedFiniteMainPart
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ)
    (tune C : ℕ) : ℂ :=
  ∑ c ∈ (Finset.range C).filter (fun c => c < tune),
    rademacherTerm χ m n A c

/-- The complementary finite tail inside the same cutoff. -/
noncomputable def tunedFiniteTail
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ)
    (tune C : ℕ) : ℂ :=
  ∑ c ∈ (Finset.range C).filter (fun c => ¬ c < tune),
    rademacherTerm χ m n A c

@[simp]
theorem coefficientTruncation_zero
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ) :
    coefficientTruncation χ m n A 0 = 0 := by
  simp [coefficientTruncation]

/-- Increasing the cutoff by one appends exactly the term at index `C`. -/
theorem coefficientTruncation_succ
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ) (C : ℕ) :
    coefficientTruncation χ m n A (Nat.succ C) =
      coefficientTruncation χ m n A C +
        rademacherTerm χ m n A C := by
  simp [coefficientTruncation, Finset.sum_range_succ]

/-- Difference form of the preceding exact finite identity. -/
theorem coefficientTruncation_succ_sub
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ) (C : ℕ) :
    coefficientTruncation χ m n A (Nat.succ C) -
        coefficientTruncation χ m n A C =
      rademacherTerm χ m n A C := by
  rw [coefficientTruncation_succ]
  abel

/-- The tuned main part and its finite complement partition the complete
finite coefficient truncation, with no limiting interchange. -/
theorem coefficientTruncation_eq_tunedMain_add_finiteTail
    (χ : MultiplierFamily) (m n : ℤ) (A : ℝ)
    (tune C : ℕ) :
    coefficientTruncation χ m n A C =
      tunedFiniteMainPart χ m n A tune C +
        tunedFiniteTail χ m n A tune C := by
  classical
  unfold coefficientTruncation tunedFiniteMainPart tunedFiniteTail
  rw [← Finset.sum_filter_add_sum_filter_not
    (Finset.range C) (fun c => c < tune)]

/-- Exact norm of one term when the Bessel scale is nonnegative. -/
theorem norm_rademacherTerm_eq
    (χ : MultiplierFamily) (m n : ℤ) {A : ℝ} (hA : 0 ≤ A) (c : ℕ) :
    ‖rademacherTerm χ m n A c‖ =
      kernelWeight A c * ‖positiveModulusKloosterman χ m n c‖ := by
  simp only [rademacherTerm, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (kernelWeight_nonneg hA c)]

/-- The first concrete pointwise bound combines the actual Kloosterman
cardinality estimate with nonnegativity of the exact Bessel weight. -/
theorem norm_rademacherTerm_le_card_bessel
    (χ : MultiplierFamily) (m n : ℤ) {A : ℝ} (hA : 0 ≤ A) (c : ℕ) :
    ‖rademacherTerm χ m n A c‖ ≤
      kernelWeight A c *
        (Fintype.card
          (ConcreteTwistedKloosterman.UnitResidue (positiveModulus c)) : ℝ) := by
  rw [norm_rademacherTerm_eq χ m n hA c]
  exact mul_le_mul_of_nonneg_left
    (norm_positiveModulusKloosterman_le_card χ m n c)
    (kernelWeight_nonneg hA c)

/-- Replacing the exact half-order kernel by its proved exponential envelope
gives an entirely explicit finite-modulus bound. -/
theorem norm_rademacherTerm_le_card_besselEnvelope
    (χ : MultiplierFamily) (m n : ℤ) {A : ℝ} (hA : 0 ≤ A) (c : ℕ) :
    ‖rademacherTerm χ m n A c‖ ≤
      besselEnvelopeWeight A c *
        (Fintype.card
          (ConcreteTwistedKloosterman.UnitResidue (positiveModulus c)) : ℝ) := by
  calc
    ‖rademacherTerm χ m n A c‖ ≤
        kernelWeight A c *
          (Fintype.card
            (ConcreteTwistedKloosterman.UnitResidue
              (positiveModulus c)) : ℝ) :=
      norm_rademacherTerm_le_card_bessel χ m n hA c
    _ ≤ besselEnvelopeWeight A c *
          (Fintype.card
            (ConcreteTwistedKloosterman.UnitResidue
              (positiveModulus c)) : ℝ) :=
      mul_le_mul_of_nonneg_right
        (kernelWeight_le_besselEnvelopeWeight A c)
        (Nat.cast_nonneg _)

/-- The same pointwise estimate summed over a finite cutoff. -/
theorem norm_coefficientTruncation_le_sum_card_besselEnvelope
    (χ : MultiplierFamily) (m n : ℤ) {A : ℝ} (hA : 0 ≤ A) (C : ℕ) :
    ‖coefficientTruncation χ m n A C‖ ≤
      ∑ c ∈ Finset.range C,
        besselEnvelopeWeight A c *
          (Fintype.card
            (ConcreteTwistedKloosterman.UnitResidue
              (positiveModulus c)) : ℝ) := by
  unfold coefficientTruncation
  calc
    ‖∑ c ∈ Finset.range C, rademacherTerm χ m n A c‖ ≤
        ∑ c ∈ Finset.range C, ‖rademacherTerm χ m n A c‖ :=
      norm_sum_le _ _
    _ ≤ ∑ c ∈ Finset.range C,
        besselEnvelopeWeight A c *
          (Fintype.card
            (ConcreteTwistedKloosterman.UnitResidue
              (positiveModulus c)) : ℝ) := by
      exact Finset.sum_le_sum fun c _hc =>
        norm_rademacherTerm_le_card_besselEnvelope χ m n hA c

/-- The critical `1/(c+1)` envelope produced by combining square-root
Kloosterman size with the small-argument half-order Bessel scale. -/
def criticalPointwiseEnvelope (B : ℝ) : ℕ → ℝ :=
  HalfOrderBessel.criticalModulusEnvelope B

theorem criticalPointwiseEnvelope_nonneg
    {B : ℝ} (hB : 0 ≤ B) (c : ℕ) :
    0 ≤ criticalPointwiseEnvelope B c := by
  unfold criticalPointwiseEnvelope HalfOrderBessel.criticalModulusEnvelope
  exact mul_nonneg hB (by positivity)

/-- The existing critical-exponent theorem applies verbatim to the concrete
zero-based modulus indexing. -/
theorem criticalPointwiseEnvelope_not_summable
    {B : ℝ} (hB : B ≠ 0) :
    ¬ Summable (criticalPointwiseEnvelope B) := by
  simpa only [criticalPointwiseEnvelope] using
    (HalfOrderBessel.not_summable_criticalModulusEnvelope hB)

/-- For a positive critical constant, even the absolute-value series of the
critical envelope diverges. -/
theorem abs_criticalPointwiseEnvelope_not_summable
    {B : ℝ} (hB : 0 < B) :
    ¬ Summable (fun c => |criticalPointwiseEnvelope B c|) := by
  have habs :
      (fun c => |criticalPointwiseEnvelope B c|) =
        criticalPointwiseEnvelope B := by
    funext c
    exact abs_of_nonneg (criticalPointwiseEnvelope_nonneg hB.le c)
  rw [habs]
  exact criticalPointwiseEnvelope_not_summable hB.ne'

/-- Pointwise domination by the critical envelope, isolated as a predicate so
that it cannot be confused with an absolute-convergence hypothesis. -/
def CriticalPointwiseControl (f : ℕ → ℝ) (B : ℝ) : Prop :=
  ∀ c, |f c| ≤ criticalPointwiseEnvelope B c

/-- The critical envelope itself is a counterexample: critical pointwise
control alone does not imply summability. -/
theorem criticalPointwiseControl_counterexample
    {B : ℝ} (hB : 0 < B) :
    ∃ f : ℕ → ℝ,
      CriticalPointwiseControl f B ∧
        ¬ Summable (fun c => |f c|) := by
  refine ⟨criticalPointwiseEnvelope B, ?_,
    abs_criticalPointwiseEnvelope_not_summable hB⟩
  intro c
  rw [abs_of_nonneg (criticalPointwiseEnvelope_nonneg hB.le c)]

/-- Formal erratum: neither a trivial estimate nor a square-root pointwise
estimate ending at the critical exponent can, by itself, certify the infinite
absolute sum.  A genuine positive decay margin or cancellation theorem is
still required. -/
theorem criticalPointwiseControl_does_not_imply_summable
    {B : ℝ} (hB : 0 < B) :
    ¬ (∀ f : ℕ → ℝ,
      CriticalPointwiseControl f B →
        Summable (fun c => |f c|)) := by
  intro h
  rcases criticalPointwiseControl_counterexample hB with
    ⟨f, hf, hnot⟩
  exact hnot (h f hf)

end CorrectedLemmas.ConcreteRademacherTruncation

/-! ### The fixed half-order Whittaker leaf

Only the parameter pair `(κ, μ) = (0, 1/2)` is used.  At this pair the
decaying Whittaker solution has the elementary closed form `exp (-x/2)`.
Nothing in this namespace asserts a general Whittaker-function theory. -/

namespace CorrectedLemmas.HalfOrderWhittaker

/-- The fixed-parameter decaying Whittaker kernel
`W_{0,1/2}(x) = exp (-x/2)`. -/
noncomputable def W (x : ℝ) : ℝ :=
  Real.exp (-x / 2)

/-- Its explicit first derivative. -/
noncomputable def firstDerivative (x : ℝ) : ℝ :=
  (-(1 : ℝ) / 2) * W x

/-- Its explicit second derivative. -/
noncomputable def secondDerivative (x : ℝ) : ℝ :=
  ((1 : ℝ) / 4) * W x

theorem W_pos (x : ℝ) : 0 < W x := by
  exact Real.exp_pos _

theorem W_nonneg (x : ℝ) : 0 ≤ W x :=
  (W_pos x).le

/-- Direct chain-rule proof of the first derivative. -/
theorem hasDerivAt_W (x : ℝ) :
    HasDerivAt W (firstDerivative x) x := by
  unfold firstDerivative
  convert ((hasDerivAt_id x).neg.div_const 2).exp using 1
  · funext y
    simp [W, div_eq_mul_inv]
  · simp [W, div_eq_mul_inv, mul_comm]

@[simp]
theorem deriv_W (x : ℝ) :
    deriv W x = firstDerivative x :=
  (hasDerivAt_W x).deriv

/-- Differentiating the explicit first derivative gives the exact second
derivative. -/
theorem hasDerivAt_firstDerivative (x : ℝ) :
    HasDerivAt firstDerivative (secondDerivative x) x := by
  let c : ℝ := -(1 : ℝ) / 2
  have hcoeff : c * firstDerivative x = secondDerivative x := by
    dsimp [c, firstDerivative, secondDerivative]
    ring
  change HasDerivAt (fun y : ℝ => c * W y) (secondDerivative x) x
  have h := (hasDerivAt_W x).const_mul c
  rw [hcoeff] at h
  exact h

@[simp]
theorem deriv_firstDerivative (x : ℝ) :
    deriv firstDerivative x = secondDerivative x :=
  (hasDerivAt_firstDerivative x).deriv

/-- The ordinary second derivative of `W`, stated without an auxiliary
function in the conclusion. -/
theorem deriv_deriv_W (x : ℝ) :
    deriv (deriv W) x = secondDerivative x := by
  have hfirst : deriv W = firstDerivative := by
    funext y
    exact deriv_W y
  rw [hfirst]
  exact deriv_firstDerivative x

theorem differentiable_W : Differentiable ℝ W :=
  fun x => (hasDerivAt_W x).differentiableAt

theorem differentiable_firstDerivative :
    Differentiable ℝ firstDerivative :=
  fun x => (hasDerivAt_firstDerivative x).differentiableAt

/-- The fixed Whittaker ODE before simplifying the parameter term.  The
positive-domain hypothesis records the classical domain on which the displayed
`x⁻²` equation is interpreted. -/
theorem whittakerODE_fixedParameters
    {x : ℝ} (_hx : 0 < x) :
    deriv (deriv W) x +
        (-(1 : ℝ) / 4 +
          (((1 : ℝ) / 4 - ((1 : ℝ) / 2) ^ 2) / x ^ 2)) * W x =
      0 := by
  rw [deriv_deriv_W]
  unfold secondDerivative
  ring

/-- At `μ = 1/2`, the inverse-square coefficient is exactly zero. -/
theorem halfOrder_inverseSquareCoefficient_eq_zero :
    (1 : ℝ) / 4 - ((1 : ℝ) / 2) ^ 2 = 0 := by
  ring

/-- The same fixed Whittaker ODE after simplifying the vanishing
inverse-square coefficient. -/
theorem whittakerODE_fixedParameters_simplified (x : ℝ) :
    deriv (deriv W) x - ((1 : ℝ) / 4) * W x = 0 := by
  rw [deriv_deriv_W]
  unfold secondDerivative
  ring

/-- Scaling the fixed kernel by a real parameter in the cusp-height
variable. -/
noncomputable def scaledKernel (a y : ℝ) : ℝ :=
  W (a * y)

/-- Exact exponential form of the scaled kernel. -/
theorem scaledKernel_eq_exp_mul (a y : ℝ) :
    scaledKernel a y = Real.exp ((-a / 2) * y) := by
  unfold scaledKernel W
  apply congrArg Real.exp
  ring

theorem scaledKernel_pos (a y : ℝ) :
    0 < scaledKernel a y := by
  exact W_pos (a * y)

theorem scaledKernel_nonneg (a y : ℝ) :
    0 ≤ scaledKernel a y :=
  (scaledKernel_pos a y).le

/-- Positive scaling gives exponential decay at the infinite end of the
horocycle-height variable. -/
theorem scaledKernel_tendsto_zero_atTop
    {a : ℝ} (ha : 0 < a) :
    Tendsto (scaledKernel a) atTop (𝓝 0) := by
  have hcoef : -a / 2 < 0 := by linarith
  have hfun :
      scaledKernel a = fun y : ℝ => Real.exp ((-a / 2) * y) := by
    funext y
    exact scaledKernel_eq_exp_mul a y
  rw [hfun]
  exact Real.tendsto_exp_atBot.comp
    ((tendsto_const_mul_atBot_of_neg hcoef).2 tendsto_id)

/-- Positive scaling makes the fixed kernel Bochner-integrable on every
right half-line. -/
theorem integrableOn_scaledKernel_Ioi
    {a : ℝ} (ha : 0 < a) (b : ℝ) :
    IntegrableOn (scaledKernel a) (Set.Ioi b) := by
  have hcoef : -a / 2 < 0 := by linarith
  have hfun :
      scaledKernel a = fun y : ℝ => Real.exp ((-a / 2) * y) := by
    funext y
    exact scaledKernel_eq_exp_mul a y
  rw [hfun]
  exact integrableOn_exp_mul_Ioi hcoef b

/-- The half-line integral in the exact form returned by Mathlib's exponential
integral theorem. -/
theorem integral_scaledKernel_Ioi_raw
    {a : ℝ} (ha : 0 < a) (b : ℝ) :
    (∫ y : ℝ in Set.Ioi b, scaledKernel a y) =
      -Real.exp ((-a / 2) * b) / (-a / 2) := by
  have hcoef : -a / 2 < 0 := by linarith
  have hfun :
      scaledKernel a = fun y : ℝ => Real.exp ((-a / 2) * y) := by
    funext y
    exact scaledKernel_eq_exp_mul a y
  rw [hfun]
  exact integral_exp_mul_Ioi hcoef b

/-- Simplified exact half-line integral of the scaled fixed Whittaker kernel. -/
theorem integral_scaledKernel_Ioi
    {a : ℝ} (ha : 0 < a) (b : ℝ) :
    (∫ y : ℝ in Set.Ioi b, scaledKernel a y) =
      (2 / a) * scaledKernel a b := by
  rw [integral_scaledKernel_Ioi_raw ha b,
    scaledKernel_eq_exp_mul]
  field_simp [ha.ne']
  <;> ring

/-- In particular, the total mass on the positive half-line is `2/a`. -/
theorem integral_scaledKernel_Ioi_zero
    {a : ℝ} (ha : 0 < a) :
    (∫ y : ℝ in Set.Ioi (0 : ℝ), scaledKernel a y) = 2 / a := by
  simpa [scaledKernel, W] using
    (integral_scaledKernel_Ioi ha (0 : ℝ))

end CorrectedLemmas.HalfOrderWhittaker

/-! ### Cusp stabilizers and the width-two local `q` coordinate

For a chosen scaling matrix `σ_κ`, the parabolic fixing the corresponding
cusp is the genuine element `σ_κ T² σ_κ⁻¹` of `Γ(2)`.  Normality of the
principal congruence subgroup supplies membership; no cusp-stabilizer
certificate is stored as data.  Conjugating its action back by `σ_κ⁻¹` gives
the standard width-two translation, from which invariance of the local
`q`-coordinate is proved directly. -/

namespace CorrectedLemmas.CuspQStabilizer

/-- The `q`-parameter is periodic under addition of its nonzero real period.
This is derived from the period `2πi` of the complex exponential rather than
assumed as part of a cusp chart. -/
theorem qParam_add_real_period
    {h : ℝ} (hh : h ≠ 0) (z : ℂ) :
    Function.Periodic.qParam h (z + (h : ℂ)) =
      Function.Periodic.qParam h z := by
  unfold Function.Periodic.qParam
  have hhℂ : (h : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hh
  rw [mul_add, add_div, mul_div_cancel_right₀ _ hhℂ]
  exact Complex.exp_periodic _

/-- Normality of `Γ(2)` puts the conjugated width-two translation back in
`Γ(2)` for every chosen cusp scaling matrix. -/
theorem translationMatrix_mem_gamma2 (k : Mock2Adv.Gamma2Cusp) :
    Mock2Adv.Gamma2Cusp.scalingMatrix k *
          ModularGroup.T ^ (2 : ℤ) *
          (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ ∈ Gamma2 := by
  change
    Mock2Adv.Gamma2Cusp.scalingMatrix k *
          ModularGroup.T ^ (2 : ℤ) *
          (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ ∈
      CongruenceSubgroup.Gamma 2
  exact
    (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (ModularGroup.T ^ (2 : ℤ)) gamma2_T_two_mem
      (Mock2Adv.Gamma2Cusp.scalingMatrix k)

/-- The actual parabolic element attached to a cusp label. -/
def Gamma2Cusp.translationElement
    (k : Mock2Adv.Gamma2Cusp) : Gamma2Element :=
  ⟨Mock2Adv.Gamma2Cusp.scalingMatrix k *
      ModularGroup.T ^ (2 : ℤ) *
      (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹,
    translationMatrix_mem_gamma2 k⟩

/-- In the scaled cusp coordinate, the conjugated parabolic acts exactly as
`T²`. -/
theorem scaledCoordinate_translationElement_eq_T_sq_smul
    (k : Mock2Adv.Gamma2Cusp) (τ : UpperHalfPlane) :
    (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ •
        (Gamma2Cusp.translationElement k • τ) =
      ModularGroup.T ^ (2 : ℤ) •
        ((Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ • τ) := by
  change
    (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ •
        ((Mock2Adv.Gamma2Cusp.scalingMatrix k *
            ModularGroup.T ^ (2 : ℤ) *
            (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹) • τ) =
      ModularGroup.T ^ (2 : ℤ) •
        ((Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ • τ)
  simp only [mul_smul, inv_smul_smul]

/-- The same scaled-coordinate action written as the literal real translation
by the proved cusp width `2`. -/
theorem scaledCoordinate_translationElement_eq_vadd_two
    (k : Mock2Adv.Gamma2Cusp) (τ : UpperHalfPlane) :
    (Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ •
        (Gamma2Cusp.translationElement k • τ) =
      (2 : ℝ) +ᵥ
        ((Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ • τ) :=
  (scaledCoordinate_translationElement_eq_T_sq_smul k τ).trans
    (UpperHalfPlane.modular_T_zpow_smul
      ((Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ • τ) (2 : ℤ))

/-- The cusp-local `q` coordinate descends across its concrete width-two
stabilizer.  This is a direct equality of the already-defined coordinate,
not a covariance field stored in a local-system structure. -/
theorem cuspQCoordinate_translationElement
    (k : Mock2Adv.Gamma2Cusp) (τ : UpperHalfPlane) :
    cuspQCoordinate k
        (Gamma2Cusp.translationElement k • τ) =
      cuspQCoordinate k τ := by
  rw [cuspQCoordinate_eq_qParam, cuspQCoordinate_eq_qParam,
    scaledCoordinate_translationElement_eq_vadd_two,
    UpperHalfPlane.coe_vadd]
  simpa [Mock2Adv.Gamma2Cusp.width_eq_two, add_comm] using
    (qParam_add_real_period (h := (2 : ℝ)) (by norm_num)
      (↑((Mock2Adv.Gamma2Cusp.scalingMatrix k)⁻¹ • τ) : ℂ))

end CorrectedLemmas.CuspQStabilizer

/-! ### A concrete six-cell polygon attached to the index-six level-two subgroup

The standard modular closed and open fundamental regions are already available
in Mathlib as `ModularGroup.fd` and `ModularGroup.fdo`.  We fix six explicit
modular matrices and take the inverse images of those regions under their
Möbius actions.  The resulting finite unions are honest closed and open subsets
of the upper half-plane, respectively.

The construction is separated into three auditable layers: the finite
topological union, the exact mod-two coset classification giving orbit coverage,
and the compactness proof for simultaneous three-cusp truncations.  No
fundamental-domain property is smuggled into the set definition itself.
-/

namespace CorrectedLemmas.Gamma2SixCellPolygon

/-- Labels for the six explicitly chosen modular cells. -/
inductive Gamma2Rep
  | id
  | t
  | s
  | ts
  | stInv
  | tstInv
  deriving DecidableEq, Repr

instance : Fintype Gamma2Rep where
  elems := { .id, .t, .s, .ts, .stInv, .tstInv }
  complete x := by cases x <;> simp

/-- The integral determinant-one matrix group.  `ModularGroup` is Mathlib's
namespace for distinguished matrices and fundamental-domain theorems, not the
underlying matrix type, so the type is named explicitly here. -/
abbrev IntegralSpecialLinear : Type :=
  Matrix.SpecialLinearGroup (Fin 2) ℤ

/-- The six standard modular matrices used to assemble the level-two polygon. -/
def repMatrix : Gamma2Rep → IntegralSpecialLinear
  | .id => 1
  | .t => ModularGroup.T
  | .s => ModularGroup.S
  | .ts => ModularGroup.T * ModularGroup.S
  | .stInv => ModularGroup.S * ModularGroup.T⁻¹
  | .tstInv => ModularGroup.T * ModularGroup.S * ModularGroup.T⁻¹

@[simp]
theorem repMatrix_id : repMatrix .id = 1 := rfl

@[simp]
theorem repMatrix_t : repMatrix .t = ModularGroup.T := rfl

@[simp]
theorem repMatrix_s : repMatrix .s = ModularGroup.S := rfl

@[simp]
theorem repMatrix_ts :
    repMatrix .ts = ModularGroup.T * ModularGroup.S := rfl

@[simp]
theorem repMatrix_stInv :
    repMatrix .stInv = ModularGroup.S * ModularGroup.T⁻¹ := rfl

@[simp]
theorem repMatrix_tstInv :
    repMatrix .tstInv =
      ModularGroup.T * ModularGroup.S * ModularGroup.T⁻¹ := rfl

/-- There are exactly six labels in the explicit representative list. -/
theorem card_gamma2Rep : Fintype.card Gamma2Rep = 6 := by
  decide

/-! #### The six representatives really are the six mod-two cosets

The principal congruence subgroup `Γ(2)` is the kernel of reduction to
`SL₂(ZMod 2)`.  The finite computation below is therefore the missing bridge
between the six labels and actual left and right cosets.  It is completely
independent of the analytic fundamental-domain argument that follows it. -/

/-- The finite quotient group detecting membership in `Γ(2)`. -/
abbrev ModTwoSpecialLinear : Type :=
  Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)

/-- Entrywise reduction of an integral determinant-one matrix modulo two. -/
def modTwoReduction : IntegralSpecialLinear →* ModTwoSpecialLinear :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod 2))

/-- The residue class represented by one of the six chosen matrices. -/
def reducedRep (r : Gamma2Rep) : ModTwoSpecialLinear :=
  modTwoReduction (repMatrix r)

@[simp]
theorem modTwoReduction_apply (g : IntegralSpecialLinear) (i j : Fin 2) :
    modTwoReduction g i j = (g i j : ZMod 2) :=
  rfl

/-- The central matrix `-1` becomes the identity modulo two. -/
@[simp]
theorem modTwoReduction_neg_one :
    modTwoReduction (-1 : IntegralSpecialLinear) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- The six reduced matrices are pairwise distinct.  All four entries are
retained in the proof so that no projective `±1` identification is hidden. -/
theorem reducedRep_injective : Function.Injective reducedRep := by
  decide

/-- Direct finite count of `SL₂(F₂)`.  The subtype contains exactly the six
two-by-two matrices over `ZMod 2` whose determinant is one. -/
theorem card_modTwoSpecialLinear :
    Fintype.card ModTwoSpecialLinear = 6 := by
  decide

/-- The six explicitly reduced matrices give every element of `SL₂(F₂)`
exactly once. -/
theorem reducedRep_bijective : Function.Bijective reducedRep := by
  refine (Fintype.bijective_iff_injective_and_card reducedRep).2
    ⟨reducedRep_injective, ?_⟩
  rw [card_gamma2Rep, card_modTwoSpecialLinear]

theorem reducedRep_surjective : Function.Surjective reducedRep :=
  reducedRep_bijective.2

/-- Kernel membership is literally equality to one after mod-two reduction. -/
theorem mem_gamma2_iff_modTwoReduction_eq_one (g : IntegralSpecialLinear) :
    g ∈ Mock2Adv.Gamma2 ↔ modTwoReduction g = 1 :=
  CongruenceSubgroup.Gamma_mem'

/-- A concrete `Γ(2)` element reduces to the identity matrix. -/
@[simp]
theorem modTwoReduction_gamma2 (γ : Mock2Adv.Gamma2Element) :
    modTwoReduction γ.1 = 1 :=
  (mem_gamma2_iff_modTwoReduction_eq_one γ.1).mp γ.property

/-- If an intertwiner built from two cell labels and a `Γ(2)` element is
central, the two labels have the same mod-two residue. -/
theorem reducedRep_eq_of_intertwiner_central
    (r s : Gamma2Rep) (γ : Mock2Adv.Gamma2Element)
    (hcentral :
      repMatrix s * γ.1 * (repMatrix r)⁻¹ = 1 ∨
        repMatrix s * γ.1 * (repMatrix r)⁻¹ = -1) :
    reducedRep s = reducedRep r := by
  have hred :
      modTwoReduction
          (repMatrix s * γ.1 * (repMatrix r)⁻¹) = 1 := by
    rcases hcentral with hcentral | hcentral
    · rw [hcentral, map_one]
    · rw [hcentral, modTwoReduction_neg_one]
  apply mul_inv_eq_one.mp
  simpa only [map_mul, map_inv, reducedRep,
    modTwoReduction_gamma2, mul_one] using hred

/-- Every modular matrix has one of the six representatives on the left and a
`Γ(2)` factor on the right. -/
theorem exists_rep_inv_mul_mem_gamma2 (g : IntegralSpecialLinear) :
    ∃ r : Gamma2Rep, (repMatrix r)⁻¹ * g ∈ Mock2Adv.Gamma2 := by
  obtain ⟨r, hr⟩ := reducedRep_surjective (modTwoReduction g)
  refine ⟨r, (mem_gamma2_iff_modTwoReduction_eq_one _).2 ?_⟩
  rw [map_mul, map_inv]
  change (reducedRep r)⁻¹ * modTwoReduction g = 1
  simpa [hr]

/-- Equivalent right-factor decomposition of every integral modular matrix. -/
theorem exists_rep_mul_gamma2 (g : IntegralSpecialLinear) :
    ∃ (r : Gamma2Rep) (γ : Mock2Adv.Gamma2Element),
      g = repMatrix r * γ.1 := by
  obtain ⟨r, hr⟩ := exists_rep_inv_mul_mem_gamma2 g
  let γ : Mock2Adv.Gamma2Element := ⟨(repMatrix r)⁻¹ * g, hr⟩
  refine ⟨r, γ, ?_⟩
  simp [γ, mul_assoc]

/-- Normality is visible concretely: the same list also represents the right
cosets, with the `Γ(2)` factor on the left. -/
theorem exists_mul_rep_inv_mem_gamma2 (g : IntegralSpecialLinear) :
    ∃ r : Gamma2Rep, g * (repMatrix r)⁻¹ ∈ Mock2Adv.Gamma2 := by
  obtain ⟨r, hr⟩ := reducedRep_surjective (modTwoReduction g)
  refine ⟨r, (mem_gamma2_iff_modTwoReduction_eq_one _).2 ?_⟩
  rw [map_mul, map_inv]
  change modTwoReduction g * (reducedRep r)⁻¹ = 1
  simpa [← hr]

/-- Equivalent left-factor decomposition of every integral modular matrix. -/
theorem exists_gamma2_mul_rep (g : IntegralSpecialLinear) :
    ∃ (γ : Mock2Adv.Gamma2Element) (r : Gamma2Rep),
      g = γ.1 * repMatrix r := by
  obtain ⟨r, hr⟩ := exists_mul_rep_inv_mem_gamma2 g
  let γ : Mock2Adv.Gamma2Element := ⟨g * (repMatrix r)⁻¹, hr⟩
  refine ⟨γ, r, ?_⟩
  simp [γ, mul_assoc]

/-- Closed cell obtained by pulling back the standard closed modular region. -/
def closedCell (r : Gamma2Rep) : Set UpperHalfPlane :=
  (fun τ => repMatrix r • τ) ⁻¹' ModularGroup.fd

/-- Open cell obtained by pulling back the standard open modular region. -/
def openCell (r : Gamma2Rep) : Set UpperHalfPlane :=
  (fun τ => repMatrix r • τ) ⁻¹' ModularGroup.fdo

theorem mem_closedCell_iff (r : Gamma2Rep) (τ : UpperHalfPlane) :
    τ ∈ closedCell r ↔ repMatrix r • τ ∈ ModularGroup.fd :=
  Iff.rfl

theorem mem_openCell_iff (r : Gamma2Rep) (τ : UpperHalfPlane) :
    τ ∈ openCell r ↔ repMatrix r • τ ∈ ModularGroup.fdo :=
  Iff.rfl

/-- Every closed cell is closed because the modular action is continuous. -/
theorem isClosed_closedCell (r : Gamma2Rep) : IsClosed (closedCell r) := by
  apply ModularGroup.isClosed_fd.preimage
  change Continuous (fun τ : UpperHalfPlane =>
    ((repMatrix r : IntegralSpecialLinear) : GL (Fin 2) ℝ) • τ)
  exact continuous_const_smul _

/-- Every open cell is open because the modular action is continuous. -/
theorem isOpen_openCell (r : Gamma2Rep) : IsOpen (openCell r) := by
  apply ModularGroup.isOpen_fdo.preimage
  change Continuous (fun τ : UpperHalfPlane =>
    ((repMatrix r : IntegralSpecialLinear) : GL (Fin 2) ℝ) • τ)
  exact continuous_const_smul _

/-- Distinct mod-two labels have disjoint open modular cells.  The level-one
interior uniqueness theorem leaves only the central matrices `±1`; both reduce
to one modulo two, contradicting injectivity of the six residue labels. -/
theorem disjoint_openCell_of_ne {r s : Gamma2Rep} (hrs : r ≠ s) :
    Disjoint (openCell r) (openCell s) := by
  refine Set.disjoint_left.mpr fun τ hr hs => ?_
  have hs' :
      (repMatrix s * (repMatrix r)⁻¹) • (repMatrix r • τ) ∈
        ModularGroup.fdo := by
    change repMatrix s • τ ∈ ModularGroup.fdo at hs
    simpa only [mul_smul, inv_smul_smul] using hs
  have hcentral :
      repMatrix s * (repMatrix r)⁻¹ = 1 ∨
        repMatrix s * (repMatrix r)⁻¹ = -1 :=
    ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo hr hs'
  have hred :
      modTwoReduction (repMatrix s * (repMatrix r)⁻¹) = 1 := by
    rcases hcentral with hcentral | hcentral
    · rw [hcentral, map_one]
    · rw [hcentral, modTwoReduction_neg_one]
  have hrsRed : reducedRep s = reducedRep r := by
    apply mul_inv_eq_one.mp
    simpa only [map_mul, map_inv, reducedRep] using hred
  exact hrs (reducedRep_injective hrsRed).symm

/-- The six open cells are pairwise disjoint as labelled subsets. -/
theorem pairwise_disjoint_openCell :
    Pairwise (fun r s => Disjoint (openCell r) (openCell s)) := by
  intro r s hrs
  exact disjoint_openCell_of_ne hrs

/-- The concrete closed six-cell polygon. -/
def closedPolygon : Set UpperHalfPlane :=
  ⋃ r : Gamma2Rep, closedCell r

/-- The corresponding union of open modular cells. -/
def openPolygon : Set UpperHalfPlane :=
  ⋃ r : Gamma2Rep, openCell r

theorem mem_closedPolygon_iff (τ : UpperHalfPlane) :
    τ ∈ closedPolygon ↔ ∃ r : Gamma2Rep, τ ∈ closedCell r := by
  simp [closedPolygon]

theorem mem_openPolygon_iff (τ : UpperHalfPlane) :
    τ ∈ openPolygon ↔ ∃ r : Gamma2Rep, τ ∈ openCell r := by
  simp [openPolygon]

/-- Interior orbit-representative uniqueness for the explicit level-two
polygon.  If two interior points are related by `Γ(2)`, they are equal.  The
proof first uses level-one interior uniqueness on the conjugated matrix, then
uses reduction modulo two to show that the two cell labels coincide. -/
theorem eq_of_mem_openPolygon_of_gamma2_smul_eq
    {x y : UpperHalfPlane}
    (hx : x ∈ openPolygon) (hy : y ∈ openPolygon)
    (γ : Mock2Adv.Gamma2Element) (hγ : γ • x = y) :
    x = y := by
  obtain ⟨r, hrCell⟩ := (mem_openPolygon_iff x).mp hx
  obtain ⟨s, hsCell⟩ := (mem_openPolygon_iff y).mp hy
  have hr : repMatrix r • x ∈ ModularGroup.fdo :=
    (mem_openCell_iff r x).mp hrCell
  have hs : repMatrix s • y ∈ ModularGroup.fdo :=
    (mem_openCell_iff s y).mp hsCell
  let g : IntegralSpecialLinear :=
    repMatrix s * γ.1 * (repMatrix r)⁻¹
  have hγ' :
      (((γ.1 : IntegralSpecialLinear) : GL (Fin 2) ℝ) • x) = y := by
    change (γ.1 : IntegralSpecialLinear) • x = y at hγ
    simpa only [ModularGroup.sl_moeb] using hγ
  have htransport :
      g • (repMatrix r • x) = repMatrix s • y := by
    simp [g, mul_smul, hγ']
  have hg : g • (repMatrix r • x) ∈ ModularGroup.fdo := by
    rw [htransport]
    exact hs
  have hcentral : g = 1 ∨ g = -1 :=
    ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo hr hg
  have hrsRed : reducedRep s = reducedRep r :=
    reducedRep_eq_of_intertwiner_central r s γ <| by
      simpa only [g] using hcentral
  have hrs : s = r := reducedRep_injective hrsRed
  have hfundamental :
      repMatrix r • x = g • (repMatrix r • x) :=
    ModularGroup.eq_smul_self_of_mem_fdo_mem_fdo hr hg
  rw [htransport] at hfundamental
  subst s
  have hcancel := congrArg
    (fun z : UpperHalfPlane => (repMatrix r)⁻¹ • z) hfundamental
  simpa [← mul_smul] using hcancel

/-- A finite union of the six closed cells is closed. -/
theorem isClosed_closedPolygon : IsClosed closedPolygon := by
  rw [closedPolygon]
  exact isClosed_iUnion_of_finite isClosed_closedCell

/-- The union of the six open cells is open. -/
theorem isOpen_openPolygon : IsOpen openPolygon := by
  rw [openPolygon]
  exact isOpen_iUnion isOpen_openCell

/-- Every `Γ(2)` orbit meets the explicit six-cell closed polygon.  This is the
promised orbit-coverage theorem: it combines the level-one fundamental-domain
lemma with the proved right-factor decomposition, and introduces no new
geometric hypothesis. -/
theorem exists_gamma2_smul_mem_closedPolygon (τ : UpperHalfPlane) :
    ∃ γ : Mock2Adv.Gamma2Element, γ • τ ∈ closedPolygon := by
  obtain ⟨g, hg⟩ := ModularGroup.exists_smul_mem_fd τ
  obtain ⟨r, γ, hfactor⟩ := exists_rep_mul_gamma2 g
  refine ⟨γ, (mem_closedPolygon_iff (γ • τ)).2 ⟨r, ?_⟩⟩
  apply (mem_closedCell_iff r (γ • τ)).2
  change repMatrix r • (γ.1 • τ) ∈ ModularGroup.fd
  rw [← mul_smul, ← hfactor]
  exact hg

/-! #### Compactness of every simultaneous three-cusp truncation

Each of the six modular cells has one of the three selected cusp heights as
the imaginary part of its defining level-one translate.  This exact identity
places the simultaneous three-cusp truncation inside a finite union of
homeomorphic preimages of Mathlib's compact standard truncated fundamental
domain.  Closedness then gives compactness of the desired subset. -/

/-- The cusp whose height is the imaginary part on a selected modular cell.
The two representatives in each fibre differ by a left translation by `T`,
which preserves the imaginary part. -/
def repCusp : Gamma2Rep → Gamma2Cusp
  | .id => .infinity
  | .t => .infinity
  | .s => .zero
  | .ts => .zero
  | .stInv => .one
  | .tstInv => .one

@[simp]
theorem repCusp_id : repCusp .id = .infinity := rfl

@[simp]
theorem repCusp_t : repCusp .t = .infinity := rfl

@[simp]
theorem repCusp_s : repCusp .s = .zero := rfl

@[simp]
theorem repCusp_ts : repCusp .ts = .zero := rfl

@[simp]
theorem repCusp_stInv : repCusp .stInv = .one := rfl

@[simp]
theorem repCusp_tstInv : repCusp .tstInv = .one := rfl

/-- The cusp represented by the first column of a six-cell matrix.  This is
deliberately distinct from `repCusp`: left multiplication by `T` preserves
imaginary part, which is why `repCusp .ts = .zero`, but it changes the first
column of `S` from `(0,1)` to `(1,1)`.  Keeping the two maps separate prevents
the compactness height identity from being conflated with the primitive-column
orbit identity. -/
def repColumnCusp : Gamma2Rep → Gamma2Cusp
  | .id => .infinity
  | .t => .infinity
  | .s => .zero
  | .ts => .one
  | .stInv => .zero
  | .tstInv => .one

@[simp]
theorem repColumnCusp_id : repColumnCusp .id = .infinity := rfl

@[simp]
theorem repColumnCusp_t : repColumnCusp .t = .infinity := rfl

@[simp]
theorem repColumnCusp_s : repColumnCusp .s = .zero := rfl

@[simp]
theorem repColumnCusp_ts : repColumnCusp .ts = .one := rfl

@[simp]
theorem repColumnCusp_stInv : repColumnCusp .stInv = .zero := rfl

@[simp]
theorem repColumnCusp_tstInv : repColumnCusp .tstInv = .one := rfl

/-- The `TS` representative exposes the precise difference between column and
height labels: its first column is the cusp-one column, while its imaginary
part is measured by the cusp-zero height. -/
theorem repColumnCusp_ts_ne_repCusp_ts :
    repColumnCusp .ts ≠ repCusp .ts := by
  simp

/-- The inverse discrepancy occurs for `S T⁻¹`. -/
theorem repColumnCusp_stInv_ne_repCusp_stInv :
    repColumnCusp .stInv ≠ repCusp .stInv := by
  simp

@[simp]
theorem repMatrix_id_im (τ : UpperHalfPlane) :
    (repMatrix .id • τ).im = cuspHeight .infinity τ := by
  simp

@[simp]
theorem repMatrix_t_im (τ : UpperHalfPlane) :
    (repMatrix .t • τ).im = cuspHeight .infinity τ := by
  rw [repMatrix_t, cuspHeight_infinity, ModularGroup.im_T_smul]

@[simp]
theorem repMatrix_s_im (τ : UpperHalfPlane) :
    (repMatrix .s • τ).im = cuspHeight .zero τ := by
  rw [repMatrix_s]
  change (ModularGroup.S • τ).im = (ModularGroup.S⁻¹ • τ).im
  rw [ModularGroup.S_inv, ModularGroup.SL_neg_smul]

@[simp]
theorem repMatrix_ts_im (τ : UpperHalfPlane) :
    (repMatrix .ts • τ).im = cuspHeight .zero τ := by
  rw [repMatrix_ts]
  change ((ModularGroup.T * ModularGroup.S) • τ).im =
    (ModularGroup.S⁻¹ • τ).im
  rw [mul_smul, ModularGroup.im_T_smul, ModularGroup.S_inv,
    ModularGroup.SL_neg_smul]

@[simp]
theorem repMatrix_stInv_im (τ : UpperHalfPlane) :
    (repMatrix .stInv • τ).im = cuspHeight .one τ := by
  rw [repMatrix_stInv]
  change ((ModularGroup.S * ModularGroup.T⁻¹) • τ).im =
    (((ModularGroup.T * ModularGroup.S)⁻¹) • τ).im
  simp only [mul_inv_rev, ModularGroup.S_inv, mul_smul,
    ModularGroup.SL_neg_smul]

@[simp]
theorem repMatrix_tstInv_im (τ : UpperHalfPlane) :
    (repMatrix .tstInv • τ).im = cuspHeight .one τ := by
  rw [repMatrix_tstInv, mul_assoc, mul_smul,
    ModularGroup.im_T_smul]
  simpa only [repMatrix_stInv] using repMatrix_stInv_im τ

/-- Exact height identity for all six representatives. -/
@[simp]
theorem repMatrix_im_eq_cuspHeight (r : Gamma2Rep)
    (τ : UpperHalfPlane) :
    (repMatrix r • τ).im = cuspHeight (repCusp r) τ := by
  cases r with
  | id => exact repMatrix_id_im τ
  | t => exact repMatrix_t_im τ
  | s => exact repMatrix_s_im τ
  | ts => exact repMatrix_ts_im τ
  | stInv => exact repMatrix_stInv_im τ
  | tstInv => exact repMatrix_tstInv_im τ

/-! #### Heights after pulling a six-cell representative back from `fd` -/

/-- Height of the inverse image of a standard-domain point under one of the
six representatives.  This is the height that occurs after using invariance
of hyperbolic measure to integrate over one pulled-back cell. -/
noncomputable def pullbackHeight
    (r : Gamma2Rep) (z : UpperHalfPlane) : ℝ :=
  ((repMatrix r)⁻¹ • z : UpperHalfPlane).im

@[simp]
theorem pullbackHeight_id (z : UpperHalfPlane) :
    pullbackHeight .id z = z.im := by
  simp [pullbackHeight, repMatrix]

@[simp]
theorem pullbackHeight_t (z : UpperHalfPlane) :
    pullbackHeight .t z = z.im := by
  have h := ModularGroup.im_T_smul (ModularGroup.T⁻¹ • z)
  simpa [pullbackHeight, repMatrix_t, mul_smul] using h.symm

@[simp]
theorem pullbackHeight_s (z : UpperHalfPlane) :
    pullbackHeight .s z =
      z.im / Complex.normSq (z : ℂ) := by
  simpa only [pullbackHeight, repMatrix_s, cuspHeight,
    Gamma2Cusp.scalingMatrix] using cuspHeight_zero z

@[simp]
theorem pullbackHeight_ts (z : UpperHalfPlane) :
    pullbackHeight .ts z =
      z.im / Complex.normSq ((z : ℂ) - 1) := by
  simpa only [pullbackHeight, repMatrix_ts, cuspHeight,
    Gamma2Cusp.scalingMatrix] using cuspHeight_one z

@[simp]
theorem pullbackHeight_stInv (z : UpperHalfPlane) :
    pullbackHeight .stInv z =
      z.im / Complex.normSq (z : ℂ) := by
  rw [pullbackHeight, repMatrix_stInv, mul_inv_rev, inv_inv,
    mul_smul, ModularGroup.im_T_smul]
  simpa only [cuspHeight, Gamma2Cusp.scalingMatrix] using
    cuspHeight_zero z

@[simp]
theorem pullbackHeight_tstInv (z : UpperHalfPlane) :
    pullbackHeight .tstInv z =
      z.im / Complex.normSq ((z : ℂ) - 1) := by
  rw [pullbackHeight, repMatrix_tstInv, mul_inv_rev, inv_inv,
    mul_smul, ModularGroup.im_T_smul]
  simpa only [cuspHeight, Gamma2Cusp.scalingMatrix] using
    cuspHeight_one z

/-- Uniform expression of the inverse-cell height through the first-column
cusp label.  This is intentionally based on `repColumnCusp`, not `repCusp`. -/
@[simp]
theorem pullbackHeight_eq_cuspHeight
    (r : Gamma2Rep) (z : UpperHalfPlane) :
    pullbackHeight r z = cuspHeight (repColumnCusp r) z := by
  cases r <;> simp

/-- Real-coordinate bounds in the closed standard modular domain. -/
theorem fd_re_bounds {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    -(1 / 2 : ℝ) ≤ z.re ∧ z.re ≤ (1 / 2 : ℝ) :=
  abs_le.mp hz.2

/-- The familiar `3/4` lower bound for the square of the height in `fd`. -/
theorem fd_three_quarters_le_im_sq
    {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    (3 / 4 : ℝ) ≤ z.im ^ 2 := by
  nlinarith [ModularGroup.three_le_four_mul_im_sq_of_mem_fd hz]

/-- A deliberately rational lower bound, sufficient for every later
denominator estimate. -/
theorem fd_half_le_im {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    (1 / 2 : ℝ) ≤ z.im := by
  by_contra h
  have hylt : z.im < (1 / 2 : ℝ) := lt_of_not_ge h
  have hprod : 0 < z.im * ((1 / 2 : ℝ) - z.im) :=
    mul_pos z.im_pos (sub_pos.mpr hylt)
  nlinarith [fd_three_quarters_le_im_sq hz]

/-- Upper bound for the zero-cusp denominator on `fd`. -/
theorem fd_normSq_le_im_sq_add_quarter
    {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    Complex.normSq (z : ℂ) ≤ z.im ^ 2 + (1 / 4 : ℝ) := by
  obtain ⟨hreLower, hreUpper⟩ := fd_re_bounds hz
  have hprod :
      0 ≤ ((1 / 2 : ℝ) - z.re) * ((1 / 2 : ℝ) + z.re) :=
    mul_nonneg (sub_nonneg.mpr hreUpper) (by linarith)
  rw [Complex.normSq_apply]
  simp only [UpperHalfPlane.coe_re, UpperHalfPlane.coe_im]
  nlinarith [hprod]

/-- Upper bound for the cusp-one denominator on `fd`. -/
theorem fd_normSq_sub_one_le_im_sq_add_nine_quarters
    {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    Complex.normSq ((z : ℂ) - 1) ≤
      z.im ^ 2 + (9 / 4 : ℝ) := by
  obtain ⟨hreLower, hreUpper⟩ := fd_re_bounds hz
  have hlower : -(3 / 2 : ℝ) ≤ z.re - 1 := by linarith
  have hupper : z.re - 1 ≤ (3 / 2 : ℝ) := by linarith
  have hprod :
      0 ≤ ((3 / 2 : ℝ) - (z.re - 1)) *
        ((3 / 2 : ℝ) + (z.re - 1)) :=
    mul_nonneg (sub_nonneg.mpr hupper) (by linarith)
  rw [Complex.normSq_apply]
  simp only [Complex.sub_re, Complex.one_re, Complex.sub_im,
    Complex.one_im, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, sub_zero]
  nlinarith

/-- The imaginary square is a lower bound for the zero-cusp denominator. -/
theorem im_sq_le_normSq (z : UpperHalfPlane) :
    z.im ^ 2 ≤ Complex.normSq (z : ℂ) := by
  rw [Complex.normSq_apply]
  simp only [UpperHalfPlane.coe_re, UpperHalfPlane.coe_im]
  nlinarith [sq_nonneg z.re]

/-- The same lower bound for the cusp-one denominator. -/
theorem im_sq_le_normSq_sub_one (z : UpperHalfPlane) :
    z.im ^ 2 ≤ Complex.normSq ((z : ℂ) - 1) := by
  rw [Complex.normSq_apply]
  simp only [Complex.sub_re, Complex.one_re, Complex.sub_im,
    Complex.one_im, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, sub_zero]
  nlinarith [sq_nonneg (z.re - 1)]

/-- Coarse upper control of every inverse-cell height on the standard domain. -/
theorem pullbackHeight_le_on_fd
    (r : Gamma2Rep) {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    pullbackHeight r z ≤ 2 * (1 + z.im) := by
  have hy : (1 / 2 : ℝ) ≤ z.im := fd_half_le_im hz
  have hyTwoSq : z.im ≤ 2 * z.im ^ 2 := by
    have hprod : 0 ≤ z.im * (z.im - (1 / 2 : ℝ)) :=
      mul_nonneg z.im_pos.le (sub_nonneg.mpr hy)
    nlinarith
  have zeroCase :
      z.im / Complex.normSq (z : ℂ) ≤ 2 * (1 + z.im) := by
    apply (div_le_iff₀ (normSq_coe_pos z)).2
    calc
      z.im ≤ 2 * z.im ^ 2 := hyTwoSq
      _ ≤ 2 * (1 + z.im) * Complex.normSq (z : ℂ) := by
        have hnonneg : 0 ≤ 2 * (1 + z.im) := by positivity
        calc
          2 * z.im ^ 2 ≤ 2 * (1 + z.im) * z.im ^ 2 := by
            exact mul_le_mul_of_nonneg_right
              (by nlinarith [z.im_pos] : (2 : ℝ) ≤ 2 * (1 + z.im))
              (sq_nonneg z.im)
          _ ≤ 2 * (1 + z.im) * Complex.normSq (z : ℂ) :=
            mul_le_mul_of_nonneg_left (im_sq_le_normSq z) hnonneg
  have oneCase :
      z.im / Complex.normSq ((z : ℂ) - 1) ≤ 2 * (1 + z.im) := by
    apply (div_le_iff₀ (normSq_sub_one_pos z)).2
    calc
      z.im ≤ 2 * z.im ^ 2 := hyTwoSq
      _ ≤ 2 * (1 + z.im) * Complex.normSq ((z : ℂ) - 1) := by
        have hnonneg : 0 ≤ 2 * (1 + z.im) := by positivity
        calc
          2 * z.im ^ 2 ≤ 2 * (1 + z.im) * z.im ^ 2 := by
            exact mul_le_mul_of_nonneg_right
              (by nlinarith [z.im_pos] : (2 : ℝ) ≤ 2 * (1 + z.im))
              (sq_nonneg z.im)
          _ ≤ 2 * (1 + z.im) * Complex.normSq ((z : ℂ) - 1) :=
            mul_le_mul_of_nonneg_left (im_sq_le_normSq_sub_one z) hnonneg
  cases r <;> simp only [pullbackHeight_id, pullbackHeight_t,
    pullbackHeight_s, pullbackHeight_ts, pullbackHeight_stInv,
    pullbackHeight_tstInv] <;> first | exact zeroCase | exact oneCase | nlinarith

/-- Denominator-free reciprocal control of every inverse-cell height. -/
theorem pullbackHeight_reciprocal_control_on_fd
    (r : Gamma2Rep) {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    1 ≤ 5 * (1 + z.im) * pullbackHeight r z := by
  have hy : (1 / 2 : ℝ) ≤ z.im := fd_half_le_im hz
  have zeroDenom :
      Complex.normSq (z : ℂ) ≤ 5 * (1 + z.im) * z.im := by
    calc
      Complex.normSq (z : ℂ) ≤ z.im ^ 2 + (1 / 4 : ℝ) :=
        fd_normSq_le_im_sq_add_quarter hz
      _ ≤ 5 * (1 + z.im) * z.im := by nlinarith
  have oneDenom :
      Complex.normSq ((z : ℂ) - 1) ≤ 5 * (1 + z.im) * z.im := by
    calc
      Complex.normSq ((z : ℂ) - 1) ≤ z.im ^ 2 + (9 / 4 : ℝ) :=
        fd_normSq_sub_one_le_im_sq_add_nine_quarters hz
      _ ≤ 5 * (1 + z.im) * z.im := by nlinarith
  have zeroCase :
      1 ≤ 5 * (1 + z.im) *
        (z.im / Complex.normSq (z : ℂ)) := by
    calc
      1 ≤ (5 * (1 + z.im) * z.im) /
          Complex.normSq (z : ℂ) :=
        (le_div_iff₀ (normSq_coe_pos z)).2
          (by simpa only [one_mul] using zeroDenom)
      _ = 5 * (1 + z.im) *
          (z.im / Complex.normSq (z : ℂ)) := by ring
  have oneCase :
      1 ≤ 5 * (1 + z.im) *
        (z.im / Complex.normSq ((z : ℂ) - 1)) := by
    calc
      1 ≤ (5 * (1 + z.im) * z.im) /
          Complex.normSq ((z : ℂ) - 1) :=
        (le_div_iff₀ (normSq_sub_one_pos z)).2
          (by simpa only [one_mul] using oneDenom)
      _ = 5 * (1 + z.im) *
          (z.im / Complex.normSq ((z : ℂ) - 1)) := by ring
  cases r <;> simp only [pullbackHeight_id, pullbackHeight_t,
    pullbackHeight_s, pullbackHeight_ts, pullbackHeight_stInv,
    pullbackHeight_tstInv] <;> first | exact zeroCase | exact oneCase | nlinarith

/-- Every inverse-cell height is strictly positive. -/
theorem pullbackHeight_pos (r : Gamma2Rep) (z : UpperHalfPlane) :
    0 < pullbackHeight r z := by
  change 0 < (((repMatrix r)⁻¹ • z : UpperHalfPlane).im)
  exact UpperHalfPlane.im_pos _

/-- Square-root upper control of every inverse-cell height on `fd`. -/
theorem sqrt_pullbackHeight_le_on_fd
    (r : Gamma2Rep) {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    Real.sqrt (pullbackHeight r z) ≤
      2 * (1 + Real.sqrt z.im) := by
  have hh : 0 < pullbackHeight r z := pullbackHeight_pos r z
  have hright : 0 ≤ 2 * (1 + Real.sqrt z.im) := by positivity
  apply (sq_le_sq₀ (Real.sqrt_nonneg _) hright).mp
  rw [Real.sq_sqrt hh.le]
  calc
    pullbackHeight r z ≤ 2 * (1 + z.im) :=
      pullbackHeight_le_on_fd r hz
    _ ≤ (2 * (1 + Real.sqrt z.im)) ^ 2 := by
      have hySq : (Real.sqrt z.im) ^ 2 = z.im :=
        Real.sq_sqrt z.im_pos.le
      nlinarith [hySq, Real.sqrt_nonneg z.im]

/-- Reciprocal square-root control of every inverse-cell height on `fd`. -/
theorem inv_sqrt_pullbackHeight_le_on_fd
    (r : Gamma2Rep) {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    (Real.sqrt (pullbackHeight r z))⁻¹ ≤
      3 * (1 + Real.sqrt z.im) := by
  have hh : 0 < pullbackHeight r z := pullbackHeight_pos r z
  have hs : 0 < Real.sqrt (pullbackHeight r z) := Real.sqrt_pos.2 hh
  have hySq : (Real.sqrt z.im) ^ 2 = z.im :=
    Real.sq_sqrt z.im_pos.le
  have hcoefficient :
      5 * (1 + z.im) ≤
        (3 * (1 + Real.sqrt z.im)) ^ 2 := by
    nlinarith [hySq, Real.sqrt_nonneg z.im]
  have hscaled :
      5 * (1 + z.im) * pullbackHeight r z ≤
        (3 * (1 + Real.sqrt z.im)) ^ 2 * pullbackHeight r z :=
    mul_le_mul_of_nonneg_right hcoefficient hh.le
  rw [← one_div]
  apply (div_le_iff₀ hs).2
  have htargetNonneg :
      0 ≤ 3 * (1 + Real.sqrt z.im) *
        Real.sqrt (pullbackHeight r z) := by positivity
  apply (one_le_sq_iff₀ htargetNonneg).mp
  calc
    1 ≤ 5 * (1 + z.im) * pullbackHeight r z :=
      pullbackHeight_reciprocal_control_on_fd r hz
    _ ≤ (3 * (1 + Real.sqrt z.im)) ^ 2 *
        pullbackHeight r z := hscaled
    _ = (3 * (1 + Real.sqrt z.im) *
          Real.sqrt (pullbackHeight r z)) ^ 2 := by
      calc
        (3 * (1 + Real.sqrt z.im)) ^ 2 * pullbackHeight r z =
            (3 * (1 + Real.sqrt z.im)) ^ 2 *
              (Real.sqrt (pullbackHeight r z)) ^ 2 := by
          rw [Real.sq_sqrt hh.le]
        _ = _ := by ring

/-- The exact square-root expression occurring in the positive Petersson
density is controlled by one integrable height envelope on every cell. -/
theorem pullbackHeight_sqrt_envelope_on_fd
    (r : Gamma2Rep) {z : UpperHalfPlane} (hz : z ∈ ModularGroup.fd) :
    Real.sqrt (pullbackHeight r z) + 2 +
        (Real.sqrt (pullbackHeight r z))⁻¹ ≤
      7 * (1 + Real.sqrt z.im) := by
  have hu := sqrt_pullbackHeight_le_on_fd r hz
  have hi := inv_sqrt_pullbackHeight_le_on_fd r hz
  have hb : 0 ≤ Real.sqrt z.im := Real.sqrt_nonneg _
  nlinarith

/-- Pullback of Mathlib's standard compact truncation along one modular
homeomorphism. -/
def repTruncated (r : Gamma2Rep) (Y : ℝ) : Set UpperHalfPlane :=
  (fun τ => repMatrix r • τ) ⁻¹'
    ModularGroup.truncatedFundamentalDomain Y

@[simp]
theorem mem_repTruncated_iff (r : Gamma2Rep) (Y : ℝ)
    (τ : UpperHalfPlane) :
    τ ∈ repTruncated r Y ↔
      repMatrix r • τ ∈ ModularGroup.truncatedFundamentalDomain Y :=
  Iff.rfl

/-- Each pulled-back standard truncation is compact because the modular action
is a homeomorphism. -/
theorem isCompact_repTruncated (r : Gamma2Rep) (Y : ℝ) :
    IsCompact (repTruncated r Y) := by
  let g : GL (Fin 2) ℝ :=
    ((repMatrix r : IntegralSpecialLinear) : GL (Fin 2) ℝ)
  change IsCompact
    ((Homeomorph.smul g : UpperHalfPlane ≃ₜ UpperHalfPlane) ⁻¹'
      ModularGroup.truncatedFundamentalDomain Y)
  exact
    (Homeomorph.smul g : UpperHalfPlane ≃ₜ UpperHalfPlane).isCompact_preimage.mpr
      (ModularGroup.isCompact_truncatedFundamentalDomain Y)

/-- A finite compact carrier containing the desired simultaneous truncation. -/
def compactTruncationCarrier (Y : ℝ) : Set UpperHalfPlane :=
  ⋃ r : Gamma2Rep, repTruncated r Y

theorem isCompact_compactTruncationCarrier (Y : ℝ) :
    IsCompact (compactTruncationCarrier Y) := by
  rw [compactTruncationCarrier]
  exact isCompact_iUnion fun r => isCompact_repTruncated r Y

/-- Every point in the simultaneous three-cusp truncation lies in the compact
carrier associated with the cell that contains it. -/
theorem truncatedFundamentalDomain_closedPolygon_subset_compactCarrier
    (Y : ℝ) :
    truncatedFundamentalDomain closedPolygon Y ⊆
      compactTruncationCarrier Y := by
  intro τ hτ
  obtain ⟨r, hr⟩ := (mem_closedPolygon_iff τ).mp hτ.1
  rw [compactTruncationCarrier]
  refine Set.mem_iUnion.mpr ⟨r, ?_⟩
  apply (mem_repTruncated_iff r Y τ).mpr
  change repMatrix r • τ ∈ ModularGroup.fd ∧
    (repMatrix r • τ).im ≤ Y
  refine ⟨(mem_closedCell_iff r τ).mp hr, ?_⟩
  rw [repMatrix_im_eq_cuspHeight]
  exact hτ.2 (repCusp r)

/-- **Unconditional compactness leaf for corrected Definition 3.**  The
simultaneous truncation of the explicit six-cell `Γ(2)` polygon is compact for
every real height, with no positivity assumption on the height. -/
theorem isCompact_truncatedFundamentalDomain_closedPolygon (Y : ℝ) :
    IsCompact (truncatedFundamentalDomain closedPolygon Y) :=
  (isCompact_compactTruncationCarrier Y).of_isClosed_subset
    (isClosed_truncatedFundamentalDomain isClosed_closedPolygon Y)
    (truncatedFundamentalDomain_closedPolygon_subset_compactCarrier Y)

/-! #### A precise interface for piecewise-smooth boundaries

The definitions below deliberately separate the topological boundary-cover
theorem from the later analytic task of constructing regular smooth
parametrizations for every covering piece.  In particular, no smoothness
certificate is inferred merely from a set-theoretic boundary inclusion. -/

/-- A subset of the ambient complex plane carried by one regular smooth local
curve.  The parameter domain is open, the curve is `C∞` there, and its stored
derivative never vanishes on that domain. -/
def IsRegularSmoothCurvePiece (C : Set ℂ) : Prop :=
  ∃ (U : Set ℝ) (curve tangent : ℝ → ℂ),
    IsOpen U ∧
    ContDiffOn ℝ (↑(⊤ : ℕ∞)) curve U ∧
    (∀ t ∈ U,
      HasDerivWithinAt curve (tangent t) U t ∧ tangent t ≠ 0) ∧
    C ⊆ curve '' U

/-- Project-local meaning of a piecewise-smooth boundary: after embedding the
upper half-plane in `ℂ`, the topological frontier is covered by finitely many
regular smooth curve pieces.  The inclusion, rather than equality, is
intentional because a covering family may contain internal cell edges. -/
def HasPiecewiseSmoothBoundary (s : Set UpperHalfPlane) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (piece : ι → Set ℂ),
    (∀ i, IsRegularSmoothCurvePiece (piece i)) ∧
    UpperHalfPlane.coe '' frontier s ⊆ ⋃ i, piece i

/-! ##### The three regular boundary curves of the standard modular domain -/

/-- The circular part of the standard modular boundary, embedded in `ℂ`. -/
def modularArcBoundary : Set ℂ :=
  {z | 0 < z.im ∧ Complex.normSq z = 1 ∧ |z.re| ≤ (1 : ℝ) / 2}

/-- Both vertical parts of the standard modular boundary. -/
def modularVerticalBoundary : Set ℂ :=
  {z | 0 < z.im ∧ 1 ≤ Complex.normSq z ∧ |z.re| = (1 : ℝ) / 2}

/-- The left vertical boundary ray. -/
def modularLeftVerticalBoundary : Set ℂ :=
  {z | 0 < z.im ∧ 1 ≤ Complex.normSq z ∧ z.re = -(1 : ℝ) / 2}

/-- The right vertical boundary ray. -/
def modularRightVerticalBoundary : Set ℂ :=
  {z | 0 < z.im ∧ 1 ≤ Complex.normSq z ∧ z.re = (1 : ℝ) / 2}

/-- The absolute-value vertical boundary splits into its two signed rays. -/
theorem modularVerticalBoundary_eq_left_union_right :
    modularVerticalBoundary =
      modularLeftVerticalBoundary ∪ modularRightVerticalBoundary := by
  ext z
  constructor
  · rintro ⟨him, hnorm, habs⟩
    rcases le_total 0 z.re with hre | hre
    · right
      refine ⟨him, hnorm, ?_⟩
      simpa [abs_of_nonneg hre] using habs
    · left
      refine ⟨him, hnorm, ?_⟩
      have hneg : -z.re = (1 : ℝ) / 2 := by
        simpa [abs_of_nonpos hre] using habs
      linarith
  · rintro (⟨him, hnorm, hre⟩ | ⟨him, hnorm, hre⟩)
    · refine ⟨him, hnorm, ?_⟩
      rw [hre]
      norm_num
    · refine ⟨him, hnorm, ?_⟩
      rw [hre]
      norm_num

/-- Every frontier point of the standard closed modular domain lies either on
the unit arc or on one of the two vertical sides. -/
theorem coe_frontier_fd_subset_arc_union_vertical :
    UpperHalfPlane.coe '' frontier ModularGroup.fd ⊆
      modularArcBoundary ∪ modularVerticalBoundary := by
  rintro z ⟨τ, hτ, rfl⟩
  change τ ∈ closure ModularGroup.fd ∧
    τ ∉ interior ModularGroup.fd at hτ
  have hfd : τ ∈ ModularGroup.fd := by
    simpa [ModularGroup.isClosed_fd.closure_eq] using hτ.1
  have hnfdo : τ ∉ ModularGroup.fdo := by
    rw [ModularGroup.fdo_eq_interior_fd]
    exact hτ.2
  change 1 ≤ Complex.normSq (τ : ℂ) ∧
    |τ.re| ≤ (1 : ℝ) / 2 at hfd
  by_cases hnorm : Complex.normSq (τ : ℂ) = 1
  · left
    exact ⟨τ.im_pos, hnorm, hfd.2⟩
  · by_cases hre : |τ.re| = (1 : ℝ) / 2
    · right
      exact ⟨τ.im_pos, hfd.1, hre⟩
    · have hnorm' : 1 < Complex.normSq (τ : ℂ) :=
        lt_of_le_of_ne hfd.1 (Ne.symm hnorm)
      have hre' : |τ.re| < (1 : ℝ) / 2 :=
        lt_of_le_of_ne hfd.2 hre
      exact (hnfdo ⟨hnorm', hre'⟩).elim

section StandardComplexRealNormedSpace

attribute [-instance] instInnerProductSpaceRealComplex
attribute [instance 2000] NormedSpace.complexToReal

/-- Global affine parametrization of the left vertical line. -/
def modularLeftVerticalCurve (t : ℝ) : ℂ :=
  (-(1 : ℝ) / 2 : ℂ) + Complex.I * (t : ℂ)

/-- Global affine parametrization of the right vertical line. -/
def modularRightVerticalCurve (t : ℝ) : ℂ :=
  ((1 : ℝ) / 2 : ℂ) + Complex.I * (t : ℂ)

theorem hasDerivAt_modularLeftVerticalCurve (t : ℝ) :
    HasDerivAt modularLeftVerticalCurve Complex.I t := by
  unfold modularLeftVerticalCurve
  change HasDerivAt
    ((fun _ : ℝ => (-(1 : ℝ) / 2 : ℂ)) +
      fun y : ℝ => Complex.I * (y : ℂ)) Complex.I t
  simpa only [id_eq, zero_add, mul_one] using
    (hasDerivAt_const t (-(1 : ℝ) / 2 : ℂ)).add
      (((hasDerivAt_id (t : ℂ)).const_mul Complex.I).comp_ofReal)

theorem hasDerivAt_modularRightVerticalCurve (t : ℝ) :
    HasDerivAt modularRightVerticalCurve Complex.I t := by
  unfold modularRightVerticalCurve
  change HasDerivAt
    ((fun _ : ℝ => ((1 : ℝ) / 2 : ℂ)) +
      fun y : ℝ => Complex.I * (y : ℂ)) Complex.I t
  simpa only [id_eq, zero_add, mul_one] using
    (hasDerivAt_const t ((1 : ℝ) / 2 : ℂ)).add
      (((hasDerivAt_id (t : ℂ)).const_mul Complex.I).comp_ofReal)

theorem contDiff_modularLeftVerticalCurve :
    ContDiff ℝ (↑(⊤ : ℕ∞)) modularLeftVerticalCurve := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun x : ℝ => (-(1 : ℝ) / 2 : ℂ) + Complex.I * (x : ℂ))
  exact contDiff_const.add
    (contDiff_const.mul Complex.ofRealCLM.contDiff)

theorem contDiff_modularRightVerticalCurve :
    ContDiff ℝ (↑(⊤ : ℕ∞)) modularRightVerticalCurve := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun x : ℝ => ((1 : ℝ) / 2 : ℂ) + Complex.I * (x : ℂ))
  exact contDiff_const.add
    (contDiff_const.mul Complex.ofRealCLM.contDiff)

/-- The left vertical ray is carried by a globally regular affine line. -/
theorem isRegularSmoothCurvePiece_modularLeftVerticalBoundary :
    IsRegularSmoothCurvePiece modularLeftVerticalBoundary := by
  refine ⟨Set.univ, modularLeftVerticalCurve,
    (fun _ => Complex.I), isOpen_univ,
    contDiff_modularLeftVerticalCurve.contDiffOn, ?_, ?_⟩
  · intro t ht
    exact ⟨(hasDerivAt_modularLeftVerticalCurve t).hasDerivWithinAt,
      Complex.I_ne_zero⟩
  · rintro z ⟨him, hnorm, hre⟩
    refine ⟨z.im, Set.mem_univ _, ?_⟩
    apply Complex.ext
    · simp [modularLeftVerticalCurve, hre]
    · simp [modularLeftVerticalCurve]

/-- The right vertical ray is carried by a globally regular affine line. -/
theorem isRegularSmoothCurvePiece_modularRightVerticalBoundary :
    IsRegularSmoothCurvePiece modularRightVerticalBoundary := by
  refine ⟨Set.univ, modularRightVerticalCurve,
    (fun _ => Complex.I), isOpen_univ,
    contDiff_modularRightVerticalCurve.contDiffOn, ?_, ?_⟩
  · intro t ht
    exact ⟨(hasDerivAt_modularRightVerticalCurve t).hasDerivWithinAt,
      Complex.I_ne_zero⟩
  · rintro z ⟨him, hnorm, hre⟩
    refine ⟨z.im, Set.mem_univ _, ?_⟩
    apply Complex.ext
    · simp [modularRightVerticalCurve, hre]
    · simp [modularRightVerticalCurve]

/-- Global exponential parametrization of the complex unit circle. -/
def modularUnitCircleCurve (t : ℝ) : ℂ :=
  Complex.exp ((t : ℂ) * Complex.I)

/-- Its exact nonvanishing tangent. -/
def modularUnitCircleTangent (t : ℝ) : ℂ :=
  modularUnitCircleCurve t * Complex.I

theorem hasDerivAt_modularUnitCircleCurve (t : ℝ) :
    HasDerivAt modularUnitCircleCurve (modularUnitCircleTangent t) t := by
  change HasDerivAt
    (fun y : ℝ => Complex.exp ((y : ℂ) * Complex.I))
    (Complex.exp ((t : ℂ) * Complex.I) * Complex.I) t
  exact (((Complex.hasDerivAt_exp ((t : ℂ) * Complex.I)).comp
    (t : ℂ) (hasDerivAt_mul_const Complex.I)).comp_ofReal)

theorem modularUnitCircleTangent_ne_zero (t : ℝ) :
    modularUnitCircleTangent t ≠ 0 :=
  mul_ne_zero (Complex.exp_ne_zero _) Complex.I_ne_zero

theorem contDiff_modularUnitCircleCurve :
    ContDiff ℝ (↑(⊤ : ℕ∞)) modularUnitCircleCurve := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun t : ℝ => Complex.exp ((t : ℂ) * Complex.I))
  exact (Complex.ofRealCLM.contDiff.mul contDiff_const).cexp

@[simp]
theorem normSq_modularUnitCircleCurve (t : ℝ) :
    Complex.normSq (modularUnitCircleCurve t) = 1 := by
  rw [Complex.normSq_eq_norm_sq,
    show ‖modularUnitCircleCurve t‖ = 1 by
      exact Complex.norm_exp_ofReal_mul_I t]
  norm_num

/-- Every complex point of norm-square one occurs on the exponential circle
curve.  The proof uses the polar decomposition at the point's actual argument. -/
theorem mem_range_modularUnitCircleCurve_of_normSq_eq_one
    {z : ℂ} (hz : Complex.normSq z = 1) :
    z ∈ Set.range modularUnitCircleCurve := by
  have hnorm : ‖z‖ = 1 := by
    rw [Complex.normSq_eq_norm_sq] at hz
    nlinarith [norm_nonneg z]
  refine ⟨Complex.arg z, ?_⟩
  unfold modularUnitCircleCurve
  calc
    Complex.exp ((Complex.arg z : ℂ) * Complex.I) =
        (‖z‖ : ℂ) * Complex.exp (Complex.arg z * Complex.I) := by
      rw [hnorm]
      simp
    _ = z := Complex.norm_mul_exp_arg_mul_I z

/-- In particular the circular modular boundary is a regular smooth curve
piece, covered by the globally parametrized unit circle. -/
theorem isRegularSmoothCurvePiece_modularArcBoundary :
    IsRegularSmoothCurvePiece modularArcBoundary := by
  refine ⟨Set.univ, modularUnitCircleCurve, modularUnitCircleTangent,
    isOpen_univ, contDiff_modularUnitCircleCurve.contDiffOn, ?_, ?_⟩
  · intro t ht
    exact ⟨(hasDerivAt_modularUnitCircleCurve t).hasDerivWithinAt,
      modularUnitCircleTangent_ne_zero t⟩
  · intro z hz
    obtain ⟨t, ht⟩ :=
      mem_range_modularUnitCircleCurve_of_normSq_eq_one hz.2.1
    exact ⟨t, Set.mem_univ _, ht⟩

/-- Labels for the finite regular-curve cover of the standard modular frontier. -/
inductive ModularBoundaryPiece
  | arc
  | left
  | right
  deriving DecidableEq, Repr

instance : Fintype ModularBoundaryPiece where
  elems := {.arc, .left, .right}
  complete := by
    intro x
    cases x <;> simp

def modularBoundaryPieceSet : ModularBoundaryPiece → Set ℂ
  | .arc => modularArcBoundary
  | .left => modularLeftVerticalBoundary
  | .right => modularRightVerticalBoundary

theorem modularBoundaryPieceSet_regular (i : ModularBoundaryPiece) :
    IsRegularSmoothCurvePiece (modularBoundaryPieceSet i) := by
  cases i with
  | arc => exact isRegularSmoothCurvePiece_modularArcBoundary
  | left => exact isRegularSmoothCurvePiece_modularLeftVerticalBoundary
  | right => exact isRegularSmoothCurvePiece_modularRightVerticalBoundary

/-- The standard modular closed domain has an unconditional finite regular
smooth curve cover of its entire topological frontier. -/
theorem hasPiecewiseSmoothBoundary_fd :
    HasPiecewiseSmoothBoundary ModularGroup.fd := by
  refine ⟨ModularBoundaryPiece, inferInstance, modularBoundaryPieceSet,
    modularBoundaryPieceSet_regular, ?_⟩
  intro z hz
  have hcover := coe_frontier_fd_subset_arc_union_vertical hz
  rw [modularVerticalBoundary_eq_left_union_right] at hcover
  rcases hcover with hArc | hLeft | hRight
  · exact Set.mem_iUnion.mpr ⟨.arc, hArc⟩
  · exact Set.mem_iUnion.mpr ⟨.left, hLeft⟩
  · exact Set.mem_iUnion.mpr ⟨.right, hRight⟩

/-! ##### Regular boundary pieces under an integral modular action

The partial inverse `UpperHalfPlane.ofComplex` is deliberately used only on
the part of a parametrized curve having positive imaginary part.  This is why
`trimmedCurveDomain` occurs in the construction below.  Without that trim the
arbitrary value of `ofComplex` outside the upper half-plane would invalidate
both the smoothness and image arguments. -/

/-- The real general-linear matrix through which Mathlib implements the action
of an integral determinant-one matrix on the upper half-plane. -/
noncomputable def realGL (g : IntegralSpecialLinear) : GL (Fin 2) ℝ :=
  Matrix.SpecialLinearGroup.mapGL ℝ g

@[simp]
theorem realGL_det (g : IntegralSpecialLinear) :
    (realGL g).det.val = 1 := by
  simp [realGL]

theorem realGL_det_pos (g : IntegralSpecialLinear) :
    0 < (realGL g).det.val := by
  simp [realGL]

@[simp]
theorem realGL_smul (g : IntegralSpecialLinear) (τ : UpperHalfPlane) :
    realGL g • τ = g • τ :=
  rfl

/-- Restrict a real parameter domain to the points at which the ambient
complex curve actually lies in the upper half-plane. -/
def trimmedCurveDomain (U : Set ℝ) (curve : ℝ → ℂ) : Set ℝ :=
  U ∩ curve ⁻¹' UpperHalfPlane.upperHalfPlaneSet

theorem mem_trimmedCurveDomain_iff
    {U : Set ℝ} {curve : ℝ → ℂ} {t : ℝ} :
    t ∈ trimmedCurveDomain U curve ↔
      t ∈ U ∧ 0 < (curve t).im :=
  Iff.rfl

/-- Relative smoothness on an open parameter set is enough to prove that the
upper-half-plane trim is itself open. -/
theorem isOpen_trimmedCurveDomain
    {U : Set ℝ} {curve : ℝ → ℂ}
    (hU : IsOpen U)
    (hcurve : ContDiffOn ℝ (↑(⊤ : ℕ∞)) curve U) :
    IsOpen (trimmedCurveDomain U curve) := by
  rw [isOpen_iff_mem_nhds]
  rintro t ⟨htU, htH⟩
  have hcontinuous : ContinuousAt curve t :=
    ((hcurve t htU).contDiffAt (hU.mem_nhds htU)).continuousAt
  exact Filter.inter_mem (hU.mem_nhds htU)
    (hcontinuous
      (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds htH))

/-- Ambient complex value of the integral modular action.  Its use in all
subsequent curve theorems is guarded by `trimmedCurveDomain`. -/
noncomputable def ambientModularAction
    (g : IntegralSpecialLinear) (z : ℂ) : ℂ :=
  ((realGL g • UpperHalfPlane.ofComplex z : UpperHalfPlane) : ℂ)

/-- Image of the upper-half-plane part of an ambient complex set under an
integral modular transformation. -/
noncomputable def modularImage
    (g : IntegralSpecialLinear) (C : Set ℂ) : Set ℂ :=
  (fun τ : UpperHalfPlane =>
    ((realGL g • τ : UpperHalfPlane) : ℂ)) ''
      (UpperHalfPlane.coe ⁻¹' C)

/-- Transformed ambient curve on the trimmed parameter domain. -/
noncomputable def modularCurve
    (g : IntegralSpecialLinear) (curve : ℝ → ℂ) : ℝ → ℂ :=
  ambientModularAction g ∘ curve

/-- The exact real tangent obtained from Mathlib's Fréchet derivative of the
Möbius action. -/
noncomputable def modularCurveTangent
    (g : IntegralSpecialLinear) (curve tangent : ℝ → ℂ) (t : ℝ) : ℂ :=
  UpperHalfPlane.smulFDeriv (realGL g) (curve t) (tangent t)

/-- The transformed curve is smooth on the correctly trimmed domain. -/
theorem contDiffOn_modularCurve_trimmed
    (g : IntegralSpecialLinear)
    {U : Set ℝ} {curve : ℝ → ℂ}
    (hcurve : ContDiffOn ℝ (↑(⊤ : ℕ∞)) curve U) :
    ContDiffOn ℝ (↑(⊤ : ℕ∞)) (modularCurve g curve)
      (trimmedCurveDomain U curve) := by
  intro t ht
  have houter :
      ContDiffAt ℝ (↑(⊤ : ℕ∞)) (ambientModularAction g) (curve t) := by
    change ContDiffAt ℝ (↑(⊤ : ℕ∞))
      (fun z : ℂ =>
        ((realGL g • UpperHalfPlane.ofComplex z : UpperHalfPlane) : ℂ))
      (curve t)
    simpa [UpperHalfPlane.ofComplex_apply_of_im_pos ht.2] using
      ((UpperHalfPlane.analyticAt_smul
          (g := realGL g) (realGL_det_pos g)
          (UpperHalfPlane.ofComplex (curve t))).contDiffAt.restrict_scalars ℝ)
  simpa [trimmedCurveDomain, modularCurve, Function.comp_def] using
    houter.comp_contDiffWithinAt t
      ((hcurve t ht.1).mono Set.inter_subset_left)

/-- Exact chain rule for a transformed regular curve. -/
theorem hasDerivWithinAt_modularCurve
    (g : IntegralSpecialLinear)
    {U : Set ℝ} {curve tangent : ℝ → ℂ} {t : ℝ}
    (ht : t ∈ trimmedCurveDomain U curve)
    (hderiv : HasDerivWithinAt curve (tangent t) U t) :
    HasDerivWithinAt (modularCurve g curve)
      (modularCurveTangent g curve tangent t)
      (trimmedCurveDomain U curve) t := by
  have houter :
      HasFDerivAt (ambientModularAction g)
        (UpperHalfPlane.smulFDeriv (realGL g) (curve t))
        (curve t) := by
    change HasFDerivAt
      (fun z : ℂ =>
        ((realGL g • UpperHalfPlane.ofComplex z : UpperHalfPlane) : ℂ))
      (UpperHalfPlane.smulFDeriv (realGL g) (curve t))
      (curve t)
    simpa [UpperHalfPlane.ofComplex_apply_of_im_pos ht.2] using
      ((UpperHalfPlane.hasStrictFDerivAt_smul
          (realGL g) (UpperHalfPlane.ofComplex (curve t))).hasFDerivAt)
  simpa [trimmedCurveDomain, modularCurve, modularCurveTangent,
      Function.comp_def] using
    houter.comp_hasDerivWithinAt t
      (hderiv.mono Set.inter_subset_left)

/-- The Möbius derivative has no kernel at an upper-half-plane point, hence it
does not annihilate a nonzero curve tangent. -/
theorem modularCurveTangent_ne_zero
    (g : IntegralSpecialLinear)
    {curve tangent : ℝ → ℂ} {t : ℝ}
    (htH : 0 < (curve t).im) (htangent : tangent t ≠ 0) :
    modularCurveTangent g curve tangent t ≠ 0 := by
  have hdenom :
      UpperHalfPlane.denom (realGL g) (curve t) ≠ 0 := by
    simpa [UpperHalfPlane.ofComplex_apply_of_im_pos htH] using
      (UpperHalfPlane.denom_ne_zero (realGL g)
        (UpperHalfPlane.ofComplex (curve t)))
  have hdet : ((realGL g).det.val : ℂ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (realGL_det_pos g))
  have hfactor :
      (realGL g).det.val /
          UpperHalfPlane.denom (realGL g) (curve t) ^ 2 ≠ 0 :=
    div_ne_zero hdet (pow_ne_zero 2 hdenom)
  simpa [modularCurveTangent, UpperHalfPlane.smulFDeriv,
    UpperHalfPlane.σ, realGL_det_pos g, smul_eq_mul] using
      (mul_ne_zero htangent hfactor)

/-- Regular smooth curve pieces remain regular after every integral modular
transformation.  The proof constructs, rather than assumes, the transformed
parameter domain, curve, tangent, and nonvanishing certificate. -/
theorem IsRegularSmoothCurvePiece.modularImage
    {C : Set ℂ} (hC : IsRegularSmoothCurvePiece C)
    (g : IntegralSpecialLinear) :
    IsRegularSmoothCurvePiece (modularImage g C) := by
  rcases hC with
    ⟨U, curve, tangent, hU, hcurve, hderiv, hcover⟩
  refine ⟨trimmedCurveDomain U curve,
    modularCurve g curve, modularCurveTangent g curve tangent,
    isOpen_trimmedCurveDomain hU hcurve,
    contDiffOn_modularCurve_trimmed g hcurve, ?_, ?_⟩
  · intro t ht
    refine ⟨hasDerivWithinAt_modularCurve g ht (hderiv t ht.1).1,
      modularCurveTangent_ne_zero g ht.2 (hderiv t ht.1).2⟩
  · rintro z ⟨τ, hτC, rfl⟩
    obtain ⟨t, htU, hcurveτ⟩ := hcover hτC
    have htH : 0 < (curve t).im := by
      rw [hcurveτ]
      exact τ.im_pos
    refine ⟨t, ⟨htU, htH⟩, ?_⟩
    simp [modularCurve, ambientModularAction, Function.comp_def,
      hcurveτ, UpperHalfPlane.ofComplex_apply]

/-- Pulling back a piecewise-smooth boundary by an integral modular action
preserves piecewise smoothness.  Every output piece is the explicit inverse
modular image of one input piece. -/
theorem HasPiecewiseSmoothBoundary.preimage_integral_smul
    {s : Set UpperHalfPlane} (hs : HasPiecewiseSmoothBoundary s)
    (g : IntegralSpecialLinear) :
    HasPiecewiseSmoothBoundary
      ((fun τ : UpperHalfPlane => g • τ) ⁻¹' s) := by
  rcases hs with ⟨ι, hι, piece, hregular, hcover⟩
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, fun i => modularImage g⁻¹ (piece i),
    fun i => (hregular i).modularImage g⁻¹, ?_⟩
  rintro z ⟨τ, hτfrontier, rfl⟩
  have hbase : g • τ ∈ frontier s := by
    let gR : GL (Fin 2) ℝ := realGL g
    have hpre :
        τ ∈ (fun w : UpperHalfPlane => gR • w) ⁻¹' frontier s := by
      change τ ∈ ⇑(Homeomorph.smul gR) ⁻¹' frontier s
      rw [(Homeomorph.smul gR).preimage_frontier s]
      change τ ∈ frontier ((fun w : UpperHalfPlane => gR • w) ⁻¹' s)
      simpa [gR, realGL_smul] using hτfrontier
    simpa [gR, realGL_smul] using hpre
  have hcovered :
      ((g • τ : UpperHalfPlane) : ℂ) ∈ ⋃ i, piece i :=
    hcover ⟨g • τ, hbase, rfl⟩
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hcovered
  apply Set.mem_iUnion.mpr
  refine ⟨i, ⟨g • τ, hi, ?_⟩⟩
  simp [realGL_smul]

/-- The three explicit transformed standard pieces covering one closed cell. -/
noncomputable def closedCellBoundaryPiece
    (r : Gamma2Rep) (i : ModularBoundaryPiece) : Set ℂ :=
  modularImage (repMatrix r)⁻¹ (modularBoundaryPieceSet i)

theorem closedCellBoundaryPiece_regular
    (r : Gamma2Rep) (i : ModularBoundaryPiece) :
    IsRegularSmoothCurvePiece (closedCellBoundaryPiece r i) :=
  (modularBoundaryPieceSet_regular i).modularImage (repMatrix r)⁻¹

/-- Every one of the six closed cells has a finite regular smooth cover of its
entire frontier, with the covering pieces displayed above. -/
theorem hasPiecewiseSmoothBoundary_closedCell (r : Gamma2Rep) :
    HasPiecewiseSmoothBoundary (closedCell r) := by
  simpa only [closedCell] using
    hasPiecewiseSmoothBoundary_fd.preimage_integral_smul (repMatrix r)

/-- The same closed-cell theorem with its three covering pieces exposed as a
set-theoretic inclusion, for later finite-union bookkeeping. -/
theorem coe_frontier_closedCell_subset_boundaryPieces
    (r : Gamma2Rep) :
    UpperHalfPlane.coe '' frontier (closedCell r) ⊆
      ⋃ i : ModularBoundaryPiece, closedCellBoundaryPiece r i := by
  rintro z ⟨τ, hτfrontier, rfl⟩
  have hbase : repMatrix r • τ ∈ frontier ModularGroup.fd := by
    let gR : GL (Fin 2) ℝ := realGL (repMatrix r)
    have hpre :
        τ ∈ (fun w : UpperHalfPlane => gR • w) ⁻¹'
          frontier ModularGroup.fd := by
      change τ ∈ ⇑(Homeomorph.smul gR) ⁻¹' frontier ModularGroup.fd
      rw [(Homeomorph.smul gR).preimage_frontier ModularGroup.fd]
      change τ ∈ frontier
        ((fun w : UpperHalfPlane => gR • w) ⁻¹' ModularGroup.fd)
      have hclosed :
          τ ∈ frontier
            ((fun w : UpperHalfPlane => repMatrix r • w) ⁻¹'
              ModularGroup.fd) := by
        simpa [closedCell] using hτfrontier
      simpa [gR, realGL_smul] using hclosed
    simpa [gR, realGL_smul] using hpre
  have hstandard := coe_frontier_fd_subset_arc_union_vertical
    ⟨repMatrix r • τ, hbase, rfl⟩
  rw [modularVerticalBoundary_eq_left_union_right] at hstandard
  rcases hstandard with hArc | hLeft | hRight
  · apply Set.mem_iUnion.mpr
    refine ⟨.arc, ⟨repMatrix r • τ, hArc, ?_⟩⟩
    simp [closedCellBoundaryPiece, modularImage, realGL_smul]
  · apply Set.mem_iUnion.mpr
    refine ⟨.left, ⟨repMatrix r • τ, hLeft, ?_⟩⟩
    simp [closedCellBoundaryPiece, modularImage, realGL_smul]
  · apply Set.mem_iUnion.mpr
    refine ⟨.right, ⟨repMatrix r • τ, hRight, ?_⟩⟩
    simp [closedCellBoundaryPiece, modularImage, realGL_smul]

/-! ##### General finite-frontier lemmas

Mathlib's sharp binary frontier bounds retain closure factors.  The weaker
corollaries below are exactly what a finite boundary cover needs. -/

section FrontierHelpers

variable {X ι : Type*} [TopologicalSpace X]

/-- The frontier of a binary union is contained in the union of frontiers.
Equality is false in general because a common internal edge can disappear. -/
theorem frontier_union_subset_union_frontier (s t : Set X) :
    frontier (s ∪ t) ⊆ frontier s ∪ frontier t := by
  intro x hx
  rcases frontier_union_subset s t hx with hx | hx
  · exact Or.inl hx.1
  · exact Or.inr hx.2

/-- The analogous boundary-cover inclusion for a binary intersection. -/
theorem frontier_inter_subset_union_frontier (s t : Set X) :
    frontier (s ∩ t) ⊆ frontier s ∪ frontier t := by
  intro x hx
  rcases frontier_inter_subset s t hx with hx | hx
  · exact Or.inl hx.1
  · exact Or.inr hx.2

/-- A finite indexed union has frontier covered by the union of the individual
frontiers. -/
theorem frontier_finset_iUnion_subset_iUnion_frontier
    (A : Finset ι) (f : ι → Set X) :
    frontier (⋃ i ∈ A, f i) ⊆ ⋃ i ∈ A, frontier (f i) := by
  classical
  induction A using Finset.induction_on with
  | empty => simp
  | @insert a A ha ih =>
      simp only [Finset.set_biUnion_insert]
      exact (frontier_union_subset_union_frontier
        (f a) (⋃ i ∈ A, f i)).trans
          (Set.union_subset_union Subset.rfl ih)

/-- A finite indexed intersection has frontier covered by the union of the
individual frontiers. -/
theorem frontier_finset_iInter_subset_iUnion_frontier
    (A : Finset ι) (f : ι → Set X) :
    frontier (⋂ i ∈ A, f i) ⊆ ⋃ i ∈ A, frontier (f i) := by
  classical
  induction A using Finset.induction_on with
  | empty => simp
  | @insert a A ha ih =>
      simp only [Finset.set_biInter_insert, Finset.set_biUnion_insert]
      exact (frontier_inter_subset_union_frontier
        (f a) (⋂ i ∈ A, f i)).trans
          (Set.union_subset_union Subset.rfl ih)

/-- Fintype form of the finite-union frontier cover. -/
theorem frontier_iUnion_subset_iUnion_frontier
    [Fintype ι] (f : ι → Set X) :
    frontier (⋃ i, f i) ⊆ ⋃ i, frontier (f i) := by
  simpa using
    (frontier_finset_iUnion_subset_iUnion_frontier
      (X := X) (Finset.univ : Finset ι) f)

/-- Fintype form of the finite-intersection frontier cover. -/
theorem frontier_iInter_subset_iUnion_frontier
    [Fintype ι] (f : ι → Set X) :
    frontier (⋂ i, f i) ⊆ ⋃ i, frontier (f i) := by
  simpa using
    (frontier_finset_iInter_subset_iUnion_frontier
      (X := X) (Finset.univ : Finset ι) f)

end FrontierHelpers

/-! ##### Boundary cover for the explicit truncated polygon -/

/-- Closed height sublevel at one selected cusp. -/
def cuspHeightSublevel (κ : Gamma2Cusp) (Y : ℝ) :
    Set UpperHalfPlane :=
  {τ | cuspHeight κ τ ≤ Y}

/-- Height level containing the frontier of the corresponding sublevel. -/
def cuspHeightLevel (κ : Gamma2Cusp) (Y : ℝ) :
    Set UpperHalfPlane :=
  {τ | cuspHeight κ τ = Y}

/-! ##### Exact parametrization of every cusp-height level -/

/-- The horizontal line of positive height `Y`, represented inside the upper
half-plane and parametrized by its real coordinate. -/
def horizontalUHP (Y : ℝ) (hY : 0 < Y) (x : ℝ) : UpperHalfPlane :=
  ⟨(x : ℂ) + (Y : ℂ) * Complex.I, by simpa using hY⟩

@[simp]
theorem coe_horizontalUHP (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    ((horizontalUHP Y hY x : UpperHalfPlane) : ℂ) =
      (x : ℂ) + (Y : ℂ) * Complex.I :=
  rfl

@[simp]
theorem horizontalUHP_re (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    (horizontalUHP Y hY x).re = x := by
  simp [horizontalUHP]

@[simp]
theorem horizontalUHP_im (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    (horizontalUHP Y hY x).im = Y := by
  simp [horizontalUHP]

/-- The height-`Y` curve at cusp `κ` is the image of the horizontal height
line under the selected cusp scaling matrix. -/
def cuspLevelCurve (κ : Gamma2Cusp) (Y : ℝ) (hY : 0 < Y)
    (x : ℝ) : UpperHalfPlane :=
  Gamma2Cusp.scalingMatrix κ • horizontalUHP Y hY x

/-- Every point of the parametrized curve has cusp height exactly `Y`. -/
@[simp]
theorem cuspHeight_cuspLevelCurve (κ : Gamma2Cusp) (Y : ℝ)
    (hY : 0 < Y) (x : ℝ) :
    cuspHeight κ (cuspLevelCurve κ Y hY x) = Y := by
  simp [cuspLevelCurve, cuspHeight]

/-- Conversely, every point on a positive cusp-height level is obtained from
the real part of its inverse-scaled coordinate. -/
theorem exists_cuspLevelCurve_eq_of_mem
    (κ : Gamma2Cusp) (Y : ℝ) (hY : 0 < Y)
    {τ : UpperHalfPlane} (hτ : τ ∈ cuspHeightLevel κ Y) :
    ∃ x : ℝ, cuspLevelCurve κ Y hY x = τ := by
  change cuspHeight κ τ = Y at hτ
  refine ⟨((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ).re, ?_⟩
  change Gamma2Cusp.scalingMatrix κ •
    horizontalUHP Y hY
      (((Gamma2Cusp.scalingMatrix κ)⁻¹ • τ).re) = τ
  rw [← eq_inv_smul_iff]
  apply UpperHalfPlane.coe_injective
  apply Complex.ext
  · simp
  · simpa [cuspHeight] using hτ.symm

/-- Exact range description of a positive cusp-height curve. -/
theorem range_cuspLevelCurve (κ : Gamma2Cusp) (Y : ℝ)
    (hY : 0 < Y) :
    Set.range (cuspLevelCurve κ Y hY) = cuspHeightLevel κ Y := by
  ext τ
  constructor
  · rintro ⟨x, rfl⟩
    change cuspHeight κ (cuspLevelCurve κ Y hY x) = Y
    exact cuspHeight_cuspLevelCurve κ Y hY x
  · intro hτ
    obtain ⟨x, hx⟩ := exists_cuspLevelCurve_eq_of_mem κ Y hY hτ
    exact ⟨x, hx⟩

/-- A nonpositive value cannot be a cusp height. -/
theorem cuspHeightLevel_eq_empty_of_nonpos
    (κ : Gamma2Cusp) {Y : ℝ} (hY : Y ≤ 0) :
    cuspHeightLevel κ Y = ∅ := by
  ext τ
  simp only [Set.mem_empty_iff_false, iff_false]
  intro hτ
  change cuspHeight κ τ = Y at hτ
  exact (not_lt_of_ge hY) (hτ ▸ cuspHeight_pos κ τ)

/-! ##### Regular smooth parametrizations of all cusp-height levels -/

/-- The ambient complex horizontal line underlying `horizontalUHP`. -/
def cuspHorizontalAmbientCurve (Y x : ℝ) : ℂ :=
  (x : ℂ) + (Y : ℂ) * Complex.I

/-- The ambient curve obtained from the horizontal line by the modular
inversion `S`.  The action formula naturally produces `(-w)⁻¹`; this equals
`-w⁻¹`, as recorded below. -/
def cuspZeroAmbientCurve (Y x : ℝ) : ℂ :=
  (-cuspHorizontalAmbientCurve Y x)⁻¹

/-- The ambient curve obtained by applying `T * S`: first inversion, then
translation by one. -/
def cuspOneAmbientCurve (Y x : ℝ) : ℂ :=
  1 + (-cuspHorizontalAmbientCurve Y x)⁻¹

/-- The common tangent of the two finite-cusp curves. -/
def cuspFiniteAmbientTangent (Y x : ℝ) : ℂ :=
  1 / cuspHorizontalAmbientCurve Y x ^ 2

@[simp]
theorem cuspZeroAmbientCurve_eq_neg_inv (Y x : ℝ) :
    cuspZeroAmbientCurve Y x =
      -(cuspHorizontalAmbientCurve Y x)⁻¹ := by
  simp [cuspZeroAmbientCurve]

@[simp]
theorem cuspOneAmbientCurve_eq_one_sub_inv (Y x : ℝ) :
    cuspOneAmbientCurve Y x =
      1 - (cuspHorizontalAmbientCurve Y x)⁻¹ := by
  simp [cuspOneAmbientCurve, sub_eq_add_neg]

/-- Positive imaginary part is the only input needed to rule out the pole of
the two finite-cusp parametrizations. -/
theorem cuspHorizontalAmbientCurve_ne_zero {Y : ℝ} (hY : 0 < Y)
    (x : ℝ) : cuspHorizontalAmbientCurve Y x ≠ 0 := by
  intro hzero
  have him := congrArg Complex.im hzero
  have : Y = 0 := by
    simpa [cuspHorizontalAmbientCurve] using him
  exact (ne_of_gt hY) this

theorem hasDerivAt_cuspHorizontalAmbientCurve (Y x : ℝ) :
    HasDerivAt (cuspHorizontalAmbientCurve Y) 1 x := by
  have hreal : HasDerivAt (⇑Complex.ofRealCLM) 1 x :=
    (Complex.ofRealCLM.hasFDerivAt (x := x)).hasDerivAt
  have hfun : (⇑Complex.ofRealCLM : ℝ → ℂ) =
      (fun t : ℝ => (t : ℂ)) := by
    funext t
    rfl
  rw [hfun] at hreal
  change HasDerivAt
    (fun t : ℝ => (t : ℂ) + (Y : ℂ) * Complex.I) 1 x
  exact hreal.add_const ((Y : ℂ) * Complex.I)

theorem contDiff_cuspHorizontalAmbientCurve (Y : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cuspHorizontalAmbientCurve Y) := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun x : ℝ => (x : ℂ) + (Y : ℂ) * Complex.I)
  simpa [Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.add contDiff_const

/-- Exact tangent formula for the cusp at zero. -/
theorem hasDerivAt_cuspZeroAmbientCurve {Y : ℝ} (hY : 0 < Y)
    (x : ℝ) :
    HasDerivAt (cuspZeroAmbientCurve Y)
      (cuspFiniteAmbientTangent Y x) x := by
  have haff :
      HasDerivAt
        (fun z : ℂ => -(z + (Y : ℂ) * Complex.I))
        (-1) (x : ℂ) :=
    (((hasDerivAt_id (x : ℂ)).add_const
      ((Y : ℂ) * Complex.I)).neg)
  have hne : -((x : ℂ) + (Y : ℂ) * Complex.I) ≠ 0 := by
    exact neg_ne_zero.mpr (cuspHorizontalAmbientCurve_ne_zero hY x)
  convert (haff.inv hne).comp_ofReal using 1
  · funext y
    unfold cuspZeroAmbientCurve cuspHorizontalAmbientCurve
    congr 1
  · unfold cuspFiniteAmbientTangent cuspHorizontalAmbientCurve
    ring_nf

/-- Exact tangent formula for the cusp at one. -/
theorem hasDerivAt_cuspOneAmbientCurve {Y : ℝ} (hY : 0 < Y)
    (x : ℝ) :
    HasDerivAt (cuspOneAmbientCurve Y)
      (cuspFiniteAmbientTangent Y x) x := by
  change HasDerivAt
    ((fun _ : ℝ => (1 : ℂ)) + cuspZeroAmbientCurve Y)
      (cuspFiniteAmbientTangent Y x) x
  simpa only [zero_add] using
    (hasDerivAt_const x (1 : ℂ)).add
      (hasDerivAt_cuspZeroAmbientCurve hY x)

theorem contDiff_cuspZeroAmbientCurve {Y : ℝ} (hY : 0 < Y) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cuspZeroAmbientCurve Y) := by
  have hneg : ContDiff ℝ (↑(⊤ : ℕ∞))
      (fun x : ℝ => -cuspHorizontalAmbientCurve Y x) :=
    (contDiff_cuspHorizontalAmbientCurve Y).neg
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun x : ℝ => (-cuspHorizontalAmbientCurve Y x)⁻¹)
  exact hneg.inv (fun x => neg_ne_zero.mpr
    (cuspHorizontalAmbientCurve_ne_zero hY x))

theorem contDiff_cuspOneAmbientCurve {Y : ℝ} (hY : 0 < Y) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cuspOneAmbientCurve Y) := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    ((fun _ : ℝ => (1 : ℂ)) + cuspZeroAmbientCurve Y)
  exact contDiff_const.add (contDiff_cuspZeroAmbientCurve hY)

theorem cuspFiniteAmbientTangent_ne_zero {Y : ℝ} (hY : 0 < Y)
    (x : ℝ) : cuspFiniteAmbientTangent Y x ≠ 0 := by
  exact div_ne_zero one_ne_zero
    (pow_ne_zero 2 (cuspHorizontalAmbientCurve_ne_zero hY x))

/-- Coercing the upper-half-plane horizontal line gives its ambient curve. -/
@[simp]
theorem coe_horizontalUHP_eq_cuspHorizontalAmbientCurve
    (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    ((horizontalUHP Y hY x : UpperHalfPlane) : ℂ) =
      cuspHorizontalAmbientCurve Y x := by
  rfl

/-- At infinity the selected scaling matrix is the identity. -/
@[simp]
theorem coe_cuspLevelCurve_infinity (Y : ℝ) (hY : 0 < Y)
    (x : ℝ) :
    ((cuspLevelCurve .infinity Y hY x : UpperHalfPlane) : ℂ) =
      cuspHorizontalAmbientCurve Y x := by
  simp [cuspLevelCurve, Gamma2Cusp.scalingMatrix,
    cuspHorizontalAmbientCurve]

/-- At zero the selected scaling matrix acts by `w ↦ -w⁻¹`. -/
theorem coe_cuspLevelCurve_zero (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    ((cuspLevelCurve .zero Y hY x : UpperHalfPlane) : ℂ) =
      cuspZeroAmbientCurve Y x := by
  rw [cuspLevelCurve, Gamma2Cusp.scalingMatrix,
    UpperHalfPlane.modular_S_smul]
  simp [cuspZeroAmbientCurve, cuspHorizontalAmbientCurve]

/-- At one the selected scaling matrix acts by `w ↦ 1 - w⁻¹`. -/
theorem coe_cuspLevelCurve_one (Y : ℝ) (hY : 0 < Y) (x : ℝ) :
    ((cuspLevelCurve .one Y hY x : UpperHalfPlane) : ℂ) =
      cuspOneAmbientCurve Y x := by
  rw [cuspLevelCurve, Gamma2Cusp.scalingMatrix, mul_smul,
    UpperHalfPlane.modular_T_smul, UpperHalfPlane.modular_S_smul]
  simp [cuspOneAmbientCurve, cuspHorizontalAmbientCurve]

/-- The empty set is a regular curve piece: any fixed regular affine line
serves as a vacuous carrier. -/
theorem isRegularSmoothCurvePiece_empty :
    IsRegularSmoothCurvePiece (∅ : Set ℂ) := by
  refine ⟨Set.univ, modularRightVerticalCurve, (fun _ => Complex.I),
    isOpen_univ, contDiff_modularRightVerticalCurve.contDiffOn, ?_,
    Set.empty_subset _⟩
  intro t ht
  exact ⟨(hasDerivAt_modularRightVerticalCurve t).hasDerivWithinAt,
    Complex.I_ne_zero⟩

/-- Every positive cusp-height level, after coercion to `ℂ`, is carried by a
globally regular smooth curve. -/
theorem isRegularSmoothCurvePiece_coe_cuspHeightLevel_of_pos
    (κ : Gamma2Cusp) {Y : ℝ} (hY : 0 < Y) :
    IsRegularSmoothCurvePiece
      (UpperHalfPlane.coe '' cuspHeightLevel κ Y) := by
  cases κ with
  | infinity =>
      refine ⟨Set.univ, cuspHorizontalAmbientCurve Y, (fun _ => (1 : ℂ)),
        isOpen_univ, (contDiff_cuspHorizontalAmbientCurve Y).contDiffOn,
        ?_, ?_⟩
      · intro x hx
        exact ⟨(hasDerivAt_cuspHorizontalAmbientCurve Y x).hasDerivWithinAt,
          one_ne_zero⟩
      · rintro z ⟨τ, hτ, rfl⟩
        obtain ⟨x, hx⟩ :=
          exists_cuspLevelCurve_eq_of_mem .infinity Y hY hτ
        refine ⟨x, Set.mem_univ _, ?_⟩
        rw [← hx]
        exact (coe_cuspLevelCurve_infinity Y hY x).symm
  | zero =>
      refine ⟨Set.univ, cuspZeroAmbientCurve Y,
        cuspFiniteAmbientTangent Y, isOpen_univ,
        (contDiff_cuspZeroAmbientCurve hY).contDiffOn, ?_, ?_⟩
      · intro x hx
        exact ⟨(hasDerivAt_cuspZeroAmbientCurve hY x).hasDerivWithinAt,
          cuspFiniteAmbientTangent_ne_zero hY x⟩
      · rintro z ⟨τ, hτ, rfl⟩
        obtain ⟨x, hx⟩ :=
          exists_cuspLevelCurve_eq_of_mem .zero Y hY hτ
        refine ⟨x, Set.mem_univ _, ?_⟩
        rw [← hx]
        exact (coe_cuspLevelCurve_zero Y hY x).symm
  | one =>
      refine ⟨Set.univ, cuspOneAmbientCurve Y,
        cuspFiniteAmbientTangent Y, isOpen_univ,
        (contDiff_cuspOneAmbientCurve hY).contDiffOn, ?_, ?_⟩
      · intro x hx
        exact ⟨(hasDerivAt_cuspOneAmbientCurve hY x).hasDerivWithinAt,
          cuspFiniteAmbientTangent_ne_zero hY x⟩
      · rintro z ⟨τ, hτ, rfl⟩
        obtain ⟨x, hx⟩ :=
          exists_cuspLevelCurve_eq_of_mem .one Y hY hτ
        refine ⟨x, Set.mem_univ _, ?_⟩
        rw [← hx]
        exact (coe_cuspLevelCurve_one Y hY x).symm

/-- Nonpositive height levels are empty, hence regular curve pieces. -/
theorem isRegularSmoothCurvePiece_coe_cuspHeightLevel_of_nonpos
    (κ : Gamma2Cusp) {Y : ℝ} (hY : Y ≤ 0) :
    IsRegularSmoothCurvePiece
      (UpperHalfPlane.coe '' cuspHeightLevel κ Y) := by
  rw [cuspHeightLevel_eq_empty_of_nonpos κ hY, Set.image_empty]
  exact isRegularSmoothCurvePiece_empty

/-- Unconditional regularity of every cusp-height level, including the empty
nonpositive levels. -/
theorem isRegularSmoothCurvePiece_coe_cuspHeightLevel
    (κ : Gamma2Cusp) (Y : ℝ) :
    IsRegularSmoothCurvePiece
      (UpperHalfPlane.coe '' cuspHeightLevel κ Y) := by
  rcases lt_or_ge 0 Y with hY | hY
  · exact isRegularSmoothCurvePiece_coe_cuspHeightLevel_of_pos κ hY
  · exact isRegularSmoothCurvePiece_coe_cuspHeightLevel_of_nonpos κ hY

/-- The corrected truncation is an intersection of the polygon with the three
closed cusp-height sublevels. -/
theorem truncatedFundamentalDomain_closedPolygon_eq_inter_iInter
    (Y : ℝ) :
    truncatedFundamentalDomain closedPolygon Y =
      closedPolygon ∩ ⋂ κ : Gamma2Cusp, cuspHeightSublevel κ Y := by
  ext τ
  simp [truncatedFundamentalDomain, cuspHeightSublevel]

/-- Continuity forces the frontier of a closed height sublevel to lie on its
level set. -/
theorem frontier_cuspHeightSublevel_subset_level
    (κ : Gamma2Cusp) (Y : ℝ) :
    frontier (cuspHeightSublevel κ Y) ⊆ cuspHeightLevel κ Y := by
  simpa [cuspHeightSublevel, cuspHeightLevel] using
    (frontier_le_subset_eq (continuous_cuspHeight κ)
      (continuous_const : Continuous (fun _ : UpperHalfPlane => Y)))

/-- The frontier of the six-cell union is covered by the six cell frontiers;
internal shared edges are harmless extra members of the covering union. -/
theorem frontier_closedPolygon_subset_iUnion_cellFrontier :
    frontier closedPolygon ⊆
      ⋃ r : Gamma2Rep, frontier (closedCell r) := by
  rw [closedPolygon]
  exact frontier_iUnion_subset_iUnion_frontier closedCell

/-- The frontier of the simultaneous three-height condition is covered by the
three corresponding height levels. -/
theorem frontier_iInter_cuspHeightSublevel_subset_iUnion_level
    (Y : ℝ) :
    frontier (⋂ κ : Gamma2Cusp, cuspHeightSublevel κ Y) ⊆
      ⋃ κ : Gamma2Cusp, cuspHeightLevel κ Y := by
  refine (frontier_iInter_subset_iUnion_frontier
    (fun κ : Gamma2Cusp => cuspHeightSublevel κ Y)).trans ?_
  intro τ hτ
  obtain ⟨κ, hκ⟩ := Set.mem_iUnion.mp hτ
  exact Set.mem_iUnion.mpr
    ⟨κ, frontier_cuspHeightSublevel_subset_level κ Y hκ⟩

/-- **Unconditional topological boundary cover.**  The boundary of every
simultaneously truncated explicit six-cell polygon is covered by the six cell
frontiers together with the three cusp-height level sets.  This is the
set-theoretic input to the regular smooth assembly theorem below. -/
theorem frontier_truncatedFundamentalDomain_closedPolygon_subset
    (Y : ℝ) :
    frontier (truncatedFundamentalDomain closedPolygon Y) ⊆
      (⋃ r : Gamma2Rep, frontier (closedCell r)) ∪
        ⋃ κ : Gamma2Cusp, cuspHeightLevel κ Y := by
  rw [truncatedFundamentalDomain_closedPolygon_eq_inter_iInter]
  exact (frontier_inter_subset_union_frontier closedPolygon
    (⋂ κ : Gamma2Cusp, cuspHeightSublevel κ Y)).trans
      (Set.union_subset_union
        frontier_closedPolygon_subset_iUnion_cellFrontier
        (frontier_iInter_cuspHeightSublevel_subset_iUnion_level Y))

/-! ##### Finite assembly of the complete truncated boundary -/

/-- Core assembly theorem with every cell's finite presentation exposed.
The dependent sigma type collects the possibly different finite piece types
chosen for the six cells; the sum adds one regular piece for each cusp level. -/
theorem hasPiecewiseSmoothBoundary_truncated_of_explicit
    (Y : ℝ)
    (ι : Gamma2Rep → Type)
    (inst : ∀ r, Fintype (ι r))
    (piece : ∀ r, ι r → Set ℂ)
    (hregular : ∀ r i, IsRegularSmoothCurvePiece (piece r i))
    (hcellCover : ∀ r,
      UpperHalfPlane.coe '' frontier (closedCell r) ⊆
        ⋃ i, piece r i)
    (hlevel : ∀ κ,
      IsRegularSmoothCurvePiece
        (UpperHalfPlane.coe '' cuspHeightLevel κ Y)) :
    HasPiecewiseSmoothBoundary
      (truncatedFundamentalDomain closedPolygon Y) := by
  classical
  letI _ (r : Gamma2Rep) : Fintype (ι r) := inst r
  let Index : Type := (Sigma ι) ⊕ Gamma2Cusp
  letI : Fintype Index := inferInstance
  let assembledPiece : Index → Set ℂ
    | .inl ⟨r, i⟩ => piece r i
    | .inr κ => UpperHalfPlane.coe '' cuspHeightLevel κ Y
  refine ⟨Index, inferInstance, assembledPiece, ?_, ?_⟩
  · intro q
    cases q with
    | inl q =>
        exact hregular q.1 q.2
    | inr κ =>
        exact hlevel κ
  · rintro z ⟨τ, hτ, rfl⟩
    rcases frontier_truncatedFundamentalDomain_closedPolygon_subset Y hτ with
      hcell | hcusp
    · obtain ⟨r, hr⟩ := Set.mem_iUnion.mp hcell
      have hz := hcellCover r ⟨τ, hr, rfl⟩
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
      exact Set.mem_iUnion.mpr
        ⟨Sum.inl ⟨r, i⟩, by simpa [assembledPiece] using hi⟩
    · obtain ⟨κ, hκ⟩ := Set.mem_iUnion.mp hcusp
      have hz : (τ : ℂ) ∈
          UpperHalfPlane.coe '' cuspHeightLevel κ Y :=
        ⟨τ, hκ, rfl⟩
      exact Set.mem_iUnion.mpr
        ⟨Sum.inr κ, by simpa [assembledPiece] using hz⟩

/-- Existential wrapper: presentations supplied only through
`HasPiecewiseSmoothBoundary` can still be assembled even when their finite
index types vary from cell to cell. -/
theorem hasPiecewiseSmoothBoundary_truncated_of_cells
    (Y : ℝ)
    (hcell : ∀ r, HasPiecewiseSmoothBoundary (closedCell r))
    (hlevel : ∀ κ,
      IsRegularSmoothCurvePiece
        (UpperHalfPlane.coe '' cuspHeightLevel κ Y)) :
    HasPiecewiseSmoothBoundary
      (truncatedFundamentalDomain closedPolygon Y) := by
  classical
  simp only [HasPiecewiseSmoothBoundary] at hcell
  choose ι hι using hcell
  choose inst hinst using hι
  choose piece hpiece using hinst
  exact hasPiecewiseSmoothBoundary_truncated_of_explicit
    Y ι inst piece
      (fun r i => (hpiece r).1 i)
      (fun r => (hpiece r).2)
      hlevel

/-- **Unconditional piecewise-smooth boundary theorem for corrected
Definition 3.**  The six transformed standard modular boundaries and the three
explicit cusp-height curves give a finite regular smooth cover of every
truncated polygon frontier. -/
theorem hasPiecewiseSmoothBoundary_truncatedFundamentalDomain_closedPolygon
    (Y : ℝ) :
    HasPiecewiseSmoothBoundary
      (truncatedFundamentalDomain closedPolygon Y) :=
  hasPiecewiseSmoothBoundary_truncated_of_cells Y
    hasPiecewiseSmoothBoundary_closedCell
    (fun κ => isRegularSmoothCurvePiece_coe_cuspHeightLevel κ Y)

/-! ##### Bundled corrected Definition 3 certificate -/

/-- All geometric and topological obligations of the corrected concrete
`Gamma(2)` truncation are packaged in one proposition.  In particular, the
bundle stores proofs rather than assumptions about the explicit polygon. -/
structure ConcreteGamma2TruncationCertificate : Prop where
  cusp_count : Fintype.card Gamma2Cusp = 3
  width_two : ∀ κ : Gamma2Cusp, Gamma2Cusp.width κ = 2
  strict_width_two : ∀ κ : Gamma2Cusp,
    Subgroup.strictWidthInfty
      (CongruenceSubgroup.conjGL Gamma2 (Gamma2Cusp.scalingMatrix κ) :
        Subgroup (Matrix.GeneralLinearGroup (Fin 2) ℝ)) = 2
  strict_horoballs_pairwise_disjoint :
    Pairwise fun κ₁ κ₂ =>
      Disjoint (strictCuspHoroball κ₁) (strictCuspHoroball κ₂)
  six_representatives : Fintype.card Gamma2Rep = 6
  six_cosets : Function.Bijective reducedRep
  closed_polygon : IsClosed closedPolygon
  orbit_coverage : ∀ τ : UpperHalfPlane,
    ∃ γ : Gamma2Element, γ • τ ∈ closedPolygon
  open_cells_pairwise_disjoint : Pairwise fun r₁ r₂ =>
    Disjoint (openCell r₁) (openCell r₂)
  interior_orbit_unique : ∀ {x y : UpperHalfPlane},
    x ∈ openPolygon → y ∈ openPolygon →
      ∀ γ : Gamma2Element, γ • x = y → x = y
  truncation_closed : ∀ Y : ℝ,
    IsClosed (truncatedFundamentalDomain closedPolygon Y)
  truncation_compact : ∀ Y : ℝ,
    IsCompact (truncatedFundamentalDomain closedPolygon Y)
  truncation_piecewise_smooth : ∀ Y : ℝ,
    HasPiecewiseSmoothBoundary
      (truncatedFundamentalDomain closedPolygon Y)
  exhaustion :
    (⋃ Y : ℝ, truncatedFundamentalDomain closedPolygon Y) = closedPolygon

/-- **Unconditional bundled certificate for corrected Definition 3.** -/
def concreteGamma2TruncationCertificate :
    ConcreteGamma2TruncationCertificate where
  cusp_count := Gamma2Cusp.card_eq
  width_two := Gamma2Cusp.width_eq_two
  strict_width_two := Gamma2Cusp.strictWidth_scaling_conjugate_eq_two
  strict_horoballs_pairwise_disjoint :=
    pairwise_disjoint_strictCuspHoroball
  six_representatives := card_gamma2Rep
  six_cosets := reducedRep_bijective
  closed_polygon := isClosed_closedPolygon
  orbit_coverage := exists_gamma2_smul_mem_closedPolygon
  open_cells_pairwise_disjoint := pairwise_disjoint_openCell
  interior_orbit_unique := by
    intro x y hx hy γ hγ
    exact eq_of_mem_openPolygon_of_gamma2_smul_eq hx hy γ hγ
  truncation_closed := fun Y =>
    isClosed_truncatedFundamentalDomain isClosed_closedPolygon Y
  truncation_compact :=
    isCompact_truncatedFundamentalDomain_closedPolygon
  truncation_piecewise_smooth :=
    hasPiecewiseSmoothBoundary_truncatedFundamentalDomain_closedPolygon
  exhaustion := iUnion_truncatedFundamentalDomain closedPolygon

attribute [-instance] NormedSpace.complexToReal
attribute [instance] instInnerProductSpaceRealComplex
attribute [instance 900] NormedSpace.complexToReal

end StandardComplexRealNormedSpace

end CorrectedLemmas.Gamma2SixCellPolygon

/-! ### Unconditional generation of `Gamma(2)`

The six residue representatives above also give a finite
Reidemeister--Schreier calculation.  The only transition data are the twelve
left-multiplication identities for `S` and `T`; all are checked entrywise over
the integer matrices. -/

namespace CorrectedLemmas.Gamma2Generation

open Gamma2SixCellPolygon

abbrev G : Type := Gamma2SixCellPolygon.IntegralSpecialLinear

def generatorA : G := ModularGroup.T ^ (2 : ℤ)

def generatorB : G :=
  ModularGroup.S * generatorA * ModularGroup.S⁻¹

def generatorZ : G := -1

def standardGeneratorSet : Set G :=
  {generatorA, generatorB, generatorZ}

def generated : Subgroup G :=
  Subgroup.closure standardGeneratorSet

theorem generatorA_mem : generatorA ∈ generated :=
  Subgroup.subset_closure (by simp [standardGeneratorSet])

theorem generatorB_mem : generatorB ∈ generated :=
  Subgroup.subset_closure (by simp [standardGeneratorSet])

theorem generatorZ_mem : generatorZ ∈ generated :=
  Subgroup.subset_closure (by simp [standardGeneratorSet])

/-- Every standard generator is an actual element of `Gamma(2)`. -/
theorem generated_le_gamma2 : generated ≤ Gamma2 := by
  apply (Subgroup.closure_le Gamma2).2
  intro g hg
  simp only [standardGeneratorSet, Set.mem_insert_iff,
    Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl
  · exact gamma2_T_two_mem
  · simpa [generatorB] using
      (CongruenceSubgroup.Gamma_normal 2).conj_mem
        generatorA gamma2_T_two_mem ModularGroup.S
  · exact ThetaGeneratorLift.negOne_mem_gamma2

/-- Six finite `S`-transitions for the residue representatives. -/
theorem left_S_rep_decomposition
    (r : Gamma2Rep) :
    ∃ (r' : Gamma2Rep) (h : G),
      h ∈ generated ∧
        ModularGroup.S * repMatrix r = repMatrix r' * h := by
  cases r with
  | id =>
      refine ⟨.s, 1, Subgroup.one_mem generated, ?_⟩
      simp [repMatrix]
  | t =>
      refine ⟨.stInv, generatorA, generatorA_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA,
          Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | s =>
      refine ⟨.id, generatorZ, generatorZ_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorZ,
          Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
          pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | ts =>
      refine ⟨.tstInv, generatorA * generatorB * generatorZ,
        generated.mul_mem (generated.mul_mem generatorA_mem generatorB_mem)
          generatorZ_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA, generatorB, generatorZ,
          Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | stInv =>
      refine ⟨.t, generatorZ * generatorA⁻¹,
        generated.mul_mem generatorZ_mem (generated.inv_mem generatorA_mem), ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA, generatorZ,
          Matrix.SpecialLinearGroup.coe_mul,
          Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
          ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | tstInv =>
      refine ⟨.ts, generatorB⁻¹ * generatorA⁻¹,
        generated.mul_mem (generated.inv_mem generatorB_mem)
          (generated.inv_mem generatorA_mem), ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA, generatorB,
          Matrix.SpecialLinearGroup.coe_mul,
          Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
          ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

/-- Six finite `T`-transitions for the residue representatives. -/
theorem left_T_rep_decomposition
    (r : Gamma2Rep) :
    ∃ (r' : Gamma2Rep) (h : G),
      h ∈ generated ∧
        ModularGroup.T * repMatrix r = repMatrix r' * h := by
  cases r with
  | id =>
      refine ⟨.t, 1, Subgroup.one_mem generated, ?_⟩
      simp [repMatrix]
  | t =>
      refine ⟨.id, generatorA, generatorA_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA,
          Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_T,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | s =>
      refine ⟨.ts, 1, Subgroup.one_mem generated, ?_⟩
      simp [repMatrix]
  | ts =>
      refine ⟨.s, generatorB, generatorB_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA, generatorB,
          Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]
  | stInv =>
      refine ⟨.tstInv, 1, Subgroup.one_mem generated, ?_⟩
      simp [repMatrix, mul_assoc]
  | tstInv =>
      refine ⟨.stInv, generatorB⁻¹ * generatorA⁻¹ * generatorZ,
        generated.mul_mem
          (generated.mul_mem (generated.inv_mem generatorB_mem)
            (generated.inv_mem generatorA_mem)) generatorZ_mem, ?_⟩
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [repMatrix, generatorA, generatorB, generatorZ,
          Matrix.SpecialLinearGroup.coe_mul,
          Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
          ModularGroup.coe_S,
          ModularGroup.coe_T, ModularGroup.coe_T_inv,
          ModularGroup.coe_T_zpow, pow_two, Matrix.mul_fin_two, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

/-- Every integral determinant-one matrix is one of the six residue
representatives followed by an element generated by `A`, `B`, and `Z`. -/
theorem exists_rep_mul_generated (g : G) :
    ∃ (r : Gamma2Rep) (h : G),
      h ∈ generated ∧ g = repMatrix r * h := by
  induction g using (FixedDetMatrices.induction_on one_ne_zero) with
  | h0 g h10 h00 _ h01 =>
      have hg : g = (1 : G) :=
        FixedDetMatrices.reps_one_id g h10 h00 h01
      subst g
      exact ⟨.id, 1, Subgroup.one_mem generated, by simp⟩
  | hS g ih =>
      change G at g
      obtain ⟨r, h, hh, hg⟩ := ih
      obtain ⟨r', k, hk, htransition⟩ :=
        left_S_rep_decomposition r
      refine ⟨r', k * h, generated.mul_mem hk hh, ?_⟩
      change ModularGroup.S * g = repMatrix r' * (k * h)
      rw [hg, ← mul_assoc, htransition, mul_assoc]
  | hT g ih =>
      change G at g
      obtain ⟨r, h, hh, hg⟩ := ih
      obtain ⟨r', k, hk, htransition⟩ :=
        left_T_rep_decomposition r
      refine ⟨r', k * h, generated.mul_mem hk hh, ?_⟩
      change ModularGroup.T * g = repMatrix r' * (k * h)
      rw [hg, ← mul_assoc, htransition, mul_assoc]

/-- Every matrix in the principal congruence subgroup lies in the generated
subgroup. -/
theorem gamma2_le_generated : Gamma2 ≤ generated := by
  intro g hg
  obtain ⟨r, h, hh, hfactor⟩ := exists_rep_mul_generated g
  have hhGamma : h ∈ Gamma2 := generated_le_gamma2 hh
  have hred : reducedRep r = 1 := by
    have hmap := congrArg modTwoReduction hfactor
    rw [map_mul,
      (mem_gamma2_iff_modTwoReduction_eq_one g).mp hg,
      (mem_gamma2_iff_modTwoReduction_eq_one h).mp hhGamma,
      mul_one] at hmap
    exact hmap.symm
  have hid : reducedRep (.id : Gamma2Rep) = 1 := by
    simp [reducedRep, repMatrix]
  have hr : r = .id :=
    reducedRep_injective (hred.trans hid.symm)
  subst r
  rw [repMatrix_id, one_mul] at hfactor
  rw [hfactor]
  exact hh

/-- **Concrete generation theorem for `Gamma(2)`.** -/
theorem gamma2_eq_closure_standard_generators :
    Gamma2 = generated :=
  le_antisymm gamma2_le_generated generated_le_gamma2

end CorrectedLemmas.Gamma2Generation

/-! ### A theta-compatible genuine lift of the zero-cusp generator -/

namespace CorrectedLemmas.ZeroCuspThetaLift

open GenuineGamma2Metaplectic GenuineHalfWeightAutomorphy

/-- The second standard parabolic generator `S T² S⁻¹` in `Gamma(2)`. -/
def zeroTranslation : Gamma2Element :=
  CuspQStabilizer.Gamma2Cusp.translationElement Gamma2Cusp.zero

/-- The transformed point occurring in the first `S`-theta factor. -/
def transformedPoint (τ : UpperHalfPlane) : UpperHalfPlane :=
  (ModularGroup.T ^ (2 : ℤ)) • (ModularGroup.S⁻¹ • τ)

def firstBase (τ : UpperHalfPlane) : ℂ :=
  -Complex.I * (transformedPoint τ : ℂ)

def secondBase (τ : UpperHalfPlane) : ℂ :=
  -Complex.I * (τ : ℂ)

/-- Principal-half-power factor obtained by applying the `S` transformation
before and after the width-two translation. -/
noncomputable def factor (τ : UpperHalfPlane) : ℂ :=
  firstBase τ ^ (1 / 2 : ℂ) * secondBase τ ^ (1 / 2 : ℂ)

/-- Multiplication by `-I` sends every upper-half-plane point into the slit
plane, because the resulting real part is the original positive height. -/
theorem neg_I_mul_mem_slitPlane (z : UpperHalfPlane) :
    -Complex.I * (z : ℂ) ∈ Complex.slitPlane := by
  rw [Complex.mem_slitPlane_iff]
  left
  simpa [Complex.mul_re] using z.im_pos

theorem firstBase_mem_slitPlane (τ : UpperHalfPlane) :
    firstBase τ ∈ Complex.slitPlane := by
  exact neg_I_mul_mem_slitPlane (transformedPoint τ)

theorem secondBase_mem_slitPlane (τ : UpperHalfPlane) :
    secondBase τ ∈ Complex.slitPlane := by
  exact neg_I_mul_mem_slitPlane τ

theorem continuous_transformedPoint : Continuous transformedPoint := by
  change Continuous (fun τ : UpperHalfPlane =>
    (((ModularGroup.T ^ (2 : ℤ) : Matrix.SpecialLinearGroup (Fin 2) ℤ) : GL (Fin 2) ℝ) •
      (((ModularGroup.S⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : GL (Fin 2) ℝ) • τ)))
  exact (continuous_const_smul _).comp (continuous_const_smul _)

theorem continuous_firstBase : Continuous firstBase := by
  exact continuous_const.mul
    (UpperHalfPlane.continuous_coe.comp continuous_transformedPoint)

theorem continuous_secondBase : Continuous secondBase := by
  exact continuous_const.mul UpperHalfPlane.continuous_coe

theorem continuous_firstHalfPower :
    Continuous (fun τ : UpperHalfPlane => firstBase τ ^ (1 / 2 : ℂ)) := by
  have hlog : Continuous (fun τ => Complex.log (firstBase τ)) :=
    continuous_firstBase.clog firstBase_mem_slitPlane
  have heq :
      (fun τ : UpperHalfPlane => firstBase τ ^ (1 / 2 : ℂ)) =
        fun τ => Complex.exp (Complex.log (firstBase τ) * (1 / 2 : ℂ)) := by
    funext τ
    rw [Complex.cpow_def_of_ne_zero
      (Complex.slitPlane_ne_zero (firstBase_mem_slitPlane τ))]
  rw [heq]
  exact Complex.continuous_exp.comp (hlog.mul continuous_const)

theorem continuous_secondHalfPower :
    Continuous (fun τ : UpperHalfPlane => secondBase τ ^ (1 / 2 : ℂ)) := by
  have hlog : Continuous (fun τ => Complex.log (secondBase τ)) :=
    continuous_secondBase.clog secondBase_mem_slitPlane
  have heq :
      (fun τ : UpperHalfPlane => secondBase τ ^ (1 / 2 : ℂ)) =
        fun τ => Complex.exp (Complex.log (secondBase τ) * (1 / 2 : ℂ)) := by
    funext τ
    rw [Complex.cpow_def_of_ne_zero
      (Complex.slitPlane_ne_zero (secondBase_mem_slitPlane τ))]
  rw [heq]
  exact Complex.continuous_exp.comp (hlog.mul continuous_const)

theorem continuous_factor : Continuous factor := by
  exact continuous_firstHalfPower.mul continuous_secondHalfPower

/-- The square of a principal complex half-power is the original base. -/
theorem halfPower_sq (z : ℂ) :
    (z ^ (1 / 2 : ℂ)) ^ 2 = z := by
  simpa [one_div] using
    (Complex.cpow_nat_inv_pow z (by norm_num : (2 : ℕ) ≠ 0))

/-- Exact product of the two bases, before taking principal half-powers. -/
theorem firstBase_mul_secondBase (τ : UpperHalfPlane) :
    firstBase τ * secondBase τ = 1 - 2 * (τ : ℂ) := by
  have hτ : (τ : ℂ) ≠ 0 := τ.ne_zero
  simp only [firstBase, secondBase, transformedPoint,
    ModularGroup.S_inv, ModularGroup.SL_neg_smul,
    UpperHalfPlane.modular_T_zpow_smul, UpperHalfPlane.coe_vadd,
    UpperHalfPlane.modular_S_smul, UpperHalfPlane.coe_mk, inv_neg]
  rw [mul_mul_mul_comm, neg_mul_neg, Complex.I_mul_I, neg_one_mul]
  field_simp [hτ]
  simpa [mul_comm, sub_eq_add_neg]

theorem factor_sq (τ : UpperHalfPlane) :
    factor τ ^ (2 : ℕ) = 1 - 2 * (τ : ℂ) := by
  rw [factor, mul_pow, halfPower_sq, halfPower_sq]
  exact firstBase_mul_secondBase τ

/-- The actual Moebius denominator of `S T² S⁻¹` is `1 - 2τ`. -/
theorem denom_zeroTranslation (τ : UpperHalfPlane) :
    UpperHalfPlane.denom
        (GenuineGamma2Metaplectic.realMatrix zeroTranslation) τ =
      1 - 2 * (τ : ℂ) := by
  simp [zeroTranslation, CuspQStabilizer.Gamma2Cusp.translationElement,
    Gamma2Cusp.scalingMatrix, GenuineGamma2Metaplectic.realMatrix,
    UpperHalfPlane.denom, Matrix.SpecialLinearGroup.coe_mul,
    ModularGroup.S_inv, ModularGroup.coe_S, ModularGroup.coe_T_zpow,
    Matrix.mul_fin_two]
  norm_num [pow_two, Matrix.mul_apply, Fin.sum_univ_two] <;> ring_nf

/-- The zero-cusp parabolic action is the literal composition
`S ∘ T² ∘ S⁻¹`. -/
theorem zeroTranslation_act (τ : UpperHalfPlane) :
    gamma2Act zeroTranslation τ =
      ModularGroup.S • transformedPoint τ := by
  have hscaled :=
    CuspQStabilizer.scaledCoordinate_translationElement_eq_T_sq_smul
      Gamma2Cusp.zero τ
  have h := congrArg (fun z : UpperHalfPlane => ModularGroup.S • z) hscaled
  simpa [zeroTranslation, transformedPoint, gamma2Act,
    Gamma2Cusp.scalingMatrix, mul_smul] using h

/-- The genuine lift of the second standard `Gamma(2)` generator. -/
noncomputable def zeroCuspLift : GenuineGamma2Metaplectic.Element where
  matrix := zeroTranslation
  sqrtFactor := factor
  sqrtFactor_sq := by
    intro τ
    exact (factor_sq τ).trans (denom_zeroTranslation τ).symm
  continuous_sqrtFactor := continuous_factor

@[simp]
theorem zeroCuspLift_matrix : zeroCuspLift.matrix = zeroTranslation := rfl

@[simp]
theorem zeroCuspLift_sqrtFactor (τ : UpperHalfPlane) :
    zeroCuspLift.sqrtFactor τ = factor τ := rfl

@[simp]
theorem zeroCuspLift_projection :
    GenuineGamma2Metaplectic.toGamma2 zeroCuspLift = zeroTranslation := rfl

/-- A concrete point detecting the nonunit norm of the zero-cusp denominator. -/
def normTestPoint : UpperHalfPlane :=
  ⟨Complex.I, by simp⟩

@[simp]
theorem normTestPoint_coe : (normTestPoint : ℂ) = Complex.I :=
  rfl

theorem normSq_zeroCuspDenominator_at_testPoint :
    Complex.normSq
        (UpperHalfPlane.denom
          (GenuineGamma2Metaplectic.realMatrix zeroCuspLift.matrix)
          normTestPoint) = 5 := by
  rw [zeroCuspLift_matrix, denom_zeroTranslation]
  norm_num [Complex.normSq_apply]

/-- The genuine square-root denominator is not pointwise unitary. -/
theorem zeroCuspLift_sqrtFactor_norm_ne_one :
    ‖zeroCuspLift.sqrtFactor normTestPoint‖ ≠ 1 := by
  intro hnorm
  have hsq :=
    GenuineGamma2Metaplectic.normSq_denom_eq_norm_sqrtFactor_pow_four
      zeroCuspLift normTestPoint
  rw [normSq_zeroCuspDenominator_at_testPoint, hnorm] at hsq
  norm_num at hsq

/-- Explicit failure of the PDF's unweighted pointwise norm under its literal
inverse-half-weight law.  Thus the displayed integrand is not a pointwise
quotient density.  This statement does not claim an integral inequality for a
separately constructed global automorphic test section. -/
theorem inverseHalfWeight_plainNorm_not_invariant :
    ‖(zeroCuspLift.sqrtFactor normTestPoint)⁻¹ * (1 : ℂ)‖ ≠
      ‖(1 : ℂ)‖ := by
  intro hplain
  have hinv :=
    GenuineInverseHalfWeightAutomorphy.sqrtFactor_norm_inv_eq_one_of_plainNormInvariant
      zeroCuspLift (1 : Circle) normTestPoint (1 : ℂ)
      ((zeroCuspLift.sqrtFactor normTestPoint)⁻¹ * (1 : ℂ))
      (by norm_num) (by simp) hplain
  have hnorm : ‖zeroCuspLift.sqrtFactor normTestPoint‖ = 1 :=
    inv_eq_one.mp hinv
  exact zeroCuspLift_sqrtFactor_norm_ne_one hnorm

/-- Direct standard-theta covariance of the zero-cusp lift. -/
theorem theta_zeroCuspLift_covariance (τ : UpperHalfPlane) :
    ConcreteUnaryTheta.theta (gamma2Act zeroCuspLift.matrix τ) =
      zeroCuspLift.sqrtFactor τ * ConcreteUnaryTheta.theta τ := by
  have hT :
      ConcreteUnaryTheta.theta
          ((ModularGroup.T ^ (2 : ℤ)) • (ModularGroup.S⁻¹ • τ)) =
        ConcreteUnaryTheta.theta (ModularGroup.S⁻¹ • τ) := by
    simpa using
      (ConcreteUnaryTheta.theta_T_sq (ModularGroup.S⁻¹ • τ))
  have hT' :
      ConcreteUnaryTheta.theta (transformedPoint τ) =
        ConcreteUnaryTheta.theta (ModularGroup.S⁻¹ • τ) := by
    simpa [transformedPoint] using hT
  have hSinv : ModularGroup.S⁻¹ • τ = ModularGroup.S • τ := by
    rw [ModularGroup.S_inv, ModularGroup.SL_neg_smul]
  rw [zeroCuspLift_matrix, zeroTranslation_act,
    ConcreteUnaryTheta.theta_S, hT', hSinv,
    ConcreteUnaryTheta.theta_S, zeroCuspLift_sqrtFactor]
  simp only [factor, firstBase, secondBase, transformedPoint]
  ring

theorem zeroCuspLift_isThetaCovariant :
    GenuineHalfWeightAutomorphy.IsThetaCovariant zeroCuspLift (1 : Circle) := by
  intro τ
  simpa only [Circle.coe_one, one_mul] using
    theta_zeroCuspLift_covariance τ

@[simp]
theorem zeroCuspLift_pair_mem_thetaCovariantSubgroup :
    (zeroCuspLift, (1 : Circle)) ∈
      GenuineHalfWeightAutomorphy.thetaCovariantSubgroup :=
  zeroCuspLift_isThetaCovariant

end CorrectedLemmas.ZeroCuspThetaLift

/-! ### Global genuine theta multiplier from the three generators -/

namespace CorrectedLemmas.GenuineGlobalThetaMultiplier

open GenuineGamma2Metaplectic GenuineHalfWeightAutomorphy

/-- Genuine elements already carrying a verified theta phase. -/
def thetaLiftRange :
    Subgroup GenuineGamma2Metaplectic.Element :=
  MonoidHom.range thetaCovariantProjection

theorem translationTwoLift_mem_thetaLiftRange :
    ThetaGeneratorLift.translationTwoLift ∈ thetaLiftRange := by
  exact ⟨
    ⟨(ThetaGeneratorLift.translationTwoLift, (1 : Circle)),
      translationTwo_pair_mem_thetaCovariantSubgroup⟩,
    rfl⟩

theorem zeroCuspLift_mem_thetaLiftRange :
    ZeroCuspThetaLift.zeroCuspLift ∈ thetaLiftRange := by
  exact ⟨
    ⟨(ZeroCuspThetaLift.zeroCuspLift, (1 : Circle)),
      ZeroCuspThetaLift.zeroCuspLift_pair_mem_thetaCovariantSubgroup⟩,
    rfl⟩

theorem centralNegOneLift_mem_thetaLiftRange :
    ThetaGeneratorLift.centralNegOneLift ∈ thetaLiftRange := by
  exact ⟨
    ⟨(ThetaGeneratorLift.centralNegOneLift, centralNegOnePhase),
      centralNegOne_pair_mem_thetaCovariantSubgroup⟩,
    rfl⟩

theorem deckNeg_mem_thetaLiftRange :
    GenuineGamma2Metaplectic.deckNeg ∈ thetaLiftRange := by
  exact ⟨
    ⟨(GenuineGamma2Metaplectic.deckNeg, deckNegPhase),
      deckNeg_pair_mem_thetaCovariantSubgroup⟩,
    rfl⟩

/-- Underlying integral matrix of a genuine element. -/
def genuineToIntegral :
    GenuineGamma2Metaplectic.Element →*
      Gamma2Generation.G :=
  Gamma2.subtype.comp GenuineGamma2Metaplectic.toGamma2

/-- Integral matrices reached by verified theta-covariant genuine lifts. -/
def thetaCovariantProjectedMatrices :
    Subgroup Gamma2Generation.G :=
  Subgroup.map genuineToIntegral thetaLiftRange

theorem generatorA_mem_projectedMatrices :
    Gamma2Generation.generatorA ∈ thetaCovariantProjectedMatrices := by
  refine ⟨ThetaGeneratorLift.translationTwoLift,
    translationTwoLift_mem_thetaLiftRange, ?_⟩
  rfl

theorem generatorB_mem_projectedMatrices :
    Gamma2Generation.generatorB ∈ thetaCovariantProjectedMatrices := by
  refine ⟨ZeroCuspThetaLift.zeroCuspLift,
    zeroCuspLift_mem_thetaLiftRange, ?_⟩
  rfl

theorem generatorZ_mem_projectedMatrices :
    Gamma2Generation.generatorZ ∈ thetaCovariantProjectedMatrices := by
  refine ⟨ThetaGeneratorLift.centralNegOneLift,
    centralNegOneLift_mem_thetaLiftRange, ?_⟩
  rfl

theorem generated_le_projectedMatrices :
    Gamma2Generation.generated ≤ thetaCovariantProjectedMatrices := by
  unfold Gamma2Generation.generated
  rw [Subgroup.closure_le]
  intro g hg
  simp only [Gamma2Generation.standardGeneratorSet,
    Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl
  · exact generatorA_mem_projectedMatrices
  · exact generatorB_mem_projectedMatrices
  · exact generatorZ_mem_projectedMatrices

/-- Every concrete `Gamma(2)` matrix admits a genuine metaplectic lift.  The
witness is extracted from the already proved generator and projection
surjectivity argument; no section homomorphism is asserted. -/
theorem exists_genuineLift (γ : Gamma2Element) :
    ∃ a : GenuineGamma2Metaplectic.Element, a.matrix = γ := by
  have hgenerated :
      (γ.1 : Gamma2Generation.G) ∈ Gamma2Generation.generated :=
    Gamma2Generation.gamma2_le_generated γ.property
  have hprojected := generated_le_projectedMatrices hgenerated
  rcases hprojected with ⟨a, _haRange, ha⟩
  refine ⟨a, ?_⟩
  apply Subtype.ext
  simpa [genuineToIntegral,
    GenuineGamma2Metaplectic.toGamma2_apply] using ha

/-- A chosen lift for each matrix.  It is intentionally only a function, not
a group-homomorphic splitting of the genuine double cover. -/
noncomputable def chosenGenuineLift
    (γ : Gamma2Element) : GenuineGamma2Metaplectic.Element :=
  Classical.choose (exists_genuineLift γ)

@[simp]
theorem chosenGenuineLift_matrix (γ : Gamma2Element) :
    (chosenGenuineLift γ).matrix = γ :=
  Classical.choose_spec (exists_genuineLift γ)

/-- Every genuine element carries a verified theta phase.  Matrix generation
produces a covariant lift with the same projection; the two-sheet fiber
classification and the covariant deck involution then recover the original
element. -/
theorem thetaCovariantProjection_surjective :
    Function.Surjective thetaCovariantProjection := by
  intro a
  have haGenerated :
      (a.matrix : Gamma2Generation.G) ∈ Gamma2Generation.generated := by
    rw [← Gamma2Generation.gamma2_eq_closure_standard_generators]
    exact a.matrix.property
  have haProjected := generated_le_projectedMatrices haGenerated
  rcases haProjected with ⟨b, hbRange, hba⟩
  have hab :
      GenuineGamma2Metaplectic.toGamma2 a =
        GenuineGamma2Metaplectic.toGamma2 b := by
    apply Subtype.ext
    simpa [genuineToIntegral,
      GenuineGamma2Metaplectic.toGamma2_apply] using hba.symm
  have haRange : a ∈ thetaLiftRange := by
    rcases
        GenuineGamma2Metaplectic.eq_or_eq_deckNeg_mul_of_projection_eq
          a b hab with habEq | habDeck
    · simpa [habEq] using hbRange
    · rw [habDeck]
      exact thetaLiftRange.mul_mem deckNeg_mem_thetaLiftRange hbRange
  rcases haRange with ⟨p, hp⟩
  exact ⟨p, hp⟩

/-- **Unconditional full theta covariance on the genuine cover.** -/
theorem fullThetaCovariance : FullThetaCovariance :=
  fullThetaCovariance_iff_projection_surjective.mpr
    thetaCovariantProjection_surjective

/-- The standard global theta multiplier character, now constructed without
an abstract character hypothesis. -/
noncomputable def standardThetaMultiplier : Multiplier :=
  thetaMultiplier fullThetaCovariance

theorem standardTheta_isAutomorphic :
    GenuineHalfWeightAutomorphy.IsAutomorphic
      standardThetaMultiplier ConcreteUnaryTheta.theta :=
  theta_isAutomorphic fullThetaCovariance

theorem standardThetaMultiplier_central_value :
    (standardThetaMultiplier ThetaGeneratorLift.centralNegOneLift : ℂ) =
      -Complex.I :=
  thetaMultiplier_central_value fullThetaCovariance

end CorrectedLemmas.GenuineGlobalThetaMultiplier

/-! ### Representative-independent a.e. genuine automorphic sections

The completion law must live on almost-everywhere equivalence classes, not on
chosen pointwise representatives.  This layer uses Mathlib's `AEEqFun` quotient
over the concrete hyperbolic measure.  Pullback is well defined because every
`Gamma(2)` Möbius transformation preserves that measure, and multiplication by
the continuous genuine factor is well defined on the same quotient.

This is intentionally an `AEEqFun` construction rather than a global `Lp`
claim: the unnormalised unary theta function is width-two periodic and tends to
one at the infinite cusp, so it is not a global square-integrable function on
the whole upper half-plane. -/

namespace CorrectedLemmas.GenuineAEAutomorphicSections

open GenuineGamma2Metaplectic GenuineHalfWeightAutomorphy
open GenuineGlobalThetaMultiplier

/-- Measurable complex sections modulo hyperbolic almost-everywhere equality. -/
abbrev Section := UpperHalfPlane →ₘ[hyperbolicMeasure] ℂ

/-- The genuine automorphy factor as an element of the a.e. quotient. -/
noncomputable def factorClass (ν : Multiplier) (a : Element) : Section :=
  AEEqFun.mk (factor ν a) (continuous_factor ν a).aestronglyMeasurable

/-- Measure-preserving pullback by a genuine `Gamma(2)` element. -/
noncomputable def pullback (a : Element) (u : Section) : Section :=
  u.compMeasurePreserving (gamma2Act a.matrix)
    (gamma2Act_measurePreserving a.matrix)

/-- The representative-independent genuine automorphy equation. -/
def IsAutomorphicClass (ν : Multiplier) (u : Section) : Prop :=
  ∀ a, pullback a u = factorClass ν a * u

/-- The quotient equation is exactly the earlier a.e. representative law. -/
theorem mk_isAutomorphicClass_iff
    (ν : Multiplier) (u : UpperHalfPlane → ℂ)
    (hu : AEStronglyMeasurable u hyperbolicMeasure) :
    IsAutomorphicClass ν (AEEqFun.mk u hu) ↔
      GenuineHalfWeightAutomorphy.IsAEAutomorphic
        ν hyperbolicMeasure u := by
  simp only [IsAutomorphicClass, pullback, factorClass,
    AEEqFun.compMeasurePreserving_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk, GenuineHalfWeightAutomorphy.IsAEAutomorphic]
  constructor
  · intro h a
    filter_upwards [h a] with τ hτ
    exact hτ
  · intro h a
    filter_upwards [h a] with τ hτ
    exact hτ

/-- Canonical representative form of the quotient automorphy law. -/
theorem isAutomorphicClass_iff_representative
    (ν : Multiplier) (u : Section) :
    IsAutomorphicClass ν u ↔
      GenuineHalfWeightAutomorphy.IsAEAutomorphic
        ν hyperbolicMeasure u := by
  simpa only [AEEqFun.mk_coeFn] using
    (mk_isAutomorphicClass_iff ν u u.aestronglyMeasurable)

@[simp]
theorem pullback_zero (a : Element) :
    pullback a (0 : Section) = 0 := by
  simp [pullback, AEEqFun.zero_def, Function.comp_def]

theorem pullback_add (a : Element) (u v : Section) :
    pullback a (u + v) = pullback a u + pullback a v := by
  refine AEEqFun.induction_on₂ u v ?_
  intro f hf g hg
  simp [pullback, Function.comp_def]
  filter_upwards with x
  rfl

theorem pullback_smul (a : Element) (c : ℂ) (u : Section) :
    pullback a (c • u) = c • pullback a u := by
  refine AEEqFun.induction_on u ?_
  intro f hf
  simp [pullback, Function.comp_def]
  filter_upwards with x
  rfl

/-- Pointwise multiplication on `L⁰` commutes with constant complex
scalars. -/
theorem mul_const_smul (j u : Section) (c : ℂ) :
    j * (c • u) = c • (j * u) := by
  refine AEEqFun.induction_on₂ j u ?_
  intro f hf g hg
  simp only [AEEqFun.smul_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk]
  filter_upwards with x
  change f x * (c * g x) = c * (f x * g x)
  ring

@[simp]
theorem isAutomorphicClass_zero (ν : Multiplier) :
    IsAutomorphicClass ν (0 : Section) := by
  intro a
  rw [pullback_zero]
  refine AEEqFun.induction_on (factorClass ν a) ?_
  intro f hf
  simp only [AEEqFun.zero_def, AEEqFun.mk_mul_mk, AEEqFun.mk_eq_mk]
  filter_upwards with x
  simp

theorem IsAutomorphicClass.add
    {ν : Multiplier} {u v : Section}
    (hu : IsAutomorphicClass ν u)
    (hv : IsAutomorphicClass ν v) :
    IsAutomorphicClass ν (u + v) := by
  intro a
  rw [pullback_add, hu a, hv a]
  refine AEEqFun.induction_on₂ (factorClass ν a) u ?_
  intro f hf g hg
  refine AEEqFun.induction_on v ?_
  intro k hk
  simp only [AEEqFun.mk_add_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk]
  filter_upwards with x
  change f x * g x + f x * k x = f x * (g x + k x)
  ring

theorem IsAutomorphicClass.smul
    {ν : Multiplier} {u : Section}
    (hu : IsAutomorphicClass ν u) (c : ℂ) :
    IsAutomorphicClass ν (c • u) := by
  intro a
  rw [pullback_smul, hu a]
  exact (mul_const_smul (factorClass ν a) u c).symm

/-- A bad positive-weight central phase forces an a.e. automorphic quotient
section to vanish. -/
theorem IsAutomorphicClass.eq_zero_of_bad_central_phase
    {ν : Multiplier} {u : Section}
    (hu : IsAutomorphicClass ν u)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ -Complex.I) :
    u = 0 := by
  apply AEEqFun.ext
  have huRep := (isAutomorphicClass_iff_representative ν u).1 hu
  have hcentral := huRep ThetaGeneratorLift.centralNegOneLift
  have hmatrix :
      ThetaGeneratorLift.centralNegOneLift.matrix =
        ThetaGeneratorLift.gamma2NegOne := rfl
  have hz :
      ((0 : Section) : UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure] 0 :=
    AEEqFun.coeFn_zero
  filter_upwards [hcentral, hz] with τ hτ hzτ
  rw [hzτ]
  have hfixed :
      u τ =
        GenuineHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ * u τ := by
    simpa only [hmatrix, ThetaGeneratorLift.gamma2NegOne_act] using hτ
  by_contra huτ
  have hfactor :
      GenuineHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ = 1 := by
    apply mul_right_cancel₀ huτ
    calc
      GenuineHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ * u τ = u τ := hfixed.symm
      _ = 1 * u τ := by rw [one_mul]
  exact
    (GenuineHalfWeightAutomorphy.centralNegOne_factor_ne_one_of_bad_phase
      ν hν τ) hfactor

/-- Continuity, hence strong a.e. measurability, of the concrete unary theta
section on the upper half-plane. -/
theorem continuous_concreteTheta :
    Continuous ConcreteUnaryTheta.theta := by
  rw [continuous_iff_continuousAt]
  intro τ
  change ContinuousAt (fun x : UpperHalfPlane => jacobiTheta (x : ℂ)) τ
  exact
    (continuousAt_jacobiTheta τ.im_pos).comp
      UpperHalfPlane.continuous_coe.continuousAt

/-- The concrete unary theta section in the hyperbolic a.e. quotient. -/
noncomputable def standardThetaClass : Section :=
  AEEqFun.mk ConcreteUnaryTheta.theta
    continuous_concreteTheta.aestronglyMeasurable

/-- The constructed global multiplier makes the concrete theta class genuinely
automorphic without choosing a pointwise representative. -/
theorem standardThetaClass_isAutomorphic :
    IsAutomorphicClass standardThetaMultiplier standardThetaClass :=
  (mk_isAutomorphicClass_iff standardThetaMultiplier
    ConcreteUnaryTheta.theta
    continuous_concreteTheta.aestronglyMeasurable).2
      standardTheta_isAutomorphic.isAE

end CorrectedLemmas.GenuineAEAutomorphicSections

/-! ### A.e. quotient for the PDF's literal inverse-half-weight convention -/

namespace CorrectedLemmas.GenuineInverseAEAutomorphicSections

open GenuineGamma2Metaplectic GenuineInverseHalfWeightAutomorphy

abbrev Section := UpperHalfPlane →ₘ[hyperbolicMeasure] ℂ

noncomputable def factorClass
    (ν : Multiplier) (a : Element) : Section :=
  AEEqFun.mk (factor ν a) (continuous_factor ν a).aestronglyMeasurable

noncomputable def pullback (a : Element) (u : Section) : Section :=
  u.compMeasurePreserving (gamma2Act a.matrix)
    (gamma2Act_measurePreserving a.matrix)

/-- Representative-independent inverse-half-weight automorphy. -/
def IsAutomorphicClass (ν : Multiplier) (u : Section) : Prop :=
  ∀ a, pullback a u = factorClass ν a * u

/-- The quotient law is equivalent to the literal a.e. representative law. -/
theorem mk_isAutomorphicClass_iff
    (ν : Multiplier) (u : UpperHalfPlane → ℂ)
    (hu : AEStronglyMeasurable u hyperbolicMeasure) :
    IsAutomorphicClass ν (AEEqFun.mk u hu) ↔
      GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic
        ν hyperbolicMeasure u := by
  simp only [IsAutomorphicClass, pullback, factorClass,
    AEEqFun.compMeasurePreserving_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk,
    GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic]
  constructor
  · intro h a
    filter_upwards [h a] with τ hτ
    simpa only [Function.comp_apply, Pi.mul_apply] using hτ
  · intro h a
    filter_upwards [h a] with τ hτ
    simpa only [Function.comp_apply, Pi.mul_apply] using hτ

/-- Canonical representative form of inverse-weight quotient automorphy. -/
theorem isAutomorphicClass_iff_representative
    (ν : Multiplier) (u : Section) :
    IsAutomorphicClass ν u ↔
      GenuineInverseHalfWeightAutomorphy.IsAEAutomorphic
        ν hyperbolicMeasure u := by
  simpa only [AEEqFun.mk_coeFn] using
    (mk_isAutomorphicClass_iff ν u u.aestronglyMeasurable)

@[simp]
theorem pullback_zero (a : Element) :
    pullback a (0 : Section) = 0 := by
  simp [pullback, AEEqFun.zero_def, Function.comp_def]

theorem pullback_add (a : Element) (u v : Section) :
    pullback a (u + v) = pullback a u + pullback a v := by
  refine AEEqFun.induction_on₂ u v ?_
  intro f hf g hg
  simp [pullback, Function.comp_def]
  filter_upwards with x
  rfl

theorem pullback_smul (a : Element) (c : ℂ) (u : Section) :
    pullback a (c • u) = c • pullback a u := by
  refine AEEqFun.induction_on u ?_
  intro f hf
  simp [pullback, Function.comp_def]
  filter_upwards with x
  rfl

theorem mul_const_smul (j u : Section) (c : ℂ) :
    j * (c • u) = c • (j * u) := by
  refine AEEqFun.induction_on₂ j u ?_
  intro f hf g hg
  simp only [AEEqFun.smul_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk]
  filter_upwards with x
  change f x * (c * g x) = c * (f x * g x)
  ring

@[simp]
theorem isAutomorphicClass_zero (ν : Multiplier) :
    IsAutomorphicClass ν (0 : Section) := by
  intro a
  rw [pullback_zero]
  refine AEEqFun.induction_on (factorClass ν a) ?_
  intro f hf
  simp only [AEEqFun.zero_def, AEEqFun.mk_mul_mk, AEEqFun.mk_eq_mk]
  filter_upwards with x
  simp

theorem IsAutomorphicClass.add
    {ν : Multiplier} {u v : Section}
    (hu : IsAutomorphicClass ν u)
    (hv : IsAutomorphicClass ν v) :
    IsAutomorphicClass ν (u + v) := by
  intro a
  rw [pullback_add, hu a, hv a]
  refine AEEqFun.induction_on₂ (factorClass ν a) u ?_
  intro f hf g hg
  refine AEEqFun.induction_on v ?_
  intro k hk
  simp only [AEEqFun.mk_add_mk, AEEqFun.mk_mul_mk,
    AEEqFun.mk_eq_mk]
  filter_upwards with x
  change f x * g x + f x * k x = f x * (g x + k x)
  ring

theorem IsAutomorphicClass.smul
    {ν : Multiplier} {u : Section}
    (hu : IsAutomorphicClass ν u) (c : ℂ) :
    IsAutomorphicClass ν (c • u) := by
  intro a
  rw [pullback_smul, hu a]
  exact (mul_const_smul (factorClass ν a) u c).symm

/-- For inverse half-weight, any central phase other than `I` forces the
quotient section to vanish. -/
theorem IsAutomorphicClass.eq_zero_of_bad_central_phase
    {ν : Multiplier} {u : Section}
    (hu : IsAutomorphicClass ν u)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ Complex.I) :
    u = 0 := by
  apply AEEqFun.ext
  have huRep := (isAutomorphicClass_iff_representative ν u).1 hu
  have hcentral := huRep ThetaGeneratorLift.centralNegOneLift
  have hmatrix :
      ThetaGeneratorLift.centralNegOneLift.matrix =
        ThetaGeneratorLift.gamma2NegOne := rfl
  have hz :
      ((0 : Section) : UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure] 0 :=
    AEEqFun.coeFn_zero
  filter_upwards [hcentral, hz] with τ hτ hzτ
  rw [hzτ]
  have hfixed :
      u τ =
        GenuineInverseHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ * u τ := by
    simpa only [hmatrix, ThetaGeneratorLift.gamma2NegOne_act] using hτ
  by_contra huτ
  have hfactor :
      GenuineInverseHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ = 1 := by
    apply mul_right_cancel₀ huτ
    calc
      GenuineInverseHalfWeightAutomorphy.factor ν
          ThetaGeneratorLift.centralNegOneLift τ * u τ = u τ := hfixed.symm
      _ = 1 * u τ := by rw [one_mul]
  exact
    (GenuineInverseHalfWeightAutomorphy.centralNegOne_factor_ne_one_of_bad_phase
      ν hν τ) hfactor

end CorrectedLemmas.GenuineInverseAEAutomorphicSections

/-! ### Concrete weighted `L²` carriers on the six-cell `Gamma(2)` polygon

The two half-weight conventions use the same restricted hyperbolic carrier but
different Petersson normalizers.  The records below keep automorphy and
square-integrability as actual proof fields.  They do not assert boundary
nullity, extension surjectivity, or integrability of a particular theta
section. -/

namespace CorrectedLemmas.GenuineSixCellWeightedL2

/-- The explicit closed six-cell fundamental polygon certified above. -/
abbrev fundamentalRegion : Set UpperHalfPlane :=
  Gamma2SixCellPolygon.closedPolygon

theorem measurableSet_fundamentalRegion :
    MeasurableSet fundamentalRegion :=
  Gamma2SixCellPolygon.isClosed_closedPolygon.measurableSet

/-- Hyperbolic measure restricted to the explicit six-cell polygon. -/
noncomputable def fundamentalMeasure : Measure UpperHalfPlane :=
  hyperbolicMeasure.restrict fundamentalRegion

theorem fundamentalMeasure_le_hyperbolicMeasure :
    fundamentalMeasure ≤ hyperbolicMeasure := by
  exact Measure.restrict_le_self

/-- Every hyperbolic a.e. statement remains true after restriction to the
explicit polygon. -/
theorem eventually_of_hyperbolic_eventually
    {p : UpperHalfPlane → Prop}
    (h : ∀ᵐ τ ∂hyperbolicMeasure, p τ) :
    ∀ᵐ τ ∂fundamentalMeasure, p τ :=
  h.filter_mono (ae_mono fundamentalMeasure_le_hyperbolicMeasure)

/-- A representative equality on the closed fundamental polygon propagates
globally once both representatives satisfy the same nonvanishing automorphy
law.  The countable intersection is indexed by the concrete matrix group, not
by the function-valued metaplectic cover. -/
theorem global_aeEq_of_fundamental_aeEq
    (j : Gamma2Element → UpperHalfPlane → ℂ)
    (hj : ∀ γ τ, j γ τ ≠ 0)
    {u v : UpperHalfPlane → ℂ}
    (hu : ∀ γ, ∀ᵐ τ ∂hyperbolicMeasure,
      u (gamma2Act γ τ) = j γ τ * u τ)
    (hv : ∀ γ, ∀ᵐ τ ∂hyperbolicMeasure,
      v (gamma2Act γ τ) = j γ τ * v τ)
    (hfund : u =ᵐ[fundamentalMeasure] v) :
    u =ᵐ[hyperbolicMeasure] v := by
  have honFundamental :
      ∀ᵐ τ ∂hyperbolicMeasure,
        τ ∈ fundamentalRegion → u τ = v τ := by
    exact (ae_restrict_iff' measurableSet_fundamentalRegion).1 <| by
      simpa only [fundamentalMeasure, Filter.EventuallyEq] using hfund
  have hmatrix : ∀ γ : Gamma2Element,
      ∀ᵐ τ ∂hyperbolicMeasure,
        gamma2Act γ τ ∈ fundamentalRegion → u τ = v τ := by
    intro γ
    have hpull :
        ∀ᵐ τ ∂hyperbolicMeasure,
          gamma2Act γ τ ∈ fundamentalRegion →
            u (gamma2Act γ τ) = v (gamma2Act γ τ) :=
      (gamma2Act_measurePreserving γ).quasiMeasurePreserving.ae
        honFundamental
    filter_upwards [hpull, hu γ, hv γ] with τ hregion huτ hvτ
    intro hmem
    have heq := hregion hmem
    rw [huτ, hvτ] at heq
    exact mul_left_cancel₀ (hj γ τ) heq
  let encodeMatrix : Matrix (Fin 2) (Fin 2) ℤ → ℤ × ℤ × ℤ × ℤ :=
    fun A => (A 0 0, A 0 1, A 1 0, A 1 1)
  have encodeMatrix_injective : Function.Injective encodeMatrix := by
    intro A B h
    ext i j
    fin_cases i <;> fin_cases j
    · exact congrArg (fun t => t.1) h
    · exact congrArg (fun t => t.2.1) h
    · exact congrArg (fun t => t.2.2.1) h
    · exact congrArg (fun t => t.2.2.2) h
  letI : Countable Gamma2Element :=
    (show Function.Injective
        (fun γ : Gamma2Element => encodeMatrix γ.1.1) by
      intro γ δ h
      apply Subtype.ext
      apply Subtype.ext
      exact encodeMatrix_injective h).countable
  have hall :
      ∀ᵐ τ ∂hyperbolicMeasure, ∀ γ : Gamma2Element,
        gamma2Act γ τ ∈ fundamentalRegion → u τ = v τ := by
    rw [ae_all_iff]
    exact hmatrix
  filter_upwards [hall] with τ hτ
  obtain ⟨γ, hγ⟩ :=
    Gamma2SixCellPolygon.exists_gamma2_smul_mem_closedPolygon τ
  exact hτ γ <| by
    simpa only [fundamentalRegion, gamma2_smul_eq_gamma2Act] using hγ

/-- Concrete Hilbert carrier for the positive-square-root convention. -/
abbrev PositiveL2Carrier : Type :=
  MeasureTheory.Lp ℂ 2 fundamentalMeasure

/-- Concrete Hilbert carrier for the inverse-square-root convention.  It is
definitionally the same `L²` carrier; the convention enters through the
normalizing multiplier and automorphy predicate. -/
abbrev InverseL2Carrier : Type :=
  MeasureTheory.Lp ℂ 2 fundamentalMeasure

/-- Positive-convention Petersson normalizer `y^(1/4)`, written without a
complex branch. -/
noncomputable def positivePeterssonQuarter
    (τ : UpperHalfPlane) : ℂ :=
  ((Real.sqrt (Real.sqrt τ.im) : ℝ) : ℂ)

theorem continuous_positivePeterssonQuarter :
    Continuous positivePeterssonQuarter := by
  exact Complex.continuous_ofReal.comp
    (Real.continuous_sqrt.comp
      (Real.continuous_sqrt.comp UpperHalfPlane.continuous_im))

theorem positivePeterssonQuarter_ne_zero (τ : UpperHalfPlane) :
    positivePeterssonQuarter τ ≠ 0 := by
  exact Complex.ofReal_ne_zero.mpr
    (Real.sqrt_pos.2 (Real.sqrt_pos.2 τ.im_pos)).ne'

@[simp]
theorem norm_positivePeterssonQuarter (τ : UpperHalfPlane) :
    ‖positivePeterssonQuarter τ‖ =
      Real.sqrt (Real.sqrt τ.im) := by
  simp [positivePeterssonQuarter, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _)]

/-- Exact conversion of the positive-convention Petersson density into an
ordinary pointwise square norm. -/
theorem norm_positivePeterssonQuarter_mul_sq
    (τ : UpperHalfPlane) (z : ℂ) :
    ‖positivePeterssonQuarter τ * z‖ ^ 2 =
      GenuineHalfWeightDensity.density τ z := by
  unfold GenuineHalfWeightDensity.density
  rw [norm_mul, norm_positivePeterssonQuarter, mul_pow,
    Real.sq_sqrt (Real.sqrt_nonneg τ.im)]

/-- Inverse-convention Petersson normalizer `y^(-1/4)`. -/
noncomputable def inversePeterssonQuarter
    (τ : UpperHalfPlane) : ℂ :=
  (positivePeterssonQuarter τ)⁻¹

theorem inversePeterssonQuarter_ne_zero (τ : UpperHalfPlane) :
    inversePeterssonQuarter τ ≠ 0 :=
  inv_ne_zero (positivePeterssonQuarter_ne_zero τ)

theorem continuous_inversePeterssonQuarter :
    Continuous inversePeterssonQuarter := by
  exact continuous_positivePeterssonQuarter.inv₀
    positivePeterssonQuarter_ne_zero

@[simp]
theorem norm_inversePeterssonQuarter (τ : UpperHalfPlane) :
    ‖inversePeterssonQuarter τ‖ =
      (Real.sqrt (Real.sqrt τ.im))⁻¹ := by
  rw [inversePeterssonQuarter, norm_inv,
    norm_positivePeterssonQuarter]

/-- Exact conversion of the inverse-convention Petersson density into an
ordinary pointwise square norm. -/
theorem norm_inversePeterssonQuarter_mul_sq
    (τ : UpperHalfPlane) (z : ℂ) :
    ‖inversePeterssonQuarter τ * z‖ ^ 2 =
      GenuineInverseHalfWeightAutomorphy.density τ z := by
  unfold GenuineInverseHalfWeightAutomorphy.density
  rw [norm_mul, norm_inversePeterssonQuarter, mul_pow, inv_pow,
    Real.sq_sqrt (Real.sqrt_nonneg τ.im)]

/-- Positive-convention normalized representative of a global hyperbolic
`AEEqFun` class.  Dependence is on the quotient object, not on a separately
chosen representative. -/
noncomputable def positiveNormalizedRepresentative
    (u : GenuineAEAutomorphicSections.Section) :
    UpperHalfPlane → ℂ :=
  fun τ => positivePeterssonQuarter τ * u τ

theorem positiveNormalizedRepresentative_aestronglyMeasurable
    (u : GenuineAEAutomorphicSections.Section) :
    AEStronglyMeasurable
      (positiveNormalizedRepresentative u) fundamentalMeasure := by
  exact continuous_positivePeterssonQuarter.aestronglyMeasurable.mul
    (u.aestronglyMeasurable.mono_measure
      fundamentalMeasure_le_hyperbolicMeasure)

/-- Inverse-convention normalized representative of a global hyperbolic
`AEEqFun` class. -/
noncomputable def inverseNormalizedRepresentative
    (u : GenuineInverseAEAutomorphicSections.Section) :
    UpperHalfPlane → ℂ :=
  fun τ => inversePeterssonQuarter τ * u τ

theorem inverseNormalizedRepresentative_aestronglyMeasurable
    (u : GenuineInverseAEAutomorphicSections.Section) :
    AEStronglyMeasurable
      (inverseNormalizedRepresentative u) fundamentalMeasure := by
  exact continuous_inversePeterssonQuarter.aestronglyMeasurable.mul
    (u.aestronglyMeasurable.mono_measure
      fundamentalMeasure_le_hyperbolicMeasure)

/-! #### Direct hyperbolic integrability of the standard theta section on `fd`

The argument is deliberately independent of automorphy.  The sharp Gaussian
majorant proved above is multiplied by the exact hyperbolic density and then
transported through the concrete complex-coordinate model of the upper half
plane. -/

/-- The height-only majorant obtained after multiplying
`1 + sqrt y` by the hyperbolic density `y⁻²`. -/
noncomputable def fdHeightMajorant (y : ℝ) : ℝ :=
  (1 + Real.sqrt y) * (1 / y) ^ 2

/-- A measurable rectangular carrier containing the complex image of `fd`. -/
def fdRectangle : Set (ℝ × ℝ) :=
  Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Ioi (1 / 2 : ℝ)

/-- The corresponding carrier in complex coordinates. -/
def fdComplexStrip : Set ℂ :=
  Complex.measurableEquivRealProd ⁻¹' fdRectangle

/-- The height majorant is exactly the sum of two already-certified cusp
power densities. -/
theorem fdHeightMajorant_eq_cuspPowerDensity_add
    {y : ℝ} (hy : 0 < y) :
    fdHeightMajorant y =
      CuspConvergence.cuspPowerDensity 0 y +
        CuspConvergence.cuspPowerDensity (1 / 2 : ℝ) y := by
  simp only [fdHeightMajorant, CuspConvergence.cuspPowerDensity,
    CuspConvergence.densityExponent]
  rw [Real.rpow_sub hy, Real.rpow_sub hy]
  simp only [Real.rpow_zero, Real.rpow_two, ← Real.sqrt_eq_rpow]
  field_simp [hy.ne'] <;> ring

/-- Integrability of the explicit height majorant on the vertical ray. -/
theorem integrableOn_fdHeightMajorant_Ioi :
    IntegrableOn fdHeightMajorant (Ioi (1 / 2 : ℝ)) := by
  have hzero := CuspConvergence.cuspPowerDensity_integrable
    (Y := (1 / 2 : ℝ)) (growth := 0) (by norm_num) (by norm_num)
  have hhalf := CuspConvergence.cuspPowerDensity_integrable
    (Y := (1 / 2 : ℝ)) (growth := (1 / 2 : ℝ))
      (by norm_num) (by norm_num)
  refine (hzero.add hhalf).congr_fun ?_ measurableSet_Ioi
  intro y hy
  have hy0 : 0 < y := lt_trans (by norm_num) hy
  exact (fdHeightMajorant_eq_cuspPowerDensity_add hy0).symm

/-- Product integrability on the fixed-width real rectangle. -/
theorem integrableOn_fdHeightMajorant_rectangle :
    IntegrableOn (fun p : ℝ × ℝ => fdHeightMajorant p.2)
      fdRectangle (volume.prod volume) := by
  rw [IntegrableOn, fdRectangle, ← Measure.prod_restrict]
  exact integrableOn_fdHeightMajorant_Ioi.comp_snd
    (volume.restrict (Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)))

/-- Transport of the rectangular calculation to complex Lebesgue measure. -/
theorem integrableOn_fdHeightMajorant_complexStrip :
    IntegrableOn (fun z : ℂ => fdHeightMajorant z.im)
      fdComplexStrip volume := by
  rw [← (Complex.volume_preserving_equiv_real_prod.symm _).integrableOn_comp_preimage
    (MeasurableEquiv.measurableEmbedding _)]
  simpa [fdComplexStrip, fdRectangle, Function.comp_def,
    Measure.volume_eq_prod] using integrableOn_fdHeightMajorant_rectangle

/-- The imaginary part on the standard modular domain is strictly larger than
the rational cutoff used in the rectangular majorant. -/
theorem one_half_lt_im_of_mem_fd {τ : UpperHalfPlane}
    (hτ : τ ∈ ModularGroup.fd) : (1 / 2 : ℝ) < τ.im := by
  have hsq := ModularGroup.three_le_four_mul_im_sq_of_mem_fd hτ
  nlinarith [τ.im_pos]

/-- The complex image of `fd` lies in the explicit rectangle. -/
theorem coe_fd_subset_fdComplexStrip :
    UpperHalfPlane.coe '' ModularGroup.fd ⊆ fdComplexStrip := by
  rintro z ⟨τ, hτ, rfl⟩
  change τ.re ∈ Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧
    τ.im ∈ Ioi (1 / 2 : ℝ)
  exact ⟨abs_le.mp hτ.2, one_half_lt_im_of_mem_fd hτ⟩

/-- Pulling complex volume back along the upper-half-plane embedding preserves
integrability of the height majorant on `fd`. -/
theorem integrableOn_fdHeightMajorant_fd_comap :
    IntegrableOn (fun τ : UpperHalfPlane => fdHeightMajorant τ.im)
      ModularGroup.fd (volume.comap UpperHalfPlane.coe) := by
  have hc : IntegrableOn (fun z : ℂ => fdHeightMajorant z.im)
      (UpperHalfPlane.coe '' ModularGroup.fd) volume :=
    integrableOn_fdHeightMajorant_complexStrip.mono_set
      coe_fd_subset_fdComplexStrip
  have h :=
    (UpperHalfPlane.measurableEmbedding_coe.integrableOn_iff_comap
      (μ := (volume : Measure ℂ))
      (s := UpperHalfPlane.coe '' ModularGroup.fd)
      (f := fun z : ℂ => fdHeightMajorant z.im)
      (Set.image_subset_range _ _)).1 hc
  rw [Set.preimage_image_eq _ UpperHalfPlane.coe_injective] at h
  have hfun :
      ((fun z : ℂ => fdHeightMajorant z.im) ∘ UpperHalfPlane.coe) =
        (fun x : UpperHalfPlane => fdHeightMajorant ((x : ℂ).im)) := by
    funext x
    rfl
  rw [hfun] at h
  exact h

/-- The height envelope `1 + sqrt y` is integrable on `fd` for hyperbolic
measure. -/
theorem integrableOn_one_add_sqrt_im_fd :
    IntegrableOn (fun τ : UpperHalfPlane => 1 + Real.sqrt τ.im)
      ModularGroup.fd hyperbolicMeasure := by
  have hd : Continuous (fun z : UpperHalfPlane =>
      (1 / NNReal.mk z.im z.im_pos.le : NNReal) ^ 2) := by
    refine .pow (.div₀ continuous_const ?_ ?_) _
    · exact UpperHalfPlane.continuous_im.subtype_mk _
    · exact fun z => NNReal.ne_iff.mp z.im_ne_zero
  rw [IntegrableOn, hyperbolicMeasure_def,
    MeasureTheory.restrict_withDensity ModularGroup.isClosed_fd.measurableSet,
    integrable_withDensity_iff_integrable_smul hd.measurable]
  change IntegrableOn
    (fun τ : UpperHalfPlane =>
      ((1 / NNReal.mk τ.im τ.im_pos.le : NNReal) ^ 2) •
        (1 + Real.sqrt τ.im))
    ModularGroup.fd (volume.comap UpperHalfPlane.coe)
  refine integrableOn_fdHeightMajorant_fd_comap.congr_fun ?_
    ModularGroup.isClosed_fd.measurableSet
  intro τ hτ
  change
    (1 + Real.sqrt τ.im) * (1 / τ.im) ^ 2 =
      (1 / τ.im) ^ 2 * (1 + Real.sqrt τ.im)
  ring

/-- A rational bound for the inverse square root of the height on `fd`. -/
theorem inv_sqrt_im_le_two_of_mem_fd {τ : UpperHalfPlane}
    (hτ : τ ∈ ModularGroup.fd) :
    (Real.sqrt τ.im)⁻¹ ≤ 2 := by
  have hroot : (1 / 2 : ℝ) < Real.sqrt τ.im := by
    have hsquare := Real.sq_sqrt τ.im_pos.le
    nlinarith [one_half_lt_im_of_mem_fd hτ, Real.sqrt_nonneg τ.im]
  have hrootPos := Real.sqrt_pos.2 τ.im_pos
  calc
    (Real.sqrt τ.im)⁻¹ = 1 * (Real.sqrt τ.im)⁻¹ :=
      (one_mul _).symm
    _ ≤ 2 := (mul_inv_le_iff₀ hrootPos).2 (by nlinarith)

/-- The sharp Gaussian theta estimate gives an explicit Petersson-density
majorant on the standard cell. -/
theorem positiveThetaDensity_le_nine_one_add_sqrt
    (τ : UpperHalfPlane) (hτ : τ ∈ ModularGroup.fd) :
    GenuineHalfWeightDensity.density τ (ConcreteUnaryTheta.theta τ) ≤
      9 * (1 + Real.sqrt τ.im) := by
  have hnorm : ‖ConcreteUnaryTheta.theta τ‖ ≤ 3 :=
    (ConcreteUnaryTheta.norm_theta_le_one_add_inv_sqrt_im τ).trans <| by
      linarith [inv_sqrt_im_le_two_of_mem_fd hτ]
  have hsquare : ‖ConcreteUnaryTheta.theta τ‖ ^ 2 ≤ 9 := by
    nlinarith [norm_nonneg (ConcreteUnaryTheta.theta τ)]
  unfold GenuineHalfWeightDensity.density
  calc
    Real.sqrt τ.im * ‖ConcreteUnaryTheta.theta τ‖ ^ 2
        ≤ Real.sqrt τ.im * 9 :=
      mul_le_mul_of_nonneg_left hsquare (Real.sqrt_nonneg _)
    _ ≤ 9 * (1 + Real.sqrt τ.im) := by
      nlinarith [Real.sqrt_nonneg τ.im]

/-- Strong measurability of the directly normalized concrete theta function. -/
theorem directPositiveTheta_aestronglyMeasurable_fd :
    AEStronglyMeasurable
      (fun τ : UpperHalfPlane =>
        positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ)
      (hyperbolicMeasure.restrict ModularGroup.fd) :=
  (continuous_positivePeterssonQuarter.mul
    GenuineAEAutomorphicSections.continuous_concreteTheta).aestronglyMeasurable

/-- Direct square-norm integrability of normalized theta on `fd`. -/
theorem integrableOn_directPositiveTheta_sq_fd :
    IntegrableOn
      (fun τ : UpperHalfPlane =>
        ‖positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ‖ ^ 2)
      ModularGroup.fd hyperbolicMeasure := by
  have hmajor : IntegrableOn
      (fun τ : UpperHalfPlane => 9 * (1 + Real.sqrt τ.im))
      ModularGroup.fd hyperbolicMeasure :=
    integrableOn_one_add_sqrt_im_fd.const_mul 9
  have hmeas : AEStronglyMeasurable
      (fun τ : UpperHalfPlane =>
        ‖positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ‖ ^ 2)
      (hyperbolicMeasure.restrict ModularGroup.fd) :=
    ((continuous_positivePeterssonQuarter.mul
      GenuineAEAutomorphicSections.continuous_concreteTheta).norm.pow 2).aestronglyMeasurable
  apply Integrable.mono' hmajor hmeas
  filter_upwards [self_mem_ae_restrict
    ModularGroup.isClosed_fd.measurableSet] with τ hτ
  have hbound := positiveThetaDensity_le_nine_one_add_sqrt τ hτ
  rw [← norm_positivePeterssonQuarter_mul_sq] at hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg
      (sq_nonneg ‖positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ‖)]
    using hbound

/-- Unconditional `L²` membership of directly normalized theta on the standard
cell. -/
theorem directPositiveTheta_memLp_fd :
    MemLp
      (fun τ : UpperHalfPlane =>
        positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ)
      2 (hyperbolicMeasure.restrict ModularGroup.fd) := by
  exact (memLp_two_iff_integrable_sq_norm
    directPositiveTheta_aestronglyMeasurable_fd).2
      integrableOn_directPositiveTheta_sq_fd

/-- The quotient representative of standard theta agrees with the direct
function after restriction to `fd`. -/
theorem positiveNormalized_standardThetaClass_aeEq_fd :
    positiveNormalizedRepresentative
        GenuineAEAutomorphicSections.standardThetaClass =ᵐ[
          hyperbolicMeasure.restrict ModularGroup.fd]
      (fun τ : UpperHalfPlane =>
        positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ) := by
  have htheta :
      (GenuineAEAutomorphicSections.standardThetaClass :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        ConcreteUnaryTheta.theta := by
    simpa only [GenuineAEAutomorphicSections.standardThetaClass] using
      (AEEqFun.coeFn_mk ConcreteUnaryTheta.theta
        GenuineAEAutomorphicSections.continuous_concreteTheta.aestronglyMeasurable)
  have hthetaFd := htheta.filter_mono
    (ae_mono (Measure.restrict_le_self :
      hyperbolicMeasure.restrict ModularGroup.fd ≤ hyperbolicMeasure))
  filter_upwards [hthetaFd] with τ hτ
  simp only [positiveNormalizedRepresentative, hτ]

/-- Quotient-class form of the standard-cell `L²` theorem. -/
theorem positiveNormalized_standardThetaClass_memLp_fd :
    MemLp
      (positiveNormalizedRepresentative
        GenuineAEAutomorphicSections.standardThetaClass)
      2 (hyperbolicMeasure.restrict ModularGroup.fd) :=
  MemLp.ae_eq positiveNormalized_standardThetaClass_aeEq_fd.symm
    directPositiveTheta_memLp_fd

/-! #### Measure-preserving transport from one standard cell to all six cells -/

/-- Every integral determinant-one modular matrix preserves hyperbolic measure,
not only matrices already packaged as elements of `Gamma(2)`. -/
theorem integralMatrixAction_measurePreserving
    (g : Gamma2SixCellPolygon.IntegralSpecialLinear) :
    MeasurePreserving (fun τ : UpperHalfPlane => g • τ)
      hyperbolicMeasure hyperbolicMeasure := by
  simpa only [hyperbolicMeasure, MulAction.compHom_smul_def] using
    (measurePreserving_smul
      ((Matrix.SpecialLinearGroup.mapGL
        (n := Fin 2) (R := ℤ) ℝ) g)
      (volume : Measure UpperHalfPlane))

/-- The same modular action is a measurable embedding. -/
theorem integralMatrixAction_measurableEmbedding
    (g : Gamma2SixCellPolygon.IntegralSpecialLinear) :
    MeasurableEmbedding (fun τ : UpperHalfPlane => g • τ) := by
  change MeasurableEmbedding
    ⇑(Homeomorph.smul
      ((Matrix.SpecialLinearGroup.mapGL
        (n := Fin 2) (R := ℤ) ℝ) g))
  exact
    (Homeomorph.smul
      ((Matrix.SpecialLinearGroup.mapGL
        (n := Fin 2) (R := ℤ) ℝ) g)).measurableEmbedding

/-- Pull an arbitrary real density back from a six-cell representative to the
standard modular domain. -/
noncomputable def cellPullback (ρ : UpperHalfPlane → ℝ)
    (r : Gamma2SixCellPolygon.Gamma2Rep) (z : UpperHalfPlane) : ℝ :=
  ρ ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • z)

/-- Exact change-of-variables equivalence between one closed six-cell and the
standard modular domain. -/
theorem integrableOn_closedCell_iff
    (ρ : UpperHalfPlane → ℝ) (r : Gamma2SixCellPolygon.Gamma2Rep) :
    IntegrableOn ρ (Gamma2SixCellPolygon.closedCell r) hyperbolicMeasure ↔
      IntegrableOn (cellPullback ρ r) ModularGroup.fd hyperbolicMeasure := by
  have h :=
    (integralMatrixAction_measurePreserving
      (Gamma2SixCellPolygon.repMatrix r)).integrableOn_comp_preimage
      (integralMatrixAction_measurableEmbedding
        (Gamma2SixCellPolygon.repMatrix r))
      (f := cellPullback ρ r) (s := ModularGroup.fd)
  simpa [Gamma2SixCellPolygon.closedCell, cellPullback,
    Function.comp_def, MulAction.compHom_smul_def] using h

/-- A pointwise pullback majorant on `fd` proves integrability on the
corresponding closed cell. -/
theorem integrableOn_closedCell_of_pullback_majorant
    (ρ : UpperHalfPlane → ℝ) (r : Gamma2SixCellPolygon.Gamma2Rep)
    (hρ : AEStronglyMeasurable ρ hyperbolicMeasure)
    (hρ0 : ∀ τ, 0 ≤ ρ τ) (M : UpperHalfPlane → ℝ)
    (hM : IntegrableOn M ModularGroup.fd hyperbolicMeasure)
    (hle : ∀ z ∈ ModularGroup.fd, cellPullback ρ r z ≤ M z) :
    IntegrableOn ρ (Gamma2SixCellPolygon.closedCell r)
      hyperbolicMeasure := by
  rw [integrableOn_closedCell_iff]
  apply Integrable.mono' hM
  · have hc := hρ.comp_measurePreserving
      (integralMatrixAction_measurePreserving
        (Gamma2SixCellPolygon.repMatrix r)⁻¹)
    have hc' :
        AEStronglyMeasurable (cellPullback ρ r) hyperbolicMeasure := by
      change AEStronglyMeasurable
        (fun x => ρ ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • x))
        hyperbolicMeasure
      exact hc
    exact hc'.mono_measure Measure.restrict_le_self
  · filter_upwards
      [self_mem_ae_restrict ModularGroup.isClosed_fd.measurableSet]
        with z hz
    have hpull0 : 0 ≤ cellPullback ρ r z := hρ0 _
    have hMz0 : 0 ≤ M z := hpull0.trans (hle z hz)
    simpa only [Real.norm_eq_abs, abs_of_nonneg hpull0,
      abs_of_nonneg hMz0] using hle z hz

/-- Integrability on the finite six-cell polygon is equivalent to
integrability on every labelled closed cell. -/
theorem integrableOn_fundamentalRegion_iff (ρ : UpperHalfPlane → ℝ) :
    IntegrableOn ρ fundamentalRegion hyperbolicMeasure ↔
      ∀ r : Gamma2SixCellPolygon.Gamma2Rep,
        IntegrableOn ρ (Gamma2SixCellPolygon.closedCell r)
          hyperbolicMeasure := by
  simpa only [fundamentalRegion, Gamma2SixCellPolygon.closedPolygon] using
    (integrableOn_finite_iUnion
      (f := ρ) (μ := hyperbolicMeasure)
      (t := Gamma2SixCellPolygon.closedCell))

/-- Unfolding the restricted fundamental measure is definitionally the same
as an `IntegrableOn` assertion on the polygon. -/
theorem integrable_fundamentalMeasure_iff (ρ : UpperHalfPlane → ℝ) :
    Integrable ρ fundamentalMeasure ↔
      IntegrableOn ρ fundamentalRegion hyperbolicMeasure := by
  rfl

/-- Simultaneous pullback majorants for the six labels prove integrability for
the restricted polygon measure. -/
theorem integrable_fundamentalMeasure_of_pullback_majorants
    (ρ : UpperHalfPlane → ℝ)
    (hρ : AEStronglyMeasurable ρ hyperbolicMeasure)
    (hρ0 : ∀ τ, 0 ≤ ρ τ)
    (M : Gamma2SixCellPolygon.Gamma2Rep → UpperHalfPlane → ℝ)
    (hM : ∀ r, IntegrableOn (M r) ModularGroup.fd hyperbolicMeasure)
    (hle : ∀ r z, z ∈ ModularGroup.fd →
      cellPullback ρ r z ≤ M r z) :
    Integrable ρ fundamentalMeasure := by
  rw [integrable_fundamentalMeasure_iff,
    integrableOn_fundamentalRegion_iff]
  intro r
  exact integrableOn_closedCell_of_pullback_majorant
    ρ r hρ hρ0 (M r) (hM r) (hle r)

/-- `L²` bridge: a square-norm pullback majorant on each standard cell gives
`MemLp` on the concrete six-cell fundamental measure. -/
theorem memLp_two_fundamentalMeasure_of_pullback_majorants
    (f : UpperHalfPlane → ℂ)
    (hf : AEStronglyMeasurable f hyperbolicMeasure)
    (M : Gamma2SixCellPolygon.Gamma2Rep → UpperHalfPlane → ℝ)
    (hM : ∀ r, IntegrableOn (M r) ModularGroup.fd hyperbolicMeasure)
    (hle : ∀ r z, z ∈ ModularGroup.fd →
      ‖f ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • z)‖ ^ 2 ≤ M r z) :
    MemLp f 2 fundamentalMeasure := by
  have hfFund := hf.mono_measure fundamentalMeasure_le_hyperbolicMeasure
  apply (memLp_two_iff_integrable_sq_norm hfFund).2
  apply integrable_fundamentalMeasure_of_pullback_majorants
    (ρ := fun τ => ‖f τ‖ ^ 2)
  · exact (hf.norm.aemeasurable.pow_const 2).aestronglyMeasurable
  · intro τ
    exact sq_nonneg ‖f τ‖
  · exact hM
  · intro r z hz
    simpa only [cellPullback] using hle r z hz

/-! #### Unconditional six-cell `L²` theorem for the standard unary theta -/

/-- The sharp Gaussian estimate converts the positive Petersson density at an
arbitrary upper-half-plane point into the exact square-root envelope needed for
cell transport. -/
theorem positiveThetaDensity_le_sqrt_envelope (τ : UpperHalfPlane) :
    GenuineHalfWeightDensity.density τ (ConcreteUnaryTheta.theta τ) ≤
      Real.sqrt τ.im + 2 + (Real.sqrt τ.im)⁻¹ := by
  have hs : 0 < Real.sqrt τ.im := Real.sqrt_pos.2 τ.im_pos
  have hnorm := ConcreteUnaryTheta.norm_theta_le_one_add_inv_sqrt_im τ
  have hright : 0 ≤ 1 + (Real.sqrt τ.im)⁻¹ := by positivity
  have hsquare :
      ‖ConcreteUnaryTheta.theta τ‖ ^ 2 ≤
        (1 + (Real.sqrt τ.im)⁻¹) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) hright).2 hnorm
  unfold GenuineHalfWeightDensity.density
  calc
    Real.sqrt τ.im * ‖ConcreteUnaryTheta.theta τ‖ ^ 2 ≤
        Real.sqrt τ.im * (1 + (Real.sqrt τ.im)⁻¹) ^ 2 :=
      mul_le_mul_of_nonneg_left hsquare hs.le
    _ = Real.sqrt τ.im + 2 + (Real.sqrt τ.im)⁻¹ := by
      field_simp [hs.ne'] <;> ring

/-- Every inverse six-cell pullback of the concrete theta density is bounded by
the same integrable standard-domain envelope. -/
theorem positiveThetaDensity_pullback_le_on_fd
    (r : Gamma2SixCellPolygon.Gamma2Rep) {z : UpperHalfPlane}
    (hz : z ∈ ModularGroup.fd) :
    GenuineHalfWeightDensity.density
        ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • z)
        (ConcreteUnaryTheta.theta
          ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • z)) ≤
      7 * (1 + Real.sqrt z.im) := by
  exact (positiveThetaDensity_le_sqrt_envelope
    ((Gamma2SixCellPolygon.repMatrix r)⁻¹ • z)).trans <| by
      simpa only [Gamma2SixCellPolygon.pullbackHeight] using
        Gamma2SixCellPolygon.pullbackHeight_sqrt_envelope_on_fd r hz

/-- A single labelled family of majorants for all six cells. -/
noncomputable def standardThetaCellMajorant
    (_ : Gamma2SixCellPolygon.Gamma2Rep)
    (z : UpperHalfPlane) : ℝ :=
  7 * (1 + Real.sqrt z.im)

/-- The cell majorant is integrable for every representative label. -/
theorem integrableOn_standardThetaCellMajorant_fd
    (r : Gamma2SixCellPolygon.Gamma2Rep) :
    IntegrableOn (standardThetaCellMajorant r) ModularGroup.fd
      hyperbolicMeasure := by
  exact integrableOn_one_add_sqrt_im_fd.const_mul 7

/-- Direct normalized theta belongs to `L²` on the full closed six-cell
polygon.  No cusp transformation formula is assumed: the universal Gaussian
bound and the exact inverse-cell height estimates suffice. -/
theorem directPositiveTheta_memLp_fundamentalMeasure :
    MemLp
      (fun τ : UpperHalfPlane =>
        positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ)
      2 fundamentalMeasure := by
  apply memLp_two_fundamentalMeasure_of_pullback_majorants
    (f := fun τ : UpperHalfPlane =>
      positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ)
    (M := standardThetaCellMajorant)
  · exact (continuous_positivePeterssonQuarter.mul
      GenuineAEAutomorphicSections.continuous_concreteTheta).aestronglyMeasurable
  · exact integrableOn_standardThetaCellMajorant_fd
  · intro r z hz
    rw [norm_positivePeterssonQuarter_mul_sq]
    simpa only [standardThetaCellMajorant] using
      positiveThetaDensity_pullback_le_on_fd r hz

/-- The quotient representative of standard theta agrees with the direct
normalized function on the full restricted polygon measure. -/
theorem positiveNormalized_standardThetaClass_aeEq_fundamentalMeasure :
    positiveNormalizedRepresentative
        GenuineAEAutomorphicSections.standardThetaClass =ᵐ[fundamentalMeasure]
      (fun τ : UpperHalfPlane =>
        positivePeterssonQuarter τ * ConcreteUnaryTheta.theta τ) := by
  have htheta :
      (GenuineAEAutomorphicSections.standardThetaClass :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        ConcreteUnaryTheta.theta := by
    simpa only [GenuineAEAutomorphicSections.standardThetaClass] using
      (AEEqFun.coeFn_mk ConcreteUnaryTheta.theta
        GenuineAEAutomorphicSections.continuous_concreteTheta.aestronglyMeasurable)
  filter_upwards [eventually_of_hyperbolic_eventually htheta] with τ hτ
  simp only [positiveNormalizedRepresentative, hτ]

/-- Unconditional quotient-class `L²` theorem for standard theta on the
concrete six-cell fundamental measure. -/
theorem positiveNormalized_standardThetaClass_memLp_fundamentalMeasure :
    MemLp
      (positiveNormalizedRepresentative
        GenuineAEAutomorphicSections.standardThetaClass)
      2 fundamentalMeasure :=
  MemLp.ae_eq
    positiveNormalized_standardThetaClass_aeEq_fundamentalMeasure.symm
    directPositiveTheta_memLp_fundamentalMeasure

theorem positiveNormalizedRepresentative_zero :
    positiveNormalizedRepresentative
        (0 : GenuineAEAutomorphicSections.Section) =ᵐ[fundamentalMeasure]
      0 := by
  have hzero :
      ((0 : GenuineAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure] 0 :=
    AEEqFun.coeFn_zero
  filter_upwards [eventually_of_hyperbolic_eventually hzero] with τ hτ
  simp [positiveNormalizedRepresentative, hτ]

theorem positiveNormalizedRepresentative_add
    (u v : GenuineAEAutomorphicSections.Section) :
    positiveNormalizedRepresentative (u + v) =ᵐ[fundamentalMeasure]
      positiveNormalizedRepresentative u +
        positiveNormalizedRepresentative v := by
  have hadd :
      ((u + v : GenuineAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        (u : UpperHalfPlane → ℂ) + (v : UpperHalfPlane → ℂ) :=
    AEEqFun.coeFn_add u v
  filter_upwards [eventually_of_hyperbolic_eventually hadd] with τ hτ
  simp only [positiveNormalizedRepresentative, Pi.add_apply, hτ, mul_add]

theorem positiveNormalizedRepresentative_smul
    (c : ℂ) (u : GenuineAEAutomorphicSections.Section) :
    positiveNormalizedRepresentative (c • u) =ᵐ[fundamentalMeasure]
      c • positiveNormalizedRepresentative u := by
  have hsmul :
      ((c • u : GenuineAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        c • (u : UpperHalfPlane → ℂ) :=
    AEEqFun.coeFn_smul c u
  filter_upwards [eventually_of_hyperbolic_eventually hsmul] with τ hτ
  change positivePeterssonQuarter τ * (c • u :
      GenuineAEAutomorphicSections.Section) τ =
    c * (positivePeterssonQuarter τ * u τ)
  rw [hτ]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

theorem inverseNormalizedRepresentative_zero :
    inverseNormalizedRepresentative
        (0 : GenuineInverseAEAutomorphicSections.Section) =ᵐ[fundamentalMeasure]
      0 := by
  have hzero :
      ((0 : GenuineInverseAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure] 0 :=
    AEEqFun.coeFn_zero
  filter_upwards [eventually_of_hyperbolic_eventually hzero] with τ hτ
  simp [inverseNormalizedRepresentative, hτ]

theorem inverseNormalizedRepresentative_add
    (u v : GenuineInverseAEAutomorphicSections.Section) :
    inverseNormalizedRepresentative (u + v) =ᵐ[fundamentalMeasure]
      inverseNormalizedRepresentative u +
        inverseNormalizedRepresentative v := by
  have hadd :
      ((u + v : GenuineInverseAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        (u : UpperHalfPlane → ℂ) + (v : UpperHalfPlane → ℂ) :=
    AEEqFun.coeFn_add u v
  filter_upwards [eventually_of_hyperbolic_eventually hadd] with τ hτ
  simp only [inverseNormalizedRepresentative, Pi.add_apply, hτ, mul_add]

theorem inverseNormalizedRepresentative_smul
    (c : ℂ) (u : GenuineInverseAEAutomorphicSections.Section) :
    inverseNormalizedRepresentative (c • u) =ᵐ[fundamentalMeasure]
      c • inverseNormalizedRepresentative u := by
  have hsmul :
      ((c • u : GenuineInverseAEAutomorphicSections.Section) :
          UpperHalfPlane → ℂ) =ᵐ[hyperbolicMeasure]
        c • (u : UpperHalfPlane → ℂ) :=
    AEEqFun.coeFn_smul c u
  filter_upwards [eventually_of_hyperbolic_eventually hsmul] with τ hτ
  change inversePeterssonQuarter τ * (c • u :
      GenuineInverseAEAutomorphicSections.Section) τ =
    c * (inversePeterssonQuarter τ * u τ)
  rw [hτ]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- Square-integrability over the explicit polygon in the positive
convention. -/
def IsPositiveFundamentalL2
    (u : GenuineAEAutomorphicSections.Section) : Prop :=
  MemLp (positiveNormalizedRepresentative u) 2
    fundamentalMeasure

/-- Square-integrability over the explicit polygon in the inverse
convention. -/
def IsInverseFundamentalL2
    (u : GenuineInverseAEAutomorphicSections.Section) : Prop :=
  MemLp (inverseNormalizedRepresentative u) 2
    fundamentalMeasure

/-- The concrete standard theta class satisfies the positive weighted `L²`
condition on the full six-cell polygon. -/
theorem standardThetaClass_isPositiveFundamentalL2 :
    IsPositiveFundamentalL2
      GenuineAEAutomorphicSections.standardThetaClass :=
  positiveNormalized_standardThetaClass_memLp_fundamentalMeasure

@[simp]
theorem isPositiveFundamentalL2_zero :
    IsPositiveFundamentalL2
      (0 : GenuineAEAutomorphicSections.Section) := by
  exact MemLp.ae_eq positiveNormalizedRepresentative_zero.symm MemLp.zero

theorem IsPositiveFundamentalL2.add
    {u v : GenuineAEAutomorphicSections.Section}
    (hu : IsPositiveFundamentalL2 u)
    (hv : IsPositiveFundamentalL2 v) :
    IsPositiveFundamentalL2 (u + v) :=
  MemLp.ae_eq (positiveNormalizedRepresentative_add u v).symm
    (MemLp.add hu hv)

theorem IsPositiveFundamentalL2.const_smul
    {u : GenuineAEAutomorphicSections.Section}
    (hu : IsPositiveFundamentalL2 u) (c : ℂ) :
    IsPositiveFundamentalL2 (c • u) :=
  MemLp.ae_eq (positiveNormalizedRepresentative_smul c u).symm
    (MemLp.const_smul hu c)

@[simp]
theorem isInverseFundamentalL2_zero :
    IsInverseFundamentalL2
      (0 : GenuineInverseAEAutomorphicSections.Section) := by
  exact MemLp.ae_eq inverseNormalizedRepresentative_zero.symm MemLp.zero

theorem IsInverseFundamentalL2.add
    {u v : GenuineInverseAEAutomorphicSections.Section}
    (hu : IsInverseFundamentalL2 u)
    (hv : IsInverseFundamentalL2 v) :
    IsInverseFundamentalL2 (u + v) :=
  MemLp.ae_eq (inverseNormalizedRepresentative_add u v).symm
    (MemLp.add hu hv)

theorem IsInverseFundamentalL2.const_smul
    {u : GenuineInverseAEAutomorphicSections.Section}
    (hu : IsInverseFundamentalL2 u) (c : ℂ) :
    IsInverseFundamentalL2 (c • u) :=
  MemLp.ae_eq (inverseNormalizedRepresentative_smul c u).symm
    (MemLp.const_smul hu c)

/-- Actual complex-linear carrier of positive-weight automorphic polygon-`L²`
classes. -/
def positiveAutomorphicL2Submodule
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ GenuineAEAutomorphicSections.Section where
  carrier := {u |
    GenuineAEAutomorphicSections.IsAutomorphicClass ν u ∧
      IsPositiveFundamentalL2 u}
  zero_mem' :=
    ⟨GenuineAEAutomorphicSections.isAutomorphicClass_zero ν,
      isPositiveFundamentalL2_zero⟩
  add_mem' := fun hu hv => ⟨hu.1.add hv.1, hu.2.add hv.2⟩
  smul_mem' := fun c _ hu =>
    ⟨hu.1.smul c, hu.2.const_smul c⟩

@[simp]
theorem mem_positiveAutomorphicL2Submodule
    (ν : GenuineHalfWeightAutomorphy.Multiplier)
    (u : GenuineAEAutomorphicSections.Section) :
    u ∈ positiveAutomorphicL2Submodule ν ↔
      GenuineAEAutomorphicSections.IsAutomorphicClass ν u ∧
        IsPositiveFundamentalL2 u :=
  Iff.rfl

/-- Standard theta is an actual member of the positive genuine automorphic
weighted-`L²` submodule, with both automorphy and six-cell integrability proved. -/
theorem standardThetaClass_mem_positiveAutomorphicL2Submodule :
    GenuineAEAutomorphicSections.standardThetaClass ∈
      positiveAutomorphicL2Submodule
        GenuineGlobalThetaMultiplier.standardThetaMultiplier := by
  exact (mem_positiveAutomorphicL2Submodule _ _).2
    ⟨GenuineAEAutomorphicSections.standardThetaClass_isAutomorphic,
      standardThetaClass_isPositiveFundamentalL2⟩

/-- The packaged positive automorphic weighted-`L²` standard theta section. -/
noncomputable def standardThetaAutomorphicL2Section :
    ↥(positiveAutomorphicL2Submodule
      GenuineGlobalThetaMultiplier.standardThetaMultiplier) :=
  ⟨GenuineAEAutomorphicSections.standardThetaClass,
    standardThetaClass_mem_positiveAutomorphicL2Submodule⟩

/-- Actual complex-linear carrier of inverse-weight automorphic polygon-`L²`
classes. -/
def inverseAutomorphicL2Submodule
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ GenuineInverseAEAutomorphicSections.Section where
  carrier := {u |
    GenuineInverseAEAutomorphicSections.IsAutomorphicClass ν u ∧
      IsInverseFundamentalL2 u}
  zero_mem' :=
    ⟨GenuineInverseAEAutomorphicSections.isAutomorphicClass_zero ν,
      isInverseFundamentalL2_zero⟩
  add_mem' := fun hu hv => ⟨hu.1.add hv.1, hu.2.add hv.2⟩
  smul_mem' := fun c _ hu =>
    ⟨hu.1.smul c, hu.2.const_smul c⟩

@[simp]
theorem mem_inverseAutomorphicL2Submodule
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier)
    (u : GenuineInverseAEAutomorphicSections.Section) :
    u ∈ inverseAutomorphicL2Submodule ν ↔
      GenuineInverseAEAutomorphicSections.IsAutomorphicClass ν u ∧
        IsInverseFundamentalL2 u :=
  Iff.rfl

theorem positiveAutomorphicL2Submodule_eq_bot_of_bad_central_phase
    (ν : GenuineHalfWeightAutomorphy.Multiplier)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ -Complex.I) :
    positiveAutomorphicL2Submodule ν = ⊥ := by
  apply le_antisymm
  · intro u hu
    change u = 0
    exact
      GenuineAEAutomorphicSections.IsAutomorphicClass.eq_zero_of_bad_central_phase
        hu.1 hν
  · exact bot_le

theorem inverseAutomorphicL2Submodule_eq_bot_of_bad_central_phase
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier)
    (hν :
      (ν ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ Complex.I) :
    inverseAutomorphicL2Submodule ν = ⊥ := by
  apply le_antisymm
  · intro u hu
    change u = 0
    exact
      GenuineInverseAEAutomorphicSections.IsAutomorphicClass.eq_zero_of_bad_central_phase
        hu.1 hν
  · exact bot_le

/-- The raw trivial character cannot supply a positive-half-weight `L²`
sector. -/
theorem positiveAutomorphicL2Submodule_one_eq_bot :
    positiveAutomorphicL2Submodule
      (1 : GenuineHalfWeightAutomorphy.Multiplier) = ⊥ :=
  positiveAutomorphicL2Submodule_eq_bot_of_bad_central_phase 1
    GenuineHalfWeightAutomorphy.one_multiplier_bad_central_phase

theorem standardThetaMultiplier_ne_inverseCentralPhase :
    (GenuineGlobalThetaMultiplier.standardThetaMultiplier
        ThetaGeneratorLift.centralNegOneLift : ℂ) ≠ Complex.I := by
  rw [GenuineGlobalThetaMultiplier.standardThetaMultiplier_central_value]
  intro h
  have him := congrArg Complex.im h
  norm_num at him

/-- Reusing the positive theta multiplier with the PDF's inverse-square-root
law gives only the zero sector; the two conventions require opposite central
phases. -/
theorem inverseStandardThetaAutomorphicL2Submodule_eq_bot :
    inverseAutomorphicL2Submodule
      GenuineGlobalThetaMultiplier.standardThetaMultiplier = ⊥ :=
  inverseAutomorphicL2Submodule_eq_bot_of_bad_central_phase
    GenuineGlobalThetaMultiplier.standardThetaMultiplier
    standardThetaMultiplier_ne_inverseCentralPhase

/-- Realization of a positive-convention class in the concrete restricted
`L²` carrier. -/
noncomputable def positiveToLp
    (u : GenuineAEAutomorphicSections.Section)
    (hu : IsPositiveFundamentalL2 u) : PositiveL2Carrier :=
  MemLp.toLp (positiveNormalizedRepresentative u) hu

/-- Realization of an inverse-convention class in the same concrete restricted
`L²` carrier. -/
noncomputable def inverseToLp
    (u : GenuineInverseAEAutomorphicSections.Section)
    (hu : IsInverseFundamentalL2 u) : InverseL2Carrier :=
  MemLp.toLp (inverseNormalizedRepresentative u) hu

theorem coeFn_positiveToLp
    (u : GenuineAEAutomorphicSections.Section)
    (hu : IsPositiveFundamentalL2 u) :
    (positiveToLp u hu : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
      positiveNormalizedRepresentative u := by
  simpa only [positiveToLp] using MemLp.coeFn_toLp hu

theorem coeFn_inverseToLp
    (u : GenuineInverseAEAutomorphicSections.Section)
    (hu : IsInverseFundamentalL2 u) :
    (inverseToLp u hu : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
      inverseNormalizedRepresentative u := by
  simpa only [inverseToLp] using MemLp.coeFn_toLp hu

@[simp]
theorem norm_positiveToLp
    (u : GenuineAEAutomorphicSections.Section)
    (hu : IsPositiveFundamentalL2 u) :
    ‖positiveToLp u hu‖ =
      ENNReal.toReal
        (eLpNorm (positiveNormalizedRepresentative u) 2
          fundamentalMeasure) := by
  simpa only [positiveToLp] using
    (MeasureTheory.Lp.norm_toLp
      (positiveNormalizedRepresentative u) hu)

@[simp]
theorem norm_inverseToLp
    (u : GenuineInverseAEAutomorphicSections.Section)
    (hu : IsInverseFundamentalL2 u) :
    ‖inverseToLp u hu‖ =
      ENNReal.toReal
        (eLpNorm (inverseNormalizedRepresentative u) 2
          fundamentalMeasure) := by
  simpa only [inverseToLp] using
    (MeasureTheory.Lp.norm_toLp
      (inverseNormalizedRepresentative u) hu)

theorem positiveToLp_proof_irrel
    (u : GenuineAEAutomorphicSections.Section)
    (h₁ h₂ : IsPositiveFundamentalL2 u) :
    positiveToLp u h₁ = positiveToLp u h₂ := by
  simpa only [positiveToLp] using
    (MemLp.toLp_congr h₁ h₂ Filter.EventuallyEq.rfl)

theorem inverseToLp_proof_irrel
    (u : GenuineInverseAEAutomorphicSections.Section)
    (h₁ h₂ : IsInverseFundamentalL2 u) :
    inverseToLp u h₁ = inverseToLp u h₂ := by
  simpa only [inverseToLp] using
    (MemLp.toLp_congr h₁ h₂ Filter.EventuallyEq.rfl)

/-- Linear realization of positive-weight automorphic `L²` classes in the
restricted polygon carrier. -/
noncomputable def positiveRealizationLinear
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    ↥(positiveAutomorphicL2Submodule ν) →ₗ[ℂ] PositiveL2Carrier where
  toFun u := positiveToLp u.1 u.2.2
  map_add' u v := by
    change
      MemLp.toLp (positiveNormalizedRepresentative (u.1 + v.1))
          (u + v).2.2 =
        MemLp.toLp (positiveNormalizedRepresentative u.1) u.2.2 +
          MemLp.toLp (positiveNormalizedRepresentative v.1) v.2.2
    exact
      (MemLp.toLp_congr (u + v).2.2 (MeasureTheory.MemLp.add u.2.2 v.2.2)
        (positiveNormalizedRepresentative_add u.1 v.1)).trans
        (MemLp.toLp_add u.2.2 v.2.2)
  map_smul' c u := by
    change
      MemLp.toLp (positiveNormalizedRepresentative (c • u.1))
          (c • u).2.2 =
        c • MemLp.toLp (positiveNormalizedRepresentative u.1) u.2.2
    exact
      (MemLp.toLp_congr (c • u).2.2 (MeasureTheory.MemLp.const_smul u.2.2 c)
        (positiveNormalizedRepresentative_smul c u.1)).trans
        (MemLp.toLp_const_smul c u.2.2)

/-- Linear realization in the inverse-half-weight convention. -/
noncomputable def inverseRealizationLinear
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    ↥(inverseAutomorphicL2Submodule ν) →ₗ[ℂ] InverseL2Carrier where
  toFun u := inverseToLp u.1 u.2.2
  map_add' u v := by
    change
      MemLp.toLp (inverseNormalizedRepresentative (u.1 + v.1))
          (u + v).2.2 =
        MemLp.toLp (inverseNormalizedRepresentative u.1) u.2.2 +
          MemLp.toLp (inverseNormalizedRepresentative v.1) v.2.2
    exact
      (MemLp.toLp_congr (u + v).2.2 (MeasureTheory.MemLp.add u.2.2 v.2.2)
        (inverseNormalizedRepresentative_add u.1 v.1)).trans
        (MemLp.toLp_add u.2.2 v.2.2)
  map_smul' c u := by
    change
      MemLp.toLp (inverseNormalizedRepresentative (c • u.1))
          (c • u).2.2 =
        c • MemLp.toLp (inverseNormalizedRepresentative u.1) u.2.2
    exact
      (MemLp.toLp_congr (c • u).2.2 (MeasureTheory.MemLp.const_smul u.2.2 c)
        (inverseNormalizedRepresentative_smul c u.1)).trans
        (MemLp.toLp_const_smul c u.2.2)

/-- Algebraic image of the positive automorphic realization. -/
def positiveL2Range
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ PositiveL2Carrier :=
  LinearMap.range (positiveRealizationLinear ν)

/-- Algebraic image of the inverse automorphic realization. -/
def inverseL2Range
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ InverseL2Carrier :=
  LinearMap.range (inverseRealizationLinear ν)

/-- Complete positive-weight realization space: the Hilbert closure of the
actual linear range, not an unproved closed-range assertion. -/
def PositiveClosedL2Space
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ PositiveL2Carrier :=
  (positiveL2Range ν).topologicalClosure

/-- Complete inverse-weight realization space. -/
def InverseClosedL2Space
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    Submodule ℂ InverseL2Carrier :=
  (inverseL2Range ν).topologicalClosure

theorem isClosed_positiveClosedL2Space
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    IsClosed (PositiveClosedL2Space ν : Set PositiveL2Carrier) :=
  (positiveL2Range ν).isClosed_topologicalClosure

theorem isClosed_inverseClosedL2Space
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    IsClosed (InverseClosedL2Space ν : Set InverseL2Carrier) :=
  (inverseL2Range ν).isClosed_topologicalClosure

theorem isComplete_positiveClosedL2Space
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    IsComplete (PositiveClosedL2Space ν : Set PositiveL2Carrier) :=
  (isClosed_positiveClosedL2Space ν).isComplete

theorem isComplete_inverseClosedL2Space
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    IsComplete (InverseClosedL2Space ν : Set InverseL2Carrier) :=
  (isClosed_inverseClosedL2Space ν).isComplete

/-- Canonical continuous inclusion of the algebraic positive range into its
Hilbert closure. -/
noncomputable def positiveRangeToClosedL2
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    positiveL2Range ν →L[ℂ] PositiveClosedL2Space ν :=
  (positiveL2Range ν).subtypeL.codRestrict
    (PositiveClosedL2Space ν)
    (fun u => (positiveL2Range ν).le_topologicalClosure u.property)

/-- Canonical continuous inclusion of the algebraic inverse range into its
Hilbert closure. -/
noncomputable def inverseRangeToClosedL2
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    inverseL2Range ν →L[ℂ] InverseClosedL2Space ν :=
  (inverseL2Range ν).subtypeL.codRestrict
    (InverseClosedL2Space ν)
    (fun u => (inverseL2Range ν).le_topologicalClosure u.property)

theorem denseRange_positiveRangeToClosedL2
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    DenseRange (positiveRangeToClosedL2 ν) := by
  change DenseRange
    (Set.inclusion (positiveL2Range ν).le_topologicalClosure)
  rw [denseRange_inclusion_iff]
  · intro x hx
    exact hx
  · intro x hx
    exact (positiveL2Range ν).le_topologicalClosure hx

theorem denseRange_inverseRangeToClosedL2
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    DenseRange (inverseRangeToClosedL2 ν) := by
  change DenseRange
    (Set.inclusion (inverseL2Range ν).le_topologicalClosure)
  rw [denseRange_inclusion_iff]
  · intro x hx
    exact hx
  · intro x hx
    exact (inverseL2Range ν).le_topologicalClosure hx

/-- Restriction to the closed six-cell polygon is faithful on global positive
automorphic classes.  Closed-polygon orbit coverage and countability of the
concrete matrix group propagate restricted a.e. equality globally. -/
theorem positiveRealizationLinear_injective
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    Function.Injective (positiveRealizationLinear ν) := by
  intro u v huv
  apply Subtype.ext
  apply AEEqFun.ext
  have hnormalized :
      positiveNormalizedRepresentative u.1 =ᵐ[fundamentalMeasure]
        positiveNormalizedRepresentative v.1 := by
    apply (MemLp.toLp_eq_toLp_iff u.2.2 v.2.2).1
    change positiveToLp u.1 u.2.2 = positiveToLp v.1 v.2.2 at huv
    simpa only [positiveToLp] using huv
  have hfund :
      (u.1 : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
        (v.1 : UpperHalfPlane → ℂ) := by
    filter_upwards [hnormalized] with τ hτ
    change positivePeterssonQuarter τ * u.1 τ =
      positivePeterssonQuarter τ * v.1 τ at hτ
    exact mul_left_cancel₀ (positivePeterssonQuarter_ne_zero τ) hτ
  apply global_aeEq_of_fundamental_aeEq
    (j := fun γ τ =>
      GenuineHalfWeightAutomorphy.factor ν
        (GenuineGlobalThetaMultiplier.chosenGenuineLift γ) τ)
  · intro γ τ
    exact GenuineHalfWeightAutomorphy.factor_ne_zero ν
      (GenuineGlobalThetaMultiplier.chosenGenuineLift γ) τ
  · intro γ
    have huRep :=
      (GenuineAEAutomorphicSections.isAutomorphicClass_iff_representative
        ν u.1).1 u.2.1
    simpa only [GenuineGlobalThetaMultiplier.chosenGenuineLift_matrix] using
      huRep (GenuineGlobalThetaMultiplier.chosenGenuineLift γ)
  · intro γ
    have hvRep :=
      (GenuineAEAutomorphicSections.isAutomorphicClass_iff_representative
        ν v.1).1 v.2.1
    simpa only [GenuineGlobalThetaMultiplier.chosenGenuineLift_matrix] using
      hvRep (GenuineGlobalThetaMultiplier.chosenGenuineLift γ)
  · exact hfund

/-- The inverse-half-weight polygon realization is faithful for the same
reason, using the inverse cocycle's proved nonvanishing. -/
theorem inverseRealizationLinear_injective
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    Function.Injective (inverseRealizationLinear ν) := by
  intro u v huv
  apply Subtype.ext
  apply AEEqFun.ext
  have hnormalized :
      inverseNormalizedRepresentative u.1 =ᵐ[fundamentalMeasure]
        inverseNormalizedRepresentative v.1 := by
    apply (MemLp.toLp_eq_toLp_iff u.2.2 v.2.2).1
    change inverseToLp u.1 u.2.2 = inverseToLp v.1 v.2.2 at huv
    simpa only [inverseToLp] using huv
  have hfund :
      (u.1 : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
        (v.1 : UpperHalfPlane → ℂ) := by
    filter_upwards [hnormalized] with τ hτ
    change inversePeterssonQuarter τ * u.1 τ =
      inversePeterssonQuarter τ * v.1 τ at hτ
    exact mul_left_cancel₀ (inversePeterssonQuarter_ne_zero τ) hτ
  apply global_aeEq_of_fundamental_aeEq
    (j := fun γ τ =>
      GenuineInverseHalfWeightAutomorphy.factor ν
        (GenuineGlobalThetaMultiplier.chosenGenuineLift γ) τ)
  · intro γ τ
    exact GenuineInverseHalfWeightAutomorphy.factor_ne_zero ν
      (GenuineGlobalThetaMultiplier.chosenGenuineLift γ) τ
  · intro γ
    have huRep :=
      (GenuineInverseAEAutomorphicSections.isAutomorphicClass_iff_representative
        ν u.1).1 u.2.1
    simpa only [GenuineGlobalThetaMultiplier.chosenGenuineLift_matrix] using
      huRep (GenuineGlobalThetaMultiplier.chosenGenuineLift γ)
  · intro γ
    have hvRep :=
      (GenuineInverseAEAutomorphicSections.isAutomorphicClass_iff_representative
        ν v.1).1 v.2.1
    simpa only [GenuineGlobalThetaMultiplier.chosenGenuineLift_matrix] using
      hvRep (GenuineGlobalThetaMultiplier.chosenGenuineLift γ)
  · exact hfund

/-- Representative-independent positive-half-weight automorphy together with
its actual restricted weighted-`L²` certificate. -/
structure PositiveAutomorphicL2Section
    (ν : GenuineHalfWeightAutomorphy.Multiplier) where
  «section» : GenuineAEAutomorphicSections.Section
  automorphic :
    GenuineAEAutomorphicSections.IsAutomorphicClass ν «section»
  squareIntegrable : IsPositiveFundamentalL2 «section»

/-- Representative-independent inverse-half-weight automorphy together with
its actual restricted weighted-`L²` certificate. -/
structure InverseAutomorphicL2Section
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) where
  «section» : GenuineInverseAEAutomorphicSections.Section
  automorphic :
    GenuineInverseAEAutomorphicSections.IsAutomorphicClass ν «section»
  squareIntegrable : IsInverseFundamentalL2 «section»

/-- The original proof record and the new positive linear carrier have the
same underlying mathematical data. -/
def positiveAutomorphicL2SectionEquiv
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    PositiveAutomorphicL2Section ν ≃
      ↥(positiveAutomorphicL2Submodule ν) where
  toFun u := ⟨u.«section», u.automorphic, u.squareIntegrable⟩
  invFun u := ⟨u.1, u.2.1, u.2.2⟩
  left_inv u := by
    cases u
    rfl
  right_inv u := by
    cases u
    rfl

/-- Inverse-convention record/submodule identification. -/
def inverseAutomorphicL2SectionEquiv
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    InverseAutomorphicL2Section ν ≃
      ↥(inverseAutomorphicL2Submodule ν) where
  toFun u := ⟨u.«section», u.automorphic, u.squareIntegrable⟩
  invFun u := ⟨u.1, u.2.1, u.2.2⟩
  left_inv u := by
    cases u
    rfl
  right_inv u := by
    cases u
    rfl

namespace PositiveAutomorphicL2Section

noncomputable def realization
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    (u : PositiveAutomorphicL2Section ν) : PositiveL2Carrier :=
  positiveToLp u.«section» u.squareIntegrable

@[simp]
theorem realization_eq_linear
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    (u : PositiveAutomorphicL2Section ν) :
    u.realization =
      positiveRealizationLinear ν
        (positiveAutomorphicL2SectionEquiv ν u) :=
  rfl

theorem realization_injective
    (ν : GenuineHalfWeightAutomorphy.Multiplier) :
    Function.Injective
      (realization : PositiveAutomorphicL2Section ν → PositiveL2Carrier) := by
  intro u v huv
  apply (positiveAutomorphicL2SectionEquiv ν).injective
  apply positiveRealizationLinear_injective ν
  simpa only [realization_eq_linear] using huv

theorem coeFn_realization
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    (u : PositiveAutomorphicL2Section ν) :
    (u.realization : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
      positiveNormalizedRepresentative u.«section» := by
  simpa only [realization] using
    coeFn_positiveToLp u.«section» u.squareIntegrable

@[simp]
theorem norm_realization
    {ν : GenuineHalfWeightAutomorphy.Multiplier}
    (u : PositiveAutomorphicL2Section ν) :
    ‖u.realization‖ =
      ENNReal.toReal
        (eLpNorm (positiveNormalizedRepresentative u.«section»)
          2 fundamentalMeasure) := by
  simpa only [realization] using
    norm_positiveToLp u.«section» u.squareIntegrable

end PositiveAutomorphicL2Section

namespace InverseAutomorphicL2Section

noncomputable def realization
    {ν : GenuineInverseHalfWeightAutomorphy.Multiplier}
    (u : InverseAutomorphicL2Section ν) : InverseL2Carrier :=
  inverseToLp u.«section» u.squareIntegrable

@[simp]
theorem realization_eq_linear
    {ν : GenuineInverseHalfWeightAutomorphy.Multiplier}
    (u : InverseAutomorphicL2Section ν) :
    u.realization =
      inverseRealizationLinear ν
        (inverseAutomorphicL2SectionEquiv ν u) :=
  rfl

theorem realization_injective
    (ν : GenuineInverseHalfWeightAutomorphy.Multiplier) :
    Function.Injective
      (realization : InverseAutomorphicL2Section ν → InverseL2Carrier) := by
  intro u v huv
  apply (inverseAutomorphicL2SectionEquiv ν).injective
  apply inverseRealizationLinear_injective ν
  simpa only [realization_eq_linear] using huv

theorem coeFn_realization
    {ν : GenuineInverseHalfWeightAutomorphy.Multiplier}
    (u : InverseAutomorphicL2Section ν) :
    (u.realization : UpperHalfPlane → ℂ) =ᵐ[fundamentalMeasure]
      inverseNormalizedRepresentative u.«section» := by
  simpa only [realization] using
    coeFn_inverseToLp u.«section» u.squareIntegrable

@[simp]
theorem norm_realization
    {ν : GenuineInverseHalfWeightAutomorphy.Multiplier}
    (u : InverseAutomorphicL2Section ν) :
    ‖u.realization‖ =
      ENNReal.toReal
        (eLpNorm (inverseNormalizedRepresentative u.«section»)
          2 fundamentalMeasure) := by
  simpa only [realization] using
    norm_inverseToLp u.«section» u.squareIntegrable

end InverseAutomorphicL2Section

end CorrectedLemmas.GenuineSixCellWeightedL2

/-! ### The concrete mod-two invariant of the three `Γ(2)` cusp representatives

The first column of a scaling matrix is the primitive integral vector representing
its image of infinity.  Reduction of this column modulo two gives a finite
invariant for the principal congruence subgroup.  The construction below proves
that the three chosen columns exhaust the three nonzero vectors over `ZMod 2`,
and that the invariant is preserved by the literal matrix action of `Γ(2)`.

The finite parity invariant is followed by the actual primitive-column orbit
bridge.  Thus every Bezout-primitive integral column is proved to lie in
exactly one of the three displayed `Gamma(2)` cusp orbits; no rational or
projective classification hypothesis is stored in that theorem.
-/

namespace CorrectedLemmas.Gamma2CuspParity

/-- Integral numerator/denominator pair formed by the first column of the chosen
scaling matrix. -/
def scalingFirstColumn (k : Mock2Adv.Gamma2Cusp) : ℤ × ℤ :=
  (Mock2Adv.Gamma2Cusp.scalingMatrix k 0 0,
    Mock2Adv.Gamma2Cusp.scalingMatrix k 1 0)

@[simp]
theorem scalingFirstColumn_infinity :
    scalingFirstColumn .infinity = (1, 0) := by
  simp [scalingFirstColumn, Mock2Adv.Gamma2Cusp.scalingMatrix]

@[simp]
theorem scalingFirstColumn_zero :
    scalingFirstColumn .zero = (0, 1) := by
  simp [scalingFirstColumn, Mock2Adv.Gamma2Cusp.scalingMatrix,
    ModularGroup.coe_S]

@[simp]
theorem scalingFirstColumn_one :
    scalingFirstColumn .one = (1, 1) := by
  simp [scalingFirstColumn, Mock2Adv.Gamma2Cusp.scalingMatrix,
    Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_T,
    ModularGroup.coe_S, Matrix.mul_fin_two]

/-- Every chosen scaling column is primitive because it is a column of an
`SL(2, ℤ)` matrix. -/
theorem scalingFirstColumn_isCoprime (k : Mock2Adv.Gamma2Cusp) :
    IsCoprime (scalingFirstColumn k).1 (scalingFirstColumn k).2 := by
  change IsCoprime
    (Mock2Adv.Gamma2Cusp.scalingMatrix k 0 0)
      (Mock2Adv.Gamma2Cusp.scalingMatrix k 1 0)
  exact Matrix.SpecialLinearGroup.isCoprime_col
    (Mock2Adv.Gamma2Cusp.scalingMatrix k) (0 : Fin 2)

/-- The finite parity space in which the `Γ(2)` cusp invariant takes values. -/
abbrev ParityPair : Type := ZMod 2 × ZMod 2

/-- Coordinatewise reduction of an integral cusp pair modulo two. -/
def reducePair (v : ℤ × ℤ) : ParityPair :=
  ((v.1 : ZMod 2), (v.2 : ZMod 2))

/-- Mod-two label of one of the three chosen scaling columns. -/
def standardParity (k : Mock2Adv.Gamma2Cusp) : ParityPair :=
  reducePair (scalingFirstColumn k)

@[simp]
theorem standardParity_infinity :
    standardParity .infinity = ((1, 0) : ParityPair) := by
  simp [standardParity, reducePair]

@[simp]
theorem standardParity_zero :
    standardParity .zero = ((0, 1) : ParityPair) := by
  simp [standardParity, reducePair]

@[simp]
theorem standardParity_one :
    standardParity .one = ((1, 1) : ParityPair) := by
  simp [standardParity, reducePair]

/-- None of the three standard cusp columns vanishes modulo two. -/
theorem standardParity_ne_zero (k : Mock2Adv.Gamma2Cusp) :
    standardParity k ≠ 0 := by
  cases k <;> simp

/-- The three cusp labels have pairwise distinct mod-two columns. -/
theorem standardParity_injective : Function.Injective standardParity := by
  intro k l h
  cases k <;> cases l <;> simp_all

/-- Nonzero vectors in the two-dimensional parity space. -/
abbrev NonzeroParityPair : Type := {v : ParityPair // v ≠ 0}

/-- The parity label regarded as a nonzero vector. -/
def standardNonzeroParity
    (k : Mock2Adv.Gamma2Cusp) : NonzeroParityPair :=
  ⟨standardParity k, standardParity_ne_zero k⟩

theorem standardNonzeroParity_injective :
    Function.Injective standardNonzeroParity := by
  intro k l h
  apply standardParity_injective
  exact congrArg Subtype.val h

/-- There are exactly three nonzero vectors in `(ZMod 2)²`. -/
theorem card_nonzeroParityPair :
    Fintype.card NonzeroParityPair = 3 := by
  calc
    Fintype.card NonzeroParityPair =
        Fintype.card ParityPair -
          Fintype.card {v : ParityPair // v = 0} :=
      Fintype.card_subtype_compl (fun v : ParityPair => v = 0)
    _ = 3 := by
      rw [Fintype.card_subtype_eq (0 : ParityPair)]
      norm_num [ParityPair, Fintype.card_prod, ZMod.card]

/-- The three standard columns give every nonzero parity vector exactly once. -/
theorem standardNonzeroParity_bijective :
    Function.Bijective standardNonzeroParity := by
  refine (Fintype.bijective_iff_injective_and_card
    standardNonzeroParity).2 ⟨standardNonzeroParity_injective, ?_⟩
  rw [Mock2Adv.Gamma2Cusp.card_eq, card_nonzeroParityPair]

/-- Explicit finite classification: every nonzero parity vector has a unique
label among infinity, zero, and one. -/
theorem existsUnique_standardParity
    (v : ParityPair) (hv : v ≠ 0) :
    ∃! k : Mock2Adv.Gamma2Cusp, standardParity k = v := by
  obtain ⟨k, hk⟩ := standardNonzeroParity_bijective.2 ⟨v, hv⟩
  have hkv : standardParity k = v := congrArg Subtype.val hk
  refine ⟨k, hkv, ?_⟩
  intro l hl
  exact standardParity_injective (hl.trans hkv.symm)

/-- A primitive integral cusp pair cannot reduce to the zero vector modulo
two.  This is the image of Bezout coprimality in the field `ZMod 2`, not a
separately stored parity assumption. -/
theorem reducePair_ne_zero_of_isCoprime
  {v : ℤ × ℤ} (hv : IsCoprime v.1 v.2) :
    reducePair v ≠ 0 := by
  have hmod : IsCoprime (v.1 : ZMod 2) (v.2 : ZMod 2) :=
    hv.intCast
  intro hzero
  have hfst : (v.1 : ZMod 2) = 0 := by
    simpa [reducePair] using congrArg Prod.fst hzero
  have hsnd : (v.2 : ZMod 2) = 0 := by
    simpa [reducePair] using congrArg Prod.snd hzero
  apply (not_isCoprime_zero_zero (R := ZMod 2))
  simpa only [hfst, hsnd] using hmod

/-- Every primitive integral cusp column therefore has a unique one of the
three mod-two labels. -/
theorem existsUnique_standardParity_of_isCoprime
    (v : ℤ × ℤ) (hv : IsCoprime v.1 v.2) :
    ∃! k : Mock2Adv.Gamma2Cusp,
      standardParity k = reducePair v :=
  existsUnique_standardParity (reducePair v)
    (reducePair_ne_zero_of_isCoprime hv)

/-- Literal left matrix action of a `Γ(2)` element on an integral cusp pair. -/
def pairAction (γ : Gamma2Element) (v : ℤ × ℤ) : ℤ × ℤ :=
  (γ.1 0 0 * v.1 + γ.1 0 1 * v.2,
    γ.1 1 0 * v.1 + γ.1 1 1 * v.2)

/-- A principal level-two matrix acts trivially after coordinatewise reduction
modulo two. -/
theorem reducePair_pairAction
    (γ : Gamma2Element) (v : ℤ × ℤ) :
    reducePair (pairAction γ v) = reducePair v := by
  rcases CongruenceSubgroup.Gamma_mem.mp γ.property with
    ⟨h00, h01, h10, h11⟩
  apply Prod.ext
  · simp [reducePair, pairAction, h00, h01]
  · simp [reducePair, pairAction, h10, h11]

/-- Changing the sign of a primitive representative does not change its
mod-two projective label. -/
theorem reducePair_neg (v : ℤ × ℤ) :
    reducePair (-v.1, -v.2) = reducePair v := by
  apply Prod.ext
  · simp [reducePair, ZMod.neg_eq_self_mod_two]
  · simp [reducePair, ZMod.neg_eq_self_mod_two]

/-- If a `Γ(2)` matrix carries one standard scaling column exactly to another,
then the two cusp labels coincide. -/
theorem scalingFirstColumn_related_implies_sameCusp
    {k l : Mock2Adv.Gamma2Cusp}
    (h : ∃ γ : Gamma2Element,
      pairAction γ (scalingFirstColumn k) = scalingFirstColumn l) :
    k = l := by
  obtain ⟨γ, hγ⟩ := h
  apply standardParity_injective
  calc
    standardParity k = reducePair (scalingFirstColumn k) := rfl
    _ = reducePair (pairAction γ (scalingFirstColumn k)) :=
      (reducePair_pairAction γ _).symm
    _ = reducePair (scalingFirstColumn l) := congrArg reducePair hγ
    _ = standardParity l := rfl

/-- The same orbit-separation statement with the unavoidable sign ambiguity of
a primitive projective representative included explicitly. -/
theorem scalingFirstColumn_signedRelated_implies_sameCusp
    {k l : Mock2Adv.Gamma2Cusp}
    (h : ∃ γ : Gamma2Element,
      pairAction γ (scalingFirstColumn k) = scalingFirstColumn l ∨
        pairAction γ (scalingFirstColumn k) =
          (-((scalingFirstColumn l).1), -((scalingFirstColumn l).2))) :
    k = l := by
  obtain ⟨γ, hγ | hγ⟩ := h
  · exact scalingFirstColumn_related_implies_sameCusp ⟨γ, hγ⟩
  · apply standardParity_injective
    calc
      standardParity k = reducePair (scalingFirstColumn k) := rfl
      _ = reducePair (pairAction γ (scalingFirstColumn k)) :=
        (reducePair_pairAction γ _).symm
      _ = reducePair
          (-((scalingFirstColumn l).1), -((scalingFirstColumn l).2)) :=
        congrArg reducePair hγ
      _ = reducePair (scalingFirstColumn l) := reducePair_neg _
      _ = standardParity l := rfl

/-! #### Actual primitive-column orbit classification

The next results close the algebraic bridge omitted by the parity-only
classification above.  A primitive pair is first extended to an honest
integral determinant-one matrix.  The proved six-coset decomposition then
factors that matrix as a `Gamma(2)` element times one of the explicit cell
representatives, whose first column is one of the three scaling columns. -/

/-- First column of an integral determinant-one matrix, as an integral pair. -/
def integralFirstColumn
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) : ℤ × ℤ :=
  (g 0 0, g 1 0)

@[simp]
theorem integralFirstColumn_fst
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    (integralFirstColumn g).1 = g 0 0 :=
  rfl

@[simp]
theorem integralFirstColumn_snd
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    (integralFirstColumn g).2 = g 1 0 :=
  rfl

/-- Matrix multiplication on first columns is exactly `pairAction`. -/
theorem pairAction_integralFirstColumn
    (γ : Gamma2Element)
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    pairAction γ (integralFirstColumn g) =
      integralFirstColumn (γ.1 * g) := by
  apply Prod.ext
  · simp [pairAction, integralFirstColumn,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
  · simp [pairAction, integralFirstColumn,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

/-- The first column of each of the six representatives is exactly the scaling
column selected by `repColumnCusp`.  The separate height selector `repCusp`
cannot occur in this statement: its `.ts` and `.stInv` values are exchanged
for the geometric reason documented at `repColumnCusp`. -/
theorem repMatrix_firstColumn_eq_scalingFirstColumn
    (r : CorrectedLemmas.Gamma2SixCellPolygon.Gamma2Rep) :
    integralFirstColumn
        (CorrectedLemmas.Gamma2SixCellPolygon.repMatrix r) =
      scalingFirstColumn
        (CorrectedLemmas.Gamma2SixCellPolygon.repColumnCusp r) := by
  cases r <;>
    simp [integralFirstColumn,
      CorrectedLemmas.Gamma2SixCellPolygon.repMatrix,
      CorrectedLemmas.Gamma2SixCellPolygon.repColumnCusp,
      scalingFirstColumn, Mock2Adv.Gamma2Cusp.scalingMatrix,
      Matrix.SpecialLinearGroup.coe_mul, ModularGroup.coe_S,
      ModularGroup.coe_T, ModularGroup.coe_T_inv, Matrix.mul_fin_two]

/-- Bezout primitivity extends the displayed pair to the first column of an
actual integral special-linear matrix. -/
theorem exists_integralSpecialLinear_firstColumn
    (v : ℤ × ℤ) (hv : IsCoprime v.1 v.2) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) ℤ,
      integralFirstColumn g = v := by
  obtain ⟨g, hg0, hg1⟩ := hv.exists_SL2_col 0
  refine ⟨g, ?_⟩
  exact Prod.ext hg0 hg1

/-- Every primitive integral column belongs to one of the three concrete
`Gamma(2)` cusp orbits.  The witness is constructed from an `SL(2,Z)` column
extension and the proved right-coset decomposition, rather than from parity
alone. -/
theorem exists_gamma2_cuspOrbit_of_isCoprime
    (v : ℤ × ℤ) (hv : IsCoprime v.1 v.2) :
    ∃ κ : Mock2Adv.Gamma2Cusp, ∃ γ : Gamma2Element,
      pairAction γ (scalingFirstColumn κ) = v := by
  obtain ⟨g, hg⟩ := exists_integralSpecialLinear_firstColumn v hv
  obtain ⟨γ, r, hfactor⟩ :=
    CorrectedLemmas.Gamma2SixCellPolygon.exists_gamma2_mul_rep g
  refine ⟨CorrectedLemmas.Gamma2SixCellPolygon.repColumnCusp r, γ, ?_⟩
  calc
    pairAction γ
        (scalingFirstColumn
          (CorrectedLemmas.Gamma2SixCellPolygon.repColumnCusp r)) =
        pairAction γ
          (integralFirstColumn
            (CorrectedLemmas.Gamma2SixCellPolygon.repMatrix r)) := by
              rw [repMatrix_firstColumn_eq_scalingFirstColumn]
    _ = integralFirstColumn
          (γ.1 * CorrectedLemmas.Gamma2SixCellPolygon.repMatrix r) :=
      pairAction_integralFirstColumn γ _
    _ = integralFirstColumn g :=
      congrArg integralFirstColumn hfactor.symm
    _ = v := hg

/-- Two standard scaling columns lying in the same primitive-column orbit of
`Gamma(2)` have the same cusp label. -/
theorem cusp_eq_of_pairActions_eq
    {k l : Mock2Adv.Gamma2Cusp}
    {γ δ : Gamma2Element}
    (h : pairAction γ (scalingFirstColumn k) =
      pairAction δ (scalingFirstColumn l)) :
    k = l := by
  apply standardParity_injective
  calc
    standardParity k =
        reducePair (pairAction γ (scalingFirstColumn k)) :=
      (reducePair_pairAction γ _).symm
    _ = reducePair (pairAction δ (scalingFirstColumn l)) :=
      congrArg reducePair h
    _ = standardParity l :=
      reducePair_pairAction δ _

/-- **Unconditional three-cusp orbit theorem for primitive columns.**  Every
Bezout-primitive integral pair lies in exactly one orbit of the three chosen
scaling columns under the literal `Gamma(2)` matrix action. -/
theorem existsUnique_gamma2_cuspOrbit_of_isCoprime
    (v : ℤ × ℤ) (hv : IsCoprime v.1 v.2) :
    ∃! κ : Mock2Adv.Gamma2Cusp, ∃ γ : Gamma2Element,
      pairAction γ (scalingFirstColumn κ) = v := by
  obtain ⟨k, γ, hγ⟩ := exists_gamma2_cuspOrbit_of_isCoprime v hv
  refine ⟨k, ⟨γ, hγ⟩, ?_⟩
  intro l hl
  obtain ⟨δ, hδ⟩ := hl
  exact (cusp_eq_of_pairActions_eq (hγ.trans hδ.symm)).symm

end CorrectedLemmas.Gamma2CuspParity

/-! ### Finite-truncation-first construction of infinite series

The paper's Poincare, Rademacher, and arithmetic series must first be handled
at finite cutoff.  These lemmas provide the project-local convergence bridge:
the infinite object is the norm limit of `Finset.range` truncations, with an
explicit complementary-tail bound. -/

namespace CorrectedLemmas.FiniteSeriesConstruction

universe uE uF uX

variable {E : Type uE} [NormedAddCommGroup E] [CompleteSpace E]

/-- The canonical finite truncation of a natural-number-indexed series. -/
def partialSum (f : ℕ → E) (N : ℕ) : E :=
  ∑ n ∈ Finset.range N, f n

/-- A summable series is the limit of its canonical finite truncations. -/
theorem partialSum_tendsto_tsum {f : ℕ → E} (hf : Summable f) :
    Tendsto (partialSum f) atTop (𝓝 (∑' n, f n)) := by
  change Tendsto (fun N => ∑ n ∈ Finset.range N, f n)
    atTop (𝓝 (∑' n, f n))
  exact hf.hasSum.tendsto_sum_nat

/-- Hence finite truncations form a Cauchy sequence before the infinite object
is used in any subsequent equality. -/
theorem partialSum_cauchySeq {f : ℕ → E} (hf : Summable f) :
    CauchySeq (partialSum f) :=
  (partialSum_tendsto_tsum hf).cauchySeq

/-- Exact complementary-tail control under absolute summability. -/
theorem norm_tsum_sub_partialSum_le_tail
    {f : ℕ → E} (hf : Summable fun n => ‖f n‖) (N : ℕ) :
    ‖(∑' n, f n) - partialSum f N‖ ≤
      ∑' n : {n : ℕ // n ∉ Finset.range N}, ‖f n‖ := by
  have hvector : Summable f := hf.of_norm
  rw [← hvector.sum_add_tsum_subtype_compl (Finset.range N)]
  simp only [partialSum, add_sub_cancel_left]
  exact norm_tsum_le_tsum_norm (hf.subtype _)

/-- The vector-valued remainder tends to zero. -/
theorem tsum_sub_partialSum_tendsto_zero
    {f : ℕ → E} (hf : Summable f) :
    Tendsto (fun N => (∑' n, f n) - partialSum f N)
      atTop (𝓝 0) := by
  have hconst : Tendsto (fun _ : ℕ => ∑' n, f n)
      atTop (𝓝 (∑' n, f n)) := tendsto_const_nhds
  simpa only [sub_self] using
    hconst.sub (partialSum_tendsto_tsum hf)

/-- Finite truncation commutes with every linear map, without continuity or
limit arguments. -/
theorem linearMap_partialSum
    {F : Type uF} [NormedAddCommGroup F] [CompleteSpace F]
    [Module ℂ E] [Module ℂ F]
    (T : E →ₗ[ℂ] F) (f : ℕ → E) (N : ℕ) :
    T (partialSum f N) = partialSum (fun n => T (f n)) N := by
  simp [partialSum]

/-- Passing a continuous differential/operator through the infinite sum is a
separate theorem with its exact summability hypothesis. -/
theorem continuousLinearMap_tsum
    {F : Type uF} [NormedAddCommGroup F]
    [NormedSpace ℂ E] [NormedSpace ℂ F]
    (T : E →L[ℂ] F) {f : ℕ → E} (hf : Summable f) :
    T (∑' n, f n) = ∑' n, T (f n) :=
  T.map_tsum hf

/-- A summable uniform envelope proves uniform convergence of finite function
truncations on the stated set.  Compact spectral support alone is not used. -/
theorem tendstoUniformlyOn_partialSum
    {X : Type uX} {F : Type uF}
    [NormedAddCommGroup F] [CompleteSpace F]
    {f : ℕ → X → F} {u : ℕ → ℝ} (hu : Summable u) {s : Set X}
    (hfu : ∀ n x, x ∈ s → ‖f n x‖ ≤ u n) :
    TendstoUniformlyOn
      (fun N x => ∑ n ∈ Finset.range N, f n x)
      (fun x => ∑' n, f n x) atTop s :=
  tendstoUniformlyOn_tsum_nat hu hfu

end CorrectedLemmas.FiniteSeriesConstruction

/-! ### Complex PDE data as a real Lax--Milgram problem

Mathlib's complex inner product is conjugate-linear in its first argument and
linear in its second argument.  Consequently `Re ⟨A u, v⟩` is not a complex
bilinear form, but it is a genuine real bilinear form after restriction of
scalars.  The construction below installs exactly Mathlib's canonical real
inner-product structure, constructs the bounded form from continuous maps, and
then applies the real Lax--Milgram theorem. -/

namespace CorrectedLemmas.ComplexRealLaxMilgram

universe uE

variable {E : Type uE} [NormedAddCommGroup E]
variable [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The canonical real inner product on a complex Hilbert space.  It has the
same norm and topology as the original complex structure. -/
local instance complexHilbertToRealInnerProductSpace :
    InnerProductSpace ℝ E :=
  InnerProductSpace.rclikeToReal ℂ E

/-- Scalar associativity for the canonical restriction `ℝ → ℂ → E`. -/
local instance complexHilbertRealScalarTower : IsScalarTower ℝ ℂ E :=
  IsScalarTower.restrictScalars ℝ ℂ E

/-- The real part of the complex inner-product functional in the second
variable, constructed explicitly from `innerSL`, scalar restriction, and
`Complex.reCLM`. -/
noncomputable def realPartInnerFunctional (x : E) : E →L[ℝ] ℝ :=
  Complex.reCLM.comp ((innerSL ℂ x).restrictScalars ℝ)

@[simp]
theorem realPartInnerFunctional_apply (x y : E) :
    realPartInnerFunctional x y = (⟪x, y⟫_ℂ).re := by
  rfl

/-- The bounded real bilinear form associated with a bounded complex-linear
operator `A`.  Continuity is inherited from the continuous real inner product
and `A.restrictScalars ℝ`; it is not supplied as a certificate field. -/
noncomputable def realBilinearForm (A : E →L[ℂ] E) :
    E →L[ℝ] E →L[ℝ] ℝ :=
  (innerSL ℝ (E := E)).comp (A.restrictScalars ℝ)

@[simp]
theorem realBilinearForm_apply (A : E →L[ℂ] E) (u v : E) :
    realBilinearForm A u v = (⟪A u, v⟫_ℂ).re := by
  change ⟪A u, v⟫_ℝ = (⟪A u, v⟫_ℂ).re
  exact real_inner_eq_re_inner ℂ (A u) v

/-- Each continuous functional obtained by fixing the first variable is
literally the `Complex.reCLM` construction above. -/
theorem realBilinearForm_apply_eq_realPartInnerFunctional
    (A : E →L[ℂ] E) (u : E) :
    realBilinearForm A u = realPartInnerFunctional (A u) := by
  ext v
  simp only [realBilinearForm_apply, realPartInnerFunctional_apply]

/-- A complex coercivity estimate gives Mathlib's real `IsCoercive` predicate
for the explicitly constructed form. -/
theorem realBilinearForm_isCoercive
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re) :
    IsCoercive (realBilinearForm A) := by
  refine ⟨c, hc, ?_⟩
  intro u
  simpa only [realBilinearForm_apply, pow_two, mul_assoc] using hA u

/-- The real Lax--Milgram equivalence produced from the complex operator and
its explicit coercivity estimate. -/
noncomputable def laxMilgramEquiv
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re) :
    E ≃L[ℝ] E :=
  (realBilinearForm_isCoercive A hc hA).continuousLinearEquivOfBilin

/-- Characterizing identity for the Lax--Milgram equivalence, expressed back
in the original complex inner product. -/
theorem laxMilgramEquiv_inner_apply
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re)
    (u v : E) :
    ⟪laxMilgramEquiv A hc hA u, v⟫_ℝ =
      (⟪A u, v⟫_ℂ).re := by
  calc
    ⟪laxMilgramEquiv A hc hA u, v⟫_ℝ =
        realBilinearForm A u v :=
      (realBilinearForm_isCoercive A hc hA).continuousLinearEquivOfBilin_apply u v
    _ = (⟪A u, v⟫_ℂ).re := realBilinearForm_apply A u v

/-- The Lax--Milgram map is the underlying real operator of `A`, proved from
the characterizing inner-product identity rather than stored in the
definition. -/
theorem laxMilgramEquiv_apply_eq_operator
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re)
    (u : E) :
    laxMilgramEquiv A hc hA u = A u := by
  apply ext_inner_right ℝ
  intro v
  calc
    ⟪laxMilgramEquiv A hc hA u, v⟫_ℝ =
        (⟪A u, v⟫_ℂ).re :=
      laxMilgramEquiv_inner_apply A hc hA u v
    _ = ⟪A u, v⟫_ℝ :=
      (real_inner_eq_re_inner ℂ (A u) v).symm

/-- The sharp lower estimate inherited from the stated coercivity constant. -/
theorem c_mul_norm_le_norm_laxMilgramEquiv
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re)
    (u : E) :
    c * ‖u‖ ≤ ‖laxMilgramEquiv A hc hA u‖ := by
  by_cases hu : 0 < ‖u‖
  · refine (mul_le_mul_iff_left₀ hu).mp ?_
    calc
      c * ‖u‖ * ‖u‖ ≤ (⟪A u, u⟫_ℂ).re := by
        simpa only [pow_two, mul_assoc] using hA u
      _ = ⟪laxMilgramEquiv A hc hA u, u⟫_ℝ :=
        (laxMilgramEquiv_inner_apply A hc hA u u).symm
      _ ≤ ‖laxMilgramEquiv A hc hA u‖ * ‖u‖ :=
        real_inner_le_norm _ _
  · have hzero : u = 0 := by simpa using hu
    simp [hzero]

/-- The corresponding a priori bound for the inverse solution operator. -/
theorem norm_laxMilgramEquiv_symm_le
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re)
    (f : E) :
    ‖(laxMilgramEquiv A hc hA).symm f‖ ≤ ‖f‖ / c := by
  apply (le_div_iff₀ hc).2
  have hbound := c_mul_norm_le_norm_laxMilgramEquiv A hc hA
    ((laxMilgramEquiv A hc hA).symm f)
  simpa [mul_comm] using hbound

/-- Existence and both quantitative estimates, with all analytic hypotheses
visible in the theorem statement. -/
theorem exists_laxMilgramEquiv_with_estimates
    (A : E →L[ℂ] E) {c : ℝ} (hc : 0 < c)
    (hA : ∀ u : E, c * ‖u‖ ^ 2 ≤ (⟪A u, u⟫_ℂ).re) :
    ∃ e : E ≃L[ℝ] E,
      (∀ u v, ⟪e u, v⟫_ℝ = (⟪A u, v⟫_ℂ).re) ∧
      (∀ u, c * ‖u‖ ≤ ‖e u‖) ∧
      (∀ f, ‖e.symm f‖ ≤ ‖f‖ / c) := by
  refine ⟨laxMilgramEquiv A hc hA, ?_, ?_, ?_⟩
  · exact laxMilgramEquiv_inner_apply A hc hA
  · exact c_mul_norm_le_norm_laxMilgramEquiv A hc hA
  · exact norm_laxMilgramEquiv_symm_le A hc hA

end CorrectedLemmas.ComplexRealLaxMilgram

/-! ### A concrete smooth endomorphism-valued one-form

The algebraic type `EndValuedOneForm ℂ ℂ` carries no canonical normed-space
topology in Mathlib.  In complex rank one, however, evaluation twice at `1`
is a canonical complex-linear equivalence with `ℂ`.  We use that equivalence
to transport the ordinary `C^∞` notion, rather than postulating a topology on
algebraic linear maps.  The continuous-linear refinement below is literally a
`ContDiff ℂ ⊤` map into nested continuous endomorphisms and forgets to the same
algebraic form.
-/

namespace CorrectedLemmas.SmoothEndValuedOneForms

/-- Algebraic endomorphism-valued one-forms for one-dimensional complex
tangent and fibre spaces. -/
abbrev AlgebraicValue : Type := EndValuedOneForm ℂ ℂ

/-- Evaluation of a rank-one endomorphism-valued one-form on the tangent
vector `1`, followed by evaluation of the resulting endomorphism at `1`. -/
def coordinate : AlgebraicValue ≃ₗ[ℂ] ℂ :=
  (LinearMap.ringLmapEquivSelf ℂ ℂ (ℂ →ₗ[ℂ] ℂ)).trans
    (LinearMap.ringLmapEquivSelf ℂ ℂ ℂ)

@[simp]
theorem coordinate_apply (A : AlgebraicValue) :
    coordinate A = A 1 1 :=
  rfl

@[simp]
theorem coordinate_lsmul :
    coordinate (LinearMap.lsmul ℂ ℂ) = 1 := by
  simp [coordinate_apply, LinearMap.lsmul_apply]

/-- Coordinate-invariant smoothness for an algebraic rank-one
endomorphism-valued one-form.  Since `coordinate` is a linear equivalence,
this is precisely the transported `C^∞` structure from `ℂ`. -/
def IsSmooth (A : ℂ → AlgebraicValue) : Prop :=
  ContDiff ℂ ⊤ (fun z => coordinate (A z))

/-- The actual complex submodule of smooth algebraic
`End(ℂ)`-valued one-forms on the complex line. -/
def smoothForms : Submodule ℂ (ℂ → AlgebraicValue) where
  carrier := {A | IsSmooth A}
  zero_mem' := by
    simpa [IsSmooth] using
      (contDiff_const : ContDiff ℂ ⊤ (fun _ : ℂ => (0 : ℂ)))
  add_mem' := by
    intro A B hA hB
    change ContDiff ℂ ⊤ (fun z => coordinate (A z)) at hA
    change ContDiff ℂ ⊤ (fun z => coordinate (B z)) at hB
    change ContDiff ℂ ⊤ (fun z => coordinate ((A + B) z))
    simpa only [Pi.add_apply, map_add] using hA.add hB
  smul_mem' := by
    intro c A hA
    change ContDiff ℂ ⊤ (fun z => coordinate (A z)) at hA
    change ContDiff ℂ ⊤ (fun z => coordinate ((c • A) z))
    simpa only [Pi.smul_apply, map_smul] using hA.const_smul c

theorem zero_isSmooth : IsSmooth (0 : ℂ → AlgebraicValue) :=
  smoothForms.zero_mem

theorem add_isSmooth {A B : ℂ → AlgebraicValue}
    (hA : IsSmooth A) (hB : IsSmooth B) :
    IsSmooth (A + B) :=
  smoothForms.add_mem hA hB

theorem smul_isSmooth (c : ℂ) {A : ℂ → AlgebraicValue}
    (hA : IsSmooth A) :
    IsSmooth (c • A) :=
  smoothForms.smul_mem c hA

/-- The constant scalar-multiplication one-form.  Its value is the genuine
bilinear map supplied by `LinearMap.lsmul`, not a conclusion-shaped record. -/
def scalarMultiplicationForm : ℂ → AlgebraicValue :=
  fun _ => LinearMap.lsmul ℂ ℂ

@[simp]
theorem scalarMultiplicationForm_apply (z v w : ℂ) :
    scalarMultiplicationForm z v w = v * w := by
  simp [scalarMultiplicationForm, LinearMap.lsmul_apply, smul_eq_mul]

theorem scalarMultiplicationForm_isSmooth :
    IsSmooth scalarMultiplicationForm := by
  change ContDiff ℂ ⊤
    (fun _ : ℂ => coordinate (LinearMap.lsmul ℂ ℂ))
  simpa only [coordinate_lsmul] using
    (contDiff_const : ContDiff ℂ ⊤ (fun _ : ℂ => (1 : ℂ)))

theorem scalarMultiplicationForm_mem_smoothForms :
    scalarMultiplicationForm ∈ smoothForms :=
  scalarMultiplicationForm_isSmooth

/-- The scalar-multiplication form as an element of the smooth-form
submodule. -/
def scalarMultiplicationSmoothForm : smoothForms :=
  ⟨scalarMultiplicationForm, scalarMultiplicationForm_isSmooth⟩

/-- Nontriviality is witnessed by evaluating the form at base point `0`,
tangent vector `1`, and fibre vector `1`. -/
theorem scalarMultiplicationForm_ne_zero :
    scalarMultiplicationForm ≠ 0 := by
  intro hzero
  have hvalue := congrArg
    (fun A : ℂ → AlgebraicValue => A 0 1 1) hzero
  have hone : (1 : ℂ) = 0 := by
    simpa using hvalue
  exact one_ne_zero hone

theorem scalarMultiplicationSmoothForm_ne_zero :
    scalarMultiplicationSmoothForm ≠ 0 := by
  intro hzero
  apply scalarMultiplicationForm_ne_zero
  exact congrArg Subtype.val hzero

/-! The normed, continuous-linear realization. -/

/-- Continuous rank-one endomorphism-valued one-form values. -/
abbrev ContinuousValue : Type := ℂ →L[ℂ] (ℂ →L[ℂ] ℂ)

/-- The literal `ContDiff ℂ ⊤` submodule in the normed continuous-linear
realization. -/
def smoothContinuousForms : Submodule ℂ (ℂ → ContinuousValue) where
  carrier := {A | ContDiff ℂ ⊤ A}
  zero_mem' := by
    change ContDiff ℂ ⊤ (fun _ : ℂ => (0 : ContinuousValue))
    exact contDiff_const
  add_mem' := by
    intro A B hA hB
    change ContDiff ℂ ⊤ A at hA
    change ContDiff ℂ ⊤ B at hB
    change ContDiff ℂ ⊤ (fun z => A z + B z)
    exact hA.add hB
  smul_mem' := by
    intro c A hA
    change ContDiff ℂ ⊤ A at hA
    change ContDiff ℂ ⊤ (fun z => c • A z)
    exact hA.const_smul c

theorem continuous_zero_contDiff :
    ContDiff ℂ ⊤ (0 : ℂ → ContinuousValue) :=
  smoothContinuousForms.zero_mem

theorem continuous_add_contDiff {A B : ℂ → ContinuousValue}
    (hA : ContDiff ℂ ⊤ A) (hB : ContDiff ℂ ⊤ B) :
    ContDiff ℂ ⊤ (A + B) :=
  smoothContinuousForms.add_mem hA hB

theorem continuous_smul_contDiff (c : ℂ) {A : ℂ → ContinuousValue}
    (hA : ContDiff ℂ ⊤ A) :
    ContDiff ℂ ⊤ (c • A) :=
  smoothContinuousForms.smul_mem c hA

/-- Scalar multiplication as a nested continuous linear map. -/
def continuousScalarMultiplicationValue : ContinuousValue :=
  ContinuousLinearMap.lsmul ℂ ℂ

/-- The corresponding constant continuous-linear one-form. -/
def continuousScalarMultiplicationForm : ℂ → ContinuousValue :=
  fun _ => continuousScalarMultiplicationValue

theorem continuousScalarMultiplicationForm_contDiff :
    ContDiff ℂ ⊤ continuousScalarMultiplicationForm :=
  contDiff_const

theorem continuousScalarMultiplicationForm_mem_smoothContinuousForms :
    continuousScalarMultiplicationForm ∈ smoothContinuousForms :=
  continuousScalarMultiplicationForm_contDiff

@[simp]
theorem continuousScalarMultiplicationForm_apply (z v w : ℂ) :
    continuousScalarMultiplicationForm z v w = v * w := by
  simp [continuousScalarMultiplicationForm,
    continuousScalarMultiplicationValue,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul]

theorem continuousScalarMultiplicationForm_ne_zero :
    continuousScalarMultiplicationForm ≠ 0 := by
  intro hzero
  have hvalue := congrArg
    (fun A : ℂ → ContinuousValue => A 0 1 1) hzero
  have hone : (1 : ℂ) = 0 := by
    simpa using hvalue
  exact one_ne_zero hone

/-- Forget continuity in both linear-map layers. -/
def forgetContinuousValue (A : ContinuousValue) : AlgebraicValue where
  toFun v := (A v).toLinearMap
  map_add' v w :=
    congrArg ContinuousLinearMap.toLinearMap (A.map_add v w)
  map_smul' c v :=
    congrArg ContinuousLinearMap.toLinearMap (A.map_smul c v)

@[simp]
theorem forgetContinuousValue_apply (A : ContinuousValue) (v w : ℂ) :
    forgetContinuousValue A v w = A v w :=
  rfl

/-- The continuous construction forgets exactly to `LinearMap.lsmul`. -/
theorem forgetContinuousScalarMultiplicationValue :
    forgetContinuousValue continuousScalarMultiplicationValue =
      LinearMap.lsmul ℂ ℂ := by
  ext v w
  simp [continuousScalarMultiplicationValue,
    ContinuousLinearMap.lsmul_apply, LinearMap.lsmul_apply]

/-- A lawful trivial `Γ(2)` descent action on the concrete smooth-form
module.  Both deck pullback and bundle transition are the identity. -/
def trivialDescentAction : GaugeDescentAction smoothForms where
  pullback := fun _ => LinearMap.id
  transition := fun _ => LinearMap.id
  pullback_one := by
    intro A
    rfl
  pullback_mul := by
    intro γ δ A
    rfl
  transition_one := by
    intro A
    rfl
  transition_mul := by
    intro γ δ A
    rfl

theorem everySmoothForm_isGaugeCovariant (A : smoothForms) :
    IsGaugeCovariant trivialDescentAction A := by
  intro γ
  rfl

/-- The concrete nonzero smooth scalar-multiplication form descends under
the lawful trivial `Γ(2)` action. -/
theorem scalarMultiplicationSmoothForm_isGaugeCovariant :
    IsGaugeCovariant trivialDescentAction scalarMultiplicationSmoothForm :=
  everySmoothForm_isGaugeCovariant scalarMultiplicationSmoothForm

end CorrectedLemmas.SmoothEndValuedOneForms

/-! ### Unitary scattering does not create a positive density

The PDF omits the conventional imaginary factor and infers positivity of a
logarithmic derivative merely from unitarity.  The following scalar unitary
family gives an exact counterexample. -/

namespace CorrectedLemmas.ScatteringDensityErratum

/- Use Mathlib's canonical restriction-of-scalars normed-space structure
throughout the real-parameter derivative calculation. -/
attribute [local instance 10000] NormedSpace.complexToReal

noncomputable def scalarUnitaryScattering (t : ℝ) : ℂ :=
  Complex.exp (Complex.I * (t : ℂ))

noncomputable def scalarUnitaryDerivative (t : ℝ) : ℂ :=
  Complex.I * scalarUnitaryScattering t

/-- The named derivative is the actual real derivative of the unitary
scattering family, not an independently chosen auxiliary function. -/
theorem hasDerivAt_scalarUnitaryScattering (t : ℝ) :
    HasDerivAt scalarUnitaryScattering (scalarUnitaryDerivative t) t := by
  have hinner :
      HasDerivAt (fun z : ℂ => Complex.I * z) Complex.I (t : ℂ) :=
    hasDerivAt_const_mul Complex.I
  have hcomplex := hinner.cexp
  change HasDerivAt
    (fun y : ℝ => Complex.exp (Complex.I * (y : ℂ)))
    (Complex.I * Complex.exp (Complex.I * (t : ℂ))) t
  simpa [mul_comm] using hcomplex.comp_ofReal

theorem norm_scalarUnitaryScattering (t : ℝ) :
    ‖scalarUnitaryScattering t‖ = 1 := by
  rw [scalarUnitaryScattering, Complex.norm_exp]
  simp

theorem scalarLogDerivative_eq_I (t : ℝ) :
    scalarUnitaryDerivative t * (scalarUnitaryScattering t)⁻¹ =
      Complex.I := by
  unfold scalarUnitaryDerivative scalarUnitaryScattering
  calc
    Complex.I * Complex.exp (Complex.I * (t : ℂ)) *
          (Complex.exp (Complex.I * (t : ℂ)))⁻¹ =
        Complex.I *
          (Complex.exp (Complex.I * (t : ℂ)) *
            (Complex.exp (Complex.I * (t : ℂ)))⁻¹) := by ring
    _ = Complex.I := by
      rw [mul_inv_cancel₀ (Complex.exp_ne_zero _), mul_one]

theorem complex_I_not_nonnegativeReal :
    ¬ ∃ r : ℝ, 0 ≤ r ∧ Complex.I = (r : ℂ) := by
  rintro ⟨r, _hr, hI⟩
  have him := congrArg Complex.im hI
  norm_num at him

/-- A unitary scalar scattering family can have a purely imaginary logarithmic
derivative, so the trace displayed on pp.24--25 is not a positive real density
without an additional normalization theorem. -/
theorem unitarity_does_not_imply_positiveLogDerivative :
    ∃ S S' : ℝ → ℂ,
      (∀ t, ‖S t‖ = 1) ∧
      (∀ t, HasDerivAt S (S' t) t) ∧
      (∀ t, S' t * (S t)⁻¹ = Complex.I) ∧
      ¬ (∀ t, ∃ r : ℝ, 0 ≤ r ∧ S' t * (S t)⁻¹ = (r : ℂ)) := by
  refine ⟨scalarUnitaryScattering, scalarUnitaryDerivative,
    norm_scalarUnitaryScattering, hasDerivAt_scalarUnitaryScattering,
    scalarLogDerivative_eq_I, ?_⟩
  intro hpositive
  obtain ⟨r, hr, hir⟩ := hpositive 0
  exact complex_I_not_nonnegativeReal ⟨r, hr,
    (scalarLogDerivative_eq_I 0).symm.trans hir⟩

/-- The conventionally normalized scalar logarithmic derivative.  The factor
`-i` is essential: without it the logarithmic derivative above is imaginary,
not an ordered real density. -/
noncomputable def correctedScalarComplexDensity (t : ℝ) : ℂ :=
  (-Complex.I) *
    (scalarUnitaryDerivative t * (scalarUnitaryScattering t)⁻¹)

/-- For the concrete unitary family, multiplication by `-i` converts the
logarithmic derivative into the positive real scalar `1`. -/
theorem correctedScalarComplexDensity_eq_one (t : ℝ) :
    correctedScalarComplexDensity t = 1 := by
  calc
    correctedScalarComplexDensity t = (-Complex.I) * Complex.I := by
      rw [correctedScalarComplexDensity, scalarLogDerivative_eq_I]
    _ = 1 := by
      rw [neg_mul, Complex.I_mul_I]
      norm_num

/-- The real scalar density extracted after the conventional `-i`
normalization. -/
noncomputable def correctedScalarLogDensity (t : ℝ) : ℝ :=
  (correctedScalarComplexDensity t).re

theorem correctedScalarLogDensity_eq_one (t : ℝ) :
    correctedScalarLogDensity t = 1 := by
  rw [correctedScalarLogDensity, correctedScalarComplexDensity_eq_one]
  rfl

theorem correctedScalarLogDensity_nonneg (t : ℝ) :
    0 ≤ correctedScalarLogDensity t := by
  rw [correctedScalarLogDensity_eq_one]
  norm_num

theorem correctedScalarLogDensity_pos (t : ℝ) :
    0 < correctedScalarLogDensity t := by
  rw [correctedScalarLogDensity_eq_one]
  norm_num

end CorrectedLemmas.ScatteringDensityErratum

/-! ### The PDF does not specify a mock prototype or a normalized Eichler correction

The words "fix a prototype" and "the correction determined by the shadow" do
not determine mathematical objects.  The following two small results isolate
the two independent ambiguities without introducing a conclusion-shaped
certificate: every positive disk admits distinct holomorphic prototypes, and a
linear shadow equation determines a correction only modulo the kernel of its
derivative operator. -/

namespace CorrectedLemmas.MockPrototypeUnderspecification

/-- The minimal analytic datum actually stated for a proposed inside
prototype: holomorphy on the disk of the displayed positive radius. -/
def HolomorphicPrototypeAtRadius
    (R : ℝ) (f : ℂ → ℂ) : Prop :=
  0 < R ∧ DifferentiableOn ℂ f (Metric.ball 0 R)

theorem constant_holomorphicPrototypeAtRadius
    (R : ℝ) (hR : 0 < R) (c : ℂ) :
    HolomorphicPrototypeAtRadius R (fun _ : ℂ => c) := by
  refine ⟨hR, ?_⟩
  exact (differentiable_const c).differentiableOn

theorem constant_zero_ne_constant_one :
    (fun _ : ℂ => (0 : ℂ)) ≠ (fun _ : ℂ => (1 : ℂ)) := by
  intro h
  have h0 := congrFun h 0
  norm_num at h0

/-- Radius and holomorphy alone leave at least two distinct prototypes. -/
theorem positiveRadius_does_not_determinePrototype
    (R : ℝ) (hR : 0 < R) :
    ∃ f g : ℂ → ℂ,
      HolomorphicPrototypeAtRadius R f ∧
      HolomorphicPrototypeAtRadius R g ∧ f ≠ g := by
  exact ⟨(fun _ : ℂ => 0), (fun _ : ℂ => 1),
    constant_holomorphicPrototypeAtRadius R hR 0,
    constant_holomorphicPrototypeAtRadius R hR 1,
    constant_zero_ne_constant_one⟩

/-- Adding an element of the derivative kernel preserves a shadow equation. -/
theorem add_kernel_preserves_shadow
    {E F : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (D : E →ₗ[ℂ] F) {R h : E} {Θ : F}
    (hR : D R = Θ) (hh : D h = 0) :
    D (R + h) = Θ := by
  rw [map_add, hR, hh, add_zero]

/-- A nonzero kernel element produces a genuinely different correction with
the same shadow. -/
theorem correction_not_unique_of_nonzero_kernel
    {E F : Type*} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (D : E →ₗ[ℂ] F) {R h : E} {Θ : F}
    (hR : D R = Θ) (hh : D h = 0) (hne : h ≠ 0) :
    ∃ R' : E, R' ≠ R ∧ D R' = Θ := by
  refine ⟨R + h, ?_, add_kernel_preserves_shadow D hR hh⟩
  intro heq
  apply hne
  apply add_left_cancel (a := R)
  simpa only [add_zero] using heq

/-- A concrete two-coordinate model of the holomorphic-kernel ambiguity.  The
first coordinate records the shadow and the second is invisible to the
derivative, exactly as a holomorphic summand is invisible to `barPartial`. -/
def modelShadowDerivative : (ℂ × ℂ) →ₗ[ℂ] ℂ :=
  LinearMap.fst ℂ ℂ ℂ

@[simp]
theorem modelShadowDerivative_apply (z h : ℂ) :
    modelShadowDerivative (z, h) = z := rfl

theorem modelShadowEquation_has_distinctCorrections (Θ : ℂ) :
    ∃ R₀ R₁ : ℂ × ℂ,
      R₀ ≠ R₁ ∧
      modelShadowDerivative R₀ = Θ ∧
      modelShadowDerivative R₁ = Θ := by
  refine ⟨(Θ, 0), (Θ, 1), ?_, by simp, by simp⟩
  intro h
  have hsnd := congrArg Prod.snd h
  norm_num at hsnd

end CorrectedLemmas.MockPrototypeUnderspecification

/-! ### A fixed nontrivial Laurent model for corrected Definition 10

The PDF does not select a mock-theta prototype, so the underdetermination
erratum above remains in force.  The following independent construction has a
more modest purpose: it gives the corrected inside/outside API a completely
explicit, nonconstant inhabitant.  All coefficients, shifts, domains, sums,
and matching identities are proved directly before they are packaged into
`InsideOutsideSeriesData` or `InsideOutsideMatch`.

The radius is `2`.  On the annulus `1 / 2 < ‖z‖ < 2` the inside variable is
`q = z` and the independent exterior variable is `w = z⁻¹`.  We take

* `f(q) = q`, with its single nonzero coefficient in exponent `1`;
* `S(q) = 2 + q`, with exponents `0` and `1`;
* `Ψ(z) = z + 1`;
* `G(w) = w⁻¹`, represented by exterior Laurent shift `-1` and coefficient
  `1` in exponent `0`.

Consequently `G(z⁻¹) = z = 2 Ψ(z) - S(z)`.  This is a concrete Laurent model,
not a claim that the unnamed mock object in the PDF has been constructed. -/

namespace CorrectedLemmas.FixedDefinition10Model

def radius : ℝ := 2

def innerRadius : ℝ := (2 : ℝ)⁻¹

def insideDomain : Set ℂ :=
  Metric.ball 0 radius

def outsideDomain : Set ℂ :=
  Metric.ball 0 radius \ {0}

def overlap : Set ℂ :=
  Metric.ball 0 radius \ Metric.closedBall 0 innerRadius

def insideCoefficient (n : ℕ) : ℂ :=
  if n = 1 then 1 else 0

def correctionCoefficient (n : ℕ) : ℂ :=
  if n = 0 then 2 else if n = 1 then 1 else 0

def outsideCoefficient (n : ℕ) : ℂ :=
  if n = 0 then 1 else 0

def insideExponent : ℕ := 1

def correctionConstantExponent : ℕ := 0

def correctionLinearExponent : ℕ := 1

def outsideLaurentShift : ℤ := -1

def insideValue (q : ℂ) : ℂ := q

def correctionValue (q : ℂ) : ℂ := 2 + q

def prototype (z : ℂ) : ℂ := z + 1

def outsideValue (w : ℂ) : ℂ := w⁻¹

def insideVariable (z : ℂ) : ℂ := z

def outsideVariable (z : ℂ) : ℂ := z⁻¹

def continuation (z : ℂ) : ℂ := z

theorem radius_pos : 0 < radius := by
  norm_num [radius]

theorem innerRadius_pos : 0 < innerRadius := by
  norm_num [innerRadius]

@[simp]
theorem insideCoefficient_at_one : insideCoefficient 1 = 1 := by
  simp [insideCoefficient]

@[simp]
theorem correctionCoefficient_at_zero : correctionCoefficient 0 = 2 := by
  simp [correctionCoefficient]

@[simp]
theorem correctionCoefficient_at_one : correctionCoefficient 1 = 1 := by
  simp [correctionCoefficient]

@[simp]
theorem outsideCoefficient_at_zero : outsideCoefficient 0 = 1 := by
  simp [outsideCoefficient]

theorem insideCoefficient_ne_zero : insideCoefficient ≠ 0 := by
  intro hzero
  have h := congrFun hzero 1
  simpa using h

theorem outsideCoefficient_ne_zero : outsideCoefficient ≠ 0 := by
  intro hzero
  have h := congrFun hzero 0
  simpa using h

theorem prototype_ne_zero : prototype ≠ 0 := by
  intro hzero
  have h := congrFun hzero 0
  norm_num [prototype] at h

namespace Function

/-- Compatibility predicate for an everywhere constant function. -/
def Constant {α β : Type*} (f : α → β) : Prop :=
  ∀ x y, f x = f y

end Function

theorem prototype_nonconstant : ¬ Function.Constant prototype := by
  intro hconstant
  have h := hconstant 0 1
  norm_num [prototype] at h

theorem correctionValue_nonconstant : ¬ Function.Constant correctionValue := by
  intro hconstant
  have h := hconstant 0 1
  norm_num [correctionValue] at h

@[simp]
theorem insideValue_eq_pow (q : ℂ) :
    insideValue q = q ^ insideExponent := by
  simp [insideValue, insideExponent]

@[simp]
theorem outsideValue_eq_zpow (w : ℂ) :
    outsideValue w = w ^ outsideLaurentShift := by
  simp [outsideValue, outsideLaurentShift]

/-! The three convergence proofs are finite-support calculations.  In
particular, no convergence statement is stored in a custom certificate before
these lemmas are established. -/

theorem inside_hasSum (q : ℂ) :
    HasSum (fun n : ℕ => insideCoefficient n * q ^ n) (insideValue q) := by
  convert (hasSum_ite_eq (1 : ℕ) q) using 1
  · funext n
    by_cases hn : n = 1
    · subst n
      simp [insideCoefficient]
    · simp [insideCoefficient, hn]
  · simp [insideValue]

theorem correction_hasSum (q : ℂ) :
    HasSum (fun n : ℕ => correctionCoefficient n * q ^ n)
      (correctionValue q) := by
  convert
      (hasSum_ite_eq (0 : ℕ) (2 : ℂ)).add
        (hasSum_ite_eq (1 : ℕ) q) using 1
  · funext n
    by_cases hzero : n = 0
    · subst n
      simp [correctionCoefficient]
    · by_cases hone : n = 1
      · subst n
        simp [correctionCoefficient]
      · simp [correctionCoefficient, hzero, hone]
  · simp [correctionValue]

theorem outside_hasSum (w : ℂ) :
    HasSum (fun n : ℕ => w⁻¹ * outsideCoefficient n * w ^ n)
      (outsideValue w) := by
  convert (hasSum_ite_eq (0 : ℕ) w⁻¹) using 1
  · funext n
    by_cases hn : n = 0
    · subst n
      simp [outsideCoefficient]
    · simp [outsideCoefficient, hn]
  · simp [outsideValue]

theorem inside_summable (q : ℂ) :
    Summable (fun n : ℕ => insideCoefficient n * q ^ n) :=
  (inside_hasSum q).summable

theorem correction_summable (q : ℂ) :
    Summable (fun n : ℕ => correctionCoefficient n * q ^ n) :=
  (correction_hasSum q).summable

theorem outside_summable (w : ℂ) :
    Summable (fun n : ℕ => w⁻¹ * outsideCoefficient n * w ^ n) :=
  (outside_hasSum w).summable

@[simp]
theorem inside_tsum_eq (q : ℂ) :
    (∑' n : ℕ, insideCoefficient n * q ^ n) = insideValue q :=
  (inside_hasSum q).tsum_eq

@[simp]
theorem correction_tsum_eq (q : ℂ) :
    (∑' n : ℕ, correctionCoefficient n * q ^ n) = correctionValue q :=
  (correction_hasSum q).tsum_eq

@[simp]
theorem outside_tsum_eq (w : ℂ) :
    (∑' n : ℕ, w⁻¹ * outsideCoefficient n * w ^ n) = outsideValue w :=
  (outside_hasSum w).tsum_eq

theorem correction_hasDerivAt (q : ℂ) :
    HasDerivAt correctionValue 1 q := by
  change HasDerivAt (fun z : ℂ => (2 : ℂ) + z) 1 q
  simpa using (hasDerivAt_id q).const_add (2 : ℂ)

theorem correctionValue_differentiable : Differentiable ℂ correctionValue := by
  intro q
  exact (correction_hasDerivAt q).differentiableAt

@[simp]
theorem correctionValue_at_zero : correctionValue 0 = 2 := by
  simp [correctionValue]

theorem prototype_differentiable : Differentiable ℂ prototype := by
  unfold prototype
  fun_prop

theorem insideDomain_open : IsOpen insideDomain := by
  exact Metric.isOpen_ball

theorem outsideDomain_open : IsOpen outsideDomain := by
  exact Metric.isOpen_ball.sdiff isClosed_singleton

theorem overlap_open : IsOpen overlap := by
  exact Metric.isOpen_ball.sdiff Metric.isClosed_closedBall

theorem insideDomain_nonempty : insideDomain.Nonempty := by
  refine ⟨0, ?_⟩
  norm_num [insideDomain, radius, Metric.mem_ball, dist_zero_right]

theorem outsideDomain_nonempty : outsideDomain.Nonempty := by
  refine ⟨1, ?_⟩
  norm_num [outsideDomain, radius, Metric.mem_ball, dist_zero_right]

theorem overlap_nonempty : overlap.Nonempty := by
  refine ⟨1, ?_⟩
  norm_num [overlap, radius, innerRadius, Metric.mem_ball,
    Metric.mem_closedBall, dist_zero_right]

theorem norm_bounds_of_mem_overlap {z : ℂ} (hz : z ∈ overlap) :
    innerRadius < ‖z‖ ∧ ‖z‖ < radius := by
  constructor
  · have hznot : ¬ ‖z‖ ≤ innerRadius := by
      simpa [overlap, Metric.mem_closedBall, dist_zero_right] using hz.2
    exact lt_of_not_ge hznot
  · simpa [overlap, Metric.mem_ball, dist_zero_right] using hz.1

theorem ne_zero_of_mem_overlap {z : ℂ} (hz : z ∈ overlap) : z ≠ 0 := by
  intro hzero
  have hlower := (norm_bounds_of_mem_overlap hz).1
  rw [hzero, norm_zero] at hlower
  exact (not_lt_of_ge (le_of_lt innerRadius_pos)) hlower

theorem ne_zero_of_mem_outsideDomain {w : ℂ}
    (hw : w ∈ outsideDomain) : w ≠ 0 := by
  intro hzero
  apply hw.2
  simpa [hzero]

theorem insideVariable_mem {z : ℂ} (hz : z ∈ overlap) :
    insideVariable z ∈ insideDomain := by
  simpa [insideVariable, insideDomain, Metric.mem_ball, dist_zero_right] using
    (norm_bounds_of_mem_overlap hz).2

theorem correctionVariable_mem {z : ℂ} (hz : z ∈ overlap) :
    insideVariable z ∈ insideDomain :=
  insideVariable_mem hz

theorem outsideVariable_mem {z : ℂ} (hz : z ∈ overlap) :
    outsideVariable z ∈ outsideDomain := by
  have hz0 : z ≠ 0 := ne_zero_of_mem_overlap hz
  have hnormPos : 0 < ‖z‖ := norm_pos_iff.mpr hz0
  have hradiusPos : 0 < radius := radius_pos
  have hinvNorm : ‖z‖⁻¹ < radius := by
    apply (inv_lt_comm₀ hnormPos hradiusPos).2
    simpa [radius, innerRadius] using (norm_bounds_of_mem_overlap hz).1
  change z⁻¹ ∈ Metric.ball 0 radius ∧ z⁻¹ ∉ ({0} : Set ℂ)
  constructor
  · simpa [Metric.mem_ball, dist_zero_right, norm_inv] using hinvNorm
  · simpa only [Set.mem_singleton_iff] using inv_ne_zero hz0

theorem variable_inverse {z : ℂ} (hz : z ∈ overlap) :
    insideVariable z * outsideVariable z = 1 := by
  simpa [insideVariable, outsideVariable] using
    (mul_inv_cancel₀ (ne_zero_of_mem_overlap hz))

@[simp]
theorem inside_realization (z : ℂ) :
    insideValue (insideVariable z) = continuation z :=
  rfl

@[simp]
theorem outside_realization (z : ℂ) :
    outsideValue (outsideVariable z) = continuation z := by
  simp [outsideValue, outsideVariable, continuation]

theorem dictionary_identity (z : ℂ) :
    continuation z =
      2 * prototype z - correctionValue (insideVariable z) := by
  simp only [continuation, prototype, correctionValue, insideVariable]
  ring

theorem inside_outside_identity (z : ℂ) :
    insideValue (insideVariable z) =
      outsideValue (outsideVariable z) := by
  simp [insideValue, insideVariable, outsideValue, outsideVariable]

/-! Only after the direct finite-sum and overlap calculations have been proved
do we construct the generic API objects. -/

def insideSeries : ConvergentQSeries where
  coefficient := insideCoefficient
  prefactor := fun _ => 1
  domain := insideDomain
  domain_open := insideDomain_open
  domain_nonempty := insideDomain_nonempty
  value := insideValue
  prefactor_differentiable :=
    (differentiable_const (1 : ℂ)).differentiableOn
  value_differentiable := differentiable_id.differentiableOn
  hasSum := by
    intro q _hq
    simpa only [one_mul] using inside_hasSum q

def correctionSeries : ConvergentQSeries where
  coefficient := correctionCoefficient
  prefactor := fun _ => 1
  domain := insideDomain
  domain_open := insideDomain_open
  domain_nonempty := insideDomain_nonempty
  value := correctionValue
  prefactor_differentiable :=
    (differentiable_const (1 : ℂ)).differentiableOn
  value_differentiable := correctionValue_differentiable.differentiableOn
  hasSum := by
    intro q _hq
    simpa only [one_mul] using correction_hasSum q

def outsideSeries : ConvergentQSeries where
  coefficient := outsideCoefficient
  prefactor := outsideValue
  domain := outsideDomain
  domain_open := outsideDomain_open
  domain_nonempty := outsideDomain_nonempty
  value := outsideValue
  prefactor_differentiable :=
    differentiableOn_inv.mono (fun _ hw => ne_zero_of_mem_outsideDomain hw)
  value_differentiable :=
    differentiableOn_inv.mono (fun _ hw => ne_zero_of_mem_outsideDomain hw)
  hasSum := by
    intro w _hw
    exact outside_hasSum w

def data : InsideOutsideSeriesData where
  inside := insideSeries
  correction := correctionSeries
  outside := outsideSeries
  prototype := prototype

def fixedMatch : InsideOutsideMatch data where
  overlap := overlap
  overlap_open := overlap_open
  overlap_nonempty := overlap_nonempty
  insideVariable := insideVariable
  outsideVariable := outsideVariable
  continuation := continuation
  insideVariable_differentiable := differentiable_id.differentiableOn
  outsideVariable_differentiable :=
    differentiableOn_inv.mono (fun _ hz => ne_zero_of_mem_overlap hz)
  continuation_differentiable := differentiable_id.differentiableOn
  prototype_differentiable := prototype_differentiable.differentiableOn
  inside_mem := fun _ hz => insideVariable_mem hz
  correction_mem := fun _ hz => correctionVariable_mem hz
  outside_mem := fun _ hz => outsideVariable_mem hz
  variable_inverse := fun _ hz => variable_inverse hz
  inside_eq_continuation := fun z _ => inside_realization z
  outside_eq_continuation := fun z _ => outside_realization z
  continuation_formula := fun z _ => dictionary_identity z

theorem fixedMatch_inside_eq_outside {z : ℂ}
    (hz : z ∈ fixedMatch.overlap) :
    data.inside.value (fixedMatch.insideVariable z) =
      data.outside.value (fixedMatch.outsideVariable z) :=
  fixedMatch.inside_eq_outside hz

theorem fixedMatch_inside_dictionary {z : ℂ}
    (hz : z ∈ fixedMatch.overlap) :
    data.inside.value (fixedMatch.insideVariable z) =
      2 * data.prototype z -
        data.correction.value (fixedMatch.insideVariable z) :=
  fixedMatch.inside_dictionary hz

end CorrectedLemmas.FixedDefinition10Model

/-! ### Cusp indexing does not choose Eisenstein/scattering normalization

The paper labels three cusps but never fixes the scalar normalization of its
Eisenstein family.  The ambiguity is visible before any analytic continuation:
both the cusp-indexed seed and its positive spectral measure can be rescaled.
The statements below are concrete function/measure inequalities, not fields of
a certificate. -/

namespace CorrectedLemmas.CuspSpectralNormalizationErratum

/-- Unit-normalized cusp-indexed seed. -/
def unitCuspSeed : Gamma2Cusp → ℝ → ℂ :=
  fun _ _ => 1

/-- The equally cusp-indexed seed obtained by scalar doubling. -/
def doubledCuspSeed : Gamma2Cusp → ℝ → ℂ :=
  fun _ _ => 2

theorem unitCuspSeed_ne_doubledCuspSeed :
    unitCuspSeed ≠ doubledCuspSeed := by
  intro h
  have hvalue := congrArg
    (fun E : Gamma2Cusp → ℝ → ℂ => E Gamma2Cusp.infinity 0) h
  norm_num [unitCuspSeed, doubledCuspSeed] at hvalue

/-- Unit Dirac measure at every labelled cusp. -/
noncomputable def unitCuspSpectralMeasure :
    Gamma2Cusp → Measure ℝ :=
  fun _ => Measure.dirac 0

/-- A different positive measure normalization on the same labelled cusps. -/
noncomputable def doubledCuspSpectralMeasure :
    Gamma2Cusp → Measure ℝ :=
  fun κ => 2 • unitCuspSpectralMeasure κ

@[simp]
theorem unitCuspSpectralMeasure_singleton_zero (κ : Gamma2Cusp) :
    unitCuspSpectralMeasure κ {0} = 1 := by
  rw [unitCuspSpectralMeasure,
    Measure.dirac_apply' 0 (MeasurableSet.singleton 0)]
  simp

@[simp]
theorem doubledCuspSpectralMeasure_singleton_zero (κ : Gamma2Cusp) :
    doubledCuspSpectralMeasure κ {0} = 2 := by
  rw [doubledCuspSpectralMeasure, Measure.smul_apply,
    unitCuspSpectralMeasure_singleton_zero]
  norm_num

theorem unitCuspSpectralMeasure_ne_doubled :
    unitCuspSpectralMeasure ≠ doubledCuspSpectralMeasure := by
  intro h
  have hmeasure := congrArg
    (fun μ : Gamma2Cusp → Measure ℝ =>
      μ Gamma2Cusp.infinity {0}) h
  rw [unitCuspSpectralMeasure_singleton_zero,
    doubledCuspSpectralMeasure_singleton_zero] at hmeasure
  norm_num at hmeasure

/-- Cusp indexing and positivity therefore do not determine either the
Eisenstein seed or the associated positive measure normalization. -/
theorem cuspIndexing_and_positivity_do_not_fix_normalization :
    unitCuspSeed ≠ doubledCuspSeed ∧
      unitCuspSpectralMeasure ≠ doubledCuspSpectralMeasure :=
  ⟨unitCuspSeed_ne_doubledCuspSeed,
    unitCuspSpectralMeasure_ne_doubled⟩

end CorrectedLemmas.CuspSpectralNormalizationErratum

