/-- Terminal corrected Proposition 10.  A concrete product projection supplies
the finite/polar decomposition, the intrinsic fixed-point/kernel uniqueness
property, and recovery of both product components. -/
theorem proposition10_explicitProjectedSplitting_complete_correctedAndProved :
    ∃ P : CorrectedLemmas.CorrectedPropositions.JacobiDictionary.SplitProjection
        ℂ (ℂ × ℂ),
      (∀ φ,
        P.finitePart φ + P.polarPart φ = φ) ∧
      (∀ φ finite polar,
        finite + polar = φ →
        P.finitePart finite = finite →
        P.finitePart polar = 0 →
        finite = P.finitePart φ ∧ polar = P.polarPart φ) ∧
      (∀ a b : ℂ,
        P.finitePart (a, b) = (a, 0) ∧
          P.polarPart (a, b) = (0, b)) := by
  let P : CorrectedLemmas.CorrectedPropositions.JacobiDictionary.SplitProjection
      ℂ (ℂ × ℂ) :=
    CorrectedLemmas.CorrectedPropositions.JacobiDictionary.SplitProjection.product
      (R := ℂ) (A := ℂ) (B := ℂ)
  refine ⟨P, ?_, ?_, ?_⟩
  · intro φ
    exact P.finitePart_add_polarPart φ
  · intro φ finite polar hsum hfinite hpolar
    exact P.decomposition_unique φ finite polar hsum hfinite hpolar
  · intro a b
    simpa [P] using
      CorrectedLemmas.CorrectedPropositions.JacobiDictionary.SplitProjection.product_recovers_both_components
        (R := ℂ) (A := ℂ) (B := ℂ) a b

