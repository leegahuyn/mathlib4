/-! ## Section 5.1 terminal closure ledger: Definitions 1--18

Definitions are judged by whether the corrected object is genuinely typed and
its defining laws have kernel proofs.  A definition does not by itself certify
existence of the PDF's omitted automorphic input.  Definition 3 is repaired by
fixing and certifying the explicit six-cell polygon above.  Literal Definition
1 is removed because its inverse-half-weight law is incompatible with its
unweighted quotient density; corrected weighted carriers and graph closures
are proved separately.  Definition 10, which purports to choose an unspecified
mock prototype, remains removed with an underdetermination erratum. -/

namespace Section51Closure

inductive Claim
  | definition1
  | definition2
  | definition3
  | definition4
  | definition5
  | definition6
  | definition7
  | definition8
  | definition9
  | definition10
  | definition11
  | definition12
  | definition13
  | definition14
  | definition15
  | definition16
  | definition17
  | definition18
  deriving DecidableEq, Repr

instance : Fintype Claim where
  elems := {.definition1, .definition2, .definition3, .definition4, .definition5, .definition6, .definition7, .definition8, .definition9, .definition10, .definition11, .definition12, .definition13, .definition14, .definition15, .definition16, .definition17, .definition18}
  complete := by
    intro x
    cases x <;> simp

inductive Disposition
  | proved
  | correctedAndProved
  | removedWithErratum
  deriving DecidableEq, Repr

def claimDisposition : Claim → Disposition
  | .definition1 => .removedWithErratum
  | .definition2 => .correctedAndProved
  | .definition3 => .correctedAndProved
  | .definition4 => .proved
  | .definition5 => .correctedAndProved
  | .definition6 => .correctedAndProved
  | .definition7 => .proved
  | .definition8 => .correctedAndProved
  | .definition9 => .correctedAndProved
  | .definition10 => .removedWithErratum
  | .definition11 => .correctedAndProved
  | .definition12 => .correctedAndProved
  | .definition13 => .correctedAndProved
  | .definition14 => .proved
  | .definition15 => .correctedAndProved
  | .definition16 => .correctedAndProved
  | .definition17 => .correctedAndProved
  | .definition18 => .correctedAndProved

theorem exhaustive (c : Claim) :
    claimDisposition c = .proved ∨
      claimDisposition c = .correctedAndProved ∨
      claimDisposition c = .removedWithErratum := by
  cases c <;> simp [claimDisposition]

