/-- Proof-producing kernel evidence for every Definition 1--18 row.  Corrected
rows expose a defining law or universal property; removed literal rows expose a
concrete obstruction while retaining their proved repaired models above. -/
def ClaimEvidence : Claim → Prop
  | .definition1 =>
      (‖(CorrectedLemmas.ZeroCuspThetaLift.zeroCuspLift.sqrtFactor
            CorrectedLemmas.ZeroCuspThetaLift.normTestPoint)⁻¹ * (1 : ℂ)‖ ≠
          ‖(1 : ℂ)‖) ∧
        CorrectedLemmas.GenuineSixCellWeightedL2.inverseAutomorphicL2Submodule
            CorrectedLemmas.GenuineGlobalThetaMultiplier.standardThetaMultiplier = ⊥ ∧
        CorrectedLemmas.GenuineAEAutomorphicSections.standardThetaClass ∈
          CorrectedLemmas.GenuineSixCellWeightedL2.positiveAutomorphicL2Submodule
            CorrectedLemmas.GenuineGlobalThetaMultiplier.standardThetaMultiplier
  | .definition2 =>
      ∀ {J : HalfWeightAutomorphyFactor} {μ : Measure UpperHalfPlane}
          {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
          [CompleteSpace H] {M : WeightedSobolevDatum J μ H}
          (f : DataSpace M),
        ∃! u : TrialSpace M,
          ∀ v, dualPairing f v = ⟪u, v⟫_ℂ
  | .definition3 => CorrectedDefinition3Certificate
  | .definition4 =>
      ∀ {D : ContinuousSpectralData} {ε : ℝ}, HMass D ε →
        ∃ m0, 1 ≤ m0 ∧ ∀ m, m0 ≤ m → 0 < massFunctional D m
  | .definition5 =>
      ∀ {X : Type*} [MeasurableSpace X] {D : RankinSelbergData X}
          (p : RankinSelbergDomain D),
        1 < p.1.2.re ∧ RankinSelbergConvergesAt D p.1.1 p.1.2
  | .definition6 =>
      ∀ (D : ContinuousSpectralData) (m : ℕ), 0 ≤ massFunctional D m
  | .definition7 =>
      ∀ {D : ContinuousSpectralData} {ε : ℝ} {m0 m : ℕ},
        MassConditionAt D ε m0 → m0 ≤ m → 0 < massFunctional D m
  | .definition8 =>
      (∀ {κ : Gamma2Cusp} (chart : CuspQChart κ)
          (laplacian :
            ({τ // τ ∈ chart.tauDomain} → ℂ) →
              {τ // τ ∈ chart.tauDomain} → ℂ)
          (u : {τ // τ ∈ chart.tauDomain} → ℂ),
        qLaplacian chart laplacian (pushFunction chart.coord.toEquiv u) =
          pushFunction chart.coord.toEquiv (laplacian u)) ∧
      (∀ {κ : Gamma2Cusp} (chart : CuspQChart κ)
          (laplacian :
            ({τ // τ ∈ chart.tauDomain} → ℂ) →
              {τ // τ ∈ chart.tauDomain} → ℂ)
          (F : {q // q ∈ chart.qDomain} → ℂ),
        pullFunction chart.coord.toEquiv (qLaplacian chart laplacian F) =
          laplacian (pullFunction chart.coord.toEquiv F)) ∧
      ∀ {κ : Gamma2Cusp} (chart : CuspQChart κ)
          (μ : Measure {τ // τ ∈ chart.tauDomain})
          {E : Type*} [NormedAddCommGroup E]
          (p : ENNReal) (u : {τ // τ ∈ chart.tauDomain} → E),
        MemLp (pushFunction chart.coord.toEquiv u) p
            (chart.transformedMeasure μ) ↔ MemLp u p μ
  | .definition9 =>
      (∀ {V Model : Type*}
          [AddCommGroup V] [Module ℂ V]
          [AddCommGroup Model] [Module ℂ Model]
          (L : QLocalSystem V Model) (r s t : RadialBase) (x : L.fiber r),
        L.transport s t (L.transport r s x) = L.transport r t x) ∧
      ∀ {V Model : Type*}
          [AddCommGroup V] [Module ℂ V]
          [AddCommGroup Model] [Module ℂ Model]
          (L : QLocalSystem V Model) (r : RadialBase),
        Nonempty (L.flatSections ≃ₗ[ℂ] Model)
  | .definition10 =>
      ∃ f g : ℂ → ℂ,
        CorrectedLemmas.MockPrototypeUnderspecification.HolomorphicPrototypeAtRadius
            1 f ∧
        CorrectedLemmas.MockPrototypeUnderspecification.HolomorphicPrototypeAtRadius
            1 g ∧ f ≠ g
  | .definition11 =>
      (∀ {V Model : Type*}
          [AddCommGroup V] [Module ℂ V]
          [AddCommGroup Model] [Module ℂ Model]
          (L : QLocalSystem V Model) (r s : RadialBase) (x : L.fiber r),
        L.transport s r (L.transport r s x) = x) ∧
      ∀ {V Model : Type*}
          [AddCommGroup V] [Module ℂ V]
          [AddCommGroup Model] [Module ℂ Model]
          [FiniteDimensional ℂ Model]
          (L : QLocalSystem V Model) (r s : RadialBase),
        Module.finrank ℂ (L.fiber r) = Module.finrank ℂ (L.fiber s)
  | .definition12 =>
      ∀ {X E F : Type*} {G G' : Type uSheafG} [TopologicalSpace X]
          [AddCommGroup E] [Module ℂ E]
          [AddCommGroup F] [Module ℂ F]
          [AddCommGroup G] [Module ℂ G]
          {L : LinearPresheaf X E} {M : LinearPresheaf X F}
          (S : QGaugeVariableSheaf X E F G L M)
          [AddCommGroup G'] [Module ℂ G']
          (T : LinearPresheaf X G') (hT : IsLinearSheaf T)
          (f : TensorPresheafMorphism L M T),
        ∃! g : LinearPresheafMorphism S.sheaf T,
          ∀ (U : TopologicalSpace.Opens X)
            (s : TensorPresheafSection L M U),
            g.app U (S.include.app U s) = f.app U s
  | .definition13 =>
      ∀ {L M : Type*}
          [AddCommGroup L] [Module ℂ L]
          [AddCommGroup M] [Module ℂ M]
          {D : RadialDerivation}
          {nablaL : AlgebraicRadialConnection D L}
          {nablaM : AlgebraicRadialConnection D M}
          (C : AlgebraicTensorRadialConnection D nablaL nablaM)
          (u : RadialBase → L) (m : RadialBase → M),
        C.connection.nabla (fun r => u r ⊗ₜ[ℂ] m r) =
          fun r => nablaL.nabla u r ⊗ₜ[ℂ] m r +
            u r ⊗ₜ[ℂ] nablaM.nabla m r
  | .definition14 =>
      (∀ {A B : Type*}
          [AddCommGroup A] [Module ℂ A]
          [AddCommGroup B] [Module ℂ B]
          (resIn resOut : A →ₗ[ℂ] B) (a : A),
        a ∈ balancedEqualizerAt resIn resOut ↔ resIn a = resOut a) ∧
      ∀ {X E F : Type*} [TopologicalSpace X]
          [AddCommGroup E] [Module ℂ E]
          [AddCommGroup F] [Module ℂ F]
          {P : LinearPresheaf X E} {Q : LinearPresheaf X F}
          (resIn resOut : LinearPresheafMorphism P Q),
        IsLinearSheaf P → IsLinearSheaf Q →
          IsBalancedPresheafSheaf resIn resOut
  | .definition15 =>
      ∀ {E : Type*} [AddCommGroup E] [Module ℂ E]
          (D : GaugeDescentAction E),
        qGaugeForms D =
          ⨅ γ : Gamma2Element, (D.pullback γ - D.transition γ).ker
  | .definition16 =>
      ∀ {OneForm₁ TwoForm₁ OneForm₂ TwoForm₂ : Type*}
          [AddCommGroup OneForm₁] [Module ℂ OneForm₁]
          [AddCommGroup TwoForm₁] [Module ℂ TwoForm₁]
          [AddCommGroup OneForm₂] [Module ℂ OneForm₂]
          [AddCommGroup TwoForm₂] [Module ℂ TwoForm₂]
          {C₁ : CurvatureCalculus OneForm₁ TwoForm₁}
          {C₂ : CurvatureCalculus OneForm₂ TwoForm₂}
          (f : CurvatureMorphism C₁ C₂) (A : OneForm₁),
        f.mapTwo (curvature C₁ A) = curvature C₂ (f.mapOne A)
  | .definition17 =>
      ∀ {OneForm TwoForm : Type*}
          [AddCommGroup OneForm] [Module ℂ OneForm]
          [AddCommGroup TwoForm] [Module ℂ TwoForm]
          (C : CurvatureCalculus OneForm TwoForm) (A : OneForm),
        qCurvature C A = curvature C A
  | .definition18 =>
      ∀ {OneForm TwoForm : Type*}
          [AddCommGroup OneForm] [Module ℂ OneForm]
          [AddCommGroup TwoForm] [Module ℂ TwoForm]
          {C : CurvatureCalculus OneForm TwoForm}
          (D : EffectiveActionDecomposition C) (A : OneForm),
        D.mass A = D.action A -
          D.energyOfCurvature (curvature C A) - D.remainder A

