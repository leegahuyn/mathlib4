/-! #### Unconditional locally finite periodization of ambient tests

The preceding maximal-adjoint argument used one deliberately minimal local-to-
global predicate.  We now discharge that predicate.  The construction is the
literal Poincare extension of a compact test supported in the open carrier.
It is indexed by the original arithmetic group, so the two central matrices
`1` and `-1` occur separately; the normalization `1 / 2` removes exactly this
finite action kernel.  Proper discontinuity makes the sum locally finite.
-/

namespace FixedPhaseEssentialCoreRoute

open MeasureTheory Set Function Topology
open scoped BigOperators
open HalfIntegralMultiplier
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators
open GammaTwoQuotientGreenBoundary
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseClosedOperators
open FixedPhaseClosedOperators.PhysicalLocalL2

/-- Membership in the ambient image of the open carrier is exactly membership
of the corresponding upper-half-plane point in the geometric carrier. -/
theorem coe_mem_ambientGammaTwoOpenCarrier_iff (z : ℍ) :
    (z : ℂ) ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier ↔
      z ∈ gammaTwoOpenCarrier := by
  constructor
  · rintro ⟨w, hw, hwz⟩
    have : w = z := UpperHalfPlane.coe_injective hwz
    simpa [this] using hw
  · intro hz
    exact ⟨z, hz, rfl⟩

/-- The nontrivial central element of `Gamma(2)`, bundled with the already
proved congruence certificate. -/
def gammaTwoCentralNegOne : GammaTwo :=
  ⟨(-1 : SL(2, ℤ)), neg_one_mem_gammaTwo⟩

@[simp]
theorem gammaTwoCentralNegOne_coe :
    ((gammaTwoCentralNegOne : GammaTwo) : SL(2, ℤ)) = -1 :=
  rfl

@[simp]
theorem gammaTwoCentralNegOne_smul (z : ℍ) :
    ((gammaTwoCentralNegOne : GammaTwo) : SL(2, ℤ)) • z = z := by
  simpa only [gammaTwoCentralNegOne_coe, one_smul] using
    ModularGroup.SL_neg_smul (1 : SL(2, ℤ)) z

theorem gammaTwoCentralNegOne_ne_one :
    gammaTwoCentralNegOne ≠ (1 : GammaTwo) := by
  intro h
  have h00 := congrArg
    (fun g : GammaTwo ↦ ((g : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 0) h
  norm_num [gammaTwoCentralNegOne] at h00

@[simp]
theorem gammaTwo_one_ne_centralNegOne :
    (1 : GammaTwo) ≠ gammaTwoCentralNegOne :=
  gammaTwoCentralNegOne_ne_one.symm

@[simp]
theorem gammaTwoCentralNegOne_inv :
    gammaTwoCentralNegOne⁻¹ = gammaTwoCentralNegOne := by
  apply Subtype.ext
  simp [gammaTwoCentralNegOne]

/-- A concrete point in the strict modular tile, used only to identify the
kernel of the action. -/
private def gammaTwoKernelTestPoint : ℍ :=
  ⟨2 * Complex.I, by norm_num⟩

private theorem gammaTwoKernelTestPoint_mem_fdo :
    gammaTwoKernelTestPoint ∈ ModularGroup.fdo := by
  constructor <;>
    norm_num [gammaTwoKernelTestPoint, Complex.normSq_apply]

/-- The effective action kills precisely the two central matrices `±I`.
This is proved from the strict modular-tile stabilizer theorem, rather than
being added as a representative-independence assumption. -/
theorem gammaTwo_eq_one_or_centralNegOne_of_effective_eq_one
    (gamma : GammaTwo)
    (hgamma : gammaTwoEffectiveElement gamma =
      (1 : GammaTwoEffective)) :
    gamma = 1 ∨ gamma = gammaTwoCentralNegOne := by
  have hfix : ((gamma : SL(2, ℤ)) • gammaTwoKernelTestPoint) =
      gammaTwoKernelTestPoint := by
    have h := congrArg
      (fun a : GammaTwoEffective ↦ a • gammaTwoKernelTestPoint) hgamma
    simpa only [gammaTwoEffectiveElement_smul, one_smul] using h
  have hpm : (gamma : SL(2, ℤ)) = 1 ∨
      (gamma : SL(2, ℤ)) = -1 :=
    ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo
      gammaTwoKernelTestPoint_mem_fdo
      (hfix.symm ▸ gammaTwoKernelTestPoint_mem_fdo)
  rcases hpm with h | h
  · left
    apply Subtype.ext
    simpa using h
  · right
    apply Subtype.ext
    simpa only [gammaTwoCentralNegOne_coe] using h

@[simp]
theorem inverseEtaPaperOrbitDenom_centralNegOne
    (z : ℍ) :
    inverseEtaPaperOrbitDenom gammaTwoCentralNegOne z = -1 := by
  simp [inverseEtaPaperOrbitDenom, gammaTwoCentralNegOne,
    UpperHalfPlane.denom]

/-- The fixed-phase total factor is trivial on the nontrivial action-kernel
element.  The even denominator power is essential here. -/
@[simp]
theorem inverseEtaPaperOrbitFactor_centralNegOne
    (m : ℤ) (z : ℍ) :
    inverseEtaPaperOrbitFactor m gammaTwoCentralNegOne z = 1 := by
  have heven : (-1 : ℂ) ^ ((2 : ℤ) * m) = 1 := by
    rw [zpow_mul]
    norm_num
  rw [inverseEtaPaperOrbitFactor,
    inverseEtaPaperOrbitMultiplier_factor,
    inverseEtaMultiplier_factor,
    gammaTwoCentralNegOne_smul,
    div_self (ModularForm.eta_ne_zero z.im_pos),
    inverseEtaPaperOrbitDenom_centralNegOne,
    heven, mul_one]

/-- The ambient test with the inverse Euclidean gauge inserted.  This is an
actual bundled compact test, so compactness and global real smoothness are
inherited from Mathlib's test-function API. -/
noncomputable def gammaTwoPeriodizationSeedCore
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  HalfWeightCompactCoordinateGreen.rpowMul
    (-euclideanGaugeExponent m) v

/-- Restriction of the preceding ambient seed to the upper half-plane. -/
noncomputable def gammaTwoPeriodizationSeed
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) : ℂ :=
  gammaTwoPeriodizationSeedCore m v (z : ℂ)

@[simp]
theorem gammaTwoPeriodizationSeed_apply
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) :
    gammaTwoPeriodizationSeed m v z =
      (((z.im ^ (-euclideanGaugeExponent m) : ℝ) : ℂ) *
        v (z : ℂ)) := by
  rfl

/-- Compact support of the seed viewed as a subset of the upper half-plane. -/
def gammaTwoPeriodizationSeedSupport
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) : Set ℍ :=
  {z | (z : ℂ) ∈ tsupport
    (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ)}

theorem gammaTwoPeriodizationSeedCore_tsupport_subset
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    tsupport (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ) ⊆
      tsupport (v : ℂ → ℂ) := by
  change tsupport
      (fun w : ℂ ↦
        HalfWeightCompactCoordinateGreen.rpowScale
          (-euclideanGaugeExponent m) w * v w) ⊆
    tsupport (v : ℂ → ℂ)
  exact tsupport_mul_subset_right

theorem gammaTwoPeriodizationSeedSupport_isCompact
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    IsCompact (gammaTwoPeriodizationSeedSupport m v) := by
  rw [UpperHalfPlane.isEmbedding_coe.isCompact_iff]
  have himage :
      UpperHalfPlane.coe '' gammaTwoPeriodizationSeedSupport m v =
        tsupport
          (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ) := by
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact hz
    · intro hw
      have hwUpper : 0 < w.im :=
        (gammaTwoPeriodizationSeedCore m v).tsupport_subset hw
      exact ⟨⟨w, hwUpper⟩, hw, rfl⟩
  rw [himage]
  exact (gammaTwoPeriodizationSeedCore m v).hasCompactSupport

theorem gammaTwoPeriodizationSeedSupport_subset_openCarrier
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier) :
    gammaTwoPeriodizationSeedSupport m v ⊆ gammaTwoOpenCarrier := by
  intro z hz
  apply (coe_mem_ambientGammaTwoOpenCarrier_iff z).mp
  exact hv (gammaTwoPeriodizationSeedCore_tsupport_subset m v hz)

theorem gammaTwoPeriodizationSeed_realSmooth
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    RealSmooth (gammaTwoPeriodizationSeed m v) := by
  unfold RealSmooth
  refine (gammaTwoPeriodizationSeedCore m v).contDiff.contDiffOn.congr ?_
  intro w hw
  simp [upperLift, gammaTwoPeriodizationSeed, Function.comp_def,
    UpperHalfPlane.ofComplex_apply_of_im_pos hw]

/-- Precomposition by an arithmetic Mobius transformation preserves the
real `C∞` regularity used by the Maass core. -/
theorem RealSmooth.comp_gammaTwo_smul
    {f : ℍ → ℂ} (hf : RealSmooth f) (gamma : GammaTwo) :
    RealSmooth (fun z ↦ f ((gamma : SL(2, ℤ)) • z)) := by
  unfold RealSmooth at hf ⊢
  have hMaps : Set.MapsTo (gammaTwoMoebiusChart gamma)
      UpperHalfPlane.upperHalfPlaneSet
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    change 0 < (gammaTwoMoebiusChart gamma w).im
    simpa [gammaTwoMoebiusChart, gammaTwoMoebiusCoordinate,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw] using
      (((gamma : SL(2, ℤ)) • (⟨w, hw⟩ : ℍ)).im_pos)
  have hInner : ContDiffOn ℝ ∞ (gammaTwoMoebiusChart gamma)
      UpperHalfPlane.upperHalfPlaneSet := by
    simpa [RealSmooth, upperLift, gammaTwoMoebiusChart,
      Function.comp_def] using
      gammaTwoMoebiusCoordinate_realSmooth gamma
  have hComp := hf.comp hInner hMaps
  exact hComp.congr (fun w hw ↦ by
    simp [upperLift, Function.comp_def, gammaTwoMoebiusChart,
      gammaTwoMoebiusCoordinate,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- One translate in the arithmetic Poincare extension. -/
noncomputable def gammaTwoPeriodizationTerm
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (gamma : GammaTwo) (z : ℍ) : ℂ :=
  inverseEtaPaperOrbitFactor m gamma
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) *
    gammaTwoPeriodizationSeed m v
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z)

theorem gammaTwoPeriodizationTerm_realSmooth
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (gamma : GammaTwo) :
    RealSmooth (gammaTwoPeriodizationTerm m v gamma) := by
  exact
    ((inverseEtaPaperOrbitFactor_realSmooth m gamma).comp_gammaTwo_smul gamma⁻¹).mul
    ((gammaTwoPeriodizationSeed_realSmooth m v).comp_gammaTwo_smul gamma⁻¹)

theorem support_gammaTwoPeriodizationTerm_subset
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (gamma : GammaTwo) :
    Function.support (gammaTwoPeriodizationTerm m v gamma) ⊆
      ((gamma • ·) '' gammaTwoPeriodizationSeedSupport m v) := by
  intro z hz
  have hseed : gammaTwoPeriodizationSeed m v
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) ≠ 0 := by
    intro hzero
    apply hz
    simp [gammaTwoPeriodizationTerm, hzero]
  refine ⟨((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z, ?_, ?_⟩
  · change
      ((((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z : ℍ) : ℂ) ∈
        tsupport
          (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ)
    exact subset_tsupport hseed
  · simp

theorem gammaTwoPeriodizationTerm_locallyFinite
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    LocallyFinite
      (fun gamma : GammaTwo ↦
        Function.support (gammaTwoPeriodizationTerm m v gamma)) :=
  (gammaTwo_compact_translates_locallyFinite
    (gammaTwoPeriodizationSeedSupport_isCompact m v)).subset
      (support_gammaTwoPeriodizationTerm_subset m v)

/-- A locally finite `finsum` of real-smooth upper-half-plane functions is
real smooth.  The proof reduces the sum near each point to a literal finite
sum and then uses the open embedding `ℍ → ℂ`. -/
theorem realSmooth_finsum_of_locallyFinite_support
    {iota : Type*} {f : iota → ℍ → ℂ}
    (hlocal : LocallyFinite (fun i ↦ Function.support (f i)))
    (hsmooth : ∀ i, RealSmooth (f i)) :
    RealSmooth (fun z ↦ ∑ᶠ i, f i z) := by
  unfold RealSmooth
  intro w hw
  let z : ℍ := ⟨w, hw⟩
  obtain ⟨t, htnhds, htfinite⟩ := hlocal z
  obtain ⟨U, hUt, hUopen, hzU⟩ := mem_nhds_iff.mp htnhds
  let I : Finset iota := htfinite.toFinset
  have hAmbientNhds : UpperHalfPlane.coe '' U ∈ 𝓝 (z : ℂ) := by
    apply (UpperHalfPlane.isOpenEmbedding_coe.isOpenMap U hUopen).mem_nhds
    exact ⟨z, hzU, rfl⟩
  have hEq :
      upperLift (fun z : ℍ ↦ ∑ᶠ i, f i z) =ᶠ[𝓝 (z : ℂ)]
        upperLift (fun z : ℍ ↦ ∑ i ∈ I, f i z) := by
    filter_upwards [hAmbientNhds] with y hy
    rcases hy with ⟨x, hxU, rfl⟩
    simp only [upperLift_apply]
    apply finsum_eq_sum_of_support_subset
    intro i hi
    rw [htfinite.mem_toFinset]
    exact ⟨x, hi, hUt hxU⟩
  have hFiniteSmooth :
      ContDiffWithinAt ℝ ∞
        (upperLift (fun z : ℍ ↦ ∑ i ∈ I, f i z))
        UpperHalfPlane.upperHalfPlaneSet (z : ℂ) := by
    simpa only [upperLift, Function.comp_def, Finset.sum_apply] using
      (ContDiffWithinAt.sum fun i hi ↦
        (hsmooth i) (z : ℂ) z.im_pos)
  exact hFiniteSmooth.congr_of_eventuallyEq_of_mem
    (hEq.filter_mono nhdsWithin_le_nhds) z.im_pos

/-- The normalized, locally finite arithmetic Poincare periodization. -/
noncomputable def gammaTwoPoincarePeriodization
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) : ℂ :=
  (1 / 2 : ℂ) *
    ∑ᶠ gamma : GammaTwo, gammaTwoPeriodizationTerm m v gamma z

theorem gammaTwoPoincarePeriodization_realSmooth
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    RealSmooth (gammaTwoPoincarePeriodization m v) := by
  have hsum : RealSmooth
      (fun z ↦ ∑ᶠ gamma : GammaTwo,
        gammaTwoPeriodizationTerm m v gamma z) :=
    realSmooth_finsum_of_locallyFinite_support
      (gammaTwoPeriodizationTerm_locallyFinite m v)
      (gammaTwoPeriodizationTerm_realSmooth m v)
  simpa [gammaTwoPoincarePeriodization, Pi.smul_apply, smul_eq_mul] using
    hsum.const_complex_smul (1 / 2 : ℂ)

/-- Multiplying the index on the left and translating the evaluation point
produces exactly the total automorphy factor. -/
theorem gammaTwoPeriodizationTerm_mul_smul
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (delta gamma : GammaTwo) (z : ℍ) :
    gammaTwoPeriodizationTerm m v (delta * gamma)
        ((delta : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitFactor m delta z *
        gammaTwoPeriodizationTerm m v gamma z := by
  have hx :
      ((((delta * gamma)⁻¹ : GammaTwo) : SL(2, ℤ)) •
          ((delta : SL(2, ℤ)) • z) : ℍ) =
        ((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z := by
    simp [mul_smul]
  have hfactor :
      inverseEtaPaperOrbitFactor m (delta * gamma)
          (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) =
        inverseEtaPaperOrbitFactor m delta z *
          inverseEtaPaperOrbitFactor m gamma
            (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) := by
    simpa only [inverseEtaPaperOrbitFactor, map_inv, smul_inv_smul] using
      (HalfIntegralMultiplier.factor_mul
        (inverseEtaPaperOrbitMultiplier GammaTwo m)
        delta gamma
        (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z))
  unfold gammaTwoPeriodizationTerm
  rw [hx, hfactor]
  ring

theorem gammaTwoPoincarePeriodization_covariance
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (delta : GammaTwo) (z : ℍ) :
    gammaTwoPoincarePeriodization m v ((delta : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo m).factor delta z *
        gammaTwoPoincarePeriodization m v z := by
  have hreindex :
      (∑ᶠ gamma : GammaTwo,
          gammaTwoPeriodizationTerm m v gamma
            ((delta : SL(2, ℤ)) • z)) =
        ∑ᶠ gamma : GammaTwo,
          gammaTwoPeriodizationTerm m v (delta * gamma)
            ((delta : SL(2, ℤ)) • z) := by
    symm
    simpa only [Equiv.coe_mulLeft] using
      (finsum_comp_equiv (Equiv.mulLeft delta)
        (f := fun gamma : GammaTwo ↦
          gammaTwoPeriodizationTerm m v gamma
            ((delta : SL(2, ℤ)) • z)))
  rw [gammaTwoPoincarePeriodization, hreindex]
  simp_rw [gammaTwoPeriodizationTerm_mul_smul]
  rw [← mul_finsum]
  change (1 / 2 : ℂ) *
      (inverseEtaPaperOrbitFactor m delta z *
        ∑ᶠ gamma : GammaTwo,
          gammaTwoPeriodizationTerm m v gamma z) = _
  unfold inverseEtaPaperOrbitFactor
  ring

theorem support_gammaTwoPoincarePeriodization_subset_iUnion
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    Function.support (gammaTwoPoincarePeriodization m v) ⊆
      ⋃ gamma : GammaTwo,
        ((gamma • ·) '' gammaTwoPeriodizationSeedSupport m v) := by
  intro z hz
  by_contra hnot
  have hall : ∀ gamma : GammaTwo,
      gammaTwoPeriodizationTerm m v gamma z = 0 := by
    intro gamma
    by_contra hterm
    apply hnot
    exact Set.mem_iUnion.2
      ⟨gamma, support_gammaTwoPeriodizationTerm_subset m v hterm⟩
  apply hz
  simp [gammaTwoPoincarePeriodization, hall]

theorem gammaTwoPoincarePeriodization_quotientCompact
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    HasQuotientCompactSupport (gammaTwoPoincarePeriodization m v) := by
  let K := gammaTwoPeriodizationSeedSupport m v
  have hK : IsCompact K :=
    gammaTwoPeriodizationSeedSupport_isCompact m v
  have hQK : IsCompact (gammaTwoQuotientMk '' K) :=
    hK.image gammaTwoQuotientMk_isOpenQuotientMap.continuous
  apply hQK.of_isClosed_subset isClosed_closure
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    have hzUnion :=
      support_gammaTwoPoincarePeriodization_subset_iUnion m v hz
    rcases Set.mem_iUnion.1 hzUnion with ⟨gamma, x, hxK, hzx⟩
    refine ⟨x, hxK, ?_⟩
    rw [← hzx]
    exact gammaTwoQuotientMk_gamma_smul gamma x
  · exact hQK.isClosed

/-- The periodized seed as an element of the raw smooth quotient-compact
domain. -/
noncomputable def gammaTwoPeriodizedRaw
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    SmoothQuotientCompactFunction :=
  ⟨⟨gammaTwoPoincarePeriodization m v,
      gammaTwoPoincarePeriodization_realSmooth m v⟩,
    gammaTwoPoincarePeriodization_quotientCompact m v⟩

theorem gammaTwoPeriodizedRaw_covariant
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    IsInverseEtaPaperOrbitCovariant m (gammaTwoPeriodizedRaw m v) := by
  intro gamma z
  exact gammaTwoPoincarePeriodization_covariance m v gamma z

/-- The all-word physical core vector supplied by the periodization. -/
noncomputable def gammaTwoPeriodizedPhysicalCore
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m :=
  ⟨gammaTwoPeriodizedRaw m v,
    (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff
      m (gammaTwoPeriodizedRaw m v)).2
        (gammaTwoPeriodizedRaw_covariant m v)⟩

@[simp]
theorem gammaTwoPeriodizationTerm_one
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) :
    gammaTwoPeriodizationTerm m v 1 z =
      gammaTwoPeriodizationSeed m v z := by
  simp [gammaTwoPeriodizationTerm, inverseEtaPaperOrbitFactor]

@[simp]
theorem gammaTwoPeriodizationTerm_centralNegOne
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) :
    gammaTwoPeriodizationTerm m v gammaTwoCentralNegOne z =
      gammaTwoPeriodizationSeed m v z := by
  simp [gammaTwoPeriodizationTerm]

/-- At a point of the open carrier, no translate outside the two-element
action kernel can contribute to the Poincare sum. -/
theorem support_periodizationIndex_at_openCarrier
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier)
    {z : ℍ} (hz : z ∈ gammaTwoOpenCarrier) :
    Function.support
        (fun gamma : GammaTwo ↦
          gammaTwoPeriodizationTerm m v gamma z) ⊆
      ({1, gammaTwoCentralNegOne} : Finset GammaTwo) := by
  intro gamma hgamma
  have hseed : gammaTwoPeriodizationSeed m v
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) ≠ 0 := by
    intro hzero
    apply hgamma
    simp [gammaTwoPeriodizationTerm, hzero]
  have hxK : (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) ∈
      gammaTwoPeriodizationSeedSupport m v := by
    change
      (((((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z : ℍ) : ℂ) ∈
        tsupport
          (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ))
    exact subset_tsupport hseed
  have hxOpen : (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z) ∈
      gammaTwoOpenCarrier :=
    gammaTwoPeriodizationSeedSupport_subset_openCarrier hv hxK
  let a : GammaTwoEffective := gammaTwoEffectiveElement gamma
  have hzTranslate : z ∈ a • gammaTwoOpenCarrier := by
    rw [Set.mem_smul_set]
    refine ⟨((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • z,
      hxOpen, ?_⟩
    simp [a, gammaTwoEffectiveElement_smul]
  have ha : a = 1 := by
    by_contra hane
    exact Set.disjoint_left.1
      (gammaTwoOpenCarrier_disjoint a hane) hzTranslate hz
  have hkernel :=
    gammaTwo_eq_one_or_centralNegOne_of_effective_eq_one gamma ha
  simpa only [Finset.mem_insert, Finset.mem_singleton] using hkernel

/-- The normalized sum restricts to the original inverse-gauge seed on the
open carrier. -/
theorem gammaTwoPoincarePeriodization_eq_seed_on_openCarrier
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier)
    {z : ℍ} (hz : z ∈ gammaTwoOpenCarrier) :
    gammaTwoPoincarePeriodization m v z =
      gammaTwoPeriodizationSeed m v z := by
  unfold gammaTwoPoincarePeriodization
  rw [finsum_eq_sum_of_support_subset _
    (support_periodizationIndex_at_openCarrier hv hz)]
  simp [gammaTwoCentralNegOne_ne_one]
  ring

/-- Multiplication by the Euclidean gauge exactly cancels the inverse gauge
inserted in the seed. -/
theorem fixedPhaseEuclideanGauge_periodized_eq_ambientTest
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier)
    {z : ℍ} (hz : z ∈ gammaTwoOpenCarrier) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
        (gammaTwoPeriodizedPhysicalCore m v) z = v (z : ℂ) := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply]
  change (((z.im ^ euclideanGaugeExponent m : ℝ) : ℂ) *
      gammaTwoPoincarePeriodization m v z) = v (z : ℂ)
  rw [gammaTwoPoincarePeriodization_eq_seed_on_openCarrier hv hz,
    gammaTwoPeriodizationSeed_apply,
    Real.rpow_neg z.im_pos.le]
  have hp : z.im ^ euclideanGaugeExponent m ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos z.im_pos _)
  have hcancel :
      ((z.im ^ euclideanGaugeExponent m : ℝ) : ℂ) *
          (((z.im ^ euclideanGaugeExponent m)⁻¹ : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul]
    simp [hp]
  rw [← mul_assoc, hcancel, one_mul]

/-- The minimal ambient-test periodization predicate is therefore a theorem
at every fixed-phase index. -/
theorem ambientTestPhysicalGaugePeriodizationAt_unconditional
    (m : ℤ) : AmbientTestPhysicalGaugePeriodizationAt m := by
  intro v hv
  refine ⟨gammaTwoPeriodizedPhysicalCore m v, ?_⟩
  intro w hw
  rcases hw with ⟨z, hz, rfl⟩
  rw [SmoothCompactCoreGeometry.upperLift_apply]
  exact fixedPhaseEuclideanGauge_periodized_eq_ambientTest hv hz

/-- Simultaneous unconditional periodization along the whole fixed-phase
tower. -/
theorem ambientTestPhysicalGaugePeriodization_unconditional :
    AmbientTestPhysicalGaugePeriodization :=
  ambientTestPhysicalGaugePeriodizationAt_unconditional

/-- Consequently both maximal-adjoint weak Maass identifications are now
unconditional; no local-to-global certificate remains in either statement. -/
theorem raisingMaximalAdjointWeakMaassIdentificationAt_unconditional
    (n : ℤ) : RaisingMaximalAdjointWeakMaassIdentificationAt n :=
  raisingMaximalAdjointWeakMaassIdentificationAt_of_periodization
    (ambientTestPhysicalGaugePeriodizationAt_unconditional (n + 1))

theorem loweringMaximalAdjointWeakMaassIdentificationAt_unconditional
    (n : ℤ) : LoweringMaximalAdjointWeakMaassIdentificationAt n :=
  loweringMaximalAdjointWeakMaassIdentificationAt_of_periodization
    (ambientTestPhysicalGaugePeriodizationAt_unconditional n)

end FixedPhaseEssentialCoreRoute

