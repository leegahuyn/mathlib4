/-!
### P3.12: compact physical graphs and the bounded-commutator cutoff mechanism

There are two logically separate points in a maximal-domain cutoff argument.
First, literal smooth physical graph vectors really do have compact support in
the chosen Euclidean carrier; this follows from quotient-compact support and
the already proved properness of the selected closed carrier.  Second, a
bounded multiplier preserves the graph of a Hilbert adjoint only after its
commutator with the opposite core operator has been identified.  Merely
multiplying both graph coordinates by the same cutoff is not valid.

The results below prove both facts at the exact level needed by P3.7.  The
generic `AdjointCutoffExhaustion` theorem reduces invariant maximal-domain
localization to three checkable analytic estimates: strong convergence of the
two bounded multipliers, strong disappearance of the adjoint commutator, and
compact support of the localized pair.  In particular, it makes explicit why
the pointwise stabilization theorem for an already quotient-compact smooth
core vector does not by itself localize an arbitrary maximal graph vector.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseAdjointCutoffCore

open Set Function Topology Filter MeasureTheory
open scoped LinearPMap
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseClosedOperators
open FixedPhaseEssentialCoreAudit
open FixedPhaseEssentialCoreRoute
open FixedPhaseDensity

/-! #### Literal compact carrier support of every smooth physical coordinate -/

/-- A fixed-phase smooth base coordinate has an a.e. representative supported
in one compact subset of the selected Euclidean carrier.  The compact set is
not chosen ad hoc: it is the intersection of the closed six-tile carrier with
the inverse image of the genuine quotient topological support. -/
theorem l2Coordinate_hasCompactCarrierSupport
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    HasCompactCarrierSupport n (l2Coordinate n u) := by
  let K : Set ℍ :=
    gammaTwoClosedTileCarrier ∩
      gammaTwoQuotientMk ⁻¹'
        quotientTSupport
          (((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
  refine ⟨K, ?_, ?_⟩
  · exact gammaTwoClosedCarrier_inter_preimage_isCompact _
      (u : SmoothQuotientCompactFunction).2
  · filter_upwards [
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u,
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ae_mem_open_chosenEuclidean]
      with z hzGauge hzOpen
    intro hzK
    rw [hzGauge, Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply]
    have huZero :
        (u : SmoothQuotientCompactFunction) z = 0 := by
      by_contra huNe
      have hqSupport : gammaTwoQuotientMk z ∈
          quotientTSupport
            (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) :=
        subset_closure ⟨z, huNe, rfl⟩
      exact hzK
        ⟨gammaTwoOpenCarrier_subset_closedTileCarrier hzOpen, hqSupport⟩
    rw [huZero, mul_zero]

/-! #### The actual bounded Petersson cutoff multipliers -/

/-- The smooth cusp cutoff followed by the physical Petersson coordinate,
still defined on the literal fixed-phase core. -/
noncomputable def peterssonCuspCutoffCoreMap (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (cuspCutoffOperator N n)

@[simp]
theorem peterssonCuspCutoffCoreMap_apply
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    peterssonCuspCutoffCoreMap N n u =
      l2Coordinate n (cuspCutoffOperator N n u) :=
  rfl

/-- The invariant real cutoff is a contraction in the actual Petersson
`L²` norm.  The proof is pointwise in the isometric Euclidean gauge and uses
the genuine bound `0 ≤ smoothTransition ≤ 1`. -/
theorem norm_peterssonCuspCutoffCoreMap_le
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖peterssonCuspCutoffCoreMap N n u‖ ≤ ‖l2Coordinate n u‖ := by
  calc
    ‖peterssonCuspCutoffCoreMap N n u‖ =
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n (cuspCutoffOperator N n u))‖ := by
      rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm]
      rfl
    _ ≤ ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n u)‖ := by
      apply MeasureTheory.Lp.norm_le_norm_of_ae_le
      filter_upwards [
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (cuspCutoffOperator N n u),
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u]
          with z hzCut hzBase
      rw [hzCut, hzBase,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        cuspCutoffOperator_apply]
      have hCutoffNorm : ‖upstairsCuspCutoff N z‖ ≤ 1 := by
        rw [upstairsCuspCutoff_ofReal, Complex.norm_real,
          Real.norm_of_nonneg (Real.smoothTransition.nonneg _)]
        exact Real.smoothTransition.le_one _
      calc
        ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
            (upstairsCuspCutoff N z *
              (u : SmoothQuotientCompactFunction) z)‖ =
            ‖upstairsCuspCutoff N z‖ *
              ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
                (u : SmoothQuotientCompactFunction) z‖ := by
          simp only [norm_mul]
          ring
        _ ≤ 1 *
              ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
                (u : SmoothQuotientCompactFunction) z‖ :=
          mul_le_mul_of_nonneg_right hCutoffNorm (norm_nonneg _)
        _ = ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
                (u : SmoothQuotientCompactFunction) z‖ := one_mul _
    _ = ‖l2Coordinate n u‖ :=
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm n _

/-- Continuous extension of multiplication by the literal cusp cutoff from
the dense smooth Petersson core to the full Petersson Hilbert space. -/
noncomputable def peterssonCuspCutoff (N : ℕ) (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ] OrbitPeterssonHilbert n :=
  (peterssonCuspCutoffCoreMap N n).extendOfNorm (l2Coordinate n)

@[simp]
theorem peterssonCuspCutoff_l2Coordinate
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    peterssonCuspCutoff N n (l2Coordinate n u) =
      l2Coordinate n (cuspCutoffOperator N n u) := by
  exact LinearMap.extendOfNorm_eq (denseRange_l2Coordinate n)
    ⟨1, fun v ↦ by
      simpa only [one_mul] using
        norm_peterssonCuspCutoffCoreMap_le N n v⟩ u

theorem norm_peterssonCuspCutoff_apply_le
    (N : ℕ) (n : ℤ) (x : OrbitPeterssonHilbert n) :
    ‖peterssonCuspCutoff N n x‖ ≤ ‖x‖ := by
  simpa only [one_mul] using
    LinearMap.norm_extendOfNorm_apply_le
      (denseRange_l2Coordinate n) 1
      (fun v ↦ by
        simpa only [one_mul] using
          norm_peterssonCuspCutoffCoreMap_le N n v) x

theorem peterssonCuspCutoff_opNorm_le_one (N : ℕ) (n : ℤ) :
    ‖peterssonCuspCutoff N n‖ ≤ 1 := by
  exact LinearMap.opNorm_extendOfNorm_le
    (denseRange_l2Coordinate n) zero_le_one
    (fun v ↦ by
      simpa only [one_mul] using
        norm_peterssonCuspCutoffCoreMap_le N n v)

/-- On smooth core vectors the real cutoff is symmetric for the exact
Petersson inner product. -/
theorem inner_peterssonCuspCutoffCoreMap
    (N : ℕ) (n : ℤ)
    (u v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    inner ℂ (peterssonCuspCutoffCoreMap N n u) (l2Coordinate n v) =
      inner ℂ (l2Coordinate n u) (peterssonCuspCutoffCoreMap N n v) := by
  calc
    inner ℂ (peterssonCuspCutoffCoreMap N n u) (l2Coordinate n v) =
        inner ℂ
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
            (l2Coordinate n (cuspCutoffOperator N n u)))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
            (l2Coordinate n v)) := by
      symm
      exact (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map _ _
    _ = inner ℂ
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
            (l2Coordinate n u))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
            (l2Coordinate n (cuspCutoffOperator N n v))) := by
      rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (cuspCutoffOperator N n u),
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n v,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (cuspCutoffOperator N n v)]
          with z hCutU hV hU hCutV
      rw [hCutU, hV, hU, hCutV,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        cuspCutoffOperator_apply, cuspCutoffOperator_apply]
      change star
          (((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
            (upstairsCuspCutoff N z *
              (u : SmoothQuotientCompactFunction) z)) *
            (((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
              (v : SmoothQuotientCompactFunction) z) =
        star
          (((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
            (u : SmoothQuotientCompactFunction) z) *
            (((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) *
              (upstairsCuspCutoff N z *
                (v : SmoothQuotientCompactFunction) z))
      have hReal : star (upstairsCuspCutoff N z) =
          upstairsCuspCutoff N z := by
        simp only [upstairsCuspCutoff, Complex.conj_ofReal]
      simp only [map_mul, hReal]
      ring
    _ = inner ℂ (l2Coordinate n u)
          (peterssonCuspCutoffCoreMap N n v) :=
      (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map _ _

/-- The completed real cutoff is genuinely self-adjoint.  Density is used in
both Hilbert variables; no pointwise representative is assigned to a general
completion vector. -/
theorem peterssonCuspCutoff_isSelfAdjoint (N : ℕ) (n : ℤ) :
    IsSelfAdjoint (peterssonCuspCutoff N n) := by
  apply LinearMap.IsSymmetric.isSelfAdjoint
  intro x y
  refine (denseRange_l2Coordinate n).induction_on x
    (isClosed_eq
      ((peterssonCuspCutoff N n).continuous.inner continuous_const)
      (continuous_id.inner continuous_const)) ?_
  intro u
  refine (denseRange_l2Coordinate n).induction_on y
    (isClosed_eq
      (continuous_const.inner continuous_id)
      (continuous_const.inner (peterssonCuspCutoff N n).continuous)) ?_
  intro v
  rw [peterssonCuspCutoff_l2Coordinate,
    peterssonCuspCutoff_l2Coordinate]
  exact inner_peterssonCuspCutoffCoreMap N n u v

theorem adjoint_peterssonCuspCutoff (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint (peterssonCuspCutoff N n) =
      peterssonCuspCutoff N n :=
  (peterssonCuspCutoff_isSelfAdjoint N n).adjoint_eq

/-- The completed cutoff family converges strongly to the identity on every
Petersson vector.  Uniform contractivity and exact eventual stabilization on
the dense smooth core give the standard two-error argument. -/
theorem peterssonCuspCutoff_tendsto_id
    (n : ℤ) (x : OrbitPeterssonHilbert n) :
    Filter.Tendsto (fun N ↦ peterssonCuspCutoff N n x) Filter.atTop (nhds x) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨u, hu⟩ := (denseRange_l2Coordinate n).exists_dist_lt x (ε / 2)
  obtain ⟨N, hN⟩ := exists_cuspCutoffOperator_eventually_eq n u
  refine ⟨N, ?_⟩
  intro M hM
  have hCore :
      peterssonCuspCutoff M n (l2Coordinate n u) =
        l2Coordinate n u := by
    rw [peterssonCuspCutoff_l2Coordinate, hN M hM]
  have hApproxOne : ‖x - l2Coordinate n u‖ < ε / 2 := by
    simpa only [dist_eq_norm, norm_sub_rev] using hu
  have hApproxTwo : ‖l2Coordinate n u - x‖ < ε / 2 := by
    simpa only [dist_eq_norm] using hu
  have hRewrite :
      peterssonCuspCutoff M n x - x =
        peterssonCuspCutoff M n (x - l2Coordinate n u) +
          (l2Coordinate n u - x) := by
    rw [map_sub, hCore]
    abel
  rw [dist_eq_norm, hRewrite]
  calc
    ‖peterssonCuspCutoff M n (x - l2Coordinate n u) +
        (l2Coordinate n u - x)‖ ≤
        ‖peterssonCuspCutoff M n (x - l2Coordinate n u)‖ +
          ‖l2Coordinate n u - x‖ := norm_add_le _ _
    _ ≤ ‖x - l2Coordinate n u‖ +
          ‖l2Coordinate n u - x‖ :=
      add_le_add_right
        (norm_peterssonCuspCutoff_apply_le M n
          (x - l2Coordinate n u)) _
    _ < ε / 2 + ε / 2 := add_lt_add hApproxOne hApproxTwo
    _ = ε := by ring

/-! #### Fixed-stage bounded Maass commutators

The cutoff commutator is a zeroth-order multiplier after passage to the
isometric Euclidean gauge.  The raising and lowering coefficients below are
the two conjugate hyperbolic directional derivatives of the real cutoff.  At
every fixed cutoff level they have quotient-compact support and hence a finite
supremum on the selected closed carrier.  This gives honest bounded operators
on the completed Petersson spaces, without assuming a Sobolev estimate.

No uniform-in-`N` estimate is claimed here.  Such an estimate is exactly what
would be needed to pass eventual vanishing on the smooth core to strong
convergence on the entire completed `L²` space.
-/

open HalfWeightDifferentialOperators

/-- Euclidean-gauge coefficient of the raising cutoff commutator. -/
noncomputable def raiseCuspEuclideanCommutatorCoefficient
    (N : ℕ) (z : ℍ) : ℂ :=
  heightC z * raiseRaw 0 (upstairsCuspCutoff N) z

/-- Euclidean-gauge coefficient of the lowering cutoff commutator.  The
factor `y⁻¹` is the change from source to predecessor Petersson gauge. -/
noncomputable def lowerCuspEuclideanCommutatorCoefficient
    (N : ℕ) (z : ℍ) : ℂ :=
  (heightC z)⁻¹ * lowerRaw 0 (upstairsCuspCutoff N) z

theorem raiseCuspEuclideanCommutatorCoefficient_realSmooth (N : ℕ) :
    RealSmooth (raiseCuspEuclideanCommutatorCoefficient N) := by
  exact realSmooth_heightC.mul
    (realSmooth_raiseRaw 0 (upstairsCuspCutoff_realSmooth N))

theorem lowerCuspEuclideanCommutatorCoefficient_realSmooth (N : ℕ) :
    RealSmooth (lowerCuspEuclideanCommutatorCoefficient N) := by
  exact (realSmooth_heightC.inv heightC_ne_zero).mul
    (realSmooth_lowerRaw 0 (upstairsCuspCutoff_realSmooth N))

theorem raiseCuspEuclideanCommutatorCoefficient_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport
      (raiseCuspEuclideanCommutatorCoefficient N) := by
  simpa only [raiseCuspEuclideanCommutatorCoefficient, mul_comm] using
    ((upstairsCuspCutoff_quotientCompact N).raiseRaw 0).mul_right heightC

theorem lowerCuspEuclideanCommutatorCoefficient_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport
      (lowerCuspEuclideanCommutatorCoefficient N) := by
  simpa only [lowerCuspEuclideanCommutatorCoefficient, mul_comm] using
    ((upstairsCuspCutoff_quotientCompact N).lowerRaw 0).mul_right
      (fun z ↦ (heightC z)⁻¹)

/-- Any continuous quotient-compact scalar multiplier has a finite norm bound
on the actual closed six-tile carrier.  The proof uses the compact lift of its
quotient topological support; it does not treat the noncompact carrier itself
as compact. -/
theorem exists_closedCarrier_norm_bound_of_quotientCompact
    {f : ℍ → ℂ} (hf : Continuous f)
    (hCompact : HasQuotientCompactSupport f) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℍ,
      z ∈ gammaTwoClosedTileCarrier → ‖f z‖ ≤ C := by
  let K : Set ℍ :=
    gammaTwoClosedTileCarrier ∩
      gammaTwoQuotientMk ⁻¹' quotientTSupport f
  have hK : IsCompact K :=
    gammaTwoClosedCarrier_inter_preimage_isCompact
      (quotientTSupport f) hCompact
  by_cases hNonempty : K.Nonempty
  · obtain ⟨z₀, hz₀, hz₀Max⟩ := hK.exists_isMaxOn hNonempty
      hf.norm.continuousOn
    refine ⟨‖f z₀‖, norm_nonneg _, fun z hzCarrier ↦ ?_⟩
    by_cases hz : f z = 0
    · simp only [hz, norm_zero]
      exact norm_nonneg _
    · apply isMaxOn_iff.mp hz₀Max
      exact ⟨hzCarrier, subset_closure ⟨z, hz, rfl⟩⟩
  · refine ⟨0, le_rfl, fun z hzCarrier ↦ ?_⟩
    have hz : f z = 0 := by
      by_contra hzNe
      exact hNonempty ⟨z, hzCarrier, subset_closure ⟨z, hzNe, rfl⟩⟩
    simp only [hz, norm_zero]

/-- A canonical finite carrier bound for the fixed-stage raising
commutator coefficient. -/
noncomputable def raiseCuspCommutatorCarrierBound (N : ℕ) : ℝ :=
  Classical.choose
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (raiseCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (raiseCuspEuclideanCommutatorCoefficient_quotientCompact N))

theorem raiseCuspCommutatorCarrierBound_nonneg (N : ℕ) :
    0 ≤ raiseCuspCommutatorCarrierBound N :=
  (Classical.choose_spec
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (raiseCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (raiseCuspEuclideanCommutatorCoefficient_quotientCompact N))).1

theorem norm_raiseCuspEuclideanCommutatorCoefficient_le
    (N : ℕ) (z : ℍ) (hz : z ∈ gammaTwoClosedTileCarrier) :
    ‖raiseCuspEuclideanCommutatorCoefficient N z‖ ≤
      raiseCuspCommutatorCarrierBound N :=
  (Classical.choose_spec
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (raiseCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (raiseCuspEuclideanCommutatorCoefficient_quotientCompact N))).2 z hz

/-- A canonical finite carrier bound for the fixed-stage lowering
commutator coefficient. -/
noncomputable def lowerCuspCommutatorCarrierBound (N : ℕ) : ℝ :=
  Classical.choose
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (lowerCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (lowerCuspEuclideanCommutatorCoefficient_quotientCompact N))

theorem lowerCuspCommutatorCarrierBound_nonneg (N : ℕ) :
    0 ≤ lowerCuspCommutatorCarrierBound N :=
  (Classical.choose_spec
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (lowerCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (lowerCuspEuclideanCommutatorCoefficient_quotientCompact N))).1

theorem norm_lowerCuspEuclideanCommutatorCoefficient_le
    (N : ℕ) (z : ℍ) (hz : z ∈ gammaTwoClosedTileCarrier) :
    ‖lowerCuspEuclideanCommutatorCoefficient N z‖ ≤
      lowerCuspCommutatorCarrierBound N :=
  (Classical.choose_spec
    (exists_closedCarrier_norm_bound_of_quotientCompact
      (lowerCuspEuclideanCommutatorCoefficient_realSmooth N).continuous
      (lowerCuspEuclideanCommutatorCoefficient_quotientCompact N))).2 z hz

/-- Predecessor form of the Euclidean gauge scale, written so no cancellation
of a height factor is needed in the lowering commutator calculation. -/
theorem euclideanGaugeScale_pred_inv (n : ℤ) (z : ℍ) :
    ((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent (n - 1) : ℝ) : ℂ) =
      (heightC z)⁻¹ *
        ((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent_pred,
    Real.rpow_sub_one z.im_ne_zero]
  simp only [heightC, Complex.ofReal_div, div_eq_mul_inv]
  ring

/-- Exact Euclidean-gauge multiplier formula for the typed raising
commutator. -/
theorem fixedPhaseEuclideanGauge_raiseCuspCutoffCommutator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n + 1)
        (raiseCuspCutoffCommutator N n u) z =
      raiseCuspEuclideanCommutatorCoefficient N z *
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n u z := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    raiseCuspCutoffCommutator_apply,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeScale_succ]
  unfold raiseCuspEuclideanCommutatorCoefficient raiseRaw physicalExponent
  push_cast
  ring

/-- Exact Euclidean-gauge multiplier formula for the typed lowering
commutator. -/
theorem fixedPhaseEuclideanGauge_lowerCuspCutoffCommutator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n - 1)
        (lowerCuspCutoffCommutator N n u) z =
      lowerCuspEuclideanCommutatorCoefficient N z *
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n u z := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    lowerCuspCutoffCommutator_apply,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    euclideanGaugeScale_pred_inv]
  unfold lowerCuspEuclideanCommutatorCoefficient lowerRaw
  ring

/-- Generic `L²` estimate for a fixed-phase core map which is pointwise a
bounded multiplier in the isometric Euclidean gauge. -/
theorem norm_l2Coordinate_le_of_fixedPhaseGauge_multiplier
    {m n : ℤ} (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (c : ℍ → ℂ) (C : ℝ)
    (hC : 0 ≤ C)
    (hGauge : ∀ z : ℍ,
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m v z =
        c z * Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n u z)
    (hBound : ∀ z : ℍ, z ∈ gammaTwoClosedTileCarrier →
      ‖c z‖ ≤ C) :
    ‖l2Coordinate m v‖ ≤ C * ‖l2Coordinate n u‖ := by
  calc
    ‖l2Coordinate m v‖ =
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding m
          (l2Coordinate m v)‖ := by
      rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm]
    _ ≤ ‖(C : ℂ) •
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
            (l2Coordinate n u)‖ := by
      apply MeasureTheory.Lp.norm_le_norm_of_ae_le
      filter_upwards [
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge m v,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ae_mem_open_chosenEuclidean]
          with z hzTarget hzSource hzOpen
      rw [hzTarget, hzSource, hGauge]
      simp only [Pi.smul_apply, smul_eq_mul, norm_mul,
        Complex.norm_real, abs_of_nonneg hC]
      exact mul_le_mul_of_nonneg_right
        (hBound z (gammaTwoOpenCarrier_subset_closedTileCarrier hzOpen))
        (norm_nonneg _)
    _ = C *
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n u)‖ := by
      rw [norm_smul, Complex.norm_real, abs_of_nonneg hC]
    _ = C * ‖l2Coordinate n u‖ := by
      rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm]

/-- The typed raising commutator followed by the actual target Petersson
coordinate. -/
noncomputable def raisePeterssonCuspCommutatorCoreMap
    (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ]
      OrbitPeterssonHilbert (n + 1) :=
  (l2Coordinate (n + 1)).comp (raiseCuspCutoffCommutator N n)

theorem norm_raisePeterssonCuspCommutatorCoreMap_le
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖raisePeterssonCuspCommutatorCoreMap N n u‖ ≤
      raiseCuspCommutatorCarrierBound N * ‖l2Coordinate n u‖ := by
  exact norm_l2Coordinate_le_of_fixedPhaseGauge_multiplier
    (raiseCuspCutoffCommutator N n u) u
    (raiseCuspEuclideanCommutatorCoefficient N)
    (raiseCuspCommutatorCarrierBound N)
    (raiseCuspCommutatorCarrierBound_nonneg N)
    (fixedPhaseEuclideanGauge_raiseCuspCutoffCommutator N n u)
    (norm_raiseCuspEuclideanCommutatorCoefficient_le N)

/-- The typed lowering commutator followed by the actual predecessor
Petersson coordinate. -/
noncomputable def lowerPeterssonCuspCommutatorCoreMap
    (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ]
      OrbitPeterssonHilbert (n - 1) :=
  (l2Coordinate (n - 1)).comp (lowerCuspCutoffCommutator N n)

theorem norm_lowerPeterssonCuspCommutatorCoreMap_le
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖lowerPeterssonCuspCommutatorCoreMap N n u‖ ≤
      lowerCuspCommutatorCarrierBound N * ‖l2Coordinate n u‖ := by
  exact norm_l2Coordinate_le_of_fixedPhaseGauge_multiplier
    (lowerCuspCutoffCommutator N n u) u
    (lowerCuspEuclideanCommutatorCoefficient N)
    (lowerCuspCommutatorCarrierBound N)
    (lowerCuspCommutatorCarrierBound_nonneg N)
    (fixedPhaseEuclideanGauge_lowerCuspCutoffCommutator N n u)
    (norm_lowerCuspEuclideanCommutatorCoefficient_le N)

/-- Honest bounded extension of the raising cutoff commutator to the full
source Petersson completion. -/
noncomputable def raisePeterssonCuspCommutator (N : ℕ) (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ]
      OrbitPeterssonHilbert (n + 1) :=
  (raisePeterssonCuspCommutatorCoreMap N n).extendOfNorm
    (l2Coordinate n)

@[simp]
theorem raisePeterssonCuspCommutator_l2Coordinate
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    raisePeterssonCuspCommutator N n (l2Coordinate n u) =
      l2Coordinate (n + 1) (raiseCuspCutoffCommutator N n u) := by
  exact LinearMap.extendOfNorm_eq (denseRange_l2Coordinate n)
    ⟨raiseCuspCommutatorCarrierBound N,
      norm_raisePeterssonCuspCommutatorCoreMap_le N n⟩ u

/-- Honest bounded extension of the lowering cutoff commutator to the full
source Petersson completion. -/
noncomputable def lowerPeterssonCuspCommutator (N : ℕ) (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ]
      OrbitPeterssonHilbert (n - 1) :=
  (lowerPeterssonCuspCommutatorCoreMap N n).extendOfNorm
    (l2Coordinate n)

@[simp]
theorem lowerPeterssonCuspCommutator_l2Coordinate
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    lowerPeterssonCuspCommutator N n (l2Coordinate n u) =
      l2Coordinate (n - 1) (lowerCuspCutoffCommutator N n u) := by
  exact LinearMap.extendOfNorm_eq (denseRange_l2Coordinate n)
    ⟨lowerCuspCommutatorCarrierBound N,
      norm_lowerPeterssonCuspCommutatorCoreMap_le N n⟩ u

/-! The Green operator uses lowering *from a successor* with target written
definitionally as `n`.  The following parallel definitions avoid silently
transporting through the propositional equality `(n + 1) - 1 = n`. -/

noncomputable def lowerFromSuccCuspCutoffCommutator
    (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n :=
  (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n).comp
      (cuspCutoffOperator N (n + 1)) -
    (cuspCutoffOperator N n).comp
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n)

theorem lowerFromSuccCuspCutoffCommutator_apply
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    ((lowerFromSuccCuspCutoffCommutator N n u :
        Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction) z =
      (-Complex.I * heightC z ^ 2 * dx (upstairsCuspCutoff N) z +
          heightC z ^ 2 * dy (upstairsCuspCutoff N) z) *
        (u : SmoothQuotientCompactFunction) z := by
  change
    lowerRaw (paperOrbitExponent (n + 1))
        (upstairsCuspCutoff N *
          (u : SmoothQuotientCompactFunction)) z -
      upstairsCuspCutoff N z *
        lowerRaw (paperOrbitExponent (n + 1))
          (u : SmoothQuotientCompactFunction) z = _
  rw [lowerRaw_mul_cutoff (upstairsCuspCutoff_realSmooth N)
    (u : SmoothQuotientCompactFunction).1.2]
  ring

theorem euclideanGaugeScale_sourceSucc_inv (n : ℤ) (z : ℍ) :
    ((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ) =
      (heightC z)⁻¹ *
        ((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent (n + 1) : ℝ) : ℂ) := by
  simpa only [add_sub_cancel_right] using
    (euclideanGaugeScale_pred_inv (n + 1) z)

theorem fixedPhaseEuclideanGauge_lowerFromSuccCuspCutoffCommutator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n
        (lowerFromSuccCuspCutoffCommutator N n u) z =
      lowerCuspEuclideanCommutatorCoefficient N z *
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n + 1) u z := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    lowerFromSuccCuspCutoffCommutator_apply,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
    euclideanGaugeScale_sourceSucc_inv]
  unfold lowerCuspEuclideanCommutatorCoefficient lowerRaw
  ring

noncomputable def lowerFromSuccPeterssonCuspCommutatorCoreMap
    (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (lowerFromSuccCuspCutoffCommutator N n)

theorem norm_lowerFromSuccPeterssonCuspCommutatorCoreMap_le
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    ‖lowerFromSuccPeterssonCuspCommutatorCoreMap N n u‖ ≤
      lowerCuspCommutatorCarrierBound N * ‖l2Coordinate (n + 1) u‖ := by
  exact norm_l2Coordinate_le_of_fixedPhaseGauge_multiplier
    (lowerFromSuccCuspCutoffCommutator N n u) u
    (lowerCuspEuclideanCommutatorCoefficient N)
    (lowerCuspCommutatorCarrierBound N)
    (lowerCuspCommutatorCarrierBound_nonneg N)
    (fixedPhaseEuclideanGauge_lowerFromSuccCuspCutoffCommutator N n u)
    (norm_lowerCuspEuclideanCommutatorCoefficient_le N)

noncomputable def lowerFromSuccPeterssonCuspCommutator
    (N : ℕ) (n : ℤ) :
    OrbitPeterssonHilbert (n + 1) →L[ℂ]
      OrbitPeterssonHilbert n :=
  (lowerFromSuccPeterssonCuspCommutatorCoreMap N n).extendOfNorm
    (l2Coordinate (n + 1))

@[simp]
theorem lowerFromSuccPeterssonCuspCommutator_l2Coordinate
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    lowerFromSuccPeterssonCuspCommutator N n
        (l2Coordinate (n + 1) u) =
      l2Coordinate n (lowerFromSuccCuspCutoffCommutator N n u) := by
  exact LinearMap.extendOfNorm_eq (denseRange_l2Coordinate (n + 1))
    ⟨lowerCuspCommutatorCarrierBound N,
      norm_lowerFromSuccPeterssonCuspCommutatorCoreMap_le N n⟩ u

/-- On every fixed smooth vector the completed raising commutator is exactly
zero from a finite cutoff stage onward.  This is deliberately a dense-core
statement, not a strong convergence assertion on the whole completion. -/
theorem raisePeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (fun N ↦ raisePeterssonCuspCommutator N n (l2Coordinate n u))
      =ᶠ[Filter.atTop] (fun _ ↦ 0) := by
  obtain ⟨N, hN⟩ :=
    exists_raiseCuspCutoffCommutator_eventually_eq_zero n u
  filter_upwards [eventually_ge_atTop N] with M hM
  rw [raisePeterssonCuspCommutator_l2Coordinate, hN M hM, map_zero]

/-- Generic lowering has the same exact finite-stage vanishing on its dense
smooth source. -/
theorem lowerPeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (fun N ↦ lowerPeterssonCuspCommutator N n (l2Coordinate n u))
      =ᶠ[Filter.atTop] (fun _ ↦ 0) := by
  obtain ⟨N, hN⟩ :=
    exists_lowerCuspCutoffCommutator_eventually_eq_zero n u
  filter_upwards [eventually_ge_atTop N] with M hM
  rw [lowerPeterssonCuspCommutator_l2Coordinate, hN M hM, map_zero]

theorem exists_lowerFromSuccCuspCutoffCommutator_eventually_eq_zero
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      lowerFromSuccCuspCutoffCommutator M n u = 0 := by
  obtain ⟨Nu, hNu⟩ :=
    exists_cuspCutoffOperator_eventually_eq (n + 1) u
  obtain ⟨Nl, hNl⟩ := exists_cuspCutoffOperator_eventually_eq n
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n u)
  refine ⟨max Nu Nl, fun M hM ↦ ?_⟩
  have hMu := hNu M ((le_max_left Nu Nl).trans hM)
  have hMl := hNl M ((le_max_right Nu Nl).trans hM)
  change
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n
        (cuspCutoffOperator M (n + 1) u) -
      cuspCutoffOperator M n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n u) = 0
  rw [hMu, hMl, sub_self]

theorem lowerFromSuccPeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    (fun N ↦ lowerFromSuccPeterssonCuspCommutator N n
      (l2Coordinate (n + 1) u)) =ᶠ[Filter.atTop] (fun _ ↦ 0) := by
  obtain ⟨N, hN⟩ :=
    exists_lowerFromSuccCuspCutoffCommutator_eventually_eq_zero n u
  filter_upwards [eventually_ge_atTop N] with M hM
  rw [lowerFromSuccPeterssonCuspCommutator_l2Coordinate,
    hN M hM, map_zero]

/-- Completed raising product rule on the literal smooth core. -/
theorem raisedCoordinate_cuspCutoffOperator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    raisedCoordinate n (cuspCutoffOperator N n u) =
      peterssonCuspCutoff N (n + 1) (raisedCoordinate n u) +
        raisePeterssonCuspCommutator N n (l2Coordinate n u) := by
  rw [raisedCoordinate_apply, raisedCoordinate_apply,
    peterssonCuspCutoff_l2Coordinate,
    raisePeterssonCuspCommutator_l2Coordinate]
  change l2Coordinate (n + 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n (cuspCutoffOperator N n u)) =
    l2Coordinate (n + 1)
      (cuspCutoffOperator N (n + 1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)) +
      l2Coordinate (n + 1) (raiseCuspCutoffCommutator N n u)
  rw [← map_add]
  apply congrArg (l2Coordinate (n + 1))
  change
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n (cuspCutoffOperator N n u) =
      cuspCutoffOperator N (n + 1)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u) +
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n (cuspCutoffOperator N n u) -
          cuspCutoffOperator N (n + 1)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u))
  abel

/-- The exact signed-raising commutator identity in the orientation required
by maximal-adjoint graph localization. -/
theorem negativeRaisedCoordinate_peterssonCuspCutoff
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    peterssonCuspCutoff N (n + 1) (-raisedCoordinate n u) =
      -raisedCoordinate n (cuspCutoffOperator N n u) +
        raisePeterssonCuspCommutator N n (l2Coordinate n u) := by
  rw [map_neg, raisedCoordinate_cuspCutoffOperator]
  abel

/-- Completed lowering product rule on the literal smooth core. -/
theorem lowerFromSuccCoordinate_cuspCutoffOperator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    lowerFromSuccCoordinate n (cuspCutoffOperator N (n + 1) u) =
      peterssonCuspCutoff N n (lowerFromSuccCoordinate n u) +
        lowerFromSuccPeterssonCuspCommutator N n
          (l2Coordinate (n + 1) u) := by
  rw [lowerFromSuccCoordinate_apply, lowerFromSuccCoordinate_apply,
    peterssonCuspCutoff_l2Coordinate,
    lowerFromSuccPeterssonCuspCommutator_l2Coordinate]
  change l2Coordinate n
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n
        (cuspCutoffOperator N (n + 1) u)) =
    l2Coordinate n
      (cuspCutoffOperator N n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n u)) +
      l2Coordinate n (lowerFromSuccCuspCutoffCommutator N n u)
  rw [← map_add]
  apply congrArg (l2Coordinate n)
  change
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n
        (cuspCutoffOperator N (n + 1) u) =
      cuspCutoffOperator N n
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n u) +
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n
            (cuspCutoffOperator N (n + 1) u) -
          cuspCutoffOperator N n
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n u))
  abel

/-- Signed-lowering counterpart, again with the commutator sign fixed by the
opposite dense operator used in the adjoint graph theorem. -/
theorem negativeLowerFromSuccCoordinate_peterssonCuspCutoff
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    peterssonCuspCutoff N n (-lowerFromSuccCoordinate n u) =
      -lowerFromSuccCoordinate n
          (cuspCutoffOperator N (n + 1) u) +
        lowerFromSuccPeterssonCuspCommutator N n
          (l2Coordinate (n + 1) u) := by
  rw [map_neg, lowerFromSuccCoordinate_cuspCutoffOperator]
  abel

/-! #### Exact fixed-stage commutator on the dense partial-operator domains -/

/-- A completed cutoff sends the literal smooth `L²` range back into that
same range. -/
theorem peterssonCuspCutoff_mem_l2CoreRange
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    peterssonCuspCutoff N n (x : OrbitPeterssonHilbert n) ∈
      LinearMap.range (l2Coordinate n) := by
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm x
  refine ⟨cuspCutoffOperator N n u, ?_⟩
  calc
    l2Coordinate n (cuspCutoffOperator N n u) =
        peterssonCuspCutoff N n (l2Coordinate n u) :=
      (peterssonCuspCutoff_l2Coordinate N n u).symm
    _ = peterssonCuspCutoff N n (x : OrbitPeterssonHilbert n) := by
      rw [l2Coordinate_l2CoreRangeEquiv_symm]

/-- Domain preservation in exactly the adjoint form required by
`AdjointCutoffExhaustion`. -/
theorem adjoint_peterssonCuspCutoff_mem_l2CoreRange
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    ContinuousLinearMap.adjoint (peterssonCuspCutoff N n)
        (x : OrbitPeterssonHilbert n) ∈
      LinearMap.range (l2Coordinate n) := by
  rw [adjoint_peterssonCuspCutoff]
  exact peterssonCuspCutoff_mem_l2CoreRange N n x

/-- Exact signed-raising commutator on every element of the actual partial
operator domain. -/
theorem negativePhysicalRaise_peterssonCuspCutoff_commutator
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    peterssonCuspCutoff N (n + 1) ((-physicalRaise n) x) =
      (-physicalRaise n)
          ⟨peterssonCuspCutoff N n (x : OrbitPeterssonHilbert n),
            peterssonCuspCutoff_mem_l2CoreRange N n x⟩ +
        raisePeterssonCuspCommutator N n
          (x : OrbitPeterssonHilbert n) := by
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm x
  let xCut : LinearMap.range (l2Coordinate n) :=
    ⟨peterssonCuspCutoff N n (x : OrbitPeterssonHilbert n),
      peterssonCuspCutoff_mem_l2CoreRange N n x⟩
  have hx : l2Coordinate n u = (x : OrbitPeterssonHilbert n) :=
    l2Coordinate_l2CoreRangeEquiv_symm n x
  have hxCut : xCut =
      l2CoreRangeEquiv n (cuspCutoffOperator N n u) := by
    apply Subtype.ext
    change peterssonCuspCutoff N n (x : OrbitPeterssonHilbert n) =
      l2Coordinate n (cuspCutoffOperator N n u)
    rw [← hx, peterssonCuspCutoff_l2Coordinate]
  change peterssonCuspCutoff N (n + 1) ((-physicalRaise n) x) =
    (-physicalRaise n) xCut +
      raisePeterssonCuspCommutator N n
        (x : OrbitPeterssonHilbert n)
  calc
    peterssonCuspCutoff N (n + 1) ((-physicalRaise n) x) =
        peterssonCuspCutoff N (n + 1) (-raisedCoordinate n u) := by
      rw [LinearPMap.neg_apply, physicalRaise_apply]
    _ = -raisedCoordinate n (cuspCutoffOperator N n u) +
          raisePeterssonCuspCommutator N n (l2Coordinate n u) :=
      negativeRaisedCoordinate_peterssonCuspCutoff N n u
    _ = (-physicalRaise n) xCut +
          raisePeterssonCuspCommutator N n
            (x : OrbitPeterssonHilbert n) := by
      rw [hxCut, LinearPMap.neg_apply, physicalRaise_on_core, hx]

/-- The preceding identity with both cutoff occurrences written as Hilbert
adjoints, matching the generic maximal-graph theorem literally. -/
theorem negativePhysicalRaise_adjointCutoff_commutator
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    ContinuousLinearMap.adjoint (peterssonCuspCutoff N (n + 1))
        ((-physicalRaise n) x) =
      (-physicalRaise n)
          ⟨ContinuousLinearMap.adjoint (peterssonCuspCutoff N n)
              (x : OrbitPeterssonHilbert n),
            adjoint_peterssonCuspCutoff_mem_l2CoreRange N n x⟩ +
        raisePeterssonCuspCommutator N n
          (x : OrbitPeterssonHilbert n) := by
  simpa only [adjoint_peterssonCuspCutoff] using
    negativePhysicalRaise_peterssonCuspCutoff_commutator N n x

/-- Exact signed-lowering commutator on the successor partial-operator
domain. -/
theorem negativePhysicalLowerFromSucc_peterssonCuspCutoff_commutator
    (N : ℕ) (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    peterssonCuspCutoff N n ((-physicalLowerFromSucc n) x) =
      (-physicalLowerFromSucc n)
          ⟨peterssonCuspCutoff N (n + 1)
              (x : OrbitPeterssonHilbert (n + 1)),
            peterssonCuspCutoff_mem_l2CoreRange N (n + 1) x⟩ +
        lowerFromSuccPeterssonCuspCommutator N n
          (x : OrbitPeterssonHilbert (n + 1)) := by
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) :=
    (l2CoreRangeEquiv (n + 1)).symm x
  let xCut : LinearMap.range (l2Coordinate (n + 1)) :=
    ⟨peterssonCuspCutoff N (n + 1)
        (x : OrbitPeterssonHilbert (n + 1)),
      peterssonCuspCutoff_mem_l2CoreRange N (n + 1) x⟩
  have hx : l2Coordinate (n + 1) u =
      (x : OrbitPeterssonHilbert (n + 1)) :=
    l2Coordinate_l2CoreRangeEquiv_symm (n + 1) x
  have hxCut : xCut =
      l2CoreRangeEquiv (n + 1)
        (cuspCutoffOperator N (n + 1) u) := by
    apply Subtype.ext
    change peterssonCuspCutoff N (n + 1)
        (x : OrbitPeterssonHilbert (n + 1)) =
      l2Coordinate (n + 1) (cuspCutoffOperator N (n + 1) u)
    rw [← hx, peterssonCuspCutoff_l2Coordinate]
  change peterssonCuspCutoff N n ((-physicalLowerFromSucc n) x) =
    (-physicalLowerFromSucc n) xCut +
      lowerFromSuccPeterssonCuspCommutator N n
        (x : OrbitPeterssonHilbert (n + 1))
  calc
    peterssonCuspCutoff N n ((-physicalLowerFromSucc n) x) =
        peterssonCuspCutoff N n (-lowerFromSuccCoordinate n u) := by
      rw [LinearPMap.neg_apply, physicalLowerFromSucc_apply]
    _ = -lowerFromSuccCoordinate n
            (cuspCutoffOperator N (n + 1) u) +
          lowerFromSuccPeterssonCuspCommutator N n
            (l2Coordinate (n + 1) u) :=
      negativeLowerFromSuccCoordinate_peterssonCuspCutoff N n u
    _ = (-physicalLowerFromSucc n) xCut +
          lowerFromSuccPeterssonCuspCommutator N n
            (x : OrbitPeterssonHilbert (n + 1)) := by
      rw [hxCut, LinearPMap.neg_apply,
        physicalLowerFromSucc_on_core, hx]

theorem negativePhysicalLowerFromSucc_adjointCutoff_commutator
    (N : ℕ) (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    ContinuousLinearMap.adjoint (peterssonCuspCutoff N n)
        ((-physicalLowerFromSucc n) x) =
      (-physicalLowerFromSucc n)
          ⟨ContinuousLinearMap.adjoint
              (peterssonCuspCutoff N (n + 1))
              (x : OrbitPeterssonHilbert (n + 1)),
            adjoint_peterssonCuspCutoff_mem_l2CoreRange
              N (n + 1) x⟩ +
        lowerFromSuccPeterssonCuspCommutator N n
          (x : OrbitPeterssonHilbert (n + 1)) := by
  simpa only [adjoint_peterssonCuspCutoff] using
    negativePhysicalLowerFromSucc_peterssonCuspCutoff_commutator N n x

/-- Both coordinates of a literal raising graph vector have compact carrier
support.  The target statement uses quotient compactness of the raised smooth
section, not an unsupported claim that differentiation preserves an upstairs
compact set. -/
theorem physicalRaise_graph_hasCompactCarrierSupport
    (n : ℤ)
    {p : OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1)}
    (hp : p ∈ (physicalRaise n).graph) :
    HasCompactCarrierSupport n p.1 ∧
      HasCompactCarrierSupport (n + 1) p.2 := by
  rcases (LinearPMap.mem_graph_iff (physicalRaise n)).mp hp with
    ⟨x, hxBase, hxValue⟩
  constructor
  · rw [← hxBase]
    simpa only [l2Coordinate_l2CoreRangeEquiv_symm] using
      l2Coordinate_hasCompactCarrierSupport n
        ((l2CoreRangeEquiv n).symm x)
  · rw [← hxValue, physicalRaise_apply, raisedCoordinate_apply]
    exact l2Coordinate_hasCompactCarrierSupport (n + 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n
        ((l2CoreRangeEquiv n).symm x))

/-- Lowering from the successor core has the corresponding two compact
carrier coordinates. -/
theorem physicalLowerFromSucc_graph_hasCompactCarrierSupport
    (n : ℤ)
    {p : OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n}
    (hp : p ∈ (physicalLowerFromSucc n).graph) :
    HasCompactCarrierSupport (n + 1) p.1 ∧
      HasCompactCarrierSupport n p.2 := by
  rcases (LinearPMap.mem_graph_iff (physicalLowerFromSucc n)).mp hp with
    ⟨x, hxBase, hxValue⟩
  constructor
  · rw [← hxBase]
    simpa only [l2Coordinate_l2CoreRangeEquiv_symm] using
      l2Coordinate_hasCompactCarrierSupport (n + 1)
        ((l2CoreRangeEquiv (n + 1)).symm x)
  · rw [← hxValue, physicalLowerFromSucc_apply,
      lowerFromSuccCoordinate_apply]
    exact l2Coordinate_hasCompactCarrierSupport n
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lowerFromSucc n
        ((l2CoreRangeEquiv (n + 1)).symm x))

/-- The actual raising core graph lies in the compact weak maximal class.
Global Green supplies the maximal-adjoint inclusion, while the two support
fields and the weak equation are discharged independently above. -/
theorem physicalRaise_graph_subset_compactWeakMaximalGraph (n : ℤ) :
    ((physicalRaise n).graph :
        Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1))) ⊆
      RaisingCompactWeakMaximalGraphAt n := by
  intro p hp
  have hSupport := physicalRaise_graph_hasCompactCarrierSupport n hp
  refine ⟨⟨?_, hSupport.1, hSupport.2⟩,
    physicalRaise_graph_isEuclideanRaisingWeakGraphAt n hp⟩
  exact LinearPMap.le_graph_of_le
    (raise_le_negativeLower_adjoint
      (physicalGreenIdentityAt_unconditional n)) hp

/-- Lowering counterpart of the preceding compact weak graph inclusion. -/
theorem physicalLowerFromSucc_graph_subset_compactWeakMaximalGraph
    (n : ℤ) :
    ((physicalLowerFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n)) ⊆
      LoweringCompactWeakMaximalGraphAt n := by
  intro p hp
  have hSupport :=
    physicalLowerFromSucc_graph_hasCompactCarrierSupport n hp
  refine ⟨⟨?_, hSupport.1, hSupport.2⟩,
    physicalLowerFromSucc_graph_isEuclideanLoweringWeakGraphAt n hp⟩
  exact LinearPMap.le_graph_of_le
    (lower_le_negativeRaise_adjoint
      (physicalGreenIdentityAt_unconditional n)) hp

/-! #### A bounded commutator theorem for maximal adjoint graphs -/

/-- Bounded source and target cutoffs preserve a maximal adjoint graph when
their exact commutator on the opposite dense core is bounded.  The localized
operator coordinate is `U (T† y) + C† y`; omitting the commutator term would
be incorrect. -/
theorem adjoint_graph_mem_of_bounded_cutoff_commutator
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    (T : E →ₗ.[ℂ] F) (hT : Dense (T.domain : Set E))
    (U : E →L[ℂ] E) (V : F →L[ℂ] F) (C : E →L[ℂ] F)
    (hDomain : ∀ x : T.domain,
      ContinuousLinearMap.adjoint U (x : E) ∈ T.domain)
    (hCommutator : ∀ x : T.domain,
      ContinuousLinearMap.adjoint V (T x) =
        T ⟨ContinuousLinearMap.adjoint U (x : E), hDomain x⟩ + C x)
    (y : T†.domain) :
    (V (y : F),
        U (T† y) + ContinuousLinearMap.adjoint C (y : F)) ∈
      (T†).graph := by
  let yCut : F := V (y : F)
  let graphValue : E :=
    U (T† y) + ContinuousLinearMap.adjoint C (y : F)
  have hPair : ∀ x : T.domain,
      inner ℂ graphValue (x : E) = inner ℂ yCut (T x) := by
    intro x
    dsimp only [graphValue, yCut]
    calc
      inner ℂ
          (U (T† y) + ContinuousLinearMap.adjoint C (y : F))
          (x : E) =
          inner ℂ (U (T† y)) (x : E) +
            inner ℂ (ContinuousLinearMap.adjoint C (y : F))
              (x : E) := inner_add_left _ _ _
      _ = inner ℂ (T† y)
            (ContinuousLinearMap.adjoint U (x : E)) +
          inner ℂ (y : F) (C x) := by
        rw [← ContinuousLinearMap.adjoint_inner_right,
          ContinuousLinearMap.adjoint_inner_left]
      _ = inner ℂ (y : F)
            (T ⟨ContinuousLinearMap.adjoint U (x : E), hDomain x⟩) +
          inner ℂ (y : F) (C x) := by
        rw [(LinearPMap.adjoint_isFormalAdjoint hT) y
          ⟨ContinuousLinearMap.adjoint U (x : E), hDomain x⟩]
      _ = inner ℂ (y : F)
          (ContinuousLinearMap.adjoint V (T x)) := by
        rw [hCommutator x, inner_add_right]
      _ = inner ℂ (V (y : F)) (T x) := by
        rw [ContinuousLinearMap.adjoint_inner_right]
  have hyCut : yCut ∈ T†.domain :=
    LinearPMap.mem_adjoint_domain_of_exists yCut ⟨graphValue, hPair⟩
  have hValue : T† ⟨yCut, hyCut⟩ = graphValue :=
    LinearPMap.adjoint_apply_eq hT ⟨yCut, hyCut⟩ hPair
  exact (LinearPMap.mem_graph_iff (T†)).2
    ⟨⟨yCut, hyCut⟩, rfl, hValue⟩

/-- Explicit data for a maximal-adjoint cutoff exhaustion.  `U` acts on the
operator coordinate, `V` on the base coordinate, and `C` is their bounded
core commutator.  The last field asks only for the desired support class;
graph preservation follows from the preceding theorem. -/
structure AdjointCutoffExhaustion
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    (T : E →ₗ.[ℂ] F) (P : Set (F × E)) where
  U : ℕ → E →L[ℂ] E
  V : ℕ → F →L[ℂ] F
  C : ℕ → E →L[ℂ] F
  adjoint_U_mem_domain : ∀ j (x : T.domain),
    ContinuousLinearMap.adjoint (U j) (x : E) ∈ T.domain
  commutator : ∀ j (x : T.domain),
    ContinuousLinearMap.adjoint (V j) (T x) =
      T ⟨ContinuousLinearMap.adjoint (U j) (x : E),
        adjoint_U_mem_domain j x⟩ + C j x
  tendsto_U : ∀ x : E, Filter.Tendsto (fun j ↦ U j x) Filter.atTop (𝓝 x)
  tendsto_V : ∀ y : F, Filter.Tendsto (fun j ↦ V j y) Filter.atTop (𝓝 y)
  tendsto_adjoint_C_zero : ∀ y : F,
    Filter.Tendsto (fun j ↦ ContinuousLinearMap.adjoint (C j) y)
      Filter.atTop (𝓝 0)
  localized_property : ∀ j (y : T†.domain),
    (V j (y : F),
      U j (T† y) + ContinuousLinearMap.adjoint (C j) (y : F)) ∈ P

/-- A bounded adjoint-cutoff exhaustion gives the exact sequential graph
localization predicate used by P3.7. -/
theorem AdjointCutoffExhaustion.hasSequentialGraphLocalization
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    {T : E →ₗ.[ℂ] F} {P : Set (F × E)}
    (hT : Dense (T.domain : Set E))
    (X : AdjointCutoffExhaustion T P) :
    HasSequentialGraphLocalization (T†)
      {p : F × E | p ∈ (T†).graph ∧ p ∈ P} := by
  refine ⟨fun _ hp ↦ hp.1, ?_⟩
  intro p hp
  rcases (LinearPMap.mem_graph_iff (T†)).mp hp with
    ⟨y, hyBase, hyValue⟩
  let q : ℕ → F × E := fun j ↦
    (X.V j (y : F),
      X.U j (T† y) +
        ContinuousLinearMap.adjoint (X.C j) (y : F))
  refine ⟨q, fun j ↦ ⟨?_, X.localized_property j y⟩, ?_⟩
  · exact adjoint_graph_mem_of_bounded_cutoff_commutator T hT
      (X.U j) (X.V j) (X.C j)
      (X.adjoint_U_mem_domain j) (X.commutator j) y
  have hBase : Filter.Tendsto (fun j ↦ X.V j (y : F)) Filter.atTop (𝓝 p.1) := by
    simpa only [hyBase] using X.tendsto_V (y : F)
  have hValue : Filter.Tendsto
      (fun j ↦ X.U j (T† y) +
        ContinuousLinearMap.adjoint (X.C j) (y : F))
      Filter.atTop (𝓝 p.2) := by
    simpa only [hyValue, add_zero] using
      (X.tendsto_U (T† y)).add
        (X.tendsto_adjoint_C_zero (y : F))
  exact hBase.prodMk_nhds hValue

/-! #### Specialization of the bounded-commutator mechanism to the Maass pair -/

/-- The support-only part of the raising compact maximal graph. -/
def RaisingCompactCarrierPairAt (n : ℤ) :
    Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1)) :=
  {p | HasCompactCarrierSupport n p.1 ∧
    HasCompactCarrierSupport (n + 1) p.2}

/-- The support-only part of the lowering compact maximal graph. -/
def LoweringCompactCarrierPairAt (n : ℤ) :
    Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n) :=
  {p | HasCompactCarrierSupport (n + 1) p.1 ∧
    HasCompactCarrierSupport n p.2}

/-- An explicit bounded cutoff/commutator exhaustion for signed lowering
discharges the entire raising maximal-graph localization obligation. -/
theorem raisingInvariantCutoffGraphControlAt_of_adjointCutoffExhaustion
    {n : ℤ}
    (X : AdjointCutoffExhaustion (-physicalLowerFromSucc n)
      (RaisingCompactCarrierPairAt n)) :
    RaisingInvariantCutoffGraphControlAt n := by
  simpa only [RaisingInvariantCutoffGraphControlAt,
    RaisingCompactMaximalGraphAt, RaisingCompactCarrierPairAt,
    Set.mem_setOf_eq] using
      X.hasSequentialGraphLocalization
        (negativePhysicalLowerFromSucc_dense_domain n)

/-- Signed-raising specialization producing the lowering localization. -/
theorem loweringInvariantCutoffGraphControlAt_of_adjointCutoffExhaustion
    {n : ℤ}
    (X : AdjointCutoffExhaustion (-physicalRaise n)
      (LoweringCompactCarrierPairAt n)) :
    LoweringInvariantCutoffGraphControlAt n := by
  simpa only [LoweringInvariantCutoffGraphControlAt,
    LoweringCompactMaximalGraphAt, LoweringCompactCarrierPairAt,
    Set.mem_setOf_eq] using
      X.hasSequentialGraphLocalization
        (negativePhysicalRaise_dense_domain n)

/-! #### Closure characterizations of the two residual approximation steps -/

/-- In Hilbert products, sequential graph regularization is exactly inclusion
of the localization class in the closure of the small graph.  This is the
smallest honest topological target for a Friedrichs argument. -/
theorem hasSequentialGraphRegularization_iff_subset_closure_graph
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (S : E →ₗ.[ℂ] F) (K : Set (E × F)) :
    HasSequentialGraphRegularization S K ↔
      K ⊆ closure (S.graph : Set (E × F)) := by
  constructor
  · intro h p hp
    obtain ⟨q, hqGraph, hqLimit⟩ := h p hp
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦ subset_closure (hqGraph j))
  · intro h p hp
    exact mem_closure_iff_seq_limit.mp (h hp)

/-- Maximal graph localization is likewise the conjunction of the literal
graph inclusion and density of the localized class inside that graph. -/
theorem hasSequentialGraphLocalization_iff_graph_subset_closure
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (A : E →ₗ.[ℂ] F) (K : Set (E × F)) :
    HasSequentialGraphLocalization A K ↔
      K ⊆ (A.graph : Set (E × F)) ∧
        (A.graph : Set (E × F)) ⊆ closure K := by
  constructor
  · intro h
    refine ⟨h.1, ?_⟩
    intro p hp
    obtain ⟨q, hqK, hqLimit⟩ := h.2 p hp
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦ subset_closure (hqK j))
  · rintro ⟨hKGraph, hGraphClosure⟩
    refine ⟨hKGraph, ?_⟩
    intro p hp
    exact mem_closure_iff_seq_limit.mp (hGraphClosure hp)

/-- If the full raising essential-core approximation has been proved, then
both of the separately named cutoff and compact Friedrichs obligations follow.
This sanity check shows that the route predicates neither weaken nor secretly
strengthen the desired graph-core theorem. -/
theorem raising_cutoff_and_Friedrichs_of_sequentialApproximation
    {n : ℤ}
    (hCore : RaisingMaximalAdjointSequentialApproximationAt n) :
    RaisingInvariantCutoffGraphControlAt n ∧
      RaisingCompactFriedrichsPeriodizationAt n := by
  constructor
  · rw [hasSequentialGraphLocalization_iff_graph_subset_closure]
    refine ⟨raisingCompactWeakMaximalGraphAt_subset_graph n, ?_⟩
    intro p hp
    obtain ⟨q, hqGraph, hqLimit⟩ := hCore p hp
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦
        subset_closure
          (physicalRaise_graph_subset_compactWeakMaximalGraph n
            (hqGraph j)).1)
  · rw [hasSequentialGraphRegularization_iff_subset_closure_graph]
    intro p hp
    obtain ⟨q, hqGraph, hqLimit⟩ := hCore p hp.1.1
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦ subset_closure (hqGraph j))

/-- Lowering counterpart of the preceding consistency theorem. -/
theorem lowering_cutoff_and_Friedrichs_of_sequentialApproximation
    {n : ℤ}
    (hCore : LoweringMaximalAdjointSequentialApproximationAt n) :
    LoweringInvariantCutoffGraphControlAt n ∧
      LoweringCompactFriedrichsPeriodizationAt n := by
  constructor
  · rw [hasSequentialGraphLocalization_iff_graph_subset_closure]
    refine ⟨loweringCompactWeakMaximalGraphAt_subset_graph n, ?_⟩
    intro p hp
    obtain ⟨q, hqGraph, hqLimit⟩ := hCore p hp
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦
        subset_closure
          (physicalLowerFromSucc_graph_subset_compactWeakMaximalGraph n
            (hqGraph j)).1)
  · rw [hasSequentialGraphRegularization_iff_subset_closure_graph]
    intro p hp
    obtain ⟨q, hqGraph, hqLimit⟩ := hCore p hp.1.1
    exact isClosed_closure.mem_of_tendsto hqLimit
      (Filter.Eventually.of_forall fun j ↦ subset_closure (hqGraph j))

end FixedPhaseAdjointCutoffCore

