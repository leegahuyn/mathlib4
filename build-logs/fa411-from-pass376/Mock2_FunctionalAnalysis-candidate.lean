/-! #### Exact adjoint orientation and signed graph identities -/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseIntrinsicAdjointCutoff

open Set Function Topology Filter MeasureTheory
open scoped LinearPMap
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseDensity
open FixedPhaseClosedOperators
open FixedPhaseEssentialCoreRoute
open FixedPhaseAdjointCutoffCore

theorem intrinsicRaisePeterssonCommutator_l2Coordinate_eq_sub
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    intrinsicRaisePeterssonCommutator N n (l2Coordinate n u) =
      raisedCoordinate n (intrinsicCuspCutoffOperator N n u) -
        intrinsicPeterssonCuspCutoff N (n + 1)
          (raisedCoordinate n u) := by
  rw [intrinsicRaisePeterssonCommutator_l2Coordinate,
    raisedCoordinate_apply, intrinsicPeterssonCuspCutoff_l2Coordinate,
    raisedCoordinate_apply]
  rw [← map_sub]
  rfl

theorem intrinsicLowerFromSuccPeterssonCommutator_l2Coordinate_eq_sub
    (N : ℕ) (n : ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    intrinsicLowerFromSuccPeterssonCommutator N n
        (l2Coordinate (n + 1) v) =
      lowerFromSuccCoordinate n
          (intrinsicCuspCutoffOperator N (n + 1) v) -
        intrinsicPeterssonCuspCutoff N n
          (lowerFromSuccCoordinate n v) := by
  rw [intrinsicLowerFromSuccPeterssonCommutator_l2Coordinate,
    lowerFromSuccCoordinate_apply,
    intrinsicPeterssonCuspCutoff_l2Coordinate,
    lowerFromSuccCoordinate_apply]
  rw [← map_sub]
  rfl

theorem inner_intrinsicRaiseCommutator_eq_intrinsicLowerFromSucc
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    inner ℂ
        (intrinsicRaisePeterssonCommutator N n (l2Coordinate n u))
        (l2Coordinate (n + 1) v) =
      inner ℂ (l2Coordinate n u)
        (intrinsicLowerFromSuccPeterssonCommutator N n
          (l2Coordinate (n + 1) v)) := by
  have hGreenLeft :
      inner ℂ
          (raisedCoordinate n (intrinsicCuspCutoffOperator N n u))
          (l2Coordinate (n + 1) v) =
        -inner ℂ
          (intrinsicPeterssonCuspCutoff N n (l2Coordinate n u))
          (lowerFromSuccCoordinate n v) := by
    simpa only [intrinsicPeterssonCuspCutoff_l2Coordinate] using
      (physicalRaisingGreenIdentityOnCore_unconditional
        (intrinsicCuspCutoffOperator N n u) v)
  have hGreenRight :
      inner ℂ (raisedCoordinate n u)
          (intrinsicPeterssonCuspCutoff N (n + 1)
            (l2Coordinate (n + 1) v)) =
        -inner ℂ (l2Coordinate n u)
          (lowerFromSuccCoordinate n
            (intrinsicCuspCutoffOperator N (n + 1) v)) := by
    simpa only [intrinsicPeterssonCuspCutoff_l2Coordinate] using
      (physicalRaisingGreenIdentityOnCore_unconditional
        u (intrinsicCuspCutoffOperator N (n + 1) v))
  have hSymBase :
      inner ℂ
          (intrinsicPeterssonCuspCutoff N n (l2Coordinate n u))
          (lowerFromSuccCoordinate n v) =
        inner ℂ (l2Coordinate n u)
          (intrinsicPeterssonCuspCutoff N n
            (lowerFromSuccCoordinate n v)) := by
    rw [← ContinuousLinearMap.adjoint_inner_right,
      adjoint_intrinsicPeterssonCuspCutoff]
  have hSymRaised :
      inner ℂ
          (intrinsicPeterssonCuspCutoff N (n + 1)
            (raisedCoordinate n u))
          (l2Coordinate (n + 1) v) =
        inner ℂ (raisedCoordinate n u)
          (intrinsicPeterssonCuspCutoff N (n + 1)
            (l2Coordinate (n + 1) v)) := by
    rw [← ContinuousLinearMap.adjoint_inner_right,
      adjoint_intrinsicPeterssonCuspCutoff]
  rw [intrinsicRaisePeterssonCommutator_l2Coordinate_eq_sub,
    intrinsicLowerFromSuccPeterssonCommutator_l2Coordinate_eq_sub,
    inner_sub_left, inner_sub_right, hGreenLeft, hSymBase,
    hSymRaised, hGreenRight]
  ring

theorem intrinsicRaisePeterssonCommutator_eq_adjoint_lowerFromSucc
    (N : ℕ) (n : ℤ) :
    intrinsicRaisePeterssonCommutator N n =
      ContinuousLinearMap.adjoint
        (intrinsicLowerFromSuccPeterssonCommutator N n) := by
  apply (ContinuousLinearMap.eq_adjoint_iff
    (intrinsicRaisePeterssonCommutator N n)
    (intrinsicLowerFromSuccPeterssonCommutator N n)).2
  intro x y
  refine (denseRange_l2Coordinate n).induction_on x
    (isClosed_eq
      ((intrinsicRaisePeterssonCommutator N n).continuous.inner
        continuous_const)
      (continuous_id.inner continuous_const)) ?_
  intro u
  refine (denseRange_l2Coordinate (n + 1)).induction_on y
    (isClosed_eq (continuous_const.inner continuous_id)
      (continuous_const.inner
        (intrinsicLowerFromSuccPeterssonCommutator N n).continuous)) ?_
  intro v
  exact inner_intrinsicRaiseCommutator_eq_intrinsicLowerFromSucc N n u v

theorem adjoint_intrinsicRaisePeterssonCommutator
    (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint
        (intrinsicRaisePeterssonCommutator N n) =
      intrinsicLowerFromSuccPeterssonCommutator N n := by
  have h := congrArg ContinuousLinearMap.adjoint
    (intrinsicRaisePeterssonCommutator_eq_adjoint_lowerFromSucc N n)
  simpa only [ContinuousLinearMap.adjoint_adjoint] using h

theorem adjoint_intrinsicLowerFromSuccPeterssonCommutator
    (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint
        (intrinsicLowerFromSuccPeterssonCommutator N n) =
      intrinsicRaisePeterssonCommutator N n :=
  (intrinsicRaisePeterssonCommutator_eq_adjoint_lowerFromSucc N n).symm

theorem raisedCoordinate_intrinsicCuspCutoffOperator
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    raisedCoordinate n (intrinsicCuspCutoffOperator N n u) =
      intrinsicPeterssonCuspCutoff N (n + 1) (raisedCoordinate n u) +
        intrinsicRaisePeterssonCommutator N n (l2Coordinate n u) := by
  rw [intrinsicRaisePeterssonCommutator_l2Coordinate_eq_sub]
  abel

theorem lowerFromSuccCoordinate_intrinsicCuspCutoffOperator
    (N : ℕ) (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    lowerFromSuccCoordinate n
        (intrinsicCuspCutoffOperator N (n + 1) u) =
      intrinsicPeterssonCuspCutoff N n (lowerFromSuccCoordinate n u) +
        intrinsicLowerFromSuccPeterssonCommutator N n
          (l2Coordinate (n + 1) u) := by
  rw [intrinsicLowerFromSuccPeterssonCommutator_l2Coordinate_eq_sub]
  abel

theorem negativeRaisedCoordinate_intrinsicPeterssonCuspCutoff
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    intrinsicPeterssonCuspCutoff N (n + 1) (-raisedCoordinate n u) =
      -raisedCoordinate n (intrinsicCuspCutoffOperator N n u) +
        intrinsicRaisePeterssonCommutator N n (l2Coordinate n u) := by
  rw [map_neg, raisedCoordinate_intrinsicCuspCutoffOperator]
  abel

theorem negativeLowerFromSuccCoordinate_intrinsicPeterssonCuspCutoff
    (N : ℕ) (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    intrinsicPeterssonCuspCutoff N n (-lowerFromSuccCoordinate n u) =
      -lowerFromSuccCoordinate n
          (intrinsicCuspCutoffOperator N (n + 1) u) +
        intrinsicLowerFromSuccPeterssonCommutator N n
          (l2Coordinate (n + 1) u) := by
  rw [map_neg, lowerFromSuccCoordinate_intrinsicCuspCutoffOperator]
  abel

theorem intrinsicPeterssonCuspCutoff_mem_l2CoreRange
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    intrinsicPeterssonCuspCutoff N n
        (x : OrbitPeterssonHilbert n) ∈
      LinearMap.range (l2Coordinate n) := by
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm x
  refine ⟨intrinsicCuspCutoffOperator N n u, ?_⟩
  calc
    l2Coordinate n (intrinsicCuspCutoffOperator N n u) =
        intrinsicPeterssonCuspCutoff N n (l2Coordinate n u) :=
      (intrinsicPeterssonCuspCutoff_l2Coordinate N n u).symm
    _ = intrinsicPeterssonCuspCutoff N n
        (x : OrbitPeterssonHilbert n) := by
      rw [l2Coordinate_l2CoreRangeEquiv_symm]

theorem adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    ContinuousLinearMap.adjoint (intrinsicPeterssonCuspCutoff N n)
        (x : OrbitPeterssonHilbert n) ∈
      LinearMap.range (l2Coordinate n) := by
  rw [adjoint_intrinsicPeterssonCuspCutoff]
  exact intrinsicPeterssonCuspCutoff_mem_l2CoreRange N n x

theorem negativePhysicalRaise_intrinsicCutoff_commutator
    (N : ℕ) (n : ℤ) (x : LinearMap.range (l2Coordinate n)) :
    ContinuousLinearMap.adjoint
        (intrinsicPeterssonCuspCutoff N (n + 1))
        ((-physicalRaise n) x) =
      (-physicalRaise n)
          ⟨ContinuousLinearMap.adjoint
              (intrinsicPeterssonCuspCutoff N n)
              (x : OrbitPeterssonHilbert n),
            adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange N n x⟩ +
        intrinsicRaisePeterssonCommutator N n
          (x : OrbitPeterssonHilbert n) := by
  simp only [adjoint_intrinsicPeterssonCuspCutoff]
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm x
  let xCut : LinearMap.range (l2Coordinate n) :=
    ⟨intrinsicPeterssonCuspCutoff N n
      (x : OrbitPeterssonHilbert n),
      intrinsicPeterssonCuspCutoff_mem_l2CoreRange N n x⟩
  have hx : l2Coordinate n u = (x : OrbitPeterssonHilbert n) :=
    l2Coordinate_l2CoreRangeEquiv_symm n x
  have hxCut : xCut =
      l2CoreRangeEquiv n (intrinsicCuspCutoffOperator N n u) := by
    apply Subtype.ext
    change intrinsicPeterssonCuspCutoff N n
        (x : OrbitPeterssonHilbert n) =
      l2Coordinate n (intrinsicCuspCutoffOperator N n u)
    rw [← hx, intrinsicPeterssonCuspCutoff_l2Coordinate]
  change intrinsicPeterssonCuspCutoff N (n + 1)
      ((-physicalRaise n) x) =
    (-physicalRaise n) xCut +
      intrinsicRaisePeterssonCommutator N n
        (x : OrbitPeterssonHilbert n)
  calc
    intrinsicPeterssonCuspCutoff N (n + 1)
        ((-physicalRaise n) x) =
      intrinsicPeterssonCuspCutoff N (n + 1)
        (-raisedCoordinate n u) := by
          rw [LinearPMap.neg_apply, physicalRaise_apply]
    _ = -raisedCoordinate n (intrinsicCuspCutoffOperator N n u) +
        intrinsicRaisePeterssonCommutator N n (l2Coordinate n u) :=
      negativeRaisedCoordinate_intrinsicPeterssonCuspCutoff N n u
    _ = (-physicalRaise n) xCut +
        intrinsicRaisePeterssonCommutator N n
          (x : OrbitPeterssonHilbert n) := by
      rw [hxCut, LinearPMap.neg_apply, physicalRaise_on_core, hx]

theorem negativePhysicalLowerFromSucc_intrinsicCutoff_commutator
    (N : ℕ) (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    ContinuousLinearMap.adjoint
        (intrinsicPeterssonCuspCutoff N n)
        ((-physicalLowerFromSucc n) x) =
      (-physicalLowerFromSucc n)
          ⟨ContinuousLinearMap.adjoint
              (intrinsicPeterssonCuspCutoff N (n + 1))
              (x : OrbitPeterssonHilbert (n + 1)),
            adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange
              N (n + 1) x⟩ +
        intrinsicLowerFromSuccPeterssonCommutator N n
          (x : OrbitPeterssonHilbert (n + 1)) := by
  simp only [adjoint_intrinsicPeterssonCuspCutoff]
  let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) :=
    (l2CoreRangeEquiv (n + 1)).symm x
  let xCut : LinearMap.range (l2Coordinate (n + 1)) :=
    ⟨intrinsicPeterssonCuspCutoff N (n + 1)
        (x : OrbitPeterssonHilbert (n + 1)),
      intrinsicPeterssonCuspCutoff_mem_l2CoreRange N (n + 1) x⟩
  have hx : l2Coordinate (n + 1) u =
      (x : OrbitPeterssonHilbert (n + 1)) :=
    l2Coordinate_l2CoreRangeEquiv_symm (n + 1) x
  have hxCut : xCut = l2CoreRangeEquiv (n + 1)
      (intrinsicCuspCutoffOperator N (n + 1) u) := by
    apply Subtype.ext
    change intrinsicPeterssonCuspCutoff N (n + 1)
        (x : OrbitPeterssonHilbert (n + 1)) =
      l2Coordinate (n + 1)
        (intrinsicCuspCutoffOperator N (n + 1) u)
    rw [← hx, intrinsicPeterssonCuspCutoff_l2Coordinate]
  change intrinsicPeterssonCuspCutoff N n
      ((-physicalLowerFromSucc n) x) =
    (-physicalLowerFromSucc n) xCut +
      intrinsicLowerFromSuccPeterssonCommutator N n
        (x : OrbitPeterssonHilbert (n + 1))
  calc
    intrinsicPeterssonCuspCutoff N n
        ((-physicalLowerFromSucc n) x) =
      intrinsicPeterssonCuspCutoff N n
        (-lowerFromSuccCoordinate n u) := by
          rw [LinearPMap.neg_apply, physicalLowerFromSucc_apply]
    _ = -lowerFromSuccCoordinate n
          (intrinsicCuspCutoffOperator N (n + 1) u) +
        intrinsicLowerFromSuccPeterssonCommutator N n
          (l2Coordinate (n + 1) u) :=
      negativeLowerFromSuccCoordinate_intrinsicPeterssonCuspCutoff N n u
    _ = (-physicalLowerFromSucc n) xCut +
        intrinsicLowerFromSuccPeterssonCommutator N n
          (x : OrbitPeterssonHilbert (n + 1)) := by
      rw [hxCut, LinearPMap.neg_apply,
        physicalLowerFromSucc_on_core, hx]

end FixedPhaseIntrinsicAdjointCutoff

