/-!
This fragment is intended after the invariant scalar multiplier, reduced-chart
weak-graph, local Friedrichs, and quotient-compatible finite-gluing fragments.

It closes the global-uniqueness gap for a local periodized limit.  Chart
restriction alone is only contractive and need not be injective.  Instead we
identify the limit by its pairing against every completed Petersson vector.
The pairing is exactly the pairing of the corresponding invariant scalar
multiplier, so density and nondegeneracy of the Hilbert inner product give the
global equality.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped ENNReal BigOperators
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseDensity
open FixedPhaseInvariantScalarMultiplier
open FixedPhaseAffineFriedrichs
open FixedPhasePlanarLocalization
open FixedPhaseNormalizedFriedrichs
open P5DiscriminantHardTruncation

noncomputable section

/-! ### A bounded planar multiplier attached to a compact smooth test -/

noncomputable def fullPlaneTestToLInfinity (phi : FullPlaneTest) :
    MeasureTheory.Lp ℂ ∞ (volume : Measure ℂ) :=
  (phi.continuous.memLp_top_of_hasCompactSupport
    phi.hasCompactSupport volume).toLp (phi : ℂ → ℂ)

theorem coeFn_fullPlaneTestToLInfinity (phi : FullPlaneTest) :
    (fullPlaneTestToLInfinity phi : ℂ → ℂ) =ᶠ[(volume : Measure ℂ)]
      (phi : ℂ → ℂ) :=
  MemLp.coeFn_toLp
    (phi.continuous.memLp_top_of_hasCompactSupport
      phi.hasCompactSupport volume)

/-- Bundled continuous multiplication by a compact smooth planar test. -/
noncomputable def fullPlaneTestMulCLM (phi : FullPlaneTest) :
    AmbientPlaneL2 →L[ℂ] AmbientPlaneL2 :=
  lpInfinityMultiplier (volume : Measure ℂ)
    (fullPlaneTestToLInfinity phi)

theorem fullPlaneTestMulCLM_apply
    (phi : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneTestMulCLM phi u = fullPlaneTestMulL2 phi u := by
  apply MeasureTheory.Lp.ext
  filter_upwards [
    MeasureTheory.Lp.coeFn_lpSMul (fullPlaneTestToLInfinity phi) u,
    coeFn_fullPlaneTestToLInfinity phi,
    coeFn_fullPlaneTestMulL2 phi u] with z hmul hphi htarget
  rw [lpInfinityMultiplier_apply, hmul, hphi, htarget]
  rfl

/-! ### The compact chart test obtained by localizing a smooth core gauge -/

noncomputable def reducedChartGaugeLocalizedAmbientTest
    (m : ℤ) (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  HalfWeightCompactCoordinateGreen.localizeLeft
    (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m u)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_realSmooth m u) phi

@[simp]
theorem reducedChartGaugeLocalizedAmbientTest_apply
    (m : ℤ) (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) (w : ℂ) :
    reducedChartGaugeLocalizedAmbientTest m phi u w =
      upperLift (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m u) w *
        phi w :=
  rfl

theorem tsupport_reducedChartGaugeLocalizedAmbientTest_subset
    (m : ℤ) (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    tsupport
        (reducedChartGaugeLocalizedAmbientTest m phi u : ℂ → ℂ) ⊆
      tsupport (phi : ℂ → ℂ) := by
  change tsupport (fun w : ℂ ↦
      upperLift (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m u) w * phi w) ⊆
    tsupport (phi : ℂ → ℂ)
  exact tsupport_mul_subset_right

/-- Multiplication by the invariant scalar periodization of `phi` is a
genuine reduced-chart gauge model of the compact product `phi * u`. -/
theorem invariantScalarCoreOperator_isReducedChartGaugeModel
    {m : ℤ} {z₀ : ℍ}
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    IsReducedChartGaugeModel m z₀
      (invariantScalarCoreOperator
        (effectiveScalarSmoothQuotient phi)
        (effectiveScalarSmoothQuotient_invariant phi) m u)
      (ambientTestCoreToFullPlaneTest
        (reducedChartGaugeLocalizedAmbientTest m phi u)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    rw [fixedPhaseEuclideanGauge_invariantScalarCoreOperator,
      effectiveScalarSmoothQuotient_apply,
      effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
        phi hphi hz,
      ambientTestCoreToFullPlaneTest_apply,
      reducedChartGaugeLocalizedAmbientTest_apply, upperLift_apply]
    ring
  · intro z hz
    have hcZero : effectiveScalarPoincarePeriodization phi z = 0 := by
      by_contra hcNe
      have hzSupport : z ∈
          Function.support (effectiveScalarPoincarePeriodization phi) := hcNe
      have hzOrbit :=
        support_effectiveScalarPoincarePeriodization_subset_orbitSupport
          phi hzSupport
      exact hz
        (effectiveScalarPeriodizationOrbitSupport_subset_saturation
          hphi hzOrbit)
    rw [fixedPhaseEuclideanGauge_invariantScalarCoreOperator,
      effectiveScalarSmoothQuotient_apply, hcZero, zero_mul]
  · exact
      (tsupport_comp_subset rfl
        (reducedChartGaugeLocalizedAmbientTest m phi u : ℂ → ℂ)).trans <|
        (tsupport_reducedChartGaugeLocalizedAmbientTest_subset m phi u).trans
          hphi

/-- On a literal core vector, the compact localized full-plane test is
exactly multiplication of the completed chart restriction by `phi`. -/
theorem fullPlaneTestToL2_reducedChartGaugeLocalizedAmbientTest
    {m : ℤ} {z₀ : ℍ}
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    fullPlaneTestToL2
        (ambientTestCoreToFullPlaneTest
          (reducedChartGaugeLocalizedAmbientTest m phi u)) =
      fullPlaneTestMulL2 (ambientTestCoreToFullPlaneTest phi)
        (orbitPeterssonReducedChartEmbedding m z₀
          (l2Coordinate m u)) := by
  rw [l2Coordinate_apply, orbitPeterssonReducedChartEmbedding_coe]
  apply MeasureTheory.Lp.ext
  filter_upwards [
    coeFn_fullPlaneTestToL2
      (ambientTestCoreToFullPlaneTest
        (reducedChartGaugeLocalizedAmbientTest m phi u)),
    coeFn_fullPlaneTestMulL2 (ambientTestCoreToFullPlaneTest phi)
      (orbitPeterssonCoreToReducedChartL2 m z₀ (coreEmbedding m u)),
    coeFn_orbitPeterssonCoreToReducedChartL2 m z₀
      (coreEmbedding m u)] with w hleft hright hchart
  rw [hleft, hright, ambientTestCoreToFullPlaneTest_apply,
    ambientTestCoreToFullPlaneTest_apply,
    reducedChartGaugeLocalizedAmbientTest_apply, hchart]
  by_cases hw : w ∈ ambientGammaTwoReducedChart z₀
  · rcases hw with ⟨z, hz, rfl⟩
    simp only [ambientReducedChartGauge_comp_coe, hz, Set.indicator_of_mem,
      upperLift_apply, Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge]
    ring
  · have hphiZero : phi w = 0 := by
      by_contra hne
      exact hw (hphi (subset_tsupport hne))
    simp only [hphiZero, mul_zero, zero_mul]

/-! ### Pairing characterization of the completed invariant multiplier -/

theorem inner_invariantScalarPeterssonMultiplier_eq_localizedChartPair
    {m : ℤ} {z₀ : ℍ}
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (x p : OrbitPeterssonHilbert m) :
    inner ℂ x
        (invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient phi)
          (effectiveScalarSmoothQuotient_invariant phi) m p) =
      inner ℂ (orbitPeterssonReducedChartEmbedding m z₀ x)
        (fullPlaneTestMulCLM (ambientTestCoreToFullPlaneTest phi)
          (orbitPeterssonReducedChartEmbedding m z₀ p)) := by
  refine (denseRange_l2Coordinate m).induction_on p
    (isClosed_eq
      (continuous_const.inner
        ((invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient phi)
          (effectiveScalarSmoothQuotient_invariant phi) m).continuous))
      (continuous_const.inner
        ((fullPlaneTestMulCLM (ambientTestCoreToFullPlaneTest phi)).continuous.comp
          (orbitPeterssonReducedChartEmbedding m z₀).continuous))) ?_
  intro u
  rw [invariantScalarPeterssonMultiplier_l2Coordinate,
    inner_l2Coordinate_eq_reducedChart_pair
      (invariantScalarCoreOperator_isReducedChartGaugeModel phi hphi u),
    fullPlaneTestToL2_reducedChartGaugeLocalizedAmbientTest phi hphi u,
    fullPlaneTestMulCLM_apply]

/-- A local periodized base-coordinate limit is globally the invariant scalar
multiplier localization.  The proof uses all completed test vectors, so it
does not infer injectivity from the contractive chart restriction. -/
theorem localBaseLimit_eq_invariantScalarMultiplier
    {m : ℤ} {z₀ : ℍ}
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (p x : OrbitPeterssonHilbert m)
    (q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m)
    (v : ℕ → FullPlaneTest)
    (hModel : ∀ j : ℕ, IsReducedChartGaugeModel m z₀ (q j) (v j))
    (hq : Filter.Tendsto (fun j ↦ l2Coordinate m (q j)) Filter.atTop (𝓝 x))
    (hv : Filter.Tendsto (fun j ↦ fullPlaneTestToL2 (v j)) Filter.atTop
      (𝓝 (fullPlaneTestMulCLM (ambientTestCoreToFullPlaneTest phi)
        (orbitPeterssonReducedChartEmbedding m z₀ p)))) :
    x = invariantScalarPeterssonMultiplier
      (effectiveScalarSmoothQuotient phi)
      (effectiveScalarSmoothQuotient_invariant phi) m p := by
  let y := invariantScalarPeterssonMultiplier
    (effectiveScalarSmoothQuotient phi)
    (effectiveScalarSmoothQuotient_invariant phi) m p
  have hPair (w : OrbitPeterssonHilbert m) : inner ℂ w x = inner ℂ w y := by
    have hLeft : Filter.Tendsto
        (fun j ↦ inner ℂ w (l2Coordinate m (q j))) Filter.atTop
        (𝓝 (inner ℂ w x)) :=
      (continuous_const.inner continuous_id).continuousAt.tendsto.comp hq
    have hRight : Filter.Tendsto
        (fun j ↦ inner ℂ
          (orbitPeterssonReducedChartEmbedding m z₀ w)
          (fullPlaneTestToL2 (v j))) Filter.atTop
        (𝓝 (inner ℂ
          (orbitPeterssonReducedChartEmbedding m z₀ w)
          (fullPlaneTestMulCLM (ambientTestCoreToFullPlaneTest phi)
            (orbitPeterssonReducedChartEmbedding m z₀ p)))) :=
      (continuous_const.inner continuous_id).continuousAt.tendsto.comp hv
    have hEq : (fun j ↦ inner ℂ w (l2Coordinate m (q j))) =
        (fun j ↦ inner ℂ
          (orbitPeterssonReducedChartEmbedding m z₀ w)
          (fullPlaneTestToL2 (v j))) := by
      funext j
      exact inner_l2Coordinate_eq_reducedChart_pair (hModel j) w
    have hxLocal : inner ℂ w x = inner ℂ
        (orbitPeterssonReducedChartEmbedding m z₀ w)
        (fullPlaneTestMulCLM (ambientTestCoreToFullPlaneTest phi)
          (orbitPeterssonReducedChartEmbedding m z₀ p)) := by
      exact tendsto_nhds_unique hLeft (hEq.symm ▸ hRight)
    rw [hxLocal]
    exact (inner_invariantScalarPeterssonMultiplier_eq_localizedChartPair
      phi hphi w p).symm
  change x = y
  apply sub_eq_zero.mp
  apply inner_self_eq_zero.mp
  rw [inner_sub_right, hPair, sub_self]

end
