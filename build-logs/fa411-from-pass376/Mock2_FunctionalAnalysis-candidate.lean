/-!
================================================================================
P3.8: global Stokes bridge -- null boundaries, common cusp height, and top tail

This block supplies the measure-theoretic and cusp-tail interfaces needed by
the global six-tile Stokes argument.  It is deliberately independent of the
curved-chart derivative calculation: no Stokes conclusion is assumed here.
================================================================================
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace GammaTwoGlobalStokesBridge

open MeasureTheory Set Function Topology Filter
open scoped Pointwise Interval
open GammaTwoQuotientGeometry GammaTwoQuotientGreenBoundary
open GammaTwoCurvilinearTileStokes GammaTwoMoebiusPiola
open GammaTwoOrientedBoundaryIntegral
open HalfWeightDifferentialOperators SmoothCompactCoreGeometry

/-! #### A. The selected open and half-open tiles agree almost everywhere -/

/-- The standard half-open modular tile differs from the standard open tile
only on the already-proved hyperbolic-null modular boundary. -/
theorem modularHalfOpenTile_ae_eq_fdo :
    modularHalfOpenTile =ᵐ[hyperbolicMeasure] ModularGroup.fdo := by
  apply Filter.EventuallyLE.antisymm
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro z hz
      exact ⟨modularHalfOpenTile_subset_fd hz.1, hz.2⟩)
      modularBoundary_null
  · exact ModularGroup.fdo_subset_modularHalfOpenTile.eventuallyLE

/-- The standard open and closed modular domains also differ only on the
same null boundary. -/
theorem modularFdo_ae_eq_fd :
    ModularGroup.fdo =ᵐ[hyperbolicMeasure] ModularGroup.fd := by
  apply Filter.EventuallyLE.antisymm
  · exact ModularGroup.fdo_subset_fd.eventuallyLE
  · rw [ae_le_set]
    simpa only [modularBoundary] using modularBoundary_null

/-- Null-boundary equality is preserved by every selected Möbius translate.
This is the per-tile equality required by the finite carrier decomposition. -/
theorem selectedHalfOpenTile_ae_eq_openTile
    (q : GammaTwoRightCoset) :
    gammaTwoCosetRep q • modularHalfOpenTile =ᵐ[hyperbolicMeasure]
      gammaTwoCosetRep q • ModularGroup.fdo :=
  Measure.QuasiMeasurePreserving.smul_ae_eq_of_ae_eq (gammaTwoCosetRep q)
    (measurePreserving_smul (gammaTwoCosetRep q)⁻¹
      hyperbolicMeasure).quasiMeasurePreserving
    modularHalfOpenTile_ae_eq_fdo

/-- Consequently every Bochner set integral may be moved between the actual
selected open tile and its half-open representative without an integrability
hypothesis. -/
theorem setIntegral_selectedOpenTile_eq_halfOpenTile
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (q : GammaTwoRightCoset) (f : ℍ → E) :
    (∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
        f z ∂hyperbolicMeasure) =
      ∫ z in gammaTwoCosetRep q • modularHalfOpenTile,
        f z ∂hyperbolicMeasure :=
  setIntegral_congr_set (selectedHalfOpenTile_ae_eq_openTile q).symm

/-! #### B. One literal height works in all six selected cusp charts -/

/-- The open part of the standard modular tile above height `H`.  Its
openness is essential: pointwise zero on this set gives local zero and hence
zero coordinate derivatives. -/
def modularOpenHighTail (H : ℝ) : Set ℍ :=
  ModularGroup.fdo ∩ {z : ℍ | H < z.im}

theorem modularOpenHighTail_isOpen (H : ℝ) :
    IsOpen (modularOpenHighTail H) :=
  ModularGroup.isOpen_fdo.inter
    (isOpen_lt continuous_const UpperHalfPlane.continuous_im)

/-- Literal vanishing outside one three-cusp truncation yields one common
base-tile height for every selected right-coset representative.  The proof
uses the very same coset `q` in the universal height condition defining
`gammaTwoThreeCuspTruncation`; no comparison between different cusp charts
is postulated. -/
theorem HasZeroThreeCuspTail.exists_commonBaseHeight_zero
    {X Y : ℍ → ℂ} (hTail : HasZeroThreeCuspTail X Y) :
    ∃ H : ℝ, 1 < H ∧
      ∀ (q : GammaTwoRightCoset) (z : ℍ),
        z ∈ ModularGroup.fd → H ≤ z.im →
          X (selectedCosetAction q z) = 0 ∧
            Y (selectedCosetAction q z) = 0 := by
  rcases hTail with ⟨Y₀, hY₀, hTail⟩
  refine ⟨Y₀ + 1, by linarith, ?_⟩
  intro q z hzfd hzHigh
  apply hTail (selectedCosetAction q z)
  refine ⟨?_, ?_⟩
  · exact mem_gammaTwoClosedTileCarrier_iff.mpr
      ⟨q, z, hzfd, rfl⟩
  · intro hzTrunc
    have hqHeight :=
      (mem_gammaTwoThreeCuspTruncation_iff.mp hzTrunc).2
        (gammaTwoTileCuspClass q) q rfl
    have hheight :
        gammaTwoTileHeight q (selectedCosetAction q z) = z.im := by
      simp [gammaTwoTileHeight, selectedCosetAction]
    rw [hheight, gammaTwoCuspLevel_of_one_le hY₀.le] at hqHeight
    linarith

/-- On the open high tail, the two selected pullbacks are locally the zero
function.  This strengthens pointwise tail vanishing precisely enough for
the derivative API. -/
theorem selectedFields_eventuallyEq_zero_on_modularOpenHighTail
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) {z : ℍ}
    (hz : z ∈ modularOpenHighTail H) :
    (fun w : ℍ => X (selectedCosetAction q w)) =ᶠ[nhds z]
        (0 : ℍ → ℂ) ∧
      (fun w : ℍ => Y (selectedCosetAction q w)) =ᶠ[nhds z]
        (0 : ℍ → ℂ) := by
  have hTailNhd : modularOpenHighTail H ∈ nhds z :=
    (modularOpenHighTail_isOpen H).mem_nhds hz
  constructor
  · filter_upwards [hTailNhd] with w hw
    exact (hZero q w (ModularGroup.fdo_subset_fd hw.1) hw.2.le).1
  · filter_upwards [hTailNhd] with w hw
    exact (hZero q w (ModularGroup.fdo_subset_fd hw.1) hw.2.le).2

/-- Both coefficients of the genuine Möbius--Piola pullback are locally zero
on the common high tail. -/
theorem selectedCosetPiola_eventuallyEq_zero_on_modularOpenHighTail
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) {z : ℍ}
    (hz : z ∈ modularOpenHighTail H) :
    selectedCosetPiolaX q X Y =ᶠ[nhds z] (0 : ℍ → ℂ) ∧
      selectedCosetPiolaY q X Y =ᶠ[nhds z] (0 : ℍ → ℂ) := by
  have hFields :=
    selectedFields_eventuallyEq_zero_on_modularOpenHighTail hZero q hz
  constructor
  · filter_upwards [hFields.1, hFields.2] with w hXw hYw
    simp only [Pi.zero_apply] at hXw hYw ⊢
    rw [selectedCosetPiolaX_coordinate, hXw, hYw]
    ring
  · filter_upwards [hFields.1, hFields.2] with w hXw hYw
    simp only [Pi.zero_apply] at hXw hYw ⊢
    rw [selectedCosetPiolaY_coordinate, hXw, hYw]
    ring

/-- The common high tail is disjoint from both Piola topological supports. -/
theorem selectedCosetPiola_not_mem_tsupport_on_modularOpenHighTail
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) {z : ℍ}
    (hz : z ∈ modularOpenHighTail H) :
    z ∉ tsupport (selectedCosetPiolaX q X Y) ∧
      z ∉ tsupport (selectedCosetPiolaY q X Y) := by
  have hPiola :=
    selectedCosetPiola_eventuallyEq_zero_on_modularOpenHighTail hZero q hz
  exact ⟨notMem_tsupport_iff_eventuallyEq.mpr hPiola.1,
    notMem_tsupport_iff_eventuallyEq.mpr hPiola.2⟩

/-- Hence the pulled-back Euclidean divergence is exactly zero, pointwise,
on the open high tail. -/
theorem selectedCosetPiola_divergence_eq_zero_on_modularOpenHighTail
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) {z : ℍ}
    (hz : z ∈ modularOpenHighTail H) :
    dx (selectedCosetPiolaX q X Y) z +
        dy (selectedCosetPiolaY q X Y) z = 0 := by
  have hSupport :=
    selectedCosetPiola_not_mem_tsupport_on_modularOpenHighTail hZero q hz
  rw [dx_eq_zero_of_not_mem_tsupport hSupport.1,
    dy_eq_zero_of_not_mem_tsupport hSupport.2, zero_add]

/-! #### C. Removing the full open cusp tail from each base tile -/

/-- A function which is zero on the open high tail has the same integral on
the full half-open modular tile and on the closed height truncation.  The
only set changes not covered by pointwise vanishing lie on the proved-null
modular boundary. -/
theorem setIntegral_modularHalfOpenTile_eq_closedTruncation_of_highTail_zero
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (H : ℝ) (f : ℍ → E)
    (hZero : ∀ z ∈ modularOpenHighTail H, f z = 0) :
    (∫ z in modularHalfOpenTile, f z ∂hyperbolicMeasure) =
      ∫ z in modularClosedTileTruncation H,
        f z ∂hyperbolicMeasure := by
  calc
    (∫ z in modularHalfOpenTile, f z ∂hyperbolicMeasure) =
        ∫ z in ModularGroup.fdo, f z ∂hyperbolicMeasure :=
      setIntegral_congr_set modularHalfOpenTile_ae_eq_fdo
    _ = ∫ z in ModularGroup.fdo ∩ {z : ℍ | z.im ≤ H},
        f z ∂hyperbolicMeasure := by
      apply setIntegral_eq_of_subset_of_forall_diff_eq_zero
        ModularGroup.isOpen_fdo.measurableSet Set.inter_subset_left
      intro z hz
      apply hZero z
      refine ⟨hz.1, ?_⟩
      by_contra hHigh
      exact hz.2 ⟨hz.1,
        (show z.im ≤ H from le_of_not_gt hHigh)⟩
    _ = ∫ z in modularClosedTileTruncation H,
        f z ∂hyperbolicMeasure := by
      apply setIntegral_congr_set
      simpa only [modularClosedTileTruncation] using
        ae_eq_set_inter modularFdo_ae_eq_fd
          (ae_eq_refl {z : ℍ | z.im ≤ H})

/-- Specialization of the preceding tail-removal theorem to the true
Möbius--Piola divergence density. -/
theorem integral_selectedPiola_full_eq_closedTruncation
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) :
    (∫ z in modularHalfOpenTile,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure) =
      ∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure := by
  apply setIntegral_modularHalfOpenTile_eq_closedTruncation_of_highTail_zero
  intro z hz
  rw [selectedCosetPiola_divergence_eq_zero_on_modularOpenHighTail
    hZero q hz, mul_zero]

/-- Planar form of the same equality, ready to be composed with the curved
base-tile Stokes theorem. -/
theorem integral_complexImage_selectedPiola_eq_closedTruncation
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (q : GammaTwoRightCoset) :
    (∫ w in UpperHalfPlane.coe '' modularHalfOpenTile,
        upperLift (fun z =>
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z) w
        ∂(volume : Measure ℂ)) =
      ∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure := by
  calc
    (∫ w in UpperHalfPlane.coe '' modularHalfOpenTile,
        upperLift (fun z =>
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z) w
        ∂(volume : Measure ℂ)) =
        ∫ z in modularHalfOpenTile,
          heightC z ^ 2 *
            (dx (selectedCosetPiolaX q X Y) z +
              dy (selectedCosetPiolaY q X Y) z)
          ∂hyperbolicMeasure :=
      (setIntegral_heightSq_mul_hyperbolic_eq_complexImage
        modularHalfOpenTile modularHalfOpenTile_measurable _).symm
    _ = ∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure :=
      integral_selectedPiola_full_eq_closedTruncation hZero q

/-- A literal three-cusp zero tail therefore supplies one common truncation
height for all six Piola divergence integrals. -/
theorem HasZeroThreeCuspTail.exists_commonPiolaTruncation
    {X Y : ℍ → ℂ} (hTail : HasZeroThreeCuspTail X Y) :
    ∃ H : ℝ, 1 < H ∧ ∀ q : GammaTwoRightCoset,
      (∫ z in modularHalfOpenTile,
          heightC z ^ 2 *
            (dx (selectedCosetPiolaX q X Y) z +
              dy (selectedCosetPiolaY q X Y) z)
          ∂hyperbolicMeasure) =
        ∫ z in modularClosedTileTruncation H,
          heightC z ^ 2 *
            (dx (selectedCosetPiolaX q X Y) z +
              dy (selectedCosetPiolaY q X Y) z)
          ∂hyperbolicMeasure := by
  rcases HasZeroThreeCuspTail.exists_commonBaseHeight_zero hTail with ⟨H, hH, hZero⟩
  exact ⟨H, hH, fun q =>
    integral_selectedPiola_full_eq_closedTruncation hZero q⟩

/-! #### D. The top horocycles vanish at that same common height -/

/-- Every point on the horizontal segment `[-1/2,1/2] + iH`, for `H>1`,
lies in the closed standard modular tile. -/
theorem baseHorocycleParam_mem_fd
    {H : ℝ} (hH0 : 0 < H) (hH : 1 < H) {t : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    baseHorocycleParam H hH0 t ∈ ModularGroup.fd := by
  change 1 ≤ Complex.normSq (Complex.mk t H) ∧
    |t| ≤ (1 : ℝ) / 2
  constructor
  · simp only [Complex.normSq_apply]
    have hprod : 0 < (H - 1) * (H + 1) :=
      mul_pos (sub_pos.mpr hH) (by linarith)
    nlinarith [sq_nonneg t]
  · exact abs_le.mpr ht

/-- The original vector field vanishes at every selected top-horocycle
point at a common tail height. -/
theorem selectedFields_eq_zero_on_commonTop
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hH0 : 0 < H) (hH : 1 < H) (q : GammaTwoRightCoset)
    {t : ℝ} (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    X (selectedCosetAction q (baseHorocycleParam H hH0 t)) = 0 ∧
      Y (selectedCosetAction q (baseHorocycleParam H hH0 t)) = 0 := by
  apply hZero q (baseHorocycleParam H hH0 t)
  · exact baseHorocycleParam_mem_fd hH0 hH ht
  · simp [baseHorocycleParam]

/-- Both Piola coefficients vanish on the same top segment. -/
theorem selectedCosetPiola_eq_zero_on_commonTop
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hH0 : 0 < H) (hH : 1 < H) (q : GammaTwoRightCoset)
    {t : ℝ} (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    selectedCosetPiolaX q X Y (baseHorocycleParam H hH0 t) = 0 ∧
      selectedCosetPiolaY q X Y (baseHorocycleParam H hH0 t) = 0 := by
  have hFields := selectedFields_eq_zero_on_commonTop
    hZero hH0 hH q ht
  constructor
  · rw [selectedCosetPiolaX_coordinate, hFields.1, hFields.2]
    ring
  · rw [selectedCosetPiolaY_coordinate, hFields.1, hFields.2]
    ring

/-- The horizontal top contribution in base Piola coordinates is exactly
zero, not merely convergent to zero as `H → ∞`. -/
theorem selectedPiola_topHorocycle_fluxIntegral_eq_zero
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hH0 : 0 < H) (hH : 1 < H) (q : GammaTwoRightCoset) :
    orientedFluxParameterIntegral
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)
        (baseHorocycleParam H hH0) (fun _ => 1)
        (-(1 / 2 : ℝ)) (1 / 2 : ℝ) = 0 := by
  calc
    orientedFluxParameterIntegral
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)
        (baseHorocycleParam H hH0) (fun _ => 1)
        (-(1 / 2 : ℝ)) (1 / 2 : ℝ) =
        ∫ _t in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), (0 : ℂ) := by
      apply intervalIntegral.integral_congr
      intro t ht
      have ht' : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
        simpa [uIcc_of_le (by norm_num :
          (-(1 / 2 : ℝ)) ≤ (1 / 2 : ℝ))] using ht
      have hPiola := selectedCosetPiola_eq_zero_on_commonTop
        hZero hH0 hH q ht'
      simp [orientedFluxParameterIntegral, fluxOneFormValue,
        hPiola.1, hPiola.2]
    _ = 0 := by simp

/-- Equivalently, on the actual selected tile the transformed top curve and
its genuine Möbius differential have zero flux integral. -/
theorem selectedActualTopHorocycle_fluxIntegral_eq_zero
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hH0 : 0 < H) (hH : 1 < H) (q : GammaTwoRightCoset) :
    orientedFluxParameterIntegral X Y
        (fun t => selectedCosetAction q (baseHorocycleParam H hH0 t))
        (fun t => UpperHalfPlane.smulFDeriv (selectedCosetGL q)
          (baseHorocycleParam H hH0 t : ℂ) 1)
        (-(1 / 2 : ℝ)) (1 / 2 : ℝ) = 0 := by
  calc
    orientedFluxParameterIntegral X Y
        (fun t => selectedCosetAction q (baseHorocycleParam H hH0 t))
        (fun t => UpperHalfPlane.smulFDeriv (selectedCosetGL q)
          (baseHorocycleParam H hH0 t : ℂ) 1)
        (-(1 / 2 : ℝ)) (1 / 2 : ℝ) =
        ∫ _t in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), (0 : ℂ) := by
      apply intervalIntegral.integral_congr
      intro t ht
      have ht' : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
        simpa [uIcc_of_le (by norm_num :
          (-(1 / 2 : ℝ)) ≤ (1 / 2 : ℝ))] using ht
      have hFields := selectedFields_eq_zero_on_commonTop
        hZero hH0 hH q ht'
      simp [orientedFluxParameterIntegral, fluxOneFormValue,
        hFields.1, hFields.2]
    _ = 0 := by simp

/-- The zero-tail hypothesis supplies one and the same height for both the
full-to-truncated divergence identity and every selected top-horocycle
cancellation. -/
theorem HasZeroThreeCuspTail.exists_commonPiolaTruncation_and_top_zero
    {X Y : ℍ → ℂ} (hTail : HasZeroThreeCuspTail X Y) :
    ∃ H : ℝ, ∃ hH0 : 0 < H, 1 < H ∧
      ∀ q : GammaTwoRightCoset,
        ((∫ z in modularHalfOpenTile,
            heightC z ^ 2 *
              (dx (selectedCosetPiolaX q X Y) z +
                dy (selectedCosetPiolaY q X Y) z)
            ∂hyperbolicMeasure) =
          ∫ z in modularClosedTileTruncation H,
            heightC z ^ 2 *
              (dx (selectedCosetPiolaX q X Y) z +
                dy (selectedCosetPiolaY q X Y) z)
            ∂hyperbolicMeasure) ∧
        orientedFluxParameterIntegral X Y
            (fun t => selectedCosetAction q
              (baseHorocycleParam H hH0 t))
            (fun t => UpperHalfPlane.smulFDeriv (selectedCosetGL q)
              (baseHorocycleParam H hH0 t : ℂ) 1)
            (-(1 / 2 : ℝ)) (1 / 2 : ℝ) = 0 := by
  rcases HasZeroThreeCuspTail.exists_commonBaseHeight_zero hTail with ⟨H, hH, hZero⟩
  have hH0 : 0 < H := by linarith
  refine ⟨H, hH0, hH, ?_⟩
  intro q
  exact ⟨integral_selectedPiola_full_eq_closedTruncation hZero q,
    selectedActualTopHorocycle_fluxIntegral_eq_zero hZero hH0 hH q⟩

end GammaTwoGlobalStokesBridge

