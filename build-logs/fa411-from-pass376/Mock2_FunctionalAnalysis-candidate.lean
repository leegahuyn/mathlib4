    finalContradiction_dependsOn_eisensteinNormalization,
    finalContradiction_dependsOn_scatteringPlancherel,
    finalContradiction_dependsOn_multiplierKloostermanCancellation,
    finalContradiction_dependsOn_actualUniformLowerActivity,
