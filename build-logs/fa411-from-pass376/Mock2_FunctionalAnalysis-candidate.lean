/-!
## P11. Honest spectral/Kuznetsov boundary

The functional-analytic package does not manufacture a half-integral
Kuznetsov formula, Eisenstein normalization, scattering Plancherel theorem,
or a multiplier-dependent Kloosterman estimate. None is currently available
in Mathlib at the normalization used here. This section formalizes only the
exact final logical reduction: valid lower and upper estimates must have an
actual crossover index. Every premise stays visible and no inhabitant for the
manuscript's proposed arithmetic estimates is constructed.
-/

namespace Mock2FA.PaperCorrections.P11ConditionalReduction

open Set

/-- Complete numerical input needed at the final comparison step. -/
def ExactLowerUpperCrossoverInput
    (S lower upper : ℕ → ℝ) (I : Set ℕ) : Prop :=
  (∀ m ∈ I, lower m ≤ S m) ∧
    (∀ m, |S m| ≤ upper m) ∧
      ∃ m ∈ I, upper m < lower m

/-- With all three premises proved for one normalization and one test family,
the contradiction is immediate. -/
theorem false_of_exactLowerUpperCrossoverInput
    {S lower upper : ℕ → ℝ} {I : Set ℕ}
    (h : ExactLowerUpperCrossoverInput S lower upper I) : False :=
  contradiction_of_lower_upper_cross h.1 h.2.1 h.2.2

/-- Quantitative lower activity explicitly contains an index-independent
positive constant. -/
def HasUniformLowerActivity
    (mass : ℕ → ℝ) (I : Set ℕ) : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ ∀ m ∈ I, δ ≤ mass m

/-- Uniform lower activity implies pointwise nonnegativity on selected
indices. The converse is deliberately absent and is refuted in P10. -/
theorem nonneg_on_of_hasUniformLowerActivity
    {mass : ℕ → ℝ} {I : Set ℕ}
    (h : HasUniformLowerActivity mass I) :
    ∀ m ∈ I, 0 ≤ mass m := by
  obtain ⟨δ, hδ, hmass⟩ := h
  intro m hm
  exact hδ.le.trans (hmass m hm)

/-- Fixed positive lower and polynomially growing upper profiles do not force
a contradiction without a proved crossover. -/
theorem fixedLower_polynomialUpper_has_no_forced_contradiction
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ S : ℕ → ℝ,
      (∀ m, δ ≤ S m) ∧
        (∀ m, |S m| ≤ δ + (m : ℝ)) :=
  fixed_lower_compatible_with_polynomial_upper δ hδ

end Mock2FA.PaperCorrections.P11ConditionalReduction

namespace AxiomAuditP11ConditionalBoundary

#print axioms Mock2FA.PaperCorrections.P11ConditionalReduction.false_of_exactLowerUpperCrossoverInput
#print axioms Mock2FA.PaperCorrections.P11ConditionalReduction.nonneg_on_of_hasUniformLowerActivity
#print axioms Mock2FA.PaperCorrections.P11ConditionalReduction.fixedLower_polynomialUpper_has_no_forced_contradiction

end AxiomAuditP11ConditionalBoundary

/-!
## P3.26: positive reduced-chart buffers for Friedrichs convolution

A quotient-side Friedrichs argument may not extend through the boundary of
one chosen polygon.  The correct local object is a compact chart piece with
a positive closed-thickening buffer.  This section proves the complete
support bookkeeping for the normalized mollifier and for both affine
commutator kernels.  These lemmas are shared by P3 graph regularization and
P5 finite-chart Rellich.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff
open FixedPhaseAffineFriedrichs
open FixedPhaseNormalizedFriedrichs

noncomputable section

/-- A compact carrier, an open reduced chart, and a literal positive buffer
between them. -/
structure CompactChartBuffer (K U : Set ℂ) where
  radius : ℝ
  radius_pos : 0 < radius
  cthickening_subset : cthickening radius K ⊆ U

/-- Compact-inside-open separation, expressed in the exact closed-thickening
form needed for support of convolution. -/
noncomputable def compactChartBuffer
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) : CompactChartBuffer K U := by
  obtain ⟨delta, hdelta, hsub⟩ :=
    hK.exists_cthickening_subset_open hU hKU
  exact ⟨delta, hdelta, hsub⟩

@[simp]
theorem compactChartBuffer_radius_pos
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) :
    0 < (compactChartBuffer hK hU hKU).radius :=
  (compactChartBuffer hK hU hKU).radius_pos

theorem compactChartBuffer_cthickening_subset
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) :
    cthickening (compactChartBuffer hK hU hKU).radius K ⊆ U :=
  (compactChartBuffer hK hU hKU).cthickening_subset

theorem friedrichsRadius_pos (j : ℕ) :
    0 < friedrichsRadius j := by
  exact div_pos (by norm_num) (friedrichsScale_pos j)

theorem support_friedrichsMollifierReal_subset_closedBall (j : ℕ) :
    Function.support (friedrichsMollifierReal j) ⊆
      closedBall (0 : ℂ) (friedrichsRadius j) := by
  intro t ht
  have htComplex : friedrichsMollifier j t ≠ 0 := by
    simpa only [friedrichsMollifier, Complex.ofReal_ne_zero] using ht
  simpa only [mem_closedBall, dist_zero_right] using
    friedrichsMollifier_support_bound j t htComplex

theorem support_friedrichsAffineCommutatorKernel_subset_closedBall
    (sigma : ℂ) (j : ℕ) :
    Function.support (friedrichsAffineCommutatorKernel sigma j) ⊆
      closedBall (0 : ℂ) (friedrichsRadius j) := by
  intro t ht
  simpa only [mem_closedBall, dist_zero_right] using
    friedrichsAffineCommutatorKernel_support_bound sigma j t ht

/-- Base convolution support is contained in the closed thickening of the
pointwise source support. -/
theorem support_friedrichsMollifiedRepresentative_subset_cthickening
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    Function.support (friedrichsMollifiedRepresentative j u) ⊆
      cthickening (friedrichsRadius j) K := by
  refine (support_convolution_subset_swap (lsmul ℝ ℂ)).trans ?_
  calc
    Function.support (u : ℂ → ℂ) +
          Function.support (friedrichsMollifierReal j) ⊆
        K + closedBall (0 : ℂ) (friedrichsRadius j) :=
      add_subset_add hu
        (support_friedrichsMollifierReal_subset_closedBall j)
    _ = cthickening (friedrichsRadius j) K :=
      hK.add_closedBall_zero (friedrichsRadius_pos j).le

/-- Both signed affine kernels have exactly the same thickening bound. -/
theorem support_affineCommutatorConvolution_subset_cthickening
    {K : Set ℂ} (hK : IsCompact K) (sigma : ℂ) (j : ℕ)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    Function.support
        (friedrichsAffineCommutatorKernel sigma j
          ⋆[lsmul ℂ ℂ, volume] (u : ℂ → ℂ)) ⊆
      cthickening (friedrichsRadius j) K := by
  refine (support_convolution_subset_swap (lsmul ℂ ℂ)).trans ?_
  calc
    Function.support (u : ℂ → ℂ) +
          Function.support (friedrichsAffineCommutatorKernel sigma j) ⊆
        K + closedBall (0 : ℂ) (friedrichsRadius j) :=
      add_subset_add hu
        (support_friedrichsAffineCommutatorKernel_subset_closedBall sigma j)
    _ = cthickening (friedrichsRadius j) K :=
      hK.add_closedBall_zero (friedrichsRadius_pos j).le

theorem eventually_friedrichsRadius_lt {delta : ℝ} (hdelta : 0 < delta) :
    ∀ᶠ j : ℕ in Filter.atTop, friedrichsRadius j < delta :=
  (tendsto_order.1 friedrichsRadius_tendsto_zero).2 delta hdelta

theorem cthickening_friedrichsRadius_subset_chart
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) {j : ℕ}
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius) :
    cthickening (friedrichsRadius j) K ⊆ U :=
  (cthickening_mono hj.le K).trans
    (compactChartBuffer_cthickening_subset hK hU hKU)

/-- One common tail of stages keeps the base and the two signed commutator
coordinates inside the same reduced chart. -/
theorem eventually_three_friedrichs_supports_subset_chart
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    ∀ᶠ j : ℕ in Filter.atTop,
      Function.support (friedrichsMollifiedRepresentative j u) ⊆ U ∧
      Function.support
          (friedrichsAffineCommutatorKernel Complex.I j
            ⋆[lsmul ℂ ℂ, volume] (u : ℂ → ℂ)) ⊆ U ∧
      Function.support
          (friedrichsAffineCommutatorKernel (-Complex.I) j
            ⋆[lsmul ℂ ℂ, volume] (u : ℂ → ℂ)) ⊆ U := by
  filter_upwards [eventually_friedrichsRadius_lt
    (compactChartBuffer_radius_pos hK hU hKU)] with j hj
  have hThick :=
    cthickening_friedrichsRadius_subset_chart hK hU hKU hj
  exact ⟨
    (support_friedrichsMollifiedRepresentative_subset_cthickening
      hK j u hu).trans hThick,
    (support_affineCommutatorConvolution_subset_cthickening
      hK Complex.I j u hu).trans hThick,
    (support_affineCommutatorConvolution_subset_cthickening
      hK (-Complex.I) j u hu).trans hThick⟩

theorem hasCompactSupport_coe_of_support_subset
    {K : Set ℂ} (hK : IsCompact K) (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    HasCompactSupport (u : ℂ → ℂ) :=
  hK.of_isClosed_subset isClosed_closure
    (closure_minimal hu hK.isClosed)

/-- The actual smooth pointwise convolution bundled as a full-plane compact
test.  Its compactness comes from the displayed compact `K`. -/
noncomputable def bufferedFriedrichsFullPlaneTest
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    FullPlaneTest :=
  friedrichsMollifiedFullPlaneTest j u
    (hasCompactSupport_coe_of_support_subset hK u hu)

@[simp]
theorem bufferedFriedrichsFullPlaneTest_apply
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) (w : ℂ) :
    bufferedFriedrichsFullPlaneTest hK j u hu w =
      friedrichsMollifiedRepresentative j u w :=
  rfl

theorem tsupport_bufferedFriedrichsFullPlaneTest_subset_cthickening
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    tsupport (bufferedFriedrichsFullPlaneTest hK j u hu : ℂ → ℂ) ⊆
      cthickening (friedrichsRadius j) K := by
  apply closure_minimal
  · simpa only [bufferedFriedrichsFullPlaneTest_apply] using
      support_friedrichsMollifiedRepresentative_subset_cthickening
        hK j u hu
  · exact isClosed_cthickening

/-- Re-bundling from the full-plane test space into the exact upper-plane
ambient core used by the arithmetic periodization. -/
noncomputable def fullPlaneTestToAmbientTestCore
    (v : FullPlaneTest)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      HalfWeightCompactCoordinateGreen.upperPlaneOpen) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore where
  toFun := v
  contDiff' := v.contDiff
  hasCompactSupport' := v.hasCompactSupport
  tsupport_subset' := hv

@[simp]
theorem fullPlaneTestToAmbientTestCore_apply
    (v : FullPlaneTest)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      HalfWeightCompactCoordinateGreen.upperPlaneOpen) (w : ℂ) :
    fullPlaneTestToAmbientTestCore v hv w = v w :=
  rfl

/-- A buffered mollification is a genuine ambient compact test supported in
the selected reduced chart. -/
noncomputable def bufferedFriedrichsAmbientTest
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  fullPlaneTestToAmbientTestCore
    (bufferedFriedrichsFullPlaneTest hK j u hu)
    ((tsupport_bufferedFriedrichsFullPlaneTest_subset_cthickening
      hK j u hu).trans
        ((cthickening_friedrichsRadius_subset_chart
          hK hU hKU hj).trans hUupper))

@[simp]
theorem bufferedFriedrichsAmbientTest_apply
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) (w : ℂ) :
    bufferedFriedrichsAmbientTest hK hU hKU hUupper j hj u hu w =
      friedrichsMollifiedRepresentative j u w :=
  rfl

theorem tsupport_bufferedFriedrichsAmbientTest_subset_chart
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2)
    (hu : Function.support (u : ℂ → ℂ) ⊆ K) :
    tsupport
        (bufferedFriedrichsAmbientTest hK hU hKU hUupper j hj u hu :
          ℂ → ℂ) ⊆ U :=
  (tsupport_bufferedFriedrichsFullPlaneTest_subset_cthickening
    hK j u hu).trans
      (cthickening_friedrichsRadius_subset_chart hK hU hKU hj)

end
end FixedPhaseReducedChartFriedrichs

