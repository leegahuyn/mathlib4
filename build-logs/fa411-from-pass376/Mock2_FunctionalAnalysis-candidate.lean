/-!
### P3.17: the affine Maass commutator and strong `L2` translation

After reduced-chart localization, the Euclidean-gauge Maass coefficients are
not general variable coefficients.  Both forward operators have the form

`P f(w) = w.im * D f(w) + c * f(w)`

with a constant first-order operator `D`.  Translation therefore has one
exact commutator, namely `t.im * D f(w-t)`.  This is the algebraic reason the
Friedrichs error is a zero-mean approximate-identity kernel.  The other
analytic ingredient, strong continuity of translations in planar `L2`, is a
Mathlib theorem and is recorded here in the precise form needed below.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseAffineFriedrichs

open Set Function Topology Filter MeasureTheory
open scoped Convolution
open FixedPhaseEssentialCoreRoute

/-- Ordinary planar scalar `L2`. -/
noncomputable abbrev AmbientPlaneL2 :=
  MeasureTheory.Lp ℂ 2 (volume : Measure ℂ)

/-- Strong continuity of domain translation at the identity in planar `L2`.
The representative of `DomAddAct.mk t +v f` is `w |-> f (t+w)`. -/
theorem ambientPlaneL2_translation_tendsto
    (f : AmbientPlaneL2) :
    Filter.Tendsto (fun t : ℂ ↦ DomAddAct.mk t +ᵥ f)
      (nhds 0) (nhds f) := by
  have h : Continuous (fun t : ℂ ↦ DomAddAct.mk t +ᵥ f) := by
    fun_prop
  simpa using h.continuousAt

/-- Equivalent norm form of strong `L2` translation continuity. -/
theorem ambientPlaneL2_norm_translation_sub_tendsto_zero
    (f : AmbientPlaneL2) :
    Filter.Tendsto (fun t : ℂ ↦ ‖DomAddAct.mk t +ᵥ f - f‖)
      (nhds 0) (nhds 0) := by
  have h : Continuous
      (fun t : ℂ ↦ ‖DomAddAct.mk t +ᵥ f - f‖) := by
    fun_prop
  simpa using h.continuousAt

/-! #### Constant principal symbols and their affine height coefficient -/

/-- Constant complex first-order symbol
`sigma * partial_x + partial_y` on the ambient real plane. -/
noncomputable def ambientConstantMaassDerivative
    (sigma : ℂ) (f : ℂ → ℂ) (w : ℂ) : ℂ :=
  sigma * fderiv ℝ f w 1 + fderiv ℝ f w Complex.I

/-- Affine-height Maass expression with an arbitrary constant zeroth-order
coefficient. -/
noncomputable def ambientAffineMaass
    (sigma c : ℂ) (f : ℂ → ℂ) (w : ℂ) : ℂ :=
  (w.im : ℂ) * ambientConstantMaassDerivative sigma f w + c * f w

/-- Translation convention matching convolution: `translate t f w=f(w-t)`. -/
def ambientTranslate (t : ℂ) (f : ℂ → ℂ) (w : ℂ) : ℂ :=
  f (w - t)

/-- A constant principal symbol commutes exactly with convolution-style
translation.  The identity is unconditional because Mathlib's `fderiv` shift
formula also covers points at which the derivative defaults to zero. -/
theorem ambientConstantMaassDerivative_translate
    (sigma t : ℂ) (f : ℂ → ℂ) (w : ℂ) :
    ambientConstantMaassDerivative sigma (ambientTranslate t f) w =
      ambientConstantMaassDerivative sigma f (w - t) := by
  simp only [ambientConstantMaassDerivative, ambientTranslate,
    fderiv_comp_sub]

/-- Exact affine-coefficient translation commutator.  There is no remainder
involving a modulus of continuity of the coefficient: affine height produces
the literal scalar `t.im`. -/
theorem ambientAffineMaass_translate_commutator
    (sigma c t : ℂ) (f : ℂ → ℂ) (w : ℂ) :
    ambientAffineMaass sigma c (ambientTranslate t f) w -
        ambientTranslate t (ambientAffineMaass sigma c f) w =
      (t.im : ℂ) *
        ambientConstantMaassDerivative sigma f (w - t) := by
  rw [ambientAffineMaass, ambientTranslate,
    ambientConstantMaassDerivative_translate]
  simp only [ambientAffineMaass, Complex.sub_im]
  push_cast
  ring

/-- Raising is the affine symbol with `sigma=I` and coefficient `p+2`. -/
theorem euclideanRaiseForwardTest_eq_ambientAffineMaass
    (n : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (w : ℂ) :
    euclideanRaiseForwardTest n v w =
      ambientAffineMaass Complex.I
        ((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ)
        (v : ℂ → ℂ) w := by
  simp only [euclideanRaiseForwardTest, ambientAffineMaass,
    ambientConstantMaassDerivative,
    add_apply, smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightCompactCoordinateGreen.dx_apply,
    HalfWeightCompactCoordinateGreen.dy_apply, smul_eq_mul]
  ring

/-- Lowering from the successor is the same affine model with
`sigma=-I` and coefficient `-(p+1)`. -/
theorem euclideanLowerFromSuccForwardTest_eq_ambientAffineMaass
    (n : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (w : ℂ) :
    euclideanLowerFromSuccForwardTest n v w =
      ambientAffineMaass (-Complex.I)
        (-((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ))
        (v : ℂ → ℂ) w := by
  simp only [euclideanLowerFromSuccForwardTest, ambientAffineMaass,
    ambientConstantMaassDerivative,
    add_apply, sub_apply,
    smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightCompactCoordinateGreen.dx_apply,
    HalfWeightCompactCoordinateGreen.dy_apply, smul_eq_mul]
  ring

/-- Specialized exact commutator for the raising forward expression. -/
theorem ambientRaiseAffine_translate_commutator
    (n : ℤ) (t : ℂ) (f : ℂ → ℂ) (w : ℂ) :
    ambientAffineMaass Complex.I
          ((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ)
          (ambientTranslate t f) w -
        ambientTranslate t
          (ambientAffineMaass Complex.I
            ((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ) f) w =
      (t.im : ℂ) *
        ambientConstantMaassDerivative Complex.I f (w - t) :=
  ambientAffineMaass_translate_commutator _ _ _ _ _

/-- Specialized lowering commutator. -/
theorem ambientLowerAffine_translate_commutator
    (n : ℤ) (t : ℂ) (f : ℂ → ℂ) (w : ℂ) :
    ambientAffineMaass (-Complex.I)
          (-((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ))
          (ambientTranslate t f) w -
        ambientTranslate t
          (ambientAffineMaass (-Complex.I)
            (-((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ)) f) w =
      (t.im : ℂ) *
        ambientConstantMaassDerivative (-Complex.I) f (w - t) :=
  ambientAffineMaass_translate_commutator _ _ _ _ _

end FixedPhaseAffineFriedrichs

