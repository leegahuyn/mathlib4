#print axioms FixedPhaseIntrinsicJointLocalization.intrinsicJointCutoffTriple_tendsto
#print axioms FixedPhaseIntrinsicJointLocalization.hasSequentialIntrinsicJointLocalizationAt_unconditional
#print axioms FixedPhaseIntrinsicJointLocalization.intrinsicJointCutoffTriple_eventually_three_dist_lt

end AxiomAuditP4IntrinsicJointLocalization
