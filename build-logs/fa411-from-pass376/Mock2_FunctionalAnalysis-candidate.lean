/-!
This fragment is intended after P3.26 and the Bochner/pointwise bridge.

An `Lp` coercion selects an arbitrary representative, so a theorem requiring
literal pointwise support of that coercion cannot be applied to an arbitrary
localized Hilbert vector.  The correct input is essential support.  We replace
the representative by its literal compact indicator, prove that this does not
change any convolution, and then perform the closed-thickening support proof
on that representative.  This removes a genuine quotient-representative gap
from the Friedrichs route.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs
open FixedPhaseNormalizedFriedrichs
open FixedPhasePlanarLocalization

noncomputable section

/-- Representative-independent compact support for a planar `L2` class. -/
def HasEssentialSupportIn (u : AmbientPlaneL2) (K : Set ℂ) : Prop :=
  ∀ᵐ x ∂(volume : Measure ℂ), x ∉ K → u x = 0

/-- Literal zero extension of the chosen representative outside `K`. -/
def compactIndicatorRepresentative
    (K : Set ℂ) (u : AmbientPlaneL2) : ℂ → ℂ :=
  K.indicator (u : ℂ → ℂ)

theorem compactIndicatorRepresentative_support_subset
    (K : Set ℂ) (u : AmbientPlaneL2) :
    Function.support (compactIndicatorRepresentative K u) ⊆ K := by
  intro x hx
  by_contra hxK
  exact hx (Set.indicator_of_notMem hxK _)

theorem compactIndicatorRepresentative_hasCompactSupport
    {K : Set ℂ} (hK : IsCompact K) (u : AmbientPlaneL2) :
    HasCompactSupport (compactIndicatorRepresentative K u) :=
  hK.of_isClosed_subset isClosed_closure
    (closure_minimal
      (compactIndicatorRepresentative_support_subset K u)
      hK.isClosed)

/-- Essential support is exactly what is needed to replace the arbitrary
`Lp` representative by the literal compact indicator. -/
theorem compactIndicatorRepresentative_ae_eq
    {K : Set ℂ} {u : AmbientPlaneL2}
    (hu : HasEssentialSupportIn u K) :
    compactIndicatorRepresentative K u =ᵐ[(volume : Measure ℂ)]
      (u : ℂ → ℂ) := by
  filter_upwards [hu] with x hx
  by_cases hxK : x ∈ K
  · simp [compactIndicatorRepresentative, hxK]
  · simp [compactIndicatorRepresentative, hxK, hx hxK]

theorem compactIndicatorRepresentative_locallyIntegrable
    {K : Set ℂ} {u : AmbientPlaneL2}
    (hu : HasEssentialSupportIn u K) :
    LocallyIntegrable (compactIndicatorRepresentative K u)
      (volume : Measure ℂ) :=
  ((MeasureTheory.Lp.memLp u).locallyIntegrable (by norm_num)).congr
    (compactIndicatorRepresentative_ae_eq hu).symm

/-- Multiplication by a compact test has essential support in its topological
support, independently of the representative selected by `Lp`. -/
theorem fullPlaneTestMulL2_hasEssentialSupport
    (phi : FullPlaneTest) (u : AmbientPlaneL2) :
    HasEssentialSupportIn
      (FixedPhasePlanarLocalization.fullPlaneTestMulL2 phi u)
      (tsupport (phi : ℂ → ℂ)) := by
  filter_upwards [
    FixedPhasePlanarLocalization.coeFn_fullPlaneTestMulL2 phi u]
      with x hx
  intro hxSupport
  rw [hx, image_eq_zero_of_notMem_tsupport hxSupport, zero_mul]

/-- The localized weak target has the same essential compact support as its
localized source; the derivative correction does not enlarge support. -/
theorem localizedAffineTarget_hasEssentialSupport
    (sigma : ℂ) (phi : FullPlaneTest)
    (u Pu : AmbientPlaneL2) :
    HasEssentialSupportIn
      (FixedPhasePlanarLocalization.localizedAffineTarget
        sigma phi u Pu)
      (tsupport (phi : ℂ → ℂ)) := by
  filter_upwards [
    FixedPhasePlanarLocalization.coeFn_localizedAffineTarget
      sigma phi u Pu] with x hx
  intro hxSupport
  have hphi : phi x = 0 :=
    image_eq_zero_of_notMem_tsupport hxSupport
  have hprincipalSupport : x ∉ tsupport
      (FixedPhasePlanarLocalization.fullPlaneAffinePrincipalCutoff
        sigma phi : ℂ → ℂ) := by
    intro hxPrincipal
    exact hxSupport
      (FixedPhasePlanarLocalization.tsupport_fullPlaneAffinePrincipalCutoff_subset
          sigma phi hxPrincipal)
  have hprincipal :
      FixedPhasePlanarLocalization.fullPlaneAffinePrincipalCutoff
        sigma phi x = 0 :=
    image_eq_zero_of_notMem_tsupport hprincipalSupport
  simp [hx, hphi, hprincipal]

/-! ### Convolution does not depend on the selected `Lp` representative -/

theorem friedrichsMollifier_convolution_compactIndicator_eq
    {K : Set ℂ} {u : AmbientPlaneL2}
    (hu : HasEssentialSupportIn u K) (j : ℕ) :
    (friedrichsMollifierReal j ⋆[lsmul ℝ ℂ, volume]
        compactIndicatorRepresentative K u) =
      friedrichsMollifiedRepresentative j u := by
  unfold friedrichsMollifiedRepresentative
  exact convolution_congr (lsmul ℝ ℂ)
    (Filter.Eventually.of_forall fun _ => rfl)
    (compactIndicatorRepresentative_ae_eq hu)

theorem affineCommutator_convolution_compactIndicator_eq
    {K : Set ℂ} {u : AmbientPlaneL2}
    (hu : HasEssentialSupportIn u K) (sigma : ℂ) (j : ℕ) :
    (friedrichsAffineCommutatorKernel sigma j ⋆[lsmul ℂ ℂ, volume]
        compactIndicatorRepresentative K u) =
      (friedrichsAffineCommutatorKernel sigma j ⋆[lsmul ℂ ℂ, volume]
        (u : ℂ → ℂ)) := by
  exact convolution_congr (lsmul ℂ ℂ)
    (Filter.Eventually.of_forall fun _ => rfl)
    (compactIndicatorRepresentative_ae_eq hu)

/-! ### Smooth compact representatives from essential support -/

/-- Pointwise Friedrichs convolution using the literal compact
representative. -/
noncomputable def essentialFriedrichsRepresentative
    (K : Set ℂ) (j : ℕ) (u : AmbientPlaneL2) : ℂ → ℂ :=
  friedrichsMollifierReal j ⋆[lsmul ℝ ℂ, volume]
    compactIndicatorRepresentative K u

theorem essentialFriedrichsRepresentative_contDiff
    {K : Set ℂ} (j : ℕ) (u : AmbientPlaneL2)
    (hu : HasEssentialSupportIn u K) :
    ContDiff ℝ ∞ (essentialFriedrichsRepresentative K j u) := by
  exact (friedrichsMollifierReal_hasCompactSupport j).contDiff_convolution_left (lsmul ℝ ℂ)
      (friedrichsMollifierReal_contDiff j)
      (compactIndicatorRepresentative_locallyIntegrable hu)

theorem support_essentialFriedrichsRepresentative_subset_cthickening
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ) (u : AmbientPlaneL2) :
    Function.support (essentialFriedrichsRepresentative K j u) ⊆
      cthickening (friedrichsRadius j) K := by
  refine (support_convolution_subset_swap (lsmul ℝ ℂ)).trans ?_
  calc
    Function.support (compactIndicatorRepresentative K u) +
          Function.support (friedrichsMollifierReal j) ⊆
        K + closedBall (0 : ℂ) (friedrichsRadius j) :=
      add_subset_add
        (compactIndicatorRepresentative_support_subset K u)
        (support_friedrichsMollifierReal_subset_closedBall j)
    _ = cthickening (friedrichsRadius j) K :=
      hK.add_closedBall_zero (friedrichsRadius_pos j).le

theorem essentialFriedrichsRepresentative_hasCompactSupport
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2) :
    HasCompactSupport (essentialFriedrichsRepresentative K j u) := by
  exact (friedrichsMollifierReal_hasCompactSupport j).convolution
    (compactIndicatorRepresentative_hasCompactSupport hK u)

/-- The essential-support version of the buffered full-plane test. -/
noncomputable def bufferedEssentialFriedrichsFullPlaneTest
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) :
    FullPlaneTest where
  toFun := essentialFriedrichsRepresentative K j u
  contDiff' := essentialFriedrichsRepresentative_contDiff j u hu
  hasCompactSupport' :=
    essentialFriedrichsRepresentative_hasCompactSupport hK j u
  tsupport_subset' := subset_univ

@[simp]
theorem bufferedEssentialFriedrichsFullPlaneTest_apply
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) (w : ℂ) :
    bufferedEssentialFriedrichsFullPlaneTest hK j u hu w =
      friedrichsMollifiedRepresentative j u w := by
  change essentialFriedrichsRepresentative K j u w = _
  exact congrFun
    (friedrichsMollifier_convolution_compactIndicator_eq hu j) w

theorem tsupport_bufferedEssentialFriedrichsFullPlaneTest_subset
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) :
    tsupport
        (bufferedEssentialFriedrichsFullPlaneTest hK j u hu : ℂ → ℂ) ⊆
      cthickening (friedrichsRadius j) K := by
  apply closure_minimal
  · exact support_essentialFriedrichsRepresentative_subset_cthickening
      hK j u
  · exact isClosed_cthickening

/-- Re-bundling into the exact ambient upper-half-plane test core, now from
the representative-independent essential-support hypothesis. -/
noncomputable def bufferedEssentialFriedrichsAmbientTest
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  fullPlaneTestToAmbientTestCore
    (bufferedEssentialFriedrichsFullPlaneTest hK j u hu)
    ((tsupport_bufferedEssentialFriedrichsFullPlaneTest_subset
      hK j u hu).trans
        ((cthickening_friedrichsRadius_subset_chart
          hK hU hKU hj).trans hUupper))

@[simp]
theorem bufferedEssentialFriedrichsAmbientTest_apply
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) (w : ℂ) :
    bufferedEssentialFriedrichsAmbientTest
        hK hU hKU hUupper j hj u hu w =
      friedrichsMollifiedRepresentative j u w := by
  exact bufferedEssentialFriedrichsFullPlaneTest_apply hK j u hu w

theorem tsupport_bufferedEssentialFriedrichsAmbientTest_subset_chart
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U)
    (hUupper : U ⊆ HalfWeightCompactCoordinateGreen.upperPlaneOpen)
    (j : ℕ)
    (hj : friedrichsRadius j <
      (compactChartBuffer hK hU hKU).radius)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) :
    tsupport
        (bufferedEssentialFriedrichsAmbientTest
          hK hU hKU hUupper j hj u hu : ℂ → ℂ) ⊆ U :=
  (tsupport_bufferedEssentialFriedrichsFullPlaneTest_subset
    hK j u hu).trans
      (cthickening_friedrichsRadius_subset_chart hK hU hKU hj)

end
