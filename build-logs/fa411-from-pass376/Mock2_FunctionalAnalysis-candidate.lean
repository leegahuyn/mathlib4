/-!
================================================================================
P3.7 follow-up: exact adjoints of the bounded cusp-cutoff commutators

The fixed-stage commutators constructed above are not unrelated bounded
operators.  The unconditional global Green identity and self-adjointness of
the real cutoff show that raising and lowering commutators are exact Hilbert
adjoints.  Consequently the adjoint commutator occurring in a maximal graph
localization vanishes exactly on every fixed smooth compact core from a finite
stage onward.

This result is intentionally kept separate from a uniform-in-stage operator
bound.  Dense-core eventual vanishing by itself does not imply strong
convergence on the whole completion; a genuine good-cusp-cutoff estimate is
still needed for that final passage.
================================================================================
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseGoodCuspCutoffBridge

open Set Function Topology Filter MeasureTheory
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseDensity
open FixedPhaseClosedOperators
open FixedPhaseAdjointCutoffCore

/-- On a literal core vector the completed raising commutator is the exact
difference between raising after cutoff and cutoff after raising. -/
theorem raisePeterssonCuspCommutator_l2Coordinate_eq_sub
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    raisePeterssonCuspCommutator N n (l2Coordinate n u) =
      raisedCoordinate n (cuspCutoffOperator N n u) -
        peterssonCuspCutoff N (n + 1) (raisedCoordinate n u) := by
  rw [raisedCoordinate_cuspCutoffOperator]
  abel

/-- The corresponding exact difference formula for lowering from the
successor orbit. -/
theorem lowerFromSuccPeterssonCuspCommutator_l2Coordinate_eq_sub
    (N : ℕ) (n : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    lowerFromSuccPeterssonCuspCommutator N n
        (l2Coordinate (n + 1) v) =
      lowerFromSuccCoordinate n (cuspCutoffOperator N (n + 1) v) -
        peterssonCuspCutoff N n (lowerFromSuccCoordinate n v) := by
  rw [lowerFromSuccCoordinate_cuspCutoffOperator]
  abel

/-- Exact core pairing of the two bounded commutators.  Both Green identities
used here are the already proved unconditional global identities; no boundary
or Stokes premise is reintroduced. -/
theorem inner_raisePeterssonCuspCommutator_eq_lowerFromSucc
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    inner ℂ
        (raisePeterssonCuspCommutator N n (l2Coordinate n u))
        (l2Coordinate (n + 1) v) =
      inner ℂ (l2Coordinate n u)
        (lowerFromSuccPeterssonCuspCommutator N n
          (l2Coordinate (n + 1) v)) := by
  have hGreenLeft :
      inner ℂ
          (raisedCoordinate n (cuspCutoffOperator N n u))
          (l2Coordinate (n + 1) v) =
        -inner ℂ
          (peterssonCuspCutoff N n (l2Coordinate n u))
          (lowerFromSuccCoordinate n v) := by
    simpa only [peterssonCuspCutoff_l2Coordinate] using
      (physicalRaisingGreenIdentityOnCore_unconditional
        (cuspCutoffOperator N n u) v)
  have hGreenRight :
      inner ℂ (raisedCoordinate n u)
          (peterssonCuspCutoff N (n + 1)
            (l2Coordinate (n + 1) v)) =
        -inner ℂ (l2Coordinate n u)
          (lowerFromSuccCoordinate n
            (cuspCutoffOperator N (n + 1) v)) := by
    simpa only [peterssonCuspCutoff_l2Coordinate] using
      (physicalRaisingGreenIdentityOnCore_unconditional
        u (cuspCutoffOperator N (n + 1) v))
  have hSymBase :
      inner ℂ
          (peterssonCuspCutoff N n (l2Coordinate n u))
          (lowerFromSuccCoordinate n v) =
        inner ℂ (l2Coordinate n u)
          (peterssonCuspCutoff N n
            (lowerFromSuccCoordinate n v)) := by
    rw [← ContinuousLinearMap.adjoint_inner_right,
      adjoint_peterssonCuspCutoff]
  have hSymRaised :
      inner ℂ
          (peterssonCuspCutoff N (n + 1) (raisedCoordinate n u))
          (l2Coordinate (n + 1) v) =
        inner ℂ (raisedCoordinate n u)
          (peterssonCuspCutoff N (n + 1)
            (l2Coordinate (n + 1) v)) := by
    rw [← ContinuousLinearMap.adjoint_inner_right,
      adjoint_peterssonCuspCutoff]
  rw [raisePeterssonCuspCommutator_l2Coordinate_eq_sub,
    lowerFromSuccPeterssonCuspCommutator_l2Coordinate_eq_sub,
    inner_sub_left, inner_sub_right, hGreenLeft, hSymBase,
    hSymRaised, hGreenRight]
  ring

/-- The raising commutator is the Hilbert adjoint of the lowering commutator.
The core pairing is extended in each variable using the actual dense
Petersson coordinate ranges. -/
theorem raisePeterssonCuspCommutator_eq_adjoint_lowerFromSucc
    (N : ℕ) (n : ℤ) :
    raisePeterssonCuspCommutator N n =
      ContinuousLinearMap.adjoint
        (lowerFromSuccPeterssonCuspCommutator N n) := by
  apply (ContinuousLinearMap.eq_adjoint_iff
    (raisePeterssonCuspCommutator N n)
    (lowerFromSuccPeterssonCuspCommutator N n)).2
  intro x y
  refine (denseRange_l2Coordinate n).induction_on x
    (isClosed_eq
      ((raisePeterssonCuspCommutator N n).continuous.inner
        continuous_const)
      (continuous_id.inner continuous_const)) ?_
  intro u
  refine (denseRange_l2Coordinate (n + 1)).induction_on y
    (isClosed_eq
      (continuous_const.inner continuous_id)
      (continuous_const.inner
        (lowerFromSuccPeterssonCuspCommutator N n).continuous)) ?_
  intro v
  exact inner_raisePeterssonCuspCommutator_eq_lowerFromSucc N n u v

/-- Adjoint orientation needed by a signed-raising maximal graph. -/
theorem adjoint_raisePeterssonCuspCommutator
    (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint (raisePeterssonCuspCommutator N n) =
      lowerFromSuccPeterssonCuspCommutator N n := by
  have h := congrArg ContinuousLinearMap.adjoint
    (raisePeterssonCuspCommutator_eq_adjoint_lowerFromSucc N n)
  simpa only [ContinuousLinearMap.adjoint_adjoint] using h

/-- Adjoint orientation needed by a signed-lowering maximal graph. -/
theorem adjoint_lowerFromSuccPeterssonCuspCommutator
    (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint
        (lowerFromSuccPeterssonCuspCommutator N n) =
      raisePeterssonCuspCommutator N n :=
  (raisePeterssonCuspCommutator_eq_adjoint_lowerFromSucc N n).symm

/-- The two fixed-stage commutator bounds are exactly equal.  Thus a genuine
uniform good-cutoff estimate on either orientation automatically supplies the
same estimate on the other; no factor depending on the half-weight index is
lost in passing to the adjoint. -/
theorem norm_raisePeterssonCuspCommutator_eq_lowerFromSucc
    (N : ℕ) (n : ℤ) :
    ‖raisePeterssonCuspCommutator N n‖ =
      ‖lowerFromSuccPeterssonCuspCommutator N n‖ := by
  rw [raisePeterssonCuspCommutator_eq_adjoint_lowerFromSucc]
  exact ContinuousLinearMap.adjoint.norm_map _

/-- On every fixed target smooth core, the adjoint of the raising commutator
is exactly zero from a finite stage onward. -/
theorem adjoint_raisePeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
    (n : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    (fun N ↦ ContinuousLinearMap.adjoint
      (raisePeterssonCuspCommutator N n) (l2Coordinate (n + 1) v))
        =ᶠ[Filter.atTop] (fun _ ↦ 0) := by
  filter_upwards [
    lowerFromSuccPeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
      n v] with N hN
  rw [adjoint_raisePeterssonCuspCommutator, hN]

/-- On every fixed base smooth core, the adjoint of the lowering commutator
is exactly zero from a finite stage onward. -/
theorem adjoint_lowerFromSuccPeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (fun N ↦ ContinuousLinearMap.adjoint
      (lowerFromSuccPeterssonCuspCommutator N n) (l2Coordinate n u))
        =ᶠ[Filter.atTop] (fun _ ↦ 0) := by
  filter_upwards [
    raisePeterssonCuspCommutator_eventuallyEq_zero_on_l2Coordinate
      n u] with N hN
  rw [adjoint_lowerFromSuccPeterssonCuspCommutator, hN]

end FixedPhaseGoodCuspCutoffBridge

