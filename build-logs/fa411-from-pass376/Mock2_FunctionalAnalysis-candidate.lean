/-!
### P3.4a: finite measured decomposition of the selected six-tile carrier

The curvilinear Green theorem is applied tile by tile.  The lemmas below
remove a separate measure-theoretic ambiguity in that reduction: distinct
selected right-coset images of the *open* modular tile are genuinely
disjoint, and the chosen closed/half-open carrier integral is therefore the
finite sum of the six open-tile integrals.  No boundary integral or Stokes
claim is used here.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

open MeasureTheory Set

/-- Distinct selected right-coset images of the open modular tile are
disjoint.  The only full-modular elements carrying one interior point of the
standard tile to another are the central elements `±1`, and both belong to
`Gamma(2)`; hence they cannot connect two distinct right cosets. -/
theorem gammaTwoOpenTiles_pairwiseDisjoint :
    Pairwise (fun q₁ q₂ : GammaTwoRightCoset =>
      Disjoint (gammaTwoCosetRep q₁ • ModularGroup.fdo)
        (gammaTwoCosetRep q₂ • ModularGroup.fdo)) := by
  intro q₁ q₂ hq
  rw [Set.disjoint_left]
  intro z hz₁ hz₂
  rcases Set.mem_smul_set.mp hz₁ with ⟨w₁, hw₁, h₁⟩
  rcases Set.mem_smul_set.mp hz₂ with ⟨w₂, hw₂, h₂⟩
  have hmove :
      ((gammaTwoCosetRep q₂)⁻¹ * (1 : SL(2, ℤ)) *
          gammaTwoCosetRep q₁) • w₁ = w₂ := by
    calc
      ((gammaTwoCosetRep q₂)⁻¹ * (1 : SL(2, ℤ)) *
          gammaTwoCosetRep q₁) • w₁ =
          (gammaTwoCosetRep q₂)⁻¹ •
            (gammaTwoCosetRep q₁ • w₁) := by
              simp only [one_mul, mul_smul, one_smul]
      _ = (gammaTwoCosetRep q₂)⁻¹ •
            (gammaTwoCosetRep q₂ • w₂) := by rw [h₁, ← h₂]
      _ = w₂ := inv_smul_smul _ _
  have hcentral :
      (gammaTwoCosetRep q₂)⁻¹ * (1 : SL(2, ℤ)) *
            gammaTwoCosetRep q₁ = 1 ∨
        (gammaTwoCosetRep q₂)⁻¹ * (1 : SL(2, ℤ)) *
            gammaTwoCosetRep q₁ = -1 :=
    ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo hw₁
      (hmove.symm ▸ hw₂)
  have heq : q₁ = q₂ :=
    gammaTwoRightCoset_eq_of_bridge (1 : GammaTwo) q₁ q₂ hcentral
  exact hq heq

/-- Every selected open modular tile is measurable. -/
theorem gammaTwoOpenTile_measurable (q : GammaTwoRightCoset) :
    MeasurableSet (gammaTwoCosetRep q • ModularGroup.fdo) := by
  change MeasurableSet
    (((gammaTwoCosetRep q : SL(2, ℤ)) : GL (Fin 2) ℝ) •
      ModularGroup.fdo)
  exact
    (ModularGroup.isOpen_fdo.smul
      (((gammaTwoCosetRep q : SL(2, ℤ)) : GL (Fin 2) ℝ))).measurableSet

/-- An integrable function on the selected open carrier integrates as the
finite sum of its integrals over the selected open modular tiles. -/
theorem integral_gammaTwoOpenCarrier_eq_sum_openTiles
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℍ → E)
    (hf : IntegrableOn f gammaTwoOpenCarrier hyperbolicMeasure) :
    (∫ z in gammaTwoOpenCarrier, f z ∂hyperbolicMeasure) =
      ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
          f z ∂hyperbolicMeasure := by
  unfold gammaTwoOpenCarrier at hf ⊢
  exact integral_iUnion_fintype
    gammaTwoOpenTile_measurable
    gammaTwoOpenTiles_pairwiseDisjoint
    (fun q => hf.mono_set
      (Set.subset_iUnion
        (fun q : GammaTwoRightCoset =>
          gammaTwoCosetRep q • ModularGroup.fdo) q))

/-- Replacing the open carrier by the verified half-open carrier does not
alter the finite tile decomposition. -/
theorem integral_gammaTwoHalfOpenTileCarrier_eq_sum_openTiles
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℍ → E)
    (hf : IntegrableOn f gammaTwoHalfOpenTileCarrier hyperbolicMeasure) :
    (∫ z in gammaTwoHalfOpenTileCarrier, f z ∂hyperbolicMeasure) =
      ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
          f z ∂hyperbolicMeasure := by
  calc
    (∫ z in gammaTwoHalfOpenTileCarrier,
        f z ∂hyperbolicMeasure) =
        ∫ z in gammaTwoOpenCarrier,
          f z ∂hyperbolicMeasure :=
      setIntegral_congr_set gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier
    _ = ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
          f z ∂hyperbolicMeasure :=
      integral_gammaTwoOpenCarrier_eq_sum_openTiles f
        (hf.congr_set_ae
          gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier.symm)

/-- The actual chosen fundamental-domain integral, with no invariance
assumption on the integrand, is the same finite open-tile sum. -/
theorem integral_chosenCarrier_eq_sum_openTiles
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℍ → E)
    (hf : IntegrableOn f chosenGammaTwoFundamentalDomain.carrier
      hyperbolicMeasure) :
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        f z ∂hyperbolicMeasure) =
      ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
          f z ∂hyperbolicMeasure := by
  calc
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        f z ∂hyperbolicMeasure) =
        ∫ z in gammaTwoHalfOpenTileCarrier,
          f z ∂hyperbolicMeasure :=
      setIntegral_congr_set
        gammaTwoHalfOpenTileCarrier_ae_eq_chosenCarrier.symm
    _ = ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
          f z ∂hyperbolicMeasure :=
      integral_gammaTwoHalfOpenTileCarrier_eq_sum_openTiles f
        (hf.congr_set_ae
          gammaTwoHalfOpenTileCarrier_ae_eq_chosenCarrier)

end Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
### P3.4b: exact cancellation of the hyperbolic density

Before applying a planar Green theorem, the factor `heightC z ^ 2` in the
bulk integrand must be shown to cancel the Radon--Nikodym density `y⁻²` of
hyperbolic area.  The following lemmas perform that conversion at the level
of Bochner set integrals and then transport the resulting comap measure to
ordinary Lebesgue measure on the open upper half-plane in `ℂ`.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoCurvilinearTileStokes

open MeasureTheory Set
open GammaTwoQuotientGeometry SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators

/-- The nonnegative density `y⁻²` used in Mathlib's upper-half-plane
volume, before coercion to `ℝ≥0∞`. -/
noncomputable def hyperbolicDensityNNReal (z : ℍ) : NNReal :=
  (1 / NNReal.mk z.im z.im_pos.le : NNReal) ^ 2

theorem hyperbolicDensityNNReal_continuous :
    Continuous hyperbolicDensityNNReal := by
  unfold hyperbolicDensityNNReal
  refine .pow (.div₀ continuous_const ?_ ?_) _
  · exact UpperHalfPlane.continuous_im.subtype_mk _
  · exact fun z => NNReal.ne_iff.mp z.im_ne_zero

/-- Pointwise cancellation of `y⁻²` against the explicit `y²` factor
in the Euclidean-divergence density. -/
theorem hyperbolicDensityNNReal_smul_heightSq
    (f : ℍ → ℂ) (z : ℍ) :
    hyperbolicDensityNNReal z • (heightC z ^ 2 * f z) = f z := by
  have hcancel : (hyperbolicDensityNNReal z : ℝ) * z.im ^ 2 = 1 := by
    simp only [hyperbolicDensityNNReal, NNReal.coe_pow, NNReal.coe_div,
      NNReal.coe_one, NNReal.coe_mk]
    field_simp [ne_of_gt z.im_pos]
  have hheight : heightC z ^ 2 * f z = (z.im ^ 2 : ℝ) • f z := by
    simp [heightC, Algebra.smul_def]
  rw [hheight, NNReal.smul_def, smul_smul, hcancel, one_smul]

/-- The hyperbolic measure written with the named `ℝ≥0` density. -/
theorem hyperbolicMeasure_eq_withDensityNNReal :
    hyperbolicMeasure =
      (volume.comap UpperHalfPlane.coe).withDensity
        (fun z => (hyperbolicDensityNNReal z : ℝ≥0∞)) := by
  simpa only [hyperbolicDensityNNReal] using hyperbolicMeasure_def

/-- Multiplication by `heightC²` converts a hyperbolic set integral into
the same set integral for the Euclidean comap measure. -/
theorem setIntegral_heightSq_mul_hyperbolic_eq_comap
    (s : Set ℍ) (hs : MeasurableSet s) (f : ℍ → ℂ) :
    (∫ z in s, heightC z ^ 2 * f z ∂hyperbolicMeasure) =
      ∫ z in s, f z ∂(volume.comap UpperHalfPlane.coe) := by
  rw [hyperbolicMeasure_eq_withDensityNNReal]
  rw [setIntegral_withDensity_eq_setIntegral_smul
    hyperbolicDensityNNReal_continuous.measurable _ hs]
  apply setIntegral_congr_fun hs
  intro z _hz
  exact hyperbolicDensityNNReal_smul_heightSq f z

/-- The Euclidean comap integral upstairs is the ordinary planar integral
over the complex image of the set.  The function is extended off the upper
half-plane by `upperLift`; only its values on the image are used. -/
theorem setIntegral_comap_eq_complexImage
    (s : Set ℍ) (f : ℍ → ℂ) :
    (∫ z in s, f z ∂(volume.comap UpperHalfPlane.coe)) =
      ∫ w in UpperHalfPlane.coe '' s,
        upperLift f w ∂(volume : Measure ℂ) := by
  have hmp : MeasurePreserving UpperHalfPlane.coe
      (volume.comap UpperHalfPlane.coe)
      (volume.restrict (Set.range UpperHalfPlane.coe)) := by
    refine ⟨UpperHalfPlane.measurable_coe, ?_⟩
    rw [UpperHalfPlane.measurableEmbedding_coe.map_comap]
  calc
    (∫ z in s, f z ∂(volume.comap UpperHalfPlane.coe)) =
        ∫ z in s, upperLift f (z : ℂ)
          ∂(volume.comap UpperHalfPlane.coe) := by simp
    _ = ∫ w in UpperHalfPlane.coe '' s,
        upperLift f w
          ∂(volume.restrict (Set.range UpperHalfPlane.coe)) :=
      (hmp.setIntegral_image_emb
        UpperHalfPlane.measurableEmbedding_coe (upperLift f) s).symm
    _ = ∫ w in UpperHalfPlane.coe '' s,
        upperLift f w ∂(volume : Measure ℂ) := by
      change (∫ w, upperLift f w
          ∂((volume.restrict (Set.range UpperHalfPlane.coe)).restrict
            (UpperHalfPlane.coe '' s))) =
        ∫ w, upperLift f w
          ∂((volume : Measure ℂ).restrict
            (UpperHalfPlane.coe '' s))
      rw [Measure.restrict_restrict_of_subset
        (Set.image_subset_range UpperHalfPlane.coe s)]

/-- Combined hyperbolic-to-planar conversion used by every curved-tile
Green formula. -/
theorem setIntegral_heightSq_mul_hyperbolic_eq_complexImage
    (s : Set ℍ) (hs : MeasurableSet s) (f : ℍ → ℂ) :
    (∫ z in s, heightC z ^ 2 * f z ∂hyperbolicMeasure) =
      ∫ w in UpperHalfPlane.coe '' s,
        upperLift f w ∂(volume : Measure ℂ) := by
  rw [setIntegral_heightSq_mul_hyperbolic_eq_comap s hs f,
    setIntegral_comap_eq_complexImage s f]

/-! #### The explicit curved-tile rectangle chart -/

/-- Lower circular boundary of the standard modular tile in real
coordinates. -/
noncomputable def modularLowerHeight (x : ℝ) : ℝ :=
  Real.sqrt (1 - x ^ 2)

/-- Derivative of the lower circular graph on the strip `|x| ≤ 1/2`. -/
noncomputable def modularLowerHeightDeriv (x : ℝ) : ℝ :=
  -x / modularLowerHeight x

theorem one_sub_sq_pos_of_mem_modularStrip
    {x : ℝ} (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    0 < 1 - x ^ 2 := by
  have hprod : 0 ≤ (x + 1 / 2) * (1 / 2 - x) :=
    mul_nonneg (by linarith [hx.1]) (by linarith [hx.2])
  nlinarith

theorem modularLowerHeight_pos
    {x : ℝ} (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    0 < modularLowerHeight x := by
  exact Real.sqrt_pos.2 (one_sub_sq_pos_of_mem_modularStrip hx)

theorem modularLowerHeight_le_one
    {x : ℝ} (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    modularLowerHeight x ≤ 1 := by
  rw [modularLowerHeight, Real.sqrt_le_one]
  nlinarith [sq_nonneg x]

set_option backward.isDefEq.respectTransparency false in
theorem modularLowerHeight_hasDerivAt
    {x : ℝ} (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    HasDerivAt modularLowerHeight (modularLowerHeightDeriv x) x := by
  have hpos := one_sub_sq_pos_of_mem_modularStrip hx
  have hinner : HasDerivAt (fun u : ℝ => 1 - u ^ 2) (-2 * x) x := by
    have h := (hasDerivAt_pow 2 x).const_sub (1 : ℝ)
    simpa [pow_two] using h
  have hsqrt := hinner.sqrt (ne_of_gt hpos)
  change HasDerivAt (fun y : ℝ => Real.sqrt (1 - y ^ 2))
    (-x / Real.sqrt (1 - x ^ 2)) x
  convert hsqrt using 1
  field_simp [ne_of_gt (Real.sqrt_pos.2 hpos)] <;> ring

/-- Positive vertical Jacobian of the rectangle-to-curved-tile map. -/
noncomputable def curvedTileJacobian (H x : ℝ) : ℝ :=
  H - modularLowerHeight x

theorem curvedTileJacobian_pos
    {H x : ℝ} (hH : 1 < H)
    (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    0 < curvedTileJacobian H x := by
  unfold curvedTileJacobian
  linarith [modularLowerHeight_le_one hx]

/-- Diffeomorphic chart from a rectangle to the standard modular tile
truncated at height `H`:
`(x,t) ↦ (x, h(x) + t (H-h(x)))`. -/
noncomputable def curvedTileRectangleMap (H : ℝ) (p : ℝ × ℝ) : ℝ × ℝ :=
  (p.1, modularLowerHeight p.1 + p.2 * curvedTileJacobian H p.1)

@[simp]
theorem curvedTileRectangleMap_bottom (H x : ℝ) :
    curvedTileRectangleMap H (x, 0) = (x, modularLowerHeight x) := by
  simp [curvedTileRectangleMap]

@[simp]
theorem curvedTileRectangleMap_top (H x : ℝ) :
    curvedTileRectangleMap H (x, 1) = (x, H) := by
  simp [curvedTileRectangleMap, curvedTileJacobian]

/-- The chart height is a convex combination of the circular floor and the
truncating horocycle. -/
theorem curvedTileRectangleMap_snd
    (H : ℝ) (p : ℝ × ℝ) :
    (curvedTileRectangleMap H p).2 =
      (1 - p.2) * modularLowerHeight p.1 + p.2 * H := by
  simp [curvedTileRectangleMap, curvedTileJacobian]
  ring

/-- Every point of the closed source rectangle is carried to positive
height.  This is the bridge needed to apply upper-half-plane smoothness to
the real-product coordinate lift, including all four boundary faces. -/
theorem curvedTileRectangleMap_snd_pos
    {H : ℝ} (hH : 1 < H) {p : ℝ × ℝ}
    (hp : p ∈ Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1)) :
    0 < (curvedTileRectangleMap H p).2 := by
  have hx : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :=
    ⟨hp.1.1, hp.2.1⟩
  have ht : 0 ≤ p.2 := hp.1.2
  have hj : 0 < curvedTileJacobian H p.1 :=
    curvedTileJacobian_pos hH hx
  change 0 < modularLowerHeight p.1 +
    p.2 * curvedTileJacobian H p.1
  exact add_pos_of_pos_of_nonneg (modularLowerHeight_pos hx)
    (mul_nonneg ht hj.le)

/-- Closed real-coordinate truncation of the standard modular tile. -/
noncomputable def modularCurvedTileTruncation (H : ℝ) : Set (ℝ × ℝ) :=
  (Prod.fst ⁻¹' Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) ∩
    {p | modularLowerHeight p.1 ≤ p.2} ∩
    {p | p.2 ≤ H}

theorem mem_modularCurvedTileTruncation_iff
    {H : ℝ} {p : ℝ × ℝ} :
    p ∈ modularCurvedTileTruncation H ↔
      p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧
      modularLowerHeight p.1 ≤ p.2 ∧ p.2 ≤ H := by
  simp only [modularCurvedTileTruncation, Set.mem_inter_iff,
    Set.mem_preimage, Set.mem_setOf_eq]
  tauto

theorem modularLowerHeight_continuous :
    Continuous modularLowerHeight := by
  unfold modularLowerHeight
  fun_prop

theorem modularCurvedTileTruncation_measurable (H : ℝ) :
    MeasurableSet (modularCurvedTileTruncation H) := by
  unfold modularCurvedTileTruncation
  exact
    ((measurableSet_Icc.preimage measurable_fst).inter
      (isClosed_le
        (modularLowerHeight_continuous.comp continuous_fst)
        continuous_snd).measurableSet).inter
      (isClosed_le continuous_snd continuous_const).measurableSet

/-- `Φ_H` is injective on the closed source rectangle as soon as `H>1`.
The first coordinate determines `x`, and positivity of `H-h(x)` then
determines `t`. -/
theorem curvedTileRectangleMap_injOn
    {H : ℝ} (hH : 1 < H) :
    Set.InjOn (curvedTileRectangleMap H)
      (Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1)) := by
  intro p hp q hq hpq
  have hx : p.1 = q.1 := by
    simpa only [curvedTileRectangleMap] using congrArg Prod.fst hpq
  have hpx : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :=
    ⟨hp.1.1, hp.2.1⟩
  have hj : 0 < curvedTileJacobian H p.1 :=
    curvedTileJacobian_pos hH hpx
  apply Prod.ext
  · exact hx
  · have hsnd := congrArg Prod.snd hpq
    simp only [curvedTileRectangleMap] at hsnd
    rw [← hx] at hsnd
    nlinarith

/-- Exact image formula for the curved rectangle chart. -/
theorem curvedTileRectangleMap_image
    {H : ℝ} (hH : 1 < H) :
    curvedTileRectangleMap H ''
        Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1) =
      modularCurvedTileTruncation H := by
  apply Set.Subset.antisymm
  · rintro p ⟨q, hq, rfl⟩
    have hqx : q.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :=
      ⟨hq.1.1, hq.2.1⟩
    have hqt₀ : 0 ≤ q.2 := hq.1.2
    have hqt₁ : q.2 ≤ 1 := hq.2.2
    have hj : 0 < curvedTileJacobian H q.1 :=
      curvedTileJacobian_pos hH hqx
    rw [mem_modularCurvedTileTruncation_iff]
    refine ⟨hqx, ?_, ?_⟩
    · change modularLowerHeight q.1 ≤
        modularLowerHeight q.1 + q.2 * curvedTileJacobian H q.1
      exact le_add_of_nonneg_right (mul_nonneg hqt₀ hj.le)
    · rw [curvedTileRectangleMap_snd]
      have hnonneg :
          0 ≤ (1 - q.2) * curvedTileJacobian H q.1 :=
        mul_nonneg (sub_nonneg.mpr hqt₁) hj.le
      unfold curvedTileJacobian at hnonneg
      nlinarith
  · intro p hp
    rw [mem_modularCurvedTileTruncation_iff] at hp
    have hj : 0 < curvedTileJacobian H p.1 :=
      curvedTileJacobian_pos hH hp.1
    let t : ℝ :=
      (p.2 - modularLowerHeight p.1) /
        curvedTileJacobian H p.1
    have ht₀ : 0 ≤ t := by
      exact div_nonneg (sub_nonneg.mpr hp.2.1) hj.le
    have ht₁ : t ≤ 1 := by
      rw [div_le_one hj]
      unfold curvedTileJacobian
      linarith [hp.2.2]
    refine ⟨(p.1, t), ⟨⟨hp.1.1, ht₀⟩, ⟨hp.1.2, ht₁⟩⟩, ?_⟩
    apply Prod.ext
    · rfl
    · change modularLowerHeight p.1 +
          t * curvedTileJacobian H p.1 = p.2
      dsimp only [t]
      field_simp [ne_of_gt hj]
      ring

/-- Closed standard modular tile cut off by the horizontal horocycle
`im z = H`. -/
def modularClosedTileTruncation (H : ℝ) : Set ℍ :=
  ModularGroup.fd ∩ {z : ℍ | z.im ≤ H}

theorem modularClosedTileTruncation_measurable (H : ℝ) :
    MeasurableSet (modularClosedTileTruncation H) := by
  exact ModularGroup.isClosed_fd.measurableSet.inter
    (isClosed_le UpperHalfPlane.continuous_im continuous_const).measurableSet

/-- The usual inequalities `|x|≤1/2` and `x²+y²≥1` are equivalent,
in the positive half-plane, to lying above the circular graph `y=h(x)`.
This is the exact set-level bridge between Mathlib's modular domain and the
curved rectangle chart. -/
theorem mem_modularClosedTileTruncation_iff
    {H : ℝ} {z : ℍ} :
    z ∈ modularClosedTileTruncation H ↔
      (z.re, z.im) ∈ modularCurvedTileTruncation H := by
  rw [mem_modularCurvedTileTruncation_iff]
  constructor
  · intro hz
    have hfd := hz.1
    change 1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2 at hfd
    have hx : z.re ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
      exact abs_le.mp hfd.2
    have hsq : 1 - z.re ^ 2 ≤ z.im ^ 2 := by
      have hnorm := hfd.1
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re,
        UpperHalfPlane.coe_im, pow_two] at hnorm
      nlinarith
    refine ⟨hx, ?_, hz.2⟩
    unfold modularLowerHeight
    exact Real.sqrt_le_iff.mpr ⟨z.im_pos.le, hsq⟩
  · rintro ⟨hx, hfloor, htop⟩
    have hinside := one_sub_sq_pos_of_mem_modularStrip hx
    have hsqrtSq : modularLowerHeight z.re ^ 2 = 1 - z.re ^ 2 := by
      exact Real.sq_sqrt hinside.le
    have hsqle : modularLowerHeight z.re ^ 2 ≤ z.im ^ 2 := by
      have hprod :
          0 ≤ (z.im - modularLowerHeight z.re) *
            (z.im + modularLowerHeight z.re) :=
        mul_nonneg (sub_nonneg.mpr hfloor)
          (add_nonneg z.im_pos.le (modularLowerHeight_pos hx).le)
      nlinarith
    refine ⟨?_, htop⟩
    change 1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2
    constructor
    · have hnorm : 1 ≤ z.re ^ 2 + z.im ^ 2 := by
        calc
          1 = z.re ^ 2 + (1 - z.re ^ 2) := by ring
          _ = z.re ^ 2 + modularLowerHeight z.re ^ 2 := by rw [hsqrtSq]
          _ ≤ z.re ^ 2 + z.im ^ 2 := by
            simpa [add_comm] using add_le_add_right hsqle (z.re ^ 2)
      simpa only [Complex.normSq_apply, UpperHalfPlane.coe_re,
        UpperHalfPlane.coe_im, pow_two] using hnorm
    · exact abs_le.mpr hx

/-- After the standard volume-preserving identification `ℂ ≃ ℝ×ℝ`,
the complex image of the truncated modular tile is exactly the curved real
coordinate region. -/
theorem measurableEquivRealProd_image_modularClosedTileTruncation
    (H : ℝ) :
    Complex.measurableEquivRealProd ''
        (UpperHalfPlane.coe '' modularClosedTileTruncation H) =
      modularCurvedTileTruncation H := by
  apply Set.Subset.antisymm
  · rintro p ⟨w, ⟨z, hz, rfl⟩, rfl⟩
    simpa using (mem_modularClosedTileTruncation_iff.mp hz)
  · intro p hp
    have hx : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :=
      (mem_modularCurvedTileTruncation_iff.mp hp).1
    have him : 0 < p.2 :=
      lt_of_lt_of_le (modularLowerHeight_pos hx)
        (mem_modularCurvedTileTruncation_iff.mp hp).2.1
    let z : ℍ := ⟨Complex.mk p.1 p.2, him⟩
    refine ⟨(z : ℂ), ⟨z, ?_, rfl⟩, ?_⟩
    · exact mem_modularClosedTileTruncation_iff.mpr (by simpa [z] using hp)
    · apply Prod.ext <;> simp [z]

/-- The complex-to-real-coordinate image and the curved rectangle image are
literally the same truncated modular tile. -/
theorem curvedTileRectangleMap_image_eq_realProd_modularTile
    {H : ℝ} (hH : 1 < H) :
    curvedTileRectangleMap H ''
        Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1) =
      Complex.measurableEquivRealProd ''
        (UpperHalfPlane.coe '' modularClosedTileTruncation H) := by
  rw [curvedTileRectangleMap_image hH,
    measurableEquivRealProd_image_modularClosedTileTruncation H]

set_option backward.isDefEq.respectTransparency false

section CurvedTileCoherentInstances

/-- The calculus API follows the normed structures, while plain product and
scalar instances are also globally available.  Pin the coherent forgetful
path on this chart section to avoid non-definitional instance diamonds. -/
noncomputable local instance curvedTileRealAddCommGroup : AddCommGroup ℝ :=
  (inferInstance : NormedAddCommGroup ℝ).toAddCommGroup
noncomputable local instance curvedTileRealModule : Module ℝ ℝ :=
  (inferInstance : NormedSpace ℝ ℝ).toModule
noncomputable local instance curvedTileComplexAddCommGroup : AddCommGroup ℂ :=
  (inferInstance : NormedAddCommGroup ℂ).toAddCommGroup
noncomputable local instance curvedTileComplexRealModule : Module ℝ ℂ :=
  (inferInstance : NormedSpace ℝ ℂ).toModule
noncomputable local instance curvedTileProdAddCommGroup : AddCommGroup (ℝ × ℝ) :=
  (inferInstance : NormedAddCommGroup (ℝ × ℝ)).toAddCommGroup
noncomputable local instance curvedTileProdModule : Module ℝ (ℝ × ℝ) :=
  (inferInstance : NormedSpace ℝ (ℝ × ℝ)).toModule

/-- Explicit Fréchet derivative of `Φ_H`.  In the product basis its
matrix is lower triangular with diagonal `(1, H-h(x))`. -/
noncomputable def curvedTileRectangleFDeriv
    (H : ℝ) (p : ℝ × ℝ) : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) :=
  (Matrix.toLin (.finTwoProd ℝ) (.finTwoProd ℝ)
    !![(1 : ℝ), 0;
      (1 - p.2) * modularLowerHeightDeriv p.1,
      curvedTileJacobian H p.1]).toContinuousLinearMap

theorem hasFDerivAt_curvedTileRectangleMap
    {H : ℝ} {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    HasFDerivAt (curvedTileRectangleMap H)
      (curvedTileRectangleFDeriv H p) p := by
  have hfst :
      HasFDerivAt (Prod.fst : ℝ × ℝ → ℝ)
        (ContinuousLinearMap.fst ℝ ℝ ℝ) p :=
    hasFDerivAt_fst
  have hsnd :
      HasFDerivAt (Prod.snd : ℝ × ℝ → ℝ)
        (ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    hasFDerivAt_snd
  have hh := (modularLowerHeight_hasDerivAt hp).comp_hasFDerivAt p hfst
  unfold curvedTileRectangleFDeriv
  rw [Matrix.toLin_finTwoProd_toContinuousLinearMap]
  convert! HasFDerivAt.prodMk (𝕜 := ℝ) hfst
    (hh.add (hsnd.mul ((hasFDerivAt_const H p).sub hh))) using 2 <;>
    try simp [curvedTileRectangleMap, curvedTileJacobian,
      smul_smul, add_comm, mul_comm, mul_left_comm, mul_assoc] <;>
    try ring <;>
    try module

theorem det_curvedTileRectangleFDeriv (H : ℝ) (p : ℝ × ℝ) :
    (curvedTileRectangleFDeriv H p).det =
      curvedTileJacobian H p.1 := by
  unfold curvedTileRectangleFDeriv
  simp only [LinearMap.det_toContinuousLinearMap, LinearMap.det_toLin,
    Matrix.det_fin_two_of, one_mul, zero_mul, sub_zero]

theorem modularLowerHeightDeriv_differentiableAt
    {x : ℝ} (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    DifferentiableAt ℝ modularLowerHeightDeriv x := by
  unfold modularLowerHeightDeriv
  exact differentiableAt_id.neg.fun_div
    (modularLowerHeight_hasDerivAt hx).differentiableAt
    (ne_of_gt (modularLowerHeight_pos hx))

/-- Derivative of `Φ_H` along a horizontal line in the source rectangle. -/
theorem hasDerivAt_curvedTileRectangleMap_horizontal
    (H : ℝ) {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    HasDerivAt (fun x : ℝ => curvedTileRectangleMap H (x, p.2))
      (1, (1 - p.2) * modularLowerHeightDeriv p.1) p.1 := by
  have hh := modularLowerHeight_hasDerivAt hp
  have h :=
    HasDerivAt.prodMk (hasDerivAt_id p.1)
      (hh.add ((hasDerivAt_const p.1 p.2).mul
        ((hasDerivAt_const p.1 H).sub hh)))
  have hderiv :
      ((1 : ℝ), modularLowerHeightDeriv p.1 +
          (0 * (H - modularLowerHeight p.1) +
            p.2 * (0 - modularLowerHeightDeriv p.1))) =
        ((1 : ℝ), (1 - p.2) * modularLowerHeightDeriv p.1) := by
    apply Prod.ext
    · rfl
    · ring
  convert! h.congr_deriv hderiv using 1 <;>
    simp [curvedTileRectangleMap, curvedTileJacobian,
      Function.comp_apply, sub_eq_add_neg]

/-- Derivative of `Φ_H` along a vertical line in the source rectangle. -/
theorem hasDerivAt_curvedTileRectangleMap_vertical
    (H : ℝ) (p : ℝ × ℝ) :
    HasDerivAt (fun t : ℝ => curvedTileRectangleMap H (p.1, t))
      (0, curvedTileJacobian H p.1) p.2 := by
  simpa [curvedTileRectangleMap] using
    HasDerivAt.prodMk (hasDerivAt_const p.2 p.1)
      ((hasDerivAt_const p.2 (modularLowerHeight p.1)).add
        ((hasDerivAt_id p.2).mul
          (hasDerivAt_const p.2 (curvedTileJacobian H p.1))))

theorem hasDerivAt_curvedTileJacobian
    (H : ℝ) {x : ℝ}
    (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    HasDerivAt (curvedTileJacobian H)
      (-modularLowerHeightDeriv x) x := by
  convert! (hasDerivAt_const x H).sub
      (modularLowerHeight_hasDerivAt hx) using 1 <;>
    simp [curvedTileJacobian, sub_eq_add_neg]

theorem abs_det_curvedTileRectangleFDeriv
    {H : ℝ} (hH : 1 < H)
    {p : ℝ × ℝ}
    (hp : p ∈ Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1)) :
    |(curvedTileRectangleFDeriv H p).det| =
      curvedTileJacobian H p.1 := by
  rw [det_curvedTileRectangleFDeriv, abs_of_pos]
  exact curvedTileJacobian_pos hH ⟨hp.1.1, hp.2.1⟩

local instance curvedTileProdVolumeIsAddHaar :
    Measure.IsAddHaarMeasure (volume : Measure (ℝ × ℝ)) :=
  Measure.prod.instIsAddHaarMeasure _ _

/-- Exact Bochner change of variables from the curved modular tile to the
source rectangle.  This is the analytic Jacobian step required before the
rectangular divergence theorem can be applied. -/
theorem integral_modularCurvedTileTruncation_eq_rectangle
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (H : ℝ) (hH : 1 < H) (f : ℝ × ℝ → E) :
    (∫ p in modularCurvedTileTruncation H, f p) =
      ∫ q in Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
        curvedTileJacobian H q.1 • f (curvedTileRectangleMap H q) := by
  rw [← curvedTileRectangleMap_image hH]
  rw [MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul
    volume measurableSet_Icc
    (fun q (hq : q ∈ Set.Icc (-(1 / 2 : ℝ), 0)
      ((1 / 2 : ℝ), 1)) =>
        have hqi := Set.mem_Icc.mp hq
        have hlo := Prod.le_def.mp hqi.1
        have hhi := Prod.le_def.mp hqi.2
        (hasFDerivAt_curvedTileRectangleMap
          ⟨hlo.1, hhi.1⟩).hasFDerivWithinAt)
    (curvedTileRectangleMap_injOn hH) f]
  apply setIntegral_congr_fun measurableSet_Icc
  intro q hq
  change |(curvedTileRectangleFDeriv H q).det| •
      f (curvedTileRectangleMap H q) =
    curvedTileJacobian H q.1 • f (curvedTileRectangleMap H q)
  rw [abs_det_curvedTileRectangleFDeriv hH hq]

/-- Ordinary complex area is transported to product Lebesgue area by
Mathlib's volume-preserving equivalence `ℂ ≃ ℝ×ℝ`. -/
theorem setIntegral_complex_eq_realProdImage
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : Set ℂ) (f : ℂ → E) :
    (∫ w in s, f w ∂(volume : Measure ℂ)) =
      ∫ p in Complex.measurableEquivRealProd '' s,
        f (Complex.measurableEquivRealProd.symm p)
          ∂(volume : Measure (ℝ × ℝ)) := by
  simpa using
    (Complex.volume_preserving_equiv_real_prod.setIntegral_image_emb
      Complex.measurableEquivRealProd.measurableEmbedding
      (fun p => f (Complex.measurableEquivRealProd.symm p)) s).symm

/-! #### The real-product lift and integrability transport -/

/-- Pull an upper-half-plane function to the standard real-product
coordinates.  The measurable equivalence is used here because this is also
the coordinate expression occurring in the volume-preserving change of
variables above. -/
noncomputable def realProdLift (u : ℍ → ℂ) : ℝ × ℝ → ℂ :=
  fun p => upperLift u (Complex.measurableEquivRealProd.symm p)

/-- The measurable and continuous-linear versions of the standard
`ℂ ≃ ℝ × ℝ` coordinates have the same underlying function. -/
theorem realProdLift_eq_comp (u : ℍ → ℂ) :
    realProdLift u = upperLift u ∘ Complex.equivRealProdCLM.symm := by
  funext p
  unfold realProdLift Function.comp
  apply congrArg (upperLift u)
  apply Complex.ext
  · simp [Complex.measurableEquivRealProd_symm_apply,
      Complex.equivRealProdCLM_symm_apply]
  · simp [Complex.measurableEquivRealProd_symm_apply,
      Complex.equivRealProdCLM_symm_apply]

/-- The upper-half-plane point represented by a real-product coordinate of
positive second component. -/
noncomputable def realProdUpperPoint (p : ℝ × ℝ) (hp : 0 < p.2) : ℍ :=
  ⟨Complex.equivRealProdCLM.symm p, by
    simpa [Complex.equivRealProdCLM_symm_apply] using hp⟩

@[simp]
theorem realProdLift_apply_positive (u : ℍ → ℂ) (p : ℝ × ℝ)
    (hp : 0 < p.2) :
    realProdLift u p = u (realProdUpperPoint p hp) := by
  rw [realProdLift_eq_comp]
  change upperLift u ((realProdUpperPoint p hp : ℍ) : ℂ) = _
  exact upperLift_apply u (realProdUpperPoint p hp)

/-- Smooth upper-half-plane functions are differentiable in real-product
coordinates at every point of positive height. -/
theorem realProdLift_differentiableAt
    {u : ℍ → ℂ} (hu : RealSmooth u) {p : ℝ × ℝ} (hp : 0 < p.2) :
    DifferentiableAt ℝ (realProdLift u) p := by
  rw [realProdLift_eq_comp]
  have hOuter : DifferentiableAt ℝ (upperLift u)
      (Complex.equivRealProdCLM.symm p) := by
    simpa [realProdUpperPoint] using
      (RealSmooth.contDiffAt_upperLift hu (realProdUpperPoint p hp)).differentiableAt (by simp)
  exact hOuter.comp p Complex.equivRealProdCLM.symm.differentiableAt

/-- The first real-product coordinate derivative is exactly the previously
defined upper-half-plane derivative `dx`. -/
theorem fderiv_realProdLift_fst_eq_dx
    {u : ℍ → ℂ} (hu : RealSmooth u) {p : ℝ × ℝ} (hp : 0 < p.2) :
    fderiv ℝ (realProdLift u) p (1, 0) =
      dx u (realProdUpperPoint p hp) := by
  rw [realProdLift_eq_comp]
  have hOuter : DifferentiableAt ℝ (upperLift u)
      (Complex.equivRealProdCLM.symm p) := by
    simpa [realProdUpperPoint] using
      (RealSmooth.contDiffAt_upperLift hu (realProdUpperPoint p hp)).differentiableAt (by simp)
  have hComp := hOuter.hasFDerivAt.comp p
    Complex.equivRealProdCLM.symm.hasFDerivAt
  have hApply := congrArg
    (fun L : (ℝ × ℝ) →L[ℝ] ℂ => L (1, 0)) hComp.fderiv
  simpa [dx, d1, realProdUpperPoint,
    ContinuousLinearMap.comp_apply,
    Complex.equivRealProdCLM_symm_apply] using hApply

/-- The second real-product coordinate derivative is exactly `dy`. -/
theorem fderiv_realProdLift_snd_eq_dy
    {u : ℍ → ℂ} (hu : RealSmooth u) {p : ℝ × ℝ} (hp : 0 < p.2) :
    fderiv ℝ (realProdLift u) p (0, 1) =
      dy u (realProdUpperPoint p hp) := by
  rw [realProdLift_eq_comp]
  have hOuter : DifferentiableAt ℝ (upperLift u)
      (Complex.equivRealProdCLM.symm p) := by
    simpa [realProdUpperPoint] using
      (RealSmooth.contDiffAt_upperLift hu (realProdUpperPoint p hp)).differentiableAt (by simp)
  have hComp := hOuter.hasFDerivAt.comp p
    Complex.equivRealProdCLM.symm.hasFDerivAt
  have hApply := congrArg
    (fun L : (ℝ × ℝ) →L[ℝ] ℂ => L (0, 1)) hComp.fderiv
  simpa [dy, d1, realProdUpperPoint,
    ContinuousLinearMap.comp_apply,
    Complex.equivRealProdCLM_symm_apply] using hApply

/-- Multiplication by `height²` transports not only the integral but also
Bochner integrability from hyperbolic area to Euclidean comap area. -/
theorem integrableOn_heightSq_mul_hyperbolic_iff_comap
    (s : Set ℍ) (hs : MeasurableSet s) (f : ℍ → ℂ) :
    IntegrableOn (fun z => heightC z ^ 2 * f z) s hyperbolicMeasure ↔
      IntegrableOn f s (volume.comap UpperHalfPlane.coe) := by
  rw [hyperbolicMeasure_eq_withDensityNNReal]
  unfold IntegrableOn
  rw [restrict_withDensity hs]
  rw [integrable_withDensity_iff_integrable_smul
    hyperbolicDensityNNReal_continuous.measurable]
  exact integrable_congr (Filter.Eventually.of_forall fun z =>
    hyperbolicDensityNNReal_smul_heightSq f z)

/-- Integrability for the Euclidean comap measure is equivalent to ordinary
planar integrability on the complex image. -/
theorem integrableOn_comap_iff_complexImage
    (s : Set ℍ) (f : ℍ → ℂ) :
    IntegrableOn f s (volume.comap UpperHalfPlane.coe) ↔
      IntegrableOn (upperLift f) (UpperHalfPlane.coe '' s)
        (volume : Measure ℂ) := by
  have h := UpperHalfPlane.measurableEmbedding_coe.integrableOn_iff_comap
    (f := upperLift f) (μ := (volume : Measure ℂ))
    (s := UpperHalfPlane.coe '' s)
    (Set.image_subset_range UpperHalfPlane.coe s)
  rw [Set.preimage_image_eq s UpperHalfPlane.coe_injective] at h
  simpa [Function.comp_def] using h.symm

/-- The volume-preserving identification `ℂ ≃ ℝ × ℝ` also preserves
integrability on arbitrary image sets. -/
theorem integrableOn_complex_iff_realProdImage
    (s : Set ℂ) (f : ℂ → ℂ) :
    IntegrableOn f s (volume : Measure ℂ) ↔
      IntegrableOn
        (fun p => f (Complex.measurableEquivRealProd.symm p))
        (Complex.measurableEquivRealProd '' s)
        (volume : Measure (ℝ × ℝ)) := by
  have h := Complex.volume_preserving_equiv_real_prod.integrableOn_image
    Complex.measurableEquivRealProd.measurableEmbedding
    (f := fun p => f (Complex.measurableEquivRealProd.symm p))
    (s := s)
  simpa [Function.comp_def] using h.symm

/-- The Jacobian theorem gives the exact equivalence of integrability on the
curved region and of the weighted pullback on the source rectangle. -/
theorem integrableOn_modularCurvedTile_iff_rectangle
    (H : ℝ) (hH : 1 < H) (f : ℝ × ℝ → ℂ) :
    IntegrableOn f (modularCurvedTileTruncation H)
        (volume : Measure (ℝ × ℝ)) ↔
      IntegrableOn
        (fun q => curvedTileJacobian H q.1 •
          f (curvedTileRectangleMap H q))
        (Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1))
        (volume : Measure (ℝ × ℝ)) := by
  rw [← curvedTileRectangleMap_image hH]
  rw [MeasureTheory.integrableOn_image_iff_integrableOn_abs_det_fderiv_smul
    volume measurableSet_Icc
    (fun q (hq : q ∈ Set.Icc (-(1 / 2 : ℝ), 0)
      ((1 / 2 : ℝ), 1)) =>
        have hqi := Set.mem_Icc.mp hq
        have hlo := Prod.le_def.mp hqi.1
        have hhi := Prod.le_def.mp hqi.2
        (hasFDerivAt_curvedTileRectangleMap
          ⟨hlo.1, hhi.1⟩).hasFDerivWithinAt)
    (curvedTileRectangleMap_injOn hH)]
  apply integrableOn_congr_fun (s :=
    Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1))
    (fun q hq => ?_) measurableSet_Icc
  rw [abs_det_curvedTileRectangleFDeriv hH hq]

/-- Complete integrability transport from the hyperbolic truncated modular
tile to the literal curved-chart rectangle. -/
theorem integrableOn_heightSq_modularClosedTile_iff_rectangle
    (H : ℝ) (hH : 1 < H) (f : ℍ → ℂ) :
    IntegrableOn (fun z => heightC z ^ 2 * f z)
        (modularClosedTileTruncation H) hyperbolicMeasure ↔
      IntegrableOn
        (fun q => curvedTileJacobian H q.1 •
          realProdLift f (curvedTileRectangleMap H q))
        (Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1))
        (volume : Measure (ℝ × ℝ)) := by
  calc
    IntegrableOn (fun z => heightC z ^ 2 * f z)
        (modularClosedTileTruncation H) hyperbolicMeasure ↔
        IntegrableOn f (modularClosedTileTruncation H)
          (volume.comap UpperHalfPlane.coe) :=
      integrableOn_heightSq_mul_hyperbolic_iff_comap
        (modularClosedTileTruncation H)
        (modularClosedTileTruncation_measurable H) f
    _ ↔ IntegrableOn (upperLift f)
        (UpperHalfPlane.coe '' modularClosedTileTruncation H)
          (volume : Measure ℂ) :=
      integrableOn_comap_iff_complexImage
        (modularClosedTileTruncation H) f
    _ ↔ IntegrableOn (realProdLift f)
        (Complex.measurableEquivRealProd ''
          (UpperHalfPlane.coe '' modularClosedTileTruncation H))
          (volume : Measure (ℝ × ℝ)) := by
      unfold realProdLift
      exact integrableOn_complex_iff_realProdImage
        (UpperHalfPlane.coe '' modularClosedTileTruncation H)
        (upperLift f)
    _ ↔ IntegrableOn (realProdLift f)
        (modularCurvedTileTruncation H)
          (volume : Measure (ℝ × ℝ)) := by
      rw [measurableEquivRealProd_image_modularClosedTileTruncation H]
    _ ↔ IntegrableOn
        (fun q => curvedTileJacobian H q.1 •
          realProdLift f (curvedTileRectangleMap H q))
        (Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1))
        (volume : Measure (ℝ × ℝ)) :=
      integrableOn_modularCurvedTile_iff_rectangle H hH (realProdLift f)

/-- Full measure conversion for one closed truncated modular tile: the
hyperbolic `height² × divergence` integral becomes a weighted integral on
the literal source rectangle of `Φ_H`. -/
theorem setIntegral_heightSq_mul_modularClosedTile_eq_rectangle
    (H : ℝ) (hH : 1 < H) (f : ℍ → ℂ) :
    (∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 * f z ∂hyperbolicMeasure) =
      ∫ q in Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
        curvedTileJacobian H q.1 •
          upperLift f
            (Complex.measurableEquivRealProd.symm
              (curvedTileRectangleMap H q)) := by
  calc
    (∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 * f z ∂hyperbolicMeasure) =
        ∫ w in UpperHalfPlane.coe '' modularClosedTileTruncation H,
          upperLift f w ∂(volume : Measure ℂ) :=
      setIntegral_heightSq_mul_hyperbolic_eq_complexImage
        (modularClosedTileTruncation H)
        (modularClosedTileTruncation_measurable H) f
    _ = ∫ p in modularCurvedTileTruncation H,
        upperLift f (Complex.measurableEquivRealProd.symm p)
          ∂(volume : Measure (ℝ × ℝ)) := by
      rw [setIntegral_complex_eq_realProdImage,
        measurableEquivRealProd_image_modularClosedTileTruncation H]
    _ = ∫ q in Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
        curvedTileJacobian H q.1 •
          upperLift f
            (Complex.measurableEquivRealProd.symm
              (curvedTileRectangleMap H q)) :=
      integral_modularCurvedTileTruncation_eq_rectangle H hH
        (fun p => upperLift f
          (Complex.measurableEquivRealProd.symm p))

/-- Horizontal Piola component for the curved-tile pullback. -/
noncomputable def curvedTilePiolaX
    (H : ℝ) (X : ℝ × ℝ → ℂ) (p : ℝ × ℝ) : ℂ :=
  (curvedTileJacobian H p.1 : ℂ) * X (curvedTileRectangleMap H p)

/-- Vertical Piola component.  The correction term is exactly the shear
created by the moving circular floor. -/
noncomputable def curvedTilePiolaY
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) (p : ℝ × ℝ) : ℂ :=
  Y (curvedTileRectangleMap H p) -
    (((1 - p.2) * modularLowerHeightDeriv p.1 : ℝ) : ℂ) *
      X (curvedTileRectangleMap H p)

@[simp]
theorem curvedTilePiolaY_top
    (H x : ℝ) (X Y : ℝ × ℝ → ℂ) :
    curvedTilePiolaY H X Y (x, 1) = Y (x, H) := by
  simp [curvedTilePiolaY]

@[simp]
theorem curvedTilePiolaY_bottom
    (H x : ℝ) (X Y : ℝ × ℝ → ℂ) :
    curvedTilePiolaY H X Y (x, 0) =
      Y (x, modularLowerHeight x) -
        (modularLowerHeightDeriv x : ℂ) *
          X (x, modularLowerHeight x) := by
  simp [curvedTilePiolaY]

/-- Horizontal derivative of the first Piola component, before expanding the
real-linear derivative of `X` into its coordinate values. -/
theorem hasDerivAt_curvedTilePiolaX_horizontal
    (H : ℝ) {X : ℝ × ℝ → ℂ} {DX : (ℝ × ℝ) →L[ℝ] ℂ}
    {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
    (hX : HasFDerivAt X DX (curvedTileRectangleMap H p)) :
    HasDerivAt
      (fun x : ℝ => curvedTilePiolaX H X (x, p.2))
      ((-modularLowerHeightDeriv p.1 : ℝ) *
          X (curvedTileRectangleMap H p) +
        curvedTileJacobian H p.1 *
          DX (1, (1 - p.2) * modularLowerHeightDeriv p.1))
      p.1 := by
  have hj := (hasDerivAt_curvedTileJacobian H hp).ofReal_comp
  have hXc := hX.comp_hasDerivAt p.1
    (hasDerivAt_curvedTileRectangleMap_horizontal H hp)
  convert! hj.mul hXc using 1 <;>
    simp [curvedTilePiolaX, Complex.real_smul,
      Function.comp_apply, sub_eq_add_neg] <;>
    ring

/-- Vertical derivative of the second Piola component. -/
theorem hasDerivAt_curvedTilePiolaY_vertical
    (H : ℝ) {X Y : ℝ × ℝ → ℂ}
    {DX DY : (ℝ × ℝ) →L[ℝ] ℂ}
    {p : ℝ × ℝ}
    (hX : HasFDerivAt X DX (curvedTileRectangleMap H p))
    (hY : HasFDerivAt Y DY (curvedTileRectangleMap H p)) :
    HasDerivAt
      (fun t : ℝ => curvedTilePiolaY H X Y (p.1, t))
      (DY (0, curvedTileJacobian H p.1) +
        modularLowerHeightDeriv p.1 *
          X (curvedTileRectangleMap H p) -
        ((1 - p.2) * modularLowerHeightDeriv p.1 : ℝ) *
          DX (0, curvedTileJacobian H p.1))
      p.2 := by
  have hΦ := hasDerivAt_curvedTileRectangleMap_vertical H p
  have hXc := hX.comp_hasDerivAt p.2 hΦ
  have hYc := hY.comp_hasDerivAt p.2 hΦ
  have haReal : HasDerivAt
      (fun t : ℝ => (1 - t) * modularLowerHeightDeriv p.1)
      (-modularLowerHeightDeriv p.1) p.2 := by
    have hbase :=
      (((hasDerivAt_const p.2 (1 : ℝ)).sub (hasDerivAt_id p.2)).mul_const
        (modularLowerHeightDeriv p.1))
    simpa [sub_eq_add_neg] using hbase
  have ha := haReal.ofReal_comp
  have h := hYc.sub (ha.mul hXc)
  convert! h using 1 <;>
    simp [curvedTilePiolaY, Function.comp_apply,
      Complex.real_smul, sub_eq_add_neg] <;>
    ring

theorem curvedTilePiolaX_differentiableAt
    (H : ℝ) {X : ℝ × ℝ → ℂ} {DX : (ℝ × ℝ) →L[ℝ] ℂ}
    {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
    (hX : HasFDerivAt X DX (curvedTileRectangleMap H p)) :
    DifferentiableAt ℝ (curvedTilePiolaX H X) p := by
  have hΦ := hasFDerivAt_curvedTileRectangleMap (H := H) hp
  have hXc := hX.comp p hΦ
  have hfst : HasFDerivAt
      (Prod.fst : ℝ × ℝ → ℝ)
      (ContinuousLinearMap.fst ℝ ℝ ℝ) p :=
    hasFDerivAt_fst
  have hh := (modularLowerHeight_hasDerivAt hp).comp_hasFDerivAt p hfst
  have hjReal := (hasFDerivAt_const H p).sub hh
  have hj := Complex.ofRealCLM.hasFDerivAt.comp p hjReal
  convert! (hj.mul hXc).differentiableAt using 1 <;>
    simp [curvedTilePiolaX, curvedTileJacobian,
      Function.comp_apply, sub_eq_add_neg]

theorem curvedTilePiolaY_differentiableAt
    (H : ℝ) {X Y : ℝ × ℝ → ℂ}
    {DX DY : (ℝ × ℝ) →L[ℝ] ℂ}
    {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
    (hX : HasFDerivAt X DX (curvedTileRectangleMap H p))
    (hY : HasFDerivAt Y DY (curvedTileRectangleMap H p)) :
    DifferentiableAt ℝ (curvedTilePiolaY H X Y) p := by
  have hΦ := hasFDerivAt_curvedTileRectangleMap (H := H) hp
  have hXc := (hX.comp p hΦ).differentiableAt
  have hYc := (hY.comp p hΦ).differentiableAt
  have hh' : DifferentiableAt ℝ
      (fun q : ℝ × ℝ => modularLowerHeightDeriv q.1) p :=
    (modularLowerHeightDeriv_differentiableAt hp).comp p
      differentiableAt_fst
  have haReal : DifferentiableAt ℝ
      (fun q : ℝ × ℝ =>
        (1 - q.2) * modularLowerHeightDeriv q.1) p :=
    ((differentiableAt_const (c := (1 : ℝ))).sub
      differentiableAt_snd).mul hh'
  have ha : DifferentiableAt ℝ
      (fun q : ℝ × ℝ =>
        (((1 - q.2) * modularLowerHeightDeriv q.1 : ℝ) : ℂ)) p :=
    Complex.ofRealCLM.differentiableAt.comp p haReal
  convert! hYc.sub (ha.mul hXc) using 1 <;>
    simp [curvedTilePiolaY, Function.comp_apply,
      Complex.real_smul, sub_eq_add_neg]

/-- Coordinate expansion for a real-linear complex-valued map on
`ℝ×ℝ`. -/
theorem continuousLinearMap_apply_realProd_coordinates
    (D : (ℝ × ℝ) →L[ℝ] ℂ) (a b : ℝ) :
    D (a, b) = (a : ℂ) * D (1, 0) + (b : ℂ) * D (0, 1) := by
  have hab : (a, b) = a • (1, 0) + b • (0, 1) := by
    ext <;> simp
  rw [hab, map_add, map_smul, map_smul]
  simp [Complex.real_smul]

/-- Pointwise Piola identity in terms of actual Fréchet derivatives. -/
theorem fderiv_curvedTilePiola_divergence
    (H : ℝ) {X Y : ℝ × ℝ → ℂ}
    {DX DY : (ℝ × ℝ) →L[ℝ] ℂ}
    {p : ℝ × ℝ}
    (hp : p.1 ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
    (hX : HasFDerivAt X DX (curvedTileRectangleMap H p))
    (hY : HasFDerivAt Y DY (curvedTileRectangleMap H p)) :
    fderiv ℝ (curvedTilePiolaX H X) p (1, 0) +
        fderiv ℝ (curvedTilePiolaY H X Y) p (0, 1) =
      (curvedTileJacobian H p.1 : ℂ) *
        (DX (1, 0) + DY (0, 1)) := by
  have hPXfull :=
    (curvedTilePiolaX_differentiableAt H hp hX).hasFDerivAt
  have hPYfull :=
    (curvedTilePiolaY_differentiableAt H hp hX hY).hasFDerivAt
  have hlineX : HasDerivAt (fun x : ℝ => (x, p.2)) (1, 0) p.1 :=
    HasDerivAt.prodMk (hasDerivAt_id p.1) (hasDerivAt_const p.1 p.2)
  have hlineY : HasDerivAt (fun y : ℝ => (p.1, y)) (0, 1) p.2 :=
    HasDerivAt.prodMk (hasDerivAt_const p.2 p.1) (hasDerivAt_id p.2)
  have hPX :
      fderiv ℝ (curvedTilePiolaX H X) p (1, 0) =
        ((-modularLowerHeightDeriv p.1 : ℝ) *
            X (curvedTileRectangleMap H p) +
          curvedTileJacobian H p.1 *
            DX (1, (1 - p.2) * modularLowerHeightDeriv p.1)) :=
    (hPXfull.comp_hasDerivAt p.1 hlineX).unique
      (by
        convert! hasDerivAt_curvedTilePiolaX_horizontal H hp hX using 1 <;>
          simp [Function.comp_apply])
  have hPY :
      fderiv ℝ (curvedTilePiolaY H X Y) p (0, 1) =
        (DY (0, curvedTileJacobian H p.1) +
          modularLowerHeightDeriv p.1 *
            X (curvedTileRectangleMap H p) -
          ((1 - p.2) * modularLowerHeightDeriv p.1 : ℝ) *
            DX (0, curvedTileJacobian H p.1)) :=
    (hPYfull.comp_hasDerivAt p.2 hlineY).unique
      (by
        convert! hasDerivAt_curvedTilePiolaY_vertical H hX hY using 1 <;>
          simp [Function.comp_apply])
  rw [hPX, hPY,
    continuousLinearMap_apply_realProd_coordinates DX 1
      ((1 - p.2) * modularLowerHeightDeriv p.1),
    continuousLinearMap_apply_realProd_coordinates DY 0
      (curvedTileJacobian H p.1),
    continuousLinearMap_apply_realProd_coordinates DX 0
      (curvedTileJacobian H p.1)]
  push_cast
  ring

end CurvedTileCoherentInstances

set_option backward.isDefEq.respectTransparency true

/-- Pure algebra behind the Piola identity.  The two middle shear terms and
the two derivatives of the moving lower boundary cancel exactly, leaving
`det DΦ` times the original divergence. -/
theorem curvedTilePiola_divergence_algebra
    (j hp om X₀ Xx Xy Yy : ℂ) :
    (-hp * X₀ + j * (Xx + om * hp * Xy)) +
        (j * Yy + hp * X₀ - om * hp * j * Xy) =
      j * (Xx + Yy) := by
  ring

/-- Counterclockwise boundary flux of the Piola field on the literal source
rectangle. -/
noncomputable def curvedTilePiolaBoundaryIntegral
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) : ℂ :=
  ((∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
      curvedTilePiolaY H X Y (x, 1)) -
    ∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
      curvedTilePiolaY H X Y (x, 0)) +
    (∫ t in (0 : ℝ)..1,
      curvedTilePiolaX H X (1 / 2, t)) -
    ∫ t in (0 : ℝ)..1,
      curvedTilePiolaX H X (-(1 / 2), t)

/-! #### Normalization to the actual modular-edge parameters -/

/-- Common height of the two finite vertices of the standard modular tile. -/
noncomputable def modularVertexHeight : ℝ := Real.sqrt 3 / 2

theorem modularLowerHeight_half :
    modularLowerHeight (1 / 2 : ℝ) = modularVertexHeight := by
  have hleftSq : modularLowerHeight (1 / 2 : ℝ) ^ 2 = 3 / 4 := by
    rw [modularLowerHeight, Real.sq_sqrt]
    · norm_num
    · norm_num
  have hrightSq : modularVertexHeight ^ 2 = 3 / 4 := by
    unfold modularVertexHeight
    calc
      (Real.sqrt 3 / 2) ^ 2 = Real.sqrt 3 ^ 2 / 2 ^ 2 := by ring
      _ = 3 / 4 := by rw [Real.sq_sqrt] <;> norm_num
  have hleftNonneg : 0 ≤ modularLowerHeight (1 / 2 : ℝ) :=
    Real.sqrt_nonneg _
  have hrightNonneg : 0 ≤ modularVertexHeight := by
    exact div_nonneg (Real.sqrt_nonneg _) (by norm_num)
  nlinarith

theorem modularLowerHeight_neg_half :
    modularLowerHeight (-(1 / 2 : ℝ)) = modularVertexHeight := by
  calc
    modularLowerHeight (-(1 / 2 : ℝ)) =
        modularLowerHeight (1 / 2 : ℝ) := by
      unfold modularLowerHeight
      congr 1
      ring
    _ = modularVertexHeight := modularLowerHeight_half

/-- Circular-side flux density in the standard edge parameter `t = 2x`.
It is defined on all of `ℝ`; only `t ∈ [-1,1]` is integrated. -/
noncomputable def baseModularCircularFluxIntegrand
    (X Y : ℝ × ℝ → ℂ) (t : ℝ) : ℂ :=
  ((-t / (4 * modularLowerHeight (t / 2)) : ℝ) : ℂ) *
      X (t / 2, modularLowerHeight (t / 2)) -
    ((1 / 2 : ℝ) : ℂ) *
      Y (t / 2, modularLowerHeight (t / 2))

/-- Pointwise algebra for the substitution `t = 2x` on the circular side.
The factor two is exactly the derivative of this reparametrization. -/
theorem two_smul_baseModularCircularFluxIntegrand
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) {x : ℝ}
    (hx : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    (2 : ℝ) • baseModularCircularFluxIntegrand X Y (2 * x) =
      -curvedTilePiolaY H X Y (x, 0) := by
  have hh : modularLowerHeight x ≠ 0 :=
    ne_of_gt (modularLowerHeight_pos hx)
  rw [curvedTilePiolaY_bottom]
  simp only [baseModularCircularFluxIntegrand]
  have htwo : (2 * x) / 2 = x := by ring
  rw [htwo]
  unfold modularLowerHeightDeriv
  simp only [Complex.real_smul]
  push_cast
  field_simp [hh]
  ring

/-- The lower circular contribution, including its counterclockwise
orientation, written in the actual modular parameter `t ∈ [-1,1]`. -/
theorem neg_integral_curvedTilePiolaY_bottom_eq_circular
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) :
    -(∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
        curvedTilePiolaY H X Y (x, 0)) =
      ∫ t in (-1 : ℝ)..1, baseModularCircularFluxIntegrand X Y t := by
  calc
    -(∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
        curvedTilePiolaY H X Y (x, 0)) =
        ∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
          -curvedTilePiolaY H X Y (x, 0) := by
      rw [intervalIntegral.integral_neg]
    _ = ∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
        (2 : ℝ) • baseModularCircularFluxIntegrand X Y (2 * x) := by
      apply intervalIntegral.integral_congr
      intro x hx
      have hx' : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
        simpa [uIcc_of_le (by norm_num :
          (-(1 / 2 : ℝ)) ≤ (1 / 2 : ℝ))] using hx
      exact (two_smul_baseModularCircularFluxIntegrand H X Y hx').symm
    _ = (2 : ℝ) •
        (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
          baseModularCircularFluxIntegrand X Y (2 * x)) := by
      rw [intervalIntegral.integral_smul]
    _ = ∫ t in (-1 : ℝ)..1,
        baseModularCircularFluxIntegrand X Y t := by
      simpa using
        (intervalIntegral.smul_integral_comp_mul_left
          (f := baseModularCircularFluxIntegrand X Y)
          (a := (-(1 / 2 : ℝ))) (b := (1 / 2 : ℝ)) (2 : ℝ))

/-- Affine substitution on either vertical face of the curved chart. -/
theorem integral_curvedTilePiolaX_vertical
    (H x : ℝ) (X : ℝ × ℝ → ℂ) :
    (∫ t in (0 : ℝ)..1, curvedTilePiolaX H X (x, t)) =
      ∫ y in modularLowerHeight x..H, X (x, y) := by
  calc
    (∫ t in (0 : ℝ)..1, curvedTilePiolaX H X (x, t)) =
        ∫ t in (0 : ℝ)..1,
          (curvedTileJacobian H x : ℂ) *
            X (x, modularLowerHeight x +
              curvedTileJacobian H x * t) := by
      apply intervalIntegral.integral_congr
      intro t _ht
      simp [curvedTilePiolaX, curvedTileRectangleMap, mul_comm]
    _ = (curvedTileJacobian H x : ℂ) *
        (∫ t in (0 : ℝ)..1,
          X (x, modularLowerHeight x + curvedTileJacobian H x * t)) := by
      rw [intervalIntegral.integral_const_mul]
    _ = curvedTileJacobian H x •
        (∫ t in (0 : ℝ)..1,
          X (x, modularLowerHeight x + curvedTileJacobian H x * t)) := by
      rw [Complex.real_smul]
    _ = ∫ y in
          modularLowerHeight x + curvedTileJacobian H x * 0..modularLowerHeight x + curvedTileJacobian H x * 1,
        X (x, y) := by
      exact intervalIntegral.smul_integral_comp_add_mul
        (f := fun y : ℝ => X (x, y))
        (a := (0 : ℝ)) (b := (1 : ℝ))
        (curvedTileJacobian H x) (modularLowerHeight x)
    _ = ∫ y in modularLowerHeight x..H, X (x, y) := by
      simp [curvedTileJacobian]

/-- Right vertical contribution in the native parameter
`y = sqrt(3)/2 + s`. -/
theorem integral_curvedTilePiolaX_right_eq_verticalParameter
    (H : ℝ) (X : ℝ × ℝ → ℂ) :
    (∫ t in (0 : ℝ)..1, curvedTilePiolaX H X (1 / 2, t)) =
      ∫ s in (0 : ℝ)..(H - modularVertexHeight),
        X (1 / 2, modularVertexHeight + s) := by
  rw [integral_curvedTilePiolaX_vertical, modularLowerHeight_half]
  simpa [add_comm] using
    (intervalIntegral.integral_comp_add_right
      (f := fun y : ℝ => X (1 / 2, y))
      (a := (0 : ℝ)) (b := H - modularVertexHeight)
      modularVertexHeight).symm

/-- Left vertical contribution in the same native height-increment
parameter. -/
theorem integral_curvedTilePiolaX_left_eq_verticalParameter
    (H : ℝ) (X : ℝ × ℝ → ℂ) :
    (∫ t in (0 : ℝ)..1, curvedTilePiolaX H X (-(1 / 2), t)) =
      ∫ s in (0 : ℝ)..(H - modularVertexHeight),
        X (-(1 / 2), modularVertexHeight + s) := by
  rw [integral_curvedTilePiolaX_vertical, modularLowerHeight_neg_half]
  simpa [add_comm] using
    (intervalIntegral.integral_comp_add_right
      (f := fun y : ℝ => X (-(1 / 2), y))
      (a := (0 : ℝ)) (b := H - modularVertexHeight)
      modularVertexHeight).symm

/-- Top horocycle term in the original real coordinate. -/
theorem integral_curvedTilePiolaY_top_eq_horocycle
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) :
    (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
        curvedTilePiolaY H X Y (x, 1)) =
      ∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), Y (x, H) := by
  apply intervalIntegral.integral_congr
  intro x _hx
  exact curvedTilePiolaY_top H x X Y

/-- Counterclockwise boundary flux written wholly in the base modular
parameters: circular `t ∈ [-1,1]`, vertical height increment
`s = y-sqrt(3)/2`, and the exact top horocycle coordinate. -/
noncomputable def baseModularTruncationBoundaryIntegral
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) : ℂ :=
  (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), Y (x, H)) +
    (∫ t in (-1 : ℝ)..1, baseModularCircularFluxIntegrand X Y t) +
    (∫ s in (0 : ℝ)..(H - modularVertexHeight),
      X (1 / 2, modularVertexHeight + s)) -
    ∫ s in (0 : ℝ)..(H - modularVertexHeight),
      X (-(1 / 2), modularVertexHeight + s)

/-- The rectangle boundary returned by Green's theorem is exactly the
native modular-edge boundary expression, with all orientation signs and
change-of-parameter factors made explicit. -/
theorem curvedTilePiolaBoundaryIntegral_eq_baseModular
    (H : ℝ) (X Y : ℝ × ℝ → ℂ) :
    curvedTilePiolaBoundaryIntegral H X Y =
      baseModularTruncationBoundaryIntegral H X Y := by
  unfold curvedTilePiolaBoundaryIntegral
  unfold baseModularTruncationBoundaryIntegral
  simp only [sub_eq_add_neg]
  rw [integral_curvedTilePiolaY_top_eq_horocycle,
    neg_integral_curvedTilePiolaY_bottom_eq_circular,
    integral_curvedTilePiolaX_right_eq_verticalParameter,
    integral_curvedTilePiolaX_left_eq_verticalParameter]
  ring

/-- Green's theorem for one curved modular tile, expressed on the source
rectangle after the exact Piola pullback.  All differentiability hypotheses
refer to the original field on the actual image of `Φ_H`; the transformed
field and its divergence are discharged internally. -/
theorem integral_rectangle_piola_divergence_eq_boundary
    (H : ℝ)
    (X Y : ℝ × ℝ → ℂ)
    (DX DY : ℝ × ℝ → (ℝ × ℝ) →L[ℝ] ℂ)
    (hX : ∀ q ∈
      Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
      HasFDerivAt X (DX (curvedTileRectangleMap H q))
        (curvedTileRectangleMap H q))
    (hY : ∀ q ∈
      Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
      HasFDerivAt Y (DY (curvedTileRectangleMap H q))
        (curvedTileRectangleMap H q))
    (hInt : IntegrableOn
      (fun q => (curvedTileJacobian H q.1 : ℂ) *
        (DX (curvedTileRectangleMap H q) (1, 0) +
          DY (curvedTileRectangleMap H q) (0, 1)))
      (Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1))) :
    (∫ q in Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
      (curvedTileJacobian H q.1 : ℂ) *
        (DX (curvedTileRectangleMap H q) (1, 0) +
          DY (curvedTileRectangleMap H q) (0, 1))) =
      curvedTilePiolaBoundaryIntegral H X Y := by
  let R : Set (ℝ × ℝ) :=
    Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1)
  have hdiv : ∀ q ∈ R,
      fderiv ℝ (curvedTilePiolaX H X) q (1, 0) +
          fderiv ℝ (curvedTilePiolaY H X Y) q (0, 1) =
        (curvedTileJacobian H q.1 : ℂ) *
          (DX (curvedTileRectangleMap H q) (1, 0) +
            DY (curvedTileRectangleMap H q) (0, 1)) := by
    intro q hq
    exact fderiv_curvedTilePiola_divergence H
      ⟨hq.1.1, hq.2.1⟩ (hX q hq) (hY q hq)
  have hPXc : ContinuousOn (curvedTilePiolaX H X) R := by
    intro q hq
    exact (curvedTilePiolaX_differentiableAt H
      ⟨hq.1.1, hq.2.1⟩ (hX q hq)).continuousAt.continuousWithinAt
  have hPYc : ContinuousOn (curvedTilePiolaY H X Y) R := by
    intro q hq
    exact (curvedTilePiolaY_differentiableAt H
      ⟨hq.1.1, hq.2.1⟩ (hX q hq) (hY q hq)).continuousAt.continuousWithinAt
  have hPXdiff : ∀ q ∈
      Set.Ioo (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ
        Set.Ioo (0 : ℝ) 1,
      HasFDerivAt (curvedTilePiolaX H X)
        (fderiv ℝ (curvedTilePiolaX H X) q) q := by
    intro q hq
    have hqR : q ∈ R :=
      ⟨⟨hq.1.1.le, hq.2.1.le⟩, ⟨hq.1.2.le, hq.2.2.le⟩⟩
    exact (curvedTilePiolaX_differentiableAt H
      ⟨hq.1.1.le, hq.1.2.le⟩ (hX q hqR)).hasFDerivAt
  have hPYdiff : ∀ q ∈
      Set.Ioo (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ
        Set.Ioo (0 : ℝ) 1,
      HasFDerivAt (curvedTilePiolaY H X Y)
        (fderiv ℝ (curvedTilePiolaY H X Y) q) q := by
    intro q hq
    have hqR : q ∈ R :=
      ⟨⟨hq.1.1.le, hq.2.1.le⟩, ⟨hq.1.2.le, hq.2.2.le⟩⟩
    exact (curvedTilePiolaY_differentiableAt H
      ⟨hq.1.1.le, hq.1.2.le⟩ (hX q hqR) (hY q hqR)).hasFDerivAt
  have hInt' : IntegrableOn
      (fun q => fderiv ℝ (curvedTilePiolaX H X) q (1, 0) +
        fderiv ℝ (curvedTilePiolaY H X Y) q (0, 1)) R :=
    hInt.congr_fun (fun q hq => (hdiv q hq).symm) measurableSet_Icc
  have hrect :=
    MeasureTheory.integral_divergence_prod_Icc_of_hasFDerivAt_of_le
      (curvedTilePiolaX H X) (curvedTilePiolaY H X Y)
      (fun q => fderiv ℝ (curvedTilePiolaX H X) q)
      (fun q => fderiv ℝ (curvedTilePiolaY H X Y) q)
      (-(1 / 2 : ℝ), (0 : ℝ)) ((1 / 2 : ℝ), (1 : ℝ))
      (by norm_num :
        (-(1 / 2 : ℝ), (0 : ℝ)) ≤ ((1 / 2 : ℝ), (1 : ℝ)))
      hPXc hPYc hPXdiff hPYdiff hInt'
  calc
    (∫ q in Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1),
        (curvedTileJacobian H q.1 : ℂ) *
          (DX (curvedTileRectangleMap H q) (1, 0) +
            DY (curvedTileRectangleMap H q) (0, 1))) =
        ∫ q in R,
          fderiv ℝ (curvedTilePiolaX H X) q (1, 0) +
            fderiv ℝ (curvedTilePiolaY H X Y) q (0, 1) := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro q hq
      exact (hdiv q hq).symm
    _ = curvedTilePiolaBoundaryIntegral H X Y := by
      simpa [R, curvedTilePiolaBoundaryIntegral] using hrect

/-! #### Closed-tile Green theorem for genuine upper-half-plane fields -/

/-- In positive real-product coordinates the lifted divergence is precisely
the sum of the two coordinate Fréchet derivatives. -/
theorem realProdLift_divergence_eq_fderiv
    {U V : ℍ → ℂ} (hU : RealSmooth U) (hV : RealSmooth V)
    {p : ℝ × ℝ} (hp : 0 < p.2) :
    realProdLift (fun z => dx U z + dy V z) p =
      fderiv ℝ (realProdLift U) p (1, 0) +
        fderiv ℝ (realProdLift V) p (0, 1) := by
  rw [realProdLift_apply_positive]
  rw [fderiv_realProdLift_fst_eq_dx hU hp,
    fderiv_realProdLift_snd_eq_dy hV hp]

/-- The named boundary expression for actual upper-half-plane fields.  Its
four terms use exactly the base modular circular, vertical, and horocycle
parameters introduced above. -/
noncomputable def baseModularTruncationBoundaryFlux
    (H : ℝ) (U V : ℍ → ℂ) : ℂ :=
  baseModularTruncationBoundaryIntegral H (realProdLift U) (realProdLift V)

theorem baseModularTruncationBoundaryFlux_eq
    (H : ℝ) (U V : ℍ → ℂ) :
    baseModularTruncationBoundaryFlux H U V =
      (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), realProdLift V (x, H)) +
        (∫ t in (-1 : ℝ)..1,
          baseModularCircularFluxIntegrand
            (realProdLift U) (realProdLift V) t) +
        (∫ s in (0 : ℝ)..(H - modularVertexHeight),
          realProdLift U (1 / 2, modularVertexHeight + s)) -
        ∫ s in (0 : ℝ)..(H - modularVertexHeight),
          realProdLift U (-(1 / 2), modularVertexHeight + s) := by
  rfl

/-- The explicit top horocycle point at truncation height `H`. -/
def curvedTileTopHorocycleParam (H : ℝ) (hH : 0 < H) (x : ℝ) : ℍ :=
  ⟨Complex.mk x H, hH⟩

@[simp]
theorem realProdLift_topHorocycle
    (U : ℍ → ℂ) (H : ℝ) (hH : 0 < H) (x : ℝ) :
    realProdLift U (x, H) = U (curvedTileTopHorocycleParam H hH x) := by
  unfold realProdLift
  change upperLift U ((curvedTileTopHorocycleParam H hH x : ℍ) : ℂ) = _
  exact upperLift_apply U (curvedTileTopHorocycleParam H hH x)

/-- The normalized real-product circular coordinate is literally the
existing exact modular circular-edge parametrization. -/
@[simp]
theorem realProdLift_modularCircularArcParam
    (U : ℍ → ℂ) (t : Set.Icc (-1 : ℝ) 1) :
    realProdLift U
        ((t : ℝ) / 2, modularLowerHeight ((t : ℝ) / 2)) =
      U (modularCircularArcParam t) := by
  unfold realProdLift
  have harg :
      Complex.measurableEquivRealProd.symm
        ((t : ℝ) / 2, modularLowerHeight ((t : ℝ) / 2)) =
        (modularCircularArcParam t : ℂ) := by
    simp [modularLowerHeight, modularCircularArcParam]
  rw [harg]
  exact upperLift_apply U (modularCircularArcParam t)

/-- The normalized right vertical coordinate is the existing exact modular
right-edge parametrization. -/
@[simp]
theorem realProdLift_modularRightVerticalParam
    (U : ℍ → ℂ) (s : Set.Ici (0 : ℝ)) :
    realProdLift U (1 / 2, modularVertexHeight + (s : ℝ)) =
      U (modularRightVerticalParam s) := by
  unfold realProdLift
  have harg :
      Complex.measurableEquivRealProd.symm
        (1 / 2, modularVertexHeight + (s : ℝ)) =
        (modularRightVerticalParam s : ℂ) := by
    simp [modularVertexHeight, modularRightVerticalParam]
  rw [harg]
  exact upperLift_apply U (modularRightVerticalParam s)

/-- The analogous identity for the left vertical edge. -/
@[simp]
theorem realProdLift_modularLeftVerticalParam
    (U : ℍ → ℂ) (s : Set.Ici (0 : ℝ)) :
    realProdLift U (-(1 / 2), modularVertexHeight + (s : ℝ)) =
      U (modularLeftVerticalParam s) := by
  unfold realProdLift
  have harg :
      Complex.measurableEquivRealProd.symm
        (-(1 / 2), modularVertexHeight + (s : ℝ)) =
        (modularLeftVerticalParam s : ℂ) := by
    simp [modularVertexHeight, modularLeftVerticalParam]
  rw [harg]
  exact upperLift_apply U (modularLeftVerticalParam s)

/-- Tangent of the standard circular parametrization `t ↦ (t/2,
sqrt(1-(t/2)²))`. -/
noncomputable def baseModularCircularTangent (t : ℝ) : ℂ :=
  Complex.mk (1 / 2)
    (-t / (4 * modularLowerHeight (t / 2)))

/-- The normalized circular density is literally the value of the genuine
flux one-form on the existing modular circular parametrization and its
actual tangent. -/
theorem baseModularCircularFluxIntegrand_lift_eq_flux
    (U V : ℍ → ℂ) (t : Set.Icc (-1 : ℝ) 1) :
    baseModularCircularFluxIntegrand
        (realProdLift U) (realProdLift V) (t : ℝ) =
      GammaTwoQuotientGreenBoundary.fluxOneFormValue U V
        (modularCircularArcParam t)
        (baseModularCircularTangent (t : ℝ)) := by
  simp [baseModularCircularFluxIntegrand,
    baseModularCircularTangent,
    GammaTwoQuotientGreenBoundary.fluxOneFormValue]
  ring

/-- Right vertical normalized density as an actual one-form value. -/
theorem realProdLift_rightVertical_eq_flux
    (U V : ℍ → ℂ) (s : Set.Ici (0 : ℝ)) :
    realProdLift U (1 / 2, modularVertexHeight + (s : ℝ)) =
      GammaTwoQuotientGreenBoundary.fluxOneFormValue U V
        (modularRightVerticalParam s) Complex.I := by
  simpa [GammaTwoQuotientGreenBoundary.fluxOneFormValue] using
    (realProdLift_modularRightVerticalParam U s)

/-- Left vertical normalized density as an actual one-form value. -/
theorem realProdLift_leftVertical_eq_flux
    (U V : ℍ → ℂ) (s : Set.Ici (0 : ℝ)) :
    realProdLift U (-(1 / 2), modularVertexHeight + (s : ℝ)) =
      GammaTwoQuotientGreenBoundary.fluxOneFormValue U V
        (modularLeftVerticalParam s) Complex.I := by
  simpa [GammaTwoQuotientGreenBoundary.fluxOneFormValue] using
    (realProdLift_modularLeftVerticalParam U s)

/-- The positively signed top term is the one-form evaluated on the
counterclockwise tangent `-1` (right-to-left along the horocycle). -/
theorem realProdLift_topHorocycle_eq_flux
    (U V : ℍ → ℂ) (H : ℝ) (hH : 0 < H) (x : ℝ) :
    realProdLift V (x, H) =
      GammaTwoQuotientGreenBoundary.fluxOneFormValue U V
        (curvedTileTopHorocycleParam H hH x) (-1) := by
  simpa [GammaTwoQuotientGreenBoundary.fluxOneFormValue] using
    (realProdLift_topHorocycle V H hH x)

/-- Exact closed-tile Green identity.  The only integrability assumption is
the natural truncated hyperbolic bulk integrability; all Euclidean,
real-product, and Jacobian integrability obligations are derived from it. -/
theorem setIntegral_heightSq_divergence_modularClosedTile_eq_boundary
    (H : ℝ) (hH : 1 < H) (U V : ℍ → ℂ)
    (hU : RealSmooth U) (hV : RealSmooth V)
    (hInt : IntegrableOn
      (fun z => heightC z ^ 2 * (dx U z + dy V z))
      (modularClosedTileTruncation H) hyperbolicMeasure) :
    (∫ z in modularClosedTileTruncation H,
      heightC z ^ 2 * (dx U z + dy V z) ∂hyperbolicMeasure) =
      baseModularTruncationBoundaryFlux H U V := by
  let R : Set (ℝ × ℝ) :=
    Set.Icc (-(1 / 2 : ℝ), 0) ((1 / 2 : ℝ), 1)
  have hUchart : ∀ q ∈ R,
      HasFDerivAt (realProdLift U)
        (fderiv ℝ (realProdLift U) (curvedTileRectangleMap H q))
        (curvedTileRectangleMap H q) := by
    intro q hq
    exact (realProdLift_differentiableAt hU
      (curvedTileRectangleMap_snd_pos hH hq)).hasFDerivAt
  have hVchart : ∀ q ∈ R,
      HasFDerivAt (realProdLift V)
        (fderiv ℝ (realProdLift V) (curvedTileRectangleMap H q))
        (curvedTileRectangleMap H q) := by
    intro q hq
    exact (realProdLift_differentiableAt hV
      (curvedTileRectangleMap_snd_pos hH hq)).hasFDerivAt
  have hPullback : IntegrableOn
      (fun q => curvedTileJacobian H q.1 •
        realProdLift (fun z => dx U z + dy V z)
          (curvedTileRectangleMap H q)) R := by
    exact (integrableOn_heightSq_modularClosedTile_iff_rectangle
      H hH (fun z => dx U z + dy V z)).mp hInt
  have hDerivativePullback : IntegrableOn
      (fun q => (curvedTileJacobian H q.1 : ℂ) *
        (fderiv ℝ (realProdLift U) (curvedTileRectangleMap H q) (1, 0) +
          fderiv ℝ (realProdLift V) (curvedTileRectangleMap H q) (0, 1)))
      R := by
    refine hPullback.congr_fun (fun q hq => ?_) measurableSet_Icc
    simp only [Complex.real_smul]
    rw [realProdLift_divergence_eq_fderiv hU hV
      (curvedTileRectangleMap_snd_pos hH hq)]
  have hGreen := integral_rectangle_piola_divergence_eq_boundary H
    (realProdLift U) (realProdLift V)
    (fun p => fderiv ℝ (realProdLift U) p)
    (fun p => fderiv ℝ (realProdLift V) p)
    hUchart hVchart hDerivativePullback
  calc
    (∫ z in modularClosedTileTruncation H,
        heightC z ^ 2 * (dx U z + dy V z) ∂hyperbolicMeasure) =
        ∫ q in R, curvedTileJacobian H q.1 •
          realProdLift (fun z => dx U z + dy V z)
            (curvedTileRectangleMap H q) := by
      simpa [R, realProdLift] using
        (setIntegral_heightSq_mul_modularClosedTile_eq_rectangle
          H hH (fun z => dx U z + dy V z))
    _ = ∫ q in R, (curvedTileJacobian H q.1 : ℂ) *
        (fderiv ℝ (realProdLift U) (curvedTileRectangleMap H q) (1, 0) +
          fderiv ℝ (realProdLift V) (curvedTileRectangleMap H q) (0, 1)) := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro q hq
      simp only [Complex.real_smul]
      rw [realProdLift_divergence_eq_fderiv hU hV
        (curvedTileRectangleMap_snd_pos hH hq)]
    _ = curvedTilePiolaBoundaryIntegral H
        (realProdLift U) (realProdLift V) := by
      simpa [R] using hGreen
    _ = baseModularTruncationBoundaryFlux H U V := by
      rw [curvedTilePiolaBoundaryIntegral_eq_baseModular]
      rfl

namespace AxiomAuditP3CurvilinearTileStokes

#print axioms setIntegral_heightSq_mul_hyperbolic_eq_complexImage
#print axioms integral_modularCurvedTileTruncation_eq_rectangle
#print axioms integrableOn_heightSq_modularClosedTile_iff_rectangle
#print axioms integral_rectangle_piola_divergence_eq_boundary
#print axioms curvedTilePiolaBoundaryIntegral_eq_baseModular
#print axioms setIntegral_heightSq_divergence_modularClosedTile_eq_boundary

end AxiomAuditP3CurvilinearTileStokes

end Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoCurvilinearTileStokes

/-!
### P3.4c: Möbius--Piola transport from every selected tile

The selected polygon is a union of six integral-special-linear images of the
base modular tile.  A Green theorem on the base curved tile can only be
transported to those images after keeping the full real Jacobian of the
Möbius map.  This section performs that transport without an invariance
assumption on the vector field.

For a field `(X,Y)` whose oriented one-form is `X dy - Y dx`, its pullback by
`Phi_q(z) = gammaTwoCosetRep q • z` is again written as
`PiolaX dy - PiolaY dx`.  Both components are defined by evaluating the
one-form on Mathlib's genuine real Frechet derivative
`UpperHalfPlane.smulFDeriv`.  The coordinate calculation below proves

`div (Piola_q(X,Y)) = |det D Phi_q| * (div (X,Y)) o Phi_q`.

The last theorem applies Mathlib's Bochner Jacobian change-of-variables
formula, so the divergence integral on an actual selected tile is literally
the base-tile integral of the Piola pullback.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoMoebiusPiola

open MeasureTheory Set
open GammaTwoQuotientGeometry GammaTwoQuotientGreenBoundary
open SmoothCompactCoreGeometry HalfWeightDifferentialOperators

/-! #### The selected integral Möbius map and its exact derivative -/

/-- The real general-linear matrix underlying the chosen representative of a
right coset.  Its determinant is one, not merely positive. -/
noncomputable def selectedCosetGL (q : GammaTwoRightCoset) :
    GL (Fin 2) ℝ :=
  ((gammaTwoCosetRep q : SL(2, ℤ)) : GL (Fin 2) ℝ)

@[simp]
theorem selectedCosetGL_det (q : GammaTwoRightCoset) :
    (selectedCosetGL q).det = 1 := by
  simp [selectedCosetGL]

theorem selectedCosetGL_det_pos (q : GammaTwoRightCoset) :
    0 < (selectedCosetGL q).det.val := by
  simp [selectedCosetGL]

/-- The chosen Möbius action as a map of the upper half-plane. -/
noncomputable def selectedCosetAction (q : GammaTwoRightCoset) (z : ℍ) : ℍ :=
  gammaTwoCosetRep q • z

/-- Ambient complex coordinate of the chosen action.  The use of
`ofComplex` agrees with the genuine action on the open upper half-plane and
makes the Mathlib Jacobian theorem directly applicable. -/
noncomputable def selectedCosetAmbientMap (q : GammaTwoRightCoset) (w : ℂ) : ℂ :=
  ((selectedCosetGL q • UpperHalfPlane.ofComplex w : ℍ) : ℂ)

@[simp]
theorem selectedCosetAmbientMap_coe (q : GammaTwoRightCoset) (z : ℍ) :
    selectedCosetAmbientMap q (z : ℂ) =
      ((selectedCosetAction q z : ℍ) : ℂ) := by
  simp [selectedCosetAmbientMap, selectedCosetAction, selectedCosetGL]

/-- The affine denominator `c z + d` of the selected representative. -/
noncomputable def selectedCosetDenom (q : GammaTwoRightCoset) (z : ℍ) : ℂ :=
  UpperHalfPlane.denom (selectedCosetGL q) z

theorem selectedCosetDenom_ne_zero (q : GammaTwoRightCoset) (z : ℍ) :
    selectedCosetDenom q z ≠ 0 :=
  UpperHalfPlane.denom_ne_zero (selectedCosetGL q) z

/-- Holomorphic coefficient of the Möbius differential. -/
noncomputable def selectedCosetDerivative
    (q : GammaTwoRightCoset) (z : ℍ) : ℂ :=
  1 / selectedCosetDenom q z ^ 2

/-- The lower-left matrix entry, in the complex coefficient field. -/
noncomputable def selectedCosetLowerLeft (q : GammaTwoRightCoset) : ℂ :=
  (((selectedCosetGL q) 1 0 : ℝ) : ℂ)

/-- The real Jacobian used by Mathlib's change-of-variables theorem. -/
noncomputable def selectedCosetJacobian
    (q : GammaTwoRightCoset) (z : ℍ) : ℝ :=
  |(UpperHalfPlane.smulFDeriv (selectedCosetGL q) (z : ℂ)).det|

/-- Mathlib's real Frechet derivative is complex multiplication by the exact
holomorphic coefficient `(c z + d)^(-2)`. -/
theorem selectedCoset_smulFDeriv_apply
    (q : GammaTwoRightCoset) (z : ℍ) (ξ : ℂ) :
    UpperHalfPlane.smulFDeriv (selectedCosetGL q) (z : ℂ) ξ =
      selectedCosetDerivative q z * ξ := by
  have hdet : 0 < (selectedCosetGL q).det.val :=
    selectedCosetGL_det_pos q
  simp [UpperHalfPlane.smulFDeriv, UpperHalfPlane.σ, hdet,
    selectedCosetDerivative, selectedCosetDenom, selectedCosetGL_det,
    smul_eq_mul]
  ring

/-- The selected ambient Möbius map has precisely Mathlib's bundled real
Frechet derivative. -/
theorem selectedCosetAmbientMap_hasStrictFDerivAt
    (q : GammaTwoRightCoset) (z : ℍ) :
    HasStrictFDerivAt (selectedCosetAmbientMap q)
      (UpperHalfPlane.smulFDeriv (selectedCosetGL q) (z : ℂ)) (z : ℂ) := by
  unfold selectedCosetAmbientMap
  exact UpperHalfPlane.hasStrictFDerivAt_smul (selectedCosetGL q) z

/-- The coordinate Möbius map is real `C-infinity` on the open upper
half-plane. -/
theorem selectedCosetAmbientMap_contDiffOn
    (q : GammaTwoRightCoset) :
    ContDiffOn ℝ ∞ (selectedCosetAmbientMap q)
      UpperHalfPlane.upperHalfPlaneSet := by
  letI : IsScalarTower ℝ ℂ ℂ := IsScalarTower.complexToReal
  have hDiff : DifferentiableOn ℂ (selectedCosetAmbientMap q)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    change DifferentiableWithinAt ℂ
      (fun z : ℂ =>
        ((selectedCosetGL q • UpperHalfPlane.ofComplex z : ℍ) : ℂ))
      UpperHalfPlane.upperHalfPlaneSet w
    exact
      (UpperHalfPlane.hasStrictDerivAt_smul
        (selectedCosetGL_det_pos q) (⟨w, hw⟩ : ℍ)).hasDerivAt.differentiableAt.differentiableWithinAt
  exact ContDiffOn.restrict_scalars ℝ
    ((hDiff.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).contDiffOn_of_completeSpace)

/-- The selected affine denominator is real smooth. -/
theorem selectedCosetDenom_realSmooth (q : GammaTwoRightCoset) :
    RealSmooth (selectedCosetDenom q) := by
  letI : IsScalarTower ℝ ℂ ℂ := IsScalarTower.complexToReal
  have hDiff : DifferentiableOn ℂ
      (fun w : ℂ => UpperHalfPlane.denom (selectedCosetGL q) w)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w _hw
    unfold UpperHalfPlane.denom
    fun_prop
  have hSmooth : ContDiffOn ℝ ∞
      (fun w : ℂ => UpperHalfPlane.denom (selectedCosetGL q) w)
      UpperHalfPlane.upperHalfPlaneSet :=
    ContDiffOn.restrict_scalars ℝ
      ((hDiff.analyticOnNhd
        UpperHalfPlane.isOpen_upperHalfPlaneSet).contDiffOn_of_completeSpace)
  unfold RealSmooth
  exact hSmooth.congr (fun w hw => by
    simp [upperLift, selectedCosetDenom, Function.comp_def,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- The Möbius differential coefficient is real smooth. -/
theorem selectedCosetDerivative_realSmooth (q : GammaTwoRightCoset) :
    RealSmooth (selectedCosetDerivative q) := by
  have hDenom := selectedCosetDenom_realSmooth q
  have hPow : RealSmooth (fun z => selectedCosetDenom q z ^ 2) :=
    hDenom.pow 2
  have hInv : RealSmooth
      (fun z => (selectedCosetDenom q z ^ 2)⁻¹) := by
    unfold RealSmooth at hPow ⊢
    apply hPow.inv
    intro w hw
    simpa [upperLift, selectedCosetDenom, Function.comp_def,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw] using
      (UpperHalfPlane.denom_ne_zero (selectedCosetGL q)
        (⟨w, hw⟩ : ℍ))
  unfold selectedCosetDerivative
  simpa only [one_div] using hInv

/-- Exact directional derivative of `(c z + d)^(-2)`. -/
theorem d1_selectedCosetDerivative
    (q : GammaTwoRightCoset) (z : ℍ) (ξ : ℂ) :
    d1 (selectedCosetDerivative q) z ξ =
      (-2 : ℂ) * selectedCosetDenom q z ^ (-3 : ℤ) *
        selectedCosetLowerLeft q * ξ := by
  have hAffine : HasDerivAt
      (fun w : ℂ => UpperHalfPlane.denom (selectedCosetGL q) w)
      ((selectedCosetGL q) 1 0 : ℂ) (z : ℂ) := by
    simpa [UpperHalfPlane.denom] using
      (((hasDerivAt_id (z : ℂ)).const_mul
        ((((selectedCosetGL q) 1 0 : ℝ) : ℂ))).add_const
          ((((selectedCosetGL q) 1 1 : ℝ) : ℂ)))
  have hPower : HasDerivAt
      (fun w : ℂ => UpperHalfPlane.denom (selectedCosetGL q) w ^ (-2 : ℤ))
      ((-2 : ℂ) *
        UpperHalfPlane.denom (selectedCosetGL q) z ^ (-3 : ℤ) *
          ((selectedCosetGL q) 1 0 : ℂ)) (z : ℂ) := by
    convert!
      (hasDerivAt_zpow (-2 : ℤ)
        (UpperHalfPlane.denom (selectedCosetGL q) z)
        (Or.inl (UpperHalfPlane.denom_ne_zero
          (selectedCosetGL q) z))).scomp (z : ℂ) hAffine using 1 <;>
      simp [Function.comp_apply, mul_comm, mul_left_comm, mul_assoc]
  have hLocal :
      upperLift (selectedCosetDerivative q) =ᶠ[nhds (z : ℂ)]
        (fun w : ℂ =>
          UpperHalfPlane.denom (selectedCosetGL q) w ^ (-2 : ℤ)) := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    simp [upperLift, selectedCosetDerivative, selectedCosetDenom,
      Function.comp_def, UpperHalfPlane.ofComplex_apply_of_im_pos hw,
      zpow_neg, one_div]
  unfold d1
  rw [hLocal.fderiv_eq]
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ)
    hPower.complexToReal_fderiv.fderiv
  simpa [selectedCosetDenom, selectedCosetLowerLeft,
    smul_eq_mul, mul_assoc] using hApply

@[simp]
theorem dy_selectedCosetDerivative_eq_I_mul_dx
    (q : GammaTwoRightCoset) (z : ℍ) :
    dy (selectedCosetDerivative q) z =
      dx (selectedCosetDerivative q) z * Complex.I := by
  rw [dx, dy, d1_selectedCosetDerivative,
    d1_selectedCosetDerivative]
  ring

/-! #### Real and imaginary coefficient calculus -/

/-- Real part, re-embedded in `C`, preserves the real-smooth class. -/
theorem RealSmooth.complexRealPart {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (fun z => ((f z).re : ℂ)) := by
  let L : ℂ →L[ℝ] ℂ := Complex.ofRealCLM.comp Complex.reCLM
  unfold RealSmooth at hf ⊢
  simpa [upperLift, Function.comp_def, L,
    ContinuousLinearMap.comp_apply] using
      L.contDiff.comp_contDiffOn hf

/-- Imaginary part, re-embedded in `C`, preserves the real-smooth class. -/
theorem RealSmooth.complexImagPart {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (fun z => ((f z).im : ℂ)) := by
  let L : ℂ →L[ℝ] ℂ := Complex.ofRealCLM.comp Complex.imCLM
  unfold RealSmooth at hf ⊢
  simpa [upperLift, Function.comp_def, L,
    ContinuousLinearMap.comp_apply] using
      L.contDiff.comp_contDiffOn hf

/-- Directional differentiation commutes with taking the real part. -/
theorem d1_complexRealPart {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) (ξ : ℂ) :
    d1 (fun w => ((f w).re : ℂ)) z ξ =
      ((d1 f z ξ).re : ℂ) := by
  let L : ℂ →L[ℝ] ℂ := Complex.ofRealCLM.comp Complex.reCLM
  have hf' : DifferentiableAt ℝ (upperLift f) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hf z).differentiableAt (by simp)
  have hComp := L.hasFDerivAt.comp (z : ℂ) hf'.hasFDerivAt
  have hApply := congrArg (fun D : ℂ →L[ℝ] ℂ => D ξ) hComp.fderiv
  unfold d1
  rw [show upperLift (fun w : ℍ => ((f w).re : ℂ)) =
      L ∘ upperLift f by
    funext w
    simp [upperLift, Function.comp_def, L,
      ContinuousLinearMap.comp_apply]]
  simpa [L, ContinuousLinearMap.comp_apply] using hApply

/-- Directional differentiation commutes with taking the imaginary part. -/
theorem d1_complexImagPart {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) (ξ : ℂ) :
    d1 (fun w => ((f w).im : ℂ)) z ξ =
      ((d1 f z ξ).im : ℂ) := by
  let L : ℂ →L[ℝ] ℂ := Complex.ofRealCLM.comp Complex.imCLM
  have hf' : DifferentiableAt ℝ (upperLift f) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hf z).differentiableAt (by simp)
  have hComp := L.hasFDerivAt.comp (z : ℂ) hf'.hasFDerivAt
  have hApply := congrArg (fun D : ℂ →L[ℝ] ℂ => D ξ) hComp.fderiv
  unfold d1
  rw [show upperLift (fun w : ℍ => ((f w).im : ℂ)) =
      L ∘ upperLift f by
    funext w
    simp [upperLift, Function.comp_def, L,
      ContinuousLinearMap.comp_apply]]
  simpa [L, ContinuousLinearMap.comp_apply] using hApply

/-- Public real-linear decomposition of a chart directional derivative. -/
theorem d1_complex_decomposition {f : ℍ → ℂ} (z : ℍ) (ξ : ℂ) :
    d1 f z ξ =
      (ξ.re : ℂ) * dx f z + (ξ.im : ℂ) * dy f z := by
  have hξ : ξ = ξ.re • (1 : ℂ) + ξ.im • Complex.I := by
    apply Complex.ext <;> simp
  unfold dx dy d1
  rw [hξ, map_add, map_smul, map_smul]
  simp [Complex.real_smul]

@[simp]
theorem dx_neg {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dx (-f) z = -dx f z := by
  simpa [Pi.smul_apply] using dx_smul (-1 : ℂ) hf z

@[simp]
theorem dy_neg {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dy (-f) z = -dy f z := by
  simpa [Pi.smul_apply] using dy_smul (-1 : ℂ) hf z

/-- Real and imaginary entries of the conformal derivative matrix. -/
noncomputable def selectedCosetA
    (q : GammaTwoRightCoset) (z : ℍ) : ℂ :=
  ((selectedCosetDerivative q z).re : ℂ)

noncomputable def selectedCosetB
    (q : GammaTwoRightCoset) (z : ℍ) : ℂ :=
  ((selectedCosetDerivative q z).im : ℂ)

theorem selectedCosetA_realSmooth (q : GammaTwoRightCoset) :
    RealSmooth (selectedCosetA q) :=
  RealSmooth.complexRealPart (selectedCosetDerivative_realSmooth q)

theorem selectedCosetB_realSmooth (q : GammaTwoRightCoset) :
    RealSmooth (selectedCosetB q) :=
  RealSmooth.complexImagPart (selectedCosetDerivative_realSmooth q)

/-- The Cauchy--Riemann equations for the two real derivative coefficients,
in exactly the form which cancels the derivative-of-Jacobian terms in the
Piola divergence. -/
theorem dx_selectedCosetA_eq_dy_selectedCosetB
    (q : GammaTwoRightCoset) (z : ℍ) :
    dx (selectedCosetA q) z = dy (selectedCosetB q) z := by
  rw [show dx (selectedCosetA q) z =
      ((dx (selectedCosetDerivative q) z).re : ℂ) by
        unfold selectedCosetA dx
        exact d1_complexRealPart (selectedCosetDerivative_realSmooth q)
          z (1 : ℂ),
    show dy (selectedCosetB q) z =
      ((dy (selectedCosetDerivative q) z).im : ℂ) by
        unfold selectedCosetB dy
        exact d1_complexImagPart (selectedCosetDerivative_realSmooth q)
          z Complex.I,
    dy_selectedCosetDerivative_eq_I_mul_dx]
  simp

theorem dy_selectedCosetA_eq_neg_dx_selectedCosetB
    (q : GammaTwoRightCoset) (z : ℍ) :
    dy (selectedCosetA q) z = -dx (selectedCosetB q) z := by
  rw [show dy (selectedCosetA q) z =
      ((dy (selectedCosetDerivative q) z).re : ℂ) by
        unfold selectedCosetA dy
        exact d1_complexRealPart (selectedCosetDerivative_realSmooth q)
          z Complex.I,
    show dx (selectedCosetB q) z =
      ((dx (selectedCosetDerivative q) z).im : ℂ) by
        unfold selectedCosetB dx
        exact d1_complexImagPart (selectedCosetDerivative_realSmooth q)
          z (1 : ℂ),
    dy_selectedCosetDerivative_eq_I_mul_dx]
  simp

/-! #### Composition with one selected tile map -/

/-- Precomposition by a selected integral Möbius map preserves real
smoothness. -/
theorem RealSmooth.comp_selectedCosetAction {f : ℍ → ℂ}
    (hf : RealSmooth f) (q : GammaTwoRightCoset) :
    RealSmooth (fun z => f (selectedCosetAction q z)) := by
  unfold RealSmooth at hf ⊢
  have hMaps : Set.MapsTo (selectedCosetAmbientMap q)
      UpperHalfPlane.upperHalfPlaneSet
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    change 0 < (selectedCosetAmbientMap q w).im
    simpa [selectedCosetAmbientMap,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw] using
      (selectedCosetGL q • (⟨w, hw⟩ : ℍ)).im_pos
  have hComp := hf.comp (selectedCosetAmbientMap_contDiffOn q) hMaps
  exact hComp.congr (fun w hw => by
    simp [upperLift, Function.comp_def, selectedCosetAmbientMap,
      selectedCosetAction, selectedCosetGL,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- Exact real chain rule for precomposition by a selected coset
representative. -/
theorem d1_comp_selectedCosetAction
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) (ξ : ℂ) :
    d1 (fun w => f (selectedCosetAction q w)) z ξ =
      d1 f (selectedCosetAction q z)
        (UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) (z : ℂ) ξ) := by
  have hInner :=
    (selectedCosetAmbientMap_hasStrictFDerivAt q z).hasFDerivAt
  have hOuter : DifferentiableAt ℝ (upperLift f)
      (selectedCosetAmbientMap q (z : ℂ)) := by
    simpa using
      (RealSmooth.contDiffAt_upperLift hf (selectedCosetAction q z)).differentiableAt (by simp)
  have hComp := hOuter.hasFDerivAt.comp (z : ℂ) hInner
  have hLocal :
      upperLift (fun w => f (selectedCosetAction q w)) =ᶠ[nhds (z : ℂ)]
        upperLift f ∘ selectedCosetAmbientMap q := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    simp [upperLift, Function.comp_def, selectedCosetAmbientMap,
      selectedCosetAction, selectedCosetGL,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw]
  unfold d1
  rw [hLocal.fderiv_eq]
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hComp.fderiv
  simpa [ContinuousLinearMap.comp_apply, selectedCosetAmbientMap_coe]
    using hApply

theorem dx_comp_selectedCosetAction
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    dx (fun w => f (selectedCosetAction q w)) z =
      selectedCosetA q z * dx f (selectedCosetAction q z) +
        selectedCosetB q z * dy f (selectedCosetAction q z) := by
  rw [dx, d1_comp_selectedCosetAction q hf,
    selectedCoset_smulFDeriv_apply,
    d1_complex_decomposition]
  simp [selectedCosetA, selectedCosetB]

theorem dy_comp_selectedCosetAction
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    dy (fun w => f (selectedCosetAction q w)) z =
      -selectedCosetB q z * dx f (selectedCosetAction q z) +
        selectedCosetA q z * dy f (selectedCosetAction q z) := by
  rw [dy, d1_comp_selectedCosetAction q hf,
    selectedCoset_smulFDeriv_apply,
    d1_complex_decomposition]
  simp [selectedCosetA, selectedCosetB]

/-! #### The genuine Piola pullback of the flux one-form -/

/-- `dy` coefficient of the pullback of `X dy - Y dx`.  It is defined by
evaluating on the transformed vertical tangent. -/
noncomputable def selectedCosetPiolaX (q : GammaTwoRightCoset)
    (X Y : ℍ → ℂ) (z : ℍ) : ℂ :=
  fluxOneFormValue X Y (selectedCosetAction q z)
    (UpperHalfPlane.smulFDeriv
      (selectedCosetGL q) (z : ℂ) Complex.I)

/-- Negative `dx` coefficient of the same pulled-back one-form. -/
noncomputable def selectedCosetPiolaY (q : GammaTwoRightCoset)
    (X Y : ℍ → ℂ) (z : ℍ) : ℂ :=
  -fluxOneFormValue X Y (selectedCosetAction q z)
    (UpperHalfPlane.smulFDeriv
      (selectedCosetGL q) (z : ℂ) 1)

theorem selectedCosetPiolaX_coordinate
    (q : GammaTwoRightCoset) (X Y : ℍ → ℂ) (z : ℍ) :
    selectedCosetPiolaX q X Y z =
      selectedCosetA q z * X (selectedCosetAction q z) +
        selectedCosetB q z * Y (selectedCosetAction q z) := by
  rw [selectedCosetPiolaX, selectedCoset_smulFDeriv_apply]
  unfold fluxOneFormValue selectedCosetA selectedCosetB
  simp only [Complex.mul_re, Complex.mul_im, Complex.I_re,
    Complex.I_im, mul_zero, mul_one, sub_zero, zero_mul, add_zero]
  push_cast
  ring

theorem selectedCosetPiolaY_coordinate
    (q : GammaTwoRightCoset) (X Y : ℍ → ℂ) (z : ℍ) :
    selectedCosetPiolaY q X Y z =
      -selectedCosetB q z * X (selectedCosetAction q z) +
        selectedCosetA q z * Y (selectedCosetAction q z) := by
  rw [selectedCosetPiolaY, selectedCoset_smulFDeriv_apply]
  unfold fluxOneFormValue selectedCosetA selectedCosetB
  ring

/-- The two basis-defined Piola components recover the complete pullback
one-form on every real tangent vector. -/
theorem selectedCosetPiola_fluxOneFormValue
    (q : GammaTwoRightCoset) (X Y : ℍ → ℂ) (z : ℍ) (ξ : ℂ) :
    fluxOneFormValue
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y) z ξ =
      fluxOneFormValue X Y (selectedCosetAction q z)
        (UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) (z : ℂ) ξ) := by
  unfold fluxOneFormValue
  rw [selectedCosetPiolaX_coordinate,
    selectedCosetPiolaY_coordinate,
    selectedCoset_smulFDeriv_apply]
  unfold selectedCosetA selectedCosetB
  simp only [Complex.mul_re, Complex.mul_im]
  push_cast
  ring

theorem selectedCosetPiolaX_realSmooth
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) :
    RealSmooth (selectedCosetPiolaX q X Y) := by
  have hXq := RealSmooth.comp_selectedCosetAction hX q
  have hYq := RealSmooth.comp_selectedCosetAction hY q
  have hEq : selectedCosetPiolaX q X Y =
      selectedCosetA q * (fun z => X (selectedCosetAction q z)) +
        selectedCosetB q * (fun z => Y (selectedCosetAction q z)) := by
    funext z
    exact selectedCosetPiolaX_coordinate q X Y z
  rw [hEq]
  exact ((selectedCosetA_realSmooth q).mul hXq).add
    ((selectedCosetB_realSmooth q).mul hYq)

theorem selectedCosetPiolaY_realSmooth
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) :
    RealSmooth (selectedCosetPiolaY q X Y) := by
  have hXq := RealSmooth.comp_selectedCosetAction hX q
  have hYq := RealSmooth.comp_selectedCosetAction hY q
  have hEq : selectedCosetPiolaY q X Y =
      (-selectedCosetB q) * (fun z => X (selectedCosetAction q z)) +
        selectedCosetA q * (fun z => Y (selectedCosetAction q z)) := by
    funext z
    exact selectedCosetPiolaY_coordinate q X Y z
  rw [hEq]
  exact (((selectedCosetB_realSmooth q).neg).mul hXq).add
    ((selectedCosetA_realSmooth q).mul hYq)

/-! #### Jacobian identity and pointwise Piola naturality -/

/-- Mathlib's determinant formula is exactly the squared complex norm of
the holomorphic Möbius derivative. -/
theorem selectedCosetJacobian_eq_normSq
    (q : GammaTwoRightCoset) (z : ℍ) :
    selectedCosetJacobian q z =
      Complex.normSq (selectedCosetDerivative q z) := by
  have hden : selectedCosetDenom q z ≠ 0 :=
    selectedCosetDenom_ne_zero q z
  have hnorm : ‖selectedCosetDenom q z‖ ≠ 0 :=
    norm_ne_zero_iff.mpr hden
  have hdet :
      (UpperHalfPlane.smulFDeriv
        (selectedCosetGL q) (z : ℂ)).det =
        1 / ‖selectedCosetDenom q z‖ ^ 4 := by
    rw [UpperHalfPlane.det_smulFDeriv]
    simp [selectedCosetGL_det, selectedCosetDenom]
  have hpos : 0 < 1 / ‖selectedCosetDenom q z‖ ^ 4 :=
    one_div_pos.mpr (pow_pos (norm_pos_iff.mpr hden) 4)
  rw [selectedCosetJacobian, hdet, abs_of_pos hpos,
    Complex.normSq_eq_norm_sq]
  unfold selectedCosetDerivative
  rw [norm_div, norm_one, norm_pow]
  field_simp [hnorm]
  <;> ring

theorem selectedCosetA_sq_add_B_sq
    (q : GammaTwoRightCoset) (z : ℍ) :
    selectedCosetA q z ^ 2 + selectedCosetB q z ^ 2 =
      (selectedCosetJacobian q z : ℂ) := by
  rw [selectedCosetJacobian_eq_normSq]
  simp [selectedCosetA, selectedCosetB, Complex.normSq_apply]
  ring

/-- Pointwise Piola identity.  Every derivative of the Möbius coefficient
cancels by the two Cauchy--Riemann equations above; no hidden boundary or
invariance hypothesis is used. -/
theorem divergence_selectedCosetPiola
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) (z : ℍ) :
    dx (selectedCosetPiolaX q X Y) z +
        dy (selectedCosetPiolaY q X Y) z =
      (selectedCosetJacobian q z : ℂ) *
        (dx X (selectedCosetAction q z) +
          dy Y (selectedCosetAction q z)) := by
  let Xq : ℍ → ℂ := fun w => X (selectedCosetAction q w)
  let Yq : ℍ → ℂ := fun w => Y (selectedCosetAction q w)
  have hXq : RealSmooth Xq := RealSmooth.comp_selectedCosetAction hX q
  have hYq : RealSmooth Yq := RealSmooth.comp_selectedCosetAction hY q
  have hA : RealSmooth (selectedCosetA q) :=
    selectedCosetA_realSmooth q
  have hB : RealSmooth (selectedCosetB q) :=
    selectedCosetB_realSmooth q
  have hAXq : RealSmooth (selectedCosetA q * Xq) := by
    unfold RealSmooth at hA hXq ⊢
    simpa [upperLift, Function.comp_def] using hA.mul hXq
  have hBYq : RealSmooth (selectedCosetB q * Yq) := by
    unfold RealSmooth at hB hYq ⊢
    simpa [upperLift, Function.comp_def] using hB.mul hYq
  have hNegBXq : RealSmooth ((-selectedCosetB q) * Xq) := by
    have hNegB : RealSmooth (-selectedCosetB q) := RealSmooth.neg hB
    unfold RealSmooth at hNegB hXq ⊢
    simpa [upperLift, Function.comp_def] using hNegB.mul hXq
  have hAYq : RealSmooth (selectedCosetA q * Yq) := by
    unfold RealSmooth at hA hYq ⊢
    simpa [upperLift, Function.comp_def] using hA.mul hYq
  have hPiolaX : selectedCosetPiolaX q X Y =
      selectedCosetA q * Xq + selectedCosetB q * Yq := by
    funext w
    simpa [Xq, Yq] using selectedCosetPiolaX_coordinate q X Y w
  have hPiolaY : selectedCosetPiolaY q X Y =
      (-selectedCosetB q) * Xq + selectedCosetA q * Yq := by
    funext w
    simpa [Xq, Yq] using selectedCosetPiolaY_coordinate q X Y w
  rw [hPiolaX, hPiolaY]
  rw [dx_add hAXq hBYq,
    dx_mul hA hXq, dx_mul hB hYq,
    dy_add hNegBXq hAYq,
    dy_mul (RealSmooth.neg hB) hXq, dy_mul hA hYq,
    dy_neg hB]
  rw [dx_selectedCosetA_eq_dy_selectedCosetB,
    dy_selectedCosetA_eq_neg_dx_selectedCosetB]
  rw [show dx Xq z =
      selectedCosetA q z * dx X (selectedCosetAction q z) +
        selectedCosetB q z * dy X (selectedCosetAction q z) by
      simpa [Xq] using dx_comp_selectedCosetAction q hX z,
    show dy Xq z =
      -selectedCosetB q z * dx X (selectedCosetAction q z) +
        selectedCosetA q z * dy X (selectedCosetAction q z) by
      simpa [Xq] using dy_comp_selectedCosetAction q hX z,
    show dx Yq z =
      selectedCosetA q z * dx Y (selectedCosetAction q z) +
        selectedCosetB q z * dy Y (selectedCosetAction q z) by
      simpa [Yq] using dx_comp_selectedCosetAction q hY z,
    show dy Yq z =
      -selectedCosetB q z * dx Y (selectedCosetAction q z) +
        selectedCosetA q z * dy Y (selectedCosetAction q z) by
      simpa [Yq] using dy_comp_selectedCosetAction q hY z]
  rw [← selectedCosetA_sq_add_B_sq q z]
  simp only [Pi.neg_apply]
  ring

/-! #### Set images and the Mathlib Bochner Jacobian theorem -/

theorem selectedCosetAmbientMap_injOn_coeImage
    (q : GammaTwoRightCoset) (s : Set ℍ) :
    Set.InjOn (selectedCosetAmbientMap q) (UpperHalfPlane.coe '' s) := by
  rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩ hEq
  have hAction : selectedCosetAction q z = selectedCosetAction q w := by
    apply UpperHalfPlane.coe_injective
    simpa [selectedCosetAmbientMap_coe] using hEq
  have hCancel := congrArg
    (fun u : ℍ => (selectedCosetGL q)⁻¹ • u) hAction
  have hzw : z = w := by
    simpa [selectedCosetAction, selectedCosetGL] using hCancel
  simpa [hzw]

theorem selectedCosetAmbientMap_image_coe
    (q : GammaTwoRightCoset) (s : Set ℍ) :
    selectedCosetAmbientMap q '' (UpperHalfPlane.coe '' s) =
      UpperHalfPlane.coe '' (gammaTwoCosetRep q • s) := by
  apply Set.Subset.antisymm
  · rintro w ⟨_z, ⟨z, hz, rfl⟩, rfl⟩
    refine ⟨selectedCosetAction q z, ?_, ?_⟩
    · exact Set.mem_smul_set.mpr ⟨z, hz, rfl⟩
    · exact (selectedCosetAmbientMap_coe q z).symm
  · rintro w ⟨z, hz, rfl⟩
    rcases Set.mem_smul_set.mp hz with ⟨u, hu, rfl⟩
    refine ⟨(u : ℂ), ⟨u, hu, rfl⟩, ?_⟩
    exact selectedCosetAmbientMap_coe q u

/-- Direct Bochner change of variables from the complex image of a selected
tile back to the base set.  This invokes Mathlib's Jacobian theorem with the
actual derivative `smulFDeriv`; it is not derived merely from abstract
invariance of hyperbolic measure. -/
theorem integral_complexImage_selectedCoset_smul_eq_jacobian
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (q : GammaTwoRightCoset) (s : Set ℍ) (hs : MeasurableSet s)
    (f : ℂ → E) :
    (∫ w in UpperHalfPlane.coe '' (gammaTwoCosetRep q • s),
        f w ∂(volume : Measure ℂ)) =
      ∫ w in UpperHalfPlane.coe '' s,
        |(UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) w).det| •
            f (selectedCosetAmbientMap q w)
        ∂(volume : Measure ℂ) := by
  rw [← selectedCosetAmbientMap_image_coe q s]
  exact MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul
    volume
    (UpperHalfPlane.measurableEmbedding_coe.measurableSet_image.mpr hs)
    (fun w hw => by
      rcases hw with ⟨z, hz, rfl⟩
      exact (selectedCosetAmbientMap_hasStrictFDerivAt q z).hasFDerivAt.hasFDerivWithinAt)
    (selectedCosetAmbientMap_injOn_coeImage q s) f

/-- Specialization to every actual selected half-open modular tile. -/
theorem integral_selectedHalfOpenTile_eq_jacobian
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (q : GammaTwoRightCoset) (f : ℂ → E) :
    (∫ w in UpperHalfPlane.coe ''
          (gammaTwoCosetRep q • modularHalfOpenTile),
        f w ∂(volume : Measure ℂ)) =
      ∫ w in UpperHalfPlane.coe '' modularHalfOpenTile,
        |(UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) w).det| •
            f (selectedCosetAmbientMap q w)
        ∂(volume : Measure ℂ) :=
  integral_complexImage_selectedCoset_smul_eq_jacobian
    q modularHalfOpenTile modularHalfOpenTile_measurable f

/-- The Euclidean divergence integral on an actual selected polygon tile is
the base-tile integral of the proved Piola divergence. -/
theorem integral_divergence_selectedHalfOpenTile_eq_piola
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) :
    (∫ w in UpperHalfPlane.coe ''
          (gammaTwoCosetRep q • modularHalfOpenTile),
        upperLift (fun z => dx X z + dy Y z) w
        ∂(volume : Measure ℂ)) =
      ∫ w in UpperHalfPlane.coe '' modularHalfOpenTile,
        upperLift (fun z =>
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z) w
        ∂(volume : Measure ℂ) := by
  rw [integral_selectedHalfOpenTile_eq_jacobian q
    (upperLift (fun z => dx X z + dy Y z))]
  apply setIntegral_congr_fun
    (UpperHalfPlane.measurableEmbedding_coe.measurableSet_image.mpr
      modularHalfOpenTile_measurable)
  rintro _w ⟨z, _hz, rfl⟩
  change
    |(UpperHalfPlane.smulFDeriv
        (selectedCosetGL q) (z : ℂ)).det| •
      upperLift (fun z => dx X z + dy Y z)
        (selectedCosetAmbientMap q (z : ℂ)) =
      upperLift (fun z =>
        dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z) (z : ℂ)
  simp only [selectedCosetAmbientMap_coe, upperLift_apply]
  change (selectedCosetJacobian q z : ℝ) •
      (dx X (selectedCosetAction q z) +
        dy Y (selectedCosetAction q z)) =
    dx (selectedCosetPiolaX q X Y) z +
      dy (selectedCosetPiolaY q X Y) z
  rw [Complex.real_smul]
  exact (divergence_selectedCosetPiola q hX hY z).symm

/-- Hyperbolic form of the same tile transport.  The two `height^2` factors
cancel the hyperbolic density on the source and target tiles via the proved
P3.4b conversion, while the middle equality is the genuine Möbius Jacobian
formula above. -/
theorem integral_heightSq_divergence_selectedHalfOpenTile_eq_basePiola
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) :
    (∫ z in gammaTwoCosetRep q • modularHalfOpenTile,
        heightC z ^ 2 * (dx X z + dy Y z)
        ∂hyperbolicMeasure) =
      ∫ z in modularHalfOpenTile,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure := by
  have hTile : MeasurableSet
      (gammaTwoCosetRep q • modularHalfOpenTile) := by
    change MeasurableSet
      (((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
        (gammaTwoCosetRep q)) • modularHalfOpenTile)
    exact MeasurableSet.const_smul modularHalfOpenTile_measurable
      ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
        (gammaTwoCosetRep q))
  calc
    (∫ z in gammaTwoCosetRep q • modularHalfOpenTile,
        heightC z ^ 2 * (dx X z + dy Y z)
        ∂hyperbolicMeasure) =
        ∫ w in UpperHalfPlane.coe ''
            (gammaTwoCosetRep q • modularHalfOpenTile),
          upperLift (fun z => dx X z + dy Y z) w
          ∂(volume : Measure ℂ) :=
      GammaTwoCurvilinearTileStokes.setIntegral_heightSq_mul_hyperbolic_eq_complexImage
          _ hTile _
    _ = ∫ w in UpperHalfPlane.coe '' modularHalfOpenTile,
        upperLift (fun z =>
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z) w
        ∂(volume : Measure ℂ) :=
      integral_divergence_selectedHalfOpenTile_eq_piola q hX hY
    _ = ∫ z in modularHalfOpenTile,
        heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure :=
      (GammaTwoCurvilinearTileStokes.setIntegral_heightSq_mul_hyperbolic_eq_complexImage
          _ modularHalfOpenTile_measurable _).symm

namespace AxiomAuditP3MoebiusPiola

#print axioms selectedCoset_smulFDeriv_apply
#print axioms selectedCosetAmbientMap_hasStrictFDerivAt
