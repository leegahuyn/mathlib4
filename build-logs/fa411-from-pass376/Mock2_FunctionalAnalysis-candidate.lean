namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P9ClosedFormRealization

open ComplexLaxMilgram
open scoped LinearPMap

noncomputable section

/-! ### A resolvent criterion with no self-adjointness certificate

For a densely defined symmetric operator, surjectivity of one real shift
already forces maximal symmetry.  The proof below does not appeal to an
external spectral theorem: an arbitrary vector in the adjoint domain is
compared with the preimage of its shifted adjoint value, and surjectivity is
used once more to test the difference against itself.
-/

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A densely defined symmetric partial operator with one surjective real
shift is self-adjoint.  The shift is written pointwise so the statement does
not conceal any domain equality in a bundled sum of partial operators. -/
theorem LinearPMap.isSelfAdjoint_of_realShift_surjective
    (A : H →ₗ.[ℂ] H)
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (c : ℝ)
    (hSurj : ∀ y : H, ∃ x : A.domain,
      (c : ℂ) • (x : H) + A x = y) :
    IsSelfAdjoint A := by
  rw [LinearPMap.isSelfAdjoint_def]
  have hMin : A ≤ A† := hSymm.le_adjoint hDense
  refine le_antisymm ?_ hMin
  refine ⟨?_, ?_⟩
  · intro y hy
    let yAdj : A†.domain := ⟨y, hy⟩
    obtain ⟨x, hx⟩ := hSurj (A† yAdj + (c : ℂ) • y)
    have hxy : (x : H) = y := by
      let d : H := y - (x : H)
      obtain ⟨z, hz⟩ := hSurj d
      have hAdjointPair :
          inner ℂ (A z) y = inner ℂ (z : H) (A† yAdj) := by
        exact (LinearPMap.adjoint_isFormalAdjoint hDense).symm z yAdj
      have hSymmetricPair :
          inner ℂ (A z) (x : H) = inner ℂ (z : H) (A x) :=
        hSymm z x
      have hShiftY :
          inner ℂ ((c : ℂ) • (z : H) + A z) y =
            inner ℂ (z : H) (A† yAdj + (c : ℂ) • y) := by
        rw [inner_add_left, inner_smul_left, hAdjointPair,
          inner_add_right, inner_smul_right, map_ofReal]
        ring
      have hShiftX :
          inner ℂ ((c : ℂ) • (z : H) + A z) (x : H) =
            inner ℂ (z : H) ((c : ℂ) • (x : H) + A x) := by
        rw [inner_add_left, inner_smul_left, hSymmetricPair,
          inner_add_right, inner_smul_right, map_ofReal]
        ring
      have hdd : inner ℂ d d = 0 := by
        calc
          inner ℂ d d =
              inner ℂ ((c : ℂ) • (z : H) + A z) d := by rw [hz]
          _ = inner ℂ ((c : ℂ) • (z : H) + A z) y -
                inner ℂ ((c : ℂ) • (z : H) + A z) (x : H) := by
              rw [d, inner_sub_right]
          _ = inner ℂ (z : H) (A† yAdj + (c : ℂ) • y) -
                inner ℂ (z : H) ((c : ℂ) • (x : H) + A x) := by
              rw [hShiftY, hShiftX]
          _ = 0 := by rw [hx]; exact sub_self _
      have hd : d = 0 := (inner_self_eq_zero (𝕜 := ℂ)).mp hdd
      exact (sub_eq_zero.mp hd).symm
    simpa only [← hxy] using x.property
  · intro y x hyx
    exact (hMin.2 hyx.symm).symm

/-! ### The operator represented by an embedded closed form -/

variable {V : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]

/-- Pullback of the ambient `H` inner product along a continuous form-domain
embedding.  This is the literal `L2` mass form, not the graph-space Riesz
pairing. -/
noncomputable def embeddedMassLinear (J : V →L[ℂ] H) :
    V →ₗ[ℂ] StrongAntiDual V where
  toFun u := (innerSLFlip ℂ (J u)).comp J
  map_add' u w := by
    ext v
    simp only [ContinuousLinearMap.comp_apply, map_add,
      innerSLFlip_apply_apply, inner_add_right]
  map_smul' a u := by
    ext v
    simp only [ContinuousLinearMap.comp_apply, map_smul,
      innerSLFlip_apply_apply, inner_smul_right]

@[simp]
theorem embeddedMassLinear_apply (J : V →L[ℂ] H) (u v : V) :
    embeddedMassLinear J u v = inner ℂ (J v) (J u) :=
  rfl

theorem embeddedMassLinear_bound (J : V →L[ℂ] H) (u v : V) :
    ‖embeddedMassLinear J u v‖ ≤ ‖J‖ ^ 2 * ‖u‖ * ‖v‖ := by
  calc
    ‖embeddedMassLinear J u v‖ = ‖inner ℂ (J v) (J u)‖ := rfl
    _ ≤ ‖J v‖ * ‖J u‖ := norm_inner_le_norm _ _
    _ ≤ (‖J‖ * ‖v‖) * (‖J‖ * ‖u‖) := by
      exact mul_le_mul (J.le_opNorm v) (J.le_opNorm u)
        (norm_nonneg _) (mul_nonneg (norm_nonneg J) (norm_nonneg v))
    _ = ‖J‖ ^ 2 * ‖u‖ * ‖v‖ := by ring

/-- The ambient mass pairing as a bounded trial-linear/test-antilinear form
on the complete form domain. -/
noncomputable def embeddedMassForm (J : V →L[ℂ] H) :
    ContinuousSesquilinearForm V :=
  (embeddedMassLinear J).mkContinuous₂ (‖J‖ ^ 2)
    (embeddedMassLinear_bound J)

@[simp]
theorem embeddedMassForm_apply (J : V →L[ℂ] H) (u v : V) :
    embeddedMassForm J u v = inner ℂ (J v) (J u) :=
  rfl

theorem embeddedMassForm_conj_symm (J : V →L[ℂ] H) (u v : V) :
    star (embeddedMassForm J v u) = embeddedMassForm J u v := by
  simp only [embeddedMassForm_apply, inner_conj_symm]

/-- Graph relation represented by a form `B` through the ambient embedding
`J`: `(J u, f)` belongs to the graph exactly when
`B u v = <J v,f>` for every form-domain test `v`. -/
noncomputable def associatedFormGraph
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V) :
    Submodule ℂ (H × H) where
  carrier := {p | ∃ u : V, J u = p.1 ∧
    ∀ v : V, B u v = inner ℂ (J v) p.2}
  zero_mem' := by
    refine ⟨0, by simp, ?_⟩
    intro v
    simp
  add_mem' := by
    rintro p q ⟨u, hu, hBu⟩ ⟨w, hw, hBw⟩
    refine ⟨u + w, by simp only [map_add, hu, hw, Prod.fst_add], ?_⟩
    intro v
    simp only [map_add, ContinuousLinearMap.add_apply, hBu v, hBw v,
      Prod.snd_add, inner_add_right]
  smul_mem' := by
    rintro a p ⟨u, hu, hBu⟩
    refine ⟨a • u, by simp only [map_smul, hu, Prod.fst_smul], ?_⟩
    intro v
    simp only [map_smul, ContinuousLinearMap.smul_apply, hBu v,
      Prod.snd_smul, inner_smul_right]

@[simp]
theorem mem_associatedFormGraph_iff
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V) (x f : H) :
    (x, f) ∈ associatedFormGraph J B ↔
      ∃ u : V, J u = x ∧ ∀ v : V, B u v = inner ℂ (J v) f :=
  Iff.rfl

/-- The represented graph is single-valued when the form embedding is
injective and has dense range. -/
theorem associatedFormGraph_fst_eq_zero_snd
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    {f : H} (hf : (0, f) ∈ associatedFormGraph J B) :
    f = 0 := by
  rcases hf with ⟨u, hu, hBu⟩
  have hu0 : u = 0 := hJinj (by simpa only [Prod.fst_zero] using hu)
  apply hJdense.eq_zero_of_inner_right
  intro v
  calc
    inner ℂ (J v) f = B u v := (hBu v).symm
    _ = B 0 v := by rw [hu0]
    _ = 0 := by simp

/-- The partially defined ambient Hilbert operator associated with the
embedded form.  Its domain is derived from representability; it is not
declared to be the whole form domain. -/
noncomputable def associatedFormOperator
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J) :
    H →ₗ.[ℂ] H :=
  (associatedFormGraph J B).toLinearPMap

theorem associatedFormOperator_graph_eq
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J) :
    (associatedFormOperator J B hJinj hJdense).graph =
      associatedFormGraph J B := by
  apply Submodule.toLinearPMap_graph_eq
  intro p hp hp0
  apply associatedFormGraph_fst_eq_zero_snd J B hJinj hJdense
  simpa only [hp0] using hp

theorem mem_associatedFormOperator_graph_iff
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    (x f : H) :
    (x, f) ∈ (associatedFormOperator J B hJinj hJdense).graph ↔
      ∃ u : V, J u = x ∧ ∀ v : V, B u v = inner ℂ (J v) f := by
  rw [associatedFormOperator_graph_eq]
  exact mem_associatedFormGraph_iff J B x f

/-! ### Lax--Milgram resolvent and maximal symmetry -/

/-- Hermitian symmetry in the argument order used by
`ContinuousSesquilinearForm`. -/
def IsHermitianForm (B : ContinuousSesquilinearForm V) : Prop :=
  ∀ u v : V, star (B v u) = B u v

/-- Add a real ambient-`L2` mass shift to a form. -/
noncomputable def embeddedShiftedForm
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V) (c : ℝ) :
    ContinuousSesquilinearForm V :=
  B + (c : ℂ) • embeddedMassForm J

@[simp]
theorem embeddedShiftedForm_apply
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (c : ℝ) (u v : V) :
    embeddedShiftedForm J B c u v =
      B u v + (c : ℂ) * inner ℂ (J v) (J u) := by
  simp only [embeddedShiftedForm, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, embeddedMassForm_apply, smul_eq_mul]

theorem embeddedShiftedForm_isHermitian
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hB : IsHermitianForm B) (c : ℝ) :
    IsHermitianForm (embeddedShiftedForm J B c) := by
  intro u v
  simp only [embeddedShiftedForm_apply, map_add, map_mul, map_ofReal,
    inner_conj_symm]
  rw [hB]

/-- Ambient right-hand side restricted to the form domain. -/
noncomputable def embeddedAntiDual
    (J : V →L[ℂ] H) (y : H) : StrongAntiDual V :=
  (innerSLFlip ℂ y).comp J

@[simp]
theorem embeddedAntiDual_apply
    (J : V →L[ℂ] H) (y : H) (v : V) :
    embeddedAntiDual J y v = inner ℂ (J v) y :=
  rfl

/-- Lax--Milgram solution of one real shifted form equation. -/
noncomputable def embeddedFormResolventSolution
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c))
    (y : H) : V :=
  solveWith α (embeddedShiftedForm J B c) hCoercive
    (embeddedAntiDual J y)

theorem embeddedFormResolventSolution_spec
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c))
    (y : H) (v : V) :
    embeddedShiftedForm J B c
        (embeddedFormResolventSolution J B c α hCoercive y) v =
      inner ℂ (J v) y := by
  exact solveWith_spec α (embeddedShiftedForm J B c) hCoercive
    (embeddedAntiDual J y) v

/-- The shifted form solution supplies a literal graph point for the
unshifted associated operator. -/
theorem embeddedFormResolventSolution_mem_associatedGraph
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c))
    (y : H) :
    let u := embeddedFormResolventSolution J B c α hCoercive y
    (J u, y - (c : ℂ) • J u) ∈ associatedFormGraph J B := by
  dsimp only
  let u := embeddedFormResolventSolution J B c α hCoercive y
  refine ⟨u, rfl, ?_⟩
  intro v
  have hs := embeddedFormResolventSolution_spec
    J B c α hCoercive y v
  rw [embeddedShiftedForm_apply] at hs
  calc
    B u v = inner ℂ (J v) y -
        (c : ℂ) * inner ℂ (J v) (J u) :=
      eq_sub_of_add_eq hs
    _ = inner ℂ (J v) (y - (c : ℂ) • J u) := by
      rw [inner_sub_right, inner_smul_right]

/-- Every ambient right-hand side has a preimage under the real shift of the
associated operator. -/
theorem associatedFormOperator_realShift_surjective
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c)) :
    ∀ y : H, ∃ x : (associatedFormOperator J B hJinj hJdense).domain,
      (c : ℂ) • (x : H) +
        associatedFormOperator J B hJinj hJdense x = y := by
  intro y
  let u := embeddedFormResolventSolution J B c α hCoercive y
  have hGraph :
      (J u, y - (c : ℂ) • J u) ∈
        (associatedFormOperator J B hJinj hJdense).graph := by
    rw [associatedFormOperator_graph_eq]
    exact embeddedFormResolventSolution_mem_associatedGraph
      J B c α hCoercive y
  rw [LinearPMap.mem_graph_iff] at hGraph
  obtain ⟨x, hx, hAx⟩ := hGraph
  refine ⟨x, ?_⟩
  rw [← hx, hAx]
  abel

/-- Hermitian symmetry of the form makes its represented partial operator
symmetric on the exact representability domain. -/
theorem associatedFormOperator_isFormalAdjoint
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    (hB : IsHermitianForm B) :
    (associatedFormOperator J B hJinj hJdense).IsFormalAdjoint
      (associatedFormOperator J B hJinj hJdense) := by
  intro x y
  have hxGraph :=
    (associatedFormOperator J B hJinj hJdense).mem_graph x
  have hyGraph :=
    (associatedFormOperator J B hJinj hJdense).mem_graph y
  rw [mem_associatedFormOperator_graph_iff] at hxGraph hyGraph
  obtain ⟨ux, hux, hBx⟩ := hxGraph
  obtain ⟨uy, huy, hBy⟩ := hyGraph
  calc
    inner ℂ (associatedFormOperator J B hJinj hJdense x) (y : H) =
        star
          (inner ℂ (y : H)
            (associatedFormOperator J B hJinj hJdense x)) :=
      inner_conj_symm _ _
    _ = star (B ux uy) := by rw [← huy, ← hBx]
    _ = B uy ux := hB uy ux
    _ = inner ℂ (x : H)
        (associatedFormOperator J B hJinj hJdense y) := by rw [← hux, hBy]

/-- The representability domain is dense.  This proof is part of the form
theorem: it uses the Hermitian Lax--Milgram resolvent twice and does not assume
density of the operator domain as an extra certificate. -/
theorem associatedFormOperator_dense_domain
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    (hB : IsHermitianForm B)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c)) :
    Dense ((associatedFormOperator J B hJinj hJdense).domain : Set H) := by
  rw [Submodule.dense_iff_topologicalClosure_eq_top]
  apply (Submodule.orthogonal_eq_bot_iff).mp
  rw [Submodule.eq_bot_iff]
  intro z hz
  have hzDomain : ∀ x : (associatedFormOperator J B hJinj hJdense).domain,
      inner ℂ (x : H) z = 0 := by
    intro x
    exact hz _ (Submodule.le_topologicalClosure _ x.property)
  let uz := embeddedFormResolventSolution J B c α hCoercive z
  have huzGraph := embeddedFormResolventSolution_mem_associatedGraph
    J B c α hCoercive z
  have huzOperatorGraph :
      (J uz, z - (c : ℂ) • J uz) ∈
        (associatedFormOperator J B hJinj hJdense).graph := by
    rw [associatedFormOperator_graph_eq]
    exact huzGraph
  rw [LinearPMap.mem_graph_iff] at huzOperatorGraph
  obtain ⟨xz, hxz, _⟩ := huzOperatorGraph
  have hJuzDomain : J uz ∈
      (associatedFormOperator J B hJinj hJdense).domain := by
    simpa only [← hxz] using xz.property
  have hShiftHermitian := embeddedShiftedForm_isHermitian J B hB c
  have hJuzOrthogonalAll : ∀ y : H, inner ℂ (J uz) y = 0 := by
    intro y
    let uy := embeddedFormResolventSolution J B c α hCoercive y
    have huyGraph := embeddedFormResolventSolution_mem_associatedGraph
      J B c α hCoercive y
    have huyOperatorGraph :
        (J uy, y - (c : ℂ) • J uy) ∈
          (associatedFormOperator J B hJinj hJdense).graph := by
      rw [associatedFormOperator_graph_eq]
      exact huyGraph
    rw [LinearPMap.mem_graph_iff] at huyOperatorGraph
    obtain ⟨xy, hxy, _⟩ := huyOperatorGraph
    have hJuyDomain : J uy ∈
        (associatedFormOperator J B hJinj hJdense).domain := by
      simpa only [← hxy] using xy.property
    have hzy : inner ℂ (J uy) z = 0 :=
      hzDomain ⟨J uy, hJuyDomain⟩
    have hSzUy := embeddedFormResolventSolution_spec
      J B c α hCoercive z uy
    have hSyUz := embeddedFormResolventSolution_spec
      J B c α hCoercive y uz
    calc
      inner ℂ (J uz) y = embeddedShiftedForm J B c uy uz := hSyUz.symm
      _ = star (embeddedShiftedForm J B c uz uy) :=
        (hShiftHermitian uy uz).symm
      _ = star (inner ℂ (J uy) z) := by rw [hSzUy]
      _ = 0 := by rw [hzy, map_zero]
  have hJuz : J uz = 0 := by
    apply (inner_self_eq_zero (𝕜 := ℂ)).mp
    exact hJuzOrthogonalAll (J uz)
  have huz : uz = 0 := hJinj (by simpa using hJuz)
  apply hJdense.eq_zero_of_inner_right
  intro v
  have hs := embeddedFormResolventSolution_spec
    J B c α hCoercive z v
  rw [huz, map_zero] at hs
  simpa using hs.symm

/-- First representation theorem for the present embedded-form interface:
the associated ambient partial operator is self-adjoint.  All hypotheses are
form-level facts that the concrete modular graph form proves below. -/
theorem associatedFormOperator_isSelfAdjoint
    (J : V →L[ℂ] H) (B : ContinuousSesquilinearForm V)
    (hJinj : Function.Injective J) (hJdense : DenseRange J)
    (hB : IsHermitianForm B)
    (c α : ℝ)
    (hCoercive : ComplexCoerciveWith α (embeddedShiftedForm J B c)) :
    IsSelfAdjoint (associatedFormOperator J B hJinj hJdense) := by
  apply LinearPMap.isSelfAdjoint_of_realShift_surjective
    (associatedFormOperator J B hJinj hJdense)
    (associatedFormOperator_dense_domain
      J B hJinj hJdense hB c α hCoercive)
    (associatedFormOperator_isFormalAdjoint
      J B hJinj hJdense hB)
    c
  exact associatedFormOperator_realShift_surjective
    J B hJinj hJdense c α hCoercive

/-! ### Actual modular closed-form realization

The abstract representation theorem is now instantiated on the literal
fixed-phase graph completion.  The pivot Hilbert space is the Petersson
`L²` completion, the form-domain embedding is the already constructed
`baseExtension`, and the form is the real-coupling scalar discriminant
Schrodinger form.  In particular, the mass shift below is the ambient
Petersson mass; it is not the graph-space Riesz mass.
-/

namespace ActualModularEndpoint

open HalfWeightDifferentialOperators
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open ExplicitDiscriminantPotential
open ExplicitDiscriminantPotential.FixedPhaseGraphPotential
open ActualScalarDiscriminantPDE

/-- The completed base coordinate is injective because the actual physical
raising/lowering pair is jointly closable. -/
theorem modularBaseEmbedding_injective (n : ℤ) :
    Function.Injective (baseExtension n) := by
  simpa only [baseExtension,
    QuotientHilbertCoordinates.JointlyClosable] using
    FixedPhaseClosedOperators.coordinates_jointlyClosable n

/-- The completed base coordinate has dense Petersson range.  Its range
contains the literal smooth Petersson core, which is already dense. -/
theorem modularBaseEmbedding_denseRange (n : ℤ) :
    DenseRange (baseExtension n) := by
  apply (FixedPhaseDensity.denseRange_l2Coordinate n).mono
  rintro _ ⟨u, rfl⟩
  exact ⟨coreMap n u, baseExtension_core n u⟩

/-! #### Hermitian symmetry of the completed discriminant form -/

/-- Hermitian symmetry survives completion in both graph variables.  The
proof uses the exact integral identity on the smooth core and two independent
density arguments; no pointwise representative of a completion vector is
introduced. -/
theorem graphPotentialOperator_conj_symm
    (n : ℤ) (u v : GraphSobolevCompletion n) :
    star (graphPotentialOperator n v u) =
      graphPotentialOperator n u v := by
  refine (denseRange_coreMap n).induction_on u
    (isClosed_eq
      (Complex.continuous_conj.comp
        (graphPotentialOperator n v).continuous)
      ((ContinuousLinearMap.apply' ℂ (starRingEnd ℂ) v).continuous.comp
        (graphPotentialOperator n).continuous)) ?_
  intro u₀
  refine (denseRange_coreMap n).induction_on v
    (isClosed_eq
      (Complex.continuous_conj.comp
        ((ContinuousLinearMap.apply' ℂ (starRingEnd ℂ)
          (coreMap n u₀)).continuous.comp
            (graphPotentialOperator n).continuous))
      (graphPotentialOperator n (coreMap n u₀)).continuous) ?_
  intro v₀
  rw [graphPotentialOperator_apply_core,
    graphPotentialOperator_apply_core]
  exact potentialForm_conj_symm
    (M := OrbitMultiplier n)
    GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v₀)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u₀)

/-- The actual weak Schrodinger form is Hermitian for every real coupling. -/
theorem weakSchrodingerOperator_isHermitian
    (n : ℤ) (t : ℝ) :
    IsHermitianForm (weakSchrodingerOperator n t) := by
  intro u v
  simp only [weakSchrodingerOperator_apply, map_sub, map_mul,
    map_ofReal, inner_conj_symm]
  rw [graphPotentialOperator_conj_symm]

/-! #### The literal Petersson mass shift -/

/-- Uniform real mass shift sufficient for an arbitrary real coupling. -/
noncomputable def discriminantMassShift (t : ℝ) : ℝ :=
  |t| * uniformBound

theorem discriminantMassShift_nonneg (t : ℝ) :
    0 ≤ discriminantMassShift t := by
  exact mul_nonneg (abs_nonneg t) uniformBound_pos.le

/-- The real part of the completed potential diagonal is controlled by the
literal base Petersson mass, rather than merely by the larger graph norm. -/
theorem abs_graphPotentialOperator_self_re_le_baseMass
    (n : ℤ) (u : GraphSobolevCompletion n) :
    |(graphPotentialOperator n u u).re| ≤
      uniformBound * ‖baseExtension n u‖ ^ 2 := by
  calc
    |(graphPotentialOperator n u u).re| ≤
        ‖graphPotentialOperator n u u‖ :=
      Complex.abs_re_le_norm _
    _ ≤ uniformBound * ‖baseExtension n u‖ *
          ‖baseExtension n u‖ := by
      rw [graphPotentialOperator_apply]
      exact peterssonPotentialOperator_bound
        (OrbitMultiplier n) (baseExtension n u) (baseExtension n u)
    _ = uniformBound * ‖baseExtension n u‖ ^ 2 := by ring

/-- The possibly negative potential contribution is absorbed exactly by the
chosen Petersson mass shift. -/
theorem coupling_re_le_discriminantMassShift_baseMass
    (n : ℤ) (t : ℝ) (u : GraphSobolevCompletion n) :
    t * (graphPotentialOperator n u u).re ≤
      discriminantMassShift t * ‖baseExtension n u‖ ^ 2 := by
  calc
    t * (graphPotentialOperator n u u).re ≤
        |t * (graphPotentialOperator n u u).re| :=
      le_abs_self _
    _ = |t| * |(graphPotentialOperator n u u).re| := by
      rw [abs_mul]
    _ ≤ |t| * (uniformBound * ‖baseExtension n u‖ ^ 2) :=
      mul_le_mul_of_nonneg_left
        (abs_graphPotentialOperator_self_re_le_baseMass n u)
        (abs_nonneg t)
    _ = discriminantMassShift t * ‖baseExtension n u‖ ^ 2 := by
      rw [discriminantMassShift]
      ring

/-- After adding the literal `L²` mass shift, the actual modular form is
coercive with sharp graph coefficient one. -/
theorem weakSchrodinger_embeddedMassShift_coercive
    (n : ℤ) (t : ℝ) :
    ComplexCoerciveWith 1
      (embeddedShiftedForm (baseExtension n)
        (weakSchrodingerOperator n t) (discriminantMassShift t)) := by
  refine ⟨zero_lt_one, ?_⟩
  intro u
  have hExpand :
      (embeddedShiftedForm (baseExtension n)
        (weakSchrodingerOperator n t) (discriminantMassShift t)
          u u).re =
        ‖u‖ ^ 2 - t * (graphPotentialOperator n u u).re +
          discriminantMassShift t * ‖baseExtension n u‖ ^ 2 := by
    simp only [embeddedShiftedForm_apply,
      weakSchrodingerOperator_apply, Complex.add_re, Complex.sub_re,
      Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      inner_self_eq_norm_sq, zero_mul, sub_zero]
    ring
  rw [one_mul, hExpand]
  linarith only
    [coupling_re_le_discriminantMassShift_baseMass n t u]

/-! #### The represented Petersson operator -/

/-- The actual unbounded Petersson operator represented by the completed
scalar discriminant form.  Its domain is the exact `L²`-representability
domain of the weak form. -/
noncomputable def modularAssociatedOperator (n : ℤ) (t : ℝ) :
    OrbitPeterssonHilbert n →ₗ.[ℂ] OrbitPeterssonHilbert n :=
  associatedFormOperator (baseExtension n)
    (weakSchrodingerOperator n t)
    (modularBaseEmbedding_injective n)
    (modularBaseEmbedding_denseRange n)

/-- Exact graph characterization of the represented modular operator. -/
theorem mem_modularAssociatedOperator_graph_iff
    (n : ℤ) (t : ℝ) (x f : OrbitPeterssonHilbert n) :
    (x, f) ∈ (modularAssociatedOperator n t).graph ↔
      ∃ u : GraphSobolevCompletion n,
        baseExtension n u = x ∧
          ∀ v : GraphSobolevCompletion n,
            inner ℂ v u -
                (t : ℂ) * graphPotentialOperator n u v =
              inner ℂ (baseExtension n v) f := by
  rw [modularAssociatedOperator,
    mem_associatedFormOperator_graph_iff]
  simp only [weakSchrodingerOperator_apply]

/-- Every Petersson datum is hit by the real shifted represented operator. -/
theorem modularAssociatedOperator_realShift_surjective
    (n : ℤ) (t : ℝ) :
    ∀ y : OrbitPeterssonHilbert n,
      ∃ x : (modularAssociatedOperator n t).domain,
        (discriminantMassShift t : ℂ) • (x : OrbitPeterssonHilbert n) +
          modularAssociatedOperator n t x = y := by
  simpa only [modularAssociatedOperator] using
    associatedFormOperator_realShift_surjective
      (baseExtension n) (weakSchrodingerOperator n t)
      (modularBaseEmbedding_injective n)
      (modularBaseEmbedding_denseRange n)
      (discriminantMassShift t) 1
      (weakSchrodinger_embeddedMassShift_coercive n t)

/-- The representability domain of the actual Petersson operator is dense. -/
theorem modularAssociatedOperator_dense_domain
    (n : ℤ) (t : ℝ) :
    Dense ((modularAssociatedOperator n t).domain :
      Set (OrbitPeterssonHilbert n)) := by
  exact associatedFormOperator_dense_domain
    (baseExtension n) (weakSchrodingerOperator n t)
    (modularBaseEmbedding_injective n)
    (modularBaseEmbedding_denseRange n)
    (weakSchrodingerOperator_isHermitian n t)
    (discriminantMassShift t) 1
    (weakSchrodinger_embeddedMassShift_coercive n t)

/-- The actual represented modular operator is symmetric on its exact
representability domain. -/
theorem modularAssociatedOperator_isFormalAdjoint
    (n : ℤ) (t : ℝ) :
    (modularAssociatedOperator n t).IsFormalAdjoint
      (modularAssociatedOperator n t) := by
  exact associatedFormOperator_isFormalAdjoint
    (baseExtension n) (weakSchrodingerOperator n t)
    (modularBaseEmbedding_injective n)
    (modularBaseEmbedding_denseRange n)
    (weakSchrodingerOperator_isHermitian n t)

/-- Final first-representation endpoint: for every orbit index and every real
coupling, the scalar discriminant form represents a self-adjoint Petersson
operator. -/
theorem modularAssociatedOperator_isSelfAdjoint
    (n : ℤ) (t : ℝ) :
    IsSelfAdjoint (modularAssociatedOperator n t) := by
  exact associatedFormOperator_isSelfAdjoint
    (baseExtension n) (weakSchrodingerOperator n t)
    (modularBaseEmbedding_injective n)
    (modularBaseEmbedding_denseRange n)
    (weakSchrodingerOperator_isHermitian n t)
    (discriminantMassShift t) 1
    (weakSchrodinger_embeddedMassShift_coercive n t)

/-- A self-adjoint partial operator has a closed graph. -/
theorem modularAssociatedOperator_isClosed
    (n : ℤ) (t : ℝ) :
    (modularAssociatedOperator n t).IsClosed :=
  (modularAssociatedOperator_isSelfAdjoint n t).isClosed

/-- Set-level closed-graph formulation of the same endpoint. -/
theorem modularAssociatedOperator_graph_isClosed
    (n : ℤ) (t : ℝ) :
    IsClosed ((modularAssociatedOperator n t).graph :
      Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert n)) :=
  modularAssociatedOperator_isClosed n t

end ActualModularEndpoint

end
end P9ClosedFormRealization
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
## P5.3: literal fixed-stage restriction on the physical carrier

The Rellich map must be the restriction of the *actual Euclidean Petersson
representative* to the genuine three-cusp stage.  It is not an abstract map
whose compactness is stored in a field.  This section constructs that map
directly with Mathlib's `LpToLpRestrictCLM` and records its representative,
linearity, and sharp contraction estimate.  The target measure is literally

`(volume.comap UpperHalfPlane.coe).restrict carrier | F_Y`.

Thus later Fourier charts have a fixed, checkable source and target.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5PhysicalHardStageRestriction

open Set Function Topology Filter MeasureTheory
open scoped ENNReal NNReal
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open GammaTwoQuotientGeometry
open FixedPhaseClosedOperators
open PhysicalLocalL2

/-- Euclidean carrier measure restricted to the literal three-cusp stage.
The repeated restriction is intentional: it makes the carrier and the
height truncation visible in the type. -/
noncomputable abbrev literalStageMeasure (Y : ℝ) : Measure ℍ :=
  chosenEuclideanCarrierMeasure.restrict
    (gammaTwoThreeCuspTruncation Y)

/-- Actual scalar `L2` space on one literal cusp-height stage. -/
noncomputable abbrev LiteralStageL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (literalStageMeasure Y)

/-- Restriction of the concrete Petersson representative to a literal stage. -/
noncomputable def peterssonLiteralStageRestriction (Y : ℝ) (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ] LiteralStageL2 Y :=
  (MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
    chosenEuclideanCarrierMeasure 2
    (gammaTwoThreeCuspTruncation Y)).comp
      (orbitPeterssonEuclideanEmbedding n)

/-- The genuine graph-to-stage map.  Only the base Petersson coordinate is
restricted; the two derivative coordinates remain available in the source
norm and will control its Fourier tail. -/
noncomputable def graphLiteralStageRestriction (Y : ℝ) (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] LiteralStageL2 Y :=
  (peterssonLiteralStageRestriction Y n).comp (baseExtension n)

@[simp]
theorem graphLiteralStageRestriction_apply (Y : ℝ) (n : ℤ)
    (x : GraphSobolevCompletion n) :
    graphLiteralStageRestriction Y n x =
      MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
        chosenEuclideanCarrierMeasure 2
        (gammaTwoThreeCuspTruncation Y)
        (orbitPeterssonEuclideanEmbedding n (baseExtension n x)) :=
  rfl

/-- The restricted `L2` class has the literal Euclidean-gauge representative
on the literal stage. -/
theorem coeFn_graphLiteralStageRestriction (Y : ℝ) (n : ℤ)
    (x : GraphSobolevCompletion n) :
    ⇑(graphLiteralStageRestriction Y n x) =ᵐ[literalStageMeasure Y]
      orbitPeterssonEuclideanEmbedding n (baseExtension n x) := by
  exact MeasureTheory.LpToLpRestrictCLM_coeFn ℂ
    (gammaTwoThreeCuspTruncation Y)
    (orbitPeterssonEuclideanEmbedding n (baseExtension n x))

/-- On the smooth graph core the hard-stage representative is exactly the
physical Euclidean gauge, with no selected representative for a completion
vector. -/
theorem coeFn_graphLiteralStageRestriction_core
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ⇑(graphLiteralStageRestriction Y n (coreMap n u)) =ᵐ[
        literalStageMeasure Y]
      fixedPhaseEuclideanGauge n u := by
  filter_upwards [
    coeFn_graphLiteralStageRestriction Y n (coreMap n u),
    (coeFn_embedding_l2Coordinate_fixedPhaseGauge n u).filter_mono
      (ae_mono Measure.restrict_le_self)] with z hzStage hzGauge
  rw [hzStage, baseExtension_core, hzGauge]

/-- Restriction is contractive before using any derivative information. -/
theorem norm_peterssonLiteralStageRestriction_le
    (Y : ℝ) (n : ℤ) (x : OrbitPeterssonHilbert n) :
    ‖peterssonLiteralStageRestriction Y n x‖ ≤ ‖x‖ := by
  calc
    ‖peterssonLiteralStageRestriction Y n x‖ ≤
        ‖orbitPeterssonEuclideanEmbedding n x‖ :=
      MeasureTheory.norm_Lp_toLp_restrict_le
        (gammaTwoThreeCuspTruncation Y)
        (orbitPeterssonEuclideanEmbedding n x)
    _ = ‖x‖ := orbitPeterssonEuclideanEmbedding_norm n x

/-- The literal graph restriction is a contraction for the exact three-term
graph norm. -/
theorem norm_graphLiteralStageRestriction_le
    (Y : ℝ) (n : ℤ) (x : GraphSobolevCompletion n) :
    ‖graphLiteralStageRestriction Y n x‖ ≤ ‖x‖ :=
  (norm_peterssonLiteralStageRestriction_le Y n (baseExtension n x)).trans
    (norm_baseExtension_le n x)

theorem norm_graphLiteralStageRestriction_opNorm_le_one
    (Y : ℝ) (n : ℤ) :
    ‖graphLiteralStageRestriction Y n‖ ≤ 1 := by
  apply (graphLiteralStageRestriction Y n).opNorm_le_bound zero_le_one
  intro x
  simpa only [one_mul] using norm_graphLiteralStageRestriction_le Y n x

/-- The literal stage is compact and measurable; both facts are exported at
the exact set used by the restriction map. -/
theorem literalStage_isCompact (Y : ℝ) :
    IsCompact (gammaTwoThreeCuspTruncation Y) :=
  gammaTwoThreeCuspTruncation_isCompact Y

theorem literalStage_measurableSet (Y : ℝ) :
    MeasurableSet (gammaTwoThreeCuspTruncation Y) :=
  (literalStage_isCompact Y).measurableSet

end P5PhysicalHardStageRestriction

namespace AxiomAuditP5PhysicalHardStageRestriction

#print axioms P5PhysicalHardStageRestriction.coeFn_graphLiteralStageRestriction_core
#print axioms P5PhysicalHardStageRestriction.norm_graphLiteralStageRestriction_le
#print axioms P5PhysicalHardStageRestriction.literalStage_isCompact

end AxiomAuditP5PhysicalHardStageRestriction
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
## P5.4: quantitative Fourier tails (operator-norm, not pointwise)

Strong convergence of Fourier partial sums on each fixed `L2` vector is not
Rellich compactness.  What is required is a bound uniform on the graph unit
ball.  The following small lemmas turn the exact estimate produced by the two
weak physical derivatives into operator-norm convergence.  They are kept
separate so a later chart proof cannot accidentally substitute pointwise
Parseval convergence for the uniform tail estimate.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5LocalFourierRellich

open Function Set Topology Filter MeasureTheory

section QuantitativeTail

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Uniform Fourier remainder estimate on a bounded map. -/
def HasQuantitativeFiniteModeTail
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2) (delta : ℕ → ℝ) : Prop :=
  (∀ N, 0 ≤ delta N) ∧
    ∀ N x,
      ‖finiteModeLocalization twoTorusFourierBasis (modes N) T x - T x‖ ≤
        delta N * ‖x‖

theorem opNorm_sub_le_of_quantitativeFiniteModeTail
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2) (delta : ℕ → ℝ)
    (h : HasQuantitativeFiniteModeTail modes T delta) (N : ℕ) :
    ‖finiteModeLocalization twoTorusFourierBasis (modes N) T - T‖ ≤
      delta N := by
  apply ContinuousLinearMap.opNorm_le_bound (h.1 N)
  intro x
  simpa only [ContinuousLinearMap.sub_apply] using h.2 N x

/-- A quantitative graph-unit-ball estimate with a vanishing scalar bound is
exactly the non-circular Fourier tail premise used in P5.1. -/
theorem hasVanishingFiniteModeTail_of_quantitative
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2) (delta : ℕ → ℝ)
    (h : HasQuantitativeFiniteModeTail modes T delta)
    (hdelta : Filter.Tendsto delta Filter.atTop (nhds 0)) :
    HasVanishingFiniteModeTail twoTorusFourierBasis modes T := by
  exact squeeze_zero
    (fun N ↦ norm_nonneg
      (finiteModeLocalization twoTorusFourierBasis (modes N) T - T))
    (fun N ↦ opNorm_sub_le_of_quantitativeFiniteModeTail
      modes T delta h N)
    hdelta

/-- Direct compactness endpoint for a genuine quantitative local Rellich
estimate. -/
theorem twoTorus_isCompactOperator_of_quantitativeTail
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2) (delta : ℕ → ℝ)
    (h : HasQuantitativeFiniteModeTail modes T delta)
    (hdelta : Filter.Tendsto delta Filter.atTop (nhds 0)) :
    IsCompactOperator T :=
  twoTorus_isCompactOperator_of_fourierTail modes T
    (hasVanishingFiniteModeTail_of_quantitative modes T delta h hdelta)

/-- The canonical `C/(N+1)` error scale. -/
noncomputable def reciprocalFourierTail (C : ℝ) (N : ℕ) : ℝ :=
  C / ((N : ℝ) + 1)

theorem reciprocalFourierTail_nonneg {C : ℝ} (hC : 0 ≤ C) (N : ℕ) :
    0 ≤ reciprocalFourierTail C N := by
  unfold reciprocalFourierTail
  positivity

theorem reciprocalFourierTail_tendsto_zero (C : ℝ) :
    Filter.Tendsto (reciprocalFourierTail C) Filter.atTop (nhds 0) := by
  simpa only [reciprocalFourierTail, div_eq_mul_inv, Nat.cast_add,
    Nat.cast_one, mul_zero] using
    tendsto_const_nhds.mul
      (tendsto_one_div_add_atTop_nhds_zero_nat :
        Filter.Tendsto (fun N : ℕ ↦ (1 : ℝ) / (N + 1)) Filter.atTop (nhds 0))

theorem twoTorus_isCompactOperator_of_reciprocalTail
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2) (C : ℝ) (hC : 0 ≤ C)
    (hTail : ∀ N x,
      ‖finiteModeLocalization twoTorusFourierBasis (modes N) T x - T x‖ ≤
        reciprocalFourierTail C N * ‖x‖) :
    IsCompactOperator T := by
  apply twoTorus_isCompactOperator_of_quantitativeTail
    modes T (reciprocalFourierTail C)
  · exact ⟨reciprocalFourierTail_nonneg hC, hTail⟩
  · exact reciprocalFourierTail_tendsto_zero C

end QuantitativeTail

end P5LocalFourierRellich

namespace AxiomAuditP5QuantitativeFourierTail

#print axioms P5LocalFourierRellich.hasVanishingFiniteModeTail_of_quantitative
#print axioms P5LocalFourierRellich.twoTorus_isCompactOperator_of_quantitativeTail
#print axioms P5LocalFourierRellich.twoTorus_isCompactOperator_of_reciprocalTail

end AxiomAuditP5QuantitativeFourierTail
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
## P10. Correction firewall: local cusp coordinates and false implications

This section replaces the paper's nonexistent global quotient `q`-radius by
one width-two coordinate at each named cusp, and records small unconditional
countermodels for analytic implications which cannot be used downstream.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoFundamentalDomain

open UpperHalfPlane

/-! ### P10.1. Genuine width-two local cusp parameters -/

/-- The complex coordinate obtained after moving the named cusp to infinity. -/
def gammaTwoLocalCuspCoordinate (κ : GammaTwoCusp) (z : ℍ) : ℂ :=
  (((gammaTwoCuspScaling κ)⁻¹ • z : ℍ) : ℂ)

@[simp]
theorem gammaTwoLocalCuspCoordinate_im
    (κ : GammaTwoCusp) (z : ℍ) :
    (gammaTwoLocalCuspCoordinate κ z).im = gammaTwoCuspHeight κ z := by
  simp [gammaTwoLocalCuspCoordinate, gammaTwoCuspHeight]

/-- In a scaled cusp coordinate, the stabilizer is literal translation by
`2n`.  This is the coordinate statement underlying height periodicity. -/
theorem gammaTwoLocalCuspCoordinate_translation
    (κ : GammaTwoCusp) (n : ℤ) (z : ℍ) :
    gammaTwoLocalCuspCoordinate κ (gammaTwoCuspTranslation κ n • z) =
      gammaTwoLocalCuspCoordinate κ z + (2 * n : ℤ) := by
  simp only [gammaTwoLocalCuspCoordinate, gammaTwoCuspTranslation,
    mul_smul, inv_smul_smul]
  rw [ModularGroup.coe_T_zpow_smul_eq]

/-- Exact transition matrix from the `κ`-coordinate to the `lam`-coordinate. -/
def gammaTwoCuspCoordinateTransition
    (κ lam : GammaTwoCusp) : SL(2, ℤ) :=
  (gammaTwoCuspScaling lam)⁻¹ * gammaTwoCuspScaling κ

/-- Cusp transport is a Mobius coordinate transition determined by the two
scaling matrices, not a transition of a quotient-global radius. -/
theorem gammaTwoLocalCuspCoordinate_transition
    (κ lam : GammaTwoCusp) (z : ℍ) :
    gammaTwoLocalCuspCoordinate lam z =
      (((gammaTwoCuspCoordinateTransition κ lam) •
        ((gammaTwoCuspScaling κ)⁻¹ • z) : ℍ) : ℂ) := by
  simp [gammaTwoLocalCuspCoordinate, gammaTwoCuspCoordinateTransition,
    mul_smul]

/-- The correct local parameter at a `Gamma(2)` cusp uses its width `2`. -/
noncomputable def gammaTwoLocalCuspQ (κ : GammaTwoCusp) (z : ℍ) : ℂ :=
  Function.Periodic.qParam 2 (gammaTwoLocalCuspCoordinate κ z)

/-- The local parameter at a second cusp is obtained by applying the exact
scaling-matrix transition before the same width-two exponential. -/
theorem gammaTwoLocalCuspQ_transition
    (κ lam : GammaTwoCusp) (z : ℍ) :
    gammaTwoLocalCuspQ lam z =
      Function.Periodic.qParam 2
        ((((gammaTwoCuspCoordinateTransition κ lam) •
          ((gammaTwoCuspScaling κ)⁻¹ • z) : ℍ) : ℂ)) := by
  rw [gammaTwoLocalCuspQ, gammaTwoLocalCuspCoordinate_transition]

/-- The ordinary exponential parameter of width two has complex period two. -/
theorem qParam_two_periodic :
    Function.Periodic (Function.Periodic.qParam 2) (2 : ℂ) := by
  intro w
  unfold Function.Periodic.qParam
  have harg :
      (2 : ℂ) * (Real.pi : ℂ) * Complex.I * (w + 2) / 2 =
        (2 : ℂ) * (Real.pi : ℂ) * Complex.I * w / 2 +
          2 * (Real.pi : ℂ) * Complex.I := by
    ring
  rw [harg, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]

/-- The local parameter descends through the complete width-two cusp
stabilizer.  No invariance under unrelated `Gamma(2)` elements is claimed. -/
theorem gammaTwoLocalCuspQ_translation
    (κ : GammaTwoCusp) (n : ℤ) (z : ℍ) :
    gammaTwoLocalCuspQ κ (gammaTwoCuspTranslation κ n • z) =
      gammaTwoLocalCuspQ κ z := by
  rw [gammaTwoLocalCuspQ, gammaTwoLocalCuspCoordinate_translation]
  simpa [Int.cast_mul, mul_comm] using
    ((qParam_two_periodic.int_mul n)
      (gammaTwoLocalCuspCoordinate κ z))

/-- Every local cusp parameter lies strictly inside the unit disk. -/
theorem gammaTwoLocalCuspQ_norm_lt_one
    (κ : GammaTwoCusp) (z : ℍ) :
    ‖gammaTwoLocalCuspQ κ z‖ < 1 := by
  simpa [gammaTwoLocalCuspQ, gammaTwoLocalCuspCoordinate] using
    (UpperHalfPlane.norm_qParam_lt_one 2
      ((gammaTwoCuspScaling κ)⁻¹ • z))

/-- A local cusp parameter never vanishes at a point of the upper half-plane;
the missing value `0` is the added cusp point. -/
theorem gammaTwoLocalCuspQ_ne_zero
    (κ : GammaTwoCusp) (z : ℍ) :
    gammaTwoLocalCuspQ κ z ≠ 0 := by
  exact Function.Periodic.qParam_ne_zero _

/-- Consequently there is no interior `|q_κ| = 1` interface. -/
theorem gammaTwoLocalCuspQ_norm_ne_one
    (κ : GammaTwoCusp) (z : ℍ) :
    ‖gammaTwoLocalCuspQ κ z‖ ≠ 1 :=
  ne_of_lt (gammaTwoLocalCuspQ_norm_lt_one κ z)

/-- The exact radius formula is governed by the selected local height. -/
theorem gammaTwoLocalCuspQ_norm
    (κ : GammaTwoCusp) (z : ℍ) :
    ‖gammaTwoLocalCuspQ κ z‖ =
      Real.exp (-Real.pi * gammaTwoCuspHeight κ z) := by
  rw [gammaTwoLocalCuspQ, Function.Periodic.norm_qParam]
  simp only [gammaTwoLocalCuspCoordinate_im]
  congr 1
  ring

end Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoFundamentalDomain

namespace Mock2FA.PaperCorrections

open MeasureTheory Set Filter

/-! The manuscript's quotient-global radius construction is retained only
through these explicitly refuted regression lemmas.  None of the functional
analysis below depends on this namespace. -/
namespace RefutedGlobalQModel

/-- The concrete `Gamma(2)` witness against a global q-coordinate. -/
theorem qParam_not_quotientInvariant :
    Function.Periodic.qParam 1 (UpperHalfPlane.I : ℂ) ≠
      Function.Periodic.qParam 1
        ((gammaTwoHyperbolic • UpperHalfPlane.I : ℍ) : ℂ) :=
  qParam_not_GammaTwo_invariant

/-- The proposed radius fiber is either the whole solution set or empty,
because its radius equation does not involve the alleged solution. -/
theorem radiusFiber_eq_solution_or_empty
    {T R U : Type*} (π : T → R) (Sol : Set U) (τ : T) (r : R) :
    claimedRadiusFiber π Sol τ r = Sol ∨
      claimedRadiusFiber π Sol τ r = ∅ := by
  by_cases h : π τ = r
  · exact Or.inl (claimedRadiusFiber_eq_solution π Sol τ r h)
  · exact Or.inr (claimedRadiusFiber_eq_empty π Sol τ r h)

end RefutedGlobalQModel

/-! ### P10.2. There is no interior global-q radius interface -/

/-- The usual width-one upper-half-plane parameter is strictly inside the
unit disk at every interior point, independently of quotient issues. -/
theorem upperHalfPlane_qParam_norm_lt_one (z : ℍ) :
    ‖Function.Periodic.qParam 1 (z : ℂ)‖ < 1 := by
  simpa using UpperHalfPlane.norm_qParam_lt_one 1 z

/-- Thus the proposed interior region `|q| ≥ 1` is empty. -/
theorem no_upperHalfPlane_point_with_qParam_norm_ge_one :
    ¬ ∃ z : ℍ, 1 ≤ ‖Function.Periodic.qParam 1 (z : ℂ)‖ := by
  rintro ⟨z, hz⟩
  exact (not_lt_of_ge hz) (upperHalfPlane_qParam_norm_lt_one z)

/-! ### P10.3. Pointwise unitarity does not imply scattering positivity -/

/-- The value and first derivative of a scalar scattering factor at one
spectral point.  Pointwise unitarity constrains only `value`. -/
structure ScalarScatteringJet where
  value : ℂ
  derivative : ℂ
  value_unitary : ‖value‖ = 1

/-- The constant unitary scattering factor has zero derivative. -/
def constantUnitaryScatteringJet : ScalarScatteringJet where
  value := 1
  derivative := 0
  value_unitary := norm_one

/-- Scalar version of the real part of `S'(s) S(s)⁻¹`. -/
noncomputable def ScalarScatteringJet.logDerivativeReal
    (J : ScalarScatteringJet) : ℝ :=
  (J.derivative * J.value⁻¹).re

@[simp]
theorem constantUnitaryScatteringJet_logDerivativeReal :
    constantUnitaryScatteringJet.logDerivativeReal = 0 := by
  simp [ScalarScatteringJet.logDerivativeReal,
    constantUnitaryScatteringJet]

/-- A universal strict-positivity conclusion from pointwise unitarity is
false, already in rank one. -/
theorem unitary_scattering_does_not_force_positive_logDerivative :
    ¬ ∀ J : ScalarScatteringJet, 0 < J.logDerivativeReal := by
  intro h
  simpa using h constantUnitaryScatteringJet

/-! ### P10.4. Nonnegativity is not a quantitative mass gap -/

/-- A nonnegative activity model with a zero. -/
def nonnegativeActivityWithoutGap (x : ℝ) : ℝ :=
  x ^ 2

theorem nonnegativeActivityWithoutGap_nonneg (x : ℝ) :
    0 ≤ nonnegativeActivityWithoutGap x := by
  exact sq_nonneg x

/-- Pointwise nonnegativity alone supplies no strictly positive uniform lower
bound. -/
theorem nonnegativeActivityWithoutGap_has_no_uniform_positive_lowerBound :
    ¬ ∃ ε : ℝ, 0 < ε ∧
      ∀ x : ℝ, ε ≤ nonnegativeActivityWithoutGap x := by
  rintro ⟨ε, hε, hbound⟩
  have hzero := hbound 0
  simp [nonnegativeActivityWithoutGap] at hzero
  exact (not_lt_of_ge hzero) hε

/-! ### P10.5. A parameter-dependent exponent cannot be absorbed in a
constant -/

/-- Quadratic growth cannot be bounded by one parameter-independent constant
times linear growth.  Substituting `x = (mn)^(1/4)` is exactly the algebraic
obstruction to replacing `(mn)^(1/2)` by `(mn)^(1/4)` inside a constant. -/
theorem quadratic_growth_not_uniformly_absorbed_by_linear :
    ¬ ∃ C : ℝ, 0 ≤ C ∧
      ∀ x : ℝ, 0 ≤ x → x ^ 2 ≤ C * x := by
  rintro ⟨C, hC, hbound⟩
  have hx : 0 ≤ C + 1 := by linarith
  have h := hbound (C + 1) hx
  nlinarith

/-! ### P10.6. Holomorphic admissibility excludes nonzero compact tents -/

/-- An entire test function which vanishes on one full neighborhood is the
zero function.  Hence a nonzero compactly supported tent on the real spectral
axis cannot simultaneously be used as an entire Kuznetsov test function. -/
theorem entire_test_eq_zero_of_eventually_zero
    (f : ℂ → ℂ) (hf : AnalyticOnNhd ℂ f Set.univ)
    {z₀ : ℂ} (hzero : f =ᶠ[nhds z₀] (0 : ℂ → ℂ)) :
    f = 0 := by
  have hzeroAnalytic :
      AnalyticOnNhd ℂ (0 : ℂ → ℂ) Set.univ := by
    simpa using
      (analyticOnNhd_const :
        AnalyticOnNhd ℂ (fun _ : ℂ => (0 : ℂ)) Set.univ)
  exact hf.eq_of_eventuallyEq hzeroAnalytic hzero

/-! ### P10.7. Exact Rankin--Selberg origin threshold -/

/-- Near the origin, the power `y^(β-2)` is integrable exactly for `β > 1`.
This is the precise parameter restriction hidden by a formal `Γ(β-1)` term. -/
theorem rankin_origin_power_integrable_iff
    {β T : ℝ} (hT : 0 < T) :
    IntegrableOn (fun y : ℝ => y ^ (β - 2)) (Set.Ioo 0 T) ↔
      1 < β := by
  rw [intervalIntegral.integrableOn_Ioo_rpow_iff hT]
  linarith

/-- The endpoint `β = 1` is not locally integrable at the origin. -/
theorem rankin_beta_one_origin_power_not_integrable
    {T : ℝ} (hT : 0 < T) :
    ¬ IntegrableOn (fun y : ℝ => y ^ ((1 : ℝ) - 2))
      (Set.Ioo 0 T) := by
  intro h
  have hbad := (rankin_origin_power_integrable_iff
    (β := (1 : ℝ)) hT).mp h
  linarith

/-- For `β > 1`, the standard exponentially damped Gamma integrand is
genuinely integrable on the whole positive ray. -/
theorem rankin_damped_integrable_of_one_lt_beta
    {β : ℝ} (hβ : 1 < β) :
    IntegrableOn
      (fun y : ℝ => Real.exp (-y) * y ^ (β - 2))
      (Set.Ioi 0) := by
  convert Real.GammaIntegral_convergent (s := β - 1) (by linarith) using 1 <;>
    ring

end Mock2FA.PaperCorrections

/-!
### P7/P12.6: finite-dimensional kernel and cokernel

This layer does not use a compact-adjoint theorem.  Instead it proves finite
codimension directly: on `range (I - K)ᗮ` the compact map `K` is bounded
below by one.  Hence the closed unit ball of that orthogonal complement is
totally bounded.  The shifted equivalence then injects the adjoint kernel of
the original operator into this finite-dimensional space.
-/

namespace Mock2FA.PaperCorrections.FredholmBypass

open Module End

section CompactMultiplicity

variable {X : Type*}
variable [NormedAddCommGroup X] [InnerProductSpace ℂ X] [CompleteSpace X]

/-- Every nonzero eigenspace of a compact endomorphism is finite-dimensional.
This is the part of the compact spectral theorem needed for the Fredholm
kernel; no self-adjointness hypothesis is involved. -/
theorem compactOperator_eigenspace_finiteDimensional
    (K : X →L[ℂ] X) (hK : IsCompactOperator K)
    (μ : ℂ) (hμ : μ ≠ 0) :
    FiniteDimensional ℂ (eigenspace K.toLinearMap μ) := by
  replace hK := hK.restrict'
    ((mem_invtSubmodule_iff_forall_mem_of_mem _).mp
      (eigenspace_mem_invtSubmodule K.toLinearMap μ))
  rw [restrict_eigenspace, LinearMap.coe_smul,
    IsCompactOperator.smul_iff₀ hμ] at hK
  rwa [← isCompactOperator_id_iff_finiteDimensional]

/-- The kernel of `I - K` is exactly the fixed-vector eigenspace of `K`. -/
theorem fredholmDefect_ker_eq_eigenspace_one (K : X →L[ℂ] X) :
    (fredholmDefect K).ker = eigenspace K.toLinearMap 1 := by
  ext u
  simp only [LinearMap.mem_ker, mem_eigenspace_iff,
    fredholmDefect_apply, one_smul]
  exact sub_eq_zero.trans eq_comm

/-- A compact perturbation of the identity has finite-dimensional kernel. -/
theorem fredholmDefect_kernel_finiteDimensional
    (K : X →L[ℂ] X) (hK : IsCompactOperator K) :
    FiniteDimensional ℂ (fredholmDefect K).ker := by
  rw [fredholmDefect_ker_eq_eigenspace_one K]
  exact compactOperator_eigenspace_finiteDimensional K hK 1 one_ne_zero

/-- On the orthogonal complement of `range (I-K)`, the compact part `K` is
bounded below by the identity.  This elementary estimate replaces any appeal
to compactness of the adjoint. -/
theorem norm_le_compact_apply_of_mem_fredholmDefect_range_orthogonal
    (K : X →L[ℂ] X)
    (u : (fredholmDefect K).rangeᗮ) :
    ‖(u : X)‖ ≤ ‖K (u : X)‖ := by
  by_cases hu : (u : X) = 0
  · simp [hu]
  have horth :
      ⟪fredholmDefect K (u : X), (u : X)⟫_ℂ = 0 :=
    (fredholmDefect K).range.inner_right_of_mem_orthogonal
      ⟨(u : X), rfl⟩ u.property
  have hinner :
      ⟪(u : X), (u : X)⟫_ℂ =
        ⟪K (u : X), (u : X)⟫_ℂ := by
    rw [fredholmDefect_apply, inner_sub_left, sub_eq_zero] at horth
    exact horth
  have hprod :
      ‖(u : X)‖ * ‖(u : X)‖ ≤
        ‖K (u : X)‖ * ‖(u : X)‖ := by
    calc
      ‖(u : X)‖ * ‖(u : X)‖ =
          (⟪(u : X), (u : X)⟫_ℂ).re :=
        (inner_self_eq_norm_mul_norm (𝕜 := ℂ) (u : X)).symm
      _ = (⟪K (u : X), (u : X)⟫_ℂ).re :=
        congrArg Complex.re hinner
      _ ≤ ‖K (u : X)‖ * ‖(u : X)‖ :=
        real_inner_le_norm _ _
  exact (mul_le_mul_right (norm_pos_iff.mpr hu)).mp hprod

/-- The restriction of `K` used to control the normalized cokernel. -/
noncomputable def compactCokernelControl (K : X →L[ℂ] X) :
    (fredholmDefect K).rangeᗮ →L[ℂ] X :=
  K.comp (fredholmDefect K).rangeᗮ.subtypeL

@[simp]
theorem compactCokernelControl_apply
    (K : X →L[ℂ] X) (u : (fredholmDefect K).rangeᗮ) :
    compactCokernelControl K u = K (u : X) :=
  rfl

/-- The normalized Hilbert cokernel `range (I-K)ᗮ` is finite-dimensional.
The proof is quantitative: compactness gives a totally bounded image of the
unit ball, while the previous norm inequality makes the restriction a
uniform embedding and pulls total boundedness back. -/
theorem fredholmDefect_rangeOrthogonal_finiteDimensional
    (K : X →L[ℂ] X) (hK : IsCompactOperator K) :
    FiniteDimensional ℂ (fredholmDefect K).rangeᗮ := by
  let R : (fredholmDefect K).rangeᗮ →L[ℂ] X :=
    compactCokernelControl K
  have hRcompact : IsCompactOperator R := by
    dsimp only [R, compactCokernelControl]
    exact hK.comp_clm (fredholmDefect K).rangeᗮ.subtypeL
  have hRbound : ∀ u, ‖u‖ ≤ (1 : ℝ≥0) * ‖R u‖ := by
    intro u
    simpa only [one_mul, R, compactCokernelControl_apply] using
      norm_le_compact_apply_of_mem_fredholmDefect_range_orthogonal K u
  have hRembedding : IsUniformEmbedding R :=
    R.isUniformEmbedding_of_bound hRbound
  have hImageTotallyBounded :
      TotallyBounded
        (R '' Metric.closedBall
          (0 : (fredholmDefect K).rangeᗮ) 1) :=
    ((hRcompact.isCompact_closure_image_closedBall 1).totallyBounded).subset
      subset_closure
  have hBallTotallyBounded :
      TotallyBounded
        (Metric.closedBall (0 : (fredholmDefect K).rangeᗮ) 1) :=
    (totallyBounded_image_iff hRembedding.isUniformInducing).mp
      hImageTotallyBounded
  exact FiniteDimensional.of_totallyBounded_nhds_zero ℂ
    (Metric.closedBall_mem_nhds
      (0 : (fredholmDefect K).rangeᗮ) zero_lt_one)
    hBallTotallyBounded

/-- The adjoint kernel of `I-K` is finite-dimensional.  It is exactly the
orthogonal complement of the range, so this conclusion does not require a
compact-adjoint API. -/
theorem fredholmDefect_adjointKernel_finiteDimensional
    (K : X →L[ℂ] X) (hK : IsCompactOperator K) :
    FiniteDimensional ℂ
      (ContinuousLinearMap.adjoint (fredholmDefect K)).ker := by
  rw [← (fredholmDefect K).orthogonal_range]
  exact fredholmDefect_rangeOrthogonal_finiteDimensional K hK

end CompactMultiplicity

section ShiftedFiniteFredholm

variable {V W : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]
variable [NormedAddCommGroup W] [InnerProductSpace ℂ W] [CompleteSpace W]
variable {A : V →L[ℂ] W}

namespace ShiftedCompactDecomposition

/-- The original kernel and normalized `I-K` kernel are the same submodule,
not merely pointwise logically equivalent. -/
theorem kernel_eq_fredholmDefect_kernel
    (d : ShiftedCompactDecomposition A) :
    A.ker =
      (fredholmDefect d.compactPerturbation).ker := by
  ext u
  simp only [LinearMap.mem_ker]
  exact (d.defect_eq_zero_iff u).symm

/-- The kernel of every compactly preconditioned operator is
finite-dimensional. -/
theorem kernel_finiteDimensional
    (d : ShiftedCompactDecomposition A) :
    FiniteDimensional ℂ A.ker := by
  rw [d.kernel_eq_fredholmDefect_kernel]
  exact fredholmDefect_kernel_finiteDimensional d.compactPerturbation
    d.compactPerturbation_isCompact

/-- Adjoint of the exact factorization `A = S (I-K)`. -/
theorem adjoint_factorization
    (d : ShiftedCompactDecomposition A) :
    (ContinuousLinearMap.adjoint
        (fredholmDefect d.compactPerturbation)).comp
      (ContinuousLinearMap.adjoint
        d.shiftedEquiv.toContinuousLinearMap) =
      ContinuousLinearMap.adjoint A := by
  calc
    (ContinuousLinearMap.adjoint
        (fredholmDefect d.compactPerturbation)).comp
        (ContinuousLinearMap.adjoint
          d.shiftedEquiv.toContinuousLinearMap) =
        ContinuousLinearMap.adjoint
          (d.shiftedEquiv.toContinuousLinearMap.comp
            (fredholmDefect d.compactPerturbation)) :=
      (ContinuousLinearMap.adjoint_comp
        d.shiftedEquiv.toContinuousLinearMap
        (fredholmDefect d.compactPerturbation)).symm
    _ = ContinuousLinearMap.adjoint A :=
      congrArg ContinuousLinearMap.adjoint d.factorization

/-- The adjoint of the shifted equivalence is injective.  This follows from
surjectivity of the equivalence and `range(S)ᗮ = ker(S†)`. -/
theorem shiftedEquiv_adjoint_injective
    (d : ShiftedCompactDecomposition A) :
    Function.Injective
      (ContinuousLinearMap.adjoint
        d.shiftedEquiv.toContinuousLinearMap) := by
  apply LinearMap.ker_eq_bot.mp
  rw [← d.shiftedEquiv.toContinuousLinearMap.orthogonal_range]
  have hRange :
      d.shiftedEquiv.toContinuousLinearMap.range = ⊤ :=
    LinearMap.range_eq_top.mpr d.shiftedEquiv.surjective
  rw [hRange, Submodule.top_orthogonal_eq_bot]

/-- The adjoint kernel of `A` maps into the adjoint kernel of its normalized
defect by applying `S†`. -/
noncomputable def adjointKernelToNormalizedAdjointKernel
    (d : ShiftedCompactDecomposition A) :
    (ContinuousLinearMap.adjoint A).ker →L[ℂ]
      (ContinuousLinearMap.adjoint
        (fredholmDefect d.compactPerturbation)).ker :=
  ((ContinuousLinearMap.adjoint
      d.shiftedEquiv.toContinuousLinearMap).comp
      (ContinuousLinearMap.adjoint A).ker.subtypeL).codRestrict
    (ContinuousLinearMap.adjoint
      (fredholmDefect d.compactPerturbation)).ker
    (fun w => by
      change
        ((ContinuousLinearMap.adjoint
            (fredholmDefect d.compactPerturbation)).comp
          (ContinuousLinearMap.adjoint
            d.shiftedEquiv.toContinuousLinearMap)) (w : W) = 0
      rw [d.adjoint_factorization]
      exact w.property)

@[simp]
theorem adjointKernelToNormalizedAdjointKernel_apply
    (d : ShiftedCompactDecomposition A)
    (w : (ContinuousLinearMap.adjoint A).ker) :
    ((d.adjointKernelToNormalizedAdjointKernel w :
        (ContinuousLinearMap.adjoint
          (fredholmDefect d.compactPerturbation)).ker) : V) =
      ContinuousLinearMap.adjoint
        d.shiftedEquiv.toContinuousLinearMap (w : W) :=
  rfl

/-- The preceding kernel map is injective. -/
theorem adjointKernelToNormalizedAdjointKernel_injective
    (d : ShiftedCompactDecomposition A) :
    Function.Injective d.adjointKernelToNormalizedAdjointKernel := by
  intro x y hxy
  apply Subtype.ext
  apply d.shiftedEquiv_adjoint_injective
  exact congrArg Subtype.val hxy

/-- The adjoint kernel, equivalently the Hilbert cokernel, of every compactly
preconditioned operator is finite-dimensional. -/
theorem adjointKernel_finiteDimensional
    (d : ShiftedCompactDecomposition A) :
    FiniteDimensional ℂ (ContinuousLinearMap.adjoint A).ker := by
  letI : FiniteDimensional ℂ
      (ContinuousLinearMap.adjoint
        (fredholmDefect d.compactPerturbation)).ker :=
    fredholmDefect_adjointKernel_finiteDimensional
      d.compactPerturbation d.compactPerturbation_isCompact
  exact FiniteDimensional.of_injective
    d.adjointKernelToNormalizedAdjointKernel.toLinearMap
    d.adjointKernelToNormalizedAdjointKernel_injective

/-- The Hilbert-space cokernel model is the orthogonal complement of the
actual range. -/
noncomputable abbrev HilbertCokernel (A : V →L[ℂ] W) := A.rangeᗮ

/-- The Hilbert cokernel is exactly the adjoint kernel. -/
theorem hilbertCokernel_eq_adjointKernel
    (d : ShiftedCompactDecomposition A) :
    HilbertCokernel A = (ContinuousLinearMap.adjoint A).ker :=
  A.orthogonal_range

/-- The Hilbert cokernel is finite-dimensional. -/
theorem hilbertCokernel_finiteDimensional
    (d : ShiftedCompactDecomposition A) :
    FiniteDimensional ℂ (HilbertCokernel A) := by
  rw [d.hilbertCokernel_eq_adjointKernel]
  exact d.adjointKernel_finiteDimensional

/-- The algebraic cokernel used in the finite Fredholm statement. -/
abbrev FredholmCokernel (A : V →L[ℂ] W) := W ⧸ A.range

/-- Orthogonal representatives map canonically to the algebraic cokernel. -/
noncomputable def rangeOrthogonalToCokernel
    (d : ShiftedCompactDecomposition A) :
    HilbertCokernel A →ₗ[ℂ] FredholmCokernel A :=
  A.range.mkQ.comp A.rangeᗮ.subtype

/-- Every cokernel class has an orthogonal representative because the actual
range is closed. -/
theorem rangeOrthogonalToCokernel_surjective
    (d : ShiftedCompactDecomposition A) :
    Function.Surjective d.rangeOrthogonalToCokernel := by
  letI : CompleteSpace A.range := d.range_isClosed.completeSpace_coe
  intro q
  rcases A.range.mkQ_surjective q with ⟨w, rfl⟩
  obtain ⟨p, hp, z, hz, hw⟩ :=
    A.range.exists_add_mem_mem_orthogonal w
  refine ⟨⟨z, hz⟩, ?_⟩
  change A.range.mkQ z = A.range.mkQ w
  have hp0 : A.range.mkQ p = 0 := by
    simpa only [Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] using hp
  calc
    A.range.mkQ z = A.range.mkQ (p + z) := by
      rw [map_add, hp0, zero_add]
    _ = A.range.mkQ w := by rw [hw]

/-- The genuine quotient cokernel is finite-dimensional, not only its
orthogonal Hilbert representative. -/
theorem cokernel_finiteDimensional
    (d : ShiftedCompactDecomposition A) :
    FiniteDimensional ℂ (FredholmCokernel A) := by
  letI : FiniteDimensional ℂ (HilbertCokernel A) :=
    d.hilbertCokernel_finiteDimensional
  exact FiniteDimensional.of_surjective d.rangeOrthogonalToCokernel
    d.rangeOrthogonalToCokernel_surjective

end ShiftedCompactDecomposition

namespace NontrivialKernelFredholmData

/-- General Fredholm data have finite-dimensional kernel. -/
theorem kernel_finiteDimensional
    (d : NontrivialKernelFredholmData A) :
    FiniteDimensional ℂ A.ker :=
  d.toShiftedCompactDecomposition.kernel_finiteDimensional

/-- General Fredholm data have finite-dimensional adjoint kernel. -/
theorem adjointKernel_finiteDimensional
    (d : NontrivialKernelFredholmData A) :
    FiniteDimensional ℂ (ContinuousLinearMap.adjoint A).ker :=
  d.toShiftedCompactDecomposition.adjointKernel_finiteDimensional

/-- General Fredholm data have finite-dimensional Hilbert cokernel. -/
theorem hilbertCokernel_finiteDimensional
    (d : NontrivialKernelFredholmData A) :
    FiniteDimensional ℂ
      (ShiftedCompactDecomposition.HilbertCokernel A) :=
  d.toShiftedCompactDecomposition.hilbertCokernel_finiteDimensional

/-- General Fredholm data have finite-dimensional algebraic quotient
cokernel. -/
theorem cokernel_finiteDimensional
    (d : NontrivialKernelFredholmData A) :
    FiniteDimensional ℂ
      (ShiftedCompactDecomposition.FredholmCokernel A) :=
  d.toShiftedCompactDecomposition.cokernel_finiteDimensional

end NontrivialKernelFredholmData

end ShiftedFiniteFredholm

end Mock2FA.PaperCorrections.FredholmBypass

