/-!
## P11: unconditional analytic and finite-arithmetic foundations

This fragment deliberately stops short of asserting a half-integral-weight
Kuznetsov or Eisenstein--Plancherel formula.  It supplies objects which can be
constructed from the currently imported Mathlib API:

* a nonzero even entire Gaussian test family, with an exact real-axis formula
  and a quantitative closed-strip decay estimate;
* an entire Gaussian multiplied by a finite symmetric pole-killing
  polynomial;
* a concrete finite half-integral phase sum, with pointwise unit modulus,
  measurability, normalization, and a parameter-uniform cardinality bound;
* absolute convergence after an explicit geometric modulus kernel;
* a fixed-window Gaussian lower-activity theorem;
* explicit lower and upper profiles with a proved infinite index set and an
  actual crossover.

No analytic trace formula or arithmetic cancellation estimate is hidden in a
structure field.  The saturation theorem below records precisely why the
unit-modulus input alone cannot provide cancellation beyond the cardinality
bound.
-/

namespace Mock2FA.PaperCorrections.P11ActualSpectralFoundations

open Set Complex Filter
open scoped BigOperators Topology

noncomputable section

/-! ### P11.2: one explicit entire strip-admissible family -/

/-- The even entire Gaussian with positive scale `a`.  The definition makes
sense for every real `a`; positivity is requested only by the decay lemmas. -/
def evenEntireGaussian (a : ℝ) (z : ℂ) : ℂ :=
  Complex.exp (-(a : ℂ) * z ^ 2)

@[simp]
theorem evenEntireGaussian_zero (a : ℝ) :
    evenEntireGaussian a 0 = 1 := by
  simp [evenEntireGaussian]

@[simp]
theorem evenEntireGaussian_neg (a : ℝ) (z : ℂ) :
    evenEntireGaussian a (-z) = evenEntireGaussian a z := by
  simp [evenEntireGaussian]

/-- The Gaussian is genuinely nonzero as a test function. -/
theorem evenEntireGaussian_ne_zero (a : ℝ) :
    evenEntireGaussian a ≠ 0 := by
  intro h
  have h0 := congrFun h 0
  simpa using h0

/-- Entirety is obtained by composing the analytic exponential with a
quadratic polynomial. -/
theorem evenEntireGaussian_analyticOnNhd (a : ℝ) :
    AnalyticOnNhd ℂ (evenEntireGaussian a) Set.univ := by
  change AnalyticOnNhd ℂ
    (fun z : ℂ ↦ Complex.exp (-(a : ℂ) * z ^ 2)) Set.univ
  exact (analyticOnNhd_const.mul (analyticOnNhd_id.pow 2)).cexp

/-- In particular, the Gaussian is analytic at every prescribed point; it
has no poles anywhere in the spectral plane. -/
theorem evenEntireGaussian_analyticAt (a : ℝ) (p : ℂ) :
    AnalyticAt ℂ (evenEntireGaussian a) p :=
  evenEntireGaussian_analyticOnNhd a p (Set.mem_univ p)

/-- Exact restriction of the complex Gaussian to the real spectral axis. -/
theorem evenEntireGaussian_ofReal (a x : ℝ) :
    evenEntireGaussian a (x : ℂ) =
      (Real.exp (-a * x ^ 2) : ℂ) := by
  rw [evenEntireGaussian, Complex.ofReal_exp, Complex.ofReal_mul,
    Complex.ofReal_neg, Complex.ofReal_pow]

/-- The real-axis values are strictly positive real numbers. -/
theorem evenEntireGaussian_realAxis_re_pos (a x : ℝ) :
    0 < (evenEntireGaussian a (x : ℂ)).re := by
  rw [evenEntireGaussian_ofReal]
  simpa using Real.exp_pos (-a * x ^ 2)

@[simp]
theorem evenEntireGaussian_realAxis_im (a x : ℝ) :
    (evenEntireGaussian a (x : ℂ)).im = 0 := by
  rw [evenEntireGaussian_ofReal]
  simp

/-- Exact real-axis norm formula. -/
theorem norm_evenEntireGaussian_ofReal (a x : ℝ) :
    ‖evenEntireGaussian a (x : ℂ)‖ = Real.exp (-a * x ^ 2) := by
  rw [evenEntireGaussian_ofReal]
  simp only [Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]

/-- Exact two-coordinate norm formula.  This is the calculation underlying
all quantitative strip estimates. -/
theorem norm_evenEntireGaussian (a : ℝ) (z : ℂ) :
    ‖evenEntireGaussian a z‖ =
      Real.exp (-a * z.re ^ 2 + a * z.im ^ 2) := by
  rw [evenEntireGaussian, Complex.norm_exp]
  congr 1
  simp only [Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, neg_re, neg_im, zero_mul, sub_zero, pow_two]
  ring

/-- Quantitative Gaussian decay on the closed strip `|Im z| ≤ σ`.  The
constant `exp (aσ²)` is independent of the real spectral coordinate. -/
theorem norm_evenEntireGaussian_le_on_closedStrip
    {a σ : ℝ} (ha : 0 ≤ a) (hσ : 0 ≤ σ)
    {z : ℂ} (hz : |z.im| ≤ σ) :
    ‖evenEntireGaussian a z‖ ≤
      Real.exp (a * σ ^ 2) * Real.exp (-a * z.re ^ 2) := by
  rw [norm_evenEntireGaussian, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hzBounds : -σ ≤ z.im ∧ z.im ≤ σ := (abs_le.mp hz)
  have himSq : z.im ^ 2 ≤ σ ^ 2 := by
    nlinarith
  nlinarith

/-- A compact statement of the analytic conditions actually discharged by
the Gaussian family.  It contains no spectral formula as a field. -/
def IsEvenEntireGaussianStripTest
    (f : ℂ → ℂ) (a σ : ℝ) : Prop :=
  f ≠ 0 ∧
    AnalyticOnNhd ℂ f Set.univ ∧
    (∀ z, f (-z) = f z) ∧
    (∀ x : ℝ, 0 < (f (x : ℂ)).re) ∧
    ∀ z : ℂ, |z.im| ≤ σ →
      ‖f z‖ ≤ Real.exp (a * σ ^ 2) * Real.exp (-a * z.re ^ 2)

/-- The explicit Gaussian inhabits the complete strip-test interface. -/
theorem evenEntireGaussian_isEvenEntireGaussianStripTest
    {a σ : ℝ} (ha : 0 ≤ a) (hσ : 0 ≤ σ) :
    IsEvenEntireGaussianStripTest (evenEntireGaussian a) a σ := by
  refine ⟨evenEntireGaussian_ne_zero a,
    evenEntireGaussian_analyticOnNhd a, ?_, ?_, ?_⟩
  · exact evenEntireGaussian_neg a
  · exact evenEntireGaussian_realAxis_re_pos a
  · intro z hz
    exact norm_evenEntireGaussian_le_on_closedStrip ha hσ hz

/-! ### Finite prescribed pole avoidance -/

/-- One even quadratic factor killing the symmetric points `±p`. -/
def symmetricPoleFactor (p : ℝ) (z : ℂ) : ℂ :=
  z ^ 2 - (p : ℂ) ^ 2

@[simp]
theorem symmetricPoleFactor_neg (p : ℝ) (z : ℂ) :
    symmetricPoleFactor p (-z) = symmetricPoleFactor p z := by
  simp [symmetricPoleFactor]

theorem symmetricPoleFactor_analyticOnNhd (p : ℝ) :
    AnalyticOnNhd ℂ (symmetricPoleFactor p) Set.univ := by
  simpa only [symmetricPoleFactor] using
    (analyticOnNhd_id.pow 2).sub
      (analyticOnNhd_const :
        AnalyticOnNhd ℂ (fun _ : ℂ ↦ (p : ℂ) ^ 2) Set.univ)

/-- No real symmetric pole factor vanishes at the nonreal point `I`. -/
theorem symmetricPoleFactor_I_ne_zero (p : ℝ) :
    symmetricPoleFactor p Complex.I ≠ 0 := by
  intro h
  have hre := congrArg Complex.re h
  simp [symmetricPoleFactor, pow_two, Complex.mul_re] at hre
  nlinarith [sq_nonneg p]

/-- The finite symmetric pole-killing polynomial. -/
def symmetricPolePolynomial (P : Finset ℝ) (z : ℂ) : ℂ :=
  ∏ p ∈ P, symmetricPoleFactor p z

@[simp]
theorem symmetricPolePolynomial_neg (P : Finset ℝ) (z : ℂ) :
    symmetricPolePolynomial P (-z) = symmetricPolePolynomial P z := by
  simp [symmetricPolePolynomial]

theorem symmetricPolePolynomial_analyticOnNhd (P : Finset ℝ) :
    AnalyticOnNhd ℂ (symmetricPolePolynomial P) Set.univ := by
  change AnalyticOnNhd ℂ
    (fun z : ℂ ↦ ∏ p ∈ P, symmetricPoleFactor p z) Set.univ
  exact P.analyticOnNhd_fun_prod fun p _ ↦
    symmetricPoleFactor_analyticOnNhd p

theorem symmetricPolePolynomial_I_ne_zero (P : Finset ℝ) :
    symmetricPolePolynomial P Complex.I ≠ 0 := by
  rw [symmetricPolePolynomial, Finset.prod_ne_zero_iff]
  intro p _hp
  exact symmetricPoleFactor_I_ne_zero p

/-- Gaussian decay multiplied by an even polynomial which removes a finite
list of real spectral poles symmetrically. -/
def poleKillingGaussian (a : ℝ) (P : Finset ℝ) (z : ℂ) : ℂ :=
  symmetricPolePolynomial P z * evenEntireGaussian a z

@[simp]
theorem poleKillingGaussian_neg (a : ℝ) (P : Finset ℝ) (z : ℂ) :
    poleKillingGaussian a P (-z) = poleKillingGaussian a P z := by
  simp [poleKillingGaussian]

theorem poleKillingGaussian_analyticOnNhd (a : ℝ) (P : Finset ℝ) :
    AnalyticOnNhd ℂ (poleKillingGaussian a P) Set.univ :=
  (symmetricPolePolynomial_analyticOnNhd P).mul
    (evenEntireGaussian_analyticOnNhd a)

theorem poleKillingGaussian_I_ne_zero (a : ℝ) (P : Finset ℝ) :
    poleKillingGaussian a P Complex.I ≠ 0 := by
  rw [poleKillingGaussian]
  exact mul_ne_zero (symmetricPolePolynomial_I_ne_zero P)
    (Complex.exp_ne_zero _)

/-- Prescribed pole killing does not collapse the test function to zero. -/
theorem poleKillingGaussian_ne_zero (a : ℝ) (P : Finset ℝ) :
    poleKillingGaussian a P ≠ 0 := by
  intro h
  exact poleKillingGaussian_I_ne_zero a P (congrFun h Complex.I)

theorem symmetricPolePolynomial_of_mem
    {P : Finset ℝ} {p : ℝ} (hp : p ∈ P) :
    symmetricPolePolynomial P (p : ℂ) = 0 := by
  rw [symmetricPolePolynomial]
  exact Finset.prod_eq_zero hp (by simp [symmetricPoleFactor])

theorem symmetricPolePolynomial_neg_of_mem
    {P : Finset ℝ} {p : ℝ} (hp : p ∈ P) :
    symmetricPolePolynomial P (-(p : ℂ)) = 0 := by
  rw [symmetricPolePolynomial_neg]
  exact symmetricPolePolynomial_of_mem hp

theorem poleKillingGaussian_of_mem
    (a : ℝ) {P : Finset ℝ} {p : ℝ} (hp : p ∈ P) :
    poleKillingGaussian a P (p : ℂ) = 0 := by
  simp [poleKillingGaussian, symmetricPolePolynomial_of_mem hp]

theorem poleKillingGaussian_neg_of_mem
    (a : ℝ) {P : Finset ℝ} {p : ℝ} (hp : p ∈ P) :
    poleKillingGaussian a P (-(p : ℂ)) = 0 := by
  simp [poleKillingGaussian, symmetricPolePolynomial_neg_of_mem hp]

/-! ### P11.3/P11.4: a finite half-integral phase model -/

/-- The modulus represented by the finite type below.  Writing it as `q+1`
keeps the normalization total and avoids a spurious zero-modulus branch. -/
def phaseModulus (q : ℕ) : ℕ := q + 1

/-- A concrete half-integral polynomial phase.  The final odd `x` term is the
half-step multiplier contribution; the preceding terms are the usual bilinear
arithmetic phase. -/
def halfIntegralPhaseArgument
    (q m n : ℕ) (x : Fin (phaseModulus q)) : ℝ :=
  2 * Real.pi *
    (((2 * m * x.1 + 2 * n * x.1 ^ 2 + x.1 : ℕ) : ℝ) /
      (2 * phaseModulus q : ℕ))

/-- Unit complex multiplier phase attached to the preceding argument. -/
def finiteHalfIntegralPhase
    (q m n : ℕ) (x : Fin (phaseModulus q)) : ℂ :=
  Complex.exp (Complex.I * halfIntegralPhaseArgument q m n x)

theorem finiteHalfIntegralPhase_measurable (q m n : ℕ) :
    Measurable (finiteHalfIntegralPhase q m n) :=
  measurable_of_finite _

@[simp]
theorem norm_finiteHalfIntegralPhase
    (q m n : ℕ) (x : Fin (phaseModulus q)) :
    ‖finiteHalfIntegralPhase q m n x‖ = 1 := by
  simpa [finiteHalfIntegralPhase] using
    Complex.norm_exp_I_mul_ofReal
      (halfIntegralPhaseArgument q m n x)

theorem finiteHalfIntegralPhase_ne_zero
    (q m n : ℕ) (x : Fin (phaseModulus q)) :
    finiteHalfIntegralPhase q m n x ≠ 0 := by
  intro h
  have hn := congrArg norm h
  simpa using hn

/-- The concrete finite Kloosterman-type phase sum. -/
def finiteHalfIntegralKloostermanSum (q m n : ℕ) : ℂ :=
  ∑ x : Fin (phaseModulus q), finiteHalfIntegralPhase q m n x

/-- For each fixed modulus, the entire arithmetic family is measurable on
the discrete parameter space `ℕ × ℕ`. -/
theorem finiteHalfIntegralKloostermanSum_measurable (q : ℕ) :
    Measurable (fun mn : ℕ × ℕ ↦
      finiteHalfIntegralKloostermanSum q mn.1 mn.2) :=
  measurable_of_countable _

/-- The exact cardinality of the finite modulus type. -/
theorem card_phaseModulus (q : ℕ) :
    Fintype.card (Fin (phaseModulus q)) = phaseModulus q := by
  simp

/-- Trivial modulus bound, with a constant independent of `m` and `n`. -/
theorem norm_finiteHalfIntegralKloostermanSum_le
    (q m n : ℕ) :
    ‖finiteHalfIntegralKloostermanSum q m n‖ ≤ phaseModulus q := by
  rw [finiteHalfIntegralKloostermanSum]
  calc
    ‖∑ x : Fin (phaseModulus q), finiteHalfIntegralPhase q m n x‖ ≤
        ∑ x : Fin (phaseModulus q),
          ‖finiteHalfIntegralPhase q m n x‖ :=
      norm_sum_le _ _
    _ = ∑ _x : Fin (phaseModulus q), (1 : ℝ) := by
      simp only [norm_finiteHalfIntegralPhase]
    _ = phaseModulus q := by simp

/-- Cardinality-normalized finite phase sum. -/
def normalizedFiniteHalfIntegralKloostermanSum
    (q m n : ℕ) : ℂ :=
  finiteHalfIntegralKloostermanSum q m n / (phaseModulus q : ℂ)

theorem normalizedFiniteHalfIntegralKloostermanSum_measurable (q : ℕ) :
    Measurable (fun mn : ℕ × ℕ ↦
      normalizedFiniteHalfIntegralKloostermanSum q mn.1 mn.2) :=
  measurable_of_countable _

/-- The normalized sum lies in the closed unit disk, uniformly in all three
arithmetic parameters. -/
theorem norm_normalizedFiniteHalfIntegralKloostermanSum_le_one
    (q m n : ℕ) :
    ‖normalizedFiniteHalfIntegralKloostermanSum q m n‖ ≤ 1 := by
  rw [normalizedFiniteHalfIntegralKloostermanSum, norm_div]
  rw [Complex.norm_natCast]
  apply (div_le_one (by simp [phaseModulus] :
    (0 : ℝ) < phaseModulus q)).2
  exact norm_finiteHalfIntegralKloostermanSum_le q m n

/-! ### The sharp logical boundary of the trivial phase estimate -/

/-- A constant unit phase saturates the cardinality bound exactly. -/
theorem norm_constantUnitPhaseSum (q : ℕ) :
    ‖∑ _x : Fin (phaseModulus q), (1 : ℂ)‖ = phaseModulus q := by
  simp [phaseModulus]

/-- Unit modulus by itself cannot imply any strictly smaller uniform bound.
Any cancellation theorem used by a genuine Kuznetsov argument must therefore
contain additional arithmetic information. -/
theorem no_strict_improvement_from_unit_modulus_alone (q : ℕ) :
    ¬ ∃ C : ℝ, C < phaseModulus q ∧
      ∀ φ : Fin (phaseModulus q) → ℂ,
        (∀ x, ‖φ x‖ = 1) → ‖∑ x, φ x‖ ≤ C := by
  rintro ⟨C, hC, hbound⟩
  have hOne := hbound (fun _ ↦ (1 : ℂ)) (by simp)
  rw [norm_constantUnitPhaseSum] at hOne
  exact (not_le_of_gt hC) hOne

/-! ### Explicit absolute summability in the modulus -/

/-- Geometrically damped normalized phase term. -/
def geometricallyDampedPhaseTerm (c m n : ℕ) : ℂ :=
  ((1 / 2 : ℂ) ^ c) *
    normalizedFiniteHalfIntegralKloostermanSum c m n

/-- Each modulus term is dominated by the parameter-independent geometric
majorant `(1/2)^c`. -/
theorem norm_geometricallyDampedPhaseTerm_le
    (c m n : ℕ) :
    ‖geometricallyDampedPhaseTerm c m n‖ ≤ (1 / 2 : ℝ) ^ c := by
  rw [geometricallyDampedPhaseTerm, norm_mul, norm_pow]
  have hnorm : ‖(1 / 2 : ℂ)‖ = (1 / 2 : ℝ) := by
    norm_num
  rw [hnorm]
  simpa using mul_le_mul_of_nonneg_left
    (norm_normalizedFiniteHalfIntegralKloostermanSum_le_one c m n)
    (pow_nonneg (by norm_num) c)

/-- Absolute convergence of the geometrically damped modulus series. -/
theorem summable_norm_geometricallyDampedPhaseTerm (m n : ℕ) :
    Summable (fun c : ℕ ↦ ‖geometricallyDampedPhaseTerm c m n‖) :=
  summable_geometric_two.of_nonneg_of_le
    (fun c ↦ norm_nonneg (geometricallyDampedPhaseTerm c m n))
    (fun c ↦ norm_geometricallyDampedPhaseTerm_le c m n)

/-- Hence the complex series itself converges unconditionally. -/
theorem summable_geometricallyDampedPhaseTerm (m n : ℕ) :
    Summable (geometricallyDampedPhaseTerm · m n) :=
  (summable_norm_geometricallyDampedPhaseTerm m n).of_norm

/-! ### P11.5: an actual fixed-window lower-activity theorem -/

/-- Discrete spectral mass supplied by the positive real-axis Gaussian. -/
def discreteGaussianSpectralMass (a : ℝ) (m : ℕ) : ℝ :=
  Real.exp (-a * (m : ℝ) ^ 2)

theorem discreteGaussianSpectralMass_pos (a : ℝ) (m : ℕ) :
    0 < discreteGaussianSpectralMass a m := by
  exact Real.exp_pos _

theorem discreteGaussianSpectralMass_ne_zero (a : ℝ) (m : ℕ) :
    discreteGaussianSpectralMass a m ≠ 0 :=
  (discreteGaussianSpectralMass_pos a m).ne'

/-- On each explicit finite spectral window, the Gaussian mass has a concrete
positive lower bound.  This is a theorem, not a pointwise-nonnegativity-to-gap
inference. -/
theorem discreteGaussianSpectralMass_uniform_on_Iic
    {a : ℝ} (ha : 0 ≤ a) (N : ℕ) :
    ∃ δ : ℝ, 0 < δ ∧
      ∀ m ∈ Set.Iic N, δ ≤ discreteGaussianSpectralMass a m := by
  refine ⟨Real.exp (-a * (N : ℝ) ^ 2), Real.exp_pos _, ?_⟩
  intro m hm
  rw [Set.mem_Iic] at hm
  rw [discreteGaussianSpectralMass]
  apply Real.exp_le_exp.mpr
  have hmCast : (m : ℝ) ≤ (N : ℝ) := by exact_mod_cast hm
  have hm0 : (0 : ℝ) ≤ m := by positivity
  have hN0 : (0 : ℝ) ≤ N := by positivity
  have hsq : (m : ℝ) ^ 2 ≤ (N : ℝ) ^ 2 := by
    nlinarith
  have hmul : a * (m : ℝ) ^ 2 ≤ a * (N : ℝ) ^ 2 :=
    mul_le_mul_of_nonneg_left hsq ha
  linarith

/-- The preceding theorem is exactly the corrected P11 uniform-lower-activity
predicate on the chosen finite window. -/
theorem discreteGaussianSpectralMass_hasUniformLowerActivity_Iic
    {a : ℝ} (ha : 0 ≤ a) (N : ℕ) :
    P11ConditionalReduction.HasUniformLowerActivity
      (discreteGaussianSpectralMass a) (Set.Iic N) :=
  discreteGaussianSpectralMass_uniform_on_Iic ha N

/-! ### P11.6: explicit profiles and an actual crossover -/

/-- A concrete positive lower profile. -/
def explicitLowerProfile (_m : ℕ) : ℝ := 2

/-- A concrete decaying upper profile. -/
def explicitUpperProfile (m : ℕ) : ℝ :=
  1 / ((m : ℝ) + 1)

/-- Every natural index is admissible for this numerical comparison. -/
def explicitCrossoverIndices : Set ℕ := Set.univ

theorem explicitCrossoverIndices_infinite :
    explicitCrossoverIndices.Infinite := by
  simpa [explicitCrossoverIndices] using Set.infinite_univ

theorem explicitUpperProfile_pos (m : ℕ) :
    0 < explicitUpperProfile m := by
  rw [explicitUpperProfile]
  positivity

theorem explicitLowerProfile_pos (m : ℕ) :
    0 < explicitLowerProfile m := by
  norm_num [explicitLowerProfile]

/-- The requested crossover is witnessed explicitly already at `m=0`. -/
theorem exists_explicitProfile_crossover :
    ∃ m ∈ explicitCrossoverIndices,
      explicitUpperProfile m < explicitLowerProfile m := by
  refine ⟨0, Set.mem_univ 0, ?_⟩
  norm_num [explicitUpperProfile, explicitLowerProfile]

/-- There is no scalar statistic satisfying both of these literal profiles.
This is the unconditional final numerical contradiction, separated from any
unavailable assertion that a Kuznetsov statistic has the required bounds. -/
theorem no_statistic_between_explicitProfiles :
    ¬ ∃ S : ℕ → ℝ,
      (∀ m ∈ explicitCrossoverIndices, explicitLowerProfile m ≤ S m) ∧
      (∀ m, |S m| ≤ explicitUpperProfile m) := by
  rintro ⟨S, hLower, hUpper⟩
  have hL := hLower 0 (Set.mem_univ 0)
  have hU := hUpper 0
  have hAbs : S 0 ≤ |S 0| := le_abs_self (S 0)
  norm_num [explicitLowerProfile, explicitUpperProfile] at hL hU
  linarith

/-- The profiles provide the exact crossover component required by the honest
conditional reduction already present in the integrated file. -/
theorem explicitProfiles_crossover_component :
    ∃ m ∈ explicitCrossoverIndices,
      explicitUpperProfile m < explicitLowerProfile m :=
  exists_explicitProfile_crossover

end
end Mock2FA.PaperCorrections.P11ActualSpectralFoundations

