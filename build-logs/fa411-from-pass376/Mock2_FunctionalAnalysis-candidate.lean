/-!
### P2.4 follow-up: nonzero fixed-phase cores at every orbit index

The orbit-zero inverse-eta seed is not raised or lowered to obtain the
examples below: a differential operator can kill a nonzero vector.  Instead
we differentiate a genuinely nonconstant invariant scalar.  Its two
Wirtinger directions give integral-weight factors of weights `2` and `-2`.
Their ordinary powers change the inverse-eta factor by exactly `j^(2*n)` at
every `n : ℤ`.  Finally a discriminant cutoff whose level is chosen at a
proved nonvanishing point supplies quotient-compact support.
-/

namespace Mock2FA
namespace PaperCorrections
namespace AutomorphicSobolev
namespace ExplicitDiscriminantPotential

open Set Function Topology
open GammaTwoQuotientGeometry
open HalfIntegralMultiplier SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators
open MeasureTheory
open scoped ContDiff

/-! #### A nonzero invariant differential generator -/

/-- The discriminant cutoff vanishes at some honest upper-half-plane point.
This is a consequence of its proved cusp decay, not an added witness. -/
theorem exists_upstairsCoreCutoff_eq_zero :
    ∃ z : ℍ, upstairsCoreCutoff z = 0 := by
  obtain ⟨Y, hY⟩ := upstairsPotential_cuspTail coreCutoffLevel_pos
  let y : ℝ := max Y 1
  have hy : 0 < y :=
    lt_of_lt_of_le (by norm_num) (le_max_right Y 1)
  let z : ℍ :=
    ⟨(y : ℂ) * Complex.I, by simpa [y] using hy⟩
  have hzHeight : Y ≤ z.im := by
    simpa [z, y] using (le_max_left Y 1)
  have hzSmall : upstairsPotential z ≤ coreCutoffLevel := hY z hzHeight
  refine ⟨z, ?_⟩
  simp only [upstairsCoreCutoff,
    expNegInvGlue.zero_of_nonpos (sub_nonpos.mpr hzSmall),
    Complex.ofReal_zero]

/-- Since the cutoff is nonzero at `i` and zero at a cusp-tail point, its
ambient real derivative is nonzero somewhere. -/
theorem exists_fderiv_upstairsCoreCutoff_ne_zero :
    ∃ z : ℍ,
      fderiv ℝ (upperLift upstairsCoreCutoff) (z : ℂ) ≠ 0 := by
  obtain ⟨z0, hz0⟩ := exists_upstairsCoreCutoff_eq_zero
  by_contra hAllZero
  push_neg at hAllZero
  have hSmooth := upstairsCoreCutoff_realSmooth
  have hDifferentiable : DifferentiableOn ℝ
      (upperLift upstairsCoreCutoff)
      UpperHalfPlane.upperHalfPlaneSet := by
    unfold RealSmooth at hSmooth
    exact hSmooth.differentiableOn (by simp)
  have hDerivativeZero :
      UpperHalfPlane.upperHalfPlaneSet.EqOn
        (fderiv ℝ (upperLift upstairsCoreCutoff)) 0 := by
    intro w hw
    simpa using hAllZero (⟨w, hw⟩ : ℍ)
  have hConstant :=
    UpperHalfPlane.isOpen_upperHalfPlaneSet.is_const_of_fderiv_eq_zero
      (convex_halfSpace_im_gt 0).isPreconnected
      hDifferentiable hDerivativeZero
      UpperHalfPlane.I.im_pos z0.im_pos
  have hValue : upstairsCoreCutoff UpperHalfPlane.I =
      upstairsCoreCutoff z0 := by
    simpa only [upperLift_apply] using hConstant
  rw [hz0] at hValue
  exact upstairsCoreCutoff_apply_I_ne_zero hValue

/-- The holomorphic real-Wirtinger direction of the invariant cutoff.  The
normalization agrees with the direction used by `raiseRaw`. -/
noncomputable def fixedPhaseHolomorphicDirection (z : ℍ) : ℂ :=
  (Complex.I • dx upstairsCoreCutoff + dy upstairsCoreCutoff) z

/-- The opposite real-Wirtinger direction. -/
noncomputable def fixedPhaseAntiholomorphicDirection (z : ℍ) : ℂ :=
  ((-Complex.I) • dx upstairsCoreCutoff + dy upstairsCoreCutoff) z

theorem fixedPhaseHolomorphicDirection_realSmooth :
    RealSmooth fixedPhaseHolomorphicDirection := by
  change RealSmooth
    (Complex.I • dx upstairsCoreCutoff + dy upstairsCoreCutoff)
  exact RealSmooth.add
    (RealSmooth.const_complex_smul Complex.I
      (RealSmooth.dx upstairsCoreCutoff_realSmooth))
    (RealSmooth.dy upstairsCoreCutoff_realSmooth)

theorem fixedPhaseAntiholomorphicDirection_realSmooth :
    RealSmooth fixedPhaseAntiholomorphicDirection := by
  change RealSmooth
    ((-Complex.I) • dx upstairsCoreCutoff + dy upstairsCoreCutoff)
  exact RealSmooth.add
    (RealSmooth.const_complex_smul (-Complex.I)
      (RealSmooth.dx upstairsCoreCutoff_realSmooth))
    (RealSmooth.dy upstairsCoreCutoff_realSmooth)

/-- If both Wirtinger directions vanish at a point, the full real Frechet
derivative vanishes there. -/
theorem fderiv_upstairsCoreCutoff_eq_zero_of_directions_eq_zero
    (z : ℍ)
    (hHol : fixedPhaseHolomorphicDirection z = 0)
    (hAnti : fixedPhaseAntiholomorphicDirection z = 0) :
    fderiv ℝ (upperLift upstairsCoreCutoff) (z : ℂ) = 0 := by
  have hHol' : Complex.I * dx upstairsCoreCutoff z +
      dy upstairsCoreCutoff z = 0 := by
    simpa [fixedPhaseHolomorphicDirection, Pi.add_apply,
      Pi.smul_apply, smul_eq_mul] using hHol
  have hAnti' : (-Complex.I) * dx upstairsCoreCutoff z +
      dy upstairsCoreCutoff z = 0 := by
    simpa [fixedPhaseAntiholomorphicDirection, Pi.add_apply,
      Pi.smul_apply, smul_eq_mul] using hAnti
  have hdx : dx upstairsCoreCutoff z = 0 := by
    have hTwoI : (2 * Complex.I) * dx upstairsCoreCutoff z = 0 := by
      calc
        (2 * Complex.I) * dx upstairsCoreCutoff z =
            (Complex.I * dx upstairsCoreCutoff z +
              dy upstairsCoreCutoff z) -
            ((-Complex.I) * dx upstairsCoreCutoff z +
              dy upstairsCoreCutoff z) := by ring
        _ = 0 := by rw [hHol', hAnti', sub_self]
    exact (mul_eq_zero.mp hTwoI).resolve_left
      (mul_ne_zero (by norm_num) Complex.I_ne_zero)
  have hdy : dy upstairsCoreCutoff z = 0 := by
    simpa only [hdx, mul_zero, zero_add] using hHol'
  apply ContinuousLinearMap.ext
  intro ξ
  have hξ : ξ = ξ.re • (1 : ℂ) + ξ.im • Complex.I := by
    apply Complex.ext <;> simp
  rw [hξ, map_add, map_smul, map_smul]
  change ξ.re • dx upstairsCoreCutoff z +
      ξ.im • dy upstairsCoreCutoff z = 0
  rw [hdx, hdy]
  simp

/-- At least one of the two invariant differential directions is nonzero at
an actual point. -/
theorem exists_fixedPhase_direction_ne_zero :
    ∃ z : ℍ,
      fixedPhaseHolomorphicDirection z ≠ 0 ∨
        fixedPhaseAntiholomorphicDirection z ≠ 0 := by
  obtain ⟨z, hz⟩ := exists_fderiv_upstairsCoreCutoff_ne_zero
  refine ⟨z, ?_⟩
  by_contra hBoth
  push_neg at hBoth
  exact hz
    (fderiv_upstairsCoreCutoff_eq_zero_of_directions_eq_zero
      z hBoth.1 hBoth.2)

/-- Real smoothness is preserved by pointwise complex conjugation. -/
theorem realSmooth_conj_comp {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (fun z ↦ star (f z)) :=
  RealSmooth.conj hf

/-- The holomorphic direction has exact integral weight `+2`. -/
theorem fixedPhaseHolomorphicDirection_covariance
    (γ : GammaTwo) (z : ℍ) :
    fixedPhaseHolomorphicDirection
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitDenom γ z ^ (2 : ℕ) *
        fixedPhaseHolomorphicDirection z := by
  have hChain := holomorphicDirectional_comp_gammaTwo_smul γ
    upstairsCoreCutoff_realSmooth z
  have hInvariant :
      (fun w : ℍ ↦ upstairsCoreCutoff
        (((γ : GammaTwo) : SL(2, ℤ)) • w)) =
        upstairsCoreCutoff := by
    funext w
    exact upstairsCoreCutoff_gammaTwo_invariant γ w
  rw [hInvariant] at hChain
  change fixedPhaseHolomorphicDirection z =
      (inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
        fixedPhaseHolomorphicDirection
          (((γ : GammaTwo) : SL(2, ℤ)) • z) at hChain
  calc
    fixedPhaseHolomorphicDirection
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        inverseEtaPaperOrbitDenom γ z ^ 2 *
          ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
            fixedPhaseHolomorphicDirection
              (((γ : GammaTwo) : SL(2, ℤ)) • z)) := by
          field_simp [inverseEtaPaperOrbitDenom_ne_zero γ z]
    _ = inverseEtaPaperOrbitDenom γ z ^ 2 *
        fixedPhaseHolomorphicDirection z := by rw [← hChain]

/-- The opposite direction has conjugate integral weight `+2`. -/
theorem fixedPhaseAntiholomorphicDirection_covariance
    (γ : GammaTwo) (z : ℍ) :
    fixedPhaseAntiholomorphicDirection
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      star (inverseEtaPaperOrbitDenom γ z ^ (2 : ℕ)) *
        fixedPhaseAntiholomorphicDirection z := by
  have hChain := antiholomorphicDirectional_comp_gammaTwo_smul γ
    upstairsCoreCutoff_realSmooth z
  have hInvariant :
      (fun w : ℍ ↦ upstairsCoreCutoff
        (((γ : GammaTwo) : SL(2, ℤ)) • w)) =
        upstairsCoreCutoff := by
    funext w
    exact upstairsCoreCutoff_gammaTwo_invariant γ w
  rw [hInvariant] at hChain
  change fixedPhaseAntiholomorphicDirection z =
      star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
        fixedPhaseAntiholomorphicDirection
          (((γ : GammaTwo) : SL(2, ℤ)) • z) at hChain
  have hj : inverseEtaPaperOrbitDenom γ z ≠ 0 :=
    inverseEtaPaperOrbitDenom_ne_zero γ z
  have hjc : star (inverseEtaPaperOrbitDenom γ z) ≠ 0 := by
    intro h
    apply hj
    have := congrArg star h
    simpa using this
  have hConjPow :
      star (inverseEtaPaperOrbitDenom γ z ^ 2) =
        star (inverseEtaPaperOrbitDenom γ z) ^ 2 := by
    change star (inverseEtaPaperOrbitDenom γ z ^ 2) =
      star (inverseEtaPaperOrbitDenom γ z) ^ 2
    exact star_pow _ 2
  calc
    fixedPhaseAntiholomorphicDirection
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        star (inverseEtaPaperOrbitDenom γ z ^ 2) *
          (star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
            fixedPhaseAntiholomorphicDirection
              (((γ : GammaTwo) : SL(2, ℤ)) • z)) := by
          rw [show star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) =
              (star (inverseEtaPaperOrbitDenom γ z ^ 2))⁻¹ by
            exact map_inv₀ (starRingEnd ℂ) _]
          have hpow : star (inverseEtaPaperOrbitDenom γ z ^ 2) ≠ 0 := by
            rw [hConjPow]
            exact pow_ne_zero 2 hjc
          field_simp [hpow]
    _ = star (inverseEtaPaperOrbitDenom γ z ^ 2) *
        fixedPhaseAntiholomorphicDirection z := by rw [← hChain]

/-- Select a genuine weight-two generator.  If the first direction happens
to vanish identically, conjugating the proved-nonzero opposite direction
changes its conjugate covariance into ordinary weight `+2`. -/
noncomputable def fixedPhasePositiveWeightGenerator (z : ℍ) : ℂ := by
  classical
  exact if ∃ w : ℍ, fixedPhaseHolomorphicDirection w ≠ 0 then
    fixedPhaseHolomorphicDirection z
  else
    star (fixedPhaseAntiholomorphicDirection z)

theorem fixedPhasePositiveWeightGenerator_realSmooth :
    RealSmooth fixedPhasePositiveWeightGenerator := by
  classical
  unfold fixedPhasePositiveWeightGenerator
  split_ifs with h
  · exact fixedPhaseHolomorphicDirection_realSmooth
  · exact realSmooth_conj_comp
      fixedPhaseAntiholomorphicDirection_realSmooth

theorem fixedPhasePositiveWeightGenerator_covariance
    (γ : GammaTwo) (z : ℍ) :
    fixedPhasePositiveWeightGenerator
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitDenom γ z ^ (2 : ℕ) *
        fixedPhasePositiveWeightGenerator z := by
  classical
  unfold fixedPhasePositiveWeightGenerator
  split_ifs with h
  · exact fixedPhaseHolomorphicDirection_covariance γ z
  · rw [fixedPhaseAntiholomorphicDirection_covariance]
    simp only [← starRingEnd_apply, map_mul, map_pow, Complex.conj_conj]

theorem exists_fixedPhasePositiveWeightGenerator_ne_zero :
    ∃ z : ℍ, fixedPhasePositiveWeightGenerator z ≠ 0 := by
  classical
  by_cases hHol : ∃ z : ℍ, fixedPhaseHolomorphicDirection z ≠ 0
  · have hExists := hHol
    obtain ⟨z, hz⟩ := hHol
    refine ⟨z, ?_⟩
    simpa [fixedPhasePositiveWeightGenerator, hExists] using hz
  · rcases exists_fixedPhase_direction_ne_zero with ⟨z, hz⟩
    rcases hz with hzHol | hzAnti
    · exact False.elim (hHol ⟨z, hzHol⟩)
    · refine ⟨z, ?_⟩
      simp only [fixedPhasePositiveWeightGenerator, hHol, if_false]
      intro hConj
      apply hzAnti
      have := congrArg star hConj
      simpa using this

/-- A fixed point at which the selected weight-two generator is nonzero. -/

noncomputable def fixedPhaseGeneratorPoint : ℍ :=
  Classical.choose exists_fixedPhasePositiveWeightGenerator_ne_zero

theorem fixedPhasePositiveWeightGenerator_at_point_ne_zero :
    fixedPhasePositiveWeightGenerator fixedPhaseGeneratorPoint ≠ 0 :=
  Classical.choose_spec exists_fixedPhasePositiveWeightGenerator_ne_zero

/-- The canonical weight `-2` generator obtained from the positive one by the
Petersson metric. -/
noncomputable def fixedPhaseNegativeWeightGenerator (z : ℍ) : ℂ :=
  heightC z ^ (2 : ℕ) *
    star (fixedPhasePositiveWeightGenerator z)

theorem fixedPhaseNegativeWeightGenerator_realSmooth :
    RealSmooth fixedPhaseNegativeWeightGenerator := by
  exact (realSmooth_heightC.pow 2).mul
    (realSmooth_conj_comp fixedPhasePositiveWeightGenerator_realSmooth)

private theorem heightSq_conj_weight_covariance_algebra
    (j y p : ℂ) (hj : j ≠ 0) :
    (y / (Complex.normSq j : ℂ)) ^ (2 : ℕ) *
        star (j ^ (2 : ℕ) * p) =
      j ^ (-2 : ℤ) * (y ^ (2 : ℕ) * star p) := by
  have hjc : star j ≠ 0 := by
    intro h
    apply hj
    have := congrArg star h
    simpa using this
  have hstarMul :
      star (j ^ (2 : ℕ) * p) = star (j ^ (2 : ℕ)) * star p := by
    simpa only [starRingEnd_apply] using
      (map_mul (starRingEnd ℂ) (j ^ (2 : ℕ)) p)
  have hstarPow :
      star (j ^ (2 : ℕ)) = (star j) ^ (2 : ℕ) := by
    simpa only [starRingEnd_apply] using
      (map_pow (starRingEnd ℂ) j (2 : ℕ))
  rw [hstarMul, hstarPow]
  rw [show (Complex.normSq j : ℂ) = star j * j by
    exact Complex.normSq_eq_conj_mul_self]
  field_simp [hj, hjc]
  <;> ring

theorem fixedPhaseNegativeWeightGenerator_covariance
    (γ : GammaTwo) (z : ℍ) :
    fixedPhaseNegativeWeightGenerator
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitDenom γ z ^ (-2 : ℤ) *
        fixedPhaseNegativeWeightGenerator z := by
  rw [fixedPhaseNegativeWeightGenerator,
    fixedPhaseNegativeWeightGenerator,
    heightC_gammaTwo_smul,
    fixedPhasePositiveWeightGenerator_covariance]
  exact heightSq_conj_weight_covariance_algebra
    (inverseEtaPaperOrbitDenom γ z) (heightC z)
    (fixedPhasePositiveWeightGenerator z)
    (inverseEtaPaperOrbitDenom_ne_zero γ z)

theorem fixedPhaseNegativeWeightGenerator_at_point_ne_zero :
    fixedPhaseNegativeWeightGenerator fixedPhaseGeneratorPoint ≠ 0 := by
  apply mul_ne_zero
  · exact pow_ne_zero 2 (heightC_ne_zero fixedPhaseGeneratorPoint)
  · intro hConj
    apply fixedPhasePositiveWeightGenerator_at_point_ne_zero
    have := congrArg star hConj
    simpa using this

/-! #### Integral weight factors and genuine seeds at every index -/

/-- The integral-weight factor at orbit index `n`.  Negative indices use the
smooth weight-minus-two generator rather than a reciprocal, so no global
nonvanishing assumption is hidden in its definition. -/
noncomputable def fixedPhaseIntegralWeightFactor : ℤ → ℍ → ℂ
  | .ofNat m, z => fixedPhasePositiveWeightGenerator z ^ m
  | .negSucc m, z => fixedPhaseNegativeWeightGenerator z ^ (m + 1)

theorem fixedPhaseIntegralWeightFactor_realSmooth (n : ℤ) :
    RealSmooth (fixedPhaseIntegralWeightFactor n) := by
  cases n with
  | ofNat m =>
      exact fixedPhasePositiveWeightGenerator_realSmooth.pow m
  | negSucc m =>
      exact fixedPhaseNegativeWeightGenerator_realSmooth.pow (m + 1)

private theorem positiveWeightPower_eq_zpow
    (j : ℂ) (m : ℕ) :
    (j ^ (2 : ℕ)) ^ m = j ^ ((2 : ℤ) * (m : ℤ)) := by
  calc
    (j ^ (2 : ℕ)) ^ m = j ^ (2 * m) := (pow_mul j 2 m).symm
    _ = j ^ ((2 : ℤ) * (m : ℤ)) := by
      rw [show (2 : ℤ) * (m : ℤ) = ((2 * m : ℕ) : ℤ) by omega]
      exact (zpow_ofNat j (2 * m)).symm

private theorem negativeWeightPower_eq_zpow
    (j : ℂ) (m : ℕ) :
    (j ^ (-2 : ℤ)) ^ (m + 1) =
      j ^ ((2 : ℤ) * Int.negSucc m) := by
  calc
    (j ^ (-2 : ℤ)) ^ (m + 1) =
        (j ^ (-2 : ℤ)) ^ (((m + 1 : ℕ) : ℤ)) := by
      exact (zpow_ofNat (j ^ (-2 : ℤ)) (m + 1)).symm
    _ = j ^ ((-2 : ℤ) * ((m + 1 : ℕ) : ℤ)) :=
      (zpow_mul j (-2 : ℤ) (((m + 1 : ℕ) : ℤ))).symm
    _ = j ^ ((2 : ℤ) * Int.negSucc m) := by
      congr 1 <;> omega

theorem fixedPhaseIntegralWeightFactor_covariance
    (n : ℤ) (γ : GammaTwo) (z : ℍ) :
    fixedPhaseIntegralWeightFactor n
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitDenom γ z ^ ((2 : ℤ) * n) *
        fixedPhaseIntegralWeightFactor n z := by
  cases n with
  | ofNat m =>
      change fixedPhasePositiveWeightGenerator
          (((γ : GammaTwo) : SL(2, ℤ)) • z) ^ m = _
      rw [fixedPhasePositiveWeightGenerator_covariance, mul_pow,
        positiveWeightPower_eq_zpow]
      rfl
  | negSucc m =>
      change fixedPhaseNegativeWeightGenerator
          (((γ : GammaTwo) : SL(2, ℤ)) • z) ^ (m + 1) = _
      rw [fixedPhaseNegativeWeightGenerator_covariance, mul_pow,
        negativeWeightPower_eq_zpow]
      rfl

theorem fixedPhaseIntegralWeightFactor_at_point_ne_zero (n : ℤ) :
    fixedPhaseIntegralWeightFactor n fixedPhaseGeneratorPoint ≠ 0 := by
  cases n with
  | ofNat m =>
      exact pow_ne_zero m
        fixedPhasePositiveWeightGenerator_at_point_ne_zero
  | negSucc m =>
      exact pow_ne_zero (m + 1)
        fixedPhaseNegativeWeightGenerator_at_point_ne_zero

/-- A genuine smooth fixed-phase section at every orbit index. -/
noncomputable def inverseEtaPaperOrbitAllIndexSeedSection (n : ℤ) :
    InverseEtaPaperOrbitSection GammaTwo n := by
  refine ⟨fun z ↦ fixedPhaseIntegralWeightFactor n z *
    inverseEtaSection z, ?_⟩
  intro γ z
  change
    fixedPhaseIntegralWeightFactor n
          (((γ : GammaTwo) : SL(2, ℤ)) • z) *
        inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo n).factor γ z *
        (fixedPhaseIntegralWeightFactor n z * inverseEtaSection z)
  rw [fixedPhaseIntegralWeightFactor_covariance,
    WeightSection.covariance inverseEtaSection,
    inverseEtaPaperOrbitMultiplier_factor]
  change
    inverseEtaPaperOrbitDenom γ z ^ (2 * n) *
          fixedPhaseIntegralWeightFactor n z *
        ((inverseEtaMultiplier GammaTwo).factor γ z *
          inverseEtaSection z) =
      (inverseEtaMultiplier GammaTwo).factor γ z *
          inverseEtaPaperOrbitDenom γ z ^ (2 * n) *
        (fixedPhaseIntegralWeightFactor n z * inverseEtaSection z)
  ring

@[simp]
theorem inverseEtaPaperOrbitAllIndexSeedSection_apply
    (n : ℤ) (z : ℍ) :
    inverseEtaPaperOrbitAllIndexSeedSection n z =
      fixedPhaseIntegralWeightFactor n z * inverseEtaSection z :=
  rfl

/-- The all-index seed carries literally the original inverse-eta phase; the
only index-dependent term is the proved integral denominator power. -/
theorem inverseEtaPaperOrbitAllIndexSeedSection_covariance
    (n : ℤ) (γ : GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitAllIndexSeedSection n
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo n).factor γ z *
        inverseEtaPaperOrbitAllIndexSeedSection n z :=
  WeightSection.covariance (inverseEtaPaperOrbitAllIndexSeedSection n) γ z

theorem inverseEtaPaperOrbitAllIndexSeedSection_realSmooth (n : ℤ) :
    RealSmooth
      (inverseEtaPaperOrbitAllIndexSeedSection n : ℍ → ℂ) := by
  change RealSmooth
    (fixedPhaseIntegralWeightFactor n * (inverseEtaSection : ℍ → ℂ))
  exact (fixedPhaseIntegralWeightFactor_realSmooth n).mul
    inverseEtaSection_realSmooth

theorem inverseEtaPaperOrbitAllIndexSeedSection_at_point_ne_zero (n : ℤ) :
    inverseEtaPaperOrbitAllIndexSeedSection n fixedPhaseGeneratorPoint ≠ 0 := by
  exact mul_ne_zero (fixedPhaseIntegralWeightFactor_at_point_ne_zero n)
    (inverseEtaSection_apply_ne_zero fixedPhaseGeneratorPoint)

/-! #### A quotient-compact invariant cutoff at the selected point -/

/-- Positive cutoff level adapted to the selected generator point. -/
noncomputable def allIndexCoreCutoffLevel : ℝ :=
  upstairsPotential fixedPhaseGeneratorPoint / 2

theorem allIndexCoreCutoffLevel_pos : 0 < allIndexCoreCutoffLevel := by
  exact div_pos (upstairsPotential_pos fixedPhaseGeneratorPoint) (by norm_num)

theorem allIndexCoreCutoffLevel_lt_at_point :
    allIndexCoreCutoffLevel < upstairsPotential fixedPhaseGeneratorPoint := by
  dsimp only [allIndexCoreCutoffLevel]
  linarith [upstairsPotential_pos fixedPhaseGeneratorPoint]

noncomputable def upstairsAllIndexCoreCutoff (z : ℍ) : ℂ :=
  (expNegInvGlue (upstairsPotential z - allIndexCoreCutoffLevel) : ℂ)

theorem upstairsAllIndexCoreCutoff_realSmooth :
    RealSmooth upstairsAllIndexCoreCutoff := by
  unfold RealSmooth upperLift upstairsAllIndexCoreCutoff
  have hArg : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ upstairsPotential (UpperHalfPlane.ofComplex w) -
        allIndexCoreCutoffLevel)
      UpperHalfPlane.upperHalfPlaneSet :=
    upstairsPotential_upperLift_realContDiffOn.sub contDiffOn_const
  have hGlue : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ expNegInvGlue
        (upstairsPotential (UpperHalfPlane.ofComplex w) -
          allIndexCoreCutoffLevel))
      UpperHalfPlane.upperHalfPlaneSet :=
    expNegInvGlue.contDiff.comp_contDiffOn hArg
  simpa only [Function.comp_def, Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.comp_contDiffOn hGlue

theorem upstairsAllIndexCoreCutoff_gammaTwo_invariant
    (γ : GammaTwo) (z : ℍ) :
    upstairsAllIndexCoreCutoff
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsAllIndexCoreCutoff z := by
  simp only [upstairsAllIndexCoreCutoff,
    upstairsPotential_gammaTwo_invariant]

theorem upstairsAllIndexCoreCutoff_at_point_ne_zero :
    upstairsAllIndexCoreCutoff fixedPhaseGeneratorPoint ≠ 0 := by
  apply Complex.ofReal_ne_zero.mpr
  exact ne_of_gt (expNegInvGlue.pos_of_pos
    (sub_pos.mpr allIndexCoreCutoffLevel_lt_at_point))

noncomputable def quotientAllIndexCoreCutoff
    (q : GammaTwoQuotient) : ℂ :=
  (expNegInvGlue (potential q - allIndexCoreCutoffLevel) : ℂ)

@[simp]
theorem quotientAllIndexCoreCutoff_mk (z : ℍ) :
    quotientAllIndexCoreCutoff (gammaTwoQuotientMk z) =
      upstairsAllIndexCoreCutoff z :=
  rfl

theorem quotientAllIndexCoreCutoff_continuous :
    Continuous quotientAllIndexCoreCutoff := by
  exact Complex.ofRealCLM.continuous.comp
    ((expNegInvGlue.contDiff (n := 1)).continuous.comp
      (potential_continuous.sub continuous_const))

theorem quotientAllIndexCoreCutoff_support_subset_compactTruncation :
    ∃ Y : ℝ, 1 ≤ Y ∧
      Function.support quotientAllIndexCoreCutoff ⊆
        gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y := by
  obtain ⟨Y, hY, hTail⟩ :=
    potential_quotientOutside_threeCuspTruncationImage
      allIndexCoreCutoffLevel_pos
  refine ⟨Y, hY, ?_⟩
  intro q hq
  change quotientAllIndexCoreCutoff q ≠ 0 at hq
  by_contra hqOutside
  have hSmall : potential q ≤ allIndexCoreCutoffLevel :=
    hTail q hqOutside
  apply hq
  simp only [quotientAllIndexCoreCutoff,
    expNegInvGlue.zero_of_nonpos (sub_nonpos.mpr hSmall),
    Complex.ofReal_zero]

theorem quotientAllIndexCoreCutoff_hasCompactSupport :
    HasCompactSupport quotientAllIndexCoreCutoff := by
  change IsCompact (closure (Function.support quotientAllIndexCoreCutoff))
  obtain ⟨Y, _hY, hSupport⟩ :=
    quotientAllIndexCoreCutoff_support_subset_compactTruncation
  have hCompactImage : IsCompact
      (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) :=
    (gammaTwoThreeCuspTruncation_isCompact Y).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous
  exact hCompactImage.of_isClosed_subset isClosed_closure
    (closure_minimal hSupport hCompactImage.isClosed)

theorem upstairsAllIndexCoreCutoff_projected_support :
    gammaTwoQuotientMk '' Function.support upstairsAllIndexCoreCutoff =
      Function.support quotientAllIndexCoreCutoff := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · rintro ⟨w, hw, hEq⟩
    have hw' :
        quotientAllIndexCoreCutoff (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support,
        quotientAllIndexCoreCutoff_mk] using hw
    rwa [hEq] at hw'
  · intro hz
    refine ⟨z, ?_, rfl⟩
    have hz' :
        quotientAllIndexCoreCutoff (gammaTwoQuotientMk z) ≠ 0 := by
      simpa only [Function.mem_support, gammaTwoQuotientMk] using hz
    change upstairsAllIndexCoreCutoff z ≠ 0
    rw [← quotientAllIndexCoreCutoff_mk]
    exact hz'

theorem upstairsAllIndexCoreCutoff_quotientTSupport :
    quotientTSupport upstairsAllIndexCoreCutoff =
      tsupport quotientAllIndexCoreCutoff := by
  rw [quotientTSupport, tsupport,
    upstairsAllIndexCoreCutoff_projected_support]

theorem upstairsAllIndexCoreCutoff_quotientCompact :
    HasQuotientCompactSupport upstairsAllIndexCoreCutoff := by
  rw [HasQuotientCompactSupport,
    upstairsAllIndexCoreCutoff_quotientTSupport]
  exact quotientAllIndexCoreCutoff_hasCompactSupport

noncomputable def upstairsAllIndexCoreCutoffSmoothQuotient :
    SmoothQuotientCompactFunction :=
  ⟨⟨upstairsAllIndexCoreCutoff,
      upstairsAllIndexCoreCutoff_realSmooth⟩,
    upstairsAllIndexCoreCutoff_quotientCompact⟩

theorem upstairsAllIndexCoreCutoffSmoothQuotient_invariant :
    IsGammaTwoInvariantCutoff
      upstairsAllIndexCoreCutoffSmoothQuotient := by
  intro γ z
  exact upstairsAllIndexCoreCutoff_gammaTwo_invariant γ z

/-! #### The unconditional all-index nontriviality theorem -/

/-- A nonzero element of the all-word stable fixed-phase core at every
integer orbit index. -/
noncomputable def compactInverseEtaFixedPhaseCoreAllIndex (n : ℤ) :
    InverseEtaFixedPhaseCore n :=
  invariantCutoffTimesOrbitSection n
    upstairsAllIndexCoreCutoffSmoothQuotient
    upstairsAllIndexCoreCutoffSmoothQuotient_invariant
    (inverseEtaPaperOrbitAllIndexSeedSection n)
    (inverseEtaPaperOrbitAllIndexSeedSection_realSmooth n)

@[simp]
theorem compactInverseEtaFixedPhaseCoreAllIndex_apply
    (n : ℤ) (z : ℍ) :
    ((compactInverseEtaFixedPhaseCoreAllIndex n :
        InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction) z =
      upstairsAllIndexCoreCutoff z *
        (fixedPhaseIntegralWeightFactor n z * inverseEtaSection z) :=
  rfl

theorem compactInverseEtaFixedPhaseCoreAllIndex_ne_zero (n : ℤ) :
    compactInverseEtaFixedPhaseCoreAllIndex n ≠
      (0 : InverseEtaFixedPhaseCore n) := by
  exact invariantCutoffTimesOrbitSection_ne_zero n
    upstairsAllIndexCoreCutoffSmoothQuotient
    upstairsAllIndexCoreCutoffSmoothQuotient_invariant
    (inverseEtaPaperOrbitAllIndexSeedSection n)
    (inverseEtaPaperOrbitAllIndexSeedSection_realSmooth n)
    fixedPhaseGeneratorPoint
    upstairsAllIndexCoreCutoff_at_point_ne_zero
    (inverseEtaPaperOrbitAllIndexSeedSection_at_point_ne_zero n)

theorem exists_ne_zero_inverseEtaFixedPhaseCore (n : ℤ) :
    ∃ u : InverseEtaFixedPhaseCore n, u ≠ 0 :=
  ⟨compactInverseEtaFixedPhaseCoreAllIndex n,
    compactInverseEtaFixedPhaseCoreAllIndex_ne_zero n⟩

/-- A theorem-valued `Nontrivial` witness avoids overlapping the existing
specialized orbit-zero instance while making all-index nontriviality directly
available to downstream constructions. -/
noncomputable def inverseEtaFixedPhaseCoreNontrivial (n : ℤ) :
    Nontrivial (InverseEtaFixedPhaseCore n) :=
  ⟨⟨compactInverseEtaFixedPhaseCoreAllIndex n, 0,
    compactInverseEtaFixedPhaseCoreAllIndex_ne_zero n⟩⟩

end ExplicitDiscriminantPotential
end AutomorphicSobolev
end PaperCorrections

