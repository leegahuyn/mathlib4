/-!
P5 physical Rellich closure fragment.

This fragment is merged into `Mock2_FunctionalAnalysis_Integrated.lean`.  It
contains the quantitative geometric estimates used before the finite-chart
Fourier argument.  In particular the constants below are extracted from the
literal compact three-cusp stage; no abstract ``bounded geometry'' field is
introduced.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5PhysicalHardStageRestriction

open Set Function Topology Filter MeasureTheory
open scoped ENNReal NNReal
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open GammaTwoQuotientGeometry
open FixedPhaseClosedOperators
open PhysicalLocalL2
open FixedPhaseReducedChartFriedrichs
open FixedPhaseAffineFriedrichs

/-! ### One literal smooth localization, including the paired-side points

The localization below is a finite sum of members of the genuine reduced
quotient-chart partition of unity.  In particular it is not a bump chosen in
the interior of one fundamental polygon.  Its support is compact in the open
upper half-plane, while its value is exactly one on the whole literal stage.
This is the point at which paired sides are handled before any zero extension
to the ambient plane is made. -/

/-- A fixed smooth reduced-chart partition for the literal compact stage. -/
noncomputable def literalStagePartition (Y : ℝ) :
    SmoothPartitionOfUnity ℍ 𝐘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' gammaTwoThreeCuspTruncation Y) :=
  Classical.choose
    (exists_smoothPartitionOfUnity_gammaTwoReducedChart
      (gammaTwoThreeCuspTruncation_isCompact Y))

theorem literalStagePartition_isSubordinate (Y : ℝ) :
    (literalStagePartition Y).IsSubordinate
      ambientGammaTwoReducedChart :=
  (Classical.choose_spec
    (exists_smoothPartitionOfUnity_gammaTwoReducedChart
      (gammaTwoThreeCuspTruncation_isCompact Y))).1

theorem literalStagePartition_hasCompactSupport (Y : ℝ) (z : ℍ) :
    HasCompactSupport (literalStagePartition Y z : ℂ → ℝ) :=
  (Classical.choose_spec
    (exists_smoothPartitionOfUnity_gammaTwoReducedChart
      (gammaTwoThreeCuspTruncation_isCompact Y))).2.1 z

/-- Exactly the partition members whose topological support meets the literal
stage.  This set is finite by local finiteness on a compact set. -/
def literalStageActiveCenterSet (Y : ℝ) : Set ℍ :=
  {z : ℍ |
    (tsupport (literalStagePartition Y z : ℂ → ℝ) ∩
      (UpperHalfPlane.coe '' gammaTwoThreeCuspTruncation Y)).Nonempty}

theorem literalStageActiveCenterSet_finite (Y : ℝ) :
    (literalStageActiveCenterSet Y).Finite :=
  (Classical.choose_spec
    (exists_smoothPartitionOfUnity_gammaTwoReducedChart
      (gammaTwoThreeCuspTruncation_isCompact Y))).2.2

/-- The active center set as a literal finite index set. -/
noncomputable def literalStageActiveCenters (Y : ℝ) : Finset ℍ :=
  (literalStageActiveCenterSet_finite Y).toFinset

@[simp]
theorem mem_literalStageActiveCenters_iff (Y : ℝ) (z : ℍ) :
    z ∈ literalStageActiveCenters Y ↔
      (tsupport (literalStagePartition Y z : ℂ → ℝ) ∩
        (UpperHalfPlane.coe '' gammaTwoThreeCuspTruncation Y)).Nonempty := by
  classical
  rw [literalStageActiveCenters, Set.Finite.mem_toFinset]
  rfl

/-- Finite real localization obtained from all and only the partition pieces
meeting the literal stage. -/
noncomputable def literalStageCutoffReal (Y : ℝ) : ℂ → ℝ :=
  fun w ↦ ∑ z ∈ literalStageActiveCenters Y,
    literalStagePartition Y z w

theorem literalStageCutoffReal_contDiff (Y : ℝ) :
    ContDiff ℝ ∞ (literalStageCutoffReal Y) := by
  classical
  unfold literalStageCutoffReal
  fun_prop

theorem literalStageCutoffReal_hasCompactSupport (Y : ℝ) :
    HasCompactSupport (literalStageCutoffReal Y) := by
  classical
  unfold literalStageCutoffReal
  induction literalStageActiveCenters Y using Finset.induction_on with
  | empty => simp [HasCompactSupport]
  | @insert z s hz ih =>
      simpa only [Finset.sum_insert hz, Finset.sum_apply] using
        (literalStagePartition_hasCompactSupport Y z).add ih

theorem tsupport_literalStageCutoffReal_subset_upperPlaneOpen (Y : ℝ) :
    tsupport (literalStageCutoffReal Y) ⊆
      HalfWeightCompactCoordinateGreen.upperPlaneOpen := by
  classical
  unfold literalStageCutoffReal
  induction literalStageActiveCenters Y using Finset.induction_on with
  | empty => simp
  | @insert z s hz ih =>
      simpa only [Finset.sum_insert hz, Finset.sum_apply] using
        (tsupport_add
          (literalStagePartition Y z : ℂ → ℝ)
          (fun w ↦ ∑ x ∈ s, literalStagePartition Y x w)).trans
          (Set.union_subset
            ((literalStagePartition_isSubordinate Y z).trans
              (ambientGammaTwoReducedChart_subset_upperPlaneOpen z))
            ih)

/-- The finite localization is exactly one at every point of the closed
literal stage.  The proof reduces the locally finite `finsum` to the explicit
active `Finset`; no boundary point is discarded. -/
theorem literalStageCutoffReal_eq_one (Y : ℝ) {z : ℍ}
    (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    literalStageCutoffReal Y (z : ℂ) = 1 := by
  classical
  have hsupport :
      Function.support (fun x : ℍ ↦ literalStagePartition Y x (z : ℂ)) ⊆
        (literalStageActiveCenters Y : Set ℍ) := by
    intro x hx
    exact (mem_literalStageActiveCenters_iff Y x).2
      ⟨(z : ℂ), subset_closure hx, ⟨z, hz, rfl⟩⟩
  calc
    literalStageCutoffReal Y (z : ℂ) =
        ∑ x ∈ literalStageActiveCenters Y,
          literalStagePartition Y x (z : ℂ) := rfl
    _ = ∑ᶠ x : ℍ, literalStagePartition Y x (z : ℂ) :=
      (finsum_eq_sum_of_support_subset _ hsupport).symm
    _ = 1 := smoothPartitionOfUnity_sum_eq_one_on_compact
      (literalStagePartition Y) (literalStagePartition_isSubordinate Y)
      ⟨z, hz, rfl⟩

/-- Complexified localization as an actual ambient `C_c^∞` test. -/
noncomputable def literalStageCutoff (Y : ℝ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore where
  toFun := Complex.ofRealCLM ∘ literalStageCutoffReal Y
  contDiff' := Complex.ofRealCLM.contDiff.comp
    (literalStageCutoffReal_contDiff Y)
  hasCompactSupport' :=
    (literalStageCutoffReal_hasCompactSupport Y).comp_left rfl
  tsupport_subset' :=
    (tsupport_comp_subset rfl (literalStageCutoffReal Y)).trans
      (tsupport_literalStageCutoffReal_subset_upperPlaneOpen Y)

@[simp]
theorem literalStageCutoff_apply (Y : ℝ) (w : ℂ) :
    literalStageCutoff Y w =
      ((literalStageCutoffReal Y w : ℝ) : ℂ) :=
  rfl

@[simp]
theorem literalStageCutoff_eq_one (Y : ℝ) {z : ℍ}
    (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    literalStageCutoff Y (z : ℂ) = 1 := by
  rw [literalStageCutoff_apply, literalStageCutoffReal_eq_one Y hz]
  norm_num

/-! ### The compactly supported global gauge localization -/

/-- Multiply the actual global Euclidean gauge by the paired-side-safe
localization.  `localizeLeft` performs the zero extension only after the
compact factor has been shown to live in the open upper half-plane. -/
noncomputable def literalStageLocalizedGauge
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  HalfWeightCompactCoordinateGreen.localizeLeft
    (fixedPhaseEuclideanGauge n u)
    (fixedPhaseEuclideanGauge_realSmooth n u)
    (literalStageCutoff Y)

@[simp]
theorem literalStageLocalizedGauge_apply
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (w : ℂ) :
    literalStageLocalizedGauge Y n u w =
      upperLift (fixedPhaseEuclideanGauge n u) w *
        literalStageCutoff Y w :=
  rfl

theorem literalStageLocalizedGauge_eq_gauge
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    literalStageLocalizedGauge Y n u (z : ℂ) =
      fixedPhaseEuclideanGauge n u z := by
  rw [literalStageLocalizedGauge_apply, upperLift_apply,
    literalStageCutoff_eq_one Y hz, mul_one]

/-- The support of every localized gauge lies in one fixed compact set,
independent of the graph-core vector. -/
theorem tsupport_literalStageLocalizedGauge_subset_cutoff
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    tsupport (literalStageLocalizedGauge Y n u : ℂ → ℂ) ⊆
      tsupport (literalStageCutoff Y : ℂ → ℂ) :=
  tsupport_mul_subset_right

/-- One honest uniform bound for the cutoff and its two real derivatives.
The constant is extracted from compact support and continuity, rather than
stored as a bounded-geometry field. -/
theorem exists_literalStageCutoffC1Bound (Y : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ w : ℂ,
      ‖literalStageCutoff Y w‖ ≤ C ∧
      ‖HalfWeightCompactCoordinateGreen.dx (literalStageCutoff Y) w‖ ≤ C ∧
      ‖HalfWeightCompactCoordinateGreen.dy (literalStageCutoff Y) w‖ ≤ C := by
  obtain ⟨C₀, hC₀⟩ :=
    (literalStageCutoff Y).hasCompactSupport.exists_bound_of_continuous
      (literalStageCutoff Y).continuous
  obtain ⟨C₁, hC₁⟩ :=
    (HalfWeightCompactCoordinateGreen.dx
      (literalStageCutoff Y)).hasCompactSupport.exists_bound_of_continuous
        (HalfWeightCompactCoordinateGreen.dx
          (literalStageCutoff Y)).continuous
  obtain ⟨C₂, hC₂⟩ :=
    (HalfWeightCompactCoordinateGreen.dy
      (literalStageCutoff Y)).hasCompactSupport.exists_bound_of_continuous
        (HalfWeightCompactCoordinateGreen.dy
          (literalStageCutoff Y)).continuous
  refine ⟨max 0 (max C₀ (max C₁ C₂)), le_max_left _ _, ?_⟩
  intro w
  exact ⟨
    (hC₀ w).trans
      ((le_max_left C₀ (max C₁ C₂)).trans
        (le_max_right 0 (max C₀ (max C₁ C₂)))),
    (hC₁ w).trans
      ((le_max_left C₁ C₂).trans
        ((le_max_right C₀ (max C₁ C₂)).trans
          (le_max_right 0 (max C₀ (max C₁ C₂))))),
    (hC₂ w).trans
      ((le_max_right C₁ C₂).trans
        ((le_max_right C₀ (max C₁ C₂)).trans
          (le_max_right 0 (max C₀ (max C₁ C₂)))))⟩

/-- Canonically selected `C¹` cutoff bound. -/
noncomputable def literalStageCutoffC1Bound (Y : ℝ) : ℝ :=
  Classical.choose (exists_literalStageCutoffC1Bound Y)

theorem literalStageCutoffC1Bound_nonneg (Y : ℝ) :
    0 ≤ literalStageCutoffC1Bound Y :=
  (Classical.choose_spec (exists_literalStageCutoffC1Bound Y)).1

theorem norm_literalStageCutoff_le (Y : ℝ) (w : ℂ) :
    ‖literalStageCutoff Y w‖ ≤ literalStageCutoffC1Bound Y :=
  (Classical.choose_spec (exists_literalStageCutoffC1Bound Y)).2 w |>.1

theorem norm_dx_literalStageCutoff_le (Y : ℝ) (w : ℂ) :
    ‖HalfWeightCompactCoordinateGreen.dx (literalStageCutoff Y) w‖ ≤
      literalStageCutoffC1Bound Y :=
  (Classical.choose_spec (exists_literalStageCutoffC1Bound Y)).2 w |>.2.1

theorem norm_dy_literalStageCutoff_le (Y : ℝ) (w : ℂ) :
    ‖HalfWeightCompactCoordinateGreen.dy (literalStageCutoff Y) w‖ ≤
      literalStageCutoffC1Bound Y :=
  (Classical.choose_spec (exists_literalStageCutoffC1Bound Y)).2 w |>.2.2

/-! ### Positive height on the whole localization support

The derivative product rule is used on `tsupport χ_Y`, rather than merely on
the smaller set `F_Y`.  We therefore extract its own positive lower height.
This is the small but essential buffer which prevents division by the height
from becoming a hidden premise in the planar `H¹` estimate. -/

/-- The compact support of the paired-side-safe localization has a positive
lower height.  The empty-support case is included. -/
theorem exists_literalStageCutoffSupport_height_bounds (Y : ℝ) :
    ∃ y₀ y₁ : ℝ, 0 < y₀ ∧
      ∀ w ∈ tsupport (literalStageCutoff Y : ℂ → ℂ),
        y₀ ≤ w.im ∧ w.im ≤ y₁ := by
  let K : Set ℂ := tsupport (literalStageCutoff Y : ℂ → ℂ)
  have hK : IsCompact K := (literalStageCutoff Y).hasCompactSupport
  by_cases hne : K.Nonempty
  · obtain ⟨w₀, hw₀, hw₀min⟩ :=
      hK.exists_isMinOn hne Complex.continuous_im.continuousOn
    obtain ⟨w₁, hw₁, hw₁max⟩ :=
      hK.exists_isMaxOn hne Complex.continuous_im.continuousOn
    have hw₀pos : 0 < w₀.im :=
      tsupport_literalStageCutoffReal_subset_upperPlaneOpen Y <|
        (tsupport_comp_subset rfl (literalStageCutoffReal Y)) hw₀
    refine ⟨w₀.im, w₁.im, hw₀pos, ?_⟩
    intro w hw
    exact ⟨isMinOn_iff.mp hw₀min w hw,
      isMaxOn_iff.mp hw₁max w hw⟩
  · refine ⟨1, 1, zero_lt_one, ?_⟩
    intro w hw
    exact (hne ⟨w, hw⟩).elim

/-- Canonically selected positive lower height on `tsupport χ_Y`. -/
noncomputable def literalStageCutoffSupportLowerHeight (Y : ℝ) : ℝ :=
  Classical.choose (exists_literalStageCutoffSupport_height_bounds Y)

/-- Canonically selected upper height on `tsupport χ_Y`. -/
noncomputable def literalStageCutoffSupportUpperHeight (Y : ℝ) : ℝ :=
  Classical.choose (Classical.choose_spec
    (exists_literalStageCutoffSupport_height_bounds Y))

theorem literalStageCutoffSupportLowerHeight_pos (Y : ℝ) :
    0 < literalStageCutoffSupportLowerHeight Y :=
  (Classical.choose_spec (Classical.choose_spec
    (exists_literalStageCutoffSupport_height_bounds Y))).1

theorem literalStageCutoffSupport_height_mem_Icc (Y : ℝ) {w : ℂ}
    (hw : w ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    w.im ∈ Set.Icc (literalStageCutoffSupportLowerHeight Y)
      (literalStageCutoffSupportUpperHeight Y) :=
  (Classical.choose_spec (Classical.choose_spec
    (exists_literalStageCutoffSupport_height_bounds Y))).2 w hw

theorem literalStageCutoffSupportLowerHeight_le_im (Y : ℝ) {w : ℂ}
    (hw : w ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    literalStageCutoffSupportLowerHeight Y ≤ w.im :=
  (literalStageCutoffSupport_height_mem_Icc Y hw).1

/-! ### Exact product rules for the localized physical gauge -/

/-- Horizontal derivative of the actual localized gauge, evaluated upstairs.
This is a specialization of the already proved one-sided compact-localization
product rule. -/
theorem dx_literalStageLocalizedGauge_apply_upper
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    HalfWeightCompactCoordinateGreen.dx
        (literalStageLocalizedGauge Y n u) (z : ℂ) =
      dx (fixedPhaseEuclideanGauge n u) z * literalStageCutoff Y (z : ℂ) +
        fixedPhaseEuclideanGauge n u z *
          HalfWeightCompactCoordinateGreen.dx
            (literalStageCutoff Y) (z : ℂ) := by
  simpa only [HalfWeightCompactCoordinateGreen.dx,
    HalfWeightDifferentialOperators.dx] using
      HalfWeightCompactCoordinateGreen.directionalDerivative_localizeLeft_apply
        (fixedPhaseEuclideanGauge n u)
        (fixedPhaseEuclideanGauge_realSmooth n u)
        (literalStageCutoff Y) 1 z

/-- Vertical derivative counterpart. -/
theorem dy_literalStageLocalizedGauge_apply_upper
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    HalfWeightCompactCoordinateGreen.dy
        (literalStageLocalizedGauge Y n u) (z : ℂ) =
      dy (fixedPhaseEuclideanGauge n u) z * literalStageCutoff Y (z : ℂ) +
        fixedPhaseEuclideanGauge n u z *
          HalfWeightCompactCoordinateGreen.dy
            (literalStageCutoff Y) (z : ℂ) := by
  simpa only [HalfWeightCompactCoordinateGreen.dy,
    HalfWeightDifferentialOperators.dy] using
      HalfWeightCompactCoordinateGreen.directionalDerivative_localizeLeft_apply
        (fixedPhaseEuclideanGauge n u)
        (fixedPhaseEuclideanGauge_realSmooth n u)
        (literalStageCutoff Y) Complex.I z

/-! ### Literal lower and upper Euclidean heights on one stage -/

/-- Compactness and positivity of the upper-half-plane height give honest
positive lower and finite upper bounds on every literal stage.  The empty
case is included so this lemma is usable without a hidden nonemptiness
premise. -/
theorem exists_literalStage_height_bounds (Y : ℝ) :
    ∃ y₀ y₁ : ℝ, 0 < y₀ ∧
      ∀ z ∈ gammaTwoThreeCuspTruncation Y,
        y₀ ≤ z.im ∧ z.im ≤ y₁ := by
  by_cases hne : (gammaTwoThreeCuspTruncation Y).Nonempty
  · let K : Set ℍ := gammaTwoThreeCuspTruncation Y
    have hK : IsCompact K := literalStage_isCompact Y
    obtain ⟨z₀, hz₀, hz₀min⟩ :=
      hK.exists_isMinOn hne UpperHalfPlane.continuous_im.continuousOn
    obtain ⟨z₁, hz₁, hz₁max⟩ :=
      hK.exists_isMaxOn hne UpperHalfPlane.continuous_im.continuousOn
    refine ⟨z₀.im, z₁.im, z₀.im_pos, ?_⟩
    intro z hz
    exact ⟨isMinOn_iff.mp hz₀min z hz,
      isMaxOn_iff.mp hz₁max z hz⟩
  · refine ⟨1, 1, zero_lt_one, ?_⟩
    intro z hz
    exact (hne ⟨z, hz⟩).elim

/-- Canonically selected positive lower height of the literal stage. -/
noncomputable def literalStageLowerHeight (Y : ℝ) : ℝ :=
  Classical.choose (exists_literalStage_height_bounds Y)

/-- Canonically selected finite upper height of the literal stage. -/
noncomputable def literalStageUpperHeight (Y : ℝ) : ℝ :=
  Classical.choose (Classical.choose_spec
    (exists_literalStage_height_bounds Y))

theorem literalStageLowerHeight_pos (Y : ℝ) :
    0 < literalStageLowerHeight Y :=
  (Classical.choose_spec (Classical.choose_spec
    (exists_literalStage_height_bounds Y))).1

theorem literalStage_height_mem_Icc (Y : ℝ)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    z.im ∈ Set.Icc (literalStageLowerHeight Y)
      (literalStageUpperHeight Y) :=
  (Classical.choose_spec (Classical.choose_spec
    (exists_literalStage_height_bounds Y))).2 z hz

theorem literalStageLowerHeight_le_im (Y : ℝ)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    literalStageLowerHeight Y ≤ z.im :=
  (literalStage_height_mem_Icc Y hz).1

theorem im_le_literalStageUpperHeight (Y : ℝ)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    z.im ≤ literalStageUpperHeight Y :=
  (literalStage_height_mem_Icc Y hz).2

/-! ### Exact graph-density control of the two Euclidean derivatives -/

/-- The zero-order coefficient already used in the trace estimate is at
least three.  This elementary fact lets the same graph density dominate the
ordinary vertical derivative without changing its definition. -/
theorem three_le_logHeightTraceBaseCoeff (n : ℤ) :
    3 ≤ logHeightTraceBaseCoeff n := by
  unfold logHeightTraceBaseCoeff logHeightTraceDrift
    euclideanHorizontalDrift
  have hD : 0 ≤ |2 * (euclideanGaugeExponent n + 1)| := abs_nonneg _
  nlinarith [sq_nonneg ((7 : ℝ) / 2 +
    |2 * (euclideanGaugeExponent n + 1)| / 2)]

/-- The base coefficient also dominates the precise squared horizontal
zeroth-order drift occurring in the R/L reconstruction. -/
theorem three_quarters_horizontalDrift_sq_le_baseCoeff (n : ℤ) :
    (3 / 4 : ℝ) * euclideanHorizontalDrift n ^ 2 ≤
      logHeightTraceBaseCoeff n := by
  unfold logHeightTraceBaseCoeff logHeightTraceDrift
  have hD := euclideanHorizontalDrift_nonneg n
  nlinarith [sq_nonneg ((7 : ℝ) / 2 +
      euclideanHorizontalDrift n / 2),
    sq_nonneg ((7 : ℝ) / 2)]

/-- The literal graph density dominates the squared logarithmic horizontal
derivative pointwise.  Raising and lowering are the actual fixed-phase
operators, not independent derivative certificates. -/
theorem norm_height_mul_dx_sq_le_fixedPhaseEuclideanGraphDensity
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    ‖heightC z * dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      fixedPhaseEuclideanGraphDensity n u z := by
  let F := ‖fixedPhaseEuclideanGauge n u z‖
  let R := ‖fixedPhaseEuclideanGauge (n + 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u) z‖
  let L := ‖fixedPhaseEuclideanGauge (n - 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u) z‖
  let d := euclideanHorizontalDrift n
  have hpoint := norm_height_mul_dx_le_euclideanGraph n
    (fixedPhaseEuclideanGauge n u) z
  rw [← fixedPhaseEuclideanGauge_raise n u,
    ← fixedPhaseEuclideanGauge_lower_pred n u] at hpoint
  have hF : 0 ≤ F := norm_nonneg _
  have hR : 0 ≤ R := norm_nonneg _
  have hL : 0 ≤ L := norm_nonneg _
  have hd : 0 ≤ d := euclideanHorizontalDrift_nonneg n
  have hsquare :
      ‖heightC z * dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (3 / 4 : ℝ) * (R ^ 2 + L ^ 2 + d ^ 2 * F ^ 2) := by
    have hsum : (R + L + d * F) ^ 2 ≤
        3 * (R ^ 2 + L ^ 2 + (d * F) ^ 2) := by nlinarith
    nlinarith [sq_nonneg
      (‖heightC z * dx (fixedPhaseEuclideanGauge n u) z‖ -
        (R + L + d * F) / 2)]
  have hbase := three_quarters_horizontalDrift_sq_le_baseCoeff n
  unfold fixedPhaseEuclideanGraphDensity
  dsimp only [F, R, L, d] at hsquare ⊢
  calc
    _ ≤ (3 / 4 : ℝ) * (R ^ 2 + L ^ 2 + d ^ 2 * F ^ 2) := hsquare
    _ ≤ logHeightTraceBaseCoeff n * F ^ 2 + 3 * R ^ 2 + 3 * L ^ 2 := by
      nlinarith [sq_nonneg F, sq_nonneg R, sq_nonneg L,
        mul_le_mul_of_nonneg_right hbase (sq_nonneg F)]

/-- Vertical logarithmic derivative counterpart of the preceding estimate. -/
theorem norm_height_mul_dy_sq_le_fixedPhaseEuclideanGraphDensity
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    ‖heightC z * dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      fixedPhaseEuclideanGraphDensity n u z := by
  let F := ‖fixedPhaseEuclideanGauge n u z‖
  let R := ‖fixedPhaseEuclideanGauge (n + 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u) z‖
  let L := ‖fixedPhaseEuclideanGauge (n - 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u) z‖
  have hpoint := norm_height_mul_dy_le_euclideanGraph n
    (fixedPhaseEuclideanGauge n u) z
  rw [← fixedPhaseEuclideanGauge_raise n u,
    ← fixedPhaseEuclideanGauge_lower_pred n u] at hpoint
  have hF : 0 ≤ F := norm_nonneg _
  have hR : 0 ≤ R := norm_nonneg _
  have hL : 0 ≤ L := norm_nonneg _
  have hsquare :
      ‖heightC z * dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (3 / 4 : ℝ) * (R ^ 2 + L ^ 2 + 4 * F ^ 2) := by
    have hsum : (R + L + 2 * F) ^ 2 ≤
        3 * (R ^ 2 + L ^ 2 + (2 * F) ^ 2) := by nlinarith
    nlinarith [sq_nonneg
      (‖heightC z * dy (fixedPhaseEuclideanGauge n u) z‖ -
        (R + L) / 2 - F)]
  have hbase := three_le_logHeightTraceBaseCoeff n
  unfold fixedPhaseEuclideanGraphDensity
  dsimp only [F, R, L] at hsquare ⊢
  calc
    _ ≤ (3 / 4 : ℝ) * (R ^ 2 + L ^ 2 + 4 * F ^ 2) := hsquare
    _ ≤ logHeightTraceBaseCoeff n * F ^ 2 + 3 * R ^ 2 + 3 * L ^ 2 := by
      nlinarith [sq_nonneg F, sq_nonneg R, sq_nonneg L,
        mul_le_mul_of_nonneg_right hbase (sq_nonneg F)]

/-- On the literal stage, the ordinary horizontal derivative is controlled
by the same graph density with the explicit inverse lower-height factor. -/
theorem norm_dx_sq_le_literalStageLowerHeight_inv_sq_mul_graphDensity
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      (literalStageLowerHeight Y)⁻¹ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u z := by
  have hy₀ : 0 < literalStageLowerHeight Y :=
    literalStageLowerHeight_pos Y
  have hy : literalStageLowerHeight Y ≤ z.im :=
    literalStageLowerHeight_le_im Y hz
  have him : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, abs_of_pos z.im_pos]
  have hlog :=
    norm_height_mul_dx_sq_le_fixedPhaseEuclideanGraphDensity n u z
  rw [norm_mul, him, mul_pow] at hlog
  have hscale :
      ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (literalStageLowerHeight Y)⁻¹ ^ 2 *
          ((z.im) ^ 2 * ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
    have hzsq : literalStageLowerHeight Y ^ 2 ≤ z.im ^ 2 :=
      (sq_le_sq₀ hy₀.le z.im_pos.le).2 hy
    have hnorm : 0 ≤ ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 :=
      sq_nonneg _
    rw [inv_pow]
    calc
      _ = (literalStageLowerHeight Y ^ 2)⁻¹ *
          (literalStageLowerHeight Y ^ 2 *
            ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          field_simp [hy₀.ne']
      _ ≤ (literalStageLowerHeight Y ^ 2)⁻¹ *
          (z.im ^ 2 * ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          gcongr
  exact hscale.trans (mul_le_mul_of_nonneg_left hlog (sq_nonneg _))

/-- Vertical ordinary derivative counterpart. -/
theorem norm_dy_sq_le_literalStageLowerHeight_inv_sq_mul_graphDensity
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    {z : ℍ} (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      (literalStageLowerHeight Y)⁻¹ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u z := by
  have hy₀ : 0 < literalStageLowerHeight Y :=
    literalStageLowerHeight_pos Y
  have hy : literalStageLowerHeight Y ≤ z.im :=
    literalStageLowerHeight_le_im Y hz
  have him : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, abs_of_pos z.im_pos]
  have hlog :=
    norm_height_mul_dy_sq_le_fixedPhaseEuclideanGraphDensity n u z
  rw [norm_mul, him, mul_pow] at hlog
  have hscale :
      ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (literalStageLowerHeight Y)⁻¹ ^ 2 *
          ((z.im) ^ 2 * ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
    have hzsq : literalStageLowerHeight Y ^ 2 ≤ z.im ^ 2 :=
      (sq_le_sq₀ hy₀.le z.im_pos.le).2 hy
    have hnorm : 0 ≤ ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 :=
      sq_nonneg _
    rw [inv_pow]
    calc
      _ = (literalStageLowerHeight Y ^ 2)⁻¹ *
          (literalStageLowerHeight Y ^ 2 *
            ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          field_simp [hy₀.ne']
      _ ≤ (literalStageLowerHeight Y ^ 2)⁻¹ *
          (z.im ^ 2 * ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          gcongr
  exact hscale.trans (mul_le_mul_of_nonneg_left hlog (sq_nonneg _))

/-! ### The three planar coordinates of the localized gauge -/

/-- The zero-order coordinate is itself dominated by the literal graph
density. -/
theorem norm_fixedPhaseEuclideanGauge_sq_le_graphDensity
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    ‖fixedPhaseEuclideanGauge n u z‖ ^ 2 ≤
      fixedPhaseEuclideanGraphDensity n u z := by
  have hbase := three_le_logHeightTraceBaseCoeff n
  unfold fixedPhaseEuclideanGraphDensity
  nlinarith [sq_nonneg ‖fixedPhaseEuclideanGauge n u z‖,
    sq_nonneg ‖fixedPhaseEuclideanGauge (n + 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u) z‖,
    sq_nonneg ‖fixedPhaseEuclideanGauge (n - 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u) z‖]

/-- Ordinary horizontal derivative control on the entire cutoff support. -/
theorem norm_dx_sq_le_cutoffSupportLowerHeight_inv_sq_mul_graphDensity
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) {z : ℍ}
    (hz : (z : ℂ) ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u z := by
  have hy₀ : 0 < literalStageCutoffSupportLowerHeight Y :=
    literalStageCutoffSupportLowerHeight_pos Y
  have hy : literalStageCutoffSupportLowerHeight Y ≤ z.im :=
    literalStageCutoffSupportLowerHeight_le_im Y hz
  have him : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, abs_of_pos z.im_pos]
  have hlog :=
    norm_height_mul_dx_sq_le_fixedPhaseEuclideanGraphDensity n u z
  rw [norm_mul, him, mul_pow] at hlog
  have hscale :
      ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2 *
          (z.im ^ 2 * ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
    have hzsq : literalStageCutoffSupportLowerHeight Y ^ 2 ≤ z.im ^ 2 :=
      (sq_le_sq₀ hy₀.le z.im_pos.le).2 hy
    rw [inv_pow]
    calc
      _ = (literalStageCutoffSupportLowerHeight Y ^ 2)⁻¹ *
          (literalStageCutoffSupportLowerHeight Y ^ 2 *
            ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          field_simp [hy₀.ne']
      _ ≤ (literalStageCutoffSupportLowerHeight Y ^ 2)⁻¹ *
          (z.im ^ 2 * ‖dx (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
          gcongr
  exact hscale.trans (mul_le_mul_of_nonneg_left hlog (sq_nonneg _))

/-- Ordinary vertical derivative control on the entire cutoff support. -/
theorem norm_dy_sq_le_cutoffSupportLowerHeight_inv_sq_mul_graphDensity
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) {z : ℍ}
    (hz : (z : ℂ) ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
      (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u z := by
