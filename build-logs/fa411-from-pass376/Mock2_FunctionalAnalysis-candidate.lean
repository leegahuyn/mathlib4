/-!
## P9: a bounded resolvent point and the exact elliptic-regularity boundary

Mathlib's present `LinearPMap` API provides domains, graphs, Hilbert adjoints,
closedness, closures, and cores.  It does not presently provide an unbounded
operator spectrum or an unbounded resolvent object.  Consequently this file
does two things without adding an oracle:

* it defines the standard bounded-resolvent-at-a-point interface and constructs
  it for the actual Petersson form realization at the explicit coercive mass
  point;
* it identifies the missing smooth operator-core / interior-and-cusp elliptic
  regularity theorem exactly with self-adjointness of the maximal realization
  and with equality of the associated and maximal operators.

The constructed resolvent is an actual `ContinuousLinearMap`, is injective,
has dense range, has norm at most one, and is self-adjoint.  Hence Mathlib's
bounded self-adjoint eigenspace API applies to it.  No compact-resolvent,
discrete-spectrum, finite-multiplicity, interior regularity, or cusp regularity
claim is inserted.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P9BoundedResolventAndRegularityBoundary

open scoped LinearPMap
open ComplexLaxMilgram
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open ActualScalarDiscriminantPDE
open ExplicitDiscriminantPotential.FixedPhaseGraphPotential
open P9ClosedFormRealization
open P9ClosedFormRealization.ActualModularEndpoint
open P9MinimalMaximalCore

noncomputable section

/-! ### A literal bounded resolvent interface for `LinearPMap` -/

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A bounded two-sided inverse for the partial shift `A - z`.  Domain
membership is exposed in both inverse identities.  This is the usual
resolvent-at-a-point property, stated directly because Mathlib currently has
no unbounded-spectrum structure for `LinearPMap`. -/
structure BoundedPartialResolventAt (A : H →ₗ.[ℂ] H) (z : ℂ) where
  /-- The everywhere-defined bounded inverse. -/
  inverse : H →L[ℂ] H
  /-- Its values lie in the literal partial domain. -/
  inverse_mem_domain : ∀ y : H, inverse y ∈ A.domain
  /-- Applying the shifted partial operator after the inverse gives the input. -/
  apply_inverse : ∀ y : H,
    A ⟨inverse y, inverse_mem_domain y⟩ - z • inverse y = y
  /-- Applying the inverse after the shifted partial operator gives the
  original domain vector. -/
  inverse_apply : ∀ x : A.domain,
    inverse (A x - z • (x : H)) = (x : H)

/-- The honest resolvent set associated with the preceding bounded two-sided
inverse interface. -/
def partialResolventSet (A : H →ₗ.[ℂ] H) : Set ℂ :=
  {z | Nonempty (BoundedPartialResolventAt A z)}

namespace BoundedPartialResolventAt

variable {A : H →ₗ.[ℂ] H} {z : ℂ}

/-- A bounded partial resolvent is injective as an everywhere-defined map. -/
theorem inverse_injective (R : BoundedPartialResolventAt A z) :
    Function.Injective R.inverse := by
  intro x y hxy
  have hx := R.apply_inverse x
  have hy := R.apply_inverse y
  have hdom :
      (⟨R.inverse x, R.inverse_mem_domain x⟩ : A.domain) =
        ⟨R.inverse y, R.inverse_mem_domain y⟩ :=
    Subtype.ext hxy
  rw [hdom, hxy] at hx
  exact hx.symm.trans hy

/-- If the original partial domain is dense, then the range of every bounded
resolvent is dense. -/
theorem inverse_denseRange
    (R : BoundedPartialResolventAt A z)
    (hDense : Dense (A.domain : Set H)) :
    DenseRange R.inverse := by
  apply hDense.mono
  intro x hx
  let xd : A.domain := ⟨x, hx⟩
  refine ⟨A xd - z • x, ?_⟩
  simpa only [xd] using R.inverse_apply xd

/-- The range of a bounded partial resolvent is exactly the partial domain. -/
theorem range_eq_domain (R : BoundedPartialResolventAt A z) :
    Set.range R.inverse = (A.domain : Set H) := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact R.inverse_mem_domain y
  · intro hx
    let xd : A.domain := ⟨x, hx⟩
    refine ⟨A xd - z • x, ?_⟩
    simpa only [xd] using R.inverse_apply xd

end BoundedPartialResolventAt

/-! ### The explicit coercive Petersson resolvent -/

/-- The canonical pivot embedding is exactly the ambient anti-dual used by
the embedded-form Lax--Milgram construction. -/
theorem peterssonPivotEmbedding_eq_embeddedAntiDual
    (n : ℤ) (y : OrbitPeterssonHilbert n) :
    peterssonPivotEmbedding n y =
      embeddedAntiDual (baseExtension n) y := by
  ext v
  rfl

/-- The bounded inverse of
`modularAssociatedOperator n t + discriminantMassShift t`.  It is the
composition of the literal pivot embedding, the inverse coercive form
equivalence, and the completed Petersson base coordinate. -/
noncomputable def modularMassResolvent (n : ℤ) (t : ℝ) :
    OrbitPeterssonHilbert n →L[ℂ] OrbitPeterssonHilbert n :=
  (baseExtension n).comp
    ((coerciveFormEquiv 1
        (embeddedShiftedForm (baseExtension n)
          (weakSchrodingerOperator n t) (discriminantMassShift t))
        (weakSchrodinger_embeddedMassShift_coercive n t)).symm.toContinuousLinearMap.comp
      (peterssonPivotEmbedding n))

/-- Pointwise identification with the already proved Lax--Milgram solution. -/
theorem modularMassResolvent_apply
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    modularMassResolvent n t y =
      baseExtension n
        (embeddedFormResolventSolution
          (baseExtension n) (weakSchrodingerOperator n t)
          (discriminantMassShift t) 1
          (weakSchrodinger_embeddedMassShift_coercive n t) y) := by
  rw [modularMassResolvent]
  simp only [ContinuousLinearMap.comp_apply,
    ContinuousLinearEquiv.coe_coe]
  rw [peterssonPivotEmbedding_eq_embeddedAntiDual,
    coerciveFormEquiv_symm_apply]

/-- The canonical resolvent value and its represented operator value form a
literal graph point. -/
theorem modularMassResolvent_graph
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    (modularMassResolvent n t y,
        y - (discriminantMassShift t : ℂ) • modularMassResolvent n t y) ∈
      (modularAssociatedOperator n t).graph := by
  rw [modularMassResolvent_apply, modularAssociatedOperator,
    associatedFormOperator_graph_eq]
  exact embeddedFormResolventSolution_mem_associatedGraph
    (baseExtension n) (weakSchrodingerOperator n t)
    (discriminantMassShift t) 1
    (weakSchrodinger_embeddedMassShift_coercive n t) y

/-- Every bounded resolvent value belongs to the exact representability
domain, with no additional regularity hypothesis. -/
theorem modularMassResolvent_mem_domain
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    modularMassResolvent n t y ∈
      (modularAssociatedOperator n t).domain :=
  LinearPMap.mem_domain_of_mem_graph
    (modularMassResolvent_graph n t y)

/-- Domain-valued form of the canonical resolvent. -/
noncomputable def modularMassResolventDomainValue
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    (modularAssociatedOperator n t).domain :=
  ⟨modularMassResolvent n t y,
    modularMassResolvent_mem_domain n t y⟩

@[simp]
theorem modularMassResolventDomainValue_coe
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    (modularMassResolventDomainValue n t y : OrbitPeterssonHilbert n) =
      modularMassResolvent n t y :=
  rfl

/-- Exact right-inverse equation for the real coercive shift. -/
theorem modularMassResolvent_spec
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    (discriminantMassShift t : ℂ) • modularMassResolvent n t y +
        modularAssociatedOperator n t
          (modularMassResolventDomainValue n t y) = y := by
  have hCanonical :=
    (modularAssociatedOperator n t).mem_graph
      (modularMassResolventDomainValue n t y)
  have hValue := (modularAssociatedOperator n t).mem_graph_snd_inj
    hCanonical (modularMassResolvent_graph n t y) rfl
  change modularAssociatedOperator n t
      (modularMassResolventDomainValue n t y) =
        y - (discriminantMassShift t : ℂ) •
          modularMassResolvent n t y at hValue
  rw [hValue]
  abel

/-- Exact left-inverse equation on the full represented operator domain. -/
theorem modularMassResolvent_leftInverse
    (n : ℤ) (t : ℝ)
    (x : (modularAssociatedOperator n t).domain) :
    modularMassResolvent n t
        ((discriminantMassShift t : ℂ) •
            (x : OrbitPeterssonHilbert n) +
          modularAssociatedOperator n t x) =
      (x : OrbitPeterssonHilbert n) := by
  have hxGraph := (modularAssociatedOperator n t).mem_graph x
  rcases (mem_modularAssociatedOperator_graph_iff n t
      (x : OrbitPeterssonHilbert n)
      (modularAssociatedOperator n t x)).mp hxGraph with
    ⟨u, hu, hForm⟩
  let S := embeddedShiftedForm (baseExtension n)
    (weakSchrodingerOperator n t) (discriminantMassShift t)
  let E := coerciveFormEquiv 1 S
    (weakSchrodinger_embeddedMassShift_coercive n t)
  have hEu :
      E u = peterssonPivotEmbedding n
        ((discriminantMassShift t : ℂ) •
            (x : OrbitPeterssonHilbert n) +
          modularAssociatedOperator n t x) := by
    ext v
    change S u v = inner ℂ (baseExtension n v)
      ((discriminantMassShift t : ℂ) •
          (x : OrbitPeterssonHilbert n) +
        modularAssociatedOperator n t x)
    have hForm' :
        weakSchrodingerOperator n t u v =
          inner ℂ (baseExtension n v)
            (modularAssociatedOperator n t x) := by
      simpa only [weakSchrodingerOperator_apply] using hForm v
    rw [S, embeddedShiftedForm_apply, hForm', hu]
    simp only [inner_add_right, inner_smul_right]
    ring
  have hInverse :
      E.symm (peterssonPivotEmbedding n
        ((discriminantMassShift t : ℂ) •
            (x : OrbitPeterssonHilbert n) +
          modularAssociatedOperator n t x)) = u := by
    apply E.injective
    rw [E.apply_symm_apply, hEu]
  change baseExtension n
      (E.symm (peterssonPivotEmbedding n
        ((discriminantMassShift t : ℂ) •
            (x : OrbitPeterssonHilbert n) +
          modularAssociatedOperator n t x))) =
    (x : OrbitPeterssonHilbert n)
  rw [hInverse, hu]

/-- The concrete mass resolvent is a genuine bounded partial resolvent at the
spectral point `-discriminantMassShift t`. -/
noncomputable def modularBoundedPartialResolvent
    (n : ℤ) (t : ℝ) :
    BoundedPartialResolventAt (modularAssociatedOperator n t)
      (-(discriminantMassShift t : ℂ)) where
  inverse := modularMassResolvent n t
  inverse_mem_domain := modularMassResolvent_mem_domain n t
  apply_inverse y := by
    have h := modularMassResolvent_spec n t y
    simpa only [neg_smul, sub_neg_eq_add, add_comm] using h
  inverse_apply x := by
    have h := modularMassResolvent_leftInverse n t x
    simpa only [neg_smul, sub_neg_eq_add, add_comm] using h

/-- Explicit membership of the real mass point in the honest partial
resolvent set. -/
theorem neg_discriminantMassShift_mem_partialResolventSet
    (n : ℤ) (t : ℝ) :
    -(discriminantMassShift t : ℂ) ∈
      partialResolventSet (modularAssociatedOperator n t) :=
  ⟨modularBoundedPartialResolvent n t⟩

/-- The explicit mass resolvent is injective. -/
theorem modularMassResolvent_injective (n : ℤ) (t : ℝ) :
    Function.Injective (modularMassResolvent n t) :=
  (modularBoundedPartialResolvent n t).inverse_injective

/-- Its range is exactly the represented operator domain. -/
theorem modularMassResolvent_range_eq_domain (n : ℤ) (t : ℝ) :
    Set.range (modularMassResolvent n t) =
      ((modularAssociatedOperator n t).domain :
        Set (OrbitPeterssonHilbert n)) :=
  (modularBoundedPartialResolvent n t).range_eq_domain

/-- In particular the bounded mass resolvent has dense range. -/
theorem modularMassResolvent_denseRange (n : ℤ) (t : ℝ) :
    DenseRange (modularMassResolvent n t) :=
  (modularBoundedPartialResolvent n t).inverse_denseRange
    (modularAssociatedOperator_dense_domain n t)

/-- Sharp contractive estimate inherited from the graph norm, the pivot
embedding, and the coercivity constant one. -/
theorem norm_modularMassResolvent_apply_le
    (n : ℤ) (t : ℝ) (y : OrbitPeterssonHilbert n) :
    ‖modularMassResolvent n t y‖ ≤ ‖y‖ := by
  rw [modularMassResolvent]
  simp only [ContinuousLinearMap.comp_apply,
    ContinuousLinearEquiv.coe_coe]
  calc
    ‖baseExtension n
        ((coerciveFormEquiv 1
          (embeddedShiftedForm (baseExtension n)
            (weakSchrodingerOperator n t) (discriminantMassShift t))
          (weakSchrodinger_embeddedMassShift_coercive n t)).symm
            (peterssonPivotEmbedding n y))‖ ≤
        ‖(coerciveFormEquiv 1
          (embeddedShiftedForm (baseExtension n)
            (weakSchrodingerOperator n t) (discriminantMassShift t))
          (weakSchrodinger_embeddedMassShift_coercive n t)).symm
            (peterssonPivotEmbedding n y)‖ :=
      norm_baseExtension_le n _
    _ ≤ ‖peterssonPivotEmbedding n y‖ := by
      simpa only [inv_one, one_mul] using
        coerciveFormEquiv_symm_norm_le 1
          (embeddedShiftedForm (baseExtension n)
            (weakSchrodingerOperator n t) (discriminantMassShift t))
          (weakSchrodinger_embeddedMassShift_coercive n t)
          (peterssonPivotEmbedding n y)
    _ ≤ ‖y‖ := norm_peterssonPivotEmbedding_apply_le n y

/-- Operator-norm form of the same contractive estimate. -/
theorem norm_modularMassResolvent_le_one (n : ℤ) (t : ℝ) :
    ‖modularMassResolvent n t‖ ≤ 1 := by
  exact ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun y ↦ by
    simpa only [one_mul] using norm_modularMassResolvent_apply_le n t y

/-- Formal symmetry of the actual represented operator, rewritten in the
orientation used in the bounded-resolvent calculation. -/
theorem modularAssociatedOperator_inner_swap
    (n : ℤ) (t : ℝ)
    (x y : (modularAssociatedOperator n t).domain) :
    inner ℂ (modularAssociatedOperator n t x)
        (y : OrbitPeterssonHilbert n) =
      inner ℂ (x : OrbitPeterssonHilbert n)
        (modularAssociatedOperator n t y) :=
  modularAssociatedOperator_isFormalAdjoint n t x y

/-- The bounded mass resolvent is symmetric. -/
theorem modularMassResolvent_isSymmetric (n : ℤ) (t : ℝ) :
    (modularMassResolvent n t :
      OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n).IsSymmetric := by
  intro x y
  let rx := modularMassResolventDomainValue n t x
  let ry := modularMassResolventDomainValue n t y
  have hx :
      (discriminantMassShift t : ℂ) •
          (rx : OrbitPeterssonHilbert n) +
        modularAssociatedOperator n t rx = x := by
    simpa only [rx, modularMassResolventDomainValue_coe] using
      modularMassResolvent_spec n t x
  have hy :
      (discriminantMassShift t : ℂ) •
          (ry : OrbitPeterssonHilbert n) +
        modularAssociatedOperator n t ry = y := by
    simpa only [ry, modularMassResolventDomainValue_coe] using
      modularMassResolvent_spec n t y
  change inner ℂ (rx : OrbitPeterssonHilbert n) y =
    inner ℂ x (ry : OrbitPeterssonHilbert n)
  rw [← hx, ← hy]
  simp only [inner_add_left, inner_add_right, inner_smul_left,
    inner_smul_right, map_ofReal]
  rw [modularAssociatedOperator_inner_swap n t rx ry]

/-- Since it is bounded and everywhere defined, symmetry upgrades through
Mathlib's Hilbert-adjoint API to self-adjointness. -/
theorem modularMassResolvent_isSelfAdjoint (n : ℤ) (t : ℝ) :
    IsSelfAdjoint (modularMassResolvent n t) :=
  (modularMassResolvent_isSymmetric n t).isSelfAdjoint

/-! ### Actual bounded point-spectral consequences from Mathlib -/

/-- Every eigenvalue of the bounded mass resolvent is real.  This uses
Mathlib's `LinearMap.IsSymmetric.conj_eigenvalue_eq_self` theorem directly. -/
theorem modularMassResolvent_eigenvalue_conj_eq_self
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasEigenvalue
      (modularMassResolvent n t :
        OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n) μ) :
    star μ = μ :=
  (modularMassResolvent_isSymmetric n t).conj_eigenvalue_eq_self hμ

/-- Zero is not an eigenvalue of the mass resolvent.  Notice that this does
not say that zero is outside its bounded-operator spectrum: the range is dense
and equals the generally proper unbounded-operator domain. -/
theorem modularMassResolvent_eigenvalue_ne_zero
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasEigenvalue
      (modularMassResolvent n t :
        OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n) μ) :
    μ ≠ 0 := by
  intro hμ0
  obtain ⟨v, hv, hv0⟩ := hμ.exists_hasEigenvector
  rw [LinearMap.mem_eigenspace_iff] at hv
  have hvImage : modularMassResolvent n t v =
      modularMassResolvent n t 0 := by
    rw [hv, hμ0]
    simp
  exact hv0 ((modularMassResolvent_injective n t) hvImage)

/-- Every point-spectral value of the contractive mass resolvent lies in the
closed unit disk. -/
theorem modularMassResolvent_eigenvalue_norm_le_one
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasEigenvalue
      (modularMassResolvent n t :
        OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n) μ) :
    ‖μ‖ ≤ 1 := by
  obtain ⟨v, hv, hv0⟩ := hμ.exists_hasEigenvector
  rw [LinearMap.mem_eigenspace_iff] at hv
  have hBound := norm_modularMassResolvent_apply_le n t v
  rw [hv, norm_smul] at hBound
  have hvNorm : 0 < ‖v‖ := norm_pos_iff.mpr hv0
  apply (mul_le_mul_right hvNorm).mp
  simpa only [one_mul] using hBound

/-- The eigenspaces of the bounded mass resolvent form an orthogonal family,
again by Mathlib's actual bounded self-adjoint API. -/
theorem modularMassResolvent_orthogonalFamily_eigenspaces
    (n : ℤ) (t : ℝ) :
    OrthogonalFamily ℂ
      (fun μ : ℂ ↦
        LinearMap.eigenspace
          (modularMassResolvent n t :
            OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n) μ)
      (fun μ ↦
        (LinearMap.eigenspace
          (modularMassResolvent n t :
            OrbitPeterssonHilbert n →ₗ[ℂ] OrbitPeterssonHilbert n) μ).subtypeₗᵢ) :=
  (modularMassResolvent_isSymmetric n t).orthogonalFamily_eigenspaces

/-! ### Exact smooth-core / elliptic-regularity dependency boundary -/

/-- The maximal distributional realization is self-adjoint exactly when the
minimal graph closure reaches the maximal operator.  This is a direct use of
Mathlib's `LinearPMap.isSelfAdjoint_def` and the already proved double-adjoint
identity, not an elliptic-regularity assumption. -/
theorem maximalStrongSchrodinger_isSelfAdjoint_iff_minimal_eq_maximal
    (n : ℤ) (t : ℝ) :
    IsSelfAdjoint (maximalStrongSchrodinger n t) ↔
      (minimalStrongSchrodinger n t).closure =
        maximalStrongSchrodinger n t := by
  rw [LinearPMap.isSelfAdjoint_def,
    maximalStrongSchrodinger_adjoint_eq_minimalClosure]

/-- Thus smooth operator-core density is exactly self-adjointness of the
maximal distributional realization. -/
theorem smoothCoreIsOperatorCore_iff_maximal_isSelfAdjoint
    (n : ℤ) (t : ℝ) :
    SmoothCoreIsOperatorCore n t ↔
      IsSelfAdjoint (maximalStrongSchrodinger n t) :=
  (smoothCore_operatorCore_iff_minimal_eq_maximal n t).trans
    (maximalStrongSchrodinger_isSelfAdjoint_iff_minimal_eq_maximal n t).symm

/-- Equality of the self-adjoint form realization with the maximal
distributional realization is the same missing operator-core theorem. -/
theorem modularAssociatedOperator_eq_maximal_iff_smoothCoreIsOperatorCore
    (n : ℤ) (t : ℝ) :
    modularAssociatedOperator n t = maximalStrongSchrodinger n t ↔
      SmoothCoreIsOperatorCore n t := by
  constructor
  · intro hEq
    apply (smoothCoreIsOperatorCore_iff_maximal_isSelfAdjoint n t).2
    rw [← hEq]
    exact modularAssociatedOperator_isSelfAdjoint n t
  · intro hCore
    have hClosureMax :=
      (smoothCore_operatorCore_iff_minimal_eq_maximal n t).1 hCore
    have hClosureAssociated :=
      (closure_eq_associated_iff_closure_eq_maximal n t).2 hClosureMax
    exact hClosureAssociated.symm.trans hClosureMax

/-- A strict associated/maximal gap rules out the full smooth operator-core
statement.  This is the precise formal boundary at which genuine interior and
cusp elliptic regularity must enter. -/
theorem not_smoothCoreIsOperatorCore_of_associated_ne_maximal
    (n : ℤ) (t : ℝ)
    (hGap : modularAssociatedOperator n t ≠
      maximalStrongSchrodinger n t) :
    ¬ SmoothCoreIsOperatorCore n t := by
  exact fun hCore ↦ hGap
    ((modularAssociatedOperator_eq_maximal_iff_smoothCoreIsOperatorCore
      n t).2 hCore)

/-- The same strict gap prevents self-adjointness of the maximal realization;
self-adjointness of the associated form operator alone cannot close it. -/
theorem not_maximalStrongSchrodinger_isSelfAdjoint_of_associated_ne_maximal
    (n : ℤ) (t : ℝ)
    (hGap : modularAssociatedOperator n t ≠
      maximalStrongSchrodinger n t) :
    ¬ IsSelfAdjoint (maximalStrongSchrodinger n t) := by
  intro hSelf
  apply hGap
  exact (modularAssociatedOperator_eq_maximal_iff_smoothCoreIsOperatorCore
    n t).2
      ((smoothCoreIsOperatorCore_iff_maximal_isSelfAdjoint n t).2 hSelf)

end
end P9BoundedResolventAndRegularityBoundary

