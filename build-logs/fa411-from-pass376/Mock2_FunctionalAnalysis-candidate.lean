/-! ### P5.1 addendum: a canonical exhaustive sequence of torus modes -/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5LocalFourierRellich

open Filter MeasureTheory

/-- An explicit enumeration of the two integral Fourier frequencies. -/
noncomputable def twoTorusFrequencyEquivNat :
    (Fin 2 → ℤ) ≃ ℕ :=
  (finTwoArrowEquiv ℤ).trans
    ((Equiv.prodCongr Equiv.intEquivNat Equiv.intEquivNat).trans
      Nat.pairEquiv)

/-- The first `N` Fourier frequencies in the fixed enumeration. -/
noncomputable def twoTorusCanonicalModes (N : ℕ) :
    Finset (Fin 2 → ℤ) := by
  classical
  exact Finset.image twoTorusFrequencyEquivNat.symm (Finset.range N)

/-- The canonical finite mode sets are cofinal among all finite frequency
sets.  Thus they genuinely exhaust the full Fourier basis, independently of
any Sobolev estimate. -/
theorem twoTorusCanonicalModes_tendsto_atTop :
    Filter.Tendsto twoTorusCanonicalModes Filter.atTop Filter.atTop := by
  unfold twoTorusCanonicalModes
  exact
    (Filter.tendsto_finset_image_atTop_atTop
      twoTorusFrequencyEquivNat.symm_apply_apply).comp
        Filter.tendsto_finset_range

/-- Strong `L²` convergence of the canonical finite Fourier projections.
This is Parseval completeness, not yet the stronger operator-norm convergence
from a Sobolev graph into `L²`. -/
theorem twoTorusFiniteFourierProjection_tendsto
    (f : TwoTorusL2) :
    Filter.Tendsto
      (fun N ↦ twoTorusFiniteFourierProjection
        (twoTorusCanonicalModes N) f)
      Filter.atTop (nhds f) := by
  simpa only [twoTorusFiniteFourierProjection_apply] using
    (UnitAddTorus.hasSum_mFourier_series_L2 f).comp
      twoTorusCanonicalModes_tendsto_atTop

end P5LocalFourierRellich

namespace AxiomAuditP5CanonicalFourierModes

#print axioms P5LocalFourierRellich.twoTorusCanonicalModes_tendsto_atTop
#print axioms P5LocalFourierRellich.twoTorusFiniteFourierProjection_tendsto

end AxiomAuditP5CanonicalFourierModes
