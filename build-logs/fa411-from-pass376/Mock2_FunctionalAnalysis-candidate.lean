/-!
### P3.18: zero-mean shrinking kernels in planar `L2`

The affine commutator kernel has integral zero, uniformly bounded `L1` norm,
and shrinking support.  The following Hilbert-valued Bochner lemma proves
that every such kernel tends strongly to zero on a fixed `L2` vector.  Its
proof uses only the translation continuity from P3.17 and the elementary
Bochner integral norm estimate; no pointwise representative of the `L2`
vector is selected.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseAffineFriedrichs

open Set Function Topology Filter MeasureTheory Metric

/-- The zero-mean rewrite which removes the non-small untranslated term. -/
theorem integral_kernel_vadd_eq_integral_kernel_vadd_sub_of_mean_zero
    (K : ℂ → ℂ) (f : AmbientPlaneL2)
    (hK : Integrable K)
    (hMean : (∫ t : ℂ, K t) = 0)
    (hTranslate : Integrable
      (fun t : ℂ ↦ K t • (DomAddAct.mk (-t) +ᵥ f)))
    (hError : Integrable
      (fun t : ℂ ↦ K t • (DomAddAct.mk (-t) +ᵥ f - f))) :
    (∫ t : ℂ, K t • (DomAddAct.mk (-t) +ᵥ f)) =
      ∫ t : ℂ, K t • (DomAddAct.mk (-t) +ᵥ f - f) := by
  have hConst : Integrable (fun t : ℂ ↦ K t • f) :=
    hK.smul_const f
  have hPointwise :
      (fun t : ℂ ↦ K t • (DomAddAct.mk (-t) +ᵥ f - f)) =
        (fun t : ℂ ↦
          K t • (DomAddAct.mk (-t) +ᵥ f) - K t • f) := by
    funext t
    rw [smul_sub]
  rw [hPointwise, integral_sub hTranslate hConst,
    integral_smul_const, hMean, zero_smul, sub_zero]

/-- A uniformly `L1`-bounded family of kernels with shrinking support acts
strongly as zero on translation differences.  This is the precise
approximate-identity estimate used by the affine Maass commutator. -/
theorem integral_shrinkingKernel_smul_translation_sub_tendsto_zero
    (f : AmbientPlaneL2)
    (K : ℕ → ℂ → ℂ) (r : ℕ → ℝ) (C : ℝ)
    (hC : 0 ≤ C)
    (hNormIntegrable : ∀ n : ℕ,
      Integrable (fun t : ℂ ↦ ‖K n t‖))
    (hL1 : ∀ n : ℕ, (∫ t : ℂ, ‖K n t‖) ≤ C)
    (hSupport : ∀ n : ℕ, ∀ t : ℂ,
      K n t ≠ 0 → ‖t‖ ≤ r n)
    (hr : Filter.Tendsto r Filter.atTop (nhds 0)) :
    Filter.Tendsto
      (fun n : ℕ ↦
        ∫ t : ℂ, K n t • (DomAddAct.mk (-t) +ᵥ f - f))
      Filter.atTop (nhds 0) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  let η : ℝ := ε / (C + 1)
  have hC1 : 0 < C + 1 := by linarith
  have hη : 0 < η := div_pos hε hC1
  have hηC : η * C < ε := by
    rw [η, div_mul_eq_mul_div, div_lt_iff₀ hC1]
    nlinarith
  have hTranslationEventually :
      {t : ℂ | ‖DomAddAct.mk (-t) +ᵥ f - f‖ < η} ∈ nhds 0 := by
    have hT := ambientPlaneL2_norm_translation_sub_tendsto_zero f
    have hNeg : Filter.Tendsto (fun t : ℂ ↦ -t) (nhds 0) (nhds 0) := by
      fun_prop
    have hComp : Filter.Tendsto
        (fun t : ℂ ↦ ‖DomAddAct.mk (-t) +ᵥ f - f‖)
        (nhds 0) (nhds 0) := hT.comp hNeg
    exact hComp (Iio_mem_nhds hη)
  obtain ⟨δ, hδpos, hδ⟩ :=
    Metric.mem_nhds_iff.mp hTranslationEventually
  have hrEventually : ∀ᶠ n : ℕ in Filter.atTop, r n < δ :=
    hr (Iio_mem_nhds hδpos)
  obtain ⟨N, hN⟩ := eventually_atTop.1 hrEventually
  refine ⟨N, fun n hn ↦ ?_⟩
  have hrn : r n < δ := hN n hn
  have hPointwise : ∀ t : ℂ,
      ‖K n t • (DomAddAct.mk (-t) +ᵥ f - f)‖ ≤
        η * ‖K n t‖ := by
    intro t
    by_cases hKt : K n t = 0
    · simp [hKt, hη.le]
    · have htNorm : ‖t‖ < δ :=
        (hSupport n t hKt).trans_lt hrn
      have htBall : t ∈ Metric.ball (0 : ℂ) δ := by
        simpa only [mem_ball, dist_zero_right] using htNorm
      have htSmall : ‖DomAddAct.mk (-t) +ᵥ f - f‖ < η :=
        hδ htBall
      rw [norm_smul]
      exact mul_le_mul_of_nonneg_left htSmall.le (norm_nonneg _)
  have hIntegralBound :
      ‖∫ t : ℂ, K n t • (DomAddAct.mk (-t) +ᵥ f - f)‖ ≤
        ∫ t : ℂ, η * ‖K n t‖ := by
    exact norm_integral_le_of_norm_le
      ((hNormIntegrable n).const_mul η)
      (Filter.Eventually.of_forall hPointwise)
  have hMassBound : (∫ t : ℂ, η * ‖K n t‖) ≤ η * C := by
    rw [integral_const_mul]
    exact mul_le_mul_of_nonneg_left (hL1 n) hη.le
  have hNormLt :
      ‖∫ t : ℂ, K n t • (DomAddAct.mk (-t) +ᵥ f - f)‖ < ε :=
    (hIntegralBound.trans hMassBound).trans_lt hηC
  simpa only [dist_zero_right] using hNormLt

end FixedPhaseAffineFriedrichs

namespace AxiomAuditP3ShrinkingKernel

#print axioms FixedPhaseAffineFriedrichs.integral_kernel_vadd_eq_integral_kernel_vadd_sub_of_mean_zero
#print axioms FixedPhaseAffineFriedrichs.integral_shrinkingKernel_smul_translation_sub_tendsto_zero

end AxiomAuditP3ShrinkingKernel
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.19: a canonical normalized planar Friedrichs family

The previous section proved the Hilbert-valued estimate for an abstract
shrinking kernel.  Here the kernel is no longer abstract.  We start with one
literal `ContDiffBump` of inner radius one and outer radius two, normalize it
by planar Lebesgue measure, and dilate it by `j + 1`.  The resulting real
kernel is smooth, nonnegative, has integral one, has `L1` norm one, and is
supported in the closed ball of radius `2 / (j + 1)`.

Keeping the kernel real is important: convolution then uses
`lsmul real complex`, so Mathlib's real Frechet convolution theorems apply
directly to complex-valued weak functions.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

/-- The fixed radius-`1/2` bump from which every Friedrichs kernel is
obtained by dilation. -/
noncomputable def friedrichsUnitBump : ContDiffBump (0 : ℂ) where
  rIn := 1
  rOut := 2
  rIn_pos := zero_lt_one
  rIn_lt_rOut := one_lt_two

@[simp]
theorem friedrichsUnitBump_rIn : friedrichsUnitBump.rIn = 1 :=
  rfl

@[simp]
theorem friedrichsUnitBump_rOut : friedrichsUnitBump.rOut = 2 :=
  rfl

/-- The real, mass-one unit mollifier. -/
noncomputable def friedrichsUnitMollifierReal : ℂ → ℝ :=
  friedrichsUnitBump.normed (volume : Measure ℂ)

/-- Complexification of the unit mollifier. -/
noncomputable def friedrichsUnitMollifier (t : ℂ) : ℂ :=
  (friedrichsUnitMollifierReal t : ℂ)

theorem friedrichsUnitMollifierReal_nonneg (t : ℂ) :
    0 ≤ friedrichsUnitMollifierReal t :=
  friedrichsUnitBump.nonneg_normed t

theorem friedrichsUnitMollifierReal_contDiff :
    ContDiff ℝ ∞ friedrichsUnitMollifierReal :=
  friedrichsUnitBump.contDiff_normed

theorem friedrichsUnitMollifier_contDiff :
    ContDiff ℝ ∞ friedrichsUnitMollifier := by
  exact Complex.ofRealCLM.contDiff.comp
    friedrichsUnitMollifierReal_contDiff

theorem friedrichsUnitMollifierReal_integrable :
    Integrable friedrichsUnitMollifierReal (volume : Measure ℂ) :=
  friedrichsUnitBump.integrable_normed

theorem friedrichsUnitMollifier_integrable :
    Integrable friedrichsUnitMollifier (volume : Measure ℂ) :=
  friedrichsUnitMollifierReal_integrable.ofReal

theorem friedrichsUnitMollifierReal_integral :
    (∫ t : ℂ, friedrichsUnitMollifierReal t) = 1 :=
  friedrichsUnitBump.integral_normed

theorem friedrichsUnitMollifier_integral :
    (∫ t : ℂ, friedrichsUnitMollifier t) = 1 := by
  rw [friedrichsUnitMollifier, integral_ofReal,
    friedrichsUnitMollifierReal_integral]
  norm_num

theorem support_friedrichsUnitMollifierReal :
    support friedrichsUnitMollifierReal = ball (0 : ℂ) 2 := by
  simpa only [friedrichsUnitMollifierReal,
    friedrichsUnitBump_rOut] using
      (friedrichsUnitBump.support_normed_eq
        (mu := (volume : Measure ℂ)))

theorem tsupport_friedrichsUnitMollifierReal :
    tsupport friedrichsUnitMollifierReal = closedBall (0 : ℂ) 2 := by
  simpa only [friedrichsUnitMollifierReal,
    friedrichsUnitBump_rOut] using
      (friedrichsUnitBump.tsupport_normed_eq
        (mu := (volume : Measure ℂ)))

/-- Positive dilation parameter.  The first stage already has scale one, so
there is no exceptional index. -/
def friedrichsScale (j : ℕ) : ℝ :=
  (j : ℝ) + 1

theorem friedrichsScale_pos (j : ℕ) : 0 < friedrichsScale j := by
  simp only [friedrichsScale]
  positivity

theorem friedrichsScale_ne_zero (j : ℕ) :
    friedrichsScale j ≠ 0 :=
  (friedrichsScale_pos j).ne'

/-- Real normalized mollifier at stage `j`.  The power two is the real
dimension of the complex plane. -/
noncomputable def friedrichsMollifierReal (j : ℕ) (t : ℂ) : ℝ :=
  friedrichsScale j ^ 2 *
    friedrichsUnitMollifierReal (friedrichsScale j • t)

/-- The same kernel in the complex scalar field used by the `L2` Bochner
integrals below. -/
noncomputable def friedrichsMollifier (j : ℕ) (t : ℂ) : ℂ :=
  (friedrichsMollifierReal j t : ℂ)

theorem friedrichsMollifierReal_nonneg (j : ℕ) (t : ℂ) :
    0 ≤ friedrichsMollifierReal j t := by
  exact mul_nonneg (sq_nonneg _) (friedrichsUnitMollifierReal_nonneg _)

theorem friedrichsMollifierReal_contDiff (j : ℕ) :
    ContDiff ℝ ∞ (friedrichsMollifierReal j) := by
  have hcomp : ContDiff ℝ ∞
      (fun t : ℂ ↦ friedrichsUnitMollifierReal
        (friedrichsScale j • t)) :=
    friedrichsUnitMollifierReal_contDiff.comp
      (contDiff_const_smul (friedrichsScale j))
  simpa only [friedrichsMollifierReal, smul_eq_mul] using
    hcomp.const_smul (friedrichsScale j ^ 2)

theorem friedrichsMollifier_contDiff (j : ℕ) :
    ContDiff ℝ ∞ (friedrichsMollifier j) := by
  exact Complex.ofRealCLM.contDiff.comp
    (friedrichsMollifierReal_contDiff j)

theorem friedrichsMollifierReal_integrable (j : ℕ) :
    Integrable (friedrichsMollifierReal j) (volume : Measure ℂ) := by
  have hcomp : Integrable
      (fun t : ℂ ↦ friedrichsUnitMollifierReal
        (friedrichsScale j • t)) (volume : Measure ℂ) :=
    friedrichsUnitMollifierReal_integrable.comp_smul
      (friedrichsScale_ne_zero j)
  simpa only [friedrichsMollifierReal, smul_eq_mul] using
    hcomp.const_mul (friedrichsScale j ^ 2)

theorem friedrichsMollifier_integrable (j : ℕ) :
    Integrable (friedrichsMollifier j) (volume : Measure ℂ) :=
  (friedrichsMollifierReal_integrable j).ofReal

/-- The exact change-of-variables calculation for the normalized mass. -/
theorem friedrichsMollifierReal_integral (j : ℕ) :
    (∫ t : ℂ, friedrichsMollifierReal j t) = 1 := by
  let a : ℝ := friedrichsScale j
  have ha : 0 < a := friedrichsScale_pos j
  have hchange := Measure.integral_comp_smul
    (volume : Measure ℂ) friedrichsUnitMollifierReal a
  rw [Complex.finrank_real_complex,
    abs_of_pos (inv_pos.mpr (pow_pos ha 2)), smul_eq_mul] at hchange
  rw [friedrichsMollifierReal, integral_const_mul, hchange,
    friedrichsUnitMollifierReal_integral]
  change a ^ 2 * (a ^ 2)^{-1} * 1 = 1
  field_simp [ha.ne']

theorem friedrichsMollifier_integral (j : ℕ) :
    (∫ t : ℂ, friedrichsMollifier j t) = 1 := by
  rw [friedrichsMollifier, integral_ofReal,
    friedrichsMollifierReal_integral]
  norm_num

/-- Since the kernel is nonnegative, normalization is also the exact `L1`
bound needed by the abstract shrinking-kernel estimate. -/
theorem friedrichsMollifier_l1 (j : ℕ) :
    (∫ t : ℂ, ‖friedrichsMollifier j t‖) = 1 := by
  calc
    (∫ t : ℂ, ‖friedrichsMollifier j t‖) =
        ∫ t : ℂ, friedrichsMollifierReal j t := by
      apply integral_congr_ae
      filter_upwards with t
      simp only [friedrichsMollifier, Complex.norm_real,
        abs_of_nonneg (friedrichsMollifierReal_nonneg j t)]
    _ = 1 := friedrichsMollifierReal_integral j

/-- The literal shrinking support radius. -/
def friedrichsRadius (j : ℕ) : ℝ :=
  2 / friedrichsScale j

theorem friedrichsMollifier_support_bound
    (j : ℕ) (t : ℂ) (ht : friedrichsMollifier j t ≠ 0) :
    ‖t‖ ≤ friedrichsRadius j := by
  have ha : 0 < friedrichsScale j := friedrichsScale_pos j
  have hreal : friedrichsMollifierReal j t ≠ 0 := by
    simpa only [friedrichsMollifier, Complex.ofReal_ne_zero] using ht
  have hunit : friedrichsUnitMollifierReal
      (friedrichsScale j • t) ≠ 0 := by
    intro hzero
    apply hreal
    simp only [friedrichsMollifierReal, hzero, mul_zero]
  have hmem : friedrichsScale j • t ∈
      support friedrichsUnitMollifierReal := hunit
  rw [support_friedrichsUnitMollifierReal] at hmem
  have hlt : friedrichsScale j * ‖t‖ < 2 := by
    simpa only [mem_ball, dist_zero_right, norm_smul,
      Real.norm_eq_abs, abs_of_pos ha] using hmem
  exact ((lt_div_iff₀ ha).2 hlt).le

theorem friedrichsRadius_tendsto_zero :
    Filter.Tendsto friedrichsRadius Filter.atTop (𝓝 0) := by
  have hbase : Filter.Tendsto
      (fun j : ℕ ↦ (1 : ℝ) / ((j : ℝ) + 1))
      Filter.atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hmul := (tendsto_const_nhds (x := (2 : ℝ))).mul hbase
  simpa only [friedrichsRadius, friedrichsScale,
    mul_div_assoc, mul_one] using hmul

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3NormalizedMollifier

#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifierReal_integral
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifier_l1
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifier_support_bound
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsRadius_tendsto_zero

end AxiomAuditP3NormalizedMollifier
