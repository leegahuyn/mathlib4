/-!
P9 minimal/maximal comparison fragment.

This fragment is intended to be appended after the actual P6 strong/weak
bridge and the P9 closed-form realization in
`Mock2_FunctionalAnalysis_Integrated.lean`.  It does not claim elliptic
regularity.  Instead it constructs the literal minimal strong operator on the
smooth fixed-phase core, its Hilbert adjoint (the maximal distributional
operator), and proves every unconditional inclusion available from the exact
strong/weak identity and Mathlib's `LinearPMap` API.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P9MinimalMaximalCore

open scoped LinearPMap
open HalfWeightDifferentialOperators
open HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore
open DefinitionOneSobolev
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open FixedPhaseDensity
open FixedPhaseClosedOperators
open ActualScalarDiscriminantPDE
open P9ClosedFormRealization
open P9ClosedFormRealization.ActualModularEndpoint

noncomputable section

/-! ### Canonical Petersson pivot embedding into `H⁻¹` -/

/-- Algebraic Petersson pivot map.  A physical `L²` vector acts on the actual
graph completion through its completed base coordinate, with the anti-linear
test convention used by the weak equation. -/
noncomputable def peterssonPivotLinear (n : ℤ) :
    OrbitPeterssonHilbert n →ₗ[ℂ] ActualHMinusOne n where
  toFun y := (innerSLFlip ℂ y).comp (baseExtension n)
  map_add' y z := by
    ext v
    change inner ℂ (baseExtension n v) (y + z) =
      inner ℂ (baseExtension n v) y +
        inner ℂ (baseExtension n v) z
    exact inner_add_right _ _ _
  map_smul' c y := by
    ext v
    change inner ℂ (baseExtension n v) (c • y) =
      c • inner ℂ (baseExtension n v) y
    simpa only [smul_eq_mul] using
      (inner_smul_right (baseExtension n v) y c)

@[simp]
theorem peterssonPivotLinear_apply
    (n : ℤ) (y : OrbitPeterssonHilbert n) (v : ActualHOne n) :
    peterssonPivotLinear n y v =
      inner ℂ (baseExtension n v) y :=
  rfl

/-- Sharp bound obtained by composing the Riesz anti-functional with the
actual graph-to-Petersson base coordinate. -/
theorem peterssonPivotLinear_norm_le
    (n : ℤ) (y : OrbitPeterssonHilbert n) :
    ‖peterssonPivotLinear n y‖ ≤ ‖baseExtension n‖ * ‖y‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _
    (mul_nonneg (norm_nonneg _) (norm_nonneg _)) ?_
  intro v
  change ‖inner ℂ (baseExtension n v) y‖ ≤
    (‖baseExtension n‖ * ‖y‖) * ‖v‖
  calc
    ‖inner ℂ (baseExtension n v) y‖ ≤
        ‖baseExtension n v‖ * ‖y‖ := norm_inner_le_norm _ _
    _ ≤ (‖baseExtension n‖ * ‖v‖) * ‖y‖ :=
      mul_le_mul_of_nonneg_right
        ((baseExtension n).le_opNorm v) (norm_nonneg y)
    _ = (‖baseExtension n‖ * ‖y‖) * ‖v‖ := by ring

/-- Canonical continuous linear pivot embedding
`L²_n → H⁻¹_n`. -/
noncomputable def peterssonPivotEmbedding (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ] ActualHMinusOne n :=
  (peterssonPivotLinear n).mkContinuous ‖baseExtension n‖
    (peterssonPivotLinear_norm_le n)

@[simp]
theorem peterssonPivotEmbedding_apply
    (n : ℤ) (y : OrbitPeterssonHilbert n) (v : ActualHOne n) :
    peterssonPivotEmbedding n y v =
      inner ℂ (baseExtension n v) y :=
  rfl

theorem norm_peterssonPivotEmbedding_le_baseExtension (n : ℤ) :
    ‖peterssonPivotEmbedding n‖ ≤ ‖baseExtension n‖ := by
  exact LinearMap.mkContinuous_norm_le _ (norm_nonneg _)
    (peterssonPivotLinear_norm_le n)

theorem norm_peterssonPivotEmbedding_le_one (n : ℤ) :
    ‖peterssonPivotEmbedding n‖ ≤ 1 :=
  (norm_peterssonPivotEmbedding_le_baseExtension n).trans
    (norm_baseExtension_le_one n)

theorem norm_peterssonPivotEmbedding_apply_le
    (n : ℤ) (y : OrbitPeterssonHilbert n) :
    ‖peterssonPivotEmbedding n y‖ ≤ ‖y‖ := by
  calc
    ‖peterssonPivotEmbedding n y‖ ≤
        ‖peterssonPivotEmbedding n‖ * ‖y‖ :=
      (peterssonPivotEmbedding n).le_opNorm y
    _ ≤ 1 * ‖y‖ :=
      mul_le_mul_of_nonneg_right
        (norm_peterssonPivotEmbedding_le_one n) (norm_nonneg y)
    _ = ‖y‖ := one_mul _

/-- Dense range of the base coordinate makes the canonical pivot embedding
faithful. -/
theorem peterssonPivotEmbedding_eq_zero_iff
    (n : ℤ) (y : OrbitPeterssonHilbert n) :
    peterssonPivotEmbedding n y = 0 ↔ y = 0 := by
  constructor
  · intro hy
    apply (modularBaseEmbedding_denseRange n).eq_zero_of_inner_right
    intro v
    have hv := congrArg (fun F : ActualHMinusOne n ↦ F v) hy
    simpa only [peterssonPivotEmbedding_apply,
      ContinuousLinearMap.zero_apply] using hv
  · rintro rfl
    exact map_zero (peterssonPivotEmbedding n)

theorem peterssonPivotEmbedding_injective (n : ℤ) :
    Function.Injective (peterssonPivotEmbedding n) := by
  intro y z hyz
  apply sub_eq_zero.mp
  apply (peterssonPivotEmbedding_eq_zero_iff n (y - z)).mp
  rw [map_sub, hyz, sub_self]

/-- P6's smooth forcing is exactly the canonical pivot embedding of its
Petersson coordinate; the two interfaces are not merely propositionally
compatible after testing. -/
theorem corePeterssonForcing_eq_peterssonPivotEmbedding
    (n : ℤ) (f : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    corePeterssonForcing n f =
      peterssonPivotEmbedding n (l2Coordinate n f) := by
  ext v
  rw [corePeterssonForcing_apply, peterssonPivotEmbedding_apply]

@[simp]
theorem peterssonPivotEmbedding_apply_core
    (n : ℤ) (y : OrbitPeterssonHilbert n)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    peterssonPivotEmbedding n y (coreMap n v) =
      inner ℂ (l2Coordinate n v) y := by
  rw [peterssonPivotEmbedding_apply, baseExtension_core]

/-! ### The genuine minimal strong operator -/

/-- The literal differential expression on the dense Petersson image of the
actual smooth fixed-phase core.  Its value is obtained by applying the
second-order strong core endomorphism and then taking the genuine Petersson
`L²` coordinate. -/
noncomputable def minimalStrongSchrodinger (n : ℤ) (t : ℝ) :
    OrbitPeterssonHilbert n →ₗ.[ℂ] OrbitPeterssonHilbert n where
  domain := LinearMap.range (l2Coordinate n)
  toFun :=
    (l2Coordinate n).comp
      ((strongSchrodingerCore n t).comp
        (l2CoreRangeEquiv n).symm.toLinearMap)

@[simp]
theorem minimalStrongSchrodinger_domain (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).domain =
      LinearMap.range (l2Coordinate n) :=
  rfl

@[simp]
theorem minimalStrongSchrodinger_apply
    (n : ℤ) (t : ℝ) (x : LinearMap.range (l2Coordinate n)) :
    minimalStrongSchrodinger n t x =
      l2Coordinate n
        (strongSchrodingerCore n t ((l2CoreRangeEquiv n).symm x)) :=
  rfl

@[simp]
theorem minimalStrongSchrodinger_on_core
    (n : ℤ) (t : ℝ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    minimalStrongSchrodinger n t (l2CoreRangeEquiv n u) =
      l2Coordinate n (strongSchrodingerCore n t u) := by
  simp only [minimalStrongSchrodinger_apply, LinearEquiv.symm_apply_apply]

/-- The minimal strong operator has exactly the actual smooth Petersson core
as domain, hence is densely defined without a density certificate. -/
theorem minimalStrongSchrodinger_dense_domain (n : ℤ) (t : ℝ) :
    Dense ((minimalStrongSchrodinger n t).domain :
      Set (OrbitPeterssonHilbert n)) := by
  change Dense (LinearMap.range (l2Coordinate n) :
    Set (OrbitPeterssonHilbert n))
  simpa only [LinearMap.coe_range] using
    FixedPhaseDensity.denseRange_l2Coordinate n

/-- Every core graph point is represented by the completed weak form.  This
is the exact bridge from the P6 differential expression to the P9 associated
operator. -/
theorem strongCore_pair_mem_modularAssociatedOperator_graph
    (n : ℤ) (t : ℝ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (l2Coordinate n u,
        l2Coordinate n (strongSchrodingerCore n t u)) ∈
      (modularAssociatedOperator n t).graph := by
  rw [mem_modularAssociatedOperator_graph_iff]
  refine ⟨coreMap n u, baseExtension_core n u, ?_⟩
  intro v
  have hWeak := congrArg
    (fun F : ActualHMinusOne n ↦ F v)
    (strongCoreEquation_implies_weakEquation
      n t u (strongSchrodingerCore n t u) rfl)
  simpa only [weakSchrodingerOperator_apply,
    corePeterssonForcing_apply] using hWeak

/-- Core pairs are graph points of the minimal operator itself. -/
theorem strongCore_pair_mem_minimalStrongSchrodinger_graph
    (n : ℤ) (t : ℝ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (l2Coordinate n u,
        l2Coordinate n (strongSchrodingerCore n t u)) ∈
      (minimalStrongSchrodinger n t).graph := by
  simpa only [l2CoreRangeEquiv_coe,
    minimalStrongSchrodinger_on_core] using
      (minimalStrongSchrodinger n t).mem_graph (l2CoreRangeEquiv n u)

/-- Exact graph characterization of the minimal operator by a unique smooth
fixed-phase core representative. -/
theorem mem_minimalStrongSchrodinger_graph_iff
    (n : ℤ) (t : ℝ) (x f : OrbitPeterssonHilbert n) :
    (x, f) ∈ (minimalStrongSchrodinger n t).graph ↔
      ∃ u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n,
        l2Coordinate n u = x ∧
          l2Coordinate n (strongSchrodingerCore n t u) = f := by
  constructor
  · intro hGraph
    rcases (LinearPMap.mem_graph_iff (minimalStrongSchrodinger n t)).mp
        hGraph with ⟨y, hy, hf⟩
    let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm y
    refine ⟨u, ?_, ?_⟩
    · exact (l2Coordinate_l2CoreRangeEquiv_symm n y).trans hy
    · rw [← hf]
      exact (minimalStrongSchrodinger_apply n t y).symm
  · rintro ⟨u, rfl, rfl⟩
    exact strongCore_pair_mem_minimalStrongSchrodinger_graph n t u

/-! ### Inclusion in the form realization and closability -/

/-- The literal minimal differential operator is a restriction of the actual
self-adjoint form realization. -/
theorem minimalStrongSchrodinger_le_modularAssociatedOperator
    (n : ℤ) (t : ℝ) :
    minimalStrongSchrodinger n t ≤ modularAssociatedOperator n t := by
  apply LinearPMap.le_of_le_graph
  rintro ⟨x, f⟩ hp
  rw [mem_minimalStrongSchrodinger_graph_iff] at hp
  rcases hp with ⟨u, rfl, rfl⟩
  exact strongCore_pair_mem_modularAssociatedOperator_graph n t u

/-- Restricting the represented operator back to the actual smooth core gives
the literal strong differential operator, with no domain coercion hidden. -/
theorem minimalStrongSchrodinger_eq_associated_domRestrict
    (n : ℤ) (t : ℝ) :
    minimalStrongSchrodinger n t =
      (modularAssociatedOperator n t).domRestrict
        (minimalStrongSchrodinger n t).domain :=
  eq_domRestrict_of_le
    (minimalStrongSchrodinger_le_modularAssociatedOperator n t)

/-- The minimal strong operator is closable because it has the already-proved
closed self-adjoint form realization as an extension. -/
theorem minimalStrongSchrodinger_isClosable (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).IsClosable :=
  (modularAssociatedOperator_isClosed n t).isClosable.leIsClosable
    (minimalStrongSchrodinger_le_modularAssociatedOperator n t)

/-- Its canonical graph closure remains inside the self-adjoint realization. -/
theorem minimalStrongSchrodinger_closure_le_modularAssociatedOperator
    (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).closure ≤
      modularAssociatedOperator n t := by
  have hClosure :=
    (modularAssociatedOperator_isClosed n t).isClosable.closure_mono
      (minimalStrongSchrodinger_le_modularAssociatedOperator n t)
  rw [FormalAdjointClosure.closure_eq_self
    (modularAssociatedOperator_isClosed n t)] at hClosure
  exact hClosure

theorem minimalStrongSchrodinger_closure_isClosed (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).closure.IsClosed :=
  (minimalStrongSchrodinger_isClosable n t).closure_isClosed

/-! ### The maximal distributional operator -/

/-- The maximal Hilbert-space realization of the same literal core
differential expression is its Mathlib adjoint. -/
noncomputable def maximalStrongSchrodinger (n : ℤ) (t : ℝ) :
    OrbitPeterssonHilbert n →ₗ.[ℂ] OrbitPeterssonHilbert n :=
  (minimalStrongSchrodinger n t)†

/-- The maximal realization is closed by the standard Hilbert adjoint API. -/
theorem maximalStrongSchrodinger_isClosed (n : ℤ) (t : ℝ) :
    (maximalStrongSchrodinger n t).IsClosed := by
  exact LinearPMap.adjoint_isClosed
    (minimalStrongSchrodinger_dense_domain n t)

/-- Closability of the minimal operator forces density of the maximal
adjoint domain; this is not postulated as a separate regularity property. -/
theorem maximalStrongSchrodinger_dense_domain (n : ℤ) (t : ℝ) :
    Dense ((maximalStrongSchrodinger n t).domain :
      Set (OrbitPeterssonHilbert n)) := by
  exact FormalAdjointClosure.adjoint_dense_domain
    (minimalStrongSchrodinger_isClosable n t)
    (minimalStrongSchrodinger_dense_domain n t)

/-- A generic restriction of a symmetric operator is formally adjoint to the
larger operator.  This small lemma keeps all subtype transports explicit. -/
theorem formalAdjoint_extension_of_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    {S A : H →ₗ.[ℂ] H}
    (hSA : S ≤ A) (hAA : A.IsFormalAdjoint A) :
    S.IsFormalAdjoint A := by
  intro x y
  let xA : A.domain := ⟨(x : H), hSA.1 x.property⟩
  calc
    inner ℂ (S x) (y : H) = inner ℂ (A xA) (y : H) := by
      rw [hSA.2 (x := x) (y := xA) rfl]
    _ = inner ℂ (xA : H) (A y) := hAA xA y
    _ = inner ℂ (x : H) (A y) := rfl

/-- The core minimal operator is formally symmetric as a restriction of the
Hermitian associated realization. -/
theorem minimalStrongSchrodinger_isFormalAdjoint
    (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).IsFormalAdjoint
      (minimalStrongSchrodinger n t) := by
  intro x y
  let xA : (modularAssociatedOperator n t).domain :=
    ⟨(x : OrbitPeterssonHilbert n),
      (minimalStrongSchrodinger_le_modularAssociatedOperator n t).1
        x.property⟩
  let yA : (modularAssociatedOperator n t).domain :=
    ⟨(y : OrbitPeterssonHilbert n),
      (minimalStrongSchrodinger_le_modularAssociatedOperator n t).1
        y.property⟩
  calc
    inner ℂ (minimalStrongSchrodinger n t x)
        (y : OrbitPeterssonHilbert n) =
      inner ℂ (modularAssociatedOperator n t xA)
        (yA : OrbitPeterssonHilbert n) := by
          rw [(minimalStrongSchrodinger_le_modularAssociatedOperator n t).2
            (x := x) (y := xA) rfl]
    _ = inner ℂ (xA : OrbitPeterssonHilbert n)
        (modularAssociatedOperator n t yA) :=
      modularAssociatedOperator_isFormalAdjoint n t xA yA
    _ = inner ℂ (x : OrbitPeterssonHilbert n)
        (minimalStrongSchrodinger n t y) := by
          rw [(minimalStrongSchrodinger_le_modularAssociatedOperator n t).2
            (x := y) (y := yA) rfl]

/-- Formal-adjoint orientation from the minimal differential operator to the
closed-form realization. -/
theorem minimalStrongSchrodinger_isFormalAdjoint_associated
    (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).IsFormalAdjoint
      (modularAssociatedOperator n t) :=
  formalAdjoint_extension_of_le
    (minimalStrongSchrodinger_le_modularAssociatedOperator n t)
    (modularAssociatedOperator_isFormalAdjoint n t)

/-- Conjugate formal-adjoint orientation, recorded separately because this is
the one used when testing a maximal-domain vector by a smooth core vector. -/
theorem modularAssociatedOperator_isFormalAdjoint_minimalStrong
    (n : ℤ) (t : ℝ) :
    (modularAssociatedOperator n t).IsFormalAdjoint
      (minimalStrongSchrodinger n t) :=
  (minimalStrongSchrodinger_isFormalAdjoint_associated n t).symm

/-- Minimal symmetry gives the first minimal-to-maximal inclusion. -/
theorem minimalStrongSchrodinger_le_maximalStrongSchrodinger
    (n : ℤ) (t : ℝ) :
    minimalStrongSchrodinger n t ≤ maximalStrongSchrodinger n t := by
  exact LinearPMap.IsFormalAdjoint.le_adjoint
    (hT := minimalStrongSchrodinger_dense_domain n t)
    (minimalStrongSchrodinger_isFormalAdjoint n t)

/-- The associated self-adjoint realization is itself contained in the
maximal adjoint of the minimal core operator. -/
theorem modularAssociatedOperator_le_maximalStrongSchrodinger
    (n : ℤ) (t : ℝ) :
    modularAssociatedOperator n t ≤ maximalStrongSchrodinger n t := by
  exact LinearPMap.IsFormalAdjoint.le_adjoint
    (hT := minimalStrongSchrodinger_dense_domain n t)
    (minimalStrongSchrodinger_isFormalAdjoint_associated n t)

/-- The Hilbert adjoint of the maximal operator is exactly the canonical
minimal graph closure.  This is Mathlib's double-adjoint theorem instantiated
on the literal modular differential operator. -/
theorem maximalStrongSchrodinger_adjoint_eq_minimalClosure
    (n : ℤ) (t : ℝ) :
    (maximalStrongSchrodinger n t)† =
      (minimalStrongSchrodinger n t).closure := by
  simpa only [maximalStrongSchrodinger] using
    (FormalAdjointClosure.adjoint_adjoint_eq_closure
      (minimalStrongSchrodinger_isClosable n t)
      (minimalStrongSchrodinger_dense_domain n t))

/-- In particular the closed minimal realization is contained in the maximal
distributional realization. -/
theorem minimalStrongSchrodinger_closure_le_maximalStrongSchrodinger
    (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).closure ≤
      maximalStrongSchrodinger n t :=
  (minimalStrongSchrodinger_closure_le_modularAssociatedOperator n t).trans
    (modularAssociatedOperator_le_maximalStrongSchrodinger n t)

/-- The entire honest minimal/closed-form/maximal chain. -/
theorem minimal_closure_associated_maximal_chain
    (n : ℤ) (t : ℝ) :
    minimalStrongSchrodinger n t ≤
        (minimalStrongSchrodinger n t).closure ∧
      (minimalStrongSchrodinger n t).closure ≤
        modularAssociatedOperator n t ∧
      modularAssociatedOperator n t ≤
        maximalStrongSchrodinger n t :=
  ⟨(minimalStrongSchrodinger n t).le_closure,
    minimalStrongSchrodinger_closure_le_modularAssociatedOperator n t,
    modularAssociatedOperator_le_maximalStrongSchrodinger n t⟩

/-! ### Exact maximal weak graph identity -/

/-- Membership in the maximal graph is exactly the distributional pairing
identity against every vector in the literal minimal domain. -/
theorem mem_maximalStrongSchrodinger_graph_iff_domain_tests
    (n : ℤ) (t : ℝ) (x f : OrbitPeterssonHilbert n) :
    (x, f) ∈ (maximalStrongSchrodinger n t).graph ↔
      ∀ y : (minimalStrongSchrodinger n t).domain,
        inner ℂ (minimalStrongSchrodinger n t y) x =
          inner ℂ (y : OrbitPeterssonHilbert n) f := by
  constructor
  · intro hGraph y
    rcases (LinearPMap.mem_graph_iff (maximalStrongSchrodinger n t)).mp
        hGraph with ⟨xAdj, hx, hf⟩
    have hFormal := LinearPMap.adjoint_isFormalAdjoint
      (minimalStrongSchrodinger_dense_domain n t)
    have hPair := hFormal.symm y xAdj
    rw [← hx, ← hf]
    exact hPair
  · intro hTest
    have hAdjointWitness :
        ∀ y : (minimalStrongSchrodinger n t).domain,
          inner ℂ f (y : OrbitPeterssonHilbert n) =
            inner ℂ x (minimalStrongSchrodinger n t y) := by
      intro y
      calc
        inner ℂ f (y : OrbitPeterssonHilbert n) =
            star (inner ℂ (y : OrbitPeterssonHilbert n) f) :=
          inner_conj_symm _ _
        _ = star
            (inner ℂ (minimalStrongSchrodinger n t y) x) :=
          congrArg star (hTest y).symm
        _ = inner ℂ x (minimalStrongSchrodinger n t y) :=
          inner_conj_symm _ _
    have hxDomain : x ∈ (maximalStrongSchrodinger n t).domain := by
      exact LinearPMap.mem_adjoint_domain_of_exists x
        ⟨f, hAdjointWitness⟩
    let xAdj : (maximalStrongSchrodinger n t).domain := ⟨x, hxDomain⟩
    have hValue : maximalStrongSchrodinger n t xAdj = f := by
      exact LinearPMap.adjoint_apply_eq
        (minimalStrongSchrodinger_dense_domain n t) xAdj hAdjointWitness
    exact (LinearPMap.mem_graph_iff (maximalStrongSchrodinger n t)).2
      ⟨xAdj, rfl, hValue⟩

/-- Equivalent maximal graph characterization using precisely the actual
smooth fixed-phase test sections, with the literal second-order expression in
the first Petersson slot. -/
theorem mem_maximalStrongSchrodinger_graph_iff_core_tests
    (n : ℤ) (t : ℝ) (x f : OrbitPeterssonHilbert n) :
    (x, f) ∈ (maximalStrongSchrodinger n t).graph ↔
      ∀ u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n,
        inner ℂ (l2Coordinate n (strongSchrodingerCore n t u)) x =
          inner ℂ (l2Coordinate n u) f := by
  rw [mem_maximalStrongSchrodinger_graph_iff_domain_tests]
  constructor
  · intro h u
    simpa only [minimalStrongSchrodinger_on_core,
      l2CoreRangeEquiv_coe] using h (l2CoreRangeEquiv n u)
  · intro h y
    let u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n := (l2CoreRangeEquiv n).symm y
    simpa only [u, minimalStrongSchrodinger_apply,
      l2Coordinate_l2CoreRangeEquiv_symm] using h u

/-! ### What operator-core density would mean, exactly -/

/-- The precise remaining second-order operator-core statement.  It is a
standard Mathlib `HasCore` predicate for the already constructed associated
operator, not an informal smoothness label. -/
def SmoothCoreIsOperatorCore (n : ℤ) (t : ℝ) : Prop :=
  (modularAssociatedOperator n t).HasCore
    (minimalStrongSchrodinger n t).domain

/-- Mathlib's core predicate is exactly equality between the canonical
minimal closure and the self-adjoint form realization. -/
theorem smoothCoreIsOperatorCore_iff_closure_eq_associated
    (n : ℤ) (t : ℝ) :
    SmoothCoreIsOperatorCore n t ↔
      (minimalStrongSchrodinger n t).closure =
        modularAssociatedOperator n t := by
  constructor
  · intro hCore
    calc
      (minimalStrongSchrodinger n t).closure =
          ((modularAssociatedOperator n t).domRestrict
            (minimalStrongSchrodinger n t).domain).closure :=
        congrArg LinearPMap.closure
          (minimalStrongSchrodinger_eq_associated_domRestrict n t)
      _ = modularAssociatedOperator n t := hCore.closure_eq
  · intro hClosure
    refine ⟨(minimalStrongSchrodinger_le_modularAssociatedOperator n t).1,
      ?_⟩
    calc
      ((modularAssociatedOperator n t).domRestrict
          (minimalStrongSchrodinger n t).domain).closure =
          (minimalStrongSchrodinger n t).closure :=
        congrArg LinearPMap.closure
          (minimalStrongSchrodinger_eq_associated_domRestrict n t).symm
      _ = modularAssociatedOperator n t := hClosure

/-- Equivalent graph-density formulation of the same operator-core boundary. -/
theorem smoothCoreIsOperatorCore_iff_graphClosure
    (n : ℤ) (t : ℝ) :
    SmoothCoreIsOperatorCore n t ↔
      (minimalStrongSchrodinger n t).graph.topologicalClosure =
        (modularAssociatedOperator n t).graph := by
  rw [smoothCoreIsOperatorCore_iff_closure_eq_associated]
  exact closure_eq_iff_isEssentialGraphCoreFor
    (minimalStrongSchrodinger_isClosable n t)

/-- For this symmetric dense minimal realization, equality with the
self-adjoint form realization is equivalent to the usual minimal=maximal
(essential self-adjointness) statement.  This theorem records the exact
logical role of the missing second-order elliptic core argument. -/
theorem closure_eq_associated_iff_closure_eq_maximal
    (n : ℤ) (t : ℝ) :
    (minimalStrongSchrodinger n t).closure =
        modularAssociatedOperator n t ↔
      (minimalStrongSchrodinger n t).closure =
        maximalStrongSchrodinger n t := by
  constructor
  · intro hClosure
    have hMinClosable := minimalStrongSchrodinger_isClosable n t
    have hMinDense := minimalStrongSchrodinger_dense_domain n t
    have hAdjDense := FormalAdjointClosure.adjoint_dense_domain
      hMinClosable hMinDense
    have hAdjClosed : (maximalStrongSchrodinger n t).IsClosed :=
      maximalStrongSchrodinger_isClosed n t
    have hDouble := FormalAdjointClosure.adjoint_adjoint_eq_closure
      hMinClosable hMinDense
    have hTriple := FormalAdjointClosure.adjoint_adjoint_eq_closure
      hAdjClosed.isClosable hAdjDense
    have hTriple' :
        (minimalStrongSchrodinger n t)††† =
          maximalStrongSchrodinger n t := by
      simpa only [maximalStrongSchrodinger,
        FormalAdjointClosure.closure_eq_self hAdjClosed] using hTriple
    calc
      (minimalStrongSchrodinger n t).closure =
          modularAssociatedOperator n t := hClosure
      _ = (modularAssociatedOperator n t)† :=
        (LinearPMap.isSelfAdjoint_def.mp
          (modularAssociatedOperator_isSelfAdjoint n t)).symm
      _ = ((minimalStrongSchrodinger n t).closure)† := by rw [hClosure]
      _ = (minimalStrongSchrodinger n t)††† := by rw [← hDouble]
      _ = maximalStrongSchrodinger n t := hTriple'
  · intro hEssential
    apply le_antisymm
    · exact minimalStrongSchrodinger_closure_le_modularAssociatedOperator n t
    · rw [hEssential]
      exact modularAssociatedOperator_le_maximalStrongSchrodinger n t

/-- Final exact comparison: smooth operator-core density, equality with the
closed-form realization, and minimal=maximal essential self-adjointness are
the same proposition.  No one of them is silently inferred from first-order
form-core density. -/
theorem smoothCore_operatorCore_iff_minimal_eq_maximal
    (n : ℤ) (t : ℝ) :
    SmoothCoreIsOperatorCore n t ↔
      (minimalStrongSchrodinger n t).closure =
        maximalStrongSchrodinger n t := by
  rw [smoothCoreIsOperatorCore_iff_closure_eq_associated,
    closure_eq_associated_iff_closure_eq_maximal]

/-- A strict minimal/maximal gap is an unconditional obstruction to calling
the smooth form core an operator core. -/
theorem not_smoothCoreIsOperatorCore_of_closure_ne_maximal
    (n : ℤ) (t : ℝ)
    (hGap : (minimalStrongSchrodinger n t).closure ≠
      maximalStrongSchrodinger n t) :
    ¬ SmoothCoreIsOperatorCore n t := by
  exact fun hCore ↦ hGap
    ((smoothCore_operatorCore_iff_minimal_eq_maximal n t).mp hCore)

end
end P9MinimalMaximalCore

