    literalStageCutoffSupportLowerHeight_pos Y
  have hy : literalStageCutoffSupportLowerHeight Y ≤ z.im :=
    literalStageCutoffSupportLowerHeight_le_im Y hz
  have him : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, abs_of_pos z.im_pos]
  have hlog :=
    norm_height_mul_dy_sq_le_fixedPhaseEuclideanGraphDensity n u z
  rw [norm_mul, him, mul_pow] at hlog
  have hscale :
      ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2 ≤
        (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2 *
          (z.im ^ 2 * ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
    have hzsq : literalStageCutoffSupportLowerHeight Y ^ 2 ≤ z.im ^ 2 :=
      (sq_le_sq₀ hy₀.le z.im_pos.le).2 hy
    rw [inv_pow]
    calc
      _ = (literalStageCutoffSupportLowerHeight Y ^ 2)⁻¹ *
          (literalStageCutoffSupportLowerHeight Y ^ 2 *
            ‖dy (fixedPhaseEuclideanGauge n u) z‖ ^ 2) := by
