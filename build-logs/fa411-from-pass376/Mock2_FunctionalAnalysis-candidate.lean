/-!
This fragment is intended after the reduced-chart periodization and local
Friedrichs fragments.

It supplies the missing seam-compatible finite localization.  An ordinary
partition of unity on the chosen upstairs compact set cannot simply be
periodized: different representatives of one quotient point would then be
counted independently.  Here every active partition member is first
periodized for the *effective*, faithful Gamma(2)-action and the resulting
finite family is normalized by one invariant, everywhere nonzero smooth
denominator.  Consequently the normalized periodizations sum to one on the
entire orbit saturation of the compact set.

The denominator is

  B + (1 - smoothTransition (2 * re B - 1)).

It is positive everywhere, while it is exactly `B` wherever `re B >= 1`.
This removes the zero-denominator seam without a certificate or a piecewise
regularity premise.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped BigOperators ContDiff ENNReal
open HalfIntegralMultiplier
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open PhysicalLocalL2

theorem realSmooth_const (c : ℂ) :
    RealSmooth (fun _ : ℍ ↦ c) := by
  unfold RealSmooth upperLift
  simpa [Function.comp_def] using
    (contDiffOn_const : ContDiffOn ℝ ∞
      (fun _ : ℂ ↦ c) UpperHalfPlane.upperHalfPlaneSet)

theorem RealSmooth.finset_sum
    {iota : Type*} (s : Finset iota) {f : iota → ℍ → ℂ}
    (hf : ∀ i ∈ s, RealSmooth (f i)) :
    RealSmooth (fun z ↦ ∑ i ∈ s, f i z) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using realSmooth_const 0
  | @insert i s hi ih =>
      simpa only [Finset.sum_insert hi, Finset.sum_apply] using
        (hf i (Finset.mem_insert_self i s)).add
          (ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj)))

/-! ### Weight-zero periodization for the faithful effective action -/

/-- The compact upstairs support used by the effective scalar
periodization. -/
def effectiveScalarSeedSupport
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) : Set ℍ :=
  UpperHalfPlane.coe ⁻¹' tsupport (v : ℂ → ℂ)

theorem effectiveScalarSeedSupport_isCompact
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    IsCompact (effectiveScalarSeedSupport v) := by
  apply UpperHalfPlane.isOpenEmbedding_coe.isInducing.isCompact_preimage'
    v.hasCompactSupport
  intro w hw
  have hwUpper := v.tsupport_subset hw
  exact ⟨UpperHalfPlane.ofComplex w, by
    rw [UpperHalfPlane.ofComplex_apply_of_im_pos hwUpper]⟩

/-- One translate of a scalar seed.  There is no multiplier factor: this is
the weight-zero localization algebra, not a physical half-weight section. -/
noncomputable def effectiveScalarPeriodizationTerm
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (a : GammaTwoEffective) (z : ℍ) : ℂ :=
  v ((((a⁻¹ • z : ℍ) : ℂ)))

theorem support_effectiveScalarPeriodizationTerm_subset
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (a : GammaTwoEffective) :
    Function.support (effectiveScalarPeriodizationTerm v a) ⊆
      (a • ·) '' effectiveScalarSeedSupport v := by
  intro z hz
  refine ⟨a⁻¹ • z, ?_, by simp⟩
  change ((((a⁻¹ • z : ℍ) : ℂ))) ∈
    tsupport (v : ℂ → ℂ)
  exact subset_tsupport hz

theorem effectiveScalarPeriodizationTerm_locallyFinite
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    LocallyFinite (fun a : GammaTwoEffective ↦
      Function.support (effectiveScalarPeriodizationTerm v a)) :=
  (gammaTwoEffective_compact_translates_locallyFinite
      (effectiveScalarSeedSupport_isCompact v)).subset
    (support_effectiveScalarPeriodizationTerm_subset v)

theorem effectiveScalarSeed_realSmooth
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    RealSmooth (fun z : ℍ ↦ v (z : ℂ)) := by
  unfold RealSmooth upperLift
  simpa [Function.comp_def] using v.contDiff.contDiffOn

theorem effectiveScalarPeriodizationTerm_realSmooth
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (a : GammaTwoEffective) :
    RealSmooth (effectiveScalarPeriodizationTerm v a) := by
  rcases effective_exists_gamma a⁻¹ with ⟨gamma, hgamma⟩
  have h := (effectiveScalarSeed_realSmooth v).comp_gammaTwo_smul gamma
  simpa only [effectiveScalarPeriodizationTerm, hgamma] using h

/-- Locally finite weight-zero periodization over the faithful action. -/
noncomputable def effectiveScalarPoincarePeriodization
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) : ℂ :=
  ∑ᶠ a : GammaTwoEffective,
    effectiveScalarPeriodizationTerm v a z

theorem effectiveScalarPoincarePeriodization_realSmooth
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    RealSmooth (effectiveScalarPoincarePeriodization v) := by
  exact realSmooth_finsum_of_locallyFinite_support
    (effectiveScalarPeriodizationTerm_locallyFinite v)
    (effectiveScalarPeriodizationTerm_realSmooth v)

theorem effectiveScalarPeriodizationTerm_mul_smul
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (b a : GammaTwoEffective) (z : ℍ) :
    effectiveScalarPeriodizationTerm v (b * a) (b • z) =
      effectiveScalarPeriodizationTerm v a z := by
  simp [effectiveScalarPeriodizationTerm, mul_smul]

theorem effectiveScalarPoincarePeriodization_invariant
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (b : GammaTwoEffective) (z : ℍ) :
    effectiveScalarPoincarePeriodization v (b • z) =
      effectiveScalarPoincarePeriodization v z := by
  have hreindex :
      (∑ᶠ a : GammaTwoEffective,
          effectiveScalarPeriodizationTerm v a (b • z)) =
        ∑ᶠ a : GammaTwoEffective,
          effectiveScalarPeriodizationTerm v (b * a) (b • z) := by
    symm
    simpa only [Equiv.coe_mulLeft] using
      (finsum_comp_equiv (Equiv.mulLeft b)
        (f := fun a : GammaTwoEffective ↦
          effectiveScalarPeriodizationTerm v a (b • z)))
  rw [effectiveScalarPoincarePeriodization, hreindex]
  simp_rw [effectiveScalarPeriodizationTerm_mul_smul]

/-- On a reduced chart, a seed supported in that chart has only the identity
effective translate. -/
theorem effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
    {z₀ : ℍ} (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    {z : ℍ} (hz : z ∈ gammaTwoReducedChart z₀) :
    effectiveScalarPoincarePeriodization v z = v (z : ℂ) := by
  unfold effectiveScalarPoincarePeriodization
  apply finsum_eq_single (1 : GammaTwoEffective)
  · intro a ha
    by_contra hterm
    have hxSupport : ((((a⁻¹ • z : ℍ) : ℂ))) ∈
        tsupport (v : ℂ → ℂ) :=
      subset_tsupport hterm
    have hxU : a⁻¹ • z ∈ gammaTwoReducedChart z₀ :=
      hv hxSupport
    have hInter :
        (((a • ·) '' gammaTwoReducedChart z₀) ∩
          gammaTwoReducedChart z₀).Nonempty :=
      ⟨z, ⟨a⁻¹ • z, hxU, by simp⟩, hz⟩
    exact ha (gammaTwoReducedChart_inter_translate_imp_eq_one z₀ a hInter)
  · simp [effectiveScalarPeriodizationTerm]

/-! ### Closed support and quotient-compact packaging -/

/-- Closed locally finite union of the effective translates of the compact
scalar seed support. -/
def effectiveScalarPeriodizationOrbitSupport
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) : Set ℍ :=
  ⋃ a : GammaTwoEffective,
    (a • ·) '' effectiveScalarSeedSupport v

theorem effectiveScalarPeriodizationOrbitSupport_isClosed
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    IsClosed (effectiveScalarPeriodizationOrbitSupport v) := by
  unfold effectiveScalarPeriodizationOrbitSupport
  apply (gammaTwoEffective_compact_translates_locallyFinite
    (effectiveScalarSeedSupport_isCompact v)).isClosed_iUnion
  intro a
  exact ((effectiveScalarSeedSupport_isCompact v).smul a).isClosed

theorem support_effectiveScalarPoincarePeriodization_subset_orbitSupport
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    Function.support (effectiveScalarPoincarePeriodization v) ⊆
      effectiveScalarPeriodizationOrbitSupport v := by
  intro z hz
  by_contra hzOrbit
  have hzero (a : GammaTwoEffective) :
      effectiveScalarPeriodizationTerm v a z = 0 := by
    by_contra hne
    apply hzOrbit
    exact Set.mem_iUnion.2
      ⟨a, support_effectiveScalarPeriodizationTerm_subset v a hne⟩
  apply hz
  unfold effectiveScalarPoincarePeriodization
  exact finsum_eq_zero_of_forall_eq_zero hzero

theorem tsupport_effectiveScalarPoincarePeriodization_subset_orbitSupport
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    tsupport (effectiveScalarPoincarePeriodization v) ⊆
      effectiveScalarPeriodizationOrbitSupport v :=
  closure_minimal
    (support_effectiveScalarPoincarePeriodization_subset_orbitSupport v)
    (effectiveScalarPeriodizationOrbitSupport_isClosed v)

theorem effectiveScalarPeriodizationOrbitSupport_subset_saturation
    {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀) :
    effectiveScalarPeriodizationOrbitSupport v ⊆
      gammaTwoOrbitSaturation (gammaTwoReducedChart z₀) := by
  intro z hz
  rcases Set.mem_iUnion.1 hz with ⟨a, x, hx, rfl⟩
  have hxChart : x ∈ gammaTwoReducedChart z₀ := by
    rcases hv hx with ⟨y, hy, hyx⟩
    have hxy : x = y := UpperHalfPlane.coe_injective hyx.symm
    simpa only [hxy] using hy
  apply Set.mem_iUnion.2
  exact ⟨a, x, hxChart, rfl⟩

theorem effectiveScalarPoincarePeriodization_quotientCompact
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    HasQuotientCompactSupport
      (effectiveScalarPoincarePeriodization v) := by
  let K := effectiveScalarSeedSupport v
  have hK : IsCompact K := effectiveScalarSeedSupport_isCompact v
  have hQK : IsCompact (gammaTwoQuotientMk '' K) :=
    hK.image gammaTwoQuotientMk_isOpenQuotientMap.continuous
  apply hQK.of_isClosed_subset isClosed_closure
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    have hzOrbit :=
      support_effectiveScalarPoincarePeriodization_subset_orbitSupport v hz
    rcases Set.mem_iUnion.1 hzOrbit with ⟨a, x, hxK, rfl⟩
    rcases effective_exists_gamma a with ⟨gamma, hgamma⟩
    refine ⟨x, hxK, ?_⟩
    rw [← hgamma]
    exact gammaTwoQuotientMk_gamma_smul gamma x
  · exact hQK.isClosed

/-- The invariant scalar periodization as a genuine smooth
quotient-compact function. -/
noncomputable def effectiveScalarSmoothQuotient
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    SmoothQuotientCompactFunction :=
  ⟨⟨effectiveScalarPoincarePeriodization v,
      effectiveScalarPoincarePeriodization_realSmooth v⟩,
    effectiveScalarPoincarePeriodization_quotientCompact v⟩

@[simp]
theorem effectiveScalarSmoothQuotient_apply
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) :
    (effectiveScalarSmoothQuotient v : ℍ → ℂ) z =
      effectiveScalarPoincarePeriodization v z :=
  rfl

theorem effectiveScalarSmoothQuotient_invariant
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    IsGammaTwoInvariantCutoff (effectiveScalarSmoothQuotient v) := by
  intro gamma z
  let a : GammaTwoEffective := gammaTwoEffectiveElement gamma
  simpa only [effectiveScalarSmoothQuotient_apply,
    gammaTwoEffectiveElement_smul] using
      effectiveScalarPoincarePeriodization_invariant v a z

theorem effectiveScalarPoincarePeriodization_eventuallyEq_seed_on_reducedChart
    {z₀ z : ℍ} (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hz : z ∈ gammaTwoReducedChart z₀) :
    upperLift (effectiveScalarPoincarePeriodization v) =ᶠ[𝓝 (z : ℂ)]
      (v : ℂ → ℂ) := by
  have hOpen : IsOpen (ambientGammaTwoReducedChart z₀) :=
    ambientGammaTwoReducedChart_isOpen z₀
  filter_upwards [hOpen.mem_nhds ⟨z, hz, rfl⟩] with w hw
  rcases hw with ⟨x, hx, rfl⟩
  rw [upperLift_apply,
    effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart v hv hx]

theorem dx_effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
    {z₀ z : ℍ} (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hz : z ∈ gammaTwoReducedChart z₀) :
    HalfWeightDifferentialOperators.dx
        (effectiveScalarPoincarePeriodization v) z =
      fderiv ℝ (v : ℂ → ℂ) (z : ℂ) 1 := by
  unfold HalfWeightDifferentialOperators.dx
    HalfWeightDifferentialOperators.d1
  exact Filter.EventuallyEq.fderiv_eq
    (effectiveScalarPoincarePeriodization_eventuallyEq_seed_on_reducedChart
      v hv hz) (z : ℂ)

theorem dy_effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
    {z₀ z : ℍ} (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hz : z ∈ gammaTwoReducedChart z₀) :
    HalfWeightDifferentialOperators.dy
        (effectiveScalarPoincarePeriodization v) z =
      fderiv ℝ (v : ℂ → ℂ) (z : ℂ) Complex.I := by
  unfold HalfWeightDifferentialOperators.dy
    HalfWeightDifferentialOperators.d1
  exact Filter.EventuallyEq.fderiv_eq
    (effectiveScalarPoincarePeriodization_eventuallyEq_seed_on_reducedChart
      v hv hz) (z : ℂ)

theorem effectiveScalarPoincarePeriodization_re_nonneg
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : ∀ w : ℂ, 0 ≤ (v w).re) (z : ℍ) :
    0 ≤ (effectiveScalarPoincarePeriodization v z).re := by
  obtain ⟨s, _hsNhds, hsFinite⟩ :=
    effectiveScalarPeriodizationTerm_locallyFinite v z
  let I : Finset GammaTwoEffective := hsFinite.toFinset
  have hsupport : Function.support
      (fun a : GammaTwoEffective ↦
        effectiveScalarPeriodizationTerm v a z) ⊆ I := by
    intro a ha
    rw [Set.Finite.mem_toFinset]
    exact ⟨z, ha, mem_of_mem_nhds _hsNhds⟩
  rw [effectiveScalarPoincarePeriodization,
    finsum_eq_sum_of_support_subset _ hsupport, map_sum]
  exact Finset.sum_nonneg fun a _ ↦ hv _

theorem effectiveScalarPoincarePeriodization_im_eq_zero
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : ∀ w : ℂ, (v w).im = 0) (z : ℍ) :
    (effectiveScalarPoincarePeriodization v z).im = 0 := by
  obtain ⟨s, _hsNhds, hsFinite⟩ :=
    effectiveScalarPeriodizationTerm_locallyFinite v z
  let I : Finset GammaTwoEffective := hsFinite.toFinset
  have hsupport : Function.support
      (fun a : GammaTwoEffective ↦
        effectiveScalarPeriodizationTerm v a z) ⊆ I := by
    intro a ha
    rw [Set.Finite.mem_toFinset]
    exact ⟨z, ha, mem_of_mem_nhds _hsNhds⟩
  rw [effectiveScalarPoincarePeriodization,
    finsum_eq_sum_of_support_subset _ hsupport, map_sum]
  simp [effectiveScalarPeriodizationTerm, hv]

/-! ### Finite active partition and its invariant normalization -/

/-- The exact finite set of partition members whose topological support
meets `coe '' K`. -/
def quotientChartActiveCenterSet
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K)) : Set ℍ :=
  {z : ℍ | (tsupport (rho z : ℂ → ℝ) ∩
    (UpperHalfPlane.coe '' K)).Nonempty}

noncomputable def quotientChartActiveCenters
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hfinite : (quotientChartActiveCenterSet rho).Finite) : Finset ℍ :=
  hfinite.toFinset

@[simp]
theorem mem_quotientChartActiveCenters_iff
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (z : ℍ) :
    z ∈ quotientChartActiveCenters rho hfinite ↔
      (tsupport (rho z : ℂ → ℝ) ∩
        (UpperHalfPlane.coe '' K)).Nonempty := by
  rw [quotientChartActiveCenters, Set.Finite.mem_toFinset]
  rfl

/-- The unnormalized invariant finite sum. -/
noncomputable def quotientChartPeriodizedMass
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) : ℍ → ℂ :=
  fun z ↦ ∑ x ∈ quotientChartActiveCenters rho hfinite,
    effectiveScalarPoincarePeriodization
      (reducedChartPartitionAmbientTest rho hrho x) z

theorem quotientChartPeriodizedMass_realSmooth
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) :
    RealSmooth (quotientChartPeriodizedMass rho hrho hfinite) := by
  unfold quotientChartPeriodizedMass
  exact RealSmooth.finset_sum _ fun x _ ↦
    effectiveScalarPoincarePeriodization_realSmooth
      (reducedChartPartitionAmbientTest rho hrho x)

theorem quotientChartPeriodizedMass_invariant
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (a : GammaTwoEffective) (z : ℍ) :
    quotientChartPeriodizedMass rho hrho hfinite (a • z) =
      quotientChartPeriodizedMass rho hrho hfinite z := by
  unfold quotientChartPeriodizedMass
  apply Finset.sum_congr rfl
  intro x hx
  exact effectiveScalarPoincarePeriodization_invariant _ a z

theorem quotientChartPeriodizedMass_re_nonneg
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (z : ℍ) :
    0 ≤ (quotientChartPeriodizedMass rho hrho hfinite z).re := by
  rw [quotientChartPeriodizedMass, map_sum]
  exact Finset.sum_nonneg fun x _ ↦
    effectiveScalarPoincarePeriodization_re_nonneg _
      (fun w ↦ by simp [reducedChartPartitionAmbientTest_apply]) z

theorem quotientChartPeriodizedMass_im_eq_zero
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (z : ℍ) :
    (quotientChartPeriodizedMass rho hrho hfinite z).im = 0 := by
  rw [quotientChartPeriodizedMass, map_sum]
  apply Finset.sum_eq_zero
  intro x hx
  exact effectiveScalarPoincarePeriodization_im_eq_zero _
    (fun w ↦ by simp [reducedChartPartitionAmbientTest_apply]) z

/-- The active mass is at least one on the original compact set.  Additional
orbit representatives can only add nonnegative terms. -/
theorem one_le_quotientChartPeriodizedMass_re_on_compact
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    {z : ℍ} (hz : z ∈ K) :
    1 ≤ (quotientChartPeriodizedMass rho hrho hfinite z).re := by
  let t := quotientChartActiveCenters rho hfinite
  have hsupport : Function.support (fun x : ℍ ↦ rho x (z : ℂ)) ⊆ t := by
    intro x hx
    rw [mem_quotientChartActiveCenters_iff]
    exact ⟨(z : ℂ), subset_closure hx, ⟨z, hz, rfl⟩⟩
  have hsum : ∑ x ∈ t, rho x (z : ℂ) = 1 := by
    rw [← finsum_eq_sum_of_support_subset _ hsupport]
    exact smoothPartitionOfUnity_sum_eq_one_on_compact rho ⟨z, hz, rfl⟩
  have hterm (x : ℍ) :
      rho x (z : ℂ) ≤
        (effectiveScalarPoincarePeriodization
          (reducedChartPartitionAmbientTest rho hrho x) z).re := by
    by_cases hzx : z ∈ gammaTwoReducedChart x
    · rw [effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
          (reducedChartPartitionAmbientTest rho hrho x)
          (tsupport_reducedChartPartitionAmbientTest_subset rho hrho x) hzx,
        reducedChartPartitionAmbientTest_apply]
      simp
    · have hrhozero : rho x (z : ℂ) = 0 := by
        by_contra hne
        rcases (hrho x) (subset_closure hne) with ⟨y, hy, hyz⟩
        have hyEq : y = z := UpperHalfPlane.coe_injective hyz
        exact hzx (hyEq ▸ hy)
      rw [hrhozero]
      exact effectiveScalarPoincarePeriodization_re_nonneg _
        (fun w ↦ by simp [reducedChartPartitionAmbientTest_apply]) z
  calc
    1 = ∑ x ∈ t, rho x (z : ℂ) := hsum.symm
    _ ≤ ∑ x ∈ t,
        (effectiveScalarPoincarePeriodization
          (reducedChartPartitionAmbientTest rho hrho x) z).re :=
      Finset.sum_le_sum fun x _ ↦ hterm x
    _ = (quotientChartPeriodizedMass rho hrho hfinite z).re := by
      simp [quotientChartPeriodizedMass, t, map_sum]

theorem one_le_quotientChartPeriodizedMass_re_on_saturation
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    {z : ℍ} (hz : z ∈ gammaTwoOrbitSaturation K) :
    1 ≤ (quotientChartPeriodizedMass rho hrho hfinite z).re := by
  rcases Set.mem_iUnion.1 hz with ⟨a, x, hxK, rfl⟩
  rw [quotientChartPeriodizedMass_invariant rho hrho hfinite a x]
  exact one_le_quotientChartPeriodizedMass_re_on_compact
    rho hrho hfinite hxK

/-- Smooth scalar switch: zero for mass at most `1/2`, one for mass at
least `1`. -/
noncomputable def quotientChartMassSwitch
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) (z : ℍ) : ℂ :=
  (Real.smoothTransition
    (2 * (quotientChartPeriodizedMass rho hrho hfinite z).re - 1) : ℝ)

theorem quotientChartMassSwitch_realSmooth
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) :
    RealSmooth (quotientChartMassSwitch rho hrho hfinite) := by
  unfold quotientChartMassSwitch RealSmooth upperLift
  have hB := quotientChartPeriodizedMass_realSmooth rho hrho hfinite
  unfold RealSmooth at hB
  have hRe : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ (upperLift
        (quotientChartPeriodizedMass rho hrho hfinite) w).re)
      UpperHalfPlane.upperHalfPlaneSet :=
    Complex.reCLM.contDiff.comp_contDiffOn hB
  have hAffine : ContDiffOn ℝ ∞
      (fun w : ℂ ↦
        2 * (upperLift
          (quotientChartPeriodizedMass rho hrho hfinite) w).re - 1)
      UpperHalfPlane.upperHalfPlaneSet :=
    (contDiffOn_const.mul hRe).sub contDiffOn_const
  exact Complex.ofRealCLM.contDiff.comp_contDiffOn
    (Real.smoothTransition.contDiff.comp_contDiffOn hAffine)

theorem quotientChartMassSwitch_eq_one_of_one_le
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    {z : ℍ}
    (hz : 1 ≤ (quotientChartPeriodizedMass rho hrho hfinite z).re) :
    quotientChartMassSwitch rho hrho hfinite z = 1 := by
  rw [quotientChartMassSwitch,
    Real.smoothTransition.one_of_one_le (by linarith)]
  norm_num

/-- The everywhere nonzero invariant denominator. -/
noncomputable def quotientChartNormalizationDenominator
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) (z : ℍ) : ℂ :=
  quotientChartPeriodizedMass rho hrho hfinite z +
    (1 - quotientChartMassSwitch rho hrho hfinite z)

theorem quotientChartNormalizationDenominator_realSmooth
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) :
    RealSmooth
      (quotientChartNormalizationDenominator rho hrho hfinite) := by
  exact (quotientChartPeriodizedMass_realSmooth rho hrho hfinite).add
    ((realSmooth_const 1).sub
      (quotientChartMassSwitch_realSmooth rho hrho hfinite))

theorem quotientChartNormalizationDenominator_ne_zero
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (z : ℍ) :
    quotientChartNormalizationDenominator rho hrho hfinite z ≠ 0 := by
  have hB := quotientChartPeriodizedMass_re_nonneg rho hrho hfinite z
  have hchi0 := Real.smoothTransition.nonneg
    (2 * (quotientChartPeriodizedMass rho hrho hfinite z).re - 1)
  have hchi1 := Real.smoothTransition.le_one
    (2 * (quotientChartPeriodizedMass rho hrho hfinite z).re - 1)
  have him := quotientChartPeriodizedMass_im_eq_zero rho hrho hfinite z
  intro hzero
  have hre := congrArg Complex.re hzero
  simp only [quotientChartNormalizationDenominator,
    quotientChartMassSwitch, map_add, map_sub, Complex.one_re,
    Complex.ofReal_re, Complex.zero_re] at hre
  by_cases hBzero :
      (quotientChartPeriodizedMass rho hrho hfinite z).re = 0
  · rw [hBzero] at hre
    have hswitch : Real.smoothTransition (-1) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by norm_num)
    rw [hswitch] at hre
    norm_num at hre
  · have hBpos :
        0 < (quotientChartPeriodizedMass rho hrho hfinite z).re :=
      lt_of_le_of_ne hB (Ne.symm hBzero)
    nlinarith

noncomputable def quotientChartNormalizer
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) (z : ℍ) : ℂ :=
  (quotientChartNormalizationDenominator rho hrho hfinite z)⁻¹

theorem quotientChartNormalizer_realSmooth
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite) :
    RealSmooth (quotientChartNormalizer rho hrho hfinite) :=
  (quotientChartNormalizationDenominator_realSmooth rho hrho hfinite).inv
    (quotientChartNormalizationDenominator_ne_zero rho hrho hfinite)

theorem quotientChartNormalizer_invariant
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (a : GammaTwoEffective) (z : ℍ) :
    quotientChartNormalizer rho hrho hfinite (a • z) =
      quotientChartNormalizer rho hrho hfinite z := by
  simp only [quotientChartNormalizer,
    quotientChartNormalizationDenominator, quotientChartMassSwitch,
    quotientChartPeriodizedMass_invariant rho hrho hfinite a z]

/-- Normalized local seed.  Its support remains in the original reduced
chart because `localizeLeft` multiplies on the left by the global invariant
normalizer. -/
noncomputable def normalizedQuotientChartSeed
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (x : ℍ) : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
  HalfWeightCompactCoordinateGreen.localizeLeft
    (quotientChartNormalizer rho hrho hfinite)
    (quotientChartNormalizer_realSmooth rho hrho hfinite)
    (reducedChartPartitionAmbientTest rho hrho x)

theorem tsupport_normalizedQuotientChartSeed_subset
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    (x : ℍ) :
    tsupport (normalizedQuotientChartSeed rho hrho hfinite x : ℂ → ℂ)
      ⊆ ambientGammaTwoReducedChart x :=
  (tsupport_mul_subset_right :
    tsupport (fun w : ℂ ↦
      upperLift (quotientChartNormalizer rho hrho hfinite) w *
        reducedChartPartitionAmbientTest rho hrho x w) ⊆
      tsupport
        (reducedChartPartitionAmbientTest rho hrho x : ℂ → ℂ)).trans
    (tsupport_reducedChartPartitionAmbientTest_subset rho hrho x)

/-- Periodization commutes exactly with multiplication by an invariant
smooth scalar. -/
theorem effectiveScalarPeriodization_localizeLeft
    (f : ℍ → ℂ) (hf : RealSmooth f)
    (hinv : ∀ (a : GammaTwoEffective) (z : ℍ), f (a • z) = f z)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (z : ℍ) :
    effectiveScalarPoincarePeriodization
        (HalfWeightCompactCoordinateGreen.localizeLeft f hf v) z =
      f z * effectiveScalarPoincarePeriodization v z := by
  unfold effectiveScalarPoincarePeriodization
  have hfactor (a : GammaTwoEffective) : f (a⁻¹ • z) = f z :=
    hinv a⁻¹ z
  simp_rw [effectiveScalarPeriodizationTerm,
    HalfWeightCompactCoordinateGreen.localizeLeft_apply, upperLift_apply,
    hfactor]
  rw [← mul_finsum]

/-- The normalized finite quotient-chart periodizations sum to one on the
whole saturated compact carrier.  This is the exact seam-compatible gluing
identity needed by the local graph-limit package. -/
theorem normalizedQuotientChartPeriodizations_sum_eq_one_on_saturation
    {K : Set ℍ}
    (rho : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hrho : rho.IsSubordinate ambientGammaTwoReducedChart)
    (hfinite : (quotientChartActiveCenterSet rho).Finite)
    {z : ℍ} (hz : z ∈ gammaTwoOrbitSaturation K) :
    (∑ x ∈ quotientChartActiveCenters rho hfinite,
      effectiveScalarPoincarePeriodization
        (normalizedQuotientChartSeed rho hrho hfinite x) z) = 1 := by
  have hB := one_le_quotientChartPeriodizedMass_re_on_saturation
    rho hrho hfinite hz
  have hswitch := quotientChartMassSwitch_eq_one_of_one_le
    rho hrho hfinite hB
  simp_rw [effectiveScalarPeriodization_localizeLeft
    (quotientChartNormalizer rho hrho hfinite)
    (quotientChartNormalizer_realSmooth rho hrho hfinite)
    (quotientChartNormalizer_invariant rho hrho hfinite)]
  rw [← Finset.mul_sum, quotientChartPeriodizedMass]
  rw [quotientChartNormalizer, quotientChartNormalizationDenominator,
    hswitch, sub_self, add_zero]
  exact inv_mul_cancel₀ (by
    intro hzero
    have := congrArg Complex.re hzero
    have hBne :
        (quotientChartPeriodizedMass rho hrho hfinite z).re ≠ 0 :=
      ne_of_gt (lt_of_lt_of_le zero_lt_one hB)
    exact hBne (by simpa using this))

/-- Fully unconditional existence form used by the final finite gluing
argument. -/
theorem exists_quotientCompatibleFiniteReducedChartLocalization
    {K : Set ℍ} (hK : IsCompact K) :
    ∃ t : Finset ℍ,
    ∃ theta : ℍ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore,
      (∀ x ∈ t,
        tsupport (theta x : ℂ → ℂ) ⊆
          ambientGammaTwoReducedChart x) ∧
      (∀ a : GammaTwoEffective, ∀ x ∈ t, ∀ z : ℍ,
        effectiveScalarPoincarePeriodization (theta x) (a • z) =
          effectiveScalarPoincarePeriodization (theta x) z) ∧
      (∀ z ∈ gammaTwoOrbitSaturation K,
        (∑ x ∈ t,
          effectiveScalarPoincarePeriodization (theta x) z) = 1) := by
  obtain ⟨rho, hrho, _hcompact, hfinite⟩ :=
    exists_smoothPartitionOfUnity_gammaTwoReducedChart hK
  let t := quotientChartActiveCenters rho hfinite
  let theta : ℍ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
    normalizedQuotientChartSeed rho hrho hfinite
  refine ⟨t, theta, ?_, ?_, ?_⟩
  · intro x hx
    exact tsupport_normalizedQuotientChartSeed_subset
      rho hrho hfinite x
  · intro a x hx z
    exact effectiveScalarPoincarePeriodization_invariant (theta x) a z
  · intro z hz
    exact normalizedQuotientChartPeriodizations_sum_eq_one_on_saturation
      rho hrho hfinite hz

end FixedPhaseReducedChartFriedrichs

namespace AxiomAuditP3QuotientCompatibleFiniteGluing

