/-!
### P3.16: reduced quotient charts and a smooth finite-on-compact partition

The boundary of one selected fundamental polygon is not an analytic boundary
of the quotient.  Consequently a Friedrichs proof may not zero-extend across
that polygon boundary.  Proper discontinuity instead supplies relatively
compact quotient charts around every point, including paired-side points.
This section constructs those charts and a genuine real-smooth partition of
unity subordinate to them.  On any compact carrier only finitely many
topological supports occur.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory
open scoped Manifold ContDiff
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open FixedPhaseEssentialCoreRoute

/-! #### Canonical relatively compact reduced charts -/

/-- A compact neighbourhood selected from proper discontinuity. -/
noncomputable def gammaTwoReducedChartCompact (z : ℍ) : Set ℍ :=
  Classical.choose
    (gammaTwoEffective_exists_compact_nhds_image_smul_eq_self z)

theorem gammaTwoReducedChartCompact_spec (z : ℍ) :
    IsCompact (gammaTwoReducedChartCompact z) ∧
      gammaTwoReducedChartCompact z ∈ nhds z ∧
      ∀ a : GammaTwoEffective,
        (((a • ·) '' gammaTwoReducedChartCompact z) ∩
          gammaTwoReducedChartCompact z).Nonempty →
            a • z = z :=
  Classical.choose_spec
    (gammaTwoEffective_exists_compact_nhds_image_smul_eq_self z)

/-- The open reduced chart is the interior of the selected compact
neighbourhood. -/
noncomputable def gammaTwoReducedChart (z : ℍ) : Set ℍ :=
  interior (gammaTwoReducedChartCompact z)

theorem gammaTwoReducedChart_isOpen (z : ℍ) :
    IsOpen (gammaTwoReducedChart z) :=
  isOpen_interior

theorem mem_gammaTwoReducedChart (z : ℍ) :
    z ∈ gammaTwoReducedChart z := by
  exact mem_interior_iff_mem_nhds.mpr
    (gammaTwoReducedChartCompact_spec z).2.1

theorem gammaTwoReducedChart_subset_compact (z : ℍ) :
    gammaTwoReducedChart z ⊆ gammaTwoReducedChartCompact z :=
  interior_subset

theorem closure_gammaTwoReducedChart_subset_compact (z : ℍ) :
    closure (gammaTwoReducedChart z) ⊆
      gammaTwoReducedChartCompact z := by
  exact closure_minimal interior_subset
    (gammaTwoReducedChartCompact_spec z).1.isClosed

theorem gammaTwoReducedChart_closure_isCompact (z : ℍ) :
    IsCompact (closure (gammaTwoReducedChart z)) :=
  (gammaTwoReducedChartCompact_spec z).1.of_isClosed_subset
    isClosed_closure (closure_gammaTwoReducedChart_subset_compact z)

/-- A reduced chart can meet one of its effective translates only through
the stabilizer of its centre.  No polygon-side exception is present. -/
theorem gammaTwoReducedChart_inter_translate_imp_smul_eq
    (z : ℍ) (a : GammaTwoEffective)
    (h : (((a • ·) '' gammaTwoReducedChart z) ∩
      gammaTwoReducedChart z).Nonempty) :
    a • z = z := by
  apply (gammaTwoReducedChartCompact_spec z).2.2 a
  rcases h with ⟨y, ⟨x, hx, hxy⟩, hy⟩
  exact ⟨y,
    ⟨x, gammaTwoReducedChart_subset_compact z hx, hxy⟩,
    gammaTwoReducedChart_subset_compact z hy⟩

/-- Every compact upper-half-plane set admits a finite cover by reduced
charts. -/
theorem compact_subset_finite_iUnion_gammaTwoReducedChart
    {K : Set ℍ} (hK : IsCompact K) :
    ∃ t : Finset ℍ,
      K ⊆ ⋃ z ∈ t, gammaTwoReducedChart z := by
  apply hK.elim_finite_subcover gammaTwoReducedChart
  · exact gammaTwoReducedChart_isOpen
  · intro z hz
    exact Set.mem_iUnion.2 ⟨z,
      mem_gammaTwoReducedChart z⟩

/-! #### Ambient real charts -/

/-- Image of a reduced chart in the ambient real plane. -/
noncomputable def ambientGammaTwoReducedChart (z : ℍ) : Set ℂ :=
  UpperHalfPlane.coe '' gammaTwoReducedChart z

theorem ambientGammaTwoReducedChart_isOpen (z : ℍ) :
    IsOpen (ambientGammaTwoReducedChart z) :=
  UpperHalfPlane.isOpenEmbedding_coe.isOpenMap _
    (gammaTwoReducedChart_isOpen z)

theorem ambientGammaTwoReducedChart_subset_upperPlaneOpen (z : ℍ) :
    ambientGammaTwoReducedChart z ⊆
      HalfWeightCompactCoordinateGreen.upperPlaneOpen := by
  rintro w ⟨x, _hx, rfl⟩
  exact x.im_pos

theorem closure_ambientGammaTwoReducedChart_isCompact (z : ℍ) :
    IsCompact (closure (ambientGammaTwoReducedChart z)) := by
  have hBig : IsCompact
      (UpperHalfPlane.coe '' gammaTwoReducedChartCompact z) :=
    (gammaTwoReducedChartCompact_spec z).1.image
      UpperHalfPlane.continuous_coe
  apply hBig.of_isClosed_subset isClosed_closure
  apply closure_minimal
  · exact Set.image_mono (gammaTwoReducedChart_subset_compact z)
  · exact hBig.isClosed

theorem compact_ambient_subset_finite_iUnion_reducedChart
    {K : Set ℍ} (hK : IsCompact K) :
    ∃ t : Finset ℍ,
      UpperHalfPlane.coe '' K ⊆
        ⋃ z ∈ t, ambientGammaTwoReducedChart z := by
  obtain ⟨t, ht⟩ :=
    compact_subset_finite_iUnion_gammaTwoReducedChart hK
  refine ⟨t, ?_⟩
  rintro _ ⟨x, hxK, rfl⟩
  rcases Set.mem_iUnion₂.1 (ht hxK) with ⟨z, hzt, hxz⟩
  exact Set.mem_iUnion₂.2
    ⟨z, hzt, ⟨x, hxz, rfl⟩⟩

/-! #### Smooth partition subordinate to the reduced charts -/

/-- Every compact carrier has a genuine real-smooth partition of unity
subordinate to the reduced ambient quotient charts.  Each member is compactly
supported in the upper half-plane, and only finitely many topological supports
meet the compact carrier. -/
theorem exists_smoothPartitionOfUnity_gammaTwoReducedChart
    {K : Set ℍ} (hK : IsCompact K) :
    ∃ ρ : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
        (UpperHalfPlane.coe '' K),
      ρ.IsSubordinate ambientGammaTwoReducedChart ∧
      (∀ z : ℍ, HasCompactSupport (ρ z : ℂ → ℝ)) ∧
      {z : ℍ |
        (tsupport (ρ z : ℂ → ℝ) ∩
          (UpperHalfPlane.coe '' K)).Nonempty}.Finite := by
  have hKambient : IsCompact (UpperHalfPlane.coe '' K) :=
    hK.image UpperHalfPlane.continuous_coe
  have hCover : UpperHalfPlane.coe '' K ⊆
      ⋃ z : ℍ, ambientGammaTwoReducedChart z := by
    rintro _ ⟨z, hzK, rfl⟩
    exact Set.mem_iUnion.2
      ⟨z, ⟨z, mem_gammaTwoReducedChart z, rfl⟩⟩
  obtain ⟨ρ, hρ⟩ :=
    SmoothPartitionOfUnity.exists_isSubordinate
      (I := 𝓘(ℝ, ℂ)) hKambient.isClosed
      ambientGammaTwoReducedChart
      ambientGammaTwoReducedChart_isOpen hCover
  refine ⟨ρ, hρ, ?_, ?_⟩
  · intro z
    exact (closure_ambientGammaTwoReducedChart_isCompact z).of_isClosed_subset isClosed_closure
        ((hρ z).trans subset_closure)
  · exact ρ.toPartitionOfUnity.locallyFinite_tsupport.finite_nonempty_inter_compact hKambient

/-- A subordinate partition member, complexified, is an actual member of the
same ambient `C_c^infinity` core used by the weak Maass equations. -/
noncomputable def reducedChartPartitionAmbientTest
    {K : Set ℍ}
    (ρ : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hρ : ρ.IsSubordinate ambientGammaTwoReducedChart)
    (z : ℍ) : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore where
  toFun := Complex.ofRealCLM ∘ (ρ z : ℂ → ℝ)
  contDiff' := Complex.ofRealCLM.contDiff.comp
    (ρ z).contMDiff.contDiff
  hasCompactSupport' := by
    have hReal : HasCompactSupport (ρ z : ℂ → ℝ) :=
      (closure_ambientGammaTwoReducedChart_isCompact z).of_isClosed_subset isClosed_closure
          ((hρ z).trans subset_closure)
    exact hReal.comp_left rfl
  tsupport_subset' := by
    exact (tsupport_comp_subset rfl (ρ z : ℂ → ℝ)).trans <|
      (hρ z).trans
        (ambientGammaTwoReducedChart_subset_upperPlaneOpen z)

@[simp]
theorem reducedChartPartitionAmbientTest_apply
    {K : Set ℍ}
    (ρ : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hρ : ρ.IsSubordinate ambientGammaTwoReducedChart)
    (z : ℍ) (w : ℂ) :
    reducedChartPartitionAmbientTest ρ hρ z w =
      ((ρ z w : ℝ) : ℂ) :=
  rfl

theorem tsupport_reducedChartPartitionAmbientTest_subset
    {K : Set ℍ}
    (ρ : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    (hρ : ρ.IsSubordinate ambientGammaTwoReducedChart)
    (z : ℍ) :
    tsupport
        (reducedChartPartitionAmbientTest ρ hρ z : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z :=
  (tsupport_comp_subset rfl (ρ z : ℂ → ℝ)).trans (hρ z)

/-- The smooth partition still sums exactly to one on the compact carrier;
this is the finite-on-compact localization identity used before convolution. -/
theorem smoothPartitionOfUnity_sum_eq_one_on_compact
    {K : Set ℍ}
    (ρ : SmoothPartitionOfUnity ℍ 𝓘(ℝ, ℂ) ℂ
      (UpperHalfPlane.coe '' K))
    {w : ℂ} (hw : w ∈ UpperHalfPlane.coe '' K) :
    ∑ᶠ z : ℍ, ρ z w = 1 :=
  ρ.sum_eq_one hw

end FixedPhaseReducedChartFriedrichs

namespace AxiomAuditP3ReducedChartFriedrichs

