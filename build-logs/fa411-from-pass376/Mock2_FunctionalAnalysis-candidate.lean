/-! ## P2.6: unconditional graph closure and double adjoints

This final operator layer deliberately separates two statements which need
different analysis.  Local compact-test distributional uniqueness proves
closability, hence identifies the double Hilbert adjoint with the canonical
graph closure.  It does **not** identify raising with the adjoint of signed
lowering; that cross-adjoint assertion remains in the earlier Green/Stokes
layer with its explicit hypotheses.
-/

namespace Mock2FA
namespace PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators

open DefinitionOneSobolev
open HalfWeightDifferentialOperators
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open scoped LinearPMap

noncomputable local instance fixedPhaseClosedTowerCoreModule (n : ℤ) :
    Module ℂ (InverseEtaFixedPhaseCore n) := by
  change Module ℂ ↥(inverseEtaFixedPhaseStableCoreSubmodule n)
  exact Submodule.module (inverseEtaFixedPhaseStableCoreSubmodule n)

noncomputable local instance fixedPhaseClosedTowerCoreAddCommGroup (n : ℤ) :
    AddCommGroup (InverseEtaFixedPhaseCore n) := by
  exact Module.addCommMonoidToAddCommGroup ℂ

/-! ### Canonical double-adjoint closures on the physical tower -/

/-- The second Hilbert adjoint of the physical raising operator is exactly its
canonical graph closure.  This uses only unconditional local closability and
the already-proved density of the physical smooth domain. -/
theorem physicalRaise_adjoint_adjoint_eq_closedRaise (n : ℤ) :
    (physicalRaise n)†† = closedRaise n := by
  change (physicalRaise n)†† = (physicalRaise n).closure
  exact FormalAdjointClosure.adjoint_adjoint_eq_closure
    (physicalRaise_isClosable n) (physicalRaise_dense_domain n)

/-- The successor-indexed physical lowering operator also equals its second
Hilbert adjoint after closure, with no Green or boundary hypothesis. -/
theorem physicalLowerFromSucc_adjoint_adjoint_eq_closedLowerFromSucc
    (n : ℤ) :
    (physicalLowerFromSucc n)†† = closedLowerFromSucc n := by
  change (physicalLowerFromSucc n)†† =
    (physicalLowerFromSucc n).closure
  exact FormalAdjointClosure.adjoint_adjoint_eq_closure
    (physicalLowerFromSucc_isClosable n)
    (physicalLowerFromSucc_dense_domain n)

/-- The genuine two-component physical operator has the same canonical
double-adjoint closure. -/
theorem physicalJointFromSucc_adjoint_adjoint_eq_closedJointFromSucc
    (n : ℤ) :
    (physicalJointFromSucc n)†† = closedJointFromSucc n := by
  change (physicalJointFromSucc n)†† =
    (physicalJointFromSucc n).closure
  exact FormalAdjointClosure.adjoint_adjoint_eq_closure
    (physicalJointFromSucc_isClosable n)
    (physicalJointFromSucc_dense_domain n)

/-- Every raw raising graph is contained in its second Hilbert adjoint.  This
is the unconditional adjoint inclusion attached to the canonical closure; it
does not assert the stronger cross identity with signed lowering. -/
theorem physicalRaise_le_adjoint_adjoint (n : ℤ) :
    physicalRaise n ≤ (physicalRaise n)†† := by
  rw [physicalRaise_adjoint_adjoint_eq_closedRaise]
  exact physicalRaise_le_closedRaise n

/-- The analogous unconditional second-adjoint inclusion for lowering. -/
theorem physicalLowerFromSucc_le_adjoint_adjoint (n : ℤ) :
    physicalLowerFromSucc n ≤ (physicalLowerFromSucc n)†† := by
  rw [physicalLowerFromSucc_adjoint_adjoint_eq_closedLowerFromSucc]
  exact physicalLowerFromSucc_le_closedLowerFromSucc n

/-- The actual two-coordinate raw graph is contained in its second adjoint,
whose graph is exactly the closed physical joint graph. -/
theorem physicalJointFromSucc_le_adjoint_adjoint (n : ℤ) :
    physicalJointFromSucc n ≤ (physicalJointFromSucc n)†† := by
  rw [physicalJointFromSucc_adjoint_adjoint_eq_closedJointFromSucc]
  exact physicalJointFromSucc_le_closedJointFromSucc n

/-- In particular, the adjoint of every raising operator has dense domain. -/
theorem physicalRaise_adjoint_dense_domain (n : ℤ) :
    Dense (((physicalRaise n)†).domain :
      Set (OrbitPeterssonHilbert (n + 1))) :=
  FormalAdjointClosure.adjoint_dense_domain
    (physicalRaise_isClosable n) (physicalRaise_dense_domain n)

/-- The adjoint of every successor-indexed lowering operator has dense
domain. -/
theorem physicalLowerFromSucc_adjoint_dense_domain (n : ℤ) :
    Dense (((physicalLowerFromSucc n)†).domain :
      Set (OrbitPeterssonHilbert n)) :=
  FormalAdjointClosure.adjoint_dense_domain
    (physicalLowerFromSucc_isClosable n)
    (physicalLowerFromSucc_dense_domain n)

/-- The adjoint of every physical joint operator has dense domain. -/
theorem physicalJointFromSucc_adjoint_dense_domain (n : ℤ) :
    Dense (((physicalJointFromSucc n)†).domain :
      Set (PhysicalJointTarget n)) :=
  FormalAdjointClosure.adjoint_dense_domain
    (physicalJointFromSucc_isClosable n)
    (physicalJointFromSucc_dense_domain n)

/-! ### Exact reindexing of the actual lowering coordinate -/

/-- The actual lowering map at source index `n+1`, transported only across
the arithmetic identity `(n+1)-1=n`.  This definition exposes the transport
instead of silently conflating the source and target indices. -/
noncomputable def reindexedActualLower (n : ℤ) :
    InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      InverseEtaFixedPhaseCore n :=
  InverseEtaFixedPhaseCore.lowerFromSucc n

/-- The transported actual lowering map is exactly the separately typed
`lowerFromSucc`; both have the same raw differential expression and stable-core
proof. -/
theorem reindexedActualLower_eq_lowerFromSucc (n : ℤ) :
    reindexedActualLower n = InverseEtaFixedPhaseCore.lowerFromSucc n :=
  rfl

/-- The corresponding transported Petersson coordinate. -/
noncomputable def reindexedActualLoweredCoordinate (n : ℤ) :
    InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (reindexedActualLower n)

/-- Reindexing commutes exactly with the Petersson coordinate; hence the
lowering coordinate appearing in the actual graph completion is the one used
by the physical successor-indexed operator. -/
theorem reindexedActualLoweredCoordinate_eq_lowerFromSuccCoordinate
    (n : ℤ) :
    reindexedActualLoweredCoordinate n = lowerFromSuccCoordinate n := by
  rw [reindexedActualLoweredCoordinate,
    reindexedActualLower_eq_lowerFromSucc]
  rfl

/-! ### A reusable graph-completion closability bridge -/

/-- If the raw three-coordinate graph of `Q` is contained in the graph of a
closable physical joint operator on the same base and derivative spaces, then
the base projection from the graph completion is injective.  The proof uses
the canonical realization of the graph completion as the closure of the raw
graph, transports that closure through the outer `WithLp` homeomorphism, and
then applies the vertical-line characterization of closability. -/
theorem quotientCoordinates_jointlyClosable_of_jointGraph
    {V H₀ HR HL : Type*}
    [AddCommGroup V] [Module ℂ V]
    [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
    [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
    [NormedAddCommGroup HL] [InnerProductSpace ℂ HL]
    [CompleteSpace H₀] [CompleteSpace HR] [CompleteSpace HL]
    (Q : DefinitionOneSobolev.QuotientHilbertCoordinates V H₀ HR HL)
    (T : H₀ →ₗ.[ℂ] WithLp 2 (HR × HL))
    (hT : T.IsClosable)
    (hCore : ∀ u : V,
      (Q.base u, WithLp.toLp 2 (Q.raised u, Q.lowered u)) ∈ T.graph) :
    Q.JointlyClosable := by
  intro x y hxy
  let z : Q.SobolevCompletion := x - y
  have hBase : Q.baseExtension z = 0 := by
    dsimp only [z]
    rw [map_sub, hxy, sub_self]
  have hRawClosure :
      Q.graphExtension z ∈ closure (Set.range Q.graph) := by
    rw [← Q.range_graphExtension_eq_closure_range_graph]
    exact ⟨z, rfl⟩
  let unwrap :
      DefinitionOneSobolev.EnergyTarget H₀ HR HL ≃L[ℂ]
        H₀ × WithLp 2 (HR × HL) :=
    WithLp.prodContinuousLinearEquiv 2 ℂ H₀ (WithLp 2 (HR × HL))
  have hImageSubset :
      unwrap '' Set.range Q.graph ⊆
        (T.graph : Set (H₀ × WithLp 2 (HR × HL))) := by
    rintro _ ⟨_, ⟨u, rfl⟩, rfl⟩
    change
      (Q.base u, WithLp.toLp 2 (Q.raised u, Q.lowered u)) ∈ T.graph
    exact hCore u
  have hMappedSet :
      unwrap (Q.graphExtension z) ∈
        closure (T.graph : Set (H₀ × WithLp 2 (HR × HL))) :=
    (closure_mono hImageSubset)
      ((image_closure_subset_closure_image unwrap.continuous)
        ⟨Q.graphExtension z, hRawClosure, rfl⟩)
  have hMapped :
      unwrap (Q.graphExtension z) ∈ T.graph.topologicalClosure := by
    change unwrap (Q.graphExtension z) ∈
      closure (T.graph : Set (H₀ × WithLp 2 (HR × HL)))
    exact hMappedSet
  rw [hT.graph_closure_eq_closure_graph] at hMapped
  have hFirstZero : (unwrap (Q.graphExtension z)).1 = 0 := by
    change Q.baseExtension z = 0
    exact hBase
  have hTailZero : (unwrap (Q.graphExtension z)).2 = 0 :=
    T.closure.graph_fst_eq_zero_snd hMapped hFirstZero
  have hTailZero' : (Q.graphExtension z).snd = 0 := by
    change (Q.graphExtension z).snd = 0 at hTailZero
    exact hTailZero
  have hRaise : Q.raiseExtension z = 0 := by
    change (Q.graphExtension z).snd.fst = 0
    rw [hTailZero']
    rfl
  have hLower : Q.lowerExtension z = 0 := by
    change (Q.graphExtension z).snd.snd = 0
    rw [hTailZero']
    rfl
  have hz : z = 0 := by
    apply Q.jointExtensions_injective
    apply Prod.ext
    · simpa only [map_zero] using hBase
    · apply Prod.ext
      · simpa only [map_zero] using hRaise
      · simpa only [map_zero] using hLower
  apply sub_eq_zero.mp
  simpa only [z] using hz

/-! ### The actual Definition-1 graph completion is jointly closable -/

private abbrev successorCoordinateType (n k : ℤ) :=
  DefinitionOneSobolev.QuotientHilbertCoordinates
    (InverseEtaFixedPhaseCore (n + 1))
    (OrbitPeterssonHilbert (n + 1))
    (OrbitPeterssonHilbert ((n + 1) + 1))
    (OrbitPeterssonHilbert k)

private theorem successorIndexEq (n : ℤ) : n + 1 - 1 = n :=
  add_sub_cancel_right n 1

private noncomputable def transportSuccessorCoordinates
    (n m : ℤ) (h : m = n) (Q : successorCoordinateType n m) :
    successorCoordinateType n n :=
  Eq.mp (congrArg (successorCoordinateType n) h) Q

private theorem transportSuccessorCoordinates_base
    (n m : ℤ) (h : m = n) (Q : successorCoordinateType n m)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (transportSuccessorCoordinates n m h Q).base u = Q.base u := by
  cases h
  rfl

private theorem transportSuccessorCoordinates_raised
    (n m : ℤ) (h : m = n) (Q : successorCoordinateType n m)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (transportSuccessorCoordinates n m h Q).raised u = Q.raised u := by
  cases h
  rfl

private theorem transportSuccessorCoordinates_lowered
    (n m : ℤ) (h : m = n) (Q : successorCoordinateType n m)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (transportSuccessorCoordinates n m h Q).lowered u =
      Eq.mp (congrArg OrbitPeterssonHilbert h) (Q.lowered u) := by
  cases h
  rfl

private theorem transportL2Coordinate
    (m n : ℤ) (h : m = n) (u : InverseEtaFixedPhaseCore m) :
    Eq.mp (congrArg OrbitPeterssonHilbert h) (l2Coordinate m u) =
      l2Coordinate n
        (Eq.mp (congrArg InverseEtaFixedPhaseCore h) u) := by
  cases h
  rfl

private theorem coe_transportInverseEtaFixedPhaseCore
    (m n : ℤ) (h : m = n) (u : InverseEtaFixedPhaseCore m) :
    ((Eq.mp (congrArg InverseEtaFixedPhaseCore h) u :
        InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction) =
      (u : SmoothQuotientCompactFunction) := by
  cases h
  rfl

private theorem transportLowerCore_eq_lowerFromSucc
    (n : ℤ) (u : InverseEtaFixedPhaseCore (n + 1)) :
    Eq.mp (congrArg InverseEtaFixedPhaseCore (successorIndexEq n))
        (InverseEtaFixedPhaseCore.lower (n + 1) u) =
      InverseEtaFixedPhaseCore.lowerFromSucc n u := by
  apply Subtype.ext
  change
    ((Eq.mp (congrArg InverseEtaFixedPhaseCore (successorIndexEq n))
        (InverseEtaFixedPhaseCore.lower (n + 1) u) :
          InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction) =
      ((InverseEtaFixedPhaseCore.lowerFromSucc n u :
          InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction)
  calc
    _ = ((InverseEtaFixedPhaseCore.lower (n + 1) u :
          InverseEtaFixedPhaseCore (n + 1 - 1)) :
            SmoothQuotientCompactFunction) :=
      coe_transportInverseEtaFixedPhaseCore
        (n + 1 - 1) n (successorIndexEq n)
        (InverseEtaFixedPhaseCore.lower (n + 1) u)
    _ = _ := rfl

private theorem transportedCoordinateLowered_eq_reindexed
    (n : ℤ) (u : InverseEtaFixedPhaseCore (n + 1)) :
    Eq.mp (congrArg OrbitPeterssonHilbert (successorIndexEq n))
        ((DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates
          (n + 1)).lowered u) =
      reindexedActualLoweredCoordinate n u := by
  rw [DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates_lowered]
  rw [transportL2Coordinate (n + 1 - 1) n (successorIndexEq n)]
  rw [transportLowerCore_eq_lowerFromSucc]
  rfl

/-- The three actual coordinates at source index `n+1`, transported only in
its lowering target across `(n+1)-1=n`. -/
noncomputable def successorGraphCoordinates (n : ℤ) :
    successorCoordinateType n n :=
  transportSuccessorCoordinates n (n + 1 - 1) (successorIndexEq n)
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates (n + 1))

@[simp]
theorem successorGraphCoordinates_base (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (successorGraphCoordinates n).base u = l2Coordinate (n + 1) u := by
  exact transportSuccessorCoordinates_base n (n + 1 - 1)
    (successorIndexEq n)
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates (n + 1)) u

@[simp]
theorem successorGraphCoordinates_raised (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (successorGraphCoordinates n).raised u = raisedCoordinate (n + 1) u := by
  exact transportSuccessorCoordinates_raised n (n + 1 - 1)
    (successorIndexEq n)
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates (n + 1)) u

@[simp]
theorem successorGraphCoordinates_lowered (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    (successorGraphCoordinates n).lowered u =
      reindexedActualLoweredCoordinate n u := by
  rw [successorGraphCoordinates,
    transportSuccessorCoordinates_lowered]
  exact transportedCoordinateLowered_eq_reindexed n u

/-- This rewritten coordinate package is literally the original graph
coordinate package transported across the displayed integer identity. -/
theorem successorGraphCoordinates_eq_coordinates (n : ℤ) :
    successorGraphCoordinates n =
      transportSuccessorCoordinates n (n + 1 - 1) (successorIndexEq n)
        (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates (n + 1)) :=
  rfl

/-- Every raw successor graph vector belongs to the genuine physical joint
operator graph. -/
theorem successorGraphCoordinates_core_mem_physicalJointGraph
    (n : ℤ) (u : InverseEtaFixedPhaseCore (n + 1)) :
    ((successorGraphCoordinates n).base u,
        WithLp.toLp 2
          ((successorGraphCoordinates n).raised u,
            (successorGraphCoordinates n).lowered u)) ∈
      (physicalJointFromSucc n).graph := by
  simpa only [successorGraphCoordinates_base,
    successorGraphCoordinates_raised, successorGraphCoordinates_lowered,
    reindexedActualLoweredCoordinate_eq_lowerFromSuccCoordinate,
    l2CoreRangeEquiv_coe, physicalJointFromSucc_on_core] using
      (physicalJointFromSucc n).mem_graph
        (l2CoreRangeEquiv (n + 1) u)

/-- Joint closability for the successor-index presentation follows directly
from unconditional closability of the physical joint operator. -/
theorem successorGraphCoordinates_jointlyClosable (n : ℤ) :
    (successorGraphCoordinates n).JointlyClosable :=
  quotientCoordinates_jointlyClosable_of_jointGraph
    (successorGraphCoordinates n) (physicalJointFromSucc n)
    (physicalJointFromSucc_isClosable n)
    (successorGraphCoordinates_core_mem_physicalJointGraph n)

/-! ### Exact compatibility with the physical closed joint graph -/

/-- Remove the outer `WithLp 2` wrapper from a successor graph vector.  This
is a continuous linear equivalence, so it transports closures exactly. -/
noncomputable def successorGraphUnwrap (n : ℤ) :
    DefinitionOneSobolev.EnergyTarget
        (OrbitPeterssonHilbert (n + 1))
        (OrbitPeterssonHilbert ((n + 1) + 1))
        (OrbitPeterssonHilbert n) ≃L[ℂ]
      OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n :=
  WithLp.prodContinuousLinearEquiv 2 ℂ
    (OrbitPeterssonHilbert (n + 1)) (PhysicalJointTarget n)

/-- Before closure, unwrapping the range of the actual three-coordinate graph
gives exactly the graph of the genuine densely-defined physical joint
operator.  The reverse inclusion uses the algebraic equivalence between the
smooth core and its `L²` range, so no graph-density assertion is hidden. -/
theorem successorGraphUnwrap_image_range_graph_eq_physicalJointGraph
    (n : ℤ) :
    successorGraphUnwrap n ''
        Set.range (successorGraphCoordinates n).graph =
      ((physicalJointFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨_, ⟨u, rfl⟩, rfl⟩
    change
      ((successorGraphCoordinates n).base u,
          WithLp.toLp 2
            ((successorGraphCoordinates n).raised u,
              (successorGraphCoordinates n).lowered u)) ∈
        (physicalJointFromSucc n).graph
    exact successorGraphCoordinates_core_mem_physicalJointGraph n u
  · intro p hp
    rcases (LinearPMap.mem_graph_iff (physicalJointFromSucc n)).mp hp with
      ⟨x, hxBase, hxValue⟩
    let u : InverseEtaFixedPhaseCore (n + 1) :=
      (l2CoreRangeEquiv (n + 1)).symm x
    refine ⟨(successorGraphCoordinates n).graph u, ⟨u, rfl⟩, ?_⟩
    change
      ((successorGraphCoordinates n).base u,
        WithLp.toLp 2
          ((successorGraphCoordinates n).raised u,
            (successorGraphCoordinates n).lowered u)) = p
    apply Prod.ext
    · simp only [successorGraphCoordinates_base]
      change l2Coordinate (n + 1) u = p.1
      calc
        l2Coordinate (n + 1) u =
            (x : OrbitPeterssonHilbert (n + 1)) := by
          simpa only [u] using
            (l2Coordinate_l2CoreRangeEquiv_symm (n + 1) x)
        _ = p.1 := hxBase
    · simp only [successorGraphCoordinates_raised,
        successorGraphCoordinates_lowered]
      change
        WithLp.toLp 2
            (raisedCoordinate (n + 1) u,
              reindexedActualLoweredCoordinate n u) = p.2
      calc
        WithLp.toLp 2
            (raisedCoordinate (n + 1) u,
              reindexedActualLoweredCoordinate n u) =
            physicalJointFromSucc n x := by
          have hxCore : l2CoreRangeEquiv (n + 1) u = x := by
            simpa only [u] using
              (l2CoreRangeEquiv (n + 1)).apply_symm_apply x
          rw [← hxCore, physicalJointFromSucc_on_core,
            reindexedActualLoweredCoordinate_eq_lowerFromSuccCoordinate]
        _ = p.2 := hxValue

/-- After completion, the preceding raw equality becomes exact equality with
the canonical physical closed-joint graph.  This is the requested usable
closed-tower endpoint: the abstract Definition-1 completion and the concrete
closed operator have literally the same completed graph after the canonical
outer `WithLp` unwrapping. -/
theorem successorGraphUnwrap_image_range_graphExtension_eq_closedJointGraph
    (n : ℤ) :
    successorGraphUnwrap n ''
        Set.range (successorGraphCoordinates n).graphExtension =
      ((closedJointFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) := by
  rw [(successorGraphCoordinates n).range_graphExtension_eq_closure_range_graph]
  rw [ContinuousLinearEquiv.image_closure]
  rw [successorGraphUnwrap_image_range_graph_eq_physicalJointGraph]
  change
    closure ((physicalJointFromSucc n).graph :
      Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) =
      (((physicalJointFromSucc n).closure).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n))
  rw [← Submodule.topologicalClosure_coe,
    (physicalJointFromSucc_isClosable n).graph_closure_eq_closure_graph]

/-- The literal fixed-phase coordinate package at `n+1` is jointly closable;
there is no graph-density, Green, Stokes, or boundary parameter. -/
private theorem jointlyClosable_of_transportSuccessorCoordinates
    (n m : ℤ) (h : m = n) (Q : successorCoordinateType n m)
    (hQ : (transportSuccessorCoordinates n m h Q).JointlyClosable) :
    Q.JointlyClosable := by
  cases h
  exact hQ

theorem coordinates_add_one_jointlyClosable (n : ℤ) :
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates
      (n + 1)).JointlyClosable := by
  exact jointlyClosable_of_transportSuccessorCoordinates
    n (n + 1 - 1) (successorIndexEq n)
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates (n + 1))
    (successorGraphCoordinates_jointlyClosable n)

/-- At every integer orbit index, the base Petersson coordinate on the actual
Definition-1 graph completion is injective.  Consequently that completion is
the graph of one single-valued closed `(R_n,L_n)` pair over its base range. -/
theorem coordinates_jointlyClosable (n : ℤ) :
    (DefinitionOneSobolev.FixedPhaseGraphCompletion.coordinates n).JointlyClosable := by
  have hIndex : n - 1 + 1 = n := sub_add_cancel n 1
  exact hIndex ▸ coordinates_add_one_jointlyClosable (n - 1)

end PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators

