/-! ## 1. Existing real compatibility layer -/

section RealCompatibility

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- General real Cauchy-Schwarz helper used by later variational estimates. -/
theorem cauchy_schwarz (u v : E) : ‖⟪u, v⟫_ℝ‖ ≤ ‖u‖ * ‖v‖ :=
  norm_inner_le_norm u v

/-- Backwards-compatible real operator-norm bound. -/
theorem dual_holder (f : E →L[ℝ] ℝ) (v : E) : ‖f v‖ ≤ ‖f‖ * ‖v‖ :=
  f.le_opNorm v

/-- Abstract real Lax-Milgram reduction.

The hypothesis `coercive : IsCoercive B` is essential.  This theorem does not
prove coercivity of the paper's concrete form and is not the paper's Lemma 1.1.
-/
theorem lax_milgram [CompleteSpace E]
    (B : E →L[ℝ] E →L[ℝ] ℝ) (coercive : IsCoercive B) :
    ∃ φ : E ≃L[ℝ] E, ∀ v w : E, ⟪φ v, w⟫_ℝ = B v w :=
  ⟨coercive.continuousLinearEquivOfBilin,
    coercive.continuousLinearEquivOfBilin_apply⟩

end RealCompatibility

/-! ## 2. Complex-linear dual convention -/

section ComplexDual

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/- The dual-norm results need only a complex normed space, so they apply in
particular to every complete complex Hilbert space from the checklist. -/

/-- The convention used in this file is the complex-linear evaluation pairing.

If an analytic integral is conjugate-linear in its test vector, it must first be
transported to a conjugate space or conjugated; it may not silently be identified
with this pairing.
-/
noncomputable def dualPairing (f : StrongDual ℂ E) (v : E) : ℂ :=
  f v

@[simp]
theorem dualPairing_apply (f : StrongDual ℂ E) (v : E) :
    dualPairing f v = f v :=
  rfl

@[simp]
theorem dualPairing_zero (f : StrongDual ℂ E) : dualPairing f 0 = 0 := by
  simp [dualPairing]

@[simp]
theorem dualPairing_add (f : StrongDual ℂ E) (u v : E) :
    dualPairing f (u + v) = dualPairing f u + dualPairing f v := by
  simp [dualPairing]

@[simp]
theorem dualPairing_smul (f : StrongDual ℂ E) (c : ℂ) (v : E) :
    dualPairing f (c • v) = c * dualPairing f v := by
  simp [dualPairing]

@[simp]
theorem dualPairing_zero_functional (v : E) :
    dualPairing (0 : StrongDual ℂ E) v = 0 := by
  simp [dualPairing]

@[simp]
theorem dualPairing_add_functional (f g : StrongDual ℂ E) (v : E) :
    dualPairing (f + g) v = dualPairing f v + dualPairing g v := by
  simp [dualPairing]

@[simp]
theorem dualPairing_smul_functional (c : ℂ) (f : StrongDual ℂ E) (v : E) :
    dualPairing (c • f) v = c * dualPairing f v := by
  simp [dualPairing]

/-- Complex-linear abstract analogue of Proposition 1, equation (1.4). -/
theorem dual_holder_complex (f : StrongDual ℂ E) (v : E) :
    ‖dualPairing f v‖ ≤ ‖f‖ * ‖v‖ :=
  f.le_opNorm v

/-- Pointwise quotient form of the operator-norm bound.

Mathlib defines division by zero, so the statement is true even at `v = 0`;
the supremum sets below nevertheless exclude `v = 0` to match the paper.
-/
theorem dual_ratio_le (f : StrongDual ℂ E) (v : E) :
    ‖dualPairing f v‖ / ‖v‖ ≤ ‖f‖ :=
  f.ratio_le_opNorm v

/-! ### Unit-sphere form -/

/-- Norms of evaluations on the unit sphere. -/
def dualUnitEvalSet (f : StrongDual ℂ E) : Set ℝ :=
  (fun v : E => ‖dualPairing f v‖) '' Metric.sphere 0 1

/-- Complex-linear abstract analogue of Proposition 1, equation (1.3), in
unit-sphere form.

This theorem also handles a subsingleton domain: then the unit sphere is empty,
Mathlib has `sSup (∅ : Set ℝ) = 0`, and every functional has norm zero.
-/
theorem dual_norm_eq_sSup_unit (f : StrongDual ℂ E) :
    ‖f‖ = sSup (dualUnitEvalSet f) := by
  simpa [dualUnitEvalSet, dualPairing] using
    (ContinuousLinearMap.sSup_sphere_eq_norm f).symm

theorem dualUnitEvalSet_eq_empty_of_subsingleton [Subsingleton E]
    (f : StrongDual ℂ E) : dualUnitEvalSet f = ∅ := by
  simp [dualUnitEvalSet, Metric.sphere_eq_empty_of_subsingleton one_ne_zero]

@[simp]
theorem dual_norm_eq_zero_of_subsingleton [Subsingleton E]
    (f : StrongDual ℂ E) : ‖f‖ = 0 := by
  rw [dual_norm_eq_sSup_unit, dualUnitEvalSet_eq_empty_of_subsingleton]
  exact Real.sSup_empty

@[simp]
theorem sSup_dualUnitEvalSet_zero :
    sSup (dualUnitEvalSet (0 : StrongDual ℂ E)) = 0 := by
  simpa using (dual_norm_eq_sSup_unit (0 : StrongDual ℂ E)).symm

/-! ### Nonzero-vector ratio form -/

/-- Quotient values on the nonzero vectors of a core `D`. -/
def dualRatioSetOn (D : Set E) (f : StrongDual ℂ E) : Set ℝ :=
  {r | ∃ v : E, v ∈ D ∧ v ≠ 0 ∧ r = ‖dualPairing f v‖ / ‖v‖}

@[simp]
theorem mem_dualRatioSetOn {D : Set E} {f : StrongDual ℂ E} {r : ℝ} :
    r ∈ dualRatioSetOn D f ↔
      ∃ v : E, v ∈ D ∧ v ≠ 0 ∧ r = ‖dualPairing f v‖ / ‖v‖ :=
  Iff.rfl

/-- The quotient-value set is bounded above by the operator norm. -/
theorem dualRatioSetOn_bddAbove (D : Set E) (f : StrongDual ℂ E) :
    BddAbove (dualRatioSetOn D f) := by
  refine ⟨‖f‖, ?_⟩
  rintro r ⟨v, hvD, hv0, rfl⟩
  exact f.ratio_le_opNorm v

/-- Every quotient value is nonnegative. -/
theorem dualRatioSetOn_nonneg {D : Set E} {f : StrongDual ℂ E} {r : ℝ}
    (hr : r ∈ dualRatioSetOn D f) : 0 ≤ r := by
  rcases hr with ⟨v, hvD, hv0, rfl⟩
  exact div_nonneg (norm_nonneg _) (norm_nonneg _)

/-- The norm detected on a core by nonzero-vector quotients.

For a core containing no nonzero vector this is `0`, because
`Real.sSup_empty = 0`.
-/
noncomputable def coreRatioNorm (D : Set E) (f : StrongDual ℂ E) : ℝ :=
  sSup (dualRatioSetOn D f)

theorem coreRatioNorm_nonneg (D : Set E) (f : StrongDual ℂ E) :
    0 ≤ coreRatioNorm D f := by
  apply Real.sSup_nonneg
  intro r hr
  exact dualRatioSetOn_nonneg hr

theorem coreRatioNorm_le_norm (D : Set E) (f : StrongDual ℂ E) :
    coreRatioNorm D f ≤ ‖f‖ := by
  apply Real.sSup_le
  · intro r hr
    rcases hr with ⟨v, hvD, hv0, rfl⟩
    exact f.ratio_le_opNorm v
  · exact f.opNorm_nonneg

@[simp]
theorem coreRatioNorm_empty (f : StrongDual ℂ E) :
    coreRatioNorm (∅ : Set E) f = 0 := by
  simp [coreRatioNorm, dualRatioSetOn]

@[simp]
theorem coreRatioNorm_singleton_zero (f : StrongDual ℂ E) :
    coreRatioNorm ({0} : Set E) f = 0 := by
  simp [coreRatioNorm, dualRatioSetOn]

@[simp]
theorem coreRatioNorm_zero (D : Set E) :
    coreRatioNorm D (0 : StrongDual ℂ E) = 0 := by
  apply le_antisymm
  · simpa using coreRatioNorm_le_norm D (0 : StrongDual ℂ E)
  · exact coreRatioNorm_nonneg D (0 : StrongDual ℂ E)

/-- Enlarging a core cannot decrease its detected norm. -/
theorem coreRatioNorm_mono {D₁ D₂ : Set E} (hD : D₁ ⊆ D₂)
    (f : StrongDual ℂ E) : coreRatioNorm D₁ f ≤ coreRatioNorm D₂ f := by
  apply Real.sSup_le
  · intro r hr
    apply le_csSup (dualRatioSetOn_bddAbove D₂ f)
    rcases hr with ⟨v, hvD, hv0, rfl⟩
    exact ⟨v, hD hvD, hv0, rfl⟩
  · exact coreRatioNorm_nonneg D₂ f

/-! ### Dense-core norm recovery -/

/-- A pointwise operator bound verified on a dense set extends to the whole
domain.  This is the closed-property step used by all dense-core results below.
-/
theorem opNorm_le_of_dense (f : StrongDual ℂ E) {D : Set E} (hD : Dense D)
    {C : ℝ} (hC : 0 ≤ C) (h : ∀ v ∈ D, ‖f v‖ ≤ C * ‖v‖) : ‖f‖ ≤ C := by
  apply f.opNorm_le_bound hC
  intro v
  exact hD.induction h
    (isClosed_le f.continuous.norm (continuous_const.mul continuous_norm)) v

/-- A dense core detects at least the full operator norm. -/
theorem norm_le_coreRatioNorm_of_dense (f : StrongDual ℂ E) {D : Set E}
    (hD : Dense D) : ‖f‖ ≤ coreRatioNorm D f := by
  apply opNorm_le_of_dense f hD (coreRatioNorm_nonneg D f)
  intro v hvD
  by_cases hv0 : v = 0
  · simp [hv0]
  · have hratio : ‖f v‖ / ‖v‖ ≤ coreRatioNorm D f := by
      apply le_csSup (dualRatioSetOn_bddAbove D f)
      exact ⟨v, hvD, hv0, rfl⟩
    exact (div_le_iff₀ (norm_pos_iff.mpr hv0)).mp hratio

/-- Restricting the quotient supremum to a dense core preserves the dual norm. -/
theorem dual_norm_eq_coreRatioNorm_of_dense (f : StrongDual ℂ E)
    {D : Set E} (hD : Dense D) : ‖f‖ = coreRatioNorm D f :=
  le_antisymm (norm_le_coreRatioNorm_of_dense f hD)
    (coreRatioNorm_le_norm D f)

/-- Complex-linear abstract analogue of Proposition 1, equation (1.3), in
nonzero-vector quotient form. -/
theorem dual_norm_eq_sSup_ratio (f : StrongDual ℂ E) :
    ‖f‖ = sSup {r | ∃ v : E, v ≠ 0 ∧
      r = ‖dualPairing f v‖ / ‖v‖} := by
  simpa [coreRatioNorm, dualRatioSetOn] using
    (dual_norm_eq_coreRatioNorm_of_dense f (D := Set.univ) dense_univ)

/-! ## 3. Increasing dense exhaustions -/

/-- An increasing family of cores whose union is dense.

The monotonicity field records the intended truncated-domain invariant.  The
numerical supremum theorem itself only needs `dense_iUnion`; monotonicity yields
the separate monotonicity theorem below.
-/
structure DualCoreExhaustion (ι E : Type*) [Preorder ι] [TopologicalSpace E] where
  core : ι → Set E
  monotone_core : Monotone core
  dense_iUnion : Dense (⋃ i, core i)

/-- The family of core norms is uniformly bounded above by the full dual norm. -/
theorem coreRatioNorm_family_bddAbove {ι : Type*} (D : ι → Set E)
    (f : StrongDual ℂ E) :
    BddAbove (Set.range fun i => coreRatioNorm (D i) f) := by
  refine ⟨‖f‖, ?_⟩
  rintro r ⟨i, rfl⟩
  exact coreRatioNorm_le_norm (D i) f

theorem iSup_coreRatioNorm_le_norm {ι : Type*} (D : ι → Set E)
    (f : StrongDual ℂ E) :
    (⨆ i, coreRatioNorm (D i) f) ≤ ‖f‖ := by
  apply Real.iSup_le
  · intro i
    exact coreRatioNorm_le_norm (D i) f
  · exact f.opNorm_nonneg

/-- A dense union of cores detects the full dual norm. -/
theorem norm_le_iSup_coreRatioNorm_of_dense_iUnion {ι : Type*}
    (D : ι → Set E) (hDense : Dense (⋃ i, D i)) (f : StrongDual ℂ E) :
    ‖f‖ ≤ ⨆ i, coreRatioNorm (D i) f := by
  apply opNorm_le_of_dense f hDense
  · exact Real.iSup_nonneg fun i => coreRatioNorm_nonneg (D i) f
  · intro v hvUnion
    rcases Set.mem_iUnion.mp hvUnion with ⟨i, hvi⟩
    by_cases hv0 : v = 0
    · simp [hv0]
    · have hratio : ‖f v‖ / ‖v‖ ≤ coreRatioNorm (D i) f := by
        apply le_csSup (dualRatioSetOn_bddAbove (D i) f)
        exact ⟨v, hvi, hv0, rfl⟩
      have hcore : coreRatioNorm (D i) f ≤
          ⨆ j, coreRatioNorm (D j) f :=
        le_ciSup (coreRatioNorm_family_bddAbove D f) i
      exact (div_le_iff₀ (norm_pos_iff.mpr hv0)).mp (hratio.trans hcore)

/-- Abstract norm-exhaustion component of the corrected replacement for the
fixed-`F_Y` supremum in paper (1.5).

No fixed finite core is used: the outer supremum ranges over the entire family.
-/
theorem dual_norm_eq_iSup_coreRatio {ι : Type*} (D : ι → Set E)
    (hDense : Dense (⋃ i, D i)) (f : StrongDual ℂ E) :
    ‖f‖ = ⨆ i, coreRatioNorm (D i) f :=
  le_antisymm
    (norm_le_iSup_coreRatioNorm_of_dense_iUnion D hDense f)
    (iSup_coreRatioNorm_le_norm D f)

namespace DualCoreExhaustion

variable {ι : Type*} [Preorder ι]

theorem monotone_coreRatioNorm (X : DualCoreExhaustion ι E)
    (f : StrongDual ℂ E) :
    Monotone (fun i => coreRatioNorm (X.core i) f) := by
  intro i j hij
  exact coreRatioNorm_mono (X.monotone_core hij) f

theorem norm_eq_iSup_coreRatio (X : DualCoreExhaustion ι E)
    (f : StrongDual ℂ E) :
    ‖f‖ = ⨆ i, coreRatioNorm (X.core i) f :=
  dual_norm_eq_iSup_coreRatio X.core X.dense_iUnion f

end DualCoreExhaustion

end ComplexDual

/-! ## 4. Unconditional paper-statement correction and obstruction layer

The declarations in this section do two different jobs, and their names keep
the distinction explicit.

* `UnitaryAutomorphyFactor`, the anti-dual layer, weak equations, dense-core
  extension, and the corrected lower/upper crossover lemma are reusable
  positive interfaces.
* Declarations whose names contain `counterexample`, `not_`, `forces`, or
  `obstruction` are kernel-checked proofs that the corresponding source-paper
  inference cannot be used as stated.

None of the structures below packages an unproved theorem as an axiom. A
field of a structure is input data, so a concrete application is certified
only after an inhabitant is constructed for the paper's actual objects.
-/

namespace PaperCorrections

/-! ### P0.1: unitary automorphy and an explicit square-root lift -/

section UnitaryAutomorphy

variable (Γ X : Type*) [Group Γ] [MulAction Γ X]

/-- A unitary automorphy factor for a left group action.

The cocycle law is part of the data; a bare function `Γ → X → ℂ` is not a
multiplier system. The unit-norm field is the convention that makes the raw
pointwise norm invariant.
-/
structure UnitaryAutomorphyFactor where
  factor : Γ → X → ℂ
  factor_one : ∀ x, factor 1 x = 1
  factor_mul : ∀ γ δ x,
    factor (γ * δ) x = factor γ (δ • x) * factor δ x
  norm_factor : ∀ γ x, ‖factor γ x‖ = 1

/-- A coherent half-weight lift records its square explicitly.

This deliberately does not use the principal complex square root: a
pointwise choice of square root need not satisfy the cocycle law.
-/
structure UnitaryHalfWeightFactor (base : UnitaryAutomorphyFactor Γ X)
    extends UnitaryAutomorphyFactor Γ X where
  square_root_law : ∀ γ x, factor γ x ^ 2 = base.factor γ x

namespace UnitaryAutomorphyFactor

variable {Γ X : Type*} [Group Γ] [MulAction Γ X]

/-- Automorphy for the convention represented by `J`. -/
def IsAutomorphic (J : UnitaryAutomorphyFactor Γ X) (u : X → ℂ) : Prop :=
  ∀ γ x, u (γ • x) = J.factor γ x * u x

/-- A unitary automorphic section has invariant pointwise norm. -/
theorem norm_apply_smul_eq (J : UnitaryAutomorphyFactor Γ X) {u : X → ℂ}
    (hu : J.IsAutomorphic u) (γ : Γ) (x : X) :
    ‖u (γ • x)‖ = ‖u x‖ := by
  rw [hu γ x, norm_mul, J.norm_factor, one_mul]

/-- Consequently the raw norm-square density is invariant. -/
theorem norm_sq_apply_smul_eq (J : UnitaryAutomorphyFactor Γ X) {u : X → ℂ}
    (hu : J.IsAutomorphic u) (γ : Γ) (x : X) :
    ‖u (γ • x)‖ ^ 2 = ‖u x‖ ^ 2 := by
  rw [J.norm_apply_smul_eq hu γ x]

/-- Every value of a unitary automorphy factor is nonzero. -/
theorem factor_ne_zero (J : UnitaryAutomorphyFactor Γ X) (γ : Γ) (x : X) :
    J.factor γ x ≠ 0 := by
  intro h
  have hnorm := J.norm_factor γ x
  simp [h] at hnorm

/-- A finite truncation preserves automorphy if every retained summand already
preserves the same automorphy law. This hypothesis is substantive for Fourier
truncations of automorphic objects.
-/
theorem finset_sum_isAutomorphic (J : UnitaryAutomorphyFactor Γ X)
    {ι : Type*} (s : Finset ι) (f : ι → X → ℂ)
    (hf : ∀ i ∈ s, J.IsAutomorphic (f i)) :
    J.IsAutomorphic (fun x => ∑ i ∈ s, f i x) := by
  intro γ x
  calc
    ∑ i ∈ s, f i (γ • x) =
        ∑ i ∈ s, J.factor γ x * f i x := by
          apply Finset.sum_congr rfl
          intro i hi
          exact hf i hi γ x
    _ = J.factor γ x * ∑ i ∈ s, f i x := by
          rw [Finset.mul_sum]

end UnitaryAutomorphyFactor

end UnitaryAutomorphy

/-! ### P0.2: conjugate-linear data and weak equations -/

section AntiDualAndWeakEquation

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The strong conjugate-linear dual. The paper's pairing
`v ↦ ∫ g * conj v` belongs here, not in `StrongDual ℂ E`.
-/
abbrev StrongAntiDual (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] :=
  E →L⋆[ℂ] ℂ

/-- Evaluation of a conjugate-linear functional. -/
noncomputable def antiDualPairing (f : StrongAntiDual E) (v : E) : ℂ :=
  f v

@[simp]
theorem antiDualPairing_apply (f : StrongAntiDual E) (v : E) :
    antiDualPairing f v = f v :=
  rfl

@[simp]
theorem antiDualPairing_add (f : StrongAntiDual E) (u v : E) :
    antiDualPairing f (u + v) = antiDualPairing f u + antiDualPairing f v := by
  simp [antiDualPairing]

/-- Scalar multiplication in the test vector is conjugated. -/
theorem antiDualPairing_smul (f : StrongAntiDual E) (c : ℂ) (v : E) :
    antiDualPairing f (c • v) =
      (starRingEnd ℂ) c • antiDualPairing f v := by
  simpa [antiDualPairing] using f.map_smulₛₗ c v

@[simp]
theorem antiDualPairing_zero_functional (v : E) :
    antiDualPairing (0 : StrongAntiDual E) v = 0 := by
  simp [antiDualPairing]

@[simp]
theorem antiDualPairing_add_functional (f g : StrongAntiDual E) (v : E) :
    antiDualPairing (f + g) v =
      antiDualPairing f v + antiDualPairing g v := by
  simp [antiDualPairing]

@[simp]
theorem antiDualPairing_smul_functional
    (c : ℂ) (f : StrongAntiDual E) (v : E) :
    antiDualPairing (c • f) v = c * antiDualPairing f v := by
  simp [antiDualPairing]

/-- Operator-norm bound for the conjugate-linear dual. -/
theorem antiDual_holder (f : StrongAntiDual E) (v : E) :
    ‖antiDualPairing f v‖ ≤ ‖f‖ * ‖v‖ :=
  f.le_opNorm v

/- The inner product supplies the canonical anti-dual pairing in the test
variable, with exactly the orientation used by `∫ g * conj v`.
-/
end AntiDualAndWeakEquation

section InnerSLFlipPairing

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

theorem innerSLFlip_pairing (u v : E) :
    antiDualPairing (innerSLFlip ℂ u) v = ⟪v, u⟫_ℂ := by
  simpa only [antiDualPairing] using
    (innerSLFlip_apply_apply ℂ u v)

end InnerSLFlipPairing

section AntiDualAndWeakEquation

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- A weak sesquilinear operator maps a trial vector to the anti-dual. -/
abbrev WeakAntiOperator (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] :=
  E →L[ℂ] StrongAntiDual E

/-- A weak equation is equality in the anti-dual, not a pointwise Laplacian
identity.
-/
def WeakAntiEquation (A : WeakAntiOperator E) (u : E)
    (f : StrongAntiDual E) : Prop :=
  A u = f

theorem weakAntiEquation_iff_forall (A : WeakAntiOperator E) (u : E)
    (f : StrongAntiDual E) :
    WeakAntiEquation A u f ↔ ∀ v : E, A u v = f v := by
  constructor
  · rintro rfl v
    rfl
  · intro h
    ext v
    exact h v

/-- Checklist 5.2's complex-linear weak operator.  This convention is suitable
only for pairings linear in the test vector. -/
abbrev WeakOperator (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] :=
  E →L[ℂ] StrongDual ℂ E

/-- Backwards-compatible explicit name for the linear convention. -/
abbrev WeakLinearOperator (E : Type*)
    [NormedAddCommGroup E] [NormedSpace ℂ E] :=
  WeakOperator E

def WeakLinearEquation (A : WeakLinearOperator E) (u : E)
    (f : StrongDual ℂ E) : Prop :=
  A u = f

theorem weakLinearEquation_iff_forall (A : WeakLinearOperator E) (u : E)
    (f : StrongDual ℂ E) :
    WeakLinearEquation A u f ↔ ∀ v : E, A u v = f v := by
  constructor
  · rintro rfl v
    rfl
  · intro h
    ext v
    exact h v

/-! #### Checklist 5.2: weak equations with a potential term -/

/-- Linear-dual formulation of `A u + potentialOp u = f`. -/
def SolvesWeakWithPotential (A potentialOp : WeakOperator E) (u : E)
    (f : StrongDual ℂ E) : Prop :=
  A u + potentialOp u = f

theorem solvesWeakWithPotential_iff_forall
    (A potentialOp : WeakOperator E) (u : E) (f : StrongDual ℂ E) :
    SolvesWeakWithPotential A potentialOp u f ↔
      ∀ v : E, A u v + potentialOp u v = f v := by
  constructor
  · intro h v
    change A u + potentialOp u = f at h
    have hv := congrArg (fun g : StrongDual ℂ E => g v) h
    simpa using hv
  · intro h
    change A u + potentialOp u = f
    ext v
    simpa using h v

theorem solvesWeakWithPotential_apply
    (A potentialOp : WeakOperator E) (u : E) (f : StrongDual ℂ E)
    (h : SolvesWeakWithPotential A potentialOp u f) (v : E) :
    A u v + potentialOp u v = f v :=
  (solvesWeakWithPotential_iff_forall A potentialOp u f).1 h v

/-- Paper-convention counterpart: the right-hand side is conjugate-linear in
the test vector, as is `v ↦ ∫ g * conj(v)`. -/
def SolvesWeakAntiWithPotential (A potentialOp : WeakAntiOperator E) (u : E)
    (f : StrongAntiDual E) : Prop :=
  A u + potentialOp u = f

theorem solvesWeakAntiWithPotential_iff_forall
    (A potentialOp : WeakAntiOperator E) (u : E) (f : StrongAntiDual E) :
    SolvesWeakAntiWithPotential A potentialOp u f ↔
      ∀ v : E, A u v + potentialOp u v = f v := by
  constructor
  · intro h v
    change A u + potentialOp u = f at h
    have hv := congrArg (fun g : StrongAntiDual E => g v) h
    simpa using hv
  · intro h
    change A u + potentialOp u = f
    ext v
    simpa using h v

theorem solvesWeakAntiWithPotential_apply
    (A potentialOp : WeakAntiOperator E) (u : E) (f : StrongAntiDual E)
    (h : SolvesWeakAntiWithPotential A potentialOp u f) (v : E) :
    A u v + potentialOp u v = f v :=
  (solvesWeakAntiWithPotential_iff_forall A potentialOp u f).1 h v

/-- A scalar-valued pairing cannot be simultaneously complex-linear and
conjugate-linear in the same variable unless it vanishes identically. -/
theorem linear_and_conjugate_scalar_laws_force_zero
    (Φ : E → ℂ)
    (hLinear : ∀ c v, Φ (c • v) = c * Φ v)
    (hConjugate : ∀ c v,
      Φ (c • v) = (starRingEnd ℂ) c * Φ v) :
    ∀ v, Φ v = 0 := by
  intro v
  have hI : Complex.I * Φ v = (-Complex.I) * Φ v := by
    calc
      Complex.I * Φ v = Φ (Complex.I • v) :=
        (hLinear Complex.I v).symm
      _ = (starRingEnd ℂ) Complex.I * Φ v :=
        hConjugate Complex.I v
      _ = (-Complex.I) * Φ v := by simp
  have htwoI : ((2 : ℂ) * Complex.I) * Φ v = 0 := by
    calc
      ((2 : ℂ) * Complex.I) * Φ v =
          Complex.I * Φ v - (-Complex.I) * Φ v := by ring
      _ = 0 := sub_eq_zero.mpr hI
  exact (mul_eq_zero.mp htwoI).resolve_left
    (mul_ne_zero (by norm_num) Complex.I_ne_zero)

/-- An equivalence gives existence and uniqueness without hiding either
property in an informal phrase such as "representing iso".
-/
noncomputable def weakLinearSolution
    (A : E ≃L[ℂ] StrongDual ℂ E) (f : StrongDual ℂ E) : E :=
  A.symm f

theorem weakLinearSolution_spec (A : E ≃L[ℂ] StrongDual ℂ E)
    (f : StrongDual ℂ E) :
    A (weakLinearSolution A f) = f := by
  simp [weakLinearSolution]

theorem weakLinearSolution_unique (A : E ≃L[ℂ] StrongDual ℂ E)
    (f : StrongDual ℂ E) {u : E} (hu : A u = f) :
    u = weakLinearSolution A f := by
  apply A.injective
  rw [hu, weakLinearSolution_spec]

theorem weakLinearSolution_existsUnique (A : E ≃L[ℂ] StrongDual ℂ E)
    (f : StrongDual ℂ E) :
    ∃! u : E, A u = f := by
  refine ⟨weakLinearSolution A f, weakLinearSolution_spec A f, ?_⟩
  intro u hu
  exact weakLinearSolution_unique A f hu

theorem weakLinearSolution_norm_le (A : E ≃L[ℂ] StrongDual ℂ E)
    (f : StrongDual ℂ E) :
    ‖weakLinearSolution A f‖ ≤ ‖A.symm.toContinuousLinearMap‖ * ‖f‖ :=
  A.symm.toContinuousLinearMap.le_opNorm f

/-- Real parts of a complex equality, tested once directly and once after
multiplication by `i`, recover the full complex equality. This is the small
algebraic step required by a realification argument; it is not itself a complex
Lax--Milgram theorem.
-/
theorem complex_eq_of_re_eq_of_re_I_mul_eq {z w : ℂ}
    (hre : z.re = w.re) (hI : (Complex.I * z).re = (Complex.I * w).re) :
    z = w := by
  apply Complex.ext
  · exact hre
  · simpa only [Complex.mul_re, Complex.I_re, zero_mul, Complex.I_im,
      one_mul, zero_sub, neg_inj] using hI

end AntiDualAndWeakEquation

/-! ### P1 checklist 5.2: abstract weak form and Bochner core bridge

The linear and conjugate-linear conventions are developed in parallel.  The
predicates `CoreBochnerRegular` and `CoreBochnerPairing` are explicit proof
obligations: they do not manufacture the paper's missing regularity or Green
formula.  Once those obligations are discharged for concrete objects, the
lemmas below pass from dual-space equalities to global and restricted Bochner
integrals without another hidden assumption.
-/

section CoreBochnerWeakForm

open Function Set

variable {X V ι : Type*} [MeasurableSpace X] [TopologicalSpace X]
variable [NormedAddCommGroup V] [NormedSpace ℂ V]

/-! #### Linear and conjugate-linear test kernels -/

/-- An integral kernel linear in the test vector. -/
def linearTestIntegrand (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (v : V) (x : X) : ℂ :=
  ρ x * T v x

/-- The paper's raw convention, conjugate-linear in the test vector. -/
def antiTestIntegrand (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (v : V) (x : X) : ℂ :=
  ρ x * (starRingEnd ℂ) (T v x)

@[simp]
theorem linearTestIntegrand_add (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (v w : V) :
    linearTestIntegrand ρ T (v + w) =
      linearTestIntegrand ρ T v + linearTestIntegrand ρ T w := by
  funext x
  simp [linearTestIntegrand, mul_add]

@[simp]
theorem linearTestIntegrand_smul (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (c : ℂ) (v : V) :
    linearTestIntegrand ρ T (c • v) =
      c • linearTestIntegrand ρ T v := by
  funext x
  simp only [linearTestIntegrand, map_smul, Pi.smul_apply, smul_eq_mul]
  ring

@[simp]
theorem linearTestIntegrand_density_add
    (ρ σ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ)) (v : V) :
    linearTestIntegrand (ρ + σ) T v =
      linearTestIntegrand ρ T v + linearTestIntegrand σ T v := by
  funext x
  simp [linearTestIntegrand, add_mul]

@[simp]
theorem antiTestIntegrand_add (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (v w : V) :
    antiTestIntegrand ρ T (v + w) =
      antiTestIntegrand ρ T v + antiTestIntegrand ρ T w := by
  funext x
  simp [antiTestIntegrand, mul_add]

@[simp]
theorem antiTestIntegrand_smul (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ))
    (c : ℂ) (v : V) :
    antiTestIntegrand ρ T (c • v) =
      (starRingEnd ℂ) c • antiTestIntegrand ρ T v := by
  funext x
  simp only [antiTestIntegrand, map_smul, Pi.smul_apply, smul_eq_mul,
    map_mul]
  ring

@[simp]
theorem antiTestIntegrand_density_add
    (ρ σ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ)) (v : V) :
    antiTestIntegrand (ρ + σ) T v =
      antiTestIntegrand ρ T v + antiTestIntegrand σ T v := by
  funext x
  simp [antiTestIntegrand, add_mul]

/-- Global Bochner pairing for the linear test convention. -/
noncomputable def linearBochnerPairing (μ : MeasureTheory.Measure X) (ρ : X → ℂ)
    (T : V →ₗ[ℂ] (X → ℂ)) (v : V) : ℂ :=
  ∫ x, linearTestIntegrand ρ T v x ∂μ

/-- Global Bochner pairing for the conjugate-linear test convention. -/
noncomputable def antiBochnerPairing (μ : MeasureTheory.Measure X) (ρ : X → ℂ)
    (T : V →ₗ[ℂ] (X → ℂ)) (v : V) : ℂ :=
  ∫ x, antiTestIntegrand ρ T v x ∂μ

theorem linearBochnerPairing_add
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v w : V}
    (hv : MeasureTheory.Integrable (linearTestIntegrand ρ T v) μ)
    (hw : MeasureTheory.Integrable (linearTestIntegrand ρ T w) μ) :
    linearBochnerPairing μ ρ T (v + w) =
      linearBochnerPairing μ ρ T v + linearBochnerPairing μ ρ T w := by
  unfold linearBochnerPairing
  rw [linearTestIntegrand_add]
  exact MeasureTheory.integral_add hv hw

theorem linearBochnerPairing_smul
    (μ : MeasureTheory.Measure X) (ρ : X → ℂ)
    (T : V →ₗ[ℂ] (X → ℂ)) (c : ℂ) (v : V) :
    linearBochnerPairing μ ρ T (c • v) =
      c * linearBochnerPairing μ ρ T v := by
  unfold linearBochnerPairing
  rw [linearTestIntegrand_smul]
  change (∫ x, c * linearTestIntegrand ρ T v x ∂μ) =
    c * ∫ x, linearTestIntegrand ρ T v x ∂μ
  exact MeasureTheory.integral_smul c (linearTestIntegrand ρ T v)

theorem antiBochnerPairing_add
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v w : V}
    (hv : MeasureTheory.Integrable (antiTestIntegrand ρ T v) μ)
    (hw : MeasureTheory.Integrable (antiTestIntegrand ρ T w) μ) :
    antiBochnerPairing μ ρ T (v + w) =
      antiBochnerPairing μ ρ T v + antiBochnerPairing μ ρ T w := by
  unfold antiBochnerPairing
  rw [antiTestIntegrand_add]
  exact MeasureTheory.integral_add hv hw

theorem antiBochnerPairing_smul
    (μ : MeasureTheory.Measure X) (ρ : X → ℂ)
    (T : V →ₗ[ℂ] (X → ℂ)) (c : ℂ) (v : V) :
    antiBochnerPairing μ ρ T (c • v) =
      (starRingEnd ℂ) c * antiBochnerPairing μ ρ T v := by
  unfold antiBochnerPairing
  rw [antiTestIntegrand_smul]
  change (∫ x, (starRingEnd ℂ) c * antiTestIntegrand ρ T v x ∂μ) =
    (starRingEnd ℂ) c * ∫ x, antiTestIntegrand ρ T v x ∂μ
  exact MeasureTheory.integral_smul ((starRingEnd ℂ) c)
    (antiTestIntegrand ρ T v)

/-! #### Regularity and integral representation are separate obligations -/

/-- Integrability of the linear test integrand on a regular core. -/
def CoreBochnerRegular (μ : MeasureTheory.Measure X) (D : Set V)
    (T : V →ₗ[ℂ] (X → ℂ)) (ρ : X → ℂ) : Prop :=
  ∀ v ∈ D, MeasureTheory.Integrable (linearTestIntegrand ρ T v) μ

/-- Equality between a linear functional and its Bochner formula on a core. -/
def CoreBochnerPairing (μ : MeasureTheory.Measure X) (D : Set V)
    (T : V →ₗ[ℂ] (X → ℂ)) (F : StrongDual ℂ V) (ρ : X → ℂ) : Prop :=
  ∀ v ∈ D, dualPairing F v = linearBochnerPairing μ ρ T v

/-- Integrability of the conjugate-linear test integrand on a regular core. -/
def CoreAntiBochnerRegular (μ : MeasureTheory.Measure X) (D : Set V)
    (T : V →ₗ[ℂ] (X → ℂ)) (ρ : X → ℂ) : Prop :=
  ∀ v ∈ D, MeasureTheory.Integrable (antiTestIntegrand ρ T v) μ

/-- Equality between an anti-dual functional and the paper-style Bochner
formula on a core. -/
def CoreAntiBochnerPairing (μ : MeasureTheory.Measure X) (D : Set V)
    (T : V →ₗ[ℂ] (X → ℂ)) (F : StrongAntiDual V) (ρ : X → ℂ) : Prop :=
  ∀ v ∈ D, antiDualPairing F v = antiBochnerPairing μ ρ T v

theorem coreBochnerRegular_add
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρ σ : X → ℂ}
    (hρ : CoreBochnerRegular μ D T ρ)
    (hσ : CoreBochnerRegular μ D T σ) :
    CoreBochnerRegular μ D T (ρ + σ) := by
  intro v hv
  rw [linearTestIntegrand_density_add]
  exact (hρ v hv).add (hσ v hv)

theorem coreBochnerPairing_add
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F G : StrongDual ℂ V} {ρ σ : X → ℂ}
    (hregρ : CoreBochnerRegular μ D T ρ)
    (hregσ : CoreBochnerRegular μ D T σ)
    (hpairρ : CoreBochnerPairing μ D T F ρ)
    (hpairσ : CoreBochnerPairing μ D T G σ) :
    CoreBochnerPairing μ D T (F + G) (ρ + σ) := by
  intro v hv
  calc
    dualPairing (F + G) v = dualPairing F v + dualPairing G v := by simp
    _ = linearBochnerPairing μ ρ T v + linearBochnerPairing μ σ T v := by
      rw [hpairρ v hv, hpairσ v hv]
    _ = linearBochnerPairing μ (ρ + σ) T v := by
      unfold linearBochnerPairing
      rw [linearTestIntegrand_density_add]
      exact (MeasureTheory.integral_add (hregρ v hv) (hregσ v hv)).symm

theorem coreAntiBochnerRegular_add
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρ σ : X → ℂ}
    (hρ : CoreAntiBochnerRegular μ D T ρ)
    (hσ : CoreAntiBochnerRegular μ D T σ) :
    CoreAntiBochnerRegular μ D T (ρ + σ) := by
  intro v hv
  rw [antiTestIntegrand_density_add]
  exact (hρ v hv).add (hσ v hv)

theorem coreAntiBochnerPairing_add
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F G : StrongAntiDual V} {ρ σ : X → ℂ}
    (hregρ : CoreAntiBochnerRegular μ D T ρ)
    (hregσ : CoreAntiBochnerRegular μ D T σ)
    (hpairρ : CoreAntiBochnerPairing μ D T F ρ)
    (hpairσ : CoreAntiBochnerPairing μ D T G σ) :
    CoreAntiBochnerPairing μ D T (F + G) (ρ + σ) := by
  intro v hv
  calc
    antiDualPairing (F + G) v =
        antiDualPairing F v + antiDualPairing G v := by simp
    _ = antiBochnerPairing μ ρ T v + antiBochnerPairing μ σ T v := by
      rw [hpairρ v hv, hpairσ v hv]
    _ = antiBochnerPairing μ (ρ + σ) T v := by
      unfold antiBochnerPairing
      rw [antiTestIntegrand_density_add]
      exact (MeasureTheory.integral_add (hregρ v hv) (hregσ v hv)).symm

theorem solvesWeakWithPotential_coreBochnerPairing
    {A potentialOp : WeakOperator V} {u : V} {f : StrongDual ℂ V}
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρA ρP : X → ℂ}
    (hEq : SolvesWeakWithPotential A potentialOp u f)
    (hregA : CoreBochnerRegular μ D T ρA)
    (hregP : CoreBochnerRegular μ D T ρP)
    (hpairA : CoreBochnerPairing μ D T (A u) ρA)
    (hpairP : CoreBochnerPairing μ D T (potentialOp u) ρP) :
    CoreBochnerPairing μ D T f (ρA + ρP) := by
  change A u + potentialOp u = f at hEq
  rw [← hEq]
  exact coreBochnerPairing_add hregA hregP hpairA hpairP

theorem solvesWeakAntiWithPotential_coreBochnerPairing
    {A potentialOp : WeakAntiOperator V} {u : V} {f : StrongAntiDual V}
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρA ρP : X → ℂ}
    (hEq : SolvesWeakAntiWithPotential A potentialOp u f)
    (hregA : CoreAntiBochnerRegular μ D T ρA)
    (hregP : CoreAntiBochnerRegular μ D T ρP)
    (hpairA : CoreAntiBochnerPairing μ D T (A u) ρA)
    (hpairP : CoreAntiBochnerPairing μ D T (potentialOp u) ρP) :
    CoreAntiBochnerPairing μ D T f (ρA + ρP) := by
  change A u + potentialOp u = f at hEq
  rw [← hEq]
  exact coreAntiBochnerPairing_add hregA hregP hpairA hpairP

/-! #### Exact support restriction for Bochner integrals -/

/-- A function supported in `s` has the same global and restricted Bochner
integrals.  No measurability of `s` is needed because the function is exactly
zero on the complement. -/
theorem integral_eq_setIntegral_of_support_subset
    {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    {μ : MeasureTheory.Measure X} {g : X → G} {s : Set X}
    (hgs : Function.support g ⊆ s) :
    (∫ x, g x ∂μ) = ∫ x in s, g x ∂μ :=
  (MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero
    (Function.support_subset_iff'.mp hgs)).symm

theorem support_linearTestIntegrand_subset_test
    (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ)) (v : V) :
    Function.support (linearTestIntegrand ρ T v) ⊆ Function.support (T v) := by
  intro x hx
  by_contra hxv
  apply hx
  have hv0 : T v x = 0 := Function.notMem_support.mp hxv
  simp [linearTestIntegrand, hv0]

theorem support_antiTestIntegrand_subset_test
    (ρ : X → ℂ) (T : V →ₗ[ℂ] (X → ℂ)) (v : V) :
    Function.support (antiTestIntegrand ρ T v) ⊆ Function.support (T v) := by
  intro x hx
  by_contra hxv
  apply hx
  have hv0 : T v x = 0 := Function.notMem_support.mp hxv
  simp [antiTestIntegrand, hv0]

theorem linearBochnerPairing_eq_setIntegral_of_support_subset
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v : V} {s : Set X}
    (hs : Function.support (T v) ⊆ s) :
    linearBochnerPairing μ ρ T v =
      ∫ x in s, linearTestIntegrand ρ T v x ∂μ :=
  integral_eq_setIntegral_of_support_subset
    ((support_linearTestIntegrand_subset_test ρ T v).trans hs)

theorem antiBochnerPairing_eq_setIntegral_of_support_subset
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v : V} {s : Set X}
    (hs : Function.support (T v) ⊆ s) :
    antiBochnerPairing μ ρ T v =
      ∫ x in s, antiTestIntegrand ρ T v x ∂μ :=
  integral_eq_setIntegral_of_support_subset
    ((support_antiTestIntegrand_subset_test ρ T v).trans hs)

theorem linearBochnerPairing_eq_setIntegral_of_tsupport_subset
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v : V} {s : Set X}
    (hs : tsupport (T v) ⊆ s) :
    linearBochnerPairing μ ρ T v =
      ∫ x in s, linearTestIntegrand ρ T v x ∂μ :=
  linearBochnerPairing_eq_setIntegral_of_support_subset
    ((subset_tsupport (T v)).trans hs)

theorem antiBochnerPairing_eq_setIntegral_of_tsupport_subset
    {μ : MeasureTheory.Measure X} {ρ : X → ℂ}
    {T : V →ₗ[ℂ] (X → ℂ)} {v : V} {s : Set X}
    (hs : tsupport (T v) ⊆ s) :
    antiBochnerPairing μ ρ T v =
      ∫ x in s, antiTestIntegrand ρ T v x ∂μ :=
  antiBochnerPairing_eq_setIntegral_of_support_subset
    ((subset_tsupport (T v)).trans hs)

theorem coreBochnerPairing_eq_setIntegral
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongDual ℂ V} {ρ : X → ℂ}
    (hpair : CoreBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    {s : Set X} (hs : tsupport (T v) ⊆ s) :
    dualPairing F v = ∫ x in s, linearTestIntegrand ρ T v x ∂μ := by
  calc
    dualPairing F v = linearBochnerPairing μ ρ T v := hpair v hvD
    _ = ∫ x in s, linearTestIntegrand ρ T v x ∂μ :=
      linearBochnerPairing_eq_setIntegral_of_tsupport_subset hs

theorem coreAntiBochnerPairing_eq_setIntegral
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongAntiDual V} {ρ : X → ℂ}
    (hpair : CoreAntiBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    {s : Set X} (hs : tsupport (T v) ⊆ s) :
    antiDualPairing F v = ∫ x in s, antiTestIntegrand ρ T v x ∂μ := by
  calc
    antiDualPairing F v = antiBochnerPairing μ ρ T v := hpair v hvD
    _ = ∫ x in s, antiTestIntegrand ρ T v x ∂μ :=
      antiBochnerPairing_eq_setIntegral_of_tsupport_subset hs

/-! #### Compact support and truncation exhaustions -/

/-- The topological support of a compactly supported function lies in the
interior of a sufficiently large member of a compact exhaustion. -/
theorem tsupport_subset_interior_compactExhaustion
    (K : CompactExhaustion X) {g : X → ℂ}
    (hg : HasCompactSupport g) :
    ∃ Y, tsupport g ⊆ interior (K Y) := by
  obtain ⟨n, hn⟩ := K.exists_superset_of_isCompact hg.isCompact
  exact ⟨n + 1, hn.trans (K.subset_interior_succ n)⟩

theorem support_subset_interior_compactExhaustion
    (K : CompactExhaustion X) {g : X → ℂ}
    (hg : HasCompactSupport g) :
    ∃ Y, Function.support g ⊆ interior (K Y) := by
  obtain ⟨Y, hY⟩ := tsupport_subset_interior_compactExhaustion K hg
  exact ⟨Y, (subset_tsupport g).trans hY⟩

theorem eventually_tsupport_subset_compactExhaustion
    (K : CompactExhaustion X) {g : X → ℂ}
    (hg : HasCompactSupport g) :
    ∃ Y₀, ∀ Y, Y₀ ≤ Y → tsupport g ⊆ K Y := by
  obtain ⟨Y₀, hY₀⟩ := K.exists_superset_of_isCompact hg.isCompact
  exact ⟨Y₀, fun Y hY => hY₀.trans (K.subset hY)⟩

theorem coreBochnerPairing_eq_setIntegral_of_compactSupport
    (K : CompactExhaustion X)
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongDual ℂ V} {ρ : X → ℂ}
    (hpair : CoreBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    (hv : HasCompactSupport (T v)) :
    ∃ Y, dualPairing F v =
      ∫ x in K Y, linearTestIntegrand ρ T v x ∂μ := by
  obtain ⟨Y, hY⟩ := K.exists_superset_of_isCompact hv.isCompact
  exact ⟨Y, coreBochnerPairing_eq_setIntegral hpair hvD hY⟩

theorem coreAntiBochnerPairing_eq_setIntegral_of_compactSupport
    (K : CompactExhaustion X)
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongAntiDual V} {ρ : X → ℂ}
    (hpair : CoreAntiBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    (hv : HasCompactSupport (T v)) :
    ∃ Y, antiDualPairing F v =
      ∫ x in K Y, antiTestIntegrand ρ T v x ∂μ := by
  obtain ⟨Y, hY⟩ := K.exists_superset_of_isCompact hv.isCompact
  exact ⟨Y, coreAntiBochnerPairing_eq_setIntegral hpair hvD hY⟩

/-- Once a test has compact support, every sufficiently large truncation gives
the same linear-dual pairing as the global integral. -/
theorem coreBochnerPairing_eq_setIntegral_eventually_of_compactSupport
    (K : CompactExhaustion X)
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongDual ℂ V} {ρ : X → ℂ}
    (hpair : CoreBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    (hv : HasCompactSupport (T v)) :
    ∃ Y₀, ∀ Y, Y₀ ≤ Y → dualPairing F v =
      ∫ x in K Y, linearTestIntegrand ρ T v x ∂μ := by
  obtain ⟨Y₀, hY₀⟩ := eventually_tsupport_subset_compactExhaustion K hv
  exact ⟨Y₀, fun Y hY =>
    coreBochnerPairing_eq_setIntegral hpair hvD (hY₀ Y hY)⟩

/-- Conjugate-linear counterpart of eventual truncation independence. -/
theorem coreAntiBochnerPairing_eq_setIntegral_eventually_of_compactSupport
    (K : CompactExhaustion X)
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {F : StrongAntiDual V} {ρ : X → ℂ}
    (hpair : CoreAntiBochnerPairing μ D T F ρ) {v : V} (hvD : v ∈ D)
    (hv : HasCompactSupport (T v)) :
    ∃ Y₀, ∀ Y, Y₀ ≤ Y → antiDualPairing F v =
      ∫ x in K Y, antiTestIntegrand ρ T v x ∂μ := by
  obtain ⟨Y₀, hY₀⟩ := eventually_tsupport_subset_compactExhaustion K hv
  exact ⟨Y₀, fun Y hY =>
    coreAntiBochnerPairing_eq_setIntegral hpair hvD (hY₀ Y hY)⟩

/-- Tests in `D` whose topological support lies in the truncation `FY i`. -/
def truncatedTestCore (D : Set V) (T : V →ₗ[ℂ] (X → ℂ))
    (FY : ι → Set X) (i : ι) : Set V :=
  {v | v ∈ D ∧ tsupport (T v) ⊆ FY i}

@[simp]
theorem mem_truncatedTestCore {D : Set V} {T : V →ₗ[ℂ] (X → ℂ)}
    {FY : ι → Set X} {i : ι} {v : V} :
    v ∈ truncatedTestCore D T FY i ↔
      v ∈ D ∧ tsupport (T v) ⊆ FY i :=
  Iff.rfl

theorem truncatedTestCore_subset_core
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) (FY : ι → Set X) (i : ι) :
    truncatedTestCore D T FY i ⊆ D :=
  fun _ hv => hv.1

theorem truncatedTestCore_mono [Preorder ι]
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) {FY : ι → Set X}
    (hFY : Monotone FY) :
    Monotone (truncatedTestCore D T FY) := by
  intro i j hij v hv
  exact ⟨hv.1, hv.2.trans (hFY hij)⟩

theorem iUnion_truncatedTestCore_eq
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) (FY : ι → Set X)
    (hCover : ∀ v ∈ D, ∃ i, tsupport (T v) ⊆ FY i) :
    (⋃ i, truncatedTestCore D T FY i) = D := by
  apply Set.Subset.antisymm
  · intro v hv
    rcases Set.mem_iUnion.mp hv with ⟨i, hi⟩
    exact hi.1
  · intro v hv
    rcases hCover v hv with ⟨i, hi⟩
    exact Set.mem_iUnion.mpr ⟨i, ⟨hv, hi⟩⟩

theorem dense_iUnion_truncatedTestCore
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) (FY : ι → Set X)
    (hDense : Dense D)
    (hCover : ∀ v ∈ D, ∃ i, tsupport (T v) ⊆ FY i) :
    Dense (⋃ i, truncatedTestCore D T FY i) := by
  rw [iUnion_truncatedTestCore_eq D T FY hCover]
  exact hDense

def truncatedDualCoreExhaustion [Preorder ι]
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) (FY : ι → Set X)
    (hFY : Monotone FY) (hDense : Dense D)
    (hCover : ∀ v ∈ D, ∃ i, tsupport (T v) ⊆ FY i) :
    DualCoreExhaustion ι V where
  core := truncatedTestCore D T FY
  monotone_core := truncatedTestCore_mono D T hFY
  dense_iUnion := dense_iUnion_truncatedTestCore D T FY hDense hCover

theorem dual_norm_eq_iSup_truncatedTestCore [Preorder ι]
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ)) (FY : ι → Set X)
    (hFY : Monotone FY) (hDense : Dense D)
    (hCover : ∀ v ∈ D, ∃ i, tsupport (T v) ⊆ FY i)
    (f : StrongDual ℂ V) :
    ‖f‖ = ⨆ i, coreRatioNorm (truncatedTestCore D T FY i) f :=
  (truncatedDualCoreExhaustion D T FY hFY hDense hCover).norm_eq_iSup_coreRatio f

theorem compactExhaustion_covers_compactlySupported_tests
    (K : CompactExhaustion X)
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ))
    (hCompact : ∀ v ∈ D, HasCompactSupport (T v)) :
    ∀ v ∈ D, ∃ Y, tsupport (T v) ⊆ K Y := by
  intro v hv
  exact K.exists_superset_of_isCompact (hCompact v hv).isCompact

/-- Interior-valued cover matching the corrected paper core
`D_Y = {v ∈ D | tsupport (T v) ⊆ interior (K Y)}` literally. -/
theorem compactExhaustion_interiors_cover_compactlySupported_tests
    (K : CompactExhaustion X)
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ))
    (hCompact : ∀ v ∈ D, HasCompactSupport (T v)) :
    ∀ v ∈ D, ∃ Y, tsupport (T v) ⊆ interior (K Y) := by
  intro v hv
  exact tsupport_subset_interior_compactExhaustion K (hCompact v hv)

/-- Compactly supported tests on a dense core give the corrected outer
supremum over all truncation heights.  No single finite truncation is claimed
to norm the whole dual. -/
theorem dual_norm_eq_iSup_compactExhaustion
    (K : CompactExhaustion X)
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ))
    (hDense : Dense D)
    (hCompact : ∀ v ∈ D, HasCompactSupport (T v))
    (f : StrongDual ℂ V) :
    ‖f‖ = ⨆ Y : ℕ,
      coreRatioNorm (truncatedTestCore D T K Y) f := by
  exact dual_norm_eq_iSup_truncatedTestCore D T K
    (by
      intro m n hmn
      exact K.subset hmn)
    hDense
    (compactExhaustion_covers_compactlySupported_tests K D T hCompact)
    f

/-- Literal interior-core version of the corrected norm exhaustion. -/
theorem dual_norm_eq_iSup_interior_compactExhaustion
    (K : CompactExhaustion X)
    (D : Set V) (T : V →ₗ[ℂ] (X → ℂ))
    (hDense : Dense D)
    (hCompact : ∀ v ∈ D, HasCompactSupport (T v))
    (f : StrongDual ℂ V) :
    ‖f‖ = ⨆ Y : ℕ,
      coreRatioNorm
        (truncatedTestCore D T (fun n => interior (K n)) Y) f := by
  exact dual_norm_eq_iSup_truncatedTestCore D T
    (fun n => interior (K n))
    (by
      intro m n hmn
      exact interior_mono (K.subset hmn))
    hDense
    (compactExhaustion_interiors_cover_compactlySupported_tests
      K D T hCompact)
    f

theorem solvesWeakWithPotential_on_truncatedTestCore
    {A potentialOp : WeakOperator V} {u : V} {f : StrongDual ℂ V}
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρA ρP : X → ℂ}
    {FY : ι → Set X} {i : ι} {v : V}
    (hEq : SolvesWeakWithPotential A potentialOp u f)
    (hregA : CoreBochnerRegular μ D T ρA)
    (hregP : CoreBochnerRegular μ D T ρP)
    (hpairA : CoreBochnerPairing μ D T (A u) ρA)
    (hpairP : CoreBochnerPairing μ D T (potentialOp u) ρP)
    (hv : v ∈ truncatedTestCore D T FY i) :
    dualPairing f v =
      ∫ x in FY i, linearTestIntegrand (ρA + ρP) T v x ∂μ := by
  exact coreBochnerPairing_eq_setIntegral
    (solvesWeakWithPotential_coreBochnerPairing
      hEq hregA hregP hpairA hpairP) hv.1 hv.2

theorem solvesWeakAntiWithPotential_on_truncatedTestCore
    {A potentialOp : WeakAntiOperator V} {u : V} {f : StrongAntiDual V}
    {μ : MeasureTheory.Measure X} {D : Set V}
    {T : V →ₗ[ℂ] (X → ℂ)} {ρA ρP : X → ℂ}
    {FY : ι → Set X} {i : ι} {v : V}
    (hEq : SolvesWeakAntiWithPotential A potentialOp u f)
    (hregA : CoreAntiBochnerRegular μ D T ρA)
    (hregP : CoreAntiBochnerRegular μ D T ρP)
    (hpairA : CoreAntiBochnerPairing μ D T (A u) ρA)
    (hpairP : CoreAntiBochnerPairing μ D T (potentialOp u) ρP)
    (hv : v ∈ truncatedTestCore D T FY i) :
    antiDualPairing f v =
      ∫ x in FY i, antiTestIntegrand (ρA + ρP) T v x ∂μ := by
  exact coreAntiBochnerPairing_eq_setIntegral
    (solvesWeakAntiWithPotential_coreBochnerPairing
      hEq hregA hregP hpairA hpairP) hv.1 hv.2

end CoreBochnerWeakForm

/-! ### P1 checklist 5.3: complex Lax--Milgram by realification

The form convention in this section is the one forced by the paper's weak
pairing: the trial variable is complex-linear and the test variable is
conjugate-linear.  Boundedness is part of the nested continuous-linear-map
type.  The coercivity constant is kept explicit, rather than hidden inside an
existential, so that the final `α⁻¹` estimate has a kernel-checked provenance.

This is an unconditional *abstract reduction theorem*.  A concrete
automorphic application must still construct the form and prove its
coercivity hypothesis.  In particular, the shifted theorem at the end proves
only the shifted equation; it does not perform the invalid "undo the shift"
step in the paper's display (1.16).
-/

namespace ComplexLaxMilgram

/-! #### Bounded sesquilinear forms and explicit complex coercivity -/

/-- A bounded complex sesquilinear form, linear in the trial variable and
conjugate-linear in the test variable. -/
abbrev ContinuousSesquilinearForm (V : Type*)
    [NormedAddCommGroup V] [NormedSpace ℂ V] :=
  WeakAntiOperator V

/-- Complex coercivity with a specified positive constant. -/
def ComplexCoerciveWith {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (α : ℝ) (B : ContinuousSesquilinearForm V) : Prop :=
  0 < α ∧ ∀ u : V, α * ‖u‖ ^ 2 ≤ (B u u).re

namespace ComplexCoerciveWith

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]
variable {α : ℝ} {B : ContinuousSesquilinearForm V}

theorem alpha_pos (hB : ComplexCoerciveWith α B) : 0 < α :=
  hB.1

theorem diagonal (hB : ComplexCoerciveWith α B) (u : V) :
    α * ‖u‖ ^ 2 ≤ (B u u).re :=
  hB.2 u

end ComplexCoerciveWith

/-- A form together with an exposed proof that it is coercive at the fixed
constant `α`.  This subtype makes the high-level solver read `solve B F`
without hiding either `α` or the coercivity proof in an axiom or typeclass. -/
abbrev CoerciveSesquilinearFormWith (α : ℝ) (V : Type*)
    [NormedAddCommGroup V] [NormedSpace ℂ V] :=
  {B : ContinuousSesquilinearForm V // ComplexCoerciveWith α B}

/-! #### A small reusable real Lax--Milgram solver -/

section RealLaxMilgramCore

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable [CompleteSpace H]

/-- The real Lax--Milgram solution obtained by composing the inverse
Lax--Milgram equivalence with the real Riesz representative of `f`. -/
noncomputable def realLaxMilgramSolve
    (B : H →L[ℝ] H →L[ℝ] ℝ) (hB : IsCoercive B)
    (f : H →L[ℝ] ℝ) : H :=
  hB.continuousLinearEquivOfBilin.symm
    ((InnerProductSpace.toDual ℝ H).symm f)

theorem realLaxMilgramSolve_spec
    (B : H →L[ℝ] H →L[ℝ] ℝ) (hB : IsCoercive B)
    (f : H →L[ℝ] ℝ) (v : H) :
    B (realLaxMilgramSolve B hB f) v = f v := by
  calc
    B (realLaxMilgramSolve B hB f) v =
        ⟪hB.continuousLinearEquivOfBilin
            (realLaxMilgramSolve B hB f), v⟫_ℝ :=
      (hB.continuousLinearEquivOfBilin_apply _ _).symm
    _ = ⟪(InnerProductSpace.toDual ℝ H).symm f, v⟫_ℝ := by
      rw [realLaxMilgramSolve,
        ContinuousLinearEquiv.apply_symm_apply]
    _ = f v :=
      InnerProductSpace.toDual_symm_apply

theorem realLaxMilgramSolve_unique
    (B : H →L[ℝ] H →L[ℝ] ℝ) (hB : IsCoercive B)
    (f : H →L[ℝ] ℝ) {u : H} (hu : ∀ v, B u v = f v) :
    u = realLaxMilgramSolve B hB f := by
  apply hB.continuousLinearEquivOfBilin.injective
  apply ext_inner_right ℝ
  intro v
  calc
    ⟪hB.continuousLinearEquivOfBilin u, v⟫_ℝ = B u v :=
      hB.continuousLinearEquivOfBilin_apply u v
    _ = f v := hu v
    _ = B (realLaxMilgramSolve B hB f) v :=
      (realLaxMilgramSolve_spec B hB f v).symm
    _ = ⟪hB.continuousLinearEquivOfBilin
        (realLaxMilgramSolve B hB f), v⟫_ℝ :=
      (hB.continuousLinearEquivOfBilin_apply _ _).symm

theorem realLaxMilgramSolve_existsUnique
    (B : H →L[ℝ] H →L[ℝ] ℝ) (hB : IsCoercive B)
    (f : H →L[ℝ] ℝ) :
    ∃! u : H, ∀ v, B u v = f v := by
  refine ⟨realLaxMilgramSolve B hB f,
    realLaxMilgramSolve_spec B hB f, ?_⟩
  intro u hu
  exact realLaxMilgramSolve_unique B hB f hu

end RealLaxMilgramCore

/-! #### Realification of anti-linear functionals and sesquilinear forms -/

section Realification

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- The real-linear map underlying the real part of a complex anti-linear
functional.  The scalar proof uses that conjugation fixes real scalars. -/
noncomputable def realifiedFunctionalLinear (F : StrongAntiDual V) : V →ₗ[ℝ] ℝ := by
  set_option maxHeartbeats 800000 in
  set_option maxRecDepth 10000 in
    exact
      { toFun := fun v => (F v).re
        map_add' := by
          intro u v
          simp
        map_smul' := by
          set_option maxHeartbeats 4000000 in
            set_option maxRecDepth 100000 in
              intro r v
              have hr : r • v = (r : ℂ) • v := rfl
              rw [hr, map_smulₛₗ]
              change
                (((starRingEnd ℂ) (r : ℂ)) * F v).re =
                  r * (F v).re
              rw [starRingEnd_apply, Complex.star_def,
                Complex.conj_ofReal]
              exact Complex.re_ofReal_mul r (F v) }

theorem realifiedFunctionalLinear_bound (F : StrongAntiDual V) (v : V) :
    ‖realifiedFunctionalLinear F v‖ ≤ ‖F‖ * ‖v‖ := by
  change ‖(F v).re‖ ≤ ‖F‖ * ‖v‖
  rw [Real.norm_eq_abs]
  exact (Complex.abs_re_le_norm (F v)).trans (F.le_opNorm v)

/-- The real part of a bounded anti-linear functional, as a bounded real
linear functional. -/
noncomputable def realifiedFunctional (F : StrongAntiDual V) : V →L[ℝ] ℝ :=
  (realifiedFunctionalLinear F).mkContinuous ‖F‖
    (realifiedFunctionalLinear_bound F)

@[simp]
theorem realifiedFunctional_apply (F : StrongAntiDual V) (v : V) :
    realifiedFunctional F v = (F v).re :=
  rfl

theorem realifiedFunctional_norm_le (F : StrongAntiDual V) :
    ‖realifiedFunctional F‖ ≤ ‖F‖ := by
  unfold realifiedFunctional
  exact LinearMap.mkContinuous_norm_le _ (norm_nonneg F)
    (realifiedFunctionalLinear_bound F)

theorem realifiedFunctional_continuous (F : StrongAntiDual V) :
    Continuous (fun v => realifiedFunctional F v) :=
  (realifiedFunctional F).continuous

/-- The real-bilinear map underlying the real part of a bounded complex
sesquilinear form. -/
noncomputable def realifiedFormLinear (B : ContinuousSesquilinearForm V) :
    V →ₗ[ℝ] V →ₗ[ℝ] ℝ := by
  set_option maxHeartbeats 800000 in
  set_option maxRecDepth 10000 in
    exact LinearMap.mk₂ ℝ (fun u v => (B u v).re)
      (by
        intro u₁ u₂ v
        simp)
      (by
        intro r u v
        have hr : r • u = (r : ℂ) • u := rfl
        simp only [hr, map_smul, smul_apply,
          smul_eq_mul, Complex.re_ofReal_mul])
      (by
        intro u v₁ v₂
        simp)
      (by
        set_option maxHeartbeats 4000000 in
          set_option maxRecDepth 100000 in
            intro r u v
            have hr : r • v = (r : ℂ) • v := rfl
            rw [hr, map_smulₛₗ]
            change
              (((starRingEnd ℂ) (r : ℂ)) * B u v).re =
                r * (B u v).re
            rw [starRingEnd_apply, Complex.star_def,
              Complex.conj_ofReal]
            exact Complex.re_ofReal_mul r (B u v))

theorem realifiedFormLinear_bound (B : ContinuousSesquilinearForm V)
    (u v : V) :
    ‖realifiedFormLinear B u v‖ ≤ ‖B‖ * ‖u‖ * ‖v‖ := by
  change ‖(B u v).re‖ ≤ ‖B‖ * ‖u‖ * ‖v‖
  rw [Real.norm_eq_abs]
  exact (Complex.abs_re_le_norm (B u v)).trans
    ((B u).le_of_opNorm_le (B.le_opNorm u) v)

/-- Realification of a bounded complex sesquilinear form. -/
noncomputable def realifiedForm (B : ContinuousSesquilinearForm V) :
    V →L[ℝ] V →L[ℝ] ℝ :=
  (realifiedFormLinear B).mkContinuous₂ ‖B‖
    (realifiedFormLinear_bound B)

@[simp]
theorem realifiedForm_apply (B : ContinuousSesquilinearForm V) (u v : V) :
    realifiedForm B u v = (B u v).re :=
  rfl

@[simp]
theorem realifiedForm_add_left (B : ContinuousSesquilinearForm V)
    (u₁ u₂ v : V) :
    realifiedForm B (u₁ + u₂) v =
      realifiedForm B u₁ v + realifiedForm B u₂ v := by
  simp

@[simp]
theorem realifiedForm_smul_left (B : ContinuousSesquilinearForm V)
    (r : ℝ) (u v : V) :
    realifiedForm B (r • u) v = r * realifiedForm B u v := by
  simp

@[simp]
theorem realifiedForm_add_right (B : ContinuousSesquilinearForm V)
    (u v₁ v₂ : V) :
    realifiedForm B u (v₁ + v₂) =
      realifiedForm B u v₁ + realifiedForm B u v₂ := by
  simp

@[simp]
theorem realifiedForm_smul_right (B : ContinuousSesquilinearForm V)
    (r : ℝ) (u v : V) :
    realifiedForm B u (r • v) = r * realifiedForm B u v := by
  simp

theorem realifiedForm_norm_le (B : ContinuousSesquilinearForm V) :
    ‖realifiedForm B‖ ≤ ‖B‖ := by
  unfold realifiedForm
  exact LinearMap.mkContinuous₂_norm_le _ (norm_nonneg B)
    (realifiedFormLinear_bound B)

theorem realifiedForm_continuous (B : ContinuousSesquilinearForm V) :
    Continuous (fun p : V × V => realifiedForm B p.1 p.2) :=
  (realifiedForm B).continuous₂

/-- The specified complex coercivity constant is preserved exactly by
realification. -/
theorem realifiedForm_isCoercive {α : ℝ}
    {B : ContinuousSesquilinearForm V} (hB : ComplexCoerciveWith α B) :
    IsCoercive (realifiedForm B) := by
  refine ⟨α, hB.1, ?_⟩
  intro u
  simpa only [realifiedForm_apply, pow_two, mul_assoc] using hB.2 u

end Realification

/-! #### Recovering a complex equality from the literal tests `v` and `I • v` -/

/-- Real parts of `z`, and real parts after multiplication by `-i`, determine
the complex number.  The sign is the one produced by a conjugate-linear test
slot evaluated at `I • v`. -/
theorem complex_eq_of_re_eq_of_re_neg_I_mul_eq {z w : ℂ}
    (hre : z.re = w.re)
    (hnegI : ((-Complex.I) * z).re = ((-Complex.I) * w).re) :
    z = w := by
  apply Complex.ext
  · exact hre
  · simpa only [neg_mul, Complex.neg_re, Complex.I_mul_re, neg_neg]
      using hnegI

section RecoverComplexEquation

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- Equality of real parts against every test vector upgrades to equality in
the anti-dual.  The proof literally tests `I • v`; anti-linearity changes the
scalar to `-I`. -/
theorem weakAntiEquation_of_forall_re_eq
    (B : ContinuousSesquilinearForm V) (u : V) (F : StrongAntiDual V)
    (h : ∀ v : V, (B u v).re = (F v).re) :
    WeakAntiEquation B u F := by
  set_option maxHeartbeats 4000000 in
    set_option maxRecDepth 100000 in
      apply (weakAntiEquation_iff_forall B u F).2
      intro v
      apply complex_eq_of_re_eq_of_re_neg_I_mul_eq (h v)
      have hI := h (Complex.I • v)
      rw [map_smulₛₗ, map_smulₛₗ] at hI
      have hstar : starRingEnd ℂ Complex.I = -Complex.I := by
        exact Complex.conj_I
      rw [hstar] at hI
      simpa only [smul_eq_mul] using hI

theorem forall_re_eq_iff_weakAntiEquation
    (B : ContinuousSesquilinearForm V) (u : V) (F : StrongAntiDual V) :
    (∀ v : V, (B u v).re = (F v).re) ↔
      WeakAntiEquation B u F := by
  constructor
  · exact weakAntiEquation_of_forall_re_eq B u F
  · intro h v
    exact congrArg Complex.re
      ((weakAntiEquation_iff_forall B u F).1 h v)

end RecoverComplexEquation

/-! #### Complex solution, uniqueness, and the sharp coercive estimate -/

section ComplexSolver

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
variable [CompleteSpace V]

/-- Low-level solver for a raw form and an explicit coercivity proof. -/
noncomputable def solveWith (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) : V := by
  letI : InnerProductSpace ℝ V := InnerProductSpace.rclikeToReal ℂ V
  letI : IsScalarTower ℝ ℂ V := IsScalarTower.restrictScalars ℝ ℂ V
  exact realLaxMilgramSolve (realifiedForm B)
    (realifiedForm_isCoercive hB) (realifiedFunctional F)

/-- The real equation delivered directly by mathlib's real Lax--Milgram
equivalence. -/
theorem solveWith_real_spec (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) (v : V) :
    (B (solveWith α B hB F) v).re = (F v).re := by
  letI : InnerProductSpace ℝ V := InnerProductSpace.rclikeToReal ℂ V
  letI : IsScalarTower ℝ ℂ V := IsScalarTower.restrictScalars ℝ ℂ V
  simpa only [solveWith, realifiedForm_apply,
    realifiedFunctional_apply] using
      (realLaxMilgramSolve_spec
        (B := realifiedForm B)
        (hB := realifiedForm_isCoercive hB)
        (f := realifiedFunctional F) v)

/-- The realified solution satisfies the full complex weak equation. -/
theorem solveWith_equation (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    WeakAntiEquation B (solveWith α B hB F) F :=
  weakAntiEquation_of_forall_re_eq B (solveWith α B hB F) F
    (solveWith_real_spec α B hB F)

theorem solveWith_spec (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) (v : V) :
    B (solveWith α B hB F) v = F v :=
  (weakAntiEquation_iff_forall B (solveWith α B hB F) F).1
    (solveWith_equation α B hB F) v

theorem solveWith_operator_spec (α : ℝ)
    (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    B (solveWith α B hB F) = F := by
  ext v
  exact solveWith_spec α B hB F v

theorem solveWith_unique (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V)
    {u : V} (hu : ∀ v, B u v = F v) :
    u = solveWith α B hB F := by
  letI : InnerProductSpace ℝ V := InnerProductSpace.rclikeToReal ℂ V
  letI : IsScalarTower ℝ ℂ V := IsScalarTower.restrictScalars ℝ ℂ V
  have hreal : ∀ v, realifiedForm B u v = realifiedFunctional F v := by
    intro v
    simpa only [realifiedForm_apply, realifiedFunctional_apply] using
      congrArg Complex.re (hu v)
  simpa only [solveWith] using
    (realLaxMilgramSolve_unique
      (B := realifiedForm B)
      (hB := realifiedForm_isCoercive hB)
      (f := realifiedFunctional F) hreal)

theorem solveWith_existsUnique (α : ℝ)
    (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    ∃! u : V, ∀ v, B u v = F v := by
  refine ⟨solveWith α B hB F, solveWith_spec α B hB F, ?_⟩
  intro u hu
  exact solveWith_unique α B hB F hu

theorem solveWith_existsUnique_operator (α : ℝ)
    (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    ∃! u : V, B u = F := by
  refine ⟨solveWith α B hB F, solveWith_operator_spec α B hB F, ?_⟩
  intro u hu
  apply solveWith_unique α B hB F
  intro v
  exact congrArg (fun G : StrongAntiDual V => G v) hu

/-- Energy inequality before cancellation of the solution norm. -/
theorem solveWith_energy_le (α : ℝ)
    (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    α * ‖solveWith α B hB F‖ ^ 2 ≤
      ‖F‖ * ‖solveWith α B hB F‖ := by
  calc
    α * ‖solveWith α B hB F‖ ^ 2 ≤
        (B (solveWith α B hB F) (solveWith α B hB F)).re :=
      hB.2 _
    _ = (F (solveWith α B hB F)).re :=
      congrArg Complex.re
        (solveWith_spec α B hB F (solveWith α B hB F))
    _ ≤ ‖F (solveWith α B hB F)‖ :=
      Complex.re_le_norm _
    _ ≤ ‖F‖ * ‖solveWith α B hB F‖ :=
      F.le_opNorm _

/-- Coercivity times the solution norm is controlled by the data norm. -/
theorem solveWith_coercivity_mul_norm_le (α : ℝ)
    (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    α * ‖solveWith α B hB F‖ ≤ ‖F‖ := by
  by_cases hu : solveWith α B hB F = 0
  · simp [hu]
  · have hnorm : 0 < ‖solveWith α B hB F‖ :=
      norm_pos_iff.mpr hu
    have hcancel :
        (α * ‖solveWith α B hB F‖) * ‖solveWith α B hB F‖ ≤
          ‖F‖ * ‖solveWith α B hB F‖ := by
      simpa only [pow_two, mul_assoc] using
        solveWith_energy_le α B hB F
    exact le_of_mul_le_mul_right hcancel hnorm

/-- Sharp a-priori estimate with the same explicit coercivity constant. -/
theorem solveWith_norm_le (α : ℝ) (B : ContinuousSesquilinearForm V)
    (hB : ComplexCoerciveWith α B) (F : StrongAntiDual V) :
    ‖solveWith α B hB F‖ ≤ α⁻¹ * ‖F‖ := by
  calc
    ‖solveWith α B hB F‖ =
        α⁻¹ * (α * ‖solveWith α B hB F‖) := by
      rw [← mul_assoc, inv_mul_cancel₀ hB.1.ne', one_mul]
    _ ≤ α⁻¹ * ‖F‖ :=
      mul_le_mul_of_nonneg_left
        (solveWith_coercivity_mul_norm_le α B hB F)
        (inv_nonneg.mpr hB.1.le)

/-! The high-level API: the coercivity proof is carried by `B`, hence the
solver itself has the requested two explicit arguments `solve B F`. -/

noncomputable def solve {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) : V :=
  solveWith α B.1 B.2 F

theorem solve_spec {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) (v : V) :
    B.1 (solve B F) v = F v := by
  simpa only [solve] using solveWith_spec α B.1 B.2 F v

theorem solve_equation {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) :
    B.1 (solve B F) = F := by
  ext v
  exact solve_spec B F v

theorem solve_unique_of_forall {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V)
    {u : V} (hu : ∀ v, B.1 u v = F v) :
    u = solve B F := by
  simpa only [solve] using solveWith_unique α B.1 B.2 F hu

theorem solve_unique {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V)
    {u : V} (hu : B.1 u = F) :
    u = solve B F := by
  apply solve_unique_of_forall B F
  intro v
  exact congrArg (fun G : StrongAntiDual V => G v) hu

theorem solve_existsUnique {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) :
    ∃! u : V, B.1 u = F := by
  refine ⟨solve B F, solve_equation B F, ?_⟩
  intro u hu
  exact solve_unique B F hu

theorem solve_energy_le {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) :
    α * ‖solve B F‖ ^ 2 ≤ ‖F‖ * ‖solve B F‖ := by
  simpa only [solve] using solveWith_energy_le α B.1 B.2 F

theorem solve_coercivity_mul_norm_le {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) :
    α * ‖solve B F‖ ≤ ‖F‖ := by
  simpa only [solve] using
    solveWith_coercivity_mul_norm_le α B.1 B.2 F

theorem solve_norm_le {α : ℝ}
    (B : CoerciveSesquilinearFormWith α V) (F : StrongAntiDual V) :
    ‖solve B F‖ ≤ α⁻¹ * ‖F‖ := by
  simpa only [solve] using solveWith_norm_le α B.1 B.2 F

end ComplexSolver

/-! #### Shifted forms: the mass operator remains explicit -/

section ShiftedForms

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- A shift by a specified bounded mass form.  Keeping `mass` explicit is
essential: on an `H¹` trial space, `innerSLFlip ℂ` is the `H¹` Riesz pairing,
whereas the paper's display uses an `L²` mass pairing. -/
noncomputable def shiftedForm (B mass : ContinuousSesquilinearForm V) (lam : ℝ) :
    ContinuousSesquilinearForm V :=
  B + (lam : ℂ) • mass

@[simp]
theorem shiftedForm_apply (B mass : ContinuousSesquilinearForm V)
    (lam : ℝ) (u v : V) :
    shiftedForm B mass lam u v =
      B u v + (lam : ℂ) * mass u v := by
  simp [shiftedForm]

/-- Operator form of the exact residual left by a shift. -/
theorem shiftedForm_equation_iff_residual
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (u : V) (F : StrongAntiDual V) :
    shiftedForm B mass lam u = F ↔
      B u = F - (lam : ℂ) • mass u := by
  change B u + (lam : ℂ) • mass u = F ↔
    B u = F - (lam : ℂ) • mass u
  constructor
  · intro h
    exact (eq_sub_iff_add_eq).2 h
  · intro h
    exact (eq_sub_iff_add_eq).1 h

/-- Pointwise form of the exact residual left by a shift. -/
theorem shiftedForm_equation_iff_forall_residual
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (u : V) (F : StrongAntiDual V) :
    shiftedForm B mass lam u = F ↔
      ∀ v : V, B u v = F v - (lam : ℂ) * mass u v := by
  constructor
  · intro h v
    have hres :=
      (shiftedForm_equation_iff_residual B mass lam u F).1 h
    have hv := congrArg (fun G : StrongAntiDual V => G v) hres
    simpa using hv
  · intro h
    apply (shiftedForm_equation_iff_residual B mass lam u F).2
    ext v
    simpa using h v

/-- A shifted solution is an unshifted solution exactly when its mass term
vanishes.  This is the precise replacement for an unconditional shift-removal
claim. -/
theorem shiftedForm_solution_is_unshifted_iff_mass_zero
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (u : V) (F : StrongAntiDual V)
    (hshift : shiftedForm B mass lam u = F) :
    B u = F ↔ (lam : ℂ) • mass u = 0 := by
  have hsum : B u + (lam : ℂ) • mass u = F := by
    ext v
    have hv := congrArg (fun G : StrongAntiDual V => G v) hshift
    change (B u) v + (lam : ℂ) * (mass u) v = F v at hv
    exact hv
  constructor
  · intro hB
    apply add_left_cancel (a := B u)
    simpa only [hB, add_zero] using hsum
  · intro hmass
    calc
      B u = B u + 0 := (add_zero _).symm
      _ = B u + (lam : ℂ) • mass u := by rw [hmass]
      _ = F := hsum

end ShiftedForms

section RieszShiftedForms

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]

/-- The Riesz mass form of `V` itself.  It is offered only as a typed
convenience and is not identified with an `L²` pivot mass on an `H¹` space. -/
noncomputable def rieszMassForm : ContinuousSesquilinearForm V :=
  innerSLFlip ℂ

@[simp]
theorem rieszMassForm_apply (u v : V) :
    rieszMassForm u v = ⟪v, u⟫_ℂ := by
  simp [rieszMassForm]

/-- Shift by the Riesz mass of `V`. -/
noncomputable def rieszShiftedForm (B : ContinuousSesquilinearForm V) (lam : ℝ) :
    ContinuousSesquilinearForm V :=
  shiftedForm B rieszMassForm lam

@[simp]
theorem rieszShiftedForm_apply (B : ContinuousSesquilinearForm V)
    (lam : ℝ) (u v : V) :
    rieszShiftedForm B lam u v =
      B u v + (lam : ℂ) * ⟪v, u⟫_ℂ := by
  simp [rieszShiftedForm]

end RieszShiftedForms

section ShiftedSolver

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
variable [CompleteSpace V]

/-- Solve a shifted form under an explicit coercivity proof for that shifted
form.  No coercivity of an arbitrary shift is manufactured here. -/
noncomputable def solveShifted (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) : V :=
  solveWith α (shiftedForm B mass lam) hShift F

/-- The shifted solver concludes exactly the shifted equation. -/
theorem solveShifted_spec (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) (v : V) :
    B (solveShifted α B mass lam hShift F) v +
        (lam : ℂ) * mass (solveShifted α B mass lam hShift F) v =
      F v := by
  simpa only [solveShifted, shiftedForm_apply] using
    solveWith_spec α (shiftedForm B mass lam) hShift F v

theorem solveShifted_equation (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) :
    shiftedForm B mass lam (solveShifted α B mass lam hShift F) = F := by
  ext v
  simpa only [shiftedForm_apply] using
    solveShifted_spec α B mass lam hShift F v

/-- The unshifted residual retained by the shifted solution. -/
theorem solveShifted_residual (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) (v : V) :
    B (solveShifted α B mass lam hShift F) v =
      F v - (lam : ℂ) * mass (solveShifted α B mass lam hShift F) v :=
  (eq_sub_iff_add_eq).2 (solveShifted_spec α B mass lam hShift F v)

theorem solveShifted_unique (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) {u : V}
    (hu : ∀ v, B u v + (lam : ℂ) * mass u v = F v) :
    u = solveShifted α B mass lam hShift F := by
  simpa only [solveShifted] using
    solveWith_unique α (shiftedForm B mass lam) hShift F
      (fun v => by simpa only [shiftedForm_apply] using hu v)

theorem solveShifted_existsUnique (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) :
    ∃! u : V, ∀ v,
      B u v + (lam : ℂ) * mass u v = F v := by
  refine ⟨solveShifted α B mass lam hShift F,
    solveShifted_spec α B mass lam hShift F, ?_⟩
  intro u hu
  exact solveShifted_unique α B mass lam hShift F hu

theorem solveShifted_norm_le (α : ℝ)
    (B mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm B mass lam))
    (F : StrongAntiDual V) :
    ‖solveShifted α B mass lam hShift F‖ ≤ α⁻¹ * ‖F‖ := by
  simpa only [solveShifted] using
    solveWith_norm_le α (shiftedForm B mass lam) hShift F

/-- For the canonical `V`-Riesz shift, the conclusion remains visibly
shifted; no theorem below replaces it by `B u v = F v`. -/
theorem solveRieszShifted_spec (α : ℝ)
    (B : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (rieszShiftedForm B lam))
    (F : StrongAntiDual V) (v : V) :
    B (solveShifted α B rieszMassForm lam hShift F) v +
        (lam : ℂ) * ⟪v, solveShifted α B rieszMassForm lam hShift F⟫_ℂ =
      F v := by
  simpa only [rieszMassForm_apply] using
    solveShifted_spec α B rieszMassForm lam hShift F v

end ShiftedSolver

end ComplexLaxMilgram

/-! ### Checklist 5.4: Fredholm bypass for the unshifted problem

The source shifted Lax--Milgram solution cannot simply be declared to solve
the unshifted equation.  This section gives the kernel-checkable replacement.
If S : V ≃L W is the coercive shifted operator and C : V →L W is the
compact lower-order term, put K = S⁻¹ C.  The original operator is then
factored as A = S (1 - K).

The kernel hypothesis below is always the kernel of the original unshifted
operator A, not the automatically trivial kernel of S.  Mathlib's actual
compact-operator Fredholm alternative is applied to K at spectral parameter 1.

On a noncompact modular surface, compactness of the full Sobolev-to-pivot
embedding is not automatic.  The cusp-tail certificates below require compact
truncations converging in operator norm.  Pointwise or strong convergence is
deliberately not accepted.  In particular, nothing below asserts that
rieszMassForm is compact in an infinite-dimensional Hilbert space.
-/

namespace FredholmBypass

open ComplexLaxMilgram

/-! #### Exact kernel certificates -/

section TrivialKernel

variable {E F : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]
variable [NormedAddCommGroup F] [NormedSpace ℂ F]

/-- The explicit zero-kernel predicate used throughout the Fredholm layer. -/
def HasTrivialKernel (A : E →L[ℂ] F) : Prop :=
  ∀ u : E, A u = 0 → u = 0

namespace HasTrivialKernel

variable {A : E →L[ℂ] F}

theorem ker_eq_bot (hA : HasTrivialKernel A) : A.ker = ⊥ :=
  LinearMap.ker_eq_bot'.2 hA

theorem injective (hA : HasTrivialKernel A) : Function.Injective A :=
  LinearMap.ker_eq_bot.mp hA.ker_eq_bot

theorem iff_injective :
    HasTrivialKernel A ↔ Function.Injective A := by
  constructor
  · exact injective
  · intro hA u hu
    apply hA
    simpa using hu

/-- A positive lower bound is a reusable, quantitative certificate for
kernel triviality. -/
theorem of_lowerBound
    {c : ℝ} (hc : 0 < c)
    (hbound : ∀ u : E, c * ‖u‖ ≤ ‖A u‖) :
    HasTrivialKernel A := by
  intro u hu
  have h := hbound u
  rw [hu, norm_zero] at h
  have hnorm : ‖u‖ = 0 := by
    have hprod : c * ‖u‖ = 0 :=
      le_antisymm h (mul_nonneg (le_of_lt hc) (norm_nonneg u))
    exact (mul_eq_zero.mp hprod).resolve_left (ne_of_gt hc)
  exact norm_eq_zero.mp hnorm

end HasTrivialKernel

end TrivialKernel

/-! #### Compact lower-order terms and honest cusp-tail control -/

section CompactnessCertificates

variable {E F H : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]
variable [NormedAddCommGroup F] [NormedSpace ℂ F]
variable [NormedAddCommGroup H] [NormedSpace ℂ H]

/-- Compact truncations together with convergence in the operator norm.

For a noncompact cusp this is the required global tail datum.  Merely knowing
that every fixed vector converges is intentionally insufficient. -/
structure CuspTailCompactApproximation (T : E →L[ℂ] F) where
  truncation : ℕ → E →L[ℂ] F
  truncation_isCompact : ∀ n, IsCompactOperator (truncation n)
  tail_norm :
    Filter.Tendsto (fun n => ‖truncation n - T‖) Filter.atTop (nhds 0)

namespace CuspTailCompactApproximation

variable {T : E →L[ℂ] F}

/-- A quantitative operator-norm tail bound constructs the cusp certificate. -/
def ofNormBound
    (truncation : ℕ → E →L[ℂ] F)
    (hcompact : ∀ n, IsCompactOperator (truncation n))
    (ε : ℕ → ℝ) (hε : Filter.Tendsto ε Filter.atTop (nhds 0))
    (htail : ∀ n, ‖truncation n - T‖ ≤ ε n) :
    CuspTailCompactApproximation T where
  truncation := truncation
  truncation_isCompact := hcompact
  tail_norm :=
    squeeze_zero (fun n => norm_nonneg (truncation n - T)) htail hε

variable [CompleteSpace F]

/-- Operator-norm limits of compact cusp truncations are compact. -/
theorem isCompactOperator (h : CuspTailCompactApproximation T) :
    IsCompactOperator T := by
  exact isCompactOperator_of_tendsto (l := Filter.atTop)
    (tendsto_iff_norm_sub_tendsto_zero.mpr h.tail_norm)
    (Filter.Eventually.of_forall h.truncation_isCompact)

end CuspTailCompactApproximation

/-- A lower-order operator factored through an intermediate pivot space. -/
def factoredLowerOrder (J : E →L[ℂ] H) (Q : H →L[ℂ] F) :
    E →L[ℂ] F :=
  Q.comp J

/-- A bounded postcomposition of a compact embedding is compact. -/
theorem factoredLowerOrder_isCompact
    (J : E →L[ℂ] H) (Q : H →L[ℂ] F)
    (hJ : IsCompactOperator J) :
    IsCompactOperator (factoredLowerOrder J Q) := by
  change IsCompactOperator (Q ∘ J)
  exact hJ.clm_comp Q

/-- Factoring through a finite-dimensional pivot gives a concrete compact
lower-order operator. -/
theorem factoredLowerOrder_isCompact_of_finiteDimensional
    [FiniteDimensional ℂ H]
    (J : E →L[ℂ] H) (Q : H →L[ℂ] F) :
    IsCompactOperator (factoredLowerOrder J Q) := by
  have hId : IsCompactOperator (id : H → H) :=
    (isCompactOperator_id_iff_finiteDimensional
      (𝕜 := ℂ) (E := H)).2
      (inferInstance : FiniteDimensional ℂ H)
  have hJ : IsCompactOperator J := by
    simpa only [Function.id_comp] using hId.comp_clm J
  exact factoredLowerOrder_isCompact J Q hJ

variable [CompleteSpace H]

/-- A cusp-tail compact embedding yields a compact lower-order composition. -/
theorem factoredLowerOrder_isCompact_of_cuspTail
    {J : E →L[ℂ] H} (Q : H →L[ℂ] F)
    (hJ : CuspTailCompactApproximation J) :
    IsCompactOperator (factoredLowerOrder J Q) :=
  factoredLowerOrder_isCompact J Q hJ.isCompactOperator

end CompactnessCertificates

section SesquilinearCuspTail

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- Pointwise two-variable tail estimates strong enough to imply convergence
in the operator norm of sesquilinear forms.  A concrete modular-surface proof
must provide both compact core truncations and the uniform cusp estimate. -/
structure SesquilinearCuspTailControl
    (C : ContinuousSesquilinearForm V) where
  truncation : ℕ → ContinuousSesquilinearForm V
  truncation_isCompact :
    ∀ n, IsCompactOperator (truncation n)
  epsilon : ℕ → ℝ
  epsilon_nonneg : ∀ n, 0 ≤ epsilon n
  epsilon_tendsto_zero :
    Filter.Tendsto epsilon Filter.atTop (nhds 0)
  tail_bound :
    ∀ n u v,
      ‖(truncation n - C) u v‖ ≤
        epsilon n * ‖u‖ * ‖v‖

namespace SesquilinearCuspTailControl

variable {C : ContinuousSesquilinearForm V}

/-- The two-variable cusp estimate controls the full operator norm. -/
theorem tail_opNorm_le
    (h : SesquilinearCuspTailControl C) (n : ℕ) :
    ‖h.truncation n - C‖ ≤ h.epsilon n := by
  apply (h.truncation n - C).opNorm_le_bound
    (h.epsilon_nonneg n)
  intro u
  apply ((h.truncation n - C) u).opNorm_le_bound
    (mul_nonneg (h.epsilon_nonneg n) (norm_nonneg u))
  intro v
  exact h.tail_bound n u v

/-- The pointwise tail certificate produces operator-norm convergence. -/
theorem tail_norm_tendsto_zero
    (h : SesquilinearCuspTailControl C) :
    Filter.Tendsto (fun n => ‖h.truncation n - C‖) Filter.atTop (nhds 0) :=
  squeeze_zero
    (fun n => norm_nonneg (h.truncation n - C))
    h.tail_opNorm_le h.epsilon_tendsto_zero

/-- Forget the two-variable presentation and retain the compact
operator-norm approximation. -/
def compactApproximation
    (h : SesquilinearCuspTailControl C) :
    CuspTailCompactApproximation C where
  truncation := h.truncation
  truncation_isCompact := h.truncation_isCompact
  tail_norm := h.tail_norm_tendsto_zero

variable [CompleteSpace (StrongAntiDual V)]

/-- Compact core truncations plus the uniform cusp tail prove compactness of
the full sesquilinear lower-order operator. -/
theorem isCompactOperator
    (h : SesquilinearCuspTailControl C) :
    IsCompactOperator C :=
  h.compactApproximation.isCompactOperator

end SesquilinearCuspTailControl

end SesquilinearCuspTail

/-! #### The compact-operator Fredholm alternative at μ = 1 -/

section FredholmCore

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]

/-- The normalized Fredholm operator I - K. -/
def fredholmDefect (K : X →L[ℂ] X) : X →L[ℂ] X :=
  1 - K

@[simp]
theorem fredholmDefect_apply (K : X →L[ℂ] X) (u : X) :
    fredholmDefect K u = u - K u := by
  simp [fredholmDefect]

/-- A unique fixed point at zero is exactly the kernel input needed for the
normalized operator. -/
theorem fredholmDefect_hasTrivialKernel_of_fixedPointUnique
    (K : X →L[ℂ] X)
    (hfixed : ∀ u, K u = u → u = 0) :
    HasTrivialKernel (fredholmDefect K) := by
  intro u hu
  apply hfixed u
  exact (sub_eq_zero.mp
    (by simpa only [fredholmDefect_apply] using hu)).symm

/-- A strict operator-norm contraction gives a concrete proof of kernel
triviality.  The general Fredholm theorem below does not assume contraction. -/
theorem fredholmDefect_hasTrivialKernel_of_norm_lt_one
    (K : X →L[ℂ] X) (hK : ‖K‖ < 1) :
    HasTrivialKernel (fredholmDefect K) := by
  apply fredholmDefect_hasTrivialKernel_of_fixedPointUnique K
  intro u hfixed
  by_contra hu
  have hu_pos : 0 < ‖u‖ := norm_pos_iff.mpr hu
  have hbound : ‖K u‖ ≤ ‖K‖ * ‖u‖ :=
    K.le_opNorm u
  rw [hfixed] at hbound
  have hstrict : ‖K‖ * ‖u‖ < ‖u‖ := by
    simpa using mul_lt_mul_of_pos_right hK hu_pos
  exact (not_lt_of_ge hbound) hstrict

/-- Triviality of ker (I-K) excludes the eigenvalue 1. -/
theorem not_hasEigenvalue_one_of_hasTrivialKernel
    (K : X →L[ℂ] X)
    (hker : HasTrivialKernel (fredholmDefect K)) :
    ¬ Module.End.HasEigenvalue (K : Module.End ℂ X) (1 : ℂ) := by
  intro h
  obtain ⟨u, hu⟩ := h.exists_hasEigenvector
  have hKu : K u = u := by
    simpa using hu.apply_eq_smul
  exact hu.2 (hker u (by simp [fredholmDefect, hKu]))

variable [CompleteSpace X]

/-- The right branch of mathlib's compact-operator Fredholm alternative. -/
theorem one_mem_resolventSet
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) :
    (1 : ℂ) ∈ resolventSet ℂ K :=
  (hcompact.hasEigenvalue_or_mem_resolventSet
      (μ := (1 : ℂ)) one_ne_zero).resolve_left
    (not_hasEigenvalue_one_of_hasTrivialKernel K hker)

/-- Fredholm alternative plus the trivial kernel makes I-K bijective. -/
theorem fredholmDefect_bijective
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) :
    Function.Bijective (fredholmDefect K) := by
  have hres := one_mem_resolventSet K hcompact hker
  have hunit : IsUnit (fredholmDefect K) := by
    simpa [fredholmDefect, Algebra.algebraMap_eq_smul_one] using
      (spectrum.mem_resolventSet_iff.mp hres)
  exact ContinuousLinearMap.isUnit_iff_bijective.mp hunit

/-- The continuous equivalence supplied by the Fredholm alternative. -/
noncomputable def fredholmEquiv
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) :
    X ≃L[ℂ] X :=
  ContinuousLinearEquiv.ofBijective (fredholmDefect K)
    hker.ker_eq_bot
    (LinearMap.range_eq_top.mpr
      (fredholmDefect_bijective K hcompact hker).2)

@[simp]
theorem fredholmEquiv_apply
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) (u : X) :
    fredholmEquiv K hcompact hker u = u - K u := by
  change fredholmDefect K u = u - K u
  exact fredholmDefect_apply K u

/-- The normalized inverse norm is recorded independently of every shifted
coercivity constant. -/
noncomputable def fredholmInverseNorm
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) : ℝ :=
  ‖(fredholmEquiv K hcompact hker).symm.toContinuousLinearMap‖

theorem fredholmInverseNorm_nonneg
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) :
    0 ≤ fredholmInverseNorm K hcompact hker :=
  norm_nonneg _

/-- Solution of the normalized equation (I-K)u=f. -/
noncomputable def fredholmSolve
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) (f : X) : X :=
  (fredholmEquiv K hcompact hker).symm f

theorem fredholmSolve_spec
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) (f : X) :
    fredholmDefect K (fredholmSolve K hcompact hker f) = f := by
  change
    fredholmEquiv K hcompact hker
        ((fredholmEquiv K hcompact hker).symm f) = f
  exact (fredholmEquiv K hcompact hker).apply_symm_apply f

theorem fredholmSolve_unique
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) (f : X)
    {u : X} (hu : fredholmDefect K u = f) :
    u = fredholmSolve K hcompact hker f := by
  apply sub_eq_zero.mp
  apply hker
  rw [map_sub, hu, fredholmSolve_spec, sub_self]

theorem fredholmSolve_norm_le
    (K : X →L[ℂ] X) (hcompact : IsCompactOperator K)
    (hker : HasTrivialKernel (fredholmDefect K)) (f : X) :
    ‖fredholmSolve K hcompact hker f‖ ≤
      fredholmInverseNorm K hcompact hker * ‖f‖ :=
  (fredholmEquiv K hcompact hker).symm.toContinuousLinearMap.le_opNorm f

end FredholmCore

/-! #### Preconditioned compact perturbations -/

/-- Data for the exact factorization of an unshifted operator through a
shifted continuous equivalence and a compact lower-order term. -/
structure ShiftedCompactDecomposition
    {V W : Type*}
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    [NormedAddCommGroup W] [NormedSpace ℂ W]
    (A : V →L[ℂ] W) where
  shiftedEquiv : V ≃L[ℂ] W
  lowerOrder : V →L[ℂ] W
  shifted_eq :
    shiftedEquiv.toContinuousLinearMap = A + lowerOrder
  lowerOrder_isCompact :
    IsCompactOperator lowerOrder

namespace ShiftedCompactDecomposition

variable {V W : Type*}
variable [NormedAddCommGroup V] [NormedSpace ℂ V]
variable [NormedAddCommGroup W] [NormedSpace ℂ W]
variable {A : V →L[ℂ] W}

/-- The normalized compact perturbation K = S⁻¹ C. -/
def compactPerturbation
    (d : ShiftedCompactDecomposition A) : V →L[ℂ] V :=
  d.shiftedEquiv.symm.toContinuousLinearMap.comp d.lowerOrder

/-- Compactness survives postcomposition by the shifted inverse. -/
theorem compactPerturbation_isCompact
    (d : ShiftedCompactDecomposition A) :
    IsCompactOperator d.compactPerturbation := by
  change IsCompactOperator
    (d.shiftedEquiv.symm.toContinuousLinearMap ∘ d.lowerOrder)
  exact d.lowerOrder_isCompact.clm_comp
    d.shiftedEquiv.symm.toContinuousLinearMap

theorem shifted_apply
    (d : ShiftedCompactDecomposition A) (u : V) :
    d.shiftedEquiv u = A u + d.lowerOrder u := by
  have h := congrArg (fun T : V →L[ℂ] W => T u) d.shifted_eq
  simpa using h

/-- The shifted operator sends K u back to the lower-order term. -/
theorem shifted_compactPerturbation_apply
    (d : ShiftedCompactDecomposition A) (u : V) :
    d.shiftedEquiv (d.compactPerturbation u) =
      d.lowerOrder u := by
  change d.shiftedEquiv
      (d.shiftedEquiv.symm (d.lowerOrder u)) =
    d.lowerOrder u
  exact d.shiftedEquiv.apply_symm_apply (d.lowerOrder u)

/-- Pointwise form of the exact preconditioned factorization
A = S (I-K). -/
theorem factorization_apply
    (d : ShiftedCompactDecomposition A) (u : V) :
    d.shiftedEquiv
        (fredholmDefect d.compactPerturbation u) =
      A u := by
  calc
    d.shiftedEquiv
        (fredholmDefect d.compactPerturbation u) =
        d.shiftedEquiv u -
          d.shiftedEquiv (d.compactPerturbation u) := by
      rw [fredholmDefect_apply, map_sub]
    _ = (A u + d.lowerOrder u) - d.lowerOrder u := by
      rw [d.shifted_apply, d.shifted_compactPerturbation_apply]
    _ = A u := add_sub_cancel_right _ _

/-- Operator form of A = S (I-K). -/
theorem factorization
    (d : ShiftedCompactDecomposition A) :
    d.shiftedEquiv.toContinuousLinearMap.comp
        (fredholmDefect d.compactPerturbation) = A := by
  ext u
  exact d.factorization_apply u

/-- The normalized and original homogeneous equations have exactly the same
kernel. -/
theorem defect_eq_zero_iff
    (d : ShiftedCompactDecomposition A) (u : V) :
    fredholmDefect d.compactPerturbation u = 0 ↔
      A u = 0 := by
  constructor
  · intro hu
    calc
      A u = d.shiftedEquiv
          (fredholmDefect d.compactPerturbation u) :=
        (d.factorization_apply u).symm
      _ = d.shiftedEquiv 0 := by rw [hu]
      _ = 0 := map_zero d.shiftedEquiv
  · intro hu
    apply d.shiftedEquiv.injective
    rw [d.factorization_apply, hu, map_zero]

/-- Fixed vectors of K are precisely homogeneous solutions of A. -/
theorem compactPerturbation_fixedPoint_iff
    (d : ShiftedCompactDecomposition A) (u : V) :
    d.compactPerturbation u = u ↔ A u = 0 := by
  constructor
  · intro hu
    apply (d.defect_eq_zero_iff u).1
    simp [fredholmDefect, hu]
  · intro hu
    have hzero := (d.defect_eq_zero_iff u).2 hu
    have hsub : u - d.compactPerturbation u = 0 := by
      simpa only [fredholmDefect_apply] using hzero
    exact (sub_eq_zero.mp hsub).symm

/-- Triviality of the original unshifted kernel proves triviality of the
normalized Fredholm kernel. -/
theorem normalized_hasTrivialKernel
    (d : ShiftedCompactDecomposition A)
    (hA : HasTrivialKernel A) :
    HasTrivialKernel (fredholmDefect d.compactPerturbation) := by
  intro u hu
  exact hA u ((d.defect_eq_zero_iff u).1 hu)

end ShiftedCompactDecomposition

/-- A complete Fredholm bypass package.  Its two substantive proof fields are
compactness of the lower-order term and triviality of the original unshifted
kernel; neither is hidden in a typeclass. -/
structure FredholmBypassData
    {V W : Type*}
    [NormedAddCommGroup V] [NormedSpace ℂ V]
    [NormedAddCommGroup W] [NormedSpace ℂ W]
    (A : V →L[ℂ] W)
    extends ShiftedCompactDecomposition A where
  unshiftedKernel : HasTrivialKernel A

namespace FredholmBypassData

variable {V W : Type*}
variable [NormedAddCommGroup V] [NormedSpace ℂ V]
variable [NormedAddCommGroup W] [NormedSpace ℂ W]
variable [CompleteSpace V]
variable {A : V →L[ℂ] W}

/-- The compact normalized perturbation carried by the bypass data. -/
def compactPerturbation (d : FredholmBypassData A) : V →L[ℂ] V :=
  d.toShiftedCompactDecomposition.compactPerturbation

theorem compactPerturbation_isCompact
    (d : FredholmBypassData A) :
    IsCompactOperator d.compactPerturbation :=
  d.toShiftedCompactDecomposition.compactPerturbation_isCompact

theorem normalized_hasTrivialKernel
    (d : FredholmBypassData A) :
    HasTrivialKernel (fredholmDefect d.compactPerturbation) :=
  d.toShiftedCompactDecomposition.normalized_hasTrivialKernel
    d.unshiftedKernel

/-- The normalized I-K equivalence obtained from mathlib's Fredholm
alternative. -/
noncomputable def normalizedEquiv
    (d : FredholmBypassData A) : V ≃L[ℂ] V :=
  fredholmEquiv d.compactPerturbation
    d.compactPerturbation_isCompact
    d.normalized_hasTrivialKernel

/-- The actual unshifted equivalence A : V ≃L W. -/
noncomputable def unshiftedEquiv
    (d : FredholmBypassData A) : V ≃L[ℂ] W :=
  d.normalizedEquiv.trans d.shiftedEquiv

@[simp]
theorem unshiftedEquiv_apply
    (d : FredholmBypassData A) (u : V) :
    d.unshiftedEquiv u = A u := by
  calc
    d.unshiftedEquiv u =
        d.shiftedEquiv
          (fredholmDefect d.compactPerturbation u) := by
      rfl
    _ = A u :=
      d.toShiftedCompactDecomposition.factorization_apply u

/-- Norm of the normalized Fredholm inverse (I-K)⁻¹. -/
noncomputable def normalizedInverseNorm
    (d : FredholmBypassData A) : ℝ :=
  ‖d.normalizedEquiv.symm.toContinuousLinearMap‖

theorem normalizedInverseNorm_nonneg
    (d : FredholmBypassData A) :
    0 ≤ d.normalizedInverseNorm :=
  norm_nonneg _

/-- The actual inverse continuous linear map of the unshifted operator. -/
noncomputable def solutionOperator
    (d : FredholmBypassData A) : W →L[ℂ] V :=
  d.unshiftedEquiv.symm.toContinuousLinearMap

/-- Norm of the actual unshifted inverse.  This is deliberately a second
constant, distinct from both shifted coercivity and the normalized inverse
norm. -/
noncomputable def inverseNorm
    (d : FredholmBypassData A) : ℝ :=
  ‖d.solutionOperator‖

theorem inverseNorm_nonneg
    (d : FredholmBypassData A) :
    0 ≤ d.inverseNorm :=
  norm_nonneg _

/-- The unshifted Fredholm solution. -/
noncomputable def solve
    (d : FredholmBypassData A) (F : W) : V :=
  d.solutionOperator F

theorem solve_spec
    (d : FredholmBypassData A) (F : W) :
    A (d.solve F) = F := by
  rw [← d.unshiftedEquiv_apply (d.solve F)]
  unfold solve solutionOperator
  exact d.unshiftedEquiv.apply_symm_apply F

theorem solve_unique
    (d : FredholmBypassData A) (F : W)
    {u : V} (hu : A u = F) :
    u = d.solve F := by
  apply sub_eq_zero.mp
  apply d.unshiftedKernel
  rw [map_sub, hu, d.solve_spec, sub_self]

theorem solve_existsUnique
    (d : FredholmBypassData A) (F : W) :
    ∃! u : V, A u = F := by
  refine ⟨d.solve F, d.solve_spec F, ?_⟩
  intro u hu
  exact d.solve_unique F hu

theorem solutionOperator_rightInverse
    (d : FredholmBypassData A) (F : W) :
    A (d.solutionOperator F) = F :=
  d.solve_spec F

theorem solutionOperator_leftInverse
    (d : FredholmBypassData A) (u : V) :
    d.solutionOperator (A u) = u := by
  exact (d.solve_unique (A u) rfl).symm

/-- Exact a-priori bound using the actual unshifted inverse norm. -/
theorem solve_norm_le
    (d : FredholmBypassData A) (F : W) :
    ‖d.solve F‖ ≤ d.inverseNorm * ‖F‖ :=
  d.solutionOperator.le_opNorm F

/-- Two-stage bound exposing the separate normalized Fredholm constant. -/
theorem solve_norm_le_normalized
    (d : FredholmBypassData A) (F : W) :
    ‖d.solve F‖ ≤
      d.normalizedInverseNorm * ‖d.shiftedEquiv.symm F‖ := by
  change
    ‖d.normalizedEquiv.symm (d.shiftedEquiv.symm F)‖ ≤
      ‖d.normalizedEquiv.symm.toContinuousLinearMap‖ *
        ‖d.shiftedEquiv.symm F‖
  exact d.normalizedEquiv.symm.toContinuousLinearMap.le_opNorm
    (d.shiftedEquiv.symm F)

end FredholmBypassData

/-! #### Bridge from the checklist 5.3 complex Lax--Milgram solver -/

section CoerciveReferenceBridge

variable {V : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V]
variable [CompleteSpace V]

/-- A coercive complex form is injective, using the already proved uniqueness
of the 5.3 solver. -/
theorem coerciveForm_injective
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S) :
    Function.Injective S := by
  intro u w huw
  have hu : u = solveWith α S hS (S w) := by
    apply solveWith_unique α S hS
    intro v
    exact congrArg (fun F : StrongAntiDual V => F v) huw
  have hw : w = solveWith α S hS (S w) := by
    apply solveWith_unique α S hS
    intro v
    rfl
  exact hu.trans hw.symm

/-- A coercive complex form is surjective by the 5.3 existence theorem. -/
theorem coerciveForm_surjective
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S) :
    Function.Surjective S := by
  intro F
  exact ⟨solveWith α S hS F,
    solveWith_operator_spec α S hS F⟩

/-- The bundled shifted equivalence used for Fredholm preconditioning. -/
noncomputable def coerciveFormEquiv
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S) :
    V ≃L[ℂ] StrongAntiDual V :=
  ContinuousLinearEquiv.ofBijective S
    (LinearMap.ker_eq_bot.mpr
      (coerciveForm_injective α S hS))
    (LinearMap.range_eq_top.mpr
      (coerciveForm_surjective α S hS))

@[simp]
theorem coerciveFormEquiv_apply
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S) (u : V) :
    coerciveFormEquiv α S hS u = S u :=
  rfl

/-- The inverse of the bundled form equivalence is the same solution
characterized by the 5.3 solver. -/
theorem coerciveFormEquiv_symm_apply
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S)
    (F : StrongAntiDual V) :
    (coerciveFormEquiv α S hS).symm F =
      solveWith α S hS F := by
  apply (coerciveFormEquiv α S hS).injective
  calc
    coerciveFormEquiv α S hS
        ((coerciveFormEquiv α S hS).symm F) = F :=
      (coerciveFormEquiv α S hS).apply_symm_apply F
    _ = S (solveWith α S hS F) :=
      (solveWith_operator_spec α S hS F).symm
    _ = coerciveFormEquiv α S hS
        (solveWith α S hS F) := rfl

/-- The shifted inverse retains the sharp 5.3 coercivity estimate. -/
theorem coerciveFormEquiv_symm_norm_le
    (α : ℝ) (S : ContinuousSesquilinearForm V)
    (hS : ComplexCoerciveWith α S)
    (F : StrongAntiDual V) :
    ‖(coerciveFormEquiv α S hS).symm F‖ ≤
      α⁻¹ * ‖F‖ := by
  rw [coerciveFormEquiv_symm_apply]
  exact solveWith_norm_le α S hS F

/-- Package a shifted form using exactly the compactness assumption needed by
Fredholm: compactness of the actual lower-order term (lam : ℂ) • mass.  This
formulation also covers lam = 0 without asking for compactness of mass itself. -/
noncomputable def shiftedFredholmDataOfCompactLowerOrder
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hLower : IsCompactOperator ((lam : ℂ) • mass))
    (hker : HasTrivialKernel A) :
    FredholmBypassData A where
  shiftedEquiv :=
    coerciveFormEquiv α (shiftedForm A mass lam) hShift
  lowerOrder := (lam : ℂ) • mass
  shifted_eq := by
    ext u v
    change shiftedForm A mass lam u v =
      (A + (lam : ℂ) • mass) u v
    simp [shiftedForm]
  lowerOrder_isCompact := hLower
  unshiftedKernel := hker

/-- Convenient wrapper when compactness of the unscaled mass operator is
available. -/
noncomputable def shiftedFredholmData
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A) :
    FredholmBypassData A :=
  shiftedFredholmDataOfCompactLowerOrder α A mass lam hShift
    (by simpa using hmass.smul (lam : ℂ)) hker

/-- A concrete cusp-tail certificate supplies the compactness input required
by the shifted Fredholm package. -/
noncomputable def shiftedFredholmDataOfCuspTail
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (htail : SesquilinearCuspTailControl mass)
    (hker : HasTrivialKernel A) :
    FredholmBypassData A :=
  shiftedFredholmData α A mass lam hShift
    htail.isCompactOperator hker

@[simp]
theorem shiftedFredholmData_shiftedEquiv_symm_apply
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A)
    (F : StrongAntiDual V) :
    (shiftedFredholmData α A mass lam hShift hmass hker).shiftedEquiv.symm F =
      solveWith α (shiftedForm A mass lam) hShift F := by
  change
    (coerciveFormEquiv α (shiftedForm A mass lam) hShift).symm F =
      solveWith α (shiftedForm A mass lam) hShift F
  exact coerciveFormEquiv_symm_apply α
    (shiftedForm A mass lam) hShift F

/-- The final unshifted solution obtained by the corrected Fredholm route. -/
noncomputable def solveOfShiftedForm
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A)
    (F : StrongAntiDual V) : V :=
  (shiftedFredholmData α A mass lam hShift hmass hker).solve F

/-- Unlike the raw shifted solver, the Fredholm solution satisfies the
original unshifted equation. -/
theorem solveOfShiftedForm_spec
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A)
    (F : StrongAntiDual V) :
    A (solveOfShiftedForm α A mass lam hShift hmass hker F) = F :=
  (shiftedFredholmData α A mass lam hShift hmass hker).solve_spec F

theorem solveOfShiftedForm_existsUnique
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A)
    (F : StrongAntiDual V) :
    ∃! u : V, A u = F :=
  (shiftedFredholmData α A mass lam hShift hmass hker).solve_existsUnique F

/-- Two-stage estimate.  The new normalized inverse norm is not replaced by
the shifted coercivity constant. -/
theorem solveOfShiftedForm_norm_le
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A)
    (F : StrongAntiDual V) :
    ‖solveOfShiftedForm α A mass lam hShift hmass hker F‖ ≤
      (shiftedFredholmData α A mass lam hShift hmass hker).normalizedInverseNorm *
        (α⁻¹ * ‖F‖) := by
  let d := shiftedFredholmData α A mass lam hShift hmass hker
  calc
    ‖solveOfShiftedForm α A mass lam hShift hmass hker F‖ ≤
        d.normalizedInverseNorm * ‖d.shiftedEquiv.symm F‖ :=
      d.solve_norm_le_normalized F
    _ ≤ d.normalizedInverseNorm * (α⁻¹ * ‖F‖) :=
      mul_le_mul_of_nonneg_left
        (by
          rw [shiftedFredholmData_shiftedEquiv_symm_apply]
          exact solveWith_norm_le α
            (shiftedForm A mass lam) hShift F)
        d.normalizedInverseNorm_nonneg

/-- The actual unshifted inverse norm is bounded by the product of the
normalized Fredholm constant and the shifted coercive bound. -/
theorem shiftedFredholm_inverseNorm_le
    (α : ℝ)
    (A mass : ContinuousSesquilinearForm V) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A mass lam))
    (hmass : IsCompactOperator mass)
    (hker : HasTrivialKernel A) :
    (shiftedFredholmData α A mass lam hShift hmass hker).inverseNorm ≤
      (shiftedFredholmData α A mass lam hShift hmass hker).normalizedInverseNorm *
        α⁻¹ := by
  let d := shiftedFredholmData α A mass lam hShift hmass hker
  apply d.solutionOperator.opNorm_le_bound
    (mul_nonneg d.normalizedInverseNorm_nonneg
      (inv_nonneg.mpr hShift.1.le))
  intro F
  calc
    ‖d.solutionOperator F‖ = ‖d.solve F‖ := rfl
    _ ≤ d.normalizedInverseNorm * ‖d.shiftedEquiv.symm F‖ :=
      d.solve_norm_le_normalized F
    _ ≤ d.normalizedInverseNorm * (α⁻¹ * ‖F‖) :=
      mul_le_mul_of_nonneg_left
        (by
          rw [shiftedFredholmData_shiftedEquiv_symm_apply]
          exact solveWith_norm_le α
            (shiftedForm A mass lam) hShift F)
        d.normalizedInverseNorm_nonneg
    _ = (d.normalizedInverseNorm * α⁻¹) * ‖F‖ :=
      (mul_assoc _ _ _).symm

end CoerciveReferenceBridge

/-! #### Closed-range Fredholm alternative with a possibly nontrivial kernel

The bijective package above is the correct endpoint when the unshifted kernel
is zero.  It is not the general Fredholm alternative.  In the latter, the
forcing term must be orthogonal to the adjoint kernel and the solution is
unique only after imposing orthogonality to the original kernel.

Mathlib's current compact-operator alternative supplies invertibility when the
kernel is trivial, but does not directly export the nontrivial-kernel
closed-range theorem.  We prove that missing step below by a compactness
argument on the kernel orthogonal complement.  The adjoint-kernel
compatibility condition, canonical kernel-orthogonal solution, all solutions
modulo the kernel, and the actual reduced-inverse norm then follow without any
trivial-kernel or closed-range certificate hypothesis.
-/

section NontrivialKernelAlternative

variable {V W : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℂ V] [CompleteSpace V]
variable [NormedAddCommGroup W] [InnerProductSpace ℂ W] [CompleteSpace W]
variable {A : V →L[ℂ] W}

/-! #### Closed range of `I - K` without a trivial-kernel hypothesis

The usual compact-operator alternative only gives a global inverse when the
kernel is zero.  For the general Fredholm alternative we instead restrict
`I - K` to the orthogonal complement of its kernel.  Compactness rules out an
approximate null sequence on this complement: after passing to a subsequence,
compactness of `K` makes the vectors themselves converge, while their limit
lies simultaneously in the kernel and its orthogonal complement.  This gives
the lower bound needed for closed range.
-/

variable {X : Type*}
variable [NormedAddCommGroup X] [InnerProductSpace ℂ X] [CompleteSpace X]

/-- The Fredholm defect restricted to the orthogonal complement of its full
kernel.  The codomain is deliberately the ambient Hilbert space; no
self-adjointness or invariance of the complement is assumed. -/
noncomputable def fredholmDefectKernelComplementRestriction (K : X →L[ℂ] X) :
    (fredholmDefect K).kerᗮ →L[ℂ] X :=
  (fredholmDefect K).comp (fredholmDefect K).kerᗮ.subtypeL

@[simp]
theorem fredholmDefectKernelComplementRestriction_apply
    (K : X →L[ℂ] X) (u : (fredholmDefect K).kerᗮ) :
    fredholmDefectKernelComplementRestriction K u =
      fredholmDefect K (u : X) :=
  rfl

/-- The kernel-complement restriction is injective even when `I - K` has a
nontrivial kernel. -/
theorem fredholmDefectKernelComplementRestriction_injective
    (K : X →L[ℂ] X) :
    Function.Injective (fredholmDefectKernelComplementRestriction K) := by
  intro u v huv
  apply Subtype.ext
  have hImage : fredholmDefect K (u : X) =
      fredholmDefect K (v : X) := by
    simpa only [fredholmDefectKernelComplementRestriction_apply] using huv
  have hKer : (u : X) - (v : X) ∈ (fredholmDefect K).ker := by
    change fredholmDefect K ((u : X) - (v : X)) = 0
    rw [map_sub, hImage, sub_self]
  have hOrth : (u : X) - (v : X) ∈ (fredholmDefect K).kerᗮ :=
    Submodule.sub_mem _ u.property v.property
  have hZero : (u : X) - (v : X) = 0 := by
    exact (inner_self_eq_zero (𝕜 := ℂ)).mp
      ((fredholmDefect K).ker.inner_right_of_mem_orthogonal hKer hOrth)
  exact sub_eq_zero.mp hZero

/-- Compactness supplies an anti-Lipschitz estimate on the entire orthogonal
complement of the Fredholm kernel.  This is the analytic core of the
nontrivial-kernel closed-range theorem. -/
theorem fredholmDefectKernelComplementRestriction_antilipschitz
    (K : X →L[ℂ] X) (hK : IsCompactOperator K) :
    ∃ C, AntilipschitzWith C
      (fredholmDefectKernelComplementRestriction K) := by
  rw [antilipschitzWith_iff_exists_mul_le_norm]
  by_contra! hLower
  let S : X →L[ℂ] X := fredholmDefect K
  let R : S.kerᗮ →L[ℂ] X :=
    fredholmDefectKernelComplementRestriction K
  change ∀ c > 0, ∃ x, ‖R x‖ < c * ‖x‖ at hLower

  /- Rescale the approximate null vectors into one fixed shell.  Keeping a
  positive lower norm bound is what makes the limiting contradiction exact. -/
  have hShell : ∃ c > 0, ∀ ε > 0, ∃ x : S.kerᗮ,
      ‖x‖ ≤ 1 ∧ c ≤ ‖x‖ ∧ ‖R x‖ < ε := by
    obtain ⟨a, ha⟩ := NormedField.exists_one_lt_norm ℂ
    refine ⟨‖a‖⁻¹, by positivity, fun ε hε ↦ ?_⟩
    obtain ⟨x, hx⟩ := hLower ε (by positivity)
    have hx0 : x ≠ 0 := by aesop
    obtain ⟨η, hη, hOne, hLowerNorm, hUpperNorm⟩ :=
      rescale_to_shell ha (ε := 1) (by simp) hx0
    refine ⟨η • x, hOne.le, by simpa using hLowerNorm, ?_⟩
    grw [map_smul, norm_smul, hx, mul_left_comm, ← norm_smul]
    linear_combination ε * hOne

  obtain ⟨c, hc, hcShell⟩ := hShell
  obtain ⟨φ, hφAnti, hφPos, hφ⟩ :=
    exists_seq_strictAnti_tendsto (0 : ℝ)
  have hxExists (n : ℕ) : ∃ x : S.kerᗮ,
      ‖x‖ ≤ 1 ∧ c ≤ ‖x‖ ∧ ‖R x‖ < φ n :=
    hcShell (φ n) (hφPos n)
  choose x hxNormUpper hxNormLower hxDefect using hxExists
  have hDefectTendsto : Filter.Tendsto (fun n ↦ R (x n)) Filter.atTop (nhds 0) :=
    squeeze_zero_norm (by grind) hφ

  /- A compact subsequence of `K x_n` is also a convergent subsequence of
  `x_n`, because `(I-K)x_n → 0`. -/
  let ySeq (n : ℕ) : X := K (x n : X)
  obtain ⟨C, hCCompact, hCContains⟩ :=
    hK.image_closedBall_subset_compact 1
  obtain ⟨y, hyC, ψ, hψ, hKy⟩ :=
    hCCompact.tendsto_subseq (x := ySeq)
      (fun n ↦ hCContains
        ⟨(x n : X), by simpa using hxNormUpper n, rfl⟩)
  have hxTendsto : Filter.Tendsto (fun n ↦ (x (ψ n) : X)) Filter.atTop (nhds y) := by
    have hSum := (hDefectTendsto.comp hψ.tendsto_atTop).add hKy
    change Filter.Tendsto
      (fun n => R (x (ψ n)) + ySeq (ψ n))
      Filter.atTop (nhds (0 + y)) at hSum
    have hfun :
        (fun n => R (x (ψ n)) + ySeq (ψ n)) =
          (fun n => (x (ψ n) : X)) := by
      funext n
      change
        ((x (ψ n) : X) - K (x (ψ n) : X)) +
            K (x (ψ n) : X) = (x (ψ n) : X)
      exact sub_add_cancel _ _
    rw [hfun] at hSum
    simpa only [zero_add] using hSum

  /- Closedness of the orthogonal complement and continuity of `I-K` put the
  limit in both complementary subspaces. -/
  have hyOrth : y ∈ S.kerᗮ := by
    apply S.ker.isClosed_orthogonal.mem_of_tendsto hxTendsto
    exact Filter.Eventually.of_forall fun n ↦ (x (ψ n)).property
  have hDefectSubseq :
      Filter.Tendsto (fun n ↦ S (x (ψ n) : X)) Filter.atTop (nhds 0) := by
    change Filter.Tendsto
      ((fun n => S (x n : X)) ∘ ψ) Filter.atTop (nhds 0)
    simpa only [S, R,
      fredholmDefectKernelComplementRestriction_apply] using
      hDefectTendsto.comp hψ.tendsto_atTop
  have hyKerEq : S y = 0 := by
    apply tendsto_nhds_unique _ hDefectSubseq
    change Filter.Tendsto
      (S ∘ fun n => (x (ψ n) : X)) Filter.atTop (nhds (S y))
    exact S.continuous.continuousAt.tendsto.comp hxTendsto
  have hyKer : y ∈ S.ker := hyKerEq
  have hyZero : y = 0 := by
    apply (inner_self_eq_zero (𝕜 := ℂ)).mp
    exact S.ker.inner_right_of_mem_orthogonal hyKer hyOrth

  /- The shell lower bound forbids convergence to zero. -/
  have hyNe : y ≠ 0 := by
    rintro rfl
    rw [NormedAddGroup.tendsto_nhds_zero] at hxTendsto
    have hSmall := hxTendsto c hc
    obtain ⟨n, hn⟩ := hSmall.exists
    exact (not_lt_of_ge (by simpa using hxNormLower (ψ n))) hn
  exact hyNe hyZero

/-- Restriction to the kernel complement does not change the actual range of
`I-K`. -/
theorem fredholmDefectKernelComplementRestriction_range
    (K : X →L[ℂ] X) :
    (fredholmDefectKernelComplementRestriction K).range =
      (fredholmDefect K).range := by
  apply le_antisymm
  · rintro y ⟨u, rfl⟩
    exact ⟨(u : X), rfl⟩
  · rintro y ⟨u, rfl⟩
    obtain ⟨p, hp, z, hz, huz⟩ :=
      (fredholmDefect K).ker.exists_add_mem_mem_orthogonal u
    have hp0 : fredholmDefect K p = 0 := hp
    refine ⟨⟨z, hz⟩, ?_⟩
    change fredholmDefect K z = fredholmDefect K u
    calc
      fredholmDefect K z = fredholmDefect K (p + z) := by
        symm
        rw [map_add, hp0, zero_add]
      _ = fredholmDefect K u := by rw [← huz]

/-- A compact perturbation of the identity has closed range, with no
assumption on the dimension or triviality of its kernel. -/
theorem fredholmDefect_range_isClosed
    (K : X →L[ℂ] X) (hK : IsCompactOperator K) :
    IsClosed ((fredholmDefect K).range : Set X) := by
  let R := fredholmDefectKernelComplementRestriction K
  have hRInjective : Function.Injective R :=
    fredholmDefectKernelComplementRestriction_injective K
  have hRAnti : ∃ C, AntilipschitzWith C R :=
    fredholmDefectKernelComplementRestriction_antilipschitz K hK
  have hRSetClosed : IsClosed (Set.range R) :=
    (R.isClosed_range_iff_antilipschitz_of_injective hRInjective).2 hRAnti
  have hSetRange : Set.range R = (R.range : Set X) := by
    ext y
    constructor <;> rintro ⟨x, rfl⟩ <;> exact ⟨x, rfl⟩
  have hRRangeClosed : IsClosed (R.range : Set X) := by
    rw [← hSetRange]
    exact hRSetClosed
  rw [← fredholmDefectKernelComplementRestriction_range K]
  exact hRRangeClosed

/-- Closed range transports through the exact shifted factorization
`A = S (I-K)`.  Thus compact lower order is sufficient; no separate
closed-range certificate is needed. -/
theorem ShiftedCompactDecomposition.range_isClosed
    (d : ShiftedCompactDecomposition A) :
    IsClosed (A.range : Set W) := by
  have hDefectClosed :
      IsClosed
        ((fredholmDefect d.compactPerturbation).range : Set V) :=
    fredholmDefect_range_isClosed d.compactPerturbation
      d.compactPerturbation_isCompact
  have hRange : (A.range : Set W) =
      d.shiftedEquiv ''
        ((fredholmDefect d.compactPerturbation).range : Set V) := by
    ext w
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨fredholmDefect d.compactPerturbation u, ⟨u, rfl⟩,
        d.factorization_apply u⟩
    · rintro ⟨v, ⟨u, rfl⟩, rfl⟩
      exact ⟨u, (d.factorization_apply u).symm⟩
  rw [hRange]
  exact d.shiftedEquiv.toHomeomorph.isClosedMap _ hDefectClosed

/-- A compactly preconditioned Fredholm operator in the possibly
nontrivial-kernel branch.  Closed range is now a theorem of the compact
decomposition, not an additional certificate field. -/
structure NontrivialKernelFredholmData (A : V →L[ℂ] W)
    extends ShiftedCompactDecomposition A where

namespace NontrivialKernelFredholmData

/-- Closed range follows unconditionally from compact preconditioning. -/
theorem range_isClosed (d : NontrivialKernelFredholmData A) :
    IsClosed (A.range : Set W) :=
  d.toShiftedCompactDecomposition.range_isClosed

/-- The restriction of `A` from the orthogonal complement of its kernel to its
actual range. -/
noncomputable def kernelComplementRestriction (d : NontrivialKernelFredholmData A) :
    A.kerᗮ →L[ℂ] A.range :=
  (A.comp A.kerᗮ.subtypeL).codRestrict A.range
    (fun u => ⟨(u : V), rfl⟩)

@[simp]
theorem kernelComplementRestriction_apply
    (d : NontrivialKernelFredholmData A) (u : A.kerᗮ) :
    ((d.kernelComplementRestriction u : A.range) : W) = A (u : V) :=
  rfl

/-- The kernel-complement restriction is injective without assuming that the
original kernel is trivial. -/
theorem kernelComplementRestriction_injective
    (d : NontrivialKernelFredholmData A) :
    Function.Injective d.kernelComplementRestriction := by
  intro u v huv
  apply Subtype.ext
  have hAuAv : A (u : V) = A (v : V) :=
    congrArg (fun y : A.range => (y : W)) huv
  have hker : (u : V) - (v : V) ∈ A.ker := by
    change A ((u : V) - (v : V)) = 0
    rw [map_sub, hAuAv, sub_self]
  have horth : (u : V) - (v : V) ∈ A.kerᗮ :=
    Submodule.sub_mem _ u.property v.property
  have hzero : (u : V) - (v : V) = 0 := by
    apply (inner_self_eq_zero (𝕜 := ℂ)).mp
    exact A.ker.inner_right_of_mem_orthogonal hker horth
  exact sub_eq_zero.mp hzero

/-- Every vector in the range has a preimage orthogonal to the kernel. -/
theorem kernelComplementRestriction_surjective
    (d : NontrivialKernelFredholmData A) :
    Function.Surjective d.kernelComplementRestriction := by
  intro y
  rcases y.property with ⟨u, hu⟩
  obtain ⟨p, hp, z, hz, huz⟩ := A.ker.exists_add_mem_mem_orthogonal u
  have hp0 : A p = 0 := hp
  refine ⟨⟨z, hz⟩, ?_⟩
  apply Subtype.ext
  change A z = (y : W)
  calc
    A z = A (p + z) := by
      symm
      rw [map_add, hp0, zero_add]
    _ = A u := by rw [← huz]
    _ = (y : W) := hu

/-- Banach's inverse theorem upgrades the algebraic reduced inverse to a
continuous equivalence between `ker(A)ᗮ` and `range(A)`. -/
noncomputable def kernelComplementEquivRange
    (d : NontrivialKernelFredholmData A) :
    A.kerᗮ ≃L[ℂ] A.range := by
  letI : CompleteSpace A.range := d.range_isClosed.completeSpace_coe
  exact ContinuousLinearEquiv.ofBijective d.kernelComplementRestriction
    (LinearMap.ker_eq_bot.mpr d.kernelComplementRestriction_injective)
    (LinearMap.range_eq_top.mpr d.kernelComplementRestriction_surjective)

@[simp]
theorem kernelComplementEquivRange_apply
    (d : NontrivialKernelFredholmData A) (u : A.kerᗮ) :
    ((d.kernelComplementEquivRange u : A.range) : W) = A (u : V) :=
  rfl

/-- The canonical solution operator takes compatible forcing terms (elements
of the actual range) to the unique solution orthogonal to `ker A`. -/
noncomputable def canonicalSolutionOperator
    (d : NontrivialKernelFredholmData A) : A.range →L[ℂ] V :=
  A.kerᗮ.subtypeL.comp
    d.kernelComplementEquivRange.symm.toContinuousLinearMap

/-- Canonical kernel-orthogonal solution for a compatible forcing term. -/
noncomputable def canonicalSolution
    (d : NontrivialKernelFredholmData A) (f : A.range) : V :=
  d.canonicalSolutionOperator f

@[simp]
theorem canonicalSolution_eq
    (d : NontrivialKernelFredholmData A) (f : A.range) :
    d.canonicalSolution f =
      (d.kernelComplementEquivRange.symm f : A.kerᗮ) :=
  rfl

/-- The canonical solution satisfies the original unshifted equation. -/
theorem canonicalSolution_spec
    (d : NontrivialKernelFredholmData A) (f : A.range) :
    A (d.canonicalSolution f) = (f : W) := by
  change A ((d.kernelComplementEquivRange.symm f : A.kerᗮ) : V) = (f : W)
  exact congrArg (fun y : A.range => (y : W))
    (d.kernelComplementEquivRange.apply_symm_apply f)

/-- The normalization condition is membership in the orthogonal complement of
the entire kernel, not merely orthogonality to a chosen basis. -/
theorem canonicalSolution_mem_kernelOrthogonal
    (d : NontrivialKernelFredholmData A) (f : A.range) :
    d.canonicalSolution f ∈ A.kerᗮ :=
  (d.kernelComplementEquivRange.symm f).property

/-- Uniqueness holds exactly after imposing the kernel-orthogonality
normalization. -/
theorem canonicalSolution_unique
    (d : NontrivialKernelFredholmData A) (f : A.range)
    {u : V} (hu : A u = (f : W)) (huOrth : u ∈ A.kerᗮ) :
    u = d.canonicalSolution f := by
  let uOrth : A.kerᗮ := ⟨u, huOrth⟩
  have hsub : uOrth = d.kernelComplementEquivRange.symm f := by
    apply d.kernelComplementEquivRange.injective
    apply Subtype.ext
    exact hu.trans (d.canonicalSolution_spec f).symm
  exact congrArg (fun z : A.kerᗮ => (z : V)) hsub

/-- Every solution is the canonical solution plus an arbitrary kernel vector,
and every such translate is a solution. -/
theorem solves_iff_canonical_add_kernel
    (d : NontrivialKernelFredholmData A) (f : A.range) (u : V) :
    A u = (f : W) ↔
      ∃ n : V, n ∈ A.ker ∧ u = d.canonicalSolution f + n := by
  constructor
  · intro hu
    refine ⟨u - d.canonicalSolution f, ?_, by abel⟩
    change A (u - d.canonicalSolution f) = 0
    rw [map_sub, hu, d.canonicalSolution_spec, sub_self]
  · rintro ⟨n, hn, rfl⟩
    have hn0 : A n = 0 := hn
    rw [map_add, d.canonicalSolution_spec, hn0, add_zero]

/-- The exact range-orthogonality identity, valid before using closedness. -/
theorem range_orthogonal_eq_adjointKernel
    (d : NontrivialKernelFredholmData A) :
    A.rangeᗮ = (ContinuousLinearMap.adjoint A).ker :=
  A.orthogonal_range

/-- Closedness turns the density statement into the exact Fredholm range
identity `range(A) = ker(A†)ᗮ`. -/
theorem range_eq_orthogonal_adjointKernel
    (d : NontrivialKernelFredholmData A) :
    A.range = (ContinuousLinearMap.adjoint A).kerᗮ := by
  rw [← A.orthogonal_range,
    Submodule.orthogonal_orthogonal_eq_closure,
    d.range_isClosed.submodule_topologicalClosure_eq]

/-- Fredholm solvability condition for arbitrary forcing terms. -/
theorem solvable_iff_mem_orthogonal_adjointKernel
    (d : NontrivialKernelFredholmData A) (f : W) :
    (∃ u : V, A u = f) ↔
      f ∈ (ContinuousLinearMap.adjoint A).kerᗮ := by
  change f ∈ A.range ↔ _
  rw [d.range_eq_orthogonal_adjointKernel]

/-- Equivalent pointwise orthogonality formulation of the compatibility
condition. -/
theorem solvable_iff_forall_adjointKernel_inner_eq_zero
    (d : NontrivialKernelFredholmData A) (f : W) :
    (∃ u : V, A u = f) ↔
      ∀ w : W, ContinuousLinearMap.adjoint A w = 0 → inner ℂ w f = 0 := by
  rw [d.solvable_iff_mem_orthogonal_adjointKernel]
  change
    f ∈ (ContinuousLinearMap.adjoint A).kerᗮ ↔
      ∀ w : W, w ∈ (ContinuousLinearMap.adjoint A).ker → inner ℂ w f = 0
  exact (ContinuousLinearMap.adjoint A).ker.mem_orthogonal f

/-- The reduced inverse norm is the actual operator norm of the canonical
solution operator, distinct from the shifted coercivity constant. -/
noncomputable def canonicalInverseNorm
    (d : NontrivialKernelFredholmData A) : ℝ :=
  ‖d.canonicalSolutionOperator‖

theorem canonicalInverseNorm_nonneg
    (d : NontrivialKernelFredholmData A) :
    0 ≤ d.canonicalInverseNorm := by
  change 0 ≤ ‖d.canonicalSolutionOperator‖
  exact norm_nonneg
    (d.canonicalSolutionOperator : A.range →L[ℂ] V)

/-- Sharp operator-norm a-priori estimate on the compatible range. -/
theorem canonicalSolution_norm_le
    (d : NontrivialKernelFredholmData A) (f : A.range) :
    ‖d.canonicalSolution f‖ ≤ d.canonicalInverseNorm * ‖f‖ :=
  d.canonicalSolutionOperator.le_opNorm f

/-- The compact normalized perturbation remains available in the
nontrivial-kernel branch. -/
theorem compactPerturbation_isCompact
    (d : NontrivialKernelFredholmData A) :
    IsCompactOperator d.toShiftedCompactDecomposition.compactPerturbation :=
  d.toShiftedCompactDecomposition.compactPerturbation_isCompact

/-- The exact shifted factorization is retained without a kernel-triviality
assumption. -/
theorem factorization
    (d : NontrivialKernelFredholmData A) :
    d.shiftedEquiv.toContinuousLinearMap.comp
        (fredholmDefect
          d.toShiftedCompactDecomposition.compactPerturbation) = A :=
  d.toShiftedCompactDecomposition.factorization

/-- Every shifted compact decomposition canonically enters the general
nontrivial-kernel Fredholm package; closed range is derived internally. -/
def ofShiftedCompactDecomposition
    (d : ShiftedCompactDecomposition A) :
    NontrivialKernelFredholmData A where
  shiftedEquiv := d.shiftedEquiv
  lowerOrder := d.lowerOrder
  shifted_eq := d.shifted_eq
  lowerOrder_isCompact := d.lowerOrder_isCompact

end NontrivialKernelFredholmData

end NontrivialKernelAlternative

end FredholmBypass


/-! ### P0.3: typed weight shifts and the missing averaging coefficient -/

section TypedWeightOperators

/-- The index is a doubled weight: index `w` represents physical weight
`w / 2`. Raising and lowering therefore move the index by four.
-/
structure WeightShiftOperators (W : ℤ → Type*) where
  raise : ∀ w, W w → W (w + 4)
  lower : ∀ w, W w → W (w - 4)

namespace WeightShiftOperators

variable {W : ℤ → Type*}

/-- Only the type-correct lower-after-raise composition is admitted. -/
def lowerRaise (O : WeightShiftOperators W) (w : ℤ) (u : W w) : W w := by
  simpa only [add_sub_cancel_right] using O.lower (w + 4) (O.raise w u)

/-- Only the type-correct raise-after-lower composition is admitted. -/
def raiseLower (O : WeightShiftOperators W) (w : ℤ) (u : W w) : W w := by
  simpa only [sub_add_cancel] using O.raise (w - 4) (O.lower w u)

end WeightShiftOperators

/-- Averaging two Green identities necessarily averages their bulk and
boundary terms. The factor `1/2` cannot be discarded.
-/
theorem average_two_green_identities
    {lhs raiseTerm lowerTerm boundaryR boundaryL : ℂ}
    (hR : lhs = raiseTerm + boundaryR)
    (hL : lhs = lowerTerm + boundaryL) :
    lhs = (raiseTerm + lowerTerm) / 2 + (boundaryR + boundaryL) / 2 := by
  have hsum : lhs + lhs =
      (raiseTerm + boundaryR) + (lowerTerm + boundaryL) :=
    congrArg₂ (fun z w : ℂ => z + w) hR hL
  calc
    lhs = (lhs + lhs) / 2 := by ring
    _ = ((raiseTerm + boundaryR) + (lowerTerm + boundaryL)) / 2 := by
      exact congrArg (fun z : ℂ => z / 2) hsum
    _ = (raiseTerm + lowerTerm) / 2 +
        (boundaryR + boundaryL) / 2 := by ring

/-- The half-weight factorization constants in the corrected unitary
convention are numerically distinct; they cannot both be silently set to zero.
-/
theorem halfWeight_factorization_constants :
    ((1 / 2 : ℚ) * (1 / 2 + 2) / 4 = 5 / 16) ∧
      ((1 / 2 : ℚ) * (1 / 2 - 2) / 4 = -3 / 16) := by
  norm_num

/-- After inserting the signs in the two corrected factorizations, their
average contributes the nonzero mass shift `-1/16`. -/
theorem halfWeight_averaged_factorization_shift :
    ((-(5 / 16 : ℚ) + 3 / 16) / 2) = (-1 / 16 : ℚ) := by
  norm_num

end TypedWeightOperators

/-! ### P0.4: pointwise cutoffs, covers, and dense exhaustions -/

section CutoffQuantifiers

/-- Exact logical model of the valid compact-support statement
`∀ v, ∃ Y(v), support v ⊆ F_Y`.
-/
theorem pointwise_cutoff_exists : ∀ n : ℕ, ∃ Y : ℕ, n ≤ Y :=
  fun n => ⟨n, le_rfl⟩

/-- There is no single finite cutoff that contains every index. -/
theorem no_uniform_finite_cutoff : ¬ ∃ Y : ℕ, ∀ n : ℕ, n ≤ Y := by
  rintro ⟨Y, hY⟩
  have := hY (Y + 1)
  omega

/-- Hence exchanging `∀ v, ∃ Y(v)` with `∃ Y, ∀ v` is invalid. -/
theorem pointwise_cutoff_does_not_give_uniform_cutoff :
    (∀ n : ℕ, ∃ Y : ℕ, n ≤ Y) ∧
      ¬ ∃ Y : ℕ, ∀ n : ℕ, n ≤ Y :=
  ⟨pointwise_cutoff_exists, no_uniform_finite_cutoff⟩

variable {E ι : Type*}

theorem iUnion_eq_core_of_subset_of_cover {D : Set E} {C : ι → Set E}
    (hSub : ∀ i, C i ⊆ D)
    (hCover : ∀ x ∈ D, ∃ i, x ∈ C i) :
    (⋃ i, C i) = D := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_iUnion.mp hx with ⟨i, hxi⟩
    exact hSub i hxi
  · intro hx
    rcases hCover x hx with ⟨i, hxi⟩
    exact Set.mem_iUnion.mpr ⟨i, hxi⟩

theorem dense_iUnion_of_dense_core [TopologicalSpace E]
    {D : Set E} {C : ι → Set E}
    (hDense : Dense D) (hSub : ∀ i, C i ⊆ D)
    (hCover : ∀ x ∈ D, ∃ i, x ∈ C i) :
    Dense (⋃ i, C i) := by
  rw [iUnion_eq_core_of_subset_of_cover hSub hCover]
  exact hDense

variable [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Corrected norm exhaustion from a dense core together with a genuine cover
of that core. No fixed finite member is substituted for the outer supremum.
-/
theorem dual_norm_eq_iSup_coreRatio_of_dense_cover
    (D : Set E) (C : ι → Set E) (f : StrongDual ℂ E)
    (hDense : Dense D) (hSub : ∀ i, C i ⊆ D)
    (hCover : ∀ x ∈ D, ∃ i, x ∈ C i) :
    ‖f‖ = ⨆ i, coreRatioNorm (C i) f :=
  dual_norm_eq_iSup_coreRatio C
    (dense_iUnion_of_dense_core hDense hSub hCover) f

end CutoffQuantifiers

/-! ### P0.5: exact core boundary route and continuous extension -/

section BoundaryAndDenseExtension

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Two continuous bilinear forms agreeing on a dense core agree everywhere.
This is the rigorous density step available after the boundary is shown to be
exactly zero on compactly supported tests.
-/
theorem continuous_bilinear_ext_of_dense
    (B₁ B₂ : E →L[ℂ] E →L[ℂ] ℂ) {D : Set E} (hD : Dense D)
    (h : ∀ u ∈ D, ∀ v ∈ D, B₁ u v = B₂ u v) :
    B₁ = B₂ := by
  have huncurry :
      (Function.uncurry fun u v => B₁ u v) =
        Function.uncurry fun u v => B₂ u v := by
    apply Continuous.ext_on (hD.prod hD) B₁.continuous₂ B₂.continuous₂
    rintro ⟨u, v⟩ ⟨hu, hv⟩
    exact h u hu v hv
  ext u v
  exact congrFun huncurry (u, v)

/-- The same dense-core uniqueness principle for forms that are linear in the
first variable and conjugate-linear in the test variable. -/
theorem continuous_sesquilinear_ext_of_dense
    (B₁ B₂ : WeakAntiOperator E) {D : Set E} (hD : Dense D)
    (h : ∀ u ∈ D, ∀ v ∈ D, B₁ u v = B₂ u v) :
    B₁ = B₂ := by
  have houter : (B₁ : E → StrongAntiDual E) = B₂ := by
    apply Continuous.ext_on hD B₁.continuous B₂.continuous
    intro u hu
    apply ContinuousLinearMap.ext
    intro v
    have hinner : (B₁ u : E → ℂ) = B₂ u := by
      apply Continuous.ext_on hD (B₁ u).continuous (B₂ u).continuous
      intro w hw
      exact h u hu w hw
    exact congrFun hinner v
  ext u v
  exact congrArg (fun g : StrongAntiDual E => g v) (congrFun houter u)

/-- A top-boundary term on a compact core should be proved exactly zero past a
support cutoff, rather than assigned an unsupported pointwise decay rate.
-/
def BoundaryVanishesPast (b : ℕ → ℂ) (N : ℕ) : Prop :=
  ∀ Y, N ≤ Y → b Y = 0

theorem boundary_norm_eq_zero_past {b : ℕ → ℂ} {N : ℕ}
    (h : BoundaryVanishesPast b N) :
    ∀ Y, N ≤ Y → ‖b Y‖ = 0 := by
  intro Y hY
  rw [h Y hY, norm_zero]

/-- A decaying scalar factor alone does not control a simultaneously growing
trace norm: their product can remain identically one.
-/
theorem small_factor_times_growing_norm (n : ℕ) :
    (1 / ((n : ℝ) + 1)) * ((n : ℝ) + 1) = 1 := by
  have hn : (n : ℝ) + 1 ≠ 0 := by positivity
  field_simp

end BoundaryAndDenseExtension

/-! ### P0.6: local boundedness does not imply a global potential bound -/

section PotentialObstruction

/-- Discrete model of a nonnegative potential that is bounded on every finite
initial region but has no global pointwise bound.
-/
def discretePotential (n : ℕ) : ℝ :=
  n

theorem discretePotential_nonneg (n : ℕ) : 0 ≤ discretePotential n := by
  simp [discretePotential]

theorem discretePotential_bounded_on_initialSegment (N : ℕ) :
    ∀ n ≤ N, discretePotential n ≤ discretePotential N := by
  intro n hn
  change (n : ℝ) ≤ (N : ℝ)
  exact_mod_cast hn

theorem discretePotential_not_uniformly_bounded :
    ¬ ∃ C : ℝ, ∀ n : ℕ, discretePotential n ≤ C := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hn⟩ := exists_nat_gt C
  exact (not_lt_of_ge (hC n)) hn

/-- The associated diagonal forms have no continuity constant uniform in the
finite-region index. This is the finite-dimensional-family version of the
local-to-global form-bound obstruction.
-/
def discretePotentialForm (n : ℕ) (u v : ℝ) : ℝ :=
  discretePotential n * u * v

theorem discretePotentialForm_not_uniformly_bounded :
    ¬ ∃ C : ℝ, ∀ n : ℕ, ∀ u v : ℝ,
      |discretePotentialForm n u v| ≤ C * |u| * |v| := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hn⟩ := exists_nat_gt C
  have hn0 : (0 : ℝ) ≤ (n : ℝ) := by positivity
  have hbound : (n : ℝ) ≤ C := by
    simpa [discretePotentialForm, discretePotential,
      abs_of_nonneg hn0] using hC n 1 1
  exact (not_lt_of_ge hbound) hn

end PotentialObstruction

/-! ### P0.7: shifted and unshifted equations are different -/

section ShiftObstruction

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- The operator actually solved after adding a coercive mass shift. -/
def shiftedOperator (A : E →L[𝕜] E) (lam : 𝕜) : E →L[𝕜] E :=
  A + lam • ContinuousLinearMap.id 𝕜 E

@[simp]
theorem shiftedOperator_apply (A : E →L[𝕜] E) (lam : 𝕜) (u : E) :
    shiftedOperator A lam u = A u + lam • u := by
  simp [shiftedOperator]

/-- A shifted equation has a residual mass term when rewritten for `A`. -/
theorem shiftedEquation_iff_residual (A : E →L[𝕜] E) (lam : 𝕜)
    (u f : E) :
    shiftedOperator A lam u = f ↔ A u = f - lam • u := by
  simpa only [shiftedOperator_apply] using
    (eq_sub_iff_add_eq : A u = f - lam • u ↔ A u + lam • u = f).symm

/-- Under a shifted equation, the same vector solves the unshifted equation
exactly when its mass term vanishes.
-/
theorem shiftedSolution_isUnshifted_iff_massTerm_zero
    (A : E →L[𝕜] E) (lam : 𝕜) (u f : E)
    (hshift : shiftedOperator A lam u = f) :
    A u = f ↔ lam • u = 0 := by
  rw [shiftedOperator_apply] at hshift
  constructor
  · intro h
    simpa [h] using hshift
  · intro h
    simpa [h] using hshift

/-- Concrete one-dimensional counterexample: `u = 1` solves
`(0 + I)u = 1` but not `0u = 1`.
-/
theorem shifted_not_unshifted_counterexample :
    shiftedOperator (0 : ℝ →L[ℝ] ℝ) 1 1 = (1 : ℝ) ∧
      (0 : ℝ →L[ℝ] ℝ) 1 ≠ (1 : ℝ) := by
  constructor <;> norm_num [shiftedOperator]

end ShiftObstruction

/-! ### P0.8: kernels and spectral-parameter scope -/

section SpectralObstructions

/-- Any Poincare estimate forces the joint raising/lowering kernel in its
stated domain to vanish.
-/
theorem poincare_annihilates_jointKernel
    {E : Type*} [NormedAddCommGroup E]
    (D : Set E) (R L : E → E) (C : ℝ)
    (hP : ∀ u ∈ D, ‖u‖ ≤ C * (‖R u‖ + ‖L u‖))
    {u : E} (hu : u ∈ D) (hR : R u = 0) (hL : L u = 0) :
    u = 0 := by
  have hu0 : ‖u‖ ≤ 0 := by
    simpa [hR, hL] using hP u hu
  exact norm_eq_zero.mp (le_antisymm hu0 (norm_nonneg u))

/-- A nonzero joint-kernel vector rules out a Poincare estimate on the whole
stated domain.
-/
theorem no_poincare_with_nonzero_jointKernel
    {E : Type*} [NormedAddCommGroup E]
    (D : Set E) (R L : E → E) {u : E}
    (hu : u ∈ D) (hu_ne : u ≠ 0) (hR : R u = 0) (hL : L u = 0) :
    ¬ ∃ C : ℝ, ∀ v ∈ D, ‖v‖ ≤ C * (‖R v‖ + ‖L v‖) := by
  rintro ⟨C, hP⟩
  exact hu_ne (poincare_annihilates_jointKernel D R L C hP hu hR hL)

/-- Writing a spectral value as `1/4 + t^2` with real `t` already excludes
exceptional spectrum below `1/4`.
-/
theorem real_spectral_parameter_forces_quarter_lower {lam t : ℝ}
    (hlam : lam = (1 : ℝ) / 4 + t ^ 2) :
    (1 : ℝ) / 4 ≤ lam := by
  rw [hlam]
  exact le_add_of_nonneg_right (sq_nonneg t)

end SpectralObstructions

/-! ### P0.9: downstream order, compactness, and energy obstructions -/

section DownstreamObstructions

/-- A lower/upper-bound contradiction requires an actual crossover index. -/
theorem contradiction_of_lower_upper_cross
    {S lower upper : ℕ → ℝ} {I : Set ℕ}
    (hlow : ∀ n ∈ I, lower n ≤ S n)
    (hupp : ∀ n, |S n| ≤ upper n)
    (hcross : ∃ n ∈ I, upper n < lower n) : False := by
  rcases hcross with ⟨n, hnI, hn⟩
  have hle : lower n ≤ upper n :=
    (hlow n hnI).trans ((le_abs_self (S n)).trans (hupp n))
  exact (not_lt_of_ge hle) hn

/-- A fixed positive lower bound is perfectly compatible with a polynomial
(indeed linear) upper bound, so those two facts alone give no contradiction.
-/
theorem fixed_lower_compatible_with_polynomial_upper (δ : ℝ) (hδ : 0 < δ) :
    ∃ S : ℕ → ℝ,
      (∀ n, δ ≤ S n) ∧ (∀ n, |S n| ≤ δ + (n : ℝ)) := by
  refine ⟨fun _ => δ, fun _ => le_rfl, ?_⟩
  intro n
  rw [abs_of_pos hδ]
  exact le_add_of_nonneg_right (Nat.cast_nonneg n)

/-- Two-coordinate algebraic model of a cutoff that destroys orthogonality. -/
def dotTwo (u v : ℝ × ℝ) : ℝ :=
  u.1 * v.1 + u.2 * v.2

/-- Keep only the first coordinate, modeling multiplication by a cutoff. -/
def firstCoordinateCutoff (u : ℝ × ℝ) : ℝ × ℝ :=
  (u.1, 0)

/-- Orthogonality to a distinguished vector need not survive a cutoff. -/
theorem firstCoordinateCutoff_destroys_orthogonality :
    dotTwo ((1, -1) : ℝ × ℝ) ((1, 1) : ℝ × ℝ) = 0 ∧
      dotTwo (firstCoordinateCutoff ((1, -1) : ℝ × ℝ))
        ((1, 1) : ℝ × ℝ) = 1 := by
  norm_num [dotTwo, firstCoordinateCutoff]

/-- A two-term average controls at least one term, but does not identify a
preselected coefficient. -/
theorem one_of_two_at_least_average (a b : ℝ) :
    (a + b) / 2 ≤ a ∨ (a + b) / 2 ≤ b := by
  by_cases h : a ≤ b
  · right
    linarith
  · left
    linarith

/-- A positive average does not force pointwise positivity of every term. -/
theorem positive_average_not_pointwise_nonvanishing :
    ∃ a b : ℝ, 0 < (a + b) / 2 ∧ ¬ (0 < a ∧ 0 < b) := by
  exact ⟨2, 0, by norm_num, by norm_num⟩

/-- In every infinite-dimensional normed space the closed unit ball is bounded
but not totally bounded. Thus boundedness cannot imply strong precompactness.
-/
theorem bounded_closedBall_not_precompact
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (hE : ¬ FiniteDimensional ℂ E) :
    Bornology.IsBounded (Metric.closedBall (0 : E) 1) ∧
      ¬ TotallyBounded (Metric.closedBall (0 : E) 1) := by
  refine ⟨Metric.isBounded_closedBall, ?_⟩
  intro htb
  exact hE (FiniteDimensional.of_totallyBounded_nhds_zero ℂ
    (Metric.closedBall_mem_nhds (0 : E) zero_lt_one) htb)

/-- The correct compactness bridge for a concrete truncation is a proved
Cauchy estimate (or another genuine compactness theorem), not boundedness.
-/
theorem cauchySeq_range_precompact {E : Type*} [UniformSpace E]
    {u : ℕ → E} (hu : CauchySeq u) :
    TotallyBounded (Set.range u) :=
  hu.totallyBounded_range

/-- The damping inequality used in the source fails already at `n = 1`,
`N = 4`: its asserted direction is reversed.
-/
theorem claimed_damping_inequality_fails :
    (1 : ℝ) / Real.sqrt 4 < Real.sqrt 1 := by
  norm_num

/-- A zero covariant derivative has zero norm-square and therefore cannot equal
a strictly positive theta mass.
-/
theorem zero_derivative_energy_ne_positive_mass
    {E : Type*} [SeminormedAddCommGroup E] {d : E} (hd : d = 0)
    {mass : ℝ} (hmass : 0 < mass) :
    ‖d‖ ^ 2 ≠ mass := by
  rw [hd, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0)]
  exact ne_of_lt hmass

end DownstreamObstructions

/-! ### P0.10: the proposed global q-coordinate and radius fibers -/

section QCoordinateObstruction

/-- A concrete element that will witness failure of q-invariance on `Gamma(2)`. -/
def gammaTwoHyperbolic : SL(2, ℤ) :=
  ⟨!![3, 2; 4, 3], by norm_num [Matrix.det_fin_two_of]⟩

theorem gammaTwoHyperbolic_mem :
    gammaTwoHyperbolic ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  change
    ((3 : ZMod 2) = 1 ∧ (2 : ZMod 2) = 0 ∧
      (4 : ZMod 2) = 0 ∧ (3 : ZMod 2) = 1)
  decide

/-- This element sends `Im(i) = 1` to `1/25`. -/
theorem gammaTwoHyperbolic_smul_I_im :
    (gammaTwoHyperbolic • UpperHalfPlane.I).im = (1 : ℝ) / 25 := by
  rw [ModularGroup.im_smul_eq_div_normSq]
  change (1 : ℝ) / Complex.normSq ((4 : ℂ) * Complex.I + 3) =
    (1 : ℝ) / 25
  norm_num [Complex.normSq]

/-- Even the radius of the usual q-parameter is not invariant under this
`Gamma(2)` element. -/
theorem qParam_norm_not_GammaTwo_invariant :
    ‖Function.Periodic.qParam 1 (UpperHalfPlane.I : ℂ)‖ ≠
      ‖Function.Periodic.qParam 1
        ((gammaTwoHyperbolic • UpperHalfPlane.I : ℍ) : ℂ)‖ := by
  intro hn
  simp only [Function.Periodic.norm_qParam, UpperHalfPlane.coe_im,
    UpperHalfPlane.I_im, div_one] at hn
  rw [gammaTwoHyperbolic_smul_I_im] at hn
  have harg := Real.exp_injective hn
  nlinarith [Real.pi_pos]

/-- The q-parameter itself is therefore not invariant under the actual
`Gamma(2)` action, so it cannot descend to a global quotient coordinate. -/
theorem qParam_not_GammaTwo_invariant :
    Function.Periodic.qParam 1 (UpperHalfPlane.I : ℂ) ≠
      Function.Periodic.qParam 1
        ((gammaTwoHyperbolic • UpperHalfPlane.I : ℍ) : ℂ) := by
  intro h
  exact qParam_norm_not_GammaTwo_invariant
    (congrArg (fun z : ℂ => ‖z‖) h)

/-- Membership and q-noninvariance packaged as one kernel-checked witness. -/
theorem gammaTwo_qParam_counterexample :
    gammaTwoHyperbolic ∈ CongruenceSubgroup.Gamma 2 ∧
      Function.Periodic.qParam 1 (UpperHalfPlane.I : ℂ) ≠
        Function.Periodic.qParam 1
          ((gammaTwoHyperbolic • UpperHalfPlane.I : ℍ) : ℂ) :=
  ⟨gammaTwoHyperbolic_mem, qParam_not_GammaTwo_invariant⟩

/-- Logical shape of the paper's displayed radius fiber. Its radius condition
does not depend on the alleged solution `u`.
-/
def claimedRadiusFiber {T R U : Type*}
    (π : T → R) (Sol : Set U) (τ : T) (r : R) : Set U :=
  {u | u ∈ Sol ∧ π τ = r}

theorem claimedRadiusFiber_eq_solution {T R U : Type*}
    (π : T → R) (Sol : Set U) (τ : T) (r : R) (h : π τ = r) :
    claimedRadiusFiber π Sol τ r = Sol := by
  ext u
  simp [claimedRadiusFiber, h]

theorem claimedRadiusFiber_eq_empty {T R U : Type*}
    (π : T → R) (Sol : Set U) (τ : T) (r : R) (h : π τ ≠ r) :
    claimedRadiusFiber π Sol τ r = ∅ := by
  ext u
  simp [claimedRadiusFiber, h]

end QCoordinateObstruction

/-! ## 6. P2: certificate-separated half-integral automorphic Sobolev layer

In `HalfIntegralMultiplier Γ k` the integer `k` records the negative of twice
the holomorphic covariance exponent: the total factor contains
`sqrtFactor ^ (-k)`.  Hence the displayed paper covariance is index `k = 1`
but exponent `-1/2`.  The differential-operator layer below uses a separate
*exponent index* `a = -k`; in that indexing the standard shifts really are
`a ↦ a + 4` and `a ↦ a - 4`.  Keeping these indices separate is essential:
the PDF combines exponent `-1/2` with the coefficient `+1/2` in its raising
operator, and those conventions are not covariant with one another.

The paper does not give a globally coherent square-root cocycle or enough
values of its symbol `ν` to identify the intended normalization.  The abstract
structure therefore remains explicit, while the inverse-Dedekind-eta
construction below supplies a concrete coherent multiplier at every integer
index.  All normalization, cocycle, nonvanishing, section algebra, and
metric-invariance consequences are proved rather than postulated separately.
-/

namespace AutomorphicSobolev

open UpperHalfPlane

/-! ### 6.2: square-root multipliers and weight sections -/

/-- A coherent half-integral multiplier on a subgroup of `SL(2, ℤ)`.

`sqrtFactor` is a chosen square root of the classical denominator `c z + d`;
it is not required to be an ordinary cocycle.  Indeed, on a group containing
`-I` such a square-root cocycle is impossible.  The phase `nu` cancels its
metaplectic sign defect, and the cocycle law is imposed only on the resulting
total weight-`k/2` factor `nu γ * sqrtFactor γ z ^ (-k)`.
-/
structure HalfIntegralMultiplier
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) where
  nu : Γ → ℂ
  nu_one : nu 1 = 1
  nu_norm : ∀ γ, ‖nu γ‖ = 1
  sqrtFactor : Γ → ℍ → ℂ
  sqrtFactor_one : ∀ z, sqrtFactor 1 z = 1
  sqrtFactor_sq : ∀ γ z,
    sqrtFactor γ z ^ 2 =
      UpperHalfPlane.denom (γ : SL(2, ℤ)) z
  factor_cocycle : ∀ γ δ z,
    nu (γ * δ) * sqrtFactor (γ * δ) z ^ (-k) =
      (nu γ * sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (-k)) *
        (nu δ * sqrtFactor δ z ^ (-k))

namespace HalfIntegralMultiplier

variable {Γ : Subgroup SL(2, ℤ)} {k : ℤ}

/-- The combined weight-`k/2` automorphy factor. -/
noncomputable def factor (M : HalfIntegralMultiplier Γ k) (γ : Γ) (z : ℍ) : ℂ :=
  M.nu γ * M.sqrtFactor γ z ^ (-k)

@[simp]
theorem factor_one (M : HalfIntegralMultiplier Γ k) (z : ℍ) :
    M.factor 1 z = 1 := by
  simp [factor, M.nu_one, M.sqrtFactor_one]

/-- The derived factor satisfies the left-action cocycle law. -/
theorem factor_mul (M : HalfIntegralMultiplier Γ k) (γ δ : Γ) (z : ℍ) :
    M.factor (γ * δ) z =
      M.factor γ ((δ : SL(2, ℤ)) • z) * M.factor δ z :=
  M.factor_cocycle γ δ z

/-- The phase multiplier is unitary by construction. -/
theorem nu_unitary (M : HalfIntegralMultiplier Γ k) (γ : Γ) :
    ‖M.nu γ‖ = 1 :=
  M.nu_norm γ

/-- A unitary phase never vanishes. -/
theorem nu_ne_zero (M : HalfIntegralMultiplier Γ k) (γ : Γ) :
    M.nu γ ≠ 0 := by
  intro h
  have hn := M.nu_norm γ
  rw [h, norm_zero] at hn
  norm_num at hn

/-- Coherence with `c z + d` forces every square-root value to be nonzero. -/
theorem sqrtFactor_ne_zero (M : HalfIntegralMultiplier Γ k)
    (γ : Γ) (z : ℍ) :
    M.sqrtFactor γ z ≠ 0 := by
  intro h
  apply UpperHalfPlane.denom_ne_zero (γ : SL(2, ℤ)) z
  rw [← M.sqrtFactor_sq γ z, h]
  norm_num

/-- The combined half-integral automorphy factor never vanishes. -/
theorem factor_ne_zero (M : HalfIntegralMultiplier Γ k)
    (γ : Γ) (z : ℍ) :
    M.factor γ z ≠ 0 := by
  exact mul_ne_zero (M.nu_ne_zero γ)
    (zpow_ne_zero _ (M.sqrtFactor_ne_zero γ z))

/-- Squaring the total half-integral automorphy factor removes the chosen
square-root branch.  This algebraic identity is the convenient starting point
for differentiating a fixed-phase factor: only the ordinary affine
denominator remains. -/
theorem factor_sq (M : HalfIntegralMultiplier Γ k)
    (γ : Γ) (z : ℍ) :
    M.factor γ z ^ 2 =
      M.nu γ ^ 2 *
        UpperHalfPlane.denom (γ : SL(2, ℤ)) z ^ (-k) := by
  rw [factor, mul_pow]
  congr 1
  calc
    (M.sqrtFactor γ z ^ (-k)) ^ (2 : ℕ) =
        (M.sqrtFactor γ z ^ (-k)) ^ (2 : ℤ) := by
          simp only [zpow_ofNat]
    _ = (M.sqrtFactor γ z ^ (2 : ℤ)) ^ (-k) :=
      zpow_comm (M.sqrtFactor γ z) (-k) (2 : ℤ)
    _ = (M.sqrtFactor γ z ^ (2 : ℕ)) ^ (-k) := by
      simp only [zpow_ofNat]
    _ = UpperHalfPlane.denom (γ : SL(2, ℤ)) z ^ (-k) := by
      rw [M.sqrtFactor_sq]

/-- Norm of the combined factor; the phase contributes no size. -/
theorem norm_factor (M : HalfIntegralMultiplier Γ k)
    (γ : Γ) (z : ℍ) :
    ‖M.factor γ z‖ = ‖M.sqrtFactor γ z‖ ^ (-k) := by
  rw [factor, norm_mul, M.nu_norm, one_mul, norm_zpow]

/-- Taking norms in the square-root law gives the exact metric scaling datum. -/
theorem norm_sq_sqrtFactor (M : HalfIntegralMultiplier Γ k)
    (γ : Γ) (z : ℍ) :
    ‖M.sqrtFactor γ z‖ ^ 2 =
      ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ := by
  have h := congrArg norm (M.sqrtFactor_sq γ z)
  simpa only [norm_pow] using h

/-- At physical weight `1/2`, the total factor has squared norm
`|c z + d|⁻¹`. -/
theorem norm_factor_sq_one
    (M : HalfIntegralMultiplier Γ 1) (γ : Γ) (z : ℍ) :
    ‖M.factor γ z‖ ^ 2 =
      ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖⁻¹ := by
  calc
    ‖M.factor γ z‖ ^ 2 =
        (‖M.sqrtFactor γ z‖ ^ (-1 : ℤ)) ^ 2 := by
          rw [M.norm_factor]
    _ = (‖M.sqrtFactor γ z‖⁻¹) ^ 2 := by
          rw [zpow_neg_one]
    _ = (‖M.sqrtFactor γ z‖ ^ 2)⁻¹ := by
          rw [inv_pow]
    _ = ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖⁻¹ := by
          rw [M.norm_sq_sqrtFactor]

/-- Squared norm of the total factor at an arbitrary doubled integer weight. -/
theorem norm_factor_sq
    (M : HalfIntegralMultiplier Γ k) (γ : Γ) (z : ℍ) :
    ‖M.factor γ z‖ ^ 2 =
      ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ ^ (-k) := by
  calc
    ‖M.factor γ z‖ ^ 2 =
        (‖M.sqrtFactor γ z‖ ^ (-k)) ^ (2 : ℕ) := by
      rw [M.norm_factor]
    _ = (‖M.sqrtFactor γ z‖ ^ (-k)) ^ (2 : ℤ) := by
      simp only [zpow_ofNat]
    _ = (‖M.sqrtFactor γ z‖ ^ (2 : ℤ)) ^ (-k) :=
      zpow_comm ‖M.sqrtFactor γ z‖ (-k) (2 : ℤ)
    _ = (‖M.sqrtFactor γ z‖ ^ (2 : ℕ)) ^ (-k) := by
      simp only [zpow_ofNat]
    _ = ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ ^ (-k) := by
      rw [M.norm_sq_sqrtFactor]

/-! #### Fixed-phase shifts by integral weight two -/

/-- The ordinary denominator is an honest cocycle on a subgroup of
`SL(2, Z)`. -/
theorem subgroupDenom_mul (γ δ : Γ) (z : ℍ) :
    UpperHalfPlane.denom
        (((γ * δ : Γ) : SL(2, ℤ)) : GL (Fin 2) ℝ) z =
      UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ)
          (((δ : SL(2, ℤ)) • z : ℍ)) *
        UpperHalfPlane.denom
          ((δ : SL(2, ℤ)) : GL (Fin 2) ℝ) z := by
  simpa [UpperHalfPlane.σ, MulAction.compHom_smul_def,
    Matrix.SpecialLinearGroup.mapGL] using
    (UpperHalfPlane.denom_cocycle_σ
      ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ)
      ((δ : SL(2, ℤ)) : GL (Fin 2) ℝ) z)

/-- Every fourth square-root power is branch-independent. -/
theorem sqrtFactor_zpow_four_mul
    (M : HalfIntegralMultiplier Γ k) (n : ℤ) (γ : Γ) (z : ℍ) :
    M.sqrtFactor γ z ^ ((4 : ℤ) * n) =
      UpperHalfPlane.denom
        ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n) := by
  calc
    M.sqrtFactor γ z ^ ((4 : ℤ) * n) =
        M.sqrtFactor γ z ^ ((2 : ℤ) * ((2 : ℤ) * n)) :=
      congrArg (fun e : ℤ => M.sqrtFactor γ z ^ e) (by ring)
    _ = (M.sqrtFactor γ z ^ (2 : ℤ)) ^ ((2 : ℤ) * n) :=
      zpow_mul (M.sqrtFactor γ z) (2 : ℤ) ((2 : ℤ) * n)
    _ = (M.sqrtFactor γ z ^ (2 : ℕ)) ^ ((2 : ℤ) * n) := by
      rw [zpow_ofNat]
    _ = UpperHalfPlane.denom
        ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n) := by
      rw [M.sqrtFactor_sq]

/-- The branch-independent fourth-power correction is itself a cocycle. -/
theorem sqrtFactor_zpow_four_mul_cocycle
    (M : HalfIntegralMultiplier Γ k) (n : ℤ)
    (γ δ : Γ) (z : ℍ) :
    M.sqrtFactor (γ * δ) z ^ ((4 : ℤ) * n) =
      M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ ((4 : ℤ) * n) *
        M.sqrtFactor δ z ^ ((4 : ℤ) * n) := by
  rw [sqrtFactor_zpow_four_mul M n (γ * δ) z,
    sqrtFactor_zpow_four_mul M n γ ((δ : SL(2, ℤ)) • z),
    sqrtFactor_zpow_four_mul M n δ z,
    subgroupDenom_mul, mul_zpow]

/-- Shift a half-integral multiplier by an arbitrary integral-weight-two
power while keeping its phase character fixed. -/
def shiftByFour (M : HalfIntegralMultiplier Γ k) (n : ℤ) :
    HalfIntegralMultiplier Γ (k - 4 * n) where
  nu := M.nu
  nu_one := M.nu_one
  nu_norm := M.nu_norm
  sqrtFactor := M.sqrtFactor
  sqrtFactor_one := M.sqrtFactor_one
  sqrtFactor_sq := M.sqrtFactor_sq
  factor_cocycle := by
    intro γ δ z
    have hγδ : M.sqrtFactor (γ * δ) z ≠ 0 :=
      M.sqrtFactor_ne_zero (γ * δ) z
    have hγ : M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ≠ 0 :=
      M.sqrtFactor_ne_zero γ ((δ : SL(2, ℤ)) • z)
    have hδ : M.sqrtFactor δ z ≠ 0 :=
      M.sqrtFactor_ne_zero δ z
    have hshift := sqrtFactor_zpow_four_mul_cocycle M n γ δ z
    have hExp : -(k - 4 * n) = -k + 4 * n := by ring
    simp only [hExp, zpow_add₀ hγδ, zpow_add₀ hγ, zpow_add₀ hδ]
    calc
      M.nu (γ * δ) *
          (M.sqrtFactor (γ * δ) z ^ (-k) *
            M.sqrtFactor (γ * δ) z ^ (4 * n)) =
        (M.nu (γ * δ) * M.sqrtFactor (γ * δ) z ^ (-k)) *
          M.sqrtFactor (γ * δ) z ^ (4 * n) := by ring
      _ = ((M.nu γ *
            M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (-k)) *
          (M.nu δ * M.sqrtFactor δ z ^ (-k))) *
            M.sqrtFactor (γ * δ) z ^ (4 * n) := by
        rw [M.factor_cocycle]
      _ = ((M.nu γ *
            M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (-k)) *
          (M.nu δ * M.sqrtFactor δ z ^ (-k))) *
            (M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (4 * n) *
              M.sqrtFactor δ z ^ (4 * n)) := by
        rw [hshift]
      _ = (M.nu γ *
            (M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (-k) *
              M.sqrtFactor γ ((δ : SL(2, ℤ)) • z) ^ (4 * n))) *
          (M.nu δ *
            (M.sqrtFactor δ z ^ (-k) *
              M.sqrtFactor δ z ^ (4 * n))) := by ring

@[simp]
theorem shiftByFour_factor
    (M : HalfIntegralMultiplier Γ k) (n : ℤ) (γ : Γ) (z : ℍ) :
    (shiftByFour M n).factor γ z =
      M.factor γ z *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n) := by
  have hs : M.sqrtFactor γ z ≠ 0 := M.sqrtFactor_ne_zero γ z
  have hExp : -(k - 4 * n) = -k + 4 * n := by ring
  change M.nu γ * M.sqrtFactor γ z ^ (-(k - 4 * n)) =
    (M.nu γ * M.sqrtFactor γ z ^ (-k)) *
      UpperHalfPlane.denom
        ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n)
  rw [hExp, zpow_add₀ hs, sqrtFactor_zpow_four_mul M n γ z]
  ring

/-! #### A concrete inverse-Dedekind-eta multiplier

The PDF leaves its multiplier `nu` and its square-root branch unspecified.
The following construction makes one canonical, fully explicit normalization:
use Mathlib's principal complex square root and normalize the phase by the
Dedekind eta function at `I`.  The key phase is independent of `z` because its
24th power is one and the upper half-plane is connected.
-/

/-- Principal square root of `c z + d` for an integral special-linear
matrix. -/
noncomputable def etaSqrtFactor (γ : SL(2, ℤ)) (z : ℍ) : ℂ :=
  Complex.sqrt
    (UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z)

@[simp]
theorem etaSqrtFactor_sq (γ : SL(2, ℤ)) (z : ℍ) :
    etaSqrtFactor γ z ^ 2 =
      UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z := by
  simpa [etaSqrtFactor, Complex.sqrt] using
    (Complex.cpow_nat_inv_pow
      (UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z)
      (n := 2) (by norm_num))

@[simp]
theorem etaSqrtFactor_one (z : ℍ) :
    etaSqrtFactor (1 : SL(2, ℤ)) z = 1 := by
  simp [etaSqrtFactor, UpperHalfPlane.denom_one]

theorem etaSqrtFactor_ne_zero (γ : SL(2, ℤ)) (z : ℍ) :
    etaSqrtFactor γ z ≠ 0 := by
  intro h
  apply UpperHalfPlane.denom_ne_zero (γ : GL (Fin 2) ℝ) z
  rw [← etaSqrtFactor_sq γ z, h]
  norm_num

/-- The 24th power of the chosen square root is branch-independent. -/
theorem etaSqrtFactor_pow_twentyFour (γ : SL(2, ℤ)) (z : ℍ) :
    etaSqrtFactor γ z ^ 24 =
      UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ 12 := by
  calc
    etaSqrtFactor γ z ^ 24 = (etaSqrtFactor γ z ^ 2) ^ 12 := by
      ring
    _ = UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ 12 := by
      rw [etaSqrtFactor_sq]

/-- Dedekind eta restricted to the upper half-plane is continuous. -/
theorem continuous_eta_upperHalfPlane :
    Continuous (fun z : ℍ ↦ ModularForm.eta (z : ℂ)) := by
  rw [continuous_iff_continuousAt]
  intro z
  exact
    (ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet z.2).continuousAt.comp'
      UpperHalfPlane.continuous_coe.continuousAt

/-- A fixed integral special-linear transformation acts continuously; this is
the restriction of Mathlib's continuous `GL(2, R)` action. -/
theorem continuous_sl2z_smul (γ : SL(2, ℤ)) :
    Continuous (fun z : ℍ ↦ γ • z) := by
  change Continuous (fun z : ℍ ↦ ((γ : GL (Fin 2) ℝ) • z))
  exact continuous_const_smul (γ : GL (Fin 2) ℝ)

/-- For fixed `gamma`, the principal square-root denominator is continuous on
the upper half-plane.  If `c ≠ 0`, the denominator has nonzero imaginary
part there; if `c = 0`, it is constant.  Thus the principal-branch cut is
never crossed. -/
theorem etaSqrtFactor_continuous (γ : SL(2, ℤ)) :
    Continuous (etaSqrtFactor γ) := by
  let g : GL (Fin 2) ℝ := γ
  by_cases hc : g 1 0 = 0
  · have hfun : etaSqrtFactor γ =
        (fun _ : ℍ ↦ Complex.sqrt (g 1 1)) := by
      funext z
      simp [etaSqrtFactor, UpperHalfPlane.denom, g, hc]
    rw [hfun]
    exact continuous_const
  · rw [continuous_iff_continuousAt]
    intro z
    have him : (UpperHalfPlane.denom g z).im ≠ 0 := by
      simpa [UpperHalfPlane.denom] using
        mul_ne_zero hc (ne_of_gt z.im_pos)
    have hdenom : ContinuousAt (fun w : ℍ ↦
        UpperHalfPlane.denom g w) z := by
      fun_prop
    change ContinuousAt (fun w : ℍ ↦
      Complex.sqrt (UpperHalfPlane.denom g w)) z
    exact ContinuousAt.comp'
      (f := fun w : ℍ ↦ UpperHalfPlane.denom g w)
      (g := Complex.sqrt)
      (Complex.continuousAt_sqrt (Or.inr him)) hdenom

/-- The eta-normalized square-root phase before proving that it is constant. -/
noncomputable def etaPhaseRatio (γ : SL(2, ℤ)) (z : ℍ) : ℂ :=
  ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) /
    (etaSqrtFactor γ z * ModularForm.eta (z : ℂ))

/-- The discriminant transformation formula says that the eta phase is a
24th root of unity at every point. -/
theorem etaPhaseRatio_pow_twentyFour (γ : SL(2, ℤ)) (z : ℍ) :
    etaPhaseRatio γ z ^ 24 = 1 := by
  have hdisc :
      ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) ^ 24 =
        UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ 12 *
          ModularForm.eta (z : ℂ) ^ 24 := by
    have hΔ := SlashInvariantForm.slash_action_eqn''
      CuspForm.discriminant
      (show (γ : GL (Fin 2) ℝ) ∈ 𝒮ℒ from ⟨γ, rfl⟩) z
    change ModularForm.discriminant (((γ : SL(2, ℤ)) • z : ℍ)) =
      UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ 12 *
        ModularForm.discriminant z at hΔ
    exact hΔ
  rw [etaPhaseRatio, div_pow, hdisc, mul_pow,
    etaSqrtFactor_pow_twentyFour]
  exact div_self (mul_ne_zero
    (pow_ne_zero 12 (UpperHalfPlane.denom_ne_zero
      (γ : GL (Fin 2) ℝ) z))
    (pow_ne_zero 24 (ModularForm.eta_ne_zero z.2)))

theorem etaPhaseRatio_ne_zero (γ : SL(2, ℤ)) (z : ℍ) :
    etaPhaseRatio γ z ≠ 0 := by
  intro h
  have hp := etaPhaseRatio_pow_twentyFour γ z
  rw [h, zero_pow (by norm_num : (24 : ℕ) ≠ 0)] at hp
  exact zero_ne_one hp

theorem etaPhaseRatio_continuous (γ : SL(2, ℤ)) :
    Continuous (etaPhaseRatio γ) := by
  unfold etaPhaseRatio
  exact
    (continuous_eta_upperHalfPlane.comp (continuous_sl2z_smul γ)).div
      ((etaSqrtFactor_continuous γ).mul continuous_eta_upperHalfPlane)
      (fun z ↦ mul_ne_zero (etaSqrtFactor_ne_zero γ z)
        (ModularForm.eta_ne_zero z.2))

/-- The finite set of complex 24th roots of unity, represented through
Mathlib's bundled `rootsOfUnity`. -/
def etaRootsTwentyFour : Set ℂ :=
  Set.range fun ζ : rootsOfUnity 24 ℂ ↦ ((ζ : ℂˣ) : ℂ)

theorem etaRootsTwentyFour_finite : etaRootsTwentyFour.Finite :=
  Set.finite_range _

theorem etaPhaseRatio_mem_roots (γ : SL(2, ℤ)) (z : ℍ) :
    etaPhaseRatio γ z ∈ etaRootsTwentyFour := by
  refine ⟨rootsOfUnity.mkOfPowEq (etaPhaseRatio γ z)
    (etaPhaseRatio_pow_twentyFour γ z), ?_⟩
  simpa using rootsOfUnity.coe_mkOfPowEq
    (etaPhaseRatio_pow_twentyFour γ z)

/-- Connectedness of the upper half-plane forces the finite-valued continuous
phase to be constant. -/
theorem etaPhaseRatio_eq_at_I (γ : SL(2, ℤ)) (z : ℍ) :
    etaPhaseRatio γ z = etaPhaseRatio γ UpperHalfPlane.I := by
  exact isPreconnected_univ.constant_of_mapsTo
    etaRootsTwentyFour_finite.isDiscrete
    (etaPhaseRatio_continuous γ).continuousOn
    (fun w _ ↦ etaPhaseRatio_mem_roots γ w)
    (Set.mem_univ z) (Set.mem_univ UpperHalfPlane.I)

/-- Explicit eta phase, normalized at the base point `I`. -/
noncomputable def etaPhase (γ : SL(2, ℤ)) : ℂ :=
  etaPhaseRatio γ UpperHalfPlane.I

theorem etaPhaseRatio_eq (γ : SL(2, ℤ)) (z : ℍ) :
    etaPhaseRatio γ z = etaPhase γ := by
  simpa [etaPhase] using etaPhaseRatio_eq_at_I γ z

theorem etaPhase_pow_twentyFour (γ : SL(2, ℤ)) :
    etaPhase γ ^ 24 = 1 := by
  simpa [etaPhase] using
    etaPhaseRatio_pow_twentyFour γ UpperHalfPlane.I

theorem etaPhase_norm (γ : SL(2, ℤ)) : ‖etaPhase γ‖ = 1 :=
  Complex.norm_eq_one_of_pow_eq_one
    (etaPhase_pow_twentyFour γ) (by norm_num)

theorem etaPhase_ne_zero (γ : SL(2, ℤ)) : etaPhase γ ≠ 0 := by
  intro h
  have hn := etaPhase_norm γ
  rw [h, norm_zero] at hn
  norm_num at hn

/-- Dedekind eta's transformation law with the now-explicit constant phase. -/
theorem eta_transform (γ : SL(2, ℤ)) (z : ℍ) :
    ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) =
      etaPhase γ * etaSqrtFactor γ z *
        ModularForm.eta (z : ℂ) := by
  have h := etaPhaseRatio_eq γ z
  rw [etaPhaseRatio] at h
  have hden : etaSqrtFactor γ z * ModularForm.eta (z : ℂ) ≠ 0 :=
    mul_ne_zero (etaSqrtFactor_ne_zero γ z)
      (ModularForm.eta_ne_zero z.2)
  have hm := (div_eq_iff hden).mp h
  simpa [mul_assoc] using hm

@[simp]
theorem etaPhase_one : etaPhase (1 : SL(2, ℤ)) = 1 := by
  have h := eta_transform (1 : SL(2, ℤ)) UpperHalfPlane.I
  simp only [one_smul, etaSqrtFactor_one, mul_one] at h
  apply mul_right_cancel₀ (ModularForm.eta_ne_zero UpperHalfPlane.I.2)
  simpa using h.symm

/-- Raw inverse-eta factor in exactly the exponent convention used by
`HalfIntegralMultiplier` at `k = 1`. -/
noncomputable def inverseEtaRawFactor (γ : SL(2, ℤ)) (z : ℍ) : ℂ :=
  (etaPhase γ)⁻¹ * etaSqrtFactor γ z ^ (-1 : ℤ)

theorem inverseEtaRawFactor_eq (γ : SL(2, ℤ)) (z : ℍ) :
    inverseEtaRawFactor γ z =
      ModularForm.eta (z : ℂ) /
        ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) := by
  rw [inverseEtaRawFactor, zpow_neg_one, eta_transform]
  field_simp [etaPhase_ne_zero γ, etaSqrtFactor_ne_zero γ z,
    ModularForm.eta_ne_zero z.2]
  <;> ring

theorem inverseEtaRawFactor_one (z : ℍ) :
    inverseEtaRawFactor (1 : SL(2, ℤ)) z = 1 := by
  rw [inverseEtaRawFactor_eq]
  simp [ModularForm.eta_ne_zero z.2]

theorem inverseEtaRawFactor_mul (γ δ : SL(2, ℤ)) (z : ℍ) :
    inverseEtaRawFactor (γ * δ) z =
      inverseEtaRawFactor γ (δ • z) * inverseEtaRawFactor δ z := by
  rw [inverseEtaRawFactor_eq, inverseEtaRawFactor_eq,
    inverseEtaRawFactor_eq, mul_smul]
  simp only [div_eq_mul_inv]
  calc
    ModularForm.eta ↑z * (ModularForm.eta ↑(γ • δ • z))⁻¹ =
        (ModularForm.eta ↑(δ • z) *
          (ModularForm.eta ↑(δ • z))⁻¹) *
            (ModularForm.eta ↑z *
              (ModularForm.eta ↑(γ • δ • z))⁻¹) := by
      rw [mul_inv_cancel₀ (ModularForm.eta_ne_zero (δ • z).2), one_mul]
    _ =
        (ModularForm.eta ↑(δ • z) *
          (ModularForm.eta ↑(γ • δ • z))⁻¹) *
            (ModularForm.eta ↑z *
              (ModularForm.eta ↑(δ • z))⁻¹) := by ring

/-- Integer powers of the raw inverse-eta factor split into exactly the phase
and square-root exponents required by `HalfIntegralMultiplier Γ k`. -/
theorem inverseEtaRawFactor_zpow
    (γ : SL(2, ℤ)) (z : ℍ) (k : ℤ) :
    inverseEtaRawFactor γ z ^ k =
      ((etaPhase γ)⁻¹) ^ k * etaSqrtFactor γ z ^ (-k) := by
  rw [inverseEtaRawFactor, zpow_neg_one, mul_zpow,
    inv_zpow' (etaSqrtFactor γ z) k]

/-- The eta normalization gives a coherent multiplier at every doubled
half-integral weight `k`. -/
noncomputable def inverseEtaPowerMultiplier
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) : HalfIntegralMultiplier Γ k where
  nu γ := ((etaPhase (γ : SL(2, ℤ)))⁻¹) ^ k
  nu_one := by
    change ((etaPhase (1 : SL(2, ℤ)))⁻¹) ^ k = 1
    rw [etaPhase_one, inv_one, one_zpow]
  nu_norm γ := by
    simp only [norm_zpow, norm_inv, etaPhase_norm, inv_one, one_zpow]
  sqrtFactor γ z := etaSqrtFactor (γ : SL(2, ℤ)) z
  sqrtFactor_one := etaSqrtFactor_one
  sqrtFactor_sq := by
    intro γ z
    simpa using etaSqrtFactor_sq (γ : SL(2, ℤ)) z
  factor_cocycle := by
    intro γ δ z
    have h := congrArg (fun w : ℂ ↦ w ^ k)
      (inverseEtaRawFactor_mul
        (γ : SL(2, ℤ)) (δ : SL(2, ℤ)) z)
    rw [mul_zpow] at h
    change
      ((etaPhase (((γ * δ : Γ) : SL(2, ℤ))))⁻¹) ^ k *
          etaSqrtFactor (((γ * δ : Γ) : SL(2, ℤ))) z ^ (-k) = _
    rw [show (((γ * δ : Γ) : SL(2, ℤ))) =
      (γ : SL(2, ℤ)) * (δ : SL(2, ℤ)) by rfl]
    simpa only [inverseEtaRawFactor_zpow] using h

@[simp]
theorem inverseEtaPowerMultiplier_factor
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaPowerMultiplier Γ k).factor γ z =
      (ModularForm.eta (z : ℂ) /
        ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ)) ^ k := by
  change ((etaPhase (γ : SL(2, ℤ)))⁻¹) ^ k *
      etaSqrtFactor (γ : SL(2, ℤ)) z ^ (-k) = _
  calc
    ((etaPhase (γ : SL(2, ℤ)))⁻¹) ^ k *
        etaSqrtFactor (γ : SL(2, ℤ)) z ^ (-k) =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ k :=
        (inverseEtaRawFactor_zpow (γ : SL(2, ℤ)) z k).symm
    _ = (ModularForm.eta (z : ℂ) /
          ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ)) ^ k :=
      congrArg (fun w : ℂ ↦ w ^ k)
        (inverseEtaRawFactor_eq (γ : SL(2, ℤ)) z)

/-- Pointwise action-kernel compatibility follows from the eta ratio itself. -/
theorem inverseEtaPowerMultiplier_factor_eq_one_of_fixed
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) (γ : Γ) (z : ℍ)
    (hfix : (γ : SL(2, ℤ)) • z = z) :
    (inverseEtaPowerMultiplier Γ k).factor γ z = 1 := by
  rw [inverseEtaPowerMultiplier_factor, hfix,
    div_self (ModularForm.eta_ne_zero z.2), one_zpow]

/-- A concrete half-integral multiplier on every subgroup of `SL(2, Z)`.
Its total factor is `eta(z) / eta(gamma z)`. -/
noncomputable def inverseEtaMultiplier
    (Γ : Subgroup SL(2, ℤ)) : HalfIntegralMultiplier Γ 1 :=
  inverseEtaPowerMultiplier Γ 1

@[simp]
theorem inverseEtaMultiplier_factor
    (Γ : Subgroup SL(2, ℤ)) (γ : Γ) (z : ℍ) :
    (inverseEtaMultiplier Γ).factor γ z =
      ModularForm.eta (z : ℂ) /
        ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) := by
  simpa [inverseEtaMultiplier] using
    inverseEtaPowerMultiplier_factor Γ 1 γ z

/-- The fixed eta phase orbit through the paper's exponent `a = -1`.
The step `n` has multiplier index `1 - 4n`, hence exponent `-1 + 4n`. -/
noncomputable def inverseEtaHalfOrbitMultiplier
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) :
    HalfIntegralMultiplier Γ (1 - 4 * n) :=
  shiftByFour (inverseEtaMultiplier Γ) n

@[simp]
theorem inverseEtaHalfOrbitMultiplier_factor
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaHalfOrbitMultiplier Γ n).factor γ z =
      (inverseEtaMultiplier Γ).factor γ z *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n) := by
  change (shiftByFour (inverseEtaMultiplier Γ) n).factor γ z = _
  exact shiftByFour_factor (inverseEtaMultiplier Γ) n γ z

/-- Advancing one raising step preserves the eta phase and multiplies only by
the ordinary denominator square. -/
theorem inverseEtaHalfOrbitMultiplier_factor_add_one
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaHalfOrbitMultiplier Γ (n + 1)).factor γ z =
      (inverseEtaHalfOrbitMultiplier Γ n).factor γ z *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ (2 : ℕ) := by
  rw [inverseEtaHalfOrbitMultiplier_factor,
    inverseEtaHalfOrbitMultiplier_factor]
  have hd : UpperHalfPlane.denom
      ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ≠ 0 :=
    UpperHalfPlane.denom_ne_zero
      ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z
  rw [show (2 : ℤ) * (n + 1) = (2 : ℤ) * n + 2 by ring,
    zpow_add₀ hd ((2 : ℤ) * n) (2 : ℤ), zpow_ofNat]
  ring

/-- Natural Hermitian fiber scale at arbitrary doubled weight index `k`. -/
noncomputable def weightFiberScale (k : ℤ) (z : ℍ) : ℝ :=
  (Real.sqrt z.im) ^ (-k)

theorem weightFiberScale_pos (k : ℤ) (z : ℍ) :
    0 < weightFiberScale k z :=
  zpow_pos (Real.sqrt_pos.2 z.im_pos) (-k)

/-- Exact square-root transformation of the height coordinate. -/
theorem sqrt_im_smul_eq (γ : Γ) (z : ℍ) :
    Real.sqrt (((γ : SL(2, ℤ)) • z).im) =
      Real.sqrt z.im /
        ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ := by
  rw [ModularGroup.im_smul_eq_div_normSq,
    Complex.normSq_eq_norm_sq,
    Real.sqrt_div z.im_pos.le,
    Real.sqrt_sq (norm_nonneg
      (UpperHalfPlane.denom (γ : SL(2, ℤ)) z))]

theorem weightFiberScale_covariance
    (M : HalfIntegralMultiplier Γ k) (γ : Γ) (z : ℍ) :
    weightFiberScale k ((γ : SL(2, ℤ)) • z) *
        ‖M.factor γ z‖ ^ 2 =
      weightFiberScale k z := by
  have hd : UpperHalfPlane.denom (γ : SL(2, ℤ)) z ≠ 0 :=
    UpperHalfPlane.denom_ne_zero (γ : SL(2, ℤ)) z
  have hdn : ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ ≠ 0 :=
    norm_ne_zero_iff.mpr hd
  have hpow :
      ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ ^ (-k) ≠ 0 :=
    zpow_ne_zero (-k) hdn
  rw [weightFiberScale, weightFiberScale,
    sqrt_im_smul_eq γ z, M.norm_factor_sq γ z,
    div_zpow, div_mul_cancel₀ _ hpow]

/-- The natural fiber scale for the paper's weight `1/2` convention. -/
noncomputable def halfWeightScale (z : ℍ) : ℝ :=
  (Real.sqrt z.im)⁻¹

theorem halfWeightScale_pos (z : ℍ) : 0 < halfWeightScale z :=
  inv_pos.mpr (Real.sqrt_pos.2 z.im_pos)

@[simp]
theorem weightFiberScale_one (z : ℍ) :
    weightFiberScale 1 z = halfWeightScale z := by
  simp [weightFiberScale, halfWeightScale, zpow_neg_one]

/-- Weight sections are the linear subspace of functions satisfying the
half-integral covariance law.  Using a `Submodule` gives extensionality,
addition, subtraction, and scalar multiplication without duplicating algebra.
-/
def weightSectionSubmodule (M : HalfIntegralMultiplier Γ k) :
    Submodule ℂ (ℍ → ℂ) where
  carrier := {u | ∀ (γ : Γ) z,
    u ((γ : SL(2, ℤ)) • z) = M.factor γ z * u z}
  zero_mem' := by
    intro γ z
    simp
  add_mem' := by
    intro u v hu hv γ z
    simp only [Pi.add_apply, hu γ z, hv γ z]
    ring
  smul_mem' := by
    intro c u hu γ z
    simp only [Pi.smul_apply, smul_eq_mul, hu γ z]
    ring

/-- A function together with its weight-`k/2` covariance proof. -/
abbrev WeightSection (M : HalfIntegralMultiplier Γ k) :=
  M.weightSectionSubmodule

namespace WeightSection

variable {M : HalfIntegralMultiplier Γ k}

instance instCoeFun : CoeFun (WeightSection M) (fun _ => ℍ → ℂ) where
  coe u := u.1

@[simp]
theorem covariance (u : WeightSection M) (γ : Γ) (z : ℍ) :
    u ((γ : SL(2, ℤ)) • z) = M.factor γ z * u z :=
  u.2 γ z

/-- At a fixed point, a nonzero section forces the total automorphy factor to
act trivially.  Applied to the central element `-I`, this is the compatibility
condition omitted by a bare principal-square-root convention. -/
theorem factor_eq_one_of_fixed_nonzero (u : WeightSection M)
    (γ : Γ) (z : ℍ)
    (hfix : (γ : SL(2, ℤ)) • z = z) (hu : u z ≠ 0) :
    M.factor γ z = 1 := by
  have hcov := WeightSection.covariance u γ z
  rw [hfix] at hcov
  apply mul_right_cancel₀ hu
  simpa using hcov.symm

/-- A nontrivial stabilizer action forces every covariant section to vanish at
that fixed point. -/
theorem eq_zero_at_of_fixed_factor_ne_one (u : WeightSection M)
    (γ : Γ) (z : ℍ)
    (hfix : (γ : SL(2, ℤ)) • z = z)
    (hfactor : M.factor γ z ≠ 1) :
    u z = 0 := by
  by_contra hu
  exact hfactor (WeightSection.factor_eq_one_of_fixed_nonzero u γ z hfix hu)

/-- Equality of sections is pointwise equality of their representing
functions. -/
@[ext]
theorem ext_apply {u v : WeightSection M}
    (h : ∀ z, u z = v z) :
    u = v :=
  Subtype.ext (funext h)

@[simp]
theorem zero_apply (z : ℍ) : (0 : WeightSection M) z = 0 :=
  rfl

@[simp]
theorem add_apply (u v : WeightSection M) (z : ℍ) :
    (u + v) z = u z + v z :=
  rfl

@[simp]
theorem neg_apply (u : WeightSection M) (z : ℍ) :
    (-u) z = -u z :=
  rfl

@[simp]
theorem sub_apply (u v : WeightSection M) (z : ℍ) :
    (u - v) z = u z - v z :=
  rfl

@[simp]
theorem smul_apply (c : ℂ) (u : WeightSection M) (z : ℍ) :
    (c • u) z = c * u z :=
  rfl

/-! #### Raw unweighted norm defect

The holomorphic covariance convention does not make the raw pointwise norm
invariant.  The next lemmas record its exact scaling law before the invariant
fiber metric is introduced below. -/

/-- Raw pointwise norm, with no compensating line-bundle metric. -/
noncomputable def rawPointwiseNorm (u : WeightSection M) (z : ℍ) : ℝ :=
  ‖u z‖

/-- Raw unweighted norm-square density. -/
noncomputable def rawPointwiseNormSq (u : WeightSection M) (z : ℍ) : ℝ :=
  ‖u z‖ ^ 2

/-- Exact transformation law for the raw pointwise norm. -/
theorem rawPointwiseNorm_smul (u : WeightSection M)
    (γ : Γ) (z : ℍ) :
    rawPointwiseNorm u ((γ : SL(2, ℤ)) • z) =
      ‖M.factor γ z‖ * rawPointwiseNorm u z := by
  rw [rawPointwiseNorm, rawPointwiseNorm, WeightSection.covariance u γ z, norm_mul]

/-- Exact transformation law for the raw unweighted norm-square density. -/
theorem rawPointwiseNormSq_smul (u : WeightSection M)
    (γ : Γ) (z : ℍ) :
    rawPointwiseNormSq u ((γ : SL(2, ℤ)) • z) =
      ‖M.factor γ z‖ ^ 2 * rawPointwiseNormSq u z := by
  rw [rawPointwiseNormSq, rawPointwiseNormSq, WeightSection.covariance u γ z, norm_mul]
  ring

/-- The raw norm-square defect factors into the metric-scaling defect and the
original raw density. -/
theorem rawPointwiseNormSq_smul_sub (u : WeightSection M)
    (γ : Γ) (z : ℍ) :
    rawPointwiseNormSq u ((γ : SL(2, ℤ)) • z) -
        rawPointwiseNormSq u z =
      (‖M.factor γ z‖ ^ 2 - 1) * rawPointwiseNormSq u z := by
  rw [rawPointwiseNormSq_smul]
  ring

/-- At physical weight `1/2`, the exact raw-density multiplier is
`|c z + d|⁻¹`. -/
theorem rawPointwiseNormSq_smul_halfWeight
    (M : HalfIntegralMultiplier Γ 1) (u : WeightSection M)
    (γ : Γ) (z : ℍ) :
    rawPointwiseNormSq u ((γ : SL(2, ℤ)) • z) =
      ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖⁻¹ *
        rawPointwiseNormSq u z := by
  rw [rawPointwiseNormSq_smul, M.norm_factor_sq_one]

/-- If the automorphy factor changes length and the section is nonzero, the
raw pointwise norm cannot be invariant at that point. -/
theorem rawPointwiseNorm_ne_of_factor_norm_ne_one
    (u : WeightSection M) (γ : Γ) (z : ℍ)
    (hfactor : ‖M.factor γ z‖ ≠ 1) (hu : u z ≠ 0) :
    rawPointwiseNorm u ((γ : SL(2, ℤ)) • z) ≠
      rawPointwiseNorm u z := by
  rw [rawPointwiseNorm_smul]
  intro hEq
  apply hfactor
  apply mul_right_cancel₀ (norm_ne_zero_iff.mpr hu)
  simpa [rawPointwiseNorm] using hEq

/-- Under the same nondegeneracy hypotheses, the raw norm-square density is
also genuinely non-invariant. -/
theorem rawPointwiseNormSq_ne_of_factor_norm_ne_one
    (u : WeightSection M) (γ : Γ) (z : ℍ)
    (hfactor : ‖M.factor γ z‖ ≠ 1) (hu : u z ≠ 0) :
    rawPointwiseNormSq u ((γ : SL(2, ℤ)) • z) ≠
      rawPointwiseNormSq u z := by
  intro hSq
  apply rawPointwiseNorm_ne_of_factor_norm_ne_one u γ z hfactor hu
  unfold rawPointwiseNorm
  unfold rawPointwiseNormSq at hSq
  nlinarith [norm_nonneg (u ((γ : SL(2, ℤ)) • z)), norm_nonneg (u z)]

end WeightSection

/-! #### Canonical eta-power sections at every integer index -/

/-- Cancellation identity used by the eta-power section.  Only `a ≠ 0` is
needed; no illicit cancellation of `b` occurs. -/
theorem div_zpow_mul_zpow_neg_cancel
    (a b : ℂ) (k : ℤ) (ha : a ≠ 0) :
    (a / b) ^ k * a ^ (-k) = b ^ (-k) := by
  calc
    (a / b) ^ k * a ^ (-k) =
        b ^ (-k) * (a ^ (-k) * a ^ k) := by
      rw [div_zpow, div_eq_mul_inv, ← zpow_neg b k]
      ring
    _ = b ^ (-k) := by
      rw [zpow_neg_mul_zpow_self k ha, mul_one]

/-- `eta^(-k)` is a nowhere-vanishing section of the weight-`k/2`
inverse-eta multiplier for every subgroup.  This witnesses nontriviality of
the section space; it does not claim compact quotient support or finite
Sobolev energy. -/
noncomputable def inverseEtaPowerSection
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) :
    WeightSection (inverseEtaPowerMultiplier Γ k) := by
  refine ⟨(fun z ↦ ModularForm.eta (z : ℂ) ^ (-k)), ?_⟩
  intro γ z
  change
    ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ) ^ (-k) =
      (inverseEtaPowerMultiplier Γ k).factor γ z *
        ModularForm.eta (z : ℂ) ^ (-k)
  rw [inverseEtaPowerMultiplier_factor]
  symm
  exact div_zpow_mul_zpow_neg_cancel
    (ModularForm.eta (z : ℂ))
    (ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ))
    k (ModularForm.eta_ne_zero z.2)

theorem inverseEtaPowerSection_apply_ne_zero
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) (z : ℍ) :
    inverseEtaPowerSection Γ k z ≠ 0 := by
  change ModularForm.eta (z : ℂ) ^ (-k) ≠ 0
  exact zpow_ne_zero (-k) (ModularForm.eta_ne_zero z.2)

theorem inverseEtaPowerSection_ne_zero
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) :
    inverseEtaPowerSection Γ k ≠
      (0 : WeightSection (inverseEtaPowerMultiplier Γ k)) := by
  intro h
  have hI := congrArg
    (fun u : WeightSection (inverseEtaPowerMultiplier Γ k) ↦
      u UpperHalfPlane.I) h
  rw [WeightSection.zero_apply] at hI
  exact inverseEtaPowerSection_apply_ne_zero
    Γ k UpperHalfPlane.I hI

/-- Reindex the eta-power multipliers by the differential layer's exponent
index `a`; its multiplier index is `-a` by convention.

This is a useful family of genuine multipliers and nowhere-zero sections, but
it must not be confused with a raising/lowering tower: shifting `a` by four
also shifts the eta phase by its fourth power, whereas the raw differential
operators preserve the phase character.  A covariant differential tower must
therefore use a fixed-phase family on each residue class modulo four. -/
noncomputable def inverseEtaExponentMultiplier
    (Γ : Subgroup SL(2, ℤ)) (a : ℤ) :
    HalfIntegralMultiplier Γ (-a) :=
  inverseEtaPowerMultiplier Γ (-a)

/-- The raw inverse-eta factor is nowhere zero. -/
theorem inverseEtaRawFactor_ne_zero (γ : SL(2, ℤ)) (z : ℍ) :
    inverseEtaRawFactor γ z ≠ 0 := by
  unfold inverseEtaRawFactor
  exact mul_ne_zero (inv_ne_zero (etaPhase_ne_zero γ))
    (zpow_ne_zero (-1) (etaSqrtFactor_ne_zero γ z))

/-- Inverting the raw inverse-eta factor recovers the fixed eta phase times
the chosen square root. -/
theorem inverseEtaRawFactor_inv (γ : SL(2, ℤ)) (z : ℍ) :
    (inverseEtaRawFactor γ z)⁻¹ =
      etaPhase γ * etaSqrtFactor γ z := by
  simp only [inverseEtaRawFactor, zpow_neg_one, mul_inv_rev, inv_inv]
  exact mul_comm _ _

/-- The raising-step discrepancy is the fourth power of the eta phase times
the ordinary integral-weight denominator square. -/
theorem inverseEtaRawFactor_zpow_neg_four
    (γ : SL(2, ℤ)) (z : ℍ) :
    inverseEtaRawFactor γ z ^ (-4 : ℤ) =
      etaPhase γ ^ (4 : ℕ) *
        UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ (2 : ℕ) := by
  calc
    inverseEtaRawFactor γ z ^ (-4 : ℤ) =
        ((inverseEtaRawFactor γ z)⁻¹) ^ (4 : ℤ) :=
      (inv_zpow' (inverseEtaRawFactor γ z) (4 : ℤ)).symm
    _ = (etaPhase γ * etaSqrtFactor γ z) ^ (4 : ℤ) := by
      rw [inverseEtaRawFactor_inv]
    _ = etaPhase γ ^ (4 : ℤ) *
        etaSqrtFactor γ z ^ (4 : ℤ) := by
      rw [mul_zpow]
    _ = etaPhase γ ^ (4 : ℕ) *
        etaSqrtFactor γ z ^ (4 : ℕ) := by
      simp only [zpow_ofNat]
    _ = etaPhase γ ^ (4 : ℕ) *
        UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ (2 : ℕ) := by
      rw [show etaSqrtFactor γ z ^ (4 : ℕ) =
        (etaSqrtFactor γ z ^ (2 : ℕ)) ^ (2 : ℕ) by ring,
        etaSqrtFactor_sq]

/-- The reciprocal fourth power, used by the lowering shift. -/
theorem inverseEtaRawFactor_zpow_four
    (γ : SL(2, ℤ)) (z : ℍ) :
    inverseEtaRawFactor γ z ^ (4 : ℤ) =
      (etaPhase γ ^ (4 : ℕ) *
        UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ (2 : ℕ))⁻¹ := by
  calc
    inverseEtaRawFactor γ z ^ (4 : ℤ) =
        (inverseEtaRawFactor γ z ^ (-4 : ℤ))⁻¹ := by
      rw [zpow_neg, inv_inv]
    _ = (etaPhase γ ^ (4 : ℕ) *
        UpperHalfPlane.denom (γ : GL (Fin 2) ℝ) z ^ (2 : ℕ))⁻¹ :=
      congrArg Inv.inv (inverseEtaRawFactor_zpow_neg_four γ z)

/-- Expose an eta-power multiplier factor as an integer power of the raw
weight-one factor. -/
theorem inverseEtaPowerMultiplier_factor_eq_raw
    (Γ : Subgroup SL(2, ℤ)) (k : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaPowerMultiplier Γ k).factor γ z =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ k := by
  change ((etaPhase (γ : SL(2, ℤ)))⁻¹) ^ k *
      etaSqrtFactor (γ : SL(2, ℤ)) z ^ (-k) = _
  exact (inverseEtaRawFactor_zpow (γ : SL(2, ℤ)) z k).symm

/-- Shifting the eta-power exponent by the raising step `a ↦ a + 4`
introduces the fourth inverse power of the raw eta factor.  In particular,
this reindexed eta-power family does not silently preserve a fixed phase
character. -/
theorem inverseEtaExponentMultiplier_raise_shift_ratio
    (Γ : Subgroup SL(2, ℤ)) (a : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaExponentMultiplier Γ (a + 4)).factor γ z =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ (-4 : ℤ) *
        (inverseEtaExponentMultiplier Γ a).factor γ z := by
  change
    (inverseEtaPowerMultiplier Γ (-(a + 4))).factor γ z =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ (-4 : ℤ) *
        (inverseEtaPowerMultiplier Γ (-a)).factor γ z
  rw [inverseEtaPowerMultiplier_factor_eq_raw,
    inverseEtaPowerMultiplier_factor_eq_raw]
  rw [show -(a + 4) = (-4 : ℤ) + (-a) by omega,
    zpow_add₀ (inverseEtaRawFactor_ne_zero (γ : SL(2, ℤ)) z)]

/-- Expanded form of the raising-step discrepancy.  A fixed-character
differential tower has only the denominator-square factor; the additional
`etaPhase ^ 4` here is precisely why the eta-power reindexing is not that
tower. -/
theorem inverseEtaExponentMultiplier_raise_shift_phase
    (Γ : Subgroup SL(2, ℤ)) (a : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaExponentMultiplier Γ (a + 4)).factor γ z =
      etaPhase (γ : SL(2, ℤ)) ^ (4 : ℕ) *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ (2 : ℕ) *
        (inverseEtaExponentMultiplier Γ a).factor γ z := by
  rw [inverseEtaExponentMultiplier_raise_shift_ratio,
    inverseEtaRawFactor_zpow_neg_four]

/-- The lowering step has the reciprocal phase shift. -/
theorem inverseEtaExponentMultiplier_lower_shift_ratio
    (Γ : Subgroup SL(2, ℤ)) (a : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaExponentMultiplier Γ (a - 4)).factor γ z =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ (4 : ℤ) *
        (inverseEtaExponentMultiplier Γ a).factor γ z := by
  change
    (inverseEtaPowerMultiplier Γ (-(a - 4))).factor γ z =
      inverseEtaRawFactor (γ : SL(2, ℤ)) z ^ (4 : ℤ) *
        (inverseEtaPowerMultiplier Γ (-a)).factor γ z
  rw [inverseEtaPowerMultiplier_factor_eq_raw,
    inverseEtaPowerMultiplier_factor_eq_raw]
  rw [show -(a - 4) = (4 : ℤ) + (-a) by omega,
    zpow_add₀ (inverseEtaRawFactor_ne_zero (γ : SL(2, ℤ)) z)]

/-- Expanded lowering-step discrepancy, reciprocal to the raising phase and
denominator square. -/
theorem inverseEtaExponentMultiplier_lower_shift_phase
    (Γ : Subgroup SL(2, ℤ)) (a : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaExponentMultiplier Γ (a - 4)).factor γ z =
      (etaPhase (γ : SL(2, ℤ)) ^ (4 : ℕ) *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ (2 : ℕ))⁻¹ *
        (inverseEtaExponentMultiplier Γ a).factor γ z := by
  rw [inverseEtaExponentMultiplier_lower_shift_ratio,
    inverseEtaRawFactor_zpow_four]

/-- A Hermitian fiber metric is recorded by its positive scale.  The
covariance equation is exactly the condition needed to compensate for the
non-unit norm of `(c z + d)^(-k/2)`.
-/
structure InvariantFiberMetric (M : HalfIntegralMultiplier Γ k) where
  scale : ℍ → ℝ
  scale_pos : ∀ z, 0 < scale z
  scale_covariance : ∀ (γ : Γ) z,
    scale ((γ : SL(2, ℤ)) • z) * ‖M.factor γ z‖ ^ 2 = scale z

namespace InvariantFiberMetric

variable {M : HalfIntegralMultiplier Γ k}

/-- Every integer-index half-integral multiplier carries its canonical
height-compensated Hermitian fiber metric. -/
noncomputable def weightFiberMetric
    (M : HalfIntegralMultiplier Γ k) : InvariantFiberMetric M where
  scale := weightFiberScale k
  scale_pos := weightFiberScale_pos k
  scale_covariance := weightFiberScale_covariance M

/-- The natural `y⁻¹ᐟ²` Hermitian metric for a weight-`1/2` section.

This is constructed from the upper-half-plane transformation law and is not
an extra paper hypothesis.  It also makes explicit why the raw unweighted
`|u|²` density displayed later in the PDF is not invariant under the stated
holomorphic factor `(c z + d)⁻¹ᐟ²`.
-/
noncomputable def halfWeightFiberMetric
    (M : HalfIntegralMultiplier Γ 1) : InvariantFiberMetric M where
  scale := halfWeightScale
  scale_pos := halfWeightScale_pos
  scale_covariance := by
    intro γ z
    have hd : UpperHalfPlane.denom (γ : SL(2, ℤ)) z ≠ 0 :=
      UpperHalfPlane.denom_ne_zero (γ : SL(2, ℤ)) z
    have hdn : ‖UpperHalfPlane.denom (γ : SL(2, ℤ)) z‖ ≠ 0 :=
      norm_ne_zero_iff.mpr hd
    rw [halfWeightScale, halfWeightScale,
      ModularGroup.im_smul_eq_div_normSq,
      Complex.normSq_eq_norm_sq,
      M.norm_factor_sq_one,
      Real.sqrt_div z.im_pos.le,
      Real.sqrt_sq (norm_nonneg
        (UpperHalfPlane.denom (γ : SL(2, ℤ)) z))]
    rw [inv_div, div_mul_eq_mul_div, mul_inv_cancel₀ hdn, one_div]

/-- Pointwise squared norm in the selected Hermitian fiber metric. -/
noncomputable def pointwiseNormSq (m : InvariantFiberMetric M)
    (u : WeightSection M) (z : ℍ) : ℝ :=
  m.scale z * ‖u z‖ ^ 2

theorem pointwiseNormSq_nonneg (m : InvariantFiberMetric M)
    (u : WeightSection M) (z : ℍ) :
    0 ≤ m.pointwiseNormSq u z :=
  mul_nonneg (m.scale_pos z).le (sq_nonneg ‖u z‖)

theorem pointwiseNormSq_eq_zero_iff (m : InvariantFiberMetric M)
    (u : WeightSection M) (z : ℍ) :
    m.pointwiseNormSq u z = 0 ↔ u z = 0 := by
  constructor
  · intro h
    have hnormSq : ‖u z‖ ^ 2 = 0 :=
      (mul_eq_zero.mp h).resolve_left (ne_of_gt (m.scale_pos z))
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hnormSq)
  · rintro h
    simp [pointwiseNormSq, h]

/-- Pointwise Hermitian cross-density, conjugate-linear in the first slot and
linear in the second. -/
noncomputable def pointwiseInnerDensity (m : InvariantFiberMetric M)
    (u v : WeightSection M) (z : ℍ) : ℂ :=
  (m.scale z : ℂ) * star (u z) * v z

@[simp]
theorem pointwiseInnerDensity_add_left
    (m : InvariantFiberMetric M) (u v w : WeightSection M) (z : ℍ) :
    m.pointwiseInnerDensity (u + v) w z =
      m.pointwiseInnerDensity u w z +
        m.pointwiseInnerDensity v w z := by
  simp only [pointwiseInnerDensity, HalfIntegralMultiplier.WeightSection.add_apply, star_add]
  ring

@[simp]
theorem pointwiseInnerDensity_smul_left
    (m : InvariantFiberMetric M) (c : ℂ)
    (u v : WeightSection M) (z : ℍ) :
    m.pointwiseInnerDensity (c • u) v z =
      star c * m.pointwiseInnerDensity u v z := by
  simp only [pointwiseInnerDensity, HalfIntegralMultiplier.WeightSection.smul_apply, star_mul]
  ring

@[simp]
theorem pointwiseInnerDensity_add_right
    (m : InvariantFiberMetric M) (u v w : WeightSection M) (z : ℍ) :
    m.pointwiseInnerDensity u (v + w) z =
      m.pointwiseInnerDensity u v z +
        m.pointwiseInnerDensity u w z := by
  simp only [pointwiseInnerDensity, HalfIntegralMultiplier.WeightSection.add_apply]
  ring

@[simp]
theorem pointwiseInnerDensity_smul_right
    (m : InvariantFiberMetric M) (c : ℂ)
    (u v : WeightSection M) (z : ℍ) :
    m.pointwiseInnerDensity u (c • v) z =
      c * m.pointwiseInnerDensity u v z := by
  simp only [pointwiseInnerDensity, HalfIntegralMultiplier.WeightSection.smul_apply]
  ring

theorem pointwiseInnerDensity_conj_symm
    (m : InvariantFiberMetric M) (u v : WeightSection M) (z : ℍ) :
    star (m.pointwiseInnerDensity v u z) =
      m.pointwiseInnerDensity u v z := by
  have hscale : star (m.scale z : ℂ) = (m.scale z : ℂ) := by
    simp
  simp only [pointwiseInnerDensity, star_mul, star_star, hscale]
  ring

@[simp]
theorem pointwiseInnerDensity_self
    (m : InvariantFiberMetric M) (u : WeightSection M) (z : ℍ) :
    m.pointwiseInnerDensity u u z =
      (m.pointwiseNormSq u z : ℂ) := by
  rw [pointwiseInnerDensity, pointwiseNormSq, mul_assoc]
  change
    (m.scale z : ℂ) * ((starRingEnd ℂ) (u z) * u z) =
      (m.scale z * ‖u z‖ ^ 2 : ℝ)
  rw [Complex.conj_mul', Complex.ofReal_mul]
  norm_cast

/-- The full cross-density, not only its diagonal, is invariant. -/
theorem pointwiseInnerDensity_smul
    (m : InvariantFiberMetric M) (u v : WeightSection M)
    (γ : Γ) (z : ℍ) :
    m.pointwiseInnerDensity u v ((γ : SL(2, ℤ)) • z) =
      m.pointwiseInnerDensity u v z := by
  rw [pointwiseInnerDensity, pointwiseInnerDensity,
    WeightSection.covariance u γ z, WeightSection.covariance v γ z, star_mul]
  have hmetric :
      (m.scale ((γ : SL(2, ℤ)) • z) : ℂ) *
          (star (M.factor γ z) * M.factor γ z) =
        (m.scale z : ℂ) := by
    change (m.scale ((γ : SL(2, ℤ)) • z) : ℂ) *
        ((starRingEnd ℂ) (M.factor γ z) * M.factor γ z) =
      (m.scale z : ℂ)
    rw [Complex.conj_mul']
    simpa only [Complex.ofReal_mul, Complex.ofReal_pow] using
      congrArg (fun r : ℝ => (r : ℂ))
        (m.scale_covariance γ z)
  calc
    (m.scale ((γ : SL(2, ℤ)) • z) : ℂ) *
          (star (u z) * star (M.factor γ z)) *
          (M.factor γ z * v z) =
      ((m.scale ((γ : SL(2, ℤ)) • z) : ℂ) *
          (star (M.factor γ z) * M.factor γ z)) *
        (star (u z) * v z) := by ring
    _ = (m.scale z : ℂ) * (star (u z) * v z) := by
      rw [hmetric]
    _ = (m.scale z : ℂ) * star (u z) * v z := by
      ring

/-- The selected fiber metric makes the pointwise norm density genuinely
`Γ`-invariant. -/
theorem pointwiseNormSq_smul (m : InvariantFiberMetric M)
    (u : WeightSection M) (γ : Γ) (z : ℍ) :
    m.pointwiseNormSq u ((γ : SL(2, ℤ)) • z) =
      m.pointwiseNormSq u z := by
  rw [pointwiseNormSq, pointwiseNormSq, WeightSection.covariance,
    norm_mul]
  calc
    m.scale ((γ : SL(2, ℤ)) • z) *
        (‖M.factor γ z‖ * ‖u z‖) ^ 2 =
      (m.scale ((γ : SL(2, ℤ)) • z) * ‖M.factor γ z‖ ^ 2) *
        ‖u z‖ ^ 2 := by ring
    _ = m.scale z * ‖u z‖ ^ 2 := by
      rw [m.scale_covariance]

/-- The corrected fiber-metric density remains invariant precisely where the
raw unweighted density is forced to change. -/
theorem rawPointwiseNormSq_noninvariant_but_metric_invariant
    (m : InvariantFiberMetric M) (u : WeightSection M)
    (γ : Γ) (z : ℍ)
    (hfactor : ‖M.factor γ z‖ ≠ 1) (hu : u z ≠ 0) :
    WeightSection.rawPointwiseNormSq u ((γ : SL(2, ℤ)) • z) ≠
        WeightSection.rawPointwiseNormSq u z ∧
      m.pointwiseNormSq u ((γ : SL(2, ℤ)) • z) =
        m.pointwiseNormSq u z :=
  ⟨WeightSection.rawPointwiseNormSq_ne_of_factor_norm_ne_one
      u γ z hfactor hu,
    m.pointwiseNormSq_smul u γ z⟩

end InvariantFiberMetric

/-- Interface for a physical weight-`1/2` multiplier on `Gamma(2)` whose
total factor is trivial on the action kernel.  The PDF does not determine a
unique inhabitant because it omits branch and generator normalization data;
`inverseEtaPaperCertificate` below provides one explicit valid choice. -/
structure PaperHalfWeightCertificate where
  multiplier : HalfIntegralMultiplier (CongruenceSubgroup.Gamma 2) 1
  effective_on_action_kernel :
    ∀ γ : CongruenceSubgroup.Gamma 2,
      (∀ z : ℍ, (γ : SL(2, ℤ)) • z = z) →
        ∀ z : ℍ, multiplier.factor γ z = 1

/-- The central element `-I` belongs to `Gamma(2)`. -/
def gammaTwoNegOne : CongruenceSubgroup.Gamma 2 :=
  ⟨-1, by simp [CongruenceSubgroup.Gamma_mem]⟩

@[simp]
theorem gammaTwoNegOne_smul (z : ℍ) :
    ((gammaTwoNegOne : CongruenceSubgroup.Gamma 2) : SL(2, ℤ)) • z = z := by
  change (-(1 : SL(2, ℤ))) • z = z
  rw [ModularGroup.SL_neg_smul]
  simp

/-- A paper multiplier intended to admit nonzero sections must cancel the
central metaplectic sign. -/
theorem PaperHalfWeightCertificate.factor_gammaTwoNegOne
    (P : PaperHalfWeightCertificate) (z : ℍ) :
    P.multiplier.factor gammaTwoNegOne z = 1 :=
  P.effective_on_action_kernel gammaTwoNegOne gammaTwoNegOne_smul z

/-- The paper certificate has a canonical invariant fiber metric; it is not an
additional assumption. -/
noncomputable def PaperHalfWeightCertificate.fiberMetric
    (P : PaperHalfWeightCertificate) : InvariantFiberMetric P.multiplier :=
  InvariantFiberMetric.halfWeightFiberMetric P.multiplier

/-- A genuine inhabitant of the paper certificate obtained from the explicit
inverse-Dedekind-eta normalization above.  This supplies a mathematically
valid concrete choice; it does not assert that the PDF's unnamed `nu` was
intended to use this normalization. -/
noncomputable def inverseEtaPaperCertificate : PaperHalfWeightCertificate where
  multiplier := inverseEtaMultiplier (CongruenceSubgroup.Gamma 2)
  effective_on_action_kernel := by
    intro γ hfix z
    rw [inverseEtaMultiplier_factor, hfix z,
      div_self (ModularForm.eta_ne_zero z.2)]

/-- The inverse eta function is an actual nowhere-vanishing weight-`1/2`
weight section for the concrete multiplier. -/
noncomputable def inverseEtaSection :
    WeightSection inverseEtaPaperCertificate.multiplier := by
  refine ⟨(fun z ↦ (ModularForm.eta (z : ℂ))⁻¹), ?_⟩
  intro γ z
  change
    (ModularForm.eta (((γ : SL(2, ℤ)) • z : ℍ) : ℂ))⁻¹ =
      (inverseEtaMultiplier (CongruenceSubgroup.Gamma 2)).factor γ z *
        (ModularForm.eta (z : ℂ))⁻¹
  rw [inverseEtaMultiplier_factor]
  field_simp [ModularForm.eta_ne_zero z.2,
    ModularForm.eta_ne_zero ((γ : SL(2, ℤ)) • z).2]
  <;> ring

theorem inverseEtaSection_apply_ne_zero (z : ℍ) :
    inverseEtaSection z ≠ 0 := by
  change (ModularForm.eta (z : ℂ))⁻¹ ≠ 0
  exact inv_ne_zero (ModularForm.eta_ne_zero z.2)

theorem inverseEtaSection_ne_zero :
    inverseEtaSection ≠
      (0 : WeightSection inverseEtaPaperCertificate.multiplier) := by
  intro h
  have hI := congrArg
    (fun u : WeightSection inverseEtaPaperCertificate.multiplier ↦
      u UpperHalfPlane.I) h
  rw [WeightSection.zero_apply] at hI
  exact inverseEtaSection_apply_ne_zero UpperHalfPlane.I hI

end HalfIntegralMultiplier

/-! ### 6.3: the effective `Gamma(2)` quotient and hyperbolic measure

The action of `Gamma(2)` on the upper half-plane is not faithful: its distinct
central elements `1` and `-1` act identically.  In particular, a positive-measure
fundamental domain cannot satisfy `IsFundamentalDomain (Gamma 2) ...` literally,
because that predicate asks distinct translates to be almost disjoint.  We take
the image of the permutation action before forming the orbit quotient.  This
does not change any orbit, but removes exactly this formal obstruction.
-/

namespace GammaTwoQuotientGeometry

open MeasureTheory
open scoped NNReal

/-- The paper's congruence subgroup. -/
abbrev GammaTwo := CongruenceSubgroup.Gamma 2

/-- The faithful image of `Gamma(2)` in the permutation group of `ℍ`. -/
abbrev GammaTwoEffective : Type :=
  (MulAction.toPermHom GammaTwo ℍ).range

/-- The orbit quotient by the effective action. -/
abbrev GammaTwoQuotient : Type :=
  MulAction.orbitRel.Quotient GammaTwoEffective ℍ

/-- Send a matrix in `Gamma(2)` to its induced effective transformation. -/
noncomputable def gammaTwoEffectiveElement (γ : GammaTwo) : GammaTwoEffective :=
  (MulAction.toPermHom GammaTwo ℍ).rangeRestrict γ

/-- The canonical map from the upper half-plane to the effective quotient. -/
noncomputable def gammaTwoQuotientMk : ℍ → GammaTwoQuotient :=
  Quotient.mk''

@[simp]
theorem gammaTwoEffectiveElement_smul (γ : GammaTwo) (z : ℍ) :
    gammaTwoEffectiveElement γ • z = γ • z :=
  rfl

/-- The quotient map is constant on every effective orbit. -/
@[simp]
theorem gammaTwoQuotientMk_smul (g : GammaTwoEffective) (z : ℍ) :
    gammaTwoQuotientMk (g • z) = gammaTwoQuotientMk z := by
  apply Quotient.sound
  exact ⟨g, rfl⟩

/-- The same orbit identity, stated for the original `Gamma(2)` action. -/
@[simp]
theorem gammaTwoQuotientMk_gamma_smul (γ : GammaTwo) (z : ℍ) :
    gammaTwoQuotientMk (γ • z) = gammaTwoQuotientMk z := by
  simpa only [gammaTwoEffectiveElement_smul] using
    gammaTwoQuotientMk_smul (gammaTwoEffectiveElement γ) z

noncomputable instance gammaTwoCountable : Countable GammaTwo :=
  (show Function.Injective
      (fun γ : GammaTwo =>
        ((((γ : GammaTwo) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 0,
         (((γ : GammaTwo) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 1,
         (((γ : GammaTwo) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0,
         (((γ : GammaTwo) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 1)) from by
      intro a b h
      apply Subtype.ext
      apply Matrix.SpecialLinearGroup.ext
      intro i j
      fin_cases i <;> fin_cases j <;> simp_all).countable

/-- The effective image is countable because it is a quotient image of the
countable matrix group `Gamma(2)`. -/
noncomputable instance : Countable GammaTwoEffective :=
  (MulAction.toPermHom GammaTwo ℍ).rangeRestrict_surjective.countable

/-- Every effective transformation has a representative in `Gamma(2)`. -/
theorem effective_exists_gamma (g : GammaTwoEffective) :
    ∃ γ : GammaTwo, ∀ z : ℍ, g • z = γ • z := by
  rcases g.property with ⟨γ, hγ⟩
  refine ⟨γ, fun z => ?_⟩
  exact congrFun (congrArg DFunLike.coe hγ.symm) z

/-! ##### Proper discontinuity of the effective action

The arithmetic group is embedded as a closed discrete subgroup of
`SL(2, ℝ)`.  Properness therefore descends from Mathlib's proper real
Möbius action.  Passing to the faithful image is done at the level of the
finite-intersection characterization, so the central kernel `±1` causes no
topological ambiguity. -/

/-- The coefficient embedding of `Gamma(2)` into `SL(2, ℝ)`. -/
def gammaTwoToSL2Real : GammaTwo →* SL(2, ℝ) :=
  (Matrix.SpecialLinearGroup.map (algebraMap ℤ ℝ)).comp GammaTwo.subtype

@[simp]
theorem gammaTwoToSL2Real_smul (γ : GammaTwo) (z : ℍ) :
    gammaTwoToSL2Real γ • z = γ • z := by
  rfl

/-- The real coefficient embedding of `Gamma(2)` is closed.  This is the
composition of the closed integer-matrix embedding with the closed subgroup
inclusion. -/
theorem gammaTwoToSL2Real_isClosedEmbedding :
    Topology.IsClosedEmbedding gammaTwoToSL2Real := by
  change Topology.IsClosedEmbedding
    (fun γ : GammaTwo =>
      Matrix.SpecialLinearGroup.map (algebraMap ℤ ℝ) (γ : SL(2, ℤ)))
  exact
    Real.isClosedEmbedding_intCast.specialLinearGroup_map.comp
      ((isClosed_discrete (GammaTwo : Set SL(2, ℤ))).isClosedEmbedding_subtypeVal)

/-- The original arithmetic action is proper as the restriction of the
proper `SL(2, ℝ)` action on the upper half-plane. -/
instance gammaTwoProperSMul : ProperSMul GammaTwo ℍ :=
  properSMul_of_isClosedEmbedding gammaTwoToSL2Real
    gammaTwoToSL2Real_isClosedEmbedding gammaTwoToSL2Real_smul

/-- Equivalently, only finitely many `Gamma(2)` translates of one compact
set can meet another compact set. -/
instance gammaTwoProperlyDiscontinuousSMul :
    ProperlyDiscontinuousSMul GammaTwo ℍ :=
  properlyDiscontinuousSMul_iff_properSMul.mpr inferInstance

/-- The faithful image is equipped with its intrinsic discrete topology. -/
instance gammaTwoEffectiveTopologicalSpace :
    TopologicalSpace GammaTwoEffective := ⊥

instance gammaTwoEffectiveDiscreteTopology :
    DiscreteTopology GammaTwoEffective := ⟨rfl⟩

/-- Proper discontinuity survives quotienting out the central action kernel.
The proof pushes the finite set of arithmetic transforms forward to the
faithful image and uses surjectivity of `rangeRestrict`. -/
instance gammaTwoEffectiveProperlyDiscontinuousSMul :
    ProperlyDiscontinuousSMul GammaTwoEffective ℍ where
  finite_disjoint_inter_image {K L} hK hL := by
    have hFinite :
        Set.Finite
          {γ : GammaTwo | (((γ • ·) '' K) ∩ L).Nonempty} :=
      finite_disjoint_inter_image hK hL
    refine (hFinite.image gammaTwoEffectiveElement).subset ?_
    intro a ha
    rcases effective_exists_gamma a with ⟨γ, hγ⟩
    have hγmem : γ ∈
        {γ : GammaTwo | (((γ • ·) '' K) ∩ L).Nonempty} := by
      rcases ha with ⟨x, ⟨y, hyK, hyx⟩, hxL⟩
      refine ⟨x, ⟨y, hyK, ?_⟩, hxL⟩
      exact (hγ y).symm.trans hyx
    refine ⟨γ, hγmem, ?_⟩
    apply Subtype.ext
    apply Equiv.ext
    intro z
    change γ • z = a • z
    exact (hγ z).symm

/-- Effective transformations are continuous because every one has a
`Gamma(2)` matrix representative and the real Möbius action is continuous. -/
instance : ContinuousConstSMul GammaTwoEffective ℍ where
  continuous_const_smul g := by
    rcases effective_exists_gamma g with ⟨γ, hγ⟩
    simp_rw [hγ]
    change Continuous (fun z : ℍ ↦
      (((γ : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ) • z)
    exact continuous_const_smul _

/-- Effective transformations are measurable; this is inherited from the
continuous real Möbius action. -/
instance : MeasurableConstSMul GammaTwoEffective ℍ where
  measurable_const_smul g := by
    rcases effective_exists_gamma g with ⟨γ, hγ⟩
    simp_rw [hγ]
    change Measurable (fun z : ℍ =>
      (((γ : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ) • z)
    exact (continuous_const_smul _).measurable

/-- With the discrete topology, proper discontinuity is equivalent to a
proper action.  In particular the effective orbit quotient is Hausdorff. -/
instance gammaTwoEffectiveProperSMul :
    ProperSMul GammaTwoEffective ℍ :=
  properlyDiscontinuousSMul_iff_properSMul.mp inferInstance

/-- Named finite-translate theorem for later compact-support reductions. -/
theorem gammaTwoEffective_finite_translates_inter_compact
    {K L : Set ℍ} (hK : IsCompact K) (hL : IsCompact L) :
    {a : GammaTwoEffective |
      (((a • ·) '' K) ∩ L).Nonempty}.Finite :=
  finite_disjoint_inter_image hK hL

/-- Stabilizers are finite, including at elliptic and side-pairing points. -/
theorem gammaTwoEffective_stabilizer_finite (z : ℍ) :
    (MulAction.stabilizer GammaTwoEffective z :
      Set GammaTwoEffective).Finite :=
  ProperlyDiscontinuousSMul.finite_stabilizer z

/-- A neighbourhood meets one of its translates only when that transform
fixes its centre.  This is the local-reduction statement at ordinary,
elliptic, and paired-side points in one uniform form. -/
theorem gammaTwoEffective_exists_nhds_image_smul_eq_self (z : ℍ) :
    ∃ U ∈ nhds z, ∀ a : GammaTwoEffective,
      (((a • ·) '' U) ∩ U).Nonempty → a • z = z :=
  ProperlyDiscontinuousSMul.exists_nhds_image_smul_eq_self
    GammaTwoEffective z

/-- The preceding local reduction can be chosen with a compact neighbourhood
of the centre. -/
theorem gammaTwoEffective_exists_compact_nhds_image_smul_eq_self (z : ℍ) :
    ∃ C : Set ℍ, IsCompact C ∧ C ∈ nhds z ∧
      ∀ a : GammaTwoEffective,
        (((a • ·) '' C) ∩ C).Nonempty → a • z = z := by
  obtain ⟨U, hUnhd, hU⟩ :=
    gammaTwoEffective_exists_nhds_image_smul_eq_self z
  obtain ⟨V, hVU, hVopen, hzV⟩ := mem_nhds_iff.mp hUnhd
  obtain ⟨C, hCcompact, hzC, hCV⟩ :=
    exists_compact_subset hVopen hzV
  refine ⟨C, hCcompact, mem_interior_iff_mem_nhds.mp hzC, ?_⟩
  intro a ha
  apply hU a
  rcases ha with ⟨y, ⟨x, hxC, haxy⟩, hyC⟩
  exact ⟨y, ⟨x, hVU (hCV hxC), haxy⟩,
    hVU (hCV hyC)⟩

/-- The translates of a compact set by the arithmetic `Gamma(2)` action form
a locally finite family.  This is the exact topological finiteness statement
needed to turn a compactly supported local smoothing kernel into a pointwise
finite automorphic periodization. -/
theorem gammaTwo_compact_translates_locallyFinite
    {K : Set ℍ} (hK : IsCompact K) :
    LocallyFinite (fun γ : GammaTwo ↦ (γ • ·) '' K) := by
  intro z
  obtain ⟨C, hCcompact, hCnhds, _hCpairing⟩ :=
    gammaTwoEffective_exists_compact_nhds_image_smul_eq_self z
  exact ⟨C, hCnhds, finite_disjoint_inter_image hK hCcompact⟩

/-- The corresponding locally finite compact-translate family for the
faithful effective action. -/
theorem gammaTwoEffective_compact_translates_locallyFinite
    {K : Set ℍ} (hK : IsCompact K) :
    LocallyFinite (fun a : GammaTwoEffective ↦ (a • ·) '' K) := by
  intro z
  obtain ⟨C, hCcompact, hCnhds, _hCpairing⟩ :=
    gammaTwoEffective_exists_compact_nhds_image_smul_eq_self z
  exact ⟨C, hCnhds,
    gammaTwoEffective_finite_translates_inter_compact hK hCcompact⟩

/-- The effective orbit quotient is Hausdorff because the action is proper. -/
instance gammaTwoQuotientT2Space : T2Space GammaTwoQuotient :=
  t2Space_quotient_mulAction_of_properSMul

/-- The orbit projection is an open quotient map.  This single statement
supplies both continuity and surjectivity and is the topological input for the
canonical compact exhaustion below. -/
theorem gammaTwoQuotientMk_isOpenQuotientMap :
    IsOpenQuotientMap gammaTwoQuotientMk := by
  simpa only [gammaTwoQuotientMk, Quotient.mk''_eq_mk] using
    (MulAction.isOpenQuotientMap_quotientMk
      (Γ := GammaTwoEffective) (T := ℍ))

/-- Open subsets of the orbit quotient are measurable for the quotient
measurable structure used by all quotient measures below. -/
instance gammaTwoQuotientOpensMeasurable :
    OpensMeasurableSpace GammaTwoQuotient where
  borel_le := by
    apply MeasurableSpace.generateFrom_le
    intro U hU
    rw [measurableSet_quotient]
    exact
      (hU.preimage gammaTwoQuotientMk_isOpenQuotientMap.continuous).measurableSet

/-- An open quotient of the weakly locally compact upper half-plane is weakly
locally compact. -/
instance gammaTwoQuotientWeaklyLocallyCompactSpace :
    WeaklyLocallyCompactSpace GammaTwoQuotient :=
  gammaTwoQuotientMk_isOpenQuotientMap.weaklyLocallyCompactSpace

/-- The quotient is sigma-compact because it is the continuous image of the
sigma-compact upper half-plane. -/
instance gammaTwoQuotientSigmaCompactSpace :
    SigmaCompactSpace GammaTwoQuotient where
  isSigmaCompact_univ := by
    have hrange : Set.range gammaTwoQuotientMk = Set.univ :=
      Set.range_eq_univ.mpr
        gammaTwoQuotientMk_isOpenQuotientMap.surjective
    rw [← hrange]
    exact isSigmaCompact_range
      gammaTwoQuotientMk_isOpenQuotientMap.continuous

/-- A fixed noncomputable compact exhaustion of the orbit quotient. -/
noncomputable def gammaTwoQuotientCompactExhaustion :
    CompactExhaustion GammaTwoQuotient :=
  CompactExhaustion.choice GammaTwoQuotient

theorem gammaTwoQuotientCompactExhaustion_isCompact (n : ℕ) :
    IsCompact (gammaTwoQuotientCompactExhaustion n) :=
  (gammaTwoQuotientCompactExhaustion).isCompact n

theorem gammaTwoQuotientCompactExhaustion_subset {m n : ℕ}
    (hmn : m ≤ n) :
    gammaTwoQuotientCompactExhaustion m ⊆
      gammaTwoQuotientCompactExhaustion n :=
  (gammaTwoQuotientCompactExhaustion).subset hmn

theorem gammaTwoQuotientCompactExhaustion_subset_interior_succ
    (n : ℕ) :
    gammaTwoQuotientCompactExhaustion n ⊆
      interior (gammaTwoQuotientCompactExhaustion (n + 1)) :=
  (gammaTwoQuotientCompactExhaustion).subset_interior_succ n

theorem gammaTwoQuotientCompactExhaustion_iUnion_eq :
    ⋃ n : ℕ, gammaTwoQuotientCompactExhaustion n = Set.univ :=
  (gammaTwoQuotientCompactExhaustion).iUnion_eq

/-- Every compact quotient set is contained in one canonical stage. -/
theorem compact_subset_gammaTwoQuotientCompactExhaustion
    {K : Set GammaTwoQuotient} (hK : IsCompact K) :
    ∃ n : ℕ, K ⊆ gammaTwoQuotientCompactExhaustion n :=
  (gammaTwoQuotientCompactExhaustion).exists_superset_of_isCompact hK

/-- Mathlib's upper-half-plane volume is the paper's hyperbolic measure
`y⁻² dx dy`. -/
noncomputable abbrev hyperbolicMeasure : Measure ℍ :=
  volume

/-- The definition of the hyperbolic measure, exposed without hiding its
`y⁻²` Radon--Nikodym density. -/
theorem hyperbolicMeasure_def :
    hyperbolicMeasure =
      (volume.comap UpperHalfPlane.coe).withDensity fun z ↦
        ↑((1 / NNReal.mk z.im z.im_pos.le : ℝ≥0) ^ 2) :=
  UpperHalfPlane.volume_def

/-- Hyperbolic volume is positive on every nonempty open set. -/
noncomputable instance hyperbolicMeasure_isOpenPosMeasure :
    hyperbolicMeasure.IsOpenPosMeasure := by
  letI : (volume.comap UpperHalfPlane.coe).IsOpenPosMeasure :=
    Measure.IsOpenPosMeasure.comap volume
      UpperHalfPlane.isOpenEmbedding_coe
  have hcont :
      Continuous (fun z : ℍ ↦
        (1 / NNReal.mk z.im z.im_pos.le : ℝ≥0) ^ 2) := by
    refine .pow (.div₀ continuous_const ?_ ?_) _
    · exact UpperHalfPlane.continuous_im.subtype_mk _
    · exact fun z ↦ NNReal.ne_iff.mp z.im_ne_zero
  rw [hyperbolicMeasure_def]
  exact (MeasureTheory.withDensity_absolutelyContinuous'
    (μ := volume.comap UpperHalfPlane.coe)
    (ENNReal.continuous_coe.comp hcont).aemeasurable
    (Filter.Eventually.of_forall fun z => by
      apply ENNReal.coe_ne_zero.mpr
      exact pow_ne_zero 2
        (div_ne_zero one_ne_zero
          (NNReal.ne_iff.mp z.im_ne_zero)))).isOpenPosMeasure

/-- The hyperbolic measure is invariant under the effective `Gamma(2)` action.
This follows from Mathlib's proved `GL(2, ℝ)` invariance, not from a new axiom.
-/
instance :
    SMulInvariantMeasure GammaTwoEffective ℍ hyperbolicMeasure where
  measure_preimage_smul g s hs := by
    rcases effective_exists_gamma g with ⟨γ, hγ⟩
    simp_rw [hγ]
    change volume ((fun z : ℍ =>
      (((γ : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ) • z) ⁻¹' s) = volume s
    exact SMulInvariantMeasure.measure_preimage_smul _ hs

/-- Setwise formulation of hyperbolic-measure invariance. -/
theorem hyperbolicMeasure_smul (g : GammaTwoEffective) (s : Set ℍ) :
    hyperbolicMeasure (g • s) = hyperbolicMeasure s :=
  measure_smul hyperbolicMeasure g s

/-- A measurable fundamental-domain model for the effective action.

The translate-overlap boundary is automatically null for every value of this
structure.  The usual topological frontier is a separate geometric statement,
so it is retained as an explicit certificate rather than silently conflated
with the translate-overlap boundary.
-/
structure GammaTwoFundamentalDomain where
  carrier : Set ℍ
  carrier_measurable : MeasurableSet carrier
  isFundamental :
    IsFundamentalDomain GammaTwoEffective carrier hyperbolicMeasure
  topologicalBoundary_null :
    hyperbolicMeasure (frontier carrier) = 0

/-! #### A chosen measured fundamental domain for the effective action -/

/-- A vertical real-affine line in `ℂ` has zero planar Lebesgue measure. -/
theorem complex_verticalLine_null (a : ℝ) :
    (volume : Measure ℂ) {z : ℂ | z.re = a} = 0 := by
  rw [← (Complex.volume_preserving_equiv_real_prod.symm).measure_preimage]
  · simp only [Set.preimage_setOf_eq,
      Complex.measurableEquivRealProd_symm_apply]
    rw [show {p : ℝ × ℝ | p.1 = a} =
        ({a} : Set ℝ) ×ˢ Set.univ by
      ext p
      simp]
    change (volume.prod volume)
      (({a} : Set ℝ) ×ˢ Set.univ) = 0
    simp
  · exact
      (Complex.measurable_re
        (measurableSet_singleton a)).nullMeasurableSet

/-- The part of the closed modular tile omitted by its open interior. -/
def modularBoundary : Set ℍ :=
  ModularGroup.fd \ ModularGroup.fdo

theorem modularBoundary_measurable : MeasurableSet modularBoundary :=
  ModularGroup.isClosed_fd.measurableSet.diff
    ModularGroup.isOpen_fdo.measurableSet

/-- The omitted modular boundary lies in one circle and two vertical lines. -/
theorem modularBoundary_complex_subset :
    UpperHalfPlane.coe '' modularBoundary ⊆
      Metric.sphere (0 : ℂ) 1 ∪
        ({z : ℂ | z.re = (1 : ℝ) / 2} ∪
          {z : ℂ | z.re = -((1 : ℝ) / 2)}) := by
  rintro w ⟨z, hz, rfl⟩
  change z ∈ ModularGroup.fd ∧ z ∉ ModularGroup.fdo at hz
  rcases hz with ⟨hzfd, hznot⟩
  change
    1 ≤ Complex.normSq (z : ℂ) ∧ |z.re| ≤ (1 : ℝ) / 2
      at hzfd
  change
    ¬(1 < Complex.normSq (z : ℂ) ∧ |z.re| < (1 : ℝ) / 2)
      at hznot
  by_cases hnorm : 1 < Complex.normSq (z : ℂ)
  · have hre_not : ¬|z.re| < (1 : ℝ) / 2 :=
      fun hre ↦ hznot ⟨hnorm, hre⟩
    have hre : |z.re| = (1 : ℝ) / 2 :=
      le_antisymm hzfd.2 (le_of_not_gt hre_not)
    rcases (abs_eq (by positivity : (0 : ℝ) ≤ (1 : ℝ) / 2)).mp hre with
      hre | hre
    · exact Or.inr (Or.inl hre)
    · exact Or.inr (Or.inr hre)
  · have hnorm_eq : Complex.normSq (z : ℂ) = 1 :=
      le_antisymm (le_of_not_gt hnorm) hzfd.1
    have hsq : ‖(z : ℂ)‖ ^ 2 = 1 := by
      simpa [Complex.normSq_eq_norm_sq] using hnorm_eq
    refine Or.inl (mem_sphere_zero_iff_norm.mpr ?_)
    nlinarith [norm_nonneg (z : ℂ)]

/-- The boundary discarded from the closed modular tile is hyperbolic-null. -/
theorem modularBoundary_null :
    hyperbolicMeasure modularBoundary = 0 := by
  have himage :
      (volume : Measure ℂ) (UpperHalfPlane.coe '' modularBoundary) = 0 :=
    measure_mono_null modularBoundary_complex_subset
      (measure_union_null
        (Measure.addHaar_sphere (volume : Measure ℂ) 0 1)
        (measure_union_null
          (complex_verticalLine_null ((1 : ℝ) / 2))
          (complex_verticalLine_null (-((1 : ℝ) / 2)))))
  change (volume : Measure ℍ) modularBoundary = 0
  rw [UpperHalfPlane.volume_eq_lintegral]
  exact setLIntegral_measure_zero _ _ himage

/-- The right-coset space used to inflate the full modular open tile to a
`Gamma(2)` tile. -/
abbrev GammaTwoRightCoset : Type :=
  Quotient (QuotientGroup.rightRel (CongruenceSubgroup.Gamma 2))

/-- A fixed representative of a right coset. -/
noncomputable def gammaTwoCosetRep
    (q : GammaTwoRightCoset) : SL(2, ℤ) :=
  Quotient.out q

@[simp]
theorem gammaTwoCosetRep_mk (q : GammaTwoRightCoset) :
    (Quotient.mk'' (gammaTwoCosetRep q) : GammaTwoRightCoset) = q :=
  Quotient.out_eq' q

/-- Every modular matrix is a `Gamma(2)` element followed by the selected
right-coset representative. -/
theorem gammaTwo_decompose_right (g : SL(2, ℤ)) :
    ∃ γ : GammaTwo,
      g = (γ : SL(2, ℤ)) *
        gammaTwoCosetRep
          (Quotient.mk'' g : GammaTwoRightCoset) := by
  let q : GammaTwoRightCoset := Quotient.mk'' g
  have hq :
      (Quotient.mk'' (gammaTwoCosetRep q) : GammaTwoRightCoset) =
        (Quotient.mk'' g : GammaTwoRightCoset) := by
    simpa [q] using gammaTwoCosetRep_mk q
  have hmem :
      g * (gammaTwoCosetRep q)⁻¹ ∈ CongruenceSubgroup.Gamma 2 :=
    QuotientGroup.rightRel_apply.mp (Quotient.exact' hq)
  refine ⟨⟨g * (gammaTwoCosetRep q)⁻¹, hmem⟩, ?_⟩
  change g =
    (g * (gammaTwoCosetRep q)⁻¹) *
      gammaTwoCosetRep
        (Quotient.mk'' g : GammaTwoRightCoset)
  simp [q, mul_assoc]

/-- The open `Gamma(2)` carrier obtained from one selected tile per right
coset. -/
noncomputable def gammaTwoOpenCarrier : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q • ModularGroup.fdo

theorem gammaTwoOpenCarrier_isOpen : IsOpen gammaTwoOpenCarrier := by
  unfold gammaTwoOpenCarrier
  refine isOpen_iUnion fun q ↦ ?_
  let g : SL(2, ℤ) := gammaTwoCosetRep q
  have hset :
      g • ModularGroup.fdo =
        (fun z : ℍ => g⁻¹ • z) ⁻¹' ModularGroup.fdo := by
    ext z
    constructor
    · intro hz
      rcases Set.mem_smul_set.mp hz with ⟨w, hw, rfl⟩
      simpa using hw
    · intro hz
      exact Set.mem_smul_set.mpr ⟨g⁻¹ • z, hz, by simp⟩
  rw [hset]
  exact ModularGroup.isOpen_fdo.preimage
    (HalfIntegralMultiplier.continuous_sl2z_smul g⁻¹)

theorem gammaTwoOpenCarrier_measurable :
    MeasurableSet gammaTwoOpenCarrier :=
  gammaTwoOpenCarrier_isOpen.measurableSet

theorem mem_gammaTwoOpenCarrier_iff {z : ℍ} :
    z ∈ gammaTwoOpenCarrier ↔
      ∃ q : GammaTwoRightCoset, ∃ w : ℍ,
        w ∈ ModularGroup.fdo ∧ gammaTwoCosetRep q • w = z := by
  simp only [gammaTwoOpenCarrier, Set.mem_iUnion, Set.mem_smul_set]

/-- The central matrix `-1` belongs to `Gamma(2)`. -/
theorem neg_one_mem_gammaTwo :
    (-1 : SL(2, ℤ)) ∈ CongruenceSubgroup.Gamma 2 := by
  rw [CongruenceSubgroup.Gamma_mem]
  decide

/-- A `Gamma(2)` bridge between two selected tiles can be central only when
the selected right cosets agree. -/
theorem gammaTwoRightCoset_eq_of_bridge
    (γ : GammaTwo) (q₁ q₂ : GammaTwoRightCoset)
    (hbridge :
      (gammaTwoCosetRep q₂)⁻¹ * (γ : SL(2, ℤ)) *
          gammaTwoCosetRep q₁ = 1 ∨
      (gammaTwoCosetRep q₂)⁻¹ * (γ : SL(2, ℤ)) *
          gammaTwoCosetRep q₁ = -1) :
    q₁ = q₂ := by
  rw [← gammaTwoCosetRep_mk q₁, ← gammaTwoCosetRep_mk q₂]
  apply Quotient.sound'
  rw [QuotientGroup.rightRel_apply]
  rcases hbridge with hbridge | hbridge
  · have heq :
        gammaTwoCosetRep q₂ * (gammaTwoCosetRep q₁)⁻¹ =
          (γ : SL(2, ℤ)) := by
      have h := congrArg
        (fun x : SL(2, ℤ) ↦
          gammaTwoCosetRep q₂ * x * (gammaTwoCosetRep q₁)⁻¹)
        hbridge
      simpa [mul_assoc] using h.symm
    rw [heq]
    exact γ.property
  · have hraw :
        (γ : SL(2, ℤ)) =
          -(gammaTwoCosetRep q₂ * (gammaTwoCosetRep q₁)⁻¹) := by
      simpa [mul_assoc] using congrArg
        (fun x : SL(2, ℤ) ↦
          gammaTwoCosetRep q₂ * x * (gammaTwoCosetRep q₁)⁻¹)
        hbridge
    have heq :
        gammaTwoCosetRep q₂ * (gammaTwoCosetRep q₁)⁻¹ =
          -(γ : SL(2, ℤ)) := by
      simpa using
        (congrArg (fun x : SL(2, ℤ) ↦ -x) hraw).symm
    rw [heq]
    have hmem := (CongruenceSubgroup.Gamma 2).mul_mem
      neg_one_mem_gammaTwo γ.property
    simpa using hmem

/-- Conjugation cannot change either central element `±1`. -/
theorem eq_one_or_neg_one_of_conjugate_eq_one_or_neg_one
    {r γ : SL(2, ℤ)}
    (h : r⁻¹ * γ * r = 1 ∨ r⁻¹ * γ * r = -1) :
    γ = 1 ∨ γ = -1 := by
  rcases h with h | h
  · left
    simpa [mul_assoc] using congrArg
      (fun x : SL(2, ℤ) ↦ r * x * r⁻¹) h
  · right
    simpa [mul_assoc] using congrArg
      (fun x : SL(2, ℤ) ↦ r * x * r⁻¹) h

/-- Distinct effective `Gamma(2)` translates of the selected open carrier
are genuinely disjoint, not merely almost disjoint. -/
theorem gammaTwoOpenCarrier_disjoint
    (a : GammaTwoEffective) (ha : a ≠ 1) :
    Disjoint (a • gammaTwoOpenCarrier) gammaTwoOpenCarrier := by
  refine Set.disjoint_left.2 ?_
  intro x hax hx
  rcases Set.mem_smul_set.mp hax with ⟨y, hy, hxy⟩
  rcases mem_gammaTwoOpenCarrier_iff.mp hy with
    ⟨q₁, z₁, hz₁, hy_eq⟩
  rcases mem_gammaTwoOpenCarrier_iff.mp hx with
    ⟨q₂, z₂, hz₂, hx_eq⟩
  rcases effective_exists_gamma a with ⟨γ, hγ⟩
  have hmove :
      ((gammaTwoCosetRep q₂)⁻¹ * (γ : SL(2, ℤ)) *
          gammaTwoCosetRep q₁) • z₁ = z₂ := by
    simp only [mul_smul]
    calc
      (gammaTwoCosetRep q₂)⁻¹ •
          (γ : SL(2, ℤ)) • gammaTwoCosetRep q₁ • z₁ =
          (gammaTwoCosetRep q₂)⁻¹ • (γ : SL(2, ℤ)) • y := by
        rw [hy_eq]
      _ = (gammaTwoCosetRep q₂)⁻¹ • a • y := by
        exact congrArg
          (fun t : ℍ => (gammaTwoCosetRep q₂)⁻¹ • t)
          (hγ y).symm
      _ = (gammaTwoCosetRep q₂)⁻¹ • x := by
        exact congrArg
          (fun t : ℍ => (gammaTwoCosetRep q₂)⁻¹ • t) hxy
      _ = (gammaTwoCosetRep q₂)⁻¹ • gammaTwoCosetRep q₂ • z₂ := by
        exact congrArg
          (fun t : ℍ => (gammaTwoCosetRep q₂)⁻¹ • t) hx_eq.symm
      _ = z₂ := by simp
  have hbridge :
      (gammaTwoCosetRep q₂)⁻¹ * (γ : SL(2, ℤ)) *
          gammaTwoCosetRep q₁ = 1 ∨
      (gammaTwoCosetRep q₂)⁻¹ * (γ : SL(2, ℤ)) *
          gammaTwoCosetRep q₁ = -1 :=
    ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo hz₁
      (hmove.symm ▸ hz₂)
  have hq : q₁ = q₂ :=
    gammaTwoRightCoset_eq_of_bridge γ q₁ q₂ hbridge
  subst q₂
  have hγpm :
      (γ : SL(2, ℤ)) = 1 ∨ (γ : SL(2, ℤ)) = -1 :=
    eq_one_or_neg_one_of_conjugate_eq_one_or_neg_one hbridge
  have haone : a = 1 := by
    apply Subtype.ext
    apply Equiv.ext
    intro z
    change a • z = z
    rw [hγ z]
    change (γ : SL(2, ℤ)) • z = z
    rcases hγpm with hγpm | hγpm
    · rw [hγpm]
      simp
    · rw [hγpm]
      simpa using ModularGroup.SL_neg_smul (1 : SL(2, ℤ)) z
  exact ha haone

/-- Hyperbolic volume is invariant under the full integral modular action. -/
theorem hyperbolicMeasure_fullModular_smul
    (g : SL(2, ℤ)) (s : Set ℍ) :
    hyperbolicMeasure (g • s) = hyperbolicMeasure s := by
  change volume ((g : GL (Fin 2) ℝ) • s) = volume s
  exact measure_smul volume (g : GL (Fin 2) ℝ) s

noncomputable instance sl2zCountable : Countable (SL(2, ℤ)) :=
  (show Function.Injective
      (fun γ : SL(2, ℤ) =>
        ((((γ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 0,
          ((γ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 0 1),
         (((γ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0,
          ((γ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 1))) from by
      intro a b h
      apply Matrix.SpecialLinearGroup.ext
      intro i j
      fin_cases i <;> fin_cases j <;> simp_all).countable

/-- All translates of the boundary omitted from the full modular open tile. -/
def modularBoundaryOrbit : Set ℍ :=
  ⋃ g : SL(2, ℤ), g • modularBoundary

theorem modularBoundaryOrbit_null :
    hyperbolicMeasure modularBoundaryOrbit = 0 := by
  unfold modularBoundaryOrbit
  apply measure_iUnion_null
  intro g
  rw [hyperbolicMeasure_fullModular_smul]
  exact modularBoundary_null

/-- Pointwise reduction away from the full modular boundary orbit.  This is
the non-a.e. statement hidden inside the usual almost-everywhere proof. -/
theorem gammaTwoOpenCarrier_covers_of_not_mem_modularBoundaryOrbit
    {z : ℍ} (hz : z ∉ modularBoundaryOrbit) :
    ∃ a : GammaTwoEffective, a • z ∈ gammaTwoOpenCarrier := by
  rcases ModularGroup.exists_smul_mem_fd z with ⟨g, hgfd⟩
  have hgfdo : g • z ∈ ModularGroup.fdo := by
    by_contra hnot
    have hb : g • z ∈ modularBoundary := by
      change g • z ∈ ModularGroup.fd ∧ g • z ∉ ModularGroup.fdo
      exact ⟨hgfd, hnot⟩
    apply hz
    unfold modularBoundaryOrbit
    refine Set.mem_iUnion.2 ⟨g⁻¹, ?_⟩
    simpa [Set.mem_smul_set_iff_inv_smul_mem] using hb
  rcases gammaTwo_decompose_right g⁻¹ with ⟨γ, hdecomp⟩
  let q : GammaTwoRightCoset := Quotient.mk'' g⁻¹
  have hdecomp' :
      g⁻¹ = (γ : SL(2, ℤ)) * gammaTwoCosetRep q := by
    simpa [q] using hdecomp
  refine ⟨gammaTwoEffectiveElement γ⁻¹, ?_⟩
  have hcancel :
      ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) • z =
        gammaTwoCosetRep q • (g • z) := by
    have hg :
        g = (gammaTwoCosetRep q)⁻¹ *
          ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) := by
      have h := congrArg Inv.inv hdecomp'
      simpa [mul_inv_rev] using h
    have hγ :
        ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) =
          gammaTwoCosetRep q * g := by
      rw [hg]
      simp [mul_assoc]
    rw [hγ, mul_smul]
  have htile :
      gammaTwoCosetRep q • (g • z) ∈ gammaTwoOpenCarrier :=
    mem_gammaTwoOpenCarrier_iff.mpr
      ⟨q, g • z, hgfdo, rfl⟩
  change ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) • z ∈
    gammaTwoOpenCarrier
  rw [hcancel]
  exact htile

/-- The effective translating element is unique once the orbit avoids the
discarded boundary.  Elliptic and paired-side phenomena are therefore
confined to the already-null exceptional orbit set. -/
theorem gammaTwoOpenCarrier_unique_translate_of_not_mem_modularBoundaryOrbit
    {z : ℍ} (hz : z ∉ modularBoundaryOrbit) :
    ∃! a : GammaTwoEffective, a • z ∈ gammaTwoOpenCarrier := by
  obtain ⟨a, ha⟩ :=
    gammaTwoOpenCarrier_covers_of_not_mem_modularBoundaryOrbit hz
  refine ⟨a, ha, ?_⟩
  intro b hb
  by_contra hba
  have hc : b * a⁻¹ ≠ (1 : GammaTwoEffective) := by
    intro hc
    apply hba
    calc
      b = (b * a⁻¹) * a := by simp
      _ = 1 * a := by rw [hc]
      _ = a := one_mul a
  have hmem : b • z ∈ (b * a⁻¹) • gammaTwoOpenCarrier := by
    rw [Set.mem_smul_set]
    exact ⟨a • z, ha, by simp [mul_smul]⟩
  exact Set.disjoint_left.1
    (gammaTwoOpenCarrier_disjoint (b * a⁻¹) hc) hmem hb

/-- Almost every upper-half-plane point can be moved into the selected open
`Gamma(2)` carrier. -/
theorem gammaTwoOpenCarrier_ae_covers :
    ∀ᵐ z ∂hyperbolicMeasure,
      ∃ a : GammaTwoEffective, a • z ∈ gammaTwoOpenCarrier := by
  have hnotBoundary :
      ∀ᵐ z ∂hyperbolicMeasure, z ∉ modularBoundaryOrbit := by
    rw [ae_iff]
    simpa using modularBoundaryOrbit_null
  filter_upwards [hnotBoundary] with z hz
  rcases ModularGroup.exists_smul_mem_fd z with ⟨g, hgfd⟩
  have hgfdo : g • z ∈ ModularGroup.fdo := by
    by_contra hnot
    have hb : g • z ∈ modularBoundary := by
      change g • z ∈ ModularGroup.fd ∧ g • z ∉ ModularGroup.fdo
      exact ⟨hgfd, hnot⟩
    apply hz
    unfold modularBoundaryOrbit
    refine Set.mem_iUnion.2 ⟨g⁻¹, ?_⟩
    simpa [Set.mem_smul_set_iff_inv_smul_mem] using hb
  rcases gammaTwo_decompose_right g⁻¹ with ⟨γ, hdecomp⟩
  let q : GammaTwoRightCoset := Quotient.mk'' g⁻¹
  have hdecomp' :
      g⁻¹ = (γ : SL(2, ℤ)) * gammaTwoCosetRep q := by
    simpa [q] using hdecomp
  refine ⟨gammaTwoEffectiveElement γ⁻¹, ?_⟩
  have hcancel :
      ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) • z =
        gammaTwoCosetRep q • (g • z) := by
    have hg :
        g = (gammaTwoCosetRep q)⁻¹ *
          ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) := by
      have h := congrArg Inv.inv hdecomp'
      simpa [mul_inv_rev] using h
    have hγ :
        ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) =
          gammaTwoCosetRep q * g := by
      rw [hg]
      simp [mul_assoc]
    rw [hγ, mul_smul]
  have htile :
      gammaTwoCosetRep q • (g • z) ∈ gammaTwoOpenCarrier :=
    mem_gammaTwoOpenCarrier_iff.mpr
      ⟨q, g • z, hgfdo, rfl⟩
  change ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) • z ∈
    gammaTwoOpenCarrier
  rw [hcancel]
  exact htile

/-- The selected open carrier is a measured fundamental domain for the
faithful effective action. -/
theorem gammaTwoOpenCarrier_isFundamental :
    IsFundamentalDomain GammaTwoEffective gammaTwoOpenCarrier
      hyperbolicMeasure := by
  refine IsFundamentalDomain.mk''
    gammaTwoOpenCarrier_measurable.nullMeasurableSet
    gammaTwoOpenCarrier_ae_covers ?_ ?_
  · intro a ha
    exact (gammaTwoOpenCarrier_disjoint a ha).aedisjoint
  · intro a
    exact (measurePreserving_smul a hyperbolicMeasure).quasiMeasurePreserving

/-- No point of the topological frontier lies in any effective translate of
the open carrier. -/
theorem gammaTwoOpenCarrier_frontier_subset_uncovered :
    frontier gammaTwoOpenCarrier ⊆
      {z : ℍ | ¬∃ a : GammaTwoEffective,
        a • z ∈ gammaTwoOpenCarrier} := by
  intro z hz hcovered
  change z ∈ closure gammaTwoOpenCarrier ∧
    z ∉ interior gammaTwoOpenCarrier at hz
  rcases hcovered with ⟨a, haz⟩
  by_cases ha : a = 1
  · subst a
    have hzmem : z ∈ gammaTwoOpenCarrier := by simpa using haz
    apply hz.2
    simpa [gammaTwoOpenCarrier_isOpen.interior_eq] using hzmem
  · have hainv : a⁻¹ ≠ 1 := inv_ne_one.mpr ha
    have hzU : z ∈ a⁻¹ • gammaTwoOpenCarrier := by
      simpa [Set.mem_smul_set_iff_inv_smul_mem] using haz
    have hUopen : IsOpen (a⁻¹ • gammaTwoOpenCarrier) :=
      gammaTwoOpenCarrier_isOpen.smul a⁻¹
    have hdis :
        Disjoint (a⁻¹ • gammaTwoOpenCarrier) gammaTwoOpenCarrier :=
      gammaTwoOpenCarrier_disjoint a⁻¹ hainv
    have hclosure :
        closure gammaTwoOpenCarrier ⊆
          (a⁻¹ • gammaTwoOpenCarrier)ᶜ := by
      refine closure_minimal ?_ hUopen.isClosed_compl
      intro y hyF hyU
      exact Set.disjoint_left.1 hdis hyU hyF
    exact (hclosure hz.1) hzU

/-- The ordinary topological frontier is null. -/
theorem gammaTwoOpenCarrier_frontier_null :
    hyperbolicMeasure (frontier gammaTwoOpenCarrier) = 0 := by
  have huncovered :
      hyperbolicMeasure
        {z : ℍ | ¬∃ a : GammaTwoEffective,
          a • z ∈ gammaTwoOpenCarrier} = 0 :=
    ae_iff.mp gammaTwoOpenCarrier_ae_covers
  exact measure_mono_null
    gammaTwoOpenCarrier_frontier_subset_uncovered huncovered

/-- Closing the open measured carrier changes it only on its null frontier. -/
theorem gammaTwoOpenCarrier_closure_ae_eq :
    closure gammaTwoOpenCarrier =ᵐ[hyperbolicMeasure]
      gammaTwoOpenCarrier := by
  apply Filter.EventuallyLE.antisymm
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro z hz
      rw [Set.mem_diff] at hz
      change z ∈ closure gammaTwoOpenCarrier ∧
        z ∉ interior gammaTwoOpenCarrier
      simpa [gammaTwoOpenCarrier_isOpen.interior_eq] using hz)
      gammaTwoOpenCarrier_frontier_null
  · exact subset_closure.eventuallyLE

/-- The closed carrier is still a measured fundamental domain.  This is a
genuine a.e.-congruence theorem, not an additional reduction hypothesis. -/
theorem gammaTwoOpenCarrier_closure_isFundamental :
    IsFundamentalDomain GammaTwoEffective (closure gammaTwoOpenCarrier)
      hyperbolicMeasure := by
  refine IsFundamentalDomain.mk''
    isClosed_closure.measurableSet.nullMeasurableSet
    (gammaTwoOpenCarrier_isFundamental.ae_covers.mono fun z hz ↦ by
      rcases hz with ⟨a, ha⟩
      exact ⟨a, subset_closure ha⟩) ?_ ?_
  · intro a ha
    exact AEDisjoint.congr
      ((gammaTwoOpenCarrier_disjoint a ha).aedisjoint)
      (MeasureTheory.Measure.QuasiMeasurePreserving.smul_ae_eq_of_ae_eq a
        (measurePreserving_smul a⁻¹ hyperbolicMeasure).quasiMeasurePreserving
        gammaTwoOpenCarrier_closure_ae_eq)
      gammaTwoOpenCarrier_closure_ae_eq
  · intro a
    exact (measurePreserving_smul a hyperbolicMeasure).quasiMeasurePreserving

/-- The frontier of the closed carrier is contained in the already-null
frontier of the open carrier. -/
theorem gammaTwoOpenCarrier_closure_frontier_null :
    hyperbolicMeasure (frontier (closure gammaTwoOpenCarrier)) = 0 :=
  measure_mono_null frontier_closure_subset
    gammaTwoOpenCarrier_frontier_null

/-- A chosen, noncomputable *closed* measured fundamental domain for the
effective `Gamma(2)` action.  `Quotient.out` selects the six coset tiles.
Using the closure rather than the open carrier is essential for literal
closed cusp truncations; all quotient integrals are unchanged by the
preceding a.e.-equality. -/
noncomputable def chosenGammaTwoFundamentalDomain :
    GammaTwoFundamentalDomain where
  carrier := closure gammaTwoOpenCarrier
  carrier_measurable := isClosed_closure.measurableSet
  isFundamental := gammaTwoOpenCarrier_closure_isFundamental
  topologicalBoundary_null :=
    gammaTwoOpenCarrier_closure_frontier_null

namespace GammaTwoFundamentalDomain

/-- The quotient measure obtained by restricting to a fundamental domain and
pushing forward along the orbit map. -/
noncomputable def quotientMeasure
    (D : GammaTwoFundamentalDomain) : Measure GammaTwoQuotient :=
  (hyperbolicMeasure.restrict D.carrier).map gammaTwoQuotientMk

/-- The quotient image of a measurable set is measurable.  This uses the
explicit description of its preimage as the countable union of translates. -/
theorem quotientImage_measurable {A : Set ℍ}
    (hA : MeasurableSet A) :
    MeasurableSet (gammaTwoQuotientMk '' A) := by
  have hpre :
      gammaTwoQuotientMk ⁻¹' (gammaTwoQuotientMk '' A) =
        ⋃ g : GammaTwoEffective, (g • ·) '' A := by
    change
      (Quotient.mk'' : ℍ → GammaTwoQuotient) ⁻¹'
          ((Quotient.mk'' : ℍ → GammaTwoQuotient) '' A) =
        ⋃ g : GammaTwoEffective, (g • ·) '' A
    exact MulAction.quotient_preimage_image_eq_union_mul
      A (G := GammaTwoEffective)
  rw [measurableSet_quotient]
  change MeasurableSet
    (gammaTwoQuotientMk ⁻¹' (gammaTwoQuotientMk '' A))
  rw [hpre]
  apply MeasurableSet.iUnion
  exact fun g ↦ MeasurableSet.const_smul hA g

/-- A quotient image never has more quotient measure than the original
upstairs measurable set.  The proof is the same translate-sum calculation
used by Mathlib to prove sigma-finiteness of quotient measures. -/
theorem quotientMeasure_image_le
    (D : GammaTwoFundamentalDomain) {A : Set ℍ}
    (hA : MeasurableSet A) :
    D.quotientMeasure (gammaTwoQuotientMk '' A) ≤
      hyperbolicMeasure A := by
  have hpre :
      gammaTwoQuotientMk ⁻¹' (gammaTwoQuotientMk '' A) =
        ⋃ g : GammaTwoEffective, (g • ·) '' A := by
    change
      (Quotient.mk'' : ℍ → GammaTwoQuotient) ⁻¹'
          ((Quotient.mk'' : ℍ → GammaTwoQuotient) '' A) =
        ⋃ g : GammaTwoEffective, (g • ·) '' A
    exact MulAction.quotient_preimage_image_eq_union_mul
      A (G := GammaTwoEffective)
  have himage := quotientImage_measurable hA
  have hpreMeas :
      MeasurableSet
        (gammaTwoQuotientMk ⁻¹' (gammaTwoQuotientMk '' A)) := by
    simpa only [gammaTwoQuotientMk] using
      (measurable_quotient_mk'' himage)
  rw [quotientMeasure,
    Measure.map_apply_of_aemeasurable
      (show AEMeasurable gammaTwoQuotientMk
          (hyperbolicMeasure.restrict D.carrier) from
        measurable_quotient_mk''.aemeasurable)
      himage,
    Measure.restrict_apply hpreMeas,
    hpre]
  have hunionInter :
      (⋃ g : GammaTwoEffective, (g • ·) '' A) ∩ D.carrier =
        ⋃ g : GammaTwoEffective, ((g • ·) '' A ∩ D.carrier) := by
    ext z
    simp only [Set.mem_inter_iff, Set.mem_iUnion]
    constructor
    · rintro ⟨⟨g, hg⟩, hzD⟩
      exact ⟨g, hg, hzD⟩
    · rintro ⟨g, hg, hzD⟩
      exact ⟨⟨g, hg⟩, hzD⟩
  rw [hunionInter, D.isFundamental.measure_eq_tsum A]
  exact measure_iUnion_le _

theorem quotientMeasure_image_open_le
    (D : GammaTwoFundamentalDomain) {U : Set ℍ}
    (hU : IsOpen U) :
    D.quotientMeasure (gammaTwoQuotientMk '' U) ≤
      hyperbolicMeasure U :=
  D.quotientMeasure_image_le hU.measurableSet

/-- The orbit quotient map is open. -/
theorem quotientImage_isOpen {U : Set ℍ} (hU : IsOpen U) :
    IsOpen (gammaTwoQuotientMk '' U) :=
  gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap U hU

/-- Every certified quotient measure is positive on nonempty open sets. -/
noncomputable instance quotientMeasure_isOpenPosMeasure
    (D : GammaTwoFundamentalDomain) :
    D.quotientMeasure.IsOpenPosMeasure where
  open_pos U hU hUne := by
    let A : Set ℍ := gammaTwoQuotientMk ⁻¹' U
    have hAopen : IsOpen A :=
      hU.preimage gammaTwoQuotientMk_isOpenQuotientMap.continuous
    have hAne : A.Nonempty :=
      (gammaTwoQuotientMk_isOpenQuotientMap.surjective.nonempty_preimage).mpr hUne
    have hAinv : ∀ g : GammaTwoEffective, g • A = A := by
      intro g
      ext z
      simp only [A, Set.mem_smul_set_iff_inv_smul_mem,
        Set.mem_preimage, gammaTwoQuotientMk_smul]
    intro hzero
    have hAinter : hyperbolicMeasure (A ∩ D.carrier) = 0 := by
      have hzero' := hzero
      rw [quotientMeasure,
        Measure.map_apply_of_aemeasurable
          (show AEMeasurable gammaTwoQuotientMk
              (hyperbolicMeasure.restrict D.carrier) from
            measurable_quotient_mk''.aemeasurable)
          hU.measurableSet,
        Measure.restrict_apply hAopen.measurableSet] at hzero'
      simpa only [A] using hzero'
    exact (hAopen.measure_ne_zero hyperbolicMeasure hAne)
      (D.isFundamental.measure_zero_of_invariant A hAinv hAinter)

/-- Every certified fundamental-domain quotient measure is locally finite;
no separate regularity certificate is needed. -/
instance quotientMeasure_isLocallyFinite
    (D : GammaTwoFundamentalDomain) :
    IsLocallyFiniteMeasure D.quotientMeasure where
  finiteAtNhds q := by
    obtain ⟨z, rfl⟩ := q.exists_rep
    rcases
        (Measure.finiteAt_nhds hyperbolicMeasure z).exists_mem_basis
          (nhds_basis_opens z) with
      ⟨U, ⟨hzU, hUopen⟩, hUfinite⟩
    refine ⟨gammaTwoQuotientMk '' U, ?_, ?_⟩
    · exact (quotientImage_isOpen hUopen).mem_nhds
        (Set.mem_image_of_mem gammaTwoQuotientMk hzU)
    · exact
        (D.quotientMeasure_image_open_le hUopen).trans_lt hUfinite

/-- Local finiteness implies finiteness on compact quotient sets. -/
theorem quotientMeasure_isFiniteMeasureOnCompacts
    (D : GammaTwoFundamentalDomain) :
    IsFiniteMeasureOnCompacts D.quotientMeasure := by
  infer_instance

/-- The quotient measure is independent of the selected certified fundamental
domain. -/
theorem quotientMeasure_eq
    (D₁ D₂ : GammaTwoFundamentalDomain) :
    D₁.quotientMeasure = D₂.quotientMeasure := by
  simpa [quotientMeasure, gammaTwoQuotientMk] using
    (IsFundamentalDomain.quotientMeasure_eq
      (G := GammaTwoEffective) hyperbolicMeasure
      D₁.isFundamental D₂.isFundamental)

/-- The intrinsic translate-overlap frontier has hyperbolic measure zero. -/
theorem fundamentalFrontier_null (D : GammaTwoFundamentalDomain) :
    hyperbolicMeasure
        (fundamentalFrontier GammaTwoEffective D.carrier) = 0 :=
  D.isFundamental.measure_fundamentalFrontier

/-- The separately certified topological boundary also has measure zero. -/
theorem frontier_null (D : GammaTwoFundamentalDomain) :
    hyperbolicMeasure (frontier D.carrier) = 0 :=
  D.topologicalBoundary_null

/-- Bochner integration on the quotient agrees exactly with integration over
the chosen fundamental domain. -/
theorem integral_quotientMeasure_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (D : GammaTwoFundamentalDomain) (f : GammaTwoQuotient → E)
    (hf : AEStronglyMeasurable f D.quotientMeasure) :
    ∫ q, f q ∂D.quotientMeasure =
      ∫ z in D.carrier, f (gammaTwoQuotientMk z) ∂hyperbolicMeasure := by
  simpa [quotientMeasure, gammaTwoQuotientMk] using
    (integral_map
      (μ := hyperbolicMeasure.restrict D.carrier)
      measurable_quotient_mk''.aemeasurable hf)

/-- Integrability of an invariant lift does not depend on the chosen
fundamental domain. -/
theorem integrableOn_iff
    {E : Type*} [NormedAddCommGroup E]
    (D₁ D₂ : GammaTwoFundamentalDomain) (f : ℍ → E)
    (hf : ∀ g : GammaTwoEffective, ∀ z, f (g • z) = f z) :
    IntegrableOn f D₁.carrier hyperbolicMeasure ↔
      IntegrableOn f D₂.carrier hyperbolicMeasure :=
  D₁.isFundamental.integrableOn_iff D₂.isFundamental hf

/-- The fundamental-domain integral of an invariant Bochner integrand is
independent of every certified choice, including in the non-integrable case
where both Bochner integrals are definitionally zero. -/
theorem setIntegral_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (D₁ D₂ : GammaTwoFundamentalDomain) (f : ℍ → E)
    (hf : ∀ g : GammaTwoEffective, ∀ z, f (g • z) = f z) :
    ∫ z in D₁.carrier, f z ∂hyperbolicMeasure =
      ∫ z in D₂.carrier, f z ∂hyperbolicMeasure :=
  D₁.isFundamental.setIntegral_eq D₂.isFundamental hf

end GammaTwoFundamentalDomain

/-- Descend an invariant function to the effective orbit quotient. -/
noncomputable def descendInvariant {E : Type*} (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z) :
    GammaTwoQuotient → E :=
  Quotient.lift ρ (by
    intro a b hab
    rcases hab with ⟨g, rfl⟩
    exact hρ g b)

@[simp]
theorem descendInvariant_mk {E : Type*} (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z)
    (z : ℍ) :
    descendInvariant ρ hρ (gammaTwoQuotientMk z) = ρ z :=
  rfl

/-- Support of an invariant function after descent is exactly the projected
upstairs support. -/
theorem descendInvariant_support {E : Type*} [Zero E]
    (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z) :
    Function.support (descendInvariant ρ hρ) =
      gammaTwoQuotientMk '' Function.support ρ := by
  ext q
  refine Quotient.inductionOn' q ?_
  intro z
  constructor
  · intro hz
    refine ⟨z, ?_, rfl⟩
    change descendInvariant ρ hρ (gammaTwoQuotientMk z) ≠ 0 at hz
    simpa only [Function.mem_support, descendInvariant_mk] using hz
  · rintro ⟨w, hw, hEq⟩
    have hw' : descendInvariant ρ hρ (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support, descendInvariant_mk] using hw
    rwa [hEq] at hw'

theorem descendInvariant_tsupport {E : Type*} [Zero E]
    (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z) :
    tsupport (descendInvariant ρ hρ) =
      closure (gammaTwoQuotientMk '' Function.support ρ) := by
  rw [tsupport, descendInvariant_support]

/-- Measurability descends through the quotient measurable structure. -/
theorem measurable_descendInvariant {E : Type*} [MeasurableSpace E]
    (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z)
    (hρm : Measurable ρ) :
    Measurable (descendInvariant ρ hρ) := by
  rw [measurable_from_quotient]
  change Measurable (fun z => descendInvariant ρ hρ (gammaTwoQuotientMk z))
  simpa only [descendInvariant_mk] using hρm

/-- Quotient integration of a descended invariant density is its
fundamental-domain integral. -/
theorem GammaTwoFundamentalDomain.integral_descendInvariant_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (D : GammaTwoFundamentalDomain) (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z)
    (hm : AEStronglyMeasurable (descendInvariant ρ hρ) D.quotientMeasure) :
    ∫ q, descendInvariant ρ hρ q ∂D.quotientMeasure =
      ∫ z in D.carrier, ρ z ∂hyperbolicMeasure := by
  simpa using D.integral_quotientMeasure_eq (descendInvariant ρ hρ) hm

/-! #### Three-cusp geometry and the closed modular-tile truncation

The open measured carrier above is the right object for integration, but it
omits its side-pairing boundary.  A cusp truncation used pointwise must instead
start with closed modular tiles.  The construction below is independent of the
topological compact exhaustion later in this namespace: it is the finite union
of the sets `r • ModularGroup.truncatedFundamentalDomain Y`, one for every
right coset of `Gamma(2)`.

There are three quotient cusps, represented by `∞`, `0`, and `1`.  The
matrices `1`, `S`, and `T*S` are fixed as their scaling matrices.  The fourth
The endpoint `-1` of the usual closed polygon is another representative of the cusp
class of `1`; its scaling matrix is `T⁻¹*S`.  Thus the two finite endpoints of
that class differ by the width-two translation `T²`.
-/

/-- The three cusp classes of `Gamma(2)`. -/
inductive GammaTwoCusp where
  | atInfinity
  | zero
  | one
deriving DecidableEq

instance gammaTwoCuspFintype : Fintype GammaTwoCusp where
  elems := {.atInfinity, .zero, .one}
  complete x := by cases x <;> simp

/-- Explicit integral scaling matrices taking `∞` to the named cusp. -/
def gammaTwoCuspScaling : GammaTwoCusp → SL(2, ℤ)
  | .atInfinity => 1
  | .zero => ModularGroup.S
  | .one => ModularGroup.T * ModularGroup.S

@[simp]
theorem gammaTwoCuspScaling_atInfinity :
    gammaTwoCuspScaling .atInfinity = 1 :=
  rfl

@[simp]
theorem gammaTwoCuspScaling_zero :
    gammaTwoCuspScaling .zero = ModularGroup.S :=
  rfl

@[simp]
theorem gammaTwoCuspScaling_one :
    gammaTwoCuspScaling .one = ModularGroup.T * ModularGroup.S :=
  rfl

/-- Every cusp of `Gamma(2)` has width two. -/
def gammaTwoCuspWidth (_ : GammaTwoCusp) : ℕ :=
  2

@[simp]
theorem gammaTwoCuspWidth_eq_two (κ : GammaTwoCusp) :
    gammaTwoCuspWidth κ = 2 :=
  rfl

/-- The width-two parabolic at the cusp `κ`, with an arbitrary integral
power. -/
def gammaTwoCuspTranslation (κ : GammaTwoCusp) (n : ℤ) : SL(2, ℤ) :=
  gammaTwoCuspScaling κ * ModularGroup.T ^ (2 * n) *
    (gammaTwoCuspScaling κ)⁻¹

/-- Width-two translations at all three cusps really belong to `Gamma(2)`. -/
theorem gammaTwoCuspTranslation_mem (κ : GammaTwoCusp) (n : ℤ) :
    gammaTwoCuspTranslation κ n ∈ GammaTwo := by
  have hdiv : (2 : ℤ) ∣ 2 * n := ⟨n, rfl⟩
  have hT : ModularGroup.T ^ (2 * n) ∈ GammaTwo := by
    simpa using
      CongruenceSubgroup.ModularGroup_T_pow_mem_Gamma
        (2 : ℤ) (2 * n) hdiv
  simpa [gammaTwoCuspTranslation, mul_assoc] using
    (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (ModularGroup.T ^ (2 * n)) hT (gammaTwoCuspScaling κ)

/-- The unit translation is not a level-two matrix. -/
theorem modularGroup_T_not_mem_gammaTwo :
    ModularGroup.T ∉ GammaTwo := by
  rw [CongruenceSubgroup.Gamma_mem]
  norm_num [ModularGroup.T]

/-- Conjugating a unit translation to any named cusp does not put it in
`Gamma(2)`. -/
theorem gammaTwoCuspUnitTranslation_not_mem (κ : GammaTwoCusp) :
    gammaTwoCuspScaling κ * ModularGroup.T *
      (gammaTwoCuspScaling κ)⁻¹ ∉ GammaTwo := by
  intro h
  have hback :=
    (CongruenceSubgroup.Gamma_normal 2).conj_mem _ h
      (gammaTwoCuspScaling κ)⁻¹
  have hT : ModularGroup.T ∈ GammaTwo := by
    simpa [mul_assoc] using hback
  exact modularGroup_T_not_mem_gammaTwo hT

/-- Width two is minimal among positive natural translation lengths. -/
theorem gammaTwoCuspWidth_minimal
    (κ : GammaTwoCusp) (n : ℕ) (hn : 0 < n)
    (hnw : n < gammaTwoCuspWidth κ) :
    gammaTwoCuspScaling κ * ModularGroup.T ^ n *
      (gammaTwoCuspScaling κ)⁻¹ ∉ GammaTwo := by
  have hn1 : n = 1 := by
    simp only [gammaTwoCuspWidth] at hnw
    omega
  subst n
  simpa using gammaTwoCuspUnitTranslation_not_mem κ

/-- Local cusp height in the coordinate supplied by the scaling matrix. -/
noncomputable def gammaTwoCuspHeight (κ : GammaTwoCusp) (z : ℍ) : ℝ :=
  ((gammaTwoCuspScaling κ)⁻¹ • z).im

theorem gammaTwoCuspHeight_pos (κ : GammaTwoCusp) (z : ℍ) :
    0 < gammaTwoCuspHeight κ z :=
  UpperHalfPlane.im_pos _

theorem gammaTwoCuspHeight_continuous (κ : GammaTwoCusp) :
    Continuous (gammaTwoCuspHeight κ) := by
  change Continuous (fun z : ℍ =>
    ((((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
      ((gammaTwoCuspScaling κ)⁻¹)) • z).im))
  exact UpperHalfPlane.continuous_im.comp
    (continuous_const_smul
      ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
        ((gammaTwoCuspScaling κ)⁻¹)))

theorem gammaTwoCuspHeight_measurable (κ : GammaTwoCusp) :
    Measurable (gammaTwoCuspHeight κ) :=
  (gammaTwoCuspHeight_continuous κ).measurable

/-- The local height is periodic under the full width-two cusp stabilizer. -/
theorem gammaTwoCuspHeight_translation
    (κ : GammaTwoCusp) (n : ℤ) (z : ℍ) :
    gammaTwoCuspHeight κ (gammaTwoCuspTranslation κ n • z) =
      gammaTwoCuspHeight κ z := by
  simp only [gammaTwoCuspHeight, gammaTwoCuspTranslation, mul_smul,
    inv_smul_smul, ModularGroup.im_T_zpow_smul]

/-- Four ideal ends of the standard closed polygon; `one` and `negOne`
represent the same quotient cusp. -/
inductive GammaTwoCuspEnd where
  | atInfinity
  | zero
  | one
  | negOne
deriving DecidableEq

instance gammaTwoCuspEndFintype : Fintype GammaTwoCuspEnd where
  elems := {.atInfinity, .zero, .one, .negOne}
  complete x := by cases x <;> simp

/-- The cusp class represented by a polygon end. -/
def GammaTwoCuspEnd.cuspClass : GammaTwoCuspEnd → GammaTwoCusp
  | .atInfinity => .atInfinity
  | .zero => .zero
  | .one => .one
  | .negOne => .one

/-- Scaling matrices for all four polygon ends. -/
def gammaTwoCuspEndScaling : GammaTwoCuspEnd → SL(2, ℤ)
  | .atInfinity => 1
  | .zero => ModularGroup.S
  | .one => ModularGroup.T * ModularGroup.S
  | .negOne => ModularGroup.T⁻¹ * ModularGroup.S

/-- The endpoints `1` and `-1` are paired by the width-two translation. -/
theorem gammaTwo_one_negOne_scaling_pair :
    gammaTwoCuspEndScaling .one =
      ModularGroup.T ^ (2 : ℕ) * gammaTwoCuspEndScaling .negOne := by
  simp [gammaTwoCuspEndScaling, pow_two, mul_assoc]

/-! ##### The explicit standard ideal quadrilateral

The following data describe the usual ideal quadrilateral with ends
`-1, 0, 1, ∞`.  Its vertical sides are paired by `T²`; its two circular
sides are paired by `[[1,0],[2,1]]`.  This geometric object is kept distinct
from the noncomputably selected six-tile carrier until an equality theorem is
proved; no choice of coset representatives is silently identified with this
particular drawing.
-/

/-- The four geometric edges of the standard ideal quadrilateral. -/
inductive GammaTwoStandardEdge where
  | leftVertical
  | rightVertical
  | leftCircular
  | rightCircular
deriving DecidableEq

instance gammaTwoStandardEdgeFintype : Fintype GammaTwoStandardEdge where
  elems := {.leftVertical, .rightVertical, .leftCircular, .rightCircular}
  complete x := by cases x <;> simp

/-- Centers of the two circular sides. -/
noncomputable def gammaTwoLeftCircleCenter : ℂ := -((1 : ℝ) / 2)
noncomputable def gammaTwoRightCircleCenter : ℂ := (1 : ℝ) / 2

/-- Distance to the left circular-side center. -/
noncomputable def gammaTwoLeftCircleDistance (z : ℍ) : ℝ :=
  dist (z : ℂ) gammaTwoLeftCircleCenter

/-- Distance to the right circular-side center. -/
noncomputable def gammaTwoRightCircleDistance (z : ℍ) : ℝ :=
  dist (z : ℂ) gammaTwoRightCircleCenter

theorem gammaTwoLeftCircleDistance_continuous :
    Continuous gammaTwoLeftCircleDistance :=
  UpperHalfPlane.continuous_coe.dist continuous_const

theorem gammaTwoRightCircleDistance_continuous :
    Continuous gammaTwoRightCircleDistance :=
  UpperHalfPlane.continuous_coe.dist continuous_const

/-- The closed standard polygon
`-1 ≤ x ≤ 1`, exterior to both radius-`1/2` semicircles. -/
def gammaTwoStandardPolygonClosed : Set ℍ :=
  {z : ℍ | -1 ≤ z.re} ∩
  {z : ℍ | z.re ≤ 1} ∩
  {z : ℍ | (1 : ℝ) / 2 ≤ gammaTwoLeftCircleDistance z} ∩
  {z : ℍ | (1 : ℝ) / 2 ≤ gammaTwoRightCircleDistance z}

/-- The open interior of the standard ideal quadrilateral. -/
def gammaTwoStandardPolygonOpen : Set ℍ :=
  {z : ℍ | -1 < z.re} ∩
  {z : ℍ | z.re < 1} ∩
  {z : ℍ | (1 : ℝ) / 2 < gammaTwoLeftCircleDistance z} ∩
  {z : ℍ | (1 : ℝ) / 2 < gammaTwoRightCircleDistance z}

/-- A concrete half-open convention: retain the left vertical and left
circular sides, and discard their right partners.  The ideal vertices are on
the real boundary and hence are not points of `ℍ`. -/
def gammaTwoStandardPolygonHalfOpen : Set ℍ :=
  {z : ℍ | -1 ≤ z.re} ∩
  {z : ℍ | z.re < 1} ∩
  {z : ℍ | (1 : ℝ) / 2 ≤ gammaTwoLeftCircleDistance z} ∩
  {z : ℍ | (1 : ℝ) / 2 < gammaTwoRightCircleDistance z}

theorem mem_gammaTwoStandardPolygonClosed_iff {z : ℍ} :
    z ∈ gammaTwoStandardPolygonClosed ↔
      -1 ≤ z.re ∧ z.re ≤ 1 ∧
      (1 : ℝ) / 2 ≤ gammaTwoLeftCircleDistance z ∧
      (1 : ℝ) / 2 ≤ gammaTwoRightCircleDistance z := by
  simp [gammaTwoStandardPolygonClosed, and_assoc]

theorem mem_gammaTwoStandardPolygonOpen_iff {z : ℍ} :
    z ∈ gammaTwoStandardPolygonOpen ↔
      -1 < z.re ∧ z.re < 1 ∧
      (1 : ℝ) / 2 < gammaTwoLeftCircleDistance z ∧
      (1 : ℝ) / 2 < gammaTwoRightCircleDistance z := by
  simp [gammaTwoStandardPolygonOpen, and_assoc]

theorem mem_gammaTwoStandardPolygonHalfOpen_iff {z : ℍ} :
    z ∈ gammaTwoStandardPolygonHalfOpen ↔
      -1 ≤ z.re ∧ z.re < 1 ∧
      (1 : ℝ) / 2 ≤ gammaTwoLeftCircleDistance z ∧
      (1 : ℝ) / 2 < gammaTwoRightCircleDistance z := by
  simp [gammaTwoStandardPolygonHalfOpen, and_assoc]

theorem gammaTwoStandardPolygonClosed_isClosed :
    IsClosed gammaTwoStandardPolygonClosed := by
  exact (((isClosed_le continuous_const UpperHalfPlane.continuous_re).inter
    (isClosed_le UpperHalfPlane.continuous_re continuous_const)).inter
    (isClosed_le continuous_const gammaTwoLeftCircleDistance_continuous)).inter
    (isClosed_le continuous_const gammaTwoRightCircleDistance_continuous)

theorem gammaTwoStandardPolygonOpen_isOpen :
    IsOpen gammaTwoStandardPolygonOpen := by
  exact (((isOpen_lt continuous_const UpperHalfPlane.continuous_re).inter
    (isOpen_lt UpperHalfPlane.continuous_re continuous_const)).inter
    (isOpen_lt continuous_const gammaTwoLeftCircleDistance_continuous)).inter
    (isOpen_lt continuous_const gammaTwoRightCircleDistance_continuous)

theorem gammaTwoStandardPolygonHalfOpen_measurable :
    MeasurableSet gammaTwoStandardPolygonHalfOpen := by
  exact (((isClosed_le continuous_const UpperHalfPlane.continuous_re).measurableSet.inter
    (isOpen_lt UpperHalfPlane.continuous_re continuous_const).measurableSet).inter
    (isClosed_le continuous_const gammaTwoLeftCircleDistance_continuous).measurableSet).inter
    (isOpen_lt continuous_const gammaTwoRightCircleDistance_continuous).measurableSet

theorem gammaTwoStandardPolygonOpen_subset_halfOpen :
    gammaTwoStandardPolygonOpen ⊆ gammaTwoStandardPolygonHalfOpen := by
  intro z hz
  rw [mem_gammaTwoStandardPolygonOpen_iff] at hz
  rw [mem_gammaTwoStandardPolygonHalfOpen_iff]
  exact ⟨hz.1.le, hz.2.1, hz.2.2.1.le, hz.2.2.2⟩

theorem gammaTwoStandardPolygonHalfOpen_subset_closed :
    gammaTwoStandardPolygonHalfOpen ⊆ gammaTwoStandardPolygonClosed := by
  intro z hz
  rw [mem_gammaTwoStandardPolygonHalfOpen_iff] at hz
  rw [mem_gammaTwoStandardPolygonClosed_iff]
  exact ⟨hz.1, hz.2.1.le, hz.2.2.1, hz.2.2.2.le⟩

/-- Each edge as an actual subset of the upper half-plane. -/
def gammaTwoStandardEdgeSet : GammaTwoStandardEdge → Set ℍ
  | .leftVertical => {z : ℍ | z.re = -1}
  | .rightVertical => {z : ℍ | z.re = 1}
  | .leftCircular =>
      {z : ℍ | (z : ℂ) ∈
        Metric.sphere gammaTwoLeftCircleCenter ((1 : ℝ) / 2)}
  | .rightCircular =>
      {z : ℍ | (z : ℂ) ∈
        Metric.sphere gammaTwoRightCircleCenter ((1 : ℝ) / 2)}

/-- Union of the four named edges. -/
def gammaTwoStandardPolygonEdgeBoundary : Set ℍ :=
  ⋃ e : GammaTwoStandardEdge, gammaTwoStandardEdgeSet e

/-- The set difference between the closed and open polygon. -/
def gammaTwoStandardPolygonBoundary : Set ℍ :=
  gammaTwoStandardPolygonClosed \ gammaTwoStandardPolygonOpen

/-- Every boundary point lies on one of the four explicitly named edges. -/
theorem gammaTwoStandardPolygonBoundary_subset_edges :
    gammaTwoStandardPolygonBoundary ⊆
      gammaTwoStandardPolygonEdgeBoundary := by
  intro z hz
  rw [gammaTwoStandardPolygonBoundary, Set.mem_diff,
    mem_gammaTwoStandardPolygonClosed_iff] at hz
  rw [gammaTwoStandardPolygonEdgeBoundary, Set.mem_iUnion]
  by_cases hLV : -1 < z.re
  · by_cases hRV : z.re < 1
    · by_cases hLC : (1 : ℝ) / 2 < gammaTwoLeftCircleDistance z
      · have hRC : ¬(1 : ℝ) / 2 < gammaTwoRightCircleDistance z := by
          intro hRC
          exact hz.2 (mem_gammaTwoStandardPolygonOpen_iff.mpr
            ⟨hLV, hRV, hLC, hRC⟩)
        refine ⟨.rightCircular, ?_⟩
        change gammaTwoRightCircleDistance z = (1 : ℝ) / 2
        exact le_antisymm (le_of_not_gt hRC) hz.1.2.2.2
      · refine ⟨.leftCircular, ?_⟩
        change gammaTwoLeftCircleDistance z = (1 : ℝ) / 2
        exact le_antisymm (le_of_not_gt hLC) hz.1.2.2.1
    · refine ⟨.rightVertical, ?_⟩
      change z.re = 1
      exact le_antisymm hz.1.2.1 (le_of_not_gt hRV)
  · refine ⟨.leftVertical, ?_⟩
    change z.re = -1
    exact le_antisymm (le_of_not_gt hLV) hz.1.1

/-- A complex-null coe-image gives a hyperbolic-null upstairs set. -/
theorem hyperbolicMeasure_eq_zero_of_coe_image_eq_zero
    {s : Set ℍ}
    (hs : (volume : Measure ℂ) (UpperHalfPlane.coe '' s) = 0) :
    hyperbolicMeasure s = 0 := by
  change (volume : Measure ℍ) s = 0
  rw [UpperHalfPlane.volume_eq_lintegral]
  exact setLIntegral_measure_zero _ _ hs

theorem gammaTwoStandardEdgeSet_null (e : GammaTwoStandardEdge) :
    hyperbolicMeasure (gammaTwoStandardEdgeSet e) = 0 := by
  apply hyperbolicMeasure_eq_zero_of_coe_image_eq_zero
  cases e with
  | leftVertical =>
      exact measure_mono_null (by
        rintro w ⟨z, hz, rfl⟩
        exact hz) (complex_verticalLine_null (-1))
  | rightVertical =>
      exact measure_mono_null (by
        rintro w ⟨z, hz, rfl⟩
        exact hz) (complex_verticalLine_null 1)
  | leftCircular =>
      exact measure_mono_null (by
        rintro w ⟨z, hz, rfl⟩
        exact hz)
        (Measure.addHaar_sphere (volume : Measure ℂ)
          gammaTwoLeftCircleCenter ((1 : ℝ) / 2))
  | rightCircular =>
      exact measure_mono_null (by
        rintro w ⟨z, hz, rfl⟩
        exact hz)
        (Measure.addHaar_sphere (volume : Measure ℂ)
          gammaTwoRightCircleCenter ((1 : ℝ) / 2))

theorem gammaTwoStandardPolygonEdgeBoundary_null :
    hyperbolicMeasure gammaTwoStandardPolygonEdgeBoundary = 0 := by
  unfold gammaTwoStandardPolygonEdgeBoundary
  apply measure_iUnion_null
  exact gammaTwoStandardEdgeSet_null

theorem gammaTwoStandardPolygonBoundary_null :
    hyperbolicMeasure gammaTwoStandardPolygonBoundary = 0 :=
  measure_mono_null gammaTwoStandardPolygonBoundary_subset_edges
    gammaTwoStandardPolygonEdgeBoundary_null

/-- The concrete half-open convention differs from the open polygon only on
the explicitly null polygon boundary. -/
theorem gammaTwoStandardPolygonHalfOpen_ae_eq_open :
    gammaTwoStandardPolygonHalfOpen =ᵐ[hyperbolicMeasure]
      gammaTwoStandardPolygonOpen := by
  apply Filter.EventuallyLE.antisymm
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro z hz
      exact ⟨gammaTwoStandardPolygonHalfOpen_subset_closed hz.1, hz.2⟩)
      gammaTwoStandardPolygonBoundary_null
  · exact gammaTwoStandardPolygonOpen_subset_halfOpen.eventuallyLE

open scoped symmDiff in
theorem gammaTwoStandardPolygonHalfOpen_symmDiff_open_null :
    hyperbolicMeasure
      (gammaTwoStandardPolygonHalfOpen ∆
        gammaTwoStandardPolygonOpen) = 0 :=
  measure_symmDiff_eq_zero_iff.mpr
    gammaTwoStandardPolygonHalfOpen_ae_eq_open

/-- Pair the two vertical sides and the two circular sides. -/
def GammaTwoStandardEdge.paired :
    GammaTwoStandardEdge → GammaTwoStandardEdge
  | .leftVertical => .rightVertical
  | .rightVertical => .leftVertical
  | .leftCircular => .rightCircular
  | .rightCircular => .leftCircular

@[simp]
theorem GammaTwoStandardEdge.paired_paired (e : GammaTwoStandardEdge) :
    e.paired.paired = e := by
  cases e <;> rfl

/-- Boundary-orientation sign for the common positive parameter used below.
Left sides follow the positive parameter and right sides oppose it. -/
def GammaTwoStandardEdge.orientationSign :
    GammaTwoStandardEdge → ℤ
  | .leftVertical => 1
  | .rightVertical => -1
  | .leftCircular => 1
  | .rightCircular => -1

/-- Both side pairings reverse the induced boundary orientation. -/
theorem GammaTwoStandardEdge.pairing_reverses_orientation
    (e : GammaTwoStandardEdge) :
    e.paired.orientationSign = -e.orientationSign := by
  cases e <;> norm_num [GammaTwoStandardEdge.paired,
    GammaTwoStandardEdge.orientationSign]

/-- The vertical pairing matrix `T²`. -/
def gammaTwoVerticalPairingMatrix : SL(2, ℤ) :=
  ModularGroup.T ^ (2 : ℤ)

theorem gammaTwoVerticalPairingMatrix_mem :
    gammaTwoVerticalPairingMatrix ∈ GammaTwo := by
  have hdiv : (2 : ℤ) ∣ 2 := dvd_refl 2
  simpa [gammaTwoVerticalPairingMatrix] using
    CongruenceSubgroup.ModularGroup_T_pow_mem_Gamma
      (2 : ℤ) (2 : ℤ) hdiv

/-- The circular pairing matrix `[[1,0],[2,1]]`. -/
def gammaTwoCircularPairingMatrix : SL(2, ℤ) :=
  ⟨!![1, 0; 2, 1], by norm_num [Matrix.det_fin_two]⟩

theorem gammaTwoCircularPairingMatrix_mem :
    gammaTwoCircularPairingMatrix ∈ GammaTwo := by
  rw [CongruenceSubgroup.Gamma_mem]
  change (1 : ZMod 2) = 1 /\
    (0 : ZMod 2) = 0 /\
    (2 : ZMod 2) = 0 /\
    (1 : ZMod 2) = 1
  decide

/-- Bundled pairing elements in `Gamma(2)`. -/
def gammaTwoVerticalPairing : GammaTwo :=
  ⟨gammaTwoVerticalPairingMatrix, gammaTwoVerticalPairingMatrix_mem⟩

def gammaTwoCircularPairing : GammaTwo :=
  ⟨gammaTwoCircularPairingMatrix, gammaTwoCircularPairingMatrix_mem⟩

/-- Pairing element attached to each oriented edge. -/
def GammaTwoStandardEdge.pairingElement :
    GammaTwoStandardEdge → GammaTwo
  | .leftVertical => gammaTwoVerticalPairing
  | .rightVertical => gammaTwoVerticalPairing⁻¹
  | .leftCircular => gammaTwoCircularPairing
  | .rightCircular => gammaTwoCircularPairing⁻¹

@[simp]
theorem GammaTwoStandardEdge.paired_pairingElement
    (e : GammaTwoStandardEdge) :
    e.paired.pairingElement = e.pairingElement⁻¹ := by
  cases e <;> simp [GammaTwoStandardEdge.paired,
    GammaTwoStandardEdge.pairingElement]

/-- One positive parameter suffices for every open edge. -/
abbrev GammaTwoPositiveEdgeParameter := {t : ℝ // 0 < t}

/-- Explicit rational parametrizations.  The circular formulas are the
stereographic parametrizations of the two radius-`1/2` semicircles. -/
noncomputable def gammaTwoStandardEdgeParam
    (e : GammaTwoStandardEdge) (t : GammaTwoPositiveEdgeParameter) : ℍ :=
  match e with
  | .leftVertical =>
      ⟨Complex.mk (-1) t, by simpa using t.property⟩
  | .rightVertical =>
      ⟨Complex.mk 1 t, by simpa using t.property⟩
  | .leftCircular =>
      ⟨Complex.mk
          (-(t : ℝ) ^ 2 / (1 + (t : ℝ) ^ 2))
          ((t : ℝ) / (1 + (t : ℝ) ^ 2)),
        by
          dsimp
          exact div_pos t.property (by positivity)⟩
  | .rightCircular =>
      ⟨Complex.mk
          ((t : ℝ) ^ 2 / (1 + (t : ℝ) ^ 2))
          ((t : ℝ) / (1 + (t : ℝ) ^ 2)),
        by
          dsimp
          exact div_pos t.property (by positivity)⟩

/-- Every displayed parametrization lands on its named edge. -/
theorem gammaTwoStandardEdgeParam_mem
    (e : GammaTwoStandardEdge) (t : GammaTwoPositiveEdgeParameter) :
    gammaTwoStandardEdgeParam e t ∈ gammaTwoStandardEdgeSet e := by
  cases e with
  | leftVertical =>
      simp [gammaTwoStandardEdgeParam, gammaTwoStandardEdgeSet]
  | rightVertical =>
      simp [gammaTwoStandardEdgeParam, gammaTwoStandardEdgeSet]
  | leftCircular =>
      change dist
        ((gammaTwoStandardEdgeParam .leftCircular t : ℍ) : ℂ)
        gammaTwoLeftCircleCenter = (1 : ℝ) / 2
      rw [dist_eq_norm]
      have hden : 0 < 1 + (t : ℝ) ^ 2 := by positivity
      have hsq :
          Complex.normSq
              (((gammaTwoStandardEdgeParam .leftCircular t : ℍ) : ℂ) -
                gammaTwoLeftCircleCenter) = ((1 : ℝ) / 2) ^ 2 := by
        simp only [gammaTwoStandardEdgeParam, gammaTwoLeftCircleCenter,
          UpperHalfPlane.coe_mk, Complex.normSq_apply, Complex.sub_re,
          Complex.sub_im, Complex.neg_re, Complex.ofReal_re,
          Complex.neg_im, Complex.ofReal_im, sub_zero, neg_neg]
        norm_num
        field_simp [hden.ne']
        ring_nf
      have hsq' :
          ‖(((gammaTwoStandardEdgeParam .leftCircular t : ℍ) : ℂ) -
              gammaTwoLeftCircleCenter)‖ ^ 2 = ((1 : ℝ) / 2) ^ 2 := by
        simpa [Complex.normSq_eq_norm_sq] using hsq
      nlinarith [norm_nonneg
        (((gammaTwoStandardEdgeParam .leftCircular t : ℍ) : ℂ) -
          gammaTwoLeftCircleCenter)]
  | rightCircular =>
      change dist
        ((gammaTwoStandardEdgeParam .rightCircular t : ℍ) : ℂ)
        gammaTwoRightCircleCenter = (1 : ℝ) / 2
      rw [dist_eq_norm]
      have hden : 0 < 1 + (t : ℝ) ^ 2 := by positivity
      have hsq :
          Complex.normSq
              (((gammaTwoStandardEdgeParam .rightCircular t : ℍ) : ℂ) -
                gammaTwoRightCircleCenter) = ((1 : ℝ) / 2) ^ 2 := by
        simp only [gammaTwoStandardEdgeParam, gammaTwoRightCircleCenter,
          UpperHalfPlane.coe_mk, Complex.normSq_apply, Complex.sub_re,
          Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im, sub_zero]
        norm_num
        field_simp [hden.ne']
        ring_nf
      have hsq' :
          ‖(((gammaTwoStandardEdgeParam .rightCircular t : ℍ) : ℂ) -
              gammaTwoRightCircleCenter)‖ ^ 2 = ((1 : ℝ) / 2) ^ 2 := by
        simpa [Complex.normSq_eq_norm_sq] using hsq
      nlinarith [norm_nonneg
        (((gammaTwoStandardEdgeParam .rightCircular t : ℍ) : ℂ) -
          gammaTwoRightCircleCenter)]

/-- `T²` sends the left vertical parametrization to the right one with the
same positive parameter. -/
theorem gammaTwoVerticalPairing_param
    (t : GammaTwoPositiveEdgeParameter) :
    ((gammaTwoVerticalPairing : GammaTwo) : SL(2, ℤ)) •
        gammaTwoStandardEdgeParam .leftVertical t =
      gammaTwoStandardEdgeParam .rightVertical t := by
  change (ModularGroup.T ^ (2 : ℤ)) •
      gammaTwoStandardEdgeParam .leftVertical t =
    gammaTwoStandardEdgeParam .rightVertical t
  rw [UpperHalfPlane.modular_T_zpow_smul]
  rw [UpperHalfPlane.ext_iff]
  apply Complex.ext <;>
    norm_num [gammaTwoStandardEdgeParam, UpperHalfPlane.coe_vadd]

/-- The explicit circular matrix acts by `z ↦ z/(2z+1)`. -/
theorem gammaTwoCircularPairing_coe_smul (z : ℍ) :
    ((((gammaTwoCircularPairing : GammaTwo) : SL(2, ℤ)) • z : ℍ) : ℂ) =
      (z : ℂ) / (2 * (z : ℂ) + 1) := by
  rw [UpperHalfPlane.coe_specialLinearGroup_apply]
  norm_num [gammaTwoCircularPairing, gammaTwoCircularPairingMatrix]

/-- `[[1,0],[2,1]]` sends the left rational semicircle parametrization to
the right one, again with the same positive parameter. -/
theorem gammaTwoCircularPairing_param
    (t : GammaTwoPositiveEdgeParameter) :
    ((gammaTwoCircularPairing : GammaTwo) : SL(2, ℤ)) •
        gammaTwoStandardEdgeParam .leftCircular t =
      gammaTwoStandardEdgeParam .rightCircular t := by
  rw [UpperHalfPlane.ext_iff, gammaTwoCircularPairing_coe_smul]
  let d : ℝ := 1 + (t : ℝ) ^ 2
  have hd : 0 < d := by
    dsimp [d]
    positivity
  have hden :
      (2 : ℂ) *
          ((gammaTwoStandardEdgeParam .leftCircular t : ℍ) : ℂ) + 1 ≠ 0 := by
    simpa using UpperHalfPlane.linear_ne_zero
      (cd := ![(2 : ℝ), 1])
      (gammaTwoStandardEdgeParam .leftCircular t)
      (by
        intro h
        have h0 := congrFun h (0 : Fin 2)
        norm_num at h0)
  apply (div_eq_iff hden).2
  apply Complex.ext
  · simp only [gammaTwoStandardEdgeParam, UpperHalfPlane.coe_mk,
      Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
      Complex.ofReal_re, Complex.ofReal_im, Complex.one_re,
      Complex.one_im, zero_mul, mul_zero, add_zero]
    norm_num
    field_simp [hd.ne']
    ring_nf
  · simp only [gammaTwoStandardEdgeParam, UpperHalfPlane.coe_mk,
      Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
      Complex.ofReal_re, Complex.ofReal_im, Complex.one_re,
      Complex.one_im, zero_mul, mul_zero, add_zero]
    norm_num
    field_simp [hd.ne']
    ring_nf

/-- Every edge pairing carries the displayed parametrization to that of the
paired edge.  Since the paired edges have opposite orientation signs, this
is the precise orientation-reversal statement used in boundary cancellation.
-/
theorem gammaTwoStandardEdge_pairing_param
    (e : GammaTwoStandardEdge) (t : GammaTwoPositiveEdgeParameter) :
    ((e.pairingElement : GammaTwo) : SL(2, ℤ)) •
        gammaTwoStandardEdgeParam e t =
      gammaTwoStandardEdgeParam e.paired t := by
  cases e with
  | leftVertical =>
      exact gammaTwoVerticalPairing_param t
  | rightVertical =>
      exact inv_smul_eq_iff.mpr (gammaTwoVerticalPairing_param t).symm
  | leftCircular =>
      exact gammaTwoCircularPairing_param t
  | rightCircular =>
      exact inv_smul_eq_iff.mpr (gammaTwoCircularPairing_param t).symm

/-- Local height attached to a particular polygon end. -/
noncomputable def gammaTwoCuspEndHeight (e : GammaTwoCuspEnd) (z : ℍ) : ℝ :=
  ((gammaTwoCuspEndScaling e)⁻¹ • z).im

theorem gammaTwoCuspEndHeight_pos (e : GammaTwoCuspEnd) (z : ℍ) :
    0 < gammaTwoCuspEndHeight e z :=
  UpperHalfPlane.im_pos _

theorem gammaTwoCuspEndHeight_continuous (e : GammaTwoCuspEnd) :
    Continuous (gammaTwoCuspEndHeight e) := by
  change Continuous (fun z : ℍ =>
    ((((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
      ((gammaTwoCuspEndScaling e)⁻¹)) • z).im))
  exact UpperHalfPlane.continuous_im.comp
    (continuous_const_smul
      ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
        ((gammaTwoCuspEndScaling e)⁻¹)))

/-! The right-coset space is finite because `Gamma(2)` has finite index. -/

noncomputable instance gammaTwoRightCosetFintype :
    Fintype GammaTwoRightCoset := by
  letI : Fintype (SL(2, ℤ) ⧸ GammaTwo) :=
    Subgroup.fintypeQuotientOfFiniteIndex
  infer_instance

/-- Closed six-tile representative carrier.  Unlike the open carrier used for
integration, this contains every side-pairing boundary orbit. -/
noncomputable def gammaTwoClosedTileCarrier : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q • ModularGroup.fd

theorem mem_gammaTwoClosedTileCarrier_iff {z : ℍ} :
    z ∈ gammaTwoClosedTileCarrier ↔
      ∃ q : GammaTwoRightCoset, ∃ w : ℍ,
        w ∈ ModularGroup.fd ∧ gammaTwoCosetRep q • w = z := by
  simp only [gammaTwoClosedTileCarrier, Set.mem_iUnion, Set.mem_smul_set]

/-- The six closed modular tiles are exactly the closure of the selected
open measured carrier.  Finiteness of the right-coset space is the essential
point: closure commutes with this finite union. -/
theorem gammaTwoClosedTileCarrier_eq_closure_openCarrier :
    gammaTwoClosedTileCarrier = closure gammaTwoOpenCarrier := by
  classical
  unfold gammaTwoClosedTileCarrier gammaTwoOpenCarrier
  calc
    (⋃ q : GammaTwoRightCoset,
        gammaTwoCosetRep q • ModularGroup.fd) =
        ⋃ q : GammaTwoRightCoset,
          gammaTwoCosetRep q • closure ModularGroup.fdo := by
            simp_rw [← ModularGroup.fd_eq_closure_fdo]
    _ = ⋃ q : GammaTwoRightCoset,
          closure (gammaTwoCosetRep q • ModularGroup.fdo) := by
            apply Set.iUnion_congr
            intro q
            change
              ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
                  (gammaTwoCosetRep q)) • closure ModularGroup.fdo =
                closure
                  (((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
                    (gammaTwoCosetRep q)) • ModularGroup.fdo)
            exact (closure_smul _ _).symm
    _ = closure (⋃ q : GammaTwoRightCoset,
          gammaTwoCosetRep q • ModularGroup.fdo) := by
            symm
            exact closure_iUnion_of_finite _

/-- The literal closed tile carrier is definitionally the carrier selected
for quotient integration, after exposing the preceding geometric equality. -/
theorem gammaTwoClosedTileCarrier_eq_chosenCarrier :
    gammaTwoClosedTileCarrier =
      chosenGammaTwoFundamentalDomain.carrier := by
  rw [gammaTwoClosedTileCarrier_eq_closure_openCarrier]
  rfl

/-- The old open integration carrier sits inside the literal closed carrier. -/
theorem gammaTwoOpenCarrier_subset_closedTileCarrier :
    gammaTwoOpenCarrier ⊆ gammaTwoClosedTileCarrier := by
  rw [gammaTwoClosedTileCarrier_eq_closure_openCarrier]
  exact subset_closure

/-- The closed and open carriers differ only on a hyperbolic-null set. -/
theorem gammaTwoClosedTileCarrier_ae_eq_openCarrier :
    gammaTwoClosedTileCarrier =ᵐ[hyperbolicMeasure]
      gammaTwoOpenCarrier := by
  rw [gammaTwoClosedTileCarrier_eq_closure_openCarrier]
  exact gammaTwoOpenCarrier_closure_ae_eq

theorem gammaTwoClosedTileCarrier_diff_openCarrier_null :
    hyperbolicMeasure
      (gammaTwoClosedTileCarrier \ gammaTwoOpenCarrier) = 0 := by
  exact ae_le_set.mp gammaTwoClosedTileCarrier_ae_eq_openCarrier.le

/-- The modular one-tile half-open convention: include the circular side and
the left vertical side, exclude the right vertical side. -/
def modularHalfOpenTile : Set ℍ :=
  {z : ℍ | 1 ≤ Complex.normSq (z : ℂ)} ∩
  {z : ℍ | -((1 : ℝ) / 2) ≤ z.re} ∩
  {z : ℍ | z.re < (1 : ℝ) / 2}

theorem mem_modularHalfOpenTile_iff {z : ℍ} :
    z ∈ modularHalfOpenTile ↔
      1 ≤ Complex.normSq (z : ℂ) ∧
      -((1 : ℝ) / 2) ≤ z.re ∧ z.re < (1 : ℝ) / 2 := by
  simp [modularHalfOpenTile, and_assoc]

theorem modularHalfOpenTile_measurable :
    MeasurableSet modularHalfOpenTile := by
  exact ((isClosed_le continuous_const
    (Complex.continuous_normSq.comp UpperHalfPlane.continuous_coe)).measurableSet.inter
    (isClosed_le continuous_const UpperHalfPlane.continuous_re).measurableSet).inter
    (isOpen_lt UpperHalfPlane.continuous_re continuous_const).measurableSet

theorem ModularGroup.fdo_subset_modularHalfOpenTile :
    ModularGroup.fdo ⊆ modularHalfOpenTile := by
  intro z hz
  change 1 < Complex.normSq (z : ℂ) ∧
    |z.re| < (1 : ℝ) / 2 at hz
  rw [mem_modularHalfOpenTile_iff]
  exact ⟨hz.1.le, (neg_lt_of_abs_lt hz.2).le, lt_of_abs_lt hz.2⟩

theorem modularHalfOpenTile_subset_fd :
    modularHalfOpenTile ⊆ ModularGroup.fd := by
  intro z hz
  rw [mem_modularHalfOpenTile_iff] at hz
  change 1 ≤ Complex.normSq (z : ℂ) ∧
    |z.re| ≤ (1 : ℝ) / 2
  exact ⟨hz.1, abs_le.mpr ⟨hz.2.1, hz.2.2.le⟩⟩

/-- The actually verified half-open six-tile carrier.  Unlike the explicit
ideal quadrilateral above, this construction uses exactly the selected
right-coset tiles that define the quotient measure. -/
noncomputable def gammaTwoHalfOpenTileCarrier : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q • modularHalfOpenTile

theorem gammaTwoHalfOpenTileCarrier_measurable :
    MeasurableSet gammaTwoHalfOpenTileCarrier := by
  unfold gammaTwoHalfOpenTileCarrier
  apply MeasurableSet.iUnion
  intro q
  change MeasurableSet
    (((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
      (gammaTwoCosetRep q)) • modularHalfOpenTile)
  exact MeasurableSet.const_smul modularHalfOpenTile_measurable
    ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ))
      (gammaTwoCosetRep q))

theorem gammaTwoOpenCarrier_subset_halfOpenTileCarrier :
    gammaTwoOpenCarrier ⊆ gammaTwoHalfOpenTileCarrier := by
  intro z hz
  rcases mem_gammaTwoOpenCarrier_iff.mp hz with ⟨q, w, hw, rfl⟩
  unfold gammaTwoHalfOpenTileCarrier
  exact Set.mem_iUnion.2 ⟨q,
    Set.mem_smul_set.mpr
      ⟨w, ModularGroup.fdo_subset_modularHalfOpenTile hw, rfl⟩⟩

theorem gammaTwoHalfOpenTileCarrier_subset_closedTileCarrier :
    gammaTwoHalfOpenTileCarrier ⊆ gammaTwoClosedTileCarrier := by
  intro z hz
  rcases Set.mem_iUnion.mp hz with ⟨q, hq⟩
  rcases Set.mem_smul_set.mp hq with ⟨w, hw, rfl⟩
  exact mem_gammaTwoClosedTileCarrier_iff.mpr
    ⟨q, w, modularHalfOpenTile_subset_fd hw, rfl⟩

theorem gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier :
    gammaTwoHalfOpenTileCarrier =ᵐ[hyperbolicMeasure]
      gammaTwoOpenCarrier := by
  apply Filter.EventuallyLE.antisymm
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro z hz
      exact ⟨gammaTwoHalfOpenTileCarrier_subset_closedTileCarrier hz.1,
        hz.2⟩) gammaTwoClosedTileCarrier_diff_openCarrier_null
  · exact gammaTwoOpenCarrier_subset_halfOpenTileCarrier.eventuallyLE

/-- The half-open and chosen closed carriers have null symmetric difference.
This is the actual measured-equivalence theorem used below. -/
theorem gammaTwoHalfOpenTileCarrier_ae_eq_chosenCarrier :
    gammaTwoHalfOpenTileCarrier =ᵐ[hyperbolicMeasure]
      chosenGammaTwoFundamentalDomain.carrier := by
  exact gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier.trans
    gammaTwoOpenCarrier_closure_ae_eq.symm

open scoped symmDiff in
theorem gammaTwoHalfOpenTileCarrier_symmDiff_chosenCarrier_null :
    hyperbolicMeasure
      (gammaTwoHalfOpenTileCarrier ∆
        chosenGammaTwoFundamentalDomain.carrier) = 0 :=
  measure_symmDiff_eq_zero_iff.mpr
    gammaTwoHalfOpenTileCarrier_ae_eq_chosenCarrier

theorem gammaTwoHalfOpenTileCarrier_isFundamental :
    IsFundamentalDomain GammaTwoEffective gammaTwoHalfOpenTileCarrier
      hyperbolicMeasure := by
  refine IsFundamentalDomain.mk''
    gammaTwoHalfOpenTileCarrier_measurable.nullMeasurableSet
    (gammaTwoOpenCarrier_isFundamental.ae_covers.mono fun z hz ↦ by
      rcases hz with ⟨a, ha⟩
      exact ⟨a, gammaTwoOpenCarrier_subset_halfOpenTileCarrier ha⟩) ?_ ?_
  · intro a ha
    exact AEDisjoint.congr
      ((gammaTwoOpenCarrier_disjoint a ha).aedisjoint)
      (MeasureTheory.Measure.QuasiMeasurePreserving.smul_ae_eq_of_ae_eq a
        (measurePreserving_smul a⁻¹ hyperbolicMeasure).quasiMeasurePreserving
        gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier)
      gammaTwoHalfOpenTileCarrier_ae_eq_openCarrier
  · intro a
    exact (measurePreserving_smul a hyperbolicMeasure).quasiMeasurePreserving

/-- The frontier of the half-open carrier is no larger than the frontier of
the open carrier: `open ⊆ half-open ⊆ closure(open)`. -/
theorem gammaTwoHalfOpenTileCarrier_frontier_subset_openCarrier_frontier :
    frontier gammaTwoHalfOpenTileCarrier ⊆
      frontier gammaTwoOpenCarrier := by
  have hHalfClosure :
      gammaTwoHalfOpenTileCarrier ⊆ closure gammaTwoOpenCarrier := by
    rw [← gammaTwoClosedTileCarrier_eq_closure_openCarrier]
    exact gammaTwoHalfOpenTileCarrier_subset_closedTileCarrier
  have hOpenInterior :
      gammaTwoOpenCarrier ⊆ interior gammaTwoHalfOpenTileCarrier :=
    interior_maximal gammaTwoOpenCarrier_subset_halfOpenTileCarrier
      gammaTwoOpenCarrier_isOpen
  intro z hz
  change z ∈ closure gammaTwoHalfOpenTileCarrier ∧
    z ∉ interior gammaTwoHalfOpenTileCarrier at hz
  change z ∈ closure gammaTwoOpenCarrier ∧
    z ∉ interior gammaTwoOpenCarrier
  refine ⟨closure_minimal hHalfClosure isClosed_closure hz.1, ?_⟩
  rw [gammaTwoOpenCarrier_isOpen.interior_eq]
  exact fun hzOpen ↦ hz.2 (hOpenInterior hzOpen)

theorem gammaTwoHalfOpenTileCarrier_frontier_null :
    hyperbolicMeasure
      (frontier gammaTwoHalfOpenTileCarrier) = 0 :=
  measure_mono_null
    gammaTwoHalfOpenTileCarrier_frontier_subset_openCarrier_frontier
    gammaTwoOpenCarrier_frontier_null

/-! ##### Finite edge data on the actual measured polygon

The ideal quadrilateral above is useful for displaying the familiar four
pairings, but no equality with the noncomputably selected right-coset carrier
is asserted.  The following finite complex is instead attached directly to
the carrier for which `IsFundamentalDomain` was proved.  Each selected modular
tile has one circular arc and two vertical segments; all sets remain restricted
to `modularBoundary`, so the words "arc" and "segment" do not mean an entire
supporting circle or line.
-/

/-- The three geometric kinds that can occur on a truncated polygon boundary.
The horocycle constructor is used below after the height cutoff is imposed. -/
inductive GammaTwoBoundaryPieceKind
  | circularArc
  | verticalSegment
  | horocycleSegment
deriving DecidableEq

instance gammaTwoBoundaryPieceKindFintype :
    Fintype GammaTwoBoundaryPieceKind where
  elems := {.circularArc, .verticalSegment, .horocycleSegment}
  complete x := by cases x <;> simp

/-- The three sides of one half-open modular tile. -/
inductive GammaTwoModularTileEdge
  | circularArc
  | leftVerticalSegment
  | rightVerticalSegment
deriving DecidableEq

instance gammaTwoModularTileEdgeFintype :
    Fintype GammaTwoModularTileEdge where
  elems := {.circularArc, .leftVerticalSegment, .rightVerticalSegment}
  complete x := by cases x <;> simp

/-- Forget the left/right label while retaining the geometric kind. -/
def GammaTwoModularTileEdge.kind :
    GammaTwoModularTileEdge → GammaTwoBoundaryPieceKind
  | .circularArc => .circularArc
  | .leftVerticalSegment => .verticalSegment
  | .rightVerticalSegment => .verticalSegment

/-- Chosen orientation relative to the real parameters below.  The two
vertical sides receive opposite signs; the circular parameter is oriented
from its left endpoint to its right endpoint. -/
def GammaTwoModularTileEdge.orientationSign :
    GammaTwoModularTileEdge → ℤ
  | .circularArc => 1
  | .leftVerticalSegment => -1
  | .rightVerticalSegment => 1

/-- Exact edge pieces of the closed modular tile.  Intersecting with
`modularBoundary` cuts the supporting circle/lines down to the genuine arcs
and vertical rays of the tile. -/
def modularTileEdgeSet : GammaTwoModularTileEdge → Set ℍ
  | .circularArc =>
      modularBoundary ∩
        {z : ℍ | (z : ℂ) ∈ Metric.sphere (0 : ℂ) 1}
  | .leftVerticalSegment =>
      modularBoundary ∩ {z : ℍ | z.re = -((1 : ℝ) / 2)}
  | .rightVerticalSegment =>
      modularBoundary ∩ {z : ℍ | z.re = (1 : ℝ) / 2}

theorem modularTileEdgeSet_subset_boundary
    (e : GammaTwoModularTileEdge) :
    modularTileEdgeSet e ⊆ modularBoundary := by
  cases e <;> exact Set.inter_subset_left

/-- The three named edge pieces cover the whole modular boundary. -/
theorem modularBoundary_subset_iUnion_modularTileEdgeSet :
    modularBoundary ⊆ ⋃ e : GammaTwoModularTileEdge,
      modularTileEdgeSet e := by
  intro z hz
  have hsupport := modularBoundary_complex_subset
    (show (z : ℂ) ∈ UpperHalfPlane.coe '' modularBoundary from
      ⟨z, hz, rfl⟩)
  rcases hsupport with hcircle | hvertical
  · exact Set.mem_iUnion.2 ⟨.circularArc, hz, hcircle⟩
  · rcases hvertical with hright | hleft
    · exact Set.mem_iUnion.2 ⟨.rightVerticalSegment, hz, hright⟩
    · exact Set.mem_iUnion.2 ⟨.leftVerticalSegment, hz, hleft⟩

/-- The half-open convention changes side ownership but introduces no new
topological boundary beyond the three closed modular edge pieces. -/
theorem frontier_modularHalfOpenTile_subset_modularBoundary :
    frontier modularHalfOpenTile ⊆ modularBoundary := by
  have hHalfClosure :
      modularHalfOpenTile ⊆ closure ModularGroup.fdo := by
    rw [← ModularGroup.fd_eq_closure_fdo]
    exact modularHalfOpenTile_subset_fd
  have hOpenInterior :
      ModularGroup.fdo ⊆ interior modularHalfOpenTile :=
    interior_maximal ModularGroup.fdo_subset_modularHalfOpenTile
      ModularGroup.isOpen_fdo
  intro z hz
  change z ∈ closure modularHalfOpenTile ∧
    z ∉ interior modularHalfOpenTile at hz
  refine ⟨?_, ?_⟩
  · rw [ModularGroup.fd_eq_closure_fdo]
    exact closure_minimal hHalfClosure isClosed_closure hz.1
  · exact fun hzOpen ↦ hz.2 (hOpenInterior hzOpen)

/-- Finite index type for the actual polygon edges: one of three modular
edge pieces on one of the finitely many selected right-coset tiles. -/
abbrev GammaTwoActualPolygonEdge : Type :=
  GammaTwoRightCoset × GammaTwoModularTileEdge

/-- Edge set on the actual selected tile complex. -/
noncomputable def gammaTwoActualPolygonEdgeSet
    (e : GammaTwoActualPolygonEdge) : Set ℍ :=
  gammaTwoCosetRep e.1 • modularTileEdgeSet e.2

/-- Orientation sign of an edge in the actual selected tile complex. -/
def GammaTwoActualPolygonEdge.orientationSign
    (e : GammaTwoActualPolygonEdge) : ℤ :=
  e.2.orientationSign

/-- Real parameter set for each exact modular edge.  The circular arc uses
`-1 ≤ t ≤ 1` as twice the real coordinate; each vertical ray starts at its
lowest vertex and uses a nonnegative height increment. -/
def modularTileEdgeParameterSet : GammaTwoModularTileEdge → Set ℝ
  | .circularArc => Set.Icc (-1) 1
  | .leftVerticalSegment => Set.Ici 0
  | .rightVerticalSegment => Set.Ici 0

/-- Canonical finite endpoint set of an exact modular edge parameter domain. -/
noncomputable def modularTileEdgeEndpoints :
    GammaTwoModularTileEdge → Finset ℝ
  | .circularArc => {-1, 1}
  | .leftVerticalSegment => {0}
  | .rightVerticalSegment => {0}

/-- Every declared endpoint is an admissible parameter for its edge. -/
theorem modularTileEdgeEndpoints_subset_parameterSet
    (e : GammaTwoModularTileEdge) :
    (↑(modularTileEdgeEndpoints e) : Set ℝ) ⊆
      modularTileEdgeParameterSet e := by
  cases e <;> intro x hx
  · simp [modularTileEdgeEndpoints, modularTileEdgeParameterSet] at hx ⊢
    rcases hx with rfl | rfl <;> constructor <;> norm_num
  · have hx0 : x = 0 := by
      simpa [modularTileEdgeEndpoints] using hx
    subst x
    change (0 : ℝ) ≤ 0
    exact le_rfl
  · have hx0 : x = 0 := by
      simpa [modularTileEdgeEndpoints] using hx
    subst x
    change (0 : ℝ) ≤ 0
    exact le_rfl

/-- Modular side paired to a given modular tile edge. -/
def GammaTwoModularTileEdge.paired :
    GammaTwoModularTileEdge → GammaTwoModularTileEdge
  | .circularArc => .circularArc
  | .leftVerticalSegment => .rightVerticalSegment
  | .rightVerticalSegment => .leftVerticalSegment

@[simp]
theorem GammaTwoModularTileEdge.paired_paired
    (e : GammaTwoModularTileEdge) : e.paired.paired = e := by
  cases e <;> rfl

/-- Full-modular side pairing used before transport to `Gamma(2)`. -/
def GammaTwoModularTileEdge.pairingMatrix :
    GammaTwoModularTileEdge → SL(2, ℤ)
  | .circularArc => ModularGroup.S
  | .leftVerticalSegment => ModularGroup.T
  | .rightVerticalSegment => ModularGroup.T⁻¹

/-- Sign of the real parameter change under the modular side pairing. -/
def GammaTwoModularTileEdge.parameterSign :
    GammaTwoModularTileEdge → ℤ
  | .circularArc => -1
  | .leftVerticalSegment => 1
  | .rightVerticalSegment => 1

/-- The parameter transported to the paired modular edge. -/
def GammaTwoModularTileEdge.pairedParameter :
    (e : GammaTwoModularTileEdge) →
      modularTileEdgeParameterSet e →
        modularTileEdgeParameterSet e.paired
  | .circularArc, t =>
      ⟨-(t : ℝ), by
        constructor <;> linarith [t.property.1, t.property.2]⟩
  | .leftVerticalSegment, t => t
  | .rightVerticalSegment, t => t

/-- The parameter change on a paired modular side is onto.  In particular,
the circular involution `t ↦ -t` loses neither endpoint, and the two vertical
parameter domains are identified literally. -/
theorem GammaTwoModularTileEdge.pairedParameter_surjective
    (e : GammaTwoModularTileEdge) :
    Function.Surjective e.pairedParameter := by
  cases e with
  | circularArc =>
      intro u
      let t : Set.Icc (-1 : ℝ) 1 :=
        ⟨-(u : ℝ), by
          constructor <;> linarith [u.property.1, u.property.2]⟩
      refine ⟨t, ?_⟩
      apply Subtype.ext
      simp [GammaTwoModularTileEdge.pairedParameter, t]
  | leftVerticalSegment =>
      intro u
      exact ⟨u, rfl⟩
  | rightVerticalSegment =>
      intro u
      exact ⟨u, rfl⟩

/-- The modular pairing carries the finite endpoint set to the finite endpoint
set of the paired side. -/
theorem GammaTwoModularTileEdge.pairedParameter_mem_endpoints
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e)
    (ht : (t : ℝ) ∈ modularTileEdgeEndpoints e) :
    (e.pairedParameter t : ℝ) ∈ modularTileEdgeEndpoints e.paired := by
  cases e with
  | circularArc =>
      simp only [GammaTwoModularTileEdge.pairedParameter,
        GammaTwoModularTileEdge.paired, modularTileEdgeEndpoints,
        Finset.mem_insert, Finset.mem_singleton] at ht ⊢
      rcases ht with ht | ht
      · exact Or.inr (by linarith)
      · exact Or.inl (by linarith)
  | leftVerticalSegment =>
      simpa [GammaTwoModularTileEdge.pairedParameter,
        GammaTwoModularTileEdge.paired, modularTileEdgeEndpoints] using ht
  | rightVerticalSegment =>
      simpa [GammaTwoModularTileEdge.pairedParameter,
        GammaTwoModularTileEdge.paired, modularTileEdgeEndpoints] using ht

/-- The geometric boundary orientation is reversed after combining the edge
orientation with the parameter change. -/
theorem GammaTwoModularTileEdge.pairing_reverses_orientation
    (e : GammaTwoModularTileEdge) :
    e.paired.orientationSign * e.parameterSign = -e.orientationSign := by
  cases e <;> norm_num [GammaTwoModularTileEdge.paired,
    GammaTwoModularTileEdge.orientationSign,
    GammaTwoModularTileEdge.parameterSign]

/-- Explicit upper-unit-circle parametrization of the modular circular arc. -/
noncomputable def modularCircularArcParam (t : Set.Icc (-1 : ℝ) 1) : ℍ :=
  ⟨Complex.mk ((t : ℝ) / 2)
      (Real.sqrt (1 - ((t : ℝ) / 2) ^ 2)), by
    apply Real.sqrt_pos.2
    have hprod :
        0 ≤ (1 - (t : ℝ)) * ((t : ℝ) + 1) :=
      mul_nonneg (sub_nonneg.mpr t.property.2)
        (by linarith [t.property.1])
    nlinarith⟩

/-- Explicit left vertical ray, starting at height `sqrt 3 / 2`. -/
noncomputable def modularLeftVerticalParam (t : Set.Ici (0 : ℝ)) : ℍ :=
  ⟨Complex.mk (-((1 : ℝ) / 2))
      (Real.sqrt 3 / 2 + (t : ℝ)), by
    have hsqrt : 0 < Real.sqrt (3 : ℝ) := Real.sqrt_pos.2 (by norm_num)
    exact add_pos_of_pos_of_nonneg (div_pos hsqrt (by norm_num)) t.property⟩

/-- Explicit right vertical ray, starting at height `sqrt 3 / 2`. -/
noncomputable def modularRightVerticalParam (t : Set.Ici (0 : ℝ)) : ℍ :=
  ⟨Complex.mk ((1 : ℝ) / 2)
      (Real.sqrt 3 / 2 + (t : ℝ)), by
    have hsqrt : 0 < Real.sqrt (3 : ℝ) := Real.sqrt_pos.2 (by norm_num)
    exact add_pos_of_pos_of_nonneg (div_pos hsqrt (by norm_num)) t.property⟩

/-- The explicit parametrization selected by a modular edge label. -/
noncomputable def modularTileEdgeParam :
    (e : GammaTwoModularTileEdge) →
      modularTileEdgeParameterSet e → ℍ
  | .circularArc, t => modularCircularArcParam t
  | .leftVerticalSegment, t => modularLeftVerticalParam t
  | .rightVerticalSegment, t => modularRightVerticalParam t

theorem modularCircularArcParam_mem (t : Set.Icc (-1 : ℝ) 1) :
    modularCircularArcParam t ∈ modularTileEdgeSet .circularArc := by
  have hprod :
      0 ≤ (1 - (t : ℝ)) * ((t : ℝ) + 1) :=
    mul_nonneg (sub_nonneg.mpr t.property.2)
      (by linarith [t.property.1])
  have hs : 0 ≤ 1 - ((t : ℝ) / 2) ^ 2 := by
    nlinarith
  have hsqrt := Real.sq_sqrt hs
  have hnormSq :
      Complex.normSq (modularCircularArcParam t : ℂ) = 1 := by
    simp only [modularCircularArcParam, UpperHalfPlane.coe_mk,
      Complex.normSq_apply]
    nlinarith [hsqrt]
  refine ⟨?_, ?_⟩
  · refine ⟨?_, ?_⟩
    · change 1 ≤ Complex.normSq (modularCircularArcParam t : ℂ) ∧
        |(modularCircularArcParam t).re| ≤ (1 : ℝ) / 2
      refine ⟨hnormSq.ge, ?_⟩
      change |(t : ℝ) / 2| ≤ (1 : ℝ) / 2
      rw [abs_le]
      constructor <;> linarith [t.property.1, t.property.2]
    · change ¬(1 < Complex.normSq (modularCircularArcParam t : ℂ) ∧
        |(modularCircularArcParam t).re| < (1 : ℝ) / 2)
      intro h
      linarith [h.1, hnormSq]
  · change (modularCircularArcParam t : ℂ) ∈ Metric.sphere 0 1
    rw [mem_sphere_zero_iff_norm]
    have hsq : ‖(modularCircularArcParam t : ℂ)‖ ^ 2 = 1 := by
      simpa [Complex.normSq_eq_norm_sq] using hnormSq
    nlinarith [norm_nonneg (modularCircularArcParam t : ℂ)]

theorem modularLeftVerticalParam_mem (t : Set.Ici (0 : ℝ)) :
    modularLeftVerticalParam t ∈
      modularTileEdgeSet .leftVerticalSegment := by
  have hsqrtSq : (Real.sqrt (3 : ℝ)) ^ 2 = 3 :=
    Real.sq_sqrt (by norm_num)
  have hsqrtNonneg : 0 ≤ Real.sqrt (3 : ℝ) := Real.sqrt_nonneg _
  have hcross : 0 ≤ Real.sqrt (3 : ℝ) * (t : ℝ) :=
    mul_nonneg hsqrtNonneg t.property
  refine ⟨?_, ?_⟩
  · refine ⟨?_, ?_⟩
    · change 1 ≤ Complex.normSq (modularLeftVerticalParam t : ℂ) ∧
        |(modularLeftVerticalParam t).re| ≤ (1 : ℝ) / 2
      constructor
      · simp only [modularLeftVerticalParam, UpperHalfPlane.coe_mk,
          Complex.normSq_apply]
        nlinarith [sq_nonneg (t : ℝ)]
      · simp [modularLeftVerticalParam]
    · change ¬(1 < Complex.normSq (modularLeftVerticalParam t : ℂ) ∧
        |(modularLeftVerticalParam t).re| < (1 : ℝ) / 2)
      simp [modularLeftVerticalParam]
  · simp [modularLeftVerticalParam]

theorem modularRightVerticalParam_mem (t : Set.Ici (0 : ℝ)) :
    modularRightVerticalParam t ∈
      modularTileEdgeSet .rightVerticalSegment := by
  have hsqrtSq : (Real.sqrt (3 : ℝ)) ^ 2 = 3 :=
    Real.sq_sqrt (by norm_num)
  have hsqrtNonneg : 0 ≤ Real.sqrt (3 : ℝ) := Real.sqrt_nonneg _
  have hcross : 0 ≤ Real.sqrt (3 : ℝ) * (t : ℝ) :=
    mul_nonneg hsqrtNonneg t.property
  refine ⟨?_, ?_⟩
  · refine ⟨?_, ?_⟩
    · change 1 ≤ Complex.normSq (modularRightVerticalParam t : ℂ) ∧
        |(modularRightVerticalParam t).re| ≤ (1 : ℝ) / 2
      constructor
      · simp only [modularRightVerticalParam, UpperHalfPlane.coe_mk,
          Complex.normSq_apply]
        nlinarith [sq_nonneg (t : ℝ)]
      · simp [modularRightVerticalParam]
    · change ¬(1 < Complex.normSq (modularRightVerticalParam t : ℂ) ∧
        |(modularRightVerticalParam t).re| < (1 : ℝ) / 2)
      simp [modularRightVerticalParam]
  · simp [modularRightVerticalParam]

/-- Every explicit modular edge parametrization lands on the exact named
boundary piece. -/
theorem modularTileEdgeParam_mem
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e) :
    modularTileEdgeParam e t ∈ modularTileEdgeSet e := by
  cases e with
  | circularArc => exact modularCircularArcParam_mem t
  | leftVerticalSegment => exact modularLeftVerticalParam_mem t
  | rightVerticalSegment => exact modularRightVerticalParam_mem t

/-- The upper-unit-circle parameter is onto the exact circular boundary arc,
including both finite vertices. -/
theorem modularCircularArcParam_range :
    Set.range modularCircularArcParam =
      modularTileEdgeSet .circularArc := by
  apply Set.Subset.antisymm
  · rintro z ⟨t, rfl⟩
    exact modularCircularArcParam_mem t
  · intro z hz
    have hzBoundary :
        z ∈ ModularGroup.fd ∧ z ∉ ModularGroup.fdo := hz.1
    have hzfd := hzBoundary.1
    change 1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2 at hzfd
    have hreBounds :
        -((1 : ℝ) / 2) ≤ z.re ∧ z.re ≤ (1 : ℝ) / 2 :=
      abs_le.mp hzfd.2
    let t : Set.Icc (-1 : ℝ) 1 :=
      ⟨2 * z.re, by constructor <;> linarith [hreBounds.1, hreBounds.2]⟩
    refine ⟨t, ?_⟩
    have hnorm : ‖(z : ℂ)‖ = 1 :=
      mem_sphere_zero_iff_norm.mp hz.2
    have hnormSq : Complex.normSq (z : ℂ) = 1 := by
      rw [Complex.normSq_eq_norm_sq, hnorm]
      norm_num
    have himSq : (z : ℂ).im ^ 2 = 1 - (z : ℂ).re ^ 2 := by
      simp only [Complex.normSq_apply] at hnormSq
      nlinarith
    rw [UpperHalfPlane.ext_iff]
    apply Complex.ext
    · change (2 * z.re) / 2 = z.re
      ring
    · change Real.sqrt (1 - ((2 * z.re) / 2) ^ 2) = z.im
      have himSq' : z.im ^ 2 = 1 - z.re ^ 2 := by
        exact himSq
      have hinside :
          1 - ((2 * z.re) / 2) ^ 2 = z.im ^ 2 := by
        nlinarith [himSq']
      rw [hinside, Real.sqrt_sq_eq_abs, abs_of_pos z.im_pos]

/-- The height-increment parameter is onto the exact left vertical ray. -/
theorem modularLeftVerticalParam_range :
    Set.range modularLeftVerticalParam =
      modularTileEdgeSet .leftVerticalSegment := by
  apply Set.Subset.antisymm
  · rintro z ⟨t, rfl⟩
    exact modularLeftVerticalParam_mem t
  · intro z hz
    have hzBoundary :
        z ∈ ModularGroup.fd ∧ z ∉ ModularGroup.fdo := hz.1
    have hzfd := hzBoundary.1
    change 1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2 at hzfd
    have hnormLower :
        1 ≤ (z : ℂ).re * (z : ℂ).re + (z : ℂ).im * (z : ℂ).im := by
      simpa only [Complex.normSq_apply] using hzfd.1
    have hre : (z : ℂ).re = -((1 : ℝ) / 2) := hz.2
    have hsqrtSq : (Real.sqrt (3 : ℝ)) ^ 2 = 3 :=
      Real.sq_sqrt (by norm_num)
    have hbaseSq :
        (Real.sqrt (3 : ℝ) / 2) ^ 2 ≤ z.im ^ 2 := by
      change (Real.sqrt (3 : ℝ) / 2) ^ 2 ≤ (z : ℂ).im ^ 2
      rw [hre] at hnormLower
      nlinarith [hsqrtSq]
    have hbaseNonneg : 0 ≤ Real.sqrt (3 : ℝ) / 2 :=
      div_nonneg (Real.sqrt_nonneg _) (by norm_num)
    have hbase : Real.sqrt (3 : ℝ) / 2 ≤ z.im :=
      (sq_le_sq₀ hbaseNonneg z.im_pos.le).mp hbaseSq
    let t : Set.Ici (0 : ℝ) :=
      ⟨z.im - Real.sqrt 3 / 2, sub_nonneg.mpr hbase⟩
    refine ⟨t, ?_⟩
    rw [UpperHalfPlane.ext_iff]
    apply Complex.ext
    · change -((1 : ℝ) / 2) = z.re
      exact hre.symm
    · change Real.sqrt 3 / 2 +
        (z.im - Real.sqrt 3 / 2) = z.im
      ring

/-- The height-increment parameter is onto the exact right vertical ray. -/
theorem modularRightVerticalParam_range :
    Set.range modularRightVerticalParam =
      modularTileEdgeSet .rightVerticalSegment := by
  apply Set.Subset.antisymm
  · rintro z ⟨t, rfl⟩
    exact modularRightVerticalParam_mem t
  · intro z hz
    have hzBoundary :
        z ∈ ModularGroup.fd ∧ z ∉ ModularGroup.fdo := hz.1
    have hzfd := hzBoundary.1
    change 1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2 at hzfd
    have hnormLower :
        1 ≤ (z : ℂ).re * (z : ℂ).re + (z : ℂ).im * (z : ℂ).im := by
      simpa only [Complex.normSq_apply] using hzfd.1
    have hre : (z : ℂ).re = (1 : ℝ) / 2 := hz.2
    have hsqrtSq : (Real.sqrt (3 : ℝ)) ^ 2 = 3 :=
      Real.sq_sqrt (by norm_num)
    have hbaseSq :
        (Real.sqrt (3 : ℝ) / 2) ^ 2 ≤ z.im ^ 2 := by
      change (Real.sqrt (3 : ℝ) / 2) ^ 2 ≤ (z : ℂ).im ^ 2
      rw [hre] at hnormLower
      nlinarith [hsqrtSq]
    have hbaseNonneg : 0 ≤ Real.sqrt (3 : ℝ) / 2 :=
      div_nonneg (Real.sqrt_nonneg _) (by norm_num)
    have hbase : Real.sqrt (3 : ℝ) / 2 ≤ z.im :=
      (sq_le_sq₀ hbaseNonneg z.im_pos.le).mp hbaseSq
    let t : Set.Ici (0 : ℝ) :=
      ⟨z.im - Real.sqrt 3 / 2, sub_nonneg.mpr hbase⟩
    refine ⟨t, ?_⟩
    rw [UpperHalfPlane.ext_iff]
    apply Complex.ext
    · change (1 : ℝ) / 2 = z.re
      exact hre.symm
    · change Real.sqrt 3 / 2 +
        (z.im - Real.sqrt 3 / 2) = z.im
      ring

/-- Every exact modular edge is precisely the range of its declared explicit
parameter, not merely a set containing that range. -/
theorem modularTileEdgeParam_range (e : GammaTwoModularTileEdge) :
    Set.range (modularTileEdgeParam e) = modularTileEdgeSet e := by
  cases e with
  | circularArc => exact modularCircularArcParam_range
  | leftVerticalSegment => exact modularLeftVerticalParam_range
  | rightVerticalSegment => exact modularRightVerticalParam_range

/-- Subtype-valued version of the exact modular edge parametrization. -/
noncomputable def modularTileEdgeParamToEdge (e : GammaTwoModularTileEdge) :
    modularTileEdgeParameterSet e → modularTileEdgeSet e :=
  fun t ↦ ⟨modularTileEdgeParam e t, modularTileEdgeParam_mem e t⟩

/-- The subtype-valued exact modular edge parametrization is surjective. -/
theorem modularTileEdgeParamToEdge_surjective
    (e : GammaTwoModularTileEdge) :
    Function.Surjective (modularTileEdgeParamToEdge e) := by
  intro z
  have hz : (z : ℍ) ∈ Set.range (modularTileEdgeParam e) := by
    rw [modularTileEdgeParam_range e]
    exact z.property
  rcases hz with ⟨t, ht⟩
  refine ⟨t, ?_⟩
  apply Subtype.ext
  exact ht

/-- The full-modular `S/T` side pairing sends each explicit base parameter to
the explicit parameter on the paired modular edge. -/
theorem modularTileEdgePairing_param
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e) :
    e.pairingMatrix • modularTileEdgeParam e t =
      modularTileEdgeParam e.paired (e.pairedParameter t) := by
  cases e with
  | circularArc =>
      have hprod :
          0 ≤ (1 - (t : ℝ)) * ((t : ℝ) + 1) := by
        apply mul_nonneg (sub_nonneg.mpr t.property.2)
        linarith [t.property.1]
      have hs : 0 ≤ 1 - ((t : ℝ) / 2) ^ 2 := by
        nlinarith
      have hsqrt := Real.sq_sqrt hs
      have hnormSq :
          Complex.normSq (modularCircularArcParam t : ℂ) = 1 := by
        simp only [modularCircularArcParam, UpperHalfPlane.coe_mk,
          Complex.normSq_apply]
        nlinarith [hsqrt]
      have hden :
          (t : ℝ) / 2 * ((t : ℝ) / 2) +
              Real.sqrt (1 - ((t : ℝ) / 2) ^ 2) *
                Real.sqrt (1 - ((t : ℝ) / 2) ^ 2) = 1 := by
        nlinarith [hsqrt]
      simp only [GammaTwoModularTileEdge.pairingMatrix,
        GammaTwoModularTileEdge.paired,
        GammaTwoModularTileEdge.pairedParameter, modularTileEdgeParam]
      rw [UpperHalfPlane.modular_S_smul, UpperHalfPlane.ext_iff]
      apply Complex.ext
      · simp [GammaTwoModularTileEdge.pairingMatrix,
          GammaTwoModularTileEdge.paired,
          GammaTwoModularTileEdge.pairedParameter,
          modularTileEdgeParam, modularCircularArcParam, hnormSq, hden]
        ring
      · simp [GammaTwoModularTileEdge.pairingMatrix,
          GammaTwoModularTileEdge.paired,
          GammaTwoModularTileEdge.pairedParameter,
          modularTileEdgeParam, modularCircularArcParam, hnormSq, hden]
        congr 1
        ring
  | leftVerticalSegment =>
      change ModularGroup.T • modularLeftVerticalParam t =
        modularRightVerticalParam t
      rw [UpperHalfPlane.modular_T_smul, UpperHalfPlane.ext_iff]
      apply Complex.ext <;>
        norm_num [modularLeftVerticalParam, modularRightVerticalParam,
          UpperHalfPlane.coe_vadd]
  | rightVerticalSegment =>
      change (ModularGroup.T ^ (-1 : ℤ)) • modularRightVerticalParam t =
        modularLeftVerticalParam t
      rw [UpperHalfPlane.modular_T_zpow_smul, UpperHalfPlane.ext_iff]
      apply Complex.ext <;>
        norm_num [modularLeftVerticalParam, modularRightVerticalParam,
          UpperHalfPlane.coe_vadd]

/-- Transport the explicit modular parametrization to an edge of the actual
selected fundamental tile complex. -/
noncomputable def gammaTwoActualPolygonEdgeParam
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) : ℍ :=
  gammaTwoCosetRep e.1 • modularTileEdgeParam e.2 t

theorem gammaTwoActualPolygonEdgeParam_mem
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    gammaTwoActualPolygonEdgeParam e t ∈
      gammaTwoActualPolygonEdgeSet e := by
  exact Set.mem_smul_set.mpr
    ⟨modularTileEdgeParam e.2 t, modularTileEdgeParam_mem e.2 t, rfl⟩

/-- Transport by a selected coset representative preserves exactness of the
edge parametrization: its range is the whole actual polygon edge. -/
theorem gammaTwoActualPolygonEdgeParam_range
    (e : GammaTwoActualPolygonEdge) :
    Set.range (gammaTwoActualPolygonEdgeParam e) =
      gammaTwoActualPolygonEdgeSet e := by
  apply Set.Subset.antisymm
  · rintro z ⟨t, rfl⟩
    exact gammaTwoActualPolygonEdgeParam_mem e t
  · intro z hz
    rcases Set.mem_smul_set.mp hz with ⟨w, hw, hEq⟩
    rw [← modularTileEdgeParam_range e.2] at hw
    rcases hw with ⟨t, rfl⟩
    exact ⟨t, hEq⟩

/-- Subtype-valued parametrization of one edge in the actual selected polygon
complex. -/
noncomputable def gammaTwoActualPolygonEdgeParamToEdge
    (e : GammaTwoActualPolygonEdge) :
    modularTileEdgeParameterSet e.2 → gammaTwoActualPolygonEdgeSet e :=
  fun t ↦ ⟨gammaTwoActualPolygonEdgeParam e t,
    gammaTwoActualPolygonEdgeParam_mem e t⟩

/-- Every point of an actual selected polygon edge has an explicit real
parameter. -/
theorem gammaTwoActualPolygonEdgeParamToEdge_surjective
    (e : GammaTwoActualPolygonEdge) :
    Function.Surjective (gammaTwoActualPolygonEdgeParamToEdge e) := by
  intro z
  have hz : (z : ℍ) ∈ Set.range (gammaTwoActualPolygonEdgeParam e) := by
    rw [gammaTwoActualPolygonEdgeParam_range e]
    exact z.property
  rcases hz with ⟨t, ht⟩
  refine ⟨t, ?_⟩
  apply Subtype.ext
  exact ht

/-- The selected right coset reached after crossing an actual polygon edge.
The inverse of the base pairing matrix is placed on the right because our
fundamental carrier is indexed by right cosets. -/
noncomputable def GammaTwoActualPolygonEdge.paired
    (e : GammaTwoActualPolygonEdge) : GammaTwoActualPolygonEdge :=
  ((Quotient.mk''
      (gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹) :
        GammaTwoRightCoset), e.2.paired)

@[simp]
theorem GammaTwoActualPolygonEdge.paired_second
    (e : GammaTwoActualPolygonEdge) :
    e.paired.2 = e.2.paired := rfl

/-- The `Gamma(2)` factor in the canonical right-coset decomposition used to
transport a base modular pairing to the selected actual carrier. -/
noncomputable def GammaTwoActualPolygonEdge.decompositionElement
    (e : GammaTwoActualPolygonEdge) : GammaTwo :=
  Classical.choose
    (gammaTwo_decompose_right
      (gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹))

theorem GammaTwoActualPolygonEdge.decompositionElement_spec
    (e : GammaTwoActualPolygonEdge) :
    gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹ =
      (e.decompositionElement : SL(2, ℤ)) *
        gammaTwoCosetRep e.paired.1 := by
  simpa [GammaTwoActualPolygonEdge.decompositionElement,
    GammaTwoActualPolygonEdge.paired] using
      (Classical.choose_spec
        (gammaTwo_decompose_right
          (gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹)))

/-- Actual side-pairing element in `Gamma(2)`.  It is the inverse of the
decomposition factor, hence acts from the source selected tile to the target
selected tile. -/
noncomputable def GammaTwoActualPolygonEdge.pairingElement
    (e : GammaTwoActualPolygonEdge) : GammaTwo :=
  e.decompositionElement⁻¹

/-- Matrix identity expressing the actual side pairing on selected coset
representatives. -/
theorem GammaTwoActualPolygonEdge.pairingElement_mul_cosetRep
    (e : GammaTwoActualPolygonEdge) :
    (e.pairingElement : SL(2, ℤ)) * gammaTwoCosetRep e.1 =
      gammaTwoCosetRep e.paired.1 * e.2.pairingMatrix := by
  change (e.decompositionElement : SL(2, ℤ))⁻¹ *
      gammaTwoCosetRep e.1 =
    gammaTwoCosetRep e.paired.1 * e.2.pairingMatrix
  calc
    (e.decompositionElement : SL(2, ℤ))⁻¹ *
        gammaTwoCosetRep e.1 =
      (e.decompositionElement : SL(2, ℤ))⁻¹ *
        ((gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹) *
          e.2.pairingMatrix) := by simp [mul_assoc]
    _ = (e.decompositionElement : SL(2, ℤ))⁻¹ *
        (((e.decompositionElement : SL(2, ℤ)) *
          gammaTwoCosetRep e.paired.1) * e.2.pairingMatrix) := by
      rw [e.decompositionElement_spec]
    _ = gammaTwoCosetRep e.paired.1 * e.2.pairingMatrix := by
      simp [mul_assoc]

/-- Parameter on the actual paired edge; its type records the target side. -/
def GammaTwoActualPolygonEdge.pairedParameter
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    modularTileEdgeParameterSet e.paired.2 :=
  e.2.pairedParameter t

/-- Actual transported pairing preserves the declared finite vertex set. -/
theorem GammaTwoActualPolygonEdge.pairedParameter_mem_endpoints
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2)
    (ht : (t : ℝ) ∈ modularTileEdgeEndpoints e.2) :
    (e.pairedParameter t : ℝ) ∈
      modularTileEdgeEndpoints e.paired.2 := by
  exact e.2.pairedParameter_mem_endpoints t ht

/-- Orientation reversal for the actual transported edge pairing. -/
theorem GammaTwoActualPolygonEdge.pairing_reverses_orientation
    (e : GammaTwoActualPolygonEdge) :
    e.paired.orientationSign * e.2.parameterSign =
      -e.orientationSign := by
  exact e.2.pairing_reverses_orientation

/-- The actual `Gamma(2)` pairing element sends every explicit source-edge
parameter exactly to the paired explicit target-edge parameter. -/
theorem gammaTwoActualPolygonEdgePairing_param
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    (e.pairingElement : SL(2, ℤ)) •
        gammaTwoActualPolygonEdgeParam e t =
      gammaTwoActualPolygonEdgeParam e.paired
        (e.pairedParameter t) := by
  unfold gammaTwoActualPolygonEdgeParam
  calc
    (e.pairingElement : SL(2, ℤ)) •
        (gammaTwoCosetRep e.1 • modularTileEdgeParam e.2 t) =
      ((e.pairingElement : SL(2, ℤ)) * gammaTwoCosetRep e.1) •
        modularTileEdgeParam e.2 t := by
          rw [mul_smul]
    _ = (gammaTwoCosetRep e.paired.1 * e.2.pairingMatrix) •
        modularTileEdgeParam e.2 t := by
          rw [e.pairingElement_mul_cosetRep]
    _ = gammaTwoCosetRep e.paired.1 •
        (e.2.pairingMatrix • modularTileEdgeParam e.2 t) := by
          rw [mul_smul]
    _ = gammaTwoCosetRep e.paired.1 •
        modularTileEdgeParam e.2.paired
          (e.2.pairedParameter t) := by
          rw [modularTileEdgePairing_param]
    _ = gammaTwoCosetRep e.paired.1 •
        modularTileEdgeParam e.paired.2
          (e.pairedParameter t) := rfl

/-- The actual `Gamma(2)` pairing maps the entire source edge onto the entire
paired target edge.  This is the set-level form of the pointwise parameter
identity, with surjectivity supplied by the exact inverse parameters above. -/
theorem gammaTwoActualPolygonEdgePairing_set
    (e : GammaTwoActualPolygonEdge) :
    (e.pairingElement : SL(2, ℤ)) • gammaTwoActualPolygonEdgeSet e =
      gammaTwoActualPolygonEdgeSet e.paired := by
  apply Set.Subset.antisymm
  · intro z hz
    rcases Set.mem_smul_set.mp hz with ⟨w, hw, rfl⟩
    rw [← gammaTwoActualPolygonEdgeParam_range e] at hw
    rcases hw with ⟨t, rfl⟩
    rw [gammaTwoActualPolygonEdgePairing_param]
    exact gammaTwoActualPolygonEdgeParam_mem _ _
  · intro z hz
    rw [← gammaTwoActualPolygonEdgeParam_range e.paired] at hz
    rcases hz with ⟨u, rfl⟩
    rcases e.2.pairedParameter_surjective u with ⟨t, ht⟩
    have ht' : e.pairedParameter t = u := ht
    rw [← ht', ← gammaTwoActualPolygonEdgePairing_param]
    exact Set.mem_smul_set.mpr
      ⟨gammaTwoActualPolygonEdgeParam e t,
        gammaTwoActualPolygonEdgeParam_mem e t, rfl⟩

theorem gammaTwoActualPolygonEdgeSet_kind
    (e : GammaTwoActualPolygonEdge) :
    e.2.kind = .circularArc ∨ e.2.kind = .verticalSegment := by
  cases e.2 <;> simp [GammaTwoModularTileEdge.kind]

/-- Every frontier point of the actual half-open fundamental carrier lies on
one of its finitely indexed tile edges. -/
theorem gammaTwoHalfOpenTileCarrier_frontier_subset_actualEdges :
    frontier gammaTwoHalfOpenTileCarrier ⊆
      ⋃ e : GammaTwoActualPolygonEdge,
        gammaTwoActualPolygonEdgeSet e := by
  intro z hz
  have hzOpen :=
    gammaTwoHalfOpenTileCarrier_frontier_subset_openCarrier_frontier hz
  change z ∈ closure gammaTwoOpenCarrier ∧
    z ∉ interior gammaTwoOpenCarrier at hzOpen
  have hzClosed : z ∈ gammaTwoClosedTileCarrier := by
    rw [gammaTwoClosedTileCarrier_eq_closure_openCarrier]
    exact hzOpen.1
  have hzNotOpen : z ∉ gammaTwoOpenCarrier := by
    rw [gammaTwoOpenCarrier_isOpen.interior_eq] at hzOpen
    exact hzOpen.2
  rcases mem_gammaTwoClosedTileCarrier_iff.mp hzClosed with
    ⟨q, w, hwfd, hEq⟩
  have hwNotOpen : w ∉ ModularGroup.fdo := by
    intro hw
    exact hzNotOpen (mem_gammaTwoOpenCarrier_iff.mpr ⟨q, w, hw, hEq⟩)
  have hwBoundary : w ∈ modularBoundary := ⟨hwfd, hwNotOpen⟩
  rcases Set.mem_iUnion.mp
      (modularBoundary_subset_iUnion_modularTileEdgeSet hwBoundary) with
    ⟨e, hwe⟩
  exact Set.mem_iUnion.2 ⟨(q, e),
    Set.mem_smul_set.mpr ⟨w, hwe, hEq⟩⟩

/-- A finite-tile, finite-edge presentation attached to a genuine measured
fundamental domain.  This structure prevents an illustrative polygon picture
from being silently substituted for the carrier used by quotient integration.
-/
structure GammaTwoExplicitFundamentalPolygon where
  carrier : Set ℍ
  tile : GammaTwoRightCoset → Set ℍ
  edge : GammaTwoActualPolygonEdge → Set ℍ
  edgeParam : ∀ e : GammaTwoActualPolygonEdge,
    modularTileEdgeParameterSet e.2 → ℍ
  edgeOrientation : GammaTwoActualPolygonEdge → ℤ
  edgeEndpoints : GammaTwoActualPolygonEdge → Finset ℝ
  edgePairingElement : GammaTwoActualPolygonEdge → GammaTwo
  carrier_eq_tiles : carrier = ⋃ q, tile q
  tile_formula : ∀ q, tile q = gammaTwoCosetRep q • modularHalfOpenTile
  edge_formula : ∀ e, edge e = gammaTwoActualPolygonEdgeSet e
  edgeParam_formula : ∀ e t,
    edgeParam e t = gammaTwoActualPolygonEdgeParam e t
  edgeOrientation_formula : ∀ e,
    edgeOrientation e = e.orientationSign
  edgeEndpoints_formula : ∀ e,
    edgeEndpoints e = modularTileEdgeEndpoints e.2
  edgePairingElement_formula : ∀ e,
    edgePairingElement e = e.pairingElement
  edgeParam_mem : ∀ e t, edgeParam e t ∈ edge e
  edgeEndpoints_mem : ∀ e,
    (↑(edgeEndpoints e) : Set ℝ) ⊆ modularTileEdgeParameterSet e.2
  edgePairing_maps_endpoints : ∀ (e : GammaTwoActualPolygonEdge)
      (t : modularTileEdgeParameterSet e.2),
    (t : ℝ) ∈ edgeEndpoints e →
      (e.pairedParameter t : ℝ) ∈ edgeEndpoints e.paired
  edgePairing_param : ∀ (e : GammaTwoActualPolygonEdge)
      (t : modularTileEdgeParameterSet e.2),
    (edgePairingElement e : SL(2, ℤ)) • edgeParam e t =
      edgeParam e.paired (e.pairedParameter t)
  edgePairing_reverses_orientation : ∀ e,
    edgeOrientation e.paired * e.2.parameterSign =
      -edgeOrientation e
  carrier_measurable : MeasurableSet carrier
  isFundamental :
    IsFundamentalDomain GammaTwoEffective carrier hyperbolicMeasure
  frontier_subset_edges : frontier carrier ⊆ ⋃ e, edge e

/-- The actual half-open carrier, together with its finite selected-tile and
finite edge data. -/
noncomputable def chosenGammaTwoExplicitFundamentalPolygon :
    GammaTwoExplicitFundamentalPolygon where
  carrier := gammaTwoHalfOpenTileCarrier
  tile q := gammaTwoCosetRep q • modularHalfOpenTile
  edge e := gammaTwoActualPolygonEdgeSet e
  edgeParam e t := gammaTwoActualPolygonEdgeParam e t
  edgeOrientation e := e.orientationSign
  edgeEndpoints e := modularTileEdgeEndpoints e.2
  edgePairingElement e := e.pairingElement
  carrier_eq_tiles := rfl
  tile_formula _ := rfl
  edge_formula _ := rfl
  edgeParam_formula _ _ := rfl
  edgeOrientation_formula _ := rfl
  edgeEndpoints_formula _ := rfl
  edgePairingElement_formula _ := rfl
  edgeParam_mem := gammaTwoActualPolygonEdgeParam_mem
  edgeEndpoints_mem := fun e ↦
    modularTileEdgeEndpoints_subset_parameterSet e.2
  edgePairing_maps_endpoints := fun e t ht ↦
    e.pairedParameter_mem_endpoints t ht
  edgePairing_param := gammaTwoActualPolygonEdgePairing_param
  edgePairing_reverses_orientation := fun e ↦
    e.pairing_reverses_orientation
  carrier_measurable := gammaTwoHalfOpenTileCarrier_measurable
  isFundamental := gammaTwoHalfOpenTileCarrier_isFundamental
  frontier_subset_edges :=
    gammaTwoHalfOpenTileCarrier_frontier_subset_actualEdges

@[simp]
theorem chosenGammaTwoExplicitFundamentalPolygon_carrier :
    chosenGammaTwoExplicitFundamentalPolygon.carrier =
      gammaTwoHalfOpenTileCarrier := rfl

theorem chosenGammaTwoExplicitFundamentalPolygon_isFundamental :
    IsFundamentalDomain GammaTwoEffective
      chosenGammaTwoExplicitFundamentalPolygon.carrier
      hyperbolicMeasure :=
  chosenGammaTwoExplicitFundamentalPolygon.isFundamental

/-- A certified fundamental domain whose carrier is the actual half-open
six-tile complex. -/
noncomputable def chosenGammaTwoHalfOpenFundamentalDomain :
    GammaTwoFundamentalDomain where
  carrier := gammaTwoHalfOpenTileCarrier
  carrier_measurable := gammaTwoHalfOpenTileCarrier_measurable
  isFundamental := gammaTwoHalfOpenTileCarrier_isFundamental
  topologicalBoundary_null := gammaTwoHalfOpenTileCarrier_frontier_null

/-- The full modular boundary orbit is invariant under every integral
modular transformation. -/
theorem modularBoundaryOrbit_smul (g : SL(2, ℤ)) :
    g • modularBoundaryOrbit = modularBoundaryOrbit := by
  apply Set.Subset.antisymm
  · intro z hz
    rcases Set.mem_smul_set.mp hz with ⟨y, hy, rfl⟩
    rcases Set.mem_iUnion.mp hy with ⟨h, hh⟩
    rcases Set.mem_smul_set.mp hh with ⟨w, hw, rfl⟩
    unfold modularBoundaryOrbit
    exact Set.mem_iUnion.2 ⟨g * h,
      Set.mem_smul_set.mpr ⟨w, hw, by simp [mul_smul]⟩⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨h, hh⟩
    rcases Set.mem_smul_set.mp hh with ⟨w, hw, rfl⟩
    rw [Set.mem_smul_set]
    refine ⟨(g⁻¹ * h) • w, ?_, by simp [mul_smul]⟩
    unfold modularBoundaryOrbit
    exact Set.mem_iUnion.2 ⟨g⁻¹ * h,
      Set.mem_smul_set.mpr ⟨w, hw, rfl⟩⟩

theorem modularBoundaryOrbit_smul_mem_iff
    (g : SL(2, ℤ)) (z : ℍ) :
    g • z ∈ modularBoundaryOrbit ↔ z ∈ modularBoundaryOrbit := by
  calc
    g • z ∈ modularBoundaryOrbit ↔
        g • z ∈ g • modularBoundaryOrbit := by rw [modularBoundaryOrbit_smul g]
    _ ↔ z ∈ modularBoundaryOrbit := by
      rw [Set.mem_smul_set_iff_inv_smul_mem]
      simp

theorem modularBoundaryOrbit_effective_smul_mem_iff
    (a : GammaTwoEffective) (z : ℍ) :
    a • z ∈ modularBoundaryOrbit ↔ z ∈ modularBoundaryOrbit := by
  rcases effective_exists_gamma a with ⟨γ, hγ⟩
  rw [hγ z]
  exact modularBoundaryOrbit_smul_mem_iff (γ : SL(2, ℤ)) z

/-- Every point added when passing from the open six-tile carrier to the
closed carrier lies in the explicit full modular boundary orbit. -/
theorem gammaTwoClosedTileCarrier_diff_openCarrier_subset_modularBoundaryOrbit :
    gammaTwoClosedTileCarrier \ gammaTwoOpenCarrier ⊆
      modularBoundaryOrbit := by
  intro z hz
  rcases mem_gammaTwoClosedTileCarrier_iff.mp hz.1 with
    ⟨q, w, hwfd, hEq⟩
  have hwNot : w ∉ ModularGroup.fdo := by
    intro hw
    exact hz.2 (mem_gammaTwoOpenCarrier_iff.mpr
      ⟨q, w, hw, hEq⟩)
  have hwBoundary : w ∈ modularBoundary := ⟨hwfd, hwNot⟩
  unfold modularBoundaryOrbit
  exact Set.mem_iUnion.2 ⟨gammaTwoCosetRep q,
    Set.mem_smul_set.mpr ⟨w, hwBoundary, hEq⟩⟩

/-- Away from the null boundary orbit, membership in the verified half-open
carrier is exactly membership in the open carrier. -/
theorem mem_gammaTwoOpenCarrier_of_mem_halfOpen_of_not_boundaryOrbit
    {z : ℍ} (hz : z ∉ modularBoundaryOrbit)
    (hHalf : z ∈ gammaTwoHalfOpenTileCarrier) :
    z ∈ gammaTwoOpenCarrier := by
  by_contra hOpen
  exact hz
    (gammaTwoClosedTileCarrier_diff_openCarrier_subset_modularBoundaryOrbit
      ⟨gammaTwoHalfOpenTileCarrier_subset_closedTileCarrier hHalf, hOpen⟩)

/-- Every generic effective orbit has exactly one translating element whose
image lies in the actual half-open six-tile carrier. -/
theorem gammaTwoHalfOpenTileCarrier_unique_translate_of_not_boundaryOrbit
    {z : ℍ} (hz : z ∉ modularBoundaryOrbit) :
    ∃! a : GammaTwoEffective,
      a • z ∈ gammaTwoHalfOpenTileCarrier := by
  obtain ⟨a, haOpen, haUnique⟩ :=
    gammaTwoOpenCarrier_unique_translate_of_not_mem_modularBoundaryOrbit hz
  refine ⟨a, gammaTwoOpenCarrier_subset_halfOpenTileCarrier haOpen, ?_⟩
  intro b hbHalf
  apply haUnique b
  apply mem_gammaTwoOpenCarrier_of_mem_halfOpen_of_not_boundaryOrbit
  · intro hbBoundary
    exact hz ((modularBoundaryOrbit_effective_smul_mem_iff b z).mp
      hbBoundary)
  · exact hbHalf

/-- Invariant integrals over the chosen closed carrier and over the actual
half-open six-tile carrier agree exactly. -/
theorem integral_chosenCarrier_eq_halfOpenTileCarrier
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℍ → E)
    (hf : ∀ g : GammaTwoEffective, ∀ z, f (g • z) = f z) :
    ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        f z ∂hyperbolicMeasure =
      ∫ z in gammaTwoHalfOpenTileCarrier,
        f z ∂hyperbolicMeasure := by
  simpa [chosenGammaTwoHalfOpenFundamentalDomain] using
    chosenGammaTwoFundamentalDomain.isFundamental.setIntegral_eq
      chosenGammaTwoHalfOpenFundamentalDomain.isFundamental hf

/-- Quotient integration is therefore literally integration over the
verified half-open polygonal carrier. -/
theorem integral_chosenQuotientMeasure_eq_halfOpenTileCarrier
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ρ : ℍ → E)
    (hρ : ∀ g : GammaTwoEffective, ∀ z, ρ (g • z) = ρ z)
    (hm : AEStronglyMeasurable (descendInvariant ρ hρ)
      chosenGammaTwoFundamentalDomain.quotientMeasure) :
    ∫ q, descendInvariant ρ hρ q
        ∂chosenGammaTwoFundamentalDomain.quotientMeasure =
      ∫ z in gammaTwoHalfOpenTileCarrier,
        ρ z ∂hyperbolicMeasure := by
  calc
    ∫ q, descendInvariant ρ hρ q
        ∂chosenGammaTwoFundamentalDomain.quotientMeasure =
      ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        ρ z ∂hyperbolicMeasure :=
          chosenGammaTwoFundamentalDomain.integral_descendInvariant_eq
            ρ hρ hm
    _ = ∫ z in gammaTwoHalfOpenTileCarrier,
        ρ z ∂hyperbolicMeasure :=
          integral_chosenCarrier_eq_halfOpenTileCarrier ρ hρ

/-- Every point, including a modular-boundary point, can be moved by an
effective `Gamma(2)` transformation into the closed tile carrier. -/
theorem gammaTwoClosedTileCarrier_orbit_covers (z : ℍ) :
    ∃ a : GammaTwoEffective, a • z ∈ gammaTwoClosedTileCarrier := by
  rcases ModularGroup.exists_smul_mem_fd z with ⟨g, hgfd⟩
  rcases gammaTwo_decompose_right g⁻¹ with ⟨γ, hdecomp⟩
  let q : GammaTwoRightCoset := Quotient.mk'' g⁻¹
  have hdecomp' :
      g⁻¹ = (γ : SL(2, ℤ)) * gammaTwoCosetRep q := by
    simpa [q] using hdecomp
  refine ⟨gammaTwoEffectiveElement γ⁻¹, ?_⟩
  have hcancel :
      ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) • z =
        gammaTwoCosetRep q • (g • z) := by
    have hg :
        g = (gammaTwoCosetRep q)⁻¹ *
          ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) := by
      have h := congrArg Inv.inv hdecomp'
      simpa [mul_inv_rev] using h
    have hγ :
        ((γ⁻¹ : GammaTwo) : SL(2, ℤ)) =
          gammaTwoCosetRep q * g := by
      rw [hg]
      simp [mul_assoc]
    rw [hγ, mul_smul]
  have htile :
      gammaTwoCosetRep q • (g • z) ∈ gammaTwoClosedTileCarrier :=
    mem_gammaTwoClosedTileCarrier_iff.mpr
      ⟨q, g • z, hgfd, rfl⟩
  simpa only [gammaTwoEffectiveElement_smul] using
    hcancel.symm ▸ htile

/-- Normalize arbitrary real height parameters so that the geometric stages
are monotone on all of `ℝ`; for the paper range `1 ≤ Y` this is exactly `Y`. -/
def gammaTwoCuspLevel (Y : ℝ) : ℝ :=
  max 1 Y

theorem one_le_gammaTwoCuspLevel (Y : ℝ) :
    1 ≤ gammaTwoCuspLevel Y :=
  le_max_left _ _

theorem gammaTwoCuspLevel_mono : Monotone gammaTwoCuspLevel := by
  intro Y Z hYZ
  exact max_le_max le_rfl hYZ

@[simp]
theorem gammaTwoCuspLevel_of_one_le {Y : ℝ} (hY : 1 ≤ Y) :
    gammaTwoCuspLevel Y = Y :=
  max_eq_right hY

/-! ##### The three named scaling charts

The three fixed scaling matrices provide canonical local coordinates, but a
single chart at the cusp class of `1` does not see the duplicate polygon end
at `-1`.  Consequently the following named-chart intersection is useful for
local statements but is deliberately *not* called the global `F_Y`.
-/

/-- Simultaneous sublevel set for the three explicit cusp heights. -/
def gammaTwoNamedScalingHeightSublevel (Y : ℝ) : Set ℍ :=
  {z : ℍ | ∀ κ : GammaTwoCusp,
    gammaTwoCuspHeight κ z ≤ gammaTwoCuspLevel Y}

theorem mem_gammaTwoNamedScalingHeightSublevel_iff
    {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoNamedScalingHeightSublevel Y ↔
      ∀ κ : GammaTwoCusp,
        gammaTwoCuspHeight κ z ≤ gammaTwoCuspLevel Y :=
  Iff.rfl

theorem gammaTwoNamedScalingHeightSublevel_isClosed (Y : ℝ) :
    IsClosed (gammaTwoNamedScalingHeightSublevel Y) := by
  unfold gammaTwoNamedScalingHeightSublevel
  rw [show {z : ℍ | ∀ κ : GammaTwoCusp,
      gammaTwoCuspHeight κ z ≤ gammaTwoCuspLevel Y} =
      ⋂ κ : GammaTwoCusp,
        {z : ℍ | gammaTwoCuspHeight κ z ≤ gammaTwoCuspLevel Y} by
    ext z
    simp]
  exact isClosed_iInter fun κ ↦
    isClosed_le (gammaTwoCuspHeight_continuous κ) continuous_const

theorem gammaTwoClosedTileCarrier_isClosed :
    IsClosed gammaTwoClosedTileCarrier := by
  classical
  unfold gammaTwoClosedTileCarrier
  exact isClosed_iUnion_of_finite fun q ↦ by
    let g : SL(2, ℤ) := gammaTwoCosetRep q
    have hset :
        g • ModularGroup.fd =
          (fun z : ℍ => g⁻¹ • z) ⁻¹' ModularGroup.fd := by
      ext z
      constructor
      · intro hz
        rcases Set.mem_smul_set.mp hz with ⟨w, hw, rfl⟩
        simpa using hw
      · intro hz
        exact Set.mem_smul_set.mpr ⟨g⁻¹ • z, hz, by simp⟩
    rw [hset]
    exact ModularGroup.isClosed_fd.preimage
      (HalfIntegralMultiplier.continuous_sl2z_smul g⁻¹)

/-- The local three-chart intersection.  The duplicate-end-safe global
truncation is defined below after the tile cusp classes are available. -/
def gammaTwoNamedScalingTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoClosedTileCarrier ∩ gammaTwoNamedScalingHeightSublevel Y

theorem mem_gammaTwoNamedScalingTruncation_iff {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoNamedScalingTruncation Y ↔
      z ∈ gammaTwoClosedTileCarrier ∧
        ∀ κ : GammaTwoCusp,
          gammaTwoCuspHeight κ z ≤ gammaTwoCuspLevel Y :=
  Iff.rfl

theorem gammaTwoNamedScalingTruncation_isClosed (Y : ℝ) :
    IsClosed (gammaTwoNamedScalingTruncation Y) :=
  gammaTwoClosedTileCarrier_isClosed.inter
    (gammaTwoNamedScalingHeightSublevel_isClosed Y)

theorem gammaTwoNamedScalingTruncation_measurable (Y : ℝ) :
    MeasurableSet (gammaTwoNamedScalingTruncation Y) :=
  (gammaTwoNamedScalingTruncation_isClosed Y).measurableSet

theorem gammaTwoNamedScalingTruncation_monotone :
    Monotone gammaTwoNamedScalingTruncation := by
  intro Y Z hYZ z hz
  exact ⟨hz.1, fun κ ↦
    (hz.2 κ).trans (gammaTwoCuspLevel_mono hYZ)⟩

/-- The height in the modular coordinate of the selected closed tile. -/
noncomputable def gammaTwoTileHeight
    (q : GammaTwoRightCoset) (z : ℍ) : ℝ :=
  ((gammaTwoCosetRep q)⁻¹ • z).im

theorem gammaTwoTileHeight_pos (q : GammaTwoRightCoset) (z : ℍ) :
    0 < gammaTwoTileHeight q z :=
  UpperHalfPlane.im_pos _

theorem gammaTwoTileHeight_continuous (q : GammaTwoRightCoset) :
    Continuous (gammaTwoTileHeight q) :=
  UpperHalfPlane.continuous_im.comp
    (HalfIntegralMultiplier.continuous_sl2z_smul (gammaTwoCosetRep q)⁻¹)

/-- Cusp class of the ideal point `gammaTwoCosetRep q • ∞`.  For the primitive
first column `(a,c)`, its reduction modulo two is respectively `(1,0)`,
`(0,1)`, or `(1,1)`, giving the three branches below. -/
noncomputable def gammaTwoTileCuspClass
    (q : GammaTwoRightCoset) : GammaTwoCusp :=
  if ((gammaTwoCosetRep q 1 0 : ℤ) : ZMod 2) = 0 then
    .atInfinity
  else if ((gammaTwoCosetRep q 0 0 : ℤ) : ZMod 2) = 0 then
    .zero
  else
    .one

/-- Duplicate-end-safe height for one cusp class.  It sums the positive local
heights of every selected tile whose ideal end has that class.  A finite sum
is used instead of a maximum because it gives the same sublevel properness and
has a direct continuity proof. -/
noncomputable def gammaTwoCarrierCuspHeight
    (κ : GammaTwoCusp) (z : ℍ) : ℝ := by
  classical
  exact Finset.sum
    (Finset.univ.filter (fun q : GammaTwoRightCoset ↦
      gammaTwoTileCuspClass q = κ))
    (fun q => gammaTwoTileHeight q z)

theorem gammaTwoCarrierCuspHeight_continuous (κ : GammaTwoCusp) :
    Continuous (gammaTwoCarrierCuspHeight κ) := by
  classical
  unfold gammaTwoCarrierCuspHeight
  exact continuous_finset_sum _ fun q _ ↦
    gammaTwoTileHeight_continuous q

/-- Every individual tile height is bounded by the grouped height of its cusp
class, so duplicate ideal ends cannot escape the truncation. -/
theorem gammaTwoTileHeight_le_carrierCuspHeight
    (q : GammaTwoRightCoset) (z : ℍ) :
    gammaTwoTileHeight q z ≤
      gammaTwoCarrierCuspHeight (gammaTwoTileCuspClass q) z := by
  classical
  unfold gammaTwoCarrierCuspHeight
  exact Finset.single_le_sum
    (fun r _ ↦ (gammaTwoTileHeight_pos r z).le)
    (Finset.mem_filter.mpr ⟨Finset.mem_univ q, rfl⟩)

/-- Simultaneous sublevel of the three duplicate-end-safe cusp classes.  Each
class condition quantifies over every selected local chart in that class; this
is the finite maximum formulation without choosing a default value for an
empty maximum. -/
def gammaTwoThreeCuspHeightSublevel (Y : ℝ) : Set ℍ :=
  {z : ℍ | ∀ κ : GammaTwoCusp, ∀ q : GammaTwoRightCoset,
    gammaTwoTileCuspClass q = κ →
      gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y}

theorem mem_gammaTwoThreeCuspHeightSublevel_iff
    {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoThreeCuspHeightSublevel Y ↔
      ∀ κ : GammaTwoCusp, ∀ q : GammaTwoRightCoset,
        gammaTwoTileCuspClass q = κ →
          gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y :=
  Iff.rfl

theorem gammaTwoThreeCuspHeightSublevel_isClosed (Y : ℝ) :
    IsClosed (gammaTwoThreeCuspHeightSublevel Y) := by
  rw [show gammaTwoThreeCuspHeightSublevel Y =
      ⋂ κ : GammaTwoCusp, ⋂ q : GammaTwoRightCoset,
        {z : ℍ | gammaTwoTileCuspClass q = κ →
          gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y} by
    ext z
    simp [gammaTwoThreeCuspHeightSublevel]]
  apply isClosed_iInter
  intro κ
  apply isClosed_iInter
  intro q
  by_cases hq : gammaTwoTileCuspClass q = κ
  · simpa [hq] using
      (isClosed_le (gammaTwoTileHeight_continuous q) continuous_const)
  · simp [hq]

/-- Strict simultaneous tile-height inequalities.  This auxiliary open set
is the interior witness used to identify the geometric boundary of `F_Y`. -/
def gammaTwoThreeCuspStrictHeightSublevel (Y : ℝ) : Set ℍ :=
  {z : ℍ | ∀ q : GammaTwoRightCoset,
    gammaTwoTileHeight q z < gammaTwoCuspLevel Y}

theorem gammaTwoThreeCuspStrictHeightSublevel_isOpen (Y : ℝ) :
    IsOpen (gammaTwoThreeCuspStrictHeightSublevel Y) := by
  rw [show gammaTwoThreeCuspStrictHeightSublevel Y =
      ⋂ q : GammaTwoRightCoset,
        {z : ℍ | gammaTwoTileHeight q z < gammaTwoCuspLevel Y} by
    ext z
    simp [gammaTwoThreeCuspStrictHeightSublevel]]
  exact isOpen_iInter_of_finite fun q ↦
    isOpen_lt (gammaTwoTileHeight_continuous q) continuous_const

theorem gammaTwoThreeCuspStrictHeightSublevel_subset (Y : ℝ) :
    gammaTwoThreeCuspStrictHeightSublevel Y ⊆
      gammaTwoThreeCuspHeightSublevel Y := by
  intro z hz κ q _hq
  exact (hz q).le

/-- The genuine three-cusp `F_Y` on the selected closed carrier.  All tile
ends are first grouped into their mod-two cusp class, so the paired endpoints
`1` and `-1` are both cut in the class `one`. -/
def gammaTwoThreeCuspTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoClosedTileCarrier ∩ gammaTwoThreeCuspHeightSublevel Y

theorem mem_gammaTwoThreeCuspTruncation_iff {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoThreeCuspTruncation Y ↔
      z ∈ gammaTwoClosedTileCarrier ∧
        ∀ κ : GammaTwoCusp, ∀ q : GammaTwoRightCoset,
          gammaTwoTileCuspClass q = κ →
            gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y :=
  Iff.rfl

theorem gammaTwoThreeCuspTruncation_isClosed (Y : ℝ) :
    IsClosed (gammaTwoThreeCuspTruncation Y) :=
  gammaTwoClosedTileCarrier_isClosed.inter
    (gammaTwoThreeCuspHeightSublevel_isClosed Y)

theorem gammaTwoThreeCuspTruncation_measurable (Y : ℝ) :
    MeasurableSet (gammaTwoThreeCuspTruncation Y) :=
  (gammaTwoThreeCuspTruncation_isClosed Y).measurableSet

theorem gammaTwoThreeCuspTruncation_monotone :
    Monotone gammaTwoThreeCuspTruncation := by
  intro Y Z hYZ z hz
  exact ⟨hz.1, fun κ q hq ↦
    (hz.2 κ q hq).trans (gammaTwoCuspLevel_mono hYZ)⟩

/-- The literal truncation is a subset of the chosen closed fundamental
carrier.  This field was unavailable when the chosen carrier was open. -/
theorem gammaTwoThreeCuspTruncation_subset_chosenCarrier (Y : ℝ) :
    gammaTwoThreeCuspTruncation Y ⊆
      chosenGammaTwoFundamentalDomain.carrier := by
  intro z hz
  rw [← gammaTwoClosedTileCarrier_eq_chosenCarrier]
  exact hz.1

/-- The chosen closed polygon as a subtype. -/
abbrev GammaTwoChosenPolygon : Type :=
  chosenGammaTwoFundamentalDomain.carrier

/-- Literal `F_Y` viewed inside the polygon subtype. -/
def gammaTwoRelativeTruncation (Y : ℝ) : Set GammaTwoChosenPolygon :=
  Subtype.val ⁻¹' gammaTwoThreeCuspTruncation Y

/-- Strict height inequalities viewed inside the polygon subtype. -/
def gammaTwoRelativeStrictHeightSublevel
    (Y : ℝ) : Set GammaTwoChosenPolygon :=
  Subtype.val ⁻¹' gammaTwoThreeCuspStrictHeightSublevel Y

theorem gammaTwoRelativeStrictHeightSublevel_isOpen (Y : ℝ) :
    IsOpen (gammaTwoRelativeStrictHeightSublevel Y) :=
  (gammaTwoThreeCuspStrictHeightSublevel_isOpen Y).preimage
    continuous_subtype_val

theorem gammaTwoRelativeStrictHeightSublevel_subset_truncation (Y : ℝ) :
    gammaTwoRelativeStrictHeightSublevel Y ⊆
      gammaTwoRelativeTruncation Y := by
  intro z hz
  exact ⟨by
    rw [gammaTwoClosedTileCarrier_eq_chosenCarrier]
    exact z.property,
    gammaTwoThreeCuspStrictHeightSublevel_subset Y hz⟩

/-- Strict tile-height control puts a polygon point in the *relative*
interior of `F_Y`.  This deliberately makes no false full-`ℍ` interior claim
at a paired side. -/
theorem gammaTwoRelativeStrictHeightSublevel_subset_interior (Y : ℝ) :
    gammaTwoRelativeStrictHeightSublevel Y ⊆
      interior (gammaTwoRelativeTruncation Y) :=
  interior_maximal
    (gammaTwoRelativeStrictHeightSublevel_subset_truncation Y)
    (gammaTwoRelativeStrictHeightSublevel_isOpen Y)

/-- Exact tail decomposition inside the selected closed carrier: leaving the
three-cusp truncation is equivalent to exceeding the height cutoff in at
least one selected local tile coordinate. -/
theorem mem_closedTileCarrier_diff_threeCuspTruncation_iff
    {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoClosedTileCarrier \ gammaTwoThreeCuspTruncation Y ↔
      z ∈ gammaTwoClosedTileCarrier ∧
        ∃ q : GammaTwoRightCoset,
          gammaTwoCuspLevel Y < gammaTwoTileHeight q z := by
  constructor
  · intro hz
    refine ⟨hz.1, ?_⟩
    by_contra hNo
    apply hz.2
    refine ⟨hz.1, fun _κ q _hq ↦ ?_⟩
    exact le_of_not_gt (fun hgt ↦ hNo ⟨q, hgt⟩)
  · rintro ⟨hzCarrier, q, hq⟩
    refine ⟨hzCarrier, ?_⟩
    intro hzF
    exact (not_lt_of_ge
      (hzF.2 (gammaTwoTileCuspClass q) q rfl)) hq

theorem mem_closedTileCarrier_diff_threeCuspTruncation_iff_localCoordinate
    {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoClosedTileCarrier \ gammaTwoThreeCuspTruncation Y ↔
      z ∈ gammaTwoClosedTileCarrier ∧
        ∃ q : GammaTwoRightCoset,
          gammaTwoCuspLevel Y < ((gammaTwoCosetRep q)⁻¹ • z).im := by
  simpa only [gammaTwoTileHeight] using
    (mem_closedTileCarrier_diff_threeCuspTruncation_iff (Y := Y) (z := z))

/-- A compact finite-tile cusp truncation.  This uses Mathlib's closed modular
fundamental domain truncated in every selected tile coordinate.  It is a
strong geometric model, but it is deliberately kept distinct from the literal
three-height intersection `gammaTwoThreeCuspTruncation`. -/
noncomputable def gammaTwoGeometricTruncation (Y : ℝ) : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q •
      ModularGroup.truncatedFundamentalDomain (gammaTwoCuspLevel Y)

theorem mem_gammaTwoGeometricTruncation_iff {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoGeometricTruncation Y ↔
      ∃ q : GammaTwoRightCoset, ∃ w : ℍ,
        w ∈ ModularGroup.fd ∧ w.im ≤ gammaTwoCuspLevel Y ∧
          gammaTwoCosetRep q • w = z := by
  unfold gammaTwoGeometricTruncation
  constructor
  · intro hz
    rcases Set.mem_iUnion.mp hz with ⟨q, hzq⟩
    rcases Set.mem_smul_set.mp hzq with ⟨w, hw, hEq⟩
    exact ⟨q, w, hw.1, hw.2, hEq⟩
  · rintro ⟨q, w, hwfd, hwY, hEq⟩
    exact Set.mem_iUnion.2
      ⟨q, Set.mem_smul_set.2
        ⟨w, ⟨hwfd, hwY⟩, hEq⟩⟩

/-- Equivalent tilewise formulation using the pulled-back height. -/
theorem mem_gammaTwoGeometricTruncation_iff_tileHeight
    {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoGeometricTruncation Y ↔
      ∃ q : GammaTwoRightCoset,
        z ∈ gammaTwoCosetRep q • ModularGroup.fd ∧
          gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y := by
  constructor
  · intro hz
    rcases mem_gammaTwoGeometricTruncation_iff.mp hz with
      ⟨q, w, hwfd, hwY, rfl⟩
    refine ⟨q, Set.mem_smul_set.mpr ⟨w, hwfd, rfl⟩, ?_⟩
    simpa [gammaTwoTileHeight] using hwY
  · rintro ⟨q, hzfd, hzY⟩
    rcases Set.mem_smul_set.mp hzfd with ⟨w, hwfd, rfl⟩
    refine mem_gammaTwoGeometricTruncation_iff.mpr
      ⟨q, w, hwfd, ?_, rfl⟩
    simpa [gammaTwoTileHeight] using hzY

/-- Every geometric truncation is compact, not merely relatively compact. -/
theorem gammaTwoGeometricTruncation_isCompact (Y : ℝ) :
    IsCompact (gammaTwoGeometricTruncation Y) := by
  classical
  unfold gammaTwoGeometricTruncation
  exact isCompact_iUnion fun q ↦ by
    change IsCompact
      ((fun z : ℍ => gammaTwoCosetRep q • z) ''
        ModularGroup.truncatedFundamentalDomain (gammaTwoCuspLevel Y))
    exact
      (ModularGroup.isCompact_truncatedFundamentalDomain
        (gammaTwoCuspLevel Y)).image
          (HalfIntegralMultiplier.continuous_sl2z_smul (gammaTwoCosetRep q))

theorem gammaTwoGeometricTruncation_measurable (Y : ℝ) :
    MeasurableSet (gammaTwoGeometricTruncation Y) :=
  (gammaTwoGeometricTruncation_isCompact Y).isClosed.measurableSet

theorem gammaTwoGeometricTruncation_relativelyCompact (Y : ℝ) :
    IsCompact (closure (gammaTwoGeometricTruncation Y)) := by
  rw [(gammaTwoGeometricTruncation_isCompact Y).isClosed.closure_eq]
  exact gammaTwoGeometricTruncation_isCompact Y

theorem gammaTwoGeometricTruncation_monotone :
    Monotone gammaTwoGeometricTruncation := by
  intro Y Z hYZ z hz
  rcases mem_gammaTwoGeometricTruncation_iff.mp hz with
    ⟨q, w, hwfd, hwY, rfl⟩
  exact mem_gammaTwoGeometricTruncation_iff.mpr
    ⟨q, w, hwfd,
      hwY.trans (gammaTwoCuspLevel_mono hYZ), rfl⟩

/-- The literal three-cusp stage lies in the compact finite-tile stage at the
same height.  A point of the closed carrier belongs to at least one selected
tile, and the defining three-cusp condition controls the height in that tile
as one of its finitely many local charts. -/
theorem gammaTwoThreeCuspTruncation_subset_geometricTruncation (Y : ℝ) :
    gammaTwoThreeCuspTruncation Y ⊆ gammaTwoGeometricTruncation Y := by
  intro z hz
  rcases mem_gammaTwoClosedTileCarrier_iff.mp hz.1 with
    ⟨q, w, hwfd, hEq⟩
  refine mem_gammaTwoGeometricTruncation_iff_tileHeight.mpr
    ⟨q, Set.mem_smul_set.mpr ⟨w, hwfd, hEq⟩, ?_⟩
  exact hz.2 (gammaTwoTileCuspClass q) q rfl

/-- Hence the genuine three-cusp truncation is compact.  This proof uses the
closedness of all three height conditions and containment in the compact
finite union of truncated modular tiles. -/
theorem gammaTwoThreeCuspTruncation_isCompact (Y : ℝ) :
    IsCompact (gammaTwoThreeCuspTruncation Y) :=
  (gammaTwoGeometricTruncation_isCompact Y).of_isClosed_subset
    (gammaTwoThreeCuspTruncation_isClosed Y)
    (gammaTwoThreeCuspTruncation_subset_geometricTruncation Y)

theorem gammaTwoThreeCuspTruncation_relativelyCompact (Y : ℝ) :
    IsCompact (closure (gammaTwoThreeCuspTruncation Y)) := by
  rw [(gammaTwoThreeCuspTruncation_isCompact Y).isClosed.closure_eq]
  exact gammaTwoThreeCuspTruncation_isCompact Y

/-- Every compact finite-tile stage is contained in the closed six-tile
carrier. -/
theorem gammaTwoGeometricTruncation_subset_closedTileCarrier (Y : ℝ) :
    gammaTwoGeometricTruncation Y ⊆ gammaTwoClosedTileCarrier := by
  intro z hz
  rcases mem_gammaTwoGeometricTruncation_iff.mp hz with
    ⟨q, w, hwfd, _hwY, hEq⟩
  exact mem_gammaTwoClosedTileCarrier_iff.mpr
    ⟨q, w, hwfd, hEq⟩

/-! ##### Uniform reduction height on compact lifts

The key properness estimate is arithmetic and does not treat the noncompact
closed carrier as if it were compact.  For an integral matrix, either its
lower-left entry is zero, or its absolute value is at least one.  The standard
imaginary-part formula then bounds every modular translate by
`max y (1 / y)`. -/

/-- A continuous pointwise envelope for the height of every integral modular
translate. -/
noncomputable def gammaTwoModularHeightEnvelope (z : ℍ) : ℝ :=
  max z.im (1 / z.im)

theorem gammaTwoModularHeightEnvelope_continuous :
    Continuous gammaTwoModularHeightEnvelope := by
  unfold gammaTwoModularHeightEnvelope
  exact UpperHalfPlane.continuous_im.max
    (Continuous.div₀ continuous_const UpperHalfPlane.continuous_im
      fun z ↦ z.im_ne_zero)

/-- Every integral modular translate has height bounded solely in terms of
the original height. -/
theorem modular_im_smul_le_heightEnvelope
    (g : SL(2, ℤ)) (z : ℍ) :
    (g • z).im ≤ gammaTwoModularHeightEnvelope z := by
  rw [ModularGroup.im_smul_eq_div_normSq,
    ModularGroup.denom_apply]
  by_cases hg : g 1 0 = 0
  · have hd : g 1 1 ≠ 0 := fun hg' ↦ zero_ne_one <| by
      simpa only [Matrix.det_fin_two, hg, hg', mul_zero, sub_zero] using
        g.det_coe
    have hdSq : (1 : ℝ) ≤ g 1 1 ^ 2 :=
      mod_cast (one_le_sq_iff_one_le_abs _).mpr (Int.one_le_abs hd)
    refine le_trans ?_ (le_max_left _ _)
    rw [show Complex.normSq
        ((g 1 0) * z + (g 1 1)) = (g 1 1) ^ 2 by
      simp [hg, sq]]
    simpa [field] using inv_le_one_of_one_le₀ hdSq
  · have hcSq : (1 : ℝ) ≤ g 1 0 ^ 2 :=
      mod_cast (one_le_sq_iff_one_le_abs _).mpr (Int.one_le_abs hg)
    refine le_trans ?_ (le_max_right _ _)
    rw [show 1 / z.im = z.im / z.im ^ 2 by field_simp]
    gcongr
    rw [show Complex.normSq
        ((g 1 0) * z + (g 1 1)) =
          ((g 1 0) * z.re + (g 1 1)) ^ 2 +
            (g 1 0) ^ 2 * z.im ^ 2 by
      simp [Complex.normSq_apply]
      ring]
    nlinarith

/-- On a compact upstairs set, the heights of *all* integral modular
translates admit one strict bound.  The extra unit in the chosen level is
what later yields relative-interior rather than merely closed capture. -/
theorem compact_uniform_modularHeight
    {L : Set ℍ} (hL : IsCompact L) :
    ∃ Y : ℝ, 1 < Y ∧
      ∀ z ∈ L, ∀ g : SL(2, ℤ), (g • z).im < Y := by
  classical
  rcases L.eq_empty_or_nonempty with hEmpty | hNonempty
  · subst L
    exact ⟨2, by norm_num, by simp⟩
  · obtain ⟨u, huL, huMax⟩ :=
      hL.exists_isMaxOn hNonempty
        gammaTwoModularHeightEnvelope_continuous.continuousOn
    let Y : ℝ := max 2 (gammaTwoModularHeightEnvelope u + 1)
    have hY : 1 < Y :=
      lt_of_lt_of_le (by norm_num) (le_max_left _ _)
    refine ⟨Y, hY, fun z hzL g ↦ ?_⟩
    calc
      (g • z).im ≤ gammaTwoModularHeightEnvelope z :=
        modular_im_smul_le_heightEnvelope g z
      _ ≤ gammaTwoModularHeightEnvelope u :=
        isMaxOn_iff.mp huMax z hzL
      _ < gammaTwoModularHeightEnvelope u + 1 := by linarith
      _ ≤ Y := le_max_right _ _

/-- A continuous finite sum dominating the height in every selected tile. -/
noncomputable def gammaTwoTotalTileHeight (z : ℍ) : ℝ :=
  ∑ q : GammaTwoRightCoset, gammaTwoTileHeight q z

theorem gammaTwoTotalTileHeight_continuous :
    Continuous gammaTwoTotalTileHeight := by
  unfold gammaTwoTotalTileHeight
  exact continuous_finset_sum Finset.univ fun q _ ↦
    gammaTwoTileHeight_continuous q

theorem gammaTwoTileHeight_le_total
    (q : GammaTwoRightCoset) (z : ℍ) :
    gammaTwoTileHeight q z ≤ gammaTwoTotalTileHeight z := by
  unfold gammaTwoTotalTileHeight
  exact Finset.single_le_sum
    (fun r _ ↦ (gammaTwoTileHeight_pos r z).le)
    (Finset.mem_univ q)

/-- Every compact set upstairs has one simultaneous bound for all selected
local cusp heights.  No carrier or quotient-selection hypothesis is needed
for this purely analytic compactness statement. -/
theorem compact_subset_threeCuspHeightSublevel
    {L : Set ℍ} (hL : IsCompact L) :
    ∃ Y : ℝ, 1 < Y ∧ L ⊆ gammaTwoThreeCuspHeightSublevel Y := by
  classical
  rcases L.eq_empty_or_nonempty with hEmpty | hNonempty
  · subst L
    exact ⟨2, by norm_num, Set.empty_subset _⟩
  · obtain ⟨u, huL, huMax⟩ :=
      hL.exists_isMaxOn hNonempty
        gammaTwoTotalTileHeight_continuous.continuousOn
    let Y : ℝ := max 2 (gammaTwoTotalTileHeight u)
    have hY : 1 < Y :=
      lt_of_lt_of_le (by norm_num) (le_max_left _ _)
    have hlevel : gammaTwoCuspLevel Y = Y :=
      gammaTwoCuspLevel_of_one_le hY.le
    refine ⟨Y, hY, fun z hzL _κ q _hq ↦ ?_⟩
    rw [hlevel]
    exact (gammaTwoTileHeight_le_total q z).trans
      ((isMaxOn_iff.mp huMax z hzL).trans (le_max_right _ _))

/-- A compact subset already represented in the closed tile carrier is
contained in one genuine three-cusp height stage.  The finite sum of positive
tile heights supplies one continuous dominating function, so a compact set
has one height bound valid simultaneously in every cusp chart, including all
charts in the cusp class of `1`. -/
theorem compact_closedTileCarrier_subset_threeCuspTruncation
    {L : Set ℍ} (hL : IsCompact L)
    (hLC : L ⊆ gammaTwoClosedTileCarrier) :
    ∃ Y : ℝ, 1 < Y ∧ L ⊆ gammaTwoThreeCuspTruncation Y := by
  obtain ⟨Y, hY, hLY⟩ := compact_subset_threeCuspHeightSublevel hL
  exact ⟨Y, hY, fun z hzL ↦ ⟨hLC hzL, hLY hzL⟩⟩

/-- Every compact subset of the chosen polygon is captured in the relative
interior of a strictly larger literal cusp truncation.  The one-unit height
margin is what turns all finitely many weak inequalities into strict ones.
-/
theorem compact_subset_relativeInterior_threeCuspTruncation
    {L : Set GammaTwoChosenPolygon} (hL : IsCompact L) :
    ∃ Y : ℝ, 1 < Y ∧
      L ⊆ interior (gammaTwoRelativeTruncation Y) := by
  have hImage : IsCompact (Subtype.val '' L : Set ℍ) :=
    hL.image continuous_subtype_val
  obtain ⟨B, hB, hLB⟩ :=
    compact_subset_threeCuspHeightSublevel hImage
  let Y : ℝ := B + 1
  have hY : 1 < Y := by
    dsimp [Y]
    linarith
  have hlevelB : gammaTwoCuspLevel B = B :=
    gammaTwoCuspLevel_of_one_le hB.le
  have hlevelY : gammaTwoCuspLevel Y = Y :=
    gammaTwoCuspLevel_of_one_le hY.le
  refine ⟨Y, hY, fun z hzL ↦
    gammaTwoRelativeStrictHeightSublevel_subset_interior Y ?_⟩
  change ∀ q : GammaTwoRightCoset,
    gammaTwoTileHeight q z < gammaTwoCuspLevel Y
  intro q
  have hq := hLB ⟨z, hzL, rfl⟩
    (gammaTwoTileCuspClass q) q rfl
  rw [hlevelB] at hq
  rw [hlevelY]
  dsimp [Y]
  linarith

/-- The preceding simultaneous-height bound also recovers the weaker compact
finite-tile capture statement. -/
theorem compact_closedTileCarrier_subset_geometricTruncation
    {L : Set ℍ} (hL : IsCompact L)
    (hLC : L ⊆ gammaTwoClosedTileCarrier) :
    ∃ Y : ℝ, 1 < Y ∧ L ⊆ gammaTwoGeometricTruncation Y := by
  obtain ⟨Y, hY, hLY⟩ :=
    compact_closedTileCarrier_subset_threeCuspTruncation hL hLC
  exact ⟨Y, hY,
    hLY.trans (gammaTwoThreeCuspTruncation_subset_geometricTruncation Y)⟩

/-- The finite-tile stages exhaust every orbit pointwise.  This statement is
strictly geometric and does not use the topological compact exhaustion. -/
theorem gammaTwoGeometricTruncation_orbit_exhausts (z : ℍ) :
    ∃ Y : ℝ, 1 < Y ∧ ∃ w : ℍ,
      w ∈ gammaTwoGeometricTruncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  rcases gammaTwoClosedTileCarrier_orbit_covers z with ⟨a, ha⟩
  rcases mem_gammaTwoClosedTileCarrier_iff.mp ha with
    ⟨q, w, hwfd, hEq⟩
  let Y : ℝ := w.im + 2
  have hY : 1 < Y := by
    dsimp [Y]
    linarith [w.im_pos]
  have hlevel : gammaTwoCuspLevel Y = Y :=
    gammaTwoCuspLevel_of_one_le hY.le
  refine ⟨Y, hY, a • z, ?_, gammaTwoQuotientMk_smul a z⟩
  rw [← hEq]
  exact mem_gammaTwoGeometricTruncation_iff.mpr
    ⟨q, w, hwfd, by simp [hlevel, Y], rfl⟩

/-- The duplicate-end-safe three-cusp stages themselves exhaust every orbit
pointwise. -/
theorem gammaTwoThreeCuspTruncation_orbit_exhausts (z : ℍ) :
    ∃ Y : ℝ, 1 < Y ∧ ∃ w : ℍ,
      w ∈ gammaTwoThreeCuspTruncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  rcases gammaTwoClosedTileCarrier_orbit_covers z with ⟨a, ha⟩
  let Y : ℝ := max 2 (gammaTwoTotalTileHeight (a • z))
  have hY : 1 < Y :=
    lt_of_lt_of_le (by norm_num) (le_max_left _ _)
  have hlevel : gammaTwoCuspLevel Y = Y :=
    gammaTwoCuspLevel_of_one_le hY.le
  refine ⟨Y, hY, a • z, ⟨ha, ?_⟩,
    gammaTwoQuotientMk_smul a z⟩
  intro _κ q _hq
  rw [hlevel]
  exact (gammaTwoTileHeight_le_total q (a • z)).trans
    (le_max_right _ _)

/-! ##### Boundary measure and corner separation -/

/-- A horizontal real-affine line in `ℂ` has zero planar measure. -/
theorem complex_horizontalLine_null (b : ℝ) :
    (volume : Measure ℂ) {z : ℂ | z.im = b} = 0 := by
  rw [← (Complex.volume_preserving_equiv_real_prod.symm).measure_preimage]
  · simp only [Set.preimage_setOf_eq,
      Complex.measurableEquivRealProd_symm_apply]
    rw [show {p : ℝ × ℝ | p.2 = b} =
        (Set.univ : Set ℝ) ×ˢ ({b} : Set ℝ) by
      ext p
      simp]
    rw [Measure.volume_eq_prod, Measure.prod_prod]
    simp
  · exact
      ((measurableSet_singleton b).preimage
        Complex.measurable_im).nullMeasurableSet

/-- A horizontal line in the upper half-plane is hyperbolic-null. -/
theorem hyperbolicHorizontalLine_null (b : ℝ) :
    hyperbolicMeasure {z : ℍ | z.im = b} = 0 := by
  apply hyperbolicMeasure_eq_zero_of_coe_image_eq_zero
  exact measure_mono_null (by
    rintro z ⟨w, hw, rfl⟩
    exact hw) (complex_horizontalLine_null b)

/-- A horocycle in any explicit cusp coordinate. -/
def gammaTwoCuspHorocycle (κ : GammaTwoCusp) (Y : ℝ) : Set ℍ :=
  {z : ℍ | gammaTwoCuspHeight κ z = Y}

theorem gammaTwoCuspHorocycle_eq_smul
    (κ : GammaTwoCusp) (Y : ℝ) :
    gammaTwoCuspHorocycle κ Y =
      gammaTwoCuspScaling κ • {z : ℍ | z.im = Y} := by
  ext z
  simp [gammaTwoCuspHorocycle, gammaTwoCuspHeight,
    Set.mem_smul_set_iff_inv_smul_mem]

theorem gammaTwoCuspHorocycle_null
    (κ : GammaTwoCusp) (Y : ℝ) :
    hyperbolicMeasure (gammaTwoCuspHorocycle κ Y) = 0 := by
  rw [gammaTwoCuspHorocycle_eq_smul,
    hyperbolicMeasure_fullModular_smul]
  exact hyperbolicHorizontalLine_null Y

/-- Union of the three fixed-scaling horocycles.  This is the boundary object
for the local named-scaling model, not for the duplicate-end-safe global
truncation. -/
def gammaTwoNamedScalingHorocycleBoundary (Y : ℝ) : Set ℍ :=
  ⋃ κ : GammaTwoCusp,
    gammaTwoCuspHorocycle κ (gammaTwoCuspLevel Y)

theorem gammaTwoNamedScalingHorocycleBoundary_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoNamedScalingHorocycleBoundary Y) = 0 := by
  unfold gammaTwoNamedScalingHorocycleBoundary
  apply measure_iUnion_null
  intro κ
  exact gammaTwoCuspHorocycle_null κ (gammaTwoCuspLevel Y)

/-- The paired-side boundary of all selected closed tiles. -/
noncomputable def gammaTwoPairedSideBoundary : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q • frontier ModularGroup.fd

/-- The height boundary of all selected truncated tiles. -/
noncomputable def gammaTwoHorocycleBoundary (Y : ℝ) : Set ℍ :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoCosetRep q •
      {z : ℍ | z ∈ ModularGroup.fd ∧ z.im = gammaTwoCuspLevel Y}

/-- Side/horocycle intersections are the corner locus. -/
noncomputable def gammaTwoTruncationCorners (Y : ℝ) : Set ℍ :=
  gammaTwoPairedSideBoundary ∩ gammaTwoHorocycleBoundary Y

theorem modularFundamentalFrontier_eq_boundary :
    frontier ModularGroup.fd = modularBoundary := by
  unfold modularBoundary
  rw [frontier, ModularGroup.isClosed_fd.closure_eq,
    ← ModularGroup.fdo_eq_interior_fd]

theorem modularFundamentalFrontier_null :
    hyperbolicMeasure (frontier ModularGroup.fd) = 0 := by
  rw [modularFundamentalFrontier_eq_boundary]
  exact modularBoundary_null

theorem gammaTwoPairedSideBoundary_null :
    hyperbolicMeasure gammaTwoPairedSideBoundary = 0 := by
  unfold gammaTwoPairedSideBoundary
  apply measure_iUnion_null
  intro q
  rw [hyperbolicMeasure_fullModular_smul]
  exact modularFundamentalFrontier_null

theorem gammaTwoHorocycleBoundary_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoHorocycleBoundary Y) = 0 := by
  unfold gammaTwoHorocycleBoundary
  apply measure_iUnion_null
  intro q
  rw [hyperbolicMeasure_fullModular_smul]
  exact measure_mono_null (by
    intro z hz
    exact hz.2) (hyperbolicHorizontalLine_null (gammaTwoCuspLevel Y))

/-- Horocycle hypersurfaces in all selected local charts belonging to one
of the three mod-two cusp classes.  Unlike the finite-tile boundary above,
these surfaces are not restricted to points lying in the corresponding
closed tile: this is exactly what the simultaneous height inequalities in
`gammaTwoThreeCuspTruncation` require. -/
noncomputable def gammaTwoCuspClassHorocycleBoundary
    (κ : GammaTwoCusp) (Y : ℝ) : Set ℍ :=
  ⋃ q : {q : GammaTwoRightCoset // gammaTwoTileCuspClass q = κ},
    gammaTwoCosetRep q.1 •
      {z : ℍ | z.im = gammaTwoCuspLevel Y}

theorem gammaTwoCuspClassHorocycleBoundary_null
    (κ : GammaTwoCusp) (Y : ℝ) :
    hyperbolicMeasure (gammaTwoCuspClassHorocycleBoundary κ Y) = 0 := by
  unfold gammaTwoCuspClassHorocycleBoundary
  apply measure_iUnion_null
  intro q
  rw [hyperbolicMeasure_fullModular_smul]
  exact hyperbolicHorizontalLine_null (gammaTwoCuspLevel Y)

/-- The complete horocycle boundary for the genuine three-cusp truncation.
The outer union records the three quotient cusps and the inner union retains
every selected local end, so in particular the cusp class of `1` does not
discard its paired `-1` end. -/
noncomputable def gammaTwoThreeCuspHorocycleBoundary (Y : ℝ) : Set ℍ :=
  ⋃ κ : GammaTwoCusp, gammaTwoCuspClassHorocycleBoundary κ Y

theorem gammaTwoThreeCuspHorocycleBoundary_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoThreeCuspHorocycleBoundary Y) = 0 := by
  unfold gammaTwoThreeCuspHorocycleBoundary
  apply measure_iUnion_null
  intro κ
  exact gammaTwoCuspClassHorocycleBoundary_null κ Y

/-- The topological frontier of the genuine `F_Y` consists only of selected
tile sides and the simultaneous-height horocycles.  The proof uses finiteness
of the tile set: away from every height equality all inequalities are strict,
and away from the selected side frontier a carrier point lies in the interior
of one of its closed tiles. -/
theorem gammaTwoThreeCuspTruncation_frontier_subset (Y : ℝ) :
    frontier (gammaTwoThreeCuspTruncation Y) ⊆
      gammaTwoPairedSideBoundary ∪
        gammaTwoThreeCuspHorocycleBoundary Y := by
  intro z hzFrontier
  have hzF : z ∈ gammaTwoThreeCuspTruncation Y := by
    have hzClosure := frontier_subset_closure hzFrontier
    simpa only [(gammaTwoThreeCuspTruncation_isClosed Y).closure_eq] using
      hzClosure
  by_cases hzSide : z ∈ gammaTwoPairedSideBoundary
  · exact Or.inl hzSide
  by_cases hzHoro : z ∈ gammaTwoThreeCuspHorocycleBoundary Y
  · exact Or.inr hzHoro
  exfalso
  have hzStrict : z ∈ gammaTwoThreeCuspStrictHeightSublevel Y := by
    intro q
    have hle := hzF.2 (gammaTwoTileCuspClass q) q rfl
    have hne : gammaTwoTileHeight q z ≠ gammaTwoCuspLevel Y := by
      intro heq
      apply hzHoro
      unfold gammaTwoThreeCuspHorocycleBoundary
      refine Set.mem_iUnion.2
        ⟨gammaTwoTileCuspClass q, ?_⟩
      unfold gammaTwoCuspClassHorocycleBoundary
      let q' :
          {r : GammaTwoRightCoset //
            gammaTwoTileCuspClass r = gammaTwoTileCuspClass q} :=
        ⟨q, rfl⟩
      refine Set.mem_iUnion.2 ⟨q', ?_⟩
      refine Set.mem_smul_set.mpr
        ⟨(gammaTwoCosetRep q)⁻¹ • z, ?_, by simp [q']⟩
      simpa [gammaTwoTileHeight] using heq
    exact lt_of_le_of_ne hle hne
  rcases mem_gammaTwoClosedTileCarrier_iff.mp hzF.1 with
    ⟨q, w, hwfd, hEq⟩
  have hwNotFrontier : w ∉ frontier ModularGroup.fd := by
    intro hwFrontier
    apply hzSide
    unfold gammaTwoPairedSideBoundary
    exact Set.mem_iUnion.2
      ⟨q, Set.mem_smul_set.mpr ⟨w, hwFrontier, hEq⟩⟩
  have hwInterior : w ∈ interior ModularGroup.fd := by
    by_contra hwNotInterior
    apply hwNotFrontier
    rw [ModularGroup.isClosed_fd.frontier_eq]
    exact ⟨hwfd, hwNotInterior⟩
  have hzTileInterior :
      z ∈ interior (gammaTwoCosetRep q • ModularGroup.fd) := by
    let e : ℍ ≃ₜ ℍ :=
      { toEquiv :=
          { toFun := fun u => gammaTwoCosetRep q • u
            invFun := fun u => (gammaTwoCosetRep q)⁻¹ • u
            left_inv := by intro u; simp
            right_inv := by intro u; simp }
        continuous_toFun :=
          HalfIntegralMultiplier.continuous_sl2z_smul (gammaTwoCosetRep q)
        continuous_invFun :=
          HalfIntegralMultiplier.continuous_sl2z_smul (gammaTwoCosetRep q)⁻¹ }
    change z ∈ interior (e '' ModularGroup.fd)
    rw [← e.image_interior]
    exact ⟨w, hwInterior, hEq⟩
  have hzCarrierInterior : z ∈ interior gammaTwoClosedTileCarrier :=
    interior_mono (fun x hx ↦ by
      unfold gammaTwoClosedTileCarrier
      exact Set.mem_iUnion.2 ⟨q, hx⟩) hzTileInterior
  have hzHeightInterior :
      z ∈ interior (gammaTwoThreeCuspHeightSublevel Y) := by
    apply mem_interior_iff_mem_nhds.mpr
    exact Filter.mem_of_superset
      ((gammaTwoThreeCuspStrictHeightSublevel_isOpen Y).mem_nhds hzStrict)
      (gammaTwoThreeCuspStrictHeightSublevel_subset Y)
  have hzInterior : z ∈ interior (gammaTwoThreeCuspTruncation Y) := by
    rw [gammaTwoThreeCuspTruncation, interior_inter]
    exact ⟨hzCarrierInterior, hzHeightInterior⟩
  exact ((mem_frontier_iff_notMem_interior hzF).mp hzFrontier) hzInterior

/-! ##### A finite typed decomposition of the literal truncation boundary -/

/-- Finite labels for all geometric boundary-piece kinds of the literal
three-height truncation.  The first three constructors are the exact modular
tile edges; the last records a selected local height equation. -/
inductive GammaTwoTruncationBoundaryPiece
  | circularArc (q : GammaTwoRightCoset)
  | leftVerticalSegment (q : GammaTwoRightCoset)
  | rightVerticalSegment (q : GammaTwoRightCoset)
  | horocycleSegment (q : GammaTwoRightCoset)

noncomputable instance gammaTwoTruncationBoundaryPieceDecidableEq :
    DecidableEq GammaTwoTruncationBoundaryPiece :=
  Classical.decEq _

noncomputable instance gammaTwoTruncationBoundaryPieceFinite :
    Finite GammaTwoTruncationBoundaryPiece := by
  let encode : GammaTwoTruncationBoundaryPiece →
      Fin 4 × GammaTwoRightCoset
    | .circularArc q => (0, q)
    | .leftVerticalSegment q => (1, q)
    | .rightVerticalSegment q => (2, q)
    | .horocycleSegment q => (3, q)
  exact Finite.of_injective encode (by
    intro a b hab
    cases a <;> cases b <;> simp_all [encode])

noncomputable instance gammaTwoTruncationBoundaryPieceFintype :
    Fintype GammaTwoTruncationBoundaryPiece :=
  Fintype.ofFinite _

/-- Coarse geometric kind of a typed truncation boundary piece. -/
def GammaTwoTruncationBoundaryPiece.kind :
    GammaTwoTruncationBoundaryPiece → GammaTwoBoundaryPieceKind
  | .circularArc _ => .circularArc
  | .leftVerticalSegment _ => .verticalSegment
  | .rightVerticalSegment _ => .verticalSegment
  | .horocycleSegment _ => .horocycleSegment

/-- The set carried by a typed truncation boundary label.  Horocycle pieces
are cut back to the chosen closed carrier; side pieces are already restricted
to the exact modular boundary before translation. -/
noncomputable def gammaTwoTruncationBoundaryPieceSet
    (Y : ℝ) : GammaTwoTruncationBoundaryPiece → Set ℍ
  | .circularArc q =>
      gammaTwoCosetRep q • modularTileEdgeSet .circularArc
  | .leftVerticalSegment q =>
      gammaTwoCosetRep q • modularTileEdgeSet .leftVerticalSegment
  | .rightVerticalSegment q =>
      gammaTwoCosetRep q • modularTileEdgeSet .rightVerticalSegment
  | .horocycleSegment q =>
      gammaTwoClosedTileCarrier ∩
        gammaTwoCosetRep q •
          {z : ℍ | z.im = gammaTwoCuspLevel Y}

/-- The boundary-piece label type is genuinely finite. -/
theorem gammaTwoTruncationBoundaryPiece_univ_finite :
    (Set.univ : Set GammaTwoTruncationBoundaryPiece).Finite :=
  Set.toFinite _

/-- Every frontier point of the literal three-cusp truncation is carried by
one of the finitely many typed circular, vertical, or horocycle pieces. -/
theorem gammaTwoThreeCuspTruncation_frontier_subset_finitePieces
    (Y : ℝ) :
    frontier (gammaTwoThreeCuspTruncation Y) ⊆
      ⋃ p : GammaTwoTruncationBoundaryPiece,
        gammaTwoTruncationBoundaryPieceSet Y p := by
  intro z hz
  have hzF : z ∈ gammaTwoThreeCuspTruncation Y := by
    have hzClosure := frontier_subset_closure hz
    simpa only [(gammaTwoThreeCuspTruncation_isClosed Y).closure_eq] using
      hzClosure
  rcases gammaTwoThreeCuspTruncation_frontier_subset Y hz with
    hzSide | hzHoro
  · unfold gammaTwoPairedSideBoundary at hzSide
    rcases Set.mem_iUnion.mp hzSide with ⟨q, hzq⟩
    rcases Set.mem_smul_set.mp hzq with ⟨w, hw, hEq⟩
    rw [modularFundamentalFrontier_eq_boundary] at hw
    rcases Set.mem_iUnion.mp
        (modularBoundary_subset_iUnion_modularTileEdgeSet hw) with
      ⟨e, hwe⟩
    cases e with
    | circularArc =>
        exact Set.mem_iUnion.2 ⟨.circularArc q,
          Set.mem_smul_set.mpr ⟨w, hwe, hEq⟩⟩
    | leftVerticalSegment =>
        exact Set.mem_iUnion.2 ⟨.leftVerticalSegment q,
          Set.mem_smul_set.mpr ⟨w, hwe, hEq⟩⟩
    | rightVerticalSegment =>
        exact Set.mem_iUnion.2 ⟨.rightVerticalSegment q,
          Set.mem_smul_set.mpr ⟨w, hwe, hEq⟩⟩
  · unfold gammaTwoThreeCuspHorocycleBoundary at hzHoro
    rcases Set.mem_iUnion.mp hzHoro with ⟨κ, hzκ⟩
    unfold gammaTwoCuspClassHorocycleBoundary at hzκ
    rcases Set.mem_iUnion.mp hzκ with ⟨q, hzq⟩
    exact Set.mem_iUnion.2 ⟨.horocycleSegment q.1, ⟨hzF.1, hzq⟩⟩

/-! ##### Endpoint deletion on one-dimensional boundary parameters

Planar or hyperbolic nullity alone says nothing about a boundary integral.
The next result instead works on the real parameter axis.  It is a Bochner
set-integral identity and therefore applies equally to scalar, complex, and
vector-valued flux densities.
-/

/-- A finite set of real boundary parameters is Lebesgue-null. -/
theorem realFinset_volume_zero (vertices : Finset ℝ) :
    (volume : Measure ℝ) (vertices : Set ℝ) = 0 :=
  vertices.measure_zero volume

/-- Removing finitely many parameter values from an arbitrary parameter set
does not change any Bochner set integral.  No integrability hypothesis is
needed because `setIntegral_congr_set` also identifies the nonintegrable-zero
branches of the Bochner integral definition. -/
theorem setIntegral_diff_finset_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℝ → E) (I : Set ℝ) (vertices : Finset ℝ) :
    (∫ t in I \ (vertices : Set ℝ), f t) =
      ∫ t in I, f t := by
  apply setIntegral_congr_set
  apply Filter.EventuallyLE.antisymm
  · exact Set.diff_subset.eventuallyLE
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro t ht
      by_contra htVertex
      exact ht.2 ⟨ht.1, htVertex⟩)
      (realFinset_volume_zero vertices)

/-- Data needed to turn a geometric boundary piece into a real-parameter
integral.  `endpoints` may contain shared vertices more than once across
different records; the theorem below removes each finite set independently.
-/
structure GammaTwoBoundaryParametrization where
  kind : GammaTwoBoundaryPieceKind
  parameterSet : Set ℝ
  endpoints : Finset ℝ
  point : ℝ → ℍ
  target : Set ℍ
  mapsTo : Set.MapsTo point parameterSet target

/-- Endpoint deletion for an arbitrary parameter-space flux integrand. -/
theorem GammaTwoBoundaryParametrization.integral_remove_endpoints
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : GammaTwoBoundaryParametrization) (f : ℝ → E) :
    (∫ t in P.parameterSet \ (P.endpoints : Set ℝ), f t) =
      ∫ t in P.parameterSet, f t :=
  setIntegral_diff_finset_eq f P.parameterSet P.endpoints

/-- Endpoint deletion after composing a boundary density with the actual
geometric parametrization. -/
theorem GammaTwoBoundaryParametrization.integral_comp_remove_endpoints
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (P : GammaTwoBoundaryParametrization) (F : ℍ → E) :
    (∫ t in P.parameterSet \ (P.endpoints : Set ℝ), F (P.point t)) =
      ∫ t in P.parameterSet, F (P.point t) :=
  setIntegral_diff_finset_eq (F ∘ P.point) P.parameterSet P.endpoints

/-- Package the explicit transported parametrization of an edge of the actual
measured fundamental carrier as one-dimensional boundary-integration data. -/
noncomputable def gammaTwoActualPolygonEdgeBoundaryParametrization
    (e : GammaTwoActualPolygonEdge) :
    GammaTwoBoundaryParametrization := by
  classical
  exact
    { kind := e.2.kind
      parameterSet := modularTileEdgeParameterSet e.2
      endpoints := modularTileEdgeEndpoints e.2
      point := fun t => if ht : t ∈ modularTileEdgeParameterSet e.2 then
          gammaTwoActualPolygonEdgeParam e ⟨t, ht⟩
        else UpperHalfPlane.I
      target := gammaTwoActualPolygonEdgeSet e
      mapsTo := by
        intro t ht
        simp only [dif_pos ht]
        exact gammaTwoActualPolygonEdgeParam_mem e ⟨t, ht⟩ }

/-- Vertex deletion is harmless for every explicitly parametrized edge of the
actual half-open measured fundamental polygon. -/
theorem gammaTwoActualPolygonEdge_integral_remove_vertices
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (e : GammaTwoActualPolygonEdge) (F : ℍ → E) :
    (∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
          ((gammaTwoActualPolygonEdgeBoundaryParametrization e).endpoints : Set ℝ),
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) :=
  (gammaTwoActualPolygonEdgeBoundaryParametrization e).integral_comp_remove_endpoints F

/-- Finite summation preserves endpoint deletion.  Thus a vertex shared by
several boundary records can be deleted in every record without changing the
total one-dimensional flux. -/
theorem GammaTwoBoundaryParametrization.finset_sum_integral_remove_endpoints
    {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : Finset ι) (P : ι → GammaTwoBoundaryParametrization)
    (F : ι → ℍ → E) :
    (∑ i ∈ s,
        ∫ t in (P i).parameterSet \ ((P i).endpoints : Set ℝ),
          F i ((P i).point t)) =
      ∑ i ∈ s,
        ∫ t in (P i).parameterSet, F i ((P i).point t) := by
  apply Finset.sum_congr rfl
  intro i hi
  exact (P i).integral_comp_remove_endpoints (F i)

/-- Direct finite-edge version for the actual measured fundamental polygon. -/
theorem gammaTwoActualPolygonEdges_sum_integral_remove_vertices
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (F : GammaTwoActualPolygonEdge → ℍ → E) :
    (∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
              ((gammaTwoActualPolygonEdgeBoundaryParametrization e).endpoints : Set ℝ),
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  simpa using
    GammaTwoBoundaryParametrization.finset_sum_integral_remove_endpoints
      (Finset.univ : Finset GammaTwoActualPolygonEdge)
      gammaTwoActualPolygonEdgeBoundaryParametrization F

/-- Geometric kind of one of the four displayed ideal-quadrilateral edges. -/
def GammaTwoStandardEdge.boundaryPieceKind :
    GammaTwoStandardEdge → GammaTwoBoundaryPieceKind
  | .leftVertical => .verticalSegment
  | .rightVertical => .verticalSegment
  | .leftCircular => .circularArc
  | .rightCircular => .circularArc

/-- A compact positive-parameter segment of any displayed ideal-quadrilateral
edge, with its two endpoint parameters recorded explicitly. -/
noncomputable def gammaTwoStandardEdgeSegmentParametrization
    (e : GammaTwoStandardEdge) (a b : ℝ) (ha : 0 < a) :
    GammaTwoBoundaryParametrization where
  kind := e.boundaryPieceKind
  parameterSet := Set.Icc a b
  endpoints := {a, b}
  point t := if ht : 0 < t then
      gammaTwoStandardEdgeParam e ⟨t, ht⟩
    else UpperHalfPlane.I
  target := gammaTwoStandardEdgeSet e
  mapsTo := by
    intro t ht
    simpa only [dif_pos (ha.trans_le ht.1)] using
      gammaTwoStandardEdgeParam_mem e ⟨t, ha.trans_le ht.1⟩

/-- Removing both vertices from a parametrized displayed edge does not alter
its one-dimensional boundary integral. -/
theorem gammaTwoStandardEdgeSegment_integral_remove_vertices
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (e : GammaTwoStandardEdge) (a b : ℝ) (ha : 0 < a) (F : ℍ → E) :
    (∫ t in (gammaTwoStandardEdgeSegmentParametrization e a b ha).parameterSet \
        ((gammaTwoStandardEdgeSegmentParametrization e a b ha).endpoints : Set ℝ),
        F ((gammaTwoStandardEdgeSegmentParametrization e a b ha).point t)) =
      ∫ t in (gammaTwoStandardEdgeSegmentParametrization e a b ha).parameterSet,
        F ((gammaTwoStandardEdgeSegmentParametrization e a b ha).point t) :=
  (gammaTwoStandardEdgeSegmentParametrization e a b ha).integral_comp_remove_endpoints F

/-- The horizontal line in a selected tile coordinate, transported to the
upper half-plane. -/
noncomputable def gammaTwoSelectedHorocycleParam
    (q : GammaTwoRightCoset) (Y t : ℝ) : ℍ :=
  gammaTwoCosetRep q •
    ⟨Complex.mk t (gammaTwoCuspLevel Y),
      lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)⟩

theorem gammaTwoSelectedHorocycleParam_mem
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    gammaTwoSelectedHorocycleParam q Y t ∈
      gammaTwoCosetRep q •
        {z : ℍ | z.im = gammaTwoCuspLevel Y} := by
  exact Set.mem_smul_set.mpr
    ⟨⟨Complex.mk t (gammaTwoCuspLevel Y),
        lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)⟩,
      by simp, rfl⟩

/-- Any compact interval on an actual selected horocycle has exactly the two
displayed endpoint parameters. -/
noncomputable def gammaTwoSelectedHorocycleSegmentParametrization
    (q : GammaTwoRightCoset) (Y a b : ℝ) :
    GammaTwoBoundaryParametrization where
  kind := .horocycleSegment
  parameterSet := Set.Icc a b
  endpoints := {a, b}
  point := gammaTwoSelectedHorocycleParam q Y
  target := gammaTwoCosetRep q •
    {z : ℍ | z.im = gammaTwoCuspLevel Y}
  mapsTo := fun t _ ↦ gammaTwoSelectedHorocycleParam_mem q Y t

/-- Removing the two vertices of a selected horocycle segment does not change
its one-dimensional boundary integral. -/
theorem gammaTwoSelectedHorocycleSegment_integral_remove_vertices
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (q : GammaTwoRightCoset) (Y a b : ℝ) (F : ℍ → E) :
    (∫ t in
        (gammaTwoSelectedHorocycleSegmentParametrization q Y a b).parameterSet \
          ((gammaTwoSelectedHorocycleSegmentParametrization q Y a b).endpoints : Set ℝ),
        F ((gammaTwoSelectedHorocycleSegmentParametrization q Y a b).point t)) =
      ∫ t in
        (gammaTwoSelectedHorocycleSegmentParametrization q Y a b).parameterSet,
        F ((gammaTwoSelectedHorocycleSegmentParametrization q Y a b).point t) :=
  (gammaTwoSelectedHorocycleSegmentParametrization q Y a b).integral_comp_remove_endpoints F

/-- In particular the entire frontier of the genuine cusp truncation is
hyperbolic-null. -/
theorem gammaTwoThreeCuspTruncation_frontier_null (Y : ℝ) :
    hyperbolicMeasure (frontier (gammaTwoThreeCuspTruncation Y)) = 0 :=
  measure_mono_null (gammaTwoThreeCuspTruncation_frontier_subset Y)
    (measure_union_null gammaTwoPairedSideBoundary_null
      (gammaTwoThreeCuspHorocycleBoundary_null Y))

theorem gammaTwoTruncationCorners_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoTruncationCorners Y) = 0 :=
  measure_mono_null Set.inter_subset_left
    gammaTwoPairedSideBoundary_null

/-- Corners for the literal three-height model. -/
noncomputable def gammaTwoThreeCuspCorners (Y : ℝ) : Set ℍ :=
  gammaTwoPairedSideBoundary ∩ gammaTwoThreeCuspHorocycleBoundary Y

theorem gammaTwoThreeCuspCorners_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoThreeCuspCorners Y) = 0 :=
  measure_mono_null Set.inter_subset_left
    gammaTwoPairedSideBoundary_null

/-- Named paired sides after deleting the three-cusp corner locus. -/
noncomputable def gammaTwoThreeCuspPairedSideAwayFromCorners
    (Y : ℝ) : Set ℍ :=
  gammaTwoPairedSideBoundary \ gammaTwoThreeCuspHorocycleBoundary Y

/-- Named cusp horocycles after deleting the paired-side corner locus. -/
noncomputable def gammaTwoThreeCuspHorocycleAwayFromCorners
    (Y : ℝ) : Set ℍ :=
  gammaTwoThreeCuspHorocycleBoundary Y \ gammaTwoPairedSideBoundary

theorem gammaTwoThreeCuspBoundaryPieces_disjoint (Y : ℝ) :
    Disjoint (gammaTwoThreeCuspPairedSideAwayFromCorners Y)
      (gammaTwoThreeCuspHorocycleAwayFromCorners Y) := by
  refine Set.disjoint_left.2 ?_
  intro z hzSide hzHoro
  exact hzSide.2 hzHoro.1

/-! ##### Exact literal-corner incidence in the real edge parameters

The fixed endpoint finsets of the untruncated modular edges contain the
vertices of those edges.  They do **not** contain the new, height-dependent
points at which a simultaneous local height cuts an edge.  We therefore name
the actual local height curves and pull their intersections back through the
proved-surjective edge parametrizations.  This gives an exact global
incidence theorem without making the false claim that distinct selected-tile
labels meet only at endpoints: internal seams can carry two labels along an
entire edge.
-/

/-- The full height curve in the local coordinate selected by a right-coset
representative. -/
noncomputable def gammaTwoSelectedHorocycleCurve
    (q : GammaTwoRightCoset) (Y : ℝ) : Set ℍ :=
  gammaTwoCosetRep q •
    {z : ℍ | z.im = gammaTwoCuspLevel Y}

/-- Membership in a selected height curve is exactly equality of the
corresponding pulled-back tile height. -/
theorem mem_gammaTwoSelectedHorocycleCurve_iff
    {q : GammaTwoRightCoset} {Y : ℝ} {z : ℍ} :
    z ∈ gammaTwoSelectedHorocycleCurve q Y ↔
      gammaTwoTileHeight q z = gammaTwoCuspLevel Y := by
  constructor
  · intro hz
    rcases Set.mem_smul_set.mp hz with ⟨w, hw, rfl⟩
    simpa [gammaTwoTileHeight] using hw
  · intro hz
    refine Set.mem_smul_set.mpr
      ⟨(gammaTwoCosetRep q)⁻¹ • z, ?_, by simp⟩
    simpa [gammaTwoTileHeight] using hz

/-- The explicit real horizontal-line parameter covers the whole selected
height curve, not merely a chosen compact subinterval of it. -/
theorem gammaTwoSelectedHorocycleParam_range
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Set.range (gammaTwoSelectedHorocycleParam q Y) =
      gammaTwoSelectedHorocycleCurve q Y := by
  apply Set.Subset.antisymm
  · rintro z ⟨t, rfl⟩
    simpa [gammaTwoSelectedHorocycleCurve] using
      gammaTwoSelectedHorocycleParam_mem q Y t
  · intro z hz
    rcases Set.mem_smul_set.mp hz with ⟨w, hw, hEq⟩
    change w.im = gammaTwoCuspLevel Y at hw
    refine ⟨w.re, ?_⟩
    have hbase :
        (⟨Complex.mk w.re (gammaTwoCuspLevel Y),
            lt_of_lt_of_le zero_lt_one
              (one_le_gammaTwoCuspLevel Y)⟩ : ℍ) = w := by
      rw [UpperHalfPlane.ext_iff]
      apply Complex.ext
      · simp
      · simpa using hw.symm
    unfold gammaTwoSelectedHorocycleParam
    rw [hbase]
    exact hEq

/-- The union of the actual parametrized selected-tile edges is exactly the
paired-side boundary used in the literal truncation theorem. -/
theorem gammaTwoPairedSideBoundary_eq_iUnion_actualPolygonEdgeSet :
    gammaTwoPairedSideBoundary =
      ⋃ e : GammaTwoActualPolygonEdge,
        gammaTwoActualPolygonEdgeSet e := by
  apply Set.Subset.antisymm
  · intro z hz
    unfold gammaTwoPairedSideBoundary at hz
    rcases Set.mem_iUnion.mp hz with ⟨q, hzq⟩
    rcases Set.mem_smul_set.mp hzq with ⟨w, hw, hEq⟩
    rw [modularFundamentalFrontier_eq_boundary] at hw
    rcases Set.mem_iUnion.mp
        (modularBoundary_subset_iUnion_modularTileEdgeSet hw) with
      ⟨e, hwe⟩
    exact Set.mem_iUnion.2 ⟨(q, e),
      Set.mem_smul_set.mpr ⟨w, hwe, hEq⟩⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_smul_set.mp hze with ⟨w, hw, hEq⟩
    unfold gammaTwoPairedSideBoundary
    refine Set.mem_iUnion.2 ⟨e.1,
      Set.mem_smul_set.mpr ⟨w, ?_, hEq⟩⟩
    rw [modularFundamentalFrontier_eq_boundary]
    exact modularTileEdgeSet_subset_boundary e.2 hw

/-- The nested cusp-class union is precisely the finite union of all selected
local height curves. -/
theorem gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves
    (Y : ℝ) :
    gammaTwoThreeCuspHorocycleBoundary Y =
      ⋃ q : GammaTwoRightCoset,
        gammaTwoSelectedHorocycleCurve q Y := by
  apply Set.Subset.antisymm
  · intro z hz
    unfold gammaTwoThreeCuspHorocycleBoundary at hz
    rcases Set.mem_iUnion.mp hz with ⟨κ, hzκ⟩
    unfold gammaTwoCuspClassHorocycleBoundary at hzκ
    rcases Set.mem_iUnion.mp hzκ with ⟨q, hzq⟩
    exact Set.mem_iUnion.2 ⟨q.1, hzq⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨q, hzq⟩
    unfold gammaTwoThreeCuspHorocycleBoundary
    refine Set.mem_iUnion.2 ⟨gammaTwoTileCuspClass q, ?_⟩
    unfold gammaTwoCuspClassHorocycleBoundary
    let q' :
        {r : GammaTwoRightCoset //
          gammaTwoTileCuspClass r = gammaTwoTileCuspClass q} :=
      ⟨q, rfl⟩
    exact Set.mem_iUnion.2 ⟨q', hzq⟩

/-- Exact set-level incidence: every literal three-cusp corner is an
intersection of one actual selected-tile edge and one selected local height
curve, and conversely. -/
theorem gammaTwoThreeCuspCorners_eq_iUnion_edge_inter_selectedCurve
    (Y : ℝ) :
    gammaTwoThreeCuspCorners Y =
      ⋃ e : GammaTwoActualPolygonEdge,
        ⋃ q : GammaTwoRightCoset,
          gammaTwoActualPolygonEdgeSet e ∩
            gammaTwoSelectedHorocycleCurve q Y := by
  apply Set.Subset.antisymm
  · intro z hz
    rcases hz with ⟨hzSide, hzHoro⟩
    rw [gammaTwoPairedSideBoundary_eq_iUnion_actualPolygonEdgeSet]
      at hzSide
    rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
      at hzHoro
    rcases Set.mem_iUnion.mp hzSide with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hzHoro with ⟨q, hzq⟩
    exact Set.mem_iUnion.2 ⟨e,
      Set.mem_iUnion.2 ⟨q, ⟨hze, hzq⟩⟩⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hz⟩
    refine ⟨?_, ?_⟩
    · rw [gammaTwoPairedSideBoundary_eq_iUnion_actualPolygonEdgeSet]
      exact Set.mem_iUnion.2 ⟨e, hz.1⟩
    · rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
      exact Set.mem_iUnion.2 ⟨q, hz.2⟩

/-- Actual subtype parameters on one edge that land on one selected local
height curve.  These are the literal height-dependent corner parameters. -/
noncomputable def gammaTwoActualEdgeSelectedCurveParameters
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset) :
    Set (modularTileEdgeParameterSet e.2) :=
  {t | gammaTwoActualPolygonEdgeParam e t ∈
    gammaTwoSelectedHorocycleCurve q Y}

/-- One edge/height-curve intersection is exactly the image of its actual
parameter preimage. -/
theorem gammaTwoActualEdge_inter_selectedCurve_eq_paramImage
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset) :
    gammaTwoActualPolygonEdgeSet e ∩
        gammaTwoSelectedHorocycleCurve q Y =
      gammaTwoActualPolygonEdgeParam e ''
        gammaTwoActualEdgeSelectedCurveParameters Y e q := by
  apply Set.Subset.antisymm
  · intro z hz
    have hze := hz.1
    rw [← gammaTwoActualPolygonEdgeParam_range e] at hze
    rcases hze with ⟨t, rfl⟩
    exact ⟨t, hz.2, rfl⟩
  · rintro z ⟨t, ht, rfl⟩
    exact ⟨gammaTwoActualPolygonEdgeParam_mem e t, ht⟩

/-- Strongest unconditional global parameter-incidence statement available
for the literal simultaneous-height truncation.  The two indexing types are
finite, while each displayed set is the *actual* preimage in the explicit
real edge parameter. -/
theorem gammaTwoThreeCuspCorners_eq_iUnion_paramImages
    (Y : ℝ) :
    gammaTwoThreeCuspCorners Y =
      ⋃ e : GammaTwoActualPolygonEdge,
        ⋃ q : GammaTwoRightCoset,
          gammaTwoActualPolygonEdgeParam e ''
            gammaTwoActualEdgeSelectedCurveParameters Y e q := by
  apply Set.Subset.antisymm
  · intro z hz
    rw [gammaTwoThreeCuspCorners_eq_iUnion_edge_inter_selectedCurve]
      at hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hzEq⟩
    rw [gammaTwoActualEdge_inter_selectedCurve_eq_paramImage]
      at hzEq
    exact Set.mem_iUnion.2 ⟨e, Set.mem_iUnion.2 ⟨q, hzEq⟩⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hzEq⟩
    rw [← gammaTwoActualEdge_inter_selectedCurve_eq_paramImage]
      at hzEq
    rw [gammaTwoThreeCuspCorners_eq_iUnion_edge_inter_selectedCurve]
    exact Set.mem_iUnion.2 ⟨e, Set.mem_iUnion.2 ⟨q, hzEq⟩⟩

/-- The genuine overlap locus on the literal truncation frontier.  The older
`gammaTwoThreeCuspCorners` is a convenient ambient side/height intersection;
this definition removes those ambient intersections which do not lie on the
boundary of `F_Y` because another height inequality has already failed. -/
noncomputable def gammaTwoLiteralFrontierCorners (Y : ℝ) : Set ℍ :=
  frontier (gammaTwoThreeCuspTruncation Y) ∩
    gammaTwoThreeCuspCorners Y

/-- Parameters on one actual edge which are both on the literal frontier and
on one selected local height curve. -/
noncomputable def gammaTwoActualEdgeLiteralCornerParametersAt
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset) :
    Set (modularTileEdgeParameterSet e.2) :=
  {t | gammaTwoActualPolygonEdgeParam e t ∈
      frontier (gammaTwoThreeCuspTruncation Y) ∧
    t ∈ gammaTwoActualEdgeSelectedCurveParameters Y e q}

/-- Exact global incidence for the genuine literal-frontier corners.  Every
point is displayed by an actual edge parameter and an actual local height
chart, and every displayed parameter maps back to the genuine overlap locus.
-/
theorem gammaTwoLiteralFrontierCorners_eq_iUnion_paramImages
    (Y : ℝ) :
    gammaTwoLiteralFrontierCorners Y =
      ⋃ e : GammaTwoActualPolygonEdge,
        ⋃ q : GammaTwoRightCoset,
          gammaTwoActualPolygonEdgeParam e ''
            gammaTwoActualEdgeLiteralCornerParametersAt Y e q := by
  apply Set.Subset.antisymm
  · intro z hz
    have hzCorner := hz.2
    rw [gammaTwoThreeCuspCorners_eq_iUnion_paramImages] at hzCorner
    rcases Set.mem_iUnion.mp hzCorner with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hzImage⟩
    rcases hzImage with ⟨t, ht, rfl⟩
    exact Set.mem_iUnion.2 ⟨e, Set.mem_iUnion.2 ⟨q,
      ⟨t, ⟨hz.1, ht⟩, rfl⟩⟩⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hzImage⟩
    rcases hzImage with ⟨t, ht, rfl⟩
    refine ⟨ht.1, ?_⟩
    rw [gammaTwoThreeCuspCorners_eq_iUnion_paramImages]
    exact Set.mem_iUnion.2 ⟨e, Set.mem_iUnion.2 ⟨q,
      ⟨t, ht.2, rfl⟩⟩⟩

/-- All genuine literal-corner parameters on one edge, before forgetting the
edge-parameter subtype. -/
noncomputable def gammaTwoActualEdgeLiteralCornerParameters
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) :
    Set (modularTileEdgeParameterSet e.2) :=
  ⋃ q : GammaTwoRightCoset,
    gammaTwoActualEdgeLiteralCornerParametersAt Y e q

/-- The same corner parameters as a subset of the real integration axis. -/
noncomputable def gammaTwoActualEdgeLiteralCornerRealParameters
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) : Set ℝ :=
  Subtype.val '' gammaTwoActualEdgeLiteralCornerParameters Y e

theorem gammaTwoActualEdgeLiteralCornerRealParameters_subset
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) :
    gammaTwoActualEdgeLiteralCornerRealParameters Y e ⊆
      modularTileEdgeParameterSet e.2 := by
  rintro t ⟨u, _hu, rfl⟩
  exact u.property

/-- Per-edge form of the genuine global corner incidence. -/
theorem gammaTwoLiteralFrontierCorners_eq_iUnion_edgeParamImages
    (Y : ℝ) :
    gammaTwoLiteralFrontierCorners Y =
      ⋃ e : GammaTwoActualPolygonEdge,
        gammaTwoActualPolygonEdgeParam e ''
          gammaTwoActualEdgeLiteralCornerParameters Y e := by
  apply Set.Subset.antisymm
  · intro z hz
    rw [gammaTwoLiteralFrontierCorners_eq_iUnion_paramImages] at hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hze⟩
    rcases Set.mem_iUnion.mp hze with ⟨q, hzImage⟩
    rcases hzImage with ⟨t, ht, rfl⟩
    refine Set.mem_iUnion.2 ⟨e, ⟨t, ?_, rfl⟩⟩
    exact Set.mem_iUnion.2 ⟨q, ht⟩
  · intro z hz
    rcases Set.mem_iUnion.mp hz with ⟨e, hzImage⟩
    rcases hzImage with ⟨t, ht, rfl⟩
    rcases Set.mem_iUnion.mp ht with ⟨q, htq⟩
    rw [gammaTwoLiteralFrontierCorners_eq_iUnion_paramImages]
    exact Set.mem_iUnion.2 ⟨e, Set.mem_iUnion.2 ⟨q,
      ⟨t, htq, rfl⟩⟩⟩

/-- Actual edge parameters retained by the literal truncated frontier. -/
noncomputable def gammaTwoLiteralFrontierEdgeParameters
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) :
    Set (modularTileEdgeParameterSet e.2) :=
  {t | gammaTwoActualPolygonEdgeParam e t ∈
    frontier (gammaTwoThreeCuspTruncation Y)}

/-- Actual selected-horocycle parameters retained by the literal truncated
frontier. -/
noncomputable def gammaTwoLiteralFrontierHorocycleParameters
    (Y : ℝ) (q : GammaTwoRightCoset) : Set ℝ :=
  {t | gammaTwoSelectedHorocycleParam q Y t ∈
    frontier (gammaTwoThreeCuspTruncation Y)}

/-- A finite family of restricted explicit edge and horocycle
parametrizations covers the literal frontier exactly.  This is a statement
about images of the *actual frontier preimages*, not a pairwise-disjointness
claim for the selected-tile labels. -/
theorem gammaTwoThreeCuspTruncation_frontier_eq_paramImages
    (Y : ℝ) :
    frontier (gammaTwoThreeCuspTruncation Y) =
      (⋃ e : GammaTwoActualPolygonEdge,
        gammaTwoActualPolygonEdgeParam e ''
          gammaTwoLiteralFrontierEdgeParameters Y e) ∪
      (⋃ q : GammaTwoRightCoset,
        gammaTwoSelectedHorocycleParam q Y ''
          gammaTwoLiteralFrontierHorocycleParameters Y q) := by
  apply Set.Subset.antisymm
  · intro z hz
    rcases gammaTwoThreeCuspTruncation_frontier_subset Y hz with
      hzSide | hzHoro
    · left
      rw [gammaTwoPairedSideBoundary_eq_iUnion_actualPolygonEdgeSet]
        at hzSide
      rcases Set.mem_iUnion.mp hzSide with ⟨e, hze⟩
      rw [← gammaTwoActualPolygonEdgeParam_range e] at hze
      rcases hze with ⟨t, rfl⟩
      exact Set.mem_iUnion.2 ⟨e, ⟨t, hz, rfl⟩⟩
    · right
      rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
        at hzHoro
      rcases Set.mem_iUnion.mp hzHoro with ⟨q, hzq⟩
      rw [← gammaTwoSelectedHorocycleParam_range q Y] at hzq
      rcases hzq with ⟨t, rfl⟩
      exact Set.mem_iUnion.2 ⟨q, ⟨t, hz, rfl⟩⟩
  · intro z hz
    rcases hz with hzEdge | hzHoro
    · rcases Set.mem_iUnion.mp hzEdge with ⟨e, hzImage⟩
      rcases hzImage with ⟨t, ht, rfl⟩
      exact ht
    · rcases Set.mem_iUnion.mp hzHoro with ⟨q, hzImage⟩
      rcases hzImage with ⟨t, ht, rfl⟩
      exact ht

/-- Finiteness of all local curve preimages implies finiteness of the full
corner-parameter set on one edge.  The geometric input is deliberately
visible here and is discharged unconditionally below: each transported
geodesic/horocycle intersection is reduced to a nonzero real polynomial. -/
theorem gammaTwoActualEdgeLiteralCornerParameters_finite_of_local
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (hfinite : ∀ q : GammaTwoRightCoset,
      (gammaTwoActualEdgeLiteralCornerParametersAt Y e q).Finite) :
    (gammaTwoActualEdgeLiteralCornerParameters Y e).Finite := by
  exact Set.finite_iUnion hfinite

/-- Forgetting the subtype preserves finiteness of literal corner parameters.
-/
theorem gammaTwoActualEdgeLiteralCornerRealParameters_finite_of_local
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (hfinite : ∀ q : GammaTwoRightCoset,
      (gammaTwoActualEdgeLiteralCornerParametersAt Y e q).Finite) :
    (gammaTwoActualEdgeLiteralCornerRealParameters Y e).Finite :=
  (gammaTwoActualEdgeLiteralCornerParameters_finite_of_local Y e hfinite).image
    Subtype.val

/-- Removing any null subset of the real parameter axis from a set integral
does not change that integral. -/
theorem setIntegral_diff_null_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℝ → E) (I C : Set ℝ)
    (hC : (volume : Measure ℝ) C = 0) :
    (∫ t in I \ C, f t) = ∫ t in I, f t := by
  apply setIntegral_congr_set
  apply Filter.EventuallyLE.antisymm
  · exact Set.diff_subset.eventuallyLE
  · rw [ae_le_set]
    exact measure_mono_null (by
      intro t ht
      by_contra htC
      exact ht.2 ⟨ht.1, htC⟩) hC

/-- Once the actual literal-corner preimage on an edge is null, deleting all
of it from that edge's one-dimensional flux integral is harmless. -/
theorem gammaTwoActualPolygonEdge_integral_remove_literalCorners_of_null
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) (F : ℍ → E)
    (hnull : (volume : Measure ℝ)
      (gammaTwoActualEdgeLiteralCornerRealParameters Y e) = 0) :
    (∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
          gammaTwoActualEdgeLiteralCornerRealParameters Y e,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) :=
  setIntegral_diff_null_eq
    (fun t ↦ F
      ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t))
    (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet
    (gammaTwoActualEdgeLiteralCornerRealParameters Y e) hnull

/-- Finite local geodesic/horocycle preimages are enough to discharge the
null-set premise of literal-corner deletion on one edge. -/
theorem gammaTwoActualPolygonEdge_integral_remove_literalCorners_of_finite
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) (F : ℍ → E)
    (hfinite : ∀ q : GammaTwoRightCoset,
      (gammaTwoActualEdgeLiteralCornerParametersAt Y e q).Finite) :
    (∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
          gammaTwoActualEdgeLiteralCornerRealParameters Y e,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  apply gammaTwoActualPolygonEdge_integral_remove_literalCorners_of_null
  exact
    (gammaTwoActualEdgeLiteralCornerRealParameters_finite_of_local
      Y e hfinite).measure_zero volume

/-- Finite summation over every actual polygon edge preserves deletion of all
literal corner parameters. -/
theorem gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners_of_null
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (F : GammaTwoActualPolygonEdge → ℍ → E)
    (hnull : ∀ e : GammaTwoActualPolygonEdge,
      (volume : Measure ℝ)
        (gammaTwoActualEdgeLiteralCornerRealParameters Y e) = 0) :
    (∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
              gammaTwoActualEdgeLiteralCornerRealParameters Y e,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  apply Finset.sum_congr rfl
  intro e _he
  exact gammaTwoActualPolygonEdge_integral_remove_literalCorners_of_null
    Y e (F e) (hnull e)

/-- Finite local incidence on every edge gives the corresponding total-flux
deletion identity. -/
theorem gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners_of_finite
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (F : GammaTwoActualPolygonEdge → ℍ → E)
    (hfinite : ∀ e : GammaTwoActualPolygonEdge,
      ∀ q : GammaTwoRightCoset,
        (gammaTwoActualEdgeLiteralCornerParametersAt Y e q).Finite) :
    (∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
              gammaTwoActualEdgeLiteralCornerRealParameters Y e,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  apply gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners_of_null
  intro e
  exact
    (gammaTwoActualEdgeLiteralCornerRealParameters_finite_of_local
      Y e (hfinite e)).measure_zero volume

/-! ##### Unconditional finiteness of the literal edge/horocycle incidence

For a source edge in the selected tile `e.1` and a selected height chart
`q`, pull both back to the standard modular tile.  The only matrix which
remains is

`(gammaTwoCosetRep q)⁻¹ * gammaTwoCosetRep e.1`.

If its lower row is `(c,d)`, the transformed height is

`y / ((c*x+d)^2 + c^2*y^2)`.

On a vertical edge this gives a nonzero polynomial of degree at most two in
the height-increment parameter.  On the circular edge the identity
`x=t/2`, `y^2=1-t^2/4` reduces the denominator to
`c^2+d^2+c*d*t`; squaring gives a quadratic whose leading coefficient is
`-1/4-L^2(c*d)^2 < 0`.  Thus every actual local incidence set is finite,
without a transversality assumption or a corner certificate.
-/

/-- Relative integral modular matrix between an actual edge tile and a
selected local-height chart. -/
noncomputable def gammaTwoCornerRelativeMatrix
    (e : GammaTwoActualPolygonEdge) (q : GammaTwoRightCoset) :
    SL(2, ℤ) :=
  (gammaTwoCosetRep q)⁻¹ * gammaTwoCosetRep e.1

/-- Lower-left real coefficient of the relative modular matrix. -/
noncomputable def gammaTwoCornerLowerLeft
    (e : GammaTwoActualPolygonEdge) (q : GammaTwoRightCoset) : ℝ :=
  ((gammaTwoCornerRelativeMatrix e q 1 0 : ℤ) : ℝ)

/-- Lower-right real coefficient of the relative modular matrix. -/
noncomputable def gammaTwoCornerLowerRight
    (e : GammaTwoActualPolygonEdge) (q : GammaTwoRightCoset) : ℝ :=
  ((gammaTwoCornerRelativeMatrix e q 1 1 : ℤ) : ℝ)

/-- Exact real quadratic form for the norm-square of a modular denominator.
This is separated from the incidence proof so no cast normalization is
hidden in the geometric argument. -/
theorem modular_normSq_denom_eq_lowerRowQuadratic
    (g : SL(2, ℤ)) (z : ℍ) :
    Complex.normSq (UpperHalfPlane.denom g z) =
      ((((g 1 0 : ℤ) : ℝ) * z.re + ((g 1 1 : ℤ) : ℝ)) ^ 2 +
        (((g 1 0 : ℤ) : ℝ) ^ 2 * z.im ^ 2)) := by
  rw [ModularGroup.denom_apply]
  norm_num [Complex.normSq_apply, UpperHalfPlane.coe_re,
    UpperHalfPlane.coe_im] <;> ring

/-- Equality to a positive cusp level is equivalent to clearing the strictly
positive modular denominator. -/
theorem modular_im_smul_eq_level_iff_lowerRowQuadratic
    (g : SL(2, ℤ)) (z : ℍ) (L : ℝ) :
    (g • z).im = L ↔
      z.im = L *
        (((((g 1 0 : ℤ) : ℝ) * z.re +
              ((g 1 1 : ℤ) : ℝ)) ^ 2 +
          (((g 1 0 : ℤ) : ℝ) ^ 2 * z.im ^ 2))) := by
  rw [ModularGroup.im_smul_eq_div_normSq,
    div_eq_iff
      (UpperHalfPlane.normSq_denom_pos
        (g : GL (Fin 2) ℝ) z.im_ne_zero).ne',
    modular_normSq_denom_eq_lowerRowQuadratic]

/-- Pulling an actual edge point back through a selected height chart leaves
exactly the relative matrix defined above. -/
theorem mem_gammaTwoActualEdgeSelectedCurveParameters_iff_relativeHeight
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset)
    (t : modularTileEdgeParameterSet e.2) :
    t ∈ gammaTwoActualEdgeSelectedCurveParameters Y e q ↔
      (gammaTwoCornerRelativeMatrix e q •
          modularTileEdgeParam e.2 t).im = gammaTwoCuspLevel Y := by
  rw [show t ∈ gammaTwoActualEdgeSelectedCurveParameters Y e q ↔
      gammaTwoActualPolygonEdgeParam e t ∈
        gammaTwoSelectedHorocycleCurve q Y by rfl,
    mem_gammaTwoSelectedHorocycleCurve_iff]
  simp only [gammaTwoTileHeight, gammaTwoActualPolygonEdgeParam,
    gammaTwoCornerRelativeMatrix, mul_smul]

/-- Expanded polynomial for a vertical edge with fixed real coordinate
`x₀` and height `y₀+t`. -/
noncomputable def gammaTwoVerticalIncidencePolynomial
    (L c d x₀ y₀ : ℝ) : Polynomial ℝ :=
  Polynomial.C
      (y₀ - L * ((c * x₀ + d) ^ 2 + c ^ 2 * y₀ ^ 2)) +
    Polynomial.C (1 - 2 * L * c ^ 2 * y₀) * Polynomial.X +
    Polynomial.C (-(L * c ^ 2)) * Polynomial.X ^ 2

/-- Evaluation of the expanded vertical incidence polynomial. -/
theorem gammaTwoVerticalIncidencePolynomial_eval
    (L c d x₀ y₀ t : ℝ) :
    Polynomial.eval t
        (gammaTwoVerticalIncidencePolynomial L c d x₀ y₀) =
      (y₀ + t) -
        L * ((c * x₀ + d) ^ 2 + c ^ 2 * (y₀ + t) ^ 2) := by
  simp [gammaTwoVerticalIncidencePolynomial]
  ring

/-- The vertical incidence polynomial is never zero at a positive level:
if `c ≠ 0` its quadratic coefficient is nonzero, while for `c = 0` its
linear coefficient is exactly one. -/
theorem gammaTwoVerticalIncidencePolynomial_ne_zero
    (L c d x₀ y₀ : ℝ) (hL : 0 < L) :
    gammaTwoVerticalIncidencePolynomial L c d x₀ y₀ ≠ 0 := by
  intro hp
  have h0 := congrArg (Polynomial.eval (0 : ℝ)) hp
  have h1 := congrArg (Polynomial.eval (1 : ℝ)) hp
  have h2 := congrArg (Polynomial.eval (2 : ℝ)) hp
  simp [gammaTwoVerticalIncidencePolynomial_eval] at h0 h1 h2
  by_cases hc : c = 0
  · subst c
    norm_num at h0 h1
    linarith
  · have hc2 : 0 < c ^ 2 := sq_pos_of_ne_zero hc
    nlinarith

/-- Expanded polynomial obtained from a circular edge after the denominator
has been reduced to the affine expression `A+B*t`. -/
noncomputable def gammaTwoCircularIncidencePolynomial
    (L A B : ℝ) : Polynomial ℝ :=
  Polynomial.C (1 - L ^ 2 * A ^ 2) +
    Polynomial.C (-2 * L ^ 2 * A * B) * Polynomial.X +
    Polynomial.C (-((1 : ℝ) / 4) - L ^ 2 * B ^ 2) * Polynomial.X ^ 2

/-- Evaluation of the expanded circular incidence polynomial. -/
theorem gammaTwoCircularIncidencePolynomial_eval
    (L A B t : ℝ) :
    Polynomial.eval t (gammaTwoCircularIncidencePolynomial L A B) =
      1 - t ^ 2 / 4 - L ^ 2 * (A + B * t) ^ 2 := by
  simp [gammaTwoCircularIncidencePolynomial]
  ring

/-- The circular incidence polynomial is always nonzero.  Its quadratic
coefficient is strictly negative, independently of the relative matrix. -/
theorem gammaTwoCircularIncidencePolynomial_ne_zero
    (L A B : ℝ) :
    gammaTwoCircularIncidencePolynomial L A B ≠ 0 := by
  intro hp
  have h0 := congrArg (Polynomial.eval (0 : ℝ)) hp
  have h1 := congrArg (Polynomial.eval (1 : ℝ)) hp
  have hm1 := congrArg (Polynomial.eval (-1 : ℝ)) hp
  simp [gammaTwoCircularIncidencePolynomial_eval] at h0 h1 hm1
  have hnonneg : 0 ≤ L ^ 2 * B ^ 2 :=
    mul_nonneg (sq_nonneg L) (sq_nonneg B)
  nlinarith

/-- The circular parameter has the unit-circle square identity used to
eliminate its square root from the incidence equation. -/
theorem modularCircularArcParam_im_sq
    (t : Set.Icc (-1 : ℝ) 1) :
    (modularCircularArcParam t).im ^ 2 =
      1 - ((t : ℝ) / 2) ^ 2 := by
  have hprod :
      0 ≤ (1 - (t : ℝ)) * ((t : ℝ) + 1) :=
    mul_nonneg (sub_nonneg.mpr t.property.2)
      (by linarith [t.property.1])
  have hs : 0 ≤ 1 - ((t : ℝ) / 2) ^ 2 := by
    nlinarith
  simpa [modularCircularArcParam] using Real.sq_sqrt hs

/-- On the circular edge the lower-row denominator quadratic is affine in
the real edge parameter. -/
theorem circular_lowerRowQuadratic_eq_affine
    (c d : ℝ) (t : Set.Icc (-1 : ℝ) 1) :
    (c * (modularCircularArcParam t).re + d) ^ 2 +
        c ^ 2 * (modularCircularArcParam t).im ^ 2 =
      (c ^ 2 + d ^ 2) + (c * d) * (t : ℝ) := by
  rw [modularCircularArcParam_im_sq]
  simp only [modularCircularArcParam, UpperHalfPlane.mk_re]
  ring

/-- Every actual circular-edge/selected-height-curve parameter lies in the
root set of the explicit nonzero circular incidence polynomial. -/
theorem gammaTwoCircularSelectedCurveParameters_subset_isRoot
    (Y : ℝ) (e : GammaTwoRightCoset)
    (q : GammaTwoRightCoset) :
    gammaTwoActualEdgeSelectedCurveParameters Y
        (e, .circularArc) q ⊆
      {t : Set.Icc (-1 : ℝ) 1 |
        Polynomial.IsRoot
          (gammaTwoCircularIncidencePolynomial
            (gammaTwoCuspLevel Y)
            (gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 +
              gammaTwoCornerLowerRight (e, .circularArc) q ^ 2)
            (gammaTwoCornerLowerLeft (e, .circularArc) q *
              gammaTwoCornerLowerRight (e, .circularArc) q))
          (t : ℝ)} := by
  intro t ht
  change Polynomial.eval (t : ℝ)
      (gammaTwoCircularIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 +
          gammaTwoCornerLowerRight (e, .circularArc) q ^ 2)
        (gammaTwoCornerLowerLeft (e, .circularArc) q *
          gammaTwoCornerLowerRight (e, .circularArc) q)) = 0
  rw [gammaTwoCircularIncidencePolynomial_eval]
  have hheight :=
    (mem_gammaTwoActualEdgeSelectedCurveParameters_iff_relativeHeight
      Y (e, .circularArc) q t).mp ht
  have hcleared :=
    (modular_im_smul_eq_level_iff_lowerRowQuadratic
      (gammaTwoCornerRelativeMatrix (e, .circularArc) q)
      (modularCircularArcParam t) (gammaTwoCuspLevel Y)).mp hheight
  change (modularCircularArcParam t).im =
      gammaTwoCuspLevel Y *
        ((gammaTwoCornerLowerLeft (e, .circularArc) q *
              (modularCircularArcParam t).re +
            gammaTwoCornerLowerRight (e, .circularArc) q) ^ 2 +
          gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 *
            (modularCircularArcParam t).im ^ 2) at hcleared
  have htmem : (t : ℝ) ∈ Set.Icc (-1 : ℝ) 1 := by
    simpa [modularTileEdgeParameterSet] using t.property
  have hinside : 0 ≤ 1 - ((t : ℝ) / 2) ^ 2 := by
    nlinarith [htmem.1, htmem.2]
  have hsqrt :
      (Real.sqrt (1 - ((t : ℝ) / 2) ^ 2)) ^ 2 =
        1 - ((t : ℝ) / 2) ^ 2 :=
    Real.sq_sqrt hinside
  change
    Real.sqrt (1 - ((t : ℝ) / 2) ^ 2) =
      gammaTwoCuspLevel Y *
        ((gammaTwoCornerLowerLeft (e, .circularArc) q *
              ((t : ℝ) / 2) +
            gammaTwoCornerLowerRight (e, .circularArc) q) ^ 2 +
          gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 *
            (Real.sqrt (1 - ((t : ℝ) / 2) ^ 2)) ^ 2) at hcleared
  have hquad :
      (gammaTwoCornerLowerLeft (e, .circularArc) q *
              ((t : ℝ) / 2) +
            gammaTwoCornerLowerRight (e, .circularArc) q) ^ 2 +
          gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 *
            (Real.sqrt (1 - ((t : ℝ) / 2) ^ 2)) ^ 2 =
        gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 +
          gammaTwoCornerLowerRight (e, .circularArc) q ^ 2 +
          gammaTwoCornerLowerLeft (e, .circularArc) q *
            gammaTwoCornerLowerRight (e, .circularArc) q * (t : ℝ) := by
    rw [hsqrt]
    ring
  rw [hquad] at hcleared
  have hsq := congrArg (fun y : ℝ => y ^ 2) hcleared
  nlinarith [hsqrt, hsq]

/-- Every actual left-vertical-edge/selected-height-curve parameter is a root
of its explicit nonzero vertical incidence polynomial. -/
theorem gammaTwoLeftVerticalSelectedCurveParameters_subset_isRoot
    (Y : ℝ) (e : GammaTwoRightCoset)
    (q : GammaTwoRightCoset) :
    gammaTwoActualEdgeSelectedCurveParameters Y
        (e, .leftVerticalSegment) q ⊆
      {t : Set.Ici (0 : ℝ) |
        Polynomial.IsRoot
          (gammaTwoVerticalIncidencePolynomial
            (gammaTwoCuspLevel Y)
            (gammaTwoCornerLowerLeft (e, .leftVerticalSegment) q)
            (gammaTwoCornerLowerRight (e, .leftVerticalSegment) q)
            (-((1 : ℝ) / 2)) (Real.sqrt 3 / 2))
          (t : ℝ)} := by
  intro t ht
  change Polynomial.eval (t : ℝ)
      (gammaTwoVerticalIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .leftVerticalSegment) q)
        (gammaTwoCornerLowerRight (e, .leftVerticalSegment) q)
        (-((1 : ℝ) / 2)) (Real.sqrt 3 / 2)) = 0
  rw [gammaTwoVerticalIncidencePolynomial_eval]
  have hheight :=
    (mem_gammaTwoActualEdgeSelectedCurveParameters_iff_relativeHeight
      Y (e, .leftVerticalSegment) q t).mp ht
  have hcleared :=
    (modular_im_smul_eq_level_iff_lowerRowQuadratic
      (gammaTwoCornerRelativeMatrix (e, .leftVerticalSegment) q)
      (modularLeftVerticalParam t) (gammaTwoCuspLevel Y)).mp hheight
  change (Real.sqrt 3 / 2 + (t : ℝ)) =
      gammaTwoCuspLevel Y *
        ((gammaTwoCornerLowerLeft (e, .leftVerticalSegment) q *
              (-((1 : ℝ) / 2)) +
            gammaTwoCornerLowerRight (e, .leftVerticalSegment) q) ^ 2 +
          gammaTwoCornerLowerLeft (e, .leftVerticalSegment) q ^ 2 *
            (Real.sqrt 3 / 2 + (t : ℝ)) ^ 2) at hcleared
  linarith

/-- Every actual right-vertical-edge/selected-height-curve parameter is a
root of its explicit nonzero vertical incidence polynomial. -/
theorem gammaTwoRightVerticalSelectedCurveParameters_subset_isRoot
    (Y : ℝ) (e : GammaTwoRightCoset)
    (q : GammaTwoRightCoset) :
    gammaTwoActualEdgeSelectedCurveParameters Y
        (e, .rightVerticalSegment) q ⊆
      {t : Set.Ici (0 : ℝ) |
        Polynomial.IsRoot
          (gammaTwoVerticalIncidencePolynomial
            (gammaTwoCuspLevel Y)
            (gammaTwoCornerLowerLeft (e, .rightVerticalSegment) q)
            (gammaTwoCornerLowerRight (e, .rightVerticalSegment) q)
            ((1 : ℝ) / 2) (Real.sqrt 3 / 2))
          (t : ℝ)} := by
  intro t ht
  change Polynomial.eval (t : ℝ)
      (gammaTwoVerticalIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .rightVerticalSegment) q)
        (gammaTwoCornerLowerRight (e, .rightVerticalSegment) q)
        ((1 : ℝ) / 2) (Real.sqrt 3 / 2)) = 0
  rw [gammaTwoVerticalIncidencePolynomial_eval]
  have hheight :=
    (mem_gammaTwoActualEdgeSelectedCurveParameters_iff_relativeHeight
      Y (e, .rightVerticalSegment) q t).mp ht
  have hcleared :=
    (modular_im_smul_eq_level_iff_lowerRowQuadratic
      (gammaTwoCornerRelativeMatrix (e, .rightVerticalSegment) q)
      (modularRightVerticalParam t) (gammaTwoCuspLevel Y)).mp hheight
  change (Real.sqrt 3 / 2 + (t : ℝ)) =
      gammaTwoCuspLevel Y *
        ((gammaTwoCornerLowerLeft (e, .rightVerticalSegment) q *
              ((1 : ℝ) / 2) +
            gammaTwoCornerLowerRight (e, .rightVerticalSegment) q) ^ 2 +
          gammaTwoCornerLowerLeft (e, .rightVerticalSegment) q ^ 2 *
            (Real.sqrt 3 / 2 + (t : ℝ)) ^ 2) at hcleared
  linarith

/-- The parameter preimage of one actual edge against one selected local
height curve is finite, with no geometric hypothesis. -/
theorem gammaTwoActualEdgeSelectedCurveParameters_finite
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset) :
    (gammaTwoActualEdgeSelectedCurveParameters Y e q).Finite := by
  rcases e with ⟨e, edge⟩
  cases edge with
  | circularArc =>
      let P : Polynomial ℝ := gammaTwoCircularIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .circularArc) q ^ 2 +
          gammaTwoCornerLowerRight (e, .circularArc) q ^ 2)
        (gammaTwoCornerLowerLeft (e, .circularArc) q *
          gammaTwoCornerLowerRight (e, .circularArc) q)
      have hP : P ≠ 0 := by
        exact gammaTwoCircularIncidencePolynomial_ne_zero _ _ _
      have hroots : ({x : ℝ | Polynomial.IsRoot P x} : Set ℝ).Finite :=
        Polynomial.finite_setOf_isRoot hP
      have hpre :
          ({t : Set.Icc (-1 : ℝ) 1 |
            Polynomial.IsRoot P (t : ℝ)}).Finite :=
        hroots.preimage Subtype.val_injective.injOn
      exact hpre.subset
        (gammaTwoCircularSelectedCurveParameters_subset_isRoot Y e q)
  | leftVerticalSegment =>
      let P : Polynomial ℝ := gammaTwoVerticalIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .leftVerticalSegment) q)
        (gammaTwoCornerLowerRight (e, .leftVerticalSegment) q)
        (-((1 : ℝ) / 2)) (Real.sqrt 3 / 2)
      have hP : P ≠ 0 := by
        apply gammaTwoVerticalIncidencePolynomial_ne_zero
        exact lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
      have hroots : ({x : ℝ | Polynomial.IsRoot P x} : Set ℝ).Finite :=
        Polynomial.finite_setOf_isRoot hP
      have hpre :
          ({t : Set.Ici (0 : ℝ) |
            Polynomial.IsRoot P (t : ℝ)}).Finite :=
        hroots.preimage Subtype.val_injective.injOn
      exact hpre.subset
        (gammaTwoLeftVerticalSelectedCurveParameters_subset_isRoot Y e q)
  | rightVerticalSegment =>
      let P : Polynomial ℝ := gammaTwoVerticalIncidencePolynomial
        (gammaTwoCuspLevel Y)
        (gammaTwoCornerLowerLeft (e, .rightVerticalSegment) q)
        (gammaTwoCornerLowerRight (e, .rightVerticalSegment) q)
        ((1 : ℝ) / 2) (Real.sqrt 3 / 2)
      have hP : P ≠ 0 := by
        apply gammaTwoVerticalIncidencePolynomial_ne_zero
        exact lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
      have hroots : ({x : ℝ | Polynomial.IsRoot P x} : Set ℝ).Finite :=
        Polynomial.finite_setOf_isRoot hP
      have hpre :
          ({t : Set.Ici (0 : ℝ) |
            Polynomial.IsRoot P (t : ℝ)}).Finite :=
        hroots.preimage Subtype.val_injective.injOn
      exact hpre.subset
        (gammaTwoRightVerticalSelectedCurveParameters_subset_isRoot Y e q)

/-- The genuine literal-frontier incidence is a subset of the corresponding
ambient edge/height-curve incidence and is therefore finite
unconditionally. -/
theorem gammaTwoActualEdgeLiteralCornerParametersAt_finite
    (Y : ℝ) (e : GammaTwoActualPolygonEdge)
    (q : GammaTwoRightCoset) :
    (gammaTwoActualEdgeLiteralCornerParametersAt Y e q).Finite := by
  exact (gammaTwoActualEdgeSelectedCurveParameters_finite Y e q).subset
    (fun _t ht ↦ ht.2)

/-- All genuine literal-corner parameters on one edge form a finite set. -/
theorem gammaTwoActualEdgeLiteralCornerParameters_finite
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) :
    (gammaTwoActualEdgeLiteralCornerParameters Y e).Finite :=
  gammaTwoActualEdgeLiteralCornerParameters_finite_of_local Y e
    (gammaTwoActualEdgeLiteralCornerParametersAt_finite Y e)

/-- After forgetting the edge-parameter subtype, genuine literal corners
remain finite on the real integration axis. -/
theorem gammaTwoActualEdgeLiteralCornerRealParameters_finite
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) :
    (gammaTwoActualEdgeLiteralCornerRealParameters Y e).Finite :=
  gammaTwoActualEdgeLiteralCornerRealParameters_finite_of_local Y e
    (gammaTwoActualEdgeLiteralCornerParametersAt_finite Y e)

/-- The genuine literal-frontier corner locus itself is finite.  Multiple
edge labels on an internal seam may still name the same point; finiteness,
not false pairwise-disjointness, is the property needed for integration. -/
theorem gammaTwoLiteralFrontierCorners_finite (Y : ℝ) :
    (gammaTwoLiteralFrontierCorners Y).Finite := by
  rw [gammaTwoLiteralFrontierCorners_eq_iUnion_paramImages]
  exact Set.finite_iUnion fun e ↦
    Set.finite_iUnion fun q ↦
      (gammaTwoActualEdgeLiteralCornerParametersAt_finite Y e q).image
        (gammaTwoActualPolygonEdgeParam e)

/-- Unconditional one-edge deletion of every genuine literal-corner
parameter from its flux integral. -/
theorem gammaTwoActualPolygonEdge_integral_remove_literalCorners
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (e : GammaTwoActualPolygonEdge) (F : ℍ → E) :
    (∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
          gammaTwoActualEdgeLiteralCornerRealParameters Y e,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∫ t in
        (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
        F ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  apply gammaTwoActualPolygonEdge_integral_remove_literalCorners_of_finite
  exact gammaTwoActualEdgeLiteralCornerParametersAt_finite Y e

/-- Unconditional finite edge-sum identity after deleting all genuine
literal-corner parameters. -/
theorem gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (F : GammaTwoActualPolygonEdge → ℍ → E) :
    (∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
              gammaTwoActualEdgeLiteralCornerRealParameters Y e,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∑ e : GammaTwoActualPolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  apply gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners_of_finite
  exact fun e q ↦
    gammaTwoActualEdgeLiteralCornerParametersAt_finite Y e q

/-- Paired sides with corners removed. -/
noncomputable def gammaTwoPairedSideAwayFromCorners (Y : ℝ) : Set ℍ :=
  gammaTwoPairedSideBoundary \ gammaTwoHorocycleBoundary Y

/-- Horocycles with corners removed. -/
noncomputable def gammaTwoHorocycleAwayFromCorners (Y : ℝ) : Set ℍ :=
  gammaTwoHorocycleBoundary Y \ gammaTwoPairedSideBoundary

theorem gammaTwoBoundaryPieces_disjoint (Y : ℝ) :
    Disjoint (gammaTwoPairedSideAwayFromCorners Y)
      (gammaTwoHorocycleAwayFromCorners Y) := by
  refine Set.disjoint_left.2 ?_
  intro z hzSide hzHoro
  exact hzSide.2 hzHoro.1

/-- The finite-tile compact-cofinality statement.  It is formulated here as
a reusable proposition and inhabited below from the arithmetic height bound
on compact lifts; elliptic and paired-side points need no separate choice. -/
def GammaTwoGeometricCompactCofinal : Prop :=
  ∀ K : Set GammaTwoQuotient, IsCompact K →
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ gammaTwoQuotientMk '' gammaTwoGeometricTruncation Y

/-- Exact cofinal-comparison obligation between the literal three-height
intersection and the compact finite-tile model.  No topological exhaustion is
used in this statement. -/
def GammaTwoThreeCuspFiniteTileCofinal : Prop :=
  (∀ Y : ℝ, ∃ Z : ℝ,
    gammaTwoThreeCuspTruncation Y ⊆ gammaTwoGeometricTruncation Z) ∧
  (∀ Y : ℝ, ∃ Z : ℝ,
    gammaTwoGeometricTruncation Y ⊆ gammaTwoThreeCuspTruncation Z)

/-- The literal three-cusp stages and the compact finite-tile stages are
cofinal without an extra certificate.  One inclusion holds at equal height;
the reverse inclusion follows by maximizing the simultaneous tile-height
control on the compact finite-tile stage. -/
theorem gammaTwoThreeCuspFiniteTileCofinal :
    GammaTwoThreeCuspFiniteTileCofinal := by
  constructor
  · intro Y
    exact ⟨Y, gammaTwoThreeCuspTruncation_subset_geometricTruncation Y⟩
  · intro Y
    obtain ⟨Z, _hZ, hYZ⟩ :=
      compact_closedTileCarrier_subset_threeCuspTruncation
        (gammaTwoGeometricTruncation_isCompact Y)
        (gammaTwoGeometricTruncation_subset_closedTileCarrier Y)
    exact ⟨Z, hYZ⟩

/-- Uniform compact-support capture by the literal three-height `F_Y`. -/
def GammaTwoThreeCuspCompactCofinal : Prop :=
  ∀ K : Set GammaTwoQuotient, IsCompact K →
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y

/-- A cofinal comparison with the compact finite-tile model transfers its
quotient-compact capture theorem to the literal three-height model. -/
theorem threeCuspCompactCofinal_of_finiteTile
    (hTile : GammaTwoGeometricCompactCofinal)
    (hBridge : GammaTwoThreeCuspFiniteTileCofinal) :
    GammaTwoThreeCuspCompactCofinal := by
  intro K hK
  obtain ⟨Y, hY, hKY⟩ := hTile K hK
  obtain ⟨Z, hYZ⟩ := hBridge.2 Y
  let W : ℝ := max 2 Z
  have hW : 1 < W :=
    lt_of_lt_of_le (by norm_num) (le_max_left _ _)
  have hZW : Z ≤ W := le_max_right _ _
  have hMono : gammaTwoThreeCuspTruncation Z ⊆
      gammaTwoThreeCuspTruncation W :=
    gammaTwoThreeCuspTruncation_monotone hZW
  exact ⟨W, hW,
    hKY.trans (Set.image_mono (hYZ.trans hMono))⟩

/-- A finite-tile compact-capture theorem transfers to the literal model.
The finite-tile hypothesis itself is discharged below from proper arithmetic
reduction on compact lifts. -/
theorem threeCuspCompactCofinal_of_geometric
    (hTile : GammaTwoGeometricCompactCofinal) :
    GammaTwoThreeCuspCompactCofinal :=
  threeCuspCompactCofinal_of_finiteTile hTile
    gammaTwoThreeCuspFiniteTileCofinal

/-! #### Concrete compact lifts of quotient compacta

The open measured fundamental-domain carrier is intentionally allowed to miss
boundary orbits.  It therefore cannot serve as a pointwise representative set
for every compact subset of the quotient.  The open quotient map nevertheless
gives a different, completely unconditional construction: a compact quotient
set has a compact lift upstairs.  Indeed, compact neighbourhoods of chosen
representatives have open images, and finitely many of those images cover the
given compact set.
-/

/-- Every compact subset of the effective orbit quotient is covered by the
image of a compact subset of the upper half-plane. -/
theorem compact_has_compact_upstairs_lift
    {K : Set GammaTwoQuotient} (hK : IsCompact K) :
    ∃ L : Set ℍ, IsCompact L ∧ K ⊆ gammaTwoQuotientMk '' L := by
  classical
  choose z hz using gammaTwoQuotientMk_isOpenQuotientMap.surjective
  choose L hLc hLn using fun q : GammaTwoQuotient =>
    exists_compact_mem_nhds (z q)
  have hImageNhd : ∀ q : GammaTwoQuotient,
      gammaTwoQuotientMk '' L q ∈ nhds q := by
    intro q
    simpa only [hz q] using
      gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap.image_mem_nhds
        (hLn q)
  obtain ⟨I, -, hcover⟩ := hK.elim_nhds_subcover
    (fun q => gammaTwoQuotientMk '' L q)
    (fun q _ => hImageNhd q)
  refine ⟨⋃ q ∈ I, L q,
    I.isCompact_biUnion (fun q _ => hLc q), ?_⟩
  intro q hq
  rcases Set.mem_iUnion₂.mp (hcover hq) with ⟨r, hrI, hqr⟩
  rcases hqr with ⟨w, hwL, hwq⟩
  exact ⟨w, Set.mem_iUnion₂_of_mem hrI hwL, hwq⟩

/-! ##### Properness of closed-carrier reduction

The following argument is uniform at elliptic points and paired sides: it
never chooses a locally unique polygon representative.  Equality in the
orbit quotient supplies some effective transform, and the arithmetic height
envelope bounds every possible integral representative at once. -/

/-- A compact lift gives a strict simultaneous height bound for every point
over its quotient image which lies in the closed six-tile carrier. -/
theorem compactLift_closedCarrier_strictHeightCapture
    {K : Set GammaTwoQuotient} {L : Set ℍ}
    (hL : IsCompact L) (hKL : K ⊆ gammaTwoQuotientMk '' L) :
    ∃ Y : ℝ, 1 < Y ∧
      gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K ⊆
        gammaTwoClosedTileCarrier ∩
          gammaTwoThreeCuspStrictHeightSublevel Y := by
  obtain ⟨Y, hY, hUniform⟩ := compact_uniform_modularHeight hL
  refine ⟨Y, hY, ?_⟩
  intro z hz
  rcases hKL hz.2 with ⟨w, hwL, hwq⟩
  have hOrbit : z ∈ MulAction.orbit GammaTwoEffective w :=
    MulAction.orbitRel_apply.mp (Quotient.exact' hwq.symm)
  rcases MulAction.mem_orbit_iff.mp hOrbit with ⟨a, haw⟩
  rcases effective_exists_gamma a with ⟨γ, hγ⟩
  have hγw : (γ : SL(2, ℤ)) • w = z := by
    exact (hγ w).symm.trans haw
  refine ⟨hz.1, fun q ↦ ?_⟩
  rw [gammaTwoCuspLevel_of_one_le hY.le]
  change (((gammaTwoCosetRep q)⁻¹ • z).im < Y)
  rw [← hγw]
  simpa only [mul_smul] using
    hUniform w hwL
      ((gammaTwoCosetRep q)⁻¹ * (γ : SL(2, ℤ)))

/-- The inverse image of a compact quotient set inside the selected closed
carrier is compact.  This is the previously missing
`GammaTwoClosedCarrierCompactPreimage` theorem, proved from a compact lift and
the strict arithmetic reduction bound rather than postulated as a
certificate. -/
theorem gammaTwoClosedCarrier_inter_preimage_isCompact
    (K : Set GammaTwoQuotient) (hK : IsCompact K) :
    IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) := by
  obtain ⟨L, hL, hKL⟩ := compact_has_compact_upstairs_lift hK
  obtain ⟨Y, _hY, hStrict⟩ :=
    compactLift_closedCarrier_strictHeightCapture hL hKL
  refine (gammaTwoThreeCuspTruncation_isCompact Y).of_isClosed_subset
    (gammaTwoClosedTileCarrier_isClosed.inter
      (hK.isClosed.preimage
        gammaTwoQuotientMk_isOpenQuotientMap.continuous)) ?_
  intro z hz
  have hzStrict := hStrict hz
  exact ⟨hzStrict.1,
    gammaTwoThreeCuspStrictHeightSublevel_subset Y hzStrict.2⟩

/-- Representatives of a quotient set, viewed inside the chosen polygon
subtype. -/
def gammaTwoRelativeQuotientPreimage
    (K : Set GammaTwoQuotient) : Set GammaTwoChosenPolygon :=
  {z | gammaTwoQuotientMk z.1 ∈ K}

/-- Every compact quotient set is represented strictly inside the cusp-height
boundary, in the relative topology of the closed polygon.  Elliptic points
and paired-side points require no exceptional branch: the strict bound holds
simultaneously in every selected tile chart. -/
theorem compact_relativeQuotientPreimage_subset_truncationInterior
    (K : Set GammaTwoQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      gammaTwoRelativeQuotientPreimage K ⊆
        interior (gammaTwoRelativeTruncation Y) := by
  obtain ⟨L, hL, hKL⟩ := compact_has_compact_upstairs_lift hK
  obtain ⟨Y, hY, hStrict⟩ :=
    compactLift_closedCarrier_strictHeightCapture hL hKL
  refine ⟨Y, hY, fun z hz ↦
    gammaTwoRelativeStrictHeightSublevel_subset_interior Y ?_⟩
  have hzCarrier : (z.1 : ℍ) ∈ gammaTwoClosedTileCarrier := by
    rw [gammaTwoClosedTileCarrier_eq_chosenCarrier]
    exact z.2
  exact (hStrict ⟨hzCarrier, hz⟩).2

/-- Every quotient point has a representative in the selected closed carrier,
and this remains true after restricting to any prescribed quotient set. -/
theorem quotientSet_subset_closedCarrier_preimage_image
    (K : Set GammaTwoQuotient) :
    K ⊆ gammaTwoQuotientMk ''
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) := by
  intro x hx
  obtain ⟨z, rfl⟩ := gammaTwoQuotientMk_isOpenQuotientMap.surjective x
  obtain ⟨a, ha⟩ := gammaTwoClosedTileCarrier_orbit_covers z
  refine ⟨a • z, ⟨ha, ?_⟩, ?_⟩
  · change gammaTwoQuotientMk (a • z) ∈ K
    simpa only [gammaTwoQuotientMk_smul] using hx
  · exact gammaTwoQuotientMk_smul a z

/-- The compact finite-tile truncations capture every compact quotient set,
with no remaining geometric-properness hypothesis. -/
theorem gammaTwoGeometricCompactCofinal_unconditional :
    GammaTwoGeometricCompactCofinal := by
  intro K hK
  have hPre : IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) :=
    gammaTwoClosedCarrier_inter_preimage_isCompact K hK
  obtain ⟨Y, hY, hSub⟩ :=
    compact_closedTileCarrier_subset_geometricTruncation hPre
      Set.inter_subset_left
  exact ⟨Y, hY,
    (quotientSet_subset_closedCarrier_preimage_image K).trans
      (Set.image_mono hSub)⟩

/-- The literal simultaneous three-cusp truncations capture every compact
quotient set, again without a certificate argument. -/
theorem gammaTwoThreeCuspCompactCofinal_unconditional :
    GammaTwoThreeCuspCompactCofinal := by
  intro K hK
  have hPre : IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) :=
    gammaTwoClosedCarrier_inter_preimage_isCompact K hK
  obtain ⟨Y, hY, hSub⟩ :=
    compact_closedTileCarrier_subset_threeCuspTruncation hPre
      Set.inter_subset_left
  exact ⟨Y, hY,
    (quotientSet_subset_closedCarrier_preimage_image K).trans
      (Set.image_mono hSub)⟩

/-- A compact lift of the `n`-th fixed compact quotient stage. -/
noncomputable def gammaTwoCompactLiftStage (n : ℕ) : Set ℍ :=
  Classical.choose
    (compact_has_compact_upstairs_lift
      (gammaTwoQuotientCompactExhaustion_isCompact n))

theorem gammaTwoCompactLiftStage_isCompact (n : ℕ) :
    IsCompact (gammaTwoCompactLiftStage n) :=
  (Classical.choose_spec
    (compact_has_compact_upstairs_lift
      (gammaTwoQuotientCompactExhaustion_isCompact n))).1

theorem gammaTwoQuotientCompactStage_subset_lift_image (n : ℕ) :
    gammaTwoQuotientCompactExhaustion n ⊆
      gammaTwoQuotientMk '' gammaTwoCompactLiftStage n :=
  (Classical.choose_spec
    (compact_has_compact_upstairs_lift
      (gammaTwoQuotientCompactExhaustion_isCompact n))).2

/-- Accumulate the chosen compact lifts so that the upstairs stages are
monotone as actual sets. -/
noncomputable def gammaTwoCompactLiftExhaustion : ℕ → Set ℍ
  | 0 => gammaTwoCompactLiftStage 0
  | n + 1 =>
      gammaTwoCompactLiftExhaustion n ∪ gammaTwoCompactLiftStage (n + 1)

theorem gammaTwoCompactLiftExhaustion_isCompact (n : ℕ) :
    IsCompact (gammaTwoCompactLiftExhaustion n) := by
  induction n with
  | zero =>
      simpa [gammaTwoCompactLiftExhaustion] using
        gammaTwoCompactLiftStage_isCompact 0
  | succ n ih =>
      simpa [gammaTwoCompactLiftExhaustion] using
        ih.union (gammaTwoCompactLiftStage_isCompact (n + 1))

theorem gammaTwoCompactLiftStage_subset_exhaustion (n : ℕ) :
    gammaTwoCompactLiftStage n ⊆ gammaTwoCompactLiftExhaustion n := by
  cases n with
  | zero =>
      exact Set.Subset.rfl
  | succ n =>
      simpa [gammaTwoCompactLiftExhaustion] using
        (Set.subset_union_right :
          gammaTwoCompactLiftStage (n + 1) ⊆
            gammaTwoCompactLiftExhaustion n ∪
              gammaTwoCompactLiftStage (n + 1))

theorem gammaTwoCompactLiftExhaustion_subset_succ (n : ℕ) :
    gammaTwoCompactLiftExhaustion n ⊆
      gammaTwoCompactLiftExhaustion (n + 1) := by
  simpa [gammaTwoCompactLiftExhaustion] using
    (Set.subset_union_left :
      gammaTwoCompactLiftExhaustion n ⊆
        gammaTwoCompactLiftExhaustion n ∪ gammaTwoCompactLiftStage (n + 1))

theorem gammaTwoCompactLiftExhaustion_monotone :
    Monotone gammaTwoCompactLiftExhaustion :=
  monotone_nat_of_le_succ gammaTwoCompactLiftExhaustion_subset_succ

theorem gammaTwoQuotientCompactStage_subset_liftExhaustion_image
    (n : ℕ) :
    gammaTwoQuotientCompactExhaustion n ⊆
      gammaTwoQuotientMk '' gammaTwoCompactLiftExhaustion n :=
  (gammaTwoQuotientCompactStage_subset_lift_image n).trans
    (Set.image_mono (gammaTwoCompactLiftStage_subset_exhaustion n))

/-- A real-height indexing of the concrete compact lifts.  Negative heights
simply select stage zero; the support theorem below always produces a height
strictly larger than one. -/
noncomputable def gammaTwoTopologicalTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoCompactLiftExhaustion ⌊Y⌋₊

theorem gammaTwoTopologicalTruncation_isCompact (Y : ℝ) :
    IsCompact (gammaTwoTopologicalTruncation Y) :=
  gammaTwoCompactLiftExhaustion_isCompact ⌊Y⌋₊

theorem gammaTwoTopologicalTruncation_measurable (Y : ℝ) :
    MeasurableSet (gammaTwoTopologicalTruncation Y) :=
  (gammaTwoTopologicalTruncation_isCompact Y).isClosed.measurableSet

theorem gammaTwoTopologicalTruncation_monotone :
    Monotone gammaTwoTopologicalTruncation := by
  intro Y Z hYZ
  exact gammaTwoCompactLiftExhaustion_monotone (Nat.floor_mono hYZ)

theorem gammaTwoTopologicalTruncation_relativelyCompact (Y : ℝ) :
    IsCompact (closure (gammaTwoTopologicalTruncation Y)) :=
  (gammaTwoTopologicalTruncation_isCompact Y).closure

/-- The concrete real-indexed truncations cover every compact quotient set. -/
theorem gammaTwoTopologicalTruncation_exhausts_compacts
    (K : Set GammaTwoQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ gammaTwoQuotientMk '' gammaTwoTopologicalTruncation Y := by
  obtain ⟨n, hn⟩ := compact_subset_gammaTwoQuotientCompactExhaustion hK
  refine ⟨((n + 2 : ℕ) : ℝ), ?_, ?_⟩
  · exact_mod_cast (show (1 : ℕ) < n + 2 by omega)
  · have hstage :=
      gammaTwoQuotientCompactStage_subset_liftExhaustion_image n
    have hmono : gammaTwoCompactLiftExhaustion n ⊆
        gammaTwoCompactLiftExhaustion (n + 2) :=
      gammaTwoCompactLiftExhaustion_monotone (by omega)
    change K ⊆ gammaTwoQuotientMk ''
      gammaTwoCompactLiftExhaustion ⌊(((n + 2 : ℕ) : ℝ))⌋₊
    rw [Nat.floor_natCast]
    exact hn.trans (hstage.trans (Set.image_mono hmono))

/-! ##### Augmented global cusp-representative truncation

The literal `gammaTwoThreeCuspTruncation` is now known to capture arbitrary
compact quotient sets by the proper-reduction theorem above.  We retain the
older augmented family as a useful second exhaustion: it adjoins an explicit
compact lift stage to the geometric cusp core.  The adjoined component is not
claimed to lie in the closed carrier; each augmented stage is nevertheless
compact and height-controlled.
-/

/-- Geometric cusp core plus a compact global quotient-representative
supplement. -/
noncomputable def gammaTwoGlobalCuspTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoThreeCuspTruncation Y ∪ gammaTwoTopologicalTruncation Y

theorem gammaTwoThreeCuspTruncation_subset_global (Y : ℝ) :
    gammaTwoThreeCuspTruncation Y ⊆ gammaTwoGlobalCuspTruncation Y := by
  intro z hz
  exact Or.inl hz

theorem gammaTwoTopologicalTruncation_subset_global (Y : ℝ) :
    gammaTwoTopologicalTruncation Y ⊆ gammaTwoGlobalCuspTruncation Y := by
  intro z hz
  exact Or.inr hz

theorem gammaTwoGlobalCuspTruncation_isCompact (Y : ℝ) :
    IsCompact (gammaTwoGlobalCuspTruncation Y) :=
  (gammaTwoThreeCuspTruncation_isCompact Y).union
    (gammaTwoTopologicalTruncation_isCompact Y)

theorem gammaTwoGlobalCuspTruncation_measurable (Y : ℝ) :
    MeasurableSet (gammaTwoGlobalCuspTruncation Y) :=
  (gammaTwoGlobalCuspTruncation_isCompact Y).isClosed.measurableSet

theorem gammaTwoGlobalCuspTruncation_monotone :
    Monotone gammaTwoGlobalCuspTruncation := by
  intro Y Z hYZ
  exact Set.union_subset_union
    (gammaTwoThreeCuspTruncation_monotone hYZ)
    (gammaTwoTopologicalTruncation_monotone hYZ)

theorem gammaTwoGlobalCuspTruncation_relativelyCompact (Y : ℝ) :
    IsCompact (closure (gammaTwoGlobalCuspTruncation Y)) :=
  (gammaTwoGlobalCuspTruncation_isCompact Y).closure

/-- Although the supplemental representatives need not belong to the chosen
closed carrier, compactness gives one finite bound for every selected cusp
height on the whole augmented stage. -/
theorem gammaTwoGlobalCuspTruncation_heightControlled (Y : ℝ) :
    ∃ Z : ℝ, 1 < Z ∧
      gammaTwoGlobalCuspTruncation Y ⊆
        gammaTwoThreeCuspHeightSublevel Z :=
  compact_subset_threeCuspHeightSublevel
    (gammaTwoGlobalCuspTruncation_isCompact Y)

/-- Uniform capture of arbitrary compact quotient sets, with no geometric
certificate parameter. -/
theorem gammaTwoGlobalCuspTruncation_exhausts_compacts
    (K : Set GammaTwoQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ gammaTwoQuotientMk '' gammaTwoGlobalCuspTruncation Y := by
  obtain ⟨Y, hY, hKY⟩ :=
    gammaTwoTopologicalTruncation_exhausts_compacts K hK
  exact ⟨Y, hY,
    hKY.trans (Set.image_mono
      (gammaTwoTopologicalTruncation_subset_global Y))⟩

/-- Correct pointwise-orbit truncation interface.  Unlike the measured open
fundamental-domain interface below, this structure does not require all
representatives to lie in a carrier that omits a null boundary. -/
structure GammaTwoOrbitTruncationExhaustion where
  truncation : ℝ → Set ℍ
  measurable : ∀ Y, MeasurableSet (truncation Y)
  monotone : Monotone truncation
  relativelyCompact : ∀ Y, IsCompact (closure (truncation Y))
  quotient_exhausts_compacts :
    ∀ K : Set GammaTwoQuotient, IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧ K ⊆ gammaTwoQuotientMk '' truncation Y

/-- A concrete inhabitant of the corrected orbit-truncation interface. -/
noncomputable def chosenGammaTwoOrbitTruncationExhaustion :
    GammaTwoOrbitTruncationExhaustion where
  truncation := gammaTwoTopologicalTruncation
  measurable := gammaTwoTopologicalTruncation_measurable
  monotone := gammaTwoTopologicalTruncation_monotone
  relativelyCompact := gammaTwoTopologicalTruncation_relativelyCompact
  quotient_exhausts_compacts :=
    gammaTwoTopologicalTruncation_exhausts_compacts

/-- A second concrete orbit-truncation package retaining the literal
geometric cusp truncation as a distinguished subset of every stage. -/
noncomputable def chosenGammaTwoGlobalCuspTruncationExhaustion :
    GammaTwoOrbitTruncationExhaustion where
  truncation := gammaTwoGlobalCuspTruncation
  measurable := gammaTwoGlobalCuspTruncation_measurable
  monotone := gammaTwoGlobalCuspTruncation_monotone
  relativelyCompact := gammaTwoGlobalCuspTruncation_relativelyCompact
  quotient_exhausts_compacts :=
    gammaTwoGlobalCuspTruncation_exhausts_compacts

end GammaTwoQuotientGeometry

/-! ### 6.4: the real-smooth quotient-compact core

The existing manifold instance on `ℍ` is complex.  Using `CMDiff` for the
paper's smooth Maass-type functions would therefore impose holomorphicity and
would collapse a compactly supported core.  We use the same open chart with
the real model `ℂ ≃ ℝ²` and define genuine real `C∞` smoothness.
-/

namespace SmoothCompactCoreGeometry

open MeasureTheory Set Function Topology
open scoped Manifold ContDiff
open HalfIntegralMultiplier GammaTwoQuotientGeometry

/-- Pull a function back to the open upper half-plane chart in `ℂ`. -/
noncomputable def upperLift (u : ℍ → ℂ) : ℂ → ℂ :=
  u ∘ UpperHalfPlane.ofComplex

@[simp]
theorem upperLift_apply (u : ℍ → ℂ) (z : ℍ) :
    upperLift u (z : ℂ) = u z := by
  simp [upperLift, Function.comp_def]

/-- Real `C∞` smoothness, as opposed to complex analyticity. -/
def RealSmooth (u : ℍ → ℂ) : Prop :=
  ContDiffOn ℝ ∞ (upperLift u) UpperHalfPlane.upperHalfPlaneSet

theorem realSmooth_zero : RealSmooth (0 : ℍ → ℂ) := by
  simpa [RealSmooth, upperLift, Function.comp_def] using
    (contDiffOn_const : ContDiffOn ℝ ∞
      (fun _ : ℂ => (0 : ℂ)) UpperHalfPlane.upperHalfPlaneSet)

namespace RealSmooth

theorem add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v) :
    RealSmooth (u + v) := by
  unfold RealSmooth at hu hv ⊢
  simpa [upperLift, Function.comp_def] using hu.add hv

theorem neg {u : ℍ → ℂ} (hu : RealSmooth u) :
    RealSmooth (-u) := by
  unfold RealSmooth at hu ⊢
  simpa [upperLift, Function.comp_def] using hu.neg

theorem sub {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v) :
    RealSmooth (u - v) := by
  unfold RealSmooth at hu hv ⊢
  simpa [upperLift, Function.comp_def] using hu.sub hv

/-- Fixed complex multiplication is real-linear and real-smooth. -/
theorem const_complex_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u) :
    RealSmooth (c • u) := by
  unfold RealSmooth at hu ⊢
  simpa [upperLift, Function.comp_def] using hu.const_smul c

theorem continuous {u : ℍ → ℂ} (hu : RealSmooth u) : Continuous u := by
  rw [continuous_iff_continuousAt]
  intro z
  unfold RealSmooth at hu
  have hWithin := (hu (z : ℂ) z.im_pos).continuousWithinAt
  have hAt : ContinuousAt (upperLift u) (z : ℂ) :=
    hWithin.continuousAt
      (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos)
  have hcomp := hAt.comp' UpperHalfPlane.continuous_coe.continuousAt
  simpa [upperLift, Function.comp_def] using hcomp

theorem measurable {u : ℍ → ℂ} (hu : RealSmooth u) : Measurable u :=
  hu.continuous.measurable

end RealSmooth

/-- Topological support on the quotient.  The closure is important: it is the
downstairs analogue of `tsupport`, and it makes compact support stable under
addition and scalar multiplication. -/
def quotientTSupport (u : ℍ → ℂ) : Set GammaTwoQuotient :=
  closure (gammaTwoQuotientMk '' Function.support u)

/-- A lifted automorphic function is compactly supported modulo `Gamma(2)`. -/
def HasQuotientCompactSupport (u : ℍ → ℂ) : Prop :=
  IsCompact (quotientTSupport u)

@[simp]
theorem quotientTSupport_zero :
    quotientTSupport (0 : ℍ → ℂ) = ∅ := by
  simp [quotientTSupport]

theorem quotientTSupport_add_subset (u v : ℍ → ℂ) :
    quotientTSupport (u + v) ⊆ quotientTSupport u ∪ quotientTSupport v := by
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    rcases Function.support_add u v hz with hz | hz
    · exact Or.inl (subset_closure ⟨z, hz, rfl⟩)
    · exact Or.inr (subset_closure ⟨z, hz, rfl⟩)
  · exact isClosed_closure.union isClosed_closure

theorem quotientTSupport_smul_subset (c : ℂ) (u : ℍ → ℂ) :
    quotientTSupport (c • u) ⊆ quotientTSupport u := by
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    exact subset_closure
      ⟨z, Function.support_const_smul_subset c u hz, rfl⟩
  · exact isClosed_closure

/-- Multiplication by an arbitrary second factor cannot enlarge quotient
support.  No automorphy or regularity of the second factor is needed. -/
theorem quotientTSupport_mul_subset_left_general (u v : ℍ → ℂ) :
    quotientTSupport (u * v) ⊆ quotientTSupport u := by
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    exact subset_closure
      ⟨z, Function.support_mul_subset_left u v hz, rfl⟩
  · exact isClosed_closure

namespace HasQuotientCompactSupport

theorem zero : HasQuotientCompactSupport (0 : ℍ → ℂ) := by
  simp [HasQuotientCompactSupport]

theorem add {u v : ℍ → ℂ}
    (hu : HasQuotientCompactSupport u)
    (hv : HasQuotientCompactSupport v) :
    HasQuotientCompactSupport (u + v) :=
  (hu.union hv).of_isClosed_subset isClosed_closure
    (quotientTSupport_add_subset u v)

theorem smul (c : ℂ) {u : ℍ → ℂ}
    (hu : HasQuotientCompactSupport u) :
    HasQuotientCompactSupport (c • u) :=
  hu.of_isClosed_subset isClosed_closure
    (quotientTSupport_smul_subset c u)

/-- A quotient-compact first factor makes its product with any function
quotient-compact. -/
theorem mul_right {u : ℍ → ℂ}
    (hu : HasQuotientCompactSupport u) (v : ℍ → ℂ) :
    HasQuotientCompactSupport (u * v) :=
  hu.of_isClosed_subset isClosed_closure
    (quotientTSupport_mul_subset_left_general u v)

end HasQuotientCompactSupport

/-- The smooth quotient-compact core for an arbitrary integer-index
half-integral multiplier on `Gamma(2)`.  It can be used at the shifted weights
of a raising/lowering tower; the paper-specific core below is its weight-one
specialization with an action-kernel certificate. -/
def smoothCompactWeightCoreSubmodule {k : ℤ}
    (M : HalfIntegralMultiplier GammaTwo k) :
    Submodule ℂ (WeightSection M) where
  carrier := {u |
    RealSmooth (u : ℍ → ℂ) ∧
      HasQuotientCompactSupport (u : ℍ → ℂ)}
  zero_mem' := by
    constructor
    · change RealSmooth (0 : ℍ → ℂ)
      exact realSmooth_zero
    · change HasQuotientCompactSupport (0 : ℍ → ℂ)
      exact HasQuotientCompactSupport.zero
  add_mem' := by
    rintro u v ⟨hu, hqu⟩ ⟨hv, hqv⟩
    constructor
    · change RealSmooth ((u : ℍ → ℂ) + (v : ℍ → ℂ))
      exact hu.add hv
    · change HasQuotientCompactSupport ((u : ℍ → ℂ) + (v : ℍ → ℂ))
      exact hqu.add hqv
  smul_mem' := by
    rintro c u ⟨hu, hqu⟩
    constructor
    · change RealSmooth (c • (u : ℍ → ℂ))
      exact hu.const_complex_smul c
    · change HasQuotientCompactSupport (c • (u : ℍ → ℂ))
      exact hqu.smul c

abbrev SmoothCompactWeightCore {k : ℤ}
    (M : HalfIntegralMultiplier GammaTwo k) :=
  smoothCompactWeightCoreSubmodule M

namespace SmoothCompactWeightCore

variable {k : ℤ} {M : HalfIntegralMultiplier GammaTwo k}

def toSection (u : SmoothCompactWeightCore M) : WeightSection M :=
  u.1

instance : Coe (SmoothCompactWeightCore M) (WeightSection M) :=
  ⟨toSection⟩

theorem realSmooth (u : SmoothCompactWeightCore M) :
    RealSmooth (toSection u : ℍ → ℂ) :=
  u.2.1

theorem quotientCompact (u : SmoothCompactWeightCore M) :
    HasQuotientCompactSupport (toSection u : ℍ → ℂ) :=
  u.2.2

theorem covariance (u : SmoothCompactWeightCore M)
    (γ : GammaTwo) (z : ℍ) :
    toSection u (γ • z) = M.factor γ z * toSection u z :=
  WeightSection.covariance (toSection u) γ z

theorem continuous (u : SmoothCompactWeightCore M) :
    Continuous (toSection u : ℍ → ℂ) :=
  (realSmooth u).continuous

theorem measurable (u : SmoothCompactWeightCore M) :
    Measurable (toSection u : ℍ → ℂ) :=
  (continuous u).measurable

@[simp]
theorem zero_apply (z : ℍ) :
    toSection (0 : SmoothCompactWeightCore M) z = 0 :=
  rfl

@[simp]
theorem add_apply (u v : SmoothCompactWeightCore M) (z : ℍ) :
    toSection (u + v) z = toSection u z + toSection v z :=
  rfl

@[simp]
theorem smul_apply (c : ℂ) (u : SmoothCompactWeightCore M) (z : ℍ) :
    toSection (c • u) z = c * toSection u z :=
  rfl

@[ext]
theorem ext {u v : SmoothCompactWeightCore M}
    (h : ∀ z, toSection u z = toSection v z) : u = v := by
  apply Subtype.ext
  exact WeightSection.ext_apply h

end SmoothCompactWeightCore

/-- The exact `C_c∞(Gamma(2)\ℍ, ν)` core.  Automorphy is carried by
`WeightSection`; the two additional conjuncts are real smoothness and compact
support on the effective quotient. -/
def smoothCompactCoreSubmodule (P : PaperHalfWeightCertificate) :
    Submodule ℂ (WeightSection P.multiplier) where
  carrier := {u |
    RealSmooth (u : ℍ → ℂ) ∧
      HasQuotientCompactSupport (u : ℍ → ℂ)}
  zero_mem' := by
    constructor
    · change RealSmooth (0 : ℍ → ℂ)
      exact realSmooth_zero
    · change HasQuotientCompactSupport (0 : ℍ → ℂ)
      exact HasQuotientCompactSupport.zero
  add_mem' := by
    rintro u v ⟨hu, hqu⟩ ⟨hv, hqv⟩
    constructor
    · change RealSmooth ((u : ℍ → ℂ) + (v : ℍ → ℂ))
      exact hu.add hv
    · change HasQuotientCompactSupport ((u : ℍ → ℂ) + (v : ℍ → ℂ))
      exact hqu.add hqv
  smul_mem' := by
    rintro c u ⟨hu, hqu⟩
    constructor
    · change RealSmooth (c • (u : ℍ → ℂ))
      exact hu.const_complex_smul c
    · change HasQuotientCompactSupport (c • (u : ℍ → ℂ))
      exact hqu.smul c

/-- The paper's compactly supported real-smooth automorphic core. -/
abbrev SmoothCompactCore (P : PaperHalfWeightCertificate) :=
  smoothCompactCoreSubmodule P

namespace SmoothCompactCore

variable {P : PaperHalfWeightCertificate}

/-- Forget smoothness and support, retaining the covariant section. -/
def toSection (u : SmoothCompactCore P) : WeightSection P.multiplier :=
  u.1

instance : Coe (SmoothCompactCore P) (WeightSection P.multiplier) :=
  ⟨toSection⟩

theorem realSmooth (u : SmoothCompactCore P) :
    RealSmooth (toSection u : ℍ → ℂ) :=
  u.2.1

theorem quotientCompact (u : SmoothCompactCore P) :
    HasQuotientCompactSupport (toSection u : ℍ → ℂ) :=
  u.2.2

theorem covariance (u : SmoothCompactCore P) (γ : GammaTwo) (z : ℍ) :
    toSection u (γ • z) =
      P.multiplier.factor γ z * toSection u z :=
  WeightSection.covariance (toSection u) γ z

theorem continuous (u : SmoothCompactCore P) :
    Continuous (toSection u : ℍ → ℂ) :=
  (realSmooth u).continuous

theorem measurable (u : SmoothCompactCore P) :
    Measurable (toSection u : ℍ → ℂ) :=
  (continuous u).measurable

@[ext]
theorem ext {u v : SmoothCompactCore P}
    (h : ∀ z, toSection u z = toSection v z) : u = v := by
  apply Subtype.ext
  exact WeightSection.ext_apply h

@[simp]
theorem zero_apply (z : ℍ) :
    toSection (0 : SmoothCompactCore P) z = 0 :=
  rfl

@[simp]
theorem add_apply (u v : SmoothCompactCore P) (z : ℍ) :
    toSection (u + v) z = toSection u z + toSection v z :=
  rfl

@[simp]
theorem smul_apply (c : ℂ) (u : SmoothCompactCore P) (z : ℍ) :
    toSection (c • u) z = c * toSection u z :=
  rfl

end SmoothCompactCore

/-! #### Scalar trivialization by the nowhere-zero inverse-eta section -/

/-- Divide a concrete inverse-eta covariant section by the fixed nowhere-zero
inverse-eta section.  The result has weight zero. -/
noncomputable def inverseEtaRatio
    (u : SmoothCompactCore inverseEtaPaperCertificate) : ℍ → ℂ :=
  fun z ↦ SmoothCompactCore.toSection u z / inverseEtaSection z

/-- The fixed inverse-eta section is continuous on the upper half-plane. -/
theorem continuous_inverseEtaSection :
    Continuous (inverseEtaSection : ℍ → ℂ) := by
  change Continuous (fun z : ℍ ↦
    (ModularForm.eta (z : ℂ))⁻¹)
  exact continuous_eta_upperHalfPlane.inv₀
    (fun z ↦ ModularForm.eta_ne_zero z.2)

/-- Scalar trivialization preserves continuity. -/
theorem inverseEtaRatio_continuous
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    Continuous (inverseEtaRatio u) := by
  unfold inverseEtaRatio
  exact (SmoothCompactCore.continuous u).div continuous_inverseEtaSection
    inverseEtaSection_apply_ne_zero

/-- Division by a nowhere-zero section preserves support exactly. -/
theorem inverseEtaRatio_support
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    Function.support (inverseEtaRatio u) =
      Function.support (SmoothCompactCore.toSection u : ℍ → ℂ) := by
  ext z
  simp only [Function.mem_support, inverseEtaRatio, div_ne_zero_iff]
  constructor
  · exact And.left
  · intro hz
    exact ⟨hz, inverseEtaSection_apply_ne_zero z⟩

/-- The quotient scalar is invariant under every effective `Gamma(2)` action. -/
theorem inverseEtaRatio_effective_invariant
    (u : SmoothCompactCore inverseEtaPaperCertificate)
    (g : GammaTwoEffective) (z : ℍ) :
    inverseEtaRatio u (g • z) = inverseEtaRatio u z := by
  rcases effective_exists_gamma g with ⟨γ, hγ⟩
  unfold inverseEtaRatio
  rw [hγ z, SmoothCompactCore.covariance u γ z]
  change
    inverseEtaPaperCertificate.multiplier.factor γ z *
          SmoothCompactCore.toSection u z /
        ((inverseEtaSection : ℍ → ℂ) ((γ : SL(2, ℤ)) • z)) =
      SmoothCompactCore.toSection u z /
        ((inverseEtaSection : ℍ → ℂ) z)
  rw [WeightSection.covariance inverseEtaSection γ z]
  exact mul_div_mul_left _ _
    (inverseEtaPaperCertificate.multiplier.factor_ne_zero γ z)

/-- The invariant ratio descended to the effective orbit quotient. -/
noncomputable def inverseEtaRatioQuotient
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    GammaTwoQuotient → ℂ :=
  descendInvariant (inverseEtaRatio u)
    (inverseEtaRatio_effective_invariant u)

@[simp]
theorem inverseEtaRatioQuotient_mk
    (u : SmoothCompactCore inverseEtaPaperCertificate) (z : ℍ) :
    inverseEtaRatioQuotient u (gammaTwoQuotientMk z) =
      inverseEtaRatio u z :=
  rfl

/-- Quotient continuity follows from the quotient topology, with no choice of
orbit representatives. -/
theorem inverseEtaRatioQuotient_continuous
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    Continuous (inverseEtaRatioQuotient u) := by
  unfold inverseEtaRatioQuotient
    GammaTwoQuotientGeometry.descendInvariant
  exact (inverseEtaRatio_continuous u).quotient_lift _

/-- Before using nowhere-vanishing, support downstairs is precisely the image
of support of the invariant ratio. -/
theorem inverseEtaRatioQuotient_support_raw
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    Function.support (inverseEtaRatioQuotient u) =
      gammaTwoQuotientMk '' Function.support (inverseEtaRatio u) := by
  ext q
  induction q using Quotient.inductionOn'
  constructor
  · intro hz
    refine ⟨_, ?_, rfl⟩
    change inverseEtaRatio u _ ≠ 0 at hz
    exact hz
  · rintro ⟨w, hw, hEq⟩
    change inverseEtaRatio u w ≠ 0 at hw
    have hw' : inverseEtaRatioQuotient u
        (gammaTwoQuotientMk w) ≠ 0 := by
      change inverseEtaRatio u w ≠ 0
      exact hw
    rwa [hEq] at hw'

/-- Hence support downstairs is exactly the projected support of the original
covariant section. -/
theorem inverseEtaRatioQuotient_support
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    Function.support (inverseEtaRatioQuotient u) =
      gammaTwoQuotientMk ''
        Function.support (SmoothCompactCore.toSection u : ℍ → ℂ) := by
  rw [inverseEtaRatioQuotient_support_raw, inverseEtaRatio_support]

/-- Exact topological-support identity needed for compact support. -/
theorem inverseEtaRatioQuotient_tsupport
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    tsupport (inverseEtaRatioQuotient u) =
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) := by
  rw [tsupport, quotientTSupport, inverseEtaRatioQuotient_support]

/-- Compact quotient support of `u` becomes ordinary compact support of its
scalar trivialization. -/
theorem inverseEtaRatioQuotient_hasCompactSupport
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    HasCompactSupport (inverseEtaRatioQuotient u) := by
  change IsCompact (tsupport (inverseEtaRatioQuotient u))
  rw [inverseEtaRatioQuotient_tsupport]
  exact SmoothCompactCore.quotientCompact u

/-- The scalar trivialization as an actual compactly supported continuous map. -/
noncomputable def inverseEtaQuotientScalar
    (u : SmoothCompactCore inverseEtaPaperCertificate) :
    CompactlySupportedContinuousMap GammaTwoQuotient ℂ where
  toFun := inverseEtaRatioQuotient u
  continuous_toFun := inverseEtaRatioQuotient_continuous u
  hasCompactSupport' := inverseEtaRatioQuotient_hasCompactSupport u

@[simp]
theorem inverseEtaQuotientScalar_mk
    (u : SmoothCompactCore inverseEtaPaperCertificate) (z : ℍ) :
    inverseEtaQuotientScalar u (gammaTwoQuotientMk z) =
      SmoothCompactCore.toSection u z / inverseEtaSection z :=
  rfl

/-- Division by the fixed inverse-eta section is complex-linear. -/
noncomputable def inverseEtaQuotientLinear :
    SmoothCompactCore inverseEtaPaperCertificate →ₗ[ℂ]
      CompactlySupportedContinuousMap GammaTwoQuotient ℂ where
  toFun := inverseEtaQuotientScalar
  map_add' u v := by
    apply CompactlySupportedContinuousMap.ext
    intro q
    induction q using Quotient.inductionOn'
    change
      SmoothCompactCore.toSection (u + v) _ / inverseEtaSection _ =
        SmoothCompactCore.toSection u _ / inverseEtaSection _ +
          SmoothCompactCore.toSection v _ / inverseEtaSection _
    rw [SmoothCompactCore.add_apply, add_div]
  map_smul' c u := by
    apply CompactlySupportedContinuousMap.ext
    intro q
    induction q using Quotient.inductionOn'
    change
      SmoothCompactCore.toSection (c • u) _ / inverseEtaSection _ =
        c * (SmoothCompactCore.toSection u _ / inverseEtaSection _)
    rw [SmoothCompactCore.smul_apply]
    ring

@[simp]
theorem inverseEtaQuotientLinear_mk
    (u : SmoothCompactCore inverseEtaPaperCertificate) (z : ℍ) :
    inverseEtaQuotientLinear u (gammaTwoQuotientMk z) =
      SmoothCompactCore.toSection u z / inverseEtaSection z :=
  rfl

/-- The quotient scalar model is faithful because the trivializing section is
nowhere zero and every quotient point has an upstairs representative. -/
theorem inverseEtaQuotientLinear_injective :
    Function.Injective inverseEtaQuotientLinear := by
  intro u v huv
  apply SmoothCompactCore.ext
  intro z
  have hz :
      SmoothCompactCore.toSection u z / inverseEtaSection z =
        SmoothCompactCore.toSection v z / inverseEtaSection z := by
    simpa only [inverseEtaQuotientLinear_mk] using
      congrArg
        (fun f : CompactlySupportedContinuousMap GammaTwoQuotient ℂ ↦
          f (gammaTwoQuotientMk z)) huv
  exact (div_left_inj'
    (inverseEtaSection_apply_ne_zero z)).mp hz

/-! #### Canonical quotient-level compact stages

These stages are unconditional consequences of the topology of the orbit
quotient.  They do not choose representatives inside a fundamental-domain
cusp truncation; that strictly stronger geometric task remains separated
below.
-/

theorem HasQuotientCompactSupport.exists_compactExhaustion_stage
    {u : ℍ → ℂ} (hu : HasQuotientCompactSupport u) :
    ∃ n : ℕ, quotientTSupport u ⊆
      gammaTwoQuotientCompactExhaustion n := by
  change IsCompact (quotientTSupport u) at hu
  exact compact_subset_gammaTwoQuotientCompactExhaustion hu

theorem HasQuotientCompactSupport.exists_interior_compactExhaustion_stage
    {u : ℍ → ℂ} (hu : HasQuotientCompactSupport u) :
    ∃ n : ℕ, quotientTSupport u ⊆
      interior (gammaTwoQuotientCompactExhaustion n) := by
  obtain ⟨n, hn⟩ := hu.exists_compactExhaustion_stage
  exact ⟨n + 1, hn.trans
    (gammaTwoQuotientCompactExhaustion_subset_interior_succ n)⟩

theorem SmoothCompactCore.exists_quotientSupport_subset_compactStage
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ n : ℕ,
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientCompactExhaustion n :=
  HasQuotientCompactSupport.exists_compactExhaustion_stage
    (SmoothCompactCore.quotientCompact u)

theorem SmoothCompactCore.exists_quotientSupport_subset_interior_compactStage
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ n : ℕ,
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        interior (gammaTwoQuotientCompactExhaustion n) :=
  HasQuotientCompactSupport.exists_interior_compactExhaustion_stage
    (SmoothCompactCore.quotientCompact u)

/-- Generic transfer from a three-cusp compact-cofinality witness.  The
unconditional witness proved above is instantiated immediately below. -/
theorem SmoothCompactCore.exists_quotientSupport_subset_threeCuspTruncation_of_compactCofinal
    (hCofinal : GammaTwoThreeCuspCompactCofinal)
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y :=
  hCofinal _ (SmoothCompactCore.quotientCompact u)

/-- Equivalent pointwise support-orbit formulation of geometric cusp
capture. -/
theorem SmoothCompactCore.support_orbit_has_threeCuspTruncation_representative_of_compactCofinal
    (hCofinal : GammaTwoThreeCuspCompactCofinal)
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧ ∀ z : ℍ,
      SmoothCompactCore.toSection u z ≠ 0 →
        ∃ w : ℍ, w ∈ gammaTwoThreeCuspTruncation Y ∧
          gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  obtain ⟨Y, hY, hsub⟩ :=
    SmoothCompactCore.exists_quotientSupport_subset_threeCuspTruncation_of_compactCofinal
      hCofinal u
  refine ⟨Y, hY, fun z hz ↦ ?_⟩
  have hzq : gammaTwoQuotientMk z ∈
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) :=
    subset_closure ⟨z, hz, rfl⟩
  rcases hsub hzq with ⟨w, hw, hEq⟩
  exact ⟨w, hw, hEq⟩

/-- Unconditional literal three-cusp capture of every smooth
quotient-compact section. -/
theorem SmoothCompactCore.exists_quotientSupport_subset_threeCuspTruncation
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y :=
  SmoothCompactCore.exists_quotientSupport_subset_threeCuspTruncation_of_compactCofinal
    gammaTwoThreeCuspCompactCofinal_unconditional u

/-- Every nonzero support point has a representative in one fixed literal
three-cusp stage, uniformly over the whole section support. -/
theorem SmoothCompactCore.support_orbit_has_threeCuspTruncation_representative
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧ ∀ z : ℍ,
      SmoothCompactCore.toSection u z ≠ 0 →
        ∃ w : ℍ, w ∈ gammaTwoThreeCuspTruncation Y ∧
          gammaTwoQuotientMk w = gammaTwoQuotientMk z :=
  SmoothCompactCore.support_orbit_has_threeCuspTruncation_representative_of_compactCofinal
    gammaTwoThreeCuspCompactCofinal_unconditional u

/-- All closed-polygon representatives of the quotient support lie in the
relative interior of one literal `F_Y`. -/
theorem SmoothCompactCore.exists_relativeQuotientSupport_subset_truncationInterior
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      gammaTwoRelativeQuotientPreimage
          (quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ)) ⊆
        interior (gammaTwoRelativeTruncation Y) :=
  compact_relativeQuotientPreimage_subset_truncationInterior _
    (SmoothCompactCore.quotientCompact u)

/-- Unconditional compact-support capture by the honest augmented global
cusp-representative truncation.  Its first component is the literal geometric
`F_Y`; its second component is the compact quotient-lift supplement described
in `gammaTwoGlobalCuspTruncation`. -/
theorem SmoothCompactCore.exists_quotientSupport_subset_globalCuspTruncation
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientMk '' gammaTwoGlobalCuspTruncation Y :=
  gammaTwoGlobalCuspTruncation_exhausts_compacts _
    (SmoothCompactCore.quotientCompact u)

theorem SmoothCompactCore.support_orbit_has_globalCuspTruncation_representative
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧ ∀ z : ℍ,
      SmoothCompactCore.toSection u z ≠ 0 →
      ∃ w : ℍ, w ∈ gammaTwoGlobalCuspTruncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  obtain ⟨Y, hY, hsub⟩ :=
    SmoothCompactCore.exists_quotientSupport_subset_globalCuspTruncation u
  refine ⟨Y, hY, fun z hz ↦ ?_⟩
  have hzq : gammaTwoQuotientMk z ∈
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) :=
    subset_closure ⟨z, hz, rfl⟩
  rcases hsub hzq with ⟨w, hw, hEq⟩
  exact ⟨w, hw, hEq⟩

/-! #### The invariant norm density on the quotient -/

/-- The canonical invariant squared fiber norm associated to the paper's
displayed covariance. -/
noncomputable def pointwiseNormDensity (P : PaperHalfWeightCertificate)
    (u : WeightSection P.multiplier) : ℍ → ℝ :=
  P.fiberMetric.pointwiseNormSq u

theorem pointwiseNormDensity_effective_invariant
    (P : PaperHalfWeightCertificate) (u : WeightSection P.multiplier)
    (g : GammaTwoEffective) (z : ℍ) :
    pointwiseNormDensity P u (g • z) = pointwiseNormDensity P u z := by
  rcases effective_exists_gamma g with ⟨γ, hγ⟩
  rw [hγ z]
  exact P.fiberMetric.pointwiseNormSq_smul u γ z

/-- The invariant squared norm descended to the effective quotient. -/
noncomputable def quotientNormSq (P : PaperHalfWeightCertificate)
    (u : WeightSection P.multiplier) : GammaTwoQuotient → ℝ :=
  descendInvariant (pointwiseNormDensity P u)
    (pointwiseNormDensity_effective_invariant P u)

@[simp]
theorem quotientNormSq_mk (P : PaperHalfWeightCertificate)
    (u : WeightSection P.multiplier) (z : ℍ) :
    quotientNormSq P u (gammaTwoQuotientMk z) =
      pointwiseNormDensity P u z :=
  rfl

theorem continuous_halfWeightScale :
    Continuous HalfIntegralMultiplier.halfWeightScale := by
  exact (Real.continuous_sqrt.comp UpperHalfPlane.continuous_im).inv₀
    (fun z => ne_of_gt (Real.sqrt_pos.2 z.im_pos))

theorem pointwiseNormDensity_continuous (P : PaperHalfWeightCertificate)
    {u : WeightSection P.multiplier} (hu : Continuous (u : ℍ → ℂ)) :
    Continuous (pointwiseNormDensity P u) := by
  change Continuous (fun z =>
    HalfIntegralMultiplier.halfWeightScale z * ‖u z‖ ^ 2)
  exact continuous_halfWeightScale.mul (hu.norm.pow 2)

theorem quotientNormSq_continuous (P : PaperHalfWeightCertificate)
    {u : WeightSection P.multiplier} (hu : Continuous (u : ℍ → ℂ)) :
    Continuous (quotientNormSq P u) := by
  unfold quotientNormSq GammaTwoQuotientGeometry.descendInvariant
  exact (pointwiseNormDensity_continuous P hu).quotient_lift _

theorem pointwiseNormDensity_eq_zero_iff
    (P : PaperHalfWeightCertificate) (u : WeightSection P.multiplier)
    (z : ℍ) :
    pointwiseNormDensity P u z = 0 ↔ u z = 0 :=
  P.fiberMetric.pointwiseNormSq_eq_zero_iff u z

/-- The support of the descended density is exactly the projection of the
support of the section. -/
theorem quotientNormSq_support
    (P : PaperHalfWeightCertificate) (u : WeightSection P.multiplier) :
    Function.support (quotientNormSq P u) =
      gammaTwoQuotientMk '' Function.support (u : ℍ → ℂ) := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · intro hz
    refine ⟨z, ?_, rfl⟩
    change pointwiseNormDensity P u z ≠ 0 at hz
    exact (pointwiseNormDensity_eq_zero_iff P u z).not.mp hz
  · rintro ⟨w, hw, hEq⟩
    have hw' : quotientNormSq P u (gammaTwoQuotientMk w) ≠ 0 := by
      change pointwiseNormDensity P u w ≠ 0
      exact (pointwiseNormDensity_eq_zero_iff P u w).not.mpr hw
    rwa [hEq] at hw'

theorem quotientNormSq_tsupport
    (P : PaperHalfWeightCertificate) (u : WeightSection P.multiplier) :
    tsupport (quotientNormSq P u) = quotientTSupport (u : ℍ → ℂ) := by
  rw [tsupport, quotientTSupport, quotientNormSq_support]

theorem SmoothCompactCore.quotientNormSq_hasCompactSupport
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    HasCompactSupport
      (quotientNormSq P (SmoothCompactCore.toSection u)) := by
  change IsCompact
    (tsupport (quotientNormSq P (SmoothCompactCore.toSection u)))
  rw [quotientNormSq_tsupport]
  exact SmoothCompactCore.quotientCompact u

theorem SmoothCompactCore.quotientNormSq_integrable
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P)
    (D : GammaTwoFundamentalDomain) :
    Integrable (quotientNormSq P (SmoothCompactCore.toSection u))
      D.quotientMeasure := by
  exact
    (quotientNormSq_continuous P
      (SmoothCompactCore.continuous u)).integrable_of_hasCompactSupport
        (SmoothCompactCore.quotientNormSq_hasCompactSupport u)

/-- The invariant norm density is integrable on every regular certified
fundamental-domain realization. -/
theorem SmoothCompactCore.pointwiseNormDensity_integrableOn
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P)
    (D : GammaTwoFundamentalDomain) :
    IntegrableOn
      (pointwiseNormDensity P (SmoothCompactCore.toSection u))
      D.carrier hyperbolicMeasure := by
  have hq := SmoothCompactCore.quotientNormSq_integrable u D
  have hq' : Integrable
      (quotientNormSq P (SmoothCompactCore.toSection u))
      ((hyperbolicMeasure.restrict D.carrier).map gammaTwoQuotientMk) := by
    simpa [GammaTwoFundamentalDomain.quotientMeasure] using hq
  have hcomp := hq'.comp_aemeasurable
    (measurable_quotient_mk''.aemeasurable :
      AEMeasurable gammaTwoQuotientMk
        (hyperbolicMeasure.restrict D.carrier))
  change Integrable
    (pointwiseNormDensity P (SmoothCompactCore.toSection u))
    (hyperbolicMeasure.restrict D.carrier)
  simpa only [Function.comp_def, quotientNormSq_mk] using hcomp

/-- Quotient integration of the core density is exactly the paper-style
fundamental-domain integral. -/
theorem SmoothCompactCore.quotientIntegral_eq_fundamentalDomainIntegral
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P)
    (D : GammaTwoFundamentalDomain) :
    ∫ q, quotientNormSq P (SmoothCompactCore.toSection u) q
        ∂D.quotientMeasure =
      ∫ z in D.carrier,
        pointwiseNormDensity P (SmoothCompactCore.toSection u) z
        ∂hyperbolicMeasure := by
  exact D.integral_quotientMeasure_eq _
    (SmoothCompactCore.quotientNormSq_integrable u D).aestronglyMeasurable

/-! #### Literal geometric cusp-truncation exhaustion

A lifted nonzero automorphic section has support on every translate, so the
literal assertion `support u ⊆ F_Y` upstairs is false.  The correct statement
is that the quotient support lies in the projection of `F_Y`, equivalently
that every support orbit has a representative in `F_Y`.  Proper
discontinuity and the closed-carrier compact-preimage theorem proved above
now supply an unconditional inhabitant for the chosen closed polygon.
-/

/-- To cover every compact quotient set, it is enough to cover the fixed
canonical compact stages.  This is a reduction of the geometric obligation;
it does not itself choose representatives inside a fundamental domain. -/
theorem quotient_exhausts_compacts_of_compactStages
    (truncation : ℝ → Set ℍ) (stageHeight : ℕ → ℝ)
    (hHeight : ∀ n, 1 < stageHeight n)
    (hStage : ∀ n,
      gammaTwoQuotientCompactExhaustion n ⊆
        gammaTwoQuotientMk '' truncation (stageHeight n)) :
    ∀ K : Set GammaTwoQuotient, IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧
        K ⊆ gammaTwoQuotientMk '' truncation Y := by
  intro K hK
  obtain ⟨n, hn⟩ :=
    compact_subset_gammaTwoQuotientCompactExhaustion hK
  exact ⟨stageHeight n, hHeight n, hn.trans (hStage n)⟩

structure GammaTwoTruncationExhaustion
    (D : GammaTwoFundamentalDomain) where
  truncation : ℝ → Set ℍ
  subset_domain : ∀ Y, truncation Y ⊆ D.carrier
  measurable : ∀ Y, MeasurableSet (truncation Y)
  monotone : Monotone truncation
  relativelyCompact : ∀ Y, IsCompact (closure (truncation Y))
  quotient_exhausts_compacts :
    ∀ K : Set GammaTwoQuotient, IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧
        K ⊆ gammaTwoQuotientMk '' truncation Y

/-- Constructor whose only orbit-coverage obligation is stagewise coverage of
the fixed quotient compact exhaustion. -/
def GammaTwoTruncationExhaustion.ofCompactStages
    {D : GammaTwoFundamentalDomain}
    (truncation : ℝ → Set ℍ)
    (hSubsetDomain : ∀ Y, truncation Y ⊆ D.carrier)
    (hMeasurable : ∀ Y, MeasurableSet (truncation Y))
    (hMonotone : Monotone truncation)
    (hRelativelyCompact : ∀ Y, IsCompact (closure (truncation Y)))
    (stageHeight : ℕ → ℝ)
    (hHeight : ∀ n, 1 < stageHeight n)
    (hStage : ∀ n,
      gammaTwoQuotientCompactExhaustion n ⊆
        gammaTwoQuotientMk '' truncation (stageHeight n)) :
    GammaTwoTruncationExhaustion D where
  truncation := truncation
  subset_domain := hSubsetDomain
  measurable := hMeasurable
  monotone := hMonotone
  relativelyCompact := hRelativelyCompact
  quotient_exhausts_compacts :=
    quotient_exhausts_compacts_of_compactStages
      truncation stageHeight hHeight hStage

/-- The paper's literal three-cusp height truncations form an actual
exhaustion of the chosen closed fundamental polygon.  Every field is a proved
theorem: there is no compactness or representative-selection certificate. -/
noncomputable def chosenGammaTwoThreeCuspTruncationExhaustion :
    GammaTwoTruncationExhaustion chosenGammaTwoFundamentalDomain where
  truncation := gammaTwoThreeCuspTruncation
  subset_domain := gammaTwoThreeCuspTruncation_subset_chosenCarrier
  measurable := gammaTwoThreeCuspTruncation_measurable
  monotone := gammaTwoThreeCuspTruncation_monotone
  relativelyCompact := gammaTwoThreeCuspTruncation_relativelyCompact
  quotient_exhausts_compacts :=
    gammaTwoThreeCuspCompactCofinal_unconditional

@[simp]
theorem chosenGammaTwoThreeCuspTruncationExhaustion_truncation
    (Y : ℝ) :
    chosenGammaTwoThreeCuspTruncationExhaustion.truncation Y =
      gammaTwoThreeCuspTruncation Y :=
  rfl

theorem SmoothCompactCore.exists_quotientSupport_subset_truncation
    {P : PaperHalfWeightCertificate} {D : GammaTwoFundamentalDomain}
    (E : GammaTwoTruncationExhaustion D) (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientMk '' E.truncation Y :=
  E.quotient_exhausts_compacts _ (SmoothCompactCore.quotientCompact u)

theorem SmoothCompactCore.support_orbit_has_truncated_representative
    {P : PaperHalfWeightCertificate} {D : GammaTwoFundamentalDomain}
    (E : GammaTwoTruncationExhaustion D) (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧ ∀ z : ℍ,
      SmoothCompactCore.toSection u z ≠ 0 →
      ∃ w : ℍ, w ∈ E.truncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  obtain ⟨Y, hY, hsub⟩ :=
    SmoothCompactCore.exists_quotientSupport_subset_truncation E u
  refine ⟨Y, hY, fun z hz => ?_⟩
  have hzq : gammaTwoQuotientMk z ∈
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) :=
    subset_closure ⟨z, hz, rfl⟩
  rcases hsub hzq with ⟨w, hw, hEq⟩
  exact ⟨w, hw, hEq⟩

/-! #### Auxiliary topological truncation of quotient-compact support

The literal geometric interface now has the concrete inhabitant
`chosenGammaTwoThreeCuspTruncationExhaustion`.  The older topological compact
lift remains useful as an auxiliary construction, but is no longer a
substitute for the paper's cusp-height truncation.
-/

theorem SmoothCompactCore.exists_quotientSupport_subset_topologicalTruncation
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) ⊆
        gammaTwoQuotientMk '' gammaTwoTopologicalTruncation Y :=
  gammaTwoTopologicalTruncation_exhausts_compacts _
    (SmoothCompactCore.quotientCompact u)

theorem SmoothCompactCore.support_orbit_has_topologicalTruncation_representative
    {P : PaperHalfWeightCertificate} (u : SmoothCompactCore P) :
    ∃ Y : ℝ, 1 < Y ∧ ∀ z : ℍ,
      SmoothCompactCore.toSection u z ≠ 0 →
      ∃ w : ℍ, w ∈ gammaTwoTopologicalTruncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z := by
  obtain ⟨Y, hY, hsub⟩ :=
    SmoothCompactCore.exists_quotientSupport_subset_topologicalTruncation u
  refine ⟨Y, hY, fun z hz => ?_⟩
  have hzq : gammaTwoQuotientMk z ∈
      quotientTSupport (SmoothCompactCore.toSection u : ℍ → ℂ) :=
    subset_closure ⟨z, hz, rfl⟩
  rcases hsub hzq with ⟨w, hw, hEq⟩
  exact ⟨w, hw, hEq⟩

end SmoothCompactCoreGeometry

/-! ### 6.5: real-coordinate differential operators

The index `a` in this section is twice the actual holomorphic covariance
exponent.  Thus a factor `j^(a/2)` is raised to exponent `(a+4)/2` by `R`.
The multiplier layer realizes this exponent by `HalfIntegralMultiplier Γ (-a)`.
In particular, the PDF's displayed factor `j^(-1/2)` has exponent index `a=-1`.
-/

namespace HalfWeightDifferentialOperators

open SmoothCompactCoreGeometry HalfIntegralMultiplier GammaTwoQuotientGeometry
open scoped ContDiff

/-! #### Coordinate jets -/

theorem RealSmooth.contDiffAt_upperLift {u : ℍ → ℂ} (hu : RealSmooth u)
    (z : ℍ) : ContDiffAt ℝ ∞ (upperLift u) (z : ℂ) := by
  unfold RealSmooth at hu
  exact (hu (z : ℂ) z.im_pos).contDiffAt
    (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos)

theorem RealSmooth.contDiffAt_two_upperLift {u : ℍ → ℂ}
    (hu : RealSmooth u) (z : ℍ) :
    ContDiffAt ℝ 2 (upperLift u) (z : ℂ) :=
  (RealSmooth.contDiffAt_upperLift hu z).of_le
    (WithTop.coe_le_coe.mpr (show (2 : ℕ∞) ≤ ⊤ from le_top))

/-- First real directional derivative in the open upper-half-plane chart. -/
noncomputable def d1 (f : ℍ → ℂ) (z : ℍ) (ξ : ℂ) : ℂ :=
  fderiv ℝ (upperLift f) (z : ℂ) ξ

/-- Second real directional derivative in two ordered directions. -/
noncomputable def d2 (f : ℍ → ℂ) (z : ℍ) (ξ η : ℂ) : ℂ :=
  iteratedFDeriv ℝ 2 (upperLift f) (z : ℂ) ![ξ, η]

theorem d1_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) (ξ : ℂ) :
    d1 (u + v) z ξ = d1 u z ξ + d1 v z ξ := by
  have hu' : DifferentiableAt ℝ (upperLift u) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hu z).differentiableAt (by simp)
  have hv' : DifferentiableAt ℝ (upperLift v) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hv z).differentiableAt (by simp)
  unfold d1
  change (fderiv ℝ (upperLift u + upperLift v) (z : ℂ)) ξ = _
  rw [fderiv_add hu' hv']
  rfl

theorem d1_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u)
    (z : ℍ) (ξ : ℂ) :
    d1 (c • u) z ξ = c * d1 u z ξ := by
  have hu' : DifferentiableAt ℝ (upperLift u) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hu z).differentiableAt (by simp)
  unfold d1
  change (fderiv ℝ (c • upperLift u) (z : ℂ)) ξ = _
  rw [fderiv_const_smul hu' c]
  rfl

theorem d2_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) (ξ η : ℂ) :
    d2 (u + v) z ξ η = d2 u z ξ η + d2 v z ξ η := by
  have hu' := RealSmooth.contDiffAt_two_upperLift hu z
  have hv' := RealSmooth.contDiffAt_two_upperLift hv z
  unfold d2
  change iteratedFDeriv ℝ 2 (upperLift u + upperLift v) (z : ℂ) ![ξ, η] = _
  rw [iteratedFDeriv_add_apply hu' hv']
  rfl

theorem d2_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u)
    (z : ℍ) (ξ η : ℂ) :
    d2 (c • u) z ξ η = c * d2 u z ξ η := by
  have hu' := RealSmooth.contDiffAt_two_upperLift hu z
  unfold d2
  change iteratedFDeriv ℝ 2 (c • upperLift u) (z : ℂ) ![ξ, η] = _
  rw [iteratedFDeriv_const_smul_apply (a := c) hu']
  rfl

/-! #### Primitive real chain and product rules -/

/-- A fixed directional derivative of a real-smooth function is again
real-smooth on the upper-half-plane chart. -/
theorem RealSmooth.d1_constDirection {f : ℍ → ℂ} (hf : RealSmooth f)
    (η : ℂ) : RealSmooth (fun z => d1 f z η) := by
  unfold RealSmooth at hf ⊢
  have hD :
      ContDiffOn ℝ ∞ (fderiv ℝ (upperLift f))
        UpperHalfPlane.upperHalfPlaneSet :=
    hf.fderiv_of_isOpen UpperHalfPlane.isOpen_upperHalfPlaneSet (by simp)
  have hEval :
      ContDiffOn ℝ ∞
        (fun w : ℂ => fderiv ℝ (upperLift f) w η)
        UpperHalfPlane.upperHalfPlaneSet :=
    hD.clm_apply contDiffOn_const
  refine hEval.congr ?_
  intro w hw
  change d1 f (UpperHalfPlane.ofComplex w) η =
    fderiv ℝ (upperLift f) w η
  unfold d1
  rw [UpperHalfPlane.ofComplex_apply_of_im_pos hw]

/-- Pointwise products preserve real smoothness. -/
theorem RealSmooth.mul {u v : ℍ → ℂ} (hu : RealSmooth u)
    (hv : RealSmooth v) : RealSmooth (u * v) := by
  unfold RealSmooth at hu hv ⊢
  simpa [upperLift, Function.comp_def] using hu.mul hv

/-- Complex conjugation is real-linear, hence preserves real smoothness. -/
theorem RealSmooth.conj {u : ℍ → ℂ} (hu : RealSmooth u) :
    RealSmooth (fun z => star (u z)) := by
  unfold RealSmooth at hu ⊢
  simpa [upperLift, Function.comp_def, Complex.conjCLE_apply] using
    hu.continuousLinearMap_comp (Complex.conjCLE : ℂ →L[ℝ] ℂ)

/-- A nowhere-zero real-smooth function has a real-smooth reciprocal. -/
theorem RealSmooth.inv {u : ℍ → ℂ} (hu : RealSmooth u)
    (hne : ∀ z, u z ≠ 0) : RealSmooth (fun z => (u z)⁻¹) := by
  unfold RealSmooth at hu ⊢
  change ContDiffOn ℝ ∞
    (fun w : ℂ => (u (UpperHalfPlane.ofComplex w))⁻¹)
    UpperHalfPlane.upperHalfPlaneSet
  exact hu.inv (fun w _ => hne (UpperHalfPlane.ofComplex w))

/-- Natural powers preserve real smoothness. -/
theorem RealSmooth.pow {u : ℍ → ℂ} (hu : RealSmooth u) (n : ℕ) :
    RealSmooth (fun z => u z ^ n) := by
  unfold RealSmooth at hu ⊢
  simpa [upperLift, Function.comp_def] using hu.pow n

/-- Differentiating a fixed first directional derivative gives the ordered
second derivative.  The order is outer direction `xi`, then evaluated
direction `eta`: `d2 f (xi, eta) = D(Df)(xi)(eta)`. -/
theorem d1_d1 {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ)
    (ξ η : ℂ) :
    d1 (fun w => d1 f w η) z ξ = d2 f z ξ η := by
  have hLocal :
      upperLift (fun w : ℍ => d1 f w η) =ᶠ[nhds (z : ℂ)]
        (fun w : ℂ => fderiv ℝ (upperLift f) w η) := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    change d1 f (UpperHalfPlane.ofComplex w) η =
      fderiv ℝ (upperLift f) w η
    unfold d1
    rw [UpperHalfPlane.ofComplex_apply_of_im_pos hw]
  change
    (fderiv ℝ (upperLift (fun w : ℍ => d1 f w η)) (z : ℂ)) ξ =
      d2 f z ξ η
  rw [hLocal.fderiv_eq]
  unfold d2
  have hField :
      DifferentiableAt ℝ (fderiv ℝ (upperLift f)) (z : ℂ) :=
    ((RealSmooth.contDiffAt_two_upperLift hf z).fderiv_right
      (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have hComp :=
    (ContinuousLinearMap.apply ℝ ℂ η).hasFDerivAt.comp
      (z : ℂ) hField.hasFDerivAt
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hComp.fderiv
  simpa [Function.comp_def, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.apply_apply, iteratedFDeriv_two_apply] using hApply

/-- Product rule for the chart directional derivative. -/
theorem d1_mul {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) (ξ : ℂ) :
    d1 (u * v) z ξ =
      d1 u z ξ * v z + u z * d1 v z ξ := by
  have hu' : DifferentiableAt ℝ (upperLift u) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hu z).differentiableAt (by simp)
  have hv' : DifferentiableAt ℝ (upperLift v) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hv z).differentiableAt (by simp)
  unfold d1
  change (fderiv ℝ (upperLift u * upperLift v) (z : ℂ)) ξ = _
  rw [fderiv_mul hu' hv']
  simp only [ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, upperLift_apply, smul_eq_mul]
  ring

/-- Reciprocal rule for the chart directional derivative. -/
theorem d1_inv {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) (ξ : ℂ)
    (hz : u z ≠ 0) :
    d1 (fun w => (u w)⁻¹) z ξ =
      -(d1 u z ξ) / (u z) ^ 2 := by
  have hu' : DifferentiableAt ℝ (upperLift u) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hu z).differentiableAt (by simp)
  have hz' : upperLift u (z : ℂ) ≠ 0 := by
    simpa using hz
  have hComp :=
    (hasFDerivAt_inv' (𝕜 := ℝ) hz').comp
      (z : ℂ) hu'.hasFDerivAt
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hComp.fderiv
  have hRaw :
      d1 (fun w => (u w)⁻¹) z ξ =
        -((u z)⁻¹ * d1 u z ξ * (u z)⁻¹) := by
    simpa [d1, upperLift, Function.comp_def,
      ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.mulLeftRight_apply] using hApply
  calc
    d1 (fun w => (u w)⁻¹) z ξ =
        -((u z)⁻¹ * d1 u z ξ * (u z)⁻¹) := hRaw
    _ = -(d1 u z ξ) / (u z) ^ 2 := by
      field_simp [hz]
      <;> ring

/-- Real directional differentiation commutes with complex conjugation. -/
theorem d1_conj {u : ℍ → ℂ} (hu : RealSmooth u)
    (z : ℍ) (ξ : ℂ) :
    d1 (fun w => star (u w)) z ξ =
      star (d1 u z ξ) := by
  have hu' : DifferentiableAt ℝ (upperLift u) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hu z).differentiableAt (by simp)
  have hComp := Complex.conjCLE.hasFDerivAt.comp (z : ℂ) hu'.hasFDerivAt
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hComp.fderiv
  simpa [d1, upperLift, Function.comp_def,
    ContinuousLinearMap.comp_apply, Complex.conjCLE_apply] using hApply

noncomputable def dx (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d1 f z 1

noncomputable def dy (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d1 f z Complex.I

noncomputable def dxx (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d2 f z 1 1

/-- `x` followed by `y` in the ordered iterated derivative. -/
noncomputable def dxy (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d2 f z 1 Complex.I

/-- `y` followed by `x` in the ordered iterated derivative. -/
noncomputable def dyx (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d2 f z Complex.I 1

noncomputable def dyy (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  d2 f z Complex.I Complex.I

@[simp]
theorem dx_conj {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dx (fun w => star (u w)) z = star (dx u z) := by
  simpa [dx] using d1_conj hu z (1 : ℂ)

@[simp]
theorem dy_conj {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dy (fun w => star (u w)) z = star (dy u z) := by
  simpa [dy] using d1_conj hu z Complex.I

theorem dx_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) : dx (u + v) z = dx u z + dx v z :=
  d1_add hu hv z 1

theorem dy_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) : dy (u + v) z = dy u z + dy v z :=
  d1_add hu hv z Complex.I

theorem dxx_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) : dxx (u + v) z = dxx u z + dxx v z :=
  d2_add hu hv z 1 1

theorem dyy_add {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) : dyy (u + v) z = dyy u z + dyy v z :=
  d2_add hu hv z Complex.I Complex.I

theorem dx_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dx (c • u) z = c * dx u z :=
  d1_smul c hu z 1

theorem dy_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dy (c • u) z = c * dy u z :=
  d1_smul c hu z Complex.I

theorem dxx_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dxx (c • u) z = c * dxx u z :=
  d2_smul c hu z 1 1

theorem dyy_smul (c : ℂ) {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dyy (c • u) z = c * dyy u z :=
  d2_smul c hu z Complex.I Complex.I

/-- The `x`-derivative of a real-smooth function is real-smooth. -/
theorem RealSmooth.dx {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (dx f) := by
  change RealSmooth (fun z => d1 f z (1 : ℂ))
  exact RealSmooth.d1_constDirection hf (1 : ℂ)

/-- The `y`-derivative of a real-smooth function is real-smooth. -/
theorem RealSmooth.dy {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (dy f) := by
  change RealSmooth (fun z => d1 f z Complex.I)
  exact RealSmooth.d1_constDirection hf Complex.I

/-- Coordinate product rule in the `x` direction. -/
theorem dx_mul {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) :
    dx (u * v) z = dx u z * v z + u z * dx v z := by
  simpa [dx] using d1_mul hu hv z (1 : ℂ)

/-- Coordinate product rule in the `y` direction. -/
theorem dy_mul {u v : ℍ → ℂ} (hu : RealSmooth u) (hv : RealSmooth v)
    (z : ℍ) :
    dy (u * v) z = dy u z * v z + u z * dy v z := by
  simpa [dy] using d1_mul hu hv z Complex.I

/-- `x` after `x` is the ordered `xx` jet. -/
theorem dx_dx {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dx (dx f) z = dxx f z := by
  change d1 (fun w => d1 f w (1 : ℂ)) z (1 : ℂ) =
    d2 f z (1 : ℂ) (1 : ℂ)
  exact d1_d1 hf z (1 : ℂ) (1 : ℂ)

/-- `x` after `y` is the ordered `xy` jet. -/
theorem dx_dy {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dx (dy f) z = dxy f z := by
  change d1 (fun w => d1 f w Complex.I) z (1 : ℂ) =
    d2 f z (1 : ℂ) Complex.I
  exact d1_d1 hf z (1 : ℂ) Complex.I

/-- `y` after `x` is the ordered `yx` jet. -/
theorem dy_dx {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dy (dx f) z = dyx f z := by
  change d1 (fun w => d1 f w (1 : ℂ)) z Complex.I =
    d2 f z Complex.I (1 : ℂ)
  exact d1_d1 hf z Complex.I (1 : ℂ)

/-- `y` after `y` is the ordered `yy` jet. -/
theorem dy_dy {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    dy (dy f) z = dyy f z := by
  change d1 (fun w => d1 f w Complex.I) z Complex.I =
    d2 f z Complex.I Complex.I
  exact d1_d1 hf z Complex.I Complex.I

/-- Schwarz symmetry for the real mixed derivatives, derived from `C∞`. -/
theorem mixedDerivative_comm {u : ℍ → ℂ} (hu : RealSmooth u) (z : ℍ) :
    dxy u z = dyx u z := by
  unfold dxy dyx d2
  exact ((RealSmooth.contDiffAt_upperLift hu z).isSymmSndFDerivAt
    (by
      simpa [minSmoothness] using
        (WithTop.coe_le_coe.mpr
          (show (2 : ℕ∞) ≤ ⊤ from le_top)))).iteratedFDeriv_cons

/-! #### Raw raising, lowering, and the consistent Laplacian -/

/-- Physical holomorphic exponent represented by doubled exponent index `a`. -/
noncomputable def physicalExponent (a : ℤ) : ℂ :=
  (((a : ℝ) / 2 : ℝ) : ℂ)

def heightC (z : ℍ) : ℂ :=
  (z.im : ℂ)

/-- `R_q = 2i ∂z + q/y`, with `q=a/2`. -/
noncomputable def raiseRaw (a : ℤ) (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  Complex.I * dx f z + dy f z +
    physicalExponent a / heightC z * f z

/-- The raising formula literally printed by the PDF after translating its
reported weight `k` to the actual covariance exponent `q=-k`. -/
noncomputable def paperDisplayedRaiseRaw
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  Complex.I * dx f z + dy f z -
    physicalExponent a / heightC z * f z

theorem paperDisplayedRaiseRaw_sub_raiseRaw
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    paperDisplayedRaiseRaw a f z - raiseRaw a f z =
      -2 * physicalExponent a / heightC z * f z := by
  unfold paperDisplayedRaiseRaw raiseRaw
  ring

/-- `L_q = -2i y² ∂bar`, independent of `q` in this gauge. -/
noncomputable def lowerRaw (_a : ℤ) (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  -Complex.I * heightC z ^ 2 * dx f z +
    heightC z ^ 2 * dy f z

/-- The holomorphic-gauge Laplacian consistent with the displayed `R` and `L`.
The final `-q y ∂y` term is absent from the PDF's p.12 display. -/
noncomputable def laplaceRaw (a : ℤ) (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  -(heightC z ^ 2) * (dxx f z + dyy f z) +
    Complex.I * physicalExponent a * heightC z * dx f z -
    physicalExponent a * heightC z * dy f z

@[simp]
theorem conj_physicalExponent (a : ℤ) :
    star (physicalExponent a) = physicalExponent a := by
  simp [physicalExponent]

@[simp]
theorem conj_heightC (z : ℍ) :
    star (heightC z) = heightC z := by
  simp [heightC]

/-- The exact local bulk expression underlying the raising/lowering Green
identity.  The target Petersson scale differs from the source scale by `y²`;
after cancelling that factor against hyperbolic measure, the two pairings
have precisely the normalized combination on the left.  This theorem fixes
all signs, the weight index, and the zero-order term before any global Stokes
argument is invoked. -/
theorem normalizedGreenBulk_expansion
    (a : ℤ) (u v : ℍ → ℂ) (z : ℍ) :
    star (raiseRaw a u z) * v z +
        star (u z) *
          (lowerRaw (a + 4) v z / heightC z ^ 2) =
      -Complex.I *
          (star (dx u z) * v z +
            star (u z) * dx v z) +
        (star (dy u z) * v z +
          star (u z) * dy v z) +
        physicalExponent a / heightC z *
          star (u z) * v z := by
  have hh : heightC z ≠ 0 := by
    simpa [heightC] using
      (Complex.ofReal_ne_zero.mpr (ne_of_gt z.im_pos))
  have hI : star (Complex.I) = -Complex.I := by simp
  have hweight :
      star (physicalExponent a / heightC z) =
        physicalExponent a / heightC z := by
    simp [physicalExponent, heightC]
  simp only [raiseRaw, lowerRaw, star_add, star_mul']
  rw [hI, hweight]
  field_simp [hh]
  ring

/-- The p.12 displayed expression, recorded separately rather than identified
with the Laplacian compatible with `raiseRaw` and `lowerRaw`. -/
noncomputable def paperDisplayedLaplaceRaw
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  -(heightC z ^ 2) * (dxx f z + dyy f z) +
    -Complex.I * physicalExponent a * heightC z * dx f z

theorem laplaceRaw_eq_paperDisplayed_add_defect
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    laplaceRaw a f z = paperDisplayedLaplaceRaw a f z +
      2 * Complex.I * physicalExponent a * heightC z * dx f z -
        physicalExponent a * heightC z * dy f z := by
  unfold laplaceRaw paperDisplayedLaplaceRaw
  ring

/-! #### Linearity on the smooth domain -/

def realSmoothSubmodule : Submodule ℂ (ℍ → ℂ) where
  carrier := RealSmooth
  zero_mem' := realSmooth_zero
  add_mem' hu hv := hu.add hv
  smul_mem' c _ hu := hu.const_complex_smul c

abbrev SmoothFunction := realSmoothSubmodule

noncomputable def raiseLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] (ℍ → ℂ) where
  toFun f := raiseRaw a f
  map_add' u v := by
    ext z
    change raiseRaw a ((u : ℍ → ℂ) + (v : ℍ → ℂ)) z =
      raiseRaw a (u : ℍ → ℂ) z + raiseRaw a (v : ℍ → ℂ) z
    unfold raiseRaw
    rw [dx_add u.2 v.2, dy_add u.2 v.2]
    simp only [Pi.add_apply]
    ring
  map_smul' c u := by
    ext z
    change raiseRaw a (c • (u : ℍ → ℂ)) z =
      c • raiseRaw a (u : ℍ → ℂ) z
    unfold raiseRaw
    rw [dx_smul c u.2, dy_smul c u.2]
    simp only [Pi.smul_apply, smul_eq_mul]
    ring

noncomputable def lowerLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] (ℍ → ℂ) where
  toFun f := lowerRaw a f
  map_add' u v := by
    ext z
    change lowerRaw a ((u : ℍ → ℂ) + (v : ℍ → ℂ)) z =
      lowerRaw a (u : ℍ → ℂ) z + lowerRaw a (v : ℍ → ℂ) z
    unfold lowerRaw
    rw [dx_add u.2 v.2, dy_add u.2 v.2]
    ring
  map_smul' c u := by
    ext z
    change lowerRaw a (c • (u : ℍ → ℂ)) z =
      c • lowerRaw a (u : ℍ → ℂ) z
    unfold lowerRaw
    rw [dx_smul c u.2, dy_smul c u.2]
    simp only [smul_eq_mul]
    ring

noncomputable def laplaceLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] (ℍ → ℂ) where
  toFun f := laplaceRaw a f
  map_add' u v := by
    ext z
    change laplaceRaw a ((u : ℍ → ℂ) + (v : ℍ → ℂ)) z =
      laplaceRaw a (u : ℍ → ℂ) z + laplaceRaw a (v : ℍ → ℂ) z
    unfold laplaceRaw
    rw [dxx_add u.2 v.2, dyy_add u.2 v.2,
      dx_add u.2 v.2, dy_add u.2 v.2]
    ring
  map_smul' c u := by
    ext z
    change laplaceRaw a (c • (u : ℍ → ℂ)) z =
      c • laplaceRaw a (u : ℍ → ℂ) z
    unfold laplaceRaw
    rw [dxx_smul c u.2, dyy_smul c u.2,
      dx_smul c u.2, dy_smul c u.2]
    simp only [smul_eq_mul]
    ring

/-! #### Direct factorization from primitive chain/product rules -/

@[simp]
theorem physicalExponent_sub_four (a : ℤ) :
    physicalExponent (a - 4) = physicalExponent a - 2 := by
  norm_num [physicalExponent] <;> ring

theorem heightC_ne_zero (z : ℍ) : heightC z ≠ 0 := by
  simpa [heightC] using
    (Complex.ofReal_ne_zero.mpr (ne_of_gt z.im_pos))

/-! #### Unconditional coordinate chain rules -/

/-- The real-linear height-coordinate map on the ambient complex chart. -/
noncomputable def heightCoordinateCLM : ℂ →L[ℝ] ℂ :=
  Complex.ofRealCLM.comp Complex.imCLM

@[simp]
theorem heightCoordinateCLM_apply (w : ℂ) :
    heightCoordinateCLM w = (w.im : ℂ) := by
  simp [heightCoordinateCLM, Complex.ofRealCLM_apply,
    Complex.imCLM_apply]

/-- On the open upper half-plane, the arbitrary total extension `upperLift`
of height agrees with the ambient imaginary-coordinate linear map. -/
theorem upperLift_heightC_eqOn :
    Set.EqOn (upperLift heightC) heightCoordinateCLM
      UpperHalfPlane.upperHalfPlaneSet := by
  intro w hw
  simp [upperLift, heightC, Function.comp_def,
    UpperHalfPlane.ofComplex_apply_of_im_pos hw,
    heightCoordinateCLM]

/-- Height is real-smooth in the ambient chart. -/
theorem realSmooth_heightC : RealSmooth heightC := by
  unfold RealSmooth
  exact heightCoordinateCLM.contDiff.contDiffOn.congr
    upperLift_heightC_eqOn

/-- The directional derivative of height is the imaginary coordinate of the
direction. -/
theorem d1_heightC (z : ℍ) (ξ : ℂ) :
    d1 heightC z ξ = (ξ.im : ℂ) := by
  have hLocal :
      upperLift heightC =ᶠ[nhds (z : ℂ)] heightCoordinateCLM := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    exact upperLift_heightC_eqOn hw
  unfold d1
  rw [hLocal.fderiv_eq, heightCoordinateCLM.fderiv]
  exact heightCoordinateCLM_apply ξ

@[simp]
theorem dx_heightC (z : ℍ) : dx heightC z = 0 := by
  simpa [dx] using d1_heightC z (1 : ℂ)

@[simp]
theorem dy_heightC (z : ℍ) : dy heightC z = 1 := by
  simpa [dy] using d1_heightC z Complex.I

/-- The scalar coefficient `q / y` occurring in the raising operator. -/
noncomputable def weightCoefficient (q : ℂ) (z : ℍ) : ℂ :=
  q / heightC z

/-- The raising coefficient is real-smooth because height never vanishes. -/
theorem realSmooth_weightCoefficient (q : ℂ) :
    RealSmooth (weightCoefficient q) := by
  have hInv : RealSmooth (fun z => (heightC z)⁻¹) :=
    RealSmooth.inv realSmooth_heightC heightC_ne_zero
  change RealSmooth (fun z => q * (heightC z)⁻¹)
  rw [show (fun z => q * (heightC z)⁻¹) =
      q • (fun z => (heightC z)⁻¹) by
    funext z
    rfl]
  exact RealSmooth.const_complex_smul q hInv

/-- Full directional derivative of `q / y`. -/
theorem d1_weightCoefficient (q : ℂ) (z : ℍ) (ξ : ℂ) :
    d1 (weightCoefficient q) z ξ =
      -q * (ξ.im : ℂ) / heightC z ^ 2 := by
  have hInv : RealSmooth (fun w => (heightC w)⁻¹) :=
    RealSmooth.inv realSmooth_heightC heightC_ne_zero
  calc
    d1 (weightCoefficient q) z ξ =
        q * d1 (fun w => (heightC w)⁻¹) z ξ := by
      change d1 (fun w => q * (heightC w)⁻¹) z ξ =
        q * d1 (fun w => (heightC w)⁻¹) z ξ
      rw [show (fun w => q * (heightC w)⁻¹) =
          q • (fun w => (heightC w)⁻¹) by
        funext w
        rfl]
      exact d1_smul q hInv z ξ
    _ = q * (-(d1 heightC z ξ) / heightC z ^ 2) := by
      rw [d1_inv realSmooth_heightC z ξ (heightC_ne_zero z)]
    _ = -q * (ξ.im : ℂ) / heightC z ^ 2 := by
      rw [d1_heightC]
      ring

@[simp]
theorem dx_weightCoefficient (q : ℂ) (z : ℍ) :
    dx (weightCoefficient q) z = 0 := by
  unfold dx
  rw [d1_weightCoefficient]
  simp

@[simp]
theorem dy_weightCoefficient (q : ℂ) (z : ℍ) :
    dy (weightCoefficient q) z = -q / heightC z ^ 2 := by
  unfold dy
  rw [d1_weightCoefficient]
  simp

/-- The square-height coefficient in the lowering operator. -/
def heightSq (z : ℍ) : ℂ :=
  heightC z ^ 2

/-- Square height is real-smooth. -/
theorem realSmooth_heightSq : RealSmooth heightSq := by
  change RealSmooth (fun z => heightC z ^ 2)
  exact realSmooth_heightC.pow 2

/-- Directional derivative of square height. -/
theorem d1_heightSq (z : ℍ) (ξ : ℂ) :
    d1 heightSq z ξ = 2 * heightC z * (ξ.im : ℂ) := by
  calc
    d1 heightSq z ξ = d1 (heightC * heightC) z ξ := by
      apply congrArg (fun g : ℍ → ℂ => d1 g z ξ)
      funext w
      simp [heightSq, pow_two]
    _ = d1 heightC z ξ * heightC z +
        heightC z * d1 heightC z ξ :=
      d1_mul realSmooth_heightC realSmooth_heightC z ξ
    _ = 2 * heightC z * (ξ.im : ℂ) := by
      rw [d1_heightC]
      ring

@[simp]
theorem dx_heightSq (z : ℍ) : dx heightSq z = 0 := by
  unfold dx
  rw [d1_heightSq]
  simp

@[simp]
theorem dy_heightSq (z : ℍ) : dy heightSq z = 2 * heightC z := by
  unfold dy
  rw [d1_heightSq]
  simp

/-- The first `x` derivative of the raw raising operator, now derived rather
than stored as a certificate. -/
theorem dx_raiseRaw_of_realSmooth (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    dx (raiseRaw a f) z =
      Complex.I * dxx f z + dxy f z +
        physicalExponent a / heightC z * dx f z := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hc : RealSmooth (weightCoefficient (physicalExponent a)) :=
    realSmooth_weightCoefficient _
  have hI : RealSmooth (Complex.I • dx f) :=
    hdx.const_complex_smul Complex.I
  have hSum : RealSmooth (Complex.I • dx f + dy f) := hI.add hdy
  have hProd : RealSmooth
      (weightCoefficient (physicalExponent a) * f) := hc.mul hf
  change dx
    ((Complex.I • dx f) + dy f +
      weightCoefficient (physicalExponent a) * f) z = _
  rw [dx_add hSum hProd, dx_add hI hdy,
    dx_smul Complex.I hdx, dx_mul hc hf,
    dx_dx hf, dx_dy hf, dx_weightCoefficient]
  unfold weightCoefficient
  ring

/-- The first `y` derivative of the raw raising operator. -/
theorem dy_raiseRaw_of_realSmooth (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    dy (raiseRaw a f) z =
      Complex.I * dyx f z + dyy f z -
        physicalExponent a / heightC z ^ 2 * f z +
        physicalExponent a / heightC z * dy f z := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hc : RealSmooth (weightCoefficient (physicalExponent a)) :=
    realSmooth_weightCoefficient _
  have hI : RealSmooth (Complex.I • dx f) :=
    hdx.const_complex_smul Complex.I
  have hSum : RealSmooth (Complex.I • dx f + dy f) := hI.add hdy
  have hProd : RealSmooth
      (weightCoefficient (physicalExponent a) * f) := hc.mul hf
  change dy
    ((Complex.I • dx f) + dy f +
      weightCoefficient (physicalExponent a) * f) z = _
  rw [dy_add hSum hProd, dy_add hI hdy,
    dy_smul Complex.I hdx, dy_mul hc hf,
    dy_dx hf, dy_dy hf, dy_weightCoefficient]
  unfold weightCoefficient
  ring

/-- The first `x` derivative of the raw lowering operator. -/
theorem dx_lowerRaw_of_realSmooth (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    dx (lowerRaw a f) z =
      -Complex.I * heightC z ^ 2 * dxx f z +
        heightC z ^ 2 * dxy f z := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hs : RealSmooth heightSq := realSmooth_heightSq
  have hNeg : RealSmooth ((-Complex.I) • heightSq) :=
    hs.const_complex_smul (-Complex.I)
  change dx
    (((-Complex.I) • heightSq) * dx f + heightSq * dy f) z = _
  rw [dx_add (RealSmooth.mul hNeg hdx) (RealSmooth.mul hs hdy),
    dx_mul hNeg hdx, dx_mul hs hdy,
    dx_smul (-Complex.I) hs, dx_heightSq,
    dx_dx hf, dx_dy hf]
  unfold heightSq
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- The first `y` derivative of the raw lowering operator. -/
theorem dy_lowerRaw_of_realSmooth (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    dy (lowerRaw a f) z =
      -Complex.I *
          (2 * heightC z * dx f z + heightC z ^ 2 * dyx f z) +
        2 * heightC z * dy f z + heightC z ^ 2 * dyy f z := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hs : RealSmooth heightSq := realSmooth_heightSq
  have hNeg : RealSmooth ((-Complex.I) • heightSq) :=
    hs.const_complex_smul (-Complex.I)
  change dy
    (((-Complex.I) • heightSq) * dx f + heightSq * dy f) z = _
  rw [dy_add (RealSmooth.mul hNeg hdx) (RealSmooth.mul hs hdy),
    dy_mul hNeg hdx, dy_mul hs hdy,
    dy_smul (-Complex.I) hs, dy_heightSq,
    dy_dx hf, dy_dy hf]
  unfold heightSq
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- The raw raising operator preserves real smoothness. -/
theorem realSmooth_raiseRaw (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) : RealSmooth (raiseRaw a f) := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hc : RealSmooth (weightCoefficient (physicalExponent a)) :=
    realSmooth_weightCoefficient _
  have hI : RealSmooth (Complex.I • dx f) :=
    hdx.const_complex_smul Complex.I
  change RealSmooth
    ((Complex.I • dx f) + dy f +
      weightCoefficient (physicalExponent a) * f)
  exact (hI.add hdy).add (hc.mul hf)

/-- The raw lowering operator preserves real smoothness. -/
theorem realSmooth_lowerRaw (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) : RealSmooth (lowerRaw a f) := by
  have hdx : RealSmooth (dx f) := RealSmooth.dx hf
  have hdy : RealSmooth (dy f) := RealSmooth.dy hf
  have hs : RealSmooth heightSq := realSmooth_heightSq
  have hNeg : RealSmooth ((-Complex.I) • heightSq) :=
    hs.const_complex_smul (-Complex.I)
  change RealSmooth
    (((-Complex.I) • heightSq) * dx f + heightSq * dy f)
  exact (hNeg.mul hdx).add (hs.mul hdy)

/-- Primitive first-derivative product/chain rules for the two composed
operators.  Unlike a factorization field, these equations expose every
coordinate derivative needed by the subsequent ring calculation. -/
structure RealJetChainRuleCertificate
    (a : ℤ) (f : ℍ → ℂ) : Prop where
  dx_raise : ∀ z,
    dx (raiseRaw a f) z =
      Complex.I * dxx f z + dxy f z +
        physicalExponent a / heightC z * dx f z
  dy_raise : ∀ z,
    dy (raiseRaw a f) z =
      Complex.I * dyx f z + dyy f z -
        physicalExponent a / heightC z ^ 2 * f z +
        physicalExponent a / heightC z * dy f z
  dx_lower : ∀ z,
    dx (lowerRaw a f) z =
      -Complex.I * heightC z ^ 2 * dxx f z +
        heightC z ^ 2 * dxy f z
  dy_lower : ∀ z,
    dy (lowerRaw a f) z =
      -Complex.I *
          (2 * heightC z * dx f z + heightC z ^ 2 * dyx f z) +
        2 * heightC z * dy f z + heightC z ^ 2 * dyy f z

/-- Every real-smooth function supplies all four primitive chain/product
rules; this is no longer an external certificate boundary. -/
theorem realJetChainRuleCertificate (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) : RealJetChainRuleCertificate a f where
  dx_raise z := dx_raiseRaw_of_realSmooth a hf z
  dy_raise z := dy_raiseRaw_of_realSmooth a hf z
  dx_lower z := dx_lowerRaw_of_realSmooth a hf z
  dy_lower z := dy_lowerRaw_of_realSmooth a hf z

private theorem lowerRaise_algebra
    (h q x y xx xy yx yy u : ℂ) (hh : h ≠ 0) :
    -Complex.I * h ^ 2 *
          (Complex.I * xx + xy + q / h * x) +
        h ^ 2 *
          (Complex.I * yx + yy - q / h ^ 2 * u + q / h * y) =
      -(-(h ^ 2) * (xx + yy) + Complex.I * q * h * x - q * h * y) -
        q * u + Complex.I * h ^ 2 * (yx - xy) := by
  field_simp [hh]
  ring_nf
  simp [Complex.I_sq]
  <;> ring

private theorem raiseLower_algebra
    (h q x y xx xy yx yy : ℂ) (hh : h ≠ 0) :
    Complex.I * (-Complex.I * h ^ 2 * xx + h ^ 2 * xy) +
        (-Complex.I * (2 * h * x + h ^ 2 * yx) +
          2 * h * y + h ^ 2 * yy) +
        (q - 2) / h * (-Complex.I * h ^ 2 * x + h ^ 2 * y) =
      -(-(h ^ 2) * (xx + yy) + Complex.I * q * h * x - q * h * y) +
        Complex.I * h ^ 2 * (xy - yx) := by
  field_simp [hh]
  ring_nf
  simp [Complex.I_sq]
  <;> ring

theorem RealJetChainRuleCertificate.lower_raise_expansion
    {a : ℤ} {f : ℍ → ℂ} (J : RealJetChainRuleCertificate a f) (z : ℍ) :
    lowerRaw (a + 4) (raiseRaw a f) z =
      -laplaceRaw a f z - physicalExponent a * f z +
        Complex.I * heightC z ^ 2 * (dyx f z - dxy f z) := by
  unfold lowerRaw
  rw [J.dx_raise z, J.dy_raise z]
  simpa [laplaceRaw] using lowerRaise_algebra
    (heightC z) (physicalExponent a) (dx f z) (dy f z)
    (dxx f z) (dxy f z) (dyx f z) (dyy f z) (f z)
    (heightC_ne_zero z)

theorem RealJetChainRuleCertificate.raise_lower_expansion
    {a : ℤ} {f : ℍ → ℂ} (J : RealJetChainRuleCertificate a f) (z : ℍ) :
    raiseRaw (a - 4) (lowerRaw a f) z =
      -laplaceRaw a f z +
        Complex.I * heightC z ^ 2 * (dxy f z - dyx f z) := by
  unfold raiseRaw
  rw [J.dx_lower z, J.dy_lower z, physicalExponent_sub_four]
  simpa [laplaceRaw, lowerRaw] using raiseLower_algebra
    (heightC z) (physicalExponent a) (dx f z) (dy f z)
    (dxx f z) (dxy f z) (dyx f z) (dyy f z)
    (heightC_ne_zero z)

theorem lower_raise_factorization
    {a : ℤ} {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    -laplaceRaw a f z = lowerRaw (a + 4) (raiseRaw a f) z +
      physicalExponent a * f z := by
  have h := (realJetChainRuleCertificate a hf).lower_raise_expansion z
  rw [mixedDerivative_comm hf z, sub_self, mul_zero, add_zero] at h
  rw [h]
  ring

theorem raise_lower_factorization
    {a : ℤ} {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    -laplaceRaw a f z = raiseRaw (a - 4) (lowerRaw a f) z := by
  have h := (realJetChainRuleCertificate a hf).raise_lower_expansion z
  rw [mixedDerivative_comm hf z, sub_self, mul_zero, add_zero] at h
  exact h.symm

theorem averaged_factorization
    {a : ℤ} {f : ℍ → ℂ} (hf : RealSmooth f) (z : ℍ) :
    -laplaceRaw a f z =
      (1 / 2 : ℂ) *
        (lowerRaw (a + 4) (raiseRaw a f) z +
          raiseRaw (a - 4) (lowerRaw a f) z) +
      (physicalExponent a / 2) * f z := by
  have hLR := lower_raise_factorization (a := a) hf z
  have hRL := raise_lower_factorization (a := a) hf z
  linear_combination (1 / 2 : ℂ) * hLR + (1 / 2 : ℂ) * hRL

/-- The compatible raw Laplacian preserves real smoothness.  This is derived
from the already-proved lower--raise factorization, so no second independent
coordinate calculation is hidden here. -/
theorem realSmooth_laplaceRaw (a : ℤ) {f : ℍ → ℂ}
    (hf : RealSmooth f) : RealSmooth (laplaceRaw a f) := by
  have hEq :
      -laplaceRaw a f =
        lowerRaw (a + 4) (raiseRaw a f) +
          physicalExponent a • f := by
    funext z
    change -laplaceRaw a f z =
      lowerRaw (a + 4) (raiseRaw a f) z +
        physicalExponent a * f z
    exact lower_raise_factorization hf z
  have hRight : RealSmooth
      (lowerRaw (a + 4) (raiseRaw a f) +
        physicalExponent a • f) :=
    (realSmooth_lowerRaw (a + 4) (realSmooth_raiseRaw a hf)).add
      (hf.const_complex_smul (physicalExponent a))
  have hNeg : RealSmooth (-laplaceRaw a f) := by
    rw [hEq]
    exact hRight
  simpa only [neg_neg] using hNeg.neg

/-! #### Smooth-domain and compact-support preservation

The raw coordinate operators can be bundled on the real-smooth domain without
any automorphy hypothesis.  Their support preservation is likewise local: off
the topological support, the function is identically zero on a neighbourhood,
so its chart derivatives vanish.  This closes the smooth/domain part of the
operator-core obligation while leaving multiplier differentiability and
automorphy as a separate geometric issue.
-/

/-- The raw raising operator as an endomorphism of the real-smooth domain. -/
noncomputable def raiseSmoothLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] SmoothFunction :=
  LinearMap.codRestrict realSmoothSubmodule (raiseLinear a) (fun f => by
    change RealSmooth (raiseRaw a (f : ℍ → ℂ))
    exact realSmooth_raiseRaw a f.2)

/-- The raw lowering operator as an endomorphism of the real-smooth domain. -/
noncomputable def lowerSmoothLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] SmoothFunction :=
  LinearMap.codRestrict realSmoothSubmodule (lowerLinear a) (fun f => by
    change RealSmooth (lowerRaw a (f : ℍ → ℂ))
    exact realSmooth_lowerRaw a f.2)

/-- The compatible raw Laplacian as an endomorphism of the real-smooth
domain. -/
noncomputable def laplaceSmoothLinear (a : ℤ) :
    SmoothFunction →ₗ[ℂ] SmoothFunction :=
  LinearMap.codRestrict realSmoothSubmodule (laplaceLinear a) (fun f => by
    change RealSmooth (laplaceRaw a (f : ℍ → ℂ))
    exact realSmooth_laplaceRaw a f.2)

@[simp]
theorem raiseSmoothLinear_coe (a : ℤ) (f : SmoothFunction) :
    ((raiseSmoothLinear a f : SmoothFunction) : ℍ → ℂ) =
      raiseRaw a (f : ℍ → ℂ) :=
  rfl

@[simp]
theorem lowerSmoothLinear_coe (a : ℤ) (f : SmoothFunction) :
    ((lowerSmoothLinear a f : SmoothFunction) : ℍ → ℂ) =
      lowerRaw a (f : ℍ → ℂ) :=
  rfl

@[simp]
theorem laplaceSmoothLinear_coe (a : ℤ) (f : SmoothFunction) :
    ((laplaceSmoothLinear a f : SmoothFunction) : ℍ → ℂ) =
      laplaceRaw a (f : ℍ → ℂ) :=
  rfl

/-- The Laplacian is already determined on the smooth domain by the
raise-after-lower factorization. -/
theorem neg_raiseSmoothLinear_lowerSmoothLinear_apply
    (a : ℤ) (f : SmoothFunction) (z : ℍ) :
    -((raiseSmoothLinear (a - 4) (lowerSmoothLinear a f) :
        SmoothFunction) : ℍ → ℂ) z =
      laplaceRaw a (f : ℍ → ℂ) z := by
  change -raiseRaw (a - 4) (lowerRaw a (f : ℍ → ℂ)) z =
    laplaceRaw a (f : ℍ → ℂ) z
  rw [← raise_lower_factorization f.2 z]
  simp

/-- Local zero of a function on `ℍ` transfers to local zero of its arbitrary
ambient chart extension at an upper-half-plane point. -/
theorem upperLift_eventuallyEq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) :
    upperLift f =ᶠ[nhds (z : ℂ)] (0 : ℂ → ℂ) := by
  rw [notMem_tsupport_iff_eventuallyEq] at hz
  rw [← UpperHalfPlane.isOpenEmbedding_coe.map_nhds_eq]
  change
    (fun w : ℍ => upperLift f (w : ℂ)) =ᶠ[nhds z]
      (fun _ : ℍ => (0 : ℂ))
  filter_upwards [hz] with w hw
  simpa only [upperLift_apply, Pi.zero_apply] using hw

theorem d1_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} {z : ℍ} (ξ : ℂ) (hz : z ∉ tsupport f) :
    d1 f z ξ = 0 := by
  unfold d1
  rw [(upperLift_eventuallyEq_zero_of_not_mem_tsupport hz).fderiv_eq]
  simp

theorem support_d1_constDirection_subset_tsupport
    (f : ℍ → ℂ) (ξ : ℂ) :
    Function.support (fun z => d1 f z ξ) ⊆ tsupport f := by
  intro z hz
  by_contra hzt
  exact hz (d1_eq_zero_of_not_mem_tsupport ξ hzt)

theorem tsupport_d1_constDirection_subset_tsupport
    (f : ℍ → ℂ) (ξ : ℂ) :
    tsupport (fun z => d1 f z ξ) ⊆ tsupport f :=
  closure_minimal (support_d1_constDirection_subset_tsupport f ξ)
    isClosed_closure

theorem dx_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) :
    dx f z = 0 :=
  d1_eq_zero_of_not_mem_tsupport 1 hz

theorem dy_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) :
    dy f z = 0 :=
  d1_eq_zero_of_not_mem_tsupport Complex.I hz

theorem support_dx_subset_tsupport (f : ℍ → ℂ) :
    Function.support (dx f) ⊆ tsupport f :=
  support_d1_constDirection_subset_tsupport f 1

theorem support_dy_subset_tsupport (f : ℍ → ℂ) :
    Function.support (dy f) ⊆ tsupport f :=
  support_d1_constDirection_subset_tsupport f Complex.I

theorem tsupport_dx_subset_tsupport (f : ℍ → ℂ) :
    tsupport (dx f) ⊆ tsupport f :=
  tsupport_d1_constDirection_subset_tsupport f 1

theorem tsupport_dy_subset_tsupport (f : ℍ → ℂ) :
    tsupport (dy f) ⊆ tsupport f :=
  tsupport_d1_constDirection_subset_tsupport f Complex.I

theorem dxx_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} (hf : RealSmooth f) {z : ℍ}
    (hz : z ∉ tsupport f) : dxx f z = 0 := by
  rw [← dx_dx hf z]
  exact dx_eq_zero_of_not_mem_tsupport
    (fun hdx => hz (tsupport_dx_subset_tsupport f hdx))

theorem dyy_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} (hf : RealSmooth f) {z : ℍ}
    (hz : z ∉ tsupport f) : dyy f z = 0 := by
  rw [← dy_dy hf z]
  exact dy_eq_zero_of_not_mem_tsupport
    (fun hdy => hz (tsupport_dy_subset_tsupport f hdy))

theorem value_eq_zero_of_not_mem_tsupport
    {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) : f z = 0 := by
  by_contra hfz
  exact hz (subset_closure hfz)

theorem raiseRaw_eq_zero_of_not_mem_tsupport
    (a : ℤ) {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) :
    raiseRaw a f z = 0 := by
  unfold raiseRaw
  rw [dx_eq_zero_of_not_mem_tsupport hz,
    dy_eq_zero_of_not_mem_tsupport hz,
    value_eq_zero_of_not_mem_tsupport hz]
  ring

theorem lowerRaw_eq_zero_of_not_mem_tsupport
    (a : ℤ) {f : ℍ → ℂ} {z : ℍ} (hz : z ∉ tsupport f) :
    lowerRaw a f z = 0 := by
  unfold lowerRaw
  rw [dx_eq_zero_of_not_mem_tsupport hz,
    dy_eq_zero_of_not_mem_tsupport hz]
  ring

theorem laplaceRaw_eq_zero_of_not_mem_tsupport
    (a : ℤ) {f : ℍ → ℂ} (hf : RealSmooth f) {z : ℍ}
    (hz : z ∉ tsupport f) : laplaceRaw a f z = 0 := by
  unfold laplaceRaw
  rw [dxx_eq_zero_of_not_mem_tsupport hf hz,
    dyy_eq_zero_of_not_mem_tsupport hf hz,
    dx_eq_zero_of_not_mem_tsupport hz,
    dy_eq_zero_of_not_mem_tsupport hz]
  ring

theorem support_raiseRaw_subset_tsupport (a : ℤ) (f : ℍ → ℂ) :
    Function.support (raiseRaw a f) ⊆ tsupport f := by
  intro z hz
  by_contra hzt
  exact hz (raiseRaw_eq_zero_of_not_mem_tsupport a hzt)

theorem support_lowerRaw_subset_tsupport (a : ℤ) (f : ℍ → ℂ) :
    Function.support (lowerRaw a f) ⊆ tsupport f := by
  intro z hz
  by_contra hzt
  exact hz (lowerRaw_eq_zero_of_not_mem_tsupport a hzt)

theorem support_laplaceRaw_subset_tsupport
    (a : ℤ) {f : ℍ → ℂ} (hf : RealSmooth f) :
    Function.support (laplaceRaw a f) ⊆ tsupport f := by
  intro z hz
  by_contra hzt
  exact hz (laplaceRaw_eq_zero_of_not_mem_tsupport a hf hzt)

/-- A general bridge from local support preservation upstairs to topological
support preservation on the orbit quotient. -/
theorem quotientTSupport_mono_of_support_subset_tsupport
    {f g : ℍ → ℂ} (h : Function.support g ⊆ tsupport f) :
    quotientTSupport g ⊆ quotientTSupport f := by
  unfold SmoothCompactCoreGeometry.quotientTSupport
  apply closure_minimal
  · have hImage : gammaTwoQuotientMk '' tsupport f ⊆
        closure (gammaTwoQuotientMk '' Function.support f) := by
      simpa only [tsupport] using
        (image_closure_subset_closure_image
          gammaTwoQuotientMk_isOpenQuotientMap.continuous :
          gammaTwoQuotientMk '' closure (Function.support f) ⊆
            closure (gammaTwoQuotientMk '' Function.support f))
    exact (Set.image_mono h).trans hImage
  · exact isClosed_closure

theorem quotientTSupport_raiseRaw_subset (a : ℤ) (f : ℍ → ℂ) :
    quotientTSupport (raiseRaw a f) ⊆ quotientTSupport f :=
  quotientTSupport_mono_of_support_subset_tsupport
    (support_raiseRaw_subset_tsupport a f)

theorem quotientTSupport_lowerRaw_subset (a : ℤ) (f : ℍ → ℂ) :
    quotientTSupport (lowerRaw a f) ⊆ quotientTSupport f :=
  quotientTSupport_mono_of_support_subset_tsupport
    (support_lowerRaw_subset_tsupport a f)

theorem quotientTSupport_laplaceRaw_subset
    (a : ℤ) {f : ℍ → ℂ} (hf : RealSmooth f) :
    quotientTSupport (laplaceRaw a f) ⊆ quotientTSupport f :=
  quotientTSupport_mono_of_support_subset_tsupport
    (support_laplaceRaw_subset_tsupport a hf)

theorem HasQuotientCompactSupport.raiseRaw
    {f : ℍ → ℂ} (hf : HasQuotientCompactSupport f) (a : ℤ) :
    HasQuotientCompactSupport (raiseRaw a f) :=
  hf.of_isClosed_subset isClosed_closure
    (quotientTSupport_raiseRaw_subset a f)

theorem HasQuotientCompactSupport.lowerRaw
    {f : ℍ → ℂ} (hf : HasQuotientCompactSupport f) (a : ℤ) :
    HasQuotientCompactSupport (lowerRaw a f) :=
  hf.of_isClosed_subset isClosed_closure
    (quotientTSupport_lowerRaw_subset a f)

theorem HasQuotientCompactSupport.laplaceRaw
    {f : ℍ → ℂ} (hf : HasQuotientCompactSupport f)
    (hs : RealSmooth f) (a : ℤ) :
    HasQuotientCompactSupport (laplaceRaw a f) :=
  hf.of_isClosed_subset isClosed_closure
    (quotientTSupport_laplaceRaw_subset a hs)

/-- The analytic domain common to all three raw operators: real-smooth
functions with compact support on the effective quotient.  No covariance is
asserted at this layer. -/
def smoothQuotientCompactSubmodule : Submodule ℂ SmoothFunction where
  carrier := {f | HasQuotientCompactSupport (f : ℍ → ℂ)}
  zero_mem' := by
    change HasQuotientCompactSupport (0 : ℍ → ℂ)
    exact HasQuotientCompactSupport.zero
  add_mem' := by
    rintro u v hu hv
    change HasQuotientCompactSupport
      ((u : ℍ → ℂ) + (v : ℍ → ℂ))
    exact hu.add hv
  smul_mem' := by
    rintro c u hu
    change HasQuotientCompactSupport (c • (u : ℍ → ℂ))
    exact hu.smul c

abbrev SmoothQuotientCompactFunction := smoothQuotientCompactSubmodule

/-- Evaluate a smooth quotient-compact function without relying on a
multi-step coercion through `SmoothFunction`. -/
instance : CoeFun SmoothQuotientCompactFunction (fun _ => ℍ → ℂ) where
  coe f := (f.1 : ℍ → ℂ)

/-- Raising is a linear endomorphism of the smooth quotient-compact analytic
domain. -/
noncomputable def raiseSmoothCompactLinear (a : ℤ) :
    SmoothQuotientCompactFunction →ₗ[ℂ] SmoothQuotientCompactFunction :=
  LinearMap.codRestrict smoothQuotientCompactSubmodule
    ((raiseSmoothLinear a).domRestrict smoothQuotientCompactSubmodule)
    (fun f => by
      change HasQuotientCompactSupport (raiseRaw a (f : ℍ → ℂ))
      exact HasQuotientCompactSupport.raiseRaw f.2 a)

/-- Lowering is a linear endomorphism of the smooth quotient-compact analytic
domain. -/
noncomputable def lowerSmoothCompactLinear (a : ℤ) :
    SmoothQuotientCompactFunction →ₗ[ℂ] SmoothQuotientCompactFunction :=
  LinearMap.codRestrict smoothQuotientCompactSubmodule
    ((lowerSmoothLinear a).domRestrict smoothQuotientCompactSubmodule)
    (fun f => by
      change HasQuotientCompactSupport (lowerRaw a (f : ℍ → ℂ))
      exact HasQuotientCompactSupport.lowerRaw f.2 a)

/-- The compatible Laplacian is a linear endomorphism of the same analytic
domain. -/
noncomputable def laplaceSmoothCompactLinear (a : ℤ) :
    SmoothQuotientCompactFunction →ₗ[ℂ] SmoothQuotientCompactFunction :=
  LinearMap.codRestrict smoothQuotientCompactSubmodule
    ((laplaceSmoothLinear a).domRestrict smoothQuotientCompactSubmodule)
    (fun f => by
      change HasQuotientCompactSupport (laplaceRaw a (f : ℍ → ℂ))
      exact HasQuotientCompactSupport.laplaceRaw f.2 f.1.2 a)

@[simp]
theorem raiseSmoothCompactLinear_apply
    (a : ℤ) (f : SmoothQuotientCompactFunction) (z : ℍ) :
    ((raiseSmoothCompactLinear a f : SmoothQuotientCompactFunction) :
        ℍ → ℂ) z = raiseRaw a (f : ℍ → ℂ) z :=
  rfl

@[simp]
theorem lowerSmoothCompactLinear_apply
    (a : ℤ) (f : SmoothQuotientCompactFunction) (z : ℍ) :
    ((lowerSmoothCompactLinear a f : SmoothQuotientCompactFunction) :
        ℍ → ℂ) z = lowerRaw a (f : ℍ → ℂ) z :=
  rfl

@[simp]
theorem laplaceSmoothCompactLinear_apply
    (a : ℤ) (f : SmoothQuotientCompactFunction) (z : ℍ) :
    ((laplaceSmoothCompactLinear a f : SmoothQuotientCompactFunction) :
        ℍ → ℂ) z = laplaceRaw a (f : ℍ → ℂ) z :=
  rfl

/-! #### The PDF sign obstruction -/

/-- The universal extra term in the raising-chain-rule calculation when the
operator coefficient `r` differs from the covariance exponent `q`. -/
def raisingCovarianceDefect
    (q r c nu jPow u : ℂ) : ℂ :=
  2 * Complex.I * c * (q - r) * nu * jPow * u

theorem raisingCovarianceDefect_eq_zero_of_coefficient_eq
    (q c nu jPow u : ℂ) :
    raisingCovarianceDefect q q c nu jPow u = 0 := by
  simp [raisingCovarianceDefect]

/-- For the PDF's exponent `q=-1/2` and displayed coefficient `r=+1/2`,
the chain-rule defect is generally nonzero. -/
theorem paperDisplayedRaising_defect
    (c nu jPow u : ℂ) :
    raisingCovarianceDefect (-1 / 2) (1 / 2) c nu jPow u =
      -2 * Complex.I * c * nu * jPow * u := by
  simp [raisingCovarianceDefect]
  ring

theorem paperDisplayedRaising_defect_ne_zero
    {c nu jPow u : ℂ} (hc : c ≠ 0) (hnu : nu ≠ 0)
    (hj : jPow ≠ 0) (hu : u ≠ 0) :
    raisingCovarianceDefect (-1 / 2) (1 / 2) c nu jPow u ≠ 0 := by
  rw [paperDisplayedRaising_defect]
  exact mul_ne_zero
    (mul_ne_zero
      (mul_ne_zero
        (mul_ne_zero
          (mul_ne_zero (by norm_num) Complex.I_ne_zero) hc)
        hnu)
      hj)
    hu

/-- Exponent index of the PDF's displayed `j^(-1/2)` covariance. -/
def paperDisplayedExponentIndex : ℤ :=
  -1

@[simp]
theorem neg_paperDisplayedExponentIndex :
    -paperDisplayedExponentIndex = 1 := by
  norm_num [paperDisplayedExponentIndex]

/-- Reindex the paper certificate by the actual doubled covariance exponent. -/
def paperMultiplierAtExponent (P : PaperHalfWeightCertificate) :
    HalfIntegralMultiplier GammaTwoQuotientGeometry.GammaTwo
      (-paperDisplayedExponentIndex) := by
  simpa [paperDisplayedExponentIndex] using P.multiplier

/-- The only exponent residue class determined by the paper's base
half-weight: repeated raising/lowering moves `a = -1` by multiples of four. -/
def paperOrbitExponent (n : ℤ) : ℤ :=
  paperDisplayedExponentIndex + 4 * n

@[simp]
theorem paperOrbitExponent_zero : paperOrbitExponent 0 = -1 := by
  simp [paperOrbitExponent, paperDisplayedExponentIndex]

@[simp]
theorem paperOrbitExponent_add_one (n : ℤ) :
    paperOrbitExponent (n + 1) = paperOrbitExponent n + 4 := by
  simp [paperOrbitExponent]
  ring

@[simp]
theorem paperOrbitExponent_sub_one (n : ℤ) :
    paperOrbitExponent (n - 1) = paperOrbitExponent n - 4 := by
  simp [paperOrbitExponent]
  ring

@[simp]
theorem neg_paperOrbitExponent (n : ℤ) :
    -paperOrbitExponent n = 1 - 4 * n := by
  simp [paperOrbitExponent, paperDisplayedExponentIndex]
  ring

/-- The concrete fixed-phase inverse-eta multiplier on precisely the residue
orbit reached from the paper's half-weight.  This avoids postulating
unrelated multiplier families on the other three residue classes modulo
four. -/
noncomputable def inverseEtaPaperOrbitMultiplier
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) :
    HalfIntegralMultiplier Γ (-paperOrbitExponent n) where
  nu := (inverseEtaHalfOrbitMultiplier Γ n).nu
  nu_one := (inverseEtaHalfOrbitMultiplier Γ n).nu_one
  nu_norm := (inverseEtaHalfOrbitMultiplier Γ n).nu_norm
  sqrtFactor := (inverseEtaHalfOrbitMultiplier Γ n).sqrtFactor
  sqrtFactor_one := (inverseEtaHalfOrbitMultiplier Γ n).sqrtFactor_one
  sqrtFactor_sq := (inverseEtaHalfOrbitMultiplier Γ n).sqrtFactor_sq
  factor_cocycle := by
    intro γ δ z
    have hexp : -(-paperOrbitExponent n) = -(1 - 4 * n) := by
      simp [paperOrbitExponent, paperDisplayedExponentIndex]
      ring
    simpa only [hexp] using
      (inverseEtaHalfOrbitMultiplier Γ n).factor_cocycle γ δ z

@[simp]
theorem inverseEtaPaperOrbitMultiplier_factor
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaPaperOrbitMultiplier Γ n).factor γ z =
      (inverseEtaMultiplier Γ).factor γ z *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ ((2 : ℤ) * n) := by
  change
    (inverseEtaHalfOrbitMultiplier Γ n).nu γ *
        (inverseEtaHalfOrbitMultiplier Γ n).sqrtFactor γ z ^
          (-(-paperOrbitExponent n)) = _
  have hexp : -(-paperOrbitExponent n) = -(1 - 4 * n) := by
    simp [paperOrbitExponent, paperDisplayedExponentIndex]
    ring
  rw [hexp]
  exact inverseEtaHalfOrbitMultiplier_factor Γ n γ z

@[simp]
theorem inverseEtaPaperOrbitMultiplier_factor_add_one
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) (γ : Γ) (z : ℍ) :
    (inverseEtaPaperOrbitMultiplier Γ (n + 1)).factor γ z =
      (inverseEtaPaperOrbitMultiplier Γ n).factor γ z *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ (2 : ℕ) := by
  change
    (inverseEtaHalfOrbitMultiplier Γ (n + 1)).nu γ *
        (inverseEtaHalfOrbitMultiplier Γ (n + 1)).sqrtFactor γ z ^
          (-(-paperOrbitExponent (n + 1))) =
      ((inverseEtaHalfOrbitMultiplier Γ n).nu γ *
        (inverseEtaHalfOrbitMultiplier Γ n).sqrtFactor γ z ^
          (-(-paperOrbitExponent n))) *
        UpperHalfPlane.denom
          ((γ : SL(2, ℤ)) : GL (Fin 2) ℝ) z ^ (2 : ℕ)
  have hexp_succ : -(-paperOrbitExponent (n + 1)) = -(1 - 4 * (n + 1)) := by
    simp [paperOrbitExponent, paperDisplayedExponentIndex]
    ring
  have hexp : -(-paperOrbitExponent n) = -(1 - 4 * n) := by
    simp [paperOrbitExponent, paperDisplayedExponentIndex]
    ring
  rw [hexp_succ, hexp]
  exact inverseEtaHalfOrbitMultiplier_factor_add_one Γ n γ z

/-- Every member of the orbit has literally the same unitary eta phase; only
the branch-independent integral-weight denominator power changes. -/
@[simp]
theorem inverseEtaPaperOrbitMultiplier_nu
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) (γ : Γ) :
    (inverseEtaPaperOrbitMultiplier Γ n).nu γ =
      (inverseEtaMultiplier Γ).nu γ := by
  change (inverseEtaHalfOrbitMultiplier Γ n).nu γ = _
  rfl

/-- Typed covariant sections along the concrete fixed-phase paper orbit. -/
noncomputable abbrev InverseEtaPaperOrbitSection
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ) :=
  WeightSection (inverseEtaPaperOrbitMultiplier Γ n)

/-! #### Canonical fixed-phase `R/L`-stable core

The earlier `ExponentIndexedDifferentialCore` is deliberately an interface:
an inhabitant has to prove that its chosen domain is stable under the raw
operators.  For the concrete inverse-eta fixed-phase orbit one can instead
define the *maximal stable smooth compact core* directly.  An element at orbit
index `n` is a smooth quotient-compact function for which every finite word in
`R` and `L` has the covariance prescribed by the multiplier at the word's
target index.  Prefixing a word then proves operator-domain preservation by
construction.  This is a genuine submodule and gives actual typed linear
operators; it does not assume differentiability of an abstract multiplier.

The analytic bridge below proves one-step covariance of both raw operators.
Consequently induction on words reduces membership in the maximal stable core
to zeroth-word covariance.  The explicit invariant discriminant cutoff later
in the file supplies a nonzero orbit-zero member without a locally finite
Poincare-series certificate.
-/

/-- A finite word in the two first-order differential operators.  The head is
applied first, so `raise tail` evaluates `R` and then evaluates `tail`. -/
inductive FixedPhaseDifferentialWord where
  | nil
  | raise (tail : FixedPhaseDifferentialWord)
  | lower (tail : FixedPhaseDifferentialWord)

namespace FixedPhaseDifferentialWord

/-- Net displacement of a word in the integer orbit index. -/
@[simp]
def displacement : FixedPhaseDifferentialWord → ℤ
  | nil => 0
  | raise tail => 1 + displacement tail
  | lower tail => -1 + displacement tail

/-- Orbit index reached after applying a word. -/
def targetIndex (n : ℤ) (word : FixedPhaseDifferentialWord) : ℤ :=
  n + word.displacement

@[simp]
theorem targetIndex_nil (n : ℤ) : targetIndex n .nil = n := by
  simp [targetIndex]

@[simp]
theorem targetIndex_raise (n : ℤ) (tail : FixedPhaseDifferentialWord) :
    targetIndex n (.raise tail) = targetIndex (n + 1) tail := by
  simp [targetIndex]
  ring

@[simp]
theorem targetIndex_lower (n : ℤ) (tail : FixedPhaseDifferentialWord) :
    targetIndex n (.lower tail) = targetIndex (n - 1) tail := by
  simp [targetIndex]
  ring

/-- Exact doubled-weight arithmetic for an arbitrary finite differential
word.  This is registered as a simplification rule so later covariance
statements do not need to redo residue-class arithmetic. -/
@[simp]
theorem paperOrbitExponent_targetIndex
    (n : ℤ) (word : FixedPhaseDifferentialWord) :
    paperOrbitExponent (targetIndex n word) =
      paperOrbitExponent n + 4 * word.displacement := by
  simp [paperOrbitExponent, targetIndex]
  ring

/-- The multiplier index is the negative doubled exponent at every word
target. -/
@[simp]
theorem neg_paperOrbitExponent_targetIndex
    (n : ℤ) (word : FixedPhaseDifferentialWord) :
    -paperOrbitExponent (targetIndex n word) =
      -paperOrbitExponent n - 4 * word.displacement := by
  rw [paperOrbitExponent_targetIndex]
  ring

/-- Arbitrary finite `R/L` words preserve the eta phase literally; only the
integral denominator exponent and the typed multiplier index change. -/
@[simp]
theorem targetMultiplier_nu
    (Γ : Subgroup SL(2, ℤ)) (n : ℤ)
    (word : FixedPhaseDifferentialWord) (γ : Γ) :
    (inverseEtaPaperOrbitMultiplier Γ (targetIndex n word)).nu γ =
      (inverseEtaPaperOrbitMultiplier Γ n).nu γ := by
  rw [inverseEtaPaperOrbitMultiplier_nu,
    inverseEtaPaperOrbitMultiplier_nu]

/-- Evaluate a finite differential word on the already constructed smooth
quotient-compact raw domain.  Each letter uses the exponent at its source
orbit index. -/
noncomputable def eval :
    (n : ℤ) → FixedPhaseDifferentialWord →
      SmoothQuotientCompactFunction →ₗ[ℂ] SmoothQuotientCompactFunction
  | _n, .nil => LinearMap.id
  | n, .raise tail =>
      (eval (n + 1) tail).comp
        (raiseSmoothCompactLinear (paperOrbitExponent n))
  | n, .lower tail =>
      (eval (n - 1) tail).comp
        (lowerSmoothCompactLinear (paperOrbitExponent n))

@[simp]
theorem eval_nil_apply (n : ℤ) (f : SmoothQuotientCompactFunction) :
    eval n .nil f = f :=
  rfl

@[simp]
theorem eval_raise_apply (n : ℤ) (tail : FixedPhaseDifferentialWord)
    (f : SmoothQuotientCompactFunction) :
    eval n (.raise tail) f =
      eval (n + 1) tail
        (raiseSmoothCompactLinear (paperOrbitExponent n) f) :=
  rfl

@[simp]
theorem eval_lower_apply (n : ℤ) (tail : FixedPhaseDifferentialWord)
    (f : SmoothQuotientCompactFunction) :
    eval n (.lower tail) f =
      eval (n - 1) tail
        (lowerSmoothCompactLinear (paperOrbitExponent n) f) :=
  rfl

end FixedPhaseDifferentialWord

/-- Covariance at one member of the fixed-phase inverse-eta orbit. -/
def IsInverseEtaPaperOrbitCovariant
    (n : ℤ) (f : SmoothQuotientCompactFunction) : Prop :=
  ∀ (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ),
    (f : ℍ → ℂ) ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n).factor γ z *
        (f : ℍ → ℂ) z

namespace IsInverseEtaPaperOrbitCovariant

theorem zero (n : ℤ) :
    IsInverseEtaPaperOrbitCovariant n
      (0 : SmoothQuotientCompactFunction) := by
  intro γ z
  simp [IsInverseEtaPaperOrbitCovariant]

theorem add {n : ℤ} {f g : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (hg : IsInverseEtaPaperOrbitCovariant n g) :
    IsInverseEtaPaperOrbitCovariant n (f + g) := by
  intro γ z
  change
    (f : ℍ → ℂ) ((γ : SL(2, ℤ)) • z) +
        (g : ℍ → ℂ) ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n).factor γ z *
        ((f : ℍ → ℂ) z + (g : ℍ → ℂ) z)
  rw [hf γ z, hg γ z]
  ring

theorem smul {n : ℤ} (c : ℂ) {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f) :
    IsInverseEtaPaperOrbitCovariant n (c • f) := by
  intro γ z
  change
    c * (f : ℍ → ℂ) ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n).factor γ z *
        (c * (f : ℍ → ℂ) z)
  rw [hf γ z]
  ring

end IsInverseEtaPaperOrbitCovariant

/-! #### The analytic fixed-phase covariance bridge

The stable-core definition below is useful only after one proves that the raw
coordinate operators really preserve the stated multiplier covariance.  The
next lemmas do that from the explicit inverse-eta factor.  The proof keeps the
real `C^∞` chart visible: first the fixed-phase factor is shown smooth and
its exact logarithmic derivative is computed; then the real Fréchet chain
rule for a Möbius transformation is combined with the two Wirtinger
directions. -/

/-- The affine denominator attached to an element of `Gamma(2)`. -/
def inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) : ℂ :=
  UpperHalfPlane.denom
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ) z

/-- The lower-left matrix coefficient, regarded in the complex coefficient
field. -/
def inverseEtaPaperOrbitLowerLeft
    (γ : GammaTwoQuotientGeometry.GammaTwo) : ℂ :=
  (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ) 1 0 : ℝ) : ℂ)

/-! ##### Public smooth phase and square-root API -/

/-- The principal square root selected in the concrete eta multiplier is
genuinely real `C∞` on the upper half-plane.  When the lower-left entry is
nonzero its affine denominator stays in the complex slit plane; when that
entry is zero the square root is constant.  Thus no differentiability is
inferred merely from the earlier continuity theorem. -/
theorem etaSqrtFactor_realSmooth (γ : SL(2, ℤ)) :
    RealSmooth (etaSqrtFactor γ) := by
  let g : GL (Fin 2) ℝ := γ
  by_cases hc : g 1 0 = 0
  · unfold RealSmooth
    have hConst : ContDiffOn ℝ ∞
        (fun _ : ℂ => Complex.sqrt (g 1 1))
        UpperHalfPlane.upperHalfPlaneSet :=
      contDiffOn_const
    exact hConst.congr (fun w hw => by
      simp [upperLift, etaSqrtFactor, g, UpperHalfPlane.denom, hc,
        Function.comp_def])
  · have hDifferentiable : DifferentiableOn ℂ
        (fun w : ℂ => Complex.sqrt (UpperHalfPlane.denom g w))
        UpperHalfPlane.upperHalfPlaneSet := by
      intro w hw
      have hDenom : DifferentiableAt ℂ
          (fun u : ℂ => UpperHalfPlane.denom g u) w := by
        unfold UpperHalfPlane.denom
        fun_prop
      have hIm : (UpperHalfPlane.denom g w).im ≠ 0 := by
        simpa [UpperHalfPlane.denom] using
          mul_ne_zero hc (ne_of_gt hw)
      exact ((Complex.differentiableAt_sqrt
        (Complex.mem_slitPlane_iff.mpr (Or.inr hIm))).comp w hDenom).differentiableWithinAt
    have hSmooth : ContDiffOn ℝ ∞
        (fun w : ℂ => Complex.sqrt (UpperHalfPlane.denom g w))
        UpperHalfPlane.upperHalfPlaneSet :=
      (hDifferentiable.analyticOnNhd
        UpperHalfPlane.isOpen_upperHalfPlaneSet).restrictScalars.contDiffOn_of_completeSpace
    unfold RealSmooth
    exact hSmooth.congr (fun w hw => by
      simp [upperLift, etaSqrtFactor, g, Function.comp_def,
        UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- The fixed eta phase, displayed as a function of the upper-half-plane
variable so that its vanishing differential can be reused directly in chain
rule calculations. -/
noncomputable def inverseEtaPaperOrbitPhaseFunction
    (γ : GammaTwoQuotientGeometry.GammaTwo) (_z : ℍ) : ℂ :=
  (inverseEtaMultiplier GammaTwoQuotientGeometry.GammaTwo).nu γ

@[simp]
theorem inverseEtaPaperOrbitPhaseFunction_apply
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitPhaseFunction γ z =
      (inverseEtaMultiplier GammaTwoQuotientGeometry.GammaTwo).nu γ :=
  rfl

/-- Every physical orbit index uses the same phase function. -/
@[simp]
theorem inverseEtaPaperOrbitPhaseFunction_eq_multiplier
    (n : ℤ) (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitPhaseFunction γ z =
      (inverseEtaPaperOrbitMultiplier
        GammaTwoQuotientGeometry.GammaTwo n).nu γ := by
  rw [inverseEtaPaperOrbitMultiplier_nu]
  rfl

theorem inverseEtaPaperOrbitPhaseFunction_realSmooth
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    RealSmooth (inverseEtaPaperOrbitPhaseFunction γ) := by
  unfold RealSmooth inverseEtaPaperOrbitPhaseFunction
  simpa [upperLift, Function.comp_def] using
    (contDiffOn_const : ContDiffOn ℝ ∞
      (fun _ : ℂ =>
        (inverseEtaMultiplier
          GammaTwoQuotientGeometry.GammaTwo).nu γ)
      UpperHalfPlane.upperHalfPlaneSet)

@[simp]
theorem d1_inverseEtaPaperOrbitPhaseFunction
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    d1 (inverseEtaPaperOrbitPhaseFunction γ) z ξ = 0 := by
  unfold d1 inverseEtaPaperOrbitPhaseFunction upperLift
  change
    (fderiv ℝ
      (fun _ : ℂ =>
        (inverseEtaMultiplier
          GammaTwoQuotientGeometry.GammaTwo).nu γ)
      (z : ℂ)) ξ = 0
  rw [(hasFDerivAt_const
    ((inverseEtaMultiplier
      GammaTwoQuotientGeometry.GammaTwo).nu γ)
    (z : ℂ)).fderiv]
  rfl

@[simp]
theorem dx_inverseEtaPaperOrbitPhaseFunction
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dx (inverseEtaPaperOrbitPhaseFunction γ) z = 0 := by
  simp [dx]

@[simp]
theorem dy_inverseEtaPaperOrbitPhaseFunction
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dy (inverseEtaPaperOrbitPhaseFunction γ) z = 0 := by
  simp [dy]

/-- The actual total automorphy factor at one index of the inverse-eta orbit. -/
noncomputable def inverseEtaPaperOrbitFactor (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) : ℂ :=
  (inverseEtaPaperOrbitMultiplier
      GammaTwoQuotientGeometry.GammaTwo n).factor γ z

@[simp]
theorem inverseEtaPaperOrbitFactor_eq_eta (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitFactor n γ z =
      ModularForm.eta (z : ℂ) /
          ModularForm.eta ((((γ : GammaTwoQuotientGeometry.GammaTwo) :
            SL(2, ℤ)) • z : ℍ) : ℂ) *
        inverseEtaPaperOrbitDenom γ z ^ ((2 : ℤ) * n) := by
  rw [inverseEtaPaperOrbitFactor,
    inverseEtaPaperOrbitMultiplier_factor,
    inverseEtaMultiplier_factor]
  rfl

theorem inverseEtaPaperOrbitDenom_ne_zero
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitDenom γ z ≠ 0 :=
  UpperHalfPlane.denom_ne_zero
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ) z

theorem inverseEtaPaperOrbitFactor_ne_zero (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitFactor n γ z ≠ 0 :=
  (inverseEtaPaperOrbitMultiplier
    GammaTwoQuotientGeometry.GammaTwo n).factor_ne_zero γ z

/-- The determinant of the real matrix underlying an integral
special-linear element is positive. -/
theorem inverseEtaPaperOrbit_det_pos
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    0 < (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)).val.det) := by
  rw [← Matrix.GeneralLinearGroup.val_det_apply]
  norm_num


/-- The real determinant of an integral special-linear element is one. -/
@[simp] theorem inverseEtaPaperOrbit_det_eq_one
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)).val.det) = 1 := by
  rw [← Matrix.GeneralLinearGroup.val_det_apply]
  norm_num

/-- The explicit eta-ratio formula makes the total fixed-phase factor
real-smooth.  The argument differentiates the eta function and the genuine
Möbius action on the open upper half-plane; continuity of a chosen square-root
branch is not used as a surrogate for differentiability. -/
theorem inverseEtaPaperOrbitFactor_realSmooth (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    RealSmooth (inverseEtaPaperOrbitFactor n γ) := by
  let g : GL (Fin 2) ℝ :=
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)
  let explicitFactor : ℂ → ℂ := fun w ↦
    ModularForm.eta w /
        ModularForm.eta ((g • UpperHalfPlane.ofComplex w : ℍ) : ℂ) *
      UpperHalfPlane.denom g w ^ ((2 : ℤ) * n)
  have hDifferentiable : DifferentiableOn ℂ explicitFactor
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    have hAction : DifferentiableAt ℂ
        (fun u : ℂ ↦ ((g • UpperHalfPlane.ofComplex u : ℍ) : ℂ)) w := by
      simpa [g] using
        (UpperHalfPlane.hasStrictDerivAt_smul
          (inverseEtaPaperOrbit_det_pos γ)
          (⟨w, hw⟩ : ℍ)).hasDerivAt.differentiableAt
    have hEtaSource : DifferentiableAt ℂ ModularForm.eta w :=
      ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet hw
    have hTargetMem :
        (((g • UpperHalfPlane.ofComplex w : ℍ) : ℂ) ∈
          UpperHalfPlane.upperHalfPlaneSet) :=
      (g • UpperHalfPlane.ofComplex w : ℍ).im_pos
    have hEtaTarget : DifferentiableAt ℂ
        (fun u : ℂ ↦ ModularForm.eta
          ((g • UpperHalfPlane.ofComplex u : ℍ) : ℂ)) w := by
      change DifferentiableAt ℂ
        (ModularForm.eta ∘
          fun u : ℂ ↦ ((g • UpperHalfPlane.ofComplex u : ℍ) : ℂ)) w
      exact
        (ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet
          hTargetMem).comp w hAction
    have hDenom : DifferentiableAt ℂ
        (fun u : ℂ ↦ UpperHalfPlane.denom g u) w := by
      unfold UpperHalfPlane.denom
      fun_prop
    exact ((hEtaSource.div hEtaTarget
      (ModularForm.eta_ne_zero hTargetMem)).mul
          (hDenom.zpow (Or.inl
            (UpperHalfPlane.denom_ne_zero g (⟨w, hw⟩ : ℍ))))).differentiableWithinAt
  have hSmooth : ContDiffOn ℝ ∞ explicitFactor
      UpperHalfPlane.upperHalfPlaneSet :=
    (hDifferentiable.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).restrictScalars.contDiffOn_of_completeSpace
  unfold RealSmooth
  exact hSmooth.congr (fun w hw ↦ by
    have hAction :
        g • (⟨w, hw⟩ : ℍ) =
          ((γ : SL(2, ℤ)) • (⟨w, hw⟩ : ℍ)) := by
      simpa [g, GammaTwoQuotientGeometry.gammaTwoToSL2Real] using
        (GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul
          γ (⟨w, hw⟩ : ℍ))
    rw [upperLift, Function.comp_apply,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw]
    rw [inverseEtaPaperOrbitFactor_eq_eta]
    simp only [explicitFactor, inverseEtaPaperOrbitDenom,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw]
    rw [hAction])

/-- Every integral power of the affine denominator is real-smooth on the
upper half-plane, including negative powers. -/
theorem inverseEtaPaperOrbitDenom_zpow_realSmooth
    (m : ℤ) (γ : GammaTwoQuotientGeometry.GammaTwo) :
    RealSmooth (fun z ↦ inverseEtaPaperOrbitDenom γ z ^ m) := by
  let g : GL (Fin 2) ℝ :=
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)
  have hDifferentiable : DifferentiableOn ℂ
      (fun w : ℂ ↦ UpperHalfPlane.denom g w ^ m)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    have hDenom : DifferentiableAt ℂ
        (fun u : ℂ ↦ UpperHalfPlane.denom g u) w := by
      unfold UpperHalfPlane.denom
      fun_prop
    exact (hDenom.zpow (Or.inl
      (UpperHalfPlane.denom_ne_zero g (⟨w, hw⟩ : ℍ)))).differentiableWithinAt
  have hSmooth : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ UpperHalfPlane.denom g w ^ m)
      UpperHalfPlane.upperHalfPlaneSet :=
    (hDifferentiable.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).restrictScalars.contDiffOn_of_completeSpace
  unfold RealSmooth
  exact hSmooth.congr (fun w hw ↦ by
    simp [upperLift, inverseEtaPaperOrbitDenom, g,
      Function.comp_def, UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- Exact real directional derivative of an arbitrary integral denominator
power. -/
theorem d1_inverseEtaPaperOrbitDenom_zpow
    (m : ℤ) (γ : GammaTwoQuotientGeometry.GammaTwo)
    (z : ℍ) (ξ : ℂ) :
    d1 (fun w ↦ inverseEtaPaperOrbitDenom γ w ^ m) z ξ =
      (m : ℂ) * inverseEtaPaperOrbitDenom γ z ^ (m - 1) *
        inverseEtaPaperOrbitLowerLeft γ * ξ := by
  let g : GL (Fin 2) ℝ :=
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)
  have hPower : HasDerivAt
      (fun w : ℂ ↦ UpperHalfPlane.denom g w ^ m)
      ((m : ℂ) * UpperHalfPlane.denom g z ^ (m - 1) *
        (g 1 0 : ℂ)) (z : ℂ) := by
    simpa [mul_comm, mul_left_comm, mul_assoc] using
      UpperHalfPlane.hasDerivAt_denom_zpow g m z
  have hLocal :
      upperLift (fun w ↦ inverseEtaPaperOrbitDenom γ w ^ m) =ᶠ[nhds (z : ℂ)]
        (fun w : ℂ ↦ UpperHalfPlane.denom g w ^ m) := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    simp [upperLift, inverseEtaPaperOrbitDenom, g, Function.comp_def,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw]
  unfold d1
  rw [hLocal.fderiv_eq]
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ ↦ L ξ)
    hPower.complexToReal_fderiv.fderiv
  simpa [inverseEtaPaperOrbitDenom, inverseEtaPaperOrbitLowerLeft,
    g, smul_eq_mul, mul_assoc] using hApply

/-- The affine denominator itself is real `C∞`. -/
theorem inverseEtaPaperOrbitDenom_realSmooth
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    RealSmooth (inverseEtaPaperOrbitDenom γ) := by
  simpa using inverseEtaPaperOrbitDenom_zpow_realSmooth (1 : ℤ) γ

/-- Exact real directional derivative of `c z + d`. -/
@[simp]
theorem d1_inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    d1 (inverseEtaPaperOrbitDenom γ) z ξ =
      inverseEtaPaperOrbitLowerLeft γ * ξ := by
  simpa using d1_inverseEtaPaperOrbitDenom_zpow (1 : ℤ) γ z ξ

@[simp]
theorem dx_inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dx (inverseEtaPaperOrbitDenom γ) z =
      inverseEtaPaperOrbitLowerLeft γ := by
  simpa [dx] using d1_inverseEtaPaperOrbitDenom γ z (1 : ℂ)

@[simp]
theorem dy_inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dy (inverseEtaPaperOrbitDenom γ) z =
      inverseEtaPaperOrbitLowerLeft γ * Complex.I := by
  simpa [dy] using d1_inverseEtaPaperOrbitDenom γ z Complex.I

/-- The conventional holomorphic Wirtinger coordinate `∂/∂z`. -/
noncomputable def wirtingerZ (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  (dx f z - Complex.I * dy f z) / 2

/-- The conventional antiholomorphic Wirtinger coordinate `∂/∂zbar`. -/
noncomputable def wirtingerBar (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  (dx f z + Complex.I * dy f z) / 2

/-- The affine denominator is holomorphic with exact `z` derivative `c`. -/
@[simp]
theorem wirtingerZ_inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    wirtingerZ (inverseEtaPaperOrbitDenom γ) z =
      inverseEtaPaperOrbitLowerLeft γ := by
  unfold wirtingerZ
  rw [dx_inverseEtaPaperOrbitDenom, dy_inverseEtaPaperOrbitDenom]
  ring_nf
  simp [Complex.I_sq]
  <;> ring

/-- The affine denominator has zero `zbar` derivative. -/
@[simp]
theorem wirtingerBar_inverseEtaPaperOrbitDenom
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    wirtingerBar (inverseEtaPaperOrbitDenom γ) z = 0 := by
  unfold wirtingerBar
  rw [dx_inverseEtaPaperOrbitDenom, dy_inverseEtaPaperOrbitDenom]
  ring_nf
  simp [Complex.I_sq]
  <;> ring

/-- Squaring the explicit fixed-phase factor eliminates its square root and
leaves the ordinary denominator to precisely the physical exponent. -/
theorem inverseEtaPaperOrbitFactor_sq (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitFactor n γ z ^ 2 =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n).nu γ ^ 2 *
        inverseEtaPaperOrbitDenom γ z ^ paperOrbitExponent n := by
  simpa [inverseEtaPaperOrbitFactor, inverseEtaPaperOrbitDenom,
    paperOrbitExponent, paperDisplayedExponentIndex] using
    (HalfIntegralMultiplier.factor_sq
      (inverseEtaPaperOrbitMultiplier
        GammaTwoQuotientGeometry.GammaTwo n) γ z)

theorem physicalExponent_eq_intCast_div_two (a : ℤ) :
    physicalExponent a = (a : ℂ) / 2 := by
  norm_num [physicalExponent]

@[simp]
theorem physicalExponent_paperOrbit_add_one (n : ℤ) :
    physicalExponent (paperOrbitExponent (n + 1)) =
      physicalExponent (paperOrbitExponent n) + 2 := by
  rw [paperOrbitExponent_add_one,
    physicalExponent_eq_intCast_div_two,
    physicalExponent_eq_intCast_div_two]
  push_cast
  ring

@[simp]
theorem physicalExponent_paperOrbit_sub_one (n : ℤ) :
    physicalExponent (paperOrbitExponent (n - 1)) =
      physicalExponent (paperOrbitExponent n) - 2 := by
  rw [paperOrbitExponent_sub_one,
    physicalExponent_eq_intCast_div_two,
    physicalExponent_eq_intCast_div_two]
  push_cast
  ring

/-- Physical half-weight arithmetic after an arbitrary finite word. -/
theorem physicalExponent_paperOrbit_targetIndex
    (n : ℤ) (word : FixedPhaseDifferentialWord) :
    physicalExponent
        (paperOrbitExponent (FixedPhaseDifferentialWord.targetIndex n word)) =
      physicalExponent (paperOrbitExponent n) +
        2 * (word.displacement : ℂ) := by
  rw [physicalExponent_eq_intCast_div_two,
    FixedPhaseDifferentialWord.paperOrbitExponent_targetIndex,
    physicalExponent_eq_intCast_div_two]
  push_cast
  ring

/-- Exact logarithmic derivative of the total fixed-phase factor.  In
particular, its eta phase contributes no derivative and the coefficient is
the genuine physical exponent `a/2`. -/
theorem d1_inverseEtaPaperOrbitFactor (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    d1 (inverseEtaPaperOrbitFactor n γ) z ξ =
      physicalExponent (paperOrbitExponent n) *
        inverseEtaPaperOrbitLowerLeft γ /
          inverseEtaPaperOrbitDenom γ z * ξ *
            inverseEtaPaperOrbitFactor n γ z := by
  let F := inverseEtaPaperOrbitFactor n γ z
  let C := (inverseEtaPaperOrbitMultiplier
    GammaTwoQuotientGeometry.GammaTwo n).nu γ ^ 2
  let j := inverseEtaPaperOrbitDenom γ z
  let c := inverseEtaPaperOrbitLowerLeft γ
  let m := paperOrbitExponent n
  let dF := d1 (inverseEtaPaperOrbitFactor n γ) z ξ
  have hFsm := inverseEtaPaperOrbitFactor_realSmooth n γ
  have hJsm := inverseEtaPaperOrbitDenom_zpow_realSmooth m γ
  have hFunction :
      inverseEtaPaperOrbitFactor n γ *
          inverseEtaPaperOrbitFactor n γ =
        C • (fun w ↦ inverseEtaPaperOrbitDenom γ w ^ m) := by
    funext w
    simpa [F, C, j, c, m, pow_two, Pi.mul_apply, Pi.smul_apply,
      smul_eq_mul] using inverseEtaPaperOrbitFactor_sq n γ w
  have hDerivative := congrArg (fun h : ℍ → ℂ ↦ d1 h z ξ) hFunction
  rw [d1_mul hFsm hFsm, d1_smul C hJsm,
    d1_inverseEtaPaperOrbitDenom_zpow] at hDerivative
  have hSq : F ^ 2 = C * j ^ m := by
    simpa [F, C, j, m] using inverseEtaPaperOrbitFactor_sq n γ z
  have hF0 : F ≠ 0 := by
    simpa [F] using inverseEtaPaperOrbitFactor_ne_zero n γ z
  have hj0 : j ≠ 0 := by
    simpa [j] using inverseEtaPaperOrbitDenom_ne_zero γ z
  have hDerivative' :
      dF * F + F * dF = C * (m : ℂ) * j ^ (m - 1) * c * ξ := by
    simpa [F, C, j, c, m, dF, Pi.mul_apply, Pi.smul_apply,
      smul_eq_mul, mul_assoc] using hDerivative
  apply mul_left_cancel₀ hF0
  calc
    F * dF = (dF * F + F * dF) / 2 := by ring
    _ = (C * (m : ℂ) * j ^ (m - 1) * c * ξ) / 2 := by
      rw [hDerivative']
    _ = ((m : ℂ) / 2) * c * ξ * (C * j ^ m) * j⁻¹ := by
      rw [zpow_sub_one₀ hj0]
      ring
    _ = ((m : ℂ) / 2) * c * ξ * F ^ 2 * j⁻¹ := by
      rw [hSq]
    _ = F * (physicalExponent m * c / j * ξ * F) := by
      rw [physicalExponent_eq_intCast_div_two]
      simp only [div_eq_mul_inv]
      ring

@[simp]
theorem dx_inverseEtaPaperOrbitFactor (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dx (inverseEtaPaperOrbitFactor n γ) z =
      physicalExponent (paperOrbitExponent n) *
        inverseEtaPaperOrbitLowerLeft γ /
          inverseEtaPaperOrbitDenom γ z *
            inverseEtaPaperOrbitFactor n γ z := by
  simpa [dx] using d1_inverseEtaPaperOrbitFactor n γ z (1 : ℂ)

@[simp]
theorem dy_inverseEtaPaperOrbitFactor (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    dy (inverseEtaPaperOrbitFactor n γ) z =
      physicalExponent (paperOrbitExponent n) *
        inverseEtaPaperOrbitLowerLeft γ /
          inverseEtaPaperOrbitDenom γ z * Complex.I *
            inverseEtaPaperOrbitFactor n γ z := by
  simpa [dy] using
    d1_inverseEtaPaperOrbitFactor n γ z Complex.I

/-- A real-linear map on `C` is determined by its values on `1` and `i`. -/
private theorem realCLM_apply_complex_decomposition
    (D : ℂ →L[ℝ] ℂ) (α : ℂ) :
    D α = (α.re : ℂ) * D 1 + (α.im : ℂ) * D Complex.I := by
  have hα : α = α.re • (1 : ℂ) + α.im • Complex.I := by
    apply Complex.ext <;> simp
  calc
    D α = D (α.re • (1 : ℂ) + α.im • Complex.I) := congrArg D hα
    _ = (α.re : ℂ) * D 1 + (α.im : ℂ) * D Complex.I := by
      rw [map_add, map_smul, map_smul]
      simp [Complex.real_smul]

/-- Holomorphic Wirtinger combination after precomposition by complex
multiplication. -/
private theorem realCLM_holomorphic_wirtinger
    (D : ℂ →L[ℝ] ℂ) (α : ℂ) :
    Complex.I * D α + D (α * Complex.I) =
      α * (Complex.I * D 1 + D Complex.I) := by
  rw [realCLM_apply_complex_decomposition D α,
    realCLM_apply_complex_decomposition D (α * Complex.I)]
  apply Complex.ext <;>
    simp [Complex.mul_re, Complex.mul_im, Complex.I_sq] <;> ring

/-- Antiholomorphic Wirtinger combination after precomposition by complex
multiplication. -/
private theorem realCLM_antiholomorphic_wirtinger
    (D : ℂ →L[ℝ] ℂ) (α : ℂ) :
    -Complex.I * D α + D (α * Complex.I) =
      star α * (-Complex.I * D 1 + D Complex.I) := by
  rw [realCLM_apply_complex_decomposition D α,
    realCLM_apply_complex_decomposition D (α * Complex.I)]
  apply Complex.ext <;>
    simp [Complex.mul_re, Complex.mul_im, Complex.I_sq] <;> ring

/-! ##### The Möbius derivative itself -/

/-- The genuine complex coordinate of the `Gamma(2)` Möbius action. -/
noncomputable def gammaTwoMoebiusCoordinate
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) : ℂ :=
  (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z) : ℍ) : ℂ)

/-- The upper-half-plane action is literally the classical fractional-linear
formula `(a z + b) / (c z + d)`; the four entries remain visible so later
coordinate calculations do not have to unfold the action implementation. -/
theorem gammaTwoMoebiusCoordinate_eq_fraction
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    gammaTwoMoebiusCoordinate γ z =
      (((algebraMap ℤ ℝ
            (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) 0 0) : ℂ) *
          (z : ℂ) +
          (algebraMap ℤ ℝ
            (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) 0 1) : ℂ)) /
        ((algebraMap ℤ ℝ
            (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) 1 0) : ℂ) *
          (z : ℂ) +
          (algebraMap ℤ ℝ
            (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) 1 1) : ℂ))) := by
  simpa only [gammaTwoMoebiusCoordinate] using
    (UpperHalfPlane.coe_specialLinearGroup_apply
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ))) z)

/-- The same coordinate in the ambient open upper-half-plane chart. -/
noncomputable def gammaTwoMoebiusChart
    (γ : GammaTwoQuotientGeometry.GammaTwo) (w : ℂ) : ℂ :=
  gammaTwoMoebiusCoordinate γ (UpperHalfPlane.ofComplex w)

/-- Exact complex derivative of `z ↦ (a z + b)/(c z + d)` for an element of
`Gamma(2)`: the determinant is one, hence the derivative is
`1 / (c z + d)^2`. -/
theorem gammaTwoMoebiusChart_hasStrictDerivAt
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    HasStrictDerivAt (gammaTwoMoebiusChart γ)
      (1 / inverseEtaPaperOrbitDenom γ z ^ 2) (z : ℂ) := by
  let g : GL (Fin 2) ℝ :=
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)
  have hdet : g.val.det = 1 := by
    simpa [g] using inverseEtaPaperOrbit_det_eq_one γ
  have hg : 0 < g.det.val := by
    simpa [g] using inverseEtaPaperOrbit_det_pos γ
  have hdetC : (g.val.det : ℂ) = 1 := by
    exact_mod_cast hdet
  have hfun : gammaTwoMoebiusChart γ =
      fun w : ℂ => ((g • UpperHalfPlane.ofComplex w : ℍ) : ℂ) := by
    funext w
    rfl
  have hdenom : inverseEtaPaperOrbitDenom γ z =
      UpperHalfPlane.denom g z := by
    rfl
  have hraw := UpperHalfPlane.hasStrictDerivAt_smul (g := g) hg z
  rw [hdetC] at hraw
  simpa [hfun, hdenom, one_div] using hraw

/-- The ordinary complex derivative form of the Möbius formula. -/
@[simp]
theorem deriv_gammaTwoMoebiusChart
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    deriv (gammaTwoMoebiusChart γ) (z : ℂ) =
      1 / inverseEtaPaperOrbitDenom γ z ^ 2 :=
  (gammaTwoMoebiusChart_hasStrictDerivAt γ z).hasDerivAt.deriv

/-- The Möbius coordinate is real `C∞` on the upper-half-plane subtype. -/
theorem gammaTwoMoebiusCoordinate_realSmooth
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    RealSmooth (gammaTwoMoebiusCoordinate γ) := by
  have hDifferentiable : DifferentiableOn ℂ (gammaTwoMoebiusChart γ)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    have hDeriv :=
      (gammaTwoMoebiusChart_hasStrictDerivAt γ
        (⟨w, hw⟩ : ℍ)).hasDerivAt.differentiableAt
    exact hDeriv.differentiableWithinAt
  have hSmooth : ContDiffOn ℝ ∞ (gammaTwoMoebiusChart γ)
      UpperHalfPlane.upperHalfPlaneSet :=
    (hDifferentiable.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).restrictScalars.contDiffOn_of_completeSpace
  change ContDiffOn ℝ ∞ (gammaTwoMoebiusChart γ)
    UpperHalfPlane.upperHalfPlaneSet
  exact hSmooth

/-- Real directional form of the same derivative on the upper-half-plane
subtype.  This is the primitive input used by the general chain rule below. -/
theorem d1_gammaTwoMoebiusCoordinate
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    d1 (gammaTwoMoebiusCoordinate γ) z ξ =
      ξ / inverseEtaPaperOrbitDenom γ z ^ 2 := by
  have hDeriv :=
    (gammaTwoMoebiusChart_hasStrictDerivAt γ z).hasDerivAt
  have hFderiv := hDeriv.complexToReal_fderiv.fderiv
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hFderiv
  unfold d1
  change fderiv ℝ (gammaTwoMoebiusChart γ) (z : ℂ) ξ = _
  simpa [smul_eq_mul, div_eq_mul_inv, mul_comm, mul_left_comm,
    mul_assoc] using hApply

/-- Exact real Fréchet chain rule for precomposition by an integral
special-linear Möbius transformation. -/
theorem d1_comp_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) (ξ : ℂ) :
    d1 (fun w ↦ f (((γ : GammaTwoQuotientGeometry.GammaTwo) :
        SL(2, ℤ)) • w)) z ξ =
      d1 f ((((γ : GammaTwoQuotientGeometry.GammaTwo) :
        SL(2, ℤ)) • z))
        (ξ / inverseEtaPaperOrbitDenom γ z ^ 2) := by
  let g : GL (Fin 2) ℝ :=
    (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) :
      GL (Fin 2) ℝ)
  let G : ℂ → ℂ := fun w ↦
    ((g • UpperHalfPlane.ofComplex w : ℍ) : ℂ)
  have hG : HasFDerivAt G
      (UpperHalfPlane.smulFDeriv g (z : ℂ)) (z : ℂ) := by
    simpa [G] using
      (UpperHalfPlane.hasStrictFDerivAt_smul g z).hasFDerivAt
  have hG_apply (η : ℂ) :
      UpperHalfPlane.smulFDeriv g (z : ℂ) η =
        (1 / inverseEtaPaperOrbitDenom γ z ^ 2) * η := by
    have hg : 0 < g.det.val := by
      simpa [g] using inverseEtaPaperOrbit_det_pos γ
    simp [UpperHalfPlane.smulFDeriv, UpperHalfPlane.σ, hg,
      inverseEtaPaperOrbitDenom, inverseEtaPaperOrbit_det_eq_one,
      g, smul_eq_mul, mul_comm]
  have hOuter : DifferentiableAt ℝ (upperLift f) (G (z : ℂ)) := by
    have hSmooth := RealSmooth.contDiffAt_upperLift hf
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)
    simpa [G, g,
      GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul] using
      hSmooth.differentiableAt (by simp)
  have hComp := hOuter.hasFDerivAt.comp (z : ℂ) hG
  have hLocal :
      upperLift (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) =ᶠ[
          nhds (z : ℂ)] upperLift f ∘ G := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    simp [upperLift, Function.comp_def, G, g,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw,
      GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul]
  unfold d1
  rw [hLocal.fderiv_eq]
  have hApply := congrArg (fun L : ℂ →L[ℝ] ℂ ↦ L ξ) hComp.fderiv
  simp only [ContinuousLinearMap.comp_apply] at hApply
  rw [hG_apply] at hApply
  simpa [G, smul_eq_mul, div_eq_mul_inv, mul_comm, mul_left_comm,
    mul_assoc] using hApply

/-- The holomorphic first-order direction transforms with `j^{-2}`. -/
theorem holomorphicDirectional_comp_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    Complex.I * dx (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z +
      dy (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      (inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
        (Complex.I * dx f
          ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
          dy f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))) := by
  rw [show dx (fun w ↦ f
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      d1 f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
        ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) by
      simpa [dx, div_eq_mul_inv] using
        d1_comp_gammaTwo_smul γ hf z (1 : ℂ),
    show dy (fun w ↦ f
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      d1 f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
        ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ * Complex.I) by
      simpa [dy, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
        d1_comp_gammaTwo_smul γ hf z Complex.I]
  exact realCLM_holomorphic_wirtinger
    (fderiv ℝ (upperLift f)
      (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z) : ℍ) : ℂ))
    ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹)

/-- The antiholomorphic first-order direction transforms with the conjugate
of `j^{-2}`. -/
theorem antiholomorphicDirectional_comp_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    -Complex.I * dx (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z +
      dy (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
        (-Complex.I * dx f
          ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
          dy f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))) := by
  rw [show dx (fun w ↦ f
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      d1 f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
        ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) by
      simpa [dx, div_eq_mul_inv] using
        d1_comp_gammaTwo_smul γ hf z (1 : ℂ),
    show dy (fun w ↦ f
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      d1 f ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
        ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ * Complex.I) by
      simpa [dy, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
        d1_comp_gammaTwo_smul γ hf z Complex.I]
  exact realCLM_antiholomorphic_wirtinger
    (fderiv ℝ (upperLift f)
      (((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z) : ℍ) : ℂ))
    ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹)

/-- Wirtinger chain rule for `∂/∂z` on the upper-half-plane subtype. -/
theorem wirtingerZ_comp_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    wirtingerZ (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      (inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
        wirtingerZ f
          ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) := by
  have h := holomorphicDirectional_comp_gammaTwo_smul γ hf z
  unfold wirtingerZ
  calc
    (dx (fun w ↦ f
          (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z -
        Complex.I * dy (fun w ↦ f
          (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z) / 2 =
        (-Complex.I / 2) *
          (Complex.I * dx (fun w ↦ f
              (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z +
            dy (fun w ↦ f
              (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z) := by
          ring_nf
          simp [Complex.I_sq]
          <;> ring
    _ = (-Complex.I / 2) *
        ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
          (Complex.I * dx f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
            dy f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)))) := by
          rw [h]
    _ = (inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹ *
        ((dx f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) -
            Complex.I * dy f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))) / 2) := by
          ring_nf
          simp [Complex.I_sq]
          <;> ring

/-- Wirtinger chain rule for `∂/∂zbar`; the coefficient is the conjugate of
the holomorphic Möbius derivative. -/
theorem wirtingerBar_comp_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    wirtingerBar (fun w ↦ f
        (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z =
      star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
        wirtingerBar f
          ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) := by
  have h := antiholomorphicDirectional_comp_gammaTwo_smul γ hf z
  unfold wirtingerBar
  calc
    (dx (fun w ↦ f
          (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z +
        Complex.I * dy (fun w ↦ f
          (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z) / 2 =
        (Complex.I / 2) *
          (-Complex.I * dx (fun w ↦ f
              (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z +
            dy (fun w ↦ f
              (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • w)) z) := by
          ring_nf
          simp [Complex.I_sq]
          <;> ring
    _ = (Complex.I / 2) *
        (star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
          (-Complex.I * dx f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
            dy f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)))) := by
          rw [h]
    _ = star ((inverseEtaPaperOrbitDenom γ z ^ 2)⁻¹) *
        ((dx f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
            Complex.I * dy f
              ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))) / 2) := by
          ring_nf
          simp [Complex.I_sq]
          <;> ring

/-- The imaginary-coordinate transformation in the notation used by the raw
differential operators. -/
theorem heightC_gammaTwo_smul
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    heightC ((((γ : GammaTwoQuotientGeometry.GammaTwo) :
        SL(2, ℤ)) • z)) =
      heightC z /
        (Complex.normSq (inverseEtaPaperOrbitDenom γ z) : ℂ) := by
  have h := congrArg (fun t : ℝ ↦ (t : ℂ))
    (ModularGroup.im_smul_eq_div_normSq
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ))) z)
  simpa [heightC, inverseEtaPaperOrbitDenom, map_div₀] using h

/-- The exact Möbius derivative and imaginary-height transformation exposed
together as a reusable compatibility theorem. -/
theorem gammaTwoMoebius_derivative_height_compatibility
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    deriv (gammaTwoMoebiusChart γ) (z : ℂ) =
        1 / inverseEtaPaperOrbitDenom γ z ^ 2 ∧
      heightC ((((γ : GammaTwoQuotientGeometry.GammaTwo) :
          SL(2, ℤ)) • z)) =
        heightC z /
          (Complex.normSq (inverseEtaPaperOrbitDenom γ z) : ℂ) :=
  ⟨deriv_gammaTwoMoebiusChart γ z, heightC_gammaTwo_smul γ z⟩

/-- Elementary denominator identity responsible for the zero-order
correction in the raising operator. -/
theorem inverseEtaPaperOrbitDenom_sq_eq_normSq_add
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitDenom γ z ^ 2 =
      (Complex.normSq (inverseEtaPaperOrbitDenom γ z) : ℂ) +
        2 * Complex.I * inverseEtaPaperOrbitLowerLeft γ *
          heightC z * inverseEtaPaperOrbitDenom γ z := by
  apply Complex.ext <;>
    simp [inverseEtaPaperOrbitDenom, inverseEtaPaperOrbitLowerLeft,
      UpperHalfPlane.denom, heightC, Complex.normSq_apply, pow_two,
      Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im] <;>
    ring

theorem inverseEtaPaperOrbit_normSq_ne_zero
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    (Complex.normSq (inverseEtaPaperOrbitDenom γ z) : ℂ) ≠ 0 := by
  apply Complex.ofReal_ne_zero.mpr
  intro h
  exact inverseEtaPaperOrbitDenom_ne_zero γ z
    (Complex.normSq_eq_zero.mp h)

/-- Advancing one orbit index multiplies the total factor by `j^2`. -/
theorem inverseEtaPaperOrbitFactor_add_one (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitFactor (n + 1) γ z =
      inverseEtaPaperOrbitFactor n γ z *
        inverseEtaPaperOrbitDenom γ z ^ 2 := by
  simpa [inverseEtaPaperOrbitFactor, inverseEtaPaperOrbitDenom] using
    inverseEtaPaperOrbitMultiplier_factor_add_one
      GammaTwoQuotientGeometry.GammaTwo n γ z

/-- Retreating one orbit index divides the total factor by `j^2`. -/
theorem inverseEtaPaperOrbitFactor_sub_one (n : ℤ)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    inverseEtaPaperOrbitFactor (n - 1) γ z =
      inverseEtaPaperOrbitFactor n γ z /
        inverseEtaPaperOrbitDenom γ z ^ 2 := by
  have h := inverseEtaPaperOrbitFactor_add_one (n - 1) γ z
  have hj2 : inverseEtaPaperOrbitDenom γ z ^ 2 ≠ 0 :=
    pow_ne_zero 2 (inverseEtaPaperOrbitDenom_ne_zero γ z)
  apply (eq_div_iff hj2).2
  simpa only [sub_add_cancel] using h.symm

/-- A covariance equation is an equality of two real-smooth functions, so it
may be differentiated without a pointwise choice. -/
theorem IsInverseEtaPaperOrbitCovariant.comp_smul_eq_factor_mul
    {n : ℤ} {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (γ : GammaTwoQuotientGeometry.GammaTwo) :
    (fun z : ℍ ↦ (f : ℍ → ℂ)
      (((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) =
      inverseEtaPaperOrbitFactor n γ * (f : ℍ → ℂ) := by
  funext z
  exact hf γ z

private theorem fixedPhaseFactor_holomorphic_direction
    (n : ℤ) (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    Complex.I * dx (inverseEtaPaperOrbitFactor n γ) z +
        dy (inverseEtaPaperOrbitFactor n γ) z =
      2 * Complex.I * physicalExponent (paperOrbitExponent n) *
        inverseEtaPaperOrbitLowerLeft γ /
          inverseEtaPaperOrbitDenom γ z *
            inverseEtaPaperOrbitFactor n γ z := by
  rw [dx_inverseEtaPaperOrbitFactor, dy_inverseEtaPaperOrbitFactor]
  ring

private theorem fixedPhaseFactor_antiholomorphic_direction
    (n : ℤ) (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    -Complex.I * dx (inverseEtaPaperOrbitFactor n γ) z +
        dy (inverseEtaPaperOrbitFactor n γ) z = 0 := by
  rw [dx_inverseEtaPaperOrbitFactor, dy_inverseEtaPaperOrbitFactor]
  ring_nf

/-- The elementary algebra at the end of the raising covariance proof. -/
private theorem raise_covariance_algebra
    (q F j c y u Az Aw r : ℂ)
    (hj : j ≠ 0) (hy : y ≠ 0) (hr : r ≠ 0)
    (hDerivative : (j ^ 2)⁻¹ * Aw =
      2 * Complex.I * q * c / j * F * u + F * Az)
    (hDenom : j ^ 2 = r + 2 * Complex.I * c * y * j) :
    Aw + q / (y / r) * F * u =
      F * j ^ 2 * (Az + q / y * u) := by
  have hAw : Aw =
      2 * Complex.I * q * c * j * F * u + F * j ^ 2 * Az := by
    calc
      Aw = j ^ 2 * ((j ^ 2)⁻¹ * Aw) := by
        field_simp [hj]
      _ = j ^ 2 *
          (2 * Complex.I * q * c / j * F * u + F * Az) := by
        rw [hDerivative]
      _ = 2 * Complex.I * q * c * j * F * u +
          F * j ^ 2 * Az := by
        field_simp [hj]
  rw [hAw, hDenom]
  field_simp [hy, hr]
  ring

/- The elementary algebra at the end of the lowering covariance proof. -/
set_option maxHeartbeats 3000000 in
private theorem lower_covariance_algebra
    (F j y Bw Bz : ℂ)
    (hj : j ≠ 0)
    (hDerivative : star ((j ^ 2)⁻¹) * Bw = F * Bz) :
    (y / (Complex.normSq j : ℂ)) ^ 2 * Bw =
      (F / j ^ 2) * (y ^ 2 * Bz) := by
  have hjc : star j ≠ 0 := by simpa using hj
  have hConjPow : star (j ^ 2) = star j ^ 2 := by
    change star (j ^ 2) = star j ^ 2
    exact star_pow j 2
  have hBw : Bw = star j ^ 2 * F * Bz := by
    calc
      Bw = star (j ^ 2) *
          (star ((j ^ 2)⁻¹) * Bw) := by
        have hs : star (j ^ 2) ≠ 0 := by
          simpa [map_pow] using pow_ne_zero 2 hjc
        have hstarInv :
            star ((j ^ 2)⁻¹) = (star (j ^ 2))⁻¹ := by
          change (starRingEnd ℂ) ((j ^ 2)⁻¹) =
            ((starRingEnd ℂ) (j ^ 2))⁻¹
          rw [map_inv₀]
        calc
          Bw = 1 * Bw := by rw [one_mul]
          _ = (star (j ^ 2) * (star (j ^ 2))⁻¹) * Bw :=
            congrArg (fun z : ℂ => z * Bw) (mul_inv_cancel₀ hs).symm
          _ = star (j ^ 2) * ((star (j ^ 2))⁻¹ * Bw) :=
            mul_assoc _ _ _
          _ = star (j ^ 2) * (star ((j ^ 2)⁻¹) * Bw) := by
            rw [hstarInv]
      _ = star (j ^ 2) * (F * Bz) := by rw [hDerivative]
      _ = star j ^ 2 * F * Bz := by rw [hConjPow]; ring
  rw [hBw]
  rw [show (Complex.normSq j : ℂ) = star j * j by
    exact Complex.normSq_eq_conj_mul_self]
  field_simp [hj, hjc]

/-- One raw raising step has the exact next-index fixed-phase covariance. -/
theorem raiseRaw_covariance_of_inverseEtaPaperOrbitCovariant
    {n : ℤ} {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    raiseRaw (paperOrbitExponent n) (f : ℍ → ℂ)
        ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) =
      inverseEtaPaperOrbitFactor (n + 1) γ z *
        raiseRaw (paperOrbitExponent n) (f : ℍ → ℂ) z := by
  let F := inverseEtaPaperOrbitFactor n γ z
  let j := inverseEtaPaperOrbitDenom γ z
  let c := inverseEtaPaperOrbitLowerLeft γ
  let q := physicalExponent (paperOrbitExponent n)
  let y := heightC z
  let r := (Complex.normSq j : ℂ)
  let u := (f : ℍ → ℂ) z
  let Az := Complex.I * dx (f : ℍ → ℂ) z +
    dy (f : ℍ → ℂ) z
  let Aw := Complex.I * dx (f : ℍ → ℂ)
      ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
    dy (f : ℍ → ℂ)
      ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
  have hFunction := hf.comp_smul_eq_factor_mul γ
  have hDerivative := congrArg
    (fun h : ℍ → ℂ ↦ Complex.I * dx h z + dy h z) hFunction
  rw [holomorphicDirectional_comp_gammaTwo_smul γ
      (f : SmoothQuotientCompactFunction).1.2 z,
    dx_mul (inverseEtaPaperOrbitFactor_realSmooth n γ)
      (f : SmoothQuotientCompactFunction).1.2,
    dy_mul (inverseEtaPaperOrbitFactor_realSmooth n γ)
      (f : SmoothQuotientCompactFunction).1.2] at hDerivative
  have hDerivative' : (j ^ 2)⁻¹ * Aw =
      2 * Complex.I * q * c / j * F * u + F * Az := by
    calc
      (j ^ 2)⁻¹ * Aw =
          Complex.I *
              (dx (inverseEtaPaperOrbitFactor n γ) z * u +
                F * dx (f : ℍ → ℂ) z) +
            (dy (inverseEtaPaperOrbitFactor n γ) z * u +
                F * dy (f : ℍ → ℂ) z) := by
        simpa [F, j, u, Az, Aw, Pi.mul_apply] using hDerivative
      _ = (Complex.I * dx (inverseEtaPaperOrbitFactor n γ) z +
              dy (inverseEtaPaperOrbitFactor n γ) z) * u +
            F * Az := by ring
      _ = 2 * Complex.I * q * c / j * F * u + F * Az := by
        rw [fixedPhaseFactor_holomorphic_direction n γ z]
  have hAlgebra := raise_covariance_algebra q F j c y u Az Aw r
    (by simpa [j] using inverseEtaPaperOrbitDenom_ne_zero γ z)
    (by simpa [y] using heightC_ne_zero z)
    (by simpa [r, j] using inverseEtaPaperOrbit_normSq_ne_zero γ z)
    hDerivative'
    (by simpa [j, c, y, r] using
      inverseEtaPaperOrbitDenom_sq_eq_normSq_add γ z)
  rw [raiseRaw, heightC_gammaTwo_smul,
    hf γ z, inverseEtaPaperOrbitFactor_add_one]
  dsimp [F, j, q, y, r, u, Az, Aw] at hAlgebra ⊢
  simp only [raiseRaw, inverseEtaPaperOrbitFactor] at hAlgebra ⊢
  ring_nf at hAlgebra ⊢
  exact hAlgebra

/-- One raw lowering step has the exact previous-index fixed-phase
covariance. -/
theorem lowerRaw_covariance_of_inverseEtaPaperOrbitCovariant
    {n : ℤ} {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    lowerRaw (paperOrbitExponent n) (f : ℍ → ℂ)
        ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) =
      inverseEtaPaperOrbitFactor (n - 1) γ z *
        lowerRaw (paperOrbitExponent n) (f : ℍ → ℂ) z := by
  let F := inverseEtaPaperOrbitFactor n γ z
  let j := inverseEtaPaperOrbitDenom γ z
  let y := heightC z
  let u := (f : ℍ → ℂ) z
  let Bz := -Complex.I * dx (f : ℍ → ℂ) z +
    dy (f : ℍ → ℂ) z
  let Bw := -Complex.I * dx (f : ℍ → ℂ)
      ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) +
    dy (f : ℍ → ℂ)
      ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z))
  have hFunction := hf.comp_smul_eq_factor_mul γ
  have hDerivative := congrArg
    (fun h : ℍ → ℂ ↦ -Complex.I * dx h z + dy h z) hFunction
  rw [antiholomorphicDirectional_comp_gammaTwo_smul γ
      (f : SmoothQuotientCompactFunction).1.2 z,
    dx_mul (inverseEtaPaperOrbitFactor_realSmooth n γ)
      (f : SmoothQuotientCompactFunction).1.2,
    dy_mul (inverseEtaPaperOrbitFactor_realSmooth n γ)
      (f : SmoothQuotientCompactFunction).1.2] at hDerivative
  have hDerivative' : star ((j ^ 2)⁻¹) * Bw = F * Bz := by
    calc
      star ((j ^ 2)⁻¹) * Bw =
          -Complex.I *
              (dx (inverseEtaPaperOrbitFactor n γ) z * u +
                F * dx (f : ℍ → ℂ) z) +
            (dy (inverseEtaPaperOrbitFactor n γ) z * u +
                F * dy (f : ℍ → ℂ) z) := by
        simpa [F, j, u, Bz, Bw, Pi.mul_apply] using hDerivative
      _ = (-Complex.I * dx (inverseEtaPaperOrbitFactor n γ) z +
              dy (inverseEtaPaperOrbitFactor n γ) z) * u +
            F * Bz := by ring
      _ = F * Bz := by
        rw [fixedPhaseFactor_antiholomorphic_direction n γ z]
        simp only [F, Bz]
        ring
  have hAlgebra := lower_covariance_algebra F j y Bw Bz
    (by simpa [j] using inverseEtaPaperOrbitDenom_ne_zero γ z)
    hDerivative'
  simp only [lowerRaw]
  rw [heightC_gammaTwo_smul,
    inverseEtaPaperOrbitFactor_sub_one]
  dsimp [F, j, y, Bz, Bw] at hAlgebra ⊢
  ring_nf at hAlgebra ⊢
  exact hAlgebra

namespace IsInverseEtaPaperOrbitCovariant

/-- Closure under one genuine raw raising step, derived from the analytic
chain rule above. -/
theorem raiseRaw {n : ℤ} {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f) :
    IsInverseEtaPaperOrbitCovariant (n + 1)
      (raiseSmoothCompactLinear (paperOrbitExponent n) f) := by
  intro γ z
  simpa [inverseEtaPaperOrbitFactor,
    raiseSmoothCompactLinear_apply] using
      raiseRaw_covariance_of_inverseEtaPaperOrbitCovariant hf γ z

/-- Closure under one genuine raw lowering step, derived from the analytic
chain rule above. -/
theorem lowerRaw {n : ℤ} {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f) :
    IsInverseEtaPaperOrbitCovariant (n - 1)
      (lowerSmoothCompactLinear (paperOrbitExponent n) f) := by
  intro γ z
  simpa [inverseEtaPaperOrbitFactor,
    lowerSmoothCompactLinear_apply] using
      lowerRaw_covariance_of_inverseEtaPaperOrbitCovariant hf γ z

end IsInverseEtaPaperOrbitCovariant

/-- Induction on an arbitrary finite `R/L` word.  Thus the all-word predicate
is a theorem from zeroth-word covariance, not an extra certificate carried by
the example. -/
theorem FixedPhaseDifferentialWord.eval_covariant
    (word : FixedPhaseDifferentialWord) {n : ℤ}
    {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f) :
    IsInverseEtaPaperOrbitCovariant
      (FixedPhaseDifferentialWord.targetIndex n word)
      (FixedPhaseDifferentialWord.eval n word f) := by
  induction word generalizing n f with
  | nil => simpa using hf
  | raise tail ih =>
      rw [FixedPhaseDifferentialWord.eval_raise_apply,
        FixedPhaseDifferentialWord.targetIndex_raise]
      exact ih hf.raiseRaw
  | lower tail ih =>
      rw [FixedPhaseDifferentialWord.eval_lower_apply,
        FixedPhaseDifferentialWord.targetIndex_lower]
      exact ih hf.lowerRaw

/-- The maximal smooth quotient-compact submodule stable under every finite
word in the concrete fixed-phase raising and lowering operators. -/
noncomputable def inverseEtaFixedPhaseStableCoreSubmodule (n : ℤ) :
    Submodule ℂ SmoothQuotientCompactFunction where
  carrier := {f | ∀ word : FixedPhaseDifferentialWord,
    IsInverseEtaPaperOrbitCovariant
      (FixedPhaseDifferentialWord.targetIndex n word)
      (FixedPhaseDifferentialWord.eval n word f)}
  zero_mem' := by
    intro word
    rw [map_zero]
    exact IsInverseEtaPaperOrbitCovariant.zero _
  add_mem' := by
    intro f g hf hg word
    rw [map_add]
    exact (hf word).add (hg word)
  smul_mem' := by
    intro c f hf word
    rw [map_smul]
    exact (hf word).smul c

/-- Canonical fixed-phase core at orbit index `n`. -/
noncomputable abbrev InverseEtaFixedPhaseCore (n : ℤ) : Type :=
  ↥(inverseEtaFixedPhaseStableCoreSubmodule n)

/-- Once the one-step covariance theorem has been proved, membership in the
all-word stable core is equivalent to the ordinary zeroth-word covariance
condition. -/
theorem mem_inverseEtaFixedPhaseStableCoreSubmodule_iff
    (n : ℤ) (f : SmoothQuotientCompactFunction) :
    f ∈ inverseEtaFixedPhaseStableCoreSubmodule n ↔
      IsInverseEtaPaperOrbitCovariant n f := by
  constructor
  · intro hf
    simpa using hf FixedPhaseDifferentialWord.nil
  · intro hf word
    exact word.eval_covariant hf

/-! #### Natural invariant-cutoff test cores -/

/-- Pointwise `Gamma(2)` invariance of a smooth quotient-compact cutoff. -/
def IsGammaTwoInvariantCutoff
    (cutoff : SmoothQuotientCompactFunction) : Prop :=
  ∀ (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ),
    (cutoff : ℍ → ℂ)
        ((((γ : GammaTwoQuotientGeometry.GammaTwo) : SL(2, ℤ)) • z)) =
      (cutoff : ℍ → ℂ) z

/-- The raw product of an invariant test cutoff with an actual section at one
index of the fixed-phase orbit.  Quotient compactness comes entirely from the
cutoff; the section is only required to be real-smooth. -/
noncomputable def invariantCutoffTimesOrbitSectionRaw
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) :
    SmoothQuotientCompactFunction :=
  ⟨⟨(cutoff : ℍ → ℂ) * (orbitSection : ℍ → ℂ),
      cutoff.1.2.mul hSectionSmooth⟩,
    HasQuotientCompactSupport.mul_right cutoff.2
      (orbitSection : ℍ → ℂ)⟩

@[simp]
theorem invariantCutoffTimesOrbitSectionRaw_apply
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) (z : ℍ) :
    (invariantCutoffTimesOrbitSectionRaw n cutoff orbitSection
      hSectionSmooth : ℍ → ℂ) z =
        (cutoff : ℍ → ℂ) z * orbitSection z :=
  rfl

/-- Zeroth-word covariance of the invariant-cutoff product. -/
theorem invariantCutoffTimesOrbitSectionRaw_covariant
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (hCutoffInvariant : IsGammaTwoInvariantCutoff cutoff)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) :
    IsInverseEtaPaperOrbitCovariant n
      (invariantCutoffTimesOrbitSectionRaw n cutoff orbitSection
        hSectionSmooth) := by
  intro γ z
  change
    (cutoff : ℍ → ℂ) (((γ : GammaTwoQuotientGeometry.GammaTwo) :
        SL(2, ℤ)) • z) *
        orbitSection (((γ : GammaTwoQuotientGeometry.GammaTwo) :
          SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n).factor γ z *
        ((cutoff : ℍ → ℂ) z * orbitSection z)
  rw [hCutoffInvariant γ z,
    WeightSection.covariance orbitSection γ z]
  ring

/-- Every natural invariant-cutoff product lies in the all-word stable set;
this is a consequence of the proved one-step `R/L` covariance, not an extra
stability certificate. -/
theorem invariantCutoffTimesOrbitSectionRaw_mem
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (hCutoffInvariant : IsGammaTwoInvariantCutoff cutoff)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) :
    invariantCutoffTimesOrbitSectionRaw n cutoff orbitSection
        hSectionSmooth ∈
      inverseEtaFixedPhaseStableCoreSubmodule n :=
  (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff n
    (invariantCutoffTimesOrbitSectionRaw n cutoff orbitSection
      hSectionSmooth)).2
    (invariantCutoffTimesOrbitSectionRaw_covariant n cutoff
      hCutoffInvariant orbitSection hSectionSmooth)

/-- Typed natural test-core element obtained from an invariant cutoff and a
genuine smooth section at orbit index `n`. -/
noncomputable def invariantCutoffTimesOrbitSection
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (hCutoffInvariant : IsGammaTwoInvariantCutoff cutoff)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) :
    InverseEtaFixedPhaseCore n :=
  ⟨invariantCutoffTimesOrbitSectionRaw n cutoff orbitSection
      hSectionSmooth,
    invariantCutoffTimesOrbitSectionRaw_mem n cutoff hCutoffInvariant
      orbitSection hSectionSmooth⟩

@[simp]
theorem invariantCutoffTimesOrbitSection_apply
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (hCutoffInvariant : IsGammaTwoInvariantCutoff cutoff)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) (z : ℍ) :
    (invariantCutoffTimesOrbitSection n cutoff hCutoffInvariant orbitSection
        hSectionSmooth).1 z =
        (cutoff : ℍ → ℂ) z * orbitSection z :=
  rfl

/-- Exact nonvanishing criterion for the natural product.  In particular, no
unsupported claim that every orbit index already has a nonzero seed section
is made: a common point where both supplied factors are nonzero is sufficient. -/
theorem invariantCutoffTimesOrbitSection_ne_zero
    (n : ℤ) (cutoff : SmoothQuotientCompactFunction)
    (hCutoffInvariant : IsGammaTwoInvariantCutoff cutoff)
    (orbitSection : InverseEtaPaperOrbitSection
      GammaTwoQuotientGeometry.GammaTwo n)
    (hSectionSmooth : RealSmooth (orbitSection : ℍ → ℂ)) (z : ℍ)
    (hCutoff : (cutoff : ℍ → ℂ) z ≠ 0)
    (hSection : orbitSection z ≠ 0) :
    invariantCutoffTimesOrbitSection n cutoff hCutoffInvariant orbitSection
        hSectionSmooth ≠ (0 : InverseEtaFixedPhaseCore n) := by
  intro hZero
  have hAt := congrArg
    (fun u : InverseEtaFixedPhaseCore n ↦
      ((u.1 : SmoothQuotientCompactFunction) : ℍ → ℂ) z) hZero
  change (cutoff : ℍ → ℂ) z * orbitSection z = 0 at hAt
  exact (mul_ne_zero hCutoff hSection) hAt

namespace InverseEtaFixedPhaseCore

/-- Every fixed-phase core is inhabited by its zero section.  A concrete
nonzero inhabitant at index zero is constructed from the discriminant cutoff
later in the file. -/
noncomputable instance (n : ℤ) : Inhabited (InverseEtaFixedPhaseCore n) :=
  ⟨0⟩

/-- Forget the stability predicate and retain the smooth quotient-compact raw
function. -/
def toSmoothQuotientCompactFunction {n : ℤ}
    (u : InverseEtaFixedPhaseCore n) : SmoothQuotientCompactFunction :=
  u.1

noncomputable instance (n : ℤ) :
    CoeOut (InverseEtaFixedPhaseCore n) SmoothQuotientCompactFunction :=
  ⟨toSmoothQuotientCompactFunction⟩

/-- The zeroth word turns a stable raw function into an actual covariant
weight section for the multiplier at its source index. -/
noncomputable def toWeightSection (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      InverseEtaPaperOrbitSection
        GammaTwoQuotientGeometry.GammaTwo n where
  toFun u := ⟨toSmoothQuotientCompactFunction u,
    (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff n
      (toSmoothQuotientCompactFunction u)).1 u.2⟩
  map_add' u v := by
    apply WeightSection.ext_apply
    intro z
    rfl
  map_smul' c u := by
    apply WeightSection.ext_apply
    intro z
    rfl

@[simp]
theorem toWeightSection_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    toWeightSection n u z = (u : SmoothQuotientCompactFunction) z :=
  rfl

/-- The fixed-phase stable core embeds in the already constructed Petersson
smooth compact core at the same shifted weight. -/
noncomputable def toSmoothCompactWeightCore (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      SmoothCompactWeightCore
        (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n) where
  toFun u := ⟨toWeightSection n u,
    (u : SmoothQuotientCompactFunction).1.2,
    (u : SmoothQuotientCompactFunction).2⟩
  map_add' u v := by
    apply SmoothCompactWeightCore.ext
    intro z
    rfl
  map_smul' c u := by
    apply SmoothCompactWeightCore.ext
    intro z
    rfl

@[simp]
theorem toSmoothCompactWeightCore_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    SmoothCompactWeightCore.toSection
        (toSmoothCompactWeightCore n u) z =
      (u : SmoothQuotientCompactFunction) z :=
  rfl

/-- No information is lost when the stable core is viewed as a shifted
Petersson smooth compact core. -/
theorem toSmoothCompactWeightCore_injective (n : ℤ) :
    Function.Injective (toSmoothCompactWeightCore n) := by
  intro u v huv
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  funext z
  have h := congrArg
    (fun w : SmoothCompactWeightCore
        (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo n) =>
      SmoothCompactWeightCore.toSection w z) huv
  exact h

/-- Actual covariant raising map on the canonical stable core. -/
noncomputable def raise (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      InverseEtaFixedPhaseCore (n + 1) :=
  LinearMap.codRestrict
    (inverseEtaFixedPhaseStableCoreSubmodule (n + 1))
    ((raiseSmoothCompactLinear (paperOrbitExponent n)).domRestrict
      (inverseEtaFixedPhaseStableCoreSubmodule n))
    (fun u => by
      intro word
      simpa using (u.2 (FixedPhaseDifferentialWord.raise word)))

/-- Actual covariant lowering map on the canonical stable core. -/
noncomputable def lower (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      InverseEtaFixedPhaseCore (n - 1) :=
  LinearMap.codRestrict
    (inverseEtaFixedPhaseStableCoreSubmodule (n - 1))
    ((lowerSmoothCompactLinear (paperOrbitExponent n)).domRestrict
      (inverseEtaFixedPhaseStableCoreSubmodule n))
    (fun u => by
      intro word
      simpa using (u.2 (FixedPhaseDifferentialWord.lower word)))

/-- The lowering map whose source is written as the successor orbit and whose
target is definitionally the original index.  This avoids transporting across
the arithmetic equality `(n + 1) - 1 = n` in Green pairings. -/
noncomputable def lowerFromSucc (n : ℤ) :
    InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      InverseEtaFixedPhaseCore n :=
  LinearMap.codRestrict
    (inverseEtaFixedPhaseStableCoreSubmodule n)
    ((lowerSmoothCompactLinear (paperOrbitExponent (n + 1))).domRestrict
      (inverseEtaFixedPhaseStableCoreSubmodule (n + 1)))
    (fun u => by
      intro word
      simpa using (u.2 (FixedPhaseDifferentialWord.lower word)))

/-- The raising map from the predecessor orbit to a definitionally specified
target index. -/
noncomputable def raiseFromPred (n : ℤ) :
    InverseEtaFixedPhaseCore (n - 1) →ₗ[ℂ]
      InverseEtaFixedPhaseCore n :=
  LinearMap.codRestrict
    (inverseEtaFixedPhaseStableCoreSubmodule n)
    ((raiseSmoothCompactLinear (paperOrbitExponent (n - 1))).domRestrict
      (inverseEtaFixedPhaseStableCoreSubmodule (n - 1)))
    (fun u => by
      intro word
      simpa using (u.2 (FixedPhaseDifferentialWord.raise word)))

@[simp]
theorem raise_apply (n : ℤ) (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) z =
      raiseRaw (paperOrbitExponent n)
        (u : SmoothQuotientCompactFunction) z :=
  rfl

@[simp]
theorem lower_apply (n : ℤ) (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) z =
      lowerRaw (paperOrbitExponent n)
        (u : SmoothQuotientCompactFunction) z :=
  rfl

@[simp]
theorem lowerFromSucc_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    ((lowerFromSucc n u : InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      lowerRaw (paperOrbitExponent (n + 1))
        (u : SmoothQuotientCompactFunction) z :=
  rfl

@[simp]
theorem raiseFromPred_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n - 1)) (z : ℍ) :
    ((raiseFromPred n u : InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      raiseRaw (paperOrbitExponent (n - 1))
        (u : SmoothQuotientCompactFunction) z :=
  rfl

/-- Raising preserves real `C∞` regularity on the actual typed core. -/
theorem raise_realSmooth (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    RealSmooth
      (((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) :=
  (raise n u : InverseEtaFixedPhaseCore (n + 1)).1.1.2

/-- Lowering preserves real `C∞` regularity on the actual typed core. -/
theorem lower_realSmooth (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    RealSmooth
      (((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) :=
  (lower n u : InverseEtaFixedPhaseCore (n - 1)).1.1.2

/-- Raising preserves compact support on the effective quotient. -/
theorem raise_quotientCompact (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    HasQuotientCompactSupport
      (((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) :=
  (raise n u : InverseEtaFixedPhaseCore (n + 1)).1.2

/-- Lowering preserves compact support on the effective quotient. -/
theorem lower_quotientCompact (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    HasQuotientCompactSupport
      (((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) :=
  (lower n u : InverseEtaFixedPhaseCore (n - 1)).1.2

/-- Exact shifted-weight covariance of the actual raising operator. -/
theorem raise_covariance (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    ((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo (n + 1)).factor γ z *
        ((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
          SmoothQuotientCompactFunction) z := by
  have hcov :=
    (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff (n + 1)
      (toSmoothQuotientCompactFunction (raise n u))).1 (raise n u).2
  simpa [toSmoothQuotientCompactFunction] using hcov γ z

/-- Exact shifted-weight covariance of the actual lowering operator. -/
theorem lower_covariance (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (γ : GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    ((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier
          GammaTwoQuotientGeometry.GammaTwo (n - 1)).factor γ z *
        ((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
          SmoothQuotientCompactFunction) z := by
  have hcov :=
    (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff (n - 1)
      (toSmoothQuotientCompactFunction (lower n u))).1 (lower n u).2
  simpa [toSmoothQuotientCompactFunction] using hcov γ z

/-- Complex linearity is part of the bundled raising operator. -/
@[simp]
theorem raise_add (n : ℤ) (u v : InverseEtaFixedPhaseCore n) :
    raise n (u + v) = raise n u + raise n v :=
  map_add (raise n) u v

@[simp]
theorem raise_smul (n : ℤ) (c : ℂ) (u : InverseEtaFixedPhaseCore n) :
    raise n (c • u) = c • raise n u :=
  map_smul (raise n) c u

/-- Complex linearity is part of the bundled lowering operator. -/
@[simp]
theorem lower_add (n : ℤ) (u v : InverseEtaFixedPhaseCore n) :
    lower n (u + v) = lower n u + lower n v :=
  map_add (lower n) u v

@[simp]
theorem lower_smul (n : ℤ) (c : ℂ) (u : InverseEtaFixedPhaseCore n) :
    lower n (c • u) = c • lower n u :=
  map_smul (lower n) c u

/-- Exact lower-after-raise factorization on the actual fixed-phase core,
including the weight-dependent constant term. -/
theorem lower_raise_factorization (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    -laplaceRaw (paperOrbitExponent n)
        (u : SmoothQuotientCompactFunction) z =
      (((lowerFromSucc n (raise n u) :
          InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) z +
        physicalExponent (paperOrbitExponent n) *
          (u : SmoothQuotientCompactFunction) z := by
  have hraise :
      (((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) =
      raiseRaw (paperOrbitExponent n)
        ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) := by
    funext w
    exact raise_apply n u w
  rw [lowerFromSucc_apply, paperOrbitExponent_add_one, hraise]
  exact HalfWeightDifferentialOperators.lower_raise_factorization
    (a := paperOrbitExponent n)
    (f := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
    (u : SmoothQuotientCompactFunction).1.2 z

/-- Exact raise-after-lower factorization on the actual fixed-phase core. -/
theorem raise_lower_factorization (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    -laplaceRaw (paperOrbitExponent n)
        (u : SmoothQuotientCompactFunction) z =
      (((raiseFromPred n (lower n u) :
          InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) z := by
  have hlower :
      (((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) =
      lowerRaw (paperOrbitExponent n)
        ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) := by
    funext w
    exact lower_apply n u w
  rw [raiseFromPred_apply, paperOrbitExponent_sub_one, hlower]
  exact HalfWeightDifferentialOperators.raise_lower_factorization
    (a := paperOrbitExponent n)
    (f := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
    (u : SmoothQuotientCompactFunction).1.2 z

/-- The corrected one-half average and its half-weight constant term on the
actual fixed-phase core. -/
theorem averaged_factorization (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    -laplaceRaw (paperOrbitExponent n)
        (u : SmoothQuotientCompactFunction) z =
      (1 / 2 : ℂ) *
        ((((lowerFromSucc n (raise n u) :
            InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) : ℍ → ℂ) z +
          (((raiseFromPred n (lower n u) :
              InverseEtaFixedPhaseCore n) :
            SmoothQuotientCompactFunction) : ℍ → ℂ) z) +
        (physicalExponent (paperOrbitExponent n) / 2) *
          (u : SmoothQuotientCompactFunction) z := by
  have hraise :
      (((raise n u : InverseEtaFixedPhaseCore (n + 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) =
      raiseRaw (paperOrbitExponent n)
        ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) := by
    funext w
    exact raise_apply n u w
  have hlower :
      (((lower n u : InverseEtaFixedPhaseCore (n - 1)) :
        SmoothQuotientCompactFunction) : ℍ → ℂ) =
      lowerRaw (paperOrbitExponent n)
        ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) := by
    funext w
    exact lower_apply n u w
  rw [lowerFromSucc_apply, raiseFromPred_apply,
    paperOrbitExponent_add_one, paperOrbitExponent_sub_one,
    hraise, hlower]
  exact HalfWeightDifferentialOperators.averaged_factorization
    (a := paperOrbitExponent n)
    (f := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
    (u : SmoothQuotientCompactFunction).1.2 z

end InverseEtaFixedPhaseCore

/-! #### Typed covariant differential cores -/

/-- A legacy certificate interface for a regular core indexed by *every*
integer exponent.  An inhabitant must supply typed raw operators that preserve
automorphy and the selected operator domains.  The concrete construction
above deliberately uses only the one residue class modulo four determined by
the paper, so it is represented by `InverseEtaFixedPhaseCore` rather than by
an artificial inhabitant of this stronger all-integer interface.

The multiplier at exponent index `a` has multiplier index `-a`, because the
6.2 total factor is `sqrtFactor ^ (-k)`.  The three `*_apply` fields identify
the bundled maps with the explicitly defined coordinate formulas; all
linearity and later factorization lemmas use those formulas.
-/
structure ExponentIndexedDifferentialCore
    (Γ : Subgroup SL(2, ℤ)) where
  multiplier : ∀ a : ℤ, HalfIntegralMultiplier Γ (-a)
  core : ∀ a : ℤ, Submodule ℂ SmoothFunction
  «section» : ∀ a : ℤ, core a →ₗ[ℂ] WeightSection (multiplier a)
  section_apply : ∀ a (u : core a) z,
    «section» a u z = (u : ℍ → ℂ) z
  raiseCore : ∀ a : ℤ, core a →ₗ[ℂ] core (a + 4)
  lowerCore : ∀ a : ℤ, core a →ₗ[ℂ] core (a - 4)
  laplaceCore : ∀ a : ℤ, core a →ₗ[ℂ] core a
  raise_apply : ∀ a (u : core a) z,
    (raiseCore a u : ℍ → ℂ) z = raiseRaw a (u : ℍ → ℂ) z
  lower_apply : ∀ a (u : core a) z,
    (lowerCore a u : ℍ → ℂ) z = lowerRaw a (u : ℍ → ℂ) z
  laplace_apply : ∀ a (u : core a) z,
    (laplaceCore a u : ℍ → ℂ) z = laplaceRaw a (u : ℍ → ℂ) z

namespace ExponentIndexedDifferentialCore

variable {Γ : Subgroup SL(2, ℤ)}

/-- The chain-rule package is derived from the smoothness already carried by
the core subtype; it is not an additional structure field. -/
theorem chainRule (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) :
    RealJetChainRuleCertificate a (u : ℍ → ℂ) :=
  realJetChainRuleCertificate a u.1.2

theorem raise_coe (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) :
    (D.raiseCore a u : ℍ → ℂ) = raiseRaw a (u : ℍ → ℂ) :=
  funext (D.raise_apply a u)

theorem lower_coe (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) :
    (D.lowerCore a u : ℍ → ℂ) = lowerRaw a (u : ℍ → ℂ) :=
  funext (D.lower_apply a u)

theorem laplace_coe (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) :
    (D.laplaceCore a u : ℍ → ℂ) = laplaceRaw a (u : ℍ → ℂ) :=
  funext (D.laplace_apply a u)

/-- Covariance of every core element, derived from its typed section. -/
theorem covariance (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) (γ : Γ) (z : ℍ) :
    (u : ℍ → ℂ) (γ • z) =
      (D.multiplier a).factor γ z * (u : ℍ → ℂ) z := by
  rw [← D.section_apply a u (γ • z), ← D.section_apply a u z]
  exact WeightSection.covariance (D.«section» a u) γ z

/-- Raising has the correct target exponent at the type level. -/
theorem raise_covariance (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) (γ : Γ) (z : ℍ) :
    (D.raiseCore a u : ℍ → ℂ) (γ • z) =
      (D.multiplier (a + 4)).factor γ z *
        (D.raiseCore a u : ℍ → ℂ) z :=
  D.covariance (a + 4) (D.raiseCore a u) γ z

/-- Lowering has the correct target exponent at the type level. -/
theorem lower_covariance (D : ExponentIndexedDifferentialCore Γ)
    (a : ℤ) (u : D.core a) (γ : Γ) (z : ℍ) :
    (D.lowerCore a u : ℍ → ℂ) (γ • z) =
      (D.multiplier (a - 4)).factor γ z *
        (D.lowerCore a u : ℍ → ℂ) z :=
  D.covariance (a - 4) (D.lowerCore a u) γ z

/-- Coordinate factorization transported to the typed core. -/
theorem typed_lower_raise_factorization
    (D : ExponentIndexedDifferentialCore Γ) (a : ℤ) (u : D.core a)
    (z : ℍ) :
    -(D.laplaceCore a u : ℍ → ℂ) z =
      (D.lowerCore (a + 4) (D.raiseCore a u) : ℍ → ℂ) z +
        physicalExponent a * (u : ℍ → ℂ) z := by
  rw [D.laplace_apply, D.lower_apply, D.raise_coe]
  exact lower_raise_factorization u.1.2 z

/-- The second typed factorization. -/
theorem typed_raise_lower_factorization
    (D : ExponentIndexedDifferentialCore Γ) (a : ℤ) (u : D.core a)
    (z : ℍ) :
    -(D.laplaceCore a u : ℍ → ℂ) z =
      (D.raiseCore (a - 4) (D.lowerCore a u) : ℍ → ℂ) z := by
  rw [D.laplace_apply, D.raise_apply, D.lower_coe]
  exact raise_lower_factorization u.1.2 z

end ExponentIndexedDifferentialCore

/-- Anchor an exponent-indexed differential tower to the actual paper
half-weight core at exponent index `-1`. -/
structure PaperExponentIndexedDifferentialCore
    (P : PaperHalfWeightCertificate) extends
      ExponentIndexedDifferentialCore GammaTwoQuotientGeometry.GammaTwo where
  multiplier_at_half :
    toExponentIndexedDifferentialCore.multiplier
        paperDisplayedExponentIndex = paperMultiplierAtExponent P
  halfCoreEquiv :
    toExponentIndexedDifferentialCore.core paperDisplayedExponentIndex ≃ₗ[ℂ]
      SmoothCompactCoreGeometry.SmoothCompactCore P
  halfCoreEquiv_apply : ∀ u z,
    SmoothCompactCore.toSection (halfCoreEquiv u) z =
      (u : ℍ → ℂ) z

/-! #### Green identity and unbounded formal adjoints -/

section FormalAdjoint

open scoped LinearPMap

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]

/-- Boundary-free Green identity on two specified unbounded domains. -/
def GreenIdentity (R : E →ₗ.[ℂ] F) (L : F →ₗ.[ℂ] E) : Prop :=
  ∀ (u : R.domain) (v : L.domain),
    inner ℂ (R u) (v : F) + inner ℂ (u : E) (L v) = 0

/-- Green's identity is exactly the statement that `-L` is a formal adjoint
of `R`; no bounded-adjoint API is misused. -/
theorem greenIdentity_iff_isFormalAdjoint_neg
    (R : E →ₗ.[ℂ] F) (L : F →ₗ.[ℂ] E) :
    GreenIdentity R L ↔ R.IsFormalAdjoint (-L) := by
  constructor
  · intro h u v
    rw [LinearPMap.neg_apply, inner_neg_right]
    exact eq_neg_of_add_eq_zero_left (h u v)
  · intro h u v
    have huv := h u v
    rw [LinearPMap.neg_apply, inner_neg_right] at huv
    exact eq_neg_iff_add_eq_zero.mp huv

end FormalAdjoint

end HalfWeightDifferentialOperators

/-! ### 6.5.1: unconditional compact-coordinate Green identity

The quotient Green theorem needs a Stokes theorem for the chosen polygon,
paired-side cancellation, and a horocycle trace theorem.  Those results are
not presently available in the imported modular-surface API.  The following
The namespace below closes the analytic identity which *is* available without such an
input: Mathlib's genuine smooth test-function core
`C_c^∞({z : ℂ | 0 < im z})`, with no boundary certificate stored in an
element.  The proof uses the full-space Fubini/integration-by-parts theorem;
compact support strictly inside the upper half-plane makes every boundary
term vanish.  The exponent, complex conjugation, signs, and the normalization
of lowering by `y²` are all explicit.
-/

namespace HalfWeightCompactCoordinateGreen

open MeasureTheory Set Function Topology
open scoped ContDiff Distributions
open HalfIntegralMultiplier SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators

noncomputable section

/-- The upper half-plane regarded as an open subset of the ambient real
two-dimensional vector space `ℂ`. -/
def upperPlaneOpen : TopologicalSpace.Opens ℂ :=
  ⟨UpperHalfPlane.upperHalfPlaneSet,
    UpperHalfPlane.isOpen_upperHalfPlaneSet⟩

/-- A genuine `C_c^∞` test function whose topological support lies strictly
inside the upper half-plane. -/
abbrev Core := 𝓓(upperPlaneOpen, ℂ)

/-- The real physical exponent represented by the doubled integer index. -/
def exponentR (a : ℤ) : ℝ :=
  (a : ℝ) / 2

/-- The same exponent in the coefficient field. -/
def exponentC (a : ℤ) : ℂ :=
  (exponentR a : ℂ)

@[simp]
theorem exponentC_eq_physicalExponent (a : ℤ) :
    exponentC a = physicalExponent a :=
  rfl

/-- The directional derivative remains in the same genuine test-function
core.  This is Mathlib's bundled derivative, not an assumed closure field. -/
noncomputable def directionalDerivative (ξ : ℂ) (u : Core) : Core :=
  TestFunction.lineDerivCLM ℂ ξ u

/-- The two real coordinate derivatives on the ambient chart. -/
noncomputable def dx (u : Core) : Core :=
  directionalDerivative 1 u

noncomputable def dy (u : Core) : Core :=
  directionalDerivative Complex.I u

@[simp]
theorem directionalDerivative_apply (ξ : ℂ) (u : Core) (w : ℂ) :
    directionalDerivative ξ u w = fderiv ℝ (u : ℂ → ℂ) w ξ := by
  rw [directionalDerivative,
    TestFunction.lineDerivCLM_eq_fderivCLM,
    TestFunction.fderivCLM_apply_of_le (hk := by simp)]

@[simp]
theorem dx_apply (u : Core) (w : ℂ) :
    dx u w = fderiv ℝ (u : ℂ → ℂ) w 1 := by
  simp [dx]

@[simp]
theorem dy_apply (u : Core) (w : ℂ) :
    dy u w = fderiv ℝ (u : ℂ → ℂ) w Complex.I := by
  simp [dy]

/-- Complex conjugation preserves the real-smooth compact test core. -/
noncomputable def conjugate (u : Core) : Core :=
  TestFunction.postcompCLM (Complex.conjCLE : ℂ →L[ℝ] ℂ) u

@[simp]
theorem conjugate_apply (u : Core) (w : ℂ) :
    conjugate u w = star (u w) := by
  simp [conjugate, TestFunction.postcompCLM_apply,
    Function.comp_def, Complex.conjCLE_apply]

/-- The real power of the height, complexified for multiplication with a
test function.  It need only be smooth where the second factor can be
nonzero. -/
def rpowScale (p : ℝ) (w : ℂ) : ℂ :=
  ((w.im ^ p : ℝ) : ℂ)

theorem rpowScale_contDiffAt_of_im_pos
    (p : ℝ) {w : ℂ} (hw : 0 < w.im) :
    ContDiffAt ℝ ∞ (rpowScale p) w := by
  have him : ContDiffAt ℝ ∞ (fun z : ℂ => z.im) w :=
    Complex.imCLM.contDiff.contDiffAt
  have hp : ContDiffAt ℝ ∞ (fun z : ℂ => z.im ^ p) w :=
    (Real.contDiffAt_rpow_const_of_ne (x := w.im) (p := p)
      (ne_of_gt hw)).comp w him
  change ContDiffAt ℝ ∞
    (fun z : ℂ => ((z.im ^ p : ℝ) : ℂ)) w
  exact Complex.ofRealCLM.contDiff.contDiffAt.comp w hp

/-- Multiplication by `y^p`, extended by zero through the region where the
test function already vanishes.  It is again an actual test function for
every real exponent, including the negative and half-integral exponents used
below. -/
noncomputable def rpowMul (p : ℝ) (u : Core) : Core := by
  let f : ℂ → ℂ := fun w => rpowScale p w * u w
  have hf : ContDiff ℝ ∞ f := by
    rw [contDiff_iff_contDiffAt]
    intro w
    by_cases hw : 0 < w.im
    · exact (rpowScale_contDiffAt_of_im_pos p hw).mul
        u.contDiff.contDiffAt
    · have hu : (u : ℂ → ℂ) =ᶠ[nhds w] (0 : ℂ → ℂ) := by
        rw [← notMem_tsupport_iff_eventuallyEq]
        intro hwu
        exact hw (u.tsupport_subset hwu)
      have hzero : f =ᶠ[nhds w] (0 : ℂ → ℂ) := by
        filter_upwards [hu] with z hz
        simp [f, hz]
      exact contDiffAt_const.congr_of_eventuallyEq hzero
  exact
    { toFun := f
      contDiff' := hf
      hasCompactSupport' := u.hasCompactSupport.mul_left
      tsupport_subset' :=
        (tsupport_mul_subset_right :
          tsupport (fun w => rpowScale p w * u w) ⊆
            tsupport (u : ℂ → ℂ)).trans u.tsupport_subset }

@[simp]
theorem rpowMul_apply (p : ℝ) (u : Core) (w : ℂ) :
    rpowMul p u w = rpowScale p w * u w :=
  rfl

/-- Every element of this core, including every bundled derivative and every
weighted product constructed above, vanishes pointwise off the open upper
half-plane. -/
theorem eq_zero_of_not_im_pos (u : Core) {w : ℂ}
    (hw : ¬ 0 < w.im) : u w = 0 := by
  exact image_eq_zero_of_notMem_tsupport
    (fun hwu => hw (u.tsupport_subset hwu))

/-- Exact derivative of the height power in an arbitrary real direction. -/
theorem fderiv_rpowScale_apply_of_im_pos
    (p : ℝ) {w ξ : ℂ} (hw : 0 < w.im) :
    fderiv ℝ (rpowScale p) w ξ =
      (((p * w.im ^ (p - 1)) * ξ.im : ℝ) : ℂ) := by
  have him : HasFDerivAt (fun z : ℂ => z.im) Complex.imCLM w :=
    Complex.imCLM.hasFDerivAt
  have hp := him.rpow_const (p := p) (Or.inl (ne_of_gt hw))
  have hc := Complex.ofRealCLM.hasFDerivAt.comp w hp
  have h := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hc.fderiv
  change fderiv ℝ (fun z : ℂ => ((z.im ^ p : ℝ) : ℂ)) w ξ = _
  simpa [Function.comp_def, ContinuousLinearMap.comp_apply,
    Complex.ofRealCLM_apply, Complex.imCLM_apply, smul_eq_mul,
    mul_assoc] using h

/-- Product/chain rule for the weighted test function, with every coefficient
visible. -/
theorem directionalDerivative_rpowMul_apply_of_im_pos
    (p : ℝ) (u : Core) {w ξ : ℂ} (hw : 0 < w.im) :
    directionalDerivative ξ (rpowMul p u) w =
      (((p * w.im ^ (p - 1)) * ξ.im : ℝ) : ℂ) * u w +
        rpowScale p w * directionalDerivative ξ u w := by
  change fderiv ℝ
    (fun z : ℂ => rpowScale p z * (u : ℂ → ℂ) z) w ξ = _
  change (fderiv ℝ (rpowScale p * (u : ℂ → ℂ)) w) ξ = _
  rw [fderiv_mul
    ((rpowScale_contDiffAt_of_im_pos p hw).differentiableAt (by simp))
    ((u.contDiff.differentiable (by simp)) w)]
  simp only [ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul]
  rw [fderiv_rpowScale_apply_of_im_pos p hw]
  simp only [directionalDerivative_apply]
  ring

@[simp]
theorem dx_rpowMul_apply_of_im_pos
    (p : ℝ) (u : Core) {w : ℂ} (hw : 0 < w.im) :
    dx (rpowMul p u) w = rpowScale p w * dx u w := by
  simpa [dx] using
    directionalDerivative_rpowMul_apply_of_im_pos p u hw (ξ := (1 : ℂ))

@[simp]
theorem dy_rpowMul_apply_of_im_pos
    (p : ℝ) (u : Core) {w : ℂ} (hw : 0 < w.im) :
    dy (rpowMul p u) w =
      ((p * w.im ^ (p - 1) : ℝ) : ℂ) * u w +
        rpowScale p w * dy u w := by
  simpa [dy] using
    directionalDerivative_rpowMul_apply_of_im_pos p u hw
      (ξ := Complex.I)

/-- Products of two genuine test functions are integrable over the ambient
Lebesgue measure. -/
theorem product_integrable (u v : Core) :
    Integrable (fun w : ℂ => u w * v w) volume :=
  (u.continuous.mul v.continuous).integrable_of_hasCompactSupport
    u.hasCompactSupport.mul_right

/-- The bilinear compact-core pairing used after conjugating and inserting
the Petersson height factor explicitly. -/
noncomputable def compactPair (u v : Core) : ℂ :=
  ∫ w : ℂ, u w * v w

theorem compactPair_add_left (u v w : Core) :
    compactPair (u + v) w = compactPair u w + compactPair v w := by
  unfold compactPair
  change (∫ z : ℂ, (u z + v z) * w z) = _
  simpa only [add_mul] using
    integral_add (product_integrable u w) (product_integrable v w)

theorem compactPair_add_right (u v w : Core) :
    compactPair u (v + w) = compactPair u v + compactPair u w := by
  unfold compactPair
  change (∫ z : ℂ, u z * (v z + w z)) = _
  simpa only [mul_add] using
    integral_add (product_integrable u v) (product_integrable u w)

theorem compactPair_smul_left (c : ℂ) (u v : Core) :
    compactPair (c • u) v = c * compactPair u v := by
  unfold compactPair
  change (∫ z : ℂ, (c * u z) * v z) = _
  simp_rw [mul_assoc]
  exact integral_const_mul c (fun z : ℂ => u z * v z)

theorem compactPair_smul_right (c : ℂ) (u v : Core) :
    compactPair u (c • v) = c * compactPair u v := by
  unfold compactPair
  change (∫ z : ℂ, u z * (c * v z)) = _
  have hpoint : (fun z : ℂ => u z * (c * v z)) =
      fun z : ℂ => c * (u z * v z) := by
    funext z
    ring
  rw [hpoint]
  exact integral_const_mul c (fun z : ℂ => u z * v z)

/-- Full-space integration by parts on the actual compact core.  All three
integrability hypotheses of Mathlib's theorem are discharged from the core
itself. -/
theorem compactPair_directionalDerivative_right
    (ξ : ℂ) (u v : Core) :
    compactPair u (directionalDerivative ξ v) =
      -compactPair (directionalDerivative ξ u) v := by
  have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (μ := (volume : Measure ℂ))
    (f := (u : ℂ → ℂ)) (g := (v : ℂ → ℂ)) (v := ξ)
    (by simpa only [directionalDerivative_apply] using
      product_integrable (directionalDerivative ξ u) v)
    (by simpa only [directionalDerivative_apply] using
      product_integrable u (directionalDerivative ξ v))
    (product_integrable u v)
    (fun z _ => (u.contDiff.differentiable (by simp)) z)
    (fun z _ => (v.contDiff.differentiable (by simp)) z)
  simpa only [compactPair, directionalDerivative_apply] using h

/-- The orientation used in the formal-adjoint calculation. -/
theorem compactPair_directionalDerivative_left
    (ξ : ℂ) (u v : Core) :
    compactPair (directionalDerivative ξ u) v =
      -compactPair u (directionalDerivative ξ v) := by
  have h := compactPair_directionalDerivative_right ξ u v
  rw [h]
  simp

/-! #### One-sided compact localization

For closability on the physical Petersson `L²` space one must test a possibly
non-compact automorphic function against a compactly supported local test.
The two-sided theorem above is not directly applicable because an
automorphic lift is never compactly supported upstairs.  The construction
below packages the *product* with the compact test as a genuine element of
`Core`.  This is the distributional localization needed for a local proof of
closability and uses no polygonal boundary theorem. -/

/-- Multiplication of an arbitrary real-smooth upper-half-plane function by
an ambient compact test is again an actual compact test.  Away from the upper
half-plane the second factor vanishes on a neighbourhood, so no regularity of
`upperLift f` across the real axis is asserted or needed. -/
noncomputable def localizeLeft (f : ℍ → ℂ) (hf : RealSmooth f)
    (v : Core) : Core := by
  let F : ℂ → ℂ := fun w => upperLift f w * v w
  have hF : ContDiff ℝ ∞ F := by
    rw [contDiff_iff_contDiffAt]
    intro w
    by_cases hw : 0 < w.im
    · exact ((hf w hw).contDiffAt
        (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds hw)).mul
        v.contDiff.contDiffAt
    · have hv : (v : ℂ → ℂ) =ᶠ[nhds w] (0 : ℂ → ℂ) := by
        rw [← notMem_tsupport_iff_eventuallyEq]
        intro hwv
        exact hw (v.tsupport_subset hwv)
      have hzero : F =ᶠ[nhds w] (0 : ℂ → ℂ) := by
        filter_upwards [hv] with z hz
        simp [F, hz]
      exact contDiffAt_const.congr_of_eventuallyEq hzero
  exact
    { toFun := F
      contDiff' := hF
      hasCompactSupport' := v.hasCompactSupport.mul_left
      tsupport_subset' :=
        (tsupport_mul_subset_right :
          tsupport (fun w => upperLift f w * v w) ⊆
            tsupport (v : ℂ → ℂ)).trans v.tsupport_subset }

@[simp]
theorem localizeLeft_apply (f : ℍ → ℂ) (hf : RealSmooth f)
    (v : Core) (w : ℂ) :
    localizeLeft f hf v w = upperLift f w * v w :=
  rfl

/-- On the upper-half-plane chart, differentiation of the localized product
is the ordinary product rule. -/
theorem directionalDerivative_localizeLeft_apply
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core)
    (ξ : ℂ) (z : ℍ) :
    directionalDerivative ξ (localizeLeft f hf v) (z : ℂ) =
      d1 f z ξ * v (z : ℂ) +
        f z * directionalDerivative ξ v (z : ℂ) := by
  change (fderiv ℝ (upperLift f * (v : ℂ → ℂ)) (z : ℂ)) ξ = _
  rw [fderiv_mul
    ((RealSmooth.contDiffAt_upperLift hf z).differentiableAt (by simp))
    ((v.contDiff.differentiable (by simp)) (z : ℂ))]
  simp only [ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul,
    directionalDerivative_apply, upperLift_apply, d1]
  ring

/-- Every genuine compact test, and hence every localized product above, is
Bochner integrable against ambient planar Lebesgue measure. -/
theorem core_integrable (u : Core) :
    Integrable (u : ℂ → ℂ) volume :=
  u.continuous.integrable_of_hasCompactSupport u.hasCompactSupport

/-- The integral of a directional derivative of a compact test is zero.  It
is obtained from Mathlib's full-space integration-by-parts theorem with the
constant function in the other factor. -/
theorem integral_directionalDerivative_eq_zero (ξ : ℂ) (u : Core) :
    (∫ w : ℂ, directionalDerivative ξ u w) = 0 := by
  have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (μ := (volume : Measure ℂ))
    (f := fun _w : ℂ => (1 : ℂ)) (g := (u : ℂ → ℂ)) (v := ξ)
    (by simpa using (integrable_zero :
      Integrable (fun _w : ℂ => (0 : ℂ)) volume))
    (by
      exact (core_integrable (directionalDerivative ξ u)).congr
        (Filter.Eventually.of_forall fun x => by
          simpa only [one_mul] using directionalDerivative_apply ξ u x))
    (by simpa only [one_mul] using core_integrable u)
    (fun w _ => differentiableAt_const (c := (1 : ℂ)))
    (fun w _ => (u.contDiff.differentiable (by simp)) w)
  have hconst :
      (fun x : ℂ =>
        (fderiv ℝ (fun _w : ℂ => (1 : ℂ)) x) ξ * u x) = 0 := by
    funext x
    simp
  rw [hconst] at h
  simp at h
  simpa only [one_mul, directionalDerivative_apply] using h

/-- Exact product rule as an equality in the genuine compact test core. -/
theorem directionalDerivative_localizeLeft
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) (ξ : ℂ) :
    directionalDerivative ξ (localizeLeft f hf v) =
      localizeLeft (fun z => d1 f z ξ) (RealSmooth.d1_constDirection hf ξ) v +
        localizeLeft f hf (directionalDerivative ξ v) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · let z : ℍ := ⟨w, hw⟩
    simpa [z, upperLift, Function.comp_def,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw] using
        directionalDerivative_localizeLeft_apply f hf v ξ z
  · rw [eq_zero_of_not_im_pos
      (directionalDerivative ξ (localizeLeft f hf v)) hw,
      eq_zero_of_not_im_pos
        (localizeLeft (fun z => d1 f z ξ)
          (RealSmooth.d1_constDirection hf ξ) v +
          localizeLeft f hf (directionalDerivative ξ v)) hw]

/-- One-sided integration by parts: only the test factor is required to be
compactly supported.  This is the local distributional Green identity used
to prove closability without any paired-polygon Stokes theorem. -/
theorem integral_d1_mul_test_eq_neg
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) (ξ : ℂ) :
    (∫ w : ℂ,
        localizeLeft (fun z => d1 f z ξ)
          (RealSmooth.d1_constDirection hf ξ) v w) =
      -(∫ w : ℂ,
        localizeLeft f hf (directionalDerivative ξ v) w) := by
  have hzero := integral_directionalDerivative_eq_zero ξ
    (localizeLeft f hf v)
  rw [directionalDerivative_localizeLeft f hf v ξ] at hzero
  change (∫ w : ℂ,
      localizeLeft (fun z => d1 f z ξ)
          (RealSmooth.d1_constDirection hf ξ) v w +
        localizeLeft f hf (directionalDerivative ξ v) w) = 0 at hzero
  rw [integral_add
      (core_integrable
        (localizeLeft (fun z => d1 f z ξ)
          (RealSmooth.d1_constDirection hf ξ) v))
      (core_integrable
        (localizeLeft f hf (directionalDerivative ξ v)))] at hzero
  exact eq_neg_of_add_eq_zero_left hzero

/-- The one-sided formula in the horizontal coordinate. -/
theorem integral_dx_mul_test_eq_neg
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dx f)
          (RealSmooth.dx hf) v w) =
      -(∫ w : ℂ, localizeLeft f hf (dx v) w) := by
  change (∫ w : ℂ,
      localizeLeft (fun z => d1 f z 1)
        (RealSmooth.d1_constDirection hf 1) v w) =
      -(∫ w : ℂ, localizeLeft f hf (directionalDerivative 1 v) w)
  exact integral_d1_mul_test_eq_neg f hf v 1

/-- The one-sided formula in the vertical coordinate. -/
theorem integral_dy_mul_test_eq_neg
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dy f)
          (RealSmooth.dy hf) v w) =
      -(∫ w : ℂ, localizeLeft f hf (dy v) w) := by
  change (∫ w : ℂ,
      localizeLeft (fun z => d1 f z Complex.I)
        (RealSmooth.d1_constDirection hf Complex.I) v w) =
      -(∫ w : ℂ,
        localizeLeft f hf (directionalDerivative Complex.I v) w)
  exact integral_d1_mul_test_eq_neg f hf v Complex.I

/-- A bundled directional derivative cannot enlarge topological support. -/
theorem tsupport_directionalDerivative_subset
    (ξ : ℂ) (v : Core) :
    tsupport (directionalDerivative ξ v : ℂ → ℂ) ⊆
      tsupport (v : ℂ → ℂ) := by
  have hfun : (directionalDerivative ξ v : ℂ → ℂ) =
      fun w : ℂ => fderiv ℝ (v : ℂ → ℂ) w ξ := by
    funext w
    exact directionalDerivative_apply ξ v w
  rw [hfun]
  exact (tsupport_fderiv_apply_subset ℝ ξ :
    tsupport (fun w : ℂ => fderiv ℝ (v : ℂ → ℂ) w ξ) ⊆
      tsupport (v : ℂ → ℂ))

theorem tsupport_dx_subset (v : Core) :
    tsupport (dx v : ℂ → ℂ) ⊆ tsupport (v : ℂ → ℂ) :=
  tsupport_directionalDerivative_subset 1 v

theorem tsupport_dy_subset (v : Core) :
    tsupport (dy v : ℂ → ℂ) ⊆ tsupport (v : ℂ → ℂ) :=
  tsupport_directionalDerivative_subset Complex.I v

/-- Multiplication by a height power cannot enlarge the support of a compact
test. -/
theorem tsupport_rpowMul_subset (p : ℝ) (v : Core) :
    tsupport (rpowMul p v : ℂ → ℂ) ⊆ tsupport (v : ℂ → ℂ) :=
  tsupport_mul_subset_right

/-- Horizontal differentiation commutes with every real height power. -/
theorem dx_rpowMul (p : ℝ) (v : Core) :
    dx (rpowMul p v) = rpowMul p (dx v) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · simpa using dx_rpowMul_apply_of_im_pos p v hw
  · rw [eq_zero_of_not_im_pos (dx (rpowMul p v)) hw,
      eq_zero_of_not_im_pos (rpowMul p (dx v)) hw]

/-- Vertical differentiation of a general height power, with the derivative
of the coefficient retained as a separate compact-core term. -/
theorem dy_rpowMul (p : ℝ) (v : Core) :
    dy (rpowMul p v) =
      (p : ℂ) • rpowMul (p - 1) v + rpowMul p (dy v) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · rw [dy_rpowMul_apply_of_im_pos p v hw]
    change _ = (p : ℂ) * rpowMul (p - 1) v w +
      rpowMul p (dy v) w
    simp only [rpowMul_apply, rpowScale, smul_eq_mul,
      Complex.ofReal_mul]
    ring
  · rw [eq_zero_of_not_im_pos (dy (rpowMul p v)) hw,
      eq_zero_of_not_im_pos
        ((p : ℂ) • rpowMul (p - 1) v + rpowMul p (dy v)) hw]

/-- One-sided horizontal integration by parts after inserting any real power
of the height in the compact test factor. -/
theorem integral_rpow_dx_mul_test_eq_neg
    (p : ℝ) (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dx f)
          (RealSmooth.dx hf) (rpowMul p v) w) =
      -(∫ w : ℂ,
        localizeLeft f hf (rpowMul p (dx v)) w) := by
  rw [← dx_rpowMul]
  exact integral_dx_mul_test_eq_neg f hf (rpowMul p v)

/-- One-sided vertical integration by parts with an arbitrary height power.
The first term on the right is the exact derivative of `y^p`. -/
theorem integral_rpow_dy_mul_test_eq_neg
    (p : ℝ) (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dy f)
          (RealSmooth.dy hf) (rpowMul p v) w) =
      -(∫ w : ℂ,
        localizeLeft f hf
          ((p : ℂ) • rpowMul (p - 1) v + rpowMul p (dy v)) w) := by
  rw [← dy_rpowMul]
  exact integral_dy_mul_test_eq_neg f hf (rpowMul p v)

/-- Horizontal differentiation commutes with multiplication by the height
inside the compact test core. -/
theorem dx_rpowMul_one (v : Core) :
    dx (rpowMul 1 v) = rpowMul 1 (dx v) := by
  exact dx_rpowMul 1 v

/-- Vertical differentiation of `y v` retains the derivative of the height
itself. -/
theorem dy_rpowMul_one (v : Core) :
    dy (rpowMul 1 v) = v + rpowMul 1 (dy v) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · rw [dy_rpowMul_apply_of_im_pos (1 : ℝ) v hw]
    change _ = v w + rpowMul 1 (dy v) w
    simp only [rpowMul_apply, rpowScale, Real.rpow_one, one_mul,
      sub_self, Real.rpow_zero, Complex.ofReal_one]
  · rw [eq_zero_of_not_im_pos (dy (rpowMul 1 v)) hw,
      eq_zero_of_not_im_pos (v + rpowMul 1 (dy v)) hw]

/-- Horizontal one-sided integration by parts with the variable coefficient
`y`. -/
theorem integral_height_dx_mul_test_eq_neg
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dx f)
          (RealSmooth.dx hf) (rpowMul 1 v) w) =
      -(∫ w : ℂ,
        localizeLeft f hf (rpowMul 1 (dx v)) w) := by
  rw [← dx_rpowMul_one]
  exact integral_dx_mul_test_eq_neg f hf (rpowMul 1 v)

/-- Vertical one-sided integration by parts with the variable coefficient
`y`; the additional zeroth-order term is the derivative of `y`. -/
theorem integral_height_dy_mul_test_eq_neg
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : Core) :
    (∫ w : ℂ,
        localizeLeft (HalfWeightDifferentialOperators.dy f)
          (RealSmooth.dy hf) (rpowMul 1 v) w) =
      -(∫ w : ℂ,
        localizeLeft f hf (v + rpowMul 1 (dy v)) w) := by
  rw [← dy_rpowMul_one]
  exact integral_dy_mul_test_eq_neg f hf (rpowMul 1 v)

/-! #### Actual coordinate raising/lowering maps -/

@[simp]
theorem conj_exponentC (a : ℤ) :
    star (exponentC a) = exponentC a := by
  simp [exponentC, exponentR]

@[simp]
theorem conj_rpowScale (p : ℝ) (w : ℂ) :
    star (rpowScale p w) = rpowScale p w := by
  simp [rpowScale]

/-- Directional differentiation commutes with conjugation because both are
real-linear operations. -/
@[simp]
theorem directionalDerivative_conjugate_apply
    (ξ : ℂ) (u : Core) (w : ℂ) :
    directionalDerivative ξ (conjugate u) w =
      star (directionalDerivative ξ u w) := by
  have hu : DifferentiableAt ℝ (u : ℂ → ℂ) w :=
    (u.contDiff.differentiable (by simp)) w
  have hcomp := Complex.conjCLE.hasFDerivAt.comp w hu.hasFDerivAt
  have h := congrArg (fun L : ℂ →L[ℝ] ℂ => L ξ) hcomp.fderiv
  simpa [directionalDerivative_apply, conjugate,
    TestFunction.postcompCLM_apply, Function.comp_def,
    ContinuousLinearMap.comp_apply, Complex.conjCLE_apply] using h

@[simp]
theorem dx_conjugate_apply (u : Core) (w : ℂ) :
    dx (conjugate u) w = star (dx u w) := by
  simpa [dx] using directionalDerivative_conjugate_apply 1 u w

@[simp]
theorem dy_conjugate_apply (u : Core) (w : ℂ) :
    dy (conjugate u) w = star (dy u w) := by
  simpa [dy] using
    directionalDerivative_conjugate_apply Complex.I u w

/-- The coordinate raising operator on the actual upper-plane test core.
The `y⁻¹` coefficient is implemented by the already-proved smooth compact
multiplier `rpowMul (-1)`. -/
noncomputable def raise (a : ℤ) (u : Core) : Core :=
  Complex.I • dx u + dy u + exponentC a • rpowMul (-1) u

/-- Lowering after dividing out its `y²` coefficient.  This is the expression
which occurs in the source-weight Petersson integral. -/
noncomputable def normalizedLower (v : Core) : Core :=
  (-Complex.I) • dx v + dy v

/-- The unnormalized lowering operator `L = y²(-i ∂x + ∂y)`. -/
noncomputable def lower (v : Core) : Core :=
  rpowMul 2 (normalizedLower v)

/-- Conjugation followed by the exact source Petersson-coordinate scale. -/
noncomputable def weightedConjugate (a : ℤ) (u : Core) : Core :=
  rpowMul (exponentR a) (conjugate u)

@[simp]
theorem raise_apply (a : ℤ) (u : Core) (w : ℂ) :
    raise a u w =
      Complex.I * dx u w + dy u w +
        exponentC a * rpowScale (-1) w * u w := by
  simp [raise, smul_eq_mul]
  ring

@[simp]
theorem normalizedLower_apply (v : Core) (w : ℂ) :
    normalizedLower v w = -Complex.I * dx v w + dy v w := by
  simp [normalizedLower, smul_eq_mul]

@[simp]
theorem lower_apply (v : Core) (w : ℂ) :
    lower v w = rpowScale 2 w *
      (-Complex.I * dx v w + dy v w) := by
  simp [lower]

@[simp]
theorem weightedConjugate_apply (a : ℤ) (u : Core) (w : ℂ) :
    weightedConjugate a u w =
      rpowScale (exponentR a) w * star (u w) := by
  simp [weightedConjugate]

theorem dx_weightedConjugate_apply_of_im_pos
    (a : ℤ) (u : Core) {w : ℂ} (hw : 0 < w.im) :
    dx (weightedConjugate a u) w =
      rpowScale (exponentR a) w * star (dx u w) := by
  rw [weightedConjugate, dx_rpowMul_apply_of_im_pos _ _ hw,
    dx_conjugate_apply]

theorem dy_weightedConjugate_apply_of_im_pos
    (a : ℤ) (u : Core) {w : ℂ} (hw : 0 < w.im) :
    dy (weightedConjugate a u) w =
      ((exponentR a * w.im ^ (exponentR a - 1) : ℝ) : ℂ) *
          star (u w) +
        rpowScale (exponentR a) w * star (dy u w) := by
  rw [weightedConjugate, dy_rpowMul_apply_of_im_pos _ _ hw,
    conjugate_apply, dy_conjugate_apply]

/-- Multiplying the source scale by `y⁻¹` gives exactly the derivative
coefficient `q y^(q-1)`. -/
theorem weighted_inverse_height_coefficient
    (a : ℤ) {w : ℂ} (hw : 0 < w.im) :
    rpowScale (exponentR a) w *
        (exponentC a * rpowScale (-1) w) =
      ((exponentR a * w.im ^ (exponentR a - 1) : ℝ) : ℂ) := by
  have hpow :
      rpowScale (exponentR a) w * rpowScale (-1) w =
        ((w.im ^ (exponentR a - 1) : ℝ) : ℂ) := by
    rw [rpowScale, rpowScale, ← Complex.ofReal_mul]
    congr 1
    rw [← Real.rpow_add hw]
    congr 1
  calc
    rpowScale (exponentR a) w *
        (exponentC a * rpowScale (-1) w) =
      exponentC a *
        (rpowScale (exponentR a) w * rpowScale (-1) w) := by ring
    _ = exponentC a *
        ((w.im ^ (exponentR a - 1) : ℝ) : ℂ) := by rw [hpow]
    _ = ((exponentR a * w.im ^ (exponentR a - 1) : ℝ) : ℂ) := by
      simp [exponentC, Complex.ofReal_mul]

/-- Exact flux identity before integration.  It is an equality *inside the
actual test-function core*, hence it also proves all regularity and support
claims needed by the subsequent integration-by-parts argument. -/
theorem weightedConjugate_raise_eq_flux (a : ℤ) (u : Core) :
    weightedConjugate a (raise a u) =
      (-Complex.I) • dx (weightedConjugate a u) +
        dy (weightedConjugate a u) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · change
      rpowScale (exponentR a) w * star (raise a u w) =
        -Complex.I * dx (weightedConjugate a u) w +
          dy (weightedConjugate a u) w
    rw [raise_apply,
      dx_weightedConjugate_apply_of_im_pos a u hw,
      dy_weightedConjugate_apply_of_im_pos a u hw]
    simp only [star_add, star_mul, Complex.conj_I,
      conj_exponentC, conj_rpowScale]
    have hI : star Complex.I = -Complex.I := by
      exact Complex.conj_I
    rw [hI]
    have hcoeff := weighted_inverse_height_coefficient a hw
    linear_combination (star (u w)) * hcoeff
  · rw [eq_zero_of_not_im_pos
      (weightedConjugate a (raise a u)) hw,
      eq_zero_of_not_im_pos
        ((-Complex.I) • dx (weightedConjugate a u) +
          dy (weightedConjugate a u)) hw]

/-! #### Boundary-free Green identity on the coordinate core -/

/-- Exact formal-adjoint identity on `C_c^∞(ℍ)`.  The target-weight
Petersson factor and hyperbolic density have already cancelled to the source
factor `y^(a/2)`; `normalizedLower = lower / y²` is therefore the precise
lowering term. -/
theorem compact_green_identity (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (raise a u)) v =
      -compactPair (weightedConjugate a u) (normalizedLower v) := by
  rw [weightedConjugate_raise_eq_flux, dx, dy, normalizedLower,
    compactPair_add_left, compactPair_smul_left,
    compactPair_directionalDerivative_left,
    compactPair_directionalDerivative_left,
    compactPair_add_right, compactPair_smul_right]
  simp only [dx, dy] <;> ring

/-- The same theorem written as an exact zero-boundary Green sum. -/
theorem compact_green_sum_eq_zero (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (raise a u)) v +
        compactPair (weightedConjugate a u) (normalizedLower v) = 0 := by
  rw [compact_green_identity]
  ring

/-- Moving a height multiplier between the two slots does not change the
bilinear compact-core pairing. -/
theorem compactPair_rpowMul_left_eq_right
    (p : ℝ) (u v : Core) :
    compactPair (rpowMul p u) v = compactPair u (rpowMul p v) := by
  unfold compactPair
  exact integral_congr_ae (Filter.Eventually.of_forall (fun w => by
    simp only [rpowMul_apply]
    ring))

/-- Flux identity for the normalized lowering operator. -/
theorem weightedConjugate_normalizedLower_eq_flux
    (a : ℤ) (u : Core) :
    weightedConjugate a (normalizedLower u) =
      Complex.I • dx (weightedConjugate a u) +
        dy (weightedConjugate a u) +
        (-exponentC a) • rpowMul (-1) (weightedConjugate a u) := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · change
      rpowScale (exponentR a) w *
          star (normalizedLower u w) =
        Complex.I * dx (weightedConjugate a u) w +
          dy (weightedConjugate a u) w +
          (-exponentC a) *
            (rpowScale (-1) w * weightedConjugate a u w)
    rw [normalizedLower_apply,
      dx_weightedConjugate_apply_of_im_pos a u hw,
      dy_weightedConjugate_apply_of_im_pos a u hw,
      weightedConjugate_apply]
    simp only [star_add, star_mul, star_neg, Complex.conj_I,
      conj_exponentC, conj_rpowScale]
    have hI : star Complex.I = -Complex.I := by
      exact Complex.conj_I
    rw [hI]
    have hcoeff := weighted_inverse_height_coefficient a hw
    rw [← hcoeff]
    ring
  · rw [eq_zero_of_not_im_pos
      (weightedConjugate a (normalizedLower u)) hw,
      eq_zero_of_not_im_pos
        (Complex.I • dx (weightedConjugate a u) +
          dy (weightedConjugate a u) +
          (-exponentC a) • rpowMul (-1) (weightedConjugate a u)) hw]

/-- The corresponding lowering Green identity, proved independently on the
same actual compact core. -/
theorem compact_lowering_green_identity (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (normalizedLower u)) v =
      -compactPair (weightedConjugate a u) (raise a v) := by
  rw [weightedConjugate_normalizedLower_eq_flux, dx, dy, raise,
    compactPair_add_left, compactPair_add_left,
    compactPair_smul_left,
    compactPair_directionalDerivative_left,
    compactPair_directionalDerivative_left,
    compactPair_smul_left,
    compactPair_rpowMul_left_eq_right,
    compactPair_add_right, compactPair_add_right,
    compactPair_smul_right, compactPair_smul_right]
  simp only [dx, dy] <;> ring

/-- Zero-sum form of the lowering identity. -/
theorem compact_lowering_green_sum_eq_zero (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (normalizedLower u)) v +
        compactPair (weightedConjugate a u) (raise a v) = 0 := by
  rw [compact_lowering_green_identity]
  ring

/-- Averaging the raising and lowering Green sums retains the indispensable
factor `1/2`; no normalization is silently doubled. -/
theorem compact_green_half_average_eq_zero (a : ℤ) (u v : Core) :
    (1 / 2 : ℂ) *
        (compactPair (weightedConjugate a (raise a u)) v +
          compactPair (weightedConjugate a u) (normalizedLower v)) +
      (1 / 2 : ℂ) *
        (compactPair (weightedConjugate a (normalizedLower u)) v +
          compactPair (weightedConjugate a u) (raise a v)) = 0 := by
  rw [compact_green_sum_eq_zero,
    compact_lowering_green_sum_eq_zero]
  ring

/-- Expanded integral form of the same theorem.  This makes the exact
conjugation convention and the real two-dimensional Lebesgue measure
syntactically visible. -/
theorem compact_green_identity_expanded (a : ℤ) (u v : Core) :
    (∫ w : ℂ,
      rpowScale (exponentR a) w * star (raise a u w) * v w) =
      -(∫ w : ℂ,
        rpowScale (exponentR a) w * star (u w) *
          normalizedLower v w) := by
  simpa only [compactPair, weightedConjugate_apply] using
    compact_green_identity a u v

/-! #### Bridge back to the upper-half-plane raw operators -/

/-- Restriction of an ambient test function to `ℍ`. -/
def restrictToUpper (u : Core) : ℍ → ℂ :=
  fun z => u (z : ℂ)

theorem upperLift_restrictToUpper_eqOn (u : Core) :
    Set.EqOn (upperLift (restrictToUpper u)) (u : ℂ → ℂ)
      UpperHalfPlane.upperHalfPlaneSet := by
  intro w hw
  simp [upperLift, restrictToUpper, Function.comp_def,
    UpperHalfPlane.ofComplex_apply_of_im_pos hw]

/-- The restriction is genuinely real `C∞` in the chart used by the raw
half-weight operators. -/
theorem restrictToUpper_realSmooth (u : Core) :
    RealSmooth (restrictToUpper u) := by
  unfold RealSmooth
  exact u.contDiff.contDiffOn.congr
    (upperLift_restrictToUpper_eqOn u)

theorem upperLift_restrictToUpper_eventuallyEq
    (u : Core) (z : ℍ) :
    upperLift (restrictToUpper u) =ᶠ[nhds (z : ℂ)] (u : ℂ → ℂ) := by
  filter_upwards [
    UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
  exact upperLift_restrictToUpper_eqOn u hw

/-- The two definitions of the `x` derivative agree after restriction. -/
theorem raw_dx_restrictToUpper (u : Core) (z : ℍ) :
    HalfWeightDifferentialOperators.dx (restrictToUpper u) z =
      dx u (z : ℂ) := by
  unfold HalfWeightDifferentialOperators.dx
    HalfWeightDifferentialOperators.d1
  rw [(upperLift_restrictToUpper_eventuallyEq u z).fderiv_eq]
  exact (directionalDerivative_apply 1 u (z : ℂ)).symm

/-- The two definitions of the `y` derivative agree after restriction. -/
theorem raw_dy_restrictToUpper (u : Core) (z : ℍ) :
    HalfWeightDifferentialOperators.dy (restrictToUpper u) z =
      dy u (z : ℂ) := by
  unfold HalfWeightDifferentialOperators.dy
    HalfWeightDifferentialOperators.d1
  rw [(upperLift_restrictToUpper_eventuallyEq u z).fderiv_eq]
  exact (directionalDerivative_apply Complex.I u (z : ℂ)).symm

/-- On the upper half-plane, the real scale used in the coordinate proof is
exactly the invariant fiber scale at multiplier index `-a`. -/
theorem rpowScale_eq_weightFiberScale
    (a : ℤ) {w : ℂ} (hw : 0 < w.im) :
    rpowScale (exponentR a) w =
      (weightFiberScale (-a) (UpperHalfPlane.ofComplex w) : ℂ) := by
  have him : (UpperHalfPlane.ofComplex w).im = w.im := by
    rw [UpperHalfPlane.ofComplex_apply_of_im_pos hw]
    rfl
  change ((w.im ^ ((a : ℝ) / 2) : ℝ) : ℂ) =
    (((Real.sqrt (UpperHalfPlane.ofComplex w).im) ^
      (-(-a) : ℤ) : ℝ) : ℂ)
  rw [him, neg_neg, Real.rpow_div_two_eq_sqrt (a : ℝ) hw.le,
    Real.rpow_intCast]

/-- The coordinate-core raising operator is literally the existing corrected
raw raising operator after restriction. -/
theorem restrictToUpper_raise (a : ℤ) (u : Core) (z : ℍ) :
    restrictToUpper (raise a u) z =
      raiseRaw a (restrictToUpper u) z := by
  change raise a u (z : ℂ) = _
  rw [raise_apply]
  unfold raiseRaw
  rw [raw_dx_restrictToUpper, raw_dy_restrictToUpper]
  simp [exponentC_eq_physicalExponent, rpowScale,
    Real.rpow_neg_one, heightC, restrictToUpper, div_eq_mul_inv]

/-- The unnormalized coordinate lowering operator likewise agrees literally
with `lowerRaw`.  Its formal-adjoint partner is therefore exactly
`normalizedLower = lowerRaw / y²`, not a differently indexed expression. -/
theorem restrictToUpper_lower (a : ℤ) (v : Core) (z : ℍ) :
    restrictToUpper (lower v) z =
      lowerRaw a (restrictToUpper v) z := by
  change lower v (z : ℂ) = _
  rw [lower_apply]
  unfold lowerRaw
  rw [raw_dx_restrictToUpper, raw_dy_restrictToUpper]
  simp [rpowScale, Real.rpow_two, heightC]
  ring

/-- Exact normalized lowering identity used in `compact_green_identity`. -/
theorem normalizedLower_eq_lowerRaw_div_heightSq
    (a : ℤ) (v : Core) (z : ℍ) :
    normalizedLower v (z : ℂ) =
      lowerRaw a (restrictToUpper v) z / heightC z ^ 2 := by
  have hy : heightC z ≠ 0 := heightC_ne_zero z
  rw [normalizedLower_apply]
  unfold lowerRaw
  rw [raw_dx_restrictToUpper, raw_dy_restrictToUpper]
  field_simp [hy]

/-! #### Constant shifts and the indispensable one-half average -/

/-- The lower-after-raise factorization transported to the actual coordinate
test core.  The zero-order term is retained. -/
theorem coordinate_lower_raise_factorization
    (a : ℤ) (u : Core) (z : ℍ) :
    -laplaceRaw a (restrictToUpper u) z =
      restrictToUpper (lower (raise a u)) z +
        physicalExponent a * restrictToUpper u z := by
  have hR : restrictToUpper (raise a u) =
      raiseRaw a (restrictToUpper u) :=
    funext (restrictToUpper_raise a u)
  rw [restrictToUpper_lower (a + 4), hR]
  exact lower_raise_factorization (restrictToUpper_realSmooth u) z

/-- The raise-after-lower factorization on the same actual core. -/
theorem coordinate_raise_lower_factorization
    (a : ℤ) (u : Core) (z : ℍ) :
    -laplaceRaw a (restrictToUpper u) z =
      restrictToUpper (raise (a - 4) (lower u)) z := by
  have hL : restrictToUpper (lower u) =
      lowerRaw a (restrictToUpper u) :=
    funext (restrictToUpper_lower a u)
  rw [restrictToUpper_raise, hL]
  exact raise_lower_factorization (restrictToUpper_realSmooth u) z

/-- Averaging the two exact factorizations keeps both the coefficient `1/2`
and the constant shift `physicalExponent a / 2`. -/
theorem coordinate_averaged_factorization
    (a : ℤ) (u : Core) (z : ℍ) :
    -laplaceRaw a (restrictToUpper u) z =
      (1 / 2 : ℂ) *
        (restrictToUpper (lower (raise a u)) z +
          restrictToUpper (raise (a - 4) (lower u)) z) +
      (physicalExponent a / 2) * restrictToUpper u z := by
  have hLR := coordinate_lower_raise_factorization a u z
  have hRL := coordinate_raise_lower_factorization a u z
  linear_combination (1 / 2 : ℂ) * hLR + (1 / 2 : ℂ) * hRL

/-! The following aliases make the scope of the proved Green theorem visible
at every use site.  In particular, `ambientCcInfinity` means compact support
in the ambient upper-half-plane chart, not merely compact support on the
automorphic quotient. -/

/-- Raising Green identity on the genuine ambient `C_c^∞(ℍ)` core. -/
theorem ambientCcInfinity_raising_green_identity
    (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (raise a u)) v =
      -compactPair (weightedConjugate a u) (normalizedLower v) :=
  compact_green_identity a u v

/-- Lowering Green identity on the genuine ambient `C_c^∞(ℍ)` core. -/
theorem ambientCcInfinity_lowering_green_identity
    (a : ℤ) (u v : Core) :
    compactPair (weightedConjugate a (normalizedLower u)) v =
      -compactPair (weightedConjugate a u) (raise a v) :=
  compact_lowering_green_identity a u v

/-- Exact half-average on the genuine ambient `C_c^∞(ℍ)` core. -/
theorem ambientCcInfinity_green_half_average_eq_zero
    (a : ℤ) (u v : Core) :
    (1 / 2 : ℂ) *
        (compactPair (weightedConjugate a (raise a u)) v +
          compactPair (weightedConjugate a u) (normalizedLower v)) +
      (1 / 2 : ℂ) *
        (compactPair (weightedConjugate a (normalizedLower u)) v +
          compactPair (weightedConjugate a u) (raise a v)) = 0 :=
  compact_green_half_average_eq_zero a u v

/-!
Honesty boundary.  `Core` has compact support in the ambient upper half-plane.
An automorphic fixed-phase lift instead repeats along every `Gamma(2)` orbit
and has only *quotient*-compact support, so there is intentionally no coercion
from `InverseEtaFixedPhaseCore n` to `Core`.  Consequently the theorems above
do not assert `FixedPhasePeterssonCoordinates.greenBoundaryDefect = 0` on the
quotient.  That final statement still requires polygonal Stokes, paired-side
cancellation, and horocycle trace/decay; nullity of the geometric boundary
alone is not an integration-by-parts theorem.
-/

end

end HalfWeightCompactCoordinateGreen

/-! ### 6.5.2: exact missing quotient-Stokes statements

Mathlib contains the full-space integration-by-parts theorem used in
`HalfWeightCompactCoordinateGreen`, and rectangular divergence theorems such
as `MeasureTheory.integral_divergence_prod_Icc_of_hasFDerivAt_of_le`.  The
latter applies to a Cartesian rectangle with four explicitly parametrized
edges.  The selected `Gamma(2)` carrier is instead a finite union of Möbius
images of the modular tile; its boundary contains circular arcs, paired
vertical sides, and cusp horocycles.  The current modular API supplies these
sets, their point parametrizations, orientation signs, pairing maps, and
finite corner deletion.  It does not yet supply the derivative/tangent form
of those parametrizations or a curvilinear change-of-variables theorem that
identifies the tile area integral with the resulting one-dimensional flux
sum.  Thus the rectangular theorem cannot be instantiated merely by
rewriting sets.

The declarations below state the precise lower-level theorem that is missing.
They do not add a certificate to a differential core and do not repackage the
desired Petersson equality as a hypothesis.  Instead they expose the
coordinate flux one-form, its pullback law under `Gamma(2)`, and the actual
Euclidean-divergence integral (written against hyperbolic measure with the
Jacobian factor `y²`).
-/

namespace GammaTwoQuotientGreenBoundary

open MeasureTheory Set
open HalfWeightDifferentialOperators
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry

/-- Every real power of the positive height, complexified, is real smooth on
the upper half-plane. -/
theorem realSmooth_complexHeightRpow (p : ℝ) :
    RealSmooth (fun z : ℍ => ((z.im ^ p : ℝ) : ℂ)) := by
  unfold RealSmooth
  have hBase : ContDiffOn ℝ (↑(⊤ : ℕ∞))
      (HalfWeightCompactCoordinateGreen.rpowScale p)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    exact
      (HalfWeightCompactCoordinateGreen.rpowScale_contDiffAt_of_im_pos p hw).contDiffWithinAt
  refine hBase.congr ?_
  intro w hw
  simp [upperLift, Function.comp_def,
    HalfWeightCompactCoordinateGreen.rpowScale,
    UpperHalfPlane.ofComplex_apply_of_im_pos hw]

/-- Exact real directional derivative of a complexified height power. -/
theorem d1_complexHeightRpow (p : ℝ) (z : ℍ) (ξ : ℂ) :
    d1 (fun w : ℍ => ((w.im ^ p : ℝ) : ℂ)) z ξ =
      (((p * z.im ^ (p - 1)) * ξ.im : ℝ) : ℂ) := by
  have hLocal :
      upperLift (fun w : ℍ => ((w.im ^ p : ℝ) : ℂ)) =ᶠ[nhds (z : ℂ)]
        HalfWeightCompactCoordinateGreen.rpowScale p := by
    filter_upwards [
      UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds z.im_pos] with w hw
    simp [upperLift, Function.comp_def,
      HalfWeightCompactCoordinateGreen.rpowScale,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw]
  unfold d1
  rw [hLocal.fderiv_eq]
  exact HalfWeightCompactCoordinateGreen.fderiv_rpowScale_apply_of_im_pos
    p z.im_pos

@[simp]
theorem dx_complexHeightRpow (p : ℝ) (z : ℍ) :
    dx (fun w : ℍ => ((w.im ^ p : ℝ) : ℂ)) z = 0 := by
  simpa [dx] using d1_complexHeightRpow p z (1 : ℂ)

@[simp]
theorem dy_complexHeightRpow (p : ℝ) (z : ℍ) :
    dy (fun w : ℍ => ((w.im ^ p : ℝ) : ℂ)) z =
      ((p * z.im ^ (p - 1) : ℝ) : ℂ) := by
  simpa [dy] using d1_complexHeightRpow p z Complex.I

/-- The oriented flux one-form `X dy - Y dx`, evaluated on a real tangent
direction represented by a complex number. -/
def fluxOneFormValue
    (X Y : ℍ → ℂ) (z : ℍ) (ξ : ℂ) : ℂ :=
  X z * (ξ.im : ℂ) - Y z * (ξ.re : ℂ)

/-- The upper-half-plane coordinate expression of a `Gamma(2)` action. -/
noncomputable def gammaTwoActionCoordinate (γ : GammaTwo) : ℍ → ℂ :=
  fun z => (((((γ : GammaTwo) : SL(2, ℤ)) • z) : ℍ) : ℂ)

/-- Pullback invariance of the flux one-form.  This is the exact law which
makes oppositely oriented paired-side curve integrals cancel. -/
def IsGammaTwoInvariantFlux (X Y : ℍ → ℂ) : Prop :=
  ∀ (γ : GammaTwo) (z : ℍ) (ξ : ℂ),
    fluxOneFormValue X Y
        (((γ : GammaTwo) : SL(2, ℤ)) • z)
        (d1 (gammaTwoActionCoordinate γ) z ξ) =
      fluxOneFormValue X Y z ξ

/-- Smooth quotient-compact flux data with the precise side-pairing law. -/
def IsSmoothQuotientCompactFlux (X Y : ℍ → ℂ) : Prop :=
  RealSmooth X ∧ RealSmooth Y ∧
    HasQuotientCompactSupport X ∧ HasQuotientCompactSupport Y ∧
      IsGammaTwoInvariantFlux X Y

/-- Exact pointwise disappearance of a flux beyond one literal three-cusp
stage in the selected closed carrier. -/
def HasZeroThreeCuspTail (X Y : ℍ → ℂ) : Prop :=
  ∃ Y₀ : ℝ, 1 < Y₀ ∧
    ∀ z ∈ gammaTwoClosedTileCarrier \
        gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0

/-- The geometric properness statement turning quotient compactness into
compactness of *all* representatives in the selected closed carrier. -/
def GammaTwoClosedCarrierCompactPreimage : Prop :=
  ∀ K : Set GammaTwoQuotient, IsCompact K →
    IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K)

/-- The closed-carrier compact-preimage proposition has an unconditional
inhabitant, supplied by arithmetic height reduction on compact lifts. -/
theorem gammaTwoClosedCarrierCompactPreimage :
    GammaTwoClosedCarrierCompactPreimage :=
  gammaTwoClosedCarrier_inter_preimage_isCompact

/-- Quotient-compact support converted into uniform cusp-tail tightness for
all representatives in the closed carrier. -/
def GammaTwoQuotientCompactFluxTailTightness : Prop :=
  ∀ (X Y : ℍ → ℂ),
    IsSmoothQuotientCompactFlux X Y → HasZeroThreeCuspTail X Y

/-- Closed-carrier compact-preimage properness is sufficient for the exact
literal `F_Y` tail statement.  This reduction uses the already-proved theorem
that every compact subset of the closed carrier lies in one three-cusp
truncation; no boundary or Stokes assertion is used. -/
theorem gammaTwoQuotientCompactFluxTailTightness_of_closedCarrierCompactPreimage
    (hProper : GammaTwoClosedCarrierCompactPreimage) :
    GammaTwoQuotientCompactFluxTailTightness := by
  intro X Y hXY
  rcases hXY with ⟨_hXs, _hYs, hXc, hYc, _hInv⟩
  let K : Set GammaTwoQuotient := quotientTSupport X ∪ quotientTSupport Y
  have hK : IsCompact K := hXc.union hYc
  have hLift : IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) :=
    hProper K hK
  obtain ⟨Y₀, hY₀, hsub⟩ :=
    compact_closedTileCarrier_subset_threeCuspTruncation hLift
      Set.inter_subset_left
  refine ⟨Y₀, hY₀, ?_⟩
  intro z hz
  constructor
  · by_contra hXz
    have hqX : gammaTwoQuotientMk z ∈ quotientTSupport X :=
      subset_closure ⟨z, hXz, rfl⟩
    have hzLift : z ∈
        gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K :=
      ⟨hz.1, Or.inl hqX⟩
    exact hz.2 (hsub hzLift)
  · by_contra hYz
    have hqY : gammaTwoQuotientMk z ∈ quotientTSupport Y :=
      subset_closure ⟨z, hYz, rfl⟩
    have hzLift : z ∈
        gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K :=
      ⟨hz.1, Or.inr hqY⟩
    exact hz.2 (hsub hzLift)

/-- Quotient-compact smooth invariant fluxes vanish outside one literal
three-cusp stage, without any compactness certificate. -/
theorem gammaTwoQuotientCompactFluxTailTightness :
    GammaTwoQuotientCompactFluxTailTightness :=
  gammaTwoQuotientCompactFluxTailTightness_of_closedCarrierCompactPreimage
    gammaTwoClosedCarrierCompactPreimage

/-- The second precise missing implication: polygonal divergence plus
oriented cancellation of every paired side.  The tail hypothesis has already
removed the high horocycles, while `IsGammaTwoInvariantFlux` is exactly the
pullback identity needed on paired sides.

The factor `heightC z ^ 2` converts hyperbolic area `dx dy / y²` back to
Euclidean area, so the integrand is literally `∂x X + ∂y Y`. -/
def GammaTwoPairedPolygonFluxStokes : Prop :=
  ∀ (X Y : ℍ → ℂ),
    IsSmoothQuotientCompactFlux X Y →
    HasZeroThreeCuspTail X Y →
    IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure →
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
      heightC z ^ 2 * (dx X z + dy Y z)
        ∂hyperbolicMeasure) = 0

/-- Combined compact-flux Stokes endpoint.  This is the exact lower-level
statement required before applying the pointwise Green bulk expansion. -/
def GammaTwoCompactFluxStokes : Prop :=
  ∀ (X Y : ℍ → ℂ),
    IsSmoothQuotientCompactFlux X Y →
    IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure →
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
      heightC z ^ 2 * (dx X z + dy Y z)
        ∂hyperbolicMeasure) = 0

/-- The two missing geometric/analytic statements imply the combined Stokes
endpoint without any further certificate. -/
theorem gammaTwoCompactFluxStokes_of_tailTightness_of_pairedPolygon
    (hTail : GammaTwoQuotientCompactFluxTailTightness)
    (hPolygon : GammaTwoPairedPolygonFluxStokes) :
    GammaTwoCompactFluxStokes := by
  intro X Y hXY hInt
  exact hPolygon X Y hXY (hTail X Y hXY) hInt

/-- In purely geometric terms, closed-carrier properness and the oriented
paired-polygon divergence theorem are the two missing inputs for compact-flux
Stokes. -/
theorem gammaTwoCompactFluxStokes_of_closedCarrierCompactPreimage_of_pairedPolygon
    (hProper : GammaTwoClosedCarrierCompactPreimage)
    (hPolygon : GammaTwoPairedPolygonFluxStokes) :
    GammaTwoCompactFluxStokes :=
  gammaTwoCompactFluxStokes_of_tailTightness_of_pairedPolygon
    (gammaTwoQuotientCompactFluxTailTightness_of_closedCarrierCompactPreimage
      hProper)
    hPolygon

/-- Since closed-carrier properness is proved above, oriented paired-polygon
Stokes is the sole remaining input for the compact-flux endpoint. -/
theorem gammaTwoCompactFluxStokes_of_pairedPolygon
    (hPolygon : GammaTwoPairedPolygonFluxStokes) :
    GammaTwoCompactFluxStokes :=
  gammaTwoCompactFluxStokes_of_closedCarrierCompactPreimage_of_pairedPolygon
    gammaTwoClosedCarrierCompactPreimage hPolygon

/-- Planar nullity of a boundary is not a replacement for its oriented
one-dimensional integral: the horizontal line is planar-null while the
constant trace has nonzero integral along a unit segment of that line. -/
theorem planarNullity_does_not_imply_zeroBoundaryIntegral :
    ¬ ((volume : Measure ℂ) {z : ℂ | z.im = 0} = 0 →
      (∫ _x in (0 : ℝ)..1, (1 : ℂ)) = 0) := by
  intro h
  have hzero := h (complex_horizontalLine_null 0)
  rw [intervalIntegral.integral_const] at hzero
  norm_num at hzero

/-- Consequently the already-proved nullity of the full paired-side boundary
cannot by itself discharge `GammaTwoCompactFluxStokes`. -/
theorem pairedSideBoundary_null_available :
    hyperbolicMeasure gammaTwoPairedSideBoundary = 0 :=
  gammaTwoPairedSideBoundary_null

/-- Likewise, the complete three-cusp corner separation is valid geometric
input, but does not manufacture the absent oriented curve integrals. -/
theorem threeCusp_boundary_geometry_available (Y : ℝ) :
    hyperbolicMeasure (frontier (gammaTwoThreeCuspTruncation Y)) = 0 ∧
      Disjoint (gammaTwoThreeCuspPairedSideAwayFromCorners Y)
        (gammaTwoThreeCuspHorocycleAwayFromCorners Y) :=
  ⟨gammaTwoThreeCuspTruncation_frontier_null Y,
    gammaTwoThreeCuspBoundaryPieces_disjoint Y⟩

/-! ##### The invariant one-form on the actual finite edge complex

The abstract pullback law above is now specialized to the edge labels and
parameters of the *measured* six-tile carrier.  This is the exact pointwise
identity needed before differentiating the edge curves and changing the
one-dimensional parameter in a paired boundary integral.  In particular,
it does not infer an integral cancellation merely from planar nullity.
-/

/-- Pullback invariance evaluated on an actual selected-tile edge.  The
geometric pairing theorem rewrites the transformed source point as the
declared point of the paired edge, while the tangent is transported by the
actual Möbius differential. -/
theorem invariantFlux_actualPolygonEdge_pairing
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) (ξ : ℂ) :
    fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e.paired
          (e.pairedParameter t))
        (d1 (gammaTwoActionCoordinate e.pairingElement)
          (gammaTwoActualPolygonEdgeParam e t) ξ) =
      fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e t) ξ := by
  simpa only [gammaTwoActualPolygonEdgePairing_param e t] using
    hInv e.pairingElement (gammaTwoActualPolygonEdgeParam e t) ξ

/-- Every smooth quotient-compact invariant flux therefore satisfies the
same exact identity on each actual edge.  Smoothness and support are retained
in the hypothesis because this is the form consumed by polygonal Stokes. -/
theorem IsSmoothQuotientCompactFlux.actualPolygonEdge_pairing
    {X Y : ℍ → ℂ} (hFlux : IsSmoothQuotientCompactFlux X Y)
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) (ξ : ℂ) :
    fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e.paired
          (e.pairedParameter t))
        (d1 (gammaTwoActionCoordinate e.pairingElement)
          (gammaTwoActualPolygonEdgeParam e t) ξ) =
      fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e t) ξ :=
  invariantFlux_actualPolygonEdge_pairing hFlux.2.2.2.2 e t ξ

end GammaTwoQuotientGreenBoundary

/-! ### 6.6: Definition 1 energy graph and completion

The three Hilbert coordinates below are deliberately quotient/fundamental-
domain realizations.  Using the lifted automorphic function directly in
`L²(ℍ, volume)` would repeat it over every orbit and is generally wrong.
The energy graph is placed in a genuine nested `WithLp 2` product, so its norm
is exactly the sum of the three squared norms in Definition 1.
-/

namespace DefinitionOneSobolev

open Function Set Topology
open scoped ComplexConjugate

universe u v₀ vR vL

/-! #### Petersson pairing on every shifted-weight compact core

The inverse-eta scalarization above is useful at the base weight, but it is not
an isometry for the Hermitian line-bundle metric and it does not provide a
single scalar frame at every shifted weight.  The construction in this section
therefore uses the canonical height-compensated fiber metric directly.  Its
cross-density is invariant under the effective `Gamma(2)` action, descends to
the quotient, has compact support, and defines a positive-definite Hermitian
pairing on each `SmoothCompactWeightCore M`.
-/

namespace WeightCorePetersson

open MeasureTheory
open HalfIntegralMultiplier GammaTwoQuotientGeometry
  SmoothCompactCoreGeometry

variable {k : ℤ} (M : HalfIntegralMultiplier GammaTwo k)

/-- Continuity of the canonical height scale at every integer weight index. -/
theorem continuous_weightFiberScale :
    Continuous (weightFiberScale k) := by
  unfold weightFiberScale
  exact
    (Real.continuous_sqrt.comp UpperHalfPlane.continuous_im).zpow₀ (-k)
      (fun z => Or.inl (ne_of_gt (Real.sqrt_pos.2 z.im_pos)))

/-! ##### The real squared-norm density -/

/-- The canonical real squared fiber norm upstairs. -/
noncomputable def upstairsNormSqDensity
    (u : SmoothCompactWeightCore M) : ℍ → ℝ :=
  (InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq (SmoothCompactWeightCore.toSection u)

/-- The real norm density is invariant under the effective orbit action. -/
theorem upstairsNormSqDensity_effective_invariant
    (u : SmoothCompactWeightCore M)
    (g : GammaTwoEffective) (z : ℍ) :
    upstairsNormSqDensity M u (g • z) =
      upstairsNormSqDensity M u z := by
  rcases effective_exists_gamma g with ⟨γ, hγ⟩
  rw [hγ z]
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq_smul
      (SmoothCompactWeightCore.toSection u) γ z

/-- The real norm density is continuous at every shifted weight. -/
theorem upstairsNormSqDensity_continuous
    (u : SmoothCompactWeightCore M) :
    Continuous (upstairsNormSqDensity M u) := by
  change Continuous (fun z =>
    weightFiberScale k z * ‖(SmoothCompactWeightCore.toSection u) z‖ ^ 2)
  exact (continuous_weightFiberScale (k := k)).mul
    ((SmoothCompactWeightCore.continuous u).norm.pow 2)

/-- Positivity of the real norm density. -/
theorem upstairsNormSqDensity_nonneg
    (u : SmoothCompactWeightCore M) (z : ℍ) :
    0 ≤ upstairsNormSqDensity M u z :=
  (InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq_nonneg
    (SmoothCompactWeightCore.toSection u) z

/-- The real norm density vanishes exactly when the section value vanishes. -/
theorem upstairsNormSqDensity_eq_zero_iff
    (u : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsNormSqDensity M u z = 0 ↔ (SmoothCompactWeightCore.toSection u) z = 0 :=
  (InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq_eq_zero_iff
    (SmoothCompactWeightCore.toSection u) z

/-- Consequently, the real norm density has exactly the section's support. -/
theorem upstairsNormSqDensity_support
    (u : SmoothCompactWeightCore M) :
    Function.support (upstairsNormSqDensity M u) =
      Function.support ((SmoothCompactWeightCore.toSection u) : ℍ → ℂ) := by
  ext z
  change (upstairsNormSqDensity M u z ≠ 0) ↔ (SmoothCompactWeightCore.toSection u) z ≠ 0
  exact not_congr (upstairsNormSqDensity_eq_zero_iff M u z)

@[simp]
theorem upstairsNormSqDensity_zero (z : ℍ) :
    upstairsNormSqDensity M (0 : SmoothCompactWeightCore M) z = 0 := by
  simp [upstairsNormSqDensity,
    InvariantFiberMetric.pointwiseNormSq]

/-- The real squared-norm density on the effective quotient. -/
noncomputable def quotientNormSqDensity
    (u : SmoothCompactWeightCore M) : GammaTwoQuotient → ℝ :=
  descendInvariant (upstairsNormSqDensity M u)
    (upstairsNormSqDensity_effective_invariant M u)

@[simp]
theorem quotientNormSqDensity_mk
    (u : SmoothCompactWeightCore M) (z : ℍ) :
    quotientNormSqDensity M u (gammaTwoQuotientMk z) =
      upstairsNormSqDensity M u z :=
  rfl

/-- Quotient continuity of the real norm density. -/
theorem quotientNormSqDensity_continuous
    (u : SmoothCompactWeightCore M) :
    Continuous (quotientNormSqDensity M u) := by
  unfold quotientNormSqDensity
  exact (upstairsNormSqDensity_continuous M u).quotient_lift _

/-- Exact support descent for the positive real density. -/
theorem quotientNormSqDensity_support
    (u : SmoothCompactWeightCore M) :
    Function.support (quotientNormSqDensity M u) =
      gammaTwoQuotientMk ''
        Function.support ((SmoothCompactWeightCore.toSection u) : ℍ → ℂ) := by
  rw [quotientNormSqDensity, descendInvariant_support,
    upstairsNormSqDensity_support]

/-- Exact topological-support identity for the descended real norm. -/
theorem quotientNormSqDensity_tsupport
    (u : SmoothCompactWeightCore M) :
    tsupport (quotientNormSqDensity M u) =
      quotientTSupport ((SmoothCompactWeightCore.toSection u) : ℍ → ℂ) := by
  rw [tsupport, quotientTSupport, quotientNormSqDensity_support]

/-- The descended real norm has ordinary compact support. -/
theorem quotientNormSqDensity_hasCompactSupport
    (u : SmoothCompactWeightCore M) :
    HasCompactSupport (quotientNormSqDensity M u) := by
  change IsCompact (tsupport (quotientNormSqDensity M u))
  rw [quotientNormSqDensity_tsupport]
  exact (SmoothCompactWeightCore.quotientCompact u)

/-- The quotient real norm density is everywhere nonnegative. -/
theorem quotientNormSqDensity_nonneg
    (u : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    0 ≤ quotientNormSqDensity M u q := by
  induction q using Quotient.inductionOn'
  change 0 ≤ upstairsNormSqDensity M u _
  exact upstairsNormSqDensity_nonneg M u _

@[simp]
theorem quotientNormSqDensity_zero (q : GammaTwoQuotient) :
    quotientNormSqDensity M (0 : SmoothCompactWeightCore M) q = 0 := by
  induction q using Quotient.inductionOn'
  change upstairsNormSqDensity M (0 : SmoothCompactWeightCore M) _ = 0
  exact upstairsNormSqDensity_zero M _

/-- Compact support and local finiteness make the real norm density
integrable. -/
theorem quotientNormSqDensity_integrable
    (u : SmoothCompactWeightCore M)
    (D : GammaTwoFundamentalDomain) :
    Integrable (quotientNormSqDensity M u) D.quotientMeasure := by
  exact (quotientNormSqDensity_continuous M u).integrable_of_hasCompactSupport
    (quotientNormSqDensity_hasCompactSupport M u)

/-- The upstairs Hermitian cross-density on a shifted-weight compact core. -/
noncomputable def upstairsInnerDensity
    (u v : SmoothCompactWeightCore M) : ℍ → ℂ :=
  (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity
    (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v)

/-- The cross-density is additive in its conjugate-linear slot. -/
@[simp]
theorem upstairsInnerDensity_add_left
    (u v w : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsInnerDensity M (u + v) w z =
      upstairsInnerDensity M u w z +
        upstairsInnerDensity M v w z := by
  change
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity
        ((SmoothCompactWeightCore.toSection u) + (SmoothCompactWeightCore.toSection v)) (SmoothCompactWeightCore.toSection w) z = _
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_add_left
      (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) (SmoothCompactWeightCore.toSection w) z

/-- The first slot is conjugate-linear. -/
@[simp]
theorem upstairsInnerDensity_smul_left
    (c : ℂ) (u v : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsInnerDensity M (c • u) v z =
      star c * upstairsInnerDensity M u v z := by
  change
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity
        (c • (SmoothCompactWeightCore.toSection u)) (SmoothCompactWeightCore.toSection v) z = _
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_smul_left
      c (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) z

/-- The cross-density is additive in its linear slot. -/
@[simp]
theorem upstairsInnerDensity_add_right
    (u v w : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsInnerDensity M u (v + w) z =
      upstairsInnerDensity M u v z +
        upstairsInnerDensity M u w z := by
  change
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity
        (SmoothCompactWeightCore.toSection u) ((SmoothCompactWeightCore.toSection v) + (SmoothCompactWeightCore.toSection w)) z = _
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_add_right
      (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) (SmoothCompactWeightCore.toSection w) z

/-- The second slot is complex-linear. -/
@[simp]
theorem upstairsInnerDensity_smul_right
    (c : ℂ) (u v : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsInnerDensity M u (c • v) z =
      c * upstairsInnerDensity M u v z := by
  change
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity
        (SmoothCompactWeightCore.toSection u) (c • (SmoothCompactWeightCore.toSection v)) z = _
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_smul_right
      c (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) z

/-- Pointwise Hermitian symmetry upstairs. -/
theorem upstairsInnerDensity_conj_symm
    (u v : SmoothCompactWeightCore M) (z : ℍ) :
    star (upstairsInnerDensity M v u z) =
      upstairsInnerDensity M u v z := by
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_conj_symm
      (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) z

/-- On the diagonal, the cross-density is the real squared fiber norm. -/
@[simp]
theorem upstairsInnerDensity_self
    (u : SmoothCompactWeightCore M) (z : ℍ) :
    upstairsInnerDensity M u u z =
      ((InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq
        (SmoothCompactWeightCore.toSection u) z : ℂ) := by
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_self
      (SmoothCompactWeightCore.toSection u) z

/-- Effective-orbit invariance follows from the section covariance and the
fiber-metric covariance; no scalar trivialization is chosen. -/
theorem upstairsInnerDensity_effective_invariant
    (u v : SmoothCompactWeightCore M)
    (g : GammaTwoEffective) (z : ℍ) :
    upstairsInnerDensity M u v (g • z) =
      upstairsInnerDensity M u v z := by
  rcases effective_exists_gamma g with ⟨γ, hγ⟩
  rw [hγ z]
  exact
    (InvariantFiberMetric.weightFiberMetric M).pointwiseInnerDensity_smul
      (SmoothCompactWeightCore.toSection u) (SmoothCompactWeightCore.toSection v) γ z

/-- The canonical height-compensated cross-density is continuous upstairs. -/
theorem upstairsInnerDensity_continuous
    (u v : SmoothCompactWeightCore M) :
    Continuous (upstairsInnerDensity M u v) := by
  change Continuous (fun z =>
    (weightFiberScale k z : ℂ) * star ((SmoothCompactWeightCore.toSection u) z) *
      (SmoothCompactWeightCore.toSection v) z)
  have huConj : Continuous (fun z => star ((SmoothCompactWeightCore.toSection u) z)) := by
    simpa only [Complex.star_def] using (SmoothCompactWeightCore.continuous u).star
  exact
    ((Complex.continuous_ofReal.comp
      (continuous_weightFiberScale (k := k))).mul
      huConj).mul (SmoothCompactWeightCore.continuous v)

/-- A cross-density can be nonzero only where its first section is nonzero. -/
theorem upstairsInnerDensity_support_subset_left
    (u v : SmoothCompactWeightCore M) :
    Function.support (upstairsInnerDensity M u v) ⊆
      Function.support ((SmoothCompactWeightCore.toSection u) : ℍ → ℂ) := by
  intro z hz
  simp only [Function.mem_support] at hz ⊢
  intro huz
  apply hz
  simp [upstairsInnerDensity,
    InvariantFiberMetric.pointwiseInnerDensity, huz]

/-- A cross-density can be nonzero only where its second section is nonzero. -/
theorem upstairsInnerDensity_support_subset_right
    (u v : SmoothCompactWeightCore M) :
    Function.support (upstairsInnerDensity M u v) ⊆
      Function.support ((SmoothCompactWeightCore.toSection v) : ℍ → ℂ) := by
  intro z hz
  simp only [Function.mem_support] at hz ⊢
  intro hvz
  apply hz
  simp [upstairsInnerDensity,
    InvariantFiberMetric.pointwiseInnerDensity, hvz]

/-- The invariant cross-density descended to the effective orbit quotient. -/
noncomputable def quotientInnerDensity
    (u v : SmoothCompactWeightCore M) : GammaTwoQuotient → ℂ :=
  descendInvariant (upstairsInnerDensity M u v)
    (upstairsInnerDensity_effective_invariant M u v)

@[simp]
theorem quotientInnerDensity_mk
    (u v : SmoothCompactWeightCore M) (z : ℍ) :
    quotientInnerDensity M u v (gammaTwoQuotientMk z) =
      upstairsInnerDensity M u v z :=
  rfl

/-- Quotient continuity is obtained from the quotient topology itself. -/
theorem quotientInnerDensity_continuous
    (u v : SmoothCompactWeightCore M) :
    Continuous (quotientInnerDensity M u v) := by
  unfold quotientInnerDensity
  exact (upstairsInnerDensity_continuous M u v).quotient_lift _

/-- The quotient support of the cross-density is controlled by its first
section. -/
theorem quotientInnerDensity_tsupport_subset_left
    (u v : SmoothCompactWeightCore M) :
    tsupport (quotientInnerDensity M u v) ⊆
      quotientTSupport ((SmoothCompactWeightCore.toSection u) : ℍ → ℂ) := by
  rw [quotientInnerDensity, descendInvariant_tsupport]
  exact closure_mono
    (Set.image_mono (upstairsInnerDensity_support_subset_left M u v))

/-- The quotient support of the cross-density is also controlled by its second
section. -/
theorem quotientInnerDensity_tsupport_subset_right
    (u v : SmoothCompactWeightCore M) :
    tsupport (quotientInnerDensity M u v) ⊆
      quotientTSupport ((SmoothCompactWeightCore.toSection v) : ℍ → ℂ) := by
  rw [quotientInnerDensity, descendInvariant_tsupport]
  exact closure_mono
    (Set.image_mono (upstairsInnerDensity_support_subset_right M u v))

/-- Compact quotient support of the first section gives ordinary compact
support of the descended cross-density. -/
theorem quotientInnerDensity_hasCompactSupport_left
    (u v : SmoothCompactWeightCore M) :
    HasCompactSupport (quotientInnerDensity M u v) := by
  change IsCompact (tsupport (quotientInnerDensity M u v))
  exact (SmoothCompactWeightCore.quotientCompact u).of_isClosed_subset isClosed_closure
    (quotientInnerDensity_tsupport_subset_left M u v)

/-- Symmetrically, compact quotient support of the second section suffices. -/
theorem quotientInnerDensity_hasCompactSupport_right
    (u v : SmoothCompactWeightCore M) :
    HasCompactSupport (quotientInnerDensity M u v) := by
  change IsCompact (tsupport (quotientInnerDensity M u v))
  exact (SmoothCompactWeightCore.quotientCompact v).of_isClosed_subset isClosed_closure
    (quotientInnerDensity_tsupport_subset_right M u v)

/-- The descended density bundled as a compactly supported continuous map. -/
noncomputable def quotientInnerContinuousMap
    (u v : SmoothCompactWeightCore M) :
    CompactlySupportedContinuousMap GammaTwoQuotient ℂ where
  toFun := quotientInnerDensity M u v
  continuous_toFun := quotientInnerDensity_continuous M u v
  hasCompactSupport' := quotientInnerDensity_hasCompactSupport_left M u v

@[simp]
theorem quotientInnerContinuousMap_mk
    (u v : SmoothCompactWeightCore M) (z : ℍ) :
    quotientInnerContinuousMap M u v (gammaTwoQuotientMk z) =
      upstairsInnerDensity M u v z :=
  rfl

/-- Every shifted-weight compact-core cross-density is integrable for every
certified quotient measure. -/
theorem quotientInnerDensity_integrable
    (u v : SmoothCompactWeightCore M)
    (D : GammaTwoFundamentalDomain) :
    Integrable (quotientInnerDensity M u v) D.quotientMeasure := by
  exact (quotientInnerDensity_continuous M u v).integrable_of_hasCompactSupport
    (quotientInnerDensity_hasCompactSupport_left M u v)

/-- Pulling the descended compact density back along the quotient map gives
an integrable function on the selected fundamental carrier. -/
theorem upstairsInnerDensity_integrableOn
    (u v : SmoothCompactWeightCore M)
    (D : GammaTwoFundamentalDomain) :
    IntegrableOn (upstairsInnerDensity M u v)
      D.carrier hyperbolicMeasure := by
  have hq := quotientInnerDensity_integrable M u v D
  have hq' : Integrable (quotientInnerDensity M u v)
      ((hyperbolicMeasure.restrict D.carrier).map gammaTwoQuotientMk) := by
    simpa [GammaTwoFundamentalDomain.quotientMeasure] using hq
  have hpull := hq'.comp_aemeasurable
    (measurable_quotient_mk''.aemeasurable :
      AEMeasurable gammaTwoQuotientMk
        (hyperbolicMeasure.restrict D.carrier))
  change Integrable (upstairsInnerDensity M u v)
      (hyperbolicMeasure.restrict D.carrier) at hpull
  exact hpull

/-- Additivity in the first quotient slot. -/
@[simp]
theorem quotientInnerDensity_add_left
    (u v w : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    quotientInnerDensity M (u + v) w q =
      quotientInnerDensity M u w q + quotientInnerDensity M v w q := by
  induction q using Quotient.inductionOn'
  change upstairsInnerDensity M (u + v) w _ =
    upstairsInnerDensity M u w _ + upstairsInnerDensity M v w _
  exact upstairsInnerDensity_add_left M u v w _

/-- Conjugate homogeneity in the first quotient slot. -/
@[simp]
theorem quotientInnerDensity_smul_left
    (c : ℂ) (u v : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    quotientInnerDensity M (c • u) v q =
      star c * quotientInnerDensity M u v q := by
  induction q using Quotient.inductionOn'
  change upstairsInnerDensity M (c • u) v _ =
    star c * upstairsInnerDensity M u v _
  exact upstairsInnerDensity_smul_left M c u v _

/-- Additivity in the second quotient slot. -/
@[simp]
theorem quotientInnerDensity_add_right
    (u v w : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    quotientInnerDensity M u (v + w) q =
      quotientInnerDensity M u v q + quotientInnerDensity M u w q := by
  induction q using Quotient.inductionOn'
  change upstairsInnerDensity M u (v + w) _ =
    upstairsInnerDensity M u v _ + upstairsInnerDensity M u w _
  exact upstairsInnerDensity_add_right M u v w _

/-- Homogeneity in the second quotient slot. -/
@[simp]
theorem quotientInnerDensity_smul_right
    (c : ℂ) (u v : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    quotientInnerDensity M u (c • v) q =
      c * quotientInnerDensity M u v q := by
  induction q using Quotient.inductionOn'
  change upstairsInnerDensity M u (c • v) _ =
    c * upstairsInnerDensity M u v _
  exact upstairsInnerDensity_smul_right M c u v _

/-- Hermitian symmetry survives descent. -/
theorem quotientInnerDensity_conj_symm
    (u v : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    star (quotientInnerDensity M v u q) =
      quotientInnerDensity M u v q := by
  induction q using Quotient.inductionOn'
  change star (upstairsInnerDensity M v u _) =
    upstairsInnerDensity M u v _
  exact upstairsInnerDensity_conj_symm M u v _

/-- The diagonal complex density is the complexification of the real norm
density. -/
@[simp]
theorem quotientInnerDensity_self
    (u : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    quotientInnerDensity M u u q =
      (quotientNormSqDensity M u q : ℂ) := by
  induction q using Quotient.inductionOn'
  change upstairsInnerDensity M u u _ =
    (upstairsNormSqDensity M u _ : ℂ)
  exact upstairsInnerDensity_self M u _

/-- The real part of every diagonal quotient density is nonnegative. -/
theorem quotientInnerDensity_self_re_nonneg
    (u : SmoothCompactWeightCore M) (q : GammaTwoQuotient) :
    0 ≤ (quotientInnerDensity M u u q).re := by
  rw [quotientInnerDensity_self, Complex.ofReal_re]
  exact quotientNormSqDensity_nonneg M u q

/-- The Petersson form associated to any certified fundamental-domain quotient
measure.  It is conjugate-linear in the first slot, following Mathlib's inner
product convention. -/
noncomputable def peterssonForm
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) : ℂ :=
  ∫ q, quotientInnerDensity M u v q ∂D.quotientMeasure

/-- The real Petersson squared norm before completion. -/
noncomputable def peterssonNormSq
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) : ℝ :=
  ∫ q, quotientNormSqDensity M u q ∂D.quotientMeasure

/-- The real squared norm is nonnegative. -/
theorem peterssonNormSq_nonneg
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    0 ≤ peterssonNormSq M D u := by
  unfold peterssonNormSq
  exact MeasureTheory.integral_nonneg (quotientNormSqDensity_nonneg M u)

/-- A diagonal complex Petersson value is exactly the complexification of the
real Petersson squared norm. -/
theorem peterssonForm_self_eq_ofReal_peterssonNormSq
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    peterssonForm M D u u = (peterssonNormSq M D u : ℂ) := by
  unfold peterssonForm peterssonNormSq
  calc
    (∫ q, quotientInnerDensity M u u q ∂D.quotientMeasure) =
        ∫ q, (quotientNormSqDensity M u q : ℂ)
          ∂D.quotientMeasure := by
      exact integral_congr_ae (Filter.Eventually.of_forall
        (quotientInnerDensity_self M u))
    _ = ((∫ q, quotientNormSqDensity M u q
          ∂D.quotientMeasure : ℝ) : ℂ) :=
      integral_complex_ofReal

/-- Quotient integration agrees with integration of the invariant density over
the selected measured fundamental domain. -/
theorem peterssonForm_eq_fundamentalDomainIntegral
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    peterssonForm M D u v =
      ∫ z in D.carrier, upstairsInnerDensity M u v z
        ∂hyperbolicMeasure := by
  exact D.integral_quotientMeasure_eq _
    (quotientInnerDensity_integrable M u v D).aestronglyMeasurable

/-- The resulting form is independent of the certified fundamental domain. -/
theorem peterssonForm_domain_independent
    (D₁ D₂ : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    peterssonForm M D₁ u v = peterssonForm M D₂ u v := by
  unfold peterssonForm
  rw [D₁.quotientMeasure_eq D₂]

/-- Additivity in the conjugate-linear slot. -/
theorem peterssonForm_add_left
    (D : GammaTwoFundamentalDomain)
    (u v w : SmoothCompactWeightCore M) :
    peterssonForm M D (u + v) w =
      peterssonForm M D u w + peterssonForm M D v w := by
  unfold peterssonForm
  simpa only [quotientInnerDensity_add_left] using
    (MeasureTheory.integral_add
      (quotientInnerDensity_integrable M u w D)
      (quotientInnerDensity_integrable M v w D))

/-- Conjugate homogeneity in the first slot. -/
theorem peterssonForm_smul_left
    (D : GammaTwoFundamentalDomain) (c : ℂ)
    (u v : SmoothCompactWeightCore M) :
    peterssonForm M D (c • u) v =
      star c * peterssonForm M D u v := by
  unfold peterssonForm
  simpa only [quotientInnerDensity_smul_left] using
    (MeasureTheory.integral_const_mul
      (μ := D.quotientMeasure) (star c)
      (quotientInnerDensity M u v))

/-- Additivity in the linear slot. -/
theorem peterssonForm_add_right
    (D : GammaTwoFundamentalDomain)
    (u v w : SmoothCompactWeightCore M) :
    peterssonForm M D u (v + w) =
      peterssonForm M D u v + peterssonForm M D u w := by
  unfold peterssonForm
  simpa only [quotientInnerDensity_add_right] using
    (MeasureTheory.integral_add
      (quotientInnerDensity_integrable M u v D)
      (quotientInnerDensity_integrable M u w D))

/-- Homogeneity in the second slot. -/
theorem peterssonForm_smul_right
    (D : GammaTwoFundamentalDomain) (c : ℂ)
    (u v : SmoothCompactWeightCore M) :
    peterssonForm M D u (c • v) =
      c * peterssonForm M D u v := by
  unfold peterssonForm
  simpa only [quotientInnerDensity_smul_right] using
    (MeasureTheory.integral_const_mul
      (μ := D.quotientMeasure) c (quotientInnerDensity M u v))

/-- Hermitian symmetry of the Petersson form. -/
theorem peterssonForm_conj_symm
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    star (peterssonForm M D v u) =
      peterssonForm M D u v := by
  unfold peterssonForm
  calc
    star
          (∫ q, quotientInnerDensity M v u q ∂D.quotientMeasure) =
        ∫ q, star (quotientInnerDensity M v u q)
          ∂D.quotientMeasure := by
            symm
            exact integral_conj
    _ = ∫ q, quotientInnerDensity M u v q ∂D.quotientMeasure := by
      exact integral_congr_ae (Filter.Eventually.of_forall
        (quotientInnerDensity_conj_symm M u v))

/-- The form vanishes when its first entry is zero. -/
@[simp]
theorem peterssonForm_zero_left
    (D : GammaTwoFundamentalDomain) (v : SmoothCompactWeightCore M) :
    peterssonForm M D 0 v = 0 := by
  have h := peterssonForm_smul_left M D 0 (0 : SmoothCompactWeightCore M) v
  simpa using h

/-- The form vanishes when its second entry is zero. -/
@[simp]
theorem peterssonForm_zero_right
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    peterssonForm M D u 0 = 0 := by
  have h := peterssonForm_smul_right M D 0 u (0 : SmoothCompactWeightCore M)
  simpa using h

/-- Diagonal values are real. -/
theorem peterssonForm_self_im_eq_zero
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    (peterssonForm M D u u).im = 0 :=
  Complex.conj_eq_iff_im.mp (peterssonForm_conj_symm M D u u)

/-- The real part of a diagonal Petersson value is nonnegative. -/
theorem peterssonForm_self_re_nonneg
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    0 ≤ (peterssonForm M D u u).re := by
  have hInt := quotientInnerDensity_integrable M u u D
  rw [peterssonForm]
  calc
    0 ≤ ∫ q, (quotientInnerDensity M u u q).re ∂D.quotientMeasure :=
      MeasureTheory.integral_nonneg
        (quotientInnerDensity_self_re_nonneg M u)
    _ = (∫ q, quotientInnerDensity M u u q ∂D.quotientMeasure).re := by
      simpa using integral_re hInt

/-- Strict positivity on the compact core: a zero diagonal integral forces the
smooth section to vanish pointwise.  The key analytic input is the already-proved
positivity of `D.quotientMeasure` on every nonempty open set. -/
theorem peterssonForm_self_eq_zero_iff
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    peterssonForm M D u u = 0 ↔ u = 0 := by
  constructor
  · intro hIntegral
    have hInt := quotientInnerDensity_integrable M u u D
    have hRealIntegral :
        ∫ q, (quotientInnerDensity M u u q).re ∂D.quotientMeasure = 0 := by
      calc
        ∫ q, (quotientInnerDensity M u u q).re ∂D.quotientMeasure =
            (∫ q, quotientInnerDensity M u u q ∂D.quotientMeasure).re := by
          simpa using integral_re hInt
        _ = 0 := by
          simpa only [peterssonForm, Complex.zero_re] using
            congrArg Complex.re hIntegral
    have hAeZero :
        (fun q => (quotientInnerDensity M u u q).re) =ᵐ[D.quotientMeasure]
          (0 : GammaTwoQuotient → ℝ) :=
      (MeasureTheory.integral_eq_zero_iff_of_nonneg
        (quotientInnerDensity_self_re_nonneg M u) hInt.re).mp hRealIntegral
    have hContinuous :
        Continuous (fun q => (quotientInnerDensity M u u q).re) :=
      Complex.continuous_re.comp (quotientInnerDensity_continuous M u u)
    have hEverywhereZero :
        (fun q => (quotientInnerDensity M u u q).re) =
          (0 : GammaTwoQuotient → ℝ) :=
      MeasureTheory.Measure.eq_of_ae_eq hAeZero hContinuous continuous_zero
    apply SmoothCompactWeightCore.ext
    intro z
    have hz := congrFun hEverywhereZero (gammaTwoQuotientMk z)
    have hNormSq :
        (InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq
          (SmoothCompactWeightCore.toSection u) z = 0 := by
      simpa only [quotientInnerDensity_mk, upstairsInnerDensity_self,
        Complex.ofReal_re, Pi.zero_apply] using hz
    exact
      ((InvariantFiberMetric.weightFiberMetric M).pointwiseNormSq_eq_zero_iff
        (SmoothCompactWeightCore.toSection u) z).mp hNormSq
  · rintro rfl
    exact peterssonForm_zero_left M D 0

/-- The real norm integral is strictly definite on the compact core. -/
theorem peterssonNormSq_eq_zero_iff
    (D : GammaTwoFundamentalDomain) (u : SmoothCompactWeightCore M) :
    peterssonNormSq M D u = 0 ↔ u = 0 := by
  constructor
  · intro hNorm
    apply (peterssonForm_self_eq_zero_iff M D u).mp
    rw [peterssonForm_self_eq_ofReal_peterssonNormSq, hNorm]
    rfl
  · rintro rfl
    unfold peterssonNormSq
    simp only [quotientNormSqDensity_zero, integral_zero]

/-- Strict positivity of the real norm integral for every nonzero section. -/
theorem peterssonNormSq_pos
    (D : GammaTwoFundamentalDomain) {u : SmoothCompactWeightCore M}
    (hu : u ≠ 0) :
    0 < peterssonNormSq M D u := by
  exact lt_of_le_of_ne (peterssonNormSq_nonneg M D u)
    (fun hZero => hu ((peterssonNormSq_eq_zero_iff M D u).mp hZero.symm))

/-- Equivalent strict-positivity formulation for a nonzero section. -/
theorem peterssonForm_self_re_pos
    (D : GammaTwoFundamentalDomain) {u : SmoothCompactWeightCore M}
    (hu : u ≠ 0) :
    0 < (peterssonForm M D u u).re := by
  exact lt_of_le_of_ne (peterssonForm_self_re_nonneg M D u)
    (fun hZero => hu ((peterssonForm_self_eq_zero_iff M D u).mp
      (Complex.ext hZero.symm (peterssonForm_self_im_eq_zero M D u))))

/-- The Petersson pairing packaged as Mathlib's algebraic inner-product core.

This deliberately supplies only the norm-free `InnerProductSpace.Core` data.
Installing its induced norm is a separate type-design decision because this
core is also used by later model embeddings, and Mathlib warns against silently
installing two non-definitionally-equal norms on one type.
-/
noncomputable def peterssonInnerProductCore
    (D : GammaTwoFundamentalDomain) :
    InnerProductSpace.Core ℂ (SmoothCompactWeightCore M) where
  inner := peterssonForm M D
  conj_inner_symm := peterssonForm_conj_symm M D
  re_inner_nonneg := peterssonForm_self_re_nonneg M D
  add_left := peterssonForm_add_left M D
  smul_left := fun u v c => peterssonForm_smul_left M D c u v
  definite := fun u hu =>
    (peterssonForm_self_eq_zero_iff M D u).mp hu

/-- Canonical algebraic inner-product core obtained from the explicitly chosen
measured `Gamma(2)` fundamental domain. -/
noncomputable def chosenPeterssonInnerProductCore :
    InnerProductSpace.Core ℂ (SmoothCompactWeightCore M) :=
  peterssonInnerProductCore M chosenGammaTwoFundamentalDomain

@[simp]
theorem peterssonInnerProductCore_inner
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    (peterssonInnerProductCore M D).inner u v =
      peterssonForm M D u v :=
  rfl

@[simp]
theorem chosenPeterssonInnerProductCore_inner
    (u v : SmoothCompactWeightCore M) :
    (chosenPeterssonInnerProductCore M).inner u v =
      peterssonForm M chosenGammaTwoFundamentalDomain u v :=
  rfl

/-! ##### A separate norm-carrying wrapper and its Hilbert completion

`SmoothCompactWeightCore M` remains a purely algebraic/smooth subtype.  The
following one-field structure is intentionally opaque rather than a reducible
type synonym.  Consequently the Petersson norm and inner-product instances
installed below cannot leak back to the original subtype through definitional
equality.
-/

/-- An opaque copy of the shifted-weight compact core reserved for the
Petersson norm. -/
structure PeterssonCoreSpace where
  toSmoothCore : SmoothCompactWeightCore M

namespace PeterssonCoreSpace

variable {k : ℤ} {M : HalfIntegralMultiplier GammaTwo k}

/-- The underlying set-level equivalence with the smooth compact core. -/
def coreEquiv (M : HalfIntegralMultiplier GammaTwo k) :
    PeterssonCoreSpace M ≃ SmoothCompactWeightCore M where
  toFun := toSmoothCore
  invFun := fun u => ⟨u⟩
  left_inv := by
    rintro ⟨u⟩
    rfl
  right_inv := fun _ => rfl

/-- Transport the additive group structure to the opaque copy. -/
instance instAddCommGroup : AddCommGroup (PeterssonCoreSpace M) :=
  (coreEquiv M).addCommGroup

/-- Transport the complex module structure to the opaque copy. -/
instance instModule : Module ℂ (PeterssonCoreSpace M) :=
  (coreEquiv M).module ℂ

/-- The transported set equivalence is complex-linear. -/
def coreLinearEquiv (M : HalfIntegralMultiplier GammaTwo k) :
    PeterssonCoreSpace M ≃ₗ[ℂ] SmoothCompactWeightCore M :=
  (coreEquiv M).linearEquiv ℂ

/-- Canonical inclusion of a smooth compact section into the opaque copy. -/
def ofSmoothCore (u : SmoothCompactWeightCore M) : PeterssonCoreSpace M :=
  ⟨u⟩

instance : Coe (PeterssonCoreSpace M) (SmoothCompactWeightCore M) :=
  ⟨toSmoothCore⟩

@[simp]
theorem toSmoothCore_ofSmoothCore (u : SmoothCompactWeightCore M) :
    (ofSmoothCore u).toSmoothCore = u :=
  rfl

@[simp]
theorem ofSmoothCore_toSmoothCore (u : PeterssonCoreSpace M) :
    ofSmoothCore u.toSmoothCore = u := by
  cases u
  rfl

@[simp]
theorem toSmoothCore_zero :
    (0 : PeterssonCoreSpace M).toSmoothCore = 0 :=
  rfl

@[simp]
theorem toSmoothCore_add (u v : PeterssonCoreSpace M) :
    (u + v).toSmoothCore = u.toSmoothCore + v.toSmoothCore :=
  rfl

@[simp]
theorem toSmoothCore_neg (u : PeterssonCoreSpace M) :
    (-u).toSmoothCore = -u.toSmoothCore :=
  rfl

@[simp]
theorem toSmoothCore_smul (c : ℂ) (u : PeterssonCoreSpace M) :
    (c • u).toSmoothCore = c • u.toSmoothCore :=
  rfl

/-- The chosen Petersson pairing as an algebraic inner-product core on the
norm-carrying wrapper. -/
noncomputable def wrappedInnerProductCore :
    InnerProductSpace.Core ℂ (PeterssonCoreSpace M) where
  inner := fun u v => peterssonForm M chosenGammaTwoFundamentalDomain
    u.toSmoothCore v.toSmoothCore
  conj_inner_symm := fun u v =>
    peterssonForm_conj_symm M chosenGammaTwoFundamentalDomain
      u.toSmoothCore v.toSmoothCore
  re_inner_nonneg := fun u =>
    peterssonForm_self_re_nonneg M chosenGammaTwoFundamentalDomain
      u.toSmoothCore
  add_left := fun u v w => by
    simpa only [toSmoothCore_add] using
      peterssonForm_add_left M chosenGammaTwoFundamentalDomain
        u.toSmoothCore v.toSmoothCore w.toSmoothCore
  smul_left := fun u v c => by
    change peterssonForm M chosenGammaTwoFundamentalDomain
        (c • u.toSmoothCore) v.toSmoothCore =
      star c * peterssonForm M chosenGammaTwoFundamentalDomain
        u.toSmoothCore v.toSmoothCore
    exact peterssonForm_smul_left M chosenGammaTwoFundamentalDomain c
      u.toSmoothCore v.toSmoothCore
  definite := fun u hu => by
    apply (coreEquiv M).injective
    change u.toSmoothCore = 0
    exact (peterssonForm_self_eq_zero_iff M
      chosenGammaTwoFundamentalDomain u.toSmoothCore).mp hu

/-- The wrapper-specific core instance; its opaque carrier prevents norm
instance overlap with `SmoothCompactWeightCore M`. -/
noncomputable instance instInnerProductCore :
    InnerProductSpace.Core ℂ (PeterssonCoreSpace M) :=
  wrappedInnerProductCore

/-- The norm induced from the positive-definite Petersson core. -/
noncomputable instance instNormedAddCommGroup :
    NormedAddCommGroup (PeterssonCoreSpace M) :=
  @InnerProductSpace.Core.toNormedAddCommGroup ℂ
    (PeterssonCoreSpace M) _ _ _ (wrappedInnerProductCore (M := M))

/-- The corresponding complex inner-product-space structure. -/
noncomputable instance instInnerProductSpace :
    InnerProductSpace ℂ (PeterssonCoreSpace M) :=
  InnerProductSpace.ofCore
    (inferInstance : PreInnerProductSpace.Core ℂ (PeterssonCoreSpace M))

/-- The installed inner product is exactly the chosen Petersson form. -/
@[simp]
theorem inner_eq_peterssonForm (u v : PeterssonCoreSpace M) :
    inner ℂ u v =
      peterssonForm M chosenGammaTwoFundamentalDomain
        u.toSmoothCore v.toSmoothCore :=
  rfl

/-- The squared induced norm is the real Petersson norm integral. -/
theorem norm_sq_eq_peterssonNormSq (u : PeterssonCoreSpace M) :
    ‖u‖ ^ 2 =
      peterssonNormSq M chosenGammaTwoFundamentalDomain u.toSmoothCore := by
  calc
    ‖u‖ ^ 2 = (inner ℂ u u).re := norm_sq_eq_re_inner (𝕜 := ℂ) u
    _ = (peterssonForm M chosenGammaTwoFundamentalDomain
          u.toSmoothCore u.toSmoothCore).re := by
      rw [inner_eq_peterssonForm]
    _ = peterssonNormSq M chosenGammaTwoFundamentalDomain
          u.toSmoothCore := by
      rw [peterssonForm_self_eq_ofReal_peterssonNormSq,
        Complex.ofReal_re]

/-- The Hilbert completion of the Petersson-normed compact core. -/
abbrev PeterssonHilbertCompletion
    (M : HalfIntegralMultiplier GammaTwo k) :=
  UniformSpace.Completion (PeterssonCoreSpace M)

/-- Canonical isometric embedding into the Petersson Hilbert completion. -/
noncomputable def toCompletion :
    PeterssonCoreSpace M →ₗᵢ[ℂ] PeterssonHilbertCompletion M :=
  UniformSpace.Completion.toComplₗᵢ

@[simp]
theorem toCompletion_apply (u : PeterssonCoreSpace M) :
    toCompletion u =
      (u : UniformSpace.Completion (PeterssonCoreSpace M)) :=
  rfl

/-- The canonical completion embedding is injective. -/
theorem toCompletion_injective : Function.Injective (toCompletion (M := M)) :=
  (toCompletion (M := M)).injective

/-- The canonical completion embedding has dense range. -/
theorem denseRange_toCompletion :
    DenseRange (toCompletion (M := M)) := by
  change DenseRange ((↑) : PeterssonCoreSpace M →
    UniformSpace.Completion (PeterssonCoreSpace M))
  exact UniformSpace.Completion.denseRange_coe

/-- The canonical completion embedding is a dense inducing map. -/
theorem isDenseInducing_toCompletion :
    IsDenseInducing (toCompletion (M := M)) := by
  change IsDenseInducing ((↑) : PeterssonCoreSpace M →
    UniformSpace.Completion (PeterssonCoreSpace M))
  exact UniformSpace.Completion.isDenseInducing_coe

/-- Equivalently, the closure of the embedded compact core is the whole
completion. -/
theorem closure_range_toCompletion :
    closure (Set.range (toCompletion (M := M))) = Set.univ :=
  (denseRange_toCompletion (M := M)).closure_range

/-- The completion embedding preserves the chosen Petersson inner product. -/
@[simp]
theorem inner_toCompletion (u v : PeterssonCoreSpace M) :
    inner ℂ (toCompletion u) (toCompletion v) =
      peterssonForm M chosenGammaTwoFundamentalDomain
        u.toSmoothCore v.toSmoothCore := by
  calc
    inner ℂ (toCompletion u) (toCompletion v) = inner ℂ u v := by
      change inner ℂ
        (u : UniformSpace.Completion (PeterssonCoreSpace M))
        (v : UniformSpace.Completion (PeterssonCoreSpace M)) = inner ℂ u v
      exact UniformSpace.Completion.inner_coe u v
    _ = _ := inner_eq_peterssonForm u v

/-- The completion embedding also preserves the induced norm. -/
@[simp]
theorem norm_toCompletion (u : PeterssonCoreSpace M) :
    ‖toCompletion u‖ = ‖u‖ :=
  (toCompletion (M := M)).norm_map u

/-- Explicit witness that the completed space is Hilbert. -/
noncomputable def hilbertSpaceWitness :
    HilbertSpace ℂ (PeterssonHilbertCompletion M) :=
  ⟨⟩

end PeterssonCoreSpace

end WeightCorePetersson

/-! #### Fixed-phase differential coordinates in the Petersson completions

The canonical stable core from 6.5 now has a faithful coordinate in every
shifted Petersson Hilbert completion.  Composing those coordinates with the
actual typed `R` and `L` maps gives the three algebraic graph coordinates
needed later.  Continuity/closability is deliberately not inferred from this
algebraic construction: that is exactly what the global Green identity must
establish.
-/

namespace FixedPhasePeterssonCoordinates

open MeasureTheory
open HalfIntegralMultiplier HalfWeightDifferentialOperators
  GammaTwoQuotientGeometry
open GammaTwoQuotientGreenBoundary
open SmoothCompactCoreGeometry
open WeightCorePetersson WeightCorePetersson.PeterssonCoreSpace

noncomputable abbrev OrbitMultiplier (n : ℤ) :=
  inverseEtaPaperOrbitMultiplier GammaTwo n

abbrev OrbitPeterssonCore (n : ℤ) :=
  PeterssonCoreSpace (OrbitMultiplier n)

abbrev OrbitPeterssonHilbert (n : ℤ) :=
  PeterssonHilbertCompletion (OrbitMultiplier n)

/-- Faithful algebraic embedding of the fixed-phase differential core into
the norm-carrying Petersson core at the same shifted weight. -/
noncomputable def coreEmbedding (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] OrbitPeterssonCore n :=
  ((PeterssonCoreSpace.coreLinearEquiv (OrbitMultiplier n)).symm.toLinearMap).comp
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n)

@[simp]
theorem coreEmbedding_toSmoothCore (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    (coreEmbedding n u).toSmoothCore =
      InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u :=
  rfl

theorem coreEmbedding_injective (n : ℤ) :
    Function.Injective (coreEmbedding n) := by
  intro u v huv
  apply InverseEtaFixedPhaseCore.toSmoothCompactWeightCore_injective n
  have h := congrArg
    (fun w : OrbitPeterssonCore n => w.toSmoothCore) huv
  simpa using h

/-- Canonical base `L²` coordinate in the shifted Petersson completion. -/
noncomputable def l2Coordinate (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] OrbitPeterssonHilbert n :=
  (PeterssonCoreSpace.toCompletion (M := OrbitMultiplier n)).toLinearMap.comp
    (coreEmbedding n)

@[simp]
theorem l2Coordinate_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    l2Coordinate n u =
      PeterssonCoreSpace.toCompletion (coreEmbedding n u) :=
  rfl

theorem l2Coordinate_injective (n : ℤ) :
    Function.Injective (l2Coordinate n) := by
  intro u v huv
  apply coreEmbedding_injective n
  exact PeterssonCoreSpace.toCompletion_injective huv

/-- The raised graph coordinate, landing in the Petersson completion at the
next member of the fixed-phase orbit. -/
noncomputable def raisedCoordinate (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      OrbitPeterssonHilbert (n + 1) :=
  (l2Coordinate (n + 1)).comp (InverseEtaFixedPhaseCore.raise n)

/-- The lowered graph coordinate at the preceding shifted weight. -/
noncomputable def loweredCoordinate (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      OrbitPeterssonHilbert (n - 1) :=
  (l2Coordinate (n - 1)).comp (InverseEtaFixedPhaseCore.lower n)

@[simp]
theorem raisedCoordinate_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    raisedCoordinate n u =
      l2Coordinate (n + 1) (InverseEtaFixedPhaseCore.raise n u) :=
  rfl

@[simp]
theorem loweredCoordinate_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    loweredCoordinate n u =
      l2Coordinate (n - 1) (InverseEtaFixedPhaseCore.lower n u) :=
  rfl

/-! The exact remaining Green/Stokes boundary

`normalizedGreenBulk_expansion` proves the complete pointwise bulk formula.
The quantity below is the global Petersson defect for a compact-core pair.
Proving that it vanishes is *not* an algebraic multiplier question: it requires
a Stokes/divergence theorem on the chosen `Gamma(2)` fundamental region,
cancellation of paired sides, and control of the horocycle/corner boundary.
No field or certificate below assumes that theorem.
-/

/-- Exact global defect in the desired identity
`<R_n u,v> = -<u,L_{n+1}v>`. -/
noncomputable def greenBoundaryDefect (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) : ℂ :=
  peterssonForm (OrbitMultiplier (n + 1))
      chosenGammaTwoFundamentalDomain
      (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
        (InverseEtaFixedPhaseCore.raise n u))
      (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v) +
    peterssonForm (OrbitMultiplier n)
      chosenGammaTwoFundamentalDomain
      (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
      (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
        (InverseEtaFixedPhaseCore.lowerFromSucc n v))

/-! The actual fixed-phase flux behind the defect

For source doubled exponent `a`, put
`rho = y^(a/2) * conj(u) * v`.  The Green bulk formula is
`-i ∂x rho + ∂y rho`, hence the oriented one-form is
`(-i rho) dy - rho dx`.  The following functions record this concrete flux;
they are not existential boundary certificates. -/

/-- The explicit scalar coefficient `rho` of the fixed-phase Green flux. -/
noncomputable def fixedPhaseGreenScalarDensity (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) : ℍ → ℂ :=
  fun z =>
    ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) *
      star
        ((u : SmoothQuotientCompactFunction) z) *
      ((v : SmoothQuotientCompactFunction) z)

/-- Public form of the exact cancellation between the source Hermitian fiber
metric and the conjugate/source multiplier pair.  This isolates the
conjugation slot: the source factor occurs as `conj F * F`, not as `F * F` or
as two target factors. -/
theorem fixedPhaseGreen_sourceFiberFactor_cancellation (n : ℤ)
    (γ : GammaTwo) (z : ℍ) :
    ((weightFiberScale (-paperOrbitExponent n)
        (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
        (star ((OrbitMultiplier n).factor γ z) *
          (OrbitMultiplier n).factor γ z) =
      ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) := by
  let M := OrbitMultiplier n
  let F : ℂ := M.factor γ z
  have hScaleR := weightFiberScale_covariance M γ z
  have hScaleNormSq :
      weightFiberScale (-paperOrbitExponent n)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) *
          Complex.normSq F =
        weightFiberScale (-paperOrbitExponent n) z := by
    simpa [M, F, OrbitMultiplier, Complex.normSq_eq_norm_sq] using hScaleR
  have hScaleC := congrArg (fun r : ℝ => (r : ℂ)) hScaleNormSq
  change
    ((weightFiberScale (-paperOrbitExponent n)
        (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
        (star F * F) =
      ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ)
  rw [Complex.ofReal_mul, Complex.normSq_eq_conj_mul_self] at hScaleC
  simpa only [starRingEnd_apply] using hScaleC

/-- Successive fixed-phase indices have the same unitary phase; the target
factor differs from the source factor only by the square of the Möbius
denominator. -/
theorem fixedPhaseGreen_targetFactor_reindex (n : ℤ)
    (γ : GammaTwo) (z : ℍ) :
    (OrbitMultiplier (n + 1)).factor γ z =
      (OrbitMultiplier n).factor γ z *
        inverseEtaPaperOrbitDenom γ z ^ 2 := by
  simpa [OrbitMultiplier, inverseEtaPaperOrbitDenom] using
    (inverseEtaPaperOrbitMultiplier_factor_add_one GammaTwo n γ z)

/-- Exact weight-two covariance of the scalar Green coefficient.  The
source fiber scale cancels the norm square of the source automorphy factor,
while the target factor contributes precisely the remaining `j²`. -/
theorem fixedPhaseGreenScalarDensity_covariance (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (γ : GammaTwo) (z : ℍ) :
    fixedPhaseGreenScalarDensity n u v
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperOrbitDenom γ z ^ 2 *
        fixedPhaseGreenScalarDensity n u v z := by
  let M := OrbitMultiplier n
  let F : ℂ := M.factor γ z
  let j : ℂ := inverseEtaPaperOrbitDenom γ z
  have hScaleR := weightFiberScale_covariance M γ z
  have hScaleNormSq :
      weightFiberScale (-paperOrbitExponent n)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) *
          Complex.normSq F =
        weightFiberScale (-paperOrbitExponent n) z := by
    simpa [M, F, OrbitMultiplier, Complex.normSq_eq_norm_sq] using hScaleR
  have hScaleC := congrArg (fun r : ℝ => (r : ℂ)) hScaleNormSq
  have hScaleConj :
      ((weightFiberScale (-paperOrbitExponent n)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
          (star F * F) =
        ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) := by
    simpa only [Complex.ofReal_mul, starRingEnd_apply,
      Complex.normSq_eq_conj_mul_self] using hScaleC
  have hu := u.2 FixedPhaseDifferentialWord.nil γ z
  have hv := v.2 FixedPhaseDifferentialWord.nil γ z
  have hu0 :
      ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        (OrbitMultiplier n).factor γ z *
          (u : SmoothQuotientCompactFunction) z := by
    simpa [OrbitMultiplier,
      FixedPhaseDifferentialWord.targetIndex_nil,
      FixedPhaseDifferentialWord.eval_nil_apply,
      InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction] using hu
  have hv0 :
      ((v : SmoothQuotientCompactFunction) : ℍ → ℂ)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        (OrbitMultiplier (n + 1)).factor γ z *
          (v : SmoothQuotientCompactFunction) z := by
    simpa [OrbitMultiplier,
      FixedPhaseDifferentialWord.targetIndex_nil,
      FixedPhaseDifferentialWord.eval_nil_apply,
      InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction] using hv
  have hu' :
      ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        F * (u : SmoothQuotientCompactFunction) z := by
    simpa [F, M] using hu0
  have hv' :
      ((v : SmoothQuotientCompactFunction) : ℍ → ℂ)
          (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        (F * j ^ 2) * (v : SmoothQuotientCompactFunction) z := by
    rw [fixedPhaseGreen_targetFactor_reindex n γ z] at hv0
    simpa [F, M, j, mul_assoc] using hv0
  rw [fixedPhaseGreenScalarDensity, hu', hv', star_mul]
  change
    ((weightFiberScale (-paperOrbitExponent n)
        (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
          (star ((u : SmoothQuotientCompactFunction) z) * star F) *
          ((F * j ^ 2) *
            (v : SmoothQuotientCompactFunction) z) =
      j ^ 2 *
        (((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) *
          star ((u : SmoothQuotientCompactFunction) z) *
          (v : SmoothQuotientCompactFunction) z)
  calc
    ((weightFiberScale (-paperOrbitExponent n)
        (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
          (star ((u : SmoothQuotientCompactFunction) z) * star F) *
          ((F * j ^ 2) *
            (v : SmoothQuotientCompactFunction) z) =
        (((weightFiberScale (-paperOrbitExponent n)
            (((γ : GammaTwo) : SL(2, ℤ)) • z) : ℝ) : ℂ) *
            (star F * F)) * j ^ 2 *
          star ((u : SmoothQuotientCompactFunction) z) *
          (v : SmoothQuotientCompactFunction) z := by ring
    _ = ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) *
          j ^ 2 *
          star ((u : SmoothQuotientCompactFunction) z) *
          (v : SmoothQuotientCompactFunction) z := by rw [hScaleConj]
    _ = j ^ 2 *
        (((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ) *
          star ((u : SmoothQuotientCompactFunction) z) *
          (v : SmoothQuotientCompactFunction) z) := by ring

/-- The canonical fiber scale at source index `-a` is exactly `y^(a/2)` on
the positive-height chart. -/
theorem weightFiberScale_neg_eq_heightRpow (a : ℤ) (z : ℍ) :
    weightFiberScale (-a) z = z.im ^ ((a : ℝ) / 2) := by
  rw [weightFiberScale]
  simp only [neg_neg]
  calc
    (Real.sqrt z.im) ^ a =
        (Real.sqrt z.im) ^ (a : ℝ) :=
      (Real.rpow_intCast (Real.sqrt z.im) a).symm
    _ = (z.im ^ (1 / 2 : ℝ)) ^ (a : ℝ) := by
      rw [Real.sqrt_eq_rpow]
    _ = z.im ^ ((1 / 2 : ℝ) * (a : ℝ)) :=
      (Real.rpow_mul z.im_pos.le (1 / 2 : ℝ) (a : ℝ)).symm
    _ = z.im ^ ((a : ℝ) / 2) := by
      congr 1
      ring

/-- Complexified source fiber scale used in the Green coefficient. -/
noncomputable def fixedPhaseGreenScale (n : ℤ) (z : ℍ) : ℂ :=
  ((weightFiberScale (-paperOrbitExponent n) z : ℝ) : ℂ)

@[simp]
theorem fixedPhaseGreenScale_eq_heightRpow (n : ℤ) (z : ℍ) :
    fixedPhaseGreenScale n z =
      ((z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ) := by
  rw [fixedPhaseGreenScale, weightFiberScale_neg_eq_heightRpow]

theorem fixedPhaseGreenScale_realSmooth (n : ℤ) :
    SmoothCompactCoreGeometry.RealSmooth (fixedPhaseGreenScale n) := by
  have hfun : fixedPhaseGreenScale n =
      (fun z : ℍ =>
        ((z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ)) := by
    funext z
    exact fixedPhaseGreenScale_eq_heightRpow n z
  rw [hfun]
  exact realSmooth_complexHeightRpow
    (((paperOrbitExponent n : ℤ) : ℝ) / 2)

@[simp]
theorem dx_fixedPhaseGreenScale (n : ℤ) (z : ℍ) :
    dx (fixedPhaseGreenScale n) z = 0 := by
  have hfun : fixedPhaseGreenScale n =
      (fun w : ℍ =>
        ((w.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ)) := by
    funext w
    exact fixedPhaseGreenScale_eq_heightRpow n w
  rw [hfun]
  exact dx_complexHeightRpow _ z

@[simp]
theorem dy_fixedPhaseGreenScale (n : ℤ) (z : ℍ) :
    dy (fixedPhaseGreenScale n) z =
      physicalExponent (paperOrbitExponent n) / heightC z *
        fixedPhaseGreenScale n z := by
  let a : ℤ := paperOrbitExponent n
  let p : ℝ := (a : ℝ) / 2
  have hfun : fixedPhaseGreenScale n =
      (fun w : ℍ => ((w.im ^ p : ℝ) : ℂ)) := by
    funext w
    simp [fixedPhaseGreenScale_eq_heightRpow, a, p]
  rw [hfun, dy_complexHeightRpow]
  rw [Real.rpow_sub_one (ne_of_gt z.im_pos)]
  change
    ((p * (z.im ^ p / z.im) : ℝ) : ℂ) =
      physicalExponent a / (z.im : ℂ) *
        ((z.im ^ p : ℝ) : ℂ)
  rw [physicalExponent_eq_intCast_div_two]
  dsimp [p]
  push_cast
  ring_nf

/-- Moving to the raised orbit index multiplies the Petersson fiber scale by
exactly `y²`. -/
theorem fixedPhaseGreenScale_succ (n : ℤ) (z : ℍ) :
    ((weightFiberScale (-paperOrbitExponent (n + 1)) z : ℝ) : ℂ) =
      heightC z ^ 2 * fixedPhaseGreenScale n z := by
  change fixedPhaseGreenScale (n + 1) z =
    heightC z ^ 2 * fixedPhaseGreenScale n z
  rw [fixedPhaseGreenScale_eq_heightRpow,
    fixedPhaseGreenScale_eq_heightRpow]
  have hExponent :
      (((paperOrbitExponent (n + 1) : ℤ) : ℝ) / 2) =
        (((paperOrbitExponent n : ℤ) : ℝ) / 2) + 2 := by
    rw [paperOrbitExponent_add_one]
    push_cast
    ring
  rw [hExponent, Real.rpow_add z.im_pos, Real.rpow_two]
  simp only [heightC, Complex.ofReal_mul, Complex.ofReal_pow]
  ring

/-- Exact `x` derivative of the scalar Green coefficient. -/
theorem dx_fixedPhaseGreenScalarDensity (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    dx (fixedPhaseGreenScalarDensity n u v) z =
      fixedPhaseGreenScale n z *
        (star (dx
            (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) z) *
            (v : SmoothQuotientCompactFunction) z +
          star ((u : SmoothQuotientCompactFunction) z) *
            dx (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) z) := by
  have hu : SmoothCompactCoreGeometry.RealSmooth
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) := u.1.1.2
  have hv : SmoothCompactCoreGeometry.RealSmooth
      (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) := v.1.1.2
  change dx
    ((fixedPhaseGreenScale n *
        (fun w => star
          ((u : SmoothQuotientCompactFunction) w))) *
      (((v : SmoothQuotientCompactFunction) : ℍ → ℂ))) z = _
  rw [dx_mul (RealSmooth.mul (fixedPhaseGreenScale_realSmooth n) (RealSmooth.conj hu)) hv,
    dx_mul (fixedPhaseGreenScale_realSmooth n) (RealSmooth.conj hu),
    dx_fixedPhaseGreenScale, dx_conj hu]
  simp only [Pi.mul_apply, zero_mul, zero_add]
  ring

/-- Exact `y` derivative, including the indispensable zero-order weight
coefficient. -/
theorem dy_fixedPhaseGreenScalarDensity (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    dy (fixedPhaseGreenScalarDensity n u v) z =
      physicalExponent (paperOrbitExponent n) / heightC z *
          fixedPhaseGreenScalarDensity n u v z +
        fixedPhaseGreenScale n z *
          (star (dy
              (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) z) *
              (v : SmoothQuotientCompactFunction) z +
            star ((u : SmoothQuotientCompactFunction) z) *
              dy (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) z) := by
  have hu : SmoothCompactCoreGeometry.RealSmooth
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) := u.1.1.2
  have hv : SmoothCompactCoreGeometry.RealSmooth
      (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) := v.1.1.2
  change dy
    ((fixedPhaseGreenScale n *
        (fun w => star
          ((u : SmoothQuotientCompactFunction) w))) *
      (((v : SmoothQuotientCompactFunction) : ℍ → ℂ))) z = _
  rw [dy_mul (RealSmooth.mul (fixedPhaseGreenScale_realSmooth n) (RealSmooth.conj hu)) hv,
    dy_mul (fixedPhaseGreenScale_realSmooth n) (RealSmooth.conj hu),
    dy_fixedPhaseGreenScale, dy_conj hu]
  simp only [Pi.mul_apply]
  unfold fixedPhaseGreenScalarDensity fixedPhaseGreenScale
  ring

/-- Real smoothness of the concrete scalar Green coefficient is derived from
the positive-height real power, real-linear conjugation, and the smoothness
already carried by the fixed-phase core. -/
theorem fixedPhaseGreenScalarDensity_realSmooth (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    SmoothCompactCoreGeometry.RealSmooth (fixedPhaseGreenScalarDensity n u v) := by
  have hScale : SmoothCompactCoreGeometry.RealSmooth
      (fun z : ℍ =>
        ((z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ)) :=
    realSmooth_complexHeightRpow
      (((paperOrbitExponent n : ℤ) : ℝ) / 2)
  have hu : SmoothCompactCoreGeometry.RealSmooth
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) :=
    u.1.1.2
  have hv : SmoothCompactCoreGeometry.RealSmooth
      (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) :=
    v.1.1.2
  have hProduct : SmoothCompactCoreGeometry.RealSmooth
      (fun z : ℍ =>
        ((z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ) *
          star ((u : SmoothQuotientCompactFunction) z) *
          ((v : SmoothQuotientCompactFunction) z)) :=
    RealSmooth.mul (RealSmooth.mul hScale (RealSmooth.conj hu)) hv
  have hEq : fixedPhaseGreenScalarDensity n u v =
      (fun z : ℍ =>
        ((z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) : ℝ) : ℂ) *
          star ((u : SmoothQuotientCompactFunction) z) *
          ((v : SmoothQuotientCompactFunction) z)) := by
    funext z
    simp only [fixedPhaseGreenScalarDensity]
    rw [weightFiberScale_neg_eq_heightRpow]
  rw [hEq]
  exact hProduct

/-- `x`-component of the divergence field associated to the Green one-form. -/
noncomputable def fixedPhaseGreenFluxX (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) : ℍ → ℂ :=
  fun z => -Complex.I * fixedPhaseGreenScalarDensity n u v z

/-- `y`-component of the same divergence field. -/
noncomputable def fixedPhaseGreenFluxY (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) : ℍ → ℂ :=
  fixedPhaseGreenScalarDensity n u v

/-- Pointwise divergence of the concrete Green flux, expressed as the exact
normalized raising/lowering bulk. -/
theorem fixedPhaseGreenFlux_divergence_eq_normalizedBulk (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    dx (fixedPhaseGreenFluxX n u v) z +
        dy (fixedPhaseGreenFluxY n u v) z =
      fixedPhaseGreenScale n z *
        (star
            (raiseRaw (paperOrbitExponent n)
              (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) z) *
            (v : SmoothQuotientCompactFunction) z +
          star ((u : SmoothQuotientCompactFunction) z) *
            (lowerRaw (paperOrbitExponent n + 4)
              (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) z /
                heightC z ^ 2)) := by
  have hρ := fixedPhaseGreenScalarDensity_realSmooth n u v
  change
    dx ((-Complex.I) • fixedPhaseGreenScalarDensity n u v) z +
        dy (fixedPhaseGreenScalarDensity n u v) z = _
  rw [dx_smul (-Complex.I) hρ,
    dx_fixedPhaseGreenScalarDensity,
    dy_fixedPhaseGreenScalarDensity]
  have hBulk := normalizedGreenBulk_expansion
    (paperOrbitExponent n)
    (((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
    (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) z
  rw [hBulk]
  unfold fixedPhaseGreenScalarDensity fixedPhaseGreenScale
  ring

/-- Multiplying the Euclidean divergence by the hyperbolic Jacobian `y²`
gives exactly the sum of the two Petersson cross-densities in the global
Green defect. -/
theorem heightSq_mul_fixedPhaseGreenFlux_divergence (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    heightC z ^ 2 *
        (dx (fixedPhaseGreenFluxX n u v) z +
          dy (fixedPhaseGreenFluxY n u v) z) =
      upstairsInnerDensity (OrbitMultiplier (n + 1))
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
            (InverseEtaFixedPhaseCore.raise n u))
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v) z +
        upstairsInnerDensity (OrbitMultiplier n)
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
            (InverseEtaFixedPhaseCore.lowerFromSucc n v)) z := by
  rw [fixedPhaseGreenFlux_divergence_eq_normalizedBulk]
  unfold upstairsInnerDensity
    InvariantFiberMetric.pointwiseInnerDensity
    InvariantFiberMetric.weightFiberMetric
  simp only [InverseEtaFixedPhaseCore.toSmoothCompactWeightCore_apply,
    InverseEtaFixedPhaseCore.raise_apply,
    InverseEtaFixedPhaseCore.lowerFromSucc_apply]
  rw [fixedPhaseGreenScale_succ, paperOrbitExponent_add_one]
  unfold fixedPhaseGreenScale
  field_simp [heightC_ne_zero z]
  <;> ring_nf

/-- The concrete divergence is integrable on the measured fundamental
carrier, because it is pointwise the sum of two compact Petersson densities. -/
theorem fixedPhaseGreenFlux_divergence_integrableOn (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    IntegrableOn
      (fun z => heightC z ^ 2 *
        (dx (fixedPhaseGreenFluxX n u v) z +
          dy (fixedPhaseGreenFluxY n u v) z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure := by
  have hRaise := upstairsInnerDensity_integrableOn
    (OrbitMultiplier (n + 1))
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
      (InverseEtaFixedPhaseCore.raise n u))
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v)
    chosenGammaTwoFundamentalDomain
  have hLower := upstairsInnerDensity_integrableOn
    (OrbitMultiplier n)
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
      (InverseEtaFixedPhaseCore.lowerFromSucc n v))
    chosenGammaTwoFundamentalDomain
  refine (hRaise.add hLower).congr ?_
  filter_upwards with z
  exact (heightSq_mul_fixedPhaseGreenFlux_divergence n u v z).symm

/-- The global Petersson defect is exactly the integral of the explicit
divergence.  No vanishing or Stokes conclusion is used in this bridge. -/
theorem greenBoundaryDefect_eq_integral_fixedPhaseGreenFlux (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v =
      ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        heightC z ^ 2 *
          (dx (fixedPhaseGreenFluxX n u v) z +
            dy (fixedPhaseGreenFluxY n u v) z)
        ∂hyperbolicMeasure := by
  have hRaise := upstairsInnerDensity_integrableOn
    (OrbitMultiplier (n + 1))
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
      (InverseEtaFixedPhaseCore.raise n u))
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v)
    chosenGammaTwoFundamentalDomain
  have hLower := upstairsInnerDensity_integrableOn
    (OrbitMultiplier n)
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
    (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
      (InverseEtaFixedPhaseCore.lowerFromSucc n v))
    chosenGammaTwoFundamentalDomain
  rw [greenBoundaryDefect,
    peterssonForm_eq_fundamentalDomainIntegral,
    peterssonForm_eq_fundamentalDomainIntegral,
    ← MeasureTheory.integral_add hRaise hLower]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z =>
    (heightSq_mul_fixedPhaseGreenFlux_divergence n u v z).symm

/-- The displayed Green one-form is simply `-rho dz` in complex notation. -/
theorem fixedPhaseGreen_fluxOneFormValue (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (z : ℍ) (ξ : ℂ) :
    fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) z ξ =
      -fixedPhaseGreenScalarDensity n u v z * ξ := by
  unfold fluxOneFormValue fixedPhaseGreenFluxX fixedPhaseGreenFluxY
  rw [← Complex.re_add_im ξ]
  simp only [Complex.add_re, Complex.add_im, Complex.ofReal_re,
    Complex.ofReal_im, Complex.mul_re, Complex.mul_im,
    Complex.I_re, Complex.I_im, zero_mul, one_mul, mul_zero,
    add_zero, zero_add, sub_zero]
  ring_nf

/-- Cancellation of a nonzero squared automorphy factor against the denominator
in a transformed tangent vector. -/
private theorem sq_mul_mul_div_sq_cancel (j rho xi : ℂ) (hj : j ≠ 0) :
    (j ^ 2 * rho) * (xi / j ^ 2) = rho * xi := by
  calc
    (j ^ 2 * rho) * (xi / j ^ 2) =
        rho * (j ^ 2 * (xi / j ^ 2)) := by
      ac_rfl
    _ = rho * xi := by
      rw [mul_div_cancel₀ xi (pow_ne_zero _ hj)]

/-- The weight-two scalar transformation and the inverse-square Möbius
differential cancel exactly.  This is the fiber-metric/Jacobian cancellation
underlying the one-form pullback law. -/
theorem fixedPhaseGreenScalarDensity_mul_moebiusDifferential (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (γ : GammaTwo) (z : ℍ) (ξ : ℂ) :
    fixedPhaseGreenScalarDensity n u v
        (((γ : GammaTwo) : SL(2, ℤ)) • z) *
        d1 (gammaTwoMoebiusCoordinate γ) z ξ =
      fixedPhaseGreenScalarDensity n u v z * ξ := by
  rw [fixedPhaseGreenScalarDensity_covariance,
    d1_gammaTwoMoebiusCoordinate]
  exact sq_mul_mul_div_sq_cancel _ _ _
    (inverseEtaPaperOrbitDenom_ne_zero γ z)

/-- The concrete Green flux satisfies the exact Möbius pullback law.  This
closes the former side-pairing part of the flux bridge directly from section
covariance and the proved derivative `d(γz)=j⁻² dz`. -/
theorem fixedPhaseGreenFlux_invariant (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    IsGammaTwoInvariantFlux
      (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) := by
  intro γ z ξ
  rw [fixedPhaseGreen_fluxOneFormValue,
    fixedPhaseGreen_fluxOneFormValue]
  change
    -fixedPhaseGreenScalarDensity n u v
        (((γ : GammaTwo) : SL(2, ℤ)) • z) *
        d1 (gammaTwoMoebiusCoordinate γ) z ξ =
      -fixedPhaseGreenScalarDensity n u v z * ξ
  rw [fixedPhaseGreenScalarDensity_covariance,
    d1_gammaTwoMoebiusCoordinate]
  simpa only [neg_mul] using congrArg Neg.neg
    (sq_mul_mul_div_sq_cancel _ _ _
      (inverseEtaPaperOrbitDenom_ne_zero γ z))

/-- Explicit one-form pullback statement for `(-iρ) dy - ρ dx = -ρ dz`.
It is definitionally the concrete instance of `IsGammaTwoInvariantFlux`, but
is exposed separately for path-level change-of-variables arguments. -/
theorem fixedPhaseGreenOneForm_pullback (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (γ : GammaTwo) (z : ℍ) (ξ : ℂ) :
    fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (((γ : GammaTwo) : SL(2, ℤ)) • z)
        (d1 (gammaTwoMoebiusCoordinate γ) z ξ) =
      fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) z ξ :=
  fixedPhaseGreenFlux_invariant n u v γ z ξ

/-- Specialization of the pullback law to every edge of the actual measured
six-tile polygon carrier. -/
theorem fixedPhaseGreenFlux_actualPolygonEdge_pairing (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) (ξ : ℂ) :
    fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
        (d1 (gammaTwoActionCoordinate e.pairingElement)
          (gammaTwoActualPolygonEdgeParam e t) ξ) =
      fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e t) ξ :=
  invariantFlux_actualPolygonEdge_pairing
    (fixedPhaseGreenFlux_invariant n u v) e t ξ

/-- Reversing the transported tangent reverses the value of the actual
paired-side one-form.  This records the orientation sign separately from the
Möbius pullback equality. -/
theorem fixedPhaseGreenFlux_actualPolygonEdge_pairing_oppositeTangent
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) (ξ : ℂ) :
    fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
        (-d1 (gammaTwoActionCoordinate e.pairingElement)
          (gammaTwoActualPolygonEdgeParam e t) ξ) =
      -fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e t) ξ := by
  calc
    fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
        (-d1 (gammaTwoActionCoordinate e.pairingElement)
          (gammaTwoActualPolygonEdgeParam e t) ξ) =
        -fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
          (d1 (gammaTwoActionCoordinate e.pairingElement)
            (gammaTwoActualPolygonEdgeParam e t) ξ) := by
      unfold fluxOneFormValue
      simp
      ring
    _ = -fluxOneFormValue
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
        (gammaTwoActualPolygonEdgeParam e t) ξ :=
      congrArg Neg.neg
        (fixedPhaseGreenFlux_actualPolygonEdge_pairing n u v e t ξ)

/-- Exact oriented-side cancellation after inserting both pieces of the
actual edge convention: the parameter-change sign and the target boundary
orientation.  This is pointwise and therefore does not presuppose a path
integral or Stokes theorem. -/
theorem fixedPhaseGreenFlux_actualPolygonEdge_orientedCancellation
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) (ξ : ℂ) :
    (e.paired.orientationSign : ℂ) *
        fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
          ((e.2.parameterSign : ℂ) *
            d1 (gammaTwoActionCoordinate e.pairingElement)
              (gammaTwoActualPolygonEdgeParam e t) ξ) =
      -(e.orientationSign : ℂ) *
        fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e t) ξ := by
  let dξ := d1 (gammaTwoActionCoordinate e.pairingElement)
    (gammaTwoActualPolygonEdgeParam e t) ξ
  have hLinear :
      fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
          ((e.2.parameterSign : ℂ) * dξ) =
        (e.2.parameterSign : ℂ) *
          fluxOneFormValue
            (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
            (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
            dξ := by
    unfold fluxOneFormValue
    simp
    ring
  have hPair :
      fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t)) dξ =
        fluxOneFormValue
          (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
          (gammaTwoActualPolygonEdgeParam e t) ξ := by
    simpa [dξ] using
      fixedPhaseGreenFlux_actualPolygonEdge_pairing n u v e t ξ
  rw [hLinear, hPair]
  have hSign := e.pairing_reverses_orientation
  have hSignC := congrArg (fun m : ℤ => (m : ℂ)) hSign
  push_cast at hSignC
  rw [← mul_assoc, hSignC]

/-- The concrete scalar flux coefficient can be nonzero only where its source
section is nonzero. -/
theorem fixedPhaseGreenScalarDensity_support_subset_left (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    Function.support (fixedPhaseGreenScalarDensity n u v) ⊆
      Function.support
        (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) := by
  intro z hz
  simp only [Function.mem_support] at hz ⊢
  intro huz
  apply hz
  simp [fixedPhaseGreenScalarDensity, huz]

/-- The same coefficient is also supported where the target section is
nonzero. -/
theorem fixedPhaseGreenScalarDensity_support_subset_right (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    Function.support (fixedPhaseGreenScalarDensity n u v) ⊆
      Function.support
        (((v : SmoothQuotientCompactFunction) : ℍ → ℂ)) := by
  intro z hz
  simp only [Function.mem_support] at hz ⊢
  intro hvz
  apply hz
  simp [fixedPhaseGreenScalarDensity, hvz]

/-- Quotient compactness of the source support already gives quotient
compactness of the explicit scalar flux coefficient. -/
theorem fixedPhaseGreenScalarDensity_quotientCompact (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    HasQuotientCompactSupport (fixedPhaseGreenScalarDensity n u v) := by
  apply u.1.2.of_isClosed_subset isClosed_closure
  unfold quotientTSupport
  exact closure_mono (Set.image_mono
    (fixedPhaseGreenScalarDensity_support_subset_left n u v))

/-- Both displayed divergence components inherit quotient compactness. -/
theorem fixedPhaseGreenFlux_quotientCompact (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    HasQuotientCompactSupport (fixedPhaseGreenFluxX n u v) ∧
      HasQuotientCompactSupport (fixedPhaseGreenFluxY n u v) := by
  have hρ := fixedPhaseGreenScalarDensity_quotientCompact n u v
  constructor
  · change HasQuotientCompactSupport
      ((-Complex.I) • fixedPhaseGreenScalarDensity n u v)
    exact hρ.smul (-Complex.I)
  · exact hρ

/-- Both concrete flux components are real smooth. -/
theorem fixedPhaseGreenFlux_realSmooth (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    RealSmooth (fixedPhaseGreenFluxX n u v) ∧
      RealSmooth (fixedPhaseGreenFluxY n u v) := by
  have hρ := fixedPhaseGreenScalarDensity_realSmooth n u v
  constructor
  · change RealSmooth
      ((-Complex.I) • fixedPhaseGreenScalarDensity n u v)
    exact hρ.const_complex_smul (-Complex.I)
  · exact hρ

/-- For the actual Green flux, quotient compactness is already discharged;
only real smoothness and the one-form pullback law remain in the geometric
flux predicate. -/
theorem fixedPhaseGreenFlux_isSmoothQuotientCompact_iff (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    IsSmoothQuotientCompactFlux
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) ↔
      RealSmooth (fixedPhaseGreenFluxX n u v) ∧
        RealSmooth (fixedPhaseGreenFluxY n u v) ∧
          IsGammaTwoInvariantFlux
            (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) := by
  constructor
  · rintro ⟨hXs, hYs, _hXc, _hYc, hInv⟩
    exact ⟨hXs, hYs, hInv⟩
  · rintro ⟨hXs, hYs, hInv⟩
    exact ⟨hXs, hYs,
      (fixedPhaseGreenFlux_quotientCompact n u v).1,
      (fixedPhaseGreenFlux_quotientCompact n u v).2, hInv⟩

/-- Consequently the full smooth quotient-compact flux predicate is now
equivalent to the sole remaining Möbius pullback identity. -/
theorem fixedPhaseGreenFlux_isSmoothQuotientCompact_iff_invariant (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    IsSmoothQuotientCompactFlux
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) ↔
      IsGammaTwoInvariantFlux
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) := by
  rw [fixedPhaseGreenFlux_isSmoothQuotientCompact_iff]
  constructor
  · exact fun h => h.2.2
  · intro hInv
    exact ⟨(fixedPhaseGreenFlux_realSmooth n u v).1,
      (fixedPhaseGreenFlux_realSmooth n u v).2, hInv⟩

/-- The actual fixed-phase flux now satisfies every smoothness, support, and
side-pairing requirement without an external certificate. -/
theorem fixedPhaseGreenFlux_isSmoothQuotientCompact (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    IsSmoothQuotientCompactFlux
      (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) :=
  (fixedPhaseGreenFlux_isSmoothQuotientCompact_iff_invariant n u v).2
    (fixedPhaseGreenFlux_invariant n u v)

/-- Exact, non-circular packaging of the concrete bridge from the fixed-phase
defect to compact-flux Stokes.  Its equality identifies the defect with the
integral of the explicitly displayed divergence; it does not assume that
either side vanishes. -/
def FixedPhaseGreenFluxBridgeStatement : Prop :=
  ∀ (n : ℤ) (u : InverseEtaFixedPhaseCore n)
      (v : InverseEtaFixedPhaseCore (n + 1)),
    IsSmoothQuotientCompactFlux
        (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) ∧
      IntegrableOn
        (fun z => heightC z ^ 2 *
          (dx (fixedPhaseGreenFluxX n u v) z +
            dy (fixedPhaseGreenFluxY n u v) z))
        chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure ∧
      greenBoundaryDefect n u v =
        ∫ z in chosenGammaTwoFundamentalDomain.carrier,
          heightC z ^ 2 *
            (dx (fixedPhaseGreenFluxX n u v) z +
              dy (fixedPhaseGreenFluxY n u v) z)
            ∂hyperbolicMeasure

/-- The concrete fixed-phase flux discharges the entire analytic bridge:
smoothness, quotient-compact support, side-pairing covariance, integrability,
and the exact identification of the Petersson defect with its divergence
integral.  No boundary-vanishing or Stokes hypothesis is used here. -/
theorem fixedPhaseGreenFluxBridge :
    FixedPhaseGreenFluxBridgeStatement := by
  intro n u v
  exact ⟨fixedPhaseGreenFlux_isSmoothQuotientCompact n u v,
    fixedPhaseGreenFlux_divergence_integrableOn n u v,
    greenBoundaryDefect_eq_integral_fixedPhaseGreenFlux n u v⟩

/-- Once the explicit flux bridge and compact-flux Stokes are available, the
actual fixed-phase Petersson Green defect vanishes. -/
theorem greenBoundaryDefect_eq_zero_of_compactFluxStokes_of_bridge
    (hStokes : GammaTwoCompactFluxStokes)
    (hBridge : FixedPhaseGreenFluxBridgeStatement)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 := by
  rcases hBridge n u v with ⟨hFlux, hInt, hEq⟩
  rw [hEq]
  exact hStokes _ _ hFlux hInt

/-- Compact-flux Stokes now implies the physical fixed-phase Green identity
with no separate analytic bridge input. -/
theorem greenBoundaryDefect_eq_zero_of_compactFluxStokes
    (hStokes : GammaTwoCompactFluxStokes)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 :=
  greenBoundaryDefect_eq_zero_of_compactFluxStokes_of_bridge
    hStokes fixedPhaseGreenFluxBridge n u v

/-- Fully expanded route from the two geometric quotient inputs to the actual
fixed-phase Green identity.  The analytic flux bridge is already discharged
by `fixedPhaseGreenFluxBridge`. -/
theorem greenBoundaryDefect_eq_zero_of_closedCarrierCompactPreimage_of_pairedPolygon
    (hProper : GammaTwoClosedCarrierCompactPreimage)
    (hPolygon : GammaTwoPairedPolygonFluxStokes)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 :=
  greenBoundaryDefect_eq_zero_of_compactFluxStokes
    (gammaTwoCompactFluxStokes_of_closedCarrierCompactPreimage_of_pairedPolygon
      hProper hPolygon)
    n u v

/-- Closed-carrier properness and the analytic bridge are discharged: only
the oriented polygon Stokes theorem remains as a geometric input. -/
theorem greenBoundaryDefect_eq_zero_of_pairedPolygon
    (hPolygon : GammaTwoPairedPolygonFluxStokes)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 :=
  greenBoundaryDefect_eq_zero_of_closedCarrierCompactPreimage_of_pairedPolygon
    gammaTwoClosedCarrierCompactPreimage hPolygon n u v

/-- Vanishing of the concrete global boundary defect is exactly the desired
compact-core Green identity.  Thus the remaining analytic obligation is
isolated without being postulated. -/
theorem greenBoundaryDefect_eq_zero_iff (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 ↔
      peterssonForm (OrbitMultiplier (n + 1))
          chosenGammaTwoFundamentalDomain
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
            (InverseEtaFixedPhaseCore.raise n u))
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v) =
        -peterssonForm (OrbitMultiplier n)
          chosenGammaTwoFundamentalDomain
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
            (InverseEtaFixedPhaseCore.lowerFromSucc n v)) := by
  rw [greenBoundaryDefect]
  exact eq_neg_iff_add_eq_zero.symm

end FixedPhasePeterssonCoordinates

/-! #### Compactly supported continuous functions embed faithfully into L²

This layer discharges the analytic part of the base-coordinate injectivity
obligation.  Compact support plus local finiteness gives square integrability;
positivity of the measure on nonempty open sets makes equality almost
everywhere faithful on continuous representatives.  No finiteness assumption
on the total measure is used.
-/

namespace CompactCoreL2

open MeasureTheory

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X]
  [OpensMeasurableSpace X]
  (mu : Measure X) [IsFiniteMeasureOnCompacts mu]

/-- A compactly supported continuous scalar function belongs to every finite
`L^p`; here we specialize the reusable Mathlib result to `p = 2`. -/
theorem memLpTwo (f : CompactlySupportedContinuousMap X ℂ) :
    MemLp (f : X → ℂ) 2 mu :=
  f.continuous.memLp_of_hasCompactSupport f.hasCompactSupport

/-- The canonical linear map from compactly supported continuous functions
to their `L²` almost-everywhere classes. -/
noncomputable def toL2 :
    CompactlySupportedContinuousMap X ℂ →ₗ[ℂ] MeasureTheory.Lp ℂ 2 mu where
  toFun f := (memLpTwo mu f).toLp f
  map_add' f g := by
    simpa only [CompactlySupportedContinuousMap.coe_add] using
      (MemLp.toLp_add (memLpTwo mu f) (memLpTwo mu g))
  map_smul' c f := by
    simpa only [CompactlySupportedContinuousMap.coe_smul,
      RingHom.id_apply] using
      (MemLp.toLp_const_smul c (memLpTwo mu f))

/-- The `L²` class has the original continuous function as an a.e.
representative. -/
theorem coeFn_toL2 (f : CompactlySupportedContinuousMap X ℂ) :
    ⇑(toL2 mu f) =ᵐ[mu] (f : X → ℂ) := by
  simpa [toL2] using MemLp.coeFn_toLp (memLpTwo mu f)

/-- If the measure is positive on every nonempty open set, the canonical
compact-core-to-`L²` map loses no pointwise information. -/
theorem toL2_injective [mu.IsOpenPosMeasure] :
    Function.Injective (toL2 mu) := by
  intro f g hfg
  apply CompactlySupportedContinuousMap.ext
  have hlp :
      (⇑(toL2 mu f) : X → ℂ) =ᵐ[mu] ⇑(toL2 mu g) := by
    rw [hfg]
  have hae : (f : X → ℂ) =ᵐ[mu] (g : X → ℂ) :=
    (coeFn_toL2 mu f).symm.trans (hlp.trans (coeFn_toL2 mu g))
  exact congrFun (MeasureTheory.Measure.eq_of_ae_eq hae
    f.continuous g.continuous)

/-- Canonical compactly-supported continuous realization in the actual
`Gamma(2)` quotient `L²` space attached to a certified fundamental domain. -/
noncomputable def gammaTwoQuotientToL2
    (D : GammaTwoQuotientGeometry.GammaTwoFundamentalDomain) :
    CompactlySupportedContinuousMap
        GammaTwoQuotientGeometry.GammaTwoQuotient ℂ →ₗ[ℂ]
      MeasureTheory.Lp ℂ 2 D.quotientMeasure :=
  toL2 D.quotientMeasure

/-- The quotient `L²` realization is faithful; open positivity and local
finiteness of the quotient measure were proved above. -/
theorem gammaTwoQuotientToL2_injective
    (D : GammaTwoQuotientGeometry.GammaTwoFundamentalDomain) :
    Function.Injective (gammaTwoQuotientToL2 D) :=
  toL2_injective D.quotientMeasure

/-- The faithful inverse-eta scalar quotient model, realized in the certified
quotient `L²` space.  This is a faithful trivialization, not an assertion that
division by `eta⁻¹` is isometric to the paper's Hermitian fiber metric. -/
noncomputable def inverseEtaCoreToL2
    (D : GammaTwoQuotientGeometry.GammaTwoFundamentalDomain) :
    (SmoothCompactCoreGeometry.SmoothCompactCore
      HalfIntegralMultiplier.inverseEtaPaperCertificate) →ₗ[ℂ]
      MeasureTheory.Lp ℂ 2 D.quotientMeasure :=
  (gammaTwoQuotientToL2 D).comp
    SmoothCompactCoreGeometry.inverseEtaQuotientLinear

/-- The base `L²` coordinate is injective: quotient scalarization and the
continuous compact-core-to-`L²` map are both faithful. -/
theorem inverseEtaCoreToL2_injective
    (D : GammaTwoQuotientGeometry.GammaTwoFundamentalDomain) :
    Function.Injective (inverseEtaCoreToL2 D) :=
  (gammaTwoQuotientToL2_injective D).comp
    SmoothCompactCoreGeometry.inverseEtaQuotientLinear_injective

/-- The quotient `L²` coordinate for the explicitly constructed chosen
fundamental domain. -/
noncomputable def chosenGammaTwoQuotientToL2 :
    CompactlySupportedContinuousMap
        GammaTwoQuotientGeometry.GammaTwoQuotient ℂ →ₗ[ℂ]
      MeasureTheory.Lp ℂ 2
        (GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain).quotientMeasure :=
  gammaTwoQuotientToL2
    GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain

theorem chosenGammaTwoQuotientToL2_injective :
    Function.Injective chosenGammaTwoQuotientToL2 :=
  gammaTwoQuotientToL2_injective
    GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain

/-- A parameter-free faithful base `L²` realization of the concrete
inverse-eta half-weight compact core. -/
noncomputable def chosenInverseEtaCoreToL2 :
    (SmoothCompactCoreGeometry.SmoothCompactCore
      HalfIntegralMultiplier.inverseEtaPaperCertificate) →ₗ[ℂ]
      MeasureTheory.Lp ℂ 2
        (GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain).quotientMeasure :=
  inverseEtaCoreToL2
    GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain

theorem chosenInverseEtaCoreToL2_injective :
    Function.Injective chosenInverseEtaCoreToL2 :=
  inverseEtaCoreToL2_injective
    GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain

end CompactCoreL2

/-- The Hilbert direct sum `H₀ ⊕₂ H_R ⊕₂ H_L`. -/
abbrev EnergyTarget (H₀ : Type v₀) (HR : Type vR) (HL : Type vL) :=
  WithLp 2 (H₀ × WithLp 2 (HR × HL))

/-- A concrete realization of a core by its base, raised, and lowered
quotient-`L²` coordinates.  Each field is linear; integrability and quotient
choice-independence are obligations of the realization that constructs it.
-/
@[ext]
structure QuotientHilbertCoordinates
    (V : Type u) [AddCommGroup V] [Module ℂ V]
    (H₀ : Type v₀) (HR : Type vR) (HL : Type vL)
    [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
    [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
    [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] where
  base : V →ₗ[ℂ] H₀
  raised : V →ₗ[ℂ] HR
  lowered : V →ₗ[ℂ] HL

namespace QuotientHilbertCoordinates

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  {H₀ : Type v₀} {HR : Type vR} {HL : Type vL}
  [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
  [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
  [NormedAddCommGroup HL] [InnerProductSpace ℂ HL]
  (Q : QuotientHilbertCoordinates V H₀ HR HL)

include Q

/-- `(u, R u, L u)` in the Hilbert `L²` direct sum. -/
def graph : V →ₗ[ℂ] EnergyTarget H₀ HR HL where
  toFun u := WithLp.toLp 2
    (Q.base u, WithLp.toLp 2 (Q.raised u, Q.lowered u))
  map_add' u v := by simp [← WithLp.toLp_add]
  map_smul' c u := by simp [← WithLp.toLp_smul]

@[simp]
theorem graph_fst (u : V) : (Q.graph u).fst = Q.base u :=
  rfl

@[simp]
theorem graph_snd_fst (u : V) : (Q.graph u).snd.fst = Q.raised u :=
  rfl

@[simp]
theorem graph_snd_snd (u : V) : (Q.graph u).snd.snd = Q.lowered u :=
  rfl

/-- Definition 1's energy sesquilinear form on the raw core. -/
noncomputable def energyForm (u v : V) : ℂ :=
  ⟪Q.graph u, Q.graph v⟫_ℂ

theorem energyForm_apply (u v : V) :
    Q.energyForm u v =
      ⟪Q.base u, Q.base v⟫_ℂ +
      ⟪Q.raised u, Q.raised v⟫_ℂ +
      ⟪Q.lowered u, Q.lowered v⟫_ℂ := by
  simp only [energyForm, WithLp.prod_inner_apply, graph_fst,
    WithLp.ofLp_fst, WithLp.ofLp_snd,
    graph_snd_fst, graph_snd_snd, add_assoc]

theorem energyForm_add_left (u v w : V) :
    Q.energyForm (u + v) w = Q.energyForm u w + Q.energyForm v w := by
  simp only [energyForm, map_add, inner_add_left]

theorem energyForm_add_right (u v w : V) :
    Q.energyForm u (v + w) = Q.energyForm u v + Q.energyForm u w := by
  simp only [energyForm, map_add, inner_add_right]

theorem energyForm_smul_left (c : ℂ) (u v : V) :
    Q.energyForm (c • u) v = conj c * Q.energyForm u v := by
  simp only [energyForm, map_smul, inner_smul_left]

theorem energyForm_smul_right (c : ℂ) (u v : V) :
    Q.energyForm u (c • v) = c * Q.energyForm u v := by
  simp only [energyForm, map_smul, inner_smul_right]

theorem energyForm_conj_symm (u v : V) :
    conj (Q.energyForm v u) = Q.energyForm u v :=
  inner_conj_symm _ _

theorem graph_norm_sq (u : V) :
    ‖Q.graph u‖ ^ 2 =
      ‖Q.base u‖ ^ 2 + ‖Q.raised u‖ ^ 2 + ‖Q.lowered u‖ ^ 2 := by
  rw [WithLp.prod_norm_sq_eq_of_L2 (Q.graph u),
    WithLp.prod_norm_sq_eq_of_L2 (Q.graph u).snd,
    Q.graph_fst u, Q.graph_snd_fst u, Q.graph_snd_snd u]
  ring

theorem re_energyForm_self (u : V) :
    (Q.energyForm u u).re =
      ‖Q.base u‖ ^ 2 + ‖Q.raised u‖ ^ 2 + ‖Q.lowered u‖ ^ 2 := by
  rw [energyForm]
  have h := norm_sq_eq_re_inner (𝕜 := ℂ) (Q.graph u)
  change ‖Q.graph u‖ ^ 2 = (inner ℂ (Q.graph u) (Q.graph u)).re at h
  rw [← h]
  exact Q.graph_norm_sq u

theorem re_energyForm_self_nonneg (u : V) :
    0 ≤ (Q.energyForm u u).re := by
  rw [Q.re_energyForm_self u]
  positivity

theorem graph_eq_zero_iff (u : V) :
    Q.graph u = 0 ↔
      Q.base u = 0 ∧ Q.raised u = 0 ∧ Q.lowered u = 0 := by
  change WithLp.toLp 2
      (Q.base u, WithLp.toLp 2 (Q.raised u, Q.lowered u)) = 0 ↔ _
  simp

theorem energyForm_self_eq_zero_iff (u : V) :
    Q.energyForm u u = 0 ↔
      Q.base u = 0 ∧ Q.raised u = 0 ∧ Q.lowered u = 0 := by
  rw [energyForm, inner_self_eq_zero (𝕜 := ℂ), Q.graph_eq_zero_iff u]

/-- Definiteness on the raw core is exactly joint graph injectivity. -/
def EnergyDefinite : Prop :=
  ∀ u : V, Q.energyForm u u = 0 → u = 0

theorem energyDefinite_iff_graph_injective :
    Q.EnergyDefinite ↔ Function.Injective Q.graph := by
  constructor
  · intro h u v huv
    apply sub_eq_zero.mp
    apply h
    have hgraph : Q.graph (u - v) = 0 := by
      rw [map_sub, huv, sub_self]
    simp only [energyForm, hgraph, inner_zero_left]
  · intro h u hu
    apply h
    rw [map_zero, Q.graph_eq_zero_iff]
    exact (Q.energyForm_self_eq_zero_iff u).mp hu

theorem energyDefinite_of_base_injective (h : Function.Injective Q.base) :
    Q.EnergyDefinite :=
  Q.energyDefinite_iff_graph_injective.mpr fun u v huv =>
    h (by simpa using congrArg WithLp.fst huv)

/-- The graph range quotients out exactly the possible raw zero-energy kernel,
so it is always a genuine pre-Hilbert space. -/
abbrev GraphRange :=
  LinearMap.range Q.graph




def toGraphRange : V →ₗ[ℂ] Q.GraphRange :=
  Q.graph.rangeRestrict

theorem toGraphRange_surjective : Function.Surjective Q.toGraphRange := by
  rintro ⟨x, u, rfl⟩
  exact ⟨u, rfl⟩

@[simp]
theorem inner_toGraphRange (u v : V) :
    ⟪Q.toGraphRange u, Q.toGraphRange v⟫_ℂ = Q.energyForm u v :=
  rfl

@[simp]
theorem norm_toGraphRange_sq (u : V) :
    ‖Q.toGraphRange u‖ ^ 2 =
      ‖Q.base u‖ ^ 2 + ‖Q.raised u‖ ^ 2 + ‖Q.lowered u‖ ^ 2 :=
  Q.graph_norm_sq u

@[simp]
theorem graphRange_inner_self_eq_zero_iff (x : Q.GraphRange) :
    ⟪x, x⟫_ℂ = 0 ↔ x = 0 :=
  inner_self_eq_zero (𝕜 := ℂ)

theorem graphRange_re_inner_self_pos {x : Q.GraphRange} (hx : x ≠ 0) :
    0 < (⟪x, x⟫_ℂ).re := by
  have h := norm_sq_eq_re_inner (𝕜 := ℂ) x
  change ‖x‖ ^ 2 = (inner ℂ x x).re at h
  rw [← h]
  positivity

theorem toGraphRange_injective_iff_energyDefinite :
    Function.Injective Q.toGraphRange ↔ Q.EnergyDefinite := by
  rw [Q.energyDefinite_iff_graph_injective]
  constructor
  · intro h u v huv
    apply h
    exact Subtype.ext huv
  · intro h u v huv
    apply h
    exact congrArg Subtype.val huv

/-- The graph-range subtype inherits the uniform additive group structure
from the ambient Hilbert direct sum through its subtype isometry. -/
noncomputable instance graphRangeIsUniformAddGroup :
    IsUniformAddGroup Q.GraphRange :=
  IsUniformInducing.isUniformAddGroup Q.GraphRange.subtype
    Q.GraphRange.subtypeₗᵢ.isometry.isUniformInducing

/-- Complex scalar multiplication on the graph range is uniformly continuous. -/
noncomputable instance graphRangeUniformContinuousConstSMul :
    UniformContinuousConstSMul ℂ Q.GraphRange :=
  uniformContinuousConstSMul_of_continuousConstSMul ℂ Q.GraphRange

/-- The Definition 1 Sobolev space is the uniform completion of the genuine graph range. -/
abbrev SobolevCompletion :=
  UniformSpace.Completion Q.GraphRange

/-! Expose Mathlib's canonical structures through the dependent abbreviation.

The explicit `change` steps are deliberate: they expose the underlying
`UniformSpace.Completion Q.GraphRange` before typeclass search starts.  This
avoids an expensive failed search through the dependent abbreviation. -/
noncomputable instance sobolevCompletionNormedAddCommGroup :
    NormedAddCommGroup Q.SobolevCompletion :=
  UniformSpace.Completion.instNormedAddCommGroup Q.GraphRange

noncomputable instance sobolevCompletionNormedSpace :
    NormedSpace ℂ Q.SobolevCompletion :=
  UniformSpace.Completion.instNormedSpace ℂ Q.GraphRange

noncomputable instance sobolevCompletionInnerProductSpace :
    InnerProductSpace ℂ Q.SobolevCompletion :=
  @UniformSpace.Completion.innerProductSpace
    ℂ Q.GraphRange Complex.instRCLike inferInstance inferInstance

noncomputable instance sobolevCompletionCompleteSpace :
    CompleteSpace Q.SobolevCompletion :=
  UniformSpace.Completion.completeSpace Q.GraphRange

/- These smoke tests force the four bridge instances to elaborate here, rather
than allowing a missing instance to trigger a very long search thousands of
lines later. -/
#synth NormedAddCommGroup Q.SobolevCompletion
#synth NormedSpace ℂ Q.SobolevCompletion
#synth InnerProductSpace ℂ Q.SobolevCompletion
#synth CompleteSpace Q.SobolevCompletion

/-- Canonical isometric embedding of the graph core into its completion. -/
noncomputable def coreEmbedding :
    Q.GraphRange →ₗᵢ[ℂ] Q.SobolevCompletion :=
  (UniformSpace.Completion.toComplₗᵢ :
    Q.GraphRange →ₗᵢ[ℂ] Q.SobolevCompletion)

theorem denseRange_coreEmbedding : DenseRange Q.coreEmbedding := by
  simpa [coreEmbedding] using
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : Q.GraphRange → Q.SobolevCompletion))

/-- Map a raw smooth core vector into the completed energy graph. -/
noncomputable def sectionCoreMap : V →ₗ[ℂ] Q.SobolevCompletion :=
  Q.coreEmbedding.toLinearMap.comp Q.toGraphRange

@[simp]
theorem sectionCoreMap_apply (u : V) :
    Q.sectionCoreMap u =
      (Q.toGraphRange u : Q.SobolevCompletion) := by
  simpa [sectionCoreMap, coreEmbedding]

theorem denseRange_sectionCoreMap : DenseRange Q.sectionCoreMap := by
  have hs : DenseRange Q.toGraphRange := Q.toGraphRange_surjective.denseRange
  have hc := Q.denseRange_coreEmbedding.comp hs Q.coreEmbedding.continuous
  simpa [sectionCoreMap, Function.comp_def] using hc

theorem sectionCoreMap_injective_iff_energyDefinite :
    Function.Injective Q.sectionCoreMap ↔ Q.EnergyDefinite := by
  rw [← Q.toGraphRange_injective_iff_energyDefinite]
  constructor
  · intro h u v huv
    apply h
    change Q.coreEmbedding (Q.toGraphRange u) =
      Q.coreEmbedding (Q.toGraphRange v)
    rw [huv]
  · intro h u v huv
    apply h
    apply Q.coreEmbedding.injective
    change Q.coreEmbedding (Q.toGraphRange u) =
      Q.coreEmbedding (Q.toGraphRange v) at huv
    exact huv

theorem norm_sectionCoreMap_sq (u : V) :
    ‖Q.sectionCoreMap u‖ ^ 2 =
      ‖Q.base u‖ ^ 2 + ‖Q.raised u‖ ^ 2 + ‖Q.lowered u‖ ^ 2 := by
  simpa [sectionCoreMap, coreEmbedding] using Q.norm_toGraphRange_sq u

variable [CompleteSpace H₀] [CompleteSpace HR] [CompleteSpace HL]

/-- Isometric closure of the graph range inside the Hilbert direct sum. -/
noncomputable def graphExtension :
    Q.SobolevCompletion →L[ℂ] EnergyTarget H₀ HR HL :=
  Q.GraphRange.subtypeₗᵢ.toContinuousLinearMap.extend
    Q.coreEmbedding.toContinuousLinearMap

@[simp]
theorem graphExtension_coe (x : Q.GraphRange) :
    Q.graphExtension (x : Q.SobolevCompletion) =
      (x : EnergyTarget H₀ HR HL) := by
  unfold graphExtension
  exact ContinuousLinearMap.extend_eq
    (e := Q.coreEmbedding.toContinuousLinearMap)
    Q.GraphRange.subtypeₗᵢ.toContinuousLinearMap
    Q.denseRange_coreEmbedding
    Q.coreEmbedding.isometry.isUniformInducing x

theorem graphExtension_norm (x : Q.SobolevCompletion) :
    ‖Q.graphExtension x‖ = ‖x‖ := by
  refine
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : Q.GraphRange → Q.SobolevCompletion)).induction_on x
      (isClosed_eq Q.graphExtension.continuous.norm
        (show Continuous (fun y : Q.SobolevCompletion => ‖y‖) from
          continuous_norm)) ?_
  intro y
  rw [Q.graphExtension_coe y]
  exact (UniformSpace.Completion.norm_coe y).symm

noncomputable def graphExtensionIsometry :
    Q.SobolevCompletion →ₗᵢ[ℂ] EnergyTarget H₀ HR HL where
  toLinearMap := Q.graphExtension.toLinearMap
  norm_map' := Q.graphExtension_norm

theorem graphExtension_range_isClosed :
    IsClosed (Set.range Q.graphExtension) := by
  change IsClosed (Set.range Q.graphExtensionIsometry)
  exact Q.graphExtensionIsometry.isometry.isClosedEmbedding.isClosed_range

/-- The completed graph is exactly the ambient closure of the raw graph. -/
theorem range_graphExtension_eq_closure_range_graph :
    Set.range Q.graphExtension = closure (Set.range Q.graph) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨x, rfl⟩
    refine UniformSpace.Completion.denseRange_coe.induction_on x
      (isClosed_closure.preimage Q.graphExtension.continuous) ?_
    intro y
    rw [Q.graphExtension_coe y]
    exact subset_closure y.property
  · apply closure_minimal
    · rintro _ ⟨u, rfl⟩
      refine ⟨(Q.toGraphRange u : Q.SobolevCompletion), ?_⟩
      rw [Q.graphExtension_coe]
      rfl
    · exact Q.graphExtension_range_isClosed

/-- Continuous base-coordinate projection from the completed graph. -/
noncomputable def baseExtension : Q.SobolevCompletion →L[ℂ] H₀ :=
  (WithLp.fstL 2 ℂ H₀ (WithLp 2 (HR × HL))).comp Q.graphExtension

/-- Continuous raising-coordinate projection from the completed graph. -/
noncomputable def raiseExtension : Q.SobolevCompletion →L[ℂ] HR :=
  (WithLp.fstL 2 ℂ HR HL).comp
    ((WithLp.sndL 2 ℂ H₀ (WithLp 2 (HR × HL))).comp Q.graphExtension)

/-- Continuous lowering-coordinate projection from the completed graph. -/
noncomputable def lowerExtension : Q.SobolevCompletion →L[ℂ] HL :=
  (WithLp.sndL 2 ℂ HR HL).comp
    ((WithLp.sndL 2 ℂ H₀ (WithLp 2 (HR × HL))).comp Q.graphExtension)

@[simp]
theorem baseExtension_core (u : V) :
    Q.baseExtension (Q.sectionCoreMap u) = Q.base u := by
  change (Q.graphExtension (Q.sectionCoreMap u)).fst = Q.base u
  rw [Q.sectionCoreMap_apply, Q.graphExtension_coe]
  rfl

@[simp]
theorem raiseExtension_core (u : V) :
    Q.raiseExtension (Q.sectionCoreMap u) = Q.raised u := by
  change (Q.graphExtension (Q.sectionCoreMap u)).snd.fst = Q.raised u
  rw [Q.sectionCoreMap_apply, Q.graphExtension_coe]
  rfl

@[simp]
theorem lowerExtension_core (u : V) :
    Q.lowerExtension (Q.sectionCoreMap u) = Q.lowered u := by
  change (Q.graphExtension (Q.sectionCoreMap u)).snd.snd = Q.lowered u
  rw [Q.sectionCoreMap_apply, Q.graphExtension_coe]
  rfl

theorem norm_baseExtension_le (x : Q.SobolevCompletion) :
    ‖Q.baseExtension x‖ ≤ ‖x‖ := by
  calc
    ‖Q.baseExtension x‖ ≤ ‖Q.graphExtension x‖ :=
      WithLp.norm_fst_le H₀ (Q.graphExtension x)
    _ = ‖x‖ := Q.graphExtension_norm x

theorem norm_raiseExtension_le (x : Q.SobolevCompletion) :
    ‖Q.raiseExtension x‖ ≤ ‖x‖ := by
  calc
    ‖Q.raiseExtension x‖ ≤ ‖(Q.graphExtension x).snd‖ :=
      WithLp.norm_fst_le HR (Q.graphExtension x).snd
    _ ≤ ‖Q.graphExtension x‖ :=
      WithLp.norm_snd_le H₀ (Q.graphExtension x)
    _ = ‖x‖ := Q.graphExtension_norm x

theorem norm_lowerExtension_le (x : Q.SobolevCompletion) :
    ‖Q.lowerExtension x‖ ≤ ‖x‖ := by
  calc
    ‖Q.lowerExtension x‖ ≤ ‖(Q.graphExtension x).snd‖ :=
      WithLp.norm_snd_le HR (Q.graphExtension x).snd
    _ ≤ ‖Q.graphExtension x‖ :=
      WithLp.norm_snd_le H₀ (Q.graphExtension x)
    _ = ‖x‖ := Q.graphExtension_norm x

theorem norm_baseExtension_le_one : ‖Q.baseExtension‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound Q.baseExtension zero_le_one
    (fun x => by simpa only [one_mul] using Q.norm_baseExtension_le x)

theorem norm_raiseExtension_le_one : ‖Q.raiseExtension‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound Q.raiseExtension zero_le_one
    (fun x => by simpa only [one_mul] using Q.norm_raiseExtension_le x)

theorem norm_lowerExtension_le_one : ‖Q.lowerExtension‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound Q.lowerExtension zero_le_one
    (fun x => by simpa only [one_mul] using Q.norm_lowerExtension_le x)

/-- Exact sum-of-squares norm identity for every completed graph vector. -/
theorem completion_norm_sq (x : Q.SobolevCompletion) :
    ‖x‖ ^ 2 = ‖Q.baseExtension x‖ ^ 2 +
      ‖Q.raiseExtension x‖ ^ 2 + ‖Q.lowerExtension x‖ ^ 2 := by
  calc
    ‖x‖ ^ 2 = ‖Q.graphExtension x‖ ^ 2 := by
      rw [Q.graphExtension_norm x]
    _ = ‖(Q.graphExtension x).fst‖ ^ 2 +
        ‖(Q.graphExtension x).snd‖ ^ 2 :=
      WithLp.prod_norm_sq_eq_of_L2 (Q.graphExtension x)
    _ = ‖(Q.graphExtension x).fst‖ ^ 2 +
        (‖(Q.graphExtension x).snd.fst‖ ^ 2 +
          ‖(Q.graphExtension x).snd.snd‖ ^ 2) := by
      rw [WithLp.prod_norm_sq_eq_of_L2 (Q.graphExtension x).snd]
    _ = ‖Q.baseExtension x‖ ^ 2 +
        ‖Q.raiseExtension x‖ ^ 2 + ‖Q.lowerExtension x‖ ^ 2 := by
      change
        ‖(Q.graphExtension x).fst‖ ^ 2 +
            (‖(Q.graphExtension x).snd.fst‖ ^ 2 +
              ‖(Q.graphExtension x).snd.snd‖ ^ 2) =
          ‖(Q.graphExtension x).fst‖ ^ 2 +
            ‖(Q.graphExtension x).snd.fst‖ ^ 2 +
              ‖(Q.graphExtension x).snd.snd‖ ^ 2
      exact (add_assoc _ _ _).symm

/-- Trial-first weak energy operator on the Hilbert completion. -/
noncomputable def completionEnergyOperator :
    WeakAntiOperator Q.SobolevCompletion :=
  innerSLFlip ℂ (E := Q.SobolevCompletion)

@[simp]
theorem completionEnergyOperator_apply (u v : Q.SobolevCompletion) :
    Q.completionEnergyOperator u v = ⟪v, u⟫_ℂ :=
  innerSLFlip_apply_apply ℂ (E := Q.SobolevCompletion) u v

/-- On the dense raw core, the canonical completion pairing is exactly the
previously defined graph energy form, with the trial-first argument order of
`WeakAntiOperator`. -/
@[simp]
theorem completionEnergyOperator_sectionCoreMap (u v : V) :
    Q.completionEnergyOperator (Q.sectionCoreMap u) (Q.sectionCoreMap v) =
      Q.energyForm v u := by
  rw [Q.completionEnergyOperator_apply, Q.sectionCoreMap_apply,
    Q.sectionCoreMap_apply]
  change
    ⟪((Q.toGraphRange v : Q.GraphRange) : Q.SobolevCompletion),
      ((Q.toGraphRange u : Q.GraphRange) : Q.SobolevCompletion)⟫_ℂ =
        Q.energyForm v u
  calc
    inner ℂ
        ((Q.toGraphRange v : Q.GraphRange) : Q.SobolevCompletion)
        ((Q.toGraphRange u : Q.GraphRange) : Q.SobolevCompletion) =
      inner ℂ (Q.toGraphRange v) (Q.toGraphRange u) := by
        exact UniformSpace.Completion.inner_coe
          (𝕜 := ℂ) (Q.toGraphRange v) (Q.toGraphRange u)
    _ = Q.energyForm v u := Q.inner_toGraphRange v u

theorem completionEnergyOperator_self_eq_zero_iff (u : Q.SobolevCompletion) :
    Q.completionEnergyOperator u u = 0 ↔ u = 0 := by
  rw [Q.completionEnergyOperator_apply]
  exact inner_self_eq_zero (𝕜 := ℂ) (x := u)

/-- The completed energy pairing is coercive with the sharp constant one. -/
theorem completionEnergyOperator_coercive :
    ComplexLaxMilgram.ComplexCoerciveWith
      (V := Q.SobolevCompletion) 1 Q.completionEnergyOperator := by
  refine ⟨zero_lt_one, fun u ↦ ?_⟩
  rw [one_mul, Q.completionEnergyOperator_apply]
  exact le_of_eq (norm_sq_eq_re_inner (𝕜 := ℂ) u)

/-- The completed energy operator is injective. -/
theorem completionEnergyOperator_injective :
    Function.Injective Q.completionEnergyOperator :=
  FredholmBypass.coerciveForm_injective
    (V := Q.SobolevCompletion) 1 Q.completionEnergyOperator
      Q.completionEnergyOperator_coercive

/-- Every bounded anti-linear functional has a completed energy solution. -/
theorem completionEnergyOperator_surjective :
    Function.Surjective Q.completionEnergyOperator :=
  FredholmBypass.coerciveForm_surjective
    (V := Q.SobolevCompletion) 1 Q.completionEnergyOperator
      Q.completionEnergyOperator_coercive

/-- The completed energy operator is bijective. -/
theorem completionEnergyOperator_bijective :
    Function.Bijective Q.completionEnergyOperator :=
  ⟨Q.completionEnergyOperator_injective,
    Q.completionEnergyOperator_surjective⟩

/-- Riesz/Lax--Milgram equivalence for the completed energy pairing. -/
noncomputable def completionEnergyEquiv :
    Q.SobolevCompletion ≃L[ℂ]
      StrongAntiDual Q.SobolevCompletion :=
  FredholmBypass.coerciveFormEquiv
    (V := Q.SobolevCompletion) 1 Q.completionEnergyOperator
      Q.completionEnergyOperator_coercive

@[simp]
theorem completionEnergyEquiv_apply (u : Q.SobolevCompletion) :
    Q.completionEnergyEquiv u = Q.completionEnergyOperator u := by
  exact FredholmBypass.coerciveFormEquiv_apply
    (V := Q.SobolevCompletion) 1 Q.completionEnergyOperator
      Q.completionEnergyOperator_coercive u

/-- Canonical completed solution for an anti-dual right-hand side. -/
noncomputable def solveCompletionEnergy
    (F : StrongAntiDual Q.SobolevCompletion) :
    Q.SobolevCompletion :=
  Q.completionEnergyEquiv.symm F

@[simp]
theorem completionEnergyOperator_solveCompletionEnergy
    (F : StrongAntiDual Q.SobolevCompletion) :
    Q.completionEnergyOperator (Q.solveCompletionEnergy F) = F := by
  simpa only [solveCompletionEnergy, completionEnergyEquiv_apply] using
    Q.completionEnergyEquiv.apply_symm_apply F

theorem solveCompletionEnergy_unique
    (F : StrongAntiDual Q.SobolevCompletion) {u : Q.SobolevCompletion}
    (hu : Q.completionEnergyOperator u = F) :
    u = Q.solveCompletionEnergy F := by
  apply Q.completionEnergyOperator_injective
  exact hu.trans (Q.completionEnergyOperator_solveCompletionEnergy F).symm

theorem solveCompletionEnergy_existsUnique
    (F : StrongAntiDual Q.SobolevCompletion) :
    ∃! u : Q.SobolevCompletion,
      Q.completionEnergyOperator u = F := by
  refine ⟨Q.solveCompletionEnergy F,
    Q.completionEnergyOperator_solveCompletionEnergy F, ?_⟩
  intro u hu
  exact Q.solveCompletionEnergy_unique F hu

/-- Sharp unit coercivity bound for the canonical solution. -/
theorem solveCompletionEnergy_norm_le
    (F : StrongAntiDual Q.SobolevCompletion) :
    ‖Q.solveCompletionEnergy F‖ ≤ ‖F‖ := by
  let u := Q.solveCompletionEnergy F
  have huOp : Q.completionEnergyOperator u = F := by
    simpa only [u] using
      Q.completionEnergyOperator_solveCompletionEnergy F
  have henergy : ‖u‖ ^ 2 ≤ ‖F‖ * ‖u‖ := by
    calc
      ‖u‖ ^ 2 = 1 * ‖u‖ ^ 2 := (one_mul _).symm
      _ ≤ (Q.completionEnergyOperator u u).re :=
        Q.completionEnergyOperator_coercive.2 u
      _ = (F u).re := by rw [huOp]
      _ ≤ ‖F u‖ := Complex.re_le_norm _
      _ ≤ ‖F‖ * ‖u‖ := F.le_opNorm u
  change ‖u‖ ≤ ‖F‖
  nlinarith [norm_nonneg u, norm_nonneg F]

/-- All three completion coordinates jointly remain injective. -/
theorem jointExtensions_injective :
    Function.Injective (fun x : Q.SobolevCompletion =>
      (Q.baseExtension x, Q.raiseExtension x, Q.lowerExtension x)) := by
  intro x y h
  have hbase := congrArg Prod.fst h
  have htail := congrArg Prod.snd h
  have hraise := congrArg Prod.fst htail
  have hlower := congrArg Prod.snd htail
  apply Q.graphExtensionIsometry.injective
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact hbase
  · apply WithLp.ofLp_injective 2
    exact Prod.ext hraise hlower

/-- The completed relation is the graph of a single-valued derivative pair
over its base `L²` coordinate exactly when this projection is injective. -/
def JointlyClosable : Prop :=
  Function.Injective Q.baseExtension

theorem jointlyClosable_iff_verticalKernel_eq_bot :
    Q.JointlyClosable ↔ LinearMap.ker Q.baseExtension.toLinearMap = ⊥ := by
  change Function.Injective Q.baseExtension.toLinearMap ↔ _
  exact LinearMap.ker_eq_bot.symm

noncomputable def ClosedBaseDomain :=
  LinearMap.range Q.baseExtension.toLinearMap

noncomputable def baseEquiv (h : Q.JointlyClosable) :
    Q.SobolevCompletion ≃ₗ[ℂ] Q.ClosedBaseDomain :=
  LinearEquiv.ofInjective Q.baseExtension.toLinearMap h

/-- Raising coordinate of the closed joint graph over the base range.  It is
intentionally a `LinearMap`: it need not be bounded in the ambient base norm. -/
noncomputable def closedRaise (h : Q.JointlyClosable) :
    Q.ClosedBaseDomain →ₗ[ℂ] HR :=
  Q.raiseExtension.toLinearMap.comp (Q.baseEquiv h).symm.toLinearMap

/-- Lowering coordinate of the closed joint graph over the base range. -/
noncomputable def closedLower (h : Q.JointlyClosable) :
    Q.ClosedBaseDomain →ₗ[ℂ] HL :=
  Q.lowerExtension.toLinearMap.comp (Q.baseEquiv h).symm.toLinearMap

/-- Parametrization of the completed joint `(u, R u, L u)` graph by its base
coordinate, when the base projection is injective. -/
noncomputable def closedJointGraphParametrization (h : Q.JointlyClosable) :
    Q.ClosedBaseDomain →ₗ[ℂ] EnergyTarget H₀ HR HL :=
  Q.graphExtension.toLinearMap.comp (Q.baseEquiv h).symm.toLinearMap

@[simp]
theorem closedJointGraphParametrization_fst (h : Q.JointlyClosable)
    (x : Q.ClosedBaseDomain) :
    (Q.closedJointGraphParametrization h x).fst = (x : H₀) := by
  change Q.baseExtension ((Q.baseEquiv h).symm x) = (x : H₀)
  exact congrArg Subtype.val ((Q.baseEquiv h).apply_symm_apply x)

@[simp]
theorem closedJointGraphParametrization_snd_fst (h : Q.JointlyClosable)
    (x : Q.ClosedBaseDomain) :
    (Q.closedJointGraphParametrization h x).snd.fst = Q.closedRaise h x :=
  rfl

@[simp]
theorem closedJointGraphParametrization_snd_snd (h : Q.JointlyClosable)
    (x : Q.ClosedBaseDomain) :
    (Q.closedJointGraphParametrization h x).snd.snd = Q.closedLower h x :=
  rfl

theorem range_closedJointGraphParametrization
    (h : Q.JointlyClosable) :
    Set.range (Q.closedJointGraphParametrization h) =
      Set.range Q.graphExtension := by
  apply Set.Subset.antisymm
  · rintro _ ⟨x, rfl⟩
    refine ⟨(Q.baseEquiv h).symm x, ?_⟩
    rfl
  · rintro _ ⟨x, rfl⟩
    refine ⟨Q.baseEquiv h x, ?_⟩
    change Q.graphExtension ((Q.baseEquiv h).symm (Q.baseEquiv h x)) =
      Q.graphExtension x
    rw [(Q.baseEquiv h).symm_apply_apply]

/-- The completed joint graph is closed in the three-coordinate Hilbert
space.  No unsupported claim that either coordinate operator is bounded in
the base norm is made. -/
theorem closedJointGraphParametrization_range_isClosed
    (h : Q.JointlyClosable) :
    IsClosed (Set.range (Q.closedJointGraphParametrization h)) := by
  rw [Q.range_closedJointGraphParametrization h]
  exact Q.graphExtension_range_isClosed

/-- Precomposition by a linear core map preserves the three typed Hilbert
coordinates. -/
def precomp {U : Type*} [AddCommGroup U] [Module ℂ U]
    (f : U →ₗ[ℂ] V) : QuotientHilbertCoordinates U H₀ HR HL where
  base := Q.base.comp f
  raised := Q.raised.comp f
  lowered := Q.lowered.comp f

@[simp]
theorem precomp_graph {U : Type*} [AddCommGroup U] [Module ℂ U]
    (f : U →ₗ[ℂ] V) (u : U) :
    (Q.precomp f).graph u = Q.graph (f u) :=
  rfl

end QuotientHilbertCoordinates


open QuotientHilbertCoordinates

/-! #### Completion of an isometric core inclusion -/

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F]

/-- The continuous linear map induced on uniform completions by a linear
isometry. -/
noncomputable def energyCompletionMap (f : E →ₗᵢ[ℂ] F) :
    UniformSpace.Completion E →L[ℂ] UniformSpace.Completion F :=
  (((UniformSpace.Completion.toComplₗᵢ :
      F →ₗᵢ[ℂ] UniformSpace.Completion F).comp f).toContinuousLinearMap).extend
    (UniformSpace.Completion.toComplL :
      E →L[ℂ] UniformSpace.Completion E)

@[simp]
theorem energyCompletionMap_coe (f : E →ₗᵢ[ℂ] F) (x : E) :
    energyCompletionMap f (x : UniformSpace.Completion E) =
      (f x : UniformSpace.Completion F) := by
  unfold energyCompletionMap
  exact ContinuousLinearMap.extend_eq _
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : E → UniformSpace.Completion E))
    (by
      simpa using
        (UniformSpace.Completion.isUniformInducing_coe E :
          IsUniformInducing ((↑) : E → UniformSpace.Completion E))) x

theorem energyCompletionMap_norm (f : E →ₗᵢ[ℂ] F)
    (x : UniformSpace.Completion E) :
    ‖energyCompletionMap f x‖ = ‖x‖ := by
  refine UniformSpace.Completion.denseRange_coe.induction_on x
    (isClosed_eq (energyCompletionMap f).continuous.norm continuous_norm) ?_
  intro y
  simp

noncomputable def energyCompletionIsometry (f : E →ₗᵢ[ℂ] F) :
    UniformSpace.Completion E →ₗᵢ[ℂ] UniformSpace.Completion F where
  toLinearMap := (energyCompletionMap f).toLinearMap
  norm_map' := energyCompletionMap_norm f

/-- A linear isometry out of a complete normed space has closed range, so
density and surjectivity coincide. -/
theorem denseRange_iff_surjective_linearIsometry_of_complete
    {X Y : Type*}
    [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
    [NormedAddCommGroup Y] [NormedSpace ℂ Y]
    (g : X →ₗᵢ[ℂ] Y) :
    DenseRange g ↔ Function.Surjective g := by
  constructor
  · intro hd
    have hc : IsClosed (Set.range g) :=
      g.isometry.isClosedEmbedding.isClosed_range
    apply Set.range_eq_univ.mp
    rw [← hc.closure_eq]
    exact hd.closure_eq
  · intro hs
    exact hs.denseRange

private theorem denseRange_energyCompletionMap_of_denseRange
    (f : E →ₗᵢ[ℂ] F) (hf : DenseRange f) :
    DenseRange (energyCompletionMap f) := by
  apply DenseRange.of_comp (g := ((↑) : E → UniformSpace.Completion E))
  have h : DenseRange
      (((↑) : F → UniformSpace.Completion F) ∘ (f : E → F)) :=
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : F → UniformSpace.Completion F)).comp
        hf (UniformSpace.Completion.continuous_coe F)
  have hfun :
      ((energyCompletionMap f :
          UniformSpace.Completion E → UniformSpace.Completion F) ∘
        ((↑) : E → UniformSpace.Completion E)) =
      (((↑) : F → UniformSpace.Completion F) ∘ (f : E → F)) := by
    funext e
    exact energyCompletionMap_coe f e
  rw [hfun]
  exact h

private theorem denseRange_of_surjective_energyCompletionMap
    (f : E →ₗᵢ[ℂ] F)
    (hf : Function.Surjective (energyCompletionMap f)) :
    DenseRange f := by
  intro y
  obtain ⟨x, hx⟩ := hf (y : UniformSpace.Completion F)
  have hmem :
      energyCompletionMap f x ∈
        closure (Set.range (fun e : E =>
          (f e : UniformSpace.Completion F))) := by
    refine UniformSpace.Completion.denseRange_coe.induction_on x
      (isClosed_closure.preimage (energyCompletionMap f).continuous) ?_
    intro e
    rw [energyCompletionMap_coe]
    exact subset_closure ⟨e, rfl⟩
  rw [hx] at hmem
  change (y : UniformSpace.Completion F) ∈
    closure (Set.range
      (((↑) : F → UniformSpace.Completion F) ∘ f)) at hmem
  rw [Set.range_comp] at hmem
  rw [Topology.IsInducing.closure_eq_preimage_closure_image
    ((UniformSpace.Completion.isUniformInducing_coe F :
      IsUniformInducing ((↑) : F → UniformSpace.Completion F))).isInducing
      (Set.range f)]
  exact hmem

/-- Exact p4/p12 bridge: an isometric core inclusion is dense exactly when
its map between Hilbert completions is onto. -/
theorem denseRange_iff_surjective_energyCompletionIsometry
    (f : E →ₗᵢ[ℂ] F) :
    DenseRange f ↔
      Function.Surjective (energyCompletionIsometry f) := by
  constructor
  · intro hf
    apply (denseRange_iff_surjective_linearIsometry_of_complete
      (energyCompletionIsometry f)).mp
    simpa [energyCompletionIsometry] using
      denseRange_energyCompletionMap_of_denseRange f hf
  · intro hf
    apply denseRange_of_surjective_energyCompletionMap f
    simpa [energyCompletionIsometry] using hf

namespace QuotientHilbertCoordinates

variable {Vc Vs : Type u} [AddCommGroup Vc] [Module ℂ Vc]
  [AddCommGroup Vs] [Module ℂ Vs]
  {H₀ : Type v₀} {HR : Type vR} {HL : Type vL}
  [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
  [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
  [NormedAddCommGroup HL] [InnerProductSpace ℂ HL]
  (Qc : QuotientHilbertCoordinates Vc H₀ HR HL)
  (Qs : QuotientHilbertCoordinates Vs H₀ HR HL)

/-- Restrict all three Hilbert coordinates along one linear core map. -/
def pullback (inclusion : Vc →ₗ[ℂ] Vs) :
    QuotientHilbertCoordinates Vc H₀ HR HL where
  base := Qs.base.comp inclusion
  raised := Qs.raised.comp inclusion
  lowered := Qs.lowered.comp inclusion

@[simp]
theorem pullback_base (inclusion : Vc →ₗ[ℂ] Vs) (u : Vc) :
    (Qs.pullback inclusion).base u = Qs.base (inclusion u) :=
  rfl

@[simp]
theorem pullback_raised (inclusion : Vc →ₗ[ℂ] Vs) (u : Vc) :
    (Qs.pullback inclusion).raised u = Qs.raised (inclusion u) :=
  rfl

@[simp]
theorem pullback_lowered (inclusion : Vc →ₗ[ℂ] Vs) (u : Vc) :
    (Qs.pullback inclusion).lowered u = Qs.lowered (inclusion u) :=
  rfl

@[simp]
theorem pullback_graph (inclusion : Vc →ₗ[ℂ] Vs) (u : Vc) :
    (Qs.pullback inclusion).graph u = Qs.graph (inclusion u) :=
  rfl

@[simp]
theorem pullback_energyForm (inclusion : Vc →ₗ[ℂ] Vs) (u v : Vc) :
    (Qs.pullback inclusion).energyForm u v =
      Qs.energyForm (inclusion u) (inclusion v) :=
  rfl

/-- Coordinatewise compatibility of a compact core with a smooth
finite-energy enlargement. -/
structure CompatibleCoreInclusion where
  inclusion : Vc →ₗ[ℂ] Vs
  base_compat : ∀ u, Qs.base (inclusion u) = Qc.base u
  raise_compat : ∀ u, Qs.raised (inclusion u) = Qc.raised u
  lower_compat : ∀ u, Qs.lowered (inclusion u) = Qc.lowered u

namespace CompatibleCoreInclusion

/-- When the smaller coordinate system is literally obtained by restricting
the larger one, all three compatibility fields are definitional rather than
external proof obligations. -/
def ofPullback (inclusion : Vc →ₗ[ℂ] Vs) :
    CompatibleCoreInclusion (Qs.pullback inclusion) Qs where
  inclusion := inclusion
  base_compat _ := rfl
  raise_compat _ := rfl
  lower_compat _ := rfl

variable (I : CompatibleCoreInclusion Qc Qs)

include I

@[simp]
theorem graph_compat (u : Vc) :
    Qs.graph (I.inclusion u) = Qc.graph u := by
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact I.base_compat u
  · apply WithLp.ofLp_injective 2
    exact Prod.ext (I.raise_compat u) (I.lower_compat u)

theorem graphRange_le : Qc.GraphRange ≤ Qs.GraphRange := by
  rintro _ ⟨u, rfl⟩
  exact ⟨I.inclusion u, graph_compat Qc Qs I u⟩

noncomputable def graphRangeIsometry :
    Qc.GraphRange →ₗᵢ[ℂ] Qs.GraphRange where
  toLinearMap := Submodule.inclusion (graphRange_le Qc Qs I)
  norm_map' _ := rfl

/-- Canonical isometric completion map associated to a supplied compatible
core inclusion. -/
noncomputable def completionInclusion :
    Qc.SobolevCompletion →ₗᵢ[ℂ] Qs.SobolevCompletion :=
  energyCompletionIsometry
    (E := Qc.GraphRange) (F := Qs.GraphRange)
    (graphRangeIsometry Qc Qs I)

/-- The two completions coincide only after proving graph-density. -/
theorem denseRange_graphRange_iff_completion_surjective :
    DenseRange (graphRangeIsometry Qc Qs I) ↔
      Function.Surjective (completionInclusion Qc Qs I) := by
  simpa only [completionInclusion] using
    denseRange_iff_surjective_energyCompletionIsometry
      (E := Qc.GraphRange) (F := Qs.GraphRange)
      (graphRangeIsometry Qc Qs I)

/-- Once graph density is supplied, the page-4 and page-12 completions are
canonically linearly isometric. -/
noncomputable def completionEquiv
    (h : DenseRange (graphRangeIsometry Qc Qs I)) :
    Qc.SobolevCompletion ≃ₗᵢ[ℂ] Qs.SobolevCompletion :=
  LinearIsometryEquiv.ofSurjective (completionInclusion Qc Qs I)
    ((denseRange_graphRange_iff_completion_surjective Qc Qs I).mp h)

@[simp]
theorem completionEquiv_apply
    (h : DenseRange (graphRangeIsometry Qc Qs I))
    (x : Qc.SobolevCompletion) :
    completionEquiv Qc Qs I h x = completionInclusion Qc Qs I x := by
  rfl

end CompatibleCoreInclusion


/-- Page 4: completion of the compactly supported graph core. -/
abbrev PaperFourCompactCompletion
    (Q4 : QuotientHilbertCoordinates Vc H₀ HR HL) :=
  (SobolevCompletion Q4)

/-- Page 12, interpreted honestly: completion of a separately supplied
smooth finite-energy graph core. -/
abbrev PaperTwelveSmoothFiniteEnergyCompletion
    (Q12 : QuotientHilbertCoordinates Vs H₀ HR HL) :=
  (SobolevCompletion Q12)

end QuotientHilbertCoordinates

/-! #### Adapter from the typed exponent-indexed differential core -/

namespace TypedDifferentialAdapter

open HalfIntegralMultiplier HalfWeightDifferentialOperators

structure ThreeWeightHilbertRealization
    {Γ : Subgroup SL(2, ℤ)}
    (D : ExponentIndexedDifferentialCore Γ) (a : ℤ)
    (H₀ : Type v₀) (HR : Type vR) (HL : Type vL)
    [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
    [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
    [NormedAddCommGroup HL] [InnerProductSpace ℂ HL] where
  base : D.core a →ₗ[ℂ] H₀
  base_injective : Function.Injective base
  raised : D.core (a + 4) →ₗ[ℂ] HR
  lowered : D.core (a - 4) →ₗ[ℂ] HL

namespace ThreeWeightHilbertRealization

variable {Γ : Subgroup SL(2, ℤ)}
  {D : ExponentIndexedDifferentialCore Γ} {a : ℤ}
  {H₀ : Type v₀} {HR : Type vR} {HL : Type vL}
  [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
  [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
  [NormedAddCommGroup HL] [InnerProductSpace ℂ HL]
  (J : ThreeWeightHilbertRealization D a H₀ HR HL)

/-- Build all three Hilbert coordinates from compactly supported continuous
models.  The only algebraic input needed for energy definiteness is that the
base model itself is injective; the passage from a continuous representative
to its `L²` class is proved injective above rather than postulated.For automorphic sections the model spaces should live on a genuine quotient
or on a line-bundle trivialization over a fundamental domain.  This constructor
deliberately does not pretend that a nonzero automorphic lift is compactly
supported on the full upper half-plane.
-/
noncomputable def ofCompactlySupportedL2
    {X₀ XR XL : Type*}
    [TopologicalSpace X₀] [MeasurableSpace X₀]
    [OpensMeasurableSpace X₀]
    [TopologicalSpace XR] [MeasurableSpace XR]
    [OpensMeasurableSpace XR]
    [TopologicalSpace XL] [MeasurableSpace XL]
    [OpensMeasurableSpace XL]
    (mu₀ : MeasureTheory.Measure X₀)
    (muR : MeasureTheory.Measure XR)
    (muL : MeasureTheory.Measure XL)
    [hmu₀ : MeasureTheory.IsFiniteMeasureOnCompacts mu₀]
    [hmuR : MeasureTheory.IsFiniteMeasureOnCompacts muR]
    [hmuL : MeasureTheory.IsFiniteMeasureOnCompacts muL]
    [mu₀.IsOpenPosMeasure]
    (baseModel : D.core a →ₗ[ℂ]
      CompactlySupportedContinuousMap X₀ ℂ)
    (baseModel_injective : Function.Injective baseModel)
    (raisedModel : D.core (a + 4) →ₗ[ℂ]
      CompactlySupportedContinuousMap XR ℂ)
    (loweredModel : D.core (a - 4) →ₗ[ℂ]
      CompactlySupportedContinuousMap XL ℂ) :
    ThreeWeightHilbertRealization D a
      (MeasureTheory.Lp ℂ 2 mu₀)
      (MeasureTheory.Lp ℂ 2 muR)
      (MeasureTheory.Lp ℂ 2 muL) where
  base := (CompactCoreL2.toL2 mu₀).comp baseModel
  base_injective :=
    (CompactCoreL2.toL2_injective mu₀).comp baseModel_injective
  raised := (CompactCoreL2.toL2 muR).comp raisedModel
  lowered := (CompactCoreL2.toL2 muL).comp loweredModel

/-- The typed R/L maps are applied before the target-weight Hilbert
realizations. -/
def coordinates :
    QuotientHilbertCoordinates (D.core a) H₀ HR HL where
  base := J.base
  raised := J.raised.comp (D.raiseCore a)
  lowered := J.lowered.comp (D.lowerCore a)

@[simp]
theorem coordinates_base (u : D.core a) :
    J.coordinates.base u = J.base u := rfl

@[simp]
theorem coordinates_raised (u : D.core a) :
    J.coordinates.raised u = J.raised (D.raiseCore a u) := rfl

@[simp]
theorem coordinates_lowered (u : D.core a) :
    J.coordinates.lowered u = J.lowered (D.lowerCore a u) := rfl

theorem coordinates_energyDefinite : EnergyDefinite J.coordinates :=
  energyDefinite_of_base_injective J.coordinates J.base_injective

end ThreeWeightHilbertRealization

variable {P : PaperHalfWeightCertificate}
  {H₀ : Type v₀} {HR : Type vR} {HL : Type vL}
  [NormedAddCommGroup H₀] [InnerProductSpace ℂ H₀]
  [NormedAddCommGroup HR] [InnerProductSpace ℂ HR]
  [NormedAddCommGroup HL] [InnerProductSpace ℂ HL]

/-- Anchor the typed exponent `-1` core to the actual p4 compact core. -/
def paperFourCoordinates
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :
    QuotientHilbertCoordinates
      (SmoothCompactCoreGeometry.SmoothCompactCore P) H₀ HR HL :=
  precomp J.coordinates A.halfCoreEquiv.symm.toLinearMap

theorem paperFourCoordinates_energyDefinite
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :
    EnergyDefinite (paperFourCoordinates A J) :=
  energyDefinite_of_base_injective (paperFourCoordinates A J)
    (J.base_injective.comp A.halfCoreEquiv.symm.injective)

/-- The page-4 half-weight Sobolev completion associated to the explicitly
supplied multiplier, differential core, and quotient-Hilbert realization. -/
abbrev PaperHalfWeightSobolevCompletion
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :=
  SobolevCompletion (paperFourCoordinates A J)

/-- Canonical map from the paper compact core into its energy completion. -/
noncomputable def paperFourCoreMap
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :
    SmoothCompactCoreGeometry.SmoothCompactCore P →ₗ[ℂ]
      PaperHalfWeightSobolevCompletion A J :=
  sectionCoreMap (paperFourCoordinates A J)

theorem denseRange_paperFourCoreMap
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :
    DenseRange (paperFourCoreMap A J) := by
  simpa [paperFourCoreMap] using
    denseRange_sectionCoreMap (paperFourCoordinates A J)

theorem paperFourCoreMap_injective
    (A : PaperExponentIndexedDifferentialCore P)
    (J : ThreeWeightHilbertRealization
      A.toExponentIndexedDifferentialCore paperDisplayedExponentIndex
      H₀ HR HL) :
    Function.Injective (paperFourCoreMap A J) := by
  have h :=
    (sectionCoreMap_injective_iff_energyDefinite (paperFourCoordinates A J)).mpr
      (paperFourCoordinates_energyDefinite A J)
  simpa [paperFourCoreMap] using h

end TypedDifferentialAdapter

/-! #### The actual fixed-phase graph completion

The residue-class tower constructed above now supplies all three Hilbert
coordinates of Definition 1 without an additional realization certificate.
At orbit index `n`, the base coordinate is the shifted Petersson `L²`
completion, while the derivative coordinates are obtained by applying the
actual typed `R_n` and `L_n` before entering the adjacent-weight Petersson
completions.This constructs the graph completion and its continuous coordinate maps.  It
does not identify this completion with the base Petersson `L²` completion, and
it does not identify independently chosen page-4 and page-12 cores.
-/

namespace FixedPhaseGraphCompletion

open HalfIntegralMultiplier HalfWeightDifferentialOperators
  GammaTwoQuotientGeometry
open WeightCorePetersson WeightCorePetersson.PeterssonCoreSpace
open FixedPhasePeterssonCoordinates

/- `InverseEtaFixedPhaseCore` is an opaque abbreviation of a `Submodule`
subtype. Keep one canonical additive/module instance family for every orbit
index so graph-coordinate structures and completion constructions elaborate
coherently throughout this namespace. -/
noncomputable local instance fixedPhaseGraphCoreModule (n : ℤ) :
    Module ℂ (InverseEtaFixedPhaseCore n) := by
  change Module ℂ ↥(inverseEtaFixedPhaseStableCoreSubmodule n)
  exact Submodule.module (inverseEtaFixedPhaseStableCoreSubmodule n)

noncomputable local instance fixedPhaseGraphCoreAddCommGroup (n : ℤ) :
    AddCommGroup (InverseEtaFixedPhaseCore n) := by
  exact Module.addCommMonoidToAddCommGroup ℂ

/-- The three concrete shifted Petersson coordinates on the canonical
fixed-phase differential core. -/
noncomputable def coordinates (n : ℤ) :
    QuotientHilbertCoordinates
      (InverseEtaFixedPhaseCore n)
      (OrbitPeterssonHilbert n)
      (OrbitPeterssonHilbert (n + 1))
      (OrbitPeterssonHilbert (n - 1)) where
  base := l2Coordinate n
  raised := raisedCoordinate n
  lowered := loweredCoordinate n

@[simp]
theorem coordinates_base (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    (coordinates n).base u = l2Coordinate n u :=
  rfl

@[simp]
theorem coordinates_raised (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    (coordinates n).raised u =
      l2Coordinate (n + 1) (InverseEtaFixedPhaseCore.raise n u) :=
  rfl

@[simp]
theorem coordinates_lowered (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    (coordinates n).lowered u =
      l2Coordinate (n - 1) (InverseEtaFixedPhaseCore.lower n u) :=
  rfl

/-- The base Petersson coordinate is faithful, hence the full three-coordinate
energy is definite. -/
theorem coordinates_energyDefinite (n : ℤ) :
    (coordinates n).EnergyDefinite :=
  (coordinates n).energyDefinite_of_base_injective
    (l2Coordinate_injective n)

/-- Hilbert completion of the actual fixed-phase graph
`(u, R_n u, L_n u)`. -/
noncomputable abbrev GraphSobolevCompletion (n : ℤ) : Type :=
  (coordinates n).SobolevCompletion

/- Re-export only the canonical completion structures needed to reveal the
opaque abbreviation.  The scalar normed-space structure is deliberately
inherited from the inner-product instance, avoiding two competing `Module`
fields on the same completion type. -/
noncomputable instance graphSobolevCompletionNormedAddCommGroup (n : ℤ) :
    NormedAddCommGroup (GraphSobolevCompletion n) :=
  UniformSpace.Completion.instNormedAddCommGroup (coordinates n).GraphRange

noncomputable instance graphSobolevCompletionInnerProductSpace (n : ℤ) :
    InnerProductSpace ℂ (GraphSobolevCompletion n) :=
  @UniformSpace.Completion.innerProductSpace
    ℂ (coordinates n).GraphRange Complex.instRCLike inferInstance inferInstance

noncomputable instance graphSobolevCompletionCompleteSpace (n : ℤ) :
    CompleteSpace (GraphSobolevCompletion n) :=
  UniformSpace.Completion.completeSpace (coordinates n).GraphRange

/-- Canonical map of the smooth fixed-phase core into its graph completion. -/
noncomputable def coreMap (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] GraphSobolevCompletion n :=
  (coordinates n).sectionCoreMap

/-- The raw fixed-phase core has dense image by the universal completion
property, not by a separate smooth-density assumption. -/
theorem denseRange_coreMap (n : ℤ) : DenseRange (coreMap n) := by
  simpa [coreMap] using (coordinates n).denseRange_sectionCoreMap

/-- Definiteness of the base Petersson coordinate makes the canonical graph
core map injective. -/
theorem coreMap_injective (n : ℤ) : Function.Injective (coreMap n) := by
  change Function.Injective ((coordinates n).sectionCoreMap)
  exact (coordinates n).sectionCoreMap_injective_iff_energyDefinite.mpr
    (coordinates_energyDefinite n)

/-- Explicit Hilbert-space witness for the fixed-phase graph completion. -/
noncomputable def hilbertSpaceWitness (n : ℤ) :
    HilbertSpace ℂ (GraphSobolevCompletion n) :=
  by exact ⟨⟩

/-- A Petersson `L²` coordinate has squared norm equal to the concrete
fundamental-domain integral defining that shifted-weight norm. -/
theorem l2Coordinate_norm_sq_eq_peterssonNormSq
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    ‖l2Coordinate n u‖ ^ 2 =
      peterssonNormSq (OrbitMultiplier n)
        chosenGammaTwoFundamentalDomain
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) := by
  rw [l2Coordinate_apply, PeterssonCoreSpace.norm_toCompletion,
    PeterssonCoreSpace.norm_sq_eq_peterssonNormSq,
    coreEmbedding_toSmoothCore]

/-- Exact Definition-1 norm on the actual smooth fixed-phase core, rewritten
as the sum of the three concrete shifted Petersson norm integrals. -/
theorem coreMap_norm_sq_eq_three_peterssonNormSq
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    ‖coreMap n u‖ ^ 2 =
      peterssonNormSq (OrbitMultiplier n)
          chosenGammaTwoFundamentalDomain
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) +
        peterssonNormSq (OrbitMultiplier (n + 1))
          chosenGammaTwoFundamentalDomain
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
            (InverseEtaFixedPhaseCore.raise n u)) +
        peterssonNormSq (OrbitMultiplier (n - 1))
          chosenGammaTwoFundamentalDomain
          (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n - 1)
            (InverseEtaFixedPhaseCore.lower n u)) := by
  calc
    ‖coreMap n u‖ ^ 2 =
        ‖l2Coordinate n u‖ ^ 2 +
          ‖l2Coordinate (n + 1) (InverseEtaFixedPhaseCore.raise n u)‖ ^ 2 +
          ‖l2Coordinate (n - 1) (InverseEtaFixedPhaseCore.lower n u)‖ ^ 2 := by
      simpa [coreMap] using (coordinates n).norm_sectionCoreMap_sq u
    _ = _ := by
      rw [l2Coordinate_norm_sq_eq_peterssonNormSq,
        l2Coordinate_norm_sq_eq_peterssonNormSq,
        l2Coordinate_norm_sq_eq_peterssonNormSq]

/-- Continuous base Petersson coordinate on the completed graph. -/
noncomputable def baseExtension (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] OrbitPeterssonHilbert n :=
  (coordinates n).baseExtension

/-- Continuous raised Petersson coordinate on the completed graph. -/
noncomputable def raiseExtension (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] OrbitPeterssonHilbert (n + 1) :=
  (coordinates n).raiseExtension

/-- Continuous lowered Petersson coordinate on the completed graph. -/
noncomputable def lowerExtension (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] OrbitPeterssonHilbert (n - 1) :=
  (coordinates n).lowerExtension

/-- The completed base coordinate restricts to the original Petersson core
coordinate on the dense smooth core. -/
@[simp]
theorem baseExtension_core (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    baseExtension n (coreMap n u) = l2Coordinate n u := by
  simpa [baseExtension, coreMap] using
    (coordinates n).baseExtension_core u

/-- The completed raising coordinate restricts to the actual typed raising
operator followed by its target-weight Petersson embedding. -/
@[simp]
theorem raiseExtension_core (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    raiseExtension n (coreMap n u) =
      l2Coordinate (n + 1) (InverseEtaFixedPhaseCore.raise n u) := by
  simpa [raiseExtension, coreMap] using
    (coordinates n).raiseExtension_core u

/-- The completed lowering coordinate restricts to the actual typed lowering
operator followed by its target-weight Petersson embedding. -/
@[simp]
theorem lowerExtension_core (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    lowerExtension n (coreMap n u) =
      l2Coordinate (n - 1) (InverseEtaFixedPhaseCore.lower n u) := by
  simpa [lowerExtension, coreMap] using
    (coordinates n).lowerExtension_core u

/-- Each completed coordinate is contractive with respect to the graph norm. -/
theorem norm_baseExtension_le (n : ℤ) (x : GraphSobolevCompletion n) :
    ‖baseExtension n x‖ ≤ ‖x‖ := by
  simpa [baseExtension] using (coordinates n).norm_baseExtension_le x

theorem norm_raiseExtension_le (n : ℤ) (x : GraphSobolevCompletion n) :
    ‖raiseExtension n x‖ ≤ ‖x‖ := by
  simpa [raiseExtension] using (coordinates n).norm_raiseExtension_le x

theorem norm_lowerExtension_le (n : ℤ) (x : GraphSobolevCompletion n) :
    ‖lowerExtension n x‖ ≤ ‖x‖ := by
  simpa [lowerExtension] using (coordinates n).norm_lowerExtension_le x

/-- Consequently all three continuous coordinate operators have norm at most
one. -/
theorem norm_baseExtension_le_one (n : ℤ) : ‖baseExtension n‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound (baseExtension n) zero_le_one
    (fun x => by simpa only [one_mul] using norm_baseExtension_le n x)

theorem norm_raiseExtension_le_one (n : ℤ) : ‖raiseExtension n‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound (raiseExtension n) zero_le_one
    (fun x => by simpa only [one_mul] using norm_raiseExtension_le n x)

theorem norm_lowerExtension_le_one (n : ℤ) : ‖lowerExtension n‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound (lowerExtension n) zero_le_one
    (fun x => by simpa only [one_mul] using norm_lowerExtension_le n x)

/-- Exact sum-of-squares identity on every vector of the completed graph. -/
theorem completion_norm_sq (n : ℤ) (x : GraphSobolevCompletion n) :
    ‖x‖ ^ 2 = ‖baseExtension n x‖ ^ 2 +
      ‖raiseExtension n x‖ ^ 2 + ‖lowerExtension n x‖ ^ 2 := by
  simpa [baseExtension, raiseExtension, lowerExtension] using
    (coordinates n).completion_norm_sq x

/-! #### One corrected space for both occurrences of `H¹`

The manuscript uses an `H¹` completion on page 4 and a graph completion on
page 12.  Defining those names from two independently chosen cores would make
their comparison depend on an extra graph-density hypothesis.  The corrected
formalization instead gives both manuscript names to the single concrete
completion of `(u, Rₙu, Lₙu)` constructed above.  Their identification is
therefore an unconditional linear isometry, not a certificate field.
-/

/-- The page-4 Sobolev space, after replacing its informal norm by the actual
three-coordinate graph norm on the fixed-phase smooth core. -/
abbrev PaperPageFourHOne (n : ℤ) := GraphSobolevCompletion n

/-- The page-12 graph space on the very same core and with the very same
Petersson derivative coordinates. -/
abbrev PaperPageTwelveGraphSpace (n : ℤ) := GraphSobolevCompletion n

/-- The two corrected manuscript spaces are canonically and isometrically
identical.  No density or closability assumption is used here. -/
noncomputable def pageFourHOneEquivPageTwelveGraph (n : ℤ) :
    PaperPageFourHOne n ≃ₗᵢ[ℂ] PaperPageTwelveGraphSpace n :=
  LinearIsometryEquiv.refl ℂ (GraphSobolevCompletion n)

@[simp]
theorem pageFourHOneEquivPageTwelveGraph_apply
    (n : ℤ) (x : PaperPageFourHOne n) :
    pageFourHOneEquivPageTwelveGraph n x = x :=
  rfl

/-- The page-4 norm is exactly the page-12 graph norm, including both
derivative coordinates and with no suppressed coefficient. -/
theorem paperPageFour_norm_sq
    (n : ℤ) (x : PaperPageFourHOne n) :
    ‖x‖ ^ 2 = ‖baseExtension n x‖ ^ 2 +
      ‖raiseExtension n x‖ ^ 2 + ‖lowerExtension n x‖ ^ 2 :=
  completion_norm_sq n x

end FixedPhaseGraphCompletion


end DefinitionOneSobolev

open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.QuotientHilbertCoordinates

/-! ### A concrete nonzero bounded cusp-decaying potential

The modular discriminant supplies an actual potential rather than a potential
certificate.  We use its Petersson self-density

`VΔ(z) = ‖conj(Δ z) * Δ z * Im(z)^12‖`.

It is strictly positive, continuous, invariant under the full modular group
(hence under `Gamma(2)`), uniformly bounded, and tends to zero exponentially
at every cusp after applying any integral scaling matrix.  It therefore
descends to the effective quotient.  On every shifted-weight compact core the
associated Hermitian potential form is genuinely integrable and its diagonal
has an explicit relative Petersson bound.  Since `VΔ ≥ 0`, its negative part
vanishes identically.The pointwise decay is connected below to the literal geometric three-cusp
truncations.  The final `H¹ → H⁻¹` compactness step still requires a local
Rellich theorem on those compact stages; no compactness claim is hidden here.
-/

namespace ExplicitDiscriminantPotential

open GammaTwoQuotientGeometry
open HalfIntegralMultiplier SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators
open DefinitionOneSobolev
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open MeasureTheory
open scoped ModularForm ContDiff

/-- The nonzero discriminant Petersson potential upstairs. -/
noncomputable def upstairsPotential (z : ℍ) : ℝ :=
  ‖UpperHalfPlane.petersson 12 ModularForm.discriminantCuspForm
      ModularForm.discriminantCuspForm z‖

/-- Continuity follows from holomorphy of the discriminant and continuity of
the Petersson density. -/
theorem upstairsPotential_continuous : Continuous upstairsPotential := by
  exact continuous_norm.comp
    (UpperHalfPlane.petersson_continuous 12
      (ModularFormClass.continuous ModularForm.discriminantCuspForm)
      (ModularFormClass.continuous ModularForm.discriminantCuspForm))

/-- The potential is pointwise nonnegative. -/
theorem upstairsPotential_nonneg (z : ℍ) : 0 ≤ upstairsPotential z :=
  norm_nonneg _

/-- The discriminant has no zero in the upper half-plane, so this potential is
strictly positive rather than the forbidden zero-potential shortcut. -/
theorem upstairsPotential_pos (z : ℍ) : 0 < upstairsPotential z := by
  rw [upstairsPotential, norm_pos_iff]
  have hDelta : (ModularForm.discriminantCuspForm z : ℂ) ≠ 0 := by
    change ModularForm.discriminant z ≠ 0
    exact ModularForm.discriminant_ne_zero z
  have hConj : star (ModularForm.discriminantCuspForm z : ℂ) ≠ 0 := by
    intro h
    apply hDelta
    simpa using congrArg star h
  have hIm : (z.im : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt z.im_pos)
  unfold UpperHalfPlane.petersson
  exact mul_ne_zero (mul_ne_zero hConj hDelta) (zpow_ne_zero _ hIm)

/-- Full modular invariance of the discriminant Petersson density. -/
theorem upstairsPotential_SL_invariant (g : SL(2, ℤ)) (z : ℍ) :
    upstairsPotential (g • z) = upstairsPotential z := by
  have hg : ((g : SL(2, ℤ)) : GL (Fin 2) ℝ) ∈ 𝒮ℒ :=
    ⟨g, rfl⟩
  simpa only [upstairsPotential, ModularGroup.sl_moeb] using
    (SlashInvariantFormClass.norm_petersson_smul
      (k := (12 : ℤ)) (f := ModularForm.discriminantCuspForm)
      (f' := ModularForm.discriminantCuspForm) (τ := z) hg)

/-- Invariance under the concrete `Gamma(2)` subgroup. -/
theorem upstairsPotential_gammaTwo_invariant (γ : GammaTwo) (z : ℍ) :
    upstairsPotential (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsPotential z :=
  upstairsPotential_SL_invariant (γ : SL(2, ℤ)) z

/-- Invariance under the effective action used by the quotient construction. -/
theorem upstairsPotential_effective_invariant
    (g : GammaTwoEffective) (z : ℍ) :
    upstairsPotential (g • z) = upstairsPotential z := by
  obtain ⟨γ, hγ⟩ := effective_exists_gamma g
  rw [hγ z]
  exact upstairsPotential_gammaTwo_invariant γ z

/-- The actual descended real-valued potential on `Gamma(2)\ℍ`. -/
noncomputable def potential : GammaTwoQuotient → ℝ :=
  descendInvariant upstairsPotential upstairsPotential_effective_invariant

@[simp]
theorem potential_mk (z : ℍ) :
    potential (gammaTwoQuotientMk z) = upstairsPotential z :=
  rfl

/-- Quotient continuity. -/
theorem potential_continuous : Continuous potential := by
  unfold potential
  exact upstairsPotential_continuous.quotient_lift _

/-- In particular the quotient potential is Borel measurable. -/
theorem potential_measurable : Measurable potential :=
  potential_continuous.measurable

/-- Strict positivity survives descent. -/
theorem potential_pos (q : GammaTwoQuotient) : 0 < potential q := by
  induction q using Quotient.inductionOn'
  change 0 < upstairsPotential _
  exact upstairsPotential_pos _

theorem potential_nonneg (q : GammaTwoQuotient) : 0 ≤ potential q :=
  (potential_pos q).le

/-- The descended potential is genuinely nonzero. -/
theorem potential_ne_zero : potential ≠ 0 := by
  intro hzero
  have hI := congrFun hzero (gammaTwoQuotientMk UpperHalfPlane.I)
  have hpos := potential_pos (gammaTwoQuotientMk UpperHalfPlane.I)
  have hI0 : potential (gammaTwoQuotientMk UpperHalfPlane.I) = 0 := by
    simpa only [Pi.zero_apply] using hI
  exact (ne_of_gt hpos) hI0

/-- Uniform boundedness furnished by the cusp-form Petersson estimate. -/
theorem exists_uniformBound :
    ∃ C : ℝ, 0 < C ∧ ∀ z : ℍ, upstairsPotential z ≤ C := by
  obtain ⟨C, hC⟩ := CuspFormClass.petersson_bounded_left
    (12 : ℤ) 𝒮ℒ ModularForm.discriminantCuspForm
      ModularForm.discriminantCuspForm
  have hCI : upstairsPotential UpperHalfPlane.I ≤ C := by
    simpa only [upstairsPotential] using hC UpperHalfPlane.I
  refine ⟨C, (upstairsPotential_pos UpperHalfPlane.I).trans_le hCI, ?_⟩
  intro z
  simpa only [upstairsPotential] using hC z

/-- A fixed positive global bound for the explicit potential. -/
noncomputable def uniformBound : ℝ :=
  Classical.choose exists_uniformBound

theorem uniformBound_pos : 0 < uniformBound :=
  (Classical.choose_spec exists_uniformBound).1

theorem upstairsPotential_le_uniformBound (z : ℍ) :
    upstairsPotential z ≤ uniformBound :=
  (Classical.choose_spec exists_uniformBound).2 z

theorem potential_le_uniformBound (q : GammaTwoQuotient) :
    potential q ≤ uniformBound := by
  induction q using Quotient.inductionOn'
  change upstairsPotential _ ≤ uniformBound
  exact upstairsPotential_le_uniformBound _

/-- Local integrability with respect to every certified quotient measure. -/
theorem potential_locallyIntegrable (D : GammaTwoFundamentalDomain) :
    LocallyIntegrable potential D.quotientMeasure :=
  potential_continuous.locallyIntegrable

/-- The Petersson self-density of the discriminant tends to zero at the cusp
`i∞`. -/
theorem upstairsPotential_isZeroAtImInfty :
    UpperHalfPlane.IsZeroAtImInfty upstairsPotential := by
  have hPet : UpperHalfPlane.IsZeroAtImInfty
      (UpperHalfPlane.petersson 12 ModularForm.discriminantCuspForm
        ModularForm.discriminantCuspForm) :=
    UpperHalfPlane.IsZeroAtImInfty.petersson_isZeroAtImInfty_left
      (k := (12 : ℤ)) (Γ := 𝒮ℒ)
      (CuspFormClass.zero_at_infty ModularForm.discriminantCuspForm)
      ModularForm.discriminantCuspForm
  rw [UpperHalfPlane.isZeroAtImInfty_iff] at hPet ⊢
  intro ε hε
  simpa only [upstairsPotential, norm_norm] using hPet ε hε

/-- Quantitative epsilon-height form of cusp decay. -/
theorem upstairsPotential_cuspTail
    {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, ∀ z : ℍ, Y ≤ z.im → upstairsPotential z ≤ ε :=
  by
    obtain ⟨Y, hY⟩ := (UpperHalfPlane.isZeroAtImInfty_iff.mp
      upstairsPotential_isZeroAtImInfty) ε hε
    refine ⟨Y, fun z hz ↦ ?_⟩
    simpa only [Real.norm_eq_abs, abs_of_nonneg
      (upstairsPotential_nonneg z)] using hY z hz

/-- The same tail estimate holds after every integral scaling matrix.  Thus it
applies simultaneously to scaling matrices for the cusps `∞`, `0`, and `1`. -/
theorem upstairsPotential_scaledCuspTail
    (g : SL(2, ℤ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, ∀ z : ℍ, Y ≤ z.im →
      upstairsPotential (g • z) ≤ ε := by
  obtain ⟨Y, hY⟩ := upstairsPotential_cuspTail hε
  exact ⟨Y, fun z hz => by
    rw [upstairsPotential_SL_invariant]
    exact hY z hz⟩

/-! ##### The analytic tail on the literal geometric `F_Y`

The finite right-coset tile set makes the three cusp estimates uniform.  This
is the missing bridge between decay in each scaling coordinate and the actual
geometric truncation constructed above.
-/

/-- Decay in the local coordinate of one selected closed tile. -/
theorem upstairsPotential_tileCuspTail
    (q : GammaTwoRightCoset) {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, ∀ z : ℍ,
      Y ≤ gammaTwoTileHeight q z → upstairsPotential z ≤ ε := by
  obtain ⟨Y, hY⟩ := upstairsPotential_cuspTail hε
  refine ⟨Y, fun z hz ↦ ?_⟩
  calc
    upstairsPotential z =
        upstairsPotential ((gammaTwoCosetRep q)⁻¹ • z) :=
      (upstairsPotential_SL_invariant (gammaTwoCosetRep q)⁻¹ z).symm
    _ ≤ ε := hY _ (by simpa only [gammaTwoTileHeight] using hz)

/-- One height works simultaneously in all finitely many selected tile
coordinates. -/
theorem exists_uniformTileCuspLevel
    {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, 1 ≤ Y ∧ ∀ q : GammaTwoRightCoset, ∀ z : ℍ,
      Y ≤ gammaTwoTileHeight q z → upstairsPotential z ≤ ε := by
  classical
  choose tileLevel hTile using fun q : GammaTwoRightCoset ↦
    upstairsPotential_tileCuspTail q hε
  let maxTileLevel : ℝ :=
    Finset.univ.sup' Finset.univ_nonempty tileLevel
  let Y : ℝ := max 1 maxTileLevel
  refine ⟨Y, by exact le_max_left _ _, ?_⟩
  intro q z hz
  have hqMax : tileLevel q ≤ maxTileLevel := by
    dsimp only [maxTileLevel]
    exact Finset.le_sup' tileLevel (Finset.mem_univ q)
  apply hTile q z
  exact hqMax.trans ((le_max_right 1 maxTileLevel).trans hz)

/-- Pointwise cusp-tail smallness on the complement of the literal compact
three-cusp truncation inside the selected closed carrier. -/
theorem upstairsPotential_closedTileCarrier_diff_threeCuspTruncation
    {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, 1 ≤ Y ∧ ∀ z : ℍ,
      z ∈ gammaTwoClosedTileCarrier \
          gammaTwoThreeCuspTruncation Y →
        upstairsPotential z ≤ ε := by
  obtain ⟨Y, hYOne, hTile⟩ := exists_uniformTileCuspLevel hε
  refine ⟨Y, hYOne, fun z hz ↦ ?_⟩
  rcases
      (mem_closedTileCarrier_diff_threeCuspTruncation_iff.mp hz) with
    ⟨hzCarrier, q, hq⟩
  apply hTile q z
  rw [gammaTwoCuspLevel_of_one_le hYOne] at hq
  exact hq.le

/-- The descended potential is uniformly small off the image of a sufficiently
large literal `F_Y`.  Every quotient point is first moved into the selected
closed carrier by an effective `Gamma(2)` transformation, under which the
potential and quotient class are unchanged. -/
theorem potential_quotientOutside_threeCuspTruncationImage
    {ε : ℝ} (hε : 0 < ε) :
    ∃ Y : ℝ, 1 ≤ Y ∧ ∀ q : GammaTwoQuotient,
      q ∉ gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y →
        potential q ≤ ε := by
  obtain ⟨Y, hYOne, hTail⟩ :=
    upstairsPotential_closedTileCarrier_diff_threeCuspTruncation hε
  refine ⟨Y, hYOne, ?_⟩
  intro q
  induction q using Quotient.inductionOn'
  rename_i z
  intro hq
  obtain ⟨a, haCarrier⟩ := gammaTwoClosedTileCarrier_orbit_covers z
  have haNot : a • z ∉ gammaTwoThreeCuspTruncation Y := by
    intro haF
    apply hq
    exact ⟨a • z, haF, gammaTwoQuotientMk_smul a z⟩
  calc
    potential (gammaTwoQuotientMk z) = upstairsPotential z :=
      potential_mk z
    _ = upstairsPotential (a • z) :=
      (upstairsPotential_effective_invariant a z).symm
    _ ≤ ε := hTail (a • z) ⟨haCarrier, haNot⟩

/-! ##### A nonzero smooth compactly supported half-weight section

The cusp-decaying potential is also a source of an honest automorphic bump.
We cut it off at half of its value at `i`.  Unlike a bump chosen in one
fundamental polygon, this cutoff is invariant before passing to the quotient,
so no side-pairing regularity has to be assumed.  Its quotient support is
compact because the potential is below the cutoff outside one of the literal
three-cusp truncations proved compact above.
-/

/-- Holomorphy of the discriminant gives real `C∞` regularity in the ambient
upper-half-plane chart.  The restriction-of-scalars step is explicit: complex
analyticity is stronger than the real smoothness needed by the Maass
operators. -/
theorem discriminant_upperLift_realContDiffOn :
    ContDiffOn ℝ ∞
      ((fun z : ℍ ↦
          (ModularForm.discriminantCuspForm z : ℂ)) ∘
        UpperHalfPlane.ofComplex)
      UpperHalfPlane.upperHalfPlaneSet := by
  letI : IsScalarTower ℝ ℂ ℂ := IsScalarTower.complexToReal
  have hDiff : DifferentiableOn ℂ
      ((fun z : ℍ ↦
          (ModularForm.discriminantCuspForm z : ℂ)) ∘
        UpperHalfPlane.ofComplex)
      UpperHalfPlane.upperHalfPlaneSet :=
    UpperHalfPlane.mdifferentiable_iff.mp
      ModularForm.discriminantCuspForm.holo'
  exact ContDiffOn.restrict_scalars ℝ
    ((hDiff.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).contDiffOn_of_completeSpace)

/-- The discriminant itself belongs to the real-smooth function class used
throughout the differential-operator layer. -/
theorem discriminant_realSmooth :
    RealSmooth
      (fun z : ℍ ↦ (ModularForm.discriminantCuspForm z : ℂ)) := by
  unfold RealSmooth upperLift
  exact discriminant_upperLift_realContDiffOn

/-- Complex conjugation is real linear, hence it preserves real smoothness. -/
theorem discriminant_conj_realSmooth :
    RealSmooth
      (fun z : ℍ ↦
        star (ModularForm.discriminantCuspForm z : ℂ)) := by
  exact RealSmooth.conj discriminant_realSmooth

/-- The un-normed Petersson self-density is real smooth. -/
theorem discriminantPetersson_realSmooth :
    RealSmooth
      (UpperHalfPlane.petersson 12
        ModularForm.discriminantCuspForm
        ModularForm.discriminantCuspForm) := by
  have hProduct :=
    (discriminant_conj_realSmooth.mul discriminant_realSmooth).mul
      (HalfWeightDifferentialOperators.realSmooth_heightC.pow 12)
  change RealSmooth
    (((fun z : ℍ =>
        star (ModularForm.discriminantCuspForm z : ℂ)) *
      (fun z : ℍ => (ModularForm.discriminantCuspForm z : ℂ))) *
        (HalfWeightDifferentialOperators.heightC ^ (12 : ℕ)))
  exact hProduct

/-- Ambient real `C∞` regularity of the positive discriminant potential.  The
norm is smooth here because the Petersson self-density never vanishes. -/
theorem upstairsPotential_upperLift_realContDiffOn :
    ContDiffOn ℝ ∞
      (fun w : ℂ ↦ upstairsPotential (UpperHalfPlane.ofComplex w))
      UpperHalfPlane.upperHalfPlaneSet := by
  have hPetersson := discriminantPetersson_realSmooth
  unfold RealSmooth at hPetersson
  have hNorm := hPetersson.norm ℝ (fun w hw ↦ by
    have hpos := upstairsPotential_pos (UpperHalfPlane.ofComplex w)
    simpa only [upstairsPotential, norm_pos_iff, upperLift,
      Function.comp_apply] using hpos)
  simpa only [upperLift, Function.comp_def, upstairsPotential] using hNorm

/-- The positive cutoff level, chosen canonically from the value at `i`. -/
noncomputable def coreCutoffLevel : ℝ :=
  upstairsPotential UpperHalfPlane.I / 2

theorem coreCutoffLevel_pos : 0 < coreCutoffLevel := by
  exact div_pos (upstairsPotential_pos UpperHalfPlane.I) (by norm_num)

theorem coreCutoffLevel_lt_valueAtI :
    coreCutoffLevel < upstairsPotential UpperHalfPlane.I := by
  dsimp only [coreCutoffLevel]
  linarith [upstairsPotential_pos UpperHalfPlane.I]

/-- The invariant smooth cutoff upstairs.  It vanishes wherever the potential
is at most `coreCutoffLevel` and is positive at `i`. -/
noncomputable def upstairsCoreCutoff (z : ℍ) : ℂ :=
  (expNegInvGlue (upstairsPotential z - coreCutoffLevel) : ℂ)

/-- The cutoff is genuinely real `C∞`, including across its zero set. -/
theorem upstairsCoreCutoff_realSmooth : RealSmooth upstairsCoreCutoff := by
  unfold RealSmooth upperLift upstairsCoreCutoff
  have hArg : ContDiffOn ℝ ∞
      (fun w : ℂ ↦
        upstairsPotential (UpperHalfPlane.ofComplex w) - coreCutoffLevel)
      UpperHalfPlane.upperHalfPlaneSet :=
    upstairsPotential_upperLift_realContDiffOn.sub contDiffOn_const
  have hGlue : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ expNegInvGlue
        (upstairsPotential (UpperHalfPlane.ofComplex w) - coreCutoffLevel))
      UpperHalfPlane.upperHalfPlaneSet :=
    expNegInvGlue.contDiff.comp_contDiffOn hArg
  simpa only [Function.comp_def, Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.comp_contDiffOn hGlue

/-- Full modular invariance of the cutoff. -/
theorem upstairsCoreCutoff_SL_invariant (g : SL(2, ℤ)) (z : ℍ) :
    upstairsCoreCutoff (g • z) = upstairsCoreCutoff z := by
  simp only [upstairsCoreCutoff, upstairsPotential_SL_invariant]

/-- In particular the cutoff is invariant under `Gamma(2)`. -/
theorem upstairsCoreCutoff_gammaTwo_invariant (γ : GammaTwo) (z : ℍ) :
    upstairsCoreCutoff (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsCoreCutoff z :=
  upstairsCoreCutoff_SL_invariant (γ : SL(2, ℤ)) z

/-- The descended cutoff. -/
noncomputable def quotientCoreCutoff (q : GammaTwoQuotient) : ℂ :=
  (expNegInvGlue (potential q - coreCutoffLevel) : ℂ)

@[simp]
theorem quotientCoreCutoff_mk (z : ℍ) :
    quotientCoreCutoff (gammaTwoQuotientMk z) = upstairsCoreCutoff z :=
  rfl

theorem quotientCoreCutoff_continuous : Continuous quotientCoreCutoff := by
  exact Complex.ofRealCLM.continuous.comp
    ((expNegInvGlue.contDiff (n := 1)).continuous.comp
      (potential_continuous.sub continuous_const))

/-- The support of the descended cutoff lies in one compact literal
three-cusp truncation image. -/
theorem quotientCoreCutoff_support_subset_compactTruncation :
    ∃ Y : ℝ, 1 ≤ Y ∧
      Function.support quotientCoreCutoff ⊆
        gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y := by
  obtain ⟨Y, hY, hTail⟩ :=
    potential_quotientOutside_threeCuspTruncationImage coreCutoffLevel_pos
  refine ⟨Y, hY, ?_⟩
  intro q hq
  change quotientCoreCutoff q ≠ 0 at hq
  by_contra hqOutside
  have hSmall : potential q ≤ coreCutoffLevel := hTail q hqOutside
  apply hq
  simp only [quotientCoreCutoff,
    expNegInvGlue.zero_of_nonpos (sub_nonpos.mpr hSmall),
    Complex.ofReal_zero]

/-- The descended cutoff has ordinary compact topological support. -/
theorem quotientCoreCutoff_hasCompactSupport :
    HasCompactSupport quotientCoreCutoff := by
  change IsCompact (closure (Function.support quotientCoreCutoff))
  obtain ⟨Y, _hY, hSupport⟩ :=
    quotientCoreCutoff_support_subset_compactTruncation
  have hCompactImage : IsCompact
      (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) :=
    (gammaTwoThreeCuspTruncation_isCompact Y).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous
  exact hCompactImage.of_isClosed_subset isClosed_closure
    (closure_minimal hSupport hCompactImage.isClosed)

/-- Projecting the upstairs cutoff support gives exactly the support of the
descended cutoff.  This prevents any hidden choice of quotient
representatives in the compact-support proof. -/
theorem upstairsCoreCutoff_projected_support :
    gammaTwoQuotientMk '' Function.support upstairsCoreCutoff =
      Function.support quotientCoreCutoff := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · rintro ⟨w, hw, hEq⟩
    have hw' : quotientCoreCutoff (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support, quotientCoreCutoff_mk] using hw
    rwa [hEq] at hw'
  · intro hz
    refine ⟨z, ?_, rfl⟩
    change quotientCoreCutoff (gammaTwoQuotientMk z) ≠ 0 at hz
    rw [quotientCoreCutoff_mk] at hz
    exact hz

/-- Consequently quotient support upstairs is literally the ordinary
topological support of the descended bump. -/
theorem upstairsCoreCutoff_quotientTSupport :
    quotientTSupport upstairsCoreCutoff = tsupport quotientCoreCutoff := by
  rw [quotientTSupport, tsupport, upstairsCoreCutoff_projected_support]

theorem upstairsCoreCutoff_quotientCompact :
    HasQuotientCompactSupport upstairsCoreCutoff := by
  rw [HasQuotientCompactSupport, upstairsCoreCutoff_quotientTSupport]
  exact quotientCoreCutoff_hasCompactSupport

/-- The automorphic bump is nonzero at `i`. -/
theorem upstairsCoreCutoff_apply_I_ne_zero :
    upstairsCoreCutoff UpperHalfPlane.I ≠ 0 := by
  apply Complex.ofReal_ne_zero.mpr
  exact ne_of_gt (expNegInvGlue.pos_of_pos (sub_pos.mpr
    coreCutoffLevel_lt_valueAtI))

/-- Eta inverse is real smooth on the upper half-plane.  This proof uses the
locally uniform holomorphic eta product and its nowhere-vanishing theorem; it
does not infer smoothness merely from continuity. -/
theorem inverseEtaSection_realSmooth :
    RealSmooth (inverseEtaSection : ℍ → ℂ) := by
  letI : IsScalarTower ℝ ℂ ℂ := IsScalarTower.complexToReal
  have hEtaDiff : DifferentiableOn ℂ ModularForm.eta
      UpperHalfPlane.upperHalfPlaneSet := fun w hw ↦
    (ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet hw).differentiableWithinAt
  have hEtaSmooth : ContDiffOn ℝ ∞ ModularForm.eta
      UpperHalfPlane.upperHalfPlaneSet :=
    ContDiffOn.restrict_scalars ℝ
      ((hEtaDiff.analyticOnNhd
        UpperHalfPlane.isOpen_upperHalfPlaneSet).contDiffOn_of_completeSpace)
  have hEtaInv : ContDiffOn ℝ ∞ (fun w : ℂ ↦ (ModularForm.eta w)⁻¹)
      UpperHalfPlane.upperHalfPlaneSet :=
    hEtaSmooth.inv (fun w hw ↦ ModularForm.eta_ne_zero hw)
  unfold RealSmooth upperLift
  exact hEtaInv.congr (fun w hw ↦ by
    simp only [Function.comp_apply, inverseEtaSection,
      UpperHalfPlane.ofComplex_apply_of_im_pos hw])

/-- The explicit invariant cutoff as an element of the raw smooth
quotient-compact domain. -/
noncomputable def upstairsCoreCutoffSmoothQuotient :
    SmoothQuotientCompactFunction :=
  ⟨⟨upstairsCoreCutoff, upstairsCoreCutoff_realSmooth⟩,
    upstairsCoreCutoff_quotientCompact⟩

@[simp]
theorem upstairsCoreCutoffSmoothQuotient_apply (z : ℍ) :
    (upstairsCoreCutoffSmoothQuotient : ℍ → ℂ) z =
      upstairsCoreCutoff z :=
  rfl

/-- The packaged cutoff satisfies the exact invariance hypothesis of the
general natural-test-core constructor. -/
theorem upstairsCoreCutoffSmoothQuotient_invariant :
    IsGammaTwoInvariantCutoff upstairsCoreCutoffSmoothQuotient := by
  intro γ z
  exact upstairsCoreCutoff_gammaTwo_invariant γ z

/-- The inverse-eta seed transported to orbit index zero, before multiplying
by a cutoff.  The transport is proved from the factor formula; it does not
identify separately packaged multiplier structures by definitional equality. -/
noncomputable def inverseEtaPaperOrbitZeroSeedSection :
    InverseEtaPaperOrbitSection GammaTwo 0 := by
  refine ⟨(inverseEtaSection : ℍ → ℂ), ?_⟩
  intro γ z
  have hEta := WeightSection.covariance inverseEtaSection γ z
  change
    inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      (inverseEtaMultiplier GammaTwo).factor γ z * inverseEtaSection z at hEta
  change
    inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo 0).factor γ z *
        inverseEtaSection z
  rw [inverseEtaPaperOrbitMultiplier_factor]
  simp only [mul_zero, zpow_zero, mul_one]
  exact hEta

@[simp]
theorem inverseEtaPaperOrbitZeroSeedSection_apply (z : ℍ) :
    inverseEtaPaperOrbitZeroSeedSection z = inverseEtaSection z :=
  rfl

theorem inverseEtaPaperOrbitZeroSeedSection_realSmooth :
    RealSmooth (inverseEtaPaperOrbitZeroSeedSection : ℍ → ℂ) :=
  by
    change RealSmooth (inverseEtaSection : ℍ → ℂ)
    exact inverseEtaSection_realSmooth

theorem inverseEtaPaperOrbitZeroSeedSection_apply_ne_zero (z : ℍ) :
    inverseEtaPaperOrbitZeroSeedSection z ≠ 0 := by
  change inverseEtaSection z ≠ 0
  exact inverseEtaSection_apply_ne_zero z

/-- Multiplication by a compactly supported factor cannot enlarge quotient
support. -/
theorem quotientTSupport_mul_subset_left (f g : ℍ → ℂ) :
    quotientTSupport (f * g) ⊆ quotientTSupport f := by
  apply closure_minimal
  · rintro q ⟨z, hz, rfl⟩
    exact subset_closure
      ⟨z, Function.support_mul_subset_left f g hz, rfl⟩
  · exact isClosed_closure

/-- The actual nonzero half-weight section: invariant bump times inverse eta. -/
noncomputable def compactInverseEtaSection :
    WeightSection inverseEtaPaperCertificate.multiplier := by
  refine ⟨fun z ↦ upstairsCoreCutoff z * inverseEtaSection z, ?_⟩
  intro γ z
  change
    upstairsCoreCutoff (((γ : GammaTwo) : SL(2, ℤ)) • z) *
        inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      inverseEtaPaperCertificate.multiplier.factor γ z *
        (upstairsCoreCutoff z * inverseEtaSection z)
  rw [upstairsCoreCutoff_gammaTwo_invariant,
    WeightSection.covariance inverseEtaSection]
  ring

theorem compactInverseEtaSection_realSmooth :
    RealSmooth (compactInverseEtaSection : ℍ → ℂ) := by
  change RealSmooth
    (upstairsCoreCutoff * (inverseEtaSection : ℍ → ℂ))
  exact upstairsCoreCutoff_realSmooth.mul inverseEtaSection_realSmooth

theorem compactInverseEtaSection_quotientCompact :
    HasQuotientCompactSupport (compactInverseEtaSection : ℍ → ℂ) := by
  change HasQuotientCompactSupport
    (upstairsCoreCutoff * (inverseEtaSection : ℍ → ℂ))
  have hCutoffCompact := upstairsCoreCutoff_quotientCompact
  unfold HasQuotientCompactSupport at hCutoffCompact ⊢
  apply hCutoffCompact.of_isClosed_subset
    isClosed_closure
  exact quotientTSupport_mul_subset_left upstairsCoreCutoff
    (inverseEtaSection : ℍ → ℂ)

/-- A concrete inhabitant of the paper's actual smooth quotient-compact
half-weight core. -/
noncomputable def compactInverseEtaPaperCore :
    SmoothCompactCore inverseEtaPaperCertificate :=
  ⟨compactInverseEtaSection,
    compactInverseEtaSection_realSmooth,
    compactInverseEtaSection_quotientCompact⟩

/-- The same object in the weight-indexed compact-core interface. -/
noncomputable def compactInverseEtaWeightCore :
    SmoothCompactWeightCore inverseEtaPaperCertificate.multiplier :=
  ⟨compactInverseEtaSection,
    compactInverseEtaSection_realSmooth,
    compactInverseEtaSection_quotientCompact⟩

/-- The same formula, rebuilt directly at orbit index zero.  This avoids
relying on definitional equality between two separately packaged multiplier
structures. -/
noncomputable def compactInverseEtaOrbitZeroSection :
    InverseEtaPaperOrbitSection GammaTwo 0 := by
  refine ⟨fun z ↦ upstairsCoreCutoff z * inverseEtaSection z, ?_⟩
  intro γ z
  have hEta :
      inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
        (inverseEtaMultiplier GammaTwo).factor γ z *
          inverseEtaSection z :=
    WeightSection.covariance inverseEtaSection γ z
  change
    upstairsCoreCutoff (((γ : GammaTwo) : SL(2, ℤ)) • z) *
        inverseEtaSection (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo 0).factor γ z *
        (upstairsCoreCutoff z * inverseEtaSection z)
  rw [upstairsCoreCutoff_gammaTwo_invariant, hEta,
    inverseEtaPaperOrbitMultiplier_factor]
  simp only [mul_zero, zpow_zero, mul_one]
  ring

/-- A nonzero member of the exact fixed-phase orbit's base smooth compact
core.  Stability under every `R/L` word is a strictly stronger statement. -/
noncomputable def compactInverseEtaOrbitZeroWeightCore :
    SmoothCompactWeightCore
      (inverseEtaPaperOrbitMultiplier GammaTwo 0) :=
  ⟨compactInverseEtaOrbitZeroSection,
    compactInverseEtaSection_realSmooth,
    compactInverseEtaSection_quotientCompact⟩

@[simp]
theorem compactInverseEtaPaperCore_apply (z : ℍ) :
    SmoothCompactCore.toSection compactInverseEtaPaperCore z =
      upstairsCoreCutoff z * inverseEtaSection z :=
  rfl

/-- Nontriviality is witnessed pointwise at `i`; it is not inferred from an
abstract existence interface. -/
theorem compactInverseEtaPaperCore_ne_zero :
    compactInverseEtaPaperCore ≠
      (0 : SmoothCompactCore inverseEtaPaperCertificate) := by
  intro hZero
  have hAtI := congrArg
    (fun u : SmoothCompactCore inverseEtaPaperCertificate ↦
      SmoothCompactCore.toSection u UpperHalfPlane.I) hZero
  rw [compactInverseEtaPaperCore_apply,
    SmoothCompactCore.zero_apply] at hAtI
  exact (mul_ne_zero upstairsCoreCutoff_apply_I_ne_zero
    (inverseEtaSection_apply_ne_zero UpperHalfPlane.I)) hAtI

theorem compactInverseEtaWeightCore_ne_zero :
    compactInverseEtaWeightCore ≠
      (0 : SmoothCompactWeightCore
        inverseEtaPaperCertificate.multiplier) := by
  intro hZero
  have hAtI := congrArg
    (fun u : SmoothCompactWeightCore
        inverseEtaPaperCertificate.multiplier ↦
      SmoothCompactWeightCore.toSection u UpperHalfPlane.I) hZero
  rw [SmoothCompactWeightCore.zero_apply] at hAtI
  change upstairsCoreCutoff UpperHalfPlane.I *
      inverseEtaSection UpperHalfPlane.I = 0 at hAtI
  exact (mul_ne_zero upstairsCoreCutoff_apply_I_ne_zero
    (inverseEtaSection_apply_ne_zero UpperHalfPlane.I)) hAtI

theorem compactInverseEtaOrbitZeroWeightCore_ne_zero :
    compactInverseEtaOrbitZeroWeightCore ≠
      (0 : SmoothCompactWeightCore
        (inverseEtaPaperOrbitMultiplier GammaTwo 0)) := by
  intro hZero
  have hAtI := congrArg
    (fun u : SmoothCompactWeightCore
        (inverseEtaPaperOrbitMultiplier GammaTwo 0) ↦
      SmoothCompactWeightCore.toSection u UpperHalfPlane.I) hZero
  rw [SmoothCompactWeightCore.zero_apply] at hAtI
  change upstairsCoreCutoff UpperHalfPlane.I *
      inverseEtaSection UpperHalfPlane.I = 0 at hAtI
  exact (mul_ne_zero upstairsCoreCutoff_apply_I_ne_zero
    (inverseEtaSection_apply_ne_zero UpperHalfPlane.I)) hAtI

/-- Forget only the already-proved covariance of the concrete orbit-zero
weight core, retaining its genuine real-smooth quotient-compact function. -/
noncomputable def compactInverseEtaOrbitZeroSmoothQuotient :
    SmoothQuotientCompactFunction :=
  ⟨⟨(SmoothCompactWeightCore.toSection compactInverseEtaOrbitZeroWeightCore : ℍ → ℂ),
      SmoothCompactWeightCore.realSmooth compactInverseEtaOrbitZeroWeightCore⟩,
    SmoothCompactWeightCore.quotientCompact compactInverseEtaOrbitZeroWeightCore⟩

/-- Zeroth-word covariance of the explicit discriminant-cutoff section. -/
theorem compactInverseEtaOrbitZeroSmoothQuotient_covariant :
    IsInverseEtaPaperOrbitCovariant 0
      compactInverseEtaOrbitZeroSmoothQuotient := by
  intro γ z
  have hCov :=
    SmoothCompactWeightCore.covariance
      compactInverseEtaOrbitZeroWeightCore γ z
  rw [← GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul] at hCov
  rw [show
    GammaTwoQuotientGeometry.gammaTwoToSL2Real γ • z =
      Matrix.SpecialLinearGroup.toGL
        (GammaTwoQuotientGeometry.gammaTwoToSL2Real γ) • z by rfl] at hCov
  simpa [compactInverseEtaOrbitZeroSmoothQuotient,
    inverseEtaPaperOrbitFactor,
    GammaTwoQuotientGeometry.gammaTwoToSL2Real] using hCov

/-- The discriminant-cutoff section belongs to the all-word stable
fixed-phase core.  Membership is discharged by the proved `R/L` word
induction, not by a stored stability field. -/
noncomputable def compactInverseEtaFixedPhaseCoreZero :
    InverseEtaFixedPhaseCore 0 :=
  invariantCutoffTimesOrbitSection 0
    upstairsCoreCutoffSmoothQuotient
    upstairsCoreCutoffSmoothQuotient_invariant
    inverseEtaPaperOrbitZeroSeedSection
    inverseEtaPaperOrbitZeroSeedSection_realSmooth

@[simp]
theorem compactInverseEtaFixedPhaseCoreZero_apply (z : ℍ) :
    ((compactInverseEtaFixedPhaseCoreZero :
        InverseEtaFixedPhaseCore 0) : SmoothQuotientCompactFunction) z =
      upstairsCoreCutoff z * inverseEtaSection z :=
  rfl

/-- The stronger all-word fixed-phase core is therefore genuinely nontrivial. -/
theorem compactInverseEtaFixedPhaseCoreZero_ne_zero :
    compactInverseEtaFixedPhaseCoreZero ≠
      (0 : InverseEtaFixedPhaseCore 0) := by
  exact invariantCutoffTimesOrbitSection_ne_zero 0
    upstairsCoreCutoffSmoothQuotient
    upstairsCoreCutoffSmoothQuotient_invariant
    inverseEtaPaperOrbitZeroSeedSection
    inverseEtaPaperOrbitZeroSeedSection_realSmooth UpperHalfPlane.I
    upstairsCoreCutoff_apply_I_ne_zero
    (inverseEtaPaperOrbitZeroSeedSection_apply_ne_zero UpperHalfPlane.I)

noncomputable instance inverseEtaFixedPhaseCoreZero_nontrivial :
    Nontrivial (InverseEtaFixedPhaseCore 0) :=
  ⟨⟨compactInverseEtaFixedPhaseCoreZero, 0,
    compactInverseEtaFixedPhaseCoreZero_ne_zero⟩⟩

/-- Forgetting all-word stability recovers exactly the previously constructed
orbit-zero smooth weight core. -/
theorem compactInverseEtaFixedPhaseCoreZero_toWeightCore :
    InverseEtaFixedPhaseCore.toSmoothCompactWeightCore 0
        compactInverseEtaFixedPhaseCoreZero =
      compactInverseEtaOrbitZeroWeightCore := by
  apply SmoothCompactWeightCore.ext
  intro z
  rfl

section CorePotentialForm

variable {k : ℤ} (M : HalfIntegralMultiplier GammaTwo k)

/-- The explicit potential times the Hermitian Petersson cross-density. -/
noncomputable def weightedInnerDensity
    (u v : SmoothCompactWeightCore M) (q : GammaTwoQuotient) : ℂ :=
  (potential q : ℂ) * quotientInnerDensity M u v q

theorem weightedInnerDensity_continuous
    (u v : SmoothCompactWeightCore M) :
    Continuous (weightedInnerDensity M u v) := by
  exact (Complex.continuous_ofReal.comp potential_continuous).mul
    (quotientInnerDensity_continuous M u v)

/-- Compact support comes from either compact-core entry, not from pretending
that the potential itself is compactly supported. -/
theorem weightedInnerDensity_hasCompactSupport
    (u v : SmoothCompactWeightCore M) :
    HasCompactSupport (weightedInnerDensity M u v) := by
  exact (quotientInnerDensity_hasCompactSupport_left M u v).mul_left

theorem weightedInnerDensity_integrable
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    Integrable (weightedInnerDensity M u v) D.quotientMeasure :=
  (weightedInnerDensity_continuous M u v).integrable_of_hasCompactSupport
    (weightedInnerDensity_hasCompactSupport M u v)

/-- The actual Hermitian potential form on the shifted-weight compact core. -/
noncomputable def potentialForm
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) : ℂ :=
  ∫ q, weightedInnerDensity M u v q ∂D.quotientMeasure

/-- Its real diagonal energy. -/
noncomputable def potentialEnergy
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) : ℝ :=
  ∫ q, potential q * quotientNormSqDensity M u q ∂D.quotientMeasure

theorem potentialEnergyDensity_integrable
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) :
    Integrable (fun q => potential q * quotientNormSqDensity M u q)
      D.quotientMeasure := by
  exact (potential_continuous.mul
      (quotientNormSqDensity_continuous M u)).integrable_of_hasCompactSupport
    ((quotientNormSqDensity_hasCompactSupport M u).mul_left)

theorem potentialEnergy_nonneg
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) :
    0 ≤ potentialEnergy M D u := by
  unfold potentialEnergy
  exact integral_nonneg fun q =>
    mul_nonneg (potential_nonneg q) (quotientNormSqDensity_nonneg M u q)

/-- Exact identification of the complex diagonal with the real energy. -/
theorem potentialForm_self_eq_ofReal_energy
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) :
    potentialForm M D u u = (potentialEnergy M D u : ℂ) := by
  unfold potentialForm potentialEnergy weightedInnerDensity
  calc
    (∫ q, (potential q : ℂ) * quotientInnerDensity M u u q
        ∂D.quotientMeasure) =
        ∫ q, ((potential q * quotientNormSqDensity M u q : ℝ) : ℂ)
          ∂D.quotientMeasure := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun q => by
        change (potential q : ℂ) * quotientInnerDensity M u u q =
          ((potential q * quotientNormSqDensity M u q : ℝ) : ℂ)
        rw [quotientInnerDensity_self]
        exact (Complex.ofReal_mul _ _).symm
    _ = ((∫ q, potential q * quotientNormSqDensity M u q
          ∂D.quotientMeasure : ℝ) : ℂ) :=
      integral_complex_ofReal

/-- Hermitian symmetry uses that the explicit potential is real-valued. -/
theorem potentialForm_conj_symm
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    star (potentialForm M D v u) = potentialForm M D u v := by
  unfold potentialForm
  calc
    star
        (∫ q, weightedInnerDensity M v u q ∂D.quotientMeasure) =
        ∫ q, star (weightedInnerDensity M v u q)
          ∂D.quotientMeasure := by
      symm
      exact integral_conj
    _ = ∫ q, weightedInnerDensity M u v q ∂D.quotientMeasure := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun q => by
        change (starRingEnd ℂ)
            ((potential q : ℂ) * quotientInnerDensity M v u q) =
          (potential q : ℂ) * quotientInnerDensity M u v q
        rw [map_mul]
        change star (potential q : ℂ) *
            star (quotientInnerDensity M v u q) =
          (potential q : ℂ) * quotientInnerDensity M u v q
        have hPotentialConj : star (potential q : ℂ) =
            (potential q : ℂ) :=
          Complex.conj_ofReal _
        rw [hPotentialConj, quotientInnerDensity_conj_symm]

/-- Additivity in the conjugate-linear entry. -/
theorem potentialForm_add_left
    (D : GammaTwoFundamentalDomain)
    (u v w : SmoothCompactWeightCore M) :
    potentialForm M D (u + v) w =
      potentialForm M D u w + potentialForm M D v w := by
  unfold potentialForm weightedInnerDensity
  simpa only [weightedInnerDensity, quotientInnerDensity_add_left, mul_add] using
    integral_add (weightedInnerDensity_integrable M D u w)
      (weightedInnerDensity_integrable M D v w)

/-- Conjugate homogeneity in the first entry. -/
theorem potentialForm_smul_left
    (D : GammaTwoFundamentalDomain) (c : ℂ)
    (u v : SmoothCompactWeightCore M) :
    potentialForm M D (c • u) v =
      star c * potentialForm M D u v := by
  unfold potentialForm weightedInnerDensity
  simpa only [quotientInnerDensity_smul_left, mul_assoc, mul_left_comm,
    mul_comm] using
    (MeasureTheory.integral_const_mul
      (μ := D.quotientMeasure) (star c)
      (fun q => (potential q : ℂ) * quotientInnerDensity M u v q))

/-- Additivity in the linear entry. -/
theorem potentialForm_add_right
    (D : GammaTwoFundamentalDomain)
    (u v w : SmoothCompactWeightCore M) :
    potentialForm M D u (v + w) =
      potentialForm M D u v + potentialForm M D u w := by
  unfold potentialForm weightedInnerDensity
  simpa only [weightedInnerDensity, quotientInnerDensity_add_right, mul_add] using
    integral_add (weightedInnerDensity_integrable M D u v)
      (weightedInnerDensity_integrable M D u w)

/-- Homogeneity in the linear entry. -/
theorem potentialForm_smul_right
    (D : GammaTwoFundamentalDomain) (c : ℂ)
    (u v : SmoothCompactWeightCore M) :
    potentialForm M D u (c • v) =
      c * potentialForm M D u v := by
  unfold potentialForm weightedInnerDensity
  simpa only [quotientInnerDensity_smul_right, mul_assoc, mul_left_comm,
    mul_comm] using
    (MeasureTheory.integral_const_mul
      (μ := D.quotientMeasure) c
      (fun q => (potential q : ℂ) * quotientInnerDensity M u v q))

/-- The explicit potential is relatively form-bounded by its uniform bound.
This is the core-level continuity estimate needed before completion. -/
theorem potentialEnergy_le_peterssonNormSq
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) :
    potentialEnergy M D u ≤
      uniformBound * peterssonNormSq M D u := by
  unfold potentialEnergy peterssonNormSq
  calc
    (∫ q, potential q * quotientNormSqDensity M u q
        ∂D.quotientMeasure) ≤
        ∫ q, uniformBound * quotientNormSqDensity M u q
          ∂D.quotientMeasure := by
      apply integral_mono
      · exact potentialEnergyDensity_integrable M D u
      · exact (quotientNormSqDensity_integrable M u D).const_mul uniformBound
      · intro q
        exact mul_le_mul_of_nonneg_right
          (potential_le_uniformBound q)
          (quotientNormSqDensity_nonneg M u q)
    _ = uniformBound *
        ∫ q, quotientNormSqDensity M u q ∂D.quotientMeasure := by
      exact MeasureTheory.integral_const_mul uniformBound
        (quotientNormSqDensity M u)

/-! ##### Cauchy--Schwarz and completion-level form continuity

The diagonal estimate above is not, by itself, a two-variable continuity
estimate.  The missing step is the Cauchy--Schwarz inequality for the positive
Hermitian form defined by the explicit potential.  We first package precisely
the already-proved algebraic and positivity facts as a *pre*-inner-product
core.  Semidefiniteness is sufficient here; no artificial definiteness or
nonvanishing certificate is introduced.
-/

/-- The explicit potential form as a positive-semidefinite Hermitian
pre-inner-product core on the smooth compact section space. -/
@[reducible] noncomputable def potentialPreInnerProductCore
    (D : GammaTwoFundamentalDomain) :
    PreInnerProductSpace.Core ℂ (SmoothCompactWeightCore M) where
  inner := potentialForm M D
  conj_inner_symm := potentialForm_conj_symm M D
  re_inner_nonneg := fun u => by
    rw [potentialForm_self_eq_ofReal_energy]
    change 0 ≤ potentialEnergy M D u
    exact potentialEnergy_nonneg M D u
  add_left := potentialForm_add_left M D
  smul_left := fun u v c => potentialForm_smul_left M D c u v

/-- Cauchy--Schwarz for the actual potential integral, in its squared form.
This proof uses only positivity and Hermitian symmetry of that integral. -/
theorem potentialForm_norm_sq_le_energy_mul_energy
    (D : GammaTwoFundamentalDomain)
    (u v : SmoothCompactWeightCore M) :
    ‖potentialForm M D u v‖ ^ 2 ≤
      potentialEnergy M D u * potentialEnergy M D v := by
  letI : PreInnerProductSpace.Core ℂ (SmoothCompactWeightCore M) :=
    potentialPreInnerProductCore M D
  have hCS :=
    InnerProductSpace.Core.inner_mul_inner_self_le
      (𝕜 := ℂ) u v
  change
    ‖potentialForm M D u v‖ * ‖potentialForm M D v u‖ ≤
      (potentialForm M D u u).re * (potentialForm M D v v).re at hCS
  have hSymmNorm :
      ‖potentialForm M D v u‖ = ‖potentialForm M D u v‖ := by
    calc
      ‖potentialForm M D v u‖ =
          ‖star (potentialForm M D v u)‖ :=
        (Complex.norm_conj _).symm
      _ = ‖potentialForm M D u v‖ := by
        rw [potentialForm_conj_symm]
  rw [hSymmNorm, potentialForm_self_eq_ofReal_energy,
    potentialForm_self_eq_ofReal_energy, Complex.ofReal_re,
    Complex.ofReal_re] at hCS
  simpa only [pow_two] using hCS

/-- The Cauchy--Schwarz estimate and the uniform pointwise bound combine to
give the genuine two-variable Petersson estimate on the norm-carrying core. -/
theorem potentialForm_norm_le_uniformBound_mul_peterssonNorm
    (u v : PeterssonCoreSpace M) :
    ‖potentialForm M chosenGammaTwoFundamentalDomain
        u.toSmoothCore v.toSmoothCore‖ ≤
      uniformBound * ‖u‖ * ‖v‖ := by
  have hCS := potentialForm_norm_sq_le_energy_mul_energy M
    chosenGammaTwoFundamentalDomain u.toSmoothCore v.toSmoothCore
  have hEu := potentialEnergy_le_peterssonNormSq M
    chosenGammaTwoFundamentalDomain u.toSmoothCore
  have hEv := potentialEnergy_le_peterssonNormSq M
    chosenGammaTwoFundamentalDomain v.toSmoothCore
  have hProduct :
      potentialEnergy M chosenGammaTwoFundamentalDomain u.toSmoothCore *
          potentialEnergy M chosenGammaTwoFundamentalDomain v.toSmoothCore ≤
        (uniformBound * peterssonNormSq M
            chosenGammaTwoFundamentalDomain u.toSmoothCore) *
          (uniformBound * peterssonNormSq M
            chosenGammaTwoFundamentalDomain v.toSmoothCore) := by
    exact mul_le_mul hEu hEv
      (potentialEnergy_nonneg M chosenGammaTwoFundamentalDomain v.toSmoothCore)
      (mul_nonneg uniformBound_pos.le
        (peterssonNormSq_nonneg M chosenGammaTwoFundamentalDomain
          u.toSmoothCore))
  have hSq :
      ‖potentialForm M chosenGammaTwoFundamentalDomain
          u.toSmoothCore v.toSmoothCore‖ ^ 2 ≤
        (uniformBound * ‖u‖ * ‖v‖) ^ 2 := by
    calc
      ‖potentialForm M chosenGammaTwoFundamentalDomain
          u.toSmoothCore v.toSmoothCore‖ ^ 2 ≤
          potentialEnergy M chosenGammaTwoFundamentalDomain u.toSmoothCore *
            potentialEnergy M chosenGammaTwoFundamentalDomain v.toSmoothCore :=
        hCS
      _ ≤ (uniformBound * peterssonNormSq M
            chosenGammaTwoFundamentalDomain u.toSmoothCore) *
          (uniformBound * peterssonNormSq M
            chosenGammaTwoFundamentalDomain v.toSmoothCore) :=
        hProduct
      _ = (uniformBound * ‖u‖ * ‖v‖) ^ 2 := by
        rw [← PeterssonCoreSpace.norm_sq_eq_peterssonNormSq,
          ← PeterssonCoreSpace.norm_sq_eq_peterssonNormSq]
        ring
  exact le_of_sq_le_sq hSq
    (mul_nonneg
      (mul_nonneg uniformBound_pos.le (norm_nonneg u)) (norm_nonneg v))

/-- Algebraic operator associated to the potential form.  The trial variable
is linear and the test variable is conjugate-linear, matching
`WeakAntiOperator`. -/
noncomputable def peterssonCorePotentialLinear :
    PeterssonCoreSpace M →ₗ[ℂ]
      PeterssonCoreSpace M →ₗ⋆[ℂ] ℂ where
  toFun u :=
    { toFun := fun v => potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore u.toSmoothCore
      map_add' := fun v w => by
        simpa only [PeterssonCoreSpace.toSmoothCore_add] using
          potentialForm_add_left M chosenGammaTwoFundamentalDomain
            v.toSmoothCore w.toSmoothCore u.toSmoothCore
      map_smul' := fun c v => by
        have hstar : (starRingEnd ℂ) c = star c := by
          rfl
        simpa only [PeterssonCoreSpace.toSmoothCore_smul,
          smul_eq_mul, hstar] using
          potentialForm_smul_left M chosenGammaTwoFundamentalDomain c
            v.toSmoothCore u.toSmoothCore }
  map_add' u w := by
    ext v
    change potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore (u + w).toSmoothCore =
      potentialForm M chosenGammaTwoFundamentalDomain
          v.toSmoothCore u.toSmoothCore +
        potentialForm M chosenGammaTwoFundamentalDomain
          v.toSmoothCore w.toSmoothCore
    rw [PeterssonCoreSpace.toSmoothCore_add]
    exact potentialForm_add_right M chosenGammaTwoFundamentalDomain
      v.toSmoothCore u.toSmoothCore w.toSmoothCore
  map_smul' c u := by
    ext v
    change potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore (c • u).toSmoothCore =
      c * potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore u.toSmoothCore
    rw [PeterssonCoreSpace.toSmoothCore_smul]
    exact potentialForm_smul_right M chosenGammaTwoFundamentalDomain c
      v.toSmoothCore u.toSmoothCore

@[simp]
theorem peterssonCorePotentialLinear_apply
    (u v : PeterssonCoreSpace M) :
    peterssonCorePotentialLinear M u v =
      potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore u.toSmoothCore :=
  rfl

/-- The actual bounded potential operator on the Petersson compact core. -/
noncomputable def peterssonCorePotentialOperator :
    WeakAntiOperator (PeterssonCoreSpace M) :=
  (peterssonCorePotentialLinear M).mkContinuous₂ uniformBound fun u v => by
    simpa only [peterssonCorePotentialLinear_apply, mul_comm, mul_left_comm,
      mul_assoc] using
      potentialForm_norm_le_uniformBound_mul_peterssonNorm M v u

@[simp]
theorem peterssonCorePotentialOperator_apply
    (u v : PeterssonCoreSpace M) :
    peterssonCorePotentialOperator M u v =
      potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore u.toSmoothCore :=
  rfl

/-- Operator-norm form of the core continuity estimate. -/
theorem norm_peterssonCorePotentialOperator_le_uniformBound :
    ‖peterssonCorePotentialOperator M‖ ≤ uniformBound := by
  exact LinearMap.mkContinuous₂_norm_le
    (peterssonCorePotentialLinear M) uniformBound_pos.le fun u v => by
      simpa only [peterssonCorePotentialLinear_apply, mul_comm, mul_left_comm,
        mul_assoc] using
        potentialForm_norm_le_uniformBound_mul_peterssonNorm M v u

/-! The next layer extends both variables to the Petersson Hilbert
completion.  Extending only the outer variable would leave a functional on
the incomplete core; the explicit anti-dual extension below prevents that
common gap. -/

/-- The continuous isometric embedding used for both completion variables. -/
noncomputable def peterssonCompletionEmbedding :
    PeterssonCoreSpace M →L[ℂ] PeterssonHilbertCompletion M :=
  (PeterssonCoreSpace.toCompletion (M := M)).toContinuousLinearMap

theorem peterssonCompletionEmbedding_denseRange :
    DenseRange (peterssonCompletionEmbedding M) := by
  change DenseRange
    ((↑) : PeterssonCoreSpace M →
      UniformSpace.Completion (PeterssonCoreSpace M))
  exact UniformSpace.Completion.denseRange_coe

theorem peterssonCompletionEmbedding_isUniformInducing :
    IsUniformInducing (peterssonCompletionEmbedding M) := by
  change IsUniformInducing
    ((↑) : PeterssonCoreSpace M →
      UniformSpace.Completion (PeterssonCoreSpace M))
  exact (UniformSpace.Completion.isUniformInducing_coe (PeterssonCoreSpace M) :
    IsUniformInducing ((↑) : PeterssonCoreSpace M →
      UniformSpace.Completion (PeterssonCoreSpace M)))

/-- Algebraic dependence of the extension of an anti-linear functional on
that functional.  Each value is the unique continuous extension along the
dense Petersson completion embedding. -/
noncomputable def peterssonAntiDualExtensionLinear :
    StrongAntiDual (PeterssonCoreSpace M) →ₗ[ℂ]
      StrongAntiDual (PeterssonHilbertCompletion M) where
  toFun f := f.extend (peterssonCompletionEmbedding M)
  map_add' f g := by
    apply ContinuousLinearMap.extend_unique
      (f := f + g)
      (peterssonCompletionEmbedding_denseRange M)
      (peterssonCompletionEmbedding_isUniformInducing M)
    ext u
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.extend_eq _
        (peterssonCompletionEmbedding_denseRange M)
        (peterssonCompletionEmbedding_isUniformInducing M)]
  map_smul' c f := by
    apply ContinuousLinearMap.extend_unique
      (f := c • f)
      (peterssonCompletionEmbedding_denseRange M)
      (peterssonCompletionEmbedding_isUniformInducing M)
    ext u
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.extend_eq _
        (peterssonCompletionEmbedding_denseRange M)
        (peterssonCompletionEmbedding_isUniformInducing M), RingHom.id_apply]

/-- Extension to the completed test space does not increase the anti-dual
operator norm. -/
theorem peterssonAntiDualExtensionLinear_norm_le
    (f : StrongAntiDual (PeterssonCoreSpace M)) :
    ‖peterssonAntiDualExtensionLinear M f‖ ≤ ‖f‖ := by
  change ‖f.extend (peterssonCompletionEmbedding M)‖ ≤ ‖f‖
  have h := ContinuousLinearMap.opNorm_extend_le
    (f := f) (e := peterssonCompletionEmbedding M)
    (N := (1 : NNReal))
    (peterssonCompletionEmbedding_denseRange M)
    (fun u => by
      rw [NNReal.coe_one, one_mul]
      change ‖u‖ ≤ ‖PeterssonCoreSpace.toCompletion u‖
      exact (PeterssonCoreSpace.norm_toCompletion u).ge)
  simpa only [NNReal.coe_one, one_mul] using h

/-- Continuous linear extension of anti-duals from the Petersson core to its
Hilbert completion. -/
noncomputable def peterssonAntiDualExtension :
    StrongAntiDual (PeterssonCoreSpace M) →L[ℂ]
      StrongAntiDual (PeterssonHilbertCompletion M) :=
  (peterssonAntiDualExtensionLinear M).mkContinuous 1 fun f => by
    simpa only [one_mul] using peterssonAntiDualExtensionLinear_norm_le M f

@[simp]
theorem peterssonAntiDualExtension_apply_core
    (f : StrongAntiDual (PeterssonCoreSpace M))
    (v : PeterssonCoreSpace M) :
    peterssonAntiDualExtension M f (PeterssonCoreSpace.toCompletion v) =
      f v := by
  change f.extend (peterssonCompletionEmbedding M)
    (peterssonCompletionEmbedding M v) = f v
  exact ContinuousLinearMap.extend_eq f
    (peterssonCompletionEmbedding_denseRange M)
    (peterssonCompletionEmbedding_isUniformInducing M) v

theorem norm_peterssonAntiDualExtension_le_one :
    ‖peterssonAntiDualExtension M‖ ≤ 1 := by
  exact LinearMap.mkContinuous_norm_le
    (peterssonAntiDualExtensionLinear M) zero_le_one fun f => by
      simpa only [one_mul] using
        peterssonAntiDualExtensionLinear_norm_le M f

/-- Core potential operator after completing its test-variable anti-dual. -/
noncomputable def peterssonCorePotentialIntoCompletion :
    PeterssonCoreSpace M →L[ℂ]
      StrongAntiDual (PeterssonHilbertCompletion M) :=
  (peterssonAntiDualExtension M).comp (peterssonCorePotentialOperator M)

theorem norm_peterssonCorePotentialIntoCompletion_le_uniformBound :
    ‖peterssonCorePotentialIntoCompletion M‖ ≤ uniformBound := by
  calc
    ‖peterssonCorePotentialIntoCompletion M‖ ≤
        ‖peterssonAntiDualExtension M‖ *
          ‖peterssonCorePotentialOperator M‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ ≤ 1 * uniformBound := by
      exact mul_le_mul
        (norm_peterssonAntiDualExtension_le_one M)
        (norm_peterssonCorePotentialOperator_le_uniformBound M)
        (norm_nonneg (peterssonCorePotentialOperator M)) zero_le_one
    _ = uniformBound := one_mul _

/-- The explicit potential form as a bounded weak anti-operator on the full
Petersson `L²` completion.  Both arguments have genuinely been completed. -/
noncomputable def peterssonPotentialOperator :
    WeakAntiOperator (PeterssonHilbertCompletion M) :=
  (peterssonCorePotentialIntoCompletion M).extend
    (peterssonCompletionEmbedding M)

/-- Exact agreement of the completed operator with the original integral on
the dense compact core. -/
@[simp]
theorem peterssonPotentialOperator_apply_core
    (u v : PeterssonCoreSpace M) :
    peterssonPotentialOperator M (PeterssonCoreSpace.toCompletion u)
        (PeterssonCoreSpace.toCompletion v) =
      potentialForm M chosenGammaTwoFundamentalDomain
        v.toSmoothCore u.toSmoothCore := by
  change
    ((peterssonCorePotentialIntoCompletion M).extend
      (peterssonCompletionEmbedding M))
        (peterssonCompletionEmbedding M u)
        (peterssonCompletionEmbedding M v) = _
  rw [ContinuousLinearMap.extend_eq _
    (peterssonCompletionEmbedding_denseRange M)
    (peterssonCompletionEmbedding_isUniformInducing M)]
  exact peterssonAntiDualExtension_apply_core M
    (peterssonCorePotentialOperator M u) v

/-- Completing the trial variable also preserves the same uniform bound. -/
theorem norm_peterssonPotentialOperator_le_uniformBound :
    ‖peterssonPotentialOperator M‖ ≤ uniformBound := by
  have hExtend := ContinuousLinearMap.opNorm_extend_le
    (f := peterssonCorePotentialIntoCompletion M)
    (e := peterssonCompletionEmbedding M)
    (N := (1 : NNReal))
    (peterssonCompletionEmbedding_denseRange M)
    (fun u => by
      rw [NNReal.coe_one, one_mul]
      change ‖u‖ ≤ ‖PeterssonCoreSpace.toCompletion u‖
      exact (PeterssonCoreSpace.norm_toCompletion u).ge)
  have hPotential :
      ‖peterssonPotentialOperator M‖ ≤
        ‖peterssonCorePotentialIntoCompletion M‖ := by
    simpa only [peterssonPotentialOperator, NNReal.coe_one, one_mul] using hExtend
  exact hPotential.trans
    (norm_peterssonCorePotentialIntoCompletion_le_uniformBound M)

/-- Pointwise two-variable continuity on the Petersson Hilbert completion. -/
theorem peterssonPotentialOperator_bound
    (u v : PeterssonHilbertCompletion M) :
    ‖peterssonPotentialOperator M u v‖ ≤
      uniformBound * ‖u‖ * ‖v‖ := by
  calc
    ‖peterssonPotentialOperator M u v‖ ≤
        ‖peterssonPotentialOperator M‖ * ‖u‖ * ‖v‖ :=
      (peterssonPotentialOperator M).le_opNorm₂ u v
    _ ≤ uniformBound * ‖u‖ * ‖v‖ := by
      gcongr
      exact norm_peterssonPotentialOperator_le_uniformBound M

/-! ##### Pullback to the actual fixed-phase graph completion

The graph norm dominates its base Petersson coordinate.  Consequently the
completed `L²` potential form pulls back continuously to the genuine
fixed-phase graph `H¹`, without invoking Rellich compactness.  Compactness is
a later and strictly stronger statement.
-/

namespace FixedPhaseGraphPotential

open HalfWeightDifferentialOperators
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion

/-- Algebraic pullback of the completed Petersson potential form along the
base coordinate of the actual fixed-phase graph completion. -/
noncomputable def graphPotentialLinear (n : ℤ) :
    GraphSobolevCompletion n →ₗ[ℂ]
      GraphSobolevCompletion n →ₗ⋆[ℂ] ℂ where
  toFun u :=
    { toFun := fun v =>
        peterssonPotentialOperator (OrbitMultiplier n)
          (baseExtension n u) (baseExtension n v)
      map_add' := fun v w => by simp
      map_smul' := fun c v => by simp }
  map_add' u w := by
    ext v
    simp
  map_smul' c u := by
    ext v
    simp

@[simp]
theorem graphPotentialLinear_apply (n : ℤ)
    (u v : GraphSobolevCompletion n) :
    graphPotentialLinear n u v =
      peterssonPotentialOperator (OrbitMultiplier n)
        (baseExtension n u) (baseExtension n v) :=
  rfl

/-- The graph pullback satisfies the same two-variable bound because the base
coordinate is contractive for the graph norm. -/
theorem graphPotentialLinear_bound (n : ℤ)
    (u v : GraphSobolevCompletion n) :
    ‖graphPotentialLinear n u v‖ ≤
      uniformBound * ‖u‖ * ‖v‖ := by
  calc
    ‖graphPotentialLinear n u v‖ ≤
        uniformBound * ‖baseExtension n u‖ * ‖baseExtension n v‖ :=
      peterssonPotentialOperator_bound (OrbitMultiplier n)
        (baseExtension n u) (baseExtension n v)
    _ ≤ uniformBound * ‖u‖ * ‖v‖ := by
      exact mul_le_mul
        (mul_le_mul_of_nonneg_left (norm_baseExtension_le n u)
          uniformBound_pos.le)
        (norm_baseExtension_le n v)
        (norm_nonneg _)
        (mul_nonneg uniformBound_pos.le (norm_nonneg u))

/-- The explicit discriminant potential as a bounded weak anti-operator on
the actual graph `H¹` completion. -/
noncomputable def graphPotentialOperator (n : ℤ) :
    WeakAntiOperator (GraphSobolevCompletion n) :=
  (graphPotentialLinear n).mkContinuous₂ uniformBound
    (graphPotentialLinear_bound n)

@[simp]
theorem graphPotentialOperator_apply (n : ℤ)
    (u v : GraphSobolevCompletion n) :
    graphPotentialOperator n u v =
      peterssonPotentialOperator (OrbitMultiplier n)
        (baseExtension n u) (baseExtension n v) :=
  rfl

/-- Exact integral formula on the dense smooth fixed-phase core. -/
theorem graphPotentialOperator_apply_core (n : ℤ)
    (u v : InverseEtaFixedPhaseCore n) :
    graphPotentialOperator n (coreMap n u) (coreMap n v) =
      potentialForm (OrbitMultiplier n) chosenGammaTwoFundamentalDomain
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v)
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) := by
  simpa only [graphPotentialOperator_apply, baseExtension_core,
    l2Coordinate_apply, coreEmbedding_toSmoothCore] using
    peterssonPotentialOperator_apply_core (OrbitMultiplier n)
      (coreEmbedding n u) (coreEmbedding n v)

/-- Operator norm of the graph-level form is controlled by the same global
potential bound. -/
theorem norm_graphPotentialOperator_le_uniformBound (n : ℤ) :
    ‖graphPotentialOperator n‖ ≤ uniformBound := by
  exact LinearMap.mkContinuous₂_norm_le
    (graphPotentialLinear n) uniformBound_pos.le
      (graphPotentialLinear_bound n)

/-- Pointwise graph-form continuity, stated directly in the norm used by the
paper's corrected `H¹` space. -/
theorem graphPotentialOperator_bound (n : ℤ)
    (u v : GraphSobolevCompletion n) :
    ‖graphPotentialOperator n u v‖ ≤
      uniformBound * ‖u‖ * ‖v‖ :=
  graphPotentialLinear_bound n u v

end FixedPhaseGraphPotential

/-- The negative part is identically zero, so its relative form bound is
exactly zero (and in particular strictly below one). -/
noncomputable def negativePart (q : GammaTwoQuotient) : ℝ :=
  max (-potential q) 0

@[simp]
theorem negativePart_eq_zero (q : GammaTwoQuotient) : negativePart q = 0 := by
  rw [negativePart, max_eq_right]
  exact neg_nonpos.mpr (potential_nonneg q)

theorem negativePartEnergy_eq_zero
    (D : GammaTwoFundamentalDomain)
    (u : SmoothCompactWeightCore M) :
    (∫ q, negativePart q * quotientNormSqDensity M u q
      ∂D.quotientMeasure) = 0 := by
  simp only [negativePart_eq_zero, zero_mul, integral_zero]

end CorePotentialForm

end ExplicitDiscriminantPotential

/-! ### An unconditional compact separable test kernel

The local Rellich theorem needed to prove compactness of multiplication by
the scalar discriminant potential is not presently available in Mathlib.
There is, however, a different explicit potential allowed by the checklist:
a compactly supported kernel-weighted potential.  The construction below is
the separable kernel

`K(q,r) = φ(q) * conj (φ(r))`.

Algebraically it is the rank-one operator `|φ><φ|`.  Its compactness is proved
by an actual factorization through the one-dimensional space `ℂ`, and its
cusp truncations are exactly constant, so the operator-norm tail is exactly
zero.  This is a nonlocal integral-kernel operator.  It is deliberately not
identified with, or used as a proof of compactness for, pointwise scalar
multiplication by `VΔ`.
-/

namespace CompactSeparableKernelPotential

open ComplexLaxMilgram FredholmBypass

section AbstractRankOne

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The positive rank-one Hilbert operator `u ↦ <φ,u> φ`. -/
noncomputable def hilbertRankOne (φ : H) : H →L[ℂ] H :=
  InnerProductSpace.rankOne ℂ φ φ

@[simp]
theorem hilbertRankOne_apply (φ u : H) :
    hilbertRankOne φ u = inner ℂ φ u • φ :=
  rfl

/-- The rank-one operator factors exactly through the scalar field. -/
theorem hilbertRankOne_eq_finiteDimensionalFactorization (φ : H) :
    hilbertRankOne φ =
      factoredLowerOrder (innerSL ℂ φ)
        (ContinuousLinearMap.toSpanSingleton ℂ φ) :=
  rfl

/-- The exact operator norm of the rank-one Hilbert operator. -/
@[simp]
theorem norm_hilbertRankOne (φ : H) :
    ‖hilbertRankOne φ‖ = ‖φ‖ ^ 2 := by
  rw [hilbertRankOne, InnerProductSpace.norm_rankOne]
  ring

/-- Its range lies in the one-dimensional span of the kernel vector. -/
theorem hilbertRankOne_range_le_span (φ : H) :
    (hilbertRankOne φ).range ≤ Submodule.span ℂ {φ} := by
  rintro _ ⟨u, rfl⟩
  change inner ℂ φ u • φ ∈ Submodule.span ℂ {φ}
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self φ)

/-- Rank one is compact, proved through the displayed finite-dimensional
factorization rather than through a compactness certificate. -/
theorem hilbertRankOne_isCompact (φ : H) :
    IsCompactOperator (hilbertRankOne φ) := by
  rw [hilbertRankOne_eq_finiteDimensionalFactorization]
  exact factoredLowerOrder_isCompact_of_finiteDimensional
    (innerSL ℂ φ) (ContinuousLinearMap.toSpanSingleton ℂ φ)

/-- Trial-first anti-dual form associated to the rank-one Hilbert operator. -/
noncomputable def rankOneForm (φ : H) : ContinuousSesquilinearForm H :=
  (innerSLFlip ℂ).comp (hilbertRankOne φ)

/-- Exact separable-kernel pairing. -/
@[simp]
theorem rankOneForm_apply (φ u v : H) :
    rankOneForm φ u v =
      inner ℂ v φ * inner ℂ φ u := by
  change inner ℂ v (InnerProductSpace.rankOne ℂ φ φ u) = _
  exact InnerProductSpace.inner_right_rankOne_apply v φ φ u

/-- The pairing is Hermitian. -/
theorem rankOneForm_conj_symm (φ u v : H) :
    star (rankOneForm φ v u) = rankOneForm φ u v := by
  rw [rankOneForm_apply, rankOneForm_apply, star_mul']
  calc
    star (inner ℂ u φ) * star (inner ℂ φ v) =
        inner ℂ φ u * inner ℂ v φ :=
      congrArg₂ (· * ·) (inner_conj_symm φ u) (inner_conj_symm v φ)
    _ = inner ℂ v φ * inner ℂ φ u := mul_comm _ _

/-- The diagonal is the squared modulus of the one scalar coefficient. -/
theorem rankOneForm_self_re (φ u : H) :
    (rankOneForm φ u u).re = ‖inner ℂ φ u‖ ^ 2 := by
  rw [rankOneForm_apply, ← inner_conj_symm, Complex.conj_mul']
  norm_cast

/-- Positivity is pointwise and unconditional. -/
theorem rankOneForm_self_nonneg (φ u : H) :
    0 ≤ (rankOneForm φ u u).re := by
  rw [rankOneForm_self_re]
  positivity

/-- Sharp two-variable estimate before taking the operator norm. -/
theorem rankOneForm_pairing_norm_le (φ u v : H) :
    ‖rankOneForm φ u v‖ ≤
      (‖φ‖ ^ 2 * ‖u‖) * ‖v‖ := by
  rw [rankOneForm_apply, norm_mul]
  calc
    ‖inner ℂ v φ‖ * ‖inner ℂ φ u‖ ≤
        (‖v‖ * ‖φ‖) * (‖φ‖ * ‖u‖) :=
      mul_le_mul (norm_inner_le_norm v φ) (norm_inner_le_norm φ u)
        (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ = (‖φ‖ ^ 2 * ‖u‖) * ‖v‖ := by ring

/-- The anti-dual form has the expected rank-one operator-norm bound. -/
theorem norm_rankOneForm_le (φ : H) :
    ‖rankOneForm φ‖ ≤ ‖φ‖ ^ 2 := by
  apply (rankOneForm φ).opNorm_le_bound (sq_nonneg ‖φ‖)
  intro u
  apply ((rankOneForm φ) u).opNorm_le_bound
    (mul_nonneg (sq_nonneg ‖φ‖) (norm_nonneg u))
  intro v
  exact rankOneForm_pairing_norm_le φ u v

/-- Compactness survives the continuous Riesz map into the anti-dual. -/
theorem rankOneForm_isCompact (φ : H) :
    IsCompactOperator (rankOneForm φ) := by
  change IsCompactOperator
    ((innerSLFlip ℂ) ∘ (hilbertRankOne φ))
  exact (hilbertRankOne_isCompact φ).clm_comp (innerSLFlip ℂ)

end AbstractRankOne

section ExactTail

variable {H : Type*}
variable [NormedAddCommGroup H] [NormedSpace ℂ H]

/-- Every already compact sesquilinear operator has a literal zero-tail
truncation: every truncation is the operator itself. -/
def constantCompactCuspTail
    (C : ContinuousSesquilinearForm H) (hC : IsCompactOperator C) :
    SesquilinearCuspTailControl C where
  truncation := fun _ => C
  truncation_isCompact := fun _ => hC
  epsilon := fun _ => 0
  epsilon_nonneg := fun _ => le_rfl
  epsilon_tendsto_zero := tendsto_const_nhds
  tail_bound := by
    intro n u v
    simp

@[simp]
theorem constantCompactCuspTail_truncation
    (C : ContinuousSesquilinearForm H) (hC : IsCompactOperator C) (n : ℕ) :
    (constantCompactCuspTail C hC).truncation n = C :=
  rfl

@[simp]
theorem constantCompactCuspTail_epsilon
    (C : ContinuousSesquilinearForm H) (hC : IsCompactOperator C) (n : ℕ) :
    (constantCompactCuspTail C hC).epsilon n = 0 :=
  rfl

@[simp]
theorem constantCompactCuspTail_tail_eq_zero
    (C : ContinuousSesquilinearForm H) (hC : IsCompactOperator C) (n : ℕ) :
    (constantCompactCuspTail C hC).truncation n - C = 0 := by
  rw [constantCompactCuspTail_truncation]
  exact sub_self C

@[simp]
theorem constantCompactCuspTail_tail_norm_eq_zero
    (C : ContinuousSesquilinearForm H) (hC : IsCompactOperator C) (n : ℕ) :
    ‖(constantCompactCuspTail C hC).truncation n - C‖ = 0 := by
  calc
    ‖(constantCompactCuspTail C hC).truncation n - C‖ = ‖(0 : ContinuousSesquilinearForm H)‖ :=
      congrArg norm (constantCompactCuspTail_tail_eq_zero C hC n)
    _ = 0 := by
      exact ContinuousLinearMap.opNorm_zero

end ExactTail

section RankOneExactTail

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The explicit rank-one cusp-tail package. -/
noncomputable def rankOneCuspTail (φ : H) :
    SesquilinearCuspTailControl (rankOneForm φ) :=
  constantCompactCuspTail (rankOneForm φ) (rankOneForm_isCompact φ)

@[simp]
theorem rankOneCuspTail_truncation (φ : H) (n : ℕ) :
    (rankOneCuspTail φ).truncation n = rankOneForm φ :=
  rfl

@[simp]
theorem rankOneCuspTail_tail_norm_eq_zero (φ : H) (n : ℕ) :
    ‖(rankOneCuspTail φ).truncation n - rankOneForm φ‖ = 0 := by
  simpa only [rankOneCuspTail] using
    constantCompactCuspTail_tail_norm_eq_zero
      (rankOneForm φ) (rankOneForm_isCompact φ) n

end RankOneExactTail

section FredholmConstructors

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Direct input to the shifted, trivial-kernel Fredholm endpoint.  The only
analytic hypotheses left are coercivity of the displayed shifted form and
triviality of the unshifted kernel; compactness is discharged here. -/
noncomputable def rankOneShiftedFredholmData
    (α : ℝ) (A : ContinuousSesquilinearForm H) (φ : H) (lam : ℝ)
    (hShift : ComplexCoerciveWith α (shiftedForm A (rankOneForm φ) lam))
    (hker : HasTrivialKernel A) :
    FredholmBypassData A :=
  shiftedFredholmData α A (rankOneForm φ) lam hShift
    (rankOneForm_isCompact φ) hker

/-- Operator-level shifted decomposition with rank-one lower order. -/
noncomputable def rankOneShiftedCompactDecomposition
    (A : H →L[ℂ] H) (S : H ≃L[ℂ] H) (φ : H) (lam : ℂ)
    (hS : S.toContinuousLinearMap = A + lam • hilbertRankOne φ) :
    ShiftedCompactDecomposition A where
  shiftedEquiv := S
  lowerOrder := lam • hilbertRankOne φ
  shifted_eq := hS
  lowerOrder_isCompact := (hilbertRankOne_isCompact φ).smul lam

/-- Direct input to the complete nontrivial-kernel Fredholm alternative.
No kernel-triviality assumption is inserted. -/
noncomputable def rankOneNontrivialKernelFredholmData
    (A : H →L[ℂ] H) (S : H ≃L[ℂ] H) (φ : H) (lam : ℂ)
    (hS : S.toContinuousLinearMap = A + lam • hilbertRankOne φ) :
    NontrivialKernelFredholmData A :=
  NontrivialKernelFredholmData.ofShiftedCompactDecomposition
    (rankOneShiftedCompactDecomposition A S φ lam hS)

end FredholmConstructors

section PulledBackKernel

variable {H G : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable [NormedAddCommGroup G] [InnerProductSpace ℂ G] [CompleteSpace G]

/-- Pull a rank-one kernel on a pivot Hilbert space back along a bounded
coordinate map.  In operator notation this is `B† |φ><φ| B`. -/
noncomputable def pulledBackHilbertKernel
    (B : H →L[ℂ] G) (φ : G) : H →L[ℂ] H :=
  (ContinuousLinearMap.adjoint B).comp ((hilbertRankOne φ).comp B)

/-- The pulled-back kernel paired into the anti-dual. -/
noncomputable def pulledBackKernelForm
    (B : H →L[ℂ] G) (φ : G) : ContinuousSesquilinearForm H :=
  (innerSLFlip ℂ).comp (pulledBackHilbertKernel B φ)

/-- Exact kernel formula after pullback. -/
@[simp]
theorem pulledBackKernelForm_apply
    (B : H →L[ℂ] G) (φ : G) (u v : H) :
    pulledBackKernelForm B φ u v =
      inner ℂ (B v) φ * inner ℂ φ (B u) := by
  change inner ℂ v
      (ContinuousLinearMap.adjoint B
        (InnerProductSpace.rankOne ℂ φ φ (B u))) = _
  rw [ContinuousLinearMap.adjoint_inner_right]
  exact InnerProductSpace.inner_right_rankOne_apply (B v) φ φ (B u)

/-- The pulled-back kernel remains Hermitian. -/
theorem pulledBackKernelForm_conj_symm
    (B : H →L[ℂ] G) (φ : G) (u v : H) :
    star (pulledBackKernelForm B φ v u) =
      pulledBackKernelForm B φ u v := by
  rw [pulledBackKernelForm_apply, pulledBackKernelForm_apply, star_mul']
  calc
    star (inner ℂ (B u) φ) * star (inner ℂ φ (B v)) =
        inner ℂ φ (B u) * inner ℂ (B v) φ :=
      congrArg₂ (· * ·)
        (inner_conj_symm φ (B u)) (inner_conj_symm (B v) φ)
    _ = inner ℂ (B v) φ * inner ℂ φ (B u) := mul_comm _ _

/-- Its diagonal is positive, with the exact scalar square. -/
theorem pulledBackKernelForm_self_re
    (B : H →L[ℂ] G) (φ : G) (u : H) :
    (pulledBackKernelForm B φ u u).re =
      ‖inner ℂ φ (B u)‖ ^ 2 := by
  rw [pulledBackKernelForm_apply, ← inner_conj_symm,
    Complex.conj_mul']
  norm_cast

theorem pulledBackKernelForm_self_nonneg
    (B : H →L[ℂ] G) (φ : G) (u : H) :
    0 ≤ (pulledBackKernelForm B φ u u).re := by
  rw [pulledBackKernelForm_self_re]
  positivity

/-- Explicit norm bound for the pulled-back Hilbert operator. -/
theorem norm_pulledBackHilbertKernel_le
    (B : H →L[ℂ] G) (φ : G) :
    ‖pulledBackHilbertKernel B φ‖ ≤ ‖B‖ ^ 2 * ‖φ‖ ^ 2 := by
  unfold pulledBackHilbertKernel
  calc
    ‖(ContinuousLinearMap.adjoint B).comp
        ((hilbertRankOne φ).comp B)‖ ≤
        ‖ContinuousLinearMap.adjoint B‖ *
          ‖(hilbertRankOne φ).comp B‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ ≤ ‖ContinuousLinearMap.adjoint B‖ *
        (‖hilbertRankOne φ‖ * ‖B‖) :=
      mul_le_mul_of_nonneg_left
        (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
    _ = ‖B‖ ^ 2 * ‖φ‖ ^ 2 := by
      rw [LinearIsometryEquiv.norm_map, norm_hilbertRankOne]
      ring

/-- Compactness is preserved under both bounded coordinate maps. -/
theorem pulledBackHilbertKernel_isCompact
    (B : H →L[ℂ] G) (φ : G) :
    IsCompactOperator (pulledBackHilbertKernel B φ) := by
  change IsCompactOperator
    ((ContinuousLinearMap.adjoint B) ∘
      ((hilbertRankOne φ) ∘ B))
  exact ((hilbertRankOne_isCompact φ).comp_clm B).clm_comp
    (ContinuousLinearMap.adjoint B)

/-- The associated anti-dual operator is compact as well. -/
theorem pulledBackKernelForm_isCompact
    (B : H →L[ℂ] G) (φ : G) :
    IsCompactOperator (pulledBackKernelForm B φ) := by
  change IsCompactOperator
    ((innerSLFlip ℂ) ∘ (pulledBackHilbertKernel B φ))
  exact (pulledBackHilbertKernel_isCompact B φ).clm_comp
    (innerSLFlip ℂ)

/-- Its truncations can again be chosen literally constant, with exact zero
operator-norm tail. -/
noncomputable def pulledBackKernelCuspTail
    (B : H →L[ℂ] G) (φ : G) :
    SesquilinearCuspTailControl (pulledBackKernelForm B φ) :=
  constantCompactCuspTail (pulledBackKernelForm B φ)
    (pulledBackKernelForm_isCompact B φ)

@[simp]
theorem pulledBackKernelCuspTail_tail_norm_eq_zero
    (B : H →L[ℂ] G) (φ : G) (n : ℕ) :
    ‖(pulledBackKernelCuspTail B φ).truncation n -
        pulledBackKernelForm B φ‖ = 0 := by
  simpa only [pulledBackKernelCuspTail] using
    constantCompactCuspTail_tail_norm_eq_zero
      (pulledBackKernelForm B φ) (pulledBackKernelForm_isCompact B φ) n

end PulledBackKernel

/-! #### A concrete nonzero compactly supported kernel vector

The discriminant cutoff constructed above gives an actual nonzero smooth
quotient-compact inverse-eta section.  Embedding that section into its
Petersson completion produces a concrete nonzero vector, hence a genuinely
nonzero rank-one kernel rather than only a family parameterized by a vector.
-/

section ExplicitNonzeroKernel

open ExplicitDiscriminantPotential
open HalfIntegralMultiplier
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace

abbrev ExplicitKernelHilbert :=
  PeterssonHilbertCompletion inverseEtaPaperCertificate.multiplier

/-- The quotient-compact inverse-eta bump in the norm-carrying Petersson
core. -/
noncomputable def explicitKernelPeterssonCore :
    PeterssonCoreSpace inverseEtaPaperCertificate.multiplier :=
  ofSmoothCore compactInverseEtaWeightCore

/-- Its canonical vector in the Petersson Hilbert completion. -/
noncomputable def explicitKernelVector : ExplicitKernelHilbert :=
  toCompletion explicitKernelPeterssonCore

/-- The kernel vector is genuinely nonzero. -/
theorem explicitKernelVector_ne_zero : explicitKernelVector ≠ 0 := by
  intro hZero
  have hCore : explicitKernelPeterssonCore = 0 := by
    apply toCompletion_injective
    simpa only [explicitKernelVector, map_zero] using hZero
  apply compactInverseEtaWeightCore_ne_zero
  have hSmooth := congrArg
    (fun u : PeterssonCoreSpace
        inverseEtaPaperCertificate.multiplier => u.toSmoothCore) hCore
  simpa only [explicitKernelPeterssonCore, toSmoothCore_ofSmoothCore,
    toSmoothCore_zero] using hSmooth

/-- A fully specified nonzero compact separable-kernel potential. -/
noncomputable def explicitCompactKernelForm :
    ContinuousSesquilinearForm ExplicitKernelHilbert :=
  rankOneForm explicitKernelVector

theorem explicitCompactKernelForm_ne_zero :
    explicitCompactKernelForm ≠ 0 := by
  intro hZero
  have hEval :
      explicitCompactKernelForm explicitKernelVector explicitKernelVector = 0 := by
    rw [hZero]
    simp
  rw [explicitCompactKernelForm, rankOneForm_apply] at hEval
  have hInner : inner ℂ explicitKernelVector explicitKernelVector ≠ 0 :=
    inner_self_ne_zero.mpr explicitKernelVector_ne_zero
  exact (mul_ne_zero hInner hInner) hEval

theorem explicitCompactKernelForm_conj_symm
    (u v : ExplicitKernelHilbert) :
    star (explicitCompactKernelForm v u) =
      explicitCompactKernelForm u v :=
  rankOneForm_conj_symm explicitKernelVector u v

theorem explicitCompactKernelForm_self_nonneg
    (u : ExplicitKernelHilbert) :
    0 ≤ (explicitCompactKernelForm u u).re :=
  rankOneForm_self_nonneg explicitKernelVector u

theorem explicitCompactKernelForm_isCompact :
    IsCompactOperator explicitCompactKernelForm :=
  rankOneForm_isCompact explicitKernelVector

noncomputable def explicitCompactKernelCuspTail :
    SesquilinearCuspTailControl explicitCompactKernelForm :=
  constantCompactCuspTail explicitCompactKernelForm
    explicitCompactKernelForm_isCompact

@[simp]
theorem explicitCompactKernelCuspTail_tail_norm_eq_zero (Y : ℕ) :
    ‖explicitCompactKernelCuspTail.truncation Y -
        explicitCompactKernelForm‖ = 0 := by
  simpa only [explicitCompactKernelCuspTail] using
    constantCompactCuspTail_tail_norm_eq_zero explicitCompactKernelForm
      explicitCompactKernelForm_isCompact Y

/-! #### A completely explicit unshifted Fredholm model

Normalize the discriminant-cutoff vector and let `P = |ψ><ψ|`.  Since `ψ`
has norm one, `P` is the orthogonal rank-one projection onto `ℂ ψ`.  The
unshifted operator `A = I - P` then has a genuinely nontrivial kernel, while
the shifted operator `S = I` satisfies the literal identity `S = A + P`.
Thus every datum required by the general nontrivial-kernel Fredholm
alternative is constructed here rather than supplied as a hypothesis.
-/

/-- The discriminant-cutoff kernel vector normalized to unit norm. -/
noncomputable def explicitKernelUnitVector : ExplicitKernelHilbert :=
  (‖explicitKernelVector‖⁻¹ : ℂ) • explicitKernelVector

@[simp]
theorem explicitKernelUnitVector_norm : ‖explicitKernelUnitVector‖ = 1 := by
  exact norm_smul_inv_norm explicitKernelVector_ne_zero

theorem explicitKernelUnitVector_ne_zero : explicitKernelUnitVector ≠ 0 := by
  apply norm_ne_zero_iff.mp
  rw [explicitKernelUnitVector_norm]
  exact one_ne_zero

/-- The orthogonal rank-one projection `P = |ψ><ψ|`. -/
noncomputable def explicitKernelProjection :
    ExplicitKernelHilbert →L[ℂ] ExplicitKernelHilbert :=
  hilbertRankOne explicitKernelUnitVector

@[simp]
theorem explicitKernelProjection_apply (u : ExplicitKernelHilbert) :
    explicitKernelProjection u =
      inner ℂ explicitKernelUnitVector u • explicitKernelUnitVector :=
  rfl

/-- Unit normalization makes the rank-one operator fix its generator. -/
@[simp]
theorem explicitKernelProjection_unitVector :
    explicitKernelProjection explicitKernelUnitVector =
      explicitKernelUnitVector := by
  rw [explicitKernelProjection_apply,
    inner_self_eq_one_of_norm_eq_one explicitKernelUnitVector_norm, one_smul]

/-- `P` is idempotent, so it is genuinely a projection rather than merely a
compact rank-one endomorphism. -/
theorem explicitKernelProjection_idempotent :
    explicitKernelProjection.comp explicitKernelProjection =
      explicitKernelProjection := by
  ext u
  simp only [ContinuousLinearMap.comp_apply,
    explicitKernelProjection_apply, inner_smul_right,
    inner_self_eq_one_of_norm_eq_one explicitKernelUnitVector_norm,
    mul_one]

/-- The concrete projection is compact by its actual one-dimensional
factorization. -/
theorem explicitKernelProjection_isCompact :
    IsCompactOperator explicitKernelProjection :=
  hilbertRankOne_isCompact explicitKernelUnitVector

/-- The orthogonal rank-one projection is self-adjoint. -/
theorem explicitKernelProjection_adjoint :
    ContinuousLinearMap.adjoint explicitKernelProjection =
      explicitKernelProjection := by
  simp only [explicitKernelProjection, hilbertRankOne,
    InnerProductSpace.adjoint_rankOne]

/-- The unshifted operator in the explicit model: `A = I - P`. -/
noncomputable def explicitUnshiftedFredholmOperator :
    ExplicitKernelHilbert →L[ℂ] ExplicitKernelHilbert :=
  ContinuousLinearMap.id ℂ ExplicitKernelHilbert - explicitKernelProjection

@[simp]
theorem explicitUnshiftedFredholmOperator_apply
    (u : ExplicitKernelHilbert) :
    explicitUnshiftedFredholmOperator u =
      u - explicitKernelProjection u := by
  simp only [explicitUnshiftedFredholmOperator,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply]

/-- The shifted operator is the identity continuous equivalence. -/
noncomputable def explicitShiftedFredholmEquiv :
    ExplicitKernelHilbert ≃L[ℂ] ExplicitKernelHilbert :=
  ContinuousLinearEquiv.refl ℂ ExplicitKernelHilbert

/-- The shift identity is exact: `S = A + P`. -/
theorem explicitShifted_eq_unshifted_add_projection :
    explicitShiftedFredholmEquiv.toContinuousLinearMap =
      explicitUnshiftedFredholmOperator + explicitKernelProjection := by
  ext u
  change u = (u - explicitKernelProjection u) + explicitKernelProjection u
  exact (sub_add_cancel u (explicitKernelProjection u)).symm

/-- Hypothesis-free nontrivial-kernel Fredholm data on the actual
discriminant-cutoff Petersson Hilbert space. -/
noncomputable def explicitUnshiftedFredholmData :
    NontrivialKernelFredholmData explicitUnshiftedFredholmOperator := by
  refine rankOneNontrivialKernelFredholmData
    explicitUnshiftedFredholmOperator explicitShiftedFredholmEquiv
      explicitKernelUnitVector 1 ?_
  simpa only [one_smul, explicitKernelProjection] using
    explicitShifted_eq_unshifted_add_projection

/-- The normalized discriminant-cutoff vector is an explicit homogeneous
solution of the unshifted equation. -/
@[simp]
theorem explicitUnshiftedFredholmOperator_unitVector :
    explicitUnshiftedFredholmOperator explicitKernelUnitVector = 0 := by
  rw [explicitUnshiftedFredholmOperator_apply,
    explicitKernelProjection_unitVector, sub_self]

/-- In particular the unshifted kernel is genuinely nontrivial. -/
theorem explicitUnshiftedFredholmOperator_has_nonzero_kernel :
    ∃ u : ExplicitKernelHilbert,
      u ≠ 0 ∧ explicitUnshiftedFredholmOperator u = 0 :=
  ⟨explicitKernelUnitVector, explicitKernelUnitVector_ne_zero,
    explicitUnshiftedFredholmOperator_unitVector⟩

/-- Exact kernel identification: `ker(I-P) = ℂ ψ`. -/
theorem explicitUnshiftedFredholmOperator_ker :
    explicitUnshiftedFredholmOperator.ker =
      Submodule.span ℂ {explicitKernelUnitVector} := by
  apply le_antisymm
  · intro u hu
    change explicitUnshiftedFredholmOperator u = 0 at hu
    rw [explicitUnshiftedFredholmOperator_apply,
      explicitKernelProjection_apply] at hu
    have huEq : u =
        inner ℂ explicitKernelUnitVector u • explicitKernelUnitVector :=
      sub_eq_zero.mp hu
    rw [huEq]
    exact Submodule.smul_mem _ _
      (Submodule.mem_span_singleton_self explicitKernelUnitVector)
  · apply Submodule.span_le.mpr
    intro u hu
    rw [Set.mem_singleton_iff] at hu
    subst u
    exact explicitUnshiftedFredholmOperator_unitVector

theorem explicitUnshiftedFredholmOperator_ker_ne_bot :
    explicitUnshiftedFredholmOperator.ker ≠ ⊥ := by
  rw [explicitUnshiftedFredholmOperator_ker]
  intro hbot
  apply explicitKernelUnitVector_ne_zero
  have hmem : explicitKernelUnitVector ∈
      (⊥ : Submodule ℂ ExplicitKernelHilbert) := by
    rw [← hbot]
    exact Submodule.mem_span_singleton_self explicitKernelUnitVector
  simpa using hmem

/-- The unshifted operator is self-adjoint. -/
theorem explicitUnshiftedFredholmOperator_adjoint :
    ContinuousLinearMap.adjoint explicitUnshiftedFredholmOperator =
      explicitUnshiftedFredholmOperator := by
  simp only [explicitUnshiftedFredholmOperator, map_sub,
    ContinuousLinearMap.adjoint_id, explicitKernelProjection_adjoint]

/-- Closed range is now a theorem for this concrete `A`, not a structure
field or an assumed analytic certificate. -/
theorem explicitUnshiftedFredholmOperator_range_isClosed :
    IsClosed (explicitUnshiftedFredholmOperator.range :
      Set ExplicitKernelHilbert) :=
  explicitUnshiftedFredholmData.range_isClosed

/-- The exact range is the orthogonal complement of the normalized kernel
vector. -/
theorem explicitUnshiftedFredholmOperator_range :
    explicitUnshiftedFredholmOperator.range =
      (Submodule.span ℂ {explicitKernelUnitVector})ᗮ := by
  calc
    explicitUnshiftedFredholmOperator.range =
        (ContinuousLinearMap.adjoint
          explicitUnshiftedFredholmOperator).kerᗮ :=
      explicitUnshiftedFredholmData.range_eq_orthogonal_adjointKernel
    _ = (Submodule.span ℂ {explicitKernelUnitVector})ᗮ := by
      rw [explicitUnshiftedFredholmOperator_adjoint,
        explicitUnshiftedFredholmOperator_ker]

/-- Concrete action on a vector orthogonal to `ψ`. -/
theorem explicitUnshiftedFredholmOperator_eq_self_of_inner_eq_zero
    (f : ExplicitKernelHilbert)
    (hf : inner ℂ explicitKernelUnitVector f = 0) :
    explicitUnshiftedFredholmOperator f = f := by
  rw [explicitUnshiftedFredholmOperator_apply,
    explicitKernelProjection_apply, hf, zero_smul, sub_zero]

/-- The Fredholm compatibility condition becomes the single explicit scalar
orthogonality equation `<ψ,f> = 0`. -/
theorem explicitUnshiftedFredholm_solvable_iff
    (f : ExplicitKernelHilbert) :
    (∃ u : ExplicitKernelHilbert,
        explicitUnshiftedFredholmOperator u = f) ↔
      inner ℂ explicitKernelUnitVector f = 0 := by
  rw [explicitUnshiftedFredholmData.solvable_iff_mem_orthogonal_adjointKernel,
    explicitUnshiftedFredholmOperator_adjoint,
    explicitUnshiftedFredholmOperator_ker,
    Submodule.mem_orthogonal_singleton_iff_inner_right]

/-- A compatible forcing term packaged in the actual range, using the
explicit solution `u=f`. -/
noncomputable def explicitCompatibleForcing
    (f : ExplicitKernelHilbert)
    (hf : inner ℂ explicitKernelUnitVector f = 0) :
    explicitUnshiftedFredholmOperator.range :=
  ⟨f, ⟨f,
    explicitUnshiftedFredholmOperator_eq_self_of_inner_eq_zero f hf⟩⟩

/-- For compatible forcing, the canonical kernel-orthogonal Fredholm
solution is literally the forcing vector itself. -/
theorem explicitCanonicalSolution_eq
    (f : ExplicitKernelHilbert)
    (hf : inner ℂ explicitKernelUnitVector f = 0) :
    explicitUnshiftedFredholmData.canonicalSolution
        (explicitCompatibleForcing f hf) = f := by
  symm
  apply explicitUnshiftedFredholmData.canonicalSolution_unique
  · exact explicitUnshiftedFredholmOperator_eq_self_of_inner_eq_zero f hf
  · rw [explicitUnshiftedFredholmOperator_ker,
      Submodule.mem_orthogonal_singleton_iff_inner_right]
    exact hf

/-- Every element of the actual range satisfies the single scalar Fredholm
compatibility condition. -/
theorem explicitRange_inner_eq_zero
    (f : explicitUnshiftedFredholmOperator.range) :
    inner ℂ explicitKernelUnitVector (f : ExplicitKernelHilbert) = 0 := by
  have hf : (f : ExplicitKernelHilbert) ∈
      (ℂ ∙ explicitKernelUnitVector)ᗮ := by
    simpa only [explicitUnshiftedFredholmOperator_range] using f.property
  exact Submodule.mem_orthogonal_singleton_iff_inner_right.mp hf

/-- On the compatible range, the canonical kernel-orthogonal solution is the
underlying forcing vector itself.  This formulation applies to an arbitrary
range subtype, not only to `explicitCompatibleForcing`. -/
@[simp]
theorem explicitCanonicalSolution_range_eq
    (f : explicitUnshiftedFredholmOperator.range) :
    explicitUnshiftedFredholmData.canonicalSolution f =
      (f : ExplicitKernelHilbert) := by
  symm
  apply explicitUnshiftedFredholmData.canonicalSolution_unique
  · exact explicitUnshiftedFredholmOperator_eq_self_of_inner_eq_zero
      (f : ExplicitKernelHilbert) (explicitRange_inner_eq_zero f)
  · rw [explicitUnshiftedFredholmOperator_ker,
      Submodule.mem_orthogonal_singleton_iff_inner_right]
    exact explicitRange_inner_eq_zero f

/-- The concrete reduced inverse is contractive.  Equality is deliberately
not asserted, since it would additionally require the orthogonal complement
of the rank-one kernel to contain a nonzero vector. -/
theorem explicitCanonicalInverseNorm_le_one :
    explicitUnshiftedFredholmData.canonicalInverseNorm ≤ 1 := by
  change ‖explicitUnshiftedFredholmData.canonicalSolutionOperator‖ ≤ 1
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro f
  change ‖explicitUnshiftedFredholmData.canonicalSolution f‖ ≤ 1 * ‖f‖
  rw [explicitCanonicalSolution_range_eq, one_mul]
  exact le_rfl

end ExplicitNonzeroKernel

/-! #### Specialization to the fixed-phase graph completion

The pivot coordinate below is the completed Petersson `L²` coordinate.  If
`φ` is obtained from `l2Coordinate n φ₀` with `φ₀` in the smooth
quotient-compact core, the abstract formula is the completion of the genuine
separable quotient kernel `φ(q) * conj (φ(r))`.  Compactness is rank-one and
therefore does not invoke a nonexistent global Rellich theorem.
-/

namespace FixedPhaseGraphKernel

open HalfWeightDifferentialOperators
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion

/-- Rank-one kernel on the graph space pulled back from its base Petersson
coordinate. -/
noncomputable def graphBaseHilbertKernel
    (n : ℤ) (φ : OrbitPeterssonHilbert n) :
    GraphSobolevCompletion n →L[ℂ] GraphSobolevCompletion n :=
  pulledBackHilbertKernel (baseExtension n) φ

/-- Anti-dual graph-space form of the same kernel. -/
noncomputable def graphBaseKernelForm
    (n : ℤ) (φ : OrbitPeterssonHilbert n) :
    ContinuousSesquilinearForm (GraphSobolevCompletion n) :=
  pulledBackKernelForm (baseExtension n) φ

@[simp]
theorem graphBaseKernelForm_apply
    (n : ℤ) (φ : OrbitPeterssonHilbert n)
    (u v : GraphSobolevCompletion n) :
    graphBaseKernelForm n φ u v =
      inner ℂ (baseExtension n v) φ *
        inner ℂ φ (baseExtension n u) :=
  pulledBackKernelForm_apply (baseExtension n) φ u v

theorem graphBaseKernelForm_conj_symm
    (n : ℤ) (φ : OrbitPeterssonHilbert n)
    (u v : GraphSobolevCompletion n) :
    star (graphBaseKernelForm n φ v u) =
      graphBaseKernelForm n φ u v :=
  pulledBackKernelForm_conj_symm (baseExtension n) φ u v

theorem graphBaseKernelForm_self_nonneg
    (n : ℤ) (φ : OrbitPeterssonHilbert n)
    (u : GraphSobolevCompletion n) :
    0 ≤ (graphBaseKernelForm n φ u u).re :=
  pulledBackKernelForm_self_nonneg (baseExtension n) φ u

/-- Unconditional finite-rank compactness on the completed graph space. -/
theorem graphBaseKernelForm_isCompact
    (n : ℤ) (φ : OrbitPeterssonHilbert n) :
    IsCompactOperator (graphBaseKernelForm n φ) :=
  pulledBackKernelForm_isCompact (baseExtension n) φ

/-- Literal constant truncations and zero tail for the graph kernel. -/
noncomputable def graphBaseKernelCuspTail
    (n : ℤ) (φ : OrbitPeterssonHilbert n) :
    SesquilinearCuspTailControl (graphBaseKernelForm n φ) :=
  constantCompactCuspTail (graphBaseKernelForm n φ)
    (graphBaseKernelForm_isCompact n φ)

@[simp]
theorem graphBaseKernelCuspTail_tail_norm_eq_zero
    (n : ℤ) (φ : OrbitPeterssonHilbert n) (Y : ℕ) :
    ‖(graphBaseKernelCuspTail n φ).truncation Y -
        graphBaseKernelForm n φ‖ = 0 := by
  simpa only [graphBaseKernelCuspTail] using
    constantCompactCuspTail_tail_norm_eq_zero
      (graphBaseKernelForm n φ) (graphBaseKernelForm_isCompact n φ) Y

/-- Use an actual smooth quotient-compact core vector as the kernel vector. -/
noncomputable def compactCoreKernelVector
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n) :
    OrbitPeterssonHilbert n :=
  l2Coordinate n φ₀

/-- The compact-core-generated separable kernel form.  No nonzero assertion
is built into this definition; nontriviality follows separately from a
nonzero core vector and injectivity of `l2Coordinate`. -/
noncomputable def compactCoreKernelForm
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n) :
    ContinuousSesquilinearForm (GraphSobolevCompletion n) :=
  graphBaseKernelForm n (compactCoreKernelVector n φ₀)

/-- On the dense graph core the completed form is exactly the separable
Petersson-coordinate kernel. -/
@[simp]
theorem compactCoreKernelForm_core_apply
    (n : ℤ) (φ₀ u v : InverseEtaFixedPhaseCore n) :
    compactCoreKernelForm n φ₀ (coreMap n u) (coreMap n v) =
      inner ℂ (l2Coordinate n v) (l2Coordinate n φ₀) *
        inner ℂ (l2Coordinate n φ₀) (l2Coordinate n u) := by
  rw [compactCoreKernelForm, graphBaseKernelForm_apply,
    baseExtension_core, baseExtension_core]
  rfl

theorem compactCoreKernelForm_isCompact
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n) :
    IsCompactOperator (compactCoreKernelForm n φ₀) :=
  graphBaseKernelForm_isCompact n (compactCoreKernelVector n φ₀)

noncomputable def compactCoreKernelCuspTail
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n) :
    SesquilinearCuspTailControl (compactCoreKernelForm n φ₀) :=
  constantCompactCuspTail (compactCoreKernelForm n φ₀)
    (compactCoreKernelForm_isCompact n φ₀)

@[simp]
theorem compactCoreKernelCuspTail_tail_norm_eq_zero
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n) (Y : ℕ) :
    ‖(compactCoreKernelCuspTail n φ₀).truncation Y -
        compactCoreKernelForm n φ₀‖ = 0 := by
  simpa only [compactCoreKernelCuspTail] using
    constantCompactCuspTail_tail_norm_eq_zero
      (compactCoreKernelForm n φ₀) (compactCoreKernelForm_isCompact n φ₀) Y

/-- The compact-core kernel directly discharges the compactness hypothesis
of the shifted trivial-kernel Fredholm constructor. -/
noncomputable def compactCoreKernelShiftedFredholmData
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n)
    (α : ℝ)
    (A : ContinuousSesquilinearForm (GraphSobolevCompletion n)) (lam : ℝ)
    (hShift : ComplexCoerciveWith α
      (shiftedForm A (compactCoreKernelForm n φ₀) lam))
    (hker : HasTrivialKernel A) :
    FredholmBypassData A :=
  shiftedFredholmData α A (compactCoreKernelForm n φ₀) lam hShift
    (compactCoreKernelForm_isCompact n φ₀) hker

/-- Operator-level compact-core kernel data for the full Fredholm alternative
with a possibly nontrivial kernel. -/
noncomputable def compactCoreKernelNontrivialFredholmData
    (n : ℤ) (φ₀ : InverseEtaFixedPhaseCore n)
    (A : GraphSobolevCompletion n →L[ℂ] GraphSobolevCompletion n)
    (S : GraphSobolevCompletion n ≃L[ℂ] GraphSobolevCompletion n)
    (lam : ℂ)
    (hS : S.toContinuousLinearMap =
      A + lam • graphBaseHilbertKernel n (compactCoreKernelVector n φ₀)) :
    NontrivialKernelFredholmData A :=
  NontrivialKernelFredholmData.ofShiftedCompactDecomposition
    { shiftedEquiv := S
      lowerOrder :=
        lam • graphBaseHilbertKernel n (compactCoreKernelVector n φ₀)
      shifted_eq := hS
      lowerOrder_isCompact :=
        (pulledBackHilbertKernel_isCompact (baseExtension n)
          (compactCoreKernelVector n φ₀)).smul lam }

end FixedPhaseGraphKernel

end CompactSeparableKernelPotential

end AutomorphicSobolev

end PaperCorrections

/-! ### Geometric support of the explicit cutoff factor

The finite-rank proof above is already an unconditional compactness proof.
The lemmas in this namespace record the separate scalar cutoff factor used in
the concrete kernel vector.  On the quotient, its two-variable separable
kernel has compact support in `π(F_Y) × π(F_Y)`, and its tail is pointwise
exactly zero as soon as either variable leaves that image stage.  No equality
between this scalar factor and the full Hilbert-space operator kernel is
asserted here.
-/

namespace PaperCorrections.AutomorphicSobolev.CompactSeparableKernelPotential

namespace GeometricKernelSupport

open GammaTwoQuotientGeometry
open ExplicitDiscriminantPotential

/-- The scalar separable kernel attached to the explicit invariant cutoff. -/
noncomputable def explicitQuotientKernel
    (p : GammaTwoQuotient × GammaTwoQuotient) : ℂ :=
  quotientCoreCutoff p.1 * star (quotientCoreCutoff p.2)

theorem explicitQuotientKernel_continuous :
    Continuous explicitQuotientKernel := by
  exact
    (quotientCoreCutoff_continuous.comp continuous_fst).mul
      (Complex.continuous_conj.comp
        (quotientCoreCutoff_continuous.comp continuous_snd))

/-- The geometric kernel is genuinely nonzero at the pair represented by
`(i,i)`. -/
theorem explicitQuotientKernel_at_I_ne_zero :
    explicitQuotientKernel
      (gammaTwoQuotientMk UpperHalfPlane.I,
        gammaTwoQuotientMk UpperHalfPlane.I) ≠ 0 := by
  rw [explicitQuotientKernel, quotientCoreCutoff_mk]
  apply mul_ne_zero upstairsCoreCutoff_apply_I_ne_zero
  intro hConj
  apply upstairsCoreCutoff_apply_I_ne_zero
  have := congrArg star hConj
  simpa using this

/-- Both quotient variables lie in the image of one and the same literal
cusp-height truncation. -/
theorem explicitQuotientKernel_support_subset_truncationProduct :
    ∃ Y : ℝ, 1 ≤ Y ∧
      Function.support explicitQuotientKernel ⊆
        (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) ×ˢ
          (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) := by
  obtain ⟨Y, hY, hCutoff⟩ :=
    quotientCoreCutoff_support_subset_compactTruncation
  refine ⟨Y, hY, ?_⟩
  rintro ⟨q, r⟩ hKernel
  have hq : quotientCoreCutoff q ≠ 0 := by
    intro hZero
    apply hKernel
    simp [explicitQuotientKernel, hZero]
  have hr : quotientCoreCutoff r ≠ 0 := by
    intro hZero
    apply hKernel
    simp [explicitQuotientKernel, hZero]
  exact ⟨hCutoff hq, hCutoff hr⟩

/-- The actual two-variable kernel has compact topological support. -/
theorem explicitQuotientKernel_hasCompactSupport :
    HasCompactSupport explicitQuotientKernel := by
  change IsCompact (closure (Function.support explicitQuotientKernel))
  obtain ⟨Y, _hY, hSupport⟩ :=
    explicitQuotientKernel_support_subset_truncationProduct
  have hStage : IsCompact
      (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) :=
    (gammaTwoThreeCuspTruncation_isCompact Y).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous
  have hProduct : IsCompact
      ((gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) ×ˢ
        (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y)) :=
    hStage.prod hStage
  exact hProduct.of_isClosed_subset isClosed_closure
    (closure_minimal hSupport hProduct.isClosed)

/-- Exact pointwise zero tail: outside the geometric product stage in either
variable, no estimate or limiting argument is needed. -/
theorem explicitQuotientKernel_eq_zero_outside_truncationProduct :
    ∃ Y : ℝ, 1 ≤ Y ∧ ∀ q r : GammaTwoQuotient,
      q ∉ gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y ∨
        r ∉ gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y →
      explicitQuotientKernel (q, r) = 0 := by
  obtain ⟨Y, hY, hCutoff⟩ :=
    quotientCoreCutoff_support_subset_compactTruncation
  refine ⟨Y, hY, ?_⟩
  intro q r hOutside
  rcases hOutside with hq | hr
  · have hqZero : quotientCoreCutoff q = 0 := by
      by_contra hqNe
      exact hq (hCutoff hqNe)
    simp [explicitQuotientKernel, hqZero]
  · have hrZero : quotientCoreCutoff r = 0 := by
      by_contra hrNe
      exact hr (hCutoff hrNe)
    simp [explicitQuotientKernel, hrZero]

end GeometricKernelSupport

end PaperCorrections.AutomorphicSobolev.CompactSeparableKernelPotential

/-! ### Fixed-phase smooth-core and Petersson-density bridge

The all-word predicate defining `InverseEtaFixedPhaseCore n` is not a smaller
test space.  The proved one-step covariance theorem implies that it is exactly
the smooth quotient-compact core for the orbit multiplier at index `n`.  The
inverse below is built from the actual section covariance, smoothness, and
quotient-compact support; no completion-density field or nonzero seed is used.

Consequently the fixed-phase `L²` coordinate contains the whole Petersson
smooth core before completion.  Its dense range in the Petersson completion is
therefore a genuine comparison theorem, rather than the tautological density
of the graph-core map in the graph completion.
-/

namespace PaperCorrections.AutomorphicSobolev.FixedPhaseDensity

open GammaTwoQuotientGeometry SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators
open DefinitionOneSobolev
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion

/- `InverseEtaFixedPhaseCore` is an opaque abbreviation of a `Submodule`
subtype. Keep one canonical additive/module instance family for every orbit
index so subtraction of core-valued linear maps and finite-sum APIs elaborate
coherently throughout the density section. -/
noncomputable local instance fixedPhaseDensityCoreModule (n : ℤ) :
    Module ℂ (InverseEtaFixedPhaseCore n) := by
  change Module ℂ ↥(inverseEtaFixedPhaseStableCoreSubmodule n)
  exact Submodule.module (inverseEtaFixedPhaseStableCoreSubmodule n)

noncomputable local instance fixedPhaseDensityCoreAddCommGroup (n : ℤ) :
    AddCommGroup (InverseEtaFixedPhaseCore n) := by
  exact Module.addCommMonoidToAddCommGroup ℂ

/-- Forget the bundled covariance of a smooth compact weight section while
retaining its actual function, real smoothness, and quotient-compact support. -/
noncomputable def rawOfSmoothCompactWeightCore (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) :
    SmoothQuotientCompactFunction :=
  ⟨⟨(SmoothCompactWeightCore.toSection u : ℍ → ℂ),
      SmoothCompactWeightCore.realSmooth u⟩,
    SmoothCompactWeightCore.quotientCompact u⟩

@[simp]
theorem rawOfSmoothCompactWeightCore_apply (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) (z : ℍ) :
    (rawOfSmoothCompactWeightCore n u : ℍ → ℂ) z =
      SmoothCompactWeightCore.toSection u z :=
  rfl

/-- The forgotten raw function has precisely the fixed-phase covariance at
the same orbit index. -/
theorem rawOfSmoothCompactWeightCore_covariant (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) :
    IsInverseEtaPaperOrbitCovariant n
      (rawOfSmoothCompactWeightCore n u) := by
  intro γ z
  have hCov := SmoothCompactWeightCore.covariance u γ z
  rw [← GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul] at hCov
  rw [show
    GammaTwoQuotientGeometry.gammaTwoToSL2Real γ • z =
      Matrix.SpecialLinearGroup.toGL
        (GammaTwoQuotientGeometry.gammaTwoToSL2Real γ) • z by rfl] at hCov
  simpa [rawOfSmoothCompactWeightCore,
    IsInverseEtaPaperOrbitCovariant, OrbitMultiplier,
    GammaTwoQuotientGeometry.gammaTwoToSL2Real] using hCov

/-- Every smooth quotient-compact covariant section belongs to the all-word
stable core.  Stability is deduced from covariance through the proved finite
word induction. -/
noncomputable def ofSmoothCompactWeightCore (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) :
    InverseEtaFixedPhaseCore n :=
  ⟨rawOfSmoothCompactWeightCore n u,
    (mem_inverseEtaFixedPhaseStableCoreSubmodule_iff n
      (rawOfSmoothCompactWeightCore n u)).2
        (rawOfSmoothCompactWeightCore_covariant n u)⟩

@[simp]
theorem ofSmoothCompactWeightCore_apply (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) (z : ℍ) :
    ((ofSmoothCompactWeightCore n u : InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      SmoothCompactWeightCore.toSection u z :=
  rfl

/-- The inverse construction is complex-linear. -/
noncomputable def smoothCompactWeightCoreToFixedPhase (n : ℤ) :
    SmoothCompactWeightCore (OrbitMultiplier n) →ₗ[ℂ]
      InverseEtaFixedPhaseCore n where
  toFun := ofSmoothCompactWeightCore n
  map_add' u v := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    rfl
  map_smul' c u := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    rfl

@[simp]
theorem smoothCompactWeightCoreToFixedPhase_apply (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) :
    smoothCompactWeightCoreToFixedPhase n u =
      ofSmoothCompactWeightCore n u :=
  rfl

/-- Forgetting stability after rebuilding it recovers the original smooth
compact weight section exactly. -/
@[simp]
theorem toSmoothCompactWeightCore_ofSmoothCompactWeightCore (n : ℤ)
    (u : SmoothCompactWeightCore (OrbitMultiplier n)) :
    InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
        (ofSmoothCompactWeightCore n u) = u := by
  apply SmoothCompactWeightCore.ext
  intro z
  rfl

/-- Rebuilding the stable core after forgetting it is also the identity. -/
@[simp]
theorem ofSmoothCompactWeightCore_toSmoothCompactWeightCore (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ofSmoothCompactWeightCore n
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) = u := by
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  funext z
  rfl

/-- The fixed-phase stable core and the ordinary smooth quotient-compact
covariant core are linearly equivalent at every orbit index. -/
noncomputable def fixedPhaseCoreEquivSmoothCompactWeightCore (n : ℤ) :
    InverseEtaFixedPhaseCore n ≃ₗ[ℂ]
      SmoothCompactWeightCore (OrbitMultiplier n) where
  toLinearMap := InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
  invFun := smoothCompactWeightCoreToFixedPhase n
  left_inv := ofSmoothCompactWeightCore_toSmoothCompactWeightCore n
  right_inv := toSmoothCompactWeightCore_ofSmoothCompactWeightCore n

@[simp]
theorem fixedPhaseCoreEquivSmoothCompactWeightCore_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    fixedPhaseCoreEquivSmoothCompactWeightCore n u =
      InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u :=
  rfl

/-- In particular, no smooth quotient-compact orbit section is omitted by the
all-word stable-core predicate. -/
theorem toSmoothCompactWeightCore_surjective (n : ℤ) :
    Function.Surjective
      (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n) :=
  (fixedPhaseCoreEquivSmoothCompactWeightCore n).surjective

/-- The stable core also fills the opaque norm-carrying Petersson core before
the completion map is applied. -/
theorem coreEmbedding_surjective (n : ℤ) :
    Function.Surjective (coreEmbedding n) := by
  intro v
  obtain ⟨u, hu⟩ :=
    toSmoothCompactWeightCore_surjective n v.toSmoothCore
  refine ⟨u, ?_⟩
  cases v with
  | mk v =>
      cases hu
      rfl

/-- The actual fixed-phase base coordinate is dense in the Petersson Hilbert
completion because it already contains the entire normed smooth core.  This is
not the graph completion's defining dense-range statement. -/
theorem denseRange_l2Coordinate (n : ℤ) :
    DenseRange (l2Coordinate n) := by
  change DenseRange (fun u : InverseEtaFixedPhaseCore n ↦
    PeterssonCoreSpace.toCompletion (coreEmbedding n u))
  exact
    (PeterssonCoreSpace.denseRange_toCompletion
      (M := OrbitMultiplier n)).comp
      (coreEmbedding_surjective n).denseRange
      (PeterssonCoreSpace.toCompletion
        (M := OrbitMultiplier n)).continuous

/-- Closure formulation of the preceding base-`L²` density theorem. -/
theorem closure_range_l2Coordinate (n : ℤ) :
    closure (Set.range (l2Coordinate n)) = Set.univ :=
  (denseRange_l2Coordinate n).closure_range

/-- Canonical base-`L²` map with the literal full smooth compact covariant
core as its domain. -/
noncomputable def fullSmoothCoreL2Map (n : ℤ) :
    SmoothCompactWeightCore (OrbitMultiplier n) →ₗ[ℂ]
      OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (smoothCompactWeightCoreToFixedPhase n)

@[simp]
theorem fullSmoothCoreL2Map_apply (n : ℤ)
    (v : SmoothCompactWeightCore (OrbitMultiplier n)) :
    fullSmoothCoreL2Map n v =
      l2Coordinate n (ofSmoothCompactWeightCore n v) :=
  rfl

/-- Literal Petersson-`L²` density of the full smooth compact covariant
core, expressed without changing its domain to the fixed-phase presentation. -/
theorem denseRange_fullSmoothCoreL2Map (n : ℤ) :
    DenseRange (fullSmoothCoreL2Map n) := by
  apply (denseRange_l2Coordinate n).mono
  rintro _ ⟨u, rfl⟩
  refine ⟨InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u, ?_⟩
  change l2Coordinate n
      (ofSmoothCompactWeightCore n
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)) =
    l2Coordinate n u
  rw [ofSmoothCompactWeightCore_toSmoothCompactWeightCore]

/-- Since the stable and ordinary smooth cores are the same, the existing
graph-core density theorem is genuinely density of the full smooth
quotient-compact covariant core in the three-coordinate graph norm. -/
theorem denseRange_fullSmoothCore_graphMap (n : ℤ) :
    DenseRange (coreMap n) :=
  denseRange_coreMap n

/-- The literal graph map whose domain is the full ordinary smooth compact
covariant core, rather than its fixed-phase presentation. -/
noncomputable def fullSmoothCoreGraphMap (n : ℤ) :
    SmoothCompactWeightCore (OrbitMultiplier n) →ₗ[ℂ]
      GraphSobolevCompletion n :=
  (coreMap n).comp (smoothCompactWeightCoreToFixedPhase n)

@[simp]
theorem fullSmoothCoreGraphMap_apply (n : ℤ)
    (v : SmoothCompactWeightCore (OrbitMultiplier n)) :
    fullSmoothCoreGraphMap n v =
      coreMap n (ofSmoothCompactWeightCore n v) :=
  rfl

/-- Literal graph-norm density of the full smooth compact covariant core.
This is stronger than merely renaming the fixed-phase core: the domain of the
map in the statement is `SmoothCompactWeightCore` itself. -/
theorem denseRange_fullSmoothCoreGraphMap (n : ℤ) :
    DenseRange (fullSmoothCoreGraphMap n) := by
  apply (denseRange_coreMap n).mono
  rintro _ ⟨u, rfl⟩
  refine ⟨InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u, ?_⟩
  change coreMap n
      (ofSmoothCompactWeightCore n
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)) =
    coreMap n u
  rw [ofSmoothCompactWeightCore_toSmoothCompactWeightCore]

/-! #### An explicit invariant smooth cusp-cutoff partition

The discriminant Petersson potential is strictly positive everywhere and
tends to zero in every cusp.  Applying the standard smooth transition to
`(N+1)V-1` gives an increasing sequence of invariant smooth compactly
supported cutoffs.  It is eventually one at every point.  Successive
differences therefore form a locally finite telescoping partition of unity.
-/

open ExplicitDiscriminantPotential

/-- Real-valued quotient cutoff at level `N`.  It vanishes when
`V ≤ 1/(N+1)` and equals one when `2/(N+1) ≤ V`. -/
noncomputable def quotientCuspCutoffReal (N : ℕ)
    (q : GammaTwoQuotient) : ℝ :=
  Real.smoothTransition (((N : ℝ) + 1) * potential q - 1)

/-- The invariant upstairs realization of the real cutoff. -/
noncomputable def upstairsCuspCutoffReal (N : ℕ) (z : ℍ) : ℝ :=
  Real.smoothTransition (((N : ℝ) + 1) * upstairsPotential z - 1)

/-- Complex-valued realization used to multiply automorphic sections. -/
noncomputable def upstairsCuspCutoff (N : ℕ) (z : ℍ) : ℂ :=
  (upstairsCuspCutoffReal N z : ℂ)

@[simp]
theorem quotientCuspCutoffReal_mk (N : ℕ) (z : ℍ) :
    quotientCuspCutoffReal N (gammaTwoQuotientMk z) =
      upstairsCuspCutoffReal N z :=
  rfl

@[simp]
theorem upstairsCuspCutoff_ofReal (N : ℕ) (z : ℍ) :
    upstairsCuspCutoff N z = (upstairsCuspCutoffReal N z : ℂ) :=
  rfl

theorem quotientCuspCutoffReal_continuous (N : ℕ) :
    Continuous (quotientCuspCutoffReal N) := by
  exact Real.smoothTransition.continuous.comp
    (((continuous_const.mul potential_continuous).sub continuous_const))

theorem upstairsCuspCutoffReal_continuous (N : ℕ) :
    Continuous (upstairsCuspCutoffReal N) := by
  exact Real.smoothTransition.continuous.comp
    (((continuous_const.mul upstairsPotential_continuous).sub continuous_const))

theorem upstairsCuspCutoff_continuous (N : ℕ) :
    Continuous (upstairsCuspCutoff N) :=
  Complex.continuous_ofReal.comp (upstairsCuspCutoffReal_continuous N)

/-- The cutoff is real `C∞` in the upper-half-plane chart, including both
transition hypersurfaces. -/
theorem upstairsCuspCutoff_realSmooth (N : ℕ) :
    RealSmooth (upstairsCuspCutoff N) := by
  unfold RealSmooth upperLift upstairsCuspCutoff upstairsCuspCutoffReal
  have hArg : ContDiffOn ℝ ∞
      (fun w : ℂ ↦
        ((N : ℝ) + 1) *
            upstairsPotential (UpperHalfPlane.ofComplex w) - 1)
      UpperHalfPlane.upperHalfPlaneSet :=
    (contDiffOn_const.mul
      upstairsPotential_upperLift_realContDiffOn).sub contDiffOn_const
  have hTransition : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ Real.smoothTransition
        (((N : ℝ) + 1) *
            upstairsPotential (UpperHalfPlane.ofComplex w) - 1))
      UpperHalfPlane.upperHalfPlaneSet :=
    Real.smoothTransition.contDiff.comp_contDiffOn hArg
  simpa only [Function.comp_def, Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.comp_contDiffOn hTransition

/-- Full modular invariance, hence in particular `Gamma(2)` invariance. -/
theorem upstairsCuspCutoff_SL_invariant (N : ℕ)
    (g : SL(2, ℤ)) (z : ℍ) :
    upstairsCuspCutoff N (g • z) = upstairsCuspCutoff N z := by
  simp only [upstairsCuspCutoff, upstairsCuspCutoffReal,
    upstairsPotential_SL_invariant]

theorem upstairsCuspCutoff_gammaTwo_invariant (N : ℕ)
    (γ : GammaTwo) (z : ℍ) :
    upstairsCuspCutoff N (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsCuspCutoff N z :=
  upstairsCuspCutoff_SL_invariant N (γ : SL(2, ℤ)) z

/-- Nonzero support of one quotient cutoff lies in one literal compact
three-cusp truncation image. -/
theorem quotientCuspCutoffReal_support_subset_compactTruncation (N : ℕ) :
    ∃ Y : ℝ, 1 ≤ Y ∧
      Function.support (quotientCuspCutoffReal N) ⊆
        gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y := by
  have hCoeff : 0 < (N : ℝ) + 1 := by positivity
  have hThreshold : 0 < ((N : ℝ) + 1)⁻¹ := inv_pos.mpr hCoeff
  obtain ⟨Y, hY, hTail⟩ :=
    potential_quotientOutside_threeCuspTruncationImage hThreshold
  refine ⟨Y, hY, ?_⟩
  intro q hq
  change quotientCuspCutoffReal N q ≠ 0 at hq
  by_contra hOutside
  have hSmall : potential q ≤ ((N : ℝ) + 1)⁻¹ :=
    hTail q hOutside
  have hMul := mul_le_mul_of_nonneg_left hSmall hCoeff.le
  have hArg : ((N : ℝ) + 1) * potential q - 1 ≤ 0 := by
    calc
      ((N : ℝ) + 1) * potential q - 1 ≤
          ((N : ℝ) + 1) * ((N : ℝ) + 1)⁻¹ - 1 :=
        sub_le_sub_right hMul 1
      _ = 0 := by
        rw [mul_inv_cancel₀ (ne_of_gt hCoeff)]
        ring
  apply hq
  simp only [quotientCuspCutoffReal,
    Real.smoothTransition.zero_of_nonpos hArg]

theorem quotientCuspCutoffReal_hasCompactSupport (N : ℕ) :
    HasCompactSupport (quotientCuspCutoffReal N) := by
  change IsCompact
    (closure (Function.support (quotientCuspCutoffReal N)))
  obtain ⟨Y, _hY, hSupport⟩ :=
    quotientCuspCutoffReal_support_subset_compactTruncation N
  have hCompactImage : IsCompact
      (gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y) :=
    (gammaTwoThreeCuspTruncation_isCompact Y).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous
  exact hCompactImage.of_isClosed_subset isClosed_closure
    (closure_minimal hSupport hCompactImage.isClosed)

/-- Exact comparison of upstairs projected support with quotient support. -/
theorem upstairsCuspCutoff_projected_support (N : ℕ) :
    gammaTwoQuotientMk '' Function.support (upstairsCuspCutoff N) =
      Function.support (quotientCuspCutoffReal N) := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · rintro ⟨w, hw, hEq⟩
    have hw' : quotientCuspCutoffReal N (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support, quotientCuspCutoffReal_mk,
        upstairsCuspCutoff, Complex.ofReal_ne_zero] using hw
    rwa [hEq] at hw'
  · intro hz
    refine ⟨z, ?_, rfl⟩
    change quotientCuspCutoffReal N (gammaTwoQuotientMk z) ≠ 0 at hz
    rw [quotientCuspCutoffReal_mk] at hz
    simpa only [Function.mem_support, upstairsCuspCutoff,
      Complex.ofReal_ne_zero] using hz

theorem upstairsCuspCutoff_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (upstairsCuspCutoff N) := by
  rw [HasQuotientCompactSupport, quotientTSupport,
    upstairsCuspCutoff_projected_support]
  exact quotientCuspCutoffReal_hasCompactSupport N

/-- The packaged invariant smooth quotient-compact cutoff. -/
noncomputable def cuspCutoffSmoothQuotient (N : ℕ) :
    SmoothQuotientCompactFunction :=
  ⟨⟨upstairsCuspCutoff N, upstairsCuspCutoff_realSmooth N⟩,
    upstairsCuspCutoff_quotientCompact N⟩

@[simp]
theorem cuspCutoffSmoothQuotient_apply (N : ℕ) (z : ℍ) :
    (cuspCutoffSmoothQuotient N : ℍ → ℂ) z =
      upstairsCuspCutoff N z :=
  rfl

theorem cuspCutoffSmoothQuotient_invariant (N : ℕ) :
    IsGammaTwoInvariantCutoff (cuspCutoffSmoothQuotient N) := by
  intro γ z
  exact upstairsCuspCutoff_gammaTwo_invariant N γ z

/-- The real cutoff sequence is increasing. -/
theorem quotientCuspCutoffReal_mono {N M : ℕ} (hNM : N ≤ M)
    (q : GammaTwoQuotient) :
    quotientCuspCutoffReal N q ≤ quotientCuspCutoffReal M q := by
  apply Real.smoothTransition.monotone
  have hCast : (N : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
  have hV := potential_nonneg q
  nlinarith

theorem upstairsCuspCutoffReal_mono {N M : ℕ} (hNM : N ≤ M)
    (z : ℍ) :
    upstairsCuspCutoffReal N z ≤ upstairsCuspCutoffReal M z := by
  simpa only [← quotientCuspCutoffReal_mk] using
    quotientCuspCutoffReal_mono hNM (gammaTwoQuotientMk z)

theorem quotientCuspCutoffReal_nonneg (N : ℕ) (q : GammaTwoQuotient) :
    0 ≤ quotientCuspCutoffReal N q :=
  Real.smoothTransition.nonneg _

theorem quotientCuspCutoffReal_le_one (N : ℕ) (q : GammaTwoQuotient) :
    quotientCuspCutoffReal N q ≤ 1 :=
  Real.smoothTransition.le_one _

/-- Strict positivity of the potential makes the cutoff sequence eventually
equal to one at every quotient point. -/
theorem exists_quotientCuspCutoffReal_eq_one (q : GammaTwoQuotient) :
    ∃ N : ℕ, quotientCuspCutoffReal N q = 1 := by
  have hV : 0 < potential q := potential_pos q
  obtain ⟨N, hN⟩ := exists_nat_gt (2 / potential q)
  refine ⟨N, ?_⟩
  apply Real.smoothTransition.one_of_one_le
  have hProd : 2 < (N : ℝ) * potential q :=
    (div_lt_iff₀ hV).mp hN
  nlinarith

theorem quotientCuspCutoffReal_eq_one_of_le
    {N M : ℕ} (hNM : N ≤ M) {q : GammaTwoQuotient}
    (hN : quotientCuspCutoffReal N q = 1) :
    quotientCuspCutoffReal M q = 1 := by
  apply le_antisymm (quotientCuspCutoffReal_le_one M q)
  simpa only [hN] using quotientCuspCutoffReal_mono hNM q

/-- A quantitative growth condition forces every later cutoff to be one. -/
theorem quotientCuspCutoffReal_eq_one_of_growth
    {N M : ℕ} (hNM : N ≤ M) (q : GammaTwoQuotient)
    (hGrowth : 2 ≤ ((N : ℝ) + 1) * potential q) :
    quotientCuspCutoffReal M q = 1 := by
  apply Real.smoothTransition.one_of_one_le
  have hCast : (N : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
  have hV := potential_nonneg q
  nlinarith

/-- Successive differences of the increasing cutoffs. -/
noncomputable def quotientCuspPartitionPiece :
    ℕ → GammaTwoQuotient → ℝ
  | 0 => quotientCuspCutoffReal 0
  | N + 1 => fun q ↦
      quotientCuspCutoffReal (N + 1) q - quotientCuspCutoffReal N q

theorem quotientCuspPartitionPiece_nonneg (N : ℕ)
    (q : GammaTwoQuotient) :
    0 ≤ quotientCuspPartitionPiece N q := by
  cases N with
  | zero => exact quotientCuspCutoffReal_nonneg 0 q
  | succ N =>
      exact sub_nonneg.mpr
        (quotientCuspCutoffReal_mono (Nat.le_succ N) q)

theorem quotientCuspPartitionPiece_continuous (N : ℕ) :
    Continuous (quotientCuspPartitionPiece N) := by
  cases N with
  | zero => exact quotientCuspCutoffReal_continuous 0
  | succ N =>
      exact (quotientCuspCutoffReal_continuous (N + 1)).sub
        (quotientCuspCutoffReal_continuous N)

theorem quotientCuspPartitionPiece_hasCompactSupport (N : ℕ) :
    HasCompactSupport (quotientCuspPartitionPiece N) := by
  cases N with
  | zero => exact quotientCuspCutoffReal_hasCompactSupport 0
  | succ N =>
      change HasCompactSupport
        (quotientCuspCutoffReal (N + 1) - quotientCuspCutoffReal N)
      simpa only [sub_eq_add_neg] using
        (quotientCuspCutoffReal_hasCompactSupport (N + 1)).add
          (quotientCuspCutoffReal_hasCompactSupport N).neg

/-- The finite partial sums telescope exactly to the last cutoff. -/
theorem sum_quotientCuspPartitionPiece (N : ℕ)
    (q : GammaTwoQuotient) :
    ∑ i ∈ Finset.range (N + 1), quotientCuspPartitionPiece i q =
      quotientCuspCutoffReal N q := by
  induction N with
  | zero => simp [quotientCuspPartitionPiece]
  | succ N ih =>
      rw [Finset.sum_range_succ, ih]
      simp only [quotientCuspPartitionPiece]
      ring

/-- The successive differences are an actual pointwise partition of unity. -/
theorem quotientCuspPartitionPiece_hasSum_one (q : GammaTwoQuotient) :
    HasSum (fun N ↦ quotientCuspPartitionPiece N q) 1 := by
  rw [hasSum_iff_tendsto_nat_of_nonneg
    (fun N ↦ quotientCuspPartitionPiece_nonneg N q)]
  obtain ⟨N, hN⟩ := exists_quotientCuspCutoffReal_eq_one q
  have hEventually :
      (fun m : ℕ ↦ ∑ i ∈ Finset.range m,
        quotientCuspPartitionPiece i q) =ᶠ[Filter.atTop]
        (fun _ ↦ (1 : ℝ)) := by
    filter_upwards [Filter.eventually_ge_atTop (N + 1)] with m hm
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hm
    have hIndex : N + 1 + k = (N + k) + 1 := by omega
    rw [hIndex, sum_quotientCuspPartitionPiece]
    exact quotientCuspCutoffReal_eq_one_of_le
      (Nat.le_add_right N k) hN
  exact (Filter.tendsto_congr' hEventually).mpr tendsto_const_nhds

/-- The supports of the explicit quotient pieces are locally finite.  Near a
point, positivity of `V` makes all sufficiently late cutoffs identically one,
so all sufficiently late successive differences vanish on that neighborhood. -/
theorem quotientCuspPartitionPiece_locallyFinite :
    LocallyFinite
      (fun N : ℕ ↦ Function.support (quotientCuspPartitionPiece N)) := by
  intro q
  have hV : 0 < potential q := potential_pos q
  obtain ⟨N, hN⟩ := exists_nat_gt (2 / potential q)
  have hGrowthAt : 2 < ((N : ℝ) + 1) * potential q := by
    have hProd : 2 < (N : ℝ) * potential q :=
      (div_lt_iff₀ hV).mp hN
    nlinarith
  let U : Set GammaTwoQuotient :=
    {r | 2 < ((N : ℝ) + 1) * potential r}
  have hUopen : IsOpen U := by
    dsimp only [U]
    exact isOpen_lt continuous_const
      (continuous_const.mul potential_continuous)
  have hqU : q ∈ U := hGrowthAt
  refine ⟨U, hUopen.mem_nhds hqU, ?_⟩
  apply (Set.finite_Iic N).subset
  intro M hMeet
  by_contra hM
  have hNM : N < M := Nat.lt_of_not_ge hM
  rcases hMeet with ⟨r, hrPiece, hrU⟩
  have hGrowth : 2 ≤ ((N : ℝ) + 1) * potential r :=
    (show 2 < ((N : ℝ) + 1) * potential r from hrU).le
  cases M with
  | zero => omega
  | succ K =>
      have hNK : N ≤ K := by omega
      have hK : quotientCuspCutoffReal K r = 1 :=
        quotientCuspCutoffReal_eq_one_of_growth hNK r hGrowth
      have hKS : quotientCuspCutoffReal (K + 1) r = 1 :=
        quotientCuspCutoffReal_eq_one_of_growth
          (hNK.trans (Nat.le_succ K)) r hGrowth
      have hZero : quotientCuspPartitionPiece (K + 1) r = 0 := by
        simp only [quotientCuspPartitionPiece, hK, hKS, sub_self]
      exact hrPiece hZero

/-- In particular the infinite sum of the explicit partition is one. -/
@[simp]
theorem tsum_quotientCuspPartitionPiece (q : GammaTwoQuotient) :
    ∑' N, quotientCuspPartitionPiece N q = 1 :=
  (quotientCuspPartitionPiece_hasSum_one q).tsum_eq

/-- Complex upstairs form of one partition piece. -/
noncomputable def upstairsCuspPartitionPiece (N : ℕ) (z : ℍ) : ℂ :=
  (quotientCuspPartitionPiece N (gammaTwoQuotientMk z) : ℂ)

theorem upstairsCuspPartitionPiece_realSmooth (N : ℕ) :
    RealSmooth (upstairsCuspPartitionPiece N) := by
  cases N with
  | zero =>
      have hEq : upstairsCuspPartitionPiece 0 = upstairsCuspCutoff 0 := by
        funext z
        rfl
      rw [hEq]
      exact upstairsCuspCutoff_realSmooth 0
  | succ N =>
      have hEq : upstairsCuspPartitionPiece (N + 1) =
          upstairsCuspCutoff (N + 1) - upstairsCuspCutoff N := by
        funext z
        simp [upstairsCuspPartitionPiece, quotientCuspPartitionPiece,
          upstairsCuspCutoff, quotientCuspCutoffReal_mk]
      rw [hEq]
      exact (upstairsCuspCutoff_realSmooth (N + 1)).sub
        (upstairsCuspCutoff_realSmooth N)

theorem upstairsCuspPartitionPiece_gammaTwo_invariant (N : ℕ)
    (γ : GammaTwo) (z : ℍ) :
    upstairsCuspPartitionPiece N
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsCuspPartitionPiece N z := by
  change (quotientCuspPartitionPiece N
      (gammaTwoQuotientMk (((γ : GammaTwo) : SL(2, ℤ)) • z)) : ℂ) =
    (quotientCuspPartitionPiece N (gammaTwoQuotientMk z) : ℂ)
  rw [show (((γ : GammaTwo) : SL(2, ℤ)) • z) = γ • z from rfl,
    gammaTwoQuotientMk_gamma_smul]

theorem upstairsCuspPartitionPiece_support (N : ℕ) :
    Function.support (upstairsCuspPartitionPiece N) =
      gammaTwoQuotientMk ⁻¹'
        Function.support (quotientCuspPartitionPiece N) := by
  ext z
  simp only [Function.mem_support, Set.mem_preimage,
    upstairsCuspPartitionPiece, Complex.ofReal_ne_zero]

/-- Local finiteness also holds upstairs.  This is the form used by local
chart smoothing and by termwise differentiation of the partition. -/
theorem upstairsCuspPartitionPiece_locallyFinite :
    LocallyFinite
      (fun N : ℕ ↦ Function.support (upstairsCuspPartitionPiece N)) := by
  rw [show (fun N : ℕ ↦ Function.support (upstairsCuspPartitionPiece N)) =
      (fun N : ℕ ↦ gammaTwoQuotientMk ⁻¹'
        Function.support (quotientCuspPartitionPiece N)) by
      funext N
      exact upstairsCuspPartitionPiece_support N]
  intro z
  rcases quotientCuspPartitionPiece_locallyFinite
      (gammaTwoQuotientMk z) with ⟨U, hU, hFinite⟩
  refine ⟨gammaTwoQuotientMk ⁻¹' U,
    gammaTwoQuotientMk_isOpenQuotientMap.continuous.continuousAt hU, ?_⟩
  apply hFinite.subset
  intro N hMeet
  rcases hMeet with ⟨w, hwSupport, hwU⟩
  exact ⟨gammaTwoQuotientMk w, hwSupport, hwU⟩

theorem upstairsCuspPartitionPiece_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (upstairsCuspPartitionPiece N) := by
  cases N with
  | zero =>
      have hEq : upstairsCuspPartitionPiece 0 = upstairsCuspCutoff 0 := by
        funext z
        rfl
      rw [hEq]
      exact upstairsCuspCutoff_quotientCompact 0
  | succ N =>
      have hEq : upstairsCuspPartitionPiece (N + 1) =
          upstairsCuspCutoff (N + 1) - upstairsCuspCutoff N := by
        funext z
        simp [upstairsCuspPartitionPiece, quotientCuspPartitionPiece,
          upstairsCuspCutoff, quotientCuspCutoffReal_mk]
      rw [hEq]
      simpa only [sub_eq_add_neg, neg_smul, one_smul] using
        (upstairsCuspCutoff_quotientCompact (N + 1)).add
          ((upstairsCuspCutoff_quotientCompact N).smul (-1))

/-- Each partition piece is a genuine invariant smooth quotient-compact
function, suitable for multiplying any fixed-phase section. -/
noncomputable def cuspPartitionPieceSmoothQuotient (N : ℕ) :
    SmoothQuotientCompactFunction :=
  ⟨⟨upstairsCuspPartitionPiece N,
      upstairsCuspPartitionPiece_realSmooth N⟩,
    upstairsCuspPartitionPiece_quotientCompact N⟩

theorem cuspPartitionPieceSmoothQuotient_invariant (N : ℕ) :
    IsGammaTwoInvariantCutoff (cuspPartitionPieceSmoothQuotient N) := by
  intro γ z
  exact upstairsCuspPartitionPiece_gammaTwo_invariant N γ z

/-- Upstairs pointwise partition identity. -/
theorem upstairsCuspPartitionPiece_hasSum_one (z : ℍ) :
    HasSum (fun N ↦ upstairsCuspPartitionPiece N z) 1 := by
  simpa only [upstairsCuspPartitionPiece, Complex.ofRealCLM_apply,
    Complex.ofReal_one] using
    Complex.ofRealCLM.hasSum
      (quotientCuspPartitionPiece_hasSum_one
        (gammaTwoQuotientMk z))

/-! #### Exact cutoff commutators for the raw Maass operators -/

/-- Exact raising product rule.  The final term is the entire cutoff
commutator; no hidden lower-order remainder is suppressed. -/
theorem raiseRaw_mul_cutoff {χ f : ℍ → ℂ}
    (hχ : RealSmooth χ) (hf : RealSmooth f)
    (a : ℤ) (z : ℍ) :
    raiseRaw a (χ * f) z =
      χ z * raiseRaw a f z +
        (Complex.I * dx χ z + dy χ z) * f z := by
  simp only [raiseRaw, dx_mul hχ hf, dy_mul hχ hf, Pi.mul_apply]
  ring

/-- Exact lowering product rule and cutoff commutator. -/
theorem lowerRaw_mul_cutoff {χ f : ℍ → ℂ}
    (hχ : RealSmooth χ) (hf : RealSmooth f)
    (a : ℤ) (z : ℍ) :
    lowerRaw a (χ * f) z =
      χ z * lowerRaw a f z +
        (-Complex.I * heightC z ^ 2 * dx χ z +
          heightC z ^ 2 * dy χ z) * f z := by
  simp only [lowerRaw, dx_mul hχ hf, dy_mul hχ hf, Pi.mul_apply]
  ring

/-! #### Covariance-preserving cutoff operators and typed commutators -/

/-- Multiplication by the explicit invariant cusp cutoff is a complex-linear
endomorphism of every fixed-phase stable core. -/
noncomputable def cuspCutoffOperator (N : ℕ) (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] InverseEtaFixedPhaseCore n where
  toFun u :=
    invariantCutoffTimesOrbitSection n
      (cuspCutoffSmoothQuotient N)
      (cuspCutoffSmoothQuotient_invariant N)
      (InverseEtaFixedPhaseCore.toWeightSection n u)
      (u : SmoothQuotientCompactFunction).1.2
  map_add' u v := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    change
      (cuspCutoffSmoothQuotient N : ℍ → ℂ) z *
          (InverseEtaFixedPhaseCore.toWeightSection n (u + v)) z =
        (cuspCutoffSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n u) z +
          (cuspCutoffSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n v) z
    simp only [map_add, HalfIntegralMultiplier.WeightSection.add_apply, mul_add]
  map_smul' c u := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    change
      (cuspCutoffSmoothQuotient N : ℍ → ℂ) z *
          (InverseEtaFixedPhaseCore.toWeightSection n (c • u)) z =
        c *
          ((cuspCutoffSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n u) z)
    simp only [map_smul, HalfIntegralMultiplier.WeightSection.smul_apply, smul_eq_mul]
    ring

@[simp]
theorem cuspCutoffOperator_apply (N : ℕ) (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((cuspCutoffOperator N n u : InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      upstairsCuspCutoff N z *
        (u : SmoothQuotientCompactFunction) z :=
  rfl

/-- Multiplication by one partition piece is likewise a fixed-phase
endomorphism. -/
noncomputable def cuspPartitionPieceOperator (N : ℕ) (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] InverseEtaFixedPhaseCore n where
  toFun u :=
    invariantCutoffTimesOrbitSection n
      (cuspPartitionPieceSmoothQuotient N)
      (cuspPartitionPieceSmoothQuotient_invariant N)
      (InverseEtaFixedPhaseCore.toWeightSection n u)
      (u : SmoothQuotientCompactFunction).1.2
  map_add' u v := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    change
      (cuspPartitionPieceSmoothQuotient N : ℍ → ℂ) z *
          (InverseEtaFixedPhaseCore.toWeightSection n (u + v)) z =
        (cuspPartitionPieceSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n u) z +
          (cuspPartitionPieceSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n v) z
    simp only [map_add, HalfIntegralMultiplier.WeightSection.add_apply, mul_add]
  map_smul' c u := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    change
      (cuspPartitionPieceSmoothQuotient N : ℍ → ℂ) z *
          (InverseEtaFixedPhaseCore.toWeightSection n (c • u)) z =
        c *
          ((cuspPartitionPieceSmoothQuotient N : ℍ → ℂ) z *
            (InverseEtaFixedPhaseCore.toWeightSection n u) z)
    simp only [map_smul, HalfIntegralMultiplier.WeightSection.smul_apply, smul_eq_mul]
    ring

@[simp]
theorem cuspPartitionPieceOperator_apply (N : ℕ) (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((cuspPartitionPieceOperator N n u : InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      upstairsCuspPartitionPiece N z *
        (u : SmoothQuotientCompactFunction) z :=
  rfl

/-- The invariant partition reconstructs every fixed-phase section pointwise. -/
theorem cuspPartitionPieceOperator_hasSum_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    HasSum
      (fun N ↦
        ((cuspPartitionPieceOperator N n u :
            InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) z)
      ((u : SmoothQuotientCompactFunction) z) := by
  simpa only [cuspPartitionPieceOperator_apply, one_mul] using
    HasSum.mul_right ((u : SmoothQuotientCompactFunction) z)
      (upstairsCuspPartitionPiece_hasSum_one z)

/-- Typed raising commutator of the explicit cutoff. -/
noncomputable def raiseCuspCutoffCommutator (N : ℕ) (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      InverseEtaFixedPhaseCore (n + 1) :=
  (InverseEtaFixedPhaseCore.raise n).comp (cuspCutoffOperator N n) -
    (cuspCutoffOperator N (n + 1)).comp
      (InverseEtaFixedPhaseCore.raise n)

/-- Typed lowering commutator of the explicit cutoff. -/
noncomputable def lowerCuspCutoffCommutator (N : ℕ) (n : ℤ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      InverseEtaFixedPhaseCore (n - 1) :=
  (InverseEtaFixedPhaseCore.lower n).comp (cuspCutoffOperator N n) -
    (cuspCutoffOperator N (n - 1)).comp
      (InverseEtaFixedPhaseCore.lower n)

/-- Exact pointwise formula for the typed raising commutator. -/
theorem raiseCuspCutoffCommutator_apply (N : ℕ) (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((raiseCuspCutoffCommutator N n u :
        InverseEtaFixedPhaseCore (n + 1)) :
      SmoothQuotientCompactFunction) z =
      (Complex.I * dx (upstairsCuspCutoff N) z +
          dy (upstairsCuspCutoff N) z) *
        (u : SmoothQuotientCompactFunction) z := by
  simp only [raiseCuspCutoffCommutator, LinearMap.sub_apply,
    LinearMap.comp_apply]
  change
    (InverseEtaFixedPhaseCore.toWeightSection (n + 1)
      ((InverseEtaFixedPhaseCore.raise n)
          (cuspCutoffOperator N n u) -
        (cuspCutoffOperator N (n + 1))
          (InverseEtaFixedPhaseCore.raise n u))) z = _
  rw [map_sub]
  change
    raiseRaw (paperOrbitExponent n)
        (((cuspCutoffOperator N n u : InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) : ℍ → ℂ) z -
      upstairsCuspCutoff N z *
        raiseRaw (paperOrbitExponent n)
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) z = _
  rw [show
      (((cuspCutoffOperator N n u : InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) : ℍ → ℂ) =
        upstairsCuspCutoff N *
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) from rfl,
    raiseRaw_mul_cutoff (upstairsCuspCutoff_realSmooth N)
      (u : SmoothQuotientCompactFunction).1.2]
  ring

/-- Exact pointwise formula for the typed lowering commutator. -/
theorem lowerCuspCutoffCommutator_apply (N : ℕ) (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((lowerCuspCutoffCommutator N n u :
        InverseEtaFixedPhaseCore (n - 1)) :
      SmoothQuotientCompactFunction) z =
      (-Complex.I * heightC z ^ 2 * dx (upstairsCuspCutoff N) z +
          heightC z ^ 2 * dy (upstairsCuspCutoff N) z) *
        (u : SmoothQuotientCompactFunction) z := by
  simp only [lowerCuspCutoffCommutator, LinearMap.sub_apply,
    LinearMap.comp_apply]
  change
    (InverseEtaFixedPhaseCore.toWeightSection (n - 1)
      ((InverseEtaFixedPhaseCore.lower n)
          (cuspCutoffOperator N n u) -
        (cuspCutoffOperator N (n - 1))
          (InverseEtaFixedPhaseCore.lower n u))) z = _
  rw [map_sub]
  change
    lowerRaw (paperOrbitExponent n)
        (((cuspCutoffOperator N n u : InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) : ℍ → ℂ) z -
      upstairsCuspCutoff N z *
        lowerRaw (paperOrbitExponent n)
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) z = _
  rw [show
      (((cuspCutoffOperator N n u : InverseEtaFixedPhaseCore n) :
          SmoothQuotientCompactFunction) : ℍ → ℂ) =
        upstairsCuspCutoff N *
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) from rfl,
    lowerRaw_mul_cutoff (upstairsCuspCutoff_realSmooth N)
      (u : SmoothQuotientCompactFunction).1.2]
  ring

/-! #### Exact exhaustion on every quotient-compact fixed-phase section

The cutoff sequence does not merely converge on the present core.  The
quotient topological support of one core section is compact, while the
discriminant potential is continuous and strictly positive.  Compactness
therefore gives a positive uniform lower bound on that support (with the empty
support case included automatically), and one cutoff is already identically
one there.  Monotonicity makes every later cutoff exactly one as well.  This
gives zero (rather than asymptotically small) graph error and zero cutoff
commutator from a finite stage onward.
-/

/-- Any theorem about the full smooth quotient-compact covariant core is
equivalent to its pullback to the fixed-phase stable core.  Thus no separate
local mollification or group-averaging construction is needed for density in
the Petersson completion used here: the two smooth cores are already linearly
equivalent. -/
theorem forall_smoothCompactWeightCore_iff_forall_fixedPhaseCore
    (n : ℤ) (P : SmoothCompactWeightCore (OrbitMultiplier n) → Prop) :
    (∀ v, P v) ↔
      ∀ u, P (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) := by
  constructor
  · intro h u
    exact h _
  · intro h v
    obtain ⟨u, rfl⟩ := toSmoothCompactWeightCore_surjective n v
    exact h u

/-- Every ordinary smooth quotient-compact covariant section has a unique
fixed-phase stable lift with exactly the same underlying section.  This is the
precise replacement for a separate smoothing or group-averaging step: both
sides of the alleged approximation are already the same smooth core. -/
theorem existsUnique_fixedPhase_lift (n : ℤ)
    (v : SmoothCompactWeightCore (OrbitMultiplier n)) :
    ∃! u : InverseEtaFixedPhaseCore n,
      InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u = v := by
  refine ⟨ofSmoothCompactWeightCore n v,
    toSmoothCompactWeightCore_ofSmoothCompactWeightCore n v, ?_⟩
  intro u hu
  apply InverseEtaFixedPhaseCore.toSmoothCompactWeightCore_injective n
  rw [hu, toSmoothCompactWeightCore_ofSmoothCompactWeightCore]

/-- A single cutoff, and therefore every later cutoff, is one on the entire
quotient topological support of a fixed-phase core section. -/
theorem exists_cutoff_eq_one_on_quotientTSupport (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      ∀ q ∈ quotientTSupport
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ),
        quotientCuspCutoffReal M q = 1 := by
  let K : Set GammaTwoQuotient :=
    quotientTSupport ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
  have hKcompact : IsCompact K :=
    (u : SmoothQuotientCompactFunction).2
  obtain ⟨δ, hδ, hδK⟩ := hKcompact.exists_forall_le'
    potential_continuous.continuousOn (fun q _hq ↦ potential_pos q)
  obtain ⟨N, hN⟩ := exists_nat_gt (2 / δ)
  refine ⟨N, fun M hNM r hrK ↦ ?_⟩
  apply quotientCuspCutoffReal_eq_one_of_growth hNM r
  have hmin : δ ≤ potential r := hδK r hrK
  have hscaled :
      (N : ℝ) * δ ≤ (N : ℝ) * potential r :=
    mul_le_mul_of_nonneg_left hmin (Nat.cast_nonneg N)
  have htwo : 2 < (N : ℝ) * δ :=
    (div_lt_iff₀ hδ).mp hN
  have hrpos : 0 < potential r := potential_pos r
  nlinarith

/-- Multiplication by the invariant cusp cutoff is eventually exactly the
identity on each fixed-phase core vector. -/
theorem exists_cuspCutoffOperator_eventually_eq (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M → cuspCutoffOperator M n u = u := by
  obtain ⟨N, hN⟩ := exists_cutoff_eq_one_on_quotientTSupport n u
  refine ⟨N, fun M hNM ↦ ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  funext z
  change upstairsCuspCutoff M z *
      (u : SmoothQuotientCompactFunction) z =
    (u : SmoothQuotientCompactFunction) z
  by_cases hz : (u : SmoothQuotientCompactFunction) z = 0
  · rw [hz, mul_zero]
  · have hzSupport : gammaTwoQuotientMk z ∈
        quotientTSupport
          ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) :=
      subset_closure ⟨z, hz, rfl⟩
    have hCut := hN M hNM (gammaTwoQuotientMk z) hzSupport
    have hCutReal : upstairsCuspCutoffReal M z = 1 := by
      simpa only [quotientCuspCutoffReal_mk] using hCut
    simp only [upstairsCuspCutoff, hCutReal, Complex.ofReal_one, one_mul]

/-- Every member of the full smooth compact covariant core is represented by
a fixed-phase vector which is already fixed by one finite cusp cutoff.  Thus
the usual "smooth, average, then truncate" approximation package collapses
here to an exact lift followed by exact finite-stage stabilization. -/
theorem exists_exactCutoff_fixedPhase_lift (n : ℤ)
    (v : SmoothCompactWeightCore (OrbitMultiplier n)) :
    ∃ u : InverseEtaFixedPhaseCore n, ∃ N : ℕ,
      InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u = v ∧
        cuspCutoffOperator N n u = u := by
  let u : InverseEtaFixedPhaseCore n := ofSmoothCompactWeightCore n v
  obtain ⟨N, hN⟩ := exists_cuspCutoffOperator_eventually_eq n u
  refine ⟨u, N, ?_, hN N le_rfl⟩
  exact toSmoothCompactWeightCore_ofSmoothCompactWeightCore n v

/-- Filter form of exact eventual cutoff stabilization. -/
theorem cuspCutoffOperator_eventuallyEq (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    (fun M ↦ cuspCutoffOperator M n u) =ᶠ[Filter.atTop]
      (fun _ ↦ u) := by
  obtain ⟨N, hN⟩ := exists_cuspCutoffOperator_eventually_eq n u
  filter_upwards [Filter.eventually_ge_atTop N] with M hM
  exact hN M hM

/-- The graph-completion images of the cutoff approximants are eventually
constant, hence converge in the full base/raising/lowering graph norm. -/
theorem coreMap_cuspCutoffOperator_tendsto (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    Filter.Tendsto
      (fun M ↦ coreMap n (cuspCutoffOperator M n u))
      Filter.atTop (nhds (coreMap n u)) := by
  apply (Filter.tendsto_congr' ?_).mpr tendsto_const_nhds
  exact (cuspCutoffOperator_eventuallyEq n u).fun_comp (coreMap n)

/-- Quantitative graph-norm form: the cutoff error is literally zero after a
finite stage. -/
theorem exists_cuspCutoffOperator_graphNorm_error_eq_zero (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      ‖coreMap n (cuspCutoffOperator M n u) - coreMap n u‖ = 0 := by
  obtain ⟨N, hN⟩ := exists_cuspCutoffOperator_eventually_eq n u
  refine ⟨N, fun M hM ↦ ?_⟩
  rw [hN M hM, sub_self, norm_zero]

/-- The union of all cutoff-localized core images is dense in the completed
graph norm.  Indeed it already contains every original core image, because
each quotient-compact core vector is fixed by one finite cutoff stage. -/
theorem dense_iUnion_range_coreMap_cuspCutoffOperator (n : ℤ) :
    Dense
      (⋃ N : ℕ, Set.range fun u : InverseEtaFixedPhaseCore n ↦
        coreMap n (cuspCutoffOperator N n u)) := by
  apply (denseRange_coreMap n).mono
  rintro _ ⟨u, rfl⟩
  obtain ⟨N, hN⟩ := exists_cuspCutoffOperator_eventually_eq n u
  refine Set.mem_iUnion.mpr ⟨N, ?_⟩
  exact ⟨u, congrArg (coreMap n) (hN N le_rfl)⟩

theorem closure_iUnion_range_coreMap_cuspCutoffOperator (n : ℤ) :
    closure
        (⋃ N : ℕ, Set.range fun u : InverseEtaFixedPhaseCore n ↦
          coreMap n (cuspCutoffOperator N n u)) = Set.univ :=
  (dense_iUnion_range_coreMap_cuspCutoffOperator n).closure_eq

/-- The typed raising cutoff commutator vanishes exactly from a finite stage
onward for each core vector. -/
theorem exists_raiseCuspCutoffCommutator_eventually_eq_zero (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      raiseCuspCutoffCommutator M n u = 0 := by
  obtain ⟨Nu, hNu⟩ := exists_cuspCutoffOperator_eventually_eq n u
  obtain ⟨Nr, hNr⟩ := exists_cuspCutoffOperator_eventually_eq (n + 1)
    (InverseEtaFixedPhaseCore.raise n u)
  refine ⟨max Nu Nr, fun M hM ↦ ?_⟩
  have hMu := hNu M ((le_max_left Nu Nr).trans hM)
  have hMr := hNr M ((le_max_right Nu Nr).trans hM)
  simpa only [raiseCuspCutoffCommutator, LinearMap.sub_apply,
    LinearMap.comp_apply, hMu, hMr, sub_self]

/-- The typed lowering cutoff commutator likewise vanishes exactly from a
finite stage onward. -/
theorem exists_lowerCuspCutoffCommutator_eventually_eq_zero (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      lowerCuspCutoffCommutator M n u = 0 := by
  obtain ⟨Nu, hNu⟩ := exists_cuspCutoffOperator_eventually_eq n u
  obtain ⟨Nl, hNl⟩ := exists_cuspCutoffOperator_eventually_eq (n - 1)
    (InverseEtaFixedPhaseCore.lower n u)
  refine ⟨max Nu Nl, fun M hM ↦ ?_⟩
  have hMu := hNu M ((le_max_left Nu Nl).trans hM)
  have hMl := hNl M ((le_max_right Nu Nl).trans hM)
  simpa only [lowerCuspCutoffCommutator, LinearMap.sub_apply,
    LinearMap.comp_apply, hMu, hMl, sub_self]

/-! #### Disjoint compact seeds and infinite dimension at physical index zero

The positive discriminant potential takes every value between a sufficiently
small cusp value and its value at `i`.  Geometrically decreasing potential
levels therefore support pairwise disjoint smooth compact shells.  Multiplying
these invariant shells by the nowhere-zero inverse-eta section gives an
explicit countable linearly independent family in the physical fixed-phase
core `InverseEtaFixedPhaseCore 0`.
-/

/-- Every positive value below the value of the discriminant potential at
`i` is attained in the upper half-plane. -/
theorem exists_upstairsPotential_eq_of_pos_le_I {a : ℝ}
    (ha : 0 < a) (haI : a ≤ upstairsPotential UpperHalfPlane.I) :
    ∃ z : ℍ, upstairsPotential z = a := by
  obtain ⟨Y, hY⟩ := upstairsPotential_cuspTail ha
  let y : ℝ := max Y 1
  have hy : 0 < y :=
    lt_of_lt_of_le (by norm_num) (le_max_right Y 1)
  let z : ℍ :=
    ⟨(y : ℂ) * Complex.I, by simpa [y] using hy⟩
  have hzHeight : Y ≤ z.im := by
    simpa [z, y] using (le_max_left Y 1)
  have hzSmall : upstairsPotential z ≤ a := hY z hzHeight
  exact (intermediate_value_univ z UpperHalfPlane.I
    upstairsPotential_continuous) ⟨hzSmall, haI⟩

/-- Geometric shell levels, with ratio exactly `1/4`. -/
noncomputable def potentialShellLevel : ℕ → ℝ
  | 0 => upstairsPotential UpperHalfPlane.I / 4
  | N + 1 => potentialShellLevel N / 4

@[simp]
theorem potentialShellLevel_zero :
    potentialShellLevel 0 = upstairsPotential UpperHalfPlane.I / 4 :=
  rfl

@[simp]
theorem potentialShellLevel_succ (N : ℕ) :
    potentialShellLevel (N + 1) = potentialShellLevel N / 4 :=
  rfl

theorem potentialShellLevel_pos (N : ℕ) : 0 < potentialShellLevel N := by
  induction N with
  | zero =>
      exact div_pos (upstairsPotential_pos UpperHalfPlane.I) (by norm_num)
  | succ N ih =>
      rw [potentialShellLevel_succ]
      exact div_pos ih (by norm_num)

theorem potentialShellLevel_antitone : Antitone potentialShellLevel :=
  antitone_nat_of_succ_le fun N ↦ by
    rw [potentialShellLevel_succ]
    exact div_le_self (potentialShellLevel_pos N).le (by norm_num)

theorem potentialShellLevel_le_I (N : ℕ) :
    potentialShellLevel N ≤ upstairsPotential UpperHalfPlane.I := by
  calc
    potentialShellLevel N ≤ potentialShellLevel 0 :=
      potentialShellLevel_antitone (Nat.zero_le N)
    _ = upstairsPotential UpperHalfPlane.I / 4 := rfl
    _ ≤ upstairsPotential UpperHalfPlane.I :=
      div_le_self (upstairsPotential_pos UpperHalfPlane.I).le (by norm_num)

/-- A selected point on every shell level. -/
noncomputable def potentialShellPoint (N : ℕ) : ℍ :=
  Classical.choose
    (exists_upstairsPotential_eq_of_pos_le_I
      (potentialShellLevel_pos N) (potentialShellLevel_le_I N))

@[simp]
theorem potentialShellPoint_spec (N : ℕ) :
    upstairsPotential (potentialShellPoint N) = potentialShellLevel N :=
  Classical.choose_spec
    (exists_upstairsPotential_eq_of_pos_le_I
      (potentialShellLevel_pos N) (potentialShellLevel_le_I N))

/-- Real downstairs shell supported where
`level/2 < potential < 2*level`. -/
noncomputable def quotientPotentialShellReal (N : ℕ)
    (q : GammaTwoQuotient) : ℝ :=
  expNegInvGlue (potential q - potentialShellLevel N / 2) *
    expNegInvGlue (2 * potentialShellLevel N - potential q)

/-- Upstairs complex realization of the same shell. -/
noncomputable def upstairsPotentialShell (N : ℕ) (z : ℍ) : ℂ :=
  (expNegInvGlue
      (upstairsPotential z - potentialShellLevel N / 2) *
    expNegInvGlue
      (2 * potentialShellLevel N - upstairsPotential z) : ℝ)

@[simp]
theorem quotientPotentialShellReal_mk (N : ℕ) (z : ℍ) :
    quotientPotentialShellReal N (gammaTwoQuotientMk z) =
      (upstairsPotentialShell N z).re := by
  simp only [quotientPotentialShellReal, upstairsPotentialShell,
    potential_mk, Complex.ofReal_re]

theorem quotientPotentialShellReal_continuous (N : ℕ) :
    Continuous (quotientPotentialShellReal N) := by
  exact
    ((expNegInvGlue.contDiff (n := 1)).continuous.comp
      (potential_continuous.sub continuous_const)).mul
    ((expNegInvGlue.contDiff (n := 1)).continuous.comp
      (continuous_const.sub potential_continuous))

theorem upstairsPotentialShell_realSmooth (N : ℕ) :
    RealSmooth (upstairsPotentialShell N) := by
  unfold RealSmooth upperLift upstairsPotentialShell
  have hLeft : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ expNegInvGlue
        (upstairsPotential (UpperHalfPlane.ofComplex w) -
          potentialShellLevel N / 2))
      UpperHalfPlane.upperHalfPlaneSet :=
    expNegInvGlue.contDiff.comp_contDiffOn
      (upstairsPotential_upperLift_realContDiffOn.sub contDiffOn_const)
  have hRight : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ expNegInvGlue
        (2 * potentialShellLevel N -
          upstairsPotential (UpperHalfPlane.ofComplex w)))
      UpperHalfPlane.upperHalfPlaneSet :=
    expNegInvGlue.contDiff.comp_contDiffOn
      (contDiffOn_const.sub upstairsPotential_upperLift_realContDiffOn)
  simpa only [Function.comp_def, Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.comp_contDiffOn (hLeft.mul hRight)

theorem upstairsPotentialShell_gammaTwo_invariant (N : ℕ)
    (γ : GammaTwo) (z : ℍ) :
    upstairsPotentialShell N
        (((γ : GammaTwo) : SL(2, ℤ)) • z) =
      upstairsPotentialShell N z := by
  simp only [upstairsPotentialShell, upstairsPotential_gammaTwo_invariant]

theorem upstairsPotentialShell_at_point_ne_zero (N : ℕ) :
    upstairsPotentialShell N (potentialShellPoint N) ≠ 0 := by
  apply Complex.ofReal_ne_zero.mpr
  apply mul_ne_zero
  · apply ne_of_gt
    apply expNegInvGlue.pos_of_pos
    rw [potentialShellPoint_spec]
    nlinarith [potentialShellLevel_pos N]
  · apply ne_of_gt
    apply expNegInvGlue.pos_of_pos
    rw [potentialShellPoint_spec]
    nlinarith [potentialShellLevel_pos N]

theorem upstairsPotentialShell_support_lower {N : ℕ} {z : ℍ}
    (hz : z ∈ Function.support (upstairsPotentialShell N)) :
    potentialShellLevel N / 2 < upstairsPotential z := by
  have hzReal :
      expNegInvGlue
          (upstairsPotential z - potentialShellLevel N / 2) *
        expNegInvGlue
          (2 * potentialShellLevel N - upstairsPotential z) ≠ 0 := by
    simpa only [Function.mem_support, upstairsPotentialShell,
      Complex.ofReal_ne_zero] using hz
  have hLeft :
      expNegInvGlue
        (upstairsPotential z - potentialShellLevel N / 2) ≠ 0 :=
    left_ne_zero_of_mul hzReal
  have hNot :
      ¬ upstairsPotential z - potentialShellLevel N / 2 ≤ 0 := by
    intro h
    exact hLeft (expNegInvGlue.zero_of_nonpos h)
  linarith

theorem upstairsPotentialShell_support_upper {N : ℕ} {z : ℍ}
    (hz : z ∈ Function.support (upstairsPotentialShell N)) :
    upstairsPotential z < 2 * potentialShellLevel N := by
  have hzReal :
      expNegInvGlue
          (upstairsPotential z - potentialShellLevel N / 2) *
        expNegInvGlue
          (2 * potentialShellLevel N - upstairsPotential z) ≠ 0 := by
    simpa only [Function.mem_support, upstairsPotentialShell,
      Complex.ofReal_ne_zero] using hz
  have hRight :
      expNegInvGlue
        (2 * potentialShellLevel N - upstairsPotential z) ≠ 0 :=
    right_ne_zero_of_mul hzReal
  have hNot :
      ¬ 2 * potentialShellLevel N - upstairsPotential z ≤ 0 := by
    intro h
    exact hRight (expNegInvGlue.zero_of_nonpos h)
  linarith

theorem quotientPotentialShellReal_support_lower {N : ℕ}
    {q : GammaTwoQuotient}
    (hq : q ∈ Function.support (quotientPotentialShellReal N)) :
    potentialShellLevel N / 2 < potential q := by
  change
    expNegInvGlue (potential q - potentialShellLevel N / 2) *
      expNegInvGlue (2 * potentialShellLevel N - potential q) ≠ 0 at hq
  have hLeft :
      expNegInvGlue (potential q - potentialShellLevel N / 2) ≠ 0 :=
    left_ne_zero_of_mul hq
  have hNot : ¬ potential q - potentialShellLevel N / 2 ≤ 0 := by
    intro h
    exact hLeft (expNegInvGlue.zero_of_nonpos h)
  linarith

/-- Each downstairs shell has ordinary compact support; its lower potential
bound places it inside one already-proved compact cusp cutoff. -/
theorem quotientPotentialShellReal_hasCompactSupport (N : ℕ) :
    HasCompactSupport (quotientPotentialShellReal N) := by
  have hLevel : 0 < potentialShellLevel N := potentialShellLevel_pos N
  obtain ⟨M, hM⟩ := exists_nat_gt (2 / potentialShellLevel N)
  apply (quotientCuspCutoffReal_hasCompactSupport M).mono
  intro q hq
  have hLower := quotientPotentialShellReal_support_lower hq
  have hMul : 2 < (M : ℝ) * potentialShellLevel N :=
    (div_lt_iff₀ hLevel).mp hM
  have hMpos : 0 < (M : ℝ) :=
    (div_pos (by norm_num) hLevel).trans hM
  have hScaled :
      (M : ℝ) * (potentialShellLevel N / 2) <
        (M : ℝ) * potential q :=
    mul_lt_mul_of_pos_left hLower hMpos
  have hOne : 1 < (M : ℝ) * potential q := by
    nlinarith
  have hArg : 0 < ((M : ℝ) + 1) * potential q - 1 := by
    nlinarith [potential_pos q]
  change quotientCuspCutoffReal M q ≠ 0
  exact ne_of_gt (Real.smoothTransition.pos_of_pos hArg)

theorem upstairsPotentialShell_projected_support (N : ℕ) :
    gammaTwoQuotientMk '' Function.support (upstairsPotentialShell N) =
      Function.support (quotientPotentialShellReal N) := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · rintro ⟨w, hw, hEq⟩
    have hw' :
        quotientPotentialShellReal N (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support, quotientPotentialShellReal,
        upstairsPotentialShell, potential_mk, Complex.ofReal_ne_zero] using hw
    rwa [hEq] at hw'
  · intro hz
    refine ⟨z, ?_, rfl⟩
    change quotientPotentialShellReal N (gammaTwoQuotientMk z) ≠ 0 at hz
    have hzC :
        (quotientPotentialShellReal N (gammaTwoQuotientMk z) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr hz
    simpa only [Function.mem_support, quotientPotentialShellReal,
      upstairsPotentialShell, potential_mk] using hzC

theorem upstairsPotentialShell_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (upstairsPotentialShell N) := by
  rw [HasQuotientCompactSupport, quotientTSupport,
    upstairsPotentialShell_projected_support]
  exact quotientPotentialShellReal_hasCompactSupport N

noncomputable def potentialShellSmoothQuotient (N : ℕ) :
    SmoothQuotientCompactFunction :=
  ⟨⟨upstairsPotentialShell N, upstairsPotentialShell_realSmooth N⟩,
    upstairsPotentialShell_quotientCompact N⟩

theorem potentialShellSmoothQuotient_invariant (N : ℕ) :
    IsGammaTwoInvariantCutoff (potentialShellSmoothQuotient N) := by
  intro γ z
  exact upstairsPotentialShell_gammaTwo_invariant N γ z

/-- The shell supports are pairwise disjoint because successive levels shrink
by a factor four while each shell lies between half and twice its level. -/
theorem upstairsPotentialShell_support_disjoint_of_lt {N M : ℕ}
    (hNM : N < M) :
    Disjoint (Function.support (upstairsPotentialShell N))
      (Function.support (upstairsPotentialShell M)) := by
  rw [Set.disjoint_left]
  intro z hzN hzM
  have hLower := upstairsPotentialShell_support_lower hzN
  have hUpper := upstairsPotentialShell_support_upper hzM
  have hLevels :=
    potentialShellLevel_antitone (Nat.succ_le_of_lt hNM)
  rw [potentialShellLevel_succ] at hLevels
  nlinarith

theorem upstairsPotentialShell_support_pairwiseDisjoint :
    Pairwise fun N M : ℕ ↦
      Disjoint (Function.support (upstairsPotentialShell N))
        (Function.support (upstairsPotentialShell M)) := by
  intro N M hNM
  rcases lt_or_gt_of_ne hNM with hlt | hgt
  · exact upstairsPotentialShell_support_disjoint_of_lt hlt
  · exact (upstairsPotentialShell_support_disjoint_of_lt hgt).symm

/-- The physical-index core vector obtained from one compact shell and the
nowhere-zero inverse-eta seed. -/
noncomputable def potentialShellCoreZero (N : ℕ) :
    InverseEtaFixedPhaseCore 0 :=
  invariantCutoffTimesOrbitSection 0
    (potentialShellSmoothQuotient N)
    (potentialShellSmoothQuotient_invariant N)
    inverseEtaPaperOrbitZeroSeedSection
    inverseEtaPaperOrbitZeroSeedSection_realSmooth

@[simp]
theorem potentialShellCoreZero_apply (N : ℕ) (z : ℍ) :
    ((potentialShellCoreZero N : InverseEtaFixedPhaseCore 0) :
        SmoothQuotientCompactFunction) z =
      upstairsPotentialShell N z * inverseEtaPaperOrbitZeroSeedSection z := by
  rfl

theorem potentialShellCoreZero_at_point_ne_zero (N : ℕ) :
    ((potentialShellCoreZero N : InverseEtaFixedPhaseCore 0) :
        SmoothQuotientCompactFunction) (potentialShellPoint N) ≠ 0 := by
  rw [potentialShellCoreZero_apply]
  exact mul_ne_zero (upstairsPotentialShell_at_point_ne_zero N)
    (inverseEtaPaperOrbitZeroSeedSection_apply_ne_zero
      (potentialShellPoint N))

theorem potentialShellCoreZero_ne_zero (N : ℕ) :
    potentialShellCoreZero N ≠ (0 : InverseEtaFixedPhaseCore 0) := by
  intro hzero
  have hAt := congrArg
    (fun u : InverseEtaFixedPhaseCore 0 ↦
      ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
        (potentialShellPoint N)) hzero
  change
    upstairsPotentialShell N (potentialShellPoint N) *
      inverseEtaPaperOrbitZeroSeedSection (potentialShellPoint N) = 0 at hAt
  exact potentialShellCoreZero_at_point_ne_zero N hAt

theorem potentialShellCoreZero_support_subset (N : ℕ) :
    Function.support
        (fun z ↦ ((potentialShellCoreZero N :
          InverseEtaFixedPhaseCore 0) : SmoothQuotientCompactFunction) z) ⊆
      Function.support (upstairsPotentialShell N) := by
  intro z hz
  have hz' :
      upstairsPotentialShell N z *
          inverseEtaPaperOrbitZeroSeedSection z ≠ 0 := by
    simpa only [Function.mem_support, potentialShellCoreZero_apply] using hz
  exact left_ne_zero_of_mul hz'

theorem potentialShellCoreZero_support_pairwiseDisjoint :
    Pairwise fun N M : ℕ ↦
      Disjoint
        (Function.support
          (fun z ↦ ((potentialShellCoreZero N :
            InverseEtaFixedPhaseCore 0) : SmoothQuotientCompactFunction) z))
        (Function.support
          (fun z ↦ ((potentialShellCoreZero M :
            InverseEtaFixedPhaseCore 0) : SmoothQuotientCompactFunction) z)) := by
  intro N M hNM
  exact Disjoint.mono
    (potentialShellCoreZero_support_subset N)
    (potentialShellCoreZero_support_subset M)
    (upstairsPotentialShell_support_pairwiseDisjoint hNM)

/-- Point evaluation, used only to certify linear independence of the explicit
disjoint family. -/
def fixedPhaseCoreEvaluation (n : ℤ) (z : ℍ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] ℂ where
  toFun u := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) z
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp]
theorem fixedPhaseCoreEvaluation_apply (n : ℤ) (z : ℍ)
    (u : InverseEtaFixedPhaseCore n) :
    fixedPhaseCoreEvaluation n z u =
      ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) z :=
  rfl

/-- The disjoint compact shell vectors form a countable linearly independent
family in the physical fixed-phase core. -/
theorem potentialShellCoreZero_linearIndependent :
    LinearIndependent ℂ potentialShellCoreZero := by
  refine (linearIndependent_iff'ₛ).2 ?_
  intro s f g hsum N hNs
  have hEval := congrArg
    (fixedPhaseCoreEvaluation 0 (potentialShellPoint N)) hsum
  simp only [map_sum, map_smul,
    fixedPhaseCoreEvaluation_apply, smul_eq_mul] at hEval
  have hOther : ∀ M ∈ s, M ≠ N →
      ((potentialShellCoreZero M : InverseEtaFixedPhaseCore 0) :
          SmoothQuotientCompactFunction) (potentialShellPoint N) = 0 := by
    intro M hMs hMN
    by_contra hMpoint
    exact Set.disjoint_left.mp
      (potentialShellCoreZero_support_pairwiseDisjoint hMN.symm)
      (potentialShellCoreZero_at_point_ne_zero N) hMpoint
  have hF :
      ∑ M ∈ s, f M *
          ((potentialShellCoreZero M : InverseEtaFixedPhaseCore 0) :
            SmoothQuotientCompactFunction) (potentialShellPoint N) =
        f N *
          ((potentialShellCoreZero N : InverseEtaFixedPhaseCore 0) :
            SmoothQuotientCompactFunction) (potentialShellPoint N) := by
    apply Finset.sum_eq_single_of_mem N hNs
    intro M hMs hMN
    rw [hOther M hMs hMN, mul_zero]
  have hG :
      ∑ M ∈ s, g M *
          ((potentialShellCoreZero M : InverseEtaFixedPhaseCore 0) :
            SmoothQuotientCompactFunction) (potentialShellPoint N) =
        g N *
          ((potentialShellCoreZero N : InverseEtaFixedPhaseCore 0) :
            SmoothQuotientCompactFunction) (potentialShellPoint N) := by
    apply Finset.sum_eq_single_of_mem N hNs
    intro M hMs hMN
    rw [hOther M hMs hMN, mul_zero]
  rw [hF, hG] at hEval
  exact mul_right_cancel₀
    (potentialShellCoreZero_at_point_ne_zero N) hEval

/-- Consequently the physical fixed-phase smooth core is genuinely
infinite-dimensional, not merely nontrivial. -/
theorem inverseEtaFixedPhaseCoreZero_not_finiteDimensional :
    ¬ FiniteDimensional ℂ (InverseEtaFixedPhaseCore 0) := by
  intro hFinite
  letI : FiniteDimensional ℂ (InverseEtaFixedPhaseCore 0) := hFinite
  have hlt :=
    potentialShellCoreZero_linearIndependent.lt_aleph0_of_finiteDimensional
  rw [Cardinal.mk_nat] at hlt
  exact (lt_irrefl _ hlt)

end PaperCorrections.AutomorphicSobolev.FixedPhaseDensity

/-! ### Actual closed fixed-phase operators on the Petersson `L²` tower

The graph completion above is useful as an energy space, but its coordinate
maps do not by themselves prove that the differential operators are closable
on the ambient Petersson `L²` spaces.  This section makes the genuine
unbounded operators.  Their domains are the actual dense images of the
smooth fixed-phase cores in the Petersson completions, and their values are
the typed raising and lowering maps constructed earlier.

The sole Green hypothesis used below is the literal statement that the
already-defined geometric boundary defect vanishes for every core pair.  It
is proved equivalent to Mathlib's `LinearPMap.IsFormalAdjoint` predicate.
Thus all density, closure, closedness, and adjoint-inclusion arguments are
unconditional functional analysis; the remaining geometric obligation is
neither hidden in the operator definition nor replaced by graph-completion
tautology.
-/

namespace PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators

open DefinitionOneSobolev
open HalfWeightDifferentialOperators
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open GammaTwoQuotientGreenBoundary
open scoped LinearPMap

/-! #### A concrete Euclidean-gauge realization of Petersson `L²`

The Petersson completion is abstractly constructed from its inner product.
For the local distribution argument below we also need an honest function
representative.  Multiplication by

`y ^ (paperOrbitExponent n / 4 - 1)`

absorbs both the Hermitian fiber scale and the hyperbolic density.  It gives
an isometric realization in ordinary Euclidean `L²` on the selected carrier.
This construction is independent of every polygonal Green/Stokes statement. -/

namespace PhysicalLocalL2

open MeasureTheory Set Function Topology
open GammaTwoQuotientGeometry
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open HalfIntegralMultiplier SmoothCompactCoreGeometry

/-- Euclidean area on the upper half-plane, before insertion of `y⁻²`. -/
noncomputable abbrev upperEuclideanMeasure : Measure ℍ :=
  volume.comap UpperHalfPlane.coe

/-- The nowhere-zero Radon--Nikodym density which turns Euclidean area into
hyperbolic area. -/
noncomputable def hyperbolicDensity (z : ℍ) : NNReal :=
  ((1 : NNReal) / NNReal.mk z.im z.im_pos.le) ^ 2

@[simp]
theorem hyperbolicDensity_coe (z : ℍ) :
    (hyperbolicDensity z : ℝ) = (1 / z.im) ^ 2 := by
  simp [hyperbolicDensity, one_div]

theorem hyperbolicDensity_continuous :
    Continuous hyperbolicDensity := by
  have hOne : Continuous (fun _ : ℍ => (1 : NNReal)) := continuous_const
  have hIm : Continuous (fun z : ℍ => NNReal.mk z.im z.im_pos.le) :=
    UpperHalfPlane.continuous_im.subtype_mk _
  exact (hOne.div₀ hIm (fun z hz => by
    apply z.im_ne_zero
    have hcoe := congrArg (fun x : NNReal => (x : ℝ)) hz
    simpa using hcoe)).pow 2

theorem hyperbolicDensity_measurable :
    Measurable hyperbolicDensity :=
  hyperbolicDensity_continuous.measurable

theorem hyperbolicMeasure_eq_euclidean_withDensity :
    hyperbolicMeasure =
      upperEuclideanMeasure.withDensity fun z => hyperbolicDensity z := by
  simpa only [upperEuclideanMeasure, hyperbolicDensity] using
    hyperbolicMeasure_def

/-- Euclidean area restricted to the actual chosen closed carrier. -/
noncomputable abbrev chosenEuclideanCarrierMeasure : Measure ℍ :=
  upperEuclideanMeasure.restrict
    chosenGammaTwoFundamentalDomain.carrier

/-- The concrete scalar `L²` space in which local distributions are tested. -/
noncomputable abbrev OrbitEuclideanL2 (_n : ℤ) :=
  MeasureTheory.Lp ℂ 2 chosenEuclideanCarrierMeasure

/-- Exponent of the Euclidean gauge.  The `-1` is precisely the square root
of the hyperbolic density `y⁻²`. -/
noncomputable def euclideanGaugeExponent (n : ℤ) : ℝ :=
  ((paperOrbitExponent n : ℤ) : ℝ) / 4 - 1

/-- Euclidean-gauge representative of a Petersson compact-core vector. -/
noncomputable def orbitEuclideanGauge (n : ℤ)
    (u : OrbitPeterssonCore n) : ℍ → ℂ :=
  fun z => ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) *
    SmoothCompactWeightCore.toSection u.toSmoothCore z

@[simp]
theorem orbitEuclideanGauge_add (n : ℤ)
    (u v : OrbitPeterssonCore n) :
    orbitEuclideanGauge n (u + v) =
      orbitEuclideanGauge n u + orbitEuclideanGauge n v := by
  funext z
  simp only [orbitEuclideanGauge, toSmoothCore_add,
    SmoothCompactWeightCore.add_apply, Pi.add_apply]
  ring

@[simp]
theorem orbitEuclideanGauge_smul (n : ℤ) (c : ℂ)
    (u : OrbitPeterssonCore n) :
    orbitEuclideanGauge n (c • u) = c • orbitEuclideanGauge n u := by
  funext z
  simp only [orbitEuclideanGauge, toSmoothCore_smul,
    SmoothCompactWeightCore.smul_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- The gauge representative remains real `C∞`. -/
theorem orbitEuclideanGauge_realSmooth (n : ℤ)
    (u : OrbitPeterssonCore n) :
    RealSmooth (orbitEuclideanGauge n u) := by
  change RealSmooth
    ((fun z : ℍ =>
        ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ)) *
      (SmoothCompactWeightCore.toSection u.toSmoothCore : ℍ → ℂ))
  exact (realSmooth_complexHeightRpow (euclideanGaugeExponent n)).mul
    (SmoothCompactWeightCore.realSmooth u.toSmoothCore)

theorem orbitEuclideanGauge_continuous (n : ℤ)
    (u : OrbitPeterssonCore n) :
    Continuous (orbitEuclideanGauge n u) :=
  (orbitEuclideanGauge_realSmooth n u).continuous

/-- The elementary power identity behind the gauge isometry. -/
theorem euclideanGaugeScale_sq (n : ℤ) (z : ℍ) :
    (z.im ^ euclideanGaugeExponent n) ^ 2 =
      (hyperbolicDensity z : ℝ) *
        weightFiberScale (-paperOrbitExponent n) z := by
  rw [weightFiberScale_neg_eq_heightRpow]
  have hy : 0 < z.im := z.im_pos
  have hy0 : z.im ≠ 0 := ne_of_gt hy
  calc
    (z.im ^ euclideanGaugeExponent n) ^ 2 =
        z.im ^ (euclideanGaugeExponent n * 2) := by
      rw [← Real.rpow_two, ← Real.rpow_mul hy.le]
    _ = z.im ^
        ((((paperOrbitExponent n : ℤ) : ℝ) / 2) - 2) := by
      congr 1
      simp only [euclideanGaugeExponent]
      ring
    _ = z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) /
        z.im ^ (2 : ℝ) :=
      Real.rpow_sub hy _ _
    _ = (1 / z.im) ^ 2 *
        z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) := by
      rw [Real.rpow_two]
      field_simp [hy0]
      <;> ring
    _ = (hyperbolicDensity z : ℝ) *
        z.im ^ (((paperOrbitExponent n : ℤ) : ℝ) / 2) := by
      rw [hyperbolicDensity_coe]

/-- Pointwise Hermitian products in the Euclidean gauge are the Petersson
products multiplied by the hyperbolic density. -/
theorem orbitEuclideanGauge_inner (n : ℤ)
    (u v : OrbitPeterssonCore n) (z : ℍ) :
    inner ℂ (orbitEuclideanGauge n u z)
        (orbitEuclideanGauge n v z) =
      hyperbolicDensity z •
        upstairsInnerDensity (OrbitMultiplier n)
          u.toSmoothCore v.toSmoothCore z := by
  change
    inner ℂ
        (((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) •
          SmoothCompactWeightCore.toSection u.toSmoothCore z)
        (((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) •
          SmoothCompactWeightCore.toSection v.toSmoothCore z) =
      hyperbolicDensity z •
        upstairsInnerDensity (OrbitMultiplier n)
          u.toSmoothCore v.toSmoothCore z
  rw [inner_smul_left, inner_smul_right]
  unfold upstairsInnerDensity
    InvariantFiberMetric.pointwiseInnerDensity
    InvariantFiberMetric.weightFiberMetric
  have hScale := congrArg (fun r : ℝ => (r : ℂ))
    (euclideanGaugeScale_sq n z)
  simp only [Complex.ofReal_mul, Complex.ofReal_pow] at hScale
  simp only [RCLike.inner_apply, Complex.conj_ofReal, starRingEnd_apply,
    NNReal.smul_def, smul_eq_mul, Complex.ofReal_mul]
  have hReal :
      star (((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ)) =
        (((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ)) := by
    simp
  rw [hReal, ← mul_assoc, ← pow_two, hScale]
  rw [Complex.real_smul]
  ring

/-- Squared pointwise norms satisfy the corresponding real identity. -/
theorem orbitEuclideanGauge_norm_sq (n : ℤ)
    (u : OrbitPeterssonCore n) (z : ℍ) :
    ‖orbitEuclideanGauge n u z‖ ^ 2 =
      hyperbolicDensity z •
        upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z := by
  calc
    ‖orbitEuclideanGauge n u z‖ ^ 2 =
        (inner ℂ (orbitEuclideanGauge n u z)
          (orbitEuclideanGauge n u z)).re :=
      norm_sq_eq_re_inner (𝕜 := ℂ) _
    _ = _ := by
      have hre := congrArg Complex.re
        (orbitEuclideanGauge_inner n u u z)
      simpa only [upstairsInnerDensity_self, upstairsNormSqDensity,
        NNReal.smul_def, Complex.smul_re, Complex.ofReal_re,
        smul_eq_mul] using hre

/-- The Euclidean-gauge representative belongs to the concrete carrier
`L²` space. -/
theorem orbitEuclideanGauge_memLp (n : ℤ)
    (u : OrbitPeterssonCore n) :
    MemLp (orbitEuclideanGauge n u) 2
      chosenEuclideanCarrierMeasure := by
  apply (memLp_two_iff_integrable_sq_norm
    (orbitEuclideanGauge_continuous n u).aestronglyMeasurable).2
  have hHyperbolic := upstairsInnerDensity_integrableOn
    (OrbitMultiplier n) u.toSmoothCore u.toSmoothCore
      chosenGammaTwoFundamentalDomain
  have hNormHyperbolic :
      Integrable
        (upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore)
        (hyperbolicMeasure.restrict
          chosenGammaTwoFundamentalDomain.carrier) := by
    convert hHyperbolic.re using 1
    funext z
    simp only [upstairsInnerDensity_self, upstairsNormSqDensity]
    exact (Complex.ofReal_re _).symm
  rw [hyperbolicMeasure_eq_euclidean_withDensity,
    MeasureTheory.restrict_withDensity
      (μ := upperEuclideanMeasure)
      chosenGammaTwoFundamentalDomain.carrier_measurable
      (fun z => (hyperbolicDensity z : ℝ≥0∞))] at hNormHyperbolic
  have hWeighted :=
    (integrable_withDensity_iff_integrable_smul
      (μ := chosenEuclideanCarrierMeasure)
      hyperbolicDensity_measurable).mp hNormHyperbolic
  simpa only [orbitEuclideanGauge_norm_sq] using hWeighted

/-- Linear Euclidean-gauge realization of the normed Petersson compact core. -/
noncomputable def orbitPeterssonCoreToEuclideanL2 (n : ℤ) :
    OrbitPeterssonCore n →ₗ[ℂ] OrbitEuclideanL2 n where
  toFun u := (orbitEuclideanGauge_memLp n u).toLp
    (orbitEuclideanGauge n u)
  map_add' u v := by
    simpa only [orbitEuclideanGauge_add] using
      (MemLp.toLp_add (orbitEuclideanGauge_memLp n u)
        (orbitEuclideanGauge_memLp n v))
  map_smul' c u := by
    change
      (orbitEuclideanGauge_memLp n (c • u)).toLp
          (orbitEuclideanGauge n (c • u)) =
        c • (orbitEuclideanGauge_memLp n u).toLp
          (orbitEuclideanGauge n u)
    simpa only [orbitEuclideanGauge_smul] using
      (MemLp.toLp_const_smul c (orbitEuclideanGauge_memLp n u))

/-- The `L²` class has the literal gauge function as representative. -/
theorem coeFn_orbitPeterssonCoreToEuclideanL2 (n : ℤ)
    (u : OrbitPeterssonCore n) :
    ⇑(orbitPeterssonCoreToEuclideanL2 n u) =ᵐ[
      chosenEuclideanCarrierMeasure] orbitEuclideanGauge n u := by
  change
    ⇑((orbitEuclideanGauge_memLp n u).toLp
      (orbitEuclideanGauge n u)) =ᵐ[
        chosenEuclideanCarrierMeasure] orbitEuclideanGauge n u
  exact MemLp.coeFn_toLp (orbitEuclideanGauge_memLp n u)

/-- The concrete realization preserves the full Petersson inner product. -/
theorem inner_orbitPeterssonCoreToEuclideanL2 (n : ℤ)
    (u v : OrbitPeterssonCore n) :
    inner ℂ (orbitPeterssonCoreToEuclideanL2 n u)
        (orbitPeterssonCoreToEuclideanL2 n v) = inner ℂ u v := by
  rw [MeasureTheory.L2.inner_def]
  calc
    (∫ z, inner ℂ
          (orbitPeterssonCoreToEuclideanL2 n u z)
          (orbitPeterssonCoreToEuclideanL2 n v z)
        ∂chosenEuclideanCarrierMeasure) =
        ∫ z, inner ℂ (orbitEuclideanGauge n u z)
          (orbitEuclideanGauge n v z)
        ∂chosenEuclideanCarrierMeasure := by
      apply integral_congr_ae
      filter_upwards [
        coeFn_orbitPeterssonCoreToEuclideanL2 n u,
        coeFn_orbitPeterssonCoreToEuclideanL2 n v] with z huz hvz
      rw [huz, hvz]
    _ = ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        hyperbolicDensity z •
          upstairsInnerDensity (OrbitMultiplier n)
            u.toSmoothCore v.toSmoothCore z
        ∂upperEuclideanMeasure := by
      exact integral_congr_ae (Filter.Eventually.of_forall fun z =>
        orbitEuclideanGauge_inner n u v z)
    _ = ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        upstairsInnerDensity (OrbitMultiplier n)
          u.toSmoothCore v.toSmoothCore z
        ∂hyperbolicMeasure := by
      rw [hyperbolicMeasure_eq_euclidean_withDensity,
        setIntegral_withDensity_eq_setIntegral_smul
          hyperbolicDensity_measurable _
          chosenGammaTwoFundamentalDomain.carrier_measurable]
    _ = peterssonForm (OrbitMultiplier n)
        chosenGammaTwoFundamentalDomain
          u.toSmoothCore v.toSmoothCore :=
      (peterssonForm_eq_fundamentalDomainIntegral
        (OrbitMultiplier n) chosenGammaTwoFundamentalDomain
          u.toSmoothCore v.toSmoothCore).symm
    _ = inner ℂ u v :=
      (PeterssonCoreSpace.inner_eq_peterssonForm u v).symm

/-- The compact-core realization as a linear isometry. -/
noncomputable def orbitPeterssonCoreEuclideanIsometry (n : ℤ) :
    OrbitPeterssonCore n →ₗᵢ[ℂ] OrbitEuclideanL2 n :=
  (orbitPeterssonCoreToEuclideanL2 n).isometryOfInner
    (inner_orbitPeterssonCoreToEuclideanL2 n)

/-- Extension of the concrete gauge realization to the full Petersson
Hilbert completion. -/
noncomputable def orbitPeterssonEuclideanEmbedding (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ] OrbitEuclideanL2 n :=
  (orbitPeterssonCoreEuclideanIsometry n).toContinuousLinearMap.extend
    (UniformSpace.Completion.toComplL :
      OrbitPeterssonCore n →L[ℂ] OrbitPeterssonHilbert n)

@[simp]
theorem orbitPeterssonEuclideanEmbedding_coe (n : ℤ)
    (u : OrbitPeterssonCore n) :
    orbitPeterssonEuclideanEmbedding n
        (u : OrbitPeterssonHilbert n) =
      orbitPeterssonCoreToEuclideanL2 n u := by
  unfold orbitPeterssonEuclideanEmbedding
  exact ContinuousLinearMap.extend_eq _
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : OrbitPeterssonCore n → OrbitPeterssonHilbert n))
    (by
      simpa using
        (UniformSpace.Completion.isUniformInducing_coe
          (OrbitPeterssonCore n))) u

theorem orbitPeterssonEuclideanEmbedding_norm (n : ℤ)
    (x : OrbitPeterssonHilbert n) :
    ‖orbitPeterssonEuclideanEmbedding n x‖ = ‖x‖ := by
  refine UniformSpace.Completion.denseRange_coe.induction_on x
    (isClosed_eq (orbitPeterssonEuclideanEmbedding n).continuous.norm
      continuous_norm) ?_
  intro u
  rw [orbitPeterssonEuclideanEmbedding_coe,
    UniformSpace.Completion.norm_coe]
  change ‖orbitPeterssonCoreEuclideanIsometry n u‖ = ‖u‖
  exact (orbitPeterssonCoreEuclideanIsometry n).norm_map u

/-- The completed Petersson realization is an actual linear isometry. -/
noncomputable def orbitPeterssonEuclideanIsometry (n : ℤ) :
    OrbitPeterssonHilbert n →ₗᵢ[ℂ] OrbitEuclideanL2 n where
  toLinearMap := (orbitPeterssonEuclideanEmbedding n).toLinearMap
  norm_map' := orbitPeterssonEuclideanEmbedding_norm n

theorem orbitPeterssonEuclideanEmbedding_injective (n : ℤ) :
    Function.Injective (orbitPeterssonEuclideanEmbedding n) :=
  (orbitPeterssonEuclideanIsometry n).injective

/-- On the fixed-phase smooth core, the completed embedding is represented
by the literal Euclidean gauge of the original section. -/
theorem coeFn_embedding_l2Coordinate (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ⇑(orbitPeterssonEuclideanEmbedding n (l2Coordinate n u)) =ᵐ[
      chosenEuclideanCarrierMeasure]
      (fun z =>
        ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) *
          ((u : SmoothQuotientCompactFunction) z)) := by
  rw [l2Coordinate_apply, PeterssonCoreSpace.toCompletion_apply,
    orbitPeterssonEuclideanEmbedding_coe]
  have h :=
    coeFn_orbitPeterssonCoreToEuclideanL2 n (coreEmbedding n u)
  filter_upwards [h] with z hz
  simpa only [orbitEuclideanGauge, coreEmbedding_toSmoothCore,
    InverseEtaFixedPhaseCore.toSmoothCompactWeightCore_apply] using hz

/-! #### Exact Euclidean-gauge formulas for the physical operators -/

/-- Literal Euclidean gauge of a fixed-phase smooth vector. -/
noncomputable def fixedPhaseEuclideanGauge (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) : ℍ → ℂ :=
  orbitEuclideanGauge n (coreEmbedding n u)

@[simp]
theorem fixedPhaseEuclideanGauge_apply (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    fixedPhaseEuclideanGauge n u z =
      ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) *
        ((u : SmoothQuotientCompactFunction) z) := by
  simp only [fixedPhaseEuclideanGauge, orbitEuclideanGauge,
    coreEmbedding_toSmoothCore,
    InverseEtaFixedPhaseCore.toSmoothCompactWeightCore_apply]

/-- The literal fixed-phase gauge is real `C∞`. -/
theorem fixedPhaseEuclideanGauge_realSmooth (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    RealSmooth (fixedPhaseEuclideanGauge n u) :=
  orbitEuclideanGauge_realSmooth n (coreEmbedding n u)

@[simp]
theorem euclideanGaugeExponent_succ (n : ℤ) :
    euclideanGaugeExponent (n + 1) =
      euclideanGaugeExponent n + 1 := by
  simp only [euclideanGaugeExponent, paperOrbitExponent_add_one]
  push_cast
  ring

/-- A successor in the fixed-phase tower multiplies its Euclidean gauge by
one power of the height. -/
theorem euclideanGaugeScale_succ (n : ℤ) (z : ℍ) :
    ((z.im ^ euclideanGaugeExponent (n + 1) : ℝ) : ℂ) =
      heightC z *
        ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) := by
  rw [euclideanGaugeExponent_succ,
    Real.rpow_add z.im_pos, Real.rpow_one]
  simp only [heightC, Complex.ofReal_mul]
  ring

/-- Exact complex form of `d(y^p)/dy = (p/y)y^p` on the upper
half-plane. -/
theorem complex_rpow_derivative_eq_div (p : ℝ) (z : ℍ) :
    ((p * z.im ^ (p - 1) : ℝ) : ℂ) =
      (p : ℂ) / heightC z * ((z.im ^ p : ℝ) : ℂ) := by
  rw [Real.rpow_sub_one z.im_ne_zero]
  simp only [heightC, Complex.ofReal_mul, Complex.ofReal_div]
  ring

/-- Horizontal derivative of the literal Euclidean gauge. -/
theorem dx_fixedPhaseEuclideanGauge (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    dx (fixedPhaseEuclideanGauge n u) z =
      ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) *
        dx (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) z := by
  change dx
    ((fun w : ℍ =>
        ((w.im ^ euclideanGaugeExponent n : ℝ) : ℂ)) *
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ))) z = _
  have hProd :=
    dx_mul
      (u := fun w : ℍ =>
        ((w.im ^ euclideanGaugeExponent n : ℝ) : ℂ))
      (v := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
      (realSmooth_complexHeightRpow (euclideanGaugeExponent n))
      u.1.1.2 z
  simpa only [dx_complexHeightRpow, Pi.mul_apply, zero_mul,
    zero_add] using hProd

/-- Vertical derivative of the literal Euclidean gauge, including the
derivative of its height power. -/
theorem dy_fixedPhaseEuclideanGauge (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    dy (fixedPhaseEuclideanGauge n u) z =
      ((euclideanGaugeExponent n *
          z.im ^ (euclideanGaugeExponent n - 1) : ℝ) : ℂ) *
          ((u : SmoothQuotientCompactFunction) z) +
        ((z.im ^ euclideanGaugeExponent n : ℝ) : ℂ) *
          dy (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) z := by
  change dy
    ((fun w : ℍ =>
        ((w.im ^ euclideanGaugeExponent n : ℝ) : ℂ)) *
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ))) z = _
  have hProd :=
    dy_mul
      (u := fun w : ℍ =>
        ((w.im ^ euclideanGaugeExponent n : ℝ) : ℂ))
      (v := ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
      (realSmooth_complexHeightRpow (euclideanGaugeExponent n))
      u.1.1.2 z
  simpa only [dy_complexHeightRpow, Pi.mul_apply] using hProd

/-- Euclidean-gauge raising expression.  Its zeroth-order coefficient is
`p+2`, where `p=a/4-1` is the source gauge exponent. -/
noncomputable def euclideanRaiseGauge (n : ℤ)
    (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  Complex.I * heightC z * dx f z +
    heightC z * dy f z +
    ((euclideanGaugeExponent n + 2 : ℝ) : ℂ) * f z

/-- Euclidean-gauge lowering expression from the successor orbit. -/
noncomputable def euclideanLowerFromSuccGauge (n : ℤ)
    (f : ℍ → ℂ) (z : ℍ) : ℂ :=
  -Complex.I * heightC z * dx f z +
    heightC z * dy f z -
    ((euclideanGaugeExponent n + 1 : ℝ) : ℂ) * f z

/-- The physical exponent is exactly twice `p+1` in the Euclidean gauge. -/
theorem physicalExponent_eq_twice_gaugeShift (n : ℤ) :
    physicalExponent (paperOrbitExponent n) =
      ((2 * (euclideanGaugeExponent n + 1) : ℝ) : ℂ) := by
  unfold physicalExponent euclideanGaugeExponent
  push_cast
  ring

/-- Exact pointwise conjugation of the typed raising operator by the
Euclidean Petersson gauge. -/
theorem fixedPhaseEuclideanGauge_raise (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    fixedPhaseEuclideanGauge (n + 1)
        (InverseEtaFixedPhaseCore.raise n u) z =
      euclideanRaiseGauge n (fixedPhaseEuclideanGauge n u) z := by
  simp only [fixedPhaseEuclideanGauge_apply,
    InverseEtaFixedPhaseCore.raise_apply]
  unfold euclideanRaiseGauge raiseRaw
  rw [dx_fixedPhaseEuclideanGauge,
    dy_fixedPhaseEuclideanGauge,
    euclideanGaugeScale_succ,
    complex_rpow_derivative_eq_div,
    physicalExponent_eq_twice_gaugeShift,
    fixedPhaseEuclideanGauge_apply]
  have hz : heightC z ≠ 0 := by
    exact Complex.ofReal_ne_zero.mpr z.im_ne_zero
  field_simp [hz]
  push_cast
  ring

/-- Exact pointwise conjugation of lowering from the successor orbit by the
Euclidean Petersson gauge. -/
theorem fixedPhaseEuclideanGauge_lowerFromSucc (n : ℤ)
    (v : InverseEtaFixedPhaseCore (n + 1)) (z : ℍ) :
    fixedPhaseEuclideanGauge n
        (InverseEtaFixedPhaseCore.lowerFromSucc n v) z =
      euclideanLowerFromSuccGauge n
        (fixedPhaseEuclideanGauge (n + 1) v) z := by
  simp only [fixedPhaseEuclideanGauge_apply,
    InverseEtaFixedPhaseCore.lowerFromSucc_apply]
  unfold euclideanLowerFromSuccGauge lowerRaw
  rw [dx_fixedPhaseEuclideanGauge,
    dy_fixedPhaseEuclideanGauge,
    euclideanGaugeScale_succ,
    euclideanGaugeExponent_succ,
    complex_rpow_derivative_eq_div,
    fixedPhaseEuclideanGauge_apply]
  have hz : heightC z ≠ 0 := by
    exact Complex.ofReal_ne_zero.mpr z.im_ne_zero
  rw [euclideanGaugeExponent_succ]
  field_simp [hz]
  push_cast
  ring

/-! #### Compact Hermitian test transposes -/

abbrev AmbientTestCore := HalfWeightCompactCoordinateGreen.Core

/-- Raising preserves real smoothness after Euclidean gauge conjugation. -/
theorem euclideanRaiseGauge_realSmooth (n : ℤ)
    {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (euclideanRaiseGauge n f) := by
  have h : RealSmooth
      ((Complex.I • (heightC * dx f)) +
        (heightC * dy f) +
        (((euclideanGaugeExponent n + 2 : ℝ) : ℂ) • f)) :=
    RealSmooth.add
      (RealSmooth.add
        (RealSmooth.const_complex_smul Complex.I
          (RealSmooth.mul realSmooth_heightC (RealSmooth.dx hf)))
        (RealSmooth.mul realSmooth_heightC (RealSmooth.dy hf)))
      (RealSmooth.const_complex_smul
        ((euclideanGaugeExponent n + 2 : ℝ) : ℂ) hf)
  have hEq :
      euclideanRaiseGauge n f =
        (Complex.I • (heightC * dx f)) +
          (heightC * dy f) +
          (((euclideanGaugeExponent n + 2 : ℝ) : ℂ) • f) := by
    funext z
    simp only [euclideanRaiseGauge, Pi.add_apply, Pi.mul_apply,
      Pi.smul_apply, smul_eq_mul]
    ring
  rw [hEq]
  exact h

/-- Lowering preserves real smoothness after Euclidean gauge conjugation. -/
theorem euclideanLowerFromSuccGauge_realSmooth (n : ℤ)
    {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (euclideanLowerFromSuccGauge n f) := by
  have h : RealSmooth
      (((-Complex.I) • (heightC * dx f)) +
        (heightC * dy f) -
        (((euclideanGaugeExponent n + 1 : ℝ) : ℂ) • f)) :=
    RealSmooth.sub
      (RealSmooth.add
        (RealSmooth.const_complex_smul (-Complex.I)
          (RealSmooth.mul realSmooth_heightC (RealSmooth.dx hf)))
        (RealSmooth.mul realSmooth_heightC (RealSmooth.dy hf)))
      (RealSmooth.const_complex_smul
        ((euclideanGaugeExponent n + 1 : ℝ) : ℂ) hf)
  have hEq :
      euclideanLowerFromSuccGauge n f =
        ((-Complex.I) • (heightC * dx f)) +
          (heightC * dy f) -
          (((euclideanGaugeExponent n + 1 : ℝ) : ℂ) • f) := by
    funext z
    simp only [euclideanLowerFromSuccGauge, Pi.add_apply, Pi.sub_apply,
      Pi.mul_apply, Pi.smul_apply, smul_eq_mul]
    ring
  rw [hEq]
  exact h

/-- Compact-core Hermitian transpose of the Euclidean raising expression.
The `+I` sign is forced by conjugating the first argument before horizontal
integration by parts. -/
noncomputable def euclideanRaiseTestAdjoint (n : ℤ)
    (v : AmbientTestCore) : AmbientTestCore :=
  Complex.I • HalfWeightCompactCoordinateGreen.rpowMul 1
      (HalfWeightCompactCoordinateGreen.dx v) -
    HalfWeightCompactCoordinateGreen.rpowMul 1
      (HalfWeightCompactCoordinateGreen.dy v) +
    ((euclideanGaugeExponent n + 1 : ℝ) : ℂ) • v

/-- Compact-core Hermitian transpose of Euclidean lowering from the successor
orbit. -/
noncomputable def euclideanLowerFromSuccTestAdjoint (n : ℤ)
    (v : AmbientTestCore) : AmbientTestCore :=
  (-Complex.I) • HalfWeightCompactCoordinateGreen.rpowMul 1
      (HalfWeightCompactCoordinateGreen.dx v) -
    HalfWeightCompactCoordinateGreen.rpowMul 1
      (HalfWeightCompactCoordinateGreen.dy v) -
    ((euclideanGaugeExponent n + 2 : ℝ) : ℂ) • v

/-- The raising test transpose cannot enlarge test support. -/
theorem tsupport_euclideanRaiseTestAdjoint_subset (n : ℤ)
    (v : AmbientTestCore) :
    tsupport (euclideanRaiseTestAdjoint n v : ℂ → ℂ) ⊆
      tsupport (v : ℂ → ℂ) := by
  intro w hw
  by_contra hwv
  have hx : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.rpowMul 1
        (HalfWeightCompactCoordinateGreen.dx v) : ℂ → ℂ) :=
    fun h => hwv <|
      (HalfWeightCompactCoordinateGreen.tsupport_rpowMul_subset 1
        (HalfWeightCompactCoordinateGreen.dx v)).trans
          (HalfWeightCompactCoordinateGreen.tsupport_dx_subset v) h
  have hy : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.rpowMul 1
        (HalfWeightCompactCoordinateGreen.dy v) : ℂ → ℂ) :=
    fun h => hwv <|
      (HalfWeightCompactCoordinateGreen.tsupport_rpowMul_subset 1
        (HalfWeightCompactCoordinateGreen.dy v)).trans
          (HalfWeightCompactCoordinateGreen.tsupport_dy_subset v) h
  have hx0 := notMem_tsupport_iff_eventuallyEq.mp hx
  have hy0 := notMem_tsupport_iff_eventuallyEq.mp hy
  have hv0 := notMem_tsupport_iff_eventuallyEq.mp hwv
  have hzero : (euclideanRaiseTestAdjoint n v : ℂ → ℂ) =ᶠ[nhds w] 0 := by
    filter_upwards [hx0, hy0, hv0] with z hzx hzy hzv
    simp [euclideanRaiseTestAdjoint, hzx, hzy, hzv]
  exact (notMem_tsupport_iff_eventuallyEq.mpr hzero) hw

/-- The lowering test transpose cannot enlarge test support. -/
theorem tsupport_euclideanLowerFromSuccTestAdjoint_subset (n : ℤ)
    (v : AmbientTestCore) :
    tsupport (euclideanLowerFromSuccTestAdjoint n v : ℂ → ℂ) ⊆
      tsupport (v : ℂ → ℂ) := by
  intro w hw
  by_contra hwv
  have hx : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.rpowMul 1
        (HalfWeightCompactCoordinateGreen.dx v) : ℂ → ℂ) :=
    fun h => hwv <|
      (HalfWeightCompactCoordinateGreen.tsupport_rpowMul_subset 1
        (HalfWeightCompactCoordinateGreen.dx v)).trans
          (HalfWeightCompactCoordinateGreen.tsupport_dx_subset v) h
  have hy : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.rpowMul 1
        (HalfWeightCompactCoordinateGreen.dy v) : ℂ → ℂ) :=
    fun h => hwv <|
      (HalfWeightCompactCoordinateGreen.tsupport_rpowMul_subset 1
        (HalfWeightCompactCoordinateGreen.dy v)).trans
          (HalfWeightCompactCoordinateGreen.tsupport_dy_subset v) h
  have hx0 := notMem_tsupport_iff_eventuallyEq.mp hx
  have hy0 := notMem_tsupport_iff_eventuallyEq.mp hy
  have hv0 := notMem_tsupport_iff_eventuallyEq.mp hwv
  have hzero :
      (euclideanLowerFromSuccTestAdjoint n v : ℂ → ℂ) =ᶠ[nhds w] 0 := by
    filter_upwards [hx0, hy0, hv0] with z hzx hzy hzv
    simp [euclideanLowerFromSuccTestAdjoint, hzx, hzy, hzv]
  exact (notMem_tsupport_iff_eventuallyEq.mpr hzero) hw

/-! Small algebraic rules for one-sided localization. -/

theorem localizeLeft_add_right (f : ℍ → ℂ) (hf : RealSmooth f)
    (u v : AmbientTestCore) :
    HalfWeightCompactCoordinateGreen.localizeLeft f hf (u + v) =
      HalfWeightCompactCoordinateGreen.localizeLeft f hf u +
        HalfWeightCompactCoordinateGreen.localizeLeft f hf v := by
  apply TestFunction.ext
  intro w
  simp [HalfWeightCompactCoordinateGreen.localizeLeft_apply]
  ring

theorem localizeLeft_sub_right (f : ℍ → ℂ) (hf : RealSmooth f)
    (u v : AmbientTestCore) :
    HalfWeightCompactCoordinateGreen.localizeLeft f hf (u - v) =
      HalfWeightCompactCoordinateGreen.localizeLeft f hf u -
        HalfWeightCompactCoordinateGreen.localizeLeft f hf v := by
  apply TestFunction.ext
  intro w
  simp [HalfWeightCompactCoordinateGreen.localizeLeft_apply]
  ring

theorem localizeLeft_smul_right (c : ℂ) (f : ℍ → ℂ)
    (hf : RealSmooth f) (v : AmbientTestCore) :
    HalfWeightCompactCoordinateGreen.localizeLeft f hf (c • v) =
      c • HalfWeightCompactCoordinateGreen.localizeLeft f hf v := by
  apply TestFunction.ext
  intro w
  simp [HalfWeightCompactCoordinateGreen.localizeLeft_apply,
    smul_eq_mul]
  ring

theorem integral_ambientTestCore_add (u v : AmbientTestCore) :
    (∫ w : ℂ, (u + v) w) = (∫ w : ℂ, u w) + ∫ w : ℂ, v w := by
  exact integral_add
    (HalfWeightCompactCoordinateGreen.core_integrable u)
    (HalfWeightCompactCoordinateGreen.core_integrable v)

theorem integral_ambientTestCore_sub (u v : AmbientTestCore) :
    (∫ w : ℂ, (u - v) w) = (∫ w : ℂ, u w) - ∫ w : ℂ, v w := by
  exact integral_sub
    (HalfWeightCompactCoordinateGreen.core_integrable u)
    (HalfWeightCompactCoordinateGreen.core_integrable v)

theorem integral_ambientTestCore_smul (c : ℂ) (v : AmbientTestCore) :
    (∫ w : ℂ, (c • v) w) = c * ∫ w : ℂ, v w := by
  change (∫ w : ℂ, c * v w) = _
  exact integral_const_mul c (v : ℂ → ℂ)

/-- Hermitian compact-test pairing written as an actual planar integral. -/
noncomputable def ambientCompactHermitianPair
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : AmbientTestCore) : ℂ :=
  ∫ w : ℂ,
    HalfWeightCompactCoordinateGreen.localizeLeft
      (fun z => star (f z)) (RealSmooth.conj hf) v w

/-- Pointwise localization of the starred Euclidean raising expression into
the three terms to which one-sided integration by parts applies. -/
theorem localizeStar_euclideanRaiseGauge (n : ℤ)
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : AmbientTestCore) :
    HalfWeightCompactCoordinateGreen.localizeLeft
        (fun z => star (euclideanRaiseGauge n f z))
        (RealSmooth.conj (euclideanRaiseGauge_realSmooth n hf)) v =
      (-Complex.I) •
          HalfWeightCompactCoordinateGreen.localizeLeft
            (dx (fun z => star (f z)))
            (RealSmooth.dx (RealSmooth.conj hf))
            (HalfWeightCompactCoordinateGreen.rpowMul 1 v) +
        HalfWeightCompactCoordinateGreen.localizeLeft
          (dy (fun z => star (f z)))
          (RealSmooth.dy (RealSmooth.conj hf))
          (HalfWeightCompactCoordinateGreen.rpowMul 1 v) +
        ((euclideanGaugeExponent n + 2 : ℝ) : ℂ) •
          HalfWeightCompactCoordinateGreen.localizeLeft
            (fun z => star (f z)) (RealSmooth.conj hf) v := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · let z : ℍ := ⟨w, hw⟩
    simp only [HalfWeightCompactCoordinateGreen.localizeLeft_apply,
      HalfWeightCompactCoordinateGreen.rpowMul_apply]
    simp [HalfWeightCompactCoordinateGreen.rpowScale, upperLift,
      Function.comp_def, hw, dif_pos,
      UpperHalfPlane.ofComplex_apply_of_im_pos, z,
      euclideanRaiseGauge, map_add, map_mul,
      Complex.conj_I, Complex.conj_ofReal, heightC, smul_eq_mul]
    have hdx :
        dx (fun w => (starRingEnd ℂ) (f w)) z =
          (starRingEnd ℂ) (dx f z) := by
      simpa only [starRingEnd_apply] using dx_conj hf z
    have hdy :
        dy (fun w => (starRingEnd ℂ) (f w)) z =
          (starRingEnd ℂ) (dy f z) := by
      simpa only [starRingEnd_apply] using dy_conj hf z
    rw [hdx, hdy]
    norm_num
    ring
  · rw [HalfWeightCompactCoordinateGreen.eq_zero_of_not_im_pos _ hw,
      HalfWeightCompactCoordinateGreen.eq_zero_of_not_im_pos _ hw]

/-- The analogous pointwise localization for lowering. -/
theorem localizeStar_euclideanLowerFromSuccGauge (n : ℤ)
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : AmbientTestCore) :
    HalfWeightCompactCoordinateGreen.localizeLeft
        (fun z => star (euclideanLowerFromSuccGauge n f z))
        (RealSmooth.conj (euclideanLowerFromSuccGauge_realSmooth n hf)) v =
      Complex.I •
          HalfWeightCompactCoordinateGreen.localizeLeft
            (dx (fun z => star (f z)))
            (RealSmooth.dx (RealSmooth.conj hf))
            (HalfWeightCompactCoordinateGreen.rpowMul 1 v) +
        HalfWeightCompactCoordinateGreen.localizeLeft
          (dy (fun z => star (f z)))
          (RealSmooth.dy (RealSmooth.conj hf))
          (HalfWeightCompactCoordinateGreen.rpowMul 1 v) -
        ((euclideanGaugeExponent n + 1 : ℝ) : ℂ) •
          HalfWeightCompactCoordinateGreen.localizeLeft
            (fun z => star (f z)) (RealSmooth.conj hf) v := by
  apply TestFunction.ext
  intro w
  by_cases hw : 0 < w.im
  · let z : ℍ := ⟨w, hw⟩
    simp only [HalfWeightCompactCoordinateGreen.localizeLeft_apply,
      HalfWeightCompactCoordinateGreen.rpowMul_apply]
    simp [HalfWeightCompactCoordinateGreen.rpowScale, upperLift,
      Function.comp_def, hw, dif_pos,
      UpperHalfPlane.ofComplex_apply_of_im_pos, z,
      euclideanLowerFromSuccGauge, map_add, map_sub, map_mul, map_neg,
      Complex.conj_I, Complex.conj_ofReal, heightC, smul_eq_mul]
    have hdx :
        dx (fun w => (starRingEnd ℂ) (f w)) z =
          (starRingEnd ℂ) (dx f z) := by
      simpa only [starRingEnd_apply] using dx_conj hf z
    have hdy :
        dy (fun w => (starRingEnd ℂ) (f w)) z =
          (starRingEnd ℂ) (dy f z) := by
      simpa only [starRingEnd_apply] using dy_conj hf z
    rw [hdx, hdy]
    norm_num
    ring
  · rw [HalfWeightCompactCoordinateGreen.eq_zero_of_not_im_pos _ hw,
      HalfWeightCompactCoordinateGreen.eq_zero_of_not_im_pos _ hw]

/-- Exact one-sided Hermitian formal-adjoint identity for Euclidean raising.
No quotient boundary or Green certificate occurs. -/
theorem ambientCompactHermitianPair_raise (n : ℤ)
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : AmbientTestCore) :
    ambientCompactHermitianPair (euclideanRaiseGauge n f)
        (euclideanRaiseGauge_realSmooth n hf) v =
      ambientCompactHermitianPair f hf
        (euclideanRaiseTestAdjoint n v) := by
  have hx :=
    HalfWeightCompactCoordinateGreen.integral_height_dx_mul_test_eq_neg
      (fun z => star (f z)) (RealSmooth.conj hf) v
  have hy :=
    HalfWeightCompactCoordinateGreen.integral_height_dy_mul_test_eq_neg
      (fun z => star (f z)) (RealSmooth.conj hf) v
  rw [localizeLeft_add_right, integral_ambientTestCore_add] at hy
  unfold ambientCompactHermitianPair
  rw [localizeStar_euclideanRaiseGauge,
    integral_ambientTestCore_add, integral_ambientTestCore_add,
    integral_ambientTestCore_smul,
    euclideanRaiseTestAdjoint,
    localizeLeft_add_right, localizeLeft_sub_right,
    localizeLeft_smul_right, localizeLeft_smul_right,
    integral_ambientTestCore_add, integral_ambientTestCore_sub,
    integral_ambientTestCore_smul, integral_ambientTestCore_smul]
  rw [hx, hy]
  all_goals try exact hf
  simp only [smul_apply, smul_eq_mul]
  push_cast
  rw [integral_const_mul]
  ring

/-- Exact one-sided Hermitian formal-adjoint identity for Euclidean lowering.
No quotient boundary or Green certificate occurs. -/
theorem ambientCompactHermitianPair_lowerFromSucc (n : ℤ)
    (f : ℍ → ℂ) (hf : RealSmooth f) (v : AmbientTestCore) :
    ambientCompactHermitianPair (euclideanLowerFromSuccGauge n f)
        (euclideanLowerFromSuccGauge_realSmooth n hf) v =
      ambientCompactHermitianPair f hf
        (euclideanLowerFromSuccTestAdjoint n v) := by
  have hx :=
    HalfWeightCompactCoordinateGreen.integral_height_dx_mul_test_eq_neg
      (fun z => star (f z)) (RealSmooth.conj hf) v
  have hy :=
    HalfWeightCompactCoordinateGreen.integral_height_dy_mul_test_eq_neg
      (fun z => star (f z)) (RealSmooth.conj hf) v
  rw [localizeLeft_add_right, integral_ambientTestCore_add] at hy
  unfold ambientCompactHermitianPair
  rw [localizeStar_euclideanLowerFromSuccGauge,
    integral_ambientTestCore_sub, integral_ambientTestCore_add,
    integral_ambientTestCore_smul,
    euclideanLowerFromSuccTestAdjoint,
    localizeLeft_sub_right, localizeLeft_sub_right,
    localizeLeft_smul_right, localizeLeft_smul_right,
    integral_ambientTestCore_sub, integral_ambientTestCore_sub,
    integral_ambientTestCore_smul, integral_ambientTestCore_smul]
  rw [hx, hy]
  all_goals try exact hf
  simp only [smul_apply, smul_eq_mul]
  push_cast
  rw [integral_const_mul]
  ring

/-! #### Ambient carrier and distributional uniqueness

The local integration-by-parts core lives on `ℂ`, while the Petersson
completion is represented on `ℍ`.  We transport only the measure and the
`L²` representative along the canonical open embedding.  This avoids any
unproved extension theorem for smooth functions on the `UpperHalfPlane`
structure. -/

/-- Image in `ℂ` of the selected closed quotient carrier. -/
def ambientChosenCarrier : Set ℂ :=
  UpperHalfPlane.coe '' chosenGammaTwoFundamentalDomain.carrier

/-- Image in `ℂ` of the genuine open `Γ(2)` carrier. -/
def ambientGammaTwoOpenCarrier : Set ℂ :=
  UpperHalfPlane.coe '' gammaTwoOpenCarrier

theorem ambientGammaTwoOpenCarrier_isOpen :
    IsOpen ambientGammaTwoOpenCarrier := by
  exact UpperHalfPlane.isOpenEmbedding_coe.isOpenMap _
    gammaTwoOpenCarrier_isOpen

theorem ambientGammaTwoOpenCarrier_subset_ambientChosenCarrier :
    ambientGammaTwoOpenCarrier ⊆ ambientChosenCarrier := by
  exact Set.image_mono <| by
    rw [← gammaTwoClosedTileCarrier_eq_chosenCarrier]
    exact gammaTwoOpenCarrier_subset_closedTileCarrier

theorem ambientGammaTwoOpenCarrier_subset_upperPlaneOpen :
    ambientGammaTwoOpenCarrier ⊆
      HalfWeightCompactCoordinateGreen.upperPlaneOpen := by
  rintro w ⟨z, _hz, rfl⟩
  exact z.im_pos

/-- Euclidean area restricted to the image of the chosen carrier. -/
noncomputable abbrev ambientChosenEuclideanMeasure : Measure ℂ :=
  (volume : Measure ℂ).restrict ambientChosenCarrier

/-- The concrete carrier measure is transported exactly to restricted planar
Lebesgue measure. -/
theorem map_chosenEuclideanCarrierMeasure :
    Measure.map UpperHalfPlane.coe chosenEuclideanCarrierMeasure =
      ambientChosenEuclideanMeasure := by
  change
    ((volume.comap UpperHalfPlane.coe).restrict
        chosenGammaTwoFundamentalDomain.carrier).map
      UpperHalfPlane.coe =
        (volume : Measure ℂ).restrict
          (UpperHalfPlane.coe ''
            chosenGammaTwoFundamentalDomain.carrier)
  rw [UpperHalfPlane.measurableEmbedding_coe.restrict_comap,
    UpperHalfPlane.measurableEmbedding_coe.map_comap,
    Measure.restrict_restrict
      UpperHalfPlane.measurableEmbedding_coe.measurableSet_range,
    Set.inter_eq_right.mpr (Set.image_subset_range _ _)]

/-- The positive hyperbolic density never vanishes. -/
theorem hyperbolicDensity_ne_zero (z : ℍ) :
    (hyperbolicDensity z : ℝ≥0∞) ≠ 0 := by
  apply ENNReal.coe_ne_zero.mpr
  change (((1 : NNReal) / NNReal.mk z.im z.im_pos.le) ^ 2) ≠ 0
  apply pow_ne_zero
  exact div_ne_zero one_ne_zero <| by
    intro hz
    apply z.im_ne_zero
    have hcoe := congrArg (fun x : NNReal => (x : ℝ)) hz
    simpa using hcoe

/-- Euclidean area is absolutely continuous with respect to hyperbolic area
because their density is everywhere strictly positive. -/
theorem upperEuclideanMeasure_ac_hyperbolicMeasure :
    upperEuclideanMeasure ≪ hyperbolicMeasure := by
  rw [hyperbolicMeasure_eq_euclidean_withDensity]
  exact withDensity_absolutelyContinuous'
    (ENNReal.continuous_coe.comp
      hyperbolicDensity_continuous).aemeasurable
    (Filter.Eventually.of_forall hyperbolicDensity_ne_zero)

/-- The part of the chosen closed carrier omitted by the open carrier is also
Euclidean-null, not merely hyperbolic-null. -/
theorem chosenCarrier_diff_open_null_upperEuclidean :
    upperEuclideanMeasure
      (chosenGammaTwoFundamentalDomain.carrier \
        gammaTwoOpenCarrier) = 0 := by
  apply upperEuclideanMeasure_ac_hyperbolicMeasure
  rw [← gammaTwoClosedTileCarrier_eq_chosenCarrier]
  exact gammaTwoClosedTileCarrier_diff_openCarrier_null

/-- The open carrier has full measure for the selected Euclidean carrier
measure. -/
theorem ae_mem_open_chosenEuclidean :
    ∀ᵐ z ∂chosenEuclideanCarrierMeasure,
      z ∈ gammaTwoOpenCarrier := by
  change ∀ᵐ z ∂upperEuclideanMeasure.restrict
    chosenGammaTwoFundamentalDomain.carrier,
      z ∈ gammaTwoOpenCarrier
  rw [ae_restrict_iff'
    chosenGammaTwoFundamentalDomain.carrier_measurable]
  rw [ae_iff]
  have hset :
      {z : ℍ | ¬(z ∈ chosenGammaTwoFundamentalDomain.carrier →
        z ∈ gammaTwoOpenCarrier)} =
        chosenGammaTwoFundamentalDomain.carrier \
          gammaTwoOpenCarrier := by
    ext z
    simp
  rw [hset]
  exact chosenCarrier_diff_open_null_upperEuclidean

/-- Complexification of an arbitrary real ambient distribution test.  The
support hypothesis makes it an element of the already-defined genuine
`C_c^∞` upper-plane core. -/
noncomputable def ambientRealTestCore
    (g : ℂ → ℝ) (hg : ContDiff ℝ ∞ g)
    (hcompact : HasCompactSupport g)
    (hsupport : tsupport g ⊆ ambientGammaTwoOpenCarrier) :
    HalfWeightCompactCoordinateGreen.Core where
  toFun := Complex.ofRealCLM ∘ g
  contDiff' := Complex.ofRealCLM.contDiff.comp hg
  hasCompactSupport' := hcompact.comp_left rfl
  tsupport_subset' :=
    (tsupport_comp_subset rfl g).trans <|
      hsupport.trans
        ambientGammaTwoOpenCarrier_subset_upperPlaneOpen

@[simp]
theorem ambientRealTestCore_apply
    (g : ℂ → ℝ) (hg : ContDiff ℝ ∞ g)
    (hcompact : HasCompactSupport g)
    (hsupport : tsupport g ⊆ ambientGammaTwoOpenCarrier)
    (w : ℂ) :
    ambientRealTestCore g hg hcompact hsupport w = (g w : ℂ) :=
  rfl

theorem ambientRealTestCore_tsupport_subset
    (g : ℂ → ℝ) (hg : ContDiff ℝ ∞ g)
    (hcompact : HasCompactSupport g)
    (hsupport : tsupport g ⊆ ambientGammaTwoOpenCarrier) :
    tsupport
      ((ambientRealTestCore g hg hcompact hsupport :
        HalfWeightCompactCoordinateGreen.Core) : ℂ → ℂ) ⊆
      ambientGammaTwoOpenCarrier := by
  change tsupport (Complex.ofRealCLM ∘ g) ⊆
    ambientGammaTwoOpenCarrier
  exact (tsupport_comp_subset rfl g).trans hsupport

/-- Ambient zero-extension of the pointwise star of an `L²` carrier
representative.  On the upper half-plane it is literally `star (q z)`. -/
noncomputable def ambientStarRepresentative (n : ℤ)
    (q : OrbitEuclideanL2 n) : ℂ → ℂ :=
  upperLift (star (q : ℍ → ℂ))

@[simp]
theorem ambientStarRepresentative_apply (n : ℤ)
    (q : OrbitEuclideanL2 n) (z : ℍ) :
    ambientStarRepresentative n q (z : ℂ) = star (q z) := by
  simp only [ambientStarRepresentative, upperLift_apply,
    Pi.star_apply]

theorem ambientStarRepresentative_memLp (n : ℤ)
    (q : OrbitEuclideanL2 n) :
    MemLp (ambientStarRepresentative n q) 2
      ambientChosenEuclideanMeasure := by
  rw [← map_chosenEuclideanCarrierMeasure,
    UpperHalfPlane.measurableEmbedding_coe.memLp_map_measure_iff]
  have hcomp :
      ambientStarRepresentative n q ∘ UpperHalfPlane.coe =
        star (q : ℍ → ℂ) := by
    funext z
    simpa only [Function.comp_apply, Pi.star_apply] using
      ambientStarRepresentative_apply n q z
  rw [hcomp]
  exact (Lp.memLp q).star

theorem ambientStarRepresentative_locallyIntegrable (n : ℤ)
    (q : OrbitEuclideanL2 n) :
    LocallyIntegrable (ambientStarRepresentative n q)
      ambientChosenEuclideanMeasure :=
  (ambientStarRepresentative_memLp n q).locallyIntegrable (by norm_num)

/-- Restriction of an ambient compact test to the chosen carrier belongs to
every concrete orbit `L²` space. -/
theorem ambientTestCore_memLp_chosen (n : ℤ)
    (v : AmbientTestCore) :
    MemLp (fun z : ℍ => v (z : ℂ)) 2
      chosenEuclideanCarrierMeasure := by
  have hvAmbient : MemLp (v : ℂ → ℂ) 2
      ambientChosenEuclideanMeasure :=
    MemLp.mono_measure Measure.restrict_le_self
      (v.continuous.memLp_of_hasCompactSupport v.hasCompactSupport)
  rw [← map_chosenEuclideanCarrierMeasure] at hvAmbient
  exact UpperHalfPlane.measurableEmbedding_coe.memLp_map_measure_iff.mp hvAmbient

/-- The carrier `L²` vector represented by an ambient compact test. -/
noncomputable def ambientTestCoreToCarrierL2 (n : ℤ)
    (v : AmbientTestCore) : OrbitEuclideanL2 n :=
  (ambientTestCore_memLp_chosen n v).toLp
    (fun z : ℍ => v (z : ℂ))

theorem coeFn_ambientTestCoreToCarrierL2 (n : ℤ)
    (v : AmbientTestCore) :
    ⇑(ambientTestCoreToCarrierL2 n v) =ᵐ[
      chosenEuclideanCarrierMeasure]
        (fun z : ℍ => v (z : ℂ)) := by
  exact MemLp.coeFn_toLp (ambientTestCore_memLp_chosen n v)

/-- A carrier Hilbert pairing with a compact test is exactly its full planar
integral, provided the test is supported in the open carrier. -/
theorem ambient_integral_eq_inner_test (n : ℤ)
    (q : OrbitEuclideanL2 n) (v : AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoOpenCarrier) :
    (∫ w : ℂ, ambientStarRepresentative n q w * v w) =
      inner ℂ q (ambientTestCoreToCarrierL2 n v) := by
  calc
    (∫ w : ℂ, ambientStarRepresentative n q w * v w) =
        ∫ w in ambientChosenCarrier,
          ambientStarRepresentative n q w * v w := by
      apply Mock2FA.PaperCorrections.integral_eq_setIntegral_of_support_subset
      intro w hw
      by_contra hwC
      have hwv : w ∉ tsupport (v : ℂ → ℂ) := fun hwv =>
        hwC (ambientGammaTwoOpenCarrier_subset_ambientChosenCarrier
          (hv hwv))
      exact hw <| by
        change ambientStarRepresentative n q w * v w = 0
        rw [image_eq_zero_of_notMem_tsupport hwv, mul_zero]
    _ = ∫ w : ℂ, ambientStarRepresentative n q w * v w
          ∂ambientChosenEuclideanMeasure := rfl
    _ = ∫ w : ℂ, ambientStarRepresentative n q w * v w
          ∂Measure.map UpperHalfPlane.coe
            chosenEuclideanCarrierMeasure := by
      rw [map_chosenEuclideanCarrierMeasure]
    _ = ∫ z : ℍ,
        ambientStarRepresentative n q (z : ℂ) * v (z : ℂ)
          ∂chosenEuclideanCarrierMeasure :=
      UpperHalfPlane.measurableEmbedding_coe.integral_map _
    _ = inner ℂ q (ambientTestCoreToCarrierL2 n v) := by
      rw [MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [coeFn_ambientTestCoreToCarrierL2 n v] with z hz
      rw [ambientStarRepresentative_apply, hz]
      simpa only [RCLike.inner_apply', starRingEnd_apply]

theorem coeFn_embedding_l2Coordinate_fixedPhaseGauge (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ⇑(orbitPeterssonEuclideanEmbedding n (l2Coordinate n u)) =ᵐ[
      chosenEuclideanCarrierMeasure] fixedPhaseEuclideanGauge n u := by
  filter_upwards [coeFn_embedding_l2Coordinate n u] with z hz
  simpa only [fixedPhaseEuclideanGauge_apply] using hz

/-- A literal smooth gauge pairing agrees with the Hilbert pairing of any
carrier `L²` class represented by that gauge. -/
theorem ambientCompactHermitianPair_eq_inner_of_ae (n : ℤ)
    (f : ℍ → ℂ) (hf : RealSmooth f) (q : OrbitEuclideanL2 n)
    (hq : (q : ℍ → ℂ) =ᵐ[chosenEuclideanCarrierMeasure] f)
    (v : AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoOpenCarrier) :
    ambientCompactHermitianPair f hf v =
      inner ℂ q (ambientTestCoreToCarrierL2 n v) := by
  unfold ambientCompactHermitianPair
  calc
    (∫ w : ℂ,
        HalfWeightCompactCoordinateGreen.localizeLeft
          (fun z => star (f z)) (RealSmooth.conj hf) v w) =
        ∫ w in ambientChosenCarrier,
          HalfWeightCompactCoordinateGreen.localizeLeft
            (fun z => star (f z)) (RealSmooth.conj hf) v w := by
      apply Mock2FA.PaperCorrections.integral_eq_setIntegral_of_support_subset
      intro w hw
      by_contra hwC
      have hwv : w ∉ tsupport (v : ℂ → ℂ) := fun hwv =>
        hwC (ambientGammaTwoOpenCarrier_subset_ambientChosenCarrier
          (hv hwv))
      exact hw <| by
        simp [HalfWeightCompactCoordinateGreen.localizeLeft_apply,
          image_eq_zero_of_notMem_tsupport hwv]
    _ = ∫ w : ℂ,
        HalfWeightCompactCoordinateGreen.localizeLeft
          (fun z => star (f z)) (RealSmooth.conj hf) v w
          ∂ambientChosenEuclideanMeasure := rfl
    _ = ∫ w : ℂ,
        HalfWeightCompactCoordinateGreen.localizeLeft
          (fun z => star (f z)) (RealSmooth.conj hf) v w
          ∂Measure.map UpperHalfPlane.coe
            chosenEuclideanCarrierMeasure := by
      rw [map_chosenEuclideanCarrierMeasure]
    _ = ∫ z : ℍ,
        HalfWeightCompactCoordinateGreen.localizeLeft
          (fun z => star (f z)) (RealSmooth.conj hf) v (z : ℂ)
          ∂chosenEuclideanCarrierMeasure :=
      UpperHalfPlane.measurableEmbedding_coe.integral_map _
    _ = ∫ z : ℍ, star (f z) * v (z : ℂ)
          ∂chosenEuclideanCarrierMeasure := by
      apply integral_congr_ae
      filter_upwards with z
      simp only [HalfWeightCompactCoordinateGreen.localizeLeft_apply,
        upperLift_apply]
    _ = inner ℂ q (ambientTestCoreToCarrierL2 n v) := by
      rw [MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [hq, coeFn_ambientTestCoreToCarrierL2 n v]
        with z hzq hzv
      rw [hzq, hzv]
      simpa only [RCLike.inner_apply', starRingEnd_apply]

/-- Local compact-test identity for the actual typed raising coordinate,
expressed entirely in the concrete Euclidean `L²` realizations. -/
theorem inner_embedded_raise_test (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) (v : AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoOpenCarrier) :
    inner ℂ
        (orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1)
            (InverseEtaFixedPhaseCore.raise n u)))
        (ambientTestCoreToCarrierL2 (n + 1) v) =
      inner ℂ
        (orbitPeterssonEuclideanEmbedding n (l2Coordinate n u))
        (ambientTestCoreToCarrierL2 n
          (euclideanRaiseTestAdjoint n v)) := by
  have hvAdj :
      tsupport (euclideanRaiseTestAdjoint n v : ℂ → ℂ) ⊆
        ambientGammaTwoOpenCarrier :=
    (tsupport_euclideanRaiseTestAdjoint_subset n v).trans hv
  calc
    inner ℂ
        (orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1)
            (InverseEtaFixedPhaseCore.raise n u)))
        (ambientTestCoreToCarrierL2 (n + 1) v) =
      ambientCompactHermitianPair
        (fixedPhaseEuclideanGauge (n + 1)
          (InverseEtaFixedPhaseCore.raise n u))
        (fixedPhaseEuclideanGauge_realSmooth (n + 1)
          (InverseEtaFixedPhaseCore.raise n u)) v :=
      (ambientCompactHermitianPair_eq_inner_of_ae (n + 1) _ _ _
        (coeFn_embedding_l2Coordinate_fixedPhaseGauge (n + 1)
          (InverseEtaFixedPhaseCore.raise n u)) v hv).symm
    _ = ambientCompactHermitianPair
        (euclideanRaiseGauge n (fixedPhaseEuclideanGauge n u))
        (euclideanRaiseGauge_realSmooth n
          (fixedPhaseEuclideanGauge_realSmooth n u)) v := by
      congr 1
      funext z
      exact fixedPhaseEuclideanGauge_raise n u z
    _ = ambientCompactHermitianPair (fixedPhaseEuclideanGauge n u)
        (fixedPhaseEuclideanGauge_realSmooth n u)
        (euclideanRaiseTestAdjoint n v) :=
      ambientCompactHermitianPair_raise n
        (fixedPhaseEuclideanGauge n u)
        (fixedPhaseEuclideanGauge_realSmooth n u) v
    _ = inner ℂ
        (orbitPeterssonEuclideanEmbedding n (l2Coordinate n u))
        (ambientTestCoreToCarrierL2 n
          (euclideanRaiseTestAdjoint n v)) :=
      ambientCompactHermitianPair_eq_inner_of_ae n _ _ _
        (coeFn_embedding_l2Coordinate_fixedPhaseGauge n u)
        (euclideanRaiseTestAdjoint n v) hvAdj

/-- Local compact-test identity for actual typed lowering from the successor
coordinate. -/
theorem inner_embedded_lowerFromSucc_test (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) (v : AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoOpenCarrier) :
    inner ℂ
        (orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n
            (InverseEtaFixedPhaseCore.lowerFromSucc n u)))
        (ambientTestCoreToCarrierL2 n v) =
      inner ℂ
        (orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1) u))
        (ambientTestCoreToCarrierL2 (n + 1)
          (euclideanLowerFromSuccTestAdjoint n v)) := by
  have hvAdj :
      tsupport (euclideanLowerFromSuccTestAdjoint n v : ℂ → ℂ) ⊆
        ambientGammaTwoOpenCarrier :=
    (tsupport_euclideanLowerFromSuccTestAdjoint_subset n v).trans hv
  calc
    inner ℂ
        (orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n
            (InverseEtaFixedPhaseCore.lowerFromSucc n u)))
        (ambientTestCoreToCarrierL2 n v) =
      ambientCompactHermitianPair
        (fixedPhaseEuclideanGauge n
          (InverseEtaFixedPhaseCore.lowerFromSucc n u))
        (fixedPhaseEuclideanGauge_realSmooth n
          (InverseEtaFixedPhaseCore.lowerFromSucc n u)) v :=
      (ambientCompactHermitianPair_eq_inner_of_ae n _ _ _
        (coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (InverseEtaFixedPhaseCore.lowerFromSucc n u)) v hv).symm
    _ = ambientCompactHermitianPair
        (euclideanLowerFromSuccGauge n
          (fixedPhaseEuclideanGauge (n + 1) u))
        (euclideanLowerFromSuccGauge_realSmooth n
          (fixedPhaseEuclideanGauge_realSmooth (n + 1) u)) v := by
      congr 1
      funext z
      exact fixedPhaseEuclideanGauge_lowerFromSucc n u z
    _ = ambientCompactHermitianPair
        (fixedPhaseEuclideanGauge (n + 1) u)
        (fixedPhaseEuclideanGauge_realSmooth (n + 1) u)
        (euclideanLowerFromSuccTestAdjoint n v) :=
      ambientCompactHermitianPair_lowerFromSucc n
        (fixedPhaseEuclideanGauge (n + 1) u)
        (fixedPhaseEuclideanGauge_realSmooth (n + 1) u) v
    _ = inner ℂ
        (orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1) u))
        (ambientTestCoreToCarrierL2 (n + 1)
          (euclideanLowerFromSuccTestAdjoint n v)) :=
      ambientCompactHermitianPair_eq_inner_of_ae (n + 1) _ _ _
        (coeFn_embedding_l2Coordinate_fixedPhaseGauge (n + 1) u)
        (euclideanLowerFromSuccTestAdjoint n v) hvAdj

/-- Distributional uniqueness specialized to the actual selected carrier.
Testing the ambient starred representative against every genuine compact
test supported in the open carrier forces the original carrier `L²` vector
to vanish. -/
theorem orbitEuclidean_eq_zero_of_ambient_test_pairings (n : ℤ)
    (q : OrbitEuclideanL2 n)
    (hTest : ∀ v : HalfWeightCompactCoordinateGreen.Core,
      tsupport ((v : HalfWeightCompactCoordinateGreen.Core) : ℂ → ℂ) ⊆
        ambientGammaTwoOpenCarrier →
      (∫ w : ℂ, ambientStarRepresentative n q w * v w) = 0) :
    q = 0 := by
  have hDist : ∀ᵐ w ∂ambientChosenEuclideanMeasure,
      w ∈ ambientGammaTwoOpenCarrier →
        ambientStarRepresentative n q w = 0 := by
    apply ambientGammaTwoOpenCarrier_isOpen.ae_eq_zero_of_integral_contDiff_smul_eq_zero
        ((ambientStarRepresentative_locallyIntegrable n q).locallyIntegrableOn ambientGammaTwoOpenCarrier)
    intro g hg hcompact hsupport
    let v : HalfWeightCompactCoordinateGreen.Core :=
      ambientRealTestCore g hg hcompact hsupport
    have hvSupport :
        tsupport ((v : HalfWeightCompactCoordinateGreen.Core) : ℂ → ℂ) ⊆
          ambientGammaTwoOpenCarrier := by
      simpa only [v] using
        ambientRealTestCore_tsupport_subset g hg hcompact hsupport
    calc
      (∫ w : ℂ, g w • ambientStarRepresentative n q w
          ∂ambientChosenEuclideanMeasure) =
          ∫ w in ambientChosenCarrier,
            g w • ambientStarRepresentative n q w := rfl
      _ = ∫ w : ℂ, g w • ambientStarRepresentative n q w := by
        apply setIntegral_eq_integral_of_forall_compl_eq_zero
        intro w hw
        have hwg : w ∉ tsupport g := fun hwg =>
          hw (ambientGammaTwoOpenCarrier_subset_ambientChosenCarrier
            (hsupport hwg))
        rw [image_eq_zero_of_notMem_tsupport hwg]
        simp
      _ = ∫ w : ℂ, ambientStarRepresentative n q w * v w := by
        apply integral_congr_ae
        filter_upwards with w
        simp only [v, ambientRealTestCore_apply, Complex.real_smul]
        ring
      _ = 0 := hTest v hvSupport
  have hOpenAmbient : ∀ᵐ w ∂ambientChosenEuclideanMeasure,
      w ∈ ambientGammaTwoOpenCarrier := by
    rw [← map_chosenEuclideanCarrierMeasure]
    apply UpperHalfPlane.measurableEmbedding_coe.ae_map_iff.mpr
    filter_upwards [ae_mem_open_chosenEuclidean] with z hz
    exact ⟨z, hz, rfl⟩
  have hZeroAmbient :
      ambientStarRepresentative n q =ᵐ[
        ambientChosenEuclideanMeasure] 0 := by
    filter_upwards [hDist, hOpenAmbient] with w hw hz
    exact hw hz
  have hZeroMap := hZeroAmbient
  rw [← map_chosenEuclideanCarrierMeasure] at hZeroMap
  have hPull :=
    UpperHalfPlane.measurableEmbedding_coe.ae_map_iff.mp hZeroMap
  have hq : (q : ℍ → ℂ) =ᵐ[chosenEuclideanCarrierMeasure] 0 := by
    filter_upwards [hPull] with z hz
    simp only [Function.comp_apply, ambientStarRepresentative_apply,
      Pi.zero_apply] at hz
    simpa using hz
  exact Lp.ext <| hq.trans
    (Lp.coeFn_zero ℂ 2 chosenEuclideanCarrierMeasure).symm

end PhysicalLocalL2

/-! #### Small reusable closure lemmas -/

namespace FormalAdjointClosure

variable {E F : Type*}
  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
  {T : E →ₗ.[ℂ] F} {S : F →ₗ.[ℂ] E}

/-! ##### The graph double-adjoint theorem

Mathlib defines the adjoint of a graph submodule, but does not currently
package the elementary identity saying that taking this adjoint twice gives
the Hilbert-space closure of the original graph.  We prove it directly from
`Submodule.mem_adjoint_iff`.  The rotations `(p,q) ↦ (q,-p)` and
`(c,d) ↦ (-d,c)` identify the graph-adjoint orthogonality with ordinary
orthogonality in the product Hilbert space. -/

/-- The double graph adjoint of an arbitrary linear relation is its
topological closure.  No density or single-valuedness hypothesis is needed. -/
theorem submodule_adjoint_adjoint_eq_topologicalClosure
    (g : Submodule ℂ (E × F)) :
    g.adjoint.adjoint = g.topologicalClosure := by
  let e : (E × F) ≃L[ℂ] WithLp 2 (E × F) :=
    (WithLp.prodContinuousLinearEquiv 2 ℂ E F).symm
  let G : Submodule ℂ (WithLp 2 (E × F)) :=
    g.map e.toLinearMap
  apply Submodule.ext
  intro x
  rcases x with ⟨x₀, x₁⟩
  have hmem :
      (x₀, x₁) ∈ g.adjoint.adjoint ↔
        e (x₀, x₁) ∈ G.orthogonal.orthogonal := by
    constructor
    · intro hx
      rw [Submodule.mem_orthogonal]
      intro y hy
      have hAdj : (y.snd, -y.fst) ∈ g.adjoint := by
        rw [Submodule.mem_adjoint_iff]
        intro a b hab
        have hy0 : inner ℂ (e (a, b)) y = 0 :=
          (Submodule.mem_orthogonal G y).mp hy (e (a, b)) <| by
            exact ⟨(a, b), hab, rfl⟩
        simpa [e, WithLp.prod_inner_apply, inner_neg_right,
          sub_neg_eq_add, add_comm] using hy0
      have hDouble :=
        (Submodule.mem_adjoint_iff g.adjoint (x₀, x₁)).mp
          hx y.snd (-y.fst) hAdj
      simp only [e, WithLp.prodContinuousLinearEquiv_symm_apply,
        WithLp.prod_inner_apply, WithLp.ofLp_fst, WithLp.ofLp_snd,
        inner_neg_left] at hDouble ⊢
      linear_combination -hDouble
    · intro hx
      rw [Submodule.mem_adjoint_iff]
      intro c d hcd
      have hOrth : e (-d, c) ∈ G.orthogonal := by
        rw [Submodule.mem_orthogonal]
        intro y hy
        rcases hy with ⟨⟨a, b⟩, hab, rfl⟩
        have hAdj :=
          (Submodule.mem_adjoint_iff g (c, d)).mp hcd a b hab
        simpa [e, G, WithLp.prod_inner_apply, inner_neg_right,
          sub_eq_add_neg, add_comm] using hAdj
      have hDouble :=
        (Submodule.mem_orthogonal G.orthogonal (e (x₀, x₁))).mp
          hx (e (-d, c)) hOrth
      simp only [e, WithLp.prodContinuousLinearEquiv_symm_apply,
        WithLp.prod_inner_apply, WithLp.ofLp_fst, WithLp.ofLp_snd,
        inner_neg_left] at hDouble
      linear_combination -hDouble
  rw [hmem, G.orthogonal_orthogonal_eq_closure]
  change e (x₀, x₁) ∈ (G.topologicalClosure : Set _) ↔
    (x₀, x₁) ∈ (g.topologicalClosure : Set _)
  rw [Submodule.topologicalClosure_coe, Submodule.topologicalClosure_coe]
  change e (x₀, x₁) ∈ closure (e '' (g : Set (E × F))) ↔
    (x₀, x₁) ∈ closure (g : Set (E × F))
  rw [← e.image_closure]
  constructor
  · rintro ⟨y, hy, hxy⟩
    have : y = (x₀, x₁) := e.injective hxy
    simpa [this] using hy
  · intro hx
    exact ⟨(x₀, x₁), hx, rfl⟩

/-- Once a densely defined operator is closable, the domain of its Hilbert
adjoint is automatically dense.  The proof uses the preceding graph theorem:
a vector orthogonal to the adjoint domain gives a vertical vector in the
closed graph, which closability forces to vanish. -/
theorem adjoint_dense_domain
    (hT : T.IsClosable) (hDense : Dense (T.domain : Set E)) :
    Dense ((T†).domain : Set F) := by
  rw [Submodule.dense_iff_topologicalClosure_eq_top,
    Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
  intro y hy
  have hGraphAdj : (0, y) ∈ (T†).graph.adjoint := by
    rw [Submodule.mem_adjoint_iff]
    intro a b hab
    have ha : a ∈ (T†).domain := by
      rcases (LinearPMap.mem_graph_iff (T†)).mp hab with
        ⟨a', ha', _⟩
      have haEq : (a' : F) = a := by
        simpa only using ha'
      rw [← haEq]
      exact a'.property
    have hay : inner ℂ a y = 0 :=
      (Submodule.mem_orthogonal (K := (T†).domain) y).mp hy a ha
    simpa only [inner_zero_right, zero_sub, neg_eq_zero] using hay
  have hClosure : (0, y) ∈ T.graph.topologicalClosure := by
    rw [T.adjoint_graph_eq_graph_adjoint hDense,
      submodule_adjoint_adjoint_eq_topologicalClosure] at hGraphAdj
    exact hGraphAdj
  have hClosedGraph : (0, y) ∈ T.closure.graph := by
    rw [← hT.graph_closure_eq_closure_graph]
    exact hClosure
  exact T.closure.graph_fst_eq_zero_snd hClosedGraph rfl

/-- For every densely defined closable operator, the second Hilbert adjoint
is exactly its canonical graph closure. -/
theorem adjoint_adjoint_eq_closure
    (hT : T.IsClosable) (hDense : Dense (T.domain : Set E)) :
    T†† = T.closure := by
  apply LinearPMap.eq_of_eq_graph
  rw [(T†).adjoint_graph_eq_graph_adjoint
      (adjoint_dense_domain hT hDense),
    T.adjoint_graph_eq_graph_adjoint hDense,
    submodule_adjoint_adjoint_eq_topologicalClosure,
    ← hT.graph_closure_eq_closure_graph]

/-- A formal adjoint with dense domain is a closed extension of the operator
on the other side, so that other operator is closable. -/
theorem left_isClosable (h : T.IsFormalAdjoint S)
    (hS : Dense (S.domain : Set F)) :
    T.IsClosable :=
  (LinearPMap.adjoint_isClosed hS).isClosable.leIsClosable
    (LinearPMap.IsFormalAdjoint.le_adjoint (hT := hS) h.symm)

/-- A closed partially defined operator is equal to its Mathlib closure. -/
theorem closure_eq_self (hT : T.IsClosed) :
    T.closure = T := by
  apply LinearPMap.eq_of_eq_graph
  rw [← hT.isClosable.graph_closure_eq_closure_graph]
  exact hT.submodule_topologicalClosure_eq

/-- The closure of one member of a formal-adjoint pair is contained in the
adjoint of its densely defined partner. -/
theorem closure_le_adjoint (h : T.IsFormalAdjoint S)
    (hS : Dense (S.domain : Set F)) :
    T.closure ≤ S† := by
  have hClosed : (S†).IsClosed := LinearPMap.adjoint_isClosed hS
  have hLe : T ≤ S† :=
    LinearPMap.IsFormalAdjoint.le_adjoint (hT := hS) h.symm
  have hClosure : T.closure ≤ (S†).closure :=
    hClosed.isClosable.closure_mono hLe
  rw [closure_eq_self hClosed] at hClosure
  exact hClosure

end FormalAdjointClosure

/-! #### Dense physical core domains -/

/-- Algebraic identification of the fixed-phase core with its actual image
inside the ambient Petersson completion. -/
noncomputable def l2CoreRangeEquiv (n : ℤ) :
    InverseEtaFixedPhaseCore n ≃ₗ[ℂ]
      LinearMap.range (l2Coordinate n) :=
  LinearEquiv.ofInjective (l2Coordinate n) (l2Coordinate_injective n)

@[simp]
theorem l2CoreRangeEquiv_coe (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    ((l2CoreRangeEquiv n u : LinearMap.range (l2Coordinate n)) :
        OrbitPeterssonHilbert n) = l2Coordinate n u :=
  rfl

@[simp]
theorem l2Coordinate_l2CoreRangeEquiv_symm (n : ℤ)
    (x : LinearMap.range (l2Coordinate n)) :
    l2Coordinate n ((l2CoreRangeEquiv n).symm x) =
      (x : OrbitPeterssonHilbert n) := by
  simpa only [l2CoreRangeEquiv] using
    (LinearEquiv.ofInjective_symm_apply
      (f := l2Coordinate n) (h := l2Coordinate_injective n) x)

/-- The target-`n` coordinate of lowering from orbit index `n+1`. -/
noncomputable def lowerFromSuccCoordinate (n : ℤ) :
    InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (InverseEtaFixedPhaseCore.lowerFromSucc n)

@[simp]
theorem lowerFromSuccCoordinate_apply (n : ℤ)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    lowerFromSuccCoordinate n v =
      l2Coordinate n (InverseEtaFixedPhaseCore.lowerFromSucc n v) :=
  rfl

/-- Raising as an actual partially defined operator on the ambient
Petersson `L²` completion. -/
noncomputable def physicalRaise (n : ℤ) :
    OrbitPeterssonHilbert n →ₗ.[ℂ] OrbitPeterssonHilbert (n + 1) where
  domain := LinearMap.range (l2Coordinate n)
  toFun :=
    (raisedCoordinate n).comp (l2CoreRangeEquiv n).symm.toLinearMap

/-- Lowering from the successor weight, again on its actual dense smooth
core range in the ambient Petersson completion. -/
noncomputable def physicalLowerFromSucc (n : ℤ) :
    OrbitPeterssonHilbert (n + 1) →ₗ.[ℂ] OrbitPeterssonHilbert n where
  domain := LinearMap.range (l2Coordinate (n + 1))
  toFun :=
    (lowerFromSuccCoordinate n).comp
      (l2CoreRangeEquiv (n + 1)).symm.toLinearMap

@[simp]
theorem physicalRaise_apply (n : ℤ)
    (x : LinearMap.range (l2Coordinate n)) :
    physicalRaise n x =
      raisedCoordinate n ((l2CoreRangeEquiv n).symm x) :=
  rfl

@[simp]
theorem physicalLowerFromSucc_apply (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    physicalLowerFromSucc n x =
      lowerFromSuccCoordinate n
        ((l2CoreRangeEquiv (n + 1)).symm x) :=
  rfl

@[simp]
theorem physicalRaise_on_core (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) :
    physicalRaise n (l2CoreRangeEquiv n u) = raisedCoordinate n u := by
  simp only [physicalRaise_apply, LinearEquiv.symm_apply_apply]

@[simp]
theorem physicalLowerFromSucc_on_core (n : ℤ)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    physicalLowerFromSucc n (l2CoreRangeEquiv (n + 1) v) =
      lowerFromSuccCoordinate n v := by
  simp only [physicalLowerFromSucc_apply, LinearEquiv.symm_apply_apply]

/-- The fixed-phase core domain of raising is dense in the ambient source
Petersson space at every orbit index. -/
theorem physicalRaise_dense_domain (n : ℤ) :
    Dense ((physicalRaise n).domain : Set (OrbitPeterssonHilbert n)) := by
  change Dense (LinearMap.range (l2Coordinate n) :
    Set (OrbitPeterssonHilbert n))
  simpa only [DenseRange, LinearMap.coe_range] using
    FixedPhaseDensity.denseRange_l2Coordinate n

/-- The successor core domain of lowering is likewise dense. -/
theorem physicalLowerFromSucc_dense_domain (n : ℤ) :
    Dense ((physicalLowerFromSucc n).domain :
      Set (OrbitPeterssonHilbert (n + 1))) := by
  change Dense (LinearMap.range (l2Coordinate (n + 1)) :
    Set (OrbitPeterssonHilbert (n + 1)))
  simpa only [DenseRange, LinearMap.coe_range] using
    FixedPhaseDensity.denseRange_l2Coordinate (n + 1)

theorem negativePhysicalRaise_dense_domain (n : ℤ) :
    Dense ((-physicalRaise n).domain :
      Set (OrbitPeterssonHilbert n)) := by
  simpa only [LinearPMap.neg_domain] using physicalRaise_dense_domain n

theorem negativePhysicalLowerFromSucc_dense_domain (n : ℤ) :
    Dense ((-physicalLowerFromSucc n).domain :
      Set (OrbitPeterssonHilbert (n + 1))) := by
  simpa only [LinearPMap.neg_domain] using
    physicalLowerFromSucc_dense_domain n

/-- Petersson inner products of physical core coordinates are exactly the
integral pairing used in the geometric Green defect. -/
@[simp]
theorem inner_l2Coordinate (n : ℤ)
    (u v : InverseEtaFixedPhaseCore n) :
    inner ℂ (l2Coordinate n u) (l2Coordinate n v) =
      peterssonForm (OrbitMultiplier n)
        GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
        (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v) := by
  rw [l2Coordinate_apply, l2Coordinate_apply,
    PeterssonCoreSpace.inner_toCompletion,
    coreEmbedding_toSmoothCore, coreEmbedding_toSmoothCore]

/-! #### The exact physical Green predicate and formal adjoints -/

/-- Minimal global-analytic hypothesis at one orbit index: the concrete
boundary defect already defined from the two Petersson integrals vanishes for
every pair in the actual smooth core. -/
def PhysicalGreenIdentityAt (n : ℤ) : Prop :=
  ∀ (u : InverseEtaFixedPhaseCore n)
      (v : InverseEtaFixedPhaseCore (n + 1)),
    greenBoundaryDefect n u v = 0

/-- Simultaneous physical Green identity on the whole fixed-phase tower. -/
def PhysicalGreenIdentity : Prop :=
  ∀ n : ℤ, PhysicalGreenIdentityAt n

/-- The geometric defect predicate is exactly the inner-product Green
identity on the two dense algebraic core spaces. -/
theorem physicalGreenIdentityAt_iff_coreInner (n : ℤ) :
    PhysicalGreenIdentityAt n ↔
      ∀ (u : InverseEtaFixedPhaseCore n)
          (v : InverseEtaFixedPhaseCore (n + 1)),
        inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v) +
          inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v) = 0 := by
  simp only [PhysicalGreenIdentityAt, greenBoundaryDefect,
    raisedCoordinate_apply, lowerFromSuccCoordinate_apply,
    inner_l2Coordinate]

/-- The same statement, now on the genuine dense-domain `LinearPMap`s. -/
theorem physicalGreenIdentityAt_iff_greenIdentity (n : ℤ) :
    PhysicalGreenIdentityAt n ↔
      GreenIdentity (physicalRaise n) (physicalLowerFromSucc n) := by
  rw [physicalGreenIdentityAt_iff_coreInner]
  constructor
  · intro h x y
    change
      inner ℂ
          (raisedCoordinate n ((l2CoreRangeEquiv n).symm x))
          (y : OrbitPeterssonHilbert (n + 1)) +
        inner ℂ (x : OrbitPeterssonHilbert n)
          (lowerFromSuccCoordinate n
            ((l2CoreRangeEquiv (n + 1)).symm y)) = 0
    have hxy :=
      h ((l2CoreRangeEquiv n).symm x)
        ((l2CoreRangeEquiv (n + 1)).symm y)
    rw [l2Coordinate_l2CoreRangeEquiv_symm n x,
      l2Coordinate_l2CoreRangeEquiv_symm (n + 1) y] at hxy
    exact hxy
  · intro h u v
    simpa only [physicalRaise_apply, physicalLowerFromSucc_apply,
      l2CoreRangeEquiv_coe, LinearEquiv.symm_apply_apply] using
        h (l2CoreRangeEquiv n u) (l2CoreRangeEquiv (n + 1) v)

/-- Vanishing of the actual geometric defect is equivalent, with no change
of domains, to `-L_{n+1}` being a formal adjoint of `R_n`. -/
theorem physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower
    (n : ℤ) :
    PhysicalGreenIdentityAt n ↔
      (physicalRaise n).IsFormalAdjoint (-physicalLowerFromSucc n) := by
  rw [physicalGreenIdentityAt_iff_greenIdentity,
    greenIdentity_iff_isFormalAdjoint_neg]

/-- The conjugate Green identity gives the converse signed formal-adjoint
orientation needed to close the lowering operator itself. -/
theorem physicalLowerFromSucc_isFormalAdjoint_negativeRaise
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    (physicalLowerFromSucc n).IsFormalAdjoint (-physicalRaise n) := by
  intro v u
  have hFormal :
      (physicalRaise n).IsFormalAdjoint (-physicalLowerFromSucc n) :=
    (physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp hGreen
  have hNeg :
      -inner ℂ (physicalLowerFromSucc n v)
          (u : OrbitPeterssonHilbert n) =
        inner ℂ (v : OrbitPeterssonHilbert (n + 1))
          (physicalRaise n u) := by
    simpa only [LinearPMap.neg_apply, inner_neg_left] using
      hFormal.symm v u
  rw [LinearPMap.neg_apply, inner_neg_right]
  simpa only [neg_neg] using congrArg (fun z : ℂ ↦ -z) hNeg

/-- Compact-flux Stokes supplies the minimal physical Green predicate; the
concrete analytic flux bridge has already been proved without assumptions. -/
theorem physicalGreenIdentityAt_of_compactFluxStokes
    (hStokes : GammaTwoCompactFluxStokes)
    (n : ℤ) : PhysicalGreenIdentityAt n :=
  fun u v ↦ greenBoundaryDefect_eq_zero_of_compactFluxStokes
    hStokes n u v

theorem physicalGreenIdentity_of_compactFluxStokes
    (hStokes : GammaTwoCompactFluxStokes) :
    PhysicalGreenIdentity :=
  fun n ↦ physicalGreenIdentityAt_of_compactFluxStokes hStokes n

/-- After closed-carrier properness and the unconditional analytic bridge,
paired-polygon Stokes is the sole remaining geometric input. -/
theorem physicalGreenIdentity_of_pairedPolygon
    (hPolygon : GammaTwoPairedPolygonFluxStokes) :
    PhysicalGreenIdentity :=
  fun n u v ↦ greenBoundaryDefect_eq_zero_of_pairedPolygon
    hPolygon n u v

/-! #### Unconditional local distribution identities on the physical graph -/

theorem physicalRaise_core_ambient_test_identity (n : ℤ)
    (x : LinearMap.range (l2Coordinate n))
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier) :
    inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          (physicalRaise n x))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1) v) =
      inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (x : OrbitPeterssonHilbert n))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseTestAdjoint n v)) := by
  simpa only [physicalRaise_apply, raisedCoordinate_apply,
    l2Coordinate_l2CoreRangeEquiv_symm] using
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.inner_embedded_raise_test n
        ((l2CoreRangeEquiv n).symm x) v hv

theorem physicalLowerFromSucc_core_ambient_test_identity (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1)))
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier) :
    inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (physicalLowerFromSucc n x))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n v) =
      inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          (x : OrbitPeterssonHilbert (n + 1)))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccTestAdjoint n v)) := by
  simpa only [physicalLowerFromSucc_apply,
    lowerFromSuccCoordinate_apply,
    l2Coordinate_l2CoreRangeEquiv_symm] using
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.inner_embedded_lowerFromSucc_test n
        ((l2CoreRangeEquiv (n + 1)).symm x) v hv

/-! #### Closures and adjoint inclusions -/

theorem physicalRaise_isClosable_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (physicalRaise n).IsClosable :=
  FormalAdjointClosure.left_isClosable
    ((physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp hGreen)
    (negativePhysicalLowerFromSucc_dense_domain n)

theorem physicalLowerFromSucc_isClosable_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (physicalLowerFromSucc n).IsClosable :=
  FormalAdjointClosure.left_isClosable
    (physicalLowerFromSucc_isFormalAdjoint_negativeRaise hGreen)
    (negativePhysicalRaise_dense_domain n)

/-- Raising is closable without any quotient Green/Stokes hypothesis.  Local
compact tests see every vertical graph-closure vector; ambient distributional
uniqueness then forces that vector to vanish. -/
theorem physicalRaise_isClosable (n : ℤ) :
    (physicalRaise n).IsClosable := by
  use (physicalRaise n).graph.topologicalClosure.toLinearPMap
  rw [Submodule.toLinearPMap_graph_eq]
  intro p hp hpZero
  have hpSet :
      p ∈ closure ((physicalRaise n).graph :
        Set (OrbitPeterssonHilbert n ×
          OrbitPeterssonHilbert (n + 1))) := by
    change p ∈ closure ((physicalRaise n).graph :
      Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1))) at hp
    exact hp
  have hPair : ∀ v : PhysicalLocalL2.AmbientTestCore,
      tsupport (v : ℂ → ℂ) ⊆
          PhysicalLocalL2.ambientGammaTwoOpenCarrier →
      inner ℂ
          (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
            (n + 1) p.2)
          (PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1) v) = 0 := by
    intro v hv
    let pairing :
        OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1) → ℂ :=
      fun r =>
        inner ℂ
            (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
              (n + 1) r.2)
            (PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1) v) -
          inner ℂ
            (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n r.1)
            (PhysicalLocalL2.ambientTestCoreToCarrierL2 n
              (PhysicalLocalL2.euclideanRaiseTestAdjoint n v))
    have hPairingContinuous : Continuous pairing := by
      dsimp only [pairing]
      exact
        (((PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)).continuous.comp continuous_snd).inner continuous_const).sub
        (((PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n).continuous.comp continuous_fst).inner continuous_const)
    have hClosed : IsClosed {r | pairing r = 0} :=
      isClosed_eq hPairingContinuous continuous_const
    have hGraphSubset :
        ((physicalRaise n).graph :
          Set (OrbitPeterssonHilbert n ×
            OrbitPeterssonHilbert (n + 1))) ⊆
          {r | pairing r = 0} := by
      intro r hr
      rcases (LinearPMap.mem_graph_iff (physicalRaise n)).mp hr with
        ⟨x, hxBase, hxValue⟩
      change pairing r = 0
      dsimp only [pairing]
      rw [← hxBase, ← hxValue]
      rw [physicalRaise_core_ambient_test_identity n x v hv]
      ring
    have hpClosed : p ∈ {r | pairing r = 0} :=
      (closure_minimal hGraphSubset hClosed) hpSet
    change pairing p = 0 at hpClosed
    dsimp only [pairing] at hpClosed
    simpa [hpZero] using hpClosed
  have hEuclidean :
      PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.2 = 0 :=
    PhysicalLocalL2.orbitEuclidean_eq_zero_of_ambient_test_pairings
      (n + 1)
      (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.2)
      (fun v hv =>
        (PhysicalLocalL2.ambient_integral_eq_inner_test (n + 1)
          (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.2)
          v hv).trans (hPair v hv))
  apply PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_injective (n + 1)
  simpa using hEuclidean

/-- Lowering from the successor orbit is closable by the same unconditional
local distribution argument. -/
theorem physicalLowerFromSucc_isClosable (n : ℤ) :
    (physicalLowerFromSucc n).IsClosable := by
  use (physicalLowerFromSucc n).graph.topologicalClosure.toLinearPMap
  rw [Submodule.toLinearPMap_graph_eq]
  intro p hp hpZero
  have hpSet :
      p ∈ closure ((physicalLowerFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) ×
          OrbitPeterssonHilbert n)) := by
    change p ∈ closure ((physicalLowerFromSucc n).graph :
      Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n)) at hp
    exact hp
  have hPair : ∀ v : PhysicalLocalL2.AmbientTestCore,
      tsupport (v : ℂ → ℂ) ⊆
          PhysicalLocalL2.ambientGammaTwoOpenCarrier →
      inner ℂ
          (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2)
          (PhysicalLocalL2.ambientTestCoreToCarrierL2 n v) = 0 := by
    intro v hv
    let pairing :
        OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n → ℂ :=
      fun r =>
        inner ℂ
            (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n r.2)
            (PhysicalLocalL2.ambientTestCoreToCarrierL2 n v) -
          inner ℂ
            (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
              (n + 1) r.1)
            (PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1)
              (PhysicalLocalL2.euclideanLowerFromSuccTestAdjoint n v))
    have hPairingContinuous : Continuous pairing := by
      dsimp only [pairing]
      exact
        (((PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n).continuous.comp continuous_snd).inner continuous_const).sub
        (((PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)).continuous.comp continuous_fst).inner continuous_const)
    have hClosed : IsClosed {r | pairing r = 0} :=
      isClosed_eq hPairingContinuous continuous_const
    have hGraphSubset :
        ((physicalLowerFromSucc n).graph :
          Set (OrbitPeterssonHilbert (n + 1) ×
            OrbitPeterssonHilbert n)) ⊆
          {r | pairing r = 0} := by
      intro r hr
      rcases (LinearPMap.mem_graph_iff (physicalLowerFromSucc n)).mp hr with
        ⟨x, hxBase, hxValue⟩
      change pairing r = 0
      dsimp only [pairing]
      rw [← hxBase, ← hxValue]
      rw [physicalLowerFromSucc_core_ambient_test_identity n x v hv]
      ring
    have hpClosed : p ∈ {r | pairing r = 0} :=
      (closure_minimal hGraphSubset hClosed) hpSet
    change pairing p = 0 at hpClosed
    dsimp only [pairing] at hpClosed
    simpa [hpZero] using hpClosed
  have hEuclidean :
      PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2 = 0 :=
    PhysicalLocalL2.orbitEuclidean_eq_zero_of_ambient_test_pairings n
      (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2)
      (fun v hv =>
        (PhysicalLocalL2.ambient_integral_eq_inner_test n
          (PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2)
          v hv).trans (hPair v hv))
  apply PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_injective n
  simpa using hEuclidean

/-- Canonical graph closure of physical raising.  Its closedness is proved
unconditionally below from local distributional closability. -/
noncomputable def closedRaise (n : ℤ) :
    OrbitPeterssonHilbert n →ₗ.[ℂ] OrbitPeterssonHilbert (n + 1) :=
  (physicalRaise n).closure

/-- Canonical graph closure of lowering from the successor orbit. -/
noncomputable def closedLowerFromSucc (n : ℤ) :
    OrbitPeterssonHilbert (n + 1) →ₗ.[ℂ] OrbitPeterssonHilbert n :=
  (physicalLowerFromSucc n).closure

theorem physicalRaise_le_closedRaise (n : ℤ) :
    physicalRaise n ≤ closedRaise n :=
  (physicalRaise n).le_closure

theorem physicalLowerFromSucc_le_closedLowerFromSucc (n : ℤ) :
    physicalLowerFromSucc n ≤ closedLowerFromSucc n :=
  (physicalLowerFromSucc n).le_closure

theorem closedRaise_isClosed_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (closedRaise n).IsClosed :=
  (physicalRaise_isClosable_of_green hGreen).closure_isClosed

theorem closedLowerFromSucc_isClosed_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (closedLowerFromSucc n).IsClosed :=
  (physicalLowerFromSucc_isClosable_of_green hGreen).closure_isClosed

theorem closedRaise_isClosed (n : ℤ) :
    (closedRaise n).IsClosed :=
  (physicalRaise_isClosable n).closure_isClosed

theorem closedLowerFromSucc_isClosed (n : ℤ) :
    (closedLowerFromSucc n).IsClosed :=
  (physicalLowerFromSucc_isClosable n).closure_isClosed

theorem closedRaise_graph_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (closedRaise n).graph = (physicalRaise n).graph.topologicalClosure := by
  symm
  exact (physicalRaise_isClosable_of_green hGreen).graph_closure_eq_closure_graph

theorem closedLowerFromSucc_graph_of_green {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    (closedLowerFromSucc n).graph =
      (physicalLowerFromSucc n).graph.topologicalClosure := by
  symm
  exact
    (physicalLowerFromSucc_isClosable_of_green hGreen).graph_closure_eq_closure_graph

theorem closedRaise_graph (n : ℤ) :
    (closedRaise n).graph = (physicalRaise n).graph.topologicalClosure := by
  symm
  exact (physicalRaise_isClosable n).graph_closure_eq_closure_graph

theorem closedLowerFromSucc_graph (n : ℤ) :
    (closedLowerFromSucc n).graph =
      (physicalLowerFromSucc n).graph.topologicalClosure := by
  symm
  exact (physicalLowerFromSucc_isClosable n).graph_closure_eq_closure_graph

/-- The signed lowering core is contained in the Hilbert adjoint of raising. -/
theorem negativeLower_le_raise_adjoint {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    -physicalLowerFromSucc n ≤ (physicalRaise n)† :=
  LinearPMap.IsFormalAdjoint.le_adjoint
    (hT := physicalRaise_dense_domain n)
    ((physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp hGreen)

/-- Raising is contained in the adjoint of signed lowering. -/
theorem raise_le_negativeLower_adjoint {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    physicalRaise n ≤ (-physicalLowerFromSucc n)† :=
  LinearPMap.IsFormalAdjoint.le_adjoint
    (hT := negativePhysicalLowerFromSucc_dense_domain n)
    ((physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp hGreen).symm

/-- Lowering is contained in the adjoint of signed raising. -/
theorem lower_le_negativeRaise_adjoint {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    physicalLowerFromSucc n ≤ (-physicalRaise n)† :=
  LinearPMap.IsFormalAdjoint.le_adjoint
    (hT := negativePhysicalRaise_dense_domain n)
    (physicalLowerFromSucc_isFormalAdjoint_negativeRaise hGreen).symm

/-- The closed raising operator remains contained in the maximal adjoint of
signed lowering. -/
theorem closedRaise_le_negativeLower_adjoint {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    closedRaise n ≤ (-physicalLowerFromSucc n)† :=
  FormalAdjointClosure.closure_le_adjoint
    ((physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp hGreen)
    (negativePhysicalLowerFromSucc_dense_domain n)

/-- The closed lowering operator remains contained in the maximal adjoint of
signed raising. -/
theorem closedLower_le_negativeRaise_adjoint {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    closedLowerFromSucc n ≤ (-physicalRaise n)† :=
  FormalAdjointClosure.closure_le_adjoint
    (physicalLowerFromSucc_isFormalAdjoint_negativeRaise hGreen)
    (negativePhysicalRaise_dense_domain n)

/-- Equality with the maximal adjoint is reduced exactly to the reverse
inclusion.  That reverse inclusion is the genuine essential-adjoint/core
theorem and is not a consequence of Green's identity alone. -/
theorem closedRaise_eq_negativeLower_adjoint_iff {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    closedRaise n = (-physicalLowerFromSucc n)† ↔
      (-physicalLowerFromSucc n)† ≤ closedRaise n := by
  constructor
  · intro h
    rw [h]
  · intro h
    exact le_antisymm (closedRaise_le_negativeLower_adjoint hGreen) h

theorem closedLower_eq_negativeRaise_adjoint_iff {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    closedLowerFromSucc n = (-physicalRaise n)† ↔
      (-physicalRaise n)† ≤ closedLowerFromSucc n := by
  constructor
  · intro h
    rw [h]
  · intro h
    exact le_antisymm (closedLower_le_negativeRaise_adjoint hGreen) h

/-! #### The actual joint raising/lowering operator -/

/-- The physical `L²` direct-sum target for the two derivatives of a section
at successor index `n+1`. -/
abbrev PhysicalJointTarget (n : ℤ) :=
  WithLp 2
    (OrbitPeterssonHilbert ((n + 1) + 1) × OrbitPeterssonHilbert n)

/-- The genuine joint operator `(R_{n+1}, L_{n+1})` on the common dense
Petersson core domain.  The lowering component is written as
`lowerFromSucc n` so that its target is definitionally index `n`. -/
noncomputable def physicalJointFromSucc (n : ℤ) :
    OrbitPeterssonHilbert (n + 1) →ₗ.[ℂ] PhysicalJointTarget n where
  domain := LinearMap.range (l2Coordinate (n + 1))
  toFun :=
    (WithLp.linearEquiv 2 ℂ
      (OrbitPeterssonHilbert ((n + 1) + 1) ×
        OrbitPeterssonHilbert n)).symm.toLinearMap.comp
      (((raisedCoordinate (n + 1)).prod
        (lowerFromSuccCoordinate n)).comp
          (l2CoreRangeEquiv (n + 1)).symm.toLinearMap)

@[simp]
theorem physicalJointFromSucc_fst (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    (physicalJointFromSucc n x).fst = physicalRaise (n + 1) x :=
  rfl

@[simp]
theorem physicalJointFromSucc_snd (n : ℤ)
    (x : LinearMap.range (l2Coordinate (n + 1))) :
    (physicalJointFromSucc n x).snd = physicalLowerFromSucc n x :=
  rfl

@[simp]
theorem physicalJointFromSucc_on_core (n : ℤ)
    (u : InverseEtaFixedPhaseCore (n + 1)) :
    physicalJointFromSucc n (l2CoreRangeEquiv (n + 1) u) =
      WithLp.toLp 2
        (raisedCoordinate (n + 1) u, lowerFromSuccCoordinate n u) := by
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · change physicalRaise (n + 1)
      (l2CoreRangeEquiv (n + 1) u) = raisedCoordinate (n + 1) u
    exact physicalRaise_on_core (n + 1) u
  · change physicalLowerFromSucc n
      (l2CoreRangeEquiv (n + 1) u) = lowerFromSuccCoordinate n u
    exact physicalLowerFromSucc_on_core n u

/-- The joint domain is the same actual dense smooth-core range as each
component. -/
theorem physicalJointFromSucc_dense_domain (n : ℤ) :
    Dense ((physicalJointFromSucc n).domain :
      Set (OrbitPeterssonHilbert (n + 1))) := by
  change Dense (LinearMap.range (l2Coordinate (n + 1)) :
    Set (OrbitPeterssonHilbert (n + 1)))
  simpa only [DenseRange, LinearMap.coe_range] using
    FixedPhaseDensity.denseRange_l2Coordinate (n + 1)

/-- If both physical components are closable, the actual `L²`-direct-sum
operator is closable.  The proof works on the closure of the joint graph:
continuous coordinate projections put every vertical joint-graph limit in
the two component graph closures, where component closability forces both
coordinates to vanish. -/
theorem physicalJointFromSucc_isClosable_of_components {n : ℤ}
    (hRaise : (physicalRaise (n + 1)).IsClosable)
    (hLower : (physicalLowerFromSucc n).IsClosable) :
    (physicalJointFromSucc n).IsClosable := by
  use (physicalJointFromSucc n).graph.topologicalClosure.toLinearPMap
  rw [Submodule.toLinearPMap_graph_eq]
  intro x hx hxZero
  have hxSet :
      x ∈ closure ((physicalJointFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) := by
    change x ∈ closure ((physicalJointFromSucc n).graph :
      Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) at hx
    exact hx
  let projRaise :
      OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n →
        OrbitPeterssonHilbert (n + 1) ×
          OrbitPeterssonHilbert ((n + 1) + 1) :=
    fun p ↦ (p.1, p.2.fst)
  let projLower :
      OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n →
        OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n :=
    fun p ↦ (p.1, p.2.snd)
  have hProjRaiseContinuous : Continuous projRaise := by
    dsimp only [projRaise]
    fun_prop
  have hProjLowerContinuous : Continuous projLower := by
    dsimp only [projLower]
    fun_prop
  have hProjRaiseGraph :
      projRaise '' ((physicalJointFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) ⊆
        ((physicalRaise (n + 1)).graph :
          Set (OrbitPeterssonHilbert (n + 1) ×
            OrbitPeterssonHilbert ((n + 1) + 1))) := by
    rintro _ ⟨p, hp, rfl⟩
    change (p.1, p.2.fst) ∈ (physicalRaise (n + 1)).graph
    rcases (LinearPMap.mem_graph_iff (physicalJointFromSucc n)).mp hp with
      ⟨z, hzBase, hzValue⟩
    rw [← hzBase, ← hzValue]
    change
      ((z : OrbitPeterssonHilbert (n + 1)),
        physicalRaise (n + 1) z) ∈
          (physicalRaise (n + 1)).graph
    exact (physicalRaise (n + 1)).mem_graph z
  have hProjLowerGraph :
      projLower '' ((physicalJointFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)) ⊆
        ((physicalLowerFromSucc n).graph :
          Set (OrbitPeterssonHilbert (n + 1) ×
            OrbitPeterssonHilbert n)) := by
    rintro _ ⟨p, hp, rfl⟩
    change (p.1, p.2.snd) ∈ (physicalLowerFromSucc n).graph
    rcases (LinearPMap.mem_graph_iff (physicalJointFromSucc n)).mp hp with
      ⟨z, hzBase, hzValue⟩
    rw [← hzBase, ← hzValue]
    change
      ((z : OrbitPeterssonHilbert (n + 1)),
        physicalLowerFromSucc n z) ∈
          (physicalLowerFromSucc n).graph
    exact (physicalLowerFromSucc n).mem_graph z
  have hRaiseSet :
      projRaise x ∈ closure ((physicalRaise (n + 1)).graph :
        Set (OrbitPeterssonHilbert (n + 1) ×
          OrbitPeterssonHilbert ((n + 1) + 1))) :=
    (closure_mono hProjRaiseGraph)
      ((image_closure_subset_closure_image hProjRaiseContinuous)
        ⟨x, hxSet, rfl⟩)
  have hLowerSet :
      projLower x ∈ closure ((physicalLowerFromSucc n).graph :
        Set (OrbitPeterssonHilbert (n + 1) ×
          OrbitPeterssonHilbert n)) :=
    (closure_mono hProjLowerGraph)
      ((image_closure_subset_closure_image hProjLowerContinuous)
        ⟨x, hxSet, rfl⟩)
  have hRaiseClosure :
      projRaise x ∈ (physicalRaise (n + 1)).graph.topologicalClosure := by
    change projRaise x ∈ closure ((physicalRaise (n + 1)).graph :
      Set (OrbitPeterssonHilbert (n + 1) ×
        OrbitPeterssonHilbert ((n + 1) + 1)))
    exact hRaiseSet
  have hLowerClosure :
      projLower x ∈ (physicalLowerFromSucc n).graph.topologicalClosure := by
    change projLower x ∈ closure ((physicalLowerFromSucc n).graph :
      Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n))
    exact hLowerSet
  rw [hRaise.graph_closure_eq_closure_graph] at hRaiseClosure
  rw [hLower.graph_closure_eq_closure_graph] at hLowerClosure
  dsimp only [projRaise] at hRaiseClosure
  dsimp only [projLower] at hLowerClosure
  have hRaiseZero : x.2.fst = 0 :=
    (physicalRaise (n + 1)).closure.graph_fst_eq_zero_snd
      hRaiseClosure hxZero
  have hLowerZero : x.2.snd = 0 :=
    (physicalLowerFromSucc n).closure.graph_fst_eq_zero_snd
      hLowerClosure hxZero
  apply WithLp.ofLp_injective 2
  exact Prod.ext hRaiseZero hLowerZero

/-- Two adjacent instances of the physical Green identity close the genuine
joint operator at successor index `n+1`. -/
theorem physicalJointFromSucc_isClosable_of_green {n : ℤ}
    (hGreenLower : PhysicalGreenIdentityAt n)
    (hGreenRaise : PhysicalGreenIdentityAt (n + 1)) :
    (physicalJointFromSucc n).IsClosable :=
  physicalJointFromSucc_isClosable_of_components
    (physicalRaise_isClosable_of_green hGreenRaise)
    (physicalLowerFromSucc_isClosable_of_green hGreenLower)

/-- The genuine joint operator is unconditionally closable because each
physical differential component is unconditionally closable. -/
theorem physicalJointFromSucc_isClosable (n : ℤ) :
    (physicalJointFromSucc n).IsClosable :=
  physicalJointFromSucc_isClosable_of_components
    (physicalRaise_isClosable (n + 1))
    (physicalLowerFromSucc_isClosable n)

/-- Canonical graph closure of the joint physical operator. -/
noncomputable def closedJointFromSucc (n : ℤ) :
    OrbitPeterssonHilbert (n + 1) →ₗ.[ℂ] PhysicalJointTarget n :=
  (physicalJointFromSucc n).closure

theorem physicalJointFromSucc_le_closedJointFromSucc (n : ℤ) :
    physicalJointFromSucc n ≤ closedJointFromSucc n :=
  (physicalJointFromSucc n).le_closure

theorem closedJointFromSucc_isClosed_of_green {n : ℤ}
    (hGreenLower : PhysicalGreenIdentityAt n)
    (hGreenRaise : PhysicalGreenIdentityAt (n + 1)) :
    (closedJointFromSucc n).IsClosed :=
  (physicalJointFromSucc_isClosable_of_green hGreenLower hGreenRaise).closure_isClosed

theorem closedJointFromSucc_isClosed (n : ℤ) :
    (closedJointFromSucc n).IsClosed :=
  (physicalJointFromSucc_isClosable n).closure_isClosed

theorem closedJointFromSucc_graph_of_green {n : ℤ}
    (hGreenLower : PhysicalGreenIdentityAt n)
    (hGreenRaise : PhysicalGreenIdentityAt (n + 1)) :
    (closedJointFromSucc n).graph =
      (physicalJointFromSucc n).graph.topologicalClosure := by
  symm
  exact (physicalJointFromSucc_isClosable_of_green hGreenLower hGreenRaise).graph_closure_eq_closure_graph

theorem closedJointFromSucc_graph (n : ℤ) :
    (closedJointFromSucc n).graph =
      (physicalJointFromSucc n).graph.topologicalClosure := by
  symm
  exact (physicalJointFromSucc_isClosable n).graph_closure_eq_closure_graph

/-- A tower-wide Green theorem closes every raising, lowering, and joint
physical operator at once. -/
theorem all_physical_operators_closable_of_green
    (hGreen : PhysicalGreenIdentity) :
    (∀ n, (physicalRaise n).IsClosable) ∧
      (∀ n, (physicalLowerFromSucc n).IsClosable) ∧
        (∀ n, (physicalJointFromSucc n).IsClosable) := by
  refine ⟨fun n ↦ physicalRaise_isClosable_of_green (hGreen n),
    fun n ↦ physicalLowerFromSucc_isClosable_of_green (hGreen n), ?_⟩
  intro n
  exact physicalJointFromSucc_isClosable_of_green (hGreen n) (hGreen (n + 1))

/-- The paired-polygon route also implies the now-independent closability
statement.  Its substantive additional use is the cross-adjoint Green layer
above, not the existence of graph closures. -/
theorem all_physical_operators_closable_of_pairedPolygon
    (hPolygon : GammaTwoPairedPolygonFluxStokes) :
    (∀ n, (physicalRaise n).IsClosable) ∧
      (∀ n, (physicalLowerFromSucc n).IsClosable) ∧
        (∀ n, (physicalJointFromSucc n).IsClosable) :=
  all_physical_operators_closable_of_green
    (physicalGreenIdentity_of_pairedPolygon hPolygon)

theorem all_physical_operators_closable_of_compactFluxStokes
    (hStokes : GammaTwoCompactFluxStokes) :
    (∀ n, (physicalRaise n).IsClosable) ∧
      (∀ n, (physicalLowerFromSucc n).IsClosable) ∧
        (∀ n, (physicalJointFromSucc n).IsClosable) :=
  all_physical_operators_closable_of_green
    (physicalGreenIdentity_of_compactFluxStokes hStokes)

/-- Every physical raising, lowering, and joint operator in the fixed-phase
tower is closable without Green, Stokes, polygon, or boundary hypotheses. -/
theorem all_physical_operators_closable :
    (∀ n, (physicalRaise n).IsClosable) ∧
      (∀ n, (physicalLowerFromSucc n).IsClosable) ∧
        (∀ n, (physicalJointFromSucc n).IsClosable) :=
  ⟨physicalRaise_isClosable,
    physicalLowerFromSucc_isClosable,
    physicalJointFromSucc_isClosable⟩

end PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators

