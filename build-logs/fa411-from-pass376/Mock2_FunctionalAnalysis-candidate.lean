/-!
## P5.1: finite Fourier projections and the non-circular Rellich criterion

The local compactness argument is separated into two layers.  This first
layer is completely Hilbert-theoretic and uses the genuine Fourier basis of
the two-torus.  Every finite Fourier projection is exhibited as a finite sum
of rank-one operators, hence is compact.  Therefore any localization whose
high-frequency tail tends to zero in operator norm is compact.  Notice that
the hypothesis below is a quantitative Fourier tail estimate; it is not a
field saying that the localization itself is compact.

The second, geometric layer must identify the localized fixed-phase graph
coordinates with finitely many such torus charts and prove the tail estimate
from the two physical weak derivative coordinates.  That obligation is
recorded after the unconditional Fourier theorem rather than hidden in a
certificate called “Rellich”.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5LocalFourierRellich

open Function Set Topology Filter MeasureTheory
open scoped BigOperators ENNReal NNReal

section FiniteHilbertProjections

variable {I H E : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [NormedAddCommGroup E] [InnerProductSpace ℂ E]
variable [CompleteSpace E]

/-- Orthogonal projection onto a finite set of vectors of a Hilbert basis,
written explicitly as a finite sum of rank-one operators. -/
noncomputable def finiteHilbertProjection
    (b : HilbertBasis I ℂ E) (s : Finset I) : E →L[ℂ] E :=
  ∑ i ∈ s, InnerProductSpace.rankOne ℂ (b i) (b i)

@[simp]
theorem finiteHilbertProjection_empty (b : HilbertBasis I ℂ E) :
    finiteHilbertProjection b ∅ = 0 := by
  simp only [finiteHilbertProjection, Finset.sum_empty]

@[simp]
theorem finiteHilbertProjection_apply
    (b : HilbertBasis I ℂ E) (s : Finset I) (x : E) :
    finiteHilbertProjection b s x =
      ∑ i ∈ s, inner ℂ (b i) x • b i := by
  classical
  simp only [finiteHilbertProjection, ContinuousLinearMap.sum_apply,
    InnerProductSpace.rankOne_apply]

/-- Each finite Fourier/Hilbert projection is genuinely compact: its proof
passes through a displayed finite sum of one-dimensional operators. -/
theorem finiteHilbertProjection_isCompact
    (b : HilbertBasis I ℂ E) (s : Finset I) :
    IsCompactOperator (finiteHilbertProjection b s) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [finiteHilbertProjection, Finset.sum_empty]
      exact isCompactOperator_zero
  | @insert i s hi ih =>
      rw [finiteHilbertProjection, Finset.sum_insert hi]
      exact
        (Mock2FA.PaperCorrections.AutomorphicSobolev.CompactSeparableKernelPotential.hilbertRankOne_isCompact (b i)).add ih

/-- Finite-mode localization of a bounded map into a Hilbert space. -/
noncomputable def finiteModeLocalization
    (b : HilbertBasis I ℂ E) (s : Finset I) (T : H →L[ℂ] E) :
    H →L[ℂ] E :=
  (finiteHilbertProjection b s).comp T

@[simp]
theorem finiteModeLocalization_apply
    (b : HilbertBasis I ℂ E) (s : Finset I)
    (T : H →L[ℂ] E) (x : H) :
    finiteModeLocalization b s T x =
      ∑ i ∈ s, inner ℂ (b i) (T x) • b i := by
  rw [finiteModeLocalization, ContinuousLinearMap.comp_apply,
    finiteHilbertProjection_apply]

/-- Every finite-mode localization is compact even when its source is
infinite-dimensional. -/
theorem finiteModeLocalization_isCompact
    (b : HilbertBasis I ℂ E) (s : Finset I) (T : H →L[ℂ] E) :
    IsCompactOperator (finiteModeLocalization b s T) :=
  (finiteHilbertProjection_isCompact b s).comp_clm T

/-- Exact quantitative tail predicate used by the Rellich proof.  It only
asks that the displayed finite Fourier approximants converge in operator
norm; compactness is a conclusion below, not part of this definition. -/
def HasVanishingFiniteModeTail
    (b : HilbertBasis I ℂ E) (modes : ℕ → Finset I)
    (T : H →L[ℂ] E) : Prop :=
  Filter.Tendsto
    (fun N ↦ ‖finiteModeLocalization b (modes N) T - T‖)
    Filter.atTop (nhds 0)

/-- Operator-norm convergence of finite Fourier projections. -/
theorem finiteModeLocalization_tendsto
    (b : HilbertBasis I ℂ E) (modes : ℕ → Finset I)
    (T : H →L[ℂ] E)
    (hTail : HasVanishingFiniteModeTail b modes T) :
    Filter.Tendsto (fun N ↦ finiteModeLocalization b (modes N) T)
      Filter.atTop (nhds T) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  exact hTail

/-- Abstract Fourier--Rellich theorem.  It is unconditional once the
quantitative high-frequency estimate has been proved: compactness follows by
operator-norm closure of the compact operators. -/
theorem isCompactOperator_of_vanishingFiniteModeTail
    (b : HilbertBasis I ℂ E) (modes : ℕ → Finset I)
    (T : H →L[ℂ] E)
    (hTail : HasVanishingFiniteModeTail b modes T) :
    IsCompactOperator T := by
  apply isCompactOperator_of_tendsto
    (finiteModeLocalization_tendsto b modes T hTail)
  exact Filter.Eventually.of_forall fun N ↦
    finiteModeLocalization_isCompact b (modes N) T

end FiniteHilbertProjections

/-! ### The actual two-torus Fourier basis -/

/-- The two-dimensional unit additive torus used after extending a bounded
rectangle periodically. -/
abbrev TwoTorus := UnitAddTorus (Fin 2)

/-- Its concrete complex `L²` Hilbert space. -/
noncomputable abbrev TwoTorusL2 :=
  MeasureTheory.Lp ℂ 2 (volume : Measure TwoTorus)

/-- The genuine Fourier Hilbert basis supplied by Mathlib's multi-circle
Fourier theory. -/
noncomputable def twoTorusFourierBasis :
    HilbertBasis (Fin 2 → ℤ) ℂ TwoTorusL2 :=
  UnitAddTorus.mFourierBasis

@[simp]
theorem coe_twoTorusFourierBasis :
    ⇑twoTorusFourierBasis = UnitAddTorus.mFourierLp 2 :=
  UnitAddTorus.coe_mFourierBasis

/-- Finite Fourier projection on the actual two-torus. -/
noncomputable def twoTorusFiniteFourierProjection
    (s : Finset (Fin 2 → ℤ)) : TwoTorusL2 →L[ℂ] TwoTorusL2 :=
  finiteHilbertProjection twoTorusFourierBasis s

theorem twoTorusFiniteFourierProjection_isCompact
    (s : Finset (Fin 2 → ℤ)) :
    IsCompactOperator (twoTorusFiniteFourierProjection s) :=
  finiteHilbertProjection_isCompact twoTorusFourierBasis s

@[simp]
theorem twoTorusFiniteFourierProjection_apply
    (s : Finset (Fin 2 → ℤ)) (f : TwoTorusL2) :
    twoTorusFiniteFourierProjection s f =
      ∑ k ∈ s,
        UnitAddTorus.mFourierCoeff f k •
          UnitAddTorus.mFourierLp 2 k := by
  rw [twoTorusFiniteFourierProjection,
    finiteHilbertProjection_apply]
  apply Finset.sum_congr rfl
  intro k hk
  rw [← HilbertBasis.repr_apply_apply,
    UnitAddTorus.mFourierBasis_repr]
  simp only [twoTorusFourierBasis,
    UnitAddTorus.coe_mFourierBasis]

/-- Concrete two-torus Fourier--Rellich theorem for a bounded localization
map.  The only analytic input is the displayed high-frequency operator-norm
tail; all compactness reasoning and all finite-rank approximants are explicit. -/
theorem twoTorus_isCompactOperator_of_fourierTail
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (modes : ℕ → Finset (Fin 2 → ℤ))
    (T : H →L[ℂ] TwoTorusL2)
    (hTail : HasVanishingFiniteModeTail
      twoTorusFourierBasis modes T) :
    IsCompactOperator T :=
  isCompactOperator_of_vanishingFiniteModeTail
    twoTorusFourierBasis modes T hTail

/-! ### Finite chart assembly -/

variable {H E : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A finite sum of compact chart reconstruction maps is compact.  This is
the exact finite-atlas assembly step needed after local Fourier Rellich. -/
theorem finite_chart_sum_isCompact
    {J : Type*} [Fintype J]
    (localize : J → H →L[ℂ] TwoTorusL2)
    (reconstruct : J → TwoTorusL2 →L[ℂ] E)
    (hLocal : ∀ j, IsCompactOperator (localize j)) :
    IsCompactOperator
      (∑ j, (reconstruct j).comp (localize j)) := by
  classical
  have hFinite : ∀ s : Finset J,
      IsCompactOperator
        (∑ j ∈ s, (reconstruct j).comp (localize j)) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        simp only [Finset.sum_empty]
        exact isCompactOperator_zero
    | @insert j s hj ih =>
        rw [Finset.sum_insert hj]
        exact ((hLocal j).clm_comp (reconstruct j)).add ih
  simpa using hFinite Finset.univ

/-- Non-circular finite-chart Rellich interface.  The equality identifies a
global restriction with actual chart localization/reconstruction maps, while
each local premise is the quantitative Fourier tail used above. -/
theorem isCompactOperator_of_finite_torus_chart_decomposition
    {J : Type*} [Fintype J]
    (T : H →L[ℂ] E)
    (localize : J → H →L[ℂ] TwoTorusL2)
    (reconstruct : J → TwoTorusL2 →L[ℂ] E)
    (modes : J → ℕ → Finset (Fin 2 → ℤ))
    (hDecompose : T = ∑ j, (reconstruct j).comp (localize j))
    (hTail : ∀ j, HasVanishingFiniteModeTail
      twoTorusFourierBasis (modes j) (localize j)) :
    IsCompactOperator T := by
  rw [hDecompose]
  exact finite_chart_sum_isCompact localize reconstruct fun j ↦
    twoTorus_isCompactOperator_of_fourierTail
      (modes j) (localize j) (hTail j)

end P5LocalFourierRellich

namespace AxiomAuditP5LocalFourierRellich

#print axioms P5LocalFourierRellich.finiteHilbertProjection_isCompact
#print axioms P5LocalFourierRellich.finiteModeLocalization_isCompact
#print axioms P5LocalFourierRellich.isCompactOperator_of_vanishingFiniteModeTail
#print axioms P5LocalFourierRellich.twoTorusFiniteFourierProjection_isCompact
#print axioms P5LocalFourierRellich.twoTorus_isCompactOperator_of_fourierTail
#print axioms P5LocalFourierRellich.isCompactOperator_of_finite_torus_chart_decomposition

end AxiomAuditP5LocalFourierRellich
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.25: the exact planar Friedrichs graph identity

The Hilbert-valued approximation in P3.21 used only translation continuity.
Here we close the complementary distributional calculation.  For an actual
weak affine graph `(u, Pu)`, convolution by the normalized mollifier is
smooth and its *classical* affine Maass derivative is exactly

`rho_j * Pu + (D (t.im * rho_j)) * u`.

The proof keeps the zeroth-order coefficient `c` throughout.  In particular
the extra `+rho_j` in the commutator is not discarded: it is the divergence
of the affine height coefficient and is precisely what makes the transpose
coefficient `c - 1` agree with the forward coefficient `c`.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

/-- Complex-bilinear pairing of a full-plane test with a planar `L2`
representative.  This is deliberately not the Hermitian `L2` pairing: it is
the distributional pairing used in `IsPlanarAffineWeakGraph`. -/
noncomputable def fullPlaneBilinearPair
    (v : FullPlaneTest) (u : AmbientPlaneL2) : ℂ :=
  ∫ x : ℂ, v x * u x

theorem fullPlaneBilinearPair_add
    (v q : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair (v + q) u =
      fullPlaneBilinearPair v u + fullPlaneBilinearPair q u := by
  unfold fullPlaneBilinearPair
  simpa only [add_apply, add_mul] using
    integral_add (fullPlaneTest_mul_l2_integrable v u)
      (fullPlaneTest_mul_l2_integrable q u)

theorem fullPlaneBilinearPair_sub
    (v q : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair (v - q) u =
      fullPlaneBilinearPair v u - fullPlaneBilinearPair q u := by
  unfold fullPlaneBilinearPair
  simpa only [sub_apply, sub_mul] using
    integral_sub (fullPlaneTest_mul_l2_integrable v u)
      (fullPlaneTest_mul_l2_integrable q u)

theorem fullPlaneBilinearPair_smul
    (a : ℂ) (v : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair (a • v) u =
      a * fullPlaneBilinearPair v u := by
  unfold fullPlaneBilinearPair
  change (∫ x : ℂ, (a * v x) * u x) = a * ∫ x : ℂ, v x * u x
  simpa only [mul_assoc] using
    (integral_const_mul a (fun x : ℂ ↦ v x * u x))

/-- The Frechet derivative of the pointwise mollification.  Every term is a
genuine Bochner integral: compact support of `fderiv rho_j` and local
integrability of an `L2` representative supply the convolution-existence
premise needed to commute evaluation with the integral. -/
theorem fderiv_friedrichsMollifiedRepresentative_apply
    (j : ℕ) (u : AmbientPlaneL2) (w xi : ℂ) :
    fderiv ℝ (friedrichsMollifiedRepresentative j u) w xi =
      ∫ x : ℂ,
        fderiv ℝ (friedrichsMollifier j) (w - x) xi * u x := by
  have hLocal : LocallyIntegrable (u : ℂ → ℂ)
      (volume : Measure ℂ) :=
    (MeasureTheory.Lp.memLp u).locallyIntegrable (by norm_num)
  have hRhoOne : ContDiff ℝ 1 (friedrichsMollifierReal j) :=
    (friedrichsMollifierReal_contDiff j).of_le (by simp)
  have hDerivative :=
    (friedrichsMollifierReal_hasCompactSupport j).hasFDerivAt_convolution_left
        (lsmul ℝ ℂ) hRhoOne hLocal w
  rw [hDerivative.fderiv]
  have hDerivativeConvolution : ConvolutionExists
      (fderiv ℝ (friedrichsMollifierReal j)) (u : ℂ → ℂ)
      ((lsmul ℝ ℂ).precompL ℂ) (volume : Measure ℂ) :=
    ((friedrichsMollifierReal_hasCompactSupport j).fderiv ℝ).convolutionExists_left
        ((lsmul ℝ ℂ).precompL ℂ)
        hRhoOne.continuous_fderiv (by norm_num) hLocal
  rw [convolution_eq_swap,
    ContinuousLinearMap.integral_apply
      (hDerivativeConvolution w).integrable_swap xi]
  apply integral_congr_ae
  filter_upwards with x
  simp only [ContinuousLinearMap.precompL_apply, lsmul_apply,
    Complex.real_smul, fderiv_friedrichsMollifier]

/-- The symmetric convolution formula is exactly the bilinear pairing with
the reflected translated mollifier test. -/
theorem friedrichsMollifiedRepresentative_eq_pair
    (j : ℕ) (u : AmbientPlaneL2) (w : ℂ) :
    friedrichsMollifiedRepresentative j u w =
      fullPlaneBilinearPair
        (friedrichsTranslatedMollifierTest j w) u := by
  rw [friedrichsMollifiedRepresentative, convolution_lsmul_swap]
  unfold fullPlaneBilinearPair
  apply integral_congr_ae
  filter_upwards with x
  simp only [friedrichsTranslatedMollifierTest_apply,
    friedrichsMollifier, Complex.real_smul]

/-- Differentiating in the output variable is the negative of
differentiating the reflected translated test in the integration variable. -/
theorem fderiv_friedrichsMollifiedRepresentative_eq_neg_pair
    (j : ℕ) (u : AmbientPlaneL2) (w xi : ℂ) :
    fderiv ℝ (friedrichsMollifiedRepresentative j u) w xi =
      -fullPlaneBilinearPair
        (fullPlaneDirectionalDerivative xi
          (friedrichsTranslatedMollifierTest j w)) u := by
  rw [fderiv_friedrichsMollifiedRepresentative_apply]
  unfold fullPlaneBilinearPair
  rw [← integral_neg]
  apply integral_congr_ae
  filter_upwards with x
  rw [fullPlaneDirectionalDerivative_apply,
    fderiv_friedrichsTranslatedMollifierTest]
  ring

/-- The compact test whose bilinear pairing is the classical forward affine
Maass expression of the mollified representative. -/
noncomputable def friedrichsAffineForwardTranslateTest
    (sigma c : ℂ) (j : ℕ) (w : ℂ) : FullPlaneTest :=
  (-(sigma * (w.im : ℂ))) •
      fullPlaneDirectionalDerivative 1
        (friedrichsTranslatedMollifierTest j w) +
    (-((w.im : ℂ))) •
      fullPlaneDirectionalDerivative Complex.I
        (friedrichsTranslatedMollifierTest j w) +
    c • friedrichsTranslatedMollifierTest j w

@[simp]
theorem friedrichsAffineForwardTranslateTest_apply
    (sigma c : ℂ) (j : ℕ) (w x : ℂ) :
    friedrichsAffineForwardTranslateTest sigma c j w x =
      sigma * (w.im : ℂ) *
          fderiv ℝ (friedrichsMollifier j) (w - x) 1 +
        (w.im : ℂ) *
          fderiv ℝ (friedrichsMollifier j) (w - x) Complex.I +
        c * friedrichsMollifier j (w - x) := by
  simp only [friedrichsAffineForwardTranslateTest,
    add_apply, smul_apply,
    fullPlaneDirectionalDerivative_apply,
    friedrichsTranslatedMollifierTest_apply, smul_eq_mul]
  rw [fderiv_friedrichsTranslatedMollifierTest,
    fderiv_friedrichsTranslatedMollifierTest]
  ring

/-- Exact classical-forward/pairing identity, with no weak premise. -/
theorem ambientAffineMaass_friedrichsMollifiedRepresentative
    (sigma c : ℂ) (j : ℕ) (u : AmbientPlaneL2) (w : ℂ) :
    ambientAffineMaass sigma c
        (friedrichsMollifiedRepresentative j u) w =
      fullPlaneBilinearPair
        (friedrichsAffineForwardTranslateTest sigma c j w) u := by
  rw [ambientAffineMaass, ambientConstantMaassDerivative,
    fderiv_friedrichsMollifiedRepresentative_eq_neg_pair,
    fderiv_friedrichsMollifiedRepresentative_eq_neg_pair,
    friedrichsMollifiedRepresentative_eq_pair]
  simp only [friedrichsAffineForwardTranslateTest,
    fullPlaneBilinearPair_add, fullPlaneBilinearPair_smul]
  ring

/-- Difference between the forward test and the distributional transpose.
Although `c` appears in its definition, the next theorem shows pointwise that
it cancels completely. -/
noncomputable def friedrichsAffineCommutatorTranslateTest
    (sigma c : ℂ) (j : ℕ) (w : ℂ) : FullPlaneTest :=
  friedrichsAffineForwardTranslateTest sigma c j w -
    fullPlaneAffineTranspose sigma c
      (friedrichsTranslatedMollifierTest j w)

/-- Literal translated-kernel identity.  This is the coefficient-sensitive
heart of Friedrichs' lemma for the affine Maass operator. -/
@[simp]
theorem friedrichsAffineCommutatorTranslateTest_apply
    (sigma c : ℂ) (j : ℕ) (w x : ℂ) :
    friedrichsAffineCommutatorTranslateTest sigma c j w x =
      friedrichsAffineCommutatorKernel sigma j (w - x) := by
  rw [friedrichsAffineCommutatorTranslateTest,
    sub_apply,
    friedrichsAffineForwardTranslateTest_apply,
    fullPlaneAffineTranspose_apply,
    fderiv_friedrichsTranslatedMollifierTest,
    fderiv_friedrichsTranslatedMollifierTest,
    friedrichsAffineCommutatorKernel_expanded,
    fderiv_friedrichsMollifier,
    fderiv_friedrichsMollifier,
    Complex.sub_im]
  ring

/-- The bilinear pairing of the commutator test is the expected translated
commutator convolution. -/
theorem fullPlaneBilinearPair_friedrichsAffineCommutatorTranslateTest
    (sigma c : ℂ) (j : ℕ) (u : AmbientPlaneL2) (w : ℂ) :
    fullPlaneBilinearPair
        (friedrichsAffineCommutatorTranslateTest sigma c j w) u =
      ∫ x : ℂ,
        friedrichsAffineCommutatorKernel sigma j (w - x) * u x := by
  unfold fullPlaneBilinearPair
  apply integral_congr_ae
  filter_upwards with x
  rw [friedrichsAffineCommutatorTranslateTest_apply]

/-- **Exact weak graph convolution identity.**  One and the same normalized
mollifier regularizes the source, and the classical forward affine Maass
operator of that regularization is the mollification of the weak derivative
plus the explicit zero-mean commutator convolution. -/
theorem IsPlanarAffineWeakGraph.friedrichs_identity
    {sigma c : ℂ} {u Pu : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraph sigma c u Pu)
    (j : ℕ) (w : ℂ) :
    ambientAffineMaass sigma c
        (friedrichsMollifiedRepresentative j u) w =
      friedrichsMollifiedRepresentative j Pu w +
        ∫ x : ℂ,
          friedrichsAffineCommutatorKernel sigma j (w - x) * u x := by
  have hTranslated := hWeak.translatedMollifier j w
  change
    fullPlaneBilinearPair
        (friedrichsTranslatedMollifierTest j w) Pu =
      fullPlaneBilinearPair
        (fullPlaneAffineTranspose sigma c
          (friedrichsTranslatedMollifierTest j w)) u at hTranslated
  calc
    ambientAffineMaass sigma c
        (friedrichsMollifiedRepresentative j u) w =
        fullPlaneBilinearPair
          (friedrichsAffineForwardTranslateTest sigma c j w) u :=
      ambientAffineMaass_friedrichsMollifiedRepresentative
        sigma c j u w
    _ = fullPlaneBilinearPair
          (fullPlaneAffineTranspose sigma c
            (friedrichsTranslatedMollifierTest j w)) u +
        fullPlaneBilinearPair
          (friedrichsAffineCommutatorTranslateTest sigma c j w) u := by
      rw [friedrichsAffineCommutatorTranslateTest,
        fullPlaneBilinearPair_sub]
      ring
    _ = fullPlaneBilinearPair
          (friedrichsTranslatedMollifierTest j w) Pu +
        fullPlaneBilinearPair
          (friedrichsAffineCommutatorTranslateTest sigma c j w) u := by
      rw [hTranslated]
    _ = friedrichsMollifiedRepresentative j Pu w +
        ∫ x : ℂ,
          friedrichsAffineCommutatorKernel sigma j (w - x) * u x := by
      rw [← friedrichsMollifiedRepresentative_eq_pair,
        fullPlaneBilinearPair_friedrichsAffineCommutatorTranslateTest]

/-- Raising specialization.  The coefficient is the exact Euclidean-gauge
coefficient at source orbit `n`; no weight-independent replacement is used. -/
theorem IsPlanarAffineWeakGraph.friedrichs_raising_identity
    {n : ℤ} {u Ru : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraph Complex.I
      (((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ)) u Ru)
    (j : ℕ) (w : ℂ) :
    ambientAffineMaass Complex.I
        (((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ))
        (friedrichsMollifiedRepresentative j u) w =
      friedrichsMollifiedRepresentative j Ru w +
        ∫ x : ℂ,
          friedrichsAffineCommutatorKernel Complex.I j (w - x) * u x :=
  hWeak.friedrichs_identity j w

/-- Lowering-from-successor specialization. -/
theorem IsPlanarAffineWeakGraph.friedrichs_loweringFromSucc_identity
    {n : ℤ} {u Lu : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraph (-Complex.I)
      (-(((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ))) u Lu)
    (j : ℕ) (w : ℂ) :
    ambientAffineMaass (-Complex.I)
        (-(((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ)))
        (friedrichsMollifiedRepresentative j u) w =
      friedrichsMollifiedRepresentative j Lu w +
        ∫ x : ℂ,
          friedrichsAffineCommutatorKernel (-Complex.I) j (w - x) * u x :=
  hWeak.friedrichs_identity j w

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3ExactPlanarFriedrichs

#print axioms FixedPhaseNormalizedFriedrichs.fderiv_friedrichsMollifiedRepresentative_apply
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsAffineCommutatorTranslateTest_apply
#print axioms FixedPhaseNormalizedFriedrichs.IsPlanarAffineWeakGraph.friedrichs_identity
#print axioms FixedPhaseNormalizedFriedrichs.IsPlanarAffineWeakGraph.friedrichs_raising_identity
#print axioms FixedPhaseNormalizedFriedrichs.IsPlanarAffineWeakGraph.friedrichs_loweringFromSucc_identity

end AxiomAuditP3ExactPlanarFriedrichs
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
## P5.2: the actual discriminant cusp scale and hard-truncation endpoint

The discriminant potential already has a proved uniform tail on the quotient
outside the image of the literal three-cusp truncation.  Here we choose one
literal height for the explicit null sequence `1 / (N+1)` and connect compact
stage restrictions to the completed graph potential by bounded
postcomposition and operator-norm closure.

No compactness premise is attached to the scalar potential itself.  The only
remaining local input in the last theorem is compactness of the displayed
hard stage restriction; `P5LocalFourierRellich` is designed to prove exactly
that input chart by chart.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P5DiscriminantHardTruncation

open Function Set Topology Filter MeasureTheory
open scoped ENNReal NNReal
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open ExplicitDiscriminantPotential
open ExplicitDiscriminantPotential.FixedPhaseGraphPotential
open GammaTwoQuotientGeometry

/-- Explicit positive error used for the potential tail. -/
noncomputable def discriminantCuspEpsilon (N : ℕ) : ℝ :=
  1 / ((N : ℝ) + 1)

theorem discriminantCuspEpsilon_pos (N : ℕ) :
    0 < discriminantCuspEpsilon N := by
  unfold discriminantCuspEpsilon
  positivity

theorem discriminantCuspEpsilon_nonneg (N : ℕ) :
    0 ≤ discriminantCuspEpsilon N :=
  (discriminantCuspEpsilon_pos N).le

theorem discriminantCuspEpsilon_tendsto_zero :
    Filter.Tendsto discriminantCuspEpsilon Filter.atTop (nhds 0) := by
  simpa only [discriminantCuspEpsilon, Nat.cast_add, Nat.cast_one] using
    (tendsto_one_div_add_atTop_nhds_zero_nat :
      Filter.Tendsto (fun N : ℕ ↦ (1 : ℝ) / (N + 1)) Filter.atTop (nhds 0))

/-- One actual literal three-cusp height chosen for the `N`-th quantitative
tail tolerance. -/
noncomputable def discriminantLiteralCuspLevel (N : ℕ) : ℝ :=
  Classical.choose
    (potential_quotientOutside_threeCuspTruncationImage
      (discriminantCuspEpsilon_pos N))

theorem one_le_discriminantLiteralCuspLevel (N : ℕ) :
    1 ≤ discriminantLiteralCuspLevel N :=
  (Classical.choose_spec
    (potential_quotientOutside_threeCuspTruncationImage
      (discriminantCuspEpsilon_pos N))).1

/-- The selected level has the promised uniform pointwise potential tail on
the actual quotient complement. -/
theorem potential_le_discriminantCuspEpsilon_outside_literalStage
    (N : ℕ) (q : GammaTwoQuotient)
    (hq : q ∉ gammaTwoQuotientMk ''
      gammaTwoThreeCuspTruncation (discriminantLiteralCuspLevel N)) :
    potential q ≤ discriminantCuspEpsilon N :=
  (Classical.choose_spec
    (potential_quotientOutside_threeCuspTruncationImage
      (discriminantCuspEpsilon_pos N))).2 q hq

section HardStageFactorization

variable {E : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- A compact hard-stage restriction remains compact after the bounded
potential pairing into the graph anti-dual. -/
theorem hardStagePotentialFactor_isCompact
    (n : ℤ)
    (stageRestriction : GraphSobolevCompletion n →L[ℂ] E)
    (stagePotentialPairing :
      E →L[ℂ] StrongAntiDual (GraphSobolevCompletion n))
    (hStage : IsCompactOperator stageRestriction) :
    IsCompactOperator (stagePotentialPairing.comp stageRestriction) :=
  hStage.clm_comp stagePotentialPairing

/-- Exact operator-norm endpoint for literal hard truncations.  The
approximants are not abstract compact certificates: each one is displayed as
the composition of a hard-stage restriction with a bounded potential pairing.
The quantitative bound is matched to the actual discriminant cusp scale
chosen above. -/
theorem graphPotentialOperator_isCompact_of_literalStageFactorization
    (n : ℤ)
    (stageRestriction : ℕ → GraphSobolevCompletion n →L[ℂ] E)
    (stagePotentialPairing : ℕ →
      E →L[ℂ] StrongAntiDual (GraphSobolevCompletion n))
    (hStage : ∀ N, IsCompactOperator (stageRestriction N))
    (hTail : ∀ N,
      ‖(stagePotentialPairing N).comp (stageRestriction N) -
          graphPotentialOperator n‖ ≤ discriminantCuspEpsilon N) :
    IsCompactOperator (graphPotentialOperator n) := by
  apply isCompactOperator_of_tendsto
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero
      (fun N ↦ norm_nonneg
        ((stagePotentialPairing N).comp (stageRestriction N) -
          graphPotentialOperator n))
      hTail discriminantCuspEpsilon_tendsto_zero
  · exact Filter.Eventually.of_forall fun N ↦
      hardStagePotentialFactor_isCompact n
        (stageRestriction N) (stagePotentialPairing N) (hStage N)

end HardStageFactorization

end P5DiscriminantHardTruncation

namespace AxiomAuditP5DiscriminantHardTruncation

#print axioms P5DiscriminantHardTruncation.discriminantCuspEpsilon_tendsto_zero
#print axioms P5DiscriminantHardTruncation.potential_le_discriminantCuspEpsilon_outside_literalStage
#print axioms P5DiscriminantHardTruncation.hardStagePotentialFactor_isCompact
#print axioms P5DiscriminantHardTruncation.graphPotentialOperator_isCompact_of_literalStageFactorization

end AxiomAuditP5DiscriminantHardTruncation
