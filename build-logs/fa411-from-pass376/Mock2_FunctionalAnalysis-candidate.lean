/-! ### Pure graph lemmas used by both directions -/

/-- If finitely many points lie in a linear graph and their first
coordinates reconstruct the first coordinate of another graph point, then
their second coordinates reconstruct its second coordinate.  This is the
precise single-valuedness argument that replaces a derivative partition-of-
unity calculation. -/
theorem finset_graph_snd_eq_of_sum_fst_eq
    {E F ι : Type*}
    [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F]
    (T : E →ₗ.[ℂ] F) (s : Finset ι)
    (x : ι → E) (y : ι → F) (p : E × F)
    (hp : p ∈ T.graph)
    (hxy : ∀ i ∈ s, (x i, y i) ∈ T.graph)
    (hx : (∑ i ∈ s, x i) = p.1) :
    (∑ i ∈ s, y i) = p.2 := by
  classical
  have hPair : (∑ i ∈ s, (x i, y i)) ∈ T.graph :=
    T.graph.sum_mem fun i hi ↦ hxy i hi
  have hFst : (∑ i ∈ s, (x i, y i)).1 = p.1 := by
    simpa only [Prod.fst_sum, Prod.fst_mk] using hx
  have hSnd := T.mem_graph_snd_inj' hPair hp hFst
  simpa only [Prod.snd_sum, Prod.snd_mk] using hSnd

/-- A convergent sequence in the physical raising graph has its limit in the
closed opposite maximal-adjoint graph. -/
theorem raising_limit_mem_oppositeMaximalGraph
    (n : ℤ) (q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    (x : OrbitPeterssonHilbert n)
    (y : OrbitPeterssonHilbert (n + 1))
    (hq : ∀ j : ℕ,
      (l2Coordinate n (q j), raisedCoordinate n (q j)) ∈
        (physicalRaise n).graph)
    (hx : Filter.Tendsto (fun j ↦ l2Coordinate n (q j)) Filter.atTop (𝓝 x))
    (hy : Filter.Tendsto (fun j ↦ raisedCoordinate n (q j)) Filter.atTop (𝓝 y)) :
    (x, y) ∈ ((-physicalLowerFromSucc n)†).graph := by
  apply (LinearPMap.adjoint_isClosed
    (negativePhysicalLowerFromSucc_dense_domain n)).mem_of_tendsto
      (hx.prodMk_nhds hy)
  exact Filter.Eventually.of_forall fun j ↦
    LinearPMap.le_graph_of_le
      (raise_le_negativeLower_adjoint
        (physicalGreenIdentityAt_unconditional n)) (hq j)

/-- Lowering counterpart of `raising_limit_mem_oppositeMaximalGraph`. -/
theorem lowering_limit_mem_oppositeMaximalGraph
    (n : ℤ) (q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1))
    (x : OrbitPeterssonHilbert (n + 1))
    (y : OrbitPeterssonHilbert n)
    (hq : ∀ j : ℕ,
      (l2Coordinate (n + 1) (q j), lowerFromSuccCoordinate n (q j)) ∈
        (physicalLowerFromSucc n).graph)
    (hx : Filter.Tendsto (fun j ↦ l2Coordinate (n + 1) (q j)) Filter.atTop (𝓝 x))
    (hy : Filter.Tendsto (fun j ↦ lowerFromSuccCoordinate n (q j)) Filter.atTop (𝓝 y)) :
    (x, y) ∈ ((-physicalRaise n)†).graph := by
  apply (LinearPMap.adjoint_isClosed
    (negativePhysicalRaise_dense_domain n)).mem_of_tendsto
      (hx.prodMk_nhds hy)
  exact Filter.Eventually.of_forall fun j ↦
    LinearPMap.le_graph_of_le
      (lower_le_negativeRaise_adjoint
        (physicalGreenIdentityAt_unconditional n)) (hq j)

/-! ### One localized chart, with its global base limit identified -/

/-- One quotient-compatible scalar chart localization of a compact raising
maximal-graph vector admits a physical core graph sequence.  Its base limit
is the literal completed invariant scalar multiplier, and the whole limit
pair remains in the opposite maximal graph. -/
theorem exists_localizedRaisingGraphSequence
    (n : ℤ) (z₀ : ℍ)
    (p : OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1))
    (hp : p ∈ ((-physicalLowerFromSucc n)†).graph)
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀) :
    ∃ q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n,
    ∃ x : OrbitPeterssonHilbert n,
    ∃ y : OrbitPeterssonHilbert (n + 1),
      (∀ j : ℕ,
        (l2Coordinate n (q j), raisedCoordinate n (q j)) ∈
          (physicalRaise n).graph) ∧
      Filter.Tendsto (fun j ↦ l2Coordinate n (q j)) Filter.atTop (𝓝 x) ∧
      Filter.Tendsto (fun j ↦ raisedCoordinate n (q j)) Filter.atTop (𝓝 y) ∧
      x = invariantScalarPeterssonMultiplier
        (effectiveScalarSmoothQuotient phi)
        (effectiveScalarSmoothQuotient_invariant phi) n p.1 ∧
      (x, y) ∈ ((-physicalLowerFromSucc n)†).graph := by
  let psi : FullPlaneTest := ambientTestCoreToFullPlaneTest phi
  have hpsi : tsupport (psi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀ := by
    change tsupport (phi : ℂ → ℂ) ⊆ ambientGammaTwoReducedChart z₀
    exact hphi
  let u : AmbientPlaneL2 := fullPlaneTestMulL2 psi
    (orbitPeterssonReducedChartEmbedding n z₀ p.1)
  let Ru : AmbientPlaneL2 := localizedAffineTarget Complex.I psi
    (orbitPeterssonReducedChartEmbedding n z₀ p.1)
    (orbitPeterssonReducedChartEmbedding (n + 1) z₀ p.2)
  have hWeakOn :=
    raisingMaximalAdjoint_isPlanarAffineWeakGraphOn_reducedChart
      n z₀ p hp
  have hWeak : IsPlanarAffineWeakGraph Complex.I
      (((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ))
      u Ru := by
    exact hWeakOn.localizeOn psi hpsi
  let K : Set ℂ := tsupport (psi : ℂ → ℂ)
  have hK : IsCompact K := psi.hasCompactSupport
  have hKU : K ⊆ ambientGammaTwoReducedChart z₀ := hpsi
  have hu : HasEssentialSupportIn u K := by
    exact fullPlaneTestMulL2_hasEssentialSupport psi
      (orbitPeterssonReducedChartEmbedding n z₀ p.1)
  obtain ⟨q, v, x, y, hqGraph, hqModel, hv, hx, hy⟩ :=
    exists_periodizedLocalRaisingGraphLimitWithModels
      hK hKU u Ru hu hWeak
  have hvMultiplier : Filter.Tendsto (fun j ↦ fullPlaneTestToL2 (v j))
      Filter.atTop (𝓝 (fullPlaneTestMulCLM
        (ambientTestCoreToFullPlaneTest phi)
        (orbitPeterssonReducedChartEmbedding n z₀ p.1))) := by
    simpa only [u, psi, fullPlaneTestMulCLM_apply] using hv
  have hxIdentified : x = invariantScalarPeterssonMultiplier
      (effectiveScalarSmoothQuotient phi)
      (effectiveScalarSmoothQuotient_invariant phi) n p.1 :=
    localBaseLimit_eq_invariantScalarMultiplier
      phi hphi p.1 x q v hqModel hx hvMultiplier
  refine ⟨q, x, y, hqGraph, hx, hy, hxIdentified, ?_⟩
  exact raising_limit_mem_oppositeMaximalGraph n q x y hqGraph hx hy

/-- Lowering version of `exists_localizedRaisingGraphSequence`. -/
theorem exists_localizedLoweringGraphSequence
    (n : ℤ) (z₀ : ℍ)
    (p : OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n)
    (hp : p ∈ ((-physicalRaise n)†).graph)
    (phi : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀) :
    ∃ q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1),
    ∃ x : OrbitPeterssonHilbert (n + 1),
    ∃ y : OrbitPeterssonHilbert n,
      (∀ j : ℕ,
        (l2Coordinate (n + 1) (q j), lowerFromSuccCoordinate n (q j)) ∈
          (physicalLowerFromSucc n).graph) ∧
      Filter.Tendsto (fun j ↦ l2Coordinate (n + 1) (q j)) Filter.atTop (𝓝 x) ∧
      Filter.Tendsto (fun j ↦ lowerFromSuccCoordinate n (q j)) Filter.atTop (𝓝 y) ∧
      x = invariantScalarPeterssonMultiplier
        (effectiveScalarSmoothQuotient phi)
        (effectiveScalarSmoothQuotient_invariant phi) (n + 1) p.1 ∧
      (x, y) ∈ ((-physicalRaise n)†).graph := by
  let psi : FullPlaneTest := ambientTestCoreToFullPlaneTest phi
  have hpsi : tsupport (psi : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀ := by
    change tsupport (phi : ℂ → ℂ) ⊆ ambientGammaTwoReducedChart z₀
    exact hphi
  let u : AmbientPlaneL2 := fullPlaneTestMulL2 psi
    (orbitPeterssonReducedChartEmbedding (n + 1) z₀ p.1)
  let Lu : AmbientPlaneL2 := localizedAffineTarget (-Complex.I) psi
    (orbitPeterssonReducedChartEmbedding (n + 1) z₀ p.1)
    (orbitPeterssonReducedChartEmbedding n z₀ p.2)
  have hWeakOn :=
    loweringMaximalAdjoint_isPlanarAffineWeakGraphOn_reducedChart
      n z₀ p hp
  have hWeak : IsPlanarAffineWeakGraph (-Complex.I)
      (-(((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ)))
      u Lu := by
    exact hWeakOn.localizeOn psi hpsi
  let K : Set ℂ := tsupport (psi : ℂ → ℂ)
  have hK : IsCompact K := psi.hasCompactSupport
  have hKU : K ⊆ ambientGammaTwoReducedChart z₀ := hpsi
  have hu : HasEssentialSupportIn u K := by
    exact fullPlaneTestMulL2_hasEssentialSupport psi
      (orbitPeterssonReducedChartEmbedding (n + 1) z₀ p.1)
  obtain ⟨q, v, x, y, hqGraph, hqModel, hv, hx, hy⟩ :=
    exists_periodizedLocalLoweringGraphLimitWithModels
      hK hKU u Lu hu hWeak
  have hvMultiplier : Filter.Tendsto (fun j ↦ fullPlaneTestToL2 (v j))
      Filter.atTop (𝓝 (fullPlaneTestMulCLM
        (ambientTestCoreToFullPlaneTest phi)
        (orbitPeterssonReducedChartEmbedding (n + 1) z₀ p.1))) := by
    simpa only [u, psi, fullPlaneTestMulCLM_apply] using hv
  have hxIdentified : x = invariantScalarPeterssonMultiplier
      (effectiveScalarSmoothQuotient phi)
      (effectiveScalarSmoothQuotient_invariant phi) (n + 1) p.1 :=
    localBaseLimit_eq_invariantScalarMultiplier
      phi hphi p.1 x q v hqModel hx hvMultiplier
  refine ⟨q, x, y, hqGraph, hx, hy, hxIdentified, ?_⟩
  exact lowering_limit_mem_oppositeMaximalGraph n q x y hqGraph hx hy

/-! ### Finite quotient-compatible gluing -/

/-- Two compactly supported completed Petersson vectors admit one common
literal compact carrier, obtained by taking the union of their selected
carriers.  The finite quotient localization can therefore be chosen once for
the complete graph pair. -/
theorem exists_commonCompactCarrierSupport
    {m₀ m₁ : ℤ}
    (x : OrbitPeterssonHilbert m₀)
    (y : OrbitPeterssonHilbert m₁)
    (hx : HasCompactCarrierSupport m₀ x)
    (hy : HasCompactCarrierSupport m₁ y) :
    ∃ K : Set ℍ, IsCompact K ∧
      (∀ᵐ z ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.chosenEuclideanCarrierMeasure,
        z ∉ K →
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding m₀ x z = 0) ∧
      (∀ᵐ z ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.chosenEuclideanCarrierMeasure,
        z ∉ K →
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding m₁ y z = 0) := by
  obtain ⟨Kx, hKx, hxK⟩ := hx
  obtain ⟨Ky, hKy, hyK⟩ := hy
  refine ⟨Kx ∪ Ky, hKx.union hKy, ?_, ?_⟩
  · filter_upwards [hxK] with z hz
    intro hzUnion
    exact hz (fun hzKx ↦ hzUnion (Or.inl hzKx))
  · filter_upwards [hyK] with z hz
    intro hzUnion
    exact hz (fun hzKy ↦ hzUnion (Or.inr hzKy))

/-- The finite localization identity, rewritten over the attached finite
index type used for dependent local choices. -/
theorem effectiveScalarSmoothQuotient_sum_attach_eq_one
    {K : Set ℍ} {t : Finset ℍ}
    {theta : ℍ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hsum : ∀ z ∈ gammaTwoOrbitSaturation K,
      (∑ x ∈ t,
        effectiveScalarPoincarePeriodization (theta x) z) = 1)
    {z : ℍ} (hz : z ∈ gammaTwoOrbitSaturation K) :
    (∑ i : {x // x ∈ t},
      (effectiveScalarSmoothQuotient (theta i) : ℍ → ℂ) z) = 1 := by
  classical
  calc
    (∑ i : {x // x ∈ t},
        (effectiveScalarSmoothQuotient (theta i) : ℍ → ℂ) z) =
        ∑ i in t.attach,
          effectiveScalarPoincarePeriodization (theta i) z := by
            rw [Finset.attach_eq_univ]
            simp only [effectiveScalarSmoothQuotient_apply]
    _ = ∑ i ∈ t,
          effectiveScalarPoincarePeriodization (theta i) z := by
            exact Finset.sum_attach t _
    _ = 1 := hsum z hz

/-- The attached family of completed invariant scalar multipliers exactly
reconstructs every vector essentially supported on the compact carrier. -/
theorem finiteQuotientLocalization_base_reconstruction
    {n : ℤ} {K : Set ℍ} (hK : IsCompact K)
    (p : OrbitPeterssonHilbert n)
    (hp : ∀ᵐ z ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.chosenEuclideanCarrierMeasure,
      z ∉ K → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p z = 0)
    {t : Finset ℍ} {theta : ℍ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore}
    (hsum : ∀ z ∈ gammaTwoOrbitSaturation K,
      (∑ x ∈ t,
        effectiveScalarPoincarePeriodization (theta x) z) = 1) :
    (∑ i : {x // x ∈ t},
      invariantScalarPeterssonMultiplier
        (effectiveScalarSmoothQuotient (theta i))
        (effectiveScalarSmoothQuotient_invariant (theta i)) n p) = p := by
  classical
  exact finset_sum_invariantScalarMultipliers_eq_of_compactSupport
    hK p hp Finset.univ
    (fun i : {x // x ∈ t} ↦ effectiveScalarSmoothQuotient (theta i))
    (fun i ↦ effectiveScalarSmoothQuotient_invariant (theta i))
    (fun z hz ↦ effectiveScalarSmoothQuotient_sum_attach_eq_one hsum hz)

/-- The compact weak raising maximal graph is unconditionally regularized by
the actual physical raising core. -/
theorem raisingCompactFriedrichsPeriodizationAt_unconditional (n : ℤ) :
    RaisingCompactFriedrichsPeriodizationAt n := by
  classical
  intro p hp
  obtain ⟨K, hK, hpK, _hpDerivativeK⟩ :=
    exists_commonCompactCarrierSupport p.1 p.2 hp.1.2.1 hp.1.2.2
  obtain ⟨t, theta, htheta, _hthetaInvariant, hthetaSum⟩ :=
    exists_quotientCompatibleFiniteReducedChartLocalization hK
  have hLocal (i : {z // z ∈ t}) :
      ∃ q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n,
      ∃ x : OrbitPeterssonHilbert n,
      ∃ y : OrbitPeterssonHilbert (n + 1),
        (∀ j : ℕ,
          (l2Coordinate n (q j), raisedCoordinate n (q j)) ∈
            (physicalRaise n).graph) ∧
        Filter.Tendsto (fun j ↦ l2Coordinate n (q j)) Filter.atTop (𝓝 x) ∧
        Filter.Tendsto (fun j ↦ raisedCoordinate n (q j)) Filter.atTop (𝓝 y) ∧
        x = invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient (theta i))
          (effectiveScalarSmoothQuotient_invariant (theta i)) n p.1 ∧
        (x, y) ∈ ((-physicalLowerFromSucc n)†).graph :=
    exists_localizedRaisingGraphSequence n i p hp.1.1
      (theta i) (htheta i i.property)
  choose q x y hqGraph hqBase hqRaise hxIdentified hxyMax using hLocal
  have hBaseReconstruction :
      (∑ i : {z // z ∈ t},
        invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient (theta i))
          (effectiveScalarSmoothQuotient_invariant (theta i)) n p.1) = p.1 := by
    exact finiteQuotientLocalization_base_reconstruction
      hK p.1 hpK hthetaSum
  have hxSum : (∑ i : {z // z ∈ t}, x i) = p.1 := by
    calc
      (∑ i : {z // z ∈ t}, x i) =
          ∑ i : {z // z ∈ t},
            invariantScalarPeterssonMultiplier
              (effectiveScalarSmoothQuotient (theta i))
              (effectiveScalarSmoothQuotient_invariant (theta i)) n p.1 := by
                apply Finset.sum_congr rfl
                intro i _hi
                exact hxIdentified i
      _ = p.1 := hBaseReconstruction
  have hySum : (∑ i : {z // z ∈ t}, y i) = p.2 :=
    finset_graph_snd_eq_of_sum_fst_eq
      ((-physicalLowerFromSucc n)†) Finset.univ x y p hp.1.1
      (fun i _hi ↦ hxyMax i) hxSum
  let Q : ℕ →
      OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1) := fun j ↦
    ∑ i : {z // z ∈ t},
      (l2Coordinate n (q i j), raisedCoordinate n (q i j))
  refine ⟨Q, ?_, ?_⟩
  · intro j
    change (∑ i : {z // z ∈ t},
      (l2Coordinate n (q i j), raisedCoordinate n (q i j))) ∈
        (physicalRaise n).graph
    exact (physicalRaise n).graph.sum_mem fun i _hi ↦ hqGraph i j
  · have hSum : Filter.Tendsto Q Filter.atTop
        (𝓝 (∑ i : {z // z ∈ t}, (x i, y i))) := by
      simpa only [Q] using
        (tendsto_finset_sum Finset.univ fun i _hi ↦
          (hqBase i).prodMk_nhds (hqRaise i))
    have hTarget : (∑ i : {z // z ∈ t}, (x i, y i)) = p := by
      apply Prod.ext
      · simpa only [Prod.fst_sum, Prod.fst_mk] using hxSum
      · simpa only [Prod.snd_sum, Prod.snd_mk] using hySum
    simpa only [hTarget] using hSum

/-- The compact weak lowering maximal graph is unconditionally regularized
by the actual physical lowering core. -/
theorem loweringCompactFriedrichsPeriodizationAt_unconditional (n : ℤ) :
    LoweringCompactFriedrichsPeriodizationAt n := by
  classical
  intro p hp
  obtain ⟨K, hK, hpK, _hpDerivativeK⟩ :=
    exists_commonCompactCarrierSupport p.1 p.2 hp.1.2.1 hp.1.2.2
  obtain ⟨t, theta, htheta, _hthetaInvariant, hthetaSum⟩ :=
    exists_quotientCompatibleFiniteReducedChartLocalization hK
  have hLocal (i : {z // z ∈ t}) :
      ∃ q : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1),
      ∃ x : OrbitPeterssonHilbert (n + 1),
      ∃ y : OrbitPeterssonHilbert n,
        (∀ j : ℕ,
          (l2Coordinate (n + 1) (q j), lowerFromSuccCoordinate n (q j)) ∈
            (physicalLowerFromSucc n).graph) ∧
        Filter.Tendsto (fun j ↦ l2Coordinate (n + 1) (q j)) Filter.atTop (𝓝 x) ∧
        Filter.Tendsto (fun j ↦ lowerFromSuccCoordinate n (q j)) Filter.atTop (𝓝 y) ∧
        x = invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient (theta i))
          (effectiveScalarSmoothQuotient_invariant (theta i)) (n + 1) p.1 ∧
        (x, y) ∈ ((-physicalRaise n)†).graph :=
    exists_localizedLoweringGraphSequence n i p hp.1.1
      (theta i) (htheta i i.property)
  choose q x y hqGraph hqBase hqLower hxIdentified hxyMax using hLocal
  have hBaseReconstruction :
      (∑ i : {z // z ∈ t},
        invariantScalarPeterssonMultiplier
          (effectiveScalarSmoothQuotient (theta i))
          (effectiveScalarSmoothQuotient_invariant (theta i)) (n + 1) p.1) =
        p.1 := by
    exact finiteQuotientLocalization_base_reconstruction
      hK p.1 hpK hthetaSum
  have hxSum : (∑ i : {z // z ∈ t}, x i) = p.1 := by
    calc
      (∑ i : {z // z ∈ t}, x i) =
          ∑ i : {z // z ∈ t},
            invariantScalarPeterssonMultiplier
              (effectiveScalarSmoothQuotient (theta i))
              (effectiveScalarSmoothQuotient_invariant (theta i))
              (n + 1) p.1 := by
                apply Finset.sum_congr rfl
                intro i _hi
                exact hxIdentified i
      _ = p.1 := hBaseReconstruction
  have hySum : (∑ i : {z // z ∈ t}, y i) = p.2 :=
    finset_graph_snd_eq_of_sum_fst_eq
      ((-physicalRaise n)†) Finset.univ x y p hp.1.1
      (fun i _hi ↦ hxyMax i) hxSum
  let Q : ℕ →
      OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n := fun j ↦
    ∑ i : {z // z ∈ t},
      (l2Coordinate (n + 1) (q i j), lowerFromSuccCoordinate n (q i j))
  refine ⟨Q, ?_, ?_⟩
  · intro j
    change (∑ i : {z // z ∈ t},
      (l2Coordinate (n + 1) (q i j), lowerFromSuccCoordinate n (q i j))) ∈
        (physicalLowerFromSucc n).graph
    exact (physicalLowerFromSucc n).graph.sum_mem fun i _hi ↦ hqGraph i j
  · have hSum : Filter.Tendsto Q Filter.atTop
        (𝓝 (∑ i : {z // z ∈ t}, (x i, y i))) := by
      simpa only [Q] using
        (tendsto_finset_sum Finset.univ fun i _hi ↦
          (hqBase i).prodMk_nhds (hqLower i))
    have hTarget : (∑ i : {z // z ∈ t}, (x i, y i)) = p := by
      apply Prod.ext
      · simpa only [Prod.fst_sum, Prod.fst_mk] using hxSum
      · simpa only [Prod.snd_sum, Prod.snd_mk] using hySum
    simpa only [hTarget] using hSum

/-! ### Public strong cross-adjoint endpoint -/

/-- The full strong raising/lowering cross-adjoint theorem, now with every
periodization, cutoff, and compact Friedrichs input discharged internally. -/
theorem strongCrossAdjointAt_unconditional (n : ℤ) :
