/-!
================================================================================
P3.7: the intrinsic modular maximum-height exhaustion

Instead of gluing six tilewise height functions across paired sides, take the
maximum height in the full integral modular orbit.  Mathlib proves that this
maximum is attained.  Its logarithm is intrinsically modular invariant and
one-Lipschitz for the hyperbolic metric.  Above height one, any maximizing
matrix remains maximizing on the open set where its transported height stays
above one; hence the apparently non-smooth maximum is locally one ordinary
smooth log-height precisely throughout every future cutoff transition shell.
================================================================================
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseGoodCuspCutoffBridge

open Set Function Topology Filter MeasureTheory Metric
open GammaTwoQuotientGeometry

/-- A canonical (classically chosen) integral matrix attaining the largest
imaginary part in the full modular orbit. -/
noncomputable def modularHeightMaximizer (z : ℍ) : SL(2, ℤ) :=
  Classical.choose (ModularGroup.exists_max_im z)

/-- The intrinsic maximum modular height. -/
noncomputable def modularMaxHeight (z : ℍ) : ℝ :=
  ((modularHeightMaximizer z) • z).im

theorem modularHeightMaximizer_spec (z : ℍ) (g : SL(2, ℤ)) :
    (g • z).im ≤ modularMaxHeight z := by
  exact (Classical.choose_spec (ModularGroup.exists_max_im z)) g

theorem modularMaxHeight_pos (z : ℍ) : 0 < modularMaxHeight z :=
  UpperHalfPlane.im_pos _

theorem im_le_modularMaxHeight (z : ℍ) :
    z.im ≤ modularMaxHeight z := by
  simpa only [one_smul] using modularHeightMaximizer_spec z 1

/-- The chosen maximum is independent of the initial integral modular
representative.  Both inequalities are obtained by reindexing the orbit. -/
theorem modularMaxHeight_SL_invariant (gamma : SL(2, ℤ)) (z : ℍ) :
    modularMaxHeight (gamma • z) = modularMaxHeight z := by
  apply le_antisymm
  · have h := modularHeightMaximizer_spec z
      (modularHeightMaximizer (gamma • z) * gamma)
    simpa only [modularMaxHeight, mul_smul] using h
  · have h := modularHeightMaximizer_spec (gamma • z)
      (modularHeightMaximizer z * gamma⁻¹)
    simpa only [modularMaxHeight, mul_smul, inv_smul_smul] using h

theorem modularMaxHeight_gammaTwo_invariant
    (gamma : GammaTwo) (z : ℍ) :
    modularMaxHeight (((gamma : GammaTwo) : SL(2, ℤ)) • z) =
      modularMaxHeight z :=
  modularMaxHeight_SL_invariant (gamma : SL(2, ℤ)) z

/-- The maximum also satisfies the elementary pointwise envelope already
proved for every individual integral modular translate. -/
theorem modularMaxHeight_le_heightEnvelope (z : ℍ) :
    modularMaxHeight z ≤ gammaTwoModularHeightEnvelope z := by
  exact modular_im_smul_le_heightEnvelope (modularHeightMaximizer z) z

/-- Logarithmic maximum height, the intrinsic cusp radial variable. -/
noncomputable def modularLogMaxHeight (z : ℍ) : ℝ :=
  Real.log (modularMaxHeight z)

theorem modularLogMaxHeight_SL_invariant
    (gamma : SL(2, ℤ)) (z : ℍ) :
    modularLogMaxHeight (gamma • z) = modularLogMaxHeight z := by
  simp only [modularLogMaxHeight, modularMaxHeight_SL_invariant]

theorem modularLogMaxHeight_gammaTwo_invariant
    (gamma : GammaTwo) (z : ℍ) :
    modularLogMaxHeight (((gamma : GammaTwo) : SL(2, ℤ)) • z) =
      modularLogMaxHeight z :=
  modularLogMaxHeight_SL_invariant (gamma : SL(2, ℤ)) z

/-- Integral modular transformations preserve the hyperbolic distance used by
`UpperHalfPlane.Metric`. -/
theorem dist_SL_smul (g : SL(2, ℤ)) (z w : ℍ) :
    dist (g • z) (g • w) = dist z w := by
  let gReal : SL(2, ℝ) :=
    Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) g
  have hAction : ∀ x : ℍ, g • x = gReal • x := by
    intro x
    apply UpperHalfPlane.ext
    simp [gReal, UpperHalfPlane.coe_specialLinearGroup_apply]
  rw [hAction z, hAction w, dist_smul]

/-- One directed logarithmic-height difference is bounded by hyperbolic
distance.  The maximizing matrix at the first point is merely a competitor at
the second point. -/
theorem modularLogMaxHeight_sub_le_dist (z w : ℍ) :
    modularLogMaxHeight z - modularLogMaxHeight w ≤ dist z w := by
  let g : SL(2, ℤ) := modularHeightMaximizer z
  have hCandidate : (g • w).im ≤ modularMaxHeight w :=
    modularHeightMaximizer_spec w g
  have hLog : Real.log (g • w).im ≤ Real.log (modularMaxHeight w) :=
    Real.log_le_log (g • w).im_pos hCandidate
  calc
    modularLogMaxHeight z - modularLogMaxHeight w =
        Real.log (g • z).im - Real.log (modularMaxHeight w) := by
      rfl
    _ ≤ Real.log (g • z).im - Real.log (g • w).im :=
      sub_le_sub_left hLog _
    _ ≤ |Real.log (g • z).im - Real.log (g • w).im| :=
      le_abs_self _
    _ = dist (Real.log (g • z).im) (Real.log (g • w).im) := by
      rw [Real.dist_eq]
    _ ≤ dist (g • z) (g • w) :=
      UpperHalfPlane.dist_log_im_le _ _
    _ = dist z w := dist_SL_smul g z w

/-- The intrinsic log-height is globally one-Lipschitz. -/
theorem modularLogMaxHeight_dist_le (z w : ℍ) :
    dist (modularLogMaxHeight z) (modularLogMaxHeight w) ≤ dist z w := by
  rw [Real.dist_eq, abs_le]
  constructor
  · have h := modularLogMaxHeight_sub_le_dist w z
    rw [dist_comm] at h
    linarith
  · exact modularLogMaxHeight_sub_le_dist z w

theorem modularLogMaxHeight_lipschitz :
    LipschitzWith 1 modularLogMaxHeight := by
  rw [lipschitzWith_iff_dist_le_mul]
  intro z w
  simpa only [NNReal.coe_one, one_mul] using
    modularLogMaxHeight_dist_le z w

theorem modularLogMaxHeight_continuous :
    Continuous modularLogMaxHeight :=
  modularLogMaxHeight_lipschitz.continuous

theorem modularMaxHeight_continuous : Continuous modularMaxHeight := by
  have hExp :
      (fun z : ℍ ↦ Real.exp (modularLogMaxHeight z)) = modularMaxHeight := by
    funext z
    simp only [modularLogMaxHeight,
      Real.exp_log (modularMaxHeight_pos z)]
  rw [← hExp]
  exact Real.continuous_exp.comp modularLogMaxHeight_continuous

/-- Above height one, the maximizing matrix chosen at `z` remains maximizing
on the explicit open neighborhood where its transported height remains above
one.  The pointwise envelope makes this proof independent of a classification
of parabolic stabilizers. -/
theorem modularMaxHeight_eventuallyEq_maximizer_im_of_one_lt
    {z : ℍ} (hz : 1 < modularMaxHeight z) :
    modularMaxHeight =ᶠ[nhds z]
      (fun w ↦ ((modularHeightMaximizer z) • w).im) := by
  let g : SL(2, ℤ) := modularHeightMaximizer z
  let U : Set ℍ := {w | 1 < (g • w).im}
  have hUOpen : IsOpen U := by
    exact isOpen_lt continuous_const
      (UpperHalfPlane.continuous_im.comp (continuous_const_smul g))
  have hzU : z ∈ U := by
    simpa only [U, g, modularMaxHeight] using hz
  filter_upwards [hUOpen.mem_nhds hzU] with w hw
  apply le_antisymm
  · calc
      modularMaxHeight w =
          (((modularHeightMaximizer w) * g⁻¹) • (g • w)).im := by
        simp only [modularMaxHeight, mul_smul, inv_smul_smul]
      _ ≤ gammaTwoModularHeightEnvelope (g • w) :=
        modular_im_smul_le_heightEnvelope
          (modularHeightMaximizer w * g⁻¹) (g • w)
      _ = (g • w).im := by
        unfold gammaTwoModularHeightEnvelope
        rw [max_eq_left]
        have hInv : 1 / (g • w).im < 1 := by
          simpa only [one_div_one] using
            (one_div_lt_one_div_of_lt (by norm_num : (0 : ℝ) < 1) hw)
        exact (hInv.trans hw).le
  · exact modularHeightMaximizer_spec w g

/-- Hence the intrinsic log-height is locally the ordinary smooth log-height
in one fixed integral modular chart throughout the whole positive region. -/
theorem modularLogMaxHeight_eventuallyEq_chart_of_pos
    {z : ℍ} (hz : 0 < modularLogMaxHeight z) :
    modularLogMaxHeight =ᶠ[nhds z]
      (fun w ↦ Real.log (((modularHeightMaximizer z) • w).im)) := by
  have hHeight : 1 < modularMaxHeight z := by
    rwa [modularLogMaxHeight,
      Real.log_pos_iff (modularMaxHeight_pos z).le] at hz
  exact (modularMaxHeight_eventuallyEq_maximizer_im_of_one_lt hHeight).fun_comp
    Real.log

end FixedPhaseGoodCuspCutoffBridge

