/-!
### P3.7 audit: the exact maximal-adjoint graph approximation theorem

The cutoff exhaustion constructed above acts on vectors which are *already*
in the smooth quotient-compact core.  Its eventual-equality theorem therefore
cannot by itself approximate an arbitrary vector in a maximal-adjoint domain.
The missing analytic input is a Friedrichs/Gaffney approximation theorem:
every maximal weak graph vector must be approximable, simultaneously in its
base and differential coordinates, by vectors in the actual smooth physical
domain.

This block records that requirement without weakening it.  First it proves a
general sequential characterization of an essential graph core in Hilbert
spaces.  It then specializes the characterization to the two concrete
fixed-phase operators.  Thus the remaining theorem is exposed as an explicit
sequence of genuine physical-core graph vectors, rather than being inferred
from closability, ordinary `L²` density, or the cutoff identity on an already
compactly supported vector.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseEssentialCoreAudit

open Set Function Topology Filter
open scoped LinearPMap
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseClosedOperators

/-- Sequential graph-core approximation for a concrete extension `A` of
`S`.  Every point of the full graph of `A` is required to be a limit of a
sequence lying in the graph of `S`; both operator coordinates therefore
converge simultaneously. -/
def HasSequentialGraphCore
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (S A : E →ₗ.[ℂ] F) : Prop :=
  ∀ p : E × F, p ∈ A.graph →
    ∃ q : ℕ → E × F,
      (∀ j : ℕ, q j ∈ S.graph) ∧
        Filter.Tendsto q Filter.atTop (nhds p)

/-- In Hilbert spaces the sequential formulation is exactly equality of the
closed small graph with the graph of a closed extension.  The extension and
closedness hypotheses are essential: they supply the inclusion from the
closure of the small graph into the large graph. -/
theorem isEssentialGraphCoreFor_iff_hasSequentialGraphCore
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    {S A : E →ₗ.[ℂ] F} (hSA : S ≤ A) (hA : A.IsClosed) :
    IsEssentialGraphCoreFor S A ↔ HasSequentialGraphCore S A := by
  constructor
  · intro hEssential p hp
    apply mem_closure_iff_seq_limit.mp
    rw [← Submodule.topologicalClosure_coe]
    rw [hEssential]
    exact hp
  · intro hSequential
    unfold IsEssentialGraphCoreFor
    apply le_antisymm
    · exact S.graph.topologicalClosure_minimal
        (LinearPMap.le_graph_of_le hSA) hA
    · intro p hp
      obtain ⟨q, hqGraph, hqLimit⟩ := hSequential p hp
      change p ∈ closure (S.graph : Set (E × F))
      exact isClosed_closure.mem_of_tendsto hqLimit
        (Filter.Eventually.of_forall fun j ↦
          subset_closure (hqGraph j))

/-- The precise missing approximation theorem for raising at index `n`.
The approximating sequence lies in the actual domain of `physicalRaise n`,
which is definitionally the image of the full smooth quotient-compact
fixed-phase core. -/
def RaisingMaximalAdjointSequentialApproximationAt (n : ℤ) : Prop :=
  HasSequentialGraphCore (physicalRaise n)
    ((-physicalLowerFromSucc n)†)

/-- The corresponding maximal weak-graph approximation theorem for lowering
from the successor index. -/
def LoweringMaximalAdjointSequentialApproximationAt (n : ℤ) : Prop :=
  HasSequentialGraphCore (physicalLowerFromSucc n)
    ((-physicalRaise n)†)

/-- Once the concrete Green identity supplies the extension inclusion,
raising is an essential core for the opposite maximal adjoint exactly when
the genuine two-coordinate sequential approximation theorem holds. -/
theorem raisingEssentialAdjointCoreAt_iff_sequentialApproximation
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    RaisingEssentialAdjointCoreAt n ↔
      RaisingMaximalAdjointSequentialApproximationAt n := by
  exact isEssentialGraphCoreFor_iff_hasSequentialGraphCore
    (raise_le_negativeLower_adjoint hGreen)
    (LinearPMap.adjoint_isClosed
      (negativePhysicalLowerFromSucc_dense_domain n))

/-- The independent lowering essential-core statement has the identical
sequential characterization. -/
theorem loweringEssentialAdjointCoreAt_iff_sequentialApproximation
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    LoweringEssentialAdjointCoreAt n ↔
      LoweringMaximalAdjointSequentialApproximationAt n := by
  exact isEssentialGraphCoreFor_iff_hasSequentialGraphCore
    (lower_le_negativeRaise_adjoint hGreen)
    (LinearPMap.adjoint_isClosed
      (negativePhysicalRaise_dense_domain n))

/-- Strong cross-adjointness is therefore equivalent to two concrete
Friedrichs/Gaffney graph-approximation theorems.  Neither conjunct follows
from the previously proved closability or base-`L²` density statements. -/
theorem strongCrossAdjointAt_iff_sequentialApproximations
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    StrongCrossAdjointAt n ↔
      RaisingMaximalAdjointSequentialApproximationAt n ∧
        LoweringMaximalAdjointSequentialApproximationAt n := by
  rw [strongCrossAdjointAt_iff_essentialCores n]
  exact and_congr
    (raisingEssentialAdjointCoreAt_iff_sequentialApproximation hGreen)
    (loweringEssentialAdjointCoreAt_iff_sequentialApproximation hGreen)

end FixedPhaseEssentialCoreAudit

namespace AxiomAuditP3EssentialCore

#print axioms FixedPhaseEssentialCoreAudit.isEssentialGraphCoreFor_iff_hasSequentialGraphCore
#print axioms FixedPhaseEssentialCoreAudit.raisingEssentialAdjointCoreAt_iff_sequentialApproximation
#print axioms FixedPhaseEssentialCoreAudit.loweringEssentialAdjointCoreAt_iff_sequentialApproximation
#print axioms FixedPhaseEssentialCoreAudit.strongCrossAdjointAt_iff_sequentialApproximations

end AxiomAuditP3EssentialCore
end Mock2FA.PaperCorrections.AutomorphicSobolev



/-!
================================================================================
P3.4: native actual-edge tangents and finite paired-boundary cancellation

The preceding boundary API transported an arbitrary tangent through a side
pairing.  For Stokes' theorem one must additionally prove that this transported
tangent is the derivative of the *native parametrization of the paired edge*.
This block supplies that missing compatibility.  The circular edge is treated
with its genuine square-root derivative, the vertical edges with their affine
derivative, and selected-coset images with Mathlib's actual Mobius Frechet
derivative `UpperHalfPlane.smulFDeriv`.

All vertical rays are truncated at one common finite parameter `T`.  Thus every
integral below is over a compact interval; the circular reparametrization is
`t |-> -t`, while both vertical reparametrizations are the identity.  Combining
the parameter sign with the already-declared edge-orientation sign gives exact
pairwise cancellation and hence a zero finite sum over all actual edges.
================================================================================
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace GammaTwoNativeEdgeCancellation

open MeasureTheory Set
open GammaTwoQuotientGeometry GammaTwoQuotientGreenBoundary
open GammaTwoMoebiusPiola GammaTwoOrientedBoundaryIntegral
open GammaTwoCurvilinearTileStokes
open HalfWeightDifferentialOperators

/-! #### Ambient base-edge curves and their genuine derivatives -/

/-- Ambient complex formula for each of the three base-edge curves.  It is
defined on all real parameters so that ordinary `HasDerivAt` can be used; only
its restriction to `modularTileEdgeParameterSet` represents the boundary. -/
noncomputable def modularTileEdgeAmbientParam :
    GammaTwoModularTileEdge → Real → Complex
  | .circularArc, t =>
      (((t / 2 : Real) : Complex) +
        ((Real.sqrt (1 - (t / 2) ^ 2) : Real) : Complex) * Complex.I)
  | .leftVerticalSegment, t =>
      (((-(1 / 2 : Real)) : Complex) +
        ((Real.sqrt 3 / 2 + t : Real) : Complex) * Complex.I)
  | .rightVerticalSegment, t =>
      ((((1 / 2 : Real)) : Complex) +
        ((Real.sqrt 3 / 2 + t : Real) : Complex) * Complex.I)

/-- Native derivative of the ambient base-edge formula. -/
noncomputable def modularTileEdgeAmbientVelocity :
    GammaTwoModularTileEdge → Real → Complex
  | .circularArc, t =>
      ((((1 / 2 : Real)) : Complex) +
        ((-t / (4 * Real.sqrt (1 - (t / 2) ^ 2)) : Real) : Complex) *
          Complex.I)
  | .leftVerticalSegment, _t => Complex.I
  | .rightVerticalSegment, _t => Complex.I

set_option backward.isDefEq.respectTransparency false in
/-- On the declared circular interval the square-root curve has exactly the
velocity used by the boundary-flux API. -/
theorem modularCircularArcAmbient_hasDerivAt
    (t : Set.Icc (-1 : Real) 1) :
    HasDerivAt
      (modularTileEdgeAmbientParam .circularArc)
      (modularTileEdgeAmbientVelocity .circularArc t) (t : Real) := by
  have hxR : HasDerivAt (fun s : Real => s / 2) (1 / 2 : Real) t :=
    (hasDerivAt_id (t : Real)).div_const 2
  have hg0 := (hasDerivAt_const (t : Real) (1 : Real)).sub
      (((hasDerivAt_id (t : Real)).div_const 2).pow 2)
  have hg : HasDerivAt
      (fun s : Real => 1 - (s / 2) ^ 2)
      (0 - (2 : Real) * ((t : Real) / 2) ^ (2 - 1) * (1 / 2))
      (t : Real) :=
    hg0.congr_of_eventuallyEq
      (Filter.Eventually.of_forall (fun s => by
        change 1 - (s / 2) ^ 2 = 1 - (s / 2) ^ 2
        rfl))
  have hrad : 0 < 1 - ((t : Real) / 2) ^ 2 :=
    Real.sqrt_pos.1 (modularCircularArc_sqrt_pos t)
  have hsqrt0 : Real.sqrt (1 - ((t : Real) / 2) ^ 2) ≠ 0 :=
    ne_of_gt (modularCircularArc_sqrt_pos t)
  have hyR0 := hg.sqrt (ne_of_gt hrad)
  have hyR : HasDerivAt
      (fun s : Real => Real.sqrt (1 - (s / 2) ^ 2))
      (-((t : Real)) /
        (4 * Real.sqrt (1 - ((t : Real) / 2) ^ 2))) (t : Real) := by
    convert hyR0 using 1
    field_simp [hsqrt0]
    ring
  have hxC := hxR.ofReal_comp
  have hyC := hyR.ofReal_comp
  unfold modularTileEdgeAmbientParam modularTileEdgeAmbientVelocity
  exact hxC.add (hyC.mul_const Complex.I)

set_option backward.isDefEq.respectTransparency false in
/-- The left vertical base edge has constant native velocity `I`. -/
theorem modularLeftVerticalAmbient_hasDerivAt (t : Set.Ici (0 : Real)) :
    HasDerivAt
      (modularTileEdgeAmbientParam .leftVerticalSegment)
      (modularTileEdgeAmbientVelocity .leftVerticalSegment t) (t : Real) := by
  rw [hasDerivAt_iff_tendsto_slope_zero]
  refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
  filter_upwards [self_mem_nhdsWithin] with s hs
  simp only [Set.mem_compl_iff, Set.mem_singleton_iff] at hs
  dsimp [modularTileEdgeAmbientParam, modularTileEdgeAmbientVelocity]
  push_cast
  field_simp [hs]
  ring

set_option backward.isDefEq.respectTransparency false in
/-- The right vertical base edge has the same constant native velocity `I`. -/
theorem modularRightVerticalAmbient_hasDerivAt (t : Set.Ici (0 : Real)) :
    HasDerivAt
      (modularTileEdgeAmbientParam .rightVerticalSegment)
      (modularTileEdgeAmbientVelocity .rightVerticalSegment t) (t : Real) := by
  rw [hasDerivAt_iff_tendsto_slope_zero]
  refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
  filter_upwards [self_mem_nhdsWithin] with s hs
  simp only [Set.mem_compl_iff, Set.mem_singleton_iff] at hs
  dsimp [modularTileEdgeAmbientParam, modularTileEdgeAmbientVelocity]
  push_cast
  field_simp [hs]
  ring

/-- Uniform base-edge derivative theorem, including both finite circular
endpoints and the initial points of the two vertical rays. -/
theorem modularTileEdgeAmbientParam_hasDerivAt
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e) :
    HasDerivAt (modularTileEdgeAmbientParam e)
      (modularTileEdgeAmbientVelocity e t) (t : Real) := by
  cases e with
  | circularArc => exact modularCircularArcAmbient_hasDerivAt t
  | leftVerticalSegment => exact modularLeftVerticalAmbient_hasDerivAt t
  | rightVerticalSegment => exact modularRightVerticalAmbient_hasDerivAt t

/-- The ambient formula agrees pointwise with the existing subtype-valued base
edge parametrization. -/
theorem modularTileEdgeAmbientParam_eq_coe
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e) :
    modularTileEdgeAmbientParam e t = (modularTileEdgeParam e t : Complex) := by
  cases e with
  | circularArc =>
      apply Complex.ext <;>
        simp [modularTileEdgeAmbientParam, modularTileEdgeParam,
          modularCircularArcParam]
  | leftVerticalSegment =>
      apply Complex.ext <;>
        simp [modularTileEdgeAmbientParam, modularTileEdgeParam,
          modularLeftVerticalParam]
  | rightVerticalSegment =>
      apply Complex.ext <;>
        simp [modularTileEdgeAmbientParam, modularTileEdgeParam,
          modularRightVerticalParam]

/-- The ambient derivative agrees with the pre-existing native velocity used
in the explicit flux formulas. -/
theorem modularTileEdgeAmbientVelocity_eq
    (e : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet e) :
    modularTileEdgeAmbientVelocity e t = modularTileEdgeVelocity e t := by
  cases e with
  | circularArc =>
      unfold modularTileEdgeAmbientVelocity modularTileEdgeVelocity
        modularCircularArcVelocity
      apply Complex.ext <;>
        simp only [Complex.add_re, Complex.add_im, Complex.ofReal_re,
          Complex.ofReal_im, Complex.mul_re, Complex.mul_im,
          Complex.I_re, Complex.I_im, mul_zero, mul_one, zero_mul,
          sub_zero, add_zero, zero_add]
  | leftVerticalSegment => rfl
  | rightVerticalSegment => rfl

/-! #### Selected-coset actual edges -/

/-- Ambient formula for an actual edge obtained from a selected right-coset
representative. -/
noncomputable def actualEdgeAmbientParam
    (e : GammaTwoActualPolygonEdge) (t : Real) : Complex :=
  selectedCosetAmbientMap e.1 (modularTileEdgeAmbientParam e.2 t)

/-- Native actual-edge tangent: the genuine selected-coset Frechet derivative
applied to the native base-edge tangent. -/
noncomputable def actualEdgeNativeVelocity
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) : Complex :=
  UpperHalfPlane.smulFDeriv (selectedCosetGL e.1)
    (modularTileEdgeParam e.2 t : Complex)
    (modularTileEdgeVelocity e.2 t)

/-- Pointwise agreement of the ambient actual-edge formula with the existing
subtype-valued actual polygon-edge parametrization. -/
theorem actualEdgeAmbientParam_eq_coe
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    actualEdgeAmbientParam e t =
      (gammaTwoActualPolygonEdgeParam e t : Complex) := by
  rw [actualEdgeAmbientParam, modularTileEdgeAmbientParam_eq_coe]
  simpa [selectedCosetAction, gammaTwoActualPolygonEdgeParam] using
    selectedCosetAmbientMap_coe e.1 (modularTileEdgeParam e.2 t)

/-- Coordinate form of the native actual tangent.  This records explicitly
that no informal complex derivative is substituted for Mathlib's bundled real
Frechet derivative. -/
theorem actualEdgeNativeVelocity_eq_selectedDerivative_mul
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    actualEdgeNativeVelocity e t =
      selectedCosetDerivative e.1 (modularTileEdgeParam e.2 t) *
        modularTileEdgeVelocity e.2 t := by
  unfold actualEdgeNativeVelocity
  exact selectedCoset_smulFDeriv_apply e.1
    (modularTileEdgeParam e.2 t) (modularTileEdgeVelocity e.2 t)

/-- The Mobius-composed actual edge has the declared native tangent. -/
theorem actualEdgeAmbientParam_hasDerivAt
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    HasDerivAt (actualEdgeAmbientParam e)
      (actualEdgeNativeVelocity e t) (t : Real) := by
  have hbase := modularTileEdgeAmbientParam_hasDerivAt e.2 t
  have houter :=
    (selectedCosetAmbientMap_hasStrictFDerivAt e.1
      (modularTileEdgeParam e.2 t)).hasFDerivAt
  have hcomp := houter.comp_hasDerivAt_of_eq (t : Real) hbase
    (modularTileEdgeAmbientParam_eq_coe e.2 t).symm
  simpa [actualEdgeAmbientParam, actualEdgeNativeVelocity,
    Function.comp_def, modularTileEdgeAmbientVelocity_eq] using hcomp

/-! #### Native tangent compatibility under the actual side pairing -/

/-- The subtype pairing is multiplication of the real parameter by the
declared sign. -/
@[simp]
theorem pairedParameter_coe_eq_parameterSign_mul
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    (e.pairedParameter t : Real) =
      (e.2.parameterSign : Real) * (t : Real) := by
  rcases e with ⟨q, edge⟩
  cases edge <;>
    simp [GammaTwoActualPolygonEdge.pairedParameter,
      GammaTwoModularTileEdge.pairedParameter,
      GammaTwoModularTileEdge.parameterSign]

/-- Each real parameter set has unique one-dimensional derivatives, including
at its finite endpoints. -/
theorem uniqueDiffOn_modularTileEdgeParameterSet
    (e : GammaTwoModularTileEdge) :
    UniqueDiffOn Real (modularTileEdgeParameterSet e) := by
  cases e with
  | circularArc =>
      simpa [modularTileEdgeParameterSet] using
        (uniqueDiffOn_Icc (by norm_num : (-1 : Real) < 1))
  | leftVerticalSegment =>
      simpa [modularTileEdgeParameterSet] using uniqueDiffOn_Ici (0 : Real)
  | rightVerticalSegment =>
      simpa [modularTileEdgeParameterSet] using uniqueDiffOn_Ici (0 : Real)

/-- Ambient form of the exact actual-edge pairing identity. -/
theorem gammaTwoMoebiusChart_actualEdgeAmbientParam_eq
    (e : GammaTwoActualPolygonEdge) {t : Real}
    (ht : t ∈ modularTileEdgeParameterSet e.2) :
    gammaTwoMoebiusChart e.pairingElement (actualEdgeAmbientParam e t) =
      actualEdgeAmbientParam e.paired
        ((e.2.parameterSign : Real) * t) := by
  let tau : modularTileEdgeParameterSet e.2 := ⟨t, ht⟩
  have hpair := gammaTwoActualPolygonEdgePairing_param e tau
  have hpairCoe := congrArg (fun z : UpperHalfPlane => (z : Complex)) hpair
  calc
    gammaTwoMoebiusChart e.pairingElement (actualEdgeAmbientParam e t) =
        gammaTwoMoebiusChart e.pairingElement
          (gammaTwoActualPolygonEdgeParam e tau : Complex) := by
            rw [actualEdgeAmbientParam_eq_coe e tau]
    _ = (((e.pairingElement : SL(2, Int))
          • gammaTwoActualPolygonEdgeParam e tau : UpperHalfPlane) : Complex) := by
            simp [gammaTwoMoebiusChart, gammaTwoMoebiusCoordinate]
    _ = (gammaTwoActualPolygonEdgeParam e.paired
          (e.pairedParameter tau) : Complex) := hpairCoe
    _ = actualEdgeAmbientParam e.paired
          ((e.2.parameterSign : Real) * t) := by
            simpa [pairedParameter_coe_eq_parameterSign_mul e tau] using
              (actualEdgeAmbientParam_eq_coe e.paired
                (e.pairedParameter tau)).symm

/-- The `d1` derivative used by flux invariance is the same derivative as the
fixed-phase Mobius chart derivative. -/
theorem d1_gammaTwoActionCoordinate_eq
    (gamma : GammaTwo) (z : UpperHalfPlane) (xi : Complex) :
    d1 (gammaTwoActionCoordinate gamma) z xi =
      xi / inverseEtaPaperOrbitDenom gamma z ^ 2 := by
  change d1 (gammaTwoMoebiusCoordinate gamma) z xi =
    xi / inverseEtaPaperOrbitDenom gamma z ^ 2
  exact d1_gammaTwoMoebiusCoordinate gamma z xi

/-- Derivative of the paired Mobius image of a native actual-edge curve,
expressed in the exact `d1` notation used by invariant fluxes. -/
theorem gammaTwoChart_actualEdgeAmbientParam_hasDerivAt
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    HasDerivAt
      (fun s : Real =>
        gammaTwoMoebiusChart e.pairingElement
          (actualEdgeAmbientParam e s))
      (d1 (gammaTwoActionCoordinate e.pairingElement)
        (gammaTwoActualPolygonEdgeParam e t)
        (actualEdgeNativeVelocity e t)) (t : Real) := by
  have hinner := actualEdgeAmbientParam_hasDerivAt e t
  have houter :=
    (gammaTwoMoebiusChart_hasStrictDerivAt e.pairingElement
      (gammaTwoActualPolygonEdgeParam e t)).hasDerivAt.complexToReal_fderiv
  have hcomp := houter.comp_hasDerivAt_of_eq (t : Real) hinner
    (actualEdgeAmbientParam_eq_coe e t).symm
  simpa [Function.comp_def, d1_gammaTwoActionCoordinate_eq,
    smul_eq_mul, div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hcomp

/-- Exact native tangent compatibility.  The parameter sign is indispensable:
on the circular side the paired native tangent is the negative of the
transported source tangent, whereas it is equal on the two vertical sides. -/
theorem parameterSign_mul_nativePairedTangent_eq_transport
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    (e.2.parameterSign : Complex) *
        actualEdgeNativeVelocity e.paired (e.pairedParameter t) =
      d1 (gammaTwoActionCoordinate e.pairingElement)
        (gammaTwoActualPolygonEdgeParam e t)
        (actualEdgeNativeVelocity e t) := by
  let sigma : Real := (e.2.parameterSign : Real)
  have hleft := gammaTwoChart_actualEdgeAmbientParam_hasDerivAt e t
  have htarget := actualEdgeAmbientParam_hasDerivAt e.paired
    (e.pairedParameter t)
  have htarget' : HasDerivAt (actualEdgeAmbientParam e.paired)
      (actualEdgeNativeVelocity e.paired (e.pairedParameter t))
      (sigma * (t : Real)) := by
    simpa [sigma, pairedParameter_coe_eq_parameterSign_mul e t] using htarget
  have hscale : HasDerivAt (fun s : Real => sigma * s) sigma (t : Real) := by
    simpa using (hasDerivAt_id (t : Real)).const_mul sigma
  have hright := htarget'.scomp (t : Real) hscale
  have heq : ∀ s ∈ modularTileEdgeParameterSet e.2,
      (fun r : Real =>
        gammaTwoMoebiusChart e.pairingElement
          (actualEdgeAmbientParam e r)) s =
      (fun r : Real => actualEdgeAmbientParam e.paired (sigma * r)) s := by
    intro s hs
    simpa [sigma] using gammaTwoMoebiusChart_actualEdgeAmbientParam_eq e hs
  have hleftAsRight : HasDerivWithinAt
      (fun r : Real => actualEdgeAmbientParam e.paired (sigma * r))
      (d1 (gammaTwoActionCoordinate e.pairingElement)
        (gammaTwoActualPolygonEdgeParam e t)
        (actualEdgeNativeVelocity e t))
      (modularTileEdgeParameterSet e.2) (t : Real) :=
    hleft.hasDerivWithinAt.congr_of_mem
      (fun s hs => (heq s hs).symm) t.property
  have hderivEq :=
    (uniqueDiffOn_modularTileEdgeParameterSet e.2 t t.property).eq
      hleftAsRight.hasFDerivWithinAt hright.hasDerivWithinAt.hasFDerivWithinAt
  have happly := congrArg
    (fun L : Real →L[Real] Complex => L 1) hderivEq
  simpa [sigma, Complex.real_smul] using happly.symm

/-! #### Pointwise native flux pairing -/

/-- The flux one-form is linear under multiplication of a tangent by a real
scalar. -/
theorem fluxOneFormValue_real_mul
    (X Y : UpperHalfPlane → Complex) (z : UpperHalfPlane)
    (r : Real) (xi : Complex) :
    fluxOneFormValue X Y z ((r : Complex) * xi) =
      (r : Complex) * fluxOneFormValue X Y z xi := by
  simp [fluxOneFormValue, Complex.mul_re, Complex.mul_im]
  ring

/-- Specialization of real linearity to the three integral parameter signs.
This form avoids hiding the integer-to-real-to-complex coercion used by the
geometric edge data. -/
theorem fluxOneFormValue_parameterSign_mul
    (X Y : UpperHalfPlane → Complex) (z : UpperHalfPlane)
    (e : GammaTwoModularTileEdge) (xi : Complex) :
    fluxOneFormValue X Y z ((e.parameterSign : Complex) * xi) =
      (e.parameterSign : Complex) * fluxOneFormValue X Y z xi := by
  cases e <;>
    simp [GammaTwoModularTileEdge.parameterSign, fluxOneFormValue_neg]

/-- The square of every parameter sign is one. -/
theorem parameterSign_mul_self_complex (e : GammaTwoModularTileEdge) :
    (e.parameterSign : Complex) * (e.parameterSign : Complex) = 1 := by
  cases e <;> norm_num [GammaTwoModularTileEdge.parameterSign]

/-- Flux on the native paired edge equals the parameter sign times flux on the
native source edge. -/
theorem invariantFlux_nativePaired_parameterSign
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
        (actualEdgeNativeVelocity e.paired (e.pairedParameter t)) =
      (e.2.parameterSign : Complex) *
        fluxOneFormValue X Y (gammaTwoActualPolygonEdgeParam e t)
          (actualEdgeNativeVelocity e t) := by
  have hinv := invariantFlux_actualPolygonEdge_pairing hInv e t
    (actualEdgeNativeVelocity e t)
  rw [← parameterSign_mul_nativePairedTangent_eq_transport e t] at hinv
  rw [fluxOneFormValue_parameterSign_mul] at hinv
  have hsquare := parameterSign_mul_self_complex e.2
  calc
    fluxOneFormValue X Y
        (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
        (actualEdgeNativeVelocity e.paired (e.pairedParameter t)) =
        1 * fluxOneFormValue X Y
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
          (actualEdgeNativeVelocity e.paired (e.pairedParameter t)) := by ring
    _ = ((e.2.parameterSign : Complex) * (e.2.parameterSign : Complex)) *
        fluxOneFormValue X Y
          (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
          (actualEdgeNativeVelocity e.paired (e.pairedParameter t)) := by
          rw [hsquare]
    _ = (e.2.parameterSign : Complex) *
        ((e.2.parameterSign : Complex) *
          fluxOneFormValue X Y
            (gammaTwoActualPolygonEdgeParam e.paired (e.pairedParameter t))
            (actualEdgeNativeVelocity e.paired (e.pairedParameter t))) := by ring
    _ = (e.2.parameterSign : Complex) *
        fluxOneFormValue X Y (gammaTwoActualPolygonEdgeParam e t)
          (actualEdgeNativeVelocity e t) := by rw [hinv]

/-! #### Total integrands and finite truncation -/

/-- Totalized native tangent; outside the edge parameter set its value is
irrelevant and is set to zero. -/
noncomputable def actualEdgeNativeVelocityTotal
    (e : GammaTwoActualPolygonEdge) (t : Real) : Complex := by
  classical
  exact if ht : t ∈ modularTileEdgeParameterSet e.2 then
    actualEdgeNativeVelocity e ⟨t, ht⟩
  else 0

/-- Native actual-edge flux integrand used by the finite tile boundary
integral. -/
noncomputable def nativeActualEdgeFluxIntegrand
    (X Y : UpperHalfPlane → Complex)
    (e : GammaTwoActualPolygonEdge) (t : Real) : Complex :=
  fluxOneFormValue X Y (actualEdgePoint e t)
    (actualEdgeNativeVelocityTotal e t)

/-- Totalized integrands satisfy the same exact native pairing law at every
admissible source parameter. -/
theorem nativeActualEdgeFluxIntegrand_pairedParameter
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    nativeActualEdgeFluxIntegrand X Y e.paired (e.pairedParameter t) =
      (e.2.parameterSign : Complex) *
        nativeActualEdgeFluxIntegrand X Y e t := by
  classical
  simp only [nativeActualEdgeFluxIntegrand, actualEdgePoint,
    actualEdgeNativeVelocityTotal, dif_pos t.property,
    dif_pos (e.pairedParameter t).property]
  exact invariantFlux_nativePaired_parameterSign hInv e t

/-- Real-parameter version of the preceding identity. -/
theorem nativeActualEdgeFluxIntegrand_paired_mul
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge)
    (t : modularTileEdgeParameterSet e.2) :
    nativeActualEdgeFluxIntegrand X Y e.paired
        ((e.2.parameterSign : Real) * (t : Real)) =
      (e.2.parameterSign : Complex) *
        nativeActualEdgeFluxIntegrand X Y e t := by
  simpa [pairedParameter_coe_eq_parameterSign_mul e t] using
    nativeActualEdgeFluxIntegrand_pairedParameter hInv e t

/-- Lower endpoint of a finite native edge integral. -/
def nativeEdgeParameterLower : GammaTwoModularTileEdge → Real
  | .circularArc => -1
  | .leftVerticalSegment => 0
  | .rightVerticalSegment => 0

/-- Upper endpoint of a finite native edge integral.  `T` is the common
vertical truncation parameter; the circular edge retains its fixed endpoint
`1`. -/
def nativeEdgeParameterUpper (T : Real) : GammaTwoModularTileEdge → Real
  | .circularArc => 1
  | .leftVerticalSegment => T
  | .rightVerticalSegment => T

@[simp]
theorem nativeEdgeParameterLower_paired (e : GammaTwoActualPolygonEdge) :
    nativeEdgeParameterLower e.paired.2 = nativeEdgeParameterLower e.2 := by
  rcases e with ⟨q, edge⟩
  cases edge <;> rfl

@[simp]
theorem nativeEdgeParameterUpper_paired
    (T : Real) (e : GammaTwoActualPolygonEdge) :
    nativeEdgeParameterUpper T e.paired.2 =
      nativeEdgeParameterUpper T e.2 := by
  rcases e with ⟨q, edge⟩
  cases edge <;> rfl

/-- Every parameter in a finite native integration interval is admissible. -/
theorem nativeEdge_uIcc_subset_parameterSet
    {T : Real} (hT : 0 ≤ T) (e : GammaTwoModularTileEdge) :
    Set.uIcc (nativeEdgeParameterLower e) (nativeEdgeParameterUpper T e) ⊆
      modularTileEdgeParameterSet e := by
  cases e with
  | circularArc =>
      simpa [nativeEdgeParameterLower, nativeEdgeParameterUpper,
        modularTileEdgeParameterSet,
        uIcc_of_le (by norm_num : (-1 : Real) ≤ 1)]
  | leftVerticalSegment =>
      intro t ht
      have ht' : t ∈ Set.Icc (0 : Real) T := by
        simpa [nativeEdgeParameterLower, nativeEdgeParameterUpper,
          uIcc_of_le hT] using ht
      simpa [modularTileEdgeParameterSet] using ht'.1
  | rightVerticalSegment =>
      intro t ht
      have ht' : t ∈ Set.Icc (0 : Real) T := by
        simpa [nativeEdgeParameterLower, nativeEdgeParameterUpper,
          uIcc_of_le hT] using ht
      simpa [modularTileEdgeParameterSet] using ht'.1

/-- Unoriented finite native flux integral on one actual edge. -/
noncomputable def nativeActualEdgeFluxIntegral
    (T : Real) (X Y : UpperHalfPlane → Complex)
    (e : GammaTwoActualPolygonEdge) : Complex :=
  ∫ t in nativeEdgeParameterLower e.2..nativeEdgeParameterUpper T e.2,
    nativeActualEdgeFluxIntegrand X Y e t

/-- Circular native integrals acquire the sign `-1` under pairing, including
the nontrivial change of variables `t |-> -t`. -/
theorem nativeActualEdgeFluxIntegral_paired_circular
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    (T : Real) (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        ((q, GammaTwoModularTileEdge.circularArc) : GammaTwoActualPolygonEdge).paired =
      (-1 : Complex) *
        nativeActualEdgeFluxIntegral T X Y
          (q, GammaTwoModularTileEdge.circularArc) := by
  change
    (∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
        ((q, GammaTwoModularTileEdge.circularArc) : GammaTwoActualPolygonEdge).paired t) =
      (-1 : Complex) *
        (∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
          (q, GammaTwoModularTileEdge.circularArc) t)
  calc
    (∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
        ((q, GammaTwoModularTileEdge.circularArc) : GammaTwoActualPolygonEdge).paired t) =
        ∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
          ((q, GammaTwoModularTileEdge.circularArc) : GammaTwoActualPolygonEdge).paired (-t) := by
      symm
      simpa using
        (intervalIntegral.integral_comp_neg
          (f := fun t : Real => nativeActualEdgeFluxIntegrand X Y
            ((q, GammaTwoModularTileEdge.circularArc) : GammaTwoActualPolygonEdge).paired t)
          (a := (-1 : Real)) (b := (1 : Real)))
    _ = ∫ t in (-1 : Real)..1,
        -nativeActualEdgeFluxIntegrand X Y
          (q, GammaTwoModularTileEdge.circularArc) t := by
      apply intervalIntegral.integral_congr
      intro t ht
      have ht' : t ∈ Set.Icc (-1 : Real) 1 := by
        simpa [uIcc_of_le (by norm_num : (-1 : Real) ≤ 1)] using ht
      have hpair := nativeActualEdgeFluxIntegrand_paired_mul hInv
        ((q, GammaTwoModularTileEdge.circularArc) :
          GammaTwoActualPolygonEdge) ⟨t, ht'⟩
      simpa [GammaTwoModularTileEdge.parameterSign] using hpair
    _ = -(∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.circularArc) t) := by
      rw [intervalIntegral.integral_neg]
    _ = (-1 : Complex) *
        (∫ t in (-1 : Real)..1, nativeActualEdgeFluxIntegrand X Y
          (q, GammaTwoModularTileEdge.circularArc) t) := by ring

/-- Left-to-right vertical pairing preserves the unoriented native integral. -/
theorem nativeActualEdgeFluxIntegral_paired_left
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    {T : Real} (hT : 0 ≤ T) (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        ((q, GammaTwoModularTileEdge.leftVerticalSegment) : GammaTwoActualPolygonEdge).paired =
      nativeActualEdgeFluxIntegral T X Y
        (q, GammaTwoModularTileEdge.leftVerticalSegment) := by
  change
    (∫ t in (0 : Real)..T, nativeActualEdgeFluxIntegrand X Y
      ((q, GammaTwoModularTileEdge.leftVerticalSegment) : GammaTwoActualPolygonEdge).paired t) =
    ∫ t in (0 : Real)..T, nativeActualEdgeFluxIntegrand X Y
      (q, GammaTwoModularTileEdge.leftVerticalSegment) t
  apply intervalIntegral.integral_congr
  intro t ht
  have htIcc : t ∈ Set.Icc (0 : Real) T := by
    simpa [uIcc_of_le hT] using ht
  have ht' : t ∈ modularTileEdgeParameterSet
      GammaTwoModularTileEdge.leftVerticalSegment := by
    simpa [modularTileEdgeParameterSet] using htIcc.1
  have hpair := nativeActualEdgeFluxIntegrand_paired_mul hInv
    ((q, GammaTwoModularTileEdge.leftVerticalSegment) :
      GammaTwoActualPolygonEdge) ⟨t, ht'⟩
  simpa [GammaTwoModularTileEdge.parameterSign] using hpair

/-- Right-to-left vertical pairing preserves the unoriented native integral. -/
theorem nativeActualEdgeFluxIntegral_paired_right
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    {T : Real} (hT : 0 ≤ T) (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        ((q, GammaTwoModularTileEdge.rightVerticalSegment) : GammaTwoActualPolygonEdge).paired =
      nativeActualEdgeFluxIntegral T X Y
        (q, GammaTwoModularTileEdge.rightVerticalSegment) := by
  change
    (∫ t in (0 : Real)..T, nativeActualEdgeFluxIntegrand X Y
      ((q, GammaTwoModularTileEdge.rightVerticalSegment) : GammaTwoActualPolygonEdge).paired t) =
    ∫ t in (0 : Real)..T, nativeActualEdgeFluxIntegrand X Y
      (q, GammaTwoModularTileEdge.rightVerticalSegment) t
  apply intervalIntegral.integral_congr
  intro t ht
  have htIcc : t ∈ Set.Icc (0 : Real) T := by
    simpa [uIcc_of_le hT] using ht
  have ht' : t ∈ modularTileEdgeParameterSet
      GammaTwoModularTileEdge.rightVerticalSegment := by
    simpa [modularTileEdgeParameterSet] using htIcc.1
  have hpair := nativeActualEdgeFluxIntegrand_paired_mul hInv
    ((q, GammaTwoModularTileEdge.rightVerticalSegment) :
      GammaTwoActualPolygonEdge) ⟨t, ht'⟩
  simpa [GammaTwoModularTileEdge.parameterSign] using hpair

/-- Uniform pairing law for every finite native edge integral. -/
theorem nativeActualEdgeFluxIntegral_paired
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    {T : Real} (hT : 0 ≤ T) (e : GammaTwoActualPolygonEdge) :
    nativeActualEdgeFluxIntegral T X Y e.paired =
      (e.2.parameterSign : Complex) *
        nativeActualEdgeFluxIntegral T X Y e := by
  rcases e with ⟨q, edge⟩
  cases edge with
  | circularArc =>
      simpa [GammaTwoModularTileEdge.parameterSign] using
        nativeActualEdgeFluxIntegral_paired_circular hInv T q
  | leftVerticalSegment =>
      simpa [GammaTwoModularTileEdge.parameterSign] using
        nativeActualEdgeFluxIntegral_paired_left hInv hT q
  | rightVerticalSegment =>
      simpa [GammaTwoModularTileEdge.parameterSign] using
        nativeActualEdgeFluxIntegral_paired_right hInv hT q

/-! #### Oriented contribution and finite cancellation -/

/-- Native oriented edge contribution with exactly the orientation convention
used by the actual finite tile complex. -/
noncomputable def nativeOrientedActualEdgeContribution
    (T : Real) (X Y : UpperHalfPlane → Complex)
    (e : GammaTwoActualPolygonEdge) : Complex :=
  (e.orientationSign : Complex) * nativeActualEdgeFluxIntegral T X Y e

/-- Every paired native contribution is the exact negative of its source
contribution.  The proof uses both the analytic parameter sign and the
geometric orientation sign. -/
theorem nativeOrientedActualEdgeContribution_paired_eq_neg
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    {T : Real} (hT : 0 ≤ T) (e : GammaTwoActualPolygonEdge) :
    nativeOrientedActualEdgeContribution T X Y e.paired =
      -nativeOrientedActualEdgeContribution T X Y e := by
  rw [nativeOrientedActualEdgeContribution,
    nativeOrientedActualEdgeContribution,
    nativeActualEdgeFluxIntegral_paired hInv hT]
  have horient :
      (e.paired.orientationSign : Complex) *
          (e.2.parameterSign : Complex) =
        -(e.orientationSign : Complex) := by
    exact_mod_cast e.pairing_reverses_orientation
  rw [← mul_assoc, horient]
  ring

/-- The complete finite native boundary sum cancels.  This invokes the genuine
actual-edge pairing equivalence, not an informal pairing of a polygon picture.
-/
theorem sum_nativeOrientedActualEdgeContribution_eq_zero
    {X Y : UpperHalfPlane → Complex} (hInv : IsGammaTwoInvariantFlux X Y)
    {T : Real} (hT : 0 ≤ T) :
    (Finset.univ.sum fun e : GammaTwoActualPolygonEdge =>
      nativeOrientedActualEdgeContribution T X Y e) = 0 := by
  exact sum_actualPolygonEdges_eq_zero_of_paired_neg
    (nativeOrientedActualEdgeContribution T X Y)
    (nativeOrientedActualEdgeContribution_paired_eq_neg hInv hT)

/-! #### Exact bridge to the curved-tile Stokes boundary expression -/

/-- The native actual-edge density is exactly the flux of the selected Piola
field on the corresponding base edge. -/
theorem nativeActualEdgeFluxIntegrand_eq_selectedPiolaFlux
    (X Y : UpperHalfPlane → Complex) (q : GammaTwoRightCoset)
    (edge : GammaTwoModularTileEdge)
    (t : modularTileEdgeParameterSet edge) :
    nativeActualEdgeFluxIntegrand X Y (q, edge) t =
      fluxOneFormValue (selectedCosetPiolaX q X Y)
        (selectedCosetPiolaY q X Y) (modularTileEdgeParam edge t)
        (modularTileEdgeVelocity edge t) := by
  simpa [nativeActualEdgeFluxIntegrand, actualEdgePoint,
    actualEdgeNativeVelocityTotal, actualEdgeNativeVelocity,
    gammaTwoActualPolygonEdgeParam, selectedCosetAction, t.property] using
      (selectedCosetPiola_fluxOneFormValue q X Y
        (modularTileEdgeParam edge t)
        (modularTileEdgeVelocity edge t)).symm

/-- The tangent normalized in the curved-tile theorem is the same circular
tangent already differentiated above. -/
theorem baseModularCircularTangent_eq_nativeVelocity
    (t : Set.Icc (-1 : Real) 1) :
    baseModularCircularTangent t =
      modularTileEdgeVelocity GammaTwoModularTileEdge.circularArc t := by
  apply Complex.ext <;>
    simp [baseModularCircularTangent, modularTileEdgeVelocity,
      modularCircularArcVelocity, modularLowerHeight]

/-- The circular native integral on one selected tile is exactly the circular
term in the normalized curved-tile boundary formula. -/
theorem nativeActualEdgeFluxIntegral_circular_eq_selectedPiola
    (T : Real) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        (q, GammaTwoModularTileEdge.circularArc) =
      ∫ t in (-1 : Real)..1,
        baseModularCircularFluxIntegrand
          (realProdLift (selectedCosetPiolaX q X Y))
          (realProdLift (selectedCosetPiolaY q X Y)) t := by
  change
    (∫ t in (-1 : Real)..1,
      nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.circularArc) t) = _
  apply intervalIntegral.integral_congr
  intro t ht
  have ht' : t ∈ Set.Icc (-1 : Real) 1 := by
    simpa [uIcc_of_le (by norm_num : (-1 : Real) ≤ 1)] using ht
  let tau : Set.Icc (-1 : Real) 1 := ⟨t, ht'⟩
  calc
    nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.circularArc) t =
        fluxOneFormValue (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) (modularCircularArcParam tau)
          (modularTileEdgeVelocity
            GammaTwoModularTileEdge.circularArc tau) := by
      simpa [tau, modularTileEdgeParam] using
        nativeActualEdgeFluxIntegrand_eq_selectedPiolaFlux X Y q
          GammaTwoModularTileEdge.circularArc tau
    _ = fluxOneFormValue (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) (modularCircularArcParam tau)
          (baseModularCircularTangent t) := by
      rw [baseModularCircularTangent_eq_nativeVelocity tau]
    _ = baseModularCircularFluxIntegrand
          (realProdLift (selectedCosetPiolaX q X Y))
          (realProdLift (selectedCosetPiolaY q X Y)) t := by
      simpa [tau] using
        (baseModularCircularFluxIntegrand_lift_eq_flux
          (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y) tau).symm

/-- The right native vertical integral is the right vertical term in the
curved-tile boundary expression. -/
theorem nativeActualEdgeFluxIntegral_right_eq_selectedPiola
    {T : Real} (hT : 0 ≤ T) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        (q, GammaTwoModularTileEdge.rightVerticalSegment) =
      ∫ s in (0 : Real)..T,
        realProdLift (selectedCosetPiolaX q X Y)
          (1 / 2, modularVertexHeight + s) := by
  change
    (∫ s in (0 : Real)..T,
      nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.rightVerticalSegment) s) = _
  apply intervalIntegral.integral_congr
  intro s hs
  have hsIcc : s ∈ Set.Icc (0 : Real) T := by
    simpa [uIcc_of_le hT] using hs
  have hs' : s ∈ modularTileEdgeParameterSet
      GammaTwoModularTileEdge.rightVerticalSegment := by
    simpa [modularTileEdgeParameterSet] using hsIcc.1
  let sigma : modularTileEdgeParameterSet
      GammaTwoModularTileEdge.rightVerticalSegment := ⟨s, hs'⟩
  calc
    nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.rightVerticalSegment) s =
        fluxOneFormValue (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) (modularRightVerticalParam sigma)
          Complex.I := by
      simpa [sigma, modularTileEdgeParam, modularTileEdgeVelocity] using
        nativeActualEdgeFluxIntegrand_eq_selectedPiolaFlux X Y q
          GammaTwoModularTileEdge.rightVerticalSegment sigma
    _ = realProdLift (selectedCosetPiolaX q X Y)
          (1 / 2, modularVertexHeight + s) := by
      simpa [sigma] using
        (realProdLift_rightVertical_eq_flux
          (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y) sigma).symm

/-- The left native vertical integral is the unsigned left vertical term in
the curved-tile boundary expression; its negative orientation is inserted in
`nativeOrientedActualEdgeContribution`. -/
theorem nativeActualEdgeFluxIntegral_left_eq_selectedPiola
    {T : Real} (hT : 0 ≤ T) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeActualEdgeFluxIntegral T X Y
        (q, GammaTwoModularTileEdge.leftVerticalSegment) =
      ∫ s in (0 : Real)..T,
        realProdLift (selectedCosetPiolaX q X Y)
          (-(1 / 2), modularVertexHeight + s) := by
  change
    (∫ s in (0 : Real)..T,
      nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.leftVerticalSegment) s) = _
  apply intervalIntegral.integral_congr
  intro s hs
  have hsIcc : s ∈ Set.Icc (0 : Real) T := by
    simpa [uIcc_of_le hT] using hs
  have hs' : s ∈ modularTileEdgeParameterSet
      GammaTwoModularTileEdge.leftVerticalSegment := by
    simpa [modularTileEdgeParameterSet] using hsIcc.1
  let sigma : modularTileEdgeParameterSet
      GammaTwoModularTileEdge.leftVerticalSegment := ⟨s, hs'⟩
  calc
    nativeActualEdgeFluxIntegrand X Y
        (q, GammaTwoModularTileEdge.leftVerticalSegment) s =
        fluxOneFormValue (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) (modularLeftVerticalParam sigma)
          Complex.I := by
      simpa [sigma, modularTileEdgeParam, modularTileEdgeVelocity] using
        nativeActualEdgeFluxIntegrand_eq_selectedPiolaFlux X Y q
          GammaTwoModularTileEdge.leftVerticalSegment sigma
    _ = realProdLift (selectedCosetPiolaX q X Y)
          (-(1 / 2), modularVertexHeight + s) := by
      simpa [sigma] using
        (realProdLift_leftVertical_eq_flux
          (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y) sigma).symm

/-- The modular finite vertex lies strictly below height one. -/
theorem modularVertexHeight_lt_one : modularVertexHeight < (1 : Real) := by
  have hsqrtSq : (Real.sqrt (3 : Real)) ^ 2 = 3 :=
    Real.sq_sqrt (by norm_num)
  have hsqrtNonneg : 0 ≤ Real.sqrt (3 : Real) := Real.sqrt_nonneg _
  unfold modularVertexHeight
  nlinarith

/-- A truncation height above one gives a nonnegative common vertical
parameter length. -/
theorem zero_le_height_sub_modularVertexHeight
    {H : Real} (hH : 1 < H) : 0 ≤ H - modularVertexHeight := by
  linarith [modularVertexHeight_lt_one]

/-- The three native contributions over one selected coset are the circular,
left, and right normalized Piola boundary terms. -/
theorem nativeOrientedActualEdgeContribution_circular
    (T : Real) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeOrientedActualEdgeContribution T X Y
        (q, GammaTwoModularTileEdge.circularArc) =
      ∫ t in (-1 : Real)..1,
        baseModularCircularFluxIntegrand
          (realProdLift (selectedCosetPiolaX q X Y))
          (realProdLift (selectedCosetPiolaY q X Y)) t := by
  simp only [nativeOrientedActualEdgeContribution,
    GammaTwoActualPolygonEdge.orientationSign,
    GammaTwoModularTileEdge.orientationSign, Int.cast_one, one_mul]
  exact nativeActualEdgeFluxIntegral_circular_eq_selectedPiola T X Y q

theorem nativeOrientedActualEdgeContribution_right
    {T : Real} (hT : 0 ≤ T) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeOrientedActualEdgeContribution T X Y
        (q, GammaTwoModularTileEdge.rightVerticalSegment) =
      ∫ s in (0 : Real)..T,
        realProdLift (selectedCosetPiolaX q X Y)
          (1 / 2, modularVertexHeight + s) := by
  simp only [nativeOrientedActualEdgeContribution,
    GammaTwoActualPolygonEdge.orientationSign,
    GammaTwoModularTileEdge.orientationSign, Int.cast_one, one_mul]
  exact nativeActualEdgeFluxIntegral_right_eq_selectedPiola hT X Y q

theorem nativeOrientedActualEdgeContribution_left
    {T : Real} (hT : 0 ≤ T) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    nativeOrientedActualEdgeContribution T X Y
        (q, GammaTwoModularTileEdge.leftVerticalSegment) =
      -(∫ s in (0 : Real)..T,
        realProdLift (selectedCosetPiolaX q X Y)
          (-(1 / 2), modularVertexHeight + s)) := by
  simp only [nativeOrientedActualEdgeContribution,
    GammaTwoActualPolygonEdge.orientationSign,
    GammaTwoModularTileEdge.orientationSign, Int.cast_neg,
    Int.cast_one, neg_mul]
  rw [nativeActualEdgeFluxIntegral_left_eq_selectedPiola hT]
  simp

/-- Explicit enumeration of the three base-edge labels. -/
theorem sum_modularTileEdges_eq_three
    (B : GammaTwoModularTileEdge → Complex) :
    (∑ edge : GammaTwoModularTileEdge, B edge) =
      B GammaTwoModularTileEdge.circularArc +
        B GammaTwoModularTileEdge.leftVerticalSegment +
          B GammaTwoModularTileEdge.rightVerticalSegment := by
  classical
  rw [show (Finset.univ : Finset GammaTwoModularTileEdge) =
      {GammaTwoModularTileEdge.circularArc,
        GammaTwoModularTileEdge.leftVerticalSegment,
        GammaTwoModularTileEdge.rightVerticalSegment} by decide]
  simp [add_assoc]

/-- Top horocycle term of the selected Piola boundary. -/
noncomputable def selectedPiolaTopBoundaryTerm
    (H : Real) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) : Complex :=
  ∫ x in (-(1 / 2 : Real))..(1 / 2 : Real),
    realProdLift (selectedCosetPiolaY q X Y) (x, H)

/-- Per selected coset, the closed-tile boundary is the top horocycle plus the
sum of the three genuinely oriented native actual-edge contributions. -/
theorem baseModularTruncationBoundaryFlux_selectedPiola_eq_top_add_native
    {H : Real} (hH : 1 < H) (X Y : UpperHalfPlane → Complex)
    (q : GammaTwoRightCoset) :
    baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y) =
      selectedPiolaTopBoundaryTerm H X Y q +
        ∑ edge : GammaTwoModularTileEdge,
          nativeOrientedActualEdgeContribution
            (H - modularVertexHeight) X Y (q, edge) := by
  have hT : 0 ≤ H - modularVertexHeight :=
    zero_le_height_sub_modularVertexHeight hH
  rw [baseModularTruncationBoundaryFlux_eq,
    sum_modularTileEdges_eq_three,
    nativeOrientedActualEdgeContribution_circular,
    nativeOrientedActualEdgeContribution_left hT,
    nativeOrientedActualEdgeContribution_right hT]
  simp only [selectedPiolaTopBoundaryTerm]
  ring

/-- Global boundary decomposition: all non-top terms are exactly one finite
sum over the actual edge type. -/
theorem sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_top_add_native
    {H : Real} (hH : 1 < H) (X Y : UpperHalfPlane → Complex) :
    (∑ q : GammaTwoRightCoset,
      baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)) =
      (∑ q : GammaTwoRightCoset, selectedPiolaTopBoundaryTerm H X Y q) +
        ∑ e : GammaTwoActualPolygonEdge,
          nativeOrientedActualEdgeContribution
            (H - modularVertexHeight) X Y e := by
  classical
  calc
    (∑ q : GammaTwoRightCoset,
        baseModularTruncationBoundaryFlux H
          (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)) =
        ∑ q : GammaTwoRightCoset,
          (selectedPiolaTopBoundaryTerm H X Y q +
            ∑ edge : GammaTwoModularTileEdge,
              nativeOrientedActualEdgeContribution
                (H - modularVertexHeight) X Y (q, edge)) := by
      apply Finset.sum_congr rfl
      intro q _hq
      exact baseModularTruncationBoundaryFlux_selectedPiola_eq_top_add_native
        hH X Y q
    _ = (∑ q : GammaTwoRightCoset,
          selectedPiolaTopBoundaryTerm H X Y q) +
        ∑ q : GammaTwoRightCoset,
          ∑ edge : GammaTwoModularTileEdge,
            nativeOrientedActualEdgeContribution
              (H - modularVertexHeight) X Y (q, edge) := by
      rw [Finset.sum_add_distrib]
    _ = (∑ q : GammaTwoRightCoset,
          selectedPiolaTopBoundaryTerm H X Y q) +
        ∑ e : GammaTwoActualPolygonEdge,
          nativeOrientedActualEdgeContribution
            (H - modularVertexHeight) X Y e := by
      rw [Fintype.sum_prod_type]

/-- If the top horocycle vanishes on every selected tile, the full boundary
sum is exactly the native actual-edge sum requested by the global Stokes
bridge. -/
theorem sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_native_of_top_zero
    {H : Real} (hH : 1 < H) (X Y : UpperHalfPlane → Complex)
    (hTop : ∀ q : GammaTwoRightCoset,
      (∫ x in (-(1 / 2 : Real))..(1 / 2 : Real),
        realProdLift (selectedCosetPiolaY q X Y) (x, H)) = 0) :
    (∑ q : GammaTwoRightCoset,
      baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)) =
      ∑ e : GammaTwoActualPolygonEdge,
        nativeOrientedActualEdgeContribution
          (H - modularVertexHeight) X Y e := by
  rw [sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_top_add_native
    hH X Y]
  have hTopSum :
      (∑ q : GammaTwoRightCoset, selectedPiolaTopBoundaryTerm H X Y q) = 0 := by
    apply Finset.sum_eq_zero
    intro q _hq
    simpa [selectedPiolaTopBoundaryTerm] using hTop q
  rw [hTopSum, zero_add]

/-- Invariant flux makes the native actual-edge sum vanish, leaving only the
top horocycles.  No top-tail hypothesis is used in this stronger identity. -/
theorem sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_top
    {H : Real} (hH : 1 < H) {X Y : UpperHalfPlane → Complex}
    (hInv : IsGammaTwoInvariantFlux X Y) :
    (∑ q : GammaTwoRightCoset,
      baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)) =
      ∑ q : GammaTwoRightCoset, selectedPiolaTopBoundaryTerm H X Y q := by
  rw [sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_top_add_native
    hH X Y]
  rw [sum_nativeOrientedActualEdgeContribution_eq_zero hInv
    (zero_le_height_sub_modularVertexHeight hH)]
  exact add_zero _

/-- With pointwise top cancellation, the complete selected Piola boundary sum
is zero. -/
theorem sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_zero
    {H : Real} (hH : 1 < H) {X Y : UpperHalfPlane → Complex}
    (hInv : IsGammaTwoInvariantFlux X Y)
    (hTop : ∀ q : GammaTwoRightCoset,
      (∫ x in (-(1 / 2 : Real))..(1 / 2 : Real),
        realProdLift (selectedCosetPiolaY q X Y) (x, H)) = 0) :
    (∑ q : GammaTwoRightCoset,
      baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)) = 0 := by
  rw [sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_top hH hInv]
  apply Finset.sum_eq_zero
  intro q _hq
  simpa [selectedPiolaTopBoundaryTerm] using hTop q

