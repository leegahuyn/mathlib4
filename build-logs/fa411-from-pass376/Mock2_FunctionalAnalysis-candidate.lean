/-!
### P6/P7 bridge: the actual scalar modular weak Schrodinger operator

This section fixes the PDE that the later compactness theorem will feed into.
The principal part is the genuine completed three-coordinate energy form at
orbit index `n`; the lower-order part is scalar multiplication by the explicit
discriminant potential.  Thus the displayed operator is not the rank-one test
model.  Compactness is kept as a theorem parameter only in the constructors
whose mathematical purpose is precisely to consume the forthcoming P5
compactness theorem.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace ActualScalarDiscriminantPDE

open ComplexLaxMilgram FredholmBypass
open HalfWeightDifferentialOperators
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open ExplicitDiscriminantPotential
open ExplicitDiscriminantPotential.FixedPhaseGraphPotential

/-- The actual energy/form domain at one fixed-phase orbit index. -/
abbrev ActualHOne (n : ℤ) := GraphSobolevCompletion n

/-- Its strong anti-dual, with the conjugate-linear test convention used by
the Petersson pairing throughout the file. -/
abbrev ActualHMinusOne (n : ℤ) := StrongAntiDual (ActualHOne n)

/-- The genuine principal graph-energy operator.  Its three coordinates are
the base Petersson value and the closed raising/lowering graph coordinates. -/
noncomputable def principalEnergyOperator (n : ℤ) :
    ContinuousSesquilinearForm (ActualHOne n) :=
  (coordinates n).completionEnergyOperator

@[simp]
theorem principalEnergyOperator_apply
    (n : ℤ) (u v : ActualHOne n) :
    principalEnergyOperator n u v = inner ℂ v u := by
  exact (coordinates n).completionEnergyOperator_apply u v

/-- The actual scalar discriminant weak operator
`E_n - t J_{VDelta}`.  Keeping the real coupling visible makes Hermitian
symmetry and the sign convention auditable. -/
noncomputable def weakSchrodingerOperator (n : ℤ) (t : ℝ) :
    ActualHOne n →L[ℂ] ActualHMinusOne n :=
  principalEnergyOperator n -
    (t : ℂ) • graphPotentialOperator n

@[simp]
theorem weakSchrodingerOperator_apply
    (n : ℤ) (t : ℝ) (u v : ActualHOne n) :
    weakSchrodingerOperator n t u v =
      inner ℂ v u -
        (t : ℂ) * graphPotentialOperator n u v := by
  simp only [weakSchrodingerOperator, principalEnergyOperator_apply,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
    smul_eq_mul]

/-- On the literal smooth automorphic core, the weak operator is exactly the
three-coordinate graph energy minus the integral of `t VDelta u conj(v)`.
This is the concrete weak PDE formula used by the manuscript. -/
theorem weakSchrodingerOperator_apply_core
    (n : ℤ) (t : ℝ)
    (u v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    weakSchrodingerOperator n t (coreMap n u) (coreMap n v) =
      (coordinates n).energyForm v u -
        (t : ℂ) *
          potentialForm (OrbitMultiplier n)
            GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) := by
  have hEnergy :=
    (coordinates n).completionEnergyOperator_sectionCoreMap u v
  change inner ℂ (coreMap n v) (coreMap n u) =
      (coordinates n).energyForm v u at hEnergy
  rw [weakSchrodingerOperator_apply, hEnergy,
    graphPotentialOperator_apply_core]

/-- The exact shift identity.  It explicitly retains the residual potential
term and therefore cannot be misread as naive removal of a Lax--Milgram
shift. -/
theorem principalEnergy_eq_weakSchrodinger_add_potential
    (n : ℤ) (t : ℝ) :
    principalEnergyOperator n =
      weakSchrodingerOperator n t +
        (t : ℂ) • graphPotentialOperator n := by
  rw [weakSchrodingerOperator]
  abel

/-- The principal graph energy is the canonical unit-coercive Riesz
equivalence from `H1` onto `H-1`. -/
noncomputable def principalEnergyEquiv (n : ℤ) :
    ActualHOne n ≃L[ℂ] ActualHMinusOne n :=
  (coordinates n).completionEnergyEquiv

@[simp]
theorem principalEnergyEquiv_apply (n : ℤ) (u : ActualHOne n) :
    principalEnergyEquiv n u = principalEnergyOperator n u :=
  rfl

/-- Exact shifted compact decomposition for the actual scalar modular PDE.
The sole input is compactness of the already-defined scalar multiplication
form, which P5 proves by local Rellich plus a cusp-tail norm estimate. -/
noncomputable def shiftedCompactDecomposition_of_compactPotential
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n)) :
    ShiftedCompactDecomposition (weakSchrodingerOperator n t) where
  shiftedEquiv := principalEnergyEquiv n
  lowerOrder := (t : ℂ) • graphPotentialOperator n
  shifted_eq := by
    change principalEnergyOperator n =
      weakSchrodingerOperator n t +
        (t : ℂ) • graphPotentialOperator n
    exact principalEnergy_eq_weakSchrodinger_add_potential n t
  lowerOrder_isCompact := hcompact.smul (t : ℂ)

/-- The general, possibly nontrivial-kernel Fredholm package attached to the
actual modular PDE.  No kernel-triviality field is requested. -/
noncomputable def fredholmData_of_compactPotential
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n)) :
    NontrivialKernelFredholmData (weakSchrodingerOperator n t) :=
  NontrivialKernelFredholmData.ofShiftedCompactDecomposition
    (shiftedCompactDecomposition_of_compactPotential n t hcompact)

/-- Closed range is derived from compact preconditioning for the actual PDE. -/
theorem weakSchrodinger_range_isClosed_of_compactPotential
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n)) :
    IsClosed ((weakSchrodingerOperator n t).range :
      Set (ActualHMinusOne n)) :=
  (fredholmData_of_compactPotential n t hcompact).range_isClosed

/-- Exact Fredholm solvability condition for an arbitrary `H-1` forcing. -/
theorem weakSchrodinger_solvable_iff_adjointKernel_orthogonal
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : ActualHMinusOne n) :
    (∃ u : ActualHOne n, weakSchrodingerOperator n t u = f) ↔
      f ∈ (ContinuousLinearMap.adjoint
        (weakSchrodingerOperator n t)).kerᗮ :=
  (fredholmData_of_compactPotential n t hcompact)
    .solvable_iff_mem_orthogonal_adjointKernel f

/-- The compatible forcing subtype for the actual PDE. -/
noncomputable abbrev CompatibleForcing
    (n : ℤ) (t : ℝ) := (weakSchrodingerOperator n t).range

/-- Canonical kernel-orthogonal weak solution. -/
noncomputable def canonicalWeakSolution
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : CompatibleForcing n t) : ActualHOne n :=
  (fredholmData_of_compactPotential n t hcompact).canonicalSolution f

@[simp]
theorem canonicalWeakSolution_spec
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : CompatibleForcing n t) :
    weakSchrodingerOperator n t
        (canonicalWeakSolution n t hcompact f) = (f : ActualHMinusOne n) :=
  (fredholmData_of_compactPotential n t hcompact).canonicalSolution_spec f

/-- The canonical solution lies in the orthogonal complement of the full
homogeneous solution space. -/
theorem canonicalWeakSolution_mem_kernelOrthogonal
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : CompatibleForcing n t) :
    canonicalWeakSolution n t hcompact f ∈
      (weakSchrodingerOperator n t).kerᗮ :=
  (fredholmData_of_compactPotential n t hcompact)
    .canonicalSolution_mem_kernelOrthogonal f

/-- Every weak solution is the canonical solution plus one homogeneous
solution, and every such translate is a solution. -/
theorem weakSchrodinger_solves_iff_canonical_add_kernel
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : CompatibleForcing n t) (u : ActualHOne n) :
    weakSchrodingerOperator n t u = (f : ActualHMinusOne n) ↔
      ∃ h : ActualHOne n,
        h ∈ (weakSchrodingerOperator n t).ker ∧
          u = canonicalWeakSolution n t hcompact f + h :=
  (fredholmData_of_compactPotential n t hcompact)
    .solves_iff_canonical_add_kernel f u

/-- The actual reduced inverse norm on the compatible forcing range. -/
noncomputable def reducedInverseNorm
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n)) : ℝ :=
  (fredholmData_of_compactPotential n t hcompact).canonicalInverseNorm

theorem canonicalWeakSolution_norm_le
    (n : ℤ) (t : ℝ)
    (hcompact : IsCompactOperator (graphPotentialOperator n))
    (f : CompatibleForcing n t) :
    ‖canonicalWeakSolution n t hcompact f‖ ≤
      reducedInverseNorm n t hcompact * ‖f‖ :=
  (fredholmData_of_compactPotential n t hcompact)
    .canonicalSolution_norm_le f

/-- Equality of anti-dual vectors is exactly the usual all-test weak
equation. -/
theorem isWeakSolution_iff_forall_test
    (n : ℤ) (t : ℝ) (f : ActualHMinusOne n) (u : ActualHOne n) :
    weakSchrodingerOperator n t u = f ↔
      ∀ v : ActualHOne n,
        inner ℂ v u -
            (t : ℂ) * graphPotentialOperator n u v = f v := by
  constructor
  · intro h v
    have hv := congrArg (fun g : ActualHMinusOne n => g v) h
    simpa only [weakSchrodingerOperator_apply] using hv
  · intro h
    ext v
    simpa only [weakSchrodingerOperator_apply] using h v

end ActualScalarDiscriminantPDE

namespace AxiomAuditP6ActualScalarPDE

#print axioms ActualScalarDiscriminantPDE.weakSchrodingerOperator_apply_core
#print axioms ActualScalarDiscriminantPDE.principalEnergy_eq_weakSchrodinger_add_potential
#print axioms ActualScalarDiscriminantPDE.fredholmData_of_compactPotential
#print axioms ActualScalarDiscriminantPDE.weakSchrodinger_solvable_iff_adjointKernel_orthogonal
#print axioms ActualScalarDiscriminantPDE.canonicalWeakSolution_spec
#print axioms ActualScalarDiscriminantPDE.weakSchrodinger_solves_iff_canonical_add_kernel
#print axioms ActualScalarDiscriminantPDE.canonicalWeakSolution_norm_le
#print axioms ActualScalarDiscriminantPDE.isWeakSolution_iff_forall_test

end AxiomAuditP6ActualScalarPDE
