#print axioms FixedPhaseGoodCuspCutoffBridge.modularLogMaxHeight_lipschitz
#print axioms FixedPhaseGoodCuspCutoffBridge.modularMaxHeight_eventuallyEq_maximizer_im_of_one_lt
#print axioms FixedPhaseGoodCuspCutoffBridge.modularLogMaxHeight_eventuallyEq_chart_of_pos

end AxiomAuditP3IntrinsicModularHeight
