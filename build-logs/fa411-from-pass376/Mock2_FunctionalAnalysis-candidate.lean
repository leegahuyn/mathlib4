/-- Explicit pointwise multiplier for the three planar localization
coordinates. -/
noncomputable def literalStageLocalizationDensityConstant (Y : ℝ) : ℝ :=
  literalStageCutoffC1Bound Y ^ 2 *
    (5 + 4 * (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2)

theorem literalStageLocalizationDensityConstant_nonneg (Y : ℝ) :
    0 ≤ literalStageLocalizationDensityConstant Y := by
  unfold literalStageLocalizationDensityConstant
  positivity

/-- Pointwise `L² + dx + dy` estimate on `tsupport χ_Y`.  All three terms
come from the actual physical gauge and the actual cutoff product rule. -/
theorem localizedGauge_planarDensity_le_on_cutoffSupport
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ)
    (hz : (z : ℂ) ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    ‖literalStageLocalizedGauge Y n u (z : ℂ)‖ ^ 2 +
        ‖HalfWeightCompactCoordinateGreen.dx
          (literalStageLocalizedGauge Y n u) (z : ℂ)‖ ^ 2 +
        ‖HalfWeightCompactCoordinateGreen.dy
          (literalStageLocalizedGauge Y n u) (z : ℂ)‖ ^ 2 ≤
      literalStageLocalizationDensityConstant Y *
        fixedPhaseEuclideanGraphDensity n u z := by
  let C := literalStageCutoffC1Bound Y
  let h := (literalStageCutoffSupportLowerHeight Y)⁻¹ ^ 2
  let G := fixedPhaseEuclideanGraphDensity n u z
  let F := ‖fixedPhaseEuclideanGauge n u z‖
  let Fx := ‖dx (fixedPhaseEuclideanGauge n u) z‖
  let Fy := ‖dy (fixedPhaseEuclideanGauge n u) z‖
  let X := ‖literalStageCutoff Y (z : ℂ)‖
  let Xx := ‖HalfWeightCompactCoordinateGreen.dx
    (literalStageCutoff Y) (z : ℂ)‖
  let Xy := ‖HalfWeightCompactCoordinateGreen.dy
    (literalStageCutoff Y) (z : ℂ)‖
  have hC : 0 ≤ C := literalStageCutoffC1Bound_nonneg Y
  have hh : 0 ≤ h := sq_nonneg _
  have hG : 0 ≤ G := fixedPhaseEuclideanGraphDensity_nonneg n u z
  have hF : 0 ≤ F := norm_nonneg _
  have hFx : 0 ≤ Fx := norm_nonneg _
  have hFy : 0 ≤ Fy := norm_nonneg _
  have hX : 0 ≤ X := norm_nonneg _
  have hXx : 0 ≤ Xx := norm_nonneg _
  have hXy : 0 ≤ Xy := norm_nonneg _
  have hXle : X ≤ C := norm_literalStageCutoff_le Y (z : ℂ)
  have hXxle : Xx ≤ C := norm_dx_literalStageCutoff_le Y (z : ℂ)
  have hXyle : Xy ≤ C := norm_dy_literalStageCutoff_le Y (z : ℂ)
  have hFgraph : F ^ 2 ≤ G :=
    norm_fixedPhaseEuclideanGauge_sq_le_graphDensity n u z
  have hFxgraph : Fx ^ 2 ≤ h * G :=
    norm_dx_sq_le_cutoffSupportLowerHeight_inv_sq_mul_graphDensity
      Y n u hz
  have hFygraph : Fy ^ 2 ≤ h * G :=
    norm_dy_sq_le_cutoffSupportLowerHeight_inv_sq_mul_graphDensity
      Y n u hz
  have hzero :
      ‖literalStageLocalizedGauge Y n u (z : ℂ)‖ ^ 2 ≤ C ^ 2 * G := by
    rw [literalStageLocalizedGauge_apply, upperLift_apply, norm_mul, mul_pow]
    dsimp only [F, X] at hFgraph hXle ⊢
    nlinarith [sq_nonneg (C - X),
      mul_le_mul_of_nonneg_left hFgraph (sq_nonneg X),
      mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hX hC).2 hXle) hG]
  have hxraw :
      ‖dx (fixedPhaseEuclideanGauge n u) z *
            literalStageCutoff Y (z : ℂ) +
          fixedPhaseEuclideanGauge n u z *
            HalfWeightCompactCoordinateGreen.dx
              (literalStageCutoff Y) (z : ℂ)‖ ^ 2 ≤
        2 * C ^ 2 * (h + 1) * G := by
    have hadd := norm_add_le
      (dx (fixedPhaseEuclideanGauge n u) z *
        literalStageCutoff Y (z : ℂ))
      (fixedPhaseEuclideanGauge n u z *
        HalfWeightCompactCoordinateGreen.dx
          (literalStageCutoff Y) (z : ℂ))
    rw [norm_mul, norm_mul] at hadd
    dsimp only [Fx, F, X, Xx] at hadd hFxgraph hFgraph hXle hXxle ⊢
    nlinarith [sq_nonneg (Fx * X - F * Xx),
      mul_le_mul_of_nonneg_left hFxgraph (sq_nonneg X),
      mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hX hC).2 hXle) (mul_nonneg hh hG),
      mul_le_mul_of_nonneg_left hFgraph (sq_nonneg Xx),
      mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hXx hC).2 hXxle) hG]
  have hyraw :
      ‖dy (fixedPhaseEuclideanGauge n u) z *
            literalStageCutoff Y (z : ℂ) +
          fixedPhaseEuclideanGauge n u z *
            HalfWeightCompactCoordinateGreen.dy
              (literalStageCutoff Y) (z : ℂ)‖ ^ 2 ≤
        2 * C ^ 2 * (h + 1) * G := by
    have hadd := norm_add_le
      (dy (fixedPhaseEuclideanGauge n u) z *
        literalStageCutoff Y (z : ℂ))
      (fixedPhaseEuclideanGauge n u z *
        HalfWeightCompactCoordinateGreen.dy
          (literalStageCutoff Y) (z : ℂ))
    rw [norm_mul, norm_mul] at hadd
    dsimp only [Fy, F, X, Xy] at hadd hFygraph hFgraph hXle hXyle ⊢
    nlinarith [sq_nonneg (Fy * X - F * Xy),
      mul_le_mul_of_nonneg_left hFygraph (sq_nonneg X),
      mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hX hC).2 hXle) (mul_nonneg hh hG),
      mul_le_mul_of_nonneg_left hFgraph (sq_nonneg Xy),
      mul_le_mul_of_nonneg_right
        ((sq_le_sq₀ hXy hC).2 hXyle) hG]
  rw [dx_literalStageLocalizedGauge_apply_upper,
    dy_literalStageLocalizedGauge_apply_upper]
  dsimp only [literalStageLocalizationDensityConstant, C, h, G] at hzero ⊢
  nlinarith

/-- Global upper-half-plane version.  Off `tsupport χ_Y`, the localized test
and both of its test-function derivatives vanish on a neighbourhood. -/
theorem localizedGauge_planarDensity_le
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    ‖literalStageLocalizedGauge Y n u (z : ℂ)‖ ^ 2 +
        ‖HalfWeightCompactCoordinateGreen.dx
          (literalStageLocalizedGauge Y n u) (z : ℂ)‖ ^ 2 +
        ‖HalfWeightCompactCoordinateGreen.dy
          (literalStageLocalizedGauge Y n u) (z : ℂ)‖ ^ 2 ≤
      literalStageLocalizationDensityConstant Y *
        fixedPhaseEuclideanGraphDensity n u z := by
  by_cases hz : (z : ℂ) ∈
      tsupport (literalStageCutoff Y : ℂ → ℂ)
  · exact localizedGauge_planarDensity_le_on_cutoffSupport Y n u z hz
  · have hlocal : (z : ℂ) ∉
        tsupport (literalStageLocalizedGauge Y n u : ℂ → ℂ) :=
      fun h ↦ hz (tsupport_literalStageLocalizedGauge_subset_cutoff Y n u h)
    have hdx : (z : ℂ) ∉ tsupport
        (HalfWeightCompactCoordinateGreen.dx
          (literalStageLocalizedGauge Y n u) : ℂ → ℂ) :=
      fun h ↦ hlocal
        (HalfWeightCompactCoordinateGreen.tsupport_dx_subset _ h)
    have hdy : (z : ℂ) ∉ tsupport
        (HalfWeightCompactCoordinateGreen.dy
          (literalStageLocalizedGauge Y n u) : ℂ → ℂ) :=
      fun h ↦ hlocal
        (HalfWeightCompactCoordinateGreen.tsupport_dy_subset _ h)
    rw [image_eq_zero_of_notMem_tsupport hlocal,
      image_eq_zero_of_notMem_tsupport hdx,
      image_eq_zero_of_notMem_tsupport hdy,
      norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
      zero_add]
    exact mul_nonneg (literalStageLocalizationDensityConstant_nonneg Y)
      (fixedPhaseEuclideanGraphDensity_nonneg n u z)

/-! ### A finite orbit cover of the localization support

The graph norm is integrated on the chosen carrier, whereas `χ_Y` is a
paired-side-safe ambient cutoff and can cross that carrier's sides.  Proper
discontinuity reduces this discrepancy to an explicit finite set of
effective `Gamma(2)` translates. -/

/-- The cutoff support pulled back to the upper half-plane. -/
def literalStageCutoffUpperSupport (Y : ℝ) : Set ℍ :=
  {z | (z : ℂ) ∈ tsupport (literalStageCutoff Y : ℂ → ℂ)}

theorem coe_image_literalStageCutoffUpperSupport (Y : ℝ) :
    UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y =
      tsupport (literalStageCutoff Y : ℂ → ℂ) := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    exact hz
  · intro hw
    have hwUpper : 0 < w.im := (literalStageCutoff Y).tsupport_subset hw
    exact ⟨⟨w, hwUpper⟩, hw, rfl⟩

theorem literalStageCutoffUpperSupport_isCompact (Y : ℝ) :
    IsCompact (literalStageCutoffUpperSupport Y) := by
  rw [UpperHalfPlane.isEmbedding_coe.isCompact_iff,
    coe_image_literalStageCutoffUpperSupport]
  exact (literalStageCutoff Y).hasCompactSupport

/-- Compact quotient image of the cutoff support. -/
def literalStageCutoffQuotientSupport (Y : ℝ) :
    Set GammaTwoQuotient :=
  gammaTwoQuotientMk '' literalStageCutoffUpperSupport Y

theorem literalStageCutoffQuotientSupport_isCompact (Y : ℝ) :
    IsCompact (literalStageCutoffQuotientSupport Y) :=
  (literalStageCutoffUpperSupport_isCompact Y).image
    gammaTwoQuotientMk_isOpenQuotientMap.continuous

/-- Compact representatives, in the chosen closed carrier, of all quotient
points met by the ambient cutoff. -/
def literalStageCutoffCarrierLift (Y : ℝ) : Set ℍ :=
  gammaTwoClosedTileCarrier ∩
    gammaTwoQuotientMk ⁻¹' literalStageCutoffQuotientSupport Y

theorem literalStageCutoffCarrierLift_isCompact (Y : ℝ) :
    IsCompact (literalStageCutoffCarrierLift Y) :=
  gammaTwoClosedCarrier_inter_preimage_isCompact
    (literalStageCutoffQuotientSupport Y)
    (literalStageCutoffQuotientSupport_isCompact Y)

/-- Effective translates of the compact carrier lift which actually meet the
cutoff support. -/
def literalStageActiveTranslateSet (Y : ℝ) :
    Set GammaTwoEffective :=
  {a | (((a • ·) '' literalStageCutoffCarrierLift Y) ∩
    literalStageCutoffUpperSupport Y).Nonempty}

theorem literalStageActiveTranslateSet_finite (Y : ℝ) :
    (literalStageActiveTranslateSet Y).Finite :=
  gammaTwoEffective_finite_translates_inter_compact
    (literalStageCutoffCarrierLift_isCompact Y)
    (literalStageCutoffUpperSupport_isCompact Y)

/-- The active effective translates as a literal finite index set. -/
noncomputable def literalStageActiveTranslates (Y : ℝ) :
    Finset GammaTwoEffective :=
  (literalStageActiveTranslateSet_finite Y).toFinset

@[simp]
theorem mem_literalStageActiveTranslates_iff
    (Y : ℝ) (a : GammaTwoEffective) :
    a ∈ literalStageActiveTranslates Y ↔
      (((a • ·) '' literalStageCutoffCarrierLift Y) ∩
        literalStageCutoffUpperSupport Y).Nonempty := by
  classical
  rw [literalStageActiveTranslates, Set.Finite.mem_toFinset]
  rfl

/-- Every point on the cutoff support lies in one of the displayed finitely
many translates of the compact carrier lift. -/
theorem literalStageCutoffUpperSupport_subset_activeTranslates (Y : ℝ) :
    literalStageCutoffUpperSupport Y ⊆
      ⋃ a ∈ literalStageActiveTranslates Y,
        (a • ·) '' literalStageCutoffCarrierLift Y := by
  intro z hz
  have hzq : gammaTwoQuotientMk z ∈
      literalStageCutoffQuotientSupport Y := ⟨z, hz, rfl⟩
  obtain ⟨w, hwLift, hwq⟩ :=
    quotientSet_subset_closedCarrier_preimage_image
      (literalStageCutoffQuotientSupport Y) hzq
  have hOrbit : z ∈ MulAction.orbit GammaTwoEffective w :=
    MulAction.orbitRel_apply.mp (Quotient.exact' hwq)
  obtain ⟨a, haw⟩ := MulAction.mem_orbit_iff.mp hOrbit
  have hzImage : z ∈ (a • ·) '' literalStageCutoffCarrierLift Y :=
    ⟨w, hwLift, haw⟩
  have ha : a ∈ literalStageActiveTranslates Y :=
    (mem_literalStageActiveTranslates_iff Y a).2
      ⟨z, hzImage, hz⟩
  exact Set.mem_iUnion₂.2 ⟨a, ha, hzImage⟩

/-! ### Invariant hyperbolic form of the physical graph density -/

/-- The same three physical coordinates before the Euclidean `y⁻²` gauge is
absorbed into area measure. -/
noncomputable def fixedPhaseHyperbolicGraphDensity
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) : ℍ → ℝ :=
  fun z =>
    logHeightTraceBaseCoeff n *
        WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier n)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) z +
      3 * WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier (n + 1))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)) z +
      3 * WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier (n - 1))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n - 1)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)) z

theorem fixedPhaseHyperbolicGraphDensity_nonneg
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    0 ≤ fixedPhaseHyperbolicGraphDensity n u z := by
  unfold fixedPhaseHyperbolicGraphDensity
  positivity

theorem fixedPhaseHyperbolicGraphDensity_continuous
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    Continuous (fixedPhaseHyperbolicGraphDensity n u) := by
  unfold fixedPhaseHyperbolicGraphDensity
  exact
    (((continuous_const.mul
      (WeightCorePetersson.upstairsNormSqDensity_continuous
        (OrbitMultiplier n)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u))).add
      (continuous_const.mul
        (WeightCorePetersson.upstairsNormSqDensity_continuous
          (OrbitMultiplier (n + 1))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u))))).add
      (continuous_const.mul
        (WeightCorePetersson.upstairsNormSqDensity_continuous
          (OrbitMultiplier (n - 1))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n - 1)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)))))

theorem fixedPhaseHyperbolicGraphDensity_effective_invariant
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    (a : GammaTwoEffective) (z : ℍ) :
    fixedPhaseHyperbolicGraphDensity n u (a • z) =
      fixedPhaseHyperbolicGraphDensity n u z := by
  unfold fixedPhaseHyperbolicGraphDensity
  rw [WeightCorePetersson.upstairsNormSqDensity_effective_invariant,
    WeightCorePetersson.upstairsNormSqDensity_effective_invariant,
    WeightCorePetersson.upstairsNormSqDensity_effective_invariant]

/-- Exact relation between Euclidean and invariant hyperbolic graph
densities. -/
theorem fixedPhaseEuclideanGraphDensity_eq_hyperbolicDensity_mul
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    fixedPhaseEuclideanGraphDensity n u z =
      (hyperbolicDensity z : ℝ) *
        fixedPhaseHyperbolicGraphDensity n u z := by
  unfold fixedPhaseEuclideanGraphDensity fixedPhaseHyperbolicGraphDensity
  rw [show ‖fixedPhaseEuclideanGauge n u z‖ ^ 2 =
      hyperbolicDensity z •
        WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier n)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) z by
        simpa only [fixedPhaseEuclideanGauge,
          coreEmbedding_toSmoothCore] using
            orbitEuclideanGauge_norm_sq n (coreEmbedding n u) z,
    show ‖fixedPhaseEuclideanGauge (n + 1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u) z‖ ^ 2 =
      hyperbolicDensity z •
        WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier (n + 1))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)) z by
        simpa only [fixedPhaseEuclideanGauge,
          coreEmbedding_toSmoothCore] using
            orbitEuclideanGauge_norm_sq (n + 1)
              (coreEmbedding (n + 1)
                (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)) z,
    show ‖fixedPhaseEuclideanGauge (n - 1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u) z‖ ^ 2 =
      hyperbolicDensity z •
        WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier (n - 1))
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n - 1)
            (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)) z by
        simpa only [fixedPhaseEuclideanGauge,
          coreEmbedding_toSmoothCore] using
            orbitEuclideanGauge_norm_sq (n - 1)
              (coreEmbedding (n - 1)
                (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)) z]
  simp only [NNReal.smul_def]
  ring

/-- Real diagonal Petersson norm as the invariant upstairs integral on the
chosen carrier. -/
theorem peterssonNormSq_eq_integral_upstairsNormSqDensity
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    WeightCorePetersson.peterssonNormSq (OrbitMultiplier m)
        chosenGammaTwoFundamentalDomain
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v) =
      ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier m)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v) z
          ∂hyperbolicMeasure := by
  unfold WeightCorePetersson.peterssonNormSq
    WeightCorePetersson.quotientNormSqDensity
  exact chosenGammaTwoFundamentalDomain.integral_descendInvariant_eq _ _
    ((WeightCorePetersson.quotientNormSqDensity_integrable
      (OrbitMultiplier m)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v)
      chosenGammaTwoFundamentalDomain).aestronglyMeasurable)

/-- Integrability of the real diagonal density, derived from the already
proved complex Petersson integrability rather than assumed separately. -/
theorem upstairsNormSqDensity_integrableOn_chosenCarrier
    (m : ℤ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore m) :
    IntegrableOn
      (WeightCorePetersson.upstairsNormSqDensity (OrbitMultiplier m)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure := by
  have hInner := WeightCorePetersson.upstairsInnerDensity_integrableOn
    (OrbitMultiplier m)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore m v)
    chosenGammaTwoFundamentalDomain
  simpa only [WeightCorePetersson.upstairsInnerDensity_self,
    Complex.ofReal_re] using hInner.re

theorem fixedPhaseHyperbolicGraphDensity_integrableOn_chosenCarrier
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    IntegrableOn (fixedPhaseHyperbolicGraphDensity n u)
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure := by
  unfold fixedPhaseHyperbolicGraphDensity
  exact (((upstairsNormSqDensity_integrableOn_chosenCarrier n u).const_mul _).add
    ((upstairsNormSqDensity_integrableOn_chosenCarrier (n + 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)).const_mul _)).add
    ((upstairsNormSqDensity_integrableOn_chosenCarrier (n - 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)).const_mul _)

theorem integral_fixedPhaseHyperbolicGraphDensity_chosenCarrier
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure) =
      logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 := by
  have hBase := upstairsNormSqDensity_integrableOn_chosenCarrier n u
  have hRaise := upstairsNormSqDensity_integrableOn_chosenCarrier (n + 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u)
  have hLower := upstairsNormSqDensity_integrableOn_chosenCarrier (n - 1)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u)
  unfold fixedPhaseHyperbolicGraphDensity
  rw [integral_add ((hBase.const_mul _).add (hRaise.const_mul _))
      (hLower.const_mul _),
    integral_add (hBase.const_mul _) (hRaise.const_mul _),
    integral_const_mul, integral_const_mul, integral_const_mul,
    ← peterssonNormSq_eq_integral_upstairsNormSqDensity n u,
    ← peterssonNormSq_eq_integral_upstairsNormSqDensity (n + 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.raise n u),
    ← peterssonNormSq_eq_integral_upstairsNormSqDensity (n - 1)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.lower n u),
    ← l2Coordinate_norm_sq_eq_peterssonNormSq,
    ← l2Coordinate_norm_sq_eq_peterssonNormSq,
    ← l2Coordinate_norm_sq_eq_peterssonNormSq,
    raisedCoordinate_apply, loweredCoordinate_apply]

/-! ### Finite-translate integration estimate -/

/-- Set integration of the invariant graph density is unchanged by one
effective translate. -/
theorem setIntegral_fixedPhaseHyperbolicGraphDensity_image_smul
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n)
    (a : GammaTwoEffective) (S : Set ℍ) :
    (∫ z in (a • ·) '' S,
        fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure) =
      ∫ z in S, fixedPhaseHyperbolicGraphDensity n u z
        ∂hyperbolicMeasure := by
  have hChange :=
    (measurePreserving_smul a hyperbolicMeasure).setIntegral_image_emb
      (measurableEmbedding_const_smul a)
      (fixedPhaseHyperbolicGraphDensity n u) S
  calc
    (∫ z in (a • ·) '' S,
        fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure) =
        ∫ z in S, fixedPhaseHyperbolicGraphDensity n u (a • z)
          ∂hyperbolicMeasure := hChange
    _ = ∫ z in S, fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := by
      apply setIntegral_congr_ae
      filter_upwards with z
      intro _hz
      exact fixedPhaseHyperbolicGraphDensity_effective_invariant n u a z

/-- A finite union of compact sets has no more nonnegative integral than the
sum over its members.  This is proved by disjointifying each insertion; no
pairwise-disjoint chart premise is needed. -/
theorem setIntegral_biUnion_finset_le_sum_of_nonneg
    {ι : Type*} [DecidableEq ι]
    (s : ι → Set ℍ) (t : Finset ι) (f : ℍ → ℝ)
    (hf : Continuous f) (hf0 : ∀ z, 0 ≤ f z)
    (hs : ∀ i ∈ t, IsCompact (s i)) :
    (∫ z in ⋃ i ∈ t, s i, f z ∂hyperbolicMeasure) ≤
      ∑ i ∈ t, ∫ z in s i, f z ∂hyperbolicMeasure := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | @insert a t hat ih =>
      let U : Set ℍ := ⋃ i ∈ t, s i
      have hsa : IsCompact (s a) := hs a (Finset.mem_insert_self a t)
      have hU : IsCompact U := by
        exact t.isCompact_biUnion fun i hi ↦
          hs i (Finset.mem_insert_of_mem hi)
      have hsaInt : IntegrableOn f (s a) hyperbolicMeasure :=
        hf.continuousOn.integrableOn_compact hsa
      have hUInt : IntegrableOn f U hyperbolicMeasure :=
        hf.continuousOn.integrableOn_compact hU
      have hDiffInt : IntegrableOn f (U \ s a) hyperbolicMeasure :=
        hUInt.mono_set Set.diff_subset
      have hUnionEq :
          (⋃ i ∈ insert a t, s i) = s a ∪ U := by
        simp only [U, Finset.set_biUnion_insert]
      have hDisjoint : Disjoint (s a) (U \ s a) :=
        Set.disjoint_sdiff_right
      have hSplit :
          (∫ z in s a ∪ U, f z ∂hyperbolicMeasure) =
            (∫ z in s a, f z ∂hyperbolicMeasure) +
              ∫ z in U \ s a, f z ∂hyperbolicMeasure := by
        rw [show s a ∪ U = s a ∪ (U \ s a) by
          ext z
          simp only [Set.mem_union, Set.mem_diff]
          tauto]
        exact setIntegral_union hDisjoint
          (hU.measurableSet.diff hsa.measurableSet) hsaInt hDiffInt
      have hDiffLe :
          (∫ z in U \ s a, f z ∂hyperbolicMeasure) ≤
            ∫ z in U, f z ∂hyperbolicMeasure := by
        apply setIntegral_mono_set hUInt
        · exact Filter.Eventually.of_forall hf0
        · exact Set.diff_subset.eventuallyLE
      have ih' := ih (fun i hi ↦ hs i (Finset.mem_insert_of_mem hi))
      rw [hUnionEq, hSplit, Finset.sum_insert hat]
      exact add_le_add le_rfl (hDiffLe.trans ih')

/-- The active finite orbit cover has an explicit integral multiplicity. -/
theorem integral_cutoffSupport_hyperbolicGraphDensity_le
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ z in literalStageCutoffUpperSupport Y,
        fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure) ≤
      (literalStageActiveTranslates Y).card *
        (selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2) := by
  classical
  let A : Finset GammaTwoEffective := literalStageActiveTranslates Y
  let L : Set ℍ := literalStageCutoffCarrierLift Y
  let U : Set ℍ := ⋃ a ∈ A, (a • ·) '' L
  have hL : IsCompact L := literalStageCutoffCarrierLift_isCompact Y
  have hU : IsCompact U := A.isCompact_biUnion fun a _ ↦
    hL.image (continuous_const_smul a)
  have hUInt : IntegrableOn (fixedPhaseHyperbolicGraphDensity n u) U
      hyperbolicMeasure :=
    (fixedPhaseHyperbolicGraphDensity_continuous n u).continuousOn.integrableOn_compact hU
  have hSupportLeUnion :
      (∫ z in literalStageCutoffUpperSupport Y,
          fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure) ≤
        ∫ z in U, fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := by
    apply setIntegral_mono_set hUInt
    · exact Filter.Eventually.of_forall fun z ↦
        fixedPhaseHyperbolicGraphDensity_nonneg n u z
    · exact (literalStageCutoffUpperSupport_subset_activeTranslates Y).eventuallyLE
  have hUnionLeSum :
      (∫ z in U, fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure) ≤
        ∑ a ∈ A, ∫ z in (a • ·) '' L,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := by
    exact setIntegral_biUnion_finset_le_sum_of_nonneg
      (fun a ↦ (a • ·) '' L) A
      (fixedPhaseHyperbolicGraphDensity n u)
      (fixedPhaseHyperbolicGraphDensity_continuous n u)
      (fixedPhaseHyperbolicGraphDensity_nonneg n u)
      (fun a _ ↦ hL.image (continuous_const_smul a))
  have hLiftSubset : L ⊆ chosenGammaTwoFundamentalDomain.carrier := by
    intro z hz
    rw [← gammaTwoClosedTileCarrier_eq_chosenCarrier]
    exact hz.1
  have hCarrierInt :=
    fixedPhaseHyperbolicGraphDensity_integrableOn_chosenCarrier n u
  have hLiftLe :
      (∫ z in L, fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure) ≤
        ∫ z in chosenGammaTwoFundamentalDomain.carrier,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := by
    apply setIntegral_mono_set hCarrierInt
    · exact Filter.Eventually.of_forall fun z ↦
        fixedPhaseHyperbolicGraphDensity_nonneg n u z
    · exact hLiftSubset.eventuallyLE
  have hEnergy :
      (∫ z in chosenGammaTwoFundamentalDomain.carrier,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure) ≤
        selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2 := by
    rw [integral_fixedPhaseHyperbolicGraphDensity_chosenCarrier]
    exact weighted_coordinate_energy_le_coreMap n u
  calc
    _ ≤ ∫ z in U, fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := hSupportLeUnion
    _ ≤ ∑ a ∈ A, ∫ z in (a • ·) '' L,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := hUnionLeSum
    _ = ∑ a ∈ A, ∫ z in L,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure := by
        apply Finset.sum_congr rfl
        intro a ha
        exact setIntegral_fixedPhaseHyperbolicGraphDensity_image_smul
          n u a L
    _ ≤ ∑ _a ∈ A,
          selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2 := by
        gcongr
        exact hLiftLe.trans hEnergy
    _ = (literalStageActiveTranslates Y).card *
          (selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2) := by
        simp only [A, Finset.sum_const, nsmul_eq_mul]

/-- Euclidean and hyperbolic graph integrals agree on the cutoff support. -/
theorem integral_euclideanGraphDensity_cutoffSupport_eq_hyperbolic
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ z in literalStageCutoffUpperSupport Y,
        fixedPhaseEuclideanGraphDensity n u z ∂upperEuclideanMeasure) =
      ∫ z in literalStageCutoffUpperSupport Y,
        fixedPhaseHyperbolicGraphDensity n u z ∂hyperbolicMeasure := by
  rw [hyperbolicMeasure_eq_euclidean_withDensity]
  rw [setIntegral_withDensity_eq_setIntegral_smul
    hyperbolicDensity_measurable _
    (literalStageCutoffUpperSupport_isCompact Y).measurableSet]
  symm
  apply setIntegral_congr_fun
    (literalStageCutoffUpperSupport_isCompact Y).measurableSet
  intro z hz
  rw [fixedPhaseEuclideanGraphDensity_eq_hyperbolicDensity_mul]
  simp only [NNReal.smul_def]

/-! ### Integrated planar `H¹` bound and completion extension -/

/-- Literal planar `L² + dx + dy` density of the localized gauge. -/
noncomputable def literalStageLocalizedPlanarDensity
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) : ℂ → ℝ :=
  fun w =>
    ‖literalStageLocalizedGauge Y n u w‖ ^ 2 +
      ‖HalfWeightCompactCoordinateGreen.dx
        (literalStageLocalizedGauge Y n u) w‖ ^ 2 +
      ‖HalfWeightCompactCoordinateGreen.dy
        (literalStageLocalizedGauge Y n u) w‖ ^ 2

theorem literalStageLocalizedPlanarDensity_continuous
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    Continuous (literalStageLocalizedPlanarDensity Y n u) := by
  unfold literalStageLocalizedPlanarDensity
  exact (((literalStageLocalizedGauge Y n u).continuous.norm.pow 2).add
    ((HalfWeightCompactCoordinateGreen.dx
      (literalStageLocalizedGauge Y n u)).continuous.norm.pow 2)).add
    ((HalfWeightCompactCoordinateGreen.dy
      (literalStageLocalizedGauge Y n u)).continuous.norm.pow 2)

theorem literalStageLocalizedPlanarDensity_eq_zero_of_not_mem_cutoff
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) {w : ℂ}
    (hw : w ∉ tsupport (literalStageCutoff Y : ℂ → ℂ)) :
    literalStageLocalizedPlanarDensity Y n u w = 0 := by
  have hlocal : w ∉
      tsupport (literalStageLocalizedGauge Y n u : ℂ → ℂ) :=
    fun h ↦ hw (tsupport_literalStageLocalizedGauge_subset_cutoff Y n u h)
  have hdx : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.dx
        (literalStageLocalizedGauge Y n u) : ℂ → ℂ) :=
    fun h ↦ hlocal (HalfWeightCompactCoordinateGreen.tsupport_dx_subset _ h)
  have hdy : w ∉ tsupport
      (HalfWeightCompactCoordinateGreen.dy
        (literalStageLocalizedGauge Y n u) : ℂ → ℂ) :=
    fun h ↦ hlocal (HalfWeightCompactCoordinateGreen.tsupport_dy_subset _ h)
  unfold literalStageLocalizedPlanarDensity
  rw [image_eq_zero_of_notMem_tsupport hlocal,
    image_eq_zero_of_notMem_tsupport hdx,
    image_eq_zero_of_notMem_tsupport hdy]
  norm_num

theorem support_literalStageLocalizedPlanarDensity_subset_cutoff
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    Function.support (literalStageLocalizedPlanarDensity Y n u) ⊆
      tsupport (literalStageCutoff Y : ℂ → ℂ) := by
  intro w hw
  by_contra hnot
  exact hw (literalStageLocalizedPlanarDensity_eq_zero_of_not_mem_cutoff
    Y n u hnot)

theorem literalStageLocalizedPlanarDensity_hasCompactSupport
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    HasCompactSupport (literalStageLocalizedPlanarDensity Y n u) :=
  (literalStageCutoff Y).hasCompactSupport.of_isClosed_subset
    isClosed_closure
    (closure_minimal
      (support_literalStageLocalizedPlanarDensity_subset_cutoff Y n u)
      (literalStageCutoff Y).hasCompactSupport.isClosed)

theorem literalStageLocalizedPlanarDensity_integrable
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    Integrable (literalStageLocalizedPlanarDensity Y n u)
      (volume : Measure ℂ) :=
  (literalStageLocalizedPlanarDensity_continuous Y n u).integrable_of_hasCompactSupport
      (literalStageLocalizedPlanarDensity_hasCompactSupport Y n u)

/-- Pulling the compact planar density back through the upper-half-plane
embedding preserves its integral. -/
theorem integral_literalStageLocalizedPlanarDensity_eq_upperSupport
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ w : ℂ, literalStageLocalizedPlanarDensity Y n u w) =
      ∫ z in literalStageCutoffUpperSupport Y,
        literalStageLocalizedPlanarDensity Y n u (z : ℂ)
        ∂upperEuclideanMeasure := by
  have hmp : MeasurePreserving UpperHalfPlane.coe
      upperEuclideanMeasure
      (volume.restrict (Set.range UpperHalfPlane.coe)) := by
    refine ⟨UpperHalfPlane.measurable_coe, ?_⟩
    rw [UpperHalfPlane.measurableEmbedding_coe.map_comap]
  have hImage : UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y =
      tsupport (literalStageCutoff Y : ℂ → ℂ) :=
    coe_image_literalStageCutoffUpperSupport Y
  calc
    (∫ w : ℂ, literalStageLocalizedPlanarDensity Y n u w) =
        ∫ w in tsupport (literalStageCutoff Y : ℂ → ℂ),
          literalStageLocalizedPlanarDensity Y n u w :=
      (setIntegral_eq_integral_of_forall_compl_eq_zero fun w hw ↦
        literalStageLocalizedPlanarDensity_eq_zero_of_not_mem_cutoff
          Y n u hw).symm
    _ = ∫ w in UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y,
          literalStageLocalizedPlanarDensity Y n u w := by rw [hImage]
    _ = ∫ w in UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y,
          literalStageLocalizedPlanarDensity Y n u w
          ∂(volume.restrict (Set.range UpperHalfPlane.coe)) := by
      change (∫ w, literalStageLocalizedPlanarDensity Y n u w
          ∂((volume : Measure ℂ).restrict
            (UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y))) =
        ∫ w, literalStageLocalizedPlanarDensity Y n u w
          ∂((volume.restrict (Set.range UpperHalfPlane.coe)).restrict
            (UpperHalfPlane.coe '' literalStageCutoffUpperSupport Y))
      rw [Measure.restrict_restrict_of_subset
        (Set.image_subset_range UpperHalfPlane.coe
          (literalStageCutoffUpperSupport Y))]
    _ = ∫ z in literalStageCutoffUpperSupport Y,
          literalStageLocalizedPlanarDensity Y n u (z : ℂ)
          ∂upperEuclideanMeasure :=
      hmp.setIntegral_image_emb
        UpperHalfPlane.measurableEmbedding_coe
        (literalStageLocalizedPlanarDensity Y n u)
        (literalStageCutoffUpperSupport Y)

/-- The actual compactly supported planar localization is bounded by the
Definition-1 graph norm, with an explicit finite-orbit multiplicity. -/
theorem integral_literalStageLocalizedPlanarDensity_le_coreMap
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ w : ℂ, literalStageLocalizedPlanarDensity Y n u w) ≤
      literalStageLocalizationDensityConstant Y *
        ((literalStageActiveTranslates Y).card *
          (selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2)) := by
  rw [integral_literalStageLocalizedPlanarDensity_eq_upperSupport]
  have hK := literalStageCutoffUpperSupport_isCompact Y
  have hLocalInt : IntegrableOn
      (fun z : ℍ ↦ literalStageLocalizedPlanarDensity Y n u (z : ℂ))
      (literalStageCutoffUpperSupport Y) upperEuclideanMeasure :=
    ((literalStageLocalizedPlanarDensity_continuous Y n u).comp
      UpperHalfPlane.continuous_coe).continuousOn.integrableOn_compact hK
  have hGraphInt : IntegrableOn
      (fun z ↦ literalStageLocalizationDensityConstant Y *
        fixedPhaseEuclideanGraphDensity n u z)
      (literalStageCutoffUpperSupport Y) upperEuclideanMeasure :=
    (((fixedPhaseEuclideanGraphDensity_continuous n u).const_mul
      (literalStageLocalizationDensityConstant Y)).continuousOn.integrableOn_compact hK)
  calc
    (∫ z in literalStageCutoffUpperSupport Y,
        literalStageLocalizedPlanarDensity Y n u (z : ℂ)
        ∂upperEuclideanMeasure) ≤
      ∫ z in literalStageCutoffUpperSupport Y,
        literalStageLocalizationDensityConstant Y *
          fixedPhaseEuclideanGraphDensity n u z
          ∂upperEuclideanMeasure := by
        apply integral_mono_ae hLocalInt hGraphInt
        filter_upwards [ae_restrict_mem hK.measurableSet] with z hz
        exact localizedGauge_planarDensity_le Y n u z
    _ = literalStageLocalizationDensityConstant Y *
        (∫ z in literalStageCutoffUpperSupport Y,
          fixedPhaseEuclideanGraphDensity n u z
          ∂upperEuclideanMeasure) := integral_const_mul
    _ = literalStageLocalizationDensityConstant Y *
        (∫ z in literalStageCutoffUpperSupport Y,
          fixedPhaseHyperbolicGraphDensity n u z
          ∂hyperbolicMeasure) := by
        rw [integral_euclideanGraphDensity_cutoffSupport_eq_hyperbolic]
    _ ≤ literalStageLocalizationDensityConstant Y *
        ((literalStageActiveTranslates Y).card *
          (selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2)) := by
        gcongr
        exact integral_cutoffSupport_hyperbolicGraphDensity_le Y n u

/-- The full explicit energy constant for planar localization. -/
noncomputable def literalStageLocalizationEnergyConstant
    (Y : ℝ) (n : ℤ) : ℝ :=
  literalStageLocalizationDensityConstant Y *
    ((literalStageActiveTranslates Y).card *
      selectedCuspTraceEnergyConstant n)

theorem literalStageLocalizationEnergyConstant_nonneg
    (Y : ℝ) (n : ℤ) :
    0 ≤ literalStageLocalizationEnergyConstant Y n := by
  unfold literalStageLocalizationEnergyConstant
  positivity

theorem integral_literalStageLocalizedPlanarDensity_le_energyConstant
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (∫ w : ℂ, literalStageLocalizedPlanarDensity Y n u w) ≤
      literalStageLocalizationEnergyConstant Y n * ‖coreMap n u‖ ^ 2 := by
  have h := integral_literalStageLocalizedPlanarDensity_le_coreMap Y n u
  unfold literalStageLocalizationEnergyConstant
  nlinarith

/-! #### The three genuine planar `L²` coordinates -/

theorem ambientTestCore_memLp_volume
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    MemLp (v : ℂ → ℂ) 2 (volume : Measure ℂ) := by
  apply (memLp_two_iff_integrable_sq_norm
    v.continuous.aestronglyMeasurable).2
  have hsupport :
      Function.support (fun w : ℂ ↦ ‖v w‖ ^ 2) ⊆
        tsupport (v : ℂ → ℂ) := by
    intro w hw
    by_contra hnot
    rw [image_eq_zero_of_notMem_tsupport hnot, norm_zero,
      zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hw
    exact hw rfl
  have hcompact : HasCompactSupport (fun w : ℂ ↦ ‖v w‖ ^ 2) :=
    v.hasCompactSupport.of_isClosed_subset isClosed_closure
      (closure_minimal hsupport v.hasCompactSupport.isClosed)
  exact (v.continuous.norm.pow 2).integrable_of_hasCompactSupport hcompact

/-- The squared pointwise norm of a compact test is integrable on the
ordinary plane.  Keeping this consequence separate prevents the three
coordinate estimates below from depending on the implementation of `MemLp`. -/
theorem ambientTestCore_normSq_integrable
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    Integrable (fun w : ℂ ↦ ‖v w‖ ^ 2) (volume : Measure ℂ) :=
  (memLp_two_iff_integrable_sq_norm
    v.continuous.aestronglyMeasurable).mp
      (ambientTestCore_memLp_volume v)

/-- Forget a compact upper-plane test to ordinary full-plane `L²`. -/
noncomputable def ambientTestCoreToPlaneL2Linear :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore →ₗ[ℂ] AmbientPlaneL2 where
  toFun v := (ambientTestCore_memLp_volume v).toLp (v : ℂ → ℂ)
  map_add' v w := by
    simpa only [add_apply] using
      MemLp.toLp_add (ambientTestCore_memLp_volume v)
        (ambientTestCore_memLp_volume w)
  map_smul' c v := by
    simpa only [smul_apply, smul_eq_mul] using
      MemLp.toLp_const_smul c (ambientTestCore_memLp_volume v)

theorem coeFn_ambientTestCoreToPlaneL2Linear
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ⇑(ambientTestCoreToPlaneL2Linear v) =ᵐ[(volume : Measure ℂ)]
      (v : ℂ → ℂ) :=
  MemLp.coeFn_toLp (ambientTestCore_memLp_volume v)

theorem ambientPlaneL2_norm_sq_eq_integral (F : AmbientPlaneL2) :
    ‖F‖ ^ 2 = ∫ w : ℂ, ‖F w‖ ^ 2 := by
  rw [← inner_self_eq_norm_sq, MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner F F)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun w ↦
    inner_self_eq_norm_sq (𝕜 := ℂ) (F w)

theorem norm_ambientTestCoreToPlaneL2Linear_sq
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖ambientTestCoreToPlaneL2Linear v‖ ^ 2 =
      ∫ w : ℂ, ‖v w‖ ^ 2 := by
  rw [ambientPlaneL2_norm_sq_eq_integral]
  apply integral_congr_ae
  filter_upwards [coeFn_ambientTestCoreToPlaneL2Linear v] with w hw
  rw [hw]

@[simp]
theorem literalStageLocalizedGauge_add
    (Y : ℝ) (n : ℤ) (u v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    literalStageLocalizedGauge Y n (u + v) =
      literalStageLocalizedGauge Y n u +
        literalStageLocalizedGauge Y n v := by
  apply TestFunction.ext
  intro w
  simp only [literalStageLocalizedGauge_apply, add_apply]
  have hg : fixedPhaseEuclideanGauge n (u + v) =
      fixedPhaseEuclideanGauge n u + fixedPhaseEuclideanGauge n v := by
    simp only [fixedPhaseEuclideanGauge, map_add, orbitEuclideanGauge_add]
  rw [hg]
  simp only [upperLift, Pi.add_apply]
  split_ifs <;> ring

@[simp]
theorem literalStageLocalizedGauge_smul
    (Y : ℝ) (n : ℤ) (c : ℂ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    literalStageLocalizedGauge Y n (c • u) =
      c • literalStageLocalizedGauge Y n u := by
  apply TestFunction.ext
  intro w
  simp only [literalStageLocalizedGauge_apply, smul_apply,
    smul_eq_mul]
  have hg : fixedPhaseEuclideanGauge n (c • u) =
      c • fixedPhaseEuclideanGauge n u := by
    simp only [fixedPhaseEuclideanGauge, map_smul,
      orbitEuclideanGauge_smul]
  rw [hg]
  simp only [upperLift, Pi.smul_apply, smul_eq_mul]
  split_ifs <;> ring

/-- Linear compact localization on the smooth fixed-phase graph core. -/
noncomputable def literalStageLocalizedGaugeLinear (Y : ℝ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ]
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore where
  toFun := literalStageLocalizedGauge Y n
  map_add' := literalStageLocalizedGauge_add Y n
  map_smul' := literalStageLocalizedGauge_smul Y n

/-- Base planar `L²` coordinate. -/
noncomputable def literalStagePlaneBaseCore (Y : ℝ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] AmbientPlaneL2 :=
  ambientTestCoreToPlaneL2Linear.comp
    (literalStageLocalizedGaugeLinear Y n)

/-- Horizontal-derivative planar `L²` coordinate. -/
noncomputable def literalStagePlaneDxCore (Y : ℝ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] AmbientPlaneL2 :=
  ambientTestCoreToPlaneL2Linear.comp
    ((TestFunction.lineDerivCLM ℂ (1 : ℂ)).toLinearMap.comp
      (literalStageLocalizedGaugeLinear Y n))

/-- Vertical-derivative planar `L²` coordinate. -/
noncomputable def literalStagePlaneDyCore (Y : ℝ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] AmbientPlaneL2 :=
  ambientTestCoreToPlaneL2Linear.comp
    ((TestFunction.lineDerivCLM ℂ Complex.I).toLinearMap.comp
      (literalStageLocalizedGaugeLinear Y n))

@[simp]
theorem literalStagePlaneBaseCore_apply
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    literalStagePlaneBaseCore Y n u =
      ambientTestCoreToPlaneL2Linear (literalStageLocalizedGauge Y n u) :=
  rfl

@[simp]
theorem literalStagePlaneDxCore_apply
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    literalStagePlaneDxCore Y n u =
      ambientTestCoreToPlaneL2Linear
        (HalfWeightCompactCoordinateGreen.dx
          (literalStageLocalizedGauge Y n u)) :=
