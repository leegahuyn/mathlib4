/-!
## P4.2: simultaneous intrinsic localization of both weak derivatives

The same intrinsic cutoff localizes the base coordinate and both maximal
adjoint coordinates.  The raising and lowering commutator errors use the one
uniform derivative bound proved above.  Hence there is one sequence of
compact-carrier triples, with a common cutoff index, converging in all three
Petersson coordinates at once.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseIntrinsicJointLocalization

open Set Function Topology Filter MeasureTheory
open scoped LinearPMap
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseDensity
open FixedPhaseClosedOperators
open FixedPhaseAdjointCutoffCore
open FixedPhaseIntrinsicAdjointCutoff
open IndependentWeightedWeakSobolev

/-- One common intrinsic cutoff applied to a weak base coordinate and its two
maximal weak derivatives, including the exact signed commutator terms. -/
noncomputable def intrinsicJointCutoffTriple
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n) :
    WeakCoordinateAmbient n :=
  WithLp.toLp 2
    (intrinsicPeterssonCuspCutoff j (n + 1) (baseProjection n x),
      WithLp.toLp 2
        (intrinsicPeterssonCuspCutoff j ((n + 1) + 1)
              (raiseProjection n x) +
            intrinsicRaisePeterssonCommutator j (n + 1)
              (baseProjection n x),
          intrinsicPeterssonCuspCutoff j n (lowerProjection n x) +
            intrinsicLowerFromSuccPeterssonCommutator j n
              (baseProjection n x)))

@[simp]
theorem baseProjection_intrinsicJointCutoffTriple
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n) :
    baseProjection n (intrinsicJointCutoffTriple j n x) =
      intrinsicPeterssonCuspCutoff j (n + 1) (baseProjection n x) :=
  rfl

@[simp]
theorem raiseProjection_intrinsicJointCutoffTriple
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n) :
    raiseProjection n (intrinsicJointCutoffTriple j n x) =
      intrinsicPeterssonCuspCutoff j ((n + 1) + 1)
          (raiseProjection n x) +
        intrinsicRaisePeterssonCommutator j (n + 1)
          (baseProjection n x) :=
  rfl

@[simp]
theorem lowerProjection_intrinsicJointCutoffTriple
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n) :
    lowerProjection n (intrinsicJointCutoffTriple j n x) =
      intrinsicPeterssonCuspCutoff j n (lowerProjection n x) +
        intrinsicLowerFromSuccPeterssonCommutator j n
          (baseProjection n x) :=
  rfl

/-- All three coordinates of a localized triple have compact carrier
support. -/
def HasJointCompactCarrierSupport (n : ℤ)
    (x : WeakCoordinateAmbient n) : Prop :=
  HasCompactCarrierSupport (n + 1) (baseProjection n x) ∧
    HasCompactCarrierSupport ((n + 1) + 1) (raiseProjection n x) ∧
      HasCompactCarrierSupport n (lowerProjection n x)

theorem intrinsicJointCutoffTriple_hasJointCompactCarrierSupport
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n) :
    HasJointCompactCarrierSupport n (intrinsicJointCutoffTriple j n x) := by
  refine ⟨
    intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
      j (n + 1) (baseProjection n x), ?_, ?_⟩
  · exact (intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
      j ((n + 1) + 1) (raiseProjection n x)).add
        (intrinsicRaisePeterssonCommutator_hasCompactCarrierSupport
          j (n + 1) (baseProjection n x))
  · exact (intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
      j n (lowerProjection n x)).add
        (intrinsicLowerFromSuccPeterssonCommutator_hasCompactCarrierSupport
          j n (baseProjection n x))

/-- The explicit common-cutoff triple remains in both opposite maximal
adjoint graphs. -/
theorem intrinsicJointCutoffTriple_mem_weightedWeakSubmodule
    (j : ℕ) (n : ℤ) (x : WeakCoordinateAmbient n)
    (hx : x ∈ weightedWeakSubmodule n) :
    intrinsicJointCutoffTriple j n x ∈ weightedWeakSubmodule n := by
  rw [mem_weightedWeakSubmodule_iff_maximalAdjointGraphs] at hx ⊢
  constructor
  · rcases (LinearPMap.mem_graph_iff
      ((-physicalLowerFromSucc (n + 1))†)).mp hx.1 with
      ⟨y, hyBase, hyValue⟩
    have hLocalized := adjoint_graph_mem_of_bounded_cutoff_commutator
      (-physicalLowerFromSucc (n + 1))
      (negativePhysicalLowerFromSucc_dense_domain (n + 1))
      (intrinsicPeterssonCuspCutoff j ((n + 1) + 1))
      (intrinsicPeterssonCuspCutoff j (n + 1))
      (intrinsicLowerFromSuccPeterssonCommutator j (n + 1))
      (fun q ↦
        adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange
          j ((n + 1) + 1) q)
      (fun q ↦
        negativePhysicalLowerFromSucc_intrinsicCutoff_commutator
          j (n + 1) q) y
    simpa only [baseProjection_intrinsicJointCutoffTriple,
      raiseProjection_intrinsicJointCutoffTriple, hyBase, hyValue,
      adjoint_intrinsicLowerFromSuccPeterssonCommutator] using hLocalized
  · rcases (LinearPMap.mem_graph_iff ((-physicalRaise n)†)).mp hx.2 with
      ⟨y, hyBase, hyValue⟩
    have hLocalized := adjoint_graph_mem_of_bounded_cutoff_commutator
      (-physicalRaise n) (negativePhysicalRaise_dense_domain n)
      (intrinsicPeterssonCuspCutoff j n)
      (intrinsicPeterssonCuspCutoff j (n + 1))
      (intrinsicRaisePeterssonCommutator j n)
      (fun q ↦
        adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange j n q)
      (fun q ↦ negativePhysicalRaise_intrinsicCutoff_commutator j n q) y
    simpa only [baseProjection_intrinsicJointCutoffTriple,
      lowerProjection_intrinsicJointCutoffTriple, hyBase, hyValue,
      adjoint_intrinsicRaisePeterssonCommutator] using hLocalized

theorem baseProjection_intrinsicJointCutoffTriple_tendsto
    (n : ℤ) (x : WeakCoordinateAmbient n) :
    Filter.Tendsto
      (fun j ↦ baseProjection n (intrinsicJointCutoffTriple j n x))
      Filter.atTop (nhds (baseProjection n x)) := by
  simpa only [baseProjection_intrinsicJointCutoffTriple] using
    intrinsicPeterssonCuspCutoff_tendsto_id (n + 1) (baseProjection n x)

theorem raiseProjection_intrinsicJointCutoffTriple_tendsto
    (n : ℤ) (x : WeakCoordinateAmbient n) :
    Filter.Tendsto
      (fun j ↦ raiseProjection n (intrinsicJointCutoffTriple j n x))
      Filter.atTop (nhds (raiseProjection n x)) := by
  simpa only [raiseProjection_intrinsicJointCutoffTriple, add_zero] using
    (intrinsicPeterssonCuspCutoff_tendsto_id ((n + 1) + 1)
      (raiseProjection n x)).add
        (intrinsicRaisePeterssonCommutator_tendsto_zero
          (n + 1) (baseProjection n x))

theorem lowerProjection_intrinsicJointCutoffTriple_tendsto
    (n : ℤ) (x : WeakCoordinateAmbient n) :
    Filter.Tendsto
      (fun j ↦ lowerProjection n (intrinsicJointCutoffTriple j n x))
      Filter.atTop (nhds (lowerProjection n x)) := by
  simpa only [lowerProjection_intrinsicJointCutoffTriple, add_zero] using
    (intrinsicPeterssonCuspCutoff_tendsto_id n
      (lowerProjection n x)).add
        (intrinsicLowerFromSuccPeterssonCommutator_tendsto_zero
          n (baseProjection n x))

/-- Joint convergence in the actual three-coordinate Hilbert norm. -/
theorem intrinsicJointCutoffTriple_tendsto
    (n : ℤ) (x : WeakCoordinateAmbient n) :
    Filter.Tendsto (fun j ↦ intrinsicJointCutoffTriple j n x)
      Filter.atTop (nhds x) := by
  have hBase := baseProjection_intrinsicJointCutoffTriple_tendsto n x
  have hRaise := raiseProjection_intrinsicJointCutoffTriple_tendsto n x
  have hLower := lowerProjection_intrinsicJointCutoffTriple_tendsto n x
  simpa only [intrinsicJointCutoffTriple, baseProjection_apply,
    raiseProjection_apply, lowerProjection_apply] using
      hBase.prodMk_nhds (hRaise.prodMk_nhds hLower)

/-- A named simultaneous localization predicate for the independent weak
Sobolev space. -/
def HasSequentialIntrinsicJointLocalizationAt (n : ℤ) : Prop :=
  ∀ x : WeightedWeakSobolev n,
    ∃ q : ℕ → WeightedWeakSobolev n,
      (∀ j, HasJointCompactCarrierSupport n
        (q j : WeakCoordinateAmbient n)) ∧
      Filter.Tendsto q Filter.atTop (nhds x)

/-- Unconditional simultaneous localization.  There is one cutoff index in
all three coordinates; no diagonal extraction is used. -/
theorem hasSequentialIntrinsicJointLocalizationAt_unconditional
    (n : ℤ) :
    HasSequentialIntrinsicJointLocalizationAt n := by
  intro x
  let q : ℕ → WeightedWeakSobolev n := fun j ↦
    ⟨intrinsicJointCutoffTriple j n (x : WeakCoordinateAmbient n),
      intrinsicJointCutoffTriple_mem_weightedWeakSubmodule
        j n (x : WeakCoordinateAmbient n) x.property⟩
  refine ⟨q, ?_, ?_⟩
  · intro j
    exact intrinsicJointCutoffTriple_hasJointCompactCarrierSupport
      j n (x : WeakCoordinateAmbient n)
  · rw [tendsto_subtype_rng]
    exact intrinsicJointCutoffTriple_tendsto n
      (x : WeakCoordinateAmbient n)

/-- Expanded common-stage form: all three coordinate errors are eventually
smaller than the same positive tolerance. -/
theorem intrinsicJointCutoffTriple_eventually_three_dist_lt
    (n : ℤ) (x : WeakCoordinateAmbient n) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ j : ℕ in Filter.atTop,
      dist (baseProjection n (intrinsicJointCutoffTriple j n x))
          (baseProjection n x) < eps ∧
        dist (raiseProjection n (intrinsicJointCutoffTriple j n x))
          (raiseProjection n x) < eps ∧
        dist (lowerProjection n (intrinsicJointCutoffTriple j n x))
          (lowerProjection n x) < eps := by
  filter_upwards [
    (baseProjection_intrinsicJointCutoffTriple_tendsto n x)
      (Metric.ball_mem_nhds _ heps),
    (raiseProjection_intrinsicJointCutoffTriple_tendsto n x)
      (Metric.ball_mem_nhds _ heps),
    (lowerProjection_intrinsicJointCutoffTriple_tendsto n x)
      (Metric.ball_mem_nhds _ heps)] with j hBase hRaise hLower
  simpa only [Metric.mem_ball] using ⟨hBase, hRaise, hLower⟩

end FixedPhaseIntrinsicJointLocalization

namespace AxiomAuditP4IntrinsicJointLocalization

