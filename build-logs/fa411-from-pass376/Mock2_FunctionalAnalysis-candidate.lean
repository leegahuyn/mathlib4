/-- Square-root norm bound shared by all three planar coordinates. -/
noncomputable def literalStageLocalizationConstant
    (Y : ℝ) (n : ℤ) : ℝ :=
  Real.sqrt (literalStageLocalizationEnergyConstant Y n)

theorem literalStageLocalizationConstant_nonneg (Y : ℝ) (n : ℤ) :
    0 ≤ literalStageLocalizationConstant Y n := Real.sqrt_nonneg _

theorem literalStageLocalizationConstant_sq (Y : ℝ) (n : ℤ) :
    literalStageLocalizationConstant Y n ^ 2 =
      literalStageLocalizationEnergyConstant Y n :=
  Real.sq_sqrt (literalStageLocalizationEnergyConstant_nonneg Y n)

theorem norm_literalStagePlaneBaseCore_le
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖literalStagePlaneBaseCore Y n u‖ ≤
      literalStageLocalizationConstant Y n * ‖coreMap n u‖ := by
  apply (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg (literalStageLocalizationConstant_nonneg Y n)
      (norm_nonneg _))).mp
  rw [mul_pow, literalStageLocalizationConstant_sq]
  exact norm_literalStagePlaneBaseCore_sq_le_energy Y n u

theorem norm_literalStagePlaneDxCore_le
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖literalStagePlaneDxCore Y n u‖ ≤
      literalStageLocalizationConstant Y n * ‖coreMap n u‖ := by
  apply (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg (literalStageLocalizationConstant_nonneg Y n)
      (norm_nonneg _))).mp
  rw [mul_pow, literalStageLocalizationConstant_sq]
  exact norm_literalStagePlaneDxCore_sq_le_energy Y n u

theorem norm_literalStagePlaneDyCore_le
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖literalStagePlaneDyCore Y n u‖ ≤
      literalStageLocalizationConstant Y n * ‖coreMap n u‖ := by
  apply (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg (literalStageLocalizationConstant_nonneg Y n)
      (norm_nonneg _))).mp
  rw [mul_pow, literalStageLocalizationConstant_sq]
  exact norm_literalStagePlaneDyCore_sq_le_energy Y n u

/-- Completion extensions of the actual localized base and two derivatives. -/
noncomputable def completedLiteralStagePlaneBase (Y : ℝ) (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] AmbientPlaneL2 :=
  (literalStagePlaneBaseCore Y n).extendOfNorm (coreMap n)

noncomputable def completedLiteralStagePlaneDx (Y : ℝ) (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] AmbientPlaneL2 :=
  (literalStagePlaneDxCore Y n).extendOfNorm (coreMap n)

noncomputable def completedLiteralStagePlaneDy (Y : ℝ) (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] AmbientPlaneL2 :=
  (literalStagePlaneDyCore Y n).extendOfNorm (coreMap n)

@[simp]
theorem completedLiteralStagePlaneBase_core
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    completedLiteralStagePlaneBase Y n (coreMap n u) =
      literalStagePlaneBaseCore Y n u :=
  LinearMap.extendOfNorm_eq (denseRange_coreMap n)
    ⟨literalStageLocalizationConstant Y n,
      norm_literalStagePlaneBaseCore_le Y n⟩ u

@[simp]
theorem completedLiteralStagePlaneDx_core
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    completedLiteralStagePlaneDx Y n (coreMap n u) =
      literalStagePlaneDxCore Y n u :=
  LinearMap.extendOfNorm_eq (denseRange_coreMap n)
    ⟨literalStageLocalizationConstant Y n,
      norm_literalStagePlaneDxCore_le Y n⟩ u

@[simp]
theorem completedLiteralStagePlaneDy_core
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    completedLiteralStagePlaneDy Y n (coreMap n u) =
      literalStagePlaneDyCore Y n u :=
  LinearMap.extendOfNorm_eq (denseRange_coreMap n)
    ⟨literalStageLocalizationConstant Y n,
      norm_literalStagePlaneDyCore_le Y n⟩ u

/-! #### A fixed rectangle and its genuine Fourier modes

The following rectangle is chosen from the compact support of `χ_Y`.  Its
side length is four times a positive support radius.  Consequently every
localized gauge is supported in the *interior half* of the rectangle.  This
strict buffer is what makes the half-open fundamental-box representative
periodic without a boundary term. -/

theorem exists_literalStageFourierRadius (Y : ℝ) :
    ∃ R : ℝ, 0 < R ∧
      tsupport (literalStageCutoff Y : ℂ → ℂ) ⊆ Metric.ball 0 R := by
  obtain ⟨R₀, hR₀⟩ :=
    (Metric.isBounded_iff_subset_ball (0 : ℂ)).mp
      (literalStageCutoff Y).hasCompactSupport.isBounded
  refine ⟨max 1 R₀, lt_of_lt_of_le zero_lt_one (le_max_left _ _), ?_⟩
  exact hR₀.trans (Metric.ball_subset_ball (le_max_right _ _))

/-- Positive radius containing the support of the paired-side-safe cutoff. -/
noncomputable def literalStageFourierRadius (Y : ℝ) : ℝ :=
  Classical.choose (exists_literalStageFourierRadius Y)

theorem literalStageFourierRadius_pos (Y : ℝ) :
    0 < literalStageFourierRadius Y :=
  (Classical.choose_spec (exists_literalStageFourierRadius Y)).1

theorem tsupport_literalStageCutoff_subset_fourierBall (Y : ℝ) :
    tsupport (literalStageCutoff Y : ℂ → ℂ) ⊆
      Metric.ball 0 (literalStageFourierRadius Y) :=
  (Classical.choose_spec (exists_literalStageFourierRadius Y)).2

/-- Side length of the Fourier rectangle. -/
noncomputable def literalStageFourierScale (Y : ℝ) : ℝ :=
  4 * literalStageFourierRadius Y

theorem literalStageFourierScale_pos (Y : ℝ) :
    0 < literalStageFourierScale Y := by
  unfold literalStageFourierScale
  positivity

theorem literalStageFourierScale_ne_zero (Y : ℝ) :
    literalStageFourierScale Y ≠ 0 :=
  (literalStageFourierScale_pos Y).ne'

/-- Half-open physical fundamental rectangle.  The half-open convention is
the one used by `UnitAddTorus.measurableEquivPiIoc`. -/
def literalStageFourierBox (Y : ℝ) : Set ℂ :=
  {w | ∀ i : Fin 2,
    Complex.measurableEquivPi w i ∈
      Set.Ioc (-(literalStageFourierScale Y / 2))
        (literalStageFourierScale Y / 2)}

theorem literalStageFourierBox_measurableSet (Y : ℝ) :
    MeasurableSet (literalStageFourierBox Y) := by
  unfold literalStageFourierBox
  exact MeasurableSet.iInter fun i ↦
    measurableSet_Ioc.preimage
      ((measurable_pi_apply i).comp
        Complex.measurableEquivPi.measurable)

/-- Closed rectangle used only for compact-support bookkeeping. -/
def literalStageFourierClosedBox (Y : ℝ) : Set ℂ :=
  {w | ∀ i : Fin 2,
    Complex.measurableEquivPi w i ∈
      Set.Icc (-(literalStageFourierScale Y / 2))
        (literalStageFourierScale Y / 2)}

theorem literalStageFourierClosedBox_isCompact (Y : ℝ) :
    IsCompact (literalStageFourierClosedBox Y) := by
  rw [show literalStageFourierClosedBox Y =
      Complex.measurableEquivPi.symm ''
        Set.pi Set.univ (fun _ : Fin 2 ↦
          Set.Icc (-(literalStageFourierScale Y / 2))
            (literalStageFourierScale Y / 2)) by
    ext w
    simp only [literalStageFourierClosedBox, Set.mem_setOf_eq,
      Set.mem_image, Set.mem_pi, Set.mem_univ, forall_const]
    constructor
    · intro hw
      exact ⟨Complex.measurableEquivPi w, hw,
        Complex.measurableEquivPi.symm_apply_apply w⟩
    · rintro ⟨x, hx, rfl⟩
      simpa using hx]
  exact (isCompact_univ_pi fun _ : Fin 2 ↦ isCompact_Icc).image
    (by
      change Continuous (fun x : Fin 2 → ℝ ↦ x 0 + x 1 * Complex.I)
      fun_prop)

theorem literalStageFourierBox_subset_closedBox (Y : ℝ) :
    literalStageFourierBox Y ⊆ literalStageFourierClosedBox Y := by
  intro w hw i
  exact Set.Ioc_subset_Icc_self (hw i)

/-- The support buffer is strict: it lies in the physical Fourier box. -/
theorem tsupport_literalStageCutoff_subset_fourierBox (Y : ℝ) :
    tsupport (literalStageCutoff Y : ℂ → ℂ) ⊆
      literalStageFourierBox Y := by
  intro w hw i
  have hnorm : ‖w‖ < literalStageFourierRadius Y := by
    simpa only [Metric.mem_ball, dist_zero_right] using
      tsupport_literalStageCutoff_subset_fourierBall Y hw
  have hcoord : |Complex.measurableEquivPi w i| ≤ ‖w‖ := by
    fin_cases i
    · simpa only [Complex.measurableEquivPi_apply,
        Matrix.cons_val_zero] using Complex.abs_re_le_norm w
    · simpa only [Complex.measurableEquivPi_apply,
        Matrix.cons_val_one, Matrix.head_cons] using
        Complex.abs_im_le_norm w
  have hhalf : literalStageFourierRadius Y <
      literalStageFourierScale Y / 2 := by
    unfold literalStageFourierScale
    linarith [literalStageFourierRadius_pos Y]
  exact Set.mem_Ioc.mpr ⟨
    (neg_lt_of_abs_lt (hcoord.trans_lt (hnorm.trans hhalf))),
    (le_of_lt (lt_of_abs_lt (hcoord.trans_lt (hnorm.trans hhalf))))⟩

theorem tsupport_literalStageLocalizedGauge_subset_fourierBox
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    tsupport (literalStageLocalizedGauge Y n u : ℂ → ℂ) ⊆
      literalStageFourierBox Y :=
  (tsupport_literalStageLocalizedGauge_subset_cutoff Y n u).trans
    (tsupport_literalStageCutoff_subset_fourierBox Y)

/-! #### Finite frequency rectangles -/

/-- The literal square of frequencies `|k₀|,|k₁| ≤ N`. -/
noncomputable def literalStageFourierModes (N : ℕ) :
    Finset (Fin 2 → ℤ) := by
  classical
  exact Finset.univ.pi fun _ : Fin 2 ↦
    Finset.Icc (-(N : ℤ)) (N : ℤ)

@[simp]
theorem mem_literalStageFourierModes_iff (N : ℕ) (k : Fin 2 → ℤ) :
    k ∈ literalStageFourierModes N ↔
      ∀ i : Fin 2, |k i| ≤ (N : ℤ) := by
  classical
  simp only [literalStageFourierModes, Finset.mem_pi, Finset.mem_univ,
    true_implies, Finset.mem_Icc, neg_le]
  exact forall_congr' fun i ↦ abs_le

theorem exists_large_coordinate_of_not_mem_literalStageFourierModes
    (N : ℕ) (k : Fin 2 → ℤ)
    (hk : k ∉ literalStageFourierModes N) :
    (N : ℤ) + 1 ≤ |k 0| ∨ (N : ℤ) + 1 ≤ |k 1| := by
  rw [mem_literalStageFourierModes_iff, not_forall] at hk
  obtain ⟨i, hi⟩ := hk
  fin_cases i
  · exact Or.inl (Int.add_one_le_iff.mpr (lt_of_not_ge hi))
  · exact Or.inr (Int.add_one_le_iff.mpr (lt_of_not_ge hi))

/-! #### A Hilbert-basis tail inequality with both derivative coordinates -/

namespace RectangleFourierTail

variable {I E : Type*}
variable [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

theorem repr_finiteHilbertProjection_sub_apply
    (b : HilbertBasis I ℂ E) (s : Finset I) (f : E) (i : I) :
    b.repr (P5LocalFourierRellich.finiteHilbertProjection b s f - f) i =
      if i ∈ s then 0 else -b.repr f i := by
  classical
  by_cases hi : i ∈ s <;>
    simp [P5LocalFourierRellich.finiteHilbertProjection_apply,
      map_sub, map_sum, map_smul, b.repr_self, lp.single_apply, hi]

/-- Parseval plus a pointwise coefficient estimate.  This is the exact
two-derivative inequality used below; it contains no compactness premise. -/
theorem finiteHilbertProjection_tail_le_of_coeff_sq
    (b : HilbertBasis I ℂ E) (s : Finset I)
    (f g₀ g₁ : E) (delta : ℝ) (hdelta : 0 ≤ delta)
    (hcoeff : ∀ i ∉ s,
      ‖b.repr f i‖ ^ 2 ≤ delta ^ 2 *
        (‖b.repr g₀ i‖ ^ 2 + ‖b.repr g₁ i‖ ^ 2)) :
    ‖P5LocalFourierRellich.finiteHilbertProjection b s f - f‖ ≤
      delta * Real.sqrt (‖g₀‖ ^ 2 + ‖g₁‖ ^ 2) := by
  rw [← b.repr.norm_map
    (P5LocalFourierRellich.finiteHilbertProjection b s f - f)]
  apply lp.norm_le_of_forall_sum_le (by norm_num)
    (mul_nonneg hdelta (Real.sqrt_nonneg _))
  intro t
  have hsum₀ := lp.sum_rpow_le_norm_rpow (p := (2 : ℝ≥0∞))
    (by norm_num) (b.repr g₀) t
  have hsum₁ := lp.sum_rpow_le_norm_rpow (p := (2 : ℝ≥0∞))
    (by norm_num) (b.repr g₁) t
  simp only [ENNReal.toReal_ofNat, Real.rpow_two] at hsum₀ hsum₁ ⊢
  calc
    ∑ i ∈ t,
        ‖b.repr
          (P5LocalFourierRellich.finiteHilbertProjection b s f - f) i‖ ^ 2 ≤
        ∑ i ∈ t, delta ^ 2 *
          (‖b.repr g₀ i‖ ^ 2 + ‖b.repr g₁ i‖ ^ 2) := by
      gcongr with i hi
      rw [repr_finiteHilbertProjection_sub_apply]
      by_cases his : i ∈ s
      · simp [his, hdelta]
      · simpa only [his, if_false, norm_neg] using hcoeff i his
    _ = delta ^ 2 *
        ((∑ i ∈ t, ‖b.repr g₀ i‖ ^ 2) +
          ∑ i ∈ t, ‖b.repr g₁ i‖ ^ 2) := by
      rw [Finset.mul_sum]
      congr 1
      rw [← Finset.sum_add_distrib]
      congr 1
      ext i
      ring
    _ ≤ delta ^ 2 * (‖g₀‖ ^ 2 + ‖g₁‖ ^ 2) := by
      gcongr
      exact add_le_add hsum₀ hsum₁
    _ = (delta * Real.sqrt (‖g₀‖ ^ 2 + ‖g₁‖ ^ 2)) ^ 2 := by
      rw [mul_pow, Real.sq_sqrt]
      positivity

end RectangleFourierTail

/-! #### The scaled compact test on the actual two-torus -/

/-- The standard half-open unit box used by the multi-circle Fourier API. -/
def literalStageUnitPiBox : Set (Fin 2 → ℝ) :=
  {x | ∀ i : Fin 2, x i ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)}

theorem literalStageUnitPiBox_measurableSet :
    MeasurableSet literalStageUnitPiBox := by
  exact MeasurableSet.univ_pi' fun _ : Fin 2 ↦ measurableSet_Ioc

/-- Measurable fundamental representative of a two-torus point. -/
noncomputable def literalStageTorusCoordinate
    (t : P5LocalFourierRellich.TwoTorus) : Fin 2 → ℝ :=
  (UnitAddTorus.measurableEquivPiIoc
    (fun _ : Fin 2 ↦ -(1 / 2 : ℝ)) t).1

theorem literalStageTorusCoordinate_measurable :
    Measurable literalStageTorusCoordinate :=
  measurable_subtype_coe.comp
    (UnitAddTorus.measurableEquivPiIoc
      (fun _ : Fin 2 ↦ -(1 / 2 : ℝ))).measurable

/-- Rescale the unit Fourier box to the physical rectangle. -/
noncomputable def literalStageTorusPoint (Y : ℝ)
    (t : P5LocalFourierRellich.TwoTorus) : ℂ :=
  literalStageFourierScale Y •
    Complex.measurableEquivPi.symm (literalStageTorusCoordinate t)

theorem literalStageTorusPoint_measurable (Y : ℝ) :
    Measurable (literalStageTorusPoint Y) := by
  unfold literalStageTorusPoint
  exact (Complex.measurableEquivPi.symm.measurable.comp
    literalStageTorusCoordinate_measurable).const_smul _

/-- Pull an actual compact plane test back to the genuine two-torus. -/
noncomputable def literalStageTorusRepresentative
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    P5LocalFourierRellich.TwoTorus → ℂ :=
  fun t ↦ v (literalStageTorusPoint Y t)

theorem literalStageTorusRepresentative_aestronglyMeasurable
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    AEStronglyMeasurable (literalStageTorusRepresentative Y v)
      (volume : Measure P5LocalFourierRellich.TwoTorus) :=
  (v.continuous.measurable.comp
    (literalStageTorusPoint_measurable Y)).aestronglyMeasurable

theorem literalStageTorusRepresentative_memLp
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    MemLp (literalStageTorusRepresentative Y v) 2
      (volume : Measure P5LocalFourierRellich.TwoTorus) := by
  obtain ⟨C, hC⟩ :=
    v.hasCompactSupport.exists_bound_of_continuous v.continuous
  exact MemLp.of_bound
    (literalStageTorusRepresentative_aestronglyMeasurable Y v) C
    (Filter.Eventually.of_forall fun t ↦ hC (literalStageTorusPoint Y t))

/-- The scaled plane test as an honest member of torus `L²`. -/
noncomputable def literalStageTorusTest
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    P5LocalFourierRellich.TwoTorusL2 :=
  (literalStageTorusRepresentative_memLp Y v).toLp
    (literalStageTorusRepresentative Y v)

theorem coeFn_literalStageTorusTest
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ⇑(literalStageTorusTest Y v) =ᵐ[
        (volume : Measure P5LocalFourierRellich.TwoTorus)]
      literalStageTorusRepresentative Y v :=
  MemLp.coeFn_toLp (literalStageTorusRepresentative_memLp Y v)

@[simp]
theorem literalStageTorusTest_add
    (Y : ℝ) (v w : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    literalStageTorusTest Y (v + w) =
      literalStageTorusTest Y v + literalStageTorusTest Y w := by
  apply Lp.ext fun t ↦ ?_
  filter_upwards [coeFn_literalStageTorusTest Y (v + w),
    coeFn_literalStageTorusTest Y v,
    coeFn_literalStageTorusTest Y w,
    Lp.coeFn_add (literalStageTorusTest Y v)
      (literalStageTorusTest Y w)] with t ht hv hw hadd
  simp only [ht, hv, hw, hadd, literalStageTorusRepresentative,
    add_apply]

@[simp]
theorem literalStageTorusTest_smul
    (Y : ℝ) (c : ℂ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    literalStageTorusTest Y (c • v) = c • literalStageTorusTest Y v := by
  apply Lp.ext fun t ↦ ?_
  filter_upwards [coeFn_literalStageTorusTest Y (c • v),
    coeFn_literalStageTorusTest Y v,
    Lp.coeFn_smul c (literalStageTorusTest Y v)] with t ht hv hsmul
  simp only [ht, hv, hsmul, literalStageTorusRepresentative,
    smul_apply, Pi.smul_apply, smul_eq_mul]

/-- `L²` norm formula on the genuine two-torus. -/
theorem twoTorusL2_norm_sq_eq_integral
    (F : P5LocalFourierRellich.TwoTorusL2) :
    ‖F‖ ^ 2 = ∫ t, ‖F t‖ ^ 2 := by
  rw [← inner_self_eq_norm_sq, MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner F F)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun t ↦
    inner_self_eq_norm_sq (𝕜 := ℂ) (F t)

/-- Exact torus-to-box integral for the scaled representative. -/
theorem integral_literalStageTorusRepresentative_normSq_eq_box
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    (∫ t : P5LocalFourierRellich.TwoTorus,
        ‖literalStageTorusRepresentative Y v t‖ ^ 2) =
      ∫ x in literalStageUnitPiBox,
        ‖v (literalStageFourierScale Y •
          Complex.measurableEquivPi.symm x)‖ ^ 2 := by
  rw [UnitAddTorus.integral_preimage
    (fun t : P5LocalFourierRellich.TwoTorus ↦
      ‖literalStageTorusRepresentative Y v t‖ ^ 2)
    (fun _ : Fin 2 ↦ -(1 / 2 : ℝ))]
  congr 1
  ext x
  simp only [literalStageUnitPiBox, literalStageTorusRepresentative,
    literalStageTorusPoint, literalStageTorusCoordinate]
  congr 3
  apply congrArg Complex.measurableEquivPi.symm
  funext i
  rw [UnitAddTorus.coe_measurableEquivPiIoc_apply]
  exact congrArg Subtype.val
    (AddCircle.equivIoc_coe_eq (by simpa using x.2 i))

/-- Scaling and restriction of a nonnegative integrable plane density give
the required torus norm bound. -/
theorem norm_literalStageTorusTest_sq_le_plane
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖literalStageTorusTest Y v‖ ^ 2 ≤
      (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w : ℂ, ‖v w‖ ^ 2 := by
  rw [twoTorusL2_norm_sq_eq_integral]
  calc
    (∫ t, ‖literalStageTorusTest Y v t‖ ^ 2) =
        ∫ t, ‖literalStageTorusRepresentative Y v t‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards [coeFn_literalStageTorusTest Y v] with t ht
      rw [ht]
    _ = ∫ x in literalStageUnitPiBox,
        ‖v (literalStageFourierScale Y •
          Complex.measurableEquivPi.symm x)‖ ^ 2 :=
      integral_literalStageTorusRepresentative_normSq_eq_box Y v
    _ = ∫ w in Complex.measurableEquivPi.symm '' literalStageUnitPiBox,
        ‖v (literalStageFourierScale Y • w)‖ ^ 2 := by
      symm
      exact Complex.volume_preserving_equiv_pi.symm.setIntegral_image_emb
        Complex.measurableEquivPi.symm.measurableEmbedding
        (fun w : ℂ ↦ ‖v (literalStageFourierScale Y • w)‖ ^ 2)
        literalStageUnitPiBox
    _ = (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w in literalStageFourierScale Y •
            (Complex.measurableEquivPi.symm '' literalStageUnitPiBox),
          ‖v w‖ ^ 2 := by
      rw [Measure.setIntegral_comp_smul_of_pos volume
        (fun w : ℂ ↦ ‖v w‖ ^ 2)
        (Complex.measurableEquivPi.symm '' literalStageUnitPiBox)
        (literalStageFourierScale_pos Y)]
      simp only [Module.finrank_complex_real, zpow_neg, zpow_ofNat]
    _ ≤ (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w : ℂ, ‖v w‖ ^ 2 := by
      gcongr
      exact MeasureTheory.setIntegral_le_integral
        (ambientTestCore_normSq_integrable v)
        (Filter.Eventually.of_forall fun w ↦ sq_nonneg ‖v w‖)

/-- Before discarding the complement of the physical rectangle, the change
of variables is an equality.  This is the exact Jacobian statement used in
the Fourier remainder comparison below. -/
theorem norm_literalStageTorusTest_sq_eq_scale_inv_sq_mul_scaledBox
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖literalStageTorusTest Y v‖ ^ 2 =
      (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w in literalStageFourierScale Y •
            (Complex.measurableEquivPi.symm '' literalStageUnitPiBox),
          ‖v w‖ ^ 2 := by
  rw [twoTorusL2_norm_sq_eq_integral]
  calc
    (∫ t, ‖literalStageTorusTest Y v t‖ ^ 2) =
        ∫ t, ‖literalStageTorusRepresentative Y v t‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards [coeFn_literalStageTorusTest Y v] with t ht
      rw [ht]
    _ = ∫ x in literalStageUnitPiBox,
        ‖v (literalStageFourierScale Y •
          Complex.measurableEquivPi.symm x)‖ ^ 2 :=
      integral_literalStageTorusRepresentative_normSq_eq_box Y v
    _ = ∫ w in Complex.measurableEquivPi.symm '' literalStageUnitPiBox,
        ‖v (literalStageFourierScale Y • w)‖ ^ 2 := by
      symm
      exact Complex.volume_preserving_equiv_pi.symm.setIntegral_image_emb
        Complex.measurableEquivPi.symm.measurableEmbedding
        (fun w : ℂ ↦ ‖v (literalStageFourierScale Y • w)‖ ^ 2)
        literalStageUnitPiBox
    _ = (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w in literalStageFourierScale Y •
            (Complex.measurableEquivPi.symm '' literalStageUnitPiBox),
          ‖v w‖ ^ 2 := by
      rw [Measure.setIntegral_comp_smul_of_pos volume
        (fun w : ℂ ↦ ‖v w‖ ^ 2)
        (Complex.measurableEquivPi.symm '' literalStageUnitPiBox)
        (literalStageFourierScale_pos Y)]
      simp only [Module.finrank_complex_real, zpow_neg, zpow_ofNat]

/-- A compact test supported in the Fourier rectangle has no mass outside
that rectangle.  The statement is kept at the level of the actual integral,
so no representative of an abstract `L²` class is chosen. -/
theorem integral_normSq_eq_setIntegral_fourierBox_of_tsupport_subset
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    (∫ w : ℂ, ‖v w‖ ^ 2) =
      ∫ w in literalStageFourierBox Y, ‖v w‖ ^ 2 := by
  rw [← integral_indicator (literalStageFourierBox_measurableSet Y)]
  apply integral_congr_ae
  filter_upwards with w
  by_cases hw : w ∈ literalStageFourierBox Y
  · simp [hw]
  · have hv0 : v w = 0 := by
      by_contra hn
      exact hw (hv (subset_tsupport _ hn))
    simp [hw, hv0]

/-! #### Normalized physical Fourier waves and finite-rank projections -/

/-- The point of the unit torus represented by a physical point after
division by the fixed side length. -/
noncomputable def literalStagePhysicalTorusPoint (Y : ℝ) (w : ℂ) :
    P5LocalFourierRellich.TwoTorus :=
  fun i ↦
    ((literalStageFourierScale Y)⁻¹ *
      Complex.measurableEquivPi w i : ℝ)

theorem literalStagePhysicalTorusPoint_measurable (Y : ℝ) :
    Measurable (literalStagePhysicalTorusPoint Y) := by
  unfold literalStagePhysicalTorusPoint
  fun_prop

/-- A normalized Fourier wave on the physical half-open rectangle, extended
by zero to the whole plane. -/
noncomputable def literalStagePlaneWaveRepresentative
    (Y : ℝ) (k : Fin 2 → ℤ) (w : ℂ) : ℂ :=
  if w ∈ literalStageFourierBox Y then
    ((literalStageFourierScale Y)⁻¹ : ℂ) *
      UnitAddTorus.mFourier k (literalStagePhysicalTorusPoint Y w)
  else 0

theorem literalStagePlaneWaveRepresentative_aestronglyMeasurable
    (Y : ℝ) (k : Fin 2 → ℤ) :
    AEStronglyMeasurable (literalStagePlaneWaveRepresentative Y k)
      (volume : Measure ℂ) := by
  apply AEMeasurable.aestronglyMeasurable
  exact (measurable_const.mul
    (UnitAddTorus.mFourier k).continuous.measurable.comp
      (literalStagePhysicalTorusPoint_measurable Y)).ite
        (literalStageFourierBox_measurableSet Y) measurable_const

theorem literalStagePlaneWaveRepresentative_support_subset
    (Y : ℝ) (k : Fin 2 → ℤ) :
    Function.support (literalStagePlaneWaveRepresentative Y k) ⊆
      literalStageFourierBox Y := by
  intro w hw
  by_contra hnot
  simp only [literalStagePlaneWaveRepresentative, if_neg hnot] at hw
  exact hw rfl

theorem literalStagePlaneWaveRepresentative_hasCompactSupport
    (Y : ℝ) (k : Fin 2 → ℤ) :
    HasCompactSupport (literalStagePlaneWaveRepresentative Y k) :=
  (literalStageFourierClosedBox_isCompact Y).of_isClosed_subset
    isClosed_closure
    (closure_minimal
      ((literalStagePlaneWaveRepresentative_support_subset Y k).trans
        (literalStageFourierBox_subset_closedBox Y))
      (literalStageFourierClosedBox_isCompact Y).isClosed)

theorem literalStagePlaneWaveRepresentative_memLp
    (Y : ℝ) (k : Fin 2 → ℤ) :
    MemLp (literalStagePlaneWaveRepresentative Y k) 2
      (volume : Measure ℂ) := by
  apply (literalStagePlaneWaveRepresentative_hasCompactSupport Y k).memLp_of_bound
    (literalStagePlaneWaveRepresentative_aestronglyMeasurable Y k)
    (literalStageFourierScale Y)⁻¹
  exact Filter.Eventually.of_forall fun w ↦ by
    unfold literalStagePlaneWaveRepresentative
    split_ifs
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_inv, abs_of_pos (literalStageFourierScale_pos Y),
        show ‖UnitAddTorus.mFourier k
          (literalStagePhysicalTorusPoint Y w)‖ = 1 by
            simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk,
              norm_prod, fourier_apply, Circle.norm_coe,
              Finset.prod_const_one]]
      simp only [mul_one, le_rfl]
    · simp only [norm_zero]
      exact inv_nonneg.mpr (literalStageFourierScale_pos Y).le

/-- The normalized physical wave as a genuine full-plane `L²` vector. -/
noncomputable def literalStagePlaneWave
    (Y : ℝ) (k : Fin 2 → ℤ) : AmbientPlaneL2 :=
  (literalStagePlaneWaveRepresentative_memLp Y k).toLp
    (literalStagePlaneWaveRepresentative Y k)

theorem coeFn_literalStagePlaneWave
    (Y : ℝ) (k : Fin 2 → ℤ) :
    ⇑(literalStagePlaneWave Y k) =ᵐ[(volume : Measure ℂ)]
      literalStagePlaneWaveRepresentative Y k :=
  MemLp.coeFn_toLp (literalStagePlaneWaveRepresentative_memLp Y k)

/-- Finite Fourier projection in the physical rectangle, displayed as an
actual finite sum of rank-one full-plane operators. -/
noncomputable def literalStagePlaneFiniteProjection
    (Y : ℝ) (N : ℕ) : AmbientPlaneL2 →L[ℂ] AmbientPlaneL2 :=
  ∑ k ∈ literalStageFourierModes N,
    InnerProductSpace.rankOne ℂ
      (literalStagePlaneWave Y k) (literalStagePlaneWave Y k)

@[simp]
theorem literalStagePlaneFiniteProjection_apply
    (Y : ℝ) (N : ℕ) (F : AmbientPlaneL2) :
    literalStagePlaneFiniteProjection Y N F =
      ∑ k ∈ literalStageFourierModes N,
        inner ℂ (literalStagePlaneWave Y k) F •
          literalStagePlaneWave Y k := by
  simp only [literalStagePlaneFiniteProjection,
    ContinuousLinearMap.sum_apply, InnerProductSpace.rankOne_apply]

theorem literalStagePlaneFiniteProjection_isCompact
    (Y : ℝ) (N : ℕ) :
    IsCompactOperator (literalStagePlaneFiniteProjection Y N) := by
  classical
  unfold literalStagePlaneFiniteProjection
  induction literalStageFourierModes N using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      exact isCompactOperator_zero
  | @insert k s hk ih =>
      rw [Finset.sum_insert hk]
      exact
        (CompactSeparableKernelPotential.hilbertRankOne_isCompact
          (literalStagePlaneWave Y k)).add ih

/-- Finite-rank approximants to the completed physical localization. -/
noncomputable def literalStagePlaneFiniteApproximation
    (Y : ℝ) (n : ℤ) (N : ℕ) :
    GraphSobolevCompletion n →L[ℂ] AmbientPlaneL2 :=
  (literalStagePlaneFiniteProjection Y N).comp
    (completedLiteralStagePlaneBase Y n)

theorem literalStagePlaneFiniteApproximation_isCompact
    (Y : ℝ) (n : ℤ) (N : ℕ) :
    IsCompactOperator (literalStagePlaneFiniteApproximation Y n N) :=
  (literalStagePlaneFiniteProjection_isCompact Y N).comp_clm
    (completedLiteralStagePlaneBase Y n)

/-! #### Exact rectangle periodization and the physical Fourier basis -/

/-- The scaled image of the standard unit box is exactly the physical
rectangle.  This equality, rather than an informal identification modulo its
boundary, is used in every change of variables below. -/
theorem literalStageFourierBox_eq_smul_unitPiBox (Y : ℝ) :
    literalStageFourierBox Y =
      literalStageFourierScale Y •
        (Complex.measurableEquivPi.symm '' literalStageUnitPiBox) := by
  ext w
  constructor
  · intro hw
    let x : Fin 2 → ℝ := fun i ↦
      (literalStageFourierScale Y)⁻¹ *
        Complex.measurableEquivPi w i
    have hx : x ∈ literalStageUnitPiBox := by
      intro i
      have hi := hw i
      rw [Set.mem_Ioc] at hi ⊢
      constructor
      · apply (mul_lt_mul_left (literalStageFourierScale_pos Y)).mp
        simpa [x, literalStageFourierScale_ne_zero Y] using hi.1
      · apply (mul_le_mul_left (literalStageFourierScale_pos Y)).mp
        simpa [x, literalStageFourierScale_ne_zero Y] using hi.2
    refine ⟨Complex.measurableEquivPi.symm x, ⟨x, hx, rfl⟩, ?_⟩
    apply Complex.measurableEquivPi.injective
    ext i
    simp [x, literalStageFourierScale_ne_zero Y]
  · rintro ⟨w, ⟨x, hx, rfl⟩, rfl⟩
    intro i
    have hi := hx i
    rw [Set.mem_Ioc] at hi ⊢
    simpa [literalStageFourierScale_pos Y, mul_assoc] using
      (mul_lt_mul_of_pos_left hi.1 (literalStageFourierScale_pos Y)).and
        (mul_le_mul_of_nonneg_left hi.2
          (literalStageFourierScale_pos Y).le)

theorem norm_literalStageTorusTest_sq_eq_scale_inv_sq_mul_box
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖literalStageTorusTest Y v‖ ^ 2 =
      (literalStageFourierScale Y) ^ (-2 : ℤ) *
        ∫ w in literalStageFourierBox Y, ‖v w‖ ^ 2 := by
  simpa only [literalStageFourierBox_eq_smul_unitPiBox] using
    norm_literalStageTorusTest_sq_eq_scale_inv_sq_mul_scaledBox Y v

/-- Exact norm scaling between a rectangle-supported physical test and its
periodization on the genuine two-torus. -/
theorem norm_ambientTestCoreToPlaneL2Linear_eq_scale_mul_torusTest
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    ‖ambientTestCoreToPlaneL2Linear v‖ =
      literalStageFourierScale Y * ‖literalStageTorusTest Y v‖ := by
  have htorus :=
    norm_literalStageTorusTest_sq_eq_scale_inv_sq_mul_box Y v
  have hplane := norm_ambientTestCoreToPlaneL2Linear_sq v
  have hmass :=
    integral_normSq_eq_setIntegral_fourierBox_of_tsupport_subset Y v hv
  have hsq :
      ‖ambientTestCoreToPlaneL2Linear v‖ ^ 2 =
        literalStageFourierScale Y ^ 2 *
          ‖literalStageTorusTest Y v‖ ^ 2 := by
    calc
      ‖ambientTestCoreToPlaneL2Linear v‖ ^ 2 =
          ∫ w : ℂ, ‖v w‖ ^ 2 := hplane
      _ = literalStageFourierScale Y ^ 2 *
          ‖literalStageTorusTest Y v‖ ^ 2 := by
        rw [htorus, hmass]
        simp only [zpow_neg, zpow_ofNat]
        field_simp [literalStageFourierScale_ne_zero Y] <;> ring
  have hL := literalStageFourierScale_pos Y
  have hleft := norm_nonneg (ambientTestCoreToPlaneL2Linear v)
  have hright := norm_nonneg (literalStageTorusTest Y v)
  nlinarith [sq_nonneg
    (‖ambientTestCoreToPlaneL2Linear v‖ -
      literalStageFourierScale Y * ‖literalStageTorusTest Y v‖)]

/-- The measurable fundamental representative recovers an interior point of
the physical rectangle exactly.  The half-open convention is important at
the right edge. -/
theorem literalStageTorusPoint_physicalTorusPoint
    (Y : ℝ) {w : ℂ} (hw : w ∈ literalStageFourierBox Y) :
    literalStageTorusPoint Y (literalStagePhysicalTorusPoint Y w) = w := by
  apply Complex.measurableEquivPi.injective
  ext i
  simp only [literalStageTorusPoint, literalStageTorusCoordinate,
    literalStagePhysicalTorusPoint, Complex.measurableEquivPi_apply]
  rw [UnitAddTorus.coe_measurableEquivPiIoc_apply]
  have hi := hw i
  have hscaled :
      (literalStageFourierScale Y)⁻¹ *
          Complex.measurableEquivPi w i ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2) := by
    rw [Set.mem_Ioc] at hi ⊢
    constructor
    · apply (mul_lt_mul_left (literalStageFourierScale_pos Y)).mp
      simpa [literalStageFourierScale_ne_zero Y] using hi.1
    · apply (mul_le_mul_left (literalStageFourierScale_pos Y)).mp
      simpa [literalStageFourierScale_ne_zero Y] using hi.2
  rw [show
      (AddCircle.equivIoc 1 (-(1 / 2 : ℝ))
          (((literalStageFourierScale Y)⁻¹ *
            Complex.measurableEquivPi w i : ℝ) : UnitAddCircle)).1 =
        (literalStageFourierScale Y)⁻¹ *
          Complex.measurableEquivPi w i by
    exact congrArg Subtype.val (AddCircle.equivIoc_coe_eq hscaled)]
  field_simp [literalStageFourierScale_ne_zero Y]

/-- A globally smooth negative physical plane wave.  On the physical box it
is exactly the complex conjugate of the normalized zero-extended wave. -/
noncomputable def literalStageNegativePlaneWave
    (Y : ℝ) (k : Fin 2 → ℤ) (w : ℂ) : ℂ :=
  ((literalStageFourierScale Y)⁻¹ : ℂ) *
    fourier (-(k 0))
      (((literalStageFourierScale Y)⁻¹ * w.re : ℝ) : UnitAddCircle) *
    fourier (-(k 1))
      (((literalStageFourierScale Y)⁻¹ * w.im : ℝ) : UnitAddCircle)

theorem literalStageNegativePlaneWave_continuous
    (Y : ℝ) (k : Fin 2 → ℤ) :
    Continuous (literalStageNegativePlaneWave Y k) := by
  unfold literalStageNegativePlaneWave
  fun_prop

theorem literalStageNegativePlaneWave_differentiable
    (Y : ℝ) (k : Fin 2 → ℤ) :
    Differentiable ℝ (literalStageNegativePlaneWave Y k) := by
  unfold literalStageNegativePlaneWave
  fun_prop

theorem literalStageNegativePlaneWave_eq_conj_planeWaveRepresentative
    (Y : ℝ) (k : Fin 2 → ℤ) {w : ℂ}
    (hw : w ∈ literalStageFourierBox Y) :
    literalStageNegativePlaneWave Y k w =
      star (literalStagePlaneWaveRepresentative Y k w) := by
  rw [literalStagePlaneWaveRepresentative, if_pos hw]
  simp only [literalStageNegativePlaneWave,
    literalStagePhysicalTorusPoint, UnitAddTorus.mFourier_neg,
    UnitAddTorus.mFourier, ContinuousMap.coe_mk, map_mul,
    Complex.conj_inv, Complex.conj_ofReal, map_prod, Pi.neg_apply]
  rw [show (∏ i : Fin 2,
      fourier (-(k i))
        (((literalStageFourierScale Y)⁻¹ *
          Complex.measurableEquivPi w i : ℝ) : UnitAddCircle)) =
      fourier (-(k 0))
        (((literalStageFourierScale Y)⁻¹ * w.re : ℝ) : UnitAddCircle) *
      fourier (-(k 1))
        (((literalStageFourierScale Y)⁻¹ * w.im : ℝ) : UnitAddCircle) by
    rw [Fin.prod_univ_two]
    rfl]
  ring

/-- Exact horizontal derivative of the smooth negative physical wave. -/
theorem fderiv_literalStageNegativePlaneWave_one
    (Y : ℝ) (k : Fin 2 → ℤ) (w : ℂ) :
    fderiv ℝ (literalStageNegativePlaneWave Y k) w 1 =
      (-2 * Real.pi * Complex.I * (k 0 : ℂ) /
          literalStageFourierScale Y) *
        literalStageNegativePlaneWave Y k w := by
  have hdiff :=
    (literalStageNegativePlaneWave_differentiable Y k w).differentiableAt
  rw [← hdiff.lineDeriv_eq_fderiv]
  apply HasLineDerivAt.lineDeriv
  unfold HasLineDerivAt literalStageNegativePlaneWave
  convert
    (((hasDerivAt_fourier_neg (1 : ℝ) (k 0)
        ((literalStageFourierScale Y)⁻¹ * w.re)).comp 0
          (((hasDerivAt_id (0 : ℝ)).const_add w.re).const_mul
            (literalStageFourierScale Y)⁻¹)).mul_const
        (fourier (-(k 1))
          (((literalStageFourierScale Y)⁻¹ * w.im : ℝ) : UnitAddCircle))).const_mul
      ((literalStageFourierScale Y)⁻¹ : ℂ) using 1 <;>
    simp only [one_div, one_re, one_im, Complex.add_re, Complex.add_im,
      Complex.real_smul, smul_eq_mul, mul_one, add_zero, zero_mul,
      Complex.ofReal_inv, Complex.ofReal_mul] <;>
    field_simp [literalStageFourierScale_ne_zero Y] <;> ring

/-- Exact vertical derivative of the smooth negative physical wave. -/
theorem fderiv_literalStageNegativePlaneWave_I
    (Y : ℝ) (k : Fin 2 → ℤ) (w : ℂ) :
    fderiv ℝ (literalStageNegativePlaneWave Y k) w Complex.I =
      (-2 * Real.pi * Complex.I * (k 1 : ℂ) /
          literalStageFourierScale Y) *
        literalStageNegativePlaneWave Y k w := by
  have hdiff :=
    (literalStageNegativePlaneWave_differentiable Y k w).differentiableAt
  rw [← hdiff.lineDeriv_eq_fderiv]
  apply HasLineDerivAt.lineDeriv
  unfold HasLineDerivAt literalStageNegativePlaneWave
  convert
    (((hasDerivAt_fourier_neg (1 : ℝ) (k 1)
        ((literalStageFourierScale Y)⁻¹ * w.im)).comp 0
          (((hasDerivAt_id (0 : ℝ)).const_add w.im).const_mul
            (literalStageFourierScale Y)⁻¹)).const_mul
        (fourier (-(k 0))
          (((literalStageFourierScale Y)⁻¹ * w.re : ℝ) : UnitAddCircle))).const_mul
      ((literalStageFourierScale Y)⁻¹ : ℂ) using 1 <;>
    simp only [one_div, Complex.I_re, Complex.I_im, Complex.add_re,
      Complex.add_im, Complex.real_smul, smul_eq_mul, mul_one, add_zero,
      zero_mul, Complex.ofReal_inv, Complex.ofReal_mul] <;>
    field_simp [literalStageFourierScale_ne_zero Y] <;> ring

/-- Full-plane integration by parts gives the horizontal Fourier coefficient
identity without a boundary term.  Compact support is carried by `v`; the
plane wave itself is intentionally not compactly supported. -/
theorem integral_negativePlaneWave_mul_dx
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    (∫ w : ℂ, literalStageNegativePlaneWave Y k w *
        HalfWeightCompactCoordinateGreen.dx v w) =
      (2 * Real.pi * Complex.I * (k 0 : ℂ) /
          literalStageFourierScale Y) *
        ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w := by
  have hIBP := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (μ := (volume : Measure ℂ)) (v := (1 : ℂ))
    ((literalStageNegativePlaneWave_continuous Y k).mul
      v.continuous).integrable_of_hasCompactSupport v.hasCompactSupport.mul_left
    ((literalStageNegativePlaneWave_continuous Y k).mul
      (HalfWeightCompactCoordinateGreen.dx v).continuous)
        .integrable_of_hasCompactSupport
          (HalfWeightCompactCoordinateGreen.dx v).hasCompactSupport.mul_left
    ((literalStageNegativePlaneWave_continuous Y k).mul
      v.continuous).integrable_of_hasCompactSupport v.hasCompactSupport.mul_left
    (fun _ _ ↦ (literalStageNegativePlaneWave_differentiable Y k _).differentiableAt)
    (fun _ _ ↦ v.contDiff.differentiable (by simp) _)
  simpa only [HalfWeightCompactCoordinateGreen.dx_apply,
    fderiv_literalStageNegativePlaneWave_one, neg_mul, neg_neg,
    integral_const_mul, mul_assoc] using hIBP

/-- Vertical counterpart of `integral_negativePlaneWave_mul_dx`. -/
theorem integral_negativePlaneWave_mul_dy
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    (∫ w : ℂ, literalStageNegativePlaneWave Y k w *
        HalfWeightCompactCoordinateGreen.dy v w) =
      (2 * Real.pi * Complex.I * (k 1 : ℂ) /
          literalStageFourierScale Y) *
        ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w := by
  have hIBP := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (μ := (volume : Measure ℂ)) (v := Complex.I)
    ((literalStageNegativePlaneWave_continuous Y k).mul
      v.continuous).integrable_of_hasCompactSupport v.hasCompactSupport.mul_left
    ((literalStageNegativePlaneWave_continuous Y k).mul
      (HalfWeightCompactCoordinateGreen.dy v).continuous)
        .integrable_of_hasCompactSupport
          (HalfWeightCompactCoordinateGreen.dy v).hasCompactSupport.mul_left
    ((literalStageNegativePlaneWave_continuous Y k).mul
      v.continuous).integrable_of_hasCompactSupport v.hasCompactSupport.mul_left
    (fun _ _ ↦ (literalStageNegativePlaneWave_differentiable Y k _).differentiableAt)
    (fun _ _ ↦ v.contDiff.differentiable (by simp) _)
  simpa only [HalfWeightCompactCoordinateGreen.dy_apply,
    fderiv_literalStageNegativePlaneWave_I, neg_mul, neg_neg,
    integral_const_mul, mul_assoc] using hIBP

/-- The `L²` coefficient of a rectangle-supported test is represented by
the smooth negative plane wave on the whole plane.  Compact support of the
test kills the zero-extension complement exactly. -/
theorem inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    inner ℂ (literalStagePlaneWave Y k)
        (ambientTestCoreToPlaneL2Linear v) =
      ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w := by
  rw [MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards [coeFn_literalStagePlaneWave Y k,
    coeFn_ambientTestCoreToPlaneL2Linear v] with w hwave hvw
  rw [hwave, hvw]
  by_cases hw : w ∈ literalStageFourierBox Y
  · rw [literalStageNegativePlaneWave_eq_conj_planeWaveRepresentative
      Y k hw]
    rfl
  · have hv0 : v w = 0 := by
      by_contra hn
      exact hw (hv (subset_tsupport _ hn))
    simp [literalStagePlaneWaveRepresentative, hw, hv0]

/-- Periodization of one physical coefficient.  The factor is exactly the
side length: Jacobian `L²` times wave normalization `L⁻¹`. -/
theorem inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    inner ℂ (literalStagePlaneWave Y k)
        (ambientTestCoreToPlaneL2Linear v) =
      (literalStageFourierScale Y : ℂ) *
        UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k := by
  rw [MeasureTheory.L2.inner_def,
    UnitAddTorus.mFourierBasis_repr]
  unfold UnitAddTorus.mFourierCoeff
  rw [show (∫ w : ℂ,
      inner ℂ (literalStagePlaneWave Y k w)
        (ambientTestCoreToPlaneL2Linear v w)) =
      ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w by
    simpa only [MeasureTheory.L2.inner_def] using
      inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
        Y k v hv]
  rw [UnitAddTorus.integral_preimage
    (fun t : P5LocalFourierRellich.TwoTorus ↦
      UnitAddTorus.mFourier (-k) t *
        literalStageTorusRepresentative Y v t)
    (fun _ : Fin 2 ↦ -(1 / 2 : ℝ))]
  rw [← literalStageFourierBox_eq_smul_unitPiBox Y,
    Measure.setIntegral_comp_smul_of_pos volume
      (fun w : ℂ ↦ literalStageNegativePlaneWave Y k w * v w)
      (Complex.measurableEquivPi.symm '' literalStageUnitPiBox)
      (literalStageFourierScale_pos Y)]
  simp only [Module.finrank_complex_real, literalStageTorusRepresentative,
    literalStageTorusPoint, literalStageTorusCoordinate, smul_eq_mul,
    zpow_ofNat, Complex.ofReal_mul, Complex.ofReal_inv]
  apply integral_congr_ae
  filter_upwards [coeFn_literalStageTorusTest Y v] with x hx
  rw [hx]
  simp only [literalStageNegativePlaneWave, Complex.mul_re,
    Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
    sub_zero, UnitAddTorus.mFourier, ContinuousMap.coe_mk]
  rw [Fin.prod_univ_two]
  field_simp [literalStageFourierScale_ne_zero Y]
  ring

/-- The derivative Fourier coefficients carry the exact integer frequency.
This is the horizontal identity on the genuine two-torus. -/
theorem mFourierCoeff_scaled_dx
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    UnitAddTorus.mFourierCoeff
        ((literalStageFourierScale Y : ℂ) •
          literalStageTorusTest Y
            (HalfWeightCompactCoordinateGreen.dx v)) k =
      (2 * Real.pi * Complex.I * (k 0 : ℂ)) *
        UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k := by
  have hdx : tsupport
      (HalfWeightCompactCoordinateGreen.dx v : ℂ → ℂ) ⊆
        literalStageFourierBox Y :=
    (HalfWeightCompactCoordinateGreen.tsupport_dx_subset v).trans hv
  have hbase := inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
    Y k v hv
  have hder := inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
    Y k (HalfWeightCompactCoordinateGreen.dx v) hdx
  rw [map_smul]
  simp only [smul_eq_mul]
  calc
    (literalStageFourierScale Y : ℂ) *
        UnitAddTorus.mFourierCoeff
          (literalStageTorusTest Y
            (HalfWeightCompactCoordinateGreen.dx v)) k =
      inner ℂ (literalStagePlaneWave Y k)
        (ambientTestCoreToPlaneL2Linear
          (HalfWeightCompactCoordinateGreen.dx v)) := hder.symm
    _ = ∫ w : ℂ, literalStageNegativePlaneWave Y k w *
        HalfWeightCompactCoordinateGreen.dx v w :=
      inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
        Y k (HalfWeightCompactCoordinateGreen.dx v) hdx
    _ = (2 * Real.pi * Complex.I * (k 0 : ℂ) /
          literalStageFourierScale Y) *
        ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w :=
      integral_negativePlaneWave_mul_dx Y k v
    _ = (2 * Real.pi * Complex.I * (k 0 : ℂ) /
          literalStageFourierScale Y) *
        inner ℂ (literalStagePlaneWave Y k)
          (ambientTestCoreToPlaneL2Linear v) := by
      rw [inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
        Y k v hv]
    _ = (2 * Real.pi * Complex.I * (k 0 : ℂ)) *
        UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k := by
      rw [hbase]
      field_simp [literalStageFourierScale_ne_zero Y]
      ring

/-- Vertical integer-frequency identity. -/
theorem mFourierCoeff_scaled_dy
    (Y : ℝ) (k : Fin 2 → ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    UnitAddTorus.mFourierCoeff
        ((literalStageFourierScale Y : ℂ) •
          literalStageTorusTest Y
            (HalfWeightCompactCoordinateGreen.dy v)) k =
      (2 * Real.pi * Complex.I * (k 1 : ℂ)) *
        UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k := by
  have hdy : tsupport
      (HalfWeightCompactCoordinateGreen.dy v : ℂ → ℂ) ⊆
        literalStageFourierBox Y :=
    (HalfWeightCompactCoordinateGreen.tsupport_dy_subset v).trans hv
  have hbase := inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
    Y k v hv
  have hder := inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
    Y k (HalfWeightCompactCoordinateGreen.dy v) hdy
  rw [map_smul]
  simp only [smul_eq_mul]
  calc
    (literalStageFourierScale Y : ℂ) *
        UnitAddTorus.mFourierCoeff
          (literalStageTorusTest Y
            (HalfWeightCompactCoordinateGreen.dy v)) k =
      inner ℂ (literalStagePlaneWave Y k)
        (ambientTestCoreToPlaneL2Linear
          (HalfWeightCompactCoordinateGreen.dy v)) := hder.symm
    _ = ∫ w : ℂ, literalStageNegativePlaneWave Y k w *
        HalfWeightCompactCoordinateGreen.dy v w :=
      inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
        Y k (HalfWeightCompactCoordinateGreen.dy v) hdy
    _ = (2 * Real.pi * Complex.I * (k 1 : ℂ) /
          literalStageFourierScale Y) *
        ∫ w : ℂ, literalStageNegativePlaneWave Y k w * v w :=
      integral_negativePlaneWave_mul_dy Y k v
    _ = (2 * Real.pi * Complex.I * (k 1 : ℂ) /
          literalStageFourierScale Y) *
        inner ℂ (literalStagePlaneWave Y k)
          (ambientTestCoreToPlaneL2Linear v) := by
      rw [inner_planeWave_ambientTestCore_eq_integral_negativePlaneWave
        Y k v hv]
    _ = (2 * Real.pi * Complex.I * (k 1 : ℂ)) *
        UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k := by
      rw [hbase]
      field_simp [literalStageFourierScale_ne_zero Y]
      ring

/-- Rectangle periodization preserves the normalized Fourier inner product.
Consequently the zero-extended physical waves are genuinely orthonormal in
the full-plane `L²` space. -/
theorem inner_literalStagePlaneWave
    (Y : ℝ) (k l : Fin 2 → ℤ) :
    inner ℂ (literalStagePlaneWave Y k)
        (literalStagePlaneWave Y l) = if k = l then 1 else 0 := by
  rw [MeasureTheory.L2.inner_def]
  calc
    (∫ w : ℂ, inner ℂ (literalStagePlaneWave Y k w)
        (literalStagePlaneWave Y l w)) =
      inner ℂ
        (UnitAddTorus.mFourierLp (d := Fin 2) 2 k)
        (UnitAddTorus.mFourierLp (d := Fin 2) 2 l) := by
      rw [MeasureTheory.L2.inner_def]
      rw [← literalStageFourierBox_eq_smul_unitPiBox Y,
        Measure.setIntegral_comp_smul_of_pos volume
          (fun w : ℂ ↦
            inner ℂ (literalStagePlaneWave Y k w)
              (literalStagePlaneWave Y l w))
          (Complex.measurableEquivPi.symm '' literalStageUnitPiBox)
          (literalStageFourierScale_pos Y)]
      rw [UnitAddTorus.integral_preimage
        (fun t : P5LocalFourierRellich.TwoTorus ↦
          inner ℂ (UnitAddTorus.mFourier k t)
            (UnitAddTorus.mFourier l t))
        (fun _ : Fin 2 ↦ -(1 / 2 : ℝ))]
      apply integral_congr_ae
      filter_upwards [coeFn_literalStagePlaneWave Y k,
        coeFn_literalStagePlaneWave Y l,
        UnitAddTorus.coeFn_mFourierLp (d := Fin 2) 2 k,
        UnitAddTorus.coeFn_mFourierLp (d := Fin 2) 2 l] with x hk hl hkt hlt
      simp [hk, hl, hkt, hlt, literalStagePlaneWaveRepresentative,
        literalStageFourierBox_eq_smul_unitPiBox,
        literalStageFourierScale_ne_zero Y]
    _ = if k = l then 1 else 0 :=
      (orthonormal_iff_ite.mp
        (UnitAddTorus.orthonormal_mFourier (d := Fin 2))) k l

theorem orthonormal_literalStagePlaneWave (Y : ℝ) :
    Orthonormal ℂ (literalStagePlaneWave Y) := by
  rw [orthonormal_iff_ite]
  exact inner_literalStagePlaneWave Y

/-- The displayed physical Fourier projection is literally the finite sum
of its normalized rank-one mode projections.  This theorem records the
operator equality used by the compactness proof, rather than appealing to a
nonexistent `Orthonormal.repr` interface. -/
theorem literalStagePlaneFiniteProjection_eq_rankOneFourierSum
    (Y : ℝ) (N : ℕ) :
    literalStagePlaneFiniteProjection Y N =
      ∑ k ∈ literalStageFourierModes N,
        InnerProductSpace.rankOne ℂ
          (literalStagePlaneWave Y k) (literalStagePlaneWave Y k) :=
  rfl

theorem inner_literalStagePlaneWave_finiteProjection_of_mem
    (Y : ℝ) (N : ℕ) (F : AmbientPlaneL2) {k : Fin 2 → ℤ}
    (hk : k ∈ literalStageFourierModes N) :
    inner ℂ (literalStagePlaneWave Y k)
        (literalStagePlaneFiniteProjection Y N F) =
      inner ℂ (literalStagePlaneWave Y k) F := by
  rw [literalStagePlaneFiniteProjection_apply]
  exact (orthonormal_literalStagePlaneWave Y).inner_right_sum
    (fun l ↦ inner ℂ (literalStagePlaneWave Y l) F) hk

/-- The finite rank-one Fourier sum is an actual projection operator. -/
theorem literalStagePlaneFiniteProjection_idempotent
    (Y : ℝ) (N : ℕ) (F : AmbientPlaneL2) :
    literalStagePlaneFiniteProjection Y N
        (literalStagePlaneFiniteProjection Y N F) =
      literalStagePlaneFiniteProjection Y N F := by
  calc
    literalStagePlaneFiniteProjection Y N
        (literalStagePlaneFiniteProjection Y N F) =
      ∑ k ∈ literalStageFourierModes N,
        inner ℂ (literalStagePlaneWave Y k)
            (literalStagePlaneFiniteProjection Y N F) •
          literalStagePlaneWave Y k :=
      literalStagePlaneFiniteProjection_apply Y N _
    _ = ∑ k ∈ literalStageFourierModes N,
        inner ℂ (literalStagePlaneWave Y k) F •
          literalStagePlaneWave Y k := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [inner_literalStagePlaneWave_finiteProjection_of_mem Y N F hk]
    _ = literalStagePlaneFiniteProjection Y N F :=
      (literalStagePlaneFiniteProjection_apply Y N F).symm

/-- Inner-product Pythagoras for the explicit finite projection associated
with any orthonormal family.  The right-hand sum is retained in complex
form, which makes the physical scaling argument exact and avoids a hidden
choice of a completion of the family to a Hilbert basis. -/
theorem inner_finiteOrthonormalProjection_sub
    {I E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : I → E) (he : Orthonormal ℂ e) (s : Finset I) (x : E) :
    inner ℂ
        ((∑ i ∈ s, inner ℂ (e i) x • e i) - x)
        ((∑ i ∈ s, inner ℂ (e i) x • e i) - x) =
      inner ℂ x x -
        ∑ i ∈ s,
          starRingEnd ℂ (inner ℂ (e i) x) * inner ℂ (e i) x := by
  classical
  have hPP := he.inner_sum
    (fun i ↦ inner ℂ (e i) x) (fun i ↦ inner ℂ (e i) x) s
  have hPx :
      inner ℂ (∑ i ∈ s, inner ℂ (e i) x • e i) x =
        ∑ i ∈ s,
          starRingEnd ℂ (inner ℂ (e i) x) * inner ℂ (e i) x := by
    rw [sum_inner]
    apply Finset.sum_congr rfl
    intro i hi
    rw [inner_smul_left]
  have hxP :
      inner ℂ x (∑ i ∈ s, inner ℂ (e i) x • e i) =
        ∑ i ∈ s,
          starRingEnd ℂ (inner ℂ (e i) x) * inner ℂ (e i) x := by
    rw [inner_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [inner_smul_right, ← inner_conj_symm]
    ring
  rw [inner_sub_left, inner_sub_right, hPP, hPx, hxP]
  ring

/-- Exact equality of the physical Fourier remainder with the rescaled
torus remainder for a test supported in the rectangle. -/
theorem norm_planeFourierRemainder_eq_scale_mul_torusRemainder
    (Y : ℝ) (N : ℕ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    ‖literalStagePlaneFiniteProjection Y N
        (ambientTestCoreToPlaneL2Linear v) -
        ambientTestCoreToPlaneL2Linear v‖ =
      literalStageFourierScale Y *
        ‖P5LocalFourierRellich.twoTorusFiniteFourierProjection
            (literalStageFourierModes N) (literalStageTorusTest Y v) -
          literalStageTorusTest Y v‖ := by
  let b := P5LocalFourierRellich.twoTorusFourierBasis
  let s := literalStageFourierModes N
  let F := ambientTestCoreToPlaneL2Linear v
  let T := literalStageTorusTest Y v
  have hcoeff : ∀ k,
      inner ℂ (literalStagePlaneWave Y k)
          F =
        (literalStageFourierScale Y : ℂ) *
          inner ℂ (b k) T := by
    intro k
    calc
      inner ℂ (literalStagePlaneWave Y k) F =
          (literalStageFourierScale Y : ℂ) *
            UnitAddTorus.mFourierCoeff T k := by
        exact inner_planeWave_ambientTestCore_eq_scale_mul_mFourierCoeff
          Y k v hv
      _ = (literalStageFourierScale Y : ℂ) *
          inner ℂ (b k) T := by
        rw [← HilbertBasis.repr_apply_apply]
        simp only [b, P5LocalFourierRellich.twoTorusFourierBasis,
          UnitAddTorus.mFourierBasis_repr]
  have hbase : ‖F‖ = literalStageFourierScale Y * ‖T‖ := by
    exact norm_ambientTestCoreToPlaneL2Linear_eq_scale_mul_torusTest
      Y v hv
  have hbaseInner :
      inner ℂ F F =
        (literalStageFourierScale Y ^ 2 : ℝ) * inner ℂ T T := by
    rw [inner_self_eq_norm_sq, inner_self_eq_norm_sq, hbase]
    push_cast
    ring
  have hsum :
      (∑ k ∈ s,
          starRingEnd ℂ
              (inner ℂ (literalStagePlaneWave Y k) F) *
            inner ℂ (literalStagePlaneWave Y k) F) =
        (literalStageFourierScale Y ^ 2 : ℝ) *
          ∑ k ∈ s,
            starRingEnd ℂ (inner ℂ (b k) T) * inner ℂ (b k) T := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [hcoeff k]
    simp only [map_mul, map_ofReal]
    ring
  have hp := inner_finiteOrthonormalProjection_sub
    (literalStagePlaneWave Y) (orthonormal_literalStagePlaneWave Y) s F
  have ht := inner_finiteOrthonormalProjection_sub
    (fun k ↦ b k) b.orthonormal s T
  rw [← literalStagePlaneFiniteProjection_apply Y N F] at hp
  rw [← P5LocalFourierRellich.finiteHilbertProjection_apply b s T] at ht
  change inner ℂ
      (P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T)
      (P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T) = _ at ht
  have hresInner :
      inner ℂ (literalStagePlaneFiniteProjection Y N F - F)
          (literalStagePlaneFiniteProjection Y N F - F) =
        (literalStageFourierScale Y ^ 2 : ℝ) *
          inner ℂ
            (P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T)
            (P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T) := by
    rw [hp, ht, hbaseInner, hsum]
    ring
  have hsq :
      ‖literalStagePlaneFiniteProjection Y N F - F‖ ^ 2 =
        literalStageFourierScale Y ^ 2 *
          ‖P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T‖ ^ 2 := by
    rw [inner_self_eq_norm_sq, inner_self_eq_norm_sq] at hresInner
    exact_mod_cast hresInner
  have hL := literalStageFourierScale_pos Y
  have hpnonneg := norm_nonneg (literalStagePlaneFiniteProjection Y N F - F)
  have htnonneg := norm_nonneg
    (P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T)
  change ‖literalStagePlaneFiniteProjection Y N F - F‖ =
    literalStageFourierScale Y *
      ‖P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T‖
  nlinarith [sq_nonneg
    (‖literalStagePlaneFiniteProjection Y N F - F‖ -
      literalStageFourierScale Y *
        ‖P5LocalFourierRellich.twoTorusFiniteFourierProjection s T - T‖)]

/-! #### Uniform high-frequency tail on the graph unit ball -/

/-- The rescaled horizontal torus derivative is bounded by the literal
full-plane derivative norm. -/
theorem norm_scale_smul_torusTest_dx_le_plane
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖(literalStageFourierScale Y : ℂ) •
        literalStageTorusTest Y
          (HalfWeightCompactCoordinateGreen.dx v)‖ ≤
      ‖ambientTestCoreToPlaneL2Linear
        (HalfWeightCompactCoordinateGreen.dx v)‖ := by
  have h := norm_literalStageTorusTest_sq_le_plane Y
    (HalfWeightCompactCoordinateGreen.dx v)
  rw [← norm_ambientTestCoreToPlaneL2Linear_sq] at h
  rw [norm_smul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos (literalStageFourierScale_pos Y)]
  have hL := literalStageFourierScale_pos Y
  have hL0 := literalStageFourierScale_ne_zero Y
  have hnonneg := norm_nonneg
    (literalStageTorusTest Y (HalfWeightCompactCoordinateGreen.dx v))
  have hplane := norm_nonneg
    (ambientTestCoreToPlaneL2Linear
      (HalfWeightCompactCoordinateGreen.dx v))
  simp only [zpow_neg, zpow_ofNat] at h
  nlinarith [sq_nonneg
    (literalStageFourierScale Y *
      ‖literalStageTorusTest Y
        (HalfWeightCompactCoordinateGreen.dx v)‖)]

theorem norm_scale_smul_torusTest_dy_le_plane
    (Y : ℝ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) :
    ‖(literalStageFourierScale Y : ℂ) •
        literalStageTorusTest Y
          (HalfWeightCompactCoordinateGreen.dy v)‖ ≤
      ‖ambientTestCoreToPlaneL2Linear
        (HalfWeightCompactCoordinateGreen.dy v)‖ := by
  have h := norm_literalStageTorusTest_sq_le_plane Y
    (HalfWeightCompactCoordinateGreen.dy v)
  rw [← norm_ambientTestCoreToPlaneL2Linear_sq] at h
  rw [norm_smul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos (literalStageFourierScale_pos Y)]
  have hL := literalStageFourierScale_pos Y
  have hL0 := literalStageFourierScale_ne_zero Y
  have hnonneg := norm_nonneg
    (literalStageTorusTest Y (HalfWeightCompactCoordinateGreen.dy v))
  have hplane := norm_nonneg
    (ambientTestCoreToPlaneL2Linear
      (HalfWeightCompactCoordinateGreen.dy v))
  simp only [zpow_neg, zpow_ofNat] at h
  nlinarith [sq_nonneg
    (literalStageFourierScale Y *
      ‖literalStageTorusTest Y
        (HalfWeightCompactCoordinateGreen.dy v)‖)]

/-- Pointwise Fourier coefficient estimate outside the square of modes. -/
theorem torusFourierCoeff_sq_le_of_not_mem
    (Y : ℝ) (N : ℕ) (k : Fin 2 → ℤ)
    (hk : k ∉ literalStageFourierModes N)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    ‖P5LocalFourierRellich.twoTorusFourierBasis.repr
        (literalStageTorusTest Y v) k‖ ^ 2 ≤
      (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
        (‖P5LocalFourierRellich.twoTorusFourierBasis.repr
            ((literalStageFourierScale Y : ℂ) •
              literalStageTorusTest Y
                (HalfWeightCompactCoordinateGreen.dx v)) k‖ ^ 2 +
         ‖P5LocalFourierRellich.twoTorusFourierBasis.repr
            ((literalStageFourierScale Y : ℂ) •
              literalStageTorusTest Y
                (HalfWeightCompactCoordinateGreen.dy v)) k‖ ^ 2) := by
  rw [P5LocalFourierRellich.twoTorusFourierBasis,
    UnitAddTorus.mFourierBasis_repr,
    UnitAddTorus.mFourierBasis_repr,
    UnitAddTorus.mFourierBasis_repr]
  rcases exists_large_coordinate_of_not_mem_literalStageFourierModes N k hk with
    hk0 | hk1
  · rw [mFourierCoeff_scaled_dx Y k v hv]
    have hpi : 0 < 2 * Real.pi * ((N : ℝ) + 1) := by positivity
    have hki : (N : ℝ) + 1 ≤ |(k 0 : ℝ)| := by exact_mod_cast hk0
    have hfreq :
        2 * Real.pi * ((N : ℝ) + 1) ≤
          ‖2 * Real.pi * Complex.I * (k 0 : ℂ)‖ := by
      have hmul := mul_le_mul_of_nonneg_left hki
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) Real.pi_pos.le)
      convert hmul using 1 <;>
        simp [norm_mul, abs_of_pos Real.pi_pos] <;> ring
    have hfreqSq :
        (2 * Real.pi * ((N : ℝ) + 1)) ^ 2 *
            ‖UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 ≤
          ‖(2 * Real.pi * Complex.I * (k 0 : ℂ)) *
              UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 := by
      rw [norm_mul, mul_pow]
      exact mul_le_mul_of_nonneg_right
        (sq_le_sq₀ hpi.le hfreq) (sq_nonneg _)
    calc
      ‖UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 =
          (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
            ((2 * Real.pi * ((N : ℝ) + 1)) ^ 2 *
              ‖UnitAddTorus.mFourierCoeff
                (literalStageTorusTest Y v) k‖ ^ 2) := by
        field_simp [ne_of_gt hpi] <;> ring
      _ ≤ (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
          ‖(2 * Real.pi * Complex.I * (k 0 : ℂ)) *
            UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 :=
        mul_le_mul_of_nonneg_left hfreqSq (sq_nonneg _)
      _ ≤ (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
          (‖(2 * Real.pi * Complex.I * (k 0 : ℂ)) *
              UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 +
           ‖UnitAddTorus.mFourierCoeff
              ((literalStageFourierScale Y : ℂ) •
                literalStageTorusTest Y
                  (HalfWeightCompactCoordinateGreen.dy v)) k‖ ^ 2) := by
        gcongr
        positivity
  · rw [mFourierCoeff_scaled_dy Y k v hv]
    have hpi : 0 < 2 * Real.pi * ((N : ℝ) + 1) := by positivity
    have hki : (N : ℝ) + 1 ≤ |(k 1 : ℝ)| := by exact_mod_cast hk1
    have hfreq :
        2 * Real.pi * ((N : ℝ) + 1) ≤
          ‖2 * Real.pi * Complex.I * (k 1 : ℂ)‖ := by
      have hmul := mul_le_mul_of_nonneg_left hki
        (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) Real.pi_pos.le)
      convert hmul using 1 <;>
        simp [norm_mul, abs_of_pos Real.pi_pos] <;> ring
    have hfreqSq :
        (2 * Real.pi * ((N : ℝ) + 1)) ^ 2 *
            ‖UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 ≤
          ‖(2 * Real.pi * Complex.I * (k 1 : ℂ)) *
              UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 := by
      rw [norm_mul, mul_pow]
      exact mul_le_mul_of_nonneg_right
        (sq_le_sq₀ hpi.le hfreq) (sq_nonneg _)
    calc
      ‖UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 =
          (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
            ((2 * Real.pi * ((N : ℝ) + 1)) ^ 2 *
              ‖UnitAddTorus.mFourierCoeff
                (literalStageTorusTest Y v) k‖ ^ 2) := by
        field_simp [ne_of_gt hpi] <;> ring
      _ ≤ (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
          ‖(2 * Real.pi * Complex.I * (k 1 : ℂ)) *
            UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2 :=
        mul_le_mul_of_nonneg_left hfreqSq (sq_nonneg _)
      _ ≤ (1 / (2 * Real.pi * ((N : ℝ) + 1))) ^ 2 *
          (‖UnitAddTorus.mFourierCoeff
              ((literalStageFourierScale Y : ℂ) •
                literalStageTorusTest Y
                  (HalfWeightCompactCoordinateGreen.dx v)) k‖ ^ 2 +
           ‖(2 * Real.pi * Complex.I * (k 1 : ℂ)) *
              UnitAddTorus.mFourierCoeff (literalStageTorusTest Y v) k‖ ^ 2) := by
        gcongr
        positivity

/-- Quantitative physical rectangle tail for one compact test. -/
theorem norm_planeFourierRemainder_le_derivatives
    (Y : ℝ) (N : ℕ) (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : tsupport (v : ℂ → ℂ) ⊆ literalStageFourierBox Y) :
    ‖literalStagePlaneFiniteProjection Y N
        (ambientTestCoreToPlaneL2Linear v) -
        ambientTestCoreToPlaneL2Linear v‖ ≤
      literalStageFourierScale Y /
          (2 * Real.pi * ((N : ℝ) + 1)) *
        Real.sqrt
          (‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dx v)‖ ^ 2 +
           ‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dy v)‖ ^ 2) := by
  rw [norm_planeFourierRemainder_eq_scale_mul_torusRemainder Y N v hv]
  have htail :=
    RectangleFourierTail.finiteHilbertProjection_tail_le_of_coeff_sq
      P5LocalFourierRellich.twoTorusFourierBasis
      (literalStageFourierModes N)
      (literalStageTorusTest Y v)
      ((literalStageFourierScale Y : ℂ) •
        literalStageTorusTest Y (HalfWeightCompactCoordinateGreen.dx v))
      ((literalStageFourierScale Y : ℂ) •
        literalStageTorusTest Y (HalfWeightCompactCoordinateGreen.dy v))
      (1 / (2 * Real.pi * ((N : ℝ) + 1))) (by positivity)
      (fun k hk ↦ torusFourierCoeff_sq_le_of_not_mem Y N k hk v hv)
  calc
    literalStageFourierScale Y *
        ‖P5LocalFourierRellich.twoTorusFiniteFourierProjection
              (literalStageFourierModes N) (literalStageTorusTest Y v) -
            literalStageTorusTest Y v‖ ≤
      literalStageFourierScale Y *
        (1 / (2 * Real.pi * ((N : ℝ) + 1)) *
          Real.sqrt
            (‖(literalStageFourierScale Y : ℂ) •
                literalStageTorusTest Y
                  (HalfWeightCompactCoordinateGreen.dx v)‖ ^ 2 +
             ‖(literalStageFourierScale Y : ℂ) •
                literalStageTorusTest Y
                  (HalfWeightCompactCoordinateGreen.dy v)‖ ^ 2)) :=
      mul_le_mul_of_nonneg_left htail
        (literalStageFourierScale_pos Y).le
    _ ≤ literalStageFourierScale Y /
          (2 * Real.pi * ((N : ℝ) + 1)) *
        Real.sqrt
          (‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dx v)‖ ^ 2 +
           ‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dy v)‖ ^ 2) := by
      rw [div_eq_mul_inv]
      gcongr
      · exact norm_scale_smul_torusTest_dx_le_plane Y v
      · exact norm_scale_smul_torusTest_dy_le_plane Y v

/-- The uniform rectangle-tail constant on the completed graph unit ball. -/
noncomputable def literalStagePlaneTailConstant (Y : ℝ) (n : ℤ) : ℝ :=
  literalStageFourierScale Y * Real.sqrt 2 *
    literalStageLocalizationConstant Y n / (2 * Real.pi)

theorem literalStagePlaneTailConstant_nonneg (Y : ℝ) (n : ℤ) :
    0 ≤ literalStagePlaneTailConstant Y n := by
  unfold literalStagePlaneTailConstant
  positivity

theorem norm_literalStagePlaneFiniteApproximation_sub_core_le
    (Y : ℝ) (n : ℤ) (N : ℕ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖literalStagePlaneFiniteApproximation Y n N (coreMap n u) -
        completedLiteralStagePlaneBase Y n (coreMap n u)‖ ≤
      (literalStagePlaneTailConstant Y n / ((N : ℝ) + 1)) *
        ‖coreMap n u‖ := by
  rw [literalStagePlaneFiniteApproximation,
    ContinuousLinearMap.comp_apply, completedLiteralStagePlaneBase_core,
    literalStagePlaneBaseCore_apply]
  have htail := norm_planeFourierRemainder_le_derivatives Y N
    (literalStageLocalizedGauge Y n u)
    (tsupport_literalStageLocalizedGauge_subset_fourierBox Y n u)
  refine htail.trans ?_
  have hdx := norm_literalStagePlaneDxCore_le Y n u
  have hdy := norm_literalStagePlaneDyCore_le Y n u
  rw [literalStagePlaneDxCore_apply, literalStagePlaneDyCore_apply] at hdx hdy
  have hsqrt :
      Real.sqrt
          (‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dx
                (literalStageLocalizedGauge Y n u))‖ ^ 2 +
           ‖ambientTestCoreToPlaneL2Linear
              (HalfWeightCompactCoordinateGreen.dy
                (literalStageLocalizedGauge Y n u))‖ ^ 2) ≤
        Real.sqrt 2 * literalStageLocalizationConstant Y n *
          ‖coreMap n u‖ := by
    rw [← Real.sqrt_sq (mul_nonneg
      (mul_nonneg (Real.sqrt_nonneg 2)
        (literalStageLocalizationConstant_nonneg Y n))
      (norm_nonneg (coreMap n u)))]
    gcongr
    rw [Real.sq_sqrt (by positivity)]
    nlinarith [sq_nonneg
      (literalStageLocalizationConstant Y n * ‖coreMap n u‖),
      sq_le_sq₀ (norm_nonneg _) hdx,
      sq_le_sq₀ (norm_nonneg _) hdy]
  calc
    literalStageFourierScale Y /
          (2 * Real.pi * ((N : ℝ) + 1)) * _ ≤
      literalStageFourierScale Y /
          (2 * Real.pi * ((N : ℝ) + 1)) *
        (Real.sqrt 2 * literalStageLocalizationConstant Y n *
          ‖coreMap n u‖) :=
      mul_le_mul_of_nonneg_left hsqrt (by positivity)
    _ = (literalStagePlaneTailConstant Y n / ((N : ℝ) + 1)) *
        ‖coreMap n u‖ := by
      unfold literalStagePlaneTailConstant
      field_simp [Real.pi_ne_zero]
      ring

theorem norm_literalStagePlaneFiniteApproximation_sub_le
    (Y : ℝ) (n : ℤ) (N : ℕ) (x : GraphSobolevCompletion n) :
    ‖literalStagePlaneFiniteApproximation Y n N x -
        completedLiteralStagePlaneBase Y n x‖ ≤
      (literalStagePlaneTailConstant Y n / ((N : ℝ) + 1)) * ‖x‖ := by
  exact (denseRange_coreMap n).induction
    (fun _ ⟨u, rfl⟩ ↦
      norm_literalStagePlaneFiniteApproximation_sub_core_le Y n N u)
    (isClosed_le
      (((literalStagePlaneFiniteApproximation Y n N) -
        completedLiteralStagePlaneBase Y n).continuous.norm)
      (continuous_const.mul continuous_norm)) x

theorem opNorm_literalStagePlaneFiniteApproximation_sub_le
    (Y : ℝ) (n : ℤ) (N : ℕ) :
    ‖literalStagePlaneFiniteApproximation Y n N -
        completedLiteralStagePlaneBase Y n‖ ≤
      literalStagePlaneTailConstant Y n / ((N : ℝ) + 1) := by
  apply ContinuousLinearMap.opNorm_le_bound
    (div_nonneg (literalStagePlaneTailConstant_nonneg Y n) (by positivity))
  intro x
  simpa only [ContinuousLinearMap.sub_apply] using
    norm_literalStagePlaneFiniteApproximation_sub_le Y n N x

theorem literalStagePlaneFiniteApproximation_tendsto
    (Y : ℝ) (n : ℤ) :
    Filter.Tendsto (literalStagePlaneFiniteApproximation Y n) Filter.atTop
      (nhds (completedLiteralStagePlaneBase Y n)) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  exact squeeze_zero
    (fun N ↦ norm_nonneg
      (literalStagePlaneFiniteApproximation Y n N -
        completedLiteralStagePlaneBase Y n))
    (opNorm_literalStagePlaneFiniteApproximation_sub_le Y n)
    (by
      simpa only [div_eq_mul_inv, mul_zero, Nat.cast_add, Nat.cast_one] using
        tendsto_const_nhds.mul
          (tendsto_one_div_add_atTop_nhds_zero_nat :
            Filter.Tendsto (fun N : ℕ ↦ (1 : ℝ) / (N + 1)) Filter.atTop (nhds 0)))

/-- The actual localized physical base coordinate is compact.  This is the
Rellich theorem: finite-rank rectangle projections converge in operator norm,
with the derivative estimate proved above. -/
theorem completedLiteralStagePlaneBase_isCompact
    (Y : ℝ) (n : ℤ) :
    IsCompactOperator (completedLiteralStagePlaneBase Y n) := by
  exact isCompactOperator_of_tendsto
    (literalStagePlaneFiniteApproximation_tendsto Y n)
    (Filter.Eventually.of_forall fun N ↦
      literalStagePlaneFiniteApproximation_isCompact Y n N)

/-! #### From full-plane localization back to the literal stage -/

/-- Restriction of full-plane `L²` to the upper-half-plane subtype. -/
abbrev AmbientUpperPlaneL2 :=
  MeasureTheory.Lp ℂ 2 Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure

theorem upperHalfPlaneCoe_measurableEmbedding :
    MeasurableEmbedding (fun z : ℍ ↦ (z : ℂ)) :=
  MeasurableEmbedding.subtype_coe
    UpperHalfPlane.isOpen_upperHalfPlaneSet.measurableSet

theorem upperHalfPlaneCoe_quasiMeasurePreserving :
    MeasureTheory.Measure.QuasiMeasurePreserving
      (fun z : ℍ ↦ (z : ℂ))
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure (volume : Measure ℂ) := by
  refine ⟨upperHalfPlaneCoe_measurableEmbedding.measurable, ?_⟩
  change (Measure.map (fun z : ℍ ↦ (z : ℂ))
    (Measure.comap (fun z : ℍ ↦ (z : ℂ)) volume)).AbsolutelyContinuous
      volume
  rw [upperHalfPlaneCoe_measurableEmbedding.map_comap]
  exact Measure.absolutelyContinuous_restrict

theorem ambientPlane_comp_upper_memLp (F : AmbientPlaneL2) :
    MemLp (fun z : ℍ ↦ F (z : ℂ)) 2
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
  apply (memLp_two_iff_integrable_sq_norm
    ((Lp.aestronglyMeasurable F).comp_quasiMeasurePreserving
      upperHalfPlaneCoe_quasiMeasurePreserving)).2
  rw [← integrableOn_iff_comap_subtypeVal
    UpperHalfPlane.isOpen_upperHalfPlaneSet.measurableSet]
  exact (Lp.memLp F).integrable_sq_norm.integrableOn

noncomputable def ambientPlaneToUpperLinear :
    AmbientPlaneL2 →ₗ[ℂ] AmbientUpperPlaneL2 where
  toFun F := (ambientPlane_comp_upper_memLp F).toLp
    (fun z : ℍ ↦ F (z : ℂ))
  map_add' F G := by
    apply Lp.ext fun z ↦ ?_
    filter_upwards [MemLp.coeFn_toLp (ambientPlane_comp_upper_memLp (F + G)),
      MemLp.coeFn_toLp (ambientPlane_comp_upper_memLp F),
      MemLp.coeFn_toLp (ambientPlane_comp_upper_memLp G),
      Lp.coeFn_add
        ((ambientPlane_comp_upper_memLp F).toLp fun z : ℍ ↦ F z)
        ((ambientPlane_comp_upper_memLp G).toLp fun z : ℍ ↦ G z),
      Lp.coeFn_add F G] with z hfg hf hg hadd hFG
    simpa [hfg, hf, hg, hadd, hFG]
  map_smul' c F := by
    apply Lp.ext fun z ↦ ?_
    filter_upwards [MemLp.coeFn_toLp
        (ambientPlane_comp_upper_memLp (c • F)),
      MemLp.coeFn_toLp (ambientPlane_comp_upper_memLp F),
      Lp.coeFn_smul c F] with z hcf hf hc
    simpa [hcf, hf, hc]

theorem norm_ambientPlaneToUpperLinear_le (F : AmbientPlaneL2) :
    ‖ambientPlaneToUpperLinear F‖ ≤ ‖F‖ := by
  rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _),
    MeasureTheory.L2.norm_sq_eq_integral]
  calc
    (∫ z : ℍ, ‖ambientPlaneToUpperLinear F z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure) =
      ∫ w in UpperHalfPlane.upperHalfPlaneSet, ‖F w‖ ^ 2 := by
        rw [← integral_subtype_comap
          UpperHalfPlane.isOpen_upperHalfPlaneSet.measurableSet]
        apply integral_congr_ae
        filter_upwards [MemLp.coeFn_toLp
          (ambientPlane_comp_upper_memLp F)] with z hz
        rw [hz]
    _ ≤ ∫ w : ℂ, ‖F w‖ ^ 2 :=
      setIntegral_le_integral (Lp.memLp F).integrable_sq_norm
        (Filter.Eventually.of_forall fun _ ↦ sq_nonneg _)
    _ = ‖F‖ ^ 2 := (MeasureTheory.L2.norm_sq_eq_integral F).symm

noncomputable def ambientPlaneToUpper :
    AmbientPlaneL2 →L[ℂ] AmbientUpperPlaneL2 :=
  ambientPlaneToUpperLinear.mkContinuous 1 fun F ↦ by
    simpa only [one_mul] using norm_ambientPlaneToUpperLinear_le F

/-- Two literal restrictions: first to the chosen carrier and then to the
three-cusp stage. -/
noncomputable def ambientPlaneToLiteralStage (Y : ℝ) :
    AmbientPlaneL2 →L[ℂ] LiteralStageL2 Y :=
  (MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.chosenEuclideanCarrierMeasure 2
      (gammaTwoThreeCuspTruncation Y)).comp
    ((MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure 2
      chosenGammaTwoFundamentalDomain.carrier).comp
        ambientPlaneToUpper)

theorem norm_ambientPlaneToLiteralStage_le
    (Y : ℝ) (F : AmbientPlaneL2) :
    ‖ambientPlaneToLiteralStage Y F‖ ≤ ‖F‖ := by
  calc
    ‖ambientPlaneToLiteralStage Y F‖ ≤
      ‖MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure 2
          chosenGammaTwoFundamentalDomain.carrier
          (ambientPlaneToUpper F)‖ :=
      MeasureTheory.norm_Lp_toLp_restrict_le _ _
    _ ≤ ‖ambientPlaneToUpper F‖ :=
      MeasureTheory.norm_Lp_toLp_restrict_le _ _
    _ ≤ ‖F‖ := norm_ambientPlaneToUpperLinear_le F

/-- On the dense graph core, plane localization followed by literal
restriction is exactly the original physical stage restriction. -/
theorem ambientPlaneToLiteralStage_completedPlaneBase_core
    (Y : ℝ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ambientPlaneToLiteralStage Y
        (completedLiteralStagePlaneBase Y n (coreMap n u)) =
      graphLiteralStageRestriction Y n (coreMap n u) := by
  have hcarrier :=
    (MeasureTheory.LpToLpRestrictCLM_coeFn ℂ
      chosenGammaTwoFundamentalDomain.carrier
      (ambientPlaneToUpper
        (completedLiteralStagePlaneBase Y n (coreMap n u)))).filter_mono
      (ae_mono Measure.restrict_le_self)
  have hupper :=
    (MemLp.coeFn_toLp
      (ambientPlane_comp_upper_memLp
        (completedLiteralStagePlaneBase Y n (coreMap n u)))).filter_mono
      (ae_mono (Measure.restrict_le_self.trans Measure.restrict_le_self))
  have hplaneUpper :
      (fun z : ℍ ↦
        ambientTestCoreToPlaneL2Linear
          (literalStageLocalizedGauge Y n u) (z : ℂ)) =ᵐ[
            Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure]
        fun z : ℍ ↦ literalStageLocalizedGauge Y n u (z : ℂ) := by
    simpa only [Function.comp_apply] using
      upperHalfPlaneCoe_quasiMeasurePreserving.ae_eq_comp
        (coeFn_ambientTestCoreToPlaneL2Linear
          (literalStageLocalizedGauge Y n u))
  have hplane := hplaneUpper.filter_mono
    (ae_mono (Measure.restrict_le_self.trans Measure.restrict_le_self))
  apply Lp.ext fun z ↦ ?_
  filter_upwards [
    coeFn_graphLiteralStageRestriction_core Y n u,
    MeasureTheory.LpToLpRestrictCLM_coeFn ℂ
      (gammaTwoThreeCuspTruncation Y)
      (MeasureTheory.LpToLpRestrictCLM ℍ ℂ ℂ
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure 2
        chosenGammaTwoFundamentalDomain.carrier
        (ambientPlaneToUpper
          (completedLiteralStagePlaneBase Y n (coreMap n u)))),
    hcarrier, hupper, hplane,
    ae_restrict_mem
      (gammaTwoThreeCuspTruncation_isCompact Y).measurableSet]
      with z hgraph hstage hcarrier hupper hplane hzStage
  rw [hgraph, hstage, hcarrier, hupper,
    completedLiteralStagePlaneBase_core,
    literalStagePlaneBaseCore_apply, hplane]
  exact literalStageLocalizedGauge_eq_gauge Y n u hzStage

theorem ambientPlaneToLiteralStage_comp_completedPlaneBase
    (Y : ℝ) (n : ℤ) :
    (ambientPlaneToLiteralStage Y).comp
        (completedLiteralStagePlaneBase Y n) =
      graphLiteralStageRestriction Y n := by
  ext x
  exact (denseRange_coreMap n).induction
    (fun _ ⟨u, rfl⟩ ↦
      ambientPlaneToLiteralStage_completedPlaneBase_core Y n u)
    (isClosed_eq
      ((ambientPlaneToLiteralStage Y).continuous.comp
        (completedLiteralStagePlaneBase Y n).continuous)
      (graphLiteralStageRestriction Y n).continuous) x

/-- Unconditional compactness of the actual literal cusp-height restriction.
No Rellich certificate occurs in the statement or proof. -/
theorem graphLiteralStageRestriction_isCompact_unconditional
    (Y : ℝ) (n : ℤ) :
    IsCompactOperator (graphLiteralStageRestriction Y n) := by
  rw [← ambientPlaneToLiteralStage_comp_completedPlaneBase Y n]
  exact (completedLiteralStagePlaneBase_isCompact Y n).clm_comp
    (ambientPlaneToLiteralStage Y)



end P5PhysicalHardStageRestriction

/-!
#### P5 discriminant hard truncations

The local compactness theorem above is now applied to the *actual*
discriminant multiplier.  The compact quotient set is pulled back inside the
selected closed carrier, captured by one literal height stage, multiplied in
`L∞ · L² → L²`, and paired with the same graph restriction in the test
variable.  The complementary multiplier has explicit `L∞` norm at most
`1/(N+1)`.  Thus the hard-stage operators converge in operator norm.
-/

namespace P5DiscriminantHardTruncation

open Set Function Topology Filter MeasureTheory
open scoped ENNReal NNReal
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open GammaTwoQuotientGeometry
open FixedPhaseClosedOperators
open FixedPhaseClosedOperators.PhysicalLocalL2
open ExplicitDiscriminantPotential
open ExplicitDiscriminantPotential.FixedPhaseGraphPotential
open P5PhysicalHardStageRestriction

/-! ##### A reusable, literal `L∞` multiplier -/

section LpInfinityMultiplier

variable {α : Type*} [MeasurableSpace α] (μ : Measure α)

/-- Heterogeneous Mathlib `L∞ · L² → L²` multiplication as a linear map in
the `L²` entry. -/
noncomputable def lpInfinityMultiplierLinear
    (a : MeasureTheory.Lp ℂ ∞ μ) :
    MeasureTheory.Lp ℂ 2 μ →ₗ[ℂ] MeasureTheory.Lp ℂ 2 μ where
  toFun f := a • f
  map_add' f g := MeasureTheory.Lp.add_smul a f g
  map_smul' c f := by
    rw [← MeasureTheory.Lp.smul_comm c a f,
      MeasureTheory.Lp.smul_assoc]

theorem norm_lpInfinityMultiplierLinear_le
    (a : MeasureTheory.Lp ℂ ∞ μ) (f : MeasureTheory.Lp ℂ 2 μ) :
    ‖lpInfinityMultiplierLinear μ a f‖ ≤ ‖a‖ * ‖f‖ :=
  MeasureTheory.Lp.norm_smul_le a f

/-- Bundled bounded multiplication; its bound is Hölder's inequality, not a
postulated multiplier certificate. -/
noncomputable def lpInfinityMultiplier
    (a : MeasureTheory.Lp ℂ ∞ μ) :
    MeasureTheory.Lp ℂ 2 μ →L[ℂ] MeasureTheory.Lp ℂ 2 μ :=
  (lpInfinityMultiplierLinear μ a).mkContinuous ‖a‖
    (norm_lpInfinityMultiplierLinear_le μ a)

@[simp]
theorem lpInfinityMultiplier_apply
    (a : MeasureTheory.Lp ℂ ∞ μ) (f : MeasureTheory.Lp ℂ 2 μ) :
    lpInfinityMultiplier μ a f = a • f :=
  rfl

theorem norm_lpInfinityMultiplier_le
    (a : MeasureTheory.Lp ℂ ∞ μ) :
    ‖lpInfinityMultiplier μ a‖ ≤ ‖a‖ :=
  LinearMap.mkContinuous_norm_le _ (norm_nonneg a)
    (norm_lpInfinityMultiplierLinear_le μ a)

end LpInfinityMultiplier

/-! ##### The actual compact quotient stage and its carrier lift -/

/-- Compact quotient stage selected by the already proved discriminant tail
height. -/
def discriminantHardQuotientStage (N : ℕ) : Set GammaTwoQuotient :=
  gammaTwoQuotientMk ''
    gammaTwoThreeCuspTruncation (discriminantLiteralCuspLevel N)

theorem discriminantHardQuotientStage_isCompact (N : ℕ) :
    IsCompact (discriminantHardQuotientStage N) :=
  (gammaTwoThreeCuspTruncation_isCompact
    (discriminantLiteralCuspLevel N)).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous

theorem discriminantHardQuotientStage_measurableSet (N : ℕ) :
    MeasurableSet (discriminantHardQuotientStage N) :=
  (discriminantHardQuotientStage_isCompact N).measurableSet

/-- All representatives of the compact quotient stage in the selected
closed carrier. -/
def discriminantHardCarrierLift (N : ℕ) : Set ℍ :=
  gammaTwoClosedTileCarrier ∩
    gammaTwoQuotientMk ⁻¹' discriminantHardQuotientStage N

theorem discriminantHardCarrierLift_isCompact (N : ℕ) :
    IsCompact (discriminantHardCarrierLift N) :=
  gammaTwoClosedCarrier_inter_preimage_isCompact _
    (discriminantHardQuotientStage_isCompact N)

theorem discriminantHardCarrierLift_subset_closedCarrier (N : ℕ) :
    discriminantHardCarrierLift N ⊆ gammaTwoClosedTileCarrier :=
  Set.inter_subset_left

theorem exists_discriminantHardLiteralStage (N : ℕ) :
    ∃ Z : ℝ, 1 < Z ∧
      discriminantHardCarrierLift N ⊆ gammaTwoThreeCuspTruncation Z :=
  compact_closedTileCarrier_subset_threeCuspTruncation
    (discriminantHardCarrierLift_isCompact N)
    (discriminantHardCarrierLift_subset_closedCarrier N)

/-- One literal stage containing every selected-carrier representative of
the `N`-th compact quotient stage. -/
noncomputable def discriminantHardLiteralStage (N : ℕ) : ℝ :=
  Classical.choose (exists_discriminantHardLiteralStage N)

theorem one_lt_discriminantHardLiteralStage (N : ℕ) :
    1 < discriminantHardLiteralStage N :=
  (Classical.choose_spec (exists_discriminantHardLiteralStage N)).1

theorem discriminantHardCarrierLift_subset_literalStage (N : ℕ) :
    discriminantHardCarrierLift N ⊆
      gammaTwoThreeCuspTruncation (discriminantHardLiteralStage N) :=
  (Classical.choose_spec (exists_discriminantHardLiteralStage N)).2

/-! ##### Hard and complementary physical weights -/

/-- Hard discriminant weight on the literal stage. -/
noncomputable def discriminantHardStageWeight
    (N : ℕ) (z : ℍ) : ℂ :=
  if gammaTwoQuotientMk z ∈ discriminantHardQuotientStage N then
    (upstairsPotential z : ℂ)
  else 0

/-- Complementary carrier weight. -/
noncomputable def discriminantTailCarrierWeight
    (N : ℕ) (z : ℍ) : ℂ :=
  if gammaTwoQuotientMk z ∈ discriminantHardQuotientStage N then
    0
  else (upstairsPotential z : ℂ)

/-- The untruncated carrier weight. -/
noncomputable def discriminantFullCarrierWeight (z : ℍ) : ℂ :=
  (upstairsPotential z : ℂ)

theorem discriminantHardStageWeight_measurable (N : ℕ) :
    Measurable (discriminantHardStageWeight N) := by
  unfold discriminantHardStageWeight
  exact (Complex.ofRealCLM.measurable.comp
    upstairsPotential_continuous.measurable).ite
      ((discriminantHardQuotientStage_measurableSet N).preimage
        gammaTwoQuotientMk_isOpenQuotientMap.continuous.measurable)
      measurable_const

theorem discriminantTailCarrierWeight_measurable (N : ℕ) :
    Measurable (discriminantTailCarrierWeight N) := by
  unfold discriminantTailCarrierWeight
  exact measurable_const.ite
      ((discriminantHardQuotientStage_measurableSet N).preimage
        gammaTwoQuotientMk_isOpenQuotientMap.continuous.measurable)
      (Complex.ofRealCLM.measurable.comp
        upstairsPotential_continuous.measurable)

theorem discriminantFullCarrierWeight_measurable :
    Measurable discriminantFullCarrierWeight :=
  Complex.ofRealCLM.measurable.comp upstairsPotential_continuous.measurable

theorem norm_discriminantHardStageWeight_le
    (N : ℕ) (z : ℍ) :
    ‖discriminantHardStageWeight N z‖ ≤ uniformBound := by
  unfold discriminantHardStageWeight
  split_ifs
  · simpa only [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (upstairsPotential_nonneg z)] using
      upstairsPotential_le_uniformBound z
  · simpa using uniformBound_pos.le

theorem norm_discriminantFullCarrierWeight_le (z : ℍ) :
    ‖discriminantFullCarrierWeight z‖ ≤ uniformBound := by
  simpa only [discriminantFullCarrierWeight, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (upstairsPotential_nonneg z)] using
      upstairsPotential_le_uniformBound z

/-- The complementary weight has the literal discriminant cusp bound. -/
theorem norm_discriminantTailCarrierWeight_le
    (N : ℕ) (z : ℍ) :
    ‖discriminantTailCarrierWeight N z‖ ≤ discriminantCuspEpsilon N := by
  unfold discriminantTailCarrierWeight
  split_ifs with hz
  · simpa using discriminantCuspEpsilon_nonneg N
  · simpa only [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (upstairsPotential_nonneg z), ← potential_mk] using
      potential_le_discriminantCuspEpsilon_outside_literalStage N
        (gammaTwoQuotientMk z) hz

theorem discriminantFull_eq_hard_add_tail (N : ℕ) (z : ℍ) :
    discriminantFullCarrierWeight z =
      discriminantHardStageWeight N z +
        discriminantTailCarrierWeight N z := by
  unfold discriminantFullCarrierWeight discriminantHardStageWeight
    discriminantTailCarrierWeight
  split_ifs <;> simp

/-- The hard weight is zero, on the selected carrier, outside its containing
literal stage. -/
theorem discriminantHardStageWeight_eq_zero_outside_literalStage
    (N : ℕ) {z : ℍ} (hzCarrier : z ∈ gammaTwoClosedTileCarrier)
    (hzStage : z ∉ gammaTwoThreeCuspTruncation
      (discriminantHardLiteralStage N)) :
    discriminantHardStageWeight N z = 0 := by
  unfold discriminantHardStageWeight
  rw [if_neg]
  intro hzK
  exact hzStage (discriminantHardCarrierLift_subset_literalStage N
    ⟨hzCarrier, hzK⟩)

/-- Hard stage weight as an actual `L∞` vector. -/
theorem discriminantHardStageWeight_memLp (N : ℕ) :
    MemLp (discriminantHardStageWeight N) ∞
      (P5PhysicalHardStageRestriction.literalStageMeasure
        (discriminantHardLiteralStage N)) :=
  memLp_top_of_bound
    (discriminantHardStageWeight_measurable N).aestronglyMeasurable
    uniformBound
    (Filter.Eventually.of_forall
      (norm_discriminantHardStageWeight_le N))

noncomputable def discriminantHardStageWeightLp (N : ℕ) :
    MeasureTheory.Lp ℂ ∞
      (P5PhysicalHardStageRestriction.literalStageMeasure
        (discriminantHardLiteralStage N)) :=
  (discriminantHardStageWeight_memLp N).toLp
    (discriminantHardStageWeight N)

theorem coeFn_discriminantHardStageWeightLp (N : ℕ) :
    ⇑(discriminantHardStageWeightLp N) =ᵐ[
      P5PhysicalHardStageRestriction.literalStageMeasure
        (discriminantHardLiteralStage N)]
      discriminantHardStageWeight N :=
  MemLp.coeFn_toLp (discriminantHardStageWeight_memLp N)

theorem norm_discriminantHardStageWeightLp_le (N : ℕ) :
    ‖discriminantHardStageWeightLp N‖ ≤ uniformBound := by
  rw [discriminantHardStageWeightLp, Lp.norm_toLp,
    eLpNorm_exponent_top]
  have hess := eLpNormEssSup_le_of_ae_bound
    (μ := P5PhysicalHardStageRestriction.literalStageMeasure
      (discriminantHardLiteralStage N))
    (Filter.Eventually.of_forall
      (norm_discriminantHardStageWeight_le N))
  exact (ENNReal.toReal_mono ENNReal.ofReal_ne_top hess).trans_eq
      (by simp [uniformBound_pos.le])

/-- Tail weight as an actual global carrier `L∞` vector. -/
theorem discriminantTailCarrierWeight_memLp (N : ℕ) :
    MemLp (discriminantTailCarrierWeight N) ∞
      chosenEuclideanCarrierMeasure :=
  memLp_top_of_bound
    (discriminantTailCarrierWeight_measurable N).aestronglyMeasurable
    (discriminantCuspEpsilon N)
    (Filter.Eventually.of_forall
      (norm_discriminantTailCarrierWeight_le N))

noncomputable def discriminantTailCarrierWeightLp (N : ℕ) :
    MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure :=
  (discriminantTailCarrierWeight_memLp N).toLp
    (discriminantTailCarrierWeight N)

theorem norm_discriminantTailCarrierWeightLp_le (N : ℕ) :
    ‖discriminantTailCarrierWeightLp N‖ ≤ discriminantCuspEpsilon N := by
  rw [discriminantTailCarrierWeightLp, Lp.norm_toLp,
    eLpNorm_exponent_top]
  have hess := eLpNormEssSup_le_of_ae_bound
    (μ := chosenEuclideanCarrierMeasure)
    (Filter.Eventually.of_forall
      (norm_discriminantTailCarrierWeight_le N))
  exact (ENNReal.toReal_mono ENNReal.ofReal_ne_top hess).trans_eq
      (by simp [discriminantCuspEpsilon_nonneg N])

theorem discriminantFullCarrierWeight_memLp :
    MemLp discriminantFullCarrierWeight ∞ chosenEuclideanCarrierMeasure :=
  memLp_top_of_bound
    discriminantFullCarrierWeight_measurable.aestronglyMeasurable
    uniformBound
    (Filter.Eventually.of_forall norm_discriminantFullCarrierWeight_le)

noncomputable def discriminantFullCarrierWeightLp :
    MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure :=
  discriminantFullCarrierWeight_memLp.toLp
    discriminantFullCarrierWeight

theorem coeFn_discriminantFullCarrierWeightLp :
    ⇑discriminantFullCarrierWeightLp =ᵐ[chosenEuclideanCarrierMeasure]
      discriminantFullCarrierWeight :=
  MemLp.coeFn_toLp discriminantFullCarrierWeight_memLp

theorem discriminantHardCarrierWeight_memLp (N : ℕ) :
    MemLp (discriminantHardStageWeight N) ∞
      chosenEuclideanCarrierMeasure :=
  memLp_top_of_bound
    (discriminantHardStageWeight_measurable N).aestronglyMeasurable
    uniformBound
    (Filter.Eventually.of_forall
      (norm_discriminantHardStageWeight_le N))

noncomputable def discriminantHardCarrierWeightLp (N : ℕ) :
    MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure :=
  (discriminantHardCarrierWeight_memLp N).toLp
    (discriminantHardStageWeight N)

theorem coeFn_discriminantHardCarrierWeightLp (N : ℕ) :
    ⇑(discriminantHardCarrierWeightLp N) =ᵐ[
      chosenEuclideanCarrierMeasure]
      discriminantHardStageWeight N :=
  MemLp.coeFn_toLp (discriminantHardCarrierWeight_memLp N)

theorem coeFn_discriminantTailCarrierWeightLp (N : ℕ) :
    ⇑(discriminantTailCarrierWeightLp N) =ᵐ[
      chosenEuclideanCarrierMeasure]
      discriminantTailCarrierWeight N :=
  MemLp.coeFn_toLp (discriminantTailCarrierWeight_memLp N)

/-! ##### Weighted graph pullbacks and hard-stage factorization -/

/-- The concrete Euclidean base coordinate of the graph completion. -/
noncomputable def graphEuclideanBase (n : ℤ) :
    GraphSobolevCompletion n →L[ℂ] OrbitEuclideanL2 n :=
  (orbitPeterssonEuclideanEmbedding n).comp (baseExtension n)

theorem norm_graphEuclideanBase_le (n : ℤ)
    (u : GraphSobolevCompletion n) :
    ‖graphEuclideanBase n u‖ ≤ ‖u‖ := by
  rw [graphEuclideanBase, ContinuousLinearMap.comp_apply,
    orbitPeterssonEuclideanEmbedding_norm]
  exact norm_baseExtension_le n u

theorem coeFn_graphEuclideanBase_core
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ⇑(graphEuclideanBase n (coreMap n u)) =ᵐ[
      chosenEuclideanCarrierMeasure]
      fixedPhaseEuclideanGauge n u := by
  simpa only [graphEuclideanBase, ContinuousLinearMap.comp_apply,
    baseExtension_core] using
      coeFn_embedding_l2Coordinate_fixedPhaseGauge n u

/-- Pull an actual carrier `L∞` multiplier back to the graph space. -/
noncomputable def weightedGraphLinear (n : ℤ)
    (a : MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure) :
    GraphSobolevCompletion n →ₗ[ℂ]
      GraphSobolevCompletion n →ₗ⋆[ℂ] ℂ where
  toFun u :=
    { toFun := fun v ↦ inner ℂ (graphEuclideanBase n v)
        (lpInfinityMultiplier chosenEuclideanCarrierMeasure a
          (graphEuclideanBase n u))
      map_add' := fun v w ↦ by simp
      map_smul' := fun c v ↦ by simp }
  map_add' u w := by
    ext v
    simp [lpInfinityMultiplier_apply, MeasureTheory.Lp.add_smul]
  map_smul' c u := by
    ext v
    simp [lpInfinityMultiplier_apply, ← MeasureTheory.Lp.smul_comm,
      MeasureTheory.Lp.smul_assoc]

theorem weightedGraphLinear_bound (n : ℤ)
    (a : MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure)
    (u v : GraphSobolevCompletion n) :
    ‖weightedGraphLinear n a u v‖ ≤ ‖a‖ * ‖u‖ * ‖v‖ := by
  calc
    ‖weightedGraphLinear n a u v‖ ≤
      ‖graphEuclideanBase n v‖ *
        ‖lpInfinityMultiplier chosenEuclideanCarrierMeasure a
          (graphEuclideanBase n u)‖ := norm_inner_le_norm _ _
    _ ≤ ‖graphEuclideanBase n v‖ *
        (‖a‖ * ‖graphEuclideanBase n u‖) :=
      mul_le_mul_of_nonneg_left
        (norm_lpInfinityMultiplierLinear_le
          chosenEuclideanCarrierMeasure a (graphEuclideanBase n u))
        (norm_nonneg _)
    _ ≤ ‖v‖ * (‖a‖ * ‖u‖) := by
      gcongr
      · exact norm_graphEuclideanBase_le n v
      · exact norm_graphEuclideanBase_le n u
    _ = ‖a‖ * ‖u‖ * ‖v‖ := by ring

noncomputable def weightedGraphOperator (n : ℤ)
    (a : MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure) :
    WeakAntiOperator (GraphSobolevCompletion n) :=
  (weightedGraphLinear n a).mkContinuous₂ ‖a‖
    (weightedGraphLinear_bound n a)

theorem norm_weightedGraphOperator_le (n : ℤ)
    (a : MeasureTheory.Lp ℂ ∞ chosenEuclideanCarrierMeasure) :
    ‖weightedGraphOperator n a‖ ≤ ‖a‖ :=
  LinearMap.mkContinuous₂_norm_le _ (norm_nonneg a)
    (weightedGraphLinear_bound n a)

/-- Stage pairing used in the compact factorization. -/
noncomputable def discriminantHardStagePairingLinear
    (N : ℕ) (n : ℤ) :
    P5PhysicalHardStageRestriction.LiteralStageL2
        (discriminantHardLiteralStage N) →ₗ[ℂ]
      StrongAntiDual (GraphSobolevCompletion n) where
  toFun f :=
    { toFun := fun v ↦
        inner ℂ
          (graphLiteralStageRestriction
            (discriminantHardLiteralStage N) n v)
          (lpInfinityMultiplier
            (P5PhysicalHardStageRestriction.literalStageMeasure
              (discriminantHardLiteralStage N))
            (discriminantHardStageWeightLp N) f)
      map_add' := fun v w ↦ by simp
      map_smul' := fun c v ↦ by simp }
  map_add' f g := by
    ext v
    simp [lpInfinityMultiplier_apply, MeasureTheory.Lp.add_smul]
  map_smul' c f := by
    ext v
    simp [lpInfinityMultiplier_apply, ← MeasureTheory.Lp.smul_comm,
      MeasureTheory.Lp.smul_assoc]

theorem discriminantHardStagePairingLinear_bound
    (N : ℕ) (n : ℤ)
    (f : P5PhysicalHardStageRestriction.LiteralStageL2
      (discriminantHardLiteralStage N))
    (v : GraphSobolevCompletion n) :
    ‖discriminantHardStagePairingLinear N n f v‖ ≤
      uniformBound * ‖f‖ * ‖v‖ := by
  calc
    ‖discriminantHardStagePairingLinear N n f v‖ ≤
      ‖graphLiteralStageRestriction
          (discriminantHardLiteralStage N) n v‖ *
        ‖lpInfinityMultiplier
          (P5PhysicalHardStageRestriction.literalStageMeasure
            (discriminantHardLiteralStage N))
          (discriminantHardStageWeightLp N) f‖ := norm_inner_le_norm _ _
    _ ≤ ‖v‖ * (uniformBound * ‖f‖) := by
      gcongr
      · exact norm_graphLiteralStageRestriction_le _ _ _
      · exact (norm_lpInfinityMultiplierLinear_le _ _ _).trans
          (mul_le_mul_of_nonneg_right
            (norm_discriminantHardStageWeightLp_le N) (norm_nonneg f))
    _ = uniformBound * ‖f‖ * ‖v‖ := by ring

noncomputable def discriminantHardStagePotentialPairing
    (N : ℕ) (n : ℤ) :
    P5PhysicalHardStageRestriction.LiteralStageL2
        (discriminantHardLiteralStage N) →L[ℂ]
      StrongAntiDual (GraphSobolevCompletion n) :=
  (discriminantHardStagePairingLinear N n).mkContinuous₂ uniformBound
    (discriminantHardStagePairingLinear_bound N n)

/-- Literal hard-stage approximant. -/
noncomputable def discriminantHardStageOperator
    (N : ℕ) (n : ℤ) :
    WeakAntiOperator (GraphSobolevCompletion n) :=
  (discriminantHardStagePotentialPairing N n).comp
    (graphLiteralStageRestriction
      (discriminantHardLiteralStage N) n)

theorem discriminantHardStageOperator_isCompact
    (N : ℕ) (n : ℤ) :
    IsCompactOperator (discriminantHardStageOperator N n) :=
  hardStagePotentialFactor_isCompact n
    (graphLiteralStageRestriction
      (discriminantHardLiteralStage N) n)
    (discriminantHardStagePotentialPairing N n)
    (graphLiteralStageRestriction_isCompact_unconditional
      (discriminantHardLiteralStage N) n)

/-! ##### Identification with the global discriminant form -/

/-- On the smooth graph core, the full carrier multiplier is the original
quotient potential integral. -/
theorem weightedFull_apply_core
    (n : ℤ) (u v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    weightedGraphOperator n discriminantFullCarrierWeightLp
        (coreMap n u) (coreMap n v) =
      potentialForm (OrbitMultiplier n)
        chosenGammaTwoFundamentalDomain
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u) := by
  let U := Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u
  let V := Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n v
  calc
    weightedGraphOperator n discriminantFullCarrierWeightLp
        (coreMap n u) (coreMap n v) =
      ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        inner ℂ (fixedPhaseEuclideanGauge n v z)
          ((upstairsPotential z : ℂ) *
            fixedPhaseEuclideanGauge n u z)
        ∂upperEuclideanMeasure := by
      rw [MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [
        coeFn_graphEuclideanBase_core n v,
        coeFn_graphEuclideanBase_core n u,
        coeFn_discriminantFullCarrierWeightLp,
        MeasureTheory.Lp.coeFn_lpSMul
          discriminantFullCarrierWeightLp
          (graphEuclideanBase n (coreMap n u))] with z hv hu hw hmul
      simp only [weightedGraphOperator, weightedGraphLinear,
        lpInfinityMultiplier_apply]
      rw [hv, hmul, hw, hu]
      rfl
    _ = ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        hyperbolicDensity z •
          ((upstairsPotential z : ℂ) *
            upstairsInnerDensity (OrbitMultiplier n) V U z)
        ∂upperEuclideanMeasure := by
      apply integral_congr_ae
      filter_upwards with z
      rw [show inner ℂ (fixedPhaseEuclideanGauge n v z)
          ((upstairsPotential z : ℂ) *
            fixedPhaseEuclideanGauge n u z) =
        (upstairsPotential z : ℂ) *
          inner ℂ (fixedPhaseEuclideanGauge n v z)
            (fixedPhaseEuclideanGauge n u z) by
          rw [inner_smul_right, smul_eq_mul]]
      rw [show inner ℂ (fixedPhaseEuclideanGauge n v z)
          (fixedPhaseEuclideanGauge n u z) =
        hyperbolicDensity z •
          upstairsInnerDensity (OrbitMultiplier n) V U z by
        simpa only [fixedPhaseEuclideanGauge, V, U] using
          orbitEuclideanGauge_inner n (coreEmbedding n v)
            (coreEmbedding n u) z]
      simp only [NNReal.smul_def, smul_eq_mul]
      ring
    _ = ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        (upstairsPotential z : ℂ) *
          upstairsInnerDensity (OrbitMultiplier n) V U z
        ∂hyperbolicMeasure := by
      rw [hyperbolicMeasure_eq_euclidean_withDensity,
        setIntegral_withDensity_eq_setIntegral_smul
          hyperbolicDensity_measurable _
          chosenGammaTwoFundamentalDomain.carrier_measurable]
    _ = potentialForm (OrbitMultiplier n)
        chosenGammaTwoFundamentalDomain V U := by
      unfold potentialForm
      rw [chosenGammaTwoFundamentalDomain.integral_quotientMeasure_eq _
        (weightedInnerDensity_integrable (OrbitMultiplier n)
          chosenGammaTwoFundamentalDomain V U).aestronglyMeasurable]
      apply integral_congr_ae
      filter_upwards with z
      simp only [weightedInnerDensity, potential_mk,
        quotientInnerDensity_mk, V, U]

/-- The full carrier multiplier is exactly the previously constructed
quotient discriminant operator. -/
theorem graphPotentialOperator_eq_weightedFull (n : ℤ) :
    graphPotentialOperator n =
      weightedGraphOperator n discriminantFullCarrierWeightLp := by
  ext u v
  refine (denseRange_coreMap n).induction_on u
    (isClosed_eq
      ((ContinuousLinearMap.apply' ℂ (starRingEnd ℂ) v).continuous.comp
        (graphPotentialOperator n).continuous)
      ((ContinuousLinearMap.apply' ℂ (starRingEnd ℂ) v).continuous.comp
        (weightedGraphOperator n discriminantFullCarrierWeightLp).continuous)) ?_
  intro u₀
  refine (denseRange_coreMap n).induction_on v
    (isClosed_eq
      (graphPotentialOperator n (coreMap n u₀)).continuous
      (weightedGraphOperator n discriminantFullCarrierWeightLp
        (coreMap n u₀)).continuous) ?_
  intro v₀
  rw [graphPotentialOperator_apply_core,
    weightedFull_apply_core]

/-- Hard multiplication on the global carrier agrees with the literal-stage
factorization because every carrier point where the hard weight is nonzero
lies in the chosen literal stage. -/
theorem discriminantHardStageOperator_eq_weightedHard
    (N : ℕ) (n : ℤ) :
    discriminantHardStageOperator N n =
      weightedGraphOperator n (discriminantHardCarrierWeightLp N) := by
  ext u v
  simp only [discriminantHardStageOperator,
    ContinuousLinearMap.comp_apply,
    discriminantHardStagePotentialPairing,
    discriminantHardStagePairingLinear,
    weightedGraphOperator, weightedGraphLinear,
    lpInfinityMultiplier_apply]
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  let Z := discriminantHardLiteralStage N
  let Φ : ℍ → ℂ := fun z ↦
    inner ℂ (graphEuclideanBase n v z)
      (discriminantHardStageWeight N z * graphEuclideanBase n u z)
  calc
    (∫ z,
        inner ℂ (graphLiteralStageRestriction Z n v z)
          ((discriminantHardStageWeightLp N •
            graphLiteralStageRestriction Z n u :
              P5PhysicalHardStageRestriction.LiteralStageL2 Z) z)
        ∂P5PhysicalHardStageRestriction.literalStageMeasure Z) =
      ∫ z in gammaTwoThreeCuspTruncation Z, Φ z
        ∂chosenEuclideanCarrierMeasure := by
      apply integral_congr_ae
      filter_upwards [
        coeFn_graphLiteralStageRestriction Z n v,
        coeFn_graphLiteralStageRestriction Z n u,
        coeFn_discriminantHardStageWeightLp N,
        MeasureTheory.Lp.coeFn_lpSMul
          (discriminantHardStageWeightLp N)
          (graphLiteralStageRestriction Z n u)] with z hv hu hw hmul
      rw [hv, hmul, hw, hu]
      rfl
    _ = ∫ z, Φ z ∂chosenEuclideanCarrierMeasure :=
      setIntegral_eq_integral_of_ae_compl_eq_zero (by
        filter_upwards [ae_restrict_mem
          chosenGammaTwoFundamentalDomain.carrier_measurable] with z hzCarrier hz
        have hzClosed : z ∈ gammaTwoClosedTileCarrier := by
          rwa [gammaTwoClosedTileCarrier_eq_chosenCarrier]
        rw [discriminantHardStageWeight_eq_zero_outside_literalStage
          N hzClosed hz]
        simp [Φ])
    _ = ∫ z,
        inner ℂ (graphEuclideanBase n v z)
          ((discriminantHardCarrierWeightLp N •
            graphEuclideanBase n u : OrbitEuclideanL2 n) z)
        ∂chosenEuclideanCarrierMeasure := by
      apply integral_congr_ae
      filter_upwards [
        coeFn_discriminantHardCarrierWeightLp N,
        MeasureTheory.Lp.coeFn_lpSMul
          (discriminantHardCarrierWeightLp N)
          (graphEuclideanBase n u)] with z hw hmul
      rw [hmul, hw]
      rfl

/-- Pointwise splitting of full multiplication into hard and tail parts,
lifted to the graph weak anti-operator. -/
theorem weightedFull_sub_weightedHard_eq_weightedTail
    (N : ℕ) (n : ℤ) :
    weightedGraphOperator n discriminantFullCarrierWeightLp -
      discriminantHardStageOperator N n =
    weightedGraphOperator n (discriminantTailCarrierWeightLp N) := by
  ext u v
  rw [discriminantHardStageOperator_eq_weightedHard]
  simp only [ContinuousLinearMap.sub_apply, weightedGraphOperator,
    weightedGraphLinear, lpInfinityMultiplier_apply]
  rw [← inner_sub_right]
  congr 2
  apply Lp.ext fun z ↦ ?_
  filter_upwards [
    coeFn_discriminantFullCarrierWeightLp,
    coeFn_discriminantTailCarrierWeightLp N,
    coeFn_discriminantHardCarrierWeightLp N,
    MeasureTheory.Lp.coeFn_lpSMul discriminantFullCarrierWeightLp
      (graphEuclideanBase n u),
    MeasureTheory.Lp.coeFn_lpSMul (discriminantTailCarrierWeightLp N)
      (graphEuclideanBase n u)] with z hfull htail hhard hfullmul htailmul
  rw [hfullmul, htailmul, hfull, htail, hhard,
    discriminantFull_eq_hard_add_tail]
  ring

theorem norm_discriminantHardStageOperator_sub_graphPotential_le
    (N : ℕ) (n : ℤ) :
    ‖discriminantHardStageOperator N n - graphPotentialOperator n‖ ≤
      discriminantCuspEpsilon N := by
  rw [graphPotentialOperator_eq_weightedFull]
  have hsplit := weightedFull_sub_weightedHard_eq_weightedTail N n
  rw [← neg_sub, norm_neg, hsplit]
  exact (norm_weightedGraphOperator_le n
    (discriminantTailCarrierWeightLp N)).trans
      (norm_discriminantTailCarrierWeightLp_le N)

/-- Final P5 endpoint: the actual pointwise scalar discriminant potential is
compact from the fixed-phase graph completion to its strong anti-dual.  The
proof uses finite-rank physical Fourier projections on literal cusp-height
stages and the explicit discriminant cusp tail; there is no abstract Rellich
certificate, no rank-one replacement, and no residual hypothesis. -/
theorem graphPotentialOperator_isCompact_unconditional (n : ℤ) :
    IsCompactOperator
      (ExplicitDiscriminantPotential.FixedPhaseGraphPotential.graphPotentialOperator n) := by
  exact graphPotentialOperator_isCompact_of_literalStageFactorization n
    (fun N ↦ graphLiteralStageRestriction
      (discriminantHardLiteralStage N) n)
    (fun N ↦ discriminantHardStagePotentialPairing N n)
    (fun N ↦ graphLiteralStageRestriction_isCompact_unconditional
      (discriminantHardLiteralStage N) n)
    (fun N ↦ by
      simpa only [discriminantHardStageOperator] using
        norm_discriminantHardStageOperator_sub_graphPotential_le N n)

end P5DiscriminantHardTruncation

