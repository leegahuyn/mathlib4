/-!
## P10/P11: manuscript correction and honest dependency audit

This fragment is appended after `P11ActualSpectralFoundations`.  It has two
purposes.

* It strengthens the arithmetic layer with an explicit reduced-residue
  half-step phase sum.  Every estimate proved for it is a finite-sum or
  summability theorem from the imported Mathlib API.
* It records the exact dependency boundary of the spectral argument as data,
  not as an analytic certificate.  In particular, no value of the audit data
  is an Eisenstein expansion, a Plancherel theorem, a Kuznetsov formula, or a
  Weil estimate, and no theorem below constructs one.

The endpoint combines the manuscript correction firewall with a model showing
that all currently discharged Gaussian/finite-arithmetic facts coexist with
valid lower and upper estimates having no crossover.  Thus those facts cannot
silently manufacture the missing spectral and arithmetic inputs.
-/

namespace Mock2FA.PaperCorrections.P10P11HonestDependencyAudit

open Set Complex Filter
open scoped BigOperators Topology

noncomputable section

/-! ### 1. Generic finite unit-phase estimates -/

section GenericFinitePhase

variable {ι : Type*} [Fintype ι]

/-- Triangle inequality for a finite family of unit complex phases, with the
cardinality constant made explicit. -/
theorem norm_fintype_unitPhase_sum_le_card
    (φ : ι → ℂ) (hφ : ∀ x, ‖φ x‖ = 1) :
    ‖∑ x, φ x‖ ≤ Fintype.card ι := by
  calc
    ‖∑ x, φ x‖ ≤ ∑ x, ‖φ x‖ := norm_sum_le _ _
    _ = ∑ _x : ι, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro x _hx
      exact hφ x
    _ = Fintype.card ι := by simp

/-- The constant unit phase attains the preceding cardinality bound. -/
theorem norm_fintype_constantUnitPhase_sum :
    ‖∑ _x : ι, (1 : ℂ)‖ = Fintype.card ι := by
  simp

/-- No bound strictly below cardinality follows uniformly from unit modulus
alone.  This is independent of the particular arithmetic phase chosen later. -/
theorem no_strict_fintype_bound_from_unitModulus_alone :
    ¬ ∃ C : ℝ, C < Fintype.card ι ∧
      ∀ φ : ι → ℂ, (∀ x, ‖φ x‖ = 1) → ‖∑ x, φ x‖ ≤ C := by
  rintro ⟨C, hC, hbound⟩
  have hone := hbound (fun _ ↦ (1 : ℂ)) (by simp)
  rw [norm_fintype_constantUnitPhase_sum] at hone
  exact (not_le_of_gt hC) hone

end GenericFinitePhase

section GenericFinsetPhase

variable {ι : Type*}

/-- Finset form of the same triangle inequality.  This is the form used for a
reduced residue system. -/
theorem norm_finset_unitPhase_sum_le_card
    (s : Finset ι) (φ : ι → ℂ)
    (hφ : ∀ x ∈ s, ‖φ x‖ = 1) :
    ‖∑ x ∈ s, φ x‖ ≤ s.card := by
  calc
    ‖∑ x ∈ s, φ x‖ ≤ ∑ x ∈ s, ‖φ x‖ := norm_sum_le _ _
    _ = ∑ _x ∈ s, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro x hx
      exact hφ x hx
    _ = s.card := by simp

/-- Constant phases saturate the finset cardinality estimate. -/
theorem norm_finset_constantUnitPhase_sum (s : Finset ι) :
    ‖∑ _x ∈ s, (1 : ℂ)‖ = s.card := by
  simp

/-- The saturation obstruction also holds on an arbitrary prescribed finite
support. -/
theorem no_strict_finset_bound_from_unitModulus_alone (s : Finset ι) :
    ¬ ∃ C : ℝ, C < s.card ∧
      ∀ φ : ι → ℂ,
        (∀ x ∈ s, ‖φ x‖ = 1) → ‖∑ x ∈ s, φ x‖ ≤ C := by
  rintro ⟨C, hC, hbound⟩
  have hone := hbound (fun _ ↦ (1 : ℂ)) (by simp)
  rw [norm_finset_constantUnitPhase_sum] at hone
  exact (not_le_of_gt hC) hone

end GenericFinsetPhase

/-! ### 2. An explicit reduced-residue half-step phase model

This is deliberately named a `PhaseSum`, not a proved Kuznetsov Kloosterman
sum.  It supplies genuine finite arithmetic data: a coprime residue support,
an explicit half-step exponential phase, exact unit modulus, and a uniform
trivial bound.  It does not assert multiplier cancellation.
-/

open P11ActualSpectralFoundations

/-- The reduced residue support in the canonical representatives
`0, ..., q`. -/
def reducedResidues (q : ℕ) : Finset ℕ :=
  (Finset.range (phaseModulus q)).filter
    (fun x ↦ Nat.Coprime x (phaseModulus q))

theorem reducedResidues_subset_range (q : ℕ) :
    reducedResidues q ⊆ Finset.range (phaseModulus q) := by
  exact Finset.filter_subset _ _

/-- The reduced residue support has at most the full modulus cardinality. -/
theorem card_reducedResidues_le_phaseModulus (q : ℕ) :
    (reducedResidues q).card ≤ phaseModulus q := by
  calc
    (reducedResidues q).card ≤
        (Finset.range (phaseModulus q)).card :=
      Finset.card_le_card (reducedResidues_subset_range q)
    _ = phaseModulus q := Finset.card_range _

/-- Explicit real argument on the reduced residue support.  The odd `x` term
is the half-step contribution.  No inverse-residue identity is claimed. -/
def reducedResidueHalfPhaseArgument
    (q m n x : ℕ) : ℝ :=
  2 * Real.pi *
    (((2 * m * x + 2 * n * x ^ 2 + x : ℕ) : ℝ) /
      (2 * phaseModulus q : ℕ))

/-- Explicit unit complex phase on a reduced residue representative. -/
def reducedResidueHalfPhase
    (q m n x : ℕ) : ℂ :=
  Complex.exp (Complex.I * reducedResidueHalfPhaseArgument q m n x)

@[simp]
theorem norm_reducedResidueHalfPhase
    (q m n x : ℕ) :
    ‖reducedResidueHalfPhase q m n x‖ = 1 := by
  simpa [reducedResidueHalfPhase] using
    Complex.norm_exp_I_mul_ofReal
      (reducedResidueHalfPhaseArgument q m n x)

theorem reducedResidueHalfPhase_ne_zero
    (q m n x : ℕ) :
    reducedResidueHalfPhase q m n x ≠ 0 := by
  intro hzero
  have hnorm := congrArg norm hzero
  simpa using hnorm

/-- The literal finite reduced-residue half-step phase sum. -/
def reducedResidueHalfPhaseSum (q m n : ℕ) : ℂ :=
  ∑ x ∈ reducedResidues q, reducedResidueHalfPhase q m n x

/-- The parameter family is measurable because its domain is countable. -/
theorem reducedResidueHalfPhaseSum_measurable (q : ℕ) :
    Measurable (fun mn : ℕ × ℕ ↦
      reducedResidueHalfPhaseSum q mn.1 mn.2) :=
  measurable_of_countable _

/-- Trivial bound by the number of reduced residues. -/
theorem norm_reducedResidueHalfPhaseSum_le_card
    (q m n : ℕ) :
    ‖reducedResidueHalfPhaseSum q m n‖ ≤
      (reducedResidues q).card := by
  rw [reducedResidueHalfPhaseSum]
  exact norm_finset_unitPhase_sum_le_card
    (reducedResidues q) (reducedResidueHalfPhase q m n)
      (fun x _hx ↦ norm_reducedResidueHalfPhase q m n x)

/-- The same estimate with a modulus-only majorant. -/
theorem norm_reducedResidueHalfPhaseSum_le_phaseModulus
    (q m n : ℕ) :
    ‖reducedResidueHalfPhaseSum q m n‖ ≤ phaseModulus q := by
  exact (norm_reducedResidueHalfPhaseSum_le_card q m n).trans
    (by exact_mod_cast card_reducedResidues_le_phaseModulus q)

/-- Normalization by the nonzero full modulus, avoiding any empty-support
division branch. -/
def modulusNormalizedReducedResidueHalfPhaseSum
    (q m n : ℕ) : ℂ :=
  reducedResidueHalfPhaseSum q m n / (phaseModulus q : ℂ)

theorem modulusNormalizedReducedResidueHalfPhaseSum_measurable
    (q : ℕ) :
    Measurable (fun mn : ℕ × ℕ ↦
      modulusNormalizedReducedResidueHalfPhaseSum q mn.1 mn.2) :=
  measurable_of_countable _

/-- The normalized reduced-residue phase sum lies in the closed unit disk. -/
theorem norm_modulusNormalizedReducedResidueHalfPhaseSum_le_one
    (q m n : ℕ) :
    ‖modulusNormalizedReducedResidueHalfPhaseSum q m n‖ ≤ 1 := by
  rw [modulusNormalizedReducedResidueHalfPhaseSum, norm_div]
  rw [Complex.norm_natCast]
  apply (div_le_one (by simp [phaseModulus] :
    (0 : ℝ) < phaseModulus q)).2
  exact norm_reducedResidueHalfPhaseSum_le_phaseModulus q m n

/-! ### 3. Absolute convergence from an honest `ℓ¹` kernel -/

/-- Weight a normalized arithmetic family by a complex scalar sequence. -/
def l1WeightedReducedResidueTerm
    (w : ℕ → ℂ) (c m n : ℕ) : ℂ :=
  w c * modulusNormalizedReducedResidueHalfPhaseSum c m n

/-- Pointwise domination by the norm of the supplied scalar kernel. -/
theorem norm_l1WeightedReducedResidueTerm_le
    (w : ℕ → ℂ) (c m n : ℕ) :
    ‖l1WeightedReducedResidueTerm w c m n‖ ≤ ‖w c‖ := by
  rw [l1WeightedReducedResidueTerm, norm_mul]
  calc
    ‖w c‖ * ‖modulusNormalizedReducedResidueHalfPhaseSum c m n‖ ≤
        ‖w c‖ * 1 :=
      mul_le_mul_of_nonneg_left
        (norm_modulusNormalizedReducedResidueHalfPhaseSum_le_one c m n)
        (norm_nonneg (w c))
    _ = ‖w c‖ := mul_one _

/-- Any genuinely `ℓ¹` modulus kernel gives absolute convergence, uniformly
with respect to the two arithmetic parameters. -/
theorem summable_norm_l1WeightedReducedResidueTerm
    (w : ℕ → ℂ) (hw : Summable (fun c ↦ ‖w c‖))
    (m n : ℕ) :
    Summable (fun c ↦ ‖l1WeightedReducedResidueTerm w c m n‖) :=
  hw.of_nonneg_of_le
    (fun c ↦ norm_nonneg (l1WeightedReducedResidueTerm w c m n))
    (fun c ↦ norm_l1WeightedReducedResidueTerm_le w c m n)

/-- Therefore the complex weighted arithmetic series itself converges. -/
theorem summable_l1WeightedReducedResidueTerm
    (w : ℕ → ℂ) (hw : Summable (fun c ↦ ‖w c‖))
    (m n : ℕ) :
    Summable (fun c ↦ l1WeightedReducedResidueTerm w c m n) :=
  (summable_norm_l1WeightedReducedResidueTerm w hw m n).of_norm

/-- The already imported geometric series provides one concrete nonzero
kernel, so this is an inhabited summability result rather than a certificate. -/
def geometricReducedResidueTerm (c m n : ℕ) : ℂ :=
  l1WeightedReducedResidueTerm (fun j ↦ (1 / 2 : ℂ) ^ j) c m n

theorem norm_geometricReducedResidueTerm_le
    (c m n : ℕ) :
    ‖geometricReducedResidueTerm c m n‖ ≤ (1 / 2 : ℝ) ^ c := by
  rw [geometricReducedResidueTerm]
  calc
    ‖l1WeightedReducedResidueTerm (fun j ↦ (1 / 2 : ℂ) ^ j) c m n‖ ≤
        ‖(1 / 2 : ℂ) ^ c‖ :=
      norm_l1WeightedReducedResidueTerm_le _ c m n
    _ = (1 / 2 : ℝ) ^ c := by
      rw [norm_pow]
      norm_num

theorem summable_norm_geometricReducedResidueTerm (m n : ℕ) :
    Summable (fun c ↦ ‖geometricReducedResidueTerm c m n‖) :=
  summable_geometric_two.of_nonneg_of_le
    (fun c ↦ norm_nonneg (geometricReducedResidueTerm c m n))
    (fun c ↦ norm_geometricReducedResidueTerm_le c m n)

theorem summable_geometricReducedResidueTerm (m n : ℕ) :
    Summable (geometricReducedResidueTerm · m n) :=
  (summable_norm_geometricReducedResidueTerm m n).of_norm

/-! ### 4. Sharpness and uniform-activity firewalls -/

/-- Constant phases on the actual reduced-residue support attain its exact
cardinality. -/
def saturatedReducedResiduePhaseSum (q : ℕ) : ℂ :=
  ∑ _x ∈ reducedResidues q, (1 : ℂ)

theorem norm_saturatedReducedResiduePhaseSum (q : ℕ) :
    ‖saturatedReducedResiduePhaseSum q‖ =
      (reducedResidues q).card := by
  simp [saturatedReducedResiduePhaseSum]

/-- Hence reduced support plus unit modulus still does not imply arithmetic
cancellation. -/
theorem no_strict_reducedResidue_bound_from_unitModulus_alone (q : ℕ) :
    ¬ ∃ C : ℝ, C < (reducedResidues q).card ∧
      ∀ φ : ℕ → ℂ,
        (∀ x ∈ reducedResidues q, ‖φ x‖ = 1) →
          ‖∑ x ∈ reducedResidues q, φ x‖ ≤ C :=
  no_strict_finset_bound_from_unitModulus_alone (reducedResidues q)

/-- A positive discrete activity profile that decays toward the cusp/spectral
tail. -/
def positiveDiscreteTailActivity (m : ℕ) : ℝ :=
  1 / ((m : ℝ) + 1)

theorem positiveDiscreteTailActivity_pos (m : ℕ) :
    0 < positiveDiscreteTailActivity m := by
  rw [positiveDiscreteTailActivity]
  positivity

theorem positiveDiscreteTailActivity_nonneg (m : ℕ) :
    0 ≤ positiveDiscreteTailActivity m :=
  (positiveDiscreteTailActivity_pos m).le

/-- Pointwise strict positivity on an infinite index set still does not imply
one index-independent positive lower bound. -/
theorem positiveDiscreteTailActivity_has_no_uniformLowerActivity_univ :
    ¬ P11ConditionalReduction.HasUniformLowerActivity
      positiveDiscreteTailActivity Set.univ := by
  rintro ⟨δ, hδ, hgap⟩
  obtain ⟨m, hm⟩ := exists_nat_gt (1 / δ)
  have hmul : 1 < (m : ℝ) * δ := by
    exact (div_lt_iff₀ hδ).mp hm
  have hden : 0 < (m : ℝ) + 1 := by positivity
  have htail : positiveDiscreteTailActivity m < δ := by
    rw [positiveDiscreteTailActivity, div_lt_iff₀ hden]
    nlinarith
  exact (not_le_of_gt htail) (hgap m (Set.mem_univ m))

/-! ### 5. A compatible comparison model with no crossover -/

/-- Statistic witnessing compatibility of a fixed lower bound with a growing
upper bound. -/
def compatibleAuditStatistic (_m : ℕ) : ℝ := 1

def compatibleAuditLower (_m : ℕ) : ℝ := 1

def compatibleAuditUpper (m : ℕ) : ℝ := (m : ℝ) + 1

def compatibleAuditIndices : Set ℕ := Set.univ

theorem compatibleAudit_lowerEstimate :
    ∀ m ∈ compatibleAuditIndices,
      compatibleAuditLower m ≤ compatibleAuditStatistic m := by
  intro m _hm
  simp [compatibleAuditLower, compatibleAuditStatistic]

theorem compatibleAudit_upperEstimate :
    ∀ m, |compatibleAuditStatistic m| ≤ compatibleAuditUpper m := by
  intro m
  simp [compatibleAuditStatistic, compatibleAuditUpper]

theorem compatibleAudit_has_no_crossover :
    ¬ ∃ m ∈ compatibleAuditIndices,
      compatibleAuditUpper m < compatibleAuditLower m := by
  rintro ⟨m, _hm, hcross⟩
  simp [compatibleAuditUpper, compatibleAuditLower] at hcross

/-- Consequently the exact final input predicate is not inhabited by this
compatible model. -/
theorem compatibleAudit_not_exactLowerUpperCrossoverInput :
    ¬ P11ConditionalReduction.ExactLowerUpperCrossoverInput
      compatibleAuditStatistic compatibleAuditLower compatibleAuditUpper
      compatibleAuditIndices := by
  intro h
  exact compatibleAudit_has_no_crossover h.2.2

/-- All currently discharged Gaussian and normalized finite-arithmetic facts
coexist with valid lower/upper estimates having no crossover.  This is the
formal non-substitution theorem for the P11 boundary. -/
theorem availableFoundation_coexists_with_noCrossover :
    P11ActualSpectralFoundations.IsEvenEntireGaussianStripTest
        (P11ActualSpectralFoundations.evenEntireGaussian 1) 1 1 ∧
      (∀ q m n,
        ‖modulusNormalizedReducedResidueHalfPhaseSum q m n‖ ≤ 1) ∧
      (∀ m ∈ compatibleAuditIndices,
        compatibleAuditLower m ≤ compatibleAuditStatistic m) ∧
      (∀ m,
        |compatibleAuditStatistic m| ≤ compatibleAuditUpper m) ∧
      ¬ ∃ m ∈ compatibleAuditIndices,
        compatibleAuditUpper m < compatibleAuditLower m := by
  refine ⟨P11ActualSpectralFoundations.evenEntireGaussian_isEvenEntireGaussianStripTest
        (a := 1) (σ := 1) (by norm_num) (by norm_num), ?_,
      compatibleAudit_lowerEstimate, compatibleAudit_upperEstimate,
      compatibleAudit_has_no_crossover⟩
  exact norm_modulusNormalizedReducedResidueHalfPhaseSum_le_one

/-! ### 6. Lean-level manuscript dependency map

`AuditDisposition` is project metadata.  In particular, `externalMathematics`
does not assert that a theorem is impossible or absent from every library; it
asserts only that this source has not supplied the corresponding mathematical
construction.  No proof below eliminates an `externalMathematics` node by
turning it into a hypothesis-bearing certificate.
-/

inductive AuditDisposition where
  | discharged
  | refuted
  | logicalReductionOnly
  | externalMathematics
  deriving DecidableEq, Repr

inductive AuditNode where
  | cuspLocalParameter
  | quotientGlobalQRadius
  | shiftedEqualsUnshifted
  | scatteringUnitarityForcesPositivity
  | nonnegativityForcesUniformGap
  | exponentAbsorbedIntoConstant
  | nonzeroCompactTentIsEntire
  | rankinEndpointBetaOneIntegrable
  | boundednessForcesStrongPrecompactness
  | evenEntireGaussianTest
  | finiteReducedResiduePhase
  | l1WeightedModulusSeries
  | eisensteinNormalization
  | scatteringPlancherel
  | halfIntegralKuznetsovIdentity
  | multiplierKloostermanCancellation
  | actualUniformLowerActivity
  | actualStatisticLowerEstimate
  | actualStatisticUpperEstimate
  | actualCrossover
  | finalContradiction
  deriving DecidableEq, Repr

/-- Exact audit classification.  This is reducible data, not a field storing
the missing mathematics. -/
def auditDisposition : AuditNode → AuditDisposition
  | .cuspLocalParameter => .discharged
  | .quotientGlobalQRadius => .refuted
  | .shiftedEqualsUnshifted => .refuted
  | .scatteringUnitarityForcesPositivity => .refuted
  | .nonnegativityForcesUniformGap => .refuted
  | .exponentAbsorbedIntoConstant => .refuted
  | .nonzeroCompactTentIsEntire => .refuted
  | .rankinEndpointBetaOneIntegrable => .refuted
  | .boundednessForcesStrongPrecompactness => .refuted
  | .evenEntireGaussianTest => .discharged
  | .finiteReducedResiduePhase => .discharged
  | .l1WeightedModulusSeries => .discharged
  | .eisensteinNormalization => .externalMathematics
  | .scatteringPlancherel => .externalMathematics
  | .halfIntegralKuznetsovIdentity => .externalMathematics
  | .multiplierKloostermanCancellation => .externalMathematics
  | .actualUniformLowerActivity => .externalMathematics
  | .actualStatisticLowerEstimate => .externalMathematics
  | .actualStatisticUpperEstimate => .externalMathematics
  | .actualCrossover => .externalMathematics
  | .finalContradiction => .logicalReductionOnly

/-- Immediate mathematical dependency, oriented from a downstream conclusion
to one prerequisite. -/
inductive ImmediateDependency : AuditNode → AuditNode → Prop
  | kuznetsov_needs_test :
      ImmediateDependency .halfIntegralKuznetsovIdentity
        .evenEntireGaussianTest
  | kuznetsov_needs_eisensteinNormalization :
      ImmediateDependency .halfIntegralKuznetsovIdentity
        .eisensteinNormalization
  | kuznetsov_needs_plancherel :
      ImmediateDependency .halfIntegralKuznetsovIdentity
        .scatteringPlancherel
  | lowerEstimate_needs_kuznetsov :
      ImmediateDependency .actualStatisticLowerEstimate
        .halfIntegralKuznetsovIdentity
  | lowerEstimate_needs_uniformActivity :
      ImmediateDependency .actualStatisticLowerEstimate
        .actualUniformLowerActivity
  | upperEstimate_needs_kuznetsov :
      ImmediateDependency .actualStatisticUpperEstimate
        .halfIntegralKuznetsovIdentity
  | upperEstimate_needs_cancellation :
      ImmediateDependency .actualStatisticUpperEstimate
        .multiplierKloostermanCancellation
  | final_needs_lowerEstimate :
      ImmediateDependency .finalContradiction
        .actualStatisticLowerEstimate
  | final_needs_upperEstimate :
      ImmediateDependency .finalContradiction
        .actualStatisticUpperEstimate
  | final_needs_crossover :
      ImmediateDependency .finalContradiction .actualCrossover

/-- Positive transitive closure of the explicit dependency relation. -/
inductive DependsOn : AuditNode → AuditNode → Prop
  | direct {a b} : ImmediateDependency a b → DependsOn a b
  | trans {a b c} : DependsOn a b → DependsOn b c → DependsOn a c

theorem finalContradiction_dependsOn_halfIntegralKuznetsovIdentity :
    DependsOn .finalContradiction .halfIntegralKuznetsovIdentity := by
  exact DependsOn.trans
    (DependsOn.direct ImmediateDependency.final_needs_lowerEstimate)
    (DependsOn.direct ImmediateDependency.lowerEstimate_needs_kuznetsov)

theorem finalContradiction_dependsOn_eisensteinNormalization :
    DependsOn .finalContradiction .eisensteinNormalization := by
  exact DependsOn.trans
    finalContradiction_dependsOn_halfIntegralKuznetsovIdentity
    (DependsOn.direct
      ImmediateDependency.kuznetsov_needs_eisensteinNormalization)

theorem finalContradiction_dependsOn_scatteringPlancherel :
    DependsOn .finalContradiction .scatteringPlancherel := by
  exact DependsOn.trans
    finalContradiction_dependsOn_halfIntegralKuznetsovIdentity
    (DependsOn.direct ImmediateDependency.kuznetsov_needs_plancherel)

theorem finalContradiction_dependsOn_multiplierKloostermanCancellation :
    DependsOn .finalContradiction .multiplierKloostermanCancellation := by
  exact DependsOn.trans
    (DependsOn.direct ImmediateDependency.final_needs_upperEstimate)
    (DependsOn.direct ImmediateDependency.upperEstimate_needs_cancellation)

theorem finalContradiction_dependsOn_actualUniformLowerActivity :
    DependsOn .finalContradiction .actualUniformLowerActivity := by
  exact DependsOn.trans
    (DependsOn.direct ImmediateDependency.final_needs_lowerEstimate)
    (DependsOn.direct ImmediateDependency.lowerEstimate_needs_uniformActivity)

theorem finalContradiction_dependsOn_actualCrossover :
    DependsOn .finalContradiction .actualCrossover :=
  DependsOn.direct ImmediateDependency.final_needs_crossover

/-! ### 7. Manuscript-wide correction endpoint -/

/-- One unconditional conjunction exposing the principal manuscript
corrections already proved in the integrated source. -/
theorem manuscriptCorrectionFirewall_endpoint :
    (∀ κ z,
      ‖AutomorphicSobolev.GammaTwoFundamentalDomain.gammaTwoLocalCuspQ κ z‖ < 1) ∧
    (¬ ∃ z : ℍ,
      1 ≤ ‖Function.Periodic.qParam 1 (z : ℂ)‖) ∧
    (¬ ∀ J : ScalarScatteringJet, 0 < J.logDerivativeReal) ∧
    (¬ ∃ ε : ℝ, 0 < ε ∧
      ∀ x : ℝ, ε ≤ nonnegativeActivityWithoutGap x) ∧
    (¬ ∃ C : ℝ, 0 ≤ C ∧
      ∀ x : ℝ, 0 ≤ x → x ^ 2 ≤ C * x) ∧
    shiftedOperator (0 : ℝ →L[ℝ] ℝ) 1 1 = (1 : ℝ) ∧
    (0 : ℝ →L[ℝ] ℝ) 1 ≠ (1 : ℝ) := by
  refine ⟨?_, no_upperHalfPlane_point_with_qParam_norm_ge_one,
    unitary_scattering_does_not_force_positive_logDerivative,
    nonnegativeActivityWithoutGap_has_no_uniform_positive_lowerBound,
    quadratic_growth_not_uniformly_absorbed_by_linear, ?_⟩
  · intro κ z
    exact AutomorphicSobolev.GammaTwoFundamentalDomain.gammaTwoLocalCuspQ_norm_lt_one κ z
  · exact shifted_not_unshifted_counterexample

/-- Final audit endpoint.  The first components are concrete theorems; the
last components are the visible external-mathematics dependency paths. -/
theorem p10P11_honestDependencyAudit_endpoint :
    auditDisposition .quotientGlobalQRadius = .refuted ∧
    auditDisposition .shiftedEqualsUnshifted = .refuted ∧
    auditDisposition .scatteringUnitarityForcesPositivity = .refuted ∧
