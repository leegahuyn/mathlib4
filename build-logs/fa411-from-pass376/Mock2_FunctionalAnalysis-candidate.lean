/-!
================================================================================
P3.7 completion: intrinsic cutoff smoothness and uniform hyperbolic gradient

The maximum-height function is only asserted to be continuous globally.  This
is enough: below the positive log-height region the cutoff is locally one,
whereas on the transition shell it is locally the logarithmic height in one
fixed integral Mobius chart.  The derivative estimate is obtained independently
from the global hyperbolic Lipschitz estimate.  In particular its constant is
independent of the cutoff level.
================================================================================
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseIntrinsicAdjointCutoff

open Set Function Topology Filter MeasureTheory Metric
open scoped LinearPMap ContDiff
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open HalfWeightDifferentialOperators
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseDensity
open FixedPhaseClosedOperators
open FixedPhaseEssentialCoreRoute
open FixedPhaseAdjointCutoffCore
open FixedPhaseGoodCuspCutoffBridge

/-! #### Real smoothness on the transition shell -/

/-- The ambient complex chart of an arbitrary integral special-linear
transformation.  It is defined through the real matrix action so that the
existing strict derivative theorem applies literally. -/
noncomputable def integralMoebiusChart
    (g : SL(2, ℤ)) (w : ℂ) : ℂ :=
  (((g : GL (Fin 2) ℝ) • UpperHalfPlane.ofComplex w : ℍ) : ℂ)

theorem integralMoebius_det_pos (g : SL(2, ℤ)) :
    0 < ((g : GL (Fin 2) ℝ)).val.det := by
  simp

theorem integralMoebiusChart_hasStrictDerivAt
    (g : SL(2, ℤ)) (z : ℍ) :
    HasStrictDerivAt (integralMoebiusChart g)
      (((g : GL (Fin 2) ℝ)).val.det /
        UpperHalfPlane.denom (g : GL (Fin 2) ℝ) z ^ 2) (z : ℂ) := by
  simpa only [integralMoebiusChart] using
    UpperHalfPlane.hasStrictDerivAt_smul
      (integralMoebius_det_pos g) z

/-- The integral Mobius chart is real `C-infinity` on the open upper
half-plane. -/
theorem integralMoebiusChart_realContDiffOn (g : SL(2, ℤ)) :
    ContDiffOn ℝ ∞ (integralMoebiusChart g)
      UpperHalfPlane.upperHalfPlaneSet := by
  letI : IsScalarTower ℝ ℂ ℂ := IsScalarTower.complexToReal
  have hDifferentiable : DifferentiableOn ℂ (integralMoebiusChart g)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro w hw
    simpa using
      (HasDerivAt.differentiableAt
        (integralMoebiusChart_hasStrictDerivAt g
          (⟨w, hw⟩ : ℍ)).hasDerivAt).differentiableWithinAt
  exact ContDiffOn.restrict_scalars ℝ
    ((hDifferentiable.analyticOnNhd
      UpperHalfPlane.isOpen_upperHalfPlaneSet).contDiffOn_of_completeSpace)

/-- Logarithmic height in one fixed integral Mobius chart. -/
noncomputable def integralLogHeightChart
    (g : SL(2, ℤ)) (w : ℂ) : ℝ :=
  Real.log (integralMoebiusChart g w).im

theorem integralLogHeightChart_realContDiffOn (g : SL(2, ℤ)) :
    ContDiffOn ℝ ∞ (integralLogHeightChart g)
      UpperHalfPlane.upperHalfPlaneSet := by
  have hIm : ContDiffOn ℝ ∞
      (fun w : ℂ ↦ (integralMoebiusChart g w).im)
      UpperHalfPlane.upperHalfPlaneSet :=
    Complex.imCLM.contDiff.comp_contDiffOn
      (integralMoebiusChart_realContDiffOn g)
  unfold integralLogHeightChart
  exact hIm.log (fun w hw ↦ by
    change (((g : GL (Fin 2) ℝ) •
      UpperHalfPlane.ofComplex w : ℍ).im) ≠ 0
    exact ne_of_gt (UpperHalfPlane.im_pos _))

/-- Pull the local maximizing-chart identity from the subtype to the ambient
upper-half-plane chart. -/
theorem modularLogMaxHeight_upperLift_eventuallyEq_chart
    {z : ℍ} (hz : 0 < modularLogMaxHeight z) :
    (fun w : ℂ ↦ modularLogMaxHeight (UpperHalfPlane.ofComplex w)) =ᶠ[
        nhds[UpperHalfPlane.upperHalfPlaneSet] (z : ℂ)]
      integralLogHeightChart (modularHeightMaximizer z) := by
  have hMap : Filter.Tendsto UpperHalfPlane.ofComplex
      (nhds[UpperHalfPlane.upperHalfPlaneSet] (z : ℂ)) (nhds z) := by
    simpa only [UpperHalfPlane.ofComplex_apply_of_im_pos z.im_pos] using
      (UpperHalfPlane.ofComplex.continuousOn
        (x := (z : ℂ)) z.im_pos)
  have hLocal := hMap
    (modularLogMaxHeight_eventuallyEq_chart_of_pos hz)
  filter_upwards [hLocal] with w hw
  simpa only [integralLogHeightChart, integralMoebiusChart] using hw

/-- The intrinsic cutoff is genuinely real smooth.  At nonpositive
log-height it is locally the constant one; at positive log-height it is a
smooth composition with one fixed maximizing chart. -/
theorem intrinsicCuspCutoff_realSmooth (N : ℕ) :
    RealSmooth (intrinsicCuspCutoff N) := by
  unfold RealSmooth
  intro w hw
  let z : ℍ := ⟨w, hw⟩
  by_cases hz : 0 < modularLogMaxHeight z
  · let g : SL(2, ℤ) := modularHeightMaximizer z
    let chartCutoff : ℂ → ℂ := fun v ↦
      ((Real.smoothTransition
        (((N : ℝ) + 2) - integralLogHeightChart g v) : ℝ) : ℂ)
    have hChart : ContDiffWithinAt ℝ ∞ chartCutoff
        UpperHalfPlane.upperHalfPlaneSet (z : ℂ) := by
      have hLog := (integralLogHeightChart_realContDiffOn g)
        (z : ℂ) z.im_pos
      have hArg : ContDiffWithinAt ℝ ∞
          (fun v : ℂ ↦ ((N : ℝ) + 2) - integralLogHeightChart g v)
          UpperHalfPlane.upperHalfPlaneSet (z : ℂ) :=
        contDiffWithinAt_const.sub hLog
      have hReal : ContDiffWithinAt ℝ ∞
          (fun v : ℂ ↦ Real.smoothTransition
            (((N : ℝ) + 2) - integralLogHeightChart g v))
          UpperHalfPlane.upperHalfPlaneSet (z : ℂ) :=
        Real.smoothTransition.contDiffAt.comp_contDiffWithinAt (z : ℂ) hArg
      simpa only [chartCutoff, Complex.ofRealCLM_apply] using
        Complex.ofRealCLM.contDiff.contDiffAt.comp_contDiffWithinAt
          (z : ℂ) hReal
    have hEq : upperLift (intrinsicCuspCutoff N) =ᶠ[
        nhds[UpperHalfPlane.upperHalfPlaneSet] (z : ℂ)] chartCutoff := by
      have hLocal := modularLogMaxHeight_upperLift_eventuallyEq_chart hz
      filter_upwards [hLocal] with v hv
      simp only [upperLift, Function.comp_def, intrinsicCuspCutoff,
        intrinsicCuspCutoffReal, chartCutoff, g, hv]
    exact hChart.congr_of_eventuallyEq_of_mem hEq z.im_pos
  · have hzle : modularLogMaxHeight z ≤ 0 := le_of_not_gt hz
    have hRhoNhds : {q : ℍ | modularLogMaxHeight q < 1} ∈ nhds z := by
      exact (isOpen_lt continuous_const modularLogMaxHeight_continuous).mem_nhds (by simpa only [Set.mem_setOf_eq] using hzle.trans_lt zero_lt_one)
    have hMap : Filter.Tendsto UpperHalfPlane.ofComplex
        (nhds[UpperHalfPlane.upperHalfPlaneSet] (z : ℂ)) (nhds z) := by
      simpa only [UpperHalfPlane.ofComplex_apply_of_im_pos z.im_pos] using
        (UpperHalfPlane.ofComplex.continuousOn
          (x := (z : ℂ)) z.im_pos)
    have hPulled := hMap hRhoNhds
    have hEq : upperLift (intrinsicCuspCutoff N) =ᶠ[
        nhds[UpperHalfPlane.upperHalfPlaneSet] (z : ℂ)]
        (fun _ : ℂ ↦ (1 : ℂ)) := by
      filter_upwards [hPulled] with v hv
      change intrinsicCuspCutoff N (UpperHalfPlane.ofComplex v) = 1
      rw [intrinsicCuspCutoff]
      norm_cast
      apply intrinsicCuspCutoffReal_eq_one_of_logHeight_le
      have hN : (1 : ℝ) ≤ (N : ℝ) + 1 := by positivity
      exact hv.le.trans hN
    exact contDiffWithinAt_const.congr_of_eventuallyEq_of_mem hEq z.im_pos

/-! #### A level-independent Lipschitz and derivative bound -/

/-- `smoothTransition` is globally Lipschitz.  Compactness is needed only on
`[0,1]`; the projection identity handles both constant tails. -/
theorem exists_smoothTransition_lipschitz :
    ∃ K : ℝ≥0, LipschitzWith K Real.smoothTransition := by
  obtain ⟨K, hK⟩ :=
    Real.smoothTransition.contDiff.contDiffOn.exists_lipschitzOnWith
      (by simp) convex_Icc isCompact_Icc
  refine ⟨K, ?_⟩
  rw [lipschitzWith_iff_dist_le_mul]
  intro x y
  let px := projIcc (0 : ℝ) 1 zero_le_one x
  let py := projIcc (0 : ℝ) 1 zero_le_one y
  have hpx : (px : ℝ) ∈ Icc (0 : ℝ) 1 := px.property
  have hpy : (py : ℝ) ∈ Icc (0 : ℝ) 1 := py.property
  have hProj : dist (px : ℝ) (py : ℝ) ≤ 1 * dist x y := by
    simpa only [px, py, Subtype.dist_eq] using
      (LipschitzWith.projIcc zero_le_one).dist_le x y
  calc
    dist (Real.smoothTransition x) (Real.smoothTransition y) =
        dist (Real.smoothTransition (px : ℝ))
          (Real.smoothTransition (py : ℝ)) := by
      rw [Real.smoothTransition.projIcc, Real.smoothTransition.projIcc]
    _ ≤ (K : ℝ) * dist (px : ℝ) (py : ℝ) := hK.dist_le hpx hpy
    _ ≤ (K : ℝ) * (1 * dist x y) :=
      mul_le_mul_of_nonneg_left hProj K.coe_nonneg
    _ = (K : ℝ) * dist x y := by ring

/-- Canonical global Lipschitz constant used by every intrinsic cutoff. -/
noncomputable def intrinsicTransitionLipschitzConstant : ℝ≥0 :=
  Classical.choose exists_smoothTransition_lipschitz

theorem smoothTransition_lipschitz :
    LipschitzWith intrinsicTransitionLipschitzConstant
      Real.smoothTransition :=
  Classical.choose_spec exists_smoothTransition_lipschitz

theorem intrinsicCuspCutoffReal_lipschitz
    (N : ℕ) :
    LipschitzWith intrinsicTransitionLipschitzConstant
      (intrinsicCuspCutoffReal N) := by
  rw [lipschitzWith_iff_dist_le_mul]
  intro z w
  calc
    dist (intrinsicCuspCutoffReal N z)
        (intrinsicCuspCutoffReal N w) ≤
      (intrinsicTransitionLipschitzConstant : ℝ) *
        dist (((N : ℝ) + 2) - modularLogMaxHeight z)
          (((N : ℝ) + 2) - modularLogMaxHeight w) :=
      smoothTransition_lipschitz.dist_le _ _
    _ = (intrinsicTransitionLipschitzConstant : ℝ) *
        dist (modularLogMaxHeight z) (modularLogMaxHeight w) := by
      congr 1
      simpa only [Real.dist_eq] using
        abs_neg (modularLogMaxHeight z - modularLogMaxHeight w)
    _ ≤ (intrinsicTransitionLipschitzConstant : ℝ) * dist z w :=
      mul_le_mul_of_nonneg_left
        (modularLogMaxHeight_dist_le z w)
        intrinsicTransitionLipschitzConstant.coe_nonneg

/-- A local comparison between the Poincare distance and the Euclidean chart
distance.  The deliberately non-sharp factor two keeps the later uniform
gradient estimate elementary. -/
theorem upperHalfPlane_dist_le_two_div_im_mul_dist
    (z : ℍ) {w : ℂ} (hw : z.im / 2 < w.im) :
    dist (UpperHalfPlane.ofComplex w) z ≤
      (2 / z.im) * dist w (z : ℂ) := by
  have hwpos : 0 < w.im := (by linarith [z.im_pos] : 0 < w.im)
  have hsqrtPos : 0 < Real.sqrt (w.im * z.im) :=
    Real.sqrt_pos.2 (mul_pos hwpos z.im_pos)
  have hhalf : z.im / 2 ≤ Real.sqrt (w.im * z.im) := by
    rw [Real.le_sqrt (by positivity) (by positivity)]
    nlinarith [z.im_pos]
  have hfactor : 1 ≤ (2 / z.im) * Real.sqrt (w.im * z.im) := by
    have hy : z.im ≤ 2 * Real.sqrt (w.im * z.im) := by linarith
    calc
      (1 : ℝ) = z.im / z.im := (div_self z.im_ne_zero).symm
      _ ≤ (2 * Real.sqrt (w.im * z.im)) / z.im :=
        div_le_div_of_nonneg_right hy z.im_pos.le
      _ = (2 / z.im) * Real.sqrt (w.im * z.im) := by ring
  have hDiv : dist w (z : ℂ) / Real.sqrt (w.im * z.im) ≤
      (2 / z.im) * dist w (z : ℂ) := by
    rw [div_le_iff₀ hsqrtPos]
    calc
      dist w (z : ℂ) = 1 * dist w (z : ℂ) := by ring
      _ ≤ ((2 / z.im) * Real.sqrt (w.im * z.im)) *
          dist w (z : ℂ) :=
        mul_le_mul_of_nonneg_right hfactor (dist_nonneg)
      _ = ((2 / z.im) * dist w (z : ℂ)) *
          Real.sqrt (w.im * z.im) := by ring
  calc
    dist (UpperHalfPlane.ofComplex w) z ≤
        dist ((UpperHalfPlane.ofComplex w : ℍ) : ℂ) (z : ℂ) /
          Real.sqrt ((UpperHalfPlane.ofComplex w).im * z.im) :=
      UpperHalfPlane.dist_le_dist_coe_div_sqrt _ _
    _ = dist w (z : ℂ) / Real.sqrt (w.im * z.im) := by
      rw [UpperHalfPlane.ofComplex_apply_of_im_pos hwpos]
    _ ≤ (2 / z.im) * dist w (z : ℂ) := hDiv

/-- Euclidean Frechet derivative of the complex-valued cutoff, measured in
the hyperbolically natural scale.  The right-hand side is independent of
`N` and `z`. -/
theorem intrinsicCuspCutoff_fderiv_hyperbolic_bound
    (N : ℕ) (z : ℍ) :
    z.im * ‖fderiv ℝ (upperLift (intrinsicCuspCutoff N)) (z : ℂ)‖ ≤
      2 * (intrinsicTransitionLipschitzConstant : ℝ) := by
  let C : ℝ := 2 * (intrinsicTransitionLipschitzConstant : ℝ) / z.im
  have hC : 0 ≤ C := by
    exact div_nonneg (mul_nonneg (by norm_num)
      intrinsicTransitionLipschitzConstant.coe_nonneg) z.im_pos.le
  have hLocal : ∀ᶠ w : ℂ in nhds (z : ℂ),
      ‖upperLift (intrinsicCuspCutoff N) w -
          upperLift (intrinsicCuspCutoff N) (z : ℂ)‖ ≤
        C * ‖w - (z : ℂ)‖ := by
    have hImNhds : {w : ℂ | z.im / 2 < w.im} ∈ nhds (z : ℂ) := by
      exact (isOpen_lt continuous_const Complex.continuous_im).mem_nhds (by simpa only [Set.mem_setOf_eq] using
          (by linarith [z.im_pos] : z.im / 2 < z.im))
    filter_upwards [hImNhds] with w hw
    have hwpos : 0 < w.im := by linarith [z.im_pos]
    have hLip := (intrinsicCuspCutoffReal_lipschitz N).dist_le
      (UpperHalfPlane.ofComplex w) z
    have hMetric := upperHalfPlane_dist_le_two_div_im_mul_dist z hw
    have hNormEq :
        ‖upperLift (intrinsicCuspCutoff N) w -
            upperLift (intrinsicCuspCutoff N) (z : ℂ)‖ =
          dist (intrinsicCuspCutoffReal N (UpperHalfPlane.ofComplex w))
            (intrinsicCuspCutoffReal N z) := by
      rw [Real.dist_eq]
      simp only [upperLift, Function.comp_def, intrinsicCuspCutoff,
        Complex.norm_real, UpperHalfPlane.ofComplex_apply_of_im_pos z.im_pos]
    rw [hNormEq]
    calc
      dist (intrinsicCuspCutoffReal N (UpperHalfPlane.ofComplex w))
          (intrinsicCuspCutoffReal N z) ≤
        (intrinsicTransitionLipschitzConstant : ℝ) *
          dist (UpperHalfPlane.ofComplex w) z := hLip
      _ ≤ (intrinsicTransitionLipschitzConstant : ℝ) *
          ((2 / z.im) * dist w (z : ℂ)) :=
        mul_le_mul_of_nonneg_left hMetric
          intrinsicTransitionLipschitzConstant.coe_nonneg
      _ = C * ‖w - (z : ℂ)‖ := by
        rw [← dist_eq_norm]
        dsimp only [C]
        ring
  have hDeriv :
      ‖fderiv ℝ (upperLift (intrinsicCuspCutoff N)) (z : ℂ)‖ ≤ C :=
    norm_fderiv_le_of_lip' ℝ hC hLocal
  dsimp only [C] at hDeriv
  have hy := z.im_pos
  nlinarith [mul_le_mul_of_nonneg_left hDeriv hy.le]

theorem intrinsicCuspCutoff_dx_hyperbolic_bound
    (N : ℕ) (z : ℍ) :
    z.im * ‖dx (intrinsicCuspCutoff N) z‖ ≤
      2 * (intrinsicTransitionLipschitzConstant : ℝ) := by
  have hApply :=
    (fderiv ℝ (upperLift (intrinsicCuspCutoff N)) (z : ℂ)).le_opNorm
      (1 : ℂ)
  simp only [norm_one, mul_one] at hApply
  exact (mul_le_mul_of_nonneg_left hApply z.im_pos.le).trans
    (intrinsicCuspCutoff_fderiv_hyperbolic_bound N z)

theorem intrinsicCuspCutoff_dy_hyperbolic_bound
    (N : ℕ) (z : ℍ) :
    z.im * ‖dy (intrinsicCuspCutoff N) z‖ ≤
      2 * (intrinsicTransitionLipschitzConstant : ℝ) := by
  have hApply :=
    (fderiv ℝ (upperLift (intrinsicCuspCutoff N)) (z : ℂ)).le_opNorm
      Complex.I
  simp only [norm_I, mul_one] at hApply
  exact (mul_le_mul_of_nonneg_left hApply z.im_pos.le).trans
    (intrinsicCuspCutoff_fderiv_hyperbolic_bound N z)

end FixedPhaseIntrinsicAdjointCutoff

