#print axioms FixedPhaseIntrinsicAdjointCutoff.norm_intrinsicLowerFromSuccPeterssonCommutatorCoreMap_le
#print axioms FixedPhaseIntrinsicAdjointCutoff.tendsto_zero_of_uniform_bound_of_eventuallyEq_on_denseRange
#print axioms FixedPhaseIntrinsicAdjointCutoff.intrinsicRaisePeterssonCommutator_tendsto_zero
#print axioms FixedPhaseIntrinsicAdjointCutoff.intrinsicLowerFromSuccPeterssonCommutator_tendsto_zero

