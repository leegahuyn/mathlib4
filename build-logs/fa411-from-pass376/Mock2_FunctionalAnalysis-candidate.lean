/-!
### P3.23: smooth representatives and the exact scaled derivative kernel

This section records the pointwise side of the preceding Hilbert-valued
construction.  Convolution of an arbitrary planar `L2` representative with
the real compact mollifier is genuinely `C infinity`.  In addition, the
scaled commutator kernel defined in P3.20 is proved to be the literal
directional derivative of `t.im * rho_j(t)`, not merely a kernel with the
same estimates.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

theorem friedrichsMollifierReal_hasCompactSupport (j : ℕ) :
    HasCompactSupport (friedrichsMollifierReal j) := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℂ)
    (friedrichsRadius j))
  intro t ht
  by_contra hne
  have hcomplex : friedrichsMollifier j t ≠ 0 := by
    simpa only [friedrichsMollifier, Complex.ofReal_ne_zero] using hne
  exact ht <| by
    simpa only [mem_closedBall, dist_zero_right] using
      friedrichsMollifier_support_bound j t hcomplex

/-- Pointwise convolution of an `L2` class with the canonical real
mollifier. -/
noncomputable def friedrichsMollifiedRepresentative
    (j : ℕ) (f : AmbientPlaneL2) : ℂ → ℂ :=
  friedrichsMollifierReal j ⋆[lsmul ℝ ℂ, volume]
    (f : ℂ → ℂ)

theorem friedrichsMollifiedRepresentative_contDiff
    (j : ℕ) (f : AmbientPlaneL2) :
    ContDiff ℝ ∞ (friedrichsMollifiedRepresentative j f) := by
  exact (friedrichsMollifierReal_hasCompactSupport j).contDiff_convolution_left (lsmul ℝ ℂ)
      (friedrichsMollifierReal_contDiff j)
      ((MeasureTheory.Lp.memLp f).locallyIntegrable (by norm_num))

/-- Compact support is preserved when the chosen representative already has
compact support. -/
theorem friedrichsMollifiedRepresentative_hasCompactSupport
    (j : ℕ) (f : AmbientPlaneL2)
    (hf : HasCompactSupport (f : ℂ → ℂ)) :
    HasCompactSupport (friedrichsMollifiedRepresentative j f) := by
  exact (friedrichsMollifierReal_hasCompactSupport j).convolution hf

/-- The pointwise mollification bundled as a genuine full-plane test whenever
the original representative has compact support. -/
noncomputable def friedrichsMollifiedFullPlaneTest
    (j : ℕ) (f : AmbientPlaneL2)
    (hf : HasCompactSupport (f : ℂ → ℂ)) : FullPlaneTest where
  toFun := friedrichsMollifiedRepresentative j f
  contDiff' := friedrichsMollifiedRepresentative_contDiff j f
  hasCompactSupport' :=
    friedrichsMollifiedRepresentative_hasCompactSupport j f hf
  tsupport_subset' := subset_univ

@[simp]
theorem friedrichsMollifiedFullPlaneTest_apply
    (j : ℕ) (f : AmbientPlaneL2)
    (hf : HasCompactSupport (f : ℂ → ℂ)) (t : ℂ) :
    friedrichsMollifiedFullPlaneTest j f hf t =
      friedrichsMollifiedRepresentative j f t :=
  rfl

/-- Algebraic scaling identity for the height-weighted mollifier. -/
theorem height_mul_friedrichsMollifier_eq_scaled_unit
    (j : ℕ) (t : ℂ) :
    (t.im : ℂ) * friedrichsMollifier j t =
      friedrichsScale j •
        friedrichsUnitHeightMollifierTest
          (friedrichsScale j • t) := by
  have him : (friedrichsScale j • t).im =
      friedrichsScale j * t.im := by
    rw [Complex.real_smul]
    simp
  simp only [friedrichsMollifier, friedrichsMollifierReal,
    friedrichsUnitHeightMollifierTest_apply,
    friedrichsUnitMollifier, Complex.real_smul]
  rw [him]
  push_cast
  ring

/-- Directional derivative of the scaled height-mollifier. -/
theorem fderiv_height_mul_friedrichsMollifier
    (j : ℕ) (t xi : ℂ) :
    fderiv ℝ
        (fun s : ℂ ↦ (s.im : ℂ) * friedrichsMollifier j s)
        t xi =
      ((friedrichsScale j ^ 2 : ℝ) : ℂ) *
        fderiv ℝ
          (friedrichsUnitHeightMollifierTest : ℂ → ℂ)
          (friedrichsScale j • t) xi := by
  let a : ℝ := friedrichsScale j
  have ha : 0 < a := friedrichsScale_pos j
  have hfun :
      (fun s : ℂ ↦ (s.im : ℂ) * friedrichsMollifier j s) =
        (fun s : ℂ ↦ a •
          friedrichsUnitHeightMollifierTest (a • s)) := by
    funext s
    simpa only [a] using height_mul_friedrichsMollifier_eq_scaled_unit j s
  rw [hfun]
  have hinner : DifferentiableAt ℝ
      (fun s : ℂ ↦ friedrichsUnitHeightMollifierTest (a • s)) t :=
    (friedrichsUnitHeightMollifierTest.contDiff.comp
      (contDiff_const_smul a)).differentiableAt (by simp)
  rw [fderiv_fun_const_smul hinner a, fderiv_comp_smul]
  simp only [ContinuousLinearMap.smul_apply, smul_smul, pow_two,
    Complex.real_smul]

/-- The scaled kernel from P3.20 is exactly
`D_t (t.im * rho_j(t))`. -/
theorem friedrichsAffineCommutatorKernel_eq_directionalDerivative
    (sigma : ℂ) (j : ℕ) (t : ℂ) :
    friedrichsAffineCommutatorKernel sigma j t =
      ambientConstantMaassDerivative sigma
        (fun s : ℂ ↦ (s.im : ℂ) * friedrichsMollifier j s) t := by
  unfold ambientConstantMaassDerivative
  rw [fderiv_height_mul_friedrichsMollifier,
    fderiv_height_mul_friedrichsMollifier]
  simp only [friedrichsAffineCommutatorKernel,
    friedrichsUnitAffineCommutatorTest_apply,
    ambientConstantMaassDerivative]
  ring

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3SmoothAffineMollifier

#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifiedRepresentative_contDiff
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsAffineCommutatorKernel_eq_directionalDerivative

end AxiomAuditP3SmoothAffineMollifier
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.24: full-plane weak affine graphs and translated mollifier tests

The local Friedrichs statement is most transparent before quotient
bookkeeping.  We therefore define the complex-bilinear distributional graph
of `P = y (sigma partial_x + partial_y) + c` on genuine full-plane compact
tests.  Its transpose is bundled from test-function operations, so every
pairing below is an actual Bochner integral of an integrable function.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

/-- Multiplication of a full-plane test by the real affine height. -/
noncomputable def fullPlaneHeightMul (v : FullPlaneTest) : FullPlaneTest where
  toFun := fun t : ℂ ↦ (t.im : ℂ) * v t
  contDiff' := by
    have him : ContDiff ℝ ∞ (fun t : ℂ ↦ (t.im : ℂ)) :=
      (Complex.ofRealCLM.comp Complex.imCLM).contDiff
    exact him.mul v.contDiff
  hasCompactSupport' := v.hasCompactSupport.mul_left
  tsupport_subset' := subset_univ

@[simp]
theorem fullPlaneHeightMul_apply (v : FullPlaneTest) (t : ℂ) :
    fullPlaneHeightMul v t = (t.im : ℂ) * v t :=
  rfl

/-- Complex-bilinear distributional transpose of
`y (sigma partial_x + partial_y) + c`. -/
noncomputable def fullPlaneAffineTranspose
    (sigma c : ℂ) (v : FullPlaneTest) : FullPlaneTest :=
  (-sigma) • fullPlaneHeightMul (fullPlaneDirectionalDerivative 1 v) -
    fullPlaneHeightMul (fullPlaneDirectionalDerivative Complex.I v) +
      (c - 1) • v

@[simp]
theorem fullPlaneAffineTranspose_apply
    (sigma c : ℂ) (v : FullPlaneTest) (t : ℂ) :
    fullPlaneAffineTranspose sigma c v t =
      -sigma * (t.im : ℂ) *
          fderiv ℝ (v : ℂ → ℂ) t 1 -
        (t.im : ℂ) *
          fderiv ℝ (v : ℂ → ℂ) t Complex.I +
        (c - 1) * v t := by
  simp only [fullPlaneAffineTranspose, add_apply,
    sub_apply, smul_apply,
    fullPlaneHeightMul_apply, fullPlaneDirectionalDerivative_apply,
    smul_eq_mul]
  ring

/-- Complex-bilinear weak graph of the affine Maass expression.  The source
and target are planar `L2`; hence they are locally integrable and every
compact-test pairing is genuine. -/
def IsPlanarAffineWeakGraph
    (sigma c : ℂ) (u Pu : AmbientPlaneL2) : Prop :=
  ∀ v : FullPlaneTest,
    (∫ t : ℂ, v t * Pu t) =
      ∫ t : ℂ, fullPlaneAffineTranspose sigma c v t * u t

/-- Every test/source product occurring in the weak graph is integrable. -/
theorem fullPlaneTest_mul_l2_integrable
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    Integrable (fun t : ℂ ↦ v t * u t) (volume : Measure ℂ) := by
  simpa only [smul_eq_mul] using
    ((MeasureTheory.Lp.memLp u).locallyIntegrable (by norm_num)).integrable_smul_left_of_hasCompactSupport
        v.continuous v.hasCompactSupport

/-- The reflected translate `x |-> rho_j(w-x)` as a genuine full-plane
compact test. -/
noncomputable def friedrichsTranslatedMollifierTest
    (j : ℕ) (w : ℂ) : FullPlaneTest where
  toFun := fun x : ℂ ↦ friedrichsMollifier j (w - x)
  contDiff' := friedrichsMollifier_contDiff j |>.comp
    (contDiff_const.sub contDiff_id)
  hasCompactSupport' := by
    have hreal : HasCompactSupport
        (fun x : ℂ ↦ friedrichsMollifierReal j (w - x)) :=
      (friedrichsMollifierReal_hasCompactSupport j).comp_homeomorph
        (Homeomorph.subLeft w)
    exact hreal.comp_left rfl
  tsupport_subset' := subset_univ

@[simp]
theorem friedrichsTranslatedMollifierTest_apply
    (j : ℕ) (w x : ℂ) :
    friedrichsTranslatedMollifierTest j w x =
      friedrichsMollifier j (w - x) :=
  rfl

/-- Frechet derivative of a reflected translate. -/
theorem fderiv_friedrichsTranslatedMollifierTest
    (j : ℕ) (w x xi : ℂ) :
    fderiv ℝ
        (friedrichsTranslatedMollifierTest j w : ℂ → ℂ) x xi =
      -fderiv ℝ (friedrichsMollifier j) (w - x) xi := by
  have houter : DifferentiableAt ℝ (friedrichsMollifier j) (w - x) :=
    (friedrichsMollifier_contDiff j).differentiableAt (by simp)
  have hinner : HasFDerivAt (fun y : ℂ ↦ w - y)
      (-ContinuousLinearMap.id ℝ ℂ) x := by
    simpa using (hasFDerivAt_const (x := x) (c := w)).sub
      (hasFDerivAt_id x)
  have hcomp := houter.hasFDerivAt.comp x hinner
  have hEq := congrArg (fun A : ℂ →L[ℝ] ℂ ↦ A xi) hcomp.fderiv
  simpa only [friedrichsTranslatedMollifierTest_apply,
    ContinuousLinearMap.comp_apply, ContinuousLinearMap.neg_apply,
    ContinuousLinearMap.id_apply, map_neg] using hEq

/-- The weak equation specialized to the translated normalized mollifier. -/
theorem IsPlanarAffineWeakGraph.translatedMollifier
    {sigma c : ℂ} {u Pu : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraph sigma c u Pu)
    (j : ℕ) (w : ℂ) :
    (∫ x : ℂ, friedrichsMollifier j (w - x) * Pu x) =
      ∫ x : ℂ,
        fullPlaneAffineTranspose sigma c
          (friedrichsTranslatedMollifierTest j w) x * u x := by
  simpa only [friedrichsTranslatedMollifierTest_apply] using
    hWeak (friedrichsTranslatedMollifierTest j w)

end
end FixedPhaseNormalizedFriedrichs

