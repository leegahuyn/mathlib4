/-! ## P3.5/P3.7: compact horocycle tails and exact cross-adjoint criteria

This section records two logically separate endpoints.  Quotient-compact
support makes every sufficiently high *actual* truncation horocycle carry the
zero Green flux, so its oriented one-dimensional integral is exactly zero.
The strong cross-adjoint equalities require one further, genuinely operator-
theoretic input: the smooth opposite-weight core must be an essential graph
core for the corresponding maximal adjoint.  Mere closability is deliberately
not used as a substitute for that graph-density statement.
-/

namespace Mock2FA
namespace PaperCorrections.AutomorphicSobolev

namespace GammaTwoQuotientGreenBoundary

open MeasureTheory Set
open GammaTwoQuotientGeometry

/-! ### Compact quotient support removes the high horocycles exactly -/

/-- A point of a later selected horocycle which lies in the closed polygon is
outside every earlier literal three-cusp truncation.  The strict inequality is
essential: the horocycle at the truncation level itself belongs to the closed
sublevel boundary. -/
theorem closedCarrier_mem_diff_threeCuspTruncation_of_mem_laterHorocycle
    {Y₀ Z : ℝ} (hY₀ : 1 < Y₀) (hYZ : Y₀ < Z) {z : ℍ}
    (hzCarrier : z ∈ gammaTwoClosedTileCarrier)
    (hzHoro : z ∈ gammaTwoThreeCuspHorocycleBoundary Z) :
    z ∈ gammaTwoClosedTileCarrier \ gammaTwoThreeCuspTruncation Y₀ := by
  refine ⟨hzCarrier, ?_⟩
  intro hzOld
  rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
    at hzHoro
  rcases Set.mem_iUnion.mp hzHoro with ⟨q, hzq⟩
  have hHeight :
      gammaTwoTileHeight q z = gammaTwoCuspLevel Z :=
    (mem_gammaTwoSelectedHorocycleCurve_iff).mp hzq
  have hOld :
      gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y₀ :=
    hzOld.2 (gammaTwoTileCuspClass q) q rfl
  have hLevelY₀ : gammaTwoCuspLevel Y₀ = Y₀ :=
    gammaTwoCuspLevel_of_one_le hY₀.le
  have hZ : 1 < Z := hY₀.trans hYZ
  have hLevelZ : gammaTwoCuspLevel Z = Z :=
    gammaTwoCuspLevel_of_one_le hZ.le
  rw [hHeight, hLevelY₀, hLevelZ] at hOld
  exact (not_le_of_gt hYZ) hOld

/-- A zero three-cusp tail vanishes pointwise on every sufficiently later
actual horocycle of the closed polygon, including its corner points. -/
theorem HasZeroThreeCuspTail.eventually_zero_on_horocycleBoundary
    {X Y : ℍ → ℂ} (hTail : HasZeroThreeCuspTail X Y) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Z : ℝ, Y₀ < Z → ∀ z : ℍ,
        z ∈ gammaTwoClosedTileCarrier ∩
            gammaTwoThreeCuspHorocycleBoundary Z →
          X z = 0 ∧ Y z = 0 := by
  rcases hTail with ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Z hYZ z hz
  exact hZero z
    (closedCarrier_mem_diff_threeCuspTruncation_of_mem_laterHorocycle
      hY₀ hYZ hz.1 hz.2)

/-- On every compact parameter interval of a sufficiently high selected
horocycle segment lying in the closed polygon, the oriented flux integral is
literally zero.  The tangent is arbitrary, so the statement applies in
particular to the derivative of the actual horocycle parametrization. -/
theorem HasZeroThreeCuspTail.eventually_selectedHorocycle_fluxIntegral_eq_zero
    {X Y : ℍ → ℂ} (hTail : HasZeroThreeCuspTail X Y) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ (Z : ℝ), Y₀ < Z →
        ∀ (q : GammaTwoRightCoset) (a b : ℝ) (ξ : ℝ → ℂ),
          (∀ t ∈ Set.Icc a b,
            gammaTwoSelectedHorocycleParam q Z t ∈
              gammaTwoClosedTileCarrier) →
          (∫ t in Set.Icc a b,
            fluxOneFormValue X Y
              (gammaTwoSelectedHorocycleParam q Z t) (ξ t)) = 0 := by
  rcases hTail.eventually_zero_on_horocycleBoundary with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Z hYZ q a b ξ hCarrier
  calc
    (∫ t in Set.Icc a b,
        fluxOneFormValue X Y
          (gammaTwoSelectedHorocycleParam q Z t) (ξ t)) =
        ∫ _t in Set.Icc a b, (0 : ℂ) := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      have hzCurve : gammaTwoSelectedHorocycleParam q Z t ∈
          gammaTwoSelectedHorocycleCurve q Z := by
        simpa only [gammaTwoSelectedHorocycleCurve] using
          gammaTwoSelectedHorocycleParam_mem q Z t
      have hzHoro : gammaTwoSelectedHorocycleParam q Z t ∈
          gammaTwoThreeCuspHorocycleBoundary Z := by
        rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
        exact Set.mem_iUnion.2 ⟨q, hzCurve⟩
      have hz := hZero Z hYZ
        (gammaTwoSelectedHorocycleParam q Z t)
        ⟨hCarrier t ht, hzHoro⟩
      simp [fluxOneFormValue, hz.1, hz.2]
    _ = 0 := by simp

/-- Every smooth quotient-compact flux, hence in particular every actual
fixed-phase Green flux, has exactly zero sufficiently high horocycle
integrals. -/
theorem IsSmoothQuotientCompactFlux.eventually_selectedHorocycle_fluxIntegral_eq_zero
    {X Y : ℍ → ℂ} (hFlux : IsSmoothQuotientCompactFlux X Y) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ (Z : ℝ), Y₀ < Z →
        ∀ (q : GammaTwoRightCoset) (a b : ℝ) (ξ : ℝ → ℂ),
          (∀ t ∈ Set.Icc a b,
            gammaTwoSelectedHorocycleParam q Z t ∈
              gammaTwoClosedTileCarrier) →
          (∫ t in Set.Icc a b,
            fluxOneFormValue X Y
              (gammaTwoSelectedHorocycleParam q Z t) (ξ t)) = 0 :=
  HasZeroThreeCuspTail.eventually_selectedHorocycle_fluxIntegral_eq_zero
    (gammaTwoQuotientCompactFluxTailTightness X Y hFlux)

end GammaTwoQuotientGreenBoundary

namespace DefinitionOneSobolev.FixedPhasePeterssonCoordinates

open HalfWeightDifferentialOperators
open GammaTwoQuotientGeometry
open GammaTwoQuotientGreenBoundary

/-- The actual fixed-phase Green flux has an exact zero three-cusp tail; this
is a theorem from quotient compactness, not a decay certificate attached to
the core. -/
theorem fixedPhaseGreenFlux_hasZeroThreeCuspTail (n : ℤ)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    HasZeroThreeCuspTail
      (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v) :=
  gammaTwoQuotientCompactFluxTailTightness
    (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
    (fixedPhaseGreenFlux_isSmoothQuotientCompact n u v)

/-- Consequently every sufficiently high actual selected-horocycle segment
has zero Green-flux integral.  This is the compact-quotient-support endpoint
of P3.5; no Sobolev trace theorem is needed on this core. -/
theorem fixedPhaseGreenFlux_eventually_selectedHorocycle_integral_eq_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ (Z : ℝ), Y₀ < Z →
        ∀ (q : GammaTwoRightCoset) (a b : ℝ) (ξ : ℝ → ℂ),
          (∀ t ∈ Set.Icc a b,
            gammaTwoSelectedHorocycleParam q Z t ∈
              gammaTwoClosedTileCarrier) →
          (∫ t in Set.Icc a b,
            fluxOneFormValue
              (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
              (gammaTwoSelectedHorocycleParam q Z t) (ξ t)) = 0 :=
  HasZeroThreeCuspTail.eventually_selectedHorocycle_fluxIntegral_eq_zero
    (fixedPhaseGreenFlux_hasZeroThreeCuspTail n u v)

end DefinitionOneSobolev.FixedPhasePeterssonCoordinates

namespace FixedPhaseClosedOperators

open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open HalfWeightDifferentialOperators
open GammaTwoQuotientGreenBoundary
open scoped LinearPMap

noncomputable local instance fixedPhaseGreenCoreModule (n : ℤ) :
    Module ℂ (InverseEtaFixedPhaseCore n) := by
  change Module ℂ ↥(inverseEtaFixedPhaseStableCoreSubmodule n)
  exact Submodule.module (inverseEtaFixedPhaseStableCoreSubmodule n)

noncomputable local instance fixedPhaseGreenCoreAddCommGroup (n : ℤ) :
    AddCommGroup (InverseEtaFixedPhaseCore n) := by
  exact Module.addCommMonoidToAddCommGroup ℂ

/-! ### The actual raising, lowering, and one-half Green identities -/

/-- Vanishing of the concrete global defect gives the raising identity on the
actual automorphic compact core with no change of domains or normalization. -/
theorem physicalRaisingGreenIdentityOnCore {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v) =
      -inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v) := by
  exact (eq_neg_iff_add_eq_zero).2
    ((physicalGreenIdentityAt_iff_coreInner n).mp hGreen u v)

/-- The conjugate lowering identity on the same actual fixed-phase core. -/
theorem physicalLoweringGreenIdentityOnCore {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (u : InverseEtaFixedPhaseCore n) :
    inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) =
      -inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u) := by
  have hCore :=
    (physicalGreenIdentityAt_iff_coreInner n).mp hGreen u v
  have hConj := congrArg (starRingEnd ℂ) hCore
  simp only [map_add, map_zero, starRingEnd_apply] at hConj
  have hA :
      star (inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v)) =
        inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u) :=
    inner_conj_symm _ _
  have hB :
      star (inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v)) =
        inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) :=
    inner_conj_symm _ _
  rw [hA, hB] at hConj
  linear_combination hConj

/-- Averaging the two actual core Green sums keeps the coefficient `1/2`.
This is independent of the already-proved factorization average, so neither
normalization can silently absorb the other. -/
theorem physicalGreenHalfAverageOnCore {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    (1 / 2 : ℂ) *
        (inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v) +
          inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v)) +
      (1 / 2 : ℂ) *
        (inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) +
          inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u)) = 0 := by
  have hRaise := (physicalGreenIdentityAt_iff_coreInner n).mp hGreen u v
  have hLowerEq := physicalLoweringGreenIdentityOnCore hGreen v u
  have hLower :
      inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) +
          inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u) = 0 := by
    rw [hLowerEq]
    ring
  rw [hRaise, hLower]
  ring

/-! ### Continuous Green identity on the completed graph domains

The Definition-1 completion is the completion of the genuine three-coordinate
graph, so its base, raising, and lowering coordinates are continuous.  Hence
the core Green identity extends to the entire pair of adjacent graph
completions by two applications of density.  This is a form-domain statement;
it does not assert the separate maximal-adjoint graph-core theorem below. -/

open DefinitionOneSobolev.FixedPhaseGraphCompletion

private noncomputable def transportGraphLowerExtension
    (n m : ℤ) (h : m = n)
    (L : GraphSobolevCompletion (n + 1) →L[ℂ]
      OrbitPeterssonHilbert m) :
    GraphSobolevCompletion (n + 1) →L[ℂ]
      OrbitPeterssonHilbert n :=
  Eq.mp
    (congrArg
      (fun k => GraphSobolevCompletion (n + 1) →L[ℂ]
        OrbitPeterssonHilbert k) h) L

private theorem transportGraphLowerExtension_apply
    (n m : ℤ) (h : m = n)
    (L : GraphSobolevCompletion (n + 1) →L[ℂ]
      OrbitPeterssonHilbert m)
    (x : GraphSobolevCompletion (n + 1)) :
    transportGraphLowerExtension n m h L x =
      Eq.mp (congrArg OrbitPeterssonHilbert h) (L x) := by
  cases h
  rfl

/-- The lowering coordinate on the successor graph completion, with its
target transported across the displayed arithmetic equality
`(n + 1) - 1 = n`. -/
noncomputable def graphLowerFromSuccExtension (n : ℤ) :
    GraphSobolevCompletion (n + 1) →L[ℂ]
      OrbitPeterssonHilbert n :=
  transportGraphLowerExtension n (n + 1 - 1) (successorIndexEq n)
    (lowerExtension (n + 1))

private theorem transportedLowerExtension_core_eq_lowerFromSucc
    (n : ℤ) (v : InverseEtaFixedPhaseCore (n + 1)) :
    Eq.mp (congrArg OrbitPeterssonHilbert (successorIndexEq n))
        (lowerExtension (n + 1) (coreMap (n + 1) v)) =
      lowerFromSuccCoordinate n v := by
  rw [lowerExtension_core]
  rw [transportL2Coordinate (n + 1 - 1) n (successorIndexEq n)]
  rw [transportLowerCore_eq_lowerFromSucc]
  rfl

@[simp]
theorem graphLowerFromSuccExtension_core (n : ℤ)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    graphLowerFromSuccExtension n (coreMap (n + 1) v) =
      lowerFromSuccCoordinate n v := by
  rw [graphLowerFromSuccExtension,
    transportGraphLowerExtension_apply]
  exact transportedLowerExtension_core_eq_lowerFromSucc n v

/-- The continuous Green defect on adjacent completed graph domains. -/
noncomputable def graphSobolevGreenDefect (n : ℤ)
    (u : GraphSobolevCompletion n)
    (v : GraphSobolevCompletion (n + 1)) : ℂ :=
  inner ℂ (raiseExtension n u) (baseExtension (n + 1) v) +
    inner ℂ (baseExtension n u) (graphLowerFromSuccExtension n v)

/-- Continuity in the source graph variable. -/
theorem graphSobolevGreenDefect_continuous_left (n : ℤ)
    (v : GraphSobolevCompletion (n + 1)) :
    Continuous (fun u : GraphSobolevCompletion n =>
      graphSobolevGreenDefect n u v) := by
  exact
    ((raiseExtension n).continuous.inner continuous_const).add
      ((baseExtension n).continuous.inner continuous_const)

/-- Continuity in the successor graph variable. -/
theorem graphSobolevGreenDefect_continuous_right (n : ℤ)
    (u : GraphSobolevCompletion n) :
    Continuous (fun v : GraphSobolevCompletion (n + 1) =>
      graphSobolevGreenDefect n u v) := by
  exact
    (continuous_const.inner (baseExtension (n + 1)).continuous).add
      (continuous_const.inner
        (graphLowerFromSuccExtension n).continuous)

/-- On the dense smooth graph core, the completed defect is the already
proved physical Petersson Green defect. -/
theorem graphSobolevGreenDefect_core_eq_zero {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    graphSobolevGreenDefect n (coreMap n u) (coreMap (n + 1) v) = 0 := by
  simpa [graphSobolevGreenDefect, raisedCoordinate_apply] using
    ((physicalGreenIdentityAt_iff_coreInner n).mp hGreen u v)

/-- For a fixed smooth source vector, density of the successor graph core
extends Green's identity to every successor form-domain vector. -/
theorem graphSobolevGreenDefect_core_left_eq_zero {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : InverseEtaFixedPhaseCore n)
    (v : GraphSobolevCompletion (n + 1)) :
    graphSobolevGreenDefect n (coreMap n u) v = 0 := by
  have hEq :
      (fun y : GraphSobolevCompletion (n + 1) =>
          graphSobolevGreenDefect n (coreMap n u) y) =
        (fun _y : GraphSobolevCompletion (n + 1) => 0) :=
    (denseRange_coreMap (n + 1)).equalizer
      (graphSobolevGreenDefect_continuous_right n (coreMap n u))
      continuous_const
      (by
        funext w
        exact graphSobolevGreenDefect_core_eq_zero hGreen u w)
  exact congrFun hEq v

/-- The physical Green identity extends, without a trace certificate, to the
entire pair of adjacent Definition-1 graph/form completions. -/
theorem graphSobolevGreenDefect_eq_zero {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : GraphSobolevCompletion n)
    (v : GraphSobolevCompletion (n + 1)) :
    graphSobolevGreenDefect n u v = 0 := by
  have hEq :
      (fun x : GraphSobolevCompletion n =>
          graphSobolevGreenDefect n x v) =
        (fun _x : GraphSobolevCompletion n => 0) :=
    (denseRange_coreMap n).equalizer
      (graphSobolevGreenDefect_continuous_left n v)
      continuous_const
      (by
        funext w
        exact graphSobolevGreenDefect_core_left_eq_zero hGreen w v)
  exact congrFun hEq u

/-- Expanded completed raising/lowering Green identity. -/
theorem graphSobolev_raising_lowering_identity {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n)
    (u : GraphSobolevCompletion n)
    (v : GraphSobolevCompletion (n + 1)) :
    inner ℂ (raiseExtension n u) (baseExtension (n + 1) v) =
      -inner ℂ (baseExtension n u)
        (graphLowerFromSuccExtension n v) := by
  exact (eq_neg_iff_add_eq_zero).2
    (graphSobolevGreenDefect_eq_zero hGreen u v)

/-! ### Essential graph cores are the exact missing strong-adjoint input -/

/-- A raw operator is an essential graph core for a closed/maximal extension
when the closure of its graph is the entire graph of that extension.  This is
the operator-domain density assertion needed for a strong adjoint equality. -/
def IsEssentialGraphCoreFor
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (S A : E →ₗ.[ℂ] F) : Prop :=
  S.graph.topologicalClosure = A.graph

/-- For a closable operator, essential graph-core density is exactly equality
of its canonical closure with the proposed maximal extension. -/
theorem closure_eq_iff_isEssentialGraphCoreFor
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    {S A : E →ₗ.[ℂ] F} (hS : S.IsClosable) :
    S.closure = A ↔ IsEssentialGraphCoreFor S A := by
  constructor
  · intro h
    unfold IsEssentialGraphCoreFor
    rw [hS.graph_closure_eq_closure_graph, h]
  · intro h
    apply LinearPMap.eq_of_eq_graph
    rw [← hS.graph_closure_eq_closure_graph]
    exact h

/-- Restricting an extension back to the smaller operator's domain recovers
the smaller operator exactly.  This elementary lemma makes both the domain
inclusion and equality of values visible, rather than identifying restrictions
by a coercion. -/
theorem eq_domRestrict_of_le
    {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    {S A : E →ₗ.[ℂ] F} (hSA : S ≤ A) :
    S = A.domRestrict S.domain := by
  let R : E →ₗ.[ℂ] F := A.domRestrict S.domain
  have hRA : R ≤ A := LinearPMap.domRestrict_le
  have hDomain : R.domain = S.domain := by
    dsimp only [R]
    rw [LinearPMap.domRestrict_domain, inf_eq_left.mpr hSA.1]
  have hSR : S ≤ R := by
    refine ⟨?_, ?_⟩
    · rw [hDomain]
    · intro x y hxy
      let z : A.domain := ⟨(x : E), hSA.1 x.property⟩
      calc
        S x = A z := hSA.2 rfl
        _ = R y := (hRA.2 (by simpa only [z] using hxy.symm)).symm
  exact LinearPMap.eq_of_le_of_domain_eq hSR hDomain.symm

/-- The raising core is essential for the maximal adjoint of signed lowering
precisely when the first strong cross-adjoint equality holds. -/
def RaisingEssentialAdjointCoreAt (n : ℤ) : Prop :=
  IsEssentialGraphCoreFor (physicalRaise n)
    ((-physicalLowerFromSucc n)†)

/-- The lowering core is essential for the maximal adjoint of signed raising
precisely when the second strong cross-adjoint equality holds. -/
def LoweringEssentialAdjointCoreAt (n : ℤ) : Prop :=
  IsEssentialGraphCoreFor (physicalLowerFromSucc n)
    ((-physicalRaise n)†)

/-- Both strong cross-adjoint equalities, stated with the signs inside the
maximal adjoints so that the source and target domains remain explicit. -/
def StrongCrossAdjointAt (n : ℤ) : Prop :=
  closedRaise n = (-physicalLowerFromSucc n)† ∧
    closedLowerFromSucc n = (-physicalRaise n)†

/-- Mathlib's canonical essential-core predicate for the raising domain inside
the maximal adjoint of signed lowering.  Its `closure_eq` field is the exact
graph-norm density theorem still required analytically. -/
def RaisingMaximalAdjointHasPhysicalCoreAt (n : ℤ) : Prop :=
  ((-physicalLowerFromSucc n)†).HasCore (physicalRaise n).domain

/-- The corresponding canonical essential-core predicate for lowering. -/
def LoweringMaximalAdjointHasPhysicalCoreAt (n : ℤ) : Prop :=
  ((-physicalRaise n)†).HasCore (physicalLowerFromSucc n).domain

/-- Green's identity identifies raw raising with the restriction of the
opposite signed maximal adjoint to the actual smooth raising domain. -/
theorem physicalRaise_eq_negativeLowerAdjoint_domRestrict {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    physicalRaise n =
      ((-physicalLowerFromSucc n)†).domRestrict (physicalRaise n).domain :=
  eq_domRestrict_of_le (raise_le_negativeLower_adjoint hGreen)

/-- The lowering restriction identity, with its own source domain. -/
theorem physicalLowerFromSucc_eq_negativeRaiseAdjoint_domRestrict {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    physicalLowerFromSucc n =
      ((-physicalRaise n)†).domRestrict
        (physicalLowerFromSucc n).domain :=
  eq_domRestrict_of_le (lower_le_negativeRaise_adjoint hGreen)

theorem raisingEssentialAdjointCoreAt_iff (n : ℤ) :
    RaisingEssentialAdjointCoreAt n ↔
      closedRaise n = (-physicalLowerFromSucc n)† := by
  simpa only [RaisingEssentialAdjointCoreAt, closedRaise] using
    (closure_eq_iff_isEssentialGraphCoreFor
      (S := physicalRaise n) (A := (-physicalLowerFromSucc n)†)
      (physicalRaise_isClosable n)).symm

theorem loweringEssentialAdjointCoreAt_iff (n : ℤ) :
    LoweringEssentialAdjointCoreAt n ↔
      closedLowerFromSucc n = (-physicalRaise n)† := by
  simpa only [LoweringEssentialAdjointCoreAt, closedLowerFromSucc] using
    (closure_eq_iff_isEssentialGraphCoreFor
      (S := physicalLowerFromSucc n) (A := (-physicalRaise n)†)
      (physicalLowerFromSucc_isClosable n)).symm

/-- Under the already-established Green inclusion, the custom graph equality
is exactly Mathlib's standard `HasCore` predicate for the maximal adjoint. -/
theorem raisingEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    RaisingEssentialAdjointCoreAt n ↔
      RaisingMaximalAdjointHasPhysicalCoreAt n := by
  constructor
  · intro hEssential
    have hClosure :
        (physicalRaise n).closure = (-physicalLowerFromSucc n)† :=
      (closure_eq_iff_isEssentialGraphCoreFor
        (physicalRaise_isClosable n)).2 hEssential
    refine ⟨(raise_le_negativeLower_adjoint hGreen).1, ?_⟩
    rw [← physicalRaise_eq_negativeLowerAdjoint_domRestrict hGreen]
    exact hClosure
  · intro hCore
    apply (closure_eq_iff_isEssentialGraphCoreFor
      (physicalRaise_isClosable n)).1
    rw [physicalRaise_eq_negativeLowerAdjoint_domRestrict hGreen]
    exact hCore.closure_eq

theorem loweringEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    LoweringEssentialAdjointCoreAt n ↔
      LoweringMaximalAdjointHasPhysicalCoreAt n := by
  constructor
  · intro hEssential
    have hClosure :
        (physicalLowerFromSucc n).closure = (-physicalRaise n)† :=
      (closure_eq_iff_isEssentialGraphCoreFor
        (physicalLowerFromSucc_isClosable n)).2 hEssential
    refine ⟨(lower_le_negativeRaise_adjoint hGreen).1, ?_⟩
    rw [← physicalLowerFromSucc_eq_negativeRaiseAdjoint_domRestrict hGreen]
    exact hClosure
  · intro hCore
    apply (closure_eq_iff_isEssentialGraphCoreFor
      (physicalLowerFromSucc_isClosable n)).1
    rw [physicalLowerFromSucc_eq_negativeRaiseAdjoint_domRestrict hGreen]
    exact hCore.closure_eq

/-- Strong cross-adjointness is equivalent to the two independent essential
graph-core statements; no implication from closability is inserted. -/
theorem strongCrossAdjointAt_iff_essentialCores (n : ℤ) :
    StrongCrossAdjointAt n ↔
      RaisingEssentialAdjointCoreAt n ∧
        LoweringEssentialAdjointCoreAt n := by
  constructor
  · rintro ⟨hRaise, hLower⟩
    exact ⟨(raisingEssentialAdjointCoreAt_iff n).2 hRaise,
      (loweringEssentialAdjointCoreAt_iff n).2 hLower⟩
  · rintro ⟨hRaise, hLower⟩
    exact ⟨(raisingEssentialAdjointCoreAt_iff n).1 hRaise,
      (loweringEssentialAdjointCoreAt_iff n).1 hLower⟩

/-- This is the canonical essential-core formulation of the missing strong
theorem.  It states precisely which two graph-norm density results must be
proved after the global Green defect has been shown to vanish. -/
theorem strongCrossAdjointAt_iff_maximalAdjointsHavePhysicalCores
    {n : ℤ} (hGreen : PhysicalGreenIdentityAt n) :
    StrongCrossAdjointAt n ↔
      RaisingMaximalAdjointHasPhysicalCoreAt n ∧
        LoweringMaximalAdjointHasPhysicalCoreAt n := by
  constructor
  · intro hStrong
    have hEssential := (strongCrossAdjointAt_iff_essentialCores n).1 hStrong
    exact ⟨
      (raisingEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
        hGreen).1 hEssential.1,
      (loweringEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
        hGreen).1 hEssential.2⟩
  · rintro ⟨hRaise, hLower⟩
    apply (strongCrossAdjointAt_iff_essentialCores n).2
    exact ⟨
      (raisingEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
        hGreen).2 hRaise,
      (loweringEssentialAdjointCoreAt_iff_maximalAdjointHasPhysicalCore
        hGreen).2 hLower⟩

/-- Under Green's identity, the already-proved closure inclusions supply one
direction.  Strong cross-adjointness is therefore equivalent to the two
reverse maximal-domain inclusions below. -/
theorem strongCrossAdjointAt_iff_reverseInclusions {n : ℤ}
    (hGreen : PhysicalGreenIdentityAt n) :
    StrongCrossAdjointAt n ↔
      (-physicalLowerFromSucc n)† ≤ closedRaise n ∧
        (-physicalRaise n)† ≤ closedLowerFromSucc n := by
  constructor
  · rintro ⟨hRaise, hLower⟩
    constructor
    · rw [hRaise]
    · rw [hLower]
  · rintro ⟨hRaise, hLower⟩
    exact ⟨
      le_antisymm (closedRaise_le_negativeLower_adjoint hGreen) hRaise,
      le_antisymm (closedLower_le_negativeRaise_adjoint hGreen) hLower⟩

/-- Polygonal Stokes supplies the Green half of the strong theorem, but the
two essential-domain inclusions remain explicit and cannot be dropped. -/
theorem strongCrossAdjointAt_of_pairedPolygon_of_reverseInclusions
    {n : ℤ} (hPolygon : GammaTwoPairedPolygonFluxStokes)
    (hRaise : (-physicalLowerFromSucc n)† ≤ closedRaise n)
    (hLower : (-physicalRaise n)† ≤ closedLowerFromSucc n) :
    StrongCrossAdjointAt n :=
  (strongCrossAdjointAt_iff_reverseInclusions
    (physicalGreenIdentity_of_pairedPolygon hPolygon n)).2
      ⟨hRaise, hLower⟩

end FixedPhaseClosedOperators

