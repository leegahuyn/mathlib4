/-!
### P3.9: integrability-preserving global Stokes composition support

The final finite boundary cancellation must not acquire a new integrability
assumption after changing tiles or coordinates.  The lemmas below transport
the original chosen-carrier hypothesis through the same genuine Jacobian and
Piola maps used by the integral identities above.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace GammaTwoGlobalStokesCompositionSupport

open MeasureTheory Set Function
open scoped Pointwise Interval
open GammaTwoQuotientGeometry GammaTwoQuotientGreenBoundary
open GammaTwoCurvilinearTileStokes GammaTwoMoebiusPiola
open GammaTwoOrientedBoundaryIntegral GammaTwoGlobalStokesBridge
open HalfWeightDifferentialOperators SmoothCompactCoreGeometry

/-- Integrability counterpart of the selected-coset Bochner Jacobian
identity.  This is Mathlib's actual change-of-variables equivalence for the
Möbius map, not a consequence inferred from equality of two integrals. -/
theorem integrableOn_complexImage_selectedCoset_smul_iff_jacobian
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (q : GammaTwoRightCoset) (s : Set ℍ) (hs : MeasurableSet s)
    (f : ℂ → E) :
    IntegrableOn f
        (UpperHalfPlane.coe '' (gammaTwoCosetRep q • s))
        (volume : Measure ℂ) ↔
      IntegrableOn
        (fun w => |(UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) w).det| •
            f (selectedCosetAmbientMap q w))
        (UpperHalfPlane.coe '' s) (volume : Measure ℂ) := by
  rw [← selectedCosetAmbientMap_image_coe q s]
  exact MeasureTheory.integrableOn_image_iff_integrableOn_abs_det_fderiv_smul
    volume
    (UpperHalfPlane.measurableEmbedding_coe.measurableSet_image.mpr hs)
    (fun w hw => by
      rcases hw with ⟨z, hz, rfl⟩
      exact (selectedCosetAmbientMap_hasStrictFDerivAt q z).hasFDerivAt.hasFDerivWithinAt)
    (selectedCosetAmbientMap_injOn_coeImage q s) f

/-- The hyperbolic `height² × divergence` integrability on a selected tile
is equivalent to integrability of the genuine Piola divergence on the base
half-open tile. -/
theorem integrableOn_heightSq_divergence_selectedHalfOpenTile_iff_basePiola
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (hX : RealSmooth X) (hY : RealSmooth Y) :
    IntegrableOn
        (fun z => heightC z ^ 2 * (dx X z + dy Y z))
        (gammaTwoCosetRep q • modularHalfOpenTile)
        hyperbolicMeasure ↔
      IntegrableOn
        (fun z => heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z))
        modularHalfOpenTile hyperbolicMeasure := by
  have hSelectedTile : MeasurableSet
      (gammaTwoCosetRep q • modularHalfOpenTile) :=
    MeasurableSet.const_smul modularHalfOpenTile_measurable
      (gammaTwoCosetRep q)
  have hBaseImage : MeasurableSet
      (UpperHalfPlane.coe '' modularHalfOpenTile) :=
    UpperHalfPlane.measurableEmbedding_coe.measurableSet_image.mpr
      modularHalfOpenTile_measurable
  calc
    IntegrableOn
        (fun z => heightC z ^ 2 * (dx X z + dy Y z))
        (gammaTwoCosetRep q • modularHalfOpenTile)
        hyperbolicMeasure ↔
        IntegrableOn (fun z => dx X z + dy Y z)
          (gammaTwoCosetRep q • modularHalfOpenTile)
          (volume.comap UpperHalfPlane.coe) :=
      integrableOn_heightSq_mul_hyperbolic_iff_comap
        _ hSelectedTile _
    _ ↔ IntegrableOn (upperLift (fun z => dx X z + dy Y z))
        (UpperHalfPlane.coe ''
          (gammaTwoCosetRep q • modularHalfOpenTile))
        (volume : Measure ℂ) :=
      integrableOn_comap_iff_complexImage _ _
    _ ↔ IntegrableOn
        (fun w => |(UpperHalfPlane.smulFDeriv
          (selectedCosetGL q) w).det| •
            upperLift (fun z => dx X z + dy Y z)
              (selectedCosetAmbientMap q w))
        (UpperHalfPlane.coe '' modularHalfOpenTile)
        (volume : Measure ℂ) :=
      integrableOn_complexImage_selectedCoset_smul_iff_jacobian
        q modularHalfOpenTile modularHalfOpenTile_measurable _
    _ ↔ IntegrableOn
        (upperLift (fun z =>
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z))
        (UpperHalfPlane.coe '' modularHalfOpenTile)
        (volume : Measure ℂ) := by
      apply integrableOn_congr_fun
      · rintro _w ⟨z, _hz, rfl⟩
        simp only [selectedCosetAmbientMap_coe, upperLift_apply]
        change (selectedCosetJacobian q z : ℝ) •
            (dx X (selectedCosetAction q z) +
              dy Y (selectedCosetAction q z)) =
          dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z
        rw [Complex.real_smul]
        exact (divergence_selectedCosetPiola q hX hY z).symm
      · exact hBaseImage
    _ ↔ IntegrableOn
        (fun z => dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z)
        modularHalfOpenTile
        (volume.comap UpperHalfPlane.coe) :=
      (integrableOn_comap_iff_complexImage _ _).symm
    _ ↔ IntegrableOn
        (fun z => heightC z ^ 2 *
          (dx (selectedCosetPiolaX q X Y) z +
            dy (selectedCosetPiolaY q X Y) z))
        modularHalfOpenTile hyperbolicMeasure :=
      (integrableOn_heightSq_mul_hyperbolic_iff_comap
        modularHalfOpenTile modularHalfOpenTile_measurable _).symm

/-- The sole global `hInt` hypothesis restricts to every selected half-open
tile, crosses the Möbius--Piola equivalence, and then extends across the null
base boundary before restricting to any closed height truncation. -/
theorem integrableOn_selectedPiola_closedTruncation_of_chosenCarrier
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ} (H : ℝ)
    (hX : RealSmooth X) (hY : RealSmooth Y)
    (hInt : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure) :
    IntegrableOn
      (fun z => heightC z ^ 2 *
        (dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z))
      (modularClosedTileTruncation H) hyperbolicMeasure := by
  have hHalfCarrier : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      gammaTwoHalfOpenTileCarrier hyperbolicMeasure :=
    hInt.congr_set_ae gammaTwoHalfOpenTileCarrier_ae_eq_chosenCarrier
  have hTileSubset :
      gammaTwoCosetRep q • modularHalfOpenTile ⊆
        gammaTwoHalfOpenTileCarrier := by
    intro z hz
    exact Set.mem_iUnion.2 ⟨q, hz⟩
  have hSelected : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      (gammaTwoCosetRep q • modularHalfOpenTile)
      hyperbolicMeasure :=
    hHalfCarrier.mono_set hTileSubset
  have hBaseHalfOpen : IntegrableOn
      (fun z => heightC z ^ 2 *
        (dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z))
      modularHalfOpenTile hyperbolicMeasure :=
    (integrableOn_heightSq_divergence_selectedHalfOpenTile_iff_basePiola
      q hX hY).mp hSelected
  have hHalfOpenFd :
      modularHalfOpenTile =ᵐ[hyperbolicMeasure] ModularGroup.fd :=
    modularHalfOpenTile_ae_eq_fdo.trans modularFdo_ae_eq_fd
  have hBaseFd : IntegrableOn
      (fun z => heightC z ^ 2 *
        (dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z))
      ModularGroup.fd hyperbolicMeasure :=
    hBaseHalfOpen.congr_set_ae hHalfOpenFd.symm
  exact hBaseFd.mono_set (by
    intro z hz
    exact hz.1)

/-- The landed curved-tile Green theorem can therefore be instantiated for
every selected Piola field using only the original chosen-carrier
integrability hypothesis. -/
theorem integral_selectedPiola_closedTruncation_eq_boundary_of_chosenCarrier
    (q : GammaTwoRightCoset) {X Y : ℍ → ℂ}
    (H : ℝ) (hH : 1 < H)
    (hX : RealSmooth X) (hY : RealSmooth Y)
    (hInt : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure) :
    (∫ z in modularClosedTileTruncation H,
      heightC z ^ 2 *
        (dx (selectedCosetPiolaX q X Y) z +
          dy (selectedCosetPiolaY q X Y) z)
        ∂hyperbolicMeasure) =
      baseModularTruncationBoundaryFlux H
        (selectedCosetPiolaX q X Y)
        (selectedCosetPiolaY q X Y) := by
  exact setIntegral_heightSq_divergence_modularClosedTile_eq_boundary
    H hH (selectedCosetPiolaX q X Y) (selectedCosetPiolaY q X Y)
    (selectedCosetPiolaX_realSmooth q hX hY)
    (selectedCosetPiolaY_realSmooth q hX hY)
    (integrableOn_selectedPiola_closedTruncation_of_chosenCarrier
      q H hX hY hInt)

/-- The top term occurring in the curved-tile boundary formula vanishes at
the common literal zero-tail height.  This is the exact `realProdLift`
expression consumed by `baseModularTruncationBoundaryFlux_eq`. -/
theorem integral_realProdLift_selectedPiolaY_top_eq_zero
    {X Y : ℍ → ℂ} {H : ℝ}
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hH0 : 0 < H) (hH : 1 < H) (q : GammaTwoRightCoset) :
    (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
      realProdLift (selectedCosetPiolaY q X Y) (x, H)) = 0 := by
  calc
    (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
      realProdLift (selectedCosetPiolaY q X Y) (x, H)) =
        ∫ _x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ), (0 : ℂ) := by
      apply intervalIntegral.integral_congr
      intro x hx
      have hx' : x ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) := by
        simpa [uIcc_of_le (by norm_num :
          (-(1 / 2 : ℝ)) ≤ (1 / 2 : ℝ))] using hx
      have hPiola := selectedCosetPiola_eq_zero_on_commonTop
        hZero hH0 hH q hx'
      change realProdLift (selectedCosetPiolaY q X Y) (x, H) = (0 : ℂ)
      rw [realProdLift_topHorocycle _ H hH0 x]
      simpa [curvedTileTopHorocycleParam, baseHorocycleParam]
        using hPiola.2
    _ = 0 := by simp

/-- Global reduction at a fixed common tail height.  Exposing the actual
pointwise zero hypothesis lets the final pairing theorem use exactly the same
`H` for the bulk truncation and the vanished top horocycles. -/
theorem integral_chosenCarrier_eq_sum_PiolaBoundary_of_commonHeight
    (X Y : ℍ → ℂ) (H : ℝ) (hH : 1 < H)
    (hZero : ∀ (q : GammaTwoRightCoset) (z : ℍ),
      z ∈ ModularGroup.fd → H ≤ z.im →
        X (selectedCosetAction q z) = 0 ∧
          Y (selectedCosetAction q z) = 0)
    (hX : RealSmooth X) (hY : RealSmooth Y)
    (hInt : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure) :
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
      heightC z ^ 2 * (dx X z + dy Y z)
        ∂hyperbolicMeasure) =
      ∑ q : GammaTwoRightCoset,
        baseModularTruncationBoundaryFlux H
          (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) := by
  calc
    (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        heightC z ^ 2 * (dx X z + dy Y z)
          ∂hyperbolicMeasure) =
        ∑ q : GammaTwoRightCoset,
          ∫ z in gammaTwoCosetRep q • ModularGroup.fdo,
            heightC z ^ 2 * (dx X z + dy Y z)
              ∂hyperbolicMeasure :=
      integral_chosenCarrier_eq_sum_openTiles _ hInt
    _ = ∑ q : GammaTwoRightCoset,
        ∫ z in gammaTwoCosetRep q • modularHalfOpenTile,
          heightC z ^ 2 * (dx X z + dy Y z)
            ∂hyperbolicMeasure := by
      apply Finset.sum_congr rfl
      intro q _hq
      exact setIntegral_selectedOpenTile_eq_halfOpenTile q _
    _ = ∑ q : GammaTwoRightCoset,
        ∫ z in modularHalfOpenTile,
          heightC z ^ 2 *
            (dx (selectedCosetPiolaX q X Y) z +
              dy (selectedCosetPiolaY q X Y) z)
            ∂hyperbolicMeasure := by
      apply Finset.sum_congr rfl
      intro q _hq
      exact integral_heightSq_divergence_selectedHalfOpenTile_eq_basePiola
        q hX hY
    _ = ∑ q : GammaTwoRightCoset,
        ∫ z in modularClosedTileTruncation H,
          heightC z ^ 2 *
            (dx (selectedCosetPiolaX q X Y) z +
              dy (selectedCosetPiolaY q X Y) z)
            ∂hyperbolicMeasure := by
      apply Finset.sum_congr rfl
      intro q _hq
      exact integral_selectedPiola_full_eq_closedTruncation hZero q
    _ = ∑ q : GammaTwoRightCoset,
        baseModularTruncationBoundaryFlux H
          (selectedCosetPiolaX q X Y)
          (selectedCosetPiolaY q X Y) := by
      apply Finset.sum_congr rfl
      intro q _hq
      exact integral_selectedPiola_closedTruncation_eq_boundary_of_chosenCarrier
        q H hH hX hY hInt

/-- Complete global reduction up to the native finite boundary sum.  Every
step is now unconditional: chosen-carrier decomposition, null-boundary
replacement, Möbius--Piola transport, common cusp truncation, and the curved
closed-tile Green theorem.  The remaining operation is purely the finite
identification and pairing of these explicit boundary terms. -/
theorem exists_commonHeight_integral_chosenCarrier_eq_sum_PiolaBoundary
    (X Y : ℍ → ℂ)
    (hXY : IsSmoothQuotientCompactFlux X Y)
    (hTail : HasZeroThreeCuspTail X Y)
    (hInt : IntegrableOn
      (fun z => heightC z ^ 2 * (dx X z + dy Y z))
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure) :
    ∃ H : ℝ, 1 < H ∧
      (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        heightC z ^ 2 * (dx X z + dy Y z)
          ∂hyperbolicMeasure) =
        ∑ q : GammaTwoRightCoset,
          baseModularTruncationBoundaryFlux H
            (selectedCosetPiolaX q X Y)
            (selectedCosetPiolaY q X Y) := by
  rcases hXY with ⟨hX, hY, _hXCompact, _hYCompact, _hInvariant⟩
  rcases HasZeroThreeCuspTail.exists_commonBaseHeight_zero hTail with ⟨H, hH, hZero⟩
  exact ⟨H, hH,
    integral_chosenCarrier_eq_sum_PiolaBoundary_of_commonHeight
      X Y H hH hZero hX hY hInt⟩

end GammaTwoGlobalStokesCompositionSupport
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.10: unconditional global polygon Stokes and Green endpoints

All geometric, measure-theoretic, differential, and finite-pairing bridges
are now proved.  The following endpoints remove the former polygon/Stokes
parameters while retaining the separate essential-graph-core obligations for
strong maximal-adjoint equality.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev

open MeasureTheory Set
open GammaTwoQuotientGeometry GammaTwoQuotientGreenBoundary
open GammaTwoCurvilinearTileStokes GammaTwoMoebiusPiola
open GammaTwoGlobalStokesBridge GammaTwoGlobalStokesCompositionSupport
open GammaTwoNativeEdgeCancellation
open HalfWeightDifferentialOperators SmoothCompactCoreGeometry

/-- The genuine six-tile polygon Stokes theorem.  The proof uses one literal
height simultaneously for cusp-tail removal and top-horocycle vanishing, and
then the actual-edge native-tangent pairing theorem cancels the complete
finite boundary sum. -/
theorem gammaTwoPairedPolygonFluxStokes :
    GammaTwoPairedPolygonFluxStokes := by
  intro X Y hXY hTail hInt
  rcases HasZeroThreeCuspTail.exists_commonBaseHeight_zero hTail with ⟨H, hH, hZero⟩
  have hH0 : 0 < H := lt_trans zero_lt_one hH
  have hBulk :
      (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        heightC z ^ 2 * (dx X z + dy Y z)
          ∂hyperbolicMeasure) =
        ∑ q : GammaTwoRightCoset,
          baseModularTruncationBoundaryFlux H
            (selectedCosetPiolaX q X Y)
            (selectedCosetPiolaY q X Y) :=
    integral_chosenCarrier_eq_sum_PiolaBoundary_of_commonHeight
      X Y H hH hZero hXY.1 hXY.2.1 hInt
  have hTop : ∀ q : GammaTwoRightCoset,
      (∫ x in (-(1 / 2 : ℝ))..(1 / 2 : ℝ),
        realProdLift (selectedCosetPiolaY q X Y) (x, H)) = 0 :=
    fun q => integral_realProdLift_selectedPiolaY_top_eq_zero
      hZero hH0 hH q
  exact hBulk.trans
    (sum_baseModularTruncationBoundaryFlux_selectedPiola_eq_zero
      hH hXY.2.2.2.2 hTop)

/-- Compact-flux Stokes is now unconditional: quotient-compact support gives
the literal zero cusp tail, and the polygon theorem above supplies the full
boundary cancellation. -/
theorem gammaTwoCompactFluxStokes : GammaTwoCompactFluxStokes :=
  gammaTwoCompactFluxStokes_of_pairedPolygon
    gammaTwoPairedPolygonFluxStokes

namespace FixedPhaseClosedOperators

open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open scoped LinearPMap

/-- The concrete fixed-phase boundary defect vanishes with no remaining
Stokes or polygon argument. -/
theorem greenBoundaryDefect_eq_zero_unconditional
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    greenBoundaryDefect n u v = 0 :=
  greenBoundaryDefect_eq_zero_of_compactFluxStokes
    gammaTwoCompactFluxStokes n u v

/-- Unconditional physical Green identity at each fixed-phase index. -/
theorem physicalGreenIdentityAt_unconditional (n : ℤ) :
    PhysicalGreenIdentityAt n :=
  physicalGreenIdentityAt_of_compactFluxStokes
    gammaTwoCompactFluxStokes n

/-- Unconditional physical Green identity on the entire residue-class
tower. -/
theorem physicalGreenIdentity_unconditional : PhysicalGreenIdentity :=
  physicalGreenIdentity_of_compactFluxStokes gammaTwoCompactFluxStokes

/-- The raising core identity with the former `hGreen` input discharged. -/
theorem physicalRaisingGreenIdentityOnCore_unconditional
    {n : ℤ} (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v) =
      -inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v) :=
  physicalRaisingGreenIdentityOnCore
    (physicalGreenIdentityAt_unconditional n) u v

/-- The conjugate lowering core identity, also free of a Green parameter. -/
theorem physicalLoweringGreenIdentityOnCore_unconditional
    {n : ℤ} (v : InverseEtaFixedPhaseCore (n + 1))
    (u : InverseEtaFixedPhaseCore n) :
    inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) =
      -inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u) :=
  physicalLoweringGreenIdentityOnCore
    (physicalGreenIdentityAt_unconditional n) v u

/-- The exact `1/2`-averaged core Green identity with all geometric inputs
discharged. -/
theorem physicalGreenHalfAverageOnCore_unconditional
    {n : ℤ} (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    (1 / 2 : ℂ) *
        (inner ℂ (raisedCoordinate n u) (l2Coordinate (n + 1) v) +
          inner ℂ (l2Coordinate n u) (lowerFromSuccCoordinate n v)) +
      (1 / 2 : ℂ) *
        (inner ℂ (lowerFromSuccCoordinate n v) (l2Coordinate n u) +
          inner ℂ (l2Coordinate (n + 1) v) (raisedCoordinate n u)) = 0 :=
  physicalGreenHalfAverageOnCore
    (physicalGreenIdentityAt_unconditional n) u v

/-- Formal adjointness of raising and signed lowering is now an unconditional
dense-core theorem. -/
theorem physicalRaise_isFormalAdjoint_negativeLower_unconditional
    (n : ℤ) :
    (physicalRaise n).IsFormalAdjoint (-physicalLowerFromSucc n) :=
  (physicalGreenIdentityAt_iff_isFormalAdjoint_negativeLower n).mp
    (physicalGreenIdentityAt_unconditional n)

/-- The converse signed formal-adjoint orientation is unconditional as well. -/
theorem physicalLowerFromSucc_isFormalAdjoint_negativeRaise_unconditional
    (n : ℤ) :
    (physicalLowerFromSucc n).IsFormalAdjoint (-physicalRaise n) :=
  physicalLowerFromSucc_isFormalAdjoint_negativeRaise
    (physicalGreenIdentityAt_unconditional n)

/-- Vanishing on the embedded smooth graph core, with no `hGreen` input. -/
theorem graphSobolevGreenDefect_core_eq_zero_unconditional
    {n : ℤ} (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    graphSobolevGreenDefect n (coreMap n u) (coreMap (n + 1) v) = 0 :=
  graphSobolevGreenDefect_core_eq_zero
    (physicalGreenIdentityAt_unconditional n) u v

/-- The Green defect vanishes on the complete adjacent graph/form domains. -/
theorem graphSobolevGreenDefect_eq_zero_unconditional
    {n : ℤ} (u : GraphSobolevCompletion n)
    (v : GraphSobolevCompletion (n + 1)) :
    graphSobolevGreenDefect n u v = 0 :=
  graphSobolevGreenDefect_eq_zero
    (physicalGreenIdentityAt_unconditional n) u v

/-- Expanded raising/lowering Green identity on the completed graph domains,
with no polygon, Stokes, or Green hypothesis. -/
theorem graphSobolev_raising_lowering_identity_unconditional
    {n : ℤ} (u : GraphSobolevCompletion n)
    (v : GraphSobolevCompletion (n + 1)) :
    inner ℂ (raiseExtension n u) (baseExtension (n + 1) v) =
      -inner ℂ (baseExtension n u)
        (graphLowerFromSuccExtension n v) :=
  graphSobolev_raising_lowering_identity
    (physicalGreenIdentityAt_unconditional n) u v

end FixedPhaseClosedOperators

namespace AxiomAuditP3GlobalStokesCompletion

#print axioms GammaTwoGlobalStokesCompositionSupport.integrableOn_heightSq_divergence_selectedHalfOpenTile_iff_basePiola
#print axioms GammaTwoGlobalStokesCompositionSupport.integrableOn_selectedPiola_closedTruncation_of_chosenCarrier
#print axioms GammaTwoGlobalStokesCompositionSupport.integral_chosenCarrier_eq_sum_PiolaBoundary_of_commonHeight
#print axioms gammaTwoPairedPolygonFluxStokes
#print axioms gammaTwoCompactFluxStokes
#print axioms FixedPhaseClosedOperators.greenBoundaryDefect_eq_zero_unconditional
#print axioms FixedPhaseClosedOperators.physicalGreenIdentity_unconditional
#print axioms FixedPhaseClosedOperators.physicalRaisingGreenIdentityOnCore_unconditional
#print axioms FixedPhaseClosedOperators.physicalGreenHalfAverageOnCore_unconditional
#print axioms FixedPhaseClosedOperators.physicalRaise_isFormalAdjoint_negativeLower_unconditional
