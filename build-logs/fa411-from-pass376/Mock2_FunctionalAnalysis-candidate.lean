/-!
This fragment is intended to be appended after P3.26 of
`Mock2_FunctionalAnalysis_Integrated.lean`.

It closes the representative gap between the Hilbert-valued Friedrichs
action and the literal smooth convolution.  No point-evaluation map on `L²`
is used.  Instead, compact smooth tests are put in `L²`, the resulting
bilinear pairing is moved through the Bochner integral, Fubini is justified
by the `L² × L² -> L¹` Holder map, and distributional uniqueness gives the
almost-everywhere identity.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

/-! ### Compact smooth tests as planar `L²` vectors -/

/-- The canonical planar `L²` class of a full-plane compact smooth test. -/
noncomputable def fullPlaneTestToL2 (v : FullPlaneTest) : AmbientPlaneL2 :=
  (v.continuous.memLp_of_hasCompactSupport v.hasCompactSupport).toLp
    (v : ℂ → ℂ)

theorem coeFn_fullPlaneTestToL2 (v : FullPlaneTest) :
    (fullPlaneTestToL2 v : ℂ → ℂ) =ᵐ[(volume : Measure ℂ)]
      (v : ℂ → ℂ) :=
  MemLp.coeFn_toLp
    (v.continuous.memLp_of_hasCompactSupport v.hasCompactSupport)

/-- The complex-bilinear full-plane pairing is Mathlib's continuous
`L² × L² -> ℂ` Holder pairing. -/
theorem fullPlaneBilinearPair_eq_lpPairing
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair v u =
      (lsmul ℂ ℂ).lpPairing (volume : Measure ℂ) 2 2
        (fullPlaneTestToL2 v) u := by
  rw [(lsmul ℂ ℂ).lpPairing_eq_integral]
  unfold fullPlaneBilinearPair
  apply integral_congr_ae
  filter_upwards [coeFn_fullPlaneTestToL2 v] with x hx
  simp only [lsmul_apply, hx]

/-- Translation of an `L²` representative can be used inside a compact-test
pairing as the literal function `x ↦ u (x - t)`. -/
theorem fullPlaneTest_mul_translation_integrable
    (v : FullPlaneTest) (u : AmbientPlaneL2) (t : ℂ) :
    Integrable (fun x : ℂ ↦ v x * u (x - t))
      (volume : Measure ℂ) := by
  let ut : AmbientPlaneL2 := DomAddAct.mk (-t) +ᵥ u
  have hInt := fullPlaneTest_mul_l2_integrable v ut
  apply hInt.congr
  filter_upwards [DomAddAct.vadd_Lp_ae_eq (DomAddAct.mk (-t)) u] with x hx
  change v x * ut x = v x * u (x - t)
  congr 1
  change ut x = u (-t + x) at hx
  simpa only [sub_eq_add_neg, add_comm] using hx

/-! ### The exact product-integrability theorem needed by Fubini -/

/-- For an `L¹` kernel, a compact smooth test, and a planar `L²` vector, the
three-variable pairing integrand is genuinely integrable on the product
plane.  The proof uses the `L² × L² -> L¹` Holder map for the inner slice;
this is the quantitative step that makes the subsequent Fubini swap legal. -/
theorem integrable_fullPlaneTest_mul_kernel_mul_translate
    (K : ℂ → ℂ) (hK : Integrable K (volume : Measure ℂ))
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    Integrable
      (Function.uncurry fun x t : ℂ ↦ v x * K t * u (x - t))
      ((volume : Measure ℂ).prod (volume : Measure ℂ)) := by
  let V : AmbientPlaneL2 := fullPlaneTestToL2 v
  let C : ℝ := ‖lsmul ℂ ℂ‖ * ‖V‖ * ‖u‖
  have hMeasBase : AEStronglyMeasurable
      (fun p : ℂ × ℂ ↦ K p.2 * u (p.1 - p.2))
      ((volume : Measure ℂ).prod (volume : Measure ℂ)) :=
    hK.aestronglyMeasurable.convolution_integrand
      (mul ℂ ℂ) (MeasureTheory.Lp.aestronglyMeasurable u)
  have hMeasV : AEStronglyMeasurable
      (fun p : ℂ × ℂ ↦ v p.1)
      ((volume : Measure ℂ).prod (volume : Measure ℂ)) :=
    v.continuous.aestronglyMeasurable.comp_fst
  have hMeas : AEStronglyMeasurable
      (Function.uncurry fun x t : ℂ ↦ v x * K t * u (x - t))
      ((volume : Measure ℂ).prod (volume : Measure ℂ)) := by
    simpa only [Function.uncurry_apply_pair, mul_assoc] using
      hMeasV.mul hMeasBase
  apply (integrable_prod_iff' hMeas).2
  constructor
  · filter_upwards with t
    have hSlice := fullPlaneTest_mul_translation_integrable v u t
    have hScaled := hSlice.const_mul (K t)
    simpa only [Function.uncurry_apply_pair, mul_assoc, mul_left_comm,
      mul_comm] using hScaled
  · have hOuterMeas : AEStronglyMeasurable
        (fun t : ℂ ↦ ∫ x : ℂ,
          ‖v x * K t * u (x - t)‖ ∂(volume : Measure ℂ))
        (volume : Measure ℂ) := by
      simpa only [Function.uncurry_apply_pair] using
        hMeas.prod_swap.norm.integral_prod_right'
    refine Integrable.mono' (hK.norm.mul_const C) hOuterMeas ?_
    filter_upwards with t
    let ut : AmbientPlaneL2 := DomAddAct.mk (-t) +ᵥ u
    let productL1 : MeasureTheory.Lp ℂ 1 (volume : Measure ℂ) :=
      (lsmul ℂ ℂ).holder 1 V ut
    have hProductNorm :
        (∫ x : ℂ, ‖v x * u (x - t)‖ ∂(volume : Measure ℂ)) =
          ‖productL1‖ := by
      rw [MeasureTheory.L1.norm_eq_integral_norm]
      apply integral_congr_ae
      filter_upwards [
        (lsmul ℂ ℂ).coeFn_holder V ut,
        coeFn_fullPlaneTestToL2 v,
        DomAddAct.vadd_Lp_ae_eq (DomAddAct.mk (-t)) u] with x hHolder hV hut
      change ‖v x * u (x - t)‖ = ‖productL1 x‖
      rw [hHolder]
      simp only [lsmul_apply, hV]
      congr 2
      change ut x = u (-t + x) at hut
      simpa only [sub_eq_add_neg, add_comm] using hut
    have hHolderBound : ‖productL1‖ ≤ C := by
      have h := (lsmul ℂ ℂ).norm_holder_apply_apply_le V ut
      simpa only [productL1, C, DomAddAct.norm_vadd_Lp] using h
    have hIntegralNonneg :
        0 ≤ ∫ x : ℂ, ‖v x * K t * u (x - t)‖
          ∂(volume : Measure ℂ) :=
      integral_nonneg fun _ ↦ norm_nonneg _
    rw [Real.norm_of_nonneg hIntegralNonneg]
    calc
      (∫ x : ℂ, ‖v x * K t * u (x - t)‖
          ∂(volume : Measure ℂ)) =
          ‖K t‖ * ∫ x : ℂ, ‖v x * u (x - t)‖
            ∂(volume : Measure ℂ) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with x
        simp only [norm_mul]
        ring
      _ = ‖K t‖ * ‖productL1‖ := by rw [hProductNorm]
      _ ≤ ‖K t‖ * C :=
        mul_le_mul_of_nonneg_left hHolderBound (norm_nonneg (K t))

/-! ### Moving the `L²` pairing through the Bochner action -/

/-- Hilbert-valued convolution by an arbitrary integrable complex kernel. -/
noncomputable def kernelTranslationAction
    (K : ℂ → ℂ) (u : AmbientPlaneL2) : AmbientPlaneL2 :=
  ∫ t : ℂ, K t • (DomAddAct.mk (-t) +ᵥ u)

/-- Pairing the Hilbert-valued action with a compact smooth test gives the
first iterated integral, with the kernel variable outside. -/
theorem lpPairing_kernelTranslationAction
    (K : ℂ → ℂ) (hK : Integrable K (volume : Measure ℂ))
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    (lsmul ℂ ℂ).lpPairing (volume : Measure ℂ) 2 2
        (fullPlaneTestToL2 v) (kernelTranslationAction K u) =
      ∫ t : ℂ, ∫ x : ℂ, v x * K t * u (x - t)
        ∂(volume : Measure ℂ) ∂(volume : Measure ℂ) := by
  let P : AmbientPlaneL2 →L[ℂ] ℂ :=
    (lsmul ℂ ℂ).lpPairing (volume : Measure ℂ) 2 2
      (fullPlaneTestToL2 v)
  have hActionInt := integrable_kernel_smul_translation K u hK
  rw [kernelTranslationAction,
    ← ContinuousLinearMap.integral_comp_comm P hActionInt]
  apply integral_congr_ae
  filter_upwards with t
  change P (K t • (DomAddAct.mk (-t) +ᵥ u)) = _
  rw [show P (K t • (DomAddAct.mk (-t) +ᵥ u)) =
      K t * P (DomAddAct.mk (-t) +ᵥ u) by
        rw [map_smul, smul_eq_mul]]
  rw [show P (DomAddAct.mk (-t) +ᵥ u) =
      ∫ x : ℂ,
        (fullPlaneTestToL2 v) x *
          (DomAddAct.mk (-t) +ᵥ u) x
          ∂(volume : Measure ℂ) by
        exact (lsmul ℂ ℂ).lpPairing_eq_integral
          (fullPlaneTestToL2 v) (DomAddAct.mk (-t) +ᵥ u)]
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [coeFn_fullPlaneTestToL2 v,
    DomAddAct.vadd_Lp_ae_eq (DomAddAct.mk (-t)) u] with x hv hut
  simp only [lsmul_apply] at *
  rw [hv]
  have hut' : (DomAddAct.mk (-t) +ᵥ u) x = u (x - t) := by
    change (DomAddAct.mk (-t) +ᵥ u) x = u (-t + x) at hut
    simpa only [sub_eq_add_neg, add_comm] using hut
  rw [hut']
  ring

/-- Pointwise convolution with a complex kernel. -/
noncomputable def pointwiseKernelConvolution
    (K : ℂ → ℂ) (u : AmbientPlaneL2) (x : ℂ) : ℂ :=
  ∫ t : ℂ, K t * u (x - t)

/-- The compact-test pairing with the pointwise convolution is the other
iterated integral. -/
theorem integral_test_mul_pointwiseKernelConvolution
    (K : ℂ → ℂ) (hK : Integrable K (volume : Measure ℂ))
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    (∫ x : ℂ, v x * pointwiseKernelConvolution K u x
        ∂(volume : Measure ℂ)) =
      ∫ x : ℂ, ∫ t : ℂ, v x * K t * u (x - t)
        ∂(volume : Measure ℂ) ∂(volume : Measure ℂ) := by
  apply integral_congr_ae
  filter_upwards with x
  unfold pointwiseKernelConvolution
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with t
  ring

/-- Every compact smooth test has the same pairing with the Hilbert-valued
kernel action and the literal pointwise convolution. -/
theorem fullPlaneBilinearPair_kernelTranslationAction_eq_pointwise
    (K : ℂ → ℂ) (hK : Integrable K (volume : Measure ℂ))
    (v : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair v (kernelTranslationAction K u) =
      ∫ x : ℂ, v x * pointwiseKernelConvolution K u x
        ∂(volume : Measure ℂ) := by
  rw [fullPlaneBilinearPair_eq_lpPairing,
    lpPairing_kernelTranslationAction K hK]
  rw [integral_test_mul_pointwiseKernelConvolution K hK]
  exact (integral_integral_swap
    (integrable_fullPlaneTest_mul_kernel_mul_translate K hK v u)).symm

/-! ### Specialization to the normalized mollifier -/

theorem kernelTranslationAction_friedrichsMollifier
    (j : ℕ) (u : AmbientPlaneL2) :
    kernelTranslationAction (friedrichsMollifier j) u =
      friedrichsMollifierAction j u :=
  rfl

theorem pointwiseKernelConvolution_friedrichsMollifier
    (j : ℕ) (u : AmbientPlaneL2) (x : ℂ) :
    pointwiseKernelConvolution (friedrichsMollifier j) u x =
      friedrichsMollifiedRepresentative j u x := by
  unfold pointwiseKernelConvolution friedrichsMollifiedRepresentative
  rw [convolution_lsmul]
  apply integral_congr_ae
  filter_upwards with t
  simp only [friedrichsMollifier, lsmul_apply, Complex.real_smul]

/-- Pairing form of the desired representative identity. -/
theorem fullPlaneBilinearPair_friedrichsMollifierAction
    (j : ℕ) (v : FullPlaneTest) (u : AmbientPlaneL2) :
    fullPlaneBilinearPair v (friedrichsMollifierAction j u) =
      ∫ x : ℂ, v x * friedrichsMollifiedRepresentative j u x
        ∂(volume : Measure ℂ) := by
  rw [← kernelTranslationAction_friedrichsMollifier]
  simpa only [pointwiseKernelConvolution_friedrichsMollifier] using
    fullPlaneBilinearPair_kernelTranslationAction_eq_pointwise
      (friedrichsMollifier j) (friedrichsMollifier_integrable j) v u

/-- A real scalar test, complexified, as a full-plane compact smooth test. -/
noncomputable def realFullPlaneTest
    (g : ℂ → ℝ) (hg : ContDiff ℝ ∞ g)
    (hcompact : HasCompactSupport g) : FullPlaneTest where
  toFun := fun x ↦ (g x : ℂ)
  contDiff' := Complex.ofRealCLM.contDiff.comp hg
  hasCompactSupport' := hcompact.comp_left rfl
  tsupport_subset' := subset_univ

@[simp]
theorem realFullPlaneTest_apply
    (g : ℂ → ℝ) (hg : ContDiff ℝ ∞ g)
    (hcompact : HasCompactSupport g) (x : ℂ) :
    realFullPlaneTest g hg hcompact x = (g x : ℂ) :=
  rfl

/-- Compact support of the literal affine commutator kernel, obtained from
its already-proved closed-ball support bound. -/
theorem friedrichsAffineCommutatorKernel_hasCompactSupport
    (sigma : ℂ) (j : ℕ) :
    HasCompactSupport (friedrichsAffineCommutatorKernel sigma j) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : ℂ) (friedrichsRadius j))
  intro t ht
  by_contra hne
  exact ht <| by
    simpa only [mem_closedBall, dist_zero_right] using
      friedrichsAffineCommutatorKernel_support_bound sigma j t hne

/-- Smoothness of the scaled affine commutator kernel. -/
theorem friedrichsAffineCommutatorKernel_contDiff
    (sigma : ℂ) (j : ℕ) :
    ContDiff ℝ ∞ (friedrichsAffineCommutatorKernel sigma j) := by
  have hScaled : ContDiff ℝ ∞
      (fun t : ℂ ↦ friedrichsUnitAffineCommutatorTest sigma
        (friedrichsScale j • t)) :=
    (friedrichsUnitAffineCommutatorTest sigma).contDiff.comp
      (contDiff_const_smul (friedrichsScale j))
  have hConst : ContDiff ℝ ∞
      (fun _t : ℂ ↦ (((friedrichsScale j ^ 2 : ℝ) : ℂ))) :=
    contDiff_const
  simpa only [friedrichsAffineCommutatorKernel] using hConst.mul hScaled

/-- Pointwise convolution by the affine kernel is a genuine smooth
function, hence locally integrable. -/
theorem pointwiseKernelConvolution_affine_contDiff
    (sigma : ℂ) (j : ℕ) (u : AmbientPlaneL2) :
    ContDiff ℝ ∞
      (pointwiseKernelConvolution
        (friedrichsAffineCommutatorKernel sigma j) u) := by
  change ContDiff ℝ ∞
    (friedrichsAffineCommutatorKernel sigma j
      ⋆[mul ℂ ℂ, volume] (u : ℂ → ℂ))
  exact (friedrichsAffineCommutatorKernel_hasCompactSupport sigma j).contDiff_convolution_left (mul ℂ ℂ)
      (friedrichsAffineCommutatorKernel_contDiff sigma j)
      ((MeasureTheory.Lp.memLp u).locallyIntegrable (by norm_num))

/-- **Bochner/pointwise Friedrichs bridge.**  The Hilbert-valued normalized
mollifier action is represented almost everywhere by the actual smooth
pointwise convolution. -/
theorem friedrichsMollifierAction_ae_eq_mollifiedRepresentative
    (j : ℕ) (u : AmbientPlaneL2) :
    (friedrichsMollifierAction j u : ℂ → ℂ) =ᵐ[
        (volume : Measure ℂ)]
      friedrichsMollifiedRepresentative j u := by
  apply ae_eq_of_integral_contDiff_smul_eq
    ((MeasureTheory.Lp.memLp (friedrichsMollifierAction j u)).locallyIntegrable (by norm_num))
    ((friedrichsMollifiedRepresentative_contDiff j u).continuous.locallyIntegrable)
  intro g hg hcompact
  let v : FullPlaneTest := realFullPlaneTest g hg hcompact
  have hPair := fullPlaneBilinearPair_friedrichsMollifierAction j v u
  unfold fullPlaneBilinearPair at hPair
  simpa only [v, realFullPlaneTest_apply, Complex.real_smul] using hPair

/-- The analogous representative bridge for the affine commutator action. -/
theorem friedrichsAffineCommutatorAction_ae_eq_pointwise
    (sigma : ℂ) (j : ℕ) (u : AmbientPlaneL2) :
    (friedrichsAffineCommutatorAction sigma j u : ℂ → ℂ) =ᵐ[
        (volume : Measure ℂ)]
      pointwiseKernelConvolution
        (friedrichsAffineCommutatorKernel sigma j) u := by
  apply ae_eq_of_integral_contDiff_smul_eq
    ((MeasureTheory.Lp.memLp
      (friedrichsAffineCommutatorAction sigma j u)).locallyIntegrable (by norm_num))
    ((pointwiseKernelConvolution_affine_contDiff sigma j u).continuous.locallyIntegrable)
  intro g hg hcompact
  let v : FullPlaneTest := realFullPlaneTest g hg hcompact
  have hPair :=
    fullPlaneBilinearPair_kernelTranslationAction_eq_pointwise
      (friedrichsAffineCommutatorKernel sigma j)
      (friedrichsAffineCommutatorKernel_integrable sigma j) v u
  have hAction : kernelTranslationAction
      (friedrichsAffineCommutatorKernel sigma j) u =
        friedrichsAffineCommutatorAction sigma j u := rfl
  rw [hAction] at hPair
  unfold fullPlaneBilinearPair at hPair
  simpa only [v, realFullPlaneTest_apply, Complex.real_smul] using hPair

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3BochnerPointwiseBridge

#print axioms FixedPhaseNormalizedFriedrichs.integrable_fullPlaneTest_mul_kernel_mul_translate
#print axioms FixedPhaseNormalizedFriedrichs.fullPlaneBilinearPair_kernelTranslationAction_eq_pointwise
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifierAction_ae_eq_mollifiedRepresentative
