/-!
This fragment is intended after
`P3_Reduced_Chart_Periodization_Closure_Fragment.lean`.

It constructs a genuine fundamental carrier containing a prescribed reduced
chart.  This is the measure-theoretic descent needed at paired polygon sides:
the Petersson completion can be restricted to the whole quotient chart, not
only to its intersection with the chosen six-tile polygon.  The restriction
is first constructed on the smooth Petersson core, is proved contractive, and
is then extended continuously to the completed Petersson Hilbert space.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Pointwise ENNReal
open HalfIntegralMultiplier
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseAffineFriedrichs
open FixedPhaseClosedOperators

noncomputable section

/-! ### A fundamental carrier containing one reduced chart -/

/-- Saturation of a set by the effective `Gamma(2)` action. -/
def gammaTwoOrbitSaturation (U : Set ℍ) : Set ℍ :=
  ⋃ a : GammaTwoEffective, a • U

theorem subset_gammaTwoOrbitSaturation (U : Set ℍ) :
    U ⊆ gammaTwoOrbitSaturation U := by
  intro x hx
  exact Set.mem_iUnion.2 ⟨1, by simpa using hx⟩

theorem gammaTwoOrbitSaturation_measurable
    {U : Set ℍ} (hU : MeasurableSet U) :
    MeasurableSet (gammaTwoOrbitSaturation U) := by
  unfold gammaTwoOrbitSaturation
  exact MeasurableSet.iUnion fun a ↦ (hU.smul a)

/-- The saturation is literally invariant, not merely invariant almost
everywhere. -/
theorem smul_gammaTwoOrbitSaturation
    (a : GammaTwoEffective) (U : Set ℍ) :
    a • gammaTwoOrbitSaturation U = gammaTwoOrbitSaturation U := by
  apply Set.Subset.antisymm
  · intro x hx
    rw [Set.mem_smul_set_iff_inv_smul_mem] at hx
    rcases Set.mem_iUnion.1 hx with ⟨b, hb⟩
    apply Set.mem_iUnion.2
    refine ⟨a * b, ?_⟩
    rw [Set.mem_smul_set_iff_inv_smul_mem] at hb ⊢
    simpa only [mul_inv_rev, mul_smul] using hb
  · intro x hx
    rcases Set.mem_iUnion.1 hx with ⟨b, hb⟩
    rw [Set.mem_smul_set_iff_inv_smul_mem]
    apply Set.mem_iUnion.2
    refine ⟨a⁻¹ * b, ?_⟩
    rw [Set.mem_smul_set_iff_inv_smul_mem] at hb ⊢
    simpa only [mul_inv_rev, inv_inv, mul_smul] using hb

theorem smul_mem_gammaTwoOrbitSaturation_iff
    (a : GammaTwoEffective) (U : Set ℍ) (x : ℍ) :
    a • x ∈ gammaTwoOrbitSaturation U ↔
      x ∈ gammaTwoOrbitSaturation U := by
  calc
    a • x ∈ gammaTwoOrbitSaturation U ↔
        a • x ∈ a • gammaTwoOrbitSaturation U := by
          rw [smul_gammaTwoOrbitSaturation]
    _ ↔ x ∈ gammaTwoOrbitSaturation U := by simp

/-- All effective translates of a reduced chart are pairwise disjoint. -/
theorem gammaTwoReducedChart_pairwise_disjoint_translates (z₀ : ℍ) :
    Pairwise (Disjoint on fun a : GammaTwoEffective ↦
      a • gammaTwoReducedChart z₀) := by
  rw [pairwise_disjoint_smul_iff]
  intro a ha
  exact gammaTwoReducedChart_inter_translate_imp_eq_one z₀ a <| by
    simpa only [image_smul] using ha

/-- Replace the part of the chosen carrier lying in the orbit saturation of
the chart by the chart itself. -/
def gammaTwoReducedChartCompletedCarrier (z₀ : ℍ) : Set ℍ :=
  gammaTwoReducedChart z₀ ∪
    (chosenGammaTwoFundamentalDomain.carrier \
      gammaTwoOrbitSaturation (gammaTwoReducedChart z₀))

theorem gammaTwoReducedChart_subset_completedCarrier (z₀ : ℍ) :
    gammaTwoReducedChart z₀ ⊆
      gammaTwoReducedChartCompletedCarrier z₀ :=
  Set.subset_union_left

theorem gammaTwoReducedChartCompletedCarrier_measurable (z₀ : ℍ) :
    MeasurableSet (gammaTwoReducedChartCompletedCarrier z₀) := by
  apply MeasurableSet.union (gammaTwoReducedChart_isOpen z₀).measurableSet
  exact chosenGammaTwoFundamentalDomain.carrier_measurable.diff
    (gammaTwoOrbitSaturation_measurable
      (gammaTwoReducedChart_isOpen z₀).measurableSet)

/-- The completed chart carrier is a genuine fundamental domain for the
effective action.  This is the key seam-removal theorem. -/
theorem gammaTwoReducedChartCompletedCarrier_isFundamental (z₀ : ℍ) :
    IsFundamentalDomain GammaTwoEffective
      (gammaTwoReducedChartCompletedCarrier z₀)
      hyperbolicMeasure := by
  let U : Set ℍ := gammaTwoReducedChart z₀
  let S : Set ℍ := gammaTwoOrbitSaturation U
  let D : Set ℍ := chosenGammaTwoFundamentalDomain.carrier
  let R : Set ℍ := D \ S
  have hPair : Pairwise (Disjoint on fun a : GammaTwoEffective ↦ a • U) :=
    gammaTwoReducedChart_pairwise_disjoint_translates z₀
  have hUsubS : U ⊆ S := subset_gammaTwoOrbitSaturation U
  have hSInvariant (a : GammaTwoEffective) : a • S = S :=
    smul_gammaTwoOrbitSaturation a U
  have hCover : ∀ᵐ x ∂hyperbolicMeasure,
      ∃ a : GammaTwoEffective,
        a • x ∈ gammaTwoReducedChartCompletedCarrier z₀ := by
    filter_upwards [chosenGammaTwoFundamentalDomain.isFundamental.ae_covers]
      with x hx
    rcases hx with ⟨a, haD⟩
    by_cases haS : a • x ∈ S
    · rcases Set.mem_iUnion.1 haS with ⟨b, hb⟩
      refine ⟨b⁻¹ * a, ?_⟩
      apply Set.mem_union_left
      rw [Set.mem_smul_set_iff_inv_smul_mem] at hb
      simpa only [U, mul_smul] using hb
    · exact ⟨a, Set.mem_union_right _ ⟨haD, haS⟩⟩
  refine IsFundamentalDomain.mk''
    (gammaTwoReducedChartCompletedCarrier_measurable z₀).nullMeasurableSet hCover ?_ ?_
  · intro a ha
    have hUU : Disjoint (a • U) U := by
      simpa only [one_smul] using hPair ha
    have hUR : Disjoint (a • U) R := by
      rw [Set.disjoint_left]
      intro x hxa hxR
      exact hxR.2 <| Set.mem_iUnion.2 ⟨a, hxa⟩
    have hRU : Disjoint (a • R) U := by
      rw [Set.disjoint_left]
      intro x hxa hxU
      rw [Set.mem_smul_set_iff_inv_smul_mem] at hxa
      have hxS : x ∈ S := hUsubS hxU
      have hpreS : a⁻¹ • x ∈ S :=
        (smul_mem_gammaTwoOrbitSaturation_iff a⁻¹ U x).2 hxS
      exact hxa.2 hpreS
    have hDD : AEDisjoint hyperbolicMeasure (a • D) D := by
      simpa only [D, one_smul, Function.onFun] using
        chosenGammaTwoFundamentalDomain.isFundamental.aedisjoint ha
    have hRR : AEDisjoint hyperbolicMeasure (a • R) R :=
      hDD.mono (by
        simpa only [image_smul] using
          (Set.image_mono Set.diff_subset :
            (a • ·) '' R ⊆ (a • ·) '' D)) Set.diff_subset
    have hLeftU : AEDisjoint hyperbolicMeasure (a • U) (U ∪ R) :=
      hUU.aedisjoint.union_right hUR.aedisjoint
    have hLeftR : AEDisjoint hyperbolicMeasure (a • R) (U ∪ R) :=
      hRU.aedisjoint.union_right hRR
    simpa only [gammaTwoReducedChartCompletedCarrier, U, D, S, R,
      smul_set_union] using hLeftU.union_left hLeftR
  · intro a
    exact (measurePreserving_smul a hyperbolicMeasure).quasiMeasurePreserving

/-! ### Reduced-chart integral bounds -/

/-- An invariant nonnegative density has no more mass on one reduced chart
than on a complete fundamental carrier. -/
theorem setLIntegral_reducedChart_le_chosenCarrier
    (z₀ : ℍ) (f : ℍ → ℝ≥0∞)
    (hf : ∀ (a : GammaTwoEffective) (z : ℍ), f (a • z) = f z) :
    (∫⁻ z in gammaTwoReducedChart z₀, f z ∂hyperbolicMeasure) ≤
      ∫⁻ z in chosenGammaTwoFundamentalDomain.carrier,
        f z ∂hyperbolicMeasure := by
  let C : Set ℍ := gammaTwoReducedChartCompletedCarrier z₀
  have hC := gammaTwoReducedChartCompletedCarrier_isFundamental z₀
  have hUsubC : gammaTwoReducedChart z₀ ⊆ C :=
    gammaTwoReducedChart_subset_completedCarrier z₀
  calc
    (∫⁻ z in gammaTwoReducedChart z₀, f z ∂hyperbolicMeasure) ≤
        ∫⁻ z in C, f z ∂hyperbolicMeasure :=
      lintegral_mono_set hUsubC
    _ = ∫⁻ z in chosenGammaTwoFundamentalDomain.carrier,
        f z ∂hyperbolicMeasure :=
      hC.setLIntegral_eq
        chosenGammaTwoFundamentalDomain.isFundamental f hf

/-- The real invariant Petersson density is integrable on every reduced
chart. -/
theorem upstairsNormSqDensity_integrableOn_reducedChart
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    IntegrableOn
      (upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore)
      (gammaTwoReducedChart z₀) hyperbolicMeasure := by
  let f : ℍ → ℝ :=
    upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore
  have hD : IntegrableOn f
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure := by
    have hSelf := upstairsInnerDensity_integrableOn
      (OrbitMultiplier n) u.toSmoothCore u.toSmoothCore
      chosenGammaTwoFundamentalDomain
    simpa only [f, upstairsInnerDensity_self, Complex.ofReal_re] using
      hSelf.re
  have hDlin :
      (∫⁻ z in chosenGammaTwoFundamentalDomain.carrier,
          ENNReal.ofReal (f z) ∂hyperbolicMeasure) < ∞ := by
    apply (hasFiniteIntegral_iff_ofReal
      (Filter.Eventually.of_forall fun z ↦
        upstairsNormSqDensity_nonneg
          (OrbitMultiplier n) u.toSmoothCore z)).mp
    exact hD.2
  have hLe :
      (∫⁻ z in gammaTwoReducedChart z₀,
          ENNReal.ofReal (f z) ∂hyperbolicMeasure) ≤
        ∫⁻ z in chosenGammaTwoFundamentalDomain.carrier,
          ENNReal.ofReal (f z) ∂hyperbolicMeasure := by
    apply setLIntegral_reducedChart_le_chosenCarrier z₀
    intro a z
    rw [upstairsNormSqDensity_effective_invariant]
  refine ⟨?_, ?_⟩
  · exact (upstairsNormSqDensity_continuous
      (OrbitMultiplier n) u.toSmoothCore).aestronglyMeasurable.restrict
  · apply (hasFiniteIntegral_iff_ofReal
      (Filter.Eventually.of_forall fun z ↦
        upstairsNormSqDensity_nonneg
          (OrbitMultiplier n) u.toSmoothCore z)).mpr
    exact hLe.trans_lt hDlin

/-- Euclidean gauge norm-squared on a chart is the invariant Petersson
density integrated against hyperbolic area. -/
theorem setIntegral_orbitEuclideanGauge_norm_sq_eq_density
    (n : ℤ) (u : OrbitPeterssonCore n)
    (s : Set ℍ) (hs : MeasurableSet s) :
    (∫ z in s, ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure) =
      ∫ z in s,
        upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z
        ∂hyperbolicMeasure := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.hyperbolicMeasure_eq_euclidean_withDensity,
    setIntegral_withDensity_eq_setIntegral_smul
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.hyperbolicDensity_measurable _ hs]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z ↦
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge_norm_sq n u z

theorem orbitEuclideanGauge_memLp_reducedChart
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    MemLp (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u) 2
      (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure.restrict
        (gammaTwoReducedChart z₀)) := by
  apply (memLp_two_iff_integrable_sq_norm
    (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge_continuous n u).aestronglyMeasurable.restrict).2
  have hHyperbolic :=
    upstairsNormSqDensity_integrableOn_reducedChart n z₀ u
  change Integrable
    (upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore)
    (hyperbolicMeasure.restrict (gammaTwoReducedChart z₀)) at
      hHyperbolic
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.hyperbolicMeasure_eq_euclidean_withDensity,
    Measure.restrict_withDensity
      (gammaTwoReducedChart_isOpen z₀).measurableSet] at hHyperbolic
  have hWeighted :=
    (integrable_withDensity_iff_integrable_smul
      (mu := Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure.restrict
        (gammaTwoReducedChart z₀))
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.hyperbolicDensity_measurable).mp hHyperbolic
  simpa only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge_norm_sq] using hWeighted

/-! ### The completed chart restriction in planar `L2` -/

/-- Zero extension of a smooth Petersson gauge from a reduced chart to the
ambient complex plane. -/
noncomputable def ambientReducedChartGauge
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) : ℂ → ℂ :=
  (ambientGammaTwoReducedChart z₀).indicator
    (upperLift (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u))

theorem ambientReducedChartGauge_comp_coe
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) (z : ℍ) :
    ambientReducedChartGauge n z₀ u (z : ℂ) =
      (gammaTwoReducedChart z₀).indicator
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u) z := by
  have hz : (z : ℂ) ∈ ambientGammaTwoReducedChart z₀ ↔
      z ∈ gammaTwoReducedChart z₀ := by
    constructor
    · rintro ⟨w, hw, hwz⟩
      exact UpperHalfPlane.coe_injective hwz ▸ hw
    · intro hz
      exact ⟨z, hz, rfl⟩
  by_cases h : z ∈ gammaTwoReducedChart z₀
  · simp [ambientReducedChartGauge, h, hz.2 h, upperLift_apply]
  · simp [ambientReducedChartGauge, h, fun hw ↦ h (hz.1 hw)]

theorem ambientReducedChartGauge_support_subset_range
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    Function.support (ambientReducedChartGauge n z₀ u) ⊆
      Set.range UpperHalfPlane.coe := by
  intro w hw
  by_contra hwRange
  have hwChart : w ∉ ambientGammaTwoReducedChart z₀ := by
    intro hwChart
    have hwUpper :=
      ambientGammaTwoReducedChart_subset_upperPlaneOpen z₀ hwChart
    exact hwRange ⟨⟨w, hwUpper⟩, rfl⟩
  exact hw <| by simp [ambientReducedChartGauge, hwChart]

theorem ambientReducedChartGauge_memLp
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    MemLp (ambientReducedChartGauge n z₀ u) 2
      (volume : Measure ℂ) := by
  have hUpper : MemLp
      ((gammaTwoReducedChart z₀).indicator
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u)) 2
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
    exact (memLp_indicator_iff_restrict
      (gammaTwoReducedChart_isOpen z₀).measurableSet).2
        (orbitEuclideanGauge_memLp_reducedChart n z₀ u)
  have hMapped : MemLp (ambientReducedChartGauge n z₀ u) 2
      (Measure.map UpperHalfPlane.coe
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure) := by
    apply UpperHalfPlane.measurableEmbedding_coe.memLp_map_measure_iff.2
    simpa only [Function.comp_apply,
      ambientReducedChartGauge_comp_coe] using hUpper
  have hRestricted : MemLp (ambientReducedChartGauge n z₀ u) 2
      ((volume : Measure ℂ).restrict
        (Set.range UpperHalfPlane.coe)) := by
    simpa only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure,
      UpperHalfPlane.measurableEmbedding_coe.map_comap] using hMapped
  have hRangeMeas : MeasurableSet (Set.range UpperHalfPlane.coe) :=
    UpperHalfPlane.measurableEmbedding_coe.measurableSet_range
  have hSupport := ambientReducedChartGauge_support_subset_range n z₀ u
  refine ⟨?_, ?_⟩
  · have hIndicator : AEStronglyMeasurable
        ((Set.range UpperHalfPlane.coe).indicator
          (ambientReducedChartGauge n z₀ u))
        (volume : Measure ℂ) :=
      (aestronglyMeasurable_indicator_iff hRangeMeas).2 hRestricted.1
    apply hIndicator.congr
    exact Filter.Eventually.of_forall fun w ↦ by
      by_cases hw : w ∈ Set.range UpperHalfPlane.coe
      · simp [hw]
      · have hzero : ambientReducedChartGauge n z₀ u w = 0 := by
          by_contra hne
          exact hw (hSupport hne)
        simp [hw, hzero]
  · rw [← eLpNorm_restrict_eq_of_support_subset hSupport]
    exact hRestricted.2

/-- Core restriction to a quotient chart as an ordinary planar `L2`
vector. -/
noncomputable def orbitPeterssonCoreToReducedChartL2
    (n : ℤ) (z₀ : ℍ) :
    OrbitPeterssonCore n →ₗ[ℂ] AmbientPlaneL2 where
  toFun u := (ambientReducedChartGauge_memLp n z₀ u).toLp
    (ambientReducedChartGauge n z₀ u)
  map_add' u v := by
    apply MeasureTheory.Lp.ext
    filter_upwards [
      MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ (u + v)),
      MeasureTheory.Lp.coeFn_add
        ((ambientReducedChartGauge_memLp n z₀ u).toLp
          (ambientReducedChartGauge n z₀ u))
        ((ambientReducedChartGauge_memLp n z₀ v).toLp
          (ambientReducedChartGauge n z₀ v)),
      MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ u),
      MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ v)]
        with w hsum hadd hu hv
    rw [hsum, hadd, hu, hv]
    simp only [ambientReducedChartGauge,
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge_add, Pi.add_apply,
      Set.indicator_add]
  map_smul' c u := by
    apply MeasureTheory.Lp.ext
    filter_upwards [
      MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ (c • u)),
      MeasureTheory.Lp.coeFn_smul c
        ((ambientReducedChartGauge_memLp n z₀ u).toLp
          (ambientReducedChartGauge n z₀ u)),
      MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ u)]
        with w hsmul hlp hu
    rw [hsmul, hlp, hu]
    by_cases hw : w ∈ ambientGammaTwoReducedChart z₀ <;>
      simp [ambientReducedChartGauge, hw,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge_smul]

theorem coeFn_orbitPeterssonCoreToReducedChartL2
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    (orbitPeterssonCoreToReducedChartL2 n z₀ u : ℂ → ℂ) =ᵐ[
        (volume : Measure ℂ)]
      ambientReducedChartGauge n z₀ u :=
  MemLp.coeFn_toLp (ambientReducedChartGauge_memLp n z₀ u)

/-- Squared `L2` norm of a chart restriction. -/
theorem orbitPeterssonCoreToReducedChartL2_norm_sq
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    ‖orbitPeterssonCoreToReducedChartL2 n z₀ u‖ ^ 2 =
      ∫ z in gammaTwoReducedChart z₀,
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
  let g : ℍ → ℂ := Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u
  have hUpper : MemLp
      ((gammaTwoReducedChart z₀).indicator g) 2
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
    exact (memLp_indicator_iff_restrict
      (gammaTwoReducedChart_isOpen z₀).measurableSet).2
        (orbitEuclideanGauge_memLp_reducedChart n z₀ u)
  let qUpper : MeasureTheory.Lp ℂ 2
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure :=
    hUpper.toLp ((gammaTwoReducedChart z₀).indicator g)
  let q := orbitPeterssonCoreToReducedChartL2 n z₀ u
  have hNorm : ‖q‖ = ‖qUpper‖ := by
    rw [MeasureTheory.Lp.norm_toLp, MeasureTheory.Lp.norm_toLp]
    congr 1
    calc
      eLpNorm (ambientReducedChartGauge n z₀ u) 2
          (volume : Measure ℂ) =
          eLpNorm (ambientReducedChartGauge n z₀ u) 2
            ((volume : Measure ℂ).restrict
              (Set.range UpperHalfPlane.coe)) :=
        (eLpNorm_restrict_eq_of_support_subset
          (ambientReducedChartGauge_support_subset_range n z₀ u)).symm
      _ = eLpNorm (ambientReducedChartGauge n z₀ u) 2
          (Measure.map UpperHalfPlane.coe
            Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure) := by
        simp only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure,
          UpperHalfPlane.measurableEmbedding_coe.map_comap]
      _ = eLpNorm
          (ambientReducedChartGauge n z₀ u ∘ UpperHalfPlane.coe) 2
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure :=
        UpperHalfPlane.measurableEmbedding_coe.eLpNorm_map_measure
      _ = eLpNorm ((gammaTwoReducedChart z₀).indicator g) 2
          Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
        apply eLpNorm_congr_ae
        exact Filter.Eventually.of_forall fun z ↦ by
          simpa only [Function.comp_apply, g] using
            ambientReducedChartGauge_comp_coe n z₀ u z
  calc
    ‖q‖ ^ 2 = ‖qUpper‖ ^ 2 := by rw [hNorm]
    _ = ∫ z : ℍ, ‖qUpper z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
      rw [← inner_self_eq_norm_sq, MeasureTheory.L2.inner_def,
        ← integral_re (MeasureTheory.L2.integrable_inner qUpper qUpper)]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z ↦
        inner_self_eq_norm_sq (𝕜 := ℂ) (qUpper z)
    _ = ∫ z : ℍ,
        ‖(gammaTwoReducedChart z₀).indicator g z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
      apply integral_congr_ae
      filter_upwards [MemLp.coeFn_toLp hUpper] with z hz
      rw [hz]
    _ = ∫ z in gammaTwoReducedChart z₀, ‖g z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := by
      rw [← integral_indicator
        (gammaTwoReducedChart_isOpen z₀).measurableSet]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z ↦ by
        by_cases hz : z ∈ gammaTwoReducedChart z₀ <;>
          simp [hz]
    _ = ∫ z in gammaTwoReducedChart z₀,
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitEuclideanGauge n u z‖ ^ 2
        ∂Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.upperEuclideanMeasure := rfl

theorem orbitPeterssonCore_norm_sq_eq_density_integral
    (n : ℤ) (u : OrbitPeterssonCore n) :
    ‖u‖ ^ 2 =
      ∫ z in chosenGammaTwoFundamentalDomain.carrier,
        upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z
        ∂hyperbolicMeasure := by
  rw [PeterssonCoreSpace.norm_sq_eq_peterssonNormSq]
  unfold peterssonNormSq
  exact chosenGammaTwoFundamentalDomain.integral_quotientMeasure_eq _
    (quotientNormSqDensity_integrable (OrbitMultiplier n) u.toSmoothCore
      chosenGammaTwoFundamentalDomain).aestronglyMeasurable

theorem orbitPeterssonCoreToReducedChartL2_norm_le
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    ‖orbitPeterssonCoreToReducedChartL2 n z₀ u‖ ≤ ‖u‖ := by
  have hD : IntegrableOn
      (upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore)
      chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure := by
    have hSelf := upstairsInnerDensity_integrableOn
      (OrbitMultiplier n) u.toSmoothCore u.toSmoothCore
      chosenGammaTwoFundamentalDomain
    simpa only [upstairsInnerDensity_self, Complex.ofReal_re] using hSelf.re
  have hU := upstairsNormSqDensity_integrableOn_reducedChart n z₀ u
  have hLin := setLIntegral_reducedChart_le_chosenCarrier z₀
    (fun z ↦ ENNReal.ofReal
      (upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z))
    (fun a z ↦ by rw [upstairsNormSqDensity_effective_invariant])
  have hIntegral :
      (∫ z in gammaTwoReducedChart z₀,
          upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z
          ∂hyperbolicMeasure) ≤
        ∫ z in chosenGammaTwoFundamentalDomain.carrier,
          upstairsNormSqDensity (OrbitMultiplier n) u.toSmoothCore z
          ∂hyperbolicMeasure := by
    have hDlin :
        (∫⁻ z in chosenGammaTwoFundamentalDomain.carrier,
            ENNReal.ofReal
              (upstairsNormSqDensity (OrbitMultiplier n)
                u.toSmoothCore z) ∂hyperbolicMeasure) < ∞ := by
      apply (hasFiniteIntegral_iff_ofReal
        (Filter.Eventually.of_forall fun z ↦
          upstairsNormSqDensity_nonneg
            (OrbitMultiplier n) u.toSmoothCore z)).mp
      exact hD.2
    rw [integral_eq_lintegral_of_nonneg_ae
        (Filter.Eventually.of_forall fun z ↦
          upstairsNormSqDensity_nonneg
            (OrbitMultiplier n) u.toSmoothCore z) hU.1,
      integral_eq_lintegral_of_nonneg_ae
        (Filter.Eventually.of_forall fun z ↦
          upstairsNormSqDensity_nonneg
            (OrbitMultiplier n) u.toSmoothCore z) hD.1]
    exact ENNReal.toReal_mono hDlin.ne hLin
  have hSq :
      ‖orbitPeterssonCoreToReducedChartL2 n z₀ u‖ ^ 2 ≤ ‖u‖ ^ 2 := by
    rw [orbitPeterssonCoreToReducedChartL2_norm_sq,
      setIntegral_orbitEuclideanGauge_norm_sq_eq_density,
      orbitPeterssonCore_norm_sq_eq_density_integral]
    exact hIntegral
  nlinarith [norm_nonneg (orbitPeterssonCoreToReducedChartL2 n z₀ u),
    norm_nonneg u]

/-- Contractive core chart restriction. -/
noncomputable def orbitPeterssonCoreToReducedChartCLM
    (n : ℤ) (z₀ : ℍ) :
    OrbitPeterssonCore n →L[ℂ] AmbientPlaneL2 :=
  (orbitPeterssonCoreToReducedChartL2 n z₀).mkContinuous 1 fun u ↦ by
    simpa only [one_mul] using
      orbitPeterssonCoreToReducedChartL2_norm_le n z₀ u

/-- Canonical restriction of a completed Petersson vector to a whole reduced
quotient chart. -/
noncomputable def orbitPeterssonReducedChartEmbedding
    (n : ℤ) (z₀ : ℍ) :
    OrbitPeterssonHilbert n →L[ℂ] AmbientPlaneL2 :=
  (orbitPeterssonCoreToReducedChartCLM n z₀).extend
    (UniformSpace.Completion.toComplL :
      OrbitPeterssonCore n →L[ℂ] OrbitPeterssonHilbert n)

@[simp]
theorem orbitPeterssonReducedChartEmbedding_coe
    (n : ℤ) (z₀ : ℍ) (u : OrbitPeterssonCore n) :
    orbitPeterssonReducedChartEmbedding n z₀
        (u : OrbitPeterssonHilbert n) =
      orbitPeterssonCoreToReducedChartL2 n z₀ u := by
  unfold orbitPeterssonReducedChartEmbedding
  exact ContinuousLinearMap.extend_eq _
    (UniformSpace.Completion.denseRange_coe :
      DenseRange ((↑) : OrbitPeterssonCore n → OrbitPeterssonHilbert n))
    (by simpa using UniformSpace.Completion.isUniformInducing_coe
      (OrbitPeterssonCore n)) u

theorem orbitPeterssonReducedChartEmbedding_norm_le
    (n : ℤ) (z₀ : ℍ) (x : OrbitPeterssonHilbert n) :
    ‖orbitPeterssonReducedChartEmbedding n z₀ x‖ ≤ ‖x‖ := by
  refine UniformSpace.Completion.denseRange_coe.induction_on x
    (isClosed_le
      (orbitPeterssonReducedChartEmbedding n z₀).continuous.norm
      continuous_norm) ?_
  intro u
  rw [orbitPeterssonReducedChartEmbedding_coe,
    UniformSpace.Completion.norm_coe]
  exact orbitPeterssonCoreToReducedChartL2_norm_le n z₀ u

end
end FixedPhaseReducedChartFriedrichs

