    (intrinsicLowerFromSuccCuspCutoffCommutator N n)
    (intrinsicLowerFromSuccPeterssonCommutator N n)
    (intrinsicLowerCommutatorCoefficient N)
    (intrinsicLowerCommutatorCoefficient_quotientCompact N)
    (intrinsicLowerFromSuccPeterssonCommutator_l2Coordinate N n)
    (fixedPhaseEuclideanGauge_intrinsicLowerFromSuccCommutator N n) x

/-! #### Literal maximal-adjoint cutoff exhaustions -/

noncomputable def intrinsicRaisingAdjointCutoffExhaustion (n : ℤ) :
    AdjointCutoffExhaustion (-physicalLowerFromSucc n)
      (RaisingCompactCarrierPairAt n) where
  U j := intrinsicPeterssonCuspCutoff j (n + 1)
  V j := intrinsicPeterssonCuspCutoff j n
  C j := intrinsicLowerFromSuccPeterssonCommutator j n
  adjoint_U_mem_domain j x :=
    adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange
      j (n + 1) x
  commutator j x :=
    negativePhysicalLowerFromSucc_intrinsicCutoff_commutator j n x
  tendsto_U x := intrinsicPeterssonCuspCutoff_tendsto_id (n + 1) x
  tendsto_V y := intrinsicPeterssonCuspCutoff_tendsto_id n y
  tendsto_adjoint_C_zero y := by
    simpa only [adjoint_intrinsicLowerFromSuccPeterssonCommutator] using
      intrinsicRaisePeterssonCommutator_tendsto_zero n y
  localized_property j y := by
    refine ⟨
      intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport j n (y : _),
      ?_⟩
    exact (intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
      j (n + 1) ((-physicalLowerFromSucc n)† y)).add <| by
        rw [adjoint_intrinsicLowerFromSuccPeterssonCommutator]
        exact intrinsicRaisePeterssonCommutator_hasCompactCarrierSupport
          j n (y : _)

noncomputable def intrinsicLoweringAdjointCutoffExhaustion (n : ℤ) :
    AdjointCutoffExhaustion (-physicalRaise n)
      (LoweringCompactCarrierPairAt n) where
  U j := intrinsicPeterssonCuspCutoff j n
  V j := intrinsicPeterssonCuspCutoff j (n + 1)
  C j := intrinsicRaisePeterssonCommutator j n
  adjoint_U_mem_domain j x :=
    adjoint_intrinsicPeterssonCuspCutoff_mem_l2CoreRange j n x
  commutator j x :=
    negativePhysicalRaise_intrinsicCutoff_commutator j n x
  tendsto_U x := intrinsicPeterssonCuspCutoff_tendsto_id n x
  tendsto_V y := intrinsicPeterssonCuspCutoff_tendsto_id (n + 1) y
  tendsto_adjoint_C_zero y := by
    simpa only [adjoint_intrinsicRaisePeterssonCommutator] using
      intrinsicLowerFromSuccPeterssonCommutator_tendsto_zero n y
  localized_property j y := by
    refine ⟨
      intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
        j (n + 1) (y : _), ?_⟩
    exact (intrinsicPeterssonCuspCutoff_hasCompactCarrierSupport
      j n ((-physicalRaise n)† y)).add <| by
        rw [adjoint_intrinsicRaisePeterssonCommutator]
        exact intrinsicLowerFromSuccPeterssonCommutator_hasCompactCarrierSupport
          j n (y : _)

theorem raisingInvariantCutoffGraphControlAt_unconditional (n : ℤ) :
    RaisingInvariantCutoffGraphControlAt n :=
  raisingInvariantCutoffGraphControlAt_of_adjointCutoffExhaustion
    (intrinsicRaisingAdjointCutoffExhaustion n)

theorem loweringInvariantCutoffGraphControlAt_unconditional (n : ℤ) :
    LoweringInvariantCutoffGraphControlAt n :=
  loweringInvariantCutoffGraphControlAt_of_adjointCutoffExhaustion
    (intrinsicLoweringAdjointCutoffExhaustion n)

