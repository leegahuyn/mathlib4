/-! #### The four concrete analytic obligations -/

/-- First raising obligation: every graph vector of the opposite maximal
adjoint satisfies the local weak raising equation.  Proving this requires
turning an ambient compact test into a legitimate automorphic test (or an
equivalent local-to-global distribution theorem). -/
def RaisingMaximalAdjointWeakMaassIdentificationAt (n : ℤ) : Prop :=
  ∀ p : OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1),
    p ∈ ((-physicalLowerFromSucc n)†).graph →
      IsEuclideanRaisingWeakGraphAt n p

/-- First lowering obligation. -/
def LoweringMaximalAdjointWeakMaassIdentificationAt (n : ℤ) : Prop :=
  ∀ p : OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n,
    p ∈ ((-physicalRaise n)†).graph →
      IsEuclideanLoweringWeakGraphAt n p

/-- Minimal ambient-test periodization at the successor index closes the
raising maximal-adjoint/weak-Maass identification.  The proof uses the
defining formal-adjoint identity of `(-L)†`, then transports both sides by
the concrete Petersson--Euclidean isometries. -/
theorem raisingMaximalAdjointWeakMaassIdentificationAt_of_periodization
    {n : ℤ}
    (hPeriod : AmbientTestPhysicalGaugePeriodizationAt (n + 1)) :
    RaisingMaximalAdjointWeakMaassIdentificationAt n := by
  intro p hp v hv
  obtain ⟨u, hEq⟩ := hPeriod v hv
  rcases (LinearPMap.mem_graph_iff ((-physicalLowerFromSucc n)†)).mp hp with
    ⟨x, hxBase, hxValue⟩
  have hFormal :=
    (LinearPMap.adjoint_isFormalAdjoint
      (T := -physicalLowerFromSucc n)
      (negativePhysicalLowerFromSucc_dense_domain n))
      x (l2CoreRangeEquiv (n + 1) u)
  rw [hxValue, hxBase] at hFormal
  have hPetersson :
      inner ℂ p.2 (l2Coordinate (n + 1) u) =
        inner ℂ p.1 (-lowerFromSuccCoordinate n u) := by
    simpa only [l2CoreRangeEquiv_coe, LinearPMap.neg_apply,
      physicalLowerFromSucc_on_core] using hFormal
  have hBase :=
    embedded_l2Coordinate_eq_ambientTest_of_periodizedGauge hEq
  have hSigned :=
    embedded_neg_lowerFromSuccCoordinate_eq_raiseTestAdjoint hEq
  calc
    inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.2)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1) v) =
      inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.2)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1) u)) := by rw [hBase]
    _ = inner ℂ p.2 (l2Coordinate (n + 1) u) :=
      (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry (n + 1)).inner_map_map p.2 (l2Coordinate (n + 1) u)
    _ = inner ℂ p.1 (-lowerFromSuccCoordinate n u) := hPetersson
    _ = inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (-lowerFromSuccCoordinate n u)) :=
      ((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map p.1 (-lowerFromSuccCoordinate n u)).symm
    _ = inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseTestAdjoint n v)) := by
      rw [hSigned]

/-- Periodization at the source index closes the lowering
maximal-adjoint/weak-Maass identification by the same signed argument for
`(-R)†`. -/
theorem loweringMaximalAdjointWeakMaassIdentificationAt_of_periodization
    {n : ℤ}
    (hPeriod : AmbientTestPhysicalGaugePeriodizationAt n) :
    LoweringMaximalAdjointWeakMaassIdentificationAt n := by
  intro p hp v hv
  obtain ⟨u, hEq⟩ := hPeriod v hv
  rcases (LinearPMap.mem_graph_iff ((-physicalRaise n)†)).mp hp with
    ⟨x, hxBase, hxValue⟩
  have hFormal :=
    (LinearPMap.adjoint_isFormalAdjoint
      (T := -physicalRaise n)
      (negativePhysicalRaise_dense_domain n))
      x (l2CoreRangeEquiv n u)
  rw [hxValue, hxBase] at hFormal
  have hPetersson :
      inner ℂ p.2 (l2Coordinate n u) =
        inner ℂ p.1 (-raisedCoordinate n u) := by
    simpa only [l2CoreRangeEquiv_coe, LinearPMap.neg_apply,
      physicalRaise_on_core] using hFormal
  have hBase :=
    embedded_l2Coordinate_eq_ambientTest_of_periodizedGauge hEq
  have hSigned :=
    embedded_neg_raisedCoordinate_eq_lowerFromSuccTestAdjoint hEq
  calc
    inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n v) =
      inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n p.2)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n u)) := by rw [hBase]
    _ = inner ℂ p.2 (l2Coordinate n u) :=
      (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map p.2 (l2Coordinate n u)
    _ = inner ℂ p.1 (-raisedCoordinate n u) := hPetersson
    _ = inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          (-raisedCoordinate n u)) :=
      ((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry (n + 1)).inner_map_map p.1 (-raisedCoordinate n u)).symm
    _ = inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1) p.1)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1)
          (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccTestAdjoint n v)) := by
      rw [hSigned]

theorem raisingMaximalAdjointWeakMaassIdentificationAt_of_globalPeriodization
    {n : ℤ} (hPeriod : AmbientTestPhysicalGaugePeriodization) :
    RaisingMaximalAdjointWeakMaassIdentificationAt n :=
  raisingMaximalAdjointWeakMaassIdentificationAt_of_periodization
    (hPeriod (n + 1))

theorem loweringMaximalAdjointWeakMaassIdentificationAt_of_globalPeriodization
    {n : ℤ} (hPeriod : AmbientTestPhysicalGaugePeriodization) :
    LoweringMaximalAdjointWeakMaassIdentificationAt n :=
  loweringMaximalAdjointWeakMaassIdentificationAt_of_periodization
    (hPeriod n)

/-- Compactly supported vectors in the raising maximal graph, before adding
the local weak-domain identification. -/
def RaisingCompactMaximalGraphAt (n : ℤ) :
    Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1)) :=
  {p | p ∈ ((-physicalLowerFromSucc n)†).graph ∧
    HasCompactCarrierSupport n p.1 ∧
      HasCompactCarrierSupport (n + 1) p.2}

/-- Compactly supported vectors in the lowering maximal graph. -/
def LoweringCompactMaximalGraphAt (n : ℤ) :
    Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n) :=
  {p | p ∈ ((-physicalRaise n)†).graph ∧
    HasCompactCarrierSupport (n + 1) p.1 ∧
      HasCompactCarrierSupport n p.2}

/-- The exact raising class to which finite-chart Friedrichs smoothing and
periodization must apply. -/
def RaisingCompactWeakMaximalGraphAt (n : ℤ) :
    Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1)) :=
  {p | p ∈ RaisingCompactMaximalGraphAt n ∧
    IsEuclideanRaisingWeakGraphAt n p}

/-- The exact lowering class to which finite-chart smoothing must apply. -/
def LoweringCompactWeakMaximalGraphAt (n : ℤ) :
    Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n) :=
  {p | p ∈ LoweringCompactMaximalGraphAt n ∧
    IsEuclideanLoweringWeakGraphAt n p}

theorem raisingCompactWeakMaximalGraphAt_subset_graph (n : ℤ) :
    RaisingCompactWeakMaximalGraphAt n ⊆
      (((-physicalLowerFromSucc n)†).graph :
        Set (OrbitPeterssonHilbert n × OrbitPeterssonHilbert (n + 1))) := by
  intro p hp
  exact hp.1.1

theorem loweringCompactWeakMaximalGraphAt_subset_graph (n : ℤ) :
    LoweringCompactWeakMaximalGraphAt n ⊆
      (((-physicalRaise n)†).graph :
        Set (OrbitPeterssonHilbert (n + 1) × OrbitPeterssonHilbert n)) := by
  intro p hp
  exact hp.1.1

/-- Second raising obligation: invariant cutoffs act on every maximal weak
graph vector, keep the localized vector in the same maximal graph, give both
coordinates compact carrier support, and converge in the product graph norm. -/
def RaisingInvariantCutoffGraphControlAt (n : ℤ) : Prop :=
  HasSequentialGraphLocalization ((-physicalLowerFromSucc n)†)
    (RaisingCompactMaximalGraphAt n)

/-- Second lowering obligation. -/
def LoweringInvariantCutoffGraphControlAt (n : ℤ) : Prop :=
  HasSequentialGraphLocalization ((-physicalRaise n)†)
    (LoweringCompactMaximalGraphAt n)

/-- Third raising obligation: compactly supported weak raising graph vectors
possess simultaneous base/derivative approximation by genuine fixed-phase
smooth quotient-compact sections.  This is the precise
Friedrichs-plus-periodization theorem absent from base `L²` density. -/
def RaisingCompactFriedrichsPeriodizationAt (n : ℤ) : Prop :=
  HasSequentialGraphRegularization (physicalRaise n)
    (RaisingCompactWeakMaximalGraphAt n)

/-- Third lowering obligation. -/
def LoweringCompactFriedrichsPeriodizationAt (n : ℤ) : Prop :=
  HasSequentialGraphRegularization (physicalLowerFromSucc n)
    (LoweringCompactWeakMaximalGraphAt n)

/-! #### Composition into the strong cross-adjoint theorem -/

/-- The three raising-side analytic inputs imply the exact sequential
physical-core approximation of the opposite maximal-adjoint graph. -/
theorem raisingMaximalAdjointSequentialApproximationAt_of_analyticRoute
    {n : ℤ}
    (hWeak : RaisingMaximalAdjointWeakMaassIdentificationAt n)
    (hCutoff : RaisingInvariantCutoffGraphControlAt n)
    (hFriedrichs : RaisingCompactFriedrichsPeriodizationAt n) :
    RaisingMaximalAdjointSequentialApproximationAt n := by
  apply hasSequentialGraphCore_of_localization_of_regularization
    (K := RaisingCompactWeakMaximalGraphAt n)
  · refine ⟨raisingCompactWeakMaximalGraphAt_subset_graph n, ?_⟩
    intro p hp
    obtain ⟨q, hqCompact, hqLimit⟩ := hCutoff.2 p hp
    refine ⟨q, ?_, hqLimit⟩
    intro j
    exact ⟨hqCompact j, hWeak (q j) (hqCompact j).1⟩
  · exact hFriedrichs

/-- The corresponding lowering-side composition theorem. -/
theorem loweringMaximalAdjointSequentialApproximationAt_of_analyticRoute
    {n : ℤ}
    (hWeak : LoweringMaximalAdjointWeakMaassIdentificationAt n)
    (hCutoff : LoweringInvariantCutoffGraphControlAt n)
    (hFriedrichs : LoweringCompactFriedrichsPeriodizationAt n) :
    LoweringMaximalAdjointSequentialApproximationAt n := by
  apply hasSequentialGraphCore_of_localization_of_regularization
    (K := LoweringCompactWeakMaximalGraphAt n)
  · refine ⟨loweringCompactWeakMaximalGraphAt_subset_graph n, ?_⟩
    intro p hp
    obtain ⟨q, hqCompact, hqLimit⟩ := hCutoff.2 p hp
    refine ⟨q, ?_, hqLimit⟩
    intro j
    exact ⟨hqCompact j, hWeak (q j) (hqCompact j).1⟩
  · exact hFriedrichs

/-- Once the exact ambient-test periodization is supplied, the raising
sequential-core theorem no longer carries a separate weak-domain premise. -/
theorem raisingMaximalAdjointSequentialApproximationAt_of_periodizationRoute
    {n : ℤ}
    (hPeriod : AmbientTestPhysicalGaugePeriodizationAt (n + 1))
    (hCutoff : RaisingInvariantCutoffGraphControlAt n)
    (hFriedrichs : RaisingCompactFriedrichsPeriodizationAt n) :
    RaisingMaximalAdjointSequentialApproximationAt n :=
  raisingMaximalAdjointSequentialApproximationAt_of_analyticRoute
    (raisingMaximalAdjointWeakMaassIdentificationAt_of_periodization hPeriod)
    hCutoff hFriedrichs

/-- Lowering counterpart of the preceding periodization route. -/
theorem loweringMaximalAdjointSequentialApproximationAt_of_periodizationRoute
    {n : ℤ}
    (hPeriod : AmbientTestPhysicalGaugePeriodizationAt n)
    (hCutoff : LoweringInvariantCutoffGraphControlAt n)
    (hFriedrichs : LoweringCompactFriedrichsPeriodizationAt n) :
    LoweringMaximalAdjointSequentialApproximationAt n :=
  loweringMaximalAdjointSequentialApproximationAt_of_analyticRoute
    (loweringMaximalAdjointWeakMaassIdentificationAt_of_periodization hPeriod)
    hCutoff hFriedrichs

/-- With the unconditional global Green theorem already proved, the two weak
identifications, two cutoff graph estimates, and two compact Friedrichs
periodization theorems are sufficient for the actual strong cross-adjoint
equalities.  Every still-missing analytic premise remains explicit. -/
theorem strongCrossAdjointAt_of_weakMaass_cutoff_Friedrichs
    {n : ℤ}
    (hRaiseWeak : RaisingMaximalAdjointWeakMaassIdentificationAt n)
    (hRaiseCutoff : RaisingInvariantCutoffGraphControlAt n)
    (hRaiseFriedrichs : RaisingCompactFriedrichsPeriodizationAt n)
    (hLowerWeak : LoweringMaximalAdjointWeakMaassIdentificationAt n)
    (hLowerCutoff : LoweringInvariantCutoffGraphControlAt n)
    (hLowerFriedrichs : LoweringCompactFriedrichsPeriodizationAt n) :
    StrongCrossAdjointAt n := by
  apply (strongCrossAdjointAt_iff_sequentialApproximations
    (physicalGreenIdentityAt_unconditional n)).2
  exact ⟨
    raisingMaximalAdjointSequentialApproximationAt_of_analyticRoute
      hRaiseWeak hRaiseCutoff hRaiseFriedrichs,
    loweringMaximalAdjointSequentialApproximationAt_of_analyticRoute
      hLowerWeak hLowerCutoff hLowerFriedrichs⟩

/-- The exact local-to-global periodization theorem discharges both weak
maximal-adjoint identifications.  Thus only cutoff graph convergence and
compact Friedrichs regularization remain in the final strong cross-adjoint
interface. -/
theorem strongCrossAdjointAt_of_periodization_cutoff_Friedrichs
    {n : ℤ}
    (hPeriod : AmbientTestPhysicalGaugePeriodization)
    (hRaiseCutoff : RaisingInvariantCutoffGraphControlAt n)
    (hRaiseFriedrichs : RaisingCompactFriedrichsPeriodizationAt n)
    (hLowerCutoff : LoweringInvariantCutoffGraphControlAt n)
    (hLowerFriedrichs : LoweringCompactFriedrichsPeriodizationAt n) :
    StrongCrossAdjointAt n :=
  strongCrossAdjointAt_of_weakMaass_cutoff_Friedrichs
    (raisingMaximalAdjointWeakMaassIdentificationAt_of_globalPeriodization
      hPeriod)
    hRaiseCutoff hRaiseFriedrichs
    (loweringMaximalAdjointWeakMaassIdentificationAt_of_globalPeriodization
      hPeriod)
    hLowerCutoff hLowerFriedrichs

end FixedPhaseEssentialCoreRoute

