noncomputable def intrinsicCuspCutoffSmoothQuotient (N : ℕ) :
    SmoothQuotientCompactFunction :=
  ⟨⟨intrinsicCuspCutoff N, intrinsicCuspCutoff_realSmooth N⟩,
    intrinsicCuspCutoff_quotientCompact N⟩

@[simp]
theorem intrinsicCuspCutoffSmoothQuotient_apply
    (N : ℕ) (z : ℍ) :
    (intrinsicCuspCutoffSmoothQuotient N : ℍ → ℂ) z =
      intrinsicCuspCutoff N z :=
  rfl

theorem intrinsicCuspCutoffSmoothQuotient_invariant (N : ℕ) :
    IsGammaTwoInvariantCutoff (intrinsicCuspCutoffSmoothQuotient N) := by
  intro gamma z
  exact intrinsicCuspCutoff_gammaTwo_invariant N gamma z

/-- Multiplication by the intrinsic cutoff on the literal fixed-phase core. -/
noncomputable def intrinsicCuspCutoffOperator (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n where
  toFun u :=
    invariantCutoffTimesOrbitSection n
      (intrinsicCuspCutoffSmoothQuotient N)
      (intrinsicCuspCutoffSmoothQuotient_invariant N)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore.toWeightSection n u)
      (u : SmoothQuotientCompactFunction).1.2
  map_add' u v := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    rfl
  map_smul' c u := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    funext z
    rfl

@[simp]
theorem intrinsicCuspCutoffOperator_apply
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (z : ℍ) :
    ((intrinsicCuspCutoffOperator N n u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
        SmoothQuotientCompactFunction) z =
      intrinsicCuspCutoff N z *
        (u : SmoothQuotientCompactFunction) z :=
  rfl

theorem modularLogMaxHeight_effective_invariant
    (a : GammaTwoEffective) (z : ℍ) :
    modularLogMaxHeight (a • z) = modularLogMaxHeight z := by
  obtain ⟨gamma, hgamma⟩ := effective_exists_gamma a
  rw [hgamma z]
  exact modularLogMaxHeight_gammaTwo_invariant gamma z

/-- On each quotient-compact core vector the intrinsic cutoff is exactly one
from a finite stage onward. -/
theorem exists_intrinsicCuspCutoffOperator_eventually_eq
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ∃ N : ℕ, ∀ M : ℕ, N ≤ M →
      intrinsicCuspCutoffOperator M n u = u := by
  let K : Set ℍ := gammaTwoClosedTileCarrier ∩
    gammaTwoQuotientMk ⁻¹'
      quotientTSupport (((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
  have hK : IsCompact K :=
    gammaTwoClosedCarrier_inter_preimage_isCompact _
      (u : SmoothQuotientCompactFunction).2
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
    modularLogMaxHeight_continuous.continuousOn
  obtain ⟨N, hN⟩ := exists_nat_gt C
  refine ⟨N, fun M hNM ↦ ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  apply Subtype.ext
  funext z
  change intrinsicCuspCutoff M z *
      (u : SmoothQuotientCompactFunction) z =
    (u : SmoothQuotientCompactFunction) z
  by_cases huz : (u : SmoothQuotientCompactFunction) z = 0
  · simp only [huz, mul_zero]
  · obtain ⟨a, ha⟩ := gammaTwoClosedTileCarrier_orbit_covers z
    let w : ℍ := a • z
    have hwK : w ∈ K := by
      refine ⟨ha, ?_⟩
      have hzSupport : gammaTwoQuotientMk z ∈
          quotientTSupport
            (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) :=
        subset_closure ⟨z, huz, rfl⟩
      simpa only [w, gammaTwoQuotientMk_smul] using hzSupport
    have hRhoW : modularLogMaxHeight w ≤ C :=
      (le_abs_self _).trans (hC w hwK)
    have hRhoZ : modularLogMaxHeight z ≤ (M : ℝ) + 1 := by
      rw [← modularLogMaxHeight_effective_invariant a z]
      exact hRhoW.trans <| by
        have hCastN : C < (N : ℝ) := hN
        have hCastNM : (N : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
        linarith
    rw [intrinsicCuspCutoff, intrinsicCuspCutoffReal_eq_one_of_logHeight_le
      hRhoZ, Complex.ofReal_one, one_mul]

theorem intrinsicCuspCutoffOperator_eventuallyEq
    (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    (fun M ↦ intrinsicCuspCutoffOperator M n u) =ᶠ[Filter.atTop]
      (fun _ ↦ u) := by
  obtain ⟨N, hN⟩ :=
    exists_intrinsicCuspCutoffOperator_eventually_eq n u
  filter_upwards [eventually_ge_atTop N] with M hM
  exact hN M hM

/-! #### Completed intrinsic cutoff multipliers -/

noncomputable def intrinsicPeterssonCuspCutoffCoreMap
    (N : ℕ) (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n →ₗ[ℂ] OrbitPeterssonHilbert n :=
  (l2Coordinate n).comp (intrinsicCuspCutoffOperator N n)

theorem norm_intrinsicPeterssonCuspCutoffCoreMap_le
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    ‖intrinsicPeterssonCuspCutoffCoreMap N n u‖ ≤
      ‖l2Coordinate n u‖ := by
  calc
    ‖intrinsicPeterssonCuspCutoffCoreMap N n u‖ =
        ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n (intrinsicCuspCutoffOperator N n u))‖ := by
      rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm]
      rfl
    _ ≤ ‖Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n u)‖ := by
      apply MeasureTheory.Lp.norm_le_norm_of_ae_le
      filter_upwards [
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (intrinsicCuspCutoffOperator N n u),
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u]
          with z hzCut hzBase
      rw [hzCut, hzBase,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        intrinsicCuspCutoffOperator_apply]
      have hCut : ‖intrinsicCuspCutoff N z‖ ≤ 1 := by
        rw [intrinsicCuspCutoff, Complex.norm_real,
          Real.norm_of_nonneg (intrinsicCuspCutoffReal_nonneg N z)]
        exact intrinsicCuspCutoffReal_le_one N z
      simp only [norm_mul]
      calc
        ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ)‖ *
            (‖intrinsicCuspCutoff N z‖ *
              ‖(u : SmoothQuotientCompactFunction) z‖) =
          ‖intrinsicCuspCutoff N z‖ *
            (‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ)‖ *
              ‖(u : SmoothQuotientCompactFunction) z‖) := by ring
        _ ≤ 1 *
            (‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ)‖ *
              ‖(u : SmoothQuotientCompactFunction) z‖) :=
          mul_le_mul_of_nonneg_right hCut (mul_nonneg (norm_nonneg _) (norm_nonneg _))
        _ = ‖((z.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n : ℝ) : ℂ)‖ *
              ‖(u : SmoothQuotientCompactFunction) z‖ := one_mul _
    _ = ‖l2Coordinate n u‖ :=
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding_norm n _

noncomputable def intrinsicPeterssonCuspCutoff
    (N : ℕ) (n : ℤ) :
    OrbitPeterssonHilbert n →L[ℂ] OrbitPeterssonHilbert n :=
  (intrinsicPeterssonCuspCutoffCoreMap N n).extendOfNorm (l2Coordinate n)

@[simp]
theorem intrinsicPeterssonCuspCutoff_l2Coordinate
    (N : ℕ) (n : ℤ) (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    intrinsicPeterssonCuspCutoff N n (l2Coordinate n u) =
      l2Coordinate n (intrinsicCuspCutoffOperator N n u) := by
  exact LinearMap.extendOfNorm_eq (denseRange_l2Coordinate n)
    ⟨1, fun v ↦ by
      simpa only [one_mul] using
        norm_intrinsicPeterssonCuspCutoffCoreMap_le N n v⟩ u

theorem norm_intrinsicPeterssonCuspCutoff_apply_le
    (N : ℕ) (n : ℤ) (x : OrbitPeterssonHilbert n) :
    ‖intrinsicPeterssonCuspCutoff N n x‖ ≤ ‖x‖ := by
  simpa only [one_mul] using
    LinearMap.norm_extendOfNorm_apply_le
      (denseRange_l2Coordinate n) 1
      (fun v ↦ by simpa only [one_mul] using
        norm_intrinsicPeterssonCuspCutoffCoreMap_le N n v) x

theorem intrinsicPeterssonCuspCutoff_tendsto_id
    (n : ℤ) (x : OrbitPeterssonHilbert n) :
    Filter.Tendsto (fun N ↦ intrinsicPeterssonCuspCutoff N n x)
      Filter.atTop (nhds x) := by
  rw [Metric.tendsto_atTop]
  intro eps heps
  obtain ⟨u, hu⟩ :=
    (denseRange_l2Coordinate n).exists_dist_lt x (eps / 2)
  obtain ⟨N, hN⟩ :=
    exists_intrinsicCuspCutoffOperator_eventually_eq n u
  refine ⟨N, fun M hM ↦ ?_⟩
  have hCore : intrinsicPeterssonCuspCutoff M n (l2Coordinate n u) =
      l2Coordinate n u := by
    rw [intrinsicPeterssonCuspCutoff_l2Coordinate, hN M hM]
  have hOne : ‖x - l2Coordinate n u‖ < eps / 2 := by
    simpa only [dist_eq_norm, norm_sub_rev] using hu
  have hTwo : ‖l2Coordinate n u - x‖ < eps / 2 := by
    simpa only [dist_eq_norm] using hu
  rw [dist_eq_norm]
  have hRewrite : intrinsicPeterssonCuspCutoff M n x - x =
      intrinsicPeterssonCuspCutoff M n (x - l2Coordinate n u) +
        (l2Coordinate n u - x) := by
    rw [map_sub, hCore]
    abel
  rw [hRewrite]
  calc
    ‖intrinsicPeterssonCuspCutoff M n (x - l2Coordinate n u) +
        (l2Coordinate n u - x)‖ ≤
      ‖intrinsicPeterssonCuspCutoff M n (x - l2Coordinate n u)‖ +
        ‖l2Coordinate n u - x‖ := norm_add_le _ _
    _ ≤ ‖x - l2Coordinate n u‖ + ‖l2Coordinate n u - x‖ :=
      add_le_add_right
        (norm_intrinsicPeterssonCuspCutoff_apply_le M n _) _
    _ < eps / 2 + eps / 2 := add_lt_add hOne hTwo
    _ = eps := by ring

theorem inner_intrinsicPeterssonCuspCutoffCoreMap
    (N : ℕ) (n : ℤ) (u v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    inner ℂ (intrinsicPeterssonCuspCutoffCoreMap N n u)
        (l2Coordinate n v) =
      inner ℂ (l2Coordinate n u)
        (intrinsicPeterssonCuspCutoffCoreMap N n v) := by
  calc
    inner ℂ (intrinsicPeterssonCuspCutoffCoreMap N n u)
        (l2Coordinate n v) =
      inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n (intrinsicCuspCutoffOperator N n u)))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n v)) := by
        symm
        exact (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map _ _
    _ = inner ℂ
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n u))
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (l2Coordinate n (intrinsicCuspCutoffOperator N n v))) := by
      rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (intrinsicCuspCutoffOperator N n u),
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n v,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n u,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.coeFn_embedding_l2Coordinate_fixedPhaseGauge n
          (intrinsicCuspCutoffOperator N n v)]
          with z hCu hV hU hCv
      rw [hCu, hV, hU, hCv,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply,
        intrinsicCuspCutoffOperator_apply,
        intrinsicCuspCutoffOperator_apply]
      have hReal : star (intrinsicCuspCutoff N z) =
          intrinsicCuspCutoff N z := by
        simp only [intrinsicCuspCutoff, Complex.conj_ofReal]
      simp only [map_mul, hReal]
      ring
    _ = inner ℂ (l2Coordinate n u)
        (intrinsicPeterssonCuspCutoffCoreMap N n v) :=
      (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanIsometry n).inner_map_map _ _

theorem intrinsicPeterssonCuspCutoff_isSelfAdjoint
    (N : ℕ) (n : ℤ) :
    IsSelfAdjoint (intrinsicPeterssonCuspCutoff N n) := by
  apply LinearMap.IsSymmetric.isSelfAdjoint
  intro x y
  refine (denseRange_l2Coordinate n).induction_on x
    (isClosed_eq
      ((intrinsicPeterssonCuspCutoff N n).continuous.inner continuous_const)
      (continuous_id.inner continuous_const)) ?_
  intro u
  refine (denseRange_l2Coordinate n).induction_on y
    (isClosed_eq (continuous_const.inner continuous_id)
      (continuous_const.inner
        (intrinsicPeterssonCuspCutoff N n).continuous)) ?_
  intro v
  rw [intrinsicPeterssonCuspCutoff_l2Coordinate,
    intrinsicPeterssonCuspCutoff_l2Coordinate]
  exact inner_intrinsicPeterssonCuspCutoffCoreMap N n u v

theorem adjoint_intrinsicPeterssonCuspCutoff
    (N : ℕ) (n : ℤ) :
    ContinuousLinearMap.adjoint (intrinsicPeterssonCuspCutoff N n) =
      intrinsicPeterssonCuspCutoff N n :=
  (intrinsicPeterssonCuspCutoff_isSelfAdjoint N n).adjoint_eq

/-! #### The two uniform zeroth-order coefficients -/

noncomputable def intrinsicRaiseCommutatorCoefficient
    (N : ℕ) (z : ℍ) : ℂ :=
  heightC z * raiseRaw 0 (intrinsicCuspCutoff N) z

noncomputable def intrinsicLowerCommutatorCoefficient
    (N : ℕ) (z : ℍ) : ℂ :=
  (heightC z)⁻¹ * lowerRaw 0 (intrinsicCuspCutoff N) z

theorem intrinsicRaiseCommutatorCoefficient_realSmooth (N : ℕ) :
    RealSmooth (intrinsicRaiseCommutatorCoefficient N) :=
  realSmooth_heightC.mul
    (realSmooth_raiseRaw 0 (intrinsicCuspCutoff_realSmooth N))

theorem intrinsicLowerCommutatorCoefficient_realSmooth (N : ℕ) :
    RealSmooth (intrinsicLowerCommutatorCoefficient N) :=
  (realSmooth_heightC.inv heightC_ne_zero).mul
    (realSmooth_lowerRaw 0 (intrinsicCuspCutoff_realSmooth N))

theorem intrinsicRaiseCommutatorCoefficient_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (intrinsicRaiseCommutatorCoefficient N) := by
  simpa only [intrinsicRaiseCommutatorCoefficient, mul_comm] using
    ((intrinsicCuspCutoff_quotientCompact N).raiseRaw 0).mul_right heightC

theorem intrinsicLowerCommutatorCoefficient_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (intrinsicLowerCommutatorCoefficient N) := by
  simpa only [intrinsicLowerCommutatorCoefficient, mul_comm] using
    ((intrinsicCuspCutoff_quotientCompact N).lowerRaw 0).mul_right
      (fun z ↦ (heightC z)⁻¹)

noncomputable def intrinsicCommutatorUniformBound : ℝ :=
  4 * (intrinsicTransitionLipschitzConstant : ℝ)

theorem intrinsicCommutatorUniformBound_nonneg :
    0 ≤ intrinsicCommutatorUniformBound := by
  exact mul_nonneg (by norm_num)
    intrinsicTransitionLipschitzConstant.coe_nonneg

theorem norm_intrinsicRaiseCommutatorCoefficient_le
    (N : ℕ) (z : ℍ) :
    ‖intrinsicRaiseCommutatorCoefficient N z‖ ≤
      intrinsicCommutatorUniformBound := by
  have hFormula : intrinsicRaiseCommutatorCoefficient N z =
      heightC z *
        (Complex.I * dx (intrinsicCuspCutoff N) z +
          dy (intrinsicCuspCutoff N) z) := by
    simp only [intrinsicRaiseCommutatorCoefficient, raiseRaw,
      physicalExponent, Int.cast_zero, zero_div, Complex.ofReal_zero,
      zero_div, zero_mul, add_zero]
  rw [hFormula, norm_mul]
  have hHeight : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos z.im_pos]
  rw [hHeight]
  calc
    z.im * ‖Complex.I * dx (intrinsicCuspCutoff N) z +
        dy (intrinsicCuspCutoff N) z‖ ≤
      z.im * (‖Complex.I * dx (intrinsicCuspCutoff N) z‖ +
        ‖dy (intrinsicCuspCutoff N) z‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) z.im_pos.le
    _ = z.im * ‖dx (intrinsicCuspCutoff N) z‖ +
        z.im * ‖dy (intrinsicCuspCutoff N) z‖ := by
      simp only [norm_mul, norm_I, one_mul]
      ring
    _ ≤ 2 * (intrinsicTransitionLipschitzConstant : ℝ) +
        2 * (intrinsicTransitionLipschitzConstant : ℝ) :=
      add_le_add (intrinsicCuspCutoff_dx_hyperbolic_bound N z)
        (intrinsicCuspCutoff_dy_hyperbolic_bound N z)
    _ = intrinsicCommutatorUniformBound := by
      unfold intrinsicCommutatorUniformBound
      ring

theorem norm_intrinsicLowerCommutatorCoefficient_le
    (N : ℕ) (z : ℍ) :
    ‖intrinsicLowerCommutatorCoefficient N z‖ ≤
      intrinsicCommutatorUniformBound := by
  have hFormula : intrinsicLowerCommutatorCoefficient N z =
      heightC z *
        (-Complex.I * dx (intrinsicCuspCutoff N) z +
          dy (intrinsicCuspCutoff N) z) := by
    unfold intrinsicLowerCommutatorCoefficient lowerRaw
    field_simp [heightC_ne_zero z]
    ring
  rw [hFormula, norm_mul]
  have hHeight : ‖heightC z‖ = z.im := by
    simp only [heightC, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos z.im_pos]
  rw [hHeight]
  calc
    z.im * ‖-Complex.I * dx (intrinsicCuspCutoff N) z +
        dy (intrinsicCuspCutoff N) z‖ ≤
      z.im * (‖-Complex.I * dx (intrinsicCuspCutoff N) z‖ +
        ‖dy (intrinsicCuspCutoff N) z‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) z.im_pos.le
    _ = z.im * ‖dx (intrinsicCuspCutoff N) z‖ +
        z.im * ‖dy (intrinsicCuspCutoff N) z‖ := by
      simp only [norm_mul, norm_neg, norm_I, one_mul]
      ring
    _ ≤ 2 * (intrinsicTransitionLipschitzConstant : ℝ) +
        2 * (intrinsicTransitionLipschitzConstant : ℝ) :=
      add_le_add (intrinsicCuspCutoff_dx_hyperbolic_bound N z)
        (intrinsicCuspCutoff_dy_hyperbolic_bound N z)
    _ = intrinsicCommutatorUniformBound := by
      unfold intrinsicCommutatorUniformBound
      ring

