#print axioms PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.fixedPhasePositiveWeightGenerator_covariance
#print axioms PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.fixedPhaseNegativeWeightGenerator_covariance
#print axioms PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.fixedPhaseIntegralWeightFactor_covariance
#print axioms PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.inverseEtaPaperOrbitAllIndexSeedSection_at_point_ne_zero
#print axioms PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.compactInverseEtaFixedPhaseCoreAllIndex_ne_zero
