#print axioms IndependentWeightedWeakSobolev.hilbertSpaceWitness
#print axioms IndependentWeightedWeakSobolev.norm_sq_eq_three_coordinates
#print axioms IndependentWeightedWeakSobolev.mem_adjoint_graph_iff_swapped_pairing
#print axioms IndependentWeightedWeakSobolev.mem_weightedWeakSubmodule_iff_maximalAdjointGraphs
#print axioms IndependentWeightedWeakSobolev.mem_weightedWeakSubmodule_iff_closedComponentGraphs
#print axioms IndependentWeightedWeakSobolev.successorSmoothGraph_mem_weightedWeakSubmodule
#print axioms IndependentWeightedWeakSobolev.graphCompletionToWeightedWeak
#print axioms IndependentWeightedWeakSobolev.denseRange_smoothCoreMap_iff_surjective_comparison

end AxiomAuditP4IndependentWeightedWeakSobolev
