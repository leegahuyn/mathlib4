/-!
This fragment is intended after P3.25.  It closes the product/localization
part of the planar Friedrichs argument.  In particular, localization is not
recorded as an informal distributional rule: multiplication in planar `L2`,
the exact principal-symbol correction, and the weak Leibniz identity are all
separate proved lemmas.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhasePlanarLocalization

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs
open FixedPhaseNormalizedFriedrichs

noncomputable section

/-! ### Compact-test products -/

/-- Pointwise multiplication of two full-plane compact smooth tests. -/
noncomputable def fullPlaneTestProduct
    (phi v : FullPlaneTest) : FullPlaneTest where
  toFun := fun x : ℂ => phi x * v x
  contDiff' := phi.contDiff.mul v.contDiff
  hasCompactSupport' := v.hasCompactSupport.mul_left
  tsupport_subset' := subset_univ

@[simp]
theorem fullPlaneTestProduct_apply
    (phi v : FullPlaneTest) (x : ℂ) :
    fullPlaneTestProduct phi v x = phi x * v x :=
  rfl

/-- Multiplication by the left test cannot create support outside that test.
This is the support fact needed to pass from a chart-local weak equation to a
global weak equation after localization. -/
theorem tsupport_fullPlaneTestProduct_subset_left
    (phi v : FullPlaneTest) :
    tsupport (fullPlaneTestProduct phi v : ℂ → ℂ) ⊆
      tsupport (phi : ℂ → ℂ) := by
  change tsupport (fun x : ℂ => phi x * v x) ⊆
    tsupport (phi : ℂ → ℂ)
  exact tsupport_mul_subset_left

/-- The compact smooth principal-symbol derivative
`y (sigma d_x + d_y) phi`. -/
noncomputable def fullPlaneAffinePrincipalCutoff
    (sigma : ℂ) (phi : FullPlaneTest) : FullPlaneTest :=
  fullPlaneHeightMul
    (sigma • fullPlaneDirectionalDerivative 1 phi +
      fullPlaneDirectionalDerivative Complex.I phi)

@[simp]
theorem fullPlaneAffinePrincipalCutoff_apply
    (sigma : ℂ) (phi : FullPlaneTest) (x : ℂ) :
    fullPlaneAffinePrincipalCutoff sigma phi x =
      (x.im : ℂ) *
        (sigma * fderiv ℝ (phi : ℂ → ℂ) x 1 +
          fderiv ℝ (phi : ℂ → ℂ) x Complex.I) := by
  simp only [fullPlaneAffinePrincipalCutoff, fullPlaneHeightMul_apply,
    add_apply, smul_apply,
    fullPlaneDirectionalDerivative_apply, smul_eq_mul]

theorem tsupport_fullPlaneAffinePrincipalCutoff_subset
    (sigma : ℂ) (phi : FullPlaneTest) :
    tsupport (fullPlaneAffinePrincipalCutoff sigma phi : ℂ → ℂ) ⊆
      tsupport (phi : ℂ → ℂ) := by
  have hOne : tsupport
      (fullPlaneDirectionalDerivative 1 phi : ℂ → ℂ) ⊆
        tsupport (phi : ℂ → ℂ) :=
    tsupport_fullPlaneDirectionalDerivative_subset 1 phi
  have hI : tsupport
      (fullPlaneDirectionalDerivative Complex.I phi : ℂ → ℂ) ⊆
        tsupport (phi : ℂ → ℂ) :=
    tsupport_fullPlaneDirectionalDerivative_subset Complex.I phi
  have hSigma : tsupport
      (fun x : ℂ => sigma * fullPlaneDirectionalDerivative 1 phi x) ⊆
        tsupport (phi : ℂ → ℂ) :=
    tsupport_mul_subset_right.trans hOne
  refine tsupport_mul_subset_right.trans ?_
  simpa only [add_apply, smul_apply,
    smul_eq_mul] using
      (tsupport_add _ _).trans (union_subset hSigma hI)

/-- Pointwise transpose Leibniz identity.  The zeroth-order coefficient is
kept arbitrary; it cancels only after the exact `c - 1` transpose term is
included. -/
theorem fullPlaneAffineTranspose_product_add_principal
    (sigma c : ℂ) (phi v : FullPlaneTest) (x : ℂ) :
    fullPlaneAffineTranspose sigma c
          (fullPlaneTestProduct phi v) x +
        v x * fullPlaneAffinePrincipalCutoff sigma phi x =
      phi x * fullPlaneAffineTranspose sigma c v x := by
  have hphi : DifferentiableAt ℝ (phi : ℂ → ℂ) x :=
    phi.contDiff.differentiableAt (by simp)
  have hv : DifferentiableAt ℝ (v : ℂ → ℂ) x :=
    v.contDiff.differentiableAt (by simp)
  simp only [fullPlaneAffineTranspose_apply,
    fullPlaneTestProduct_apply,
    fullPlaneAffinePrincipalCutoff_apply]
  change
    -sigma * (x.im : ℂ) *
          fderiv ℝ (fun y : ℂ => phi y * v y) x 1 -
        (x.im : ℂ) *
          fderiv ℝ (fun y : ℂ => phi y * v y) x Complex.I +
        (c - 1) * (phi x * v x) +
        v x * ((x.im : ℂ) *
          (sigma * fderiv ℝ (phi : ℂ → ℂ) x 1 +
            fderiv ℝ (phi : ℂ → ℂ) x Complex.I)) = _
  rw [fderiv_mul hphi hv, fderiv_mul hphi hv]
  simp only [ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul]
  ring

/-! ### Bounded multiplication on planar `L2` -/

theorem fullPlaneTest_mul_l2_memLp
    (phi : FullPlaneTest) (u : AmbientPlaneL2) :
    MemLp (fun x : ℂ => phi x * u x) 2 (volume : Measure ℂ) := by
  exact (MeasureTheory.Lp.memLp u).mul'
    (phi.continuous.memLp_top_of_hasCompactSupport
      phi.hasCompactSupport volume)

/-- The `L2` class represented by multiplication with a compact smooth
coefficient. -/
noncomputable def fullPlaneTestMulL2
    (phi : FullPlaneTest) (u : AmbientPlaneL2) : AmbientPlaneL2 :=
  (fullPlaneTest_mul_l2_memLp phi u).toLp

theorem coeFn_fullPlaneTestMulL2
    (phi : FullPlaneTest) (u : AmbientPlaneL2) :
    (fullPlaneTestMulL2 phi u : ℂ → ℂ) =ᵐ[(volume : Measure ℂ)]
      fun x => phi x * u x := by
  simpa only [fullPlaneTestMulL2] using
    MemLp.coeFn_toLp (fullPlaneTest_mul_l2_memLp phi u)

/-- Distributional target after localizing a weak affine graph by `phi`. -/
noncomputable def localizedAffineTarget
    (sigma : ℂ) (phi : FullPlaneTest)
    (u Pu : AmbientPlaneL2) : AmbientPlaneL2 :=
  fullPlaneTestMulL2 phi Pu +
    fullPlaneTestMulL2 (fullPlaneAffinePrincipalCutoff sigma phi) u

theorem coeFn_localizedAffineTarget
    (sigma : ℂ) (phi : FullPlaneTest)
    (u Pu : AmbientPlaneL2) :
    (localizedAffineTarget sigma phi u Pu : ℂ → ℂ) =ᵐ[
        (volume : Measure ℂ)]
      fun x => phi x * Pu x +
        fullPlaneAffinePrincipalCutoff sigma phi x * u x := by
  filter_upwards [MeasureTheory.Lp.coeFn_add
      (fullPlaneTestMulL2 phi Pu)
      (fullPlaneTestMulL2
        (fullPlaneAffinePrincipalCutoff sigma phi) u),
    coeFn_fullPlaneTestMulL2 phi Pu,
    coeFn_fullPlaneTestMulL2
      (fullPlaneAffinePrincipalCutoff sigma phi) u]
      with x hadd hbase hcomm
  rw [hadd, hbase, hcomm]

/-! ### Weak Leibniz closure -/

/-- The affine weak graph tested only by compact smooth functions supported
in `U`.  This is the correct chart-level statement before a cutoff has removed
the chart boundary. -/
def IsPlanarAffineWeakGraphOn
    (U : Set ℂ) (sigma c : ℂ) (u Pu : AmbientPlaneL2) : Prop :=
  ∀ v : FullPlaneTest,
    tsupport (v : ℂ → ℂ) ⊆ U →
      (∫ t : ℂ, v t * Pu t) =
        ∫ t : ℂ, fullPlaneAffineTranspose sigma c v t * u t

/-- A cutoff supported in the validity region of a local weak graph produces
a genuine full-plane weak graph.  The target contains exactly the
principal-symbol correction and no hidden boundary distribution. -/
theorem IsPlanarAffineWeakGraphOn.localizeOn
    {U : Set ℂ}
    {sigma c : ℂ} {u Pu : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraphOn U sigma c u Pu)
    (phi : FullPlaneTest)
    (hphi : tsupport (phi : ℂ → ℂ) ⊆ U) :
    IsPlanarAffineWeakGraph sigma c
      (fullPlaneTestMulL2 phi u)
      (localizedAffineTarget sigma phi u Pu) := by
  intro v
  have hBaseInt := fullPlaneTest_mul_l2_integrable
    (fullPlaneTestProduct phi v) Pu
  have hCommInt := fullPlaneTest_mul_l2_integrable
    (fullPlaneTestProduct
      (fullPlaneAffinePrincipalCutoff sigma phi) v) u
  have hRightInt := fullPlaneTest_mul_l2_integrable
    (fullPlaneTestProduct phi
      (fullPlaneAffineTranspose sigma c v)) u
  have hLocalizedLeft :
      (∫ x : ℂ, v x * localizedAffineTarget sigma phi u Pu x) =
        (∫ x : ℂ, (fullPlaneTestProduct phi v) x * Pu x) +
          ∫ x : ℂ,
            v x * (fullPlaneAffinePrincipalCutoff sigma phi x * u x) := by
    rw [integral_congr_ae <|
      (coeFn_localizedAffineTarget sigma phi u Pu).mono
        (fun x hx => by rw [hx]; ring), integral_add]
    · congr 1
      · apply integral_congr_ae
        exact Filter.Eventually.of_forall fun x => by
          simp only [fullPlaneTestProduct_apply]
          ring
      · apply integral_congr_ae
        filter_upwards [coeFn_fullPlaneTestMulL2
          (fullPlaneAffinePrincipalCutoff sigma phi) u]
            with x hx
        rw [hx]
        ring
    · simpa only [fullPlaneTestProduct_apply, mul_assoc, mul_left_comm,
        mul_comm] using hBaseInt
    · simpa only [fullPlaneTestProduct_apply, mul_assoc, mul_left_comm,
        mul_comm] using hCommInt
  have hLocalizedRight :
      (∫ x : ℂ,
          fullPlaneAffineTranspose sigma c v x *
            fullPlaneTestMulL2 phi u x) =
        ∫ x : ℂ,
          (phi x * fullPlaneAffineTranspose sigma c v x) * u x := by
    apply integral_congr_ae
    filter_upwards [coeFn_fullPlaneTestMulL2 phi u] with x hx
    rw [hx]
    ring
  have hProductSupport :
      tsupport (fullPlaneTestProduct phi v : ℂ → ℂ) ⊆ U :=
    (tsupport_fullPlaneTestProduct_subset_left phi v).trans hphi
  rw [hLocalizedLeft,
    hWeak (fullPlaneTestProduct phi v) hProductSupport, hLocalizedRight]
  rw [← integral_add]
  · apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x => by
      rw [← fullPlaneAffineTranspose_product_add_principal
        sigma c phi v x]
      ring
  · exact fullPlaneTest_mul_l2_integrable
      (fullPlaneAffineTranspose sigma c (fullPlaneTestProduct phi v)) u
  · simpa only [fullPlaneTestProduct_apply, mul_assoc, mul_left_comm,
      mul_comm] using hCommInt

/-- Global weak graphs are the special case of the chart-local localization
lemma with validity region `univ`. -/
theorem IsPlanarAffineWeakGraph.localize
    {sigma c : ℂ} {u Pu : AmbientPlaneL2}
    (hWeak : IsPlanarAffineWeakGraph sigma c u Pu)
    (phi : FullPlaneTest) :
    IsPlanarAffineWeakGraph sigma c
      (fullPlaneTestMulL2 phi u)
      (localizedAffineTarget sigma phi u Pu) := by
  have hWeakOn :
      IsPlanarAffineWeakGraphOn Set.univ sigma c u Pu :=
    fun v _ => hWeak v
  exact hWeakOn.localizeOn phi subset_univ

end
end FixedPhasePlanarLocalization

