/-!
## P4.1: an independent weighted weak Sobolev space

The graph completion constructed above is the completion of the *minimal*
smooth joint graph.  It must not be used as the definition of the weak
Sobolev space if one later wants a genuine minimal-versus-maximal-domain
theorem.  This section therefore constructs the weighted weak space
independently, inside the actual three Petersson Hilbert coordinates.

At source index `n + 1`, a triple `(u, r, l)` is weakly differentiable when

* `r` satisfies the distributional raising identity against every smooth
  test at index `(n + 1) + 1`; and
* `l` satisfies the distributional lowering identity against every smooth
  test at index `n`.

The Euclidean gauge factors, half-integral multiplier, and quotient measure
are already incorporated in the three Petersson Hilbert spaces.  Thus the
two displayed identities are intrinsic quotient identities, not unweighted
ambient-plane substitutes.  Each defect is a continuous linear functional,
so their common kernel is a closed Hilbert subspace.  The smooth joint graph
maps canonically and isometrically into it.  Surjectivity of the resulting
completion map is isolated below as the exact joint Friedrichs/core-density
statement; it is not inserted as a structure field or an assumption in the
definition.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace IndependentWeightedWeakSobolev

open Function Set Topology
open scoped LinearPMap
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion
open FixedPhaseClosedOperators

/-! ### The three actual weighted `L²` coordinates -/

/-- Ambient Hilbert product for a weak section at source index `n + 1`.
The first coordinate is the section, the second is its weak raising
coordinate, and the third is its weak lowering coordinate. -/
abbrev WeakCoordinateAmbient (n : ℤ) :=
  DefinitionOneSobolev.EnergyTarget
    (OrbitPeterssonHilbert (n + 1))
    (OrbitPeterssonHilbert ((n + 1) + 1))
    (OrbitPeterssonHilbert n)

/-- Continuous base-coordinate projection. -/
noncomputable def baseProjection (n : ℤ) :
    WeakCoordinateAmbient n →L[ℂ] OrbitPeterssonHilbert (n + 1) :=
  WithLp.fstL 2 ℂ
    (OrbitPeterssonHilbert (n + 1))
    (WithLp 2
      (OrbitPeterssonHilbert ((n + 1) + 1) ×
        OrbitPeterssonHilbert n))

/-- Continuous weak-raising-coordinate projection. -/
noncomputable def raiseProjection (n : ℤ) :
    WeakCoordinateAmbient n →L[ℂ]
      OrbitPeterssonHilbert ((n + 1) + 1) :=
  (WithLp.fstL 2 ℂ
      (OrbitPeterssonHilbert ((n + 1) + 1))
      (OrbitPeterssonHilbert n)).comp
    (WithLp.sndL 2 ℂ
      (OrbitPeterssonHilbert (n + 1))
      (WithLp 2
        (OrbitPeterssonHilbert ((n + 1) + 1) ×
          OrbitPeterssonHilbert n)))

/-- Continuous weak-lowering-coordinate projection. -/
noncomputable def lowerProjection (n : ℤ) :
    WeakCoordinateAmbient n →L[ℂ] OrbitPeterssonHilbert n :=
  (WithLp.sndL 2 ℂ
      (OrbitPeterssonHilbert ((n + 1) + 1))
      (OrbitPeterssonHilbert n)).comp
    (WithLp.sndL 2 ℂ
      (OrbitPeterssonHilbert (n + 1))
      (WithLp 2
        (OrbitPeterssonHilbert ((n + 1) + 1) ×
          OrbitPeterssonHilbert n)))

@[simp]
theorem baseProjection_apply (n : ℤ) (x : WeakCoordinateAmbient n) :
    baseProjection n x = x.fst :=
  rfl

@[simp]
theorem raiseProjection_apply (n : ℤ) (x : WeakCoordinateAmbient n) :
    raiseProjection n x = x.snd.fst :=
  rfl

@[simp]
theorem lowerProjection_apply (n : ℤ) (x : WeakCoordinateAmbient n) :
    lowerProjection n x = x.snd.snd :=
  rfl

/-! ### Closed distributional defects -/

/-- Raising defect against one genuine smooth quotient test.  The inner
products are written with the fixed test in the first slot, making this a
complex-linear continuous functional of `(u,r,l)`.  Its vanishing is the
conjugate of
`⟪r,v⟫ = -⟪u,L v⟫`. -/
noncomputable def raisingDefect (n : ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1)) :
    WeakCoordinateAmbient n →L[ℂ] ℂ :=
  ((innerSL ℂ (l2Coordinate ((n + 1) + 1) v)).comp
      (raiseProjection n)) +
    ((innerSL ℂ (lowerFromSuccCoordinate (n + 1) v)).comp
      (baseProjection n))

/-- Lowering defect against one genuine smooth quotient test.  Its
vanishing is the conjugate of
`⟪l,v⟫ = -⟪u,R v⟫`. -/
noncomputable def loweringDefect (n : ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) :
    WeakCoordinateAmbient n →L[ℂ] ℂ :=
  ((innerSL ℂ (l2Coordinate n v)).comp (lowerProjection n)) +
    ((innerSL ℂ (raisedCoordinate n v)).comp (baseProjection n))

@[simp]
theorem raisingDefect_apply (n : ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1))
    (x : WeakCoordinateAmbient n) :
    raisingDefect n v x =
      inner ℂ (l2Coordinate ((n + 1) + 1) v)
          (raiseProjection n x) +
        inner ℂ (lowerFromSuccCoordinate (n + 1) v)
          (baseProjection n x) := by
  simp only [raisingDefect, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.comp_apply, innerSL_apply_apply]

@[simp]
theorem loweringDefect_apply (n : ℤ)
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n) (x : WeakCoordinateAmbient n) :
    loweringDefect n v x =
      inner ℂ (l2Coordinate n v) (lowerProjection n x) +
        inner ℂ (raisedCoordinate n v) (baseProjection n x) := by
  simp only [loweringDefect, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.comp_apply, innerSL_apply_apply]

/-- Common kernel of all distributional raising tests. -/
noncomputable def weakRaisingSubmodule (n : ℤ) :
    Submodule ℂ (WeakCoordinateAmbient n) :=
  ⨅ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1),
    (raisingDefect n v).ker

/-- Common kernel of all distributional lowering tests. -/
noncomputable def weakLoweringSubmodule (n : ℤ) :
    Submodule ℂ (WeakCoordinateAmbient n) :=
  ⨅ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n, (loweringDefect n v).ker

/-- The independent weighted weak Sobolev submodule.  It is defined by weak
identities, not as a completion, graph range, or image. -/
noncomputable def weightedWeakSubmodule (n : ℤ) :
    Submodule ℂ (WeakCoordinateAmbient n) :=
  weakRaisingSubmodule n ⊓ weakLoweringSubmodule n

theorem mem_weakRaisingSubmodule_iff (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weakRaisingSubmodule n ↔
      ∀ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1),
        raisingDefect n v x = 0 := by
  simp only [weakRaisingSubmodule, Submodule.mem_iInf,
    LinearMap.mem_ker, ContinuousLinearMap.coe_coe]

theorem mem_weakLoweringSubmodule_iff (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weakLoweringSubmodule n ↔
      ∀ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n, loweringDefect n v x = 0 := by
  simp only [weakLoweringSubmodule, Submodule.mem_iInf,
    LinearMap.mem_ker, ContinuousLinearMap.coe_coe]

theorem mem_weightedWeakSubmodule_iff (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weightedWeakSubmodule n ↔
      (∀ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1),
        raisingDefect n v x = 0) ∧
      (∀ v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n,
        loweringDefect n v x = 0) := by
  rw [weightedWeakSubmodule, Submodule.mem_inf,
    mem_weakRaisingSubmodule_iff,
    mem_weakLoweringSubmodule_iff]

/-! ### Exact maximal-adjoint interpretation

The next lemma is the graph form of the defining Hilbert-adjoint pairing,
written in the orientation linear in the graph coordinates.  It is useful
here because the weak defects above use `inner test coordinate` rather than
the conjugate-linear orientation.
-/

theorem mem_adjoint_graph_iff_swapped_pairing
    {E F : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]
    (T : E →ₗ.[ℂ] F) (hDense : Dense (T.domain : Set E))
    (y : F) (z : E) :
    (y, z) ∈ T†.graph ↔
      ∀ x : T.domain, inner ℂ (x : E) z = inner ℂ (T x) y := by
  constructor
  · intro hGraph x
    rcases (LinearPMap.mem_graph_iff (T†)).mp hGraph with
      ⟨y', hy', hz'⟩
    rw [← hy', ← hz']
    exact ((LinearPMap.adjoint_isFormalAdjoint hDense).symm x y').symm
  · intro hPair
    have hOriginal : ∀ x : T.domain,
        inner ℂ z (x : E) = inner ℂ y (T x) := by
      intro x
      calc
        inner ℂ z (x : E) =
            star (inner ℂ (x : E) z) :=
          (inner_conj_symm z (x : E)).symm
        _ = star (inner ℂ (T x) y) :=
          congrArg star (hPair x)
        _ = inner ℂ y (T x) := inner_conj_symm y (T x)
    have hyDomain : y ∈ T†.domain :=
      LinearPMap.mem_adjoint_domain_of_exists y ⟨z, hOriginal⟩
    let yDomain : T†.domain := ⟨y, hyDomain⟩
    have hValue : T† yDomain = z :=
      LinearPMap.adjoint_apply_eq hDense yDomain hOriginal
    exact (LinearPMap.mem_graph_iff (T†)).2
      ⟨yDomain, rfl, hValue⟩

/-- The raising weak identities are exactly membership in the maximal
adjoint graph of signed physical lowering.  No essential-core or density
beyond the already-proved density of the physical operator domain occurs. -/
theorem mem_weakRaisingSubmodule_iff_maximalAdjointGraph (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weakRaisingSubmodule n ↔
      (baseProjection n x, raiseProjection n x) ∈
        ((-physicalLowerFromSucc (n + 1))†).graph := by
  rw [mem_weakRaisingSubmodule_iff,
    mem_adjoint_graph_iff_swapped_pairing
      (-physicalLowerFromSucc (n + 1))
      (negativePhysicalLowerFromSucc_dense_domain (n + 1))]
  constructor
  · intro hWeak y
    let v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore ((n + 1) + 1) :=
      (l2CoreRangeEquiv ((n + 1) + 1)).symm y
    have hv := hWeak v
    rw [raisingDefect_apply] at hv
    rw [LinearPMap.neg_apply, physicalLowerFromSucc_apply,
      inner_neg_left,
      ← l2Coordinate_l2CoreRangeEquiv_symm ((n + 1) + 1) y]
    change
      inner ℂ (l2Coordinate ((n + 1) + 1) v)
          (raiseProjection n x) =
        -inner ℂ (lowerFromSuccCoordinate (n + 1) v)
          (baseProjection n x)
    linear_combination hv
  · intro hGraph v
    rw [raisingDefect_apply]
    have hv := hGraph (l2CoreRangeEquiv ((n + 1) + 1) v)
    simp only [l2CoreRangeEquiv_coe, LinearPMap.neg_apply,
      physicalLowerFromSucc_on_core, inner_neg_left] at hv
    linear_combination hv

/-- The lowering weak identities are exactly membership in the maximal
adjoint graph of signed physical raising. -/
theorem mem_weakLoweringSubmodule_iff_maximalAdjointGraph (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weakLoweringSubmodule n ↔
      (baseProjection n x, lowerProjection n x) ∈
        ((-physicalRaise n)†).graph := by
  rw [mem_weakLoweringSubmodule_iff,
    mem_adjoint_graph_iff_swapped_pairing
      (-physicalRaise n) (negativePhysicalRaise_dense_domain n)]
  constructor
  · intro hWeak y
    let v : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore n :=
      (l2CoreRangeEquiv n).symm y
    have hv := hWeak v
    rw [loweringDefect_apply] at hv
    rw [LinearPMap.neg_apply, physicalRaise_apply, inner_neg_left,
      ← l2Coordinate_l2CoreRangeEquiv_symm n y]
    change
      inner ℂ (l2Coordinate n v) (lowerProjection n x) =
        -inner ℂ (raisedCoordinate n v) (baseProjection n x)
    linear_combination hv
  · intro hGraph v
    rw [loweringDefect_apply]
    have hv := hGraph (l2CoreRangeEquiv n v)
    simp only [l2CoreRangeEquiv_coe, LinearPMap.neg_apply,
      physicalRaise_on_core, inner_neg_left] at hv
    linear_combination hv

/-- The independent weak space is literally the simultaneous graph of the
two opposite maximal adjoints. -/
theorem mem_weightedWeakSubmodule_iff_maximalAdjointGraphs (n : ℤ)
    (x : WeakCoordinateAmbient n) :
    x ∈ weightedWeakSubmodule n ↔
      (baseProjection n x, raiseProjection n x) ∈
          ((-physicalLowerFromSucc (n + 1))†).graph ∧
        (baseProjection n x, lowerProjection n x) ∈
          ((-physicalRaise n)†).graph := by
  rw [weightedWeakSubmodule, Submodule.mem_inf,
    mem_weakRaisingSubmodule_iff_maximalAdjointGraph,
    mem_weakLoweringSubmodule_iff_maximalAdjointGraph]

/-- Under the two adjacent strong cross-adjoint theorems, a weak triple is
exactly a common-domain triple for the two *individual* closed physical
components.  This statement deliberately does not replace simultaneous
joint graph-core density by separate component core density. -/
theorem mem_weightedWeakSubmodule_iff_closedComponentGraphs
    {n : ℤ} (hLower : StrongCrossAdjointAt n)
    (hRaise : StrongCrossAdjointAt (n + 1))
    (x : WeakCoordinateAmbient n) :
    x ∈ weightedWeakSubmodule n ↔
      (baseProjection n x, raiseProjection n x) ∈
          (closedRaise (n + 1)).graph ∧
        (baseProjection n x, lowerProjection n x) ∈
          (closedLowerFromSucc n).graph := by
  rw [mem_weightedWeakSubmodule_iff_maximalAdjointGraphs,
    ← hRaise.1, ← hLower.2]

/-- Arbitrary intersections of the closed raising kernels remain closed. -/
theorem weakRaisingSubmodule_isClosed (n : ℤ) :
    IsClosed (weakRaisingSubmodule n : Set (WeakCoordinateAmbient n)) := by
  unfold weakRaisingSubmodule
  exact isClosed_iInter fun v ↦
    ContinuousLinearMap.isClosed_ker (raisingDefect n v)

/-- Arbitrary intersections of the closed lowering kernels remain closed. -/
theorem weakLoweringSubmodule_isClosed (n : ℤ) :
    IsClosed (weakLoweringSubmodule n : Set (WeakCoordinateAmbient n)) := by
  unfold weakLoweringSubmodule
  exact isClosed_iInter fun v ↦
    ContinuousLinearMap.isClosed_ker (loweringDefect n v)

/-- The independent weighted weak Sobolev submodule is closed in the full
three-coordinate Petersson Hilbert product. -/
theorem weightedWeakSubmodule_isClosed (n : ℤ) :
    IsClosed (weightedWeakSubmodule n : Set (WeakCoordinateAmbient n)) := by
  rw [show (weightedWeakSubmodule n : Set (WeakCoordinateAmbient n)) =
      (weakRaisingSubmodule n : Set (WeakCoordinateAmbient n)) ∩
        (weakLoweringSubmodule n : Set (WeakCoordinateAmbient n)) by
    ext x
    simp only [weightedWeakSubmodule, Submodule.mem_inf, Set.mem_inter_iff]]
  exact (weakRaisingSubmodule_isClosed n).inter
    (weakLoweringSubmodule_isClosed n)

/-- The actual independent weighted weak Sobolev space. -/
noncomputable abbrev WeightedWeakSobolev (n : ℤ) := weightedWeakSubmodule n

local instance weightedWeakSubmodule_closedInstance (n : ℤ) :
    IsClosed (weightedWeakSubmodule n : Set (WeakCoordinateAmbient n)) :=
  weightedWeakSubmodule_isClosed n

/-- Closedness supplies completeness, while the inherited inner product is
the exact sum of the three Petersson coordinates. -/
noncomputable instance weightedWeakSobolevCompleteSpace (n : ℤ) :
    CompleteSpace (WeightedWeakSobolev n) :=
  by infer_instance

/-- Explicit Hilbert-space witness for the independently defined weak
space. -/
noncomputable def hilbertSpaceWitness (n : ℤ) :
    HilbertSpace ℂ (WeightedWeakSobolev n) :=
  by infer_instance

/-! ### Intrinsic coordinates and norm definiteness -/

/-- Base Petersson coordinate on the independent weak space. -/
noncomputable def baseCoordinate (n : ℤ) :
    WeightedWeakSobolev n →L[ℂ] OrbitPeterssonHilbert (n + 1) :=
  (baseProjection n).comp (weightedWeakSubmodule n).subtypeL

/-- Weak raising coordinate on the independent weak space. -/
noncomputable def raiseCoordinate (n : ℤ) :
    WeightedWeakSobolev n →L[ℂ]
      OrbitPeterssonHilbert ((n + 1) + 1) :=
  (raiseProjection n).comp (weightedWeakSubmodule n).subtypeL

/-- Weak lowering coordinate on the independent weak space. -/
noncomputable def lowerCoordinate (n : ℤ) :
    WeightedWeakSobolev n →L[ℂ] OrbitPeterssonHilbert n :=
  (lowerProjection n).comp (weightedWeakSubmodule n).subtypeL

@[simp]
theorem baseCoordinate_apply (n : ℤ) (x : WeightedWeakSobolev n) :
    baseCoordinate n x = (x : WeakCoordinateAmbient n).fst :=
  rfl

@[simp]
theorem raiseCoordinate_apply (n : ℤ) (x : WeightedWeakSobolev n) :
    raiseCoordinate n x = (x : WeakCoordinateAmbient n).snd.fst :=
  rfl

@[simp]
theorem lowerCoordinate_apply (n : ℤ) (x : WeightedWeakSobolev n) :
    lowerCoordinate n x = (x : WeakCoordinateAmbient n).snd.snd :=
  rfl

/-- Exact independent weak norm: no derivative coordinate or coefficient is
suppressed. -/
theorem norm_sq_eq_three_coordinates (n : ℤ)
    (x : WeightedWeakSobolev n) :
    ‖x‖ ^ 2 = ‖baseCoordinate n x‖ ^ 2 +
      ‖raiseCoordinate n x‖ ^ 2 + ‖lowerCoordinate n x‖ ^ 2 := by
  change ‖(x : WeakCoordinateAmbient n)‖ ^ 2 =
    ‖(x : WeakCoordinateAmbient n).fst‖ ^ 2 +
      ‖(x : WeakCoordinateAmbient n).snd.fst‖ ^ 2 +
        ‖(x : WeakCoordinateAmbient n).snd.snd‖ ^ 2
  rw [WithLp.prod_norm_sq_eq_of_L2 (x : WeakCoordinateAmbient n),
    WithLp.prod_norm_sq_eq_of_L2 (x : WeakCoordinateAmbient n).snd]
  ring

/-- Vanishing of all three concrete coordinates forces the weak vector to
vanish.  This records positive-definiteness independently of completion
injectivity. -/
theorem eq_zero_of_coordinates_eq_zero (n : ℤ)
    (x : WeightedWeakSobolev n)
    (hBase : baseCoordinate n x = 0)
    (hRaise : raiseCoordinate n x = 0)
    (hLower : lowerCoordinate n x = 0) :
    x = 0 := by
  apply Subtype.ext
  apply WithLp.ofLp_injective 2
  apply Prod.ext
  · exact hBase
  · apply WithLp.ofLp_injective 2
    exact Prod.ext hRaise hLower

theorem norm_eq_zero_iff_coordinates (n : ℤ)
    (x : WeightedWeakSobolev n) :
    ‖x‖ = 0 ↔ baseCoordinate n x = 0 ∧
      raiseCoordinate n x = 0 ∧ lowerCoordinate n x = 0 := by
  constructor
  · intro hx
    have hx0 : x = 0 := norm_eq_zero.mp hx
    simp only [hx0, map_zero]
  · rintro ⟨hBase, hRaise, hLower⟩
    exact norm_eq_zero.mpr
      (eq_zero_of_coordinates_eq_zero n x hBase hRaise hLower)

/-! ### The smooth core and the minimal-to-maximal comparison -/

/-- The raw smooth successor graph satisfies both weak identities.  This is
where the unconditional quotient Green theorem is used; closedness and
completeness above did not use it. -/
theorem successorSmoothGraph_mem_weightedWeakSubmodule (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graph u ∈
      weightedWeakSubmodule n := by
  rw [mem_weightedWeakSubmodule_iff]
  constructor
  · intro v
    rw [raisingDefect_apply]
    simp only [baseProjection_apply, raiseProjection_apply,
      DefinitionOneSobolev.QuotientHilbertCoordinates.graph_fst,
      DefinitionOneSobolev.QuotientHilbertCoordinates.graph_snd_fst,
      FixedPhaseClosedOperators.successorGraphCoordinates]
    have h :=
      FixedPhaseClosedOperators.physicalLoweringGreenIdentityOnCore_unconditional
          (n := n + 1) v u
    linear_combination h
  · intro v
    rw [loweringDefect_apply]
    simp only [baseProjection_apply, lowerProjection_apply,
      DefinitionOneSobolev.QuotientHilbertCoordinates.graph_fst,
      DefinitionOneSobolev.QuotientHilbertCoordinates.graph_snd_snd,
      FixedPhaseClosedOperators.successorGraphCoordinates,
      FixedPhaseClosedOperators.reindexedActualLoweredCoordinate_eq_lowerFromSuccCoordinate]
    have h :=
      FixedPhaseClosedOperators.physicalRaisingGreenIdentityOnCore_unconditional
          (n := n) v u
    linear_combination h

/-- Canonical linear map from the actual smooth fixed-phase core into the
independent weak Sobolev space. -/
noncomputable def smoothCoreMap (n : ℤ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) →ₗ[ℂ]
      WeightedWeakSobolev n :=
  (FixedPhaseClosedOperators.successorGraphCoordinates n).graph.codRestrict
    (weightedWeakSubmodule n)
    (successorSmoothGraph_mem_weightedWeakSubmodule n)

/-- The one genuinely simultaneous P4 density obligation.  It asks for
density in the norm containing *both* outgoing derivatives at once; it is
strictly stronger than merely knowing separate essential-core statements
for raising and lowering.  This is a named proposition, not a field of the
weak-space construction. -/
def JointGraphCoreDensityAt (n : ℤ) : Prop :=
  DenseRange (smoothCoreMap n)

@[simp]
theorem coe_smoothCoreMap (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    (smoothCoreMap n u : WeakCoordinateAmbient n) =
      (FixedPhaseClosedOperators.successorGraphCoordinates n).graph u :=
  rfl

/-- Exact graph norm on the canonical smooth weak vector. -/
theorem norm_smoothCoreMap_sq (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    ‖smoothCoreMap n u‖ ^ 2 =
      ‖l2Coordinate (n + 1) u‖ ^ 2 +
        ‖raisedCoordinate (n + 1) u‖ ^ 2 +
          ‖lowerFromSuccCoordinate n u‖ ^ 2 := by
  change
    ‖(FixedPhaseClosedOperators.successorGraphCoordinates n).graph u‖ ^ 2 = _
  simpa only [FixedPhaseClosedOperators.successorGraphCoordinates,
    FixedPhaseClosedOperators.reindexedActualLoweredCoordinate_eq_lowerFromSuccCoordinate] using
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graph_norm_sq u

/-- The successor presentation of the already constructed minimal graph
completion.  It is kept distinct from `WeightedWeakSobolev`. -/
abbrev SuccessorGraphCompletion (n : ℤ) :=
  (FixedPhaseClosedOperators.successorGraphCoordinates n).SobolevCompletion

/-- Every vector in the completed minimal graph still satisfies the two weak
identities, because the latter cut out a closed subspace. -/
theorem graphExtension_mem_weightedWeakSubmodule (n : ℤ)
    (x : SuccessorGraphCompletion n) :
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graphExtension x ∈
      weightedWeakSubmodule n := by
  let Q := FixedPhaseClosedOperators.successorGraphCoordinates n
  refine UniformSpace.Completion.denseRange_coe.induction_on x
    ((weightedWeakSubmodule_isClosed n).preimage
      Q.graphExtension.continuous) ?_
  intro y
  rw [Q.graphExtension_coe]
  rcases y.property with ⟨u, rfl⟩
  exact successorSmoothGraph_mem_weightedWeakSubmodule n u

/-- Canonical isometric inclusion of the minimal graph completion into the
independently defined maximal weak space. -/
noncomputable def graphCompletionToWeightedWeak (n : ℤ) :
    SuccessorGraphCompletion n →ₗᵢ[ℂ] WeightedWeakSobolev n where
  toLinearMap :=
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graphExtension.toLinearMap.codRestrict
        (weightedWeakSubmodule n)
        (graphExtension_mem_weightedWeakSubmodule n)
  norm_map' x :=
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graphExtension_norm x

/-- The comparison agrees exactly with the two canonical smooth-core maps. -/
@[simp]
theorem graphCompletionToWeightedWeak_sectionCoreMap (n : ℤ)
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1)) :
    graphCompletionToWeightedWeak n
        ((FixedPhaseClosedOperators.successorGraphCoordinates n).sectionCoreMap u) =
      smoothCoreMap n u := by
  apply Subtype.ext
  change
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graphExtension
        ((FixedPhaseClosedOperators.successorGraphCoordinates n).sectionCoreMap u) =
      (FixedPhaseClosedOperators.successorGraphCoordinates n).graph u
  rw [show
      (FixedPhaseClosedOperators.successorGraphCoordinates n).sectionCoreMap u =
        ((FixedPhaseClosedOperators.successorGraphCoordinates n).toGraphRange u : SuccessorGraphCompletion n) from rfl,
    (FixedPhaseClosedOperators.successorGraphCoordinates n).graphExtension_coe]
  rfl

/-- The comparison range is closed.  Therefore no weak vector can be
obtained merely as a limit of minimal graph vectors without already lying in
the comparison range. -/
theorem graphCompletionToWeightedWeak_range_isClosed (n : ℤ) :
    IsClosed (Set.range (graphCompletionToWeightedWeak n)) :=
  (graphCompletionToWeightedWeak n).isometry.isClosedEmbedding.isClosed_range

/-- Exact remaining P4 gate: density of the actual smooth core in the
independent weak norm is equivalent to surjectivity of the canonical
minimal-to-maximal isometry.  Neither side is assumed in any definition. -/
theorem denseRange_smoothCoreMap_iff_surjective_comparison (n : ℤ) :
    DenseRange (smoothCoreMap n) ↔
      Function.Surjective (graphCompletionToWeightedWeak n) := by
  constructor
  · intro hCore
    apply (DefinitionOneSobolev.denseRange_iff_surjective_linearIsometry_of_complete
        (graphCompletionToWeightedWeak n)).mp
    apply Dense.mono _ hCore
    rintro _ ⟨u, rfl⟩
    exact ⟨
      (FixedPhaseClosedOperators.successorGraphCoordinates n).sectionCoreMap u,
      (graphCompletionToWeightedWeak_sectionCoreMap n u).symm⟩
  · intro hSurj
    have hOuter : DenseRange (graphCompletionToWeightedWeak n) :=
      hSurj.denseRange
    have hComp := hOuter.comp
      (FixedPhaseClosedOperators.successorGraphCoordinates n).denseRange_sectionCoreMap
      (graphCompletionToWeightedWeak n).continuous
    simpa only [Function.comp_apply,
      graphCompletionToWeightedWeak_sectionCoreMap] using hComp

/-- Named form of the exact simultaneous Friedrichs gate. -/
theorem jointGraphCoreDensityAt_iff_surjective_comparison (n : ℤ) :
    JointGraphCoreDensityAt n ↔
      Function.Surjective (graphCompletionToWeightedWeak n) :=
  denseRange_smoothCoreMap_iff_surjective_comparison n

/-- Once the preceding density theorem is proved analytically, the two
spaces are canonically linearly isometric.  This constructor consumes the
theorem explicitly and does not store it in the weak-space definition. -/
noncomputable def graphCompletionEquivWeightedWeak (n : ℤ)
    (hDense : JointGraphCoreDensityAt n) :
    SuccessorGraphCompletion n ≃ₗᵢ[ℂ] WeightedWeakSobolev n :=
  LinearIsometryEquiv.ofSurjective
    (graphCompletionToWeightedWeak n)
    ((jointGraphCoreDensityAt_iff_surjective_comparison n).mp hDense)

end IndependentWeightedWeakSobolev

namespace AxiomAuditP4IndependentWeightedWeakSobolev

