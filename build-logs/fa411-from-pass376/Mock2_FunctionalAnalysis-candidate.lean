    (intrinsicRaiseCuspCutoffCommutator N n)
    (intrinsicRaisePeterssonCommutator N n)
    (intrinsicRaiseCommutatorCoefficient N)
    (intrinsicRaiseCommutatorCoefficient_quotientCompact N)
    (intrinsicRaisePeterssonCommutator_l2Coordinate N n)
    (fixedPhaseEuclideanGauge_intrinsicRaiseCommutator N n) x

theorem intrinsicLowerFromSuccPeterssonCommutator_hasCompactCarrierSupport
    (N : ℕ) (n : ℤ) (x : OrbitPeterssonHilbert (n + 1)) :
    HasCompactCarrierSupport n
      (intrinsicLowerFromSuccPeterssonCommutator N n x) := by
