/-!
This fragment is intended after the reduced-chart periodization, reduced-chart
`L²` descent, planar localization, essential-support buffer, weak-chart, and
Bochner/pointwise fragments.

It closes the *local* Friedrichs step without choosing a pointwise
representative of an `L²` class.  A compactly supported chart localization is
mollified by the normalized kernel, the exact weak affine identity identifies
the differentiated test, and the resulting tests are periodized inside one
reduced quotient chart.  The final inner-product lemmas show that reduced-chart
models are isometric: this is the quantitative fact needed for the finite
quotient-chart gluing argument.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped BigOperators Convolution ContDiff Distributions LinearPMap ENNReal
open HalfIntegralMultiplier
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open DefinitionOneSobolev.WeightCorePetersson
open DefinitionOneSobolev.WeightCorePetersson.PeterssonCoreSpace
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseEssentialCoreRoute
open FixedPhaseClosedOperators
open FixedPhaseAffineFriedrichs
open FixedPhaseNormalizedFriedrichs
open FixedPhasePlanarLocalization

noncomputable section

/-! ### Re-bundling upper-plane tests as full-plane tests -/

/-- Forget only the support-open parameter of an upper-half-plane test.  The
function, smoothness, and compact support are unchanged. -/
noncomputable def ambientTestCoreToFullPlaneTest
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) : FullPlaneTest where
  toFun := v
  contDiff' := v.contDiff
  hasCompactSupport' := v.hasCompactSupport
  tsupport_subset' := subset_univ

@[simp]
theorem ambientTestCoreToFullPlaneTest_apply
    (v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore) (w : ℂ) :
    ambientTestCoreToFullPlaneTest v w = v w :=
  rfl

/-- The pointwise kernel action can be written with the source variable as
the integration variable.  This is the orientation appearing in the exact
distributional Friedrichs identity. -/
theorem pointwiseKernelConvolution_eq_reflectedPair
    (K : ℂ → ℂ) (u : AmbientPlaneL2) (w : ℂ) :
    pointwiseKernelConvolution K u w =
      ∫ x : ℂ, K (w - x) * u x := by
  change (K ⋆[mul ℂ ℂ, volume] (u : ℂ → ℂ)) w = _
  exact convolution_mul_swap

/-! ### Exact Hilbert representatives of the buffered tests -/

/-- The buffered smooth test represents exactly the Hilbert-valued
normalized mollifier action. -/
theorem fullPlaneTestToL2_bufferedEssentialFriedrichs
    {K : Set ℂ} (hK : IsCompact K) (j : ℕ)
    (u : AmbientPlaneL2) (hu : HasEssentialSupportIn u K) :
    fullPlaneTestToL2
        (bufferedEssentialFriedrichsFullPlaneTest hK j u hu) =
      friedrichsMollifierAction j u := by
  apply MeasureTheory.Lp.ext
  filter_upwards [
    coeFn_fullPlaneTestToL2
      (bufferedEssentialFriedrichsFullPlaneTest hK j u hu),
    friedrichsMollifierAction_ae_eq_mollifiedRepresentative j u]
      with w htest haction
  rw [htest, haction,
    bufferedEssentialFriedrichsFullPlaneTest_apply]

/-- Exact raising-coordinate representative of the buffered test.  Both
terms on the right are the actual Bochner `L²` actions; no point-evaluation
map on `L²` is used. -/
theorem fullPlaneTestToL2_raiseForward_bufferedEssentialFriedrichs
    {n : ℤ} {z₀ : ℍ} {K : Set ℂ}
    (hK : IsCompact K) (j : ℕ)
    (u Ru : AmbientPlaneL2) (hu : HasEssentialSupportIn u K)
    (hb : tsupport
        (bufferedEssentialFriedrichsFullPlaneTest hK j u hu : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hWeak : IsPlanarAffineWeakGraph Complex.I
      (((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ))
      u Ru) :
    fullPlaneTestToL2
        (ambientTestCoreToFullPlaneTest
          (euclideanRaiseForwardTest n
            (reducedChartAmbientTest
              (bufferedEssentialFriedrichsFullPlaneTest hK j u hu)
              hb))) =
      friedrichsAffineForwardCoordinate Complex.I j u Ru := by
  let b : FullPlaneTest :=
    bufferedEssentialFriedrichsFullPlaneTest hK j u hu
  let a : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
    reducedChartAmbientTest b hb
  apply MeasureTheory.Lp.ext
  filter_upwards [
    coeFn_fullPlaneTestToL2
      (ambientTestCoreToFullPlaneTest
        (euclideanRaiseForwardTest n a)),
    MeasureTheory.Lp.coeFn_add
      (friedrichsMollifierAction j Ru)
      (friedrichsAffineCommutatorAction Complex.I j u),
    friedrichsMollifierAction_ae_eq_mollifiedRepresentative j Ru,
    friedrichsAffineCommutatorAction_ae_eq_pointwise Complex.I j u]
      with w htest hadd hmoll hcomm
  rw [htest]
  change euclideanRaiseForwardTest n a w = _
  rw [euclideanRaiseForwardTest_eq_ambientAffineMaass,
    show a w = friedrichsMollifiedRepresentative j u w by
      simpa only [a, b, reducedChartAmbientTest_apply] using
        bufferedEssentialFriedrichsFullPlaneTest_apply hK j u hu w,
    hWeak.friedrichs_raising_identity]
  change _ =
    (friedrichsMollifierAction j Ru +
      friedrichsAffineCommutatorAction Complex.I j u) w
  rw [hadd, hmoll, hcomm,
    pointwiseKernelConvolution_eq_reflectedPair]

/-- Lowering-from-successor counterpart of the preceding exact
representative identity. -/
theorem fullPlaneTestToL2_lowerForward_bufferedEssentialFriedrichs
    {n : ℤ} {z₀ : ℍ} {K : Set ℂ}
    (hK : IsCompact K) (j : ℕ)
    (u Lu : AmbientPlaneL2) (hu : HasEssentialSupportIn u K)
    (hb : tsupport
        (bufferedEssentialFriedrichsFullPlaneTest hK j u hu : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hWeak : IsPlanarAffineWeakGraph (-Complex.I)
      (-(((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 1 : ℝ) : ℂ)))
      u Lu) :
    fullPlaneTestToL2
        (ambientTestCoreToFullPlaneTest
          (euclideanLowerFromSuccForwardTest n
            (reducedChartAmbientTest
              (bufferedEssentialFriedrichsFullPlaneTest hK j u hu)
              hb))) =
      friedrichsAffineForwardCoordinate (-Complex.I) j u Lu := by
  let b : FullPlaneTest :=
    bufferedEssentialFriedrichsFullPlaneTest hK j u hu
  let a : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore :=
    reducedChartAmbientTest b hb
  apply MeasureTheory.Lp.ext
  filter_upwards [
    coeFn_fullPlaneTestToL2
      (ambientTestCoreToFullPlaneTest
        (euclideanLowerFromSuccForwardTest n a)),
    MeasureTheory.Lp.coeFn_add
      (friedrichsMollifierAction j Lu)
      (friedrichsAffineCommutatorAction (-Complex.I) j u),
    friedrichsMollifierAction_ae_eq_mollifiedRepresentative j Lu,
    friedrichsAffineCommutatorAction_ae_eq_pointwise (-Complex.I) j u]
      with w htest hadd hmoll hcomm
  rw [htest]
  change euclideanLowerFromSuccForwardTest n a w = _
  rw [euclideanLowerFromSuccForwardTest_eq_ambientAffineMaass,
    show a w = friedrichsMollifiedRepresentative j u w by
      simpa only [a, b, reducedChartAmbientTest_apply] using
        bufferedEssentialFriedrichsFullPlaneTest_apply hK j u hu w,
    hWeak.friedrichs_loweringFromSucc_identity]
  change _ =
    (friedrichsMollifierAction j Lu +
      friedrichsAffineCommutatorAction (-Complex.I) j u) w
  rw [hadd, hmoll, hcomm,
    pointwiseKernelConvolution_eq_reflectedPair]

/-! ### A single buffered tail gives both graph-coordinate limits -/

/-- Every positive chart buffer admits a natural-number tail on which all
Friedrichs radii lie inside that buffer. -/
theorem exists_friedrichsBufferStart
    {K U : Set ℂ} (hK : IsCompact K) (hU : IsOpen U)
    (hKU : K ⊆ U) :
    ∃ N : ℕ, ∀ j : ℕ,
      friedrichsRadius (j + N) <
        (compactChartBuffer hK hU hKU).radius := by
  obtain ⟨N, hN⟩ := (eventually_atTop.1
    (eventually_friedrichsRadius_lt
      (compactChartBuffer_radius_pos hK hU hKU)))
  refine ⟨N, fun j ↦ hN (j + N) ?_⟩
  exact Nat.le_add_left N j

/-- Local raising Friedrichs approximation in one reduced chart.  The same
shifted sequence has compact support in the chart and converges in both the
base and forward coordinates. -/
theorem exists_bufferedLocalRaisingApproximation
    {n : ℤ} {z₀ : ℍ} {K : Set ℂ}
    (hK : IsCompact K)
    (hKU : K ⊆ ambientGammaTwoReducedChart z₀)
    (u Ru : AmbientPlaneL2) (hu : HasEssentialSupportIn u K)
    (hWeak : IsPlanarAffineWeakGraph Complex.I
      (((Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent n + 2 : ℝ) : ℂ))
      u Ru) :
    ∃ v : ℕ → FullPlaneTest,
      ∃ hv : ∀ j : ℕ, tsupport (v j : ℂ → ℂ) ⊆
        ambientGammaTwoReducedChart z₀,
      Filter.Tendsto (fun j ↦ fullPlaneTestToL2 (v j)) Filter.atTop (𝓝 u) ∧
      Filter.Tendsto
        (fun j ↦ fullPlaneTestToL2
          (ambientTestCoreToFullPlaneTest
            (euclideanRaiseForwardTest n
              (reducedChartAmbientTest (v j) (hv j)))))
        Filter.atTop (𝓝 Ru) := by
  let U : Set ℂ := ambientGammaTwoReducedChart z₀
  have hU : IsOpen U := ambientGammaTwoReducedChart_isOpen z₀
  obtain ⟨N, hN⟩ := exists_friedrichsBufferStart hK hU hKU
  let v : ℕ → FullPlaneTest := fun j ↦
    bufferedEssentialFriedrichsFullPlaneTest hK (j + N) u hu
  have hv (j : ℕ) : tsupport (v j : ℂ → ℂ) ⊆ U :=
    (tsupport_bufferedEssentialFriedrichsFullPlaneTest_subset
      hK (j + N) u hu).trans
        (cthickening_friedrichsRadius_subset_chart
          hK hU hKU (hN j))
  refine ⟨v, hv, ?_, ?_⟩
  · have hAction :=
      (friedrichsMollifierAction_tendsto u).comp
        (tendsto_add_atTop_nat N)
    exact hAction.congr' <| Filter.Eventually.of_forall fun j ↦ by
      exact (fullPlaneTestToL2_bufferedEssentialFriedrichs
        hK (j + N) u hu).symm
  · have hAction :=
      (friedrichsAffineForwardCoordinate_tendsto Complex.I u Ru).comp
        (tendsto_add_atTop_nat N)
    apply hAction.congr'
    exact Filter.Eventually.of_forall fun j ↦ by
      simpa only [v] using
        (fullPlaneTestToL2_raiseForward_bufferedEssentialFriedrichs
          (n := n) hK (j + N) u Ru hu (hv j) hWeak).symm

/-- Local lowering approximation with the exact successor coefficient. -/
theorem exists_bufferedLocalLoweringApproximation
    {n : ℤ} {z₀ : ℍ} {K : Set ℂ}
    (hK : IsCompact K)
    (hKU : K ⊆ ambientGammaTwoReducedChart z₀)
    (u Lu : AmbientPlaneL2) (hu : HasEssentialSupportIn u K)
    (hWeak : IsPlanarAffineWeakGraph (-Complex.I)
