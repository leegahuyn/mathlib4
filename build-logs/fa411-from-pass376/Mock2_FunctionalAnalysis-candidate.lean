/-! #### Intrinsic compactly supported logarithmic cusp cutoffs -/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseGoodCuspCutoffBridge

open Set Function Topology Filter MeasureTheory Metric
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry

/-- The transition shell is
`N + 1 < modularLogMaxHeight < N + 2`.  In particular it lies entirely in
the positive, single-chart smooth region even when `N = 0`. -/
noncomputable def intrinsicCuspCutoffReal (N : ℕ) (z : ℍ) : ℝ :=
  Real.smoothTransition
    (((N : ℝ) + 2) - modularLogMaxHeight z)

noncomputable def intrinsicCuspCutoff (N : ℕ) (z : ℍ) : ℂ :=
  (intrinsicCuspCutoffReal N z : ℂ)

theorem intrinsicCuspCutoffReal_continuous (N : ℕ) :
    Continuous (intrinsicCuspCutoffReal N) := by
  exact Real.smoothTransition.continuous.comp
    (continuous_const.sub modularLogMaxHeight_continuous)

theorem intrinsicCuspCutoff_continuous (N : ℕ) :
    Continuous (intrinsicCuspCutoff N) :=
  Complex.continuous_ofReal.comp (intrinsicCuspCutoffReal_continuous N)

theorem intrinsicCuspCutoffReal_SL_invariant
    (N : ℕ) (gamma : SL(2, ℤ)) (z : ℍ) :
    intrinsicCuspCutoffReal N (gamma • z) =
      intrinsicCuspCutoffReal N z := by
  simp only [intrinsicCuspCutoffReal,
    modularLogMaxHeight_SL_invariant]

theorem intrinsicCuspCutoff_SL_invariant
    (N : ℕ) (gamma : SL(2, ℤ)) (z : ℍ) :
    intrinsicCuspCutoff N (gamma • z) =
      intrinsicCuspCutoff N z := by
  simp only [intrinsicCuspCutoff,
    intrinsicCuspCutoffReal_SL_invariant]

theorem intrinsicCuspCutoffReal_gammaTwo_invariant
    (N : ℕ) (gamma : GammaTwo) (z : ℍ) :
    intrinsicCuspCutoffReal N
        (((gamma : GammaTwo) : SL(2, ℤ)) • z) =
      intrinsicCuspCutoffReal N z :=
  intrinsicCuspCutoffReal_SL_invariant N (gamma : SL(2, ℤ)) z

theorem intrinsicCuspCutoff_gammaTwo_invariant
    (N : ℕ) (gamma : GammaTwo) (z : ℍ) :
    intrinsicCuspCutoff N
        (((gamma : GammaTwo) : SL(2, ℤ)) • z) =
      intrinsicCuspCutoff N z :=
  intrinsicCuspCutoff_SL_invariant N (gamma : SL(2, ℤ)) z

theorem intrinsicCuspCutoffReal_effective_invariant
    (N : ℕ) (a : GammaTwoEffective) (z : ℍ) :
    intrinsicCuspCutoffReal N (a • z) =
      intrinsicCuspCutoffReal N z := by
  obtain ⟨gamma, hgamma⟩ := effective_exists_gamma a
  rw [hgamma z]
  exact intrinsicCuspCutoffReal_gammaTwo_invariant N gamma z

theorem intrinsicCuspCutoff_effective_invariant
    (N : ℕ) (a : GammaTwoEffective) (z : ℍ) :
    intrinsicCuspCutoff N (a • z) = intrinsicCuspCutoff N z := by
  simp only [intrinsicCuspCutoff,
    intrinsicCuspCutoffReal_effective_invariant]

theorem intrinsicCuspCutoffReal_nonneg (N : ℕ) (z : ℍ) :
    0 ≤ intrinsicCuspCutoffReal N z :=
  Real.smoothTransition.nonneg _

theorem intrinsicCuspCutoffReal_le_one (N : ℕ) (z : ℍ) :
    intrinsicCuspCutoffReal N z ≤ 1 :=
  Real.smoothTransition.le_one _

theorem intrinsicCuspCutoffReal_eq_one_of_logHeight_le
    {N : ℕ} {z : ℍ}
    (hz : modularLogMaxHeight z ≤ (N : ℝ) + 1) :
    intrinsicCuspCutoffReal N z = 1 := by
  apply Real.smoothTransition.one_of_one_le
  dsimp only [intrinsicCuspCutoffReal]
  linarith

theorem intrinsicCuspCutoffReal_eq_zero_of_level_le_logHeight
    {N : ℕ} {z : ℍ}
    (hz : (N : ℝ) + 2 ≤ modularLogMaxHeight z) :
    intrinsicCuspCutoffReal N z = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  dsimp only [intrinsicCuspCutoffReal]
  linarith

theorem intrinsicCuspCutoffReal_mono
    {N M : ℕ} (hNM : N ≤ M) (z : ℍ) :
    intrinsicCuspCutoffReal N z ≤ intrinsicCuspCutoffReal M z := by
  apply Real.smoothTransition.monotone
  have hCast : (N : ℝ) ≤ (M : ℝ) := by exact_mod_cast hNM
  linarith

theorem exists_intrinsicCuspCutoffReal_eq_one (z : ℍ) :
    ∃ N : ℕ, intrinsicCuspCutoffReal N z = 1 := by
  obtain ⟨N, hN⟩ := exists_nat_gt (modularLogMaxHeight z)
  refine ⟨N, intrinsicCuspCutoffReal_eq_one_of_logHeight_le ?_⟩
  exact hN.le.trans (by linarith)

/-- Descended intrinsic cutoff on the effective `Gamma(2)` quotient. -/
noncomputable def intrinsicQuotientCuspCutoffReal
    (N : ℕ) : GammaTwoQuotient → ℝ :=
  descendInvariant (intrinsicCuspCutoffReal N)
    (intrinsicCuspCutoffReal_effective_invariant N)

@[simp]
theorem intrinsicQuotientCuspCutoffReal_mk (N : ℕ) (z : ℍ) :
    intrinsicQuotientCuspCutoffReal N (gammaTwoQuotientMk z) =
      intrinsicCuspCutoffReal N z :=
  rfl

theorem intrinsicQuotientCuspCutoffReal_continuous (N : ℕ) :
    Continuous (intrinsicQuotientCuspCutoffReal N) := by
  unfold intrinsicQuotientCuspCutoffReal
  exact (intrinsicCuspCutoffReal_continuous N).quotient_lift _

/-- Nonzero quotient support lies in the image of the literal compact
three-cusp truncation at the exponential height corresponding to the outer
logarithmic cutoff level. -/
theorem intrinsicQuotientCuspCutoffReal_support_subset_truncation
    (N : ℕ) :
    Function.support (intrinsicQuotientCuspCutoffReal N) ⊆
      gammaTwoQuotientMk ''
        gammaTwoThreeCuspTruncation (Real.exp ((N : ℝ) + 2)) := by
  intro q hq
  induction q using Quotient.inductionOn'
  rename_i z
  obtain ⟨a, haCarrier⟩ := gammaTwoClosedTileCarrier_orbit_covers z
  let w : ℍ := a • z
  have hCutW : intrinsicCuspCutoffReal N w ≠ 0 := by
    simpa only [w, intrinsicQuotientCuspCutoffReal_mk,
      intrinsicCuspCutoffReal_effective_invariant] using hq
  have hArg : 0 < ((N : ℝ) + 2) - modularLogMaxHeight w := by
    by_contra hnot
    have hle : ((N : ℝ) + 2) - modularLogMaxHeight w ≤ 0 :=
      le_of_not_gt hnot
    exact hCutW (Real.smoothTransition.zero_of_nonpos hle)
  have hLog : modularLogMaxHeight w < (N : ℝ) + 2 := by
    linarith
  have hMax : modularMaxHeight w < Real.exp ((N : ℝ) + 2) := by
    rw [← Real.exp_log (modularMaxHeight_pos w)]
    exact Real.exp_lt_exp.mpr hLog
  have hY : 1 ≤ Real.exp ((N : ℝ) + 2) := by
    apply Real.one_le_exp
    positivity
  have hwTrunc :
      w ∈ gammaTwoThreeCuspTruncation
        (Real.exp ((N : ℝ) + 2)) := by
    apply mem_gammaTwoThreeCuspTruncation_iff.mpr
    refine ⟨haCarrier, ?_⟩
    intro r
    rw [gammaTwoCuspLevel_of_one_le hY]
    simpa only [gammaTwoTileHeight] using
      (modularHeightMaximizer_spec w
        (gammaTwoCosetRep r)⁻¹).trans hMax.le
  refine ⟨w, hwTrunc, ?_⟩
  exact gammaTwoQuotientMk_smul a z

theorem intrinsicQuotientCuspCutoffReal_hasCompactSupport (N : ℕ) :
    HasCompactSupport (intrinsicQuotientCuspCutoffReal N) := by
  change IsCompact
    (closure (Function.support (intrinsicQuotientCuspCutoffReal N)))
  have hCompactImage : IsCompact
      (gammaTwoQuotientMk ''
        gammaTwoThreeCuspTruncation (Real.exp ((N : ℝ) + 2))) :=
    (gammaTwoThreeCuspTruncation_isCompact _).image
      gammaTwoQuotientMk_isOpenQuotientMap.continuous
  exact hCompactImage.of_isClosed_subset isClosed_closure
    (closure_minimal
      (intrinsicQuotientCuspCutoffReal_support_subset_truncation N)
      hCompactImage.isClosed)

theorem intrinsicCuspCutoff_projected_support (N : ℕ) :
    gammaTwoQuotientMk '' Function.support (intrinsicCuspCutoff N) =
      Function.support (intrinsicQuotientCuspCutoffReal N) := by
  ext q
  induction q using Quotient.inductionOn'
  rename_i z
  constructor
  · rintro ⟨w, hw, hEq⟩
    have hw' : intrinsicQuotientCuspCutoffReal N
        (gammaTwoQuotientMk w) ≠ 0 := by
      simpa only [Function.mem_support,
        intrinsicQuotientCuspCutoffReal_mk, intrinsicCuspCutoff,
        Complex.ofReal_ne_zero] using hw
    rwa [hEq] at hw'
  · intro hz
    refine ⟨z, ?_, rfl⟩
    simpa only [Function.mem_support,
      intrinsicQuotientCuspCutoffReal_mk, intrinsicCuspCutoff,
      Complex.ofReal_ne_zero] using hz

theorem intrinsicCuspCutoff_quotientCompact (N : ℕ) :
    HasQuotientCompactSupport (intrinsicCuspCutoff N) := by
  rw [HasQuotientCompactSupport, quotientTSupport, tsupport,
    intrinsicCuspCutoff_projected_support]
  exact intrinsicQuotientCuspCutoffReal_hasCompactSupport N

end FixedPhaseGoodCuspCutoffBridge

