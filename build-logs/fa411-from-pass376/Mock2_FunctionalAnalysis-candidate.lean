/-!
================================================================================
P3.3: oriented one-dimensional flux integrals

Mathlib's `Path` and `curveIntegral` are used here as the canonical path API.
The latter is defined from the derivative of `Path.extend`, is insensitive to
the two endpoint parameters, and already supplies reversal and concatenation.
For the noncompact edge parameters used by the modular polygon we also expose
the equivalent explicit interval/set-integral API.  This second API is the one
that interfaces directly with the existing circular, vertical, and horocycle
parametrizations.
================================================================================
-/

namespace Mock2FA
namespace PaperCorrections.AutomorphicSobolev
namespace GammaTwoOrientedBoundaryIntegral

open MeasureTheory Set
open scoped Interval unitInterval
open GammaTwoQuotientGeometry
open GammaTwoQuotientGreenBoundary
open HalfWeightDifferentialOperators

/-! #### The real-linear complex one-form -/

/-- The flux expression `X dy - Y dx` as a genuine continuous real-linear
map on the complex tangent plane at an upper-half-plane point. -/
noncomputable def fluxOneFormCLM (X Y : ℍ → ℂ) (z : ℍ) :
    ℂ →L[ℝ] ℂ :=
  Complex.imCLM.smulRight (X z) - Complex.reCLM.smulRight (Y z)

@[simp]
theorem fluxOneFormCLM_apply (X Y : ℍ → ℂ) (z : ℍ) (ξ : ℂ) :
    fluxOneFormCLM X Y z ξ = fluxOneFormValue X Y z ξ := by
  simp [fluxOneFormCLM, fluxOneFormValue, Complex.real_smul]
  ring

/-- Extension of the upper-half-plane one-form to the ambient complex plane.
Its values outside the open upper half-plane are immaterial for paths whose
range stays upstairs. -/
noncomputable def ambientUpperFluxOneForm (X Y : ℍ → ℂ) :
    ℂ → ℂ →L[ℝ] ℂ :=
  fun w => if hw : 0 < w.im then fluxOneFormCLM X Y ⟨w, hw⟩ else 0

@[simp]
theorem ambientUpperFluxOneForm_apply (X Y : ℍ → ℂ)
    (z : ℍ) (ξ : ℂ) :
    ambientUpperFluxOneForm X Y (z : ℂ) ξ =
      fluxOneFormValue X Y z ξ := by
  simp [ambientUpperFluxOneForm, z.im_pos]

/-! #### Mathlib paths and curve integrals -/

/-- A complex path is an upper-half-plane path when its whole range stays in
the open upper half plane.  Endpoints are included because `Path.range`
contains the source and target. -/
def IsUpperPlanePath {a b : ℂ} (γ : Path a b) : Prop :=
  Set.range γ ⊆ UpperHalfPlane.upperHalfPlaneSet

theorem IsUpperPlanePath.symm {a b : ℂ} {γ : Path a b}
    (hγ : IsUpperPlanePath γ) : IsUpperPlanePath γ.symm := by
  rw [IsUpperPlanePath, Path.symm_range]
  exact hγ

theorem IsUpperPlanePath.trans {a b c : ℂ}
    {γab : Path a b} {γbc : Path b c}
    (hab : IsUpperPlanePath γab) (hbc : IsUpperPlanePath γbc) :
    IsUpperPlanePath (γab.trans γbc) := by
  rw [IsUpperPlanePath, Path.trans_range]
  exact Set.union_subset hab hbc

/-- The upper-half-plane point represented by the globally extended path at a
real parameter.  `Path.extend_range` makes the positivity proof uniform both
inside and outside `[0,1]`. -/
noncomputable def upperPathPoint {a b : ℂ} (γ : Path a b)
    (hγ : IsUpperPlanePath γ) (t : ℝ) : ℍ :=
  ⟨γ.extend t, hγ (by
    rw [← γ.extend_range]
    exact Set.mem_range_self t)⟩

/-- Complex-valued integral of the flux one-form along a Mathlib path. -/
noncomputable def upperFluxCurveIntegral (X Y : ℍ → ℂ)
    {a b : ℂ} (γ : Path a b) : ℂ :=
  curveIntegral (ambientUpperFluxOneForm X Y) γ

/-- The selected curve integral is literally the interval integral of
`X dy - Y dx` against the derivative of the extended path. -/
theorem upperFluxCurveIntegral_eq_intervalIntegral (X Y : ℍ → ℂ)
    {a b : ℂ} (γ : Path a b) (hγ : IsUpperPlanePath γ) :
    upperFluxCurveIntegral X Y γ =
      ∫ t in (0 : ℝ)..1,
        fluxOneFormValue X Y (upperPathPoint γ hγ t)
          (deriv γ.extend t) := by
  rw [upperFluxCurveIntegral, curveIntegral_eq_intervalIntegral_deriv]
  apply intervalIntegral.integral_congr
  intro t _ht
  simpa [upperPathPoint] using
    ambientUpperFluxOneForm_apply X Y (upperPathPoint γ hγ t)
      (deriv γ.extend t)

/-- Reversing an oriented path reverses the sign of its flux integral. -/
@[simp]
theorem upperFluxCurveIntegral_symm (X Y : ℍ → ℂ)
    {a b : ℂ} (γ : Path a b) :
    upperFluxCurveIntegral X Y γ.symm =
      -upperFluxCurveIntegral X Y γ := by
  simpa only [upperFluxCurveIntegral] using
    curveIntegral_symm (ambientUpperFluxOneForm X Y) γ

/-- Concatenation is additive whenever the two one-dimensional Bochner
integrals exist.  This is Mathlib's piecewise-`C¹` path theorem. -/
theorem upperFluxCurveIntegral_trans (X Y : ℍ → ℂ)
    {a b c : ℂ} (γab : Path a b) (γbc : Path b c)
    (hab : CurveIntegrable (ambientUpperFluxOneForm X Y) γab)
    (hbc : CurveIntegrable (ambientUpperFluxOneForm X Y) γbc) :
    upperFluxCurveIntegral X Y (γab.trans γbc) =
      upperFluxCurveIntegral X Y γab +
        upperFluxCurveIntegral X Y γbc := by
  simpa only [upperFluxCurveIntegral] using curveIntegral_trans hab hbc

/-! #### Explicit real-parameter integrals -/

/-- Oriented interval integral for an explicitly supplied point curve and its
complex tangent.  Supplying the tangent separately is useful for the subtype-
valued modular edge parametrizations. -/
noncomputable def orientedFluxParameterIntegral
    (X Y : ℍ → ℂ) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (a b : ℝ) : ℂ :=
  ∫ t in a..b, fluxOneFormValue X Y (p t) (velocity t)

/-- The same integral over a measurable parameter set. -/
noncomputable def orientedFluxSetIntegral
    (X Y : ℍ → ℂ) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (s : Set ℝ) : ℂ :=
  ∫ t in s, fluxOneFormValue X Y (p t) (velocity t)

theorem orientedFluxParameterIntegral_symm
    (X Y : ℍ → ℂ) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (a b : ℝ) :
    orientedFluxParameterIntegral X Y p velocity b a =
      -orientedFluxParameterIntegral X Y p velocity a b := by
  exact intervalIntegral.integral_symm a b

theorem orientedFluxParameterIntegral_add_adjacent
    (X Y : ℍ → ℂ) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (a b c : ℝ)
    (hab : IntervalIntegrable
      (fun t => fluxOneFormValue X Y (p t) (velocity t)) volume a b)
    (hbc : IntervalIntegrable
      (fun t => fluxOneFormValue X Y (p t) (velocity t)) volume b c) :
    orientedFluxParameterIntegral X Y p velocity a c =
      orientedFluxParameterIntegral X Y p velocity a b +
        orientedFluxParameterIntegral X Y p velocity b c := by
  exact (intervalIntegral.integral_add_adjacent_intervals hab hbc).symm

/-- Pointwise pullback invariance integrates to the exact Möbius
change-of-variables formula.  The transformed tangent is the proved real
Fréchet differential of the Möbius action, so no Jacobian or phase factor is
omitted. -/
theorem orientedFluxParameterIntegral_gammaTwo
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (γ : GammaTwo) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (a b : ℝ) :
    orientedFluxParameterIntegral X Y
        (fun t => ((γ : SL(2, ℤ)) • p t))
        (fun t => d1 (gammaTwoActionCoordinate γ) (p t) (velocity t))
        a b =
      orientedFluxParameterIntegral X Y p velocity a b := by
  apply intervalIntegral.integral_congr
  intro t _ht
  exact hInv γ (p t) (velocity t)

theorem orientedFluxSetIntegral_gammaTwo
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (γ : GammaTwo) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    {s : Set ℝ} (hs : MeasurableSet s) :
    orientedFluxSetIntegral X Y
        (fun t => ((γ : SL(2, ℤ)) • p t))
        (fun t => d1 (gammaTwoActionCoordinate γ) (p t) (velocity t))
        s =
      orientedFluxSetIntegral X Y p velocity s := by
  apply setIntegral_congr_fun hs
  intro t _ht
  exact hInv γ (p t) (velocity t)

/-- Removing finitely many endpoint or corner parameters does not change the
one-dimensional flux integral. -/
theorem orientedFluxSetIntegral_diff_finite
    (X Y : ℍ → ℂ) (p : ℝ → ℍ) (velocity : ℝ → ℂ)
    (s C : Set ℝ) (hC : C.Finite) :
    orientedFluxSetIntegral X Y p velocity (s \ C) =
      orientedFluxSetIntegral X Y p velocity s := by
  exact GammaTwoQuotientGeometry.setIntegral_diff_null_eq
    (fun t => fluxOneFormValue X Y (p t) (velocity t)) s C
    (hC.measure_zero volume)

/-! #### Tangent algebra and the three geometric edge types -/

@[simp]
theorem fluxOneFormValue_neg (X Y : ℍ → ℂ) (z : ℍ) (ξ : ℂ) :
    fluxOneFormValue X Y z (-ξ) = -fluxOneFormValue X Y z ξ := by
  simp [fluxOneFormValue]
  ring

theorem fluxOneFormValue_vertical (X Y : ℍ → ℂ)
    (z : ℍ) (r : ℝ) :
    fluxOneFormValue X Y z ((r : ℂ) * Complex.I) =
      (r : ℂ) * X z := by
  simp [fluxOneFormValue]
  ring

theorem fluxOneFormValue_horizontal (X Y : ℍ → ℂ)
    (z : ℍ) (r : ℝ) :
    fluxOneFormValue X Y z (r : ℂ) =
      -(r : ℂ) * Y z := by
  simp [fluxOneFormValue]
  ring

/-- Velocity of the explicit upper-unit-circle parametrization used by the
actual modular edge API. -/
noncomputable def modularCircularArcVelocity (t : ℝ) : ℂ :=
  Complex.mk ((1 : ℝ) / 2)
    (-t / (4 * Real.sqrt (1 - (t / 2) ^ 2)))

/-- The circular velocity has no endpoint singularity on the declared
parameter interval.  Here `|t| ≤ 1`, so the radicand is at least `3/4`. -/
theorem modularCircularArc_sqrt_pos
    (t : Set.Icc (-1 : ℝ) 1) :
    0 < Real.sqrt (1 - ((t : ℝ) / 2) ^ 2) := by
  apply Real.sqrt_pos.2
  have hprod :
      0 ≤ (1 - (t : ℝ)) * ((t : ℝ) + 1) :=
    mul_nonneg (sub_nonneg.mpr t.property.2)
      (by linarith [t.property.1])
  nlinarith

theorem modularCircularArc_velocityDenominator_ne_zero
    (t : Set.Icc (-1 : ℝ) 1) :
    4 * Real.sqrt (1 - ((t : ℝ) / 2) ^ 2) ≠ 0 := by
  have hs := modularCircularArc_sqrt_pos t
  positivity

/-- Velocity selected for each of the three base modular edge kinds. -/
noncomputable def modularTileEdgeVelocity :
    (e : GammaTwoModularTileEdge) →
      modularTileEdgeParameterSet e → ℂ
  | .circularArc, t => modularCircularArcVelocity t
  | .leftVerticalSegment, _t => Complex.I
  | .rightVerticalSegment, _t => Complex.I

theorem modularCircularArc_flux_formula (X Y : ℍ → ℂ)
    (t : Set.Icc (-1 : ℝ) 1) :
    fluxOneFormValue X Y (modularCircularArcParam t)
        (modularTileEdgeVelocity .circularArc t) =
      X (modularCircularArcParam t) *
          ((-((t : ℝ)) /
            (4 * Real.sqrt (1 - ((t : ℝ) / 2) ^ 2)) : ℝ) : ℂ) -
        Y (modularCircularArcParam t) * (((1 : ℝ) / 2 : ℝ) : ℂ) := by
  simp [modularTileEdgeVelocity, modularCircularArcVelocity,
    fluxOneFormValue]

theorem modularLeftVertical_flux_formula (X Y : ℍ → ℂ)
    (t : Set.Ici (0 : ℝ)) :
    fluxOneFormValue X Y (modularLeftVerticalParam t)
        (modularTileEdgeVelocity .leftVerticalSegment t) =
      X (modularLeftVerticalParam t) := by
  simpa [modularTileEdgeVelocity] using
    fluxOneFormValue_vertical X Y (modularLeftVerticalParam t) 1

theorem modularRightVertical_flux_formula (X Y : ℍ → ℂ)
    (t : Set.Ici (0 : ℝ)) :
    fluxOneFormValue X Y (modularRightVerticalParam t)
        (modularTileEdgeVelocity .rightVerticalSegment t) =
      X (modularRightVerticalParam t) := by
  simpa [modularTileEdgeVelocity] using
    fluxOneFormValue_vertical X Y (modularRightVerticalParam t) 1

/-- A horizontal horocycle in one cusp chart. -/
def baseHorocycleParam (H : ℝ) (hH : 0 < H) (t : ℝ) : ℍ :=
  ⟨Complex.mk t H, hH⟩

@[simp]
theorem baseHorocycle_flux_formula (X Y : ℍ → ℂ)
    (H : ℝ) (hH : 0 < H) (t : ℝ) :
    fluxOneFormValue X Y (baseHorocycleParam H hH t) 1 =
      -Y (baseHorocycleParam H hH t) := by
  simpa using fluxOneFormValue_horizontal X Y
    (baseHorocycleParam H hH t) 1

theorem baseHorocycle_fluxIntegral_formula (X Y : ℍ → ℂ)
    (H : ℝ) (hH : 0 < H) (a b : ℝ) :
    orientedFluxParameterIntegral X Y
        (baseHorocycleParam H hH) (fun _ => 1) a b =
      -(∫ t in a..b, Y (baseHorocycleParam H hH t)) := by
  calc
    orientedFluxParameterIntegral X Y
        (baseHorocycleParam H hH) (fun _ => 1) a b =
        ∫ t in a..b, -Y (baseHorocycleParam H hH t) := by
      apply intervalIntegral.integral_congr
      intro t _ht
      exact baseHorocycle_flux_formula X Y H hH t
    _ = -(∫ t in a..b, Y (baseHorocycleParam H hH t)) := by
      rw [intervalIntegral.integral_neg]

/-! #### Actual paired-edge transport and cancellation -/

theorem measurableSet_modularTileEdgeParameterSet
    (e : GammaTwoModularTileEdge) :
    MeasurableSet (modularTileEdgeParameterSet e) := by
  cases e <;> simp [modularTileEdgeParameterSet]

noncomputable def actualEdgePoint
    (e : GammaTwoActualPolygonEdge) (t : ℝ) : ℍ := by
  classical
  exact if ht : t ∈ modularTileEdgeParameterSet e.2 then
    gammaTwoActualPolygonEdgeParam e ⟨t, ht⟩
  else UpperHalfPlane.I

noncomputable def actualPairedEdgePoint
    (e : GammaTwoActualPolygonEdge) (t : ℝ) : ℍ := by
  classical
  exact if ht : t ∈ modularTileEdgeParameterSet e.2 then
    gammaTwoActualPolygonEdgeParam e.paired
      (e.pairedParameter ⟨t, ht⟩)
  else UpperHalfPlane.I

noncomputable def actualPairedTransportedVelocity
    (e : GammaTwoActualPolygonEdge) (velocity : ℝ → ℂ)
    (t : ℝ) : ℂ := by
  classical
  exact if ht : t ∈ modularTileEdgeParameterSet e.2 then
    -d1 (gammaTwoActionCoordinate e.pairingElement)
      (gammaTwoActualPolygonEdgeParam e ⟨t, ht⟩) (velocity t)
  else 0

/-- Pointwise paired-side cancellation after transporting both the point and
tangent by the actual `Gamma(2)` pairing. -/
theorem invariantFlux_actualPairedEdge_opposite
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge) (velocity : ℝ → ℂ)
    {t : ℝ} (ht : t ∈ modularTileEdgeParameterSet e.2) :
    fluxOneFormValue X Y (actualPairedEdgePoint e t)
        (actualPairedTransportedVelocity e velocity t) =
      -fluxOneFormValue X Y (actualEdgePoint e t) (velocity t) := by
  simp only [actualPairedEdgePoint, actualPairedTransportedVelocity,
    actualEdgePoint, dif_pos ht, fluxOneFormValue_neg]
  rw [invariantFlux_actualPolygonEdge_pairing hInv e ⟨t, ht⟩ (velocity t)]

/-- The one-dimensional integral on a paired side, written in the source
parameter and with the opposite transported orientation, is the negative of
the source-edge integral. -/
theorem invariantFlux_actualPairedEdge_integral_cancel
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge) (velocity : ℝ → ℂ) :
    (∫ t in modularTileEdgeParameterSet e.2,
      fluxOneFormValue X Y (actualPairedEdgePoint e t)
        (actualPairedTransportedVelocity e velocity t)) =
      -(∫ t in modularTileEdgeParameterSet e.2,
        fluxOneFormValue X Y (actualEdgePoint e t) (velocity t)) := by
  calc
    (∫ t in modularTileEdgeParameterSet e.2,
        fluxOneFormValue X Y (actualPairedEdgePoint e t)
          (actualPairedTransportedVelocity e velocity t)) =
        ∫ t in modularTileEdgeParameterSet e.2,
          -fluxOneFormValue X Y (actualEdgePoint e t) (velocity t) := by
      apply setIntegral_congr_fun
        (measurableSet_modularTileEdgeParameterSet e.2)
      intro t ht
      exact invariantFlux_actualPairedEdge_opposite hInv e velocity ht
    _ = -(∫ t in modularTileEdgeParameterSet e.2,
        fluxOneFormValue X Y (actualEdgePoint e t) (velocity t)) := by
      rw [integral_neg]

theorem invariantFlux_actualPairedEdge_sum_eq_zero
    {X Y : ℍ → ℂ} (hInv : IsGammaTwoInvariantFlux X Y)
    (e : GammaTwoActualPolygonEdge) (velocity : ℝ → ℂ) :
    (∫ t in modularTileEdgeParameterSet e.2,
        fluxOneFormValue X Y (actualEdgePoint e t) (velocity t)) +
      (∫ t in modularTileEdgeParameterSet e.2,
        fluxOneFormValue X Y (actualPairedEdgePoint e t)
          (actualPairedTransportedVelocity e velocity t)) = 0 := by
  rw [invariantFlux_actualPairedEdge_integral_cancel hInv]
  exact add_neg_cancel _

/-! #### The actual edge-pairing permutation

The first coordinate of an actual edge is a *selected* right-coset
representative.  Consequently involutivity of `paired` is not definitional:
after crossing two sides one has to use normality of `Gamma(2)` to compare
the newly selected representative with the original one.  This is the finite
combinatorial step needed to turn pointwise paired-side cancellation into
cancellation of the whole polygonal boundary sum. -/

/-- The two inverse base side-pairing matrices differ from the identity by an
element of `Gamma(2)`.  On the circular side their product is the central
matrix `-1`; on the vertical sides it is literally `1`. -/
theorem modularPairingMatrix_inv_mul_paired_inv_mem_gammaTwo
    (e : GammaTwoModularTileEdge) :
    e.pairingMatrix⁻¹ * e.paired.pairingMatrix⁻¹ ∈
      CongruenceSubgroup.Gamma 2 := by
  cases e with
  | circularArc =>
      change ModularGroup.S⁻¹ * ModularGroup.S⁻¹ ∈
        CongruenceSubgroup.Gamma 2
      rw [ModularGroup.S_inv]
      have hSS :
          ModularGroup.S * ModularGroup.S = (-1 : SL(2, ℤ)) := by
        apply Subtype.ext
        exact ModularGroup.S_mul_S_eq
      have hneg :
          (-ModularGroup.S) * (-ModularGroup.S) =
            (-1 : SL(2, ℤ)) := by
        simpa using hSS
      rw [hneg]
      exact neg_one_mem_gammaTwo
  | leftVerticalSegment =>
      simp [GammaTwoModularTileEdge.pairingMatrix,
        GammaTwoModularTileEdge.paired]
  | rightVerticalSegment =>
      simp [GammaTwoModularTileEdge.pairingMatrix,
        GammaTwoModularTileEdge.paired]

/-- Crossing the paired side twice returns the original actual edge, including
its noncomputably selected right-coset representative. -/
theorem GammaTwoActualPolygonEdge.paired_paired
    (e : GammaTwoActualPolygonEdge) : e.paired.paired = e := by
  have hrep :
      gammaTwoCosetRep e.paired.1 =
        (e.decompositionElement : SL(2, ℤ))⁻¹ *
          (gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹) := by
    calc
      gammaTwoCosetRep e.paired.1 =
          (e.decompositionElement : SL(2, ℤ))⁻¹ *
            ((e.decompositionElement : SL(2, ℤ)) *
              gammaTwoCosetRep e.paired.1) := by simp
      _ = (e.decompositionElement : SL(2, ℤ))⁻¹ *
          (gammaTwoCosetRep e.1 * e.2.pairingMatrix⁻¹) := by
        rw [← e.decompositionElement_spec]
  have hfirst :
      gammaTwoCosetRep e.paired.1 * e.2.pairingMatrix *
          (gammaTwoCosetRep e.1)⁻¹ ∈
        CongruenceSubgroup.Gamma 2 := by
    rw [hrep]
    simpa [mul_assoc] using
      (CongruenceSubgroup.Gamma 2).inv_mem
        e.decompositionElement.property
  have hbase :
      e.2.pairingMatrix⁻¹ *
          e.2.paired.pairingMatrix⁻¹ ∈
        CongruenceSubgroup.Gamma 2 :=
    modularPairingMatrix_inv_mul_paired_inv_mem_gammaTwo e.2
  have hconj :
      gammaTwoCosetRep e.1 *
          (e.2.pairingMatrix⁻¹ *
            e.2.paired.pairingMatrix⁻¹) *
          (gammaTwoCosetRep e.1)⁻¹ ∈
        CongruenceSubgroup.Gamma 2 :=
    (CongruenceSubgroup.Gamma_normal 2).conj_mem _ hbase _
  have hrepresentative :
      gammaTwoCosetRep e.paired.1 *
          e.2.paired.pairingMatrix⁻¹ *
          (gammaTwoCosetRep e.1)⁻¹ ∈
        CongruenceSubgroup.Gamma 2 := by
    simpa [mul_assoc] using
      (CongruenceSubgroup.Gamma 2).mul_mem hfirst hconj
  have hq : e.1 = e.paired.paired.1 := by
    change e.1 =
      (Quotient.mk''
        (gammaTwoCosetRep e.paired.1 *
          e.paired.2.pairingMatrix⁻¹) : GammaTwoRightCoset)
    rw [← gammaTwoCosetRep_mk e.1]
    apply Quotient.sound'
    rw [QuotientGroup.rightRel_apply]
    simpa only [GammaTwoActualPolygonEdge.paired_second] using
      hrepresentative
  apply Prod.ext
  · exact hq.symm
  · exact e.2.paired_paired

/-- The genuine pairing permutation of the finite actual-edge type. -/
noncomputable def actualPolygonEdgePairingEquiv :
    GammaTwoActualPolygonEdge ≃ GammaTwoActualPolygonEdge where
  toFun := GammaTwoActualPolygonEdge.paired
  invFun := GammaTwoActualPolygonEdge.paired
  left_inv := GammaTwoActualPolygonEdge.paired_paired
  right_inv := GammaTwoActualPolygonEdge.paired_paired

/-- A complex-valued contribution which changes sign under the actual side
pairing has zero sum over the complete finite edge complex. -/
theorem sum_actualPolygonEdges_eq_zero_of_paired_neg
    (B : GammaTwoActualPolygonEdge → ℂ)
    (hB : ∀ e, B e.paired = -B e) :
    (∑ e : GammaTwoActualPolygonEdge, B e) = 0 := by
  have hreindex :
      (∑ e : GammaTwoActualPolygonEdge, B e.paired) =
        ∑ e : GammaTwoActualPolygonEdge, B e := by
    simpa [actualPolygonEdgePairingEquiv] using
      (actualPolygonEdgePairingEquiv.sum_comp B)
  have hneg :
      (∑ e : GammaTwoActualPolygonEdge, B e.paired) =
        -(∑ e : GammaTwoActualPolygonEdge, B e) := by
    calc
      (∑ e : GammaTwoActualPolygonEdge, B e.paired) =
          ∑ e : GammaTwoActualPolygonEdge, -B e := by
        apply Finset.sum_congr rfl
        intro e _he
        exact hB e
      _ = -(∑ e : GammaTwoActualPolygonEdge, B e) := by
        simp
  have hsym :
      -(∑ e : GammaTwoActualPolygonEdge, B e) =
        ∑ e : GammaTwoActualPolygonEdge, B e :=
    hneg.symm.trans hreindex
  linear_combination (-1 / 2 : ℂ) * hsym

/-! #### Finite boundary chains and internal-edge cancellation -/

/-- Endpoint-typed wrapper allowing paths with different endpoints to occur
in one finite boundary chain. -/
structure ComplexPathPiece where
  source : ℂ
  target : ℂ
  path : Path source target

namespace ComplexPathPiece

noncomputable def symm (p : ComplexPathPiece) : ComplexPathPiece where
  source := p.target
  target := p.source
  path := p.path.symm

noncomputable def fluxIntegral (X Y : ℍ → ℂ)
    (p : ComplexPathPiece) : ℂ :=
  upperFluxCurveIntegral X Y p.path

@[simp]
theorem fluxIntegral_symm (X Y : ℍ → ℂ) (p : ComplexPathPiece) :
    (p.symm).fluxIntegral X Y = -p.fluxIntegral X Y := by
  exact upperFluxCurveIntegral_symm X Y p.path

end ComplexPathPiece

abbrev ComplexBoundaryChain := List ComplexPathPiece

namespace ComplexBoundaryChain

noncomputable def fluxIntegral (X Y : ℍ → ℂ)
    (C : ComplexBoundaryChain) : ℂ :=
  (C.map fun p => p.fluxIntegral X Y).sum

noncomputable def reverse (C : ComplexBoundaryChain) : ComplexBoundaryChain :=
  (C.map ComplexPathPiece.symm).reverse

@[simp]
theorem fluxIntegral_append (X Y : ℍ → ℂ)
    (C D : ComplexBoundaryChain) :
    fluxIntegral X Y (C ++ D) =
      fluxIntegral X Y C + fluxIntegral X Y D := by
  simp [fluxIntegral]

@[simp]
theorem fluxIntegral_reverse (X Y : ℍ → ℂ)
    (C : ComplexBoundaryChain) :
    fluxIntegral X Y C.reverse = -fluxIntegral X Y C := by
  unfold reverse fluxIntegral
  rw [List.map_reverse, List.sum_reverse, List.map_map]
  induction C with
  | nil => simp
  | cons p C ih =>
      simp only [List.map_cons, List.sum_cons, Function.comp_apply]
      rw [ComplexPathPiece.fluxIntegral_symm, ih]
      abel

/-- Adding every internal edge once in each orientation contributes exactly
zero to the finite boundary integral. -/
theorem append_reverse_fluxIntegral_eq_zero (X Y : ℍ → ℂ)
    (C : ComplexBoundaryChain) :
    fluxIntegral X Y (C ++ C.reverse) = 0 := by
  rw [fluxIntegral_append, fluxIntegral_reverse]
  exact add_neg_cancel _

end ComplexBoundaryChain

/-! #### One smooth rectangular tile -/

/-- Counterclockwise flux integral around the boundary of a Cartesian
rectangle.  The four terms are respectively top, bottom, right, and left. -/
noncomputable def rectangleFluxBoundaryIntegral
    (X Y : ℝ × ℝ → ℂ) (a b : ℝ × ℝ) : ℂ :=
  ((∫ x in a.1..b.1, Y (x, b.2)) -
      ∫ x in a.1..b.1, Y (x, a.2)) +
    (∫ y in a.2..b.2, X (b.1, y)) -
      ∫ y in a.2..b.2, X (a.1, y)

/-- Green/divergence theorem on one smooth rectangular tile, exposed in the
same `X dy - Y dx` orientation convention as the modular flux API. -/
theorem rectangle_flux_stokes
    (X Y : ℝ × ℝ → ℂ)
    (DX DY : ℝ × ℝ → (ℝ × ℝ) →L[ℝ] ℂ)
    (a b : ℝ × ℝ) (hle : a ≤ b)
    (hXc : ContinuousOn X (Set.Icc a b))
    (hYc : ContinuousOn Y (Set.Icc a b))
    (hXd : ∀ z ∈ Set.Ioo a.1 b.1 ×ˢ Set.Ioo a.2 b.2,
      HasFDerivAt X (DX z) z)
    (hYd : ∀ z ∈ Set.Ioo a.1 b.1 ×ˢ Set.Ioo a.2 b.2,
      HasFDerivAt Y (DY z) z)
    (hInt : IntegrableOn
      (fun z => DX z (1, 0) + DY z (0, 1)) (Set.Icc a b)) :
    (∫ z in Set.Icc a b, DX z (1, 0) + DY z (0, 1)) =
      rectangleFluxBoundaryIntegral X Y a b := by
  simpa only [rectangleFluxBoundaryIntegral] using
    MeasureTheory.integral_divergence_prod_Icc_of_hasFDerivAt_of_le
      X Y DX DY a b hle hXc hYc hXd hYd hInt

/-- Half-open conventions are harmless once the two carriers are equal almost
everywhere.  This is the exact measure-theoretic interface consumed by a
finite-tile decomposition. -/
theorem setIntegral_congr_halfOpen
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℍ → E) {s t : Set ℍ}
    (hst : s =ᵐ[hyperbolicMeasure] t) :
    (∫ z in s, f z ∂hyperbolicMeasure) =
      ∫ z in t, f z ∂hyperbolicMeasure :=
  setIntegral_congr_set hst

end GammaTwoOrientedBoundaryIntegral

