/-! #### A. The actual fixed parameter `L²` target -/

/-- Lebesgue measure restricted to the standard closed horocycle parameter
interval.  Endpoints are retained; they are null and therefore do not alter
the `L²` class. -/
noncomputable abbrev selectedHorocycleParameterMeasure : Measure ℝ :=
  (volume : Measure ℝ).restrict
    (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))

/-- The genuine Hilbert target of every selected-cusp restriction. -/
noncomputable abbrev SelectedHorocycleL2 :=
  MeasureTheory.Lp ℂ 2 selectedHorocycleParameterMeasure

/-- The actual selected Möbius horocycle parametrization is continuous in
its real parameter. -/
theorem gammaTwoSelectedHorocycleParam_continuous
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Continuous (gammaTwoSelectedHorocycleParam q Y) := by
  have hcomplex : Continuous (fun t : ℝ =>
      (t : ℂ) + (gammaTwoCuspLevel Y : ℂ) * Complex.I) :=
    (Complex.continuous_ofReal.comp continuous_id).add continuous_const
  have hbase' : Continuous (fun t : ℝ =>
      (⟨(t : ℂ) + (gammaTwoCuspLevel Y : ℂ) * Complex.I,
        lt_of_lt_of_le zero_lt_one
          (by simpa using one_le_gammaTwoCuspLevel Y)⟩ : ℍ)) :=
    hcomplex.subtype_mk _
  have hbase : Continuous (fun t : ℝ =>
      (⟨Complex.mk t (gammaTwoCuspLevel Y),
        lt_of_lt_of_le zero_lt_one
          (by simpa using one_le_gammaTwoCuspLevel Y)⟩ : ℍ)) :=
    hbase'.congr (fun t => by
      apply Subtype.ext
      apply Complex.ext <;> simp)
  exact (continuous_sl2z_smul (gammaTwoCosetRep q)).comp hbase

/-- Squared geometric trace weight.  The numerator is the invariant
Hermitian fiber scale at the actual selected point and the denominator is
the local cusp height, because hyperbolic horocycle length is `dt / H`. -/
noncomputable def selectedCuspTraceWeightSq
    (n : ℤ) (q : GammaTwoRightCoset) (Y t : ℝ) : ℝ :=
  weightFiberScale (-paperOrbitExponent n)
      (gammaTwoSelectedHorocycleParam q Y t) /
    gammaTwoCuspLevel Y

/-- Positive square root of the geometric trace weight. -/
noncomputable def selectedCuspTraceWeight
    (n : ℤ) (q : GammaTwoRightCoset) (Y t : ℝ) : ℝ :=
  Real.sqrt (selectedCuspTraceWeightSq n q Y t)

theorem selectedCuspTraceWeightSq_pos
    (n : ℤ) (q : GammaTwoRightCoset) (Y t : ℝ) :
    0 < selectedCuspTraceWeightSq n q Y t := by
  exact div_pos
    (weightFiberScale_pos (-paperOrbitExponent n)
      (gammaTwoSelectedHorocycleParam q Y t))
    (lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y))

theorem selectedCuspTraceWeight_pos
    (n : ℤ) (q : GammaTwoRightCoset) (Y t : ℝ) :
    0 < selectedCuspTraceWeight n q Y t := by
  exact Real.sqrt_pos.2 (selectedCuspTraceWeightSq_pos n q Y t)

theorem selectedCuspTraceWeight_sq
    (n : ℤ) (q : GammaTwoRightCoset) (Y t : ℝ) :
    selectedCuspTraceWeight n q Y t ^ 2 =
      selectedCuspTraceWeightSq n q Y t := by
  exact Real.sq_sqrt (selectedCuspTraceWeightSq_pos n q Y t).le

theorem selectedCuspTraceWeight_continuous
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    Continuous (selectedCuspTraceWeight n q Y) := by
  unfold selectedCuspTraceWeight selectedCuspTraceWeightSq
  apply Real.continuous_sqrt.comp
  exact
    ((continuous_weightFiberScale
        (k := -paperOrbitExponent n)).comp
      (gammaTwoSelectedHorocycleParam_continuous q Y)).div_const
      (gammaTwoCuspLevel Y)

/-! #### B. Smooth-core restriction and square integrability -/

/-- Literal weighted restriction of a fixed-phase smooth core vector to one
selected cusp horocycle. -/
noncomputable def selectedCuspRestrictionRepresentative
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) : ℝ → ℂ :=
  fun t =>
    ((selectedCuspTraceWeight n q Y t : ℝ) : ℂ) *
      ((u : SmoothQuotientCompactFunction)
        (gammaTwoSelectedHorocycleParam q Y t))

@[simp]
theorem selectedCuspRestrictionRepresentative_add
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u v : InverseEtaFixedPhaseCore n) :
    selectedCuspRestrictionRepresentative n q Y (u + v) =
      selectedCuspRestrictionRepresentative n q Y u +
        selectedCuspRestrictionRepresentative n q Y v := by
  funext t
  change
    (selectedCuspTraceWeight n q Y t : ℂ) *
        (((u : SmoothQuotientCompactFunction)
          (gammaTwoSelectedHorocycleParam q Y t)) +
         ((v : SmoothQuotientCompactFunction)
          (gammaTwoSelectedHorocycleParam q Y t))) = _
  ring

@[simp]
theorem selectedCuspRestrictionRepresentative_smul
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) (c : ℂ)
    (u : InverseEtaFixedPhaseCore n) :
    selectedCuspRestrictionRepresentative n q Y (c • u) =
      c • selectedCuspRestrictionRepresentative n q Y u := by
  funext t
  change
    (selectedCuspTraceWeight n q Y t : ℂ) *
        (c * ((u : SmoothQuotientCompactFunction)
          (gammaTwoSelectedHorocycleParam q Y t))) =
      c * ((selectedCuspTraceWeight n q Y t : ℂ) *
        ((u : SmoothQuotientCompactFunction)
          (gammaTwoSelectedHorocycleParam q Y t)))
  ring

theorem selectedCuspRestrictionRepresentative_continuous
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    Continuous (selectedCuspRestrictionRepresentative n q Y u) := by
  exact
    (Complex.continuous_ofReal.comp
      (selectedCuspTraceWeight_continuous n q Y)).mul
      ((u : SmoothQuotientCompactFunction).1.2.continuous.comp
        (gammaTwoSelectedHorocycleParam_continuous q Y))

/-- Every actual smooth-core restriction belongs to the fixed target `L²`.
The proof uses continuity on the compact parameter interval, not a global
boundedness assertion. -/
theorem selectedCuspRestrictionRepresentative_memLp
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    MemLp (selectedCuspRestrictionRepresentative n q Y u) 2
      selectedHorocycleParameterMeasure := by
  let f := selectedCuspRestrictionRepresentative n q Y u
  have hf : Continuous f :=
    selectedCuspRestrictionRepresentative_continuous n q Y u
  apply (memLp_two_iff_integrable_sq_norm
    hf.aestronglyMeasurable).2
  change IntegrableOn (fun x => ‖f x‖ ^ 2)
    (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) volume
  simpa only [Pi.pow_apply] using
    (hf.norm.pow 2).continuousOn.integrableOn_Icc

/-- The actual complex-linear smooth-core trace map. -/
noncomputable def selectedCuspCoreTrace
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] SelectedHorocycleL2 where
  toFun u :=
    (selectedCuspRestrictionRepresentative_memLp n q Y u).toLp
      (selectedCuspRestrictionRepresentative n q Y u)
  map_add' u v := by
    simpa only [selectedCuspRestrictionRepresentative_add] using
      (MemLp.toLp_add
        (selectedCuspRestrictionRepresentative_memLp n q Y u)
        (selectedCuspRestrictionRepresentative_memLp n q Y v))
  map_smul' c u := by
    simpa only [selectedCuspRestrictionRepresentative_smul,
      RingHom.id_apply] using
      (MemLp.toLp_const_smul c
        (selectedCuspRestrictionRepresentative_memLp n q Y u))

/-- The `L²` class retains the literal selected-horocycle representative. -/
theorem coeFn_selectedCuspCoreTrace
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ⇑(selectedCuspCoreTrace n q Y u) =ᵐ[
      selectedHorocycleParameterMeasure]
        selectedCuspRestrictionRepresentative n q Y u := by
  simpa only [selectedCuspCoreTrace] using
    MemLp.coeFn_toLp
      (selectedCuspRestrictionRepresentative_memLp n q Y u)

/-! #### C. Exact compact-support tail, including all corners -/

/-- Every standard horizontal point with parameter in `[-1/2,1/2]` and
height at least one lies in the closed modular tile. -/
theorem baseSelectedHorocyclePoint_mem_fd
    (Y : ℝ) {t : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    (⟨Complex.mk t (gammaTwoCuspLevel Y),
      lt_of_lt_of_le zero_lt_one
        (one_le_gammaTwoCuspLevel Y)⟩ : ℍ) ∈ ModularGroup.fd := by
  change 1 ≤ Complex.normSq
      (Complex.mk t (gammaTwoCuspLevel Y)) ∧
    |t| ≤ (1 : ℝ) / 2
  constructor
  · simp only [Complex.normSq_apply]
    have hlevel : 1 ≤ gammaTwoCuspLevel Y :=
      one_le_gammaTwoCuspLevel Y
    have hprod : 0 ≤
        (gammaTwoCuspLevel Y - 1) *
          (gammaTwoCuspLevel Y + 1) :=
      mul_nonneg (sub_nonneg.mpr hlevel) (by linarith)
    nlinarith [sq_nonneg t]
  · exact abs_le.mpr ht

/-- Hence every selected parameter point in the standard interval belongs
to the actual six-tile closed carrier. -/
theorem selectedHorocycleParam_mem_closedCarrier
    (q : GammaTwoRightCoset) (Y : ℝ) {t : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    gammaTwoSelectedHorocycleParam q Y t ∈
      gammaTwoClosedTileCarrier := by
  exact mem_gammaTwoClosedTileCarrier_iff.mpr
    ⟨q,
      ⟨Complex.mk t (gammaTwoCuspLevel Y),
        lt_of_lt_of_le zero_lt_one
          (one_le_gammaTwoCuspLevel Y)⟩,
      baseSelectedHorocyclePoint_mem_fd Y ht, rfl⟩

theorem selectedHorocycleParam_mem_threeCuspBoundary
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    gammaTwoSelectedHorocycleParam q Y t ∈
      gammaTwoThreeCuspHorocycleBoundary Y := by
  rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
  exact Set.mem_iUnion.mpr ⟨q, by
    simpa only [gammaTwoSelectedHorocycleCurve] using
      gammaTwoSelectedHorocycleParam_mem q Y t⟩

/-- Quotient compactness of one scalar function already gives a literal
three-cusp zero tail; no flux-invariance hypothesis is needed. -/
theorem hasZeroThreeCuspTail_self_zero_of_quotientCompact
    {f : ℍ → ℂ} (hf : HasQuotientCompactSupport f) :
    HasZeroThreeCuspTail f 0 := by
  let K : Set GammaTwoQuotient := quotientTSupport f
  have hLift : IsCompact
      (gammaTwoClosedTileCarrier ∩ gammaTwoQuotientMk ⁻¹' K) :=
    gammaTwoClosedCarrierCompactPreimage K hf
  obtain ⟨Y₀, hY₀, hsub⟩ :=
    compact_closedTileCarrier_subset_threeCuspTruncation hLift
      Set.inter_subset_left
  refine ⟨Y₀, hY₀, ?_⟩
  intro z hz
  constructor
  · by_contra hfz
    have hq : gammaTwoQuotientMk z ∈ quotientTSupport f :=
      subset_closure ⟨z, hfz, rfl⟩
    exact hz.2 (hsub ⟨hz.1, hq⟩)
  · rfl

/-- Each actual fixed-phase core vector therefore vanishes identically in
all three sufficiently high cusp ends. -/
theorem fixedPhaseCore_hasZeroThreeCuspTail
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    HasZeroThreeCuspTail
      (((u : SmoothQuotientCompactFunction) : ℍ → ℂ)) 0 :=
  hasZeroThreeCuspTail_self_zero_of_quotientCompact
    (u : SmoothQuotientCompactFunction).2

/-- The literal restriction representative is zero almost everywhere on
every sufficiently high selected horocycle.  The `a.e.` qualifier is only
because the fixed `L²` measure is restricted to the parameter interval;
vanishing on that interval is pointwise, including both endpoints. -/
theorem fixedPhaseCore_eventually_selectedCuspRepresentative_ae_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Z : ℝ, Y₀ < Z → ∀ q : GammaTwoRightCoset,
        selectedCuspRestrictionRepresentative n q Z u =ᵐ[
          selectedHorocycleParameterMeasure] 0 := by
  rcases (fixedPhaseCore_hasZeroThreeCuspTail n u)
      .eventually_zero_on_horocycleBoundary with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Z hYZ q
  filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
  have hz := hZero Z hYZ
    (gammaTwoSelectedHorocycleParam q Z t)
    ⟨selectedHorocycleParam_mem_closedCarrier q Z ht,
      selectedHorocycleParam_mem_threeCuspBoundary q Z t⟩
    simp only [selectedCuspRestrictionRepresentative, Pi.zero_apply,
      hz.1, mul_zero]

/-- Pointwise version of the same compact tail on the closed parameter
interval.  This is used for each vertical log-height slice before integrating
in the horizontal parameter. -/
theorem fixedPhaseCore_eventually_selectedCuspSection_eq_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Z : ℝ, Y₀ < Z → ∀ q : GammaTwoRightCoset,
        ∀ t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
          ((u : SmoothQuotientCompactFunction)
            (gammaTwoSelectedHorocycleParam q Z t)) = 0 := by
  rcases (fixedPhaseCore_hasZeroThreeCuspTail n u)
      .eventually_zero_on_horocycleBoundary with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Z hYZ q t ht
  exact (hZero Z hYZ (gammaTwoSelectedHorocycleParam q Z t)
    ⟨selectedHorocycleParam_mem_closedCarrier q Z ht,
      selectedHorocycleParam_mem_threeCuspBoundary q Z t⟩).1

/-- Consequently the genuine smooth-core `L²` trace is exactly zero past a
single support height, simultaneously for every selected cusp chart. -/
theorem fixedPhaseCore_eventually_selectedCuspCoreTrace_eq_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Z : ℝ, Y₀ < Z → ∀ q : GammaTwoRightCoset,
        selectedCuspCoreTrace n q Z u = 0 := by
  rcases fixedPhaseCore_eventually_selectedCuspRepresentative_ae_zero n u with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Z hYZ q
  apply MeasureTheory.Lp.ext
  filter_upwards [coeFn_selectedCuspCoreTrace n q Z u,
    hZero Z hYZ q] with t htrace hrep
  simpa using htrace.trans hrep

/-- The existing compact-core Green flux theorem is the bilinear boundary
counterpart of the individual trace vanishing theorem above. -/
theorem compactCoreGreenFlux_eventually_selectedHorocycle_eq_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ (Z : ℝ), Y₀ < Z →
        ∀ (q : GammaTwoRightCoset) (a b : ℝ) (ξ : ℝ → ℂ),
          (∀ t ∈ Set.Icc a b,
            gammaTwoSelectedHorocycleParam q Z t ∈
              gammaTwoClosedTileCarrier) →
          (∫ t in Set.Icc a b,
            fluxOneFormValue
              (fixedPhaseGreenFluxX n u v) (fixedPhaseGreenFluxY n u v)
              (gammaTwoSelectedHorocycleParam q Z t) (ξ t)) = 0 :=
  fixedPhaseGreenFlux_eventually_selectedHorocycle_integral_eq_zero
    n u v

/-! #### D. The unconditional one-dimensional and operator algebra -/

/-- Compact support plus one-dimensional FTC controls a boundary value by
the derivative on its entire right tail.  This is the precise scalar step
used in a cusp trace proof; it does not by itself assert an `L²` trace bound. -/
theorem compactSupport_norm_le_integral_Ioi_deriv
    {f : ℝ → ℂ} (hf : ContDiff ℝ 1 f)
    (hcompact : HasCompactSupport f) (H : ℝ) :
    ‖f H‖ ≤ ∫ y in Set.Ioi H, ‖deriv f y‖ := by
  calc
    ‖f H‖ = ‖-f H‖ := by rw [norm_neg]
    _ = ‖∫ y in Set.Ioi H, deriv f y‖ := by
      rw [hcompact.integral_Ioi_deriv_eq hf H]
    _ ≤ ∫ y in Set.Ioi H, ‖deriv f y‖ :=
      norm_integral_le_integral_norm _

/-! The preceding vector-valued FTC estimate is deliberately split into the
two scalar inequalities actually used by a cusp-strip argument.  Keeping
these lemmas independent of the automorphic coordinates makes the analytic
constant completely transparent. -/

open scoped RealInnerProductSpace

/-- Exact derivative of the height-weighted squared norm of a complex-valued
one-dimensional slice. -/
theorem deriv_height_mul_normSq
    {f : ℝ → ℂ} (hf : Differentiable ℝ f) (y : ℝ) :
    deriv (fun r : ℝ => r * ‖f r‖ ^ 2) y =
      ‖f y‖ ^ 2 + 2 * y * ⟪f y, deriv f y⟫_ℝ := by
  have hnorm := (hf y).hasDerivAt.norm_sq
  have hprod := (hasDerivAt_id y).mul hnorm
  simpa only [one_mul] using hprod.deriv

/-- Pointwise Young inequality for the preceding derivative.  On the positive
height axis it costs exactly two copies of the base density and one copy of
the logarithmic vertical-derivative density. -/
theorem norm_deriv_height_mul_normSq_le
    {f : ℝ → ℂ} (hf : Differentiable ℝ f) {y : ℝ} (hy : 0 ≤ y) :
    ‖deriv (fun r : ℝ => r * ‖f r‖ ^ 2) y‖ ≤
      2 * ‖f y‖ ^ 2 + y ^ 2 * ‖deriv f y‖ ^ 2 := by
  rw [deriv_height_mul_normSq hf y, Real.norm_eq_abs]
  have hinner : |⟪f y, deriv f y⟫_ℝ| ≤
      ‖f y‖ * ‖deriv f y‖ :=
    abs_real_inner_le_norm _ _
  calc
    |‖f y‖ ^ 2 + 2 * y * ⟪f y, deriv f y⟫_ℝ| ≤
        |‖f y‖ ^ 2| + |2 * y * ⟪f y, deriv f y⟫_ℝ| :=
      abs_add _ _
    _ = ‖f y‖ ^ 2 + (2 * y) * |⟪f y, deriv f y⟫_ℝ| := by
      rw [abs_of_nonneg (sq_nonneg _), abs_mul,
        abs_of_nonneg (mul_nonneg (by norm_num) hy)]
    _ ≤ ‖f y‖ ^ 2 + (2 * y) *
        (‖f y‖ * ‖deriv f y‖) := by
      exact add_le_add_left
        (mul_le_mul_of_nonneg_left hinner
          (mul_nonneg (by norm_num) hy)) _
    _ ≤ 2 * ‖f y‖ ^ 2 + y ^ 2 * ‖deriv f y‖ ^ 2 := by
      nlinarith [sq_nonneg (‖f y‖ - y * ‖deriv f y‖)]

/-- A fully unconditional one-dimensional weighted trace estimate.  This is
the scalar analytic core of the horocycle trace theorem: no Sobolev trace
operator, compact embedding, or boundary certificate is assumed. -/
theorem compactSupport_height_mul_normSq_le_energy_Ioi
    {f : ℝ → ℂ} (hf : ContDiff ℝ 1 f)
    (hcompact : HasCompactSupport f) {H : ℝ} (hH : 1 ≤ H) :
    H * ‖f H‖ ^ 2 ≤
      ∫ y in Set.Ioi H,
        (2 * ‖f y‖ ^ 2 + y ^ 2 * ‖deriv f y‖ ^ 2) := by
  let weighted : ℝ → ℝ := fun y => y * ‖f y‖ ^ 2
  let energy : ℝ → ℝ := fun y =>
    2 * ‖f y‖ ^ 2 + y ^ 2 * ‖deriv f y‖ ^ 2
  have hnormSq : HasCompactSupport (fun y : ℝ => ‖f y‖ ^ 2) := by
    simpa only [pow_two] using hcompact.norm.mul hcompact.norm
  have hderivNormSq :
      HasCompactSupport (fun y : ℝ => ‖deriv f y‖ ^ 2) := by
    simpa only [pow_two] using
      hcompact.deriv.norm.mul hcompact.deriv.norm
  have hweightedCompact : HasCompactSupport weighted := by
    simpa only [weighted, Pi.mul_apply] using
      hnormSq.mul_left (f := fun y : ℝ => y)
  have hfirstCompact :
      HasCompactSupport (fun y : ℝ => 2 * ‖f y‖ ^ 2) := by
    simpa only [Pi.mul_apply] using
      hnormSq.mul_left (f := fun _y : ℝ => (2 : ℝ))
  have hsecondCompact :
      HasCompactSupport (fun y : ℝ => y ^ 2 * ‖deriv f y‖ ^ 2) := by
    simpa only [Pi.mul_apply] using
      hderivNormSq.mul_left (f := fun y : ℝ => y ^ 2)
  have henergyCompact : HasCompactSupport energy := by
    exact hfirstCompact.add hsecondCompact
  have hweightedSmooth : ContDiff ℝ 1 weighted := by
    exact contDiff_id.mul (hf.norm_sq ℂ)
  have henergyContinuous : Continuous energy := by
    exact
      (continuous_const.mul (hf.continuous.norm.pow 2)).add
        ((continuous_id.pow 2).mul
          (hf.continuous_deriv_one.norm.pow 2))
  have hderivWeightedIntegrable :
      Integrable (fun y : ℝ => ‖deriv weighted y‖) :=
    (hweightedSmooth.continuous_deriv_one.norm).integrable_of_hasCompactSupport hweightedCompact.deriv.norm
  have henergyIntegrable : Integrable energy :=
    henergyContinuous.integrable_of_hasCompactSupport henergyCompact
  have hFTC : ‖weighted H‖ ≤
      ∫ y in Set.Ioi H, ‖deriv weighted y‖ := by
    calc
      ‖weighted H‖ = ‖-weighted H‖ := by rw [norm_neg]
      _ = ‖∫ y in Set.Ioi H, deriv weighted y‖ := by
        rw [hweightedCompact.integral_Ioi_deriv_eq
          hweightedSmooth H]
      _ ≤ ∫ y in Set.Ioi H, ‖deriv weighted y‖ :=
        norm_integral_le_integral_norm _
  have hmono :
      (∫ y in Set.Ioi H, ‖deriv weighted y‖) ≤
        ∫ y in Set.Ioi H, energy y := by
    apply setIntegral_mono_on
      hderivWeightedIntegrable.integrableOn
      henergyIntegrable.integrableOn measurableSet_Ioi
    intro y hy
    exact norm_deriv_height_mul_normSq_le
      (hf.differentiable (by norm_num)) (le_of_lt hy)
  have hH0 : 0 ≤ H := zero_le_one.trans hH
  calc
    H * ‖f H‖ ^ 2 = ‖weighted H‖ := by
      simp only [weighted, Real.norm_eq_abs, abs_mul,
        abs_of_nonneg hH0, abs_of_nonneg (sq_nonneg _)]
    _ ≤ ∫ y in Set.Ioi H, ‖deriv weighted y‖ := hFTC
    _ ≤ ∫ y in Set.Ioi H, energy y := hmono

/-- Fubini-ready scalar strip estimate.  All integrability assumptions here
are ordinary Bochner hypotheses; the pointwise trace estimate itself is the
unconditional theorem above. -/
theorem compactSupport_scalarStrip_trace_le_iteratedEnergy
    (f : ℝ → ℝ → ℂ) {H : ℝ} (hH : 1 ≤ H)
    (hsmooth : ∀ t, ContDiff ℝ 1 (f t))
    (hcompact : ∀ t, HasCompactSupport (f t))
    (htrace : IntegrableOn (fun t => H * ‖f t H‖ ^ 2)
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)))
    (henergy : IntegrableOn (fun t =>
        ∫ y in Set.Ioi H,
          (2 * ‖f t y‖ ^ 2 + y ^ 2 * ‖deriv (f t) y‖ ^ 2))
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))) :
    (∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        H * ‖f t H‖ ^ 2) ≤
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ∫ y in Set.Ioi H,
          (2 * ‖f t y‖ ^ 2 + y ^ 2 * ‖deriv (f t) y‖ ^ 2) := by
  apply setIntegral_mono_on htrace henergy measurableSet_Icc
  intro t _ht
  exact compactSupport_height_mul_normSq_le_energy_Ioi
    (hsmooth t) (hcompact t) hH

/-- Unweighted squared-norm derivative estimate.  This is the log-height
version of the preceding Young inequality. -/
theorem norm_deriv_normSq_le_energy
    {f : ℝ → ℂ} (hf : Differentiable ℝ f) (r : ℝ) :
    ‖deriv (fun s : ℝ => ‖f s‖ ^ 2) r‖ ≤
      ‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2 := by
  have hderiv := ((hf r).hasDerivAt.norm_sq).deriv
  rw [hderiv, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have hinner := abs_real_inner_le_norm (f r) (deriv f r)
  calc
    2 * |⟪f r, deriv f r⟫_ℝ| ≤
        2 * (‖f r‖ * ‖deriv f r‖) := by
      exact mul_le_mul_of_nonneg_left hinner (by norm_num)
    _ ≤ ‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2 := by
      nlinarith [sq_nonneg (‖f r‖ - ‖deriv f r‖)]

/-- Right-tail FTC estimate requiring only convergence to zero at `+∞` and
integrability on the tail.  Unlike a global compact-support lemma, this form
is directly applicable to a log-height cusp slice, whose behaviour below the
chosen truncation height is irrelevant. -/
theorem tendsto_zero_normSq_le_energy_Ioi
    {f : ℝ → ℂ} (hf : ContDiff ℝ 1 f) {r₀ : ℝ}
    (hzero : Filter.Tendsto f Filter.atTop (nhds 0))
    (henergy : IntegrableOn
      (fun r => ‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2) (Set.Ioi r₀)) :
    ‖f r₀‖ ^ 2 ≤
      ∫ r in Set.Ioi r₀, (‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2) := by
  let g : ℝ → ℝ := fun r => ‖f r‖ ^ 2
  have hgSmooth : ContDiff ℝ 1 g := hf.norm_sq ℂ
  have hgDerivMeasurable : AEStronglyMeasurable
      (fun r => ‖deriv g r‖) ((volume : Measure ℝ).restrict (Set.Ioi r₀)) :=
    (hgSmooth.continuous_deriv_one.norm.aestronglyMeasurable).mono_measure Measure.restrict_le_self
  have hgDerivIntegrable : IntegrableOn (fun r => ‖deriv g r‖)
      (Set.Ioi r₀) := by
    apply Integrable.mono henergy hgDerivMeasurable
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with r hr
    exact norm_deriv_normSq_le_energy
      (hf.differentiable (by norm_num)) r
  have hgDerivIntegrable' : IntegrableOn (deriv g) (Set.Ioi r₀) := by
    apply (integrable_norm_iff
      ((hgSmooth.continuous_deriv_one.aestronglyMeasurable).mono_measure Measure.restrict_le_self)).mp
    exact hgDerivIntegrable
  have hgzero : Filter.Tendsto g Filter.atTop (nhds 0) := by
    simpa only [g, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0)] using
      hzero.norm.pow 2
  have hFTC : (∫ r in Set.Ioi r₀, deriv g r) = -g r₀ := by
    simpa only [zero_sub] using
      integral_Ioi_of_hasDerivAt_of_tendsto'
        (f := g) (f' := deriv g) (m := 0)
        (fun r _hr =>
          (hgSmooth.differentiable (by norm_num) r).hasDerivAt)
        hgDerivIntegrable' hgzero
  calc
    ‖f r₀‖ ^ 2 = ‖g r₀‖ := by
      simp only [g, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    _ = ‖∫ r in Set.Ioi r₀, deriv g r‖ := by
      rw [hFTC, norm_neg]
    _ ≤ ∫ r in Set.Ioi r₀, ‖deriv g r‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ r in Set.Ioi r₀,
        (‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2) := by
      apply setIntegral_mono_on hgDerivIntegrable henergy measurableSet_Ioi
      intro r _hr
      exact norm_deriv_normSq_le_energy
        (hf.differentiable (by norm_num)) r

/-- A `C¹` function which is literally zero sufficiently far to the right has
integrable one-dimensional `H¹` energy on every right tail. -/
theorem eventuallyEq_zero_energy_integrableOn_Ioi
    {f : ℝ → ℂ} (hf : ContDiff ℝ 1 f)
    (hzero : f =ᶠ[Filter.atTop] 0) (r₀ : ℝ) :
    IntegrableOn (fun r => ‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2)
      (Set.Ioi r₀) := by
  rcases (eventually_atTop.1 hzero) with ⟨B₀, hB₀⟩
  let B : ℝ := max B₀ r₀
  have hrB : r₀ ≤ B := le_max_right _ _
  have hzeroB : ∀ r, B ≤ r → f r = 0 := by
    intro r hr
    exact hB₀ r ((le_max_left _ _).trans hr)
  let e : ℝ → ℝ := fun r => ‖f r‖ ^ 2 + ‖deriv f r‖ ^ 2
  have heContinuous : Continuous e :=
    (hf.continuous.norm.pow 2).add
      (hf.continuous_deriv_one.norm.pow 2)
  have hleft : IntegrableOn e (Set.Ioc r₀ B) := by
    exact heContinuous.continuousOn.integrableOn_Icc.mono_set
      Set.Ioc_subset_Icc_self
  have heZero : ∀ r ∈ Set.Ioi B, e r = 0 := by
    intro r hr
    have hfLocal : f =ᶠ[nhds r] 0 := by
      filter_upwards [isOpen_Ioi.mem_nhds hr] with s hs
      exact hzeroB s (le_of_lt hs)
    have hdf : deriv f r = 0 := by
      simpa using hfLocal.deriv_eq
    simp only [e, hzeroB r (le_of_lt hr), hdf, norm_zero,
      zero_pow (by norm_num : (2 : ℕ) ≠ 0), zero_add]
  have hright : IntegrableOn e (Set.Ioi B) := by
    apply integrableOn_zero.congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with r hr
    exact (heZero r hr).symm
  have hunion : Set.Ioc r₀ B ∪ Set.Ioi B = Set.Ioi r₀ := by
    ext r
    constructor
    · intro hr
      rcases hr with hr | hr
      · exact hr.1
      · exact hrB.trans_lt hr
    · intro hr
      by_cases hle : r ≤ B
      · exact Or.inl ⟨hr, hle⟩
      · exact Or.inr (lt_of_not_ge hle)
  rw [← hunion]
  exact hleft.union hright

/-- Exact recovery of the raw vertical derivative from the raising,
lowering, and base coordinates. -/
theorem dy_eq_half_raiseRaw_add_lowerRaw_div_sub_base
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    dy f z =
      (1 / 2 : ℂ) *
        (raiseRaw a f z + lowerRaw a f z / heightC z ^ 2 -
          physicalExponent a / heightC z * f z) := by
  have hz : heightC z ≠ 0 := heightC_ne_zero z
  unfold raiseRaw lowerRaw
  field_simp [hz]
  ring

/-- Norm-level form of the same reconstruction.  This is the exact
pointwise triangle estimate required before inserting Petersson weights. -/
theorem norm_dy_le_half_raise_lower_base
    (a : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    ‖dy f z‖ ≤
      (‖raiseRaw a f z‖ +
        ‖lowerRaw a f z / heightC z ^ 2‖ +
        ‖physicalExponent a / heightC z * f z‖) / 2 := by
  rw [dy_eq_half_raiseRaw_add_lowerRaw_div_sub_base]
  have htri :
      ‖raiseRaw a f z + lowerRaw a f z / heightC z ^ 2 -
          physicalExponent a / heightC z * f z‖ ≤
        ‖raiseRaw a f z‖ +
          ‖lowerRaw a f z / heightC z ^ 2‖ +
          ‖physicalExponent a / heightC z * f z‖ := by
    calc
      ‖raiseRaw a f z + lowerRaw a f z / heightC z ^ 2 -
          physicalExponent a / heightC z * f z‖ =
          ‖(raiseRaw a f z + lowerRaw a f z / heightC z ^ 2) +
            -(physicalExponent a / heightC z * f z)‖ := by ring_nf
      _ ≤ ‖raiseRaw a f z + lowerRaw a f z / heightC z ^ 2‖ +
          ‖-(physicalExponent a / heightC z * f z)‖ :=
        norm_add_le _ _
      _ ≤ (‖raiseRaw a f z‖ +
          ‖lowerRaw a f z / heightC z ^ 2‖) +
          ‖-(physicalExponent a / heightC z * f z)‖ :=
        add_le_add_right (norm_add_le _ _) _
      _ = ‖raiseRaw a f z‖ +
          ‖lowerRaw a f z / heightC z ^ 2‖ +
          ‖physicalExponent a / heightC z * f z‖ := by simp
  calc
    ‖(1 / 2 : ℂ) *
        (raiseRaw a f z + lowerRaw a f z / heightC z ^ 2 -
          physicalExponent a / heightC z * f z)‖ =
        (1 / 2 : ℝ) *
          ‖raiseRaw a f z + lowerRaw a f z / heightC z ^ 2 -
            physicalExponent a / heightC z * f z‖ := by
      rw [norm_mul]
      norm_num
    _ ≤ (1 / 2 : ℝ) *
        (‖raiseRaw a f z‖ +
          ‖lowerRaw a f z / heightC z ^ 2‖ +
          ‖physicalExponent a / heightC z * f z‖) := by
      exact mul_le_mul_of_nonneg_left htri (by norm_num)
    _ = (‖raiseRaw a f z‖ +
        ‖lowerRaw a f z / heightC z ^ 2‖ +
        ‖physicalExponent a / heightC z * f z‖) / 2 := by ring

/-- Predecessor form of the Euclidean gauge exponent. -/
theorem euclideanGaugeExponent_pred (n : ℤ) :
    euclideanGaugeExponent (n - 1) =
      euclideanGaugeExponent n - 1 := by
  have h := euclideanGaugeExponent_succ (n - 1)
  rw [sub_add_cancel] at h
  linarith

/-- In the already constructed Euclidean Petersson gauge, adding raising at
index `n` to lowering from index `n` into its predecessor cancels the
horizontal derivative and all index dependence. -/
theorem euclideanRaiseGauge_add_lowerPredGauge
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    euclideanRaiseGauge n f z +
        euclideanLowerFromSuccGauge (n - 1) f z =
      2 * heightC z * dy f z + 2 * f z := by
  unfold euclideanRaiseGauge euclideanLowerFromSuccGauge
  rw [euclideanGaugeExponent_pred]
  push_cast
  ring

/-- Exact vertical reconstruction in the isometric Euclidean gauge.  This
is the clean algebraic bridge used by the remaining Fubini/strip estimate. -/
theorem height_mul_dy_eq_half_euclideanRaise_add_lower_sub
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    heightC z * dy f z =
      (1 / 2 : ℂ) *
        (euclideanRaiseGauge n f z +
          euclideanLowerFromSuccGauge (n - 1) f z) - f z := by
  rw [euclideanRaiseGauge_add_lowerPredGauge]
  ring

/-- Direct predecessor-index form of Euclidean gauge conjugation for the
actual lowering map used by the graph coordinate. -/
theorem fixedPhaseEuclideanGauge_lower_pred
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    fixedPhaseEuclideanGauge (n - 1)
        (InverseEtaFixedPhaseCore.lower n u) z =
      euclideanLowerFromSuccGauge (n - 1)
        (fixedPhaseEuclideanGauge n u) z := by
  have hScale := euclideanGaugeScale_succ (n - 1) z
  have hExponent := euclideanGaugeExponent_succ (n - 1)
  rw [sub_add_cancel] at hScale hExponent
  simp only [fixedPhaseEuclideanGauge_apply,
    InverseEtaFixedPhaseCore.lower_apply]
  unfold euclideanLowerFromSuccGauge lowerRaw
  rw [dx_fixedPhaseEuclideanGauge,
    dy_fixedPhaseEuclideanGauge,
    hScale, hExponent,
    complex_rpow_derivative_eq_div]
  have hz : heightC z ≠ 0 :=
    Complex.ofReal_ne_zero.mpr z.im_ne_zero
  field_simp [hz]
  ring

/-- The complementary difference of the same two graph coordinates recovers
the horizontal logarithmic derivative. -/
theorem euclideanRaiseGauge_sub_lowerPredGauge
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    euclideanRaiseGauge n f z -
        euclideanLowerFromSuccGauge (n - 1) f z =
      2 * Complex.I * heightC z * dx f z +
        ((2 * (euclideanGaugeExponent n + 1) : ℝ) : ℂ) * f z := by
  unfold euclideanRaiseGauge euclideanLowerFromSuccGauge
  rw [euclideanGaugeExponent_pred]
  push_cast
  ring

/-- Exact horizontal reconstruction in the Euclidean graph gauge. -/
theorem height_mul_dx_eq_negI_half_raise_sub_lower_sub
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    heightC z * dx f z =
      (-Complex.I / 2) *
        (euclideanRaiseGauge n f z -
          euclideanLowerFromSuccGauge (n - 1) f z -
          ((2 * (euclideanGaugeExponent n + 1) : ℝ) : ℂ) * f z) := by
  rw [euclideanRaiseGauge_sub_lowerPredGauge]
  ring

/-- Absolute size of the zero-order drift in the horizontal reconstruction. -/
noncomputable def euclideanHorizontalDrift (n : ℤ) : ℝ :=
  |2 * (euclideanGaugeExponent n + 1)|

theorem euclideanHorizontalDrift_nonneg (n : ℤ) :
    0 ≤ euclideanHorizontalDrift n := abs_nonneg _

/-- Norm estimate for the vertical logarithmic derivative in terms of the
three graph coordinates. -/
theorem norm_height_mul_dy_le_euclideanGraph
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    ‖heightC z * dy f z‖ ≤
      (‖euclideanRaiseGauge n f z‖ +
        ‖euclideanLowerFromSuccGauge (n - 1) f z‖) / 2 + ‖f z‖ := by
  rw [height_mul_dy_eq_half_euclideanRaise_add_lower_sub]
  let R := euclideanRaiseGauge n f z
  let L := euclideanLowerFromSuccGauge (n - 1) f z
  change ‖(1 / 2 : ℂ) * (R + L) - f z‖ ≤
    (‖R‖ + ‖L‖) / 2 + ‖f z‖
  calc
    ‖(1 / 2 : ℂ) * (R + L) - f z‖ ≤
        ‖(1 / 2 : ℂ) * (R + L)‖ + ‖f z‖ := norm_sub_le _ _
    _ = (1 / 2 : ℝ) * ‖R + L‖ + ‖f z‖ := by
      rw [norm_mul]
      norm_num
    _ ≤ (1 / 2 : ℝ) * (‖R‖ + ‖L‖) + ‖f z‖ := by
      gcongr
      exact norm_add_le _ _
    _ = (‖R‖ + ‖L‖) / 2 + ‖f z‖ := by ring

/-- Norm estimate for the horizontal logarithmic derivative. -/
theorem norm_height_mul_dx_le_euclideanGraph
    (n : ℤ) (f : ℍ → ℂ) (z : ℍ) :
    ‖heightC z * dx f z‖ ≤
      (‖euclideanRaiseGauge n f z‖ +
        ‖euclideanLowerFromSuccGauge (n - 1) f z‖ +
        euclideanHorizontalDrift n * ‖f z‖) / 2 := by
  rw [height_mul_dx_eq_negI_half_raise_sub_lower_sub]
  let R := euclideanRaiseGauge n f z
  let L := euclideanLowerFromSuccGauge (n - 1) f z
  let c : ℂ := ((2 * (euclideanGaugeExponent n + 1) : ℝ) : ℂ)
  have hc : ‖c‖ = euclideanHorizontalDrift n := by
    simp only [c, Complex.norm_real, euclideanHorizontalDrift]
  change ‖(-Complex.I / 2) * (R - L - c * f z)‖ ≤
    (‖R‖ + ‖L‖ + euclideanHorizontalDrift n * ‖f z‖) / 2
  rw [norm_mul, norm_div, norm_neg, Complex.norm_I, norm_ofNat, one_div]
  have hinside : ‖R - L - c * f z‖ ≤
      ‖R‖ + ‖L‖ + euclideanHorizontalDrift n * ‖f z‖ := by
    calc
      ‖R - L - c * f z‖ ≤ ‖R - L‖ + ‖c * f z‖ := norm_sub_le _ _
      _ ≤ (‖R‖ + ‖L‖) + ‖c * f z‖ := by
        exact add_le_add_right (norm_sub_le _ _) _
      _ = ‖R‖ + ‖L‖ + euclideanHorizontalDrift n * ‖f z‖ := by
        rw [norm_mul, hc]
  nlinarith

/-! #### E. Exact unitary pullback of a selected horocycle

For `φ_q(z) = gammaTwoCosetRep q • z`, conformality gives the Euclidean
unitary pullback factor

`s_q(z) = Im(φ_q(z)) / Im(z) = |det Dφ_q(z)|^(1/2)`.

The following definitions use the first quotient directly.  The key squared
norm identity is proved from `euclideanGaugeScale_sq`; it is therefore not an
assumed covariance statement for a coset representative outside `Γ(2)`. -/

/-- Complex-valued conformal scale of a selected Möbius chart.  It is in fact
positive real-valued, but the complex codomain lets it multiply the Euclidean
gauge without coercion noise. -/
noncomputable def selectedCosetConformalScaleC
    (q : GammaTwoRightCoset) (z : ℍ) : ℂ :=
  heightC (selectedCosetAction q z) / heightC z

theorem selectedCosetConformalScaleC_realSmooth
    (q : GammaTwoRightCoset) :
    RealSmooth (selectedCosetConformalScaleC q) := by
  have hnum : RealSmooth
      (fun z => heightC (selectedCosetAction q z)) :=
    RealSmooth.comp_selectedCosetAction realSmooth_heightC q
  have hdenInv : RealSmooth (fun z => (heightC z)⁻¹) :=
    realSmooth_heightC.inv (fun z => heightC_ne_zero z)
  simpa only [selectedCosetConformalScaleC, div_eq_mul_inv] using
    hnum.mul hdenInv

/-- The conformal scale is the inverse squared denominator norm. -/
theorem selectedCosetConformalScaleC_eq_inv_normSq_denom
    (q : GammaTwoRightCoset) (z : ℍ) :
    selectedCosetConformalScaleC q z =
      ((1 / Complex.normSq
        (UpperHalfPlane.denom (selectedCosetGL q) z) : ℝ) : ℂ) := by
  have him := UpperHalfPlane.im_smul_eq_div_normSq
    (gammaTwoCosetRep q) z
  unfold selectedCosetConformalScaleC selectedCosetAction selectedCosetGL
    heightC
  rw [him]
  simp only [Complex.ofReal_div, Complex.ofReal_one]

/-- Horizontal derivative of the conformal scale. -/
theorem dx_selectedCosetConformalScaleC
    (q : GammaTwoRightCoset) (z : ℍ) :
    dx (selectedCosetConformalScaleC q) z =
      selectedCosetB q z / heightC z := by
  let N : ℍ → ℂ := fun w => heightC (selectedCosetAction q w)
  let Dinv : ℍ → ℂ := fun w => (heightC w)⁻¹
  have hN : RealSmooth N := RealSmooth.comp_selectedCosetAction realSmooth_heightC q
  have hDinv : RealSmooth Dinv :=
    realSmooth_heightC.inv (fun w => heightC_ne_zero w)
  have hdxN : dx N z = selectedCosetB q z := by
    simpa only [N, dx_heightC, dy_heightC, mul_zero, mul_one,
      zero_add] using
        dx_comp_selectedCosetAction q realSmooth_heightC z
  have hdxDinv : dx Dinv z = 0 := by
    change d1 Dinv z 1 = 0
    rw [show d1 Dinv z 1 =
        -(d1 heightC z 1) / heightC z ^ 2 by
      simpa only [Dinv] using
        d1_inv realSmooth_heightC z 1 (heightC_ne_zero z),
      d1_heightC]
    simp
  have hfun : selectedCosetConformalScaleC q = N * Dinv := by
    funext w
    simp only [selectedCosetConformalScaleC, N, Dinv,
      Pi.mul_apply, div_eq_mul_inv]
  rw [hfun, dx_mul hN hDinv, hdxN, hdxDinv]
  simp only [mul_zero, add_zero, Dinv, div_eq_mul_inv]

/-- Vertical derivative of the conformal scale. -/
theorem dy_selectedCosetConformalScaleC
    (q : GammaTwoRightCoset) (z : ℍ) :
    dy (selectedCosetConformalScaleC q) z =
      selectedCosetA q z / heightC z -
        selectedCosetConformalScaleC q z / heightC z := by
  let N : ℍ → ℂ := fun w => heightC (selectedCosetAction q w)
  let Dinv : ℍ → ℂ := fun w => (heightC w)⁻¹
  have hN : RealSmooth N := RealSmooth.comp_selectedCosetAction realSmooth_heightC q
  have hDinv : RealSmooth Dinv :=
    realSmooth_heightC.inv (fun w => heightC_ne_zero w)
  have hdyN : dy N z = selectedCosetA q z := by
    simpa only [N, dx_heightC, dy_heightC, mul_zero, mul_one,
      add_zero] using
        dy_comp_selectedCosetAction q realSmooth_heightC z
  have hdyDinv : dy Dinv z = -(1 / heightC z ^ 2) := by
    change d1 Dinv z Complex.I = _
    rw [show d1 Dinv z Complex.I =
        -(d1 heightC z Complex.I) / heightC z ^ 2 by
      simpa only [Dinv] using
        d1_inv realSmooth_heightC z Complex.I (heightC_ne_zero z),
      d1_heightC]
    field_simp [heightC_ne_zero z]
  have hfun : selectedCosetConformalScaleC q = N * Dinv := by
    funext w
    simp only [selectedCosetConformalScaleC, N, Dinv,
      Pi.mul_apply, div_eq_mul_inv]
  rw [hfun, dy_mul hN hDinv, hdyN, hdyDinv]
  simp only [Dinv, N, div_eq_mul_inv]
  have hz : heightC z ≠ 0 := heightC_ne_zero z
  field_simp [hz]
  <;> ring

/-- Logarithmic horizontal scale derivative. -/
theorem height_mul_dx_selectedCosetConformalScaleC
    (q : GammaTwoRightCoset) (z : ℍ) :
    heightC z * dx (selectedCosetConformalScaleC q) z =
      selectedCosetB q z := by
  rw [dx_selectedCosetConformalScaleC]
  exact mul_div_cancel₀ _ (heightC_ne_zero z)

/-- Logarithmic vertical scale derivative. -/
theorem height_mul_dy_selectedCosetConformalScaleC
    (q : GammaTwoRightCoset) (z : ℍ) :
    heightC z * dy (selectedCosetConformalScaleC q) z =
      selectedCosetA q z - selectedCosetConformalScaleC q z := by
  rw [dy_selectedCosetConformalScaleC]
  field_simp [heightC_ne_zero z]

/-- The conformal scale has the same norm as the complex Möbius derivative. -/
theorem norm_selectedCosetConformalScaleC_eq_derivative
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖selectedCosetConformalScaleC q z‖ =
      ‖selectedCosetDerivative q z‖ := by
  have hden := selectedCosetDenom_ne_zero q z
  have hnorm : 0 < ‖selectedCosetDenom q z‖ := norm_pos_iff.mpr hden
  rw [selectedCosetConformalScaleC_eq_inv_normSq_denom]
  unfold selectedCosetDerivative selectedCosetDenom selectedCosetGL
  rw [Complex.norm_real, abs_of_pos (one_div_pos.mpr
    (Complex.normSq_pos.mpr hden)), norm_div, norm_one, norm_pow,
    Complex.normSq_eq_norm_sq]

/-- Each real conformal coefficient is bounded by the full scale. -/
theorem norm_selectedCosetA_le_scale
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖selectedCosetA q z‖ ≤ ‖selectedCosetConformalScaleC q z‖ := by
  calc
    ‖selectedCosetA q z‖ = |(selectedCosetDerivative q z).re| := by
      simp only [selectedCosetA, Complex.norm_real]
    _ ≤ ‖selectedCosetDerivative q z‖ := Complex.abs_re_le_norm _
    _ = ‖selectedCosetConformalScaleC q z‖ :=
      (norm_selectedCosetConformalScaleC_eq_derivative q z).symm

theorem norm_selectedCosetB_le_scale
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖selectedCosetB q z‖ ≤ ‖selectedCosetConformalScaleC q z‖ := by
  calc
    ‖selectedCosetB q z‖ = |(selectedCosetDerivative q z).im| := by
      simp only [selectedCosetB, Complex.norm_real]
    _ ≤ ‖selectedCosetDerivative q z‖ := Complex.abs_im_le_norm _
    _ = ‖selectedCosetConformalScaleC q z‖ :=
      (norm_selectedCosetConformalScaleC_eq_derivative q z).symm

/-- Uniform logarithmic derivative bounds for all six selected charts. -/
theorem norm_height_mul_dx_selectedCosetConformalScaleC_le
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖heightC z * dx (selectedCosetConformalScaleC q) z‖ ≤
      ‖selectedCosetConformalScaleC q z‖ := by
  rw [height_mul_dx_selectedCosetConformalScaleC]
  exact norm_selectedCosetB_le_scale q z

theorem norm_height_mul_dy_selectedCosetConformalScaleC_le
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖heightC z * dy (selectedCosetConformalScaleC q) z‖ ≤
      2 * ‖selectedCosetConformalScaleC q z‖ := by
  rw [height_mul_dy_selectedCosetConformalScaleC]
  calc
    ‖selectedCosetA q z - selectedCosetConformalScaleC q z‖ ≤
        ‖selectedCosetA q z‖ +
          ‖selectedCosetConformalScaleC q z‖ := norm_sub_le _ _
    _ ≤ ‖selectedCosetConformalScaleC q z‖ +
          ‖selectedCosetConformalScaleC q z‖ := by
      exact add_le_add_right (norm_selectedCosetA_le_scale q z) _
    _ = 2 * ‖selectedCosetConformalScaleC q z‖ := by ring

/-- General unitary Euclidean pullback along one selected tile chart. -/
noncomputable def selectedCosetUnitaryPullback
    (q : GammaTwoRightCoset) (f : ℍ → ℂ) : ℍ → ℂ :=
  fun z => selectedCosetConformalScaleC q z *
    f (selectedCosetAction q z)

theorem selectedCosetUnitaryPullback_realSmooth
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f) :
    RealSmooth (selectedCosetUnitaryPullback q f) :=
  (selectedCosetConformalScaleC_realSmooth q).mul
    (RealSmooth.comp_selectedCosetAction hf q)

/-- Exact horizontal chain/product rule for the unitary pullback. -/
theorem dx_selectedCosetUnitaryPullback
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    dx (selectedCosetUnitaryPullback q f) z =
      dx (selectedCosetConformalScaleC q) z *
          f (selectedCosetAction q z) +
        selectedCosetConformalScaleC q z *
          (selectedCosetA q z * dx f (selectedCosetAction q z) +
            selectedCosetB q z * dy f (selectedCosetAction q z)) := by
  rw [dx_mul (selectedCosetConformalScaleC_realSmooth q)
    (RealSmooth.comp_selectedCosetAction hf q),
    dx_comp_selectedCosetAction q hf]

/-- Exact vertical chain/product rule for the unitary pullback. -/
theorem dy_selectedCosetUnitaryPullback
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    dy (selectedCosetUnitaryPullback q f) z =
      dy (selectedCosetConformalScaleC q) z *
          f (selectedCosetAction q z) +
        selectedCosetConformalScaleC q z *
          (-selectedCosetB q z * dx f (selectedCosetAction q z) +
            selectedCosetA q z * dy f (selectedCosetAction q z)) := by
  rw [dy_mul (selectedCosetConformalScaleC_realSmooth q)
    (RealSmooth.comp_selectedCosetAction hf q),
    dy_comp_selectedCosetAction q hf]

/-- Exact logarithmic vertical derivative of the unitary pullback. -/
theorem height_mul_dy_selectedCosetUnitaryPullback
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    heightC z * dy (selectedCosetUnitaryPullback q f) z =
      (selectedCosetA q z - selectedCosetConformalScaleC q z) *
          f (selectedCosetAction q z) -
        selectedCosetB q z *
          (heightC (selectedCosetAction q z) *
            dx f (selectedCosetAction q z)) +
        selectedCosetA q z *
          (heightC (selectedCosetAction q z) *
            dy f (selectedCosetAction q z)) := by
  rw [dy_selectedCosetUnitaryPullback q hf,
    height_mul_dy_selectedCosetConformalScaleC]
  have hscale :
      heightC z * selectedCosetConformalScaleC q z =
        heightC (selectedCosetAction q z) := by
    unfold selectedCosetConformalScaleC
    exact mul_div_cancel₀ _ (heightC_ne_zero z)
  rw [mul_add, ← mul_assoc, hscale]
  ring

/-- Uniform pointwise bound for that vertical derivative.  The constants
`2,1,1` come respectively from the logarithmic scale derivative and the two
orthogonal conformal coefficients; in particular they do not depend on the
selected cusp chart. -/
theorem norm_height_mul_dy_selectedCosetUnitaryPullback_le
    (q : GammaTwoRightCoset) {f : ℍ → ℂ} (hf : RealSmooth f)
    (z : ℍ) :
    ‖heightC z * dy (selectedCosetUnitaryPullback q f) z‖ ≤
      ‖selectedCosetConformalScaleC q z‖ *
        (2 * ‖f (selectedCosetAction q z)‖ +
          ‖heightC (selectedCosetAction q z) *
            dx f (selectedCosetAction q z)‖ +
          ‖heightC (selectedCosetAction q z) *
            dy f (selectedCosetAction q z)‖) := by
  rw [height_mul_dy_selectedCosetUnitaryPullback q hf]
  let A := selectedCosetA q z
  let B := selectedCosetB q z
  let S := selectedCosetConformalScaleC q z
  let F := f (selectedCosetAction q z)
  let Fx := heightC (selectedCosetAction q z) *
    dx f (selectedCosetAction q z)
  let Fy := heightC (selectedCosetAction q z) *
    dy f (selectedCosetAction q z)
  have hA : ‖A‖ ≤ ‖S‖ := norm_selectedCosetA_le_scale q z
  have hB : ‖B‖ ≤ ‖S‖ := norm_selectedCosetB_le_scale q z
  have hAS : ‖A - S‖ ≤ 2 * ‖S‖ := by
    calc
      ‖A - S‖ ≤ ‖A‖ + ‖S‖ := norm_sub_le _ _
      _ ≤ ‖S‖ + ‖S‖ := add_le_add_right hA _
      _ = 2 * ‖S‖ := by ring
  change ‖(A - S) * F - B * Fx + A * Fy‖ ≤
    ‖S‖ * (2 * ‖F‖ + ‖Fx‖ + ‖Fy‖)
  calc
    ‖(A - S) * F - B * Fx + A * Fy‖ ≤
        ‖(A - S) * F‖ + ‖B * Fx‖ + ‖A * Fy‖ := by
      calc
        _ ≤ ‖(A - S) * F - B * Fx‖ + ‖A * Fy‖ := norm_add_le _ _
        _ ≤ (‖(A - S) * F‖ + ‖B * Fx‖) + ‖A * Fy‖ := by
          exact add_le_add_right (norm_sub_le _ _) _
    _ = ‖A - S‖ * ‖F‖ + ‖B‖ * ‖Fx‖ + ‖A‖ * ‖Fy‖ := by
      rw [norm_mul, norm_mul, norm_mul]
    _ ≤ (2 * ‖S‖) * ‖F‖ + ‖S‖ * ‖Fx‖ + ‖S‖ * ‖Fy‖ := by
      gcongr
    _ = ‖S‖ * (2 * ‖F‖ + ‖Fx‖ + ‖Fy‖) := by ring

/-- The selected-chart vertical derivative is controlled pointwise by the
actual Euclidean raising/lowering graph coordinates at the image point. -/
theorem norm_height_mul_dy_selectedCosetUnitaryPullback_le_graph
    (n : ℤ) (q : GammaTwoRightCoset) {f : ℍ → ℂ}
    (hf : RealSmooth f) (z : ℍ) :
    ‖heightC z * dy (selectedCosetUnitaryPullback q f) z‖ ≤
      ‖selectedCosetConformalScaleC q z‖ *
        ((3 + euclideanHorizontalDrift n / 2) *
            ‖f (selectedCosetAction q z)‖ +
          ‖euclideanRaiseGauge n f (selectedCosetAction q z)‖ +
          ‖euclideanLowerFromSuccGauge (n - 1) f
            (selectedCosetAction q z)‖) := by
  let w := selectedCosetAction q z
  let F := ‖f w‖
  let R := ‖euclideanRaiseGauge n f w‖
  let L := ‖euclideanLowerFromSuccGauge (n - 1) f w‖
  let X := ‖heightC w * dx f w‖
  let V := ‖heightC w * dy f w‖
  have hX : X ≤ (R + L + euclideanHorizontalDrift n * F) / 2 :=
    norm_height_mul_dx_le_euclideanGraph n f w
  have hV : V ≤ (R + L) / 2 + F :=
    norm_height_mul_dy_le_euclideanGraph n f w
  have hinside : 2 * F + X + V ≤
      (3 + euclideanHorizontalDrift n / 2) * F + R + L := by
    calc
      2 * F + X + V ≤
          2 * F + (R + L + euclideanHorizontalDrift n * F) / 2 +
            ((R + L) / 2 + F) := by gcongr
      _ = (3 + euclideanHorizontalDrift n / 2) * F + R + L := by
        ring
  calc
    ‖heightC z * dy (selectedCosetUnitaryPullback q f) z‖ ≤
        ‖selectedCosetConformalScaleC q z‖ * (2 * F + X + V) :=
      norm_height_mul_dy_selectedCosetUnitaryPullback_le q hf z
    _ ≤ ‖selectedCosetConformalScaleC q z‖ *
        ((3 + euclideanHorizontalDrift n / 2) * F + R + L) :=
      mul_le_mul_of_nonneg_left hinside (norm_nonneg _)

/-- Zero-order coefficient after differentiating the additional
`exp(r/2)` trace factor. -/
noncomputable def logHeightTraceDrift (n : ℤ) : ℝ :=
  (7 : ℝ) / 2 + euclideanHorizontalDrift n / 2

theorem logHeightTraceDrift_nonneg (n : ℤ) :
    0 ≤ logHeightTraceDrift n := by
  unfold logHeightTraceDrift
  positivity

noncomputable def logHeightTraceBaseCoeff (n : ℤ) : ℝ :=
  1 + 3 * logHeightTraceDrift n ^ 2

theorem logHeightTraceBaseCoeff_nonneg (n : ℤ) :
    0 ≤ logHeightTraceBaseCoeff n := by
  unfold logHeightTraceBaseCoeff
  positivity

/-- Conformal scale on the selected horizontal line. -/
noncomputable def selectedCuspPullbackScale
    (q : GammaTwoRightCoset) (Y t : ℝ) : ℝ :=
  (gammaTwoSelectedHorocycleParam q Y t).im / gammaTwoCuspLevel Y

theorem selectedCuspPullbackScale_pos
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    0 < selectedCuspPullbackScale q Y t := by
  exact div_pos (gammaTwoSelectedHorocycleParam q Y t).im_pos
    (lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y))

/-- Euclidean-unitary pullback of the fixed-phase gauge to the selected base
horocycle. -/
noncomputable def selectedCuspPulledEuclideanGauge
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) : ℝ → ℂ :=
  fun t =>
    ((selectedCuspPullbackScale q Y t : ℝ) : ℂ) *
      fixedPhaseEuclideanGauge n u
        (gammaTwoSelectedHorocycleParam q Y t)

/-- Exact pointwise conversion from the pulled Euclidean gauge to the
geometric horocycle density.  This is the `q`-selected weight/Jacobian bridge
needed before applying a scalar strip estimate. -/
theorem height_mul_normSq_selectedCuspPulledEuclideanGauge
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (t : ℝ) :
    gammaTwoCuspLevel Y *
        ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 =
      selectedCuspTraceWeightSq n q Y t *
        ‖(u : SmoothQuotientCompactFunction)
          (gammaTwoSelectedHorocycleParam q Y t)‖ ^ 2 := by
  let H : ℝ := gammaTwoCuspLevel Y
  let z : ℍ := gammaTwoSelectedHorocycleParam q Y t
  let s : ℝ := selectedCuspPullbackScale q Y t
  have hH : 0 < H :=
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
  have hz : 0 < z.im := z.im_pos
  have hs : 0 < s := selectedCuspPullbackScale_pos q Y t
  have hGauge :
      ‖fixedPhaseEuclideanGauge n u z‖ ^ 2 =
        (hyperbolicDensity z : ℝ) *
          weightFiberScale (-paperOrbitExponent n) z *
            ‖(u : SmoothQuotientCompactFunction) z‖ ^ 2 := by
    calc
      ‖fixedPhaseEuclideanGauge n u z‖ ^ 2 =
          (z.im ^ euclideanGaugeExponent n) ^ 2 *
            ‖(u : SmoothQuotientCompactFunction) z‖ ^ 2 := by
        rw [fixedPhaseEuclideanGauge_apply, norm_mul,
          Complex.norm_real, abs_of_pos (Real.rpow_pos_of_pos hz _)]
        ring
      _ = (hyperbolicDensity z : ℝ) *
          weightFiberScale (-paperOrbitExponent n) z *
            ‖(u : SmoothQuotientCompactFunction) z‖ ^ 2 := by
        rw [euclideanGaugeScale_sq]
  have hDensity : (hyperbolicDensity z : ℝ) = (1 / z.im) ^ 2 := by
    simp only [hyperbolicDensity, NNReal.coe_pow, NNReal.coe_div,
      NNReal.coe_one, NNReal.coe_mk]
  have hsFormula : s = z.im / H := rfl
  change H *
      ‖((s : ℝ) : ℂ) * fixedPhaseEuclideanGauge n u z‖ ^ 2 =
    (weightFiberScale (-paperOrbitExponent n) z / H) *
      ‖(u : SmoothQuotientCompactFunction) z‖ ^ 2
  rw [norm_mul, Complex.norm_real, abs_of_pos hs, hGauge,
    hDensity, hsFormula]
  field_simp [ne_of_gt hH, ne_of_gt hz]
  <;> ring

/-- The literal weighted restriction is exactly `sqrt(H)` times the unitary
pulled gauge at the level of squared norms. -/
theorem normSq_selectedCuspRestrictionRepresentative_eq_height_mul_pulled
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (t : ℝ) :
    ‖selectedCuspRestrictionRepresentative n q Y u t‖ ^ 2 =
      gammaTwoCuspLevel Y *
        ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 := by
  have hw :
      ‖((selectedCuspTraceWeight n q Y t : ℝ) : ℂ)‖ ^ 2 =
        selectedCuspTraceWeightSq n q Y t := by
    rw [Complex.norm_real,
      abs_of_pos (selectedCuspTraceWeight_pos n q Y t),
      selectedCuspTraceWeight_sq]
  calc
    ‖selectedCuspRestrictionRepresentative n q Y u t‖ ^ 2 =
        selectedCuspTraceWeightSq n q Y t *
          ‖(u : SmoothQuotientCompactFunction)
            (gammaTwoSelectedHorocycleParam q Y t)‖ ^ 2 := by
      rw [selectedCuspRestrictionRepresentative, norm_mul, mul_pow, hw]
    _ = gammaTwoCuspLevel Y *
        ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 :=
      (height_mul_normSq_selectedCuspPulledEuclideanGauge
        n q Y u t).symm

/-- Squared norm in the fixed horocycle `L²` target as the literal integral
of squared pointwise norms. -/
theorem selectedHorocycleL2_norm_sq_eq_integral
    (F : SelectedHorocycleL2) :
    ‖F‖ ^ 2 =
      ∫ t, ‖F t‖ ^ 2 ∂selectedHorocycleParameterMeasure := by
  rw [← inner_self_eq_norm_sq, MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner F F)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun t =>
    inner_self_eq_norm_sq (𝕜 := ℂ) (F t)

/-- Exact norm-level reduction of the actual selected-cusp trace to the
unitarily pulled Euclidean gauge on the standard parameter interval. -/
theorem norm_selectedCuspCoreTrace_sq_eq_integral_pulledGauge
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 =
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        gammaTwoCuspLevel Y *
          ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 := by
  calc
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 =
        ∫ t, ‖selectedCuspCoreTrace n q Y u t‖ ^ 2
          ∂selectedHorocycleParameterMeasure :=
      selectedHorocycleL2_norm_sq_eq_integral _
    _ = ∫ t, ‖selectedCuspRestrictionRepresentative n q Y u t‖ ^ 2
          ∂selectedHorocycleParameterMeasure := by
      apply integral_congr_ae
      filter_upwards [coeFn_selectedCuspCoreTrace n q Y u] with t ht
      rw [ht]
    _ = ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        gammaTwoCuspLevel Y *
          ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro t _ht
      exact normSq_selectedCuspRestrictionRepresentative_eq_height_mul_pulled
        n q Y u t

/-! #### G. Log-height slices

The global real parameter `r` below represents height `y = exp r`.  It never
meets `y = 0`, so ordinary one-dimensional `ContDiff` and FTC apply without
extending an upper-half-plane function across the real axis. -/

/-- Standard vertical line in logarithmic height. -/
noncomputable def logHeightBasePoint (t r : ℝ) : ℍ :=
  ⟨Complex.mk t (Real.exp r), Real.exp_pos r⟩

@[simp]
theorem logHeightBasePoint_im (t r : ℝ) :
    (logHeightBasePoint t r).im = Real.exp r := rfl

/-- Natural log-height trace gauge.  The factor `exp(r/2)` is the square root
of the horocycle height. -/
noncomputable def selectedLogHeightNaturalGauge
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (t : ℝ) : ℝ → ℂ :=
  fun r => ((Real.exp (r / 2) : ℝ) : ℂ) *
    selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
      (logHeightBasePoint t r)

/-- Restriction of a real-smooth upper-half-plane function to a log-height
vertical line remains `C-infinity`. -/
theorem RealSmooth.comp_logHeightBasePoint
    {f : ℍ → ℂ} (hf : RealSmooth f) (t : ℝ) :
    ContDiff ℝ ∞ (fun r => f (logHeightBasePoint t r)) := by
  let p : ℝ → ℂ := fun r => Complex.mk t (Real.exp r)
  have hp : ContDiff ℝ ∞ p := by
    dsimp only [p]
    fun_prop
  have hpMaps : Set.MapsTo p Set.univ
      UpperHalfPlane.upperHalfPlaneSet := by
    intro r _hr
    simpa only [p, Complex.mk_im] using Real.exp_pos r
  unfold RealSmooth at hf
  have hcomp := hf.comp hp.contDiffOn hpMaps
  rw [contDiffOn_univ] at hcomp
  simpa only [p, upperLift, Function.comp_def, logHeightBasePoint,
    UpperHalfPlane.ofComplex_apply_of_im_pos, Real.exp_pos] using hcomp

/-- Exact chain rule `d/dr = y d/dy` on a log-height slice. -/
theorem deriv_comp_logHeightBasePoint
    {f : ℍ → ℂ} (hf : RealSmooth f) (t r : ℝ) :
    deriv (fun s => f (logHeightBasePoint t s)) r =
      heightC (logHeightBasePoint t r) *
        dy f (logHeightBasePoint t r) := by
  let p : ℝ → ℂ := fun s => Complex.mk t (Real.exp s)
  let z : ℍ := logHeightBasePoint t r
  have hpDeriv : HasDerivAt p
      (Complex.I * (Real.exp r : ℂ)) r := by
    have hExp := (Real.hasDerivAt_exp r).ofReal_comp
    have hIm := hExp.const_mul Complex.I
    have hRe := hasDerivAt_const r (t : ℂ)
    simpa only [p, Complex.mk_eq_add_mul_I, add_comm, mul_comm] using
      hRe.add hIm
  have hOuter : DifferentiableAt ℝ (upperLift f) (z : ℂ) :=
    (RealSmooth.contDiffAt_upperLift hf z).differentiableAt (by simp)
  have hComp := hOuter.hasFDerivAt.comp r hpDeriv.hasFDerivAt
  have hEq : (fun s => f (logHeightBasePoint t s)) =
      upperLift f ∘ p := by
    funext s
    simp only [p, logHeightBasePoint, upperLift, Function.comp_apply,
      UpperHalfPlane.ofComplex_apply_of_im_pos, Real.exp_pos]
  rw [hEq, hComp.hasDerivAt.deriv]
  change d1 f z (Complex.I * (Real.exp r : ℂ)) =
    heightC z * dy f z
  rw [d1_complex_decomposition]
  simp only [Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
    Complex.ofReal_re, Complex.ofReal_im, zero_mul, one_mul, add_zero,
    z, heightC, logHeightBasePoint_im]
  ring

theorem selectedLogHeightNaturalGauge_contDiff
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (t : ℝ) :
    ContDiff ℝ 1 (selectedLogHeightNaturalGauge n q u t) := by
  have hPull : RealSmooth
      (selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)) :=
    selectedCosetUnitaryPullback_realSmooth q
      (fixedPhaseEuclideanGauge_realSmooth n u)
  have hSlice := RealSmooth.comp_logHeightBasePoint hPull t
  unfold selectedLogHeightNaturalGauge
  have hFactor : ContDiff ℝ 1
      (fun r : ℝ => ((Real.exp (r / 2) : ℝ) : ℂ)) := by
    fun_prop
  exact hFactor.mul (hSlice.of_le (by norm_num))

/-- Exact derivative of the natural log-height gauge. -/
theorem deriv_selectedLogHeightNaturalGauge
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (t r : ℝ) :
    deriv (selectedLogHeightNaturalGauge n q u t) r =
      ((Real.exp (r / 2) : ℝ) : ℂ) *
        ((1 / 2 : ℂ) *
            selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
              (logHeightBasePoint t r) +
          heightC (logHeightBasePoint t r) *
            dy (selectedCosetUnitaryPullback q
              (fixedPhaseEuclideanGauge n u))
              (logHeightBasePoint t r)) := by
  let h : ℍ → ℂ :=
    selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
  have hh : RealSmooth h :=
    selectedCosetUnitaryPullback_realSmooth q
      (fixedPhaseEuclideanGauge_realSmooth n u)
  have hExp : HasDerivAt
      (fun s : ℝ => ((Real.exp (s / 2) : ℝ) : ℂ))
      (((1 / 2 : ℝ) * Real.exp (r / 2) : ℝ) : ℂ) r := by
    convert (((Real.hasDerivAt_exp (r / 2)).comp r
      ((hasDerivAt_id r).div_const 2)).ofReal_comp) using 1 <;> ring
  have hSlice : HasDerivAt
      (fun s => h (logHeightBasePoint t s))
      (heightC (logHeightBasePoint t r) *
        dy h (logHeightBasePoint t r)) r := by
    rw [← deriv_comp_logHeightBasePoint hh t r]
    exact ((RealSmooth.comp_logHeightBasePoint hh t).differentiable
      (by norm_num) r).hasDerivAt
  have hProduct := hExp.mul hSlice
  change deriv
      (fun s : ℝ => ((Real.exp (s / 2) : ℝ) : ℂ) *
        h (logHeightBasePoint t s)) r = _
  rw [hProduct.deriv]
  ring

/-- Pointwise graph-coordinate bound for the derivative of the natural
log-height gauge. -/
theorem norm_deriv_selectedLogHeightNaturalGauge_le_graph
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (t r : ℝ) :
    ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ≤
      Real.exp (r / 2) *
        ‖selectedCosetConformalScaleC q (logHeightBasePoint t r)‖ *
          (logHeightTraceDrift n *
              ‖fixedPhaseEuclideanGauge n u
                (selectedCosetAction q (logHeightBasePoint t r))‖ +
            ‖euclideanRaiseGauge n (fixedPhaseEuclideanGauge n u)
              (selectedCosetAction q (logHeightBasePoint t r))‖ +
            ‖euclideanLowerFromSuccGauge (n - 1)
              (fixedPhaseEuclideanGauge n u)
              (selectedCosetAction q (logHeightBasePoint t r))‖) := by
  let z := logHeightBasePoint t r
  let f := fixedPhaseEuclideanGauge n u
  let S := ‖selectedCosetConformalScaleC q z‖
  let F := ‖f (selectedCosetAction q z)‖
  let R := ‖euclideanRaiseGauge n f (selectedCosetAction q z)‖
  let L := ‖euclideanLowerFromSuccGauge (n - 1) f
    (selectedCosetAction q z)‖
  have hPullNorm :
      ‖selectedCosetUnitaryPullback q f z‖ = S * F := by
    rw [selectedCosetUnitaryPullback, norm_mul]
  have hdy := norm_height_mul_dy_selectedCosetUnitaryPullback_le_graph
    n q (fixedPhaseEuclideanGauge_realSmooth n u) z
  rw [deriv_selectedLogHeightNaturalGauge]
  have hOuter :
      ‖((1 / 2 : ℂ) * selectedCosetUnitaryPullback q f z +
          heightC z * dy (selectedCosetUnitaryPullback q f) z)‖ ≤
        S * (logHeightTraceDrift n * F + R + L) := by
    calc
      _ ≤ ‖(1 / 2 : ℂ) * selectedCosetUnitaryPullback q f z‖ +
          ‖heightC z * dy (selectedCosetUnitaryPullback q f) z‖ :=
        norm_add_le _ _
      _ = (1 / 2 : ℝ) * (S * F) +
          ‖heightC z * dy (selectedCosetUnitaryPullback q f) z‖ := by
        rw [norm_mul, hPullNorm]
        norm_num
      _ ≤ (1 / 2 : ℝ) * (S * F) +
          S * ((3 + euclideanHorizontalDrift n / 2) * F + R + L) := by
        gcongr
      _ = S * (logHeightTraceDrift n * F + R + L) := by
        unfold logHeightTraceDrift
        ring
  rw [norm_mul, Complex.norm_real,
    abs_of_pos (Real.exp_pos (r / 2))]
  exact mul_le_mul_of_nonneg_left hOuter (Real.exp_pos _).le

/-- At `r = log H`, the general unitary pullback is the selected horocycle
pullback defined above. -/
theorem selectedCosetUnitaryPullback_log_cuspLevel
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (t : ℝ) :
    selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
        (logHeightBasePoint t (Real.log (gammaTwoCuspLevel Y))) =
      selectedCuspPulledEuclideanGauge n q Y u t := by
  let H := gammaTwoCuspLevel Y
  have hH : 0 < H :=
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
  have hbase : logHeightBasePoint t (Real.log H) =
      (⟨Complex.mk t H, hH⟩ : ℍ) := by
    apply Subtype.ext
    simp only [logHeightBasePoint, H, Real.exp_log hH]
  have htarget : selectedCosetAction q
      (logHeightBasePoint t (Real.log H)) =
        gammaTwoSelectedHorocycleParam q Y t := by
    rw [hbase]
    rfl
  unfold selectedCosetUnitaryPullback selectedCuspPulledEuclideanGauge
    selectedCuspPullbackScale selectedCosetConformalScaleC
  rw [htarget]
  simp only [heightC, logHeightBasePoint_im, Real.exp_log hH,
    Complex.ofReal_div]

/-- Consequently the natural log-height gauge has exactly the selected trace
density at its base point. -/
theorem normSq_selectedLogHeightNaturalGauge_at_log_cuspLevel
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (t : ℝ) :
    ‖selectedLogHeightNaturalGauge n q u t
        (Real.log (gammaTwoCuspLevel Y))‖ ^ 2 =
      gammaTwoCuspLevel Y *
        ‖selectedCuspPulledEuclideanGauge n q Y u t‖ ^ 2 := by
  let H := gammaTwoCuspLevel Y
  have hH : 0 < H :=
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
  have hExp : Real.exp (Real.log H / 2) ^ 2 = H := by
    rw [pow_two, ← Real.exp_add]
    convert Real.exp_log hH using 1 <;> ring
  unfold selectedLogHeightNaturalGauge
  rw [selectedCosetUnitaryPullback_log_cuspLevel]
  rw [norm_mul, Complex.norm_real,
    abs_of_pos (Real.exp_pos _), mul_pow, hExp]

/-- Norm of the actual `L²` trace as an integral of log-height endpoint
values. -/
theorem norm_selectedCuspCoreTrace_sq_eq_integral_logHeightEndpoint
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 =
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ‖selectedLogHeightNaturalGauge n q u t
          (Real.log (gammaTwoCuspLevel Y))‖ ^ 2 := by
  rw [norm_selectedCuspCoreTrace_sq_eq_integral_pulledGauge]
  apply setIntegral_congr_fun measurableSet_Icc
  intro t _ht
  exact
    (normSq_selectedLogHeightNaturalGauge_at_log_cuspLevel
      n q Y u t).symm

/-- Every fixed smooth-core log-height slice is eventually exactly zero. -/
theorem selectedLogHeightNaturalGauge_eventuallyEq_zero
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    {t : ℝ} (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    selectedLogHeightNaturalGauge n q u t =ᶠ[Filter.atTop] 0 := by
  rcases fixedPhaseCore_eventually_selectedCuspSection_eq_zero n u with
    ⟨Y₀, hY₀, hZero⟩
  have hExpEventually : ∀ᶠ r : ℝ in Filter.atTop, Y₀ < Real.exp r :=
    Real.tendsto_exp_atTop.eventually (eventually_gt_atTop Y₀)
  filter_upwards [hExpEventually] with r hr
  have hExpOne : 1 ≤ Real.exp r :=
    le_of_lt (hY₀.trans hr)
  have hlevel : gammaTwoCuspLevel (Real.exp r) = Real.exp r :=
    gammaTwoCuspLevel_of_one_le hExpOne
  have hpoint :
      gammaTwoSelectedHorocycleParam q (Real.exp r) t =
        selectedCosetAction q (logHeightBasePoint t r) := by
    unfold gammaTwoSelectedHorocycleParam selectedCosetAction
      logHeightBasePoint
    rw [hlevel]
  have hu0 :
      ((u : SmoothQuotientCompactFunction)
        (selectedCosetAction q (logHeightBasePoint t r))) = 0 := by
    rw [← hpoint]
    exact hZero (Real.exp r) hr q t ht
  simp only [selectedLogHeightNaturalGauge, selectedCosetUnitaryPullback,
    fixedPhaseEuclideanGauge_apply, hu0, mul_zero]

/-- Hence every fixed smooth-core log-height slice tends to zero at `+∞`. -/
theorem selectedLogHeightNaturalGauge_tendsto_zero
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    {t : ℝ} (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    Filter.Tendsto (selectedLogHeightNaturalGauge n q u t) Filter.atTop (nhds 0) :=
  (selectedLogHeightNaturalGauge_eventuallyEq_zero n q u ht).tendsto

/-- The one-dimensional natural gauge has integrable `H¹` energy on every
tail, with no separate integrability assumption. -/
theorem selectedLogHeightNaturalGauge_energy_integrableOn_Ioi
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    {t : ℝ} (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
    (r₀ : ℝ) :
    IntegrableOn (fun r =>
        ‖selectedLogHeightNaturalGauge n q u t r‖ ^ 2 +
          ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ^ 2)
      (Set.Ioi r₀) :=
  eventuallyEq_zero_energy_integrableOn_Ioi
    (selectedLogHeightNaturalGauge_contDiff n q u t)
    (selectedLogHeightNaturalGauge_eventuallyEq_zero n q u ht) r₀

/-- Unconditional one-dimensional trace estimate for every actual selected
log-height slice. -/
theorem normSq_selectedLogHeightNaturalGauge_at_log_cuspLevel_le_energy
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) {t : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    ‖selectedLogHeightNaturalGauge n q u t
        (Real.log (gammaTwoCuspLevel Y))‖ ^ 2 ≤
      ∫ r in Set.Ioi (Real.log (gammaTwoCuspLevel Y)),
        (‖selectedLogHeightNaturalGauge n q u t r‖ ^ 2 +
          ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ^ 2) := by
  exact tendsto_zero_normSq_le_energy_Ioi
    (selectedLogHeightNaturalGauge_contDiff n q u t)
    (selectedLogHeightNaturalGauge_tendsto_zero n q u ht)
    (selectedLogHeightNaturalGauge_energy_integrableOn_Ioi
      n q u ht (Real.log (gammaTwoCuspLevel Y)))

/-- Joint log-height `H¹` density on the horizontal parameter and logarithmic
height. -/
noncomputable def selectedLogHeightEnergyDensity
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n) :
    ℝ × ℝ → ℝ :=
  fun p => ‖selectedLogHeightNaturalGauge n q u p.1 p.2‖ ^ 2 +
    ‖deriv (selectedLogHeightNaturalGauge n q u p.1) p.2‖ ^ 2

/-- Total positive-height chart, defined through `ofComplex` only to give a
total function on `ℝ × ℝ`; on every integration tail below, height is positive
and `ofComplex` reduces to the literal point `(t,y)`. -/
noncomputable def selectedHeightBasePoint (t y : ℝ) : ℍ :=
  UpperHalfPlane.ofComplex (Complex.mk t y)

theorem selectedHeightBasePoint_of_pos (t : ℝ) {y : ℝ} (hy : 0 < y) :
    selectedHeightBasePoint t y = (⟨Complex.mk t y, hy⟩ : ℍ) := by
  apply Subtype.ext
  simp only [selectedHeightBasePoint,
    UpperHalfPlane.ofComplex_apply_of_im_pos, Complex.mk_im, hy]

@[simp]
theorem selectedHeightBasePoint_exp (t r : ℝ) :
    selectedHeightBasePoint t (Real.exp r) = logHeightBasePoint t r := by
  apply Subtype.ext
  simp only [selectedHeightBasePoint, logHeightBasePoint,
    UpperHalfPlane.ofComplex_apply_of_im_pos, Complex.mk_im, Real.exp_pos]

/-- Euclidean graph density after unitary pullback, expressed in ordinary
height.  The constants are the explicit output of the pointwise Young bounds. -/
noncomputable def selectedHeightGraphDensity
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n) :
    ℝ × ℝ → ℝ :=
  fun p =>
    let z := selectedHeightBasePoint p.1 p.2
    let w := selectedCosetAction q z
    let f := fixedPhaseEuclideanGauge n u
    ‖selectedCosetConformalScaleC q z‖ ^ 2 *
      (logHeightTraceBaseCoeff n * ‖f w‖ ^ 2 +
        3 * ‖euclideanRaiseGauge n f w‖ ^ 2 +
        3 * ‖euclideanLowerFromSuccGauge (n - 1) f w‖ ^ 2)

/-- Pointwise domination of log-height energy by the ordinary-height pulled
graph density, including the exact Jacobian `dy = exp(r) dr`. -/
theorem selectedLogHeightEnergyDensity_le_exp_mul_heightGraphDensity
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (t r : ℝ) :
    selectedLogHeightEnergyDensity n q u (t, r) ≤
      Real.exp r * selectedHeightGraphDensity n q u (t, Real.exp r) := by
  let z := logHeightBasePoint t r
  let f := fixedPhaseEuclideanGauge n u
  let w := selectedCosetAction q z
  let e := Real.exp (r / 2)
  let S := ‖selectedCosetConformalScaleC q z‖
  let F := ‖f w‖
  let R := ‖euclideanRaiseGauge n f w‖
  let L := ‖euclideanLowerFromSuccGauge (n - 1) f w‖
  let A := logHeightTraceDrift n
  have he : 0 ≤ e := (Real.exp_pos _).le
  have hS : 0 ≤ S := norm_nonneg _
  have hF : 0 ≤ F := norm_nonneg _
  have hR : 0 ≤ R := norm_nonneg _
  have hL : 0 ≤ L := norm_nonneg _
  have hA : 0 ≤ A := logHeightTraceDrift_nonneg n
  have hExp : e ^ 2 = Real.exp r := by
    dsimp only [e]
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have hPullNorm :
      ‖selectedCosetUnitaryPullback q f z‖ = S * F := by
    rw [selectedCosetUnitaryPullback, norm_mul]
  have hNatural :
      ‖selectedLogHeightNaturalGauge n q u t r‖ ^ 2 =
        Real.exp r * S ^ 2 * F ^ 2 := by
    unfold selectedLogHeightNaturalGauge
    rw [norm_mul, Complex.norm_real, abs_of_pos (Real.exp_pos _),
      hPullNorm, mul_pow, mul_pow, hExp]
    ring
  have hDeriv := norm_deriv_selectedLogHeightNaturalGauge_le_graph
    n q u t r
  change ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ≤
      e * S * (A * F + R + L) at hDeriv
  have hsum0 : 0 ≤ A * F + R + L := by positivity
  have hcoef0 : 0 ≤ e * S := mul_nonneg he hS
  have hDerivSq :
      ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ^ 2 ≤
        (e * S * (A * F + R + L)) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hDeriv 2
  have hthree : (A * F + R + L) ^ 2 ≤
      3 * ((A * F) ^ 2 + R ^ 2 + L ^ 2) := by
    nlinarith [sq_nonneg (A * F - R), sq_nonneg (A * F - L),
      sq_nonneg (R - L)]
  have hDerivSq' :
      ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ^ 2 ≤
        Real.exp r * S ^ 2 *
          (3 * ((A * F) ^ 2 + R ^ 2 + L ^ 2)) := by
    calc
      _ ≤ (e * S * (A * F + R + L)) ^ 2 := hDerivSq
      _ = Real.exp r * S ^ 2 * (A * F + R + L) ^ 2 := by
        rw [mul_pow, mul_pow, hExp]
        ring
      _ ≤ Real.exp r * S ^ 2 *
          (3 * ((A * F) ^ 2 + R ^ 2 + L ^ 2)) := by
        exact mul_le_mul_of_nonneg_left hthree
          (mul_nonneg (Real.exp_pos r).le (sq_nonneg S))
  rw [selectedLogHeightEnergyDensity, hNatural]
  change Real.exp r * S ^ 2 * F ^ 2 +
      ‖deriv (selectedLogHeightNaturalGauge n q u t) r‖ ^ 2 ≤ _
  calc
    _ ≤ Real.exp r * S ^ 2 * F ^ 2 +
        Real.exp r * S ^ 2 *
          (3 * ((A * F) ^ 2 + R ^ 2 + L ^ 2)) :=
      by
        simpa [add_comm] using
          add_le_add_left hDerivSq' (Real.exp r * S ^ 2 * F ^ 2)
    _ = Real.exp r *
        selectedHeightGraphDensity n q u (t, Real.exp r) := by
      simp only [selectedHeightGraphDensity, selectedHeightBasePoint_exp,
        z, f, w, S, F, R, L, A, logHeightTraceBaseCoeff]
      ring

theorem selectedLogHeightEnergyDensity_continuous
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n) :
    Continuous (selectedLogHeightEnergyDensity n q u) := by
  let h : ℍ → ℂ :=
    selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
  have hh : RealSmooth h :=
    selectedCosetUnitaryPullback_realSmooth q
      (fixedPhaseEuclideanGauge_realSmooth n u)
  have hpoint : Continuous
      (fun p : ℝ × ℝ => logHeightBasePoint p.1 p.2) := by
    apply continuous_subtype_mk
    fun_prop
  have hcomp : Continuous
      (fun p : ℝ × ℝ => h (logHeightBasePoint p.1 p.2)) :=
    hh.continuous.comp hpoint
  have hdycomp : Continuous
      (fun p : ℝ × ℝ =>
        dy h (logHeightBasePoint p.1 p.2)) :=
    (RealSmooth.dy hh).continuous.comp hpoint
  have hnatural : Continuous
      (fun p : ℝ × ℝ =>
        selectedLogHeightNaturalGauge n q u p.1 p.2) := by
    unfold selectedLogHeightNaturalGauge
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul hcomp
  have hderiv : Continuous
      (fun p : ℝ × ℝ =>
        deriv (selectedLogHeightNaturalGauge n q u p.1) p.2) := by
    have hExplicit : (fun p : ℝ × ℝ =>
        deriv (selectedLogHeightNaturalGauge n q u p.1) p.2) =
        fun p => ((Real.exp (p.2 / 2) : ℝ) : ℂ) *
          ((1 / 2 : ℂ) * h (logHeightBasePoint p.1 p.2) +
            heightC (logHeightBasePoint p.1 p.2) *
              dy h (logHeightBasePoint p.1 p.2) ) := by
      funext p
      exact deriv_selectedLogHeightNaturalGauge n q u p.1 p.2
    rw [hExplicit]
    fun_prop
  unfold selectedLogHeightEnergyDensity
  exact (hnatural.norm.pow 2).add (hderiv.norm.pow 2)

/-- One height cuts off all horizontal slices simultaneously. -/
theorem selectedLogHeightNaturalGauge_uniform_eventually_zero
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n) :
    ∃ R : ℝ, ∀ t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
      ∀ r, R < r → selectedLogHeightNaturalGauge n q u t r = 0 := by
  rcases fixedPhaseCore_eventually_selectedCuspSection_eq_zero n u with
    ⟨Y₀, hY₀, hZero⟩
  have hY₀pos : 0 < Y₀ := zero_lt_one.trans hY₀
  refine ⟨Real.log Y₀, ?_⟩
  intro t ht r hr
  have hExp : Y₀ < Real.exp r := by
    rw [← Real.exp_log hY₀pos]
    exact Real.exp_lt_exp.mpr hr
  have hExpOne : 1 ≤ Real.exp r :=
    le_of_lt (hY₀.trans hExp)
  have hlevel : gammaTwoCuspLevel (Real.exp r) = Real.exp r :=
    gammaTwoCuspLevel_of_one_le hExpOne
  have hpoint :
      gammaTwoSelectedHorocycleParam q (Real.exp r) t =
        selectedCosetAction q (logHeightBasePoint t r) := by
    unfold gammaTwoSelectedHorocycleParam selectedCosetAction
      logHeightBasePoint
    rw [hlevel]
  have hu0 :
      ((u : SmoothQuotientCompactFunction)
        (selectedCosetAction q (logHeightBasePoint t r))) = 0 := by
    rw [← hpoint]
    exact hZero (Real.exp r) hExp q t ht
  simp only [selectedLogHeightNaturalGauge, selectedCosetUnitaryPullback,
    fixedPhaseEuclideanGauge_apply, hu0, mul_zero]

theorem selectedLogHeightEnergyDensity_uniform_eventually_zero
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n) :
    ∃ R : ℝ, ∀ t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
      ∀ r, R < r → selectedLogHeightEnergyDensity n q u (t, r) = 0 := by
  rcases selectedLogHeightNaturalGauge_uniform_eventually_zero n q u with
    ⟨R, hZero⟩
  refine ⟨R, ?_⟩
  intro t ht r hr
  have hLocal : selectedLogHeightNaturalGauge n q u t =ᶠ[nhds r] 0 := by
    filter_upwards [isOpen_Ioi.mem_nhds hr] with s hs
    exact hZero t ht s hs
  have hDeriv : deriv (selectedLogHeightNaturalGauge n q u t) r = 0 := by
    simpa using hLocal.deriv_eq
  simp only [selectedLogHeightEnergyDensity, hZero t ht r hr,
    hDeriv, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
    zero_add]

/-- Joint log-height energy is integrable on the complete selected strip
tail.  Compactness is used only on a bounded rectangle; the rest is exactly
zero by quotient compact support. -/
theorem selectedLogHeightEnergyDensity_integrableOn_stripTail
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (r₀ : ℝ) :
    IntegrableOn (selectedLogHeightEnergyDensity n q u)
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi r₀)
      ((volume : Measure ℝ).prod volume) := by
  rcases selectedLogHeightEnergyDensity_uniform_eventually_zero n q u with
    ⟨R, hZero⟩
  let B : ℝ := max R r₀
  have hRB : R ≤ B := le_max_left _ _
  have hrB : r₀ ≤ B := le_max_right _ _
  let S : Set ℝ := Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)
  let K : Set (ℝ × ℝ) := S ×ˢ Set.Ioc r₀ B
  let T : Set (ℝ × ℝ) := S ×ˢ Set.Ioi B
  have hleft : IntegrableOn (selectedLogHeightEnergyDensity n q u) K
      ((volume : Measure ℝ).prod volume) := by
    have hCompact : IsCompact (S ×ˢ Set.Icc r₀ B) :=
      isCompact_Icc.prod isCompact_Icc
    apply (selectedLogHeightEnergyDensity_continuous n q u).continuousOn
      |>.integrableOn_compact (μ := (volume : Measure ℝ).prod volume)
      hCompact |>.mono_set
    exact Set.prod_mono_right Set.Ioc_subset_Icc_self
  have hright : IntegrableOn (selectedLogHeightEnergyDensity n q u) T
      ((volume : Measure ℝ).prod volume) := by
    apply integrableOn_zero.congr
    filter_upwards [ae_restrict_mem
      (measurableSet_Icc.prod measurableSet_Ioi)] with p hp
    exact (hZero p.1 hp.1 p.2 (hRB.trans_lt hp.2)).symm
  have htailUnion : K ∪ T = S ×ˢ Set.Ioi r₀ := by
    ext p
    constructor
    · intro hp
      rcases hp with hp | hp
      · exact ⟨hp.1, hp.2.1⟩
      · exact ⟨hp.1, hrB.trans_lt hp.2⟩
    · intro hp
      by_cases hle : p.2 ≤ B
      · exact Or.inl ⟨hp.1, hp.2, hle⟩
      · exact Or.inr ⟨hp.1, lt_of_not_ge hle⟩
  change IntegrableOn (selectedLogHeightEnergyDensity n q u)
    (S ×ˢ Set.Ioi r₀) ((volume : Measure ℝ).prod volume)
  rw [← htailUnion]
  exact hleft.union hright

/-- Fubini integrability of the vertical energy as a function of the
horizontal parameter. -/
theorem selectedLogHeightEnergy_iterated_integrableOn
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (r₀ : ℝ) :
    IntegrableOn (fun t =>
        ∫ r in Set.Ioi r₀,
          selectedLogHeightEnergyDensity n q u (t, r))
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) := by
  let μ : Measure ℝ :=
    (volume : Measure ℝ).restrict
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ioi r₀)
  have hProd : Integrable (selectedLogHeightEnergyDensity n q u)
      (μ.prod ν) := by
    change Integrable (selectedLogHeightEnergyDensity n q u)
      (((volume : Measure ℝ).restrict
          (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioi r₀)))
    rw [Measure.prod_restrict]
    exact selectedLogHeightEnergyDensity_integrableOn_stripTail
      n q u r₀
  exact hProd.integral_prod_left

/-- Actual Fubini identity for the selected log-height strip. -/
theorem integral_selectedLogHeightEnergyDensity_stripTail_eq_iterated
    (n : ℤ) (q : GammaTwoRightCoset) (u : InverseEtaFixedPhaseCore n)
    (r₀ : ℝ) :
    (∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi r₀,
        selectedLogHeightEnergyDensity n q u p
        ∂((volume : Measure ℝ).prod volume)) =
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ∫ r in Set.Ioi r₀,
          selectedLogHeightEnergyDensity n q u (t, r) := by
  let μ : Measure ℝ :=
    (volume : Measure ℝ).restrict
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ioi r₀)
  have hProd : Integrable (selectedLogHeightEnergyDensity n q u)
      (μ.prod ν) := by
    change Integrable (selectedLogHeightEnergyDensity n q u)
      (((volume : Measure ℝ).restrict
          (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioi r₀)))
    rw [Measure.prod_restrict]
    exact selectedLogHeightEnergyDensity_integrableOn_stripTail
      n q u r₀
  change (∫ p, selectedLogHeightEnergyDensity n q u p ∂μ.prod ν) =
    ∫ t, ∫ r, selectedLogHeightEnergyDensity n q u (t, r) ∂ν ∂μ
  exact integral_prod _ hProd

/-- Unconditional integrated scalar trace estimate on the actual selected
cusp chart. -/
theorem norm_selectedCuspCoreTrace_sq_le_logHeightEnergy
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 ≤
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ∫ r in Set.Ioi (Real.log (gammaTwoCuspLevel Y)),
          selectedLogHeightEnergyDensity n q u (t, r) := by
  rw [norm_selectedCuspCoreTrace_sq_eq_integral_logHeightEndpoint]
  apply setIntegral_mono_on
  · have hEndpoint : Continuous (fun t =>
        ‖selectedLogHeightNaturalGauge n q u t
          (Real.log (gammaTwoCuspLevel Y))‖ ^ 2) := by
      let h : ℍ → ℂ :=
        selectedCosetUnitaryPullback q (fixedPhaseEuclideanGauge n u)
      have hh : RealSmooth h :=
        selectedCosetUnitaryPullback_realSmooth q
          (fixedPhaseEuclideanGauge_realSmooth n u)
      unfold selectedLogHeightNaturalGauge
      fun_prop
    exact hEndpoint.continuousOn.integrableOn_Icc
  · exact selectedLogHeightEnergy_iterated_integrableOn n q u
      (Real.log (gammaTwoCuspLevel Y))
  · exact measurableSet_Icc
  · intro t ht
    exact normSq_selectedLogHeightNaturalGauge_at_log_cuspLevel_le_energy
      n q Y u ht

/-! #### H. Ordinary-height strip energy and the three Hilbert coordinates

The logarithmic estimate above is now connected to the actual Euclidean
carrier.  We first package the three literal gauge densities which represent
the base, raised, and lowered Petersson coordinates.  Every statement in this
subsection is an equality or inequality for the already constructed objects;
there is no trace, extension, or compactness certificate among its inputs. -/

/-- The literal three-coordinate Euclidean graph density on the chosen
carrier. -/
noncomputable def fixedPhaseEuclideanGraphDensity
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) : ℍ → ℝ :=
  fun z =>
    logHeightTraceBaseCoeff n *
        ‖fixedPhaseEuclideanGauge n u z‖ ^ 2 +
      3 * ‖fixedPhaseEuclideanGauge (n + 1)
        (InverseEtaFixedPhaseCore.raise n u) z‖ ^ 2 +
      3 * ‖fixedPhaseEuclideanGauge (n - 1)
        (InverseEtaFixedPhaseCore.lower n u) z‖ ^ 2

theorem fixedPhaseEuclideanGraphDensity_nonneg
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    0 ≤ fixedPhaseEuclideanGraphDensity n u z := by
  unfold fixedPhaseEuclideanGraphDensity
  positivity

theorem fixedPhaseEuclideanGraphDensity_continuous
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    Continuous (fixedPhaseEuclideanGraphDensity n u) := by
  unfold fixedPhaseEuclideanGraphDensity
  exact
    (((continuous_const.mul
        ((fixedPhaseEuclideanGauge_realSmooth n u).continuous.norm.pow 2)).add
      (continuous_const.mul
        ((fixedPhaseEuclideanGauge_realSmooth (n + 1)
          (InverseEtaFixedPhaseCore.raise n u)).continuous.norm.pow 2))).add
      (continuous_const.mul
        ((fixedPhaseEuclideanGauge_realSmooth (n - 1)
          (InverseEtaFixedPhaseCore.lower n u)).continuous.norm.pow 2)))

/-- The selected ordinary-height density is exactly the Möbius Jacobian
factor times the preceding literal three-coordinate density. -/
theorem selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) (t y : ℝ) :
    selectedHeightGraphDensity n q u (t, y) =
      ‖selectedCosetConformalScaleC q
        (selectedHeightBasePoint t y)‖ ^ 2 *
      fixedPhaseEuclideanGraphDensity n u
        (selectedCosetAction q (selectedHeightBasePoint t y)) := by
  unfold selectedHeightGraphDensity fixedPhaseEuclideanGraphDensity
  rw [← fixedPhaseEuclideanGauge_raise n u,
    ← fixedPhaseEuclideanGauge_lower_pred n u]

/-- Squared `L²` norm formula, stated for the concrete carrier realization.
This is the same Hilbert identity as for the horocycle target, but keeping it
separate avoids any accidental identification of the two measures. -/
theorem orbitEuclideanL2_norm_sq_eq_integral
    (m : ℤ) (F : OrbitEuclideanL2 m) :
    ‖F‖ ^ 2 =
      ∫ z, ‖F z‖ ^ 2 ∂chosenEuclideanCarrierMeasure := by
  rw [← inner_self_eq_norm_sq, MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner F F)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z =>
    inner_self_eq_norm_sq (𝕜 := ℂ) (F z)

theorem fixedPhaseEuclideanGauge_normSq_integrable
    (m : ℤ) (v : InverseEtaFixedPhaseCore m) :
    Integrable (fun z => ‖fixedPhaseEuclideanGauge m v z‖ ^ 2)
      chosenEuclideanCarrierMeasure := by
  have hMem : MemLp (fixedPhaseEuclideanGauge m v) 2
      chosenEuclideanCarrierMeasure := by
    simpa only [fixedPhaseEuclideanGauge] using
      orbitEuclideanGauge_memLp m (coreEmbedding m v)
  exact (memLp_two_iff_integrable_sq_norm
    (fixedPhaseEuclideanGauge_realSmooth m v).continuous.aestronglyMeasurable).mp hMem

/-- The integral of a literal fixed-phase gauge is the squared norm of its
actual Petersson coordinate. -/
theorem integral_fixedPhaseEuclideanGauge_normSq_eq_coordinate
    (m : ℤ) (v : InverseEtaFixedPhaseCore m) :
    (∫ z, ‖fixedPhaseEuclideanGauge m v z‖ ^ 2
        ∂chosenEuclideanCarrierMeasure) =
      ‖l2Coordinate m v‖ ^ 2 := by
  let E := orbitPeterssonEuclideanEmbedding m (l2Coordinate m v)
  calc
    (∫ z, ‖fixedPhaseEuclideanGauge m v z‖ ^ 2
        ∂chosenEuclideanCarrierMeasure) =
        ∫ z, ‖E z‖ ^ 2 ∂chosenEuclideanCarrierMeasure := by
      apply integral_congr_ae
      filter_upwards [coeFn_embedding_l2Coordinate_fixedPhaseGauge m v]
        with z hz
      rw [hz]
    _ = ‖E‖ ^ 2 :=
      (orbitEuclideanL2_norm_sq_eq_integral m E).symm
    _ = ‖l2Coordinate m v‖ ^ 2 := by
      rw [orbitPeterssonEuclideanEmbedding_norm]

theorem fixedPhaseEuclideanGraphDensity_integrable
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    Integrable (fixedPhaseEuclideanGraphDensity n u)
      chosenEuclideanCarrierMeasure := by
  have hBase := fixedPhaseEuclideanGauge_normSq_integrable n u
  have hRaise := fixedPhaseEuclideanGauge_normSq_integrable (n + 1)
    (InverseEtaFixedPhaseCore.raise n u)
  have hLower := fixedPhaseEuclideanGauge_normSq_integrable (n - 1)
    (InverseEtaFixedPhaseCore.lower n u)
  exact ((hBase.const_mul (logHeightTraceBaseCoeff n)).add
    (hRaise.const_mul 3)).add (hLower.const_mul 3)

/-- Exact integral of the graph density as the weighted sum of the three
Petersson coordinate norms. -/
theorem integral_fixedPhaseEuclideanGraphDensity_eq_coordinates
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    (∫ z, fixedPhaseEuclideanGraphDensity n u z
        ∂chosenEuclideanCarrierMeasure) =
      logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 := by
  have hBase := fixedPhaseEuclideanGauge_normSq_integrable n u
  have hRaise := fixedPhaseEuclideanGauge_normSq_integrable (n + 1)
    (InverseEtaFixedPhaseCore.raise n u)
  have hLower := fixedPhaseEuclideanGauge_normSq_integrable (n - 1)
    (InverseEtaFixedPhaseCore.lower n u)
  unfold fixedPhaseEuclideanGraphDensity
  rw [integral_add ((hBase.const_mul _).add (hRaise.const_mul _))
      (hLower.const_mul _),
    integral_add (hBase.const_mul _) (hRaise.const_mul _),
    integral_const_mul, integral_const_mul, integral_const_mul,
    integral_fixedPhaseEuclideanGauge_normSq_eq_coordinate,
    integral_fixedPhaseEuclideanGauge_normSq_eq_coordinate,
    integral_fixedPhaseEuclideanGauge_normSq_eq_coordinate,
    raisedCoordinate_apply, loweredCoordinate_apply]

/-- On positive heights, the totalized point `(t,y)` varies continuously in
the upper half-plane. -/
theorem selectedHeightBasePoint_continuousOn_Ioi (t : ℝ) :
    ContinuousOn (selectedHeightBasePoint t) (Set.Ioi 0) := by
  unfold selectedHeightBasePoint
  refine UpperHalfPlane.ofComplex.continuousOn.comp
    (by fun_prop) ?_
  intro y hy
  change 0 < (Complex.mk t y).im
  simpa using hy

/-- Ordinary-height graph density is continuous on every positive vertical
slice. -/
theorem selectedHeightGraphDensity_slice_continuousOn
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) (t : ℝ) :
    ContinuousOn (fun y => selectedHeightGraphDensity n q u (t, y))
      (Set.Ioi 0) := by
  have hz := selectedHeightBasePoint_continuousOn_Ioi t
  have hScale : ContinuousOn (fun y =>
      ‖selectedCosetConformalScaleC q
        (selectedHeightBasePoint t y)‖ ^ 2) (Set.Ioi 0) :=
    ((selectedCosetConformalScaleC_realSmooth q).continuous.norm.pow 2).comp_continuousOn hz
  have hAction : ContinuousOn (fun y =>
      selectedCosetAction q (selectedHeightBasePoint t y))
      (Set.Ioi 0) :=
    (continuous_sl2z_smul (gammaTwoCosetRep q)).comp_continuousOn hz
  have hDensity : ContinuousOn (fun y =>
      fixedPhaseEuclideanGraphDensity n u
        (selectedCosetAction q (selectedHeightBasePoint t y)))
      (Set.Ioi 0) :=
    (fixedPhaseEuclideanGraphDensity_continuous n u).comp_continuousOn hAction
  rw [show (fun y => selectedHeightGraphDensity n q u (t, y)) =
      fun y => ‖selectedCosetConformalScaleC q
          (selectedHeightBasePoint t y)‖ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u
          (selectedCosetAction q (selectedHeightBasePoint t y)) by
    funext y
    exact selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity
      n q u t y]
  exact hScale.mul hDensity

theorem selectedHeightGraphDensity_nonneg
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) (t y : ℝ) :
    0 ≤ selectedHeightGraphDensity n q u (t, y) := by
  rw [selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity]
  exact mul_nonneg (sq_nonneg _)
    (fixedPhaseEuclideanGraphDensity_nonneg n u _)

/-- One ordinary height cuts off the base, raised, and lowered gauge
coordinates simultaneously, uniformly in the horizontal parameter and in
the selected cusp chart. -/
theorem selectedHeightGraphDensity_uniform_eventually_zero
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ B : ℝ, 1 < B ∧
      ∀ t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ∀ y, B < y → selectedHeightGraphDensity n q u (t, y) = 0 := by
  rcases fixedPhaseCore_eventually_selectedCuspSection_eq_zero n u with
    ⟨B₀, hB₀, hZeroBase⟩
  rcases fixedPhaseCore_eventually_selectedCuspSection_eq_zero (n + 1)
      (InverseEtaFixedPhaseCore.raise n u) with
    ⟨B₁, hB₁, hZeroRaise⟩
  rcases fixedPhaseCore_eventually_selectedCuspSection_eq_zero (n - 1)
      (InverseEtaFixedPhaseCore.lower n u) with
    ⟨B₂, hB₂, hZeroLower⟩
  let B : ℝ := max B₀ (max B₁ B₂)
  have hB : 1 < B := hB₀.trans_le (le_max_left _ _)
  refine ⟨B, hB, ?_⟩
  intro t ht y hy
  have hB₀y : B₀ < y := (le_max_left B₀ (max B₁ B₂)).trans_lt hy
  have hB₁y : B₁ < y :=
    ((le_max_left B₁ B₂).trans (le_max_right B₀ (max B₁ B₂))).trans_lt hy
  have hB₂y : B₂ < y :=
    ((le_max_right B₁ B₂).trans (le_max_right B₀ (max B₁ B₂))).trans_lt hy
  have hyOne : 1 ≤ y := le_of_lt (hB.trans hy)
  have hyPos : 0 < y := zero_lt_one.trans_le hyOne
  have hlevel : gammaTwoCuspLevel y = y :=
    gammaTwoCuspLevel_of_one_le hyOne
  have hpoint : selectedCosetAction q (selectedHeightBasePoint t y) =
      gammaTwoSelectedHorocycleParam q y t := by
    rw [selectedHeightBasePoint_of_pos t hyPos]
    unfold gammaTwoSelectedHorocycleParam selectedCosetAction
    rw [hlevel]
  have hu : ((u : SmoothQuotientCompactFunction)
      (selectedCosetAction q (selectedHeightBasePoint t y))) = 0 := by
    rw [hpoint]
    exact hZeroBase y hB₀y q t ht
  have hru := hZeroRaise y hB₁y q t ht
  rw [← hpoint] at hru
  have hlu := hZeroLower y hB₂y q t ht
  rw [← hpoint] at hlu
  have hg : fixedPhaseEuclideanGauge n u
      (selectedCosetAction q (selectedHeightBasePoint t y)) = 0 := by
    simp only [fixedPhaseEuclideanGauge_apply, hu, mul_zero]
  have hrg : fixedPhaseEuclideanGauge (n + 1)
      (InverseEtaFixedPhaseCore.raise n u)
      (selectedCosetAction q (selectedHeightBasePoint t y)) = 0 := by
    simp only [fixedPhaseEuclideanGauge_apply, hru, mul_zero]
  have hlg : fixedPhaseEuclideanGauge (n - 1)
      (InverseEtaFixedPhaseCore.lower n u)
      (selectedCosetAction q (selectedHeightBasePoint t y)) = 0 := by
    simp only [fixedPhaseEuclideanGauge_apply, hlu, mul_zero]
  rw [selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity]
  simp only [fixedPhaseEuclideanGraphDensity, hg, hrg, hlg, norm_zero,
    zero_pow (by norm_num : (2 : ℕ) ≠ 0), mul_zero, add_zero]

/-- A continuous real function which is literally zero at the right end is
integrable on every closed right tail. -/
theorem continuousOn_eventuallyEq_zero_integrableOn_Ici
    {f : ℝ → ℝ} {a : ℝ} (hf : ContinuousOn f (Set.Ici a))
    (hzero : f =ᶠ[Filter.atTop] 0) : IntegrableOn f (Set.Ici a) := by
  rcases (eventually_atTop.1 hzero) with ⟨B₀, hB₀⟩
  let B : ℝ := max B₀ a
  have haB : a ≤ B := le_max_right _ _
  have hzeroB : ∀ y, B ≤ y → f y = 0 := by
    intro y hy
    exact hB₀ y ((le_max_left _ _).trans hy)
  have hleft : IntegrableOn f (Set.Icc a B) :=
    (hf.mono Set.Icc_subset_Ici_self).integrableOn_compact isCompact_Icc
  have hright : IntegrableOn f (Set.Ioi B) := by
    apply integrableOn_zero.congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with y hy
    exact (hzeroB y (le_of_lt hy)).symm
  have hunion : Set.Icc a B ∪ Set.Ioi B = Set.Ici a := by
    ext y
    constructor
    · intro hy
      rcases hy with hy | hy
      · exact hy.1
      · exact haB.trans hy.le
    · intro hy
      by_cases hyB : y ≤ B
      · exact Or.inl ⟨hy, hyB⟩
      · exact Or.inr (lt_of_not_ge hyB)
  rw [← hunion]
  exact hleft.union hright

/-- Every selected ordinary-height slice has integrable graph density on a
positive tail. -/
theorem selectedHeightGraphDensity_slice_integrableOn_Ici
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {t H : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) (hH : 0 < H) :
    IntegrableOn (fun y => selectedHeightGraphDensity n q u (t, y))
      (Set.Ici H) := by
  apply continuousOn_eventuallyEq_zero_integrableOn_Ici
  · exact (selectedHeightGraphDensity_slice_continuousOn n q u t).mono
      (fun y hy => hH.trans_le hy)
  · rcases selectedHeightGraphDensity_uniform_eventually_zero n q u with
      ⟨B, _hB, hZero⟩
    filter_upwards [eventually_gt_atTop B] with y hy
    simpa using hZero t ht y hy

/-- The Jacobian-weighted exponential pullback is also integrable on the
closed logarithmic tail. -/
theorem exp_mul_selectedHeightGraphDensity_integrableOn_Ici_log
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {t H : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) (hH : 0 < H) :
    IntegrableOn (fun r =>
        selectedHeightGraphDensity n q u (t, Real.exp r) * Real.exp r)
      (Set.Ici (Real.log H)) := by
  let g : ℝ → ℝ := fun y => selectedHeightGraphDensity n q u (t, y)
  have hg : ContinuousOn g (Set.Ioi 0) :=
    selectedHeightGraphDensity_slice_continuousOn n q u t
  have hcont : ContinuousOn (fun r => g (Real.exp r) * Real.exp r)
      (Set.Ici (Real.log H)) :=
    (hg.comp Real.continuous_exp.continuousOn
      (fun r _hr => Real.exp_pos r)).mul Real.continuous_exp.continuousOn
  apply continuousOn_eventuallyEq_zero_integrableOn_Ici hcont
  rcases selectedHeightGraphDensity_uniform_eventually_zero n q u with
    ⟨B, _hB, hZero⟩
  have hExpEventually : ∀ᶠ r : ℝ in Filter.atTop, B < Real.exp r :=
    Real.tendsto_exp_atTop.eventually (eventually_gt_atTop B)
  filter_upwards [hExpEventually] with r hr
  simp only [g, hZero t ht (Real.exp r) hr, zero_mul]

/-- Exact improper substitution `y = exp r` for an actual selected graph
density.  All continuity and integrability hypotheses of Mathlib's theorem
are discharged by the preceding compact-tail lemmas. -/
theorem integral_exp_mul_selectedHeightGraphDensity_Ioi_log
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {t H : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) (hH : 0 < H) :
    (∫ r in Set.Ioi (Real.log H),
        Real.exp r * selectedHeightGraphDensity n q u (t, Real.exp r)) =
      ∫ y in Set.Ioi H, selectedHeightGraphDensity n q u (t, y) := by
  let g : ℝ → ℝ := fun y => selectedHeightGraphDensity n q u (t, y)
  have hgCont : ContinuousOn g (Set.Ioi 0) :=
    selectedHeightGraphDensity_slice_continuousOn n q u t
  have hgInt : IntegrableOn g (Set.Ici H) :=
    selectedHeightGraphDensity_slice_integrableOn_Ici n q u ht hH
  have hPullInt : IntegrableOn
      (fun r => (g ∘ Real.exp) r * Real.exp r)
      (Set.Ici (Real.log H)) := by
    simpa only [g, Function.comp_apply] using
      exp_mul_selectedHeightGraphDensity_integrableOn_Ici_log
        n q u ht hH
  have hSub := integral_comp_mul_deriv_Ioi
    (f := Real.exp) (f' := Real.exp) (g := g) (a := Real.log H)
    Real.continuous_exp.continuousOn Real.tendsto_exp_atTop
    (fun x _hx => (Real.hasDerivAt_exp x).hasDerivWithinAt)
    (hgCont.mono (by
      rintro y ⟨x, _hx, rfl⟩
      exact Real.exp_pos x))
    (hgInt.mono_set (by
      rintro y ⟨x, hx, rfl⟩
      rw [← Real.exp_log hH]
      exact Real.exp_le_exp.mpr hx))
    hPullInt
  simpa only [g, Function.comp_apply, Real.exp_log hH, mul_comm] using hSub

/-- Pointwise-in-horizontal-parameter comparison of the log-height energy
with the actual ordinary-height strip energy. -/
theorem integral_selectedLogHeightEnergy_le_heightGraphTail
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) {t : ℝ}
    (ht : t ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    (∫ r in Set.Ioi (Real.log (gammaTwoCuspLevel Y)),
        selectedLogHeightEnergyDensity n q u (t, r)) ≤
      ∫ y in Set.Ioi (gammaTwoCuspLevel Y),
        selectedHeightGraphDensity n q u (t, y) := by
  let H := gammaTwoCuspLevel Y
  have hH : 0 < H :=
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
  have hLogInt : IntegrableOn
      (fun r => selectedLogHeightEnergyDensity n q u (t, r))
      (Set.Ioi (Real.log H)) := by
    simpa only [selectedLogHeightEnergyDensity] using
      selectedLogHeightNaturalGauge_energy_integrableOn_Ioi
        n q u ht (Real.log H)
  have hHeightPullInt : IntegrableOn (fun r =>
      Real.exp r * selectedHeightGraphDensity n q u (t, Real.exp r))
      (Set.Ioi (Real.log H)) := by
    have hClosed := exp_mul_selectedHeightGraphDensity_integrableOn_Ici_log
      n q u ht hH
    have hOpen := hClosed.mono_set Set.Ioi_subset_Ici_self
    simpa only [mul_comm] using hOpen
  calc
    (∫ r in Set.Ioi (Real.log H),
        selectedLogHeightEnergyDensity n q u (t, r)) ≤
        ∫ r in Set.Ioi (Real.log H),
          Real.exp r * selectedHeightGraphDensity n q u (t, Real.exp r) := by
      apply setIntegral_mono_on hLogInt hHeightPullInt measurableSet_Ioi
      intro r _hr
      exact selectedLogHeightEnergyDensity_le_exp_mul_heightGraphDensity
        n q u t r
    _ = ∫ y in Set.Ioi H,
        selectedHeightGraphDensity n q u (t, y) :=
      integral_exp_mul_selectedHeightGraphDensity_Ioi_log n q u ht hH

/-! #### I. Joint Fubini form of the ordinary-height strip -/

theorem selectedHeightBasePoint_joint_continuousOn_positive :
    ContinuousOn (fun p : ℝ × ℝ =>
      selectedHeightBasePoint p.1 p.2)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) := by
  unfold selectedHeightBasePoint
  refine UpperHalfPlane.ofComplex.continuousOn.comp
    (by fun_prop) ?_
  intro p hp
  change 0 < (Complex.mk p.1 p.2).im
  simpa using hp.2

theorem selectedHeightGraphDensity_continuousOn_positive
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) :
    ContinuousOn (selectedHeightGraphDensity n q u)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) := by
  have hz := selectedHeightBasePoint_joint_continuousOn_positive
  have hScale : ContinuousOn (fun p : ℝ × ℝ =>
      ‖selectedCosetConformalScaleC q
        (selectedHeightBasePoint p.1 p.2)‖ ^ 2)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) :=
    ((selectedCosetConformalScaleC_realSmooth q).continuous.norm.pow 2).comp_continuousOn hz
  have hAction : ContinuousOn (fun p : ℝ × ℝ =>
      selectedCosetAction q (selectedHeightBasePoint p.1 p.2))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) :=
    (continuous_sl2z_smul (gammaTwoCosetRep q)).comp_continuousOn hz
  have hDensity : ContinuousOn (fun p : ℝ × ℝ =>
      fixedPhaseEuclideanGraphDensity n u
        (selectedCosetAction q (selectedHeightBasePoint p.1 p.2)))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) :=
    (fixedPhaseEuclideanGraphDensity_continuous n u).comp_continuousOn hAction
  rw [show selectedHeightGraphDensity n q u = fun p : ℝ × ℝ =>
      ‖selectedCosetConformalScaleC q
          (selectedHeightBasePoint p.1 p.2)‖ ^ 2 *
        fixedPhaseEuclideanGraphDensity n u
          (selectedCosetAction q (selectedHeightBasePoint p.1 p.2)) by
    funext p
    exact selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity
      n q u p.1 p.2]
  exact hScale.mul hDensity

/-- The full ordinary-height selected strip is integrable.  As before, only
a bounded rectangle uses continuity; the remaining tail is literally zero. -/
theorem selectedHeightGraphDensity_integrableOn_stripTail
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {H : ℝ} (hH : 0 < H) :
    IntegrableOn (selectedHeightGraphDensity n q u)
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H)
      ((volume : Measure ℝ).prod volume) := by
  rcases selectedHeightGraphDensity_uniform_eventually_zero n q u with
    ⟨B₀, _hB₀, hZero⟩
  let B : ℝ := max B₀ H
  have hB₀B : B₀ ≤ B := le_max_left _ _
  have hHB : H ≤ B := le_max_right _ _
  let S : Set ℝ := Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)
  let K : Set (ℝ × ℝ) := S ×ˢ Set.Ioc H B
  let T : Set (ℝ × ℝ) := S ×ˢ Set.Ioi B
  have hleft : IntegrableOn (selectedHeightGraphDensity n q u) K
      ((volume : Measure ℝ).prod volume) := by
    have hCompact : IsCompact (S ×ˢ Set.Icc H B) :=
      isCompact_Icc.prod isCompact_Icc
    have hContinuous : ContinuousOn
        (selectedHeightGraphDensity n q u) (S ×ˢ Set.Icc H B) :=
      (selectedHeightGraphDensity_continuousOn_positive n q u).mono
        (by
          intro p hp
          exact ⟨Set.mem_univ _, hH.trans_le hp.2.1⟩)
    exact (hContinuous.integrableOn_compact
      (μ := (volume : Measure ℝ).prod volume) hCompact).mono_set
        (Set.prod_mono_right Set.Ioc_subset_Icc_self)
  have hright : IntegrableOn (selectedHeightGraphDensity n q u) T
      ((volume : Measure ℝ).prod volume) := by
    apply integrableOn_zero.congr
    filter_upwards [ae_restrict_mem
      (measurableSet_Icc.prod measurableSet_Ioi)] with p hp
    exact (hZero p.1 hp.1 p.2 (hB₀B.trans_lt hp.2)).symm
  have hUnion : K ∪ T = S ×ˢ Set.Ioi H := by
    ext p
    constructor
    · intro hp
      rcases hp with hp | hp
      · exact ⟨hp.1, hp.2.1⟩
      · exact ⟨hp.1, hHB.trans_lt hp.2⟩
    · intro hp
      by_cases hle : p.2 ≤ B
      · exact Or.inl ⟨hp.1, hp.2, hle⟩
      · exact Or.inr ⟨hp.1, lt_of_not_ge hle⟩
  change IntegrableOn (selectedHeightGraphDensity n q u)
    (S ×ˢ Set.Ioi H) ((volume : Measure ℝ).prod volume)
  rw [← hUnion]
  exact hleft.union hright

theorem selectedHeightGraphEnergy_iterated_integrableOn
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {H : ℝ} (hH : 0 < H) :
    IntegrableOn (fun t =>
        ∫ y in Set.Ioi H, selectedHeightGraphDensity n q u (t, y))
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) := by
  let μ : Measure ℝ :=
    (volume : Measure ℝ).restrict
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ioi H)
  have hProd : Integrable (selectedHeightGraphDensity n q u)
      (μ.prod ν) := by
    change Integrable (selectedHeightGraphDensity n q u)
      (((volume : Measure ℝ).restrict
          (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioi H)))
    rw [Measure.prod_restrict]
    exact selectedHeightGraphDensity_integrableOn_stripTail n q u hH
  exact hProd.integral_prod_left

theorem integral_selectedHeightGraphDensity_stripTail_eq_iterated
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {H : ℝ} (hH : 0 < H) :
    (∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H,
        selectedHeightGraphDensity n q u p
        ∂((volume : Measure ℝ).prod volume)) =
      ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
        ∫ y in Set.Ioi H,
          selectedHeightGraphDensity n q u (t, y) := by
  let μ : Measure ℝ :=
    (volume : Measure ℝ).restrict
      (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ioi H)
  have hProd : Integrable (selectedHeightGraphDensity n q u)
      (μ.prod ν) := by
    change Integrable (selectedHeightGraphDensity n q u)
      (((volume : Measure ℝ).restrict
          (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioi H)))
    rw [Measure.prod_restrict]
    exact selectedHeightGraphDensity_integrableOn_stripTail n q u hH
  change (∫ p, selectedHeightGraphDensity n q u p ∂μ.prod ν) =
    ∫ t, ∫ y, selectedHeightGraphDensity n q u (t, y) ∂ν ∂μ
  exact integral_prod _ hProd

/-- The scalar trace estimate has now been transported all the way to the
literal ordinary-height strip. -/
theorem norm_selectedCuspCoreTrace_sq_le_heightGraphStrip
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 ≤
      ∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ
          Set.Ioi (gammaTwoCuspLevel Y),
        selectedHeightGraphDensity n q u p
        ∂((volume : Measure ℝ).prod volume) := by
  let H := gammaTwoCuspLevel Y
  have hH : 0 < H :=
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)
  calc
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 ≤
        ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
          ∫ r in Set.Ioi (Real.log H),
            selectedLogHeightEnergyDensity n q u (t, r) :=
      norm_selectedCuspCoreTrace_sq_le_logHeightEnergy n q Y u
    _ ≤ ∫ t in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
          ∫ y in Set.Ioi H,
            selectedHeightGraphDensity n q u (t, y) := by
      apply setIntegral_mono_on
        (selectedLogHeightEnergy_iterated_integrableOn n q u (Real.log H))
        (selectedHeightGraphEnergy_iterated_integrableOn n q u hH)
        measurableSet_Icc
      intro t ht
      exact integral_selectedLogHeightEnergy_le_heightGraphTail n q Y u ht
    _ = ∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H,
          selectedHeightGraphDensity n q u p
          ∂((volume : Measure ℝ).prod volume) :=
      (integral_selectedHeightGraphDensity_stripTail_eq_iterated
        n q u hH).symm

/-! #### J. Genuine planar and Möbius Jacobian transport -/

/-- The standard closed horizontal strip in the upper half-plane, above a
specified ordinary height. -/
def selectedBaseCuspStrip (H : ℝ) : Set ℍ :=
  {z : ℍ | z.re ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧ H < z.im}

theorem selectedBaseCuspStrip_measurable (H : ℝ) :
    MeasurableSet (selectedBaseCuspStrip H) := by
  unfold selectedBaseCuspStrip
  exact
    (measurableSet_Icc.preimage UpperHalfPlane.continuous_re.measurable).inter
      (measurableSet_Ioi.preimage UpperHalfPlane.continuous_im.measurable)

/-- The product strip and its complex realization are exactly the same
measurable set. -/
theorem complex_image_heightStrip_eq_coe_image_selectedBaseCuspStrip
    {H : ℝ} (hH : 0 < H) :
    Complex.measurableEquivRealProd.symm ''
        (Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H) =
      UpperHalfPlane.coe '' selectedBaseCuspStrip H := by
  apply Set.Subset.antisymm
  · rintro w ⟨p, hp, rfl⟩
    have him : 0 <
        (Complex.measurableEquivRealProd.symm p).im := by
      simpa using hH.trans hp.2
    let z : ℍ :=
      ⟨Complex.measurableEquivRealProd.symm p, him⟩
    refine ⟨z, ?_, rfl⟩
    change z.re ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧ H < z.im
    simpa only [z, Complex.measurableEquivRealProd_symm_apply] using hp
  · rintro w ⟨z, hz, rfl⟩
    change z.re ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧
      H < z.im at hz
    refine ⟨(z.re, z.im), hz, ?_⟩
    apply Complex.ext <;>
      simp only [Complex.measurableEquivRealProd_symm_apply]

/-- Above height one the closed strip lies in the closed standard modular
tile, including both null vertical endpoints. -/
theorem selectedBaseCuspStrip_subset_fd {H : ℝ} (hH : 1 ≤ H) :
    selectedBaseCuspStrip H ⊆ ModularGroup.fd := by
  intro z hz
  change z.re ∈ Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ∧
    H < z.im at hz
  change 1 ≤ Complex.normSq (z : ℂ) ∧ |z.re| ≤ (1 : ℝ) / 2
  constructor
  · have hy : 1 < z.im := lt_of_le_of_lt hH hz.2
    simp only [Complex.normSq_apply]
    nlinarith [sq_nonneg z.re, sq_nonneg (z.im - 1)]
  · exact abs_le.mpr hz.1

/-- Every selected image of the base cusp strip is contained in the literal
chosen closed six-tile carrier. -/
theorem selectedCoset_selectedBaseCuspStrip_subset_chosenCarrier
    (q : GammaTwoRightCoset) {H : ℝ} (hH : 1 ≤ H) :
    gammaTwoCosetRep q • selectedBaseCuspStrip H ⊆
      chosenGammaTwoFundamentalDomain.carrier := by
  intro z hz
  rcases Set.mem_smul_set.mp hz with ⟨w, hw, rfl⟩
  rw [← gammaTwoClosedTileCarrier_eq_chosenCarrier]
  exact mem_gammaTwoClosedTileCarrier_iff.mpr
    ⟨q, w, selectedBaseCuspStrip_subset_fd hH hw, rfl⟩

@[simp]
theorem selectedHeightBasePoint_re_im (z : ℍ) :
    selectedHeightBasePoint z.re z.im = z := by
  unfold selectedHeightBasePoint
  exact UpperHalfPlane.ofComplex_apply z

/-- The squared conformal scale is exactly Mathlib's absolute real
Jacobian, not merely an upper bound for it. -/
theorem norm_selectedCosetConformalScaleC_sq_eq_abs_det
    (q : GammaTwoRightCoset) (z : ℍ) :
    ‖selectedCosetConformalScaleC q z‖ ^ 2 =
      |(UpperHalfPlane.smulFDeriv
        (selectedCosetGL q) (z : ℂ)).det| := by
  calc
    ‖selectedCosetConformalScaleC q z‖ ^ 2 =
        ‖selectedCosetDerivative q z‖ ^ 2 := by
      rw [norm_selectedCosetConformalScaleC_eq_derivative]
    _ = Complex.normSq (selectedCosetDerivative q z) := by
      rw [Complex.normSq_eq_norm_sq]
    _ = selectedCosetJacobian q z :=
      (selectedCosetJacobian_eq_normSq q z).symm
    _ = |(UpperHalfPlane.smulFDeriv
        (selectedCosetGL q) (z : ℂ)).det| := rfl

/-- Total ambient version of the literal graph density.  It is used only on
complex images of upper-half-plane sets. -/
noncomputable def ambientFixedPhaseEuclideanGraphDensity
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) : ℂ → ℝ :=
  fun w => fixedPhaseEuclideanGraphDensity n u
    (UpperHalfPlane.ofComplex w)

@[simp]
theorem ambientFixedPhaseEuclideanGraphDensity_coe
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) (z : ℍ) :
    ambientFixedPhaseEuclideanGraphDensity n u (z : ℂ) =
      fixedPhaseEuclideanGraphDensity n u z := by
  simp only [ambientFixedPhaseEuclideanGraphDensity,
    UpperHalfPlane.ofComplex_apply]

theorem ambientFixedPhaseEuclideanGraphDensity_nonneg
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) (w : ℂ) :
    0 ≤ ambientFixedPhaseEuclideanGraphDensity n u w :=
  fixedPhaseEuclideanGraphDensity_nonneg n u _

theorem ambientFixedPhaseEuclideanGraphDensity_integrableOn_chosenCarrier
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    IntegrableOn (ambientFixedPhaseEuclideanGraphDensity n u)
      ambientChosenCarrier (volume : Measure ℂ) := by
  change Integrable (ambientFixedPhaseEuclideanGraphDensity n u)
    ambientChosenEuclideanMeasure
  rw [← map_chosenEuclideanCarrierMeasure,
    UpperHalfPlane.measurableEmbedding_coe.integrable_map_iff]
  simpa only [Function.comp_apply,
    ambientFixedPhaseEuclideanGraphDensity_coe] using
      fixedPhaseEuclideanGraphDensity_integrable n u

/-- The ambient chosen-carrier integral is exactly the weighted sum of the
three Hilbert coordinate norms. -/
theorem integral_ambientFixedPhaseEuclideanGraphDensity_chosenCarrier
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    (∫ w in ambientChosenCarrier,
        ambientFixedPhaseEuclideanGraphDensity n u w
        ∂(volume : Measure ℂ)) =
      logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 := by
  calc
    (∫ w in ambientChosenCarrier,
        ambientFixedPhaseEuclideanGraphDensity n u w
        ∂(volume : Measure ℂ)) =
        ∫ z, fixedPhaseEuclideanGraphDensity n u z
          ∂chosenEuclideanCarrierMeasure := by
      change (∫ w, ambientFixedPhaseEuclideanGraphDensity n u w
        ∂ambientChosenEuclideanMeasure) = _
      rw [← map_chosenEuclideanCarrierMeasure]
      simpa only [Function.comp_apply,
        ambientFixedPhaseEuclideanGraphDensity_coe] using
          (UpperHalfPlane.measurableEmbedding_coe.integral_map
            (ambientFixedPhaseEuclideanGraphDensity n u))
    _ = _ := integral_fixedPhaseEuclideanGraphDensity_eq_coordinates n u

/-- Exact transport of the product height strip through the selected
Möbius chart.  The first equality is the volume-preserving real/complex
coordinate equivalence; the second is Mathlib's genuine Frechet-Jacobian
change-of-variables theorem. -/
theorem integral_selectedHeightGraphDensity_strip_eq_selectedImage
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {H : ℝ} (hH : 0 < H) :
    (∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H,
        selectedHeightGraphDensity n q u p
        ∂((volume : Measure ℝ).prod volume)) =
      ∫ w in UpperHalfPlane.coe ''
          (gammaTwoCosetRep q • selectedBaseCuspStrip H),
        ambientFixedPhaseEuclideanGraphDensity n u w
        ∂(volume : Measure ℂ) := by
  let A : Set (ℝ × ℝ) :=
    Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H
  let B : Set ℍ := selectedBaseCuspStrip H
  let e : (ℝ × ℝ) ≃ᵐ ℂ := Complex.measurableEquivRealProd.symm
  let G : ℂ → ℝ := fun w =>
    selectedHeightGraphDensity n q u (w.re, w.im)
  have hCoordinate :
      (∫ p in A, selectedHeightGraphDensity n q u p
          ∂((volume : Measure ℝ).prod volume)) =
        ∫ w in e '' A, G w ∂(volume : Measure ℂ) := by
    have hImage :=
      (Complex.volume_preserving_equiv_real_prod.symm).setIntegral_image_emb e.measurableEmbedding G A
    simpa only [A, e, G, Measure.volume_eq_prod,
      Complex.measurableEquivRealProd_symm_apply] using hImage.symm
  have hAmbientImage : e '' A = UpperHalfPlane.coe '' B := by
    simpa only [A, B, e] using
      complex_image_heightStrip_eq_coe_image_selectedBaseCuspStrip hH
  have hBaseIntegrand :
      (∫ w in UpperHalfPlane.coe '' B, G w
          ∂(volume : Measure ℂ)) =
        ∫ w in UpperHalfPlane.coe '' B,
          |(UpperHalfPlane.smulFDeriv
            (selectedCosetGL q) w).det| •
            ambientFixedPhaseEuclideanGraphDensity n u
              (selectedCosetAmbientMap q w)
          ∂(volume : Measure ℂ) := by
    apply setIntegral_congr_fun
      (UpperHalfPlane.measurableEmbedding_coe.measurableSet_image.mpr
        (selectedBaseCuspStrip_measurable H))
    rintro _w ⟨z, _hz, rfl⟩
    rw [selectedCosetAmbientMap_coe]
    simp only [G, selectedHeightBasePoint_re_im,
      ambientFixedPhaseEuclideanGraphDensity_coe]
    rw [selectedHeightGraphDensity_eq_scale_mul_fixedPhaseDensity,
      selectedHeightBasePoint_re_im,
      norm_selectedCosetConformalScaleC_sq_eq_abs_det]
    simp only [smul_eq_mul]
  have hChange := integral_complexImage_selectedCoset_smul_eq_jacobian
    q B (selectedBaseCuspStrip_measurable H)
      (ambientFixedPhaseEuclideanGraphDensity n u)
  calc
    (∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H,
        selectedHeightGraphDensity n q u p
        ∂((volume : Measure ℝ).prod volume)) =
        ∫ w in e '' A, G w ∂(volume : Measure ℂ) := hCoordinate
    _ = ∫ w in UpperHalfPlane.coe '' B, G w
          ∂(volume : Measure ℂ) := by rw [hAmbientImage]
    _ = ∫ w in UpperHalfPlane.coe '' B,
          |(UpperHalfPlane.smulFDeriv
            (selectedCosetGL q) w).det| •
            ambientFixedPhaseEuclideanGraphDensity n u
              (selectedCosetAmbientMap q w)
          ∂(volume : Measure ℂ) := hBaseIntegrand
    _ = ∫ w in UpperHalfPlane.coe ''
          (gammaTwoCosetRep q • B),
          ambientFixedPhaseEuclideanGraphDensity n u w
          ∂(volume : Measure ℂ) := hChange.symm

/-- The selected strip integral is bounded by the full chosen-carrier graph
energy. -/
theorem integral_selectedHeightGraphDensity_strip_le_coordinates
    (n : ℤ) (q : GammaTwoRightCoset)
    (u : InverseEtaFixedPhaseCore n) {H : ℝ} (hH : 1 ≤ H) :
    (∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ Set.Ioi H,
        selectedHeightGraphDensity n q u p
        ∂((volume : Measure ℝ).prod volume)) ≤
      logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 := by
  have hHpos : 0 < H := zero_lt_one.trans_le hH
  rw [integral_selectedHeightGraphDensity_strip_eq_selectedImage
    n q u hHpos]
  have hSubtype : gammaTwoCosetRep q • selectedBaseCuspStrip H ⊆
      chosenGammaTwoFundamentalDomain.carrier :=
    selectedCoset_selectedBaseCuspStrip_subset_chosenCarrier q hH
  have hAmbient : UpperHalfPlane.coe ''
      (gammaTwoCosetRep q • selectedBaseCuspStrip H) ⊆
        ambientChosenCarrier := Set.image_mono hSubtype
  calc
    (∫ w in UpperHalfPlane.coe ''
        (gammaTwoCosetRep q • selectedBaseCuspStrip H),
        ambientFixedPhaseEuclideanGraphDensity n u w
        ∂(volume : Measure ℂ)) ≤
        ∫ w in ambientChosenCarrier,
          ambientFixedPhaseEuclideanGraphDensity n u w
          ∂(volume : Measure ℂ) := by
      apply setIntegral_mono_set
        (ambientFixedPhaseEuclideanGraphDensity_integrableOn_chosenCarrier
          n u)
      · exact Filter.Eventually.of_forall fun w =>
          ambientFixedPhaseEuclideanGraphDensity_nonneg n u w
      · exact hAmbient.eventuallyLE
    _ = _ :=
      integral_ambientFixedPhaseEuclideanGraphDensity_chosenCarrier n u

/-! #### K. Explicit uniform constant and unconditional trace theorem -/

/-- A single coefficient dominates all three terms of the transported graph
energy. -/
noncomputable def selectedCuspTraceEnergyConstant (n : ℤ) : ℝ :=
  max (logHeightTraceBaseCoeff n) 3

theorem selectedCuspTraceEnergyConstant_nonneg (n : ℤ) :
    0 ≤ selectedCuspTraceEnergyConstant n := by
  exact (by norm_num : (0 : ℝ) ≤ 3).trans
    (le_max_right (logHeightTraceBaseCoeff n) 3)

theorem logHeightTraceBaseCoeff_le_selectedCuspTraceEnergyConstant
    (n : ℤ) :
    logHeightTraceBaseCoeff n ≤ selectedCuspTraceEnergyConstant n :=
  le_max_left _ _

theorem three_le_selectedCuspTraceEnergyConstant (n : ℤ) :
    (3 : ℝ) ≤ selectedCuspTraceEnergyConstant n :=
  le_max_right _ _

theorem weighted_coordinate_energy_le_selectedCuspTraceEnergyConstant
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 ≤
      selectedCuspTraceEnergyConstant n *
        (‖l2Coordinate n u‖ ^ 2 +
          ‖raisedCoordinate n u‖ ^ 2 +
          ‖loweredCoordinate n u‖ ^ 2) := by
  have hBase := mul_le_mul_of_nonneg_right
    (logHeightTraceBaseCoeff_le_selectedCuspTraceEnergyConstant n)
    (sq_nonneg ‖l2Coordinate n u‖)
  have hRaise := mul_le_mul_of_nonneg_right
    (three_le_selectedCuspTraceEnergyConstant n)
    (sq_nonneg ‖raisedCoordinate n u‖)
  have hLower := mul_le_mul_of_nonneg_right
    (three_le_selectedCuspTraceEnergyConstant n)
    (sq_nonneg ‖loweredCoordinate n u‖)
  calc
    logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 ≤
      selectedCuspTraceEnergyConstant n * ‖l2Coordinate n u‖ ^ 2 +
        selectedCuspTraceEnergyConstant n * ‖raisedCoordinate n u‖ ^ 2 +
        selectedCuspTraceEnergyConstant n * ‖loweredCoordinate n u‖ ^ 2 :=
      add_le_add (add_le_add hBase hRaise) hLower
    _ = selectedCuspTraceEnergyConstant n *
        (‖l2Coordinate n u‖ ^ 2 +
          ‖raisedCoordinate n u‖ ^ 2 +
          ‖loweredCoordinate n u‖ ^ 2) := by ring

theorem weighted_coordinate_energy_le_coreMap
    (n : ℤ) (u : InverseEtaFixedPhaseCore n) :
    logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
        3 * ‖raisedCoordinate n u‖ ^ 2 +
        3 * ‖loweredCoordinate n u‖ ^ 2 ≤
      selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2 := by
  have hsquare :
      ‖coreMap n u‖ ^ 2 =
        ‖l2Coordinate n u‖ ^ 2 +
          ‖raisedCoordinate n u‖ ^ 2 +
          ‖loweredCoordinate n u‖ ^ 2 := by
    simpa [coreMap, raisedCoordinate, loweredCoordinate] using
      (coordinates n).norm_sectionCoreMap_sq u
  rw [hsquare]
  exact weighted_coordinate_energy_le_selectedCuspTraceEnergyConstant n u

/-- Fully transported squared trace estimate, uniform in the selected cusp
and in the truncation height. -/
theorem norm_selectedCuspCoreTrace_sq_le_coreMap
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 ≤
      selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2 := by
  calc
    ‖selectedCuspCoreTrace n q Y u‖ ^ 2 ≤
        ∫ p in Set.Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) ×ˢ
            Set.Ioi (gammaTwoCuspLevel Y),
          selectedHeightGraphDensity n q u p
          ∂((volume : Measure ℝ).prod volume) :=
      norm_selectedCuspCoreTrace_sq_le_heightGraphStrip n q Y u
    _ ≤ logHeightTraceBaseCoeff n * ‖l2Coordinate n u‖ ^ 2 +
          3 * ‖raisedCoordinate n u‖ ^ 2 +
          3 * ‖loweredCoordinate n u‖ ^ 2 :=
      integral_selectedHeightGraphDensity_strip_le_coordinates
        n q u (one_le_gammaTwoCuspLevel Y)
    _ ≤ selectedCuspTraceEnergyConstant n * ‖coreMap n u‖ ^ 2 :=
      weighted_coordinate_energy_le_coreMap n u

/-- Explicit graph-norm trace constant. -/
noncomputable def selectedCuspTraceConstant (n : ℤ) : ℝ :=
  Real.sqrt (selectedCuspTraceEnergyConstant n)

theorem selectedCuspTraceConstant_nonneg (n : ℤ) :
    0 ≤ selectedCuspTraceConstant n := Real.sqrt_nonneg _

theorem selectedCuspTraceConstant_sq (n : ℤ) :
    selectedCuspTraceConstant n ^ 2 =
      selectedCuspTraceEnergyConstant n := by
  exact Real.sq_sqrt (selectedCuspTraceEnergyConstant_nonneg n)

/-- The actual selected-cusp smooth-core trace inequality, with no analytic
hypothesis left over. -/
theorem coreGraphTraceEstimate_unconditional
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    ∀ u : InverseEtaFixedPhaseCore n,
      ‖selectedCuspCoreTrace n q Y u‖ ≤
        selectedCuspTraceConstant n * ‖coreMap n u‖ := by
  intro u
  apply (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg (selectedCuspTraceConstant_nonneg n) (norm_nonneg _))).mp
  rw [mul_pow, selectedCuspTraceConstant_sq]
  exact norm_selectedCuspCoreTrace_sq_le_coreMap n q Y u




/-! #### L. Unconditional completion of the selected-cusp trace -/

/-- The exact graph trace statement at a fixed cusp and height. -/
def CoreGraphTraceEstimate
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ) : Prop :=
  ∀ u : InverseEtaFixedPhaseCore n,
    ‖selectedCuspCoreTrace n q Y u‖ ≤ C * ‖coreMap n u‖

/-- Uniform graph trace statement over all selected cusps and heights. -/
def UniformSelectedCuspCoreGraphTraceEstimate (n : ℤ) : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧
    ∀ (q : GammaTwoRightCoset) (Y : ℝ),
      CoreGraphTraceEstimate n q Y C

/-- The strip/Fubini/Jacobian argument supplies the fixed-height statement
directly. -/
theorem coreGraphTraceEstimate_proved
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    CoreGraphTraceEstimate n q Y (selectedCuspTraceConstant n) :=
  coreGraphTraceEstimate_unconditional n q Y

/-- All selected cusps and every truncation height share the same explicit
constant; hence the formerly residual uniform assertion is unconditional. -/
theorem uniformSelectedCuspCoreGraphTraceEstimate
    (n : ℤ) : UniformSelectedCuspCoreGraphTraceEstimate n := by
  refine ⟨selectedCuspTraceConstant n,
    selectedCuspTraceConstant_nonneg n, ?_⟩
  intro q Y
  exact coreGraphTraceEstimate_proved n q Y

/-- The residual inequality is exactly a bound by the three concrete
Petersson coordinates of Definition 1. -/
theorem coreGraphTraceEstimate_iff_three_coordinates
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ) :
    CoreGraphTraceEstimate n q Y C ↔
      ∀ u : InverseEtaFixedPhaseCore n,
        ‖selectedCuspCoreTrace n q Y u‖ ≤
          C * Real.sqrt
            (‖l2Coordinate n u‖ ^ 2 +
              ‖raisedCoordinate n u‖ ^ 2 +
              ‖loweredCoordinate n u‖ ^ 2) := by
  constructor
  · intro h u
    have hsquare :
        ‖coreMap n u‖ ^ 2 =
          ‖l2Coordinate n u‖ ^ 2 +
            ‖raisedCoordinate n u‖ ^ 2 +
            ‖loweredCoordinate n u‖ ^ 2 := by
      simpa [coreMap, raisedCoordinate, loweredCoordinate] using
        (coordinates n).norm_sectionCoreMap_sq u
    have hsqrt :
        Real.sqrt
            (‖l2Coordinate n u‖ ^ 2 +
              ‖raisedCoordinate n u‖ ^ 2 +
              ‖loweredCoordinate n u‖ ^ 2) =
          ‖coreMap n u‖ := by
      rw [← hsquare, Real.sqrt_sq (norm_nonneg _)]
    simpa only [hsqrt] using h u
  · intro h u
    have hsquare :
        ‖coreMap n u‖ ^ 2 =
          ‖l2Coordinate n u‖ ^ 2 +
            ‖raisedCoordinate n u‖ ^ 2 +
            ‖loweredCoordinate n u‖ ^ 2 := by
      simpa [coreMap, raisedCoordinate, loweredCoordinate] using
        (coordinates n).norm_sectionCoreMap_sq u
    have hsqrt :
        Real.sqrt
            (‖l2Coordinate n u‖ ^ 2 +
              ‖raisedCoordinate n u‖ ^ 2 +
              ‖loweredCoordinate n u‖ ^ 2) =
          ‖coreMap n u‖ := by
      rw [← hsquare, Real.sqrt_sq (norm_nonneg _)]
    simpa only [hsqrt] using h u

/-- Safe continuous extension along the dense graph-core map.  The proof
argument is the actual norm inequality above; without it no theorem claims
that this map agrees with pointwise restriction. -/
noncomputable def completedSelectedCuspTrace
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ)
    (_hC : 0 ≤ C) (hEstimate : CoreGraphTraceEstimate n q Y C) :
    GraphSobolevCompletion n →L[ℂ] SelectedHorocycleL2 :=
  (selectedCuspCoreTrace n q Y).extendOfNorm (coreMap n)

@[simp]
theorem completedSelectedCuspTrace_core
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ)
    (hC : 0 ≤ C) (hEstimate : CoreGraphTraceEstimate n q Y C)
    (u : InverseEtaFixedPhaseCore n) :
    completedSelectedCuspTrace n q Y C hC hEstimate (coreMap n u) =
      selectedCuspCoreTrace n q Y u := by
  exact LinearMap.extendOfNorm_eq (denseRange_coreMap n)
    ⟨C, hEstimate⟩ u

theorem completedSelectedCuspTrace_norm_apply_le
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ)
    (hC : 0 ≤ C) (hEstimate : CoreGraphTraceEstimate n q Y C)
    (x : GraphSobolevCompletion n) :
    ‖completedSelectedCuspTrace n q Y C hC hEstimate x‖ ≤
      C * ‖x‖ := by
  exact LinearMap.norm_extendOfNorm_apply_le
    (denseRange_coreMap n) C hEstimate x

theorem completedSelectedCuspTrace_opNorm_le
    (n : ℤ) (q : GammaTwoRightCoset) (Y C : ℝ)
    (hC : 0 ≤ C) (hEstimate : CoreGraphTraceEstimate n q Y C) :
    ‖completedSelectedCuspTrace n q Y C hC hEstimate‖ ≤ C := by
  exact LinearMap.opNorm_extendOfNorm_le
    (denseRange_coreMap n) hC hEstimate

/-! A uniform trace bound is the natural noncompact statement.  Its norm
need not tend to zero: unit graph-norm bumps may move with the cusp height.
Dense smooth-core approximation and exact eventual core vanishing are enough
for strong convergence of every fixed completed vector. -/

/-- Height-indexed completed traces under one uniform graph-norm constant. -/
noncomputable def completedSelectedCuspTraceUniformFamily
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ) (hC : 0 ≤ C)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y C) :
    ℝ → GraphSobolevCompletion n →L[ℂ] SelectedHorocycleL2 :=
  fun Y => completedSelectedCuspTrace n q Y C hC (hEstimate Y)

theorem completedSelectedCuspTraceUniformFamily_norm_apply_le
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ) (hC : 0 ≤ C)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y C)
    (Y : ℝ) (x : GraphSobolevCompletion n) :
    ‖completedSelectedCuspTraceUniformFamily
        n q C hC hEstimate Y x‖ ≤ C * ‖x‖ :=
  completedSelectedCuspTrace_norm_apply_le
    n q Y C hC (hEstimate Y) x

/-- Uniform boundedness plus dense-core exact tail vanishing gives the full
strong trace limit on the graph completion.  This is the required `3ε`
argument; no operator-norm decay and no subsequence extraction is used. -/
theorem completedSelectedCuspTraceUniformFamily_tendsto_zero
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ) (hC : 0 ≤ C)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y C)
    (x : GraphSobolevCompletion n) :
    Filter.Tendsto
      (fun Y => completedSelectedCuspTraceUniformFamily
        n q C hC hEstimate Y x)
      Filter.atTop (nhds 0) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hCOne : 0 < C + 1 := by linarith
  obtain ⟨u, hu⟩ := (denseRange_coreMap n).exists_dist_lt x
    (div_pos hε hCOne)
  rcases fixedPhaseCore_eventually_selectedCuspCoreTrace_eq_zero n u with
    ⟨Y₀, _hY₀, hZero⟩
  refine ⟨Y₀ + 1, ?_⟩
  intro Y hY
  have hCoreZero :
      completedSelectedCuspTraceUniformFamily
          n q C hC hEstimate Y (coreMap n u) = 0 := by
    rw [completedSelectedCuspTraceUniformFamily,
      completedSelectedCuspTrace_core]
    exact hZero Y (lt_of_lt_of_le (lt_add_one Y₀) hY) q
  have hApprox : ‖x - coreMap n u‖ < ε / (C + 1) := by
    simpa only [dist_eq_norm] using hu
  have hFactor : C * (ε / (C + 1)) < ε := by
    have hratio : C / (C + 1) < 1 :=
      (div_lt_one hCOne).2 (lt_add_one C)
    calc
      C * (ε / (C + 1)) = ε * (C / (C + 1)) := by
        field_simp [ne_of_gt hCOne]
        ring
      _ < ε * 1 := mul_lt_mul_of_pos_left hratio hε
      _ = ε := mul_one ε
  have hBound :
      ‖completedSelectedCuspTraceUniformFamily
          n q C hC hEstimate Y (x - coreMap n u)‖ < ε :=
    lt_of_le_of_lt
      (completedSelectedCuspTraceUniformFamily_norm_apply_le
        n q C hC hEstimate Y (x - coreMap n u))
      ((mul_le_mul_of_nonneg_left hApprox.le hC).trans_lt hFactor)
  have hRewrite :
      completedSelectedCuspTraceUniformFamily
          n q C hC hEstimate Y x =
        completedSelectedCuspTraceUniformFamily
          n q C hC hEstimate Y (x - coreMap n u) := by
    rw [map_sub, hCoreZero, sub_zero]
  simpa only [dist_zero_right, hRewrite] using hBound

/-- Canonical completed traces obtained from the proved uniform constant. -/
noncomputable def unconditionalCompletedSelectedCuspTraceFamily
    (n : ℤ) (q : GammaTwoRightCoset) :
    ℝ → GraphSobolevCompletion n →L[ℂ] SelectedHorocycleL2 :=
  completedSelectedCuspTraceUniformFamily n q
    (selectedCuspTraceConstant n) (selectedCuspTraceConstant_nonneg n)
    (fun Y => coreGraphTraceEstimate_proved n q Y)

noncomputable def unconditionalCompletedSelectedCuspTrace
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    GraphSobolevCompletion n →L[ℂ] SelectedHorocycleL2 :=
  unconditionalCompletedSelectedCuspTraceFamily n q Y

@[simp]
theorem unconditionalCompletedSelectedCuspTrace_core
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    unconditionalCompletedSelectedCuspTrace n q Y (coreMap n u) =
      selectedCuspCoreTrace n q Y u := by
  unfold unconditionalCompletedSelectedCuspTrace
    unconditionalCompletedSelectedCuspTraceFamily
    completedSelectedCuspTraceUniformFamily
  exact completedSelectedCuspTrace_core n q Y
    (selectedCuspTraceConstant n) (selectedCuspTraceConstant_nonneg n)
    (coreGraphTraceEstimate_proved n q Y) u

theorem unconditionalCompletedSelectedCuspTrace_opNorm_le
    (n : ℤ) (q : GammaTwoRightCoset) (Y : ℝ) :
    ‖unconditionalCompletedSelectedCuspTrace n q Y‖ ≤
      selectedCuspTraceConstant n := by
  unfold unconditionalCompletedSelectedCuspTrace
    unconditionalCompletedSelectedCuspTraceFamily
    completedSelectedCuspTraceUniformFamily
  exact completedSelectedCuspTrace_opNorm_le n q Y
    (selectedCuspTraceConstant n) (selectedCuspTraceConstant_nonneg n)
    (coreGraphTraceEstimate_proved n q Y)

/-- Every vector in the full graph completion has an actual full strong
selected-cusp trace limit, with no residual estimate parameter. -/
theorem unconditionalCompletedSelectedCuspTrace_tendsto_zero
    (n : ℤ) (q : GammaTwoRightCoset)
    (x : GraphSobolevCompletion n) :
    Filter.Tendsto
      (fun Y => unconditionalCompletedSelectedCuspTrace n q Y x)
      Filter.atTop (nhds 0) := by
  simpa only [unconditionalCompletedSelectedCuspTrace,
    unconditionalCompletedSelectedCuspTraceFamily] using
      completedSelectedCuspTraceUniformFamily_tendsto_zero
        n q (selectedCuspTraceConstant n)
        (selectedCuspTraceConstant_nonneg n)
        (fun Y => coreGraphTraceEstimate_proved n q Y) x

/-- The abstract packaging theorem remains available for downstream users
who wish to substitute another uniform constant. -/
theorem UniformSelectedCuspCoreGraphTraceEstimate.exists_fullStrongTraceLimit
    {n : ℤ} (hUniform : UniformSelectedCuspCoreGraphTraceEstimate n) :
    ∃ (C : ℝ) (hC : 0 ≤ C)
        (hEstimate : ∀ (q : GammaTwoRightCoset) (Y : ℝ),
          CoreGraphTraceEstimate n q Y C),
      ∀ (q : GammaTwoRightCoset) (x : GraphSobolevCompletion n),
        Filter.Tendsto
          (fun Y => completedSelectedCuspTraceUniformFamily
            n q C hC (hEstimate q) Y x)
          Filter.atTop (nhds 0) := by
  rcases hUniform with ⟨C, hC, hEstimate⟩
  refine ⟨C, hC, hEstimate, ?_⟩
  intro q x
  exact completedSelectedCuspTraceUniformFamily_tendsto_zero
    n q C hC (hEstimate q) x

/-- A height-indexed family of genuine completed traces, constructed from a
height-indexed family of the single explicit core estimate. -/
noncomputable def completedSelectedCuspTraceFamily
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ → ℝ)
    (hC : ∀ Y, 0 ≤ C Y)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y (C Y)) :
    ℝ → GraphSobolevCompletion n →L[ℂ] SelectedHorocycleL2 :=
  fun Y => completedSelectedCuspTrace n q Y (C Y)
    (hC Y) (hEstimate Y)

theorem completedSelectedCuspTraceFamily_opNorm_le
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ → ℝ)
    (hC : ∀ Y, 0 ≤ C Y)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y (C Y))
    (Y : ℝ) :
    ‖completedSelectedCuspTraceFamily n q C hC hEstimate Y‖ ≤ C Y := by
  exact completedSelectedCuspTrace_opNorm_le n q Y (C Y)
    (hC Y) (hEstimate Y)

/-- Operator-norm cusp-tail tightness implies norm convergence of the entire
trace family, not merely decay of one scalar prefactor. -/
theorem completedSelectedCuspTraceFamily_opNorm_tendsto_zero
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ → ℝ)
    (hC : ∀ Y, 0 ≤ C Y)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y (C Y))
    (hCZero : Filter.Tendsto C Filter.atTop (nhds 0)) :
    Filter.Tendsto
      (fun Y =>
        ‖completedSelectedCuspTraceFamily n q C hC hEstimate Y‖)
      Filter.atTop (nhds 0) :=
  squeeze_zero
    (fun Y => norm_nonneg
      (completedSelectedCuspTraceFamily n q C hC hEstimate Y))
    (completedSelectedCuspTraceFamily_opNorm_le
      n q C hC hEstimate) hCZero

/-- Therefore every vector of the full graph/form domain has a genuine full
`Y → ∞` trace limit. -/
theorem completedSelectedCuspTraceFamily_tendsto_zero
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ → ℝ)
    (hC : ∀ Y, 0 ≤ C Y)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y (C Y))
    (hCZero : Filter.Tendsto C Filter.atTop (nhds 0))
    (x : GraphSobolevCompletion n) :
    Filter.Tendsto
      (fun Y => completedSelectedCuspTraceFamily n q C hC hEstimate Y x)
      Filter.atTop (nhds 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  exact squeeze_zero
    (fun Y => norm_nonneg
      (completedSelectedCuspTraceFamily n q C hC hEstimate Y x))
    (fun Y =>
      (completedSelectedCuspTraceFamily n q C hC hEstimate Y).le_opNorm x)
    ((completedSelectedCuspTraceFamily_opNorm_tendsto_zero
      n q C hC hEstimate hCZero).mul_const ‖x‖)

/-! #### F. Full-limit and subsequence vanishing are kept distinct -/

/-- Vanishing along some cofinal, strictly increasing sequence of heights. -/
def HasCofinalTraceVanishingSubsequence
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F]
    (T : ℝ → E →L[ℂ] F) (x : E) : Prop :=
  ∃ φ : ℕ → ℝ, StrictMono φ ∧ Filter.Tendsto φ Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun j => T (φ j) x) Filter.atTop (nhds 0)

/-- Full trace decay at every real height implies subsequence decay.  No
converse is asserted. -/
theorem hasCofinalTraceVanishingSubsequence_of_fullLimit
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [NormedSpace ℂ F]
    (T : ℝ → E →L[ℂ] F) (x : E)
    (hFull : Filter.Tendsto (fun Y => T Y x) Filter.atTop (nhds 0)) :
    HasCofinalTraceVanishingSubsequence T x := by
  refine ⟨fun j : ℕ => (j : ℝ), Nat.strictMono_cast,
    tendsto_natCast_atTop_atTop, ?_⟩
  exact hFull.comp tendsto_natCast_atTop_atTop

theorem completedSelectedCuspTraceFamily_hasCofinalSubsequence
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ → ℝ)
    (hC : ∀ Y, 0 ≤ C Y)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y (C Y))
    (hCZero : Filter.Tendsto C Filter.atTop (nhds 0))
    (x : GraphSobolevCompletion n) :
    HasCofinalTraceVanishingSubsequence
      (completedSelectedCuspTraceFamily n q C hC hEstimate) x :=
  hasCofinalTraceVanishingSubsequence_of_fullLimit
    (completedSelectedCuspTraceFamily n q C hC hEstimate) x
    (completedSelectedCuspTraceFamily_tendsto_zero
      n q C hC hEstimate hCZero x)

/-- The uniform-bound/dense-core full limit also yields a cofinal
subsequence, strictly as a corollary of the stronger result. -/
theorem completedSelectedCuspTraceUniformFamily_hasCofinalSubsequence
    (n : ℤ) (q : GammaTwoRightCoset) (C : ℝ) (hC : 0 ≤ C)
    (hEstimate : ∀ Y, CoreGraphTraceEstimate n q Y C)
    (x : GraphSobolevCompletion n) :
    HasCofinalTraceVanishingSubsequence
      (completedSelectedCuspTraceUniformFamily n q C hC hEstimate) x :=
  hasCofinalTraceVanishingSubsequence_of_fullLimit
    (completedSelectedCuspTraceUniformFamily n q C hC hEstimate) x
    (completedSelectedCuspTraceUniformFamily_tendsto_zero
      n q C hC hEstimate x)

/-- Two full `L²` trace limits force the corresponding Hilbert boundary
pairing to vanish.  This is a trace theorem, not an inference from decay of a
scalar weight alone. -/
theorem inner_trace_tendsto_zero
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (T U : ℝ → E →L[ℂ] F) (x y : E)
    (hT : Filter.Tendsto (fun Y => T Y x) Filter.atTop (nhds 0))
    (hU : Filter.Tendsto (fun Y => U Y y) Filter.atTop (nhds 0)) :
    Filter.Tendsto (fun Y => inner ℂ (T Y x) (U Y y)) Filter.atTop (nhds 0) := by
  simpa using hT.inner hU

