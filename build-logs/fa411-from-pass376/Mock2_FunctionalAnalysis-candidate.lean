#print axioms FixedPhaseGoodCuspCutoffBridge.intrinsicQuotientCuspCutoffReal_support_subset_truncation
#print axioms FixedPhaseGoodCuspCutoffBridge.intrinsicCuspCutoff_quotientCompact

