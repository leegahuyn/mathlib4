#print axioms FixedPhaseReducedChartFriedrichs.effectiveScalarPoincarePeriodization_eq_seed_on_reducedChart
#print axioms FixedPhaseReducedChartFriedrichs.quotientChartNormalizationDenominator_ne_zero
#print axioms FixedPhaseReducedChartFriedrichs.normalizedQuotientChartPeriodizations_sum_eq_one_on_saturation
#print axioms FixedPhaseReducedChartFriedrichs.exists_quotientCompatibleFiniteReducedChartLocalization

end AxiomAuditP3QuotientCompatibleFiniteGluing
