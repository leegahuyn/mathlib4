/-!
This fragment is intended to be appended after P3.26 (and before the final
P3/P4 endpoint wrappers) of `Mock2_FunctionalAnalysis_Integrated.lean`.

It removes the polygon-boundary defect from local periodization.  The key
arithmetic point is proved rather than assumed: the effective action of
`Gamma(2)` on the upper half-plane is free.  Hence a reduced chart meets no
nontrivial effective translate, and normalized Poincare periodization of a
seed supported in that chart agrees with the seed throughout the chart.
This is the chart statement needed by Friedrichs regularization at paired
sides; no zero extension through a chosen-carrier boundary occurs here.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseReducedChartFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped BigOperators
open HalfIntegralMultiplier
open DefinitionOneSobolev
open GammaTwoQuotientGeometry
open SmoothCompactCoreGeometry
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseEssentialCoreRoute
open FixedPhaseClosedOperators

noncomputable section

/-! ### Torsion-freeness of the effective level-two action -/

/-- A level-two matrix fixing a point of the closed modular fundamental
domain is central.  The finite Serre list is already a Mathlib theorem; each
noncentral entry in that list is excluded by its literal reduction modulo
two. -/
private theorem gammaTwo_mem_stabilizer_fd_eq_one_or_neg_one
    {g : SL(2, ℤ)} (hgΓ : g ∈ CongruenceSubgroup.Gamma 2)
    {z : ℍ} (hz : z ∈ ModularGroup.fd) (hgz : g • z = z) :
    g = 1 ∨ g = -1 := by
  have hcases := ModularGroup.cases_of_mem_fd_smul_mem_fd
    (g := g) hz (hgz.symm ▸ hz)
  rcases hcases with hpm | hT | hTinv | hS | hTS | hTinvSTinv |
      hSTinv | hST | hTST | hTinvS
  · exact hpm
  · rcases hT.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T] at hgΓ
  · rcases hTinv.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T] at hgΓ
  · rcases hS.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.S] at hgΓ
  · rcases hTS.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ
  · rcases hTinvSTinv.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ
  · rcases hSTinv.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ
  · rcases hST.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ
  · rcases hTST.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ
  · rcases hTinvS.1 with rfl | rfl <;>
      rw [CongruenceSubgroup.Gamma_mem] at hgΓ <;>
      norm_num [ModularGroup.T, ModularGroup.S] at hgΓ

/-- The full stabilizer in raw `Gamma(2)` is precisely the central action
kernel.  Conjugation into the closed modular domain is legitimate because
the principal congruence subgroup is normal. -/
theorem gammaTwo_eq_one_or_centralNegOne_of_fixed
    (gamma : GammaTwo) {z : ℍ}
    (hfix : ((gamma : SL(2, ℤ)) • z) = z) :
    gamma = 1 ∨ gamma = gammaTwoCentralNegOne := by
  obtain ⟨delta, hdelta⟩ := ModularGroup.exists_smul_mem_fd z
  let w : ℍ := delta • z
  let conjugate : SL(2, ℤ) :=
    delta * (gamma : SL(2, ℤ)) * delta⁻¹
  have hConjugateMem : conjugate ∈ CongruenceSubgroup.Gamma 2 := by
    exact (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (gamma : SL(2, ℤ)) gamma.property delta
  have hConjugateFix : conjugate • w = w := by
    dsimp only [conjugate, w]
    simp only [mul_smul, inv_smul_smul, hfix]
  have hCentral : conjugate = 1 ∨ conjugate = -1 :=
    gammaTwo_mem_stabilizer_fd_eq_one_or_neg_one
      hConjugateMem hdelta hConjugateFix
  rcases hCentral with hOne | hNeg
  · left
    apply Subtype.ext
    have h := congrArg
      (fun a : SL(2, ℤ) ↦ delta⁻¹ * a * delta) hOne
    simpa [conjugate, mul_assoc] using h
  · right
    apply Subtype.ext
    have h := congrArg
      (fun a : SL(2, ℤ) ↦ delta⁻¹ * a * delta) hNeg
    simpa [conjugate, gammaTwoCentralNegOne_coe, mul_assoc] using h

/-- The effective quotient action is free, including above elliptic points
of the full modular group: those elliptic stabilizers do not reduce to the
identity modulo two. -/
theorem gammaTwoEffective_eq_one_of_smul_eq
    (a : GammaTwoEffective) (z : ℍ) (ha : a • z = z) :
    a = 1 := by
  obtain ⟨gamma, hgamma⟩ := effective_exists_gamma a
  have hfix : ((gamma : SL(2, ℤ)) • z) = z := by
    rw [← hgamma z, ha]
  have hcentral := gammaTwo_eq_one_or_centralNegOne_of_fixed gamma hfix
  apply Subtype.ext
  apply Equiv.ext
  intro w
  change a • w = (1 : GammaTwoEffective) • w
  rw [hgamma w]
  rcases hcentral with rfl | rfl
  · simp only [one_smul]
  · simpa only [one_smul] using gammaTwoCentralNegOne_smul w

theorem gammaTwoEffective_smul_eq_iff
    (a : GammaTwoEffective) (z : ℍ) :
    a • z = z ↔ a = 1 := by
  constructor
  · exact gammaTwoEffective_eq_one_of_smul_eq a z
  · rintro rfl
    exact one_smul _ _

/-- The earlier reduced-chart overlap conclusion is therefore equality of
the effective translate, not merely membership in a finite stabilizer. -/
theorem gammaTwoReducedChart_inter_translate_imp_eq_one
    (z : ℍ) (a : GammaTwoEffective)
    (h : (((a • ·) '' gammaTwoReducedChart z) ∩
      gammaTwoReducedChart z).Nonempty) :
    a = 1 :=
  gammaTwoEffective_eq_one_of_smul_eq a z
    (gammaTwoReducedChart_inter_translate_imp_smul_eq z a h)

theorem gammaTwoReducedChart_disjoint_translate
    (z : ℍ) (a : GammaTwoEffective) (ha : a ≠ 1) :
    Disjoint ((a • ·) '' gammaTwoReducedChart z)
      (gammaTwoReducedChart z) := by
  rw [Set.disjoint_left]
  intro x hxa hx
  exact ha <| gammaTwoReducedChart_inter_translate_imp_eq_one z a
    ⟨x, hxa, hx⟩

/-! ### Exact Poincare extension on every reduced chart -/

theorem gammaTwoPeriodizationSeedSupport_subset_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀) :
    gammaTwoPeriodizationSeedSupport m v ⊆
      gammaTwoReducedChart z₀ := by
  intro z hz
  have hzSupport : (z : ℂ) ∈ tsupport (v : ℂ → ℂ) :=
    gammaTwoPeriodizationSeedCore_tsupport_subset m v hz
  rcases hv hzSupport with ⟨w, hw, hwz⟩
  have hwEq : w = z := UpperHalfPlane.coe_injective hwz
  simpa only [hwEq] using hw

/-- At a point of a reduced chart, only the two raw central representatives
of the effective identity can contribute to a seed supported in that chart.
-/
theorem support_periodizationIndex_at_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    Function.support
        (fun gamma : GammaTwo ↦
          gammaTwoPeriodizationTerm m v gamma x) ⊆
      ({1, gammaTwoCentralNegOne} : Finset GammaTwo) := by
  intro gamma hgamma
  have hseed : gammaTwoPeriodizationSeed m v
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • x) ≠ 0 := by
    intro hzero
    apply hgamma
    simp only [gammaTwoPeriodizationTerm, hzero, mul_zero]
  have hpre : (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • x) ∈
      gammaTwoPeriodizationSeedSupport m v := by
    change
      (((((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • x : ℍ) : ℂ) ∈
        tsupport
          (gammaTwoPeriodizationSeedCore m v : ℂ → ℂ))
    exact subset_tsupport hseed
  have hpreChart :
      (((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • x) ∈
        gammaTwoReducedChart z₀ :=
    gammaTwoPeriodizationSeedSupport_subset_reducedChart hv hpre
  let a : GammaTwoEffective := gammaTwoEffectiveElement gamma
  have hxTranslate : x ∈ (a • ·) '' gammaTwoReducedChart z₀ := by
    refine ⟨((gamma⁻¹ : GammaTwo) : SL(2, ℤ)) • x,
      hpreChart, ?_⟩
    simp [a, gammaTwoEffectiveElement_smul]
  have ha : a = 1 :=
    gammaTwoReducedChart_inter_translate_imp_eq_one z₀ a
      ⟨x, hxTranslate, hx⟩
  have hkernel :=
    gammaTwo_eq_one_or_centralNegOne_of_effective_eq_one gamma ha
  simpa only [Finset.mem_insert, Finset.mem_singleton] using hkernel

/-- Normalized periodization is literally the inverse-gauge seed throughout
an arbitrary reduced chart. -/
theorem gammaTwoPoincarePeriodization_eq_seed_on_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    gammaTwoPoincarePeriodization m v x =
      gammaTwoPeriodizationSeed m v x := by
  unfold gammaTwoPoincarePeriodization
  rw [finsum_eq_sum_of_support_subset _
    (support_periodizationIndex_at_reducedChart hv hx)]
  simp [gammaTwoCentralNegOne_ne_one]
  ring

/-- The Euclidean gauge of the periodized physical core agrees with its
ambient seed on the reduced chart, including across every paired side. -/
theorem fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
        (gammaTwoPeriodizedPhysicalCore m v) x = v (x : ℂ) := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge_apply]
  change (((x.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent m : ℝ) : ℂ) *
      gammaTwoPoincarePeriodization m v x) = v (x : ℂ)
  rw [gammaTwoPoincarePeriodization_eq_seed_on_reducedChart hv hx,
    gammaTwoPeriodizationSeed_apply,
    Real.rpow_neg x.im_pos.le]
  have hp : x.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent m ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos x.im_pos _)
  have hcancel :
      ((x.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent m : ℝ) : ℂ) *
          (((x.im ^ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanGaugeExponent m)⁻¹ : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul]
    simp [hp]
  rw [← mul_assoc, hcancel, one_mul]

/-- `EqOn` packaging used by every subsequent reduced-chart synthesis and
Friedrichs lemma. -/
theorem gammaTwoPeriodizedPhysicalCore_gauge_eqOn_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀) :
    Set.EqOn
      (SmoothCompactCoreGeometry.upperLift
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
          (gammaTwoPeriodizedPhysicalCore m v)))
      (v : ℂ → ℂ)
      (ambientGammaTwoReducedChart z₀) := by
  intro w hw
  rcases hw with ⟨x, hx, rfl⟩
  rw [SmoothCompactCoreGeometry.upperLift_apply]
  exact
    fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
      hv hx

/-! ### Differentiated chart identities

The following statements are deliberately local to the reduced chart.  They
are the seam-safe replacements for the earlier open-polygon identities: the
equality is available on a genuine open neighbourhood of every chart point,
so real Frechet derivatives may be transported without a boundary trace.
-/

theorem periodizedGauge_eventuallyEq_ambientTest_on_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    SmoothCompactCoreGeometry.upperLift
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
          (gammaTwoPeriodizedPhysicalCore m v)) =ᶠ[nhds (x : ℂ)]
      (v : ℂ → ℂ) := by
  apply
    (gammaTwoPeriodizedPhysicalCore_gauge_eqOn_reducedChart
      (m := m) hv).eventuallyEq_of_mem
  exact (ambientGammaTwoReducedChart_isOpen z₀).mem_nhds
    ⟨x, hx, rfl⟩

theorem dx_periodizedGauge_eq_ambientTest_on_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    HalfWeightDifferentialOperators.dx
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
          (gammaTwoPeriodizedPhysicalCore m v)) x =
      HalfWeightCompactCoordinateGreen.dx v (x : ℂ) := by
  unfold HalfWeightDifferentialOperators.dx
    HalfWeightDifferentialOperators.d1
  rw [(periodizedGauge_eventuallyEq_ambientTest_on_reducedChart
    (m := m) hv hx).fderiv_eq]
  exact
    (HalfWeightCompactCoordinateGreen.directionalDerivative_apply
      1 v (x : ℂ)).symm

theorem dy_periodizedGauge_eq_ambientTest_on_reducedChart
    {m : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    HalfWeightDifferentialOperators.dy
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge m
          (gammaTwoPeriodizedPhysicalCore m v)) x =
      HalfWeightCompactCoordinateGreen.dy v (x : ℂ) := by
  unfold HalfWeightDifferentialOperators.dy
    HalfWeightDifferentialOperators.d1
  rw [(periodizedGauge_eventuallyEq_ambientTest_on_reducedChart
    (m := m) hv hx).fderiv_eq]
  exact
    (HalfWeightCompactCoordinateGreen.directionalDerivative_apply
      Complex.I v (x : ℂ)).symm

/-- Forward raising of a reduced-chart periodization is literally the
ambient forward affine Maass expression throughout that chart. -/
theorem euclideanRaiseGauge_periodized_eq_forwardTest_on_reducedChart
    {n : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseGauge n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n
          (gammaTwoPeriodizedPhysicalCore n v)) x =
      euclideanRaiseForwardTest n v (x : ℂ) := by
  have hdx := dx_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n) hv hx
  have hdy := dy_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n) hv hx
  have hval :=
    fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
      (m := n) hv hx
  simp only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseGauge,
    euclideanRaiseForwardTest, add_apply,
    smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightDifferentialOperators.heightC, smul_eq_mul]
  rw [hdx, hdy, hval]
  ring

/-- Forward lowering from the successor gauge satisfies the identical
seam-safe chart formula. -/
theorem euclideanLowerFromSuccGauge_periodized_eq_forwardTest_on_reducedChart
    {n : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccGauge n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n + 1)
          (gammaTwoPeriodizedPhysicalCore (n + 1) v)) x =
      euclideanLowerFromSuccForwardTest n v (x : ℂ) := by
  have hdx := dx_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n + 1) hv hx
  have hdy := dy_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n + 1) hv hx
  have hval :=
    fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
      (m := n + 1) hv hx
  simp only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccGauge,
    euclideanLowerFromSuccForwardTest, add_apply,
    sub_apply, smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightDifferentialOperators.heightC, smul_eq_mul]
  rw [hdx, hdy, hval]
  ring

/-! ### Signed test-adjoint chart identities -/

/-- On a reduced-chart periodization, signed lowering from the successor
gauge is exactly the Hermitian test transpose of raising.  The coefficient
`p + 1` is retained literally. -/
theorem neg_euclideanLowerFromSuccGauge_periodized_eq_raiseTestAdjoint_on_reducedChart
    {n : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    -Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccGauge n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n + 1)
          (gammaTwoPeriodizedPhysicalCore (n + 1) v)) x =
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseTestAdjoint n v (x : ℂ) := by
  have hdx := dx_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n + 1) hv hx
  have hdy := dy_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n + 1) hv hx
  have hval :=
    fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
      (m := n + 1) hv hx
  simp only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccGauge,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseTestAdjoint,
    add_apply, sub_apply,
    smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightDifferentialOperators.heightC, smul_eq_mul]
  rw [hdx, hdy, hval]
  ring

/-- Dually, signed raising on a reduced-chart periodization is the exact
lowering-from-successor test transpose, including its `p + 2` coefficient. -/
theorem neg_euclideanRaiseGauge_periodized_eq_lowerFromSuccTestAdjoint_on_reducedChart
    {n : ℤ} {v : Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore} {z₀ x : ℍ}
    (hv : tsupport (v : ℂ → ℂ) ⊆
      ambientGammaTwoReducedChart z₀)
    (hx : x ∈ gammaTwoReducedChart z₀) :
    -Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseGauge n
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge n
          (gammaTwoPeriodizedPhysicalCore n v)) x =
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccTestAdjoint n v (x : ℂ) := by
  have hdx := dx_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n) hv hx
  have hdy := dy_periodizedGauge_eq_ambientTest_on_reducedChart
    (m := n) hv hx
  have hval :=
    fixedPhaseEuclideanGauge_periodized_eq_ambientTest_on_reducedChart
      (m := n) hv hx
  simp only [Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanRaiseGauge,
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.euclideanLowerFromSuccTestAdjoint,
    add_apply, sub_apply,
    smul_apply,
    HalfWeightCompactCoordinateGreen.rpowMul_apply,
    HalfWeightCompactCoordinateGreen.rpowScale, Real.rpow_one,
    HalfWeightDifferentialOperators.heightC, smul_eq_mul]
  rw [hdx, hdy, hval]
  ring

end
