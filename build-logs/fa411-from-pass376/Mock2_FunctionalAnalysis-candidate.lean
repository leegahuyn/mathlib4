/-!
### P3.20: the literal affine commutator kernel

For `P = y (sigma partial_x + partial_y) + c`, convolution by the normalized
kernel has one Friedrichs error.  After weak integration by parts its kernel
is

`(sigma partial_x + partial_y) (t.im * rho_j(t))`.

The following construction bundles the unit version as a genuine full-plane
test function.  Dilation then proves, without a derivative certificate, that
the kernel has mean zero, a stage-independent `L1` norm, and shrinking
support.  The same family works for `sigma = I` and `sigma = -I`, which is
the simultaneous raising/lowering feature needed by the joint graph.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

/-- Full-plane compact smooth tests.  Unlike the earlier upper-plane test
core, this type is appropriate for a translation-invariant convolution
kernel centred at the origin. -/
abbrev FullPlaneTest := TestFunction (⊤ : Opens ℂ) ℂ ∞

/-- A full-plane test is Bochner integrable. -/
theorem fullPlaneTest_integrable (v : FullPlaneTest) :
    Integrable (v : ℂ → ℂ) (volume : Measure ℂ) :=
  v.continuous.integrable_of_hasCompactSupport v.hasCompactSupport

/-- Bundled real directional derivative of a full-plane test. -/
noncomputable def fullPlaneDirectionalDerivative
    (xi : ℂ) (v : FullPlaneTest) : FullPlaneTest :=
  TestFunction.lineDerivCLM ℂ xi v

@[simp]
theorem fullPlaneDirectionalDerivative_apply
    (xi : ℂ) (v : FullPlaneTest) (t : ℂ) :
    fullPlaneDirectionalDerivative xi v t =
      fderiv ℝ (v : ℂ → ℂ) t xi := by
  rw [fullPlaneDirectionalDerivative,
    TestFunction.lineDerivCLM_eq_fderivCLM,
    TestFunction.fderivCLM_apply_of_le (hk := by simp)]

theorem tsupport_fullPlaneDirectionalDerivative_subset
    (xi : ℂ) (v : FullPlaneTest) :
    tsupport (fullPlaneDirectionalDerivative xi v : ℂ → ℂ) ⊆
      tsupport (v : ℂ → ℂ) := by
  simpa only [fullPlaneDirectionalDerivative_apply] using
    (tsupport_fderiv_apply_subset ℝ xi :
      tsupport (fun t : ℂ ↦ fderiv ℝ (v : ℂ → ℂ) t xi) ⊆
        tsupport (v : ℂ → ℂ))

/-- Every directional derivative of a full-plane compact test has integral
zero. -/
theorem integral_fullPlaneDirectionalDerivative_eq_zero
    (xi : ℂ) (v : FullPlaneTest) :
    (∫ t : ℂ, fullPlaneDirectionalDerivative xi v t) = 0 := by
  have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (mu := (volume : Measure ℂ))
    (f := fun _t : ℂ ↦ (1 : ℂ)) (g := (v : ℂ → ℂ))
    (v := xi)
    (by simpa using (integrable_zero :
      Integrable (fun _t : ℂ ↦ (0 : ℂ)) volume))
    (by simpa only [one_mul, fullPlaneDirectionalDerivative_apply] using
      fullPlaneTest_integrable (fullPlaneDirectionalDerivative xi v))
    (by simpa only [one_mul] using fullPlaneTest_integrable v)
    (fun t _ ↦ differentiableAt_const (c := (1 : ℂ)))
    (fun t _ ↦ (v.contDiff.differentiable (by simp)) t)
  simpa only [one_mul, zero_mul, integral_zero, neg_zero,
    fullPlaneDirectionalDerivative_apply] using h

/-- The unit mollifier bundled as a genuine compact smooth full-plane test. -/
noncomputable def friedrichsUnitMollifierTest : FullPlaneTest where
  toFun := friedrichsUnitMollifier
  contDiff' := friedrichsUnitMollifier_contDiff
  hasCompactSupport' := by
    exact friedrichsUnitBump.hasCompactSupport_normed.comp_left rfl
  tsupport_subset' := subset_univ

@[simp]
theorem friedrichsUnitMollifierTest_apply (t : ℂ) :
    friedrichsUnitMollifierTest t = friedrichsUnitMollifier t :=
  rfl

/-- The compact test `t.im * rho(t)` whose derivative is the affine
commutator kernel. -/
noncomputable def friedrichsUnitHeightMollifierTest : FullPlaneTest where
  toFun := fun t : ℂ ↦ (t.im : ℂ) * friedrichsUnitMollifier t
  contDiff' := by
    have him : ContDiff ℝ ∞ (fun t : ℂ ↦ (t.im : ℂ)) :=
      (Complex.ofRealCLM.comp Complex.imCLM).contDiff
    exact him.mul friedrichsUnitMollifier_contDiff
  hasCompactSupport' :=
    friedrichsUnitMollifierTest.hasCompactSupport.mul_left
  tsupport_subset' := subset_univ

@[simp]
theorem friedrichsUnitHeightMollifierTest_apply (t : ℂ) :
    friedrichsUnitHeightMollifierTest t =
      (t.im : ℂ) * friedrichsUnitMollifier t :=
  rfl

/-- Unit affine commutator test for the constant symbol `sigma`. -/
noncomputable def friedrichsUnitAffineCommutatorTest
    (sigma : ℂ) : FullPlaneTest :=
  sigma • fullPlaneDirectionalDerivative 1
      friedrichsUnitHeightMollifierTest +
    fullPlaneDirectionalDerivative Complex.I
      friedrichsUnitHeightMollifierTest

@[simp]
theorem friedrichsUnitAffineCommutatorTest_apply
    (sigma t : ℂ) :
    friedrichsUnitAffineCommutatorTest sigma t =
      FixedPhaseAffineFriedrichs.ambientConstantMaassDerivative sigma
        (fun s : ℂ ↦ (s.im : ℂ) * friedrichsUnitMollifier s) t := by
  simp only [friedrichsUnitAffineCommutatorTest,
    add_apply, smul_apply,
    fullPlaneDirectionalDerivative_apply,
    friedrichsUnitHeightMollifierTest_apply, smul_eq_mul,
    FixedPhaseAffineFriedrichs.ambientConstantMaassDerivative]

theorem integral_friedrichsUnitAffineCommutatorTest_eq_zero
    (sigma : ℂ) :
    (∫ t : ℂ, friedrichsUnitAffineCommutatorTest sigma t) = 0 := by
  rw [friedrichsUnitAffineCommutatorTest,
    integral_add
      (fullPlaneTest_integrable
        (sigma • fullPlaneDirectionalDerivative 1
          friedrichsUnitHeightMollifierTest))
      (fullPlaneTest_integrable
        (fullPlaneDirectionalDerivative Complex.I
          friedrichsUnitHeightMollifierTest)),
    integral_smul,
    integral_fullPlaneDirectionalDerivative_eq_zero,
    integral_fullPlaneDirectionalDerivative_eq_zero, smul_zero, add_zero]

theorem tsupport_friedrichsUnitHeightMollifierTest_subset :
    tsupport (friedrichsUnitHeightMollifierTest : ℂ → ℂ) ⊆
      closedBall (0 : ℂ) 2 := by
  refine tsupport_mul_subset_right.trans ?_
  exact (tsupport_comp_subset rfl friedrichsUnitMollifierReal).trans <| by
    rw [tsupport_friedrichsUnitMollifierReal]

theorem tsupport_friedrichsUnitAffineCommutatorTest_subset
    (sigma : ℂ) :
    tsupport (friedrichsUnitAffineCommutatorTest sigma : ℂ → ℂ) ⊆
      closedBall (0 : ℂ) 2 := by
  have hOne : tsupport
      (fullPlaneDirectionalDerivative 1
        friedrichsUnitHeightMollifierTest : ℂ → ℂ) ⊆
        closedBall (0 : ℂ) 2 :=
    (tsupport_fullPlaneDirectionalDerivative_subset 1 _).trans
      tsupport_friedrichsUnitHeightMollifierTest_subset
  have hI : tsupport
      (fullPlaneDirectionalDerivative Complex.I
        friedrichsUnitHeightMollifierTest : ℂ → ℂ) ⊆
        closedBall (0 : ℂ) 2 :=
    (tsupport_fullPlaneDirectionalDerivative_subset Complex.I _).trans
      tsupport_friedrichsUnitHeightMollifierTest_subset
  have hSmul : tsupport
      (fun t : ℂ ↦ sigma *
        fullPlaneDirectionalDerivative 1
          friedrichsUnitHeightMollifierTest t) ⊆
        closedBall (0 : ℂ) 2 :=
    (tsupport_mul_subset_right.trans hOne)
  simpa only [friedrichsUnitAffineCommutatorTest,
    add_apply, smul_apply, smul_eq_mul] using
      (tsupport_add _ _).trans (union_subset hSmul hI)

/-- Stage-`j` commutator kernel.  Its `scale^2` normalization is forced by
the chain rule in real dimension two. -/
noncomputable def friedrichsAffineCommutatorKernel
    (sigma : ℂ) (j : ℕ) (t : ℂ) : ℂ :=
  ((friedrichsScale j ^ 2 : ℝ) : ℂ) *
    friedrichsUnitAffineCommutatorTest sigma
      (friedrichsScale j • t)

theorem friedrichsAffineCommutatorKernel_integrable
    (sigma : ℂ) (j : ℕ) :
    Integrable (friedrichsAffineCommutatorKernel sigma j)
      (volume : Measure ℂ) := by
  have hcomp : Integrable
      (fun t : ℂ ↦ friedrichsUnitAffineCommutatorTest sigma
        (friedrichsScale j • t)) (volume : Measure ℂ) :=
    (fullPlaneTest_integrable
      (friedrichsUnitAffineCommutatorTest sigma)).comp_smul
        (friedrichsScale_ne_zero j)
  simpa only [friedrichsAffineCommutatorKernel] using
    hcomp.const_mul (((friedrichsScale j ^ 2 : ℝ) : ℂ))

theorem friedrichsAffineCommutatorKernel_norm_integrable
    (sigma : ℂ) (j : ℕ) :
    Integrable (fun t : ℂ ↦
      ‖friedrichsAffineCommutatorKernel sigma j t‖)
      (volume : Measure ℂ) :=
  (friedrichsAffineCommutatorKernel_integrable sigma j).norm

theorem integral_friedrichsAffineCommutatorKernel_eq_zero
    (sigma : ℂ) (j : ℕ) :
    (∫ t : ℂ, friedrichsAffineCommutatorKernel sigma j t) = 0 := by
  let a : ℝ := friedrichsScale j
  have ha : 0 < a := friedrichsScale_pos j
  have hchange := Measure.integral_comp_smul
    (volume : Measure ℂ)
    (friedrichsUnitAffineCommutatorTest sigma : ℂ → ℂ) a
  rw [friedrichsAffineCommutatorKernel, integral_const_mul, hchange,
    integral_friedrichsUnitAffineCommutatorTest_eq_zero, smul_zero, mul_zero]

/-- The fixed finite `L1` constant for one affine symbol. -/
noncomputable def friedrichsAffineCommutatorL1 (sigma : ℂ) : ℝ :=
  ∫ t : ℂ, ‖friedrichsUnitAffineCommutatorTest sigma t‖

theorem friedrichsAffineCommutatorL1_nonneg (sigma : ℂ) :
    0 ≤ friedrichsAffineCommutatorL1 sigma :=
  integral_nonneg fun _ ↦ norm_nonneg _

/-- Dilation preserves the exact `L1` norm of the affine commutator kernel. -/
theorem friedrichsAffineCommutatorKernel_l1
    (sigma : ℂ) (j : ℕ) :
    (∫ t : ℂ, ‖friedrichsAffineCommutatorKernel sigma j t‖) =
      friedrichsAffineCommutatorL1 sigma := by
  let a : ℝ := friedrichsScale j
  have ha : 0 < a := friedrichsScale_pos j
  have hchange := Measure.integral_comp_smul
    (volume : Measure ℂ)
    (fun t : ℂ ↦ ‖friedrichsUnitAffineCommutatorTest sigma t‖) a
  rw [Complex.finrank_real_complex,
    abs_of_pos (inv_pos.mpr (pow_pos ha 2)), smul_eq_mul] at hchange
  calc
    (∫ t : ℂ, ‖friedrichsAffineCommutatorKernel sigma j t‖) =
        a ^ 2 * ∫ t : ℂ,
          ‖friedrichsUnitAffineCommutatorTest sigma (a • t)‖ := by
      rw [integral_const_mul]
      apply integral_congr_ae
      filter_upwards with t
      simp only [friedrichsAffineCommutatorKernel,
        norm_mul, Complex.norm_real, abs_of_nonneg (sq_nonneg a)]
    _ = a ^ 2 * ((a ^ 2)^{-1} *
          friedrichsAffineCommutatorL1 sigma) := by rw [hchange]
    _ = friedrichsAffineCommutatorL1 sigma := by
      field_simp [ha.ne']

theorem friedrichsAffineCommutatorKernel_support_bound
    (sigma : ℂ) (j : ℕ) (t : ℂ)
    (ht : friedrichsAffineCommutatorKernel sigma j t ≠ 0) :
    ‖t‖ ≤ friedrichsRadius j := by
  have ha : 0 < friedrichsScale j := friedrichsScale_pos j
  have hunit : friedrichsUnitAffineCommutatorTest sigma
      (friedrichsScale j • t) ≠ 0 := by
    intro hzero
    apply ht
    simp only [friedrichsAffineCommutatorKernel, hzero, mul_zero]
  have hmem : friedrichsScale j • t ∈
      tsupport (friedrichsUnitAffineCommutatorTest sigma : ℂ → ℂ) :=
    subset_tsupport _ hunit
  have hball :=
    tsupport_friedrichsUnitAffineCommutatorTest_subset sigma hmem
  have hle : friedrichsScale j * ‖t‖ ≤ 2 := by
    simpa only [mem_closedBall, dist_zero_right, norm_smul,
      Real.norm_eq_abs, abs_of_pos ha] using hball
  exact (le_div_iff₀ ha).2 hle

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3AffineCommutatorKernel

#print axioms FixedPhaseNormalizedFriedrichs.integral_friedrichsUnitAffineCommutatorTest_eq_zero
#print axioms FixedPhaseNormalizedFriedrichs.integral_friedrichsAffineCommutatorKernel_eq_zero
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsAffineCommutatorKernel_l1
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsAffineCommutatorKernel_support_bound

end AxiomAuditP3AffineCommutatorKernel
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.21: simultaneous planar `L2` Friedrichs coordinates

The normalized mollifier and both affine commutator kernels now act directly
on planar `L2` by Bochner integration of translations.  This avoids selecting
a pointwise representative.  The base action converges strongly to the
identity, while the `+I` and `-I` commutators converge strongly to zero along
the same natural-number index.  Consequently one common sequence converges
simultaneously in the base, raising, and lowering coordinates.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseNormalizedFriedrichs

open Set Function Topology Filter MeasureTheory Metric
open scoped Convolution ContDiff Distributions
open FixedPhaseAffineFriedrichs

noncomputable section

theorem integrable_kernel_smul_translation
    (K : ℂ → ℂ) (f : AmbientPlaneL2)
    (hK : Integrable K (volume : Measure ℂ)) :
    Integrable
      (fun t : ℂ ↦ K t • (DomAddAct.mk (-t) +ᵥ f))
      (volume : Measure ℂ) := by
  have hTranslation : Continuous
      (fun t : ℂ ↦ DomAddAct.mk (-t) +ᵥ f) := by
    fun_prop
  apply hK.smul_bdd ‖f‖ hTranslation.aestronglyMeasurable
  filter_upwards with t
  simp only [DomAddAct.norm_vadd_Lp, le_rfl]

theorem integrable_kernel_smul_translation_sub
    (K : ℂ → ℂ) (f : AmbientPlaneL2)
    (hK : Integrable K (volume : Measure ℂ)) :
    Integrable
      (fun t : ℂ ↦ K t •
        (DomAddAct.mk (-t) +ᵥ f - f))
      (volume : Measure ℂ) := by
  have hTranslate := integrable_kernel_smul_translation K f hK
  have hConst : Integrable (fun t : ℂ ↦ K t • f)
      (volume : Measure ℂ) := hK.smul_const f
  simpa only [smul_sub] using hTranslate.sub hConst

/-- Mean-one counterpart of the zero-mean rewrite from P3.18. -/
theorem integral_kernel_smul_translation_eq_base_add_error
    (K : ℂ → ℂ) (f : AmbientPlaneL2)
    (hK : Integrable K (volume : Measure ℂ))
    (hMean : (∫ t : ℂ, K t) = 1) :
    (∫ t : ℂ, K t • (DomAddAct.mk (-t) +ᵥ f)) =
      f + ∫ t : ℂ, K t •
        (DomAddAct.mk (-t) +ᵥ f - f) := by
  have hTranslate := integrable_kernel_smul_translation K f hK
  have hError := integrable_kernel_smul_translation_sub K f hK
  have hConst : Integrable (fun t : ℂ ↦ K t • f)
      (volume : Measure ℂ) := hK.smul_const f
  have hPointwise :
      (fun t : ℂ ↦ K t • (DomAddAct.mk (-t) +ᵥ f)) =
        (fun t : ℂ ↦
          K t • (DomAddAct.mk (-t) +ᵥ f - f) + K t • f) := by
    funext t
    rw [smul_sub, sub_add_cancel]
  rw [hPointwise, integral_add hError hConst,
    integral_smul_const, hMean, one_smul, add_comm]

/-- Bochner `L2` action of the concrete normalized mollifier. -/
noncomputable def friedrichsMollifierAction
    (j : ℕ) (f : AmbientPlaneL2) : AmbientPlaneL2 :=
  ∫ t : ℂ,
    friedrichsMollifier j t • (DomAddAct.mk (-t) +ᵥ f)

/-- Bochner `L2` action of the affine commutator kernel. -/
noncomputable def friedrichsAffineCommutatorAction
    (sigma : ℂ) (j : ℕ) (f : AmbientPlaneL2) : AmbientPlaneL2 :=
  ∫ t : ℂ,
    friedrichsAffineCommutatorKernel sigma j t •
      (DomAddAct.mk (-t) +ᵥ f)

theorem friedrichsMollifierAction_eq_base_add_error
    (j : ℕ) (f : AmbientPlaneL2) :
    friedrichsMollifierAction j f =
      f + ∫ t : ℂ, friedrichsMollifier j t •
        (DomAddAct.mk (-t) +ᵥ f - f) := by
  exact integral_kernel_smul_translation_eq_base_add_error
    (friedrichsMollifier j) f
    (friedrichsMollifier_integrable j)
    (friedrichsMollifier_integral j)

theorem friedrichsMollifierError_tendsto_zero
    (f : AmbientPlaneL2) :
    Filter.Tendsto
      (fun j : ℕ ↦ ∫ t : ℂ, friedrichsMollifier j t •
        (DomAddAct.mk (-t) +ᵥ f - f))
      Filter.atTop (𝓝 0) := by
  apply
    FixedPhaseAffineFriedrichs.integral_shrinkingKernel_smul_translation_sub_tendsto_zero
        f friedrichsMollifier friedrichsRadius 1 zero_le_one
  · intro j
    exact (friedrichsMollifier_integrable j).norm
  · intro j
    rw [friedrichsMollifier_l1]
  · exact friedrichsMollifier_support_bound
  · exact friedrichsRadius_tendsto_zero

theorem friedrichsMollifierAction_tendsto
    (f : AmbientPlaneL2) :
    Filter.Tendsto (fun j : ℕ ↦ friedrichsMollifierAction j f)
      Filter.atTop (𝓝 f) := by
  have h := (tendsto_const_nhds (x := f)).add
    (friedrichsMollifierError_tendsto_zero f)
  simpa only [add_zero] using h.congr'
    (Filter.Eventually.of_forall fun j ↦
      (friedrichsMollifierAction_eq_base_add_error j f).symm)

theorem friedrichsAffineCommutatorAction_eq_error
    (sigma : ℂ) (j : ℕ) (f : AmbientPlaneL2) :
    friedrichsAffineCommutatorAction sigma j f =
      ∫ t : ℂ, friedrichsAffineCommutatorKernel sigma j t •
        (DomAddAct.mk (-t) +ᵥ f - f) := by
  apply
    FixedPhaseAffineFriedrichs.integral_kernel_vadd_eq_integral_kernel_vadd_sub_of_mean_zero
        (friedrichsAffineCommutatorKernel sigma j) f
  · exact friedrichsAffineCommutatorKernel_integrable sigma j
  · exact integral_friedrichsAffineCommutatorKernel_eq_zero sigma j
  · exact integrable_kernel_smul_translation _ _
      (friedrichsAffineCommutatorKernel_integrable sigma j)
  · exact integrable_kernel_smul_translation_sub _ _
      (friedrichsAffineCommutatorKernel_integrable sigma j)

theorem friedrichsAffineCommutatorError_tendsto_zero
    (sigma : ℂ) (f : AmbientPlaneL2) :
    Filter.Tendsto
      (fun j : ℕ ↦ ∫ t : ℂ,
        friedrichsAffineCommutatorKernel sigma j t •
          (DomAddAct.mk (-t) +ᵥ f - f))
      Filter.atTop (𝓝 0) := by
  apply
    FixedPhaseAffineFriedrichs.integral_shrinkingKernel_smul_translation_sub_tendsto_zero
        f (friedrichsAffineCommutatorKernel sigma)
          friedrichsRadius
          (friedrichsAffineCommutatorL1 sigma)
          (friedrichsAffineCommutatorL1_nonneg sigma)
  · exact friedrichsAffineCommutatorKernel_norm_integrable sigma
  · intro j
    rw [friedrichsAffineCommutatorKernel_l1]
  · exact friedrichsAffineCommutatorKernel_support_bound sigma
  · exact friedrichsRadius_tendsto_zero

theorem friedrichsAffineCommutatorAction_tendsto_zero
    (sigma : ℂ) (f : AmbientPlaneL2) :
    Filter.Tendsto
      (fun j : ℕ ↦ friedrichsAffineCommutatorAction sigma j f)
      Filter.atTop (𝓝 0) := by
  exact (friedrichsAffineCommutatorError_tendsto_zero sigma f).congr'
    (Filter.Eventually.of_forall fun j ↦
      (friedrichsAffineCommutatorAction_eq_error sigma j f).symm)

/-- The graph-coordinate predicted by the exact affine convolution identity. -/
noncomputable def friedrichsAffineForwardCoordinate
    (sigma : ℂ) (j : ℕ)
    (u Pu : AmbientPlaneL2) : AmbientPlaneL2 :=
  friedrichsMollifierAction j Pu +
    friedrichsAffineCommutatorAction sigma j u

theorem friedrichsAffineForwardCoordinate_tendsto
    (sigma : ℂ) (u Pu : AmbientPlaneL2) :
    Filter.Tendsto
      (fun j : ℕ ↦ friedrichsAffineForwardCoordinate sigma j u Pu)
      Filter.atTop (𝓝 Pu) := by
  simpa only [friedrichsAffineForwardCoordinate, add_zero] using
    (friedrichsMollifierAction_tendsto Pu).add
      (friedrichsAffineCommutatorAction_tendsto_zero sigma u)

/-- One common sequence converges simultaneously in the base, raising and
lowering affine coordinates.  This is stronger than choosing unrelated
subsequences for the two first-order operators. -/
theorem friedrichsJointAffineCoordinates_tendsto
    (u Ru Lu : AmbientPlaneL2) :
    Filter.Tendsto
      (fun j : ℕ ↦
        (friedrichsMollifierAction j u,
          friedrichsAffineForwardCoordinate Complex.I j u Ru,
          friedrichsAffineForwardCoordinate (-Complex.I) j u Lu))
      Filter.atTop (𝓝 (u, Ru, Lu)) := by
  exact (friedrichsMollifierAction_tendsto u).prodMk_nhds <|
    (friedrichsAffineForwardCoordinate_tendsto Complex.I u Ru).prodMk_nhds
        (friedrichsAffineForwardCoordinate_tendsto (-Complex.I) u Lu)

end
end FixedPhaseNormalizedFriedrichs

namespace AxiomAuditP3SimultaneousAffineFriedrichs

#print axioms FixedPhaseNormalizedFriedrichs.friedrichsMollifierAction_tendsto
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsAffineCommutatorAction_tendsto_zero
#print axioms FixedPhaseNormalizedFriedrichs.friedrichsJointAffineCoordinates_tendsto

end AxiomAuditP3SimultaneousAffineFriedrichs
end Mock2FA.PaperCorrections.AutomorphicSobolev

/-!
### P3.22: exact joint periodization of one ambient graph sequence

P3.15 periodized raising and lowering sequences separately.  For the graph
completion one needs more: the same smooth source sequence must approximate
both derivatives.  The next theorem performs this simultaneous passage.  It
uses one ambient test `v j`, periodizes it once at index `n+1`, and proves
membership in the literal graph of `physicalJointFromSucc n` at every stage.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace FixedPhaseJointFriedrichsPeriodization

open Set Function Topology Filter MeasureTheory
open scoped LinearPMap
open DefinitionOneSobolev
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open FixedPhaseClosedOperators
open FixedPhaseEssentialCoreRoute

/-- A simultaneous compact ambient base/raising/lowering approximation
periodizes to a literal sequence in the genuine joint physical graph. -/
theorem periodize_ambientJointGraphApproximation
    {n : ℤ}
    {p : OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n}
    (v : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore)
    (hv : ∀ j : ℕ, tsupport (v j : ℂ → ℂ) ⊆
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier)
    (hBase : Filter.Tendsto
      (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 (n + 1) (v j))
      Filter.atTop
      (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
        p.1)))
    (hRaise : Filter.Tendsto
      (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 ((n + 1) + 1)
        (euclideanRaiseForwardTest (n + 1) (v j)))
      Filter.atTop
      (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
        ((n + 1) + 1) p.2.fst)))
    (hLower : Filter.Tendsto
      (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n
        (euclideanLowerFromSuccForwardTest n (v j)))
      Filter.atTop
      (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
        p.2.snd))) :
    ∃ q : ℕ →
        OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n,
      (∀ j : ℕ, q j ∈ (physicalJointFromSucc n).graph) ∧
        Filter.Tendsto q Filter.atTop (𝓝 p) := by
  let u : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators.InverseEtaFixedPhaseCore (n + 1) := fun j ↦
    gammaTwoPeriodizedPhysicalCore (n + 1) (v j)
  let q : ℕ → OrbitPeterssonHilbert (n + 1) ×
      PhysicalJointTarget n := fun j ↦
    (l2Coordinate (n + 1) (u j),
      WithLp.toLp 2
        (raisedCoordinate (n + 1) (u j),
          lowerFromSuccCoordinate n (u j)))
  have hEq (j : ℕ) : Set.EqOn
      (SmoothCompactCoreGeometry.upperLift
        (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.fixedPhaseEuclideanGauge (n + 1) (u j)))
      (v j : ℂ → ℂ)
      Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier := by
    exact gammaTwoPeriodizedPhysicalCore_gauge_eqOn (hv j)
  refine ⟨q, ?_, ?_⟩
  · intro j
    change
      (l2Coordinate (n + 1) (u j),
        WithLp.toLp 2
          (raisedCoordinate (n + 1) (u j),
            lowerFromSuccCoordinate n (u j))) ∈
        (physicalJointFromSucc n).graph
    simpa only [l2CoreRangeEquiv_coe,
      physicalJointFromSucc_on_core] using
        (physicalJointFromSucc n).mem_graph
          (l2CoreRangeEquiv (n + 1) (u j))
  · have hBaseEmbedded : Filter.Tendsto
        (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          (l2Coordinate (n + 1) (u j)))
        Filter.atTop
        (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding (n + 1)
          p.1)) :=
      hBase.congr' <| Filter.Eventually.of_forall fun j ↦
        (embedded_l2Coordinate_eq_ambientTest_of_periodizedGauge
          (hEq j)).symm
    have hRaiseEmbedded : Filter.Tendsto
        (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
          ((n + 1) + 1) (raisedCoordinate (n + 1) (u j)))
        Filter.atTop
        (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
          ((n + 1) + 1) p.2.fst)) :=
      hRaise.congr' <| Filter.Eventually.of_forall fun j ↦
        (embedded_raisedCoordinate_eq_forwardTest_of_periodizedGauge
          (hEq j)).symm
    have hLowerEmbedded : Filter.Tendsto
        (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          (lowerFromSuccCoordinate n (u j)))
        Filter.atTop
        (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
          p.2.snd)) :=
      hLower.congr' <| Filter.Eventually.of_forall fun j ↦
        (embedded_lowerFromSuccCoordinate_eq_forwardTest_of_periodizedGauge
          (hEq j)).symm
    have hBasePhysical : Filter.Tendsto
        (fun j ↦ l2Coordinate (n + 1) (u j)) Filter.atTop (𝓝 p.1) :=
      tendsto_of_orbitPeterssonEuclideanEmbedding_tendsto hBaseEmbedded
    have hRaisePhysical : Filter.Tendsto
        (fun j ↦ raisedCoordinate (n + 1) (u j))
        Filter.atTop (𝓝 p.2.fst) :=
      tendsto_of_orbitPeterssonEuclideanEmbedding_tendsto hRaiseEmbedded
    have hLowerPhysical : Filter.Tendsto
        (fun j ↦ lowerFromSuccCoordinate n (u j))
        Filter.atTop (𝓝 p.2.snd) :=
      tendsto_of_orbitPeterssonEuclideanEmbedding_tendsto hLowerEmbedded
    have hTarget : Filter.Tendsto
        (fun j ↦ WithLp.toLp 2
          (raisedCoordinate (n + 1) (u j),
            lowerFromSuccCoordinate n (u j)))
        Filter.atTop (𝓝 p.2) := by
      have hPair := hRaisePhysical.prodMk_nhds hLowerPhysical
      exact (WithLp.prod_continuous_toLp (p := 2)).continuousAt.tendsto.comp
        hPair
    exact hBasePhysical.prodMk_nhds hTarget

/-- Joint graph regularization on a class `K` follows from one common
ambient approximation family.  This theorem exposes exactly the remaining
local weak-convolution/gluing step and performs all multiplier,
periodization, and graph bookkeeping internally. -/
theorem hasSequentialJointGraphRegularization_of_ambientApproximation
    {n : ℤ}
    {K : Set (OrbitPeterssonHilbert (n + 1) × PhysicalJointTarget n)}
    (hApprox : ∀ p,
      p ∈ K →
        ∃ v : ℕ → Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.AmbientTestCore,
          (∀ j : ℕ, tsupport (v j : ℂ → ℂ) ⊆
            Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientGammaTwoOpenCarrier) ∧
          Filter.Tendsto
            (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2
              (n + 1) (v j))
            Filter.atTop
            (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
              (n + 1) p.1)) ∧
          Filter.Tendsto
            (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2
              ((n + 1) + 1)
              (euclideanRaiseForwardTest (n + 1) (v j)))
            Filter.atTop
            (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding
              ((n + 1) + 1) p.2.fst)) ∧
          Filter.Tendsto
            (fun j ↦ Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.ambientTestCoreToCarrierL2 n
              (euclideanLowerFromSuccForwardTest n (v j)))
            Filter.atTop
            (𝓝 (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalLocalL2.orbitPeterssonEuclideanEmbedding n
              p.2.snd))) :
    HasSequentialGraphRegularization (physicalJointFromSucc n) K := by
  intro p hp
  obtain ⟨v, hv, hBase, hRaise, hLower⟩ := hApprox p hp
  exact periodize_ambientJointGraphApproximation
    v hv hBase hRaise hLower

end FixedPhaseJointFriedrichsPeriodization

