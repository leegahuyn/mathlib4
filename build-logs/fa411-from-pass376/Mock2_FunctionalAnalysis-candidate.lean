/-!
## P9: unconditional point-spectral consequences of the Petersson realization

Mathlib's current unbounded-operator API packages the modular realization as a
`LinearPMap`.  This section therefore defines its eigenspaces directly on the
literal partial domain.  It proves the two spectral facts which follow from
formal self-adjointness alone: eigenvalues are real and distinct eigenspaces
are orthogonal.  No discrete-spectrum or compact-resolvent conclusion is
inserted.
-/

namespace Mock2FA.PaperCorrections.AutomorphicSobolev
namespace P9PartialSpectralConsequences

open scoped LinearPMap

noncomputable section

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The eigenspace of a partially defined complex-linear operator.  Domain
membership is part of the carrier, rather than an external regularity
certificate. -/
def partialEigenspace (A : H →ₗ.[ℂ] H) (μ : ℂ) : Submodule ℂ H where
  carrier := {x | ∃ hx : x ∈ A.domain, A ⟨x, hx⟩ = μ • x}
  zero_mem' := by
    refine ⟨0, ?_⟩
    simp
  add_mem' := by
    rintro x y ⟨hx, hAx⟩ ⟨hy, hAy⟩
    refine ⟨hx + hy, ?_⟩
    simp only [LinearPMap.map_add, hAx, hAy, smul_add]
  smul_mem' := by
    rintro c x ⟨hx, hAx⟩
    refine ⟨c • hx, ?_⟩
    simp only [LinearPMap.map_smul, hAx, smul_smul]
    rw [mul_comm]

@[simp]
theorem mem_partialEigenspace_iff
    (A : H →ₗ.[ℂ] H) (μ : ℂ) (x : H) :
    x ∈ partialEigenspace A μ ↔
      ∃ hx : x ∈ A.domain, A ⟨x, hx⟩ = μ • x :=
  Iff.rfl

/-- A partial eigenvalue means that its literal partial eigenspace contains a
nonzero vector. -/
def HasPartialEigenvalue (A : H →ₗ.[ℂ] H) (μ : ℂ) : Prop :=
  ∃ x : H, x ≠ 0 ∧ x ∈ partialEigenspace A μ

/-- Formal self-adjointness forces every partial eigenvalue to be fixed by
complex conjugation. -/
theorem conj_eq_self_of_hasPartialEigenvalue
    {A : H →ₗ.[ℂ] H} (hA : A.IsFormalAdjoint A)
    {μ : ℂ} (hμ : HasPartialEigenvalue A μ) :
    star μ = μ := by
  rcases hμ with ⟨x, hx0, hx, hAx⟩
  let xd : A.domain := ⟨x, hx⟩
  have hSymm := hA xd xd
  change inner ℂ (A xd) x = inner ℂ x (A xd) at hSymm
  rw [hAx, inner_smul_left, inner_smul_right] at hSymm
  exact mul_right_cancel₀ (inner_self_ne_zero.mpr hx0) hSymm

/-- Equivalent coordinate statement: every such eigenvalue has zero
imaginary part. -/
theorem im_eq_zero_of_hasPartialEigenvalue
    {A : H →ₗ.[ℂ] H} (hA : A.IsFormalAdjoint A)
    {μ : ℂ} (hμ : HasPartialEigenvalue A μ) :
    μ.im = 0 := by
  have hReal := congrArg Complex.im
    (conj_eq_self_of_hasPartialEigenvalue hA hμ)
  simp only [Complex.conj_im] at hReal
  linarith

/-- Eigenspaces whose spectral parameters are not conjugate are orthogonal.
This is the precise complex statement; the real distinct-eigenvalue version
is derived below. -/
theorem inner_eq_zero_of_mem_partialEigenspaces
    {A : H →ₗ.[ℂ] H} (hA : A.IsFormalAdjoint A)
    {μ ν : ℂ} (hμν : star μ ≠ ν)
    {x y : H}
    (hx : x ∈ partialEigenspace A μ)
    (hy : y ∈ partialEigenspace A ν) :
    inner ℂ x y = 0 := by
  rcases hx with ⟨hx, hAx⟩
  rcases hy with ⟨hy, hAy⟩
  let xd : A.domain := ⟨x, hx⟩
  let yd : A.domain := ⟨y, hy⟩
  have hSymm := hA xd yd
  change inner ℂ (A xd) y = inner ℂ x (A yd) at hSymm
  rw [hAx, hAy, inner_smul_left, inner_smul_right] at hSymm
  have hz : (star μ - ν) * inner ℂ x y = 0 := by
    rw [sub_mul, hSymm, sub_self]
  exact (mul_eq_zero.mp hz).resolve_left (sub_ne_zero.mpr hμν)

/-- Distinct genuine partial eigenvalues of a formally self-adjoint operator
have orthogonal eigenspaces. -/
theorem inner_eq_zero_of_distinct_partialEigenvalues
    {A : H →ₗ.[ℂ] H} (hA : A.IsFormalAdjoint A)
    {μ ν : ℂ}
    (hμ : HasPartialEigenvalue A μ)
    (hν : HasPartialEigenvalue A ν)
    (hμν : μ ≠ ν)
    {x y : H}
    (hx : x ∈ partialEigenspace A μ)
    (hy : y ∈ partialEigenspace A ν) :
    inner ℂ x y = 0 := by
  apply inner_eq_zero_of_mem_partialEigenspaces hA ?_ hx hy
  rw [conj_eq_self_of_hasPartialEigenvalue hA hμ]
  exact hμν

/-! ### The actual Petersson operator -/

open P9ClosedFormRealization.ActualModularEndpoint
open P9ClosedFormRealization
open ActualScalarDiscriminantPDE
open DefinitionOneSobolev.FixedPhasePeterssonCoordinates
open DefinitionOneSobolev.FixedPhaseGraphCompletion

/-- Point spectrum of the actual self-adjoint scalar-discriminant Petersson
operator is real for every fixed-phase index and every real coupling. -/
theorem modularAssociatedOperator_eigenvalue_conj_eq_self
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasPartialEigenvalue (modularAssociatedOperator n t) μ) :
    star μ = μ :=
  conj_eq_self_of_hasPartialEigenvalue
    (modularAssociatedOperator_isFormalAdjoint n t) hμ

theorem modularAssociatedOperator_eigenvalue_im_eq_zero
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasPartialEigenvalue (modularAssociatedOperator n t) μ) :
    μ.im = 0 :=
  im_eq_zero_of_hasPartialEigenvalue
    (modularAssociatedOperator_isFormalAdjoint n t) hμ

/-- Distinct point-spectral subspaces of the actual Petersson realization are
orthogonal in the literal Petersson Hilbert inner product. -/
theorem modularAssociatedOperator_distinct_eigenspaces_orthogonal
    (n : ℤ) (t : ℝ) {μ ν : ℂ}
    (hμ : HasPartialEigenvalue (modularAssociatedOperator n t) μ)
    (hν : HasPartialEigenvalue (modularAssociatedOperator n t) ν)
    (hμν : μ ≠ ν)
    {x y : OrbitPeterssonHilbert n}
    (hx : x ∈ partialEigenspace (modularAssociatedOperator n t) μ)
    (hy : y ∈ partialEigenspace (modularAssociatedOperator n t) ν) :
    inner ℂ x y = 0 :=
  inner_eq_zero_of_distinct_partialEigenvalues
    (modularAssociatedOperator_isFormalAdjoint n t)
    hμ hν hμν hx hy

/-- The concrete coercive mass shift gives a genuine lower bound for every
point-spectral value.  This is stronger than reality/orthogonality, but still
does not assert that the whole spectrum is discrete. -/
theorem modularAssociatedOperator_eigenvalue_re_lower_bound
    (n : ℤ) (t : ℝ) {μ : ℂ}
    (hμ : HasPartialEigenvalue (modularAssociatedOperator n t) μ) :
    -discriminantMassShift t ≤ μ.re := by
  rcases hμ with ⟨x, hx0, hx, hAx⟩
  let xd : (modularAssociatedOperator n t).domain := ⟨x, hx⟩
  have hGraph :
      (x, μ • x) ∈ (modularAssociatedOperator n t).graph := by
    have hRaw := (modularAssociatedOperator n t).mem_graph xd
    simpa only [hAx] using hRaw
  rcases (mem_modularAssociatedOperator_graph_iff n t x (μ • x)).mp
      hGraph with ⟨u, hu, hForm⟩
  have hWeak :
      weakSchrodingerOperator n t u u =
        inner ℂ (baseExtension n u) (μ • x) := by
    simpa only [weakSchrodingerOperator_apply] using hForm u
  have hShift :
      (embeddedShiftedForm (baseExtension n)
          (weakSchrodingerOperator n t) (discriminantMassShift t)
          u u).re =
        (μ.re + discriminantMassShift t) * ‖x‖ ^ 2 := by
    rw [embeddedShiftedForm_apply, hWeak, hu]
    simp only [inner_smul_right, inner_self_eq_norm_sq,
      Complex.add_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero]
    ring
  have hCoercive :=
    (weakSchrodinger_embeddedMassShift_coercive n t).2 u
  have hNonneg :
      0 ≤ (μ.re + discriminantMassShift t) * ‖x‖ ^ 2 := by
    rw [← hShift]
    exact (sq_nonneg ‖u‖).trans (by simpa only [one_mul] using hCoercive)
  have hxSq : 0 < ‖x‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hx0)
  nlinarith

end
end P9PartialSpectralConsequences

namespace AxiomAuditP9PartialSpectralConsequences

#print axioms P9PartialSpectralConsequences.partialEigenspace
#print axioms P9PartialSpectralConsequences.conj_eq_self_of_hasPartialEigenvalue
#print axioms P9PartialSpectralConsequences.im_eq_zero_of_hasPartialEigenvalue
#print axioms P9PartialSpectralConsequences.inner_eq_zero_of_distinct_partialEigenvalues
#print axioms P9PartialSpectralConsequences.modularAssociatedOperator_eigenvalue_conj_eq_self
#print axioms P9PartialSpectralConsequences.modularAssociatedOperator_distinct_eigenspaces_orthogonal
#print axioms P9PartialSpectralConsequences.modularAssociatedOperator_eigenvalue_re_lower_bound

end AxiomAuditP9PartialSpectralConsequences
