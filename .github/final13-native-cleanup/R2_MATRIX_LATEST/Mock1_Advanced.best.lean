/-!
Exact finite algebra behind the specialized Appell-Lerch principal ridge.

For `q = exp (2 * pi * i * tau)`, the page-8 double-series exponent is

`E(n,m) = n^2 / 2 + n * (1 + m) + m / 2`.

The following declarations certify only its integer-lattice algebra and the
first three ridge exponents.  They do not assert convergence of the geometric
expansion or equality with the completed analytic Appell-Lerch function.
-/

def AdvancedClaimsIIAppellLerchBaseExponent (n : Int) (m : Nat) : Rat :=
  (n : Rat) ^ 2 / 2 + (n : Rat) * (1 + (m : Rat)) + (m : Rat) / 2

def AdvancedClaimsIIAppellLerchTotalExponent (n : Int) (m : Nat) : Rat :=
  (1 / 4 : Rat) + AdvancedClaimsIIAppellLerchBaseExponent n m

def AdvancedClaimsIIAppellLerchRidgeIndex (m : Nat) : Int :=
  -1 - (m : Int)

theorem advanced_claims_ii_appell_lerch_ridge_cast (m : Nat) :
    (AdvancedClaimsIIAppellLerchRidgeIndex m : Rat) =
      -1 - (m : Rat) := by
  simp [AdvancedClaimsIIAppellLerchRidgeIndex]

theorem advanced_claims_ii_appell_lerch_ridge_base_exponent (m : Nat) :
    AdvancedClaimsIIAppellLerchBaseExponent
        (AdvancedClaimsIIAppellLerchRidgeIndex m) m =
      -(((m : Rat) ^ 2 + (m : Rat) + 1) / 2) := by
  unfold AdvancedClaimsIIAppellLerchBaseExponent
  rw [advanced_claims_ii_appell_lerch_ridge_cast]
  ring

theorem advanced_claims_ii_appell_lerch_ridge_total_exponent (m : Nat) :
    AdvancedClaimsIIAppellLerchTotalExponent
        (AdvancedClaimsIIAppellLerchRidgeIndex m) m =
      -((2 * (m : Rat) ^ 2 + 2 * (m : Rat) + 1) / 4) := by
  unfold AdvancedClaimsIIAppellLerchTotalExponent
  rw [advanced_claims_ii_appell_lerch_ridge_base_exponent]
  ring

theorem advanced_claims_ii_appell_lerch_ridge_total_negative (m : Nat) :
    AdvancedClaimsIIAppellLerchTotalExponent
        (AdvancedClaimsIIAppellLerchRidgeIndex m) m < 0 := by
  rw [advanced_claims_ii_appell_lerch_ridge_total_exponent]
  have hm : (0 : Rat) <= (m : Rat) := by positivity
  have hsq : (0 : Rat) <= (m : Rat) ^ 2 := sq_nonneg (m : Rat)
  nlinarith

