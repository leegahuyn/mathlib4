    referenceAdvancedClaimsIIRamanujanFPaperObject.coeff n =
      A.exactCoefficient.globalConstant *
        A.exactCoefficient.powerTerm n *
          A.exactCoefficient.centralLValue n *
            A.exactCoefficient.localEulerProduct n :=
  A.exactCoefficient.coefficient_formula_at n

