    (C : ArchimedeanScalarCoefficientInputCertificate) (n : Nat) :
    C.normalizedCoeff n = C.scalar * (C.mockCoeff n * C.thetaCoeff n) :=
  C.coefficient_formula n

theorem rademacher_link_at
    (C : ArchimedeanScalarCoefficientInputCertificate) (n : Nat) :
    C.normalizedCoeff n =
      C.formula.rademacher.main n + C.formula.rademacher.remainder n :=
  C.rademacher_link n

theorem formula_coefficient_at
    (C : ArchimedeanScalarCoefficientInputCertificate) (n : Nat) :
    C.formula.normalizedCoeff n =
      C.scalarRecord.scalar *
        (C.formula.mockCoeff n * C.formula.thetaCoeff n) := by
  calc
    C.formula.normalizedCoeff n = C.normalizedCoeff n := by
      rw [C.normalized_link n]
    _ = C.scalar * (C.mockCoeff n * C.thetaCoeff n) :=
      C.coefficient_formula_at n
    _ = C.scalarRecord.scalar *
        (C.formula.mockCoeff n * C.formula.thetaCoeff n) := by
      rw [C.scalar_eq_record, C.mock_link n, C.theta_link n]

