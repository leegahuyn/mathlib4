namespace RationalInterval

def singleton (x : Rat) : RationalInterval where
  lower := x
  upper := x
  lower_le_upper := le_rfl

theorem singleton_mem (x : Rat) :
    (singleton x).Contains x := by
  simp [singleton, Contains]

theorem upper_mem (I : RationalInterval) :
    I.Contains I.upper :=
  And.intro I.lower_le_upper le_rfl

end RationalInterval

namespace Mock1Advanced

/-!
Paper table certification layer for the Mock1 advanced registry.

Floating point output from external scripts is not used directly in theorem
statements.  Printed decimals are converted to rational intervals; Lean only
checks interval membership, finite list coverage, row modes, and rational
threshold comparisons.
-/

inductive TableRowMode where
  | theoremBacked
  | diagnosticOnly
deriving DecidableEq, Repr

namespace TableRowMode

def toPaperLabelKind : TableRowMode -> PaperLabelKind
  | theoremBacked => PaperLabelKind.theorem
  | diagnosticOnly => PaperLabelKind.diagnosticOnly

theorem theorem_kind :
    toPaperLabelKind theoremBacked = PaperLabelKind.theorem :=
  rfl

theorem diagnostic_kind :
    toPaperLabelKind diagnosticOnly = PaperLabelKind.diagnosticOnly :=
  rfl

end TableRowMode

structure RationalPassFailCheck where
  value : Rat
  valueInterval : RationalInterval
  threshold : RationalInterval
  pass : Bool
  value_mem_interval :
    valueInterval.Contains value
  pass_true_upper_le :
    pass = true -> valueInterval.upper <= threshold.upper
  fail_false_threshold_lt :
    pass = false -> threshold.upper < valueInterval.lower

namespace RationalPassFailCheck

theorem value_mem_at (C : RationalPassFailCheck) :
    C.valueInterval.Contains C.value :=
  C.value_mem_interval

theorem upper_le_threshold_at
    (C : RationalPassFailCheck) (hpass : C.pass = true) :
    C.valueInterval.upper <= C.threshold.upper :=
  C.pass_true_upper_le hpass

theorem threshold_lt_lower_at
    (C : RationalPassFailCheck) (hfail : C.pass = false) :
    C.threshold.upper < C.valueInterval.lower :=
  C.fail_false_threshold_lt hfail

end RationalPassFailCheck

def referenceResidualThreshold : RationalInterval where
  lower := 0
  upper := 5
  lower_le_upper := by norm_num

def referencePassingCheck (value : Rat)
    (hvalue : value <= 5) : RationalPassFailCheck where
  value := value
  valueInterval := RationalInterval.singleton value
  threshold := referenceResidualThreshold
  pass := true
  value_mem_interval := RationalInterval.singleton_mem value
  pass_true_upper_le := by
    intro hpass
    simpa [RationalInterval.singleton, referenceResidualThreshold] using hvalue
  fail_false_threshold_lt := by
    intro hfail
    cases hfail

