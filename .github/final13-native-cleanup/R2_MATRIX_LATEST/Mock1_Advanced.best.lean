/-!
Evidence classification for every advanced requirement.

`analyticBoundary` means that Lean checks consequences of an explicit proof
field, not that the cited analytic theorem has been reconstructed in mathlib.
`diagnosticMetadata` never feeds a theorem as floating-point equality.
-/

inductive AdvancedClaimsIIEvidenceClass where
  | finiteExact
  | analyticBoundary
  | diagnosticMetadata
  | aggregate
deriving DecidableEq, Repr

namespace AdvancedClaimsIIRequirement

def evidenceClass : AdvancedClaimsIIRequirement -> AdvancedClaimsIIEvidenceClass
  | objectClaimRegistry => .finiteExact
  | objectCoefficientSchema => .finiteExact
  | paperObjectDataInstance => .finiteExact
  | scalarJacobiDegeneracyRelation => .finiteExact
  | principalPartRationalSolve => .finiteExact
  | completionShadowHolomorphicConsequence => .analyticBoundary
  | cuspTransportSkeleton => .analyticBoundary
  | appellLerchBlockFormula => .analyticBoundary
  | principalExponentFormula => .finiteExact
  | paperMatrixRhsSolution => .finiteExact
  | fixedShadowUnaryThetaData => .analyticBoundary
  | insideOutsideQSeriesCertificate => .analyticBoundary
  | natGcdLcmSkeleton => .finiteExact
  | primewiseThicknessSkeleton => .finiteExact
  | actualMpkValuationCertificate => .finiteExact
  | obstructionFreeFailureThicknessPortfolio => .finiteExact
  | baseChangeStabilityBoundary => .finiteExact
  | kernelSelectionCertificateBoundary => .finiteExact
  | finiteMultiplierPhaseMatchingCertificate => .finiteExact
  | cuspConvergenceCertificateBoundary => .analyticBoundary
  | transportFamilyConnection => .finiteExact
  | kernelSelectionTableInput => .finiteExact
  | multiplierPhaseMatchingInput => .finiteExact
  | cuspConvergenceProofData => .analyticBoundary
  | transportAcrossRelevantCusps => .finiteExact
  | coefficientSeparationBoundary => .analyticBoundary
  | thetaCoefficientCharacterBoundary => .finiteExact
  | spectralKloostermanExpansionBoundary => .analyticBoundary
  | localEulerDecompositionBoundary => .analyticBoundary
  | rootNumberFilterBoundary => .finiteExact
  | exactCoefficientFormulaBoundary => .analyticBoundary
  | paperDataFormulaProofFields => .analyticBoundary
  | padicNormalizationWrapper => .finiteExact
  | padicOverlapGluingWrapper => .finiteExact
  | mahlerInterpolationWrapper => .finiteExact
  | analyticRangeTailZeroWrapper => .analyticBoundary
  | globalPadicFaceTracking => .analyticBoundary
  | denominatorClearingData => .finiteExact
  | chartVectorsModuloPrimePower => .finiteExact
  | mahlerTableInterpolationVector => .finiteExact
  | analyticRangePredicate => .finiteExact
  | obstructionFailureCaseInstance => .finiteExact
  | regressionCardySkeleton => .diagnosticMetadata
  | rademacherTailSkeleton => .analyticBoundary
  | entropyCardyPaperWrapper => .analyticBoundary
  | actualEntropyAlphaExtraction => .diagnosticMetadata
  | degeneracyChannelInstance => .finiteExact
  | rationalOlsIntervalTable => .diagnosticMetadata
  | growthStabilityUnderSptPadic => .analyticBoundary
  | reproducibilitySchemaValidator => .finiteExact
  | externalOutputSchemaRows => .diagnosticMetadata
  | namedConcretePaperInstance => .aggregate
  | concreteCertificateTheoremExtraction => .aggregate
  | advancedClaimsGlobalChecklist => .aggregate

def finiteExactRequirements : List AdvancedClaimsIIRequirement :=
  all.filter (fun r => decide (r.evidenceClass = .finiteExact))

def analyticBoundaryRequirements : List AdvancedClaimsIIRequirement :=
  all.filter (fun r => decide (r.evidenceClass = .analyticBoundary))

def diagnosticMetadataRequirements : List AdvancedClaimsIIRequirement :=
  all.filter (fun r => decide (r.evidenceClass = .diagnosticMetadata))

def aggregateRequirements : List AdvancedClaimsIIRequirement :=
  all.filter (fun r => decide (r.evidenceClass = .aggregate))

set_option maxHeartbeats 800000 in
theorem evidenceClass_exhaustive (r : AdvancedClaimsIIRequirement) :
    r.evidenceClass = .finiteExact /\
        List.Mem r finiteExactRequirements \/
      r.evidenceClass = .analyticBoundary /\
          List.Mem r analyticBoundaryRequirements \/
        r.evidenceClass = .diagnosticMetadata /\
            List.Mem r diagnosticMetadataRequirements \/
          r.evidenceClass = .aggregate /\
            List.Mem r aggregateRequirements := by
  have hr : List.Mem r all := mem_all r
  cases hclass : r.evidenceClass with
  | finiteExact =>
      exact Or.inl ⟨rfl, by
        apply List.mem_filter.mpr
        exact ⟨hr, by simp [hclass]⟩⟩
  | analyticBoundary =>
      exact Or.inr (Or.inl ⟨rfl, by
        apply List.mem_filter.mpr
        exact ⟨hr, by simp [hclass]⟩⟩)
  | diagnosticMetadata =>
      exact Or.inr (Or.inr (Or.inl ⟨rfl, by
        apply List.mem_filter.mpr
        exact ⟨hr, by simp [hclass]⟩⟩))
  | aggregate =>
      exact Or.inr (Or.inr (Or.inr ⟨rfl, by
        apply List.mem_filter.mpr
        exact ⟨hr, by simp [hclass]⟩⟩))

theorem finiteExactRequirements_nonempty :
    Not (finiteExactRequirements = []) := by
  simp [finiteExactRequirements, all, evidenceClass]

theorem analyticBoundaryRequirements_nonempty :
    Not (analyticBoundaryRequirements = []) := by
  simp [analyticBoundaryRequirements, all, evidenceClass]

theorem diagnosticMetadataRequirements_nonempty :
    Not (diagnosticMetadataRequirements = []) := by
  simp [diagnosticMetadataRequirements, all, evidenceClass]

theorem aggregateRequirements_nonempty :
    Not (aggregateRequirements = []) := by
  simp [aggregateRequirements, all, evidenceClass]

end AdvancedClaimsIIRequirement

structure AdvancedClaimsIIEvidenceClassificationCertificate : Prop where
  exhaustive :
    forall r : AdvancedClaimsIIRequirement,
      r.evidenceClass = .finiteExact /\
          List.Mem r AdvancedClaimsIIRequirement.finiteExactRequirements \/
        r.evidenceClass = .analyticBoundary /\
            List.Mem r AdvancedClaimsIIRequirement.analyticBoundaryRequirements \/
          r.evidenceClass = .diagnosticMetadata /\
              List.Mem r AdvancedClaimsIIRequirement.diagnosticMetadataRequirements \/
            r.evidenceClass = .aggregate /\
              List.Mem r AdvancedClaimsIIRequirement.aggregateRequirements
  finite_nonempty :
    Not (AdvancedClaimsIIRequirement.finiteExactRequirements = [])
  analytic_nonempty :
    Not (AdvancedClaimsIIRequirement.analyticBoundaryRequirements = [])
  diagnostic_nonempty :
    Not (AdvancedClaimsIIRequirement.diagnosticMetadataRequirements = [])
  aggregate_nonempty :
    Not (AdvancedClaimsIIRequirement.aggregateRequirements = [])

namespace AdvancedClaimsIIEvidenceClassificationCertificate

theorem class_at
    (C : AdvancedClaimsIIEvidenceClassificationCertificate)
    (r : AdvancedClaimsIIRequirement) :
    r.evidenceClass = .finiteExact /\
        List.Mem r AdvancedClaimsIIRequirement.finiteExactRequirements \/
      r.evidenceClass = .analyticBoundary /\
          List.Mem r AdvancedClaimsIIRequirement.analyticBoundaryRequirements \/
        r.evidenceClass = .diagnosticMetadata /\
            List.Mem r AdvancedClaimsIIRequirement.diagnosticMetadataRequirements \/
          r.evidenceClass = .aggregate /\
            List.Mem r AdvancedClaimsIIRequirement.aggregateRequirements :=
  C.exhaustive r

end AdvancedClaimsIIEvidenceClassificationCertificate

theorem reference_advanced_claims_ii_evidence_classification :
    AdvancedClaimsIIEvidenceClassificationCertificate where
  exhaustive := by
    intro r
    exact AdvancedClaimsIIRequirement.evidenceClass_exhaustive r
  finite_nonempty :=
    AdvancedClaimsIIRequirement.finiteExactRequirements_nonempty
  analytic_nonempty :=
    AdvancedClaimsIIRequirement.analyticBoundaryRequirements_nonempty
