    (C : CoefficientSeparationBoundary) (n : Nat) :
    C.coefficient n = C.scalarPart n + C.thetaPart n :=
  C.separated n

theorem scalar_base_at
    (C : CoefficientSeparationBoundary) (n : Nat) :
    C.scalarPart n = C.base.scalarPart n :=
  C.scalar_eq_base n

theorem theta_base_at
    (C : CoefficientSeparationBoundary) (n : Nat) :
    C.thetaPart n = C.base.thetaPart n :=
  C.theta_eq_base n

theorem coefficient_base_at
    (C : CoefficientSeparationBoundary) (n : Nat) :
    C.coefficient n = C.base.coefficient n :=
  C.coefficient_eq_base n

theorem base_separated_at
    (C : CoefficientSeparationBoundary) (n : Nat) :
    C.base.coefficient n = C.base.scalarPart n + C.base.thetaPart n := by
  calc
    C.base.coefficient n = C.coefficient n := (C.coefficient_base_at n).symm
    _ = C.scalarPart n + C.thetaPart n := C.separated_at n
    _ = C.base.scalarPart n + C.thetaPart n := by
      rw [C.scalar_base_at n]
    _ = C.base.scalarPart n + C.base.thetaPart n := by
      rw [C.theta_base_at n]

end CoefficientSeparationBoundary

