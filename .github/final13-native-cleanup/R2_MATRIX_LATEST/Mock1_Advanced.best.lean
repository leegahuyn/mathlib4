def complexListSum (xs : List Complex) : Complex :=
  xs.foldl (fun acc x => acc + x) 0

structure FiniteResidueKloostermanSumCert where
  datum : KloostermanDatum
  residues : List Nat
  summand : Nat -> Complex
  values : List Complex
  certifiedSum : Complex
  modulus_pos :
    0 < datum.modulus
  residues_nonempty :
    Not (residues = [])
  values_eq_map :
    values = residues.map summand
  certifiedSum_eq_values_sum :
    certifiedSum = complexListSum values
  certifiedSum_eq_kloosterman :
    certifiedSum = KloostermanSum datum
  all_residues_lt_modulus :
    forall r, List.Mem r residues -> r < datum.modulus

namespace FiniteResidueKloostermanSumCert

theorem modulus_positive_at
    (C : FiniteResidueKloostermanSumCert) :
    0 < C.datum.modulus :=
  C.modulus_pos

theorem residues_nonempty_at
    (C : FiniteResidueKloostermanSumCert) :
    Not (C.residues = []) :=
  C.residues_nonempty

theorem values_map_at
    (C : FiniteResidueKloostermanSumCert) :
    C.values = C.residues.map C.summand :=
  C.values_eq_map

theorem certified_sum_values_at
    (C : FiniteResidueKloostermanSumCert) :
    C.certifiedSum = complexListSum C.values :=
  C.certifiedSum_eq_values_sum

theorem certified_sum_kloosterman_at
    (C : FiniteResidueKloostermanSumCert) :
    C.certifiedSum = KloostermanSum C.datum :=
  C.certifiedSum_eq_kloosterman

theorem residue_lt_modulus_at
    (C : FiniteResidueKloostermanSumCert)
    (r : Nat) (hr : List.Mem r C.residues) :
    r < C.datum.modulus :=
  C.all_residues_lt_modulus r hr

end FiniteResidueKloostermanSumCert

def referenceFiniteResidueKloostermanSumCert :
    FiniteResidueKloostermanSumCert where
  datum := referenceKloostermanDatum
  residues := [0]
  summand := fun _ => 0
  values := [0]
  certifiedSum := 0
  modulus_pos := by decide
  residues_nonempty := by simp
  values_eq_map := by rfl
  certifiedSum_eq_values_sum := by
    simp [complexListSum]
  certifiedSum_eq_kloosterman := by
    simp [KloostermanSum, referenceKloostermanDatum]
  all_residues_lt_modulus := by
    intro r hr
    change List.Mem r [0] at hr
    cases hr with
    | head _ => norm_num [referenceKloostermanDatum]
    | tail _ h => cases h

theorem reference_finite_residue_kloosterman_sum :
    referenceFiniteResidueKloostermanSumCert.certifiedSum =
      KloostermanSum referenceFiniteResidueKloostermanSumCert.datum :=
  referenceFiniteResidueKloostermanSumCert.certified_sum_kloosterman_at

theorem reference_finite_residue_values_sum :
    referenceFiniteResidueKloostermanSumCert.certifiedSum =
      complexListSum referenceFiniteResidueKloostermanSumCert.values :=
  referenceFiniteResidueKloostermanSumCert.certified_sum_values_at

