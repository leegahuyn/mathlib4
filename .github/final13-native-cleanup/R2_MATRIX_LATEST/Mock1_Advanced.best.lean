      0 < (completeness.manifest.auditTargets layer).length
  localPrintCovers :
    forall layer : AxiomAuditLayer,
      List.Mem layer
        (completeness.localAudit.commandLayers
          LocalAuditCommand.printAxiomsAudit)
  localLeanCommand :
    completeness.localAudit.commands LocalAuditCommand.leanFileCheck =
      "lake env lean outputs/Mock1_Integrated.lean"
  environmentLeanCommand :
    completeness.environmentPin.leanCheckCommand =
      LocalAuditCommand.shellText LocalAuditCommand.leanFileCheck
  objectiveDefinitions :
    ObjectiveDefinitionMatrix completeness.manifest.bundle
  requestedDefinitions :
    RequestedDefinitionChecklist completeness.manifest.bundle
  requestedDefinitionAudit :
    RequestedDefinitionAuditMatrix completeness.manifest.bundle
  requestedDefinitionLayerMatrix :
    RequestedDefinitionLayerMatrix completeness.manifest.bundle
  proofPayload :
    CertificateProofPayload completeness.manifest.bundle.abstract
      completeness.manifest.bundle.concrete
  proofFieldMatrix :
    ProofFieldDischargeMatrix completeness.manifest.bundle
  policy : UnconditionalityPolicy

