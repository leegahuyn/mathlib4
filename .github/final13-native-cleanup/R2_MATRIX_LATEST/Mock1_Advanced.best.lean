        f ModularMatrix.T tau =
      E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.multiplier.value
          ModularMatrix.T *
        f (E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.transportT.transport.act tau) :=
  L.slash_T_transport f tau

theorem slash_S_transport_at {E : EndToEndCertificationEvidence}
    (L : RequestedDetailFinalLedger E)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.slash
        f ModularMatrix.S tau =
      E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.multiplier.value
          ModularMatrix.S *
        f (E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.transportS.transport.act tau) :=
  L.slash_S_transport f tau

theorem degeneracy_scalar_model_at {E : EndToEndCertificationEvidence}
    (L : RequestedDetailFinalLedger E) (a : Nat -> Real) (n : Nat) :
    (DegeneracyChannel.scalar a).value n = a n :=
  L.degeneracy_scalar_model a n

theorem degeneracy_jacobi_slice_model_at
    {E : EndToEndCertificationEvidence}
    (L : RequestedDetailFinalLedger E)
    (c : Int -> Real) (a : Nat -> Int -> Real) (n : Nat) :
    (DegeneracyChannel.jacobiSlice c a).value n =
      (Finset.range (2 * n + 1)).sum
        (fun j => c ((j : Int) - n) * a n ((j : Int) - n)) :=
  L.degeneracy_jacobi_slice_model c a n

