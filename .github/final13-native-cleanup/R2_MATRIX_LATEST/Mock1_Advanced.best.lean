  And.intro (I.linked_terms_expansion n)
    (I.kernel_portfolio_expansion n)

theorem kloosterman_at
    (I : AdvancedClaimsIIRamanujanFExactCoefficientProofInput)
    (n c : Nat) :
    (I.kernelPortfolio n).expansion.multiplier c =
      KloostermanSum ((I.kernelPortfolio n).kernelCertificate c).datum :=
  (I.kernelPortfolio n).multiplier_eq_kloosterman_sum c

