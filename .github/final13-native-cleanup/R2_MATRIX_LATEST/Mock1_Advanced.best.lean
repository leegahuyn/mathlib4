theorem diagnostic_covered_at
    (C : PaperSymbolCoverageCertificate)
    (d : DiagnosticOnlyItem) :
    DiagnosticOnlyItem.toNumberedLabel d ∈ C.diagnosticLabels :=
  C.diagnosticCoverage d

theorem disjoint_at
    (C : PaperSymbolCoverageCertificate)
    (c : AdvancedClaim) (d : DiagnosticOnlyItem) :
    AdvancedClaim.toNumberedLabel c ≠
      DiagnosticOnlyItem.toNumberedLabel d :=
  C.theoremDiagnosticDisjoint c d

end PaperSymbolCoverageCertificate

