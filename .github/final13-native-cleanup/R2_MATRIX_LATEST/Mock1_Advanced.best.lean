theorem inside_outside_at {ConvergesAt : CuspLabel -> Prop}
    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt)
    (n : Nat) :
    AdvancedClaimsIIRamanujanFOutsideCoefficient n =
      2 * AdvancedClaimsIIRamanujanPsiCoefficient n -
        AdvancedClaimsIIRamanujanExplicitCorrectionCoefficient n :=
  A.t1t5.global_coefficient_identity_at n

theorem analytic_continuation_at {ConvergesAt : CuspLabel -> Prop}
    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt)
    (tau : UpperHalfPlanePoint) :
    A.t1t5.outsideAnalytic tau =
          2 * A.t1t5.psiAnalytic tau - A.t1t5.correctionAnalytic tau /\
      A.t1t5.appellLerch.holomorphicPart tau =
        A.t1t5.outsideAnalytic (A.t1t5.continuationMap tau) :=
  A.t1t5.analytic_identity_at tau

