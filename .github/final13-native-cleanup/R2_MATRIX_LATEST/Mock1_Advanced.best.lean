structure NormalizedCoefficientFormulaCertificate where
  mockCoeff : Nat -> Real
  thetaCoeff : Nat -> Real
  normalizedCoeff : Nat -> Real
  scalar : Real
  rademacher : RademacherCertificate normalizedCoeff
  coefficient_formula :
    forall n, normalizedCoeff n = scalar * (mockCoeff n * thetaCoeff n)
  rademacher_link :
    forall n, normalizedCoeff n = rademacher.main n + rademacher.remainder n

namespace NormalizedCoefficientFormulaCertificate

theorem coefficient_formula_at
    (C : NormalizedCoefficientFormulaCertificate) (n : Nat) :
    C.normalizedCoeff n = C.scalar * (C.mockCoeff n * C.thetaCoeff n) :=
  C.coefficient_formula n

theorem rademacher_link_at
    (C : NormalizedCoefficientFormulaCertificate) (n : Nat) :
    C.normalizedCoeff n = C.rademacher.main n + C.rademacher.remainder n :=
  C.rademacher_link n

theorem rademacher_tail_bound_at
    (C : NormalizedCoefficientFormulaCertificate) {n : Nat}
    (hn : C.rademacher.tail.cutoff <= n) :
    |C.rademacher.remainder n| <= C.rademacher.tail.bound :=
  C.rademacher.remainder_abs_le hn

end NormalizedCoefficientFormulaCertificate

