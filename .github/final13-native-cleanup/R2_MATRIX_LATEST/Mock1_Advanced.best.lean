theorem scalar_jacobi_degeneracy_relation_at
    {C : AdvancedClaimsIICompletionCertificate}
    (L : AdvancedClaimsIIRequirementLeafLedger C) (n : Nat) :
    C.advanced.degeneracyRelation.jacobiCoeff n
      C.advanced.degeneracyRelation.ellStar =
