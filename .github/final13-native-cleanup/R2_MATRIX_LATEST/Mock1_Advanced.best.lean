/-!
RLF bridge for the paper I.2 worked Mahler data.

The row index of the Mahler matrix is `n` and the column index is `j`, so
`B n j = choose n j` is lower triangular, not upper triangular.  The paper's
displayed coefficients are the canonical residues modulo 25 of the integral
forward differences.  Tables 5A and 5B have zero finite differences on the
worked range.  None of these finite facts supplies the missing uniform
Rademacher-tail theorem; that boundary remains visible in the input audit.
-/

def AdvancedClaimsIIPaperI2MahlerMatrixEntry
    (n j : Fin 6) : Nat :=
  Nat.choose (n : Nat) (j : Nat)

def AdvancedClaimsIIPaperI2MahlerMatrixLowerTriangular : Prop :=
  forall n j : Fin 6,
    (n : Nat) < (j : Nat) ->
      AdvancedClaimsIIPaperI2MahlerMatrixEntry n j = 0

def AdvancedClaimsIIPaperI2MahlerMatrixUpperTriangular : Prop :=
  forall n j : Fin 6,
    (j : Nat) < (n : Nat) ->
      AdvancedClaimsIIPaperI2MahlerMatrixEntry n j = 0

theorem advanced_claims_ii_paper_i2_mahler_matrix_lower_triangular :
    AdvancedClaimsIIPaperI2MahlerMatrixLowerTriangular := by
  intro n j h
  unfold AdvancedClaimsIIPaperI2MahlerMatrixEntry
  exact Nat.choose_eq_zero_of_lt h

theorem advanced_claims_ii_paper_i2_mahler_matrix_above_diagonal_zero
    (n j : Fin 6)
    (h : (n : Nat) < (j : Nat)) :
    AdvancedClaimsIIPaperI2MahlerMatrixEntry n j = 0 :=
  advanced_claims_ii_paper_i2_mahler_matrix_lower_triangular n j h

theorem advanced_claims_ii_paper_i2_mahler_matrix_unit_diagonal :
    forall n : Fin 6,
      AdvancedClaimsIIPaperI2MahlerMatrixEntry n n = 1 := by
  intro n
  simp [AdvancedClaimsIIPaperI2MahlerMatrixEntry]

theorem advanced_claims_ii_paper_i2_mahler_matrix_below_diagonal_witness :
    AdvancedClaimsIIPaperI2MahlerMatrixEntry
      (1 : Fin 6) (0 : Fin 6) = 1 := by
  norm_num [AdvancedClaimsIIPaperI2MahlerMatrixEntry]

theorem advanced_claims_ii_paper_i2_mahler_matrix_not_upper_triangular :
    Not AdvancedClaimsIIPaperI2MahlerMatrixUpperTriangular := by
  intro h
  have hz := h (1 : Fin 6) (0 : Fin 6) (by norm_num)
  norm_num [AdvancedClaimsIIPaperI2MahlerMatrixEntry] at hz

def AdvancedClaimsIIPaperI2ForwardDifference (j : Nat) : Int :=
  Finset.sum (Finset.range (j + 1))
    (fun i =>
      ((-1 : Int) ^ (j - i)) *
        (Nat.choose j i : Int) *
          AdvancedClaimsIIPaperI2NormalizedValue i)

def AdvancedClaimsIIPaperI2ForwardDifferenceResidue
    (j : Fin 6) : Int :=
  AdvancedClaimsIIPaperI2ForwardDifference (j : Nat) %
    (PrimePower AdvancedClaimsIIPaperI2Prime
      AdvancedClaimsIIPaperI2Precision : Int)

theorem advanced_claims_ii_paper_i2_forward_difference_table :
