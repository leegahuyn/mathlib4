/-!
Concrete finite coefficient model for Ramanujan's third-order mock theta `f`.

For fixed `n`, the reciprocal denominator is
`prod_{j=1}^n (1 + q^j)^(-2)`. Its `q^r` coefficient is computed by the
finite recurrence using `(1 + X)^(-2) = sum_t (-1)^t (t + 1) X^t`.
The resulting coefficient function is therefore an exact combinatorial
q-series datum, independent of the later analytic completion boundary.
-/

def AdvancedClaimsIIRamanujanDenominatorInvCoeff : Nat -> Nat -> Int
  | 0, r => if r = 0 then 1 else 0
  | n + 1, r =>
      (Finset.range (r / (n + 1) + 1)).sum
        (fun t =>
          AdvancedClaimsIIRamanujanDenominatorInvCoeff n
              (r - (n + 1) * t) *
            ((-1 : Int) ^ t) * ((t + 1 : Nat) : Int))

def AdvancedClaimsIIRamanujanFCoefficient (r : Nat) : Int :=
  (if r = 0 then 1 else 0) +
    (Finset.range (r + 1)).sum
      (fun n =>
        if 0 < n /\ n * n <= r then
          AdvancedClaimsIIRamanujanDenominatorInvCoeff n (r - n * n)
        else 0)

def AdvancedClaimsIIRamanujanFPrefixTable : List Int :=
  (List.range 16).map AdvancedClaimsIIRamanujanFCoefficient

@[simp]
theorem advanced_claims_ii_ramanujan_denominator_zero_zero :
    AdvancedClaimsIIRamanujanDenominatorInvCoeff 0 0 = 1 := by
  rfl

@[simp]
theorem advanced_claims_ii_ramanujan_denominator_zero_succ (r : Nat) :
    AdvancedClaimsIIRamanujanDenominatorInvCoeff 0 (r + 1) = 0 := by
  simp [AdvancedClaimsIIRamanujanDenominatorInvCoeff]

theorem advanced_claims_ii_ramanujan_denominator_succ
    (n r : Nat) :
    AdvancedClaimsIIRamanujanDenominatorInvCoeff (n + 1) r =
      (Finset.range (r / (n + 1) + 1)).sum
        (fun t =>
          AdvancedClaimsIIRamanujanDenominatorInvCoeff n
              (r - (n + 1) * t) *
            ((-1 : Int) ^ t) * ((t + 1 : Nat) : Int)) := by
  rfl

theorem advanced_claims_ii_ramanujan_f_coefficient_formula (r : Nat) :
    AdvancedClaimsIIRamanujanFCoefficient r =
      (if r = 0 then 1 else 0) +
        (Finset.range (r + 1)).sum
          (fun n =>
            if 0 < n /\ n * n <= r then
              AdvancedClaimsIIRamanujanDenominatorInvCoeff n (r - n * n)
            else 0) := by
  rfl

