/-!
Actual Ramanujan entropy, alpha extraction, and Cardy payload.

This layer does not use the legacy proposition `cEqualsOne := True`.  The
caller must identify the first Rademacher term, prove its logarithmic growth
limit, prove the full three-regressor asymptotic for the actual Ramanujan
coefficient function, and dominate the certified remainder by that first
term.  Reported decimal values enter only through rational/real interval
membership.
-/

def AdvancedClaimsIIThreeRegressorEntropyGrowth
    (coefficient : Nat -> Real)
    (alpha beta gamma : Real) : Prop :=
  Filter.Tendsto
    (fun n : Nat =>
      Real.log (abs (coefficient n)) -
        (alpha * Real.sqrt (n : Real) +
          beta * Real.log (n : Real) + gamma))
    Filter.atTop (nhds (0 : Real))

def AdvancedClaimsIIRationalIntervalContainsReal
    (interval : RationalInterval)
    (value : Real) : Prop :=
  (interval.lower : Real) <= value /\ value <= (interval.upper : Real)

structure AdvancedClaimsIIRamanujanFEntropyAsymptoticProofInput where
  sourceName : String
  alphaExtractionSource : String
  tailDominanceSource : String
  cardySource : String
  replacementPlan : String
  exactCoefficient : AdvancedClaimsIIRamanujanFExactCoefficientProofInput
  regression : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput
  alpha : Real
  beta : Real
  gamma : Real
  cOneMain : Nat -> Real
  tailCutoff : Nat
  tailRatio : Real
  sourceName_nonempty :
    Not (sourceName = "")
  alphaExtractionSource_nonempty :
    Not (alphaExtractionSource = "")
  tailDominanceSource_nonempty :
    Not (tailDominanceSource = "")
  cardySource_nonempty :
    Not (cardySource = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  entropy_growth :
    AdvancedClaimsIIThreeRegressorEntropyGrowth
      referenceAdvancedClaimsIIRamanujanFPaperObject.coeff alpha beta gamma
  c_one_link :
    forall n : Nat,
      cOneMain n = (exactCoefficient.rademacherExpansion.expansion n).term 0
  c_one_alpha_limit :
    Filter.Tendsto
      (fun n : Nat =>
        Real.log (abs (cOneMain n)) / Real.sqrt (n : Real))
      Filter.atTop (nhds alpha)
  tail_cutoff_pos :
    0 < tailCutoff
  rademacher_cutoff_includes_c_one :
    forall n : Nat,
      tailCutoff <= n ->
        0 < exactCoefficient.rademacherExpansion.cutoff n
  tail_ratio_nonnegative :
    0 <= tailRatio
  tail_ratio_lt_one :
    tailRatio < 1
  tail_dominance :
    forall n : Nat,
      tailCutoff <= n ->
        abs (exactCoefficient.rademacherExpansion.remainder n) <=
          tailRatio * abs (cOneMain n)
  alpha_interval :
    AdvancedClaimsIIRationalIntervalContainsReal referenceAlphaInterval alpha
  beta_interval :
    AdvancedClaimsIIRationalIntervalContainsReal referenceBetaInterval beta
  gamma_interval :
    AdvancedClaimsIIRationalIntervalContainsReal referenceGammaInterval gamma
  cardy_interval :
    AdvancedClaimsIIRationalIntervalContainsReal
      referenceCeffInterval (effectiveCardyConstant alpha)

