/-!
Ramanujan-specific p-adic analytic-range and all-cusp chart boundary.

The finite six-term Mahler certificate is already exact.  The missing global
claim is represented here without the legacy `True` range or identically-zero
tail: a caller must provide one uniform denominator, transported chart values
at all three paper cusps, an eventual range equivalent to `cutoff <= n`, and
mod-25 vanishing of the actual Ramanujan/Mahler residual on that range.
-/

structure AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput where
  sourceName : String
  denominatorSource : String
  chartTransportSource : String
  tailTheoremSource : String
  replacementPlan : String
  cutoff : Nat
  analyticRange : Nat -> Prop
  uniformDenominator : Nat
  rawAt : CuspLabel -> Nat -> Rat
  normalizedAt : CuspLabel -> Nat -> Int
  chartAt : CuspLabel -> Nat -> Int
  tail : CuspLabel -> Nat -> Int
  sourceName_nonempty :
    Not (sourceName = "")
  denominatorSource_nonempty :
    Not (denominatorSource = "")
  chartTransportSource_nonempty :
    Not (chartTransportSource = "")
  tailTheoremSource_nonempty :
    Not (tailTheoremSource = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  cutoff_pos :
    0 < cutoff
  analytic_range_iff :
    forall n : Nat, analyticRange n <-> cutoff <= n
  denominator_pos :
    0 < uniformDenominator
  denominator_coprime_precision :
    Nat.Coprime uniformDenominator
      (PrimePower AdvancedClaimsIIPaperI2Prime
        AdvancedClaimsIIPaperI2Precision)
  denominator_clearing :
    forall (cusp : CuspLabel)
      (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps)
      (n : Nat),
      (uniformDenominator : Rat) * rawAt cusp n =
        (normalizedAt cusp n : Rat)
  infinity_normalized_actual :
    forall n : Nat,
      normalizedAt infinityCuspLabel n =
        AdvancedClaimsIIRamanujanFPAdicIntegralValue n
  chart_congruence :
    forall (cusp : CuspLabel)
      (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps)
      (n : Nat),
      FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
        AdvancedClaimsIIPaperI2Precision
        (normalizedAt cusp n) (chartAt cusp n)
  chart_transport :
    forall (source target : CuspLabel)
      (hsource : List.Mem source referenceAdvancedClaimsIIPaperItem1Cusps)
      (htarget : List.Mem target referenceAdvancedClaimsIIPaperItem1Cusps)
      (n : Nat),
      FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
        AdvancedClaimsIIPaperI2Precision
        (chartAt source n) (chartAt target n)
  tail_formula :
    forall (cusp : CuspLabel) (n : Nat),
      tail cusp n =
        normalizedAt cusp n - AdvancedClaimsIIRamanujanFPAdicMahlerEval n
  tail_zero_on_range :
    forall (cusp : CuspLabel)
      (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps)
      (n : Nat),
      analyticRange n ->
        FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
          AdvancedClaimsIIPaperI2Precision (tail cusp n) 0

namespace AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput

theorem range_at
    (I : AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput)
    (n : Nat) :
    I.analyticRange n <-> I.cutoff <= n :=
  I.analytic_range_iff n

theorem denominator_at
    (I : AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps)
    (n : Nat) :
    (I.uniformDenominator : Rat) * I.rawAt cusp n =
      (I.normalizedAt cusp n : Rat) :=
  I.denominator_clearing cusp hcusp n

theorem actual_infinity_at
    (I : AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput)
    (n : Nat) :
    I.normalizedAt infinityCuspLabel n =
      AdvancedClaimsIIRamanujanFPAdicIntegralValue n :=
  I.infinity_normalized_actual n

theorem chart_at
    (I : AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps)
    (n : Nat) :
    FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
      AdvancedClaimsIIPaperI2Precision
