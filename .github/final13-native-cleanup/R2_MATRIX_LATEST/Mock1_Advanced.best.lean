theorem mahler_formula {X : Type*} (c : ConcreteCertificate X) (n : Nat) :
    c.mahler.eval n =
      Finset.univ.sum
        (fun j : Fin c.mahler.length =>
          c.mahler.coeff j * c.mahler.basis j n) :=
  c.mahler.eval_formula_at n

theorem mahler_binomial_matches {X : Type*} (c : ConcreteCertificate X)
