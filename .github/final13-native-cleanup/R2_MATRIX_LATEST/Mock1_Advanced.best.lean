    forall n, cutoff <= n -> predicate n
  tail_zero_on_range :
    forall n, predicate n -> tail n = 0

namespace PAdicAnalyticRangeTailZeroCertificate

theorem predicate_at
    (C : PAdicAnalyticRangeTailZeroCertificate)
    (n : Nat) (hn : C.cutoff <= n) :
    C.predicate n :=
  C.predicate_after_cutoff n hn

theorem tail_zero_at
    (C : PAdicAnalyticRangeTailZeroCertificate)
    (n : Nat) (hn : C.predicate n) :
    C.tail n = 0 :=
  C.tail_zero_on_range n hn

end PAdicAnalyticRangeTailZeroCertificate

def referencePAdicAnalyticRangeTailZeroCertificate :
    PAdicAnalyticRangeTailZeroCertificate where
  cutoff := 0
  predicate := fun _ => True
  tail := fun _ => 0
  predicate_after_cutoff := by
    intro n hn
    trivial
  tail_zero_on_range := by
    intro n hn
    rfl

