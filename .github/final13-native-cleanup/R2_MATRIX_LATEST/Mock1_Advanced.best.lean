structure PaperDataInstancePayloadCertificate
    (C : AdvancedClaimsIICompletionCertificate) : Prop where
  claim_registry_data :
    C.advanced.registry.requirements = RemainingAdvancedClaim.all /\
      Not (C.advanced.registry.registryName = "") /\
        Not (C.advanced.registry.sourceName = "") /\
          forall claim : RemainingAdvancedClaim,
            List.Mem claim C.advanced.registry.requirements
  object_coefficient_data :
    C.advanced.objectSchema.schema.objectName =
        C.advanced.objectSchema.object.name /\
      C.advanced.objectSchema.family.objectName =
          C.advanced.objectSchema.object.name /\
        C.advanced.objectSchema.concrete.object =
            C.advanced.objectSchema.object /\
          C.advanced.coefficientSchema = C.advanced.objectSchema /\
            forall n, C.advanced.objectSchema.coefficientAt n =
              C.advanced.objectSchema.object.coeff n
  paper_object_instance_data :
    C.paperInstance.extraction.concrete =
        C.paperInstance.namedInstance.concrete /\
      C.paperInstance.family =
          C.paperInstance.namedInstance.family /\
        C.paperInstance.family.objectName =
            referenceMock1DepthOneObjectName /\
          C.paperInstance.family.familyName =
              referenceMock1DepthOneFamilyName /\
            Not (C.paperInstance.family.sourceName = "")
  family_parameter_data :
    C.paperInstance.family.weightNumerator = 1 /\
      C.paperInstance.family.weightDenominator = 2 /\
        0 < C.paperInstance.family.level /\
          C.paperInstance.family.qShift = 0 /\
            C.paperInstance.family.workingCusp = infinityCuspLabel /\
              C.paperInstance.family.transportedCusp = zeroCuspLabel /\
                C.paperInstance.family.z0 = (-1 / 2 : Rat)
  ridge_vector_data :
    C.paperInstance.family.ridgeN = 80 /\
      C.paperInstance.family.ell0 = 50 /\
        C.paperInstance.family.mList.length =
            C.paperInstance.family.ridgeDepth /\
          C.paperInstance.family.rPhases.length = 2 /\
            C.paperInstance.family.columnCount =
                C.paperInstance.family.ridgeDepth *
                  C.paperInstance.family.rPhases.length /\
              C.paperInstance.family.targetVector.length =
                  C.paperInstance.family.principalPart.order /\
                C.paperInstance.family.principalPart.order = 1
  scalar_jacobi_degeneracy_data :
    C.advanced.degeneracyRelation.ellStar = 0 /\
      C.advanced.degeneracyRelation.weights = [1, 1] /\
        C.advanced.degeneracyRelation.usesScalar = true /\
          forall n, C.advanced.degeneracyRelation.jacobiCoeff n
            C.advanced.degeneracyRelation.ellStar =
              C.advanced.degeneracyRelation.scalarCoeff n
  paper_matrix_rhs_solution_data :
    Not (C.advanced.rationalSolve.sourceName = "") /\
      C.advanced.rationalSolve.matrix.length =
          C.advanced.rationalSolve.rows /\
        C.advanced.rationalSolve.rhs.length =
            C.advanced.rationalSolve.rows /\
          C.advanced.rationalSolve.solution.length =
              C.advanced.rationalSolve.columns /\
            MatVecRat C.advanced.rationalSolve.matrix
              C.advanced.rationalSolve.solution =
                C.advanced.rationalSolve.rhs
  appell_lerch_data :
    Not (C.advanced.appellLerch.sourceName = "") /\
      List.Mem C.advanced.appellLerch.m referenceMock1MList /\
        List.Mem C.advanced.appellLerch.r referenceMock1RPhases /\
          C.advanced.appellLerch.uTauCoeff -
              C.advanced.appellLerch.vTauCoeff = 0 /\
            C.advanced.appellLerch.uConst -
                C.advanced.appellLerch.vConst =
              C.advanced.appellLerch.z0
  principal_exponent_data :
    Not (C.advanced.exponentFormula.sourceName = "") /\
      List.Mem C.advanced.exponentFormula.m referenceMock1MList /\
        C.advanced.exponentFormula.exponent =
            paperPrincipalExponent C.advanced.exponentFormula.n
              C.advanced.exponentFormula.ell
              C.advanced.exponentFormula.m /\
          C.advanced.exponentFormula.exponent < 0
  fixed_shadow_unary_theta_data :
    Not (C.advanced.fixedShadow.sourceName = "") /\
      Not (C.advanced.fixedShadow.thetaSymbol = "") /\
        C.advanced.fixedShadow.z0 = (-1 / 2 : Rat) /\
          C.advanced.fixedShadow.nonzeroCase /\
            Not (C.advanced.fixedShadow.scale = 0)
  inside_outside_qseries_data :
    forall n,
      C.advanced.insideOutside.inside.coeff n =
          C.advanced.insideOutside.object.coeff n /\
        C.advanced.insideOutside.objectSeries.coeff n =
            C.advanced.insideOutside.object.coeff n /\
          C.advanced.insideOutside.inside.coeff n =
              C.advanced.insideOutside.outside.coeff n /\
            C.advanced.insideOutside.outside.coeff n =
            C.advanced.insideOutside.partialTheta.coeff n -
                C.advanced.insideOutside.correction.coeff n

