def primaryRequirement (item : RequestedDefinitionItem) : RequirementKey :=
  ObjectiveItem.primaryRequirement (primaryObjective item)

def Covered {X : Type*} {B : UnconditionalCertificationBundle X}
    (H : RequestedDefinitionChecklist B) :
    RequestedDefinitionItem -> Prop
  | domainQCusps =>
      (forall tau, 0 < (B.checklist.domainPoint tau).z.im) /\
      (forall tau, qParameter tau =
        Complex.exp ((((2 : Real) * Real.pi) : Complex) *
          Complex.I * tau.z)) /\
      (forall T tau, B.checklist.cuspTransport T tau =
        qParameter (T.act tau)) /\
      (forall tau,
        qParameter (B.checklist.cuspTransportCertificate.transport.act tau) =
          Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
            B.checklist.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau)) /\
      (forall tau,
        (B.checklist.cuspTransportCertificate.transport.act tau).z =
          B.checklist.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau) /\
      B.checklist.cuspTransportCertificate.transport.source =
        B.checklist.cuspSourceWitness /\
      B.checklist.cuspTransportCertificate.transport.target =
        B.checklist.cuspTargetWitness /\
      B.checklist.cuspTransportCertificate.transport.matrix =
        B.checklist.cuspMatrixWitness
  | qSeriesPrincipalPolar =>
      (forall n, B.checklist.qSeriesWitness.coefficientAt n =
        B.checklist.qSeriesWitness.coeff n) /\
      (forall n, forall h :
        n < B.checklist.qSeriesPrefixWitness.truncated.length,
          B.checklist.qSeriesPrefixWitness.truncated.coefficientAt n =
            B.checklist.qSeriesPrefixWitness.full.coeff n) /\
      (forall q : Real, B.checklist.qSeriesPrefixWitness.truncatedEval q =
        B.checklist.qSeriesPrefixWitness.fullPrefixEval q) /\
      B.checklist.qSeriesPrefixWitness.truncatedCoeffSum =
        B.checklist.qSeriesPrefixWitness.fullPrefixCoeffSum /\
      (forall n, B.checklist.finiteSupportWitness.cutoff <= n ->
        B.checklist.finiteSupportWitness.series.coefficientAt n = 0) /\
      (forall n, B.checklist.laurentWitness.principalCoeff n =
        B.checklist.laurentWitness.coeff (-((n + 1 : Nat) : Int))) /\
      (forall i : Fin B.checklist.principalPartLink.principal.order,
        B.checklist.principalPartLink.principal.coeffAt i =
          B.checklist.principalPartLink.laurent.coeff
            (-(((i : Nat) + 1 : Nat) : Int))) /\
      B.checklist.principalPartLink.laurent =
        B.checklist.laurentWitness /\
      B.checklist.principalPartLink.principal =
        B.checklist.principalPartWitness /\
      (forall i : Fin B.checklist.polarProfileLink.profile.terms,
        (B.checklist.polarProfileLink.profile.term i).exponent =
          -(((i : Nat) + 1 : Nat) : Int)) /\
      (forall i : Fin B.checklist.polarProfileLink.profile.terms,
        (B.checklist.polarProfileLink.profile.term i).exponent < 0) /\
      B.checklist.polarProfileLink.profile =
        B.checklist.polarProfileWitness
  | appellLerchSpecialization =>
      (forall tau, u0 tau = tau.z / 2) /\
      (forall tau, v0 tau = tau.z / 2 + 1 / 2) /\
      frozenZ0 = -1 / 2 /\
      (forall tau, u0 tau - v0 tau = frozenZ0) /\
      (forall tau,
        B.checklist.appellLerchWitness.specializedMu tau =
          B.checklist.appellLerchWitness.mu (u0 tau) (v0 tau) tau)
  | completionMuHatShadow =>
      (forall tau,
        B.checklist.appellLerchWitness.specializedMuHat tau =
          B.checklist.appellLerchWitness.muHat (u0 tau) (v0 tau) tau) /\
      (forall u v tau,
        B.checklist.appellLerchWitness.muHat u v tau =
          B.checklist.appellLerchWitness.mu u v tau +
            (Complex.I / 2) *
              B.checklist.appellLerchWitness.R (u - v) tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.completionTerm tau =
          (Complex.I / 2) *
            B.checklist.appellLerchWitness.R frozenZ0 tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.specializedMuHat tau =
          B.checklist.appellLerchWitness.specializedMu tau +
            B.checklist.appellLerchWitness.completionTerm tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.gz tau =
          B.checklist.appellLerchWitness.unaryThetaAt frozenZ0 tau)
  | xiOperator =>
      forall tau, B.checklist.xiWitness.xiOperator.xi
          B.checklist.xiWitness.completedObject tau =
        B.checklist.xiWitness.scale * B.checklist.xiWitness.shadow tau
  | slashTransportMultiplier =>
      B.checklist.slashGeneratorWitness.weight = halfWeight /\
      B.checklist.slashGeneratorWitness.action.multiplier.value_T =
        B.checklist.slashGeneratorWitness.action.multiplier.value
          ModularMatrix.T /\
      B.checklist.slashGeneratorWitness.action.multiplier.value_S =
        B.checklist.slashGeneratorWitness.action.multiplier.value
          ModularMatrix.S /\
      (forall f tau,
        B.checklist.slashGeneratorWitness.action.slash f ModularMatrix.T tau =
          B.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.T *
            f (B.checklist.slashGeneratorWitness.transportT.transport.act tau)) /\
      (forall f tau,
        B.checklist.slashGeneratorWitness.action.slash f ModularMatrix.S tau =
          B.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.S *
            f (B.checklist.slashGeneratorWitness.transportS.transport.act tau)) /\
      (forall tau,
        qParameter (B.checklist.slashGeneratorWitness.transportT.transport.act tau) =
          Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
            B.checklist.slashGeneratorWitness.transportT.transport.matrix.fractionalLinearFormula tau)) /\
      (forall tau,
        qParameter (B.checklist.slashGeneratorWitness.transportS.transport.act tau) =
          Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
            B.checklist.slashGeneratorWitness.transportS.transport.matrix.fractionalLinearFormula tau)) /\
      (forall tau,
        (B.checklist.slashGeneratorWitness.transportT.transport.act tau).z =
          B.checklist.slashGeneratorWitness.transportT.transport.matrix.fractionalLinearFormula tau) /\
      (forall tau,
        (B.checklist.slashGeneratorWitness.transportS.transport.act tau).z =
          B.checklist.slashGeneratorWitness.transportS.transport.matrix.fractionalLinearFormula tau)
  | principalLinearSystems =>
      (forall i, B.checklist.linearSystemIntWitness.system.matrix.mulVec
          B.checklist.linearSystemIntWitness.solution i =
        B.checklist.linearSystemIntWitness.system.rhs i) /\
      (forall i, B.checklist.linearSystemRatWitness.system.matrix.mulVec
          B.checklist.linearSystemRatWitness.solution i =
        B.checklist.linearSystemRatWitness.system.rhs i) /\
      (forall i,
        (B.checklist.linearSystemComplexWitness.residual i).Contains 0) /\
      B.checklist.linearSystemIntWitness.system.rows =
        B.checklist.principalPartWitness.order /\
      B.checklist.linearSystemRatWitness.system.rows =
        B.checklist.principalPartWitness.order /\
      B.checklist.linearSystemComplexWitness.system.rows =
        B.checklist.principalPartWitness.order
  | entropyAsymptotic =>
      EntropyGrowthEpsilonN B.checklist.qSeriesWitness.coeff
        B.checklist.entropyWitness.alpha
        B.checklist.entropyWitness.beta /\
      EntropyGrowthLittleOOne B.checklist.qSeriesWitness.coeff
        B.checklist.entropyWitness.alpha
        B.checklist.entropyWitness.beta
  | rademacherExpansion =>
      (forall n, B.checklist.qSeriesWitness.coeff n =
        (B.checklist.rademacherWitness.expansion n).truncation
          (B.checklist.rademacherWitness.cutoff n) +
            B.checklist.rademacherWitness.remainder n) /\
      (forall c, B.checklist.rademacherKernelWitness.expansion.multiplier c =
        KloostermanSum
          (B.checklist.rademacherKernelWitness.kernelCertificate c).datum) /\
      (forall c,
        B.checklist.rademacherKernelWitness.expansion.kloostermanAt c =
          (B.checklist.rademacherKernelWitness.kernelCertificate c).certifiedSum) /\
      (forall c, B.checklist.linkedRademacherWitness.expansion.term c =
        (B.checklist.linkedRademacherWitness.termCertificate c).data.amplitude *
          BesselIHalfModel
            (B.checklist.linkedRademacherWitness.termCertificate c).data.besselArgument) /\
      B.checklist.linkedRademacherWitness.expansion.truncation 1 =
        (B.checklist.linkedRademacherWitness.termCertificate 0).data.value /\
      (forall n, B.checklist.rademacherWitness.tail.cutoff <= n ->
        |B.checklist.rademacherWitness.remainder n| <=
          B.checklist.rademacherWitness.tail.C *
            Real.exp
              (-B.checklist.rademacherWitness.tail.lambda *
                Real.sqrt (n : Real))) /\
      (forall n, 0 <= B.checklist.rademacherWitness.tail.C *
        Real.exp
          (-B.checklist.rademacherWitness.tail.lambda *
            Real.sqrt (n : Real)))
  | degeneracyChannel =>
      (forall n, B.checklist.degeneracyWitness.value n =
        B.checklist.qSeriesWitness.coeff n) /\
      (forall a n, (DegeneracyChannel.scalar a).value n = a n) /\
      (forall c a n, (DegeneracyChannel.jacobiSlice c a).value n =
        (Finset.range (2 * n + 1)).sum
          (fun j => c ((j : Int) - n) * a n ((j : Int) - n)))
  | effectiveCardyConstant =>
      MockCert.effectiveCardyConstant B.checklist.entropyWitness.alpha =
        6 * (B.checklist.entropyWitness.alpha / 2) ^ 2 /
          (Real.pi ^ 2) /\
      0 <= MockCert.effectiveCardyConstant B.checklist.entropyWitness.alpha
  | sptEqualizerCrt =>
      (modularIdeal B.checklist.sptIdealWitness.spt.M).generator =
        B.checklist.sptIdealWitness.spt.M /\
      (padicIdeal B.checklist.sptIdealWitness.spt.p
        B.checklist.sptIdealWitness.spt.k).generator =
          B.checklist.sptIdealWitness.spt.p ^
            B.checklist.sptIdealWitness.spt.k /\
      Dvd.dvd
        (Nat.lcm B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k))
        B.checklist.sptWitness.equalizerElement /\
      ((modularIdeal B.checklist.sptIdealWitness.spt.M).intersection
          (padicIdeal B.checklist.sptIdealWitness.spt.p
            B.checklist.sptIdealWitness.spt.k)).Contains
        B.checklist.sptIdealWitness.spt.equalizerElement /\
      (modularIdeal B.checklist.sptIdealWitness.spt.M).failureLocus
          (padicIdeal B.checklist.sptIdealWitness.spt.p
            B.checklist.sptIdealWitness.spt.k) =
        Nat.gcd B.checklist.sptIdealWitness.spt.M
          (B.checklist.sptIdealWitness.spt.p ^
            B.checklist.sptIdealWitness.spt.k) /\
      (forall i : Fin B.checklist.crtWitness.moduliCount,
        NatCongruent (B.checklist.crtWitness.modulus i)
          B.checklist.crtWitness.candidate
          (B.checklist.crtWitness.residue i)) /\
      (forall i j : Fin B.checklist.crtWitness.moduliCount,
        PairCompatible (B.checklist.crtWitness.modulus i)
          (B.checklist.crtWitness.modulus j)
          (B.checklist.crtWitness.residue i)
          (B.checklist.crtWitness.residue j))
  | torObstruction =>
      B.checklist.torWitness.quotientOrder =
        Nat.gcd B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k) /\
      B.checklist.torWitness.quotientOrder =
        B.checklist.sptWitness.obstruction.order /\
      B.checklist.torWitness.leftQuotient.modulus =
        B.checklist.sptWitness.M /\
      B.checklist.torWitness.rightQuotient.modulus =
        B.checklist.sptWitness.p ^ B.checklist.sptWitness.k /\
      B.checklist.torWitness.obstructionQuotient.order =
        Nat.gcd B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k)
  | padicMahler =>
      (forall n, IntCongruent
        (PrimePower B.checklist.padicWitness.p
          B.checklist.padicWitness.k)
        (B.checklist.padicWitness.normalized n)
        (B.checklist.padicWitness.raw n)) /\
      (forall n, FiniteCongruenceMod B.checklist.padicWitness.p
        B.checklist.padicWitness.k
        (B.checklist.padicWitness.normalized n)
        (B.checklist.padicWitness.raw n)) /\
      (forall n, IntCongruent
        (PrimePower B.checklist.mahlerWitness.p
          B.checklist.mahlerWitness.k)
        (B.checklist.mahlerWitness.eval n)
        (B.checklist.mahlerWitness.target n)) /\
      (forall n, B.checklist.mahlerWitness.eval n =
        Finset.univ.sum
          (fun j : Fin B.checklist.mahlerWitness.length =>
            B.checklist.mahlerWitness.coeff j *
              B.checklist.mahlerWitness.basis j n)) /\
      (forall n, FiniteCongruenceMod
        B.checklist.mahlerBinomialWitness.p
        B.checklist.mahlerBinomialWitness.k
        (B.checklist.mahlerBinomialWitness.eval n)
        (B.checklist.mahlerBinomialWitness.target n)) /\
      (forall n, B.checklist.mahlerBinomialWitness.eval n =
        Finset.univ.sum
          (fun j : Fin B.checklist.mahlerBinomialWitness.length =>
            B.checklist.mahlerBinomialWitness.coeff j *
              mahlerBinomialBasis (j : Nat) n))
  | regressionCertificate =>
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.predictedAt i =
          B.checklist.olsWitness.alphaHat *
              (B.checklist.olsWitness.point i).xSqrt -
            (1 / 2 : Rat) * (B.checklist.olsWitness.point i).xLog +
              B.checklist.olsWitness.betaHat) /\
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.residual i =
          (B.checklist.olsWitness.point i).yLogAbsCoeff -
            (B.checklist.olsWitness.alphaHat *
                (B.checklist.olsWitness.point i).xSqrt -
              (1 / 2 : Rat) * (B.checklist.olsWitness.point i).xLog +
                B.checklist.olsWitness.betaHat)) /\
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.residual i =
          (B.checklist.olsWitness.point i).yLogAbsCoeff -
            B.checklist.olsWitness.predictedAt i) /\
      B.checklist.olsWitness.alphaInterval.Contains
        B.checklist.olsWitness.alphaHat /\
      B.checklist.olsWitness.betaInterval.Contains
        B.checklist.olsWitness.betaHat /\
      0 <= B.checklist.olsWitness.residualBound /\
      (forall i : Fin B.checklist.olsWitness.points,
        |B.checklist.olsWitness.residual i| <=
          B.checklist.olsWitness.residualBound) /\
      (forall i : Fin B.checklist.olsWitness.points,
        0 <= |B.checklist.olsWitness.residual i|)
  | abstractConcreteSeparation =>
      B.concrete.toAbstractCertificate = B.abstract /\
      B.checklist.paperObjectWitness = B.abstract.object /\
      B.checklist.objectQSeriesWitness.object = B.abstract.object

theorem covered_by_checklist {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (H : RequestedDefinitionChecklist B)
    (item : RequestedDefinitionItem) :
    Covered H item := by
  cases item
  case domainQCusps =>
    exact And.intro H.upper_half_plane_domain
      (And.intro H.q_parameter_formula
        (And.intro H.cusp_transport
          (And.intro H.certified_cusp_transport_q
            (And.intro H.certified_cusp_transport_formula
              (And.intro H.cusp_route_source
                (And.intro H.cusp_route_target H.cusp_route_matrix))))))
  case qSeriesPrincipalPolar =>
    exact And.intro H.qseries_coefficient
      (And.intro H.qseries_truncated_prefix
        (And.intro H.qseries_truncated_eval
          (And.intro H.qseries_truncated_coeff_sum
            (And.intro H.qseries_finite_support
              (And.intro H.laurent_principal
                (And.intro H.principal_part
                  (And.intro H.principal_laurent_link
                    (And.intro H.principal_witness_link
                      (And.intro H.polar_profile_formula
                        (And.intro H.polar_profile
                          H.polar_witness_link))))))))))
  case appellLerchSpecialization =>
    exact And.intro H.appell_u0_formula
      (And.intro H.appell_v0_formula
        (And.intro H.appell_frozen_z0_formula
          (And.intro H.appell_u0_v0
            H.appell_mu_specialization)))
  case completionMuHatShadow =>
    exact And.intro H.appell_muHat_u0_v0
      (And.intro H.appell_muHat_general
        (And.intro H.appell_completion
          (And.intro H.appell_muHat_completion
            H.appell_unary_theta_shadow)))
  case xiOperator =>
    exact H.xi_operator
  case slashTransportMultiplier =>
    exact And.intro H.slash_weight_half
      (And.intro H.slash_multiplier_T
        (And.intro H.slash_multiplier_S
          (And.intro H.slash_T_transport
            (And.intro H.slash_S_transport
              (And.intro H.slash_T_transport_q
                (And.intro H.slash_S_transport_q
                  (And.intro H.slash_T_transport_formula
                    H.slash_S_transport_formula)))))))
  case principalLinearSystems =>
    exact And.intro H.linear_int_system
      (And.intro H.linear_rat_system
        (And.intro H.linear_complex_interval
          (And.intro H.linear_int_rows_principal
            (And.intro H.linear_rat_rows_principal
              H.linear_complex_rows_principal))))
  case entropyAsymptotic =>
    exact And.intro H.entropy_epsilonN H.entropy_littleO
  case rademacherExpansion =>
    exact And.intro H.rademacher_expansion
      (And.intro H.rademacher_kernel
        (And.intro H.rademacher_kloosterman
          (And.intro H.rademacher_bessel
            (And.intro H.rademacher_truncation_one
              (And.intro H.rademacher_tail
                H.rademacher_tail_envelope_nonneg)))))
  case degeneracyChannel =>
    exact And.intro H.degeneracy_channel
      (And.intro H.degeneracy_scalar_model
        H.degeneracy_jacobi_slice_model)
  case effectiveCardyConstant =>
    exact And.intro H.effective_cardy_formula H.effective_cardy_nonneg
  case sptEqualizerCrt =>
    exact And.intro H.spt_modular_ideal_generator
      (And.intro H.spt_padic_ideal_generator
        (And.intro H.spt_equalizer_lcm
          (And.intro H.spt_intersection
            (And.intro H.spt_failure_locus
              (And.intro H.crt_portfolio H.crt_pairwise)))))
  case torObstruction =>
    exact And.intro H.tor_surrogate_order
      (And.intro H.tor_order_matches_spt
        (And.intro H.tor_left_cyclic
          (And.intro H.tor_right_cyclic H.tor_obstruction_cyclic)))
  case padicMahler =>
    exact And.intro H.padic_normalization
      (And.intro H.padic_finite
        (And.intro H.mahler_finite
          (And.intro H.mahler_formula
            (And.intro H.mahler_binomial_congruence
              H.mahler_binomial))))
  case regressionCertificate =>
    exact And.intro H.ols_prediction
      (And.intro H.ols_formula
        (And.intro H.ols_decomposition
          (And.intro H.ols_interval.1
            (And.intro H.ols_interval.2
              (And.intro H.ols_residual_nonneg
                (And.intro H.ols_residual
                  H.ols_abs_residual_nonneg))))))
  case abstractConcreteSeparation =>
    exact And.intro H.abstract_concrete_chain
      (And.intro H.checklist_object H.checklist_qseries_object)

theorem primaryRequirement_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B)
    (item : RequestedDefinitionItem) :
    RequirementKey.Covered B (primaryRequirement item) := by
  exact M.covered_at (primaryObjective item)

end RequestedDefinitionItem

structure RequestedDefinitionAuditMatrix {X : Type*}
    (B : UnconditionalCertificationBundle X) : Prop where
  checklist : RequestedDefinitionChecklist B
  objectiveDefinitions : ObjectiveDefinitionMatrix B
  itemCovered :
    forall item : RequestedDefinitionItem,
      RequestedDefinitionItem.Covered checklist item
  allItemsCovered :
    forall item : RequestedDefinitionItem,
      List.Mem item RequestedDefinitionItem.all ->
        RequestedDefinitionItem.Covered checklist item
  requirementCovered :
    forall item : RequestedDefinitionItem,
      RequirementKey.Covered B
        (RequestedDefinitionItem.primaryRequirement item)

namespace RequestedDefinitionAuditMatrix

theorem checklist_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B) :
    RequestedDefinitionChecklist B :=
  M.checklist

theorem objective_definitions_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B) :
    ObjectiveDefinitionMatrix B :=
  M.objectiveDefinitions

theorem covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B)
    (item : RequestedDefinitionItem) :
    RequestedDefinitionItem.Covered M.checklist item :=
  M.itemCovered item

theorem all_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B)
    (item : RequestedDefinitionItem)
    (hmem : List.Mem item RequestedDefinitionItem.all) :
    RequestedDefinitionItem.Covered M.checklist item :=
  M.allItemsCovered item hmem

theorem requirement_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B)
    (item : RequestedDefinitionItem) :
    RequirementKey.Covered B
      (RequestedDefinitionItem.primaryRequirement item) :=
  M.requirementCovered item

theorem domain_q_cusps_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B) :
    RequestedDefinitionItem.Covered M.checklist
      RequestedDefinitionItem.domainQCusps :=
  M.covered_at RequestedDefinitionItem.domainQCusps

theorem entropy_asymptotic_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B) :
    RequestedDefinitionItem.Covered M.checklist
      RequestedDefinitionItem.entropyAsymptotic :=
  M.covered_at RequestedDefinitionItem.entropyAsymptotic

theorem padic_mahler_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionAuditMatrix B) :
    RequestedDefinitionItem.Covered M.checklist
      RequestedDefinitionItem.padicMahler :=
  M.covered_at RequestedDefinitionItem.padicMahler

end RequestedDefinitionAuditMatrix

namespace RequestedDefinitionChecklist

theorem audit_matrix {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (H : RequestedDefinitionChecklist B) :
    RequestedDefinitionAuditMatrix B where
  checklist := H
  objectiveDefinitions := H.objective_definitions
  itemCovered := RequestedDefinitionItem.covered_by_checklist H
  allItemsCovered := by
    intro item _hmem
    exact RequestedDefinitionItem.covered_by_checklist H item
  requirementCovered := by
    intro item
    exact RequestedDefinitionItem.primaryRequirement_covered
      H.objective_definitions item

end RequestedDefinitionChecklist

inductive IntegratedLayer where
  | basic
  | spt
  | muKernel
  | rademacher
  | pAdic
  | regression
  | advanced
deriving DecidableEq, Repr

namespace IntegratedLayer

def all : List IntegratedLayer :=
  [IntegratedLayer.basic,
    IntegratedLayer.spt,
    IntegratedLayer.muKernel,
    IntegratedLayer.rademacher,
    IntegratedLayer.pAdic,
    IntegratedLayer.regression,
    IntegratedLayer.advanced]

theorem all_length :
    all.length = 7 := rfl

theorem mem_all (layer : IntegratedLayer) :
    List.Mem layer all := by
  cases layer with
  | basic => exact List.Mem.head _
  | spt => exact List.Mem.tail _ (List.Mem.head _)
  | muKernel => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))
  | rademacher => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
  | pAdic => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))
  | regression => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))))
  | advanced => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))))

def fileName : IntegratedLayer -> String
  | basic => "Basic.lean"
  | spt => "SPT.lean"
  | muKernel => "MuKernel.lean"
  | rademacher => "Rademacher.lean"
  | pAdic => "PAdic.lean"
  | regression => "Regression.lean"
  | advanced => "Advanced.lean"

theorem fileName_ne_empty (layer : IntegratedLayer) :
    Not (fileName layer = "") := by
  cases layer <;> simp [fileName]

def auditLayers : IntegratedLayer -> List AxiomAuditLayer
  | basic =>
      [AxiomAuditLayer.domain,
        AxiomAuditLayer.qseries,
        AxiomAuditLayer.slash,
        AxiomAuditLayer.linear,
        AxiomAuditLayer.entropy,
        AxiomAuditLayer.degeneracy]
  | spt => [AxiomAuditLayer.sptTor]
  | muKernel => [AxiomAuditLayer.muKernel]
  | rademacher => [AxiomAuditLayer.rademacher]
  | pAdic => [AxiomAuditLayer.padicMahler]
  | regression => [AxiomAuditLayer.regression]
  | advanced =>
      [AxiomAuditLayer.coverage,
        AxiomAuditLayer.reference]

theorem auditLayers_length_pos (layer : IntegratedLayer) :
    0 < (auditLayers layer).length := by
  cases layer <;> simp [auditLayers]

theorem auditLayer_targets_nonempty
    (layer : IntegratedLayer) (audit : AxiomAuditLayer)
    (_hmem : List.Mem audit (auditLayers layer)) :
    0 < (AxiomAuditLayer.targets audit).length :=
  AxiomAuditLayer.targets_length_pos audit

def objectives : IntegratedLayer -> List ObjectiveItem
  | basic =>
      [ObjectiveItem.domainModel,
        ObjectiveItem.qSeriesPrincipal,
        ObjectiveItem.slashAction,
        ObjectiveItem.linearPrincipalSystem,
        ObjectiveItem.entropyAsymptotic,
        ObjectiveItem.degeneracyChannel,
        ObjectiveItem.effectiveCardyConstant]
  | spt =>
      [ObjectiveItem.sptEqualizer,
        ObjectiveItem.torObstruction]
  | muKernel =>
      [ObjectiveItem.appellLerchBlock,
        ObjectiveItem.xiOperator]
  | rademacher =>
      [ObjectiveItem.rademacherData]
  | pAdic =>
      [ObjectiveItem.padicMahler]
  | regression =>
      [ObjectiveItem.regressionCertificate]
  | advanced =>
      [ObjectiveItem.abstractConcreteSeparation]

theorem objectives_length_pos (layer : IntegratedLayer) :
    0 < (objectives layer).length := by
  cases layer <;> simp [objectives]

theorem exists_layer_for_objective (item : ObjectiveItem) :
    exists layer : IntegratedLayer,
      List.Mem item (objectives layer) := by
  cases item with
  | domainModel => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.head _)
  | qSeriesPrincipal => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.head _))
  | appellLerchBlock => exact Exists.intro IntegratedLayer.muKernel (by exact List.Mem.head _)
  | xiOperator => exact Exists.intro IntegratedLayer.muKernel (by exact List.Mem.tail _ (List.Mem.head _))
  | slashAction => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
  | linearPrincipalSystem => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))
  | entropyAsymptotic => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))))
  | rademacherData => exact Exists.intro IntegratedLayer.rademacher (by exact List.Mem.head _)
  | degeneracyChannel => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))))
  | effectiveCardyConstant => exact Exists.intro IntegratedLayer.basic (by exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))))))
  | sptEqualizer => exact Exists.intro IntegratedLayer.spt (by exact List.Mem.head _)
  | torObstruction => exact Exists.intro IntegratedLayer.spt (by exact List.Mem.tail _ (List.Mem.head _))
  | padicMahler => exact Exists.intro IntegratedLayer.pAdic (by exact List.Mem.head _)
  | regressionCertificate => exact Exists.intro IntegratedLayer.regression (by exact List.Mem.head _)
  | abstractConcreteSeparation => exact Exists.intro IntegratedLayer.advanced (by exact List.Mem.head _)

theorem objective_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (O : ObjectiveAuditMatrix B)
    (layer : IntegratedLayer) (item : ObjectiveItem)
    (_hmem : List.Mem item (objectives layer)) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  O.covered_at item

end IntegratedLayer

