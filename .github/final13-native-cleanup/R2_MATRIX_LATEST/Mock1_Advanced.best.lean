  all_leaf :
    forall r : AdvancedClaimsIIRequirement,
      AdvancedClaimsIIRequirement.leafStatement C r
  rlf_channel_spine :
    PaperInstancesHRlfChannelStatement
  rlf_row_spine :
    forall n,
      forall i : Fin referencePaperInstancesHRflConcrete.rationalOLS.points,
        PaperInstancesHRlfSpineRowStatement n i

