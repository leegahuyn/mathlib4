    c.rationalOLS.residual i =
      (c.rationalOLS.point i).yLogAbsCoeff -
        (c.rationalOLS.alphaHat * (c.rationalOLS.point i).xSqrt -
          (1 / 2 : Rat) * (c.rationalOLS.point i).xLog +
            c.rationalOLS.betaHat) :=
  c.rationalOLS.residual_formula_at i

theorem rational_ols_predicted_at {X : Type*}
