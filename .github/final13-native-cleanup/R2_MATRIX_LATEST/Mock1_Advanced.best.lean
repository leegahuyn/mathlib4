    (modularIdeal C.sptIdealWitness.spt.M).failureLocus
        (padicIdeal C.sptIdealWitness.spt.p
          C.sptIdealWitness.spt.k) =
      Nat.gcd C.sptIdealWitness.spt.M
        (C.sptIdealWitness.spt.p ^ C.sptIdealWitness.spt.k) :=
  H.spt_failure_locus

theorem spt_ideal_intersection_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) :
    ((modularIdeal C.sptIdealWitness.spt.M).intersection
        (padicIdeal C.sptIdealWitness.spt.p
          C.sptIdealWitness.spt.k)).Contains
      C.sptIdealWitness.spt.equalizerElement :=
  H.spt_ideal_intersection

theorem spt_ideal_equalizer_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) :
    ArithmeticEqualizer C.sptIdealWitness.spt.M
      (C.sptIdealWitness.spt.p ^ C.sptIdealWitness.spt.k)
      C.sptIdealWitness.spt.equalizerElement :=
  H.spt_ideal_equalizer

theorem crt_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (i : Fin C.crtWitness.moduliCount) :
    NatCongruent (C.crtWitness.modulus i)
      C.crtWitness.candidate (C.crtWitness.residue i) :=
  H.crt_portfolio i

theorem ols_bound_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (i : Fin C.olsWitness.points) :
    |C.olsWitness.residual i| <= C.olsWitness.residualBound :=
  H.rational_ols i

theorem rational_ols_formula_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (i : Fin C.olsWitness.points) :
    C.olsWitness.residual i =
      (C.olsWitness.point i).yLogAbsCoeff -
        (C.olsWitness.alphaHat * (C.olsWitness.point i).xSqrt -
          (1 / 2 : Rat) * (C.olsWitness.point i).xLog +
            C.olsWitness.betaHat) :=
  H.rational_ols_formula i

theorem rational_ols_prediction_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (i : Fin C.olsWitness.points) :
    C.olsWitness.predictedAt i =
      C.olsWitness.alphaHat * (C.olsWitness.point i).xSqrt -
        (1 / 2 : Rat) * (C.olsWitness.point i).xLog +
          C.olsWitness.betaHat :=
  H.rational_ols_prediction i

theorem rational_ols_decomposition_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (i : Fin C.olsWitness.points) :
    C.olsWitness.residual i =
      (C.olsWitness.point i).yLogAbsCoeff -
        C.olsWitness.predictedAt i :=
  H.rational_ols_decomposition i

theorem rational_ols_alpha_mem {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) :
    C.olsWitness.alphaInterval.Contains C.olsWitness.alphaHat :=
  H.rational_ols_alpha

theorem rational_ols_beta_mem {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) :
    C.olsWitness.betaInterval.Contains C.olsWitness.betaHat :=
  H.rational_ols_beta

theorem rational_ols_residual_nonnegative {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) :
    0 <= C.olsWitness.residualBound :=
  H.rational_ols_residual_nonneg

theorem mahler_formula_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (n : Nat) :
    C.mahlerWitness.eval n =
      Finset.univ.sum
        (fun j : Fin C.mahlerWitness.length =>
          C.mahlerWitness.coeff j * C.mahlerWitness.basis j n) :=
  H.mahler_finite_formula n

theorem padic_overlap_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (n : Nat) :
    IntCongruent C.padicOverlapWitness.M
      (C.padicOverlapWitness.left n)
      (C.padicOverlapWitness.right n) /\
        IntCongruent
          (PrimePower C.padicOverlapWitness.p C.padicOverlapWitness.k)
          (C.padicOverlapWitness.left n)
          (C.padicOverlapWitness.right n) :=
  H.padic_overlap n

theorem padic_finite_congruence_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (n : Nat) :
    FiniteCongruenceMod C.padicWitness.p C.padicWitness.k
      (C.padicWitness.normalized n) (C.padicWitness.raw n) :=
  H.padic_finite_congruence n

theorem padic_overlap_finite_at {C : FormalizationChecklist}
    (H : ObjectiveCoverage C) (n : Nat) :
    FiniteCongruenceMod C.padicOverlapWitness.p
      C.padicOverlapWitness.k
      (C.padicOverlapWitness.left n)
      (C.padicOverlapWitness.right n) :=
  H.padic_overlap_finite n

end ObjectiveCoverage

namespace FormalizationChecklist

