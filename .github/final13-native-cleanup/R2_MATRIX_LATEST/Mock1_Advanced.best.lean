/-!
Full finite T1-T2 signed-identity input from the page-16 structural check.

The eleven listed `m` values give eleven rows.  Columns are ordered first by
phase `r = 0`, then by phase `r = 1/2`, so the matrix is `[I_11 | -I_11]`.
The exact solution to `A c = e_1` is `(e_1/2, -e_1/2)`.
-/

def AdvancedClaimsIIRatCoordinateVector
    (dimension index : Nat) (value : Rat) : List Rat :=
  (List.range dimension).map (fun j => if j = index then value else 0)

def AdvancedClaimsIISignedIdentityRow
    (dimension row : Nat) : List Rat :=
  AdvancedClaimsIIRatCoordinateVector dimension row 1 ++
    AdvancedClaimsIIRatCoordinateVector dimension row (-1)

def AdvancedClaimsIISignedIdentityMatrix
    (dimension : Nat) : List (List Rat) :=
  (List.range dimension).map
    (AdvancedClaimsIISignedIdentityRow dimension)

def AdvancedClaimsIIRatSquaredNorm (x : List Rat) : Rat :=
  (x.map (fun value => value ^ 2)).sum

theorem advanced_claims_ii_signed_pair_norm_decomposition
    (a b target : Rat)
    (h : a - b = target) :
    a ^ 2 + b ^ 2 = target ^ 2 / 2 + (a + b) ^ 2 / 2 := by
  rw [← h]
  ring

theorem advanced_claims_ii_signed_pair_norm_lower_bound
    (a b target : Rat)
    (h : a - b = target) :
    target ^ 2 / 2 <= a ^ 2 + b ^ 2 := by
  rw [advanced_claims_ii_signed_pair_norm_decomposition a b target h]
  have hsq : 0 <= (a + b) ^ 2 := sq_nonneg (a + b)
  linarith

theorem advanced_claims_ii_signed_pair_half_split
    (target : Rat) :
    target / 2 - (-target / 2) = target /\
      (target / 2) ^ 2 + (-target / 2) ^ 2 = target ^ 2 / 2 := by
  constructor <;> ring

def AdvancedClaimsIISignedPairTargets
    (pairs : List (Prod Rat Rat)) : List Rat :=
  pairs.map (fun pair => pair.1 - pair.2)

def AdvancedClaimsIISignedPairSquaredNorm
    (pairs : List (Prod Rat Rat)) : Rat :=
  (pairs.map (fun pair => pair.1 ^ 2 + pair.2 ^ 2)).sum

def AdvancedClaimsIIFlattenSignedPairs
    (pairs : List (Prod Rat Rat)) : List Rat :=
  pairs.map Prod.fst ++ pairs.map Prod.snd

theorem advanced_claims_ii_signed_pair_list_norm_lower_bound
    (pairs : List (Prod Rat Rat)) :
    AdvancedClaimsIIRatSquaredNorm
        (AdvancedClaimsIISignedPairTargets pairs) / 2 <=
      AdvancedClaimsIISignedPairSquaredNorm pairs := by
  induction pairs with
  | nil =>
      simp [AdvancedClaimsIIRatSquaredNorm,
        AdvancedClaimsIISignedPairTargets,
        AdvancedClaimsIISignedPairSquaredNorm]
  | cons pair pairs ih =>
      have hpair :=
        advanced_claims_ii_signed_pair_norm_lower_bound
          pair.1 pair.2 (pair.1 - pair.2) rfl
      simp [AdvancedClaimsIIRatSquaredNorm,
        AdvancedClaimsIISignedPairTargets,
        AdvancedClaimsIISignedPairSquaredNorm] at ih ⊢
      nlinarith

