  (I.ols.row i).degeneracy_at

theorem truncation_checks_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput)
    (i : Fin 90) :
    abs (I.ols.row i).differenceK <= (I.ols.row i).tailBound /\
      abs (I.ols.row i).differenceTwoK <= (I.ols.row i).tailBound :=
  And.intro (I.ols.row i).k_pass (I.ols.row i).two_k_pass

theorem reported_summary_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput) :
    I.ols.alphaHat = referenceAlphaHat /\
      I.ols.betaHat = referenceBetaHat /\
        I.ols.gammaHat = referenceGammaHat /\
          I.ols.rss = referenceRSSValue :=
  And.intro I.alpha_reported
    (And.intro I.beta_reported
