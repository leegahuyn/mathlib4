def objectiveCategorySpine
    (C : AdvancedClaimsIICompletionCertificate) :
    AdvancedClaimsIIObjectiveCategorySpineCertificate C where
  actual_input_audit := C.actualInputAudit
  section_concrete := C.sectionConcreteClosure
  claimwise := C.claimwiseMathematicalClosure
  rlf_spine := C.rlfMathematicalSpine
  category_lengths := AdvancedClaimsIIRequirement.grouped_lengths
  category_nodup := by
    exact And.intro AdvancedClaimsIIRequirement.objectSchemaRequirements_nodup
      (And.intro AdvancedClaimsIIRequirement.t1t5Requirements_nodup
        (And.intro AdvancedClaimsIIRequirement.sptRequirements_nodup
          (And.intro AdvancedClaimsIIRequirement.kernelRequirements_nodup
            (And.intro AdvancedClaimsIIRequirement.exactCoefficientRequirements_nodup
              (And.intro AdvancedClaimsIIRequirement.pAdicRequirements_nodup
                (And.intro AdvancedClaimsIIRequirement.entropyReproRequirements_nodup
                  AdvancedClaimsIIRequirement.finalInstanceRequirements_nodup))))))
  object_prompt := C.sectionConcreteClosure.object_prompt_at
  object_actual := C.sectionConcreteClosure.object_actual_at
  object_leaf := C.sectionConcreteClosure.object_leaf_at
  t1t5_prompt := C.sectionConcreteClosure.t1t5_prompt_at
  t1t5_actual := C.sectionConcreteClosure.t1t5_actual_at
  t1t5_leaf := C.sectionConcreteClosure.t1t5_leaf_at
  spt_prompt := C.sectionConcreteClosure.spt_prompt_at
  spt_actual_valuation := C.sectionConcreteClosure.spt_actual_valuation_at
  spt_leaf := C.sectionConcreteClosure.spt_leaf_at
  kernel_prompt := C.sectionConcreteClosure.kernel_prompt_at
  kernel_actual := C.sectionConcreteClosure.kernel_actual_at
  kernel_leaf := C.sectionConcreteClosure.kernel_leaf_at
  exact_prompt := C.sectionConcreteClosure.exact_prompt_at
  exact_actual := C.sectionConcreteClosure.exact_actual_at
  exact_leaf := C.sectionConcreteClosure.exact_leaf_at
  padic_prompt := C.sectionConcreteClosure.padic_prompt_at
  padic_actual := C.sectionConcreteClosure.padic_actual_at
  padic_leaf := C.sectionConcreteClosure.padic_leaf_at
  entropy_prompt := C.sectionConcreteClosure.entropy_prompt_at
  entropy_actual := C.sectionConcreteClosure.entropy_actual_at
  entropy_leaf := C.sectionConcreteClosure.entropy_leaf_at
  final_leaf := C.claimGroupLeafStatements.final_instance_leaf_at
  all_leaf := C.claimwiseMathematicalClosure.requirement_leaf_at
  rlf_channel_spine := C.rlf_spine_channel_at
  rlf_row_spine := C.rlf_spine_row_at

