import Mathlib

set_option maxRecDepth 200000

/-!
Mock1_Integrated.lean

Single-file integrated Lean infrastructure for unconditional certificate-style
formalization toward mock/partial theta and Jacobi objects.

Design principle:
* no global analytic axiom is introduced;
* deep paper input is carried as explicit proof fields in certificates;
* concrete instances must fill those fields with actual Lean terms;
* small lemmas expose every certified consequence.
-/

namespace MockCert

open Filter Topology

/-! ## Domain layer: upper half-plane, nome, cusps, and transport data. -/

structure UpperHalfPlanePoint where
  z : Complex
  im_pos : 0 < z.im

namespace UpperHalfPlanePoint

@[simp]
theorem im_pos' (tau : UpperHalfPlanePoint) : 0 < tau.z.im :=
  tau.im_pos

def translateOne (tau : UpperHalfPlanePoint) : UpperHalfPlanePoint where
  z := tau.z + 1
  im_pos := by
    simpa using tau.im_pos

end UpperHalfPlanePoint

noncomputable def nome (tau : UpperHalfPlanePoint) : Complex :=
  Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z)

theorem nome_def (tau : UpperHalfPlanePoint) :
    nome tau =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z) := rfl

noncomputable def qParameter (tau : UpperHalfPlanePoint) : Complex :=
  nome tau

theorem qParameter_eq_nome (tau : UpperHalfPlanePoint) :
    qParameter tau = nome tau := rfl

theorem qParameter_formula (tau : UpperHalfPlanePoint) :
    qParameter tau =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z) := rfl

inductive Cusp where
  | infinity
  | zero
  | one
  | rational (a b : Int)
deriving DecidableEq, Repr

structure ModularMatrix where
  a : Int
  b : Int
  c : Int
  d : Int
  det_eq_one : a * d - b * c = 1

namespace ModularMatrix

def T : ModularMatrix where
  a := 1
  b := 1
  c := 0
  d := 1
  det_eq_one := by norm_num

def S : ModularMatrix where
  a := 0
  b := -1
  c := 1
  d := 0
  det_eq_one := by norm_num

noncomputable def denom (A : ModularMatrix) (tau : UpperHalfPlanePoint) :
    Complex :=
  (A.c : Complex) * tau.z + (A.d : Complex)

noncomputable def fractionalLinearFormula (A : ModularMatrix)
    (tau : UpperHalfPlanePoint) : Complex :=
  ((A.a : Complex) * tau.z + (A.b : Complex)) / A.denom tau

@[simp]
theorem denom_T (tau : UpperHalfPlanePoint) :
    T.denom tau = 1 := by
  simp [denom, T]

@[simp]
theorem denom_S (tau : UpperHalfPlanePoint) :
    S.denom tau = tau.z := by
  simp [denom, S]

theorem fractionalLinearFormula_T (tau : UpperHalfPlanePoint) :
    T.fractionalLinearFormula tau = tau.z + 1 := by
  simp [fractionalLinearFormula, denom, T]

theorem fractionalLinearFormula_S (tau : UpperHalfPlanePoint) :
    S.fractionalLinearFormula tau = (-1 : Complex) / tau.z := by
  simp [fractionalLinearFormula, denom, S]

end ModularMatrix

structure CuspTransport where
  source : Cusp
  target : Cusp
  matrix : ModularMatrix
  act : UpperHalfPlanePoint -> UpperHalfPlanePoint
  act_formula :
    forall tau, (act tau).z = matrix.fractionalLinearFormula tau

namespace CuspTransport

theorem q_after_transport (T : CuspTransport) (tau : UpperHalfPlanePoint) :
    nome (T.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        T.matrix.fractionalLinearFormula tau) := by
  rw [nome, T.act_formula tau]

end CuspTransport

structure CuspTransportCertificate where
  transport : CuspTransport
  q_after :
    forall tau, qParameter (transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        transport.matrix.fractionalLinearFormula tau)

namespace CuspTransportCertificate

theorem q_after_at (c : CuspTransportCertificate)
    (tau : UpperHalfPlanePoint) :
    qParameter (c.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.transport.matrix.fractionalLinearFormula tau) :=
  c.q_after tau

theorem act_formula_at (c : CuspTransportCertificate)
    (tau : UpperHalfPlanePoint) :
    (c.transport.act tau).z =
      c.transport.matrix.fractionalLinearFormula tau :=
  c.transport.act_formula tau

end CuspTransportCertificate

structure MultiplierCharacter where
  value : ModularMatrix -> Complex
  value_T : Complex := value ModularMatrix.T
  value_S : Complex := value ModularMatrix.S
  value_T_spec : value_T = value ModularMatrix.T := by rfl
  value_S_spec : value_S = value ModularMatrix.S := by rfl

namespace MultiplierCharacter

theorem value_T_eq (chi : MultiplierCharacter) :
    chi.value_T = chi.value ModularMatrix.T :=
  chi.value_T_spec

theorem value_S_eq (chi : MultiplierCharacter) :
    chi.value_S = chi.value ModularMatrix.S :=
  chi.value_S_spec

end MultiplierCharacter

structure HalfWeightSlashAction where
  slash : (UpperHalfPlanePoint -> Complex) -> ModularMatrix ->
    UpperHalfPlanePoint -> Complex
  multiplier : MultiplierCharacter
  transportT : UpperHalfPlanePoint -> UpperHalfPlanePoint
  transportS : UpperHalfPlanePoint -> UpperHalfPlanePoint
  slash_T :
    forall f tau, slash f ModularMatrix.T tau =
      multiplier.value ModularMatrix.T * f (transportT tau)
  slash_S :
    forall f tau, slash f ModularMatrix.S tau =
      multiplier.value ModularMatrix.S * f (transportS tau)

namespace HalfWeightSlashAction

theorem generator_T (A : HalfWeightSlashAction)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    A.slash f ModularMatrix.T tau =
      A.multiplier.value ModularMatrix.T * f (A.transportT tau) :=
  A.slash_T f tau

theorem generator_S (A : HalfWeightSlashAction)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    A.slash f ModularMatrix.S tau =
      A.multiplier.value ModularMatrix.S * f (A.transportS tau) :=
  A.slash_S f tau

end HalfWeightSlashAction

def halfWeight : Rat := 1 / 2

structure SlashGeneratorCertificate where
  action : HalfWeightSlashAction
  weight : Rat
  weight_eq_half : weight = halfWeight
  transportT : CuspTransportCertificate
  transportT_link :
    forall tau, action.transportT tau = transportT.transport.act tau
  transportS : CuspTransportCertificate
  transportS_link :
    forall tau, action.transportS tau = transportS.transport.act tau
  multiplier_T_eq :
    action.multiplier.value_T = action.multiplier.value ModularMatrix.T
  multiplier_S_eq :
    action.multiplier.value_S = action.multiplier.value ModularMatrix.S

namespace SlashGeneratorCertificate

theorem weight_is_half (c : SlashGeneratorCertificate) :
    c.weight = halfWeight :=
  c.weight_eq_half

theorem transportT_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    c.action.transportT tau = c.transportT.transport.act tau :=
  c.transportT_link tau

theorem transportS_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    c.action.transportS tau = c.transportS.transport.act tau :=
  c.transportS_link tau

theorem transportT_q_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    qParameter (c.transportT.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.transportT.transport.matrix.fractionalLinearFormula tau) :=
  c.transportT.q_after_at tau

theorem transportS_q_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    qParameter (c.transportS.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.transportS.transport.matrix.fractionalLinearFormula tau) :=
  c.transportS.q_after_at tau

theorem transportT_formula_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    (c.transportT.transport.act tau).z =
      c.transportT.transport.matrix.fractionalLinearFormula tau :=
  c.transportT.act_formula_at tau

theorem transportS_formula_at (c : SlashGeneratorCertificate)
    (tau : UpperHalfPlanePoint) :
    (c.transportS.transport.act tau).z =
      c.transportS.transport.matrix.fractionalLinearFormula tau :=
  c.transportS.act_formula_at tau

theorem multiplier_T (c : SlashGeneratorCertificate) :
    c.action.multiplier.value_T =
      c.action.multiplier.value ModularMatrix.T :=
  c.multiplier_T_eq

theorem multiplier_S (c : SlashGeneratorCertificate) :
    c.action.multiplier.value_S =
      c.action.multiplier.value ModularMatrix.S :=
  c.multiplier_S_eq

theorem generator_T_via_transport
    (c : SlashGeneratorCertificate)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.action.slash f ModularMatrix.T tau =
      c.action.multiplier.value ModularMatrix.T *
        f (c.transportT.transport.act tau) := by
  rw [c.action.generator_T f tau, c.transportT_at tau]

theorem generator_S_at
    (c : SlashGeneratorCertificate)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.action.slash f ModularMatrix.S tau =
      c.action.multiplier.value ModularMatrix.S *
        f (c.action.transportS tau) :=
  c.action.generator_S f tau

theorem generator_S_via_transport
    (c : SlashGeneratorCertificate)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.action.slash f ModularMatrix.S tau =
      c.action.multiplier.value ModularMatrix.S *
        f (c.transportS.transport.act tau) := by
  rw [c.action.generator_S f tau, c.transportS_at tau]

end SlashGeneratorCertificate

/-! ## Analytic skeleton layer: Appell-Lerch specialisation and xi data. -/

noncomputable def u0 (tau : UpperHalfPlanePoint) : Complex :=
  tau.z / 2

theorem u0_formula (tau : UpperHalfPlanePoint) :
    u0 tau = tau.z / 2 := rfl

noncomputable def v0 (tau : UpperHalfPlanePoint) : Complex :=
  tau.z / 2 + 1 / 2

theorem v0_formula (tau : UpperHalfPlanePoint) :
    v0 tau = tau.z / 2 + 1 / 2 := rfl

noncomputable def frozenZ0 : Complex :=
  -1 / 2

theorem frozenZ0_formula :
    frozenZ0 = -1 / 2 := rfl

theorem u0_sub_v0 (tau : UpperHalfPlanePoint) : u0 tau - v0 tau = frozenZ0 := by
  simp [u0, v0, frozenZ0]
  ring

structure AppellLerchAnalyticData where
  mu : Complex -> Complex -> UpperHalfPlanePoint -> Complex
  R : Complex -> UpperHalfPlanePoint -> Complex
  unaryThetaShadow : Complex -> UpperHalfPlanePoint -> Complex

namespace AppellLerchAnalyticData

noncomputable def completionTerm (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) : Complex :=
  (Complex.I / 2) * D.R frozenZ0 tau

theorem completionTerm_eq_R (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) :
    D.completionTerm tau = (Complex.I / 2) * D.R frozenZ0 tau := rfl

noncomputable def completionTermAt (D : AppellLerchAnalyticData)
    (z : Complex) (tau : UpperHalfPlanePoint) : Complex :=
  (Complex.I / 2) * D.R z tau

theorem completionTermAt_frozenZ0
    (D : AppellLerchAnalyticData) (tau : UpperHalfPlanePoint) :
    D.completionTermAt frozenZ0 tau = D.completionTerm tau := rfl

noncomputable def muHat (D : AppellLerchAnalyticData)
    (u v : Complex) (tau : UpperHalfPlanePoint) : Complex :=
  D.mu u v tau + D.completionTermAt (u - v) tau

theorem muHat_eq_mu_add_R (D : AppellLerchAnalyticData)
    (u v : Complex) (tau : UpperHalfPlanePoint) :
    D.muHat u v tau =
      D.mu u v tau + (Complex.I / 2) * D.R (u - v) tau := by
  rfl

noncomputable def specializedMu (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) : Complex :=
  D.mu (u0 tau) (v0 tau) tau

theorem specializedMu_eq_mu_u0_v0
    (D : AppellLerchAnalyticData) (tau : UpperHalfPlanePoint) :
    D.specializedMu tau = D.mu (u0 tau) (v0 tau) tau := rfl

noncomputable def specializedMuHat (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) : Complex :=
  D.muHat (u0 tau) (v0 tau) tau

theorem specializedMuHat_eq_muHat_u0_v0
    (D : AppellLerchAnalyticData) (tau : UpperHalfPlanePoint) :
    D.specializedMuHat tau = D.muHat (u0 tau) (v0 tau) tau := rfl

theorem specializedMuHat_eq (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) :
  D.specializedMuHat tau =
      D.specializedMu tau + (Complex.I / 2) * D.R frozenZ0 tau := by
  simp [specializedMuHat, muHat, completionTermAt, specializedMu, u0_sub_v0]

theorem specializedMuHat_eq_mu_add_completionTerm
    (D : AppellLerchAnalyticData) (tau : UpperHalfPlanePoint) :
    D.specializedMuHat tau =
      D.specializedMu tau + D.completionTerm tau := by
  rw [D.specializedMuHat_eq tau]
  rfl

noncomputable def gz (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) : Complex :=
  D.unaryThetaShadow frozenZ0 tau

noncomputable def unaryThetaAt (D : AppellLerchAnalyticData)
    (z : Complex) (tau : UpperHalfPlanePoint) : Complex :=
  D.unaryThetaShadow z tau

@[simp]
theorem gz_eq_unaryThetaAt (D : AppellLerchAnalyticData)
    (tau : UpperHalfPlanePoint) :
    D.gz tau = D.unaryThetaAt frozenZ0 tau := rfl

end AppellLerchAnalyticData

structure XiOperator where
  xi : (UpperHalfPlanePoint -> Complex) -> UpperHalfPlanePoint -> Complex
  map_zero : forall tau, xi (fun _ => 0) tau = 0
  map_add :
    forall f g tau, xi (fun z => f z + g z) tau = xi f tau + xi g tau

namespace XiOperator

theorem zero (X : XiOperator) :
    forall tau, X.xi (fun _ => 0) tau = 0 :=
  X.map_zero

theorem add (X : XiOperator) (f g : UpperHalfPlanePoint -> Complex) :
    forall tau, X.xi (fun z => f z + g z) tau = X.xi f tau + X.xi g tau :=
  X.map_add f g

end XiOperator

/-! ## Basic layer: q-series, finite sums, principal parts, congruence. -/

structure QSeries (R : Type*) where
  coeff : Nat -> R

namespace QSeries

@[ext]
theorem ext {R : Type*} {f g : QSeries R} (h : forall n, f.coeff n = g.coeff n) :
    f = g := by
  cases f with
  | mk fc =>
    cases g with
    | mk gc =>
      congr
      funext n
      exact h n

def truncation {R : Type*} [AddCommMonoid R] (f : QSeries R) (N : Nat) : R :=
  (Finset.range N).sum f.coeff

def coefficientAt {R : Type*} (f : QSeries R) (n : Nat) : R :=
  f.coeff n

@[simp]
theorem coefficientAt_eq {R : Type*} (f : QSeries R) (n : Nat) :
    f.coefficientAt n = f.coeff n := rfl

noncomputable def evalTrunc {R : Type*} [Semiring R]
    (f : QSeries R) (q : R) (N : Nat) : R :=
  (Finset.range N).sum (fun n => f.coeff n * q ^ n)

@[simp]
theorem truncation_zero {R : Type*} [AddCommMonoid R] (f : QSeries R) :
    f.truncation 0 = 0 := by
  simp [truncation]

theorem truncation_succ {R : Type*} [AddCommMonoid R] (f : QSeries R) (N : Nat) :
    f.truncation (N + 1) = f.truncation N + f.coeff N := by
  simp [truncation, Finset.sum_range_succ]

@[simp]
theorem evalTrunc_zero {R : Type*} [Semiring R] (f : QSeries R) (q : R) :
    f.evalTrunc q 0 = 0 := by
  simp [evalTrunc]

theorem evalTrunc_succ {R : Type*} [Semiring R] (f : QSeries R)
    (q : R) (N : Nat) :
    f.evalTrunc q (N + 1) = f.evalTrunc q N + f.coeff N * q ^ N := by
  simp [evalTrunc, Finset.sum_range_succ]

end QSeries

structure LaurentQSeries (R : Type*) where
  coeff : Int -> R

namespace LaurentQSeries

def coefficientAt {R : Type*} (f : LaurentQSeries R) (n : Int) : R :=
  f.coeff n

@[simp]
theorem coefficientAt_eq {R : Type*} (f : LaurentQSeries R) (n : Int) :
    f.coefficientAt n = f.coeff n := rfl

def principalCoeff {R : Type*} (f : LaurentQSeries R) (n : Nat) : R :=
  f.coeff (-((n + 1 : Nat) : Int))

theorem principalCoeff_eq {R : Type*} (f : LaurentQSeries R) (n : Nat) :
    f.principalCoeff n = f.coeff (-((n + 1 : Nat) : Int)) := rfl

end LaurentQSeries

structure TruncatedQSeries (R : Type*) where
  length : Nat
  coeff : Fin length -> R

namespace TruncatedQSeries

def coefficientAt {R : Type*} [Zero R] (f : TruncatedQSeries R) (n : Nat) : R :=
  if h : n < f.length then f.coeff (Fin.mk n h) else 0

noncomputable def coefficientSum {R : Type*} [AddCommMonoid R]
    (f : TruncatedQSeries R) : R :=
  Finset.univ.sum f.coeff

noncomputable def eval {R : Type*} [Semiring R]
    (f : TruncatedQSeries R) (q : R) : R :=
  Finset.univ.sum (fun n : Fin f.length => f.coeff n * q ^ (n : Nat))

@[simp]
theorem coefficientAt_of_lt {R : Type*} [Zero R] (f : TruncatedQSeries R)
    {n : Nat} (h : n < f.length) :
    f.coefficientAt n = f.coeff (Fin.mk n h) := by
  simp [coefficientAt, h]

@[simp]
theorem coefficientAt_of_not_lt {R : Type*} [Zero R] (f : TruncatedQSeries R)
    {n : Nat} (h : Not (n < f.length)) :
    f.coefficientAt n = 0 := by
  simp [coefficientAt, h]

end TruncatedQSeries

structure QSeriesPrefixCertificate (R : Type*) [Zero R] where
  full : QSeries R
  truncated : TruncatedQSeries R
  prefix_eq :
    forall n, n < truncated.length ->
      truncated.coefficientAt n = full.coeff n

namespace QSeriesPrefixCertificate

theorem coefficientAt_eq_full_of_lt {R : Type*} [Zero R]
    (c : QSeriesPrefixCertificate R) {n : Nat}
    (h : n < c.truncated.length) :
    c.truncated.coefficientAt n = c.full.coeff n :=
  c.prefix_eq n h

theorem coeff_eq_full_at {R : Type*} [Zero R]
    (c : QSeriesPrefixCertificate R)
    (i : Fin c.truncated.length) :
    c.truncated.coeff i = c.full.coeff (i : Nat) := by
  simpa using c.prefix_eq (i : Nat) i.isLt

theorem coefficientAt_zero_of_not_lt {R : Type*} [Zero R]
    (c : QSeriesPrefixCertificate R) {n : Nat}
    (h : Not (n < c.truncated.length)) :
    c.truncated.coefficientAt n = 0 :=
  TruncatedQSeries.coefficientAt_of_not_lt c.truncated h

noncomputable def truncatedCoeffSum {R : Type*}
    [AddCommMonoid R] [Zero R] (c : QSeriesPrefixCertificate R) : R :=
  c.truncated.coefficientSum

noncomputable def fullPrefixCoeffSum {R : Type*}
    [AddCommMonoid R] [Zero R] (c : QSeriesPrefixCertificate R) : R :=
  Finset.univ.sum
    (fun i : Fin c.truncated.length => c.full.coeff (i : Nat))

theorem truncatedCoeffSum_eq_fullPrefixCoeffSum {R : Type*}
    [AddCommMonoid R] [Zero R] (c : QSeriesPrefixCertificate R) :
    c.truncatedCoeffSum = c.fullPrefixCoeffSum := by
  simp [truncatedCoeffSum, fullPrefixCoeffSum,
    TruncatedQSeries.coefficientSum, c.coeff_eq_full_at]

noncomputable def truncatedEval {R : Type*}
    [Semiring R] (c : QSeriesPrefixCertificate R) (q : R) : R :=
  c.truncated.eval q

noncomputable def fullPrefixEval {R : Type*}
    [Semiring R] (c : QSeriesPrefixCertificate R) (q : R) : R :=
  Finset.univ.sum
    (fun i : Fin c.truncated.length =>
      c.full.coeff (i : Nat) * q ^ (i : Nat))

theorem truncatedEval_eq_fullPrefixEval {R : Type*}
    [Semiring R] (c : QSeriesPrefixCertificate R) (q : R) :
    c.truncatedEval q = c.fullPrefixEval q := by
  simp [truncatedEval, fullPrefixEval, TruncatedQSeries.eval,
    c.coeff_eq_full_at]

end QSeriesPrefixCertificate

structure QSeriesFiniteSupportCertificate (R : Type*) [Zero R] where
  series : QSeries R
  cutoff : Nat
  coeff_zero_of_cutoff_le :
    forall n, cutoff <= n -> series.coeff n = 0

namespace QSeriesFiniteSupportCertificate

theorem coeff_zero_at {R : Type*} [Zero R]
    (c : QSeriesFiniteSupportCertificate R) {n : Nat}
    (hn : c.cutoff <= n) :
    c.series.coeff n = 0 :=
  c.coeff_zero_of_cutoff_le n hn

theorem coefficientAt_zero_at {R : Type*} [Zero R]
    (c : QSeriesFiniteSupportCertificate R) {n : Nat}
    (hn : c.cutoff <= n) :
    c.series.coefficientAt n = 0 := by
  simpa [QSeries.coefficientAt] using c.coeff_zero_at hn

end QSeriesFiniteSupportCertificate

structure Window where
  start : Nat
  stop : Nat
  start_le_stop : start <= stop

namespace Window

def Contains (w : Window) (n : Nat) : Prop :=
  w.start <= n /\ n <= w.stop

@[simp]
theorem start_mem (w : Window) : w.Contains w.start := by
  exact And.intro le_rfl w.start_le_stop

@[simp]
theorem stop_mem (w : Window) : w.Contains w.stop := by
  exact And.intro w.start_le_stop le_rfl

end Window

structure PrincipalPart (R : Type*) where
  order : Nat
  coeff : Fin order -> R

namespace PrincipalPart

def coeffAt {R : Type*} (p : PrincipalPart R) (i : Fin p.order) : R :=
  p.coeff i

@[simp]
theorem coeffAt_eq {R : Type*} (p : PrincipalPart R) (i : Fin p.order) :
    p.coeffAt i = p.coeff i := rfl

def sum {R : Type*} [AddCommMonoid R] (p : PrincipalPart R) : R :=
  Finset.univ.sum p.coeff

@[simp]
theorem sum_mk_zero {R : Type*} [AddCommMonoid R] (c : Fin 0 -> R) :
    (PrincipalPart.mk 0 c).sum = 0 := by
  simp [sum]

end PrincipalPart

structure PrincipalPartCertificate (R : Type*) where
  laurent : LaurentQSeries R
  principal : PrincipalPart R
  coeff_eq_laurent :
    forall i, principal.coeff i = laurent.principalCoeff (i : Nat)

namespace PrincipalPartCertificate

theorem coeffAt_eq_laurent {R : Type*}
    (c : PrincipalPartCertificate R) (i : Fin c.principal.order) :
    c.principal.coeffAt i =
      c.laurent.coeff (-(((i : Nat) + 1 : Nat) : Int)) := by
  calc
    c.principal.coeffAt i = c.principal.coeff i := rfl
    _ = c.laurent.principalCoeff (i : Nat) := c.coeff_eq_laurent i
    _ = c.laurent.coeff (-(((i : Nat) + 1 : Nat) : Int)) := rfl

end PrincipalPartCertificate

structure PolarTerm (R : Type*) where
  exponent : Int
  coeff : R
  is_polar : exponent < 0

structure PolarProfile (R : Type*) where
  terms : Nat
  term : Fin terms -> PolarTerm R

namespace PolarProfile

def supportExponents {R : Type*} (p : PolarProfile R) : Fin p.terms -> Int :=
  fun i => (p.term i).exponent

theorem exponent_negative {R : Type*} (p : PolarProfile R) (i : Fin p.terms) :
    (p.term i).exponent < 0 :=
  (p.term i).is_polar

end PolarProfile

structure PolarProfileCertificate (R : Type*) where
  profile : PolarProfile R
  exponent_formula :
    forall i, (profile.term i).exponent =
      -(((i : Nat) + 1 : Nat) : Int)

namespace PolarProfileCertificate

theorem exponent_at {R : Type*}
    (c : PolarProfileCertificate R) (i : Fin c.profile.terms) :
    (c.profile.term i).exponent =
      -(((i : Nat) + 1 : Nat) : Int) :=
  c.exponent_formula i

theorem exponent_negative_at {R : Type*}
    (c : PolarProfileCertificate R) (i : Fin c.profile.terms) :
    (c.profile.term i).exponent < 0 :=
  c.profile.exponent_negative i

end PolarProfileCertificate

structure ClosedInterval where
  lower : Real
  upper : Real
  lower_le_upper : lower <= upper

namespace ClosedInterval

def Contains (I : ClosedInterval) (x : Real) : Prop :=
  I.lower <= x /\ x <= I.upper

@[simp]
theorem lower_mem (I : ClosedInterval) : I.Contains I.lower := by
  exact And.intro le_rfl I.lower_le_upper

@[simp]
theorem upper_mem (I : ClosedInterval) : I.Contains I.upper := by
  exact And.intro I.lower_le_upper le_rfl

end ClosedInterval

structure RectComplexInterval where
  realPart : ClosedInterval
  imagPart : ClosedInterval

namespace RectComplexInterval

def Contains (I : RectComplexInterval) (z : Complex) : Prop :=
  I.realPart.Contains z.re /\ I.imagPart.Contains z.im

end RectComplexInterval

structure MatrixData (R : Type*) (rows cols : Nat) where
  entry : Fin rows -> Fin cols -> R

namespace MatrixData

def mulVec {R : Type*} [Semiring R] {rows cols : Nat}
    (A : MatrixData R rows cols) (v : Fin cols -> R) : Fin rows -> R :=
  fun i => Finset.univ.sum (fun j : Fin cols => A.entry i j * v j)

end MatrixData

structure LinearSystem (R : Type*) [Semiring R] where
  rows : Nat
  cols : Nat
  matrix : MatrixData R rows cols
  rhs : Fin rows -> R

structure LinearSystemCertificate (R : Type*) [Semiring R] where
  system : LinearSystem R
  solution : Fin system.cols -> R
  solution_ok :
    forall i, system.matrix.mulVec solution i = system.rhs i

namespace LinearSystemCertificate

theorem equation_at {R : Type*} [Semiring R]
    (c : LinearSystemCertificate R) (i : Fin c.system.rows) :
    c.system.matrix.mulVec c.solution i = c.system.rhs i :=
  c.solution_ok i

end LinearSystemCertificate

structure ComplexIntervalLinearSystem where
  rows : Nat
  cols : Nat
  matrix : MatrixData RectComplexInterval rows cols
  rhs : Fin rows -> RectComplexInterval

structure ComplexIntervalLinearSystemCertificate where
  system : ComplexIntervalLinearSystem
  solution : Fin system.cols -> RectComplexInterval
  residual : Fin system.rows -> RectComplexInterval
  residual_contains_zero :
    forall i, (residual i).Contains 0

namespace ComplexIntervalLinearSystemCertificate

theorem zero_residual_at (c : ComplexIntervalLinearSystemCertificate)
    (i : Fin c.system.rows) :
    (c.residual i).Contains 0 :=
  c.residual_contains_zero i

theorem zero_residual_real_at (c : ComplexIntervalLinearSystemCertificate)
    (i : Fin c.system.rows) :
    (c.residual i).realPart.Contains 0 := by
  simpa [RectComplexInterval.Contains] using (c.zero_residual_at i).1

theorem zero_residual_imag_at (c : ComplexIntervalLinearSystemCertificate)
    (i : Fin c.system.rows) :
    (c.residual i).imagPart.Contains 0 := by
  simpa [RectComplexInterval.Contains] using (c.zero_residual_at i).2

end ComplexIntervalLinearSystemCertificate

def NatCongruent (M a b : Nat) : Prop :=
  a % M = b % M

namespace NatCongruent

@[simp]
theorem refl (M a : Nat) : NatCongruent M a a := by
  simp [NatCongruent]

theorem symm {M a b : Nat} (h : NatCongruent M a b) :
    NatCongruent M b a := by
  unfold NatCongruent at h ⊢
  exact Eq.symm h

theorem trans {M a b c : Nat} (hab : NatCongruent M a b)
    (hbc : NatCongruent M b c) : NatCongruent M a c := by
  unfold NatCongruent at hab hbc ⊢
  exact Eq.trans hab hbc

end NatCongruent

def IntCongruent (M : Nat) (a b : Int) : Prop :=
  Dvd.dvd (M : Int) (a - b)

namespace IntCongruent

@[simp]
theorem refl (M : Nat) (a : Int) : IntCongruent M a a := by
  simp [IntCongruent]

theorem symm {M : Nat} {a b : Int} (h : IntCongruent M a b) :
    IntCongruent M b a := by
  cases h with
  | intro k hk =>
    refine Exists.intro (-k) ?_
    calc
      b - a = -(a - b) := by ring
      _ = -((M : Int) * k) := by rw [hk]
      _ = (M : Int) * (-k) := by ring

theorem trans {M : Nat} {a b c : Int} (hab : IntCongruent M a b)
    (hbc : IntCongruent M b c) : IntCongruent M a c := by
  cases hab with
  | intro u hu =>
    cases hbc with
    | intro v hv =>
      refine Exists.intro (u + v) ?_
      calc
        a - c = (a - b) + (b - c) := by ring
        _ = (M : Int) * u + (M : Int) * v := by rw [hu, hv]
        _ = (M : Int) * (u + v) := by ring

theorem add {M : Nat} {a b c d : Int} (hab : IntCongruent M a b)
    (hcd : IntCongruent M c d) : IntCongruent M (a + c) (b + d) := by
  cases hab with
  | intro u hu =>
    cases hcd with
    | intro v hv =>
      refine Exists.intro (u + v) ?_
      calc
        (a + c) - (b + d) = (a - b) + (c - d) := by ring
        _ = (M : Int) * u + (M : Int) * v := by rw [hu, hv]
        _ = (M : Int) * (u + v) := by ring

end IntCongruent

/-! ## SPT layer: equalizer, gcd/lcm, CRT, Tor skeleton. -/

def ArithmeticEqualizer (M N x : Nat) : Prop :=
  Dvd.dvd M x /\ Dvd.dvd N x

theorem arithmeticEqualizer_iff_lcm_dvd (M N x : Nat) :
    ArithmeticEqualizer M N x <-> Dvd.dvd (Nat.lcm M N) x := by
  constructor
  · rintro ⟨hM, hN⟩
    exact Nat.lcm_dvd hM hN
  · intro h
    exact And.intro (dvd_trans (Nat.dvd_lcm_left M N) h)
      (dvd_trans (Nat.dvd_lcm_right M N) h)

def ObstructionOrder (M p k : Nat) : Nat :=
  Nat.gcd M (p ^ k)

@[simp]
theorem obstructionOrder_eq (M p k : Nat) :
    ObstructionOrder M p k = Nat.gcd M (p ^ k) := rfl

theorem obstructionOrder_eq_one_of_gcd_eq_one {M p k : Nat}
    (h : Nat.gcd M (p ^ k) = 1) :
    ObstructionOrder M p k = 1 := by
  simpa [ObstructionOrder] using h

structure TorSkeleton where
  M : Nat
  p : Nat
  k : Nat
  order : Nat
  order_eq : order = ObstructionOrder M p k

namespace TorSkeleton

theorem order_eq_gcd (t : TorSkeleton) :
    t.order = Nat.gcd t.M (t.p ^ t.k) := by
  simpa [ObstructionOrder] using t.order_eq

theorem trivial_of_order_eq_one (t : TorSkeleton) (h : t.order = 1) :
    Nat.gcd t.M (t.p ^ t.k) = 1 := by
  calc
    Nat.gcd t.M (t.p ^ t.k) = t.order := t.order_eq_gcd.symm
    _ = 1 := h

end TorSkeleton

def PairCompatible (M N a b : Nat) : Prop :=
  a % Nat.gcd M N = b % Nat.gcd M N

namespace PairCompatible

@[simp]
theorem refl (M N a : Nat) : PairCompatible M N a a := by
  simp [PairCompatible]

theorem symm {M N a b : Nat} (h : PairCompatible M N a b) :
    PairCompatible M N b a := by
  unfold PairCompatible at h ⊢
  exact Eq.symm h

theorem of_gcd_eq_one {M N a b : Nat} (h : Nat.gcd M N = 1) :
    PairCompatible M N a b := by
  unfold PairCompatible
  rw [h]
  omega

end PairCompatible

structure CRTCertificate where
  left : Nat
  right : Nat
  leftResidue : Nat
  rightResidue : Nat
  candidate : Nat
  compatible : PairCompatible left right leftResidue rightResidue
  left_ok : NatCongruent left candidate leftResidue
  right_ok : NatCongruent right candidate rightResidue

namespace CRTCertificate

theorem left_congruent (c : CRTCertificate) :
    NatCongruent c.left c.candidate c.leftResidue := c.left_ok

theorem right_congruent (c : CRTCertificate) :
    NatCongruent c.right c.candidate c.rightResidue := c.right_ok

end CRTCertificate

structure SPTCertificate where
  M : Nat
  p : Nat
  k : Nat
  equalizerElement : Nat
  equalizer_mem : ArithmeticEqualizer M (p ^ k) equalizerElement
  obstruction : TorSkeleton
  obstruction_matches :
    obstruction.order = ObstructionOrder M p k

namespace SPTCertificate

theorem equalizer_mem_left (c : SPTCertificate) :
    Dvd.dvd c.M c.equalizerElement :=
  c.equalizer_mem.1

theorem equalizer_mem_padic (c : SPTCertificate) :
    Dvd.dvd (c.p ^ c.k) c.equalizerElement :=
  c.equalizer_mem.2

theorem equalizer_lcm_dvd (c : SPTCertificate) :
    Dvd.dvd (Nat.lcm c.M (c.p ^ c.k)) c.equalizerElement := by
  exact (arithmeticEqualizer_iff_lcm_dvd c.M (c.p ^ c.k) c.equalizerElement).mp
    c.equalizer_mem

theorem obstruction_order_eq_gcd (c : SPTCertificate) :
    c.obstruction.order = Nat.gcd c.M (c.p ^ c.k) := by
  calc
    c.obstruction.order = ObstructionOrder c.M c.p c.k := c.obstruction_matches
    _ = Nat.gcd c.M (c.p ^ c.k) := rfl

end SPTCertificate

structure PrincipalIdealNat where
  generator : Nat

namespace PrincipalIdealNat

def Contains (I : PrincipalIdealNat) (x : Nat) : Prop :=
  Dvd.dvd I.generator x

def intersection (I J : PrincipalIdealNat) : PrincipalIdealNat where
  generator := Nat.lcm I.generator J.generator

def failureLocus (I J : PrincipalIdealNat) : Nat :=
  Nat.gcd I.generator J.generator

theorem mem_intersection_iff (I J : PrincipalIdealNat) (x : Nat) :
    (I.intersection J).Contains x <->
      I.Contains x /\ J.Contains x := by
  exact (arithmeticEqualizer_iff_lcm_dvd I.generator J.generator x).symm

theorem failureLocus_eq_gcd (I J : PrincipalIdealNat) :
    I.failureLocus J = Nat.gcd I.generator J.generator := rfl

end PrincipalIdealNat

def modularIdeal (M : Nat) : PrincipalIdealNat where
  generator := M

def padicIdeal (p k : Nat) : PrincipalIdealNat where
  generator := p ^ k

theorem modularIdeal_generator (M : Nat) :
    (modularIdeal M).generator = M := rfl

theorem padicIdeal_generator (p k : Nat) :
    (padicIdeal p k).generator = p ^ k := rfl

@[simp]
theorem modularIdeal_contains_iff (M x : Nat) :
    (modularIdeal M).Contains x <-> Dvd.dvd M x := by
  rfl

@[simp]
theorem padicIdeal_contains_iff (p k x : Nat) :
    (padicIdeal p k).Contains x <-> Dvd.dvd (p ^ k) x := by
  rfl

theorem modular_padic_intersection_contains_iff (M p k x : Nat) :
    ((modularIdeal M).intersection (padicIdeal p k)).Contains x <->
      Dvd.dvd M x /\ Dvd.dvd (p ^ k) x := by
  exact PrincipalIdealNat.mem_intersection_iff (modularIdeal M) (padicIdeal p k) x

theorem modular_padic_failure_locus_eq (M p k : Nat) :
    (modularIdeal M).failureLocus (padicIdeal p k) = Nat.gcd M (p ^ k) := rfl

structure SPTIdealCertificate where
  spt : SPTCertificate
  equalizer_mem_intersection :
    ((modularIdeal spt.M).intersection (padicIdeal spt.p spt.k)).Contains
      spt.equalizerElement
  failure_locus_eq_obstruction :
    (modularIdeal spt.M).failureLocus (padicIdeal spt.p spt.k) =
      ObstructionOrder spt.M spt.p spt.k

namespace SPTIdealCertificate

theorem equalizer_in_intersection (c : SPTIdealCertificate) :
    ((modularIdeal c.spt.M).intersection
        (padicIdeal c.spt.p c.spt.k)).Contains
      c.spt.equalizerElement :=
  c.equalizer_mem_intersection

theorem intersection_iff_equalizer (c : SPTIdealCertificate) :
    ((modularIdeal c.spt.M).intersection
        (padicIdeal c.spt.p c.spt.k)).Contains
      c.spt.equalizerElement <->
        ArithmeticEqualizer c.spt.M (c.spt.p ^ c.spt.k)
          c.spt.equalizerElement := by
  simpa [ArithmeticEqualizer] using
    modular_padic_intersection_contains_iff
      c.spt.M c.spt.p c.spt.k c.spt.equalizerElement

theorem equalizer_mem_from_intersection (c : SPTIdealCertificate) :
    ArithmeticEqualizer c.spt.M (c.spt.p ^ c.spt.k)
      c.spt.equalizerElement :=
  (c.intersection_iff_equalizer).mp c.equalizer_in_intersection

theorem failure_locus_eq_obstruction_order
    (c : SPTIdealCertificate) :
    (modularIdeal c.spt.M).failureLocus (padicIdeal c.spt.p c.spt.k) =
      ObstructionOrder c.spt.M c.spt.p c.spt.k :=
  c.failure_locus_eq_obstruction

theorem failure_locus_eq_gcd (c : SPTIdealCertificate) :
    (modularIdeal c.spt.M).failureLocus (padicIdeal c.spt.p c.spt.k) =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := by
  simpa [ObstructionOrder] using c.failure_locus_eq_obstruction

end SPTIdealCertificate

structure CRTPortfolio where
  moduliCount : Nat
  modulus : Fin moduliCount -> Nat
  residue : Fin moduliCount -> Nat
  candidate : Nat
  candidate_ok :
    forall i, NatCongruent (modulus i) candidate (residue i)

namespace CRTPortfolio

theorem congruent_at (P : CRTPortfolio) (i : Fin P.moduliCount) :
    NatCongruent (P.modulus i) P.candidate (P.residue i) :=
  P.candidate_ok i

theorem candidate_mod_eq_residue_mod
    (P : CRTPortfolio) (i : Fin P.moduliCount) :
    P.candidate % P.modulus i = P.residue i % P.modulus i :=
  P.congruent_at i

end CRTPortfolio

structure CRTCompatibilityCertificate where
  portfolio : CRTPortfolio
  pairCompatible :
    forall i j,
      PairCompatible (portfolio.modulus i) (portfolio.modulus j)
        (portfolio.residue i) (portfolio.residue j)

namespace CRTCompatibilityCertificate

theorem compatible_at (c : CRTCompatibilityCertificate)
    (i j : Fin c.portfolio.moduliCount) :
    PairCompatible (c.portfolio.modulus i) (c.portfolio.modulus j)
      (c.portfolio.residue i) (c.portfolio.residue j) :=
  c.pairCompatible i j

theorem candidate_at (c : CRTCompatibilityCertificate)
    (i : Fin c.portfolio.moduliCount) :
    NatCongruent (c.portfolio.modulus i)
      c.portfolio.candidate (c.portfolio.residue i) :=
  c.portfolio.congruent_at i

theorem diagonal_compatible (c : CRTCompatibilityCertificate)
    (i : Fin c.portfolio.moduliCount) :
    PairCompatible (c.portfolio.modulus i) (c.portfolio.modulus i)
      (c.portfolio.residue i) (c.portfolio.residue i) := by
  exact PairCompatible.refl (c.portfolio.modulus i)
    (c.portfolio.modulus i) (c.portfolio.residue i)

end CRTCompatibilityCertificate

structure TorFiniteSurrogate where
  leftModulus : Nat
  rightModulus : Nat
  quotientOrder : Nat
  quotientOrder_eq_gcd :
    quotientOrder = Nat.gcd leftModulus rightModulus

structure CyclicQuotientModel where
  modulus : Nat

namespace CyclicQuotientModel

def order (Q : CyclicQuotientModel) : Nat :=
  Q.modulus

theorem order_eq_modulus (Q : CyclicQuotientModel) :
    Q.order = Q.modulus := rfl

def representative (Q : CyclicQuotientModel) (n : Nat) : Nat :=
  n % Q.modulus

theorem representative_eq_mod (Q : CyclicQuotientModel) (n : Nat) :
    Q.representative n = n % Q.modulus := rfl

end CyclicQuotientModel

namespace TorFiniteSurrogate

def leftQuotient (T : TorFiniteSurrogate) : CyclicQuotientModel where
  modulus := T.leftModulus

def rightQuotient (T : TorFiniteSurrogate) : CyclicQuotientModel where
  modulus := T.rightModulus

def obstructionQuotient (T : TorFiniteSurrogate) :
    CyclicQuotientModel where
  modulus := T.quotientOrder

theorem leftQuotient_modulus (T : TorFiniteSurrogate) :
    T.leftQuotient.modulus = T.leftModulus := rfl

theorem rightQuotient_modulus (T : TorFiniteSurrogate) :
    T.rightQuotient.modulus = T.rightModulus := rfl

theorem leftQuotient_order (T : TorFiniteSurrogate) :
    T.leftQuotient.order = T.leftModulus := rfl

theorem rightQuotient_order (T : TorFiniteSurrogate) :
    T.rightQuotient.order = T.rightModulus := rfl

theorem obstructionQuotient_order (T : TorFiniteSurrogate) :
    T.obstructionQuotient.order = T.quotientOrder := rfl

theorem obstructionQuotient_order_eq_gcd (T : TorFiniteSurrogate) :
    T.obstructionQuotient.order =
      Nat.gcd T.leftQuotient.modulus T.rightQuotient.modulus := by
  exact T.quotientOrder_eq_gcd

theorem order_for_padic (T : TorFiniteSurrogate)
    {M p k : Nat}
    (hleft : T.leftModulus = M)
    (hright : T.rightModulus = p ^ k) :
    T.quotientOrder = ObstructionOrder M p k := by
  rw [T.quotientOrder_eq_gcd, hleft, hright]
  rfl

end TorFiniteSurrogate

structure TorObstructionCertificate where
  spt : SPTCertificate
  surrogate : TorFiniteSurrogate
  left_matches : surrogate.leftModulus = spt.M
  right_matches : surrogate.rightModulus = spt.p ^ spt.k
  quotient_matches_obstruction :
    surrogate.quotientOrder = spt.obstruction.order

namespace TorObstructionCertificate

theorem surrogate_order_eq_obstruction_order
    (c : TorObstructionCertificate) :
    c.surrogate.quotientOrder = c.spt.obstruction.order :=
  c.quotient_matches_obstruction

theorem surrogate_order_eq_obstruction
    (c : TorObstructionCertificate) :
    c.surrogate.quotientOrder =
      ObstructionOrder c.spt.M c.spt.p c.spt.k :=
  c.surrogate.order_for_padic c.left_matches c.right_matches

theorem surrogate_order_eq_spt_gcd (c : TorObstructionCertificate) :
    c.surrogate.quotientOrder = Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := by
  calc
    c.surrogate.quotientOrder =
        ObstructionOrder c.spt.M c.spt.p c.spt.k :=
      c.surrogate_order_eq_obstruction
    _ = Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := rfl

theorem obstructionQuotient_order_eq_spt_gcd
    (c : TorObstructionCertificate) :
    c.surrogate.obstructionQuotient.order =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := by
  calc
    c.surrogate.obstructionQuotient.order =
        c.surrogate.quotientOrder := rfl
    _ = Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) :=
      c.surrogate_order_eq_spt_gcd

theorem obstruction_order_consistent (c : TorObstructionCertificate) :
    c.spt.obstruction.order =
      ObstructionOrder c.spt.M c.spt.p c.spt.k :=
  c.spt.obstruction_matches

end TorObstructionCertificate

/-! ## Mu-kernel layer: Appell-Lerch block, completion, shadow skeleton. -/

structure CompletionSplit (X R : Type*) [Add R] where
  plus : X -> R
  minus : X -> R
  hat : X -> R
  split : forall x, hat x = plus x + minus x

namespace CompletionSplit

theorem hat_eq_plus_of_minus_zero {X R : Type*} [AddMonoid R]
    (c : CompletionSplit X R) (hminus : forall x, c.minus x = 0) :
    forall x, c.hat x = c.plus x := by
  intro x
  rw [c.split, hminus x, add_zero]

end CompletionSplit

structure AppellLerchBlock (X R : Type*) [Add R] where
  holomorphic : X -> R
  completion : X -> R
  remainder : X -> R
  completion_eq : forall x, completion x = holomorphic x + remainder x

namespace AppellLerchBlock

def toCompletionSplit {X R : Type*} [Add R] (b : AppellLerchBlock X R) :
    CompletionSplit X R where
  plus := b.holomorphic
  minus := b.remainder
  hat := b.completion
  split := b.completion_eq

end AppellLerchBlock

structure ShadowCertificate (X : Type*) where
  xiFhat : X -> Complex
  theta : X -> Complex
  scale : Complex
  shadow_eq : forall x, xiFhat x = scale * theta x

namespace ShadowCertificate

theorem zero_of_scale_zero {X : Type*} (c : ShadowCertificate X)
    (hscale : c.scale = 0) : forall x, c.xiFhat x = 0 := by
  intro x
  rw [c.shadow_eq, hscale]
  simp

end ShadowCertificate

structure BruinierFunkeXiCertificate where
  xiOperator : XiOperator
  completedObject : UpperHalfPlanePoint -> Complex
  shadow : UpperHalfPlanePoint -> Complex
  scale : Complex
  xi_eq_shadow :
    forall tau, xiOperator.xi completedObject tau = scale * shadow tau

namespace BruinierFunkeXiCertificate

theorem xi_eq_shadow_at (c : BruinierFunkeXiCertificate)
    (tau : UpperHalfPlanePoint) :
    c.xiOperator.xi c.completedObject tau = c.scale * c.shadow tau :=
  c.xi_eq_shadow tau

theorem xi_zero_of_scale_zero (c : BruinierFunkeXiCertificate)
    (hscale : c.scale = 0) :
    forall tau, c.xiOperator.xi c.completedObject tau = 0 := by
  intro tau
  rw [c.xi_eq_shadow, hscale]
  simp

end BruinierFunkeXiCertificate

structure AppellLerchSpecializationCertificate where
  data : AppellLerchAnalyticData
  S : Complex
  Fplus : UpperHalfPlanePoint -> Complex
  Fminus : UpperHalfPlanePoint -> Complex
  Fhat : UpperHalfPlanePoint -> Complex
  Fplus_eq_mu :
    forall tau, Fplus tau = data.specializedMu tau
  Fminus_eq_R :
    forall tau, Fminus tau = (Complex.I / 2) * S * data.R frozenZ0 tau
  Fhat_split :
    forall tau, Fhat tau = Fplus tau + Fminus tau

namespace AppellLerchSpecializationCertificate

theorem Fplus_at (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fplus tau = c.data.specializedMu tau :=
  c.Fplus_eq_mu tau

theorem Fminus_at (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fminus tau =
      (Complex.I / 2) * c.S * c.data.R frozenZ0 tau :=
  c.Fminus_eq_R tau

theorem Fminus_eq_scaled_completionTerm
    (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fminus tau = c.S * c.data.completionTerm tau := by
  rw [c.Fminus_at tau, c.data.completionTerm_eq_R tau]
  ring

theorem Fhat_split_at (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fhat tau = c.Fplus tau + c.Fminus tau :=
  c.Fhat_split tau

theorem Fhat_eq_mu_add_completion
    (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fhat tau =
      c.data.specializedMu tau +
        (Complex.I / 2) * c.S * c.data.R frozenZ0 tau := by
  rw [c.Fhat_split_at tau, c.Fplus_at tau, c.Fminus_at tau]

theorem Fhat_eq_mu_add_scaled_completionTerm
    (c : AppellLerchSpecializationCertificate)
    (tau : UpperHalfPlanePoint) :
    c.Fhat tau =
      c.data.specializedMu tau + c.S * c.data.completionTerm tau := by
  rw [c.Fhat_eq_mu_add_completion tau, c.data.completionTerm_eq_R tau]
  ring

theorem holomorphic_if_S_zero (c : AppellLerchSpecializationCertificate)
    (hS : c.S = 0) :
    forall tau, c.Fminus tau = 0 := by
  intro tau
  rw [c.Fminus_eq_R, hS]
  ring

theorem Fhat_eq_mu_of_S_zero
    (c : AppellLerchSpecializationCertificate)
    (hS : c.S = 0) :
    forall tau, c.Fhat tau = c.data.specializedMu tau := by
  intro tau
  rw [c.Fhat_eq_mu_add_completion tau, hS]
  ring

end AppellLerchSpecializationCertificate

theorem corollary1_holomorphic {X : Type*} (Fminus R : X -> Complex)
    (S : Complex)
    (hsplit : forall x, Fminus x = (Complex.I / 2) * S * R x)
    (hS : S = 0) :
    forall x, Fminus x = 0 := by
  intro x
  rw [hsplit, hS]
  ring

theorem shadow_zero_of_S_zero {X : Type*} (xiFhat g : X -> Complex)
    (S kappa : Complex)
    (hshadow : forall x, xiFhat x = S * kappa * g x)
    (hS : S = 0) :
    forall x, xiFhat x = 0 := by
  intro x
  rw [hshadow, hS]
  ring

/-! ## Rademacher layer: Kloosterman sums, Bessel/tail certificate. -/

structure KloostermanDatum where
  modulus : Nat
  leftIndex : Int
  rightIndex : Int
  multiplier : Fin modulus -> Complex

def KloostermanSum (d : KloostermanDatum) : Complex :=
  Finset.univ.sum d.multiplier

structure KloostermanSumCertificate where
  datum : KloostermanDatum
  certifiedSum : Complex
  sum_eq : certifiedSum = KloostermanSum datum

namespace KloostermanSumCertificate

theorem certified_eq_sum (c : KloostermanSumCertificate) :
    c.certifiedSum = KloostermanSum c.datum :=
  c.sum_eq

theorem sum_eq_certified (c : KloostermanSumCertificate) :
    KloostermanSum c.datum = c.certifiedSum :=
  c.sum_eq.symm

end KloostermanSumCertificate

noncomputable def BesselIHalfModel (x : Real) : Real :=
  if x = 0 then 0 else Real.sqrt (2 / (Real.pi * x)) * Real.sinh x

@[simp]
theorem BesselIHalfModel_zero : BesselIHalfModel 0 = 0 := by
  simp [BesselIHalfModel]

structure RademacherTermData where
  c : Nat
  kernel : KloostermanDatum
  besselArgument : Real
  amplitude : Real

namespace RademacherTermData

noncomputable def value (t : RademacherTermData) : Real :=
  t.amplitude * BesselIHalfModel t.besselArgument

theorem value_formula (t : RademacherTermData) :
    t.value = t.amplitude * BesselIHalfModel t.besselArgument := rfl

end RademacherTermData

structure RademacherTermCertificate where
  data : RademacherTermData
  certifiedValue : Real
  value_eq : certifiedValue = data.value

namespace RademacherTermCertificate

theorem certified_eq_value (c : RademacherTermCertificate) :
    c.certifiedValue = c.data.value :=
  c.value_eq

theorem certified_eq_formula (c : RademacherTermCertificate) :
    c.certifiedValue =
      c.data.amplitude * BesselIHalfModel c.data.besselArgument := by
  simpa [RademacherTermData.value] using c.value_eq

end RademacherTermCertificate

structure RademacherExpansionData where
  term : Nat -> Real
  multiplier : Nat -> Complex
  kernel : Nat -> KloostermanDatum

namespace RademacherExpansionData

def kloostermanAt (E : RademacherExpansionData) (c : Nat) : Complex :=
  KloostermanSum (E.kernel c)

@[simp]
theorem kloostermanAt_eq (E : RademacherExpansionData) (c : Nat) :
    E.kloostermanAt c = KloostermanSum (E.kernel c) := rfl

noncomputable def truncation (E : RademacherExpansionData) (K : Nat) : Real :=
  (Finset.range K).sum E.term

@[simp]
theorem truncation_zero (E : RademacherExpansionData) :
    E.truncation 0 = 0 := by
  simp [truncation]

theorem truncation_succ (E : RademacherExpansionData) (K : Nat) :
    E.truncation (K + 1) = E.truncation K + E.term K := by
  simp [truncation, Finset.sum_range_succ]

theorem truncation_one (E : RademacherExpansionData) :
    E.truncation 1 = E.term 0 := by
  simp [truncation]

end RademacherExpansionData

structure RademacherLinkedExpansionData where
  expansion : RademacherExpansionData
  termCertificate : Nat -> RademacherTermCertificate
  term_eq_certified :
    forall c, expansion.term c = (termCertificate c).certifiedValue
  kernel_eq_data :
    forall c, expansion.kernel c = (termCertificate c).data.kernel

namespace RademacherLinkedExpansionData

theorem term_certified_at (E : RademacherLinkedExpansionData) (c : Nat) :
    E.expansion.term c = (E.termCertificate c).certifiedValue :=
  E.term_eq_certified c

theorem term_value_at (E : RademacherLinkedExpansionData) (c : Nat) :
    E.expansion.term c = (E.termCertificate c).data.value := by
  calc
    E.expansion.term c = (E.termCertificate c).certifiedValue :=
      E.term_certified_at c
    _ = (E.termCertificate c).data.value :=
      (E.termCertificate c).certified_eq_value

theorem term_formula_at (E : RademacherLinkedExpansionData) (c : Nat) :
    E.expansion.term c =
      (E.termCertificate c).data.amplitude *
        BesselIHalfModel (E.termCertificate c).data.besselArgument := by
  calc
    E.expansion.term c = (E.termCertificate c).data.value :=
      E.term_value_at c
    _ = (E.termCertificate c).data.amplitude *
        BesselIHalfModel (E.termCertificate c).data.besselArgument := rfl

theorem kernel_at (E : RademacherLinkedExpansionData) (c : Nat) :
    E.expansion.kernel c = (E.termCertificate c).data.kernel :=
  E.kernel_eq_data c

theorem kloosterman_at (E : RademacherLinkedExpansionData) (c : Nat) :
    E.expansion.kloostermanAt c =
      KloostermanSum (E.termCertificate c).data.kernel := by
  rw [RademacherExpansionData.kloostermanAt_eq, E.kernel_at c]

theorem truncation_succ_certified
    (E : RademacherLinkedExpansionData) (K : Nat) :
    E.expansion.truncation (K + 1) =
      E.expansion.truncation K + (E.termCertificate K).data.value := by
  rw [E.expansion.truncation_succ K, E.term_value_at K]

theorem truncation_one_certified
    (E : RademacherLinkedExpansionData) :
    E.expansion.truncation 1 = (E.termCertificate 0).data.value := by
  rw [E.expansion.truncation_one, E.term_value_at 0]

end RademacherLinkedExpansionData

structure RademacherKernelPortfolio where
  expansion : RademacherExpansionData
  kernelCertificate : Nat -> KloostermanSumCertificate
  kernel_eq :
    forall c, expansion.kernel c = (kernelCertificate c).datum
  multiplier_eq_sum :
    forall c, expansion.multiplier c =
      (kernelCertificate c).certifiedSum

namespace RademacherKernelPortfolio

theorem kernel_at (P : RademacherKernelPortfolio) (c : Nat) :
    P.expansion.kernel c = (P.kernelCertificate c).datum :=
  P.kernel_eq c

theorem multiplier_eq_certified_sum
    (P : RademacherKernelPortfolio) (c : Nat) :
    P.expansion.multiplier c = (P.kernelCertificate c).certifiedSum :=
  P.multiplier_eq_sum c

theorem multiplier_eq_kloosterman_sum
    (P : RademacherKernelPortfolio) (c : Nat) :
    P.expansion.multiplier c =
      KloostermanSum (P.kernelCertificate c).datum := by
  calc
    P.expansion.multiplier c = (P.kernelCertificate c).certifiedSum :=
      P.multiplier_eq_certified_sum c
    _ = KloostermanSum (P.kernelCertificate c).datum :=
      (P.kernelCertificate c).certified_eq_sum

theorem kloostermanAt_eq_certified_sum
    (P : RademacherKernelPortfolio) (c : Nat) :
    P.expansion.kloostermanAt c =
      (P.kernelCertificate c).certifiedSum := by
  calc
    P.expansion.kloostermanAt c = KloostermanSum (P.expansion.kernel c) := rfl
    _ = KloostermanSum (P.kernelCertificate c).datum := by
      rw [P.kernel_at c]
    _ = (P.kernelCertificate c).certifiedSum :=
      (P.kernelCertificate c).sum_eq_certified

theorem kloostermanAt_eq_kloosterman_sum
    (P : RademacherKernelPortfolio) (c : Nat) :
    P.expansion.kloostermanAt c =
      KloostermanSum (P.kernelCertificate c).datum := by
  calc
    P.expansion.kloostermanAt c =
        KloostermanSum (P.expansion.kernel c) := rfl
    _ = KloostermanSum (P.kernelCertificate c).datum := by
      rw [P.kernel_at c]

end RademacherKernelPortfolio

structure TailBound where
  tail : Nat -> Real
  cutoff : Nat
  bound : Real
  bound_nonneg : 0 <= bound
  eventually_bound : forall n, cutoff <= n -> |tail n| <= bound

namespace TailBound

theorem bound_at (c : TailBound) {n : Nat} (hn : c.cutoff <= n) :
    |c.tail n| <= c.bound :=
  c.eventually_bound n hn

theorem abs_nonneg_at (c : TailBound) (n : Nat) :
    0 <= |c.tail n| := by
  exact abs_nonneg (c.tail n)

end TailBound

structure ExponentialTailCertificate where
  remainder : Nat -> Real
  cutoff : Nat
  C : Real
  lambda : Real
  C_nonneg : 0 <= C
  lambda_pos : 0 < lambda
  tail_le :
    forall n, cutoff <= n ->
      |remainder n| <= C * Real.exp (-lambda * Real.sqrt (n : Real))

namespace ExponentialTailCertificate

theorem envelope_nonneg (c : ExponentialTailCertificate) (n : Nat) :
    0 <= c.C * Real.exp (-c.lambda * Real.sqrt (n : Real)) := by
  exact mul_nonneg c.C_nonneg (le_of_lt (Real.exp_pos _))

theorem lambda_nonneg (c : ExponentialTailCertificate) :
    0 <= c.lambda :=
  le_of_lt c.lambda_pos

end ExponentialTailCertificate

structure RademacherExpansionCertificate (coeff : Nat -> Real) where
  expansion : Nat -> RademacherExpansionData
  cutoff : Nat -> Nat
  remainder : Nat -> Real
  coeff_eq_truncation :
    forall n, coeff n = (expansion n).truncation (cutoff n) + remainder n
  tail : ExponentialTailCertificate
  tail_eq_remainder : tail.remainder = remainder

namespace RademacherExpansionCertificate

theorem coeff_eq {coeff : Nat -> Real}
    (c : RademacherExpansionCertificate coeff) (n : Nat) :
    coeff n = (c.expansion n).truncation (c.cutoff n) + c.remainder n :=
  c.coeff_eq_truncation n

theorem tail_le {coeff : Nat -> Real}
    (c : RademacherExpansionCertificate coeff) {n : Nat}
    (hn : c.tail.cutoff <= n) :
    |c.remainder n| <=
      c.tail.C * Real.exp (-c.tail.lambda * Real.sqrt (n : Real)) := by
  have h := c.tail.tail_le n hn
  rw [c.tail_eq_remainder] at h
  exact h

theorem tail_envelope_nonneg {coeff : Nat -> Real}
    (c : RademacherExpansionCertificate coeff) (n : Nat) :
    0 <= c.tail.C *
      Real.exp (-c.tail.lambda * Real.sqrt (n : Real)) :=
  c.tail.envelope_nonneg n

end RademacherExpansionCertificate

structure RademacherCertificate (coeff : Nat -> Real) where
  main : Nat -> Real
  remainder : Nat -> Real
  coeff_eq : forall n, coeff n = main n + remainder n
  tail : TailBound
  tail_eq_remainder : tail.tail = remainder

namespace RademacherCertificate

theorem coeff_decomposition {coeff : Nat -> Real}
    (c : RademacherCertificate coeff) (n : Nat) :
    coeff n = c.main n + c.remainder n :=
  c.coeff_eq n

theorem remainder_abs_le {coeff : Nat -> Real}
    (c : RademacherCertificate coeff) {n : Nat}
    (hn : c.tail.cutoff <= n) :
    |c.remainder n| <= c.tail.bound := by
  have h := c.tail.bound_at hn
  rw [c.tail_eq_remainder] at h
  exact h

end RademacherCertificate

/-! ## P-adic layer: normalization and Mahler finite certificate. -/

def PrimePower (p k : Nat) : Nat :=
  p ^ k

def FiniteCongruenceMod (p k : Nat) (a b : Int) : Prop :=
  IntCongruent (PrimePower p k) a b

theorem finiteCongruence_refl (p k : Nat) (a : Int) :
    FiniteCongruenceMod p k a a := by
  simp [FiniteCongruenceMod, IntCongruent]

def mahlerBinomialBasis (j n : Nat) : Int :=
  (Nat.choose n j : Int)

theorem mahlerBinomialBasis_zero (n : Nat) :
    mahlerBinomialBasis 0 n = 1 := by
  simp [mahlerBinomialBasis]

structure PAdicNormalization where
  p : Nat
  k : Nat
  raw : Nat -> Int
  normalized : Nat -> Int
  normalized_mod :
    forall n, IntCongruent (PrimePower p k) (normalized n) (raw n)

namespace PAdicNormalization

theorem congruent_at (c : PAdicNormalization) (n : Nat) :
    IntCongruent (PrimePower c.p c.k) (c.normalized n) (c.raw n) :=
  c.normalized_mod n

theorem finite_congruent_at (c : PAdicNormalization) (n : Nat) :
    FiniteCongruenceMod c.p c.k (c.normalized n) (c.raw n) :=
  c.congruent_at n

end PAdicNormalization

structure MahlerFiniteCertificate where
  p : Nat
  k : Nat
  length : Nat
  target : Nat -> Int
  coeff : Fin length -> Int
  basis : Fin length -> Nat -> Int
  eval : Nat -> Int
  eval_eq :
    forall n, eval n = Finset.univ.sum (fun j : Fin length => coeff j * basis j n)
  matches_target :
    forall n, IntCongruent (PrimePower p k) (eval n) (target n)

namespace MahlerFiniteCertificate

theorem eval_formula_at (c : MahlerFiniteCertificate) (n : Nat) :
    c.eval n =
      Finset.univ.sum
        (fun j : Fin c.length => c.coeff j * c.basis j n) :=
  c.eval_eq n

theorem eval_congruent (c : MahlerFiniteCertificate) (n : Nat) :
    IntCongruent (PrimePower c.p c.k) (c.eval n) (c.target n) :=
  c.matches_target n

end MahlerFiniteCertificate

structure MahlerBinomialCertificate where
  p : Nat
  k : Nat
  length : Nat
  target : Nat -> Int
  coeff : Fin length -> Int
  eval : Nat -> Int
  eval_eq :
    forall n,
      eval n =
        Finset.univ.sum
          (fun j : Fin length => coeff j * mahlerBinomialBasis (j : Nat) n)
  matches_target :
    forall n, FiniteCongruenceMod p k (eval n) (target n)

namespace MahlerBinomialCertificate

theorem eval_formula_at (c : MahlerBinomialCertificate) (n : Nat) :
    c.eval n =
      Finset.univ.sum
        (fun j : Fin c.length =>
          c.coeff j * mahlerBinomialBasis (j : Nat) n) :=
  c.eval_eq n

theorem eval_congruent (c : MahlerBinomialCertificate) (n : Nat) :
    FiniteCongruenceMod c.p c.k (c.eval n) (c.target n) :=
  c.matches_target n

end MahlerBinomialCertificate

structure PAdicOverlapCertificate where
  M : Nat
  p : Nat
  k : Nat
  left : Nat -> Int
  right : Nat -> Int
  modular_match : forall n, IntCongruent M (left n) (right n)
  padic_match : forall n, IntCongruent (PrimePower p k) (left n) (right n)

namespace PAdicOverlapCertificate

theorem matches_modular (c : PAdicOverlapCertificate) (n : Nat) :
    IntCongruent c.M (c.left n) (c.right n) :=
  c.modular_match n

theorem matches_padic (c : PAdicOverlapCertificate) (n : Nat) :
    IntCongruent (PrimePower c.p c.k) (c.left n) (c.right n) :=
  c.padic_match n

theorem matches_finite_padic (c : PAdicOverlapCertificate) (n : Nat) :
    FiniteCongruenceMod c.p c.k (c.left n) (c.right n) :=
  c.matches_padic n

theorem matches_both (c : PAdicOverlapCertificate) (n : Nat) :
    IntCongruent c.M (c.left n) (c.right n) /\
      IntCongruent (PrimePower c.p c.k) (c.left n) (c.right n) :=
  And.intro (c.matches_modular n) (c.matches_padic n)

end PAdicOverlapCertificate

/-! ## Regression layer: OLS/interval certificate for entropy constants. -/

noncomputable def EntropyModel (a : Nat -> Real) (alpha beta : Real) (n : Nat) : Real :=
  Real.log |a n| -
    (alpha * Real.sqrt (n : Real) - (1 / 2 : Real) * Real.log (n : Real) + beta)

def EntropyGrowth (a : Nat -> Real) (alpha beta : Real) : Prop :=
  Filter.Tendsto (fun n => EntropyModel a alpha beta n) Filter.atTop (nhds (0 : Real))

def EntropyGrowthEpsilonN (a : Nat -> Real) (alpha beta : Real) : Prop :=
  forall eps : Real, 0 < eps ->
    exists N : Nat,
      forall n : Nat, N <= n -> |EntropyModel a alpha beta n| < eps

def LittleOOneAtTop (r : Nat -> Real) : Prop :=
  forall eps : Real, 0 < eps ->
    exists N : Nat, forall n : Nat, N <= n -> |r n| < eps

def EntropyGrowthLittleOOne (a : Nat -> Real) (alpha beta : Real) : Prop :=
  LittleOOneAtTop (fun n => EntropyModel a alpha beta n)

theorem entropyGrowthLittleOOne_iff_epsilonN
    (a : Nat -> Real) (alpha beta : Real) :
    EntropyGrowthLittleOOne a alpha beta <->
      EntropyGrowthEpsilonN a alpha beta := by
  rfl

structure EntropyAsymptoticCertificate (a : Nat -> Real) where
  alpha : Real
  beta : Real
  tendsto_form : EntropyGrowth a alpha beta
  epsilonN_form : EntropyGrowthEpsilonN a alpha beta
  littleO_one_form : EntropyGrowthLittleOOne a alpha beta

namespace EntropyAsymptoticCertificate

theorem tendsto {a : Nat -> Real}
    (c : EntropyAsymptoticCertificate a) :
    EntropyGrowth a c.alpha c.beta :=
  c.tendsto_form

theorem eventually_small {a : Nat -> Real}
    (c : EntropyAsymptoticCertificate a) {eps : Real} (heps : 0 < eps) :
    exists N : Nat,
      forall n : Nat, N <= n -> |EntropyModel a c.alpha c.beta n| < eps :=
  c.epsilonN_form eps heps

theorem littleO_one {a : Nat -> Real}
    (c : EntropyAsymptoticCertificate a) :
    EntropyGrowthLittleOOne a c.alpha c.beta :=
  c.littleO_one_form

end EntropyAsymptoticCertificate

theorem entropy_intercept {a : Nat -> Real} {alpha beta : Real}
    (h : EntropyGrowth a alpha beta) :
    Filter.Tendsto
      (fun n =>
        Real.log |a n| - alpha * Real.sqrt (n : Real) +
          (1 / 2 : Real) * Real.log (n : Real))
      Filter.atTop (nhds beta) := by
  have h2 := h.add_const beta
  simp only [zero_add] at h2
  exact h2.congr (fun n => by
    simp [EntropyGrowth, EntropyModel]
    ring)

theorem entropy_beta_unique {a : Nat -> Real} {alpha beta beta' : Real}
    (h : EntropyGrowth a alpha beta) (h' : EntropyGrowth a alpha beta') :
    beta = beta' := by
  have key : Filter.Tendsto (fun _ : Nat => beta' - beta) Filter.atTop (nhds (0 - 0 : Real)) :=
    (h.sub h').congr (fun n => by
      simp [EntropyGrowth, EntropyModel])
  rw [sub_zero] at key
  have hconst : beta' - beta = 0 :=
    tendsto_nhds_unique tendsto_const_nhds key
  linarith

structure OLSCertificate (a : Nat -> Real) where
  window : Window
  alphaHat : Real
  betaHat : Real
  alphaInterval : ClosedInterval
  betaInterval : ClosedInterval
  alpha_mem : alphaInterval.Contains alphaHat
  beta_mem : betaInterval.Contains betaHat
  residualBound : Real
  residual_nonneg : 0 <= residualBound
  residual_le :
    forall n, window.Contains n ->
      |EntropyModel a alphaHat betaHat n| <= residualBound

namespace OLSCertificate

theorem alphaHat_mem {a : Nat -> Real} (c : OLSCertificate a) :
    c.alphaInterval.Contains c.alphaHat :=
  c.alpha_mem

theorem betaHat_mem {a : Nat -> Real} (c : OLSCertificate a) :
    c.betaInterval.Contains c.betaHat :=
  c.beta_mem

theorem residual_at {a : Nat -> Real} (c : OLSCertificate a)
    {n : Nat} (hn : c.window.Contains n) :
    |EntropyModel a c.alphaHat c.betaHat n| <= c.residualBound :=
  c.residual_le n hn

end OLSCertificate

structure RatClosedInterval where
  lower : Rat
  upper : Rat
  lower_le_upper : lower <= upper

namespace RatClosedInterval

def Contains (I : RatClosedInterval) (x : Rat) : Prop :=
  I.lower <= x /\ x <= I.upper

end RatClosedInterval

structure RationalRegressionPoint where
  n : Nat
  xSqrt : Rat
  xLog : Rat
  yLogAbsCoeff : Rat

structure RationalOLSCertificate where
  points : Nat
  point : Fin points -> RationalRegressionPoint
  alphaHat : Rat
  betaHat : Rat
  alphaInterval : RatClosedInterval
  betaInterval : RatClosedInterval
  alpha_mem : alphaInterval.Contains alphaHat
  beta_mem : betaInterval.Contains betaHat
  residualBound : Rat
  residual_nonneg : 0 <= residualBound
  residual : Fin points -> Rat
  residual_formula :
    forall i,
      residual i =
        (point i).yLogAbsCoeff -
          (alphaHat * (point i).xSqrt -
            (1 / 2 : Rat) * (point i).xLog + betaHat)
  residual_abs_le :
    forall i, |residual i| <= residualBound

namespace RationalOLSCertificate

def predictedAt (c : RationalOLSCertificate)
    (i : Fin c.points) : Rat :=
  c.alphaHat * (c.point i).xSqrt -
    (1 / 2 : Rat) * (c.point i).xLog + c.betaHat

theorem predictedAt_eq (c : RationalOLSCertificate)
    (i : Fin c.points) :
    c.predictedAt i =
      c.alphaHat * (c.point i).xSqrt -
        (1 / 2 : Rat) * (c.point i).xLog + c.betaHat := rfl

theorem alphaHat_mem (c : RationalOLSCertificate) :
    c.alphaInterval.Contains c.alphaHat :=
  c.alpha_mem

theorem betaHat_mem (c : RationalOLSCertificate) :
    c.betaInterval.Contains c.betaHat :=
  c.beta_mem

theorem residual_formula_at (c : RationalOLSCertificate)
    (i : Fin c.points) :
    c.residual i =
      (c.point i).yLogAbsCoeff -
        (c.alphaHat * (c.point i).xSqrt -
          (1 / 2 : Rat) * (c.point i).xLog + c.betaHat) :=
  c.residual_formula i

theorem residual_eq_observed_sub_predicted
    (c : RationalOLSCertificate) (i : Fin c.points) :
    c.residual i =
      (c.point i).yLogAbsCoeff - c.predictedAt i := by
  simpa [predictedAt] using c.residual_formula_at i

theorem residual_bound_at (c : RationalOLSCertificate) (i : Fin c.points) :
    |c.residual i| <= c.residualBound :=
  c.residual_abs_le i

theorem residualBound_nonneg (c : RationalOLSCertificate) :
    0 <= c.residualBound :=
  c.residual_nonneg

theorem interval_membership (c : RationalOLSCertificate) :
    c.alphaInterval.Contains c.alphaHat /\
      c.betaInterval.Contains c.betaHat :=
  And.intro c.alphaHat_mem c.betaHat_mem

theorem abs_residual_nonneg (c : RationalOLSCertificate)
    (i : Fin c.points) :
    0 <= |c.residual i| := by
  exact abs_nonneg (c.residual i)

end RationalOLSCertificate

noncomputable def cardyConstant (alpha : Real) : Real :=
  (6 / (Real.pi ^ 2)) * alpha ^ 2

noncomputable def effectiveCardyConstant (alpha : Real) : Real :=
  6 * (alpha / 2) ^ 2 / (Real.pi ^ 2)

theorem effectiveCardyConstant_formula (alpha : Real) :
    effectiveCardyConstant alpha = 6 * (alpha / 2) ^ 2 / (Real.pi ^ 2) := rfl

theorem cardyConstant_nonneg (alpha : Real) :
    0 <= cardyConstant alpha := by
  unfold cardyConstant
  positivity

theorem effectiveCardyConstant_nonneg (alpha : Real) :
    0 <= effectiveCardyConstant alpha := by
  unfold effectiveCardyConstant
  positivity

theorem log_abs_exp (x : Real) : Real.log |Real.exp x| = x := by
  rw [abs_of_pos (Real.exp_pos x), Real.log_exp]

noncomputable def exactEntropyCoeff (alpha beta : Real) : Nat -> Real :=
  fun n =>
    Real.exp
      (alpha * Real.sqrt (n : Real) -
        (1 / 2 : Real) * Real.log (n : Real) + beta)

theorem exactEntropyCoeff_growth (alpha beta : Real) :
    EntropyGrowth (exactEntropyCoeff alpha beta) alpha beta := by
  simpa [EntropyGrowth, EntropyModel, exactEntropyCoeff, log_abs_exp]
    using
      (tendsto_const_nhds :
        Filter.Tendsto (fun _ : Nat => (0 : Real)) Filter.atTop (nhds (0 : Real)))

theorem exactEntropyCoeff_growth_epsilonN (alpha beta : Real) :
    EntropyGrowthEpsilonN (exactEntropyCoeff alpha beta) alpha beta := by
  intro eps heps
  refine Exists.intro 0 ?_
  intro n hn
  simpa [EntropyGrowthEpsilonN, EntropyModel, exactEntropyCoeff, log_abs_exp]
    using heps

def JacobiCoefficientFamily :=
  Nat -> Int -> Real

inductive DegeneracyChannel where
  | scalar (a : Nat -> Real)
  | jacobiSlice (c : Int -> Real) (a : JacobiCoefficientFamily)

namespace DegeneracyChannel

noncomputable def value : DegeneracyChannel -> Nat -> Real
  | scalar a, n => a n
  | jacobiSlice c a, n =>
      (Finset.range (2 * n + 1)).sum
        (fun j => c ((j : Int) - n) * a n ((j : Int) - n))

@[simp]
theorem value_scalar (a : Nat -> Real) (n : Nat) :
    (DegeneracyChannel.scalar a).value n = a n := rfl

theorem value_jacobiSlice (c : Int -> Real) (a : JacobiCoefficientFamily)
    (n : Nat) :
    (DegeneracyChannel.jacobiSlice c a).value n =
      (Finset.range (2 * n + 1)).sum
        (fun j => c ((j : Int) - n) * a n ((j : Int) - n)) := rfl

end DegeneracyChannel

/-! ## Advanced layer: final theorem aggregation. -/

inductive ObjectKind where
  | mockTheta
  | partialTheta
  | jacobi
  | model
deriving DecidableEq, Repr

structure PaperObject where
  name : String
  kind : ObjectKind
  coeff : Nat -> Real

structure ObjectQSeriesCertificate where
  object : PaperObject
  series : QSeries Real
  coeff_eq :
    forall n, series.coeff n = object.coeff n

namespace ObjectQSeriesCertificate

theorem coeff_eq_object (c : ObjectQSeriesCertificate) (n : Nat) :
    c.series.coeff n = c.object.coeff n :=
  c.coeff_eq n

theorem coefficientAt_eq_object
    (c : ObjectQSeriesCertificate) (n : Nat) :
    c.series.coefficientAt n = c.object.coeff n := by
  calc
    c.series.coefficientAt n = c.series.coeff n := rfl
    _ = c.object.coeff n := c.coeff_eq_object n

end ObjectQSeriesCertificate

structure AbstractCertificate (X : Type*) where
  object : PaperObject
  qSeriesCertificate : ObjectQSeriesCertificate
  qSeriesCertificate_matches :
    qSeriesCertificate.object = object
  alpha : Real
  beta : Real
  entropyProof : EntropyGrowth object.coeff alpha beta
  entropyExplicit : EntropyGrowthEpsilonN object.coeff alpha beta
  appellLerch : AppellLerchSpecializationCertificate
  xiCertificate : BruinierFunkeXiCertificate
  slashAction : HalfWeightSlashAction
  slashGenerator : SlashGeneratorCertificate
  slashGenerator_matches :
    slashGenerator.action = slashAction
  cuspTransportCertificate : CuspTransportCertificate
  degeneracy : DegeneracyChannel
  degeneracy_matches : forall n, degeneracy.value n = object.coeff n
  completion : CompletionSplit X Complex
  shadow : ShadowCertificate X
  rademacherExpansion : RademacherExpansionCertificate object.coeff
  rademacherTerms : RademacherLinkedExpansionData
  rademacherKernel : RademacherKernelPortfolio
  rademacher : RademacherCertificate object.coeff
  padic : PAdicNormalization
  regression : OLSCertificate object.coeff

namespace AbstractCertificate

theorem qseries_object_link {X : Type*}
    (c : AbstractCertificate X) :
    c.qSeriesCertificate.object = c.object :=
  c.qSeriesCertificate_matches

theorem qseries_coeff_eq_object {X : Type*}
    (c : AbstractCertificate X) (n : Nat) :
    c.qSeriesCertificate.series.coeff n = c.object.coeff n := by
  rw [c.qSeriesCertificate_matches.symm]
  exact c.qSeriesCertificate.coeff_eq_object n

theorem qseries_coefficientAt_eq_object {X : Type*}
    (c : AbstractCertificate X) (n : Nat) :
    c.qSeriesCertificate.series.coefficientAt n = c.object.coeff n := by
  rw [c.qSeriesCertificate_matches.symm]
  exact c.qSeriesCertificate.coefficientAt_eq_object n

theorem entropy_intercept_limit {X : Type*} (c : AbstractCertificate X) :
    Filter.Tendsto
      (fun n =>
        Real.log |c.object.coeff n| - c.alpha * Real.sqrt (n : Real) +
          (1 / 2 : Real) * Real.log (n : Real))
      Filter.atTop (nhds c.beta) :=
  MockCert.entropy_intercept c.entropyProof

theorem entropy_small_eventually {X : Type*} (c : AbstractCertificate X)
    {eps : Real} (heps : 0 < eps) :
    exists N : Nat,
      forall n : Nat, N <= n ->
        |EntropyModel c.object.coeff c.alpha c.beta n| < eps :=
  c.entropyExplicit eps heps

theorem entropy_littleO_one {X : Type*} (c : AbstractCertificate X) :
    EntropyGrowthLittleOOne c.object.coeff c.alpha c.beta :=
  (entropyGrowthLittleOOne_iff_epsilonN c.object.coeff c.alpha c.beta).mpr
    c.entropyExplicit

theorem beta_unique {X : Type*} (c : AbstractCertificate X) {beta' : Real}
    (h' : EntropyGrowth c.object.coeff c.alpha beta') :
    c.beta = beta' :=
  MockCert.entropy_beta_unique c.entropyProof h'

theorem cardy_nonnegative {X : Type*} (c : AbstractCertificate X) :
    0 <= cardyConstant c.alpha :=
  cardyConstant_nonneg c.alpha

theorem effective_cardy_nonnegative {X : Type*} (c : AbstractCertificate X) :
    0 <= effectiveCardyConstant c.alpha :=
  effectiveCardyConstant_nonneg c.alpha

theorem degeneracy_value_eq_coeff {X : Type*} (c : AbstractCertificate X)
    (n : Nat) :
    c.degeneracy.value n = c.object.coeff n :=
  c.degeneracy_matches n

theorem completion_split_at {X : Type*}
    (c : AbstractCertificate X) (x : X) :
    c.completion.hat x = c.completion.plus x + c.completion.minus x :=
  c.completion.split x

theorem completion_hat_eq_plus_of_minus_zero {X : Type*}
    (c : AbstractCertificate X)
    (hminus : forall x, c.completion.minus x = 0) :
    forall x, c.completion.hat x = c.completion.plus x :=
  c.completion.hat_eq_plus_of_minus_zero hminus

theorem shadow_eq_at {X : Type*} (c : AbstractCertificate X) (x : X) :
    c.shadow.xiFhat x = c.shadow.scale * c.shadow.theta x :=
  c.shadow.shadow_eq x

theorem shadow_zero_of_scale_zero {X : Type*} (c : AbstractCertificate X)
    (hscale : c.shadow.scale = 0) :
    forall x, c.shadow.xiFhat x = 0 :=
  c.shadow.zero_of_scale_zero hscale

theorem appell_u0_sub_v0 {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    u0 tau - v0 tau = frozenZ0 :=
  MockCert.u0_sub_v0 tau

theorem appell_specializedMu_eq_mu_u0_v0 {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.data.specializedMu tau =
      c.appellLerch.data.mu (u0 tau) (v0 tau) tau :=
  c.appellLerch.data.specializedMu_eq_mu_u0_v0 tau

theorem appell_completionTerm_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.data.completionTerm tau =
      (Complex.I / 2) * c.appellLerch.data.R frozenZ0 tau :=
  c.appellLerch.data.completionTerm_eq_R tau

theorem appell_specializedMuHat_eq_mu_add_completionTerm {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.data.specializedMuHat tau =
      c.appellLerch.data.specializedMu tau +
        c.appellLerch.data.completionTerm tau :=
  c.appellLerch.data.specializedMuHat_eq_mu_add_completionTerm tau

theorem appell_Fplus_eq_mu {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fplus tau =
      c.appellLerch.data.specializedMu tau :=
  c.appellLerch.Fplus_at tau

theorem appell_Fminus_eq_R {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fminus tau =
      (Complex.I / 2) * c.appellLerch.S *
        c.appellLerch.data.R frozenZ0 tau :=
  c.appellLerch.Fminus_at tau

theorem appell_Fhat_split {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fhat tau =
      c.appellLerch.Fplus tau + c.appellLerch.Fminus tau :=
  c.appellLerch.Fhat_split_at tau

theorem appell_Fhat_eq_mu_add_completion {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fhat tau =
      c.appellLerch.data.specializedMu tau +
        (Complex.I / 2) * c.appellLerch.S *
          c.appellLerch.data.R frozenZ0 tau :=
  c.appellLerch.Fhat_eq_mu_add_completion tau

theorem appell_Fminus_eq_scaled_completionTerm {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fminus tau =
      c.appellLerch.S * c.appellLerch.data.completionTerm tau :=
  c.appellLerch.Fminus_eq_scaled_completionTerm tau

theorem appell_Fhat_eq_mu_add_scaled_completionTerm {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.appellLerch.Fhat tau =
      c.appellLerch.data.specializedMu tau +
        c.appellLerch.S * c.appellLerch.data.completionTerm tau :=
  c.appellLerch.Fhat_eq_mu_add_scaled_completionTerm tau

theorem appell_holomorphic_if_S_zero {X : Type*}
    (c : AbstractCertificate X) (hS : c.appellLerch.S = 0) :
    forall tau, c.appellLerch.Fminus tau = 0 :=
  c.appellLerch.holomorphic_if_S_zero hS

theorem appell_Fhat_eq_mu_of_S_zero {X : Type*}
    (c : AbstractCertificate X) (hS : c.appellLerch.S = 0) :
    forall tau, c.appellLerch.Fhat tau =
      c.appellLerch.data.specializedMu tau :=
  c.appellLerch.Fhat_eq_mu_of_S_zero hS

theorem xi_eq_shadow_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    c.xiCertificate.xiOperator.xi c.xiCertificate.completedObject tau =
      c.xiCertificate.scale * c.xiCertificate.shadow tau :=
  c.xiCertificate.xi_eq_shadow_at tau

theorem xi_zero_of_scale_zero {X : Type*}
    (c : AbstractCertificate X) (hscale : c.xiCertificate.scale = 0) :
    forall tau,
      c.xiCertificate.xiOperator.xi c.xiCertificate.completedObject tau = 0 :=
  c.xiCertificate.xi_zero_of_scale_zero hscale

theorem certified_cusp_transport_q_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    qParameter (c.cuspTransportCertificate.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau) :=
  c.cuspTransportCertificate.q_after_at tau

theorem certified_cusp_transport_formula_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    (c.cuspTransportCertificate.transport.act tau).z =
      c.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau :=
  c.cuspTransportCertificate.act_formula_at tau

theorem slash_generator_action_link {X : Type*}
    (c : AbstractCertificate X) :
    c.slashGenerator.action = c.slashAction :=
  c.slashGenerator_matches

theorem slash_weight_half {X : Type*}
    (c : AbstractCertificate X) :
    c.slashGenerator.weight = halfWeight :=
  c.slashGenerator.weight_is_half

theorem slash_multiplier_T {X : Type*}
    (c : AbstractCertificate X) :
    c.slashGenerator.action.multiplier.value_T =
      c.slashGenerator.action.multiplier.value ModularMatrix.T :=
  c.slashGenerator.multiplier_T

theorem slash_multiplier_S {X : Type*}
    (c : AbstractCertificate X) :
    c.slashGenerator.action.multiplier.value_S =
      c.slashGenerator.action.multiplier.value ModularMatrix.S :=
  c.slashGenerator.multiplier_S

theorem slash_T_via_certified_transport {X : Type*}
    (c : AbstractCertificate X)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.slashGenerator.action.slash f ModularMatrix.T tau =
      c.slashGenerator.action.multiplier.value ModularMatrix.T *
        f (c.slashGenerator.transportT.transport.act tau) :=
  c.slashGenerator.generator_T_via_transport f tau

theorem slash_transportT_q_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    qParameter (c.slashGenerator.transportT.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.slashGenerator.transportT.transport.matrix.fractionalLinearFormula tau) :=
  c.slashGenerator.transportT_q_at tau

theorem slash_transportS_q_at {X : Type*}
    (c : AbstractCertificate X) (tau : UpperHalfPlanePoint) :
    qParameter (c.slashGenerator.transportS.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        c.slashGenerator.transportS.transport.matrix.fractionalLinearFormula tau) :=
  c.slashGenerator.transportS_q_at tau

theorem slash_S_generator {X : Type*}
    (c : AbstractCertificate X)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.slashGenerator.action.slash f ModularMatrix.S tau =
      c.slashGenerator.action.multiplier.value ModularMatrix.S *
        f (c.slashGenerator.action.transportS tau) :=
  c.slashGenerator.generator_S_at f tau

theorem slash_S_via_certified_transport {X : Type*}
    (c : AbstractCertificate X)
    (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint) :
    c.slashGenerator.action.slash f ModularMatrix.S tau =
      c.slashGenerator.action.multiplier.value ModularMatrix.S *
        f (c.slashGenerator.transportS.transport.act tau) :=
  c.slashGenerator.generator_S_via_transport f tau

theorem rademacher_term_value_at {X : Type*}
    (c : AbstractCertificate X) (m : Nat) :
    c.rademacherTerms.expansion.term m =
      (c.rademacherTerms.termCertificate m).data.value :=
  c.rademacherTerms.term_value_at m

theorem rademacher_term_formula_at {X : Type*}
    (c : AbstractCertificate X) (m : Nat) :
    c.rademacherTerms.expansion.term m =
      (c.rademacherTerms.termCertificate m).data.amplitude *
        BesselIHalfModel
          (c.rademacherTerms.termCertificate m).data.besselArgument :=
  c.rademacherTerms.term_formula_at m

theorem rademacher_kernel_multiplier_at {X : Type*}
    (c : AbstractCertificate X) (m : Nat) :
    c.rademacherKernel.expansion.multiplier m =
      KloostermanSum (c.rademacherKernel.kernelCertificate m).datum :=
  c.rademacherKernel.multiplier_eq_kloosterman_sum m

theorem rademacher_kloosterman_at {X : Type*}
    (c : AbstractCertificate X) (m : Nat) :
    c.rademacherKernel.expansion.kloostermanAt m =
      (c.rademacherKernel.kernelCertificate m).certifiedSum :=
  c.rademacherKernel.kloostermanAt_eq_certified_sum m

theorem rademacher_tail_at {X : Type*}
    (c : AbstractCertificate X) {n : Nat}
    (hn : c.rademacherExpansion.tail.cutoff <= n) :
    |c.rademacherExpansion.remainder n| <=
      c.rademacherExpansion.tail.C *
        Real.exp
          (-c.rademacherExpansion.tail.lambda * Real.sqrt (n : Real)) :=
  c.rademacherExpansion.tail_le hn

theorem padic_normalized_congruent {X : Type*}
    (c : AbstractCertificate X) (n : Nat) :
    IntCongruent (PrimePower c.padic.p c.padic.k)
      (c.padic.normalized n) (c.padic.raw n) :=
  c.padic.congruent_at n

theorem padic_normalized_finite_congruent {X : Type*}
    (c : AbstractCertificate X) (n : Nat) :
    FiniteCongruenceMod c.padic.p c.padic.k
      (c.padic.normalized n) (c.padic.raw n) :=
  c.padic.finite_congruent_at n

theorem regression_alpha_mem {X : Type*}
    (c : AbstractCertificate X) :
    c.regression.alphaInterval.Contains c.regression.alphaHat :=
  c.regression.alphaHat_mem

theorem regression_beta_mem {X : Type*}
    (c : AbstractCertificate X) :
    c.regression.betaInterval.Contains c.regression.betaHat :=
  c.regression.betaHat_mem

theorem regression_residual_nonnegative {X : Type*}
    (c : AbstractCertificate X) :
    0 <= c.regression.residualBound :=
  c.regression.residual_nonneg

theorem regression_residual_bound_at {X : Type*}
    (c : AbstractCertificate X) {n : Nat}
    (hn : c.regression.window.Contains n) :
    |EntropyModel c.object.coeff c.regression.alphaHat
      c.regression.betaHat n| <= c.regression.residualBound :=
  c.regression.residual_at hn

end AbstractCertificate

structure AbstractProofPayload {X : Type*}
    (c : AbstractCertificate X) : Prop where
  qseriesObject :
    c.qSeriesCertificate.object = c.object
  coefficientLink :
    forall n, c.qSeriesCertificate.series.coeff n = c.object.coeff n
  entropyTendsto :
    EntropyGrowth c.object.coeff c.alpha c.beta
  entropyEpsilonN :
    EntropyGrowthEpsilonN c.object.coeff c.alpha c.beta
  entropyLittleO :
    EntropyGrowthLittleOOne c.object.coeff c.alpha c.beta
  appellMuHat :
    forall tau,
      c.appellLerch.data.specializedMuHat tau =
        c.appellLerch.data.specializedMu tau +
          c.appellLerch.data.completionTerm tau
  xiShadow :
    forall tau,
      c.xiCertificate.xiOperator.xi c.xiCertificate.completedObject tau =
        c.xiCertificate.scale * c.xiCertificate.shadow tau
  slashWeight :
    c.slashGenerator.weight = halfWeight
  slashT :
    forall f tau,
      c.slashGenerator.action.slash f ModularMatrix.T tau =
        c.slashGenerator.action.multiplier.value ModularMatrix.T *
          f (c.slashGenerator.transportT.transport.act tau)
  slashS :
    forall f tau,
      c.slashGenerator.action.slash f ModularMatrix.S tau =
        c.slashGenerator.action.multiplier.value ModularMatrix.S *
          f (c.slashGenerator.transportS.transport.act tau)
  degeneracyCoeff :
    forall n, c.degeneracy.value n = c.object.coeff n
  completionSplit :
    forall x, c.completion.hat x = c.completion.plus x + c.completion.minus x
  shadowEquation :
    forall x, c.shadow.xiFhat x = c.shadow.scale * c.shadow.theta x
  rademacherCoeff :
    forall n,
      c.object.coeff n =
        (c.rademacherExpansion.expansion n).truncation
          (c.rademacherExpansion.cutoff n) +
            c.rademacherExpansion.remainder n
  rademacherTail :
    forall n, c.rademacherExpansion.tail.cutoff <= n ->
      |c.rademacherExpansion.remainder n| <=
        c.rademacherExpansion.tail.C *
          Real.exp
            (-c.rademacherExpansion.tail.lambda * Real.sqrt (n : Real))
  padicFinite :
    forall n,
      FiniteCongruenceMod c.padic.p c.padic.k
        (c.padic.normalized n) (c.padic.raw n)
  regressionAlpha :
    c.regression.alphaInterval.Contains c.regression.alphaHat
  regressionBeta :
    c.regression.betaInterval.Contains c.regression.betaHat
  regressionResidualNonneg :
    0 <= c.regression.residualBound
  regressionResidual :
    forall n, c.regression.window.Contains n ->
      |EntropyModel c.object.coeff c.regression.alphaHat
        c.regression.betaHat n| <= c.regression.residualBound

namespace AbstractProofPayload

theorem entropy_epsilonN_at {X : Type*}
    {c : AbstractCertificate X}
    (P : AbstractProofPayload c) :
    EntropyGrowthEpsilonN c.object.coeff c.alpha c.beta :=
  P.entropyEpsilonN

theorem entropy_littleO_at {X : Type*}
    {c : AbstractCertificate X}
    (P : AbstractProofPayload c) :
    EntropyGrowthLittleOOne c.object.coeff c.alpha c.beta :=
  P.entropyLittleO

theorem rademacher_coeff_at {X : Type*}
    {c : AbstractCertificate X}
    (P : AbstractProofPayload c) (n : Nat) :
    c.object.coeff n =
      (c.rademacherExpansion.expansion n).truncation
        (c.rademacherExpansion.cutoff n) +
          c.rademacherExpansion.remainder n :=
  P.rademacherCoeff n

theorem padic_finite_at {X : Type*}
    {c : AbstractCertificate X}
    (P : AbstractProofPayload c) (n : Nat) :
    FiniteCongruenceMod c.padic.p c.padic.k
      (c.padic.normalized n) (c.padic.raw n) :=
  P.padicFinite n

theorem regression_interval_at {X : Type*}
    {c : AbstractCertificate X}
    (P : AbstractProofPayload c) :
    c.regression.alphaInterval.Contains c.regression.alphaHat /\
      c.regression.betaInterval.Contains c.regression.betaHat :=
  And.intro P.regressionAlpha P.regressionBeta

end AbstractProofPayload

namespace AbstractCertificate

theorem proof_payload {X : Type*}
    (c : AbstractCertificate X) :
    AbstractProofPayload c where
  qseriesObject := c.qseries_object_link
  coefficientLink := c.qseries_coeff_eq_object
  entropyTendsto := c.entropyProof
  entropyEpsilonN := c.entropyExplicit
  entropyLittleO := c.entropy_littleO_one
  appellMuHat := c.appell_specializedMuHat_eq_mu_add_completionTerm
  xiShadow := c.xi_eq_shadow_at
  slashWeight := c.slash_weight_half
  slashT := c.slash_T_via_certified_transport
  slashS := c.slash_S_via_certified_transport
  degeneracyCoeff := c.degeneracy_value_eq_coeff
  completionSplit := c.completion_split_at
  shadowEquation := c.shadow_eq_at
  rademacherCoeff := c.rademacherExpansion.coeff_eq
  rademacherTail := by
    intro n hn
    exact c.rademacher_tail_at hn
  padicFinite := c.padic_normalized_finite_congruent
  regressionAlpha := c.regression_alpha_mem
  regressionBeta := c.regression_beta_mem
  regressionResidualNonneg := c.regression_residual_nonnegative
  regressionResidual := by
    intro n hn
    exact c.regression_residual_bound_at hn

end AbstractCertificate

structure ConcreteCertificate (X : Type*) extends AbstractCertificate X where
  principalPart : PrincipalPart Complex
  polarProfile : PolarProfile Complex
  principalPartLink : PrincipalPartCertificate Complex
  principalPartLink_matches :
    principalPartLink.principal = principalPart
  polarProfileLink : PolarProfileCertificate Complex
  polarProfileLink_matches :
    polarProfileLink.profile = polarProfile
  principalSystemInt : LinearSystemCertificate Int
  intervalSystemRat : LinearSystemCertificate Rat
  intervalSystemComplex : ComplexIntervalLinearSystemCertificate
  principalSystemInt_rows_match :
    principalSystemInt.system.rows = principalPart.order
  intervalSystemRat_rows_match :
    intervalSystemRat.system.rows = principalPart.order
  intervalSystemComplex_rows_match :
    intervalSystemComplex.system.rows = principalPart.order
  spt : SPTCertificate
  sptIdeal : SPTIdealCertificate
  sptIdeal_matches :
    sptIdeal.spt = spt
  crt : CRTCertificate
  crtPortfolio : CRTPortfolio
  crtPortfolio_pairCompatible :
    forall i j,
      PairCompatible (crtPortfolio.modulus i) (crtPortfolio.modulus j)
        (crtPortfolio.residue i) (crtPortfolio.residue j)
  torSurrogate : TorFiniteSurrogate
  torSurrogate_left_matches_spt :
    torSurrogate.leftModulus = spt.M
  torSurrogate_right_matches_spt :
    torSurrogate.rightModulus = spt.p ^ spt.k
  torSurrogate_order_matches_spt_obstruction :
    torSurrogate.quotientOrder = spt.obstruction.order
  padicOverlap : PAdicOverlapCertificate
  mahler : MahlerFiniteCertificate
  mahlerBinomial : MahlerBinomialCertificate
  rationalOLS : RationalOLSCertificate
  paperObjectName : String
  paperFamilyName : String
  paperPrincipalPartRows : Nat
  paperCoefficientTableLength : Nat
  paperClaimRegistryName : String
  paperObjectName_eq :
    paperObjectName = object.name
  paperFamilyName_nonempty :
    Not (paperFamilyName = "")
  paperPrincipalPartRows_eq :
    paperPrincipalPartRows = principalPart.order
  paperCoefficientTableLength_pos :
    0 < paperCoefficientTableLength
  paperClaimRegistryName_nonempty :
    Not (paperClaimRegistryName = "")

namespace ConcreteCertificate

theorem entropy_intercept_limit {X : Type*} (c : ConcreteCertificate X) :
    Filter.Tendsto
      (fun n =>
        Real.log |c.object.coeff n| - c.alpha * Real.sqrt (n : Real) +
          (1 / 2 : Real) * Real.log (n : Real))
      Filter.atTop (nhds c.beta) :=
  c.toAbstractCertificate.entropy_intercept_limit

theorem qseries_object_link {X : Type*}
    (c : ConcreteCertificate X) :
    c.qSeriesCertificate.object = c.object :=
  c.toAbstractCertificate.qseries_object_link

theorem qseries_coeff_eq_object {X : Type*}
    (c : ConcreteCertificate X) (n : Nat) :
    c.qSeriesCertificate.series.coeff n = c.object.coeff n :=
  c.toAbstractCertificate.qseries_coeff_eq_object n

theorem qseries_coefficientAt_eq_object {X : Type*}
    (c : ConcreteCertificate X) (n : Nat) :
    c.qSeriesCertificate.series.coefficientAt n = c.object.coeff n :=
  c.toAbstractCertificate.qseries_coefficientAt_eq_object n

theorem spt_equalizer_lcm_dvd {X : Type*} (c : ConcreteCertificate X) :
    Dvd.dvd (Nat.lcm c.spt.M (c.spt.p ^ c.spt.k)) c.spt.equalizerElement :=
  c.spt.equalizer_lcm_dvd

theorem spt_equalizer_mem_modular {X : Type*} (c : ConcreteCertificate X) :
    Dvd.dvd c.spt.M c.spt.equalizerElement :=
