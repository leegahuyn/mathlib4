structure DefinitionCoverage (C : FormalizationChecklist) : Prop where
  upper_half_plane_domain :
    forall tau, 0 < (C.domainPoint tau).z.im
  q_parameter_exp :
    forall tau, qParameter tau =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z)
  cusp_transport_q :
    forall T tau, C.cuspTransport T tau = qParameter (T.act tau)
  certified_cusp_transport_q :
    forall tau,
      qParameter (C.cuspTransportCertificate.transport.act tau) =
        Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
          C.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau)
  certified_cusp_transport_formula :
    forall tau,
      (C.cuspTransportCertificate.transport.act tau).z =
        C.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau
  cusp_route_source :
    C.cuspTransportCertificate.transport.source = C.cuspSourceWitness
  cusp_route_target :
    C.cuspTransportCertificate.transport.target = C.cuspTargetWitness
  cusp_route_matrix :
    C.cuspTransportCertificate.transport.matrix = C.cuspMatrixWitness
  qseries_coeff_extract :
    forall n, C.qSeriesWitness.coefficientAt n = C.qSeriesWitness.coeff n
  truncated_prefix :
    forall n, forall h : n < C.qSeriesPrefixWitness.truncated.length,
      C.qSeriesPrefixWitness.truncated.coefficientAt n =
        C.qSeriesPrefixWitness.full.coeff n
  truncated_eval :
    forall q : Real, C.qSeriesPrefixWitness.truncatedEval q =
      C.qSeriesPrefixWitness.fullPrefixEval q
  truncated_coeff_sum :
    C.qSeriesPrefixWitness.truncatedCoeffSum =
      C.qSeriesPrefixWitness.fullPrefixCoeffSum
  finite_support :
    forall n, C.finiteSupportWitness.cutoff <= n ->
      C.finiteSupportWitness.series.coefficientAt n = 0
  laurent_principal :
    forall n, C.laurentWitness.principalCoeff n =
      C.laurentWitness.coeff (-((n + 1 : Nat) : Int))
  principal_part :
    forall i : Fin C.principalPartLink.principal.order,
      C.principalPartLink.principal.coeffAt i =
        C.principalPartLink.laurent.coeff
          (-(((i : Nat) + 1 : Nat) : Int))
  principal_laurent_link :
    C.principalPartLink.laurent = C.laurentWitness
  principal_witness_link :
    C.principalPartLink.principal = C.principalPartWitness
  polar_profile_formula :
    forall i : Fin C.polarProfileLink.profile.terms,
      (C.polarProfileLink.profile.term i).exponent =
        -(((i : Nat) + 1 : Nat) : Int)
  polar_profile :
    forall i : Fin C.polarProfileLink.profile.terms,
      (C.polarProfileLink.profile.term i).exponent < 0
  polar_witness_link :
    C.polarProfileLink.profile = C.polarProfileWitness
  appell_u0_v0 :
    forall tau, u0 tau - v0 tau = frozenZ0
  appell_mu_specialization :
    forall tau,
      C.appellLerchWitness.specializedMu tau =
        C.appellLerchWitness.mu (u0 tau) (v0 tau) tau
  appell_muHat_u0_v0 :
    forall tau,
      C.appellLerchWitness.specializedMuHat tau =
        C.appellLerchWitness.muHat (u0 tau) (v0 tau) tau
  appell_muHat_general :
    forall u v tau,
      C.appellLerchWitness.muHat u v tau =
        C.appellLerchWitness.mu u v tau +
          (Complex.I / 2) * C.appellLerchWitness.R (u - v) tau
  appell_completion :
    forall tau,
      C.appellLerchWitness.completionTerm tau =
        (Complex.I / 2) * C.appellLerchWitness.R frozenZ0 tau
  appell_muHat_completion :
    forall tau,
      C.appellLerchWitness.specializedMuHat tau =
        C.appellLerchWitness.specializedMu tau +
          C.appellLerchWitness.completionTerm tau
  unary_theta_shadow :
    forall tau,
      C.appellLerchWitness.gz tau =
        C.appellLerchWitness.unaryThetaAt frozenZ0 tau
  xi_shadow :
    forall tau, C.xiWitness.xiOperator.xi C.xiWitness.completedObject tau =
      C.xiWitness.scale * C.xiWitness.shadow tau
  slash_weight_half :
    C.slashGeneratorWitness.weight = halfWeight
  slash_multiplier_T :
    C.slashGeneratorWitness.action.multiplier.value_T =
      C.slashGeneratorWitness.action.multiplier.value ModularMatrix.T
  slash_multiplier_S :
    C.slashGeneratorWitness.action.multiplier.value_S =
      C.slashGeneratorWitness.action.multiplier.value ModularMatrix.S
  slash_T_transport :
    forall f tau,
      C.slashGeneratorWitness.action.slash f ModularMatrix.T tau =
        C.slashGeneratorWitness.action.multiplier.value ModularMatrix.T *
          f (C.slashGeneratorWitness.transportT.transport.act tau)
  slash_S_transport :
    forall f tau,
      C.slashGeneratorWitness.action.slash f ModularMatrix.S tau =
        C.slashGeneratorWitness.action.multiplier.value ModularMatrix.S *
          f (C.slashGeneratorWitness.transportS.transport.act tau)
  slash_T_transport_q :
    forall tau,
      qParameter (C.slashGeneratorWitness.transportT.transport.act tau) =
        Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
          C.slashGeneratorWitness.transportT.transport.matrix.fractionalLinearFormula tau)
  slash_S_transport_q :
    forall tau,
      qParameter (C.slashGeneratorWitness.transportS.transport.act tau) =
        Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
          C.slashGeneratorWitness.transportS.transport.matrix.fractionalLinearFormula tau)
  slash_T_transport_formula :
    forall tau,
      (C.slashGeneratorWitness.transportT.transport.act tau).z =
        C.slashGeneratorWitness.transportT.transport.matrix.fractionalLinearFormula tau
  slash_S_transport_formula :
    forall tau,
      (C.slashGeneratorWitness.transportS.transport.act tau).z =
        C.slashGeneratorWitness.transportS.transport.matrix.fractionalLinearFormula tau
  linear_int_system :
    forall i, C.linearSystemIntWitness.system.matrix.mulVec
        C.linearSystemIntWitness.solution i =
      C.linearSystemIntWitness.system.rhs i
  linear_rat_system :
    forall i, C.linearSystemRatWitness.system.matrix.mulVec
        C.linearSystemRatWitness.solution i =
      C.linearSystemRatWitness.system.rhs i
  linear_complex_interval :
    forall i, (C.linearSystemComplexWitness.residual i).Contains 0
  linear_int_rows_principal :
    C.linearSystemIntWitness.system.rows = C.principalPartWitness.order
  linear_rat_rows_principal :
    C.linearSystemRatWitness.system.rows = C.principalPartWitness.order
  linear_complex_rows_principal :
    C.linearSystemComplexWitness.system.rows = C.principalPartWitness.order
  entropy_epsilonN :
    EntropyGrowthEpsilonN C.qSeriesWitness.coeff
      C.entropyWitness.alpha C.entropyWitness.beta
  entropy_littleO :
    EntropyGrowthLittleOOne C.qSeriesWitness.coeff
      C.entropyWitness.alpha C.entropyWitness.beta
  rademacher_expansion :
    forall n, C.qSeriesWitness.coeff n =
      (C.rademacherWitness.expansion n).truncation
        (C.rademacherWitness.cutoff n) +
          C.rademacherWitness.remainder n
  rademacher_kernel :
    forall c, C.rademacherKernelWitness.expansion.multiplier c =
      KloostermanSum
        (C.rademacherKernelWitness.kernelCertificate c).datum
  rademacher_kloosterman :
    forall c, C.rademacherKernelWitness.expansion.kloostermanAt c =
      (C.rademacherKernelWitness.kernelCertificate c).certifiedSum
  rademacher_bessel_term :
    forall c, C.linkedRademacherWitness.expansion.term c =
      (C.linkedRademacherWitness.termCertificate c).data.amplitude *
        BesselIHalfModel
          (C.linkedRademacherWitness.termCertificate c).data.besselArgument
  rademacher_truncation_one :
    C.linkedRademacherWitness.expansion.truncation 1 =
      (C.linkedRademacherWitness.termCertificate 0).data.value
  rademacher_tail :
    forall n, C.rademacherWitness.tail.cutoff <= n ->
      |C.rademacherWitness.remainder n| <=
        C.rademacherWitness.tail.C *
          Real.exp
            (-C.rademacherWitness.tail.lambda * Real.sqrt (n : Real))
  rademacher_tail_envelope_nonneg :
    forall n, 0 <= C.rademacherWitness.tail.C *
      Real.exp
        (-C.rademacherWitness.tail.lambda * Real.sqrt (n : Real))
  degeneracy_channel :
    forall n, C.degeneracyWitness.value n = C.qSeriesWitness.coeff n
  effective_cardy_formula :
    effectiveCardyConstant C.entropyWitness.alpha =
      6 * (C.entropyWitness.alpha / 2) ^ 2 / (Real.pi ^ 2)
  effective_cardy_nonneg :
    0 <= effectiveCardyConstant C.entropyWitness.alpha
  spt_modular_ideal_generator :
    (modularIdeal C.sptIdealWitness.spt.M).generator =
      C.sptIdealWitness.spt.M
  spt_padic_ideal_generator :
    (padicIdeal C.sptIdealWitness.spt.p
      C.sptIdealWitness.spt.k).generator =
        C.sptIdealWitness.spt.p ^ C.sptIdealWitness.spt.k
  spt_equalizer_lcm :
    Dvd.dvd (Nat.lcm C.sptWitness.M (C.sptWitness.p ^ C.sptWitness.k))
      C.sptWitness.equalizerElement
  spt_intersection :
    ((modularIdeal C.sptIdealWitness.spt.M).intersection
        (padicIdeal C.sptIdealWitness.spt.p
          C.sptIdealWitness.spt.k)).Contains
      C.sptIdealWitness.spt.equalizerElement
  spt_failure_locus :
    (modularIdeal C.sptIdealWitness.spt.M).failureLocus
        (padicIdeal C.sptIdealWitness.spt.p
          C.sptIdealWitness.spt.k) =
      Nat.gcd C.sptIdealWitness.spt.M
        (C.sptIdealWitness.spt.p ^ C.sptIdealWitness.spt.k)
  crt_portfolio :
    forall i : Fin C.crtWitness.moduliCount,
      NatCongruent (C.crtWitness.modulus i)
        C.crtWitness.candidate (C.crtWitness.residue i)
  crt_pairwise :
    forall i j : Fin C.crtWitness.moduliCount,
      PairCompatible (C.crtWitness.modulus i) (C.crtWitness.modulus j)
        (C.crtWitness.residue i) (C.crtWitness.residue j)
  tor_surrogate_order :
    C.torWitness.quotientOrder =
      Nat.gcd C.sptWitness.M (C.sptWitness.p ^ C.sptWitness.k)
  tor_order_matches_spt :
    C.torWitness.quotientOrder = C.sptWitness.obstruction.order
  tor_left_cyclic :
    C.torWitness.leftQuotient.modulus = C.sptWitness.M
  tor_right_cyclic :
    C.torWitness.rightQuotient.modulus = C.sptWitness.p ^ C.sptWitness.k
  tor_obstruction_cyclic :
    C.torWitness.obstructionQuotient.order =
      Nat.gcd C.sptWitness.M (C.sptWitness.p ^ C.sptWitness.k)
  padic_normalization :
    forall n, IntCongruent (PrimePower C.padicWitness.p C.padicWitness.k)
      (C.padicWitness.normalized n) (C.padicWitness.raw n)
  padic_finite :
    forall n, FiniteCongruenceMod C.padicWitness.p C.padicWitness.k
      (C.padicWitness.normalized n) (C.padicWitness.raw n)
  mahler_finite :
    forall n, IntCongruent (PrimePower C.mahlerWitness.p C.mahlerWitness.k)
      (C.mahlerWitness.eval n) (C.mahlerWitness.target n)
  mahler_finite_formula :
    forall n, C.mahlerWitness.eval n =
      Finset.univ.sum
        (fun j : Fin C.mahlerWitness.length =>
          C.mahlerWitness.coeff j * C.mahlerWitness.basis j n)
  mahler_binomial :
    forall n, FiniteCongruenceMod C.mahlerBinomialWitness.p
      C.mahlerBinomialWitness.k
      (C.mahlerBinomialWitness.eval n)
      (C.mahlerBinomialWitness.target n)
  mahler_binomial_formula :
    forall n, C.mahlerBinomialWitness.eval n =
      Finset.univ.sum
        (fun j : Fin C.mahlerBinomialWitness.length =>
          C.mahlerBinomialWitness.coeff j *
            mahlerBinomialBasis (j : Nat) n)
  rational_ols_prediction :
    forall i : Fin C.olsWitness.points,
      C.olsWitness.predictedAt i =
        C.olsWitness.alphaHat * (C.olsWitness.point i).xSqrt -
          (1 / 2 : Rat) * (C.olsWitness.point i).xLog +
            C.olsWitness.betaHat
  rational_ols_formula :
    forall i : Fin C.olsWitness.points,
      C.olsWitness.residual i =
        (C.olsWitness.point i).yLogAbsCoeff -
          (C.olsWitness.alphaHat * (C.olsWitness.point i).xSqrt -
            (1 / 2 : Rat) * (C.olsWitness.point i).xLog +
              C.olsWitness.betaHat)
  rational_ols_decomposition :
    forall i : Fin C.olsWitness.points,
      C.olsWitness.residual i =
        (C.olsWitness.point i).yLogAbsCoeff -
          C.olsWitness.predictedAt i
  rational_ols_alpha :
    C.olsWitness.alphaInterval.Contains C.olsWitness.alphaHat
  rational_ols_beta :
    C.olsWitness.betaInterval.Contains C.olsWitness.betaHat
  rational_ols_residual_nonneg :
    0 <= C.olsWitness.residualBound
  rational_ols_residual :
    forall i : Fin C.olsWitness.points,
      |C.olsWitness.residual i| <= C.olsWitness.residualBound
  rational_ols_abs_residual_nonneg :
    forall i : Fin C.olsWitness.points,
      0 <= |C.olsWitness.residual i|

