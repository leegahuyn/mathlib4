    Filter.Tendsto
      (fun n =>
        Real.log |a n| - alpha * Real.sqrt (n : Real) +
          (1 / 2 : Real) * Real.log (n : Real))
      Filter.atTop (nhds beta) :=
  L.mock1EntropyIntercept h

