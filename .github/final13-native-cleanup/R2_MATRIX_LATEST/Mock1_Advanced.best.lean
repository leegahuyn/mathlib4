/-!
F-stage paper-table completion layer.

The reference table data is already stored as rational Lean values above.  This
layer records the checklist for the paper-table pass: parameter rows,
diagnostic residual rows, rational interval thresholds, finite rechecking, and
the external script output converted into a Lean list certificate.
-/

inductive PaperTablesFRequirement where
  | parameterTableSchema
  | residualTableSchema
  | rationalPassFailIntervals
  | rowModeAnnotations
  | finiteTableRecheckBoundary
  | externalScriptListCertificate
  | paperRowsConvertedIntoCert
  | rationalOnlyNumerics
deriving DecidableEq, Repr

namespace PaperTablesFRequirement

def all : List PaperTablesFRequirement :=
  [ parameterTableSchema
  , residualTableSchema
  , rationalPassFailIntervals
  , rowModeAnnotations
  , finiteTableRecheckBoundary
  , externalScriptListCertificate
  , paperRowsConvertedIntoCert
  , rationalOnlyNumerics
  ]

theorem all_length :
    all.length = 8 := by
  rfl

theorem mem_all (r : PaperTablesFRequirement) :
    List.Mem r all := by
  cases r with
  | parameterTableSchema => exact List.Mem.head _
  | residualTableSchema => exact List.Mem.tail _ (List.Mem.head _)
  | rationalPassFailIntervals =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))
  | rowModeAnnotations =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
  | finiteTableRecheckBoundary =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.head _))))
  | externalScriptListCertificate =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))))
  | paperRowsConvertedIntoCert =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))))
  | rationalOnlyNumerics =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
          (List.Mem.tail _ (List.Mem.head _)))))))

end PaperTablesFRequirement

