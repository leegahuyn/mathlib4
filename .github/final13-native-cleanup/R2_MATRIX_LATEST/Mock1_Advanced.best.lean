theorem appell_u0_v0_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    u0 tau - v0 tau = frozenZ0 :=
  M.definitions.appell_u0_v0 tau

theorem appell_mu_specialization_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    B.checklist.appellLerchWitness.specializedMu tau =
      B.checklist.appellLerchWitness.mu (u0 tau) (v0 tau) tau :=
  M.definitions.appell_mu_specialization tau

theorem appell_muHat_u0_v0_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    B.checklist.appellLerchWitness.specializedMuHat tau =
      B.checklist.appellLerchWitness.muHat (u0 tau) (v0 tau) tau :=
  M.definitions.appell_muHat_u0_v0 tau

theorem appell_muHat_general_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (u v : Complex)
    (tau : UpperHalfPlanePoint) :
    B.checklist.appellLerchWitness.muHat u v tau =
      B.checklist.appellLerchWitness.mu u v tau +
        (Complex.I / 2) *
          B.checklist.appellLerchWitness.R (u - v) tau :=
  M.definitions.appell_muHat_general u v tau

theorem appell_completion_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    B.checklist.appellLerchWitness.completionTerm tau =
      (Complex.I / 2) * B.checklist.appellLerchWitness.R frozenZ0 tau :=
  M.definitions.appell_completion tau

theorem appell_muHat_completion_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    B.checklist.appellLerchWitness.specializedMuHat tau =
      B.checklist.appellLerchWitness.specializedMu tau +
        B.checklist.appellLerchWitness.completionTerm tau :=
  M.definitions.appell_muHat_completion tau

