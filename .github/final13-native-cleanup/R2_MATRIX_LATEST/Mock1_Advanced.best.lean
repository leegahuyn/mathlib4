    (I : AdvancedClaimsIIRamanujanFExactCoefficientProofInput)
    (n : Nat)
    (hroot : I.rootNumber n = -1) :
    I.centralLValue n = 0 /\
      referenceAdvancedClaimsIIRamanujanFPaperObject.coeff n = 0 :=
  And.intro (I.negative_root_central_vanishing n hroot)
    (I.negative_root_coefficient_vanishing n hroot)

