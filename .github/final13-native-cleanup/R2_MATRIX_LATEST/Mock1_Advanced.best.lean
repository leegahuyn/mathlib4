        AdvancedClaimsIIRequirement.all.length = 54 /\
          AdvancedClaimsIIPromptBullet.all.length +
            AdvancedClaimsIIRequirement.finalInstanceRequirements.length =
              AdvancedClaimsIIRequirement.all.length :=
  And.intro E.prompt_bullet_count
    (And.intro E.final_requirement_count
      (And.intro E.all_requirements_length E.count_balance))

end AdvancedClaimsIIEndToEndChecklistClosureCertificate

namespace AdvancedClaimsIICompletionCertificate

def endToEndChecklistClosure
    (C : AdvancedClaimsIICompletionCertificate) :
    AdvancedClaimsIIEndToEndChecklistClosureCertificate C where
  objective_crosswalk := C.objectiveCrosswalk
  requirement_dispatch := C.requirementDispatch
  prompt_objective_audit := C.promptObjectiveAudit
  explicit_completion := C.explicitChecklistCompletion
  prompt_requirement_bridge := C.promptRequirementBridge
  claim_group_leaf_statements := C.claimGroupLeafStatements
  actual_input_audit := C.actualInputAudit
  rlf_end_to_end_closure := C.rlfEndToEndClosure
  all_requirements_listed := C.covers_at
  all_requirements_leaf := C.requirementDispatch.leaf_statement_at
  grouped_requirements_eq_all :=
    AdvancedClaimsIIRequirement.groupedRequirements_eq_all
  all_requirements_length := AdvancedClaimsIIRequirement.all_length
  all_requirements_nodup := AdvancedClaimsIIRequirement.all_nodup
  prompt_bullet_all := AdvancedClaimsIIPromptBullet.mem_all
  prompt_bullet_count := AdvancedClaimsIIPromptBullet.all_length
  prompt_bullet_nodup := AdvancedClaimsIIPromptBullet.all_nodup
  prompt_bullet_requirement_listed := by
    intro b
    exact C.covers_at (AdvancedClaimsIIPromptBullet.requirementOf b)
  prompt_bullet_leaf := C.promptBulletLeafBridge.leaf_statement_certificate_covers
  final_requirement_count :=
    AdvancedClaimsIIRequirement.grouped_lengths.2.2.2.2.2.2.2
  final_requirement_nodup :=
    AdvancedClaimsIIRequirement.finalInstanceRequirements_nodup
  final_requirement_leaf := C.claimGroupLeafStatements.final_instance_leaf
  remaining_claim_listed := C.remainingClaimStageIIBridge.registry_claims
  remaining_requirement_listed :=
    C.remainingClaimStageIIBridge.stage_requirements
  remaining_requirement_leaf := by
    intro claim
    exact C.requirementDispatch.leaf_statement_at
      (RemainingAdvancedClaim.stageIIRequirement claim)
  count_balance := by
    decide

theorem end_to_end_checklist_closure_at
    (C : AdvancedClaimsIICompletionCertificate) :
    AdvancedClaimsIIEndToEndChecklistClosureCertificate C :=
  C.endToEndChecklistClosure

