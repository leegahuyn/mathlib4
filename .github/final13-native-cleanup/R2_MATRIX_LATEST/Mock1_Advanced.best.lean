        E.readiness.completeness.manifest.bundle.checklist.olsWitness.alphaHat /\
      E.readiness.completeness.manifest.bundle.checklist.olsWitness.betaInterval.Contains
        E.readiness.completeness.manifest.bundle.checklist.olsWitness.betaHat :=
  L.ols_interval

