/-!
Paper I.2 normalization and tail audit.

The finite Mahler table on `0 <= n <= 5` is exact.  Two later prose claims
need additional hypotheses: multiplication by a denominator preserves a
coefficient modulo `p^k` only when the resulting error is divisible by
`p^k`, and the displayed extrapolated values are not themselves in
`25 Z_5`.  The following lemmas record the exact congruence criterion and
the five finite counterexamples without promoting the analytic tail claim.
-/

theorem advanced_claims_ii_paper_i2_scaled_congruence_iff
    (p k : Nat) (d a : Int) :
    FiniteCongruenceMod p k (d * a) a <->
      (PrimePower p k : Int) ∣ (d - 1) * a := by
  unfold FiniteCongruenceMod IntCongruent
  constructor <;> intro h
  · simpa [sub_mul] using h
  · simpa [sub_mul] using h

theorem advanced_claims_ii_paper_i2_scaled_congruence_of_multiplier_one
    (p k : Nat) (d a : Int)
    (hd : FiniteCongruenceMod p k d 1) :
    FiniteCongruenceMod p k (d * a) a := by
  rw [advanced_claims_ii_paper_i2_scaled_congruence_iff]
  unfold FiniteCongruenceMod IntCongruent at hd
  rcases hd with ⟨t, ht⟩
  refine ⟨t * a, ?_⟩
  calc
    (d - 1) * a = ((PrimePower p k : Int) * t) * a := by rw [ht]
    _ = (PrimePower p k : Int) * (t * a) := by ring

def AdvancedClaimsIIPaperI2PrecisionRaisedMultiplier : Int :=
  (AdvancedClaimsIIPaperI2Prime : Int) ^
    (AdvancedClaimsIIPaperI2Precision - 1)

theorem advanced_claims_ii_paper_i2_precision_raised_multiplier_value :
    AdvancedClaimsIIPaperI2PrecisionRaisedMultiplier = 5 := by
  norm_num [AdvancedClaimsIIPaperI2PrecisionRaisedMultiplier,
    AdvancedClaimsIIPaperI2Prime, AdvancedClaimsIIPaperI2Precision]

theorem advanced_claims_ii_paper_i2_precision_raised_unit_counterexample :
    Not
      (FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
        AdvancedClaimsIIPaperI2Precision
        (AdvancedClaimsIIPaperI2PrecisionRaisedMultiplier * 1) 1) := by
  norm_num [FiniteCongruenceMod, IntCongruent, PrimePower,
    AdvancedClaimsIIPaperI2Prime, AdvancedClaimsIIPaperI2Precision,
    AdvancedClaimsIIPaperI2PrecisionRaisedMultiplier]

def AdvancedClaimsIIPaperI2ExtrapolatedIndex (i : Fin 5) : Nat :=
  (i : Nat) + 6

def AdvancedClaimsIIPaperI2ExtrapolatedValue (i : Fin 5) : Int :=
  AdvancedClaimsIIPaperI2MahlerEval
    (AdvancedClaimsIIPaperI2ExtrapolatedIndex i)

def AdvancedClaimsIIPaperI2ExtrapolatedResidue (i : Fin 5) : Int :=
  AdvancedClaimsIIPaperI2ExtrapolatedValue i %
    (PrimePower AdvancedClaimsIIPaperI2Prime
      AdvancedClaimsIIPaperI2Precision : Int)

def AdvancedClaimsIIPaperI2PrecisionTube (value : Int) : Prop :=
  FiniteCongruenceMod AdvancedClaimsIIPaperI2Prime
    AdvancedClaimsIIPaperI2Precision value 0

theorem advanced_claims_ii_paper_i2_extrapolated_value_table :
    List.ofFn AdvancedClaimsIIPaperI2ExtrapolatedValue =
      [9, 1, 7, 14, 24] := by
  decide

theorem advanced_claims_ii_paper_i2_extrapolated_residue_table :
    List.ofFn AdvancedClaimsIIPaperI2ExtrapolatedResidue =
      [9, 1, 7, 14, 24] := by
  decide

theorem advanced_claims_ii_paper_i2_extrapolated_not_in_precision_tube
    (i : Fin 5) :
    Not
      (AdvancedClaimsIIPaperI2PrecisionTube
        (AdvancedClaimsIIPaperI2ExtrapolatedValue i)) := by
  fin_cases i <;>
    norm_num [Nat.choose, Fin.sum_univ_succ, Finset.sum_range_succ,
      AdvancedClaimsIIPaperI2PrecisionTube,
      AdvancedClaimsIIPaperI2ExtrapolatedValue,
      AdvancedClaimsIIPaperI2ExtrapolatedIndex,
      AdvancedClaimsIIPaperI2MahlerEval,
      AdvancedClaimsIIPaperI2MahlerRawEval,
      AdvancedClaimsIIPaperI2MahlerCoefficient,
      mahlerBinomialBasis, FiniteCongruenceMod, IntCongruent,
      PrimePower, AdvancedClaimsIIPaperI2Prime,
      AdvancedClaimsIIPaperI2Precision]

theorem advanced_claims_ii_paper_i2_claimed_extrapolation_tube_false :
    Not
      (forall i : Fin 5,
        AdvancedClaimsIIPaperI2PrecisionTube
          (AdvancedClaimsIIPaperI2ExtrapolatedValue i)) := by
  intro h
  exact
    advanced_claims_ii_paper_i2_extrapolated_not_in_precision_tube
      (0 : Fin 5) (h (0 : Fin 5))

