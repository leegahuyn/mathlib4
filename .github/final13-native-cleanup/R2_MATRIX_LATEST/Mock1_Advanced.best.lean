end PrincipalPartAssemblyCertificate

structure AbstractVerification where
  abstract : AbstractCertificate Unit
  concrete : ConcreteCertificate Unit
  concrete_to_abstract :
    concrete.toAbstractCertificate = abstract
  claim : AdvancedClaim
  blockLabel : AppellLerchBlockLabel
  blockLabel_claim_eq :
    blockLabel.claim = claim
  extraction : NegativeQOrderExtractionBoundary
  assembly : PrincipalPartAssemblyCertificate
  assembly_profile_eq_extraction :
    assembly.profile = extraction.profile
  assembly_theorem :
    MatVecRat assembly.matrix assembly.solution = assembly.rhs

namespace AbstractVerification

theorem concrete_to_abstract_at (V : AbstractVerification) :
    V.concrete.toAbstractCertificate = V.abstract :=
  V.concrete_to_abstract

theorem block_label_claim_at (V : AbstractVerification) :
    V.blockLabel.claim = V.claim :=
  V.blockLabel_claim_eq

theorem assembly_profile_at (V : AbstractVerification) :
    V.assembly.profile = V.extraction.profile :=
  V.assembly_profile_eq_extraction

theorem assembly_theorem_at (V : AbstractVerification) :
    MatVecRat V.assembly.matrix V.assembly.solution = V.assembly.rhs :=
  V.assembly_theorem

end AbstractVerification

