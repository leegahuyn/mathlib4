/-!
Paper I.2 finite/analytic evidence split.

The worked parameter, denominator, chart, and Mahler tables are finite exact
data.  Uniform tail divisibility and descent to a global p-adic analytic face
remain analytic boundaries.  The input audit additionally prevents the five
displayed extrapolated residues from being used as a proof of tail zero.
-/

structure AdvancedClaimsIIPAdicPaperFiniteAnalyticSplitCertificate : Prop where
  paper_i2_input_audit :
    AdvancedClaimsIIPaperI2PAdicInputAuditCertificate
  paper_input_gap :
    Not
        (AdvancedClaimsIIPaperI2InputManifest.Complete
          referenceAdvancedClaimsIIPaperI2InputManifest) /\
      (forall n : Nat,
        referenceAdvancedClaimsIIPaperI2Normalization.normalized n =
          referenceAdvancedClaimsIIPaperI2Normalization.raw n) /\
        (forall n : Nat,
          referenceAdvancedClaimsIIPaperI2Chart.chartLeft n =
            referenceAdvancedClaimsIIPaperI2Chart.chartRight n)
  extrapolated_tail_refutation :
    List.ofFn AdvancedClaimsIIPaperI2ExtrapolatedResidue =
          [9, 1, 7, 14, 24] /\
      (forall i : Fin 5,
        Not
          (AdvancedClaimsIIPaperI2PrecisionTube
            (AdvancedClaimsIIPaperI2ExtrapolatedValue i))) /\
        Not
          (forall i : Fin 5,
            AdvancedClaimsIIPaperI2PrecisionTube
              (AdvancedClaimsIIPaperI2ExtrapolatedValue i))
  normalization_finite_exact :
    AdvancedClaimsIIRequirement.padicNormalizationWrapper.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  overlap_finite_exact :
    AdvancedClaimsIIRequirement.padicOverlapGluingWrapper.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  mahler_finite_exact :
    AdvancedClaimsIIRequirement.mahlerInterpolationWrapper.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  denominator_finite_exact :
    AdvancedClaimsIIRequirement.denominatorClearingData.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  chart_vectors_finite_exact :
    AdvancedClaimsIIRequirement.chartVectorsModuloPrimePower.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  mahler_table_finite_exact :
    AdvancedClaimsIIRequirement.mahlerTableInterpolationVector.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  range_predicate_finite_exact :
    AdvancedClaimsIIRequirement.analyticRangePredicate.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  obstruction_case_finite_exact :
    AdvancedClaimsIIRequirement.obstructionFailureCaseInstance.evidenceClass =
      AdvancedClaimsIIEvidenceClass.finiteExact
  tail_zero_analytic :
    AdvancedClaimsIIRequirement.analyticRangeTailZeroWrapper.evidenceClass =
      AdvancedClaimsIIEvidenceClass.analyticBoundary
  global_face_analytic :
    AdvancedClaimsIIRequirement.globalPadicFaceTracking.evidenceClass =
      AdvancedClaimsIIEvidenceClass.analyticBoundary

