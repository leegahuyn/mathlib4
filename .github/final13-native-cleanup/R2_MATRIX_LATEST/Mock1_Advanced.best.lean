    exact I.regression.actual_degeneracy_at i
  referenceManifestIncomplete :=
    advanced_claims_ii_entropy_paper_input_manifest_incomplete

/-!
Actual Ramanujan certificate assembly.

The generic `AbstractCertificate` predates the paper's three-regressor
entropy model: its logarithmic slope is fixed at `-1/2`, whereas Table 6 has
an independently certified beta interval.  The paper interval does not
contain `-1/2`.  The actual certificate below therefore keeps the paper
model and the legacy generic model in separate, explicitly audited layers.
No analytic field is filled by a reference placeholder.
-/

def AdvancedClaimsIILegacyEntropyLogSlope : Rat :=
  (-1 : Rat) / 2

theorem advanced_claims_ii_ramanujan_f_paper_beta_excludes_legacy_slope :
    Not
      (referenceBetaInterval.Contains
        AdvancedClaimsIILegacyEntropyLogSlope) := by
  norm_num [RationalInterval.Contains, referenceBetaInterval,
    closedRatInterval, AdvancedClaimsIILegacyEntropyLogSlope]

structure AdvancedClaimsIIRamanujanFActualAbstractCertificate
    (ConvergesAt : CuspLabel -> Prop) where
  sourceName : String
  replacementPlan : String
  t1t5 :
    AdvancedClaimsIIRamanujanFGlobalInsideOutsideProofInput ConvergesAt
  exactCoefficient :
    AdvancedClaimsIIRamanujanFExactCoefficientProofInput
  padicAnalyticRange :
    AdvancedClaimsIIRamanujanFPAdicAnalyticRangeProofInput
  entropy :
    AdvancedClaimsIIRamanujanFEntropyAsymptoticProofInput
  sourceName_nonempty :
    Not (sourceName = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  entropy_exact_matches :
    entropy.exactCoefficient = exactCoefficient

