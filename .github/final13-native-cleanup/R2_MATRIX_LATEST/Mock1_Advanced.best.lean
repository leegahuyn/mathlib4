def transports {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt) :
    List TransportedPrincipalPart :=
  referenceAdvancedClaimsIIPaperItem1Cusps.map I.transportAt

def toFamily {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt) :
    CuspTransportFamilyCert where
  transports := I.transports
  stacked := referenceAdvancedClaimsIIRamanujanFPaperCuspStackedSystem
  rowCount_eq_transports := by
    simp [transports,
      referenceAdvancedClaimsIIRamanujanFPaperCuspStackedSystem]
  all_preserve_rows := by
    intro T hT
    exact T.preservesRows

theorem transport_count_at {ConvergesAt : CuspLabel -> Prop}
