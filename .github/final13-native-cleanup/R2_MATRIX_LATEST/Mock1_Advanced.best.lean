    Not (sourceName = "")
  mainLower_pos :
    0 < mainLower
  tailUpper_nonnegative :
    0 <= tailUpper
  ratioUpper_nonnegative :
    0 <= ratioUpper
  tail_le_ratio_main :
    tailUpper <= ratioUpper * mainLower
  ratio_le_threshold :
    ratioUpper <= dominanceThreshold
  threshold_lt_one :
    dominanceThreshold < 1

namespace RationalTailDominanceCertificate

theorem source_nonempty_at
    (C : RationalTailDominanceCertificate) :
