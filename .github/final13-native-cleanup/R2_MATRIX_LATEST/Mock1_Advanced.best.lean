def primaryRequirement : AxiomAuditLayer -> RequirementKey
  | domain => RequirementKey.domain_q_cusp
  | qseries => RequirementKey.qseries_principal_polar
  | muKernel => RequirementKey.appell_completion_shadow
  | slash => RequirementKey.slash_transport
  | linear => RequirementKey.linear_systems
  | entropy => RequirementKey.entropy_asymptotic
  | rademacher => RequirementKey.rademacher_expansion
  | degeneracy => RequirementKey.degeneracy_cardy
  | sptTor => RequirementKey.spt_crt
  | padicMahler => RequirementKey.padic_mahler
  | regression => RequirementKey.rational_ols
  | coverage => RequirementKey.abstract_concrete_chain
  | reference => RequirementKey.abstract_concrete_chain

def requiredKeys : AxiomAuditLayer -> List RequirementKey
  | domain => [RequirementKey.domain_q_cusp]
  | qseries => [RequirementKey.qseries_principal_polar]
  | muKernel =>
      [RequirementKey.appell_completion_shadow,
        RequirementKey.xi_operator]
  | slash => [RequirementKey.slash_transport]
  | linear => [RequirementKey.linear_systems]
  | entropy => [RequirementKey.entropy_asymptotic]
  | rademacher => [RequirementKey.rademacher_expansion]
  | degeneracy => [RequirementKey.degeneracy_cardy]
  | sptTor =>
      [RequirementKey.spt_crt,
        RequirementKey.tor_surrogate]
  | padicMahler => [RequirementKey.padic_mahler]
  | regression => [RequirementKey.rational_ols]
  | coverage => [RequirementKey.abstract_concrete_chain]
  | reference => [RequirementKey.abstract_concrete_chain]

theorem requiredKeys_length_pos (layer : AxiomAuditLayer) :
    0 < (requiredKeys layer).length := by
  cases layer <;> simp [requiredKeys]

theorem primaryRequirement_mem_requiredKeys
    (layer : AxiomAuditLayer) :
    List.Mem (primaryRequirement layer) (requiredKeys layer) := by
  cases layer <;> exact List.Mem.head _

theorem primaryRequirement_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequirementCoverageMatrix B)
    (layer : AxiomAuditLayer) :
    RequirementKey.Covered B (primaryRequirement layer) :=
  M.covered (primaryRequirement layer)

theorem requiredKey_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequirementCoverageMatrix B)
    (layer : AxiomAuditLayer) (key : RequirementKey)
    (_hmem : List.Mem key (requiredKeys layer)) :
    RequirementKey.Covered B key :=
  M.covered key

end AxiomAuditLayer

