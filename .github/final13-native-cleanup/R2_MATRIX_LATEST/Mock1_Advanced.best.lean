structure UnconditionalCertificationBundle (X : Type*) where
  abstract : AbstractCertificate X
  concrete : ConcreteCertificate X
  checklist : FormalizationChecklist
  concrete_extends_abstract :
    concrete.toAbstractCertificate = abstract
  checklist_object :
    checklist.paperObjectWitness = abstract.object
  checklist_qseries_object :
    checklist.objectQSeriesWitness.object = abstract.object
  infrastructure : InfrastructureComplete checklist
  objective : ObjectiveCoverage checklist
  definitions : DefinitionCoverage checklist

namespace UnconditionalCertificationBundle

theorem concrete_is_abstract {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    B.concrete.toAbstractCertificate = B.abstract :=
  B.concrete_extends_abstract

theorem infrastructure_complete {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    InfrastructureComplete B.checklist :=
  B.infrastructure

theorem objective_coverage {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    ObjectiveCoverage B.checklist :=
  B.objective

theorem definition_coverage {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    DefinitionCoverage B.checklist :=
  B.definitions

theorem checklist_object_matches {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    B.checklist.paperObjectWitness = B.abstract.object :=
  B.checklist_object

theorem checklist_qseries_object_matches {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    B.checklist.objectQSeriesWitness.object = B.abstract.object :=
  B.checklist_qseries_object

theorem proof_payload {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    CertificateProofPayload B.abstract B.concrete where
  abstractPayload := AbstractCertificate.proof_payload B.abstract
  concretePayload := ConcreteCertificate.proof_payload B.concrete
  concreteExtends := B.concrete_extends_abstract

theorem entropy_explicit {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    EntropyGrowthEpsilonN B.checklist.qSeriesWitness.coeff
      B.checklist.entropyWitness.alpha B.checklist.entropyWitness.beta :=
  B.definitions.entropy_epsilonN

theorem rademacher_tail {X : Type*}
    (B : UnconditionalCertificationBundle X) {n : Nat}
    (hn : B.checklist.rademacherWitness.tail.cutoff <= n) :
    |B.checklist.rademacherWitness.remainder n| <=
      B.checklist.rademacherWitness.tail.C *
        Real.exp
          (-B.checklist.rademacherWitness.tail.lambda *
            Real.sqrt (n : Real)) :=
  B.definitions.rademacher_tail n hn

theorem q_parameter_exp {X : Type*}
    (B : UnconditionalCertificationBundle X) (tau : UpperHalfPlanePoint) :
    qParameter tau =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z) :=
  B.definitions.q_parameter_exp tau

theorem cusp_route_matrix {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    B.checklist.cuspTransportCertificate.transport.matrix =
      B.checklist.cuspMatrixWitness :=
  B.definitions.cusp_route_matrix

theorem rademacher_bessel_term {X : Type*}
    (B : UnconditionalCertificationBundle X) (c : Nat) :
    B.checklist.linkedRademacherWitness.expansion.term c =
      (B.checklist.linkedRademacherWitness.termCertificate c).data.amplitude *
        BesselIHalfModel
          (B.checklist.linkedRademacherWitness.termCertificate c).data.besselArgument :=
  B.definitions.rademacher_bessel_term c

theorem tor_obstruction_cyclic {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    B.checklist.torWitness.obstructionQuotient.order =
      Nat.gcd B.checklist.sptWitness.M
        (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k) :=
  B.definitions.tor_obstruction_cyclic

theorem effective_cardy_formula {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    MockCert.effectiveCardyConstant B.checklist.entropyWitness.alpha =
      6 * (B.checklist.entropyWitness.alpha / 2) ^ 2 / (Real.pi ^ 2) :=
  B.definitions.effective_cardy_formula

theorem mahler_finite_formula {X : Type*}
    (B : UnconditionalCertificationBundle X) (n : Nat) :
    B.checklist.mahlerWitness.eval n =
      Finset.univ.sum
        (fun j : Fin B.checklist.mahlerWitness.length =>
          B.checklist.mahlerWitness.coeff j *
            B.checklist.mahlerWitness.basis j n) :=
  B.definitions.mahler_finite_formula n

theorem rational_ols_formula {X : Type*}
    (B : UnconditionalCertificationBundle X)
    (i : Fin B.checklist.olsWitness.points) :
    B.checklist.olsWitness.residual i =
      (B.checklist.olsWitness.point i).yLogAbsCoeff -
        (B.checklist.olsWitness.alphaHat *
            (B.checklist.olsWitness.point i).xSqrt -
          (1 / 2 : Rat) * (B.checklist.olsWitness.point i).xLog +
            B.checklist.olsWitness.betaHat) :=
  B.definitions.rational_ols_formula i

end UnconditionalCertificationBundle

structure ProofFieldDischargeMatrix {X : Type*}
    (B : UnconditionalCertificationBundle X) : Prop where
  certificatePayload :
    CertificateProofPayload B.abstract B.concrete
  abstractPayload :
    AbstractProofPayload B.abstract
  concretePayload :
    ConcreteProofPayload B.concrete
  abstractEntropyTendsto :
    EntropyGrowth B.abstract.object.coeff B.abstract.alpha B.abstract.beta
  abstractEntropyEpsilonN :
    EntropyGrowthEpsilonN B.abstract.object.coeff
      B.abstract.alpha B.abstract.beta
  abstractEntropyLittleO :
    EntropyGrowthLittleOOne B.abstract.object.coeff
      B.abstract.alpha B.abstract.beta
  abstractQSeriesObject :
    B.abstract.qSeriesCertificate.object = B.abstract.object
  abstractRegressionInterval :
    B.abstract.regression.alphaInterval.Contains
        B.abstract.regression.alphaHat /\
      B.abstract.regression.betaInterval.Contains
        B.abstract.regression.betaHat
  concreteExtends :
    B.concrete.toAbstractCertificate = B.abstract
  concreteCarriesAbstract :
    AbstractProofPayload B.concrete.toAbstractCertificate
  concretePrincipalPart :
    forall i : Fin B.concrete.principalPartLink.principal.order,
      B.concrete.principalPartLink.principal.coeffAt i =
        B.concrete.principalPartLink.laurent.coeff
          (-(((i : Nat) + 1 : Nat) : Int))
  concreteLinearComplex :
    forall i : Fin B.concrete.intervalSystemComplex.system.rows,
      (B.concrete.intervalSystemComplex.residual i).Contains 0
  concreteSPTEqualizer :
    ArithmeticEqualizer B.concrete.sptIdeal.spt.M
      (B.concrete.sptIdeal.spt.p ^ B.concrete.sptIdeal.spt.k)
      B.concrete.sptIdeal.spt.equalizerElement
  concreteTorCyclic :
    B.concrete.torSurrogate.obstructionQuotient.order =
      Nat.gcd B.concrete.spt.M
        (B.concrete.spt.p ^ B.concrete.spt.k)
  concreteRationalOLSInterval :
    B.concrete.rationalOLS.alphaInterval.Contains
        B.concrete.rationalOLS.alphaHat /\
      B.concrete.rationalOLS.betaInterval.Contains
        B.concrete.rationalOLS.betaHat
  checklistObject :
    B.checklist.paperObjectWitness = B.abstract.object
  checklistDefinitions :
    DefinitionCoverage B.checklist

namespace ProofFieldDischargeMatrix

