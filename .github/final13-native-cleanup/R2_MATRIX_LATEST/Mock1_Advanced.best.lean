inductive RequirementKey where
  | domain_q_cusp
  | qseries_principal_polar
  | appell_completion_shadow
  | xi_operator
  | slash_transport
  | linear_systems
  | entropy_asymptotic
  | rademacher_expansion
  | degeneracy_cardy
  | spt_crt
  | tor_surrogate
  | padic_mahler
  | rational_ols
  | abstract_concrete_chain
deriving DecidableEq, Repr

namespace RequirementKey

def Covered {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    RequirementKey -> Prop
  | domain_q_cusp =>
      (forall tau, qParameter tau =
        Complex.exp ((((2 : Real) * Real.pi) : Complex) *
          Complex.I * tau.z)) /\
      B.checklist.cuspTransportCertificate.transport.matrix =
        B.checklist.cuspMatrixWitness
  | qseries_principal_polar =>
      (forall n, B.checklist.qSeriesWitness.coefficientAt n =
        B.checklist.qSeriesWitness.coeff n) /\
      (forall i : Fin B.checklist.principalPartLink.principal.order,
        B.checklist.principalPartLink.principal.coeffAt i =
          B.checklist.principalPartLink.laurent.coeff
            (-(((i : Nat) + 1 : Nat) : Int))) /\
      (forall i : Fin B.checklist.polarProfileLink.profile.terms,
        (B.checklist.polarProfileLink.profile.term i).exponent < 0)
  | appell_completion_shadow =>
      (forall tau,
        B.checklist.appellLerchWitness.specializedMu tau =
          B.checklist.appellLerchWitness.mu (u0 tau) (v0 tau) tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.completionTerm tau =
          (Complex.I / 2) *
            B.checklist.appellLerchWitness.R frozenZ0 tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.specializedMuHat tau =
          B.checklist.appellLerchWitness.specializedMu tau +
            B.checklist.appellLerchWitness.completionTerm tau) /\
      (forall tau,
        B.checklist.appellLerchWitness.gz tau =
          B.checklist.appellLerchWitness.unaryThetaAt frozenZ0 tau)
  | xi_operator =>
      forall tau,
        B.checklist.xiWitness.xiOperator.xi
            B.checklist.xiWitness.completedObject tau =
          B.checklist.xiWitness.scale * B.checklist.xiWitness.shadow tau
  | slash_transport =>
      B.checklist.slashGeneratorWitness.weight = halfWeight /\
      (forall f tau,
        B.checklist.slashGeneratorWitness.action.slash f ModularMatrix.T tau =
          B.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.T *
            f (B.checklist.slashGeneratorWitness.transportT.transport.act tau)) /\
      (forall f tau,
        B.checklist.slashGeneratorWitness.action.slash f ModularMatrix.S tau =
          B.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.S *
            f (B.checklist.slashGeneratorWitness.transportS.transport.act tau))
  | linear_systems =>
      (forall i, B.checklist.linearSystemIntWitness.system.matrix.mulVec
          B.checklist.linearSystemIntWitness.solution i =
        B.checklist.linearSystemIntWitness.system.rhs i) /\
      (forall i, B.checklist.linearSystemRatWitness.system.matrix.mulVec
          B.checklist.linearSystemRatWitness.solution i =
        B.checklist.linearSystemRatWitness.system.rhs i) /\
      (forall i, (B.checklist.linearSystemComplexWitness.residual i).Contains 0)
  | entropy_asymptotic =>
      EntropyGrowthEpsilonN B.checklist.qSeriesWitness.coeff
        B.checklist.entropyWitness.alpha B.checklist.entropyWitness.beta /\
      EntropyGrowthLittleOOne B.checklist.qSeriesWitness.coeff
        B.checklist.entropyWitness.alpha B.checklist.entropyWitness.beta
  | rademacher_expansion =>
      (forall n, B.checklist.qSeriesWitness.coeff n =
        (B.checklist.rademacherWitness.expansion n).truncation
          (B.checklist.rademacherWitness.cutoff n) +
            B.checklist.rademacherWitness.remainder n) /\
      (forall c, B.checklist.rademacherKernelWitness.expansion.multiplier c =
        KloostermanSum
          (B.checklist.rademacherKernelWitness.kernelCertificate c).datum) /\
      (forall c, B.checklist.rademacherKernelWitness.expansion.kloostermanAt c =
        (B.checklist.rademacherKernelWitness.kernelCertificate c).certifiedSum) /\
      (forall c, B.checklist.linkedRademacherWitness.expansion.term c =
        (B.checklist.linkedRademacherWitness.termCertificate c).data.amplitude *
          BesselIHalfModel
            (B.checklist.linkedRademacherWitness.termCertificate c).data.besselArgument) /\
      B.checklist.linkedRademacherWitness.expansion.truncation 1 =
        (B.checklist.linkedRademacherWitness.termCertificate 0).data.value /\
      (forall n, B.checklist.rademacherWitness.tail.cutoff <= n ->
        |B.checklist.rademacherWitness.remainder n| <=
          B.checklist.rademacherWitness.tail.C *
            Real.exp
              (-B.checklist.rademacherWitness.tail.lambda *
                Real.sqrt (n : Real))) /\
      (forall n, 0 <= B.checklist.rademacherWitness.tail.C *
        Real.exp
          (-B.checklist.rademacherWitness.tail.lambda *
            Real.sqrt (n : Real)))
  | degeneracy_cardy =>
      (forall n, B.checklist.degeneracyWitness.value n =
        B.checklist.qSeriesWitness.coeff n) /\
      MockCert.effectiveCardyConstant B.checklist.entropyWitness.alpha =
        6 * (B.checklist.entropyWitness.alpha / 2) ^ 2 /
          (Real.pi ^ 2) /\
      0 <= MockCert.effectiveCardyConstant B.checklist.entropyWitness.alpha
  | spt_crt =>
      Dvd.dvd
        (Nat.lcm B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k))
        B.checklist.sptWitness.equalizerElement /\
      ((modularIdeal B.checklist.sptIdealWitness.spt.M).intersection
          (padicIdeal B.checklist.sptIdealWitness.spt.p
            B.checklist.sptIdealWitness.spt.k)).Contains
        B.checklist.sptIdealWitness.spt.equalizerElement /\
      (forall i : Fin B.checklist.crtWitness.moduliCount,
        NatCongruent (B.checklist.crtWitness.modulus i)
          B.checklist.crtWitness.candidate
          (B.checklist.crtWitness.residue i)) /\
      (forall i j : Fin B.checklist.crtWitness.moduliCount,
        PairCompatible (B.checklist.crtWitness.modulus i)
          (B.checklist.crtWitness.modulus j)
          (B.checklist.crtWitness.residue i)
          (B.checklist.crtWitness.residue j))
  | tor_surrogate =>
      B.checklist.torWitness.quotientOrder =
        Nat.gcd B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k) /\
      B.checklist.torWitness.obstructionQuotient.order =
        Nat.gcd B.checklist.sptWitness.M
          (B.checklist.sptWitness.p ^ B.checklist.sptWitness.k)
  | padic_mahler =>
      (forall n, IntCongruent
        (PrimePower B.checklist.padicWitness.p
          B.checklist.padicWitness.k)
        (B.checklist.padicWitness.normalized n)
        (B.checklist.padicWitness.raw n)) /\
      (forall n, FiniteCongruenceMod B.checklist.padicWitness.p
        B.checklist.padicWitness.k
        (B.checklist.padicWitness.normalized n)
        (B.checklist.padicWitness.raw n)) /\
      (forall n, IntCongruent
        (PrimePower B.checklist.mahlerWitness.p
          B.checklist.mahlerWitness.k)
        (B.checklist.mahlerWitness.eval n)
        (B.checklist.mahlerWitness.target n)) /\
      (forall n, B.checklist.mahlerWitness.eval n =
        Finset.univ.sum
          (fun j : Fin B.checklist.mahlerWitness.length =>
            B.checklist.mahlerWitness.coeff j *
              B.checklist.mahlerWitness.basis j n)) /\
      (forall n, FiniteCongruenceMod B.checklist.mahlerBinomialWitness.p
        B.checklist.mahlerBinomialWitness.k
        (B.checklist.mahlerBinomialWitness.eval n)
        (B.checklist.mahlerBinomialWitness.target n)) /\
      (forall n, B.checklist.mahlerBinomialWitness.eval n =
        Finset.univ.sum
          (fun j : Fin B.checklist.mahlerBinomialWitness.length =>
            B.checklist.mahlerBinomialWitness.coeff j *
              mahlerBinomialBasis (j : Nat) n))
  | rational_ols =>
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.predictedAt i =
          B.checklist.olsWitness.alphaHat *
              (B.checklist.olsWitness.point i).xSqrt -
            (1 / 2 : Rat) * (B.checklist.olsWitness.point i).xLog +
              B.checklist.olsWitness.betaHat) /\
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.residual i =
          (B.checklist.olsWitness.point i).yLogAbsCoeff -
            (B.checklist.olsWitness.alphaHat *
                (B.checklist.olsWitness.point i).xSqrt -
              (1 / 2 : Rat) * (B.checklist.olsWitness.point i).xLog +
                B.checklist.olsWitness.betaHat)) /\
      (forall i : Fin B.checklist.olsWitness.points,
        B.checklist.olsWitness.residual i =
          (B.checklist.olsWitness.point i).yLogAbsCoeff -
            B.checklist.olsWitness.predictedAt i) /\
      B.checklist.olsWitness.alphaInterval.Contains
        B.checklist.olsWitness.alphaHat /\
      B.checklist.olsWitness.betaInterval.Contains
        B.checklist.olsWitness.betaHat /\
      0 <= B.checklist.olsWitness.residualBound /\
      (forall i : Fin B.checklist.olsWitness.points,
        |B.checklist.olsWitness.residual i| <=
          B.checklist.olsWitness.residualBound) /\
      (forall i : Fin B.checklist.olsWitness.points,
        0 <= |B.checklist.olsWitness.residual i|)
  | abstract_concrete_chain =>
      B.concrete.toAbstractCertificate = B.abstract /\
      B.checklist.paperObjectWitness = B.abstract.object /\
      B.checklist.objectQSeriesWitness.object = B.abstract.object

