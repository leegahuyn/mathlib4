structure RequestedDetailFinalLedger
    (E : EndToEndCertificationEvidence) : Prop where
  objective_definitions :
    ObjectiveDefinitionMatrix
      E.readiness.completeness.manifest.bundle
  qseries_truncated_prefix :
    forall n : Nat,
      n <
          E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.truncated.length ->
        E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.truncated.coefficientAt n =
          E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.full.coeff n
  qseries_truncated_eval :
    forall q : Real,
      E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.truncatedEval q =
        E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.fullPrefixEval q
  qseries_truncated_coeff_sum :
    E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.truncatedCoeffSum =
      E.readiness.completeness.manifest.bundle.checklist.qSeriesPrefixWitness.fullPrefixCoeffSum
  laurent_principal :
    forall n : Nat,
      E.readiness.completeness.manifest.bundle.checklist.laurentWitness.principalCoeff n =
        E.readiness.completeness.manifest.bundle.checklist.laurentWitness.coeff
          (-((n + 1 : Nat) : Int))
  principal_laurent_link :
    E.readiness.completeness.manifest.bundle.checklist.principalPartLink.laurent =
      E.readiness.completeness.manifest.bundle.checklist.laurentWitness
  principal_witness_link :
    E.readiness.completeness.manifest.bundle.checklist.principalPartLink.principal =
      E.readiness.completeness.manifest.bundle.checklist.principalPartWitness
  polar_profile_formula :
    forall i : Fin
        E.readiness.completeness.manifest.bundle.checklist.polarProfileLink.profile.terms,
      (E.readiness.completeness.manifest.bundle.checklist.polarProfileLink.profile.term i).exponent =
        -(((i : Nat) + 1 : Nat) : Int)
  polar_witness_link :
    E.readiness.completeness.manifest.bundle.checklist.polarProfileLink.profile =
      E.readiness.completeness.manifest.bundle.checklist.polarProfileWitness
  appell_u0_formula :
    forall tau : UpperHalfPlanePoint, u0 tau = tau.z / 2
  appell_v0_formula :
    forall tau : UpperHalfPlanePoint, v0 tau = tau.z / 2 + 1 / 2
  appell_frozen_z0_formula :
    frozenZ0 = -1 / 2
  appell_u0_v0 :
    forall tau : UpperHalfPlanePoint, u0 tau - v0 tau = frozenZ0
  appell_specialization :
    forall tau : UpperHalfPlanePoint,
      E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.specializedMu tau =
        E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.mu
          (u0 tau) (v0 tau) tau
  appell_completion :
    forall tau : UpperHalfPlanePoint,
      E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.completionTerm tau =
        (Complex.I / 2) *
          E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.R frozenZ0 tau
  appell_muHat_completion :
    forall tau : UpperHalfPlanePoint,
      E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.specializedMuHat tau =
        E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.specializedMu tau +
          E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.completionTerm tau
  appell_unary_theta_shadow :
    forall tau : UpperHalfPlanePoint,
      E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.gz tau =
        E.readiness.completeness.manifest.bundle.checklist.appellLerchWitness.unaryThetaAt
          frozenZ0 tau
  slash_T_transport :
    forall (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint),
      E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.slash
          f ModularMatrix.T tau =
        E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.T *
          f (E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.transportT.transport.act tau)
  slash_S_transport :
    forall (f : UpperHalfPlanePoint -> Complex) (tau : UpperHalfPlanePoint),
      E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.slash
          f ModularMatrix.S tau =
        E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.action.multiplier.value
            ModularMatrix.S *
          f (E.readiness.completeness.manifest.bundle.checklist.slashGeneratorWitness.transportS.transport.act tau)
  degeneracy_scalar_model :
    forall (a : Nat -> Real) (n : Nat),
      (DegeneracyChannel.scalar a).value n = a n
  degeneracy_jacobi_slice_model :
    forall (c : Int -> Real) (a : Nat -> Int -> Real) (n : Nat),
      (DegeneracyChannel.jacobiSlice c a).value n =
        (Finset.range (2 * n + 1)).sum
          (fun j => c ((j : Int) - n) * a n ((j : Int) - n))
  ols_interval :
    E.readiness.completeness.manifest.bundle.checklist.olsWitness.alphaInterval.Contains
        E.readiness.completeness.manifest.bundle.checklist.olsWitness.alphaHat /\
      E.readiness.completeness.manifest.bundle.checklist.olsWitness.betaInterval.Contains
        E.readiness.completeness.manifest.bundle.checklist.olsWitness.betaHat

