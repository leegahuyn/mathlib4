  mock_link :
    forall n, mockCoeff n = formula.mockCoeff n
  theta_link :
    forall n, thetaCoeff n = formula.thetaCoeff n
  normalized_link :
    forall n, normalizedCoeff n = formula.normalizedCoeff n
  coefficient_formula :
    forall n, normalizedCoeff n = scalar * (mockCoeff n * thetaCoeff n)
  rademacher_link :
    forall n, normalizedCoeff n =
      formula.rademacher.main n + formula.rademacher.remainder n

