def sptKernelRequirementPayload
    (C : AdvancedClaimsIICompletionCertificate) :
    SPTKernelRequirementPayloadCertificate C where
  nat_gcd_lcm_skeleton := by
    exact And.intro C.sptKernel.sptFree.gcdLcm.gcd_dvd_M_at
      (And.intro C.sptKernel.sptFree.gcdLcm.gcd_dvd_primePower_at
        (And.intro C.sptKernel.sptFree.gcdLcm.M_dvd_lcm_at
          C.sptKernel.sptFree.gcdLcm.primePower_dvd_lcm_at))
  primewise_thickness_skeleton := by
    exact And.intro C.sptKernel.sptFree.thickness.failureThickness_succ_at
      C.sptKernel.sptFree.thickness.thickness_positive_at
  actual_mpk_valuation_certificate := by
    exact And.intro C.sptKernel.sptFree.valuation.prime_at
      (And.intro C.sptKernel.sptFree.valuation_M_eq
        (And.intro C.sptKernel.sptFree.valuation_p_eq
          (And.intro C.sptKernel.sptFree.valuation.power_dvd_at
            C.sptKernel.sptFree.valuation.next_power_not_dvd_at)))
  obstruction_free_failure_portfolio := by
    exact And.intro C.sptKernel.obstruction_free_at
      (And.intro C.sptKernel.failure_not_free_at
        (And.intro C.sptKernel.sptFailure.failureThickness_eq_at
          C.sptKernel.sptFailure.valuation_positive_at))
  base_change_stability_boundary := C.sptKernel.base_change_lcm_at
  kernel_selection_certificate_boundary := by
    exact And.intro C.sptKernel.kernel_selected_level_at
      C.sptKernel.kernelSelection.record_selected_modulus_at
  finite_multiplier_phase_matching_certificate := by
    exact And.intro C.sptKernel.multiplier.root_phases_positive_at
      (And.intro C.sptKernel.multiplier.rows_length_at
        C.sptKernel.multiplier.phase_match_at)
  cusp_convergence_certificate_boundary := by
    exact And.intro C.sptKernel.cusp_convergence_passes_at
      C.sptKernel.cuspConvergence.cutoff_at
  transport_family_connection := by
    exact And.intro C.sptKernel.transport_link
      C.sptKernel.transport_rows_at
  kernel_selection_table_input := by
    exact And.intro C.sptKernel.kernelSelection.sourceName_nonempty
      (And.intro C.sptKernel.kernelSelection.selected_level_at
        C.sptKernel.kernelSelection.multiplier_rows_length_at)
  multiplier_phase_matching_input := by
    exact And.intro C.sptKernel.multiplier_link
      C.sptKernel.multiplier.rows_length_at
  cusp_convergence_proof_data_input := by
    exact And.intro C.sptKernel.convergence_link
      C.sptKernel.cusp_convergence_passes_at
  transport_across_relevant_cusps := by
    exact And.intro C.sptKernel.transport.infinity_mem_at
      (And.intro C.sptKernel.transport.zero_mem_at
        C.sptKernel.transport.preserves_rows_at)

end AdvancedClaimsIICompletionCertificate

structure ExactCoefficientRequirementPayloadCertificate
    (C : AdvancedClaimsIICompletionCertificate) : Prop where
  coefficient_separation_boundary :
    forall n, C.exact.exact.formula.coefficient n =
      C.exact.exact.separation.scalarPart n +
        C.exact.exact.separation.thetaPart n
  theta_coefficient_character_boundary :
    Not (C.exact.thetaTable.rows = []) /\
      C.exact.spectralInput.analyticBoundary.kuznetsovAccepted /\
        C.exact.spectralInput.analyticBoundary.weilBoundAccepted /\
          C.exact.spectralInput.analyticBoundary.lValueTheoryAccepted
  spectral_kloosterman_expansion_boundary :
    C.exact.spectralInput.finiteResidue.certifiedSum =
        C.exact.spectralInput.spectral.kloostermanValue /\
      forall n, C.exact.spectralInput.spectral.coefficient n =
        C.exact.spectralInput.spectral.rademacher.main n +
          C.exact.spectralInput.spectral.rademacher.remainder n
  local_euler_decomposition_boundary :
    C.exact.localRootLValueInput.localEuler.productValue = 1
  root_number_filter_boundary :
    C.exact.localRootLValueInput.rootFilter.allowed = true
  exact_coefficient_formula_boundary :
    forall n, C.exact.localRootLValueInput.formula.coefficient n =
      C.exact.localRootLValueInput.formula.globalConstant *
        C.exact.localRootLValueInput.formula.powerTerm n *
          C.exact.localRootLValueInput.formula.centralLValue n *
            C.exact.localRootLValueInput.formula.localEulerProduct n
  paper_data_formula_proof_fields :
    (forall r : ExactCoefficientERequirement, List.Mem r C.exact.requirements) /\
      (forall n, C.betaArch.betaArch.formula.normalizedCoeff n =
        C.betaArch.betaArch.scalarRecord.scalar *
          (C.betaArch.betaArch.unfolding.mockCoeff n *
            C.betaArch.betaArch.unfolding.thetaCoeff n)) /\
        (forall n, C.betaArch.betaArch.formula.normalizedCoeff n =
          C.betaArch.betaArch.formula.rademacher.main n +
            C.betaArch.betaArch.formula.rademacher.remainder n)

