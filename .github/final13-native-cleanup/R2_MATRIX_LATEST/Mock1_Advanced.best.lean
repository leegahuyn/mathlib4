  C.cuspTransport_matrix

theorem qseries_coefficient_at (C : FormalizationChecklist)
    (n : Nat) :
    C.qSeriesWitness.coefficientAt n = C.qSeriesWitness.coeff n := rfl

theorem object_qseries_object_link (C : FormalizationChecklist) :
    C.objectQSeriesWitness.object = C.paperObjectWitness :=
  C.objectQSeriesWitness_object

theorem object_qseries_series_link (C : FormalizationChecklist) :
    C.objectQSeriesWitness.series = C.qSeriesWitness :=
