structure ConcreteProofPayload {X : Type*}
    (c : ConcreteCertificate X) : Prop where
  abstractPayload :
    AbstractProofPayload c.toAbstractCertificate
  principalPart :
    forall i : Fin c.principalPartLink.principal.order,
      c.principalPartLink.principal.coeffAt i =
        c.principalPartLink.laurent.coeff
          (-(((i : Nat) + 1 : Nat) : Int))
  polarNegative :
    forall i : Fin c.polarProfileLink.profile.terms,
      (c.polarProfileLink.profile.term i).exponent < 0
  linearInt :
    forall i : Fin c.principalSystemInt.system.rows,
      c.principalSystemInt.system.matrix.mulVec
          c.principalSystemInt.solution i =
        c.principalSystemInt.system.rhs i
  linearRat :
    forall i : Fin c.intervalSystemRat.system.rows,
      c.intervalSystemRat.system.matrix.mulVec
          c.intervalSystemRat.solution i =
        c.intervalSystemRat.system.rhs i
  linearComplex :
    forall i : Fin c.intervalSystemComplex.system.rows,
      (c.intervalSystemComplex.residual i).Contains 0
  sptIntersection :
    ((modularIdeal c.sptIdeal.spt.M).intersection
        (padicIdeal c.sptIdeal.spt.p c.sptIdeal.spt.k)).Contains
      c.sptIdeal.spt.equalizerElement
  sptEqualizer :
    ArithmeticEqualizer c.sptIdeal.spt.M
      (c.sptIdeal.spt.p ^ c.sptIdeal.spt.k)
      c.sptIdeal.spt.equalizerElement
  sptFailure :
    (modularIdeal c.sptIdeal.spt.M).failureLocus
        (padicIdeal c.sptIdeal.spt.p c.sptIdeal.spt.k) =
      Nat.gcd c.sptIdeal.spt.M
        (c.sptIdeal.spt.p ^ c.sptIdeal.spt.k)
  crtCandidate :
    forall i : Fin c.crtPortfolio.moduliCount,
      NatCongruent (c.crtPortfolio.modulus i)
        c.crtPortfolio.candidate (c.crtPortfolio.residue i)
  crtPairwise :
    forall i j : Fin c.crtPortfolio.moduliCount,
      PairCompatible (c.crtPortfolio.modulus i)
        (c.crtPortfolio.modulus j)
        (c.crtPortfolio.residue i)
        (c.crtPortfolio.residue j)
  torGcd :
    c.torSurrogate.quotientOrder =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k)
  torCyclic :
    c.torSurrogate.obstructionQuotient.order =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k)
  padicOverlap :
    forall n,
      IntCongruent c.padicOverlap.M
        (c.padicOverlap.left n) (c.padicOverlap.right n) /\
        IntCongruent (PrimePower c.padicOverlap.p c.padicOverlap.k)
          (c.padicOverlap.left n) (c.padicOverlap.right n)
  mahlerFormula :
    forall n,
      c.mahler.eval n =
        Finset.univ.sum
          (fun j : Fin c.mahler.length =>
            c.mahler.coeff j * c.mahler.basis j n)
  mahlerBinomialFormula :
    forall n,
      c.mahlerBinomial.eval n =
        Finset.univ.sum
          (fun j : Fin c.mahlerBinomial.length =>
            c.mahlerBinomial.coeff j *
              mahlerBinomialBasis (j : Nat) n)
  rationalOLSFormula :
    forall i : Fin c.rationalOLS.points,
      c.rationalOLS.residual i =
        (c.rationalOLS.point i).yLogAbsCoeff -
          (c.rationalOLS.alphaHat * (c.rationalOLS.point i).xSqrt -
            (1 / 2 : Rat) * (c.rationalOLS.point i).xLog +
              c.rationalOLS.betaHat)
  rationalOLSInterval :
    c.rationalOLS.alphaInterval.Contains c.rationalOLS.alphaHat /\
      c.rationalOLS.betaInterval.Contains c.rationalOLS.betaHat
  rationalOLSResidual :
    forall i : Fin c.rationalOLS.points,
      |c.rationalOLS.residual i| <= c.rationalOLS.residualBound

namespace ConcreteProofPayload

theorem principal_part_at {X : Type*}
    {c : ConcreteCertificate X}
    (P : ConcreteProofPayload c)
    (i : Fin c.principalPartLink.principal.order) :
    c.principalPartLink.principal.coeffAt i =
      c.principalPartLink.laurent.coeff
        (-(((i : Nat) + 1 : Nat) : Int)) :=
  P.principalPart i

theorem spt_equalizer_at {X : Type*}
    {c : ConcreteCertificate X}
    (P : ConcreteProofPayload c) :
    ArithmeticEqualizer c.sptIdeal.spt.M
      (c.sptIdeal.spt.p ^ c.sptIdeal.spt.k)
      c.sptIdeal.spt.equalizerElement :=
  P.sptEqualizer

theorem tor_cyclic_at {X : Type*}
    {c : ConcreteCertificate X}
    (P : ConcreteProofPayload c) :
    c.torSurrogate.obstructionQuotient.order =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) :=
  P.torCyclic

theorem rational_ols_interval_at {X : Type*}
    {c : ConcreteCertificate X}
    (P : ConcreteProofPayload c) :
    c.rationalOLS.alphaInterval.Contains c.rationalOLS.alphaHat /\
      c.rationalOLS.betaInterval.Contains c.rationalOLS.betaHat :=
  P.rationalOLSInterval

end ConcreteProofPayload

namespace ConcreteCertificate

theorem proof_payload {X : Type*}
    (c : ConcreteCertificate X) :
    ConcreteProofPayload c where
  abstractPayload :=
    AbstractCertificate.proof_payload c.toAbstractCertificate
  principalPart := c.principal_part_link_at
  polarNegative := c.polar_profile_negative_at
  linearInt := c.principal_int_equation_at
  linearRat := c.principal_rat_equation_at
  linearComplex := c.complex_interval_residual_zero
  sptIntersection := c.spt_ideal_intersection
  sptEqualizer := c.spt_ideal_equalizer
  sptFailure := c.spt_failure_locus_eq_gcd
  crtCandidate := c.crt_portfolio_at
  crtPairwise := c.crt_portfolio_pair_compatible_at
  torGcd := c.tor_surrogate_order_eq_spt_gcd
  torCyclic := c.tor_obstruction_cyclic_order_eq_spt_gcd
  padicOverlap := c.padic_overlap_both
  mahlerFormula := c.mahler_formula
  mahlerBinomialFormula := c.mahler_binomial_formula
  rationalOLSFormula := c.rational_ols_formula_at
  rationalOLSInterval :=
    And.intro c.rational_ols_alpha_mem c.rational_ols_beta_mem
  rationalOLSResidual := c.rational_ols_residual_bound

end ConcreteCertificate

structure CertificateProofPayload {X : Type*}
    (abstract : AbstractCertificate X)
    (concrete : ConcreteCertificate X) : Prop where
  abstractPayload : AbstractProofPayload abstract
  concretePayload : ConcreteProofPayload concrete
  concreteExtends :
    concrete.toAbstractCertificate = abstract

namespace CertificateProofPayload

theorem abstract_payload_at {X : Type*}
    {A : AbstractCertificate X} {C : ConcreteCertificate X}
    (P : CertificateProofPayload A C) :
    AbstractProofPayload A :=
  P.abstractPayload

theorem concrete_payload_at {X : Type*}
    {A : AbstractCertificate X} {C : ConcreteCertificate X}
    (P : CertificateProofPayload A C) :
    ConcreteProofPayload C :=
  P.concretePayload

theorem concrete_extends_at {X : Type*}
    {A : AbstractCertificate X} {C : ConcreteCertificate X}
    (P : CertificateProofPayload A C) :
    C.toAbstractCertificate = A :=
  P.concreteExtends

end CertificateProofPayload

