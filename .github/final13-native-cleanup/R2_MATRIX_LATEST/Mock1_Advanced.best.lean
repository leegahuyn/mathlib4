    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt)
    (n : Nat) :
    referenceAdvancedClaimsIIRamanujanFPaperObject.coeff n =
      (A.exactCoefficient.rademacherExpansion.expansion n).truncation
          (A.exactCoefficient.rademacherExpansion.cutoff n) +
        A.exactCoefficient.rademacherExpansion.remainder n :=
  A.exactCoefficient.rademacher_at n

theorem padic_actual_at {ConvergesAt : CuspLabel -> Prop}
    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt)
    (n : Nat) :
    A.padicAnalyticRange.normalizedAt infinityCuspLabel n =
