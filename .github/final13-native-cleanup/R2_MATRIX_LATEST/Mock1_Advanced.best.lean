theorem requested_item_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B)
    (item : RequestedDefinitionItem) :
    RequestedDefinitionItem.Covered M.requestedAudit.checklist item :=
  M.requestedAudit.covered_at item

theorem all_requested_items_layered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B)
    (item : RequestedDefinitionItem)
    (_hmem : List.Mem item RequestedDefinitionItem.all) :
    List.Mem (RequestedDefinitionItem.primaryObjective item)
      (IntegratedLayer.objectives (M.itemLayer item)) :=
  M.objective_placed_at item

end RequestedDefinitionLayerMatrix

namespace UnconditionalCertificationBundle

theorem objective_audit_matrix {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    ObjectiveAuditMatrix B where
  requirementMatrix := B.coverage_matrix
  objectiveCovered := by
    intro item
    exact B.coverage_matrix.covered
      (ObjectiveItem.primaryRequirement item)
  allItemsCovered := by
    intro item _hmem
    exact B.coverage_matrix.covered
      (ObjectiveItem.primaryRequirement item)
  auditTargetsNonempty := ObjectiveItem.audit_targets_nonempty

theorem objective_definition_matrix {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    ObjectiveDefinitionMatrix B where
  definitions := B.definition_coverage
  objectiveMatrix := B.objective_audit_matrix
  objectiveDefinitionCovered := by
    intro item
    exact B.objective_audit_matrix.covered_at item

