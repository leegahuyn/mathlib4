    (I : AdvancedClaimsIIRamanujanFExactCoefficientProofInput)
    (n : Nat) :
    referenceAdvancedClaimsIIRamanujanFPaperObject.coeff n =
      (I.rademacherExpansion.expansion n).truncation
          (I.rademacherExpansion.cutoff n) +
        I.rademacherExpansion.remainder n :=
  I.rademacherExpansion.coeff_eq n

theorem rademacher_tail_at
    (I : AdvancedClaimsIIRamanujanFExactCoefficientProofInput)
    {n : Nat}
    (hn : I.rademacherExpansion.tail.cutoff <= n) :
    abs (I.rademacherExpansion.remainder n) <=
      I.rademacherExpansion.tail.C *
        Real.exp
          (-I.rademacherExpansion.tail.lambda * Real.sqrt (n : Real)) :=
  I.rademacherExpansion.tail_le hn

