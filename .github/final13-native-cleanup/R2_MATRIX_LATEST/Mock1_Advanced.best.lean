structure ScalarJacobiDegeneracyRelationCertificate where
  sourceName : String
  canonical : CanonicalDegeneracyChannelCertificate
  scalarCoeff : Nat -> Real
  jacobiCoeff : Nat -> Int -> Real
  degeneracy : Nat -> Real
  ellStar : Int
  weights : List Rat
  usesScalar : Bool
  sourceName_nonempty :
    Not (sourceName = "")
  ellStar_eq_zero :
    ellStar = 0
  weights_eq_two_sign :
    weights = [1, 1]
  usesScalar_eq_true :
    usesScalar = true
  canonical_link :
    forall n, canonical.degeneracy n = degeneracy n
  degeneracy_eq_scalar :
    forall n, degeneracy n = scalarCoeff n
  jacobi_zero_eq_degeneracy :
    forall n, jacobiCoeff n 0 = degeneracy n

