structure FormalizationChecklist where
  domainPoint : UpperHalfPlanePoint -> UpperHalfPlanePoint
  qFormula : forall tau, qParameter tau =
    Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z)
  cuspTransport : CuspTransport -> UpperHalfPlanePoint -> Complex
  qAfterTransport :
    forall T tau, cuspTransport T tau = qParameter (T.act tau)
  cuspTransportCertificate : CuspTransportCertificate
  cuspSourceWitness : Cusp
  cuspTargetWitness : Cusp
  cuspMatrixWitness : ModularMatrix
  cuspTransport_source :
    cuspTransportCertificate.transport.source = cuspSourceWitness
  cuspTransport_target :
    cuspTransportCertificate.transport.target = cuspTargetWitness
  cuspTransport_matrix :
    cuspTransportCertificate.transport.matrix = cuspMatrixWitness
  qSeriesWitness : QSeries Real
  paperObjectWitness : PaperObject
  objectQSeriesWitness : ObjectQSeriesCertificate
  objectQSeriesWitness_object :
    objectQSeriesWitness.object = paperObjectWitness
  objectQSeriesWitness_series :
    objectQSeriesWitness.series = qSeriesWitness
  truncatedQSeriesWitness : TruncatedQSeries Real
  qSeriesPrefixWitness : QSeriesPrefixCertificate Real
  qSeriesPrefix_truncated :
    qSeriesPrefixWitness.truncated = truncatedQSeriesWitness
  finiteSupportWitness : QSeriesFiniteSupportCertificate Real
  laurentWitness : LaurentQSeries Complex
  principalPartWitness : PrincipalPart Complex
  principalPartLink : PrincipalPartCertificate Complex
  principalPartLink_laurent :
    principalPartLink.laurent = laurentWitness
  principalPartLink_principal :
    principalPartLink.principal = principalPartWitness
  polarProfileWitness : PolarProfile Complex
  polarProfileLink : PolarProfileCertificate Complex
  polarProfileLink_profile :
    polarProfileLink.profile = polarProfileWitness
  appellLerchWitness : AppellLerchAnalyticData
  appellLerchSpecialization : AppellLerchSpecializationCertificate
  xiWitness : BruinierFunkeXiCertificate
  completionWitness : CompletionSplit Unit Complex
  shadowWitness : ShadowCertificate Unit
  slashWitness : HalfWeightSlashAction
  slashGeneratorWitness : SlashGeneratorCertificate
  slashGeneratorWitness_link :
    slashGeneratorWitness.action = slashWitness
  linearSystemIntWitness : LinearSystemCertificate Int
  linearSystemRatWitness : LinearSystemCertificate Rat
  linearSystemComplexWitness : ComplexIntervalLinearSystemCertificate
  linearSystemInt_rows_principal :
    linearSystemIntWitness.system.rows = principalPartWitness.order
  linearSystemRat_rows_principal :
    linearSystemRatWitness.system.rows = principalPartWitness.order
  linearSystemComplex_rows_principal :
    linearSystemComplexWitness.system.rows = principalPartWitness.order
  entropyWitness : EntropyAsymptoticCertificate qSeriesWitness.coeff
  rademacherWitness : RademacherExpansionCertificate qSeriesWitness.coeff
  linkedRademacherWitness : RademacherLinkedExpansionData
  rademacherKernelWitness : RademacherKernelPortfolio
  degeneracyWitness : DegeneracyChannel
  degeneracyAgreement :
    forall n, degeneracyWitness.value n = qSeriesWitness.coeff n
  effectiveCardyNonneg :
    0 <= effectiveCardyConstant entropyWitness.alpha
  sptWitness : SPTCertificate
  sptIdealWitness : SPTIdealCertificate
  sptIdealWitness_link :
    sptIdealWitness.spt = sptWitness
  crtWitness : CRTPortfolio
  crtPairCompatible :
    forall i j,
      PairCompatible (crtWitness.modulus i) (crtWitness.modulus j)
        (crtWitness.residue i) (crtWitness.residue j)
  torWitness : TorFiniteSurrogate
  torLeftMatchesSPT :
    torWitness.leftModulus = sptWitness.M
  torRightMatchesSPT :
    torWitness.rightModulus = sptWitness.p ^ sptWitness.k
  torOrderMatchesSPT :
    torWitness.quotientOrder = sptWitness.obstruction.order
  padicWitness : PAdicNormalization
  padicOverlapWitness : PAdicOverlapCertificate
  mahlerWitness : MahlerFiniteCertificate
  mahlerBinomialWitness : MahlerBinomialCertificate
  olsWitness : RationalOLSCertificate

