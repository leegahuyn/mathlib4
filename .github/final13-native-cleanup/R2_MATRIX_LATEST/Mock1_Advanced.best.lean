/-!
Ramanujan `f` ninety-row entropy regression input boundary.

Table 6 reports `nused = 90` and rounded summary statistics, but it does not
print the ninety source rows or the window endpoints.  The structures below
therefore require those rows as proof-carrying input.  Every row is linked to
the actual Ramanujan coefficient function, carries rational enclosures for the
three transcendental observables, and certifies the `K` and `2K` truncation
checks.  The OLS layer uses the paper's three regressors
`sqrt(n)`, `log(n)`, and `1`; normal equations are checked within an explicit
rational tolerance rather than asserted as floating-point equalities.
-/

structure AdvancedClaimsIIRamanujanFEntropyRegressionRow where
  n : Nat
  coefficient : Int
  sqrtN : Rat
  logN : Rat
  logAbsCoefficient : Rat
  sqrtError : Rat
  logError : Rat
  logAbsError : Rat
  predictedK : Rat
  predictedTwoK : Rat
  differenceK : Rat
  differenceTwoK : Rat
  tailBound : Rat
  n_pos :
    0 < n
  coefficient_nonzero :
    Not (coefficient = 0)
  coefficient_eq_actual :
    coefficient = AdvancedClaimsIIRamanujanFCoefficient n
  sqrt_error_nonnegative :
    0 <= sqrtError
  log_error_nonnegative :
    0 <= logError
  log_abs_error_nonnegative :
    0 <= logAbsError
  sqrt_approximation :
    abs ((sqrtN : Real) - Real.sqrt (n : Real)) <= (sqrtError : Real)
  log_approximation :
    abs ((logN : Real) - Real.log (n : Real)) <= (logError : Real)
  log_abs_approximation :
    abs
        ((logAbsCoefficient : Real) -
          Real.log (abs (coefficient : Real))) <=
      (logAbsError : Real)
  difference_k_formula :
    differenceK = (coefficient : Rat) - predictedK
  difference_two_k_formula :
    differenceTwoK = (coefficient : Rat) - predictedTwoK
  tail_nonnegative :
    0 <= tailBound
  k_pass :
    abs differenceK <= tailBound
  two_k_pass :
    abs differenceTwoK <= tailBound

namespace AdvancedClaimsIIRamanujanFEntropyRegressionRow

theorem coefficient_at
    (R : AdvancedClaimsIIRamanujanFEntropyRegressionRow) :
    R.coefficient = AdvancedClaimsIIRamanujanFCoefficient R.n :=
  R.coefficient_eq_actual

theorem degeneracy_at
    (R : AdvancedClaimsIIRamanujanFEntropyRegressionRow) :
    (R.coefficient : Real) =
      referenceAdvancedClaimsIIRamanujanFScalarDegeneracy.degeneracy R.n := by
  rw [R.coefficient_eq_actual]
  rfl

theorem approximation_bounds_at
    (R : AdvancedClaimsIIRamanujanFEntropyRegressionRow) :
    abs ((R.sqrtN : Real) - Real.sqrt (R.n : Real)) <=
          (R.sqrtError : Real) /\
      abs ((R.logN : Real) - Real.log (R.n : Real)) <=
          (R.logError : Real) /\
        abs
            ((R.logAbsCoefficient : Real) -
              Real.log (abs (R.coefficient : Real))) <=
          (R.logAbsError : Real) :=
  And.intro R.sqrt_approximation
    (And.intro R.log_approximation R.log_abs_approximation)

theorem truncation_checks_at
    (R : AdvancedClaimsIIRamanujanFEntropyRegressionRow) :
    R.differenceK = (R.coefficient : Rat) - R.predictedK /\
      R.differenceTwoK = (R.coefficient : Rat) - R.predictedTwoK /\
        abs R.differenceK <= R.tailBound /\
          abs R.differenceTwoK <= R.tailBound :=
  And.intro R.difference_k_formula
    (And.intro R.difference_two_k_formula
      (And.intro R.k_pass R.two_k_pass))

end AdvancedClaimsIIRamanujanFEntropyRegressionRow

structure AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate where
  row : Fin 90 -> AdvancedClaimsIIRamanujanFEntropyRegressionRow
  alphaHat : Rat
  betaHat : Rat
  gammaHat : Rat
  residual : Fin 90 -> Rat
  residualBound : Rat
  normalEquationTolerance : Rat
  rss : Rat
  residual_formula :
    forall i : Fin 90,
      residual i =
        (row i).logAbsCoefficient -
          (alphaHat * (row i).sqrtN +
            betaHat * (row i).logN + gammaHat)
  residual_bound_nonnegative :
    0 <= residualBound
  residual_abs_le :
    forall i : Fin 90,
      abs (residual i) <= residualBound
  normal_equation_tolerance_nonnegative :
    0 <= normalEquationTolerance
  normal_intercept :
    abs (Finset.sum Finset.univ (fun i : Fin 90 => residual i)) <=
      normalEquationTolerance
  normal_sqrt :
    abs
        (Finset.sum Finset.univ
          (fun i : Fin 90 => (row i).sqrtN * residual i)) <=
      normalEquationTolerance
  normal_log :
    abs
        (Finset.sum Finset.univ
          (fun i : Fin 90 => (row i).logN * residual i)) <=
      normalEquationTolerance
  rss_formula :
    rss = Finset.sum Finset.univ (fun i : Fin 90 => (residual i) ^ 2)
  alpha_interval :
    referenceAlphaInterval.Contains alphaHat
  beta_interval :
    referenceBetaInterval.Contains betaHat
  gamma_interval :
    referenceGammaInterval.Contains gammaHat
  rss_interval :
    referenceRSSInterval.Contains rss

namespace AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate

theorem residual_at
    (C : AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate)
    (i : Fin 90) :
    C.residual i =
      (C.row i).logAbsCoefficient -
        (C.alphaHat * (C.row i).sqrtN +
          C.betaHat * (C.row i).logN + C.gammaHat) :=
  C.residual_formula i

theorem residual_bounded_at
    (C : AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate)
    (i : Fin 90) :
    abs (C.residual i) <= C.residualBound :=
  C.residual_abs_le i

theorem normal_equations_at
    (C : AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate) :
    abs (Finset.sum Finset.univ (fun i : Fin 90 => C.residual i)) <=
          C.normalEquationTolerance /\
      abs
          (Finset.sum Finset.univ
            (fun i : Fin 90 => (C.row i).sqrtN * C.residual i)) <=
            C.normalEquationTolerance /\
        abs
            (Finset.sum Finset.univ
              (fun i : Fin 90 => (C.row i).logN * C.residual i)) <=
          C.normalEquationTolerance :=
  And.intro C.normal_intercept
    (And.intro C.normal_sqrt C.normal_log)

theorem summary_intervals_at
    (C : AdvancedClaimsIIRamanujanFThreeRegressorRationalOLSCertificate) :
