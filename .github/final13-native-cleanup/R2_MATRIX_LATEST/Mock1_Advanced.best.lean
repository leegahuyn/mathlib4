    intro n
    simp [referenceExactCoefficient, referenceExactScalarPart,
      referenceExactThetaPart]

structure CoefficientSeparationBoundary where
  base : CoefficientSeparationCertificate
  scalarPart : Nat -> Real
  thetaPart : Nat -> Real
  coefficient : Nat -> Real
  separated :
    forall n, coefficient n = scalarPart n + thetaPart n
  scalar_eq_base :
    forall n, scalarPart n = base.scalarPart n
  theta_eq_base :
    forall n, thetaPart n = base.thetaPart n
  coefficient_eq_base :
    forall n, coefficient n = base.coefficient n

