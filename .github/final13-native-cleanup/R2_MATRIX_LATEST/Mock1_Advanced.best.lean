theorem tor_surrogate_order {X : Type*} (c : ConcreteCertificate X) :
    c.torSurrogate.quotientOrder =
      Nat.gcd c.torSurrogate.leftModulus c.torSurrogate.rightModulus :=
  c.torSurrogate.quotientOrder_eq_gcd

theorem tor_left_cyclic_modulus {X : Type*}
    (c : ConcreteCertificate X) :
    c.torSurrogate.leftQuotient.modulus = c.spt.M := by
  calc
    c.torSurrogate.leftQuotient.modulus =
        c.torSurrogate.leftModulus := rfl
    _ = c.spt.M := c.torSurrogate_left_matches_spt

theorem tor_right_cyclic_modulus {X : Type*}
    (c : ConcreteCertificate X) :
    c.torSurrogate.rightQuotient.modulus = c.spt.p ^ c.spt.k := by
  calc
    c.torSurrogate.rightQuotient.modulus =
        c.torSurrogate.rightModulus := rfl
    _ = c.spt.p ^ c.spt.k := c.torSurrogate_right_matches_spt

theorem tor_surrogate_order_matches_spt_obstruction {X : Type*}
    (c : ConcreteCertificate X) :
    c.torSurrogate.quotientOrder = c.spt.obstruction.order :=
  c.torSurrogate_order_matches_spt_obstruction

theorem tor_surrogate_order_eq_spt_gcd {X : Type*}
    (c : ConcreteCertificate X) :
    c.torSurrogate.quotientOrder =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := by
  calc
    c.torSurrogate.quotientOrder = c.spt.obstruction.order :=
      c.torSurrogate_order_matches_spt_obstruction
    _ = ObstructionOrder c.spt.M c.spt.p c.spt.k :=
      c.spt.obstruction_matches
    _ = Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := rfl

theorem tor_obstruction_cyclic_order_eq_spt_gcd {X : Type*}
    (c : ConcreteCertificate X) :
    c.torSurrogate.obstructionQuotient.order =
      Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) := by
  calc
    c.torSurrogate.obstructionQuotient.order =
        c.torSurrogate.quotientOrder := rfl
    _ = Nat.gcd c.spt.M (c.spt.p ^ c.spt.k) :=
      c.tor_surrogate_order_eq_spt_gcd

