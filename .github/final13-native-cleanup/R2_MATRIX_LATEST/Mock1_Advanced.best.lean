          c.rationalOLS.betaHat :=
  c.rationalOLS.predictedAt_eq i

theorem rational_ols_residual_decomposition {X : Type*}
    (c : ConcreteCertificate X) (i : Fin c.rationalOLS.points) :
    c.rationalOLS.residual i =
      (c.rationalOLS.point i).yLogAbsCoeff -
        c.rationalOLS.predictedAt i :=
  c.rationalOLS.residual_eq_observed_sub_predicted i

