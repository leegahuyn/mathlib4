theorem scalar_jacobi_at
    (C : ScalarJacobiDegeneracyRelationCertificate) (n : Nat) :
    C.jacobiCoeff n C.ellStar = C.scalarCoeff n := by
  rw [C.ellStar_eq_zero]
  calc
    C.jacobiCoeff n 0 = C.degeneracy n :=
      C.jacobi_zero_eq_degeneracy n
    _ = C.scalarCoeff n :=
      C.degeneracy_eq_scalar n

theorem canonical_matches_at
    (C : ScalarJacobiDegeneracyRelationCertificate) (n : Nat) :
    C.canonical.degeneracy n = C.scalarCoeff n := by
  calc
    C.canonical.degeneracy n = C.degeneracy n :=
      C.canonical_link n
    _ = C.scalarCoeff n :=
      C.degeneracy_eq_scalar n

end ScalarJacobiDegeneracyRelationCertificate

