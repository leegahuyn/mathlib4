inductive PaperLabelKind where
  | theorem
  | diagnosticOnly
deriving DecidableEq, Repr

structure NumberedPaperLabel where
  paperSection : PaperSection
  theoremNumber : Option PaperTheoremNumber
  tableNumber : Option PaperTableNumber
  equationNumber : Option PaperEquationNumber
  kind : PaperLabelKind
deriving DecidableEq, Repr

namespace NumberedPaperLabel

def IsTheorem (L : NumberedPaperLabel) : Prop :=
  L.kind = PaperLabelKind.theorem

def IsDiagnosticOnly (L : NumberedPaperLabel) : Prop :=
  L.kind = PaperLabelKind.diagnosticOnly

theorem theorem_not_diagnostic
    {L : NumberedPaperLabel}
    (h : L.IsTheorem) :
    Not L.IsDiagnosticOnly := by
  intro hd
  rw [IsTheorem] at h
  rw [IsDiagnosticOnly] at hd
  rw [h] at hd
  cases hd

end NumberedPaperLabel

inductive AdvancedClaim where
  | entropyGrowth
  | sptEqualizer
deriving DecidableEq, Repr

namespace AdvancedClaim

def all : List AdvancedClaim :=
  [entropyGrowth, sptEqualizer]

theorem all_length : all.length = 2 := rfl

theorem mem_all (c : AdvancedClaim) :
    c ∈ all := by
  cases c <;> simp [all]

def toPaperClaim : AdvancedClaim -> PaperClaim
  | entropyGrowth => advancedEntropyClaim
  | sptEqualizer => advancedSPTClaim

def toNumberedLabel : AdvancedClaim -> NumberedPaperLabel
  | entropyGrowth =>
      { paperSection := PaperSection.section1_3
        theoremNumber := some PaperTheoremNumber.theorem1_1
        tableNumber := none
        equationNumber := some PaperEquationNumber.eq3_1
        kind := PaperLabelKind.theorem }
  | sptEqualizer =>
      { paperSection := PaperSection.section3_1
        theoremNumber := some PaperTheoremNumber.theorem3_2
        tableNumber := none
        equationNumber := some PaperEquationNumber.eq3_2
        kind := PaperLabelKind.theorem }

theorem label_is_theorem (c : AdvancedClaim) :
    (toNumberedLabel c).IsTheorem := by
  cases c <;> rfl

theorem claim_label_nonempty (c : AdvancedClaim) :
    Not ((toPaperClaim c).label = "") := by
  cases c <;> simp [toPaperClaim, advancedEntropyClaim, advancedSPTClaim]

theorem toNumberedLabel_injective :
    Function.Injective toNumberedLabel := by
  intro a b h
  cases a <;> cases b
  · rfl
  · simp [toNumberedLabel] at h
  · simp [toNumberedLabel] at h
  · rfl

end AdvancedClaim

inductive DiagnosticOnlyItem where
  | entropyDiagnosticTable
  | coefficientDataTable
deriving DecidableEq, Repr

namespace DiagnosticOnlyItem

def all : List DiagnosticOnlyItem :=
  [entropyDiagnosticTable, coefficientDataTable]

theorem all_length : all.length = 2 := rfl

theorem mem_all (d : DiagnosticOnlyItem) :
    d ∈ all := by
  cases d <;> simp [all]

def toNumberedLabel : DiagnosticOnlyItem -> NumberedPaperLabel
  | entropyDiagnosticTable =>
      { paperSection := PaperSection.diagnostics
        theoremNumber := none
        tableNumber := some PaperTableNumber.table1
        equationNumber := none
        kind := PaperLabelKind.diagnosticOnly }
  | coefficientDataTable =>
      { paperSection := PaperSection.diagnostics
        theoremNumber := none
        tableNumber := some PaperTableNumber.table2
        equationNumber := none
        kind := PaperLabelKind.diagnosticOnly }

theorem label_is_diagnostic (d : DiagnosticOnlyItem) :
    (toNumberedLabel d).IsDiagnosticOnly := by
  cases d <;> rfl

theorem toNumberedLabel_injective :
    Function.Injective toNumberedLabel := by
  intro a b h
  cases a <;> cases b
  · rfl
  · simp [toNumberedLabel] at h
  · simp [toNumberedLabel] at h
  · rfl

end DiagnosticOnlyItem

def theoremLabelRegistry : List NumberedPaperLabel :=
  AdvancedClaim.all.map AdvancedClaim.toNumberedLabel

def diagnosticLabelRegistry : List NumberedPaperLabel :=
  DiagnosticOnlyItem.all.map DiagnosticOnlyItem.toNumberedLabel

def fullPaperLabelRegistry : List NumberedPaperLabel :=
  theoremLabelRegistry ++ diagnosticLabelRegistry

theorem theorem_registry_length :
    theoremLabelRegistry.length = AdvancedClaim.all.length := by
  simp [theoremLabelRegistry]

theorem diagnostic_registry_length :
    diagnosticLabelRegistry.length = DiagnosticOnlyItem.all.length := by
  simp [diagnosticLabelRegistry]

theorem full_registry_length :
    fullPaperLabelRegistry.length =
      AdvancedClaim.all.length + DiagnosticOnlyItem.all.length := by
  simp [fullPaperLabelRegistry, theorem_registry_length,
    diagnostic_registry_length]

theorem advanced_claim_label_mem_registry
    (c : AdvancedClaim) :
    AdvancedClaim.toNumberedLabel c ∈ theoremLabelRegistry := by
  exact List.mem_map.mpr ⟨c, AdvancedClaim.mem_all c, rfl⟩

theorem diagnostic_label_mem_registry
    (d : DiagnosticOnlyItem) :
    DiagnosticOnlyItem.toNumberedLabel d ∈ diagnosticLabelRegistry := by
  exact List.mem_map.mpr ⟨d, DiagnosticOnlyItem.mem_all d, rfl⟩

theorem advanced_claim_label_surjective_on_registry
    {L : NumberedPaperLabel}
    (h : L ∈ theoremLabelRegistry) :
    ∃ c : AdvancedClaim,
      c ∈ AdvancedClaim.all ∧ AdvancedClaim.toNumberedLabel c = L := by
  rcases List.mem_map.mp h with ⟨c, hc, hL⟩
  exact ⟨c, hc, hL⟩

theorem diagnostic_label_surjective_on_registry
    {L : NumberedPaperLabel}
    (h : L ∈ diagnosticLabelRegistry) :
    ∃ d : DiagnosticOnlyItem,
      d ∈ DiagnosticOnlyItem.all ∧
        DiagnosticOnlyItem.toNumberedLabel d = L := by
  rcases List.mem_map.mp h with ⟨d, hd, hL⟩
  exact ⟨d, hd, hL⟩

theorem theorem_and_diagnostic_labels_disjoint
    (c : AdvancedClaim) (d : DiagnosticOnlyItem) :
    AdvancedClaim.toNumberedLabel c ≠
      DiagnosticOnlyItem.toNumberedLabel d := by
  intro h
  have ht := AdvancedClaim.label_is_theorem c
  have hd := DiagnosticOnlyItem.label_is_diagnostic d
  rw [h] at ht
  exact NumberedPaperLabel.theorem_not_diagnostic ht hd

theorem full_registry_finite_coverage
    {L : NumberedPaperLabel}
    (h : L ∈ fullPaperLabelRegistry) :
    (∃ c : AdvancedClaim,
      c ∈ AdvancedClaim.all ∧ AdvancedClaim.toNumberedLabel c = L) ∨
    (∃ d : DiagnosticOnlyItem,
      d ∈ DiagnosticOnlyItem.all ∧
        DiagnosticOnlyItem.toNumberedLabel d = L) := by
  rcases List.mem_append.mp h with ht | hd
  · exact Or.inl (advanced_claim_label_surjective_on_registry ht)
  · exact Or.inr (diagnostic_label_surjective_on_registry hd)

structure PaperSymbolCoverageCertificate where
  theoremLabels : List NumberedPaperLabel
  diagnosticLabels : List NumberedPaperLabel
  theoremLabels_eq :
    theoremLabels = theoremLabelRegistry
  diagnosticLabels_eq :
    diagnosticLabels = diagnosticLabelRegistry
  theoremCoverage :
    forall c : AdvancedClaim,
      AdvancedClaim.toNumberedLabel c ∈ theoremLabels
  diagnosticCoverage :
    forall d : DiagnosticOnlyItem,
      DiagnosticOnlyItem.toNumberedLabel d ∈ diagnosticLabels
  theoremDiagnosticDisjoint :
    forall c d,
      AdvancedClaim.toNumberedLabel c ≠
        DiagnosticOnlyItem.toNumberedLabel d

namespace PaperSymbolCoverageCertificate

theorem theorem_covered_at
    (C : PaperSymbolCoverageCertificate)
