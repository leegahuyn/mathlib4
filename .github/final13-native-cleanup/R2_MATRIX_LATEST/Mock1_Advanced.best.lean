structure ArchimedeanScalarCoefficientInputCertificate where
  sourceName : String
  scalarRecord : ArchimedeanScalarRecord
  formula : NormalizedCoefficientFormulaCertificate
  scalar : Real
  mockCoeff : Nat -> Real
  thetaCoeff : Nat -> Real
  normalizedCoeff : Nat -> Real
  coefficientFormulaSymbol : String
  sourceName_nonempty :
    Not (sourceName = "")
