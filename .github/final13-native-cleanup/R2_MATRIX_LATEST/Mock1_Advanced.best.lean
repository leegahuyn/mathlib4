  tor_left_cyclic := C.tor_left_cyclic_modulus
  tor_right_cyclic := C.tor_right_cyclic_modulus
  tor_obstruction_cyclic := C.tor_obstruction_cyclic_order_eq_spt_gcd
  padic_normalization := C.padic_normalization_at
