  List.ofFn I.ols.row

theorem row_count_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput) :
    I.rows.length = 90 := by
  simp [rows]

theorem index_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput)
    (i : Fin 90) :
    (I.ols.row i).n = I.windowStart + (i : Nat) :=
  I.contiguous_indices i

theorem index_bounds_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput)
    (i : Fin 90) :
    I.windowStart <= (I.ols.row i).n /\
      (I.ols.row i).n < I.windowStart + 90 := by
  rw [I.index_at i]
  constructor
  · omega
  · have hi := i.isLt
    omega

theorem index_injective_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput)
    {i j : Fin 90}
    (h : (I.ols.row i).n = (I.ols.row j).n) :
    i = j := by
  rw [I.index_at i, I.index_at j] at h
  apply Fin.ext
  omega

theorem actual_coefficient_at
    (I : AdvancedClaimsIIRamanujanFEntropyNinetyRowProofInput)
    (i : Fin 90) :
    (I.ols.row i).coefficient =
