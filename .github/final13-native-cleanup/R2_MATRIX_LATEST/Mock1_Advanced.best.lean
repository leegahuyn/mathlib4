/-!
Actual Ramanujan-to-Appell-Lerch analytic identity boundary.

The finite T3 block table determines the affine arguments but does not prove
that the Ramanujan q-series equals their weighted analytic sum.  The following
proof input states that missing theorem exactly.  It starts from truncations of
the certified Ramanujan coefficient function, includes the `q^(-1/24)` shift,
identifies every declared T3 block with a `mu` value, records the completion
correction, links the Bruinier-Funke xi certificate to the completed function,
and carries the all-paper-cusp proof input from the preceding section.
-/

def AdvancedClaimsIIRamanujanFShiftExponent : Rat :=
  (-1 : Rat) / 24

noncomputable def AdvancedClaimsIIRatAsComplex (x : Rat) : Complex :=
  (x : Complex)

noncomputable def AdvancedClaimsIIRamanujanFShiftFactor
    (tau : UpperHalfPlanePoint) : Complex :=
  Complex.exp
    (((((2 : Real) * Real.pi) : Complex) * Complex.I) *
      AdvancedClaimsIIRatAsComplex AdvancedClaimsIIRamanujanFShiftExponent *
        tau.z)

noncomputable def AdvancedClaimsIIRamanujanFShiftedTruncation
    (tau : UpperHalfPlanePoint) (N : Nat) : Complex :=
  AdvancedClaimsIIRamanujanFShiftFactor tau *
    Finset.sum (Finset.range N)
      (fun n =>
        (AdvancedClaimsIIRamanujanFCoefficient n : Complex) *
          qParameter tau ^ n)

noncomputable def AdvancedClaimsIIPaperT3BlockU
    (block : AdvancedClaimsIIPaperT3WeightedBlock)
    (tau : UpperHalfPlanePoint) : Complex :=
  AdvancedClaimsIIRatAsComplex ((1 / 2 : Rat) + block.m) * tau.z +
    AdvancedClaimsIIRatAsComplex block.r

noncomputable def AdvancedClaimsIIPaperT3BlockV
    (block : AdvancedClaimsIIPaperT3WeightedBlock)
    (tau : UpperHalfPlanePoint) : Complex :=
  AdvancedClaimsIIRatAsComplex ((1 / 2 : Rat) + block.m) * tau.z +
    AdvancedClaimsIIRatAsComplex ((1 / 2 : Rat) + block.r)

noncomputable def AdvancedClaimsIIPaperT3WeightedAnalyticSum
    (blockValue :
      AdvancedClaimsIIPaperT3WeightedBlock ->
        UpperHalfPlanePoint -> Complex)
    (tau : UpperHalfPlanePoint) : Complex :=
  (referenceAdvancedClaimsIIPaperT3WeightedBlocks.map
      (fun block =>
        AdvancedClaimsIIRatAsComplex block.coefficient *
          blockValue block tau)).sum

theorem advanced_claims_ii_ramanujan_f_shift_exponent_at :
    AdvancedClaimsIIRamanujanFShiftExponent = (-1 : Rat) / 24 := by
  rfl

theorem advanced_claims_ii_paper_t3_block_argument_difference
    (block : AdvancedClaimsIIPaperT3WeightedBlock)
    (tau : UpperHalfPlanePoint) :
    AdvancedClaimsIIPaperT3BlockU block tau -
        AdvancedClaimsIIPaperT3BlockV block tau =
      AdvancedClaimsIIRatAsComplex (-1 / 2 : Rat) := by
  simp [AdvancedClaimsIIPaperT3BlockU,
    AdvancedClaimsIIPaperT3BlockV, AdvancedClaimsIIRatAsComplex] <;>
    ring

structure AdvancedClaimsIIRamanujanFAppellLerchAnalyticProofInput
    (ConvergesAt : CuspLabel -> Prop) where
  sourceName : String
  formulaLabel : String
  replacementPlan : String
  data : AppellLerchAnalyticData
  allPaperCusps :
    AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt
  blockValue :
    AdvancedClaimsIIPaperT3WeightedBlock ->
      UpperHalfPlanePoint -> Complex
  holomorphicPart : UpperHalfPlanePoint -> Complex
  completionCorrection : UpperHalfPlanePoint -> Complex
  completedPart : UpperHalfPlanePoint -> Complex
  xi : BruinierFunkeXiCertificate
  sourceName_nonempty :
    Not (sourceName = "")
  formulaLabel_nonempty :
    Not (formulaLabel = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  qseries_limit :
    forall tau : UpperHalfPlanePoint,
      Filter.Tendsto
        (fun N : Nat => AdvancedClaimsIIRamanujanFShiftedTruncation tau N)
        Filter.atTop (nhds (holomorphicPart tau))
  block_value_eq_mu :
    forall (block : AdvancedClaimsIIPaperT3WeightedBlock)
      (hblock : List.Mem block referenceAdvancedClaimsIIPaperT3WeightedBlocks)
      (tau : UpperHalfPlanePoint),
      blockValue block tau =
        data.mu
          (AdvancedClaimsIIPaperT3BlockU block tau)
          (AdvancedClaimsIIPaperT3BlockV block tau) tau
  holomorphic_eq_weighted_blocks :
    forall tau : UpperHalfPlanePoint,
      holomorphicPart tau =
        AdvancedClaimsIIPaperT3WeightedAnalyticSum blockValue tau
  completion_correction_eq :
    forall tau : UpperHalfPlanePoint,
      completionCorrection tau =
        AdvancedClaimsIIRatAsComplex
            AdvancedClaimsIIPaperT3CompletionCorrectionScale *
          data.completionTerm tau
  completed_split :
    forall tau : UpperHalfPlanePoint,
      completedPart tau = holomorphicPart tau + completionCorrection tau
  xi_completed_link :
    xi.completedObject = completedPart
  xi_shadow_link :
    xi.shadow = data.gz
  xi_scale_nonzero :
    Not (xi.scale = 0)
  shadow_nonzero :
    Exists fun tau : UpperHalfPlanePoint =>
      Not (data.gz tau = 0)

