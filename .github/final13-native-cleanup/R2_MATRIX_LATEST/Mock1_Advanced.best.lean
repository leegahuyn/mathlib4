/-!
Actual finite p-adic data derived from Ramanujan `f(q)`.

The paper I.2 worked vector is a separate numerical example and does not equal
the first six Ramanujan coefficients modulo 25.  This section derives the
Ramanujan vector and its Mahler coefficients directly from the certified
q-hypergeometric coefficient function.  No transported cusp vector or global
tail statement is inferred from this finite calculation.
-/

def AdvancedClaimsIIRamanujanFPAdicModulus : Nat :=
  PrimePower AdvancedClaimsIIPaperI2Prime
    AdvancedClaimsIIPaperI2Precision

def AdvancedClaimsIIRamanujanFPAdicDenominator : Nat := 1

def AdvancedClaimsIIRamanujanFPAdicRawValue (n : Fin 6) : Rat :=
  (AdvancedClaimsIIRamanujanFCoefficient (n : Nat) : Rat)

def AdvancedClaimsIIRamanujanFPAdicIntegralValue (n : Nat) : Int :=
  AdvancedClaimsIIRamanujanFCoefficient n

def AdvancedClaimsIIRamanujanFPAdicResidueValue (n : Nat) : Int :=
  AdvancedClaimsIIRamanujanFPAdicIntegralValue n %
    (AdvancedClaimsIIRamanujanFPAdicModulus : Int)

def AdvancedClaimsIIRamanujanFPAdicRawPrefix : List Int :=
  (List.range 6).map AdvancedClaimsIIRamanujanFPAdicIntegralValue

def AdvancedClaimsIIRamanujanFPAdicResidueTable : List Int :=
  (List.range 6).map AdvancedClaimsIIRamanujanFPAdicResidueValue

def AdvancedClaimsIIRamanujanFPAdicForwardDifference (j : Nat) : Int :=
  Finset.sum (Finset.range (j + 1))
    (fun i =>
      ((-1 : Int) ^ (j - i)) *
        (Nat.choose j i : Int) *
          AdvancedClaimsIIRamanujanFPAdicIntegralValue i)

def AdvancedClaimsIIRamanujanFPAdicMahlerCoefficient
    (j : Fin 6) : Int :=
  AdvancedClaimsIIRamanujanFPAdicForwardDifference (j : Nat) %
    (AdvancedClaimsIIRamanujanFPAdicModulus : Int)

def AdvancedClaimsIIRamanujanFPAdicMahlerEval (n : Nat) : Int :=
  Finset.sum Finset.univ
    (fun j : Fin 6 =>
      AdvancedClaimsIIRamanujanFPAdicMahlerCoefficient j *
        mahlerBinomialBasis (j : Nat) n)

def AdvancedClaimsIIRamanujanFPAdicInterpolationTable : List Int :=
  (List.range 6).map
    (fun n =>
      AdvancedClaimsIIRamanujanFPAdicMahlerEval n %
        (AdvancedClaimsIIRamanujanFPAdicModulus : Int))

theorem advanced_claims_ii_ramanujan_f_padic_modulus_value :
    AdvancedClaimsIIRamanujanFPAdicModulus = 25 := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_denominator_positive :
    0 < AdvancedClaimsIIRamanujanFPAdicDenominator := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_denominator_clears_at
    (n : Fin 6) :
    (AdvancedClaimsIIRamanujanFPAdicDenominator : Rat) *
        AdvancedClaimsIIRamanujanFPAdicRawValue n =
      (AdvancedClaimsIIRamanujanFPAdicIntegralValue (n : Nat) : Rat) := by
  simp [AdvancedClaimsIIRamanujanFPAdicDenominator,
    AdvancedClaimsIIRamanujanFPAdicRawValue,
    AdvancedClaimsIIRamanujanFPAdicIntegralValue]

theorem advanced_claims_ii_ramanujan_f_padic_raw_prefix :
    AdvancedClaimsIIRamanujanFPAdicRawPrefix =
      [1, 1, -2, 3, -3, 3] := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_residue_table :
    AdvancedClaimsIIRamanujanFPAdicResidueTable =
      [1, 1, 23, 3, 22, 3] := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_forward_difference_table :
    List.ofFn
        (fun j : Fin 6 =>
          AdvancedClaimsIIRamanujanFPAdicForwardDifference (j : Nat)) =
      [1, 0, -3, 11, -30, 72] := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_mahler_coefficient_table :
    List.ofFn AdvancedClaimsIIRamanujanFPAdicMahlerCoefficient =
      [1, 0, 22, 11, 20, 22] := by
  decide

theorem advanced_claims_ii_ramanujan_f_padic_interpolation_at
    (n : Fin 6) :
    AdvancedClaimsIIRamanujanFPAdicMahlerEval (n : Nat) %
        (AdvancedClaimsIIRamanujanFPAdicModulus : Int) =
      AdvancedClaimsIIRamanujanFPAdicResidueValue (n : Nat) := by
  fin_cases n <;> decide

