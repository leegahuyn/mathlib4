    ArithmeticEqualizer target.M (target.p ^ target.k)
      (mapEqualizer source.equalizerElement)

namespace SPTBaseChangeStabilityBoundary

theorem target_equalizer_at
    (B : SPTBaseChangeStabilityBoundary) :
    ArithmeticEqualizer B.target.M (B.target.p ^ B.target.k)
      (B.mapEqualizer B.source.equalizerElement) :=
  B.target_equalizer_mem

theorem target_lcm_dvd_at
    (B : SPTBaseChangeStabilityBoundary) :
    Dvd.dvd (Nat.lcm B.target.M (B.target.p ^ B.target.k))
      (B.mapEqualizer B.source.equalizerElement) := by
  exact
    (arithmeticEqualizer_iff_lcm_dvd B.target.M
      (B.target.p ^ B.target.k)
      (B.mapEqualizer B.source.equalizerElement)).mp
      B.target_equalizer_mem

end SPTBaseChangeStabilityBoundary

