namespace UnconditionalCertificationBundle

theorem coverage_matrix {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    RequirementCoverageMatrix B where
  audit := B.requirement_audit
  covered := by
    intro key
    have H : CertificationRequirementAudit X B := B.requirement_audit
    cases key
    case domain_q_cusp =>
      exact And.intro H.domain_q H.cusp_route
    case qseries_principal_polar =>
      exact And.intro H.qseries_coeff
        (And.intro H.principal_part H.polar_profile)
    case appell_completion_shadow =>
      exact And.intro H.appell_specialization
        (And.intro H.appell_completion
          (And.intro H.appell_muHat H.unary_theta_shadow))
    case xi_operator =>
      exact H.xi_shadow
    case slash_transport =>
      exact And.intro H.slash_weight
        (And.intro H.slash_T H.slash_S)
    case linear_systems =>
      exact And.intro H.linear_int
        (And.intro H.linear_rat H.linear_complex)
    case entropy_asymptotic =>
      exact And.intro H.entropy_epsilonN H.entropy_littleO
    case rademacher_expansion =>
      exact And.intro H.rademacher_expansion
        (And.intro H.rademacher_kernel
          (And.intro H.rademacher_kloosterman
            (And.intro H.rademacher_bessel
              (And.intro H.rademacher_truncation_one
                (And.intro H.rademacher_tail
                  H.rademacher_tail_envelope_nonneg)))))
    case degeneracy_cardy =>
      exact And.intro H.degeneracy_channel
        (And.intro H.effective_cardy H.effective_cardy_nonneg)
    case spt_crt =>
      exact And.intro H.spt_equalizer
        (And.intro H.spt_intersection
          (And.intro H.crt_portfolio H.crt_pairwise))
    case tor_surrogate =>
      exact And.intro H.tor_gcd H.tor_cyclic
    case padic_mahler =>
      exact And.intro H.padic_normalization
        (And.intro H.padic_finite
          (And.intro H.mahler_finite
            (And.intro H.mahler_formula
              (And.intro H.mahler_binomial_congruence
                H.mahler_binomial))))
    case rational_ols =>
      exact And.intro H.ols_prediction
        (And.intro H.ols_formula
          (And.intro H.ols_decomposition
            (And.intro H.ols_interval.1
              (And.intro H.ols_interval.2
                (And.intro H.ols_residual_nonneg
                  (And.intro H.ols_residual
                    H.ols_abs_residual_nonneg))))))
    case abstract_concrete_chain =>
      exact And.intro H.abstract_concrete_chain
        (And.intro B.checklist_object B.checklist_qseries_object)

theorem named_requirement_coverage {X : Type*}
    (B : UnconditionalCertificationBundle X) :
    NamedRequirementCoverage B where
  matrix := B.coverage_matrix
  domain_q_cusp := B.coverage_matrix.domain_q_cusp_covered
  qseries_principal_polar :=
    B.coverage_matrix.qseries_principal_polar_covered
  appell_completion_shadow :=
    B.coverage_matrix.appell_completion_shadow_covered
  xi_operator := B.coverage_matrix.xi_operator_covered
  slash_transport := B.coverage_matrix.slash_transport_covered
  linear_systems := B.coverage_matrix.linear_systems_covered
  entropy_asymptotic := B.coverage_matrix.entropy_asymptotic_covered
  rademacher_expansion := B.coverage_matrix.rademacher_expansion_covered
  degeneracy_cardy := B.coverage_matrix.degeneracy_cardy_covered
  spt_crt := B.coverage_matrix.spt_crt_covered
  tor_surrogate := B.coverage_matrix.tor_surrogate_covered
  padic_mahler := B.coverage_matrix.padic_mahler_covered
  rational_ols := B.coverage_matrix.rational_ols_covered
  abstract_concrete_chain :=
    B.coverage_matrix.abstract_concrete_chain_covered

end UnconditionalCertificationBundle

