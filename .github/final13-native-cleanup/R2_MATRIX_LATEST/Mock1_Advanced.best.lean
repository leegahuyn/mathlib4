namespace Mock1Advanced

/-!
Principal-part exponent layer for the Mock1 advanced registry.

This block keeps the paper-facing inputs finite: each polar row is tied to a
numbered paper label, each denominator carries its nonzero proof, and each
principal-part solve is checked by a closed rational matrix-vector equality.
-/

abbrev PolarProfileList := List (Prod Int Rat)

def dotRat (row x : List Rat) : Rat :=
  List.foldl (fun acc p => acc + p.1 * p.2) 0 (List.zip row x)

def MatVecRat (A : List (List Rat)) (x : List Rat) : List Rat :=
  A.map (fun row => dotRat row x)

structure AppellLerchBlockLabel where
  claim : AdvancedClaim
  paperSection : PaperSection
  theoremNumber : Option PaperTheoremNumber
  equationNumber : Option PaperEquationNumber
  section_eq :
    (AdvancedClaim.toNumberedLabel claim).paperSection = paperSection
  theoremNumber_eq :
    (AdvancedClaim.toNumberedLabel claim).theoremNumber = theoremNumber
  equationNumber_eq :
    (AdvancedClaim.toNumberedLabel claim).equationNumber = equationNumber

namespace AppellLerchBlockLabel

theorem section_at (L : AppellLerchBlockLabel) :
    (AdvancedClaim.toNumberedLabel L.claim).paperSection = L.paperSection :=
  L.section_eq

theorem theorem_number_at (L : AppellLerchBlockLabel) :
    (AdvancedClaim.toNumberedLabel L.claim).theoremNumber = L.theoremNumber :=
  L.theoremNumber_eq

theorem equation_number_at (L : AppellLerchBlockLabel) :
    (AdvancedClaim.toNumberedLabel L.claim).equationNumber = L.equationNumber :=
  L.equationNumber_eq

end AppellLerchBlockLabel

structure DenominatorNonzeroCertificate where
  denominator : Int
  denominator_ne_zero : Not (denominator = 0)

namespace DenominatorNonzeroCertificate

theorem nonzero_at (C : DenominatorNonzeroCertificate) :
    Not (C.denominator = 0) :=
  C.denominator_ne_zero

end DenominatorNonzeroCertificate

structure ExponentInput where
  blockLabel : AppellLerchBlockLabel
  denominatorCertificate : DenominatorNonzeroCertificate
  numeratorShift : Int
  exponent : Int
  coefficient : Rat
  exponent_formula :
    exponent = numeratorShift - denominatorCertificate.denominator

namespace ExponentInput

theorem denominator_nonzero_at (I : ExponentInput) :
    Not (I.denominatorCertificate.denominator = 0) :=
  I.denominatorCertificate.nonzero_at

theorem exponent_formula_at (I : ExponentInput) :
    I.exponent = I.numeratorShift - I.denominatorCertificate.denominator :=
  I.exponent_formula

theorem label_section_at (I : ExponentInput) :
    (AdvancedClaim.toNumberedLabel I.blockLabel.claim).paperSection =
      I.blockLabel.paperSection :=
  I.blockLabel.section_at

end ExponentInput

structure PolarExponentRowCertificate where
  input : ExponentInput
  row : PolarExponentRow
  row_exponent_eq :
    row.exponent = input.exponent
  row_multiplicity_pos :
    0 < row.multiplicity
  exponent_negative :
    input.exponent < 0

namespace PolarExponentRowCertificate

theorem row_negative_at (C : PolarExponentRowCertificate) :
    C.row.exponent < 0 := by
  rw [C.row_exponent_eq]
  exact C.exponent_negative

theorem row_polar_at (C : PolarExponentRowCertificate) :
    C.row.exponent < 0 :=
  C.row.polar

theorem denominator_nonzero_at (C : PolarExponentRowCertificate) :
    Not (C.input.denominatorCertificate.denominator = 0) :=
  C.input.denominator_nonzero_at

theorem row_multiplicity_positive_at (C : PolarExponentRowCertificate) :
    0 < C.row.multiplicity :=
  C.row_multiplicity_pos

end PolarExponentRowCertificate

structure NegativeQOrderExtractionBoundary where
  profile : PolarProfileList
  rows : List PolarExponentRow
  profile_negative :
    forall p : Prod Int Rat, List.Mem p profile -> p.1 < 0
  rows_length_eq_profile :
    rows.length = profile.length

namespace NegativeQOrderExtractionBoundary

theorem profile_negative_at
    (C : NegativeQOrderExtractionBoundary) (p : Prod Int Rat)
    (hp : List.Mem p C.profile) :
    p.1 < 0 :=
  C.profile_negative p hp

theorem rows_length_at (C : NegativeQOrderExtractionBoundary) :
    C.rows.length = C.profile.length :=
  C.rows_length_eq_profile

end NegativeQOrderExtractionBoundary

structure PrincipalPartAssemblyCertificate where
  profile : PolarProfileList
  rows : List PolarExponentRow
  matrix : List (List Rat)
  rhs : List Rat
  solution : List Rat
  rows_length_eq_profile :
    rows.length = profile.length
  matrix_rows_eq_profile :
    matrix.length = profile.length
  rhs_length_eq_profile :
    rhs.length = profile.length
  matvec_eq_rhs :
    MatVecRat matrix solution = rhs

namespace PrincipalPartAssemblyCertificate

theorem rows_length_at (C : PrincipalPartAssemblyCertificate) :
    C.rows.length = C.profile.length :=
  C.rows_length_eq_profile

theorem matrix_rows_at (C : PrincipalPartAssemblyCertificate) :
    C.matrix.length = C.profile.length :=
  C.matrix_rows_eq_profile

theorem rhs_length_at (C : PrincipalPartAssemblyCertificate) :
    C.rhs.length = C.profile.length :=
  C.rhs_length_eq_profile

theorem matvec_eq_rhs_at (C : PrincipalPartAssemblyCertificate) :
    MatVecRat C.matrix C.solution = C.rhs :=
