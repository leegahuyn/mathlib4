structure GrowthStabilityBaseChangeCertificate where
  sourceName : String
  theoremNumber : PaperTheoremNumber
  spt : SPTCertificate
  padic : PAdicNormalization
  alphaHat : Rat
  ceffHat : Rat
  alphaInterval : RationalInterval
  ceffInterval : RationalInterval
  alphaByCusp : Nat -> Rat
  ceffByCusp : Nat -> Rat
  obstructionOrder : Nat
  tailUpper : Rat
  alphaStdErr : Rat
  controlledSplitBound : Rat
  sourceName_nonempty :
    Not (sourceName = "")
  theoremNumber_eq :
    theoremNumber = PaperTheoremNumber.theoremI_8
  obstructionOrder_eq :
    obstructionOrder = Nat.gcd spt.M (spt.p ^ spt.k)
  obstructionFree :
    obstructionOrder = 1
  spt_matches_padic :
    spt.p = padic.p /\ spt.k = padic.k
  alpha_mem_interval :
    alphaInterval.Contains alphaHat
  ceff_mem_interval :
    ceffInterval.Contains ceffHat
  alpha_cusp_mem :
    forall c, alphaInterval.Contains (alphaByCusp c)
  ceff_cusp_mem :
    forall c, ceffInterval.Contains (ceffByCusp c)
  exact_invariance_when_obstruction_free :
    obstructionOrder = 1 ->
      forall c, alphaByCusp c = alphaHat /\ ceffByCusp c = ceffHat
  controlledSplitBound_eq :
    controlledSplitBound = tailUpper + 2 * alphaStdErr
  alpha_difference_le_controlled :
    forall c1 c2,
      |alphaByCusp c1 - alphaByCusp c2| <= controlledSplitBound

