def advanced_final_theorem_aggregation
    (E : EndToEndCertificationEvidence) :
    AdvancedFinalTheoremAggregation E where
  handoff := certification_handoff_seal E
  «seal» := unconditional_certification_seal E
  definition_ledger := requested_definition_final_ledger E
  detail_ledger := requested_detail_final_ledger E
  requested_definition_checklist :=
    EndToEndCertificationEvidence.requested_definition_checklist_at E
  proof_payload :=
    EndToEndCertificationEvidence.proof_payload_at E
  proof_fields :=
    EndToEndCertificationEvidence.proof_fields_at E
  checklist_definitions :=
    EndToEndCertificationEvidence.checklist_definitions_at E
  all_requested :=
    EndToEndCertificationEvidence.requested_definition_covered_at E
  all_requirements :=
    EndToEndCertificationEvidence.requirement_covered_at E
  requested_layer_file_nonempty :=
    EndToEndCertificationEvidence.requested_layer_file_nonempty_at E
  local_lean_command :=
    EndToEndCertificationEvidence.local_lean_command_at E
  local_print_axioms_command :=
    AxiomAuditCompleteness.local_print_axioms_shellText
      E.readiness.completeness
  local_static_scan_command :=
    EndToEndCertificationEvidence.local_static_scan_command_at E
  local_hash_command :=
    EndToEndCertificationEvidence.local_hash_command_at E
  print_axioms_covers :=
    EndToEndCertificationEvidence.print_axioms_covers_at E
  environment_toolchain :=
    EndToEndCertificationEvidence.environment_toolchain_at E
  environment_mathlib_commit :=
    EndToEndCertificationEvidence.environment_mathlib_commit_at E
  environment_ci_workflow :=
    EndToEndCertificationEvidence.environment_ci_workflow_at E
  abstract_concrete_separation :=
    EndToEndCertificationEvidence.requested_abstract_concrete_separation_at E

def referenceEndToEndCertificationEvidence :
    EndToEndCertificationEvidence where
  readiness := referenceCertificationReadiness
  requirements := by
    intro key hmem
    exact
      CertificationReadiness.requirements_covered_at
        referenceCertificationReadiness key hmem
  objectives := by
    intro item hmem
    exact
      CertificationReadiness.objective_covered_at
        referenceCertificationReadiness item hmem
  requestedDefinitions := by
    intro item hmem
    exact
      RequestedDefinitionAuditMatrix.all_covered_at
        referenceCertificationReadiness.requestedDefinitionAudit item hmem
  requestedRequirements := by
    intro item
    exact
      CertificationReadiness.requested_definition_requirement_at
        referenceCertificationReadiness item
  requestedLayered := by
    intro item
    exact
      RequestedDefinitionLayerMatrix.objective_placed_at
        referenceCertificationReadiness.requestedDefinitionLayerMatrix item
  requestedLayerFileNonempty := by
    intro item
    exact
      RequestedDefinitionLayerMatrix.file_name_nonempty_at
        referenceCertificationReadiness.requestedDefinitionLayerMatrix item
  objectiveDefinitions :=
    CertificationReadiness.objective_definitions_at
      referenceCertificationReadiness
  namedRequirements :=
    AxiomAuditCompleteness.named_at
      referenceCertificationReadiness.completeness
  requirementAudit :=
    AxiomAuditCompleteness.requirement_audit_at
      referenceCertificationReadiness.completeness
  proofPayload :=
    CertificationReadiness.proof_payload_at
      referenceCertificationReadiness
  proofFields :=
    CertificationReadiness.proof_field_matrix_at
      referenceCertificationReadiness
  checklistDefinitions :=
    CertificationReadiness.proof_field_checklist_definitions_at
      referenceCertificationReadiness
  localLeanCommand :=
    CertificationReadiness.local_lean_command_at
      referenceCertificationReadiness
  localStaticScanCommand :=
    CertificationReadiness.local_static_scan_command_at
      referenceCertificationReadiness
  localHashCommand :=
    CertificationReadiness.local_hash_snapshot_command_at
      referenceCertificationReadiness
  printAxiomsCovers := by
    intro layer
    exact
      CertificationReadiness.local_print_covers_at
        referenceCertificationReadiness layer
  environmentToolchain :=
    CertificationReadiness.environment_toolchain_at
      referenceCertificationReadiness
  environmentMathlibCommit :=
    CertificationReadiness.environment_mathlib_commit_at
      referenceCertificationReadiness
  environmentCIWorkflow :=
    CertificationReadiness.environment_ci_workflow_at
      referenceCertificationReadiness

