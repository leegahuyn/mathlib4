    AdvancedClaimsIIPromptBullet.statement
      referenceAdvancedClaimsIICompletionCertificate b :=
  C.prompt_statement

theorem leaf_statement_at
    {b : AdvancedClaimsIIPromptBullet}
    (C : AdvancedClaimsIIClaimwiseAtomicDischargeCertificate b) :
    AdvancedClaimsIIRequirement.leafStatement
      referenceAdvancedClaimsIICompletionCertificate
      (AdvancedClaimsIIPromptBullet.requirementOf b) :=
  C.leaf_statement

theorem statement_iff_leaf_at
    {b : AdvancedClaimsIIPromptBullet}
    (C : AdvancedClaimsIIClaimwiseAtomicDischargeCertificate b) :
    AdvancedClaimsIIPromptBullet.statement
        referenceAdvancedClaimsIICompletionCertificate b <->
      AdvancedClaimsIIRequirement.leafStatement
        referenceAdvancedClaimsIICompletionCertificate
        (AdvancedClaimsIIPromptBullet.requirementOf b) :=
  C.statement_iff_leaf

theorem atomic_payload_at
    {b : AdvancedClaimsIIPromptBullet}
    (C : AdvancedClaimsIIClaimwiseAtomicDischargeCertificate b) :
    List.Mem b AdvancedClaimsIIPromptBullet.all /\
      List.Mem (AdvancedClaimsIIPromptBullet.requirementOf b)
          AdvancedClaimsIIRequirement.all /\
        List.Mem (AdvancedClaimsIIPromptBullet.requirementOf b)
            referenceAdvancedClaimsIICompletionCertificate.requirements /\
          AdvancedClaimsIIPromptBullet.statement
              referenceAdvancedClaimsIICompletionCertificate b /\
            AdvancedClaimsIIRequirement.leafStatement
              referenceAdvancedClaimsIICompletionCertificate
              (AdvancedClaimsIIPromptBullet.requirementOf b) /\
              (AdvancedClaimsIIPromptBullet.statement
                  referenceAdvancedClaimsIICompletionCertificate b <->
                AdvancedClaimsIIRequirement.leafStatement
                  referenceAdvancedClaimsIICompletionCertificate
                  (AdvancedClaimsIIPromptBullet.requirementOf b)) :=
  And.intro C.bullet_listed
    (And.intro C.requirement_listed_global
      (And.intro C.requirement_listed_certificate
        (And.intro C.prompt_statement
          (And.intro C.leaf_statement C.statement_iff_leaf))))

end AdvancedClaimsIIClaimwiseAtomicDischargeCertificate

