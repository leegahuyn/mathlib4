    (I : AdvancedClaimsIIRamanujanFExactCoefficientProofInput)
    (n : Nat)
    (row : AdvancedClaimsIIRamanujanFLocalEulerFactorRow)
    (hrow : List.Mem row (I.localRows n)) :
    row.n = n /\ Nat.Prime row.prime /\ Not (row.factor = 0) :=
  And.intro (I.local_row_index n row hrow)
    (And.intro row.prime_at row.factor_nonzero_at)

