inductive AdvancedClaimsIIObjectiveSection where
  | objectSchema
  | t1t5Core
  | sptEqualizerTorCrt
  | kernelCuspMultiplier
  | exactCoefficientFormula
  | pAdicSection
  | entropyCardyReproducibility
  | paperDataInstance
  | finalAggregation
deriving DecidableEq, Repr

namespace AdvancedClaimsIIObjectiveSection

def all : List AdvancedClaimsIIObjectiveSection :=
  [ objectSchema
  , t1t5Core
  , sptEqualizerTorCrt
  , kernelCuspMultiplier
  , exactCoefficientFormula
  , pAdicSection
  , entropyCardyReproducibility
  , paperDataInstance
  , finalAggregation
  ]

theorem all_length :
    all.length = 9 := by
  decide

theorem all_nodup :
    all.Nodup := by
  decide

theorem mem_all (s : AdvancedClaimsIIObjectiveSection) :
    List.Mem s all := by
  cases s with
  | objectSchema => exact List.Mem.head _
  | t1t5Core => exact List.Mem.tail _ (List.Mem.head _)
  | sptEqualizerTorCrt => exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))
  | kernelCuspMultiplier =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
  | exactCoefficientFormula =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.head _))))
  | pAdicSection =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))))
  | entropyCardyReproducibility =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))))
  | paperDataInstance =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
          (List.Mem.tail _ (List.Mem.head _)))))))
  | finalAggregation =>
      exact List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
          (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))))))

def requirements : AdvancedClaimsIIObjectiveSection ->
    List AdvancedClaimsIIRequirement
  | objectSchema => AdvancedClaimsIIRequirement.objectSchemaRequirements
  | t1t5Core => AdvancedClaimsIIRequirement.t1t5Requirements
  | sptEqualizerTorCrt => AdvancedClaimsIIRequirement.sptRequirements
  | kernelCuspMultiplier => AdvancedClaimsIIRequirement.kernelRequirements
  | exactCoefficientFormula =>
      AdvancedClaimsIIRequirement.exactCoefficientRequirements
  | pAdicSection => AdvancedClaimsIIRequirement.pAdicRequirements
  | entropyCardyReproducibility =>
      AdvancedClaimsIIRequirement.entropyReproRequirements
  | paperDataInstance => [AdvancedClaimsIIRequirement.paperObjectDataInstance]
  | finalAggregation => AdvancedClaimsIIRequirement.finalInstanceRequirements

theorem requirements_nonempty
    (s : AdvancedClaimsIIObjectiveSection) :
    Not (requirements s = []) := by
  cases s <;> decide

theorem paper_data_requirement_mem :
    List.Mem AdvancedClaimsIIRequirement.paperObjectDataInstance
      (requirements paperDataInstance) := by
  exact List.Mem.head _

end AdvancedClaimsIIObjectiveSection

structure AdvancedClaimsIIObjectiveCrosswalkCertificate
    (C : AdvancedClaimsIICompletionCertificate) : Prop where
  section_complete :
    forall s : AdvancedClaimsIIObjectiveSection,
      List.Mem s AdvancedClaimsIIObjectiveSection.all
  section_requirements_covered :
    forall s r,
      List.Mem r (AdvancedClaimsIIObjectiveSection.requirements s) ->
        List.Mem r C.requirements
  object_schema_payload :
    AdvancedClaimsIIObjectSchemaEvidence C
  t1t5_core_payload :
    AdvancedClaimsIIT1T5Evidence C
  spt_equalizer_tor_crt_payload :
    AdvancedClaimsIISPTKernelEvidence C
  spt_equalizer_tor_crt_requirement_payload :
    SPTKernelRequirementPayloadCertificate C
  kernel_cusp_multiplier_payload :
    SPTKernelRequirementPayloadCertificate C
  exact_coefficient_payload :
    ExactCoefficientRequirementPayloadCertificate C
  exact_coefficient_evidence :
