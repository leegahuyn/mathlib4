structure AdvancedClaimsIIFinalAuditCertificate
    (C : AdvancedClaimsIICompletionCertificate) : Prop where
  coverage_matrix :
    AdvancedClaimsIIRequirementCoverageMatrix C
  checklist :
    AdvancedClaimsIIChecklistEvidence C
  dispatch :
    AdvancedClaimsIIRequirementDispatchCertificate C
  prompt_objective_audit :
    AdvancedClaimsIIPromptObjectiveAuditCertificate C
  prompt_bullet_statement :
    AdvancedClaimsIIPromptBulletStatementCertificate C
  prompt_bullet_coverage :
    AdvancedClaimsIIPromptBulletCoverageCertificate C
  prompt_bullet_leaf_bridge :
    AdvancedClaimsIIPromptBulletLeafBridgeCertificate C
  prompt_bullet_section_audit :
    AdvancedClaimsIIPromptBulletSectionCertificate C
  leaf_ledger :
    AdvancedClaimsIIRequirementLeafLedger C
  objective_crosswalk :
    AdvancedClaimsIIObjectiveCrosswalkCertificate C
  rfl_mathematics :
    PaperInstancesHRflMathematicalContentCertificate
  rfl_fine_mathematics :
    PaperInstancesHRflFineMathematicalContentCertificate
  rfl_expanded_mathematics :
    PaperInstancesHRflExpandedMathematicalContentCertificate
  rfl_detailed_mathematics :
    PaperInstancesHRflDetailedMathematicalContentCertificate
  rlf_mathematical_payload :
    PaperInstancesHRlfMathematicalPayloadCertificate
  rlf_end_to_end_closure :
    AdvancedClaimsIIRlfEndToEndClosureCertificate C
  end_to_end_checklist_closure :
    AdvancedClaimsIIEndToEndChecklistClosureCertificate C
  section_concrete_closure :
    AdvancedClaimsIISectionConcreteClosureCertificate C
  actual_input_audit :
    AdvancedClaimsIIActualInputAuditCertificate C
  claim_group_audit :
    AdvancedClaimsIIClaimGroupAuditCertificate C
  claim_group_leaf_statements :
    AdvancedClaimsIIClaimGroupLeafStatementCertificate C
  explicit_checklist_completion :
    AdvancedClaimsIIExplicitChecklistCompletionCertificate C
  prompt_requirement_bridge :
    AdvancedClaimsIIPromptRequirementBridgeCertificate C
  every_requirement_listed :
    forall r : AdvancedClaimsIIRequirement, List.Mem r C.requirements
  every_requirement_has_leaf_statement :
    forall r : AdvancedClaimsIIRequirement,
      AdvancedClaimsIIRequirement.leafStatement C r
  listed_requirement_has_leaf_statement :
    forall r : AdvancedClaimsIIRequirement,
      List.Mem r C.requirements ->
        AdvancedClaimsIIRequirement.leafStatement C r
  listed_requirement_routes_to_section :
    forall r : AdvancedClaimsIIRequirement,
      List.Mem r C.requirements ->
        List.Mem (AdvancedClaimsIIRequirement.sectionOf r)
          AdvancedClaimsIIRequirement.Section.all
  grouped_requirements_eq_all :
    AdvancedClaimsIIRequirement.groupedRequirements =
      AdvancedClaimsIIRequirement.all
  all_requirements_nodup :
    AdvancedClaimsIIRequirement.all.Nodup
  grouped_requirements_nodup :
    AdvancedClaimsIIRequirement.groupedRequirements.Nodup
  all_requirements_length :
    AdvancedClaimsIIRequirement.all.length = 54
  objective_sections_nodup :
    AdvancedClaimsIIObjectiveSection.all.Nodup
  objective_sections_length :
    AdvancedClaimsIIObjectiveSection.all.length = 9
  paper_instance_final :
    C.paperInstance.extraction.concrete.paperObjectName =
        C.paperInstance.extraction.concrete.object.name /\
      C.paperInstance.extraction.concrete.principalPart.order = 1 /\
        C.paperInstance.extraction.concrete.rationalOLS.alphaInterval.Contains
          C.paperInstance.extraction.concrete.rationalOLS.alphaHat /\
          C.paperInstance.extraction.concrete.rationalOLS.betaInterval.Contains
            C.paperInstance.extraction.concrete.rationalOLS.betaHat

