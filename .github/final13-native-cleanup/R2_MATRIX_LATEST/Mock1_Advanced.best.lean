structure AdvancedClaimsIIFinalTheoremAggregationCertificate
    (C : AdvancedClaimsIICompletionCertificate) : Prop where
  final_audit :
    AdvancedClaimsIIFinalAuditCertificate C
  coverage_matrix :
    AdvancedClaimsIIRequirementCoverageMatrix C
  checklist :
    AdvancedClaimsIIChecklistEvidence C
  end_to_end_checklist :
    AdvancedClaimsIIEndToEndChecklistClosureCertificate C
  section_concrete :
    AdvancedClaimsIISectionConcreteClosureCertificate C
  claimwise_mathematical_closure :
    AdvancedClaimsIIClaimwiseMathematicalClosureCertificate C
  objective_category_spine :
    AdvancedClaimsIIObjectiveCategorySpineCertificate C
  atomic_leaf_closure :
    AdvancedClaimsIIAtomicLeafClosureCertificate C
  rlf_end_to_end :
    AdvancedClaimsIIRlfEndToEndClosureCertificate C
  actual_input_audit :
    AdvancedClaimsIIActualInputAuditCertificate C
  prompt_requirement_bridge :
    AdvancedClaimsIIPromptRequirementBridgeCertificate C
  explicit_completion :
    AdvancedClaimsIIExplicitChecklistCompletionCertificate C
  all_requirements_listed :
    forall r : AdvancedClaimsIIRequirement, List.Mem r C.requirements
  all_requirements_leaf :
    forall r : AdvancedClaimsIIRequirement,
      AdvancedClaimsIIRequirement.leafStatement C r
  prompt_bullet_leaf :
    forall b : AdvancedClaimsIIPromptBullet,
      AdvancedClaimsIIRequirement.leafStatement C
        (AdvancedClaimsIIPromptBullet.requirementOf b)
  remaining_claim_leaf :
    forall claim : RemainingAdvancedClaim,
      AdvancedClaimsIIRequirement.leafStatement C
        (RemainingAdvancedClaim.stageIIRequirement claim)
  section_object_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.objectSchemaRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  section_t1t5_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.t1t5Requirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  section_spt_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.sptRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  section_kernel_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.kernelRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  section_exact_leaf :
    forall r,
      List.Mem r AdvancedClaimsIIRequirement.exactCoefficientRequirements ->
        AdvancedClaimsIIRequirement.leafStatement C r
  section_padic_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.pAdicRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  section_entropy_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.entropyReproRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  final_requirement_leaf :
    forall r, List.Mem r AdvancedClaimsIIRequirement.finalInstanceRequirements ->
      AdvancedClaimsIIRequirement.leafStatement C r
  count_balance :
    AdvancedClaimsIIPromptBullet.all.length +
      AdvancedClaimsIIRequirement.finalInstanceRequirements.length =
        AdvancedClaimsIIRequirement.all.length
  final_concrete :
    C.paperInstance.extraction.concrete.paperObjectName =
        C.paperInstance.extraction.concrete.object.name /\
      C.paperInstance.extraction.concrete.principalPart.order = 1 /\
        C.paperInstance.extraction.concrete.rationalOLS.alphaInterval.Contains
          C.paperInstance.extraction.concrete.rationalOLS.alphaHat /\
          C.paperInstance.extraction.concrete.rationalOLS.betaInterval.Contains
            C.paperInstance.extraction.concrete.rationalOLS.betaHat

