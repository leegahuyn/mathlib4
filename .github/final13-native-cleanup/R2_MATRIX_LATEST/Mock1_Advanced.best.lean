  | 0 => 1
  | 1 => 5
  | 2 => 12
  | 3 => 8
  | 4 => 15
  | 5 => 0
  | _ => 0

def AdvancedClaimsIIPaperI2RawValue (n : Fin 6) : Rat :=
  (AdvancedClaimsIIPaperI2NormalizedValue (n : Nat) : Rat)

def AdvancedClaimsIIPaperI2MahlerCoefficient (j : Fin 6) : Int :=
  match (j : Nat) with
  | 0 => 1
  | 1 => 4
  | 2 => 3
  | 3 => 11
  | 4 => 11
  | 5 => 9
  | _ => 0

def AdvancedClaimsIIPaperI2MahlerRawEval (n : Nat) : Int :=
  Finset.sum Finset.univ
    (fun j : Fin 6 =>
      AdvancedClaimsIIPaperI2MahlerCoefficient j *
        mahlerBinomialBasis (j : Nat) n)

