  M.definitions.slash_weight_half

theorem slash_multiplier_T_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) :
    B.checklist.slashGeneratorWitness.action.multiplier.value_T =
      B.checklist.slashGeneratorWitness.action.multiplier.value
        ModularMatrix.T :=
