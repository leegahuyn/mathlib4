/-!
Ramanujan-specific exact coefficient formula input.

The legacy exact-coefficient certificate is a unit model.  It is retained as
an interface regression fixture, but it is not paper data.  The structures
below put the actual Ramanujan coefficient function on the left-hand side and
require all separation, theta, Rademacher/Kloosterman, local Euler, root-sign,
and central L-value identities as explicit proof fields with provenance.
-/

theorem advanced_claims_ii_ramanujan_f_coefficient_two :
    AdvancedClaimsIIRamanujanFCoefficient 2 = -2 := by
  decide

theorem advanced_claims_ii_ramanujan_f_real_coefficient_two :
    referenceAdvancedClaimsIIRamanujanFPaperObject.coeff 2 = -2 := by
  change (AdvancedClaimsIIRamanujanFCoefficient 2 : Real) = -2
  rw [advanced_claims_ii_ramanujan_f_coefficient_two]
  norm_num

theorem advanced_claims_ii_ramanujan_f_not_unit_exact_model :
    Not
      (referenceAdvancedClaimsIIRamanujanFPaperObject.coeff =
        referenceExactCoefficient) := by
  intro h
  have h2 := congrFun h 2
  rw [advanced_claims_ii_ramanujan_f_real_coefficient_two] at h2
  norm_num [referenceExactCoefficient] at h2

