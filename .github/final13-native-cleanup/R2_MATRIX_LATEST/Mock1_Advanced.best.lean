namespace Mock1Advanced

/-!
Kernel/cusp tracking layer for the Mock1 advanced registry.

The slash action and multiplier are deliberately abstract functions with
identity/matching proof fields. Numerical residual data is kept as a
diagnostic pass/fail rectangle, not promoted to a theorem.
-/

inductive PhaseGenerator where
  | T
  | S
deriving DecidableEq, Repr

structure RationalRectangle where
  realInterval : RationalInterval
  imagInterval : RationalInterval

namespace RationalRectangle

def Contains (R : RationalRectangle) (x y : Rat) : Prop :=
  R.realInterval.Contains x /\ R.imagInterval.Contains y

theorem lower_left_mem (R : RationalRectangle) :
    R.Contains R.realInterval.lower R.imagInterval.lower :=
  And.intro R.realInterval.lower_mem R.imagInterval.lower_mem

end RationalRectangle

structure KernelSelectionRecord where
  weight : Rat
  level : Nat
  level_pos : 0 < level
  multiplier : Fin level -> Complex
  multiplierTable : List Complex
  multiplierTable_length_eq_level :
    multiplierTable.length = level
  cuspData : List CuspLabel
  cuspData_nonempty :
    Not (cuspData = [])
  selection : KernelSelectionCertificate
  selected_level_eq :
    selection.selectedModulus = level
  slashAction : CuspLabel -> CuspLabel -> Complex
  slash_identity :
    forall cusp, slashAction cusp cusp = 1

namespace KernelSelectionRecord

theorem level_positive_at (R : KernelSelectionRecord) :
    0 < R.level :=
  R.level_pos

theorem multiplier_table_length_at (R : KernelSelectionRecord) :
    R.multiplierTable.length = R.level :=
  R.multiplierTable_length_eq_level

theorem cusp_data_nonempty_at (R : KernelSelectionRecord) :
    Not (R.cuspData = []) :=
  R.cuspData_nonempty

theorem selected_level_at (R : KernelSelectionRecord) :
    R.selection.selectedModulus = R.level :=
  R.selected_level_eq

theorem selection_modulus_at (R : KernelSelectionRecord) :
    R.selection.datum.modulus = R.level := by
  calc
    R.selection.datum.modulus = R.selection.selectedModulus :=
      R.selection.selected_modulus_at.symm
    _ = R.level :=
      R.selected_level_at

theorem slash_identity_at
    (R : KernelSelectionRecord) (cusp : CuspLabel) :
    R.slashAction cusp cusp = 1 :=
  R.slash_identity cusp

end KernelSelectionRecord

