/-!
Declared page-25 T3 block portfolio with exact rational weights.

The three block shifts are certified by the existing Appell-Lerch block
schema.  Their coefficient sum is exactly one, so the formal completion
correction scale is `-1/2`.  The displayed principal-term table is retained
as diagnostic input because the PDF does not provide its finite derivation.
-/

structure AdvancedClaimsIIPaperT3WeightedBlock where
  m : Rat
  r : Rat
  coefficient : Rat
deriving DecidableEq, Repr

def referenceAdvancedClaimsIIPaperT3WeightedBlocks :
    List AdvancedClaimsIIPaperT3WeightedBlock :=
  [ { m := 0, r := 0, coefficient := 1 }
  , { m := 1, r := 0, coefficient := (-1 / 2 : Rat) }
  , { m := 0, r := (1 / 2 : Rat), coefficient := (1 / 2 : Rat) }
  ]

def AdvancedClaimsIIPaperT3BlockSum : Rat :=
  (referenceAdvancedClaimsIIPaperT3WeightedBlocks.map
    (fun block => block.coefficient)).sum

def AdvancedClaimsIIPaperT3CompletionCorrectionScale : Rat :=
  -AdvancedClaimsIIPaperT3BlockSum / 2

theorem advanced_claims_ii_paper_t3_block_sum :
    AdvancedClaimsIIPaperT3BlockSum = 1 := by
  decide

theorem advanced_claims_ii_paper_t3_completion_correction_scale :
    AdvancedClaimsIIPaperT3CompletionCorrectionScale = (-1 / 2 : Rat) := by
  decide

theorem advanced_claims_ii_paper_t3_block_admissible
    (block : AdvancedClaimsIIPaperT3WeightedBlock)
    (hblock : List.Mem block referenceAdvancedClaimsIIPaperT3WeightedBlocks) :
    List.Mem block.m referenceMock1MList /\
      List.Mem block.r referenceMock1RPhases := by
  change List.Mem block
    [ { m := 0, r := 0, coefficient := 1 }
    , { m := 1, r := 0, coefficient := (-1 / 2 : Rat) }
    , { m := 0, r := (1 / 2 : Rat), coefficient := (1 / 2 : Rat) } ] at hblock
  cases hblock with
  | head =>
      exact And.intro
        (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
          (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
            (List.Mem.head _)))))))
        (List.Mem.head _)
  | tail _ hblock =>
      cases hblock with
      | head =>
          exact And.intro
            (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
              (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _
                (List.Mem.tail _ (List.Mem.tail _
                  (List.Mem.head _)))))))))
            (List.Mem.head _)
      | tail _ hblock =>
          cases hblock with
