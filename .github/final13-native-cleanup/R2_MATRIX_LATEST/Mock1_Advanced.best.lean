structure ArchimedeanIntegralValueBoundCertificate where
  sourceName : String
  integral : ArchimedeanIntegralCert
  value : Rat
  lower : Rat
  upper : Rat
  interval : RationalInterval
  sourceName_nonempty :
    Not (sourceName = "")
  value_eq_integral :
    value = integral.normalizedValueRat
  lower_eq_interval :
    lower = interval.lower
  upper_eq_interval :
    upper = interval.upper
  interval_eq_integral :
    interval = integral.valueInterval
  value_mem_interval :
    interval.Contains value
  lower_le_value :
    lower <= value
  value_le_upper :
    value <= upper
  normalizedValue_eq_value :
    integral.normalizedValue = value

