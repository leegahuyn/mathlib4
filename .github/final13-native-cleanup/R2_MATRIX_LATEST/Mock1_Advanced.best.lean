structure BetaArchimedeanCertificate where
  baseNormalization : BetaNormalizationCertificate
  betaOne : BetaOneNormalizationCertificate
  scalarRecord : ArchimedeanScalarRecord
  integral : ArchimedeanIntegralCert
  unfolding : UnfoldingIdentityCertificate
  formula : NormalizedCoefficientFormulaCertificate
  paperInput : PaperBetaArchimedeanInput
  kernelCusp : KernelCuspCertificate
  base_beta_eq_one :
    baseNormalization.beta = 1
  base_normalized_scalar_eq :
    baseNormalization.normalizedScalar = scalarRecord.scalar
  scalar_matches_unfolding :
    scalarRecord.scalar = unfolding.scalar
  scalar_matches_formula :
    formula.scalar = scalarRecord.scalar
  beta_matches_integral :
    integral.beta = betaOne.beta
  formula_coeff_matches_unfolding :
    forall n, formula.mockCoeff n = unfolding.mockCoeff n
  formula_theta_matches_unfolding :
    forall n, formula.thetaCoeff n = unfolding.thetaCoeff n
  rademacher_tail_tracked :
    formula.rademacher.tail.cutoff = kernelCusp.tailTracking.tail.tail.cutoff

namespace BetaArchimedeanCertificate

theorem base_beta_one_at (C : BetaArchimedeanCertificate) :
    C.baseNormalization.beta = 1 :=
  C.base_beta_eq_one

theorem base_normalized_scalar_at (C : BetaArchimedeanCertificate) :
    C.baseNormalization.normalizedScalar = C.scalarRecord.scalar :=
  C.base_normalized_scalar_eq

theorem scalar_unfolding_at (C : BetaArchimedeanCertificate) :
    C.scalarRecord.scalar = C.unfolding.scalar :=
  C.scalar_matches_unfolding

theorem scalar_formula_at (C : BetaArchimedeanCertificate) :
    C.formula.scalar = C.scalarRecord.scalar :=
  C.scalar_matches_formula

theorem beta_integral_at (C : BetaArchimedeanCertificate) :
    C.integral.beta = C.betaOne.beta :=
  C.beta_matches_integral

theorem formula_mock_at
    (C : BetaArchimedeanCertificate) (n : Nat) :
    C.formula.mockCoeff n = C.unfolding.mockCoeff n :=
  C.formula_coeff_matches_unfolding n

theorem formula_theta_at
    (C : BetaArchimedeanCertificate) (n : Nat) :
    C.formula.thetaCoeff n = C.unfolding.thetaCoeff n :=
  C.formula_theta_matches_unfolding n

theorem rademacher_tail_tracked_at (C : BetaArchimedeanCertificate) :
    C.formula.rademacher.tail.cutoff =
      C.kernelCusp.tailTracking.tail.tail.cutoff :=
  C.rademacher_tail_tracked

theorem final_coefficient_formula_at
    (C : BetaArchimedeanCertificate) (n : Nat) :
    C.formula.normalizedCoeff n =
      C.scalarRecord.scalar *
        (C.unfolding.mockCoeff n * C.unfolding.thetaCoeff n) := by
  calc
    C.formula.normalizedCoeff n =
        C.formula.scalar * (C.formula.mockCoeff n * C.formula.thetaCoeff n) :=
      C.formula.coefficient_formula_at n
    _ =
        C.scalarRecord.scalar *
          (C.unfolding.mockCoeff n * C.formula.thetaCoeff n) := by
      rw [C.scalar_formula_at, C.formula_mock_at n]
    _ =
        C.scalarRecord.scalar *
          (C.unfolding.mockCoeff n * C.unfolding.thetaCoeff n) := by
      rw [C.formula_theta_at n]

theorem final_formula_rademacher_link_at
    (C : BetaArchimedeanCertificate) (n : Nat) :
    C.formula.normalizedCoeff n =
