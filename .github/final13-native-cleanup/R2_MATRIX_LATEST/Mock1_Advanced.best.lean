    I.transports.length = 3 := by
  simp [transports, referenceAdvancedClaimsIIPaperItem1Cusps]

theorem family_rows_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt) :
    I.toFamily.stacked.rowCount = I.toFamily.transports.length :=
  I.toFamily.row_count_at

theorem transport_data_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps) :
    (I.transportAt cusp).source = infinityCuspLabel /\
      (I.transportAt cusp).target = cusp /\
        (I.transportAt cusp).principal =
          referenceAdvancedClaimsIIRamanujanFPaperObjectSchema.principal :=
  And.intro (I.sourceAt cusp hcusp)
    (And.intro (I.targetAt cusp hcusp) (I.principalAt cusp hcusp))

theorem convergence_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps) :
    ConvergesAt cusp :=
  I.convergenceAt cusp hcusp

theorem analytic_provenance_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps) :
    Not (I.sourceName = "") /\
      Not (I.replacementPlan = "") /\
        Not (I.convergenceSourceAt cusp = "") :=
  And.intro I.sourceName_nonempty
    (And.intro I.replacementPlan_nonempty
      (I.convergenceSourceAt_nonempty cusp hcusp))

theorem target_coverage_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt)
    (cusp : CuspLabel)
    (hcusp : List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps) :
    exists T : TransportedPrincipalPart,
      List.Mem T I.transports /\ T.target = cusp := by
  refine Exists.intro (I.transportAt cusp) ?_
  exact And.intro
    (List.mem_map.mpr (Exists.intro cusp (And.intro hcusp rfl)))
    (I.targetAt cusp hcusp)

theorem one_cusp_transport_at {ConvergesAt : CuspLabel -> Prop}
    (I : AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput ConvergesAt) :
    (I.transportAt advancedClaimsIIPaperItem1OneCuspLabel).source =
          infinityCuspLabel /\
      (I.transportAt advancedClaimsIIPaperItem1OneCuspLabel).target =
          advancedClaimsIIPaperItem1OneCuspLabel /\
        (I.transportAt advancedClaimsIIPaperItem1OneCuspLabel).principal =
            referenceAdvancedClaimsIIRamanujanFPaperObjectSchema.principal /\
          ConvergesAt advancedClaimsIIPaperItem1OneCuspLabel :=
  And.intro
    (I.sourceAt advancedClaimsIIPaperItem1OneCuspLabel
      advanced_claims_ii_paper_item1_one_cusp_relevant)
    (And.intro
      (I.targetAt advancedClaimsIIPaperItem1OneCuspLabel
        advanced_claims_ii_paper_item1_one_cusp_relevant)
      (And.intro
        (I.principalAt advancedClaimsIIPaperItem1OneCuspLabel
          advanced_claims_ii_paper_item1_one_cusp_relevant)
        (I.convergenceAt advancedClaimsIIPaperItem1OneCuspLabel
          advanced_claims_ii_paper_item1_one_cusp_relevant)))

