/-!
Conditional constructor for transport across every paper cusp.

`ConvergesAt` is an explicit analytic predicate supplied by the caller.  The
input must provide a transport from infinity to each of the three paper cusp
labels, identify every transported principal part with the actual Ramanujan
schema, and prove `ConvergesAt` at each required cusp.  Thus this constructor
cannot turn the finite two-cusp reference model into a global theorem without
the missing mathematical evidence.
-/

def referenceAdvancedClaimsIIRamanujanFPaperCuspStackedSystem :
    StackedCuspSystem where
  cuspCount := referenceAdvancedClaimsIIPaperItem1Cusps.length
  rowCount := referenceAdvancedClaimsIIPaperItem1Cusps.length
  cuspCount_pos := by
    norm_num [referenceAdvancedClaimsIIPaperItem1Cusps]
  rowCount_pos := by
    norm_num [referenceAdvancedClaimsIIPaperItem1Cusps]

structure AdvancedClaimsIIRamanujanFAllPaperCuspsProofInput
    (ConvergesAt : CuspLabel -> Prop) where
  sourceName : String
  replacementPlan : String
  convergenceSourceAt : CuspLabel -> String
  transportAt : CuspLabel -> TransportedPrincipalPart
  sourceName_nonempty :
    Not (sourceName = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  convergenceSourceAt_nonempty :
    forall cusp : CuspLabel,
      List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps ->
        Not (convergenceSourceAt cusp = "")
  sourceAt :
    forall cusp : CuspLabel,
      List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps ->
        (transportAt cusp).source = infinityCuspLabel
  targetAt :
    forall cusp : CuspLabel,
      List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps ->
        (transportAt cusp).target = cusp
  principalAt :
    forall cusp : CuspLabel,
      List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps ->
        (transportAt cusp).principal =
          referenceAdvancedClaimsIIRamanujanFPaperObjectSchema.principal
  convergenceAt :
    forall cusp : CuspLabel,
      List.Mem cusp referenceAdvancedClaimsIIPaperItem1Cusps ->
        ConvergesAt cusp

