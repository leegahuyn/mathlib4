theorem object_qseries_coeff_at (C : FormalizationChecklist)
    (n : Nat) :
    C.qSeriesWitness.coeff n = C.paperObjectWitness.coeff n := by
  calc
    C.qSeriesWitness.coeff n =
        C.objectQSeriesWitness.series.coeff n := by
      rw [C.objectQSeriesWitness_series]
    _ = C.objectQSeriesWitness.object.coeff n :=
      C.objectQSeriesWitness.coeff_eq_object n
    _ = C.paperObjectWitness.coeff n := by
      rw [C.objectQSeriesWitness_object]

theorem object_qseries_coefficient_at (C : FormalizationChecklist)
    (n : Nat) :
    C.qSeriesWitness.coefficientAt n = C.paperObjectWitness.coeff n := by
  calc
    C.qSeriesWitness.coefficientAt n = C.qSeriesWitness.coeff n := rfl
    _ = C.paperObjectWitness.coeff n := C.object_qseries_coeff_at n

