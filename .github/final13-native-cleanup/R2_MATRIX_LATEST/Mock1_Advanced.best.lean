structure EndToEndCertificationEvidence where
  readiness : CertificationReadiness
  requirements :
    forall key : RequirementKey,
      List.Mem key RequirementKey.all ->
        RequirementKey.Covered readiness.completeness.manifest.bundle key
  objectives :
    forall item : ObjectiveItem,
      List.Mem item ObjectiveItem.all ->
        RequirementKey.Covered readiness.completeness.manifest.bundle
          (ObjectiveItem.primaryRequirement item)
  requestedDefinitions :
    forall item : RequestedDefinitionItem,
      List.Mem item RequestedDefinitionItem.all ->
        RequestedDefinitionItem.Covered
          readiness.requestedDefinitionAudit.checklist item
  requestedRequirements :
    forall item : RequestedDefinitionItem,
      RequirementKey.Covered readiness.completeness.manifest.bundle
        (RequestedDefinitionItem.primaryRequirement item)
  requestedLayered :
    forall item : RequestedDefinitionItem,
      List.Mem (RequestedDefinitionItem.primaryObjective item)
        (IntegratedLayer.objectives
          (readiness.requestedDefinitionLayerMatrix.itemLayer item))
  requestedLayerFileNonempty :
    forall item : RequestedDefinitionItem,
      Not (IntegratedLayer.fileName
        (readiness.requestedDefinitionLayerMatrix.itemLayer item) = "")
  objectiveDefinitions :
    ObjectiveDefinitionMatrix readiness.completeness.manifest.bundle
  namedRequirements :
    NamedRequirementCoverage readiness.completeness.manifest.bundle
  requirementAudit :
    CertificationRequirementAudit Unit readiness.completeness.manifest.bundle
  proofPayload :
    CertificateProofPayload readiness.completeness.manifest.bundle.abstract
      readiness.completeness.manifest.bundle.concrete
  proofFields :
    ProofFieldDischargeMatrix readiness.completeness.manifest.bundle
  checklistDefinitions :
    DefinitionCoverage readiness.completeness.manifest.bundle.checklist
  localLeanCommand :
    readiness.completeness.localAudit.commands LocalAuditCommand.leanFileCheck =
      "lake env lean outputs/Mock1_Integrated.lean"
  localStaticScanCommand :
    readiness.completeness.localAudit.commands LocalAuditCommand.staticTextScan =
      "pwsh -File scripts/audit.ps1"
  localHashCommand :
    readiness.completeness.localAudit.commands LocalAuditCommand.hashSnapshot =
      "Get-FileHash -Algorithm SHA256 outputs/Mock1_Integrated.lean"
  printAxiomsCovers :
    forall layer : AxiomAuditLayer,
      List.Mem layer
        (readiness.completeness.localAudit.commandLayers
          LocalAuditCommand.printAxiomsAudit)
  environmentToolchain :
    readiness.completeness.environmentPin.leanToolchainSpec =
      "leanprover/lean4:v4.31.0"
  environmentMathlibCommit :
    readiness.completeness.environmentPin.mathlibCommit =
      "fabf563a7c95a166b8d7b6efca11c8b4dc9d911f"
  environmentCIWorkflow :
    readiness.completeness.environmentPin.ciWorkflowPath =
      ".github/workflows/lean.yml"

