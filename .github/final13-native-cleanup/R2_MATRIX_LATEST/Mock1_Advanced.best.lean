def pAdicRequirementPayload
    (C : AdvancedClaimsIICompletionCertificate) :
    PAdicRequirementPayloadCertificate C where
  padic_normalization_wrapper :=
    C.pAdicEvidence.normalization_at
  overlap_gluing_wrapper :=
    C.pAdicEvidence.overlap_gluing_at
  mahler_interpolation_wrapper := by
    intro n
    exact And.intro (C.pAdicEvidence.mahler_at n)
      (C.pAdicEvidence.mahler_formula_at n)
  analytic_range_tail_zero_wrapper := by
    intro n hn
    have hp : C.padicAnalyticRange.predicate n :=
      C.pAdicEvidence.analytic_range_predicate_at n hn
    exact And.intro hp (C.pAdicEvidence.analytic_tail_zero_at n hp)
  global_padic_face_tracking := by
    exact And.intro C.pAdicEvidence.labels_at.1
      (And.intro C.pAdicEvidence.labels_at.2.1
        (And.intro C.pAdicEvidence.labels_at.2.2.1
          (And.intro C.pAdicEvidence.labels_at.2.2.2
            C.pAdicEvidence.face_labels_at)))
  denominator_clearing_data :=
    C.pAdicEvidence.denominator_data_at
  chart_vectors_modulo_prime_power :=
    C.pAdicEvidence.chart_vectors_mod_at
  mahler_table_interpolation_vector := by
    intro n
    exact And.intro (C.pAdicEvidence.mahler_binomial_at n)
      (C.pAdicEvidence.mahler_binomial_formula_at n)
  analytic_range_predicate :=
    C.pAdicEvidence.analytic_range_predicate_at
  obstruction_failure_case_instance :=
    C.pAdicEvidence.obstruction_failure_at

