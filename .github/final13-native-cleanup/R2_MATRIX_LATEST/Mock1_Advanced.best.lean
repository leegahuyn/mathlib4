/-!
Bridge from the general unconditional certificate stack to the advanced-claim
checklist.

The first infrastructure layer establishes `AbstractCertificate`,
`ConcreteCertificate`, `UnconditionalCertificationBundle`, and the proof-field
matrix.  The advanced-claim layer establishes prompt-level and formula-level
coverage for the paper claims.  This bridge records that both layers are the
same reference certification route and exposes the key projections as small
lemmas.
-/

structure AdvancedClaimsIIAbstractConcreteCertificationBridgeCertificate :
    Type where
  route :
    CertificateRoute Unit
  bundle :
    UnconditionalCertificationBundle Unit
  proof_payload :
    CertificateProofPayload referenceCertificationBundle.abstract
      referenceCertificationBundle.concrete
  proof_field_matrix :
    ProofFieldDischargeMatrix referenceCertificationBundle
  requirement_audit :
    CertificationRequirementAudit Unit referenceCertificationBundle
  objective_audit :
    ObjectiveAuditMatrix referenceCertificationBundle
  definition_audit :
    RequestedDefinitionAuditMatrix referenceCertificationBundle
  unconditional_policy :
    UnconditionalityPolicy
  advanced_readiness :
    AdvancedClaimsIIUnconditionalCertificationReadinessCertificate
  final_aggregation :
    AdvancedClaimsIIFinalTheoremAggregationCertificate
      referenceAdvancedClaimsIICompletionCertificate
  rlf_enriched :
    AdvancedClaimsIIRlfEnrichedMathematicalContentCertificate
  route_is_reference :
    route = referenceCertificateRoute
  bundle_is_reference :
    bundle = referenceCertificationBundle
  concrete_extends_abstract :
    referenceCertificationBundle.concrete.toAbstractCertificate =
      referenceCertificationBundle.abstract
  route_concrete_extends :
    referenceCertificateRoute.concreteLayer.toAbstractCertificate =
      referenceCertificateRoute.abstractLayer
  route_checklist_object :
    referenceCertificateRoute.checklistLayer.paperObjectWitness =
      referenceCertificateRoute.abstractLayer.object
  route_checklist_qseries_object :
    referenceCertificateRoute.checklistLayer.objectQSeriesWitness.object =
      referenceCertificateRoute.abstractLayer.object
  abstract_payload :
    AbstractProofPayload referenceCertificationBundle.abstract
  concrete_payload :
    ConcreteProofPayload referenceCertificationBundle.concrete
  abstract_entropy :
    EntropyGrowth referenceCertificationBundle.abstract.object.coeff
      referenceCertificationBundle.abstract.alpha
      referenceCertificationBundle.abstract.beta
  abstract_entropy_epsilon :
    EntropyGrowthEpsilonN referenceCertificationBundle.abstract.object.coeff
      referenceCertificationBundle.abstract.alpha
      referenceCertificationBundle.abstract.beta
  abstract_regression_interval :
    referenceCertificationBundle.abstract.regression.alphaInterval.Contains
        referenceCertificationBundle.abstract.regression.alphaHat /\
      referenceCertificationBundle.abstract.regression.betaInterval.Contains
        referenceCertificationBundle.abstract.regression.betaHat
  concrete_principal_part :
    forall i : Fin referenceCertificationBundle.concrete.principalPartLink.principal.order,
      referenceCertificationBundle.concrete.principalPartLink.principal.coeffAt i =
        referenceCertificationBundle.concrete.principalPartLink.laurent.coeff
          (-(((i : Nat) + 1 : Nat) : Int))
  concrete_spt_equalizer :
    ArithmeticEqualizer referenceCertificationBundle.concrete.sptIdeal.spt.M
      (referenceCertificationBundle.concrete.sptIdeal.spt.p ^
        referenceCertificationBundle.concrete.sptIdeal.spt.k)
      referenceCertificationBundle.concrete.sptIdeal.spt.equalizerElement
  concrete_tor_cyclic :
    referenceCertificationBundle.concrete.torSurrogate.obstructionQuotient.order =
      Nat.gcd referenceCertificationBundle.concrete.spt.M
        (referenceCertificationBundle.concrete.spt.p ^
          referenceCertificationBundle.concrete.spt.k)
  concrete_ols_interval :
    referenceCertificationBundle.concrete.rationalOLS.alphaInterval.Contains
        referenceCertificationBundle.concrete.rationalOLS.alphaHat /\
      referenceCertificationBundle.concrete.rationalOLS.betaInterval.Contains
        referenceCertificationBundle.concrete.rationalOLS.betaHat
  advanced_every_prompt :
    forall b : AdvancedClaimsIIPromptBullet,
      AdvancedClaimsIIPromptBullet.statement
          referenceAdvancedClaimsIICompletionCertificate b /\
        AdvancedClaimsIIRequirement.leafStatement
          referenceAdvancedClaimsIICompletionCertificate
          (AdvancedClaimsIIPromptBullet.requirementOf b)
  advanced_every_requirement :
    forall r : AdvancedClaimsIIRequirement,
      AdvancedClaimsIIRequirement.leafStatement
        referenceAdvancedClaimsIICompletionCertificate r
  advanced_requirement_listed :
    forall r : AdvancedClaimsIIRequirement,
      List.Mem r AdvancedClaimsIIRequirement.all
  enriched_rlf_rademacher :
    forall n : Nat,
      referencePaperInstancesHRflConcrete.qSeriesCertificate.series.coeff n =
          (referencePaperInstancesHRflConcrete.rademacherExpansion.expansion n).truncation
            (referencePaperInstancesHRflConcrete.rademacherExpansion.cutoff n) +
              referencePaperInstancesHRflConcrete.rademacherExpansion.remainder n /\
        referencePaperInstancesHCompletionCertificate.t1t5.exactCoefficient.formula.coefficient n =
          referencePaperInstancesHCompletionCertificate.t1t5.exactCoefficient.spectral.rademacher.main n +
            referencePaperInstancesHCompletionCertificate.t1t5.exactCoefficient.spectral.rademacher.remainder n
  enriched_rlf_term :
    forall c : Nat,
      referencePaperInstancesHRflConcrete.rademacherKernel.expansion.multiplier c =
          KloostermanSum
            (referencePaperInstancesHRflConcrete.rademacherKernel.kernelCertificate c).datum /\
        referencePaperInstancesHRflConcrete.rademacherTerms.expansion.term c =
          (referencePaperInstancesHRflConcrete.rademacherTerms.termCertificate c).data.amplitude *
            BesselIHalfModel
              (referencePaperInstancesHRflConcrete.rademacherTerms.termCertificate c).data.besselArgument

