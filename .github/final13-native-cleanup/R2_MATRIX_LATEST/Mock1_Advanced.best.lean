    Not (rawIntegralSymbol = "")
  normalizedValue : Real
  normalizedValueRat : Rat
  normalizedValue_eq_rat :
    normalizedValue = normalizedValueRat
  valueInterval : RationalInterval
  normalizedValue_mem_interval :
    valueInterval.Contains normalizedValueRat
  noResidualGammaTerm : Prop
  noResidualGammaTerm_proof :
    noResidualGammaTerm

namespace ArchimedeanIntegralCert

