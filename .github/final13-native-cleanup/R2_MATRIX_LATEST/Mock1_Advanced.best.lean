  AxiomAuditLayer.targets_length_pos (auditLayer item)

theorem primaryRequirement_covered {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequirementCoverageMatrix B)
    (item : ObjectiveItem) :
    RequirementKey.Covered B (primaryRequirement item) :=
  M.covered (primaryRequirement item)

end ObjectiveItem

structure ObjectiveAuditMatrix {X : Type*}
    (B : UnconditionalCertificationBundle X) : Prop where
  requirementMatrix : RequirementCoverageMatrix B
  objectiveCovered :
    forall item : ObjectiveItem,
      RequirementKey.Covered B (ObjectiveItem.primaryRequirement item)
  allItemsCovered :
    forall item : ObjectiveItem,
      List.Mem item ObjectiveItem.all ->
        RequirementKey.Covered B (ObjectiveItem.primaryRequirement item)
  auditTargetsNonempty :
    forall item : ObjectiveItem,
      0 < (AxiomAuditLayer.targets
        (ObjectiveItem.auditLayer item)).length

namespace ObjectiveAuditMatrix

theorem requirement_matrix_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (O : ObjectiveAuditMatrix B) :
    RequirementCoverageMatrix B :=
  O.requirementMatrix

theorem covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (O : ObjectiveAuditMatrix B) (item : ObjectiveItem) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  O.objectiveCovered item

theorem all_item_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (O : ObjectiveAuditMatrix B) (item : ObjectiveItem)
    (hmem : List.Mem item ObjectiveItem.all) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  O.allItemsCovered item hmem

theorem audit_targets_nonempty_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (O : ObjectiveAuditMatrix B) (item : ObjectiveItem) :
    0 < (AxiomAuditLayer.targets
      (ObjectiveItem.auditLayer item)).length :=
  O.auditTargetsNonempty item

end ObjectiveAuditMatrix

structure ObjectiveDefinitionMatrix {X : Type*}
    (B : UnconditionalCertificationBundle X) : Prop where
  definitions : DefinitionCoverage B.checklist
  objectiveMatrix : ObjectiveAuditMatrix B
  objectiveDefinitionCovered :
    forall item : ObjectiveItem,
      RequirementKey.Covered B (ObjectiveItem.primaryRequirement item)

namespace ObjectiveDefinitionMatrix

theorem definitions_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) :
    DefinitionCoverage B.checklist :=
  M.definitions

theorem objective_matrix_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) :
    ObjectiveAuditMatrix B :=
  M.objectiveMatrix

theorem covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (item : ObjectiveItem) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  M.objectiveDefinitionCovered item

theorem all_item_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (item : ObjectiveItem)
    (hmem : List.Mem item ObjectiveItem.all) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  M.objectiveMatrix.all_item_covered_at item hmem

theorem domain_upper_half_plane_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    0 < (B.checklist.domainPoint tau).z.im :=
  M.definitions.upper_half_plane_domain tau

theorem domain_q_parameter_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    qParameter tau =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I * tau.z) :=
  M.definitions.q_parameter_exp tau

theorem domain_cusp_transport_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (T : CuspTransport)
    (tau : UpperHalfPlanePoint) :
    B.checklist.cuspTransport T tau = qParameter (T.act tau) :=
  M.definitions.cusp_transport_q T tau

theorem domain_certified_cusp_transport_q_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    qParameter (B.checklist.cuspTransportCertificate.transport.act tau) =
      Complex.exp ((((2 : Real) * Real.pi) : Complex) * Complex.I *
        B.checklist.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau) :=
  M.definitions.certified_cusp_transport_q tau

theorem domain_certified_cusp_transport_formula_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (tau : UpperHalfPlanePoint) :
    (B.checklist.cuspTransportCertificate.transport.act tau).z =
      B.checklist.cuspTransportCertificate.transport.matrix.fractionalLinearFormula tau :=
  M.definitions.certified_cusp_transport_formula tau

theorem qseries_coeff_extract_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (n : Nat) :
    B.checklist.qSeriesWitness.coefficientAt n =
      B.checklist.qSeriesWitness.coeff n :=
  M.definitions.qseries_coeff_extract n

theorem qseries_truncated_prefix_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) {n : Nat}
    (h : n < B.checklist.qSeriesPrefixWitness.truncated.length) :
    B.checklist.qSeriesPrefixWitness.truncated.coefficientAt n =
      B.checklist.qSeriesPrefixWitness.full.coeff n :=
  M.definitions.truncated_prefix n h

theorem qseries_truncated_eval_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (q : Real) :
    B.checklist.qSeriesPrefixWitness.truncatedEval q =
      B.checklist.qSeriesPrefixWitness.fullPrefixEval q :=
  M.definitions.truncated_eval q

theorem qseries_truncated_coeff_sum_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) :
    B.checklist.qSeriesPrefixWitness.truncatedCoeffSum =
      B.checklist.qSeriesPrefixWitness.fullPrefixCoeffSum :=
  M.definitions.truncated_coeff_sum

theorem qseries_finite_support_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) {n : Nat}
    (hn : B.checklist.finiteSupportWitness.cutoff <= n) :
    B.checklist.finiteSupportWitness.series.coefficientAt n = 0 :=
  M.definitions.finite_support n hn

theorem laurent_principal_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) (n : Nat) :
    B.checklist.laurentWitness.principalCoeff n =
      B.checklist.laurentWitness.coeff (-((n + 1 : Nat) : Int)) :=
  M.definitions.laurent_principal n

theorem principal_part_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B)
    (i : Fin B.checklist.principalPartLink.principal.order) :
    B.checklist.principalPartLink.principal.coeffAt i =
      B.checklist.principalPartLink.laurent.coeff
        (-(((i : Nat) + 1 : Nat) : Int)) :=
  M.definitions.principal_part i

theorem principal_laurent_link_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : ObjectiveDefinitionMatrix B) :
    B.checklist.principalPartLink.laurent = B.checklist.laurentWitness :=
