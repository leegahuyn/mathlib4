theorem checklist_object_at {X : Type*}
    (R : CertificateRoute X) :
    R.checklistLayer.paperObjectWitness = R.abstractLayer.object :=
  R.checklist_object

theorem checklist_qseries_object_at {X : Type*}
    (R : CertificateRoute X) :
    R.checklistLayer.objectQSeriesWitness.object =
      R.abstractLayer.object :=
  R.checklist_qseries_object

end CertificateRoute

def referenceCertificateRoute :
    CertificateRoute Unit where
  abstractLayer := referenceCertificationBundle.abstract
  concreteLayer := referenceCertificationBundle.concrete
  checklistLayer := referenceCertificationBundle.checklist
  bundleLayer := referenceCertificationBundle
  concrete_to_abstract :=
    referenceCertificationBundle.concrete_extends_abstract
  bundle_abstract := rfl
  bundle_concrete := rfl
  bundle_checklist := rfl
  checklist_object := referenceCertificationBundle.checklist_object
  checklist_qseries_object :=
    referenceCertificationBundle.checklist_qseries_object

theorem reference_certificate_route_concrete_to_abstract :
    referenceCertificateRoute.concreteLayer.toAbstractCertificate =
      referenceCertificateRoute.abstractLayer :=
  referenceCertificateRoute.concrete_to_abstract_at

theorem reference_certificate_route_checklist_object :
    referenceCertificateRoute.checklistLayer.paperObjectWitness =
      referenceCertificateRoute.abstractLayer.object :=
  referenceCertificateRoute.checklist_object_at

theorem reference_certificate_route_qseries_object :
    referenceCertificateRoute.checklistLayer.objectQSeriesWitness.object =
      referenceCertificateRoute.abstractLayer.object :=
  referenceCertificateRoute.checklist_qseries_object_at

