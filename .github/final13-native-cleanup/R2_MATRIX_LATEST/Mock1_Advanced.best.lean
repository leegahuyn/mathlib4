def paperDataInstancePayload
    (C : AdvancedClaimsIICompletionCertificate) :
    PaperDataInstancePayloadCertificate C where
  claim_registry_data := by
    exact And.intro C.advanced.registry.requirements_eq_all
      (And.intro C.advanced.registry.registry_nonempty_at
        (And.intro C.advanced.registry.source_nonempty_at
          C.advanced.registry.covers_at))
  object_coefficient_data := by
    exact And.intro C.advanced.objectSchema.schema_object_name_at
      (And.intro C.advanced.objectSchema.family_object_name_at
        (And.intro C.advanced.objectSchema.concrete_object_at
          (And.intro C.advanced.coefficient_schema_same
            C.advanced.objectSchema.coefficientAt_eq_object)))
  paper_object_instance_data := by
    exact And.intro C.paperInstance.extraction_concrete_at
      (And.intro C.paperInstance.family_link_at
        (And.intro C.paperInstance.object_family_selected_at.1
          (And.intro C.paperInstance.object_family_selected_at.2
            C.paperInstance.family.source_nonempty_at)))
  family_parameter_data := by
    exact And.intro C.paperInstance.family.weight_half_at.1
      (And.intro C.paperInstance.family.weight_half_at.2
        (And.intro C.paperInstance.family.level_positive_at
          (And.intro C.paperInstance.family.q_shift_zero_at
            (And.intro C.paperInstance.family.working_cusp_at
