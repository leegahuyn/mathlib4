structure IntegratedLayerAudit {X : Type*}
    (B : UnconditionalCertificationBundle X) : Prop where
  objectiveMatrix : ObjectiveAuditMatrix B
  layerObjectivesCovered :
    forall layer : IntegratedLayer,
      forall item : ObjectiveItem,
        List.Mem item (IntegratedLayer.objectives layer) ->
          RequirementKey.Covered B (ObjectiveItem.primaryRequirement item)
  everyObjectivePlaced :
    forall item : ObjectiveItem,
      exists layer : IntegratedLayer,
        List.Mem item (IntegratedLayer.objectives layer)
  layerObjectivesNonempty :
    forall layer : IntegratedLayer,
      0 < (IntegratedLayer.objectives layer).length

namespace IntegratedLayerAudit

theorem objective_matrix_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (L : IntegratedLayerAudit B) :
    ObjectiveAuditMatrix B :=
  L.objectiveMatrix

theorem layer_objective_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (L : IntegratedLayerAudit B)
    (layer : IntegratedLayer) (item : ObjectiveItem)
    (hmem : List.Mem item (IntegratedLayer.objectives layer)) :
    RequirementKey.Covered B (ObjectiveItem.primaryRequirement item) :=
  L.layerObjectivesCovered layer item hmem

theorem objective_has_layer {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (L : IntegratedLayerAudit B) (item : ObjectiveItem) :
    exists layer : IntegratedLayer,
      List.Mem item (IntegratedLayer.objectives layer) :=
  L.everyObjectivePlaced item

theorem layer_objectives_nonempty_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (L : IntegratedLayerAudit B) (layer : IntegratedLayer) :
    0 < (IntegratedLayer.objectives layer).length :=
  L.layerObjectivesNonempty layer

end IntegratedLayerAudit

structure RequestedDefinitionLayerMatrix {X : Type*}
    (B : UnconditionalCertificationBundle X) where
  requestedAudit : RequestedDefinitionAuditMatrix B
  integratedAudit : IntegratedLayerAudit B
  itemLayer : RequestedDefinitionItem -> IntegratedLayer
  itemLayer_eq :
    itemLayer = RequestedDefinitionItem.integratedLayer
  itemObjectivePlaced :
    forall item : RequestedDefinitionItem,
      List.Mem (RequestedDefinitionItem.primaryObjective item)
        (IntegratedLayer.objectives (itemLayer item))
  itemRequirementCovered :
    forall item : RequestedDefinitionItem,
      RequirementKey.Covered B
        (RequestedDefinitionItem.primaryRequirement item)
  itemFileNameNonempty :
    forall item : RequestedDefinitionItem,
      Not (IntegratedLayer.fileName (itemLayer item) = "")

namespace RequestedDefinitionLayerMatrix

theorem requested_audit_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B) :
    RequestedDefinitionAuditMatrix B :=
  M.requestedAudit

theorem integrated_audit_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B) :
    IntegratedLayerAudit B :=
  M.integratedAudit

theorem layer_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B)
    (item : RequestedDefinitionItem) :
    M.itemLayer item = RequestedDefinitionItem.integratedLayer item := by
  rw [M.itemLayer_eq]

theorem objective_placed_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B)
    (item : RequestedDefinitionItem) :
    List.Mem (RequestedDefinitionItem.primaryObjective item)
      (IntegratedLayer.objectives (M.itemLayer item)) :=
  M.itemObjectivePlaced item

theorem requirement_covered_at {X : Type*}
    {B : UnconditionalCertificationBundle X}
    (M : RequestedDefinitionLayerMatrix B)
    (item : RequestedDefinitionItem) :
    RequirementKey.Covered B
      (RequestedDefinitionItem.primaryRequirement item) :=
  M.itemRequirementCovered item

