/-!
Claim-wise atomic discharge for every prompt bullet.

The objective checklist is phrased item by item.  This layer turns each
`AdvancedClaimsIIPromptBullet` into a standalone certificate containing its
global membership, requirement membership, prompt statement, leaf statement,
and statement/leaf equivalence.
-/

structure AdvancedClaimsIIClaimwiseAtomicDischargeCertificate
    (b : AdvancedClaimsIIPromptBullet) : Prop where
  bullet_listed :
    List.Mem b AdvancedClaimsIIPromptBullet.all
  requirement_listed_global :
    List.Mem (AdvancedClaimsIIPromptBullet.requirementOf b)
      AdvancedClaimsIIRequirement.all
  requirement_listed_certificate :
    List.Mem (AdvancedClaimsIIPromptBullet.requirementOf b)
      referenceAdvancedClaimsIICompletionCertificate.requirements
  prompt_statement :
    AdvancedClaimsIIPromptBullet.statement
      referenceAdvancedClaimsIICompletionCertificate b
  leaf_statement :
    AdvancedClaimsIIRequirement.leafStatement
      referenceAdvancedClaimsIICompletionCertificate
      (AdvancedClaimsIIPromptBullet.requirementOf b)
  statement_iff_leaf :
    AdvancedClaimsIIPromptBullet.statement
        referenceAdvancedClaimsIICompletionCertificate b <->
      AdvancedClaimsIIRequirement.leafStatement
        referenceAdvancedClaimsIICompletionCertificate
        (AdvancedClaimsIIPromptBullet.requirementOf b)

