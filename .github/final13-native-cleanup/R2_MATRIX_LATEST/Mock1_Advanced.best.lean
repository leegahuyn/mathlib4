namespace FormalizationChecklist

theorem definition_coverage (C : FormalizationChecklist) :
    DefinitionCoverage C where
  upper_half_plane_domain := by
    intro tau
    exact (C.domainPoint tau).im_pos
  q_parameter_exp := C.q_formula_at
  cusp_transport_q := C.transport_q_at
  certified_cusp_transport_q := C.certified_cusp_transport_q_at
  certified_cusp_transport_formula := C.certified_cusp_transport_formula_at
  cusp_route_source := C.certified_cusp_source
  cusp_route_target := C.certified_cusp_target
  cusp_route_matrix := C.certified_cusp_matrix
  qseries_coeff_extract := C.qseries_coefficient_at
  truncated_prefix := by
    intro n h
    exact C.truncated_prefix_at h
  truncated_eval := C.truncated_eval_eq_full_prefix_eval
  truncated_coeff_sum := C.truncated_coeff_sum_eq_full_prefix_sum
  finite_support := by
    intro n hn
    exact C.finite_support_zero_at hn
  laurent_principal := by
    intro n
    rfl
  principal_part := C.principal_part_link_at
  principal_laurent_link := C.principal_part_laurent_link
  principal_witness_link := C.principal_part_witness_link
  polar_profile_formula := C.polar_profile_exponent_at
  polar_profile := C.polar_profile_negative_at
  polar_witness_link := C.polar_profile_witness_link
  appell_u0_v0 := C.appell_u0_sub_v0_at
  appell_mu_specialization := C.appell_specialized_mu_at
  appell_muHat_u0_v0 := by
    intro tau
    exact C.appellLerchWitness.specializedMuHat_eq_muHat_u0_v0 tau
  appell_muHat_general := by
    intro u v tau
    exact C.appellLerchWitness.muHat_eq_mu_add_R u v tau
  appell_completion := C.appell_completion_term_at
  appell_muHat_completion := C.appell_specialized_muHat_completion_at
  unary_theta_shadow := by
    intro tau
    exact C.appellLerchWitness.gz_eq_unaryThetaAt tau
  xi_shadow := C.xi_eq_shadow_at
  slash_weight_half := C.slash_generator_weight_half
  slash_multiplier_T := C.slash_multiplier_T
  slash_multiplier_S := C.slash_multiplier_S
  slash_T_transport := C.slash_generator_T_via_transport
  slash_S_transport := C.slash_generator_S_via_transport
  slash_T_transport_q := C.slash_generator_T_q_at
  slash_S_transport_q := C.slash_generator_S_q_at
  slash_T_transport_formula := C.slash_generator_T_formula_at
  slash_S_transport_formula := C.slash_generator_S_formula_at
  linear_int_system := C.linear_int_at
  linear_rat_system := C.linear_rat_at
  linear_complex_interval := C.complex_interval_zero_at
  linear_int_rows_principal := C.linear_int_rows_principal
  linear_rat_rows_principal := C.linear_rat_rows_principal
  linear_complex_rows_principal := C.linear_complex_rows_principal
  entropy_epsilonN := C.entropyWitness.epsilonN_form
  entropy_littleO := C.entropy_littleO
  rademacher_expansion := C.rademacher_coeff_at
  rademacher_kernel := C.rademacher_kernel_multiplier_at
  rademacher_kloosterman := C.rademacher_kloosterman_at
  rademacher_bessel_term := C.linked_rademacher_formula_at
  rademacher_truncation_one := C.linked_rademacher_truncation_one_at
  rademacher_tail := by
    intro n hn
    exact C.rademacher_tail_at hn
  rademacher_tail_envelope_nonneg := by
    intro n
    exact mul_nonneg C.rademacherWitness.tail.C_nonneg (Real.exp_pos _).le
  degeneracy_channel := C.degeneracy_agrees
  effective_cardy_formula := effectiveCardyConstant_formula C.entropyWitness.alpha
  effective_cardy_nonneg := C.effective_cardy_nonnegative
  spt_modular_ideal_generator :=
    modularIdeal_generator C.sptIdealWitness.spt.M
  spt_padic_ideal_generator :=
    padicIdeal_generator C.sptIdealWitness.spt.p C.sptIdealWitness.spt.k
  spt_equalizer_lcm := C.spt_lcm_at
  spt_intersection := C.spt_ideal_intersection_at
  spt_failure_locus := C.spt_failure_locus_at
  crt_portfolio := C.crt_at
