/-!
Global Ramanujan inside/outside and T1-T5 analytic payload.

The dictionary correction is definitionally `2*psi - outside`; the explicit
page-25 correction has only been checked through degree fifteen.  A global
input must identify those two independently defined coefficient functions for
every degree and provide convergence of all three series.  It also supplies
the analytic continuation map linking the outside series back to the actual
Appell-Lerch holomorphic part.
-/

noncomputable def AdvancedClaimsIIIntCoefficientTruncation
    (coefficient : Nat -> Int)
    (tau : UpperHalfPlanePoint)
    (N : Nat) : Complex :=
  Finset.sum (Finset.range N)
    (fun n => (coefficient n : Complex) * qParameter tau ^ n)

structure AdvancedClaimsIIRamanujanFGlobalInsideOutsideProofInput
    (ConvergesAt : CuspLabel -> Prop) where
  sourceName : String
  coefficientIdentitySource : String
  analyticContinuationSource : String
  replacementPlan : String
  appellLerch :
    AdvancedClaimsIIRamanujanFAppellLerchAnalyticProofInput ConvergesAt
  outsideAnalytic : UpperHalfPlanePoint -> Complex
  psiAnalytic : UpperHalfPlanePoint -> Complex
  correctionAnalytic : UpperHalfPlanePoint -> Complex
  continuationMap : UpperHalfPlanePoint -> UpperHalfPlanePoint
  sourceName_nonempty :
    Not (sourceName = "")
  coefficientIdentitySource_nonempty :
    Not (coefficientIdentitySource = "")
  analyticContinuationSource_nonempty :
    Not (analyticContinuationSource = "")
  replacementPlan_nonempty :
    Not (replacementPlan = "")
  explicit_correction_global :
    forall n : Nat,
      AdvancedClaimsIIRamanujanExplicitCorrectionCoefficient n =
        AdvancedClaimsIIRamanujanDictionaryCorrectionCoefficient n
  outside_limit :
    forall tau : UpperHalfPlanePoint,
      Filter.Tendsto
        (fun N : Nat =>
          AdvancedClaimsIIIntCoefficientTruncation
            AdvancedClaimsIIRamanujanFOutsideCoefficient tau N)
        Filter.atTop (nhds (outsideAnalytic tau))
  psi_limit :
    forall tau : UpperHalfPlanePoint,
      Filter.Tendsto
        (fun N : Nat =>
          AdvancedClaimsIIIntCoefficientTruncation
            AdvancedClaimsIIRamanujanPsiCoefficient tau N)
        Filter.atTop (nhds (psiAnalytic tau))
  correction_limit :
    forall tau : UpperHalfPlanePoint,
      Filter.Tendsto
        (fun N : Nat =>
          AdvancedClaimsIIIntCoefficientTruncation
            AdvancedClaimsIIRamanujanExplicitCorrectionCoefficient tau N)
        Filter.atTop (nhds (correctionAnalytic tau))
  analytic_inside_outside :
    forall tau : UpperHalfPlanePoint,
      outsideAnalytic tau =
        2 * psiAnalytic tau - correctionAnalytic tau
  continuation_to_appell_lerch :
    forall tau : UpperHalfPlanePoint,
      appellLerch.holomorphicPart tau =
        outsideAnalytic (continuationMap tau)

