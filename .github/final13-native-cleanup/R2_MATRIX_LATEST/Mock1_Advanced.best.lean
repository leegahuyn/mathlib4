    (exists T : TransportedPrincipalPart,
        List.Mem T A.t1t5.appellLerch.allPaperCusps.transports /\
          T.target = cusp) /\
      ConvergesAt cusp :=
  A.t1t5.cusp_at cusp hcusp

theorem exact_coefficient_at {ConvergesAt : CuspLabel -> Prop}
    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt)
