    AdvancedClaimsIIUnaryThetaHalfLatticePoint
        (AdvancedClaimsIIUnaryThetaPartner k) =
      -AdvancedClaimsIIUnaryThetaHalfLatticePoint k := by
  change (((-k - 1 : Int) : Rat) + (1 / 2 : Rat)) =
