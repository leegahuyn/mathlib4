structure ParameterTableSchemaCertificate where
  sourceName : String
  tableNumber : PaperTableNumber
  depth : Nat
  columnCount : Nat
  rows : List ParameterTableRow
  sourceName_nonempty :
    Not (sourceName = "")
  tableNumber_eq :
    tableNumber = PaperTableNumber.table1
  depth_eq :
    depth = 11
  columnCount_eq_twice_depth :
    columnCount = 2 * depth
  rows_length_eq_depth :
    rows.length = depth
  all_rows_theorem :
    forall row, List.Mem row rows ->
      row.mode = TableRowMode.theoremBacked
  all_rows_alpha_mem :
    forall row, List.Mem row rows ->
      row.alphaInterval.Contains row.alpha
  all_rows_entries :
    forall row, List.Mem row rows ->
      row.plusEntry = 1 /\ row.minusEntry = -1

namespace ParameterTableSchemaCertificate

theorem source_nonempty_at
    (C : ParameterTableSchemaCertificate) :
    Not (C.sourceName = "") :=
  C.sourceName_nonempty

theorem table_number_at
    (C : ParameterTableSchemaCertificate) :
    C.tableNumber = PaperTableNumber.table1 :=
  C.tableNumber_eq

theorem depth_at (C : ParameterTableSchemaCertificate) :
    C.depth = 11 :=
  C.depth_eq

theorem column_count_at
    (C : ParameterTableSchemaCertificate) :
    C.columnCount = 2 * C.depth :=
  C.columnCount_eq_twice_depth

theorem rows_length_at
    (C : ParameterTableSchemaCertificate) :
    C.rows.length = C.depth :=
  C.rows_length_eq_depth

theorem row_mode_at
    (C : ParameterTableSchemaCertificate)
    (row : ParameterTableRow) (hrow : List.Mem row C.rows) :
    row.mode = TableRowMode.theoremBacked :=
  C.all_rows_theorem row hrow

theorem row_alpha_mem_at
    (C : ParameterTableSchemaCertificate)
    (row : ParameterTableRow) (hrow : List.Mem row C.rows) :
    row.alphaInterval.Contains row.alpha :=
  C.all_rows_alpha_mem row hrow

theorem row_entries_at
    (C : ParameterTableSchemaCertificate)
    (row : ParameterTableRow) (hrow : List.Mem row C.rows) :
    row.plusEntry = 1 /\ row.minusEntry = -1 :=
  C.all_rows_entries row hrow

end ParameterTableSchemaCertificate

