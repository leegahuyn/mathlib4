def promptObjectiveAudit
    (C : AdvancedClaimsIICompletionCertificate) :
    AdvancedClaimsIIPromptObjectiveAuditCertificate C where
  leaf_ledger := C.requirementLeafLedger
  objective_crosswalk := C.objectiveCrosswalk
  requirements_complete := C.covers_at
  object_schema := by
    exact And.intro C.requirementLeafLedger.object_claim_registry
      (And.intro C.requirementLeafLedger.object_coefficient_schema
        (And.intro C.requirementLeafLedger.paper_object_data_instance
          C.requirementLeafLedger.scalar_jacobi_degeneracy_relation))
  t1t5_core := by
    exact And.intro C.requirementLeafLedger.principal_part_rational_solve
      (And.intro C.requirementLeafLedger.completion_shadow_holomorphic
        (And.intro C.requirementLeafLedger.cusp_transport
          (And.intro C.requirementLeafLedger.appell_lerch_block_formula
            (And.intro C.requirementLeafLedger.principal_exponent_formula
              (And.intro C.requirementLeafLedger.paper_matrix_rhs_solution
                (And.intro C.requirementLeafLedger.fixed_shadow_unary_theta
                  C.requirementLeafLedger.inside_outside_qseries))))))
  spt_equalizer_tor_crt := by
    exact And.intro C.requirementLeafLedger.nat_gcd_lcm_skeleton
      (And.intro C.requirementLeafLedger.primewise_thickness_skeleton
        (And.intro C.requirementLeafLedger.actual_mpk_valuation_certificate
          (And.intro
            C.requirementLeafLedger.obstruction_free_failure_thickness_portfolio
            C.requirementLeafLedger.base_change_stability_boundary)))
  kernel_cusp_multiplier := by
    exact And.intro C.requirementLeafLedger.kernel_selection_certificate_boundary
      (And.intro
        C.requirementLeafLedger.finite_multiplier_phase_matching_certificate
        (And.intro C.requirementLeafLedger.cusp_convergence_certificate_boundary
          (And.intro C.requirementLeafLedger.transport_family_connection
            (And.intro C.requirementLeafLedger.kernel_selection_table_input
              (And.intro C.requirementLeafLedger.multiplier_phase_matching_input
                (And.intro C.requirementLeafLedger.cusp_convergence_proof_data_input
                  C.requirementLeafLedger.transport_across_relevant_cusps))))))
  exact_coefficient_formula := by
    exact And.intro C.requirementLeafLedger.coefficient_separation_boundary
      (And.intro C.requirementLeafLedger.theta_coefficient_character_boundary
        (And.intro C.requirementLeafLedger.spectral_kloosterman_expansion_boundary
          (And.intro C.requirementLeafLedger.local_euler_decomposition_boundary
            (And.intro C.requirementLeafLedger.root_number_filter_boundary
              (And.intro C.requirementLeafLedger.exact_coefficient_formula_boundary
                C.requirementLeafLedger.paper_data_formula_proof_fields)))))
  p_adic_section := by
    exact And.intro C.requirementLeafLedger.padic_normalization_wrapper
      (And.intro C.requirementLeafLedger.padic_overlap_gluing_wrapper
        (And.intro C.requirementLeafLedger.mahler_interpolation_wrapper
          (And.intro C.requirementLeafLedger.analytic_range_tail_zero_wrapper
            (And.intro C.requirementLeafLedger.global_padic_face_tracking
              (And.intro C.requirementLeafLedger.denominator_clearing_data
                (And.intro C.requirementLeafLedger.chart_vectors_modulo_prime_power
                  (And.intro C.requirementLeafLedger.mahler_table_interpolation_vector
                    (And.intro C.requirementLeafLedger.analytic_range_predicate
                      C.requirementLeafLedger.obstruction_failure_case_instance))))))))
  entropy_cardy_reproducibility := by
    exact And.intro C.requirementLeafLedger.regression_cardy_skeleton
      (And.intro C.requirementLeafLedger.rademacher_tail_skeleton
        (And.intro C.requirementLeafLedger.entropy_cardy_paper_wrapper
          (And.intro C.requirementLeafLedger.actual_entropy_alpha_extraction
            (And.intro C.requirementLeafLedger.degeneracy_channel_instance
              (And.intro C.requirementLeafLedger.rational_ols_interval_table
                (And.intro C.requirementLeafLedger.growth_stability_under_spt_padic
                  (And.intro C.requirementLeafLedger.reproducibility_schema_validator
                    C.requirementLeafLedger.external_output_schema_rows)))))))

