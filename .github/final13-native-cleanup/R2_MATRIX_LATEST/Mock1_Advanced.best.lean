theorem integral_interval_mem_at
    (C : ArchimedeanIntegralValueBoundCertificate) :
    C.integral.valueInterval.Contains C.integral.normalizedValueRat := by
  rw [<- C.interval_eq_integral, <- C.value_eq_integral]
  exact C.value_mem_at

