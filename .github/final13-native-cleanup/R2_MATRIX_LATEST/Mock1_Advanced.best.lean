              Not (I.centralLValueSource = "") /\
                Not (I.replacementPlan = "") :=
  And.intro I.coefficientSeparationSource_nonempty
    (And.intro I.thetaCoefficientSource_nonempty
      (And.intro I.spectralKloostermanSource_nonempty
        (And.intro I.localEulerSource_nonempty
          (And.intro I.rootNumberSource_nonempty
            (And.intro I.centralLValueSource_nonempty
              I.replacementPlan_nonempty)))))

