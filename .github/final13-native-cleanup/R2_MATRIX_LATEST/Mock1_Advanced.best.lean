      (c.padicOverlap.left n) (c.padicOverlap.right n) /\
        IntCongruent (PrimePower c.padicOverlap.p c.padicOverlap.k)
          (c.padicOverlap.left n) (c.padicOverlap.right n) :=
  c.padicOverlap.matches_both n

theorem mahler_matches {X : Type*} (c : ConcreteCertificate X) (n : Nat) :
    IntCongruent (PrimePower c.mahler.p c.mahler.k)
