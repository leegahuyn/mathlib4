theorem tail_le_threshold_main
    (C : RationalTailDominanceCertificate) :
    C.tailUpper <= C.dominanceThreshold * C.mainLower := by
  have hmain : 0 <= C.mainLower := C.mainLower_nonnegative
  have hscale :
      C.ratioUpper * C.mainLower <=
        C.dominanceThreshold * C.mainLower :=
    mul_le_mul_of_nonneg_right C.ratio_le_threshold hmain
  exact le_trans C.tail_le_ratio_main hscale

