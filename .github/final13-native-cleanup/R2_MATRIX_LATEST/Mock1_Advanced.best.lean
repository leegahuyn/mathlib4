    (A : AdvancedClaimsIIRamanujanFActualAbstractCertificate ConvergesAt) :
    AdvancedClaimsIIThreeRegressorEntropyGrowth
      referenceAdvancedClaimsIIRamanujanFPaperObject.coeff
