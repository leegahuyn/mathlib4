/-!
# Paper-normalized B2 gap correction for Corollary 4.32

The paper states that the B2 gap conclusion is “analogous” to the B1 uniform-additive result but
does not display the resulting bound.  Subtracting the two endpoint inequalities of Theorem 4.31
gives an energy-dependent correction.  The declarations here record that exact arithmetic and a
countermodel to the specific uniform-in-index additive adjacent-gap interpretation below, which
would remove the reference-energy dependence on an unbounded spectrum.

No operator, form sum, min--max theorem, or continuum eigenvalue enumeration is constructed here.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Correct energy-dependent statement -/

/-- Exact pairwise B2 gap lower bound following from the displayed eigenvalue interval. -/
def cor4_32_B2EnergyDependentGapStatement : Prop :=
  ∀ (Index : Type) (a b : ℝ) (reference corrected : Index → ℝ),
    QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
      a b reference corrected →
      ∀ i j : Index,
        QYM.RelativeSpectralB2NoGo.indexedGap reference i j -
            (a * (reference i + reference j) + 2 * b) ≤
          QYM.RelativeSpectralB2NoGo.indexedGap corrected i j

theorem cor4_32_B2EnergyDependentGapStatement_holds :
    cor4_32_B2EnergyDependentGapStatement := by
  intro Index a b reference corrected hinterval i j
  exact QYM.RelativeSpectralB2NoGo.correctedGap_lower_bound hinterval i j

/-- Quantitative half-gap retention with the necessary two-energy correction exposed. -/
def cor4_32_B2HalfGapStatement : Prop :=
  ∀ (Index : Type) (a b δ : ℝ) (reference corrected : Index → ℝ),
    QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
      a b reference corrected →
      ∀ i j : Index,
        δ ≤ QYM.RelativeSpectralB2NoGo.indexedGap reference i j →
        a * (reference i + reference j) + 2 * b ≤ δ / 2 →
          δ / 2 ≤ QYM.RelativeSpectralB2NoGo.indexedGap corrected i j

theorem cor4_32_B2HalfGapStatement_holds :
    cor4_32_B2HalfGapStatement := by
  intro Index a b δ reference corrected hinterval i j hgap hsmall
  exact
    QYM.RelativeSpectralB2NoGo.half_gapLowerBound_le_correctedGap
      hinterval i j hgap hsmall

/-! ## No-go for an energy-independent adjacent-gap reading -/

/-- Invalid uniform-adjacent-gap-error inference, specialized to the explicit quadratic
reference family. -/
def cor4_32_B2UniformAdjacentGapInferenceStatement : Prop :=
  ∀ a : ℝ,
    0 < a → a < 1 →
    QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
      a 0 QYM.RelativeSpectralB2NoGo.quadraticReference
        (QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation a) →
      ∃ ε : ℝ, ∀ n : ℕ,
        |QYM.RelativeSpectralB2NoGo.indexedGap
              (QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation a) n (n + 1) -
            QYM.RelativeSpectralB2NoGo.indexedGap
              QYM.RelativeSpectralB2NoGo.quadraticReference n (n + 1)| ≤ ε

theorem cor4_32_B2UniformAdjacentGapInferenceStatement_refuted :
    ¬ cor4_32_B2UniformAdjacentGapInferenceStatement := by
  intro hinference
  have hinterval :
      QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
        (1 / 2 : ℝ) 0 QYM.RelativeSpectralB2NoGo.quadraticReference
          (QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation (1 / 2 : ℝ)) :=
    QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation_satisfies_interval
      (by norm_num)
  have huniform :=
    hinference (1 / 2 : ℝ) (by norm_num) (by norm_num) hinterval
  exact
    QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation_has_no_uniform_adjacentGapError
      (by norm_num : (0 : ℝ) < 1 / 2) huniform

/-- Positive existential packaging of the same form-small countermodel. -/
def cor4_32_B2UniformAdjacentGapCountermodelStatement : Prop :=
  ∃ a : ℝ,
    0 < a ∧ a < 1 ∧
      QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
        a 0 QYM.RelativeSpectralB2NoGo.quadraticReference
          (QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation a) ∧
      ¬ ∃ ε : ℝ, ∀ n : ℕ,
        |QYM.RelativeSpectralB2NoGo.indexedGap
              (QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation a) n (n + 1) -
            QYM.RelativeSpectralB2NoGo.indexedGap
              QYM.RelativeSpectralB2NoGo.quadraticReference n (n + 1)| ≤ ε

theorem cor4_32_B2UniformAdjacentGapCountermodelStatement_holds :
    cor4_32_B2UniformAdjacentGapCountermodelStatement := by
  refine ⟨(1 / 2 : ℝ), by norm_num, by norm_num, ?_, ?_⟩
  · exact
      QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation_satisfies_interval
        (by norm_num)
  · exact
      QYM.RelativeSpectralB2NoGo.quadraticRelativeDilation_has_no_uniform_adjacentGapError
        (by norm_num)

end QYM.FullCertification.PaperNormalized

/-!
# Spectral test-kernel, window-count, and tail arithmetic

This module isolates unconditional order and summation statements appearing around Definition 4.6,
Definition 4.7, Corollary 4.28, and Lemma 4.29 of the paper.  It deliberately does **not** define
the unavailable Paper-I conditions (T0)--(T4), prove a Weyl law, construct the paper's spectrum, or
derive transform decay.  Instead, every majorization, smoothed-count bound, window decomposition,
and geometric-decay input used below is an explicit theorem hypothesis.

The codomain is `ℝ≥0∞`.  This makes the nonnegative infinite sums unconditional: a smoothed count
or tail may equal `∞` unless a displayed bound proves otherwise.  A paper-valued nonnegative real
kernel embeds into this codomain, while the finite-sum definitions retain exact finite counts.
-/

namespace QYM.TestKernelTailCore

open scoped BigOperators ENNReal

/-! ## Definition-4.6/4.7 arithmetic interface -/

/-- A parameter-indexed nonnegative kernel family.  This is only the codomain and arity of the
paper's `Φ_T`; it does not package or invent the Paper-I admissibility conditions (T0)--(T4). -/
abbrev TestFamily := ℝ → ℝ → ℝ≥0∞

/-- Membership of a spectral parameter in the closed unit window `[T,T+1]`. -/
def InUnitWindow (T t : ℝ) : Prop :=
  T ≤ t ∧ t ≤ T + 1

theorem inUnitWindow_iff (T t : ℝ) :
    InUnitWindow T t ↔ T ≤ t ∧ t ≤ T + 1 :=
  Iff.rfl

/-- Infinite smoothed counting functional.  The indexing carrier is explicit; for the paper's
`j ≥ 1` convention it can be instantiated by a positive-index subtype. -/
def SmoothedCount {Index : Type*}
    (family : TestFamily) (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  ∑' i : Index, family T (spectral i)

/-- Every extended-nonnegative smoothed count is nonnegative, including the divergent value. -/
theorem smoothedCount_nonnegative {Index : Type*}
    (family : TestFamily) (spectral : Index → ℝ) (T : ℝ) :
    0 ≤ SmoothedCount family spectral T :=
  bot_le

/-- Pointwise domination of kernels on the displayed spectrum implies domination of their
smoothed counts. -/
theorem smoothedCount_mono {Index : Type*}
    {family majorant : TestFamily} {spectral : Index → ℝ} {T : ℝ}
    (hmajorant : ∀ i, family T (spectral i) ≤ majorant T (spectral i)) :
    SmoothedCount family spectral T ≤ SmoothedCount majorant spectral T := by
  unfold SmoothedCount
  exact ENNReal.tsum_le_tsum hmajorant

attribute [local instance] Classical.propDecidable

/-! ## Finite approximants and exact window cardinality -/

/-- Finite smoothed count on an explicitly supplied finite set of spectral indices. -/
def FiniteSmoothedCount {Index : Type*}
    (indices : Finset Index) (family : TestFamily)
    (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  ∑ i ∈ indices, family T (spectral i)

/-- Exact natural-number cardinality of the displayed finite unit window. -/
def FiniteWindowCount {Index : Type*}
    (indices : Finset Index) (spectral : Index → ℝ) (T : ℝ) : ℕ :=
  (indices.filter fun i => InUnitWindow T (spectral i)).card

/-- The extended-nonnegative cast of a finite window cardinality is its indicator sum. -/
theorem finiteWindowCount_cast_eq_indicatorSum {Index : Type*}
    (indices : Finset Index) (spectral : Index → ℝ) (T : ℝ) :
    (FiniteWindowCount indices spectral T : ℝ≥0∞) =
      ∑ i ∈ indices,
        if InUnitWindow T (spectral i) then (1 : ℝ≥0∞) else 0 := by
  unfold FiniteWindowCount
  exact Finset.natCast_card_filter (fun i => InUnitWindow T (spectral i)) indices

/-- Finite indicator-majorant argument behind Corollary 4.28.  The hypothesis that the kernel is
at least one on the window is displayed rather than bundled into an admissibility structure. -/
theorem finiteWindowCount_le_finiteSmoothedCount {Index : Type*}
    {indices : Finset Index} {family : TestFamily}
    {spectral : Index → ℝ} {T : ℝ}
    (hmajorant : ∀ i ∈ indices,
      InUnitWindow T (spectral i) → 1 ≤ family T (spectral i)) :
    (FiniteWindowCount indices spectral T : ℝ≥0∞) ≤
      FiniteSmoothedCount indices family spectral T := by
  rw [finiteWindowCount_cast_eq_indicatorSum]
  unfold FiniteSmoothedCount
  apply Finset.sum_le_sum
  intro i hi
  by_cases hwindow : InUnitWindow T (spectral i)
  · simpa [hwindow] using hmajorant i hi hwindow
  · simp [hwindow]

/-- A finite smoothed count is bounded by the full extended-nonnegative smoothed count. -/
theorem finiteSmoothedCount_le_smoothedCount {Index : Type*}
    (indices : Finset Index) (family : TestFamily)
    (spectral : Index → ℝ) (T : ℝ) :
    FiniteSmoothedCount indices family spectral T ≤
      SmoothedCount family spectral T := by
  unfold FiniteSmoothedCount SmoothedCount
  exact ENNReal.sum_le_tsum indices

/-- Finite indicator majorization also bounds the finite window cardinality by the full smoothed
count; no separate convergence hypothesis is needed in `ℝ≥0∞`. -/
theorem finiteWindowCount_le_smoothedCount {Index : Type*}
    {indices : Finset Index} {family : TestFamily}
    {spectral : Index → ℝ} {T : ℝ}
    (hmajorant : ∀ i ∈ indices,
      InUnitWindow T (spectral i) → 1 ≤ family T (spectral i)) :
    (FiniteWindowCount indices spectral T : ℝ≥0∞) ≤
      SmoothedCount family spectral T :=
  (finiteWindowCount_le_finiteSmoothedCount hmajorant).trans
    (finiteSmoothedCount_le_smoothedCount indices family spectral T)

/-! ## Infinite window count and the Corollary-4.28 logical step -/

/-- Extended-nonnegative cardinal mass of the full unit window.  It equals `∞` when the window
contains infinitely many indexed levels. -/
def WindowCount {Index : Type*}
    (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  ∑' i : Index,
    if InUnitWindow T (spectral i) then (1 : ℝ≥0∞) else 0

theorem windowCount_nonnegative {Index : Type*}
    (spectral : Index → ℝ) (T : ℝ) :
    0 ≤ WindowCount spectral T :=
  bot_le

/-- Indicator majorization turns any smoothed-count estimate into a window-count estimate. -/
theorem windowCount_le_smoothedCount {Index : Type*}
    {family : TestFamily} {spectral : Index → ℝ} {T : ℝ}
    (hmajorant : ∀ i,
      InUnitWindow T (spectral i) → 1 ≤ family T (spectral i)) :
    WindowCount spectral T ≤ SmoothedCount family spectral T := by
  unfold WindowCount SmoothedCount
  apply ENNReal.tsum_le_tsum
  intro i
  by_cases hwindow : InUnitWindow T (spectral i)
  · simpa [hwindow] using hmajorant i hwindow
  · simp [hwindow]

/-- Complete conditional core of Corollary 4.28: the missing Weyl/smoothed-count estimate is the
explicit hypothesis `SmoothedCount family spectral T ≤ bound`. -/
theorem windowCount_le_of_smoothedCount_bound {Index : Type*}
    {family : TestFamily} {spectral : Index → ℝ} {T : ℝ} {bound : ℝ≥0∞}
    (hmajorant : ∀ i,
      InUnitWindow T (spectral i) → 1 ≤ family T (spectral i))
    (hbound : SmoothedCount family spectral T ≤ bound) :
    WindowCount spectral T ≤ bound :=
  (windowCount_le_smoothedCount hmajorant).trans hbound

/-! ## Natural cutoff and exact infinite-sum decomposition -/

/-- The scalar cutoff `T + (log T)^2` appearing in Lemma 4.29. -/
def NaturalCutoff (T : ℝ) : ℝ :=
  T + (Real.log T) ^ 2

/-- Total nonnegative spectral weight.  To represent the paper's summand, `weight T t` should be
instantiated by an explicit `ℝ≥0∞` encoding or majorant of `|Ψ_T(t)|`. -/
def SpectralTotal {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  ∑' i : Index, weight T (spectral i)

/-- Part of the total weight strictly below the displayed cutoff. -/
def SpectralTruncation {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ)
    (T cutoff : ℝ) : ℝ≥0∞ :=
  ∑' i : Index,
    if spectral i < cutoff then weight T (spectral i) else 0

/-- Tail at or above the displayed cutoff. -/
def SpectralTail {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ)
    (T cutoff : ℝ) : ℝ≥0∞ :=
  ∑' i : Index,
    if cutoff ≤ spectral i then weight T (spectral i) else 0

/-- Truncation at the natural Lemma-4.29 cutoff. -/
def NaturalSpectralTruncation {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  SpectralTruncation weight spectral T (NaturalCutoff T)

/-- Tail beginning at the natural Lemma-4.29 cutoff. -/
def NaturalSpectralTail {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T : ℝ) : ℝ≥0∞ :=
  SpectralTail weight spectral T (NaturalCutoff T)

theorem spectralTotal_nonnegative {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T : ℝ) :
    0 ≤ SpectralTotal weight spectral T :=
  bot_le

theorem spectralTruncation_nonnegative {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T cutoff : ℝ) :
    0 ≤ SpectralTruncation weight spectral T cutoff :=
  bot_le

theorem spectralTail_nonnegative {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T cutoff : ℝ) :
    0 ≤ SpectralTail weight spectral T cutoff :=
  bot_le

/-- Pointwise partition of one nonnegative summand into its strict-below and at-or-above pieces. -/
theorem spectralTerm_eq_truncated_add_tail {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ)
    (T cutoff : ℝ) (i : Index) :
    weight T (spectral i) =
      (if spectral i < cutoff then weight T (spectral i) else 0) +
      (if cutoff ≤ spectral i then weight T (spectral i) else 0) := by
  by_cases hbelow : spectral i < cutoff
  · have hnotTail : ¬ cutoff ≤ spectral i := not_le.mpr hbelow
    simp [hbelow, hnotTail]
  · have htail : cutoff ≤ spectral i := le_of_not_gt hbelow
    simp [hbelow, htail]

/-- Exact total = truncation + tail identity.  `ℝ≥0∞` makes this valid without a summability
hypothesis, including when one or both sides equal `∞`. -/
theorem spectralTotal_eq_truncation_add_tail {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ)
    (T cutoff : ℝ) :
    SpectralTotal weight spectral T =
      SpectralTruncation weight spectral T cutoff +
        SpectralTail weight spectral T cutoff := by
  unfold SpectralTotal SpectralTruncation SpectralTail
  calc
    (∑' i : Index, weight T (spectral i)) =
        ∑' i : Index,
          ((if spectral i < cutoff then weight T (spectral i) else 0) +
            (if cutoff ≤ spectral i then weight T (spectral i) else 0)) := by
      apply tsum_congr
      intro i
      exact spectralTerm_eq_truncated_add_tail weight spectral T cutoff i
    _ =
        (∑' i : Index,
          if spectral i < cutoff then weight T (spectral i) else 0) +
        (∑' i : Index,
          if cutoff ≤ spectral i then weight T (spectral i) else 0) :=
      ENNReal.tsum_add

/-- Exact decomposition at the paper's natural cutoff. -/
theorem spectralTotal_eq_naturalTruncation_add_naturalTail {Index : Type*}
    (weight : TestFamily) (spectral : Index → ℝ) (T : ℝ) :
    SpectralTotal weight spectral T =
      NaturalSpectralTruncation weight spectral T +
        NaturalSpectralTail weight spectral T := by
  unfold NaturalSpectralTruncation NaturalSpectralTail
  exact
    spectralTotal_eq_truncation_add_tail
      weight spectral T (NaturalCutoff T)

/-! ## Tail monotonicity and explicit majorants -/

/-- Raising the cutoff can only decrease an extended-nonnegative spectral tail. -/
theorem spectralTail_antitone_cutoff {Index : Type*}
    {weight : TestFamily} {spectral : Index → ℝ} {T cutoff₁ cutoff₂ : ℝ}
    (hcutoff : cutoff₁ ≤ cutoff₂) :
    SpectralTail weight spectral T cutoff₂ ≤
      SpectralTail weight spectral T cutoff₁ := by
  unfold SpectralTail
  apply ENNReal.tsum_le_tsum
  intro i
  by_cases htail₂ : cutoff₂ ≤ spectral i
  · have htail₁ : cutoff₁ ≤ spectral i := hcutoff.trans htail₂
    simp [htail₁, htail₂]
  · simp [htail₂]

/-- A pointwise weight majorant on the displayed tail passes to the tail sum. -/
theorem spectralTail_le_of_pointwiseMajorant {Index : Type*}
    {weight majorant : TestFamily} {spectral : Index → ℝ}
    {T cutoff : ℝ}
    (hmajorant : ∀ i, cutoff ≤ spectral i →
      weight T (spectral i) ≤ majorant T (spectral i)) :
    SpectralTail weight spectral T cutoff ≤
      SpectralTail majorant spectral T cutoff := by
  unfold SpectralTail
  apply ENNReal.tsum_le_tsum
  intro i
  by_cases htail : cutoff ≤ spectral i
  · simpa [htail] using hmajorant i htail
  · simp [htail]

/-! ## Geometric unit-window tail core -/

/-- Sum of unit-window masses beginning at the explicitly displayed natural-number window. -/
def WindowTail (windowMass : ℕ → ℝ≥0∞) (start : ℕ) : ℝ≥0∞ :=
  ∑' k : ℕ, windowMass (start + k)

/-- Exact shifted geometric tail, valid in `ℝ≥0∞` for every ratio.  When `r ≥ 1`, the right side
correctly evaluates to `∞` unless the prefactor annihilates it. -/
def GeometricTail (C r : ℝ≥0∞) (start : ℕ) : ℝ≥0∞ :=
  ∑' k : ℕ, C * r ^ (start + k)

theorem geometricTail_eq (C r : ℝ≥0∞) (start : ℕ) :
    GeometricTail C r start =
      (C * r ^ start) * (1 - r)⁻¹ := by
  unfold GeometricTail
  calc
    (∑' k : ℕ, C * r ^ (start + k)) =
        ∑' k : ℕ, (C * r ^ start) * r ^ k := by
      apply tsum_congr
      intro k
      rw [pow_add]
      exact (mul_assoc C (r ^ start) (r ^ k)).symm
    _ = (C * r ^ start) * (∑' k : ℕ, r ^ k) :=
      ENNReal.tsum_mul_left
    _ = (C * r ^ start) * (1 - r)⁻¹ := by
      rw [ENNReal.tsum_geometric]

/-- Explicit geometric-series bound for unit-window masses.  The hypothesis is precisely the
windowwise decay supplier that the PDF attributes to Corollary 4.28 plus transformed-kernel decay. -/
theorem windowTail_le_geometric
    {windowMass : ℕ → ℝ≥0∞} {start : ℕ} {C r : ℝ≥0∞}
    (hwindow : ∀ k, windowMass (start + k) ≤ C * r ^ k) :
    WindowTail windowMass start ≤ C * (1 - r)⁻¹ := by
  unfold WindowTail
  calc
    (∑' k : ℕ, windowMass (start + k)) ≤
        ∑' k : ℕ, C * r ^ k :=
      ENNReal.tsum_le_tsum hwindow
    _ = C * (∑' k : ℕ, r ^ k) := ENNReal.tsum_mul_left
    _ = C * (1 - r)⁻¹ := by rw [ENNReal.tsum_geometric]

/-- With a finite prefactor and ratio below one, the preceding explicit geometric upper bound
also proves that the unit-window tail is finite. -/
theorem windowTail_lt_top_of_geometric
    {windowMass : ℕ → ℝ≥0∞} {start : ℕ} {C r : ℝ≥0∞}
    (hC : C < ∞) (hr : r < 1)
    (hwindow : ∀ k, windowMass (start + k) ≤ C * r ^ k) :
    WindowTail windowMass start < ∞ := by
  refine (windowTail_le_geometric hwindow).trans_lt ?_
  exact ENNReal.mul_lt_top hC
    (ENNReal.inv_lt_top.2 (tsub_pos_iff_lt.2 hr))

/-- Conditional Lemma-4.29 summation core.  The first hypothesis is the explicit decomposition of
the spectral tail into unit-window masses; the second is the explicit geometric window estimate.
Neither is inferred from an unnamed admissibility or Weyl-law supplier. -/
theorem spectralTail_le_geometric_of_windowDomination {Index : Type*}
    {weight : TestFamily} {spectral : Index → ℝ} {T cutoff : ℝ}
    {windowMass : ℕ → ℝ≥0∞} {start : ℕ} {C r : ℝ≥0∞}
    (hdecomposition :
      SpectralTail weight spectral T cutoff ≤ WindowTail windowMass start)
    (hwindow : ∀ k, windowMass (start + k) ≤ C * r ^ k) :
    SpectralTail weight spectral T cutoff ≤ C * (1 - r)⁻¹ :=
  hdecomposition.trans (windowTail_le_geometric hwindow)

end QYM.TestKernelTailCore

/-!
# Paper-normalized diagonal sign audit for the operator-spectrum claims

The paper defines a nonnegative Laplacian `Δ = δ*δ` but later uses `H = -Δ + V` while claiming a
lower-bounded spectrum enumerated increasingly toward `+∞`.  The declarations below normalize
that sign pattern on the already constructed constant-potential diagonal carrier.  They refute
the `+∞` direction and least-level conclusion and record the corrected `+Δ + V` direction.

This is a concrete sign countermodel, not a construction of the paper's differential operator,
boundary domain, self-adjoint realization, or compact resolvent.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Proposition 4.15: direction and ground-level obstruction -/

/-- The `+∞` spectral-direction conclusion specialized to the paper-sign diagonal carrier. -/
def prop4_15_paperSignTendsToTopStatement : Prop :=
  Tendsto (QYM.DiagonalSpectralDirectionNoGo.paperSignLevel 0) atTop atTop

theorem prop4_15_paperSignTendsToTopStatement_refuted :
    ¬ prop4_15_paperSignTendsToTopStatement :=
  QYM.DiagonalSpectralDirectionNoGo.paperSignLevel_not_tendsto_atTop 0

/-- The asserted availability of a least indexed level on the same carrier. -/
def prop4_15_paperSignHasLeastLevelStatement : Prop :=
  ∃ n : ℕ, ∀ m : ℕ,
    QYM.DiagonalSpectralDirectionNoGo.paperSignLevel 0 n ≤
      QYM.DiagonalSpectralDirectionNoGo.paperSignLevel 0 m

theorem prop4_15_paperSignHasLeastLevelStatement_refuted :
    ¬ prop4_15_paperSignHasLeastLevelStatement :=
  QYM.DiagonalSpectralDirectionNoGo.paperSignLevel_has_no_least_index 0

/-- Correct direction of the paper-sign coefficients in this countermodel. -/
def prop4_15_correctPaperSignDirectionStatement : Prop :=
  Tendsto (QYM.DiagonalSpectralDirectionNoGo.paperSignLevel 0) atTop atBot

theorem prop4_15_correctPaperSignDirectionStatement_holds :
    prop4_15_correctPaperSignDirectionStatement :=
  QYM.DiagonalSpectralDirectionNoGo.paperSignLevel_tendsto_atBot 0

/-- Corrected kinetic-sign sequence has the intended positive-infinity direction. -/
def prop4_15_correctedSignTendsToTopStatement : Prop :=
  Tendsto (QYM.DiagonalSpectralDirectionNoGo.correctedSignLevel 0) atTop atTop

theorem prop4_15_correctedSignTendsToTopStatement_holds :
    prop4_15_correctedSignTendsToTopStatement :=
  QYM.DiagonalSpectralDirectionNoGo.correctedSignLevel_tendsto_atTop 0

/-! ## Lemma 4.17: lower-boundedness sign obstruction -/

/-- Constant-zero diagonal specialization of the necessary eigenpair-level consequence of the
paper's claimed operator lower bound.  It does not encode self-adjointness or form closedness. -/
def lemma4_17_paperSignLowerBoundStatement : Prop :=
  QYM.InfiniteDiagonalHamiltonian.HasEigenvalueLowerBound
    (QYM.InfiniteDiagonalHamiltonian.paperHamiltonian (fun _ => 0))

theorem lemma4_17_paperSignLowerBoundStatement_refuted :
    ¬ lemma4_17_paperSignLowerBoundStatement :=
  QYM.InfiniteDiagonalHamiltonian.constantPotential_not_hasEigenvalueLowerBound 0

/-- Corrected-sign constant-zero model does have the displayed eigenvalue lower bound. -/
def lemma4_17_correctedSignLowerBoundStatement : Prop :=
  QYM.InfiniteDiagonalHamiltonian.HasEigenvalueLowerBound
    (QYM.InfiniteDiagonalHamiltonian.correctedHamiltonian (fun _ => 0))

theorem lemma4_17_correctedSignLowerBoundStatement_holds :
    lemma4_17_correctedSignLowerBoundStatement := by
  apply
    QYM.InfiniteDiagonalHamiltonian.corrected_hasEigenvalueLowerBound_of_potential_boundedBelow
      (fun _ => 0) 0
  intro n
  exact le_rfl

/-! ## Lemma 4.18 and Appendix A repetitions -/

/-- Lemma 4.18 repeats the same `+∞` direction on the truncated carrier. -/
def lemma4_18_paperSignTendsToTopStatement : Prop :=
  prop4_15_paperSignTendsToTopStatement

theorem lemma4_18_paperSignTendsToTopStatement_refuted :
    ¬ lemma4_18_paperSignTendsToTopStatement :=
  prop4_15_paperSignTendsToTopStatement_refuted

/-- Appendix Lemma A.1 repeats the same necessary eigenpair-level lower-bound consequence. -/
def lemmaA_1_paperSignLowerBoundStatement : Prop :=
  lemma4_17_paperSignLowerBoundStatement

theorem lemmaA_1_paperSignLowerBoundStatement_refuted :
    ¬ lemmaA_1_paperSignLowerBoundStatement :=
  lemma4_17_paperSignLowerBoundStatement_refuted

/-- Appendix Lemma A.2 repeats the paper-sign `+∞` spectral direction. -/
def lemmaA_2_paperSignTendsToTopStatement : Prop :=
  prop4_15_paperSignTendsToTopStatement

theorem lemmaA_2_paperSignTendsToTopStatement_refuted :
    ¬ lemmaA_2_paperSignTendsToTopStatement :=
  prop4_15_paperSignTendsToTopStatement_refuted

/-- One conjunction records the opposite directions of the printed and corrected signs. -/
def diagonalSignDirectionCertificateStatement : Prop :=
  Tendsto (QYM.DiagonalSpectralDirectionNoGo.paperSignLevel 0) atTop atBot ∧
    Tendsto (QYM.DiagonalSpectralDirectionNoGo.correctedSignLevel 0) atTop atTop

theorem diagonalSignDirectionCertificateStatement_holds :
    diagonalSignDirectionCertificateStatement :=
  QYM.DiagonalSpectralDirectionNoGo.opposite_spectral_directions 0

end QYM.FullCertification.PaperNormalized

/-!
# Algebraic quadratic first-variation core

This module certifies the purely algebraic part of the first-variation calculation underlying
Proposition 4.1 and the quantifier pattern in Definition 4.2.  A real bilinear form `B` determines
the quadratic energy `x ↦ B x x`.  Along the affine line `x + t • v` this energy is an exact
quadratic polynomial in `t`; its linear coefficient is `B x v + B v x`.

The declarations below prove that expansion, its increment and difference-quotient forms,
the symmetric simplification, cancellation of skew parts, addition of four quadratic energy
components, and the resulting criticality equivalences on an explicitly supplied admissible set
of variations.

No claim is made here about Fréchet differentiability, integration, Sobolev domains, gauge
invariance, integration by parts, boundary terms, the paper's braided error term, or existence of
critical points.  Applying this algebraic core to the paper therefore still requires separately
constructed analytic and geometric objects identifying its action with the displayed quadratic
model.
-/

namespace QYM.QuadraticFirstVariationCore

variable {X : Type*} [AddCommGroup X] [Module ℝ X]

/-- Real-valued real bilinear forms, written as iterated linear maps. -/
abbrev RealBilinearForm (X : Type*) [AddCommGroup X] [Module ℝ X] :=
  X →ₗ[ℝ] X →ₗ[ℝ] ℝ

/-! ## Quadratic energy and its exact linear coefficient -/

/-- The diagonal quadratic energy associated with a real bilinear form. -/
def quadratic (B : RealBilinearForm X) (x : X) : ℝ :=
  B x x

/-- The exact coefficient of `t` in `quadratic B (x + t • v)`. -/
def firstVariation (B : RealBilinearForm X) (x v : X) : ℝ :=
  B x v + B v x

/-- The exact coefficient of `t²` in `quadratic B (x + t • v)`. -/
def secondOrderCoefficient (B : RealBilinearForm X) (v : X) : ℝ :=
  quadratic B v

/-- The restriction of a quadratic energy to the affine line through `x` in direction `v`. -/
def variationPolynomial (B : RealBilinearForm X) (x v : X) (t : ℝ) : ℝ :=
  quadratic B (x + t • v)

/-- The paper-normalized quadratic energy with the conventional factor `1 / 2`. -/
def halfQuadratic (B : RealBilinearForm X) (x : X) : ℝ :=
  quadratic B x / 2

/-- The exact linear coefficient for the paper-normalized half-quadratic energy. -/
def halfFirstVariation (B : RealBilinearForm X) (x v : X) : ℝ :=
  firstVariation B x v / 2

/-- Restriction of the paper-normalized half-quadratic energy to an affine line. -/
def halfVariationPolynomial (B : RealBilinearForm X) (x v : X) (t : ℝ) : ℝ :=
  halfQuadratic B (x + t • v)

/-- A transparent symmetry predicate, requiring symmetry on every ordered pair. -/
def IsSymmetric (B : RealBilinearForm X) : Prop :=
  ∀ x y : X, B x y = B y x

/-- A transparent skew-symmetry predicate, requiring a sign change on transposition. -/
def IsSkewSymmetric (B : RealBilinearForm X) : Prop :=
  ∀ x y : X, B x y = -B y x

theorem quadratic_zero (B : RealBilinearForm X) :
    quadratic B (0 : X) = 0 := by
  unfold quadratic
  exact LinearMap.map_zero₂ B (0 : X)

theorem quadratic_neg (B : RealBilinearForm X) (x : X) :
    quadratic B (-x) = quadratic B x := by
  unfold quadratic
  rw [LinearMap.map_neg₂, map_neg]
  ring

/-- Quadratic homogeneity is proved directly from bilinearity. -/
theorem quadratic_smul (B : RealBilinearForm X) (t : ℝ) (x : X) :
    quadratic B (t • x) = t ^ 2 * quadratic B x := by
  unfold quadratic
  rw [LinearMap.map_smul₂, map_smul]
  simp only [smul_eq_mul]
  ring

/-- Polarization expansion without any symmetry assumption. -/
theorem quadratic_add (B : RealBilinearForm X) (x y : X) :
    quadratic B (x + y) =
      quadratic B x + firstVariation B x y + quadratic B y := by
  unfold quadratic firstVariation
  rw [LinearMap.map_add₂, map_add, map_add]
  ring

theorem firstVariation_zero_base (B : RealBilinearForm X) (v : X) :
    firstVariation B (0 : X) v = 0 := by
  unfold firstVariation
  rw [LinearMap.map_zero₂, map_zero]
  ring

theorem firstVariation_zero_direction (B : RealBilinearForm X) (x : X) :
    firstVariation B x (0 : X) = 0 := by
  unfold firstVariation
  rw [map_zero, LinearMap.map_zero₂]
  ring

theorem firstVariation_add_base (B : RealBilinearForm X) (x y v : X) :
    firstVariation B (x + y) v =
      firstVariation B x v + firstVariation B y v := by
  unfold firstVariation
  rw [LinearMap.map_add₂, map_add]
  ring

theorem firstVariation_add_direction (B : RealBilinearForm X) (x v w : X) :
    firstVariation B x (v + w) =
      firstVariation B x v + firstVariation B x w := by
  unfold firstVariation
  rw [map_add, LinearMap.map_add₂]
  ring

theorem firstVariation_smul_base (B : RealBilinearForm X) (t : ℝ) (x v : X) :
    firstVariation B (t • x) v = t * firstVariation B x v := by
  unfold firstVariation
  rw [LinearMap.map_smul₂, map_smul]
  simp only [smul_eq_mul]
  ring

theorem firstVariation_smul_direction
    (B : RealBilinearForm X) (t : ℝ) (x v : X) :
    firstVariation B x (t • v) = t * firstVariation B x v := by
  unfold firstVariation
  rw [map_smul, LinearMap.map_smul₂]
  simp only [smul_eq_mul]
  ring

theorem firstVariation_neg_base (B : RealBilinearForm X) (x v : X) :
    firstVariation B (-x) v = -firstVariation B x v := by
  simpa only [neg_one_smul, neg_mul, one_mul] using
    firstVariation_smul_base B (-1 : ℝ) x v

theorem firstVariation_neg_direction (B : RealBilinearForm X) (x v : X) :
    firstVariation B x (-v) = -firstVariation B x v := by
  simpa only [neg_one_smul, neg_mul, one_mul] using
    firstVariation_smul_direction B (-1 : ℝ) x v

/-! ## Exact affine-line expansion -/

/-- The central exact identity: restriction to an affine line is a quadratic polynomial. -/
theorem quadratic_expansion (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    quadratic B (x + t • v) =
      quadratic B x + t * firstVariation B x v + t ^ 2 * quadratic B v := by
  calc
    quadratic B (x + t • v) =
        quadratic B x + firstVariation B x (t • v) + quadratic B (t • v) :=
      quadratic_add B x (t • v)
    _ = quadratic B x + t * firstVariation B x v + t ^ 2 * quadratic B v := by
      rw [firstVariation_smul_direction, quadratic_smul]

theorem variationPolynomial_eq (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    variationPolynomial B x v t =
      quadratic B x + t * firstVariation B x v +
        t ^ 2 * secondOrderCoefficient B v := by
  exact quadratic_expansion B x v t

theorem variationPolynomial_zero (B : RealBilinearForm X) (x v : X) :
    variationPolynomial B x v 0 = quadratic B x := by
  simp [variationPolynomial]

/-- Exact expansion with the conventional `1 / 2` normalization from the leading action. -/
theorem halfQuadratic_expansion (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    halfQuadratic B (x + t • v) =
      halfQuadratic B x + t * halfFirstVariation B x v +
        t ^ 2 * halfQuadratic B v := by
  unfold halfQuadratic halfFirstVariation
  rw [quadratic_expansion]
  ring

theorem halfVariationPolynomial_eq (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    halfVariationPolynomial B x v t =
      halfQuadratic B x + t * halfFirstVariation B x v +
        t ^ 2 * halfQuadratic B v := by
  exact halfQuadratic_expansion B x v t

theorem halfVariationPolynomial_zero (B : RealBilinearForm X) (x v : X) :
    halfVariationPolynomial B x v 0 = halfQuadratic B x := by
  simp [halfVariationPolynomial]

theorem halfQuadratic_increment (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    halfQuadratic B (x + t • v) - halfQuadratic B x =
      t * halfFirstVariation B x v + t ^ 2 * halfQuadratic B v := by
  rw [halfQuadratic_expansion]
  ring

/-- Exact half-quadratic difference quotient; again no limiting argument is used. -/
theorem halfQuadratic_differenceQuotient
    (B : RealBilinearForm X) (x v : X) {t : ℝ} (ht : t ≠ 0) :
    (halfQuadratic B (x + t • v) - halfQuadratic B x) / t =
      halfFirstVariation B x v + t * halfQuadratic B v := by
  rw [halfQuadratic_increment]
  apply (div_eq_iff ht).2
  ring

/-- Increment form of the exact quadratic expansion. -/
theorem quadratic_increment (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    quadratic B (x + t • v) - quadratic B x =
      t * firstVariation B x v + t ^ 2 * quadratic B v := by
  rw [quadratic_expansion]
  ring

/-- After subtracting the linear coefficient, the remainder is exactly quadratic. -/
theorem quadratic_linear_remainder (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    quadratic B (x + t • v) - quadratic B x - t * firstVariation B x v =
      t ^ 2 * quadratic B v := by
  rw [quadratic_expansion]
  ring

/-- The exact difference quotient for nonzero `t`; no limiting argument is used. -/
theorem quadratic_differenceQuotient
    (B : RealBilinearForm X) (x v : X) {t : ℝ} (ht : t ≠ 0) :
    (quadratic B (x + t • v) - quadratic B x) / t =
      firstVariation B x v + t * quadratic B v := by
  rw [quadratic_increment]
  apply (div_eq_iff ht).2
  ring

/-- Multiplication form of the difference-quotient identity, valid also at `t = 0`. -/
theorem quadratic_increment_factored (B : RealBilinearForm X) (x v : X) (t : ℝ) :
    quadratic B (x + t • v) - quadratic B x =
      t * (firstVariation B x v + t * quadratic B v) := by
  rw [quadratic_increment]
  ring

/-- Vanishing linear coefficient leaves only the exact quadratic remainder. -/
theorem quadratic_increment_of_firstVariation_eq_zero
    (B : RealBilinearForm X) (x v : X) (t : ℝ)
    (hvariation : firstVariation B x v = 0) :
    quadratic B (x + t • v) - quadratic B x = t ^ 2 * quadratic B v := by
  rw [quadratic_increment, hvariation]
  ring

/-! ## Symmetric and skew parts -/

theorem isSymmetric_iff (B : RealBilinearForm X) :
    IsSymmetric B ↔ ∀ x y : X, B x y = B y x :=
  Iff.rfl

theorem isSkewSymmetric_iff (B : RealBilinearForm X) :
    IsSkewSymmetric B ↔ ∀ x y : X, B x y = -B y x :=
  Iff.rfl

/-- Symmetry turns the unsymmetrized coefficient into `2 B(x,v)`. -/
theorem firstVariation_of_symmetric
    {B : RealBilinearForm X} (hB : IsSymmetric B) (x v : X) :
    firstVariation B x v = 2 * B x v := by
  rw [firstVariation, hB v x]
  ring

/-- For a symmetric pairing, the factor `1 / 2` in the energy cancels the two cross terms.
This is the precise finite algebra behind the leading-action formula in Proposition 4.1. -/
theorem halfFirstVariation_of_symmetric
    {B : RealBilinearForm X} (hB : IsSymmetric B) (x v : X) :
    halfFirstVariation B x v = B x v := by
  rw [halfFirstVariation, firstVariation_of_symmetric hB]
  ring

/-- The unnormalized skew part `B - Bᵀ`. -/
def skewPart (B : RealBilinearForm X) : RealBilinearForm X :=
  B - B.flip

/-- The unnormalized symmetric part `B + Bᵀ`. -/
def symmetricPart (B : RealBilinearForm X) : RealBilinearForm X :=
  B + B.flip

theorem skewPart_apply (B : RealBilinearForm X) (x y : X) :
    skewPart B x y = B x y - B y x := by
  simp [skewPart, LinearMap.sub_apply]

theorem symmetricPart_apply (B : RealBilinearForm X) (x y : X) :
    symmetricPart B x y = B x y + B y x := by
  simp [symmetricPart, LinearMap.add_apply]

theorem skewPart_isSkewSymmetric (B : RealBilinearForm X) :
    IsSkewSymmetric (skewPart B) := by
  intro x y
  rw [skewPart_apply, skewPart_apply]
  ring

theorem symmetricPart_isSymmetric (B : RealBilinearForm X) :
    IsSymmetric (symmetricPart B) := by
  intro x y
  rw [symmetricPart_apply, symmetricPart_apply]
  ring

/-- Every actual skew-symmetric form vanishes on the diagonal over `ℝ`. -/
theorem quadratic_eq_zero_of_skewSymmetric
    {A : RealBilinearForm X} (hA : IsSkewSymmetric A) (x : X) :
    quadratic A x = 0 := by
  have hdiag := hA x x
  unfold quadratic
  linarith

/-- Every actual skew-symmetric form has zero first-variation coefficient. -/
theorem firstVariation_eq_zero_of_skewSymmetric
    {A : RealBilinearForm X} (hA : IsSkewSymmetric A) (x v : X) :
    firstVariation A x v = 0 := by
  have hpair := hA x v
  unfold firstVariation
  linarith

/-- In particular the canonically extracted skew part vanishes on every diagonal. -/
theorem skewPart_diagonal (B : RealBilinearForm X) (x : X) :
    skewPart B x x = 0 := by
  rw [skewPart_apply]
  ring

theorem quadratic_skewPart (B : RealBilinearForm X) (x : X) :
    quadratic (skewPart B) x = 0 := by
  exact quadratic_eq_zero_of_skewSymmetric (skewPart_isSkewSymmetric B) x

theorem firstVariation_skewPart (B : RealBilinearForm X) (x v : X) :
    firstVariation (skewPart B) x v = 0 := by
  exact firstVariation_eq_zero_of_skewSymmetric (skewPart_isSkewSymmetric B) x v

/-- Adding a skew-symmetric form does not change the diagonal quadratic energy. -/
theorem quadratic_add_skew
    (B A : RealBilinearForm X) (hA : IsSkewSymmetric A) (x : X) :
    quadratic (B + A) x = quadratic B x := by
  simp only [quadratic, LinearMap.add_apply]
  rw [show A x x = 0 by
    simpa only [quadratic] using quadratic_eq_zero_of_skewSymmetric hA x]
  ring

/-- Adding a skew-symmetric form does not change the linear variation coefficient. -/
theorem firstVariation_add_skew
    (B A : RealBilinearForm X) (hA : IsSkewSymmetric A) (x v : X) :
    firstVariation (B + A) x v = firstVariation B x v := by
  rw [show firstVariation (B + A) x v =
      firstVariation B x v + firstVariation A x v by
    simp only [firstVariation, LinearMap.add_apply]
    ring]
  rw [firstVariation_eq_zero_of_skewSymmetric hA]
  ring

/-- The unnormalized symmetric part has twice the original diagonal energy. -/
theorem quadratic_symmetricPart (B : RealBilinearForm X) (x : X) :
    quadratic (symmetricPart B) x = 2 * quadratic B x := by
  rw [quadratic, symmetricPart_apply]
  unfold quadratic
  ring

/-- The symmetric part evaluates to the original first-variation coefficient. -/
theorem symmetricPart_eq_firstVariation (B : RealBilinearForm X) (x v : X) :
    symmetricPart B x v = firstVariation B x v := by
  rfl

/-! ## Four-component action algebra -/

/-- Pointwise sum of four bilinear energy components. -/
def sumFour
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) : RealBilinearForm X :=
  B₁ + B₂ + B₃ + B₄

/-- Sum of the four diagonal quadratic energies. -/
def fourQuadratic
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x : X) : ℝ :=
  quadratic B₁ x + quadratic B₂ x + quadratic B₃ x + quadratic B₄ x

/-- Sum of the four exact first-variation coefficients. -/
def fourFirstVariation
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X) : ℝ :=
  firstVariation B₁ x v + firstVariation B₂ x v +
    firstVariation B₃ x v + firstVariation B₄ x v

theorem sumFour_apply
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x y : X) :
    sumFour B₁ B₂ B₃ B₄ x y =
      B₁ x y + B₂ x y + B₃ x y + B₄ x y := by
  simp [sumFour, LinearMap.add_apply]

theorem quadratic_sumFour
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x : X) :
    quadratic (sumFour B₁ B₂ B₃ B₄) x = fourQuadratic B₁ B₂ B₃ B₄ x := by
  simp only [quadratic, fourQuadratic, sumFour_apply]

/-- The first variation of a four-term sum is the sum of the four first variations. -/
theorem firstVariation_sumFour
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X) :
    firstVariation (sumFour B₁ B₂ B₃ B₄) x v =
      fourFirstVariation B₁ B₂ B₃ B₄ x v := by
  simp only [firstVariation, fourFirstVariation, sumFour_apply]
  ring

/-- The four-component energy has the expected exact affine-line expansion. -/
theorem fourQuadratic_expansion
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X) (t : ℝ) :
    fourQuadratic B₁ B₂ B₃ B₄ (x + t • v) =
      fourQuadratic B₁ B₂ B₃ B₄ x +
        t * fourFirstVariation B₁ B₂ B₃ B₄ x v +
        t ^ 2 * fourQuadratic B₁ B₂ B₃ B₄ v := by
  unfold fourQuadratic fourFirstVariation
  rw [quadratic_expansion, quadratic_expansion, quadratic_expansion,
    quadratic_expansion]
  ring

theorem fourQuadratic_increment
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X) (t : ℝ) :
    fourQuadratic B₁ B₂ B₃ B₄ (x + t • v) - fourQuadratic B₁ B₂ B₃ B₄ x =
      t * fourFirstVariation B₁ B₂ B₃ B₄ x v +
        t ^ 2 * fourQuadratic B₁ B₂ B₃ B₄ v := by
  rw [fourQuadratic_expansion]
  ring

theorem fourQuadratic_differenceQuotient
    (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X) {t : ℝ} (ht : t ≠ 0) :
    (fourQuadratic B₁ B₂ B₃ B₄ (x + t • v) -
        fourQuadratic B₁ B₂ B₃ B₄ x) / t =
      fourFirstVariation B₁ B₂ B₃ B₄ x v +
        t * fourQuadratic B₁ B₂ B₃ B₄ v := by
  rw [fourQuadratic_increment]
  apply (div_eq_iff ht).2
  ring

theorem fourFirstVariation_of_symmetric
    {B₁ B₂ B₃ B₄ : RealBilinearForm X}
    (h₁ : IsSymmetric B₁) (h₂ : IsSymmetric B₂)
    (h₃ : IsSymmetric B₃) (h₄ : IsSymmetric B₄) (x v : X) :
    fourFirstVariation B₁ B₂ B₃ B₄ x v =
      2 * (B₁ x v + B₂ x v + B₃ x v + B₄ x v) := by
  unfold fourFirstVariation
  rw [firstVariation_of_symmetric h₁, firstVariation_of_symmetric h₂,
    firstVariation_of_symmetric h₃, firstVariation_of_symmetric h₄]
  ring

/-! ## Criticality on an explicit admissible variation predicate -/

/-- `x` is critical for the quadratic energy along every explicitly admissible variation. -/
def CriticalOn
    (admissible : X → Prop) (B : RealBilinearForm X) (x : X) : Prop :=
  ∀ v : X, admissible v → firstVariation B x v = 0

/-- Four-component version of criticality, with the same explicit admissibility predicate. -/
def FourCriticalOn
    (admissible : X → Prop) (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x : X) : Prop :=
  ∀ v : X, admissible v → fourFirstVariation B₁ B₂ B₃ B₄ x v = 0

/-- Criticality phrased using the paper-normalized half-quadratic coefficient. -/
def HalfCriticalOn
    (admissible : X → Prop) (B : RealBilinearForm X) (x : X) : Prop :=
  ∀ v : X, admissible v → halfFirstVariation B x v = 0

theorem criticalOn_iff
    (admissible : X → Prop) (B : RealBilinearForm X) (x : X) :
    CriticalOn admissible B x ↔
      ∀ v : X, admissible v → B x v + B v x = 0 :=
  Iff.rfl

/-- Criticality for the sum form is exactly criticality for the sum of its four coefficients. -/
theorem criticalOn_sumFour_iff_fourCriticalOn
    (admissible : X → Prop) (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x : X) :
    CriticalOn admissible (sumFour B₁ B₂ B₃ B₄) x ↔
      FourCriticalOn admissible B₁ B₂ B₃ B₄ x := by
  unfold CriticalOn FourCriticalOn
  constructor
  · intro h v hv
    rw [← firstVariation_sumFour]
    exact h v hv
  · intro h v hv
    rw [firstVariation_sumFour]
    exact h v hv

/-- Multiplying the action by the nonzero scalar `1 / 2` does not change its critical points. -/
theorem halfCriticalOn_iff_criticalOn
    (admissible : X → Prop) (B : RealBilinearForm X) (x : X) :
    HalfCriticalOn admissible B x ↔ CriticalOn admissible B x := by
  unfold HalfCriticalOn CriticalOn
  constructor
  · intro h v hv
    have hhalf := h v hv
    unfold halfFirstVariation at hhalf
    linarith
  · intro h v hv
    rw [halfFirstVariation, h v hv]
    norm_num

/-- Under symmetry, normalized half-quadratic criticality is exactly vanishing of the pairing. -/
theorem halfCriticalOn_iff_pairing_zero_of_symmetric
    (admissible : X → Prop) {B : RealBilinearForm X}
    (hB : IsSymmetric B) (x : X) :
    HalfCriticalOn admissible B x ↔
      ∀ v : X, admissible v → B x v = 0 := by
  unfold HalfCriticalOn
  constructor
  · intro h v hv
    simpa only [halfFirstVariation_of_symmetric hB] using h v hv
  · intro h v hv
    rw [halfFirstVariation_of_symmetric hB, h v hv]

/-- For a symmetric form, criticality is equivalent to vanishing of the one-sided pairing. -/
theorem criticalOn_iff_pairing_zero_of_symmetric
    (admissible : X → Prop) {B : RealBilinearForm X}
    (hB : IsSymmetric B) (x : X) :
    CriticalOn admissible B x ↔
      ∀ v : X, admissible v → B x v = 0 := by
  constructor
  · intro h v hv
    have hvariation := h v hv
    rw [firstVariation_of_symmetric hB] at hvariation
    linarith
  · intro h v hv
    rw [firstVariation_of_symmetric hB, h v hv]
    ring

/-- For four symmetric components, criticality is equivalent to cancellation of the four
one-sided pairings on every admissible variation. -/
theorem fourCriticalOn_iff_pairing_sum_zero_of_symmetric
    (admissible : X → Prop) {B₁ B₂ B₃ B₄ : RealBilinearForm X}
    (h₁ : IsSymmetric B₁) (h₂ : IsSymmetric B₂)
    (h₃ : IsSymmetric B₃) (h₄ : IsSymmetric B₄) (x : X) :
    FourCriticalOn admissible B₁ B₂ B₃ B₄ x ↔
      ∀ v : X, admissible v →
        B₁ x v + B₂ x v + B₃ x v + B₄ x v = 0 := by
  constructor
  · intro h v hv
    have hvariation := h v hv
    rw [fourFirstVariation_of_symmetric h₁ h₂ h₃ h₄] at hvariation
    linarith
  · intro h v hv
    rw [fourFirstVariation_of_symmetric h₁ h₂ h₃ h₄, h v hv]
    ring

/-- Adding a skew-symmetric component preserves criticality on every admissible set. -/
theorem criticalOn_add_skew_iff
    (admissible : X → Prop) (B A : RealBilinearForm X)
    (hA : IsSkewSymmetric A) (x : X) :
    CriticalOn admissible (B + A) x ↔ CriticalOn admissible B x := by
  unfold CriticalOn
  constructor
  · intro h v hv
    rw [← firstVariation_add_skew B A hA x v]
    exact h v hv
  · intro h v hv
    rw [firstVariation_add_skew B A hA x v]
    exact h v hv

/-- A criticality certificate annihilates the exact linear coefficient for each admissible
variation and hence leaves a purely quadratic affine-line increment. -/
theorem quadratic_increment_of_criticalOn
    (admissible : X → Prop) (B : RealBilinearForm X) (x v : X)
    (hcritical : CriticalOn admissible B x) (hv : admissible v) (t : ℝ) :
    quadratic B (x + t • v) - quadratic B x = t ^ 2 * quadratic B v := by
  exact quadratic_increment_of_firstVariation_eq_zero B x v t (hcritical v hv)

end QYM.QuadraticFirstVariationCore

/-!
# Paper-normalized quadratic first-variation statements

This module packages only the exact bilinear algebra isolated in
`QYM.QuadraticFirstVariationCore` under the numbering of Proposition 4.1 and Definition 4.2.
For a symmetric real bilinear form `B`, the coefficient of `t` in the half-quadratic energy
`B (x + t • v) (x + t • v) / 2` is exactly `B x v`.  It also records additivity of this algebraic
first-variation coefficient across four displayed quadratic components and the corresponding
criticality equivalences for an explicit predicate `admissible : X → Prop`.

These are not certifications of the full analytic statements in the paper.  In particular, this
file does not construct the curvature variation, trace integral, Hodge star, Sobolev form domain,
gauge slice, integration-by-parts identity, vanishing cusp boundary term, Fréchet derivative, or
braided correction.  Nor does it identify the paper's nonquadratic mass, mismatch, and remainder
functionals with the four quadratic forms below.  Any such identification remains a separate
analytic or geometric obligation.
-/

namespace QYM.FullCertification.PaperNormalized

open QYM.QuadraticFirstVariationCore

/-! ## Proposition 4.1: exact half-quadratic algebraic core -/

/-- The exact symmetric half-quadratic coefficient and affine-line expansion.

This is the pure algebra explaining cancellation of the factor `1 / 2` against the two cross
terms.  It is intentionally weaker than Proposition 4.1's integral and curvature statement. -/
def prop4_1_symmetricHalfQuadraticStatement : Prop :=
  ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
      (B : RealBilinearForm X),
    IsSymmetric B →
      ∀ x v : X,
        halfFirstVariation B x v = B x v ∧
          ∀ t : ℝ,
            halfQuadratic B (x + t • v) =
              halfQuadratic B x + t * B x v + t ^ 2 * halfQuadratic B v

theorem prop4_1_symmetricHalfQuadraticStatement_holds :
    prop4_1_symmetricHalfQuadraticStatement := by
  intro X instAdd instModule B hB x v
  constructor
  · exact halfFirstVariation_of_symmetric hB x v
  · intro t
    rw [halfQuadratic_expansion, halfFirstVariation_of_symmetric hB]

/-- The first-variation coefficient of a sum of four real quadratic forms is the sum of the four
displayed coefficients.  The four forms are abstract algebraic components; this statement does
not assert that the paper's four analytic action terms are quadratic or already constructed. -/
def prop4_1_fourComponentAdditivityStatement : Prop :=
  ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
      (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x v : X),
    firstVariation (sumFour B₁ B₂ B₃ B₄) x v =
      firstVariation B₁ x v + firstVariation B₂ x v +
        firstVariation B₃ x v + firstVariation B₄ x v

theorem prop4_1_fourComponentAdditivityStatement_holds :
    prop4_1_fourComponentAdditivityStatement := by
  intro X instAdd instModule B₁ B₂ B₃ B₄ x v
  simpa only [fourFirstVariation] using
    firstVariation_sumFour B₁ B₂ B₃ B₄ x v

/-! ## Definition 4.2: explicit admissible-variation criticality -/

/-- For a symmetric half-quadratic energy, vanishing of its exact coefficient on every explicitly
admissible variation is equivalent to vanishing of `B x v` on precisely those variations.

The predicate `admissible` is data in the statement.  No Sobolev or gauge-slice admissibility
predicate is silently supplied. -/
def def4_2_admissibleHalfQuadraticCriticalStatement : Prop :=
  ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
      (admissible : X → Prop) (B : RealBilinearForm X) (x : X),
    IsSymmetric B →
      (HalfCriticalOn admissible B x ↔
        ∀ v : X, admissible v → B x v = 0)

theorem def4_2_admissibleHalfQuadraticCriticalStatement_holds :
    def4_2_admissibleHalfQuadraticCriticalStatement := by
  intro X instAdd instModule admissible B x hB
  exact halfCriticalOn_iff_pairing_zero_of_symmetric admissible hB x

/-- For four displayed quadratic components, criticality of their sum on an explicit admissible
set is equivalent to vanishing of the sum of the four exact coefficients on that same set. -/
def def4_2_admissibleFourComponentCriticalStatement : Prop :=
  ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
      (admissible : X → Prop) (B₁ B₂ B₃ B₄ : RealBilinearForm X) (x : X),
    CriticalOn admissible (sumFour B₁ B₂ B₃ B₄) x ↔
      ∀ v : X, admissible v →
        firstVariation B₁ x v + firstVariation B₂ x v +
          firstVariation B₃ x v + firstVariation B₄ x v = 0

theorem def4_2_admissibleFourComponentCriticalStatement_holds :
    def4_2_admissibleFourComponentCriticalStatement := by
  intro X instAdd instModule admissible B₁ B₂ B₃ B₄ x
  simpa only [FourCriticalOn, fourFirstVariation] using
    criticalOn_sumFour_iff_fourCriticalOn admissible B₁ B₂ B₃ B₄ x

end QYM.FullCertification.PaperNormalized

/-!
# Paper-normalized test-kernel and tail statements

These declarations attach the unconditional `ENNReal` summation core to Definition 4.6,
Definition 4.7, Corollary 4.28, and Lemma 4.29.  The Definition-4.6 statement deliberately records
only the arity and an extended-nonnegative codomain encoding of a test family: the external
Paper-I conditions (T0)--(T4) are not available and are not invented.  The Corollary-4.28 and
Lemma-4.29 statements make the indicator majorant, smoothed-count bound, window decomposition,
and geometric-decay suppliers explicit.

Thus the theorems below are unconditional implications with all analytic input displayed.  They
do not assert a Weyl law, transformed-kernel decay, finiteness of a paper spectrum, or the printed
`C_A T^{-A}` rate without an additional analytic supplier.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Definitions 4.6 and 4.7 -/

/-- Arity/extended-codomain witness for Definition 4.6, without fabricating the missing
(T0)--(T4) conditions or claiming that the zero witness is paper-admissible. -/
def def4_6_testFamilyArityStatement : Prop :=
  ∃ family : QYM.TestKernelTailCore.TestFamily,
    ∀ T t : ℝ, family T t = 0

theorem def4_6_testFamilyArityStatement_holds :
    def4_6_testFamilyArityStatement := by
  refine ⟨fun _ _ => 0, ?_⟩
  intro T t
  rfl

/-- Transparent `ENNReal.tsum` normalization of the smoothed spectral count from Definition 4.7.
The value is allowed to be `∞`, and the index carrier is displayed; no summability premise or
identification with the paper's still-unconstructed spectrum is hidden. -/
def def4_7_smoothedCountStatement : Prop :=
  ∀ (Index : Type) (family : QYM.TestKernelTailCore.TestFamily)
      (spectral : Index → ℝ) (T : ℝ),
    QYM.TestKernelTailCore.SmoothedCount family spectral T =
      ∑' i : Index, family T (spectral i)

theorem def4_7_smoothedCountStatement_holds :
    def4_7_smoothedCountStatement := by
  intro Index family spectral T
  rfl

/-! ## Corollary 4.28 -/

/-- Conditional counting core: a unit-window indicator majorant and a supplied smoothed-count
estimate imply the same bound for the extended-nonnegative window count. -/
def cor4_28_conditionalWindowBoundStatement : Prop :=
  ∀ (Index : Type) (family : QYM.TestKernelTailCore.TestFamily)
      (spectral : Index → ℝ) (T : ℝ) (bound : ℝ≥0∞),
    (∀ i : Index,
        QYM.TestKernelTailCore.InUnitWindow T (spectral i) →
          1 ≤ family T (spectral i)) →
    QYM.TestKernelTailCore.SmoothedCount family spectral T ≤ bound →
    QYM.TestKernelTailCore.WindowCount spectral T ≤ bound

theorem cor4_28_conditionalWindowBoundStatement_holds :
    cor4_28_conditionalWindowBoundStatement := by
  intro Index family spectral T bound hmajorant hbound
  exact
    QYM.TestKernelTailCore.windowCount_le_of_smoothedCount_bound
      hmajorant hbound

/-! ## Lemma 4.29 -/

/-- The unconditional tail arithmetic behind Lemma 4.29: the printed natural cutoff, exact
truncation/tail decomposition, and a finite geometric conclusion under explicitly supplied
window decomposition, finite prefactor, and ratio-below-one hypotheses. -/
def lemma4_29_conditionalTailStatement : Prop :=
  (∀ T : ℝ,
      QYM.TestKernelTailCore.NaturalCutoff T = T + (Real.log T) ^ 2) ∧
  (∀ (Index : Type) (weight : QYM.TestKernelTailCore.TestFamily)
      (spectral : Index → ℝ) (T : ℝ),
      QYM.TestKernelTailCore.SpectralTotal weight spectral T =
        QYM.TestKernelTailCore.NaturalSpectralTruncation weight spectral T +
          QYM.TestKernelTailCore.NaturalSpectralTail weight spectral T) ∧
  ∀ (Index : Type) (weight : QYM.TestKernelTailCore.TestFamily)
      (spectral : Index → ℝ) (T cutoff : ℝ)
      (windowMass : ℕ → ℝ≥0∞) (start : ℕ) (C r : ℝ≥0∞),
    QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff ≤
        QYM.TestKernelTailCore.WindowTail windowMass start →
    C < ∞ →
    r < 1 →
    (∀ k : ℕ, windowMass (start + k) ≤ C * r ^ k) →
    QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff ≤
        C * (1 - r)⁻¹ ∧
      QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff < ∞

theorem lemma4_29_conditionalTailStatement_holds :
    lemma4_29_conditionalTailStatement := by
  refine ⟨?_, ⟨?_, ?_⟩⟩
  · intro T
    rfl
  · intro Index weight spectral T
    exact
      QYM.TestKernelTailCore.spectralTotal_eq_naturalTruncation_add_naturalTail
        weight spectral T
  · intro Index weight spectral T cutoff windowMass start C r
      hdecomposition hC hr hwindow
    constructor
    · exact
        QYM.TestKernelTailCore.spectralTail_le_geometric_of_windowDomination
          hdecomposition hwindow
    · exact
        hdecomposition.trans_lt
          (QYM.TestKernelTailCore.windowTail_lt_top_of_geometric
            hC hr hwindow)

end QYM.FullCertification.PaperNormalized

/-!
# The uniformity obstruction in the Lemma-4.29 tail argument

The paper's Lemma 4.29 needs a tail estimate whose constant is uniform in the moving parameter
`T`.  A decay or support statement proved separately for every fixed `T` does not provide that
uniformity.  This file gives an explicit arithmetic countermodel at the paper's natural cutoff
`T + (log T)^2`.

For each fixed `T`, `movingCutoffSpike T` is supported at one point and hence vanishes identically
above a finite threshold.  Nevertheless, its spike moves with `T` and sits exactly at the natural
cutoff.  Along the integer parameters, the corresponding spectral tail is therefore at least one,
so it cannot satisfy even the inverse-linear (`A = 1`) instance of the paper's claimed
faster-than-any-power uniform estimate.

This is a no-go theorem for the *inference from pointwise-in-`T` decay to a uniform-in-`T` tail
bound*.  It is not a claim that the paper's actual transformed kernels fail Lemma 4.29.  Certifying
those kernels still requires the external Paper-I conditions (T0)--(T4), a quantitative transform
estimate with constants uniform in `T`, and the required spectral window-density estimate.
-/

namespace QYM.KernelTailUniformityNoGo

open scoped BigOperators ENNReal
open QYM.TestKernelTailCore

/-! ## Pointwise decay and the moving-cutoff countermodel -/

/-- A deliberately weak, pointwise-in-parameter decay predicate.  Each fixed kernel vanishes above
some threshold, but the threshold is allowed to depend arbitrarily on the parameter `T`. -/
def HasPointwiseUpperCompactSupport (weight : TestFamily) : Prop :=
  ∀ T : ℝ, ∃ R : ℝ, ∀ t : ℝ, R < t → weight T t = 0

/-- A unit spike situated exactly at the Lemma-4.29 natural cutoff. -/
def movingCutoffSpike (T t : ℝ) : ℝ≥0∞ :=
  if t = NaturalCutoff T then 1 else 0

/-- A fixed explicit spectrum containing the natural cutoff for every nonnegative integer
parameter. -/
def movingCutoffSpectrum (n : ℕ) : ℝ :=
  NaturalCutoff (n : ℝ)

/-- Every fixed member of the moving-spike family has compact upper support.  This is stronger than
mere fixed-`T` polynomial decay, but it still contains no uniformity in `T`. -/
theorem movingCutoffSpike_hasPointwiseUpperCompactSupport :
    HasPointwiseUpperCompactSupport movingCutoffSpike := by
  intro T
  refine ⟨NaturalCutoff T, ?_⟩
  intro t ht
  simp [movingCutoffSpike, ne_of_gt ht]

/-! ## Failure of the uniform inverse-linear tail estimate -/

/-- The `A = 1` natural-cutoff tail estimate for every real parameter `T ≥ 1`, with one finite
constant independent of `T`. -/
def HasUniformInverseLinearNaturalTailBound
    (weight : TestFamily) (spectral : ℕ → ℝ) : Prop :=
  ∃ C : ℝ≥0∞, C < ∞ ∧
    ∀ T : ℝ, 1 ≤ T →
      NaturalSpectralTail weight spectral T ≤ C / ENNReal.ofReal T

/-- At every integer parameter, the spectral term with the same index lies exactly at the natural
cutoff and contributes one to the nonnegative tail. -/
theorem one_le_movingCutoffSpike_naturalSpectralTail (n : ℕ) :
    1 ≤ NaturalSpectralTail movingCutoffSpike movingCutoffSpectrum (n : ℝ) := by
  unfold NaturalSpectralTail SpectralTail
  simpa [movingCutoffSpectrum, movingCutoffSpike] using
    (ENNReal.le_tsum
      (f := fun i : ℕ =>
        if NaturalCutoff (n : ℝ) ≤ movingCutoffSpectrum i then
          movingCutoffSpike (n : ℝ) (movingCutoffSpectrum i)
        else 0)
      n)

/-- The moving-cutoff family admits no finite constant for the uniform inverse-linear tail bound.
Thus fixed-parameter compact support, even for every parameter, cannot supply the missing
uniformity in Lemma 4.29. -/
theorem movingCutoffSpike_no_uniformInverseLinearNaturalTailBound :
    ¬ HasUniformInverseLinearNaturalTailBound
      movingCutoffSpike movingCutoffSpectrum := by
  rintro ⟨C, hC, hbound⟩
  obtain ⟨n, hn⟩ := ENNReal.exists_nat_gt hC.ne
  have hn0 : n ≠ 0 := by
    intro hnzero
    subst n
    simpa using hn
  have hnpos : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
  have hnposReal : (1 : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast hnpos
  have hquotient :
      NaturalSpectralTail movingCutoffSpike movingCutoffSpectrum (n : ℝ) ≤
        C / (n : ℝ≥0∞) := by
    simpa only [ENNReal.ofReal_natCast] using hbound (n : ℝ) hnposReal
  have hnCast_ne_zero : (n : ℝ≥0∞) ≠ 0 := by
    simpa using hn0
  have hproduct :
      NaturalSpectralTail movingCutoffSpike movingCutoffSpectrum (n : ℝ) *
          (n : ℝ≥0∞) ≤ C :=
    (ENNReal.le_div_iff_mul_le
      (Or.inl hnCast_ne_zero) (Or.inl (ENNReal.natCast_ne_top n))).mp hquotient
  have hn_le_product :
      (n : ℝ≥0∞) ≤
        NaturalSpectralTail movingCutoffSpike movingCutoffSpectrum (n : ℝ) *
          (n : ℝ≥0∞) := by
    calc
      (n : ℝ≥0∞) = 1 * (n : ℝ≥0∞) := by simp
      _ ≤ NaturalSpectralTail movingCutoffSpike movingCutoffSpectrum (n : ℝ) *
          (n : ℝ≥0∞) :=
        mul_le_mul_left (one_le_movingCutoffSpike_naturalSpectralTail n) _
  have hn_le_C : (n : ℝ≥0∞) ≤ C :=
    hn_le_product.trans hproduct
  exact (not_lt_of_ge hn_le_C) hn

/-- Closed countermodel package: per-parameter compact upper support coexists with failure of the
uniform natural-cutoff tail estimate. -/
theorem pointwiseCompactSupport_coexists_with_no_uniformNaturalTailBound :
    HasPointwiseUpperCompactSupport movingCutoffSpike ∧
      ¬ HasUniformInverseLinearNaturalTailBound
        movingCutoffSpike movingCutoffSpectrum :=
  ⟨movingCutoffSpike_hasPointwiseUpperCompactSupport,
    movingCutoffSpike_no_uniformInverseLinearNaturalTailBound⟩

end QYM.KernelTailUniformityNoGo

/-!
# Paper-normalized uniformity no-go for Lemma 4.29

These closed statements isolate a missing logical step in the printed proof of Lemma 4.29.  Even
compact upper support for every fixed parameter does not, by itself, imply a tail estimate with one
constant uniform in the moving parameter.  The positive countermodel has a unit spike that follows
the printed cutoff `T + (log T)^2`.

This does not assert that the actual Paper-I transformed kernel is a counterexample.  It proves
only that pointwise-in-`T` decay is insufficient input.  An unconditional certification of the
paper's kernel still needs a quantitative transformed-kernel estimate whose constants are uniform
in `T`, together with the relevant spectral window-density bound.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Lemma 4.29: refuted pointwise-to-uniform inference -/

/-- The overstrong inference that pointwise compact upper support of an arbitrary kernel family
would force a uniform inverse-linear natural-cutoff tail bound on every explicit spectrum.  This is
the `A = 1` slice of the uniformity that the printed faster-than-any-power conclusion would need. -/
def lemma4_29_pointwiseCompactSupportInferenceStatement : Prop :=
  ∀ (weight : QYM.TestKernelTailCore.TestFamily) (spectral : ℕ → ℝ),
    QYM.KernelTailUniformityNoGo.HasPointwiseUpperCompactSupport weight →
      QYM.KernelTailUniformityNoGo.HasUniformInverseLinearNaturalTailBound
        weight spectral

/-- The pointwise-to-uniform inference is false, witnessed by the moving-cutoff spike and its
explicit natural-cutoff spectrum. -/
theorem lemma4_29_pointwiseCompactSupportInferenceStatement_refuted :
    ¬ lemma4_29_pointwiseCompactSupportInferenceStatement := by
  intro hinference
  exact
    QYM.KernelTailUniformityNoGo.movingCutoffSpike_no_uniformInverseLinearNaturalTailBound
      (hinference
        QYM.KernelTailUniformityNoGo.movingCutoffSpike
        QYM.KernelTailUniformityNoGo.movingCutoffSpectrum
        QYM.KernelTailUniformityNoGo.movingCutoffSpike_hasPointwiseUpperCompactSupport)

/-! ## Lemma 4.29: positive existential countermodel -/

/-- Positive packaging of the separation: there exists a kernel family and an explicit spectrum
such that every fixed kernel has compact upper support while no finite uniform inverse-linear
natural-tail constant exists. -/
def lemma4_29_pointwiseCompactSupportUniformTailCountermodelStatement : Prop :=
  ∃ (weight : QYM.TestKernelTailCore.TestFamily) (spectral : ℕ → ℝ),
    QYM.KernelTailUniformityNoGo.HasPointwiseUpperCompactSupport weight ∧
      ¬ QYM.KernelTailUniformityNoGo.HasUniformInverseLinearNaturalTailBound
        weight spectral

theorem lemma4_29_pointwiseCompactSupportUniformTailCountermodelStatement_holds :
    lemma4_29_pointwiseCompactSupportUniformTailCountermodelStatement := by
  exact
    ⟨QYM.KernelTailUniformityNoGo.movingCutoffSpike,
      QYM.KernelTailUniformityNoGo.movingCutoffSpectrum,
      QYM.KernelTailUniformityNoGo.pointwiseCompactSupport_coexists_with_no_uniformNaturalTailBound⟩

end QYM.FullCertification.PaperNormalized

/-!
# Typed evidence for quadratic variation, test-kernel tails, and diagonal sign audits

This module is an independent typed-evidence registry.  It does not modify or extend the
`QYM.FullCertification.TypedEvidence.EvidenceId` datatype.  Each identifier below is assigned one
exact proposition, and `evidenceSound` provides a proof term for precisely that proposition.

A claim link records relevance to a numbered PDF row only.  It does **not** assert that the linked
proposition is definitionally equal to the prose statement, that it supplies every analytic or
geometric hypothesis in the paper, or that it is adequate for terminal certification.  In
particular, the quadratic evidence does not construct the paper's curvature integral or Sobolev
gauge slice; the test-kernel evidence leaves Paper-I admissibility, Weyl bounds, and decay as
explicit suppliers; and the diagonal evidence is a concrete sign countermodel rather than a
self-adjoint continuum realization.  No terminal-status field or function is defined here.
-/

namespace QYM.FullCertification.TypedEvidenceVariationTailSignExtension

open QYM.FullCertification.Registry

/-! ## Stable typed identifiers -/

/-- Typed identifiers for the independent variation, tail, and sign evidence tranche. -/
inductive EvidenceId where
  | quadraticExpansion
  | symmetricHalfVariation
  | fourComponentVariation
  | admissibleCriticality
  | windowCountConditional
  | naturalTailDecomposition
  | geometricTailConditional
  | kernelTailUniformityNoGo
  | paperSignAtBot
  | paperSignNoLeast
  | correctedSignAtTop
  | paperQuadraticNormalization
  | paperTestKernelNormalization
  | paperKernelTailUniformityNoGo
  | paperDiagonalSignNormalization
  | paperCor4_32Normalization
  deriving DecidableEq, Repr

/-! ## Exact propositions carried by the identifiers -/

/-- The exact proposition assigned to each evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .quadraticExpansion =>
      ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
          (B : QYM.QuadraticFirstVariationCore.RealBilinearForm X)
          (x v : X) (t : ℝ),
        QYM.QuadraticFirstVariationCore.quadratic B (x + t • v) =
          QYM.QuadraticFirstVariationCore.quadratic B x +
            t * QYM.QuadraticFirstVariationCore.firstVariation B x v +
            t ^ 2 * QYM.QuadraticFirstVariationCore.quadratic B v
  | .symmetricHalfVariation =>
      ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
          (B : QYM.QuadraticFirstVariationCore.RealBilinearForm X),
        QYM.QuadraticFirstVariationCore.IsSymmetric B →
          ∀ x v : X,
            QYM.QuadraticFirstVariationCore.halfFirstVariation B x v = B x v
  | .fourComponentVariation =>
      ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
          (B₁ B₂ B₃ B₄ : QYM.QuadraticFirstVariationCore.RealBilinearForm X)
          (x v : X),
        QYM.QuadraticFirstVariationCore.firstVariation
            (QYM.QuadraticFirstVariationCore.sumFour B₁ B₂ B₃ B₄) x v =
          QYM.QuadraticFirstVariationCore.fourFirstVariation B₁ B₂ B₃ B₄ x v
  | .admissibleCriticality =>
      ∀ (X : Type) [AddCommGroup X] [Module ℝ X]
          (admissible : X → Prop)
          (B : QYM.QuadraticFirstVariationCore.RealBilinearForm X),
        QYM.QuadraticFirstVariationCore.IsSymmetric B →
          ∀ x : X,
            (QYM.QuadraticFirstVariationCore.HalfCriticalOn admissible B x ↔
              ∀ v : X, admissible v → B x v = 0)
  | .windowCountConditional =>
      ∀ (Index : Type) (family : QYM.TestKernelTailCore.TestFamily)
          (spectral : Index → ℝ) (T : ℝ) (bound : ℝ≥0∞),
        (∀ i : Index,
            QYM.TestKernelTailCore.InUnitWindow T (spectral i) →
              1 ≤ family T (spectral i)) →
        QYM.TestKernelTailCore.SmoothedCount family spectral T ≤ bound →
          QYM.TestKernelTailCore.WindowCount spectral T ≤ bound
  | .naturalTailDecomposition =>
      ∀ (Index : Type) (weight : QYM.TestKernelTailCore.TestFamily)
          (spectral : Index → ℝ) (T : ℝ),
        QYM.TestKernelTailCore.SpectralTotal weight spectral T =
          QYM.TestKernelTailCore.NaturalSpectralTruncation weight spectral T +
            QYM.TestKernelTailCore.NaturalSpectralTail weight spectral T
  | .geometricTailConditional =>
      ∀ (Index : Type) (weight : QYM.TestKernelTailCore.TestFamily)
          (spectral : Index → ℝ) (T cutoff : ℝ)
          (windowMass : ℕ → ℝ≥0∞) (start : ℕ) (C r : ℝ≥0∞),
        QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff ≤
            QYM.TestKernelTailCore.WindowTail windowMass start →
        C < ∞ →
        r < 1 →
        (∀ k : ℕ, windowMass (start + k) ≤ C * r ^ k) →
            QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff ≤
              C * (1 - r)⁻¹ ∧
            QYM.TestKernelTailCore.SpectralTail weight spectral T cutoff < ∞
  | .kernelTailUniformityNoGo =>
      QYM.KernelTailUniformityNoGo.HasPointwiseUpperCompactSupport
          QYM.KernelTailUniformityNoGo.movingCutoffSpike ∧
        ¬ QYM.KernelTailUniformityNoGo.HasUniformInverseLinearNaturalTailBound
            QYM.KernelTailUniformityNoGo.movingCutoffSpike
            QYM.KernelTailUniformityNoGo.movingCutoffSpectrum
  | .paperSignAtBot =>
      ∀ c : ℝ,
        Tendsto (QYM.DiagonalSpectralDirectionNoGo.paperSignLevel c) atTop atBot
  | .paperSignNoLeast =>
      ∀ c : ℝ,
        ¬ ∃ n : ℕ, ∀ m : ℕ,
          QYM.DiagonalSpectralDirectionNoGo.paperSignLevel c n ≤
            QYM.DiagonalSpectralDirectionNoGo.paperSignLevel c m
  | .correctedSignAtTop =>
      ∀ c : ℝ,
        Tendsto
          (QYM.DiagonalSpectralDirectionNoGo.correctedSignLevel c) atTop atTop
  | .paperQuadraticNormalization =>
      QYM.FullCertification.PaperNormalized.prop4_1_symmetricHalfQuadraticStatement ∧
        QYM.FullCertification.PaperNormalized.prop4_1_fourComponentAdditivityStatement ∧
        QYM.FullCertification.PaperNormalized.def4_2_admissibleHalfQuadraticCriticalStatement ∧
        QYM.FullCertification.PaperNormalized.def4_2_admissibleFourComponentCriticalStatement
  | .paperTestKernelNormalization =>
      QYM.FullCertification.PaperNormalized.def4_6_testFamilyArityStatement ∧
        QYM.FullCertification.PaperNormalized.def4_7_smoothedCountStatement ∧
        QYM.FullCertification.PaperNormalized.cor4_28_conditionalWindowBoundStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_29_conditionalTailStatement
  | .paperKernelTailUniformityNoGo =>
      ¬ QYM.FullCertification.PaperNormalized.lemma4_29_pointwiseCompactSupportInferenceStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_29_pointwiseCompactSupportUniformTailCountermodelStatement
  | .paperDiagonalSignNormalization =>
      ¬ QYM.FullCertification.PaperNormalized.prop4_15_paperSignTendsToTopStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.prop4_15_paperSignHasLeastLevelStatement ∧
        QYM.FullCertification.PaperNormalized.prop4_15_correctPaperSignDirectionStatement ∧
        QYM.FullCertification.PaperNormalized.prop4_15_correctedSignTendsToTopStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.lemma4_17_paperSignLowerBoundStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_17_correctedSignLowerBoundStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.lemma4_18_paperSignTendsToTopStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.lemmaA_1_paperSignLowerBoundStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.lemmaA_2_paperSignTendsToTopStatement ∧
        QYM.FullCertification.PaperNormalized.diagonalSignDirectionCertificateStatement
  | .paperCor4_32Normalization =>
      QYM.FullCertification.PaperNormalized.cor4_32_B2EnergyDependentGapStatement ∧
        QYM.FullCertification.PaperNormalized.cor4_32_B2HalfGapStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.cor4_32_B2UniformAdjacentGapInferenceStatement ∧
        QYM.FullCertification.PaperNormalized.cor4_32_B2UniformAdjacentGapCountermodelStatement

/-! ## Proof terms -/

/-- Every identifier carries a proof of exactly its displayed proposition. -/
theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | quadraticExpansion =>
      intro X instAdd instModule B x v t
      exact QYM.QuadraticFirstVariationCore.quadratic_expansion B x v t
  | symmetricHalfVariation =>
      intro X instAdd instModule B hB x v
      exact QYM.QuadraticFirstVariationCore.halfFirstVariation_of_symmetric hB x v
  | fourComponentVariation =>
      intro X instAdd instModule B₁ B₂ B₃ B₄ x v
      exact QYM.QuadraticFirstVariationCore.firstVariation_sumFour B₁ B₂ B₃ B₄ x v
  | admissibleCriticality =>
      intro X instAdd instModule admissible B hB x
      exact
        QYM.QuadraticFirstVariationCore.halfCriticalOn_iff_pairing_zero_of_symmetric
          admissible hB x
  | windowCountConditional =>
      intro Index family spectral T bound hmajorant hbound
      exact
        QYM.TestKernelTailCore.windowCount_le_of_smoothedCount_bound
          hmajorant hbound
  | naturalTailDecomposition =>
      intro Index weight spectral T
      exact
        QYM.TestKernelTailCore.spectralTotal_eq_naturalTruncation_add_naturalTail
          weight spectral T
  | geometricTailConditional =>
      intro Index weight spectral T cutoff windowMass start C r
        hdecomposition hC hr hwindow
      constructor
      · exact
          QYM.TestKernelTailCore.spectralTail_le_geometric_of_windowDomination
            hdecomposition hwindow
      · exact
          hdecomposition.trans_lt
            (QYM.TestKernelTailCore.windowTail_lt_top_of_geometric
              hC hr hwindow)
  | kernelTailUniformityNoGo =>
      exact
        QYM.KernelTailUniformityNoGo.pointwiseCompactSupport_coexists_with_no_uniformNaturalTailBound
  | paperSignAtBot =>
      intro c
      exact QYM.DiagonalSpectralDirectionNoGo.paperSignLevel_tendsto_atBot c
  | paperSignNoLeast =>
      intro c
      exact QYM.DiagonalSpectralDirectionNoGo.paperSignLevel_has_no_least_index c
  | correctedSignAtTop =>
      intro c
      exact QYM.DiagonalSpectralDirectionNoGo.correctedSignLevel_tendsto_atTop c
  | paperQuadraticNormalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.prop4_1_symmetricHalfQuadraticStatement_holds,
          QYM.FullCertification.PaperNormalized.prop4_1_fourComponentAdditivityStatement_holds,
          QYM.FullCertification.PaperNormalized.def4_2_admissibleHalfQuadraticCriticalStatement_holds,
          QYM.FullCertification.PaperNormalized.def4_2_admissibleFourComponentCriticalStatement_holds⟩
  | paperTestKernelNormalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.def4_6_testFamilyArityStatement_holds,
          QYM.FullCertification.PaperNormalized.def4_7_smoothedCountStatement_holds,
          QYM.FullCertification.PaperNormalized.cor4_28_conditionalWindowBoundStatement_holds,
          QYM.FullCertification.PaperNormalized.lemma4_29_conditionalTailStatement_holds⟩
  | paperKernelTailUniformityNoGo =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.lemma4_29_pointwiseCompactSupportInferenceStatement_refuted,
          QYM.FullCertification.PaperNormalized.lemma4_29_pointwiseCompactSupportUniformTailCountermodelStatement_holds⟩
  | paperDiagonalSignNormalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.prop4_15_paperSignTendsToTopStatement_refuted,
          QYM.FullCertification.PaperNormalized.prop4_15_paperSignHasLeastLevelStatement_refuted,
          QYM.FullCertification.PaperNormalized.prop4_15_correctPaperSignDirectionStatement_holds,
          QYM.FullCertification.PaperNormalized.prop4_15_correctedSignTendsToTopStatement_holds,
          QYM.FullCertification.PaperNormalized.lemma4_17_paperSignLowerBoundStatement_refuted,
          QYM.FullCertification.PaperNormalized.lemma4_17_correctedSignLowerBoundStatement_holds,
          QYM.FullCertification.PaperNormalized.lemma4_18_paperSignTendsToTopStatement_refuted,
          QYM.FullCertification.PaperNormalized.lemmaA_1_paperSignLowerBoundStatement_refuted,
          QYM.FullCertification.PaperNormalized.lemmaA_2_paperSignTendsToTopStatement_refuted,
          QYM.FullCertification.PaperNormalized.diagonalSignDirectionCertificateStatement_holds⟩
  | paperCor4_32Normalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.cor4_32_B2EnergyDependentGapStatement_holds,
          QYM.FullCertification.PaperNormalized.cor4_32_B2HalfGapStatement_holds,
          QYM.FullCertification.PaperNormalized.cor4_32_B2UniformAdjacentGapInferenceStatement_refuted,
          QYM.FullCertification.PaperNormalized.cor4_32_B2UniformAdjacentGapCountermodelStatement_holds⟩

/-! ## Proof-carrying certificates and exhaustive enumeration -/

/-- A dependent evidence object retaining the exact proposition proved by its identifier. -/
structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement id

/-- Canonical proof-carrying certificate for one identifier. -/
def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

/-- Complete source-ordered list of this extension's identifiers. -/
def allEvidence : List EvidenceId :=
  [.quadraticExpansion,
   .symmetricHalfVariation,
   .fourComponentVariation,
   .admissibleCriticality,
   .windowCountConditional,
   .naturalTailDecomposition,
   .geometricTailConditional,
   .kernelTailUniformityNoGo,
   .paperSignAtBot,
   .paperSignNoLeast,
   .correctedSignAtTop,
   .paperQuadraticNormalization,
   .paperTestKernelNormalization,
   .paperKernelTailUniformityNoGo,
