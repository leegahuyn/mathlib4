namespace QYM.FullCertification.P4ActualStageNonconstantCoreExtension
















/-!
# P4: a concrete nonconstant continuous core vector

The dense continuous core is useful only after one knows that it contains
more than the distinguished constant eta coordinate.  This file constructs
such a vector on every paper-range stage, without a smooth-atlas premise.

Two distinct points are taken from the proved one-sided cusp collar.  The
normality of the compact Hausdorff stage and Urysohn's lemma then give a
continuous real function which is zero at the inner collar point and one at
the boundary point.  Complexification and the proved injectivity of the
continuous-to-`L²` map show that its `L²` class is not a scalar multiple of
the distinguished inverse-eta section.  Orthogonalizing it supplies an
explicit nonzero vector in the entire distinguished-line complement.

No differentiability, Sobolev regularity, or Paper-I mock input is asserted.
-/

/-! ## 1. Two literal distinct points of the actual stage -/

/-- A height halfway between the lower edge and the retained endpoint of the
one-sided collar. -/
def stageInnerCollarHeight (Y : ℝ) : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y :=
  ⟨Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y - QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius / 2, by
    constructor
    · linarith [QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos]
    · linarith [QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos]⟩

/-- The fixed circle coordinate used for the two separating points. -/
def stageSeparatingAngle : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle :=
  ((0 : ℝ) : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle)

/-- The inner point of the selected one-sided collar. -/
def stageInnerCollarPoint
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y :=
  QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY
    (stageSeparatingAngle, stageInnerCollarHeight Y)

/-- The boundary point with the same circle coordinate. -/
def stageBoundaryCollarPoint
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y :=
  QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY
    (stageSeparatingAngle, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y)

/-- The two collar points are genuinely distinct because their height
coordinates differ by half the positive collar radius. -/
theorem stageInnerCollarPoint_ne_stageBoundaryCollarPoint
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageInnerCollarPoint q hY ≠ stageBoundaryCollarPoint q hY := by
  intro hEq
  have hParameters :=
    (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap_isEmbedding q hY).injective hEq
  have hHeight := congrArg
    (fun p : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageCuspBand Y => p.2.1) hParameters
  change
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y - QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius / 2 =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y at hHeight
  linarith [QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos]

/-! ## 2. Urysohn separation and complexification -/

/-- Urysohn's lemma applied to the two concrete closed singletons. -/
theorem exists_stageSeparatingRealContinuous
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∃ f : C(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, ℝ),
      EqOn f 0 {stageInnerCollarPoint q hY} ∧
      EqOn f 1 {stageBoundaryCollarPoint q hY} ∧
      ∀ x, f x ∈ Set.Icc (0 : ℝ) 1 := by
  exact exists_continuous_zero_one_of_isClosed
    isClosed_singleton isClosed_singleton
    (Set.disjoint_singleton.mpr
      (stageInnerCollarPoint_ne_stageBoundaryCollarPoint q hY))

/-- A chosen separating real continuous function. -/
noncomputable def stageSeparatingRealContinuous
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) : C(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, ℝ) :=
  Classical.choose (exists_stageSeparatingRealContinuous q hY)

theorem stageSeparatingRealContinuous_spec
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    EqOn (stageSeparatingRealContinuous q hY) 0
        {stageInnerCollarPoint q hY} ∧
      EqOn (stageSeparatingRealContinuous q hY) 1
        {stageBoundaryCollarPoint q hY} ∧
      ∀ x, stageSeparatingRealContinuous q hY x ∈
        Set.Icc (0 : ℝ) 1 :=
  Classical.choose_spec (exists_stageSeparatingRealContinuous q hY)

@[simp]
theorem stageSeparatingRealContinuous_inner
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageSeparatingRealContinuous q hY
        (stageInnerCollarPoint q hY) = 0 := by
  exact (stageSeparatingRealContinuous_spec q hY).1
    (Set.mem_singleton _)

@[simp]
theorem stageSeparatingRealContinuous_boundary
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageSeparatingRealContinuous q hY
        (stageBoundaryCollarPoint q hY) = 1 := by
  exact (stageSeparatingRealContinuous_spec q hY).2.1
    (Set.mem_singleton _)

/-- Complexification of the separating coordinate, now in the exact
continuous eta-coordinate core. -/
noncomputable def stageSeparatingComplexContinuous
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousInverseEtaSection Y :=
  ⟨fun x => (stageSeparatingRealContinuous q hY x : ℂ),
    Complex.continuous_ofReal.comp
      (stageSeparatingRealContinuous q hY).continuous⟩

@[simp]
theorem stageSeparatingComplexContinuous_inner
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageSeparatingComplexContinuous q hY
        (stageInnerCollarPoint q hY) = 0 := by
  change
    ((stageSeparatingRealContinuous q hY
      (stageInnerCollarPoint q hY) : ℝ) : ℂ) = 0
  rw [stageSeparatingRealContinuous_inner]
  norm_num

@[simp]
theorem stageSeparatingComplexContinuous_boundary
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageSeparatingComplexContinuous q hY
        (stageBoundaryCollarPoint q hY) = 1 := by
  change
    ((stageSeparatingRealContinuous q hY
      (stageBoundaryCollarPoint q hY) : ℝ) : ℂ) = 1
  rw [stageSeparatingRealContinuous_boundary]
  norm_num

/-- The separating coordinate is not a scalar multiple of the constant-one
continuous section. -/
theorem stageSeparatingComplexContinuous_ne_smul_one
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (c : ℂ) :
    stageSeparatingComplexContinuous q hY ≠
      c • QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousInverseEtaOne Y := by
  intro hEq
  have hInner := DFunLike.congr_fun hEq
    (stageInnerCollarPoint q hY)
  have hBoundary := DFunLike.congr_fun hEq
    (stageBoundaryCollarPoint q hY)
  have hZero : (0 : ℂ) = c := by
    simpa only [stageSeparatingComplexContinuous_inner,
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousInverseEtaOne,
      ContinuousMap.smul_apply, ContinuousMap.const_apply,
      smul_eq_mul, mul_one] using hInner
  have hOne : (1 : ℂ) = c := by
    simpa only [stageSeparatingComplexContinuous_boundary,
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousInverseEtaOne,
      ContinuousMap.smul_apply, ContinuousMap.const_apply,
      smul_eq_mul, mul_one] using hBoundary
  exact one_ne_zero (hOne.trans hZero.symm)

/-! ## 3. A nonconstant and then orthogonal `L²` core vector -/

/-- The `L²` class of the separating continuous eta coordinate. -/
noncomputable def actualStageSeparatingL2
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y
    (stageSeparatingComplexContinuous q hY)

/-- The separating class belongs to the concrete dense continuous core by
construction. -/
theorem actualStageSeparatingL2_mem_continuousL2Core
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageSeparatingL2 q hY ∈
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousL2Core Y := by
  apply (QYM.FullCertification.P4ActualStageContinuousDensityExtension.mem_ActualStageContinuousL2Core_iff
    (actualStageSeparatingL2 q hY)).2
  exact ⟨stageSeparatingComplexContinuous q hY, rfl⟩

/-- Injectivity of the concrete continuous-core inclusion promotes
pointwise nonconstancy to an `L²` noncollinearity theorem. -/
theorem actualStageSeparatingL2_ne_smul_distinguished
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (c : ℂ) :
    actualStageSeparatingL2 q hY ≠
      c • QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y := by
  intro hEq
  apply stageSeparatingComplexContinuous_ne_smul_one q hY c
  apply QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_injective hY
  rw [map_smul, QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_one]
  exact hEq

/-- Orthogonal complement of the entire distinguished inverse-eta line. -/
abbrev ActualStageDistinguishedComplement (Y : ℝ) :
    Submodule ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :=
  (ℂ ∙ QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y)ᗮ

/-- Coefficient of the orthogonal projection of the separating vector onto
the distinguished line. -/
noncomputable def actualStageSeparatingProjectionCoefficient
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) : ℂ :=
  inner ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y)
      (actualStageSeparatingL2 q hY) /
    inner ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y)

/-- The separating vector with its distinguished-line component removed. -/
noncomputable def actualStageSeparatingOrthogonalL2
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  actualStageSeparatingL2 q hY -
    actualStageSeparatingProjectionCoefficient q hY •
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y

/-- The orthogonalized vector belongs to the full distinguished-line
orthogonal complement. -/
theorem actualStageSeparatingOrthogonalL2_mem_complement
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageSeparatingOrthogonalL2 q hY ∈
      ActualStageDistinguishedComplement Y := by
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right]
  simp only [actualStageSeparatingOrthogonalL2,
    inner_sub_right, inner_smul_right,
    actualStageSeparatingProjectionCoefficient]
  rw [div_mul_cancel₀]
  · exact sub_self _
  · exact inner_self_ne_zero.mpr
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection_ne_zero
        (lt_of_lt_of_le one_lt_two hY))

/-- Orthogonalization uses only subtraction and scalar multiplication inside
the continuous core, so the resulting complement vector remains a genuine
continuous-core vector. -/
theorem actualStageSeparatingOrthogonalL2_mem_continuousL2Core
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageSeparatingOrthogonalL2 q hY ∈
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousL2Core Y := by
  rw [actualStageSeparatingOrthogonalL2]
  exact (QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousL2Core Y).sub_mem
    (actualStageSeparatingL2_mem_continuousL2Core q hY)
    ((QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousL2Core Y).smul_mem
      (actualStageSeparatingProjectionCoefficient q hY)
      (QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageDistinguishedInverseEtaSection_mem_continuousL2Core Y))

/-- Orthogonalization did not kill the vector, since the original separating
coordinate was not collinear with the distinguished section. -/
theorem actualStageSeparatingOrthogonalL2_ne_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageSeparatingOrthogonalL2 q hY ≠ 0 := by
  intro hZero
  apply actualStageSeparatingL2_ne_smul_distinguished q hY
    (actualStageSeparatingProjectionCoefficient q hY)
  exact sub_eq_zero.mp hZero

/-- The whole distinguished-line complement is therefore nontrivial on every
paper-range stage. -/
theorem actualStageDistinguishedComplement_nontrivial
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∃ u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
      u ∈ ActualStageDistinguishedComplement Y ∧ u ≠ 0 :=
  ⟨actualStageSeparatingOrthogonalL2 q hY,
    actualStageSeparatingOrthogonalL2_mem_complement q hY,
    actualStageSeparatingOrthogonalL2_ne_zero q hY⟩

theorem actualStageDistinguishedComplement_ne_bot
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualStageDistinguishedComplement Y ≠ ⊥ := by
  intro hBot
  obtain ⟨u, hu, hne⟩ :=
    actualStageDistinguishedComplement_nontrivial q hY
  rw [hBot, Submodule.mem_bot] at hu
  exact hne hu

/-! ## 4. Aggregate unconditional endpoint -/

theorem actualStageNonconstantCoreCertificate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    stageInnerCollarPoint q hY ≠ stageBoundaryCollarPoint q hY ∧
      (∀ c : ℂ, actualStageSeparatingL2 q hY ≠
        c • QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y) ∧
      actualStageSeparatingOrthogonalL2 q hY ∈
        QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousL2Core Y ∧
      actualStageSeparatingOrthogonalL2 q hY ∈
        ActualStageDistinguishedComplement Y ∧
      actualStageSeparatingOrthogonalL2 q hY ≠ 0 ∧
      ActualStageDistinguishedComplement Y ≠ ⊥ := by
  exact
    ⟨stageInnerCollarPoint_ne_stageBoundaryCollarPoint q hY,
      actualStageSeparatingL2_ne_smul_distinguished q hY,
      actualStageSeparatingOrthogonalL2_mem_continuousL2Core q hY,
      actualStageSeparatingOrthogonalL2_mem_complement q hY,
      actualStageSeparatingOrthogonalL2_ne_zero q hY,
      actualStageDistinguishedComplement_ne_bot q hY⟩

end QYM.FullCertification.P4ActualStageNonconstantCoreExtension

