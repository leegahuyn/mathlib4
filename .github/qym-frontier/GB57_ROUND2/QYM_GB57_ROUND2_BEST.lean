theorem actualCutoffExcitationProjection_not_tendsto_norm_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) :
    ¬ Tendsto (fun n => QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n)
      atTop (𝓝 (0 : ActualGlobalL2 →L[ℂ] ActualGlobalL2)) := by
  intro hNorm
  have hNorms :
      Tendsto (fun n => ‖QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n‖)
        atTop (𝓝 0) := by
    simpa only [sub_zero] using
      (tendsto_iff_norm_sub_tendsto_zero.mp hNorm)
  have hSmall :
      ∀ᶠ n in atTop,
        ‖QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n‖ < (1 / 2 : ℝ) :=
    (tendsto_order.1 hNorms).2 (1 / 2 : ℝ) (by norm_num)
  obtain ⟨n, hn⟩ := hSmall.exists
  have hnLarge := actualCutoffEscapeHamiltonian_norm_ge_one q n
  linarith

/-- Operator-norm error of the explicit common-`-1` resolvent relative to
the zero-Hamiltonian limit resolvent. -/
noncomputable def actualCutoffNegativeOneResolventError (n : ℕ) :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffNegativeOneResolvent n -
    QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffLimitNegativeOneResolvent

/-- The resolvent error is exactly one half of the escape projection `Q_n`.
This equality distinguishes pointwise strong convergence from norm
convergence. -/
theorem actualCutoffNegativeOneResolventError_eq_half_escape
    (n : ℕ) :
    actualCutoffNegativeOneResolventError n =
      (1 / 2 : ℂ) • QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n := by
  change
    (-(1 / 2 : ℂ)) •
          (ContinuousLinearMap.id ℂ ActualGlobalL2 +
            QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n) -
        (-(ContinuousLinearMap.id ℂ ActualGlobalL2)) =
      (1 / 2 : ℂ) •
        (ContinuousLinearMap.id ℂ ActualGlobalL2 -
          QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n)
  module

/-- On every member of the moving excitation block, the resolvent error is
exactly one half of that vector. -/
theorem actualCutoffNegativeOneResolventError_apply_of_mem_movingOffGround
    {n : ℕ} {u : ActualGlobalL2}
    (hu : u ∈ QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffMovingOffGround n) :
    actualCutoffNegativeOneResolventError n u = (1 / 2 : ℂ) • u := by
  rw [actualCutoffNegativeOneResolventError_eq_half_escape,
    ContinuousLinearMap.smul_apply,
    QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian_fixed_of_mem_movingOffGround hu]

/-- A nonzero excitation at stage `n` forces the resolvent operator-norm
error to be at least `1/2`. -/
theorem actualCutoffNegativeOneResolventError_norm_ge_half
    {n : ℕ} (hQ : QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n ≠ 0) :
    (1 / 2 : ℝ) ≤ ‖actualCutoffNegativeOneResolventError n‖ := by
  have hExists : ∃ x : ActualGlobalL2,
      QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n x ≠ 0 := by
    by_contra h
    push_neg at h
    apply hQ
    apply ContinuousLinearMap.ext
    intro x
    simpa only [ContinuousLinearMap.zero_apply] using h x
  obtain ⟨x, hx⟩ := hExists
  let v := QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n x
  have hv : v ≠ 0 := hx
  have hvMem : v ∈ QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffMovingOffGround n := ⟨x, rfl⟩
  have hApply :=
    actualCutoffNegativeOneResolventError_apply_of_mem_movingOffGround hvMem
  have hApplyNorm :
      ‖actualCutoffNegativeOneResolventError n v‖ =
        (1 / 2 : ℝ) * ‖v‖ := by
    rw [hApply, norm_smul]
    norm_num
  have hOp := (actualCutoffNegativeOneResolventError n).le_opNorm v
  rw [hApplyNorm] at hOp
  have hvNorm : 0 < ‖v‖ := norm_pos_iff.mpr hv
  nlinarith [norm_nonneg (actualCutoffNegativeOneResolventError n)]

/-- Unconditional stagewise version: the concrete escape-band witness makes
the operator-norm resolvent error at least `1/2` for every natural stage. -/
theorem actualCutoffNegativeOneResolventError_norm_ge_half_at_every_stage
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    (1 / 2 : ℝ) ≤ ‖actualCutoffNegativeOneResolventError n‖ :=
  actualCutoffNegativeOneResolventError_norm_ge_half
    (actualCutoffEscapeHamiltonian_ne_zero q n)

/-- If the escape projections are not eventually zero, then their explicit
common-`-1` resolvents do not converge in operator norm. -/
theorem actualCutoffNegativeOneResolvent_not_tendsto_norm_of_not_eventually_zero
    (hPersistent :
      ¬ ∀ᶠ n in atTop, QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n = 0) :
    ¬ Tendsto (fun n => QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffNegativeOneResolvent n)
