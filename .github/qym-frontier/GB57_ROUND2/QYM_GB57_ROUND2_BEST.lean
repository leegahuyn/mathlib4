namespace QYM.FullCertification.P2StageManifoldWithBoundaryExtension














open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# The actual one-sided cusp collar of the intrinsic compact stage

The ambient quotient collar from
`P2CuspCollarClosureExtension` crosses the truncation horocycle in both
directions.  This file intersects that collar with the actual intrinsic stage
`XSet Y`.  The main point is an exact three-way height dictionary:

* stage membership is `height ≤ gammaTwoCuspLevel Y`;
* stage-interior membership is `height < gammaTwoCuspLevel Y`;
* stage-frontier membership is `height = gammaTwoCuspLevel Y`.

Consequently the half-band `(level - 1/2, level]` embeds openly in the
subtype `X Y`, even though it is not open in the ambient two-sided band.  Its
inverse is an honest `OpenPartialHomeomorph` on the actual stage subtype.

No smooth manifold-with-boundary instance is asserted.  The final section
isolates the one missing datum as an explicitly named half-space-atlas
compatibility proposition.  All topology on which that datum depends is
proved before the residual is stated.
-/

/-! ## 1. Exact height formulae in a selected high cusp -/

/-- The selected tile height of its own high-cusp coordinate is the height
parameter itself. -/
@[simp]
theorem gammaTwoTileHeight_selectedHighPoint
    (q : GammaTwoRightCoset) (p : ℝ × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :
    gammaTwoTileHeight q (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q p) = p.2.1 := by
  unfold gammaTwoTileHeight QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint
  rw [inv_smul_smul]
  exact QYM.FullCertification.P2CuspCollarClosureExtension.horizontalHighPoint_im p

/-- Above height one, the universal modular-height envelope of `t + i h` is
exactly `h`. -/
@[simp]
theorem gammaTwoModularHeightEnvelope_horizontalHighPoint
    (p : ℝ × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :
    gammaTwoModularHeightEnvelope (QYM.FullCertification.P2CuspCollarClosureExtension.horizontalHighPoint p) = p.2.1 := by
  unfold gammaTwoModularHeightEnvelope
  rw [QYM.FullCertification.P2CuspCollarClosureExtension.horizontalHighPoint_im, max_eq_left]
  have hPos : 0 < p.2.1 := lt_trans zero_lt_one p.2.2
  have hInvLtOne : 1 / p.2.1 < 1 := by
    rw [div_lt_one hPos]
    exact p.2.2
  exact (hInvLtOne.trans p.2.2).le

/-- A selected high-cusp point with height strictly below the cutoff has a
whole open modular-envelope neighbourhood in the saturated stage. -/
theorem selectedHighPoint_mem_interior_saturatedXStage_of_height_lt
    (q : GammaTwoRightCoset) {Y : ℝ} (p : ℝ × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight)
    (hp : p.2.1 < gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q p ∈ interior (QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.saturatedXStage Y) := by
  let U : Set ℍ :=
    {z : ℍ |
      gammaTwoModularHeightEnvelope
          ((gammaTwoCosetRep q)⁻¹ • z) < gammaTwoCuspLevel Y}
  have hUOpen : IsOpen U := by
    have hInvContinuous :
        Continuous (fun z : ℍ => (gammaTwoCosetRep q)⁻¹ • z) := by
      change Continuous
        (fun z : ℍ =>
          (((gammaTwoCosetRep q)⁻¹ : SL(2, ℤ)) :
              GL (Fin 2) ℝ) • z)
      exact continuous_const_smul
        (((gammaTwoCosetRep q)⁻¹ : SL(2, ℤ)) : GL (Fin 2) ℝ)
    exact isOpen_lt
      (gammaTwoModularHeightEnvelope_continuous.comp hInvContinuous)
      continuous_const
  have hUSubset : U ⊆ QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.saturatedXStage Y := by
    intro z hz
    change
      gammaTwoModularHeightEnvelope ((gammaTwoCosetRep q)⁻¹ • z) <
        gammaTwoCuspLevel Y at hz
    exact QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.mem_saturatedXStage_of_tileEnvelope_lt q hz
  apply interior_maximal hUSubset hUOpen
  change
    gammaTwoModularHeightEnvelope
        ((gammaTwoCosetRep q)⁻¹ • QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q p) <
      gammaTwoCuspLevel Y
  simpa only [QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint, inv_smul_smul,
    gammaTwoModularHeightEnvelope_horizontalHighPoint] using hp

/-! ## 2. Membership, interior, and frontier on the full high cylinder -/

/-- The central selected cusp circle is part of the actual topological
frontier of the intrinsic stage. -/
theorem selectedCuspCircle_mem_frontier_XSet
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
  have hPiece :
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta ∈
        QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y (gammaTwoTileCuspClass q) := by
    rw [QYM.FullCertification.P2SmoothQuotientAtlasExtension.quotientCuspBoundaryPiece_eq_selectedCuspCircle_range hY q]
    exact ⟨theta, rfl⟩
  apply QYM.FullCertification.P2BoundaryComponentReduction.iUnion_cuspPieces_subset_frontier_XSet
    (QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.horocyclesRemainBoundary_of_two_le_level hY)
  exact Set.mem_iUnion.2
    ⟨gammaTwoTileCuspClass q, hPiece⟩

/-- At normalized level at least two, membership of a selected high-cusp
cylinder point in the actual intrinsic stage is exactly the closed height
inequality. -/
theorem cuspCylinderMap_mem_XSet_iff_height_le
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y ↔
      p.2.1 ≤ gammaTwoCuspLevel Y := by
  rcases p with ⟨theta, h⟩
  induction theta using QuotientAddGroup.induction_on with
  | H t =>
      constructor
      · intro hx
        have hzSat :
            QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q (t, h) ∈ QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.saturatedXStage Y := by
          change gammaTwoQuotientMk (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q (t, h)) ∈
            QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y
          simpa only [QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap_coe, QYM.FullCertification.P2CuspCollarClosureExtension.rawHighCuspMap] using hx
        simpa only [gammaTwoTileHeight_selectedHighPoint] using
          QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.tileHeight_le_level_of_mem_saturatedXStage hY q hzSat
      · intro hh
        rcases lt_or_eq_of_le hh with hhLt | hhEq
        · have hEnvelope :
              gammaTwoModularHeightEnvelope
                  (QYM.FullCertification.P2CuspCollarClosureExtension.horizontalHighPoint (t, h)) <
                gammaTwoCuspLevel Y := by
            simpa only [gammaTwoModularHeightEnvelope_horizontalHighPoint]
              using hhLt
          have hzSat :
              QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q (t, h) ∈ QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.saturatedXStage Y := by
            apply QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.mem_saturatedXStage_of_tileEnvelope_lt q
            simpa only [QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint, inv_smul_smul] using hEnvelope
          change gammaTwoQuotientMk (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q (t, h)) ∈
            QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y at hzSat
          simpa only [QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap_coe, QYM.FullCertification.P2CuspCollarClosureExtension.rawHighCuspMap] using hzSat
        · have hHigh : 1 < gammaTwoCuspLevel Y :=
            lt_of_lt_of_le one_lt_two hY
          have hhSubtype :
              h = (⟨gammaTwoCuspLevel Y, hHigh⟩ : QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :=
            Subtype.ext hhEq
          rw [hhSubtype]
          rw [QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap_at_cuspLevel q hY]
          exact (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).frontier_subset
            (selectedCuspCircle_mem_frontier_XSet q hY (t : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle))

/-- If a selected high-cusp point is at the cutoff level, then it is on the
actual quotient-stage frontier. -/
theorem cuspCylinderMap_mem_frontier_XSet_of_height_eq
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight)
    (hp : p.2.1 = gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
  have hHigh : 1 < gammaTwoCuspLevel Y :=
    lt_of_lt_of_le one_lt_two hY
  have hpHeight :
      p.2 = (⟨gammaTwoCuspLevel Y, hHigh⟩ : QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :=
    Subtype.ext hp
  rw [show p = (p.1,
      (⟨gammaTwoCuspLevel Y, hHigh⟩ : QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight)) by
    exact Prod.ext rfl hpHeight]
  rw [QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap_at_cuspLevel q hY]
  exact selectedCuspCircle_mem_frontier_XSet q hY p.1

/-- The open part of the selected high cusp lies in the actual interior of
the quotient stage exactly below the cutoff. -/
theorem cuspCylinderMap_mem_interior_XSet_iff_height_lt
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
      p.2.1 < gammaTwoCuspLevel Y := by
  constructor
  · intro hx
    have hpLe : p.2.1 ≤ gammaTwoCuspLevel Y :=
      (cuspCylinderMap_mem_XSet_iff_height_le q hY p).1
        (interior_subset hx)
    have hpNe : p.2.1 ≠ gammaTwoCuspLevel Y := by
      intro hpEq
      have hFront :=
        cuspCylinderMap_mem_frontier_XSet_of_height_eq q hY p hpEq
      have hMem : QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y :=
        (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).frontier_subset hFront
      exact ((mem_frontier_iff_notMem_interior hMem).1 hFront) hx
    exact lt_of_le_of_ne hpLe hpNe
  · intro hp
    rcases p with ⟨theta, h⟩
    induction theta using QuotientAddGroup.induction_on with
    | H t =>
        have hzInterior :=
          selectedHighPoint_mem_interior_saturatedXStage_of_height_lt
            q (t, h) hp
        have hQuotientInterior :=
          (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y
            (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q (t, h))).2 hzInterior
        simpa only [QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap_coe, QYM.FullCertification.P2CuspCollarClosureExtension.rawHighCuspMap] using
          hQuotientInterior

/-- On the selected high cusp, the topological frontier is exactly the
cutoff-height slice. -/
theorem cuspCylinderMap_mem_frontier_XSet_iff_height_eq
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
      p.2.1 = gammaTwoCuspLevel Y := by
  constructor
  · intro hx
    have hMem : QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y :=
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).frontier_subset hx
    have hpLe : p.2.1 ≤ gammaTwoCuspLevel Y :=
      (cuspCylinderMap_mem_XSet_iff_height_le q hY p).1 hMem
    have hpNotLt : ¬ p.2.1 < gammaTwoCuspLevel Y := by
      intro hpLt
      exact ((mem_frontier_iff_notMem_interior hMem).1 hx)
        ((cuspCylinderMap_mem_interior_XSet_iff_height_lt q hY p).2 hpLt)
    exact le_antisymm hpLe (not_lt.mp hpNotLt)
  · exact cuspCylinderMap_mem_frontier_XSet_of_height_eq q hY p

/-! ## 3. Exact preimages in the ambient two-sided band -/

/-- Restricting the high-cylinder membership theorem to the already
constructed two-sided band. -/
theorem cuspBandMap_mem_XSet_iff_height_le
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y ↔
      p.2.1 ≤ gammaTwoCuspLevel Y := by
  unfold QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap
  simpa only [Function.comp_apply, QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder] using
    cuspCylinderMap_mem_XSet_iff_height_le q hY
      (QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder hY p)

/-- The full inverse image of `XSet Y` inside the ambient band is the literal
closed half-band. -/
theorem preimage_cuspBandMap_XSet_eq_halfBand
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ⁻¹' QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y =
      Set.univ ×ˢ
        {h : QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y | h.1 ≤ gammaTwoCuspLevel Y} := by
  ext p
  simp only [Set.mem_preimage, Set.mem_prod, Set.mem_univ, true_and,
    Set.mem_setOf_eq, cuspBandMap_mem_XSet_iff_height_le q hY p]

/-- Interior membership in the ambient band is the strict half-band. -/
theorem cuspBandMap_mem_interior_XSet_iff_height_lt
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY p ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
      p.2.1 < gammaTwoCuspLevel Y := by
  unfold QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap
  simpa only [Function.comp_apply, QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder] using
    cuspCylinderMap_mem_interior_XSet_iff_height_lt q hY
      (QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder hY p)

/-- Frontier membership in the ambient band is exactly the central
horocycle. -/
theorem cuspBandMap_mem_frontier_XSet_iff_height_eq
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY p ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
      p.2.1 = gammaTwoCuspLevel Y := by
  unfold QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap
  simpa only [Function.comp_apply, QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder] using
    cuspCylinderMap_mem_frontier_XSet_iff_height_eq q hY
      (QYM.FullCertification.P2CuspCollarClosureExtension.bandToHighCylinder hY p)

/-- Set-level form of the exact frontier preimage. -/
theorem preimage_cuspBandMap_frontier_XSet_eq_levelSlice
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ⁻¹' frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
      Set.univ ×ˢ
        {h : QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y | h.1 = gammaTwoCuspLevel Y} := by
  ext p
  simp only [Set.mem_preimage, Set.mem_prod, Set.mem_univ, true_and,
    Set.mem_setOf_eq, cuspBandMap_mem_frontier_XSet_iff_height_eq q hY p]

/-! ## 4. The one-sided band and its open embedding into `X Y` -/

/-- The actual one-sided height interval carried by the compact stage.  The
lower endpoint is deleted because the ambient collar is open there; the
cutoff endpoint is retained because it is the stage boundary. -/
abbrev OneSidedHeightBand (Y : ℝ) :=
  Set.Ioc (gammaTwoCuspLevel Y - QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius)
    (gammaTwoCuspLevel Y)

/-- Product one-sided cusp band before it is inserted into the stage. -/
abbrev StageCuspBand (Y : ℝ) :=
  QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × OneSidedHeightBand Y

/-- Include the one-sided height band into the ambient two-sided height
band. -/
def oneSidedHeightToCuspBand (Y : ℝ) :
    OneSidedHeightBand Y → QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y :=
  fun h =>
    ⟨h.1, h.2.1,
      lt_of_le_of_lt h.2.2
        (lt_add_of_pos_right _ QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos)⟩

@[simp]
theorem oneSidedHeightToCuspBand_coe
    (Y : ℝ) (h : OneSidedHeightBand Y) :
    (oneSidedHeightToCuspBand Y h).1 = h.1 :=
  rfl

/-- The one-sided interval has exactly the closed-half-band range inside the
ambient two-sided interval. -/
theorem oneSidedHeightToCuspBand_range (Y : ℝ) :
    Set.range (oneSidedHeightToCuspBand Y) =
      {h : QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y | h.1 ≤ gammaTwoCuspLevel Y} := by
  ext h
  constructor
  · rintro ⟨u, rfl⟩
    exact u.2.2
  · intro hh
    let u : OneSidedHeightBand Y :=
      ⟨h.1, h.2.1, hh⟩
    exact ⟨u, Subtype.ext rfl⟩

/-- The interval inclusion is a topological embedding. -/
theorem oneSidedHeightToCuspBand_isEmbedding (Y : ℝ) :
    IsEmbedding (oneSidedHeightToCuspBand Y) := by
  change IsEmbedding
    (fun h : OneSidedHeightBand Y =>
      (⟨h.1, h.2.1,
        lt_of_le_of_lt h.2.2
          (lt_add_of_pos_right _ QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos)⟩ :
        QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y))
  exact
    Topology.IsEmbedding.subtypeVal.codRestrict
      (QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y)
      (fun h : OneSidedHeightBand Y =>
        ⟨h.2.1,
          lt_of_le_of_lt h.2.2
            (lt_add_of_pos_right _ QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos)⟩)

/-- Include the product one-sided band into the ambient product band. -/
def stageBandInclusion (Y : ℝ) :
    StageCuspBand Y → QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y :=
  Prod.map id (oneSidedHeightToCuspBand Y)

@[simp]
theorem stageBandInclusion_apply (Y : ℝ) (p : StageCuspBand Y) :
    stageBandInclusion Y p =
      (p.1, oneSidedHeightToCuspBand Y p.2) :=
  rfl

theorem stageBandInclusion_isEmbedding (Y : ℝ) :
    IsEmbedding (stageBandInclusion Y) := by
  simpa only [stageBandInclusion] using
    Topology.IsEmbedding.id.prodMap
      (oneSidedHeightToCuspBand_isEmbedding Y)

/-- Insert the literal one-sided band into the actual stage subtype. -/
def stageCuspBandMap
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    StageCuspBand Y → QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y :=
  (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).codRestrict
    (QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ∘ stageBandInclusion Y)
    (fun p =>
      (cuspBandMap_mem_XSet_iff_height_le q hY
        (stageBandInclusion Y p)).2 p.2.2.2)

@[simp]
theorem stageCuspBandMap_coe
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (p : StageCuspBand Y) :
    ((stageCuspBandMap q hY p : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : GammaTwoQuotient) =
      QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY (stageBandInclusion Y p) :=
  rfl

/-- The one-sided band map is an embedding before openness of its range is
used. -/
theorem stageCuspBandMap_isEmbedding
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    IsEmbedding (stageCuspBandMap q hY) := by
  have hAmbient : IsEmbedding
      (QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ∘ stageBandInclusion Y) :=
    (QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap_isOpenEmbedding q hY).isEmbedding.comp
      (stageBandInclusion_isEmbedding Y)
  exact hAmbient.codRestrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)
    (fun p =>
      (cuspBandMap_mem_XSet_iff_height_le q hY
        (stageBandInclusion Y p)).2 p.2.2.2)

/-- Its range is the relative intersection of the ambient open cusp band
with the stage. -/
theorem stageCuspBandMap_range
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    Set.range (stageCuspBandMap q hY) =
      ((↑) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → GammaTwoQuotient) ⁻¹'
        Set.range (QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY) := by
  ext x
  constructor
  · rintro ⟨p, rfl⟩
    exact ⟨stageBandInclusion Y p, rfl⟩
  · rintro ⟨p, hp⟩
    have hpMem : QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y := by
      rw [hp]
      exact x.2
    have hpLe : p.2.1 ≤ gammaTwoCuspLevel Y :=
      (cuspBandMap_mem_XSet_iff_height_le q hY p).1 hpMem
    let u : OneSidedHeightBand Y :=
      ⟨p.2.1, p.2.2.1, hpLe⟩
    let d : StageCuspBand Y := (p.1, u)
    have hd : stageBandInclusion Y d = p := by
      apply Prod.ext
      · rfl
      · exact Subtype.ext rfl
    refine ⟨d, Subtype.ext ?_⟩
    change QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY (stageBandInclusion Y d) = x.1
    rw [hd, hp]

/-- Although the height interval is half-closed in the ambient band, its
image is open in the *relative topology of the stage*. -/
theorem stageCuspBandMap_range_isOpen
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    IsOpen (Set.range (stageCuspBandMap q hY)) := by
  rw [stageCuspBandMap_range q hY]
  exact (QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap_isOpenEmbedding q hY).isOpen_range.preimage
    continuous_subtype_val

/-- The actual one-sided cusp band is an open embedded neighbourhood in the
stage subtype. -/
theorem stageCuspBandMap_isOpenEmbedding
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    IsOpenEmbedding (stageCuspBandMap q hY) :=
  ⟨stageCuspBandMap_isEmbedding q hY,
    stageCuspBandMap_range_isOpen q hY⟩

/-! ## 5. The actual stage collar and its frontier slice -/

/-- The retained endpoint of the one-sided height band. -/
def stageBoundaryHeight (Y : ℝ) : OneSidedHeightBand Y :=
  ⟨gammaTwoCuspLevel Y,
    sub_lt_self _ QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos,
    le_rfl⟩

local instance stageCuspBandNonempty (Y : ℝ) :
    Nonempty (StageCuspBand Y) :=
  ⟨(((0 : ℝ) : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle), stageBoundaryHeight Y)⟩

@[simp]
theorem oneSidedHeightToCuspBand_stageBoundaryHeight (Y : ℝ) :
    oneSidedHeightToCuspBand Y (stageBoundaryHeight Y) =
      QYM.FullCertification.P2CuspCollarClosureExtension.cuspLevelBandPoint Y :=
  Subtype.ext rfl

/-- The inverse of the one-sided open embedding is an actual collar chart on
the subtype `X Y`. -/
noncomputable def stageCuspCollarHomeomorph
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    OpenPartialHomeomorph (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (StageCuspBand Y) :=
  ((stageCuspBandMap_isOpenEmbedding q hY).toOpenPartialHomeomorph
    (stageCuspBandMap q hY)).symm

theorem stageCuspCollarHomeomorph_source
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    (stageCuspCollarHomeomorph q hY).source =
      Set.range (stageCuspBandMap q hY) := by
  simp [stageCuspCollarHomeomorph]

theorem stageCuspCollarHomeomorph_target
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    (stageCuspCollarHomeomorph q hY).target = Set.univ := by
  simp [stageCuspCollarHomeomorph]

/-- The collar chart is the inverse of the stage-band parametrization on
every point of the one-sided band. -/
theorem stageCuspCollarHomeomorph_apply_stageCuspBandMap
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (p : StageCuspBand Y) :
    stageCuspCollarHomeomorph q hY (stageCuspBandMap q hY p) = p := by
  unfold stageCuspCollarHomeomorph
  exact
    (stageCuspBandMap_isOpenEmbedding q hY).toOpenPartialHomeomorph_left_inv

/-- The central slice of the one-sided collar is literally the previously
certified selected cusp circle. -/
theorem stageCuspBandMap_at_boundary
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    ((stageCuspBandMap q hY
        (theta, stageBoundaryHeight Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : GammaTwoQuotient) =
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta := by
  rw [stageCuspBandMap_coe]
  change QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY
      (theta,
        oneSidedHeightToCuspBand Y (stageBoundaryHeight Y)) = _
  rw [oneSidedHeightToCuspBand_stageBoundaryHeight]
  exact QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap_at_cuspLevel q hY theta

/-- Pointwise frontier dictionary in the actual one-sided stage collar. -/
theorem stageCuspBandMap_mem_frontier_XSet_iff_boundaryHeight
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (p : StageCuspBand Y) :
    ((stageCuspBandMap q hY p : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : GammaTwoQuotient) ∈
        frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
      p.2.1 = gammaTwoCuspLevel Y := by
  rw [stageCuspBandMap_coe]
  exact cuspBandMap_mem_frontier_XSet_iff_height_eq q hY
    (stageBandInclusion Y p)

/-- Set-level frontier dictionary in one-sided collar coordinates. -/
theorem preimage_stageCuspBandMap_frontier_XSet_eq_boundarySlice
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    stageCuspBandMap q hY ⁻¹'
        {x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y |
          (x.1 : GammaTwoQuotient) ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)} =
      Set.univ ×ˢ
        {h : OneSidedHeightBand Y |
          h.1 = gammaTwoCuspLevel Y} := by
  ext p
  simp only [Set.mem_preimage, Set.mem_setOf_eq, Set.mem_prod,
    Set.mem_univ, true_and,
    stageCuspBandMap_mem_frontier_XSet_iff_boundaryHeight q hY p]

/-- The range of the boundary slice is exactly the named cusp component,
not merely a subset of it. -/
theorem stageBoundarySlice_range_eq_quotientCuspBoundaryPiece
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    Set.range
        (fun theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle =>
          ((stageCuspBandMap q hY
            (theta, stageBoundaryHeight Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
              GammaTwoQuotient)) =
      QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y (gammaTwoTileCuspClass q) := by
  rw [QYM.FullCertification.P2SmoothQuotientAtlasExtension.quotientCuspBoundaryPiece_eq_selectedCuspCircle_range hY q]
  apply Set.Subset.antisymm
  · rintro x ⟨theta, rfl⟩
    exact ⟨theta, (stageCuspBandMap_at_boundary q hY theta).symm⟩
  · rintro x ⟨theta, rfl⟩
    exact ⟨theta, stageCuspBandMap_at_boundary q hY theta⟩

/-- The collar chart sends its actual boundary circle to the retained endpoint
of the one-sided interval. -/
theorem stageCuspCollarHomeomorph_on_boundary
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    stageCuspCollarHomeomorph q hY
        (stageCuspBandMap q hY (theta, stageBoundaryHeight Y)) =
      (theta, stageBoundaryHeight Y) :=
  stageCuspCollarHomeomorph_apply_stageCuspBandMap q hY _

/-! ## 6. Honest endpoint: one explicit smooth half-space residual -/

/-- All topological data needed by a smooth manifold-with-boundary atlas is
now concrete.  The remaining datum is precisely a smooth two-dimensional
half-space atlas whose boundary charts have the sources constructed above
and identify the actual topological frontier with the model-half-space
frontier.

This is a proposition, not a structure field and not an instance.  In
particular, merely mentioning this residual does not install a
`ChartedSpace` or claim `IsManifold`. -/
def StageSmoothHalfSpaceAtlasCompatibilityResidual (Y : ℝ) : Prop :=
  ∃ (_ : ChartedSpace (EuclideanHalfSpace 2) (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y))
    (_ : IsManifold (modelWithCornersEuclideanHalfSpace 2) ∞ (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y)),
    ∀ (q : GammaTwoRightCoset)
      (hY : 2 ≤ gammaTwoCuspLevel Y),
      ∃ e : OpenPartialHomeomorph (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (EuclideanHalfSpace 2),
        e ∈ atlas (EuclideanHalfSpace 2) (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) ∧
        e.source = (stageCuspCollarHomeomorph q hY).source ∧
        ∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, x ∈ e.source →
          (x.1 ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
            modelWithCornersEuclideanHalfSpace 2 (e x) ∈ frontier
              (Set.range (modelWithCornersEuclideanHalfSpace 2)))

/-- The fully proved, quantified topological part of the stage-boundary
certificate. -/
def TopologicalStageBoundaryCollarCertificate (Y : ℝ) : Prop :=
  ∀ (q : GammaTwoRightCoset)
    (hY : 2 ≤ gammaTwoCuspLevel Y),
    (stageCuspCollarHomeomorph q hY).source =
        Set.range (stageCuspBandMap q hY) ∧
    (stageCuspCollarHomeomorph q hY).target = Set.univ ∧
    ∀ p : StageCuspBand Y,
      (((stageCuspBandMap q hY p : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : GammaTwoQuotient) ∈
          frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ↔
        p.2.1 = gammaTwoCuspLevel Y)

theorem topologicalStageBoundaryCollarCertificate
    (Y : ℝ) :
    TopologicalStageBoundaryCollarCertificate Y := by
  intro q hY
  exact
    ⟨stageCuspCollarHomeomorph_source q hY,
      stageCuspCollarHomeomorph_target q hY,
      stageCuspBandMap_mem_frontier_XSet_iff_boundaryHeight q hY⟩

/-- Exact reduction: after the constructions in this file, adjoining a
smooth half-space atlas is the only remaining condition in the combined
stage-boundary certificate. -/
theorem topological_and_smooth_stage_boundary_iff_smoothResidual
    (Y : ℝ) :
    (TopologicalStageBoundaryCollarCertificate Y ∧
        StageSmoothHalfSpaceAtlasCompatibilityResidual Y) ↔
      StageSmoothHalfSpaceAtlasCompatibilityResidual Y := by
  constructor
  · exact And.right
  · intro hSmooth
    exact ⟨topologicalStageBoundaryCollarCertificate Y, hSmooth⟩

/-- Compact theorem exposing all unconditional outputs without silently
inhabiting the smooth residual. -/
theorem stageTopologicalBoundaryClosureCertificate
    (Y : ℝ) :
    TopologicalStageBoundaryCollarCertificate Y ∧
      (∀ (q : GammaTwoRightCoset)
        (hY : 2 ≤ gammaTwoCuspLevel Y),
        QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ⁻¹' QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y =
          Set.univ ×ˢ
            {h : QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y |
              h.1 ≤ gammaTwoCuspLevel Y}) ∧
      (∀ (q : GammaTwoRightCoset)
        (hY : 2 ≤ gammaTwoCuspLevel Y),
        QYM.FullCertification.P2CuspCollarClosureExtension.cuspBandMap q hY ⁻¹' frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
          Set.univ ×ˢ
            {h : QYM.FullCertification.P2CuspCollarClosureExtension.CuspBand Y |
              h.1 = gammaTwoCuspLevel Y}) := by
  exact
    ⟨topologicalStageBoundaryCollarCertificate Y,
      (fun q hY =>
        preimage_cuspBandMap_XSet_eq_halfBand q (Y := Y) hY),
      (fun q hY =>
        preimage_cuspBandMap_frontier_XSet_eq_levelSlice q (Y := Y) hY)⟩

end QYM.FullCertification.P2StageManifoldWithBoundaryExtension

