/-- Claims in a planned terminal class, kept in source order. -/
def claimsOfClass (terminal : TerminalClass) : List ClaimId :=
  allClaims.filter fun claim => plannedClass claim = terminal

theorem provedCandidate_count : (claimsOfClass .provedCandidate).length = 2 := by decide

theorem corrected_count : (claimsOfClass .corrected).length = 21 := by decide

theorem refuted_count : (claimsOfClass .refuted).length = 13 := by decide

theorem blockedExternal_count : (claimsOfClass .blockedExternal).length = 22 := by decide

theorem planned_partition_count :
    (claimsOfClass .provedCandidate).length +
      (claimsOfClass .corrected).length +
      (claimsOfClass .refuted).length +
      (claimsOfClass .blockedExternal).length = 58 := by
  decide

