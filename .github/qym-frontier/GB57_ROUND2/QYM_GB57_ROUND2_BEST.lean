      (hinference QYM.SobolevGaugeSupplierNoGo.finiteCore_denseIn_formDomain)

def lemma4_16_twoPointDensityCountermodelStatement : Prop :=
  QYM.SobolevGaugeSupplierNoGo.DenseAtScales
      QYM.SobolevGaugeSupplierNoGo.equalityClose
      QYM.SobolevGaugeSupplierNoGo.finiteCore
