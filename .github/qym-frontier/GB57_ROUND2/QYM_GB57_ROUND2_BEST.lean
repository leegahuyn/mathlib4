/-!
# Actual mock/RS, Mosco, and uniform-gap incompatibility boundary

The supplied paper does not construct the quantitative objects requested in
Hypotheses 4.20, 4.22, and 4.24.  In particular, it refers to Paper I for the
matched Rankin--Selberg kernel and its normalization, assumes the energy
comparison, and assumes uniform truncation stability.  No Paper-I
coefficient map, matched kernel, positive spectral transform, or constants
`c_RS`, `alpha`, and `beta` are present in the supplied definitions.

This file therefore does not rename an arbitrary frame as an actual
mock/Rankin--Selberg frame.  Instead it proves the exact incompatibilities
forced by the objects that really have been constructed:

* the inverse-eta analysis map and rank-one test vanish on a concrete nonzero
  vector in their full off-test subspace, so even the lower half of the
  requested two-sided estimate is false;
* every compact analysis map on the actual infinite-dimensional off-test
  carrier has the same lower-frame obstruction;
* the cutoff escape Hamiltonians `Q_n = I - P_n` converge strongly to zero,
  and their explicit `-1` resolvents converge strongly, but operator-norm
  resolvent convergence forces the moving excitation blocks to become
  eventually trivial;
* the zero limiting Hamiltonian has the whole space as ground block and the
  zero subspace as its ground complement.

Thus pointwise cutoff convergence cannot be promoted to the requested
nontrivial uniform global-gap result.  Nothing below asserts or denies an
abstract Mosco convergence theorem for unrelated forms; the actual modular
Hamiltonian forms needed for such a statement have not been constructed.
-/

/-! ## 1. The exact two-sided estimate requested by the gap argument -/

section TwoSidedFrameEnergy

variable {H K : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [NormedAddCommGroup K] [NormedSpace ℂ K]

/-- The literal two-sided estimate
`c * ||u||^2 <= ||T u||^2 <= C * (a(u) - lambda0 * ||u||^2)`
on a specified full subspace. -/
def HasTwoSidedFrameEnergyEstimateOn
    (T : H →L[ℂ] K) (S : Submodule ℂ H)
    (a : H → ℝ) (lambda0 c C : ℝ) : Prop :=
  0 < c ∧ 0 < C ∧
    ∀ u : H, u ∈ S →
      c * ‖u‖ ^ 2 ≤ ‖T u‖ ^ 2 ∧
        ‖T u‖ ^ 2 ≤ C * (a u - lambda0 * ‖u‖ ^ 2)

end TwoSidedFrameEnergy

/-- The actual inverse-eta analysis functional cannot satisfy the requested
two-sided frame/energy estimate on its full off-test subspace, for any
candidate energy `a`, ground level `lambda0`, or positive constants. -/
theorem actualInverseEtaAnalysis_no_twoSidedFrameEnergyEstimate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (a : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y → ℝ) (lambda0 : ℝ) :
    ¬ ∃ c C : ℝ,
      HasTwoSidedFrameEnergyEstimateOn
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaAnalysisFunctional Y)
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)
        a lambda0 c C := by
  rintro ⟨c, C, hc, hC, hBounds⟩
  let w := QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness q hY
  have hw : w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y :=
    QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness_mem q hY
  have hw0 : w ≠ 0 :=
    QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness_ne_zero q hY
  have hLower := (hBounds w hw).1
  have hVanish :
      ‖QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaAnalysisFunctional Y w‖ ^ 2 = 0 := by
    rw [QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaAnalysisFunctional_witness_eq_zero q hY]
    norm_num
  rw [hVanish] at hLower
  have hwNorm : 0 < ‖w‖ ^ 2 :=
    pow_pos (norm_pos_iff.mpr hw0) 2
  nlinarith

/-- The same obstruction stated for the actual rank-one endomorphism itself.
It is killed by the same concrete nonzero off-test vector. -/
theorem actualInverseEtaRankOneOperator_no_twoSidedFrameEnergyEstimate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (a : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y → ℝ) (lambda0 : ℝ) :
    ¬ ∃ c C : ℝ,
      HasTwoSidedFrameEnergyEstimateOn
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestOperator Y)
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)
        a lambda0 c C := by
  rintro ⟨c, C, hc, hC, hBounds⟩
  let w := QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness q hY
  have hw : w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y :=
    QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness_mem q hY
  have hw0 : w ≠ 0 :=
    QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaOffTestWitness_ne_zero q hY
  have hLower := (hBounds w hw).1
  have hVanish : ‖QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestOperator Y w‖ ^ 2 = 0 := by
    rw [QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaTestOperator_witness_eq_zero q hY]
    norm_num
  rw [hVanish] at hLower
  have hwNorm : 0 < ‖w‖ ^ 2 :=
