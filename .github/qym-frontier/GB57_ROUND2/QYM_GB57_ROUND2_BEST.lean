def actualCutoffEscapeEnergy (n : ℕ) (u : ActualGlobalL2) : ℝ :=
  ‖QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n u‖ ^ 2

/-- Every fixed-vector cutoff energy converges to zero. -/
theorem actualCutoffEscapeEnergy_tendsto_zero (u : ActualGlobalL2) :
    Tendsto (fun n => actualCutoffEscapeEnergy n u) atTop (𝓝 0) := by
