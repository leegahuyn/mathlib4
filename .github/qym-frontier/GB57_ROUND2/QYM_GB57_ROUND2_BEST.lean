/-- Consequently every moving off-ground block is nontrivial, now with a
literal unit-level witness rather than a residual premise. -/
theorem actualCutoffMovingOffGround_nontrivial
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.ActualCutoffMovingOffGroundNontrivial n := by
