namespace QYM

/-! ## Legacy compatibility layer

The declarations in this section keep the public names and statements of the original artifact.
Their docstrings state their exact logical strength.  In particular, homogeneous conjugation is
not the affine gauge transformation of a connection, and a scalar inequality about three real
numbers is not a construction of spectral data.
-/

section RingOnly

variable {R : Type*} [Ring R]

/-- Conjugation by a ring unit `g`. -/
def gconj (g : Rˣ) (A : R) : R := (↑g⁻¹ : R) * A * (↑g : R)

/-- Conjugation by a unit preserves multiplication. -/
theorem gconj_mul (g : Rˣ) (A B : R) : gconj g (A * B) = gconj g A * gconj g B := by
  simp only [gconj, mul_assoc, Units.mul_inv_cancel_left]

/-- Conjugation by a unit preserves subtraction. -/
theorem gconj_sub (g : Rˣ) (A B : R) : gconj g (A - B) = gconj g A - gconj g B := by
  simp only [gconj, mul_sub, sub_mul]

/-- Conjugation by a unit preserves addition. -/
theorem gconj_add (g : Rˣ) (A B : R) : gconj g (A + B) = gconj g A + gconj g B := by
  simp only [gconj, mul_add, add_mul]

end RingOnly

section LegacyComplexAlgebra

variable {R : Type*} [Ring R] [Algebra ℂ R]

/-- Legacy ungraded q-commutator surrogate: `[A,B]_q := A*B - q • (B*A)`. -/
def qbr (q : ℂ) (A B : R) : R := A * B - q • (B * A)

/-- At `q = 1`, the legacy ungraded q-bracket is the ordinary commutator. -/
theorem qbr_one (A B : R) : qbr (1 : ℂ) A B = A * B - B * A := by
  simp [qbr]

/-- Unit conjugation commutes with the central complex-scalar action. -/
theorem gconj_smul (g : Rˣ) (c : ℂ) (A : R) : gconj g (c • A) = c • gconj g A := by
  simp only [gconj, mul_smul_comm, smul_mul_assoc]

/-- Homogeneous conjugation intertwines the legacy q-bracket when `q` is central.

This is a ring identity.  It is not affine connection covariance because no `g⁻¹ dg` term occurs.
-/
theorem qbr_gconj (q : ℂ) (g : Rˣ) (A B : R) :
    gconj g (qbr q A B) = qbr q (gconj g A) (gconj g B) := by
  simp only [qbr, gconj_sub, gconj_mul, gconj_smul]

/-- Legacy two-input polynomial `dA + qbr q A A`.

The argument named `dA` is supplied data; this definition does not construct a differential.
-/
def qCurv (q : ℂ) (dA A : R) : R := dA + qbr q A A

/-- Homogeneous-conjugation covariance of the legacy polynomial `qCurv`.

This does not prove affine gauge covariance of a curvature.  The corrected standard affine
calculation appears in `QYM.AffineGauge` below.
-/
theorem qCurv_gconj (q : ℂ) (g : Rˣ) (dA A : R) :
    gconj g (qCurv q dA A) = qCurv q (gconj g dA) (gconj g A) := by
  unfold qCurv
  rw [gconj_add, qbr_gconj]

/-- If a supplied twisted-cyclicity relation has `σ = id`, the supplied additive functional is
ordinary cyclic.  This theorem neither constructs a trace nor proves a nontrivial twist exists.
-/
theorem trace_cyclic_of_untwisted {Tr : R →+ ℂ} {σ : R →+* R}
    (htw : ∀ X Y : R, Tr (X * Y) = Tr (σ Y * X)) (hid : σ = RingHom.id R) (X Y : R) :
    Tr (X * Y) = Tr (Y * X) := by
  rw [htw, hid]
  rfl

/-- Elementary coercive rearrangement: positivity of `cRS` turns
`cRS * nrm2 ≤ E` into `nrm2 ≤ E / cRS`.

It is not a construction of the norm, energy, or a gauge slice.
-/
theorem coercive_bound {cRS nrm2 E : ℝ} (hc : 0 < cRS) (hRS : cRS * nrm2 ≤ E) :
    nrm2 ≤ E / cRS := by
  rw [le_div_iff₀ hc]
  linarith

/-- Legacy scalar order lemma: if a positive real lower bound is already supplied below `E`, then
`E` is positive.  Despite its retained name, it does not construct eigenvalues or prove a spectral
gap.  Correct gap bookkeeping and a counterexample to the stronger inference appear in
`QYM.SpectralFlowCore`.
-/
theorem lowlying_gap {α m E : ℝ} (hdom : α * m ≤ E) (hpos : 0 < α * m) : 0 < E :=
  lt_of_lt_of_le hpos hdom

/-- Predicate expressing an eventually root-exponential coefficient bound.

This definition records a growth hypothesis; it does not prove the hypothesis for coefficients
arising from the paper.
-/
def RootExpLaw (a : ℕ → ℝ) (C α : ℝ) : Prop :=
  ∀ᶠ n in atTop, |a n| ≤ C / Real.sqrt n * Real.exp (α * Real.sqrt n)

/-- The root-exponential envelope is nonnegative when `C` is nonnegative. -/
theorem rootexp_envelope_nonneg {C α : ℝ} (hC : 0 ≤ C) (n : ℕ) :
    0 ≤ C / Real.sqrt n * Real.exp (α * Real.sqrt n) :=
  mul_nonneg (div_nonneg hC (Real.sqrt_nonneg _)) (Real.exp_nonneg _)

section Examples

example {S : Type*} [Ring S] [Algebra ℂ S] (A B : S) :
    qbr (1 : ℂ) A B = A * B - B * A :=
  qbr_one A B

end Examples

end LegacyComplexAlgebra

/-! ## Algebraic no-go results and corrected graded bracket -/

namespace AlgebraNoGo

/-! ### The modular q-parameter lies strictly inside, not on, the unit circle -/

/-- The standard modular parameter `exp (2 * π * I * τ)` for `τ` in the upper half-plane. -/
def upperHalfPlaneQ (τ : ℍ) : ℂ :=
  Function.Periodic.qParam 1 τ

/-- The standard modular q-parameter never vanishes. -/
theorem upperHalfPlaneQ_ne_zero (τ : ℍ) : upperHalfPlaneQ τ ≠ 0 := by
  simpa [upperHalfPlaneQ] using
    (Function.Periodic.qParam_ne_zero (h := (1 : ℝ)) (τ : ℂ))

/-- For an upper-half-plane parameter, the modular q-parameter has norm strictly below one. -/
theorem upperHalfPlaneQ_norm_lt_one (τ : ℍ) : ‖upperHalfPlaneQ τ‖ < 1 := by
  simpa [upperHalfPlaneQ] using UpperHalfPlane.norm_qParam_lt_one 1 τ

/-- Consequently the modular q-parameter is not on the complex unit circle. -/
theorem upperHalfPlaneQ_not_on_unitCircle (τ : ℍ) : ‖upperHalfPlaneQ τ‖ ≠ 1 :=
  ne_of_lt (upperHalfPlaneQ_norm_lt_one τ)

/-- In particular, the modular q-parameter cannot equal the classical value `1`. -/
theorem upperHalfPlaneQ_ne_one (τ : ℍ) : upperHalfPlaneQ τ ≠ 1 := by
  intro hq
  exact upperHalfPlaneQ_not_on_unitCircle τ (by simp [hq])

/-! ### Scalar scaling cannot be a nontrivial unital automorphism -/

section ScalarAutomorphism

variable {S : Type*} [Ring S] [Algebra ℂ S] [FaithfulSMul ℂ S]

/-- A scalar action on a faithful complex algebra that preserves `1` has scalar `1`. -/
theorem scalar_smul_eq_one_forces_q_one (q : ℂ) (hOne : q • (1 : S) = 1) : q = 1 := by
  apply ((faithfulSMul_iff_injective_smul_one ℂ S).mp inferInstance)
  simpa using hOne

/-- If an algebra automorphism is pointwise scalar multiplication by `q`, then `q = 1`. -/
theorem scalar_smul_algEquiv_forces_q_one (q : ℂ) (e : S ≃ₐ[ℂ] S)
    (hscale : ∀ x : S, e x = q • x) : q = 1 := by
  apply scalar_smul_eq_one_forces_q_one (S := S) q
  calc
    q • (1 : S) = e 1 := (hscale 1).symm
    _ = 1 := e.map_one

/-- Hence an upper-half-plane modular q cannot act by scalar multiplication as a unital
complex-algebra automorphism. -/
theorem upperHalfPlaneQ_not_scalar_algEquiv (τ : ℍ) :
    ¬ ∃ e : S ≃ₐ[ℂ] S, ∀ x : S, e x = upperHalfPlaneQ τ • x := by
  intro h
  obtain ⟨e, he⟩ := h
  exact upperHalfPlaneQ_ne_one τ
    (scalar_smul_algEquiv_forces_q_one (S := S) (upperHalfPlaneQ τ) e he)

end ScalarAutomorphism

/-! ### A scalar q-cyclic additive trace is zero away from q = 1 -/

section QCyclicity

variable {S : Type*} [Ring S]

/-- Scalar q-cyclicity for an additive functional. -/
def IsScalarQCyclic (q : ℂ) (Tr : S →+ ℂ) : Prop :=
  ∀ X Y : S, Tr (X * Y) = q * Tr (Y * X)

namespace IsScalarQCyclic

/-- Substituting the multiplicative unit makes every trace value a fixed point of scaling by q. -/
theorem value_eq_q_mul {q : ℂ} {Tr : S →+ ℂ} (hcyc : IsScalarQCyclic q Tr) (X : S) :
    Tr X = q * Tr X := by
  simpa [IsScalarQCyclic] using hcyc X 1

/-- If `q ≠ 1`, q-cyclicity forces each value of the additive trace to vanish. -/
theorem value_eq_zero_of_ne_one {q : ℂ} {Tr : S →+ ℂ} (hcyc : IsScalarQCyclic q Tr)
    (hq : q ≠ 1) (X : S) : Tr X = 0 := by
  have hprod : (1 - q) * Tr X = 0 := by
    calc
      (1 - q) * Tr X = Tr X - q * Tr X := by rw [sub_mul, one_mul]
      _ = 0 := sub_eq_zero.mpr (hcyc.value_eq_q_mul X)
  exact (mul_eq_zero.mp hprod).resolve_left (sub_ne_zero.mpr (Ne.symm hq))

/-- Thus a scalar q-cyclic additive trace is the zero homomorphism whenever `q ≠ 1`. -/
theorem eq_zero_of_ne_one {q : ℂ} {Tr : S →+ ℂ} (hcyc : IsScalarQCyclic q Tr)
    (hq : q ≠ 1) : Tr = 0 := by
  apply AddMonoidHom.ext
  intro X
  simpa using hcyc.value_eq_zero_of_ne_one hq X

/-- Applying the no-go theorem to the standard upper-half-plane modular parameter. -/
theorem upperHalfPlaneQ_trace_eq_zero (τ : ℍ) {Tr : S →+ ℂ}
    (hcyc : IsScalarQCyclic (upperHalfPlaneQ τ) Tr) : Tr = 0 :=
  hcyc.eq_zero_of_ne_one (upperHalfPlaneQ_ne_one τ)

end IsScalarQCyclic

end QCyclicity

/-! ### The ungraded q-bracket loses the classical quadratic curvature term -/

section Brackets

variable {S : Type*} [Ring S] [Algebra ℂ S]

/-- On equal inputs, the current ungraded q-bracket is `(1-q)` times the square. -/
theorem qbr_self_eq_one_sub_smul (q : ℂ) (A : S) :
    qbr q A A = (1 - q) • (A * A) := by
  simp [qbr, sub_smul]

/-- At `q = 1`, the ungraded self-bracket vanishes identically. -/
theorem ungraded_qbr_classical_self_eq_zero (A : S) : qbr (1 : ℂ) A A = 0 := by
  simp [qbr]

/-- Therefore the legacy `qCurv` collapses to the supplied `dA` input at `q = 1`. -/
theorem ungraded_qCurv_classical_eq_dA (dA A : S) : qCurv (1 : ℂ) dA A = dA := by
  simp [qCurv, qbr]

/-- A parity-aware q-bracket.  Natural-number degrees suffice because only parity occurs through
`(-1)^(pA*pB)`. -/
def gradedQbr (q : ℂ) (pA pB : ℕ) (A B : S) : S :=
  A * B - (q * (-1 : ℂ) ^ (pA * pB)) • (B * A)

/-- If the left input is even, the graded bracket reduces to the legacy ungraded bracket. -/
theorem gradedQbr_even_left (q : ℂ) (pB : ℕ) (A B : S) :
    gradedQbr q 0 pB A B = qbr q A B := by
  simp [gradedQbr, qbr]

/-- At the classical value, two odd inputs give the anticommutator. -/
theorem gradedQbr_classical_odd_odd (A B : S) :
    gradedQbr (1 : ℂ) 1 1 A B = A * B + B * A := by
  simp [gradedQbr]

/-- In particular, the odd self-bracket restores the doubled quadratic term. -/
theorem gradedQbr_classical_odd_self (A : S) :
    gradedQbr (1 : ℂ) 1 1 A A = A * A + A * A := by
  simpa using gradedQbr_classical_odd_odd (A := A) (B := A)

/-- With the conventional factor `1/2`, the odd graded bracket restores exactly `A*A`. -/
def gradedClassicalCurvature (dA A : S) : S :=
  dA + (1 / 2 : ℂ) • gradedQbr (1 : ℂ) 1 1 A A

/-- The corrected odd classical curvature contains the expected quadratic term. -/
theorem gradedClassicalCurvature_eq (dA A : S) :
    gradedClassicalCurvature dA A = dA + A * A := by
  simp only [gradedClassicalCurvature]
  rw [gradedQbr_classical_odd_self]
  rw [← two_smul ℂ (A * A), smul_smul]
  norm_num

end Brackets

/-! ### Hamiltonian sign obstructions -/

/-- A concrete two-dimensional real state space. -/
abbrev TwoState := ℝ × ℝ

/-- The standard Euclidean pairing on `ℝ²`, written explicitly. -/
def pairTwo (x y : TwoState) : ℝ :=
  x.1 * y.1 + x.2 * y.2

/-- A positive-semidefinite diagonal surrogate for a nonnegative Laplacian.
No operator `D`, adjoint, or factorization `Δ = D*D` is encoded in this finite model. -/
def laplacianTwo (x : TwoState) : TwoState :=
  (x.1, 0)

/-- The zero bounded potential. -/
def zeroPotentialTwo (_x : TwoState) : TwoState :=
  0

/-- The sign convention `H = -Δ + V` with `V = 0`. -/
def minusLaplacianHamiltonianTwo (x : TwoState) : TwoState :=
  -laplacianTwo x + zeroPotentialTwo x

/-- The sign convention compatible with a nonnegative Laplacian form: `H = +Δ + V`. -/
def plusLaplacianHamiltonianTwo (x : TwoState) : TwoState :=
  laplacianTwo x + zeroPotentialTwo x

/-- The model Laplacian has nonnegative quadratic form `x₁²`. -/
theorem laplacianTwo_form (x : TwoState) :
    pairTwo x (laplacianTwo x) = x.1 ^ 2 := by
  simp [pairTwo, laplacianTwo, pow_two]

/-- The `-Δ` convention reverses the sign of that form. -/
theorem minusLaplacianHamiltonianTwo_form (x : TwoState) :
    pairTwo x (minusLaplacianHamiltonianTwo x) = -(x.1 ^ 2) := by
  simp [pairTwo, minusLaplacianHamiltonianTwo, laplacianTwo, zeroPotentialTwo, pow_two]

/-- The `+Δ` convention retains the positive form. -/
theorem plusLaplacianHamiltonianTwo_form (x : TwoState) :
    pairTwo x (plusLaplacianHamiltonianTwo x) = x.1 ^ 2 := by
  simp [pairTwo, plusLaplacianHamiltonianTwo, laplacianTwo, zeroPotentialTwo, pow_two]

/-- The positive-sign Hamiltonian is nonnegative in this model. -/
theorem plusLaplacianHamiltonianTwo_nonneg (x : TwoState) :
    0 ≤ pairTwo x (plusLaplacianHamiltonianTwo x) := by
  rw [plusLaplacianHamiltonianTwo_form]
  exact sq_nonneg x.1

/-- At the first basis vector, the `-Δ` Hamiltonian has energy `-1`. -/
theorem minusLaplacianHamiltonianTwo_negative_witness :
    pairTwo (1, 0) (minusLaplacianHamiltonianTwo (1, 0)) = -1 := by
  norm_num [pairTwo, minusLaplacianHamiltonianTwo, laplacianTwo, zeroPotentialTwo]

/-- Even with zero potential, `H = -Δ + V` need not be nonnegative when `Δ` has a
nonnegative quadratic form.  This finite surrogate refutes the lower-bound inference at `V = 0`;
it does not construct an analytic realization or an adjoint factorization of `Δ`. -/
theorem minusLaplacian_zeroPotential_not_nonnegative :
    ¬ ∀ x : TwoState, 0 ≤ pairTwo x (minusLaplacianHamiltonianTwo x) := by
  intro h
  have h₁ := h (1, 0)
  norm_num [pairTwo, minusLaplacianHamiltonianTwo, laplacianTwo, zeroPotentialTwo] at h₁

/-- The two sign conventions already have different quadratic forms in dimension two. -/
theorem Hamiltonian_signs_disagree_on_witness :
    pairTwo (1, 0) (minusLaplacianHamiltonianTwo (1, 0)) ≠
      pairTwo (1, 0) (plusLaplacianHamiltonianTwo (1, 0)) := by
  norm_num [pairTwo, minusLaplacianHamiltonianTwo, plusLaplacianHamiltonianTwo,
    laplacianTwo, zeroPotentialTwo]

/-- If a sequence potential is bounded above, the energies `-n + v n` have no real lower bound.

This infinite discrete model closes the stronger sign obstruction: a bounded potential cannot
repair the unbounded-below behavior of a negative kinetic spectrum tending to infinity.
-/
theorem minusLinear_plus_bounded_not_boundedBelow
    {v : ℕ → ℝ} {M : ℝ} (hv : ∀ n, v n ≤ M) :
    ¬ ∃ C : ℝ, ∀ n : ℕ, C ≤ -(n : ℝ) + v n := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (M - C)
  have hvn := hv n
  have hCn := hC n
  linarith

end AlgebraNoGo

/-! ## Corrected affine gauge algebra

The formulas below model a degree-zero gauge element `g` and a degree-one connection `A`.
The minus sign in `affineGaugeDifferentialRaw` is the graded Leibniz sign.  This section proves
unconditional associative-ring identities after that differential expansion is supplied; it does
not yet construct a differential graded algebra or prove that `dg` and `dA` arise from one.
-/

namespace AffineGauge

section RawRing

variable {S : Type*} [Ring S]

/-- The derivative forced algebraically by `d(gInv*g)=0`. -/
def inverseDifferentialRaw (gInv dg : S) : S :=
  -(gInv * dg * gInv)

/-- The left Maurer--Cartan element `ω = gInv*dg`. -/
def maurerCartanRaw (gInv dg : S) : S :=
  gInv * dg

/-- The expansion of `dω` when `d²g=0`. -/
def maurerCartanDifferentialRaw (gInv dg : S) : S :=
  inverseDifferentialRaw gInv dg * dg

/-- The inverse derivative satisfies the differentiated identity for `gInv*gVal = 1`. -/
theorem inverseDifferentialRaw_mul_add_eq_zero {gInv gVal dg : S}
    (hInvVal : gInv * gVal = 1) :
    inverseDifferentialRaw gInv dg * gVal + gInv * dg = 0 := by
  calc
    inverseDifferentialRaw gInv dg * gVal + gInv * dg =
        -(gInv * dg) * (gInv * gVal) + gInv * dg := by
      simp only [inverseDifferentialRaw]
      noncomm_ring
    _ = 0 := by
      rw [hInvVal]
      simp

/-- The same inverse derivative satisfies the differentiated identity for `gVal*gInv = 1`. -/
theorem add_mul_inverseDifferentialRaw_eq_zero {gInv gVal dg : S}
    (hValInv : gVal * gInv = 1) :
    dg * gInv + gVal * inverseDifferentialRaw gInv dg = 0 := by
  calc
    dg * gInv + gVal * inverseDifferentialRaw gInv dg =
        dg * gInv - (gVal * gInv) * dg * gInv := by
      simp only [inverseDifferentialRaw]
      noncomm_ring
    _ = 0 := by
      rw [hValInv]
      simp

/-- The explicit Maurer--Cartan derivative equals `-ω²`. -/
theorem maurerCartanDifferentialRaw_eq_neg_sq (gInv dg : S) :
    maurerCartanDifferentialRaw gInv dg =
      -(maurerCartanRaw gInv dg * maurerCartanRaw gInv dg) := by
  simp only [maurerCartanDifferentialRaw, inverseDifferentialRaw, maurerCartanRaw]
  noncomm_ring

/-- The explicit Maurer--Cartan expansion satisfies `dω + ω² = 0`. -/
theorem maurerCartanRaw_equation (gInv dg : S) :
    maurerCartanDifferentialRaw gInv dg +
      maurerCartanRaw gInv dg * maurerCartanRaw gInv dg = 0 := by
  rw [maurerCartanDifferentialRaw_eq_neg_sq]
  exact neg_add_cancel _

/-- Standard ungraded curvature polynomial `F = dA + A*A`. -/
def standardCurvature (dA A : S) : S :=
  dA + A * A

/-- The affine gauge transform `A^g = gInv*A*gVal + gInv*dg`. -/
def affineGaugeRaw (gInv gVal dg A : S) : S :=
  gInv * A * gVal + gInv * dg

/-- Explicit graded-Leibniz expansion of `d(A^g)`, assuming the supplied `d²g` term is zero. -/
def affineGaugeDifferentialRaw (gInv gVal dg A dA : S) : S :=
  inverseDifferentialRaw gInv dg * A * gVal +
    gInv * dA * gVal -
    gInv * A * dg +
    inverseDifferentialRaw gInv dg * dg

/-- Before using `gVal*gInv=1`, direct noncommutative expansion leaves three explicit terms. -/
theorem affineCurvature_expansion_raw (gInv gVal dg A dA : S) :
    standardCurvature (affineGaugeDifferentialRaw gInv gVal dg A dA)
        (affineGaugeRaw gInv gVal dg A) =
      gInv * dA * gVal +
        gInv * A * (gVal * gInv) * A * gVal +
        (gInv * A * (gVal * gInv) * dg - gInv * A * dg) := by
  simp only [standardCurvature, affineGaugeDifferentialRaw, affineGaugeRaw,
    inverseDifferentialRaw]
  noncomm_ring

/-- If `gVal*gInv=1`, standard curvature of the supplied affine expansion is homogeneous
conjugation of the original standard curvature. -/
theorem standardCurvature_affine_raw {gInv gVal dg A dA : S}
    (hValInv : gVal * gInv = 1) :
    standardCurvature (affineGaugeDifferentialRaw gInv gVal dg A dA)
        (affineGaugeRaw gInv gVal dg A) =
      gInv * standardCurvature dA A * gVal := by
  calc
    standardCurvature (affineGaugeDifferentialRaw gInv gVal dg A dA)
        (affineGaugeRaw gInv gVal dg A) =
        gInv * dA * gVal +
          gInv * A * (gVal * gInv) * A * gVal +
          (gInv * A * (gVal * gInv) * dg - gInv * A * dg) :=
      affineCurvature_expansion_raw gInv gVal dg A dA
    _ = gInv * dA * gVal + gInv * A * A * gVal := by
      rw [hValInv]
      noncomm_ring
    _ = gInv * standardCurvature dA A * gVal := by
      simp only [standardCurvature]
      noncomm_ring

end RawRing

section UnitGauge

variable {S : Type*} [Ring S]

/-- The inverse differential for a genuine ring unit. -/
def inverseDifferential (g : Sˣ) (dg : S) : S :=
  inverseDifferentialRaw (↑g⁻¹ : S) dg

/-- The Maurer--Cartan element for a genuine ring unit. -/
def maurerCartan (g : Sˣ) (dg : S) : S :=
  maurerCartanRaw (↑g⁻¹ : S) dg

/-- The explicit differential of the Maurer--Cartan element. -/
def maurerCartanDifferential (g : Sˣ) (dg : S) : S :=
  maurerCartanDifferentialRaw (↑g⁻¹ : S) dg

/-- Affine gauge transformation by a genuine ring unit. -/
def affineGauge (g : Sˣ) (dg A : S) : S :=
  affineGaugeRaw (↑g⁻¹ : S) (↑g : S) dg A

/-- The explicit graded differential expansion of `affineGauge g dg A`. -/
def affineGaugeDifferential (g : Sˣ) (dg A dA : S) : S :=
  affineGaugeDifferentialRaw (↑g⁻¹ : S) (↑g : S) dg A dA

/-- Unit specialization of `d(g⁻¹*g)=0`. -/
theorem inverseDifferential_mul_add_eq_zero (g : Sˣ) (dg : S) :
    inverseDifferential g dg * (↑g : S) + (↑g⁻¹ : S) * dg = 0 := by
  simpa [inverseDifferential] using
    (inverseDifferentialRaw_mul_add_eq_zero
      (gInv := (↑g⁻¹ : S)) (gVal := (↑g : S)) (dg := dg) g.inv_mul)

/-- Unit specialization of `d(g*g⁻¹)=0`. -/
theorem add_mul_inverseDifferential_eq_zero (g : Sˣ) (dg : S) :
    dg * (↑g⁻¹ : S) + (↑g : S) * inverseDifferential g dg = 0 := by
  simpa [inverseDifferential] using
    (add_mul_inverseDifferentialRaw_eq_zero
      (gInv := (↑g⁻¹ : S)) (gVal := (↑g : S)) (dg := dg) g.mul_inv)

/-- Unit-specialized Maurer--Cartan equation. -/
theorem maurerCartan_equation (g : Sˣ) (dg : S) :
    maurerCartanDifferential g dg + maurerCartan g dg * maurerCartan g dg = 0 := by
  simpa [maurerCartanDifferential, maurerCartan] using
    maurerCartanRaw_equation (↑g⁻¹ : S) dg

/-- Standard affine gauge covariance as a pure associative-ring identity for the supplied
differential expansion. -/
theorem standardCurvature_affine (g : Sˣ) (dg A dA : S) :
    standardCurvature (affineGaugeDifferential g dg A dA) (affineGauge g dg A) =
      (↑g⁻¹ : S) * standardCurvature dA A * (↑g : S) := by
  simpa [affineGaugeDifferential, affineGauge] using
    (standardCurvature_affine_raw
      (gInv := (↑g⁻¹ : S)) (gVal := (↑g : S)) (dg := dg) (A := A) (dA := dA)
      g.mul_inv)

/-- The same covariance identity expressed through the legacy `QYM.gconj`. -/
theorem standardCurvature_affine_eq_gconj (g : Sˣ) (dg A dA : S) :
    standardCurvature (affineGaugeDifferential g dg A dA) (affineGauge g dg A) =
      QYM.gconj g (standardCurvature dA A) := by
  simpa [QYM.gconj] using standardCurvature_affine g dg A dA

end UnitGauge

/-! ### The legacy ungraded q-bracket is not affine-shift covariant -/

section QBracketCounterexample

/-- At the identity gauge element with `dg=1` and `A=0`, the affine transform is `1`. -/
theorem complex_affineGauge_one_one_zero :
    affineGauge (1 : ℂˣ) 1 0 = (1 : ℂ) := by
  simp [affineGauge, affineGaugeRaw]

/-- For every `q ≠ 1`, the legacy q-bracket fails covariance under the simplest affine shift. -/
theorem qbr_not_affine_covariant_complex {q : ℂ} (hq : q ≠ 1) :
    QYM.qbr q (affineGauge (1 : ℂˣ) 1 0) (affineGauge (1 : ℂˣ) 1 0) ≠
      QYM.gconj (1 : ℂˣ) (QYM.qbr q 0 0) := by
  simpa [complex_affineGauge_one_one_zero, QYM.qbr, QYM.gconj, smul_eq_mul] using
    (sub_ne_zero.mpr (Ne.symm hq) : (1 - q : ℂ) ≠ 0)

/-- A concrete instance of the same failure at `q=0`. -/
theorem qbr_zero_not_affine_covariant_complex :
    QYM.qbr 0 (affineGauge (1 : ℂˣ) 1 0) (affineGauge (1 : ℂˣ) 1 0) ≠
      QYM.gconj (1 : ℂˣ) (QYM.qbr 0 0 0) := by
  simp [complex_affineGauge_one_one_zero, QYM.qbr, QYM.gconj]

end QBracketCounterexample

end AffineGauge

/-! ## Finite-matrix inner-modular weighted trace core

This section implements `σρ(Y)=ρ⁻¹Yρ` and `Trρ(X)=trace(ρX)` with `ρ` bundled as a unit.
It proves twisted cyclicity and the resulting quadratic cancellation.  For the explicit diagonal
density used in the counterexample, invertibility and Hermitian symmetry are formalized; a
later theorem in this same file also certifies `Matrix.PosDef` for that exact density.
-/

namespace WeightedTraceCore

abbrev Square (n : Type*) := Matrix n n ℂ

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Inner modular twist by an invertible density matrix. -/
def modularTwist (rho : (Square n)ˣ) (Y : Square n) : Square n :=
  (↑rho⁻¹ : Square n) * Y * (↑rho : Square n)

/-- Ordinary matrix trace weighted on the left by an invertible density matrix. -/
def weightedTrace (rho : (Square n)ˣ) (X : Square n) : ℂ :=
  Matrix.trace ((↑rho : Square n) * X)

/-- The density cancels the inverse occurring in the modular twist. -/
lemma density_mul_twist_mul
    (rho : (Square n)ˣ) (Y X : Square n) :
    (↑rho : Square n) * (modularTwist rho Y * X) =
      Y * ((↑rho : Square n) * X) := by
  simp only [modularTwist, ← Matrix.mul_assoc, Units.mul_inv, one_mul]

/-- Genuine twisted cyclicity of the finite weighted matrix trace. -/
theorem weightedTrace_twisted_cyclic
    (rho : (Square n)ˣ) (X Y : Square n) :
    weightedTrace rho (X * Y) =
      weightedTrace rho (modularTwist rho Y * X) := by
  unfold weightedTrace
  calc
    Matrix.trace ((↑rho : Square n) * (X * Y)) =
        Matrix.trace (Y * ((↑rho : Square n) * X)) :=
      Matrix.trace_mul_cycle' (↑rho : Square n) X Y
    _ = Matrix.trace ((↑rho : Square n) * (modularTwist rho Y * X)) := by
      rw [density_mul_twist_mul]

lemma weightedTrace_sub
    (rho : (Square n)ˣ) (X Y : Square n) :
    weightedTrace rho (X - Y) = weightedTrace rho X - weightedTrace rho Y := by
  simp [weightedTrace, mul_sub, Matrix.trace_sub]

/-- The twisted commutator in the concrete inner-modular model. -/
def twistedCommutator
    (rho : (Square n)ˣ) (U V : Square n) : Square n :=
  U * V - modularTwist rho V * U

/-- The proposed trace pairing, interpreted as a complex bilinear matrix pairing. -/
def weightedPairing
    (rho : (Square n)ˣ) (U V : Square n) : ℂ :=
  -weightedTrace rho (U * V)

/-- The energy-type cancellation with the second input repeated follows from twisted cyclicity;
it does not require the stronger skew-adjoint identity. -/
theorem twistedCommutator_pair_second_zero
    (rho : (Square n)ˣ) (U V : Square n) :
    weightedPairing rho (twistedCommutator rho U V) V = 0 := by
  have hcycle :
      weightedTrace rho ((U * V) * V) =
        weightedTrace rho ((modularTwist rho V * U) * V) := by
    simpa only [Matrix.mul_assoc] using
      (weightedTrace_twisted_cyclic rho (U * V) V)
  unfold weightedPairing twistedCommutator
  rw [sub_mul, weightedTrace_sub, hcycle, sub_self, neg_zero]

/-- Quadratic energy cancellation, specialized to `N(U) = [U,U]ρ`. -/
theorem twistedCommutator_quadratic_pair_zero
    (rho : (Square n)ˣ) (U : Square n) :
    weightedPairing rho (twistedCommutator rho U U) U = 0 :=
  twistedCommutator_pair_second_zero rho U U

/-! ### Counterexample to the stronger skew-adjoint identity -/

namespace SkewAdjointCounterexample

abbrev Mat2 := Square (Fin 2)

/-- The diagonal matrix `diag(2,1)`, bundled with inverse `diag(1/2,1)`.

Its Hermitian property is proved below, and its `Matrix.PosDef` certificate is proved in the
integrated positivity continuation.
-/
def positiveDiagonalDensity : Mat2ˣ :=
  ⟨!![2, 0; 0, 1], !![(1 / 2 : ℂ), 0; 0, 1],
    by
      norm_num [Matrix.mul_fin_two]
      exact (Matrix.one_fin_two (α := ℂ)).symm,
    by
      norm_num [Matrix.mul_fin_two]
      exact (Matrix.one_fin_two (α := ℂ)).symm⟩

/-- The bundled density has a Hermitian underlying matrix. -/
theorem positiveDiagonalDensity_isHermitian :
    ((positiveDiagonalDensity : Mat2)).IsHermitian := by
  apply Matrix.IsHermitian.ext
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [positiveDiagonalDensity]

def e01 : Mat2 := !![0, 1; 0, 0]

def e10 : Mat2 := !![0, 0; 1, 0]

def e00 : Mat2 := !![1, 0; 0, 0]

theorem skew_left_value :
    weightedPairing positiveDiagonalDensity
        (twistedCommutator positiveDiagonalDensity e01 e10) e00 = -2 := by
  norm_num [weightedPairing, weightedTrace, twistedCommutator, modularTwist,
    positiveDiagonalDensity, e01, e10, e00, Matrix.trace_fin_two,
    Matrix.mul_apply, Fin.sum_univ_two]

theorem skew_right_value :
    -weightedPairing positiveDiagonalDensity e10
        (twistedCommutator positiveDiagonalDensity e01 e00) = -1 := by
  norm_num [weightedPairing, weightedTrace, twistedCommutator, modularTwist,
    positiveDiagonalDensity, e01, e10, e00, Matrix.trace_fin_two,
    Matrix.mul_apply, Fin.sum_univ_two]

/-- The proposed stronger skew identity fails for the same invertible Hermitian diagonal density.
The later combined theorem pairs this calculation with the density's formal `Matrix.PosDef`
certificate.  This theorem concerns the displayed finite-matrix bilinear pairing; it does not
assert that every analytic hypothesis of the paper's theorem has been constructed.
-/
theorem theorem_4_5_skew_identity_fails :
    weightedPairing positiveDiagonalDensity
        (twistedCommutator positiveDiagonalDensity e01 e10) e00 ≠
      -weightedPairing positiveDiagonalDensity e10
        (twistedCommutator positiveDiagonalDensity e01 e00) := by
  rw [skew_left_value, skew_right_value]
  norm_num

end SkewAdjointCounterexample

end WeightedTraceCore

/-! ## Correct spectral-gap and gradient-flow algebraic cores

This namespace stays below the unbounded-operator layer.  It records exact real inequalities and
Hilbert-space identities needed only after a genuine spectral or variational construction has
supplied the quantities and hypotheses appearing in each statement.
-/

namespace SpectralFlowCore

/-! ### Exact ground energy and the first off-ground level -/

/-- If the ground energy is exactly `base` and an off-ground level is at least `base + margin`,
then the corresponding gap is at least `margin`.

The equality in `hground` is essential: replacing it by `base ≤ ground` does not suffice.
-/
theorem gap_lower_bound_of_exact_ground
    {ground next base margin : ℝ}
    (hground : ground = base)
    (hoffGround : base + margin ≤ next) :
    margin ≤ next - ground := by
  linarith

/-- Finite-index version permitting a ground-state block of arbitrary multiplicity.

`isGround` marks all ground indices.  The conclusion compares a marked ground index with an
unmarked index and does not identify list index `1` as excited when ground multiplicity is larger.
-/
theorem finite_index_gap_above_ground_block
    {n : ℕ}
    (eigenvalue : Fin n → ℝ)
    (isGround : Fin n → Prop)
    {groundIndex offGroundIndex : Fin n}
    {base margin : ℝ}
    (hGroundIndex : isGround groundIndex)
    (hOffGroundIndex : ¬ isGround offGroundIndex)
    (hground : ∀ i, isGround i → eigenvalue i = base)
    (hoffGround : ∀ i, ¬ isGround i → base + margin ≤ eigenvalue i) :
    margin ≤ eigenvalue offGroundIndex - eigenvalue groundIndex := by
  exact gap_lower_bound_of_exact_ground
    (hground groundIndex hGroundIndex)
    (hoffGround offGroundIndex hOffGroundIndex)

/-- Simple-ground finite-index specialization.  Here `i ≠ groundIndex` is a finite-coordinate
surrogate for membership in the orthogonal complement of a one-dimensional ground space. -/
theorem finite_index_gap_above_simple_ground
    {n : ℕ}
    (eigenvalue : Fin n → ℝ)
    {groundIndex offGroundIndex : Fin n}
    {base margin : ℝ}
    (hindices : offGroundIndex ≠ groundIndex)
    (hground : eigenvalue groundIndex = base)
    (hoffGround : ∀ i, i ≠ groundIndex → base + margin ≤ eigenvalue i) :
    margin ≤ eigenvalue offGroundIndex - eigenvalue groundIndex := by
  exact gap_lower_bound_of_exact_ground hground (hoffGround offGroundIndex hindices)

/-! ### A quadratic-form counterexample to the original lower-bound inference -/

namespace OriginalGapCounterexample

/-- Coordinate space for a diagonal two-level quadratic-form model. -/
abbrev Vec2 := Fin 2 → ℝ

/-- Squared Euclidean norm in the two-coordinate model. -/
def sqNorm (x : Vec2) : ℝ := x 0 ^ 2 + x 1 ^ 2

/-- The matched mass functional; its null-space is the first coordinate axis. -/
def mass (x : Vec2) : ℝ := x 1 ^ 2

/-- A diagonal quadratic form whose two normalized coordinate values are `100` and
`201 / 2 = 100.5`. -/
def form (x : Vec2) : ℝ := 100 * x 0 ^ 2 + (201 / 2 : ℝ) * x 1 ^ 2

/-- In this coordinate model, `x 0 = 0` describes the orthogonal complement of the matched
null-space. -/
def inMatchedOrthogonal (x : Vec2) : Prop := x 0 = 0

/-- First coordinate unit vector. -/
def basis0 : Vec2 := fun i => if i = 0 then 1 else 0

/-- Second coordinate unit vector. -/
def basis1 : Vec2 := fun i => if i = 1 then 1 else 0

theorem mass_nonneg (x : Vec2) : 0 ≤ mass x := by
  simpa [mass] using sq_nonneg (x 1)

/-- The mass functional has coercivity constant `c = 1` on the matched orthogonal complement. -/
theorem mass_coercive_on_matched_orthogonal
    (x : Vec2) (hx : inMatchedOrthogonal x) :
    sqNorm x ≤ mass x := by
  change x 0 = 0 at hx
  simp [sqNorm, mass, hx]

/-- The quadratic form dominates the mass functional with `alpha = 1` and `beta = 0`. -/
theorem form_dominates_mass (x : Vec2) : mass x ≤ form x := by
  unfold mass form
  nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]

/-- The form is bounded below by `100` times squared norm, not merely by the loose bound zero. -/
theorem exact_ground_form_lower (x : Vec2) : 100 * sqNorm x ≤ form x := by
  unfold sqNorm form
  nlinarith [sq_nonneg (x 1)]

theorem sqNorm_basis0 : sqNorm basis0 = 1 := by
  norm_num [sqNorm, basis0]

theorem form_basis0 : form basis0 = 100 := by
  norm_num [form, basis0]

theorem form_basis1 : form basis1 = (201 / 2 : ℝ) := by
  norm_num [form, basis1]

/-- Difference of the two normalized coordinate values.  Interpreting it as an operator gap
requires a separately constructed diagonal self-adjoint operator. -/
theorem actual_gap : form basis1 - form basis0 = (1 / 2 : ℝ) := by
  rw [form_basis0, form_basis1]
  norm_num

/-- Although `alpha * c = 1`, the coordinate-value difference is `1/2`; the claimed bare
inference `1 ≤ gap` therefore fails in this quadratic-form model. -/
theorem claimed_unit_gap_fails : ¬ (1 : ℝ) ≤ form basis1 - form basis0 := by
  rw [actual_gap]
  norm_num

/-- Purely numerical summary of the invalid inference: `beta` lower-bounds one level,
`beta + alpha*c` lower-bounds another, and `alpha*c > 0`, yet their difference can be smaller than
`alpha*c`. -/
theorem original_scalar_inference_fails :
    (0 : ℝ) ≤ 100 ∧
      (0 : ℝ) + 1 * 1 ≤ 201 / 2 ∧
      (0 : ℝ) < 1 * 1 ∧
      ¬ (1 : ℝ) * 1 ≤ 201 / 2 - 100 := by
  norm_num

end OriginalGapCounterexample

/-! ### Bounded eigenvalue perturbations -/

/-- If both adjacent eigenvalues move by at most `error`, their gap can shrink by at most
`2 * error`.  The eigenvalue-error estimates themselves are hypotheses here. -/
theorem gap_stability_of_two_uniform_errors
    {lower upper perturbedLower perturbedUpper margin error : ℝ}
    (hlower : |perturbedLower - lower| ≤ error)
    (hupper : |perturbedUpper - upper| ≤ error)
    (hgap : margin ≤ upper - lower) :
    margin - 2 * error ≤ perturbedUpper - perturbedLower := by
  obtain ⟨_, hlowerRight⟩ := abs_le.mp hlower
  obtain ⟨hupperLeft, _⟩ := abs_le.mp hupper
  linarith

/-- The criterion `error ≤ margin / 4` preserves at least half of the original gap. -/
theorem half_gap_stability_of_quarter_error
    {lower upper perturbedLower perturbedUpper margin error : ℝ}
    (hlower : |perturbedLower - lower| ≤ error)
    (hupper : |perturbedUpper - upper| ≤ error)
    (hgap : margin ≤ upper - lower)
    (hquarter : error ≤ margin / 4) :
    margin / 2 ≤ perturbedUpper - perturbedLower := by
  have hstable := gap_stability_of_two_uniform_errors hlower hupper hgap
  linarith

/-- A gap stays strictly positive when twice the supplied uniform error is smaller than the
certified original margin. -/
theorem positive_gap_stability
    {lower upper perturbedLower perturbedUpper margin error : ℝ}
    (hlower : |perturbedLower - lower| ≤ error)
    (hupper : |perturbedUpper - upper| ≤ error)
    (hgap : margin ≤ upper - lower)
    (hsmall : 2 * error < margin) :
    0 < perturbedUpper - perturbedLower := by
  have hstable := gap_stability_of_two_uniform_errors hlower hupper hgap
  linarith

/-! ### Correct sign for the Hamiltonian form -/

/-- Algebraic lower-bound core for `H = Δ + V`, where the nonnegative kinetic term is represented
by `‖D u‖²` and the supplied potential form obeys an absolute bound. -/
theorem plus_laplacian_form_lower_bound
    {H K : Type*}
    [SeminormedAddCommGroup H]
    [SeminormedAddCommGroup K]
    (D : H → K)
    (potential : H → ℝ)
    {bound : ℝ}
    (hpotential : ∀ u, |potential u| ≤ bound * ‖u‖ ^ 2)
    (u : H) :
    -bound * ‖u‖ ^ 2 ≤ ‖D u‖ ^ 2 + potential u := by
  have hkinetic : 0 ≤ ‖D u‖ ^ 2 := sq_nonneg ‖D u‖
  have hlowerPotential : -(bound * ‖u‖ ^ 2) ≤ potential u :=
    (abs_le.mp (hpotential u)).1
  linarith

/-- With zero potential, negating kinetic energy `1` destroys the asserted nonnegative bound. -/
theorem minus_laplacian_sign_counterexample : ¬ (0 : ℝ) ≤ -(1 : ℝ) ^ 2 := by
  norm_num

/-! ### Type-correct Hilbert-gradient dissipation -/

/-- Algebraic Hilbert-space core of gradient-flow dissipation.  `velocity` and `gradient` live in
the same real Hilbert space, so the inner product is well-typed. -/
theorem flow_pairing_eq_neg_gradient_norm_sq
    {H : Type*}
    [NormedAddCommGroup H]
    [InnerProductSpace ℝ H]
    {velocity gradient : H}
    (hflow : velocity + gradient = 0) :
    ⟪gradient, velocity⟫_ℝ = -‖gradient‖ ^ 2 := by
  have hvelocity : velocity = -gradient := eq_neg_of_add_eq_zero_left hflow
  rw [hvelocity, inner_neg_right, real_inner_self_eq_norm_sq]

/-- Equivalent dissipation identity expressed using trajectory speed. -/
theorem flow_pairing_eq_neg_velocity_norm_sq
    {H : Type*}
    [NormedAddCommGroup H]
    [InnerProductSpace ℝ H]
    {velocity gradient : H}
    (hflow : velocity + gradient = 0) :
    ⟪gradient, velocity⟫_ℝ = -‖velocity‖ ^ 2 := by
  have hvelocity : velocity = -gradient := eq_neg_of_add_eq_zero_left hflow
  calc
    ⟪gradient, velocity⟫_ℝ = -‖gradient‖ ^ 2 :=
      flow_pairing_eq_neg_gradient_norm_sq hflow
    _ = -‖velocity‖ ^ 2 := by rw [hvelocity, norm_neg]

/-- If a separately justified chain rule identifies the energy derivative with the Hilbert
pairing of gradient and velocity, the derivative is minus the squared speed. -/
theorem hilbert_energy_derivative_eq_neg_speed_sq
    {H : Type*}
    [NormedAddCommGroup H]
    [InnerProductSpace ℝ H]
    {velocity gradient : H}
    {energyDerivative : ℝ}
    (hchain : energyDerivative = ⟪gradient, velocity⟫_ℝ)
    (hflow : velocity + gradient = 0) :
    energyDerivative = -‖velocity‖ ^ 2 :=
  hchain.trans (flow_pairing_eq_neg_velocity_norm_sq hflow)

/-- Under the same supplied chain rule and flow equation, the energy derivative is nonpositive. -/
theorem hilbert_energy_derivative_nonpos
    {H : Type*}
    [NormedAddCommGroup H]
    [InnerProductSpace ℝ H]
    {velocity gradient : H}
    {energyDerivative : ℝ}
    (hchain : energyDerivative = ⟪gradient, velocity⟫_ℝ)
    (hflow : velocity + gradient = 0) :
    energyDerivative ≤ 0 := by
  calc
    energyDerivative = -‖velocity‖ ^ 2 :=
      hilbert_energy_derivative_eq_neg_speed_sq hchain hflow
    _ ≤ 0 := neg_nonpos.mpr (sq_nonneg ‖velocity‖)

end SpectralFlowCore

/-! ## Finite and elementary geometric/variational audit lemmas

These results do not formalize `Γ(2) \ ℍ`, Sobolev gluing, a gauge theory, or a spectral operator.
-/

namespace FullCertification

namespace NoGo

/-! ### The q-coordinate has neither a unit interface nor an outside chart on `ℍ` -/

/-- The usual cusp coordinate `q = exp (2 * π * I * τ)` on the upper half-plane. -/
def qCoordinate (τ : ℍ) : ℂ :=
  Complex.exp (2 * Real.pi * Complex.I * (τ : ℂ))

/-- On the upper half-plane, the norm of the q-coordinate is strictly less than one. -/
theorem qCoordinate_norm_lt_one (τ : ℍ) : ‖qCoordinate τ‖ < 1 := by
  simpa only [qCoordinate] using UpperHalfPlane.norm_exp_two_pi_I_lt_one τ

/-- No point of the upper half-plane is mapped to the unit circle by the q-coordinate. -/
theorem qCoordinate_ne_unit (τ : ℍ) : ‖qCoordinate τ‖ ≠ 1 :=
  ne_of_lt (qCoordinate_norm_lt_one τ)

/-- The proposed `|q| = 1` interface has empty preimage on the upper half-plane.
This neither constructs the quotient nor asserts that `qCoordinate` descends to it. -/
theorem qUnitInterface_empty :
    {τ : ℍ | ‖qCoordinate τ‖ = 1} = ∅ := by
  ext τ
  simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
  exact qCoordinate_ne_unit τ

/-- The proposed `|q| > 1` outside chart has empty preimage on the upper half-plane.
This neither constructs the quotient nor asserts that `qCoordinate` descends to it. -/
theorem qOutsideChart_empty :
    {τ : ℍ | 1 < ‖qCoordinate τ‖} = ∅ := by
  ext τ
  simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
  exact not_lt_of_ge (qCoordinate_norm_lt_one τ).le

/-- Even the closed region `|q| ≥ 1` has empty preimage on the upper half-plane. -/
theorem qOutsideOrInterface_empty :
    {τ : ℍ | 1 ≤ ‖qCoordinate τ‖} = ∅ := by
  ext τ
  simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
  exact not_le_of_gt (qCoordinate_norm_lt_one τ)

/-! ### Abstract obstruction: coordinatewise minima need not be global minima

The following finite model concerns block-coordinate replacement only.  It does not encode the
paper's open cover, overlap transition data, local energy decomposition, or Coulomb constraint.
Consequently it refutes only the generic coordinatewise-to-global implication, not the exact
hypothesis package of the paper's Theorem 4.3.
-/

/-- A deliberately finite two-coordinate energy. -/
def boolPairEnergy : Bool × Bool → ℕ
  | (false, false) => 1
  | (true, false) => 2
  | (false, true) => 2
  | (true, true) => 0

/-- A point is coordinatewise minimal if replacing either coordinate alone cannot lower energy. -/
def IsCoordinatewiseMinimum (energy : Bool × Bool → ℕ) (p : Bool × Bool) : Prop :=
  (∀ x : Bool, energy p ≤ energy (x, p.2)) ∧
    ∀ y : Bool, energy p ≤ energy (p.1, y)

/-- The usual global-minimum predicate. -/
def IsGlobalMinimum (energy : Bool × Bool → ℕ) (p : Bool × Bool) : Prop :=
  ∀ q : Bool × Bool, energy p ≤ energy q

/-- `(false, false)` is a minimum along each Boolean coordinate separately. -/
theorem boolPair_falseFalse_coordinatewiseMinimum :
    IsCoordinatewiseMinimum boolPairEnergy (false, false) := by
  constructor
  · intro x
    cases x <;> decide
  · intro y
    cases y <;> decide

/-- `(false, false)` is not a global minimum: `(true, true)` has lower energy. -/
theorem boolPair_falseFalse_not_globalMinimum :
    ¬ IsGlobalMinimum boolPairEnergy (false, false) := by
  intro h
  have hbad : boolPairEnergy (false, false) ≤ boolPairEnergy (true, true) :=
    h (true, true)
  norm_num [boolPairEnergy] at hbad

/-- A finite counterexample to “coordinatewise minimum implies global minimum”.

By itself this is not a counterexample to a cover-gluing theorem whose hypotheses link local and
global energies.
-/
theorem coordinatewiseMinimum_doesNotImply_globalMinimum :
    ∃ (energy : Bool × Bool → ℕ) (p : Bool × Bool),
      IsCoordinatewiseMinimum energy p ∧ ¬ IsGlobalMinimum energy p :=
  ⟨boolPairEnergy, (false, false), boolPair_falseFalse_coordinatewiseMinimum,
    boolPair_falseFalse_not_globalMinimum⟩

/-! ### Exceptional spectrum cannot have a real `t` parameter -/

/-- Any real representation `lambda = 1/4 + t²` forces `lambda ≥ 1/4`. -/
theorem quarter_le_of_eq_quarter_add_sq {lambda t : ℝ}
    (h : lambda = (1 : ℝ) / 4 + t ^ 2) : (1 : ℝ) / 4 ≤ lambda := by
  nlinarith [sq_nonneg t]

/-- If `lambda < 1/4`, there is no real `t` satisfying `lambda = 1/4 + t²`.

This does not construct a below-quarter eigenvalue and does not exclude a complex parameter.
-/
theorem no_realSpectralParameter_of_lt_quarter {lambda : ℝ}
    (hlambda : lambda < (1 : ℝ) / 4) :
    ¬ ∃ t : ℝ, lambda = (1 : ℝ) / 4 + t ^ 2 := by
  rintro ⟨t, ht⟩
  exact (not_le_of_gt hlambda) (quarter_le_of_eq_quarter_add_sq ht)

end NoGo

namespace Corrected

/-! ### What strict local equality does prove -/

/-- Two functions which agree strictly on every member of a point-cover are equal globally.

This is only a uniqueness lemma.  It asserts neither existence of a glued function nor preservation
of Sobolev, gauge, cusp, variational, or minimizing properties.
-/
theorem strictLocalEquality_unique
    {ι X Y : Type*} (U : ι → Set X)
    (hcover : ∀ x : X, ∃ i : ι, x ∈ U i)
    {f g : X → Y} (hlocal : ∀ i : ι, Set.EqOn f g (U i)) :
    f = g := by
  funext x
  obtain ⟨i, hxi⟩ := hcover x
  exact hlocal i hxi

end Corrected

end FullCertification

