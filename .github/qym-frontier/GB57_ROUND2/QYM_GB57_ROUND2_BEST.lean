namespace QYM.FullCertification.P2ExactBoundaryInhabitantsExtension










open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# Unconditional inhabitants and sharp remaining boundary obligations

This module continues the corrected exact-three-boundary reduction.  It
uses only the concrete definitions already present in `QYM` and proves
several facts which were previously left hidden inside stronger geometric
inputs.

* A point of the literal stage on one selected height curve is automatically
  on the literal frontier.  The reason is that every selected tile-height is
  an **open** map, so a level-set point cannot be interior to its closed
  sublevel.
* Every selected right coset supplies such a point explicitly.  The
  representative of each of the three mod-two cusp labels is then obtained
  from the right-coset decomposition, so all three genuine upstairs cusp
  parts are nonempty for every normalized cutoff.
* At normalized level greater than one, equality in the effective quotient
  forces an upper-triangular relative bridge.  Its mod-two first column then
  proves pairwise separation of the three named cusp images.
* At normalized level at least two, the modular height envelope keeps the
  entire saturated stage inside every selected height sublevel.  Hence cusp
  horocycles cannot become interior after saturation.
* At normalized level at least two, modular reduction puts the strict
  envelope neighbourhood of every corner-deleted paired-side point inside
  the saturation, closing the corrected local side-filling input.

The module also proves the exact closed-saturation/frontier identities.  It
does not infer ambient filling merely from relative polygon interior, nor
does it assert connectedness of a union of separately parametrized arcs.
The last section records those genuine logical boundaries without storing
their conclusions in a structure or an axiom.
-/

/-! ## The closed orbit saturation and its actual frontier -/

/-- Full upstairs inverse image of the intrinsic compact stage. -/
noncomputable def saturatedXStage (Y : ℝ) : Set ℍ :=
  gammaTwoQuotientMk ⁻¹' QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y

theorem saturatedXStage_eq_iUnion_translates (Y : ℝ) :
    saturatedXStage Y =
      ⋃ g : GammaTwoEffective,
        (g • ·) '' gammaTwoThreeCuspTruncation Y := by
  exact QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.preimage_XSet_eq_saturation Y

/-- The saturated stage is closed.  This avoids a separate locally-finite
union proof: it is the continuous inverse image of the compact, hence closed,
intrinsic quotient stage. -/
theorem saturatedXStage_isClosed (Y : ℝ) :
    IsClosed (saturatedXStage Y) :=
  (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).preimage
    gammaTwoQuotientMk_isOpenQuotientMap.continuous

/-- An open quotient map pulls the frontier of this closed intrinsic stage
back to the frontier of its full saturation. -/
theorem preimage_frontier_XSet_eq_frontier_saturatedXStage (Y : ℝ) :
    gammaTwoQuotientMk ⁻¹' frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
      frontier (saturatedXStage Y) := by
  ext z
  constructor
  · intro hz
    have hzX : gammaTwoQuotientMk z ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y :=
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).frontier_subset hz
    have hzSat : z ∈ saturatedXStage Y := hzX
    apply (mem_frontier_iff_notMem_interior hzSat).2
    intro hzInterior
    have hzQuotInterior :
        gammaTwoQuotientMk z ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y z).2 hzInterior
    exact ((mem_frontier_iff_notMem_interior hzX).1 hz)
      hzQuotInterior
  · intro hz
    have hzSat : z ∈ saturatedXStage Y :=
      (saturatedXStage_isClosed Y).frontier_subset hz
    have hzX : gammaTwoQuotientMk z ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y := hzSat
    apply (mem_frontier_iff_notMem_interior hzX).2
    intro hzQuotInterior
    have hzInterior : z ∈ interior (saturatedXStage Y) :=
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y z).1
        hzQuotInterior
    exact ((mem_frontier_iff_notMem_interior hzSat).1 hz)
      hzInterior

theorem frontier_saturatedXStage_eq_frontier_iUnion_translates (Y : ℝ) :
    frontier (saturatedXStage Y) =
      frontier
        (⋃ g : GammaTwoEffective,
          (g • ·) '' gammaTwoThreeCuspTruncation Y) := by
  rw [saturatedXStage_eq_iUnion_translates]

/-! ## Active height equations are genuine literal-frontier equations -/

/-- Every selected tile-height is open.  This is stronger than continuity
and is the key fact excluding equality points from a closed sublevel's
interior. -/
theorem gammaTwoTileHeight_isOpenMap
    (q : GammaTwoRightCoset) :
    IsOpenMap (gammaTwoTileHeight q) := by
  unfold gammaTwoTileHeight
  exact UpperHalfPlane.isOpenMap_im.comp
    (Homeomorph.smul
      (((gammaTwoCosetRep q)⁻¹ : SL(2, ℤ)) : GL (Fin 2) ℝ) :
        ℍ ≃ₜ ℍ).isOpenMap

/-- General topological sublevel lemma.  An equality point of an open
real-valued map cannot be interior to a set on which the map is bounded above
by that equality value. -/
theorem not_mem_interior_of_isOpenMap_eq_upperBound
    {α : Type*} [TopologicalSpace α]
    (f : α → ℝ) (hf : IsOpenMap f)
    {S : Set α} {x : α} {L : ℝ}
    (hfx : f x = L)
    (hUpper : ∀ y ∈ S, f y ≤ L) :
    x ∉ interior S := by
  intro hx
  let U : Set ℝ := f '' interior S
  have hUOpen : IsOpen U := hf (interior S) isOpen_interior
  have hLU : L ∈ U := ⟨x, hx, hfx⟩
  have hClosure : L ∈ closure (Set.Ioi L) := by simp
  rcases (mem_closure_iff.mp hClosure U hUOpen hLU) with
    ⟨r, hrU, hLr⟩
  rcases hrU with ⟨y, hyInterior, hfy⟩
  have hry : r ≤ L := by
    calc
      r = f y := hfy.symm
      _ ≤ L := hUpper y (interior_subset hyInterior)
  exact (not_lt_of_ge hry) hLr

/-- If one selected height is active, a point of the literal stage is not an
ambient interior point of that literal stage. -/
theorem tileHeight_eq_level_not_mem_interior_truncation
    {Y : ℝ} {q : GammaTwoRightCoset} {z : ℍ}
    (hEq : gammaTwoTileHeight q z = gammaTwoCuspLevel Y) :
    z ∉ interior (gammaTwoThreeCuspTruncation Y) := by
  apply not_mem_interior_of_isOpenMap_eq_upperBound
    (gammaTwoTileHeight q)
    (gammaTwoTileHeight_isOpenMap q) hEq
  intro w hw
  exact hw.2 (gammaTwoTileCuspClass q) q rfl

/-- Hence membership in the stage plus one active selected height gives
literal-frontier membership, with no transversality hypothesis. -/
theorem mem_frontier_truncation_of_mem_of_tileHeight_eq
    {Y : ℝ} {q : GammaTwoRightCoset} {z : ℍ}
    (hz : z ∈ gammaTwoThreeCuspTruncation Y)
    (hEq : gammaTwoTileHeight q z = gammaTwoCuspLevel Y) :
    z ∈ frontier (gammaTwoThreeCuspTruncation Y) :=
  (mem_frontier_iff_notMem_interior hz).2
    (tileHeight_eq_level_not_mem_interior_truncation hEq)

theorem gammaTwoSelectedHorocycleCurve_isClosed
    (q : GammaTwoRightCoset) (Y : ℝ) :
    IsClosed (gammaTwoSelectedHorocycleCurve q Y) := by
  rw [show gammaTwoSelectedHorocycleCurve q Y =
      {z : ℍ |
        gammaTwoTileHeight q z = gammaTwoCuspLevel Y} by
    ext z
    exact mem_gammaTwoSelectedHorocycleCurve_iff]
  exact isClosed_eq (gammaTwoTileHeight_continuous q) continuous_const

/-- The `frontier` conjunct in a genuine cusp part is redundant once the
point is known to lie in the literal stage. -/
theorem literalCuspFrontierPart_eq_truncation_inter_horocycle
    (Y : ℝ) (kappa : GammaTwoCusp) :
    QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa =
      gammaTwoThreeCuspTruncation Y ∩
        gammaTwoCuspClassHorocycleBoundary kappa Y := by
  apply Set.Subset.antisymm
  · rintro z ⟨hzFrontier, hzCurve⟩
    exact ⟨QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hzFrontier, hzCurve⟩
  · rintro z ⟨hzStage, hzCurve⟩
    have hzCurve' := hzCurve
    unfold gammaTwoCuspClassHorocycleBoundary at hzCurve'
    rcases Set.mem_iUnion.mp hzCurve' with ⟨q, hzq⟩
    have hEq :
        gammaTwoTileHeight q.1 z = gammaTwoCuspLevel Y := by
      change z ∈ gammaTwoSelectedHorocycleCurve q.1 Y at hzq
      exact mem_gammaTwoSelectedHorocycleCurve_iff.mp hzq
    exact ⟨mem_frontier_truncation_of_mem_of_tileHeight_eq
      hzStage hEq, hzCurve⟩

/-- One active selected-tile piece, before grouping by its mod-two cusp
class. -/
noncomputable def activeTileCuspPart
    (Y : ℝ) (q : GammaTwoRightCoset) : Set ℍ :=
  gammaTwoThreeCuspTruncation Y ∩
    gammaTwoSelectedHorocycleCurve q Y

theorem activeTileCuspPart_isCompact
    (Y : ℝ) (q : GammaTwoRightCoset) :
    IsCompact (activeTileCuspPart Y q) :=
  (gammaTwoThreeCuspTruncation_isCompact Y).inter_right
    (gammaTwoSelectedHorocycleCurve_isClosed q Y)

/-- Exact finite active-piece decomposition of each upstairs cusp part. -/
theorem literalCuspFrontierPart_eq_iUnion_activeTileCuspPart
    (Y : ℝ) (kappa : GammaTwoCusp) :
    QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa =
      ⋃ q : {q : GammaTwoRightCoset //
          gammaTwoTileCuspClass q = kappa},
        activeTileCuspPart Y q.1 := by
  rw [literalCuspFrontierPart_eq_truncation_inter_horocycle]
  unfold gammaTwoCuspClassHorocycleBoundary activeTileCuspPart
  rw [Set.inter_iUnion]
  rfl

/-! ## An explicit active point in every selected tile -/

/-- The central point on the normalized horizontal cutoff line. -/
noncomputable def canonicalHorocycleBase (Y : ℝ) : ℍ :=
  ⟨Complex.mk 0 (gammaTwoCuspLevel Y),
    lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)⟩

@[simp]
theorem canonicalHorocycleBase_re (Y : ℝ) :
    (canonicalHorocycleBase Y).re = 0 := rfl

@[simp]
theorem canonicalHorocycleBase_im (Y : ℝ) :
    (canonicalHorocycleBase Y).im = gammaTwoCuspLevel Y := rfl

theorem canonicalHorocycleBase_mem_fd (Y : ℝ) :
    canonicalHorocycleBase Y ∈ ModularGroup.fd := by
  change
    1 ≤ Complex.normSq (canonicalHorocycleBase Y : ℂ) ∧
      |(canonicalHorocycleBase Y).re| ≤ (1 : ℝ) / 2
  constructor
  · rw [Complex.normSq_apply]
    change 1 ≤ 0 * 0 +
      gammaTwoCuspLevel Y * gammaTwoCuspLevel Y
    nlinarith [one_le_gammaTwoCuspLevel Y]
  · simp

theorem modularHeightEnvelope_canonicalHorocycleBase (Y : ℝ) :
    gammaTwoModularHeightEnvelope (canonicalHorocycleBase Y) =
      gammaTwoCuspLevel Y := by
  unfold gammaTwoModularHeightEnvelope
  rw [canonicalHorocycleBase_im, max_eq_left]
  have hInv :
      (gammaTwoCuspLevel Y)⁻¹ ≤ 1 :=
    inv_le_one_of_one_le₀ (one_le_gammaTwoCuspLevel Y)
  exact (by
    simpa only [one_div] using
      hInv.trans (one_le_gammaTwoCuspLevel Y))

/-- Canonical cutoff point in one selected tile. -/
noncomputable def canonicalTileCuspPoint
    (q : GammaTwoRightCoset) (Y : ℝ) : ℍ :=
  gammaTwoCosetRep q • canonicalHorocycleBase Y

theorem tileHeight_canonicalTileCuspPoint_le
    (q r : GammaTwoRightCoset) (Y : ℝ) :
    gammaTwoTileHeight r (canonicalTileCuspPoint q Y) ≤
      gammaTwoCuspLevel Y := by
  calc
    gammaTwoTileHeight r (canonicalTileCuspPoint q Y) =
        (((gammaTwoCosetRep r)⁻¹ * gammaTwoCosetRep q) •
          canonicalHorocycleBase Y).im := by
      simp only [gammaTwoTileHeight, canonicalTileCuspPoint, mul_smul]
    _ ≤ gammaTwoModularHeightEnvelope (canonicalHorocycleBase Y) :=
      modular_im_smul_le_heightEnvelope
        ((gammaTwoCosetRep r)⁻¹ * gammaTwoCosetRep q)
        (canonicalHorocycleBase Y)
    _ = gammaTwoCuspLevel Y :=
      modularHeightEnvelope_canonicalHorocycleBase Y

@[simp]
theorem tileHeight_canonicalTileCuspPoint_self
    (q : GammaTwoRightCoset) (Y : ℝ) :
    gammaTwoTileHeight q (canonicalTileCuspPoint q Y) =
      gammaTwoCuspLevel Y := by
  unfold gammaTwoTileHeight canonicalTileCuspPoint
  rw [inv_smul_smul, canonicalHorocycleBase_im]

theorem canonicalTileCuspPoint_mem_truncation
    (q : GammaTwoRightCoset) (Y : ℝ) :
    canonicalTileCuspPoint q Y ∈
      gammaTwoThreeCuspTruncation Y := by
  constructor
  · unfold gammaTwoClosedTileCarrier
    exact Set.mem_iUnion.2 ⟨q,
      Set.mem_smul_set.mpr
        ⟨canonicalHorocycleBase Y,
          canonicalHorocycleBase_mem_fd Y, rfl⟩⟩
  · intro _kappa r _hr
    exact tileHeight_canonicalTileCuspPoint_le q r Y

theorem canonicalTileCuspPoint_mem_activeTileCuspPart
    (q : GammaTwoRightCoset) (Y : ℝ) :
    canonicalTileCuspPoint q Y ∈ activeTileCuspPart Y q := by
  refine ⟨canonicalTileCuspPoint_mem_truncation q Y, ?_⟩
  exact mem_gammaTwoSelectedHorocycleCurve_iff.mpr
    (tileHeight_canonicalTileCuspPoint_self q Y)

theorem activeTileCuspPart_nonempty
    (q : GammaTwoRightCoset) (Y : ℝ) :
    (activeTileCuspPart Y q).Nonempty :=
  ⟨canonicalTileCuspPoint q Y,
    canonicalTileCuspPoint_mem_activeTileCuspPart q Y⟩

/-! ## The finite mod-two cusp-label arithmetic -/

/-- A chosen representative has the same first column modulo two as the
matrix used to name its right coset.  This removes the apparent dependence of
`gammaTwoTileCuspClass` on `Quotient.out`. -/
theorem gammaTwoCosetRep_firstColumn_mod_two
    (g : SL(2, ℤ)) (i : Fin 2) :
    (((gammaTwoCosetRep
        (Quotient.mk'' g : GammaTwoRightCoset)) i 0 : ℤ) : ZMod 2) =
      ((g i 0 : ℤ) : ZMod 2) := by
  let q : GammaTwoRightCoset := Quotient.mk'' g
  obtain ⟨gamma, hgamma⟩ := gammaTwo_decompose_right g
  let red : SL(2, ℤ) →* SL(2, ZMod 2) :=
    Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod 2))
  have hgammaRed : red (gamma : SL(2, ℤ)) = 1 := by
    simpa only [red] using
      (CongruenceSubgroup.Gamma_mem'.mp gamma.property)
  have hred : red g = red (gammaTwoCosetRep q) := by
    calc
      red g = red ((gamma : SL(2, ℤ)) * gammaTwoCosetRep q) :=
        congrArg red hgamma
      _ = red (gamma : SL(2, ℤ)) * red (gammaTwoCosetRep q) :=
        map_mul red _ _
      _ = red (gammaTwoCosetRep q) := by rw [hgammaRed, one_mul]
  have hi := congrArg (fun A : SL(2, ZMod 2) => A i 0) hred
  change
    ((g i 0 : ℤ) : ZMod 2) =
      ((gammaTwoCosetRep q i 0 : ℤ) : ZMod 2) at hi
  exact hi.symm

@[simp]
theorem tileCuspClass_mk_one :
    gammaTwoTileCuspClass
        (Quotient.mk'' (1 : SL(2, ℤ)) : GammaTwoRightCoset) =
      .atInfinity := by
  unfold gammaTwoTileCuspClass
  rw [gammaTwoCosetRep_firstColumn_mod_two (1 : SL(2, ℤ)) 1]
  simp

@[simp]
theorem tileCuspClass_mk_S :
    gammaTwoTileCuspClass
        (Quotient.mk'' ModularGroup.S : GammaTwoRightCoset) =
      .zero := by
  unfold gammaTwoTileCuspClass
  rw [gammaTwoCosetRep_firstColumn_mod_two ModularGroup.S 1,
    gammaTwoCosetRep_firstColumn_mod_two ModularGroup.S 0]
  norm_num [ModularGroup.coe_S]

@[simp]
theorem tileCuspClass_mk_TS :
    gammaTwoTileCuspClass
        (Quotient.mk'' (ModularGroup.T * ModularGroup.S) :
          GammaTwoRightCoset) =
      .one := by
  unfold gammaTwoTileCuspClass
  rw [gammaTwoCosetRep_firstColumn_mod_two
      (ModularGroup.T * ModularGroup.S) 1,
    gammaTwoCosetRep_firstColumn_mod_two
      (ModularGroup.T * ModularGroup.S) 0]
  norm_num [ModularGroup.coe_T, ModularGroup.coe_S,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_fin_two]

/-- All three named cusp labels occur among the selected right cosets. -/
theorem gammaTwoTileCuspClass_surjective :
    Surjective gammaTwoTileCuspClass := by
  intro kappa
  cases kappa with
  | atInfinity =>
      exact ⟨Quotient.mk'' (1 : SL(2, ℤ)), tileCuspClass_mk_one⟩
  | zero =>
      exact ⟨Quotient.mk'' ModularGroup.S, tileCuspClass_mk_S⟩
  | one =>
      exact ⟨Quotient.mk'' (ModularGroup.T * ModularGroup.S),
        tileCuspClass_mk_TS⟩

theorem canonicalTileCuspPoint_mem_literalCuspFrontierPart
    (q : GammaTwoRightCoset) (Y : ℝ) :
    canonicalTileCuspPoint q Y ∈
      QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y (gammaTwoTileCuspClass q) := by
  rw [literalCuspFrontierPart_eq_iUnion_activeTileCuspPart]
  let q' : {r : GammaTwoRightCoset //
      gammaTwoTileCuspClass r = gammaTwoTileCuspClass q} := ⟨q, rfl⟩
  exact Set.mem_iUnion.2
    ⟨q', canonicalTileCuspPoint_mem_activeTileCuspPart q Y⟩

/-- Previously missing unconditional inhabitant: every one of the three
genuine upstairs cusp-frontier parts is nonempty. -/
theorem upstairsCuspFrontierPartsNonempty (Y : ℝ) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.UpstairsCuspFrontierPartsNonemptyAt Y := by
  intro kappa
  rcases gammaTwoTileCuspClass_surjective kappa with ⟨q, hq⟩
  rw [← hq]
  exact ⟨canonicalTileCuspPoint q Y,
    canonicalTileCuspPoint_mem_literalCuspFrontierPart q Y⟩

/-- Consequently all three quotient cusp candidates are nonempty as well. -/
theorem quotientCuspBoundaryPiecesNonempty (Y : ℝ) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesNonemptyAt Y :=
  (QYM.FullCertification.P2ExactThreeBoundaryExtension.quotientCuspPieces_nonempty_iff_upstairs Y).2
    (upstairsCuspFrontierPartsNonempty Y)

/-! ## The analytic core of high-cusp orbit separation -/

/-- A modular transformation preserving a height strictly greater than one
has zero lower-left entry.  This is the elementary Ford-horoball separation
estimate needed before the remaining finite mod-two bridge calculation. -/
theorem modular_lowerLeft_eq_zero_of_im_eq_of_one_lt
    (g : SL(2, ℤ)) (z : ℍ)
    (hz : 1 < z.im)
    (hEq : (g • z).im = z.im) :
    g 1 0 = 0 := by
  by_contra hc
  have hcSq : (1 : ℝ) ≤ g 1 0 ^ 2 :=
    mod_cast (one_le_sq_iff_one_le_abs _).mpr
      (Int.one_le_abs hc)
  have hdenPos :
      0 < Complex.normSq (UpperHalfPlane.denom g z) :=
    UpperHalfPlane.normSq_denom_pos
      (g : GL (Fin 2) ℝ) z.im_ne_zero
  rw [ModularGroup.im_smul_eq_div_normSq] at hEq
  have hmul := (div_eq_iff hdenPos.ne').mp hEq
  have hden :
      Complex.normSq (UpperHalfPlane.denom g z) = 1 := by
    nlinarith [z.im_pos]
  rw [modular_normSq_denom_eq_lowerRowQuadratic] at hden
  have hzSq : 1 < z.im ^ 2 := by
    nlinarith [z.im_pos]
  have hmulSq :
      z.im ^ 2 ≤
        (((g 1 0 : ℤ) : ℝ) ^ 2 * z.im ^ 2) := by
    simpa only [one_mul] using
      (mul_le_mul_of_nonneg_right hcSq (sq_nonneg z.im))
  have hlarge :
      1 <
        (((((g 1 0 : ℤ) : ℝ) * z.re +
            ((g 1 1 : ℤ) : ℝ)) ^ 2) +
          (((g 1 0 : ℤ) : ℝ) ^ 2 * z.im ^ 2)) :=
    hzSq.trans_le <|
      hmulSq.trans <| le_add_of_nonneg_left (sq_nonneg _)
  nlinarith

/-- The finite arithmetic complement to the preceding analytic lemma.  An
upper-triangular relative bridge induced by an element of `Gamma(2)`
preserves the mod-two first-column label, hence preserves
`gammaTwoTileCuspClass`. -/
theorem upperTriangularGammaBridge_preserves_tileCuspClass
    (q r : GammaTwoRightCoset) (gamma : GammaTwo)
    (hLower :
      (((gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
          gammaTwoCosetRep r) 1 0 = 0)) :
    gammaTwoTileCuspClass q = gammaTwoTileCuspClass r := by
  let bridge : SL(2, ℤ) :=
    (gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
      gammaTwoCosetRep r
  have hLower' : bridge 1 0 = 0 := hLower
  have hdet : bridge 0 0 * bridge 1 1 = 1 := by
    have h := bridge.det_coe
    rw [Matrix.det_fin_two, hLower', mul_zero, sub_zero] at h
    exact h
  have hdiag := Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet
  have h00 : ((bridge 0 0 : ℤ) : ZMod 2) = 1 := by
    rcases hdiag with hdiag | hdiag
    · rw [hdiag.1]
      simp
    · rw [hdiag.1]
      decide
  have h10 : ((bridge 1 0 : ℤ) : ZMod 2) = 0 := by
    rw [hLower']
    simp
  have hMatrix :
      gammaTwoCosetRep q * bridge =
        (gamma : SL(2, ℤ)) * gammaTwoCosetRep r := by
    simp only [bridge, mul_assoc]
    rw [mul_inv_cancel_left]
  let red : SL(2, ℤ) →* SL(2, ZMod 2) :=
    Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod 2))
  have hgammaRed : red (gamma : SL(2, ℤ)) = 1 := by
    simpa only [red] using
      (CongruenceSubgroup.Gamma_mem'.mp gamma.property)
  have hred :
      red (gammaTwoCosetRep q) * red bridge =
        red (gammaTwoCosetRep r) := by
    have h := congrArg red hMatrix
    simpa only [map_mul, hgammaRed, one_mul] using h
  have hFirstColumn : ∀ i : Fin 2,
      (((gammaTwoCosetRep q) i 0 : ℤ) : ZMod 2) =
        (((gammaTwoCosetRep r) i 0 : ℤ) : ZMod 2) := by
    intro i
    have hi := congrArg (fun A : SL(2, ZMod 2) => A i 0) hred
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply,
      Fin.sum_univ_two] at hi
    change
      (((gammaTwoCosetRep q) i 0 : ℤ) : ZMod 2) *
          ((bridge 0 0 : ℤ) : ZMod 2) +
        (((gammaTwoCosetRep q) i 1 : ℤ) : ZMod 2) *
          ((bridge 1 0 : ℤ) : ZMod 2) =
        (((gammaTwoCosetRep r) i 0 : ℤ) : ZMod 2) at hi
    simpa only [h00, h10, mul_one, mul_zero, add_zero] using hi
  unfold gammaTwoTileCuspClass
  rw [hFirstColumn 1, hFirstColumn 0]

/-- Equality of quotient points on two selected cusp curves produces an
explicit `Gamma(2)` bridge whose relative modular matrix is upper triangular
whenever the normalized cutoff level is greater than one. -/
theorem equalQuotientCuspPoints_have_upperTriangularBridge
    {Y : ℝ} (hY : 1 < gammaTwoCuspLevel Y)
    {kappa lambda : GammaTwoCusp} {z w : ℍ}
    (hz : z ∈ QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa)
    (hw : w ∈ QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y lambda)
    (hEq : gammaTwoQuotientMk z = gammaTwoQuotientMk w) :
    ∃ (q r : GammaTwoRightCoset) (gamma : GammaTwo),
      gammaTwoTileCuspClass q = kappa ∧
      gammaTwoTileCuspClass r = lambda ∧
      (((gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
          gammaTwoCosetRep r) 1 0 = 0) := by
  have hz' := hz
  rw [literalCuspFrontierPart_eq_truncation_inter_horocycle
    Y kappa] at hz'
  have hw' := hw
  rw [literalCuspFrontierPart_eq_truncation_inter_horocycle
    Y lambda] at hw'
  have hzCurve := hz'.2
  have hwCurve := hw'.2
  unfold gammaTwoCuspClassHorocycleBoundary at hzCurve hwCurve
  rcases Set.mem_iUnion.mp hzCurve with ⟨q, hzq⟩
  rcases Set.mem_iUnion.mp hwCurve with ⟨r, hwr⟩
  have hzHeight :
      gammaTwoTileHeight q.1 z = gammaTwoCuspLevel Y := by
    change z ∈ gammaTwoSelectedHorocycleCurve q.1 Y at hzq
    exact mem_gammaTwoSelectedHorocycleCurve_iff.mp hzq
  have hwHeight :
      gammaTwoTileHeight r.1 w = gammaTwoCuspLevel Y := by
    change w ∈ gammaTwoSelectedHorocycleCurve r.1 Y at hwr
    exact mem_gammaTwoSelectedHorocycleCurve_iff.mp hwr
  have hOrbit : z ∈ MulAction.orbit GammaTwoEffective w :=
    MulAction.orbitRel_apply.mp (Quotient.exact' hEq)
  rcases MulAction.mem_orbit_iff.mp hOrbit with ⟨a, haw⟩
  rcases effective_exists_gamma a with ⟨gamma, hgamma⟩
  have hgammaMove : (gamma : SL(2, ℤ)) • w = z :=
    (hgamma w).symm.trans haw
  let v : ℍ := (gammaTwoCosetRep r.1)⁻¹ • w
  let bridge : SL(2, ℤ) :=
    (gammaTwoCosetRep q.1)⁻¹ * (gamma : SL(2, ℤ)) *
      gammaTwoCosetRep r.1
  have hvHeight : v.im = gammaTwoCuspLevel Y := by
    simpa only [v, gammaTwoTileHeight] using hwHeight
  have hbridgeMove :
      bridge • v = (gammaTwoCosetRep q.1)⁻¹ • z := by
    simp only [bridge, v, mul_smul]
    rw [smul_inv_smul, hgammaMove]
  have hbridgeHeight : (bridge • v).im = v.im := by
    rw [hbridgeMove, hvHeight]
    simpa only [gammaTwoTileHeight] using hzHeight
  refine ⟨q.1, r.1, gamma, q.2, r.2, ?_⟩
  exact modular_lowerLeft_eq_zero_of_im_eq_of_one_lt bridge v
    (hvHeight.symm ▸ hY) hbridgeHeight

/-- At every cutoff whose normalized level is strictly greater than one,
distinct named cusp parts have no common effective orbit. -/
theorem noCrossCuspOrbit_of_one_lt_level
    {Y : ℝ} (hY : 1 < gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.NoCrossCuspOrbitAt Y := by
  intro kappa lambda hne z hz w hw hEq
  rcases equalQuotientCuspPoints_have_upperTriangularBridge
      hY hz hw hEq with
    ⟨q, r, gamma, hq, hr, hLower⟩
  have hClass :
      gammaTwoTileCuspClass q = gammaTwoTileCuspClass r :=
    upperTriangularGammaBridge_preserves_tileCuspClass
      q r gamma hLower
  exact hne (hq.symm.trans (hClass.trans hr))

theorem quotientCuspBoundaryPiecesPairwiseDisjoint_of_one_lt_level
    {Y : ℝ} (hY : 1 < gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesPairwiseDisjointAt Y :=
  (QYM.FullCertification.P2ExactThreeBoundaryExtension.quotientCuspPieces_pairwiseDisjoint_iff_noCrossOrbit Y).2
    (noCrossCuspOrbit_of_one_lt_level hY)

/-- Convenient raw-cutoff form of high-cusp orbit separation.  Since the
implemented level is `max 1 Y`, the hypothesis `1 < Y` identifies the
normalized level with the supplied cutoff. -/
theorem noCrossCuspOrbit_of_one_lt_cutoff
    {Y : ℝ} (hY : 1 < Y) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.NoCrossCuspOrbitAt Y := by
  apply noCrossCuspOrbit_of_one_lt_level
  rw [gammaTwoCuspLevel_of_one_le hY.le]
  exact hY

theorem quotientCuspBoundaryPiecesPairwiseDisjoint_of_one_lt_cutoff
    {Y : ℝ} (hY : 1 < Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesPairwiseDisjointAt Y :=
  (QYM.FullCertification.P2ExactThreeBoundaryExtension.quotientCuspPieces_pairwiseDisjoint_iff_noCrossOrbit Y).2
    (noCrossCuspOrbit_of_one_lt_cutoff hY)

/-! ## High-cusp saturation stays inside every selected sublevel -/

/-- A deliberately rational lower-height estimate for the standard closed
modular fundamental domain.  The sharp bound is `2 / sqrt 3`; the coarser
constant `2` avoids importing square-root arithmetic and is sufficient for
an unconditional high-cusp theorem. -/
theorem one_div_im_lt_two_of_mem_fd
    {z : ℍ} (hz : z ∈ ModularGroup.fd) :
    1 / z.im < 2 := by
  have hz' := hz
  change
    1 ≤ Complex.normSq (z : ℂ) ∧
      |z.re| ≤ (1 : ℝ) / 2 at hz'
  have hre := abs_le.mp hz'.2
  have hnorm :
      1 ≤ z.re * z.re + z.im * z.im := by
    change 1 ≤ (z : ℂ).re * (z : ℂ).re +
      (z : ℂ).im * (z : ℂ).im
    simpa only [Complex.normSq_apply] using hz'.1
  have hreProduct :
      0 ≤ ((1 : ℝ) / 2 - z.re) * ((1 : ℝ) / 2 + z.re) :=
    mul_nonneg (sub_nonneg.mpr hre.2) (by linarith [hre.1])
  have himSq :
      (3 : ℝ) / 4 ≤ z.im * z.im := by
    nlinarith
  have himHalf : (1 : ℝ) / 2 < z.im := by
    by_contra h
    have himLe : z.im ≤ (1 : ℝ) / 2 := le_of_not_gt h
    have hnonnegative :
        0 ≤ ((1 : ℝ) / 2 - z.im) *
          ((1 : ℝ) / 2 + z.im) :=
      mul_nonneg (sub_nonneg.mpr himLe) (by linarith [z.im_pos])
    nlinarith
  rw [div_lt_iff₀ z.im_pos]
  nlinarith

theorem one_div_im_le_two_of_mem_fd
    {z : ℍ} (hz : z ∈ ModularGroup.fd) :
    1 / z.im ≤ 2 :=
  (one_div_im_lt_two_of_mem_fd hz).le

/-- On a standard-domain point below a level at least two, the universal
modular height envelope is below the same level. -/
theorem modularHeightEnvelope_le_level_of_mem_fd
    {Y : ℝ} {z : ℍ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (hzfd : z ∈ ModularGroup.fd)
    (hzLevel : z.im ≤ gammaTwoCuspLevel Y) :
    gammaTwoModularHeightEnvelope z ≤ gammaTwoCuspLevel Y := by
  unfold gammaTwoModularHeightEnvelope
  exact max_le hzLevel
    ((one_div_im_le_two_of_mem_fd hzfd).trans hY)

/-- Arithmetic high-cusp invariance of the simultaneous sublevel.  A point
in the full `Gamma(2)` saturation first comes from the literal truncation,
hence from a standard-domain point below the cutoff.  Every selected local
coordinate differs from that standard coordinate by an integral modular
matrix, so the universal height-envelope estimate applies. -/
theorem tileHeight_le_level_of_mem_saturatedXStage
    {Y : ℝ} {z : ℍ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset)
    (hz : z ∈ saturatedXStage Y) :
    gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y := by
  rw [saturatedXStage_eq_iUnion_translates] at hz
  rcases Set.mem_iUnion.mp hz with ⟨a, ha⟩
  rcases ha with ⟨u, huStage, hau⟩
  have huGeometric : u ∈ gammaTwoGeometricTruncation Y :=
    gammaTwoThreeCuspTruncation_subset_geometricTruncation Y huStage
  rcases mem_gammaTwoGeometricTruncation_iff.mp huGeometric with
    ⟨r, w, hwfd, hwLevel, hrw⟩
  rcases effective_exists_gamma a with ⟨gamma, hgamma⟩
  change ∀ v : ℍ, a • v = (gamma : SL(2, ℤ)) • v at hgamma
  change a • u = z at hau
  calc
    gammaTwoTileHeight q z =
        (((gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
          gammaTwoCosetRep r) • w).im := by
      unfold gammaTwoTileHeight
      rw [← hau, hgamma u, ← hrw]
      simp only [mul_smul]
    _ ≤ gammaTwoModularHeightEnvelope w :=
      modular_im_smul_le_heightEnvelope
        ((gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
          gammaTwoCosetRep r) w
    _ ≤ gammaTwoCuspLevel Y :=
      modularHeightEnvelope_le_level_of_mem_fd hY hwfd hwLevel

/-- Second previously conditional inhabitant: once the normalized cutoff is
at least two, no genuine cusp-height point can be interior to the saturated
stage.  Openness of the active tile-height supplies arbitrarily nearby
points above the level, while the preceding theorem excludes all of them
from the saturation. -/
theorem cuspSaturationRemainsNonInterior_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.CuspSaturationRemainsNonInteriorAt Y := by
  intro kappa z hz
  rw [← saturatedXStage_eq_iUnion_translates]
  have hzCurve := hz.2
  unfold gammaTwoCuspClassHorocycleBoundary at hzCurve
  rcases Set.mem_iUnion.mp hzCurve with ⟨q, hzq⟩
  have hEq :
      gammaTwoTileHeight q.1 z = gammaTwoCuspLevel Y := by
    change z ∈ gammaTwoSelectedHorocycleCurve q.1 Y at hzq
    exact mem_gammaTwoSelectedHorocycleCurve_iff.mp hzq
  apply not_mem_interior_of_isOpenMap_eq_upperBound
    (gammaTwoTileHeight q.1)
    (gammaTwoTileHeight_isOpenMap q.1) hEq
  intro w hw
  exact tileHeight_le_level_of_mem_saturatedXStage hY q.1 hw

theorem horocyclesRemainBoundary_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y :=
  (QYM.FullCertification.P2ExactThreeBoundaryExtension.horocyclesRemainBoundary_iff_cuspSaturationNonInterior Y).2
    (cuspSaturationRemainsNonInterior_of_two_le_level hY)

/-! ## High-cusp side filling from modular reduction -/

/-- If the universal modular-height envelope in one selected tile
coordinate is strictly below the cutoff, the point lies in the saturated
stage.  Reduce that coordinate to the standard closed domain, decompose the
resulting integral matrix as `Gamma(2)` times a selected right-coset
representative, and use the same envelope to verify every height inequality
of the resulting literal representative. -/
theorem mem_saturatedXStage_of_tileEnvelope_lt
    {Y : ℝ} {z : ℍ} (q : GammaTwoRightCoset)
    (hzEnvelope :
      gammaTwoModularHeightEnvelope
          ((gammaTwoCosetRep q)⁻¹ • z) <
        gammaTwoCuspLevel Y) :
    z ∈ saturatedXStage Y := by
  let w : ℍ := (gammaTwoCosetRep q)⁻¹ • z
  rcases ModularGroup.exists_smul_mem_fd w with ⟨g, hgfd⟩
  let A : SL(2, ℤ) := gammaTwoCosetRep q * g⁻¹
  let r : GammaTwoRightCoset := Quotient.mk'' A
  rcases gammaTwo_decompose_right A with ⟨gamma, hA⟩
  have hA' :
      A = (gamma : SL(2, ℤ)) * gammaTwoCosetRep r := by
    simpa only [r] using hA
  let v : ℍ := g • w
  let u : ℍ := gammaTwoCosetRep r • v
  have hwEnvelope :
      gammaTwoModularHeightEnvelope w < gammaTwoCuspLevel Y := by
    simpa only [w] using hzEnvelope
  have huStage : u ∈ gammaTwoThreeCuspTruncation Y := by
    constructor
    · unfold gammaTwoClosedTileCarrier
      refine Set.mem_iUnion.2 ⟨r, Set.mem_smul_set.mpr
        ⟨v, ?_, rfl⟩⟩
      simpa only [v] using hgfd
    · intro kappa s _hs
      apply le_of_lt
      calc
        gammaTwoTileHeight s u =
            (((gammaTwoCosetRep s)⁻¹ * gammaTwoCosetRep r * g) •
              w).im := by
          simp only [gammaTwoTileHeight, u, v, mul_smul]
        _ ≤ gammaTwoModularHeightEnvelope w :=
          modular_im_smul_le_heightEnvelope
            ((gammaTwoCosetRep s)⁻¹ * gammaTwoCosetRep r * g) w
        _ < gammaTwoCuspLevel Y := hwEnvelope
  have hgammaU : (gamma : SL(2, ℤ)) • u = z := by
    calc
      (gamma : SL(2, ℤ)) • u =
          (((gamma : SL(2, ℤ)) * gammaTwoCosetRep r * g) • w) := by
        simp only [u, v, mul_smul]
      _ = ((A * g) • w) := by rw [hA']
      _ = z := by simp [A, w, mul_assoc]
  rw [saturatedXStage_eq_iUnion_translates]
  refine Set.mem_iUnion.2
    ⟨gammaTwoEffectiveElement gamma, ?_⟩
  refine ⟨u, huStage, ?_⟩
  change (gamma : SL(2, ℤ)) • u = z
  exact hgammaU

/-- Third previously conditional inhabitant.  If the normalized cutoff is
at least two, every corner-deleted paired-side point has a
whole open envelope neighbourhood in the saturated stage.  The strictness
comes from the deleted height equalities; the standard-domain reciprocal
height is strictly below two. -/
theorem pairedSidesAwayFromHorocyclesBecomeInterior_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y := by
  apply
    (QYM.FullCertification.P2ExactThreeBoundaryExtension.pairedSidesAwayFromHorocyclesBecomeInterior_iff_localSaturation Y).2
  intro z hz
  rw [← saturatedXStage_eq_iUnion_translates]
  have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
    QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hz.1.1
  rcases mem_gammaTwoClosedTileCarrier_iff.mp hzStage.1 with
    ⟨q, w, hwfd, hqw⟩
  have hqLe :
      gammaTwoTileHeight q z ≤ gammaTwoCuspLevel Y :=
    hzStage.2 (gammaTwoTileCuspClass q) q rfl
  have hqNe :
      gammaTwoTileHeight q z ≠ gammaTwoCuspLevel Y := by
    intro hEq
    apply hz.2
    rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
    exact Set.mem_iUnion.2
      ⟨q, mem_gammaTwoSelectedHorocycleCurve_iff.mpr hEq⟩
  have hqLt :
      gammaTwoTileHeight q z < gammaTwoCuspLevel Y :=
    lt_of_le_of_ne hqLe hqNe
  have hwHeight : w.im = gammaTwoTileHeight q z := by
    unfold gammaTwoTileHeight
    rw [← hqw, inv_smul_smul]
  have hwLt : w.im < gammaTwoCuspLevel Y := by
    calc
      w.im = gammaTwoTileHeight q z := hwHeight
      _ < gammaTwoCuspLevel Y := hqLt
  have hwEnvelope :
      gammaTwoModularHeightEnvelope w < gammaTwoCuspLevel Y := by
    unfold gammaTwoModularHeightEnvelope
    exact max_lt hwLt
      ((one_div_im_lt_two_of_mem_fd hwfd).trans_le hY)
  let U : Set ℍ :=
    {x : ℍ |
      gammaTwoModularHeightEnvelope
          ((gammaTwoCosetRep q)⁻¹ • x) <
        gammaTwoCuspLevel Y}
  have hUOpen : IsOpen U := by
    exact isOpen_lt
      (gammaTwoModularHeightEnvelope_continuous.comp
        (Homeomorph.smul
          (((gammaTwoCosetRep q)⁻¹ : SL(2, ℤ)) : GL (Fin 2) ℝ) :
            ℍ ≃ₜ ℍ).continuous)
      continuous_const
  have hUSubset : U ⊆ saturatedXStage Y := by
    intro x hx
    change
      gammaTwoModularHeightEnvelope
          ((gammaTwoCosetRep q)⁻¹ • x) <
        gammaTwoCuspLevel Y at hx
    exact mem_saturatedXStage_of_tileEnvelope_lt q hx
  have hzU : z ∈ U := by
    change
      gammaTwoModularHeightEnvelope
          ((gammaTwoCosetRep q)⁻¹ • z) <
        gammaTwoCuspLevel Y
    rw [← hqw, inv_smul_smul]
    exact hwEnvelope
  exact interior_maximal hUSubset hUOpen hzU

theorem pairedSidesAwayFromHorocyclesBecomeInterior_of_two_lt_level
    {Y : ℝ} (hY : 2 < gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y :=
  pairedSidesAwayFromHorocyclesBecomeInterior_of_two_le_level hY.le

/-! ## Exact status of the remaining geometric inputs -/

/-- Formal no-go for replacing ambient two-tile filling by relative
interiority.  In a singleton carrier the unique point is relatively interior,
but the same singleton has empty ambient interior in `ℝ`. -/
theorem relativeInterior_does_not_imply_ambientInterior :
    ∃ (P S : Set ℝ) (x : ℝ) (hxP : x ∈ P),
      (⟨x, hxP⟩ : P) ∈ interior (Subtype.val ⁻¹' S) ∧
        x ∉ interior S := by
  let P : Set ℝ := {0}
  let S : Set ℝ := {0}
  have h0P : (0 : ℝ) ∈ P := by simp [P]
  refine ⟨P, S, 0, h0P, ?_, ?_⟩
  · have hPre :
        Subtype.val ⁻¹' S = (Set.univ : Set P) := by
      ext y
      simp only [Set.mem_preimage, Set.mem_univ, iff_true]
      simpa only [P, S, Set.mem_singleton_iff] using y.property
    rw [hPre]
    simp
  · rw [show S = ({0} : Set ℝ) by rfl, interior_singleton]
    simp

/-- Formal no-go for inferring cusp exterior from the fact that the point is
on the frontier of each individual closed translate.  Two closed half-lines
both have `0` on their frontier, while their union is all of `ℝ`, so `0` is
interior to the union. -/
theorem individualTranslateFrontiers_do_not_imply_unionFrontier :
    ∃ (S T : Set ℝ) (x : ℝ),
      x ∈ frontier S ∧
      x ∈ frontier T ∧
      x ∈ interior (S ∪ T) := by
  refine ⟨Set.Iic 0, Set.Ici 0, 0, ?_, ?_, ?_⟩
  · rw [frontier_Iic]
    simp
  · rw [frontier_Ici]
    simp
  · have hUnion :
        Set.Iic (0 : ℝ) ∪ Set.Ici 0 = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      rcases le_total x 0 with hx | hx
      · exact Or.inl hx
      · exact Or.inr hx
    rw [hUnion]
    simp

/-- Horocycle survival is exactly containment of every genuine cusp part in
the frontier of the closed saturation.  The stage/frontier work above proves
membership in the saturation; the remaining content is that overlapping
deck translates do not fill an outward cusp neighbourhood. -/
theorem cuspSaturationRemainsNonInterior_iff_subset_frontier
    (Y : ℝ) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.CuspSaturationRemainsNonInteriorAt Y ↔
      ∀ kappa : GammaTwoCusp,
        QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa ⊆
          frontier (saturatedXStage Y) := by
  constructor
  · intro h kappa z hz
    have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
      QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hz.1
    have hzSat : z ∈ saturatedXStage Y :=
      QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage
    apply (mem_frontier_iff_notMem_interior hzSat).2
    rw [saturatedXStage_eq_iUnion_translates]
    exact h kappa z hz
  · intro h kappa z hz
    rw [← saturatedXStage_eq_iUnion_translates]
    exact (mem_frontier_iff_notMem_interior
      ((saturatedXStage_isClosed Y).frontier_subset (h kappa hz))).1
      (h kappa hz)

/-- The side-filling input is exactly an ambient saturation-interior
statement on the corner-deleted literal side.  The already-proved relative
interior lift has deliberately not been substituted for this stronger
statement. -/
theorem pairedSidesAwayBecomeInterior_iff_subset_saturationInterior
    (Y : ℝ) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y ↔
      QYM.FullCertification.P2ExactThreeBoundaryExtension.literalPairedSideAwayFromHorocycles Y ⊆
        interior (saturatedXStage Y) := by
  constructor
  · intro h z hz
    exact (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y z).1 (h z hz)
  · intro h z hz
    exact (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y z).2 (h hz)

/-- The remaining connectedness input can be checked on the exact finite
union of compact active pieces.  This equality is not a claim that a finite
union of connected pieces is connected; endpoint/overlap incidence is the
missing geometric datum. -/
theorem upstairsCuspFrontierPartsConnected_iff_activeUnion
    (Y : ℝ) :
    QYM.FullCertification.P2ExactThreeBoundaryExtension.UpstairsCuspFrontierPartsConnectedAt Y ↔
      ∀ kappa : GammaTwoCusp,
        IsConnected
          (⋃ q : {q : GammaTwoRightCoset //
              gammaTwoTileCuspClass q = kappa},
            activeTileCuspPart Y q.1) := by
  simp_rw [QYM.FullCertification.P2ExactThreeBoundaryExtension.UpstairsCuspFrontierPartsConnectedAt,
    literalCuspFrontierPart_eq_iUnion_activeTileCuspPart]

/-- Exact quotient-level active-piece decomposition.  Unlike upstairs
connectedness, connectedness of this image union is neither stronger nor
weaker than the required statement: it is definitionally the required
quotient cusp piece after the proved set identities. -/
theorem quotientCuspBoundaryPiece_eq_iUnion_image_activeTileCuspPart
    (Y : ℝ) (kappa : GammaTwoCusp) :
    QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y kappa =
      ⋃ q : {q : GammaTwoRightCoset //
          gammaTwoTileCuspClass q = kappa},
        gammaTwoQuotientMk '' activeTileCuspPart Y q.1 := by
  unfold QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece
  rw [literalCuspFrontierPart_eq_iUnion_activeTileCuspPart,
    Set.image_iUnion]

/-- Weakest exact connectedness obligation, expressed using only the finite
active pieces already isolated above.  Endpoint identifications may connect
the image even when the corresponding upstairs union is disconnected, so
this is the preferred remaining primitive for the final theorem. -/
theorem cuspBoundaryPiecesConnected_iff_activeImageUnion
    (Y : ℝ) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y ↔
      ∀ kappa : GammaTwoCusp,
        IsConnected
          (⋃ q : {q : GammaTwoRightCoset //
              gammaTwoTileCuspClass q = kappa},
            gammaTwoQuotientMk '' activeTileCuspPart Y q.1) := by
  unfold QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt
  simp_rw [quotientCuspBoundaryPiece_eq_iUnion_image_activeTileCuspPart]

/-- A general-cutoff exact-three theorem now needs no nonemptiness input.
The four displayed hypotheses isolate side filling, cusp exterior,
cross-cusp separation, and connectedness; none is hidden in a certificate
structure. -/
theorem exactThreeCuspBoundaryDecomposition_of_remaining_inputs
    {Y : ℝ}
    (hSide : QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hCuspExterior : QYM.FullCertification.P2ExactThreeBoundaryExtension.CuspSaturationRemainsNonInteriorAt Y)
    (hOrbitSeparation : QYM.FullCertification.P2ExactThreeBoundaryExtension.NoCrossCuspOrbitAt Y)
    (hUpstairsConnected : QYM.FullCertification.P2ExactThreeBoundaryExtension.UpstairsCuspFrontierPartsConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hHorocycle : QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y :=
    (QYM.FullCertification.P2ExactThreeBoundaryExtension.horocyclesRemainBoundary_iff_cuspSaturationNonInterior Y).2
      hCuspExterior
  exact
    ⟨quotientCuspBoundaryPiecesNonempty Y,
      (QYM.FullCertification.P2ExactThreeBoundaryExtension.quotientCuspPieces_pairwiseDisjoint_iff_noCrossOrbit Y).2
        hOrbitSeparation,
      QYM.FullCertification.P2ExactThreeBoundaryExtension.quotientCuspPieces_connected_of_upstairs hUpstairsConnected,
      QYM.FullCertification.P2ExactThreeBoundaryExtension.frontier_XSet_eq_iUnion_cuspPieces_corrected
        hSide hHorocycle⟩

/-- Above normalized level one, both nonemptiness and cross-cusp orbit
separation have now been discharged.  Only ambient side filling, cusp
exterior, and the actual arc-connectedness calculation remain. -/
theorem exactThreeCuspBoundaryDecomposition_of_high_remaining_inputs
    {Y : ℝ} (hY : 1 < gammaTwoCuspLevel Y)
    (hSide : QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hCuspExterior : QYM.FullCertification.P2ExactThreeBoundaryExtension.CuspSaturationRemainsNonInteriorAt Y)
    (hUpstairsConnected : QYM.FullCertification.P2ExactThreeBoundaryExtension.UpstairsCuspFrontierPartsConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y :=
  exactThreeCuspBoundaryDecomposition_of_remaining_inputs
    hSide hCuspExterior
    (noCrossCuspOrbit_of_one_lt_level hY)
    hUpstairsConnected

/-- Preferred high-cutoff endpoint: upstairs connectedness is not required.
At level greater than one the construction itself supplies nonemptiness and
pairwise separation, so the only remaining inputs are the two local
saturation statements and connectedness of the actual quotient pieces. -/
theorem exactThreeCuspBoundaryDecomposition_of_high_quotientConnected
    {Y : ℝ} (hY : 1 < gammaTwoCuspLevel Y)
    (hSide : QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hCuspExterior : QYM.FullCertification.P2ExactThreeBoundaryExtension.CuspSaturationRemainsNonInteriorAt Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hHorocycle : QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y :=
    (QYM.FullCertification.P2ExactThreeBoundaryExtension.horocyclesRemainBoundary_iff_cuspSaturationNonInterior Y).2
      hCuspExterior
  exact
    ⟨quotientCuspBoundaryPiecesNonempty Y,
      quotientCuspBoundaryPiecesPairwiseDisjoint_of_one_lt_level hY,
      hConnected,
      QYM.FullCertification.P2ExactThreeBoundaryExtension.frontier_XSet_eq_iUnion_cuspPieces_corrected
        hSide hHorocycle⟩

/-- At normalized level at least two, the arithmetic argument has also
discharged cusp exterior.  Thus only local side filling and connectedness of
the three actual quotient image-unions remain. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (hSide : QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hOne : 1 < gammaTwoCuspLevel Y :=
    lt_of_lt_of_le (by norm_num) hY
  exact exactThreeCuspBoundaryDecomposition_of_high_quotientConnected
    hOne hSide
    (cuspSaturationRemainsNonInterior_of_two_le_level hY)
    hConnected

/-- Raw-cutoff spelling of the preceding result. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_cutoff
    {Y : ℝ} (hY : 2 ≤ Y)
    (hSide : QYM.FullCertification.P2ExactThreeBoundaryExtension.PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hLevel : 2 ≤ gammaTwoCuspLevel Y := by
    rw [gammaTwoCuspLevel_of_one_le (le_trans (by norm_num) hY)]
    exact hY
  exact exactThreeCuspBoundaryDecomposition_of_two_le_level
    hLevel hSide hConnected

/-- Strongest endpoint proved here: at normalized level at least two,
nonemptiness, cross-cusp separation, cusp exterior, and paired-side filling
are all explicit inhabitants.  Only connectedness of the quotient active
image-unions remains as geometric input. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_level_from_connectedness
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y :=
  exactThreeCuspBoundaryDecomposition_of_two_le_level hY
    (pairedSidesAwayFromHorocyclesBecomeInterior_of_two_le_level hY)
    hConnected

/-- Raw-cutoff spelling of the strongest endpoint. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_cutoff_from_connectedness
    {Y : ℝ} (hY : 2 ≤ Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hLevel : 2 ≤ gammaTwoCuspLevel Y := by
    rw [gammaTwoCuspLevel_of_one_le (le_trans (by norm_num) hY)]
    exact hY
  exact
    exactThreeCuspBoundaryDecomposition_of_two_le_level_from_connectedness
      hLevel hConnected

/-- Strict-cutoff compatibility spelling of the strongest endpoint. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_lt_level
    {Y : ℝ} (hY : 2 < gammaTwoCuspLevel Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y :=
  exactThreeCuspBoundaryDecomposition_of_two_le_level_from_connectedness
    hY.le hConnected

/-- Raw-cutoff spelling of the strongest endpoint. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_lt_cutoff
    {Y : ℝ} (hY : 2 < Y)
    (hConnected : QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hLevel : 2 < gammaTwoCuspLevel Y := by
    rw [gammaTwoCuspLevel_of_one_le
      (le_trans (by norm_num) hY.le)]
    exact hY
  exact exactThreeCuspBoundaryDecomposition_of_two_lt_level
    hLevel hConnected

