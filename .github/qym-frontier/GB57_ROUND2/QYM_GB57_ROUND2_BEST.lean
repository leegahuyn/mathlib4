open Set Topology

/-!
# Typed evidence for the direct method, form-small B2, and asymptotic gaps

This registry is intentionally independent of
`QYM.FullCertification.TypedEvidence.EvidenceId`.  It gives every new tag an exact proposition and
an actual proof term while leaving the previously integrated registry unchanged.  A link to a
paper-claim identifier records only that the displayed proposition is relevant evidence for the
row; it does not identify the proposition with the PDF prose and it does not assign a terminal
certification status.

The direct-method statements expose compactness, lower semicontinuity, boundedness, weak
closedness, and the bidual range condition as hypotheses.  The form-small statements prove only
pointwise lower-bound arithmetic, not KLMN closedness or self-adjoint operator representation.  The
spectral B2 statements start from a displayed relative eigenvalue interval; they do not derive that
interval from an unformalized continuum min--max theorem.
-/

namespace QYM.FullCertification.TypedEvidenceB2DirectExtension

open Filter
open QYM.FullCertification.Registry

/-! ## Stable typed identifiers -/

/-- Typed identifiers for the new direct-method, B2, and liminf evidence tranche. -/
inductive EvidenceId where
  | compactDirectAttainment
  | weakDirectAttainmentWithSuppliers
  | formSmallExistentialCertificate
  | formSmallLowerBoundTransfer
  | ennrealTailLiminf
  | b2PointwiseEigenvalueError
  | b2EnergyDependentGapError
  | b2UniformAdditiveErrorNoGo
  | paperFormSmallLowerBoundNormalization
  | paperCor4_25TailNormalization
  | paperTheorem4_31B2Normalization
  deriving DecidableEq, Repr

/-! ## Exact certified propositions -/

/-- The exact proposition carried by each evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .compactDirectAttainment =>
      ∀ (X : Type*) [TopologicalSpace X]
          (feasible : Set X) (energy : X → ℝ),
        feasible.Nonempty →
        IsCompact feasible →
        LowerSemicontinuousOn energy feasible →
          ∃ minimizer ∈ feasible,
            ∀ competitor ∈ feasible,
              energy minimizer ≤ energy competitor
  | .weakDirectAttainmentWithSuppliers =>
      ∀ (𝕜 X : Type*) [RCLike 𝕜]
          [NormedAddCommGroup X] [NormedSpace 𝕜 X]
          (feasible : Set (WeakSpace 𝕜 X))
          (energy : WeakSpace 𝕜 X → ℝ),
        feasible.Nonempty →
        Bornology.IsBounded ((toWeakSpace 𝕜 X) ⁻¹' feasible) →
        closure (NormedSpace.inclusionInDoubleDualWeak 𝕜 X '' feasible) ⊆
            Set.range (NormedSpace.inclusionInDoubleDualWeak 𝕜 X) →
        IsClosed feasible →
        LowerSemicontinuousOn energy feasible →
          ∃ minimizer ∈ feasible,
            ∀ competitor ∈ feasible,
              energy minimizer ≤ energy competitor
  | .formSmallExistentialCertificate =>
      ∀ (State : Type*)
          (reference normSq correction : State → ℝ) (a b : ℝ),
        QYM.FormSmallPerturbationCore.FormSmall
            reference normSq correction a b →
          QYM.FormSmallPerturbationCore.HasFormSmallBound
            reference normSq correction
  | .formSmallLowerBoundTransfer =>
      ∀ (State : Type*)
          (reference normSq correction : State → ℝ),
        QYM.AbstractFormSign.HasFormLowerBound normSq reference →
        QYM.FormSmallPerturbationCore.HasFormSmallBound
            reference normSq correction →
          QYM.AbstractFormSign.HasFormLowerBound normSq
            (QYM.AbstractFormSign.plusForm reference correction)
  | .ennrealTailLiminf =>
      ∀ (gap : ℕ → ℝ≥0∞) (Y0 : ℕ) (δ : ℝ≥0∞),
        0 < δ →
        (∀ Y, Y0 ≤ Y → δ ≤ gap Y) →
          0 < liminf gap atTop
  | .b2PointwiseEigenvalueError =>
      ∀ (Index : Type*) (a b : ℝ)
          (reference corrected : Index → ℝ),
        QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
            a b reference corrected →
          ∀ i : Index,
            |corrected i - reference i| ≤ a * reference i + b
  | .b2EnergyDependentGapError =>
      ∀ (Index : Type*) (a b : ℝ)
          (reference corrected : Index → ℝ),
        QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
            a b reference corrected →
        0 ≤ a →
        0 ≤ b →
        (∀ i : Index, 0 ≤ reference i) →
          ∀ i j : Index,
            |QYM.RelativeSpectralB2NoGo.indexedGap corrected i j -
                QYM.RelativeSpectralB2NoGo.indexedGap reference i j| ≤
              a * (reference i + reference j) + 2 * b
  | .b2UniformAdditiveErrorNoGo =>
      ∀ a : ℝ,
        0 < a →
        a < 1 →
          a < 1 ∧
            QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
              a 0 QYM.RelativeSpectralB2NoGo.linearReference
                (QYM.RelativeSpectralB2NoGo.relativeDilation a) ∧
            ¬ ∃ ε : ℝ, ∀ n : ℕ,
              |QYM.RelativeSpectralB2NoGo.relativeDilation a n -
                  QYM.RelativeSpectralB2NoGo.linearReference n| ≤ ε
  | .paperFormSmallLowerBoundNormalization =>
      QYM.FullCertification.PaperNormalized.def4_8_formSmallStatement ∧
        QYM.FullCertification.PaperNormalized.def4_8_hasFormSmallBoundStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_30_lowerBoundCoreStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_30_existentialLowerBoundCoreStatement
  | .paperCor4_25TailNormalization =>
      QYM.FullCertification.PaperNormalized.cor4_25_ennrealLiminfStatement
  | .paperTheorem4_31B2Normalization =>
      QYM.FullCertification.PaperNormalized.theorem4_31_B2PointwiseStatement ∧
        ¬ QYM.FullCertification.PaperNormalized.theorem4_31_B2UniformInferenceStatement ∧
        QYM.FullCertification.PaperNormalized.theorem4_31_B2UniformCountermodelStatement

/-! ## Proof terms -/

/-- Every proposition in this extension has a proof term in the displayed source dependencies. -/
theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | compactDirectAttainment =>
      intro X instTopological feasible energy hne hcompact hlsc
      exact
        QYM.FullCertification.Corrected.DirectMethod.exists_minimizer_on_compact
          hne hcompact hlsc
  | weakDirectAttainmentWithSuppliers =>
      intro 𝕜 X instRCLike instNormedGroup instNormedSpace
        feasible energy hne hbounded hrange hclosed hlsc
      exact
        QYM.FullCertification.Corrected.DirectMethod.exists_weak_minimizer_of_closed_bounded_of_bidualRange
          hne hbounded hrange hclosed hlsc
  | formSmallExistentialCertificate =>
      intro State reference normSq correction a b hsmall
      exact
        QYM.FormSmallPerturbationCore.hasFormSmallBound_of_formSmall hsmall
  | formSmallLowerBoundTransfer =>
      intro State reference normSq correction hlower hsmall
      exact
        QYM.FormSmallPerturbationCore.plusForm_hasFormLowerBound_of_hasFormSmallBound
          hlower hsmall
  | ennrealTailLiminf =>
      intro gap Y0 δ hδ hlower
      exact
        QYM.AsymptoticGapLiminf.ennreal_liminf_pos_of_forall_ge
          Y0 hδ hlower
  | b2PointwiseEigenvalueError =>
      intro Index a b reference corrected hinterval i
      exact QYM.RelativeSpectralB2NoGo.pointwise_error_bound hinterval i
  | b2EnergyDependentGapError =>
      intro Index a b reference corrected hinterval ha hb hreference i j
      exact
        QYM.RelativeSpectralB2NoGo.gap_error_bound_of_nonnegative
          hinterval ha hb hreference i j
  | b2UniformAdditiveErrorNoGo =>
      intro a ha hsmall
      exact
        QYM.RelativeSpectralB2NoGo.formSmall_relative_parameters_still_do_not_give_uniform_additiveError
          ha hsmall
  | paperFormSmallLowerBoundNormalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.def4_8_formSmallStatement_holds,
          QYM.FullCertification.PaperNormalized.def4_8_hasFormSmallBoundStatement_holds,
          QYM.FullCertification.PaperNormalized.lemma4_30_lowerBoundCoreStatement_holds,
          QYM.FullCertification.PaperNormalized.lemma4_30_existentialLowerBoundCoreStatement_holds⟩
  | paperCor4_25TailNormalization =>
      exact
        QYM.FullCertification.PaperNormalized.cor4_25_ennrealLiminfStatement_holds
  | paperTheorem4_31B2Normalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.theorem4_31_B2PointwiseStatement_holds,
          QYM.FullCertification.PaperNormalized.theorem4_31_B2UniformInferenceStatement_refuted,
          QYM.FullCertification.PaperNormalized.theorem4_31_B2UniformCountermodelStatement_holds⟩

/-! ## Proof-carrying certificates and complete enumeration -/

/-- A dependent evidence object retaining the proposition proved by its tag. -/
structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement.{0, 0, 0, 0, 0, 0, 0} id

/-- The canonical proof-carrying object for one evidence identifier. -/
def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

/-- The complete, duplicate-free list of identifiers in this independent extension. -/
def allEvidence : List EvidenceId :=
  [.compactDirectAttainment,
   .weakDirectAttainmentWithSuppliers,
   .formSmallExistentialCertificate,
   .formSmallLowerBoundTransfer,
   .ennrealTailLiminf,
   .b2PointwiseEigenvalueError,
   .b2EnergyDependentGapError,
   .b2UniformAdditiveErrorNoGo,
   .paperFormSmallLowerBoundNormalization,
   .paperCor4_25TailNormalization,
   .paperTheorem4_31B2Normalization]

/-- Proof-carrying certificates for all identifiers in the extension. -/
def allCertificates : List Certificate :=
  allEvidence.map certificate

theorem allEvidence_length : allEvidence.length = 11 := by decide

theorem allCertificates_length : allCertificates.length = 11 := by decide

theorem allEvidence_nodup : allEvidence.Nodup := by decide

theorem allEvidence_complete (evidence : EvidenceId) :
    evidence ∈ allEvidence := by
  cases evidence <;> simp [allEvidence]

theorem allCertificates_ids :
    allCertificates.map Certificate.id = allEvidence := by
  simp only [allCertificates, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) allEvidence = allEvidence
  rfl

/-! ## Links to the manual claim registry -/

/-- New typed evidence associated with the seven affected manual claim rows.  Every other row is
left empty in this extension. -/
def evidenceForClaim : ClaimId → List EvidenceId
  | .prop3_1 =>
      [.compactDirectAttainment, .weakDirectAttainmentWithSuppliers]
  | .theorem4_3 =>
      [.compactDirectAttainment, .weakDirectAttainmentWithSuppliers]
  | .cor4_25 =>
      [.ennrealTailLiminf, .paperCor4_25TailNormalization]
  | .def4_8 =>
      [.formSmallExistentialCertificate, .paperFormSmallLowerBoundNormalization]
  | .lemma4_30 =>
      [.formSmallLowerBoundTransfer, .paperFormSmallLowerBoundNormalization]
  | .theorem4_31 =>
      [.b2PointwiseEigenvalueError, .b2UniformAdditiveErrorNoGo,
        .paperTheorem4_31B2Normalization]
  | .cor4_32 =>
      [.b2EnergyDependentGapError]
  | _ => []

/-- Proof-carrying evidence objects attached to one claim row. -/
def certificatesForClaim (claim : ClaimId) : List Certificate :=
  (evidenceForClaim claim).map certificate

theorem certificatesForClaim_ids (claim : ClaimId) :
    (certificatesForClaim claim).map Certificate.id = evidenceForClaim claim := by
  simp only [certificatesForClaim, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) (evidenceForClaim claim) =
    evidenceForClaim claim
  cases claim <;> rfl

/-- Membership in a support row recovers the exact certified proposition. -/
theorem linkedEvidence_sound {claim : ClaimId} {evidence : EvidenceId}
    (_h : evidence ∈ evidenceForClaim claim) : EvidenceStatement evidence :=
  evidenceSound evidence

theorem evidenceForClaim_nodup (claim : ClaimId) :
    (evidenceForClaim claim).Nodup := by
  cases claim <;> decide

/-- Exactly seven manual claim rows receive evidence from this extension. -/
def claimsWithEvidence : List ClaimId :=
  allClaims.filter fun claim => !(evidenceForClaim claim).isEmpty

theorem claimsWithEvidence_length : claimsWithEvidence.length = 7 := by decide

/-- Flattened claim/evidence links used for exact coverage accounting. -/
def evidencePairs : List (ClaimId × EvidenceId) :=
  allClaims.flatMap fun claim =>
    (evidenceForClaim claim).map fun evidence => (claim, evidence)

theorem evidencePairs_length : evidencePairs.length = 14 := by decide

/-- Every identifier in the extension is linked to at least one manual claim row. -/
theorem allEvidence_used (evidence : EvidenceId) :
    ∃ claim : ClaimId, evidence ∈ evidenceForClaim claim := by
  cases evidence with
  | compactDirectAttainment =>
      exact ⟨.prop3_1, by simp [evidenceForClaim]⟩
  | weakDirectAttainmentWithSuppliers =>
      exact ⟨.prop3_1, by simp [evidenceForClaim]⟩
  | formSmallExistentialCertificate =>
      exact ⟨.def4_8, by simp [evidenceForClaim]⟩
  | formSmallLowerBoundTransfer =>
      exact ⟨.lemma4_30, by simp [evidenceForClaim]⟩
  | ennrealTailLiminf =>
      exact ⟨.cor4_25, by simp [evidenceForClaim]⟩
  | b2PointwiseEigenvalueError =>
      exact ⟨.theorem4_31, by simp [evidenceForClaim]⟩
  | b2EnergyDependentGapError =>
      exact ⟨.cor4_32, by simp [evidenceForClaim]⟩
  | b2UniformAdditiveErrorNoGo =>
      exact ⟨.theorem4_31, by simp [evidenceForClaim]⟩
  | paperFormSmallLowerBoundNormalization =>
      exact ⟨.def4_8, by simp [evidenceForClaim]⟩
  | paperCor4_25TailNormalization =>
      exact ⟨.cor4_25, by simp [evidenceForClaim]⟩
  | paperTheorem4_31B2Normalization =>
      exact ⟨.theorem4_31, by simp [evidenceForClaim]⟩

