/-! ## Assumption 4.8: typed Sobolev bilinear estimate -/

/-- Conditional consequence of a supplied product estimate: bounded input balls have bounded
image.  This does not assert that the paper's corrected `B_q` satisfies the supplier predicate. -/
def assumption4_8_bilinearBallImplicationStatement : Prop :=
  ∀ (Parameter Input Output : Type)
      [AddCommGroup Input] [Module ℝ Input]
      [AddCommGroup Output] [Module ℝ Output]
      (region : Parameter → Prop)
      (family : Parameter → Input → Input → Output)
      (inputSize : Input → ℝ) (outputSize : Output → ℝ)
      (C R S : ℝ) (q : Parameter) (x y : Input),
    (∀ p, region p →
      QYM.SobolevGaugeSupplierNoGo.IsRealBilinear (family p)) →
    (∀ z, 0 ≤ inputSize z) →
    QYM.SobolevGaugeSupplierNoGo.HasUniformSobolevBilinearEstimateOn
        region family inputSize outputSize C →
    region q →
    inputSize x ≤ R →
    inputSize y ≤ S →
    0 ≤ R →
      outputSize (family q x y) ≤ C * R * S

theorem assumption4_8_bilinearBallImplicationStatement_holds :
    assumption4_8_bilinearBallImplicationStatement := by
  intro Parameter Input Output
    instInputAdd instInputModule instOutputAdd instOutputModule
    region family inputSize outputSize C R S q x y _hbilinear
    hinput hestimate hq hx hy hR
  exact
    QYM.SobolevGaugeSupplierNoGo.sobolevBilinear_familyBallBound
      region family inputSize outputSize C R S hinput hestimate hq hx hy hR

/-- Mere binary arity and nonnegative size functions would force a Sobolev estimate. -/
def assumption4_8_arityOnlyInferenceStatement : Prop :=
  (∀ x : Unit, 0 ≤ QYM.SobolevGaugeSupplierNoGo.unitInputSize x) →
  (∀ z : Unit, 0 ≤ QYM.SobolevGaugeSupplierNoGo.unitOutputSize z) →
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ x y,
        QYM.SobolevGaugeSupplierNoGo.unitOutputSize
            (QYM.SobolevGaugeSupplierNoGo.unitBinaryCandidate x y) ≤
          C * QYM.SobolevGaugeSupplierNoGo.unitInputSize x *
            QYM.SobolevGaugeSupplierNoGo.unitInputSize y

theorem assumption4_8_arityOnlyInferenceStatement_refuted :
    ¬ assumption4_8_arityOnlyInferenceStatement := by
  intro hinference
  apply QYM.SobolevGaugeSupplierNoGo.unitBinaryCandidate_has_no_sobolevEstimate
  apply hinference
  · intro x
    norm_num [QYM.SobolevGaugeSupplierNoGo.unitInputSize]
  · intro z
    norm_num [QYM.SobolevGaugeSupplierNoGo.unitOutputSize]

def assumption4_8_arityOnlyCountermodelStatement : Prop :=
  (∀ x : Unit, 0 ≤ QYM.SobolevGaugeSupplierNoGo.unitInputSize x) ∧
    (∀ z : Unit, 0 ≤ QYM.SobolevGaugeSupplierNoGo.unitOutputSize z) ∧
    ¬ ∃ C : ℝ, 0 ≤ C ∧
      ∀ x y,
        QYM.SobolevGaugeSupplierNoGo.unitOutputSize
            (QYM.SobolevGaugeSupplierNoGo.unitBinaryCandidate x y) ≤
          C * QYM.SobolevGaugeSupplierNoGo.unitInputSize x *
            QYM.SobolevGaugeSupplierNoGo.unitInputSize y

theorem assumption4_8_arityOnlyCountermodelStatement_holds :
