/-!
# The concrete density input for the width-two fractional graph

The closed-graph argument only leaves density of the finite-energy domain.
This file supplies the analytic part of that statement for the actual cusp
multiplier.  First, the multiplier is proved smooth (hence Lipschitz on every
compact interval).  Second, a smooth function supported strictly inside
`(0,2)` is doubled by

`F(x) = f(x) + tau (x - 2) * f (x - 2)`.

On `[0,2]`, `F = f`; on `[2,4]`, it is exactly the required covariant copy.
The existing Lipschitz seam estimate therefore puts the corresponding `L2`
class in the finite-energy domain.

The only residual statement is the standard collar-cutoff refinement of
Mathlib's `Lp.dense_hasCompactSupport_contDiff`: compactly supported smooth
representatives can be chosen with support contained in `(0,2)` for Lebesgue
measure restricted to `[0,2]`.  It is recorded as a concrete `Dense` statement,
not as an axiom or a field hidden in a certificate.
-/

/-! ## 1. Smoothness of the actual transition -/

/-- The actual inverse-eta transition is real `C-infinity` in the boundary
coordinate.  The proof upgrades the continuity calculation from the trace
producer: eta is holomorphic on the open upper half-plane, the horocycle is
smooth, and the remaining denominator is a nonvanishing smooth function. -/
theorem actualFixedPhaseCuspBoundaryTransition_contDiff
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    ContDiff ℝ ∞
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y) := by
  have hcurve : ContDiff ℝ ∞
      (fun x : ℝ =>
        ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) :=
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspHorocyclePoint_coe_contDiff kappa Y
  have hetaComplex : ContDiffOn ℂ ∞ ModularForm.eta UpperHalfPlane.upperHalfPlaneSet := by
    apply DifferentiableOn.contDiffOn
    · intro z hz
      exact
        (ModularForm.differentiableAt_eta_of_mem_upperHalfPlaneSet hz).differentiableWithinAt
    · exact UpperHalfPlane.isOpen_upperHalfPlaneSet
  have heta : ContDiff ℝ ∞
      (fun x : ℝ =>
        ModularForm.eta
          ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) := by
    simpa only [Function.comp_def] using
      (hetaComplex.restrict_scalars ℝ).comp_contDiff hcurve
        (fun x => (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x).2)
  have hshift : ContDiff ℝ ∞ (fun x : ℝ => x + 2) :=
    contDiff_id.add contDiff_const
  have hetaShift : ContDiff ℝ ∞
      (fun x : ℝ =>
        ModularForm.eta
          ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint
              kappa Y (x + 2) : ℍ) : ℂ)) := by
    simpa only [Function.comp_def] using heta.comp hshift
  have hinverseEta : ContDiff ℝ ∞
      (fun x : ℝ =>
        (inverseEtaMultiplier GammaTwo).factor
          (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspDeckTranslation kappa)
          (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x)) := by
    have hfun :
        (fun x : ℝ =>
          (inverseEtaMultiplier GammaTwo).factor
            (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspDeckTranslation kappa)
            (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x)) =
          (fun x : ℝ =>
            ModularForm.eta
                ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ) /
              ModularForm.eta
                ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y (x + 2) : ℍ) : ℂ)) := by
      funext x
      rw [inverseEtaMultiplier_factor]
      exact (congrArg
        (fun z : ℍ =>
          ModularForm.eta
              ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ) /
            ModularForm.eta (z : ℂ))
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspHorocyclePoint_add_two
          kappa Y x)).symm
    rw [hfun]
    simpa only [div_eq_mul_inv] using!
      heta.mul (hetaShift.inv
        (fun x => ModularForm.eta_ne_zero
          (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y (x + 2)).2))
  let gamma : GL (Fin 2) ℝ :=
    ((((QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
      SL(2, ℤ))) : GL (Fin 2) ℝ)
  have hden : ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.denom gamma
          ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) := by
    simpa only [UpperHalfPlane.denom] using
      (contDiff_const.mul hcurve).add contDiff_const
  have hdenNe : ∀ x : ℝ,
      UpperHalfPlane.denom gamma
        (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x) ≠ 0 := by
    intro x
    exact UpperHalfPlane.denom_ne_zero gamma
      (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x)
  have hdenPow : ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.denom gamma
          (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x) ^
            ((2 : ℤ) * n)) := by
    generalize hk : (2 : ℤ) * n = k
    cases k with
    | ofNat m =>
        simpa only [hk, zpow_natCast] using! hden.pow m
    | negSucc m =>
        simpa only [hk, zpow_negSucc] using!
          (hden.pow (m + 1)).inv
            (fun x => pow_ne_zero _ (hdenNe x))
  change ContDiff ℝ ∞
    (fun x : ℝ =>
      (inverseEtaPaperOrbitMultiplier GammaTwo n).factor
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspDeckTranslation kappa)
        (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x))
  simpa only [inverseEtaPaperOrbitMultiplier_factor, gamma] using
    hinverseEta.mul hdenPow

/-- In particular the actual transition is Lipschitz on the doubled interval
used by the Slobodeckij estimate. -/
theorem actualFixedPhaseCuspBoundaryTransition_exists_lipschitzOn
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    ∃ K : NNReal,
      LipschitzOnWith K
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (Set.Icc (0 : ℝ) 4) := by
  exact
    (actualFixedPhaseCuspBoundaryTransition_contDiff
      n kappa Y).contDiffOn.exists_lipschitzOnWith
        (by simp) (convex_Icc (0 : ℝ) 4) isCompact_Icc

/-! ## 2. Covariant doubling of an interior test function -/

/-- A raw function and its transition-corrected translate.  Interior support
makes the two summands disjoint on the two width-two copies. -/
def widthTwoCovariantDouble
    (tau f : ℝ → ℂ) (x : ℝ) : ℂ :=
  f x + tau (x - 2) * f (x - 2)

theorem widthTwoCovariantDouble_eq_on_Icc
    (tau f : ℝ → ℂ)
    (hsupport : Function.support f ⊆ Set.Ioo (0 : ℝ) 2)
    {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 2) :
    widthTwoCovariantDouble tau f x = f x := by
  have hzero : f (x - 2) = 0 := by
    by_contra hne
    have hmem := hsupport (Function.mem_support.mpr hne)
    linarith [hx.2, hmem.1]
  simp only [widthTwoCovariantDouble, hzero, mul_zero, add_zero]

theorem widthTwoCovariantDouble_covariant
    (tau f : ℝ → ℂ)
    (hsupport : Function.support f ⊆ Set.Ioo (0 : ℝ) 2)
    {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 2) :
    widthTwoCovariantDouble tau f (x + 2) =
      tau x * widthTwoCovariantDouble tau f x := by
  have hright : f (x + 2) = 0 := by
    by_contra hne
    have hmem := hsupport (Function.mem_support.mpr hne)
    linarith [hx.1, hmem.2]
  have hleft : f (x - 2) = 0 := by
    by_contra hne
    have hmem := hsupport (Function.mem_support.mpr hne)
    linarith [hx.2, hmem.1]
  simp only [widthTwoCovariantDouble, hright, hleft, mul_zero,
    add_zero, zero_add, add_sub_cancel_right]

theorem widthTwoCovariantDouble_contDiff
    {tau f : ℝ → ℂ}
    (htau : ContDiff ℝ ∞ tau) (hf : ContDiff ℝ ∞ f) :
    ContDiff ℝ ∞ (widthTwoCovariantDouble tau f) := by
  have hshift : ContDiff ℝ ∞ (fun x : ℝ => x - 2) :=
    contDiff_id.sub contDiff_const
  exact hf.add ((htau.comp hshift).mul (hf.comp hshift))

/-- Every smooth test function supported strictly inside `(0,2)` gives a
finite-energy representative.  This is the seam estimate needed for density;
no global automorphic extension is used. -/
theorem widthTwoCovariantDouble_memLp
    (tau f : ℝ → ℂ)
    (htau : ContDiff ℝ ∞ tau)
    (hf : ContDiff ℝ ∞ f)
    (hsupport : Function.support f ⊆ Set.Ioo (0 : ℝ) 2) :
    MemLp
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau
        (widthTwoCovariantDouble tau f))
      2 QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure := by
  have hdouble := widthTwoCovariantDouble_contDiff htau hf
  obtain ⟨K, hLip⟩ :=
    hdouble.contDiffOn.exists_lipschitzOnWith
      (by simp) (convex_Icc (0 : ℝ) 4) isCompact_Icc
  exact QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient_memLp_of_lipschitz
    tau (widthTwoCovariantDouble tau f) K
      htau.continuous.measurable hdouble.continuous.measurable hLip
      (fun x hx => widthTwoCovariantDouble_covariant
        tau f hsupport hx)

/-! ## 3. The exact pure-`L2` density residual -/

/-- The broad compactly supported smooth core supplied directly by Mathlib. -/
def WidthTwoCompactSmoothL2Core : Set QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2 :=
  {u | ∃ f : ℝ → ℂ,
    (u : ℝ → ℂ) =ᵐ[QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure] f ∧
      HasCompactSupport f ∧ ContDiff ℝ ∞ f}

/-- Mathlib already proves density before imposing the interior-support
collar. -/
theorem widthTwoCompactSmoothL2Core_dense :
    Dense WidthTwoCompactSmoothL2Core := by
  simpa only [WidthTwoCompactSmoothL2Core] using
    (MeasureTheory.Lp.dense_hasCompactSupport_contDiff
      (E := ℝ) (F := ℂ)
      (p := (2 : ℝ≥0∞))
      (μ := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)
      (by norm_num))

/-- Compactly supported smooth representatives whose support stays away from
both endpoints.  This is the concrete core absorbed by the fractional domain. -/
def WidthTwoInteriorSmoothL2Core : Set QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2 :=
  {u | ∃ f : ℝ → ℂ,
    (u : ℝ → ℂ) =ᵐ[QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure] f ∧
      HasCompactSupport f ∧ ContDiff ℝ ∞ f ∧
      Function.support f ⊆ Set.Ioo (0 : ℝ) 2}

/-- Exact remaining collar-cutoff lemma.  Analytically it follows by
multiplying the Mathlib smooth approximants by cutoffs that equal one on
`[epsilon, 2-epsilon]` and then sending `epsilon` to zero. -/
def WidthTwoInteriorSmoothL2CoreDense : Prop :=
  Dense WidthTwoInteriorSmoothL2Core

/-- The interior smooth core lies in the finite-energy domain for every smooth
transition. -/
theorem widthTwoInteriorSmoothL2Core_subset_domain
    (tau : ℝ → ℂ) (htau : ContDiff ℝ ∞ tau) :
    WidthTwoInteriorSmoothL2Core ⊆
      (((QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain tau :
        Submodule ℂ QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :
        Set QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2)) := by
  intro u hu
  rcases hu with ⟨f, huf, _hcompact, hf, hsupport⟩
  have hdoubleMem := widthTwoCovariantDouble_memLp
    tau f htau hf hsupport
  have hdoubleEq :
      widthTwoCovariantDouble tau f =ᵐ[
          QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure] f := by
    have hmem :
        ∀ᵐ x ∂QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure,
          x ∈ Set.Icc (0 : ℝ) 2 := by
      simpa only [QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure] using
        (ae_restrict_mem measurableSet_Icc :
          ∀ᵐ x ∂(Measure.restrict (volume : Measure ℝ)
            (Set.Icc (0 : ℝ) 2)), x ∈ Set.Icc (0 : ℝ) 2)
    filter_upwards [hmem] with x hx
    exact widthTwoCovariantDouble_eq_on_Icc tau f hsupport hx
  have huDouble :
      (u : ℝ → ℂ) =ᵐ[
          QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure]
        widthTwoCovariantDouble tau f :=
    huf.trans hdoubleEq.symm
  have hquot :=
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient_congr_ae tau huDouble
  change MemLp
    (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau (u : ℝ → ℂ))
      2 QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure
  exact (memLp_congr_ae hquot).2 hdoubleMem

/-- Unconditional analytic inclusion for each of the three actual cusp
transitions.  Only density of this already-absorbed core remains. -/
theorem actualFixedPhase_interiorSmoothL2Core_subset_domain
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    WidthTwoInteriorSmoothL2Core ⊆
      (((QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain
          (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y) :
        Submodule ℂ QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :
        Set QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2)) :=
  widthTwoInteriorSmoothL2Core_subset_domain
    (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y)
    (actualFixedPhaseCuspBoundaryTransition_contDiff n kappa Y)

/-- Once the pure collar-cutoff density lemma is supplied, the actual
inverse-eta finite-energy domain is dense. -/
theorem actualFixedPhase_widthTwoHhalfFiniteEnergyDomainDense_of_interiorSmoothCoreDense
    (hDense : WidthTwoInteriorSmoothL2CoreDense)
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    QYM.FullCertification.P2HhalfClosabilityExtension.WidthTwoHhalfFiniteEnergyDomainDense
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y) := by
  exact Dense.mono
    (actualFixedPhase_interiorSmoothL2Core_subset_domain n kappa Y)
    hDense

end QYM.FullCertification.P2HhalfDensityExtension

