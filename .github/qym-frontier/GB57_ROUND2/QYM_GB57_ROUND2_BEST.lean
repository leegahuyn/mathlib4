    QYM.FullCertification.P2NormalGreenExtension.HasOppositePairedNormalPushforward
      QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal :=
  QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal_hasOppositePushforward_of_global
    actualManifoldDeckDerivativeD1Compatibility

