namespace QYM.FullCertification.P2RegularQuotientCoveringExtension




/-!
# The genuine covering locus of the effective `Gamma(2)` quotient

Proper discontinuity alone gives an orbifold quotient: it does not erase a
nontrivial point stabilizer.  This module therefore constructs the maximal
stabilizer-free locus and applies Mathlib's actual quotient-covering theorem
there.  Nothing below assumes that the whole effective action is free.

For the paper's desired global quotient manifold, the remaining arithmetic
statement is exactly `EffectiveActionFree`.  Once a proof of that statement
is supplied from the concrete level-two congruence conditions, the final
theorems below promote the same orbit projection to a global covering map
and local homeomorphism.  Thus this file advances the quotient-atlas route
without silently treating finite stabilizers as trivial.
-/

abbrev EffectiveGroup : Type := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoEffective

abbrev EffectiveQuotient : Type := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient

/-! ## Stabilizer-free loci -/

/-- Points of the upper half-plane with trivial effective stabilizer. -/
def regularUpstairs : Set ℍ :=
  {z : ℍ | MulAction.stabilizer EffectiveGroup z = ⊥}

/-- Their image in the effective orbit quotient. -/
def regularQuotient : Set EffectiveQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk '' regularUpstairs

/-- Triviality of the stabilizer is invariant along every effective orbit. -/
@[simp]
theorem smul_mem_regularUpstairs_iff
    (g : EffectiveGroup) (z : ℍ) :
    g • z ∈ regularUpstairs ↔ z ∈ regularUpstairs := by
  change MulAction.stabilizer EffectiveGroup (g • z) = ⊥ ↔
    MulAction.stabilizer EffectiveGroup z = ⊥
  rw [MulAction.stabilizer_smul_eq_stabilizer_map_conj]
  exact Subgroup.map_eq_bot_iff_of_injective
    (MulAction.stabilizer EffectiveGroup z)
    (MulAut.conj g).injective

/-- Proper discontinuity makes the stabilizer-free locus open.  The proof
uses the actual local finite-intersection neighbourhood supplied by the
effective `Gamma(2)` action. -/
theorem regularUpstairs_isOpen : IsOpen regularUpstairs := by
  rw [isOpen_iff_mem_nhds]
  intro z hz
  obtain ⟨U, hU, hLocal⟩ :=
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoEffective_exists_nhds_image_smul_eq_self z
  refine Filter.mem_of_superset hU ?_
  intro w hw
  change MulAction.stabilizer EffectiveGroup w = ⊥
  refine (Subgroup.eq_bot_iff_forall _).mpr fun g hg ↦ ?_
  have hgw : g • w = w := MulAction.mem_stabilizer_iff.mp hg
  have hgz : g • z = z :=
    hLocal g ⟨w, ⟨w, hw, hgw⟩, hw⟩
  have hzStabilizer :
      MulAction.stabilizer EffectiveGroup z = ⊥ := hz
  rw [← Subgroup.mem_bot, ← hzStabilizer,
    MulAction.mem_stabilizer_iff]
  exact hgz

/-- The regular quotient locus is open because the orbit projection is an
open quotient map. -/
theorem regularQuotient_isOpen : IsOpen regularQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap
    regularUpstairs regularUpstairs_isOpen

/-- Pulling the regular quotient locus back upstairs recovers exactly the
trivial-stabilizer locus; no representative choice is involved. -/
theorem preimage_regularQuotient_eq_regularUpstairs :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' regularQuotient = regularUpstairs := by
  ext z
  constructor
  · rintro ⟨w, hw, hqw⟩
    have hrel : MulAction.orbitRel EffectiveGroup ℍ w z := by
      change Quotient.mk'' w = Quotient.mk'' z at hqw
      exact Quotient.eq''.mp hqw
    rcases hrel with ⟨g, hgz⟩
    change g • z = w at hgz
    have hreg : g • z ∈ regularUpstairs := by
      rw [hgz]
      exact hw
    exact (smul_mem_regularUpstairs_iff g z).mp hreg
  · intro hz
    exact ⟨z, hz, rfl⟩

/-! ## Actual covering and local-homeomorphism statements -/

/-- Mathlib's quotient-covering theorem applies unconditionally on the
trivial-stabilizer image of this concrete properly discontinuous action. -/
theorem quotientProjection_isCoveringMapOn_regular :
    IsCoveringMapOn Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk regularQuotient := by
  simpa only [regularQuotient, regularUpstairs,
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk, Quotient.mk''_eq_mk] using
    (isCoveringMapOn_quotientMk_of_properlyDiscontinuousSMul
      (G := EffectiveGroup) (E := ℍ))

/-- Every regular quotient point has an evenly covered neighbourhood. -/
theorem regularQuotient_evenlyCovered
    (x : EffectiveQuotient) (hx : x ∈ regularQuotient) :
    IsEvenlyCovered Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk x
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' {x}) :=
  quotientProjection_isCoveringMapOn_regular x hx

/-- The orbit projection is a local homeomorphism on the full preimage of
the regular quotient locus. -/
theorem quotientProjection_isLocalHomeomorphOn_regular :
    IsLocalHomeomorphOn Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' regularQuotient) :=
  quotientProjection_isCoveringMapOn_regular.isLocalHomeomorphOn

/-- In particular the orbit projection is continuous on the regular
upstairs locus, written with the exact preimage domain consumed by the
covering API. -/
theorem quotientProjection_continuousOn_regular :
    ContinuousOn Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' regularQuotient) :=
  quotientProjection_isCoveringMapOn_regular.continuousOn

/-- Restricting both source and target to the regular locus produces an
actual covering map, not merely a pointwise neighbourhood assertion. -/
theorem restrictedRegularProjection_isCoveringMap :
    IsCoveringMap
      (regularQuotient.restrictPreimage Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk) :=
  quotientProjection_isCoveringMapOn_regular.isCoveringMap_restrictPreimage

/-! ## Exact arithmetic boundary for a global quotient atlas -/

/-- The precise missing arithmetic property: the faithful effective
`Gamma(2)` action has no nontrivial stabilizer in the upper half-plane. -/
abbrev EffectiveActionFree : Prop :=
  IsCancelSMul EffectiveGroup ℍ

/-- Freeness is exactly the assertion that the regular upstairs locus is all
of the upper half-plane. -/
theorem effectiveActionFree_iff_regularUpstairs_eq_univ :
    EffectiveActionFree ↔ regularUpstairs = (Set.univ : Set ℍ) := by
  constructor
  · intro hFree
    change IsCancelSMul EffectiveGroup ℍ at hFree
    rw [isCancelSMul_iff_stabilizer_eq_bot] at hFree
    apply Set.eq_univ_of_forall
    intro z
    exact hFree z
  · intro hRegular
    change IsCancelSMul EffectiveGroup ℍ
    rw [isCancelSMul_iff_stabilizer_eq_bot]
    intro z
    have hz : z ∈ regularUpstairs := by
      rw [hRegular]
      exact Set.mem_univ z
    exact hz

/-- Once the concrete arithmetic freeness theorem is proved, the effective
orbit projection is a global covering map. -/
theorem quotientProjection_isCoveringMap_of_effectiveActionFree
    (hFree : EffectiveActionFree) :
    IsCoveringMap Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk := by
  letI : IsCancelSMul EffectiveGroup ℍ := hFree
  simpa only [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk, Quotient.mk''_eq_mk] using
    (isQuotientCoveringMap_quotientMk_of_properlyDiscontinuousSMul
      (G := EffectiveGroup) (E := ℍ)).isCoveringMap

/-- The same exact arithmetic input promotes the orbit projection to a
global local homeomorphism, the topological precursor of quotient charts. -/
theorem quotientProjection_isLocalHomeomorph_of_effectiveActionFree
    (hFree : EffectiveActionFree) :
    IsLocalHomeomorph Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk :=
  (quotientProjection_isCoveringMap_of_effectiveActionFree hFree).isLocalHomeomorph

/-- Aggregate unconditional endpoint on the genuine regular quotient. -/
theorem regularQuotientCoveringCertificate :
    IsOpen regularUpstairs ∧
      IsOpen regularQuotient ∧
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' regularQuotient = regularUpstairs ∧
      IsCoveringMapOn Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk regularQuotient ∧
      IsLocalHomeomorphOn Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' regularQuotient) := by
  exact ⟨regularUpstairs_isOpen, regularQuotient_isOpen,
    preimage_regularQuotient_eq_regularUpstairs,
    quotientProjection_isCoveringMapOn_regular,
    quotientProjection_isLocalHomeomorphOn_regular⟩

end QYM.FullCertification.P2RegularQuotientCoveringExtension

