namespace QYM.FullCertification.P2HhalfCollarDensityExtension

open Mock2FA.PaperCorrections.AutomorphicSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp










/-!
# Unconditional collar density for the width-two `H^(1/2)` domain

The preceding density module reduced the only remaining analytic input to
the density of globally smooth compactly supported representatives whose
ordinary support is contained in `(0,2)`.  This file proves that statement.

The cutoff is not an indicator.  We fix a smooth bump `beta` centered at `1`
with outer radius `1`, and use

`chi_n(x) = beta(x) / (beta(x) + 1 / (n + 1))`.

Thus `0 <= chi_n <= 1`, `support chi_n` is contained in `(0,2)`, and
`chi_n(x) -> 1` at every interior point.  Uniform integrability, inherited
from the single target function by the pointwise norm bound
`||chi_n f|| <= ||f||`, upgrades the almost-everywhere convergence to `L2`
convergence.  No density certificate or additional analytic hypothesis is
introduced.
-/

/-! ## 1. A fixed smooth bump on the open width-two interval -/

/-- A smooth bump centered at `1`, equal to one on the radius-`1/2` ball and
with support the radius-`1` ball. -/
noncomputable def widthTwoCollarBump : ContDiffBump (1 : ℝ) where
  rIn := (1 : ℝ) / 2
  rOut := 1
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

@[simp]
theorem widthTwoCollarBump_rIn :
    widthTwoCollarBump.rIn = (1 : ℝ) / 2 :=
  rfl

@[simp]
theorem widthTwoCollarBump_rOut :
    widthTwoCollarBump.rOut = (1 : ℝ) :=
  rfl

/-- The ordinary support of the fixed bump is exactly `(0,2)`. -/
theorem widthTwoCollarBump_support :
    Function.support (widthTwoCollarBump : ℝ → ℝ) =
      Set.Ioo (0 : ℝ) 2 := by
  rw [ContDiffBump.support_eq]
  ext x
  simp only [Metric.mem_ball, Real.dist_eq, widthTwoCollarBump_rOut,
    Set.mem_Ioo]
  rw [abs_lt]
  constructor
  · rintro ⟨hleft, hright⟩
    constructor <;> linarith
  · rintro ⟨hzero, htwo⟩
    constructor <;> linarith

/-- The fixed bump is strictly positive at every interior point. -/
theorem widthTwoCollarBump_pos_of_mem_Ioo
    {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 2) :
    0 < widthTwoCollarBump x := by
  apply widthTwoCollarBump.nonneg.lt_of_ne'
  apply Function.mem_support.mp
  rwa [widthTwoCollarBump_support]

/-! ## 2. Smooth collar cutoffs -/

/-- The positive regularizing scale used in the rational cutoff. -/
def widthTwoCollarScale (n : ℕ) : ℝ :=
  1 / ((n : ℝ) + 1)

theorem widthTwoCollarScale_pos (n : ℕ) :
    0 < widthTwoCollarScale n := by
  simp only [widthTwoCollarScale]
  positivity

theorem widthTwoCollarScale_tendsto_zero :
    Tendsto widthTwoCollarScale atTop (𝓝 (0 : ℝ)) := by
  change Tendsto (fun n : ℕ => (1 : ℝ) / (n + 1))
    atTop (𝓝 (0 : ℝ))
  exact tendsto_one_div_add_atTop_nhds_zero_nat

/-- A globally smooth cutoff supported in `(0,2)`.  The positive summand in
the denominator avoids any division-by-zero seam at the endpoints. -/
def widthTwoCollarCutoff (n : ℕ) (x : ℝ) : ℝ :=
  widthTwoCollarBump x /
    (widthTwoCollarBump x + widthTwoCollarScale n)

theorem widthTwoCollarCutoff_denominator_pos (n : ℕ) (x : ℝ) :
    0 < widthTwoCollarBump x + widthTwoCollarScale n :=
  add_pos_of_nonneg_of_pos widthTwoCollarBump.nonneg
    (widthTwoCollarScale_pos n)

theorem widthTwoCollarCutoff_contDiff (n : ℕ) :
    ContDiff ℝ ∞ (widthTwoCollarCutoff n) := by
  change ContDiff ℝ ∞
    (fun x : ℝ => widthTwoCollarBump x /
      (widthTwoCollarBump x + widthTwoCollarScale n))
  exact widthTwoCollarBump.contDiff.div
    (widthTwoCollarBump.contDiff.add contDiff_const)
    (fun x => (widthTwoCollarCutoff_denominator_pos n x).ne')

theorem widthTwoCollarCutoff_nonneg (n : ℕ) (x : ℝ) :
    0 ≤ widthTwoCollarCutoff n x := by
  exact div_nonneg widthTwoCollarBump.nonneg
    (widthTwoCollarCutoff_denominator_pos n x).le

theorem widthTwoCollarCutoff_le_one (n : ℕ) (x : ℝ) :
    widthTwoCollarCutoff n x ≤ 1 := by
  exact
    (div_le_one (widthTwoCollarCutoff_denominator_pos n x)).2
      (le_add_of_nonneg_right (widthTwoCollarScale_pos n).le)

/-- Each cutoff has ordinary support contained in the open parameter
interval. -/
theorem widthTwoCollarCutoff_support_subset (n : ℕ) :
    Function.support (widthTwoCollarCutoff n) ⊆
      Set.Ioo (0 : ℝ) 2 := by
  intro x hx
  have hbump : widthTwoCollarBump x ≠ 0 := by
    intro hbump
    apply Function.mem_support.mp hx
    simp only [widthTwoCollarCutoff, hbump, zero_div]
  have hxSupport :
      x ∈ Function.support (widthTwoCollarBump : ℝ → ℝ) :=
    Function.mem_support.mpr hbump
  rwa [widthTwoCollarBump_support] at hxSupport

/-- At each interior point the smooth collar cutoff tends to one. -/
theorem widthTwoCollarCutoff_tendsto_one
    {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 2) :
    Tendsto (fun n : ℕ => widthTwoCollarCutoff n x)
      atTop (𝓝 (1 : ℝ)) := by
  have hbump : 0 < widthTwoCollarBump x :=
    widthTwoCollarBump_pos_of_mem_Ioo hx
  have hnum :
      Tendsto (fun _ : ℕ => widthTwoCollarBump x) atTop
        (𝓝 (widthTwoCollarBump x)) :=
    tendsto_const_nhds
  have hden :
      Tendsto
        (fun n : ℕ => widthTwoCollarBump x + widthTwoCollarScale n)
        atTop (𝓝 (widthTwoCollarBump x + 0)) :=
    tendsto_const_nhds.add widthTwoCollarScale_tendsto_zero
  have hquot := hnum.div hden (by simpa using hbump.ne')
  change Tendsto
    (fun n : ℕ => widthTwoCollarBump x /
      (widthTwoCollarBump x + widthTwoCollarScale n))
    atTop
    (𝓝 (widthTwoCollarBump x / (widthTwoCollarBump x + 0))) at hquot
  simpa only [widthTwoCollarCutoff, add_zero,
    div_self hbump.ne'] using hquot

/-! ## 3. Complex-valued interior approximants -/

/-- Multiply a complex-valued representative by the real collar cutoff. -/
def widthTwoCollarApprox (n : ℕ) (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  (widthTwoCollarCutoff n x : ℂ) * f x

theorem widthTwoCollarApprox_contDiff
    (n : ℕ) {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f) :
    ContDiff ℝ ∞ (widthTwoCollarApprox n f) := by
  exact
    (Complex.ofRealCLM.contDiff.comp
      (widthTwoCollarCutoff_contDiff n)).mul hf

theorem widthTwoCollarApprox_hasCompactSupport
    (n : ℕ) {f : ℝ → ℂ} (hf : HasCompactSupport f) :
    HasCompactSupport (widthTwoCollarApprox n f) := by
  change HasCompactSupport
    ((fun x : ℝ => (widthTwoCollarCutoff n x : ℂ)) * f)
  exact hf.mul_left

theorem widthTwoCollarApprox_support_subset
    (n : ℕ) (f : ℝ → ℂ) :
    Function.support (widthTwoCollarApprox n f) ⊆
      Set.Ioo (0 : ℝ) 2 := by
  intro x hx
  have hcutoff : widthTwoCollarCutoff n x ≠ 0 := by
    intro hzero
    apply Function.mem_support.mp hx
    simp only [widthTwoCollarApprox, hzero, Complex.ofReal_zero,
      zero_mul]
  exact widthTwoCollarCutoff_support_subset n
    (Function.mem_support.mpr hcutoff)

theorem widthTwoCollarApprox_norm_le
    (n : ℕ) (f : ℝ → ℂ) (x : ℝ) :
    ‖widthTwoCollarApprox n f x‖ ≤ ‖f x‖ := by
  have hmul := mul_le_mul_of_nonneg_right
    (widthTwoCollarCutoff_le_one n x) (norm_nonneg (f x))
  simpa only [widthTwoCollarApprox, norm_mul, Complex.norm_real,
    Real.norm_eq_abs,
    abs_of_nonneg (widthTwoCollarCutoff_nonneg n x), one_mul] using hmul

/-- Pointwise convergence of the complex-valued approximants at every
interior point. -/
theorem widthTwoCollarApprox_tendsto
    (f : ℝ → ℂ) {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 2) :
    Tendsto (fun n : ℕ => widthTwoCollarApprox n f x)
      atTop (𝓝 (f x)) := by
  have hreal := widthTwoCollarCutoff_tendsto_one hx
  have hcomplex :
      Tendsto (fun n : ℕ => (widthTwoCollarCutoff n x : ℂ))
        atTop (𝓝 (1 : ℂ)) := by
    change Tendsto
      (Complex.ofRealCLM ∘ fun n : ℕ => widthTwoCollarCutoff n x)
      atTop (𝓝 (1 : ℂ))
    exact
      (Complex.ofRealCLM.continuous.tendsto (1 : ℝ)).comp hreal
  simpa only [widthTwoCollarApprox, one_mul] using
    hcomplex.mul_const (f x)

/-! ## 4. Almost-everywhere and `L2` convergence -/

/-- The endpoints have zero Lebesgue measure, so the restricted parameter
measure is concentrated on the open interval. -/
theorem actualFixedPhaseWidthTwoParameter_ae_mem_Ioo :
    ∀ᵐ x ∂QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure,
      x ∈ Set.Ioo (0 : ℝ) 2 := by
  change ∀ᵐ x ∂(volume : Measure ℝ).restrict (Set.Icc (0 : ℝ) 2),
    x ∈ Set.Ioo (0 : ℝ) 2
  rw [← restrict_Ioo_eq_restrict_Icc]
  exact ae_restrict_mem measurableSet_Ioo

theorem widthTwoCollarApprox_ae_tendsto (f : ℝ → ℂ) :
    ∀ᵐ x ∂QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure,
      Tendsto (fun n : ℕ => widthTwoCollarApprox n f x)
        atTop (𝓝 (f x)) := by
  filter_upwards [actualFixedPhaseWidthTwoParameter_ae_mem_Ioo] with x hx
  exact widthTwoCollarApprox_tendsto f hx

/-- The approximating family is uniformly integrable because every member is
pointwise norm-dominated by the single target function. -/
theorem widthTwoCollarApprox_unifIntegrable
    (f : ℝ → ℂ)
    (hf : MemLp f 2 QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure) :
    UnifIntegrable (fun n : ℕ => widthTwoCollarApprox n f) 2
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure := by
  intro epsilon hepsilon
  obtain ⟨delta, hdelta, hsmall⟩ :=
    hf.eLpNorm_indicator_le (by norm_num) (by norm_num) hepsilon
  refine ⟨delta, hdelta, ?_⟩
  intro n s hs hmeasure
  refine (eLpNorm_mono (fun x => ?_)).trans (hsmall s hs hmeasure)
  by_cases hxs : x ∈ s
  · simpa only [Set.indicator_of_mem hxs] using
      widthTwoCollarApprox_norm_le n f x
  · simp only [Set.indicator_of_notMem hxs, norm_zero]
    exact le_rfl

/-- Dominated almost-everywhere convergence upgraded to convergence in the
`L2` seminorm. -/
theorem widthTwoCollarApprox_tendsto_eLpNorm
    {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f)
    (hcompact : HasCompactSupport f) :
    Tendsto
      (fun n : ℕ => eLpNorm (widthTwoCollarApprox n f - f) 2
        QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)
      atTop (𝓝 0) := by
  have hfLp : MemLp f 2 QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure :=
    hf.continuous.memLp_of_hasCompactSupport hcompact
  exact tendsto_Lp_finite_of_tendsto_ae
    (by norm_num) (by norm_num)
    (fun n =>
      (widthTwoCollarApprox_contDiff n hf).continuous.aestronglyMeasurable)
    hfLp (widthTwoCollarApprox_unifIntegrable f hfLp)
    (widthTwoCollarApprox_ae_tendsto f)

theorem widthTwoCollarApprox_memLp
    (n : ℕ) {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f)
    (hcompact : HasCompactSupport f) :
    MemLp (widthTwoCollarApprox n f) 2
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure :=
  (widthTwoCollarApprox_contDiff n hf).continuous.memLp_of_hasCompactSupport
    (widthTwoCollarApprox_hasCompactSupport n hcompact)

/-! ## 5. Closure of the broad core and unconditional density -/

/-- Every member of Mathlib's broad smooth compact core is a limit of the
interior smooth core. -/
theorem widthTwoCompactSmoothL2Core_subset_closure_interior :
    QYM.FullCertification.P2HhalfDensityExtension.WidthTwoCompactSmoothL2Core ⊆
      closure QYM.FullCertification.P2HhalfDensityExtension.WidthTwoInteriorSmoothL2Core := by
  intro u hu
  rcases hu with ⟨f, huf, hcompact, hf⟩
  have hfLp : MemLp f 2 QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure :=
    hf.continuous.memLp_of_hasCompactSupport hcompact
  let approxLp : ℕ → QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2 := fun n =>
    (widthTwoCollarApprox_memLp n hf hcompact).toLp
      (widthTwoCollarApprox n f)
  have happroxTendstoTarget :
      Tendsto approxLp atTop (𝓝 (hfLp.toLp f)) := by
    apply (Lp.tendsto_Lp_iff_tendsto_eLpNorm''
      (fun n : ℕ => widthTwoCollarApprox n f)
      (fun n => widthTwoCollarApprox_memLp n hf hcompact)
      f hfLp).2
    exact widthTwoCollarApprox_tendsto_eLpNorm hf hcompact
  have huEq : u = hfLp.toLp f := by
    apply Lp.ext
    exact huf.trans hfLp.coeFn_toLp.symm
  have happroxTendsto : Tendsto approxLp atTop (𝓝 u) := by
    simpa only [huEq] using happroxTendstoTarget
  apply mem_closure_of_tendsto happroxTendsto
  filter_upwards [] with n
  refine ⟨widthTwoCollarApprox n f, ?_, ?_, ?_, ?_⟩
  · exact (widthTwoCollarApprox_memLp n hf hcompact).coeFn_toLp
  · exact widthTwoCollarApprox_hasCompactSupport n hcompact
  · exact widthTwoCollarApprox_contDiff n hf
  · exact widthTwoCollarApprox_support_subset n f

/-- The interior smooth core is unconditionally dense in the literal
width-two `L2` carrier. -/
theorem widthTwoInteriorSmoothL2Core_dense :
    Dense QYM.FullCertification.P2HhalfDensityExtension.WidthTwoInteriorSmoothL2Core := by
  intro u
  have huBroad : u ∈ closure QYM.FullCertification.P2HhalfDensityExtension.WidthTwoCompactSmoothL2Core :=
    QYM.FullCertification.P2HhalfDensityExtension.widthTwoCompactSmoothL2Core_dense u
  exact
    (closure_minimal widthTwoCompactSmoothL2Core_subset_closure_interior
      isClosed_closure) huBroad

/-- Inhabitant of the exact residual proposition isolated by the preceding
density module. -/
theorem widthTwoInteriorSmoothL2CoreDense :
    QYM.FullCertification.P2HhalfDensityExtension.WidthTwoInteriorSmoothL2CoreDense :=
  widthTwoInteriorSmoothL2Core_dense

/-- The actual inverse-eta width-two fractional finite-energy domain is now
dense without any remaining density premise. -/
theorem actualFixedPhase_widthTwoHhalfFiniteEnergyDomainDense
    (n : ℤ)
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp)
    (Y : ℝ) :
    QYM.FullCertification.P2HhalfClosabilityExtension.WidthTwoHhalfFiniteEnergyDomainDense
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspBoundaryTransition n kappa Y) :=
  QYM.FullCertification.P2HhalfDensityExtension.actualFixedPhase_widthTwoHhalfFiniteEnergyDomainDense_of_interiorSmoothCoreDense
    widthTwoInteriorSmoothL2CoreDense n kappa Y

end QYM.FullCertification.P2HhalfCollarDensityExtension

