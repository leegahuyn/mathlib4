/-!
# Finiteness of the compact self-adjoint point spectrum away from zero

This module closes the one compact-spectral supplier which was left explicit in
`CompactSelfAdjointGapExtension`.  The proof is elementary and quantitative:

* an `ε`-separated subset of a totally bounded metric set is finite;
* for every point eigenvalue we choose and normalize one eigenvector;
* eigenvectors belonging to distinct eigenvalues of a symmetric operator are orthogonal;
* if both eigenvalues have norm at least `r`, then the images of their unit eigenvectors are
  pairwise at distance at least `r`;
* compactness puts all those images in a single totally bounded set.

No enumeration of the spectrum and no finiteness premise about the point spectrum is used.
The final section injects the constructed theorem into the genuine unbounded negative-resolvent
gap theorem, thereby removing the former `AwayFromZeroPointSpectrumFinite` premise.
-/

open Module End Set

namespace QYM.CompactSelfAdjointAwayFromZeroExtension

/-! ## A metric packing lemma -/

section MetricPacking

variable {X : Type*} [PseudoMetricSpace X]

/-- An `ε`-separated subset of a totally bounded pseudometric space is finite.  The proof chooses
one center from a finite open-ball cover of radius `ε / 2`; two distinct separated points cannot
choose the same center. -/
theorem finite_of_totallyBounded_of_pairwise_le_dist
    {s : Set X} (htot : TotallyBounded s) {ε : ℝ} (hε : 0 < ε)
    (hsep : s.Pairwise fun x y => ε ≤ dist x y) :
    s.Finite := by
  classical
  obtain ⟨t, htfinite, hcover⟩ :=
    (Metric.totallyBounded_iff.mp htot) (ε / 2) (half_pos hε)
  have hcenterExists :
      ∀ x : s, ∃ y : t, (x : X) ∈ Metric.ball (y : X) (ε / 2) := by
    intro x
    have hxcover := hcover x.property
    rcases Set.mem_iUnion.mp hxcover with ⟨y, hy⟩
    rcases Set.mem_iUnion.mp hy with ⟨hyt, hxy⟩
    exact ⟨⟨y, hyt⟩, hxy⟩
  let center : s → t := fun x => Classical.choose (hcenterExists x)
  have hcenter_close (x : s) :
      dist (x : X) (center x : X) < ε / 2 :=
    Metric.mem_ball.mp (Classical.choose_spec (hcenterExists x))
  have hcenter_injective : Function.Injective center := by
    intro x y hcenter
    apply Subtype.ext
    by_contra hxy
    have hsep_xy : ε ≤ dist (x : X) (y : X) :=
      hsep x.property y.property hxy
    have hdist_lt : dist (x : X) (y : X) < ε := by
      calc
        dist (x : X) (y : X) ≤
            dist (x : X) (center x : X) + dist (y : X) (center x : X) :=
          dist_triangle_right _ _ _
        _ = dist (x : X) (center x : X) + dist (y : X) (center y : X) := by
          rw [hcenter]
        _ < ε / 2 + ε / 2 :=
          add_lt_add (hcenter_close x) (hcenter_close y)
        _ = ε := by ring
    exact (not_lt_of_ge hsep_xy) hdist_lt
  letI : Finite t := Set.finite_coe_iff.mpr htfinite
  letI : Finite s := Finite.of_injective center hcenter_injective
  exact Set.finite_coe_iff.mp inferInstance

/-- Relative form: a separated subset of a totally bounded ambient set is finite. -/
theorem finite_of_subset_totallyBounded_of_pairwise_le_dist
    {s K : Set X} (hsub : s ⊆ K) (hK : TotallyBounded K)
    {ε : ℝ} (hε : 0 < ε)
    (hsep : s.Pairwise fun x y => ε ≤ dist x y) :
    s.Finite :=
  finite_of_totallyBounded_of_pairwise_le_dist
    (TotallyBounded.subset hsub hK) hε hsep

end MetricPacking

/-! ## Canonical choices of unit point eigenvectors -/

section UnitEigenvectors

variable {𝕜 E : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

local instance instRealNormedSpaceE : NormedSpace ℝ E :=
  NormedSpace.restrictScalars ℝ 𝕜 E

local instance instRealScalarTowerE : IsScalarTower ℝ 𝕜 E :=
  RestrictScalars.isScalarTower _ _ _

/-- The subtype of point eigenvalues of a bounded operator. -/
abbrev PointEigenvalue (T : E →L[𝕜] E) :=
  {μ : 𝕜 // HasEigenvalue (T : Module.End 𝕜 E) μ}

/-- A chosen nonzero eigenvector at a point eigenvalue. -/
noncomputable def chosenEigenvector (T : E →L[𝕜] E) (μ : PointEigenvalue T) : E :=
  Classical.choose μ.property.exists_hasEigenvector

theorem chosenEigenvector_hasEigenvector
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    HasEigenvector (T : Module.End 𝕜 E) (μ : 𝕜) (chosenEigenvector T μ) :=
  Classical.choose_spec μ.property.exists_hasEigenvector

theorem chosenEigenvector_ne_zero
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    chosenEigenvector T μ ≠ 0 :=
  (chosenEigenvector_hasEigenvector T μ).2

/-- Normalize the chosen eigenvector.  `NormedSpace.normalize` uses the underlying real scalar
action; `RCLike.real_smul_eq_coe_smul` identifies it with scalar multiplication by `𝕜`. -/
noncomputable def unitEigenvector (T : E →L[𝕜] E) (μ : PointEigenvalue T) : E :=
  NormedSpace.normalize (chosenEigenvector T μ)

theorem unitEigenvector_norm
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    ‖unitEigenvector T μ‖ = 1 := by
  exact NormedSpace.norm_normalize (chosenEigenvector_ne_zero T μ)

theorem unitEigenvector_ne_zero
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    unitEigenvector T μ ≠ 0 := by
  intro h
  have hnorm := unitEigenvector_norm T μ
  rw [h, norm_zero] at hnorm
  norm_num at hnorm

theorem unitEigenvector_eq_coe_inv_norm_smul
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    unitEigenvector T μ =
      ((‖chosenEigenvector T μ‖⁻¹ : ℝ) : 𝕜) • chosenEigenvector T μ := by
  change (‖chosenEigenvector T μ‖⁻¹ : ℝ) • chosenEigenvector T μ =
    ((‖chosenEigenvector T μ‖⁻¹ : ℝ) : 𝕜) • chosenEigenvector T μ
  exact RCLike.real_smul_eq_coe_smul (K := 𝕜)
    (‖chosenEigenvector T μ‖⁻¹ : ℝ) (chosenEigenvector T μ)

theorem unitEigenvector_apply_eq_smul
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    T (unitEigenvector T μ) = (μ : 𝕜) • unitEigenvector T μ := by
  let a : 𝕜 := ((‖chosenEigenvector T μ‖⁻¹ : ℝ) : 𝕜)
  have hunit : unitEigenvector T μ = a • chosenEigenvector T μ := by
    simpa only [a] using unitEigenvector_eq_coe_inv_norm_smul T μ
  calc
    T (unitEigenvector T μ) = T (a • chosenEigenvector T μ) :=
      congrArg T hunit
    _ = a • T (chosenEigenvector T μ) := by rw [map_smul]
    _ = a • ((μ : 𝕜) • chosenEigenvector T μ) := by
      exact congrArg (fun y : E => a • y)
        (chosenEigenvector_hasEigenvector T μ).apply_eq_smul
    _ = (a * (μ : 𝕜)) • chosenEigenvector T μ := by rw [smul_smul]
    _ = ((μ : 𝕜) * a) • chosenEigenvector T μ := by rw [mul_comm]
    _ = (μ : 𝕜) • (a • chosenEigenvector T μ) := by rw [smul_smul]
    _ = (μ : 𝕜) • unitEigenvector T μ := by rw [← hunit]

theorem unitEigenvector_hasEigenvector
    (T : E →L[𝕜] E) (μ : PointEigenvalue T) :
    HasEigenvector (T : Module.End 𝕜 E) (μ : 𝕜) (unitEigenvector T μ) := by
  exact ⟨mem_eigenspace_iff.mpr (unitEigenvector_apply_eq_smul T μ),
    unitEigenvector_ne_zero T μ⟩

/-- Unit eigenvectors for distinct eigenvalues are orthogonal. -/
theorem unitEigenvector_inner_eq_zero
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {μ ν : PointEigenvalue T} (hμν : (μ : 𝕜) ≠ (ν : 𝕜)) :
    inner 𝕜 (unitEigenvector T μ) (unitEigenvector T ν) = 0 := by
  exact inner_eq_zero_symm.mpr
    (hsymm.orthogonalFamily_eigenspaces.pairwise hμν
      (unitEigenvector_hasEigenvector T μ).1
      (unitEigenvector T ν) (unitEigenvector_hasEigenvector T ν).1)

/-! ## Quantitative separation of compact images -/

/-- Images of unit eigenvectors at distinct eigenvalues whose norms are at least `r` are separated
by distance at least `r`.  Pythagoras is used after orthogonality; no upper operator-norm estimate
is involved. -/
theorem image_unitEigenvectors_dist_ge
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {μ ν : PointEigenvalue T} (hμν : (μ : 𝕜) ≠ (ν : 𝕜))
    {r : ℝ} (hr : 0 ≤ r)
    (hμr : r ≤ ‖(μ : 𝕜)‖) (hνr : r ≤ ‖(ν : 𝕜)‖) :
    r ≤ dist (T (unitEigenvector T μ)) (T (unitEigenvector T ν)) := by
  have hμapply := unitEigenvector_apply_eq_smul T μ
  have hνapply := unitEigenvector_apply_eq_smul T ν
  have hinnerUnit :
      inner 𝕜 (unitEigenvector T μ) (unitEigenvector T ν) = 0 :=
    unitEigenvector_inner_eq_zero hsymm hμν
  have hinnerImage :
      inner 𝕜 (T (unitEigenvector T μ)) (T (unitEigenvector T ν)) = 0 := by
    rw [hμapply, hνapply, inner_smul_left, inner_smul_right, hinnerUnit]
    simp
  have hnormμ : ‖T (unitEigenvector T μ)‖ = ‖(μ : 𝕜)‖ := by
    rw [hμapply, norm_smul, unitEigenvector_norm, mul_one]
  have hnormν : ‖T (unitEigenvector T ν)‖ = ‖(ν : 𝕜)‖ := by
    rw [hνapply, norm_smul, unitEigenvector_norm, mul_one]
  have hμr' : r ≤ ‖T (unitEigenvector T μ)‖ := by
    rw [hnormμ]
    exact hμr
  have hνr' : r ≤ ‖T (unitEigenvector T ν)‖ := by
    rw [hnormν]
    exact hνr
  have hpythagoras :
      ‖T (unitEigenvector T μ) - T (unitEigenvector T ν)‖ ^ 2 =
        ‖T (unitEigenvector T μ)‖ ^ 2 + ‖T (unitEigenvector T ν)‖ ^ 2 := by
    rw [norm_sub_sq (𝕜 := 𝕜), hinnerImage]
    simp
  have hμsq :
      r ^ 2 ≤ ‖T (unitEigenvector T μ)‖ ^ 2 :=
    (sq_le_sq₀ hr (norm_nonneg _)).2 hμr'
  have hνsq :
      r ^ 2 ≤ ‖T (unitEigenvector T ν)‖ ^ 2 :=
    (sq_le_sq₀ hr (norm_nonneg _)).2 hνr'
  have hdistSq :
      r ^ 2 ≤ ‖T (unitEigenvector T μ) - T (unitEigenvector T ν)‖ ^ 2 := by
    rw [hpythagoras]
    exact
      (le_add_of_nonneg_right (sq_nonneg r)).trans
        (add_le_add hμsq hνsq)
  rw [dist_eq_norm]
  exact (sq_le_sq₀ hr (norm_nonneg _)).1 hdistSq

end UnitEigenvectors

/-! ## Finiteness of the compact symmetric point spectrum away from zero -/

section CompactPointSpectrum

variable {𝕜 E : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

/-- The point eigenvalues whose norms are bounded below by `r`. -/
def pointSpectrumAwayFromZero (T : E →L[𝕜] E) (r : ℝ) : Set 𝕜 :=
  {μ : 𝕜 | HasEigenvalue (T : Module.End 𝕜 E) μ ∧ r ≤ ‖μ‖}

/-- A compact symmetric bounded operator has only finitely many point eigenvalues outside every
positive ball about zero.  This is the standard compact-spectrum theorem proved directly from
total boundedness and orthogonality. -/
theorem finite_pointSpectrumAwayFromZero_of_compact_symmetric
    {T : E →L[𝕜] E}
    (hcompact : IsCompactOperator T)
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {r : ℝ} (hr : 0 < r) :
    (pointSpectrumAwayFromZero T r).Finite := by
  classical
  let S := pointSpectrumAwayFromZero T r
  let asPointEigenvalue : S → PointEigenvalue T :=
    fun μ => ⟨(μ : 𝕜), μ.property.1⟩
  let imageVector : S → E :=
    fun μ => T (unitEigenvector T (asPointEigenvalue μ))
  have himage_separated :
      Pairwise fun μ ν : S => r ≤ dist (imageVector μ) (imageVector ν) := by
    intro μ ν hμν
    have hval : (μ : 𝕜) ≠ (ν : 𝕜) := by
      intro h
      exact hμν (Subtype.ext h)
    exact image_unitEigenvectors_dist_ge
      (μ := asPointEigenvalue μ) (ν := asPointEigenvalue ν)
      hsymm hval hr.le μ.property.2 ν.property.2
  obtain ⟨K, hKcompact, hunitImageK⟩ :=
    hcompact.image_closedBall_subset_compact 1
  have himageVectorK : Set.range imageVector ⊆ K := by
    rintro y ⟨μ, rfl⟩
    apply hunitImageK
    refine ⟨unitEigenvector T (asPointEigenvalue μ), ?_, rfl⟩
    simp [Metric.mem_closedBall, unitEigenvector_norm]
  have hrangePairwise :
      (Set.range imageVector).Pairwise fun x y => r ≤ dist x y := by
    rintro x ⟨μ, rfl⟩ y ⟨ν, rfl⟩ hxy
    have hμν : μ ≠ ν := by
      intro h
      subst ν
      exact hxy rfl
    exact himage_separated hμν
  have hrangeFinite : (Set.range imageVector).Finite :=
    finite_of_subset_totallyBounded_of_pairwise_le_dist
      himageVectorK hKcompact.totallyBounded hr hrangePairwise
  have himageVector_injective : Function.Injective imageVector := by
    intro μ ν hμν
    by_contra hne
    have hdist := himage_separated hne
    change r ≤ dist (imageVector μ) (imageVector ν) at hdist
    rw [hμν, dist_self] at hdist
    exact (not_lt_of_ge hdist) hr
  let imageVectorRange : S → Set.range imageVector :=
    fun μ => ⟨imageVector μ, ⟨μ, rfl⟩⟩
  have himageVectorRange_injective : Function.Injective imageVectorRange := by
    intro μ ν hμν
    apply himageVector_injective
    exact congrArg Subtype.val hμν
  letI : Finite (Set.range imageVector) :=
    Set.finite_coe_iff.mpr hrangeFinite
  letI : Finite S :=
    Finite.of_injective imageVectorRange himageVectorRange_injective
  exact Set.finite_coe_iff.mp inferInstance

/-- The preceding theorem in the exact set expression used by
`AwayFromZeroPointSpectrumFinite`. -/
theorem finite_pointSpectrum_away_from_zero_of_compact_symmetric
    {T : E →L[𝕜] E}
    (hcompact : IsCompactOperator T)
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {r : ℝ} (hr : 0 < r) :
    Set.Finite
      {μ : 𝕜 |
        HasEigenvalue (T : Module.End 𝕜 E) μ ∧ r ≤ ‖μ‖} := by
  exact finite_pointSpectrumAwayFromZero_of_compact_symmetric hcompact hsymm hr

/-- Compactness plus symmetry constructs the former supplier structure rather than assuming it. -/
theorem awayFromZeroPointSpectrumFinite_of_compact_symmetric
    {T : E →L[𝕜] E}
    (hcompact : IsCompactOperator T)
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric) :
    QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite T := by
  constructor
  intro r hr
  exact finite_pointSpectrum_away_from_zero_of_compact_symmetric hcompact hsymm hr

/-- Standard self-adjoint specialization. -/
theorem awayFromZeroPointSpectrumFinite_of_compact_selfAdjoint
    [CompleteSpace E]
    {T : E →L[𝕜] E}
    (hcompact : IsCompactOperator T) (hself : IsSelfAdjoint T) :
    QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite T :=
  awayFromZeroPointSpectrumFinite_of_compact_symmetric hcompact hself.isSymmetric

end CompactPointSpectrum

end QYM.CompactSelfAdjointAwayFromZeroExtension

/-! ## Removal of the supplier from the genuine unbounded negative-resolvent theorem -/

namespace QYM.UnboundedCompactSpectralMappingExtension

section ConstructedAwayFromZeroSupplier

variable {𝕜 H : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]

/-- Every compact resolvent inverse of a self-adjoint partial operator at a star-fixed parameter
satisfies away-from-zero point-spectrum finiteness, with no extra spectral premise. -/
theorem resolvent_inverse_awayFromZeroPointSpectrumFinite
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite ρ.inverse := by
  apply
    QYM.CompactSelfAdjointAwayFromZeroExtension.awayFromZeroPointSpectrumFinite_of_compact_selfAdjoint hcompact
  exact resolvent_inverse_isSelfAdjoint ρ hT hz

end ConstructedAwayFromZeroSupplier

section RealNegativeResolventWithoutSupplier

variable {H : Type*} [NormedAddCommGroup H]
variable [InnerProductSpace ℝ H] [CompleteSpace H]

/-- A compact negative resolvent of a self-adjoint genuine partial operator directly yields local
finiteness of its positive point spectrum. -/
theorem positivePointSpectrumLocallyFinite_of_compact_negative_resolvent
    {T : H →ₗ.[ℝ] H} {μ : ℝ} (hμ : 0 < μ)
    (hT : IsSelfAdjoint T)
    (ρ : ResolventData T (-μ)) (hcompact : ρ.IsCompactResolvent) :
    PositivePointSpectrumLocallyFinite T := by
  apply positivePointSpectrumLocallyFinite_of_negative_resolvent hμ ρ
  exact resolvent_inverse_awayFromZeroPointSpectrumFinite ρ hT (by simp) hcompact

/-- Unconditional standard functional-analysis form of the multiplicity-safe least-gap theorem:
the away-from-zero compact-spectrum fact is now proved internally from compactness and
self-adjointness. -/
theorem exists_multiplicitySafe_least_offGround_level_of_compact_negative_resolvent
    {T : H →ₗ.[ℝ] H} {μ c : ℝ}
    (hμ : 0 < μ) (hc : 0 < c)
    (hT : IsSelfAdjoint T)
    (ρ : ResolventData T (-μ))
    (hcompact : ρ.IsCompactResolvent)
    (hcoercive : HasGroundComplementCoercivity T c)
    (hzero : HasPMapEigenvalue T 0)
    (hnonzero : ∃ lambda : ℝ, lambda ≠ 0 ∧ HasPMapEigenvalue T lambda) :
    ∃ gap : ℝ,
      HasPMapEigenvalue T 0 ∧
      FiniteDimensional ℝ (operatorEigenspace T 0) ∧
      c ≤ gap ∧
      0 < gap ∧
      HasPMapEigenvalue T gap ∧
      FiniteDimensional ℝ (operatorEigenspace T gap) ∧
      ∀ lambda : ℝ, lambda ≠ 0 → HasPMapEigenvalue T lambda → gap ≤ lambda := by
  apply exists_multiplicitySafe_least_offGround_level
    hμ hc hT ρ hcompact
  · exact resolvent_inverse_awayFromZeroPointSpectrumFinite ρ hT (by simp) hcompact
  · exact hcoercive
  · exact hzero
  · exact hnonzero

end RealNegativeResolventWithoutSupplier

end QYM.UnboundedCompactSpectralMappingExtension

/-!
# Paper-normalized wrappers for compact point-spectrum finiteness

These statements expose the newly constructed compact-spectrum theorem in the numbering and
logical shape used by the paper.  In particular, the Appendix A.7 and Corollary 4.25 wrappers no
longer receive an `AwayFromZeroPointSpectrumFinite` hypothesis: that fact is proved from compactness
and self-adjointness.  The least-level conclusions are corrected, multiplicity-safe replacements
or operator-level prerequisites; they are not advertised as verbatim proofs of any invalid
adjacent-index or liminf inference in the paper.
-/

open Module End Set

namespace QYM.FullCertification.PaperNormalized

/-! ## Standard compact self-adjoint ingredient used by Theorem A.7 -/

def theoremA_7_compactSelfAdjointPointSpectrumAwayFromZeroFinitePrerequisiteStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →L[𝕜] E),
    IsCompactOperator T →
    IsSelfAdjoint T →
    ∀ r : ℝ, 0 < r →
      Set.Finite
        {μ : 𝕜 |
          HasEigenvalue (T : Module.End 𝕜 E) μ ∧ r ≤ ‖μ‖}

theorem theoremA_7_compactSelfAdjointPointSpectrumAwayFromZeroFinitePrerequisiteStatement_holds :
    theoremA_7_compactSelfAdjointPointSpectrumAwayFromZeroFinitePrerequisiteStatement := by
  intro 𝕜 E _ _ _ _ T hcompact hself r hr
  exact
    QYM.CompactSelfAdjointAwayFromZeroExtension.finite_pointSpectrum_away_from_zero_of_compact_symmetric
        hcompact hself.isSymmetric hr

def theoremA_7_compactSelfAdjointAwayFromZeroSupplierConstructedStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →L[𝕜] E),
    IsCompactOperator T →
    IsSelfAdjoint T →
      QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite T

theorem theoremA_7_compactSelfAdjointAwayFromZeroSupplierConstructedStatement_holds :
    theoremA_7_compactSelfAdjointAwayFromZeroSupplierConstructedStatement := by
  intro 𝕜 E _ _ _ _ T hcompact hself
  exact
    QYM.CompactSelfAdjointAwayFromZeroExtension.awayFromZeroPointSpectrumFinite_of_compact_selfAdjoint hcompact hself

/-! ## Appendix Theorem A.7: corrected multiplicity-safe replacement without that supplier -/

def theoremA_7_negativeResolventLocalFinitenessWithoutSupplierStatement : Prop :=
  ∀ (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (T : H →ₗ.[ℝ] H) (μ : ℝ)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T (-μ)),
    0 < μ →
    IsSelfAdjoint T →
    ρ.IsCompactResolvent →
      QYM.UnboundedCompactSpectralMappingExtension.PositivePointSpectrumLocallyFinite T

theorem theoremA_7_negativeResolventLocalFinitenessWithoutSupplierStatement_holds :
    theoremA_7_negativeResolventLocalFinitenessWithoutSupplierStatement := by
  intro H _ _ _ T μ ρ hμ hT hcompact
  exact
    QYM.UnboundedCompactSpectralMappingExtension.positivePointSpectrumLocallyFinite_of_compact_negative_resolvent
        hμ hT ρ hcompact

def theoremA_7_unboundedMultiplicitySafeLeastGapWithoutSupplierStatement : Prop :=
  ∀ (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (T : H →ₗ.[ℝ] H) (μ c : ℝ)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T (-μ)),
    0 < μ →
    0 < c →
    IsSelfAdjoint T →
    ρ.IsCompactResolvent →
    QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c →
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T 0 →
    (∃ lambda : ℝ,
      lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda) →
      ∃ gap : ℝ,
        QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T 0 ∧
        FiniteDimensional ℝ
          (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T 0) ∧
        c ≤ gap ∧
        0 < gap ∧
        QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T gap ∧
        FiniteDimensional ℝ
          (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T gap) ∧
        ∀ lambda : ℝ,
          lambda ≠ 0 →
          QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda →
          gap ≤ lambda

theorem theoremA_7_unboundedMultiplicitySafeLeastGapWithoutSupplierStatement_holds :
    theoremA_7_unboundedMultiplicitySafeLeastGapWithoutSupplierStatement := by
  intro H _ _ _ T μ c ρ hμ hc hT hcompact hcoercive hzero hnonzero
  exact
    QYM.UnboundedCompactSpectralMappingExtension.exists_multiplicitySafe_least_offGround_level_of_compact_negative_resolvent
        hμ hc hT ρ hcompact hcoercive hzero hnonzero

/-! ## Corollary 4.25: operator-level pointwise prerequisite without that supplier -/

def cor4_25_unboundedUniformMultiplicitySafeGapWithoutSupplierStatement : Prop :=
  ∀ (Y H : Type*)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (T : Y → H →ₗ.[ℝ] H) (μ : Y → ℝ) (c : ℝ)
      (ρ : ∀ y : Y,
        QYM.UnboundedResolventDataExtension.ResolventData (T y) (-(μ y))),
    (∀ y, 0 < μ y) →
    0 < c →
    (∀ y, IsSelfAdjoint (T y)) →
    (∀ y, (ρ y).IsCompactResolvent) →
    (∀ y,
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity
        (T y) c) →
    (∀ y,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T y) 0) →
    (∀ y, ∃ lambda : ℝ,
      lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T y) lambda) →
      ∀ y : Y, ∃ gap : ℝ,
        FiniteDimensional ℝ
          (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace (T y) 0) ∧
        c ≤ gap ∧
        0 < gap ∧
        QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T y) gap ∧
        FiniteDimensional ℝ
          (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace (T y) gap) ∧
        ∀ lambda : ℝ,
          lambda ≠ 0 →
          QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T y) lambda →
          gap ≤ lambda

theorem cor4_25_unboundedUniformMultiplicitySafeGapWithoutSupplierStatement_holds :
    cor4_25_unboundedUniformMultiplicitySafeGapWithoutSupplierStatement := by
  intro Y H _ _ _ T μ c ρ hμ hc hT hcompact hcoercive hzero hnonzero y
  obtain ⟨gap, _, hgroundFinite, hgapLower, hgappos, hgapEigen, hgapFinite, hleast⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.exists_multiplicitySafe_least_offGround_level_of_compact_negative_resolvent
        (hμ y) hc (hT y) (ρ y) (hcompact y) (hcoercive y)
        (hzero y) (hnonzero y)
  exact
    ⟨gap, hgroundFinite, hgapLower, hgappos, hgapEigen, hgapFinite, hleast⟩

