namespace QYM.FullCertification.P4ActualStageContinuousDensityExtension






















/-!
# P4: an unconditional dense continuous core on the actual compact stage

The smooth half-space atlas of the stage boundary is deliberately not assumed
here.  What follows is the strongest unconditional density result available
from the topology and measure already constructed:

* the open orbit quotient is second countable;
* its compact stage subtype is compact Hausdorff, metrizable and Borel;
* the canonical finite stage measure is weakly regular; and
* continuous eta-coordinate sections have dense image in the actual stage
  `L²` section Hilbert space.

The final `L²` fibre-value theorem uses almost-everywhere equality, as it must:
an `L²` element has no canonical pointwise representative.
-/

/-! ## 1. Countability and regularity of the concrete quotient stage -/

/-- The literal orbit quotient is second countable because it is the image of
the second-countable upper half-plane under an open quotient map. -/
noncomputable instance gammaTwoQuotient_secondCountableTopology :
    SecondCountableTopology Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.isQuotientMap.secondCountableTopology
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap

/-- The actual finite stage measure is weakly regular.  This is inferred from
the now-metrizable compact Borel stage and its proved finite mass. -/
noncomputable instance actualStageMeasure_weaklyRegular (Y : ℝ) :
    (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y).WeaklyRegular := by
  infer_instance

/-! ## 2. Relative interior density and full support at paper-range cutoffs -/

/-- The strict part of the retained one-sided height interval. -/
def actualStageStrictHeightBand (Y : ℝ) :
    Set (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y) :=
  {h | (h : ℝ) < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y}

/-- After forgetting the subtype, the strict part of the one-sided height
band is the ordinary open interval below the retained endpoint. -/
theorem image_actualStageStrictHeightBand (Y : ℝ) :
    ((fun h : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y => (h : ℝ)) ''
        actualStageStrictHeightBand Y) =
      Set.Ioo
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y - QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) := by
  ext h
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u.2.1, hu⟩
  · intro hh
    let u : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y := ⟨h, hh.1, hh.2.le⟩
    exact ⟨u, hh.2, rfl⟩

/-- The retained endpoint is approached from strictly smaller heights inside
the actual one-sided interval. -/
theorem stageBoundaryHeight_mem_closure_strictHeightBand (Y : ℝ) :
    QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y ∈ closure (actualStageStrictHeightBand Y) := by
  rw [closure_subtype, image_actualStageStrictHeightBand,
    closure_Ioo
      (ne_of_lt
        (sub_lt_self (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos))]
  exact
    ⟨(sub_lt_self (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos).le,
      le_rfl⟩

/-- Strict interior-height points in the product collar. -/
def actualStageStrictCuspBand (Y : ℝ) : Set (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageCuspBand Y) :=
  {p | (p.2 : ℝ) < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y}

/-- Every point of the retained boundary circle is a limit of points with
strictly smaller height in the product collar. -/
theorem stageBoundaryBandPoint_mem_closure_strictCuspBand
    (Y : ℝ) (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    (theta, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y) ∈
      closure (actualStageStrictCuspBand Y) := by
  let f : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y → QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageCuspBand Y :=
    fun h => (theta, h)
  have hf : Continuous f := continuous_const.prodMk continuous_id
  have hBoundary :
      QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y ∈ closure (actualStageStrictHeightBand Y) :=
    stageBoundaryHeight_mem_closure_strictHeightBand Y
  have hMapped :
      f (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y) ∈
        closure (f '' actualStageStrictHeightBand Y) :=
    (image_closure_subset_closure_image hf)
      ⟨QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y, hBoundary, rfl⟩
  refine closure_mono ?_ hMapped
  rintro _ ⟨h, hh, rfl⟩
  exact hh

/-- The image of each actual collar boundary point is in the ambient closure
of the genuine stage interior. -/
theorem stageBoundaryPoint_mem_closure_interior_XSet
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    (((QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY
        (theta, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) ∈
      closure (interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) := by
  let f : QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageCuspBand Y → Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
    fun p => ((QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY p : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)
  have hf : Continuous f :=
    continuous_subtype_val.comp
      (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap_isOpenEmbedding q hY).continuous
  have hMapped :
      f (theta, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y) ∈
        closure (f '' actualStageStrictCuspBand Y) :=
    (image_closure_subset_closure_image hf)
      ⟨(theta, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y),
        stageBoundaryBandPoint_mem_closure_strictCuspBand Y theta,
        rfl⟩
  refine closure_mono ?_ hMapped
  rintro _ ⟨p, hp, rfl⟩
  change
    ((QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY p : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)
  rw [QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap_coe]
  apply
    (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.cuspBandMap_mem_interior_XSet_iff_height_lt q hY
      (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBandInclusion Y p)).2
  change (p.2 : ℝ) <
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y at hp
  exact hp

/-- At normalized cutoff at least two, the intrinsic compact stage is the
closure of its ambient interior.  The nontrivial boundary case is supplied
by the proved three-cusp frontier decomposition and the explicit one-sided
collars above. -/
theorem XSet_subset_closure_interior_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y ⊆ closure (interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) := by
  intro x hx
  by_cases hxInterior : x ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)
  · exact subset_closure hxInterior
  have hxFrontier : x ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
    (mem_frontier_iff_notMem_interior hx).2 hxInterior
  have hFrontier :
      frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
        ⋃ kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp,
          QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y kappa :=
    QYM.FullCertification.P2ExactThreeBoundaryExtension.frontier_XSet_eq_iUnion_cuspPieces_corrected
      (QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.pairedSidesAwayFromHorocyclesBecomeInterior_of_two_le_level hY)
      (QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.horocyclesRemainBoundary_of_two_le_level hY)
  rw [hFrontier] at hxFrontier
  rcases Set.mem_iUnion.mp hxFrontier with ⟨kappa, hxPiece⟩
  rcases QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.gammaTwoTileCuspClass_surjective kappa with ⟨q, hq⟩
  have hxRange :
      x ∈ Set.range
        (fun theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle =>
          ((QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY
            (theta, QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundaryHeight Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) := by
    rw [QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageBoundarySlice_range_eq_quotientCuspBoundaryPiece q hY]
    simpa only [hq] using hxPiece
  rcases hxRange with ⟨theta, htheta⟩
  have hClosure :=
    stageBoundaryPoint_mem_closure_interior_XSet q hY theta
  exact htheta ▸ hClosure

/-- The actual relative-interior locus inside the stage subtype. -/
def actualStageTopologicalInterior (Y : ℝ) : Set (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :=
  {x | (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)}

/-- The relative-interior locus is dense in the actual stage at every
paper-range cutoff. -/
theorem actualStageTopologicalInterior_dense_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Dense (actualStageTopologicalInterior Y) := by
  have hImage :
      ((fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) ''
          actualStageTopologicalInterior Y) =
        interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
    ext x
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact hz
    · intro hx
      exact ⟨⟨x, interior_subset hx⟩, hx, rfl⟩
  refine Subtype.dense_iff.mpr ?_
  rw [hImage]
  exact XSet_subset_closure_interior_of_two_le_level hY

/-- At normalized cutoff at least two, the canonical comap measure has full
relative support: every nonempty open subset of the actual compact stage has
positive measure. -/
theorem actualStageMeasure_isOpenPos_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Measure.IsOpenPosMeasure (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  refine ⟨fun U hU hUNonempty => ?_⟩
  have hUMeasurable : MeasurableSet U := hU.measurableSet
  rcases
      (actualStageTopologicalInterior_dense_of_two_le_level hY).exists_mem_open
        hU hUNonempty with
    ⟨x, hxInterior, hxU⟩
  rcases isOpen_induced_iff.mp hU with ⟨V, hVOpen, hVU⟩
  have hxV : (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) ∈ V := by
    change x ∈
      (fun z : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (z : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) ⁻¹' V
    rw [hVU]
    exact hxU
  have hxAmbientInterior :
      (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
    hxInterior
  let W : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient := V ∩ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)
  have hWOpen : IsOpen W := hVOpen.inter isOpen_interior
  have hWNonempty : W.Nonempty :=
    ⟨(x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient), hxV, hxAmbientInterior⟩
  have hWSubset :
      W ⊆
        (fun z : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (z : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) '' U := by
    intro z hz
    let zStage : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y := ⟨z, interior_subset hz.2⟩
    refine ⟨zStage, ?_, rfl⟩
    change zStage ∈ U
    rw [← hVU]
    exact hz.1
  have hImageNe :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure
          ((fun z : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (z : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) '' U) ≠ 0 := by
    intro hImageZero
    exact
      (hWOpen.measure_ne_zero QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure hWNonempty)
        (measure_mono_null hWSubset hImageZero)
  have hComap :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y U =
        QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure
          ((fun z : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (z : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) '' U) := by
    unfold QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure
    exact Measure.comap_apply _
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageSubtype_measurableEmbedding Y).injective
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageSubtype_measurableEmbedding Y).measurableSet_image'
      _ hUMeasurable
  rw [hComap]
  exact hImageNe

/-- Instance spelling for downstream arguments that carry the paper-range
cutoff as a `Fact`. -/
noncomputable instance actualStageMeasure_isOpenPos_of_fact
    (Y : ℝ) [hY : Fact (2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)] :
    Measure.IsOpenPosMeasure (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) :=
  actualStageMeasure_isOpenPos_of_two_le_level hY.out

/-- Full support of the concrete finite-stage measure. -/
theorem actualStageMeasure_support_eq_univ_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y).support = Set.univ := by
  letI : Measure.IsOpenPosMeasure (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) :=
    actualStageMeasure_isOpenPos_of_two_le_level hY
  exact Measure.support_eq_univ

/-! ## 3. Continuous eta-coordinate sections and their `L²` realization -/

/-- Continuous eta-coordinate sections of the actual restricted quotient
bundle.  The preceding global trivialization proves that these coordinates
reconstruct literal quotient-fibre values. -/
abbrev ActualStageContinuousInverseEtaSection (Y : ℝ) :=
  C(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, ℂ)

/-- The canonical continuous-linear inclusion into the concrete Petersson
`L²` section space. -/
noncomputable def actualStageContinuousToL2 (Y : ℝ) :
    ActualStageContinuousInverseEtaSection Y →L[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  ContinuousMap.toLp 2 (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) ℂ

/-- A continuous coordinate and its `L²` realization agree almost everywhere. -/
theorem actualStageContinuousToL2_coeFn_ae
    (Y : ℝ) (f : ActualStageContinuousInverseEtaSection Y) :
    ((actualStageContinuousToL2 Y f :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      (f : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) := by
  exact ContinuousMap.coeFn_toLp (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) f

/-- Reconstructing actual quotient-total-space values from the `L²`
realization recovers the literal fibre reconstruction of the continuous
coordinate almost everywhere. -/
theorem actualStageContinuousToL2_bundleValue_ae
    (Y : ℝ) (f : ActualStageContinuousInverseEtaSection Y) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageBundleValue (actualStageContinuousToL2 Y f) x) =ᵐ[
        QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar
          (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageBasePoint x) (f x)) := by
  filter_upwards [actualStageContinuousToL2_coeFn_ae Y f] with x hx
  rw [QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageBundleValue, hx]

/-- The actual fibre coordinate of the reconstructed value is the original
continuous coordinate almost everywhere. -/
theorem actualStageContinuousToL2_fibreCoordinate_ae
    (Y : ℝ) (f : ActualStageContinuousInverseEtaSection Y) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinate
        (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageFibreValue (actualStageContinuousToL2 Y f) x)) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      (f : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) := by
  filter_upwards [actualStageContinuousToL2_coeFn_ae Y f] with x hx
  simpa only [QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageFibreValue_coordinate] using hx

/-! ## 4. Density, injectivity, and the distinguished section -/

/-- Continuous actual bundle sections are dense in the concrete stage
Petersson `L²` space. -/
theorem actualStageContinuousToL2_denseRange (Y : ℝ) :
    DenseRange (actualStageContinuousToL2 Y) := by
  exact ContinuousMap.toLp_denseRange ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) ℂ
    (by norm_num : (2 : ℝ≥0∞) ≠ (∞ : ℝ≥0∞))

/-- Full support makes the continuous-to-`L²` map injective at every
paper-range cutoff.  This is equality of continuous representatives, not a
point-evaluation assertion for arbitrary `L²` classes. -/
theorem actualStageContinuousToL2_injective
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Function.Injective (actualStageContinuousToL2 Y) := by
  letI : Measure.IsOpenPosMeasure (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) :=
    actualStageMeasure_isOpenPos_of_two_le_level hY
  exact ContinuousMap.toLp_injective (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y)

/-- Equality in `L²` detects equality of continuous eta coordinates. -/
theorem actualStageContinuousToL2_inj
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {f g : ActualStageContinuousInverseEtaSection Y} :
    actualStageContinuousToL2 Y f = actualStageContinuousToL2 Y g ↔
      f = g :=
  (actualStageContinuousToL2_injective hY).eq_iff

/-- A continuous eta coordinate maps to zero in `L²` exactly when it is the
zero continuous function. -/
theorem actualStageContinuousToL2_eq_zero_iff
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (f : ActualStageContinuousInverseEtaSection Y) :
    actualStageContinuousToL2 Y f = 0 ↔ f = 0 := by
  simpa only [map_zero] using
    (actualStageContinuousToL2_inj hY
      (f := f) (g := (0 : ActualStageContinuousInverseEtaSection Y)))

/-- The continuous-linear inclusion has trivial kernel. -/
theorem actualStageContinuousToL2_ker_eq_bot
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualStageContinuousToL2 Y).ker = ⊥ :=
  LinearMap.ker_eq_bot.mpr (actualStageContinuousToL2_injective hY)

/-- The concrete continuous `L²` core as a linear subspace of the actual
stage section Hilbert space. -/
noncomputable def ActualStageContinuousL2Core (Y : ℝ) :
    Submodule ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :=
  (actualStageContinuousToL2 Y).range

/-- The same inclusion with its codomain restricted to the continuous core. -/
noncomputable def actualStageContinuousToL2Core (Y : ℝ) :
    ActualStageContinuousInverseEtaSection Y →L[ℂ]
      ActualStageContinuousL2Core Y :=
  (actualStageContinuousToL2 Y).codRestrict
    (ActualStageContinuousL2Core Y) fun f => ⟨f, rfl⟩

@[simp]
theorem actualStageContinuousToL2Core_coe
    (Y : ℝ) (f : ActualStageContinuousInverseEtaSection Y) :
    ((actualStageContinuousToL2Core Y f :
        ActualStageContinuousL2Core Y) :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) =
      actualStageContinuousToL2 Y f :=
  rfl

/-- Codomain restriction to the range is onto, without any measure
positivity assumption. -/
theorem actualStageContinuousToL2Core_surjective (Y : ℝ) :
    Function.Surjective (actualStageContinuousToL2Core Y) := by
  rintro ⟨u, hu⟩
  rcases hu with ⟨f, hf⟩
  refine ⟨f, Subtype.ext ?_⟩
  exact hf

/-- At paper-range cutoffs the restricted continuous-linear map is a
bijection onto the concrete continuous core.  No inverse-continuity claim is
made: the `L²` topology on the range is strictly weaker in the standard
infinite-dimensional situation. -/
theorem actualStageContinuousToL2Core_bijective
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Function.Bijective (actualStageContinuousToL2Core Y) := by
  constructor
  · intro f g hfg
    apply actualStageContinuousToL2_injective hY
    exact congrArg Subtype.val hfg
  · exact actualStageContinuousToL2Core_surjective Y

/-- Membership in the continuous core has the expected explicit witness. -/
theorem mem_ActualStageContinuousL2Core_iff
    {Y : ℝ} (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    u ∈ ActualStageContinuousL2Core Y ↔
      ∃ f : ActualStageContinuousInverseEtaSection Y,
        actualStageContinuousToL2 Y f = u := by
  rfl

/-- The continuous core is dense as a submodule. -/
theorem actualStageContinuousL2Core_dense (Y : ℝ) :
    Dense (ActualStageContinuousL2Core Y :
      Set (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) := by
  change Dense (Set.range (actualStageContinuousToL2 Y))
  exact actualStageContinuousToL2_denseRange Y

/-- The topological closure of the concrete continuous core is the whole
actual stage Hilbert space. -/
theorem actualStageContinuousL2Core_topologicalClosure_eq_top (Y : ℝ) :
    (ActualStageContinuousL2Core Y).topologicalClosure = ⊤ :=
  Submodule.dense_iff_topologicalClosure_eq_top.mp
    (actualStageContinuousL2Core_dense Y)

/-- Equivalently, no nonzero `L²` section is orthogonal to every continuous
section. -/
theorem actualStageContinuousL2Core_orthogonal_eq_bot (Y : ℝ) :
    (ActualStageContinuousL2Core Y)ᗮ = ⊥ := by
  calc
    (ActualStageContinuousL2Core Y)ᗮ =
        (ActualStageContinuousL2Core Y).topologicalClosureᗮ :=
      (Submodule.orthogonal_closure
        (ActualStageContinuousL2Core Y)).symm
    _ = (⊤ : Submodule ℂ
        (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y))ᗮ := by
      rw [actualStageContinuousL2Core_topologicalClosure_eq_top]
    _ = ⊥ := Submodule.top_orthogonal_eq_bot

/-- The constant eta-coordinate `1`, viewed as a continuous actual quotient
bundle section. -/
noncomputable def actualStageContinuousInverseEtaOne (Y : ℝ) :
    ActualStageContinuousInverseEtaSection Y :=
  ContinuousMap.const (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (1 : ℂ)

/-- The continuous constant-one section realizes exactly the distinguished
inverse-eta `L²` section. -/
theorem actualStageContinuousToL2_one
    (Y : ℝ) :
    actualStageContinuousToL2 Y
        (actualStageContinuousInverseEtaOne Y) =
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageContinuousToL2_coeFn_ae Y
      (actualStageContinuousInverseEtaOne Y),
      MeasureTheory.Lp.coeFn_const
        (α := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (p := (2 : ℝ≥0∞))
        (μ := QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) (c := (1 : ℂ))]
    with x hx hOne
  simpa only [actualStageContinuousInverseEtaOne,
    QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection,
    ContinuousMap.const_apply] using hx.trans hOne.symm

/-- The distinguished inverse-eta section belongs to the dense continuous
core, not merely to its closure. -/
theorem actualStageDistinguishedInverseEtaSection_mem_range
    (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y ∈
      Set.range (actualStageContinuousToL2 Y) := by
  exact ⟨actualStageContinuousInverseEtaOne Y,
    actualStageContinuousToL2_one Y⟩

/-- Submodule spelling of membership of the distinguished section in the
continuous core. -/
theorem actualStageDistinguishedInverseEtaSection_mem_continuousL2Core
    (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y ∈
      ActualStageContinuousL2Core Y := by
  change QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y ∈
    Set.range (actualStageContinuousToL2 Y)
  exact actualStageDistinguishedInverseEtaSection_mem_range Y

/-- The dense continuous core is genuinely nonzero at every paper-range
cutoff. -/
theorem actualStageContinuousL2Core_ne_bot
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualStageContinuousL2Core Y ≠ ⊥ := by
  apply (Submodule.ne_bot_iff (ActualStageContinuousL2Core Y)).2
  exact
    ⟨QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y,
      actualStageDistinguishedInverseEtaSection_mem_continuousL2Core Y,
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection_ne_zero
        (lt_of_lt_of_le one_lt_two hY)⟩

/-- Aggregate unconditional density endpoint. -/
theorem actualStageContinuousDensityCertificate (Y : ℝ) :
    DenseRange (actualStageContinuousToL2 Y) ∧
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y ∈
        Set.range (actualStageContinuousToL2 Y) ∧
      (∀ f : ActualStageContinuousInverseEtaSection Y,
        ((actualStageContinuousToL2 Y f :
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
              QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
          (f : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ)) := by
  exact
    ⟨actualStageContinuousToL2_denseRange Y,
      actualStageDistinguishedInverseEtaSection_mem_range Y,
      actualStageContinuousToL2_coeFn_ae Y⟩

/-- Aggregate paper-range endpoint: the actual stage measure has full
support, and its continuous eta-coordinate core is simultaneously faithful,
dense, nonzero, and orthogonally total in the concrete Petersson `L²`
Hilbert space. -/
theorem actualStageContinuousInjectiveDenseCoreCertificate
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Measure.IsOpenPosMeasure (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) ∧
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y).support = Set.univ ∧
      Function.Injective (actualStageContinuousToL2 Y) ∧
      (actualStageContinuousToL2 Y).ker = ⊥ ∧
      DenseRange (actualStageContinuousToL2 Y) ∧
      (ActualStageContinuousL2Core Y).topologicalClosure = ⊤ ∧
      (ActualStageContinuousL2Core Y)ᗮ = ⊥ ∧
      ActualStageContinuousL2Core Y ≠ ⊥ ∧
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y ∈
        ActualStageContinuousL2Core Y := by
  exact
    ⟨actualStageMeasure_isOpenPos_of_two_le_level hY,
      actualStageMeasure_support_eq_univ_of_two_le_level hY,
      actualStageContinuousToL2_injective hY,
      actualStageContinuousToL2_ker_eq_bot hY,
      actualStageContinuousToL2_denseRange Y,
      actualStageContinuousL2Core_topologicalClosure_eq_top Y,
      actualStageContinuousL2Core_orthogonal_eq_bot Y,
      actualStageContinuousL2Core_ne_bot hY,
      actualStageDistinguishedInverseEtaSection_mem_continuousL2Core Y⟩

end QYM.FullCertification.P4ActualStageContinuousDensityExtension

