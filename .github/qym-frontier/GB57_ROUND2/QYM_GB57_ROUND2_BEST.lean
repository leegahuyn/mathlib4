/-!
# Mock/Rankin--Selberg and truncation-limit closure boundary

The paper's Section 4.8.5 does not define a concrete Paper-I kernel or
coefficient extraction map.  Its two quantitative inputs are explicitly
labelled Hypotheses 4.20 and 4.22:

* a lower frame estimate for the Rankin--Selberg mass functional; and
* domination of that mass functional by the Hamiltonian excess energy.

The later uniform truncation assertion is likewise labelled Hypothesis 4.24.
Consequently these data cannot be manufactured from the supplied PDF.  This
file closes everything that follows *logically* from those inequalities,
proves that the actual rank-one inverse-eta test cannot supply the first one,
and strengthens that obstruction to every compact mass operator on the
actual infinite-dimensional off-ground carrier.

The last part constructs, from the literal global quotient cutoff
projections, a family of bounded self-adjoint projection Hamiltonians and
explicit two-sided resolvents at the common point `-1`.  Both the
Hamiltonians and these displayed resolvents converge strongly.  Nevertheless
their ground projections grow strongly to the identity and the limiting
Hamiltonian has no nonzero level-one block.  This is a ground/excitation-block
identification firewall for common-point resolvent convergence; it is not a
claim that a numerical first-off-ground gap converges to zero.
-/

/-! ## 1. Exact lower-frame and energy-comparison predicates -/

section FrameBridge

variable {H K : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [NormedAddCommGroup K] [InnerProductSpace ℂ K]

/-- Squared norm of a bounded analysis map. -/
def analysisEnergy (T : H →L[ℂ] K) (u : H) : ℝ :=
  ‖T u‖ ^ 2

theorem analysisEnergy_nonneg (T : H →L[ℂ] K) (u : H) :
    0 ≤ analysisEnergy T u := by
  exact sq_nonneg ‖T u‖

/-- A lower frame bound on the orthogonal complement of the complete ground
block `ground`.  The definition does not assume that the ground block is a
line. -/
def HasLowerFrameBoundOn
    (ground : Submodule ℂ H) (T : H →L[ℂ] K) (c : ℝ) : Prop :=
  ∀ u : H, u ∈ groundᗮ → c * ‖u‖ ^ 2 ≤ analysisEnergy T u

/-- The indispensable Paper-II comparison: analysis energy is controlled by
the Hamiltonian excess energy. -/
def HasEnergyComparisonOn
    (ground : Submodule ℂ H) (T : H →L[ℂ] K)
    (excessEnergy : H → ℝ) (C : ℝ) : Prop :=
  ∀ u : H, u ∈ groundᗮ → analysisEnergy T u ≤ C * excessEnergy u

/-- Coercivity of an excess energy on the full ground complement. -/
def HasExcessCoercivityOn
    (ground : Submodule ℂ H) (excessEnergy : H → ℝ) (δ : ℝ) : Prop :=
  ∀ u : H, u ∈ groundᗮ → δ * ‖u‖ ^ 2 ≤ excessEnergy u

/-- If the matched null-space is contained in the full ground block, a
lower frame estimate on the matched complement restricts to the complete
ground complement. -/
theorem lowerFrame_restricts_from_matched_to_ground
    {matched ground : Submodule ℂ H} {T : H →L[ℂ] K} {c : ℝ}
    (hMatchedGround : matched ≤ ground)
    (hFrame : HasLowerFrameBoundOn matched T c) :
    HasLowerFrameBoundOn ground T c := by
  intro u hu
  exact hFrame u ((Submodule.orthogonal_le hMatchedGround) hu)

/-- Exact algebraic content of the paper's Hypotheses 4.20 and 4.22 in their
native `alpha * mass + beta` normalization. -/
theorem paperRSFormDomination_lower
    {ground : Submodule ℂ H}
    {massEnergy hamiltonianForm : H → ℝ}
    {c alpha beta : ℝ}
    (hAlpha : 0 ≤ alpha)
    (hMass : ∀ u : H, u ∈ groundᗮ →
      c * ‖u‖ ^ 2 ≤ massEnergy u)
    (hDomination : ∀ u : H, u ∈ groundᗮ →
      alpha * massEnergy u + beta * ‖u‖ ^ 2 ≤ hamiltonianForm u) :
    ∀ u : H, u ∈ groundᗮ →
      (alpha * c + beta) * ‖u‖ ^ 2 ≤ hamiltonianForm u := by
  intro u hu
  calc
    (alpha * c + beta) * ‖u‖ ^ 2 =
        alpha * (c * ‖u‖ ^ 2) + beta * ‖u‖ ^ 2 := by ring
    _ ≤ alpha * massEnergy u + beta * ‖u‖ ^ 2 :=
      add_le_add
        (mul_le_mul_of_nonneg_left (hMass u hu) hAlpha) (le_refl _)
    _ ≤ hamiltonianForm u := hDomination u hu

theorem paperRSGapIncrement_pos
    {alpha c : ℝ} (hAlpha : 0 < alpha) (hc : 0 < c) :
    0 < alpha * c :=
  mul_pos hAlpha hc

/-- Hypotheses 4.20 and 4.22 imply the exact multiplicity-safe lower bound
`c / C` on the whole ground complement. -/
theorem excessCoercivity_of_lowerFrame_and_energyComparison
    {ground : Submodule ℂ H} {T : H →L[ℂ] K}
    {excessEnergy : H → ℝ} {c C : ℝ}
    (hC : 0 < C)
    (hFrame : HasLowerFrameBoundOn ground T c)
    (hComparison : HasEnergyComparisonOn ground T excessEnergy C) :
    HasExcessCoercivityOn ground excessEnergy (c / C) := by
  intro u hu
  have hChain : c * ‖u‖ ^ 2 ≤ C * excessEnergy u :=
    (hFrame u hu).trans (hComparison u hu)
  calc
    (c / C) * ‖u‖ ^ 2 = (c * ‖u‖ ^ 2) / C := by ring
    _ ≤ excessEnergy u := (div_le_iff₀ hC).2 (by
      calc
        c * ‖u‖ ^ 2 ≤ C * excessEnergy u := hChain
        _ = excessEnergy u * C := mul_comm _ _)

/-- Positivity of the displayed frame and comparison constants is sufficient
for strict positivity of the derived gap constant. -/
theorem frameEnergyGapConstant_pos
    {c C : ℝ} (hc : 0 < c) (hC : 0 < C) :
    0 < c / C :=
  div_pos hc hC

/-- Uniform versions of the same two estimates give one constant for an
entire truncation family; no infimum manipulation or eigenvalue ordering is
needed. -/
theorem uniformExcessCoercivity_of_uniformFrameEnergyBridge
    {ι : Type*}
    {ground : Submodule ℂ H}
    {T : ι → H →L[ℂ] K}
    {excessEnergy : ι → H → ℝ}
    {cStar CStar : ℝ}
    (hCStar : 0 < CStar)
    (hFrame : ∀ i, HasLowerFrameBoundOn ground (T i) cStar)
    (hComparison : ∀ i,
      HasEnergyComparisonOn ground (T i) (excessEnergy i) CStar) :
    ∀ i, HasExcessCoercivityOn ground (excessEnergy i)
      (cStar / CStar) := by
  intro i
  exact excessCoercivity_of_lowerFrame_and_energyComparison
    hCStar (hFrame i) (hComparison i)

/-- A uniform coercive lower bound passes to a pointwise limit of energies on
one fixed ground complement, provided the displayed scalar convergence is
given.  This conditional statement is neither Mosco convergence nor a theorem
for moving ground subspaces. -/
theorem excessCoercivity_passes_to_pointwise_energyLimit
    {ground : Submodule ℂ H}
    {stageEnergy : ℕ → H → ℝ} {limitEnergy : H → ℝ} {δ : ℝ}
    (hStage : ∀ n, HasExcessCoercivityOn ground (stageEnergy n) δ)
    (hEnergyLimit : ∀ u : H, u ∈ groundᗮ →
      Tendsto (fun n => stageEnergy n u) atTop (𝓝 (limitEnergy u))) :
    HasExcessCoercivityOn ground limitEnergy δ := by
  intro u hu
  exact ge_of_tendsto (hEnergyLimit u hu)
    (Eventually.of_forall fun n => hStage n u hu)

/-- Complete uniform bridge: uniform Paper-I frame and comparison constants,
together with pointwise convergence of the excess forms on one fixed ground
complement, imply the same explicit lower bound for the limiting energy.  The
constant becomes positive only after separately assuming `0 < cStar`; no
Mosco or moving-ground conclusion is asserted here. -/
theorem limitExcessCoercivity_of_uniformFrameEnergyBridge
    {ground : Submodule ℂ H}
    {T : ℕ → H →L[ℂ] K}
    {stageEnergy : ℕ → H → ℝ} {limitEnergy : H → ℝ}
    {cStar CStar : ℝ}
    (hCStar : 0 < CStar)
    (hFrame : ∀ n, HasLowerFrameBoundOn ground (T n) cStar)
    (hComparison : ∀ n,
      HasEnergyComparisonOn ground (T n) (stageEnergy n) CStar)
    (hEnergyLimit : ∀ u : H, u ∈ groundᗮ →
      Tendsto (fun n => stageEnergy n u) atTop (𝓝 (limitEnergy u))) :
    HasExcessCoercivityOn ground limitEnergy (cStar / CStar) := by
  apply excessCoercivity_passes_to_pointwise_energyLimit
  · exact uniformExcessCoercivity_of_uniformFrameEnergyBridge
      hCStar hFrame hComparison
  · exact hEnergyLimit

end FrameBridge

/-! ## 2. Energy comparison is logically indispensable -/

/-- An explicit counterexample: a perfectly coercive positive test
functional can be unrelated to a nonnegative Hamiltonian energy.  Therefore
lower-frame positivity alone cannot imply a spectral gap. -/
theorem lowerFrame_alone_does_not_imply_energyCoercivity :
    ∃ (mockEnergy hamiltonianEnergy : ℝ → ℝ),
      (∀ x : ℝ, 1 * x ^ 2 ≤ mockEnergy x) ∧
      (∀ x : ℝ, 0 ≤ hamiltonianEnergy x) ∧
      ¬ ∃ δ : ℝ, 0 < δ ∧
        ∀ x : ℝ, δ * x ^ 2 ≤ hamiltonianEnergy x := by
  refine ⟨fun x => x ^ 2, fun _ => 0, ?_, ?_, ?_⟩
  · intro x
    simp only [one_mul, le_refl]
  · intro x
    exact le_rfl
  · rintro ⟨δ, hδ, hCoercive⟩
    have hOne := hCoercive 1
    norm_num at hOne
    exact (not_lt_of_ge hOne) hδ

/-- Even strict positivity at every truncation does not provide the uniform
constant required by the limiting theorem. -/
theorem pointwise_positive_frameConstants_do_not_supply_uniformGap :
    (∀ n : ℕ,
      0 < QYM.CompactSelfAdjointGapExtension.reciprocalPositiveLevel n) ∧
      ¬ ∃ c : ℝ, 0 < c ∧
        ∀ n : ℕ, c ≤ QYM.CompactSelfAdjointGapExtension.reciprocalPositiveLevel n :=
  QYM.CompactSelfAdjointGapExtension.pointwise_positivity_does_not_imply_uniform_gap

/-! ## 3. Compact Paper-I mass operators cannot supply the actual frame -/

section CompactAnalysisNoGo

variable {H K : Type*}
variable [NormedAddCommGroup H] [NormedSpace ℂ H] [CompleteSpace H]
variable [NormedAddCommGroup K] [NormedSpace ℂ K]

/-- Norm lower bound for an analysis map with an arbitrary codomain. -/
def HasAnalysisNormLowerBound (T : H →L[ℂ] K) (c : ℝ) : Prop :=
  ∀ u : H, c * ‖u‖ ≤ ‖T u‖

/-- The compact-embedding argument in its correct analysis-map generality:
a compact map `H → K` with a positive norm lower bound forces `H` to be
finite dimensional. -/
theorem finiteDimensional_of_compact_analysis_normLowerBound
    (T : H →L[ℂ] K) (hCompact : IsCompactOperator T)
    {c : ℝ} (hc : 0 < c) (hLower : HasAnalysisNormLowerBound T c) :
    FiniteDimensional ℂ H := by
  have hAnti :
      AntilipschitzWith ⟨c⁻¹, inv_nonneg.mpr hc.le⟩ T := by
    apply AntilipschitzWith.of_le_mul_dist
    intro x y
    change dist x y ≤ c⁻¹ * dist (T x) (T y)
    simp only [dist_eq_norm_sub, ← map_sub]
    calc
      ‖x - y‖ = c⁻¹ * (c * ‖x - y‖) := by
        rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
      _ ≤ c⁻¹ * ‖T (x - y)‖ :=
        mul_le_mul_of_nonneg_left (hLower (x - y))
          (inv_nonneg.mpr hc.le)
  have hEmbedding : Topology.IsClosedEmbedding T :=
    hAnti.isClosedEmbedding T.uniformContinuous
  obtain ⟨C, hCCompact, hImageSubset⟩ :=
    hCompact.image_closedBall_subset_compact 1
  have hImageClosed : IsClosed (T '' Metric.closedBall (0 : H) 1) :=
    hEmbedding.isClosedMap _ Metric.isClosed_closedBall
  have hImageCompact : IsCompact (T '' Metric.closedBall (0 : H) 1) :=
    hCCompact.of_isClosed_subset hImageClosed hImageSubset
  have hBallCompact : IsCompact (Metric.closedBall (0 : H) 1) :=
    hEmbedding.isEmbedding.isCompact_iff.mpr hImageCompact
  exact FiniteDimensional.of_isCompact_closedBall ℂ zero_lt_one hBallCompact

/-- A squared lower frame estimate implies an ordinary norm lower bound
with constant `sqrt c`. -/
theorem normLowerBound_of_squared_lowerFrame
    (T : H →L[ℂ] K) {c : ℝ} (hc : 0 < c)
    (hFrame : ∀ u : H, c * ‖u‖ ^ 2 ≤ ‖T u‖ ^ 2) :
    HasAnalysisNormLowerBound T (Real.sqrt c) := by
  intro u
  rw [← sq_le_sq₀
    (mul_nonneg (Real.sqrt_nonneg c) (norm_nonneg u))
    (norm_nonneg (T u))]
  simpa only [mul_pow, Real.sq_sqrt hc.le] using hFrame u

/-- Hence a compact analysis map from an infinite-dimensional Hilbert
domain cannot have the requested positive lower frame bound, regardless of
its codomain. -/
theorem compactAnalysis_infiniteDimensional_no_positive_lowerFrame
    (hinfinite : ¬ FiniteDimensional ℂ H)
    (T : H →L[ℂ] K) (hCompact : IsCompactOperator T) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : H, c * ‖u‖ ^ 2 ≤ ‖T u‖ ^ 2 := by
  rintro ⟨c, hc, hFrame⟩
  exact hinfinite
    (finiteDimensional_of_compact_analysis_normLowerBound
      T hCompact (Real.sqrt_pos.2 hc)
      (normLowerBound_of_squared_lowerFrame T hc hFrame))

/-- Actual-carrier specialization: every compact Paper-I candidate
`T : off-ground → K` fails the lower frame inequality. -/
theorem actualOffGround_compactAnalysis_has_no_positive_lowerFrame
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →L[ℂ] K)
    (hCompact : IsCompactOperator T) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y,
        c * ‖u‖ ^ 2 ≤ ‖T u‖ ^ 2 := by
  exact compactAnalysis_infiniteDimensional_no_positive_lowerFrame
    (QYM.FullCertification.P12ActualInverseEtaProjectionHamiltonianExtension.actualInverseEtaOffTestSubspace_not_finiteDimensional
      hY)
    T hCompact

end CompactAnalysisNoGo

section CompactMassNoGo

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Global quadratic coercivity for a bounded mass operator. -/
def HasQuadraticCoercivity (M : H →L[ℂ] H) (c : ℝ) : Prop :=
  ∀ u : H, c * ‖u‖ ^ 2 ≤ (inner ℂ u (M u)).re

/-- A positive quadratic lower bound forces injectivity. -/
theorem injective_of_quadraticCoercivity
    {M : H →L[ℂ] H} {c : ℝ} (hc : 0 < c)
    (hCoercive : HasQuadraticCoercivity M c) :
    Function.Injective M := by
  intro u v huv
  have hZero : M (u - v) = 0 := by
    rw [map_sub, huv, sub_self]
  have hBound := hCoercive (u - v)
  rw [hZero, inner_zero_right, Complex.zero_re] at hBound
  have huvZero : u - v = 0 := by
    by_contra hne
    have hPositive : 0 < c * ‖u - v‖ ^ 2 :=
      mul_pos hc (sq_pos_of_pos (norm_pos_iff.mpr hne))
    exact (not_lt_of_ge hBound) hPositive
  exact sub_eq_zero.mp huvZero

/-- On an infinite-dimensional complete Hilbert space, a compact mass
operator cannot obey a positive global quadratic coercivity estimate. -/
theorem compact_infiniteDimensional_no_quadraticCoercivity
    [CompleteSpace H]
    (hinfinite : ¬ FiniteDimensional ℂ H)
    (M : H →L[ℂ] H) (hCompact : IsCompactOperator M) :
    ¬ ∃ c : ℝ, 0 < c ∧ HasQuadraticCoercivity M c := by
  rintro ⟨c, hc, hCoercive⟩
  have hInjective : Function.Injective M :=
    injective_of_quadraticCoercivity hc hCoercive
  have hGround : QYM.CompactSelfAdjointGapExtension.HasGroundComplementCoercivity M c := by
    intro u hu
    exact hCoercive u
  exact
    (QYM.CompactSelfAdjointGapExtension.compact_infiniteDimensional_injective_no_groundComplementCoercivity
      hinfinite hCompact hInjective)
      ⟨c, hc, hGround⟩

/-- The actual inverse-eta off-ground Hilbert block at every paper-range
stage is infinite dimensional, so any operator satisfying the requested
Paper-I lower frame estimate there must be noncompact. -/
theorem actualOffGround_quadraticCoercivity_forces_noncompact
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (M : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →L[ℂ]
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)
    {c : ℝ} (hc : 0 < c)
    (hCoercive : HasQuadraticCoercivity M c) :
    ¬ IsCompactOperator M := by
  intro hCompact
  exact compact_infiniteDimensional_no_quadraticCoercivity
    (QYM.FullCertification.P12ActualInverseEtaProjectionHamiltonianExtension.actualInverseEtaOffTestSubspace_not_finiteDimensional
      hY)
    M hCompact ⟨c, hc, hCoercive⟩

/-- Existential form of the same actual-carrier obstruction. -/
theorem actualOffGround_compactMass_has_no_positive_coercivity
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (M : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →L[ℂ]
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)
    (hCompact : IsCompactOperator M) :
    ¬ ∃ c : ℝ, 0 < c ∧ HasQuadraticCoercivity M c := by
  exact compact_infiniteDimensional_no_quadraticCoercivity
    (QYM.FullCertification.P12ActualInverseEtaProjectionHamiltonianExtension.actualInverseEtaOffTestSubspace_not_finiteDimensional
      hY)
    M hCompact

end CompactMassNoGo

/-! ## 4. The actually constructed inverse-eta test still fails -/

/-- The literal rank-one inverse-eta test cannot be substituted for the
missing Paper-I frame.  This is unconditional on every paper-range stage. -/
theorem actualInverseEtaRankOne_is_not_a_lowerFrame
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
        u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
          c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u :=
  QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension.actualInverseEtaTest_no_exists_positive_coercivity q hY

/-! ## 5. Actual cutoff projection Hamiltonians -/

abbrev ActualGlobalL2 := QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.ActualGlobalQuotientL2

/-- The projection onto the part outside the `n`-th literal quotient stage:
`Q_n = I - P_n`.  This is a bounded model used only for the truncation-limit
firewall, not the paper's covariant Hamiltonian. -/
noncomputable def actualCutoffEscapeHamiltonian (n : ℕ) :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  ContinuousLinearMap.id ℂ ActualGlobalL2 -
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n

@[simp]
theorem actualCutoffEscapeHamiltonian_apply
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffEscapeHamiltonian n u =
      u - QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u := by
  rfl

/-- `Q_n` is idempotent. -/
theorem actualCutoffEscapeHamiltonian_idempotent
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffEscapeHamiltonian n
        (actualCutoffEscapeHamiltonian n u) =
      actualCutoffEscapeHamiltonian n u := by
  rw [actualCutoffEscapeHamiltonian_apply,
    actualCutoffEscapeHamiltonian_apply, map_sub,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]
  module

/-- `Q_n` is symmetric. -/
theorem actualCutoffEscapeHamiltonian_inner_symmetric
    (n : ℕ) (u v : ActualGlobalL2) :
    inner ℂ (actualCutoffEscapeHamiltonian n u) v =
      inner ℂ u (actualCutoffEscapeHamiltonian n v) := by
  rw [actualCutoffEscapeHamiltonian_apply,
    actualCutoffEscapeHamiltonian_apply,
    inner_sub_left, inner_sub_right,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_inner_symmetric]

theorem actualCutoffEscapeHamiltonian_isSymmetric (n : ℕ) :
    (actualCutoffEscapeHamiltonian n :
      ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2).IsSymmetric := by
  intro u v
  exact actualCutoffEscapeHamiltonian_inner_symmetric n u v

theorem actualCutoffEscapeHamiltonian_isSelfAdjoint (n : ℕ) :
    IsSelfAdjoint (actualCutoffEscapeHamiltonian n) :=
  (actualCutoffEscapeHamiltonian_isSymmetric n).isSelfAdjoint

/-- The complete moving off-ground block is the range of `Q_n`. -/
def actualCutoffMovingOffGround (n : ℕ) :
    Submodule ℂ ActualGlobalL2 :=
  LinearMap.range
    (actualCutoffEscapeHamiltonian n :
      ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2)

/-- Every vector in the moving off-ground block is fixed by `Q_n`. -/
theorem actualCutoffEscapeHamiltonian_fixed_of_mem_movingOffGround
    {n : ℕ} {u : ActualGlobalL2}
    (hu : u ∈ actualCutoffMovingOffGround n) :
    actualCutoffEscapeHamiltonian n u = u := by
  obtain ⟨v, rfl⟩ := hu
  exact actualCutoffEscapeHamiltonian_idempotent n v

/-- Exact level-one energy identity on the complete fixed space of `Q_n`. -/
theorem actualCutoffEscapeHamiltonian_energy_eq_norm_sq_of_fixed
    {n : ℕ} {u : ActualGlobalL2}
    (hu : actualCutoffEscapeHamiltonian n u = u) :
    (inner ℂ (actualCutoffEscapeHamiltonian n u) u).re = ‖u‖ ^ 2 := by
  rw [hu]
  exact (norm_sq_eq_re_inner (𝕜 := ℂ) u).symm

/-- Uniform unit coercivity on every member of the moving off-ground block.
This is an equality and is independent of `n`.  It is not called a
nontrivial stage gap until nonzeroness of this block is separately proved. -/
theorem actualCutoffEscapeHamiltonian_unitCoercivity_on_movingOffGround
    {n : ℕ} {u : ActualGlobalL2}
    (hu : u ∈ actualCutoffMovingOffGround n) :
    1 * ‖u‖ ^ 2 ≤
      (inner ℂ (actualCutoffEscapeHamiltonian n u) u).re := by
  rw [one_mul,
    actualCutoffEscapeHamiltonian_energy_eq_norm_sq_of_fixed
      (actualCutoffEscapeHamiltonian_fixed_of_mem_movingOffGround hu)]

/-- Exact nonvacuity boundary for the surrogate moving off-ground block.
The existing quotient-cutoff API does not yet construct an inhabitant of
this proposition for every `n`. -/
def ActualCutoffMovingOffGroundNontrivial (n : ℕ) : Prop :=
  actualCutoffMovingOffGround n ≠ ⊥

/-- Nontriviality is exactly existence of a nonzero unit-level vector.  This
equivalence prevents the conditional-on-membership coercivity theorem above
from being reported as a genuine stage gap without a witness. -/
theorem actualCutoffMovingOffGroundNontrivial_iff_exists_nonzero_fixed
    (n : ℕ) :
    ActualCutoffMovingOffGroundNontrivial n ↔
      ∃ u : ActualGlobalL2, u ≠ 0 ∧
        actualCutoffEscapeHamiltonian n u = u := by
  constructor
  · intro hNontrivial
    obtain ⟨u, hu, hu0⟩ :=
      Submodule.exists_mem_ne_zero_of_ne_bot hNontrivial
    exact ⟨u, hu0,
      actualCutoffEscapeHamiltonian_fixed_of_mem_movingOffGround hu⟩
  · rintro ⟨u, hu0, huFixed⟩ hBot
    have huMem : u ∈ actualCutoffMovingOffGround n :=
      ⟨u, huFixed⟩
    rw [hBot, Submodule.mem_bot] at huMem
    exact hu0 huMem

/-- The cutoff Hamiltonians converge strongly to zero. -/
theorem actualCutoffEscapeHamiltonian_tendsto_strong
    (u : ActualGlobalL2) :
    Tendsto (fun n => actualCutoffEscapeHamiltonian n u)
      atTop (𝓝 0) := by
  have hProjection :=
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_tendsto_strong u
  have hConst : Tendsto (fun _ : ℕ => u) atTop (𝓝 u) :=
    tendsto_const_nhds
  simpa only [actualCutoffEscapeHamiltonian_apply, sub_self] using
    hConst.sub hProjection

/-! ## 6. Explicit resolvents at the common point `-1` -/

/-- The bounded shifted operator `-I - Q_n`. -/
noncomputable def actualCutoffNegativeOneShift (n : ℕ) :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  -(ContinuousLinearMap.id ℂ ActualGlobalL2) -
    actualCutoffEscapeHamiltonian n

@[simp]
theorem actualCutoffNegativeOneShift_apply
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffNegativeOneShift n u =
      -u - actualCutoffEscapeHamiltonian n u := by
  rfl

/-- Explicit inverse of `-I-Q_n`: `-1/2 (I+P_n)`. -/
noncomputable def actualCutoffNegativeOneResolvent (n : ℕ) :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  (-(1 / 2 : ℂ)) •
    (ContinuousLinearMap.id ℂ ActualGlobalL2 +
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n)

@[simp]
theorem actualCutoffNegativeOneResolvent_apply
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffNegativeOneResolvent n u =
      (-(1 / 2 : ℂ)) •
        (u + QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u) := by
  rfl

/-- Right-inverse equation at the genuine shift `-1`. -/
theorem actualCutoffNegativeOneShift_resolvent
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffNegativeOneShift n
        (actualCutoffNegativeOneResolvent n u) = u := by
  rw [actualCutoffNegativeOneShift_apply,
    actualCutoffNegativeOneResolvent_apply,
    actualCutoffEscapeHamiltonian_apply, map_smul, map_add,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]
  module

/-- Left-inverse equation at the genuine shift `-1`. -/
theorem actualCutoffNegativeOneResolvent_shift
    (n : ℕ) (u : ActualGlobalL2) :
    actualCutoffNegativeOneResolvent n
        (actualCutoffNegativeOneShift n u) = u := by
  have hIdempotent :
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n
          (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u) =
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u := by
    rw [QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]
  rw [actualCutoffNegativeOneResolvent_apply,
    actualCutoffNegativeOneShift_apply,
    actualCutoffEscapeHamiltonian_apply, map_sub, map_neg, map_sub,
    hIdempotent]
  module

/-- Thus `-1` is a common bounded resolvent point for every cutoff escape
Hamiltonian. -/
theorem actualCutoffNegativeOneShift_bijective (n : ℕ) :
    Function.Bijective (actualCutoffNegativeOneShift n) := by
  constructor
  · intro u v huv
    calc
      u = actualCutoffNegativeOneResolvent n
          (actualCutoffNegativeOneShift n u) :=
        (actualCutoffNegativeOneResolvent_shift n u).symm
      _ = actualCutoffNegativeOneResolvent n
          (actualCutoffNegativeOneShift n v) := by rw [huv]
      _ = v := actualCutoffNegativeOneResolvent_shift n v
  · intro u
    exact ⟨actualCutoffNegativeOneResolvent n u,
      actualCutoffNegativeOneShift_resolvent n u⟩

/-- The `-1` resolvent of the zero limiting Hamiltonian. -/
noncomputable def actualCutoffLimitNegativeOneResolvent :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  -(ContinuousLinearMap.id ℂ ActualGlobalL2)

@[simp]
theorem actualCutoffLimitNegativeOneResolvent_apply
    (u : ActualGlobalL2) :
    actualCutoffLimitNegativeOneResolvent u = -u := by
  rfl

/-- The `-1` shift of the zero limiting Hamiltonian. -/
noncomputable def actualCutoffLimitNegativeOneShift :
    ActualGlobalL2 →L[ℂ] ActualGlobalL2 :=
  -(ContinuousLinearMap.id ℂ ActualGlobalL2)

@[simp]
theorem actualCutoffLimitNegativeOneShift_apply (u : ActualGlobalL2) :
    actualCutoffLimitNegativeOneShift u = -u := by
  rfl

theorem actualCutoffLimitNegativeOneShift_resolvent
    (u : ActualGlobalL2) :
    actualCutoffLimitNegativeOneShift
        (actualCutoffLimitNegativeOneResolvent u) = u := by
  simp only [actualCutoffLimitNegativeOneShift_apply,
    actualCutoffLimitNegativeOneResolvent_apply, neg_neg]

theorem actualCutoffLimitNegativeOneResolvent_shift
    (u : ActualGlobalL2) :
    actualCutoffLimitNegativeOneResolvent
        (actualCutoffLimitNegativeOneShift u) = u := by
  simp only [actualCutoffLimitNegativeOneShift_apply,
    actualCutoffLimitNegativeOneResolvent_apply, neg_neg]

theorem actualCutoffLimitNegativeOneShift_bijective :
    Function.Bijective actualCutoffLimitNegativeOneShift := by
  constructor
  · intro u v huv
    calc
      u = actualCutoffLimitNegativeOneResolvent
          (actualCutoffLimitNegativeOneShift u) :=
        (actualCutoffLimitNegativeOneResolvent_shift u).symm
      _ = actualCutoffLimitNegativeOneResolvent
          (actualCutoffLimitNegativeOneShift v) := by rw [huv]
      _ = v := actualCutoffLimitNegativeOneResolvent_shift v
  · intro u
    exact ⟨actualCutoffLimitNegativeOneResolvent u,
      actualCutoffLimitNegativeOneShift_resolvent u⟩

/-- The zero limiting Hamiltonian is self-adjoint. -/
theorem actualCutoffZeroLimit_isSelfAdjoint :
    IsSelfAdjoint (0 : ActualGlobalL2 →L[ℂ] ActualGlobalL2) := by
  apply LinearMap.IsSymmetric.isSelfAdjoint
  intro u v
  simp only [ContinuousLinearMap.coe_zero, LinearMap.zero_apply,
    inner_zero_left, inner_zero_right]

/-- The explicit resolvents converge strongly to the resolvent of the zero
limit operator. -/
theorem actualCutoffNegativeOneResolvent_tendsto_strong
    (u : ActualGlobalL2) :
    Tendsto (fun n => actualCutoffNegativeOneResolvent n u)
      atTop (𝓝 (actualCutoffLimitNegativeOneResolvent u)) := by
  have hProjection :=
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_tendsto_strong u
  have hSum :
      Tendsto
        (fun n => u + QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u)
        atTop (𝓝 (u + u)) :=
    tendsto_const_nhds.add hProjection
  have hScaled :=
    ((continuous_const_smul (-(1 / 2 : ℂ))).tendsto (u + u)).comp hSum
  change Tendsto
    (fun n => (-(1 / 2 : ℂ)) •
      (u + QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u))
    atTop (𝓝 (-(1 / 2 : ℂ) • (u + u))) at hScaled
  have hScaleLimit : (-(1 / 2 : ℂ)) • (u + u) = -u := by
    module
  simpa only [Function.comp_apply, actualCutoffNegativeOneResolvent_apply,
    actualCutoffLimitNegativeOneResolvent_apply,
    hScaleLimit] using hScaled

/-! ## 7. Common-`-1` resolvent convergence does not freeze the ground block -/

/-- The stage ground equation for the escape Hamiltonian is exactly the
fixed-space equation for the increasing cutoff projection. -/
theorem actualCutoffEscapeHamiltonian_eq_zero_iff
    {n : ℕ} {u : ActualGlobalL2} :
    actualCutoffEscapeHamiltonian n u = 0 ↔
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u = u := by
  rw [actualCutoffEscapeHamiltonian_apply, sub_eq_zero, eq_comm]

/-- Exact ground-block identity: the kernel of `Q_n` is the range of the
literal stage projection `P_n`. -/
theorem actualCutoffEscapeHamiltonian_ker_eq_stageProjection_range
    (n : ℕ) :
    LinearMap.ker
        (actualCutoffEscapeHamiltonian n :
          ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2) =
      LinearMap.range
        (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n :
          ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2) := by
  ext u
  constructor
  · intro hu
    rw [LinearMap.mem_ker] at hu
    change actualCutoffEscapeHamiltonian n u = 0 at hu
    rw [actualCutoffEscapeHamiltonian_eq_zero_iff] at hu
    exact ⟨u, hu⟩
  · rintro ⟨v, rfl⟩
    rw [LinearMap.mem_ker]
    change actualCutoffEscapeHamiltonian n
      (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n v) = 0
    rw [actualCutoffEscapeHamiltonian_eq_zero_iff,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]

/-- Exact off-ground identity: the range of `Q_n` is the kernel of `P_n`.
This makes the moving decomposition fully explicit. -/
theorem actualCutoffMovingOffGround_eq_stageProjection_ker
    (n : ℕ) :
    actualCutoffMovingOffGround n =
      LinearMap.ker
        (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n :
          ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2) := by
  ext u
  constructor
  · rintro ⟨v, rfl⟩
    rw [LinearMap.mem_ker]
    change QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n
      (actualCutoffEscapeHamiltonian n v) = 0
    rw [actualCutoffEscapeHamiltonian_apply, map_sub]
    have hIdempotent :
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n
            (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n v) =
          QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n v := by
      rw [QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]
    rw [hIdempotent, sub_self]
  · intro hu
    rw [LinearMap.mem_ker] at hu
    refine ⟨u, ?_⟩
    change u -
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u = u
    exact sub_eq_self.mpr hu

/-- Every vector is approached strongly by vectors in the stage ground
spaces. -/
theorem actualCutoffGroundApproximation
    (u : ActualGlobalL2) :
    Tendsto (fun n => QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u)
        atTop (𝓝 u) ∧
      ∀ n,
        actualCutoffEscapeHamiltonian n
            (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u) = 0 := by
  refine ⟨QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_tendsto_strong u, ?_⟩
  intro n
  rw [actualCutoffEscapeHamiltonian_eq_zero_iff,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_apply,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_idempotent]

/-- The zero limit has no nonzero level-one vector.  Thus the exact stage
identity on the moving `Q_n` block does not identify a nonzero limiting
excitation block.  This is ground/excitation instability, not a calculation
that a numerical first-off-ground gap closes. -/
theorem zeroLimit_has_no_nonzero_levelOne :
    ¬ ∃ u : ActualGlobalL2, u ≠ 0 ∧
      (0 : ActualGlobalL2 →L[ℂ] ActualGlobalL2) u = u := by
  rintro ⟨u, hu, hFixed⟩
  simp only [ContinuousLinearMap.zero_apply] at hFixed
  exact hu hFixed.symm

/-- Aggregate actual cutoff firewall based on explicit two-sided inverses and
strong convergence of the displayed resolvents at the common point `-1`.
No packaged strong-resolvent predicate is used.  The unit estimate is
conditional on membership in the moving block and may be vacuous: this
certificate deliberately does not assert
`ActualCutoffMovingOffGroundNontrivial n`. -/
theorem actualCutoffStrongResolventFirewallCertificate :
    (∀ n, IsSelfAdjoint (actualCutoffEscapeHamiltonian n)) ∧
      IsSelfAdjoint (0 : ActualGlobalL2 →L[ℂ] ActualGlobalL2) ∧
      (∀ n u,
        actualCutoffEscapeHamiltonian n
            (actualCutoffEscapeHamiltonian n u) =
          actualCutoffEscapeHamiltonian n u) ∧
      (∀ n,
        LinearMap.ker
            (actualCutoffEscapeHamiltonian n :
              ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2) =
          LinearMap.range
            (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n :
              ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2)) ∧
      (∀ n,
        actualCutoffMovingOffGround n =
          LinearMap.ker
            (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n :
              ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2)) ∧
      (∀ n u, u ∈ actualCutoffMovingOffGround n →
        1 * ‖u‖ ^ 2 ≤
          (inner ℂ (actualCutoffEscapeHamiltonian n u) u).re) ∧
      (∀ u, Tendsto (fun n => actualCutoffEscapeHamiltonian n u)
        atTop (𝓝 0)) ∧
      (∀ n u, actualCutoffNegativeOneShift n
          (actualCutoffNegativeOneResolvent n u) = u) ∧
      (∀ n u, actualCutoffNegativeOneResolvent n
          (actualCutoffNegativeOneShift n u) = u) ∧
      (∀ n, Function.Bijective (actualCutoffNegativeOneShift n)) ∧
      (∀ u, actualCutoffLimitNegativeOneShift
          (actualCutoffLimitNegativeOneResolvent u) = u) ∧
      (∀ u, actualCutoffLimitNegativeOneResolvent
          (actualCutoffLimitNegativeOneShift u) = u) ∧
      Function.Bijective actualCutoffLimitNegativeOneShift ∧
      (∀ u, Tendsto (fun n => actualCutoffNegativeOneResolvent n u)
        atTop (𝓝 (actualCutoffLimitNegativeOneResolvent u))) ∧
      (∀ u, Tendsto (fun n => QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u)
        atTop (𝓝 u)) ∧
      ¬ ∃ u : ActualGlobalL2, u ≠ 0 ∧
        (0 : ActualGlobalL2 →L[ℂ] ActualGlobalL2) u = u := by
  exact
    ⟨actualCutoffEscapeHamiltonian_isSelfAdjoint,
      actualCutoffZeroLimit_isSelfAdjoint,
      actualCutoffEscapeHamiltonian_idempotent,
      actualCutoffEscapeHamiltonian_ker_eq_stageProjection_range,
      actualCutoffMovingOffGround_eq_stageProjection_ker,
      fun n u hu =>
        actualCutoffEscapeHamiltonian_unitCoercivity_on_movingOffGround hu,
      actualCutoffEscapeHamiltonian_tendsto_strong,
      actualCutoffNegativeOneShift_resolvent,
      actualCutoffNegativeOneResolvent_shift,
      actualCutoffNegativeOneShift_bijective,
      actualCutoffLimitNegativeOneShift_resolvent,
      actualCutoffLimitNegativeOneResolvent_shift,
      actualCutoffLimitNegativeOneShift_bijective,
      actualCutoffNegativeOneResolvent_tendsto_strong,
      QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_tendsto_strong,
      zeroLimit_has_no_nonzero_levelOne⟩

/-! ## 8. Final exact boundary certificate -/

/-- The strongest aggregate endpoint recorded by this proposition.  It
contains exactly:

* failure of the literal inverse-eta rank-one lower-frame estimate;
* infinite dimensionality of the actual off-test carrier;
* the counterexample showing that a lower frame alone does not imply energy
  coercivity; and
* self-adjointness of the cutoff Hamiltonians together with strong operator
  convergence of those Hamiltonians and of their explicit common-`-1`
  resolvents.

The separate `c / C` bridge and compactness obstructions proved above are not
fields of this aggregate proposition.  Nor is this a packaged
strong-resolvent or moving-ground convergence theorem.

No assertion here identifies a surrogate with the absent Paper-I
Rankin--Selberg operator. -/
theorem actualMockRSAndUniformGapBoundaryCertificate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
        u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
          c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u) ∧
      (¬ FiniteDimensional ℂ
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)) ∧
      (∃ (mockEnergy hamiltonianEnergy : ℝ → ℝ),
        (∀ x : ℝ, 1 * x ^ 2 ≤ mockEnergy x) ∧
        (∀ x : ℝ, 0 ≤ hamiltonianEnergy x) ∧
        ¬ ∃ δ : ℝ, 0 < δ ∧
          ∀ x : ℝ, δ * x ^ 2 ≤ hamiltonianEnergy x) ∧
      ((∀ n, IsSelfAdjoint (actualCutoffEscapeHamiltonian n)) ∧
        (∀ u, Tendsto (fun n => actualCutoffEscapeHamiltonian n u)
          atTop (𝓝 0)) ∧
        (∀ u, Tendsto (fun n => actualCutoffNegativeOneResolvent n u)
          atTop (𝓝 (actualCutoffLimitNegativeOneResolvent u)))) := by
  exact
    ⟨actualInverseEtaRankOne_is_not_a_lowerFrame q hY,
      QYM.FullCertification.P12ActualInverseEtaProjectionHamiltonianExtension.actualInverseEtaOffTestSubspace_not_finiteDimensional
        hY,
      lowerFrame_alone_does_not_imply_energyCoercivity,
      actualCutoffEscapeHamiltonian_isSelfAdjoint,
      actualCutoffEscapeHamiltonian_tendsto_strong,
      actualCutoffNegativeOneResolvent_tendsto_strong⟩

end QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension

