/-- A row has proof-carrying evidence when at least one of the ten independent registries links
an identifier whose exact proposition is proved by that registry's `evidenceSound` theorem. -/
def HasAnyTypedEvidence (claim : ClaimId) : Prop :=
  (∃ evidence : QYM.FullCertification.TypedEvidence.EvidenceId,
      evidence ∈ QYM.FullCertification.TypedEvidence.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceB2DirectExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceB2DirectExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceVariationTailSignExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceVariationTailSignExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceFullClaimExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceFullClaimExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceFormResolventSpectralExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceFormResolventSpectralExtension.evidenceForClaim claim) ∨
  (∃ evidence : QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension.evidenceForClaim claim) ∨
  (∃ evidence :
      QYM.FullCertification.TypedEvidenceUnconditionalFunctionalAnalysisExtension.EvidenceId,
      evidence ∈
        QYM.FullCertification.TypedEvidenceUnconditionalFunctionalAnalysisExtension.evidenceForClaim claim)

/-- The union of the ten proof-carrying link maps covers every constructor in the 58-row manual
inventory.  The evidence proposition may be a conditional supplier or a refutation. -/
theorem everyClaim_has_typed_evidence (claim : ClaimId) :
    HasAnyTypedEvidence claim := by
  cases claim <;>
    simp [HasAnyTypedEvidence,
      QYM.FullCertification.TypedEvidence.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceB2DirectExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceVariationTailSignExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceFullClaimExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceFormResolventSpectralExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceUnconditionalFunctionalAnalysisExtension.evidenceForClaim,
      QYM.FullCertification.TypedEvidenceClosedPureDiscreteGapExtension.evidenceForClaim]

/-- Decidable source-order view of the same ten-registry union. -/
def hasAnyTypedEvidenceLink (claim : ClaimId) : Bool :=
  !(QYM.FullCertification.TypedEvidence.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceB2DirectExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceVariationTailSignExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceFullClaimExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceFormResolventSpectralExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceUnconditionalFunctionalAnalysisExtension.evidenceForClaim claim).isEmpty ||
  !(QYM.FullCertification.TypedEvidenceClosedPureDiscreteGapExtension.evidenceForClaim claim).isEmpty

def claimsWithAnyTypedEvidence : List ClaimId :=
  allClaims.filter hasAnyTypedEvidenceLink

theorem claimsWithAnyTypedEvidence_eq_allClaims :
    claimsWithAnyTypedEvidence = allClaims := by
  decide

theorem claimsWithAnyTypedEvidence_length :
    claimsWithAnyTypedEvidence.length = 58 := by
  decide

/-- Audit completeness means only that every manual row is linked to a proved exact proposition.
It is intentionally weaker than certifying every original PDF assertion as true. -/
def TypedEvidenceAuditComplete : Prop :=
  ∀ claim : ClaimId, HasAnyTypedEvidence claim

theorem typedEvidenceAuditComplete : TypedEvidenceAuditComplete := by
  intro claim
  exact everyClaim_has_typed_evidence claim

end QYM.FullCertification.EvidenceAccounting

