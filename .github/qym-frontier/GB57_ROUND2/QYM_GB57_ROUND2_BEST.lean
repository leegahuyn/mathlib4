/-!
# Mock4: the exact actual-quotient H1/Hamiltonian boundary

This producer works only on the genuine finite-stage carrier

`L²(X Y, inverse-eta) = P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y`.

It does not identify that carrier with the finite two-coordinate model.  It
also does not turn the older closed-ball graph completion into a weak Sobolev
space on the intrinsic quotient stage.

The source audit gives the following exact boundary.

* The intrinsic stage is compact and has proved one-sided topological cusp
  collars, but its smooth half-space manifold-with-boundary structure is still
  the explicit proposition `StageSmoothHalfSpaceAtlasCompatibilityResidual`.
  Consequently there is no stage `mfderiv` from which a geometric weak
  derivative with cusp boundary condition can presently be defined.
* The actual dense core constructed on the stage is a continuous-function
  core.  No quotient one-form `L²` target, weak derivative, `H¹₀` closure,
  or compact Rellich embedding is constructed from it.
* The gauge firewall defines a Coulomb slice only after callers supply a deck
  pullback and a continuous divergence.  It does not construct those maps, a
  Coulomb projection, a gauge action, or residual gauge directions on the
  actual intrinsic stage.
* The only sector-dependent operator on the actual stage is the bounded
  discriminant multiplier.  A background-holonomy sector makes this safe
  potential exactly zero; it does not create a `U(1)` connection or gauge
  slice.

The theorems below turn these observations into hard analytic firewalls.
The actual stage is infinite dimensional.  Hence:

1. the graph embedding of every *bounded* derivative surrogate has a
   continuous right inverse and is not compact;
2. no full-domain bounded partial map has compact resolvent;
3. every bounded `D†D + V_sector` surrogate is self-adjoint but has neither
   Rellich compactness nor compact resolvent; and
4. if a future actual Hamiltonian has compact resolvent, its shifted operator
   admits no bounded ambient extension.  In particular it cannot agree on its
   whole domain with any bounded `D†D + V_sector` candidate.

No missing geometric or spectral fact is inserted as a structure field or a
hypothesis of a positive paper theorem.
-/


open Function Set Topology
open scoped ComplexConjugate InnerProduct MatrixGroups

namespace QYM.FullCertification.Mock4ActualQuotientH1HamiltonianExtension























/-- The genuine inverse-eta Petersson Hilbert carrier on the intrinsic compact
quotient stage. -/
abbrev ActualStage (Y : ℝ) :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y

/-! ## 1. Exact geometric and gauge-construction boundary -/

/-- All topological cusp-collar facts are proved; adjoining a smooth
manifold-with-boundary atlas is exactly the still-separate residual. -/
theorem actualStage_topological_and_smooth_boundary_iff_smoothResidual
    (Y : ℝ) :
    (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.TopologicalStageBoundaryCollarCertificate Y ∧
        QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageSmoothHalfSpaceAtlasCompatibilityResidual Y) ↔
      QYM.FullCertification.P2StageManifoldWithBoundaryExtension.StageSmoothHalfSpaceAtlasCompatibilityResidual Y :=
  QYM.FullCertification.P2StageManifoldWithBoundaryExtension.topological_and_smooth_stage_boundary_iff_smoothResidual Y

/-- The unconditional topological part of the actual stage boundary. -/
theorem actualStage_topologicalBoundaryCollar
    (Y : ℝ) :
    QYM.FullCertification.P2StageManifoldWithBoundaryExtension.TopologicalStageBoundaryCollarCertificate Y :=
  QYM.FullCertification.P2StageManifoldWithBoundaryExtension.topologicalStageBoundaryCollarCertificate Y

/-- The actual stage has a faithful dense continuous-coordinate core.  This
is deliberately stated with the existing continuous core type, not renamed a
smooth or weak `H¹₀` core. -/
theorem actualStage_continuousCore_injective_dense
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Function.Injective (QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y) ∧
      DenseRange (QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y) :=
  ⟨QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_injective hY,
    QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_denseRange Y⟩

/-- The genuine finite-stage carrier is infinite dimensional. -/
theorem actualStage_not_finiteDimensional
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ FiniteDimensional ℂ (ActualStage Y) :=
  QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStageInverseEtaL2_not_finiteDimensional hY

/-- A `U(1)`-valued background-holonomy tag contributes the zero operator to
the currently constructed safe sector potential.  Thus this tag is not a
construction of a gauge connection, Coulomb projection, or residual gauge
subspace. -/
theorem actualStage_unitaryHolonomy_sectorPotential_eq_zero
    (phase : QYM.FullCertification.P1NotationFirewall.UnitaryHolonomy) (Y : ℝ) :
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator
        (QYM.FullCertification.P1NotationFirewall.QSector.ofBackgroundHolonomy phase) Y = 0 :=
  QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator_ofBackgroundHolonomy
    phase Y

/-- The quotient-ready Coulomb carrier in the existing gauge API remains the
kernel of an explicitly supplied divergence on an explicitly supplied
deck-covariant carrier.  This theorem exposes those inputs in its type and
does not manufacture them from the matter `L²` carrier. -/
theorem supplied_deckCovariantCoulombSlice_mem_iff
    (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y →ₗ[ℂ] QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y)
    (divergence : QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.DeckCovariantGaugeFluctuation Y deckPullback →L[ℂ]
      QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeDivergenceTarget Y)
    (a : QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.DeckCovariantGaugeFluctuation Y deckPullback) :
    a ∈ QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.DeckCovariantCoulombGaugeSlice
        Y deckPullback divergence ↔
      divergence a = 0 :=
  QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.mem_deckCovariantCoulombGaugeSlice_iff
    Y deckPullback divergence a

/-- Even before taking a Coulomb kernel, a supplied deck action must satisfy
the identity and multiplication laws below.  The equality is definitional
and makes the still-unconstructed geometric pullback obligation explicit. -/
theorem supplied_gaugeDeckPullback_isRepresentation_iff
    (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y →ₗ[ℂ] QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y) :
    QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.IsGaugeDeckPullbackRepresentation Y deckPullback ↔
      (∀ a : QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y, deckPullback 1 a = a) ∧
      ∀ (gamma delta : Mock2.Definition15Geometry.Gamma2)
        (a : QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.GaugeFluctuation Y),
        deckPullback (gamma * delta) a =
          deckPullback gamma (deckPullback delta a) := by
  rfl

/-! ## 2. Infinite dimension forbids compact retract embeddings -/

/-- The identity of the actual stage is not compact. -/
theorem actualStage_identity_not_compact
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ IsCompactOperator
      ((ContinuousLinearMap.id ℂ (ActualStage Y) :
        ActualStage Y →L[ℂ] ActualStage Y) :
          ActualStage Y → ActualStage Y) := by
  intro hCompact
  apply actualStage_not_finiteDimensional hY
  apply FiniteDimensional.of_isCompactOperator_id
  simpa only [ContinuousLinearMap.coe_id'] using hCompact

/-- If an embedding into the actual stage has a continuous right inverse,
then it cannot be compact.  Otherwise their composition would make the
identity compact. -/
theorem actualStage_no_compact_embedding_with_continuous_rightInverse
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]
    (j : V →L[ℂ] ActualStage Y) (r : ActualStage Y →L[ℂ] V)
    (hjr : j.comp r = ContinuousLinearMap.id ℂ (ActualStage Y)) :
    ¬ IsCompactOperator (j : V → ActualStage Y) := by
  intro hjCompact
  have hComposition :
      IsCompactOperator
        ((j.comp r : ActualStage Y →L[ℂ] ActualStage Y) :
          ActualStage Y → ActualStage Y) := by
    simpa only [ContinuousLinearMap.coe_comp'] using
      hjCompact.comp_clm r
  rw [hjr] at hComposition
  exact actualStage_identity_not_compact hY hComposition

/-! ## 3. Every bounded derivative graph fails actual Rellich compactness -/

section BoundedDerivativeGraph

variable {K : Type*}
variable [NormedAddCommGroup K] [InnerProductSpace ℂ K]

/-- Full-domain partial-map presentation of an arbitrary bounded derivative
surrogate on the actual stage. -/
def actualStageBoundedDerivativePMap
    (Y : ℝ) (D : ActualStage Y →L[ℂ] K) :
    ActualStage Y →ₗ.[ℂ] K :=
  D.toLinearMap.toPMap ⊤

@[simp]
theorem actualStageBoundedDerivativePMap_domain
    (Y : ℝ) (D : ActualStage Y →L[ℂ] K) :
    (actualStageBoundedDerivativePMap Y D).domain = ⊤ := by
  rfl

/-- The bounded graph map is continuous into the independently typed graph
domain. -/
def actualStageBoundedDerivativeGraphLift
    (Y : ℝ) (D : ActualStage Y →L[ℂ] K) :
    ActualStage Y →L[ℂ]
      QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain (actualStageBoundedDerivativePMap Y D) :=
  ((ContinuousLinearMap.id ℂ (ActualStage Y)).prod D).codRestrict
    (actualStageBoundedDerivativePMap Y D).graph (by
      intro u
      change (u, D u) ∈ (actualStageBoundedDerivativePMap Y D).graph
      rw [LinearPMap.mem_graph_iff]
      refine ⟨⟨u, ?_⟩, rfl, rfl⟩
      simp [actualStageBoundedDerivativePMap])

/-- The graph lift is a continuous right inverse of the graph-domain
embedding. -/
theorem actualStageBoundedDerivative_formEmbedding_comp_graphLift
    (Y : ℝ) (D : ActualStage Y →L[ℂ] K) :
    (QYM.ClosedOperatorEnergyFormExtension.formEmbedding (actualStageBoundedDerivativePMap Y D)).comp
        (actualStageBoundedDerivativeGraphLift Y D) =
      ContinuousLinearMap.id ℂ (ActualStage Y) := by
  apply ContinuousLinearMap.ext
  intro u
  rfl

/-- Exact Rellich no-go for every bounded derivative surrogate on the
genuine stage.  Its graph-domain embedding is never compact. -/
theorem actualStage_boundedDerivative_graphEmbedding_not_compact
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (D : ActualStage Y →L[ℂ] K) :
    ¬ IsCompactOperator
      (QYM.ClosedOperatorEnergyFormExtension.formEmbedding (actualStageBoundedDerivativePMap Y D) :
        QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain (actualStageBoundedDerivativePMap Y D) →
          ActualStage Y) :=
  actualStage_no_compact_embedding_with_continuous_rightInverse hY
    (QYM.ClosedOperatorEnergyFormExtension.formEmbedding (actualStageBoundedDerivativePMap Y D))
    (actualStageBoundedDerivativeGraphLift Y D)
    (actualStageBoundedDerivative_formEmbedding_comp_graphLift Y D)

/-- A bounded orthogonal/Coulomb projection composed with a bounded raw
derivative is still a bounded surrogate. -/
def boundedProjectedDerivativeSurrogate
    {Y : ℝ} (projection : K →L[ℂ] K)
    (rawDerivative : ActualStage Y →L[ℂ] K) :
    ActualStage Y →L[ℂ] K :=
  projection.comp rawDerivative

/-- Consequently a bounded projected derivative cannot produce the required
actual Rellich embedding, regardless of idempotence or symmetry of the
projection. -/
theorem actualStage_boundedProjectedDerivative_Rellich_noGo
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (projection : K →L[ℂ] K)
    (rawDerivative : ActualStage Y →L[ℂ] K) :
    ¬ IsCompactOperator
      (QYM.ClosedOperatorEnergyFormExtension.formEmbedding
          (actualStageBoundedDerivativePMap Y
            (boundedProjectedDerivativeSurrogate projection rawDerivative)) :
        QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain
            (actualStageBoundedDerivativePMap Y
              (boundedProjectedDerivativeSurrogate projection rawDerivative)) →
          ActualStage Y) :=
  actualStage_boundedDerivative_graphEmbedding_not_compact hY
    (boundedProjectedDerivativeSurrogate projection rawDerivative)

end BoundedDerivativeGraph

/-! ## 4. Compact resolvent forces a genuinely unbounded shift -/

/-- Full-domain partial-map presentation of an arbitrary bounded actual-stage
endomorphism. -/
def actualStageBoundedFullDomainPMap
    (Y : ℝ) (A : ActualStage Y →L[ℂ] ActualStage Y) :
    ActualStage Y →ₗ.[ℂ] ActualStage Y :=
  A.toLinearMap.toPMap ⊤

@[simp]
theorem actualStageBoundedFullDomainPMap_domain
    (Y : ℝ) (A : ActualStage Y →L[ℂ] ActualStage Y) :
    (actualStageBoundedFullDomainPMap Y A).domain = ⊤ := by
  rfl

/-- The bounded ambient shift associated with a bounded endomorphism. -/
def actualStageBoundedShift
    (Y : ℝ) (A : ActualStage Y →L[ℂ] ActualStage Y) (z : ℂ) :
    ActualStage Y →L[ℂ] ActualStage Y :=
  z • ContinuousLinearMap.id ℂ (ActualStage Y) - A

theorem actualStageBoundedShift_agrees
    (Y : ℝ) (A : ActualStage Y →L[ℂ] ActualStage Y) (z : ℂ)
    (u : (actualStageBoundedFullDomainPMap Y A).domain) :
    actualStageBoundedShift Y A z (u : ActualStage Y) =
      QYM.UnboundedResolventDataExtension.shifted (actualStageBoundedFullDomainPMap Y A) z u := by
  rfl

/-- Any compact-resolvent operator on the genuine infinite-dimensional stage
has no bounded ambient extension of its shifted action. -/
theorem actualStage_compactResolvent_forces_no_bounded_ambient_shift
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {T : ActualStage Y →ₗ.[ℂ] ActualStage Y} {z : ℂ}
    (hT : QYM.UnboundedResolventDataExtension.HasCompactResolventAt T z) :
    ¬ ∃ A : ActualStage Y →L[ℂ] ActualStage Y,
      ∀ u : T.domain, A (u : ActualStage Y) = QYM.UnboundedResolventDataExtension.shifted T z u := by
  rcases hT with ⟨rho, hRhoCompact⟩
  exact QYM.UnboundedResolventDataExtension.no_boundedShift_of_compactResolvent_in_infiniteDimension
    (actualStage_not_finiteDimensional hY) rho hRhoCompact

/-- No bounded full-domain actual-stage partial map has compact resolvent at
any complex point. -/
theorem actualStage_boundedFullDomainPMap_no_compactResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (A : ActualStage Y →L[ℂ] ActualStage Y) (z : ℂ) :
    ¬ QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (actualStageBoundedFullDomainPMap Y A) z := by
  rintro ⟨rho, hRhoCompact⟩
  apply QYM.UnboundedResolventDataExtension.no_boundedShift_of_compactResolvent_in_infiniteDimension
    (actualStage_not_finiteDimensional hY) rho hRhoCompact
  exact ⟨actualStageBoundedShift Y A z,
    actualStageBoundedShift_agrees Y A z⟩

/-- In particular the currently constructed full-domain sector potential has
no compact resolvent. -/
theorem actualStage_sectorPotentialPMap_no_compactResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (z : ℂ) :
    ¬ QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (QYM.FullCertification.P8ActualStagePotentialSelfAdjointExtension.actualStageSectorDiscriminantPotentialFullDomainPMap
        sector Y) z := by
  simpa [QYM.FullCertification.P8ActualStagePotentialSelfAdjointExtension.actualStageSectorDiscriminantPotentialFullDomainPMap,
    actualStageBoundedFullDomainPMap] using
      actualStage_boundedFullDomainPMap_no_compactResolvent hY
        (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y) z

/-! ## 5. Bounded `D†D + V_sector` is self-adjoint but never the headline
Hamiltonian -/

section BoundedHamiltonian

variable {K : Type*}
variable [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

/-- The strongest bounded surrogate with the requested algebraic spelling.
It is intentionally named a bounded surrogate, not the geometric paper
Hamiltonian. -/
def actualStageBoundedDstarDPlusSectorPotential
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (D : ActualStage Y →L[ℂ] K) :
    ActualStage Y →L[ℂ] ActualStage Y :=
  D.adjoint.comp D +
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y

@[simp]
theorem actualStageBoundedDstarDPlusSectorPotential_apply
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (D : ActualStage Y →L[ℂ] K) (u : ActualStage Y) :
    actualStageBoundedDstarDPlusSectorPotential sector Y D u =
      D.adjoint (D u) +
        QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y u := by
  rfl

/-- The bounded algebraic surrogate is genuinely self-adjoint.  This shows
that self-adjointness alone is not the missing ingredient. -/
theorem actualStageBoundedDstarDPlusSectorPotential_isSelfAdjoint
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (D : ActualStage Y →L[ℂ] K) :
    IsSelfAdjoint
      (actualStageBoundedDstarDPlusSectorPotential sector Y D) := by
  unfold actualStageBoundedDstarDPlusSectorPotential
  exact (D.isPositive_adjoint_comp_self.isSelfAdjoint).add
    (QYM.FullCertification.P8ActualStagePotentialSelfAdjointExtension.actualStageSectorDiscriminantPotentialOperator_isSelfAdjoint
      sector Y)

/-- Full-domain partial-map realization of the bounded surrogate. -/
def actualStageBoundedDstarDPlusSectorPotentialPMap
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (D : ActualStage Y →L[ℂ] K) :
    ActualStage Y →ₗ.[ℂ] ActualStage Y :=
  actualStageBoundedFullDomainPMap Y
    (actualStageBoundedDstarDPlusSectorPotential sector Y D)

/-- The bounded `D†D+V` surrogate has no compact resolvent at any complex
point on the genuine stage. -/
theorem actualStageBoundedDstarDPlusSectorPotential_no_compactResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (D : ActualStage Y →L[ℂ] K) (z : ℂ) :
    ¬ QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (actualStageBoundedDstarDPlusSectorPotentialPMap sector Y D) z :=
  actualStage_boundedFullDomainPMap_no_compactResolvent hY
    (actualStageBoundedDstarDPlusSectorPotential sector Y D) z

/-- A future compact-resolvent Hamiltonian cannot agree on its complete
domain with any bounded `D†D+V_sector` candidate. -/
theorem actualStage_compactResolvent_cannot_agree_with_bounded_DstarDPlusV
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (D : ActualStage Y →L[ℂ] K)
    {T : ActualStage Y →ₗ.[ℂ] ActualStage Y} {z : ℂ}
    (hT : QYM.UnboundedResolventDataExtension.HasCompactResolventAt T z) :
    ¬ ∀ u : T.domain,
      T u = actualStageBoundedDstarDPlusSectorPotential sector Y D
        (u : ActualStage Y) := by
  intro hAgreement
  apply actualStage_compactResolvent_forces_no_bounded_ambient_shift hY hT
  refine
    ⟨z • ContinuousLinearMap.id ℂ (ActualStage Y) -
        actualStageBoundedDstarDPlusSectorPotential sector Y D, ?_⟩
  intro u
  rw [QYM.UnboundedResolventDataExtension.shifted_apply, hAgreement u]
  rfl

/-- Combined actual-stage obstruction.  For any bounded derivative, the
candidate is self-adjoint, but its graph-domain embedding is noncompact and
its `D†D+V` realization has no compact resolvent. -/
theorem actualStage_boundedDerivative_H1_Hamiltonian_double_noGo
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (D : ActualStage Y →L[ℂ] K) (z : ℂ) :
    IsSelfAdjoint
        (actualStageBoundedDstarDPlusSectorPotential sector Y D) ∧
      ¬ IsCompactOperator
        (QYM.ClosedOperatorEnergyFormExtension.formEmbedding (actualStageBoundedDerivativePMap Y D) :
          QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain (actualStageBoundedDerivativePMap Y D) →
            ActualStage Y) ∧
      ¬ QYM.UnboundedResolventDataExtension.HasCompactResolventAt
        (actualStageBoundedDstarDPlusSectorPotentialPMap sector Y D) z := by
  exact
    ⟨actualStageBoundedDstarDPlusSectorPotential_isSelfAdjoint sector Y D,
      actualStage_boundedDerivative_graphEmbedding_not_compact hY D,
      actualStageBoundedDstarDPlusSectorPotential_no_compactResolvent
        hY sector D z⟩

/-- Specialization to an explicitly displayed bounded projection followed by
a bounded raw derivative.  Thus inserting a bounded object and calling it a
`U(1)` Coulomb projection cannot close either Rellich compactness or compact
resolvent on the actual carrier. -/
theorem actualStage_boundedProjectedDerivative_H1_Hamiltonian_double_noGo
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (projection : K →L[ℂ] K)
    (rawDerivative : ActualStage Y →L[ℂ] K) (z : ℂ) :
    IsSelfAdjoint
        (actualStageBoundedDstarDPlusSectorPotential sector Y
          (boundedProjectedDerivativeSurrogate projection rawDerivative)) ∧
      ¬ IsCompactOperator
        (QYM.ClosedOperatorEnergyFormExtension.formEmbedding
            (actualStageBoundedDerivativePMap Y
              (boundedProjectedDerivativeSurrogate projection rawDerivative)) :
          QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain
              (actualStageBoundedDerivativePMap Y
                (boundedProjectedDerivativeSurrogate projection rawDerivative)) →
            ActualStage Y) ∧
      ¬ QYM.UnboundedResolventDataExtension.HasCompactResolventAt
        (actualStageBoundedDstarDPlusSectorPotentialPMap sector Y
          (boundedProjectedDerivativeSurrogate projection rawDerivative)) z :=
  actualStage_boundedDerivative_H1_Hamiltonian_double_noGo hY sector
    (boundedProjectedDerivativeSurrogate projection rawDerivative) z

