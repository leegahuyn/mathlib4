/-! ## 2. The current boundary-parametrization type is not a Jordan API -/

/-- Transparent regularity requirements which are absent from
`G.GammaTwoBoundaryParametrization`.  The four conjuncts say, respectively:
`C^1` regularity on the parameter set, injectivity away from the finite
endpoint set, surjectivity onto the named target, and nonvanishing tangent.
This is a definition of the missing data, not an assertion that the actual
polygon boundary already satisfies it. -/
def IsC1EmbeddedBoundaryParametrization
    (P : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoBoundaryParametrization) : Prop :=
  ContDiffOn ℝ 1 (fun t => ((P.point t : ℍ) : ℂ)) P.parameterSet ∧
    Set.InjOn P.point (P.parameterSet \ (P.endpoints : Set ℝ)) ∧
    P.point '' P.parameterSet = P.target ∧
    ∀ t ∈ P.parameterSet \ (P.endpoints : Set ℝ),
      deriv (fun s => ((P.point s : ℍ) : ℂ)) t ≠ 0

/-- A deliberately degenerate inhabitant of the *existing* parametrization
record.  It satisfies `MapsTo`, showing that the current record itself does
not encode an embedded curve. -/
def constantBoundaryParametrization : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoBoundaryParametrization where
  kind := .verticalSegment
  parameterSet := Set.univ
  endpoints := ∅
  point := fun _ => UpperHalfPlane.I
  target := {UpperHalfPlane.I}
  mapsTo := by
    intro t ht
    simp

/-- Executable obstruction: the current boundary-parametrization type does
not force the additional `C^1` embedded-boundary data required by a
curvilinear Green theorem.  The counterexample is constant, so injectivity on
the nontrivial parameter set fails. -/
theorem gammaTwoBoundaryParametrization_does_not_force_C1Embedding :
    ¬ ∀ P : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoBoundaryParametrization,
      IsC1EmbeddedBoundaryParametrization P := by
  intro hAll
  have hInjective := (hAll constantBoundaryParametrization).2.1
  have hZero : (0 : ℝ) ∈
      constantBoundaryParametrization.parameterSet \
        (constantBoundaryParametrization.endpoints : Set ℝ) := by
    simp [constantBoundaryParametrization]
  have hOne : (1 : ℝ) ∈
      constantBoundaryParametrization.parameterSet \
        (constantBoundaryParametrization.endpoints : Set ℝ) := by
    simp [constantBoundaryParametrization]
  have hEq : (0 : ℝ) = 1 :=
    hInjective hZero hOne rfl
  norm_num at hEq

/-- A transparent finite piecewise-`C^1`/Jordan-style boundary obligation.
It requires actual embedded parametrizations, exact frontier coverage,
intersections only at endpoint images, regular-closedness of the carrier, and
connected interior.  Mathlib currently has no theorem converting this
predicate into the desired Green identity; an oriented-boundary theorem and
the identification with the concrete flux sum are still additionally
required. -/
def HasFinitePiecewiseC1JordanBoundaryPresentation (D : Set ℍ) : Prop :=
  ∃ (n : ℕ) (P : Fin n → Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoBoundaryParametrization),
    (∀ i, IsC1EmbeddedBoundaryParametrization (P i)) ∧
    frontier D = ⋃ i, (P i).target ∧
    (∀ i j, i ≠ j →
      (P i).target ∩ (P j).target ⊆
        (P i).point '' (P i).endpoints ∪
          (P j).point '' (P j).endpoints) ∧
    D = closure (interior D) ∧
    IsConnected (interior D)

/-- The actual geometric carrier whose complete finite Jordan presentation
is needed at cutoff `Ycut`. -/
def ActualTruncatedCarrierHasFinitePiecewiseC1JordanBoundary
    (Ycut : ℝ) : Prop :=
  HasFinitePiecewiseC1JordanBoundaryPresentation
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Ycut)

