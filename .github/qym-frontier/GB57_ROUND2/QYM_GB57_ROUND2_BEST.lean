  refine ⟨?_, ⟨?_,
    QYM.SobolevGaugeSupplierNoGo.unitBinaryCandidate_has_no_sobolevEstimate⟩⟩
  · intro x
    norm_num [QYM.SobolevGaugeSupplierNoGo.unitInputSize]
  · intro z
    norm_num [QYM.SobolevGaugeSupplierNoGo.unitOutputSize]

/-! ## Lemma 4.16: density prerequisite for the admissible form domain -/

/-- Correct density implication from an explicit admissibility-preserving approximation
retraction.  No such retraction is asserted to exist for the paper's gauge slice. -/
def lemma4_16_retractionDensityImplicationStatement : Prop :=
  ∀ (X : Type)
      (close : ℕ → X → X → Prop)
      (core formDomain admissible : X → Prop)
      (project : X → X),
    QYM.SobolevGaugeSupplierNoGo.DenseAtScales close core formDomain →
    (∀ x, admissible x → formDomain x) →
    (∀ x, core x → core (project x)) →
    (∀ x, admissible (project x)) →
    (∀ x, admissible x → project x = x) →
    (∀ scale x y,
      close scale x y → close scale (project x) (project y)) →
      QYM.SobolevGaugeSupplierNoGo.DenseAtScales
        close (fun x => core x ∧ admissible x) admissible

theorem lemma4_16_retractionDensityImplicationStatement_holds :
    lemma4_16_retractionDensityImplicationStatement := by
  intro X close core formDomain admissible project
    hdense hadmissibleInForm hprojectCore hprojectAdmissible
    hprojectFixed hprojectClose
  exact
    QYM.SobolevGaugeSupplierNoGo.intersection_dense_of_admissibilityRetraction
      close core formDomain admissible project hdense hadmissibleInForm
      hprojectCore hprojectAdmissible hprojectFixed hprojectClose

/-- Overstrong finite instance: density in the form domain alone would force density of its
intersection with an unrelated admissible subset. -/
def lemma4_16_formDensityOnlyInferenceStatement : Prop :=
  QYM.SobolevGaugeSupplierNoGo.DenseAtScales
      QYM.SobolevGaugeSupplierNoGo.equalityClose
      QYM.SobolevGaugeSupplierNoGo.finiteCore
      QYM.SobolevGaugeSupplierNoGo.finiteFormDomain →
    QYM.SobolevGaugeSupplierNoGo.DenseAtScales
      QYM.SobolevGaugeSupplierNoGo.equalityClose
      (fun x =>
        QYM.SobolevGaugeSupplierNoGo.finiteCore x ∧
          QYM.SobolevGaugeSupplierNoGo.finiteAdmissible x)
      QYM.SobolevGaugeSupplierNoGo.finiteAdmissible

