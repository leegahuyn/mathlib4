/-!
# The closed energy form of a closed partial operator

Let `D : H →ₗ.[𝕜] K` be a genuine Mathlib `LinearPMap`.  The paper's equation (4.41)
uses the form domain `dom(D)` and the energy

`E_D(x,y) = ⟨D x, D y⟩`.

The inherited norm on the subtype `D.domain` is only the ambient `H` norm, so it is not the
correct topology for a possibly unbounded `D`.  This module instead realizes the form domain as
the actual graph submodule `D.graph ⊆ H × K`.  Its inherited product norm is the max graph norm;
it is quantitatively equivalent to the usual sum graph norm
`‖x‖ + ‖D x‖`.  The two coordinate projections are genuine continuous linear maps, and pulling
the `K` inner product back along the second projection gives a genuine continuous sesquilinear
form on this graph-norm domain.

If `D.IsClosed`, the graph is a complete subset of the complete product, so the form domain is
complete.  Conversely, completeness of the graph in the complete ambient product implies that
the graph is closed.  Thus the predicate `IsClosedEnergyForm` below is equivalent to Mathlib's
actual closed-operator predicate.  Nonnegativity is proved from the norm-square identity and is
not an input field.

For the projected derivative `δ_q` in Lemma 4.13, this construction still requires two honest
paper-specific suppliers:

* an actual `LinearPMap` representing `δ_q` with its boundary/gauge domain;
* proofs that this map is closed and densely defined.

Those facts depend on the distributional closedness argument, the Dirichlet condition, and the
Coulomb slice.  They are deliberately explicit hypotheses of the final theorem below; this
module does not infer them merely from the phrase "first-order differential operator".
-/

namespace QYM.ClosedOperatorEnergyFormExtension

open Filter Set Topology
open scoped ComplexConjugate InnerProduct

variable {𝕜 H K : Type*}
variable [RCLike 𝕜]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
variable [NormedAddCommGroup K] [InnerProductSpace 𝕜 K]

/-! ## The graph-norm form domain -/

/-- The form domain of `E_D` presented with its graph topology.  Algebraically this is equivalent
to `D.domain`, but topologically it carries the product/graph norm rather than the inherited
ambient norm on the domain subtype. -/
abbrev EnergyFormDomain (D : H →ₗ.[𝕜] K) : Type _ :=
  ↑D.graph

/-- The ambient-coordinate embedding of the graph-norm form domain. -/
def formEmbedding (D : H →ₗ.[𝕜] K) :
    EnergyFormDomain D →L[𝕜] H :=
  (ContinuousLinearMap.fst 𝕜 H K).comp
    (Submodule.subtypeL D.graph)

/-- The operator coordinate on the graph-norm form domain. -/
def operatorCoordinate (D : H →ₗ.[𝕜] K) :
    EnergyFormDomain D →L[𝕜] K :=
  (ContinuousLinearMap.snd 𝕜 H K).comp
    (Submodule.subtypeL D.graph)

@[simp]
theorem formEmbedding_apply (D : H →ₗ.[𝕜] K)
    (u : EnergyFormDomain D) :
    formEmbedding D u = (u : H × K).1 :=
  rfl

@[simp]
theorem operatorCoordinate_apply (D : H →ₗ.[𝕜] K)
    (u : EnergyFormDomain D) :
    operatorCoordinate D u = (u : H × K).2 :=
  rfl

/-- The algebraic graph map from the original operator domain to the graph-norm form domain.
It is intentionally only a `LinearMap`: continuity for the inherited ambient norm on `D.domain`
would amount to boundedness of the generally unbounded operator `D`. -/
def domainGraphMap (D : H →ₗ.[𝕜] K) :
    D.domain →ₗ[𝕜] EnergyFormDomain D where
  toFun x := ⟨((x : H), D x), D.mem_graph x⟩
  map_add' x y := by
    apply Subtype.ext
    apply Prod.ext
    · change ((x + y : D.domain) : H) = (x : H) + (y : H)
      rfl
    · change D (x + y) = D x + D y
      exact LinearPMap.map_add D x y
  map_smul' a x := by
    apply Subtype.ext
    apply Prod.ext
    · change ((a • x : D.domain) : H) = a • (x : H)
      rfl
    · change D (a • x) = a • D x
      exact LinearPMap.map_smul D a x

@[simp]
theorem domainGraphMap_coe (D : H →ₗ.[𝕜] K) (x : D.domain) :
    ((domainGraphMap D x : EnergyFormDomain D) : H × K) =
      ((x : H), D x) :=
  rfl

@[simp]
theorem formEmbedding_domainGraphMap
    (D : H →ₗ.[𝕜] K) (x : D.domain) :
    formEmbedding D (domainGraphMap D x) = (x : H) :=
  rfl

@[simp]
theorem operatorCoordinate_domainGraphMap
    (D : H →ₗ.[𝕜] K) (x : D.domain) :
    operatorCoordinate D (domainGraphMap D x) = D x :=
  rfl

/-- The graph map is injective because its first coordinate is the original domain vector. -/
theorem domainGraphMap_injective (D : H →ₗ.[𝕜] K) :
    Function.Injective (domainGraphMap D) := by
  intro x y hxy
  apply Subtype.ext
  simpa only [domainGraphMap_coe] using
    congrArg (fun z : EnergyFormDomain D => (z : H × K).1) hxy

/-- Every point of the graph-norm form domain is the graph of a unique original domain vector. -/
theorem domainGraphMap_surjective (D : H →ₗ.[𝕜] K) :
    Function.Surjective (domainGraphMap D) := by
  intro z
  have hx : (z : H × K).1 ∈ D.domain :=
    LinearPMap.mem_domain_of_mem_graph z.property
  let x : D.domain := ⟨(z : H × K).1, hx⟩
  refine ⟨x, ?_⟩
  apply Subtype.ext
  apply Prod.ext
  · rfl
  · exact ((LinearPMap.image_iff hx).mpr z.property).symm

theorem domainGraphMap_bijective (D : H →ₗ.[𝕜] K) :
    Function.Bijective (domainGraphMap D) :=
  ⟨domainGraphMap_injective D, domainGraphMap_surjective D⟩

/-- The algebraic identification between the printed form domain `dom(D)` and the graph-norm
presentation.  This is not claimed to be continuous for the inherited norm on `D.domain`. -/
noncomputable def domainGraphEquiv (D : H →ₗ.[𝕜] K) :
    D.domain ≃ₗ[𝕜] EnergyFormDomain D :=
  LinearEquiv.ofBijective (domainGraphMap D)
    (domainGraphMap_bijective D)

@[simp]
theorem domainGraphEquiv_apply
    (D : H →ₗ.[𝕜] K) (x : D.domain) :
    domainGraphEquiv D x = domainGraphMap D x :=
  rfl

/-! ## The actual continuous energy form -/

/-- The continuous sesquilinear energy form on the graph-norm form domain.  The first variable is
conjugate-linear and the second variable is linear, following Mathlib's inner-product convention. -/
def energyForm (D : H →ₗ.[𝕜] K) :
    EnergyFormDomain D →L⋆[𝕜] EnergyFormDomain D →L[𝕜] 𝕜 :=
  (innerSL 𝕜).bilinearComp
    (operatorCoordinate D) (operatorCoordinate D)

@[simp]
theorem energyForm_apply (D : H →ₗ.[𝕜] K)
    (u v : EnergyFormDomain D) :
    energyForm D u v =
      inner 𝕜 (operatorCoordinate D u) (operatorCoordinate D v) :=
  rfl

/-- On original domain vectors, the bundled form is exactly `⟨D x, D y⟩`. -/
@[simp]
theorem energyForm_domainGraphMap_apply
    (D : H →ₗ.[𝕜] K) (x y : D.domain) :
    energyForm D (domainGraphMap D x) (domainGraphMap D y) =
      inner 𝕜 (D x) (D y) :=
  rfl

/-- Hermitian symmetry is derived from the target-space inner product. -/
theorem energyForm_isHermitian (D : H →ₗ.[𝕜] K) :
    ∀ u v : EnergyFormDomain D,
      energyForm D u v = star (energyForm D v u) := by
  intro u v
  change inner 𝕜 (operatorCoordinate D u) (operatorCoordinate D v) =
    (starRingEnd 𝕜)
      (inner 𝕜 (operatorCoordinate D v) (operatorCoordinate D u))
  exact (inner_conj_symm
    (operatorCoordinate D u) (operatorCoordinate D v)).symm

/-- The real part of the diagonal energy is the squared norm of the operator coordinate. -/
@[simp]
theorem energyForm_re_self_eq_norm_sq
    (D : H →ₗ.[𝕜] K) (u : EnergyFormDomain D) :
    RCLike.re (energyForm D u u) = ‖operatorCoordinate D u‖ ^ 2 := by
  rw [energyForm_apply, inner_self_eq_norm_sq_to_K]
  simp

/-- The graph-domain energy functional corresponding to equation (4.41). -/
def energy (D : H →ₗ.[𝕜] K) (u : EnergyFormDomain D) : ℝ :=
  ‖operatorCoordinate D u‖ ^ 2

@[simp]
theorem energy_apply (D : H →ₗ.[𝕜] K)
    (u : EnergyFormDomain D) :
    energy D u = ‖operatorCoordinate D u‖ ^ 2 :=
  rfl

/-- The energy is the real part of the diagonal of the actual sesquilinear form. -/
theorem energy_eq_re_energyForm
    (D : H →ₗ.[𝕜] K) (u : EnergyFormDomain D) :
    energy D u = RCLike.re (energyForm D u u) := by
  rw [energyForm_re_self_eq_norm_sq]
  rfl

/-- Nonnegativity is a theorem, with no positivity assumption on `D`. -/
theorem energy_nonnegative (D : H →ₗ.[𝕜] K)
    (u : EnergyFormDomain D) :
    0 ≤ energy D u :=
  sq_nonneg ‖operatorCoordinate D u‖

/-- Equivalent nonnegativity statement in terms of the bundled form. -/
theorem energyForm_nonnegative (D : H →ₗ.[𝕜] K) :
    ∀ u : EnergyFormDomain D,
      0 ≤ RCLike.re (energyForm D u u) := by
  intro u
  rw [energyForm_re_self_eq_norm_sq]
  exact sq_nonneg _

/-! ## Quantitative comparison with the usual sum graph norm -/

/-- The form-domain norm dominates the ambient coordinate. -/
theorem norm_formEmbedding_le
    (D : H →ₗ.[𝕜] K) (u : EnergyFormDomain D) :
    ‖formEmbedding D u‖ ≤ ‖u‖ := by
  change ‖(u : H × K).1‖ ≤ ‖(u : H × K)‖
  exact norm_fst_le (u : H × K)

/-- The form-domain norm dominates the operator coordinate. -/
theorem norm_operatorCoordinate_le
    (D : H →ₗ.[𝕜] K) (u : EnergyFormDomain D) :
    ‖operatorCoordinate D u‖ ≤ ‖u‖ := by
  change ‖(u : H × K).2‖ ≤ ‖(u : H × K)‖
  exact norm_snd_le (u : H × K)

/-- The inherited product norm of a graph point is bounded by the usual sum graph norm. -/
theorem formDomain_norm_le_graphNorm
    (D : H →ₗ.[𝕜] K) (x : D.domain) :
    ‖domainGraphMap D x‖ ≤
      QYM.UnboundedLinearPMapExtension.graphNorm D x := by
  change ‖((x : H), D x)‖ ≤ ‖(x : H)‖ + ‖D x‖
  rw [norm_prod_le_iff]
  exact
    ⟨le_add_of_nonneg_right (norm_nonneg _),
      le_add_of_nonneg_left (norm_nonneg _)⟩

/-- Conversely, the usual sum graph norm is at most twice the inherited product norm. -/
theorem graphNorm_le_two_mul_formDomain_norm
    (D : H →ₗ.[𝕜] K) (x : D.domain) :
    QYM.UnboundedLinearPMapExtension.graphNorm D x ≤
      2 * ‖domainGraphMap D x‖ := by
  have hx : ‖(x : H)‖ ≤ ‖((x : H), D x)‖ :=
    norm_fst_le ((x : H), D x)
  have hDx : ‖D x‖ ≤ ‖((x : H), D x)‖ :=
    norm_snd_le ((x : H), D x)
  change ‖(x : H)‖ + ‖D x‖ ≤
    2 * ‖((x : H), D x)‖
  linarith

/-! ## Density and closedness -/

/-- The range of the graph-domain embedding is exactly the original operator domain. -/
theorem range_formEmbedding_eq_domain (D : H →ₗ.[𝕜] K) :
    Set.range (formEmbedding D) = (D.domain : Set H) := by
  ext x
  constructor
  · rintro ⟨u, rfl⟩
    change (u : H × K).1 ∈ D.domain
    exact LinearPMap.mem_domain_of_mem_graph u.property
  · intro hx
    refine ⟨domainGraphMap D ⟨x, hx⟩, ?_⟩
    rfl

/-- The graph-domain embedding is injective.  This uses the single-valuedness encoded by the
`LinearPMap` graph, not a separately assumed embedding certificate. -/
theorem formEmbedding_injective (D : H →ₗ.[𝕜] K) :
    Function.Injective (formEmbedding D) := by
  intro u v huv
  obtain ⟨x, rfl⟩ := domainGraphMap_surjective D u
  obtain ⟨y, rfl⟩ := domainGraphMap_surjective D v
  have hxyVal : (x : H) = (y : H) := by
    simpa only [formEmbedding_domainGraphMap] using huv
  have hxy : x = y := Subtype.ext hxyVal
  exact congrArg (domainGraphMap D) hxy

/-- Dense definition of `D` is exactly dense range of the form-domain embedding. -/
theorem formEmbedding_denseRange
    {D : H →ₗ.[𝕜] K}
    (hDense : QYM.UnboundedLinearPMapExtension.IsDenselyDefined D) :
    DenseRange (formEmbedding D) := by
  change Dense (Set.range (formEmbedding D))
  rw [range_formEmbedding_eq_domain]
  exact hDense

/-- Closedness of the energy form is represented by completeness of the actual graph subset.
Because the graph norm used above is equivalent to the usual sum graph norm, this is the standard
closed-form condition for `E_D`. -/
def IsClosedEnergyForm (D : H →ₗ.[𝕜] K) : Prop :=
  IsComplete (D.graph : Set (H × K))

section CompleteAmbient

variable [CompleteSpace H] [CompleteSpace K]

/-- In complete ambient Hilbert spaces, the energy form is closed exactly when `D` is a closed
`LinearPMap`. -/
theorem isClosedEnergyForm_iff_operator_isClosed
    (D : H →ₗ.[𝕜] K) :
    IsClosedEnergyForm D ↔ D.IsClosed := by
  constructor
  · intro h
    exact h.isClosed
  · intro h
    exact h.isComplete

theorem isClosedEnergyForm_of_operator_isClosed
    {D : H →ₗ.[𝕜] K} (hD : D.IsClosed) :
    IsClosedEnergyForm D :=
  (isClosedEnergyForm_iff_operator_isClosed D).2 hD

theorem operator_isClosed_of_isClosedEnergyForm
    {D : H →ₗ.[𝕜] K} (hD : IsClosedEnergyForm D) :
    D.IsClosed :=
  (isClosedEnergyForm_iff_operator_isClosed D).1 hD

/-- The concrete completeness instance on the graph-norm form domain supplied by closedness of
the operator.  Downstream constructions can install it locally with
`letI := completeSpaceOfClosedOperator D hD`. -/
noncomputable def completeSpaceOfClosedOperator
    (D : H →ₗ.[𝕜] K) (hD : D.IsClosed) :
    CompleteSpace (EnergyFormDomain D) :=
  hD.isComplete.completeSpace_coe

/-- A Cauchy sequence in the actual graph-norm form domain converges there. -/
theorem cauchySeq_tendsto_in_energyFormDomain
    {D : H →ₗ.[𝕜] K} (hD : D.IsClosed)
    (u : ℕ → EnergyFormDomain D) (hu : CauchySeq u) :
    ∃ z : EnergyFormDomain D, Tendsto u atTop (𝓝 z) := by
  letI := completeSpaceOfClosedOperator D hD
  exact cauchySeq_tendsto_of_complete hu

/-- The coordinate form of the graph-completeness argument used on PDF p.36.  Closedness of `D`
is the exact step which identifies the two ambient limits as another graph point. -/
theorem exists_domain_limit_of_cauchy_coordinates
    {D : H →ₗ.[𝕜] K} (hD : D.IsClosed)
    (u : ℕ → D.domain)
    (hu : CauchySeq (fun n => (u n : H)))
    (hDu : CauchySeq (fun n => D (u n))) :
    ∃ x : D.domain,
      Tendsto (fun n => (u n : H)) atTop (𝓝 (x : H)) ∧
        Tendsto (fun n => D (u n)) atTop (𝓝 (D x)) := by
  obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete hu
  obtain ⟨y, hy⟩ := cauchySeq_tendsto_of_complete hDu
  obtain ⟨hxDomain, hDxy⟩ :=
    QYM.UnboundedLinearPMapExtension.IsClosed.limit_mem_domain_and_apply
      hD u x y hx hy
  refine ⟨⟨x, hxDomain⟩, hx, ?_⟩
  simpa [hDxy] using hy

/-- The exact closed, densely defined, nonnegative energy-form presentation.  The two assumptions
are precisely the paper-specific analytic inputs for `δ_q`; injectivity, dense embedding,
Hermitianity, nonnegativity, and graph-domain completeness are conclusions. -/
theorem closed_dense_nonnegative_energyForm_presentation
    (D : H →ₗ.[𝕜] K)
    (hClosed : D.IsClosed)
    (hDense : QYM.UnboundedLinearPMapExtension.IsDenselyDefined D) :
    IsClosedEnergyForm D ∧
      Function.Injective (formEmbedding D) ∧
        DenseRange (formEmbedding D) ∧
          (∀ u v : EnergyFormDomain D,
            energyForm D u v = star (energyForm D v u)) ∧
            (∀ u : EnergyFormDomain D,
              0 ≤ RCLike.re (energyForm D u u)) := by
  exact
    ⟨isClosedEnergyForm_of_operator_isClosed hClosed,
      formEmbedding_injective D,
      formEmbedding_denseRange hDense,
      energyForm_isHermitian D,
      energyForm_nonnegative D⟩

end CompleteAmbient

end QYM.ClosedOperatorEnergyFormExtension


/-!
# Pure-point decomposition and escape of compact-resolvent eigenvalues

This module completes two operator-theoretic consequences which the paper uses after compactness of
the resolvent.

* The compact self-adjoint inverse has a complete orthogonal family of finite-dimensional
  eigenspaces.  We combine the finite orthonormal bases inside the eigenspaces into an arbitrary
  sigma-indexed orthonormal family and use `HilbertBasis.mkOfOrthogonalEqBot`.  This is the genuine
  infinite-dimensional basis construction; it does not impose a false global `Fintype` instance.
  Exact resolvent spectral mapping shows that every Hilbert-basis vector is an eigenvector of the
  genuine unbounded `LinearPMap`.
* The point spectrum of the unbounded operator is finite in every norm-bounded scalar ball.  Hence
  every point-eigenvalue sequence with finite fibers escapes every bounded set.  In the real
  nonnegative case this is the precise order-theoretic statement `lambda n -> +infinity`.

No Hilbert basis or local-finiteness premise is assumed.  The sequence-divergence results display
their sequence, point-eigenvalue, and finite-fiber assumptions explicitly; they do not claim that
an arbitrary sequence is a surjective multiplicity enumeration.  The only operator-analytic
inputs are an actual self-adjoint `LinearPMap`, genuine resolvent data at a star-fixed parameter,
and compactness of the bounded resolvent inverse.
-/

open Module End Set
open Filter

namespace QYM.CompactResolventPureDiscreteExtension

variable {𝕜 H : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]

abbrev ResolventData (T : H →ₗ.[𝕜] H) (z : 𝕜) :=
  QYM.UnboundedResolventDataExtension.ResolventData T z

/-- The subtype of point eigenvalues of the bounded resolvent inverse. -/
abbrev ResolventEigenvalues
    (T : H →ₗ.[𝕜] H) (z : 𝕜) (ρ : ResolventData T z) :=
  Eigenvalues (ρ.inverse : Module.End 𝕜 H)

/-- Resolvent spectral mapping sends a nonzero inverse eigenvalue `nu` to `z - nu⁻¹`. -/
def operatorEigenvalue
    (T : H →ₗ.[𝕜] H) (z : 𝕜) (ρ : ResolventData T z)
    (ν : ResolventEigenvalues T z ρ) : 𝕜 :=
  z - (ν : 𝕜)⁻¹

/-- Zero cannot be an eigenvalue of a genuine two-sided resolvent inverse. -/
theorem resolventEigenvalue_ne_zero
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (ν : ResolventEigenvalues T z ρ) :
    (ν : 𝕜) ≠ 0 := by
  intro hν
  apply ν.property
  change eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜) = ⊥
  rw [hν]
  exact QYM.UnboundedCompactSpectralMappingExtension.inverse_zero_eigenspace_eq_bot ρ

/-- The unbounded eigenvalue associated to an inverse eigenvalue is never the resolvent point. -/
theorem operatorEigenvalue_ne_resolventParameter
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (ν : ResolventEigenvalues T z ρ) :
    z ≠ operatorEigenvalue T z ρ ν := by
  apply sub_ne_zero.mp
  have hdiff : z - (z - (ν : 𝕜)⁻¹) = (ν : 𝕜)⁻¹ := by ring
  change z - (z - (ν : 𝕜)⁻¹) ≠ 0
  rw [hdiff]
  exact inv_ne_zero (resolventEigenvalue_ne_zero ρ ν)

/-- Exact eigenspace equality at every inverse eigenvalue. -/
theorem operatorEigenspace_operatorEigenvalue
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (ν : ResolventEigenvalues T z ρ) :
    QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T
        (operatorEigenvalue T z ρ ν) =
      eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜) := by
  have hzν := operatorEigenvalue_ne_resolventParameter ρ ν
  have hdiff : z - (z - (ν : 𝕜)⁻¹) = (ν : 𝕜)⁻¹ := by ring
  simpa only [operatorEigenvalue, hdiff, inv_inv] using
    QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace_eq_resolventEigenspace ρ hzν

/-- Every inverse eigenspace is finite-dimensional because its eigenvalue is nonzero. -/
theorem inverseEigenspace_finiteDimensional
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hcompact : ρ.IsCompactResolvent)
    (ν : ResolventEigenvalues T z ρ) :
    FiniteDimensional 𝕜
      (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) :=
  ContinuousLinearMap.finite_dimensional_eigenspace
    (T := ρ.inverse) hcompact (ν : 𝕜)
      (resolventEigenvalue_ne_zero ρ ν)

/-- Consequently every unbounded eigenspace appearing in the resolvent decomposition has finite
multiplicity. -/
theorem operatorEigenspace_operatorEigenvalue_finiteDimensional
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hcompact : ρ.IsCompactResolvent)
    (ν : ResolventEigenvalues T z ρ) :
    FiniteDimensional 𝕜
      (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T
        (operatorEigenvalue T z ρ ν)) := by
  rw [operatorEigenspace_operatorEigenvalue ρ ν]
  exact inverseEigenspace_finiteDimensional ρ hcompact ν

/-! ## Complete orthogonal decomposition and an actual global eigenbasis -/

/-- Compact self-adjoint spectral completeness, restricted to the subtype of actual point
eigenvalues. -/
theorem inverseEigenvalues_orthogonalComplement_eq_bot
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    (⨆ ν : ResolventEigenvalues T z ρ,
      eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜))ᗮ = ⊥ := by
  have hsymm :=
    QYM.UnboundedCompactSpectralMappingExtension.resolvent_inverse_isSymmetric ρ hT hz
  show
    (⨆ ν : {ν : 𝕜 //
        eigenspace (ρ.inverse : Module.End 𝕜 H) ν ≠ ⊥},
      eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜))ᗮ = ⊥
  rw [iSup_ne_bot_subtype,
    ContinuousLinearMap.orthogonalComplement_iSup_eigenspaces_eq_bot
      hcompact hsymm]

/-- The index which records an inverse eigenvalue together with one coordinate in an orthonormal
basis of its finite-dimensional eigenspace. -/
abbrev ResolventEigenbasisIndex
    (T : H →ₗ.[𝕜] H) (z : 𝕜) (ρ : ResolventData T z) :=
  Σ ν : ResolventEigenvalues T z ρ,
    Fin (Module.finrank 𝕜
      (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)))

/-- A genuine global Hilbert basis of the Hilbert space, every member of which is an eigenvector
of the unbounded operator.  Unlike `OrthonormalBasis`, `HilbertBasis` permits an arbitrary
infinite index type and is therefore the correct Mathlib object here.  It is constructed from the
compact self-adjoint spectral theorem and the finite-dimensional bases of the individual
eigenspaces; it is not supplied as a hypothesis. -/
theorem exists_operatorEigen_hilbertBasis
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    ∃ b : HilbertBasis (ResolventEigenbasisIndex T z ρ) 𝕜 H,
      ∀ a : ResolventEigenbasisIndex T z ρ,
        b a ∈ QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T
          (operatorEigenvalue T z ρ a.1) := by
  classical
  have hsymm :=
    QYM.UnboundedCompactSpectralMappingExtension.resolvent_inverse_isSymmetric ρ hT hz
  letI : ∀ ν : ResolventEigenvalues T z ρ,
      FiniteDimensional 𝕜
        (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) :=
    fun ν => inverseEigenspace_finiteDimensional ρ hcompact ν
  let B : ∀ ν : ResolventEigenvalues T z ρ,
      OrthonormalBasis
        (Fin (Module.finrank 𝕜
          (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜))))
        𝕜 (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) :=
    fun ν => stdOrthonormalBasis 𝕜
      (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜))
  let v : ResolventEigenbasisIndex T z ρ → H :=
    fun a =>
      (eigenspace (ρ.inverse : Module.End 𝕜 H) (a.1 : 𝕜)).subtypeₗᵢ
        (B a.1 a.2)
  have hv : Orthonormal 𝕜 v := by
    simpa only [v] using
      hsymm.orthogonalFamily_eigenspaces'.orthonormal_sigma_orthonormal
        (fun ν => (B ν).orthonormal)
  have hiSup_le_span :
      (⨆ ν : ResolventEigenvalues T z ρ,
        eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) ≤
        Submodule.span 𝕜 (Set.range v) := by
    refine iSup_le ?_
    intro ν
    let W : Submodule 𝕜
        (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) :=
      (Submodule.span 𝕜 (Set.range v)).comap
        (eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)).subtype
    have hWtop : W = ⊤ :=
      (Submodule.eq_top_iff_forall_basis_mem (B ν).toBasis).2 (by
        intro i
        change ((B ν i :
          eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) : H) ∈
            Submodule.span 𝕜 (Set.range v)
        apply Submodule.subset_span
        exact ⟨⟨ν, i⟩, rfl⟩)
    intro x hx
    have hxW : (⟨x, hx⟩ :
        eigenspace (ρ.inverse : Module.End 𝕜 H) (ν : 𝕜)) ∈ W := by
      rw [hWtop]
      exact Submodule.mem_top
    exact hxW
  have hspanOrthogonal :
      (Submodule.span 𝕜 (Set.range v))ᗮ = ⊥ := by
    apply le_antisymm
    · exact (Submodule.orthogonal_le hiSup_le_span).trans_eq
        (inverseEigenvalues_orthogonalComplement_eq_bot ρ hT hz hcompact)
    · exact bot_le
  let b : HilbertBasis (ResolventEigenbasisIndex T z ρ) 𝕜 H :=
    HilbertBasis.mkOfOrthogonalEqBot hv hspanOrthogonal
  refine ⟨b, ?_⟩
  intro a
  rw [operatorEigenspace_operatorEigenvalue ρ a.1]
  change b a ∈ eigenspace (ρ.inverse : Module.End 𝕜 H) (a.1 : 𝕜)
  have hb : (b : ResolventEigenbasisIndex T z ρ → H) = v := by
    exact HilbertBasis.coe_mkOfOrthogonalEqBot hv hspanOrthogonal
  rw [show b a = v a by exact congrFun hb a]
  exact (B a.1 a.2).property

/-- Closed proposition recording the pure-point Hilbert-basis conclusion. -/
def HasPurePointHilbertBasis
    (T : H →ₗ.[𝕜] H) (z : 𝕜) (ρ : ResolventData T z) : Prop :=
  ∃ b : HilbertBasis (ResolventEigenbasisIndex T z ρ) 𝕜 H,
    ∀ a : ResolventEigenbasisIndex T z ρ,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvector T
        (operatorEigenvalue T z ρ a.1) (b a)

/-- A self-adjoint operator with a compact resolvent at a star-fixed point has a pure-point
Hilbert basis. -/
theorem hasPurePointHilbertBasis_of_compactResolvent
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    HasPurePointHilbertBasis T z ρ := by
  obtain ⟨b, hb⟩ :=
    exists_operatorEigen_hilbertBasis ρ hT hz hcompact
  refine ⟨b, ?_⟩
  intro a
  exact ⟨hb a, b.orthonormal.ne_zero a⟩

/-! ## Local finiteness of the unbounded point spectrum -/

/-- Point eigenvalues of `T` in a scalar closed ball centered at zero. -/
def pointSpectrumInClosedBall (T : H →ₗ.[𝕜] H) (R : ℝ) : Set 𝕜 :=
  {lambda : 𝕜 |
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda ∧
      ‖lambda‖ ≤ R}

/-- The complete point spectrum as a scalar set. -/
def pointSpectrum (T : H →ₗ.[𝕜] H) : Set 𝕜 :=
  {lambda : 𝕜 |
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda}

/-- A compact resolvent makes the unbounded point spectrum finite in every norm-bounded ball.
This is the enumeration-free content behind divergence of discrete eigenvalues. -/
theorem pointSpectrumInClosedBall_finite_of_compactResolvent
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) (R : ℝ) :
    (pointSpectrumInClosedBall T R).Finite := by
  classical
  by_cases hR : 0 ≤ R
  · let radius : ℝ := (1 + ‖z‖ + R)⁻¹
    have hdenom : 0 < 1 + ‖z‖ + R := by positivity
    have hradius : 0 < radius := inv_pos.mpr hdenom
    have hAway :=
      QYM.UnboundedCompactSpectralMappingExtension.resolvent_inverse_awayFromZeroPointSpectrumFinite ρ hT hz hcompact
    have hfinite := hAway.finite_away_from_zero radius hradius
    have himage :
        (fun lambda : 𝕜 => (z - lambda)⁻¹) '' pointSpectrumInClosedBall T R ⊆
          {ν : 𝕜 |
            HasEigenvalue (ρ.inverse : Module.End 𝕜 H) ν ∧
              radius ≤ ‖ν‖} := by
      rintro ν ⟨lambda, hlambda, rfl⟩
      have hzlambda : z ≠ lambda := by
        intro heq
        subst lambda
        exact
          QYM.UnboundedCompactSpectralMappingExtension.not_hasPMapEigenvalue_at_resolvent ρ hlambda.1
      refine ⟨(QYM.UnboundedCompactSpectralMappingExtension.hasPMapEigenvalue_iff_resolvent_hasEigenvalue ρ hzlambda).mp hlambda.1, ?_⟩
      have hnormPos : 0 < ‖z - lambda‖ :=
        norm_pos_iff.mpr (sub_ne_zero.mpr hzlambda)
      have hnormUpper : ‖z - lambda‖ ≤ 1 + ‖z‖ + R := by
        calc
          ‖z - lambda‖ ≤ ‖z‖ + ‖lambda‖ := norm_sub_le z lambda
          _ ≤ ‖z‖ + R := add_le_add_right hlambda.2 ‖z‖
          _ ≤ 1 + ‖z‖ + R := by linarith
      dsimp only [radius]
      rw [norm_inv]
      exact (inv_le_inv₀ hdenom hnormPos).2 hnormUpper
    have hinjective :
        Set.InjOn (fun lambda : 𝕜 => (z - lambda)⁻¹)
          (pointSpectrumInClosedBall T R) := by
      intro a _ b _ hab
      have hsub : z - a = z - b := inv_injective hab
      exact sub_right_inj.mp hsub
    exact (hfinite.subset himage).of_finite_image hinjective
  · apply Set.finite_empty.subset
    intro lambda hlambda
    exact (hR ((norm_nonneg lambda).trans hlambda.2)).elim

/-- The unbounded point spectrum is countable: it is the union of its finite intersections with
integer-radius closed balls. -/
theorem pointSpectrum_countable_of_compactResolvent
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    (pointSpectrum T).Countable := by
  apply (Set.countable_iUnion fun n : ℕ =>
    (pointSpectrumInClosedBall_finite_of_compactResolvent
      ρ hT hz hcompact (n : ℝ)).countable).mono
  intro lambda hlambda
  obtain ⟨n, hn⟩ := exists_nat_ge ‖lambda‖
  exact Set.mem_iUnion.mpr ⟨n, hlambda, hn⟩

/-! ## Enumeration-free and enumerated divergence -/

/-- Every bounded portion of an injective point-eigenvalue sequence has only finitely many
indices.  No surjectivity onto the point spectrum is asserted. -/
theorem finite_indices_norm_le_of_injective_pointEigenvalueSequence
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent)
    (eigenvalue : ℕ → 𝕜)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hinjective : Function.Injective eigenvalue) (R : ℝ) :
    {n : ℕ | ‖eigenvalue n‖ ≤ R}.Finite := by
  have hfinite :=
    pointSpectrumInClosedBall_finite_of_compactResolvent
      ρ hT hz hcompact R
  have himage :
      eigenvalue '' {n : ℕ | ‖eigenvalue n‖ ≤ R} ⊆
        pointSpectrumInClosedBall T R := by
    rintro lambda ⟨n, hn, rfl⟩
    exact ⟨heigen n, hn⟩
  exact (hfinite.subset himage).of_finite_image hinjective.injOn

/-- The same finiteness conclusion for a point-eigenvalue sequence with finite fibers. -/
theorem finite_indices_norm_le_of_finiteFiber_pointEigenvalueSequence
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent)
    (eigenvalue : ℕ → 𝕜)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hfiniteFiber : ∀ lambda : 𝕜, {n : ℕ | eigenvalue n = lambda}.Finite)
    (R : ℝ) :
    {n : ℕ | ‖eigenvalue n‖ ≤ R}.Finite := by
  have hfinite :=
    pointSpectrumInClosedBall_finite_of_compactResolvent
      ρ hT hz hcompact R
  have hpreimage :
      (eigenvalue ⁻¹' pointSpectrumInClosedBall T R).Finite :=
    hfinite.preimage' fun lambda _ => by
      convert hfiniteFiber lambda using 1
      ext n
      simp
  convert hpreimage using 1
  ext n
  simp only [Set.mem_setOf_eq, Set.mem_preimage, pointSpectrumInClosedBall, heigen n,
    true_and]

/-- An injective point-eigenvalue sequence eventually leaves every norm ball. -/
theorem injective_pointEigenvalueSequence_norm_eventually_gt
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent)
    (eigenvalue : ℕ → 𝕜)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hinjective : Function.Injective eigenvalue) :
    ∀ R : ℝ, ∀ᶠ n : ℕ in atTop, R < ‖eigenvalue n‖ := by
  intro R
  have hfinite := finite_indices_norm_le_of_injective_pointEigenvalueSequence
    ρ hT hz hcompact eigenvalue heigen hinjective R
  have heventually := hfinite.eventually_cofinite_notMem
  rw [Nat.cofinite_eq_atTop] at heventually
  filter_upwards [heventually] with n hn
  simpa only [Set.mem_setOf_eq, not_le] using hn

/-- A finite-fiber point-eigenvalue sequence eventually leaves every norm ball. -/
theorem finiteFiber_pointEigenvalueSequence_norm_eventually_gt
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent)
    (eigenvalue : ℕ → 𝕜)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hfiniteFiber : ∀ lambda : 𝕜, {n : ℕ | eigenvalue n = lambda}.Finite) :
    ∀ R : ℝ, ∀ᶠ n : ℕ in atTop, R < ‖eigenvalue n‖ := by
  intro R
  have hfinite := finite_indices_norm_le_of_finiteFiber_pointEigenvalueSequence
    ρ hT hz hcompact eigenvalue heigen hfiniteFiber R
  have heventually := hfinite.eventually_cofinite_notMem
  rw [Nat.cofinite_eq_atTop] at heventually
  filter_upwards [heventually] with n hn
  simpa only [Set.mem_setOf_eq, not_le] using hn

/-- Norms in every finite-fiber point-eigenvalue sequence tend to positive infinity. -/
theorem finiteFiber_pointEigenvalueSequence_norm_tendsto_atTop
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent)
    (eigenvalue : ℕ → 𝕜)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hfiniteFiber : ∀ lambda : 𝕜, {n : ℕ | eigenvalue n = lambda}.Finite) :
    Tendsto (fun n => ‖eigenvalue n‖) atTop atTop := by
  apply tendsto_atTop.2
  intro R
  exact (finiteFiber_pointEigenvalueSequence_norm_eventually_gt
    ρ hT hz hcompact eigenvalue heigen hfiniteFiber R).mono
      (fun _ hn => hn.le)

/-- For a nonnegative real operator, the enumerated eigenvalues themselves tend to positive
infinity, not merely their absolute values. -/
theorem nonnegative_finiteFiber_pointEigenvalueSequence_tendsto_atTop
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {T : H →ₗ.[ℝ] H} {z : ℝ} (ρ : ResolventData T z)
    (hT : IsSelfAdjoint T)
    (hcompact : ρ.IsCompactResolvent)
    (hnonnegative :
      QYM.UnboundedCompactSpectralMappingExtension.IsQuadraticallyNonnegative T)
    (eigenvalue : ℕ → ℝ)
    (heigen : ∀ n, QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hfiniteFiber : ∀ lambda : ℝ, {n : ℕ | eigenvalue n = lambda}.Finite) :
    Tendsto eigenvalue atTop atTop := by
  have hnorm := finiteFiber_pointEigenvalueSequence_norm_tendsto_atTop
    ρ hT (by simp) hcompact eigenvalue heigen hfiniteFiber
  have hfun : (fun n => ‖eigenvalue n‖) = eigenvalue := by
    funext n
    rw [Real.norm_eq_abs, abs_of_nonneg]
    exact QYM.UnboundedCompactSpectralMappingExtension.real_pmap_eigenvalue_nonnegative hnonnegative (heigen n)
  simpa only [hfun] using hnorm

end QYM.CompactResolventPureDiscreteExtension


/-!
# Multiplicity-safe low-lying gaps and their asymptotic liminf

The paper identifies `lambda 1 - lambda 0` with the first level outside a matched null-space.  That
identification is false when the ground eigenspace has multiplicity greater than one.  The existing
finite countermodel in `QYM.SpectralFlowCore.GroundMultiplicityCounterexample` records this exact
failure.

This module supplies the corrected operator theorem at the strength actually justified by compact
resolvent and coercivity:

* construct the least nonzero eigenvalue without assuming an enumeration;
* retain the full finite-dimensional ground eigenspace;
* construct a pure-point Hilbert basis and countable point spectrum;
* for a uniformly coercive truncation family, choose all pointwise gaps and prove positivity of the
  `ENNReal` liminf;
* if an external enumeration is used, state the exact extra condition saying that index `1` is
  outside the ground block.

Thus no simplicity of the ground state and no unjustified adjacent-index inference is hidden in a
definition.
-/

open Module End Set
open Filter

namespace QYM.CompactResolventLowLyingGapExtension

variable {H : Type*} [NormedAddCommGroup H]
variable [InnerProductSpace ℝ H] [CompleteSpace H]

abbrev ResolventData (T : H →ₗ.[ℝ] H) (z : ℝ) :=
  QYM.UnboundedResolventDataExtension.ResolventData T z

/-- A complete, multiplicity-safe certificate for the first level outside the zero eigenspace. -/
structure MultiplicitySafeGapWitness
    (T : H →ₗ.[ℝ] H) (c gap : ℝ) : Prop where
  ground_eigenvalue :
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T 0
  ground_finite :
    FiniteDimensional ℝ
      (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T 0)
  lower : c ≤ gap
  positive : 0 < gap
  gap_eigenvalue :
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T gap
  gap_finite :
    FiniteDimensional ℝ
      (QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T gap)
  least_nonzero :
    ∀ lambda : ℝ, lambda ≠ 0 →
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda →
        gap ≤ lambda

/-- Compactness constructs the local-finiteness input, so the least off-ground gap needs no
spectral supplier. -/
theorem exists_multiplicitySafeGapWitness
    {T : H →ₗ.[ℝ] H} {μ c : ℝ}
    (hμ : 0 < μ) (hc : 0 < c)
    (hT : IsSelfAdjoint T)
    (ρ : ResolventData T (-μ))
    (hcompact : ρ.IsCompactResolvent)
    (hcoercive :
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c)
    (hzero :
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T 0)
    (hnonzero : ∃ lambda : ℝ, lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda) :
    ∃ gap : ℝ, MultiplicitySafeGapWitness T c gap := by
  obtain ⟨gap, hground, hgroundFinite, hlower, hpositive,
      hgapEigen, hgapFinite, hleast⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.exists_multiplicitySafe_least_offGround_level_of_compact_negative_resolvent
        hμ hc hT ρ hcompact hcoercive hzero hnonzero
  exact ⟨gap, {
    ground_eigenvalue := hground
    ground_finite := hgroundFinite
    lower := hlower
    positive := hpositive
    gap_eigenvalue := hgapEigen
    gap_finite := hgapFinite
    least_nonzero := hleast }⟩

/-- The complete corrected pure-discrete package: actual Hilbert eigenbasis, countable point
spectrum, and a least positive off-ground level with its multiplicity. -/
theorem pureDiscrete_multiplicitySafeGap_package
    {T : H →ₗ.[ℝ] H} {μ c : ℝ}
    (hμ : 0 < μ) (hc : 0 < c)
    (hT : IsSelfAdjoint T)
    (ρ : ResolventData T (-μ))
    (hcompact : ρ.IsCompactResolvent)
    (hcoercive :
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c)
    (hzero :
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T 0)
    (hnonzero : ∃ lambda : ℝ, lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda) :
    QYM.CompactResolventPureDiscreteExtension.HasPurePointHilbertBasis
        T (-μ) ρ ∧
      (QYM.CompactResolventPureDiscreteExtension.pointSpectrum T).Countable ∧
      ∃ gap : ℝ, MultiplicitySafeGapWitness T c gap := by
  refine ⟨?_, ?_, ?_⟩
  · exact
      QYM.CompactResolventPureDiscreteExtension.hasPurePointHilbertBasis_of_compactResolvent ρ hT (by simp) hcompact
  · exact
      QYM.CompactResolventPureDiscreteExtension.pointSpectrum_countable_of_compactResolvent ρ hT (by simp) hcompact
  · exact exists_multiplicitySafeGapWitness
      hμ hc hT ρ hcompact hcoercive hzero hnonzero

/-! ## Exact adjacent-index boundary -/

/-- The adjacent low-lying gap of a displayed real eigenvalue enumeration. -/
def adjacentGroundGap (eigenvalue : ℕ → ℝ) : ℝ :=
  eigenvalue 1 - eigenvalue 0

/-- The gap from the ground value to a displayed off-ground index. -/
def offGroundGap (eigenvalue : ℕ → ℝ) (k : ℕ) : ℝ :=
  eigenvalue k - eigenvalue 0

/-- If index `1` is genuinely outside the zero eigenspace, ground-complement coercivity proves the
paper's adjacent-index lower bound.  This explicitly records the missing ground-multiplicity
condition. -/
theorem adjacentGroundGap_ge_of_indexOne_offGround
    {T : H →ₗ.[ℝ] H} {c : ℝ}
    (hT : IsSelfAdjoint T)
    (hcoercive :
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c)
    (eigenvalue : ℕ → ℝ)
    (heigen : ∀ n,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hground : eigenvalue 0 = 0)
    (hone : eigenvalue 1 ≠ 0) :
    c ≤ adjacentGroundGap eigenvalue := by
  have hsymm :=
    QYM.UnboundedCompactSpectralMappingExtension.pmap_isFormalAdjoint_of_selfAdjoint hT
  obtain ⟨x, hx⟩ := (heigen 1).exists_hasPMapEigenvector
  have hlower :=
    QYM.UnboundedCompactSpectralMappingExtension.real_pmap_eigenvalue_ge_of_groundComplementCoercivity
      hsymm hcoercive hone hx
  simpa only [adjacentGroundGap, hground, sub_zero] using hlower

/-- Any displayed off-ground eigenvalue, at any index, satisfies the coercive gap bound from a zero
ground value. -/
theorem offGroundGap_ge
    {T : H →ₗ.[ℝ] H} {c : ℝ}
    (hT : IsSelfAdjoint T)
    (hcoercive :
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c)
    (eigenvalue : ℕ → ℝ)
    (heigen : ∀ n,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hground : eigenvalue 0 = 0)
    {k : ℕ} (hk : eigenvalue k ≠ 0) :
    c ≤ offGroundGap eigenvalue k := by
  have hsymm :=
    QYM.UnboundedCompactSpectralMappingExtension.pmap_isFormalAdjoint_of_selfAdjoint hT
  obtain ⟨x, hx⟩ := (heigen k).exists_hasPMapEigenvector
  have hlower :=
    QYM.UnboundedCompactSpectralMappingExtension.real_pmap_eigenvalue_ge_of_groundComplementCoercivity
      hsymm hcoercive hk hx
  simpa only [offGroundGap, hground, sub_zero] using hlower

/-- The first nonzero index of any enumeration which contains at least one nonzero value. -/
noncomputable def firstOffGroundIndex
    (eigenvalue : ℕ → ℝ) (hexists : ∃ n, eigenvalue n ≠ 0) : ℕ :=
  Nat.find hexists

theorem firstOffGroundIndex_value_ne_zero
    (eigenvalue : ℕ → ℝ) (hexists : ∃ n, eigenvalue n ≠ 0) :
    eigenvalue (firstOffGroundIndex eigenvalue hexists) ≠ 0 :=
  by
    simpa only [firstOffGroundIndex] using Nat.find_spec hexists

theorem value_eq_zero_before_firstOffGroundIndex
    (eigenvalue : ℕ → ℝ) (hexists : ∃ n, eigenvalue n ≠ 0)
    {n : ℕ} (hn : n < firstOffGroundIndex eigenvalue hexists) :
    eigenvalue n = 0 := by
  by_contra hne
  have hmin : firstOffGroundIndex eigenvalue hexists ≤ n := by
    simpa only [firstOffGroundIndex] using Nat.find_min' hexists hne
  exact (Nat.not_lt_of_ge hmin) hn

theorem firstOffGroundIndex_pos
    (eigenvalue : ℕ → ℝ) (hexists : ∃ n, eigenvalue n ≠ 0)
    (hground : eigenvalue 0 = 0) :
    0 < firstOffGroundIndex eigenvalue hexists := by
  by_contra hnot
  have hzeroIndex : firstOffGroundIndex eigenvalue hexists = 0 := Nat.eq_zero_of_not_pos hnot
  have hvalueZero : eigenvalue (firstOffGroundIndex eigenvalue hexists) = 0 := by
    rw [hzeroIndex, hground]
  exact firstOffGroundIndex_value_ne_zero eigenvalue hexists hvalueZero

/-- A multiplicity-safe enumeration theorem: construct the first displayed nonzero index following
the initial zero segment and prove its gap, without identifying that index with `1`.  No ordering
or multiplicity convention for the remaining displayed indices is assumed. -/
theorem firstOffGroundGap_ge
    {T : H →ₗ.[ℝ] H} {c : ℝ}
    (hT : IsSelfAdjoint T)
    (hcoercive :
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity T c)
    (eigenvalue : ℕ → ℝ)
    (heigen : ∀ n,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T (eigenvalue n))
    (hground : eigenvalue 0 = 0)
    (hexists : ∃ n, eigenvalue n ≠ 0) :
    c ≤ offGroundGap eigenvalue (firstOffGroundIndex eigenvalue hexists) :=
  offGroundGap_ge hT hcoercive eigenvalue heigen hground
    (firstOffGroundIndex_value_ne_zero eigenvalue hexists)

/-! ## Uniform families and the corrected asymptotic liminf -/

/-- Pointwise compact-resolvent and uniform coercivity data construct a full gap witness at every
truncation index. -/
theorem exists_multiplicitySafeGapWitness_family
    {T : ℕ → H →ₗ.[ℝ] H} {μ : ℕ → ℝ} {c : ℝ}
    (ρ : ∀ Y, ResolventData (T Y) (-(μ Y)))
    (hμ : ∀ Y, 0 < μ Y) (hc : 0 < c)
    (hT : ∀ Y, IsSelfAdjoint (T Y))
    (hcompact : ∀ Y, (ρ Y).IsCompactResolvent)
    (hcoercive : ∀ Y,
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity
        (T Y) c)
    (hzero : ∀ Y,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T Y) 0)
    (hnonzero : ∀ Y, ∃ lambda : ℝ, lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T Y) lambda) :
    ∀ Y, ∃ gap : ℝ, MultiplicitySafeGapWitness (T Y) c gap := by
  intro Y
  exact exists_multiplicitySafeGapWitness
    (hμ Y) hc (hT Y) (ρ Y) (hcompact Y)
    (hcoercive Y) (hzero Y) (hnonzero Y)

/-- Choose the internally constructed gaps and pass their uniform positive lower bound to the
`ENNReal` liminf.  This is the corrected unconditional functional-analysis form of the asymptotic
gap step; it does not identify an adjacent eigenvalue index when the ground space is multiple. -/
theorem exists_gapFamily_with_positive_ennreal_liminf
    {T : ℕ → H →ₗ.[ℝ] H} {μ : ℕ → ℝ} {c : ℝ}
    (ρ : ∀ Y, ResolventData (T Y) (-(μ Y)))
    (hμ : ∀ Y, 0 < μ Y) (hc : 0 < c)
    (hT : ∀ Y, IsSelfAdjoint (T Y))
    (hcompact : ∀ Y, (ρ Y).IsCompactResolvent)
    (hcoercive : ∀ Y,
      QYM.UnboundedCompactSpectralMappingExtension.HasGroundComplementCoercivity
        (T Y) c)
    (hzero : ∀ Y,
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T Y) 0)
    (hnonzero : ∀ Y, ∃ lambda : ℝ, lambda ≠ 0 ∧
      QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue (T Y) lambda) :
    ∃ gap : ℕ → ℝ,
      (∀ Y, MultiplicitySafeGapWitness (T Y) c (gap Y)) ∧
      0 < liminf (fun Y => ENNReal.ofReal (gap Y)) atTop := by
  have hpointwise := exists_multiplicitySafeGapWitness_family
    ρ hμ hc hT hcompact hcoercive hzero hnonzero
  choose gap hgap using hpointwise
  refine ⟨gap, hgap, ?_⟩
  apply QYM.AsymptoticGapLiminf.ennreal_liminf_pos
    (gap := fun Y ↦ ENNReal.ofReal (gap Y))
    (δ := ENNReal.ofReal c) (ENNReal.ofReal_pos.mpr hc)
  intro Y
  exact ENNReal.ofReal_le_ofReal (hgap Y).lower

end QYM.CompactResolventLowLyingGapExtension


/-!
# Paper-normalized closed-form, pure-discrete, and multiplicity-safe gap statements

This file exposes the exact functional-analytic conclusions proved by the continuation modules in
the numbering used by the paper.  The names deliberately distinguish exact operator-theoretic
components from paper-specific PDE inputs.  In particular:

* Lemma 4.13 still receives the genuinely analytic facts that the displayed differential operator
  is closed and densely defined; closedness, density of the graph-domain embedding, Hermitianity,
  and nonnegativity of its energy form are then conclusions.
* Lemma 4.18 receives an actual compact resolvent.  Pure-point completeness, finite local point
  spectrum, countability, and divergence of every finite-multiplicity real nonnegative
  point-eigenvalue sequence are conclusions rather than spectral suppliers.
* Appendix Theorem A.7 and Corollary 4.25 are stated in a ground-multiplicity-safe form.  No theorem
  identifies the first off-ground index with `1` unless that extra fact is displayed explicitly.

Every definition below is a closed proposition, and the adjacent `_holds` theorem is its proof.
-/

open Filter Module End Set

namespace QYM.FullCertification.PaperNormalized

/-! ## Lemma 4.13: graph-norm realization of the energy form -/

def lemma4_13_closedDenseNonnegativeEnergyFormComponentStatement : Prop :=
  ∀ (𝕜 H K : Type*) [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      [NormedAddCommGroup K] [InnerProductSpace 𝕜 K] [CompleteSpace K]
      (D : H →ₗ.[𝕜] K),
    D.IsClosed →
    QYM.UnboundedLinearPMapExtension.IsDenselyDefined D →
      QYM.ClosedOperatorEnergyFormExtension.IsClosedEnergyForm D ∧
      Function.Injective
        (QYM.ClosedOperatorEnergyFormExtension.formEmbedding D) ∧
      DenseRange (QYM.ClosedOperatorEnergyFormExtension.formEmbedding D) ∧
      (∀ u v : QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain D,
        QYM.ClosedOperatorEnergyFormExtension.energyForm D u v =
          star (QYM.ClosedOperatorEnergyFormExtension.energyForm D v u)) ∧
      (∀ u : QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain D,
        0 ≤ RCLike.re
          (QYM.ClosedOperatorEnergyFormExtension.energyForm D u u))

theorem lemma4_13_closedDenseNonnegativeEnergyFormComponentStatement_holds :
    lemma4_13_closedDenseNonnegativeEnergyFormComponentStatement := by
  intro 𝕜 H K _ _ _ _ _ _ _ D hclosed hdense
  exact
    QYM.ClosedOperatorEnergyFormExtension.closed_dense_nonnegative_energyForm_presentation D hclosed hdense

def lemma4_13_closedGraphCoordinateLimitComponentStatement : Prop :=
  ∀ (𝕜 H K : Type*) [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      [NormedAddCommGroup K] [InnerProductSpace 𝕜 K] [CompleteSpace K]
      (D : H →ₗ.[𝕜] K),
    D.IsClosed →
    ∀ (u : ℕ → D.domain),
      CauchySeq (fun n ↦ (u n : H)) →
      CauchySeq (fun n ↦ D (u n)) →
        ∃ x : D.domain,
          Tendsto (fun n ↦ (u n : H)) atTop (𝓝 (x : H)) ∧
          Tendsto (fun n ↦ D (u n)) atTop (𝓝 (D x))

theorem lemma4_13_closedGraphCoordinateLimitComponentStatement_holds :
    lemma4_13_closedGraphCoordinateLimitComponentStatement := by
  intro 𝕜 H K _ _ _ _ _ _ _ D hclosed u hu hDu
  exact
    QYM.ClosedOperatorEnergyFormExtension.exists_domain_limit_of_cauchy_coordinates hclosed u hu hDu

/-! ## Lemma 4.18: compact resolvent consequences -/

def lemma4_18_compactResolventPurePointHilbertBasisComponentStatement : Prop :=
  ∀ (𝕜 H : Type*) [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    IsSelfAdjoint T →
    star z = z →
    ρ.IsCompactResolvent →
      QYM.CompactResolventPureDiscreteExtension.HasPurePointHilbertBasis
        T z ρ

theorem lemma4_18_compactResolventPurePointHilbertBasisComponentStatement_holds :
    lemma4_18_compactResolventPurePointHilbertBasisComponentStatement := by
  intro 𝕜 H _ _ _ _ T z ρ hT hz hcompact
  exact
    QYM.CompactResolventPureDiscreteExtension.hasPurePointHilbertBasis_of_compactResolvent ρ hT hz hcompact

def lemma4_18_compactResolventPointSpectrumLocallyFiniteComponentStatement : Prop :=
  ∀ (𝕜 H : Type*) [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    IsSelfAdjoint T →
    star z = z →
    ρ.IsCompactResolvent →
    ∀ R : ℝ,
      (QYM.CompactResolventPureDiscreteExtension.pointSpectrumInClosedBall T R).Finite

theorem lemma4_18_compactResolventPointSpectrumLocallyFiniteComponentStatement_holds :
    lemma4_18_compactResolventPointSpectrumLocallyFiniteComponentStatement := by
  intro 𝕜 H _ _ _ _ T z ρ hT hz hcompact R
  exact
    QYM.CompactResolventPureDiscreteExtension.pointSpectrumInClosedBall_finite_of_compactResolvent ρ hT hz hcompact R

def lemma4_18_compactResolventPointSpectrumCountableComponentStatement : Prop :=
  ∀ (𝕜 H : Type*) [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    IsSelfAdjoint T →
    star z = z →
