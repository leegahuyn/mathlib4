namespace QYM.FullCertification.P2HhalfClosabilityExtension






/-!
# Closability of the width-two twisted difference quotient

The previous fractional-boundary construction took the topological closure
of the graph of the twisted difference quotient.  A graph closure is the
graph of an operator only when it has no nonzero vertical fibre.  This file
proves that missing statement.

The proof does not assume that the transition `tau` is bounded or even
measurable.  Starting with `f_n -> 0` in the parameter `L2` space and
`D_tau f_n -> g` in the product `L2` space, convergence in measure supplies a
subsequence of `f_n` converging almost everywhere.  A second subsequence
makes `D_tau f_n` converge almost everywhere to `g`.  Pullback of the first
null set by the two product projections makes both values `f_n(x)` and
`f_n(y)` converge to zero.  The displayed formula for `D_tau` is pointwise
continuous in those two values, so uniqueness of pointwise limits gives
`g = 0` almost everywhere.

Consequently the first projection of the closed graph is injective.  We only
construct an algebraic inverse on its exact range; no false continuous
embedding into ambient `L2`, and no impossible right inverse defined on all
of `L2`, is asserted.
-/

/-! ## 1. Pointwise continuity of the displayed twisted quotient -/

/-- The twisted numerator tends to zero whenever its two input values do. -/
theorem widthTwoTwistedIncrement_tendsto_zero
    (tau : ℝ → ℂ) (f : ℕ → ℝ → ℂ) (x y : ℝ)
    (hx : Tendsto (fun n => f n x) atTop (𝓝 0))
    (hy : Tendsto (fun n => f n y) atTop (𝓝 0)) :
    Tendsto
      (fun n => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedIncrement tau (f n) x y)
      atTop (𝓝 0) := by
  by_cases hxy : 1 < x - y
  · simpa [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedIncrement, hxy] using
      hx.sub (tendsto_const_nhds.mul hy)
  · by_cases hyx : 1 < y - x
    · simpa [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedIncrement, hxy, hyx] using
        (tendsto_const_nhds.mul hx).sub hy
    · simpa [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedIncrement, hxy, hyx] using
        hx.sub hy

/-- Pointwise continuity of the full quotient at the zero pair.  The zero
distance branch is constant; otherwise division is by one fixed scalar. -/
theorem widthTwoTwistedDifferenceQuotient_tendsto_zero
    (tau : ℝ → ℂ) (f : ℕ → ℝ → ℂ) (x y : ℝ)
    (hx : Tendsto (fun n => f n x) atTop (𝓝 0))
    (hy : Tendsto (fun n => f n y) atTop (𝓝 0)) :
    Tendsto
      (fun n => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau (f n) (x, y))
      atTop (𝓝 0) := by
  by_cases hdist : QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoCircularDistance x y = 0
  · simpa [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient, hdist] using
      (tendsto_const_nhds :
        Tendsto (fun _ : ℕ => (0 : ℂ)) atTop (𝓝 0))
  · have hIncrement :=
      widthTwoTwistedIncrement_tendsto_zero tau f x y hx hy
    simpa [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient, hdist] using
      hIncrement.div_const
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoCircularDistance x y : ℂ)

/-! ## 2. Sequential closability in the two concrete `L2` spaces -/

/-- The exact sequential closed-at-zero criterion for the unbounded twisted
difference map. -/
def WidthTwoTwistedDifferenceSequentiallyClosable
    (tau : ℝ → ℂ) : Prop :=
  ∀ (u : ℕ → QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain tau)
      (g : QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2),
    Tendsto (fun n => (u n).1) atTop
        (𝓝 (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2)) →
      Tendsto (fun n => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau (u n))
        atTop (𝓝 g) →
      g = 0

/-- The twisted difference operator is sequentially closable for every
pointwise transition function. -/
theorem widthTwoHhalfDifferenceToL2_sequentiallyClosable
    (tau : ℝ → ℂ) :
    WidthTwoTwistedDifferenceSequentiallyClosable tau := by
  intro u g hu hg

  have huMeasure :
      TendstoInMeasure QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure
        (fun n => (u n).1) atTop
        (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :=
    tendstoInMeasure_of_tendsto_Lp hu
  obtain ⟨phi, hphi, hphiAE⟩ :=
    huMeasure.exists_seq_tendsto_ae

  have hzeroBase :
      (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) =ᵐ[
          QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure]
        (0 : ℝ → ℂ) :=
    Lp.coeFn_zero ℂ 2 QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure
  have hphiZeroAE :
      ∀ᵐ x ∂QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure,
        Tendsto (fun k => ((u (phi k)).1 : ℝ → ℂ) x)
          atTop (𝓝 0) := by
    filter_upwards [hphiAE, hzeroBase] with x hx hzero
    simpa only [hzero, Pi.zero_apply] using hx

  have hgSubsequence :
      Tendsto
        (fun k => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau (u (phi k)))
        atTop (𝓝 g) := by
    simpa only [Function.comp_def] using
      hg.comp hphi.tendsto_atTop
  have hgMeasure :
      TendstoInMeasure QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure
        (fun k => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau (u (phi k)))
        atTop g :=
    tendstoInMeasure_of_tendsto_Lp hgSubsequence
  obtain ⟨psi, hpsi, hpsiAE⟩ :=
    hgMeasure.exists_seq_tendsto_ae

  have hbaseSubsequenceAE :
      ∀ᵐ x ∂QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure,
        Tendsto
          (fun k => ((u (phi (psi k))).1 : ℝ → ℂ) x)
          atTop (𝓝 0) := by
    filter_upwards [hphiZeroAE] with x hx
    simpa only [Function.comp_def] using
      hx.comp hpsi.tendsto_atTop

  have hbaseFstAE :
      ∀ᵐ p ∂QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure,
        Tendsto
          (fun k => ((u (phi (psi k))).1 : ℝ → ℂ) p.1)
          atTop (𝓝 0) := by
    simpa only [QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure] using
      (Measure.quasiMeasurePreserving_fst
        (μ := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)
        (ν := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)).ae
          hbaseSubsequenceAE
  have hbaseSndAE :
      ∀ᵐ p ∂QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure,
        Tendsto
          (fun k => ((u (phi (psi k))).1 : ℝ → ℂ) p.2)
          atTop (𝓝 0) := by
    simpa only [QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure] using
      (Measure.quasiMeasurePreserving_snd
        (μ := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)
        (ν := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseWidthTwoParameterMeasure)).ae
          hbaseSubsequenceAE

  have hcoeRawAE :
      ∀ᵐ p ∂QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure, ∀ k : ℕ,
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau
            (u (phi (psi k))) : (ℝ × ℝ) → ℂ) p =
          QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau
            ((u (phi (psi k))).1 : ℝ → ℂ) p := by
    rw [ae_all_iff]
    intro k
    change
      (((u (phi (psi k))).property.toLp
          (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau
            ((u (phi (psi k))).1 : ℝ → ℂ)) :
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2) :
          (ℝ × ℝ) → ℂ) =ᵐ[
            QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseWidthTwoProductMeasure]
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau
          ((u (phi (psi k))).1 : ℝ → ℂ)
    exact (u (phi (psi k))).property.coeFn_toLp

  apply Lp.eq_zero_iff_ae_eq_zero.mpr
  filter_upwards [hpsiAE, hcoeRawAE, hbaseFstAE, hbaseSndAE]
    with p hpLimit hpRaw hpFst hpSnd
  have hRawLimit :
      Tendsto
        (fun k =>
          QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoTwistedDifferenceQuotient tau
            ((u (phi (psi k))).1 : ℝ → ℂ) p)
        atTop (𝓝 0) :=
    widthTwoTwistedDifferenceQuotient_tendsto_zero
      tau (fun k => ((u (phi (psi k))).1 : ℝ → ℂ))
        p.1 p.2 hpFst hpSnd
  have hLpRepresentativeLimit :
      Tendsto
        (fun k =>
          (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau
            (u (phi (psi k))) : (ℝ × ℝ) → ℂ) p)
        atTop (𝓝 0) :=
    hRawLimit.congr'
      (Eventually.of_forall fun k => (hpRaw k).symm)
  exact tendsto_nhds_unique hpLimit hLpRepresentativeLimit

/-! ## 3. No vertical fibre in the completed graph -/

/-- A point of the graph closure whose first coordinate is zero has zero
second coordinate. -/
theorem widthTwoHhalfCompletion_snd_eq_zero_of_fst_eq_zero
    (tau : ℝ → ℂ) (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfCompletion tau)
    (hz : QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau z = 0) :
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceProjection tau z = 0 := by
  have hzClosure :
      (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient) ∈
        closure
          ((QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphRange tau :
            Submodule ℂ QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient) :
            Set QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient) := by
    exact z.property
  obtain ⟨w, hwRange, hwTendsto⟩ :=
    mem_closure_iff_seq_limit.mp hzClosure

  have hwExists : ∀ n : ℕ,
      ∃ f : QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain tau,
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau f = w n := by
    intro n
    rcases hwRange n with ⟨f, hf⟩
    exact ⟨f, hf⟩
  choose f hf using hwExists

  have hGraphTendsto :
      Tendsto (fun n => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau (f n))
        atTop (𝓝 (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient)) :=
    hwTendsto.congr'
      (Eventually.of_forall fun n => (hf n).symm)

  have hzFst :
      (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).fst =
        (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) := by
    change QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau z = 0
    exact hz

  have hFstTendstoAmbient :
      Tendsto
        (fun n => (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau (f n)).fst)
        atTop (𝓝 (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).fst) := by
    change
      Tendsto
        (fun n =>
          (WithLp.fstL 2 ℂ
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
            QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2)
              (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau (f n)))
        atTop
        (𝓝 ((WithLp.fstL 2 ℂ
          QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
          QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2)
            (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient)))
    exact
      (WithLp.fstL 2 ℂ QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2).continuous.continuousAt.tendsto.comp
          hGraphTendsto
  have hFstTendsto :
      Tendsto (fun n => (f n).1) atTop
        (𝓝 (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2)) := by
    simpa only [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap_fst, hzFst] using
      hFstTendstoAmbient

  have hSndTendsto :
      Tendsto
        (fun n => QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceToL2 tau (f n))
        atTop
        (𝓝 ((z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd)) := by
    have hSndTendstoAmbient :
        Tendsto
          (fun n => (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau (f n)).snd)
          atTop (𝓝 (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd) := by
      change
        Tendsto
          (fun n =>
            (WithLp.sndL 2 ℂ
              QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
              QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2)
                (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap tau (f n)))
          atTop
          (𝓝 ((WithLp.sndL 2 ℂ
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
            QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2)
              (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient)))
      exact
        (WithLp.sndL 2 ℂ QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2
          QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseWidthTwoGagliardoL2).continuous.continuousAt.tendsto.comp
            hGraphTendsto
    simpa only [QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfGraphMap_snd] using
      hSndTendstoAmbient

  have hzSnd :
      (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd = 0 :=
    widthTwoHhalfDifferenceToL2_sequentiallyClosable tau
      f ((z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd)
        hFstTendsto hSndTendsto
  change (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd = 0
  exact hzSnd

/-- The first projection of the completed graph is genuinely injective. -/
theorem widthTwoHhalfToL2_injective (tau : ℝ → ℂ) :
    Function.Injective (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau) := by
  refine (injective_iff_map_eq_zero (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau)).mpr ?_
  intro z hz
  have hzFst :
      (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).fst =
        (0 : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) := by
    change QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau z = 0
    exact hz
  have hzSnd :
      (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient).snd = 0 := by
    change QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDifferenceProjection tau z = 0
    exact widthTwoHhalfCompletion_snd_eq_zero_of_fst_eq_zero tau z hz
  apply Subtype.ext
  apply WithLp.ofLp_injective
  apply Prod.ext
  · change
      WithLp.fst
          (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient) = 0
    exact hzFst
  · change
      WithLp.snd
          (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfGraphAmbient) = 0
    exact hzSnd

/-- Equivalent kernel formulation of graph closability. -/
theorem widthTwoHhalfToL2_ker_eq_bot (tau : ℝ → ℂ) :
    (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).ker = ⊥ := by
  change LinearMap.ker (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap = ⊥
  exact LinearMap.ker_eq_bot.mpr (widthTwoHhalfToL2_injective tau)

/-! ## 4. Honest inverse on the exact range only -/

/-- Algebraic identification of the closed graph with the exact range of its
first projection.  No continuity of the inverse in the ambient `L2` norm is
claimed. -/
noncomputable def widthTwoHhalfToL2RangeEquiv (tau : ℝ → ℂ) :
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfCompletion tau ≃ₗ[ℂ]
      LinearMap.range (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap :=
  LinearEquiv.ofInjective (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap
    (widthTwoHhalfToL2_injective tau)

@[simp]
theorem coe_widthTwoHhalfToL2RangeEquiv_apply
    (tau : ℝ → ℂ) (z : QYM.FullCertification.P2ClassicalHhalfTraceExtension.WidthTwoHhalfCompletion tau) :
    ((widthTwoHhalfToL2RangeEquiv tau z :
        LinearMap.range (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap) :
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) =
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau z := by
  simp only [widthTwoHhalfToL2RangeEquiv,
    LinearEquiv.ofInjective_apply]
  rfl

/-- The inverse on the exact image is a genuine right inverse there. -/
theorem widthTwoHhalfToL2_range_rightInverse
    (tau : ℝ → ℂ)
    (x : LinearMap.range (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap) :
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau
        ((widthTwoHhalfToL2RangeEquiv tau).symm x) =
      (x : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) := by
  calc
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau
        ((widthTwoHhalfToL2RangeEquiv tau).symm x) =
      ((widthTwoHhalfToL2RangeEquiv tau
        ((widthTwoHhalfToL2RangeEquiv tau).symm x) :
          LinearMap.range
            (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap) :
        QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :=
      (coe_widthTwoHhalfToL2RangeEquiv_apply tau
        ((widthTwoHhalfToL2RangeEquiv tau).symm x)).symm
    _ = (x : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :=
      congrArg Subtype.val
        ((widthTwoHhalfToL2RangeEquiv tau).apply_symm_apply x)

/-! ## 5. Exact remaining density statement -/

/-- The finite-energy domain is dense in parameter `L2`.  This proposition
is kept separate because proving it from compactly supported smooth functions
requires the still-missing project-local mollification layer. -/
def WidthTwoHhalfFiniteEnergyDomainDense (tau : ℝ → ℂ) : Prop :=
  Dense
    (((QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain tau :
      Submodule ℂ QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) :
      Set QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2))

/-- Density of the finite-energy domain is sufficient for dense range of the
now-injective forgetful map. -/
theorem widthTwoHhalfToL2_denseRange_of_finiteEnergyDomainDense
    (tau : ℝ → ℂ)
    (hDense : WidthTwoHhalfFiniteEnergyDomainDense tau) :
    DenseRange (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau) := by
  refine Dense.mono ?_ hDense
  intro x hx
  let f : QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfDomain tau := ⟨x, hx⟩
  refine ⟨QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfCoreMap tau f, ?_⟩
  change (f : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2) = x
  rfl

/-- Final unconditional closability certificate. -/
theorem widthTwoHhalfClosabilityCertificate (tau : ℝ → ℂ) :
    WidthTwoTwistedDifferenceSequentiallyClosable tau ∧
      Function.Injective (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau) ∧
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).ker = ⊥ ∧
      (∀ x : LinearMap.range
          (QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau).toLinearMap,
        QYM.FullCertification.P2ClassicalHhalfTraceExtension.widthTwoHhalfToL2 tau
            ((widthTwoHhalfToL2RangeEquiv tau).symm x) =
          (x : QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.ActualFixedPhaseWidthTwoL2)) := by
  exact
    ⟨widthTwoHhalfDifferenceToL2_sequentiallyClosable tau,
      widthTwoHhalfToL2_injective tau,
      widthTwoHhalfToL2_ker_eq_bot tau,
      widthTwoHhalfToL2_range_rightInverse tau⟩

end QYM.FullCertification.P2HhalfClosabilityExtension

