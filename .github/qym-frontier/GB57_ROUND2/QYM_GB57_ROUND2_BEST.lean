/-!
# Typed evidence registry, source-only continuation v2

The earlier registry deliberately stores human-readable declaration names as strings.  This
module adds a second layer whose evidence tags have actual propositions and actual proof terms.
It certifies those exact propositions only.  It does not assert that a proposition is definitionally
equal to, or an adequate formalization of, the corresponding prose claim in the PDF.
-/

namespace QYM.FullCertification.TypedEvidence

open QYM.FullCertification.Registry

abbrev Matrix2 := Matrix (Fin 2) (Fin 2) ℂ

/-- Stable typed identifiers for the high-value evidence currently implemented. -/
inductive EvidenceId where
  | qInsideUnitDisk
  | qNotScalarAutomorphism
  | affineCurvatureCovariance
  | positiveDensity
  | positiveDensitySkewFailure
  | nontrivialInnerModular
  | weightedFaithfulPositivity
  | weightedHermitianPairingCertificate
  | concreteDGACurvature
  | finiteCoverNoGo
  | finiteCoverAdditiveCorrection
  | finiteAttainment
  | finiteHamiltonianSymmetry
  | finiteEigenvalueClassification
  | finiteExactGap
  | finiteProjectionRayleigh
  | finitePerturbationGap
  | finiteWindowCountStability
  | finsuppWrongSignFormNoGo
  | finsuppCorrectedFormLowerBound
  | infiniteWrongSignNoGo
  | infiniteCorrectedLowerBound
  | finiteDualDissipation
  | finiteGalerkinDissipation
  | compositeFunctionalInvariance
  | weakCriticalDefinition
  | tripleProductDuality
  | nonnegativeGroundMass
  | boundedShadowCorrection
  | smoothedMajorantWindowCount
  | abstractPlusFormLowerBound
  | abstractWrongSignNoGo
  | strongNormCoercivityNoGo
  | strongNormDomination
  | groundMultiplicityNoGo
  | finiteFamilyEigenvalueError
  | finiteFamilyGapStability
  | finiteFamilyWindowStability
  | paperDef2_1Normalization
  | paperDef2_2Normalization
  | paperProp2_3Normalization
  | paperAxiom2_3Normalization
  | paperLemma3_2Refutation
  | paperProp3_4Normalization
  | paperDef4_2Normalization
  | paperDef4_3Normalization
  | paperLemma4_2FiniteNormalization
  | paperTheorem4_3FiniteCountermodel
  | paperTheorem4_5FiniteCountermodel
  | paperProp4_14Refutation
  | paperDef4_7FiniteNormalization
  | paperTheorem4_31FiniteNormalization
  | paperCor4_33FiniteNormalization
  deriving DecidableEq, Repr

/-- The exact proposition certified by an evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .qInsideUnitDisk =>
      ∀ τ : ℍ, ‖QYM.AlgebraNoGo.upperHalfPlaneQ τ‖ < 1
  | .qNotScalarAutomorphism =>
      ∀ τ : ℍ,
        ¬ ∃ e : ℂ ≃ₐ[ℂ] ℂ,
          ∀ x : ℂ, e x = QYM.AlgebraNoGo.upperHalfPlaneQ τ • x
  | .affineCurvatureCovariance =>
      ∀ (g : Matrix2ˣ) (dg A dA : Matrix2),
        QYM.AffineGauge.standardCurvature
            (QYM.AffineGauge.affineGaugeDifferential g dg A dA)
            (QYM.AffineGauge.affineGauge g dg A) =
          QYM.gconj g (QYM.AffineGauge.standardCurvature dA A)
  | .positiveDensity =>
      ((QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity :
        QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2)).PosDef
  | .positiveDensitySkewFailure =>
      ((QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity :
          QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2)).PosDef ∧
        ((QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity :
          QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2)).IsHermitian ∧
        QYM.WeightedTraceCore.weightedPairing
            QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
            (QYM.WeightedTraceCore.twistedCommutator
              QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
              QYM.WeightedTraceCore.SkewAdjointCounterexample.e01
              QYM.WeightedTraceCore.SkewAdjointCounterexample.e10)
            QYM.WeightedTraceCore.SkewAdjointCounterexample.e00 ≠
          -QYM.WeightedTraceCore.weightedPairing
            QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
            QYM.WeightedTraceCore.SkewAdjointCounterexample.e10
            (QYM.WeightedTraceCore.twistedCommutator
              QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
              QYM.WeightedTraceCore.SkewAdjointCounterexample.e01
              QYM.WeightedTraceCore.SkewAdjointCounterexample.e00)
  | .nontrivialInnerModular =>
      QYM.WeightedTraceCore.SkewAdjointCounterexample.e01 ≠ 0 ∧
        (1 / 2 : ℂ) ≠ 1 ∧
        QYM.WeightedTraceCore.modularTwist
            QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
            QYM.WeightedTraceCore.SkewAdjointCounterexample.e01 =
          (1 / 2 : ℂ) • QYM.WeightedTraceCore.SkewAdjointCounterexample.e01 ∧
        QYM.WeightedTraceCore.weightedTrace
            QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
            QYM.WeightedTraceCore.SkewAdjointCounterexample.e00 ≠ 0 ∧
        ((QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity :
          QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2)).PosDef
  | .weightedFaithfulPositivity =>
      ∀ X : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
        (0 : ℂ) ≤
            QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianSquare X ∧
          (QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianSquare X = 0 ↔
            X = 0)
  | .weightedHermitianPairingCertificate =>
      (∀ X : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
          (0 : ℂ) ≤
            QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianPairing X X) ∧
        (∀ X : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
          QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianPairing X X = 0 ↔
            X = 0) ∧
        (∀ X Y : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
          QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianPairing X Y =
            star
              (QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianPairing Y X))
  | .concreteDGACurvature =>
      QYM.ConstantTwoDimensionalDGA.curvature
          QYM.ConstantTwoDimensionalDGA.MatrixWitness.connection =
        QYM.ConstantTwoDimensionalDGA.MatrixWitness.expectedCurvature ∧
      QYM.ConstantTwoDimensionalDGA.curvature
          QYM.ConstantTwoDimensionalDGA.MatrixWitness.connection ≠ 0
  | .finiteCoverNoGo =>
      ¬ QYM.FullCertification.NoGo.FiniteCover.IsGlobalMinimizer
        QYM.FullCertification.NoGo.FiniteCover.chosenGlue
  | .finiteCoverAdditiveCorrection =>
      QYM.FullCertification.Corrected.FiniteCover.IsMinimum
        (QYM.FullCertification.Corrected.FiniteCover.assembledEnergy
          QYM.FullCertification.NoGo.FiniteCover.localEnergy0
          QYM.FullCertification.NoGo.FiniteCover.localEnergy1)
        QYM.FullCertification.NoGo.FiniteCover.chosenGlue
  | .finiteAttainment =>
      ∃ state : Bool,
        QYM.FullCertification.Corrected.FiniteVariational.IsGlobalMin
          (fun b : Bool => if b then (1 : ℕ) else 0) state
  | .finiteHamiltonianSymmetry =>
      ∀ x y : QYM.FiniteHamiltonian.Vec2,
        QYM.FiniteHamiltonian.dot (QYM.FiniteHamiltonian.hamiltonian x) y =
          QYM.FiniteHamiltonian.dot x (QYM.FiniteHamiltonian.hamiltonian y)
  | .finiteEigenvalueClassification =>
      ∀ {lambda : ℝ} {x : QYM.FiniteHamiltonian.Vec2},
        x ≠ 0 →
        QYM.FiniteHamiltonian.hamiltonian x = lambda • x →
        lambda = QYM.FiniteHamiltonian.groundEigenvalue ∨
          lambda = QYM.FiniteHamiltonian.excitedEigenvalue
  | .finiteExactGap =>
      QYM.FiniteHamiltonian.excitedEigenvalue - QYM.FiniteHamiltonian.groundEigenvalue =
        (1 / 2 : ℝ)
  | .finiteProjectionRayleigh =>
      ∀ {x : QYM.FiniteHamiltonian.Vec2},
        x ≠ 0 →
        QYM.FiniteHamiltonian.groundEigenvalue ≤
            QYM.FiniteHamiltonian.Projection.rayleighQuotient x ∧
          QYM.FiniteHamiltonian.Projection.rayleighQuotient x ≤
            QYM.FiniteHamiltonian.excitedEigenvalue
  | .finitePerturbationGap =>
      ∀ {δ₀ δ₁ ε : ℝ},
        |δ₀| ≤ ε → |δ₁| ≤ ε →
        (1 / 2 : ℝ) - 2 * ε ≤
          QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedGap δ₀ δ₁
  | .finiteWindowCountStability =>
      ∀ {n : ℕ} (reference perturbed : Fin n → ℝ) (center η ε : ℝ),
        (∀ i, |perturbed i - reference i| ≤ ε) →
        (QYM.SpectralWindowStability.windowIndices reference center (η - ε)).card ≤
            (QYM.SpectralWindowStability.windowIndices perturbed center η).card ∧
          (QYM.SpectralWindowStability.windowIndices perturbed center η).card ≤
            (QYM.SpectralWindowStability.windowIndices reference center (η + ε)).card
  | .finsuppWrongSignFormNoGo =>
      ¬ QYM.FinsuppDiagonalQuadraticForm.HasFormLowerBound
        (QYM.FinsuppDiagonalQuadraticForm.wrongSignEnergy (fun _ => 0))
  | .finsuppCorrectedFormLowerBound =>
      QYM.FinsuppDiagonalQuadraticForm.HasFormLowerBound
        (QYM.FinsuppDiagonalQuadraticForm.correctedEnergy (fun _ => 0))
  | .infiniteWrongSignNoGo =>
      ¬ QYM.InfiniteDiagonalHamiltonian.HasEigenvalueLowerBound
        (QYM.InfiniteDiagonalHamiltonian.paperHamiltonian (fun _ => 0))
  | .infiniteCorrectedLowerBound =>
      QYM.InfiniteDiagonalHamiltonian.HasEigenvalueLowerBound
        (QYM.InfiniteDiagonalHamiltonian.correctedHamiltonian (fun _ => 0))
  | .finiteDualDissipation =>
      ∀ {velocity : QYM.FiniteDualRieszFlow.Primal}
        {gradient : QYM.FiniteDualRieszFlow.Dual},
        QYM.FiniteDualRieszFlow.SatisfiesDualGradientFlow velocity gradient →
        gradient velocity = -QYM.FiniteDualRieszFlow.normSq
          (QYM.FiniteDualRieszFlow.raise gradient)
  | .finiteGalerkinDissipation =>
      ∀ x : QYM.FiniteHamiltonian.Vec2,
        QYM.FiniteHamiltonian.dot x
            (QYM.FiniteGalerkinDissipation.cubicNonlinearity x) = 0 ∧
          QYM.FiniteGalerkinDissipation.normSqDirectionalDerivative x
              (QYM.FiniteGalerkinDissipation.vectorField x) =
            -2 * QYM.FiniteHamiltonian.energy x
  | .compositeFunctionalInvariance =>
      ∀ (G X : Type) (transform : G → X → X) (F₁ F₂ F₃ F₄ : X → ℝ),
        QYM.FullCertification.Corrected.FunctionalLogic.InvariantUnder transform F₁ →
        QYM.FullCertification.Corrected.FunctionalLogic.InvariantUnder transform F₂ →
        QYM.FullCertification.Corrected.FunctionalLogic.InvariantUnder transform F₃ →
        QYM.FullCertification.Corrected.FunctionalLogic.InvariantUnder transform F₄ →
        QYM.FullCertification.Corrected.FunctionalLogic.InvariantUnder transform
          (fun x => ((F₁ x + F₂ x) + F₃ x) + F₄ x)
  | .weakCriticalDefinition =>
      ∀ (X V : Type) (isAdmissible : X → Prop) (isVariation : X → V → Prop)
          (firstVariation : X → V → ℝ) (state : X),
        QYM.FullCertification.Corrected.FunctionalLogic.IsWeakCriticalAt
            isAdmissible isVariation firstVariation state ↔
          isAdmissible state ∧
            ∀ variation : V,
              isVariation state variation → firstVariation state variation = 0
  | .tripleProductDuality =>
      ∀ (P D : Type) (pairing : D → P → ℝ) (bilinear : P → P → D)
          (primalSize : P → ℝ) (dualSize : D → ℝ) (C K : ℝ),
        (∀ x, 0 ≤ primalSize x) →
        QYM.FullCertification.Corrected.FunctionalLogic.HasDualityBound
          pairing dualSize primalSize C →
        QYM.FullCertification.Corrected.FunctionalLogic.HasBilinearSizeBound
          bilinear primalSize dualSize K →
        ∀ x y z : P,
          |pairing (bilinear x y) z| ≤
            (C * K) * primalSize x * primalSize y * primalSize z
  | .nonnegativeGroundMass =>
      ∀ eigenvalue : ℕ → ℝ,
        0 ≤ eigenvalue 0 →
          ∃ mass : ℝ, 0 ≤ mass ∧ mass ^ 2 = eigenvalue 0
  | .boundedShadowCorrection =>
      ∀ (ι : Type) (eigenvalue correction : ι → ℝ) (ε : ℝ),
        QYM.FullCertification.Corrected.FunctionalLogic.IsBoundedShadowCorrection
            correction ε →
          ∀ i : ι,
            |QYM.FullCertification.Corrected.FunctionalLogic.correctedEigenvalue
                eigenvalue correction i - eigenvalue i| ≤ ε
  | .smoothedMajorantWindowCount =>
      ∀ (n : ℕ) (spectrum : Fin n → ℝ) (weight : ℝ → ℝ)
          (center radius : ℝ),
        (∀ t, 0 ≤ weight t) →
        (∀ i : Fin n,
          |spectrum i - center| ≤ radius → 1 ≤ weight (spectrum i - center)) →
        QYM.FullCertification.Corrected.FunctionalLogic.realWindowCount
            spectrum center radius ≤
          QYM.FullCertification.Corrected.FunctionalLogic.smoothedCount
            spectrum weight center
  | .abstractPlusFormLowerBound =>
      ∀ (State : Type) (normSq kinetic potential : State → ℝ) (a b : ℝ),
        QYM.AbstractFormSign.FormLowerBoundBy normSq kinetic a →
        QYM.AbstractFormSign.FormAbsBoundBy normSq potential b →
        QYM.AbstractFormSign.FormLowerBoundBy normSq
          (QYM.AbstractFormSign.plusForm kinetic potential) (a - b)
  | .abstractWrongSignNoGo =>
      ∀ (State : Type) (normSq kinetic potential : State → ℝ)
          (u : ℕ → State) (bound : ℝ),
        QYM.AbstractFormSign.IsUnitSequence normSq u →
        QYM.AbstractFormSign.ArbitrarilyLargeAlong kinetic u →
        QYM.AbstractFormSign.FormUpperBoundBy normSq potential bound →
        ¬ QYM.AbstractFormSign.HasFormLowerBound normSq
          (QYM.AbstractFormSign.wrongSignForm kinetic potential)
  | .strongNormCoercivityNoGo =>
      (∀ n : ℕ,
          QYM.FinsuppStrongNormNoGo.weakNormSq
              (QYM.FinsuppStrongNormNoGo.basis n) = 1) ∧
        (∀ threshold : ℝ, ∃ n : ℕ,
          threshold < QYM.FinsuppStrongNormNoGo.strongNormSq
            (QYM.FinsuppStrongNormNoGo.basis n)) ∧
        ¬ QYM.FinsuppStrongNormNoGo.HasUniformStrongControl
  | .strongNormDomination =>
      ∀ (X : Type) (strongSize energy weakSize : X → ℝ)
          (energyCoefficient weakCoefficient energyBound weakBound : ℝ),
        0 ≤ energyCoefficient →
        0 ≤ weakCoefficient →
        QYM.FinsuppStrongNormNoGo.StrongControlledByEnergy
            strongSize energy weakSize energyCoefficient weakCoefficient →
        (∀ x, energy x ≤ energyBound) →
        (∀ x, weakSize x ≤ weakBound) →
        ∀ x, strongSize x ≤
          energyCoefficient * energyBound + weakCoefficient * weakBound
  | .groundMultiplicityNoGo =>
      (∀ i : Fin 3,
          QYM.SpectralFlowCore.GroundMultiplicityCounterexample.IsGroundIndex i →
            QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue i = 0) ∧
        (∀ i : Fin 3,
          ¬ QYM.SpectralFlowCore.GroundMultiplicityCounterexample.IsGroundIndex i →
            (1 : ℝ) ≤
              QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue i) ∧
        ¬ (1 : ℝ) ≤
          QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 1 -
            QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 0
  | .finiteFamilyEigenvalueError =>
      ∀ (n : ℕ) (reference perturbed : Fin n → ℝ) (ε : ℝ),
        QYM.FiniteSpectralFamilyStability.UniformError reference perturbed ε →
          ∀ i : Fin n, |perturbed i - reference i| ≤ ε
  | .finiteFamilyGapStability =>
      ∀ (n : ℕ) (reference perturbed : Fin n → ℝ) (ε δ : ℝ),
        QYM.FiniteSpectralFamilyStability.UniformError reference perturbed ε →
        ∀ i j : Fin n,
          δ ≤ reference j - reference i →
          ε ≤ δ / 4 →
          δ / 2 ≤ perturbed j - perturbed i
  | .finiteFamilyWindowStability =>
      ∀ (n : ℕ) (reference perturbed : Fin n → ℝ) (center η ε : ℝ),
        QYM.FiniteSpectralFamilyStability.UniformError reference perturbed ε →
          (QYM.SpectralWindowStability.windowIndices perturbed center η).card ≤
              (QYM.SpectralWindowStability.windowIndices
                reference center (η + ε)).card ∧
            (QYM.SpectralWindowStability.windowIndices reference center η).card ≤
              (QYM.SpectralWindowStability.windowIndices
                perturbed center (η + ε)).card
  | .paperDef2_1Normalization =>
      QYM.FullCertification.PaperNormalized.def2_1_matrixStatement
  | .paperDef2_2Normalization =>
      QYM.FullCertification.PaperNormalized.def2_2_constantCurvatureStatement
  | .paperProp2_3Normalization =>
      QYM.FullCertification.PaperNormalized.prop2_3_affineCurvatureStatement ∧
        QYM.FullCertification.PaperNormalized.prop2_3_homogeneousBracketStatement
  | .paperAxiom2_3Normalization =>
      QYM.FullCertification.PaperNormalized.axiom2_3_literalMatrixStatement ∧
        (∀ τ : ℍ,
          ¬ QYM.FullCertification.PaperNormalized.Axiom2_3ScalarTwistExists τ) ∧
        QYM.FullCertification.PaperNormalized.axiom2_3_nontrivialInnerMatrixStatement
  | .paperLemma3_2Refutation =>
      ∀ tau : ℍ,
        ¬ QYM.FullCertification.PaperNormalized.lemma3_2_affineBracketStatement tau
  | .paperProp3_4Normalization =>
      QYM.FullCertification.PaperNormalized.prop3_4_splitDensityStatement
  | .paperDef4_2Normalization =>
      QYM.FullCertification.PaperNormalized.def4_2_weakCriticalStatement
  | .paperDef4_3Normalization =>
      QYM.FullCertification.PaperNormalized.def4_3_finiteStrictTransitionStatement
  | .paperLemma4_2FiniteNormalization =>
      QYM.FullCertification.PaperNormalized.lemma4_2_finiteStrictGluingStatement
  | .paperTheorem4_3FiniteCountermodel =>
      QYM.FullCertification.PaperNormalized.theorem4_3_finiteCountermodelStatement
  | .paperTheorem4_5FiniteCountermodel =>
      QYM.FullCertification.PaperNormalized.theorem4_5_finiteCountermodelStatement ∧
        QYM.FullCertification.PaperNormalized.theorem4_5_finiteCancellationStatement
  | .paperProp4_14Refutation =>
      ¬ QYM.FullCertification.PaperNormalized.prop4_14_finsuppWrongSignStatement
  | .paperDef4_7FiniteNormalization =>
      QYM.FullCertification.PaperNormalized.def4_7_finiteSmoothedCountingStatement
  | .paperTheorem4_31FiniteNormalization =>
      QYM.FullCertification.PaperNormalized.theorem4_31_finiteEigenvalueErrorStatement
  | .paperCor4_33FiniteNormalization =>
      QYM.FullCertification.PaperNormalized.cor4_33_finiteWindowStatement

/-- Every typed evidence proposition has a proof term in the current source. -/
theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | qInsideUnitDisk =>
      exact QYM.AlgebraNoGo.upperHalfPlaneQ_norm_lt_one
  | qNotScalarAutomorphism =>
      intro τ
      exact QYM.AlgebraNoGo.upperHalfPlaneQ_not_scalar_algEquiv (S := ℂ) τ
  | affineCurvatureCovariance =>
      exact QYM.AffineGauge.standardCurvature_affine_eq_gconj
  | positiveDensity =>
      exact QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity_posDef
  | positiveDensitySkewFailure =>
      exact
        QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity_posDef_Hermitian_and_skew_failure
  | nontrivialInnerModular =>
      exact
        QYM.WeightedTraceCore.SkewAdjointCounterexample.concrete_nontrivial_innerModular_certificate
  | weightedFaithfulPositivity =>
      intro X
      exact ⟨
        QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianSquare_nonneg X,
        QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedHermitianSquare_eq_zero_iff X⟩
  | weightedHermitianPairingCertificate =>
      exact
        QYM.WeightedTraceCore.SkewAdjointCounterexample.concrete_weightedHermitianPairing_certificate
  | concreteDGACurvature =>
      exact ⟨QYM.ConstantTwoDimensionalDGA.MatrixWitness.curvature_connection,
        QYM.ConstantTwoDimensionalDGA.MatrixWitness.curvature_connection_ne_zero⟩
  | finiteCoverNoGo =>
      exact QYM.FullCertification.NoGo.FiniteCover.chosenGlue_not_globalMinimizer
  | finiteCoverAdditiveCorrection =>
      exact
        QYM.FullCertification.Corrected.FiniteCover.chosenGlue_minimizes_assembledLocalEnergy
  | finiteAttainment =>
      exact QYM.FullCertification.Corrected.FiniteVariational.exists_globalMin
        (State := Bool) (Energy := ℕ) (fun b : Bool => if b then 1 else 0)
  | finiteHamiltonianSymmetry =>
      exact QYM.FiniteHamiltonian.hamiltonian_dot_symmetric
  | finiteEigenvalueClassification =>
      intro lambda x hx heigen
      exact QYM.FiniteHamiltonian.eigenvalue_classification hx heigen
  | finiteExactGap =>
      exact QYM.FiniteHamiltonian.first_excited_gap
  | finiteProjectionRayleigh =>
      intro x hx
      exact QYM.FiniteHamiltonian.Projection.rayleighQuotient_bounds hx
  | finitePerturbationGap =>
      intro δ₀ δ₁ ε hδ₀ hδ₁
      exact QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedGap_lower_bound hδ₀ hδ₁
  | finiteWindowCountStability =>
      exact QYM.SpectralWindowStability.window_count_stability
  | finsuppWrongSignFormNoGo =>
      apply
        QYM.FinsuppDiagonalQuadraticForm.wrongSignEnergy_not_hasFormLowerBound_of_potential_boundedAbove
          (fun _ => 0) 0
      intro n
      exact le_rfl
  | finsuppCorrectedFormLowerBound =>
      apply
        QYM.FinsuppDiagonalQuadraticForm.correctedEnergy_hasFormLowerBound_of_potential_boundedBelow
          (fun _ => 0) 0
      intro n
      exact le_rfl
  | infiniteWrongSignNoGo =>
      exact QYM.InfiniteDiagonalHamiltonian.constantPotential_not_hasEigenvalueLowerBound 0
  | infiniteCorrectedLowerBound =>
      apply
        QYM.InfiniteDiagonalHamiltonian.corrected_hasEigenvalueLowerBound_of_potential_boundedBelow
          (fun _ => 0) 0
      intro n
      exact le_rfl
  | finiteDualDissipation =>
      intro velocity gradient hflow
      exact QYM.FiniteDualRieszFlow.dualGradientFlow_dissipation hflow
  | finiteGalerkinDissipation =>
      intro x
      exact ⟨QYM.FiniteGalerkinDissipation.dot_cubicNonlinearity_zero x,
        QYM.FiniteGalerkinDissipation.normSqDirectionalDerivative_vectorField x⟩
  | compositeFunctionalInvariance =>
      intro G X transform F₁ F₂ F₃ F₄ h₁ h₂ h₃ h₄
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.invariantUnder_sum_four
          h₁ h₂ h₃ h₄
  | weakCriticalDefinition =>
      intro X V isAdmissible isVariation firstVariation state
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.isWeakCriticalAt_iff
          isAdmissible isVariation firstVariation state
  | tripleProductDuality =>
      intro P D pairing bilinear primalSize dualSize C K hsize hpair hbilinear x y z
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.tripleProduct_bound
          pairing bilinear primalSize dualSize C K hsize hpair hbilinear x y z
  | nonnegativeGroundMass =>
      intro eigenvalue hground
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.exists_nonneg_mass_with_square_eq
          hground
  | boundedShadowCorrection =>
      intro ι eigenvalue correction ε hcorrection i
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.correctedEigenvalue_error
          eigenvalue correction ε hcorrection i
  | smoothedMajorantWindowCount =>
      intro n spectrum weight center radius hweight hmajorant
      exact
        QYM.FullCertification.Corrected.FunctionalLogic.realWindowCount_le_smoothedCount
          spectrum weight center radius hweight hmajorant
  | abstractPlusFormLowerBound =>
      intro State normSq kinetic potential a b hkinetic hpotential
      exact QYM.AbstractFormSign.plusForm_lowerBoundBy_of_absPerturbation
        hkinetic hpotential
  | abstractWrongSignNoGo =>
      intro State normSq kinetic potential u bound hunit hkinetic hpotential
      exact QYM.AbstractFormSign.wrongSignForm_not_hasFormLowerBound_of_formUpperBoundBy
        hunit hkinetic hpotential
  | strongNormCoercivityNoGo =>
      exact QYM.FinsuppStrongNormNoGo.weakBound_does_not_imply_strongBound
  | strongNormDomination =>
      intro X strongSize energy weakSize energyCoefficient weakCoefficient
        energyBound weakBound henergyCoefficient hweakCoefficient hdomination henergy hweak
      exact QYM.FinsuppStrongNormNoGo.strongBound_of_energy_and_weakBounds
        strongSize energy weakSize energyCoefficient weakCoefficient energyBound weakBound
        henergyCoefficient hweakCoefficient hdomination henergy hweak
  | groundMultiplicityNoGo =>
      exact
        QYM.SpectralFlowCore.GroundMultiplicityCounterexample.complement_separation_does_not_imply_adjacent_gap
  | finiteFamilyEigenvalueError =>
      intro n reference perturbed ε herror i
      exact QYM.FiniteSpectralFamilyStability.individual_eigenvalue_error herror i
  | finiteFamilyGapStability =>
      intro n reference perturbed ε δ herror i j hmargin hquarter
      exact QYM.FiniteSpectralFamilyStability.quarter_error_preserves_half_margin
        herror i j hmargin hquarter
  | finiteFamilyWindowStability =>
      intro n reference perturbed center η ε herror
      exact QYM.FiniteSpectralFamilyStability.symmetric_expanded_window_count_bounds herror
  | paperDef2_1Normalization =>
      exact QYM.FullCertification.PaperNormalized.def2_1_matrixStatement_holds
  | paperDef2_2Normalization =>
      exact QYM.FullCertification.PaperNormalized.def2_2_constantCurvatureStatement_holds
  | paperProp2_3Normalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.prop2_3_affineCurvatureStatement_holds,
          QYM.FullCertification.PaperNormalized.prop2_3_homogeneousBracketStatement_holds⟩
  | paperAxiom2_3Normalization =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.axiom2_3_literalMatrixStatement_holds,
          QYM.FullCertification.PaperNormalized.axiom2_3_scalarTwistStatement_refuted,
          QYM.FullCertification.PaperNormalized.axiom2_3_nontrivialInnerMatrixStatement_holds⟩
  | paperLemma3_2Refutation =>
      exact QYM.FullCertification.PaperNormalized.lemma3_2_affineBracketStatement_refuted
  | paperProp3_4Normalization =>
      exact QYM.FullCertification.PaperNormalized.prop3_4_splitDensityStatement_holds
  | paperDef4_2Normalization =>
      exact QYM.FullCertification.PaperNormalized.def4_2_weakCriticalStatement_holds
  | paperDef4_3Normalization =>
      exact
        QYM.FullCertification.PaperNormalized.def4_3_finiteStrictTransitionStatement_holds
  | paperLemma4_2FiniteNormalization =>
      exact QYM.FullCertification.PaperNormalized.lemma4_2_finiteStrictGluingStatement_holds
  | paperTheorem4_3FiniteCountermodel =>
      exact QYM.FullCertification.PaperNormalized.theorem4_3_finiteCountermodelStatement_holds
  | paperTheorem4_5FiniteCountermodel =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.theorem4_5_finiteCountermodelStatement_holds,
          QYM.FullCertification.PaperNormalized.theorem4_5_finiteCancellationStatement_holds⟩
  | paperProp4_14Refutation =>
      exact QYM.FullCertification.PaperNormalized.prop4_14_finsuppWrongSignStatement_refuted
  | paperDef4_7FiniteNormalization =>
      exact
        QYM.FullCertification.PaperNormalized.def4_7_finiteSmoothedCountingStatement_holds
  | paperTheorem4_31FiniteNormalization =>
      exact
        QYM.FullCertification.PaperNormalized.theorem4_31_finiteEigenvalueErrorStatement_holds
  | paperCor4_33FiniteNormalization =>
      exact QYM.FullCertification.PaperNormalized.cor4_33_finiteWindowStatement_holds

/-- A dependent proof-carrying evidence object. -/
structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement id

def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

/-- Canonical list of all typed evidence tags. -/
def allEvidence : List EvidenceId :=
  [.qInsideUnitDisk, .qNotScalarAutomorphism, .affineCurvatureCovariance,
   .positiveDensity, .positiveDensitySkewFailure, .nontrivialInnerModular,
   .weightedFaithfulPositivity, .weightedHermitianPairingCertificate, .concreteDGACurvature,
   .finiteCoverNoGo, .finiteCoverAdditiveCorrection, .finiteAttainment,
   .finiteHamiltonianSymmetry, .finiteEigenvalueClassification, .finiteExactGap,
   .finiteProjectionRayleigh,
   .finitePerturbationGap, .finiteWindowCountStability,
   .finsuppWrongSignFormNoGo, .finsuppCorrectedFormLowerBound,
   .infiniteWrongSignNoGo, .infiniteCorrectedLowerBound,
   .finiteDualDissipation, .finiteGalerkinDissipation,
   .compositeFunctionalInvariance, .weakCriticalDefinition, .tripleProductDuality,
   .nonnegativeGroundMass, .boundedShadowCorrection, .smoothedMajorantWindowCount,
   .abstractPlusFormLowerBound, .abstractWrongSignNoGo,
   .strongNormCoercivityNoGo, .strongNormDomination, .groundMultiplicityNoGo,
   .finiteFamilyEigenvalueError, .finiteFamilyGapStability, .finiteFamilyWindowStability,
   .paperDef2_1Normalization, .paperDef2_2Normalization, .paperProp2_3Normalization,
   .paperAxiom2_3Normalization, .paperLemma3_2Refutation,
   .paperProp3_4Normalization, .paperDef4_2Normalization, .paperDef4_3Normalization,
   .paperLemma4_2FiniteNormalization, .paperTheorem4_3FiniteCountermodel,
   .paperTheorem4_5FiniteCountermodel, .paperProp4_14Refutation,
   .paperDef4_7FiniteNormalization, .paperTheorem4_31FiniteNormalization,
   .paperCor4_33FiniteNormalization]

/-- Proof-carrying certificates for every typed evidence identifier. -/
def allCertificates : List Certificate := allEvidence.map certificate

theorem allCertificates_ids :
    allCertificates.map Certificate.id = allEvidence := by
  simp only [allCertificates, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) allEvidence = allEvidence
  rfl

theorem allCertificates_length : allCertificates.length = 53 := by decide

theorem allEvidence_length : allEvidence.length = 53 := by decide

theorem allEvidence_nodup : allEvidence.Nodup := by decide

theorem allEvidence_complete (evidence : EvidenceId) : evidence ∈ allEvidence := by
  cases evidence <;> simp [allEvidence]

/-- Typed evidence associated with a manual paper-claim identifier.  Empty rows remain explicitly
unsupported at this layer. -/
def evidenceForClaim : ClaimId → List EvidenceId
  | .def2_1 => [.paperDef2_1Normalization]
  | .def2_2 => [.concreteDGACurvature, .paperDef2_2Normalization]
  | .prop2_3 => [.affineCurvatureCovariance, .paperProp2_3Normalization]
  | .axiom2_3 =>
      [.qInsideUnitDisk, .qNotScalarAutomorphism, .nontrivialInnerModular,
       .paperAxiom2_3Normalization]
  | .lemma3_2 => [.paperLemma3_2Refutation]
  | .prop3_1 => [.strongNormCoercivityNoGo, .strongNormDomination]
  | .prop3_4 => [.compositeFunctionalInvariance, .paperProp3_4Normalization]
  | .def4_2 => [.weakCriticalDefinition, .paperDef4_2Normalization]
  | .def4_3 => [.paperDef4_3Normalization]
  | .lemma4_2 => [.paperLemma4_2FiniteNormalization]
  | .theorem4_3 =>
      [.finiteCoverNoGo, .finiteCoverAdditiveCorrection, .finiteAttainment,
       .paperTheorem4_3FiniteCountermodel]
  | .theorem4_4 => [.finiteDualDissipation]
  | .theorem4_5 =>
      [.positiveDensity, .positiveDensitySkewFailure, .weightedFaithfulPositivity,
       .weightedHermitianPairingCertificate, .finiteGalerkinDissipation,
       .paperTheorem4_5FiniteCountermodel]
  | .theorem4_9 => [.tripleProductDuality]
  | .prop4_14 =>
      [.infiniteWrongSignNoGo, .infiniteCorrectedLowerBound,
       .finsuppWrongSignFormNoGo, .finsuppCorrectedFormLowerBound,
       .abstractPlusFormLowerBound, .abstractWrongSignNoGo,
       .paperProp4_14Refutation]
  | .prop4_15 | .lemma4_17 | .lemma4_18 | .lemmaA_1 | .lemmaA_2 =>
      [.infiniteWrongSignNoGo, .infiniteCorrectedLowerBound,
       .finsuppWrongSignFormNoGo, .finsuppCorrectedFormLowerBound,
       .abstractPlusFormLowerBound, .abstractWrongSignNoGo]
  | .def4_5 => [.nonnegativeGroundMass]
  | .prop4_23 | .theoremA_7 =>
      [.finiteHamiltonianSymmetry, .finiteEigenvalueClassification, .finiteExactGap,
       .finiteProjectionRayleigh, .groundMultiplicityNoGo]
  | .def4_7 => [.paperDef4_7FiniteNormalization]
  | .cor4_28 => [.smoothedMajorantWindowCount]
  | .def4_8 => [.boundedShadowCorrection]
  | .theorem4_31 =>
      [.boundedShadowCorrection, .finiteFamilyEigenvalueError,
        .paperTheorem4_31FiniteNormalization]
  | .cor4_32 => [.finitePerturbationGap, .finiteFamilyGapStability]
  | .cor4_33 =>
      [.finiteWindowCountStability, .finiteFamilyWindowStability,
       .paperCor4_33FiniteNormalization]
  | .defA_1 => [.nonnegativeGroundMass]
  | _ => []

/-- Proof-carrying evidence objects attached to one claim row. -/
def certificatesForClaim (claim : ClaimId) : List Certificate :=
  (evidenceForClaim claim).map certificate

theorem certificatesForClaim_ids (claim : ClaimId) :
    (certificatesForClaim claim).map Certificate.id = evidenceForClaim claim := by
  simp only [certificatesForClaim, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) (evidenceForClaim claim) =
    evidenceForClaim claim
  cases claim <;> rfl

/-- Membership in a typed support list always yields the exact certified proposition. -/
theorem linkedEvidence_sound {claim : ClaimId} {evidence : EvidenceId}
    (_h : evidence ∈ evidenceForClaim claim) : EvidenceStatement evidence :=
  evidenceSound evidence

theorem evidenceForClaim_nodup (claim : ClaimId) :
    (evidenceForClaim claim).Nodup := by
  cases claim <;> decide

/-- Claims with at least one typed evidence proposition. -/
def claimsWithTypedEvidence : List ClaimId :=
  allClaims.filter fun claim => !(evidenceForClaim claim).isEmpty

theorem claimsWithTypedEvidence_length : claimsWithTypedEvidence.length = 30 := by decide

/-- Flattened typed links, used for source-level coverage accounting. -/
def typedEvidencePairs : List (ClaimId × EvidenceId) :=
  allClaims.flatMap fun claim => (evidenceForClaim claim).map fun evidence => (claim, evidence)

theorem typedEvidencePairs_length : typedEvidencePairs.length = 90 := by decide

/-- Every tag is used by at least one claim row. -/
theorem allEvidence_used (evidence : EvidenceId) :
    ∃ claim : ClaimId, evidence ∈ evidenceForClaim claim := by
  cases evidence with
  | qInsideUnitDisk => exact ⟨.axiom2_3, by simp [evidenceForClaim]⟩
  | qNotScalarAutomorphism => exact ⟨.axiom2_3, by simp [evidenceForClaim]⟩
  | affineCurvatureCovariance => exact ⟨.prop2_3, by simp [evidenceForClaim]⟩
  | positiveDensity => exact ⟨.theorem4_5, by simp [evidenceForClaim]⟩
  | positiveDensitySkewFailure => exact ⟨.theorem4_5, by simp [evidenceForClaim]⟩
  | nontrivialInnerModular => exact ⟨.axiom2_3, by simp [evidenceForClaim]⟩
  | weightedFaithfulPositivity => exact ⟨.theorem4_5, by simp [evidenceForClaim]⟩
  | weightedHermitianPairingCertificate => exact ⟨.theorem4_5, by simp [evidenceForClaim]⟩
  | concreteDGACurvature => exact ⟨.def2_2, by simp [evidenceForClaim]⟩
  | finiteCoverNoGo => exact ⟨.theorem4_3, by simp [evidenceForClaim]⟩
  | finiteCoverAdditiveCorrection => exact ⟨.theorem4_3, by simp [evidenceForClaim]⟩
  | finiteAttainment => exact ⟨.theorem4_3, by simp [evidenceForClaim]⟩
  | finiteHamiltonianSymmetry => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩
  | finiteEigenvalueClassification => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩
  | finiteExactGap => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩
  | finiteProjectionRayleigh => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩
  | finitePerturbationGap => exact ⟨.cor4_32, by simp [evidenceForClaim]⟩
  | finiteWindowCountStability => exact ⟨.cor4_33, by simp [evidenceForClaim]⟩
