/-!
# Concrete high-cutoff Green boundary and the exact Stokes residual

The earlier producers isolated three genuinely different obligations:

* the velocity chain rule on paired polygon edges;
* the negative pushforward law for an outward hyperbolic unit normal;
* a curvilinear divergence theorem on the selected finite tile complex.

The first two obligations are now unconditional.  This file feeds their
inhabitants back into the Green API and constructs the remaining boundary
functional itself.  Its side term is integrated only over points retained by
the literal three-cusp truncation.  Its horocycle term is integrated over the
actual frontier preimage and uses the explicitly differentiated, negatively
oriented selected horocycle.

Quotient-compact support gives a literal zero tail.  Above that tail the
truncated side sum equals the full paired-edge sum, while every labeled
frontier-horocycle integrand is pointwise zero.  Hence the constructed labeled
boundary sum vanishes.  The final theorem proves that the old
`GammaTwoPairedPolygonFluxStokes` proposition is equivalent to just one
remaining equality: Euclidean divergence against hyperbolic measure equals
this now-constructed boundary sum.  No Stokes theorem is postulated or hidden
inside a structure.
-/

/-! ## 1. Previously residual edge and normal conclusions -/

/-- The actual invariant-flux sum over every paired edge is now
unconditional: the formerly supplied velocity hypothesis is the explicit
derivative theorem from the edge-velocity producer. -/
theorem all_orientedEdgeFluxIntegrals_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxIntegral X Y e) = 0 :=
  QYM.FullCertification.P2NormalGreenExtension.all_orientedEdgeFluxIntegrals_eq_zero
    hInv QYM.FullCertification.P2ExplicitEdgeVelocityExtension.actualPairedEdgeVelocityChainRule

/-- The same unconditional cancellation after deleting all genuine literal
horocycle corners. -/
theorem all_orientedEdgeFluxIntegralsAwayFromLiteralCorners_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (Ycut : ℝ) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
      QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e) = 0 :=
  QYM.FullCertification.P2NormalGreenExtension.all_orientedEdgeFluxIntegralsAwayFromLiteralCorners_eq_zero
    hInv QYM.FullCertification.P2ExplicitEdgeVelocityExtension.actualPairedEdgeVelocityChainRule Ycut

/-- The actual fixed-phase Petersson Green flux has zero full paired-side
sum, with no remaining geometric parameter. -/
theorem fixedPhase_allOrientedEdgeGreenFluxIntegrals_eq_zero
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
      QYM.FullCertification.P2NormalGreenExtension.fixedPhaseOrientedEdgeGreenFluxIntegral n u v e) = 0 :=
  QYM.FullCertification.P2NormalGreenExtension.fixedPhase_allOrientedEdgeGreenFluxIntegrals_eq_zero
    QYM.FullCertification.P2ExplicitEdgeVelocityExtension.actualPairedEdgeVelocityChainRule n u v

/-- Every eta-twisted one-form has the exact paired normal-derivative sign and
inverse-eta multiplier along the concrete outward unit normal. -/
theorem etaTwistedOneForm_hasActualPairedNormalDerivative
    (A : EtaTwistedOneForm) :
    QYM.FullCertification.P2NormalGreenExtension.HasEtaPairedNormalDerivative A
      QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal :=
  QYM.FullCertification.P2NormalGreenExtension.etaTwistedOneForm_hasPairedNormalDerivative A
    QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal
    QYM.FullCertification.P2ManifoldD1BridgeExtension.actualOutwardHyperbolicUnitNormal_hasOppositePushforward

/-- In particular, the actual covariant differential `eta⁻¹ dg` obeys the
normal matching law on every regular paired edge. -/
theorem etaGaugeDifferential_hasActualPairedNormalDerivative
    (g : SmoothInvariantScalar) :
    ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
      t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e →
        etaGaugeDifferential g
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e.paired (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t))
            (QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal e.paired
              (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)) =
          -(Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
              e.pairingElement (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) *
            etaGaugeDifferential g (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)
              (QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal e t)) :=
  QYM.FullCertification.P2NormalGreenExtension.etaGaugeDifferential_hasPairedNormalDerivative g
    QYM.FullCertification.P2ExplicitEdgeNormalExtension.actualOutwardHyperbolicUnitNormal
    QYM.FullCertification.P2ManifoldD1BridgeExtension.actualOutwardHyperbolicUnitNormal_hasOppositePushforward

/-! ## 2. Exact selected-horocycle tangent -/

/-- Horizontal line before transport by a selected full-modular
representative. -/
def selectedHorocycleBaseCoordinate (Y t : ℝ) : ℂ :=
  Complex.mk t (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)

/-- Ambient complex coordinate of the genuine selected horocycle. -/
noncomputable def selectedHorocycleCoordinate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y : ℝ) : ℝ → ℂ :=
  fun t => (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Y t : ℂ)

/-- Explicit positive-parameter velocity of a selected horocycle. -/
def explicitSelectedHorocycleVelocity
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) : ℂ :=
  1 / QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeDenom q
    (selectedHorocycleBaseCoordinate Y t) ^ 2

/-- The actual selected horocycle is the selected Möbius chart applied to the
horizontal base line. -/
theorem selectedHorocycleCoordinate_eq_selectedRepresentativeChart
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) :
    selectedHorocycleCoordinate q Y t =
      QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeChart q
        (selectedHorocycleBaseCoordinate Y t) := by
  let z : ℍ :=
    ⟨Complex.mk t (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y),
      lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)⟩
  change ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q • z : ℍ) : ℂ) =
    QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeChart q (z : ℂ)
  simp only [QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeChart,
    QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeCoordinate, UpperHalfPlane.ofComplex_apply]

/-- The base horizontal line has complex derivative one. -/
theorem selectedHorocycleBaseCoordinate_hasDerivAt (Y t : ℝ) :
    HasDerivAt (selectedHorocycleBaseCoordinate Y) (1 : ℂ) t := by
  have hreal : HasDerivAt (⇑Complex.ofRealCLM) 1 t :=
    (Complex.ofRealCLM.hasFDerivAt (x := t)).hasDerivAt
  have hcurve :
      selectedHorocycleBaseCoordinate Y =
        fun s : ℝ =>
          (s : ℂ) +
            (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) * Complex.I := by
    funext s
    simp only [selectedHorocycleBaseCoordinate, Complex.mk_eq_add_mul_I]
  rw [hcurve]
  exact hreal.add_const
    ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) * Complex.I)

/-- Exact ordinary derivative of the transported selected horocycle. -/
theorem selectedHorocycleCoordinate_hasDerivAt
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) :
    HasDerivAt (selectedHorocycleCoordinate q Y)
      (explicitSelectedHorocycleVelocity q Y t) t := by
  let z : ℍ :=
    ⟨Complex.mk t (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y),
      lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)⟩
  have hz : (z : ℂ) = selectedHorocycleBaseCoordinate Y t := rfl
  have hOuter :=
    (QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeChart_hasStrictDerivAt q z).hasDerivAt.complexToReal_fderiv
  have hBase := selectedHorocycleBaseCoordinate_hasDerivAt Y t
  have hComp := hOuter.comp_hasDerivAt t hBase
  have hEq : selectedHorocycleCoordinate q Y =
      fun s => QYM.FullCertification.P2ExplicitEdgeVelocityExtension.selectedRepresentativeChart q
        (selectedHorocycleBaseCoordinate Y s) := by
    funext s
    exact selectedHorocycleCoordinate_eq_selectedRepresentativeChart q Y s
  rw [hEq]
  simpa [explicitSelectedHorocycleVelocity, Function.comp_def, hz,
    ContinuousLinearMap.smul_apply, smul_eq_mul, div_eq_mul_inv,
    mul_comm, mul_left_comm, mul_assoc] using hComp

/-- The top boundary of a region lying below a horocycle is traversed from
right to left.  Möbius maps with positive determinant preserve that
orientation, so its boundary velocity is the negative ordinary derivative. -/
def selectedHorocycleBoundaryVelocity
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) : ℂ :=
  -explicitSelectedHorocycleVelocity q Y t

/-- Derivative statement in the actual stored boundary orientation. -/
theorem selectedHorocycleCoordinate_neg_hasDerivAt
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) :
    HasDerivAt (fun s => selectedHorocycleCoordinate q Y (-s))
      (selectedHorocycleBoundaryVelocity q Y (-t)) t := by
  have h := (selectedHorocycleCoordinate_hasDerivAt q Y (-t)).scomp t
    (hasDerivAt_neg t)
  simpa only [Function.comp_def, selectedHorocycleBoundaryVelocity,
    neg_smul, one_smul] using h

/-! ## 3. Side integrals retained by the literal truncation -/

/-- Real parameters on one selected edge whose points are retained by the
literal simultaneous three-cusp truncation. -/
noncomputable def truncatedEdgeParameterSet
    (Ycut : ℝ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : Set ℝ :=
  {t | t ∈ QYM.FullCertification.P2NormalGreenExtension.edgeParameterSet e ∧
    QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Ycut}

/-- Oriented edge flux restricted to the actual literal truncation. -/
noncomputable def truncatedOrientedEdgeFluxIntegral
    (Ycut : ℝ) (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  ∫ t in truncatedEdgeParameterSet Ycut e,
    QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxDensity X Y e t

/-- Every genuine edge point belongs to the selected closed six-tile
carrier. -/
theorem actualEdgePoint_mem_closedTileCarrier
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ} (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.edgeParameterSet e) :
    QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier := by
  rw [QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint_of_mem e ht]
  apply Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.mem_gammaTwoClosedTileCarrier_iff.mpr
  refine ⟨e.1, Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParam e.2 ⟨t, ht⟩, ?_, rfl⟩
  exact (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeSet_subset_boundary e.2
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParam_mem e.2 ⟨t, ht⟩)).1

/-- Outside the retained parameter set, a higher-cutoff edge point lies in
the literal zero tail. -/
theorem orientedEdgeFluxDensity_eq_zero_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY : Y₀ ≤ Ycut) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.edgeParameterSet e \
      truncatedEdgeParameterSet Ycut e) :
    QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxDensity X Y e t = 0 := by
  have hzCarrier := actualEdgePoint_mem_closedTileCarrier e ht.1
  have hzNotCut :
      QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t ∉ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Ycut := by
    intro hz
    exact ht.2 ⟨ht.1, hz⟩
  have hzNotTail :
      QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t ∉ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀ := by
    intro hz
    exact hzNotCut (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation_monotone hY hz)
  rcases hZero (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) ⟨hzCarrier, hzNotTail⟩ with
    ⟨hX, hYzero⟩
  simp [QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxDensity, Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue, hX, hYzero]

/-- Above the zero-tail cutoff, restricting an edge integral to the literal
truncation changes nothing. -/
theorem truncatedOrientedEdgeFluxIntegral_eq_full_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY : Y₀ ≤ Ycut) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    truncatedOrientedEdgeFluxIntegral Ycut X Y e =
      QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxIntegral X Y e := by
  unfold truncatedOrientedEdgeFluxIntegral QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxIntegral
  symm
  apply setIntegral_eq_of_subset_of_forall_diff_eq_zero
    (QYM.FullCertification.P2NormalGreenExtension.edgeParameterSet_measurable e)
  · intro t ht
    exact ht.1
  · intro t ht
    exact orientedEdgeFluxDensity_eq_zero_of_tail hZero hY e ht

/-- Finite sum of all selected tile-side integrals retained at one cutoff. -/
noncomputable def truncatedPairedSideFluxSum
    (Ycut : ℝ) (X Y : ℍ → ℂ) : ℂ :=
  ∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, truncatedOrientedEdgeFluxIntegral Ycut X Y e

/-- The truncated side sum equals the full paired-side sum above the literal
zero tail. -/
theorem truncatedPairedSideFluxSum_eq_full_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY : Y₀ ≤ Ycut) :
    truncatedPairedSideFluxSum Ycut X Y =
      ∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, QYM.FullCertification.P2NormalGreenExtension.orientedEdgeFluxIntegral X Y e := by
  unfold truncatedPairedSideFluxSum
  apply Finset.sum_congr rfl
  intro e he
  exact truncatedOrientedEdgeFluxIntegral_eq_full_of_tail hZero hY e

/-- Consequently the actual retained tile-side sum vanishes for every
invariant flux above its zero tail. -/
theorem truncatedPairedSideFluxSum_eq_zero
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY : Y₀ ≤ Ycut) :
    truncatedPairedSideFluxSum Ycut X Y = 0 := by
  rw [truncatedPairedSideFluxSum_eq_full_of_tail hZero hY]
  exact all_orientedEdgeFluxIntegrals_eq_zero hInv

/-! ## 4. Actual frontier-horocycle flux and its compact-tail vanishing -/

/-- Oriented one-form density on one actual selected cusp horocycle. -/
noncomputable def selectedHorocycleFluxDensity
    (X Y : ℍ → ℂ) (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset)
    (Ycut t : ℝ) : ℂ :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t)
    (selectedHorocycleBoundaryVelocity q Ycut t)

/-- Integral over exactly those parameters of a selected horocycle which
belong to the literal truncation frontier. -/
noncomputable def selectedFrontierHorocycleFluxIntegral
    (Ycut : ℝ) (X Y : ℍ → ℂ)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) : ℂ :=
  ∫ t in Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q,
    selectedHorocycleFluxDensity X Y q Ycut t

/-- Parameters on one selected horocycle which land in the genuine global
side/horocycle corner locus.  This is the actual preimage, not a chosen list
of guessed endpoint values. -/
noncomputable def selectedHorocycleLiteralCornerParameters
    (Ycut : ℝ) (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) : Set ℝ :=
  (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut) ⁻¹'
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierCorners Ycut

/-- The actual horocycle-corner parameter set is finite.  Global corner
finiteness is pulled back along the already-proved injective selected
horocycle parameter. -/
theorem selectedHorocycleLiteralCornerParameters_finite
    (Ycut : ℝ) (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) :
    (selectedHorocycleLiteralCornerParameters Ycut q).Finite := by
  unfold selectedHorocycleLiteralCornerParameters
  exact Set.Finite.preimage
    (QYM.FullCertification.PolygonTraceExtension.gammaTwoSelectedHorocycleParam_injective q Ycut).injOn
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierCorners_finite Ycut)

/-- Actual frontier-horocycle integral after deleting genuine global corner
parameters. -/
noncomputable def selectedFrontierHorocycleFluxIntegralAwayFromCorners
    (Ycut : ℝ) (X Y : ℍ → ℂ)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) : ℂ :=
  ∫ t in Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q \
      selectedHorocycleLiteralCornerParameters Ycut q,
    selectedHorocycleFluxDensity X Y q Ycut t

/-- Deleting all genuine horocycle corners leaves the one-dimensional flux
unchanged. -/
theorem selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq
    (Ycut : ℝ) (X Y : ℍ → ℂ) (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) :
    selectedFrontierHorocycleFluxIntegralAwayFromCorners Ycut X Y q =
      selectedFrontierHorocycleFluxIntegral Ycut X Y q := by
  unfold selectedFrontierHorocycleFluxIntegralAwayFromCorners
    selectedFrontierHorocycleFluxIntegral
  apply Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.setIntegral_diff_null_eq
  exact (selectedHorocycleLiteralCornerParameters_finite Ycut q).measure_zero volume

/-- A selected horocycle parameter has exactly the declared tile height. -/
theorem tileHeight_selectedHorocycleParam
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (Y t : ℝ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoTileHeight q
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Y t) =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y := by
  apply Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.mem_gammaTwoSelectedHorocycleCurve_iff.mp
  exact Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam_mem q Y t

/-- Every retained selected-horocycle point lies in the closed carrier. -/
theorem selectedHorocycleParam_mem_closedTileCarrier_of_frontier
    {q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset} {Ycut t : ℝ}
    (ht : t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t ∈
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier := by
  have hzClosure := frontier_subset_closure ht
  have hzStage : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t ∈
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Ycut := by
    simpa only [(Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation_isClosed Ycut).closure_eq]
      using hzClosure
  exact hzStage.1

/-- A frontier horocycle strictly above a normalized zero-tail cutoff lies
outside the lower truncation. -/
theorem selectedHorocycleParam_mem_zeroTail
    {q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset} {Y₀ Ycut t : ℝ}
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut)
    (ht : t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t ∈
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀ := by
  rw [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.mem_closedTileCarrier_diff_threeCuspTruncation_iff]
  refine ⟨selectedHorocycleParam_mem_closedTileCarrier_of_frontier ht,
    q, ?_⟩
  have hYcut : 1 ≤ Ycut := hY₀.le.trans hCut.le
  rw [tileHeight_selectedHorocycleParam,
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel_of_one_le hY₀.le,
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel_of_one_le hYcut]
  exact hCut

/-- The oriented horocycle density vanishes pointwise on every sufficiently
high actual frontier parameter. -/
theorem selectedHorocycleFluxDensity_eq_zero_of_tail
    {X Y : ℍ → ℂ} {q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset}
    {Y₀ Ycut t : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut)
    (ht : t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q) :
    selectedHorocycleFluxDensity X Y q Ycut t = 0 := by
  rcases hZero _
      (selectedHorocycleParam_mem_zeroTail hY₀ hCut ht) with
    ⟨hX, hY⟩
  simp [selectedHorocycleFluxDensity, Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue, hX, hY]

/-- Every actual selected frontier-horocycle integral vanishes above the
zero-tail cutoff. -/
theorem selectedFrontierHorocycleFluxIntegral_eq_zero_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) :
    selectedFrontierHorocycleFluxIntegral Ycut X Y q = 0 := by
  unfold selectedFrontierHorocycleFluxIntegral
  apply setIntegral_eq_zero_of_forall_eq_zero
  intro t ht
  exact selectedHorocycleFluxDensity_eq_zero_of_tail
    hZero hY₀ hCut ht

/-- The same high-tail vanishing after deleting every genuine corner. -/
theorem selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq_zero_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) :
    selectedFrontierHorocycleFluxIntegralAwayFromCorners
        Ycut X Y q = 0 := by
  rw [selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq]
  exact selectedFrontierHorocycleFluxIntegral_eq_zero_of_tail
    hZero hY₀ hCut q

/-- Dirichlet form of the same conclusion at an arbitrary fixed cutoff: if
both coordinate components of the flux vanish on the actual frontier trace,
then its corner-deleted horocycle contribution is zero.  No support or decay
hypothesis is needed. -/
theorem selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq_zero_of_trace
    {X Y : ℍ → ℂ} {Ycut : ℝ} (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset)
    (hTrace : ∀ t ∈
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q,
      X (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 ∧
        Y (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0) :
    selectedFrontierHorocycleFluxIntegralAwayFromCorners
        Ycut X Y q = 0 := by
  unfold selectedFrontierHorocycleFluxIntegralAwayFromCorners
  apply setIntegral_eq_zero_of_forall_eq_zero
  intro t ht
  rcases hTrace t ht.1 with ⟨hX, hY⟩
  simp [selectedHorocycleFluxDensity, Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue, hX, hY]

/-- Finite sum over the selected six-tile right-coset horocycle labels.
No multiplicity-one identification with the three geometric quotient cusp
components is asserted here; the zero-tail theorem below does not require
one. -/
noncomputable def selectedFrontierHorocycleFluxSum
    (Ycut : ℝ) (X Y : ℍ → ℂ) : ℂ :=
  ∑ q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset,
    selectedFrontierHorocycleFluxIntegralAwayFromCorners Ycut X Y q

/-- The complete finite selected-horocycle sum vanishes above the zero tail.
Overlaps at corners cause no problem: the integrand is pointwise zero, and
the separately proved corner sets are finite. -/
theorem selectedFrontierHorocycleFluxSum_eq_zero_of_tail
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut) :
    selectedFrontierHorocycleFluxSum Ycut X Y = 0 := by
  unfold selectedFrontierHorocycleFluxSum
  apply Finset.sum_eq_zero
  intro q hq
  exact selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq_zero_of_tail
    hZero hY₀ hCut q

/-- Finite Dirichlet trace endpoint: pointwise vanishing of both flux
components on every actual selected cusp trace kills the complete horocycle
boundary sum at that cutoff. -/
theorem selectedFrontierHorocycleFluxSum_eq_zero_of_trace
    {X Y : ℍ → ℂ} {Ycut : ℝ}
    (hTrace : ∀ (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (t : ℝ),
      t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q →
        X (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 ∧
          Y (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0) :
    selectedFrontierHorocycleFluxSum Ycut X Y = 0 := by
  unfold selectedFrontierHorocycleFluxSum
  apply Finset.sum_eq_zero
  intro q hq
  exact selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq_zero_of_trace
    q (hTrace q)

/-! ### Concrete Dirichlet traces for the fixed-phase Green coefficient -/

/-- Literal vanishing of a fixed-phase section on every actual selected cusp
trace at one cutoff. -/
def FixedPhaseDirichletTraceZeroAt (Ycut : ℝ) (n : ℤ)
    (u : InverseEtaFixedPhaseCore n) : Prop :=
  ∀ (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (t : ℝ),
    t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q →
      (u : SmoothQuotientCompactFunction)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0

/-- A zero source trace makes both actual fixed-phase Green flux components
zero on the cusp boundary. -/
theorem fixedPhaseGreenFlux_zero_of_leftDirichletTrace
    {Ycut : ℝ} {n : ℤ} {u : InverseEtaFixedPhaseCore n}
    {v : InverseEtaFixedPhaseCore (n + 1)}
    (hDir : FixedPhaseDirichletTraceZeroAt Ycut n u)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (t : ℝ)
    (ht : t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 ∧
      Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 := by
  have hu := hDir q t ht
  simp [Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX, Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY,
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenScalarDensity, hu]

/-- A zero target trace gives the same pointwise boundary-flux vanishing. -/
theorem fixedPhaseGreenFlux_zero_of_rightDirichletTrace
    {Ycut : ℝ} {n : ℤ} {u : InverseEtaFixedPhaseCore n}
    {v : InverseEtaFixedPhaseCore (n + 1)}
    (hDir : FixedPhaseDirichletTraceZeroAt Ycut (n + 1) v)
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (t : ℝ)
    (ht : t ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoLiteralFrontierHorocycleParameters Ycut q) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 ∧
      Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoSelectedHorocycleParam q Ycut t) = 0 := by
  have hv := hDir q t ht
  simp [Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX, Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY,
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenScalarDensity, hv]

/-- The complete actual cusp-boundary contribution to the fixed-phase Green
form vanishes under a source Dirichlet trace. -/
theorem fixedPhase_selectedFrontierHorocycleFluxSum_eq_zero_of_leftDirichlet
    {Ycut : ℝ} {n : ℤ} {u : InverseEtaFixedPhaseCore n}
    {v : InverseEtaFixedPhaseCore (n + 1)}
    (hDir : FixedPhaseDirichletTraceZeroAt Ycut n u) :
    selectedFrontierHorocycleFluxSum Ycut
      (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) = 0 := by
  apply selectedFrontierHorocycleFluxSum_eq_zero_of_trace
  intro q t ht
  exact fixedPhaseGreenFlux_zero_of_leftDirichletTrace hDir q t ht

/-- The same exact cusp-boundary conclusion under a target Dirichlet trace. -/
theorem fixedPhase_selectedFrontierHorocycleFluxSum_eq_zero_of_rightDirichlet
    {Ycut : ℝ} {n : ℤ} {u : InverseEtaFixedPhaseCore n}
    {v : InverseEtaFixedPhaseCore (n + 1)}
    (hDir : FixedPhaseDirichletTraceZeroAt Ycut (n + 1) v) :
    selectedFrontierHorocycleFluxSum Ycut
      (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) = 0 := by
  apply selectedFrontierHorocycleFluxSum_eq_zero_of_trace
  intro q t ht
  exact fixedPhaseGreenFlux_zero_of_rightDirichletTrace hDir q t ht

/-! ## 5. The concrete high-cutoff boundary sum -/

/-- Concrete labeled boundary functional at a literal cutoff.  The side term
is restricted to the truncation and the cap term uses the frontier preimage
of every selected right-coset horocycle.  A later genuine Stokes theorem must
still identify this labeled sum, with the correct multiplicities, with the
geometric boundary integral. -/
noncomputable def actualTruncatedTileBoundaryFluxSum
    (Ycut : ℝ) (X Y : ℍ → ℂ) : ℂ :=
  truncatedPairedSideFluxSum Ycut X Y +
    selectedFrontierHorocycleFluxSum Ycut X Y

/-- Main concrete cancellation theorem: an invariant flux with a literal
three-cusp zero tail has zero constructed labeled boundary sum at every
strictly higher cutoff. -/
theorem actualTruncatedTileBoundaryFluxSum_eq_zero
    {X Y : ℍ → ℂ} {Y₀ Ycut : ℝ}
    (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hZero : ∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
      X z = 0 ∧ Y z = 0)
    (hY₀ : 1 < Y₀) (hCut : Y₀ < Ycut) :
    actualTruncatedTileBoundaryFluxSum Ycut X Y = 0 := by
  rw [actualTruncatedTileBoundaryFluxSum,
    truncatedPairedSideFluxSum_eq_zero hInv hZero hCut.le,
    selectedFrontierHorocycleFluxSum_eq_zero_of_tail
      hZero hY₀ hCut,
    add_zero]

/-- Every smooth quotient-compact invariant flux admits a tail threshold
above which the concrete boundary sum vanishes at every cutoff. -/
theorem exists_zero_actualTruncatedTileBoundaryFluxSum
    {X Y : ℍ → ℂ} (hFlux : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsSmoothQuotientCompactFlux X Y) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Ycut : ℝ, Y₀ < Ycut →
        actualTruncatedTileBoundaryFluxSum Ycut X Y = 0 := by
  rcases Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoQuotientCompactFluxTailTightness X Y hFlux with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Ycut hCut
  exact actualTruncatedTileBoundaryFluxSum_eq_zero
    hFlux.2.2.2.2 hZero hY₀ hCut

/-! ## 6. Exact equivalence with the sole remaining curvilinear Stokes step -/

/-- The actual divergence integral which occurs in compact-flux Stokes. -/
noncomputable def actualFluxDivergenceIntegral
    (X Y : ℍ → ℂ) : ℂ :=
  ∫ z in chosenGammaTwoFundamentalDomain.carrier,
    heightC z ^ 2 * (dx X z + dy Y z) ∂hyperbolicMeasure

/-- The remaining theorem in its irreducible boundary-equality form.  Every
entry is concrete: the measured carrier, divergence, truncated side
parameters, horocycle frontier parameters, velocities, and orientations.
Unlike `GammaTwoPairedPolygonFluxStokes`, this proposition does not state the
desired zero conclusion; it states only the curvilinear divergence-equals-
boundary equality which Mathlib presently does not provide for this finite
union of Möbius images of a circular-arc tile. -/
def ActualHighCutoffDivergenceBoundaryEqualityResidual : Prop :=
  ∀ (X Y : ℍ → ℂ),
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsSmoothQuotientCompactFlux X Y →
    ∀ (Y₀ : ℝ), 1 < Y₀ →
      (∀ z ∈ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoClosedTileCarrier \
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoThreeCuspTruncation Y₀,
        X z = 0 ∧ Y z = 0) →
      IntegrableOn
        (fun z => heightC z ^ 2 * (dx X z + dy Y z))
        chosenGammaTwoFundamentalDomain.carrier hyperbolicMeasure →
      ∀ (Ycut : ℝ), Y₀ < Ycut →
        actualFluxDivergenceIntegral X Y =
          actualTruncatedTileBoundaryFluxSum Ycut X Y

/-- Exact claim boundary: the old paired-polygon Stokes residual is
equivalent to the single concrete curvilinear divergence/boundary equality.
All cancellation, corner, tangent, and normal obligations are discharged;
the explicit zero-tail premise remains as the localization input. -/
theorem gammaTwoPairedPolygonFluxStokes_iff_actualHighCutoffBoundaryEqualityResidual :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.GammaTwoPairedPolygonFluxStokes ↔
      ActualHighCutoffDivergenceBoundaryEqualityResidual := by
  constructor
  · intro hStokes X Y hFlux Y₀ hY₀ hZero hInt Ycut hCut
    have hBulk : actualFluxDivergenceIntegral X Y = 0 := by
      simpa only [actualFluxDivergenceIntegral] using
        hStokes X Y hFlux ⟨Y₀, hY₀, hZero⟩ hInt
    have hBoundary :
        actualTruncatedTileBoundaryFluxSum Ycut X Y = 0 :=
      actualTruncatedTileBoundaryFluxSum_eq_zero
        hFlux.2.2.2.2 hZero hY₀ hCut
    exact hBulk.trans hBoundary.symm
  · intro hBoundary X Y hFlux hTail hInt
    rcases hTail with ⟨Y₀, hY₀, hZero⟩
    let Ycut : ℝ := Y₀ + 1
    have hCut : Y₀ < Ycut := by
      dsimp [Ycut]
      linarith
    have hEq := hBoundary X Y hFlux Y₀ hY₀ hZero hInt Ycut hCut
    rw [show
      (∫ z in chosenGammaTwoFundamentalDomain.carrier,
        heightC z ^ 2 * (dx X z + dy Y z) ∂hyperbolicMeasure) =
          actualFluxDivergenceIntegral X Y by rfl,
      hEq]
    exact actualTruncatedTileBoundaryFluxSum_eq_zero
      hFlux.2.2.2.2 hZero hY₀ hCut

/-! ## 7. Fixed-phase Petersson Green reduction -/

/-- The concrete Petersson Green defect is the actual divergence integral
used in this file. -/
theorem fixedPhaseGreenBoundaryDefect_eq_actualFluxDivergenceIntegral
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.greenBoundaryDefect n u v =
      actualFluxDivergenceIntegral
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) :=
  by
    simpa only [actualFluxDivergenceIntegral] using
      Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.greenBoundaryDefect_eq_integral_fixedPhaseGreenFlux n u v

/-- Unconditional final reduction for the actual fixed-phase sections.  A
literal tail threshold is produced, and at every higher cutoff vanishing of
the Petersson Green defect is equivalent to the sole remaining curvilinear
divergence-equals-constructed-boundary equality. -/
theorem exists_fixedPhaseGreenBoundaryDefect_reduction
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Ycut : ℝ, Y₀ < Ycut →
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.greenBoundaryDefect n u v = 0 ↔
          actualFluxDivergenceIntegral
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) =
            actualTruncatedTileBoundaryFluxSum Ycut
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v)) := by
  let X := Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v
  let Y := Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v
  have hFlux : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsSmoothQuotientCompactFlux X Y :=
    Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFlux_isSmoothQuotientCompact n u v
  rcases Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoQuotientCompactFluxTailTightness X Y hFlux with
    ⟨Y₀, hY₀, hZero⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Ycut hCut
  have hBoundary : actualTruncatedTileBoundaryFluxSum Ycut X Y = 0 :=
    actualTruncatedTileBoundaryFluxSum_eq_zero
      hFlux.2.2.2.2 hZero hY₀ hCut
  change Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.greenBoundaryDefect n u v = 0 ↔
    actualFluxDivergenceIntegral X Y =
      actualTruncatedTileBoundaryFluxSum Ycut X Y
  rw [fixedPhaseGreenBoundaryDefect_eq_actualFluxDivergenceIntegral,
    hBoundary]

/-- The same reduction stated as the physical Petersson adjoint identity,
not merely as vanishing of the named defect. -/
theorem exists_fixedPhasePeterssonGreenIdentity_reduction
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    ∃ Y₀ : ℝ, 1 < Y₀ ∧
      ∀ Ycut : ℝ, Y₀ < Ycut →
        (peterssonForm (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.OrbitMultiplier (n + 1))
              chosenGammaTwoFundamentalDomain
              (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1)
                (InverseEtaFixedPhaseCore.raise n u))
              (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore (n + 1) v) =
            -peterssonForm (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.OrbitMultiplier n)
              chosenGammaTwoFundamentalDomain
              (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n u)
              (InverseEtaFixedPhaseCore.toSmoothCompactWeightCore n
                (InverseEtaFixedPhaseCore.lowerFromSucc n v)) ↔
          actualFluxDivergenceIntegral
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) =
            actualTruncatedTileBoundaryFluxSum Ycut
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
              (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v)) := by
  rcases exists_fixedPhaseGreenBoundaryDefect_reduction n u v with
    ⟨Y₀, hY₀, hReduction⟩
  refine ⟨Y₀, hY₀, ?_⟩
  intro Ycut hCut
  exact (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.greenBoundaryDefect_eq_zero_iff n u v).symm.trans
    (hReduction Ycut hCut)

