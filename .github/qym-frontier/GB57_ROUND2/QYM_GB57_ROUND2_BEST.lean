namespace QYM.FullCertification.P2HorocycleBoundaryMeasureExtension








/-!
# Width-two hyperbolic horocycle measures

The earlier polygon layer calculated the scalar arclength `2 / H` and kept
the finite `dx` parameter measure separate from the hyperbolic density.  This
module upgrades that calculation to actual finite measures.

For positive `H`, hyperbolic arclength on the horizontal parameter is
`H⁻¹ dx`.  We push this measure first to the displayed upper-half-plane
horocycle and then to the effective quotient.  The quotient pushforward is
unconditional and is supported on the projected curve.  We do **not** call
it the topological boundary measure of `X_H`: that final identification still
requires the corrected exact-boundary theorem.
-/

/-! ## Parameter arclength -/

/-- Hyperbolic arclength density `H⁻¹ dx` on the closed width-two parameter
interval.  The definition is total in `H`; its geometric interpretation is
used only under `0 < H`. -/
noncomputable def widthTwoHyperbolicParameterMeasure (H : ℝ) : Measure ℝ :=
  ENNReal.ofReal (H⁻¹) • QYM.FullCertification.PolygonTraceExtension.widthTwoParameterMeasure

noncomputable instance widthTwoHyperbolicParameterMeasure_isFinite
    (H : ℝ) : IsFiniteMeasure (widthTwoHyperbolicParameterMeasure H) :=
  QYM.FullCertification.PolygonTraceExtension.widthTwoParameterMeasure.smul_finite ENNReal.ofReal_ne_top

/-- The parameter measure is concentrated on the chosen width-two interval.
-/
theorem widthTwoHyperbolicParameterMeasure_compl_Icc (H : ℝ) :
    widthTwoHyperbolicParameterMeasure H (Set.Icc (0 : ℝ) 2)ᶜ = 0 := by
  simp [widthTwoHyperbolicParameterMeasure,
    QYM.FullCertification.PolygonTraceExtension.widthTwoParameterMeasure, Measure.smul_apply]

/-- Exact total mass before rewriting the positive reciprocal. -/
theorem widthTwoHyperbolicParameterMeasure_univ (H : ℝ) :
    widthTwoHyperbolicParameterMeasure H Set.univ =
      ENNReal.ofReal (H⁻¹) * 2 := by
  simp [widthTwoHyperbolicParameterMeasure, Measure.smul_apply,
    QYM.FullCertification.PolygonTraceExtension.widthTwoParameterMeasure_univ]

/-- At positive height, total measure is the ENNReal lift of the geometric
hyperbolic arclength `2 / H`. -/
theorem widthTwoHyperbolicParameterMeasure_univ_of_pos
    {H : ℝ} (hH : 0 < H) :
    widthTwoHyperbolicParameterMeasure H Set.univ =
      ENNReal.ofReal (2 / H) := by
  rw [widthTwoHyperbolicParameterMeasure_univ]
  calc
    ENNReal.ofReal (H⁻¹) * 2 =
        ENNReal.ofReal (H⁻¹) * ENNReal.ofReal (2 : ℝ) := by norm_num
    _ = ENNReal.ofReal (H⁻¹ * 2) :=
      (ENNReal.ofReal_mul (inv_nonneg.mpr hH.le)).symm
    _ = ENNReal.ofReal (2 / H) := by
      rw [div_eq_mul_inv, mul_comm]

/-! ## Pushforward to the actual upper-half-plane horocycle -/

/-- The compact width-two horizontal horocycle segment upstairs. -/
def widthTwoHorocycleImage
    (H : ℝ) (hH : 0 < H) : Set ℍ :=
  QYM.FullCertification.PolygonTraceExtension.horizontalHorocyclePoint H hH '' Set.Icc (0 : ℝ) 2

theorem widthTwoHorocycleImage_isCompact
    (H : ℝ) (hH : 0 < H) :
    IsCompact (widthTwoHorocycleImage H hH) :=
  isCompact_Icc.image (QYM.FullCertification.PolygonTraceExtension.horizontalHorocyclePoint_continuous H hH)

theorem widthTwoHorocycleImage_isClosed
    (H : ℝ) (hH : 0 < H) :
    IsClosed (widthTwoHorocycleImage H hH) :=
  (widthTwoHorocycleImage_isCompact H hH).isClosed

/-- Hyperbolic arclength pushed to the genuine upper-half-plane curve. -/
noncomputable def upstairsWidthTwoHorocycleMeasure
    (H : ℝ) (hH : 0 < H) : Measure ℍ :=
  (widthTwoHyperbolicParameterMeasure H).map
    (QYM.FullCertification.PolygonTraceExtension.horizontalHorocyclePoint H hH)

noncomputable instance upstairsWidthTwoHorocycleMeasure_isFinite
    (H : ℝ) (hH : 0 < H) :
    IsFiniteMeasure (upstairsWidthTwoHorocycleMeasure H hH) :=
  Measure.isFiniteMeasure_map _ _

/-- Pushforward preserves the exact total arclength. -/
theorem upstairsWidthTwoHorocycleMeasure_univ
    (H : ℝ) (hH : 0 < H) :
    upstairsWidthTwoHorocycleMeasure H hH Set.univ =
      ENNReal.ofReal (2 / H) := by
  rw [upstairsWidthTwoHorocycleMeasure,
    Measure.map_apply
      (QYM.FullCertification.PolygonTraceExtension.horizontalHorocyclePoint_continuous H hH).measurable
      MeasurableSet.univ,
    Set.preimage_univ,
    widthTwoHyperbolicParameterMeasure_univ_of_pos hH]

/-- The upstairs measure gives zero mass to the complement of the actual
compact horocycle image. -/
theorem upstairsWidthTwoHorocycleMeasure_compl_image
    (H : ℝ) (hH : 0 < H) :
    upstairsWidthTwoHorocycleMeasure H hH
        (widthTwoHorocycleImage H hH)ᶜ = 0 := by
  rw [upstairsWidthTwoHorocycleMeasure,
    Measure.map_apply
      (QYM.FullCertification.PolygonTraceExtension.horizontalHorocyclePoint_continuous H hH).measurable
      (widthTwoHorocycleImage_isClosed H hH).measurableSet.compl]
  apply measure_mono_null
    (μ := widthTwoHyperbolicParameterMeasure H)
    (t := (Set.Icc (0 : ℝ) 2)ᶜ)
  · intro x hx hxIcc
    exact hx ⟨x, hxIcc, rfl⟩
  · exact widthTwoHyperbolicParameterMeasure_compl_Icc H

/-! ## Pushforward to the effective quotient -/

/-- The projected width-two horocycle candidate in the effective quotient.
-/
def quotientWidthTwoHorocycleImage
    (H : ℝ) (hH : 0 < H) : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk '' widthTwoHorocycleImage H hH

theorem quotientWidthTwoHorocycleImage_isCompact
    (H : ℝ) (hH : 0 < H) :
    IsCompact (quotientWidthTwoHorocycleImage H hH) :=
  (widthTwoHorocycleImage_isCompact H hH).image
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.continuous

theorem quotientWidthTwoHorocycleImage_isClosed
    (H : ℝ) (hH : 0 < H) :
    IsClosed (quotientWidthTwoHorocycleImage H hH) :=
  (quotientWidthTwoHorocycleImage_isCompact H hH).isClosed

/-- The actual pushforward arclength measure on the projected curve. -/
noncomputable def quotientWidthTwoHorocycleMeasure
    (H : ℝ) (hH : 0 < H) : Measure Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  (upstairsWidthTwoHorocycleMeasure H hH).map Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk

noncomputable instance quotientWidthTwoHorocycleMeasure_isFinite
    (H : ℝ) (hH : 0 < H) :
    IsFiniteMeasure (quotientWidthTwoHorocycleMeasure H hH) :=
  Measure.isFiniteMeasure_map _ _

/-- The orbit projection is measurable for the quotient measurable
structure.  This proof deliberately uses `measurable_quotient_mk''` rather
than `Continuous.measurable`: the effective quotient currently carries the
quotient measurable structure, and no Borel-space identification is being
smuggled into the argument. -/
theorem gammaTwoQuotientMk_measurable :
    Measurable Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk := by
  simpa only [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk] using
    (measurable_quotient_mk'' :
      Measurable
        (Quotient.mk'' : ℍ → Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient))

/-- The quotient pushforward retains exactly the same total width-two
hyperbolic arclength. -/
theorem quotientWidthTwoHorocycleMeasure_univ
    (H : ℝ) (hH : 0 < H) :
    quotientWidthTwoHorocycleMeasure H hH Set.univ =
      ENNReal.ofReal (2 / H) := by
  rw [quotientWidthTwoHorocycleMeasure,
    Measure.map_apply
      gammaTwoQuotientMk_measurable
      MeasurableSet.univ,
    Set.preimage_univ,
    upstairsWidthTwoHorocycleMeasure_univ H hH]

/-- The quotient pushforward is supported on the projected horocycle
candidate.  This is a genuine measure-theoretic statement and does not use
the still-missing identification with `frontier (XSet H)`. -/
theorem quotientWidthTwoHorocycleMeasure_compl_image
    (H : ℝ) (hH : 0 < H) :
    quotientWidthTwoHorocycleMeasure H hH
        (quotientWidthTwoHorocycleImage H hH)ᶜ = 0 := by
  rw [quotientWidthTwoHorocycleMeasure,
    Measure.map_apply
      gammaTwoQuotientMk_measurable
      (quotientWidthTwoHorocycleImage_isClosed H hH).measurableSet.compl]
  apply measure_mono_null
    (μ := upstairsWidthTwoHorocycleMeasure H hH)
    (t := (widthTwoHorocycleImage H hH)ᶜ)
  · intro z hz hzImage
    exact hz ⟨z, hzImage, rfl⟩
  · exact upstairsWidthTwoHorocycleMeasure_compl_image H hH

/-! ## All three named cusp charts -/

/-- Compact width-two segment in the actual scaling chart of a named cusp.
The horizontal coordinate used by this parametrization has height
`gammaTwoCuspLevel Y`, so this definition also respects the normalization at
small cutoffs. -/
def namedCuspHorocycleImage
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) : Set ℍ :=
  QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y '' Set.Icc (0 : ℝ) 2

theorem namedCuspHorocycleImage_isCompact
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsCompact (namedCuspHorocycleImage kappa Y) :=
