/-!
# Weak-size bounds do not imply a strong weighted-size bound

This finite-support model isolates the missing coercivity step in a direct-method argument.  The
displayed coordinate basis has constant unweighted squared size, while its weighted squared size
grows without bound.  Consequently an `L²`-type bound alone cannot provide an `H¹`-type bound.

The final theorem records the corrected elementary implication: once an explicit domination of
the strong size by the energy and weak size is supplied, uniform bounds on those two quantities do
give a uniform strong-size bound.  No Sobolev space, gauge estimate, weak compactness, or lower
semicontinuity theorem is claimed here.
-/

namespace QYM.FinsuppStrongNormNoGo

abbrev State := QYM.FinsuppDiagonalQuadraticForm.State

/-- The unweighted finite-support squared size. -/
def weakNormSq : State → ℝ :=
  QYM.FinsuppDiagonalQuadraticForm.normSq

/-- The weighted squared size with diagonal weight `n + 1`. -/
def strongNormSq : State → ℝ :=
  QYM.FinsuppDiagonalQuadraticForm.correctedEnergy (fun _ => 1)

/-- The already constructed coordinate unit state. -/
def basis (n : ℕ) : State :=
  QYM.FinsuppDiagonalQuadraticForm.basis n

@[simp]
theorem weakNormSq_basis (n : ℕ) : weakNormSq (basis n) = 1 := by
  exact QYM.FinsuppDiagonalQuadraticForm.normSq_basis n

@[simp]
theorem strongNormSq_basis (n : ℕ) : strongNormSq (basis n) = (n : ℝ) + 1 := by
  exact QYM.FinsuppDiagonalQuadraticForm.correctedEnergy_basis (fun _ => 1) n

theorem basis_weakSize_constant :
    ∀ n : ℕ, weakNormSq (basis n) = 1 :=
  weakNormSq_basis

theorem basis_strongSize_arbitrarilyLarge :
    ∀ threshold : ℝ, ∃ n : ℕ, threshold < strongNormSq (basis n) := by
  intro threshold
  obtain ⟨n, hn⟩ := exists_nat_gt threshold
  refine ⟨n, ?_⟩
  rw [strongNormSq_basis]
  linarith

/-- A uniform linear control of the weighted size by the unweighted size. -/
def HasUniformStrongControl : Prop :=
  ∃ C : ℝ, ∀ x : State, strongNormSq x ≤ C * weakNormSq x

/-- No such control exists: test it on a sufficiently high coordinate unit state. -/
theorem not_hasUniformStrongControl : ¬ HasUniformStrongControl := by
  rintro ⟨C, hcontrol⟩
  obtain ⟨n, hn⟩ := exists_nat_gt C
  have hbasis := hcontrol (basis n)
  rw [strongNormSq_basis, weakNormSq_basis, mul_one] at hbasis
  linarith

/-- Explicit counterexample package: the weak size is uniformly one, the strong size is
arbitrarily large, and hence no uniform strong-by-weak estimate exists. -/
theorem weakBound_does_not_imply_strongBound :
    (∀ n : ℕ, weakNormSq (basis n) = 1) ∧
      (∀ threshold : ℝ, ∃ n : ℕ, threshold < strongNormSq (basis n)) ∧
      ¬ HasUniformStrongControl :=
  ⟨basis_weakSize_constant, basis_strongSize_arbitrarilyLarge,
    not_hasUniformStrongControl⟩

/-! ## Corrected explicit domination logic -/

/-- A displayed estimate that makes the missing coercivity input visible. -/
def StrongControlledByEnergy {X : Type*}
    (strongSize energy weakSize : X → ℝ) (energyCoefficient weakCoefficient : ℝ) : Prop :=
  ∀ x : X,
    strongSize x ≤ energyCoefficient * energy x + weakCoefficient * weakSize x

/-- Under nonnegative coefficients, explicit uniform energy and weak-size bounds propagate
through the displayed domination estimate. -/
theorem strongBound_of_energy_and_weakBounds {X : Type*}
    (strongSize energy weakSize : X → ℝ)
    (energyCoefficient weakCoefficient energyBound weakBound : ℝ)
    (henergyCoefficient : 0 ≤ energyCoefficient)
    (hweakCoefficient : 0 ≤ weakCoefficient)
    (hdomination : StrongControlledByEnergy strongSize energy weakSize
      energyCoefficient weakCoefficient)
    (henergy : ∀ x, energy x ≤ energyBound)
    (hweak : ∀ x, weakSize x ≤ weakBound) :
    ∀ x, strongSize x ≤
      energyCoefficient * energyBound + weakCoefficient * weakBound := by
  intro x
  calc
    strongSize x ≤
        energyCoefficient * energy x + weakCoefficient * weakSize x := hdomination x
    _ ≤ energyCoefficient * energyBound + weakCoefficient * weakBound :=
      add_le_add
        (mul_le_mul_of_nonneg_left (henergy x) henergyCoefficient)
        (mul_le_mul_of_nonneg_left (hweak x) hweakCoefficient)

end QYM.FinsuppStrongNormNoGo




/-!
# Stability of finite indexed real spectral families

Let `reference perturbed : Fin n → ℝ` be two finite families whose entries are matched by the
same index.  This module packages the uniform pointwise estimate

`|perturbed i - reference i| ≤ ε`

and derives its elementary consequences one lemma at a time.  No monotonicity or sortedness of
either family is assumed.  Consequently, every gap theorem below applies to arbitrary indices
`i j`; using them as consecutive eigenvalue indices is an additional interpretation made by the
caller.  Repeated spectral values are retained through their distinct `Fin n` indices.

## Exact relationship to the paper

* Theorem 4.31(B1), PDF p. 44, concludes the pointwise estimate above with
  `ε = ‖μ_q‖∞` for the ordered eigenvalue enumerations.  Here that conclusion is the hypothesis
  `UniformError`; this finite module does **not** construct the operators, prove self-adjointness,
  compact resolvent, min--max, or Theorem 4.31 itself.
* `margin_gap_stability`, `quarter_error_preserves_half_margin`, and
  `positive_margin_gap` are the exact finite arithmetic core of Corollary 4.32(B1): a reference
  gap `≥ δ` becomes a perturbed gap `≥ δ - 2 * ε`, hence remains positive for `2 * ε < δ` and is
  at least `δ / 2` for `ε ≤ δ / 4`.
* `symmetric_expanded_window_subsets` and
  `symmetric_expanded_window_count_bounds` are the finite, same-index version of Corollary 4.33,
  PDF p. 45.  They reuse `QYM.SpectralWindowStability` and widen both directions by `ε`.
* The B2 relative-form estimate of Theorem 4.31 is not claimed here: its bounds depend on each
  reference eigenvalue and are not a single uniform additive error without further hypotheses.
* The final two-step lemmas are an additional triangle/composition principle for successive B1
  perturbations; they are not attributed to a separately numbered paper result.
-/

namespace QYM.FiniteSpectralFamilyStability

open QYM.SpectralWindowStability

/-! ## Uniform same-index error -/

/-- A uniform additive error bound between two equally indexed finite real families. -/
def UniformError {n : ℕ}
    (reference perturbed : Fin n → ℝ) (ε : ℝ) : Prop :=
  ∀ i, |perturbed i - reference i| ≤ ε

theorem uniformError_iff {n : ℕ}
    (reference perturbed : Fin n → ℝ) (ε : ℝ) :
    UniformError reference perturbed ε ↔
      ∀ i, |perturbed i - reference i| ≤ ε :=
  Iff.rfl

/-- Extract the individual eigenvalue estimate at one supplied index. -/
theorem individual_eigenvalue_error {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i : Fin n) :
    |perturbed i - reference i| ≤ ε :=
  herror i

/-- A uniform error bound is symmetric in the two indexed families. -/
theorem uniformError_symm {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) :
    UniformError perturbed reference ε := by
  intro i
  rw [abs_sub_comm]
  exact herror i

/-- Enlarging the allowed error preserves a uniform error estimate. -/
theorem uniformError_mono {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε ε' : ℝ}
    (herror : UniformError reference perturbed ε) (hε : ε ≤ ε') :
    UniformError reference perturbed ε' := by
  intro i
  exact (herror i).trans hε

/-- Reflexivity at any nonnegative error radius. -/
theorem uniformError_refl {n : ℕ}
    (spectrum : Fin n → ℝ) {ε : ℝ} (hε : 0 ≤ ε) :
    UniformError spectrum spectrum ε := by
  intro i
  simpa using hε

/-- As soon as an index is supplied, any valid error radius is nonnegative. -/
theorem error_nonneg_of_index {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i : Fin n) :
    0 ≤ ε :=
  (abs_nonneg (perturbed i - reference i)).trans (herror i)

/-- The absolute estimate gives the lower endpoint of the individual interval. -/
theorem individual_eigenvalue_lower_bound {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i : Fin n) :
    reference i - ε ≤ perturbed i := by
  obtain ⟨hlower, _⟩ := abs_le.mp (herror i)
  linarith

/-- The absolute estimate gives the upper endpoint of the individual interval. -/
theorem individual_eigenvalue_upper_bound {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i : Fin n) :
    perturbed i ≤ reference i + ε := by
  obtain ⟨_, hupper⟩ := abs_le.mp (herror i)
  linarith

/-- The individual perturbed value lies in the closed additive error interval. -/
theorem individual_eigenvalue_interval {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i : Fin n) :
    reference i - ε ≤ perturbed i ∧ perturbed i ≤ reference i + ε :=
  ⟨individual_eigenvalue_lower_bound herror i,
    individual_eigenvalue_upper_bound herror i⟩

/-! ## Arbitrary pairwise gaps -/

/-- The change of the gap between any two matched indices has absolute value at most `2 * ε`.
No order relation between `i` and `j`, and no sortedness of either family, is used. -/
theorem pairwise_gap_error {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    |(perturbed j - perturbed i) - (reference j - reference i)| ≤ 2 * ε := by
  obtain ⟨hiLower, hiUpper⟩ := abs_le.mp (herror i)
  obtain ⟨hjLower, hjUpper⟩ := abs_le.mp (herror j)
  apply abs_le.mpr
  constructor <;> linarith

/-- The amount by which an arbitrary reference gap can shrink is at most `2 * ε`. -/
theorem pairwise_gap_loss_le {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    (reference j - reference i) - (perturbed j - perturbed i) ≤ 2 * ε := by
  have hlower := (abs_le.mp (pairwise_gap_error herror i j)).1
  linarith

/-- Dually, the amount by which an arbitrary reference gap can grow is at most `2 * ε`. -/
theorem pairwise_gap_gain_le {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    (perturbed j - perturbed i) - (reference j - reference i) ≤ 2 * ε := by
  exact (abs_le.mp (pairwise_gap_error herror i j)).2

/-- Lower endpoint of the pairwise perturbed-gap interval. -/
theorem pairwise_gap_lower_bound {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    (reference j - reference i) - 2 * ε ≤ perturbed j - perturbed i := by
  have hloss := pairwise_gap_loss_le herror i j
  linarith

/-- Upper endpoint of the pairwise perturbed-gap interval. -/
theorem pairwise_gap_upper_bound {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    perturbed j - perturbed i ≤ (reference j - reference i) + 2 * ε := by
  have hgain := pairwise_gap_gain_le herror i j
  linarith

/-- Both endpoints of the exact additive pairwise-gap enclosure. -/
theorem pairwise_gap_interval {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n) :
    (reference j - reference i) - 2 * ε ≤ perturbed j - perturbed i ∧
      perturbed j - perturbed i ≤ (reference j - reference i) + 2 * ε :=
  ⟨pairwise_gap_lower_bound herror i j, pairwise_gap_upper_bound herror i j⟩

/-- Corollary 4.32(B1), finite arithmetic core: a certified reference margin loses at most
`2 * ε`. -/
theorem margin_gap_stability {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε δ : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hmargin : δ ≤ reference j - reference i) :
    δ - 2 * ε ≤ perturbed j - perturbed i := by
  have hpair := pairwise_gap_lower_bound herror i j
  linarith

/-- A pairwise gap remains strictly positive whenever its reference value is larger than
`2 * ε`. -/
theorem positive_pairwise_gap {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hgap : 2 * ε < reference j - reference i) :
    0 < perturbed j - perturbed i := by
  have hpair := pairwise_gap_lower_bound herror i j
  linarith

/-- The same positive-gap statement expressed as preservation of strict order. -/
theorem strict_order_preserved {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hgap : 2 * ε < reference j - reference i) :
    perturbed i < perturbed j :=
  sub_pos.mp (positive_pairwise_gap herror i j hgap)

/-- If a reference gap is at least `δ` and `2 * ε < δ`, the perturbed gap is positive. -/
theorem positive_margin_gap {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε δ : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hmargin : δ ≤ reference j - reference i) (hsmall : 2 * ε < δ) :
    0 < perturbed j - perturbed i := by
  exact positive_pairwise_gap herror i j (lt_of_lt_of_le hsmall hmargin)

/-- The paper's quarter-error criterion preserves at least one half of a reference margin. -/
theorem quarter_error_preserves_half_margin {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε δ : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hmargin : δ ≤ reference j - reference i) (hquarter : ε ≤ δ / 4) :
    δ / 2 ≤ perturbed j - perturbed i := by
  have hstable := margin_gap_stability herror i j hmargin
  linarith

/-- With a positive reference margin, the quarter-error criterion also gives a positive
perturbed gap. -/
theorem quarter_error_preserves_positive_gap {n : ℕ}
    {reference perturbed : Fin n → ℝ} {ε δ : ℝ}
    (herror : UniformError reference perturbed ε) (i j : Fin n)
    (hmargin : δ ≤ reference j - reference i)
    (hδ : 0 < δ) (hquarter : ε ≤ δ / 4) :
    0 < perturbed j - perturbed i := by
  have hhalf := quarter_error_preserves_half_margin herror i j hmargin hquarter
  linarith

/-! ## Symmetric expanded spectral windows -/

/-- A perturbed window is contained in the reference window widened by `ε`. -/
theorem perturbed_window_subset_reference_expansion {n : ℕ}
    {reference perturbed : Fin n → ℝ} {center η ε : ℝ}
    (herror : UniformError reference perturbed ε) :
    windowIndices perturbed center η ⊆
      windowIndices reference center (η + ε) :=
  perturbed_window_subset_expanded_reference_window
    reference perturbed center η ε (fun i => herror i)

/-- By symmetry of absolute error, a reference window is contained in the perturbed window
widened by the same `ε`. -/
theorem reference_window_subset_perturbed_expansion {n : ℕ}
    {reference perturbed : Fin n → ℝ} {center η ε : ℝ}
    (herror : UniformError reference perturbed ε) :
    windowIndices reference center η ⊆
      windowIndices perturbed center (η + ε) :=
  perturbed_window_subset_expanded_reference_window
    perturbed reference center η ε (fun i => uniformError_symm herror i)

/-- Both same-index expanded-window inclusions from Corollary 4.33(B1). -/
theorem symmetric_expanded_window_subsets {n : ℕ}
    {reference perturbed : Fin n → ℝ} {center η ε : ℝ}
    (herror : UniformError reference perturbed ε) :
    windowIndices perturbed center η ⊆
        windowIndices reference center (η + ε) ∧
      windowIndices reference center η ⊆
        windowIndices perturbed center (η + ε) :=
  ⟨perturbed_window_subset_reference_expansion herror,
    reference_window_subset_perturbed_expansion herror⟩

/-- Cardinality form of the two symmetric expanded-window inclusions.  Multiplicity is the
number of indices in `Fin n`, including repeated values at different indices. -/
theorem symmetric_expanded_window_count_bounds {n : ℕ}
    {reference perturbed : Fin n → ℝ} {center η ε : ℝ}
    (herror : UniformError reference perturbed ε) :
    (windowIndices perturbed center η).card ≤
        (windowIndices reference center (η + ε)).card ∧
      (windowIndices reference center η).card ≤
        (windowIndices perturbed center (η + ε)).card := by
  constructor
  · exact Finset.card_le_card (perturbed_window_subset_reference_expansion herror)
  · exact Finset.card_le_card (reference_window_subset_perturbed_expansion herror)

/-! ## Two successive perturbations -/

/-- Triangle inequality for two successive same-index perturbations. -/
theorem uniformError_triangle {n : ℕ}
    {reference middle perturbed : Fin n → ℝ} {ε₁ ε₂ : ℝ}
    (hfirst : UniformError reference middle ε₁)
    (hsecond : UniformError middle perturbed ε₂) :
    UniformError reference perturbed (ε₁ + ε₂) := by
  intro i
  calc
    |perturbed i - reference i| =
        |(middle i - reference i) + (perturbed i - middle i)| := by ring_nf
    _ ≤ |middle i - reference i| + |perturbed i - middle i| := abs_add_le _ _
    _ ≤ ε₁ + ε₂ := add_le_add (hfirst i) (hsecond i)

/-- Composition-name alias for the two-step triangle estimate. -/
theorem uniformError_compose {n : ℕ}
    {reference middle perturbed : Fin n → ℝ} {ε₁ ε₂ : ℝ}
    (hfirst : UniformError reference middle ε₁)
    (hsecond : UniformError middle perturbed ε₂) :
    UniformError reference perturbed (ε₁ + ε₂) :=
  uniformError_triangle hfirst hsecond

/-- The two-step triangle bound at one selected index. -/
theorem two_step_individual_eigenvalue_error {n : ℕ}
    {reference middle perturbed : Fin n → ℝ} {ε₁ ε₂ : ℝ}
    (hfirst : UniformError reference middle ε₁)
    (hsecond : UniformError middle perturbed ε₂) (i : Fin n) :
    |perturbed i - reference i| ≤ ε₁ + ε₂ :=
  uniformError_triangle hfirst hsecond i

/-- Two successive perturbations can shrink an arbitrary reference gap by at most twice the
sum of their error radii. -/
theorem two_step_pairwise_gap_loss_le {n : ℕ}
    {reference middle perturbed : Fin n → ℝ} {ε₁ ε₂ : ℝ}
    (hfirst : UniformError reference middle ε₁)
    (hsecond : UniformError middle perturbed ε₂) (i j : Fin n) :
    (reference j - reference i) - (perturbed j - perturbed i) ≤
      2 * (ε₁ + ε₂) :=
  pairwise_gap_loss_le (uniformError_triangle hfirst hsecond) i j

/-- Two-step version of the symmetric expanded-window cardinality bounds. -/
theorem two_step_symmetric_expanded_window_count_bounds {n : ℕ}
    {reference middle perturbed : Fin n → ℝ} {center η ε₁ ε₂ : ℝ}
    (hfirst : UniformError reference middle ε₁)
    (hsecond : UniformError middle perturbed ε₂) :
    (windowIndices perturbed center η).card ≤
        (windowIndices reference center (η + (ε₁ + ε₂))).card ∧
      (windowIndices reference center η).card ≤
        (windowIndices perturbed center (η + (ε₁ + ε₂))).card :=
  symmetric_expanded_window_count_bounds (uniformError_triangle hfirst hsecond)

end QYM.FiniteSpectralFamilyStability


open Set Topology

/-!
# Compact direct-method bridges

These lemmas isolate the exact compactness and lower-semicontinuity inputs needed by the
direct method.  No reflexivity, Sobolev compactness, weak closure, or coercivity fact is hidden in
a definition: each such supplier appears as an explicit hypothesis.

For weak compactness, the current Mathlib API transfers Banach--Alaoglu compactness from the
weak-star bidual under an explicit range-closure hypothesis.  Accordingly, the weak-space lemmas
below state that hypothesis verbatim.  They do not claim that an arbitrary Banach space is
reflexive, and they do not manufacture the range hypothesis from an unformalized reflexivity
argument.
-/

namespace QYM.FullCertification.Corrected.DirectMethod

/-! ## Topological direct method -/

/-- A real-valued lower-semicontinuous functional attains its minimum on a nonempty compact
feasible set. -/
theorem exists_minimizer_on_compact
    {X : Type*} [TopologicalSpace X] {feasible : Set X} {energy : X → ℝ}
    (hne : feasible.Nonempty) (hcompact : IsCompact feasible)
    (hlsc : LowerSemicontinuousOn energy feasible) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  obtain ⟨minimizer, hminimizer, hminimal⟩ := hlsc.exists_isMinOn hne hcompact
  exact ⟨minimizer, hminimizer, isMinOn_iff.mp hminimal⟩

/-- The sublevel cut of a lower-semicontinuous functional inside a compact feasible set is
compact. -/
theorem isCompact_sublevel_on_compact
    {X : Type*} [TopologicalSpace X] {feasible : Set X} {energy : X → ℝ}
    (hcompact : IsCompact feasible) (hlsc : LowerSemicontinuousOn energy feasible)
    (level : ℝ) :
    IsCompact (feasible ∩ energy ⁻¹' Set.Iic level) :=
  hlsc.isCompact_inter_preimage_Iic hcompact level

/-- Continuity is a sufficient, stronger input for compact-set attainment. -/
theorem exists_minimizer_on_compact_of_continuous
    {X : Type*} [TopologicalSpace X] {feasible : Set X} {energy : X → ℝ}
    (hne : feasible.Nonempty) (hcompact : IsCompact feasible)
    (hcontinuous : ContinuousOn energy feasible) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor :=
  exists_minimizer_on_compact hne hcompact hcontinuous.lowerSemicontinuousOn

/-- A closed epigraph over a closed feasible set supplies lower semicontinuity, hence compact-set
attainment. -/
theorem exists_minimizer_on_compact_of_closed_epigraph
    {X : Type*} [TopologicalSpace X] {feasible : Set X} {energy : X → ℝ}
    (hne : feasible.Nonempty) (hcompact : IsCompact feasible)
    (hclosed : IsClosed feasible)
    (hepigraph : IsClosed {point : X × ℝ | point.1 ∈ feasible ∧ energy point.1 ≤ point.2}) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  apply exists_minimizer_on_compact hne hcompact
  exact (lowerSemicontinuousOn_iff_isClosed_epigraph hclosed).mpr hepigraph

/-- A compact core suffices for global minimization if one reference point in the core has no
larger energy than every feasible point outside the core.  This is the exact topological reduction
normally supplied by a coercive sublevel-set estimate. -/
theorem exists_minimizer_of_compact_core
    {X : Type*} [TopologicalSpace X]
    {feasible core : Set X} {energy : X → ℝ} {reference : X}
    (hcore_nonempty : core.Nonempty) (hcore_compact : IsCompact core)
    (hcore_subset : core ⊆ feasible) (hlsc : LowerSemicontinuousOn energy core)
    (href : reference ∈ core)
    (houtside : ∀ competitor ∈ feasible, competitor ∉ core →
      energy reference ≤ energy competitor) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  obtain ⟨minimizer, hminimizer, hminimal⟩ :=
    exists_minimizer_on_compact hcore_nonempty hcore_compact hlsc
  refine ⟨minimizer, hcore_subset hminimizer, ?_⟩
  intro competitor hcompetitor
  by_cases hcompetitor_core : competitor ∈ core
  · exact hminimal competitor hcompetitor_core
  · exact (hminimal reference href).trans
      (houtside competitor hcompetitor hcompetitor_core)

/-! ## Finite-dimensional closed-bounded route -/

/-- In a finite-dimensional real normed space, closedness and boundedness provide the compactness
supplier required by the direct method. -/
theorem exists_minimizer_on_closed_bounded_finiteDimensional
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    {feasible : Set E} {energy : E → ℝ}
    (hne : feasible.Nonempty) (hclosed : IsClosed feasible)
    (hbounded : Bornology.IsBounded feasible)
    (hlsc : LowerSemicontinuousOn energy feasible) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  have hcompact : IsCompact feasible :=
    Metric.isCompact_iff_isClosed_bounded.mpr ⟨hclosed, hbounded⟩
  exact exists_minimizer_on_compact hne hcompact hlsc

/-! ## Weak-space route through the bidual -/

/-- Banach--Alaoglu gives direct-method attainment on a nonempty, bounded, weak-star closed subset
of a continuous dual.  This theorem is about `WeakDual`, not yet about the primal weak space. -/
theorem exists_weakStar_minimizer_on_closed_bounded
    {𝕜 E : Type*} [NontriviallyNormedField 𝕜] [ProperSpace 𝕜]
    [SeminormedAddCommGroup E] [NormedSpace 𝕜 E]
    {feasible : Set (WeakDual 𝕜 E)} {energy : WeakDual 𝕜 E → ℝ}
    (hne : feasible.Nonempty) (hbounded : Bornology.IsBounded feasible)
    (hclosed : IsClosed feasible) (hlsc : LowerSemicontinuousOn energy feasible) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  exact exists_minimizer_on_compact hne
    (WeakDual.isCompact_of_bounded_of_closed hbounded hclosed) hlsc

/-- Sequential Banach--Alaoglu on a separable predual extracts a weak-star convergent
subsequence. -/
theorem exists_weakStar_convergent_subsequence_on_closed_bounded
    {𝕜 E : Type*} [NontriviallyNormedField 𝕜] [ProperSpace 𝕜]
    [SeminormedAddCommGroup E] [NormedSpace 𝕜 E]
    [TopologicalSpace.SeparableSpace E]
    {feasible : Set (WeakDual 𝕜 E)}
    (hbounded : Bornology.IsBounded feasible) (hclosed : IsClosed feasible)
    (sequence : ℕ → WeakDual 𝕜 E) (hsequence : ∀ n, sequence n ∈ feasible) :
    ∃ limit ∈ feasible, ∃ extraction : ℕ → ℕ,
      StrictMono extraction ∧
        Tendsto (sequence ∘ extraction) Filter.atTop (nhds limit) := by
  exact (WeakDual.isSeqCompact_of_isBounded_of_isClosed 𝕜 E hbounded hclosed) hsequence

/-- A norm-closed real-convex set becomes closed in the weak topology.  This is the closed-set
form of `Convex.toWeakSpace_closure`. -/
theorem isClosed_toWeakSpace_image_of_closed_convex_real
    {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    {feasible : Set X} (hconvex : Convex ℝ feasible) (hclosed : IsClosed feasible) :
    IsClosed (toWeakSpace ℝ X '' feasible) := by
  rw [← closure_eq_iff_isClosed]
  rw [← hconvex.toWeakSpace_closure ℝ, hclosed.closure_eq]

/-- A weakly closed set is weakly compact when it is norm bounded and the weak-star closure of
its bidual image stays in the canonical image.  The last condition is the precise range condition
used by `NormedSpace.isCompact_closure_of_isBounded`; a future reflexivity API may discharge it. -/
theorem isCompact_weak_of_closed_bounded_of_bidualRange
    {𝕜 X : Type*} [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedSpace 𝕜 X]
    {feasible : Set (WeakSpace 𝕜 X)}
    (hbounded : Bornology.IsBounded ((toWeakSpace 𝕜 X) ⁻¹' feasible))
    (hrange : closure (NormedSpace.inclusionInDoubleDualWeak 𝕜 X '' feasible) ⊆
      Set.range (NormedSpace.inclusionInDoubleDualWeak 𝕜 X))
    (hclosed : IsClosed feasible) :
    IsCompact feasible := by
  have hcompact_closure : IsCompact (closure feasible) :=
    NormedSpace.isCompact_closure_of_isBounded 𝕜 X feasible hbounded hrange
  rwa [hclosed.closure_eq] at hcompact_closure

/-- Real closed, bounded, convex sets are weakly compact once the canonical bidual image satisfies
the explicit range-closure condition used by Mathlib's Banach--Alaoglu transfer theorem. -/
theorem isCompact_toWeakSpace_image_of_closed_bounded_convex_of_bidualRange_real
    {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    {feasible : Set X}
    (hconvex : Convex ℝ feasible) (hclosed : IsClosed feasible)
    (hbounded : Bornology.IsBounded feasible)
    (hrange : closure
        (NormedSpace.inclusionInDoubleDualWeak ℝ X '' (toWeakSpace ℝ X '' feasible)) ⊆
      Set.range (NormedSpace.inclusionInDoubleDualWeak ℝ X)) :
    IsCompact (toWeakSpace ℝ X '' feasible) := by
  apply isCompact_weak_of_closed_bounded_of_bidualRange
  · simpa only [Set.preimage_image_eq feasible (toWeakSpace ℝ X).injective] using hbounded
  · exact hrange
  · exact isClosed_toWeakSpace_image_of_closed_convex_real hconvex hclosed

/-- Direct-method attainment on the weak image of a nonempty real closed, bounded, convex set.
Weak lower semicontinuity and the bidual range condition remain explicit suppliers. -/
theorem exists_weak_minimizer_on_closed_bounded_convex_image_of_bidualRange_real
    {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    {feasible : Set X} {energy : WeakSpace ℝ X → ℝ}
    (hne : feasible.Nonempty) (hconvex : Convex ℝ feasible)
    (hclosed : IsClosed feasible) (hbounded : Bornology.IsBounded feasible)
    (hrange : closure
        (NormedSpace.inclusionInDoubleDualWeak ℝ X '' (toWeakSpace ℝ X '' feasible)) ⊆
      Set.range (NormedSpace.inclusionInDoubleDualWeak ℝ X))
    (hlsc : LowerSemicontinuousOn energy (toWeakSpace ℝ X '' feasible)) :
    ∃ minimizer ∈ toWeakSpace ℝ X '' feasible,
      ∀ competitor ∈ toWeakSpace ℝ X '' feasible,
        energy minimizer ≤ energy competitor := by
  exact exists_minimizer_on_compact (hne.image (toWeakSpace ℝ X))
    (isCompact_toWeakSpace_image_of_closed_bounded_convex_of_bidualRange_real
      hconvex hclosed hbounded hrange) hlsc

/-- Direct-method attainment in the weak topology, with all norm-boundedness, bidual-range,
weak-closedness, and weak lower-semicontinuity hypotheses exposed. -/
theorem exists_weak_minimizer_of_closed_bounded_of_bidualRange
    {𝕜 X : Type*} [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedSpace 𝕜 X]
    {feasible : Set (WeakSpace 𝕜 X)} {energy : WeakSpace 𝕜 X → ℝ}
    (hne : feasible.Nonempty)
    (hbounded : Bornology.IsBounded ((toWeakSpace 𝕜 X) ⁻¹' feasible))
    (hrange : closure (NormedSpace.inclusionInDoubleDualWeak 𝕜 X '' feasible) ⊆
      Set.range (NormedSpace.inclusionInDoubleDualWeak 𝕜 X))
    (hclosed : IsClosed feasible)
    (hlsc : LowerSemicontinuousOn energy feasible) :
    ∃ minimizer ∈ feasible, ∀ competitor ∈ feasible, energy minimizer ≤ energy competitor := by
  exact exists_minimizer_on_compact hne
    (isCompact_weak_of_closed_bounded_of_bidualRange hbounded hrange hclosed) hlsc

/-- Under first countability of the weak topology, the same compactness package extracts a weakly
convergent subsequence from every sequence in the feasible set.  First countability is explicit
because compactness alone does not imply sequential compactness in an arbitrary topology. -/
theorem exists_weakly_convergent_subsequence_of_bidualRange
    {𝕜 X : Type*} [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedSpace 𝕜 X]
    [FirstCountableTopology (WeakSpace 𝕜 X)]
    {feasible : Set (WeakSpace 𝕜 X)}
    (hbounded : Bornology.IsBounded ((toWeakSpace 𝕜 X) ⁻¹' feasible))
    (hrange : closure (NormedSpace.inclusionInDoubleDualWeak 𝕜 X '' feasible) ⊆
      Set.range (NormedSpace.inclusionInDoubleDualWeak 𝕜 X))
    (hclosed : IsClosed feasible)
    (sequence : ℕ → WeakSpace 𝕜 X) (hsequence : ∀ n, sequence n ∈ feasible) :
    ∃ limit ∈ feasible, ∃ extraction : ℕ → ℕ,
      StrictMono extraction ∧
        Tendsto (sequence ∘ extraction) Filter.atTop (nhds limit) := by
  exact (isCompact_weak_of_closed_bounded_of_bidualRange hbounded hrange hclosed).tendsto_subseq
    hsequence

end QYM.FullCertification.Corrected.DirectMethod



/-!
# Arithmetic core for relatively form-small perturbations

This module isolates the real-order calculation behind the relative form-bound condition used in
Definition 4.8(B2) and the lower-bound part of Lemma 4.30.  A "form" here is deliberately only a
function `State → ℝ`; all domain, closedness, self-adjointness, representation, and compactness
questions are outside the scope of these declarations.

Consequently, the theorems below certify pointwise inequalities and transfer of displayed form
lower bounds.  They do not assert KLMN, existence of a Friedrichs extension, self-adjointness,
compact resolvent, eigenvalue continuity, or a min--max principle.
-/

namespace QYM.FormSmallPerturbationCore

open QYM.AbstractFormSign

variable {State : Type*}

/-! ## Transparent relative-bound predicates -/

/-- The perturbation has relative absolute bound `(a,b)` with respect to `kinetic` and `normSq`.

This is the exact pointwise inequality
`|perturbation x| ≤ a * kinetic x + b * normSq x`; no analytic conclusion is bundled into it. -/
def RelativeFormAbsBoundBy
    (kinetic normSq perturbation : State → ℝ) (a b : ℝ) : Prop :=
  ∀ x : State,
    |perturbation x| ≤ a * kinetic x + b * normSq x

/-- A displayed relative bound is form-small when its relative coefficient lies in `[0,1)` and
its remainder coefficient is nonnegative. -/
def FormSmall
    (kinetic normSq perturbation : State → ℝ) (a b : ℝ) : Prop :=
  0 ≤ a ∧ a < 1 ∧ 0 ≤ b ∧
    RelativeFormAbsBoundBy kinetic normSq perturbation a b

/-- Existence of coefficients witnessing the form-small inequality.

When `State` is instantiated by the form domain `D(Q)`, this is exactly the existential
coefficient part of Definition 4.8(B2).  It deliberately does not package the additional statement
that the perturbation comes from a measurable real multiplication operator. -/
def HasFormSmallBound
    (kinetic normSq perturbation : State → ℝ) : Prop :=
  ∃ a b : ℝ, FormSmall kinetic normSq perturbation a b

/-- Unfolding rule for the transparent relative-bound predicate. -/
theorem relativeFormAbsBoundBy_iff
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ} :
    RelativeFormAbsBoundBy kinetic normSq perturbation a b ↔
      ∀ x : State,
        |perturbation x| ≤ a * kinetic x + b * normSq x :=
  Iff.rfl

/-- Unfolding rule for the transparent form-smallness predicate. -/
theorem formSmall_iff
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ} :
    FormSmall kinetic normSq perturbation a b ↔
      0 ≤ a ∧ a < 1 ∧ 0 ≤ b ∧
        RelativeFormAbsBoundBy kinetic normSq perturbation a b :=
  Iff.rfl

/-- Unfolding rule for existence of a form-small certificate. -/
theorem hasFormSmallBound_iff
    {kinetic normSq perturbation : State → ℝ} :
    HasFormSmallBound kinetic normSq perturbation ↔
      ∃ a b : ℝ, FormSmall kinetic normSq perturbation a b :=
  Iff.rfl

/-- A displayed coefficient certificate supplies the existential B2 inequality regime. -/
theorem hasFormSmallBound_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    HasFormSmallBound kinetic normSq perturbation :=
  ⟨a, b, hsmall⟩

/-- Elimination rule exposing both coefficient witnesses of a form-small regime. -/
theorem hasFormSmallBound_elim
    {kinetic normSq perturbation : State → ℝ} {P : Prop}
    (hsmall : HasFormSmallBound kinetic normSq perturbation)
    (hP : ∀ a b : ℝ, FormSmall kinetic normSq perturbation a b → P) :
    P := by
  rcases hsmall with ⟨a, b, hsmall⟩
  exact hP a b hsmall

theorem formSmall_relativeCoefficient_nonneg
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    0 ≤ a :=
  hsmall.1

theorem formSmall_relativeCoefficient_lt_one
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    a < 1 :=
  hsmall.2.1

theorem formSmall_remainderCoefficient_nonneg
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    0 ≤ b :=
  hsmall.2.2.1

theorem formSmall_relativeBound
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    RelativeFormAbsBoundBy kinetic normSq perturbation a b :=
  hsmall.2.2.2

theorem formSmall_relativeCoefficient_le_one
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    a ≤ 1 :=
  le_of_lt (formSmall_relativeCoefficient_lt_one hsmall)

/-- Form-smallness makes the retained kinetic coefficient strictly positive. -/
theorem formSmall_one_sub_relativeCoefficient_pos
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    0 < 1 - a := by
  exact sub_pos.mpr (formSmall_relativeCoefficient_lt_one hsmall)

/-! ## Pointwise two-sided estimates -/

/-- The upper half of a relative absolute bound. -/
theorem perturbation_le_relativeMajorant
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    perturbation x ≤ a * kinetic x + b * normSq x := by
  exact (abs_le.mp (hbound x)).2

/-- The lower half of a relative absolute bound, before distributing the negation. -/
theorem neg_relativeMajorant_le_perturbation
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    -(a * kinetic x + b * normSq x) ≤ perturbation x := by
  exact (abs_le.mp (hbound x)).1

/-- Any displayed relative absolute bound forces its pointwise majorant to be nonnegative. -/
theorem relativeMajorant_nonneg
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    0 ≤ a * kinetic x + b * normSq x :=
  le_trans (abs_nonneg (perturbation x)) (hbound x)

/-- The lower half of a relative absolute bound in coefficient-expanded form. -/
theorem neg_relativeTerms_le_perturbation
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    -a * kinetic x - b * normSq x ≤ perturbation x := by
  calc
    -a * kinetic x - b * normSq x =
        -(a * kinetic x + b * normSq x) := by ring
    _ ≤ perturbation x := neg_relativeMajorant_le_perturbation hbound x

/-- The lower enclosure for the perturbed sum `kinetic + perturbation`. -/
theorem plusForm_lower_pointwise
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    (1 - a) * kinetic x - b * normSq x ≤
      plusForm kinetic perturbation x := by
  calc
    (1 - a) * kinetic x - b * normSq x =
        kinetic x + (-a * kinetic x - b * normSq x) := by ring
    _ ≤ kinetic x + perturbation x :=
      add_le_add_right (neg_relativeTerms_le_perturbation hbound x) (kinetic x)
    _ = plusForm kinetic perturbation x := rfl

/-- The upper enclosure for the perturbed sum `kinetic + perturbation`. -/
theorem plusForm_upper_pointwise
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    plusForm kinetic perturbation x ≤
      (1 + a) * kinetic x + b * normSq x := by
  calc
    plusForm kinetic perturbation x = kinetic x + perturbation x := rfl
    _ ≤ kinetic x + (a * kinetic x + b * normSq x) :=
      add_le_add_right (perturbation_le_relativeMajorant hbound x) (kinetic x)
    _ = (1 + a) * kinetic x + b * normSq x := by ring

/-- Both sides of the pointwise enclosure, packaged without adding analytic structure. -/
theorem plusForm_mem_relativeEnclosure
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b)
    (x : State) :
    (1 - a) * kinetic x - b * normSq x ≤
        plusForm kinetic perturbation x ∧
      plusForm kinetic perturbation x ≤
        (1 + a) * kinetic x + b * normSq x :=
  ⟨plusForm_lower_pointwise hbound x, plusForm_upper_pointwise hbound x⟩

/-! ## Transfer of lower and upper form bounds -/

/-- If `kinetic ≥ c * normSq` and `a ≤ 1`, the lower enclosure transfers the explicit lower
bound `((1-a)c-b) * normSq` to the perturbed sum. -/
theorem plusForm_lowerBoundBy_of_relativeBound
    {kinetic normSq perturbation : State → ℝ} {a b c : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic c)
    (ha : a ≤ 1)
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation)
      ((1 - a) * c - b) := by
  intro x
  have hcoefficient : 0 ≤ 1 - a := sub_nonneg.mpr ha
  have hscaled :
      (1 - a) * (c * normSq x) ≤ (1 - a) * kinetic x :=
    mul_le_mul_of_nonneg_left (hkinetic x) hcoefficient
  calc
    ((1 - a) * c - b) * normSq x =
        (1 - a) * (c * normSq x) - b * normSq x := by ring
    _ ≤ (1 - a) * kinetic x - b * normSq x :=
      sub_le_sub_right hscaled (b * normSq x)
    _ ≤ plusForm kinetic perturbation x :=
      plusForm_lower_pointwise hbound x

/-- Form-smallness supplies the coefficient side condition needed by lower-bound transfer. -/
theorem plusForm_lowerBoundBy_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {a b c : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic c)
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation)
      ((1 - a) * c - b) := by
  exact plusForm_lowerBoundBy_of_relativeBound hkinetic
    (formSmall_relativeCoefficient_le_one hsmall)
    (formSmall_relativeBound hsmall)

/-- An existing kinetic lower bound and a displayed form-small certificate give an existential
lower bound for the pointwise perturbed form.  This is only the transparent existential predicate
from `AbstractFormSign`; it does not assert closedness or operator representation. -/
theorem plusForm_hasFormLowerBound_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hkinetic : HasFormLowerBound normSq kinetic)
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    HasFormLowerBound normSq (plusForm kinetic perturbation) := by
  rcases hkinetic with ⟨c, hkinetic⟩
  exact
    ⟨(1 - a) * c - b,
      plusForm_lowerBoundBy_of_formSmall hkinetic hsmall⟩

/-- For a fixed kinetic lower-bound coefficient, an existential form-small certificate exposes
coefficients `a,b` and the explicit transferred coefficient `(1-a)c-b`. -/
theorem plusForm_exists_lowerBoundCoefficient_of_hasFormSmallBound
    {kinetic normSq perturbation : State → ℝ} {c : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic c)
    (hsmall : HasFormSmallBound kinetic normSq perturbation) :
    ∃ a b : ℝ,
      FormSmall kinetic normSq perturbation a b ∧
        FormLowerBoundBy normSq (plusForm kinetic perturbation)
          ((1 - a) * c - b) := by
  rcases hsmall with ⟨a, b, hsmall⟩
  exact
    ⟨a, b, hsmall,
      plusForm_lowerBoundBy_of_formSmall hkinetic hsmall⟩

/-- A lower-bounded reference form and the existential B2 inequality regime imply an explicit
pointwise lower bound for the perturbed sum.  This remains the arithmetic conclusion only: it does
not supply the KLMN closedness or representation theorem asserted in Lemma 4.30. -/
theorem plusForm_hasFormLowerBound_of_hasFormSmallBound
    {kinetic normSq perturbation : State → ℝ}
    (hkinetic : HasFormLowerBound normSq kinetic)
    (hsmall : HasFormSmallBound kinetic normSq perturbation) :
    HasFormLowerBound normSq (plusForm kinetic perturbation) := by
  rcases hkinetic with ⟨c, hkinetic⟩
  rcases hsmall with ⟨a, b, hsmall⟩
  exact
    ⟨(1 - a) * c - b,
      plusForm_lowerBoundBy_of_formSmall hkinetic hsmall⟩

/-- If the kinetic form is pointwise nonnegative, the perturbed sum is bounded below by
`-b * normSq`.  Nonnegativity of `normSq` is not needed for this purely algebraic implication. -/
theorem plusForm_lowerBoundBy_neg_remainder_of_kinetic_nonneg
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hkinetic : ∀ x : State, 0 ≤ kinetic x)
    (ha : a ≤ 1)
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation) (-b) := by
  intro x
  have hcoefficient : 0 ≤ 1 - a := sub_nonneg.mpr ha
  have hnonneg : 0 ≤ (1 - a) * kinetic x :=
    mul_nonneg hcoefficient (hkinetic x)
  calc
    (-b) * normSq x = 0 - b * normSq x := by ring
    _ ≤ (1 - a) * kinetic x - b * normSq x :=
      sub_le_sub_right hnonneg (b * normSq x)
    _ ≤ plusForm kinetic perturbation x :=
      plusForm_lower_pointwise hbound x

/-- The nonnegative-kinetic lower bound specialized to a displayed form-small certificate. -/
theorem plusForm_lowerBoundBy_neg_remainder_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {a b : ℝ}
    (hkinetic : ∀ x : State, 0 ≤ kinetic x)
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation) (-b) := by
  exact plusForm_lowerBoundBy_neg_remainder_of_kinetic_nonneg hkinetic
    (formSmall_relativeCoefficient_le_one hsmall)
    (formSmall_relativeBound hsmall)

/-- An upper kinetic bound transfers through the upper enclosure when `1+a` is nonnegative. -/
theorem plusForm_upperBoundBy_of_relativeBound
    {kinetic normSq perturbation : State → ℝ} {a b c : ℝ}
    (hkinetic : FormUpperBoundBy normSq kinetic c)
    (ha : -1 ≤ a)
    (hbound : RelativeFormAbsBoundBy kinetic normSq perturbation a b) :
    FormUpperBoundBy normSq (plusForm kinetic perturbation)
      ((1 + a) * c + b) := by
  intro x
  have hcoefficient : 0 ≤ 1 + a := by linarith
  have hscaled :
      (1 + a) * kinetic x ≤ (1 + a) * (c * normSq x) :=
    mul_le_mul_of_nonneg_left (hkinetic x) hcoefficient
  calc
    plusForm kinetic perturbation x ≤
        (1 + a) * kinetic x + b * normSq x :=
      plusForm_upper_pointwise hbound x
    _ ≤ (1 + a) * (c * normSq x) + b * normSq x :=
      add_le_add_left hscaled (b * normSq x)
    _ = ((1 + a) * c + b) * normSq x := by ring

/-- Form-smallness also supplies the side condition for the corresponding upper-bound transfer. -/
theorem plusForm_upperBoundBy_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {a b c : ℝ}
    (hkinetic : FormUpperBoundBy normSq kinetic c)
    (hsmall : FormSmall kinetic normSq perturbation a b) :
    FormUpperBoundBy normSq (plusForm kinetic perturbation)
      ((1 + a) * c + b) := by
  have ha : -1 ≤ a :=
    le_trans (by norm_num : (-1 : ℝ) ≤ 0)
      (formSmall_relativeCoefficient_nonneg hsmall)
  exact plusForm_upperBoundBy_of_relativeBound hkinetic ha
    (formSmall_relativeBound hsmall)

/-! ## Shifted reference forms -/

/-- The kinetic form measured relative to the reference lower level `shift * normSq`. -/
def shiftedReference
    (kinetic normSq : State → ℝ) (shift : ℝ) (x : State) : ℝ :=
  kinetic x - shift * normSq x

/-- Reconstruction of the original kinetic form from its shifted reference. -/
theorem shiftedReference_add_reference
    (kinetic normSq : State → ℝ) (shift : ℝ) (x : State) :
    shiftedReference kinetic normSq shift x + shift * normSq x = kinetic x := by
  unfold shiftedReference
  ring

/-- A lower bound at `shift` is exactly the pointwise nonnegativity needed for the shifted
reference form. -/
theorem shiftedReference_nonneg_of_lowerBound
    {kinetic normSq : State → ℝ} {shift : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic shift) :
    ∀ x : State, 0 ≤ shiftedReference kinetic normSq shift x := by
  intro x
  unfold shiftedReference
  exact sub_nonneg.mpr (hkinetic x)

/-- Decomposition of the perturbed sum into its shifted-reference sum and the reference level. -/
theorem plusForm_eq_shiftedPlusForm_add_reference
    (kinetic normSq perturbation : State → ℝ) (shift : ℝ) (x : State) :
    plusForm kinetic perturbation x =
      plusForm (shiftedReference kinetic normSq shift) perturbation x +
        shift * normSq x := by
  unfold plusForm shiftedReference
  ring

/-- If the perturbation is relatively bounded by the nonnegative shifted reference, then the
original perturbed form retains the explicit lower level `(shift-b) * normSq`. -/
theorem plusForm_lowerBoundBy_shift_sub_remainder
    {kinetic normSq perturbation : State → ℝ} {shift a b : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic shift)
    (ha : a ≤ 1)
    (hbound :
      RelativeFormAbsBoundBy
        (shiftedReference kinetic normSq shift) normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation) (shift - b) := by
  have hshiftedNonneg := shiftedReference_nonneg_of_lowerBound hkinetic
  have hshiftedLower :
      FormLowerBoundBy normSq
        (plusForm (shiftedReference kinetic normSq shift) perturbation) (-b) :=
    plusForm_lowerBoundBy_neg_remainder_of_kinetic_nonneg
      hshiftedNonneg ha hbound
  intro x
  calc
    (shift - b) * normSq x =
        (-b) * normSq x + shift * normSq x := by ring
    _ ≤ plusForm (shiftedReference kinetic normSq shift) perturbation x +
          shift * normSq x :=
      add_le_add_left (hshiftedLower x) (shift * normSq x)
    _ = plusForm kinetic perturbation x := by
      exact
        (plusForm_eq_shiftedPlusForm_add_reference
          kinetic normSq perturbation shift x).symm

/-- Form-smallness relative to the shifted reference implies the shifted lower bound directly. -/
theorem plusForm_lowerBoundBy_shift_sub_remainder_of_formSmall
    {kinetic normSq perturbation : State → ℝ} {shift a b : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic shift)
    (hsmall :
      FormSmall (shiftedReference kinetic normSq shift) normSq perturbation a b) :
    FormLowerBoundBy normSq (plusForm kinetic perturbation) (shift - b) := by
  exact plusForm_lowerBoundBy_shift_sub_remainder hkinetic
    (formSmall_relativeCoefficient_le_one hsmall)
    (formSmall_relativeBound hsmall)

end QYM.FormSmallPerturbationCore




/-!
# Relative spectral intervals do not imply a uniform additive eigenvalue error

This module isolates the elementary arithmetic content of the relative-form alternative `B2`
near Theorem 4.31 of the paper.  For fixed real parameters `a` and `b`, the usual two-sided
eigenvalue enclosure has the form

`(1 - a) * reference i - b ≤ corrected i ≤ (1 + a) * reference i + b`.

When the reference family and the parameters are nonnegative, this gives the pointwise estimate

`|corrected i - reference i| ≤ a * reference i + b`.

The right-hand side still depends on the reference energy.  Therefore the assertion that this is
uniform in the spectral index merely because `a` and `b` are uniform constants is invalid when
`a > 0` and the reference spectrum is unbounded.  The family

`reference n = n`, `corrected n = (1 + a) * n`

is a completely explicit countermodel: it satisfies the same interval with `b = 0`, while its
same-index additive error is exactly `a * n` and hence has no uniform real upper bound.

This is only an arithmetic audit of the inference from a relative eigenvalue interval to a
uniform additive error.  It does not construct self-adjoint operators or forms and does not claim
the KLMN, compact-resolvent, or min--max inputs needed to derive the `B2` interval itself.
-/

namespace QYM.RelativeSpectralB2NoGo

/-! ## Relative interval and pointwise consequences -/

/-- The pointwise two-sided eigenvalue enclosure naturally produced by relative form bounds. -/
def RelativeEigenvalueInterval {ι : Type*}
    (a b : ℝ) (reference corrected : ι → ℝ) : Prop :=
  ∀ i, (1 - a) * reference i - b ≤ corrected i ∧
    corrected i ≤ (1 + a) * reference i + b

theorem relativeEigenvalueInterval_iff {ι : Type*}
    (a b : ℝ) (reference corrected : ι → ℝ) :
    RelativeEigenvalueInterval a b reference corrected ↔
      ∀ i, (1 - a) * reference i - b ≤ corrected i ∧
        corrected i ≤ (1 + a) * reference i + b :=
  Iff.rfl

/-- The interval's lower endpoint is exactly a lower bound on the signed error. -/
theorem signedError_lower_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i : ι) :
    -(a * reference i + b) ≤ corrected i - reference i := by
  have hlower := (hinterval i).1
  calc
    -(a * reference i + b) =
        (1 - a) * reference i - b - reference i := by ring
    _ ≤ corrected i - reference i := sub_le_sub_right hlower (reference i)

/-- The interval's upper endpoint is exactly an upper bound on the signed error. -/
theorem signedError_upper_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i : ι) :
    corrected i - reference i ≤ a * reference i + b := by
  have hupper := (hinterval i).2
  calc
    corrected i - reference i ≤
        ((1 + a) * reference i + b) - reference i :=
      sub_le_sub_right hupper (reference i)
    _ = a * reference i + b := by ring

/-- The relative interval alone gives the displayed pointwise absolute-error inequality. -/
theorem pointwise_error_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i : ι) :
    |corrected i - reference i| ≤ a * reference i + b := by
  exact abs_le.mpr
    ⟨signedError_lower_bound hinterval i, signedError_upper_bound hinterval i⟩

/-- For nonnegative data, the energy-dependent error radius is itself nonnegative. -/
theorem errorRadius_nonnegative {ι : Type*}
    {a b : ℝ} {reference : ι → ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hreference : ∀ i, 0 ≤ reference i) (i : ι) :
    0 ≤ a * reference i + b :=
  add_nonneg (mul_nonneg ha (hreference i)) hb

/-- The full nonnegative `B2` pointwise package: a nonnegative radius and its error bound. -/
theorem pointwise_error_package_of_nonnegative {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hreference : ∀ i, 0 ≤ reference i) (i : ι) :
    0 ≤ a * reference i + b ∧
      |corrected i - reference i| ≤ a * reference i + b :=
  ⟨errorRadius_nonnegative ha hb hreference i, pointwise_error_bound hinterval i⟩

/-- Pointwise form of the nonnegative relative-error estimate. -/
theorem pointwise_error_bound_of_nonnegative {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hreference : ∀ i, 0 ≤ reference i) (i : ι) :
    |corrected i - reference i| ≤ a * reference i + b :=
  (pointwise_error_package_of_nonnegative hinterval ha hb hreference i).2

/-! ## Energy-dependent gap error -/

/-- The gap of an indexed real family between a supplied pair of indices. -/
def indexedGap {ι : Type*} (family : ι → ℝ) (i j : ι) : ℝ :=
  family j - family i

/-- The change of a gap is the difference of the two same-index eigenvalue errors. -/
theorem gapError_eq_signedError_sub {ι : Type*}
    (reference corrected : ι → ℝ) (i j : ι) :
    indexedGap corrected i j - indexedGap reference i j =
      (corrected j - reference j) - (corrected i - reference i) := by
  simp only [indexedGap]
  ring

/-- Triangle inequality reducing a gap error to the two pointwise eigenvalue errors. -/
theorem gapError_le_pointwiseError_sum {ι : Type*}
    (reference corrected : ι → ℝ) (i j : ι) :
    |indexedGap corrected i j - indexedGap reference i j| ≤
      |corrected j - reference j| + |corrected i - reference i| := by
  rw [gapError_eq_signedError_sub]
  calc
    |(corrected j - reference j) - (corrected i - reference i)| =
        |(corrected j - reference j) + -(corrected i - reference i)| := by
      rw [sub_eq_add_neg]
    _ ≤ |corrected j - reference j| + |-(corrected i - reference i)| :=
      abs_add_le _ _
    _ = |corrected j - reference j| + |corrected i - reference i| := by
      rw [abs_neg]

/-- A relative interval controls a pairwise gap only by an energy-dependent radius. -/
theorem gap_error_bound_of_nonnegative {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hreference : ∀ i, 0 ≤ reference i)
    (i j : ι) :
    |indexedGap corrected i j - indexedGap reference i j| ≤
      a * (reference i + reference j) + 2 * b := by
  calc
    |indexedGap corrected i j - indexedGap reference i j| ≤
        |corrected j - reference j| + |corrected i - reference i| :=
      gapError_le_pointwiseError_sum reference corrected i j
    _ ≤ (a * reference j + b) + (a * reference i + b) :=
      add_le_add
        (pointwise_error_bound_of_nonnegative hinterval ha hb hreference j)
        (pointwise_error_bound_of_nonnegative hinterval ha hb hreference i)
    _ = a * (reference i + reference j) + 2 * b := by ring

/-- Specialization of the gap estimate to adjacent indices of a sequence. -/
theorem adjacent_gap_error_bound_of_nonnegative
    {a b : ℝ} {reference corrected : ℕ → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hreference : ∀ n, 0 ≤ reference n) (n : ℕ) :
    |indexedGap corrected n (n + 1) - indexedGap reference n (n + 1)| ≤
      a * (reference n + reference (n + 1)) + 2 * b :=
  gap_error_bound_of_nonnegative hinterval ha hb hreference n (n + 1)

/-! ## Explicit unbounded additive-error countermodel -/

/-- The nonnegative unbounded reference family `0, 1, 2, ...`. -/
def linearReference (n : ℕ) : ℝ :=
  n

/-- Multiplicative relative dilation of the reference family. -/
def relativeDilation (a : ℝ) (n : ℕ) : ℝ :=
  (1 + a) * n

@[simp]
theorem linearReference_apply (n : ℕ) : linearReference n = (n : ℝ) :=
  rfl

@[simp]
theorem relativeDilation_apply (a : ℝ) (n : ℕ) :
    relativeDilation a n = (1 + a) * (n : ℝ) :=
  rfl

theorem linearReference_nonnegative : ∀ n, 0 ≤ linearReference n := by
  intro n
  exact Nat.cast_nonneg n

/-- For every nonnegative fixed `a`, the explicit dilation satisfies the `B2` interval with
the fixed additive parameter `b = 0`. -/
theorem relativeDilation_satisfies_interval {a : ℝ} (ha : 0 ≤ a) :
    RelativeEigenvalueInterval a 0 linearReference (relativeDilation a) := by
  intro n
  constructor
  · have hcoefficient : 1 - a ≤ 1 + a := by linarith
    simpa [linearReference, relativeDilation] using
      (mul_le_mul_of_nonneg_right hcoefficient (Nat.cast_nonneg n))
  · simp [linearReference, relativeDilation]

/-- The signed same-index eigenvalue error is exactly `a * n`. -/
theorem relativeDilation_signedError (a : ℝ) (n : ℕ) :
    relativeDilation a n - linearReference n = a * (n : ℝ) := by
  simp only [linearReference, relativeDilation]
  ring

/-- For nonnegative `a`, the absolute same-index error is exactly `a * n`. -/
theorem relativeDilation_absoluteError {a : ℝ} (ha : 0 ≤ a) (n : ℕ) :
    |relativeDilation a n - linearReference n| = a * (n : ℝ) := by
  rw [relativeDilation_signedError]
  exact abs_of_nonneg (mul_nonneg ha (Nat.cast_nonneg n))

/-- If `a > 0`, the additive eigenvalue errors exceed every prescribed real bound. -/
theorem relativeDilation_error_arbitrarilyLarge {a : ℝ} (ha : 0 < a) :
    ∀ bound : ℝ, ∃ n : ℕ,
      bound < |relativeDilation a n - linearReference n| := by
  intro bound
  obtain ⟨n, hn⟩ := exists_nat_gt (bound / a)
  refine ⟨n, ?_⟩
  rw [relativeDilation_absoluteError (le_of_lt ha)]
  have hscaled : bound < (n : ℝ) * a := (div_lt_iff₀ ha).mp hn
  simpa [mul_comm] using hscaled

/-- Consequently there is no real constant that uniformly bounds all same-index additive
eigenvalue errors in this relative-interval model. -/
theorem relativeDilation_has_no_uniform_additiveError {a : ℝ} (ha : 0 < a) :
    ¬ ∃ ε : ℝ, ∀ n : ℕ,
      |relativeDilation a n - linearReference n| ≤ ε := by
  rintro ⟨ε, hε⟩
  obtain ⟨n, hn⟩ := relativeDilation_error_arbitrarilyLarge ha ε
  exact (not_lt_of_ge (hε n)) hn

/-- Arithmetic countermodel to the sentence that fixed uniform `a` and `b` make the resulting
additive eigenvalue errors uniform in the spectral index.  The theorem deliberately asserts only
the interval and failure of a uniform additive estimate, not any operator-theoretic `B2` premise. -/
theorem fixed_relative_parameters_do_not_imply_uniform_additiveError
    {a : ℝ} (ha : 0 < a) :
    RelativeEigenvalueInterval a 0 linearReference (relativeDilation a) ∧
      ¬ ∃ ε : ℝ, ∀ n : ℕ,
        |relativeDilation a n - linearReference n| ≤ ε :=
  ⟨relativeDilation_satisfies_interval (le_of_lt ha),
    relativeDilation_has_no_uniform_additiveError ha⟩

/-- The same countermodel remains inside the customary form-small range `0 < a < 1`; allowing
only relative coefficients below one therefore does not repair the uniform-additive inference. -/
theorem formSmall_relative_parameters_still_do_not_give_uniform_additiveError
    {a : ℝ} (ha : 0 < a) (hsmall : a < 1) :
    a < 1 ∧
      RelativeEigenvalueInterval a 0 linearReference (relativeDilation a) ∧
        ¬ ∃ ε : ℝ, ∀ n : ℕ,
          |relativeDilation a n - linearReference n| ≤ ε :=
  ⟨hsmall, fixed_relative_parameters_do_not_imply_uniform_additiveError ha⟩

/-! ## Sharp gap consequences of the two endpoint inequalities

Corollary 4.32 says that regime `B2` has a statement analogous to its bounded-potential
gap estimate, with the pair `(a,b)` entering through Theorem 4.31.  Subtracting the lower
endpoint at `j` from the upper endpoint at `i` gives the exact arithmetic correction

`gap corrected i j ≥ gap reference i j - a * (reference i + reference j) - 2 * b`.

Thus the relevant smallness condition depends on the *sum of the two reference energies*.
The declarations below require no sign assumptions on `a`, `b`, or the reference family: they
are direct consequences of the two endpoint inequalities in `RelativeEigenvalueInterval`.
-/

/-- The sharp lower gap bound obtained from the lower endpoint at `j` and upper endpoint at
`i`.  No nonnegativity hypothesis is used. -/
theorem correctedGap_lower_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι) :
    indexedGap reference i j - (a * (reference i + reference j) + 2 * b) ≤
      indexedGap corrected i j := by
  calc
    indexedGap reference i j - (a * (reference i + reference j) + 2 * b) =
        ((1 - a) * reference j - b) - ((1 + a) * reference i + b) := by
      simp only [indexedGap]
      ring
    _ ≤ corrected j - corrected i :=
      sub_le_sub (hinterval j).1 (hinterval i).2
    _ = indexedGap corrected i j := rfl

/-- The matching sharp upper gap bound, using the opposite pair of interval endpoints. -/
theorem correctedGap_upper_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι) :
    indexedGap corrected i j ≤
      indexedGap reference i j + (a * (reference i + reference j) + 2 * b) := by
  calc
    indexedGap corrected i j = corrected j - corrected i := rfl
    _ ≤ ((1 + a) * reference j + b) - ((1 - a) * reference i - b) :=
      sub_le_sub (hinterval j).2 (hinterval i).1
    _ = indexedGap reference i j +
        (a * (reference i + reference j) + 2 * b) := by
      simp only [indexedGap]
      ring

/-- The complete pairwise gap interval directly inherited from the `B2` eigenvalue interval. -/
theorem correctedGap_interval {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι) :
    indexedGap reference i j - (a * (reference i + reference j) + 2 * b) ≤
        indexedGap corrected i j ∧
      indexedGap corrected i j ≤
        indexedGap reference i j + (a * (reference i + reference j) + 2 * b) :=
  ⟨correctedGap_lower_bound hinterval i j, correctedGap_upper_bound hinterval i j⟩

/-- Absolute gap error estimate with no separate sign assumptions. -/
theorem gap_error_bound {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι) :
    |indexedGap corrected i j - indexedGap reference i j| ≤
      a * (reference i + reference j) + 2 * b := by
  calc
    |indexedGap corrected i j - indexedGap reference i j| ≤
        |corrected j - reference j| + |corrected i - reference i| :=
      gapError_le_pointwiseError_sum reference corrected i j
    _ ≤ (a * reference j + b) + (a * reference i + b) :=
      add_le_add (pointwise_error_bound hinterval j) (pointwise_error_bound hinterval i)
    _ = a * (reference i + reference j) + 2 * b := by ring

/-- Adjacent-index specialization of the sharp lower gap bound. -/
theorem adjacent_correctedGap_lower_bound
    {a b : ℝ} {reference corrected : ℕ → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (n : ℕ) :
    indexedGap reference n (n + 1) -
        (a * (reference n + reference (n + 1)) + 2 * b) ≤
      indexedGap corrected n (n + 1) :=
  correctedGap_lower_bound hinterval n (n + 1)

/-- Adjacent-index specialization of the full sharp gap interval. -/
theorem adjacent_correctedGap_interval
    {a b : ℝ} {reference corrected : ℕ → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (n : ℕ) :
    indexedGap reference n (n + 1) -
        (a * (reference n + reference (n + 1)) + 2 * b) ≤
        indexedGap corrected n (n + 1) ∧
      indexedGap corrected n (n + 1) ≤
        indexedGap reference n (n + 1) +
          (a * (reference n + reference (n + 1)) + 2 * b) :=
  correctedGap_interval hinterval n (n + 1)

/-- An explicit retained margin: if `margin + errorRadius` is below the reference gap, then
`margin` is below the corrected gap. -/
theorem margin_le_correctedGap_of_margin_add_errorRadius_le_referenceGap {ι : Type*}
    {a b margin : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι)
    (hmargin : margin + (a * (reference i + reference j) + 2 * b) ≤
      indexedGap reference i j) :
    margin ≤ indexedGap corrected i j := by
  exact le_trans (le_sub_iff_add_le.mpr hmargin)
    (correctedGap_lower_bound hinterval i j)

/-- Strict positivity of the corrected gap under the exact energy-dependent `B2` smallness
condition. -/
theorem correctedGap_pos_of_errorRadius_lt_referenceGap {ι : Type*}
    {a b : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι)
    (hsmall : a * (reference i + reference j) + 2 * b < indexedGap reference i j) :
    0 < indexedGap corrected i j := by
  exact lt_of_lt_of_le (sub_pos.mpr hsmall) (correctedGap_lower_bound hinterval i j)

/-- Version using a separately supplied positive reference-gap lower bound `δ`. -/
theorem correctedGap_pos_of_errorRadius_lt_gapLowerBound {ι : Type*}
    {a b δ : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι)
    (hgap : δ ≤ indexedGap reference i j)
    (hsmall : a * (reference i + reference j) + 2 * b < δ) :
    0 < indexedGap corrected i j :=
  correctedGap_pos_of_errorRadius_lt_referenceGap hinterval i j
    (lt_of_lt_of_le hsmall hgap)

/-- Quantitative half-gap retention.  This is the precise `B2` analogue of the paper's bounded
potential conclusion, with `a * (reference i + reference j) + 2*b` in place of a uniform
`2 ‖μ‖∞`. -/
theorem half_gapLowerBound_le_correctedGap {ι : Type*}
    {a b δ : ℝ} {reference corrected : ι → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (i j : ι)
    (hgap : δ ≤ indexedGap reference i j)
    (hsmall : a * (reference i + reference j) + 2 * b ≤ δ / 2) :
    δ / 2 ≤ indexedGap corrected i j := by
  apply margin_le_correctedGap_of_margin_add_errorRadius_le_referenceGap hinterval i j
  linarith

/-- Adjacent-index strict positivity with the explicit energy-dependent smallness condition. -/
theorem adjacent_correctedGap_pos_of_errorRadius_lt_referenceGap
    {a b : ℝ} {reference corrected : ℕ → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (n : ℕ)
    (hsmall : a * (reference n + reference (n + 1)) + 2 * b <
      indexedGap reference n (n + 1)) :
    0 < indexedGap corrected n (n + 1) :=
  correctedGap_pos_of_errorRadius_lt_referenceGap hinterval n (n + 1) hsmall

/-- Adjacent-index half-gap retention from a reference lower gap `δ`. -/
theorem adjacent_half_gapLowerBound_le_correctedGap
    {a b δ : ℝ} {reference corrected : ℕ → ℝ}
    (hinterval : RelativeEigenvalueInterval a b reference corrected) (n : ℕ)
    (hgap : δ ≤ indexedGap reference n (n + 1))
    (hsmall : a * (reference n + reference (n + 1)) + 2 * b ≤ δ / 2) :
    δ / 2 ≤ indexedGap corrected n (n + 1) :=
  half_gapLowerBound_le_correctedGap hinterval n (n + 1) hgap hsmall

/-! ## Exact dilation formulas and an adjacent-gap countermodel

For the already defined linear spectrum, a relative dilation changes a pairwise gap by
`a * (j - i)`.  Its adjacent gaps happen to be constant, so an unbounded *adjacent*-gap error
is witnessed below by the equally elementary quadratic spectrum `n ↦ n²`.  This distinction is
kept explicit: no growth conclusion is inferred merely from the upper bound.
-/

/-- Exact pairwise gap of the linear reference family. -/
theorem linearReference_gap (i j : ℕ) :
    indexedGap linearReference i j = (j : ℝ) - (i : ℝ) :=
  rfl

/-- Exact pairwise gap after relative dilation of the linear reference family. -/
theorem relativeDilation_gap (a : ℝ) (i j : ℕ) :
    indexedGap (relativeDilation a) i j =
      (1 + a) * ((j : ℝ) - (i : ℝ)) := by
  simp only [indexedGap, relativeDilation]
  ring

/-- Exact signed perturbation of every pairwise gap in the linear dilation model. -/
theorem relativeDilation_gapError (a : ℝ) (i j : ℕ) :
    indexedGap (relativeDilation a) i j - indexedGap linearReference i j =
      a * ((j : ℝ) - (i : ℝ)) := by
  rw [relativeDilation_gap, linearReference_gap]
  ring

@[simp]
theorem linearReference_adjacentGap (n : ℕ) :
    indexedGap linearReference n (n + 1) = 1 := by
  rw [linearReference_gap]
  simp only [Nat.cast_add, Nat.cast_one]
  ring

@[simp]
theorem relativeDilation_adjacentGap (a : ℝ) (n : ℕ) :
    indexedGap (relativeDilation a) n (n + 1) = 1 + a := by
  rw [relativeDilation_gap]
  simp only [Nat.cast_add, Nat.cast_one]
  ring

@[simp]
theorem relativeDilation_adjacentGapError (a : ℝ) (n : ℕ) :
    indexedGap (relativeDilation a) n (n + 1) -
      indexedGap linearReference n (n + 1) = a := by
  rw [relativeDilation_gapError]
  simp only [Nat.cast_add, Nat.cast_one]
  ring

/-- Quadratically growing nonnegative reference energies. -/
def quadraticReference (n : ℕ) : ℝ :=
  (n : ℝ) ^ 2

/-- Fixed relative dilation of the quadratic reference family. -/
def quadraticRelativeDilation (a : ℝ) (n : ℕ) : ℝ :=
  (1 + a) * quadraticReference n

@[simp]
theorem quadraticReference_apply (n : ℕ) :
    quadraticReference n = (n : ℝ) ^ 2 :=
  rfl

@[simp]
theorem quadraticRelativeDilation_apply (a : ℝ) (n : ℕ) :
    quadraticRelativeDilation a n = (1 + a) * (n : ℝ) ^ 2 :=
  rfl

theorem quadraticReference_nonnegative : ∀ n, 0 ≤ quadraticReference n := by
  intro n
  exact sq_nonneg (n : ℝ)

/-- The quadratic dilation satisfies the same fixed-parameter relative interval with `b = 0`. -/
theorem quadraticRelativeDilation_satisfies_interval {a : ℝ} (ha : 0 ≤ a) :
    RelativeEigenvalueInterval a 0 quadraticReference (quadraticRelativeDilation a) := by
  intro n
  constructor
  · have hcoefficient : 1 - a ≤ 1 + a := by linarith
    simpa [quadraticRelativeDilation] using
      (mul_le_mul_of_nonneg_right hcoefficient (quadraticReference_nonnegative n))
  · simp [quadraticRelativeDilation]

/-- Exact adjacent reference gap for the quadratic spectrum. -/
theorem quadraticReference_adjacentGap (n : ℕ) :
    indexedGap quadraticReference n (n + 1) = 2 * (n : ℝ) + 1 := by
  simp only [indexedGap, quadraticReference, Nat.cast_add, Nat.cast_one]
  ring

/-- Relative dilation scales every quadratic pairwise gap by the same factor. -/
theorem quadraticRelativeDilation_gap (a : ℝ) (i j : ℕ) :
    indexedGap (quadraticRelativeDilation a) i j =
      (1 + a) * indexedGap quadraticReference i j := by
  simp only [indexedGap, quadraticRelativeDilation]
  ring

/-- Exact adjacent gap after dilation of the quadratic spectrum. -/
theorem quadraticRelativeDilation_adjacentGap (a : ℝ) (n : ℕ) :
    indexedGap (quadraticRelativeDilation a) n (n + 1) =
      (1 + a) * (2 * (n : ℝ) + 1) := by
  rw [quadraticRelativeDilation_gap, quadraticReference_adjacentGap]

/-- The signed adjacent-gap perturbation is exactly `a * (2*n + 1)`. -/
theorem quadraticRelativeDilation_adjacentGapError (a : ℝ) (n : ℕ) :
    indexedGap (quadraticRelativeDilation a) n (n + 1) -
        indexedGap quadraticReference n (n + 1) =
      a * (2 * (n : ℝ) + 1) := by
  rw [quadraticRelativeDilation_adjacentGap, quadraticReference_adjacentGap]
  ring

/-- For nonnegative relative coefficient, the absolute adjacent-gap perturbation has the same
exact energy-dependent formula. -/
theorem quadraticRelativeDilation_absoluteAdjacentGapError
    {a : ℝ} (ha : 0 ≤ a) (n : ℕ) :
    |indexedGap (quadraticRelativeDilation a) n (n + 1) -
        indexedGap quadraticReference n (n + 1)| =
      a * (2 * (n : ℝ) + 1) := by
  rw [quadraticRelativeDilation_adjacentGapError]
  exact abs_of_nonneg (mul_nonneg ha (by positivity))

/-- For every fixed `a > 0`, adjacent-gap perturbations in the quadratic dilation model exceed
every real bound. -/
theorem quadraticRelativeDilation_adjacentGapError_arbitrarilyLarge
    {a : ℝ} (ha : 0 < a) :
    ∀ bound : ℝ, ∃ n : ℕ,
      bound < |indexedGap (quadraticRelativeDilation a) n (n + 1) -
        indexedGap quadraticReference n (n + 1)| := by
  intro bound
  obtain ⟨n, hn⟩ := relativeDilation_error_arbitrarilyLarge ha bound
  rw [relativeDilation_absoluteError (le_of_lt ha)] at hn
  refine ⟨n, ?_⟩
  rw [quadraticRelativeDilation_absoluteAdjacentGapError (le_of_lt ha)]
  have hindex : (n : ℝ) ≤ 2 * (n : ℝ) + 1 := by
    linarith [(Nat.cast_nonneg n : 0 ≤ (n : ℝ))]
  exact lt_of_lt_of_le hn (mul_le_mul_of_nonneg_left hindex (le_of_lt ha))

/-- Hence fixed `B2` parameters do not yield a uniform adjacent-gap error on an unbounded
quadratic spectrum. -/
theorem quadraticRelativeDilation_has_no_uniform_adjacentGapError
    {a : ℝ} (ha : 0 < a) :
    ¬ ∃ ε : ℝ, ∀ n : ℕ,
      |indexedGap (quadraticRelativeDilation a) n (n + 1) -
        indexedGap quadraticReference n (n + 1)| ≤ ε := by
  rintro ⟨ε, hε⟩
  obtain ⟨n, hn⟩ :=
    quadraticRelativeDilation_adjacentGapError_arbitrarilyLarge ha ε
  exact (not_lt_of_ge (hε n)) hn

/-- A concrete fixed-parameter `B2` interval whose adjacent-gap errors have no uniform additive
bound.  This isolates the missing energy restriction in an unqualified reading of the word
"analogous" in Corollary 4.32. -/
theorem fixed_relative_parameters_do_not_imply_uniform_adjacentGapError
    {a : ℝ} (ha : 0 < a) :
    RelativeEigenvalueInterval a 0 quadraticReference (quadraticRelativeDilation a) ∧
      ¬ ∃ ε : ℝ, ∀ n : ℕ,
        |indexedGap (quadraticRelativeDilation a) n (n + 1) -
          indexedGap quadraticReference n (n + 1)| ≤ ε :=
  ⟨quadraticRelativeDilation_satisfies_interval (le_of_lt ha),
    quadraticRelativeDilation_has_no_uniform_adjacentGapError ha⟩

/-- The adjacent-gap countermodel also lies in the standard form-small range `0 < a < 1`. -/
theorem formSmall_relative_parameters_still_do_not_give_uniform_adjacentGapError
    {a : ℝ} (ha : 0 < a) (hsmall : a < 1) :
    a < 1 ∧
      RelativeEigenvalueInterval a 0 quadraticReference (quadraticRelativeDilation a) ∧
        ¬ ∃ ε : ℝ, ∀ n : ℕ,
          |indexedGap (quadraticRelativeDilation a) n (n + 1) -
            indexedGap quadraticReference n (n + 1)| ≤ ε :=
  ⟨hsmall, fixed_relative_parameters_do_not_imply_uniform_adjacentGapError ha⟩


end QYM.RelativeSpectralB2NoGo




/-!
# The unconditional liminf core of an asymptotic spectral-gap argument

This file isolates the order-theoretic implication used in Corollary 4.25 of the paper.  It does
not construct a Hamiltonian, its eigenvalues, or the truncated gaps.  The input is the exact
uniform-positive-lower-bound property that the corollary needs.

There are two mathematically distinct codomains:

* for `ℝ≥0∞`, the target is a complete linear order, so a uniform positive lower bound alone is
  enough to prove positivity of the `liminf`;
* for `ℝ`, Mathlib's conditionally-complete-order `liminf` needs a coboundedness witness.  We derive
  that witness from an explicit uniform upper bound.  This extra hypothesis is not smuggled into a
  structure field: it is displayed in every real-valued theorem that uses it.

Consequently, the extended-nonnegative result is the clean unconditional order-theoretic core,
whereas the real-valued result is the corresponding bounded-gap specialization.
-/

namespace QYM.AsymptoticGapLiminf

open Filter

/-! ## Explicit lower- and upper-bound predicates -/

/-- A family has the displayed uniform lower bound. -/
def UniformLowerBound {ι : Type*} {α : Type*} [LE α]
    (gap : ι → α) (δ : α) : Prop :=
  ∀ i, δ ≤ gap i

/-- A real family is uniformly bounded above by the displayed number. -/
def UniformUpperBound {ι : Type*} (gap : ι → ℝ) (B : ℝ) : Prop :=
  ∀ i, gap i ≤ B

theorem uniformLowerBound_iff {ι : Type*} {α : Type*} [LE α]
    (gap : ι → α) (δ : α) :
    UniformLowerBound gap δ ↔ ∀ i, δ ≤ gap i :=
  Iff.rfl

theorem uniformUpperBound_iff {ι : Type*} (gap : ι → ℝ) (B : ℝ) :
    UniformUpperBound gap B ↔ ∀ i, gap i ≤ B :=
  Iff.rfl

/-- A pointwise lower bound is eventually valid along every filter. -/
theorem eventually_of_uniformLowerBound {ι : Type*} {α : Type*} [LE α]
    {gap : ι → α} {δ : α} (hgap : UniformLowerBound gap δ)
    (f : Filter ι) :
    ∀ᶠ i in f, δ ≤ gap i :=
  Eventually.of_forall hgap

/-! ## Complete-order version for extended nonnegative gaps -/

/-- A uniform lower bound passes to the `ℝ≥0∞` liminf. -/
theorem ennreal_lowerBound_le_liminf
    {gap : ℕ → ℝ≥0∞} {δ : ℝ≥0∞}
    (hgap : UniformLowerBound gap δ) :
    δ ≤ liminf gap atTop :=
  le_liminf_of_le (by isBoundedDefault) (Eventually.of_forall hgap)

/-- A strictly positive uniform lower bound gives a strictly positive `ℝ≥0∞` liminf. -/
theorem ennreal_liminf_pos
    {gap : ℕ → ℝ≥0∞} {δ : ℝ≥0∞}
    (hδ : 0 < δ) (hgap : UniformLowerBound gap δ) :
    0 < liminf gap atTop :=
  hδ.trans_le (ennreal_lowerBound_le_liminf hgap)

/-- It is enough to exhibit any positive lower-bound witness. -/
theorem ennreal_liminf_pos_of_exists_uniformLowerBound
    {gap : ℕ → ℝ≥0∞}
    (hgap : ∃ δ : ℝ≥0∞, 0 < δ ∧ UniformLowerBound gap δ) :
    0 < liminf gap atTop := by
  rcases hgap with ⟨δ, hδ, hlower⟩
  exact ennreal_liminf_pos hδ hlower

/-! ## Eventual and displayed-tail lower bounds -/

/-- An eventual lower bound passes to the `ℝ≥0∞` liminf.  This is the order-theoretic form
needed when a truncation hypothesis is stated only for all `Y ≥ Y0`. -/
theorem ennreal_lowerBound_le_liminf_of_eventually
    {gap : ℕ → ℝ≥0∞} {δ : ℝ≥0∞}
    (hgap : ∀ᶠ Y in atTop, δ ≤ gap Y) :
    δ ≤ liminf gap atTop :=
  le_liminf_of_le (by isBoundedDefault) hgap

/-- A lower bound displayed on the tail beginning at `Y0` is an eventual lower bound. -/
theorem eventually_lowerBound_of_forall_ge
    {gap : ℕ → ℝ≥0∞} {δ : ℝ≥0∞} (Y0 : ℕ)
    (hgap : ∀ Y, Y0 ≤ Y → δ ≤ gap Y) :
    ∀ᶠ Y in atTop, δ ≤ gap Y :=
  eventually_atTop.2 ⟨Y0, hgap⟩

/-- A strictly positive lower bound on a displayed truncation tail gives a positive liminf. -/
theorem ennreal_liminf_pos_of_forall_ge
    {gap : ℕ → ℝ≥0∞} {δ : ℝ≥0∞} (Y0 : ℕ)
    (hδ : 0 < δ)
    (hgap : ∀ Y, Y0 ≤ Y → δ ≤ gap Y) :
    0 < liminf gap atTop :=
  hδ.trans_le
    (ennreal_lowerBound_le_liminf_of_eventually
      (eventually_lowerBound_of_forall_ge Y0 hgap))

/-! ## Conditionally-complete real version -/

/-- A displayed uniform upper bound supplies the coboundedness input needed by real `liminf`. -/
theorem real_isCoboundedUnder_ge
    {gap : ℕ → ℝ} {B : ℝ}
    (hupper : UniformUpperBound gap B) :
    atTop.IsCoboundedUnder (· ≥ ·) gap :=
  isCoboundedUnder_ge_of_le atTop hupper

/-- A uniform real lower bound passes to `liminf` once a real upper bound is supplied. -/
theorem real_lowerBound_le_liminf
    {gap : ℕ → ℝ} {δ B : ℝ}
    (hlower : UniformLowerBound gap δ)
    (hupper : UniformUpperBound gap B) :
    δ ≤ liminf gap atTop :=
  le_liminf_of_le (real_isCoboundedUnder_ge hupper)
    (Eventually.of_forall hlower)

/-- The bounded real specialization of the uniform-positive-gap implication. -/
theorem real_liminf_pos
    {gap : ℕ → ℝ} {δ B : ℝ}
    (hδ : 0 < δ)
    (hlower : UniformLowerBound gap δ)
    (hupper : UniformUpperBound gap B) :
    0 < liminf gap atTop :=
  hδ.trans_le (real_lowerBound_le_liminf hlower hupper)

/-- Existential packaging of the bounded real specialization. -/
theorem real_liminf_pos_of_exists_bounds
    {gap : ℕ → ℝ}
    (hbounds : ∃ δ B : ℝ,
      0 < δ ∧ UniformLowerBound gap δ ∧ UniformUpperBound gap B) :
    0 < liminf gap atTop := by
  rcases hbounds with ⟨δ, B, hδ, hlower, hupper⟩
  exact real_liminf_pos hδ hlower hupper

/-! ## Connecting an abstract coercivity product to the gap family -/

/-- The lower-bound product appearing in Hypothesis 4.24. -/
def CoercivityProduct (alpha radial : ℕ → ℝ≥0∞) (Y : ℕ) : ℝ≥0∞ :=
  alpha Y * radial Y

/-- A pointwise Proposition-4.23-style estimate transfers a uniform product bound to the gaps. -/
theorem gap_uniformLowerBound_of_coercivityProduct
    {gap alpha radial : ℕ → ℝ≥0∞} {δ : ℝ≥0∞}
    (hproduct : UniformLowerBound (CoercivityProduct alpha radial) δ)
    (hgap : ∀ Y, CoercivityProduct alpha radial Y ≤ gap Y) :
    UniformLowerBound gap δ := by
  intro Y
  exact (hproduct Y).trans (hgap Y)

/-- The exact complete-order implication from a positive uniform coercivity-product bound and a
pointwise gap estimate to positivity of the asymptotic lower limit. -/
theorem ennreal_liminf_gap_pos_of_coercivityProduct
    {gap alpha radial : ℕ → ℝ≥0∞} {δ : ℝ≥0∞}
    (hδ : 0 < δ)
    (hproduct : UniformLowerBound (CoercivityProduct alpha radial) δ)
    (hgap : ∀ Y, CoercivityProduct alpha radial Y ≤ gap Y) :
    0 < liminf gap atTop :=
  ennreal_liminf_pos hδ
    (gap_uniformLowerBound_of_coercivityProduct hproduct hgap)

/-- Tail-exact version matching Hypothesis 4.24: a positive lower bound for the coercivity
product only for `Y ≥ Y0`, together with the pointwise Proposition-4.23-style comparison on the
same tail, is enough for positivity of the asymptotic liminf. -/
theorem ennreal_liminf_gap_pos_of_coercivityProduct_forall_ge
    {gap alpha radial : ℕ → ℝ≥0∞} {δ : ℝ≥0∞} (Y0 : ℕ)
    (hδ : 0 < δ)
    (hproduct : ∀ Y, Y0 ≤ Y → δ ≤ CoercivityProduct alpha radial Y)
    (hgap : ∀ Y, Y0 ≤ Y → CoercivityProduct alpha radial Y ≤ gap Y) :
    0 < liminf gap atTop := by
  apply ennreal_liminf_pos_of_forall_ge Y0 hδ
  intro Y hY
  exact (hproduct Y hY).trans (hgap Y hY)

/-! ## Necessity of a genuinely positive lower-bound witness -/

/-- The constant-zero family has zero liminf. -/
theorem liminf_const_zero_ennreal :
    liminf (fun _ : ℕ => (0 : ℝ≥0∞)) atTop = 0 := by
  simp

/-- Nonnegativity by itself cannot imply a positive asymptotic gap. -/
theorem nonnegative_gap_alone_not_sufficient :
    (∀ Y : ℕ, (0 : ℝ≥0∞) ≤ (fun _ : ℕ => (0 : ℝ≥0∞)) Y) ∧
      ¬ 0 < liminf (fun _ : ℕ => (0 : ℝ≥0∞)) atTop := by
  constructor
  · intro Y
    exact bot_le
  · simp

end QYM.AsymptoticGapLiminf





noncomputable section

open scoped UpperHalfPlane

/-!
# Paper-normalized statements with explicit fidelity boundaries

This layer is intentionally narrower than a proof that every assertion in the PDF is true.  It
exposes at least one closed, fidelity-bounded `Prop` statement for every one of the 58 manually
inventoried rows: literal/algebraic normalizations, conditional supplier implications, or closed
countermodel audits.

The six values of `StatementFidelity` are part of the interface:

* `literalOnConcreteCarrier` keeps the literal PDF quantifiers/formula after replacing the
  unavailable bundle of fields by one displayed concrete carrier.
* `algebraicNormalization` is the exact algebraic or logical core of a source statement, but does
  not claim that the paper's analytic objects have been constructed.
* `arithmeticNormalization` exactly settles a scalar/coordinate formula occurring in the PDF.
* `finiteSurrogate` is deliberately not a PDF-exact statement.  It proves or refutes only the
  displayed finite/DGA/Finsupp model.
* `conditionalSupplier` proves an implication after every missing analytic supplier has been made
  an explicit hypothesis; it does not construct that supplier.
* `countermodelAudit` certifies a failure or corrected replacement and therefore cannot be used as
  evidence that the corresponding original assertion is true.

No analytic conclusion is stored as a structure field or assumed in order to prove itself.  This
initial normalization block does not construct the modular quotient or Sobolev gauge slice.
Later continuation namespaces construct abstract Friedrichs realizations and compact resolvents
from displayed form hypotheses, but they still do not instantiate the paper's concrete qYM data
or a continuum spectral enumeration.
-/

namespace QYM.FullCertification.PaperNormalized

open QYM.FullCertification.Registry

abbrev Matrix2 := Matrix (Fin 2) (Fin 2) ℂ

/-- Machine-readable distinction between literal normalization and surrogate evidence. -/
inductive StatementFidelity where
  | literalOnConcreteCarrier
  | algebraicNormalization
  | arithmeticNormalization
  | finiteSurrogate
  | conditionalSupplier
  | countermodelAudit
  deriving DecidableEq, Repr

/-- Every manually inventoried row has at least one fidelity-bounded normalized statement,
conditional supplier theorem, or closed countermodel in this integrated source.  Equality with
the exact PDF prose, and discharge of the external analytic suppliers, remain separate questions. -/
def coveredClaims : List ClaimId := allClaims

theorem coveredClaims_length : coveredClaims.length = 58 := by
  exact allClaims_length

theorem coveredClaims_nodup : coveredClaims.Nodup := by
  exact allClaims_nodup

/-- Fidelity classification for the normalized audit statements.  `conditionalSupplier` exposes
an implication whose analytic premise is not constructed here; `countermodelAudit` records a
closed failure/correction package and must not be read as a proof of the original claim. -/
def fidelity : ClaimId → Option StatementFidelity
  | .def2_1 | .axiom2_3 => some .literalOnConcreteCarrier
  | .prop2_2 | .prop2_3 | .lemma3_3 | .prop3_4 | .def3_1
  | .def4_1 | .prop4_1 | .def4_2 | .theorem4_9
  | .def4_8 =>
      some .algebraicNormalization
  | .cor4_25 | .cor4_32 =>
      some .arithmeticNormalization
  | .def2_2 | .prop3_1 | .lemma4_2 | .theorem4_4
  | .def4_5 | .def4_6 | .def4_7 | .cor4_28 | .lemma4_29
  | .theorem4_31 | .cor4_33 | .defA_1 =>
      some .finiteSurrogate
  | .axiomA3M | .axiomA3V | .axiomA3R | .axiomA3T
  | .assumption3_5 | .assumption3_6 | .assumption3_8 | .axiom4_4
  | .assumption4_8 | .lemma4_13 | .lemma4_16 | .hyp4_20
  | .hyp4_22 | .hyp4_24 | .theorem4_26 | .prop4_27
  | .lemma4_30 | .hypA_4 | .hypA_6 =>
      some .conditionalSupplier
  | .lemma3_2 | .def4_3 | .theorem4_3 | .theorem4_5 | .cor4_7
  | .prop4_14 | .prop4_15 | .lemma4_17 | .lemma4_18
  | .prop4_23 | .lemmaA_1 | .lemmaA_2 | .theoremA_7 =>
      some .countermodelAudit

/-- The machine-readable fidelity table covers exactly the explicit `coveredClaims` list. -/
theorem fidelity_ne_none_iff_mem_coveredClaims (claim : ClaimId) :
    fidelity claim ≠ none ↔ claim ∈ coveredClaims := by
  cases claim <;> decide

/-- Totality of the fidelity boundary over the 58-row manual inventory.  This is statement-level
audit coverage, not a theorem that all original PDF assertions are true. -/
theorem exists_fidelity (claim : ClaimId) :
    ∃ level : StatementFidelity, fidelity claim = some level := by
  cases claim <;> simp [fidelity]

/-! ## Definition 2.1: literal matrix-carrier formula -/

/-- Equation (2.4), literally normalized on `2 × 2` complex matrices.  This does not assert
closure in a Lie subalgebra or provide the paper's sheaf of differential forms. -/
def def2_1_matrixStatement : Prop :=
  ∀ (q : ℂ) (A B : Matrix2),
    QYM.qbr q A B = A * B - q • (B * A)

theorem def2_1_matrixStatement_holds : def2_1_matrixStatement := by
  intro q A B
  rfl

/-! ## Definition 2.2: constant two-dimensional DGA surrogate -/

/-- Equation (2.6) on the already constructed constant two-dimensional DGA.  This is a finite
constant-form surrogate, not the curvature of a connection on `Γ(2) \ ℍ`. -/
def def2_2_constantCurvatureStatement : Prop :=
  ∀ A : QYM.ConstantTwoDimensionalDGA.Form1 Matrix2,
    QYM.ConstantTwoDimensionalDGA.curvature A =
      QYM.ConstantTwoDimensionalDGA.d1 A +
        QYM.ConstantTwoDimensionalDGA.wedge11 A A

theorem def2_2_constantCurvatureStatement_holds :
    def2_2_constantCurvatureStatement := by
  intro A
  rfl

/-! ## Proposition 2.3: the two algebraic covariance cores -/

/-- The standard affine-curvature calculation, with `dg` and `dA` supplied as concrete matrix
data.  The differential expansion is explicit in `QYM.AffineGauge`; no analytic gauge action is
postulated here. -/
def prop2_3_affineCurvatureStatement : Prop :=
  ∀ (g : Matrix2ˣ) (dg A dA : Matrix2),
    QYM.AffineGauge.standardCurvature
        (QYM.AffineGauge.affineGaugeDifferential g dg A dA)
        (QYM.AffineGauge.affineGauge g dg A) =
      QYM.gconj g (QYM.AffineGauge.standardCurvature dA A)

theorem prop2_3_affineCurvatureStatement_holds :
    prop2_3_affineCurvatureStatement := by
  intro g dg A dA
  exact QYM.AffineGauge.standardCurvature_affine_eq_gconj g dg A dA

/-- Equation (2.9), literally on the matrix coefficient algebra for homogeneous conjugation. -/
def prop2_3_homogeneousBracketStatement : Prop :=
  ∀ (q : ℂ) (g : Matrix2ˣ) (A B : Matrix2),
    QYM.qbr q (QYM.gconj g A) (QYM.gconj g B) =
      QYM.gconj g (QYM.qbr q A B)

theorem prop2_3_homogeneousBracketStatement_holds :
    prop2_3_homogeneousBracketStatement := by
  intro q g A B
  exact (QYM.qbr_gconj q g A B).symm

/-! ## Axiom 2.3: literal weakness and a nontrivial corrected finite witness -/

/-- Literal matrix-carrier reading of Axiom 2.3.  The PDF does not state that `Tr_q` is nonzero,
faithful, or positive, so this literal existential is satisfied by the zero linear map. -/
def axiom2_3_literalMatrixStatement : Prop :=
  ∃ Tr : Matrix2 →ₗ[ℂ] ℂ, ∃ sigma : Matrix2 ≃ₐ[ℂ] Matrix2,
    ∀ X Y : Matrix2, Tr (X * Y) = Tr (sigma Y * X)

theorem axiom2_3_literalMatrixStatement_holds :
    axiom2_3_literalMatrixStatement := by
  refine ⟨0, AlgEquiv.refl, ?_⟩
  intro X Y
  rfl

/-- The special rule `sigma(Y) = qY` advertised immediately after Axiom 2.3 cannot be a unital
complex-algebra automorphism at the upper-half-plane q-parameter, already on the scalar algebra. -/
def Axiom2_3ScalarTwistExists (tau : ℍ) : Prop :=
  ∃ sigma : ℂ ≃ₐ[ℂ] ℂ,
    ∀ X : ℂ, sigma X = QYM.AlgebraNoGo.upperHalfPlaneQ tau • X

theorem axiom2_3_scalarTwistStatement_refuted (tau : ℍ) :
    ¬ Axiom2_3ScalarTwistExists tau :=
  QYM.AlgebraNoGo.upperHalfPlaneQ_not_scalar_algEquiv tau

/-- A stronger corrected finite statement: the weighted trace is nonzero, its inner modular twist
is nontrivial, and twisted cyclicity holds.  It is not the PDF's special scalar rule
`sigma(Y) = qY`. -/
def axiom2_3_nontrivialInnerMatrixStatement : Prop :=
  ∃ rho : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2ˣ,
    QYM.WeightedTraceCore.weightedTrace rho
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e00 ≠ 0 ∧
      QYM.WeightedTraceCore.modularTwist rho
          QYM.WeightedTraceCore.SkewAdjointCounterexample.e01 ≠
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e01 ∧
      ∀ X Y : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
        QYM.WeightedTraceCore.weightedTrace rho (X * Y) =
          QYM.WeightedTraceCore.weightedTrace rho
            (QYM.WeightedTraceCore.modularTwist rho Y * X)

theorem axiom2_3_nontrivialInnerMatrixStatement_holds :
    axiom2_3_nontrivialInnerMatrixStatement := by
  refine ⟨
    QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity,
    QYM.WeightedTraceCore.SkewAdjointCounterexample.weightedTrace_e00_ne_zero,
    QYM.WeightedTraceCore.SkewAdjointCounterexample.modularTwist_e01_ne_e01,
    ?_⟩
  intro X Y
  exact QYM.WeightedTraceCore.weightedTrace_twisted_cyclic
    QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity X Y

/-! ## Lemma 3.2: affine-bracket claim refuted at the paper's modular parameter -/

/-- The source's affine covariance equation specialized to its simplest scalar data, with
`q = exp (2 * pi * I * tau)` represented by `upperHalfPlaneQ tau` exactly as in the paper. -/
def lemma3_2_affineBracketStatement (tau : ℍ) : Prop :=
  QYM.qbr (QYM.AlgebraNoGo.upperHalfPlaneQ tau)
      (QYM.AffineGauge.affineGauge (1 : ℂˣ) 1 0)
      (QYM.AffineGauge.affineGauge (1 : ℂˣ) 1 0) =
    QYM.gconj (1 : ℂˣ)
      (QYM.qbr (QYM.AlgebraNoGo.upperHalfPlaneQ tau) 0 0)

theorem lemma3_2_affineBracketStatement_refuted (tau : ℍ) :
    ¬ lemma3_2_affineBracketStatement tau := by
  simpa only [lemma3_2_affineBracketStatement] using
    QYM.AffineGauge.qbr_not_affine_covariant_complex
      (QYM.AlgebraNoGo.upperHalfPlaneQ_ne_one tau)

/-! ## Proposition 3.4: exact algebraic invariance-of-sum core -/

def InvariantUnder {State : Type*} (gauge : State → State) (block : State → ℝ) : Prop :=
  ∀ A, block (gauge A) = block A

def fullSplitDensity {State : Type*}
    (lead mass data tail : State → ℝ) (A : State) : ℝ :=
  lead A + mass A + data A + tail A

/-- Exact logical core of the pointwise-density part of Proposition 3.4.  It does not manufacture
the component invariance hypotheses or define the integral action. -/
def prop3_4_splitDensityStatement : Prop :=
  ∀ (State : Type) (gauge : State → State)
      (lead mass data tail : State → ℝ),
    InvariantUnder gauge lead →
    InvariantUnder gauge mass →
    InvariantUnder gauge data →
    InvariantUnder gauge tail →
    InvariantUnder gauge (fullSplitDensity lead mass data tail)

theorem prop3_4_splitDensityStatement_holds :
    prop3_4_splitDensityStatement := by
  intro State gauge lead mass data tail hlead hmass hdata htail
  unfold InvariantUnder at hlead hmass hdata htail ⊢
  intro A
  simp only [fullSplitDensity]
  rw [hlead A, hmass A, hdata A, htail A]

/-! ## Definition 4.2: exact logical weak-critical schema -/

/-- The logical content of “the first variation vanishes against every admissible variation”. -/
def WeakCritical {State Variation : Type*}
    (firstVariation : State → Variation → ℝ) (state : State) : Prop :=
  ∀ variation, firstVariation state variation = 0

def def4_2_weakCriticalStatement : Prop :=
  ∀ (State Variation : Type) (firstVariation : State → Variation → ℝ) (state : State),
    WeakCritical firstVariation state ↔
      ∀ variation : Variation, firstVariation state variation = 0

theorem def4_2_weakCriticalStatement_holds :
    def4_2_weakCriticalStatement := by
  intro State Variation firstVariation state
  rfl

/-! ## Definition 4.3: finite strict-transition surrogate -/

/-- Finite one-overlap normalization of Definition 4.3.  In this Boolean model, the transition
map is the identity, so the strict transition condition is exactly equality of the two overlap
restrictions.  This does not construct the paper's open cover or its `H¹` section spaces. -/
def def4_3_finiteStrictTransitionStatement : Prop :=
  ∀ (s0 : QYM.FullCertification.NoGo.FiniteCover.LocalSection0)
      (s1 : QYM.FullCertification.NoGo.FiniteCover.LocalSection1),
    QYM.FullCertification.NoGo.FiniteCover.SatisfiesStrictTransition s0 s1 ↔
      QYM.FullCertification.NoGo.FiniteCover.OverlapCompatible s0 s1

theorem def4_3_finiteStrictTransitionStatement_holds :
    def4_3_finiteStrictTransitionStatement := by
  intro s0 s1
  exact QYM.FullCertification.NoGo.FiniteCover.strictTransition_iff_overlapCompatible s0 s1

/-! ## Separate arithmetic obstruction for the explanatory `|q| = 1` interface -/

/-- The upper-half-plane q-coordinate never reaches the unit interface mentioned after
Definition 4.3.  This is an independent arithmetic obstruction, not Definition 4.3 itself. -/

def qUnitInterfaceStatement : Prop :=
  ∃ tau : ℍ, ‖QYM.FullCertification.NoGo.qCoordinate tau‖ = 1

theorem qUnitInterfaceStatement_refuted :
    ¬ qUnitInterfaceStatement := by
  rintro ⟨tau, htau⟩
  exact QYM.FullCertification.NoGo.qCoordinate_ne_unit tau htau

/-- The same coordinate also has no point in the proposed outside chart. -/
def qOutsidePointStatement : Prop :=
  ∃ tau : ℍ, 1 < ‖QYM.FullCertification.NoGo.qCoordinate tau‖

theorem qOutsidePointStatement_refuted :
    ¬ qOutsidePointStatement := by
  rintro ⟨tau, htau⟩
  exact (not_lt_of_ge
    (QYM.FullCertification.NoGo.qCoordinate_norm_lt_one tau).le) htau

/-! ## Lemma 4.2: finite strict-gluing surrogate -/

def lemma4_2_finiteStrictGluingStatement : Prop :=
  ∀ (s0 : QYM.FullCertification.NoGo.FiniteCover.LocalSection0)
      (s1 : QYM.FullCertification.NoGo.FiniteCover.LocalSection1),
    QYM.FullCertification.NoGo.FiniteCover.OverlapCompatible s0 s1 →
      ∃! s : QYM.FullCertification.NoGo.FiniteCover.GlobalSection,
        QYM.FullCertification.NoGo.FiniteCover.restrictGlobal0 s = s0 ∧
          QYM.FullCertification.NoGo.FiniteCover.restrictGlobal1 s = s1

theorem lemma4_2_finiteStrictGluingStatement_holds :
    lemma4_2_finiteStrictGluingStatement := by
  intro s0 s1 hcompat
  exact QYM.FullCertification.NoGo.FiniteCover.existsUnique_glue s0 s1 hcompat

/-! ## Theorem 4.3: finite local-minimum/gluing countermodel -/

/-- Full conjunction certified by the existing finite cover countermodel.  This is not a
countermodel to an analytic theorem that additionally assumes exact additive localization of the
global functional. -/
def theorem4_3_finiteCountermodelStatement : Prop :=
  QYM.FullCertification.NoGo.FiniteCover.IsLocalMinimizer0
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal0 ∧
    QYM.FullCertification.NoGo.FiniteCover.IsLocalMinimizer1
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal1 ∧
    QYM.FullCertification.NoGo.FiniteCover.OverlapCompatible
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal0
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal1 ∧
    QYM.FullCertification.NoGo.FiniteCover.SatisfiesStrictTransition
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal0
      QYM.FullCertification.NoGo.FiniteCover.chosenLocal1 ∧
    (∃! s : QYM.FullCertification.NoGo.FiniteCover.GlobalSection,
      QYM.FullCertification.NoGo.FiniteCover.restrictGlobal0 s =
          QYM.FullCertification.NoGo.FiniteCover.chosenLocal0 ∧
        QYM.FullCertification.NoGo.FiniteCover.restrictGlobal1 s =
          QYM.FullCertification.NoGo.FiniteCover.chosenLocal1) ∧
    ¬ QYM.FullCertification.NoGo.FiniteCover.IsGlobalMinimizer
      QYM.FullCertification.NoGo.FiniteCover.chosenGlue

theorem theorem4_3_finiteCountermodelStatement_holds :
    theorem4_3_finiteCountermodelStatement := by
  simpa only [theorem4_3_finiteCountermodelStatement] using
    QYM.FullCertification.NoGo.FiniteCover.finiteCover_localMinimizers_glue_not_global

/-! ## Theorem 4.5: separate the false skew identity from true repeated-input cancellation -/

def theorem4_5_finiteSkewStatement : Prop :=
  QYM.WeightedTraceCore.weightedPairing
      QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
      (QYM.WeightedTraceCore.twistedCommutator
        QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e01
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e10)
      QYM.WeightedTraceCore.SkewAdjointCounterexample.e00 =
    -QYM.WeightedTraceCore.weightedPairing
      QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
      QYM.WeightedTraceCore.SkewAdjointCounterexample.e10
      (QYM.WeightedTraceCore.twistedCommutator
        QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e01
        QYM.WeightedTraceCore.SkewAdjointCounterexample.e00)

theorem theorem4_5_finiteSkewStatement_refuted :
    ¬ theorem4_5_finiteSkewStatement := by
  simpa only [theorem4_5_finiteSkewStatement] using
    QYM.WeightedTraceCore.SkewAdjointCounterexample.theorem_4_5_skew_identity_fails

/-- The same finite countermodel records the positive density and twisted-cyclicity hypotheses
next to the failed skew identity.  The analytic Hodge/integration layer remains outside scope. -/
def theorem4_5_finiteCountermodelStatement : Prop :=
  ((QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity :
      QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2)).PosDef ∧
    (∀ X Y : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
      QYM.WeightedTraceCore.weightedTrace
          QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity (X * Y) =
        QYM.WeightedTraceCore.weightedTrace
          QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
          (QYM.WeightedTraceCore.modularTwist
            QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity Y * X)) ∧
    ¬ theorem4_5_finiteSkewStatement

theorem theorem4_5_finiteCountermodelStatement_holds :
    theorem4_5_finiteCountermodelStatement := by
  refine ⟨
    QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity_posDef,
    ?_, theorem4_5_finiteSkewStatement_refuted⟩
  intro X Y
  exact QYM.WeightedTraceCore.weightedTrace_twisted_cyclic
    QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity X Y

def theorem4_5_finiteCancellationStatement : Prop :=
  ∀ U V : QYM.WeightedTraceCore.SkewAdjointCounterexample.Mat2,
    QYM.WeightedTraceCore.weightedPairing
        QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity
        (QYM.WeightedTraceCore.twistedCommutator
          QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity U V) V = 0

theorem theorem4_5_finiteCancellationStatement_holds :
    theorem4_5_finiteCancellationStatement := by
  intro U V
  exact QYM.WeightedTraceCore.twistedCommutator_pair_second_zero
    QYM.WeightedTraceCore.SkewAdjointCounterexample.positiveDiagonalDensity U V

/-! ## Proposition 4.14: Finsupp sign obstruction and corrected sign -/

def prop4_14_finsuppWrongSignStatement : Prop :=
  QYM.FinsuppDiagonalQuadraticForm.HasFormLowerBound
    (QYM.FinsuppDiagonalQuadraticForm.wrongSignEnergy (fun _ => 0))

theorem prop4_14_finsuppWrongSignStatement_refuted :
    ¬ prop4_14_finsuppWrongSignStatement := by
  apply
    QYM.FinsuppDiagonalQuadraticForm.wrongSignEnergy_not_hasFormLowerBound_of_potential_boundedAbove
      (fun _ => 0) 0
  intro n
  exact le_rfl

def prop4_14_finsuppCorrectedSignStatement : Prop :=
  QYM.FinsuppDiagonalQuadraticForm.HasFormLowerBound
    (QYM.FinsuppDiagonalQuadraticForm.correctedEnergy (fun _ => 0))

theorem prop4_14_finsuppCorrectedSignStatement_holds :
    prop4_14_finsuppCorrectedSignStatement := by
  apply
    QYM.FinsuppDiagonalQuadraticForm.correctedEnergy_hasFormLowerBound_of_potential_boundedBelow
      (fun _ => 0) 0
  intro n
  exact le_rfl

/-! ## Unnumbered quarter-threshold spectral-parameter convention -/

/-- Arithmetic predicate for the unnumbered convention `lambda = 1/4 + t²` immediately before
Definition 4.6.  It is not the paper's Definition 4.7. -/
def HasNonnegativeRealSpectralParameter (lambda : ℝ) : Prop :=
  ∃ t : ℝ, 0 ≤ t ∧ lambda = (1 / 4 : ℝ) + t ^ 2

def realSpectralParameterConventionStatement : Prop :=
  ∀ lambda : ℝ,
    HasNonnegativeRealSpectralParameter lambda ↔ (1 / 4 : ℝ) ≤ lambda

theorem realSpectralParameterConventionStatement_holds :
    realSpectralParameterConventionStatement := by
  intro lambda
  constructor
  · rintro ⟨t, _ht, hlambda⟩
    exact QYM.FullCertification.NoGo.quarter_le_of_eq_quarter_add_sq hlambda
  · intro hlambda
    exact
      QYM.FullCertification.Corrected.SpectralParameter.exists_real_parameter_above_quarter
        hlambda

/-- Correct two-chart arithmetic replacement for the paper's unrestricted real-`t` convention. -/
def correctedTwoChartStatement : Prop :=
  ∀ lambda : ℝ,
    HasNonnegativeRealSpectralParameter lambda ∨
      ∃ kappa : ℝ, 0 ≤ kappa ∧ lambda = (1 / 4 : ℝ) - kappa ^ 2

theorem correctedTwoChartStatement_holds :
    correctedTwoChartStatement :=
  QYM.FullCertification.Corrected.SpectralParameter.real_parameter_chart_split

/-! ## Definition 4.7: finite smoothed-counting surrogate -/

/-- Finite replacement for the smoothed counting functional
`N_Φ(T;q) = ∑_{j≥1} Φ_T(t_j(q))` from Definition 4.7.  The first argument represents the fixed
test function `Φ_T`, and the second the finite indexed family `t_j(q)`. -/
def finiteSmoothedCountingFunctional {n : ℕ}
    (testFunction : ℝ → ℝ) (spectralParameters : Fin n → ℝ) : ℝ :=
  Finset.univ.sum fun j => testFunction (spectralParameters j)

/-- Definitional equation for the finite smoothed count.  This does not supply the paper's
infinite spectrum, convergence, admissible test family, or uniform Weyl estimate. -/
def def4_7_finiteSmoothedCountingStatement : Prop :=
  ∀ {n : ℕ} (testFunction : ℝ → ℝ) (spectralParameters : Fin n → ℝ),
    finiteSmoothedCountingFunctional testFunction spectralParameters =
      Finset.univ.sum fun j => testFunction (spectralParameters j)

theorem def4_7_finiteSmoothedCountingStatement_holds :
    def4_7_finiteSmoothedCountingStatement := by
  intro n testFunction spectralParameters
  rfl

/-! ## Theorem 4.31: finite two-level B1 eigenvalue-error statement -/

def theorem4_31_finiteEigenvalueErrorStatement : Prop :=
  ∀ (delta0 delta1 epsilon : ℝ),
    |delta0| ≤ epsilon →
    |delta1| ≤ epsilon →
      |QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedGroundLevel delta0 -
          QYM.FiniteHamiltonian.groundEigenvalue| ≤ epsilon ∧
        |QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedExcitedLevel delta1 -
          QYM.FiniteHamiltonian.excitedEigenvalue| ≤ epsilon

theorem theorem4_31_finiteEigenvalueErrorStatement_holds :
    theorem4_31_finiteEigenvalueErrorStatement := by
  intro delta0 delta1 epsilon hdelta0 hdelta1
  constructor
  · simpa [QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedGroundLevel] using hdelta0
  · simpa [QYM.FiniteHamiltonian.DiagonalPerturbation.perturbedExcitedLevel] using hdelta1

/-! ## Corollary 4.33: finite indexed-spectrum window stability -/

def cor4_33_finiteWindowStatement : Prop :=
  ∀ {n : ℕ} (reference perturbed : Fin n → ℝ) (center eta epsilon : ℝ),
    (∀ i, |perturbed i - reference i| ≤ epsilon) →
      (QYM.SpectralWindowStability.windowIndices perturbed center eta).card ≤
        (QYM.SpectralWindowStability.windowIndices
          reference center (eta + epsilon)).card ∧
      (QYM.SpectralWindowStability.windowIndices reference center eta).card ≤
        (QYM.SpectralWindowStability.windowIndices
          perturbed center (eta + epsilon)).card

theorem cor4_33_finiteWindowStatement_holds :
    cor4_33_finiteWindowStatement := by
  intro n reference perturbed center eta epsilon herror
  constructor
  · exact
      QYM.SpectralWindowStability.perturbed_window_card_le_expanded_reference_window_card
        reference perturbed center eta epsilon herror
  · apply
      QYM.SpectralWindowStability.perturbed_window_card_le_expanded_reference_window_card
        perturbed reference center eta epsilon
    intro i
    simpa only [abs_sub_comm] using herror i

end QYM.FullCertification.PaperNormalized


/-!
# Paper-normalized continuation for Definition 4.8, Corollary 4.25, Lemma 4.30,
# and Theorem 4.31(B2)

These declarations are designed to be inserted into
`QYM.FullCertification.PaperNormalized`.  Every statement displays its carrier and hypotheses.
The form-theoretic results are pointwise algebraic normalizations: they do not assert KLMN,
closedness, self-adjointness, compact resolvent, or min--max.  The `liminf` result uses `ℝ≥0∞` so
that no hidden real coboundedness assumption is required.  The B2 no-go addresses only the paper's
claimed uniform *additive* eigenvalue error, not the two-sided relative interval itself.
-/

namespace QYM.FullCertification.PaperNormalized

open Filter

/-! ## Definition 4.8(B2): transparent form-small normalization -/

/-- Exact unfolding of the B2 pointwise form-small predicate on an abstract carrier. -/
def def4_8_formSmallStatement : Prop :=
  ∀ (State : Type) (reference normSq correction : State → ℝ) (a b : ℝ),
    QYM.FormSmallPerturbationCore.FormSmall reference normSq correction a b ↔
      0 ≤ a ∧ a < 1 ∧ 0 ≤ b ∧
        ∀ u : State,
          |correction u| ≤ a * reference u + b * normSq u

theorem def4_8_formSmallStatement_holds :
    def4_8_formSmallStatement := by
  intro State reference normSq correction a b
  rfl

/-- Existential coefficient form of the B2 regime, matching the quantifier shape of Definition
4.8 after the analytic multiplication-operator and form-domain data have been abstracted to three
real-valued functions on one displayed carrier. -/
def def4_8_hasFormSmallBoundStatement : Prop :=
  ∀ (State : Type) (reference normSq correction : State → ℝ),
    QYM.FormSmallPerturbationCore.HasFormSmallBound reference normSq correction ↔
      ∃ a b : ℝ,
        0 ≤ a ∧ a < 1 ∧ 0 ≤ b ∧
          ∀ u : State,
            |correction u| ≤ a * reference u + b * normSq u

theorem def4_8_hasFormSmallBoundStatement_holds :
    def4_8_hasFormSmallBoundStatement := by
  intro State reference normSq correction
  rfl

/-! ## Lemma 4.30(B2): lower-bound arithmetic, separated from KLMN -/

/-- If the reference form has the displayed lower bound and the correction is form-small, the
pointwise form sum has the explicit transferred lower bound.  This is the lower-bound arithmetic
inside Lemma 4.30, not its closedness or representation-theorem conclusion. -/
def lemma4_30_lowerBoundCoreStatement : Prop :=
  ∀ (State : Type) (reference normSq correction : State → ℝ) (a b c : ℝ),
    QYM.AbstractFormSign.FormLowerBoundBy normSq reference c →
    QYM.FormSmallPerturbationCore.FormSmall reference normSq correction a b →
      QYM.AbstractFormSign.FormLowerBoundBy normSq
        (QYM.AbstractFormSign.plusForm reference correction)
        ((1 - a) * c - b)

theorem lemma4_30_lowerBoundCoreStatement_holds :
    lemma4_30_lowerBoundCoreStatement := by
  intro State reference normSq correction a b c hlower hsmall
  exact
    QYM.FormSmallPerturbationCore.plusForm_lowerBoundBy_of_formSmall
      hlower hsmall

/-- Existential-coefficient version of the same lower-boundedness core. -/
def lemma4_30_existentialLowerBoundCoreStatement : Prop :=
  ∀ (State : Type) (reference normSq correction : State → ℝ),
    QYM.AbstractFormSign.HasFormLowerBound normSq reference →
    QYM.FormSmallPerturbationCore.HasFormSmallBound reference normSq correction →
      QYM.AbstractFormSign.HasFormLowerBound normSq
        (QYM.AbstractFormSign.plusForm reference correction)

theorem lemma4_30_existentialLowerBoundCoreStatement_holds :
    lemma4_30_existentialLowerBoundCoreStatement := by
  intro State reference normSq correction hlower hsmall
  exact
    QYM.FormSmallPerturbationCore.plusForm_hasFormLowerBound_of_hasFormSmallBound
      hlower hsmall

/-! ## Corollary 4.25: complete-order truncation-tail liminf core -/

/-- Complete-order normalization of the inference “a uniformly positive gap lower bound on the
truncation tail implies a positive asymptotic liminf”.  The threshold `Y0`, the tail product bound,
and the Proposition-4.23-style comparison on that same tail are all explicit hypotheses. -/
def cor4_25_ennrealLiminfStatement : Prop :=
  ∀ (gap alpha radial : ℕ → ℝ≥0∞) (Y0 : ℕ) (δ : ℝ≥0∞),
    0 < δ →
    (∀ Y, Y0 ≤ Y →
      δ ≤ QYM.AsymptoticGapLiminf.CoercivityProduct alpha radial Y) →
    (∀ Y, Y0 ≤ Y →
      QYM.AsymptoticGapLiminf.CoercivityProduct alpha radial Y ≤ gap Y) →
      0 < liminf gap atTop

theorem cor4_25_ennrealLiminfStatement_holds :
    cor4_25_ennrealLiminfStatement := by
  intro gap alpha radial Y0 δ hδ hproduct hgap
  exact
    QYM.AsymptoticGapLiminf.ennreal_liminf_gap_pos_of_coercivityProduct_forall_ge
      Y0 hδ hproduct hgap

/-! ## Theorem 4.31(B2): exact interval arithmetic and the uniform-error obstruction -/

/-- The exact same-index absolute-error consequence of the B2 relative interval.  Its right-hand
side depends on the reference energy and is therefore pointwise, not uniformly additive in the
spectral index. -/
def theorem4_31_B2PointwiseStatement : Prop :=
  ∀ (Index : Type) (a b : ℝ) (reference corrected : Index → ℝ),
    QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
      a b reference corrected →
      ∀ i : Index,
        |corrected i - reference i| ≤ a * reference i + b

theorem theorem4_31_B2PointwiseStatement_holds :
    theorem4_31_B2PointwiseStatement := by
  intro Index a b reference corrected hinterval i
  exact QYM.RelativeSpectralB2NoGo.pointwise_error_bound hinterval i

/-- Formal version of the invalid inference that fixed `a,b` in the B2 interval force a single
additive error bound, specialized to the explicit unbounded reference spectrum used by the
countermodel. -/
def theorem4_31_B2UniformInferenceStatement : Prop :=
  ∀ a : ℝ,
    0 < a → a < 1 →
    QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
      a 0 QYM.RelativeSpectralB2NoGo.linearReference
        (QYM.RelativeSpectralB2NoGo.relativeDilation a) →
      ∃ ε : ℝ, ∀ n : ℕ,
        |QYM.RelativeSpectralB2NoGo.relativeDilation a n -
          QYM.RelativeSpectralB2NoGo.linearReference n| ≤ ε

/-- The B2 “uniform once `a,b` are uniform” sentence is false as a uniform-additive inference:
already `a = 1/2`, `b = 0`, and reference levels `n` satisfy the interval while the additive
errors are `n/2`. -/
theorem theorem4_31_B2UniformInferenceStatement_refuted :
    ¬ theorem4_31_B2UniformInferenceStatement := by
  intro hinference
  have hinterval :
      QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
        (1 / 2 : ℝ) 0 QYM.RelativeSpectralB2NoGo.linearReference
          (QYM.RelativeSpectralB2NoGo.relativeDilation (1 / 2 : ℝ)) :=
    QYM.RelativeSpectralB2NoGo.relativeDilation_satisfies_interval (by norm_num)
  have huniform :=
    hinference (1 / 2 : ℝ) (by norm_num) (by norm_num) hinterval
  exact
    QYM.RelativeSpectralB2NoGo.relativeDilation_has_no_uniform_additiveError
      (by norm_num : (0 : ℝ) < 1 / 2) huniform

/-- Positive existential packaging of the same countermodel. -/
def theorem4_31_B2UniformCountermodelStatement : Prop :=
  ∃ a : ℝ,
    0 < a ∧ a < 1 ∧
      QYM.RelativeSpectralB2NoGo.RelativeEigenvalueInterval
        a 0 QYM.RelativeSpectralB2NoGo.linearReference
          (QYM.RelativeSpectralB2NoGo.relativeDilation a) ∧
      ¬ ∃ ε : ℝ, ∀ n : ℕ,
        |QYM.RelativeSpectralB2NoGo.relativeDilation a n -
          QYM.RelativeSpectralB2NoGo.linearReference n| ≤ ε

theorem theorem4_31_B2UniformCountermodelStatement_holds :
    theorem4_31_B2UniformCountermodelStatement := by
  refine ⟨(1 / 2 : ℝ), by norm_num, by norm_num, ?_, ?_⟩
  · exact
      QYM.RelativeSpectralB2NoGo.relativeDilation_satisfies_interval
        (by norm_num)
  · exact
      QYM.RelativeSpectralB2NoGo.relativeDilation_has_no_uniform_additiveError
        (by norm_num)

end QYM.FullCertification.PaperNormalized




