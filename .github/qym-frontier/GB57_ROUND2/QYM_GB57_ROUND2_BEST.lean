namespace QYM.FullCertification.P2ClassicalTraceBoundaryExtension

open Mock2FA.PaperCorrections.AutomorphicSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators
open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhaseGraphCompletion
open QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension

noncomputable local instance actualFixedPhaseCanonicalCompletion_complete_inst
    (n : ℤ) (Y : ℝ) :
    CompleteSpace (ActualFixedPhaseCuspTraceCompletion n Y) :=
  actualFixedPhaseCuspTraceCompletionCompleteSpace n Y

noncomputable local instance actualFixedPhaseCanonicalCompletion_inner_inst
    (n : ℤ) (Y : ℝ) :
    InnerProductSpace ℂ (ActualFixedPhaseCuspTraceCompletion n Y) :=
  actualFixedPhaseCuspTraceCompletionInnerProductSpace n Y

/-!
# The exact trace-comparison boundary

Mathlib currently supplies neither a fractional Sobolev space on the boundary
of the concrete quotient truncation nor a classical theorem

`H^1(X_Y) -> H^(1/2)(boundary X_Y)`.

Consequently this file does not introduce a type and call it `H^(1/2)`.
Instead it closes the strongest comparison that follows from the already
constructed objects.  The target below is exactly the stored three-cusp
parameter space `L2([0,2], dx)^3` from
`P2ActualFixedPhaseCuspTraceGraphExtension`; it is not asserted to be a
topological quotient boundary.

The missing analytic input is isolated as one transparent proposition: the
actual smooth-core restriction must be bounded in the pre-existing graph
norm.  We prove that this proposition is equivalent to existence and
uniqueness of a continuous extension, and also equivalent to the enhanced
completion having the same underlying Banach space as the old graph
completion via its bulk projection.  Thus no comparison certificate is
hidden in a structure field.
-/

/-! ## 1. The exact core estimate -/

/-- The concrete stored three-cusp restriction is bounded in the already
constructed base/raising/lowering graph norm.  This is the exact estimate
which a classical trace theorem would have to imply before it could act on
`GraphSobolevCompletion n`. -/
def ActualFixedPhaseStoredTraceBounded (n : ℤ) (Y : ℝ) : Prop :=
  ∃ C : ℝ, ∀ u : InverseEtaFixedPhaseCore n,
    ‖actualFixedPhaseThreeCuspTraceToL2Linear n Y u‖ ≤
      C * ‖coreMap n u‖

/-- A continuous map has the required stored-trace values on the literal
smooth fixed-phase core. -/
def ExtendsActualFixedPhaseStoredTrace
    (n : ℤ) (Y : ℝ)
    (T : GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2) : Prop :=
  ∀ u : InverseEtaFixedPhaseCore n,
    T (coreMap n u) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u

/-! ## 2. Canonical extension from the exact estimate -/

/-- Mathlib's dense linear extension applied to the actual core map and the
actual three-cusp stored restriction.  Without the core bound its internal
fallback is not advertised as a trace; every theorem identifying its core
values below explicitly assumes `ActualFixedPhaseStoredTraceBounded`. -/
noncomputable def actualFixedPhaseStoredTraceExtension
    (n : ℤ) (Y : ℝ) :
    GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2 := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  exact (actualFixedPhaseThreeCuspTraceToL2Linear n Y).extendOfNorm (coreMap n)

@[simp]
theorem actualFixedPhaseStoredTraceExtension_core
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseStoredTraceExtension n Y (coreMap n u) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  rcases hBound with ⟨C, hC⟩
  exact LinearMap.extendOfNorm_eq (denseRange_coreMap n) ⟨C, hC⟩ u

/-- The same core constant controls the extended stored coordinate on the
whole graph completion. -/
theorem actualFixedPhaseStoredTraceExtension_norm_le
    (n : ℤ) (Y : ℝ) (C : ℝ)
    (hC : ∀ u : InverseEtaFixedPhaseCore n,
      ‖actualFixedPhaseThreeCuspTraceToL2Linear n Y u‖ ≤
        C * ‖coreMap n u‖)
    (x : GraphSobolevCompletion n) :
    ‖actualFixedPhaseStoredTraceExtension n Y x‖ ≤ C * ‖x‖ := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  exact LinearMap.norm_extendOfNorm_apply_le
    (denseRange_coreMap n) C hC x

/-- Existence of a genuine continuous stored-coordinate extension is exactly
the core graph-norm estimate; neither direction uses a boundary manifold or a
fractional Sobolev API. -/
theorem actualFixedPhaseStoredTraceBounded_iff_exists_extension
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseStoredTraceBounded n Y ↔
      ∃ T : GraphSobolevCompletion n →L[ℂ]
          ActualFixedPhaseThreeCuspBoundaryL2,
        ExtendsActualFixedPhaseStoredTrace n Y T := by
  constructor
  · intro hBound
    exact ⟨actualFixedPhaseStoredTraceExtension n Y,
      actualFixedPhaseStoredTraceExtension_core n Y hBound⟩
  · rintro ⟨T, hT⟩
    refine ⟨‖T‖, fun u => ?_⟩
    rw [← hT u]
    exact T.le_opNorm (coreMap n u)

/-- Under the exact bound, the dense extension is the unique continuous map
with the prescribed literal smooth-core values. -/
theorem actualFixedPhaseStoredTraceExtension_unique
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (T : GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2)
    (hT : ExtendsActualFixedPhaseStoredTrace n Y T) :
    actualFixedPhaseStoredTraceExtension n Y = T := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  rcases hBound with ⟨C, hC⟩
  have hComp : T.toLinearMap.comp (coreMap n) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y := by
    ext u
    exact hT u
  exact LinearMap.extendOfNorm_unique
    (denseRange_coreMap n) C hC T hComp

/-- Typed no-go: if the concrete core estimate fails, no continuous map from
the existing graph completion can extend even the stored `L2([0,2])^3`
restriction.  A fortiori the current source cannot obtain such an extension
merely by renaming this target `H^(1/2)`. -/
theorem no_continuous_actualFixedPhaseStoredTraceExtension
    (n : ℤ) (Y : ℝ)
    (hNotBounded : ¬ ActualFixedPhaseStoredTraceBounded n Y) :
    ¬ ∃ T : GraphSobolevCompletion n →L[ℂ]
        ActualFixedPhaseThreeCuspBoundaryL2,
      ExtendsActualFixedPhaseStoredTrace n Y T := by
  exact fun hExists => hNotBounded
    ((actualFixedPhaseStoredTraceBounded_iff_exists_extension n Y).2 hExists)

/-! ## 3. The enhanced completion is the graph of the extension -/

/-- Continuous graph map of the canonical stored-trace extension into the
same `L2` product ambient used to define the enhanced completion. -/
noncomputable def actualFixedPhaseStoredTraceAmbientGraph
    (n : ℤ) (Y : ℝ) :
    GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseCuspTraceAmbient n :=
  (WithLp.prodContinuousLinearEquiv 2 ℂ
      (GraphSobolevCompletion n)
      ActualFixedPhaseThreeCuspBoundaryL2).symm.toContinuousLinearMap.comp
    ((ContinuousLinearMap.id ℂ (GraphSobolevCompletion n)).prod
      (actualFixedPhaseStoredTraceExtension n Y))

@[simp]
theorem actualFixedPhaseStoredTraceAmbientGraph_fst
    (n : ℤ) (Y : ℝ) (x : GraphSobolevCompletion n) :
    (actualFixedPhaseStoredTraceAmbientGraph n Y x).fst = x := by
  rfl

@[simp]
theorem actualFixedPhaseStoredTraceAmbientGraph_snd
    (n : ℤ) (Y : ℝ) (x : GraphSobolevCompletion n) :
    (actualFixedPhaseStoredTraceAmbientGraph n Y x).snd =
      actualFixedPhaseStoredTraceExtension n Y x := by
  rfl

theorem actualFixedPhaseStoredTraceAmbientGraph_core
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseStoredTraceAmbientGraph n Y (coreMap n u) =
      actualFixedPhaseCuspTraceGraphMap n Y u := by
  apply WithLp.ofLp_injective
  apply Prod.ext
  · rfl
  · exact actualFixedPhaseStoredTraceExtension_core n Y hBound u

/-- Every point of the continuous extension graph belongs to the closure of
the literal smooth bulk-plus-stored-coordinate graph. -/
theorem actualFixedPhaseStoredTraceAmbientGraph_mem_completion
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : GraphSobolevCompletion n) :
    actualFixedPhaseStoredTraceAmbientGraph n Y x ∈
      (actualFixedPhaseCuspTraceGraphRange n Y).topologicalClosure := by
  refine (denseRange_coreMap n).induction_on x ?_ ?_
  · exact (actualFixedPhaseCuspTraceCompletion_isClosed n Y).preimage
      (actualFixedPhaseStoredTraceAmbientGraph n Y).continuous
  · intro u
    rw [actualFixedPhaseStoredTraceAmbientGraph_core n Y hBound u]
    exact actualFixedPhaseCuspTraceGraphRange_le_completion n Y
      (LinearMap.mem_range_self
        (actualFixedPhaseCuspTraceGraphMap n Y) u)

/-- A point of the old graph completion, paired with its extended stored
coordinate, as an element of the enhanced completion. -/
noncomputable def actualFixedPhaseStoredTraceGraphPoint
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : GraphSobolevCompletion n) :
    ActualFixedPhaseCuspTraceCompletion n Y :=
  ⟨actualFixedPhaseStoredTraceAmbientGraph n Y x,
    actualFixedPhaseStoredTraceAmbientGraph_mem_completion n Y hBound x⟩

@[simp]
theorem actualFixedPhaseCuspTraceBulkProjection_graphPoint
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : GraphSobolevCompletion n) :
    actualFixedPhaseCuspTraceBulkProjection n Y
        (actualFixedPhaseStoredTraceGraphPoint n Y hBound x) = x := by
  rfl

@[simp]
theorem actualFixedPhaseCuspTraceBoundaryProjection_graphPoint
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : GraphSobolevCompletion n) :
    actualFixedPhaseCuspTraceBoundaryProjection n Y
        (actualFixedPhaseStoredTraceGraphPoint n Y hBound x) =
      actualFixedPhaseStoredTraceExtension n Y x := by
  rfl

/-- On the full enhanced completion, the stored coordinate is forced to equal
the continuous extension evaluated on the bulk coordinate. -/
theorem actualFixedPhaseCuspTraceBoundary_eq_extension_bulk
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    actualFixedPhaseCuspTraceBoundaryProjection n Y x =
      actualFixedPhaseStoredTraceExtension n Y
        (actualFixedPhaseCuspTraceBulkProjection n Y x) := by
  refine (actualFixedPhaseCuspTraceCoreMap_denseRange n Y).induction_on x ?_ ?_
  · exact isClosed_eq
      (actualFixedPhaseCuspTraceBoundaryProjection n Y).continuous
      ((actualFixedPhaseStoredTraceExtension n Y).comp
        (actualFixedPhaseCuspTraceBulkProjection n Y)).continuous
  · intro u
    rw [actualFixedPhaseCuspTraceBoundaryProjection_core,
      actualFixedPhaseCuspTraceBulkProjection_core,
      actualFixedPhaseStoredTraceExtension_core n Y hBound]

/-! ## 4. Exact equivalence of the two completions -/

theorem actualFixedPhaseCuspTraceBulkProjection_injective
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y) :
    Function.Injective (actualFixedPhaseCuspTraceBulkProjection n Y) := by
  intro x y hBulk
  have hBoundary :
      actualFixedPhaseCuspTraceBoundaryProjection n Y x =
        actualFixedPhaseCuspTraceBoundaryProjection n Y y := by
    rw [actualFixedPhaseCuspTraceBoundary_eq_extension_bulk n Y hBound,
      actualFixedPhaseCuspTraceBoundary_eq_extension_bulk n Y hBound,
      hBulk]
  change (x : ActualFixedPhaseCuspTraceAmbient n).fst =
      (y : ActualFixedPhaseCuspTraceAmbient n).fst at hBulk
  change (x : ActualFixedPhaseCuspTraceAmbient n).snd =
      (y : ActualFixedPhaseCuspTraceAmbient n).snd at hBoundary
  apply Subtype.ext
  apply WithLp.ofLp_injective
  exact Prod.ext hBulk hBoundary

theorem actualFixedPhaseCuspTraceBulkProjection_surjective
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y) :
    Function.Surjective (actualFixedPhaseCuspTraceBulkProjection n Y) := by
  intro x
  exact ⟨actualFixedPhaseStoredTraceGraphPoint n Y hBound x, rfl⟩

theorem actualFixedPhaseCuspTraceBulkProjection_bijective
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y) :
    Function.Bijective (actualFixedPhaseCuspTraceBulkProjection n Y) :=
  ⟨actualFixedPhaseCuspTraceBulkProjection_injective n Y hBound,
    actualFixedPhaseCuspTraceBulkProjection_surjective n Y hBound⟩

/-- Under the exact trace estimate, the enhanced graph closure and the old
base/raising/lowering graph completion are continuously linearly equivalent;
the forward map is literally the bulk projection. -/
noncomputable def actualFixedPhaseCuspTraceBulkEquiv
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y) :
    ActualFixedPhaseCuspTraceCompletion n Y ≃L[ℂ]
      GraphSobolevCompletion n :=
  ContinuousLinearEquiv.ofBijective
    (actualFixedPhaseCuspTraceBulkProjection n Y)
    (LinearMap.ker_eq_bot.mpr
      (actualFixedPhaseCuspTraceBulkProjection_injective n Y hBound))
    (LinearMap.range_eq_top.mpr
      (actualFixedPhaseCuspTraceBulkProjection_surjective n Y hBound))

@[simp]
theorem actualFixedPhaseCuspTraceBulkEquiv_apply
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    actualFixedPhaseCuspTraceBulkEquiv n Y hBound x =
      actualFixedPhaseCuspTraceBulkProjection n Y x := by
  rfl

@[simp]
theorem actualFixedPhaseCuspTraceBulkEquiv_core
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseCuspTraceBulkEquiv n Y hBound
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      coreMap n u := by
  rw [actualFixedPhaseCuspTraceBulkEquiv_apply,
    actualFixedPhaseCuspTraceBulkProjection_core]

/-- Conversely, bijectivity of the actual bulk projection produces a
continuous stored-coordinate extension by composing the stored projection
with the Banach inverse. -/
theorem actualFixedPhaseStoredTraceBounded_of_bulkProjection_bijective
    (n : ℤ) (Y : ℝ)
    (hBij : Function.Bijective
      (actualFixedPhaseCuspTraceBulkProjection n Y)) :
    ActualFixedPhaseStoredTraceBounded n Y := by
  have hKer : (actualFixedPhaseCuspTraceBulkProjection n Y).ker = ⊥ :=
    LinearMap.ker_eq_bot.mpr hBij.1
  have hRange : (actualFixedPhaseCuspTraceBulkProjection n Y).range = ⊤ :=
    LinearMap.range_eq_top.mpr hBij.2
  let e : ActualFixedPhaseCuspTraceCompletion n Y ≃L[ℂ]
      GraphSobolevCompletion n :=
    ContinuousLinearEquiv.ofBijective
      (actualFixedPhaseCuspTraceBulkProjection n Y) hKer hRange
  let T : GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2 :=
    (actualFixedPhaseCuspTraceBoundaryProjection n Y).comp
      e.symm.toContinuousLinearMap
  apply (actualFixedPhaseStoredTraceBounded_iff_exists_extension n Y).2
  refine ⟨T, ?_⟩
  intro u
  have hInv : e.symm (coreMap n u) =
      actualFixedPhaseCuspTraceCoreMap n Y u := by
    apply e.injective
    rw [e.apply_symm_apply]
    change coreMap n u =
      actualFixedPhaseCuspTraceBulkProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u)
    exact (actualFixedPhaseCuspTraceBulkProjection_core n Y u).symm
  change actualFixedPhaseCuspTraceBoundaryProjection n Y
      (e.symm (coreMap n u)) =
        actualFixedPhaseThreeCuspTraceToL2Linear n Y u
  rw [hInv, actualFixedPhaseCuspTraceBoundaryProjection_core]

/-- This is the exact norm-equivalence frontier: the two completion carriers
are the same Banach object through the bulk projection if and only if the
literal stored cusp restriction is graph-norm bounded on the actual smooth
core. -/
theorem actualFixedPhaseStoredTraceBounded_iff_bulkProjection_bijective
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseStoredTraceBounded n Y ↔
      Function.Bijective
        (actualFixedPhaseCuspTraceBulkProjection n Y) := by
  constructor
  · exact actualFixedPhaseCuspTraceBulkProjection_bijective n Y
  · exact actualFixedPhaseStoredTraceBounded_of_bulkProjection_bijective n Y

/-- Second typed no-go formulation: failure of the smooth core estimate
forces failure of the bulk comparison map to be an equivalence. -/
theorem not_bulkProjection_bijective_of_not_storedTraceBounded
    (n : ℤ) (Y : ℝ)
    (hNotBounded : ¬ ActualFixedPhaseStoredTraceBounded n Y) :
    ¬ Function.Bijective
      (actualFixedPhaseCuspTraceBulkProjection n Y) := by
  exact fun hBij => hNotBounded
    (actualFixedPhaseStoredTraceBounded_of_bulkProjection_bijective n Y hBij)

/-! ## 5. Closed zero trace and honest smooth-density boundary -/

/-- Under the exact bound, zero stored coordinate in the enhanced completion
is precisely membership of the bulk coordinate in the kernel of the extended
stored trace. -/
theorem mem_actualFixedPhaseCuspTraceZeroBoundarySubspace_iff
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseStoredTraceBounded n Y)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    x ∈ actualFixedPhaseCuspTraceZeroBoundarySubspace n Y ↔
      actualFixedPhaseCuspTraceBulkProjection n Y x ∈
        (actualFixedPhaseStoredTraceExtension n Y).ker := by
  change actualFixedPhaseCuspTraceBoundaryProjection n Y x = 0 ↔
    actualFixedPhaseStoredTraceExtension n Y
      (actualFixedPhaseCuspTraceBulkProjection n Y x) = 0
  rw [actualFixedPhaseCuspTraceBoundary_eq_extension_bulk n Y hBound]

/-- The extended zero-stored-trace space in the old graph completion is a
closed linear subspace. -/
theorem actualFixedPhaseStoredTraceExtension_ker_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      (((actualFixedPhaseStoredTraceExtension n Y).ker :
        Submodule ℂ (GraphSobolevCompletion n)) :
        Set (GraphSobolevCompletion n)) :=
  (actualFixedPhaseStoredTraceExtension n Y).isClosed_ker

/-- The literal smooth fixed-phase core remains dense in the enhanced graph
closure by construction.  This statement concerns the full enhanced space;
it does not silently strengthen to density of smooth *zero-trace* elements in
the extended kernel. -/
theorem actualSmoothFixedPhaseCore_dense_in_traceEnhancedCompletion
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseCuspTraceCoreMap n Y) :=
  actualFixedPhaseCuspTraceCoreMap_denseRange n Y

/-!
The further statement

`closure (coreMap '' ker(core stored trace)) = ker(extended stored trace)`

requires a trace-compatible approximation or extension operator.  It does
not follow from density of the unrestricted core and boundedness of the trace
alone, so no theorem with that conclusion is declared here.  Likewise,
identification of the stored target with classical `H^(1/2)` requires an
actual quotient boundary, boundary measure, fractional Sobolev construction,
and a comparison isomorphism, none of which is present in the frozen
dependency.
-/

/-! ## 6. An unconditional intrinsic trace-class Hilbert space

There is nevertheless a canonical quotient-style trace class which requires
no graph-norm estimate.  Let `K` be the already closed kernel of the stored
boundary-coordinate projection on the enhanced completion.  Its orthogonal
complement `Kᵎ` is a genuine Hilbert subspace.  Orthogonal projection onto
`Kᵎ` is the canonical trace-class map and subtype inclusion is a norm-
preserving right inverse.

This construction records exactly the quotient by zero stored coordinate.  It
does **not** identify `Kᵎ` with the parameter `L2([0,2])^3` target, with a
geometric quotient boundary, or with a fractional Sobolev `H^(1/2)` space.
-/

/-- Closed zero-stored-coordinate kernel, renamed only for the intrinsic
orthogonal quotient construction. -/
abbrev ActualFixedPhaseCanonicalZeroStoredSubspace
    (n : ℤ) (Y : ℝ) :=
  actualFixedPhaseCuspTraceZeroBoundarySubspace n Y

/-- Canonical intrinsic trace classes: the orthogonal representatives modulo
the closed zero-stored-coordinate subspace. -/
abbrev ActualFixedPhaseCanonicalTraceClass
    (n : ℤ) (Y : ℝ) :=
  (ActualFixedPhaseCanonicalZeroStoredSubspace n Y)ᗮ

/-- The closed zero-stored-coordinate subspace admits an orthogonal
projection because the enhanced completion is Hilbert. -/
noncomputable instance actualFixedPhaseCanonicalZeroStored_hasOrthogonalProjection
    (n : ℤ) (Y : ℝ) :
    (ActualFixedPhaseCanonicalZeroStoredSubspace n Y).HasOrthogonalProjection := by
  letI : CompleteSpace
      (ActualFixedPhaseCanonicalZeroStoredSubspace n Y) :=
    (actualFixedPhaseCuspTraceZeroBoundarySubspace_isClosed n Y).isComplete.completeSpace_coe
  exact Submodule.HasOrthogonalProjection.ofCompleteSpace _

/-- The canonical trace-class carrier is complete, hence is itself a Hilbert
space with the inherited inner product. -/
noncomputable instance actualFixedPhaseCanonicalTraceClass_completeSpace
    (n : ℤ) (Y : ℝ) :
    CompleteSpace (ActualFixedPhaseCanonicalTraceClass n Y) :=
  (ActualFixedPhaseCanonicalZeroStoredSubspace n Y).isClosed_orthogonal.isComplete.completeSpace_coe

/-- Explicit theorem-level witness that the intrinsic trace carrier is a
complex Hilbert space.  This carries no analytic hypothesis: the inner
product is inherited from the enhanced completion and completeness follows
from closedness of an orthogonal complement. -/
noncomputable def actualFixedPhaseCanonicalTraceClassHilbertSpace
    (n : ℤ) (Y : ℝ) :
    HilbertSpace ℂ (ActualFixedPhaseCanonicalTraceClass n Y) :=
  ⟨⟩

/-- Canonical quotient-style trace map: orthogonally discard the closed
zero-stored-coordinate component. -/
noncomputable def actualFixedPhaseCanonicalTraceClassProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseCanonicalTraceClass n Y :=
  (ActualFixedPhaseCanonicalTraceClass n Y).orthogonalProjection

/-- Canonical representative map from an intrinsic trace class back into the
enhanced completion. -/
noncomputable def actualFixedPhaseCanonicalTraceClassExtension
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCanonicalTraceClass n Y →L[ℂ]
      ActualFixedPhaseCuspTraceCompletion n Y :=
  (ActualFixedPhaseCanonicalTraceClass n Y).subtypeL

/-- The canonical representative map is a right inverse of the intrinsic
trace-class projection. -/
@[simp]
theorem actualFixedPhaseCanonicalTraceClassProjection_extension
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseCanonicalTraceClass n Y) :
    actualFixedPhaseCanonicalTraceClassProjection n Y
        (actualFixedPhaseCanonicalTraceClassExtension n Y x) = x := by
  exact (ActualFixedPhaseCanonicalTraceClass n Y).orthogonalProjection_mem_subspace_eq_self x

/-- The canonical representative inclusion is literally a right inverse of
the intrinsic trace projection. -/
theorem actualFixedPhaseCanonicalTraceClassExtension_rightInverse
    (n : ℤ) (Y : ℝ) :
    Function.RightInverse
      (actualFixedPhaseCanonicalTraceClassExtension n Y)
      (actualFixedPhaseCanonicalTraceClassProjection n Y) :=
  actualFixedPhaseCanonicalTraceClassProjection_extension n Y

/-- Canonical orthogonal representatives are faithful. -/
theorem actualFixedPhaseCanonicalTraceClassExtension_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective
      (actualFixedPhaseCanonicalTraceClassExtension n Y) :=
  (actualFixedPhaseCanonicalTraceClassExtension_rightInverse n Y).injective

/-- The intrinsic trace-class projection is onto. -/
theorem actualFixedPhaseCanonicalTraceClassProjection_surjective
    (n : ℤ) (Y : ℝ) :
    Function.Surjective
      (actualFixedPhaseCanonicalTraceClassProjection n Y) := by
  intro x
  exact ⟨actualFixedPhaseCanonicalTraceClassExtension n Y x,
    actualFixedPhaseCanonicalTraceClassProjection_extension n Y x⟩

/-- Orthogonal trace-class projection is contractive. -/
theorem actualFixedPhaseCanonicalTraceClassProjection_norm_le
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    ‖actualFixedPhaseCanonicalTraceClassProjection n Y x‖ ≤ ‖x‖ :=
  (ActualFixedPhaseCanonicalTraceClass n Y).norm_orthogonalProjection_apply_le x

/-- Explicit operator-norm structure for this fixed continuous-linear-map type.
It is the standard infimum of all nonnegative pointwise bounds, written directly
to avoid an ambiguous `NormedSpace.toModule` search for the subtype codomain. -/
noncomputable local instance (priority := 2000)
    actualFixedPhaseCanonicalTraceClassProjectionNorm
    (n : ℤ) (Y : ℝ) :
    Norm
      (ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
        ActualFixedPhaseCanonicalTraceClass n Y) where
  norm f := sInf {c : ℝ | 0 ≤ c ∧ ∀ x, ‖f x‖ ≤ c * ‖x‖}

/-- Operator norm of the intrinsic trace-class projection is at most one. -/
theorem actualFixedPhaseCanonicalTraceClassProjection_opNorm_le
    (n : ℤ) (Y : ℝ) :
    ‖actualFixedPhaseCanonicalTraceClassProjection n Y‖ ≤ 1 := by
  refine csInf_le ?_ ?_
  · exact ⟨0, fun c hc => hc.1⟩
  · exact ⟨zero_le_one, fun x => by
      simpa using actualFixedPhaseCanonicalTraceClassProjection_norm_le n Y x⟩

/-- Inclusion of the canonical orthogonal representative preserves norm. -/
theorem actualFixedPhaseCanonicalTraceClassExtension_norm
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseCanonicalTraceClass n Y) :
    ‖actualFixedPhaseCanonicalTraceClassExtension n Y x‖ = ‖x‖ := by
  rfl

/-- Removing the canonical orthogonal representative leaves an element of
the original closed zero-stored-coordinate subspace.  This is the precise
quotient-representative statement supplied by the frozen dependency. -/
theorem actualFixedPhaseCanonicalTraceClass_remainder_mem_zeroStored
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    x - actualFixedPhaseCanonicalTraceClassExtension n Y
          (actualFixedPhaseCanonicalTraceClassProjection n Y x) ∈
      ActualFixedPhaseCanonicalZeroStoredSubspace n Y := by
  change x - (ActualFixedPhaseCanonicalTraceClass n Y).starProjection x ∈
    ActualFixedPhaseCanonicalZeroStoredSubspace n Y
  have h :=
    (ActualFixedPhaseCanonicalTraceClass n Y).sub_starProjection_mem_orthogonal x
  rw [Submodule.orthogonal_orthogonal
    (ActualFixedPhaseCanonicalZeroStoredSubspace n Y)] at h
  exact h

/-- Every enhanced-completion point decomposes into a zero-stored-coordinate
part and its norm-preserving canonical trace representative. -/
theorem actualFixedPhaseCanonicalTraceClass_decomposition
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseCuspTraceCompletion n Y) :
    x =
      (x - actualFixedPhaseCanonicalTraceClassExtension n Y
          (actualFixedPhaseCanonicalTraceClassProjection n Y x)) +
        actualFixedPhaseCanonicalTraceClassExtension n Y
          (actualFixedPhaseCanonicalTraceClassProjection n Y x) := by
  exact (sub_add_cancel x _).symm

/-- The kernel of canonical trace classes is exactly the original closed
zero-stored-coordinate subspace. -/
theorem actualFixedPhaseCanonicalTraceClassProjection_ker
    (n : ℤ) (Y : ℝ) :
    (actualFixedPhaseCanonicalTraceClassProjection n Y).ker =
      ActualFixedPhaseCanonicalZeroStoredSubspace n Y := by
  change
    ((ActualFixedPhaseCanonicalTraceClass n Y).orthogonalProjection).ker =
      ActualFixedPhaseCanonicalZeroStoredSubspace n Y
  rw [Submodule.ker_orthogonalProjection]
  change
    (ActualFixedPhaseCanonicalZeroStoredSubspace n Y)ᗮᗮ =
      ActualFixedPhaseCanonicalZeroStoredSubspace n Y
  exact Submodule.orthogonal_orthogonal
    (ActualFixedPhaseCanonicalZeroStoredSubspace n Y)

/-- Project the actual smooth fixed-phase core to intrinsic trace classes. -/
noncomputable def actualFixedPhaseSmoothCoreToCanonicalTraceClass
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseCanonicalTraceClass n Y :=
  (actualFixedPhaseCanonicalTraceClassProjection n Y).toLinearMap.comp
    (actualFixedPhaseCuspTraceCoreMap n Y)

/-- Intrinsic trace classes of actual smooth quotient-compact fixed-phase
sections are dense.  This follows from density of the smooth enhanced graph
and surjectivity/continuity of orthogonal projection. -/
theorem actualFixedPhaseSmoothCoreToCanonicalTraceClass_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseSmoothCoreToCanonicalTraceClass n Y) := by
  have hProjection : DenseRange
      (actualFixedPhaseCanonicalTraceClassProjection n Y) :=
    (actualFixedPhaseCanonicalTraceClassProjection_surjective n Y).denseRange
  have hComp := hProjection.comp
    (actualFixedPhaseCuspTraceCoreMap_denseRange n Y)
    (actualFixedPhaseCanonicalTraceClassProjection n Y).continuous
  simpa [actualFixedPhaseSmoothCoreToCanonicalTraceClass,
    Function.comp_def] using hComp

/-- Unconditional intrinsic trace-class endpoint. -/
theorem actualFixedPhaseCanonicalTraceClassCertificate
    (n : ℤ) (Y : ℝ) :
    Function.Surjective
        (actualFixedPhaseCanonicalTraceClassProjection n Y) ∧
      (∀ x : ActualFixedPhaseCuspTraceCompletion n Y,
        ‖actualFixedPhaseCanonicalTraceClassProjection n Y x‖ ≤ ‖x‖) ∧
      (actualFixedPhaseCanonicalTraceClassProjection n Y).ker =
        ActualFixedPhaseCanonicalZeroStoredSubspace n Y ∧
      DenseRange (actualFixedPhaseSmoothCoreToCanonicalTraceClass n Y) := by
  exact ⟨actualFixedPhaseCanonicalTraceClassProjection_surjective n Y,
    actualFixedPhaseCanonicalTraceClassProjection_norm_le n Y,
    actualFixedPhaseCanonicalTraceClassProjection_ker n Y,
    actualFixedPhaseSmoothCoreToCanonicalTraceClass_denseRange n Y⟩

/-- The unconditional endpoint: it packages only theorem-valued equivalences
and closedness already proved above, while leaving the concrete core estimate
visible as a proposition rather than as a supplied field. -/
theorem actualFixedPhaseStoredTraceComparisonCertificate
    (n : ℤ) (Y : ℝ) :
    (ActualFixedPhaseStoredTraceBounded n Y ↔
      ∃ T : GraphSobolevCompletion n →L[ℂ]
          ActualFixedPhaseThreeCuspBoundaryL2,
        ExtendsActualFixedPhaseStoredTrace n Y T) ∧
    (ActualFixedPhaseStoredTraceBounded n Y ↔
      Function.Bijective
        (actualFixedPhaseCuspTraceBulkProjection n Y)) ∧
    IsClosed
      (((actualFixedPhaseStoredTraceExtension n Y).ker :
        Submodule ℂ (GraphSobolevCompletion n)) :
        Set (GraphSobolevCompletion n)) ∧
    DenseRange (actualFixedPhaseCuspTraceCoreMap n Y) := by
  exact ⟨actualFixedPhaseStoredTraceBounded_iff_exists_extension n Y,
    actualFixedPhaseStoredTraceBounded_iff_bulkProjection_bijective n Y,
    actualFixedPhaseStoredTraceExtension_ker_isClosed n Y,
    actualSmoothFixedPhaseCore_dense_in_traceEnhancedCompletion n Y⟩

end QYM.FullCertification.P2ClassicalTraceBoundaryExtension

