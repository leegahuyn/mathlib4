namespace QYM.FullCertification.P2SmoothTransitionClosureExtension








open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# Closing the smooth transition residual

The global effective Gamma(2) quotient is already a covering space.  For two
covering sheets, their transition map has the same quotient projection as the
identity on its source.  At any one point an orbit representative therefore
identifies the transition with one concrete Gamma(2) Mobius transformation.
Local injectivity of the covering projection makes the equality locus of
these two lifts open.  Since the concrete Mobius transformation is smooth,
the transition is smooth locally at every point.

This argument proves the transition proposition left explicit in
P2SmoothQuotientAtlasExtension.  The final section records the resulting
smooth-manifold and open-stage inclusion endpoints.
-/

/-! ## 1. Covering-sheet transitions preserve the quotient projection -/

/-- The transition from the sheet centred at z to the sheet centred at w. -/
noncomputable def coveringSheetTransition (z w : ℍ) :
    OpenPartialHomeomorph ℍ ℍ :=
  (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).trans
    (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).symm

/-- A point in the transition source is sent by the z-sheet into the target
of the w-sheet. -/
theorem sheet_image_mem_target_of_mem_transition_source
    (z w x : ℍ) (hx : x ∈ (coveringSheetTransition z w).source) :
    QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x ∈
      (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).target := by
  rw [coveringSheetTransition,
    OpenPartialHomeomorph.trans_source] at hx
  have hx' := hx.2
  change QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x ∈
    (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).symm.source at hx'
  simpa only [OpenPartialHomeomorph.symm_source] using hx'

/-- Applying the target sheet to its transition inverse recovers the value of
the source sheet. -/
theorem target_sheet_transition_eq_source_sheet
    (z w x : ℍ) (hx : x ∈ (coveringSheetTransition z w).source) :
    QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w (coveringSheetTransition z w x) =
      QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x := by
  change QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w
      ((QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).symm
        (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x)) =
    QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x
  exact (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).right_inv
    (sheet_image_mem_target_of_mem_transition_source z w x hx)

/-- Every covering-sheet transition is another lift of the identity on the
quotient, on its natural source. -/
theorem quotientMk_transition_eq
    (z w x : ℍ) (hx : x ∈ (coveringSheetTransition z w).source) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk (coveringSheetTransition z w x) =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk x := by
  calc
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk (coveringSheetTransition z w x) =
        QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w
          (coveringSheetTransition z w x) :=
      congrFun (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt_eq_projection w)
        (coveringSheetTransition z w x)
    _ = QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z x :=
      target_sheet_transition_eq_source_sheet z w x hx
    _ = Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk x :=
      (congrFun (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt_eq_projection z) x).symm

/-! ## 2. A concrete deck transformation at every transition point -/

/-- At every point of a transition source there is an arithmetic Gamma(2)
element whose action equals the transition at that point. -/
theorem exists_gamma_transition_eq_at
    (z w x : ℍ) (hx : x ∈ (coveringSheetTransition z w).source) :
    ∃ gamma : GammaTwo,
      coveringSheetTransition z w x =
        (gamma : SL(2, ℤ)) • x := by
  have hQuotient := quotientMk_transition_eq z w x hx
  have hOrbit :
      MulAction.orbitRel GammaTwoEffective ℍ
        (coveringSheetTransition z w x) x :=
    Quotient.eq''.mp hQuotient
  rcases hOrbit with ⟨g, hg⟩
  rcases Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.effective_exists_gamma g with ⟨gamma, hgamma⟩
  exact ⟨gamma, hg.symm.trans (hgamma x)⟩

/-! ## 3. Openness of the local deck-transformation germ -/

/-- The transition, restricted to its open source subtype, is continuous. -/
theorem coveringSheetTransition_continuous_restrict
    (z w : ℍ) :
    Continuous
      (fun x : (coveringSheetTransition z w).source ↦
        coveringSheetTransition z w x.1) := by
  change Continuous ((coveringSheetTransition z w) ∘ Subtype.val)
  exact
    (coveringSheetTransition z w).continuousOn.comp_continuous
      continuous_subtype_val (fun x ↦ x.2)

/-- A fixed arithmetic deck transformation is continuous on the transition
source subtype. -/
theorem gamma_action_continuous_restrict
    (z w : ℍ) (gamma : GammaTwo) :
    Continuous
      (fun x : (coveringSheetTransition z w).source ↦
        (gamma : SL(2, ℤ)) • x.1) := by
  change Continuous
    (fun x : (coveringSheetTransition z w).source ↦
      ((((gamma : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ) • x.1))
  exact
    (continuous_const_smul
      ((((gamma : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ))).comp
      continuous_subtype_val

/-- On the transition-source subtype, the transition and a fixed deck action
have the same composite with the quotient projection. -/
theorem quotient_composites_transition_eq_gamma
    (z w : ℍ) (gamma : GammaTwo) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ∘
        (fun x : (coveringSheetTransition z w).source ↦
          coveringSheetTransition z w x.1) =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ∘
        (fun x : (coveringSheetTransition z w).source ↦
          (gamma : SL(2, ℤ)) • x.1) := by
  funext x
  calc
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk (coveringSheetTransition z w x.1) =
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk x.1 :=
      quotientMk_transition_eq z w x.1 x.2
    _ = Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ((gamma : SL(2, ℤ)) • x.1) :=
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_gamma_smul gamma x.1).symm

/-- The equality locus of a transition and a fixed deck action is open inside
the transition source. -/
theorem transition_gamma_eqLocus_isOpen
    (z w : ℍ) (gamma : GammaTwo) :
    IsOpen
      {x : (coveringSheetTransition z w).source |
        coveringSheetTransition z w x.1 =
          (gamma : SL(2, ℤ)) • x.1} := by
  exact
    QYM.FullCertification.P2GammaTwoFreeActionExtension.gammaTwoQuotientMk_isLocalHomeomorph.isLocallyInjective.isOpen_eqLocus
      (coveringSheetTransition_continuous_restrict z w)
      (gamma_action_continuous_restrict z w gamma)
      (quotient_composites_transition_eq_gamma z w gamma)

/-- The subtype equality locus has an ambient-open image because the
transition source itself is open. -/
theorem transition_gamma_eqLocus_image_isOpen
    (z w : ℍ) (gamma : GammaTwo) :
    IsOpen
      (((↑) : (coveringSheetTransition z w).source → ℍ) ''
        {x : (coveringSheetTransition z w).source |
          coveringSheetTransition z w x.1 =
            (gamma : SL(2, ℤ)) • x.1}) := by
  exact (coveringSheetTransition z w).open_source.isOpenMap_subtype_val
    _ (transition_gamma_eqLocus_isOpen z w gamma)

/-! ## 4. Local smoothness and closure of the residual -/

/-- Every integral special-linear deck transformation acts smoothly on the
upper half-plane. -/
theorem gamma_action_contMDiff
    (gamma : GammaTwo) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
      (fun x : ℍ ↦ (gamma : SL(2, ℤ)) • x) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
    (fun x : ℍ ↦
      ((((gamma : GammaTwo) : SL(2, ℤ)) : GL (Fin 2) ℝ) • x))
  exact UpperHalfPlane.contMDiff_smul (n := ∞) (by simp)

/-- Each transition is smooth on its full natural source. -/
theorem coveringSheetTransition_contMDiffOn
    (z w : ℍ) :
    ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞
      (coveringSheetTransition z w)
      (coveringSheetTransition z w).source := by
  apply contMDiffOn_of_locally_contMDiffOn
  intro x hx
  rcases exists_gamma_transition_eq_at z w x hx with
    ⟨gamma, hgammaAt⟩
  let U : Set ℍ :=
    ((↑) : (coveringSheetTransition z w).source → ℍ) ''
      {y : (coveringSheetTransition z w).source |
        coveringSheetTransition z w y.1 =
          (gamma : SL(2, ℤ)) • y.1}
  have hUOpen : IsOpen U :=
    transition_gamma_eqLocus_image_isOpen z w gamma
  have hxU : x ∈ U := by
    exact ⟨⟨x, hx⟩, hgammaAt, rfl⟩
  refine ⟨U, hUOpen, hxU, ?_⟩
  apply (gamma_action_contMDiff gamma).contMDiffOn.congr
  intro y hy
  rcases hy.2 with ⟨y', hy'Eq, hy'Val⟩
  rw [← hy'Val]
  exact hy'Eq

/-- The formerly explicit atlas-transition residual is now unconditionally
inhabited. -/
theorem smoothTransitionResidual : QYM.FullCertification.P2SmoothQuotientAtlasExtension.SmoothTransitionResidual := by
  intro z w
  simpa only [coveringSheetTransition] using
    coveringSheetTransition_contMDiffOn z w

/-! ## 5. Unconditional smooth quotient endpoints -/

/-- The all-covering-sheets atlas is unconditionally compatible with the
smooth upper-half-plane structure groupoid. -/
theorem allCoveringSheets_hasGroupoid :
    letI : ChartedSpace ℍ GammaTwoQuotient :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
    HasGroupoid GammaTwoQuotient QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid := by
  letI : ChartedSpace ℍ GammaTwoQuotient :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
  exact QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual

/-- After composition with the standard complex atlas of the upper
half-plane, the all-sheets atlas is compatible with the ordinary smooth
groupoid. -/
theorem allCoveringSheets_hasComplexGroupoid :
    letI : ChartedSpace ℍ GammaTwoQuotient :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
    letI : HasGroupoid GammaTwoQuotient
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
    letI : ChartedSpace ℂ GammaTwoQuotient :=
      ChartedSpace.comp ℂ ℍ GammaTwoQuotient
    HasGroupoid GammaTwoQuotient
      (contDiffGroupoid ∞ 𝓘(ℂ)) := by
  letI : ChartedSpace ℍ GammaTwoQuotient :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
  letI : HasGroupoid GammaTwoQuotient
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
  letI : ChartedSpace ℂ GammaTwoQuotient :=
    ChartedSpace.comp ℂ ℍ GammaTwoQuotient
  apply StructureGroupoid.HasGroupoid.comp QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid
  intro e he
  rw [isLocalStructomorphOn_contDiffGroupoid_iff]
  change
    ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e e.source ∧
      ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e.symm e.target at he
  exact he

/-- Unconditional genuine smooth-manifold structure on the effective
Gamma(2) quotient for the composed all-covering-sheets atlas. -/
theorem gammaTwoQuotient_isManifold :
    letI : ChartedSpace ℍ GammaTwoQuotient :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
    letI : HasGroupoid GammaTwoQuotient
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
    letI : ChartedSpace ℂ GammaTwoQuotient :=
      ChartedSpace.comp ℂ ℍ GammaTwoQuotient
    IsManifold 𝓘(ℂ) ∞ GammaTwoQuotient := by
  letI : ChartedSpace ℍ GammaTwoQuotient :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
  letI : HasGroupoid GammaTwoQuotient
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
  letI : ChartedSpace ℂ GammaTwoQuotient :=
    ChartedSpace.comp ℂ ℍ GammaTwoQuotient
  letI : HasGroupoid GammaTwoQuotient
      (contDiffGroupoid ∞ 𝓘(ℂ)) :=
    allCoveringSheets_hasComplexGroupoid
  exact IsManifold.mk' 𝓘(ℂ) ∞ GammaTwoQuotient

/-- Every monotone inclusion of intrinsic open-stage interiors is smooth,
with no remaining transition-atlas premise. -/
theorem interiorStageInclusion_contMDiff
    {Y Z : ℝ} (hYZ : Y ≤ Z) :
    letI : ChartedSpace ℍ GammaTwoQuotient :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
    letI : HasGroupoid GammaTwoQuotient
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
    letI : ChartedSpace ℂ GammaTwoQuotient :=
      ChartedSpace.comp ℂ ℍ GammaTwoQuotient
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞
      (QYM.FullCertification.P2SmoothQuotientAtlasExtension.interiorStageInclusion hYZ) := by
  letI : ChartedSpace ℍ GammaTwoQuotient :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH
  letI : HasGroupoid GammaTwoQuotient
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid smoothTransitionResidual
  letI : ChartedSpace ℂ GammaTwoQuotient :=
    ChartedSpace.comp ℂ ℍ GammaTwoQuotient
  letI : HasGroupoid GammaTwoQuotient
      (contDiffGroupoid ∞ 𝓘(ℂ)) :=
    allCoveringSheets_hasComplexGroupoid
  letI : IsManifold 𝓘(ℂ) ∞ GammaTwoQuotient :=
    gammaTwoQuotient_isManifold
  exact contMDiff_inclusion (QYM.FullCertification.P2SmoothQuotientAtlasExtension.interiorStage_mono hYZ)

/-- Aggregate unconditional path-A atlas endpoint.  The separate thickened
cusp-collar construction remains outside this certificate. -/
structure SmoothQuotientAtlasCertificate : Prop where
  transitionSmooth : QYM.FullCertification.P2SmoothQuotientAtlasExtension.SmoothTransitionResidual
  covering : IsCoveringMap Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
  localDiffeomorphZero :
    IsLocalDiffeomorph 𝓘(ℂ) 𝓘(ℂ) 0 Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk

/-- The atlas certificate is inhabited entirely by proved theorems. -/
theorem smoothQuotientAtlasCertificate :
    SmoothQuotientAtlasCertificate where
  transitionSmooth := smoothTransitionResidual
  covering := QYM.FullCertification.P2GammaTwoFreeActionExtension.gammaTwoQuotientMk_isCoveringMap
  localDiffeomorphZero :=
