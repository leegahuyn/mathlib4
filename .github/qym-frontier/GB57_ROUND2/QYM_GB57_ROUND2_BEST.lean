/-!
# A concrete two-level Hamiltonian

This file constructs an actual linear map on `Fin 2 → ℝ`.  Every finite algebraic eigenvalue
statement below is proved by its two coordinates; no compact-operator or infinite-dimensional
spectral API is used.

This is not a construction of the paper's differential Hamiltonian or of any self-adjoint
realization, domain, compact resolvent, gauge-slice operator, or continuum mass gap.  In
particular, `first_excited_gap` certifies only the separation of the two eigenvalues of the
explicit map defined in this file.
-/

namespace QYM
namespace FiniteHamiltonian

abbrev Vec2 := Fin 2 → ℝ

/-- The diagonal linear map with diagonal entries `100` and `201/2`. -/
def hamiltonian : Vec2 →ₗ[ℝ] Vec2 where
  toFun x i := if i = 0 then 100 * x 0 else (201 / 2 : ℝ) * x 1
  map_add' x y := by
    funext i
    fin_cases i <;> simp [mul_add]
  map_smul' c x := by
    funext i
    fin_cases i <;> simp <;> ring

theorem hamiltonian_add (x y : Vec2) :
    hamiltonian (x + y) = hamiltonian x + hamiltonian y :=
  hamiltonian.map_add x y

theorem hamiltonian_smul (c : ℝ) (x : Vec2) :
    hamiltonian (c • x) = c • hamiltonian x :=
  hamiltonian.map_smul c x

/-- Explicit Euclidean dot product on the raw function carrier. -/
def dot (x y : Vec2) : ℝ :=
  x 0 * y 0 + x 1 * y 1

/-- Squared Euclidean length, kept algebraic rather than identified with the Pi sup norm. -/
def normSq (x : Vec2) : ℝ :=
  dot x x

/-- Quadratic form associated with the concrete Hamiltonian. -/
def energy (x : Vec2) : ℝ :=
  dot x (hamiltonian x)

/-- The diagonal map is symmetric for the explicit Euclidean dot product. -/
theorem hamiltonian_dot_symmetric (x y : Vec2) :
    dot (hamiltonian x) y = dot x (hamiltonian y) := by
  simp [dot, hamiltonian]
  ring

theorem normSq_formula (x : Vec2) :
    normSq x = x 0 ^ 2 + x 1 ^ 2 := by
  simp [normSq, dot, pow_two]

theorem energy_formula (x : Vec2) :
    energy x = 100 * x 0 ^ 2 + (201 / 2 : ℝ) * x 1 ^ 2 := by
  simp [energy, dot, hamiltonian, pow_two]
  ring

def groundEigenvalue : ℝ := 100

def excitedEigenvalue : ℝ := 201 / 2

/-- First coordinate standard basis vector. -/
def basis0 : Vec2 := fun i => if i = 0 then 1 else 0

/-- Second coordinate standard basis vector. -/
def basis1 : Vec2 := fun i => if i = 1 then 1 else 0

theorem basis0_ne_zero : basis0 ≠ 0 := by
  intro h
  have h0 := congrFun h (0 : Fin 2)
  norm_num [basis0] at h0

theorem basis1_ne_zero : basis1 ≠ 0 := by
  intro h
  have h1 := congrFun h (1 : Fin 2)
  norm_num [basis1] at h1

theorem hamiltonian_basis0 :
    hamiltonian basis0 = groundEigenvalue • basis0 := by
  ext i
  fin_cases i <;> norm_num [hamiltonian, basis0, groundEigenvalue]

theorem hamiltonian_basis1 :
    hamiltonian basis1 = excitedEigenvalue • basis1 := by
  ext i
  fin_cases i <;> norm_num [hamiltonian, basis1, excitedEigenvalue]

/-- A nonzero ground eigenvector together with its eigen-equation. -/
theorem basis0_eigenpair :
    basis0 ≠ 0 ∧ hamiltonian basis0 = groundEigenvalue • basis0 :=
  ⟨basis0_ne_zero, hamiltonian_basis0⟩

/-- A nonzero excited eigenvector together with its eigen-equation. -/
theorem basis1_eigenpair :
    basis1 ≠ 0 ∧ hamiltonian basis1 = excitedEigenvalue • basis1 :=
  ⟨basis1_ne_zero, hamiltonian_basis1⟩

/-- The ground quadratic-form lower bound. -/
theorem ground_energy_lower (x : Vec2) :
    groundEigenvalue * normSq x ≤ energy x := by
  rw [energy_formula, normSq_formula]
  unfold groundEigenvalue
  nlinarith [sq_nonneg (x 1)]

/-- Equality in the ground lower bound occurs exactly on the first coordinate axis. -/
theorem energy_eq_ground_mul_normSq_iff (x : Vec2) :
    energy x = groundEigenvalue * normSq x ↔ x 1 = 0 := by
  rw [energy_formula, normSq_formula]
  unfold groundEigenvalue
  constructor
  · intro h
    have hs : x 1 ^ 2 = 0 := by
      nlinarith [sq_nonneg (x 1)]
    exact sq_eq_zero_iff.mp hs
  · intro hx
    rw [hx]
    ring

/-- Coordinate characterization of the complete ground eigenspace, including the zero vector. -/
theorem ground_eigenvector_iff (x : Vec2) :
    hamiltonian x = groundEigenvalue • x ↔ x 1 = 0 := by
  constructor
  · intro h
    have h1 := congrFun h (1 : Fin 2)
    change (201 / 2 : ℝ) * x 1 = groundEigenvalue * x 1 at h1
    unfold groundEigenvalue at h1
    linarith
  · intro hx
    ext i
    fin_cases i <;> simp [hamiltonian, groundEigenvalue, hx]

/-- Coordinate characterization of the complete excited eigenspace, including the zero vector. -/
theorem excited_eigenvector_iff (x : Vec2) :
    hamiltonian x = excitedEigenvalue • x ↔ x 0 = 0 := by
  constructor
  · intro h
    have h0 := congrFun h (0 : Fin 2)
    change (100 : ℝ) * x 0 = excitedEigenvalue * x 0 at h0
    unfold excitedEigenvalue at h0
    linarith
  · intro hx
    ext i
    fin_cases i <;> simp [hamiltonian, excitedEigenvalue, hx]

/-- Every eigenvalue occurring in an explicit nonzero eigen-equation is one of the two diagonal
entries. -/
theorem eigenvalue_classification
    {lambda : ℝ} {x : Vec2} (hx : x ≠ 0)
    (heigen : hamiltonian x = lambda • x) :
    lambda = groundEigenvalue ∨ lambda = excitedEigenvalue := by
  have hcoord : x 0 ≠ 0 ∨ x 1 ≠ 0 := by
    by_contra h
    push_neg at h
    apply hx
    funext i
    fin_cases i
    · exact h.1
    · exact h.2
  rcases hcoord with h0 | h1
  · left
    have heq := congrFun heigen (0 : Fin 2)
    change (100 : ℝ) * x 0 = lambda * x 0 at heq
    have hcancel : x 0 * (100 : ℝ) = x 0 * lambda := by
      calc
        x 0 * (100 : ℝ) = 100 * x 0 := mul_comm _ _
        _ = lambda * x 0 := heq
        _ = x 0 * lambda := mul_comm _ _
    simpa [groundEigenvalue] using (mul_left_cancel₀ h0 hcancel).symm
  · right
    have heq := congrFun heigen (1 : Fin 2)
    change (201 / 2 : ℝ) * x 1 = lambda * x 1 at heq
    have hcancel : x 1 * (201 / 2 : ℝ) = x 1 * lambda := by
      calc
        x 1 * (201 / 2 : ℝ) = (201 / 2 : ℝ) * x 1 := mul_comm _ _
        _ = lambda * x 1 := heq
        _ = x 1 * lambda := mul_comm _ _
    simpa [excitedEigenvalue] using (mul_left_cancel₀ h1 hcancel).symm

theorem ground_lt_excited : groundEigenvalue < excitedEigenvalue := by
  norm_num [groundEigenvalue, excitedEigenvalue]

/-- The separation of the two classified eigenvalues of this finite map is exactly `1/2`. -/
theorem first_excited_gap :
    excitedEigenvalue - groundEigenvalue = (1 / 2 : ℝ) := by
  norm_num [groundEigenvalue, excitedEigenvalue]

end FiniteHamiltonian
end QYM

/-!
# A finite-cover local-to-global minimization obstruction

This file builds a completely finite Boolean model with a three-point base, two overlapping
patches, explicit restriction maps, an identity transition on the overlap, and unique gluing of
compatible local sections.  The chosen local sections minimize their respective local energies,
but their unique glue does not minimize a separately defined coupled global energy.

The final theorem is not advertised as a countermodel to every analytic hypothesis of paper
Theorem 4.3.  In particular, the coupled global energy is deliberately not proved local, additive,
or determined by the two local energies.  No Sobolev, gauge, partition-of-unity, boundary, or
variational structure is encoded.
-/



namespace QYM.FullCertification.NoGo.FiniteCover

/-! ## Finite base, patches, and their overlap -/

/-- The three-point base: a left point, the overlap point, and a right point. -/
inductive X where
  | left
  | middle
  | right
deriving DecidableEq

instance : Fintype X where
  elems := {X.left, X.middle, X.right}
  complete := by
    intro x
    cases x <;> simp

/-- The left patch `U0 = {left, middle}`. -/
def U0 : Set X := {x | x = X.left ∨ x = X.middle}

/-- The right patch `U1 = {middle, right}`. -/
def U1 : Set X := {x | x = X.middle ∨ x = X.right}

theorem patches_cover : U0 ∪ U1 = Set.univ := by
  ext x
  cases x <;> simp [U0, U1]

theorem patches_overlap : U0 ∩ U1 = ({X.middle} : Set X) := by
  ext x
  cases x <;> simp [U0, U1]

/-- Coordinate type for the two points of `U0`. -/
inductive Patch0Point where
  | left
  | middle
deriving DecidableEq

instance : Fintype Patch0Point where
  elems := {Patch0Point.left, Patch0Point.middle}
  complete := by
    intro x
    cases x <;> simp

/-- Coordinate type for the two points of `U1`. -/
inductive Patch1Point where
  | middle
  | right
deriving DecidableEq

instance : Fintype Patch1Point where
  elems := {Patch1Point.middle, Patch1Point.right}
  complete := by
    intro x
    cases x <;> simp

/-- Coordinate type for the singleton overlap. -/
inductive OverlapPoint where
  | middle
deriving DecidableEq

instance : Fintype OverlapPoint where
  elems := {OverlapPoint.middle}
  complete := by
    intro x
    cases x <;> simp

def include0 : Patch0Point → X
  | .left => .left
  | .middle => .middle

def include1 : Patch1Point → X
  | .middle => .middle
  | .right => .right

def includeOverlap0 : OverlapPoint → Patch0Point
  | .middle => .middle

def includeOverlap1 : OverlapPoint → Patch1Point
  | .middle => .middle

theorem include0_mem_U0 (p : Patch0Point) : include0 p ∈ U0 := by
  cases p <;> simp [include0, U0]

theorem include1_mem_U1 (p : Patch1Point) : include1 p ∈ U1 := by
  cases p <;> simp [include1, U1]

theorem range_include0_eq_U0 : Set.range include0 = U0 := by
  ext x
  constructor
  · rintro ⟨p, rfl⟩
    exact include0_mem_U0 p
  · intro hx
    cases x with
    | left => exact ⟨Patch0Point.left, rfl⟩
    | middle => exact ⟨Patch0Point.middle, rfl⟩
    | right => simp [U0] at hx

theorem range_include1_eq_U1 : Set.range include1 = U1 := by
  ext x
  constructor
  · rintro ⟨p, rfl⟩
    exact include1_mem_U1 p
  · intro hx
    cases x with
    | left => simp [U1] at hx
    | middle => exact ⟨Patch1Point.middle, rfl⟩
    | right => exact ⟨Patch1Point.right, rfl⟩

/-! ## Sections, restrictions, compatibility, and strict transition -/

abbrev GlobalSection := X → Bool
abbrev LocalSection0 := Patch0Point → Bool
abbrev LocalSection1 := Patch1Point → Bool
abbrev OverlapSection := OverlapPoint → Bool

/-- Restriction of a global section to `U0`. -/
def restrictGlobal0 (s : GlobalSection) : LocalSection0 := fun p => s (include0 p)

/-- Restriction of a global section to `U1`. -/
def restrictGlobal1 (s : GlobalSection) : LocalSection1 := fun p => s (include1 p)

/-- Restriction from the `U0` section to the singleton overlap. -/
def restrictOverlap0 (s0 : LocalSection0) : OverlapSection :=
  fun p => s0 (includeOverlap0 p)

/-- Restriction from the `U1` section to the singleton overlap. -/
def restrictOverlap1 (s1 : LocalSection1) : OverlapSection :=
  fun p => s1 (includeOverlap1 p)

/-- Equality of the two restricted sections on `U0 ∩ U1`. -/
def OverlapCompatible (s0 : LocalSection0) (s1 : LocalSection1) : Prop :=
  restrictOverlap0 s0 = restrictOverlap1 s1

/-- The identity transition on the Boolean overlap fiber. -/
def transition01 (s : OverlapSection) : OverlapSection := s

/-- Strict transition means literal equality after applying the identity transition. -/
def SatisfiesStrictTransition (s0 : LocalSection0) (s1 : LocalSection1) : Prop :=
  transition01 (restrictOverlap0 s0) = restrictOverlap1 s1

theorem strictTransition_iff_overlapCompatible (s0 : LocalSection0) (s1 : LocalSection1) :
    SatisfiesStrictTransition s0 s1 ↔ OverlapCompatible s0 s1 := by
  simp [SatisfiesStrictTransition, OverlapCompatible, transition01]

theorem global_restrictions_overlapCompatible (s : GlobalSection) :
    OverlapCompatible (restrictGlobal0 s) (restrictGlobal1 s) := by
  funext p
  cases p
  rfl

/-! ## Explicit gluing and uniqueness -/

/-- Glue compatible local sections, taking the middle value from the left patch. -/
def glue (s0 : LocalSection0) (s1 : LocalSection1)
    (_h : OverlapCompatible s0 s1) : GlobalSection
  | .left => s0 .left
  | .middle => s0 .middle
  | .right => s1 .right

theorem overlapCompatible_value {s0 : LocalSection0} {s1 : LocalSection1}
    (h : OverlapCompatible s0 s1) :
    s0 Patch0Point.middle = s1 Patch1Point.middle := by
  change restrictOverlap0 s0 = restrictOverlap1 s1 at h
  have hm := congrFun h OverlapPoint.middle
  simpa [restrictOverlap0, restrictOverlap1, includeOverlap0, includeOverlap1] using hm

theorem restrictGlobal0_glue (s0 : LocalSection0) (s1 : LocalSection1)
    (h : OverlapCompatible s0 s1) :
    restrictGlobal0 (glue s0 s1 h) = s0 := by
  funext p
  cases p <;> rfl

theorem restrictGlobal1_glue (s0 : LocalSection0) (s1 : LocalSection1)
    (h : OverlapCompatible s0 s1) :
    restrictGlobal1 (glue s0 s1 h) = s1 := by
  funext p
  cases p with
  | middle => exact overlapCompatible_value h
  | right => rfl

/-- A global section with the prescribed two restrictions is the explicit glue. -/
theorem glue_unique (s0 : LocalSection0) (s1 : LocalSection1)
    (h : OverlapCompatible s0 s1) (s : GlobalSection)
    (hs0 : restrictGlobal0 s = s0) (hs1 : restrictGlobal1 s = s1) :
    s = glue s0 s1 h := by
  funext x
  cases x with
  | left =>
      have hx := congrFun hs0 Patch0Point.left
      simpa [restrictGlobal0, include0, glue] using hx
  | middle =>
      have hx := congrFun hs0 Patch0Point.middle
      simpa [restrictGlobal0, include0, glue] using hx
  | right =>
      have hx := congrFun hs1 Patch1Point.right
      simpa [restrictGlobal1, include1, glue] using hx

theorem existsUnique_glue (s0 : LocalSection0) (s1 : LocalSection1)
    (h : OverlapCompatible s0 s1) :
    ∃! s : GlobalSection, restrictGlobal0 s = s0 ∧ restrictGlobal1 s = s1 := by
  refine ⟨glue s0 s1 h, ?_, ?_⟩
  · exact ⟨restrictGlobal0_glue s0 s1 h, restrictGlobal1_glue s0 s1 h⟩
  · intro s hs
    exact glue_unique s0 s1 h s hs.1 hs.2

/-! ## Local minimizers -/

def boolCost : Bool → ℕ
  | false => 0
  | true => 1

/-- Local energy on `U0`: the number of `true` coordinates. -/
def localEnergy0 (s0 : LocalSection0) : ℕ :=
  boolCost (s0 .left) + boolCost (s0 .middle)

/-- Local energy on `U1`: the number of `true` coordinates. -/
def localEnergy1 (s1 : LocalSection1) : ℕ :=
  boolCost (s1 .middle) + boolCost (s1 .right)

def IsLocalMinimizer0 (s0 : LocalSection0) : Prop :=
  ∀ t0 : LocalSection0, localEnergy0 s0 ≤ localEnergy0 t0

def IsLocalMinimizer1 (s1 : LocalSection1) : Prop :=
  ∀ t1 : LocalSection1, localEnergy1 s1 ≤ localEnergy1 t1

def chosenLocal0 : LocalSection0 := fun _ => false
def chosenLocal1 : LocalSection1 := fun _ => false

theorem chosenLocal0_energy : localEnergy0 chosenLocal0 = 0 := rfl
theorem chosenLocal1_energy : localEnergy1 chosenLocal1 = 0 := rfl

theorem chosenLocal0_isMinimizer : IsLocalMinimizer0 chosenLocal0 := by
  intro t0
  change 0 ≤ localEnergy0 t0
  exact Nat.zero_le _

theorem chosenLocal1_isMinimizer : IsLocalMinimizer1 chosenLocal1 := by
  intro t1
  change 0 ≤ localEnergy1 t1
  exact Nat.zero_le _

theorem chosenOverlapCompatible : OverlapCompatible chosenLocal0 chosenLocal1 := rfl

theorem chosenSatisfiesStrictTransition :
    SatisfiesStrictTransition chosenLocal0 chosenLocal1 := rfl

def chosenGlue : GlobalSection :=
  glue chosenLocal0 chosenLocal1 chosenOverlapCompatible

theorem chosenGlue_restrictGlobal0 : restrictGlobal0 chosenGlue = chosenLocal0 := by
  simpa [chosenGlue] using
    restrictGlobal0_glue chosenLocal0 chosenLocal1 chosenOverlapCompatible

theorem chosenGlue_restrictGlobal1 : restrictGlobal1 chosenGlue = chosenLocal1 := by
  simpa [chosenGlue] using
    restrictGlobal1_glue chosenLocal0 chosenLocal1 chosenOverlapCompatible

theorem chosenGlue_unique (s : GlobalSection)
    (hs0 : restrictGlobal0 s = chosenLocal0)
    (hs1 : restrictGlobal1 s = chosenLocal1) :
    s = chosenGlue := by
  simpa [chosenGlue] using
    glue_unique chosenLocal0 chosenLocal1 chosenOverlapCompatible s hs0 hs1

theorem chosenGlue_existsUnique :
    ∃! s : GlobalSection,
      restrictGlobal0 s = chosenLocal0 ∧ restrictGlobal1 s = chosenLocal1 :=
  existsUnique_glue chosenLocal0 chosenLocal1 chosenOverlapCompatible

/-! ## A separately coupled global energy -/

/-- A joint global energy: all-false has energy `1`, all-true has energy `0`, and every other
configuration has energy `2`.  This is intentionally not the sum of the two local energies. -/
def coupledGlobalEnergy (s : GlobalSection) : ℕ :=
  match s X.left, s X.middle, s X.right with
  | false, false, false => 1
  | true, true, true => 0
  | _, _, _ => 2

def IsGlobalMinimizer (s : GlobalSection) : Prop :=
  ∀ t : GlobalSection, coupledGlobalEnergy s ≤ coupledGlobalEnergy t

def allTrueGlobal : GlobalSection := fun _ => true

theorem chosenGlue_globalEnergy : coupledGlobalEnergy chosenGlue = 1 := rfl

theorem allTrueGlobal_globalEnergy : coupledGlobalEnergy allTrueGlobal = 0 := rfl

/-- The global energy is demonstrably not the sum of the chosen local energies. -/
theorem coupledGlobalEnergy_not_localSum_at_chosen :
    coupledGlobalEnergy chosenGlue ≠
      localEnergy0 chosenLocal0 + localEnergy1 chosenLocal1 := by
  rw [chosenGlue_globalEnergy, chosenLocal0_energy, chosenLocal1_energy]
  norm_num

theorem chosenGlue_not_globalMinimizer : ¬ IsGlobalMinimizer chosenGlue := by
  intro hmin
  have hle := hmin allTrueGlobal
  rw [chosenGlue_globalEnergy, allTrueGlobal_globalEnergy] at hle
  norm_num at hle

/-- Finite local-to-global obstruction.

The two local sections are overlap-compatible, satisfy the strict identity transition, minimize
their local energies, and possess a unique global glue; nevertheless that glue is not a minimizer
of `coupledGlobalEnergy`.

This theorem isolates what compatibility plus local minimality alone cannot prove.  It is not an
exact countermodel to a stronger analytic theorem that assumes the global functional is a local or
additive assembly of the local functionals, that admissible global competitors localize to valid
local competitors, or that variations preserve Sobolev/gauge/boundary constraints.
-/
theorem finiteCover_localMinimizers_glue_not_global :
    IsLocalMinimizer0 chosenLocal0 ∧
      IsLocalMinimizer1 chosenLocal1 ∧
      OverlapCompatible chosenLocal0 chosenLocal1 ∧
      SatisfiesStrictTransition chosenLocal0 chosenLocal1 ∧
      (∃! s : GlobalSection,
        restrictGlobal0 s = chosenLocal0 ∧ restrictGlobal1 s = chosenLocal1) ∧
      ¬ IsGlobalMinimizer chosenGlue := by
  exact ⟨chosenLocal0_isMinimizer, chosenLocal1_isMinimizer, chosenOverlapCompatible,
    chosenSatisfiesStrictTransition, chosenGlue_existsUnique, chosenGlue_not_globalMinimizer⟩

end QYM.FullCertification.NoGo.FiniteCover


/-! ## Integrated positivity, variational, operator-sign, and audit modules -/



open scoped ComplexOrder

/-!
# Positive-definiteness certificate for the weighted-trace density

This integrated section upgrades the explicit diagonal density used by the skew-identity
counterexample from invertible and Hermitian to Mathlib's `Matrix.PosDef`.  It does not turn the
complex bilinear `weightedPairing` into a positive Hilbert inner product or construct the paper's
global analytic trace pairing.
-/

namespace QYM.WeightedTraceCore.SkewAdjointCounterexample

/-- The underlying matrix literal of `positiveDiagonalDensity` is the diagonal matrix with
entries `2` and `1`. -/
theorem positiveDiagonalDensity_coe_eq_diagonal :
    (positiveDiagonalDensity : Mat2) = Matrix.diagonal ![(2 : ℂ), (1 : ℂ)] := by
  change !![(2 : ℂ), 0; 0, 1] = Matrix.diagonal ![(2 : ℂ), (1 : ℂ)]
  exact (Matrix.diagonal_vec2 (2 : ℂ) (1 : ℂ)).symm

/-- The density `diag(2,1)` is positive definite in Mathlib's complex matrix order. -/
theorem positiveDiagonalDensity_posDef :
    ((positiveDiagonalDensity : Mat2)).PosDef := by
  rw [positiveDiagonalDensity_coe_eq_diagonal, Matrix.posDef_diagonal_iff]
  intro i
  fin_cases i <;> norm_num [Complex.lt_def]

/-- The previously proved Hermitian fact and skew-identity failure hold for the same now-certified
positive-definite density.  Thus positive definiteness does not make the displayed stronger
identity valid in this concrete finite-matrix model.  This is not a construction of the paper's
global analytic pairing.
-/
theorem positiveDiagonalDensity_posDef_Hermitian_and_skew_failure :
    ((positiveDiagonalDensity : Mat2)).PosDef ∧
      ((positiveDiagonalDensity : Mat2)).IsHermitian ∧
      weightedPairing positiveDiagonalDensity
          (twistedCommutator positiveDiagonalDensity e01 e10) e00 ≠
        -weightedPairing positiveDiagonalDensity e10
          (twistedCommutator positiveDiagonalDensity e01 e00) := by
  exact ⟨positiveDiagonalDensity_posDef, positiveDiagonalDensity_isHermitian,
    theorem_4_5_skew_identity_fails⟩

end QYM.WeightedTraceCore.SkewAdjointCounterexample



/-!
# Corrected finite local-to-global minimization theorem

This integrated finite model uses the explicit Boolean cover from `FiniteCover` and imposes exact
locality/additivity by definition: the global energy is exactly the sum of the two restricted
local energies.  Within this model, compatible local minimizers glue to a global minimizer, and
strict local minima give a strict global minimum.

This does not show that exact additivity is the only missing hypothesis of the paper's analytic
theorem.  It does not encode its Sobolev space, gauge constraint, boundary conditions, admissible
variations, or localization of global competitors.
-/

namespace QYM.FullCertification.Corrected.FiniteCover

open QYM.FullCertification.NoGo.FiniteCover

/-- A minimum of an arbitrary natural-valued energy. -/
def IsMinimum {S : Type*} (energy : S → ℕ) (s : S) : Prop :=
  ∀ t, energy s ≤ energy t

/-- A strict minimum: every distinct competitor has strictly larger energy. -/
def IsStrictMinimum {S : Type*} (energy : S → ℕ) (s : S) : Prop :=
  ∀ t, t ≠ s → energy s < energy t

theorem isMinimum_of_isStrictMinimum
    {S : Type*} {energy : S → ℕ} {s : S}
    (hstrict : IsStrictMinimum energy s) :
    IsMinimum energy s := by
  intro t
  by_cases hts : t = s
  · simpa [hts]
  · exact (hstrict t hts).le

/-- The genuinely additive global functional assembled from two local functionals. -/
def assembledEnergy
    (energy0 : LocalSection0 → ℕ) (energy1 : LocalSection1 → ℕ)
    (s : GlobalSection) : ℕ :=
  energy0 (restrictGlobal0 s) + energy1 (restrictGlobal1 s)

/-- Compatible local minimizers minimize the exactly assembled global energy. -/
theorem glue_isMinimum_of_localMinima
    (energy0 : LocalSection0 → ℕ) (energy1 : LocalSection1 → ℕ)
    (s0 : LocalSection0) (s1 : LocalSection1)
    (hcompat : OverlapCompatible s0 s1)
    (hmin0 : IsMinimum energy0 s0)
    (hmin1 : IsMinimum energy1 s1) :
    IsMinimum (assembledEnergy energy0 energy1) (glue s0 s1 hcompat) := by
  intro competitor
  change
    energy0 (restrictGlobal0 (glue s0 s1 hcompat)) +
        energy1 (restrictGlobal1 (glue s0 s1 hcompat)) ≤
      energy0 (restrictGlobal0 competitor) + energy1 (restrictGlobal1 competitor)
  rw [restrictGlobal0_glue, restrictGlobal1_glue]
  exact Nat.add_le_add
    (hmin0 (restrictGlobal0 competitor))
    (hmin1 (restrictGlobal1 competitor))

/-- If a global section differs from the glue, at least one of its two restrictions differs from
the corresponding local section. -/
theorem restriction_diff_of_ne_glue
    (s0 : LocalSection0) (s1 : LocalSection1)
    (hcompat : OverlapCompatible s0 s1) (competitor : GlobalSection)
    (hne : competitor ≠ glue s0 s1 hcompat) :
    restrictGlobal0 competitor ≠ s0 ∨ restrictGlobal1 competitor ≠ s1 := by
  by_contra hdiff
  apply hne
  apply glue_unique s0 s1 hcompat competitor
  · by_contra h0
    exact hdiff (Or.inl h0)
  · by_contra h1
    exact hdiff (Or.inr h1)

/-- Strict local minima yield a strict global minimum for the exactly additive energy. -/
theorem glue_isStrictMinimum_of_localStrictMinima
    (energy0 : LocalSection0 → ℕ) (energy1 : LocalSection1 → ℕ)
    (s0 : LocalSection0) (s1 : LocalSection1)
    (hcompat : OverlapCompatible s0 s1)
    (hstrict0 : IsStrictMinimum energy0 s0)
    (hstrict1 : IsStrictMinimum energy1 s1) :
    IsStrictMinimum (assembledEnergy energy0 energy1) (glue s0 s1 hcompat) := by
  intro competitor hne
  have hmin0 := isMinimum_of_isStrictMinimum hstrict0
  have hmin1 := isMinimum_of_isStrictMinimum hstrict1
  rcases restriction_diff_of_ne_glue s0 s1 hcompat competitor hne with hdiff0 | hdiff1
  · change
      energy0 (restrictGlobal0 (glue s0 s1 hcompat)) +
          energy1 (restrictGlobal1 (glue s0 s1 hcompat)) <
        energy0 (restrictGlobal0 competitor) + energy1 (restrictGlobal1 competitor)
    rw [restrictGlobal0_glue, restrictGlobal1_glue]
    exact Nat.add_lt_add_of_lt_of_le
      (hstrict0 (restrictGlobal0 competitor) hdiff0)
      (hmin1 (restrictGlobal1 competitor))
  · change
      energy0 (restrictGlobal0 (glue s0 s1 hcompat)) +
          energy1 (restrictGlobal1 (glue s0 s1 hcompat)) <
        energy0 (restrictGlobal0 competitor) + energy1 (restrictGlobal1 competitor)
    rw [restrictGlobal0_glue, restrictGlobal1_glue]
    exact Nat.add_lt_add_of_le_of_lt
      (hmin0 (restrictGlobal0 competitor))
      (hstrict1 (restrictGlobal1 competitor) hdiff1)

/-- A strict global minimum is the only global minimizer. -/
theorem unique_globalMinimum_of_strict
    {energy : GlobalSection → ℕ} {s : GlobalSection}
    (hstrict : IsStrictMinimum energy s)
    (other : GlobalSection) (hother : IsMinimum energy other) :
    other = s := by
  by_contra hne
  have hlt : energy s < energy other := hstrict other hne
  have hle : energy other ≤ energy s := hother s
  exact (not_lt_of_ge hle) hlt

/-- In this concrete finite example, the all-false local sections do minimize the additive energy;
the earlier failure is caused by replacing this assembled functional with the separately defined
coupled functional. -/
theorem chosenGlue_minimizes_assembledLocalEnergy :
    IsMinimum (assembledEnergy localEnergy0 localEnergy1) chosenGlue := by
  have hmin0 : IsMinimum localEnergy0 chosenLocal0 := by
    simpa only [IsMinimum, IsLocalMinimizer0] using chosenLocal0_isMinimizer
  have hmin1 : IsMinimum localEnergy1 chosenLocal1 := by
    simpa only [IsMinimum, IsLocalMinimizer1] using chosenLocal1_isMinimizer
  simpa [chosenGlue] using
    glue_isMinimum_of_localMinima localEnergy0 localEnergy1
      chosenLocal0 chosenLocal1 chosenOverlapCompatible
      hmin0 hmin1

end QYM.FullCertification.Corrected.FiniteCover



/-!
# Finite direct-method core

This is a genuine attainment theorem for arbitrary energy functions on nonempty finite spaces.
It is not a substitute for weak compactness or lower semicontinuity on the paper's Sobolev space,
but it supplies a concrete unconditional variational model used by the finite counterexamples.
-/

namespace QYM.FullCertification.Corrected.FiniteVariational

/-- A point is a global minimizer of an ordered energy. -/
def IsGlobalMin {State Energy : Type*} [LE Energy]
    (energy : State → Energy) (state : State) : Prop :=
  ∀ competitor, energy state ≤ energy competitor

/-- Every energy into a linear order attains a global minimum on a nonempty finite state space. -/
theorem exists_globalMin
    {State Energy : Type*} [Fintype State] [Nonempty State] [LinearOrder Energy]
    (energy : State → Energy) :
    ∃ state, IsGlobalMin energy state := by
  classical
  obtain ⟨state, _hstate, hminimal⟩ :=
    Finset.exists_min_image (Finset.univ : Finset State) energy Finset.univ_nonempty
  exact ⟨state, fun competitor => hminimal competitor (Finset.mem_univ competitor)⟩

/-- The subtype of actual global minimizers. -/
def Argmin
    {State Energy : Type*} [LE Energy]
    (energy : State → Energy) : Type _ :=
  {state : State // IsGlobalMin energy state}

/-- The argmin subtype is inhabited for every energy on a nonempty finite state space. -/
theorem argmin_nonempty
    {State Energy : Type*} [Fintype State] [Nonempty State] [LinearOrder Energy]
    (energy : State → Energy) :
    Nonempty (Argmin energy) := by
  obtain ⟨state, hstate⟩ := exists_globalMin energy
  exact ⟨⟨state, hstate⟩⟩

/-- A strict comparison with every distinct state makes a minimizer unique. -/
theorem unique_globalMin_of_strict
    {State Energy : Type*} [LinearOrder Energy]
    {energy : State → Energy} {state : State}
    (hstrict : ∀ competitor, competitor ≠ state → energy state < energy competitor) :
    ∀ other, IsGlobalMin energy other → other = state := by
  intro other hother
  by_contra hne
  have h₁ : energy state < energy other := hstrict other hne
  have h₂ : energy other ≤ energy state := hother state
  exact (not_lt_of_ge h₂) h₁

/-- On a finite state space, a strict minimizer therefore gives a singleton argmin. -/
theorem argmin_eq_singleton_of_strict
    {State Energy : Type*} [Fintype State] [Nonempty State] [LinearOrder Energy]
    {energy : State → Energy} {state : State}
    (hstrict : ∀ competitor, competitor ≠ state → energy state < energy competitor) :
    {candidate : State | IsGlobalMin energy candidate} = {state} := by
  classical
  apply Set.ext
  intro candidate
  constructor
  · intro hcandidate
    have heq := unique_globalMin_of_strict hstrict candidate hcandidate
    simpa [heq]
  · intro hcandidate
    have heq : candidate = state := by simpa using hcandidate
    subst candidate
    intro competitor
    by_cases hcomp : competitor = state
    · simpa [hcomp]
    · exact (hstrict competitor hcomp).le

end QYM.FullCertification.Corrected.FiniteVariational



/-!
# An explicit infinite diagonal algebraic sign model

On the raw algebraic function space `ℕ → ℝ`, a diagonal linear map called `laplacian` has
eigenvalue `n` on the `n`-th coordinate vector.  Consequently the surrogate with the sign pattern
`-Δ + V`, for a diagonal potential bounded above, has explicit eigenvalues `-n + v n` and fails
the elementary eigenvalue-lower-bound predicate defined below.

This models only the printed sign pattern.  It does not identify this linear map with the paper's
differential Laplacian, prove that the paper's operator has these eigenpairs, or supply an operator
domain, Hilbert topology, self-adjointness, compact resolvent, or spectral theorem.  The conclusion
follows solely from the displayed algebraic nonzero eigenpairs.
-/

namespace QYM.InfiniteDiagonalHamiltonian

/-- Algebraic sequence states.  No summability hypothesis is needed for the diagonal no-go. -/
abbrev State := ℕ → ℝ

/-- The `n`-th coordinate vector. -/
def basis (n : ℕ) : State := fun k => if k = n then 1 else 0

@[simp]
theorem basis_apply_same (n : ℕ) : basis n n = 1 := by
  simp [basis]

theorem basis_ne_zero (n : ℕ) : basis n ≠ 0 := by
  intro h
  have hn := congrFun h n
  simp [basis] at hn

/-- The nonnegative diagonal Laplacian, with eigenvalues `0,1,2,...`. -/
def laplacian : State →ₗ[ℝ] State where
  toFun x n := (n : ℝ) * x n
  map_add' x y := by
    funext n
    dsimp
    ring
  map_smul' c x := by
    funext n
    dsimp
    ring

/-- Multiplication by a real diagonal potential. -/
def potentialOperator (v : ℕ → ℝ) : State →ₗ[ℝ] State where
  toFun x n := v n * x n
  map_add' x y := by
    funext n
    dsimp
    ring
  map_smul' c x := by
    funext n
    dsimp
    ring

/-- Algebraic surrogate for the sign convention printed in the paper: `H = -Δ + V`. -/
def paperHamiltonian (v : ℕ → ℝ) : State →ₗ[ℝ] State :=
  -laplacian + potentialOperator v

@[simp]
theorem laplacian_apply (x : State) (n : ℕ) :
    laplacian x n = (n : ℝ) * x n := rfl

@[simp]
theorem potentialOperator_apply (v : ℕ → ℝ) (x : State) (n : ℕ) :
    potentialOperator v x n = v n * x n := rfl

@[simp]
theorem paperHamiltonian_apply (v : ℕ → ℝ) (x : State) (n : ℕ) :
    paperHamiltonian v x n = (-(n : ℝ) + v n) * x n := by
  simp [paperHamiltonian]
  ring

/-- The explicit eigenvalue attached to the `n`-th coordinate vector. -/
def eigenvalue (v : ℕ → ℝ) (n : ℕ) : ℝ := -(n : ℝ) + v n

theorem laplacian_basis (n : ℕ) :
    laplacian (basis n) = (n : ℝ) • basis n := by
  funext k
  by_cases h : k = n
  · subst k
    simp [basis]
  · simp [basis, h]

theorem paperHamiltonian_basis (v : ℕ → ℝ) (n : ℕ) :
    paperHamiltonian v (basis n) = eigenvalue v n • basis n := by
  funext k
  by_cases h : k = n
  · subst k
    simp [eigenvalue]
  · simp [basis, eigenvalue, h]

/-- A deliberately elementary lower-bound predicate that quantifies only over nonzero algebraic
eigenpairs of the displayed map.  Its failure obstructs a stronger lower bound for this same map;
it does not by itself identify the map or its eigenpairs with the paper's analytic spectrum. -/
def HasEigenvalueLowerBound (H : State →ₗ[ℝ] State) : Prop :=
  ∃ C : ℝ, ∀ {lambda : ℝ} {x : State}, x ≠ 0 → H x = lambda • x → C ≤ lambda

/-- In this diagonal algebraic model, a potential bounded above cannot compensate the negative
unbounded sequence of kinetic coefficients. -/
theorem not_hasEigenvalueLowerBound_of_potential_boundedAbove
    (v : ℕ → ℝ) (M : ℝ) (hv : ∀ n, v n ≤ M) :
    ¬HasEigenvalueLowerBound (paperHamiltonian v) := by
  rintro ⟨C, hC⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (M - C)
  have hbound : C ≤ eigenvalue v n :=
    hC (x := basis n) (lambda := eigenvalue v n) (basis_ne_zero n)
      (paperHamiltonian_basis v n)
  have hvn : v n ≤ M := hv n
  dsimp [eigenvalue] at hbound
  linarith

/-- The same obstruction under the common stronger hypothesis `|v n| ≤ M`. -/
theorem not_hasEigenvalueLowerBound_of_potential_abs_bounded
    (v : ℕ → ℝ) (M : ℝ) (hv : ∀ n, |v n| ≤ M) :
    ¬HasEigenvalueLowerBound (paperHamiltonian v) := by
  apply not_hasEigenvalueLowerBound_of_potential_boundedAbove v M
  intro n
  exact (le_trans (le_abs_self (v n)) (hv n))

/-- In particular, every constant diagonal potential leaves `-Δ + V` unbounded below on its
explicit eigenvalue sequence. -/
theorem constantPotential_not_hasEigenvalueLowerBound (c : ℝ) :
    ¬HasEigenvalueLowerBound (paperHamiltonian (fun _ => c)) := by
  apply not_hasEigenvalueLowerBound_of_potential_boundedAbove (fun _ => c) c
  intro n
  exact le_rfl

/-- Reversing the kinetic sign changes the displayed diagonal coefficient from `-n + v n` to
`n + v n`.  This identity isolates the corresponding sign correction within this algebraic
model only.
-/
def correctedHamiltonian (v : ℕ → ℝ) : State →ₗ[ℝ] State :=
  laplacian + potentialOperator v

@[simp]
theorem correctedHamiltonian_apply (v : ℕ → ℝ) (x : State) (n : ℕ) :
    correctedHamiltonian v x n = ((n : ℝ) + v n) * x n := by
  simp [correctedHamiltonian]
  ring

end QYM.InfiniteDiagonalHamiltonian


open Filter

/-!
# Spectral-direction audit for the diagonal sign model

The existing `QYM.InfiniteDiagonalHamiltonian` namespace constructs exact algebraic eigenpairs for
the displayed coefficients `-n + v n` and proves failure of a lower bound under a bounded-above
potential.  This file adds the asymptotic statement that is needed to audit Proposition 4.15,
Lemma 4.18, and Appendix Lemma A.2: for a constant potential the paper-sign eigenvalue sequence
tends to `-∞`, not `+∞`, and it has no least entry.  With the corrected kinetic sign, the same
constant-potential sequence starts at `c` and tends to `+∞`.

These are results about an explicit diagonal eigenvalue family.  They do not assert that the
paper's differential operator has this spectrum, compact resolvent, or a self-adjoint realization.
-/

namespace QYM.DiagonalSpectralDirectionNoGo

open QYM.InfiniteDiagonalHamiltonian

/-! ## Paper-sign constant-potential sequence -/

/-- The exact diagonal eigenvalue sequence for the paper sign and constant potential `c`. -/
def paperSignLevel (c : ℝ) (n : ℕ) : ℝ :=
  QYM.InfiniteDiagonalHamiltonian.eigenvalue (fun _ => c) n

@[simp]
theorem paperSignLevel_apply (c : ℝ) (n : ℕ) :
    paperSignLevel c n = -(n : ℝ) + c :=
  rfl

/-- The next displayed paper-sign eigenvalue is exactly one unit lower. -/
theorem paperSignLevel_succ (c : ℝ) (n : ℕ) :
    paperSignLevel c (n + 1) = paperSignLevel c n - 1 := by
  simp only [paperSignLevel_apply, Nat.cast_add, Nat.cast_one]
  ring

/-- Every displayed level has a strictly smaller displayed successor. -/
theorem paperSignLevel_succ_lt (c : ℝ) (n : ℕ) :
    paperSignLevel c (n + 1) < paperSignLevel c n := by
  rw [paperSignLevel_succ]
  linarith

/-- The displayed paper-sign family has no least indexed level. -/
theorem paperSignLevel_has_no_least_index (c : ℝ) :
    ¬ ∃ n : ℕ, ∀ m : ℕ, paperSignLevel c n ≤ paperSignLevel c m := by
  rintro ⟨n, hn⟩
  exact (not_lt_of_ge (hn (n + 1))) (paperSignLevel_succ_lt c n)

/-- Equivalent pointwise formulation: below every indexed level there is another one. -/
theorem paperSignLevel_exists_strictly_lower (c : ℝ) (n : ℕ) :
    ∃ m : ℕ, paperSignLevel c m < paperSignLevel c n :=
  ⟨n + 1, paperSignLevel_succ_lt c n⟩

/-- The paper-sign constant-potential eigenvalue sequence tends to negative infinity. -/
theorem paperSignLevel_tendsto_atBot (c : ℝ) :
    Tendsto (paperSignLevel c) atTop atBot := by
  have hcast : Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop
  have hneg : Tendsto (fun n : ℕ => -(n : ℝ)) atTop atBot :=
    tendsto_neg_atTop_atBot.comp hcast
  change Tendsto (fun n : ℕ => -(n : ℝ) + c) atTop atBot
  exact tendsto_atBot_add_const_right atTop c hneg

/-- Hence this exact sequence cannot also tend to positive infinity. -/
theorem paperSignLevel_not_tendsto_atTop (c : ℝ) :
    ¬ Tendsto (paperSignLevel c) atTop atTop :=
  (paperSignLevel_tendsto_atBot c).not_tendsto disjoint_atBot_atTop

/-- Explicit eventual version of the negative-infinity conclusion. -/
theorem paperSignLevel_eventually_lt (c threshold : ℝ) :
    ∀ᶠ n in atTop, paperSignLevel c n < threshold :=
  (paperSignLevel_tendsto_atBot c).eventually (eventually_lt_atBot threshold)

/-- Every real threshold is crossed by some displayed paper-sign eigenvalue. -/
theorem exists_paperSignLevel_lt (c threshold : ℝ) :
    ∃ n : ℕ, paperSignLevel c n < threshold :=
  (paperSignLevel_eventually_lt c threshold).exists

/-! ## Corrected-sign constant-potential sequence -/

/-- The corrected diagonal coefficients for a constant potential. -/
def correctedSignLevel (c : ℝ) (n : ℕ) : ℝ :=
  (n : ℝ) + c

@[simp]
theorem correctedSignLevel_zero (c : ℝ) :
    correctedSignLevel c 0 = c := by
  simp [correctedSignLevel]

/-- Every corrected-sign level is bounded below by the zeroth level. -/
theorem correctedSignLevel_zero_le (c : ℝ) (n : ℕ) :
    correctedSignLevel c 0 ≤ correctedSignLevel c n := by
  simp only [correctedSignLevel, Nat.cast_zero, zero_add]
  exact le_add_of_nonneg_left (Nat.cast_nonneg n)

/-- The next corrected-sign eigenvalue is exactly one unit higher. -/
theorem correctedSignLevel_succ (c : ℝ) (n : ℕ) :
    correctedSignLevel c (n + 1) = correctedSignLevel c n + 1 := by
  simp only [correctedSignLevel, Nat.cast_add, Nat.cast_one]
  ring

/-- The corrected constant-potential sequence tends to positive infinity. -/
theorem correctedSignLevel_tendsto_atTop (c : ℝ) :
    Tendsto (correctedSignLevel c) atTop atTop := by
  change Tendsto (fun n : ℕ => (n : ℝ) + c) atTop atTop
  exact tendsto_atTop_add_const_right atTop c
    (tendsto_natCast_atTop_atTop :
      Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop)

/-- The two sign choices therefore have opposite asymptotic directions. -/
theorem opposite_spectral_directions (c : ℝ) :
    Tendsto (paperSignLevel c) atTop atBot ∧
      Tendsto (correctedSignLevel c) atTop atTop :=
  ⟨paperSignLevel_tendsto_atBot c, correctedSignLevel_tendsto_atTop c⟩

end QYM.DiagonalSpectralDirectionNoGo




