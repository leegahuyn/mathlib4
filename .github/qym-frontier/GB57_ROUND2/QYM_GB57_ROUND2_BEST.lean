theorem quotientNamedCuspHorocycleMeasure_univ
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    quotientNamedCuspHorocycleMeasure kappa Y Set.univ =
      ENNReal.ofReal (2 / Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) := by
  rw [quotientNamedCuspHorocycleMeasure,
    Measure.map_apply gammaTwoQuotientMk_measurable MeasurableSet.univ,
    Set.preimage_univ,
    namedCuspHorocycleMeasure_univ kappa Y]

theorem quotientNamedCuspHorocycleMeasure_compl_image
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    quotientNamedCuspHorocycleMeasure kappa Y
        (quotientNamedCuspHorocycleImage kappa Y)ᶜ = 0 := by
  rw [quotientNamedCuspHorocycleMeasure,
    Measure.map_apply gammaTwoQuotientMk_measurable
      (quotientNamedCuspHorocycleImage_isClosed
        kappa Y).measurableSet.compl]
  apply measure_mono_null
    (μ := namedCuspHorocycleMeasure kappa Y)
    (t := (namedCuspHorocycleImage kappa Y)ᶜ)
  · intro z hz hzImage
    exact hz ⟨z, hzImage, rfl⟩
  · exact namedCuspHorocycleMeasure_compl_image kappa Y

/-- Uniform three-cusp endpoint for the actual parametrized boundary
measures.  Identifying these supports with the three components of
`frontier (XSet Y)` is kept separate and consumes the exact-boundary
theorem. -/
theorem quotientNamedCuspHorocycleMeasureCertificate
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsCompact (quotientNamedCuspHorocycleImage kappa Y) ∧
