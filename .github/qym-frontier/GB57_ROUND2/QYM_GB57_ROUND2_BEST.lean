namespace QYM.FullCertification.P3InverseEtaQuotientBundleExtension









/-!
# P3: the concrete inverse-eta quotient line bundle

Mock2 already constructs the genuine `Gamma(2)` action on `H × C`, its orbit
quotient, and its projection to `Gamma(2) \ H`.  The preceding QYM producers
specialize that construction to the exact inverse-eta automorphy factor and
prove its Hermitian transition law.  This producer does not replace any of
those objects.

The additional point proved here is that this particular associated line
bundle has a canonical global trivialization.  The invariant coordinate is

`(tau, z) |-> eta(tau) * z`,

and its inverse over `[tau]` sends `c` to `[tau, eta(tau)^(-1) * c]`.
The nowhere-vanishing theorem for eta makes both inverse identities exact.
Consequently the actual quotient fibre is a one-dimensional complex module,
the inverse-eta Hermitian pairing descends, and arbitrary covariant scalar
lifts are equivalent to actual sections of the quotient projection.

No smooth vector-bundle structure is inserted as an assumption.  A final
predicate at the end isolates only the atlas-level smoothness statement; the
algebraic and topological trivializations themselves are constructed here.
-/

/-! ## 1. Exact specializations of the existing Mock2 quotient -/

/-- The upper half-plane used by the exact eta multiplier. -/
abbrev H := Mock2.Definition15Geometry.H

/-- The actual principal congruence subgroup `Gamma(2)`. -/
abbrev Gamma2 := Mock2.Definition15Geometry.Gamma2

/-- The literal orbit quotient `Gamma(2) \ H` from Mock2. -/
abbrev InverseEtaBase := Mock2.Definition15Geometry.X

/-- The exact inverse-eta multiplier already constructed by Mock2. -/
noncomputable abbrev inverseEtaMultiplier := QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaMultiplier

/-- The actual orbit-quotient total space of the inverse-eta line. -/
noncomputable abbrev InverseEtaTotal := QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.EtaAutomorphicLineBundle.Total

/-- Re-expose the topology already carried by the concrete orbit quotient.
This does not choose a new topology: it unfolds the stored bundle carrier to
the exact `Quotient (lineOrbitRel inverseEtaMultiplier)` representation and
uses Mathlib's existing quotient instance. -/
noncomputable instance inverseEtaTotalTopologicalSpace :
    TopologicalSpace InverseEtaTotal := by
  change TopologicalSpace
    (Quotient (Mock2.Definition15Geometry.lineOrbitRel inverseEtaMultiplier))
  infer_instance

/-- The total space carries its Borel measurable structure from the proved
quotient topology.  This lets continuity of the explicit global
trivialization provide the measurable maps used by the stage `L²` model. -/
noncomputable instance inverseEtaTotalMeasurableSpace :
    MeasurableSpace InverseEtaTotal :=
  borel InverseEtaTotal

noncomputable instance inverseEtaTotalBorelSpace :
    BorelSpace InverseEtaTotal :=
  ⟨rfl⟩

/-- Open subsets of the raw `Gamma(2)` orbit quotient are measurable for its
existing coinduced quotient measurable structure. -/
noncomputable instance inverseEtaBaseOpensMeasurableSpace :
    OpensMeasurableSpace InverseEtaBase := by
  rw [opensMeasurableSpace_iff_forall_measurableSet]
  intro t ht
  rw [QYM.FullCertification.Mock2EtaQuotientMeasureExtension.measurableSet_gamma2Quotient_iff]
  exact
    (ht.preimage
      QYM.FullCertification.Mock2EtaQuotientMeasureExtension.quotientMap_continuous).measurableSet

/-- The already constructed projection of the quotient total space. -/
/-- The already constructed projection of the quotient total space. -/
noncomputable abbrev inverseEtaProjection :
    InverseEtaTotal -> InverseEtaBase :=
  QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.EtaAutomorphicLineBundle.projection

/-- The actual fibre over a quotient point.  It is written as the
literal projection subtype so that topology and other subtype instances are
visible to typeclass synthesis without unfolding an opaque bundle-field
definition. -/
noncomputable abbrev InverseEtaFibre (x : InverseEtaBase) :=
  {z : InverseEtaTotal // inverseEtaProjection z = x}

/-- The quotient class of an upstairs point and a local fibre coordinate. -/
noncomputable def inverseEtaTotalMk (tau : H) (z : ℂ) : InverseEtaTotal :=
  Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier (tau, z)

@[simp] theorem inverseEtaProjection_mk (tau : H) (z : ℂ) :
    inverseEtaProjection (inverseEtaTotalMk tau z) =
      Mock2.Definition15Geometry.quotientMap tau := by
  rfl

/-- Mock2's quotient constructor identifies every point with its exact
inverse-eta line action translate. -/
@[simp] theorem inverseEtaTotalMk_lineSmul
    (gamma : Gamma2) (p : H × ℂ) :
    Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (Mock2.Definition15Geometry.lineSmul inverseEtaMultiplier gamma p) =
      Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier p :=
  Mock2.Definition15Geometry.lineBundleMk_lineSmul
    inverseEtaMultiplier gamma p

/-! ## 2. The invariant eta coordinate -/

/-- Multiplication by eta cancels the exact inverse-eta transition. -/
theorem eta_coordinate_transport
    (gamma : Gamma2) (tau : H) (z : ℂ) :
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue (gamma • tau) *
        (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor gamma tau * z) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z := by
  rw [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor_eq_etaRatio]
  simp only [Mock2.Definition15Geometry.EtaHalfWeight.etaRatio]
  field_simp [Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero]
  <;> ring

/-- The eta-trivialized coordinate before taking the orbit quotient. -/
noncomputable def etaTrivializedCoordinateUpstairs (p : H × ℂ) : ℂ :=
  Mock2.Definition15Geometry.EtaHalfWeight.etaValue p.1 * p.2

/-- The eta coordinate is invariant under the genuine line action. -/
theorem etaTrivializedCoordinateUpstairs_lineSmul
    (gamma : Gamma2) (p : H × ℂ) :
    etaTrivializedCoordinateUpstairs
        (Mock2.Definition15Geometry.lineSmul
          inverseEtaMultiplier gamma p) =
      etaTrivializedCoordinateUpstairs p := by
  rcases p with ⟨tau, z⟩
  simpa only [etaTrivializedCoordinateUpstairs,
    Mock2.Definition15Geometry.lineSmul,
    QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor] using
      eta_coordinate_transport gamma tau z

/-- The invariant eta coordinate respects the exact orbit relation used by
the total-space quotient. -/
theorem etaTrivializedCoordinateUpstairs_respects_lineOrbit
    (p q : H × ℂ)
    (hpq : Mock2.Definition15Geometry.lineOrbitRel
      inverseEtaMultiplier p q) :
    etaTrivializedCoordinateUpstairs p =
      etaTrivializedCoordinateUpstairs q := by
  letI : MulAction Gamma2 (H × ℂ) :=
    Mock2.Definition15Geometry.lineMulAction inverseEtaMultiplier
  change p ∈ MulAction.orbit Gamma2 q at hpq
  rcases hpq with ⟨gamma, hgamma⟩
  rw [← hgamma]
  exact etaTrivializedCoordinateUpstairs_lineSmul gamma q

/-- The global eta coordinate on the actual quotient total space. -/
noncomputable def etaTrivializedCoordinate : InverseEtaTotal -> ℂ :=
  Quotient.lift etaTrivializedCoordinateUpstairs
    etaTrivializedCoordinateUpstairs_respects_lineOrbit

@[simp] theorem etaTrivializedCoordinate_mk (tau : H) (z : ℂ) :
    etaTrivializedCoordinate (inverseEtaTotalMk tau z) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z := by
  rfl

/-- The upstairs invariant coordinate is continuous. -/
theorem etaTrivializedCoordinateUpstairs_continuous :
    Continuous etaTrivializedCoordinateUpstairs := by
  exact
    (Mock2.Definition15Geometry.EtaHalfWeight.etaValue_contMDiff.continuous.comp continuous_fst).mul continuous_snd

/-- Hence the descended coordinate is continuous for the quotient topology. -/
theorem etaTrivializedCoordinate_continuous :
    Continuous etaTrivializedCoordinate :=
  etaTrivializedCoordinateUpstairs_continuous.quotient_lift
    etaTrivializedCoordinateUpstairs_respects_lineOrbit

/-! ## 3. Reconstruction from a base point and one complex coordinate -/

/-- The scaled inverse-eta graph is carried to itself by the exact line
action. -/
theorem inverseEtaScaled_lineSmul
    (gamma : Gamma2) (tau : H) (c : ℂ) :
    Mock2.Definition15Geometry.lineSmul inverseEtaMultiplier gamma
        (tau, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c) =
      (gamma • tau, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection (gamma • tau) * c) := by
  apply Prod.ext
  · rfl
  · change
      QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor gamma tau *
          (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c) =
        QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection (gamma • tau) * c
    rw [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection_covariant gamma tau]
    ring

/-- The inverse-eta reconstruction respects the base orbit relation. -/
theorem inverseEtaScaledMk_respects_baseOrbit
    (c : ℂ) (tau sigma : H)
    (hts : MulAction.orbitRel Gamma2 H tau sigma) :
    inverseEtaTotalMk tau (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c) =
      inverseEtaTotalMk sigma (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection sigma * c) := by
  change tau ∈ MulAction.orbit Gamma2 sigma at hts
  rcases hts with ⟨gamma, hgamma⟩
  rw [← hgamma]
  change
    Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (gamma • sigma, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection (gamma • sigma) * c) =
      Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (sigma, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection sigma * c)
  rw [← inverseEtaScaled_lineSmul gamma sigma c]
  exact inverseEtaTotalMk_lineSmul gamma
    (sigma, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection sigma * c)

/-- Reconstruct a point of the quotient total space from a base orbit and its
eta-trivialized complex coordinate. -/
noncomputable def totalOfBaseScalar
    (x : InverseEtaBase) (c : ℂ) : InverseEtaTotal :=
  Quotient.lift
    (fun tau : H =>
      inverseEtaTotalMk tau (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c))
    (inverseEtaScaledMk_respects_baseOrbit c) x

@[simp] theorem totalOfBaseScalar_quotientMap (tau : H) (c : ℂ) :
    totalOfBaseScalar (Mock2.Definition15Geometry.quotientMap tau) c =
      inverseEtaTotalMk tau (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c) := by
  rfl

@[simp] theorem inverseEtaProjection_totalOfBaseScalar
    (x : InverseEtaBase) (c : ℂ) :
    inverseEtaProjection (totalOfBaseScalar x c) = x := by
  refine Quotient.inductionOn x ?_
  intro tau
  rfl

@[simp] theorem etaTrivializedCoordinate_totalOfBaseScalar
    (x : InverseEtaBase) (c : ℂ) :
    etaTrivializedCoordinate (totalOfBaseScalar x c) = c := by
  refine Quotient.inductionOn x ?_
  intro tau
  change
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * c) = c
  simp [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection, Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero, mul_assoc]

/-- Reconstruction from the projection and invariant coordinate returns the
original total-space point. -/
theorem totalOfBaseScalar_projection_coordinate (u : InverseEtaTotal) :
    totalOfBaseScalar (inverseEtaProjection u)
        (etaTrivializedCoordinate u) = u := by
  refine Quotient.inductionOn u ?_
  rintro ⟨tau, z⟩
  change
    Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (tau, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau * (Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z)) =
      Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier (tau, z)
  apply congrArg
    (Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier)
  apply Prod.ext
  · rfl
  · simp [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection, Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero, mul_assoc]

/-! ## 4. Global algebraic and topological trivialization -/

/-- The exact set-level trivialization of the actual quotient total space. -/
noncomputable def inverseEtaTotalTrivialization :
    InverseEtaTotal ≃ InverseEtaBase × ℂ where
  toFun u := (inverseEtaProjection u, etaTrivializedCoordinate u)
  invFun p := totalOfBaseScalar p.1 p.2
  left_inv := totalOfBaseScalar_projection_coordinate
  right_inv p := by
    rcases p with ⟨x, c⟩
    apply Prod.ext
    · exact inverseEtaProjection_totalOfBaseScalar x c
    · exact etaTrivializedCoordinate_totalOfBaseScalar x c

@[simp] theorem inverseEtaTotalTrivialization_apply
    (u : InverseEtaTotal) :
    inverseEtaTotalTrivialization u =
      (inverseEtaProjection u, etaTrivializedCoordinate u) :=
  rfl

@[simp] theorem inverseEtaTotalTrivialization_symm_apply
    (p : InverseEtaBase × ℂ) :
    inverseEtaTotalTrivialization.symm p =
      totalOfBaseScalar p.1 p.2 :=
  rfl

@[simp] theorem inverseEtaTotalTrivialization_mk
    (tau : H) (z : ℂ) :
    inverseEtaTotalTrivialization (inverseEtaTotalMk tau z) =
      (Mock2.Definition15Geometry.quotientMap tau,
        Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z) := by
  rfl

/-- Every arithmetic deck transformation is continuous after explicitly
viewing its matrix as an element of `GL(2, R)`.  This lemma avoids relying on
a nonexistent automatic `ContinuousConstSMul Gamma2 H` instance. -/
theorem inverseEtaDeckAction_continuous (gamma : Gamma2) :
    Continuous (fun tau : H => gamma • tau) := by
  change Continuous
    (fun tau : H =>
      ((((gamma : Gamma2) : SL(2, ℤ)) : GL (Fin 2) ℝ) • tau))
  exact
    continuous_const_smul
      ((((gamma : Gamma2) : SL(2, ℤ)) : GL (Fin 2) ℝ))

/-- The raw base quotient projection is an open quotient map. -/
theorem inverseEtaBaseQuotientMap_isOpenQuotientMap :
    IsOpenQuotientMap Mock2.Definition15Geometry.quotientMap := by
  letI : ContinuousConstSMul Gamma2 H :=
    { continuous_const_smul := inverseEtaDeckAction_continuous }
  letI : Setoid H := MulAction.orbitRel Gamma2 H
  change IsOpenQuotientMap
    (@Quotient.mk' H (MulAction.orbitRel Gamma2 H))
  exact
    ⟨Quotient.mk'_surjective, continuous_quotient_mk',
      isOpenMap_quotient_mk'_mul⟩

/-- The product of the base quotient map with the identity fibre coordinate
is again an open quotient map. -/
theorem inverseEtaBaseQuotientMap_prod_id_isOpenQuotientMap :
    IsOpenQuotientMap
      (fun p : H × ℂ =>
        (Mock2.Definition15Geometry.quotientMap p.1, p.2)) := by
  exact inverseEtaBaseQuotientMap_isOpenQuotientMap.prodMap
    IsOpenQuotientMap.id

/-- Joint continuity of reconstruction.  Openness of the orbit projection is
the key fact allowing the complex parameter to vary simultaneously. -/
theorem totalOfBaseScalar_continuous :
    Continuous
      (fun p : InverseEtaBase × ℂ => totalOfBaseScalar p.1 p.2) := by
  apply
    (inverseEtaBaseQuotientMap_prod_id_isOpenQuotientMap.isQuotientMap.continuous_iff).mpr
  change Continuous
    (fun p : H × ℂ =>
      inverseEtaTotalMk p.1 (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection p.1 * p.2))
  exact continuous_quotient_mk'.comp
    (continuous_fst.prodMk
      ((QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection_continuous.comp continuous_fst).mul
        continuous_snd))

/-- Continuity of the forward eta trivialization. -/
theorem inverseEtaTotalTrivialization_continuous :
    Continuous inverseEtaTotalTrivialization := by
  apply isQuotientMap_quotient_mk'.continuous_iff.mpr
  change Continuous
    (fun p : H × ℂ =>
      (Mock2.Definition15Geometry.quotientMap p.1,
        Mock2.Definition15Geometry.EtaHalfWeight.etaValue p.1 * p.2))
  exact
    (QYM.FullCertification.Mock2EtaQuotientMeasureExtension.quotientMap_continuous.comp continuous_fst).prodMk
      etaTrivializedCoordinateUpstairs_continuous

/-- The quotient line is globally homeomorphic, over its base, to the trivial
complex line bundle. -/
noncomputable def inverseEtaTotalTrivializationHomeomorph :
    InverseEtaTotal ≃ₜ InverseEtaBase × ℂ where
  toEquiv := inverseEtaTotalTrivialization
  continuous_toFun := inverseEtaTotalTrivialization_continuous
  continuous_invFun := totalOfBaseScalar_continuous

/-- The homeomorphism is fibre-preserving on the nose. -/
@[simp] theorem inverseEtaTotalTrivializationHomeomorph_fst
    (u : InverseEtaTotal) :
    (inverseEtaTotalTrivializationHomeomorph u).1 =
      inverseEtaProjection u :=
  rfl

/-- The actual quotient projection is a topologically trivial fibre bundle
with fibre `C`. -/
theorem inverseEta_isHomeomorphicTrivialFiberBundle :
    IsHomeomorphicTrivialFiberBundle ℂ inverseEtaProjection :=
  ⟨inverseEtaTotalTrivializationHomeomorph,
    inverseEtaTotalTrivializationHomeomorph_fst⟩

/-! ## 5. The actual quotient fibre as a one-dimensional complex module -/

/-- The invariant complex coordinate of a point in a fixed actual fibre. -/
noncomputable def inverseEtaFibreCoordinate
    {x : InverseEtaBase} (u : InverseEtaFibre x) : ℂ :=
  etaTrivializedCoordinate u.1

/-- Build a point of the actual fibre from its unique complex coordinate. -/
noncomputable def inverseEtaFibreOfCoordinate
    (x : InverseEtaBase) (c : ℂ) : InverseEtaFibre x :=
  ⟨totalOfBaseScalar x c,
    inverseEtaProjection_totalOfBaseScalar x c⟩

@[simp] theorem inverseEtaFibreCoordinate_ofCoordinate
    (x : InverseEtaBase) (c : ℂ) :
    inverseEtaFibreCoordinate (inverseEtaFibreOfCoordinate x c) = c :=
  etaTrivializedCoordinate_totalOfBaseScalar x c

@[simp] theorem inverseEtaFibreOfCoordinate_coordinate
    (x : InverseEtaBase) (u : InverseEtaFibre x) :
    inverseEtaFibreOfCoordinate x (inverseEtaFibreCoordinate u) = u := by
  apply Subtype.ext
  change totalOfBaseScalar x (etaTrivializedCoordinate u.1) = u.1
  calc
    _ = totalOfBaseScalar (inverseEtaProjection u.1)
          (etaTrivializedCoordinate u.1) :=
      congrArg
        (fun y : InverseEtaBase =>
          totalOfBaseScalar y (etaTrivializedCoordinate u.1))
        u.2.symm
    _ = u.1 := totalOfBaseScalar_projection_coordinate u.1

/-- Every actual quotient fibre is canonically equivalent to `C`. -/
/-- Every actual quotient fibre is canonically equivalent to `C`. -/
noncomputable def inverseEtaFibreCoordinateEquiv (x : InverseEtaBase) :
    InverseEtaFibre x ≃ ℂ where
  toFun := inverseEtaFibreCoordinate
  invFun := inverseEtaFibreOfCoordinate x
  left_inv := inverseEtaFibreOfCoordinate_coordinate x
  right_inv := inverseEtaFibreCoordinate_ofCoordinate x

/-- The fibre coordinate is continuous for the actual quotient-subspace
topology. -/
theorem inverseEtaFibreCoordinate_continuous (x : InverseEtaBase) :
    Continuous (inverseEtaFibreCoordinate (x := x)) := by
  change Continuous
    (fun u : {z : InverseEtaTotal // inverseEtaProjection z = x} =>
      etaTrivializedCoordinate u.1)
  exact etaTrivializedCoordinate_continuous.comp continuous_subtype_val

/-- Reconstruction of one fixed fibre is continuous. -/
theorem inverseEtaFibreOfCoordinate_continuous (x : InverseEtaBase) :
    Continuous (inverseEtaFibreOfCoordinate x) := by
  have hTotal := totalOfBaseScalar_continuous.comp
    (continuous_const.prodMk continuous_id)
  change Continuous (fun c : ℂ => totalOfBaseScalar x c) at hTotal
  change Continuous
    (fun c : ℂ =>
      (⟨totalOfBaseScalar x c,
        inverseEtaProjection_totalOfBaseScalar x c⟩ :
        {z : InverseEtaTotal // inverseEtaProjection z = x}))
  exact hTotal.subtype_mk
    (fun c => inverseEtaProjection_totalOfBaseScalar x c)

/-- Each actual quotient fibre is homeomorphic to the standard complex line,
/-- Each actual quotient fibre is homeomorphic to the standard complex line,
not merely in bijection with it. -/
noncomputable def inverseEtaFibreCoordinateHomeomorph
    (x : InverseEtaBase) : InverseEtaFibre x ≃ₜ ℂ where
  toEquiv := inverseEtaFibreCoordinateEquiv x
  continuous_toFun := inverseEtaFibreCoordinate_continuous x
  continuous_invFun := inverseEtaFibreOfCoordinate_continuous x

/-- Transport the additive complex-line structure to the actual quotient
fibre along the proved coordinate equivalence. -/
noncomputable instance inverseEtaFibreAddCommGroup (x : InverseEtaBase) :
    AddCommGroup (InverseEtaFibre x) :=
  (inverseEtaFibreCoordinateEquiv x).addCommGroup

/-- Transport complex scalar multiplication to the actual quotient fibre. -/
noncomputable instance inverseEtaFibreModule (x : InverseEtaBase) :
    Module ℂ (InverseEtaFibre x) :=
  Equiv.module ℂ (inverseEtaFibreCoordinateEquiv x)

/-- The coordinate equivalence is complex linear for the transported fibre
operations. -/
noncomputable def inverseEtaFibreCoordinateLinearEquiv
    (x : InverseEtaBase) : InverseEtaFibre x ≃ₗ[ℂ] ℂ :=
  (inverseEtaFibreCoordinateEquiv x).linearEquiv ℂ

@[simp] theorem inverseEtaFibreCoordinate_zero (x : InverseEtaBase) :
    inverseEtaFibreCoordinate (0 : InverseEtaFibre x) = 0 :=
  (inverseEtaFibreCoordinateLinearEquiv x).map_zero

@[simp] theorem inverseEtaFibreCoordinate_add
    {x : InverseEtaBase} (u v : InverseEtaFibre x) :
    inverseEtaFibreCoordinate (u + v) =
      inverseEtaFibreCoordinate u + inverseEtaFibreCoordinate v :=
  (inverseEtaFibreCoordinateLinearEquiv x).map_add u v

@[simp] theorem inverseEtaFibreCoordinate_neg
    {x : InverseEtaBase} (u : InverseEtaFibre x) :
    inverseEtaFibreCoordinate (-u) = -inverseEtaFibreCoordinate u :=
  (inverseEtaFibreCoordinateLinearEquiv x).map_neg u

@[simp] theorem inverseEtaFibreCoordinate_smul
    {x : InverseEtaBase} (c : ℂ) (u : InverseEtaFibre x) :
    inverseEtaFibreCoordinate (c • u) =
      c * inverseEtaFibreCoordinate u := by
  change
    (inverseEtaFibreCoordinateLinearEquiv x) (c • u) =
      c • (inverseEtaFibreCoordinateLinearEquiv x) u
  exact (inverseEtaFibreCoordinateLinearEquiv x).map_smul c u

/-- A local coordinate represented at an upstairs point, packaged as a point
of the corresponding actual quotient fibre. -/
noncomputable def inverseEtaFibreMk (tau : H) (z : ℂ) :
    InverseEtaFibre (Mock2.Definition15Geometry.quotientMap tau) :=
  ⟨inverseEtaTotalMk tau z, inverseEtaProjection_mk tau z⟩

@[simp] theorem inverseEtaFibreCoordinate_mk (tau : H) (z : ℂ) :
    inverseEtaFibreCoordinate (inverseEtaFibreMk tau z) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z := by
  rfl

@[simp] theorem inverseEtaFibreMk_zero (tau : H) :
    inverseEtaFibreMk tau 0 =
      (0 : InverseEtaFibre
        (Mock2.Definition15Geometry.quotientMap tau)) := by
  apply (inverseEtaFibreCoordinateEquiv _).injective
  change
    inverseEtaFibreCoordinate (inverseEtaFibreMk tau 0) =
      inverseEtaFibreCoordinate
        (0 : InverseEtaFibre
          (Mock2.Definition15Geometry.quotientMap tau))
  rw [inverseEtaFibreCoordinate_mk, inverseEtaFibreCoordinate_zero]
  ring

@[simp] theorem inverseEtaFibreMk_add
    (tau : H) (z w : ℂ) :
    inverseEtaFibreMk tau (z + w) =
      inverseEtaFibreMk tau z + inverseEtaFibreMk tau w := by
  apply (inverseEtaFibreCoordinateEquiv _).injective
  change
    inverseEtaFibreCoordinate (inverseEtaFibreMk tau (z + w)) =
      inverseEtaFibreCoordinate
        (inverseEtaFibreMk tau z + inverseEtaFibreMk tau w)
  rw [inverseEtaFibreCoordinate_mk,
    inverseEtaFibreCoordinate_add,
    inverseEtaFibreCoordinate_mk,
    inverseEtaFibreCoordinate_mk]
  ring

@[simp] theorem inverseEtaFibreMk_smul
    (tau : H) (c z : ℂ) :
    inverseEtaFibreMk tau (c * z) =
      c • inverseEtaFibreMk tau z := by
  apply (inverseEtaFibreCoordinateEquiv _).injective
  change
    inverseEtaFibreCoordinate (inverseEtaFibreMk tau (c * z)) =
      inverseEtaFibreCoordinate (c • inverseEtaFibreMk tau z)
  rw [inverseEtaFibreCoordinate_mk,
    inverseEtaFibreCoordinate_smul,
    inverseEtaFibreCoordinate_mk]
  ring

/-! ## 6. Descent of the exact inverse-eta Hermitian metric -/

/-- The descended Hermitian pairing on a fixed actual quotient fibre. -/
noncomputable def inverseEtaFibreHermitian
    {x : InverseEtaBase}
    (u v : InverseEtaFibre x) : ℂ :=
  ⟪inverseEtaFibreCoordinate u, inverseEtaFibreCoordinate v⟫_ℂ

/-- The descended pairing pulls back exactly to the base-dependent metric
already constructed in P1. -/
@[simp] theorem inverseEtaFibreHermitian_mk
    (tau : H) (z w : ℂ) :
    inverseEtaFibreHermitian
        (inverseEtaFibreMk tau z) (inverseEtaFibreMk tau w) =
      QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaHermitianMetricData.pairing tau z w := by
  rw [inverseEtaFibreHermitian,
    inverseEtaFibreCoordinate_mk, inverseEtaFibreCoordinate_mk,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaHermitianMetricData_pairing]

/-- Conjugate symmetry of the descended pairing. -/
theorem inverseEtaFibreHermitian_conj_symm
    {x : InverseEtaBase} (u v : InverseEtaFibre x) :
    conj (inverseEtaFibreHermitian v u) =
      inverseEtaFibreHermitian u v := by
  exact inner_conj_symm _ _

/-- Additivity in the second argument. -/
theorem inverseEtaFibreHermitian_add_right
    {x : InverseEtaBase} (u v w : InverseEtaFibre x) :
    inverseEtaFibreHermitian u (v + w) =
      inverseEtaFibreHermitian u v +
        inverseEtaFibreHermitian u w := by
  simp only [inverseEtaFibreHermitian,
    inverseEtaFibreCoordinate_add, inner_add_right]

/-- Complex linearity in the second argument. -/
theorem inverseEtaFibreHermitian_smul_right
    {x : InverseEtaBase} (c : ℂ) (u v : InverseEtaFibre x) :
    inverseEtaFibreHermitian u (c • v) =
      c * inverseEtaFibreHermitian u v := by
  unfold inverseEtaFibreHermitian
  rw [inverseEtaFibreCoordinate_smul]
  change
    ⟪inverseEtaFibreCoordinate u,
      c • inverseEtaFibreCoordinate v⟫_ℂ =
      c • ⟪inverseEtaFibreCoordinate u,
        inverseEtaFibreCoordinate v⟫_ℂ
  simp only [inner_smul_right]
  simpa only [smul_eq_mul]

/-- The real part on the diagonal is the square of the descended norm. -/
theorem inverseEtaFibreHermitian_self_re
    {x : InverseEtaBase} (u : InverseEtaFibre x) :
    (inverseEtaFibreHermitian u u).re =
      ‖inverseEtaFibreCoordinate u‖ ^ 2 := by
  unfold inverseEtaFibreHermitian
  exact inner_self_eq_norm_sq (𝕜 := ℂ)
    (inverseEtaFibreCoordinate u)

/-- Positive definiteness on the actual quotient fibre. -/
theorem inverseEtaFibreHermitian_self_pos
    {x : InverseEtaBase} {u : InverseEtaFibre x} (hu : u ≠ 0) :
    0 < (inverseEtaFibreHermitian u u).re := by
  rw [inverseEtaFibreHermitian_self_re]
  have hCoordinate : inverseEtaFibreCoordinate u ≠ 0 := by
    intro hZero
    apply hu
    apply (inverseEtaFibreCoordinateEquiv x).injective
    change
      inverseEtaFibreCoordinate u =
        inverseEtaFibreCoordinate (0 : InverseEtaFibre x)
    rw [hZero, inverseEtaFibreCoordinate_zero]
  exact pow_pos (norm_pos_iff.mpr hCoordinate) 2

/-- The Hermitian norm on the actual quotient total space. -/
noncomputable def inverseEtaTotalHermitianNorm
    (u : InverseEtaTotal) : ℝ :=
  ‖etaTrivializedCoordinate u‖

@[simp] theorem inverseEtaTotalHermitianNorm_mk
    (tau : H) (z : ℂ) :
    inverseEtaTotalHermitianNorm (inverseEtaTotalMk tau z) =
      ‖Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z‖ := by
  rfl

/-- The same norm restricted to one actual quotient fibre. -/
noncomputable def inverseEtaFibreHermitianNorm
    {x : InverseEtaBase} (u : InverseEtaFibre x) : ℝ :=
  ‖inverseEtaFibreCoordinate u‖

theorem inverseEtaFibreHermitian_self_eq_norm_sq
    {x : InverseEtaBase} (u : InverseEtaFibre x) :
    (inverseEtaFibreHermitian u u).re =
      inverseEtaFibreHermitianNorm u ^ 2 :=
  by
    simpa only [inverseEtaFibreHermitianNorm] using
      inverseEtaFibreHermitian_self_re u

/-! ## 7. Covariant scalar lifts are exactly quotient sections -/

/-- All inverse-eta-covariant scalar lifts, with their actual pointwise
complex-module structure. -/
noncomputable def etaCovariantLiftModule : Submodule ℂ (H -> ℂ) where
  carrier := QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.EtaCovariant
  zero_mem' := by
    intro gamma tau
    simp [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor]
  add_mem' := by
    intro f g hf hg gamma tau
    change
      f (gamma • tau) + g (gamma • tau) =
        QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor gamma tau * (f tau + g tau)
    rw [hf gamma tau, hg gamma tau, mul_add]
  smul_mem' := by
    intro c f hf gamma tau
    change
      c * f (gamma • tau) =
        QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor gamma tau * (c * f tau)
    rw [hf gamma tau]
    ring

/-- A scalar lift satisfying the exact inverse-eta covariance law. -/
abbrev EtaCovariantLift := etaCovariantLiftModule

/-- An actual section of the quotient projection.  The section law is a
proved field about a function into the already constructed quotient total
space; no local coordinate is stored. -/
structure InverseEtaQuotientSection where
  toFun : InverseEtaBase -> InverseEtaTotal
  projection_toFun :
    ∀ x : InverseEtaBase, inverseEtaProjection (toFun x) = x

namespace InverseEtaQuotientSection

instance : CoeFun InverseEtaQuotientSection
    (fun _ => InverseEtaBase -> InverseEtaTotal) :=
  ⟨InverseEtaQuotientSection.toFun⟩

@[ext] theorem ext {s t : InverseEtaQuotientSection}
    (h : ∀ x : InverseEtaBase, s x = t x) : s = t := by
  cases s with
  | mk sf hs =>
      cases t with
      | mk tf ht =>
          have hfun : sf = tf := funext h
          cases hfun
          rfl

end InverseEtaQuotientSection

/-- The upstairs total-space lift associated to a covariant scalar. -/
noncomputable def covariantTotalLift
    (f : EtaCovariantLift) (tau : H) : InverseEtaTotal :=
  inverseEtaTotalMk tau ((f : H -> ℂ) tau)

/-- Exact invariance of the total-space lift. -/
theorem covariantTotalLift_invariant
    (f : EtaCovariantLift) (gamma : Gamma2) (tau : H) :
    covariantTotalLift f (gamma • tau) = covariantTotalLift f tau := by
  have hPair :
      (gamma • tau, (f : H -> ℂ) (gamma • tau)) =
        Mock2.Definition15Geometry.lineSmul inverseEtaMultiplier gamma
          (tau, (f : H -> ℂ) tau) := by
    apply Prod.ext
    · rfl
    · exact f.2 gamma tau
  change
    inverseEtaTotalMk (gamma • tau) ((f : H -> ℂ) (gamma • tau)) =
      inverseEtaTotalMk tau ((f : H -> ℂ) tau)
  change
    Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (gamma • tau, (f : H -> ℂ) (gamma • tau)) =
      Mock2.Definition15Geometry.lineBundleMk inverseEtaMultiplier
        (tau, (f : H -> ℂ) tau)
  rw [hPair]
  exact inverseEtaTotalMk_lineSmul gamma (tau, (f : H -> ℂ) tau)

/-- Descent of a covariant lift to a quotient-total-space-valued function. -/
noncomputable def covariantToSectionFun
    (f : EtaCovariantLift) : InverseEtaBase -> InverseEtaTotal := by
  refine Quotient.lift (covariantTotalLift f) ?_
  intro tau sigma hts
  change tau ∈ MulAction.orbit Gamma2 sigma at hts
  rcases hts with ⟨gamma, hgamma⟩
  rw [← hgamma]
  exact covariantTotalLift_invariant f gamma sigma

@[simp] theorem covariantToSectionFun_quotientMap
    (f : EtaCovariantLift) (tau : H) :
    covariantToSectionFun f
        (Mock2.Definition15Geometry.quotientMap tau) =
      inverseEtaTotalMk tau ((f : H -> ℂ) tau) := by
  rfl

/-- Every exact covariant scalar lift defines an actual quotient section. -/
noncomputable def covariantToSection
    (f : EtaCovariantLift) : InverseEtaQuotientSection where
  toFun := covariantToSectionFun f
  projection_toFun x := by
    refine Quotient.inductionOn x ?_
    intro tau
    rfl

@[simp] theorem covariantToSection_quotientMap
    (f : EtaCovariantLift) (tau : H) :
    covariantToSection f
        (Mock2.Definition15Geometry.quotientMap tau) =
      inverseEtaTotalMk tau ((f : H -> ℂ) tau) := by
  rfl

/-- Read a covariant scalar lift from an actual quotient section using the
proved eta trivialization. -/
noncomputable def quotientSectionToCovariant
    (s : InverseEtaQuotientSection) : EtaCovariantLift := by
  refine ⟨fun tau : H =>
    QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
      etaTrivializedCoordinate
        (s (Mock2.Definition15Geometry.quotientMap tau)), ?_⟩
  intro gamma tau
  change
    QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection (gamma • tau) *
        etaTrivializedCoordinate
          (s (Mock2.Definition15Geometry.quotientMap (gamma • tau))) =
      QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.etaAutomorphyFactor gamma tau *
        (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
          etaTrivializedCoordinate
            (s (Mock2.Definition15Geometry.quotientMap tau)))
  rw [Mock2.Definition15Geometry.quotientMap_smul,
    QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection_covariant gamma tau]
  ring

@[simp] theorem quotientSectionToCovariant_apply
    (s : InverseEtaQuotientSection) (tau : H) :
    (quotientSectionToCovariant s : H -> ℂ) tau =
      QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
        etaTrivializedCoordinate
          (s (Mock2.Definition15Geometry.quotientMap tau)) := by
  rfl

/-- Pulling back the descended section recovers the original covariant lift. -/
@[simp] theorem quotientSectionToCovariant_covariantToSection
    (f : EtaCovariantLift) :
    quotientSectionToCovariant (covariantToSection f) = f := by
  apply Subtype.ext
  funext tau
  change
    QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
        etaTrivializedCoordinate
          (inverseEtaTotalMk tau ((f : H -> ℂ) tau)) =
      (f : H -> ℂ) tau
  rw [etaTrivializedCoordinate_mk]
  simp [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection, Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero, mul_assoc]

/-- Descending the lift read from a quotient section recovers the original
section, including its actual quotient-total-space values. -/
@[simp] theorem covariantToSection_quotientSectionToCovariant
    (s : InverseEtaQuotientSection) :
    covariantToSection (quotientSectionToCovariant s) = s := by
  apply InverseEtaQuotientSection.ext
  intro x
  refine Quotient.inductionOn x ?_
  intro tau
  change
    inverseEtaTotalMk tau
        (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
          etaTrivializedCoordinate
            (s (Mock2.Definition15Geometry.quotientMap tau))) =
      s (Mock2.Definition15Geometry.quotientMap tau)
  calc
    inverseEtaTotalMk tau
          (QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau *
            etaTrivializedCoordinate
              (s (Mock2.Definition15Geometry.quotientMap tau))) =
        totalOfBaseScalar
          (Mock2.Definition15Geometry.quotientMap tau)
          (etaTrivializedCoordinate
            (s (Mock2.Definition15Geometry.quotientMap tau))) := by
      rfl
    _ = totalOfBaseScalar
          (inverseEtaProjection
            (s (Mock2.Definition15Geometry.quotientMap tau)))
          (etaTrivializedCoordinate
            (s (Mock2.Definition15Geometry.quotientMap tau))) := by
      rw [s.projection_toFun]
    _ = s (Mock2.Definition15Geometry.quotientMap tau) :=
      totalOfBaseScalar_projection_coordinate _

/-- Exact equivalence between covariant scalar lifts and genuine quotient
sections. -/
noncomputable def etaCovariantLiftEquivQuotientSection :
    EtaCovariantLift ≃ InverseEtaQuotientSection where
  toFun := covariantToSection
  invFun := quotientSectionToCovariant
  left_inv := quotientSectionToCovariant_covariantToSection
  right_inv := covariantToSection_quotientSectionToCovariant

/-! ## 8. The distinguished inverse-eta section in both presentations -/

/-- The nowhere-zero inverse-eta scalar as an element of the full covariant
lift module. -/
noncomputable def distinguishedInverseEtaLift : EtaCovariantLift :=
  ⟨QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection, QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection_covariant⟩

/-- The general descent map specializes to the previously constructed
descended inverse-eta bundle section. -/
theorem covariantToSection_distinguished_toFun :
    (covariantToSection distinguishedInverseEtaLift).toFun =
      QYM.FullCertification.Mock2EtaQuotientMeasureExtension.descendedInverseEtaBundleSection := by
  funext x
  refine Quotient.inductionOn x ?_
  intro tau
  rfl

/-- In eta coordinates the distinguished inverse-eta section is exactly the
constant section `1`. -/
@[simp] theorem distinguishedInverseEtaSection_coordinate
    (x : InverseEtaBase) :
    etaTrivializedCoordinate
        (covariantToSection distinguishedInverseEtaLift x) = 1 := by
  obtain ⟨tau, rfl⟩ := QYM.FullCertification.Mock2EtaQuotientMeasureExtension.quotientMap_surjective x
  change Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection tau = 1
  simp [QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.inverseEtaSection, Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero]

/-- Its descended Hermitian norm is one in every fibre. -/
@[simp] theorem distinguishedInverseEtaSection_norm
    (x : InverseEtaBase) :
    inverseEtaTotalHermitianNorm
        (covariantToSection distinguishedInverseEtaLift x) = 1 := by
  rw [inverseEtaTotalHermitianNorm,
    distinguishedInverseEtaSection_coordinate, norm_one]

/-! ## 9. Aggregate theorem and the exact remaining smooth-atlas statement -/

/-- The algebraic and topological quotient-bundle endpoint.  Every conjunct
is a theorem about the concrete inverse-eta quotient; none is a supplier field.
-/
theorem inverseEtaQuotientBundleCertificate :
    IsHomeomorphicTrivialFiberBundle ℂ inverseEtaProjection ∧
      (∀ x : InverseEtaBase,
        Function.Bijective
          (inverseEtaFibreCoordinate (x := x))) ∧
      Function.Bijective covariantToSection ∧
      (∀ (tau : H) (z w : ℂ),
        inverseEtaFibreHermitian
            (inverseEtaFibreMk tau z) (inverseEtaFibreMk tau w) =
          QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaHermitianMetricData.pairing tau z w) := by
  refine
    ⟨inverseEta_isHomeomorphicTrivialFiberBundle,
      ?_, etaCovariantLiftEquivQuotientSection.bijective, ?_⟩
  · intro x
    exact (inverseEtaFibreCoordinateEquiv x).bijective
  · intro tau z w
    exact inverseEtaFibreHermitian_mk tau z w

/-- The sole atlas-level statement not claimed by the preceding certificate.
It asks that the already constructed global homeomorphism and its inverse be
smooth for chosen two-complex-dimensional charts on the total space and the
product.  This predicate contains no assertion of its own and is not used as
a field of any bundle datum. -/
def InverseEtaSmoothGlobalTrivializationResidual
    [ChartedSpace ℂ InverseEtaBase]
    [ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal] : Prop :=
  ContMDiff (𝓘(ℂ).prod 𝓘(ℂ)) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      inverseEtaTotalTrivializationHomeomorph ∧
    ContMDiff (𝓘(ℂ).prod 𝓘(ℂ)) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      inverseEtaTotalTrivializationHomeomorph.symm

end QYM.FullCertification.P3InverseEtaQuotientBundleExtension

