/-! ## 2. Exact resolvent error of the actual cutoff surrogate -/

abbrev ActualGlobalL2 := QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.ActualGlobalL2

/-! ### A concrete nonzero vector beyond every natural stage -/

/-- An open cusp band lying above the `n`-th natural stage and inside the
next compact stage. -/
def actualCutoffEscapeOpenSet (n : ℕ) : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  interior
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff n + 1)) \
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet n

theorem actualCutoffEscapeOpenSet_isOpen (n : ℕ) :
    IsOpen (actualCutoffEscapeOpenSet n) := by
  apply isOpen_interior.sdiff
  simpa [QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet] using
    QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff n)

/-- The open escape band is nonempty.  A selected cusp-cylinder point at
height `Y_n + 1/2` lies in it. -/
theorem actualCutoffEscapeOpenSet_nonempty
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    (actualCutoffEscapeOpenSet n).Nonempty := by
  let Y0 : ℝ := QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff n
  have hY0 : 2 ≤ Y0 := by
    dsimp [Y0, QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff]
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hLevel0 : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y0 = Y0 :=
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel_of_one_le (le_trans (by norm_num) hY0)
  have hSmall : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y0 := by
    rw [hLevel0]
    exact hY0
  have hBig : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel (Y0 + 1) := by
    rw [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel_of_one_le (by linarith : 1 ≤ Y0 + 1)]
    linarith
  let h : QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight :=
    ⟨Y0 + 1 / 2, by
      change 1 < Y0 + (1 / 2 : ℝ)
      linarith [hY0]⟩
  let p : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight := (0, h)
  let x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient := QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p
  refine ⟨x, ?_⟩
  change
    x ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff n + 1)) ∧
      x ∉ QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet n
  have hY0Def : QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageCutoff n = Y0 := rfl
  constructor
  · have hpBig : p.2.1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel (Y0 + 1) := by
      dsimp [p, h]
      rw [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel_of_one_le (by linarith : 1 ≤ Y0 + 1)]
      linarith
    simpa only [x, hY0Def] using
      (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.cuspCylinderMap_mem_interior_XSet_iff_height_lt
        q hBig p).2 hpBig
  · intro hx
    have hxSmall : QYM.FullCertification.P2CuspCollarClosureExtension.cuspCylinderMap q p ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y0 := by
      simpa only [x, QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet,
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet_apply, hY0Def] using hx
    have hpSmall :=
      (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.cuspCylinderMap_mem_XSet_iff_height_le
        q hSmall p).1 hxSmall
    dsimp [p, h] at hpSmall
    rw [hLevel0] at hpSmall
    linarith

theorem actualCutoffEscapeOpenSet_measure_lt_top (n : ℕ) :
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.actualGlobalQuotientMeasure
        (actualCutoffEscapeOpenSet n) < (∞ : ℝ≥0∞) := by
