/-!
# A closed spectral-coordinate H1/Rellich/Hamiltonian model

This producer closes the operator-theoretic chain on a literal two-mode complex
Hilbert space.  It is deliberately called a *spectral-coordinate model*: it is
not identified with the paper's geometric covariant derivative on the
truncated modular quotient.

The declarations below contain no compactness, self-adjointness, or spectral
gap field in an input structure.  We define the carrier, derivative, graph
domain, embedding, potential, and form.  Compactness follows from actual finite
dimensionality; self-adjointness and compact resolvent follow from the already
proved RCLike Friedrichs API; and the complete ground/off-ground blocks are
computed from a rank-one orthogonal projection.

The last section is a semantic firewall.  It reuses the proved
infinite-dimensionality of the actual Petersson L2 carrier to show that no
bounded endomorphism on that carrier can be substituted for the missing
geometric unbounded Hamiltonian while retaining compact resolvent.
-/


open Function Module Set
open scoped ComplexConjugate InnerProduct lp

namespace QYM.FullCertification.Mock3SpectralCoordinateH1RellichExtension










/-! ## 1. Literal two-mode L2 carrier and the rank-one ground projection -/

/-- The finite spectral-coordinate L2 carrier. -/
abbrev CoordinateL2 := EuclideanSpace ℂ (Fin 2)

/-- The distinguished normalized ground coordinate. -/
def groundVector : CoordinateL2 :=
  EuclideanSpace.single (0 : Fin 2) (1 : ℂ)

@[simp]
theorem groundVector_norm : ‖groundVector‖ = 1 := by
  simp [groundVector]

theorem groundVector_ne_zero : groundVector ≠ 0 := by
  exact norm_ne_zero_iff.mp (by simp)

/-- Orthogonal projection onto the complete ground line. -/
def groundProjection : CoordinateL2 →L[ℂ] CoordinateL2 :=
  InnerProductSpace.rankOne ℂ groundVector groundVector

@[simp]
theorem groundProjection_apply (u : CoordinateL2) :
    groundProjection u = inner ℂ groundVector u • groundVector := by
  exact InnerProductSpace.rankOne_apply _ _ _

theorem groundProjection_isIdempotent :
    IsIdempotentElem groundProjection := by
  exact InnerProductSpace.isIdempotentElem_rankOne_self groundVector_norm

theorem groundProjection_isSymmetricProjection :
    groundProjection.IsSymmetricProjection := by
  exact InnerProductSpace.isSymmetricProjection_rankOne_self groundVector_norm

theorem groundProjection_isSymmetric : groundProjection.IsSymmetric :=
  groundProjection_isSymmetricProjection.isSymmetric

@[simp]
theorem groundProjection_apply_apply (u : CoordinateL2) :
    groundProjection (groundProjection u) = groundProjection u := by
  exact DFunLike.congr_fun groundProjection_isIdempotent u

/-- The full ground block, not a selected nonzero eigenvector. -/
def GroundBlock : Submodule ℂ CoordinateL2 :=
  ℂ ∙ groundVector

/-- The complete orthogonal complement of the ground block. -/
def OffGroundBlock : Submodule ℂ CoordinateL2 :=
  GroundBlockᗮ

theorem groundProjection_range :
    groundProjection.toLinearMap.range = GroundBlock := by
  apply le_antisymm
  · rintro u ⟨v, rfl⟩
    change groundProjection v ∈ GroundBlock
    rw [groundProjection_apply]
    exact Submodule.smul_mem _ _
      (Submodule.mem_span_singleton_self groundVector)
  · intro u hu
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hu
    refine ⟨c • groundVector, ?_⟩
    change groundProjection (c • groundVector) = c • groundVector
    rw [groundProjection_apply, inner_smul_right,
      inner_self_eq_norm_sq_to_K, groundVector_norm]
    simp

theorem groundProjection_ker :
    groundProjection.toLinearMap.ker = OffGroundBlock := by
  ext u
  change groundProjection u = 0 ↔ u ∈ OffGroundBlock
  rw [groundProjection_apply,
    smul_eq_zero_iff_left groundVector_ne_zero]
  change inner ℂ groundVector u = 0 ↔ u ∈ (ℂ ∙ groundVector)ᗮ
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right]

theorem ground_isCompl_offGround :
    IsCompl GroundBlock OffGroundBlock := by
  have h :=
    LinearMap.IsIdempotentElem.isCompl
      (ContinuousLinearMap.IsIdempotentElem.toLinearMap
        groundProjection_isIdempotent)
  rw [groundProjection_range, groundProjection_ker] at h
  exact h

/-! ## 2. A concrete covariant-coordinate derivative and an independent graph H1 -/

/-- The coordinate covariant derivative.  It kills the ground block and is the
identity on the complete off-ground block. -/
def covariantDerivative : CoordinateL2 →L[ℂ] CoordinateL2 :=
  1 - groundProjection

@[simp]
theorem covariantDerivative_apply (u : CoordinateL2) :
    covariantDerivative u = u - groundProjection u := by
  simp [covariantDerivative]

theorem covariantDerivative_isIdempotent :
    IsIdempotentElem covariantDerivative := by
  unfold covariantDerivative
  exact groundProjection_isIdempotent.one_sub

theorem covariantDerivative_isSymmetric :
    covariantDerivative.IsSymmetric := by
  intro u v
  change inner ℂ (covariantDerivative u) v =
    inner ℂ u (covariantDerivative v)
  rw [covariantDerivative_apply, covariantDerivative_apply,
    inner_sub_left, inner_sub_right]
  exact congrArg (fun z : ℂ => inner ℂ u v - z)
    (groundProjection_isSymmetric u v)

theorem covariantDerivative_isSelfAdjoint :
    IsSelfAdjoint covariantDerivative :=
  covariantDerivative_isSymmetric.isSelfAdjoint

@[simp]
theorem covariantDerivative_adjoint :
    covariantDerivative.adjoint = covariantDerivative :=
  covariantDerivative_isSelfAdjoint.adjoint_eq

@[simp]
theorem covariantDerivative_apply_apply (u : CoordinateL2) :
    covariantDerivative (covariantDerivative u) = covariantDerivative u := by
  exact DFunLike.congr_fun covariantDerivative_isIdempotent u

/-- The everywhere-defined partial-map presentation used by the graph-domain
API.  Its domain is definitionally generated from `top`; no domain premise is
stored in a structure. -/
def covariantDerivativePMap : CoordinateL2 →ₗ.[ℂ] CoordinateL2 :=
  covariantDerivative.toLinearMap.toPMap ⊤

@[simp]
theorem covariantDerivativePMap_domain :
    covariantDerivativePMap.domain = ⊤ := by
  simp [covariantDerivativePMap]

theorem covariantDerivativePMap_isDenselyDefined :
    QYM.UnboundedLinearPMapExtension.IsDenselyDefined
      covariantDerivativePMap := by
  rw [QYM.UnboundedLinearPMapExtension.IsDenselyDefined,
    covariantDerivativePMap_domain]
  exact dense_univ

/-- Closedness here is a theorem from the literal finite-dimensional graph,
not a field of the definition. -/
theorem covariantDerivativePMap_isClosed :
    covariantDerivativePMap.IsClosed := by
  exact covariantDerivativePMap.graph.closed_of_finiteDimensional

/-- The independently typed graph-norm H1 carrier.  Its points are pairs
`(u, D u)` in the actual `LinearPMap.graph`. -/
abbrev CoordinateH1 : Type _ :=
  QYM.ClosedOperatorEnergyFormExtension.EnergyFormDomain covariantDerivativePMap

/-- The H1-to-L2 embedding is the first graph coordinate. -/
def h1Embedding : CoordinateH1 →L[ℂ] CoordinateL2 :=
  QYM.ClosedOperatorEnergyFormExtension.formEmbedding covariantDerivativePMap

/-- The derivative coordinate on the graph H1 carrier. -/
def h1Derivative : CoordinateH1 →L[ℂ] CoordinateL2 :=
  QYM.ClosedOperatorEnergyFormExtension.operatorCoordinate covariantDerivativePMap

theorem h1Embedding_injective : Function.Injective h1Embedding :=
  QYM.ClosedOperatorEnergyFormExtension.formEmbedding_injective covariantDerivativePMap

theorem h1Embedding_denseRange : DenseRange h1Embedding :=
  QYM.ClosedOperatorEnergyFormExtension.formEmbedding_denseRange covariantDerivativePMap_isDenselyDefined

theorem coordinateH1_closedEnergyForm :
    QYM.ClosedOperatorEnergyFormExtension.IsClosedEnergyForm covariantDerivativePMap :=
  QYM.ClosedOperatorEnergyFormExtension.isClosedEnergyForm_of_operator_isClosed
    covariantDerivativePMap_isClosed

/-- Rellich compactness for this concrete coordinate model.  It is derived
from finite dimensionality of the independently typed graph carrier. -/
theorem h1Embedding_isCompact :
    IsCompactOperator (h1Embedding : CoordinateH1 → CoordinateL2) := by
  letI : FiniteDimensional ℂ CoordinateH1 := inferInstance
  exact isCompactOperator_of_locallyCompactSpace_rng h1Embedding

theorem coordinateH1_rellich_certificate :
    QYM.ClosedOperatorEnergyFormExtension.IsClosedEnergyForm covariantDerivativePMap ∧
      Function.Injective h1Embedding ∧
      DenseRange h1Embedding ∧
      IsCompactOperator (h1Embedding : CoordinateH1 → CoordinateL2) := by
  exact ⟨coordinateH1_closedEnergyForm, h1Embedding_injective,
    h1Embedding_denseRange, h1Embedding_isCompact⟩

/-! ## 3. Literal D*D+V and its complete two-block spectrum -/

/-- A concrete nonnegative ground-block potential. -/
def potential : CoordinateL2 →L[ℂ] CoordinateL2 :=
  (((1 : ℝ) / 4 : ℝ) : ℂ) • groundProjection

@[simp]
theorem potential_apply (u : CoordinateL2) :
    potential u = (((1 : ℝ) / 4 : ℝ) : ℂ) • groundProjection u := by
  rfl

theorem potential_isSymmetric : potential.IsSymmetric := by
  intro u v
  change inner ℂ ((((1 : ℝ) / 4 : ℝ) : ℂ) • groundProjection u) v =
    inner ℂ u ((((1 : ℝ) / 4 : ℝ) : ℂ) • groundProjection v)
  rw [inner_smul_left, inner_smul_right, starRingEnd_apply,
    Complex.star_def, Complex.conj_ofReal]
  exact congrArg
    (fun z : ℂ => (((1 : ℝ) / 4 : ℝ) : ℂ) * z)
    (groundProjection_isSymmetric u v)

theorem potential_isSelfAdjoint : IsSelfAdjoint potential :=
  potential_isSymmetric.isSelfAdjoint

/-- The corrected-sign coordinate Hamiltonian `D* D + V`. -/
def coordinateHamiltonian : CoordinateL2 →L[ℂ] CoordinateL2 :=
  covariantDerivative.adjoint.comp covariantDerivative + potential

@[simp]
theorem coordinateHamiltonian_apply (u : CoordinateL2) :
    coordinateHamiltonian u =
      covariantDerivative u + potential u := by
  rw [coordinateHamiltonian, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.comp_apply, covariantDerivative_adjoint,
    covariantDerivative_apply_apply]

theorem coordinateHamiltonian_isSymmetric :
    coordinateHamiltonian.IsSymmetric := by
  intro u v
  change inner ℂ (coordinateHamiltonian u) v =
    inner ℂ u (coordinateHamiltonian v)
  rw [coordinateHamiltonian_apply, coordinateHamiltonian_apply,
    inner_add_left, inner_add_right]
  exact congrArg₂ (fun a b : ℂ => a + b)
    (covariantDerivative_isSymmetric u v)
    (potential_isSymmetric u v)

theorem coordinateHamiltonian_isSelfAdjoint :
    IsSelfAdjoint coordinateHamiltonian :=
  coordinateHamiltonian_isSymmetric.isSelfAdjoint

theorem groundProjection_eq_self_of_mem
    {u : CoordinateL2} (hu : u ∈ GroundBlock) :
    groundProjection u = u := by
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hu
  rw [groundProjection_apply, inner_smul_right,
    inner_self_eq_norm_sq_to_K, groundVector_norm]
  simp

theorem groundProjection_eq_zero_of_mem_offGround
    {u : CoordinateL2} (hu : u ∈ OffGroundBlock) :
    groundProjection u = 0 := by
  change u ∈ groundProjection.toLinearMap.ker
  rw [groundProjection_ker]
  exact hu

theorem covariantDerivative_eq_zero_of_mem_ground
    {u : CoordinateL2} (hu : u ∈ GroundBlock) :
    covariantDerivative u = 0 := by
  rw [covariantDerivative_apply, groundProjection_eq_self_of_mem hu,
    sub_self]

theorem covariantDerivative_eq_self_of_mem_offGround
    {u : CoordinateL2} (hu : u ∈ OffGroundBlock) :
    covariantDerivative u = u := by
  rw [covariantDerivative_apply,
    groundProjection_eq_zero_of_mem_offGround hu, sub_zero]

/-- Every vector in the complete ground block has the exact ground level
`1/4`. -/
theorem coordinateHamiltonian_groundBlock
    {u : CoordinateL2} (hu : u ∈ GroundBlock) :
    coordinateHamiltonian u = (((1 : ℝ) / 4 : ℝ) : ℂ) • u := by
  rw [coordinateHamiltonian_apply,
    covariantDerivative_eq_zero_of_mem_ground hu,
    potential_apply, groundProjection_eq_self_of_mem hu, zero_add]

/-- Every vector in the complete orthogonal block has the exact level one. -/
theorem coordinateHamiltonian_offGroundBlock
    {u : CoordinateL2} (hu : u ∈ OffGroundBlock) :
    coordinateHamiltonian u = (1 : ℂ) • u := by
  rw [coordinateHamiltonian_apply,
    covariantDerivative_eq_self_of_mem_offGround hu,
    potential_apply, groundProjection_eq_zero_of_mem_offGround hu,
    smul_zero, add_zero]
  simp

/-- A displayed unit vector in the first off-ground coordinate.  This witness
prevents the off-ground spectral assertion from being vacuous. -/
def offGroundVector : CoordinateL2 :=
  EuclideanSpace.single (1 : Fin 2) (1 : ℂ)

@[simp]
theorem offGroundVector_norm : ‖offGroundVector‖ = 1 := by
  simp [offGroundVector]

theorem offGroundVector_ne_zero : offGroundVector ≠ 0 := by
  exact norm_ne_zero_iff.mp (by simp)

theorem offGroundVector_mem : offGroundVector ∈ OffGroundBlock := by
  rw [OffGroundBlock, GroundBlock,
    Submodule.mem_orthogonal_singleton_iff_inner_right]
  simp [groundVector, offGroundVector,
    EuclideanSpace.inner_single_left]

/-- The displayed off-ground unit vector is an exact eigenvector at level
one. -/
theorem coordinateHamiltonian_offGroundVector :
    coordinateHamiltonian offGroundVector = (1 : ℂ) • offGroundVector :=
  coordinateHamiltonian_offGroundBlock offGroundVector_mem

/-- The multiplicity-safe first-off-ground gap of the complete two-block
decomposition is exactly `3/4`. -/
theorem coordinate_firstOffGroundGap :
    (1 : ℝ) - (1 / 4 : ℝ) = 3 / 4 := by
  norm_num

theorem coordinate_groundBlock_spectrum_certificate :
    IsCompl GroundBlock OffGroundBlock ∧
      (∀ u : CoordinateL2, u ∈ GroundBlock →
        coordinateHamiltonian u = (((1 : ℝ) / 4 : ℝ) : ℂ) • u) ∧
      (∀ u : CoordinateL2, u ∈ OffGroundBlock →
        coordinateHamiltonian u = (1 : ℂ) • u) ∧
      offGroundVector ∈ OffGroundBlock ∧
      offGroundVector ≠ 0 ∧
      ‖offGroundVector‖ = 1 ∧
      coordinateHamiltonian offGroundVector =
        (1 : ℂ) • offGroundVector ∧
      (1 : ℝ) - (1 / 4 : ℝ) = 3 / 4 := by
  exact ⟨ground_isCompl_offGround,
    fun _ hu => coordinateHamiltonian_groundBlock hu,
    fun _ hu => coordinateHamiltonian_offGroundBlock hu,
    offGroundVector_mem, offGroundVector_ne_zero, offGroundVector_norm,
    coordinateHamiltonian_offGroundVector,
    coordinate_firstOffGroundGap⟩

/-! ## 4. Concrete form, Friedrichs realization, and compact resolvent -/

/-- The literal identity form embedding used for the finite coordinate
Friedrichs realization. -/
def coordinateFormEmbedding : CoordinateL2 →L[ℂ] CoordinateL2 :=
  ContinuousLinearMap.id ℂ CoordinateL2

/-- The form of `D*D + V`, defined from the two actual operators. -/
def coordinateHamiltonianForm : QYM.RCLikeCoerciveFormFriedrichsExtension.SesqForm ℂ CoordinateL2 :=
  QYM.RCLikeCoerciveFormFriedrichsExtension.pullbackInnerForm covariantDerivative +
    (((1 : ℝ) / 4 : ℝ) : ℂ) •
      QYM.RCLikeCoerciveFormFriedrichsExtension.pullbackInnerForm groundProjection

@[simp]
theorem coordinateHamiltonianForm_apply (u v : CoordinateL2) :
    coordinateHamiltonianForm u v =
      inner ℂ (covariantDerivative u) (covariantDerivative v) +
        (((1 : ℝ) / 4 : ℝ) : ℂ) *
          inner ℂ (groundProjection u) (groundProjection v) := by
  simp [coordinateHamiltonianForm, QYM.RCLikeCoerciveFormFriedrichsExtension.pullbackInnerForm_apply]

theorem coordinateHamiltonianForm_isHermitian :
    QYM.RCLikeCoerciveFormFriedrichsExtension.IsHermitianForm coordinateHamiltonianForm := by
  intro u v
  rw [coordinateHamiltonianForm_apply,
    coordinateHamiltonianForm_apply, Complex.star_def, map_add, map_mul,
    starRingEnd_apply, Complex.star_def, Complex.conj_ofReal]
  rw [inner_conj_symm (covariantDerivative u)
      (covariantDerivative v),
    inner_conj_symm (groundProjection u) (groundProjection v)]

/-- The bounded form is literally the quadratic form of the previously
defined corrected-sign operator `D*D+V`; the Friedrichs realization below is
therefore not attached to an unrelated coercive form. -/
theorem coordinateHamiltonianForm_eq_inner_hamiltonian
    (u v : CoordinateL2) :
    coordinateHamiltonianForm u v =
      inner ℂ (coordinateHamiltonian u) v := by
  rw [coordinateHamiltonianForm_apply, coordinateHamiltonian_apply,
    inner_add_left, potential_apply, inner_smul_left,
    starRingEnd_apply, Complex.star_def, Complex.conj_ofReal]
  have hDerivative :=
    (covariantDerivative_isSymmetric (covariantDerivative u) v).symm
  change inner ℂ (covariantDerivative u) (covariantDerivative v) =
    inner ℂ (covariantDerivative (covariantDerivative u)) v at hDerivative
  rw [covariantDerivative_apply_apply] at hDerivative
  have hProjection :=
    (groundProjection_isSymmetric (groundProjection u) v).symm
  change inner ℂ (groundProjection u) (groundProjection v) =
    inner ℂ (groundProjection (groundProjection u)) v at hProjection
  rw [groundProjection_apply_apply] at hProjection
  exact congrArg₂
    (fun a b : ℂ =>
      a + (((1 : ℝ) / 4 : ℝ) : ℂ) * b)
    hDerivative hProjection

/-- The literal vector `coordinateHamiltonian u` represents the form
functional at `u` through the identity embedding. -/
theorem coordinateHamiltonianForm_represents (u : CoordinateL2) :
    QYM.RCLikeCoerciveFormFriedrichsExtension.Represents coordinateHamiltonianForm coordinateFormEmbedding
      u (coordinateHamiltonian u) := by
  intro v
  simpa [coordinateFormEmbedding] using
    coordinateHamiltonianForm_eq_inner_hamiltonian u v

@[simp]
theorem coordinateHamiltonianForm_re_self (u : CoordinateL2) :
    RCLike.re (coordinateHamiltonianForm u u) =
      ‖covariantDerivative u‖ ^ 2 + (1 / 4 : ℝ) * ‖groundProjection u‖ ^ 2 := by
  rw [coordinateHamiltonianForm_apply,
    inner_self_eq_norm_sq_to_K, inner_self_eq_norm_sq_to_K]
  change
    ‖covariantDerivative u‖ ^ 2 +
      (1 / 4 : ℝ) * ‖groundProjection u‖ ^ 2 =
    ‖covariantDerivative u‖ ^ 2 +
      (1 / 4 : ℝ) * ‖groundProjection u‖ ^ 2
  rfl

/-- The displayed positive shift is proved pointwise. -/
theorem coordinateHamiltonianForm_positiveShift :
    QYM.RCLikeCoerciveFormFriedrichsExtension.IsPositiveCoerciveShift coordinateHamiltonianForm
      coordinateFormEmbedding 1 1 := by
  refine ⟨by norm_num, by norm_num, ?_⟩
  intro u
  rw [coordinateHamiltonianForm_re_self]
  change 1 * ‖u‖ ^ 2 ≤
    ‖covariantDerivative u‖ ^ 2 +
      (1 / 4 : ℝ) * ‖groundProjection u‖ ^ 2 + 1 * ‖u‖ ^ 2
  have hD : 0 ≤ ‖covariantDerivative u‖ ^ 2 := sq_nonneg _
  have hP : 0 ≤ (1 / 4 : ℝ) * ‖groundProjection u‖ ^ 2 := by positivity
  linarith

theorem coordinateFormEmbedding_injective :
    Function.Injective coordinateFormEmbedding := by
  intro u v h
  exact h

theorem coordinateFormEmbedding_denseRange :
    DenseRange coordinateFormEmbedding := by
  apply (show Function.Surjective coordinateFormEmbedding from ?_).denseRange
  intro u
  exact ⟨u, rfl⟩

/-- Density of the identity form embedding makes the representing vector
unique, so form representation is equivalent to equality with the literal
`D*D+V` value. -/
theorem coordinateHamiltonianForm_represents_iff
    (u f : CoordinateL2) :
    QYM.RCLikeCoerciveFormFriedrichsExtension.Represents coordinateHamiltonianForm coordinateFormEmbedding u f ↔
      f = coordinateHamiltonian u := by
  constructor
  · intro hf
    exact QYM.RCLikeCoerciveFormFriedrichsExtension.representingVector_unique coordinateFormEmbedding_denseRange
      hf (coordinateHamiltonianForm_represents u)
  · rintro rfl
    exact coordinateHamiltonianForm_represents u

theorem coordinateFormEmbedding_isCompact :
    IsCompactOperator
      (coordinateFormEmbedding : CoordinateL2 → CoordinateL2) := by
  exact isCompactOperator_of_locallyCompactSpace_rng coordinateFormEmbedding

/-- The actual partial operator constructed by the complex Friedrichs API. -/
def coordinateFriedrichsHamiltonian :
    CoordinateL2 →ₗ.[ℂ] CoordinateL2 :=
  QYM.RCLikeCoerciveFormFriedrichsExtension.realization coordinateHamiltonianForm coordinateFormEmbedding
    coordinateFormEmbedding_injective coordinateFormEmbedding_denseRange

/-- Exact graph identification: the Friedrichs realization of the concrete
form is literally the graph of the previously defined corrected-sign
Hamiltonian `D*D+V`. -/
theorem pair_mem_coordinateFriedrichsHamiltonian_graph_iff
    (u f : CoordinateL2) :
    (u, f) ∈ coordinateFriedrichsHamiltonian.graph ↔
      f = coordinateHamiltonian u := by
  simpa [coordinateFriedrichsHamiltonian, coordinateFormEmbedding] using
    (QYM.RCLikeCoerciveFormFriedrichsExtension.pair_mem_realization_graph_iff
      coordinateHamiltonianForm coordinateFormEmbedding
      coordinateFormEmbedding_injective coordinateFormEmbedding_denseRange
      u f).trans (coordinateHamiltonianForm_represents_iff u f)

@[simp]
theorem coordinateFriedrichsHamiltonian_domain :
    coordinateFriedrichsHamiltonian.domain = ⊤ := by
  apply eq_top_iff.mpr
  intro u _
  exact LinearPMap.mem_domain_of_mem_graph
    ((pair_mem_coordinateFriedrichsHamiltonian_graph_iff
      u (coordinateHamiltonian u)).mpr rfl)

/-- On its now-proved full domain, the form realization acts exactly as the
literal bounded map `D*D+V`. -/
@[simp]
theorem coordinateFriedrichsHamiltonian_apply
    (u : coordinateFriedrichsHamiltonian.domain) :
    coordinateFriedrichsHamiltonian u =
      coordinateHamiltonian (u : CoordinateL2) := by
  exact ((LinearPMap.image_iff u.property).mpr
    ((pair_mem_coordinateFriedrichsHamiltonian_graph_iff
      (u : CoordinateL2) (coordinateHamiltonian (u : CoordinateL2))).mpr
        rfl)).symm

theorem coordinateFriedrichsHamiltonian_isSelfAdjoint :
    IsSelfAdjoint coordinateFriedrichsHamiltonian := by
  exact QYM.RCLikeCoerciveFormFriedrichsExtension.realization_isSelfAdjoint
    coordinateFormEmbedding_injective coordinateFormEmbedding_denseRange
    coordinateHamiltonianForm_isHermitian
    coordinateHamiltonianForm_positiveShift

local instance coordinateL2NormedSpaceFromInnerProduct :
    NormedSpace ℂ CoordinateL2 :=
  (PiLp.innerProductSpace fun _ : Fin 2 => ℂ).toNormedSpace

/-- A genuine compact resolvent at the explicit point `-1`. -/
theorem coordinateFriedrichsHamiltonian_hasCompactResolventAt_negOne :
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt coordinateFriedrichsHamiltonian (-1 : ℂ) := by
  change
    @QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      ℂ CoordinateL2 Complex.instRCLike
      (PiLp.normedAddCommGroup 2 fun _ : Fin 2 => ℂ)
      (PiLp.innerProductSpace fun _ : Fin 2 => ℂ).toNormedSpace
      coordinateFriedrichsHamiltonian (-1)
  simpa [coordinateFriedrichsHamiltonian] using
    QYM.RCLikeCoerciveFormFriedrichsExtension.realization_hasCompactResolventAt_negShift
      coordinateHamiltonianForm coordinateFormEmbedding
      coordinateFormEmbedding_injective coordinateFormEmbedding_denseRange
      1 1 coordinateHamiltonianForm_positiveShift
      coordinateFormEmbedding_isCompact

theorem coordinate_closed_selfAdjoint_compactResolvent_certificate :
    coordinateFriedrichsHamiltonian.IsClosed ∧
      IsSelfAdjoint coordinateFriedrichsHamiltonian ∧
      QYM.UnboundedResolventDataExtension.HasCompactResolventAt coordinateFriedrichsHamiltonian (-1 : ℂ) := by
  exact ⟨coordinateFriedrichsHamiltonian_isSelfAdjoint.isClosed,
    coordinateFriedrichsHamiltonian_isSelfAdjoint,
    coordinateFriedrichsHamiltonian_hasCompactResolventAt_negOne⟩

/-- End-to-end identification certificate for the finite coordinate model.
It records the exact graph and action of the literal `D*D+V`, rather than
merely placing a compact-resolvent theorem beside an unrelated realization. -/
theorem coordinate_literal_DstarD_plus_V_realization_certificate :
    (∀ u f : CoordinateL2,
      (u, f) ∈ coordinateFriedrichsHamiltonian.graph ↔
        f = coordinateHamiltonian u) ∧
      coordinateFriedrichsHamiltonian.domain = ⊤ ∧
      (∀ u : coordinateFriedrichsHamiltonian.domain,
        coordinateFriedrichsHamiltonian u =
          coordinateHamiltonian (u : CoordinateL2)) ∧
      coordinateFriedrichsHamiltonian.IsClosed ∧
      IsSelfAdjoint coordinateFriedrichsHamiltonian ∧
      QYM.UnboundedResolventDataExtension.HasCompactResolventAt coordinateFriedrichsHamiltonian (-1 : ℂ) := by
  exact ⟨pair_mem_coordinateFriedrichsHamiltonian_graph_iff,
    coordinateFriedrichsHamiltonian_domain,
    coordinateFriedrichsHamiltonian_apply,
    coordinateFriedrichsHamiltonian_isSelfAdjoint.isClosed,
    coordinateFriedrichsHamiltonian_isSelfAdjoint,
    coordinateFriedrichsHamiltonian_hasCompactResolventAt_negOne⟩

/-! ## 5. Actual-stage semantic firewall -/

/-- On the actual finite-stage Petersson L2 carrier, every bounded real
endomorphism fails compact resolvent at every real resolvent point.  Therefore
the finite coordinate Hamiltonian above cannot be relabelled as the paper's
geometric Hamiltonian. -/
theorem actualStage_boundedHamiltonian_compactResolvent_firewall
    {Y r : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)
    (hr : r ∈ resolventSet ℝ T) :
    ¬ IsCompactOperator
      ((resolvent T r : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  exact QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStage_bounded_not_compact_resolvent hY T hr

/-- A compact-resolvent bounded surrogate on the actual carrier is impossible,
even though the finite coordinate model has one.  The missing actual-stage
ingredient must therefore be a genuinely unbounded closed derivative/form
domain, not a bounded projection replacement. -/
theorem actualStage_no_bounded_compactResolvent_surrogate
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∀ (T : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (r : ℝ),
      r ∈ resolventSet ℝ T →
        ¬ IsCompactOperator
          ((resolvent T r : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
              QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
              QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  intro T r hr
  exact actualStage_boundedHamiltonian_compactResolvent_firewall hY T hr

