/-! ## 4. Symmetry, self-adjointness, and positivity -/

/-- Direct inner-product symmetry of the complementary projection. -/
theorem actualInverseEtaProjectionHamiltonian_isSymmetric
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).IsSymmetric := by
  intro u v
  change inner ℂ (actualInverseEtaProjectionHamiltonian hY u) v =
    inner ℂ u (actualInverseEtaProjectionHamiltonian hY v)
  rw [actualInverseEtaProjectionHamiltonian_apply,
    actualInverseEtaProjectionHamiltonian_apply,
    inner_sub_left, inner_sub_right]
  exact congrArg (fun z : ℂ => inner ℂ u v - z)
    ((actualPaperRangeInverseEtaProjection_isSymmetricProjection hY).isSymmetric u v)

/-- The bounded surrogate is self-adjoint on the actual Hilbert carrier. -/
theorem actualInverseEtaProjectionHamiltonian_isSelfAdjoint
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    IsSelfAdjoint (actualInverseEtaProjectionHamiltonian hY) :=
  (actualInverseEtaProjectionHamiltonian_isSymmetric hY).isSelfAdjoint

/-- It is itself a symmetric projection. -/
theorem actualInverseEtaProjectionHamiltonian_isSymmetricProjection
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).IsSymmetricProjection :=
  ⟨ContinuousLinearMap.IsIdempotentElem.toLinearMap
      (actualInverseEtaProjectionHamiltonian_isIdempotent hY),
    actualInverseEtaProjectionHamiltonian_isSymmetric hY⟩

/-- Positivity follows from idempotence and self-adjointness, with no
finite-dimensional spectral theorem. -/
theorem actualInverseEtaProjectionHamiltonian_isPositive
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).IsPositive :=
  (ContinuousLinearMap.IsIdempotentElem.isPositive_iff_isSelfAdjoint
    (actualInverseEtaProjectionHamiltonian_isIdempotent hY)).mpr
    (actualInverseEtaProjectionHamiltonian_isSelfAdjoint hY)

/-! ## 5. Exact energy and optimal off-ground coercivity -/

/-- Real quadratic energy of the bounded projection surrogate. -/
noncomputable def actualInverseEtaProjectionHamiltonianEnergy
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) : ℝ :=
  (inner ℂ (actualInverseEtaProjectionHamiltonian hY u) u).re

/-- Before taking real parts, the quadratic pairing is the squared norm of
the projected off-ground component. -/
theorem actualInverseEtaProjectionHamiltonian_inner_self
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    inner ℂ (actualInverseEtaProjectionHamiltonian hY u) u =
      ((‖actualInverseEtaProjectionHamiltonian hY u‖ ^ 2 : ℝ) : ℂ) := by
  have hSymm := actualInverseEtaProjectionHamiltonian_isSymmetric hY
  have hMove := hSymm u (actualInverseEtaProjectionHamiltonian hY u)
  change inner ℂ (actualInverseEtaProjectionHamiltonian hY u)
      (actualInverseEtaProjectionHamiltonian hY u) =
    inner ℂ u (actualInverseEtaProjectionHamiltonian hY
      (actualInverseEtaProjectionHamiltonian hY u)) at hMove
  rw [actualInverseEtaProjectionHamiltonian_apply_apply] at hMove
  calc
    inner ℂ (actualInverseEtaProjectionHamiltonian hY u) u =
        inner ℂ u (actualInverseEtaProjectionHamiltonian hY u) :=
      hSymm u u
    _ = inner ℂ (actualInverseEtaProjectionHamiltonian hY u)
          (actualInverseEtaProjectionHamiltonian hY u) := hMove.symm
    _ = ((‖actualInverseEtaProjectionHamiltonian hY u‖ ^ 2 : ℝ) : ℂ) := by
      rw [inner_self_eq_norm_sq_to_K]
      norm_cast

@[simp]
theorem actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    actualInverseEtaProjectionHamiltonianEnergy hY u =
      ‖actualInverseEtaProjectionHamiltonian hY u‖ ^ 2 := by
  unfold actualInverseEtaProjectionHamiltonianEnergy
  rw [actualInverseEtaProjectionHamiltonian_inner_self]
  exact Complex.ofReal_re _

theorem actualInverseEtaProjectionHamiltonianEnergy_nonneg
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    0 ≤ actualInverseEtaProjectionHamiltonianEnergy hY u := by
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq]
  positivity

/-- Exact complex quadratic energy on the entire off-ground block. -/
theorem actualInverseEtaProjectionHamiltonian_inner_eq_norm_sq_of_mem_offTest
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y}
    (hu : u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :
    inner ℂ (actualInverseEtaProjectionHamiltonian hY u) u =
      ((‖u‖ ^ 2 : ℝ) : ℂ) := by
  rw [actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY hu,
    inner_self_eq_norm_sq_to_K]
  norm_cast

/-- Exact real energy on the entire off-ground block. -/
@[simp]
theorem actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq_of_mem_offTest
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y}
    (hu : u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :
    actualInverseEtaProjectionHamiltonianEnergy hY u = ‖u‖ ^ 2 := by
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq,
    actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY hu]

/-- Zero energy detects the complete ground block. -/
theorem actualInverseEtaProjectionHamiltonianEnergy_eq_zero_iff
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y} :
    actualInverseEtaProjectionHamiltonianEnergy hY u = 0 ↔
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y := by
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq,
    sq_eq_zero_iff, norm_eq_zero]
  exact actualInverseEtaProjectionHamiltonian_eq_zero_iff hY

/-- Coercivity on the whole off-ground block with constant exactly one. -/
theorem actualInverseEtaProjectionHamiltonian_offGround_coercivity_one
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y}
    (hu : u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :
    1 * ‖u‖ ^ 2 ≤ actualInverseEtaProjectionHamiltonianEnergy hY u := by
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq_of_mem_offTest hY hu,
    one_mul]

/-- The preceding coercivity estimate is an equality, not merely a lower
bound. -/
theorem actualInverseEtaProjectionHamiltonian_offGround_energy_exact_one
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y}
    (hu : u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :
    actualInverseEtaProjectionHamiltonianEnergy hY u =
      1 * ‖u‖ ^ 2 := by
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq_of_mem_offTest hY hu,
    one_mul]

/-! ## 6. Infinite multiplicity of the complete level-one block -/

/-- The off-ground block cannot be finite dimensional.  Otherwise the
complementary product of the one-dimensional ground line and the off-ground
block would make the actual stage carrier finite dimensional, contradicting
the literal Urysohn-family construction. -/
theorem actualInverseEtaOffTestSubspace_not_finiteDimensional
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) := by
  intro hOffFinite
  letI : FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :=
    hOffFinite
  letI : FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y) :=
    inferInstance
  letI : FiniteDimensional ℂ
      (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y ×
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) :=
    inferInstance
  letI : FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :=
    Module.Finite.equiv
      ((QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y).prodEquivOfIsCompl
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y)
        (actualInverseEtaProjectionHamiltonian_ground_isCompl_offGround hY))
  exact QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStageInverseEtaL2_not_finiteDimensional hY inferInstance

/-- The ground line is a proper subspace of the actual infinite-dimensional
carrier. -/
theorem actualInverseEtaTestLine_ne_top
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y ≠ ⊤ := by
  intro hTop
  apply QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStageInverseEtaL2_not_finiteDimensional hY
  letI : FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y) :=
    inferInstance
  exact Module.Finite.of_surjective
    (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y).subtype (by
      intro u
      refine ⟨⟨u, ?_⟩, rfl⟩
      rw [hTop]
      exact Submodule.mem_top)

/-- The level-one block is inhabited by a nonzero actual `L²` vector. -/
theorem exists_nonzero_actualInverseEtaProjectionHamiltonian_levelOne
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∃ w : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
      w ≠ 0 ∧
        w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧
        actualInverseEtaProjectionHamiltonian hY w = w := by
  obtain ⟨u, hu⟩ := SetLike.exists_not_mem_of_ne_top
    (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y)
    (actualInverseEtaTestLine_ne_top hY)
  let w := actualInverseEtaProjectionHamiltonian hY u
  have hwMem : w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y :=
    actualInverseEtaProjectionHamiltonian_apply_mem_offTest hY u
  have hw0 : w ≠ 0 := by
    intro hw
    exact hu
      ((actualInverseEtaProjectionHamiltonian_eq_zero_iff hY).1 hw)
  exact ⟨w, hw0, hwMem,
    actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY hwMem⟩

/-- Any uniform off-ground coercivity constant is at most one. -/
theorem actualInverseEtaProjectionHamiltonian_coercivityConstant_le_one
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {c : ℝ}
    (hCoercive : ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
        c * ‖u‖ ^ 2 ≤
          actualInverseEtaProjectionHamiltonianEnergy hY u) :
    c ≤ 1 := by
  obtain ⟨w, hw0, hwMem, -⟩ :=
    exists_nonzero_actualInverseEtaProjectionHamiltonian_levelOne hY
  have hAtW := hCoercive w hwMem
  rw [actualInverseEtaProjectionHamiltonianEnergy_eq_norm_sq_of_mem_offTest
    hY hwMem] at hAtW
  have hNormSq : 0 < ‖w‖ ^ 2 :=
    pow_pos (norm_pos_iff.mpr hw0) 2
  nlinarith

/-- Constant one works on the whole off-ground block and is the greatest
possible uniform constant. -/
theorem actualInverseEtaProjectionHamiltonian_optimalCoercivityConstant_one
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
        1 * ‖u‖ ^ 2 ≤
          actualInverseEtaProjectionHamiltonianEnergy hY u) ∧
      ∀ c : ℝ,
        (∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
          u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
            c * ‖u‖ ^ 2 ≤
              actualInverseEtaProjectionHamiltonianEnergy hY u) →
          c ≤ 1 := by
  exact ⟨fun u hu =>
      actualInverseEtaProjectionHamiltonian_offGround_coercivity_one hY hu,
    fun c hc =>
      actualInverseEtaProjectionHamiltonian_coercivityConstant_le_one hY hc⟩

/-- Multiplicity-safe first-off-ground statement: both complete eigenspaces
are identified, the positive block is nonzero and infinite dimensional, and
its energy level is exactly one. -/
theorem actualInverseEtaProjectionHamiltonian_firstOffGroundLevel_one
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).toLinearMap.ker =
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y ∧
      (actualInverseEtaProjectionHamiltonian hY - 1).toLinearMap.ker =
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧
      IsCompl (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y)
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) ∧
      ¬ FiniteDimensional ℂ (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) ∧
      (∃ w : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
        w ≠ 0 ∧ w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧
          actualInverseEtaProjectionHamiltonian hY w = w) ∧
      ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
        u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
          actualInverseEtaProjectionHamiltonian hY u = (1 : ℂ) • u ∧
            actualInverseEtaProjectionHamiltonianEnergy hY u =
              1 * ‖u‖ ^ 2 := by
  exact
    ⟨actualInverseEtaProjectionHamiltonian_ker hY,
      actualInverseEtaProjectionHamiltonian_levelOneEigenspace hY,
      actualInverseEtaProjectionHamiltonian_ground_isCompl_offGround hY,
      actualInverseEtaOffTestSubspace_not_finiteDimensional hY,
      exists_nonzero_actualInverseEtaProjectionHamiltonian_levelOne hY,
      fun u hu =>
        ⟨by simpa only [one_smul] using
            actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY hu,
          actualInverseEtaProjectionHamiltonian_offGround_energy_exact_one
            hY hu⟩⟩

/-! ## 7. Bounded compact-resolvent no-go and identification firewall -/

/-- At every real resolvent point, the real restriction of the bounded
projection Hamiltonian has noncompact resolvent on the actual carrier. -/
theorem actualInverseEtaProjectionHamiltonian_not_compact_realResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {r : ℝ}
    (hr : r ∈ resolventSet ℝ
      ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ)) :
    ¬ IsCompactOperator
      ((resolvent
        ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ) r :
          QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℝ]
            QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
          QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →
            QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) := by
  exact QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStage_complexBounded_not_compact_realResolvent hY
    (actualInverseEtaProjectionHamiltonian hY) hr

/-- Uniform formulation over all real resolvent points. -/
theorem actualInverseEtaProjectionHamiltonian_no_compact_realResolventPoint
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∀ r : ℝ,
      r ∈ resolventSet ℝ
          ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ) →
        ¬ IsCompactOperator
          ((resolvent
            ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ) r :
              QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℝ]
                QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
              QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →
                QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) := by
  intro r hr
  exact actualInverseEtaProjectionHamiltonian_not_compact_realResolvent hY hr

/-- Formal firewall: no bounded complex-linear operator having a compact
real resolvent at a stated point can equal this projection surrogate. -/
theorem actualInverseEtaProjectionHamiltonian_ne_of_compact_realResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℂ]
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y)
    {r : ℝ}
    (hr : r ∈ resolventSet ℝ (T.restrictScalars ℝ))
    (hCompact : IsCompactOperator
      ((resolvent (T.restrictScalars ℝ) r :
          QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℝ]
            QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →
          QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y)) :
    T ≠ actualInverseEtaProjectionHamiltonian hY := by
  intro hEq
  subst T
  exact
    (actualInverseEtaProjectionHamiltonian_not_compact_realResolvent hY hr)
      hCompact

/-! ## 8. Aggregate unconditional endpoint -/

/-- Complete bounded-surrogate certificate on the actual finite-stage
inverse-eta `L²` carrier. -/
theorem actualInverseEtaProjectionHamiltonianCertificate
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    IsIdempotentElem (actualInverseEtaProjectionHamiltonian hY) ∧
