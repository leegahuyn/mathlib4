/-- Completeness relative to the constructors of `ClaimId`; this is not PDF-extraction
completeness. -/
theorem allClaims_complete (claim : ClaimId) : claim ∈ allClaims := by
  cases claim <;> simp [allClaims]

/-- Planned mathematical disposition.  These values are audit targets, not earned certificates. -/
inductive TerminalClass where
  | provedCandidate
  | corrected
  | refuted
  | blockedExternal
  deriving DecidableEq, Repr

