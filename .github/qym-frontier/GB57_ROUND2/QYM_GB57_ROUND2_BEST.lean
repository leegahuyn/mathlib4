namespace QYM.FullCertification.P2SmoothQuotientAtlasExtension
















open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# The effective `Gamma(2)` quotient: the unconditional atlas endpoint

Mathlib's properly-discontinuous quotient API produces a covering map and
local homeomorphisms, but it does not contain a constructor which turns a
smooth free action into a quotient manifold.  This file therefore separates
the part which can be closed without any new premise from the one exact
transition condition needed by such a constructor.

The unconditional endpoint is stronger than connectedness of the three cusp
pieces.  At normalized level at least two, the selected real horocycle descends
to a continuous injective map from the width-two additive circle.  Compactness
of the circle and Hausdorffness of the effective quotient make this map a
closed embedding and a homeomorphism onto the genuine quotient cusp piece.

For the ambient quotient, all covering sheets are assembled into a topological
atlas modelled on `ℍ`.  A single, explicit proposition says that its overlap
maps are smooth.  Under exactly that proposition the standard groupoid
composition API gives the desired complex smooth-manifold structure.  No
unconditional smooth instance is registered here.
-/

/-! ## 1. The width-two quotient horocycle -/

/-- The compact parameter circle appropriate to `Gamma(2)` cusp width two. -/
abbrev WidthTwoCircle := AddCircle (2 : ℝ)

local instance widthTwoPositive : Fact (0 < (2 : ℝ)) :=
  ⟨by norm_num⟩

/-- The conjugate of `T^2` fixing the selected cusp.  Normality of the
principal congruence subgroup is the only group-theoretic input. -/
noncomputable def selectedWidthTwoTranslation
    (q : GammaTwoRightCoset) : GammaTwo :=
  ⟨gammaTwoCosetRep q * (ModularGroup.T ^ (2 : ℤ)) *
      (gammaTwoCosetRep q)⁻¹,
    (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (ModularGroup.T ^ (2 : ℤ))
      (by
        simpa using
          CongruenceSubgroup.ModularGroup_T_pow_mem_Gamma
            (2 : ℤ) (2 : ℤ) (dvd_refl (2 : ℤ)))
      (gammaTwoCosetRep q)⟩

/-- The selected parabolic advances the concrete horocycle parameter by two. -/
theorem selectedWidthTwoTranslation_smul
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    (selectedWidthTwoTranslation q : SL(2, ℤ)) •
        gammaTwoSelectedHorocycleParam q Y t =
      gammaTwoSelectedHorocycleParam q Y (t + 2) := by
  rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal,
    QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal]
  simp only [selectedWidthTwoTranslation, mul_smul, inv_smul_smul]
  rw [zpow_two, mul_smul, QYM.FullCertification.P2ConnectedCuspComponentsExtension.modular_T_smul_traceHorizontal,
    QYM.FullCertification.P2ConnectedCuspComponentsExtension.modular_T_smul_traceHorizontal]
  congr 2
  ring

/-- The quotient horocycle is genuinely two-periodic. -/
theorem selectedCuspQuotientLoop_periodic
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Function.Periodic (QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y) 2 := by
  intro t
  unfold QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop
  rw [← selectedWidthTwoTranslation_smul q Y t]
  exact Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_gamma_smul
    (selectedWidthTwoTranslation q)
    (gammaTwoSelectedHorocycleParam q Y t)

/-- The descended width-two cusp loop. -/
noncomputable def selectedCuspCircle
    (q : GammaTwoRightCoset) (Y : ℝ) :
    WidthTwoCircle → GammaTwoQuotient :=
  (selectedCuspQuotientLoop_periodic q Y).lift

@[simp]
theorem selectedCuspCircle_coe
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    selectedCuspCircle q Y (t : WidthTwoCircle) =
      QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y t := by
  exact Function.Periodic.lift_coe
    (selectedCuspQuotientLoop_periodic q Y) t

/-- Continuity descends through the quotient topology on `AddCircle 2`. -/
theorem selectedCuspCircle_continuous
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Continuous (selectedCuspCircle q Y) := by
  rw [isQuotientMap_quotient_mk'.continuous_iff]
  have hfun : selectedCuspCircle q Y ∘
      QuotientAddGroup.mk' (AddSubgroup.zmultiples (2 : ℝ)) =
      QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y := by
    funext t
    exact selectedCuspCircle_coe q Y t
  change Continuous (selectedCuspCircle q Y ∘
    QuotientAddGroup.mk' (AddSubgroup.zmultiples (2 : ℝ)))
  rw [hfun]
  exact
    QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop_continuous q Y

/-- Descending the parameter does not alter the loop range. -/
theorem selectedCuspCircle_range
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Set.range (selectedCuspCircle q Y) =
      Set.range (QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y) := by
  apply Set.Subset.antisymm
  · rintro x ⟨theta, rfl⟩
    rcases QuotientAddGroup.mk'_surjective _ theta with ⟨t, rfl⟩
    exact ⟨t, selectedCuspCircle_coe q Y t⟩
  · rintro x ⟨t, rfl⟩
    exact ⟨(t : WidthTwoCircle), selectedCuspCircle_coe q Y t⟩

/-! ## 2. High-cusp injectivity -/

/-- At height at least two, equality of two points on one selected quotient
horocycle is exactly congruence of their real parameters modulo two.

The proof extracts an effective orbit bridge, chooses its arithmetic
`Gamma(2)` representative, and conjugates into the selected cusp coordinate.
The high-cusp height estimate forces the lower-left entry to vanish.  The
upper-right entry is even because the bridge is still in `Gamma(2)`, while
the determinant leaves only the two matrices `T^b` and `-T^(-b)`; the latter
has the same upper-half-plane action as `T^(-b)`. -/
theorem selectedCuspCircle_injective
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    Function.Injective (selectedCuspCircle q Y) := by
  intro a b hab
  induction a using QuotientAddGroup.induction_on with
  | H s =>
      induction b using QuotientAddGroup.induction_on with
      | H t =>
          have hLoop :
              QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y s =
                QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop q Y t := by
            simpa only [selectedCuspCircle_coe] using hab
          change Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
              (gammaTwoSelectedHorocycleParam q Y s) =
            Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk
              (gammaTwoSelectedHorocycleParam q Y t) at hLoop
          have hOrbit :
              MulAction.orbitRel GammaTwoEffective ℍ
                (gammaTwoSelectedHorocycleParam q Y s)
                (gammaTwoSelectedHorocycleParam q Y t) :=
            Quotient.eq''.mp hLoop
          rcases hOrbit with ⟨g, hg⟩
          rcases Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.effective_exists_gamma g with ⟨gamma, hgamma⟩
          have hgammaMove :
              (gamma : SL(2, ℤ)) •
                  gammaTwoSelectedHorocycleParam q Y t =
                gammaTwoSelectedHorocycleParam q Y s :=
            (hgamma (gammaTwoSelectedHorocycleParam q Y t)).symm.trans hg
          let baseT : ℍ :=
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t
          let baseS : ℍ :=
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y s
          let bridge : SL(2, ℤ) :=
            (gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
              gammaTwoCosetRep q
          have hbridgeMove : bridge • baseT = baseS := by
            calc
              bridge • baseT =
                  (gammaTwoCosetRep q)⁻¹ •
                    ((gamma : SL(2, ℤ)) •
                      (gammaTwoCosetRep q • baseT)) := by
                        simp only [bridge, mul_smul]
              _ = (gammaTwoCosetRep q)⁻¹ •
                    ((gamma : SL(2, ℤ)) •
                      gammaTwoSelectedHorocycleParam q Y t) := by
                        rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal]
              _ = (gammaTwoCosetRep q)⁻¹ •
                    gammaTwoSelectedHorocycleParam q Y s := by
                        rw [hgammaMove]
              _ = (gammaTwoCosetRep q)⁻¹ •
                    (gammaTwoCosetRep q • baseS) := by
                        rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal]
              _ = baseS := inv_smul_smul _ _
          have hbridgeMem : bridge ∈ CongruenceSubgroup.Gamma 2 := by
            simpa only [bridge, inv_inv] using
              (CongruenceSubgroup.Gamma_normal 2).conj_mem
                (gamma : SL(2, ℤ)) gamma.property
                (gammaTwoCosetRep q)⁻¹
          have hbaseTIm : baseT.im = gammaTwoCuspLevel Y := by
            simpa only [baseT] using
              QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_im Y t
          have hbaseSIm : baseS.im = gammaTwoCuspLevel Y := by
            simpa only [baseS] using
              QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_im Y s
          have hheight : (bridge • baseT).im = baseT.im := by
            rw [hbridgeMove, hbaseSIm, hbaseTIm]
          have hone : 1 < baseT.im := by
            rw [hbaseTIm]
            linarith
          have hlower : bridge 1 0 = 0 :=
            QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.modular_lowerLeft_eq_zero_of_im_eq_of_one_lt
              bridge baseT hone hheight
          have hupperMod : ((bridge 0 1 : ℤ) : ZMod 2) = 0 :=
            (CongruenceSubgroup.Gamma_mem.mp hbridgeMem).2.1
          have hupperEven : (2 : ℤ) ∣ bridge 0 1 :=
            (ZMod.intCast_zmod_eq_zero_iff_dvd (bridge 0 1) 2).mp
              hupperMod
          rcases hupperEven with ⟨k, hk⟩
          have hdet : bridge 0 0 * bridge 1 1 = 1 := by
            have h := bridge.det_coe
            rw [Matrix.det_fin_two, hlower, mul_zero, sub_zero] at h
            exact h
          rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet with
            hdiag | hdiag
          · have hbridgeEq :
                bridge = ModularGroup.T ^ (bridge 0 1) := by
              ext i j
              fin_cases i <;> fin_cases j <;>
                simp [hdiag.1, hlower, hdiag.2,
                  ModularGroup.coe_T_zpow,
                  show (1 : Fin (0 + 2)) = (1 : Fin 2) from rfl]
            have hreal : t + (bridge 0 1 : ℝ) = s := by
              have hre := congrArg UpperHalfPlane.re hbridgeMove
              rw [hbridgeEq,
                ModularGroup.re_T_zpow_smul] at hre
              simpa only [baseT, baseS,
                QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_re] using hre
            rw [← sub_eq_zero, ← AddCircle.coe_sub,
              AddCircle.coe_eq_zero_iff]
            refine ⟨k, ?_⟩
            simp only [zsmul_eq_mul]
            have hkReal : (bridge 0 1 : ℝ) = 2 * (k : ℝ) := by
              exact_mod_cast hk
            nlinarith
          · have hbridgeEq :
                bridge = -ModularGroup.T ^ (-(bridge 0 1)) := by
              ext i j
              fin_cases i <;> fin_cases j <;>
                simp [hdiag.1, hlower, hdiag.2,
                  ModularGroup.coe_T_zpow,
                  show (1 : Fin (0 + 2)) = (1 : Fin 2) from rfl]
            have hreal : t - (bridge 0 1 : ℝ) = s := by
              have hre := congrArg UpperHalfPlane.re hbridgeMove
              rw [hbridgeEq, ModularGroup.SL_neg_smul,
                ModularGroup.re_T_zpow_smul] at hre
              simpa only [baseT, baseS,
                QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_re,
                Int.cast_neg, sub_eq_add_neg] using hre
            rw [← sub_eq_zero, ← AddCircle.coe_sub,
              AddCircle.coe_eq_zero_iff]
            refine ⟨-k, ?_⟩
            simp only [zsmul_eq_mul, Int.cast_neg]
            have hkReal : (bridge 0 1 : ℝ) = 2 * (k : ℝ) := by
              exact_mod_cast hk
            nlinarith

/-- The high-cusp circle is a closed topological embedding. -/
theorem selectedCuspCircle_isClosedEmbedding
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    IsClosedEmbedding (selectedCuspCircle q Y) :=
  (selectedCuspCircle_continuous q Y).isClosedEmbedding
    (selectedCuspCircle_injective hY q)

/-- The high-cusp circle is homeomorphic to its image in the effective
quotient. -/
noncomputable def selectedCuspCircleHomeomorphRange
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    WidthTwoCircle ≃ₜ Set.range (selectedCuspCircle q Y) :=
  (selectedCuspCircle_isClosedEmbedding hY q).toIsEmbedding.toHomeomorph

/-- The embedded circle range is the already certified genuine quotient cusp
boundary piece. -/
theorem quotientCuspBoundaryPiece_eq_selectedCuspCircle_range
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y (gammaTwoTileCuspClass q) =
      Set.range (selectedCuspCircle q Y) := by
  rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.quotientCuspBoundaryPiece_eq_selectedLoop_range hY q,
    selectedCuspCircle_range]

/-- Each actual high-cusp boundary component is a topological circle. -/
noncomputable def selectedCuspCircleHomeomorphBoundaryPiece
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    WidthTwoCircle ≃ₜ
      QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y (gammaTwoTileCuspClass q) :=
  (selectedCuspCircleHomeomorphRange hY q).trans
    (Homeomorph.setCongr
      (quotientCuspBoundaryPiece_eq_selectedCuspCircle_range hY q).symm)

/-! ## 3. Unconditional topological local-diffeomorphism compatibility -/

/-- A covering sheet, regarded as a `C^0` partial diffeomorphism.  This uses
only the equivalence between zero-times continuous differentiability and
continuity, so it makes no smooth-atlas assertion. -/
noncomputable def quotientProjectionPartialDiffeomorphZero (z : ℍ) :
    PartialDiffeomorph 𝓘(ℂ) 𝓘(ℂ) ℍ GammaTwoQuotient 0 where
  toPartialEquiv := (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).toPartialEquiv
  open_source := (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).open_source
  open_target := (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).open_target
  contMDiffOn_toFun := contMDiffOn_zero_iff.mpr
    (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).continuousOn
  contMDiffOn_invFun := contMDiffOn_zero_iff.mpr
    (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).continuousOn_symm

/-- Unconditionally, the quotient projection is a local diffeomorphism of
order zero, i.e. exactly its certified local-homeomorphism structure expressed
in the manifold API. -/
theorem gammaTwoQuotientMk_isLocalDiffeomorph_zero :
    IsLocalDiffeomorph 𝓘(ℂ) 𝓘(ℂ) 0 Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk := by
  intro z
  refine ⟨quotientProjectionPartialDiffeomorphZero z,
    QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt_mem_source z, ?_⟩
  intro w hw
  exact congrFun (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt_eq_projection z) w

/-! ## 4. The all-sheets atlas and the exact smooth residual -/

/-- Unlike the earlier one-chosen-lift-per-point atlas, this atlas explicitly
contains the inverse of every covering sheet.  Its `chartAt` is unchanged. -/
noncomputable def allCoveringSheetsChartedSpaceH :
    ChartedSpace ℍ GammaTwoQuotient where
  atlas := Set.range (fun z : ℍ => (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).symm)
  chartAt := QYM.FullCertification.P2GammaTwoFreeActionExtension.quotientChartAtH
  mem_chart_source := QYM.FullCertification.P2GammaTwoFreeActionExtension.mem_quotientChartAtH_source
  chart_mem_atlas x := ⟨QYM.FullCertification.P2GammaTwoFreeActionExtension.quotientLift x, rfl⟩

/-- Smooth maps of the upper half-plane, expressed as a pregroupoid.  This is
the intermediate groupoid needed before composing the `ℍ` atlas with the
standard complex atlas of `ℍ`. -/
def upperHalfPlaneSmoothPregroupoid : Pregroupoid ℍ where
  property f s := ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ f s
  comp hf hg _ _ _ := hg.comp' hf
  id_mem := contMDiff_id.contMDiffOn
  locality _ h := contMDiffOn_of_locally_contMDiffOn h
  congr _ hfg hf := hf.congr hfg

/-- The structure groupoid whose maps and inverses are smooth maps of `ℍ`. -/
def upperHalfPlaneSmoothGroupoid : StructureGroupoid ℍ :=
  upperHalfPlaneSmoothPregroupoid.groupoid

/-- The exact missing smoothness statement for the all-covering-sheets atlas:
every transition from one sheet to another is smooth on its natural source.
The reverse transition is the same assertion with `z` and `w` exchanged. -/
def SmoothTransitionResidual : Prop :=
  ∀ z w : ℍ,
    ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞
      ((QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).trans
        (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).symm)
      ((QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).trans
        (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt w).symm).source

/-- The residual is sufficient to make the all-sheets `ℍ` atlas compatible
with the intermediate smooth groupoid. -/
theorem allCoveringSheets_hasGroupoid
    (hSmooth : SmoothTransitionResidual) :
    letI : ChartedSpace ℍ GammaTwoQuotient :=
      allCoveringSheetsChartedSpaceH
    HasGroupoid GammaTwoQuotient upperHalfPlaneSmoothGroupoid := by
  letI : ChartedSpace ℍ GammaTwoQuotient :=
    allCoveringSheetsChartedSpaceH
  apply hasGroupoid_of_pregroupoid upperHalfPlaneSmoothPregroupoid
  intro e e' he he'
  change e ∈ Set.range
    (fun z : ℍ => (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).symm) at he
  change e' ∈ Set.range
    (fun z : ℍ => (QYM.FullCertification.P2GammaTwoFreeActionExtension.upstairsLocalHomeomorphAt z).symm) at he'
  rcases he with ⟨z, rfl⟩
  rcases he' with ⟨w, rfl⟩
  simpa only [upperHalfPlaneSmoothPregroupoid,
    OpenPartialHomeomorph.symm_symm] using hSmooth z w

section ConditionalSmoothAtlas

variable (hSmooth : SmoothTransitionResidual)

local instance conditionalChartedSpaceH :
    ChartedSpace ℍ GammaTwoQuotient :=
  allCoveringSheetsChartedSpaceH

/-- Compose the all-sheets atlas with the standard complex atlas on `ℍ`. -/
local instance conditionalChartedSpaceComplex :
    ChartedSpace ℂ GammaTwoQuotient :=
  ChartedSpace.comp ℂ ℍ GammaTwoQuotient

/-- Conditional construction of the genuine smooth quotient manifold.  The
only hypothesis is `SmoothTransitionResidual`; no additional topological or
atlas premise is hidden in this theorem. -/
theorem gammaTwoQuotient_isManifold_of_smoothTransitionResidual
    (hSmooth : SmoothTransitionResidual) :
    IsManifold 𝓘(ℂ) ∞ GammaTwoQuotient := by
  letI : HasGroupoid GammaTwoQuotient upperHalfPlaneSmoothGroupoid :=
    allCoveringSheets_hasGroupoid hSmooth
  letI : HasGroupoid GammaTwoQuotient (contDiffGroupoid ∞ 𝓘(ℂ)) := by
    apply StructureGroupoid.HasGroupoid.comp upperHalfPlaneSmoothGroupoid
    intro e he
    rw [isLocalStructomorphOn_contDiffGroupoid_iff]
    change
      ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e e.source ∧
        ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e.symm e.target at he
    exact he
  exact IsManifold.mk' 𝓘(ℂ) ∞ GammaTwoQuotient

/-! ## 5. Open stage interiors -/

/-- The largest open submanifold canonically contained in the intrinsic closed
stage.  The closed subtype itself is not an `Opens`, so Mathlib's manifold
inclusion theorem does not apply directly to `IStage.X Y`. -/
def interiorStage (Y : ℝ) : TopologicalSpace.Opens GammaTwoQuotient :=
  ⟨interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y), isOpen_interior⟩

/-- Monotonicity of the closed stages induces monotonicity of their open
interiors. -/
theorem interiorStage_mono {Y Z : ℝ} (hYZ : Y ≤ Z) :
    interiorStage Y ≤ interiorStage Z :=
  interior_mono (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone hYZ)

/-- The canonical open-stage inclusion. -/
def interiorStageInclusion {Y Z : ℝ} (hYZ : Y ≤ Z) :
    interiorStage Y → interiorStage Z :=
  TopologicalSpace.Opens.inclusion (interiorStage_mono hYZ)

/-- Under the exact atlas-transition residual, every open-stage inclusion is
smooth. -/
theorem interiorStageInclusion_contMDiff
    (hSmooth : SmoothTransitionResidual)
    {Y Z : ℝ} (hYZ : Y ≤ Z) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (interiorStageInclusion hYZ) := by
  letI : HasGroupoid GammaTwoQuotient upperHalfPlaneSmoothGroupoid :=
    allCoveringSheets_hasGroupoid hSmooth
  letI : HasGroupoid GammaTwoQuotient (contDiffGroupoid ∞ 𝓘(ℂ)) := by
    apply StructureGroupoid.HasGroupoid.comp upperHalfPlaneSmoothGroupoid
    intro e he
    rw [isLocalStructomorphOn_contDiffGroupoid_iff]
    change
      ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e e.source ∧
        ContMDiffOn 𝓘(ℂ) 𝓘(ℂ) ∞ e.symm e.target at he
    exact he
  letI : IsManifold 𝓘(ℂ) ∞ GammaTwoQuotient :=
    IsManifold.mk' 𝓘(ℂ) ∞ GammaTwoQuotient
  exact contMDiff_inclusion (interiorStage_mono hYZ)

end ConditionalSmoothAtlas

/-! ## 6. The remaining cusp-collar datum -/

/-- Exact residual for a genuine collar chart around the embedded cusp
circle.  It asks for an open partial homeomorphism to a product strip which
sends the certified circle to the central horizontal slice.  The embedded
circle proved above supplies the zero-thickness endpoint; a proof of this
proposition requires a uniform orbit-separation argument on a thickened
horocycle, not merely the pointwise high-cusp bridge used for injectivity. -/
def CuspCollarResidual
    (q : GammaTwoRightCoset) (Y : ℝ) : Prop :=
  ∃ epsilon : ℝ, 0 < epsilon ∧
    ∃ e : OpenPartialHomeomorph
        GammaTwoQuotient (WidthTwoCircle × ℝ),
      e.target =
        Set.univ ×ˢ
          Set.Ioo (gammaTwoCuspLevel Y - epsilon)
            (gammaTwoCuspLevel Y + epsilon) ∧
      Set.range (selectedCuspCircle q Y) ⊆ e.source ∧
      ∀ theta : WidthTwoCircle,
        e (selectedCuspCircle q Y theta) =
          (theta, gammaTwoCuspLevel Y)

/-- The full remaining path-A payload, with the atlas and collar obligations
kept visibly separate. -/
def SmoothQuotientAndCuspCollarResidual : Prop :=
  SmoothTransitionResidual ∧
    ∀ (q : GammaTwoRightCoset) (Y : ℝ),
      2 ≤ gammaTwoCuspLevel Y → CuspCollarResidual q Y

end QYM.FullCertification.P2SmoothQuotientAtlasExtension

