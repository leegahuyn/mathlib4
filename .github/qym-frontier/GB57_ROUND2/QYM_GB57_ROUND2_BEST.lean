    actualCutoffEscapeWitness_ne_zero q n,
    actualCutoffEscapeHamiltonian_escapeWitness_eq_self q n⟩

/-- The excitation projection has operator norm at least one at every stage.
This lower bound is witnessed by the concrete fixed escape-band vector. -/
theorem actualCutoffEscapeHamiltonian_norm_ge_one
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    (1 : ℝ) ≤ ‖QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n‖ := by
  let w := actualCutoffEscapeWitness q n
  have hw : w ≠ 0 := actualCutoffEscapeWitness_ne_zero q n
  have hFixed : QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n w = w :=
    actualCutoffEscapeHamiltonian_escapeWitness_eq_self q n
  have hOp := (QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n).le_opNorm w
  rw [hFixed] at hOp
  have hwNorm : 0 < ‖w‖ := norm_pos_iff.mpr hw
