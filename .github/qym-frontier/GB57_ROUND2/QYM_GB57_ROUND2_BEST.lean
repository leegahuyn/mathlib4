namespace QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension














/-!
# P6: the explicit discriminant potential on the actual finite-stage `L²` space

This file restricts the already constructed discriminant Petersson potential
from the literal quotient `Gamma(2) \ H` to the intrinsic compact stage
`I.X Y`.  It then constructs multiplication by that concrete function on the
actual inverse-eta `L²` section carrier from P3.

The construction is deliberately representative-level before it is bundled:

* the pointwise product is written down;
* strong measurability and the `L²` estimate are proved from the explicit
  global bound;
* `MemLp.toLp` produces the equivalence class;
* additivity and complex homogeneity are proved by `Lp.ext` and a.e.
  representative formulae;
* only then is the map bundled as a continuous linear operator.

Consequently no bounded-potential supplier, form-bound field, symmetry field,
or residual analytic obligation is used.  The relative form coefficient is
literally zero.  The last section couples the same operator to the existing
safe physical-sector profile `min (coupling sector)^2 1`, so arbitrary signed
real couplings still give a nonnegative, uniformly bounded potential.
-/

/-! ## 1. Restriction of the explicit quotient potential -/

/-- The discriminant Petersson potential restricted to the actual intrinsic
stage.  The subtype coercion is the genuine inclusion into the orbit
quotient. -/
noncomputable def actualStageDiscriminantPotential
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℝ :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.potential (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)

@[simp]
theorem actualStageDiscriminantPotential_apply
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantPotential Y x =
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.potential (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :=
  rfl

/-- Restriction preserves continuity. -/
theorem actualStageDiscriminantPotential_continuous (Y : ℝ) :
    Continuous (actualStageDiscriminantPotential Y) := by
  exact Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.potential_continuous.comp continuous_subtype_val

/-- In particular the stage potential is Borel measurable. -/
theorem actualStageDiscriminantPotential_measurable (Y : ℝ) :
    Measurable (actualStageDiscriminantPotential Y) :=
  (actualStageDiscriminantPotential_continuous Y).measurable

/-- The restricted discriminant potential remains strictly positive. -/
theorem actualStageDiscriminantPotential_pos
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    0 < actualStageDiscriminantPotential Y x :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.potential_pos (actualStageBasePoint x)

/-- Pointwise nonnegativity, used in the form and sector estimates. -/
theorem actualStageDiscriminantPotential_nonneg
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    0 ≤ actualStageDiscriminantPotential Y x :=
  (actualStageDiscriminantPotential_pos Y x).le

/-- The global explicit bound restricts without any loss. -/
theorem actualStageDiscriminantPotential_le_uniformBound
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantPotential Y x ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.potential_le_uniformBound (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)

/-- The potential takes values in the explicit closed interval. -/
theorem actualStageDiscriminantPotential_mem_Icc
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantPotential Y x ∈
      Set.Icc (0 : ℝ) Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
  ⟨actualStageDiscriminantPotential_nonneg Y x,
    actualStageDiscriminantPotential_le_uniformBound Y x⟩

/-- Absolute-value version of the same uniform bound. -/
theorem abs_actualStageDiscriminantPotential_le
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    |actualStageDiscriminantPotential Y x| ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  rw [abs_of_nonneg (actualStageDiscriminantPotential_nonneg Y x)]
  exact actualStageDiscriminantPotential_le_uniformBound Y x

/-- Complex scalar used for multiplication on complex-valued `L²` sections. -/
noncomputable def actualStageDiscriminantPotentialComplex
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℂ :=
  (actualStageDiscriminantPotential Y x : ℂ)

@[simp]
theorem actualStageDiscriminantPotentialComplex_apply
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantPotentialComplex Y x =
      (actualStageDiscriminantPotential Y x : ℂ) :=
  rfl

/-- The complex-valued version is continuous as well. -/
theorem actualStageDiscriminantPotentialComplex_continuous (Y : ℝ) :
    Continuous (actualStageDiscriminantPotentialComplex Y) := by
  exact Complex.continuous_ofReal.comp
    (actualStageDiscriminantPotential_continuous Y)

/-- Strong measurability in the actual stage measure. -/
theorem actualStageDiscriminantPotentialComplex_aestronglyMeasurable
    (Y : ℝ) :
    AEStronglyMeasurable
      (actualStageDiscriminantPotentialComplex Y)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) :=
  (actualStageDiscriminantPotentialComplex_continuous Y).aestronglyMeasurable

/-- Because the scalar is real and nonnegative, its complex norm is the
scalar itself. -/
@[simp]
theorem norm_actualStageDiscriminantPotentialComplex
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantPotentialComplex Y x‖ =
      actualStageDiscriminantPotential Y x := by
  rw [actualStageDiscriminantPotentialComplex, Complex.norm_real,
    Real.norm_of_nonneg (actualStageDiscriminantPotential_nonneg Y x)]

/-- Explicit pointwise complex-norm bound. -/
theorem norm_actualStageDiscriminantPotentialComplex_le
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantPotentialComplex Y x‖ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  rw [norm_actualStageDiscriminantPotentialComplex]
  exact actualStageDiscriminantPotential_le_uniformBound Y x

/-! ## 2. Representative-level multiplication and `L²` membership -/

/-- Literal pointwise product before passing to the `L²` equivalence class. -/
noncomputable def actualStageDiscriminantProduct
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℂ :=
  actualStageDiscriminantPotentialComplex Y x * u x

@[simp]
theorem actualStageDiscriminantProduct_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantProduct Y u x =
      actualStageDiscriminantPotentialComplex Y x * u x :=
  rfl

/-- The representative product is strongly measurable. -/
theorem actualStageDiscriminantProduct_aestronglyMeasurable
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    AEStronglyMeasurable
      (actualStageDiscriminantProduct Y u)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  exact
    (actualStageDiscriminantPotentialComplex_aestronglyMeasurable Y).mul
      (MeasureTheory.Lp.aestronglyMeasurable u)

/-- The pointwise multiplication estimate with the paper's explicit global
constant. -/
theorem norm_actualStageDiscriminantProduct_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantProduct Y u x‖ ≤
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u x‖ := by
  rw [actualStageDiscriminantProduct, norm_mul,
    norm_actualStageDiscriminantPotentialComplex]
  exact mul_le_mul_of_nonneg_right
    (actualStageDiscriminantPotential_le_uniformBound Y x) (norm_nonneg _)

/-- Multiplication by the explicit bounded scalar preserves `L²`. -/
theorem actualStageDiscriminantProduct_memLp
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    MemLp (actualStageDiscriminantProduct Y u) 2
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  exact (MeasureTheory.Lp.memLp u).of_le_mul
    (actualStageDiscriminantProduct_aestronglyMeasurable Y u)
    (Filter.Eventually.of_forall
      (norm_actualStageDiscriminantProduct_le Y u))

/-- The actual `L²` class obtained from pointwise multiplication. -/
noncomputable def actualStageDiscriminantMul
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (actualStageDiscriminantProduct_memLp Y u).toLp
    (actualStageDiscriminantProduct Y u)

/-- The constructed class has the literal product as an a.e. representative. -/
theorem actualStageDiscriminantMul_coeFn_ae
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ((actualStageDiscriminantMul Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      actualStageDiscriminantProduct Y u :=
  (actualStageDiscriminantProduct_memLp Y u).coeFn_toLp

/-- Multiplication is additive at the `L²` class level. -/
theorem actualStageDiscriminantMul_add
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantMul Y (u + v) =
      actualStageDiscriminantMul Y u + actualStageDiscriminantMul Y v := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageDiscriminantMul_coeFn_ae Y (u + v),
      actualStageDiscriminantMul_coeFn_ae Y u,
      actualStageDiscriminantMul_coeFn_ae Y v,
      MeasureTheory.Lp.coeFn_add u v,
      MeasureTheory.Lp.coeFn_add
        (actualStageDiscriminantMul Y u)
        (actualStageDiscriminantMul Y v)]
    with x hsum hu hv huv hout
  rw [hsum, hout, actualStageDiscriminantProduct_apply, huv,
    Pi.add_apply, Pi.add_apply, hu,
    actualStageDiscriminantProduct_apply, hv,
    actualStageDiscriminantProduct_apply, mul_add]

/-- Multiplication is complex homogeneous at the `L²` class level. -/
theorem actualStageDiscriminantMul_smul
    (Y : ℝ) (c : ℂ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantMul Y (c • u) =
      c • actualStageDiscriminantMul Y u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageDiscriminantMul_coeFn_ae Y (c • u),
      actualStageDiscriminantMul_coeFn_ae Y u,
      MeasureTheory.Lp.coeFn_smul c u,
      MeasureTheory.Lp.coeFn_smul c
        (actualStageDiscriminantMul Y u)]
    with x hleft hu hcu hright
  rw [hleft, hright, actualStageDiscriminantProduct_apply, hcu,
    Pi.smul_apply, Pi.smul_apply, hu,
    actualStageDiscriminantProduct_apply]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- The `L²` norm bound follows from the representative-level estimate. -/
theorem norm_actualStageDiscriminantMul_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageDiscriminantMul Y u‖ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ := by
  apply MeasureTheory.Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [actualStageDiscriminantMul_coeFn_ae Y u] with x hx
  rw [hx]
  exact norm_actualStageDiscriminantProduct_le Y u x

/-! ## 3. The genuine bounded multiplication operator -/

/-- Algebraic complex-linear multiplication map. -/
noncomputable def actualStageDiscriminantPotentialLinearMap (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y where
  toFun := actualStageDiscriminantMul Y
  map_add' := actualStageDiscriminantMul_add Y
  map_smul' := actualStageDiscriminantMul_smul Y

@[simp]
theorem actualStageDiscriminantPotentialLinearMap_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialLinearMap Y u =
      actualStageDiscriminantMul Y u :=
  rfl

/-- Continuous linear multiplication by the restricted discriminant
potential. -/
noncomputable def actualStageDiscriminantPotentialOperator (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (actualStageDiscriminantPotentialLinearMap Y).mkContinuous
    Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound (norm_actualStageDiscriminantMul_le Y)

@[simp]
theorem actualStageDiscriminantPotentialOperator_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialOperator Y u =
      actualStageDiscriminantMul Y u :=
  rfl

/-- A.e. representative formula for the bundled continuous operator. -/
theorem actualStageDiscriminantPotentialOperator_coeFn_ae
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ((actualStageDiscriminantPotentialOperator Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      fun x => actualStageDiscriminantPotentialComplex Y x * u x := by
  change
    ((actualStageDiscriminantMul Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
      QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
        QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      actualStageDiscriminantProduct Y u
  exact actualStageDiscriminantMul_coeFn_ae Y u

/-- Apply-norm form of boundedness. -/
theorem norm_actualStageDiscriminantPotentialOperator_apply_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageDiscriminantPotentialOperator Y u‖ ≤
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ :=
  norm_actualStageDiscriminantMul_le Y u

/-- Explicit operator-norm bound. -/
theorem norm_actualStageDiscriminantPotentialOperator_le (Y : ℝ) :
    ‖actualStageDiscriminantPotentialOperator Y‖ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  exact LinearMap.mkContinuous_norm_le
    (actualStageDiscriminantPotentialLinearMap Y)
    Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound_pos.le
    (norm_actualStageDiscriminantMul_le Y)

/-- The multiplier is symmetric on the whole actual stage `L²` Hilbert
space, proved from the a.e. real-valued representative. -/
theorem actualStageDiscriminantPotentialOperator_inner_symmetric
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    inner ℂ (actualStageDiscriminantPotentialOperator Y u) v =
      inner ℂ u (actualStageDiscriminantPotentialOperator Y v) := by
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards
    [actualStageDiscriminantPotentialOperator_coeFn_ae Y u,
      actualStageDiscriminantPotentialOperator_coeFn_ae Y v]
    with x hu hv
  rw [hu, hv]
  simpa only [actualStageDiscriminantPotentialComplex_apply, smul_eq_mul] using
    (show
      inner ℂ
          ((actualStageDiscriminantPotential Y x : ℂ) • u x) (v x) =
        inner ℂ (u x)
          ((actualStageDiscriminantPotential Y x : ℂ) • v x) by
      rw [inner_smul_left, inner_smul_right, starRingEnd_apply,
        Complex.star_def, Complex.conj_ofReal])

/-! ## 4. The bounded nonnegative Hermitian form -/

/-- The bounded potential form, with the convention that the first variable
is conjugate-linear and the second variable is linear. -/
noncomputable def actualStageDiscriminantForm
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : ℂ :=
  inner ℂ u (actualStageDiscriminantPotentialOperator Y v)

@[simp]
theorem actualStageDiscriminantForm_apply
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y u v =
      inner ℂ u (actualStageDiscriminantPotentialOperator Y v) :=
  rfl

/-- Integral formula for the actual bounded form.  This records the concrete
multiplier in the form API instead of leaving the operator representation
opaque. -/
theorem actualStageDiscriminantForm_eq_integral
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y u v =
      ∫ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y,
        inner ℂ (u x)
          ((actualStageDiscriminantPotential Y x : ℂ) • v x)
        ∂(QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  rw [actualStageDiscriminantForm, MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards
    [actualStageDiscriminantPotentialOperator_coeFn_ae Y v]
    with x hx
  rw [hx]
  simp only [actualStageDiscriminantPotentialComplex_apply, smul_eq_mul]

theorem actualStageDiscriminantForm_add_left
    (Y : ℝ) (u v w : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y (u + v) w =
      actualStageDiscriminantForm Y u w +
        actualStageDiscriminantForm Y v w := by
  simp only [actualStageDiscriminantForm, inner_add_left]

theorem actualStageDiscriminantForm_add_right
    (Y : ℝ) (u v w : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y u (v + w) =
      actualStageDiscriminantForm Y u v +
        actualStageDiscriminantForm Y u w := by
  simp only [actualStageDiscriminantForm, map_add, inner_add_right]

theorem actualStageDiscriminantForm_smul_left
    (Y : ℝ) (c : ℂ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y (c • u) v =
      conj c * actualStageDiscriminantForm Y u v := by
  simp only [actualStageDiscriminantForm, inner_smul_left]

theorem actualStageDiscriminantForm_smul_right
    (Y : ℝ) (c : ℂ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantForm Y u (c • v) =
      c * actualStageDiscriminantForm Y u v := by
  simp only [actualStageDiscriminantForm, map_smul, inner_smul_right]

/-- Hermitian conjugate symmetry follows from the proved operator symmetry. -/
theorem actualStageDiscriminantForm_conj_symm
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    conj (actualStageDiscriminantForm Y v u) =
      actualStageDiscriminantForm Y u v := by
  calc
    conj (actualStageDiscriminantForm Y v u) =
        inner ℂ (actualStageDiscriminantPotentialOperator Y u) v :=
      inner_conj_symm _ _
    _ = inner ℂ u (actualStageDiscriminantPotentialOperator Y v) :=
      actualStageDiscriminantPotentialOperator_inner_symmetric Y u v
    _ = actualStageDiscriminantForm Y u v := rfl

/-- Two-variable boundedness of the actual potential form. -/
theorem norm_actualStageDiscriminantForm_le
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageDiscriminantForm Y u v‖ ≤
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ * ‖v‖ := by
  calc
    ‖actualStageDiscriminantForm Y u v‖ ≤
        ‖u‖ * ‖actualStageDiscriminantPotentialOperator Y v‖ := by
      exact norm_inner_le_norm _ _
    _ ≤ ‖u‖ * (Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖v‖) :=
      mul_le_mul_of_nonneg_left
        (norm_actualStageDiscriminantPotentialOperator_apply_le Y v)
        (norm_nonneg u)
    _ = Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ * ‖v‖ := by ring

/-- The diagonal is the integral of a pointwise nonnegative real density. -/
theorem actualStageDiscriminantForm_self_re_nonneg
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    0 ≤ (actualStageDiscriminantForm Y u u).re := by
  rw [actualStageDiscriminantForm, MeasureTheory.L2.inner_def]
  rw [← RCLike.re_eq_complex_re]
  rw [← integral_re (𝕜 := ℂ)
    (MeasureTheory.L2.integrable_inner u
      (actualStageDiscriminantPotentialOperator Y u))]
  apply integral_nonneg_of_ae
  filter_upwards
    [actualStageDiscriminantPotentialOperator_coeFn_ae Y u]
    with x hx
  rw [hx]
  change
    0 ≤
      (inner ℂ (u x)
        ((actualStageDiscriminantPotential Y x : ℂ) • u x)).re
  rw [inner_smul_right]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  exact mul_nonneg
    (actualStageDiscriminantPotential_nonneg Y x)
    (inner_self_nonneg (𝕜 := ℂ) (x := u x))

/-- The diagonal form is real. -/
theorem actualStageDiscriminantForm_self_im_eq_zero
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    (actualStageDiscriminantForm Y u u).im = 0 := by
  have hconj := actualStageDiscriminantForm_conj_symm Y u u
  exact Complex.conj_eq_iff_im.mp hconj

/-- Explicit quadratic form bound. -/
theorem abs_actualStageDiscriminantForm_self_re_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    |(actualStageDiscriminantForm Y u u).re| ≤
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ ^ 2 := by
  calc
    |(actualStageDiscriminantForm Y u u).re| ≤
        ‖actualStageDiscriminantForm Y u u‖ :=
      Complex.abs_re_le_norm _
    _ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ * ‖u‖ :=
      norm_actualStageDiscriminantForm_le Y u u
    _ = Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ ^ 2 := by ring

/-- Bounded multiplication is infinitesimally form-bounded with exact
relative coefficient zero against every candidate kinetic energy.  No
property of the kinetic energy is assumed or hidden. -/
theorem actualStageDiscriminantForm_relative_bound_zero
    (Y : ℝ)
    (kineticEnergy : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y → ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    |(actualStageDiscriminantForm Y u u).re| ≤
      0 * kineticEnergy u + Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ ^ 2 := by
  simpa only [zero_mul, zero_add] using
    abs_actualStageDiscriminantForm_self_re_le Y u

/-- The relative coefficient in the preceding theorem is strictly below
one, as needed by KLMN-style APIs. -/
theorem actualStageDiscriminantForm_relative_coefficient_lt_one :
    (0 : ℝ) < 1 :=
  zero_lt_one

/-- The additive constant in the zero-relative-bound estimate is
nonnegative. -/
theorem actualStageDiscriminantForm_bound_constant_nonneg :
    0 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound_pos.le

/-! ## 5. Safe physical-sector coupling -/

/-- The actual stage potential after coupling to the existing safe physical
sector coefficient. -/
noncomputable def actualStageSectorDiscriminantPotential
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℝ :=
  QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector *
    actualStageDiscriminantPotential Y x

@[simp]
theorem actualStageSectorDiscriminantPotential_apply
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential sector Y x =
      QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector *
        actualStageDiscriminantPotential Y x :=
  rfl

/-- Sector-coupled continuity. -/
theorem actualStageSectorDiscriminantPotential_continuous
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    Continuous (actualStageSectorDiscriminantPotential sector Y) := by
  exact continuous_const.mul
    (actualStageDiscriminantPotential_continuous Y)

/-- Sector-coupled measurability. -/
theorem actualStageSectorDiscriminantPotential_measurable
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    Measurable (actualStageSectorDiscriminantPotential sector Y) :=
  (actualStageSectorDiscriminantPotential_continuous sector Y).measurable

/-- Every physical sector gives a nonnegative potential, including a real
coupling of either sign. -/
theorem actualStageSectorDiscriminantPotential_nonneg
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    0 ≤ actualStageSectorDiscriminantPotential sector Y x := by
  exact mul_nonneg (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)
    (actualStageDiscriminantPotential_nonneg Y x)

/-- Refined pointwise bound retaining the sector coefficient. -/
theorem actualStageSectorDiscriminantPotential_le_coefficient_mul
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential sector Y x ≤
      QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  exact mul_le_mul_of_nonneg_left
    (actualStageDiscriminantPotential_le_uniformBound Y x)
    (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)

/-- Uniform pointwise bound independent of the sector. -/
theorem actualStageSectorDiscriminantPotential_le_uniformBound
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential sector Y x ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  calc
    actualStageSectorDiscriminantPotential sector Y x ≤
        1 * actualStageDiscriminantPotential Y x := by
      exact mul_le_mul_of_nonneg_right
        (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_le_one sector)
        (actualStageDiscriminantPotential_nonneg Y x)
    _ = actualStageDiscriminantPotential Y x := one_mul _
    _ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
      actualStageDiscriminantPotential_le_uniformBound Y x

/-- Closed-interval packaging of sector nonnegativity and the uniform
bound. -/
theorem actualStageSectorDiscriminantPotential_mem_Icc
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential sector Y x ∈
      Set.Icc (0 : ℝ) Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
  ⟨actualStageSectorDiscriminantPotential_nonneg sector Y x,
    actualStageSectorDiscriminantPotential_le_uniformBound sector Y x⟩

/-- The sector-coupled continuous multiplication operator. -/
noncomputable def actualStageSectorDiscriminantPotentialOperator
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector : ℂ) •
    actualStageDiscriminantPotentialOperator Y

@[simp]
theorem actualStageSectorDiscriminantPotentialOperator_apply
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageSectorDiscriminantPotentialOperator sector Y u =
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector : ℂ) •
        actualStageDiscriminantPotentialOperator Y u :=
  rfl

/-- Representative formula for the sector-coupled operator. -/
theorem actualStageSectorDiscriminantPotentialOperator_coeFn_ae
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ((actualStageSectorDiscriminantPotentialOperator sector Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      fun x =>
        (actualStageSectorDiscriminantPotential sector Y x : ℂ) * u x := by
  filter_upwards
    [MeasureTheory.Lp.coeFn_smul
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector : ℂ)
      (actualStageDiscriminantPotentialOperator Y u),
      actualStageDiscriminantPotentialOperator_coeFn_ae Y u]
    with x hsmul hbase
  rw [actualStageSectorDiscriminantPotentialOperator_apply, hsmul,
    Pi.smul_apply, hbase]
  simp only [Pi.smul_apply, smul_eq_mul,
    actualStageSectorDiscriminantPotential_apply,
    actualStageDiscriminantPotentialComplex_apply, Complex.ofReal_mul]
  ring

/-- Sector-refined apply-norm estimate. -/
theorem norm_actualStageSectorDiscriminantPotentialOperator_apply_le
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageSectorDiscriminantPotentialOperator sector Y u‖ ≤
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) * ‖u‖ := by
  rw [actualStageSectorDiscriminantPotentialOperator_apply, norm_smul,
    Complex.norm_real,
    Real.norm_of_nonneg (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)]
  calc
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector *
        ‖actualStageDiscriminantPotentialOperator Y u‖ ≤
      QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * (Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖) :=
        mul_le_mul_of_nonneg_left
          (norm_actualStageDiscriminantPotentialOperator_apply_le Y u)
          (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)
    _ = (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) * ‖u‖ := by
      ring

/-- Refined operator-norm estimate. -/
theorem norm_actualStageSectorDiscriminantPotentialOperator_le_coefficient
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    ‖actualStageSectorDiscriminantPotentialOperator sector Y‖ ≤
      QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  rw [actualStageSectorDiscriminantPotentialOperator, norm_smul,
    Complex.norm_real,
    Real.norm_of_nonneg (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)]
  exact mul_le_mul_of_nonneg_left
    (norm_actualStageDiscriminantPotentialOperator_le Y)
    (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)

/-- Uniform operator-norm estimate independent of the physical sector. -/
theorem norm_actualStageSectorDiscriminantPotentialOperator_le
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    ‖actualStageSectorDiscriminantPotentialOperator sector Y‖ ≤
      Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  calc
    ‖actualStageSectorDiscriminantPotentialOperator sector Y‖ ≤
        QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
      norm_actualStageSectorDiscriminantPotentialOperator_le_coefficient
        sector Y
    _ ≤ 1 * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
      mul_le_mul_of_nonneg_right
        (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_le_one sector)
        Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound_pos.le
    _ = Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := one_mul _

/-- Symmetry is preserved by the safe real sector coefficient. -/
theorem actualStageSectorDiscriminantPotentialOperator_inner_symmetric
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    inner ℂ (actualStageSectorDiscriminantPotentialOperator sector Y u) v =
      inner ℂ u
        (actualStageSectorDiscriminantPotentialOperator sector Y v) := by
  rw [actualStageSectorDiscriminantPotentialOperator_apply,
    actualStageSectorDiscriminantPotentialOperator_apply,
    inner_smul_left, inner_smul_right, starRingEnd_apply,
    Complex.star_def, Complex.conj_ofReal,
    actualStageDiscriminantPotentialOperator_inner_symmetric Y u v]

/-- The sector-coupled bounded Hermitian form. -/
noncomputable def actualStageSectorDiscriminantForm
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : ℂ :=
  inner ℂ u (actualStageSectorDiscriminantPotentialOperator sector Y v)

/-- The sector form is exactly the safe real coefficient times the base
discriminant form. -/
theorem actualStageSectorDiscriminantForm_eq_coefficient_mul
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageSectorDiscriminantForm sector Y u v =
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector : ℂ) *
        actualStageDiscriminantForm Y u v := by
  rw [actualStageSectorDiscriminantForm,
    actualStageSectorDiscriminantPotentialOperator_apply,
    actualStageDiscriminantForm, inner_smul_right]

/-- Hermitian conjugate symmetry of every sector form. -/
theorem actualStageSectorDiscriminantForm_conj_symm
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    conj (actualStageSectorDiscriminantForm sector Y v u) =
      actualStageSectorDiscriminantForm sector Y u v := by
  calc
    conj (actualStageSectorDiscriminantForm sector Y v u) =
        inner ℂ
          (actualStageSectorDiscriminantPotentialOperator sector Y u) v :=
      inner_conj_symm _ _
    _ = inner ℂ u
        (actualStageSectorDiscriminantPotentialOperator sector Y v) :=
      actualStageSectorDiscriminantPotentialOperator_inner_symmetric
        sector Y u v
    _ = actualStageSectorDiscriminantForm sector Y u v := rfl

/-- Nonnegative quadratic form for every physical sector. -/
theorem actualStageSectorDiscriminantForm_self_re_nonneg
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    0 ≤ (actualStageSectorDiscriminantForm sector Y u u).re := by
  rw [actualStageSectorDiscriminantForm_eq_coefficient_mul]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  exact mul_nonneg (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)
    (actualStageDiscriminantForm_self_re_nonneg Y u)

/-- Refined two-variable sector form bound. -/
theorem norm_actualStageSectorDiscriminantForm_le
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageSectorDiscriminantForm sector Y u v‖ ≤
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) * ‖u‖ * ‖v‖ := by
  calc
    ‖actualStageSectorDiscriminantForm sector Y u v‖ ≤
        ‖u‖ *
          ‖actualStageSectorDiscriminantPotentialOperator sector Y v‖ := by
      exact norm_inner_le_norm _ _
    _ ≤ ‖u‖ *
        ((QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) * ‖v‖) :=
      mul_le_mul_of_nonneg_left
        (norm_actualStageSectorDiscriminantPotentialOperator_apply_le
          sector Y v)
        (norm_nonneg u)
    _ = (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) *
        ‖u‖ * ‖v‖ := by ring

/-- Exact relative form bound zero for the sector family. -/
theorem actualStageSectorDiscriminantForm_relative_bound_zero
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ)
    (kineticEnergy : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y → ℝ)
    (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    |(actualStageSectorDiscriminantForm sector Y u u).re| ≤
      0 * kineticEnergy u +
        (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) * ‖u‖ ^ 2 := by
  rw [zero_mul, zero_add]
  calc
    |(actualStageSectorDiscriminantForm sector Y u u).re| ≤
        ‖actualStageSectorDiscriminantForm sector Y u u‖ :=
      Complex.abs_re_le_norm _
    _ ≤ (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) *
        ‖u‖ * ‖u‖ :=
      norm_actualStageSectorDiscriminantForm_le sector Y u u
    _ = (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) *
        ‖u‖ ^ 2 := by ring

/-- The sector-dependent additive form-bound constant is nonnegative. -/
theorem actualStageSectorDiscriminantForm_bound_constant_nonneg
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) :
    0 ≤ QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient sector * Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound :=
  mul_nonneg (QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_nonneg sector)
    Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound_pos.le

/-- A real coupling is converted to `min (r²) 1`; this theorem exposes the
formula rather than hiding it behind the sector tag. -/
@[simp]
theorem actualStageSectorDiscriminantPotential_ofCoupling
    (r Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential (QYM.FullCertification.P1NotationFirewall.QSector.ofCoupling r) Y x =
      QYM.FullCertification.P1AdmissibleBackgroundExtension.safeCouplingProfile r * actualStageDiscriminantPotential Y x := by
  rw [actualStageSectorDiscriminantPotential,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofCoupling]

/-- Charge sectors carry the neutral coefficient in the first safe family. -/
@[simp]
theorem actualStageSectorDiscriminantPotential_ofCharge
    (charge : QYM.FullCertification.P1NotationFirewall.ResidueCharge) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential (QYM.FullCertification.P1NotationFirewall.QSector.ofCharge charge) Y x = 0 := by
  rw [actualStageSectorDiscriminantPotential,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofCharge, zero_mul]

/-- Background-holonomy sectors also carry the neutral coefficient in the
first safe family. -/
@[simp]
theorem actualStageSectorDiscriminantPotential_ofBackgroundHolonomy
    (phase : QYM.FullCertification.P1NotationFirewall.UnitaryHolonomy) (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectorDiscriminantPotential
      (QYM.FullCertification.P1NotationFirewall.QSector.ofBackgroundHolonomy phase) Y x = 0 := by
  rw [actualStageSectorDiscriminantPotential,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofBackgroundHolonomy, zero_mul]

/-- The coupling-sector operator exposes the same safe profile exactly. -/
@[simp]
theorem actualStageSectorDiscriminantPotentialOperator_ofCoupling
    (r Y : ℝ) :
    actualStageSectorDiscriminantPotentialOperator
      (QYM.FullCertification.P1NotationFirewall.QSector.ofCoupling r) Y =
      (QYM.FullCertification.P1AdmissibleBackgroundExtension.safeCouplingProfile r : ℂ) •
        actualStageDiscriminantPotentialOperator Y := by
  rw [actualStageSectorDiscriminantPotentialOperator,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofCoupling]

/-- The non-coupling neutral sector operators are literally zero. -/
@[simp]
theorem actualStageSectorDiscriminantPotentialOperator_ofCharge
    (charge : QYM.FullCertification.P1NotationFirewall.ResidueCharge) (Y : ℝ) :
    actualStageSectorDiscriminantPotentialOperator
      (QYM.FullCertification.P1NotationFirewall.QSector.ofCharge charge) Y = 0 := by
  rw [actualStageSectorDiscriminantPotentialOperator,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofCharge]
