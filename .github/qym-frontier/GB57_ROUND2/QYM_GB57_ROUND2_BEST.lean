/-!
# Supplier logic and no-go models for the Sobolev/gauge analytic tranche

This file isolates six analytic rows of the paper audit:

* Assumptions 3.5 and 3.6 (well-definedness and coercivity of the augmented action),
* Assumption 3.8 and the repeated cusp integration-by-parts claim 4.4,
* Assumption 4.8 (the Sobolev bilinear estimate), and
* the density prerequisite used in the proof of Lemma 4.16.

Lemma 4.16 itself additionally asserts closedness and nonnegativity of the quadratic form and the
existence and uniqueness of its nonnegative self-adjoint Friedrichs realization.  Those operator-
theoretic conclusions are outside this file; the `lemma4_16` declarations below certify only the
density supplier and the corresponding density-only no-go statement.

The project currently has no concrete modular quotient, bundle-valued Sobolev scale, trace map,
or Friedrichs representation theorem.  The definitions below therefore expose small typed
interfaces whose hypotheses are quantitative facts that a future analytic development must
supply.  The conclusions are proved from those hypotheses; none of the interfaces stores the
desired conclusion as a field.

Each weak premise used in the printed argument is also separated from its intended conclusion by
an explicit countermodel.  The countermodels are deliberately elementary (`Unit`, `Bool`, or
`ℕ`) so that the logical gap is independent of unavailable analytic infrastructure.
-/

namespace QYM.SobolevGaugeSupplierNoGo

open QYM.FullCertification.Registry

/-! ## Claim coverage -/

/-- The source rows whose missing suppliers are analyzed by this tranche.  Membership records
coverage of a supplier gap, not a complete certificate of every conclusion in the source row. -/
def coveredClaims : List ClaimId :=
  [.assumption3_5, .assumption3_6, .assumption3_8,
   .axiom4_4, .assumption4_8, .lemma4_16]

theorem coveredClaims_length : coveredClaims.length = 6 := by
  decide

theorem coveredClaims_nodup : coveredClaims.Nodup := by
  decide

/-! ## Row 15: a four-block action is well-defined only when its blocks are defined -/

/-- A scalar functional that may fail to return a finite real value.  `none` records the missing
measurability/integrability/finiteness supplier without pretending that an arbitrary value exists. -/
abbrev PartialScalarFunctional (X : Type*) := X → Option ℝ

/-- Assemble the four printed action blocks.  The result is defined exactly when all four block
values are present. -/
def assemblePartialAction {X : Type*}
    (leading mass data remainder : PartialScalarFunctional X) :
    PartialScalarFunctional X := fun x =>
  match leading x, mass x, data x, remainder x with
  | some l, some m, some v, some r => some (l + m + v + r)
  | _, _, _, _ => none

/-- A partial scalar functional is genuinely real-valued on every admissible configuration. -/
def IsDefinedOn {X : Type*}
    (admissible : X → Prop) (functional : PartialScalarFunctional X) : Prop :=
  ∀ x, admissible x → ∃ value : ℝ, functional x = some value

/-- A formal action has the advertised four-block decomposition.  This condition says nothing
about whether the individual blocks are defined. -/
def HasFourBlockDecomposition {X : Type*}
    (action leading mass data remainder : PartialScalarFunctional X) : Prop :=
  ∀ x, action x = assemblePartialAction leading mass data remainder x

/-- Separate definedness suppliers for the four blocks imply definedness of their assembled sum. -/
theorem action_definedOn_of_blocks_definedOn {X : Type*}
    (admissible : X → Prop)
    (leading mass data remainder : PartialScalarFunctional X)
    (hleading : IsDefinedOn admissible leading)
    (hmass : IsDefinedOn admissible mass)
    (hdata : IsDefinedOn admissible data)
    (hremainder : IsDefinedOn admissible remainder) :
    IsDefinedOn admissible
      (assemblePartialAction leading mass data remainder) := by
  intro x hx
  rcases hleading x hx with ⟨l, hl⟩
  rcases hmass x hx with ⟨m, hm⟩
  rcases hdata x hx with ⟨v, hv⟩
  rcases hremainder x hx with ⟨r, hr⟩
  refine ⟨l + m + v + r, ?_⟩
  simp [assemblePartialAction, hl, hm, hv, hr]

/-! ### Minimal well-definedness countermodel -/

def unitAdmissible (_x : Unit) : Prop := True

def unitZeroBlock (_x : Unit) : Option ℝ := some 0

def unitUndefinedBlock (_x : Unit) : Option ℝ := none

def unitFormalAction : PartialScalarFunctional Unit :=
  assemblePartialAction unitZeroBlock unitZeroBlock unitZeroBlock unitUndefinedBlock

theorem unitFormalAction_hasFourBlockDecomposition :
    HasFourBlockDecomposition unitFormalAction
      unitZeroBlock unitZeroBlock unitZeroBlock unitUndefinedBlock := by
  intro x
  rfl

theorem unitFormalAction_not_definedOn :
    ¬ IsDefinedOn unitAdmissible unitFormalAction := by
  intro hdefined
  rcases hdefined () trivial with ⟨value, hvalue⟩
  simp [unitFormalAction, assemblePartialAction, unitZeroBlock,
    unitUndefinedBlock] at hvalue

/-- A syntactically exact block decomposition does not by itself make the action real-valued. -/
theorem fourBlockDecomposition_does_not_force_definedness :
    HasFourBlockDecomposition unitFormalAction
        unitZeroBlock unitZeroBlock unitZeroBlock unitUndefinedBlock ∧
      ¬ IsDefinedOn unitAdmissible unitFormalAction :=
  ⟨unitFormalAction_hasFourBlockDecomposition, unitFormalAction_not_definedOn⟩

/-! ## Row 16: corrected coercivity suppliers and the weak-remainder obstruction -/

/-- A real functional has a global lower bound. -/
def IsBoundedBelow {X : Type*} (energy : X → ℝ) : Prop :=
  ∃ lower : ℝ, ∀ x, lower ≤ energy x

/-- A quantitative lower bound by a nonnegative strong-size functional. -/
def HasCoerciveLowerBound {X : Type*}
    (energy strongSize : X → ℝ) : Prop :=
  ∃ c C : ℝ, 0 < c ∧ 0 ≤ C ∧
    ∀ x, c * strongSize x - C ≤ energy x

/-- The data block can be absorbed into a chosen nonnegative leading block. -/
def HasDataAbsorption {X : Type*}
    (data leading : X → ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ →
    ∃ Cδ : ℝ, 0 ≤ Cδ ∧
      ∀ x, |data x| ≤ δ * leading x + Cδ

/-- The weak statement that the remainder grows at most linearly in the strong size.  It gives no
one-sided lower bound and therefore cannot be used as a coercivity estimate. -/
def HasPolynomialRemainderControl {X : Type*}
    (remainder strongSize : X → ℝ) : Prop :=
  ∀ x, |remainder x| ≤ strongSize x + 1

/-- Genuine coercivity follows when the mass controls the *strong* size, the data term is
absorbed with coefficient at most one, and the remainder has a uniform one-sided lower bound. -/
theorem coerciveLowerBound_of_blockSuppliers {X : Type*}
    (action leading mass data remainder strongSize : X → ℝ)
    (cM CM δ CV CR : ℝ)
    (hcM : 0 < cM)
    (hCM : 0 ≤ CM)
    (hδ0 : 0 ≤ δ)
    (hδ1 : δ ≤ 1)
    (hCV : 0 ≤ CV)
    (hCR : 0 ≤ CR)
    (haction : ∀ x, action x =
      leading x + mass x + data x + remainder x)
    (hleading : ∀ x, 0 ≤ leading x)
    (hmass : ∀ x, cM * strongSize x - CM ≤ mass x)
    (hdata : ∀ x, |data x| ≤ δ * leading x + CV)
    (hremainder : ∀ x, -CR ≤ remainder x) :
    HasCoerciveLowerBound action strongSize := by
  refine ⟨cM, CM + CV + CR, hcM, by linarith, ?_⟩
  intro x
  have hleadingRemaining : 0 ≤ (1 - δ) * leading x :=
    mul_nonneg (sub_nonneg.mpr hδ1) (hleading x)
  have hnegAbs : -|data x| ≤ data x := neg_abs_le (data x)
  rw [haction x]
  nlinarith [hmass x, hdata x, hremainder x]

/-- A coercive estimate gives a global lower bound once the strong size is nonnegative. -/
theorem boundedBelow_of_coerciveLowerBound {X : Type*}
    (energy strongSize : X → ℝ)
    (hsize : ∀ x, 0 ≤ strongSize x)
    (hcoercive : HasCoerciveLowerBound energy strongSize) :
    IsBoundedBelow energy := by
  rcases hcoercive with ⟨c, C, hc, _hC, hbound⟩
  refine ⟨-C, ?_⟩
  intro x
  have hcx : 0 ≤ c * strongSize x :=
    mul_nonneg (le_of_lt hc) (hsize x)
  nlinarith [hbound x]

/-! ### A countable coercivity countermodel -/

def weakStrongSize (n : ℕ) : ℝ := n

def weakL2Size (_n : ℕ) : ℝ := 0

def weakLeading (_n : ℕ) : ℝ := 0

def weakMass (_n : ℕ) : ℝ := 0

def weakData (_n : ℕ) : ℝ := 0

def weakRemainder (n : ℕ) : ℝ := -(n : ℝ)

def weakAction (n : ℕ) : ℝ := -(n : ℝ)

theorem weakMass_controls_only_L2Size :
    ∀ n : ℕ, (1 : ℝ) * weakL2Size n - 0 ≤ weakMass n := by
  intro n
  simp [weakL2Size, weakMass]

theorem weakData_is_absorbable :
    HasDataAbsorption weakData weakLeading := by
  intro δ _hδ
  refine ⟨0, le_rfl, ?_⟩
  intro n
  simp [weakData, weakLeading]

theorem weakRemainder_has_polynomialControl :
    HasPolynomialRemainderControl weakRemainder weakStrongSize := by
  intro n
  change |-(n : ℝ)| ≤ (n : ℝ) + 1
  rw [abs_neg, abs_of_nonneg (Nat.cast_nonneg n)]
  linarith

theorem weakAction_has_fourBlockFormula :
    ∀ n, weakAction n =
      weakLeading n + weakMass n + weakData n + weakRemainder n := by
  intro n
  simp [weakAction, weakLeading, weakMass, weakData, weakRemainder]

theorem weakAction_not_boundedBelow :
    ¬ IsBoundedBelow weakAction := by
  rintro ⟨lower, hlower⟩
  obtain ⟨n, hn⟩ := exists_nat_gt (-lower)
  have h := hlower n
  simp only [weakAction] at h
  linarith

/-- The printed weak package can hold with a positive mass coefficient and a polynomially
controlled remainder while the full action tends to minus infinity. -/
theorem weakCoercivityPremises_do_not_force_lowerBound :
    (0 : ℝ) < 1 ∧
      (∀ n : ℕ, (1 : ℝ) * weakL2Size n - 0 ≤ weakMass n) ∧
      HasDataAbsorption weakData weakLeading ∧
      HasPolynomialRemainderControl weakRemainder weakStrongSize ∧
      (∀ n, weakAction n =
        weakLeading n + weakMass n + weakData n + weakRemainder n) ∧
      ¬ IsBoundedBelow weakAction := by
  refine ⟨by norm_num, ⟨weakMass_controls_only_L2Size,
    ⟨weakData_is_absorbable, ⟨weakRemainder_has_polynomialControl,
      ⟨weakAction_has_fourBlockFormula, weakAction_not_boundedBelow⟩⟩⟩⟩⟩

/-! ## Rows 17 and 22: a quantitative cusp estimate implies vanishing -/

/-- Elementary epsilon-tail convergence for a real sequence. -/
def SequenceTendsToZero (sequence : ℕ → ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → |sequence n| < ε

/-- A concrete inverse-linear estimate, used as a Mathlib-light surrogate for the paper's
`Y⁻¹ᐟ²` trace estimate.  Either positive decay rate would support the same implication. -/
def HasInverseLinearBound (sequence : ℕ → ℝ) (C : ℝ) : Prop :=
  0 ≤ C ∧
    ∀ n : ℕ, |sequence n| ≤ C / ((n : ℝ) + 1)

theorem sequenceTendsToZero_of_inverseLinearBound
    (sequence : ℕ → ℝ) (C : ℝ)
    (hbound : HasInverseLinearBound sequence C) :
    SequenceTendsToZero sequence := by
  rcases hbound with ⟨_hC, hestimate⟩
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_gt (C / ε)
  refine ⟨N, ?_⟩
  intro n hn
  have hNn : (N : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast hn
  have hden : 0 < (n : ℝ) + 1 := by
    positivity
  have hCN : C < (N : ℝ) * ε :=
    (div_lt_iff₀ hε).mp hN
  have hNden : (N : ℝ) ≤ (n : ℝ) + 1 := by
    linarith
  have hscaled : (N : ℝ) * ε ≤ ((n : ℝ) + 1) * ε :=
    mul_le_mul_of_nonneg_right hNden (le_of_lt hε)
  have hCden : C < ((n : ℝ) + 1) * ε :=
    hCN.trans_le hscaled
  have hfraction : C / ((n : ℝ) + 1) < ε := by
    apply (div_lt_iff₀ hden).2
    nlinarith
  exact (hestimate n).trans_lt hfraction

/-- A uniform quantitative trace supplier for every admissible pair. -/
def HasUniformInverseLinearTraceBound {Field : Type*}
    (admissible : Field → Prop)
    (boundary : Field → Field → ℕ → ℝ)
    (traceSize : Field → ℝ) (C : ℝ) : Prop :=
  0 ≤ C ∧
    ∀ u v n, admissible u → admissible v →
      |boundary u v n| ≤
        (C * |traceSize u| * |traceSize v|) / ((n : ℝ) + 1)

/-- The exact logical content needed by cusp-safe integration by parts. -/
def CuspIBPVanishing {Field : Type*}
    (admissible : Field → Prop)
    (boundary : Field → Field → ℕ → ℝ) : Prop :=
  ∀ u v, admissible u → admissible v →
    SequenceTendsToZero (boundary u v)

/-- The quantitative trace estimate proves the qualitative cusp-boundary vanishing statement. -/
theorem cuspIBPVanishing_of_uniformTraceBound {Field : Type*}
    (admissible : Field → Prop)
    (boundary : Field → Field → ℕ → ℝ)
    (traceSize : Field → ℝ) (C : ℝ)
    (htrace : HasUniformInverseLinearTraceBound
      admissible boundary traceSize C) :
    CuspIBPVanishing admissible boundary := by
  rcases htrace with ⟨hC, hestimate⟩
  intro u v hu hv
  apply sequenceTendsToZero_of_inverseLinearBound
    (boundary u v) (C * |traceSize u| * |traceSize v|)
  refine ⟨mul_nonneg (mul_nonneg hC (abs_nonneg _)) (abs_nonneg _), ?_⟩
  intro n
  exact hestimate u v n hu hv

/-! ### A constant-boundary countermodel -/

/-- Mere uniform boundedness of boundary pairings, with no decaying factor. -/
def HasUniformBoundaryBound {Field : Type*}
    (admissible : Field → Prop)
    (boundary : Field → Field → ℕ → ℝ)
    (traceSize : Field → ℝ) (C : ℝ) : Prop :=
  0 ≤ C ∧
    ∀ u v n, admissible u → admissible v →
      |boundary u v n| ≤ C * |traceSize u| * |traceSize v|

def unitBoundary (_u _v : Unit) (_n : ℕ) : ℝ := 1

def unitTraceSize (_u : Unit) : ℝ := 1

theorem unitBoundary_is_uniformlyBounded :
    HasUniformBoundaryBound unitAdmissible unitBoundary unitTraceSize 1 := by
  refine ⟨by norm_num, ?_⟩
  intro u v n hu hv
  norm_num [unitBoundary, unitTraceSize]

theorem unitBoundary_not_cuspIBPVanishing :
    ¬ CuspIBPVanishing unitAdmissible unitBoundary := by
  intro hvanish
  have hsequence := hvanish () () trivial trivial
  rcases hsequence (1 / 2 : ℝ) (by norm_num) with ⟨N, hN⟩
  have hcontra := hN N le_rfl
  norm_num [unitBoundary] at hcontra

/-- Bounded or finite boundary traces do not vanish without a uniform decaying rate. -/
theorem uniformBoundaryBound_does_not_force_IBPVanishing :
    HasUniformBoundaryBound unitAdmissible unitBoundary unitTraceSize 1 ∧
      ¬ CuspIBPVanishing unitAdmissible unitBoundary :=
  ⟨unitBoundary_is_uniformlyBounded, unitBoundary_not_cuspIBPVanishing⟩

/-! ## Row 28: Sobolev product and duality suppliers -/

/-- Algebraic bilinearity is kept separate from the analytic size estimate.  This prevents a
well-typed binary function from being silently treated as a bounded bilinear operator. -/
def IsRealBilinear {Input Output : Type*}
    [AddCommGroup Input] [Module ℝ Input]
    [AddCommGroup Output] [Module ℝ Output]
    (bilinear : Input → Input → Output) : Prop :=
  (∀ x₁ x₂ y, bilinear (x₁ + x₂) y =
      bilinear x₁ y + bilinear x₂ y) ∧
    (∀ (a : ℝ) x y, bilinear (a • x) y = a • bilinear x y) ∧
    (∀ x y₁ y₂, bilinear x (y₁ + y₂) =
      bilinear x y₁ + bilinear x y₂) ∧
    (∀ (a : ℝ) x y, bilinear x (a • y) = a • bilinear x y)

theorem realBilinear_map_zero_left {Input Output : Type*}
    [AddCommGroup Input] [Module ℝ Input]
    [AddCommGroup Output] [Module ℝ Output]
    (bilinear : Input → Input → Output)
    (hbilinear : IsRealBilinear bilinear) (y : Input) :
    bilinear 0 y = 0 := by
  rcases hbilinear with ⟨_haddLeft, hsmulLeft, _haddRight, _hsmulRight⟩
  simpa using hsmulLeft 0 (0 : Input) y

/-- A quantitative product estimate between an input scale and an output scale.  The types need
not be identified, preventing the degree mismatch present in the informal formula. -/
def HasSobolevBilinearEstimate {Input Output : Type*}
    (bilinear : Input → Input → Output)
    (inputSize : Input → ℝ) (outputSize : Output → ℝ)
    (C : ℝ) : Prop :=
  0 ≤ C ∧
    ∀ x y, outputSize (bilinear x y) ≤
      C * inputSize x * inputSize y

/-- One constant controls a parameterized family on an explicitly supplied parameter region.
This is the typed replacement for the paper's phrase "operator norm locally bounded in `q`". -/
def HasUniformSobolevBilinearEstimateOn
    {Parameter Input Output : Type*}
    (region : Parameter → Prop)
    (family : Parameter → Input → Input → Output)
    (inputSize : Input → ℝ) (outputSize : Output → ℝ)
    (C : ℝ) : Prop :=
  0 ≤ C ∧
    ∀ q, region q →
      ∀ x y, outputSize (family q x y) ≤
        C * inputSize x * inputSize y

/-- A separately typed dual-pairing estimate. -/
def HasDualPairingEstimate {Output Dual : Type*}
    (pairing : Output → Dual → ℝ)
    (outputSize : Output → ℝ) (dualSize : Dual → ℝ)
    (D : ℝ) : Prop :=
  0 ≤ D ∧
    ∀ z w, |pairing z w| ≤ D * outputSize z * dualSize w

/-- A Sobolev product estimate gives a uniform bound on every pair of bounded input balls. -/
theorem sobolevBilinear_ballBound {Input Output : Type*}
    (bilinear : Input → Input → Output)
    (inputSize : Input → ℝ) (outputSize : Output → ℝ)
    (C R S : ℝ)
    (hinput : ∀ x, 0 ≤ inputSize x)
    (hestimate : HasSobolevBilinearEstimate
      bilinear inputSize outputSize C)
    {x y : Input}
    (hx : inputSize x ≤ R) (hy : inputSize y ≤ S)
    (hR : 0 ≤ R) :
    outputSize (bilinear x y) ≤ C * R * S := by
  rcases hestimate with ⟨hC, hbound⟩
  calc
    outputSize (bilinear x y) ≤
        C * inputSize x * inputSize y := hbound x y
    _ ≤ C * R * inputSize y :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hx hC) (hinput y)
    _ ≤ C * R * S :=
      mul_le_mul_of_nonneg_left hy (mul_nonneg hC hR)

/-- The locally uniform family supplier gives a ball bound with the same constant at every
parameter in the supplied region. -/
theorem sobolevBilinear_familyBallBound
    {Parameter Input Output : Type*}
    (region : Parameter → Prop)
    (family : Parameter → Input → Input → Output)
    (inputSize : Input → ℝ) (outputSize : Output → ℝ)
    (C R S : ℝ)
    (hinput : ∀ x, 0 ≤ inputSize x)
    (hfamily : HasUniformSobolevBilinearEstimateOn
      region family inputSize outputSize C)
    {q : Parameter} (hq : region q)
    {x y : Input}
    (hx : inputSize x ≤ R) (hy : inputSize y ≤ S)
    (hR : 0 ≤ R) :
    outputSize (family q x y) ≤ C * R * S := by
  rcases hfamily with ⟨hC, hbound⟩
  exact
    sobolevBilinear_ballBound
      (family q) inputSize outputSize C R S hinput
      ⟨hC, hbound q hq⟩ hx hy hR

/-- Combining the product and pairing suppliers yields the coefficient/triple-product estimate;
this conclusion is not a field of either supplier predicate. -/
theorem tripleProduct_bound_of_sobolevSuppliers
    {Input Output Dual : Type*}
    (bilinear : Input → Input → Output)
    (pairing : Output → Dual → ℝ)
    (inputSize : Input → ℝ)
    (outputSize : Output → ℝ)
    (dualSize : Dual → ℝ)
    (C D : ℝ)
    (hdualSize : ∀ w, 0 ≤ dualSize w)
    (hbilinear : HasSobolevBilinearEstimate
      bilinear inputSize outputSize C)
    (hpairing : HasDualPairingEstimate
      pairing outputSize dualSize D)
    (x y : Input) (w : Dual) :
    |pairing (bilinear x y) w| ≤
      (D * C) * inputSize x * inputSize y * dualSize w := by
  rcases hbilinear with ⟨_hC, hB⟩
  rcases hpairing with ⟨hD, hpair⟩
  calc
    |pairing (bilinear x y) w| ≤
        D * outputSize (bilinear x y) * dualSize w :=
      hpair (bilinear x y) w
    _ ≤ D * (C * inputSize x * inputSize y) * dualSize w :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hB x y) hD) (hdualSize w)
    _ = (D * C) * inputSize x * inputSize y * dualSize w := by
      ring

/-! ### A one-point arity-only countermodel -/

def unitBinaryCandidate (_x _y : Unit) : Unit := ()

def unitInputSize (_x : Unit) : ℝ := 0

def unitOutputSize (_z : Unit) : ℝ := 1

/-- A well-typed binary map, even between nonnegative size functions, need not satisfy any
Sobolev product estimate.  Analytic norm axioms and the product theorem are genuine suppliers. -/
theorem unitBinaryCandidate_has_no_sobolevEstimate :
    ¬ ∃ C : ℝ, 0 ≤ C ∧
      ∀ x y, unitOutputSize (unitBinaryCandidate x y) ≤
        C * unitInputSize x * unitInputSize y := by
  rintro ⟨C, hC, hbound⟩
  have h := hbound () ()
  norm_num [unitBinaryCandidate, unitInputSize, unitOutputSize] at h

/-! ## Row 33: the density prerequisite in Lemma 4.16 -/

/-- Density expressed through an abstract family of approximation relations.  A future Sobolev
development may instantiate `close scale` by a norm-distance estimate, while the finite no-go
model below instantiates it by equality. -/
def DenseAtScales {X : Type*}
    (close : ℕ → X → X → Prop)
    (core target : X → Prop) : Prop :=
  ∀ x, target x →
    ∀ scale : ℕ, ∃ y, core y ∧ close scale y x

/-- A retraction that preserves the core, fixes the admissible slice, and preserves approximation
transfers density to the core/admissible intersection. -/
theorem intersection_dense_of_admissibilityRetraction {X : Type*}
    (close : ℕ → X → X → Prop)
    (core formDomain admissible : X → Prop)
    (project : X → X)
    (hdense : DenseAtScales close core formDomain)
    (hadmissibleInForm : ∀ x, admissible x → formDomain x)
    (hprojectCore : ∀ x, core x → core (project x))
    (hprojectAdmissible : ∀ x, admissible (project x))
    (hprojectFixed : ∀ x, admissible x → project x = x)
    (hprojectClose : ∀ scale x y,
      close scale x y → close scale (project x) (project y)) :
    DenseAtScales close (fun x => core x ∧ admissible x) admissible := by
  intro x hx scale
  rcases hdense x (hadmissibleInForm x hx) scale with
    ⟨y, hyCore, hyClose⟩
  refine ⟨project y, ⟨hprojectCore y hyCore, hprojectAdmissible y⟩, ?_⟩
  have hclose := hprojectClose scale y x hyClose
  rw [hprojectFixed x hx] at hclose
  exact hclose

/-! ### A two-point density countermodel -/

def equalityClose (_scale : ℕ) (x y : Bool) : Prop := x = y

def finiteCore (x : Bool) : Prop := x = false

def finiteFormDomain (x : Bool) : Prop := x = false

def finiteAdmissible (x : Bool) : Prop := x = true

theorem finiteCore_denseIn_formDomain :
    DenseAtScales equalityClose finiteCore finiteFormDomain := by
  intro x hx scale
  refine ⟨x, ?_, rfl⟩
  simpa [finiteCore, finiteFormDomain] using hx

theorem finiteIntersection_not_denseIn_admissible :
    ¬ DenseAtScales equalityClose
      (fun x => finiteCore x ∧ finiteAdmissible x) finiteAdmissible := by
  intro hdense
  have htrue : finiteAdmissible true := by
    simp [finiteAdmissible]
  rcases hdense true htrue 0 with ⟨y, ⟨hyCore, hyAdmissible⟩, _hyClose⟩
  cases y <;> simp [finiteCore, finiteAdmissible] at hyCore hyAdmissible

/-- Density in the form domain alone does not imply density of its intersection with an arbitrary
admissible subset. -/
theorem formDensity_does_not_force_sliceIntersectionDensity :
    DenseAtScales equalityClose finiteCore finiteFormDomain ∧
      ¬ DenseAtScales equalityClose
        (fun x => finiteCore x ∧ finiteAdmissible x) finiteAdmissible :=
  ⟨finiteCore_denseIn_formDomain, finiteIntersection_not_denseIn_admissible⟩

end QYM.SobolevGaugeSupplierNoGo


/-!
# Paper-normalized supplier logic for the Sobolev/gauge analytic tranche

This module gives closed supplier/no-go propositions for Assumptions 3.5, 3.6, 3.8, claim 4.4,
Assumption 4.8, and the density prerequisite used by Lemma 4.16.  Every positive result is a
universally quantified implication from explicit suppliers.  The module does **not** assert that
the modular surface, its Sobolev spaces, its trace maps, or an admissibility-preserving projection
satisfying those suppliers have been constructed.

In particular, the declarations prefixed `lemma4_16` below do not certify the full Friedrichs
realisation statement of Lemma 4.16: closedness and nonnegativity of the quadratic form and the
existence and uniqueness of the associated nonnegative self-adjoint operator still require a
separate operator-theoretic development.

The negative results are closed elementary countermodels.  They refute only the weaker logical
inferences identified in the audit; they do not claim that the paper's intended analytic objects
must realize the countermodels.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Assumption 3.5: well-defined action -/

/-- Correct conditional statement: separately defined blocks assemble to a defined real action. -/
def assumption3_5_blockDefinednessImplicationStatement : Prop :=
  ∀ (X : Type) (admissible : X → Prop)
      (leading mass data remainder :
        QYM.SobolevGaugeSupplierNoGo.PartialScalarFunctional X),
    QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible leading →
    QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible mass →
    QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible data →
    QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible remainder →
      QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible
        (QYM.SobolevGaugeSupplierNoGo.assemblePartialAction
          leading mass data remainder)

theorem assumption3_5_blockDefinednessImplicationStatement_holds :
    assumption3_5_blockDefinednessImplicationStatement := by
  intro X admissible leading mass data remainder
    hleading hmass hdata hremainder
  exact
    QYM.SobolevGaugeSupplierNoGo.action_definedOn_of_blocks_definedOn
      admissible leading mass data remainder hleading hmass hdata hremainder

/-- Overstrong inference: a formal four-block equality alone would make every action defined. -/
def assumption3_5_decompositionOnlyInferenceStatement : Prop :=
  ∀ (X : Type) (admissible : X → Prop)
      (action leading mass data remainder :
        QYM.SobolevGaugeSupplierNoGo.PartialScalarFunctional X),
    QYM.SobolevGaugeSupplierNoGo.HasFourBlockDecomposition
        action leading mass data remainder →
      QYM.SobolevGaugeSupplierNoGo.IsDefinedOn admissible action

theorem assumption3_5_decompositionOnlyInferenceStatement_refuted :
    ¬ assumption3_5_decompositionOnlyInferenceStatement := by
  intro hinference
  have hdefined :=
    hinference Unit
      QYM.SobolevGaugeSupplierNoGo.unitAdmissible
      QYM.SobolevGaugeSupplierNoGo.unitFormalAction
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitUndefinedBlock
      QYM.SobolevGaugeSupplierNoGo.unitFormalAction_hasFourBlockDecomposition
  exact QYM.SobolevGaugeSupplierNoGo.unitFormalAction_not_definedOn hdefined

def assumption3_5_undefinedBlockCountermodelStatement : Prop :=
  QYM.SobolevGaugeSupplierNoGo.HasFourBlockDecomposition
      QYM.SobolevGaugeSupplierNoGo.unitFormalAction
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitZeroBlock
      QYM.SobolevGaugeSupplierNoGo.unitUndefinedBlock ∧
    ¬ QYM.SobolevGaugeSupplierNoGo.IsDefinedOn
      QYM.SobolevGaugeSupplierNoGo.unitAdmissible
      QYM.SobolevGaugeSupplierNoGo.unitFormalAction

theorem assumption3_5_undefinedBlockCountermodelStatement_holds :
    assumption3_5_undefinedBlockCountermodelStatement :=
  QYM.SobolevGaugeSupplierNoGo.fourBlockDecomposition_does_not_force_definedness

/-! ## Assumption 3.6: coercivity and absorption -/

/-- Correct conditional statement with the missing strong-size mass estimate and the missing
uniform lower bound for the remainder exposed as suppliers. -/
def assumption3_6_strongCoercivitySupplierImplicationStatement : Prop :=
  ∀ (X : Type)
      (action leading mass data remainder strongSize : X → ℝ)
      (cM CM δ CV CR : ℝ),
    0 < cM →
    0 ≤ CM →
    0 ≤ δ →
    δ ≤ 1 →
    0 ≤ CV →
    0 ≤ CR →
    (∀ x, action x = leading x + mass x + data x + remainder x) →
    (∀ x, 0 ≤ leading x) →
    (∀ x, cM * strongSize x - CM ≤ mass x) →
    (∀ x, |data x| ≤ δ * leading x + CV) →
    (∀ x, -CR ≤ remainder x) →
      QYM.SobolevGaugeSupplierNoGo.HasCoerciveLowerBound action strongSize

theorem assumption3_6_strongCoercivitySupplierImplicationStatement_holds :
    assumption3_6_strongCoercivitySupplierImplicationStatement := by
  intro X action leading mass data remainder strongSize
    cM CM δ CV CR hcM hCM hδ0 hδ1 hCV hCR
    haction hleading hmass hdata hremainder
  exact
    QYM.SobolevGaugeSupplierNoGo.coerciveLowerBound_of_blockSuppliers
      action leading mass data remainder strongSize
      cM CM δ CV CR hcM hCM hδ0 hδ1 hCV hCR
      haction hleading hmass hdata hremainder

/-- The concrete weak package appearing in the no-go model, without its failed conclusion. -/
def assumption3_6_weakPremisesStatement : Prop :=
  (0 : ℝ) < 1 ∧
    (∀ n : ℕ, (1 : ℝ) * QYM.SobolevGaugeSupplierNoGo.weakL2Size n - 0 ≤
      QYM.SobolevGaugeSupplierNoGo.weakMass n) ∧
    QYM.SobolevGaugeSupplierNoGo.HasDataAbsorption
      QYM.SobolevGaugeSupplierNoGo.weakData
