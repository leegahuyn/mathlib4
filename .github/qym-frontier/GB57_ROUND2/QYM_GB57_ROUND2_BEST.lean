open Function Set Topology MeasureTheory
open scoped ENNReal InnerProductSpace

namespace QYM.FullCertification.P14ActualStageL2MapsExtension








/-!
# P14: canonical maps between the actual finite-stage `L²` spaces

The intrinsic stages `I.XSet Y` are nested subsets of one fixed quotient.
Consequently the clean varying-domain model is the `L²` space for the
restricted quotient measure

`S.actualQuotientHyperbolicMeasure.restrict (I.XSet Y)`.

This file constructs that model and proves the complete functorial API:

* restriction from a larger stage is a norm-at-most-one contraction;
* extension by zero from a smaller stage is a linear isometry;
* restriction is a left inverse to extension by zero;
* both maps compose exactly along `Y ≤ Z ≤ W`;
* extension has the asserted support; and
* restriction and extension by zero satisfy the exact adjoint inner-product
  identity.

The last section connects the ambient restricted-measure model to the actual
subtype `L²` carrier constructed in P3 by a measure-preserving pullback
isometry.  No representative selector is used.
-/

/-! ## 1. The geometric inclusions -/

/-- The actual inclusion of the intrinsic stage at height `Y` into the stage
at height `Z`. -/
def actualStageInclusion {Y Z : ℝ} (hYZ : Y ≤ Z) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Z :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion hYZ

@[simp]
theorem actualStageInclusion_coe {Y Z : ℝ} (hYZ : Y ≤ Z)
    (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ((actualStageInclusion hYZ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Z) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) =
      (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_coe hYZ x

theorem actualStageInclusion_injective {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Injective (actualStageInclusion hYZ) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_injective hYZ

theorem actualStageInclusion_continuous {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Continuous (actualStageInclusion hYZ) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_continuous hYZ

theorem actualStageInclusion_measurable {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Measurable (actualStageInclusion hYZ) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_measurable hYZ

theorem actualStageInclusion_refl (Y : ℝ) :
    actualStageInclusion (Y := Y) (Z := Y) le_rfl = id :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_refl Y

theorem actualStageInclusion_trans {Y Z W : ℝ}
    (hYZ : Y ≤ Z) (hZW : Z ≤ W) :
    actualStageInclusion hZW ∘ actualStageInclusion hYZ =
      actualStageInclusion (hYZ.trans hZW) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XInclusion_trans hYZ hZW

/-! ## 2. A common ambient realization of every stage -/

/-- The quotient measure restricted to the actual intrinsic stage. -/
noncomputable def ambientStageMeasure (Y : ℝ) :
    Measure Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure.restrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)

/-- The common-quotient realization of the scalar stage `L²` space. -/
abbrev AmbientStageL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (ambientStageMeasure Y)

/-- The ambient stage measures are monotone with the cutoff. -/
theorem ambientStageMeasure_mono {Y Z : ℝ} (hYZ : Y ≤ Z) :
    ambientStageMeasure Y ≤ ambientStageMeasure Z := by
  exact Measure.restrict_mono (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone hYZ) le_rfl

/-- Restricting the larger ambient stage measure once more to the smaller
stage recovers the smaller ambient measure exactly. -/
theorem ambientStageMeasure_restrict {Y Z : ℝ} (hYZ : Y ≤ Z) :
    (ambientStageMeasure Z).restrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
      ambientStageMeasure Y := by
  exact Measure.restrict_restrict_of_subset (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone hYZ)

/-- Each ambient stage has finite mass. -/
noncomputable instance ambientStageMeasure_isFinite (Y : ℝ) :
    IsFiniteMeasure (ambientStageMeasure Y) := by
  refine ⟨?_⟩
  change ambientStageMeasure Y Set.univ < (∞ : ℝ≥0∞)
  rw [ambientStageMeasure, Measure.restrict_apply_univ]
  exact QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isCompact Y |>.measure_lt_top

/-! ## 3. Canonical restriction -/

/-- The representative of an element of the larger `L²` space is still in
`L²` for the smaller restricted measure. -/
theorem ambientRestriction_memLp {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) :
    MemLp (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) 2 (ambientStageMeasure Y) :=
  MemLp.mono_measure (ambientStageMeasure_mono hYZ) (Lp.memLp u)

/-- Canonical restriction from the stage `Z` to the stage `Y`. -/
noncomputable def ambientRestriction {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) : AmbientStageL2 Y :=
  (ambientRestriction_memLp hYZ u).toLp u

/-- Restriction agrees almost everywhere with the same quotient
representative. -/
theorem ambientRestriction_coeFn_ae {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) :
    ((ambientRestriction hYZ u : AmbientStageL2 Y) :
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[ambientStageMeasure Y]
      (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) :=
  (ambientRestriction_memLp hYZ u).coeFn_toLp

/-- Restriction is contractive. -/
theorem ambientRestriction_norm_le {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) :
    ‖ambientRestriction hYZ u‖ ≤ ‖u‖ := by
  rw [ambientRestriction, Lp.norm_toLp, Lp.norm_def]
  exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top u)
    (eLpNorm_mono_measure u (ambientStageMeasure_mono hYZ))

theorem ambientRestriction_add {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u v : AmbientStageL2 Z) :
    ambientRestriction hYZ (u + v) =
      ambientRestriction hYZ u + ambientRestriction hYZ v := by
  apply Lp.ext
  have huv :
      ((u + v : AmbientStageL2 Z) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[
          ambientStageMeasure Y]
        (fun x => u x + v x) :=
    ae_mono (ambientStageMeasure_mono hYZ) (Lp.coeFn_add u v)
  filter_upwards
    [ambientRestriction_coeFn_ae hYZ (u + v),
      ambientRestriction_coeFn_ae hYZ u,
      ambientRestriction_coeFn_ae hYZ v,
      Lp.coeFn_add (ambientRestriction hYZ u)
        (ambientRestriction hYZ v), huv]
    with x hsum hu hv hout hin
  rw [hsum, hout, Pi.add_apply, hu, hv, hin]

theorem ambientRestriction_smul {Y Z : ℝ} (hYZ : Y ≤ Z)
    (c : ℂ) (u : AmbientStageL2 Z) :
    ambientRestriction hYZ (c • u) =
      c • ambientRestriction hYZ u := by
  apply Lp.ext
  have hcu :
      ((c • u : AmbientStageL2 Z) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[
          ambientStageMeasure Y]
        (fun x => c • u x) :=
    ae_mono (ambientStageMeasure_mono hYZ) (Lp.coeFn_smul c u)
  filter_upwards
    [ambientRestriction_coeFn_ae hYZ (c • u),
      ambientRestriction_coeFn_ae hYZ u,
      Lp.coeFn_smul c (ambientRestriction hYZ u), hcu]
    with x hleft hu hright hin
  rw [hleft, hright, Pi.smul_apply, hu, hin]

/-- Restriction as a complex-linear map. -/
noncomputable def ambientRestrictionLinearMap {Y Z : ℝ} (hYZ : Y ≤ Z) :
    AmbientStageL2 Z →ₗ[ℂ] AmbientStageL2 Y where
  toFun := ambientRestriction hYZ
  map_add' := ambientRestriction_add hYZ
  map_smul' := ambientRestriction_smul hYZ

@[simp]
theorem ambientRestrictionLinearMap_apply {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) :
    ambientRestrictionLinearMap hYZ u = ambientRestriction hYZ u :=
  rfl

/-- Restriction as a continuous linear contraction. -/
noncomputable def ambientRestrictionCLM {Y Z : ℝ} (hYZ : Y ≤ Z) :
    AmbientStageL2 Z →L[ℂ] AmbientStageL2 Y :=
  (ambientRestrictionLinearMap hYZ).mkContinuous 1 (fun u => by
    simpa only [one_mul, ambientRestrictionLinearMap_apply] using
      ambientRestriction_norm_le hYZ u)

@[simp]
theorem ambientRestrictionCLM_apply {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) :
    ambientRestrictionCLM hYZ u = ambientRestriction hYZ u :=
  rfl

theorem ambientRestrictionCLM_norm_le_one {Y Z : ℝ} (hYZ : Y ≤ Z) :
    ‖ambientRestrictionCLM hYZ‖ ≤ 1 := by
  exact LinearMap.mkContinuous_norm_le _ zero_le_one (fun u => by
    simpa only [one_mul, ambientRestrictionLinearMap_apply] using
      ambientRestriction_norm_le hYZ u)

/-- Restriction at an unchanged cutoff is the identity. -/
theorem ambientRestriction_refl (Y : ℝ) (u : AmbientStageL2 Y) :
    ambientRestriction (Y := Y) (Z := Y) le_rfl u = u := by
  apply Lp.ext
  exact ambientRestriction_coeFn_ae le_rfl u

/-! ## 4. Canonical extension by zero -/

/-- The literal zero-extension representative. -/
def ambientZeroExtensionRepresentative {Y : ℝ}
    (u : AmbientStageL2 Y) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ :=
  (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).indicator (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ)

/-- The zero-extension representative is square-integrable on every larger
stage. -/
theorem ambientZeroExtension_memLp {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    MemLp (ambientZeroExtensionRepresentative u) 2
      (ambientStageMeasure Z) := by
  rw [ambientZeroExtensionRepresentative,
    memLp_indicator_iff_restrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y),
    ambientStageMeasure_restrict hYZ]
  exact Lp.memLp u

/-- Canonical extension by zero from stage `Y` to stage `Z`. -/
noncomputable def ambientZeroExtension {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) : AmbientStageL2 Z :=
  (ambientZeroExtension_memLp hYZ u).toLp
    (ambientZeroExtensionRepresentative u)

/-- The `L²` value of zero-extension is its literal indicator representative
almost everywhere. -/
theorem ambientZeroExtension_coeFn_ae {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    ((ambientZeroExtension hYZ u : AmbientStageL2 Z) :
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[ambientStageMeasure Z]
      ambientZeroExtensionRepresentative u :=
  (ambientZeroExtension_memLp hYZ u).coeFn_toLp

/-- Extension by zero vanishes off the smaller intrinsic stage. -/
theorem ambientZeroExtension_eq_zero_ae_off_stage {Y Z : ℝ}
    (hYZ : Y ≤ Z) (u : AmbientStageL2 Y) :
    ∀ᵐ x ∂ambientStageMeasure Z,
      x ∉ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y → ambientZeroExtension hYZ u x = 0 := by
  filter_upwards [ambientZeroExtension_coeFn_ae hYZ u] with x hx hnot
  rw [hx, ambientZeroExtensionRepresentative,
    Set.indicator_of_notMem hnot]

/-- Extension by zero preserves the norm exactly. -/
theorem ambientZeroExtension_norm {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    ‖ambientZeroExtension hYZ u‖ = ‖u‖ := by
  rw [ambientZeroExtension, Lp.norm_toLp,
    ambientZeroExtensionRepresentative,
    eLpNorm_indicator_eq_eLpNorm_restrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y),
    ambientStageMeasure_restrict hYZ, Lp.norm_def]

/-- An equality of source representatives lifts to an equality of their
zero-extensions. -/
theorem indicator_eventuallyEq_of_eventuallyEq_smaller_stage
    {Y Z : ℝ} (hYZ : Y ≤ Z)
    {f g : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ}
    (hfg : f =ᵐ[ambientStageMeasure Y] g) :
    (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).indicator f =ᵐ[ambientStageMeasure Z]
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).indicator g := by
  apply (ae_eq_restrict_iff_indicator_ae_eq
    (μ := ambientStageMeasure Z) (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y)).1
  simpa only [ambientStageMeasure_restrict hYZ] using hfg

theorem ambientZeroExtension_add {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u v : AmbientStageL2 Y) :
    ambientZeroExtension hYZ (u + v) =
      ambientZeroExtension hYZ u + ambientZeroExtension hYZ v := by
  apply Lp.ext
  have hsource :=
    indicator_eventuallyEq_of_eventuallyEq_smaller_stage hYZ
      (Lp.coeFn_add u v)
  filter_upwards
    [ambientZeroExtension_coeFn_ae hYZ (u + v),
      ambientZeroExtension_coeFn_ae hYZ u,
      ambientZeroExtension_coeFn_ae hYZ v,
      Lp.coeFn_add (ambientZeroExtension hYZ u)
        (ambientZeroExtension hYZ v), hsource]
    with x hleft hu hv hright hsrc
  rw [hleft, hright, Pi.add_apply, hu, hv]
  simp only [ambientZeroExtensionRepresentative] at hsrc ⊢
  rw [hsrc]
  by_cases hx : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y
  · simp only [hx, Set.indicator_of_mem, Pi.add_apply]
  · first
    | rfl
    | rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx,
        Set.indicator_of_notMem hx, add_zero]

theorem ambientZeroExtension_smul {Y Z : ℝ} (hYZ : Y ≤ Z)
    (c : ℂ) (u : AmbientStageL2 Y) :
    ambientZeroExtension hYZ (c • u) =
      c • ambientZeroExtension hYZ u := by
  apply Lp.ext
  have hsource :=
    indicator_eventuallyEq_of_eventuallyEq_smaller_stage hYZ
      (Lp.coeFn_smul c u)
  filter_upwards
    [ambientZeroExtension_coeFn_ae hYZ (c • u),
      ambientZeroExtension_coeFn_ae hYZ u,
      Lp.coeFn_smul c (ambientZeroExtension hYZ u), hsource]
    with x hleft hu hright hsrc
  rw [hleft, hright, Pi.smul_apply, hu]
  simp only [ambientZeroExtensionRepresentative] at hsrc ⊢
  rw [hsrc]
  by_cases hx : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y
  · simp only [hx, Set.indicator_of_mem, Pi.smul_apply]
  · first
    | rfl
    | rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx,
        smul_zero]

/-- Extension by zero as a linear map. -/
noncomputable def ambientZeroExtensionLinearMap {Y Z : ℝ} (hYZ : Y ≤ Z) :
    AmbientStageL2 Y →ₗ[ℂ] AmbientStageL2 Z where
  toFun := ambientZeroExtension hYZ
  map_add' := ambientZeroExtension_add hYZ
  map_smul' := ambientZeroExtension_smul hYZ

@[simp]
theorem ambientZeroExtensionLinearMap_apply {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    ambientZeroExtensionLinearMap hYZ u = ambientZeroExtension hYZ u :=
  rfl

/-- Extension by zero is a canonical linear isometry. -/
noncomputable def ambientZeroExtensionIsometry {Y Z : ℝ} (hYZ : Y ≤ Z) :
    AmbientStageL2 Y →ₗᵢ[ℂ] AmbientStageL2 Z where
  toLinearMap := ambientZeroExtensionLinearMap hYZ
  norm_map' := ambientZeroExtension_norm hYZ

@[simp]
theorem ambientZeroExtensionIsometry_apply {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    ambientZeroExtensionIsometry hYZ u = ambientZeroExtension hYZ u :=
  rfl

/-- Extension by zero is injective. -/
theorem ambientZeroExtension_injective {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Injective (ambientZeroExtension hYZ) :=
  (ambientZeroExtensionIsometry hYZ).injective

/-! ## 5. Retraction and functoriality -/

/-- Restriction after extension by zero is exactly the identity. -/
theorem ambientRestriction_zeroExtension {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Y) :
    ambientRestriction hYZ (ambientZeroExtension hYZ u) = u := by
  apply Lp.ext
  have hzero :
      ((ambientZeroExtension hYZ u : AmbientStageL2 Z) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[ambientStageMeasure Y]
        ambientZeroExtensionRepresentative u :=
    ae_mono (ambientStageMeasure_mono hYZ)
      (ambientZeroExtension_coeFn_ae hYZ u)
  filter_upwards
    [ambientRestriction_coeFn_ae hYZ (ambientZeroExtension hYZ u),
      hzero, ae_restrict_mem (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y)]
    with x hrestrict hzero hx
  rw [hrestrict, hzero, ambientZeroExtensionRepresentative,
    Set.indicator_of_mem hx]

/-- Extension at an unchanged cutoff is the identity. -/
theorem ambientZeroExtension_refl (Y : ℝ) (u : AmbientStageL2 Y) :
    ambientZeroExtension (Y := Y) (Z := Y) le_rfl u = u := by
  have h := ambientRestriction_zeroExtension
    (Y := Y) (Z := Y) le_rfl u
  rw [ambientRestriction_refl Y] at h
  exact h

/-- Extension after restriction is the indicator projection onto the smaller
stage. -/
theorem ambientZeroExtension_restriction_coeFn_ae {Y Z : ℝ}
    (hYZ : Y ≤ Z) (u : AmbientStageL2 Z) :
    ((ambientZeroExtension hYZ (ambientRestriction hYZ u) :
        AmbientStageL2 Z) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[
          ambientStageMeasure Z]
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).indicator (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) := by
  refine (ambientZeroExtension_coeFn_ae hYZ
    (ambientRestriction hYZ u)).trans ?_
  exact indicator_eventuallyEq_of_eventuallyEq_smaller_stage hYZ
    (ambientRestriction_coeFn_ae hYZ u)

/-- Restrictions compose along nested cutoffs. -/
theorem ambientRestriction_trans {Y Z W : ℝ}
    (hYZ : Y ≤ Z) (hZW : Z ≤ W) (u : AmbientStageL2 W) :
    ambientRestriction hYZ (ambientRestriction hZW u) =
      ambientRestriction (hYZ.trans hZW) u := by
  apply Lp.ext
  have hinner :
      ((ambientRestriction hZW u : AmbientStageL2 Z) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[ambientStageMeasure Y]
        (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) :=
    ae_mono (ambientStageMeasure_mono hYZ)
      (ambientRestriction_coeFn_ae hZW u)
  filter_upwards
    [ambientRestriction_coeFn_ae hYZ (ambientRestriction hZW u),
      hinner,
      ambientRestriction_coeFn_ae (hYZ.trans hZW) u]
    with x houter hinner hdirect
  rw [houter, hinner, hdirect]

/-- Zero-extensions compose along nested cutoffs. -/
theorem ambientZeroExtension_trans {Y Z W : ℝ}
    (hYZ : Y ≤ Z) (hZW : Z ≤ W) (u : AmbientStageL2 Y) :
    ambientZeroExtension hZW (ambientZeroExtension hYZ u) =
      ambientZeroExtension (hYZ.trans hZW) u := by
  apply Lp.ext
  have hlift :
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Z).indicator
          ((ambientZeroExtension hYZ u : AmbientStageL2 Z) :
            Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[ambientStageMeasure W]
        (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Z).indicator (ambientZeroExtensionRepresentative u) :=
    indicator_eventuallyEq_of_eventuallyEq_smaller_stage hZW
      (ambientZeroExtension_coeFn_ae hYZ u)
  filter_upwards
    [ambientZeroExtension_coeFn_ae hZW
      (ambientZeroExtension hYZ u), hlift,
      ambientZeroExtension_coeFn_ae (hYZ.trans hZW) u]
    with x houter hlift hdirect
  rw [houter, hdirect, ambientZeroExtensionRepresentative]
  rw [hlift]
  by_cases hx : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y
  · have hxZ : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Z := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone hYZ hx
    simp only [hx, hxZ, Set.indicator_of_mem]
  · by_cases hxZ : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Z
    · simp only [hx, hxZ, Set.indicator_of_mem,
        Set.indicator_of_notMem]
    · first
      | rfl
      | rw [Set.indicator_of_notMem hxZ,
          ambientZeroExtensionRepresentative,
          Set.indicator_of_notMem hx]

/-- The extension-restriction projection is idempotent. -/
theorem ambientZeroExtension_restriction_idempotent {Y Z : ℝ}
    (hYZ : Y ≤ Z) (u : AmbientStageL2 Z) :
    ambientZeroExtension hYZ
        (ambientRestriction hYZ
          (ambientZeroExtension hYZ (ambientRestriction hYZ u))) =
      ambientZeroExtension hYZ (ambientRestriction hYZ u) := by
  rw [ambientRestriction_zeroExtension]

/-! ## 6. The adjoint inner-product identity -/

/-- Pointwise, inserting an indicator in the right input of the scalar inner
product is the same as indicating the scalar inner product. -/
theorem inner_indicator_right (s : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)
    (f g : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    inner ℂ (f x) (s.indicator g x) =
      s.indicator (fun y => inner ℂ (f y) (g y)) x := by
  by_cases hx : x ∈ s
  · simp only [hx, Set.indicator_of_mem]
  · first
    | rfl
    | rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx,
        inner_zero_right]

/-- Restriction and extension by zero are adjoint.  This is proved from the
actual `L²` integral, not installed as an operator certificate. -/
theorem ambientRestriction_inner_eq_zeroExtension_inner
    {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) (v : AmbientStageL2 Y) :
    inner ℂ (ambientRestriction hYZ u) v =
      inner ℂ u (ambientZeroExtension hYZ v) := by
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  calc
    (∫ x, inner ℂ (ambientRestriction hYZ u x) (v x)
        ∂ambientStageMeasure Y) =
        ∫ x, inner ℂ (u x) (v x) ∂ambientStageMeasure Y := by
      apply integral_congr_ae
      filter_upwards [ambientRestriction_coeFn_ae hYZ u]
        with x hx
      rw [hx]
    _ = ∫ x, (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y).indicator
          (fun y => inner ℂ (u y) (v y)) x
          ∂ambientStageMeasure Z := by
      rw [integral_indicator (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y),
        ambientStageMeasure_restrict hYZ]
    _ = ∫ x, inner ℂ (u x)
          (ambientZeroExtensionRepresentative v x)
          ∂ambientStageMeasure Z := by
      apply integral_congr_ae
      filter_upwards with x
      exact (inner_indicator_right (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) u v x).symm
    _ = ∫ x, inner ℂ (u x) (ambientZeroExtension hYZ v x)
          ∂ambientStageMeasure Z := by
      apply integral_congr_ae
      filter_upwards [ambientZeroExtension_coeFn_ae hYZ v]
        with x hx
      rw [hx]

/-- The error of the extension-restriction projection is orthogonal to every
zero-extended smaller-stage vector. -/
theorem ambientProjection_error_inner_range_eq_zero
    {Y Z : ℝ} (hYZ : Y ≤ Z)
    (u : AmbientStageL2 Z) (v : AmbientStageL2 Y) :
    inner ℂ
        (u - ambientZeroExtension hYZ (ambientRestriction hYZ u))
        (ambientZeroExtension hYZ v) = 0 := by
  rw [inner_sub_left,
    ← ambientRestriction_inner_eq_zeroExtension_inner hYZ u v,
    ← ambientZeroExtensionIsometry_apply hYZ (ambientRestriction hYZ u),
    ← ambientZeroExtensionIsometry_apply hYZ v,
    (ambientZeroExtensionIsometry hYZ).inner_map_map,
    sub_self]

/-! ## 7. Identification with the actual subtype `L²` carrier -/

/-- The subtype inclusion pushes the actual stage measure to the ambient
restricted quotient measure. -/
theorem actualStageSubtype_measurePreserving (Y : ℝ) :
    MeasurePreserving
      (Subtype.val : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) (ambientStageMeasure Y) := by
  refine ⟨(QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageSubtype_measurableEmbedding Y).measurable, ?_⟩
  exact QYM.FullCertification.P3ActualStageL2SectionsExtension.map_actualStageMeasure_subtypeVal Y

/-- Pullback along the subtype inclusion embeds the ambient quotient model
isometrically into its actual-stage coordinate model. -/
noncomputable def ambientToActualStageL2Isometry (Y : ℝ) :
    AmbientStageL2 Y →ₗᵢ[ℂ] QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageScalarL2 Y :=
  MeasureTheory.Lp.compMeasurePreservingₗᵢ ℂ
    (Subtype.val : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)
    (actualStageSubtype_measurePreserving Y)

@[simp]
theorem ambientToActualStageL2Isometry_norm (Y : ℝ)
    (u : AmbientStageL2 Y) :
    ‖ambientToActualStageL2Isometry Y u‖ = ‖u‖ :=
  (ambientToActualStageL2Isometry Y).norm_map u

theorem ambientToActualStageL2Isometry_coeFn_ae (Y : ℝ)
    (u : AmbientStageL2 Y) :
    ((ambientToActualStageL2Isometry Y u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageScalarL2 Y) :
        QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      (fun x => u (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)) := by
  exact MeasureTheory.Lp.coeFn_compMeasurePreserving u
    (actualStageSubtype_measurePreserving Y)

/-! ## 8. Aggregate unconditional endpoint -/

/-- The concrete varying-domain `L²` certificate. -/
theorem actualStageL2MapsCertificate {Y Z W : ℝ}
    (hYZ : Y ≤ Z) (hZW : Z ≤ W) :
    (∀ u : AmbientStageL2 Y,
      ‖ambientZeroExtension hYZ u‖ = ‖u‖) ∧
    (∀ u : AmbientStageL2 Y,
      ∀ᵐ x ∂ambientStageMeasure Z,
        x ∉ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y → ambientZeroExtension hYZ u x = 0) ∧
    (∀ u : AmbientStageL2 Y,
      ambientRestriction hYZ (ambientZeroExtension hYZ u) = u) ∧
    (∀ u : AmbientStageL2 W,
      ambientRestriction hYZ (ambientRestriction hZW u) =
        ambientRestriction (hYZ.trans hZW) u) ∧
    (∀ u : AmbientStageL2 Y,
      ambientZeroExtension hZW (ambientZeroExtension hYZ u) =
        ambientZeroExtension (hYZ.trans hZW) u) ∧
    (∀ (u : AmbientStageL2 Z) (v : AmbientStageL2 Y),
      inner ℂ (ambientRestriction hYZ u) v =
        inner ℂ u (ambientZeroExtension hYZ v)) ∧
    (∀ (u : AmbientStageL2 Z) (v : AmbientStageL2 Y),
      inner ℂ
          (u - ambientZeroExtension hYZ (ambientRestriction hYZ u))
          (ambientZeroExtension hYZ v) = 0) := by
  exact ⟨ambientZeroExtension_norm hYZ,
    ambientZeroExtension_eq_zero_ae_off_stage hYZ,
    ambientRestriction_zeroExtension hYZ,
    ambientRestriction_trans hYZ hZW,
    ambientZeroExtension_trans hYZ hZW,
    ambientRestriction_inner_eq_zeroExtension_inner hYZ,
    ambientProjection_error_inner_range_eq_zero hYZ⟩

end QYM.FullCertification.P14ActualStageL2MapsExtension

