/-!
# A genuine twisted `H^(1/2)` boundary target for the width-two cusps

Mathlib does not currently provide a fractional Sobolev space on a circle.
This file therefore constructs the missing target directly.  It is important
that this is not a new name for the stored boundary `L2` coordinate.

For a transition function `tau : R -> C`, the circular increment of `f` is

* `f(x) - f(y)` when the short arc does not cross the seam;
* `f(x) - tau(y) f(y)` when the short arc carries `y` through `y + 2`;
* `tau(x) f(x) - f(y)` in the opposite direction.

Dividing this increment by the width-two circular distance and requiring it
to belong to `L2([0,2]^2)` is exactly the one-dimensional Slobodeckij
`H^(1/2)` condition.  Indeed, squaring the `L2` norm produces the kernel
`|increment|^2 / distance^2`, i.e. the exponent `1 + 2s = 2` for `s = 1/2`.

The graph is closed by taking its topological closure in

`L2([0,2]) x L2([0,2]^2)`.

This gives a complex Hilbert completion, a contractive forgetful map to the
stored `L2` coordinate, and a dense finite-energy core.  The actual multiplier
transition at each named cusp is then defined from the already certified
inverse-eta automorphy factor.  Its exact width-two covariance is proved.

What is deliberately not asserted here is the still missing analytic map

`GraphSobolevCompletion n -> ActualFixedPhaseThreeCuspBoundaryHhalf n Y`.

That map requires the genuine bulk-to-boundary estimate in the old graph norm
and a right inverse requires an extension theorem.  Neither is hidden in a
structure field or introduced as an axiom.
-/

/-! ## 1. Product measure and the width-two circular metric -/

/-- Product of the already constructed Lebesgue restrictions on `[0,2]`.
This is the measure used in the Slobodeckij double integral. -/
noncomputable def actualFixedPhaseWidthTwoProductMeasure :
    Measure (ℝ × ℝ) :=
  actualFixedPhaseWidthTwoParameterMeasure.prod
    actualFixedPhaseWidthTwoParameterMeasure

noncomputable instance actualFixedPhaseWidthTwoProductMeasure_isFinite :
    IsFiniteMeasure actualFixedPhaseWidthTwoProductMeasure := by
  dsimp only [actualFixedPhaseWidthTwoProductMeasure]
  infer_instance

/-- The product-measure mass is `2 * 2 = 4`. -/
theorem actualFixedPhaseWidthTwoProductMeasure_univ :
    actualFixedPhaseWidthTwoProductMeasure Set.univ = 4 := by
  change
    actualFixedPhaseWidthTwoParameterMeasure.prod
        actualFixedPhaseWidthTwoParameterMeasure Set.univ = 4
  rw [← Set.univ_prod_univ, Measure.prod_prod,
    actualFixedPhaseWidthTwoParameterMeasure_univ]
  norm_num

/-- Geodesic distance on the circle of circumference two, written in the
closed interval coordinate.  The absolute value in the second branch keeps
the definition globally nonnegative; on `[0,2]^2` it is simply
`min |x-y| (2-|x-y|)`. -/
def widthTwoCircularDistance (x y : ℝ) : ℝ :=
  min (abs (x - y)) (abs (2 - abs (x - y)))

theorem widthTwoCircularDistance_nonneg (x y : ℝ) :
    0 ≤ widthTwoCircularDistance x y := by
  exact le_min (abs_nonneg _) (abs_nonneg _)

theorem widthTwoCircularDistance_comm (x y : ℝ) :
    widthTwoCircularDistance x y = widthTwoCircularDistance y x := by
  simp [widthTwoCircularDistance, abs_sub_comm]

theorem abs_sub_le_two_of_mem_Icc
    {x y : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 2)
    (hy : y ∈ Set.Icc (0 : ℝ) 2) :
    |x - y| ≤ 2 := by
  rw [abs_le]
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

theorem widthTwoCircularDistance_eq_on_Icc
    {x y : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 2)
    (hy : y ∈ Set.Icc (0 : ℝ) 2) :
    widthTwoCircularDistance x y =
      min |x - y| (2 - |x - y|) := by
  have h := abs_sub_le_two_of_mem_Icc hx hy
  simp [widthTwoCircularDistance, abs_of_nonneg (sub_nonneg.mpr h)]

theorem widthTwoCircularDistance_le_abs_sub (x y : ℝ) :
    widthTwoCircularDistance x y ≤ |x - y| := by
  exact min_le_left _ _

theorem widthTwoCircularDistance_continuous :
    Continuous
      (fun p : ℝ × ℝ => widthTwoCircularDistance p.1 p.2) := by
  unfold widthTwoCircularDistance
  fun_prop

/-! ## 2. The transition-corrected Slobodeckij quotient -/

/-- Numerator obtained by comparing values along the shortest circular arc.
The transition `tau` is used precisely when that arc crosses the seam
`0 ~ 2`. -/
def widthTwoTwistedIncrement
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (x y : ℝ) : ℂ :=
  if 1 < x - y then
    f x - tau y * f y
  else if 1 < y - x then
    tau x * f x - f y
  else
    f x - f y

/-- The exact `s = 1/2` Slobodeckij difference quotient.  Its value is set to
zero on the diagonal and at the identified endpoint pair, a product-null set
which does not affect the a.e. class. -/
def widthTwoTwistedDifferenceQuotient
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (p : ℝ × ℝ) : ℂ :=
  if widthTwoCircularDistance p.1 p.2 = 0 then
    0
  else
    widthTwoTwistedIncrement tau f p.1 p.2 /
      (widthTwoCircularDistance p.1 p.2 : ℂ)

@[simp]
theorem widthTwoTwistedIncrement_zero
    (tau : ℝ → ℂ) (x y : ℝ) :
    widthTwoTwistedIncrement tau (fun _ => 0) x y = 0 := by
  simp [widthTwoTwistedIncrement]

theorem widthTwoTwistedIncrement_add
    (tau : ℝ → ℂ) (f g : ℝ → ℂ) (x y : ℝ) :
    widthTwoTwistedIncrement tau (fun t => f t + g t) x y =
      widthTwoTwistedIncrement tau f x y +
        widthTwoTwistedIncrement tau g x y := by
  simp only [widthTwoTwistedIncrement]
  split_ifs <;> ring

theorem widthTwoTwistedIncrement_smul
    (tau : ℝ → ℂ) (c : ℂ) (f : ℝ → ℂ) (x y : ℝ) :
    widthTwoTwistedIncrement tau (fun t => c * f t) x y =
      c * widthTwoTwistedIncrement tau f x y := by
  simp only [widthTwoTwistedIncrement]
  split_ifs <;> ring

@[simp]
theorem widthTwoTwistedDifferenceQuotient_zero
    (tau : ℝ → ℂ) :
    widthTwoTwistedDifferenceQuotient tau (0 : ℝ → ℂ) = 0 := by
  funext p
  by_cases hp : widthTwoCircularDistance p.1 p.2 = 0
  · simp [widthTwoTwistedDifferenceQuotient, hp]
  · simp [widthTwoTwistedDifferenceQuotient, hp]
    change widthTwoTwistedIncrement tau
      (fun _ : ℝ => (0 : ℂ)) p.1 p.2 = 0
    exact widthTwoTwistedIncrement_zero tau p.1 p.2

theorem widthTwoTwistedDifferenceQuotient_add
    (tau : ℝ → ℂ) (f g : ℝ → ℂ) :
    widthTwoTwistedDifferenceQuotient tau (f + g) =
      widthTwoTwistedDifferenceQuotient tau f +
        widthTwoTwistedDifferenceQuotient tau g := by
  funext p
  by_cases hp : widthTwoCircularDistance p.1 p.2 = 0
  · simp [widthTwoTwistedDifferenceQuotient, hp]
  · simp only [widthTwoTwistedDifferenceQuotient, hp, if_false,
      Pi.add_apply]
    have hfg : f + g = fun t => f t + g t := rfl
    rw [hfg, widthTwoTwistedIncrement_add]
    ring

theorem widthTwoTwistedDifferenceQuotient_smul
    (tau : ℝ → ℂ) (c : ℂ) (f : ℝ → ℂ) :
    widthTwoTwistedDifferenceQuotient tau (c • f) =
      c • widthTwoTwistedDifferenceQuotient tau f := by
  funext p
  by_cases hp : widthTwoCircularDistance p.1 p.2 = 0
  · simp [widthTwoTwistedDifferenceQuotient, hp]
  · simp only [widthTwoTwistedDifferenceQuotient, hp, if_false,
      Pi.smul_apply, smul_eq_mul]
    have hcf : c • f = fun t => c * f t := rfl
    rw [hcf, widthTwoTwistedIncrement_smul]
    ring

theorem widthTwoTwistedIncrement_swap
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (x y : ℝ) :
    widthTwoTwistedIncrement tau f y x =
      -widthTwoTwistedIncrement tau f x y := by
  simp only [widthTwoTwistedIncrement]
  by_cases hxy : 1 < x - y
  · have hyx : ¬ 1 < y - x := by linarith
    simp [hxy, hyx]
  · by_cases hyx : 1 < y - x
    · simp [hxy, hyx]
    · simp [hxy, hyx]

theorem widthTwoTwistedDifferenceQuotient_swap
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (x y : ℝ) :
    widthTwoTwistedDifferenceQuotient tau f (y, x) =
      -widthTwoTwistedDifferenceQuotient tau f (x, y) := by
  rw [widthTwoTwistedDifferenceQuotient,
    widthTwoTwistedDifferenceQuotient,
    widthTwoCircularDistance_comm y x,
    widthTwoTwistedIncrement_swap]
  split_ifs <;> ring

/-- Borel measurability of the transition and the representative gives Borel
measurability of the full fractional difference quotient. -/
theorem widthTwoTwistedDifferenceQuotient_measurable
    {tau f : ℝ → ℂ} (htau : Measurable tau) (hf : Measurable f) :
    Measurable (widthTwoTwistedDifferenceQuotient tau f) := by
  have hxy : MeasurableSet
      {p : ℝ × ℝ | 1 < p.1 - p.2} :=
    measurableSet_lt measurable_const
      (measurable_fst.sub measurable_snd)
  have hyx : MeasurableSet
      {p : ℝ × ℝ | 1 < p.2 - p.1} :=
    measurableSet_lt measurable_const
      (measurable_snd.sub measurable_fst)
  have hinc : Measurable
      (fun p : ℝ × ℝ =>
        widthTwoTwistedIncrement tau f p.1 p.2) := by
    exact Measurable.ite hxy
      ((hf.comp measurable_fst).sub
        ((htau.comp measurable_snd).mul
          (hf.comp measurable_snd)))
      (Measurable.ite hyx
        (((htau.comp measurable_fst).mul
            (hf.comp measurable_fst)).sub
          (hf.comp measurable_snd))
        ((hf.comp measurable_fst).sub
          (hf.comp measurable_snd)))
  have hdist : Measurable
      (fun p : ℝ × ℝ => widthTwoCircularDistance p.1 p.2) :=
    widthTwoCircularDistance_continuous.measurable
  have hzero : MeasurableSet
      {p : ℝ × ℝ | widthTwoCircularDistance p.1 p.2 = 0} :=
    hdist (measurableSet_singleton 0)
  exact Measurable.ite hzero measurable_const
    (hinc.div (Complex.measurable_ofReal.comp hdist))

/-! ## 2.1. A reusable smooth-circle finiteness estimate -/

theorem widthTwoCircularDistance_eq_abs_sub_of_abs_sub_le_one
    {x y : ℝ} (hxy : |x - y| ≤ 1) :
    widthTwoCircularDistance x y = |x - y| := by
  unfold widthTwoCircularDistance
  have hnonneg : 0 ≤ 2 - |x - y| := by
    linarith [abs_nonneg (x - y)]
  have hle : |x - y| ≤ 2 - |x - y| := by
    linarith
  rw [abs_of_nonneg hnonneg, min_eq_left hle]

theorem widthTwoCircularDistance_eq_two_sub_of_one_lt_sub
    {x y : ℝ} (hxy : 1 < x - y) (hxyTwo : x - y ≤ 2) :
    widthTwoCircularDistance x y = 2 - (x - y) := by
  unfold widthTwoCircularDistance
  have hpos : 0 < x - y := lt_trans zero_lt_one hxy
  have hnonneg : 0 ≤ 2 - (x - y) := sub_nonneg.mpr hxyTwo
  have hright : 2 - (x - y) ≤ x - y := by linarith
  rw [abs_of_pos hpos, abs_of_nonneg hnonneg,
    min_eq_right hright]

/-- A Lipschitz representative on one doubled coordinate interval, together
with its exact seam covariance, controls the twisted circular numerator by
the circular distance. -/
theorem widthTwoTwistedIncrement_norm_le_of_lipschitz
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (K : NNReal)
    (hLip : LipschitzOnWith K f (Set.Icc (0 : ℝ) 4))
    (hCov : ∀ x ∈ Set.Icc (0 : ℝ) 2,
      f (x + 2) = tau x * f x)
    {x y : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 2)
    (hy : y ∈ Set.Icc (0 : ℝ) 2) :
    ‖widthTwoTwistedIncrement tau f x y‖ ≤
      (K : ℝ) * widthTwoCircularDistance x y := by
  have hx4 : x ∈ Set.Icc (0 : ℝ) 4 := ⟨hx.1, hx.2.trans (by norm_num)⟩
  have hy4 : y ∈ Set.Icc (0 : ℝ) 4 := ⟨hy.1, hy.2.trans (by norm_num)⟩
  by_cases hxy : 1 < x - y
  · have hyx : ¬ 1 < y - x := by linarith
    have hxyTwo : x - y ≤ 2 := by linarith [hx.2, hy.1]
    have hyShift : y + 2 ∈ Set.Icc (0 : ℝ) 4 := by
      constructor <;> linarith [hy.1, hy.2]
    have hdist : dist x (y + 2) = 2 - (x - y) := by
      rw [Real.dist_eq, abs_of_nonpos] <;> linarith
    have hbound := hLip.dist_le_mul x hx4 (y + 2) hyShift
    rw [widthTwoTwistedIncrement, if_pos hxy, ← hCov y hy]
    calc
      ‖f x - f (y + 2)‖ = dist (f x) (f (y + 2)) := by
        rw [dist_eq_norm]
      _ ≤ (K : ℝ) * dist x (y + 2) := hbound
      _ = (K : ℝ) * widthTwoCircularDistance x y := by
        rw [hdist,
          widthTwoCircularDistance_eq_two_sub_of_one_lt_sub
            hxy hxyTwo]
  · by_cases hyx : 1 < y - x
    · have hyxTwo : y - x ≤ 2 := by linarith [hy.2, hx.1]
      have hxShift : x + 2 ∈ Set.Icc (0 : ℝ) 4 := by
        constructor <;> linarith [hx.1, hx.2]
      have hdist : dist (x + 2) y = 2 - (y - x) := by
        rw [Real.dist_eq, abs_of_nonneg] <;> linarith
      have hbound := hLip.dist_le_mul (x + 2) hxShift y hy4
      rw [widthTwoTwistedIncrement, if_neg hxy, if_pos hyx,
        ← hCov x hx]
      calc
        ‖f (x + 2) - f y‖ = dist (f (x + 2)) (f y) := by
          rw [dist_eq_norm]
        _ ≤ (K : ℝ) * dist (x + 2) y := hbound
        _ = (K : ℝ) * widthTwoCircularDistance x y := by
          rw [hdist, widthTwoCircularDistance_comm x y,
            widthTwoCircularDistance_eq_two_sub_of_one_lt_sub
              hyx hyxTwo]
    · have habs : |x - y| ≤ 1 := by
        rw [abs_le]
        constructor <;> linarith
      have hbound := hLip.dist_le_mul x hx4 y hy4
      rw [widthTwoTwistedIncrement, if_neg hxy, if_neg hyx]
      calc
        ‖f x - f y‖ = dist (f x) (f y) := by
          rw [dist_eq_norm]
        _ ≤ (K : ℝ) * dist x y := hbound
        _ = (K : ℝ) * widthTwoCircularDistance x y := by
          rw [Real.dist_eq,
            widthTwoCircularDistance_eq_abs_sub_of_abs_sub_le_one habs]

/-- Pointwise boundedness of the exact `s=1/2` difference quotient. -/
theorem widthTwoTwistedDifferenceQuotient_norm_le_of_lipschitz
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (K : NNReal)
    (hLip : LipschitzOnWith K f (Set.Icc (0 : ℝ) 4))
    (hCov : ∀ x ∈ Set.Icc (0 : ℝ) 2,
      f (x + 2) = tau x * f x)
    {p : ℝ × ℝ} (hp : p ∈
      Set.Icc (0 : ℝ) 2 ×ˢ Set.Icc (0 : ℝ) 2) :
    ‖widthTwoTwistedDifferenceQuotient tau f p‖ ≤ (K : ℝ) := by
  have hnonneg := widthTwoCircularDistance_nonneg p.1 p.2
  by_cases hzero : widthTwoCircularDistance p.1 p.2 = 0
  · simp [widthTwoTwistedDifferenceQuotient, hzero]
  · have hpos : 0 < widthTwoCircularDistance p.1 p.2 :=
      lt_of_le_of_ne hnonneg (Ne.symm hzero)
    rw [widthTwoTwistedDifferenceQuotient, if_neg hzero,
      norm_div, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hnonneg]
    exact (div_le_iff₀ hpos).2
      (widthTwoTwistedIncrement_norm_le_of_lipschitz
        tau f K hLip hCov hp.1 hp.2)

/-- The elementary one-dimensional trace estimate: measurable Lipschitz
quasiperiodic data have finite twisted Slobodeckij `H^(1/2)` energy. -/
theorem widthTwoTwistedDifferenceQuotient_memLp_of_lipschitz
    (tau : ℝ → ℂ) (f : ℝ → ℂ) (K : NNReal)
    (htau : Measurable tau) (hf : Measurable f)
    (hLip : LipschitzOnWith K f (Set.Icc (0 : ℝ) 4))
    (hCov : ∀ x ∈ Set.Icc (0 : ℝ) 2,
      f (x + 2) = tau x * f x) :
    MemLp (widthTwoTwistedDifferenceQuotient tau f) 2
      actualFixedPhaseWidthTwoProductMeasure := by
  refine MemLp.of_bound
    (p := (2 : ℝ≥0∞))
    (μ := actualFixedPhaseWidthTwoProductMeasure)
    (widthTwoTwistedDifferenceQuotient_measurable
      htau hf).aestronglyMeasurable (K : ℝ) ?_
  have hmem :
      ∀ᵐ x ∂actualFixedPhaseWidthTwoParameterMeasure,
        x ∈ Set.Icc (0 : ℝ) 2 :=
    ae_restrict_mem measurableSet_Icc
  have hfst :
      ∀ᵐ p : ℝ × ℝ ∂actualFixedPhaseWidthTwoProductMeasure,
        p.1 ∈ Set.Icc (0 : ℝ) 2 :=
    (Measure.quasiMeasurePreserving_fst
      (μ := actualFixedPhaseWidthTwoParameterMeasure)
      (ν := actualFixedPhaseWidthTwoParameterMeasure)).ae hmem
  have hsnd :
      ∀ᵐ p : ℝ × ℝ ∂actualFixedPhaseWidthTwoProductMeasure,
        p.2 ∈ Set.Icc (0 : ℝ) 2 :=
    (Measure.quasiMeasurePreserving_snd
      (μ := actualFixedPhaseWidthTwoParameterMeasure)
      (ν := actualFixedPhaseWidthTwoParameterMeasure)).ae hmem
  filter_upwards [hfst, hsnd] with p hp1 hp2
  exact widthTwoTwistedDifferenceQuotient_norm_le_of_lipschitz
    tau f K hLip hCov ⟨hp1, hp2⟩

/-! ## 3. Almost-everywhere stability with respect to `L2` representatives -/

/-- Changing a boundary function on a parameter-null set changes its double
difference quotient only on a product-null set. -/
theorem widthTwoTwistedDifferenceQuotient_congr_ae
    (tau : ℝ → ℂ) {f g : ℝ → ℂ}
    (hfg : f =ᵐ[actualFixedPhaseWidthTwoParameterMeasure] g) :
    widthTwoTwistedDifferenceQuotient tau f =ᵐ[
        actualFixedPhaseWidthTwoProductMeasure]
      widthTwoTwistedDifferenceQuotient tau g := by
  have hfst :
      ∀ᵐ p : ℝ × ℝ ∂actualFixedPhaseWidthTwoProductMeasure,
        f p.1 = g p.1 :=
    (Measure.quasiMeasurePreserving_fst
      (μ := actualFixedPhaseWidthTwoParameterMeasure)
      (ν := actualFixedPhaseWidthTwoParameterMeasure)).ae hfg
  have hsnd :
      ∀ᵐ p : ℝ × ℝ ∂actualFixedPhaseWidthTwoProductMeasure,
        f p.2 = g p.2 :=
    (Measure.quasiMeasurePreserving_snd
      (μ := actualFixedPhaseWidthTwoParameterMeasure)
      (ν := actualFixedPhaseWidthTwoParameterMeasure)).ae hfg
  filter_upwards [hfst, hsnd] with p hp1 hp2
  simp only [widthTwoTwistedDifferenceQuotient,
    widthTwoTwistedIncrement]
  rw [hp1, hp2]

/-- `L2` addition is pointwise only almost everywhere; the product-measure
lemma above supplies exactly the compatibility needed by the Gagliardo
coordinate. -/
theorem widthTwoTwistedDifferenceQuotient_L2_add_ae
    (tau : ℝ → ℂ) (f g : ActualFixedPhaseWidthTwoL2) :
    widthTwoTwistedDifferenceQuotient tau ((↑(f + g) : ℝ → ℂ)) =ᵐ[
        actualFixedPhaseWidthTwoProductMeasure]
      widthTwoTwistedDifferenceQuotient tau f +
        widthTwoTwistedDifferenceQuotient tau g := by
  exact
    (widthTwoTwistedDifferenceQuotient_congr_ae tau
      (Lp.coeFn_add f g)).trans
      (Eventually.of_forall fun p => by
        exact congrFun
          (widthTwoTwistedDifferenceQuotient_add tau f g) p)

theorem widthTwoTwistedDifferenceQuotient_L2_smul_ae
    (tau : ℝ → ℂ) (c : ℂ) (f : ActualFixedPhaseWidthTwoL2) :
    widthTwoTwistedDifferenceQuotient tau ((↑(c • f) : ℝ → ℂ)) =ᵐ[
        actualFixedPhaseWidthTwoProductMeasure]
      c • widthTwoTwistedDifferenceQuotient tau f := by
  exact
    (widthTwoTwistedDifferenceQuotient_congr_ae tau
      (Lp.coeFn_smul c f)).trans
      (Eventually.of_forall fun p => by
        exact congrFun
          (widthTwoTwistedDifferenceQuotient_smul tau c f) p)

theorem widthTwoTwistedDifferenceQuotient_L2_zero_ae
    (tau : ℝ → ℂ) :
    widthTwoTwistedDifferenceQuotient tau
        (0 : ActualFixedPhaseWidthTwoL2) =ᵐ[
          actualFixedPhaseWidthTwoProductMeasure]
      0 := by
  exact
    (widthTwoTwistedDifferenceQuotient_congr_ae tau
      (Lp.coeFn_zero ℂ 2
        actualFixedPhaseWidthTwoParameterMeasure)).trans
      (Eventually.of_forall fun p => by
        exact congrFun
          (widthTwoTwistedDifferenceQuotient_zero tau) p)

/-! ## 4. The genuine finite-energy domain and its graph norm -/

/-- The second `L2` coordinate in the `H^(1/2)` graph. -/
abbrev ActualFixedPhaseWidthTwoGagliardoL2 :=
  MeasureTheory.Lp ℂ 2 actualFixedPhaseWidthTwoProductMeasure

/-- Boundary `L2` classes whose transition-corrected circular difference
quotient is square-integrable.  This is a genuine additional regularity
condition, not a synonym for `ActualFixedPhaseWidthTwoL2`. -/
noncomputable def widthTwoHhalfDomain (tau : ℝ → ℂ) :
    Submodule ℂ ActualFixedPhaseWidthTwoL2 where
  carrier := {f |
    MemLp (widthTwoTwistedDifferenceQuotient tau f) 2
      actualFixedPhaseWidthTwoProductMeasure}
  zero_mem' := by
    apply (memLp_congr_ae
      (widthTwoTwistedDifferenceQuotient_L2_zero_ae tau)).2
    exact MemLp.zero
  add_mem' := by
    intro f g hf hg
    apply (memLp_congr_ae
      (widthTwoTwistedDifferenceQuotient_L2_add_ae tau f g)).2
    exact hf.add hg
  smul_mem' := by
    intro c f hf
    apply (memLp_congr_ae
      (widthTwoTwistedDifferenceQuotient_L2_smul_ae tau c f)).2
    exact hf.const_smul c

/-- The finite Slobodeckij energy of a raw boundary representative.  The
definition is displayed independently of `MemLp` so downstream estimates can
refer to the actual double integral. -/
noncomputable def widthTwoGagliardoEnergy
    (tau : ℝ → ℂ) (f : ℝ → ℂ) : ℝ≥0∞ :=
  ∫⁻ p, ‖widthTwoTwistedDifferenceQuotient tau f p‖ₑ ^ (2 : ℕ)
    ∂actualFixedPhaseWidthTwoProductMeasure

/-- Membership in the project-local Slobodeckij domain really makes the
displayed double integral finite; `MemLp` is not used merely as an opaque
label for regularity. -/
theorem widthTwoGagliardoEnergy_lt_top_of_memLp
    (tau : ℝ → ℂ) (f : ℝ → ℂ)
    (hf : MemLp (widthTwoTwistedDifferenceQuotient tau f) 2
      actualFixedPhaseWidthTwoProductMeasure) :
    widthTwoGagliardoEnergy tau f < (∞ : ℝ≥0∞) := by
  have hfinite :=
    lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (p := (2 : ℝ≥0∞))
      (μ := actualFixedPhaseWidthTwoProductMeasure)
      (f := widthTwoTwistedDifferenceQuotient tau f)
      (by norm_num) (by norm_num) hf.2
  simpa [widthTwoGagliardoEnergy, ENNReal.rpow_two] using hfinite

/-- The square-integrable difference quotient as an actual `L2` vector. -/
noncomputable def widthTwoHhalfDifferenceToL2
    (tau : ℝ → ℂ) :
    widthTwoHhalfDomain tau →ₗ[ℂ]
      ActualFixedPhaseWidthTwoGagliardoL2 where
  toFun f := f.property.toLp
    (widthTwoTwistedDifferenceQuotient tau f.1)
  map_add' f g := by
    calc
      (f + g).property.toLp
          (widthTwoTwistedDifferenceQuotient tau (f + g :
            widthTwoHhalfDomain tau).1) =
        (f.property.add g.property).toLp
          (widthTwoTwistedDifferenceQuotient tau f.1 +
            widthTwoTwistedDifferenceQuotient tau g.1) :=
          MemLp.toLp_congr _ _
            (widthTwoTwistedDifferenceQuotient_L2_add_ae
              tau f.1 g.1)
      _ = f.property.toLp
            (widthTwoTwistedDifferenceQuotient tau f.1) +
          g.property.toLp
            (widthTwoTwistedDifferenceQuotient tau g.1) :=
        MemLp.toLp_add f.property g.property
  map_smul' c f := by
    calc
      (c • f).property.toLp
          (widthTwoTwistedDifferenceQuotient tau (c • f :
            widthTwoHhalfDomain tau).1) =
        (f.property.const_smul c).toLp
          (c • widthTwoTwistedDifferenceQuotient tau f.1) :=
          MemLp.toLp_congr _ _
            (widthTwoTwistedDifferenceQuotient_L2_smul_ae
              tau c f.1)
      _ = c • f.property.toLp
            (widthTwoTwistedDifferenceQuotient tau f.1) :=
        MemLp.toLp_const_smul c f.property

/-- Hilbert product containing the `L2` value and the true fractional
difference quotient. -/
abbrev WidthTwoHhalfGraphAmbient :=
  WithLp 2
    (ActualFixedPhaseWidthTwoL2 ×
      ActualFixedPhaseWidthTwoGagliardoL2)

/-- Exact graph map defining the project-local `H^(1/2)` norm. -/
noncomputable def widthTwoHhalfGraphMap (tau : ℝ → ℂ) :
    widthTwoHhalfDomain tau →ₗ[ℂ] WidthTwoHhalfGraphAmbient :=
  (WithLp.linearEquiv 2 ℂ
      (ActualFixedPhaseWidthTwoL2 ×
        ActualFixedPhaseWidthTwoGagliardoL2)).symm.toLinearMap.comp
    ((widthTwoHhalfDomain tau).subtype.prod
      (widthTwoHhalfDifferenceToL2 tau))

@[simp]
theorem widthTwoHhalfGraphMap_fst
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) :
    (widthTwoHhalfGraphMap tau f).fst = f.1 := by
  rfl

@[simp]
theorem widthTwoHhalfGraphMap_snd
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) :
    (widthTwoHhalfGraphMap tau f).snd =
      widthTwoHhalfDifferenceToL2 tau f := by
  rfl

theorem widthTwoHhalfGraphMap_injective (tau : ℝ → ℂ) :
    Function.Injective (widthTwoHhalfGraphMap tau) := by
  intro f g hfg
  apply Subtype.ext
  simpa using congrArg WithLp.fst hfg

/-- The exact graph norm on the finite-energy domain. -/
noncomputable def widthTwoHhalfGraphNorm
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) : ℝ :=
  ‖widthTwoHhalfGraphMap tau f‖

theorem widthTwoHhalfGraphNorm_sq
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) :
    widthTwoHhalfGraphNorm tau f ^ 2 =
      ‖f.1‖ ^ 2 + ‖widthTwoHhalfDifferenceToL2 tau f‖ ^ 2 := by
  simpa only [widthTwoHhalfGraphNorm,
    widthTwoHhalfGraphMap_fst, widthTwoHhalfGraphMap_snd] using
      (WithLp.prod_norm_sq_eq_of_L2
        (widthTwoHhalfGraphMap tau f))

/-! ## 5. Hilbert completion and the strict forgetful direction -/

/-- Algebraic finite-energy graph. -/
noncomputable def widthTwoHhalfGraphRange (tau : ℝ → ℂ) :
    Submodule ℂ WidthTwoHhalfGraphAmbient :=
  LinearMap.range (widthTwoHhalfGraphMap tau)

/-- Project-local twisted `H^(1/2)` boundary Hilbert space. -/
abbrev WidthTwoHhalfCompletion (tau : ℝ → ℂ) :=
  (widthTwoHhalfGraphRange tau).topologicalClosure

theorem widthTwoHhalfGraphRange_le_completion (tau : ℝ → ℂ) :
    widthTwoHhalfGraphRange tau ≤
      (widthTwoHhalfGraphRange tau).topologicalClosure :=
  Submodule.le_topologicalClosure (widthTwoHhalfGraphRange tau)

theorem widthTwoHhalfCompletion_isClosed (tau : ℝ → ℂ) :
    IsClosed
      ((WidthTwoHhalfCompletion tau :
        Submodule ℂ WidthTwoHhalfGraphAmbient) :
        Set WidthTwoHhalfGraphAmbient) :=
  Submodule.isClosed_topologicalClosure (widthTwoHhalfGraphRange tau)

/-- Surjection of the finite-energy function domain onto its graph range. -/
noncomputable def widthTwoHhalfRangeMap (tau : ℝ → ℂ) :
    widthTwoHhalfDomain tau →ₗ[ℂ]
      widthTwoHhalfGraphRange tau :=
  (widthTwoHhalfGraphMap tau).rangeRestrict

theorem widthTwoHhalfRangeMap_surjective (tau : ℝ → ℂ) :
    Function.Surjective (widthTwoHhalfRangeMap tau) := by
  rintro ⟨x, f, rfl⟩
  exact ⟨f, rfl⟩

/-- Isometric inclusion of the algebraic graph into its closure. -/
noncomputable def widthTwoHhalfRangeInclusion (tau : ℝ → ℂ) :
    widthTwoHhalfGraphRange tau →ₗᵢ[ℂ]
      WidthTwoHhalfCompletion tau where
  toFun f :=
    ⟨(f : WidthTwoHhalfGraphAmbient),
      widthTwoHhalfGraphRange_le_completion tau f.property⟩
  map_add' f g := by rfl
  map_smul' c f := by rfl
  norm_map' f := by rfl

theorem widthTwoHhalfRangeInclusion_denseRange (tau : ℝ → ℂ) :
    DenseRange (widthTwoHhalfRangeInclusion tau) := by
  change Dense
    (Set.range (fun f : widthTwoHhalfGraphRange tau =>
      widthTwoHhalfRangeInclusion tau f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : WidthTwoHhalfGraphAmbient) ∈
      closure
        (Subtype.val ''
          Set.range
            (fun f : widthTwoHhalfGraphRange tau =>
              widthTwoHhalfRangeInclusion tau f))
  have hImage :
      Subtype.val ''
          Set.range
            (fun f : widthTwoHhalfGraphRange tau =>
              widthTwoHhalfRangeInclusion tau f) =
        ((widthTwoHhalfGraphRange tau :
          Submodule ℂ WidthTwoHhalfGraphAmbient) :
          Set WidthTwoHhalfGraphAmbient) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : widthTwoHhalfGraphRange tau := ⟨z, hz⟩
      exact ⟨widthTwoHhalfRangeInclusion tau f, ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- Dense map of actual finite-energy boundary functions into the completed
twisted `H^(1/2)` space. -/
noncomputable def widthTwoHhalfCoreMap (tau : ℝ → ℂ) :
    widthTwoHhalfDomain tau →ₗ[ℂ]
      WidthTwoHhalfCompletion tau :=
  (widthTwoHhalfRangeInclusion tau).toLinearMap.comp
    (widthTwoHhalfRangeMap tau)

theorem widthTwoHhalfCoreMap_denseRange (tau : ℝ → ℂ) :
    DenseRange (widthTwoHhalfCoreMap tau) := by
  have hs : DenseRange (widthTwoHhalfRangeMap tau) :=
    (widthTwoHhalfRangeMap_surjective tau).denseRange
  have hc := (widthTwoHhalfRangeInclusion_denseRange tau).comp
    hs (widthTwoHhalfRangeInclusion tau).continuous
  simpa [widthTwoHhalfCoreMap, Function.comp_def] using hc

theorem widthTwoHhalfCoreMap_injective (tau : ℝ → ℂ) :
    Function.Injective (widthTwoHhalfCoreMap tau) := by
  intro f g hfg
  apply widthTwoHhalfGraphMap_injective tau
  exact congrArg Subtype.val hfg

/-- Forget fractional regularity and retain the stored boundary `L2` value.
Only this direction is unconditional. -/
noncomputable def widthTwoHhalfToL2 (tau : ℝ → ℂ) :
    WidthTwoHhalfCompletion tau →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  (WithLp.fstL 2 ℂ ActualFixedPhaseWidthTwoL2
      ActualFixedPhaseWidthTwoGagliardoL2).comp
    (Submodule.subtypeL
      ((widthTwoHhalfGraphRange tau).topologicalClosure))

/-- Bounded fractional difference coordinate. -/
noncomputable def widthTwoHhalfDifferenceProjection
    (tau : ℝ → ℂ) :
    WidthTwoHhalfCompletion tau →L[ℂ]
      ActualFixedPhaseWidthTwoGagliardoL2 :=
  (WithLp.sndL 2 ℂ ActualFixedPhaseWidthTwoL2
      ActualFixedPhaseWidthTwoGagliardoL2).comp
    (Submodule.subtypeL
      ((widthTwoHhalfGraphRange tau).topologicalClosure))

@[simp]
theorem widthTwoHhalfToL2_core
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) :
    widthTwoHhalfToL2 tau (widthTwoHhalfCoreMap tau f) = f.1 := by
  rfl

@[simp]
theorem widthTwoHhalfDifferenceProjection_core
    (tau : ℝ → ℂ) (f : widthTwoHhalfDomain tau) :
    widthTwoHhalfDifferenceProjection tau
        (widthTwoHhalfCoreMap tau f) =
      widthTwoHhalfDifferenceToL2 tau f := by
  rfl

theorem widthTwoHhalfToL2_norm_le
    (tau : ℝ → ℂ) (f : WidthTwoHhalfCompletion tau) :
    ‖widthTwoHhalfToL2 tau f‖ ≤ ‖f‖ := by
  change ‖(f : WidthTwoHhalfGraphAmbient).fst‖ ≤
    ‖(f : WidthTwoHhalfGraphAmbient)‖
  exact WithLp.norm_fst_le ActualFixedPhaseWidthTwoL2 (f : WidthTwoHhalfGraphAmbient)

theorem widthTwoHhalfDifferenceProjection_norm_le
    (tau : ℝ → ℂ) (f : WidthTwoHhalfCompletion tau) :
    ‖widthTwoHhalfDifferenceProjection tau f‖ ≤ ‖f‖ := by
  change ‖(f : WidthTwoHhalfGraphAmbient).snd‖ ≤
    ‖(f : WidthTwoHhalfGraphAmbient)‖
  exact WithLp.norm_snd_le ActualFixedPhaseWidthTwoL2 (f : WidthTwoHhalfGraphAmbient)

noncomputable def widthTwoHhalfCompletionCompleteSpace
    (tau : ℝ → ℂ) :
    CompleteSpace (WidthTwoHhalfCompletion tau) :=
  inferInstance

noncomputable instance widthTwoHhalfCompletionInnerProductSpace
    (tau : ℝ → ℂ) :
    InnerProductSpace ℂ (WidthTwoHhalfCompletion tau) :=
  inferInstance

/-! ## 6. The actual inverse-eta transition at each named cusp -/

/-- Bundled width-two deck transformation at a named cusp. -/
def actualFixedPhaseCuspDeckTranslation
    (kappa : GammaTwoCusp) : GammaTwo :=
  ⟨gammaTwoCuspTranslation kappa 1,
    gammaTwoCuspTranslation_mem kappa 1⟩

@[simp]
theorem coe_actualFixedPhaseCuspDeckTranslation
    (kappa : GammaTwoCusp) :
    ((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
      SL(2, ℤ)) = gammaTwoCuspTranslation kappa 1 :=
  rfl

/-- Exact geometric width-two shift in every scaling chart. -/
theorem actualFixedPhaseCuspHorocyclePoint_add_two
    (kappa : GammaTwoCusp) (Y x : ℝ) :
    actualFixedPhaseCuspHorocyclePoint kappa Y (x + 2) =
      actualFixedPhaseCuspDeckTranslation kappa •
        actualFixedPhaseCuspHorocyclePoint kappa Y x := by
  rw [show actualFixedPhaseCuspDeckTranslation kappa •
      actualFixedPhaseCuspHorocyclePoint kappa Y x =
    gammaTwoCuspTranslation kappa 1 •
      actualFixedPhaseCuspHorocyclePoint kappa Y x by rfl]
  simp only [actualFixedPhaseCuspHorocyclePoint,
    gammaTwoCuspTranslation, mul_smul, inv_smul_smul]
  congr 1
  rw [UpperHalfPlane.modular_T_zpow_smul,
    UpperHalfPlane.ext_iff]
  simp [actualFixedPhaseHorizontalHorocyclePoint,
    UpperHalfPlane.coe_vadd]
  ring

/-- Actual scalar transition in the raw automorphic trivialization.  It is a
function of the boundary coordinate at the non-infinity cusps and is not
silently replaced by a constant phase. -/
noncomputable def actualFixedPhaseCuspBoundaryTransition
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) (x : ℝ) : ℂ :=
  (inverseEtaPaperOrbitMultiplier GammaTwo n).factor
    (actualFixedPhaseCuspDeckTranslation kappa)
    (actualFixedPhaseCuspHorocyclePoint kappa Y x)

theorem actualFixedPhaseCuspBoundaryTransition_ne_zero
    (n : ℤ) (kappa : GammaTwoCusp) (Y x : ℝ) :
    actualFixedPhaseCuspBoundaryTransition n kappa Y x ≠ 0 := by
  exact (inverseEtaPaperOrbitMultiplier GammaTwo n).factor_ne_zero
    (actualFixedPhaseCuspDeckTranslation kappa)
    (actualFixedPhaseCuspHorocyclePoint kappa Y x)

/-- The actual inverse-eta transition varies continuously in the chosen raw
boundary trivialization. -/
theorem actualFixedPhaseCuspBoundaryTransition_continuous
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    Continuous
      (actualFixedPhaseCuspBoundaryTransition n kappa Y) := by
  have hpoint : Continuous
      (actualFixedPhaseCuspHorocyclePoint kappa Y) :=
    actualFixedPhaseCuspHorocyclePoint_continuous kappa Y
  have hcoe : Continuous
      (fun x : ℝ =>
        ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) :=
    UpperHalfPlane.continuous_coe.comp hpoint
  have heta : Continuous
      (fun x : ℝ =>
        ModularForm.eta
          ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) :=
    Mock2FA.PaperCorrections.AutomorphicSobolev.HalfIntegralMultiplier.continuous_eta_upperHalfPlane.comp
      hpoint
  have hetaShift : Continuous
      (fun x : ℝ =>
        ModularForm.eta
          ((actualFixedPhaseCuspHorocyclePoint
              kappa Y (x + 2) : ℍ) : ℂ)) :=
    heta.comp (continuous_id.add continuous_const)
  have hinverseEta : Continuous
      (fun x : ℝ =>
        (inverseEtaMultiplier GammaTwo).factor
          (actualFixedPhaseCuspDeckTranslation kappa)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x)) := by
    refine (heta.div hetaShift
      (fun x => ModularForm.eta_ne_zero
        (actualFixedPhaseCuspHorocyclePoint kappa Y (x + 2)).2)).congr
          (fun x => ?_)
    rw [inverseEtaMultiplier_factor]
    exact congrArg
      (fun z : ℍ =>
        ModularForm.eta
            ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ) /
          ModularForm.eta (z : ℂ))
      (actualFixedPhaseCuspHorocyclePoint_add_two kappa Y x)
  have hden : Continuous
      (fun x : ℝ =>
        UpperHalfPlane.denom
          ((((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
            SL(2, ℤ))) : GL (Fin 2) ℝ)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x)) := by
    fun_prop
  have hdenPow : Continuous
      (fun x : ℝ =>
        UpperHalfPlane.denom
          ((((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
            SL(2, ℤ))) : GL (Fin 2) ℝ)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x) ^
            ((2 : ℤ) * n)) :=
    hden.zpow₀ ((2 : ℤ) * n)
      (fun x => Or.inl
        (UpperHalfPlane.denom_ne_zero
          ((((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
            SL(2, ℤ))) : GL (Fin 2) ℝ)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x)))
  change Continuous
    (fun x : ℝ =>
      (inverseEtaPaperOrbitMultiplier GammaTwo n).factor
        (actualFixedPhaseCuspDeckTranslation kappa)
        (actualFixedPhaseCuspHorocyclePoint kappa Y x))
  have hproduct := hinverseEta.mul hdenPow
  change Continuous
    (fun x : ℝ =>
      (inverseEtaMultiplier GammaTwo).factor
          (actualFixedPhaseCuspDeckTranslation kappa)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x) *
        UpperHalfPlane.denom
          ((((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
            SL(2, ℤ))) : GL (Fin 2) ℝ)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x) ^
            ((2 : ℤ) * n)) at hproduct
  simpa only [inverseEtaPaperOrbitMultiplier_factor] using hproduct

/-- Exact quasiperiodicity of every actual fixed-phase smooth core trace.
This theorem supplies the seam transition used by the fractional norm. -/
theorem actualFixedPhaseNamedCuspTraceRepresentative_add_two
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (x : ℝ) :
    actualFixedPhaseNamedCuspTraceRepresentative
        n kappa Y u (x + 2) =
      actualFixedPhaseCuspBoundaryTransition n kappa Y x *
        actualFixedPhaseNamedCuspTraceRepresentative
          n kappa Y u x := by
  rw [actualFixedPhaseNamedCuspTraceRepresentative,
    actualFixedPhaseCuspHorocyclePoint_add_two]
  change
    ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
        ((((actualFixedPhaseCuspDeckTranslation kappa : GammaTwo) :
          SL(2, ℤ))) •
          actualFixedPhaseCuspHorocyclePoint kappa Y x) =
      (inverseEtaPaperOrbitMultiplier GammaTwo n).factor
          (actualFixedPhaseCuspDeckTranslation kappa)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x) *
        ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x)
  have hcov :=
    (u.2 FixedPhaseDifferentialWord.nil)
      (actualFixedPhaseCuspDeckTranslation kappa)
      (actualFixedPhaseCuspHorocyclePoint kappa Y x)
  simpa [FixedPhaseDifferentialWord.targetIndex,
    FixedPhaseDifferentialWord.eval_nil_apply,
    InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction] using hcov

/-- Endpoint gluing is the `x = 0` instance of the full width-two covariance,
not an additional boundary assumption. -/
theorem actualFixedPhaseNamedCuspTraceRepresentative_endpoint
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u 2 =
      actualFixedPhaseCuspBoundaryTransition n kappa Y 0 *
        actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u 0 := by
  simpa using
    (actualFixedPhaseNamedCuspTraceRepresentative_add_two
      n kappa Y u 0)

/-- The exact actual fractional quotient is Borel measurable for every smooth
fixed-phase core section.  Its square-integrability is proved below from the
compact Lipschitz estimate. -/
theorem actualFixedPhaseNamedCuspDifferenceQuotient_measurable
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    Measurable
      (widthTwoTwistedDifferenceQuotient
        (actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (actualFixedPhaseNamedCuspTraceRepresentative
          n kappa Y u)) :=
  widthTwoTwistedDifferenceQuotient_measurable
    (actualFixedPhaseCuspBoundaryTransition_continuous
      n kappa Y).measurable
    (actualFixedPhaseNamedCuspTraceRepresentative_continuous
      n kappa Y u).measurable

/-- The complex coordinate of every named-cusp horocycle parametrization is
real `C-infinity`.  This is a direct rational-map calculation; the denominator
cannot vanish on the upper half-plane. -/
theorem actualFixedPhaseCuspHorocyclePoint_coe_contDiff
    (kappa : GammaTwoCusp) (Y : ℝ) :
    ContDiff ℝ ∞
      (fun x : ℝ =>
        ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) := by
  let g : GL (Fin 2) ℝ :=
    (gammaTwoCuspScaling kappa : GL (Fin 2) ℝ)
  have hg : 0 < g.det.val := by
    simp [g]
  have hcurve : ContDiff ℝ ∞
      (fun x : ℝ =>
        (x : ℂ) +
          (actualFixedPhaseCuspHeight Y : ℂ) * Complex.I) := by
    simpa only [Complex.ofRealCLM_apply] using
      Complex.ofRealCLM.contDiff.add contDiff_const
  have hnum : ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.num g
          (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ)) := by
    simpa only [UpperHalfPlane.num,
      actualFixedPhaseHorizontalHorocyclePoint] using
      (contDiff_const.mul hcurve).add contDiff_const
  have hdenDiff : ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.denom g
          (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ)) := by
    simpa only [UpperHalfPlane.denom,
      actualFixedPhaseHorizontalHorocyclePoint] using
      (contDiff_const.mul hcurve).add contDiff_const
  have hden : ∀ x : ℝ,
      UpperHalfPlane.denom g
        (actualFixedPhaseHorizontalHorocyclePoint Y x) ≠ 0 := by
    intro x
    exact UpperHalfPlane.denom_ne_zero g
      (actualFixedPhaseHorizontalHorocyclePoint Y x)
  have hinvRaw := hdenDiff.inv hden
  change ContDiff ℝ ∞
      (fun x : ℝ =>
        (UpperHalfPlane.denom g
          (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ))⁻¹) at hinvRaw
  have hmulRaw := hnum.mul hinvRaw
  change ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.num g
            (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ) *
          (UpperHalfPlane.denom g
            (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ))⁻¹) at hmulRaw
  have hfrac : ContDiff ℝ ∞
      (fun x : ℝ =>
        UpperHalfPlane.num g
            (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ) /
          UpperHalfPlane.denom g
            (actualFixedPhaseHorizontalHorocyclePoint Y x : ℂ)) := by
    simpa only [div_eq_mul_inv] using hmulRaw
  change ContDiff ℝ ∞
    (fun x : ℝ =>
      (↑(g • actualFixedPhaseHorizontalHorocyclePoint Y x) : ℂ))
  simpa only [UpperHalfPlane.coe_smul_of_det_pos hg] using hfrac

/-- Restriction of every actual real-smooth automorphic core section to a
named cusp horocycle is a real `C-infinity` function of the boundary
parameter. -/
theorem actualFixedPhaseNamedCuspTraceRepresentative_contDiff
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ContDiff ℝ ∞
      (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u) := by
  have hu : ContDiffOn ℝ ∞
      (upperLift ((u : SmoothQuotientCompactFunction) : ℍ → ℂ))
      UpperHalfPlane.upperHalfPlaneSet :=
    (u : SmoothQuotientCompactFunction).1.2
  have hcurve := actualFixedPhaseCuspHorocyclePoint_coe_contDiff kappa Y
  have hcomp := hu.comp_contDiff hcurve
    (fun x => (actualFixedPhaseCuspHorocyclePoint kappa Y x).2)
  have hfun :
      (upperLift ((u : SmoothQuotientCompactFunction) : ℍ → ℂ) ∘
        fun x : ℝ =>
          ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)) =
        actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u := by
    funext x
    change
      upperLift ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
          ((actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ) =
        (u : SmoothQuotientCompactFunction)
          (actualFixedPhaseCuspHorocyclePoint kappa Y x)
    exact upperLift_apply
      ((u : SmoothQuotientCompactFunction) : ℍ → ℂ)
      (actualFixedPhaseCuspHorocyclePoint kappa Y x)
  rw [← hfun]
  exact hcomp

/-- Every actual smooth trace is Lipschitz on the compact doubled interval
needed by the seam estimate. -/
theorem actualFixedPhaseNamedCuspTraceRepresentative_exists_lipschitzOn
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    ∃ K : NNReal,
      LipschitzOnWith K
        (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u)
        (Set.Icc (0 : ℝ) 4) := by
  exact
    (actualFixedPhaseNamedCuspTraceRepresentative_contDiff
      n kappa Y u).contDiffOn.exists_lipschitzOnWith
        (by simp) (convex_Icc (0 : ℝ) 4) isCompact_Icc

/-- Smoothness plus the proved multiplier seam law makes every actual core
trace a genuine `H^(1/2)` boundary value at each named cusp. -/
theorem actualFixedPhaseNamedCuspDifferenceQuotient_memLp
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    MemLp
      (widthTwoTwistedDifferenceQuotient
        (actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u))
      2 actualFixedPhaseWidthTwoProductMeasure := by
  obtain ⟨K, hLip⟩ :=
    actualFixedPhaseNamedCuspTraceRepresentative_exists_lipschitzOn
      n kappa Y u
  exact widthTwoTwistedDifferenceQuotient_memLp_of_lipschitz
    (actualFixedPhaseCuspBoundaryTransition n kappa Y)
    (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u)
    K
    (actualFixedPhaseCuspBoundaryTransition_continuous
      n kappa Y).measurable
    (actualFixedPhaseNamedCuspTraceRepresentative_continuous
      n kappa Y u).measurable
    hLip
    (fun x _hx =>
      actualFixedPhaseNamedCuspTraceRepresentative_add_two
        n kappa Y u x)

/-- Literal finiteness of the twisted Gagliardo double integral for every
actual smooth automorphic core trace. -/
theorem actualFixedPhaseNamedCuspGagliardoEnergy_lt_top
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    widthTwoGagliardoEnergy
        (actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u) < (∞ : ℝ≥0∞) :=
  widthTwoGagliardoEnergy_lt_top_of_memLp
    (actualFixedPhaseCuspBoundaryTransition n kappa Y)
    (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u)
    (actualFixedPhaseNamedCuspDifferenceQuotient_memLp
      n kappa Y u)

/-- Genuine fractional boundary space at a named cusp, with the exact
inverse-eta transition at that cusp. -/
abbrev ActualFixedPhaseNamedCuspBoundaryHhalf
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :=
  WidthTwoHhalfCompletion
    (actualFixedPhaseCuspBoundaryTransition n kappa Y)

/-- Hilbert direct sum of the three genuine fractional cusp targets. -/
abbrev ActualFixedPhaseThreeCuspBoundaryHhalf
    (n : ℤ) (Y : ℝ) :=
  WithLp 2
    (ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y ×
      WithLp 2
        (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
          ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y))

/-! ## 7. The maximal actual smooth subcore with finite fractional energy -/

@[simp]
theorem actualFixedPhaseNamedCuspTraceRepresentative_zero
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    actualFixedPhaseNamedCuspTraceRepresentative
        n kappa Y (0 : InverseEtaFixedPhaseCore n) = 0 := by
  funext x
  simp [actualFixedPhaseNamedCuspTraceRepresentative,
    InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction]

theorem actualFixedPhaseNamedCuspTraceRepresentative_add
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u v : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseNamedCuspTraceRepresentative n kappa Y (u + v) =
      actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u +
        actualFixedPhaseNamedCuspTraceRepresentative n kappa Y v := by
  funext x
  simp [actualFixedPhaseNamedCuspTraceRepresentative,
    InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction]

theorem actualFixedPhaseNamedCuspTraceRepresentative_smul
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (c : ℂ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseNamedCuspTraceRepresentative n kappa Y (c • u) =
      c • actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u := by
  funext x
  simp [actualFixedPhaseNamedCuspTraceRepresentative,
    InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction]

/-- Largest submodule of the actual fixed-phase smooth core for which all
three concrete Slobodeckij energies are finite.  This is a property-defined
submodule, not a certificate field: membership unfolds to the three literal
`MemLp` statements. -/
noncomputable def actualFixedPhaseHhalfFiniteEnergyCore
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (InverseEtaFixedPhaseCore n) where
  carrier := {u |
    ∀ kappa : GammaTwoCusp,
      MemLp
        (widthTwoTwistedDifferenceQuotient
          (actualFixedPhaseCuspBoundaryTransition n kappa Y)
          (actualFixedPhaseNamedCuspTraceRepresentative
            n kappa Y u))
        2 actualFixedPhaseWidthTwoProductMeasure}
  zero_mem' := by
    intro kappa
    rw [actualFixedPhaseNamedCuspTraceRepresentative_zero,
      widthTwoTwistedDifferenceQuotient_zero]
    exact MemLp.zero
  add_mem' := by
    intro u v hu hv kappa
    rw [actualFixedPhaseNamedCuspTraceRepresentative_add,
      widthTwoTwistedDifferenceQuotient_add]
    exact (hu kappa).add (hv kappa)
  smul_mem' := by
    intro c u hu kappa
    rw [actualFixedPhaseNamedCuspTraceRepresentative_smul,
      widthTwoTwistedDifferenceQuotient_smul]
    exact (hu kappa).const_smul c

theorem mem_actualFixedPhaseHhalfFiniteEnergyCore_iff
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    u ∈ actualFixedPhaseHhalfFiniteEnergyCore n Y ↔
      ∀ kappa : GammaTwoCusp,
        MemLp
          (widthTwoTwistedDifferenceQuotient
            (actualFixedPhaseCuspBoundaryTransition n kappa Y)
            (actualFixedPhaseNamedCuspTraceRepresentative
              n kappa Y u))
          2 actualFixedPhaseWidthTwoProductMeasure := by
  rfl

/-- The finite-energy actual subcore is unconditionally inhabited by the zero
smooth section.  No unsupported nonzero or density assertion is made. -/
theorem actualFixedPhaseHhalfFiniteEnergyCore_nonempty
    (n : ℤ) (Y : ℝ) :
    (actualFixedPhaseHhalfFiniteEnergyCore n Y :
      Set (InverseEtaFixedPhaseCore n)).Nonempty :=
  ⟨0, (actualFixedPhaseHhalfFiniteEnergyCore n Y).zero_mem⟩

/-- In fact smoothness and the exact seam law prove that the maximal
finite-energy subcore is the entire actual fixed-phase smooth core. -/
theorem actualFixedPhaseHhalfFiniteEnergyCore_eq_top
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseHhalfFiniteEnergyCore n Y = ⊤ := by
  apply le_antisymm le_top
  intro u _hu kappa
  exact actualFixedPhaseNamedCuspDifferenceQuotient_memLp
    n kappa Y u

/-- Canonical linear lift of the whole actual smooth core into the
finite-energy subtype.  Its existence is theorem-derived from smoothness,
not a user-supplied trace certificate. -/
noncomputable def actualFixedPhaseCoreToHhalfFiniteEnergy
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      actualFixedPhaseHhalfFiniteEnergyCore n Y where
  toFun u :=
    ⟨u, fun kappa =>
      actualFixedPhaseNamedCuspDifferenceQuotient_memLp
        n kappa Y u⟩
  map_add' u v := by
    apply Subtype.ext
    rfl
  map_smul' c u := by
    apply Subtype.ext
    rfl

@[simp]
theorem actualFixedPhaseCoreToHhalfFiniteEnergy_coe
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseCoreToHhalfFiniteEnergy n Y u :
      InverseEtaFixedPhaseCore n) = u := by
  rfl

/-- A finite-energy actual trace, viewed as an element of the abstract
one-cusp Slobodeckij domain. -/
noncomputable def actualFixedPhaseNamedCuspTraceToHhalfDomain
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    actualFixedPhaseHhalfFiniteEnergyCore n Y →ₗ[ℂ]
      widthTwoHhalfDomain
        (actualFixedPhaseCuspBoundaryTransition n kappa Y) where
  toFun u :=
    ⟨actualFixedPhaseNamedCuspTraceToL2 n kappa Y u.1, by
      have hcoe :
          (actualFixedPhaseNamedCuspTraceToL2 n kappa Y u.1 :
              ℝ → ℂ) =ᵐ[actualFixedPhaseWidthTwoParameterMeasure]
            actualFixedPhaseNamedCuspTraceRepresentative
              n kappa Y u.1 :=
        (actualFixedPhaseNamedCuspTraceRepresentative_memLp
          n kappa Y u.1).coeFn_toLp
      have hquot :=
        widthTwoTwistedDifferenceQuotient_congr_ae
          (actualFixedPhaseCuspBoundaryTransition n kappa Y) hcoe
      exact (memLp_congr_ae hquot).2 (u.2 kappa)⟩
  map_add' u v := by
    apply Subtype.ext
    exact (actualFixedPhaseNamedCuspTraceToL2Linear
      n kappa Y).map_add u.1 v.1
  map_smul' c u := by
    apply Subtype.ext
    exact (actualFixedPhaseNamedCuspTraceToL2Linear
      n kappa Y).map_smul c u.1

/-- Actual finite-energy smooth trace into the completed named-cusp
`H^(1/2)` target. -/
noncomputable def actualFixedPhaseNamedCuspTraceToHhalf
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    actualFixedPhaseHhalfFiniteEnergyCore n Y →ₗ[ℂ]
      ActualFixedPhaseNamedCuspBoundaryHhalf n kappa Y :=
  (widthTwoHhalfCoreMap
      (actualFixedPhaseCuspBoundaryTransition n kappa Y)).comp
    (actualFixedPhaseNamedCuspTraceToHhalfDomain n kappa Y)

/-- The genuine named-cusp `H^(1/2)` trace on the entire actual smooth core. -/
noncomputable def actualFixedPhaseNamedCuspTraceToHhalfFull
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseNamedCuspBoundaryHhalf n kappa Y :=
  (actualFixedPhaseNamedCuspTraceToHhalf n kappa Y).comp
    (actualFixedPhaseCoreToHhalfFiniteEnergy n Y)

@[simp]
theorem actualFixedPhaseNamedCuspHhalfToL2_trace_full
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    widthTwoHhalfToL2
        (actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (actualFixedPhaseNamedCuspTraceToHhalfFull n kappa Y u) =
      actualFixedPhaseNamedCuspTraceToL2 n kappa Y u := by
  rfl

@[simp]
theorem actualFixedPhaseNamedCuspHhalfToL2_trace
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : actualFixedPhaseHhalfFiniteEnergyCore n Y) :
    widthTwoHhalfToL2
        (actualFixedPhaseCuspBoundaryTransition n kappa Y)
        (actualFixedPhaseNamedCuspTraceToHhalf n kappa Y u) =
      actualFixedPhaseNamedCuspTraceToL2 n kappa Y u.1 := by
  rfl

/-! ## 8. Componentwise maps on the concrete three-cusp target -/

/-- The two finite-energy actual traces at zero and one, assembled with the
Hilbert product norm. -/
noncomputable def actualFixedPhaseZeroOneCuspTraceToHhalf
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseHhalfFiniteEnergyCore n Y →ₗ[ℂ]
      WithLp 2
        (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
          ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y) :=
  (WithLp.linearEquiv 2 ℂ
      (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
        ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y)).symm.toLinearMap.comp
    ((actualFixedPhaseNamedCuspTraceToHhalf n .zero Y).prod
      (actualFixedPhaseNamedCuspTraceToHhalf n .one Y))

/-- Simultaneous actual finite-energy trace into the genuine three-cusp
`H^(1/2)` target. -/
noncomputable def actualFixedPhaseThreeCuspTraceToHhalf
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseHhalfFiniteEnergyCore n Y →ₗ[ℂ]
      ActualFixedPhaseThreeCuspBoundaryHhalf n Y :=
  (WithLp.linearEquiv 2 ℂ
      (ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y ×
        WithLp 2
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
            ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y))).symm.toLinearMap.comp
    ((actualFixedPhaseNamedCuspTraceToHhalf n .atInfinity Y).prod
      (actualFixedPhaseZeroOneCuspTraceToHhalf n Y))

/-- Simultaneous genuine three-cusp fractional trace on the entire actual
smooth fixed-phase core. -/
noncomputable def actualFixedPhaseThreeCuspTraceToHhalfFull
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseThreeCuspBoundaryHhalf n Y :=
  (actualFixedPhaseThreeCuspTraceToHhalf n Y).comp
    (actualFixedPhaseCoreToHhalfFiniteEnergy n Y)

/-! ## 8.1. The genuine `H^(1/2)`-enhanced bulk graph -/

/-- Hilbert ambient combining the pre-existing bulk graph completion with
the genuine three-cusp fractional boundary target. -/
abbrev ActualFixedPhaseHhalfTraceAmbient (n : ℤ) (Y : ℝ) :=
  WithLp 2
    (GraphSobolevCompletion n ×
      ActualFixedPhaseThreeCuspBoundaryHhalf n Y)

/-- Smooth-core graph carrying both the old bulk coordinates and the actual
fractional boundary trace. -/
noncomputable def actualFixedPhaseHhalfTraceGraphMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseHhalfTraceAmbient n Y :=
  (WithLp.linearEquiv 2 ℂ
      (GraphSobolevCompletion n ×
        ActualFixedPhaseThreeCuspBoundaryHhalf n Y)).symm.toLinearMap.comp
    ((coreMap n).prod
      (actualFixedPhaseThreeCuspTraceToHhalfFull n Y))

@[simp]
theorem actualFixedPhaseHhalfTraceGraphMap_fst
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseHhalfTraceGraphMap n Y u).fst =
      coreMap n u := by
  rfl

@[simp]
theorem actualFixedPhaseHhalfTraceGraphMap_snd
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseHhalfTraceGraphMap n Y u).snd =
      actualFixedPhaseThreeCuspTraceToHhalfFull n Y u := by
  rfl

theorem actualFixedPhaseHhalfTraceGraphMap_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseHhalfTraceGraphMap n Y) := by
  intro u v huv
  apply coreMap_injective n
  simpa using congrArg WithLp.fst huv

/-- Algebraic smooth `bulk x H^(1/2)` graph. -/
noncomputable def actualFixedPhaseHhalfTraceGraphRange
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseHhalfTraceAmbient n Y) :=
  LinearMap.range (actualFixedPhaseHhalfTraceGraphMap n Y)

/-- Genuine fractional-trace-enhanced completion. -/
abbrev ActualFixedPhaseHhalfTraceCompletion
    (n : ℤ) (Y : ℝ) :=
  (actualFixedPhaseHhalfTraceGraphRange n Y).topologicalClosure

theorem actualFixedPhaseHhalfTraceGraphRange_le_completion
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseHhalfTraceGraphRange n Y ≤
      (actualFixedPhaseHhalfTraceGraphRange n Y).topologicalClosure :=
  Submodule.le_topologicalClosure
    (actualFixedPhaseHhalfTraceGraphRange n Y)

theorem actualFixedPhaseHhalfTraceCompletion_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      ((ActualFixedPhaseHhalfTraceCompletion n Y :
        Submodule ℂ (ActualFixedPhaseHhalfTraceAmbient n Y)) :
        Set (ActualFixedPhaseHhalfTraceAmbient n Y)) :=
  Submodule.isClosed_topologicalClosure
    (actualFixedPhaseHhalfTraceGraphRange n Y)

noncomputable def actualFixedPhaseHhalfTraceRangeMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      actualFixedPhaseHhalfTraceGraphRange n Y :=
  (actualFixedPhaseHhalfTraceGraphMap n Y).rangeRestrict

theorem actualFixedPhaseHhalfTraceRangeMap_surjective
    (n : ℤ) (Y : ℝ) :
    Function.Surjective (actualFixedPhaseHhalfTraceRangeMap n Y) := by
  rintro ⟨x, u, rfl⟩
  exact ⟨u, rfl⟩

noncomputable def actualFixedPhaseHhalfTraceRangeInclusion
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseHhalfTraceGraphRange n Y →ₗᵢ[ℂ]
      ActualFixedPhaseHhalfTraceCompletion n Y where
  toFun f :=
    ⟨(f : ActualFixedPhaseHhalfTraceAmbient n Y),
      actualFixedPhaseHhalfTraceGraphRange_le_completion
        n Y f.property⟩
  map_add' f g := by rfl
  map_smul' c f := by rfl
  norm_map' f := by rfl

theorem actualFixedPhaseHhalfTraceRangeInclusion_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseHhalfTraceRangeInclusion n Y) := by
  change Dense
    (Set.range
      (fun f : actualFixedPhaseHhalfTraceGraphRange n Y =>
        actualFixedPhaseHhalfTraceRangeInclusion n Y f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : ActualFixedPhaseHhalfTraceAmbient n Y) ∈
      closure
        (Subtype.val ''
          Set.range
            (fun f : actualFixedPhaseHhalfTraceGraphRange n Y =>
              actualFixedPhaseHhalfTraceRangeInclusion n Y f))
  have hImage :
      Subtype.val ''
          Set.range
            (fun f : actualFixedPhaseHhalfTraceGraphRange n Y =>
              actualFixedPhaseHhalfTraceRangeInclusion n Y f) =
        ((actualFixedPhaseHhalfTraceGraphRange n Y :
          Submodule ℂ (ActualFixedPhaseHhalfTraceAmbient n Y)) :
          Set (ActualFixedPhaseHhalfTraceAmbient n Y)) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : actualFixedPhaseHhalfTraceGraphRange n Y := ⟨z, hz⟩
      exact
        ⟨actualFixedPhaseHhalfTraceRangeInclusion n Y f,
          ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- Dense map of the original actual smooth core into the genuine
fractional-trace-enhanced completion. -/
noncomputable def actualFixedPhaseHhalfTraceCoreMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseHhalfTraceCompletion n Y :=
  (actualFixedPhaseHhalfTraceRangeInclusion n Y).toLinearMap.comp
    (actualFixedPhaseHhalfTraceRangeMap n Y)

theorem actualFixedPhaseHhalfTraceCoreMap_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseHhalfTraceCoreMap n Y) := by
  have hs : DenseRange (actualFixedPhaseHhalfTraceRangeMap n Y) :=
    (actualFixedPhaseHhalfTraceRangeMap_surjective n Y).denseRange
  have hc :=
    (actualFixedPhaseHhalfTraceRangeInclusion_denseRange n Y).comp
      hs (actualFixedPhaseHhalfTraceRangeInclusion n Y).continuous
  simpa [actualFixedPhaseHhalfTraceCoreMap, Function.comp_def] using hc

/-- Bounded projection to the pre-existing bulk graph completion. -/
noncomputable def actualFixedPhaseHhalfTraceBulkProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseHhalfTraceCompletion n Y →L[ℂ]
      GraphSobolevCompletion n :=
  (WithLp.fstL 2 ℂ
      (GraphSobolevCompletion n)
      (ActualFixedPhaseThreeCuspBoundaryHhalf n Y)).comp
    (Submodule.subtypeL
      ((actualFixedPhaseHhalfTraceGraphRange n Y).topologicalClosure))

/-- Bounded projection to the genuine three-cusp `H^(1/2)` target. -/
noncomputable def actualFixedPhaseHhalfTraceBoundaryProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseHhalfTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryHhalf n Y :=
  (WithLp.sndL 2 ℂ
      (GraphSobolevCompletion n)
      (ActualFixedPhaseThreeCuspBoundaryHhalf n Y)).comp
    (Submodule.subtypeL
      ((actualFixedPhaseHhalfTraceGraphRange n Y).topologicalClosure))

@[simp]
theorem actualFixedPhaseHhalfTraceBulkProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseHhalfTraceBulkProjection n Y
        (actualFixedPhaseHhalfTraceCoreMap n Y u) =
      coreMap n u := by
  rfl

@[simp]
theorem actualFixedPhaseHhalfTraceBoundaryProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseHhalfTraceBoundaryProjection n Y
        (actualFixedPhaseHhalfTraceCoreMap n Y u) =
      actualFixedPhaseThreeCuspTraceToHhalfFull n Y u := by
  rfl

theorem actualFixedPhaseHhalfTraceCoreMap_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseHhalfTraceCoreMap n Y) := by
  intro u v huv
  apply coreMap_injective n
  have hbulk := congrArg
    (actualFixedPhaseHhalfTraceBulkProjection n Y) huv
  simpa using hbulk

theorem actualFixedPhaseHhalfTraceBoundaryProjection_norm_le
    (n : ℤ) (Y : ℝ)
    (u : ActualFixedPhaseHhalfTraceCompletion n Y) :
    ‖actualFixedPhaseHhalfTraceBoundaryProjection n Y u‖ ≤ ‖u‖ := by
  change
    ‖(u : ActualFixedPhaseHhalfTraceAmbient n Y).snd‖ ≤
      ‖(u : ActualFixedPhaseHhalfTraceAmbient n Y)‖
  exact WithLp.norm_snd_le (GraphSobolevCompletion n)
    (u : ActualFixedPhaseHhalfTraceAmbient n Y)

/-- Closed zero-`H^(1/2)` trace subspace of the enhanced completion. -/
noncomputable def actualFixedPhaseHhalfTraceZeroBoundarySubspace
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseHhalfTraceCompletion n Y) :=
  (actualFixedPhaseHhalfTraceBoundaryProjection n Y).ker

theorem actualFixedPhaseHhalfTraceZeroBoundarySubspace_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      ((actualFixedPhaseHhalfTraceZeroBoundarySubspace n Y :
        Submodule ℂ (ActualFixedPhaseHhalfTraceCompletion n Y)) :
        Set (ActualFixedPhaseHhalfTraceCompletion n Y)) :=
  (actualFixedPhaseHhalfTraceBoundaryProjection n Y).isClosed_ker

noncomputable def actualFixedPhaseHhalfTraceCompletionCompleteSpace
    (n : ℤ) (Y : ℝ) :
    CompleteSpace (ActualFixedPhaseHhalfTraceCompletion n Y) :=
  inferInstance

noncomputable def actualFixedPhaseHhalfTraceCompletionInnerProductSpace
    (n : ℤ) (Y : ℝ) :
    InnerProductSpace ℂ (ActualFixedPhaseHhalfTraceCompletion n Y) := by
  letI : InnerProductSpace ℂ
      (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y) :=
    widthTwoHhalfCompletionInnerProductSpace
      (actualFixedPhaseCuspBoundaryTransition n .zero Y)
  letI : InnerProductSpace ℂ
      (ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y) :=
    widthTwoHhalfCompletionInnerProductSpace
      (actualFixedPhaseCuspBoundaryTransition n .one Y)
  letI : InnerProductSpace ℂ
      (WithLp 2
        (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
          ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y)) := inferInstance
  letI : InnerProductSpace ℂ
      (ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y) :=
    widthTwoHhalfCompletionInnerProductSpace
      (actualFixedPhaseCuspBoundaryTransition n .atInfinity Y)
  letI : InnerProductSpace ℂ
      (ActualFixedPhaseThreeCuspBoundaryHhalf n Y) := inferInstance
  letI : InnerProductSpace ℂ (GraphSobolevCompletion n) := inferInstance
  letI : InnerProductSpace ℂ (ActualFixedPhaseHhalfTraceAmbient n Y) := inferInstance
  exact (ActualFixedPhaseHhalfTraceCompletion n Y).innerProductSpace

@[simp]
theorem actualFixedPhaseThreeCuspTraceToHhalf_atInfinity
    (n : ℤ) (Y : ℝ)
    (u : actualFixedPhaseHhalfFiniteEnergyCore n Y) :
    (actualFixedPhaseThreeCuspTraceToHhalf n Y u).fst =
      actualFixedPhaseNamedCuspTraceToHhalf n .atInfinity Y u := by
  rfl

@[simp]
theorem actualFixedPhaseThreeCuspTraceToHhalf_zero
    (n : ℤ) (Y : ℝ)
    (u : actualFixedPhaseHhalfFiniteEnergyCore n Y) :
    (actualFixedPhaseThreeCuspTraceToHhalf n Y u).snd.fst =
      actualFixedPhaseNamedCuspTraceToHhalf n .zero Y u := by
  rfl

@[simp]
theorem actualFixedPhaseThreeCuspTraceToHhalf_one
    (n : ℤ) (Y : ℝ)
    (u : actualFixedPhaseHhalfFiniteEnergyCore n Y) :
    (actualFixedPhaseThreeCuspTraceToHhalf n Y u).snd.snd =
      actualFixedPhaseNamedCuspTraceToHhalf n .one Y u := by
  rfl

/-- Componentwise forgetful map from the actual fractional infinity-cusp
target to the stored parameter `L2`. -/
noncomputable def actualFixedPhaseInfinityHhalfToL2
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  widthTwoHhalfToL2
    (actualFixedPhaseCuspBoundaryTransition n .atInfinity Y)

/-- Componentwise forgetful map at the zero cusp. -/
noncomputable def actualFixedPhaseZeroHhalfToL2
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  widthTwoHhalfToL2
    (actualFixedPhaseCuspBoundaryTransition n .zero Y)

/-- Componentwise forgetful map at the one cusp. -/
noncomputable def actualFixedPhaseOneHhalfToL2
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  widthTwoHhalfToL2
    (actualFixedPhaseCuspBoundaryTransition n .one Y)

/-!
The three-product continuous map is intentionally assembled from the genuine
component maps below; it is not an identity cast between the `H^(1/2)` and
stored `L2` types.
-/

noncomputable def actualFixedPhaseZeroOneHhalfToL2
    (n : ℤ) (Y : ℝ) :
    WithLp 2
        (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
          ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y) →L[ℂ]
      WithLp 2
        (ActualFixedPhaseWidthTwoL2 ×
          ActualFixedPhaseWidthTwoL2) :=
  (WithLp.prodContinuousLinearEquiv 2 ℂ
      ActualFixedPhaseWidthTwoL2
      ActualFixedPhaseWidthTwoL2).symm.toContinuousLinearMap.comp
    (((actualFixedPhaseZeroHhalfToL2 n Y).comp
        (WithLp.fstL 2 ℂ
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y)
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y))).prod
      ((actualFixedPhaseOneHhalfToL2 n Y).comp
        (WithLp.sndL 2 ℂ
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y)
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y))))

/-- Continuous contractive forgetful map from the genuine three-cusp fractional
graph completion to the already stored three-cusp `L2` target. -/
noncomputable def actualFixedPhaseThreeCuspHhalfToL2
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseThreeCuspBoundaryHhalf n Y →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2 :=
  (WithLp.prodContinuousLinearEquiv 2 ℂ
      ActualFixedPhaseWidthTwoL2
      (WithLp 2
        (ActualFixedPhaseWidthTwoL2 ×
          ActualFixedPhaseWidthTwoL2))).symm.toContinuousLinearMap.comp
    (((actualFixedPhaseInfinityHhalfToL2 n Y).comp
        (WithLp.fstL 2 ℂ
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y)
          (WithLp 2
            (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
              ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y)))).prod
      ((actualFixedPhaseZeroOneHhalfToL2 n Y).comp
        (WithLp.sndL 2 ℂ
          (ActualFixedPhaseNamedCuspBoundaryHhalf n .atInfinity Y)
          (WithLp 2
            (ActualFixedPhaseNamedCuspBoundaryHhalf n .zero Y ×
              ActualFixedPhaseNamedCuspBoundaryHhalf n .one Y)))))

/-- On the actual finite-energy smooth subcore, forgetting the genuine
fractional coordinate recovers exactly the previously stored three-cusp `L2`
trace. -/
@[simp]
theorem actualFixedPhaseThreeCuspHhalfToL2_trace
    (n : ℤ) (Y : ℝ)
    (u : actualFixedPhaseHhalfFiniteEnergyCore n Y) :
    actualFixedPhaseThreeCuspHhalfToL2 n Y
        (actualFixedPhaseThreeCuspTraceToHhalf n Y u) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u.1 := by
  rfl

/-- On the full actual smooth core, the genuine fractional trace still
forgets to exactly the previously certified stored `L2` trace. -/
@[simp]
theorem actualFixedPhaseThreeCuspHhalfToL2_trace_full
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseThreeCuspHhalfToL2 n Y
        (actualFixedPhaseThreeCuspTraceToHhalfFull n Y u) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u := by
  rfl

/-! ## 9. The exact unconditional certificate and the remaining theorem -/

/-- The constructed target is a closed Hilbert graph completion with a dense
finite-energy core and a contractive forgetful map to stored `L2`. -/
theorem widthTwoHhalfConstructionCertificate (tau : ℝ → ℂ) :
    Function.Injective (widthTwoHhalfCoreMap tau) ∧
      DenseRange (widthTwoHhalfCoreMap tau) ∧
      IsClosed
        ((WidthTwoHhalfCompletion tau :
          Submodule ℂ WidthTwoHhalfGraphAmbient) :
          Set WidthTwoHhalfGraphAmbient) ∧
      ∀ f : WidthTwoHhalfCompletion tau,
        ‖widthTwoHhalfToL2 tau f‖ ≤ ‖f‖ := by
  exact ⟨widthTwoHhalfCoreMap_injective tau,
    widthTwoHhalfCoreMap_denseRange tau,
    widthTwoHhalfCompletion_isClosed tau,
    widthTwoHhalfToL2_norm_le tau⟩

/-- Concrete three-cusp fractional-target certificate: all three seam
transitions are nonzero and every actual smooth core trace obeys their exact
width-two covariance. -/
theorem actualFixedPhaseThreeCuspHhalfTransitionCertificate
    (n : ℤ) (Y : ℝ) :
    (∀ kappa x,
      actualFixedPhaseCuspBoundaryTransition n kappa Y x ≠ 0) ∧
    (∀ (kappa : GammaTwoCusp)
        (u : InverseEtaFixedPhaseCore n) (x : ℝ),
      actualFixedPhaseNamedCuspTraceRepresentative
          n kappa Y u (x + 2) =
        actualFixedPhaseCuspBoundaryTransition n kappa Y x *
          actualFixedPhaseNamedCuspTraceRepresentative
            n kappa Y u x) := by
  exact
    ⟨fun kappa x =>
      actualFixedPhaseCuspBoundaryTransition_ne_zero n kappa Y x,
    fun kappa u x =>
      actualFixedPhaseNamedCuspTraceRepresentative_add_two
        n kappa Y u x⟩

/-- Unconditional endpoint of the genuine fractional-trace-enhanced graph:
the original smooth core is dense and faithful, the completion and zero-trace
kernel are closed, and the `H^(1/2)` projection is contractive. -/
theorem actualFixedPhaseHhalfTraceGraphCertificate
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseHhalfTraceCoreMap n Y) ∧
      DenseRange (actualFixedPhaseHhalfTraceCoreMap n Y) ∧
      IsClosed
        ((ActualFixedPhaseHhalfTraceCompletion n Y :
          Submodule ℂ (ActualFixedPhaseHhalfTraceAmbient n Y)) :
          Set (ActualFixedPhaseHhalfTraceAmbient n Y)) ∧
      IsClosed
        ((actualFixedPhaseHhalfTraceZeroBoundarySubspace n Y :
          Submodule ℂ (ActualFixedPhaseHhalfTraceCompletion n Y)) :
          Set (ActualFixedPhaseHhalfTraceCompletion n Y)) ∧
      ∀ u : ActualFixedPhaseHhalfTraceCompletion n Y,
        ‖actualFixedPhaseHhalfTraceBoundaryProjection n Y u‖ ≤ ‖u‖ := by
  exact ⟨actualFixedPhaseHhalfTraceCoreMap_injective n Y,
    actualFixedPhaseHhalfTraceCoreMap_denseRange n Y,
    actualFixedPhaseHhalfTraceCompletion_isClosed n Y,
    actualFixedPhaseHhalfTraceZeroBoundarySubspace_isClosed n Y,
    actualFixedPhaseHhalfTraceBoundaryProjection_norm_le n Y⟩

/-! ## 10. Exact comparison boundary with the old bulk completion -/

/-- Canonical dense extension candidate for the genuine fractional trace.
As with `LinearMap.extendOfNorm` itself, its core-value theorem is stated only
after the concrete norm estimate has been proved. -/
noncomputable def actualFixedPhaseHhalfTraceExtension
    (n : ℤ) (Y : ℝ) :
    GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryHhalf n Y := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  exact (actualFixedPhaseThreeCuspTraceToHhalfFull n Y).extendOfNorm (coreMap n)

theorem actualFixedPhaseHhalfTraceExtension_core
    (n : ℤ) (Y : ℝ)
    (hBound : ∃ C : ℝ,
      ∀ u : InverseEtaFixedPhaseCore n,
        ‖actualFixedPhaseThreeCuspTraceToHhalfFull n Y u‖ ≤
          C * ‖coreMap n u‖)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseHhalfTraceExtension n Y (coreMap n u) =
      actualFixedPhaseThreeCuspTraceToHhalfFull n Y u := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  rcases hBound with ⟨C, hC⟩
  exact LinearMap.extendOfNorm_eq
    (denseRange_coreMap n) ⟨C, hC⟩ u

/-- Unconditional exact reduction: a classical bounded trace on the old bulk
completion exists precisely when the concrete smooth-core `H^(1/2)` estimate
holds.  The theorem does not provide either side as an input field. -/
theorem actualFixedPhaseHhalfTraceBound_iff_exists_extension
    (n : ℤ) (Y : ℝ) :
    (∃ C : ℝ,
      ∀ u : InverseEtaFixedPhaseCore n,
        ‖actualFixedPhaseThreeCuspTraceToHhalfFull n Y u‖ ≤
          C * ‖coreMap n u‖) ↔
      ∃ T : GraphSobolevCompletion n →L[ℂ]
          ActualFixedPhaseThreeCuspBoundaryHhalf n Y,
        ∀ u : InverseEtaFixedPhaseCore n,
          T (coreMap n u) =
            actualFixedPhaseThreeCuspTraceToHhalfFull n Y u := by
  constructor
  · intro hBound
    exact ⟨actualFixedPhaseHhalfTraceExtension n Y,
      actualFixedPhaseHhalfTraceExtension_core n Y hBound⟩
  · rintro ⟨T, hT⟩
    refine ⟨‖T‖, fun u => ?_⟩
    rw [← hT u]
    exact T.le_opNorm (coreMap n u)

/-!
## Exact remaining analytic statement

The target now exists, but the classical trace theorem is not yet proved.
The next theorem must be derived from the concrete bulk derivatives and the
polygon/collar geometry, not supplied as a field:

```
exists T : GraphSobolevCompletion n ->L[C]
    ActualFixedPhaseThreeCuspBoundaryHhalf n Y,
  forall u,
    actualFixedPhaseThreeCuspHhalfToL2 n Y (T (coreMap n u)) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u
```

Moreover, a classical extension/right-inverse theorem must construct

```
E : ActualFixedPhaseThreeCuspBoundaryHhalf n Y ->L[C]
      GraphSobolevCompletion n
```

with `T.comp E = ContinuousLinearMap.id C _`.  Neither statement follows from
the graph closure above: their proof needs a collar extension and an estimate
in the *pre-existing* bulk graph norm.  This file leaves those statements as
documented proof obligations rather than Lean hypotheses.
-/

end QYM.FullCertification.P2ClassicalHhalfTraceExtension

