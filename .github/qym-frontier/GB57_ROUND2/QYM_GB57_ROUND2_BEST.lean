open Function Set Topology
open scoped MatrixGroups UpperHalfPlane

namespace QYM.FullCertification.P2CuspCollarClosureExtension












open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# A genuine thick cusp collar for the effective `Gamma(2)` quotient

This file closes `P2SmoothQuotientAtlasExtension.CuspCollarResidual` without
adding a premise.  The construction uses the whole high cusp `im > 1`, not
only the boundary horocycle.

The proof has four independent layers.

1. `horizontalHighPoint` identifies `ℝ × (1,∞)` with the open high strip in
   the upper half-plane.
2. Conjugating by the selected cusp representative and projecting to the
   effective quotient gives an open map, periodic with period two.
3. The descended map `AddCircle 2 × (1,∞) → GammaTwoQuotient` is injective.
   If an orbit bridge has nonzero lower-left entry, the modular height formula
   sends a point of height greater than one below height one, contradicting
   the height of the target.  Hence the bridge is upper triangular; its
   `Gamma(2)` congruence forces an even translation.
4. Restricting this open embedding to the fixed band of radius `1/2` around a
   level at least two gives the required open partial homeomorphism.

All arithmetic and topological claims are exposed as small lemmas so that the
collar can be reused later for boundary charts and Green identities.
-/

/-! ## 1. The open high strip upstairs -/

/-- Heights on which the parabolic subgroup is the only possible
`Gamma(2)` self-identification. -/
abbrev HighHeight := Set.Ioi (1 : ℝ)

local instance widthTwoPositive : Fact (0 < (2 : ℝ)) :=
  ⟨by norm_num⟩

/-- The standard point `t + i h` with `h > 1`. -/
def horizontalHighPoint (p : ℝ × HighHeight) : ℍ :=
  ⟨(p.1 : ℂ) + (p.2.1 : ℂ) * Complex.I,
    by
      simpa using (lt_trans zero_lt_one p.2.2)⟩

@[simp]
theorem horizontalHighPoint_re (p : ℝ × HighHeight) :
    (horizontalHighPoint p).re = p.1 := by
  simp [horizontalHighPoint]

@[simp]
theorem horizontalHighPoint_im (p : ℝ × HighHeight) :
    (horizontalHighPoint p).im = p.2.1 := by
  simp [horizontalHighPoint]

/-- The explicit high-strip parametrization is an open embedding. -/
theorem horizontalHighPoint_isOpenEmbedding :
    IsOpenEmbedding horizontalHighPoint := by
  have hProd : IsOpenEmbedding
      (Prod.map (id : ℝ → ℝ) ((↑) : HighHeight → ℝ)) :=
    IsOpenEmbedding.id.prodMap isOpen_Ioi.isOpenEmbedding_subtypeVal
  have hComplex : IsOpenEmbedding
      (fun p : ℝ × HighHeight =>
        Complex.equivRealProdCLM.symm (p.1, p.2.1)) := by
    change IsOpenEmbedding
      (Complex.equivRealProdCLM.symm.toHomeomorph ∘
        Prod.map (id : ℝ → ℝ) ((↑) : HighHeight → ℝ))
    exact
      Complex.equivRealProdCLM.symm.toHomeomorph.isOpenEmbedding.comp hProd
  apply IsOpenEmbedding.of_comp horizontalHighPoint
    UpperHalfPlane.isOpenEmbedding_coe
  simpa only [Function.comp_def, horizontalHighPoint,
    Complex.equivRealProdCLM_symm_apply] using hComplex

/-- At a high parameter, Mathlib's normalized cusp height is the parameter
itself. -/
theorem gammaTwoCuspLevel_eq_highHeight (h : HighHeight) :
    gammaTwoCuspLevel h.1 = h.1 :=
  gammaTwoCuspLevel_of_one_le (le_of_lt h.2)

/-- The new two-variable point agrees with the already certified fixed-phase
point when its cutoff parameter is the high height. -/
theorem horizontalHighPoint_eq_actualFixedPhase
    (t : ℝ) (h : HighHeight) :
    horizontalHighPoint (t, h) =
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint h.1 t := by
  apply UpperHalfPlane.ext_re_im
  · simp
  · rw [horizontalHighPoint_im,
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_im,
      gammaTwoCuspLevel_eq_highHeight]

/-! ## 2. Projection of the selected high cusp -/

/-- Conjugate the standard high strip into the selected cusp. -/
def selectedHighPoint
    (q : GammaTwoRightCoset) (p : ℝ × HighHeight) : ℍ :=
  gammaTwoCosetRep q • horizontalHighPoint p

/-- Conjugation preserves the open-embedding property. -/
theorem selectedHighPoint_isOpenEmbedding (q : GammaTwoRightCoset) :
    IsOpenEmbedding (selectedHighPoint q) := by
  change IsOpenEmbedding
    ((Homeomorph.smul
        (gammaTwoCosetRep q : GL (Fin 2) ℝ) : ℍ ≃ₜ ℍ) ∘
      horizontalHighPoint)
  exact
    (Homeomorph.smul
        (gammaTwoCosetRep q : GL (Fin 2) ℝ) : ℍ ≃ₜ ℍ).isOpenEmbedding.comp
      horizontalHighPoint_isOpenEmbedding

/-- The selected high point is the old selected horocycle point at cutoff
equal to its height. -/
theorem selectedHighPoint_eq_selectedHorocycleParam
    (q : GammaTwoRightCoset) (t : ℝ) (h : HighHeight) :
    selectedHighPoint q (t, h) =
      gammaTwoSelectedHorocycleParam q h.1 t := by
  rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal,
    ← horizontalHighPoint_eq_actualFixedPhase]
  rfl

/-- Project the selected high strip to the effective quotient. -/
def rawHighCuspMap
    (q : GammaTwoRightCoset) (p : ℝ × HighHeight) :
    GammaTwoQuotient :=
  gammaTwoQuotientMk (selectedHighPoint q p)

theorem rawHighCuspMap_continuous (q : GammaTwoRightCoset) :
    Continuous (rawHighCuspMap q) := by
  exact gammaTwoQuotientMk_isOpenQuotientMap.continuous.comp
    (selectedHighPoint_isOpenEmbedding q).continuous

/-- Before dividing by the period, the selected high-strip projection is an
open map. -/
theorem rawHighCuspMap_isOpenMap (q : GammaTwoRightCoset) :
    IsOpenMap (rawHighCuspMap q) := by
  exact gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap.comp
    (selectedHighPoint_isOpenEmbedding q).isOpenMap

/-- The selected cusp projection is two-periodic in the real coordinate at
every height greater than one. -/
theorem rawHighCuspMap_periodic
    (q : GammaTwoRightCoset) (h : HighHeight) :
    Function.Periodic (fun t : ℝ => rawHighCuspMap q (t, h)) 2 := by
  intro t
  unfold rawHighCuspMap
  change gammaTwoQuotientMk (selectedHighPoint q (t + 2, h)) =
    gammaTwoQuotientMk (selectedHighPoint q (t, h))
  rw [selectedHighPoint_eq_selectedHorocycleParam,
    selectedHighPoint_eq_selectedHorocycleParam,
    ← QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedWidthTwoTranslation_smul q h.1 t]
  exact gammaTwoQuotientMk_gamma_smul
    (QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedWidthTwoTranslation q)
    (gammaTwoSelectedHorocycleParam q h.1 t)

/-! ## 3. Descent to the width-two cylinder -/

/-- The full high cusp cylinder in the effective quotient. -/
noncomputable def cuspCylinderMap
    (q : GammaTwoRightCoset) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × HighHeight → GammaTwoQuotient :=
  fun p => (rawHighCuspMap_periodic q p.2).lift p.1

@[simp]
theorem cuspCylinderMap_coe
    (q : GammaTwoRightCoset) (t : ℝ) (h : HighHeight) :
    cuspCylinderMap q ((t : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle), h) =
      rawHighCuspMap q (t, h) := by
  exact Function.Periodic.lift_coe
    (rawHighCuspMap_periodic q h) t

/-- The product quotient map used to test continuity and openness of the
descended cylinder. -/
def cylinderQuotientMap :
    ℝ × HighHeight → QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × HighHeight :=
  Prod.map
    (QuotientAddGroup.mk' (AddSubgroup.zmultiples (2 : ℝ))) id

theorem cylinderQuotientMap_isOpenQuotientMap :
    IsOpenQuotientMap cylinderQuotientMap := by
  change IsOpenQuotientMap
    (Prod.map
      (QuotientAddGroup.mk' (AddSubgroup.zmultiples (2 : ℝ)))
      (id : HighHeight → HighHeight))
  exact QuotientAddGroup.isOpenQuotientMap_mk.prodMap
    IsOpenQuotientMap.id

theorem cylinderQuotientMap_surjective :
    Function.Surjective cylinderQuotientMap :=
  cylinderQuotientMap_isOpenQuotientMap.surjective

/-- Pullback along the product quotient map recovers the raw cusp map. -/
theorem cuspCylinderMap_comp_cylinderQuotientMap
    (q : GammaTwoRightCoset) :
    cuspCylinderMap q ∘ cylinderQuotientMap = rawHighCuspMap q := by
  funext p
  exact cuspCylinderMap_coe q p.1 p.2

/-- Continuity descends jointly in the circle and height coordinates. -/
theorem cuspCylinderMap_continuous (q : GammaTwoRightCoset) :
    Continuous (cuspCylinderMap q) := by
  rw [← cylinderQuotientMap_isOpenQuotientMap.continuous_comp_iff]
  rw [cuspCylinderMap_comp_cylinderQuotientMap]
  exact rawHighCuspMap_continuous q

/-! ## 4. Uniform high-cusp orbit separation -/

/-- An orbit bridge between two selected high points, transported into the
standard cusp coordinate. -/
def standardCuspBridge
    (q : GammaTwoRightCoset) (gamma : GammaTwo) : SL(2, ℤ) :=
  (gammaTwoCosetRep q)⁻¹ * (gamma : SL(2, ℤ)) *
    gammaTwoCosetRep q

/-- The transported bridge is again in the principal congruence subgroup. -/
theorem standardCuspBridge_mem_Gamma
    (q : GammaTwoRightCoset) (gamma : GammaTwo) :
    standardCuspBridge q gamma ∈ CongruenceSubgroup.Gamma 2 := by
  simpa only [standardCuspBridge, inv_inv] using
    (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (gamma : SL(2, ℤ)) gamma.property
      (gammaTwoCosetRep q)⁻¹

/-- A bridge between two points of height greater than one cannot have a
nonzero lower-left entry.  This is the uniform orbit-separation estimate that
was absent from the zero-thickness circle construction. -/
theorem standardCuspBridge_lowerLeft_eq_zero
    (bridge : SL(2, ℤ)) (source target : ℍ)
    (hsource : 1 < source.im) (htarget : 1 < target.im)
    (hmove : bridge • source = target) :
    bridge 1 0 = 0 := by
  by_contra hc
  have hUpper : target.im ≤ 1 / source.im := by
    rw [← hmove]
    exact QYM.FullCertification.P2ConnectedCuspComponentsExtension.modular_im_smul_le_inv_im_of_lowerLeft_ne_zero
      bridge source hc
  have hInvLtOne : 1 / source.im < 1 := by
    rw [div_lt_iff₀ source.im_pos]
    simpa using hsource
  linarith

/-- An upper-triangular bridge preserves height, hence the two cylinder
heights agree. -/
theorem highBridge_preserves_height
    (bridge : SL(2, ℤ)) (source target : ℍ)
    (hlower : bridge 1 0 = 0)
    (hmove : bridge • source = target) :
    target.im = source.im := by
  rw [← hmove]
  exact QYM.FullCertification.P2ConnectedCuspComponentsExtension.modular_im_smul_eq_of_lowerLeft_eq_zero
    bridge source hlower

/-- The upper-right entry of a transported `Gamma(2)` bridge is even. -/
theorem standardCuspBridge_upperRight_even
    (q : GammaTwoRightCoset) (gamma : GammaTwo) :
    (2 : ℤ) ∣ standardCuspBridge q gamma 0 1 := by
  have hmod :
      (((standardCuspBridge q gamma) 0 1 : ℤ) : ZMod 2) = 0 :=
    (CongruenceSubgroup.Gamma_mem.mp
      (standardCuspBridge_mem_Gamma q gamma)).2.1
  exact
    (ZMod.intCast_zmod_eq_zero_iff_dvd
      (standardCuspBridge q gamma 0 1) 2).mp hmod

/-- The determinant of an upper-triangular special-linear bridge is the
product of its diagonal entries. -/
theorem upperTriangular_diagonal_product_eq_one
    (bridge : SL(2, ℤ)) (hlower : bridge 1 0 = 0) :
    bridge 0 0 * bridge 1 1 = 1 := by
  have h := bridge.det_coe
  rw [Matrix.det_fin_two, hlower, mul_zero, sub_zero] at h
  exact h

/-- In the positive-diagonal case, an upper-triangular bridge is a power of
the standard translation. -/
theorem upperTriangular_eq_T_zpow
    (bridge : SL(2, ℤ)) (hlower : bridge 1 0 = 0)
    (hdiag : bridge 0 0 = 1 ∧ bridge 1 1 = 1) :
    bridge = ModularGroup.T ^ (bridge 0 1) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [hdiag.1, hlower, hdiag.2,
      ModularGroup.coe_T_zpow,
      show (1 : Fin (0 + 2)) = (1 : Fin 2) from rfl]

/-- In the negative-diagonal case, the same Möbius action is represented by
the negative of the inverse translation power. -/
theorem upperTriangular_eq_neg_T_zpow
    (bridge : SL(2, ℤ)) (hlower : bridge 1 0 = 0)
    (hdiag : bridge 0 0 = -1 ∧ bridge 1 1 = -1) :
    bridge = -ModularGroup.T ^ (-(bridge 0 1)) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [hdiag.1, hlower, hdiag.2,
      ModularGroup.coe_T_zpow,
      show (1 : Fin (0 + 2)) = (1 : Fin 2) from rfl]

/-- The descended high cusp cylinder has no identifications beyond the
width-two parabolic period. -/
theorem cuspCylinderMap_injective (q : GammaTwoRightCoset) :
    Function.Injective (cuspCylinderMap q) := by
  rintro ⟨theta, h⟩ ⟨phi, k⟩ hEq
  induction theta using QuotientAddGroup.induction_on with
  | H s =>
      induction phi using QuotientAddGroup.induction_on with
      | H t =>
          have hRaw :
              rawHighCuspMap q (s, h) =
                rawHighCuspMap q (t, k) := by
            simpa only [cuspCylinderMap_coe] using hEq
          change gammaTwoQuotientMk (selectedHighPoint q (s, h)) =
            gammaTwoQuotientMk (selectedHighPoint q (t, k)) at hRaw
          have hOrbit :
              MulAction.orbitRel GammaTwoEffective ℍ
                (selectedHighPoint q (s, h))
                (selectedHighPoint q (t, k)) :=
            Quotient.eq''.mp hRaw
          rcases hOrbit with ⟨g, hg⟩
          rcases effective_exists_gamma g with ⟨gamma, hgamma⟩
          have hgammaMove :
              (gamma : SL(2, ℤ)) • selectedHighPoint q (t, k) =
                selectedHighPoint q (s, h) :=
            (hgamma (selectedHighPoint q (t, k))).symm.trans hg
          let baseT : ℍ := horizontalHighPoint (t, k)
          let baseS : ℍ := horizontalHighPoint (s, h)
          let bridge : SL(2, ℤ) := standardCuspBridge q gamma
          have hbridgeMove : bridge • baseT = baseS := by
            calc
              bridge • baseT =
                  (gammaTwoCosetRep q)⁻¹ •
                    ((gamma : SL(2, ℤ)) •
                      (gammaTwoCosetRep q • baseT)) := by
                        simp only [bridge, standardCuspBridge, mul_smul]
              _ = (gammaTwoCosetRep q)⁻¹ •
                    ((gamma : SL(2, ℤ)) •
                      selectedHighPoint q (t, k)) := by
                        rfl
              _ = (gammaTwoCosetRep q)⁻¹ •
                    selectedHighPoint q (s, h) := by
                        rw [hgammaMove]
              _ = baseS := by
                        simp only [selectedHighPoint, baseS,
                          inv_smul_smul]
          have hbaseTIm : baseT.im = k.1 := by
            simpa only [baseT] using horizontalHighPoint_im (t, k)
          have hbaseSIm : baseS.im = h.1 := by
            simpa only [baseS] using horizontalHighPoint_im (s, h)
          have hbaseTOne : 1 < baseT.im := by
            rw [hbaseTIm]
            exact k.2
          have hbaseSOne : 1 < baseS.im := by
            rw [hbaseSIm]
            exact h.2
          have hlower : bridge 1 0 = 0 :=
            standardCuspBridge_lowerLeft_eq_zero
              bridge baseT baseS hbaseTOne hbaseSOne hbridgeMove
          have hheight : baseS.im = baseT.im :=
            highBridge_preserves_height
              bridge baseT baseS hlower hbridgeMove
          have hHeightEq : h.1 = k.1 := by
            rw [hbaseSIm, hbaseTIm] at hheight
            exact hheight
          have hbridgeMem :
              bridge ∈ CongruenceSubgroup.Gamma 2 := by
            simpa only [bridge] using
              standardCuspBridge_mem_Gamma q gamma
          have hupperMod : ((bridge 0 1 : ℤ) : ZMod 2) = 0 :=
            (CongruenceSubgroup.Gamma_mem.mp hbridgeMem).2.1
          have hupperEven : (2 : ℤ) ∣ bridge 0 1 :=
            (ZMod.intCast_zmod_eq_zero_iff_dvd (bridge 0 1) 2).mp
              hupperMod
          rcases hupperEven with ⟨n, hn⟩
          have hdet : bridge 0 0 * bridge 1 1 = 1 :=
            upperTriangular_diagonal_product_eq_one bridge hlower
          rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet with
            hdiag | hdiag
          · have hbridgeEq :
                bridge = ModularGroup.T ^ (bridge 0 1) :=
              upperTriangular_eq_T_zpow bridge hlower hdiag
            have hreal : t + (bridge 0 1 : ℝ) = s := by
              have hre := congrArg UpperHalfPlane.re hbridgeMove
              rw [hbridgeEq, ModularGroup.re_T_zpow_smul] at hre
              simpa only [baseT, baseS,
                horizontalHighPoint_re] using hre
            have hCircleEq :
                (s : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) =
                  (t : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) := by
              rw [← sub_eq_zero, ← AddCircle.coe_sub,
                AddCircle.coe_eq_zero_iff]
              refine ⟨n, ?_⟩
              simp only [zsmul_eq_mul]
              have hnReal : (bridge 0 1 : ℝ) = 2 * (n : ℝ) := by
                exact_mod_cast hn
              nlinarith
            exact Prod.ext hCircleEq (Subtype.ext hHeightEq)
          · have hbridgeEq :
                bridge = -ModularGroup.T ^ (-(bridge 0 1)) :=
              upperTriangular_eq_neg_T_zpow bridge hlower hdiag
            have hreal : t - (bridge 0 1 : ℝ) = s := by
              have hre := congrArg UpperHalfPlane.re hbridgeMove
              rw [hbridgeEq, ModularGroup.SL_neg_smul,
                ModularGroup.re_T_zpow_smul] at hre
              simpa only [baseT, baseS, horizontalHighPoint_re,
                Int.cast_neg, sub_eq_add_neg] using hre
            have hCircleEq :
                (s : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) =
                  (t : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) := by
              rw [← sub_eq_zero, ← AddCircle.coe_sub,
                AddCircle.coe_eq_zero_iff]
              refine ⟨-n, ?_⟩
              simp only [zsmul_eq_mul, Int.cast_neg]
              have hnReal : (bridge 0 1 : ℝ) = 2 * (n : ℝ) := by
                exact_mod_cast hn
              nlinarith
            exact Prod.ext hCircleEq (Subtype.ext hHeightEq)

/-! ## 5. Openness and the open-cylinder embedding -/

/-- The descended cylinder is open.  Openness is checked upstairs using the
open product quotient map. -/
theorem cuspCylinderMap_isOpenMap (q : GammaTwoRightCoset) :
    IsOpenMap (cuspCylinderMap q) := by
  intro U hU
  have hPreOpen : IsOpen (cylinderQuotientMap ⁻¹' U) :=
    hU.preimage cylinderQuotientMap_isOpenQuotientMap.continuous
  have hImage :
      cuspCylinderMap q '' U =
        rawHighCuspMap q '' (cylinderQuotientMap ⁻¹' U) := by
    apply Set.Subset.antisymm
    · rintro x ⟨u, hu, rfl⟩
      rcases cylinderQuotientMap_surjective u with ⟨v, hv⟩
      refine ⟨v, ?_, ?_⟩
      · simpa only [mem_preimage, hv] using hu
      · rw [← cuspCylinderMap_comp_cylinderQuotientMap q]
        simp only [Function.comp_apply, hv]
    · rintro x ⟨v, hv, rfl⟩
      refine ⟨cylinderQuotientMap v, hv, ?_⟩
      rw [← cuspCylinderMap_comp_cylinderQuotientMap q]
      rfl
  rw [hImage]
  exact rawHighCuspMap_isOpenMap q _ hPreOpen

/-- The actual high cusp is an open embedded cylinder in the effective
quotient. -/
theorem cuspCylinderMap_isOpenEmbedding (q : GammaTwoRightCoset) :
    IsOpenEmbedding (cuspCylinderMap q) :=
  IsOpenEmbedding.of_continuous_injective_isOpenMap
    (cuspCylinderMap_continuous q)
    (cuspCylinderMap_injective q)
    (cuspCylinderMap_isOpenMap q)

/-! ## 6. A fixed band and its collar homeomorphism -/

/-- The radius used for every normalized cusp level at least two. -/
def collarRadius : ℝ := (1 : ℝ) / 2

theorem collarRadius_pos : 0 < collarRadius := by
  norm_num [collarRadius]

/-- The open height band around the truncation horocycle. -/
abbrev CuspBand (Y : ℝ) :=
  Set.Ioo (gammaTwoCuspLevel Y - collarRadius)
    (gammaTwoCuspLevel Y + collarRadius)

/-- Every height in the fixed band at level at least two lies in the high
cusp. -/
theorem cuspBand_height_gt_one
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (h : CuspBand Y) :
    1 < h.1 := by
  have hLower :
      gammaTwoCuspLevel Y - collarRadius < h.1 := h.2.1
  rw [collarRadius] at hLower
  linarith

/-- Include the fixed band into the full high cylinder. -/
def bandToHighCylinder
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × CuspBand Y →
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × HighHeight :=
  fun p => (p.1, ⟨p.2.1, cuspBand_height_gt_one hY p.2⟩)

/-- The band inclusion is an open embedding. -/
theorem bandToHighCylinder_isOpenEmbedding
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    IsOpenEmbedding (bandToHighCylinder hY) := by
  have hHeight : IsOpenEmbedding
      (fun h : CuspBand Y =>
        (⟨h.1, cuspBand_height_gt_one hY h⟩ : HighHeight)) := by
    apply IsOpenEmbedding.of_comp
      (fun h : CuspBand Y =>
        (⟨h.1, cuspBand_height_gt_one hY h⟩ : HighHeight))
      isOpen_Ioi.isOpenEmbedding_subtypeVal
    simpa only [Function.comp_def] using
      (isOpen_Ioo : IsOpen
        (Set.Ioo (gammaTwoCuspLevel Y - collarRadius)
          (gammaTwoCuspLevel Y + collarRadius))).isOpenEmbedding_subtypeVal
  change IsOpenEmbedding
    (Prod.map
      (id : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle →
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle)
      (fun h : CuspBand Y =>
        (⟨h.1, cuspBand_height_gt_one hY h⟩ : HighHeight)))
  exact IsOpenEmbedding.id.prodMap hHeight

/-- Embed the selected open band into the quotient. -/
def cuspBandMap
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × CuspBand Y → GammaTwoQuotient :=
  cuspCylinderMap q ∘ bandToHighCylinder hY

theorem cuspBandMap_isOpenEmbedding
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    IsOpenEmbedding (cuspBandMap q hY) := by
  exact (cuspCylinderMap_isOpenEmbedding q).comp
    (bandToHighCylinder_isOpenEmbedding hY)

/-- The ordinary product inclusion from the band subtype to
`AddCircle 2 × ℝ`. -/
def bandProductInclusion (Y : ℝ) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × CuspBand Y → QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × ℝ :=
  Prod.map id ((↑) : CuspBand Y → ℝ)

theorem bandProductInclusion_isOpenEmbedding (Y : ℝ) :
    IsOpenEmbedding (bandProductInclusion Y) := by
  simpa only [bandProductInclusion] using
    IsOpenEmbedding.id.prodMap
      ((isOpen_Ioo : IsOpen
        (Set.Ioo (gammaTwoCuspLevel Y - collarRadius)
          (gammaTwoCuspLevel Y + collarRadius))).isOpenEmbedding_subtypeVal)

theorem bandProductInclusion_range (Y : ℝ) :
    Set.range (bandProductInclusion Y) =
      Set.univ ×ˢ
        Set.Ioo (gammaTwoCuspLevel Y - collarRadius)
          (gammaTwoCuspLevel Y + collarRadius) := by
  ext p
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨Set.mem_univ _, x.2.2⟩
  · rintro ⟨_hp, hp⟩
    exact ⟨(p.1, ⟨p.2, hp⟩), rfl⟩

/-- The fixed cusp level belongs to its radius-`1/2` band. -/
def cuspLevelBandPoint (Y : ℝ) : CuspBand Y :=
  ⟨gammaTwoCuspLevel Y,
    by
      constructor <;>
        have h := collarRadius_pos <;> linarith⟩

/-- The central level provides the nonempty-domain instance required by the
open-embedding-to-partial-homeomorphism constructor. -/
local instance cuspBandNonempty (Y : ℝ) : Nonempty (CuspBand Y) :=
  ⟨cuspLevelBandPoint Y⟩

/-- The explicit point at the normalized cutoff level is literally the old
selected horocycle point with cutoff `Y`. -/
theorem selectedHighPoint_at_cuspLevel
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) (t : ℝ) :
    selectedHighPoint q
        (t,
          (⟨gammaTwoCuspLevel Y,
            lt_of_lt_of_le one_lt_two hY⟩ : HighHeight)) =
      gammaTwoSelectedHorocycleParam q Y t := by
  rw [QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedHorocycleParam_eq_traceHorizontal]
  unfold selectedHighPoint
  apply congrArg (fun z : ℍ => gammaTwoCosetRep q • z)
  apply UpperHalfPlane.ext_re_im
  · simp
  · simp

/-- At the central height, the thick-cylinder parametrization is exactly the
previously certified cusp circle. -/
theorem cuspCylinderMap_at_cuspLevel
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    cuspCylinderMap q
        (theta,
          (⟨gammaTwoCuspLevel Y,
            lt_of_lt_of_le one_lt_two hY⟩ : HighHeight)) =
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta := by
  induction theta using QuotientAddGroup.induction_on with
  | H t =>
      rw [cuspCylinderMap_coe, QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle_coe]
      unfold rawHighCuspMap QYM.FullCertification.P2ConnectedCuspComponentsExtension.selectedCuspQuotientLoop
      rw [selectedHighPoint_at_cuspLevel q hY]

/-- The band embedding sends its central slice to the selected cusp circle. -/
theorem cuspBandMap_at_cuspLevel
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    cuspBandMap q hY (theta, cuspLevelBandPoint Y) =
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta := by
  unfold cuspBandMap bandToHighCylinder
  change cuspCylinderMap q
      (theta,
        (⟨gammaTwoCuspLevel Y, _⟩ : HighHeight)) = _
  exact cuspCylinderMap_at_cuspLevel q hY theta

/-- The open partial homeomorphism from the quotient cusp neighborhood to
the literal product band. -/
noncomputable def cuspCollarHomeomorph
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    OpenPartialHomeomorph GammaTwoQuotient
      (QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × ℝ) :=
  ((cuspBandMap_isOpenEmbedding q hY).toOpenPartialHomeomorph
      (cuspBandMap q hY)).symm.trans
    ((bandProductInclusion_isOpenEmbedding Y).toOpenPartialHomeomorph
      (bandProductInclusion Y))

/-- The collar source is precisely the open range of the band embedding. -/
theorem cuspCollarHomeomorph_source
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    (cuspCollarHomeomorph q hY).source =
      Set.range (cuspBandMap q hY) := by
  rw [cuspCollarHomeomorph, OpenPartialHomeomorph.trans_source]
  simp

/-- The collar target is the required literal product strip. -/
theorem cuspCollarHomeomorph_target
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    (cuspCollarHomeomorph q hY).target =
      Set.univ ×ˢ
        Set.Ioo (gammaTwoCuspLevel Y - collarRadius)
          (gammaTwoCuspLevel Y + collarRadius) := by
  rw [cuspCollarHomeomorph, OpenPartialHomeomorph.trans_target]
  simp only [OpenPartialHomeomorph.symm_target,
    Topology.IsOpenEmbedding.toOpenPartialHomeomorph_source,
    Topology.IsOpenEmbedding.toOpenPartialHomeomorph_target,
    preimage_univ, inter_univ]
  exact bandProductInclusion_range Y

/-- The actual selected cusp circle is contained in the collar source. -/
theorem selectedCuspCircle_range_subset_cuspCollar_source
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    Set.range (QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y) ⊆
      (cuspCollarHomeomorph q hY).source := by
  rw [cuspCollarHomeomorph_source]
  rintro x ⟨theta, rfl⟩
  refine ⟨(theta, cuspLevelBandPoint Y), ?_⟩
  exact cuspBandMap_at_cuspLevel q hY theta

/-- In collar coordinates the selected cusp circle is the central horizontal
slice, with its width-two parameter unchanged. -/
theorem cuspCollarHomeomorph_selectedCuspCircle
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle) :
    cuspCollarHomeomorph q hY
        (QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta) =
      (theta, gammaTwoCuspLevel Y) := by
  let d : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle × CuspBand Y :=
    (theta, cuspLevelBandPoint Y)
  have hcentral : cuspBandMap q hY d =
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta := by
    simpa only [d] using cuspBandMap_at_cuspLevel q hY theta
  rw [← hcentral]
  unfold cuspCollarHomeomorph
  rw [OpenPartialHomeomorph.trans_apply]
  rw [Topology.IsOpenEmbedding.toOpenPartialHomeomorph_left_inv]
  rw [congrFun
    ((bandProductInclusion_isOpenEmbedding Y).toOpenPartialHomeomorph_apply
      (bandProductInclusion Y)) d]
  change bandProductInclusion Y d =
    (theta, gammaTwoCuspLevel Y)
  rfl

/-! ## 7. Closure of the exact residual -/

/-- Every selected cusp at normalized level at least two has an explicit
radius-`1/2` product collar. -/
theorem cuspCollarResidual
    (q : GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.CuspCollarResidual q Y := by
  refine ⟨collarRadius, collarRadius_pos,
    cuspCollarHomeomorph q hY, ?_, ?_, ?_⟩
  · exact cuspCollarHomeomorph_target q hY
  · exact selectedCuspCircle_range_subset_cuspCollar_source q hY
  · exact cuspCollarHomeomorph_selectedCuspCircle q hY

/-- Quantified path-A cusp-collar certificate. -/
theorem allHighCuspCollars :
    ∀ (q : GammaTwoRightCoset) (Y : ℝ),
      2 ≤ gammaTwoCuspLevel Y → QYM.FullCertification.P2SmoothQuotientAtlasExtension.CuspCollarResidual q Y := by
  intro q Y hY
  exact cuspCollarResidual q hY

/-- After this file, the combined path-A residual is definitionally reduced
to the atlas-transition statement alone. -/
theorem smoothQuotientAndCuspCollarResidual_of_smoothTransitions
    (hSmooth : QYM.FullCertification.P2SmoothQuotientAtlasExtension.SmoothTransitionResidual) :
    QYM.FullCertification.P2SmoothQuotientAtlasExtension.SmoothQuotientAndCuspCollarResidual :=
  ⟨hSmooth, allHighCuspCollars⟩

/-- A compact certificate exposing the geometric and residual endpoints. -/
theorem cuspCollarClosureCertificate :
    (∀ q : GammaTwoRightCoset,
      IsOpenEmbedding (cuspCylinderMap q)) ∧
    (∀ (q : GammaTwoRightCoset) (Y : ℝ),
      2 ≤ gammaTwoCuspLevel Y → QYM.FullCertification.P2SmoothQuotientAtlasExtension.CuspCollarResidual q Y) := by
  exact ⟨cuspCylinderMap_isOpenEmbedding, allHighCuspCollars⟩

end QYM.FullCertification.P2CuspCollarClosureExtension

