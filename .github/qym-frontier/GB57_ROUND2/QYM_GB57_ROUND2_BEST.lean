/-!
# Operator graph, form-representation, and compact-slice cores

This module isolates source-valid functional-analysis logic around Lemmas 4.13 and 4.16--4.18
and Proposition 4.15 of the paper.  It deliberately does not construct the paper's gauge slice,
projected covariant derivative, Friedrichs operator, resolvent, or eigenbasis.

The positive results expose their actual suppliers:

* sequential closedness of a partial operator and completeness of both ambient spaces imply
  sequential graph completeness;
* two already-given Hilbert-space operators representing the same form are unique on their common
  domain;
* a compact source image remains compact after intersection with a closed admissible slice.

Two explicit no-go results separate gaps in the printed proof of Lemma 4.16.  Ambient density plus
closedness of a slice does not by itself make the intersection dense in that slice.  Also, composing
a closed partial map with a bounded projection need not preserve closedness.  The latter arithmetic
countermodel is nonlinear; it refutes the bare topological inference, not a correctly stated theorem
for the paper's still-unconstructed linear differential operator.  A linear/operator-theoretic
application must supply the corresponding density, invariance, or graph-closure hypotheses.
-/

namespace QYM.OperatorFormCompactnessCore

open Filter Topology

/-! ## Sequential graph closedness and graph completeness -/

section GraphClosure

variable {H K : Type*} [PseudoMetricSpace H] [PseudoMetricSpace K]

/-- Explicit sequential closed-graph predicate for a partial map.  The map is total as Lean data,
while `domain` records the intended operator domain. -/
def IsSequentiallyClosedOn (domain : Set H) (operator : H → K) : Prop :=
  ∀ (u : ℕ → H) (x : H) (y : K),
    (∀ n : ℕ, u n ∈ domain) →
      Tendsto u atTop (𝓝 x) →
        Tendsto (fun n => operator (u n)) atTop (𝓝 y) →
          x ∈ domain ∧ operator x = y

/-- Sequential completeness of the graph-norm data: a sequence and its operator image being
Cauchy produces a domain point to which both components converge. -/
def IsSequentiallyGraphComplete (domain : Set H) (operator : H → K) : Prop :=
  ∀ (u : ℕ → H),
    (∀ n : ℕ, u n ∈ domain) →
      CauchySeq u →
        CauchySeq (fun n => operator (u n)) →
          ∃ x : H,
            x ∈ domain ∧
              Tendsto u atTop (𝓝 x) ∧
                Tendsto (fun n => operator (u n)) atTop (𝓝 (operator x))

/-- The precise graph-closure argument used in a closed quadratic-form proof.  Closedness is an
explicit hypothesis; it is not inferred from the notation used to define the operator. -/
theorem sequentiallyGraphComplete_of_sequentiallyClosed
    [CompleteSpace H] [CompleteSpace K]
    {domain : Set H} {operator : H → K}
    (hclosed : IsSequentiallyClosedOn domain operator) :
    IsSequentiallyGraphComplete domain operator := by
  intro u huDomain huCauchy hoperatorCauchy
  obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete huCauchy
  obtain ⟨y, hy⟩ := cauchySeq_tendsto_of_complete hoperatorCauchy
  obtain ⟨hxDomain, hoperator⟩ := hclosed u x y huDomain hx hy
  refine ⟨x, hxDomain, hx, ?_⟩
  simpa [hoperator] using hy

end GraphClosure

/-! ## Nonnegative graph energy -/

section GraphEnergy

variable {H K : Type*} [SeminormedAddCommGroup H] [SeminormedAddCommGroup K]

/-- The nonnegative energy attached to the operator component of graph data. -/
def graphEnergy (operator : H → K) (x : H) : ℝ :=
  ‖operator x‖ ^ 2

/-- The squared graph-norm expression, before taking a square root. -/
def graphNormSq (operator : H → K) (x : H) : ℝ :=
  ‖x‖ ^ 2 + ‖operator x‖ ^ 2

theorem graphEnergy_nonnegative (operator : H → K) (x : H) :
    0 ≤ graphEnergy operator x := by
  exact sq_nonneg ‖operator x‖

theorem graphNormSq_nonnegative (operator : H → K) (x : H) :
    0 ≤ graphNormSq operator x := by
  exact add_nonneg (sq_nonneg ‖x‖) (sq_nonneg ‖operator x‖)

end GraphEnergy

/-! ## Uniqueness, but not existence, of a form representative -/

section FormRepresentation

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- A supplied operator represents a supplied real form on an explicitly displayed domain.  This
predicate contains no existence, self-adjointness, closedness, or lower-bound field. -/
def RepresentsFormOn
    (form : H → H → ℝ) (operatorDomain : Set H) (operator : H → H) : Prop :=
  ∀ x : H, x ∈ operatorDomain →
    ∀ y : H, form x y = ⟪operator x, y⟫_ℝ

/-- The uniqueness half of form representation: two already-supplied representatives of the same
form agree on their common domain.  Friedrichs existence is intentionally not claimed. -/
theorem formRepresentative_uniqueOn
    {form : H → H → ℝ} {operatorDomain : Set H} {A B : H → H}
    (hA : RepresentsFormOn form operatorDomain A)
    (hB : RepresentsFormOn form operatorDomain B) :
    Set.EqOn A B operatorDomain := by
  intro x hx
  apply ext_inner_right ℝ
  intro y
  calc
    ⟪A x, y⟫_ℝ = form x y := (hA x hx y).symm
    _ = ⟪B x, y⟫_ℝ := hB x hx y

/-- Global specialization of uniqueness when both supplied representatives act on all of `H`. -/
theorem formRepresentative_unique
    {form : H → H → ℝ} {A B : H → H}
    (hA : RepresentsFormOn form Set.univ A)
    (hB : RepresentsFormOn form Set.univ B) :
    A = B := by
  funext x
  exact formRepresentative_uniqueOn hA hB (Set.mem_univ x)

end FormRepresentation

/-! ## The valid compactness restriction step -/

section CompactRestriction

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-- Intersecting a genuinely compact set with a closed admissible slice preserves compactness. -/
theorem compact_inter_closed_admissible
    {compactSet admissible : Set X}
    (hcompact : IsCompact compactSet) (hadmissible : IsClosed admissible) :
    IsCompact (compactSet ∩ admissible) :=
  hcompact.inter_right hadmissible

/-- Image version relevant to a compact embedding: compactness of the source set and continuity of
the embedding are explicit inputs; only the subsequent closed-slice restriction is automatic. -/
theorem compact_image_inter_closed_admissible
    {source : Set X} {admissible : Set Y} {embedding : X → Y}
    (hsource : IsCompact source)
    (hembedding : ContinuousOn embedding source)
    (hadmissible : IsClosed admissible) :
    IsCompact (embedding '' source ∩ admissible) :=
  (hsource.image_of_continuousOn hembedding).inter_right hadmissible

end CompactRestriction

/-! ## Ambient density does not imply slice density -/

section DensityNoGo

/-- Density of the intersection inside a displayed slice, expressed using ambient closure.  For a
closed slice this is the usual ambient formulation of relative density. -/
def DenseIn {X : Type*} [TopologicalSpace X] (core slice : Set X) : Prop :=
  slice ⊆ closure (core ∩ slice)

/-- A strong but transparent interaction hypothesis that does guarantee slice density. -/
theorem denseIn_of_slice_subset
    {X : Type*} [TopologicalSpace X] {core slice : Set X}
    (hsubset : slice ⊆ core) :
    DenseIn core slice := by
  intro x hx
  exact subset_closure ⟨hsubset hx, hx⟩

/-- A dense subset of the ambient real line. -/
def puncturedReal : Set ℝ :=
  ({0} : Set ℝ)ᶜ

/-- A nonempty closed slice disjoint from `puncturedReal`. -/
def zeroSlice : Set ℝ :=
  {0}

theorem puncturedReal_dense : Dense puncturedReal := by
  exact dense_compl_singleton 0

theorem zeroSlice_closed : IsClosed zeroSlice := by
  exact isClosed_singleton

theorem puncturedReal_inter_zeroSlice :
    puncturedReal ∩ zeroSlice = ∅ := by
  ext x
  simp [puncturedReal, zeroSlice]

theorem puncturedReal_not_denseIn_zeroSlice :
    ¬ DenseIn puncturedReal zeroSlice := by
  intro hdense
  have hzero : (0 : ℝ) ∈ closure (puncturedReal ∩ zeroSlice) :=
    hdense (by simp [zeroSlice])
  rw [puncturedReal_inter_zeroSlice] at hzero
  simpa using hzero

/-- Closedness of the slice and ambient density alone do not imply density of the intersection in
the slice.  This is the missing set-level implication in the informal density argument. -/
theorem ambientDense_and_closedSlice_do_not_imply_denseIntersection :
    Dense puncturedReal ∧
      IsClosed zeroSlice ∧
        ¬ DenseIn puncturedReal zeroSlice :=
  ⟨puncturedReal_dense, zeroSlice_closed, puncturedReal_not_denseIn_zeroSlice⟩

end DensityNoGo

/-! ## A bounded projection need not preserve a closed partial graph -/

section ProjectionClosednessNoGo

/-- Positive half-line domain for the reciprocal closed-graph countermodel. -/
def positiveRealDomain : Set ℝ :=
  Set.Ioi 0

/-- Reciprocal on the displayed positive domain.  Values outside the domain are irrelevant. -/
def reciprocalPartial (x : ℝ) : ℝ :=
  x⁻¹

/-- The bounded zero projection.  Its continuous-linear-map type records linearity and
boundedness; its range is the closed zero subspace. -/
def zeroProjection : ℝ →L[ℝ] ℝ :=
  0

/-- Composition of the partial reciprocal map with the bounded zero projection. -/
def projectedReciprocal (x : ℝ) : ℝ :=
  zeroProjection (reciprocalPartial x)

theorem zeroProjection_continuous : Continuous zeroProjection :=
  zeroProjection.continuous

theorem zeroProjection_idempotent (x : ℝ) :
    zeroProjection (zeroProjection x) = zeroProjection x := by
  simp [zeroProjection]

theorem zeroProjection_norm_le (x : ℝ) :
    ‖zeroProjection x‖ ≤ ‖x‖ := by
  simp [zeroProjection]

/-- The reciprocal partial map has a sequentially closed graph: if both a positive sequence and
its reciprocals converge, their limits still satisfy the reciprocal relation in the positive
domain. -/
theorem reciprocalPartial_isSequentiallyClosed :
    IsSequentiallyClosedOn positiveRealDomain reciprocalPartial := by
  intro u x y huDomain hux huy
  have hxnonnegative : 0 ≤ x :=
    ge_of_tendsto hux
      (Filter.Eventually.of_forall fun n => (huDomain n).le)
  have hproductLimit :
      Tendsto (fun n => u n * reciprocalPartial (u n)) atTop (𝓝 (x * y)) :=
    hux.mul huy
  have hproductPointwise :
      (fun n => u n * reciprocalPartial (u n)) =
        (fun _ : ℕ => (1 : ℝ)) := by
    funext n
    simpa [reciprocalPartial] using
      (mul_inv_cancel₀ (ne_of_gt (huDomain n)))
  have honeLimit :
      Tendsto (fun n => u n * reciprocalPartial (u n)) atTop (𝓝 (1 : ℝ)) := by
    rw [hproductPointwise]
    exact tendsto_const_nhds
  have hxy : x * y = 1 :=
    tendsto_nhds_unique hproductLimit honeLimit
  have hxne : x ≠ 0 := by
    intro hxzero
    subst x
    simpa using hxy
  have hxpositive : 0 < x :=
    lt_of_le_of_ne hxnonnegative (Ne.symm hxne)
  refine ⟨hxpositive, ?_⟩
  unfold reciprocalPartial
  calc
    x⁻¹ = x⁻¹ * 1 := (mul_one x⁻¹).symm
    _ = x⁻¹ * (x * y) := by rw [hxy]
    _ = y := inv_mul_cancel_left₀ hxne y

/-- After the bounded zero projection, the same nonclosed domain remains but all graph values are
zero.  A positive sequence can then converge to the excluded boundary while its images converge,
so the projected partial map is not sequentially closed. -/
theorem projectedReciprocal_not_isSequentiallyClosed :
    ¬ IsSequentiallyClosedOn positiveRealDomain projectedReciprocal := by
  intro hclosed
  let u : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  have huDomain : ∀ n : ℕ, u n ∈ positiveRealDomain := by
    intro n
    change 0 < 1 / ((n : ℝ) + 1)
    positivity
  have huLimit : Tendsto u atTop (𝓝 (0 : ℝ)) := by
    simpa [u] using
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  have hprojectedLimit :
      Tendsto (fun n => projectedReciprocal (u n)) atTop (𝓝 (0 : ℝ)) := by
    simpa [projectedReciprocal, zeroProjection] using
      (tendsto_const_nhds :
        Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 (0 : ℝ)))
  have hzeroDomain :=
    (hclosed u 0 0 huDomain huLimit hprojectedLimit).1
  have hzeroPositive : (0 : ℝ) < 0 := by
    simpa [positiveRealDomain] using hzeroDomain
  exact (lt_irrefl (0 : ℝ)) hzeroPositive

/-- Closed explicit partial map plus bounded idempotent projection, whose composition is not
closed.  Therefore `P ∘ D` cannot be declared closed merely from closedness of `D` and boundedness
of `P`; a graph-closure or range-invariance supplier is necessary. -/
theorem boundedProjection_does_not_preserve_partialGraphClosedness :
    IsSequentiallyClosedOn positiveRealDomain reciprocalPartial ∧
      (∀ x : ℝ, zeroProjection (zeroProjection x) = zeroProjection x) ∧
        ¬ IsSequentiallyClosedOn positiveRealDomain projectedReciprocal :=
  ⟨reciprocalPartial_isSequentiallyClosed,
    zeroProjection_idempotent,
    projectedReciprocal_not_isSequentiallyClosed⟩

end ProjectionClosednessNoGo

end QYM.OperatorFormCompactnessCore


/-!
# Paper-normalized operator/form/compactness boundaries

These closed propositions normalize only the source-valid functional-analysis implications around
Lemma 4.13, Lemma 4.16, and Lemma 4.18.  They do not assert existence of the paper's gauge slice,
closed projected derivative, Friedrichs representative, self-adjoint Hamiltonian, compact
resolvent, or discrete eigenvalue enumeration.

In particular, `lemma4_13_closedGraphImplicationStatement` begins with an explicit closed-graph
hypothesis, and the representation statement proves uniqueness only for representatives already
supplied as arguments.  The compactness statement begins with an explicit compact source set and
a continuous embedding; it does not prove Rellich compactness or identify a form-domain unit ball.
The two Lemma-4.16 inference statements are deliberately refuted and accompanied by positive
countermodel packages.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Lemma 4.13: corrected graph and uniqueness implications -/

/-- Closed partial graph plus complete ambient spaces implies sequential graph completeness.  This
is the graph-norm closure step, not the Friedrichs existence theorem. -/
def lemma4_13_closedGraphImplicationStatement : Prop :=
  ∀ (H K : Type) [PseudoMetricSpace H] [PseudoMetricSpace K]
      [CompleteSpace H] [CompleteSpace K]
      (domain : Set H) (operator : H → K),
    QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn domain operator →
      QYM.OperatorFormCompactnessCore.IsSequentiallyGraphComplete domain operator

theorem lemma4_13_closedGraphImplicationStatement_holds :
    lemma4_13_closedGraphImplicationStatement := by
  intro H K instH instK completeH completeK domain operator hclosed
  exact
    QYM.OperatorFormCompactnessCore.sequentiallyGraphComplete_of_sequentiallyClosed
      hclosed

/-- Uniqueness of two already-supplied Hilbert-space form representatives on their common domain.
No representative is produced by this proposition. -/
def lemma4_13_formRepresentativeUniquenessStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (form : H → H → ℝ) (domain : Set H) (A B : H → H),
    QYM.OperatorFormCompactnessCore.RepresentsFormOn form domain A →
      QYM.OperatorFormCompactnessCore.RepresentsFormOn form domain B →
        Set.EqOn A B domain

theorem lemma4_13_formRepresentativeUniquenessStatement_holds :
    lemma4_13_formRepresentativeUniquenessStatement := by
  intro H instNormed instInner form domain A B hA hB
  exact QYM.OperatorFormCompactnessCore.formRepresentative_uniqueOn hA hB

/-! ## Lemma 4.16: corrected conditional core -/

/-- Conditional closed/nonnegative graph core for the projected derivative.  The crucial
closedness of the projected map is displayed as a premise. -/
def lemma4_16_closedNonnegativeGraphCoreStatement : Prop :=
  ∀ (H K : Type) [NormedAddCommGroup H] [NormedAddCommGroup K]
      [CompleteSpace H] [CompleteSpace K]
      (domain : Set H) (operator : H → K),
    QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn domain operator →
      QYM.OperatorFormCompactnessCore.IsSequentiallyGraphComplete domain operator ∧
        ∀ x : H, 0 ≤ QYM.OperatorFormCompactnessCore.graphEnergy operator x

theorem lemma4_16_closedNonnegativeGraphCoreStatement_holds :
    lemma4_16_closedNonnegativeGraphCoreStatement := by
  intro H K instH instK completeH completeK domain operator hclosed
  exact
    ⟨QYM.OperatorFormCompactnessCore.sequentiallyGraphComplete_of_sequentiallyClosed
        hclosed,
      QYM.OperatorFormCompactnessCore.graphEnergy_nonnegative operator⟩

/-! ## Lemma 4.16: density no-go and countermodel -/

/-- Invalid bare inference: an ambient-dense set and a closed slice need not have dense
intersection in that slice. -/
def lemma4_16_ambientDensityClosedSliceInferenceStatement : Prop :=
  ∀ (X : Type) [TopologicalSpace X] (core slice : Set X),
    Dense core →
      IsClosed slice →
        QYM.OperatorFormCompactnessCore.DenseIn core slice

theorem lemma4_16_ambientDensityClosedSliceInferenceStatement_refuted :
    ¬ lemma4_16_ambientDensityClosedSliceInferenceStatement := by
  intro hinference
  have hdense :=
    hinference ℝ
      QYM.OperatorFormCompactnessCore.puncturedReal
      QYM.OperatorFormCompactnessCore.zeroSlice
      QYM.OperatorFormCompactnessCore.puncturedReal_dense
      QYM.OperatorFormCompactnessCore.zeroSlice_closed
  exact
    QYM.OperatorFormCompactnessCore.puncturedReal_not_denseIn_zeroSlice
      hdense

/-- Positive existential packaging of the ambient-density/closed-slice countermodel.  This is a
set-level obstruction and does not claim that the paper's Sobolev domain equals the punctured real
line. -/
def lemma4_16_ambientDensityClosedSliceCountermodelStatement : Prop :=
  ∃ (core slice : Set ℝ),
    Dense core ∧
      IsClosed slice ∧
        ¬ QYM.OperatorFormCompactnessCore.DenseIn core slice

theorem lemma4_16_ambientDensityClosedSliceCountermodelStatement_holds :
    lemma4_16_ambientDensityClosedSliceCountermodelStatement := by
  exact
    ⟨QYM.OperatorFormCompactnessCore.puncturedReal,
      QYM.OperatorFormCompactnessCore.zeroSlice,
      QYM.OperatorFormCompactnessCore.ambientDense_and_closedSlice_do_not_imply_denseIntersection⟩

/-! ## Lemma 4.16: projected-closedness no-go and countermodel -/

/-- Invalid inference that a sequentially closed partial map remains closed after composition with
an arbitrary bounded idempotent linear projection. -/
def lemma4_16_boundedProjectionClosedCompositionInferenceStatement : Prop :=
  ∀ (domain : Set ℝ) (operator : ℝ → ℝ) (projection : ℝ →L[ℝ] ℝ),
    QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn domain operator →
      (∀ x : ℝ, projection (projection x) = projection x) →
        (∀ x : ℝ, ‖projection x‖ ≤ ‖x‖) →
          QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn
            domain (fun x => projection (operator x))

theorem lemma4_16_boundedProjectionClosedCompositionInferenceStatement_refuted :
    ¬ lemma4_16_boundedProjectionClosedCompositionInferenceStatement := by
  intro hinference
  have hprojected :=
    hinference
      QYM.OperatorFormCompactnessCore.positiveRealDomain
      QYM.OperatorFormCompactnessCore.reciprocalPartial
      QYM.OperatorFormCompactnessCore.zeroProjection
      QYM.OperatorFormCompactnessCore.reciprocalPartial_isSequentiallyClosed
      QYM.OperatorFormCompactnessCore.zeroProjection_idempotent
      QYM.OperatorFormCompactnessCore.zeroProjection_norm_le
  apply
    QYM.OperatorFormCompactnessCore.projectedReciprocal_not_isSequentiallyClosed
  change QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn
    QYM.OperatorFormCompactnessCore.positiveRealDomain
    (fun x => QYM.OperatorFormCompactnessCore.zeroProjection
      (QYM.OperatorFormCompactnessCore.reciprocalPartial x))
  exact hprojected

/-- Positive existential bounded-projection countermodel.  The map before projection is the
closed partial reciprocal map; this arithmetic example is not asserted to be linear. -/
def lemma4_16_boundedProjectionClosedCompositionCountermodelStatement : Prop :=
  ∃ (domain : Set ℝ) (operator : ℝ → ℝ) (projection : ℝ →L[ℝ] ℝ),
    QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn domain operator ∧
      (∀ x : ℝ, projection (projection x) = projection x) ∧
        (∀ x : ℝ, ‖projection x‖ ≤ ‖x‖) ∧
          ¬ QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn
            domain (fun x => projection (operator x))

theorem lemma4_16_boundedProjectionClosedCompositionCountermodelStatement_holds :
    lemma4_16_boundedProjectionClosedCompositionCountermodelStatement := by
  refine
    ⟨QYM.OperatorFormCompactnessCore.positiveRealDomain,
      QYM.OperatorFormCompactnessCore.reciprocalPartial,
      QYM.OperatorFormCompactnessCore.zeroProjection,
      QYM.OperatorFormCompactnessCore.reciprocalPartial_isSequentiallyClosed,
      QYM.OperatorFormCompactnessCore.zeroProjection_idempotent,
      QYM.OperatorFormCompactnessCore.zeroProjection_norm_le, ?_⟩
  change ¬ QYM.OperatorFormCompactnessCore.IsSequentiallyClosedOn
    QYM.OperatorFormCompactnessCore.positiveRealDomain
    QYM.OperatorFormCompactnessCore.projectedReciprocal
  exact
    QYM.OperatorFormCompactnessCore.projectedReciprocal_not_isSequentiallyClosed

/-! ## Lemma 4.18: the valid compact-slice step -/

/-- Conditional compactness step behind Lemma 4.18.  Compactness of the source set and continuity
of the embedding are premises; no compact resolvent or spectral theorem conclusion is encoded. -/
def lemma4_18_closedSliceCompactnessCoreStatement : Prop :=
  ∀ (X Y : Type) [TopologicalSpace X] [TopologicalSpace Y]
      (source : Set X) (admissible : Set Y) (embedding : X → Y),
    IsCompact source →
      ContinuousOn embedding source →
        IsClosed admissible →
          IsCompact (embedding '' source ∩ admissible)

theorem lemma4_18_closedSliceCompactnessCoreStatement_holds :
    lemma4_18_closedSliceCompactnessCoreStatement := by
  intro X Y instX instY source admissible embedding hsource hembedding hadmissible
  exact
    QYM.OperatorFormCompactnessCore.compact_image_inter_closed_admissible
      hsource hembedding hadmissible

end QYM.FullCertification.PaperNormalized


/-!
# Root-exponential coefficients and the Weyl-to-window logical core

This file isolates the scalar and quantifier-level content of claim-ledger rows 42--47
(Theorem 4.26 through Lemma 4.29).  It does not construct the paper's mock coefficients, prove a
Rademacher expansion, package the unavailable Paper-I conditions (T0)--(T4), or prove a Weyl law
for the paper's operator.

The root-exponential definitions distinguish the PDF's bound for every `n >= 1` from the legacy
eventual predicate `QYM.RootExpLaw`.  The one-term remainder is an explicit supplier, including its
starting index and error constant.  The Weyl-to-window theorem preserves all parameter-uniform
quantifiers and exposes both the smoothed Weyl estimate and the indicator-majorant property as
hypotheses.

The final scalar profile is only a logical countermodel to exchanging pointwise constants for one
uniform constant.  It is not asserted to be the counting function of the paper's operator.  The
existing `ENNReal` spectral-tail and Lemma-4.29 uniformity developments are intentionally not
duplicated here.
-/

namespace QYM.RootExpWeylLogicCore

open Filter
open scoped ENNReal

/-! ## Theorem 4.26: exact scalar envelopes -/

/-- The exact scalar envelope printed in Theorem 4.26. -/
def rootExponentialEnvelope (C α : ℝ) (n : ℕ) : ℝ :=
  C / Real.sqrt (n : ℝ) * Real.exp (α * Real.sqrt (n : ℝ))

/-- A root-exponential estimate beginning at an explicit natural-number index. -/
def HasRootExponentialEstimateFrom
    (a : ℕ → ℝ) (C α : ℝ) (N : ℕ) : Prop :=
  ∀ n : ℕ, N ≤ n → |a n| ≤ rootExponentialEnvelope C α n

/-- The all-index law printed in Theorem 4.26, including positivity of both constants. -/
def HasRootExponentialBound (a : ℕ → ℝ) (C α : ℝ) : Prop :=
  0 < C ∧ 0 < α ∧ HasRootExponentialEstimateFrom a C α 1

/-- Existence form of the all-index root-exponential coefficient law. -/
def HasSomeRootExponentialBound (a : ℕ → ℝ) : Prop :=
  ∃ C α : ℝ, HasRootExponentialBound a C α

/-- The root-exponential envelope is nonnegative whenever its scalar constant is nonnegative. -/
theorem rootExponentialEnvelope_nonneg {C α : ℝ} (hC : 0 ≤ C) (n : ℕ) :
    0 ≤ rootExponentialEnvelope C α n := by
  exact
    mul_nonneg
      (div_nonneg hC (Real.sqrt_nonneg _))
      (Real.exp_nonneg _)

/-- Direct projection of the displayed all-index coefficient estimate. -/
theorem abs_le_rootExponentialEnvelope {a : ℕ → ℝ} {C α : ℝ}
    (hbound : HasRootExponentialBound a C α) {n : ℕ} (hn : 1 ≤ n) :
    |a n| ≤ rootExponentialEnvelope C α n :=
  hbound.2.2 n hn

/-- The absolute-value estimate gives the corresponding exact two-sided scalar interval. -/
theorem coefficient_twoSided_of_rootExponentialBound
    {a : ℕ → ℝ} {C α : ℝ}
    (hbound : HasRootExponentialBound a C α) {n : ℕ} (hn : 1 ≤ n) :
    -rootExponentialEnvelope C α n ≤ a n ∧
      a n ≤ rootExponentialEnvelope C α n :=
  abs_le.mp (abs_le_rootExponentialEnvelope hbound hn)

/-- The PDF-strength all-index law implies the older eventual predicate.  The converse is false
below because eventual truth does not control any prescribed finite prefix. -/
theorem rootExponentialBound_implies_legacyRootExpLaw
    {a : ℕ → ℝ} {C α : ℝ} (hbound : HasRootExponentialBound a C α) :
    QYM.RootExpLaw a C α := by
  filter_upwards [eventually_ge_atTop (1 : ℕ)] with n hn
  exact abs_le_rootExponentialEnvelope hbound hn

/-! ## Theorem 4.26: explicit one-term remainder supplier -/

/-- The leading term `C₀ n⁻¹ᐟ² exp (α √n)` from the PDF. -/
def oneTermMain (C₀ α : ℝ) (n : ℕ) : ℝ :=
  C₀ / Real.sqrt (n : ℝ) * Real.exp (α * Real.sqrt (n : ℝ))

/-- An explicit representative of the printed `O (n⁻¹ exp (α √n))` remainder scale. -/
def oneTermRemainderEnvelope (D α : ℝ) (n : ℕ) : ℝ :=
  D / (n : ℝ) * Real.exp (α * Real.sqrt (n : ℝ))

/-- A quantified supplier for the one-term asymptotic.  Unlike bare `O` notation, the start index
and error constant are part of the proposition. -/
def HasOneTermRemainderFrom
    (a : ℕ → ℝ) (C₀ α D : ℝ) (N : ℕ) : Prop :=
  1 ≤ N ∧ 0 ≤ D ∧
    ∀ n : ℕ, N ≤ n →
      |a n - oneTermMain C₀ α n| ≤ oneTermRemainderEnvelope D α n

/-- The absolute value of the leading term is the envelope with coefficient `|C₀|`. -/
theorem abs_oneTermMain (C₀ α : ℝ) (n : ℕ) :
    |oneTermMain C₀ α n| = rootExponentialEnvelope |C₀| α n := by
  simp only [oneTermMain, rootExponentialEnvelope, abs_mul, abs_div,
    abs_of_nonneg (Real.sqrt_nonneg _), abs_of_pos (Real.exp_pos _)]

/-- On `n >= 1`, the explicit `n⁻¹` error scale is bounded by the `n⁻¹ᐟ²` scale. -/
theorem oneTermRemainderEnvelope_le_rootExponentialEnvelope
    {D α : ℝ} (hD : 0 ≤ D) {n : ℕ} (hn : 1 ≤ n) :
    oneTermRemainderEnvelope D α n ≤ rootExponentialEnvelope D α n := by
  have hnReal : (1 : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast hn
  have hnRealPos : (0 : ℝ) < (n : ℝ) :=
    lt_of_lt_of_le zero_lt_one hnReal
  have hsqrtPos : 0 < Real.sqrt (n : ℝ) :=
    Real.sqrt_pos.2 hnRealPos
  have hsqrtLe : Real.sqrt (n : ℝ) ≤ (n : ℝ) := by
    rw [Real.sqrt_le_iff]
    constructor
    · exact hnRealPos.le
    · nlinarith
  have hdiv : D / (n : ℝ) ≤ D / Real.sqrt (n : ℝ) :=
    div_le_div_of_nonneg_left hD hsqrtPos hsqrtLe
  exact
    mul_le_mul_of_nonneg_right hdiv (Real.exp_nonneg _)

/-- Triangle inequality with the exact leading and error scales kept separate. -/
theorem coefficient_abs_le_main_add_remainder
    {a : ℕ → ℝ} {C₀ α D : ℝ} {N n : ℕ}
    (hremainder : HasOneTermRemainderFrom a C₀ α D N) (hn : N ≤ n) :
    |a n| ≤
      rootExponentialEnvelope |C₀| α n + oneTermRemainderEnvelope D α n := by
  have hdecomposition :
      a n = oneTermMain C₀ α n + (a n - oneTermMain C₀ α n) := by
    ring
  rw [hdecomposition]
  calc
    |oneTermMain C₀ α n + (a n - oneTermMain C₀ α n)| ≤
        |oneTermMain C₀ α n| + |a n - oneTermMain C₀ α n| :=
      abs_add_le _ _
    _ ≤ |oneTermMain C₀ α n| + oneTermRemainderEnvelope D α n :=
      add_le_add_right (hremainder.2.2 n hn) _
    _ = rootExponentialEnvelope |C₀| α n + oneTermRemainderEnvelope D α n := by
      rw [abs_oneTermMain]

/-- The supplied one-term remainder yields a root-exponential estimate on the supplied tail. -/
theorem oneTermRemainder_implies_tailRootExponentialEstimate
    {a : ℕ → ℝ} {C₀ α D : ℝ} {N : ℕ}
    (hremainder : HasOneTermRemainderFrom a C₀ α D N) :
    HasRootExponentialEstimateFrom a (|C₀| + D) α N := by
  intro n hn
  have hnOne : 1 ≤ n := hremainder.1.trans hn
  calc
    |a n| ≤
        rootExponentialEnvelope |C₀| α n + oneTermRemainderEnvelope D α n :=
      coefficient_abs_le_main_add_remainder hremainder hn
    _ ≤ rootExponentialEnvelope |C₀| α n + rootExponentialEnvelope D α n :=
      add_le_add_right
        (oneTermRemainderEnvelope_le_rootExponentialEnvelope hremainder.2.1 hnOne) _
    _ = rootExponentialEnvelope (|C₀| + D) α n := by
      simp only [rootExponentialEnvelope]
      ring

/-- A tail estimate becomes the PDF's all-`n >= 1` law only after the finite prefix is supplied. -/
theorem rootExponentialBound_of_prefix_and_tail
    {a : ℕ → ℝ} {C α : ℝ} {N : ℕ}
    (hC : 0 < C) (hα : 0 < α)
    (hprefix : ∀ n : ℕ, 1 ≤ n → n < N →
      |a n| ≤ rootExponentialEnvelope C α n)
    (htail : HasRootExponentialEstimateFrom a C α N) :
    HasRootExponentialBound a C α := by
  refine ⟨hC, hα, ?_⟩
  intro n hn
  by_cases hnN : n < N
  · exact hprefix n hn hnN
  · exact htail n (Nat.le_of_not_gt hnN)

/-- Fully explicit passage from a one-term asymptotic supplier plus finite-prefix control to the
all-index law.  No coefficient theorem is manufactured: `hprefix` and `hremainder` are inputs. -/
theorem rootExponentialBound_of_oneTermRemainder_and_prefix
    {a : ℕ → ℝ} {C₀ α D : ℝ} {N : ℕ}
    (hremainder : HasOneTermRemainderFrom a C₀ α D N)
    (hconstant : 0 < |C₀| + D) (hα : 0 < α)
    (hprefix : ∀ n : ℕ, 1 ≤ n → n < N →
      |a n| ≤ rootExponentialEnvelope (|C₀| + D) α n) :
    HasRootExponentialBound a (|C₀| + D) α :=
  rootExponentialBound_of_prefix_and_tail hconstant hα hprefix
    (oneTermRemainder_implies_tailRootExponentialEstimate hremainder)

/-! ## The eventual/all-index separation in the current output -/

/-- A single coefficient exceeding the desired envelope, followed by an identically zero tail. -/
def initialSpikeSequence (C α : ℝ) (n : ℕ) : ℝ :=
  if n = 1 then rootExponentialEnvelope C α 1 + 1 else 0

/-- The single-spike sequence satisfies the legacy eventual predicate whenever `C` is
nonnegative, because its tail vanishes. -/
theorem initialSpikeSequence_has_legacyRootExpLaw
    {C α : ℝ} (hC : 0 ≤ C) :
    QYM.RootExpLaw (initialSpikeSequence C α) C α := by
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with n hn
  have hn_ne_one : n ≠ 1 := by omega
  simpa [initialSpikeSequence, hn_ne_one, rootExponentialEnvelope] using
    (rootExponentialEnvelope_nonneg (C := C) (α := α) hC n)

/-- The same sequence fails the all-index law with the same constants at `n = 1`. -/
theorem initialSpikeSequence_not_hasRootExponentialBound (C α : ℝ) :
    ¬ HasRootExponentialBound (initialSpikeSequence C α) C α := by
  intro hbound
  have hAtOne := abs_le_rootExponentialEnvelope hbound (n := 1) (by omega)
  have hEnvelopeNonneg : 0 ≤ rootExponentialEnvelope C α 1 :=
    rootExponentialEnvelope_nonneg hbound.1.le 1
  have hValue :
      initialSpikeSequence C α 1 = rootExponentialEnvelope C α 1 + 1 := by
    simp [initialSpikeSequence]
  rw [hValue, abs_of_nonneg (add_nonneg hEnvelopeNonneg zero_le_one)] at hAtOne
  linarith

/-- Positive countermodel packaging the strict logical gap between eventual and all-index laws. -/
theorem legacyRootExpLaw_coexists_with_failure_of_allIndexLaw :
    ∃ (a : ℕ → ℝ) (C α : ℝ),
      0 < C ∧ 0 < α ∧ QYM.RootExpLaw a C α ∧
        ¬ HasRootExponentialBound a C α := by
  exact
    ⟨initialSpikeSequence 1 1, 1, 1, zero_lt_one, zero_lt_one,
      initialSpikeSequence_has_legacyRootExpLaw zero_le_one,
      initialSpikeSequence_not_hasRootExponentialBound 1 1⟩

/-- The current eventual predicate alone cannot recover the PDF's bound for every `n >= 1`. -/
theorem legacyRootExpLaw_does_not_imply_allIndexLaw :
    ¬ (∀ (a : ℕ → ℝ) (C α : ℝ),
      QYM.RootExpLaw a C α → HasRootExponentialBound a C α) := by
  intro hinference
  exact
    initialSpikeSequence_not_hasRootExponentialBound 1 1
      (hinference
        (initialSpikeSequence 1 1) 1 1
        (initialSpikeSequence_has_legacyRootExpLaw zero_le_one))

/-! ## Proposition 4.27 to Corollary 4.28: uniform Weyl supplier transfer -/

/-- The pointwise indicator-majorant property needed in the printed proof of Corollary 4.28. -/
def IsUnitWindowMajorant (family : QYM.TestKernelTailCore.TestFamily) : Prop :=
  ∀ T : ℝ, 1 ≤ T → ∀ t : ℝ,
    QYM.TestKernelTailCore.InUnitWindow T t → 1 ≤ family T t

/-- A single finite positive Weyl constant, uniform in the admissible parameter and `T >= 1`.
The parameter type may represent one fixed compact subset of the admissible `q`-regime. -/
def HasUniformSmoothedWeylBound
    {Parameter Index : Type*} (admissible : Parameter → Prop)
    (family : QYM.TestKernelTailCore.TestFamily)
    (spectral : Parameter → Index → ℝ) : Prop :=
  ∃ C : ℝ≥0∞, 0 < C ∧ C < ∞ ∧
    ∀ q : Parameter, admissible q → ∀ T : ℝ, 1 ≤ T →
      QYM.TestKernelTailCore.SmoothedCount family (spectral q) T ≤
        C * ENNReal.ofReal (1 + T)

/-- Uniform window-density conclusion with the same explicit constant and parameter domain. -/
def HasUniformWindowCountBound
    {Parameter Index : Type*} (admissible : Parameter → Prop)
    (spectral : Parameter → Index → ℝ) : Prop :=
  ∃ C : ℝ≥0∞, 0 < C ∧ C < ∞ ∧
    ∀ q : Parameter, admissible q → ∀ T : ℝ, 1 ≤ T →
      QYM.TestKernelTailCore.WindowCount (spectral q) T ≤
        C * ENNReal.ofReal (1 + T)

/-- The exact Weyl-to-window logical step: both the Weyl estimate and the lower majorant on the
unit window are suppliers, and the same constant is retained. -/
theorem uniformWindowCount_of_uniformSmoothedWeylBound
    {Parameter Index : Type*} {admissible : Parameter → Prop}
    {family : QYM.TestKernelTailCore.TestFamily}
    {spectral : Parameter → Index → ℝ}
    (hmajorant : IsUnitWindowMajorant family)
    (hweyl : HasUniformSmoothedWeylBound admissible family spectral) :
    HasUniformWindowCountBound admissible spectral := by
  rcases hweyl with ⟨C, hCpos, hCfinite, hbound⟩
  refine ⟨C, hCpos, hCfinite, ?_⟩
  intro q hq T hT
  exact
    QYM.TestKernelTailCore.windowCount_le_of_smoothedCount_bound
      (fun i hi => hmajorant T hT (spectral q i) hi)
      (hbound q hq T hT)

/-! ## Pointwise constants do not create parameter-uniform constants -/

/-- Nonnegativity of an abstract scalar counting profile. -/
def IsNonnegativeLinearProfile (profile : ℕ → ℝ → ℝ) : Prop :=
  ∀ q : ℕ, ∀ T : ℝ, 0 ≤ profile q T

/-- A linear-in-`T` bound with a constant allowed to depend on the parameter `q`. -/
def HasPointwiseLinearParameterBound (profile : ℕ → ℝ → ℝ) : Prop :=
  ∀ q : ℕ, ∃ C : ℝ, 0 < C ∧
    ∀ T : ℝ, 1 ≤ T → profile q T ≤ C * (1 + T)

/-- A linear-in-`T` bound with one constant for all parameters. -/
def HasUniformLinearParameterBound (profile : ℕ → ℝ → ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧
    ∀ q : ℕ, ∀ T : ℝ, 1 ≤ T → profile q T ≤ C * (1 + T)

/-- A nonnegative profile whose height drifts with the parameter. -/
def driftingLinearProfile (q : ℕ) (_T : ℝ) : ℝ :=
  q

theorem driftingLinearProfile_nonnegative :
    IsNonnegativeLinearProfile driftingLinearProfile := by
  intro q T
  exact Nat.cast_nonneg q

/-- Every fixed parameter admits a positive linear-bound constant. -/
theorem driftingLinearProfile_hasPointwiseLinearParameterBound :
    HasPointwiseLinearParameterBound driftingLinearProfile := by
  intro q
  have hq : (0 : ℝ) ≤ (q : ℝ) := Nat.cast_nonneg q
  refine ⟨(q : ℝ) + 1, by linarith, ?_⟩
  intro T hT
  have hTnonneg : (0 : ℝ) ≤ T := le_trans zero_le_one hT
  have hqT : (0 : ℝ) ≤ (q : ℝ) * T := mul_nonneg hq hTnonneg
  dsimp [driftingLinearProfile]
  nlinarith

/-- No single real constant bounds the drifting profile uniformly in the parameter. -/
theorem driftingLinearProfile_no_uniformLinearParameterBound :
    ¬ HasUniformLinearParameterBound driftingLinearProfile := by
  rintro ⟨C, _hC, hbound⟩
  obtain ⟨q, hq⟩ := exists_nat_gt (C * 2)
  have hqBound : (q : ℝ) ≤ C * 2 := by
    have hqBoundRaw := hbound q (1 : ℝ) (by norm_num)
    norm_num [driftingLinearProfile] at hqBoundRaw
    exact hqBoundRaw
  exact (not_lt_of_ge hqBound) hq

/-- Closed positive countermodel: nonnegative pointwise linear control coexists with failure of
parameter-uniform control. -/
theorem pointwiseLinearParameterBound_coexists_with_no_uniformBound :
    ∃ profile : ℕ → ℝ → ℝ,
      IsNonnegativeLinearProfile profile ∧
        HasPointwiseLinearParameterBound profile ∧
          ¬ HasUniformLinearParameterBound profile := by
  exact
    ⟨driftingLinearProfile,
      driftingLinearProfile_nonnegative,
      driftingLinearProfile_hasPointwiseLinearParameterBound,
      driftingLinearProfile_no_uniformLinearParameterBound⟩

/-- Pointwise-in-parameter linear estimates do not imply one uniform estimate, even for an
everywhere nonnegative profile. -/
theorem pointwiseLinearParameterBound_does_not_imply_uniformBound :
    ¬ (∀ profile : ℕ → ℝ → ℝ,
      IsNonnegativeLinearProfile profile →
        HasPointwiseLinearParameterBound profile →
          HasUniformLinearParameterBound profile) := by
  intro hinference
  exact
    driftingLinearProfile_no_uniformLinearParameterBound
      (hinference
        driftingLinearProfile
        driftingLinearProfile_nonnegative
        driftingLinearProfile_hasPointwiseLinearParameterBound)

end QYM.RootExpWeylLogicCore


/-!
# Paper-normalized root-exponential and Weyl logic

These closed propositions normalize the scalar content of Theorem 4.26 and the logical passage
from Proposition 4.27 to Corollary 4.28.  Every deep analytic input remains a displayed supplier:
no theorem below constructs the paper's coefficients, establishes a Rademacher expansion, verifies
Paper-I admissibility, or proves a Weyl estimate for the paper's operator.

The two countermodels have deliberately narrow conclusions.  The coefficient countermodel shows
that the current eventual `QYM.RootExpLaw` does not control the PDF's finite prefix.  The Weyl
countermodel shows that parameterwise constants do not produce one parameter-uniform constant.
Neither countermodel asserts that the actual mock coefficients or actual paper spectrum violate
the corrected supplier statements.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Theorem 4.26: supplier-conditional scalar consequences -/

/-- Given the PDF-strength all-index coefficient estimate, every coefficient lies in the exact
two-sided envelope and the weaker legacy eventual predicate follows. -/
def theorem4_26_exactAllIndexSupplierConsequenceStatement : Prop :=
  ∀ (a : ℕ → ℝ) (C α : ℝ),
    QYM.RootExpWeylLogicCore.HasRootExponentialBound a C α →
      (∀ n : ℕ, 1 ≤ n →
        -QYM.RootExpWeylLogicCore.rootExponentialEnvelope C α n ≤ a n ∧
          a n ≤ QYM.RootExpWeylLogicCore.rootExponentialEnvelope C α n) ∧
        QYM.RootExpLaw a C α

theorem theorem4_26_exactAllIndexSupplierConsequenceStatement_holds :
    theorem4_26_exactAllIndexSupplierConsequenceStatement := by
  intro a C α hbound
  constructor
  · intro n hn
    exact
      QYM.RootExpWeylLogicCore.coefficient_twoSided_of_rootExponentialBound
        hbound hn
  · exact
      QYM.RootExpWeylLogicCore.rootExponentialBound_implies_legacyRootExpLaw
        hbound

/-- The one-term asymptotic yields the stated all-index law only when its start index, error
constant, positivity, and finite-prefix estimates are all supplied. -/
def theorem4_26_oneTermAndPrefixSupplierStatement : Prop :=
  ∀ (a : ℕ → ℝ) (C₀ α D : ℝ) (N : ℕ),
    QYM.RootExpWeylLogicCore.HasOneTermRemainderFrom a C₀ α D N →
      0 < |C₀| + D →
        0 < α →
          (∀ n : ℕ, 1 ≤ n → n < N →
            |a n| ≤
              QYM.RootExpWeylLogicCore.rootExponentialEnvelope (|C₀| + D) α n) →
            QYM.RootExpWeylLogicCore.HasRootExponentialBound
              a (|C₀| + D) α

theorem theorem4_26_oneTermAndPrefixSupplierStatement_holds :
    theorem4_26_oneTermAndPrefixSupplierStatement := by
  intro a C₀ α D N hremainder hconstant hα hprefix
  exact
    QYM.RootExpWeylLogicCore.rootExponentialBound_of_oneTermRemainder_and_prefix
      hremainder hconstant hα hprefix

/-! ## Theorem 4.26: eventual/all-index no-go -/

/-- The overstrong inference that the current eventual predicate would imply the PDF's bound at
every index `n >= 1` with the same constants. -/
def theorem4_26_legacyEventualToAllIndexInferenceStatement : Prop :=
  ∀ (a : ℕ → ℝ) (C α : ℝ),
    QYM.RootExpLaw a C α →
      QYM.RootExpWeylLogicCore.HasRootExponentialBound a C α

theorem theorem4_26_legacyEventualToAllIndexInferenceStatement_refuted :
    ¬ theorem4_26_legacyEventualToAllIndexInferenceStatement :=
  QYM.RootExpWeylLogicCore.legacyRootExpLaw_does_not_imply_allIndexLaw

/-- Positive packaging of an eventually controlled sequence whose first coefficient violates the
same all-index envelope. -/
def theorem4_26_legacyEventualAllIndexCountermodelStatement : Prop :=
  ∃ (a : ℕ → ℝ) (C α : ℝ),
    0 < C ∧ 0 < α ∧ QYM.RootExpLaw a C α ∧
      ¬ QYM.RootExpWeylLogicCore.HasRootExponentialBound a C α

theorem theorem4_26_legacyEventualAllIndexCountermodelStatement_holds :
    theorem4_26_legacyEventualAllIndexCountermodelStatement :=
  QYM.RootExpWeylLogicCore.legacyRootExpLaw_coexists_with_failure_of_allIndexLaw

/-! ## Proposition 4.27 to Corollary 4.28: supplier-conditional transfer -/

/-- With a single uniform smoothed Weyl constant and an explicit unit-window majorant, the same
constant bounds the window count.  The parameter type can encode a fixed compact admissible
`q`-set; compactness itself is not invented by this statement. -/
def cor4_28_uniformWeylToWindowSupplierStatement : Prop :=
  ∀ (Parameter Index : Type)
      (admissible : Parameter → Prop)
      (family : QYM.TestKernelTailCore.TestFamily)
      (spectral : Parameter → Index → ℝ),
    QYM.RootExpWeylLogicCore.IsUnitWindowMajorant family →
      QYM.RootExpWeylLogicCore.HasUniformSmoothedWeylBound
          admissible family spectral →
        QYM.RootExpWeylLogicCore.HasUniformWindowCountBound
          admissible spectral

theorem cor4_28_uniformWeylToWindowSupplierStatement_holds :
    cor4_28_uniformWeylToWindowSupplierStatement := by
  intro Parameter Index admissible family spectral hmajorant hweyl
  exact
    QYM.RootExpWeylLogicCore.uniformWindowCount_of_uniformSmoothedWeylBound
      hmajorant hweyl

/-! ## Proposition 4.27: pointwise-to-uniform no-go -/

/-- The bare inference from nonnegative parameterwise linear bounds to one uniform linear bound. -/
def prop4_27_pointwiseToUniformLinearInferenceStatement : Prop :=
  ∀ profile : ℕ → ℝ → ℝ,
    QYM.RootExpWeylLogicCore.IsNonnegativeLinearProfile profile →
      QYM.RootExpWeylLogicCore.HasPointwiseLinearParameterBound profile →
        QYM.RootExpWeylLogicCore.HasUniformLinearParameterBound profile

theorem prop4_27_pointwiseToUniformLinearInferenceStatement_refuted :
    ¬ prop4_27_pointwiseToUniformLinearInferenceStatement :=
  QYM.RootExpWeylLogicCore.pointwiseLinearParameterBound_does_not_imply_uniformBound

/-- Positive scalar countermodel to the pointwise-to-uniform quantifier exchange. -/
def prop4_27_pointwiseUniformLinearCountermodelStatement : Prop :=
  ∃ profile : ℕ → ℝ → ℝ,
    QYM.RootExpWeylLogicCore.IsNonnegativeLinearProfile profile ∧
      QYM.RootExpWeylLogicCore.HasPointwiseLinearParameterBound profile ∧
        ¬ QYM.RootExpWeylLogicCore.HasUniformLinearParameterBound profile

theorem prop4_27_pointwiseUniformLinearCountermodelStatement_holds :
    prop4_27_pointwiseUniformLinearCountermodelStatement :=
  QYM.RootExpWeylLogicCore.pointwiseLinearParameterBound_coexists_with_no_uniformBound

end QYM.FullCertification.PaperNormalized

/-!
# Locality, invariant-feature, admissibility, and structural-skew cores

This module supplies small unconditional logical cores for Proposition 2.2, Lemma 3.3,
Definitions 3.1 and 4.1, Axiom A3.T, and Corollary 4.7.  Every geometric object is explicit data:
restriction maps, global and local operations, actions, constraints, updates, pairings, and brackets.

No sheaf of Sobolev connections, gauge quotient, trace integral, or paper-specific field algebra is
constructed here.  The theorems identify the exact compatibility hypotheses under which the
printed logical steps are valid, and the concrete countermodels show that equivariance or pairing
symmetry alone cannot replace the missing scalar-invariance or ad-invariance hypotheses.
-/

namespace QYM.LocalityCore

/-! ## A compositional restriction-compatibility predicate -/

/-- A global operation and a local operation commute with the displayed restriction maps. -/
def CommutesWithRestriction
    {X Xloc Y Yloc : Type*}
    (restrictX : X → Xloc) (restrictY : Y → Yloc)
    (globalOp : X → Y) (localOp : Xloc → Yloc) : Prop :=
  ∀ x : X, restrictY (globalOp x) = localOp (restrictX x)

theorem commutesWithRestriction_iff
    {X Xloc Y Yloc : Type*}
    (restrictX : X → Xloc) (restrictY : Y → Yloc)
    (globalOp : X → Y) (localOp : Xloc → Yloc) :
    CommutesWithRestriction restrictX restrictY globalOp localOp ↔
      ∀ x : X, restrictY (globalOp x) = localOp (restrictX x) :=
  Iff.rfl

theorem identity_commutesWithRestriction {X Xloc : Type*}
    (restrictX : X → Xloc) :
    CommutesWithRestriction restrictX restrictX id id := by
  intro x
  rfl

/-- Restriction compatibility is closed under composition. -/
theorem comp_commutesWithRestriction
    {X Xloc Y Yloc Z Zloc : Type*}
    {restrictX : X → Xloc} {restrictY : Y → Yloc} {restrictZ : Z → Zloc}
    {globalF : X → Y} {localF : Xloc → Yloc}
    {globalG : Y → Z} {localG : Yloc → Zloc}
    (hF : CommutesWithRestriction restrictX restrictY globalF localF)
    (hG : CommutesWithRestriction restrictY restrictZ globalG localG) :
    CommutesWithRestriction restrictX restrictZ
      (fun x => globalG (globalF x)) (fun x => localG (localF x)) := by
  intro x
  rw [hG, hF]

/-- Restriction compatibility passes through a binary operation when that operation itself
commutes with restriction. -/
theorem binary_commutesWithRestriction
    {X Xloc Y Yloc Z Zloc : Type*}
    {restrictX : X → Xloc} {restrictY : Y → Yloc} {restrictZ : Z → Zloc}
    {globalF globalG : X → Y} {localF localG : Xloc → Yloc}
    {globalOp : Y → Y → Z} {localOp : Yloc → Yloc → Zloc}
    (hF : CommutesWithRestriction restrictX restrictY globalF localF)
    (hG : CommutesWithRestriction restrictX restrictY globalG localG)
    (hOp : ∀ y₁ y₂ : Y,
      restrictZ (globalOp y₁ y₂) =
        localOp (restrictY y₁) (restrictY y₂)) :
    CommutesWithRestriction restrictX restrictZ
      (fun x => globalOp (globalF x) (globalG x))
      (fun x => localOp (localF x) (localG x)) := by
  intro x
  rw [hOp, hF, hG]

/-- Exact locality theorem for an abstract curvature `dA + A∧A`.  Locality is derived from the
displayed locality of `d`, `∧`, and addition rather than stored as a field. -/
theorem curvature_commutesWithRestriction
    {Connection LocalConnection Form LocalForm : Type*}
    {restrictConnection : Connection → LocalConnection}
    {restrictForm : Form → LocalForm}
    {dGlobal : Connection → Form} {dLocal : LocalConnection → LocalForm}
    {wedgeGlobal : Connection → Connection → Form}
    {wedgeLocal : LocalConnection → LocalConnection → LocalForm}
    {addGlobal : Form → Form → Form} {addLocal : LocalForm → LocalForm → LocalForm}
    (hd : CommutesWithRestriction
      restrictConnection restrictForm dGlobal dLocal)
    (hwedge : ∀ A B : Connection,
      restrictForm (wedgeGlobal A B) =
        wedgeLocal (restrictConnection A) (restrictConnection B))
    (hadd : ∀ u v : Form,
      restrictForm (addGlobal u v) =
        addLocal (restrictForm u) (restrictForm v)) :
    CommutesWithRestriction restrictConnection restrictForm
      (fun A => addGlobal (dGlobal A) (wedgeGlobal A A))
      (fun A => addLocal (dLocal A) (wedgeLocal A A)) := by
  intro A
  rw [hadd, hd, hwedge]

end QYM.LocalityCore

namespace QYM.InvariantFeatureCore

/-! ## Equivariant features and invariant scalar functionals -/

/-- Equivariance of a feature between two explicitly displayed actions. -/
def Equivariant
    {G X Y : Type*} (actX : G → X → X) (actY : G → Y → Y)
    (feature : X → Y) : Prop :=
  ∀ g x, feature (actX g x) = actY g (feature x)

/-- Invariance of a scalar functional under an explicitly displayed action. -/
def InvariantUnder
    {G X R : Type*} (actX : G → X → X) (functional : X → R) : Prop :=
  ∀ g x, functional (actX g x) = functional x

/-- An equivariant feature followed by an invariant scalar functional is invariant. -/
theorem invariant_comp_of_equivariant
    {G X Y R : Type*}
    {actX : G → X → X} {actY : G → Y → Y}
    {feature : X → Y} {energy : Y → R}
    (hfeature : Equivariant actX actY feature)
    (henergy : InvariantUnder actY energy) :
    InvariantUnder actX (fun x => energy (feature x)) := by
  intro g x
  change energy (feature (actX g x)) = energy (feature x)
  rw [hfeature, henergy]

/-- A finite sum of two invariant scalar functionals remains invariant. -/
theorem invariant_add
    {G X R : Type*} [Add R]
    {actX : G → X → X} {left right : X → R}
    (hleft : InvariantUnder actX left)
    (hright : InvariantUnder actX right) :
    InvariantUnder actX (fun x => left x + right x) := by
  intro g x
  change left (actX g x) + right (actX g x) = left x + right x
  rw [hleft, hright]

/-! ## Equivariance alone is not scalar invariance -/

def boolPermAction (g : Equiv.Perm Bool) (x : Bool) : Bool :=
  g x

def identityBoolFeature (x : Bool) : Bool :=
  x

def boolEnergy (x : Bool) : ℝ :=
  if x then 1 else 0

theorem identityBoolFeature_equivariant :
    Equivariant boolPermAction boolPermAction identityBoolFeature := by
  intro g x
  rfl

theorem boolEnergy_not_invariantUnder_permutations :
    ¬ InvariantUnder boolPermAction boolEnergy := by
  intro h
  have hfalse := h (Equiv.swap false true) false
  norm_num [boolPermAction, boolEnergy, Equiv.swap_apply_left] at hfalse

/-- Concrete no-go for Axiom A3.T's informal inference: covariance of the underlying feature does
not force an arbitrary scalar extractor to be invariant. -/
theorem equivariant_feature_does_not_force_arbitrary_scalar_invariance :
    Equivariant boolPermAction boolPermAction identityBoolFeature ∧
      ¬ InvariantUnder boolPermAction
        (fun x => boolEnergy (identityBoolFeature x)) := by
  exact
    ⟨identityBoolFeature_equivariant,
      boolEnergy_not_invariantUnder_permutations⟩

end QYM.InvariantFeatureCore

namespace QYM.AdmissibilityCore

/-! ## Explicit constraints and admissible variations -/

/-- The subtype of states satisfying an explicitly supplied admissibility constraint. -/
abbrev Admissible (State : Type*) (constraint : State → Prop) :=
  {state : State // constraint state}

theorem admissible_nonempty_iff
    {State : Type*} {constraint : State → Prop} :
    Nonempty (Admissible State constraint) ↔ ∃ state : State, constraint state := by
  constructor
  · rintro ⟨state⟩
    exact ⟨state, state.property⟩
  · rintro ⟨state, hstate⟩
    exact ⟨⟨state, hstate⟩⟩

/-- A variation is admissible when its base state and tangent constraint are valid and the
explicit update remains in the constraint for every displayed scalar parameter. -/
def IsAdmissibleVariation
    {State Variation : Type*}
    (stateConstraint : State → Prop)
    (tangentConstraint : State → Variation → Prop)
    (update : State → ℝ → Variation → State)
    (state : State) (variation : Variation) : Prop :=
  stateConstraint state ∧
    tangentConstraint state variation ∧
      ∀ t : ℝ, stateConstraint (update state t variation)

theorem admissibleVariation_base
    {State Variation : Type*}
    {stateConstraint : State → Prop}
    {tangentConstraint : State → Variation → Prop}
    {update : State → ℝ → Variation → State}
    {state : State} {variation : Variation}
    (h : IsAdmissibleVariation
      stateConstraint tangentConstraint update state variation) :
    stateConstraint state :=
  h.1

theorem admissibleVariation_tangent
    {State Variation : Type*}
    {stateConstraint : State → Prop}
    {tangentConstraint : State → Variation → Prop}
    {update : State → ℝ → Variation → State}
    {state : State} {variation : Variation}
    (h : IsAdmissibleVariation
      stateConstraint tangentConstraint update state variation) :
    tangentConstraint state variation :=
  h.2.1

theorem admissibleVariation_update
    {State Variation : Type*}
    {stateConstraint : State → Prop}
    {tangentConstraint : State → Variation → Prop}
    {update : State → ℝ → Variation → State}
    {state : State} {variation : Variation}
    (h : IsAdmissibleVariation
      stateConstraint tangentConstraint update state variation)
    (t : ℝ) :
    stateConstraint (update state t variation) :=
  h.2.2 t

/-- The zero variation is admissible when zero is tangent and the supplied update fixes the base
state.  No gauge or Sobolev closure assertion is hidden. -/
theorem zero_isAdmissibleVariation
    {State Variation : Type*} [Zero Variation]
    {stateConstraint : State → Prop}
    {tangentConstraint : State → Variation → Prop}
    {update : State → ℝ → Variation → State}
    {state : State}
    (hstate : stateConstraint state)
    (htangent : tangentConstraint state 0)
    (hupdate : ∀ t : ℝ, update state t 0 = state) :
    IsAdmissibleVariation
      stateConstraint tangentConstraint update state 0 := by
  refine ⟨hstate, htangent, ?_⟩
  intro t
  rw [hupdate]
  exact hstate

/-- Intersecting two state and tangent constraints preserves admissible variations when the same
update preserves both constraints. -/
theorem admissibleVariation_and
    {State Variation : Type*}
    {stateConstraint₁ stateConstraint₂ : State → Prop}
    {tangentConstraint₁ tangentConstraint₂ : State → Variation → Prop}
    {update : State → ℝ → Variation → State}
    {state : State} {variation : Variation}
    (h₁ : IsAdmissibleVariation
      stateConstraint₁ tangentConstraint₁ update state variation)
    (h₂ : IsAdmissibleVariation
      stateConstraint₂ tangentConstraint₂ update state variation) :
    IsAdmissibleVariation
      (fun x => stateConstraint₁ x ∧ stateConstraint₂ x)
      (fun x v => tangentConstraint₁ x v ∧ tangentConstraint₂ x v)
      update state variation := by
  refine ⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2.1, h₂.2.1⟩, ?_⟩
  intro t
  exact ⟨h₁.2.2 t, h₂.2.2 t⟩

end QYM.AdmissibilityCore

namespace QYM.StructuralSkewCore

/-! ## Correct structural skewness from symmetric pairing and ad-invariance -/

/-- Symmetry of an explicitly supplied pairing. -/
def IsSymmetricPairing
    {L R : Type*} [Neg R] (pairing : L → L → R) : Prop :=
  ∀ x y, pairing x y = pairing y x

/-- The exact ad-invariance identity needed for structural skewness. -/
def IsAdInvariant
    {L R : Type*} [Neg R]
    (bracket : L → L → L) (pairing : L → L → R) : Prop :=
  ∀ x y z, pairing (bracket x y) z = -pairing y (bracket x z)

/-- Structural coefficient in an arbitrary displayed family. -/
def structureCoefficient
    {Index L R : Type*}
    (basis : Index → L) (bracket : L → L → L)
    (pairing : L → L → R) (i j k : Index) : R :=
  pairing (bracket (basis i) (basis j)) (basis k)

theorem structureCoefficient_skew_last_of_adInvariant
    {Index L R : Type*} [Neg R]
    {basis : Index → L} {bracket : L → L → L}
    {pairing : L → L → R}
    (hsymmetric : IsSymmetricPairing pairing)
    (hadInvariant : IsAdInvariant bracket pairing)
    (i j k : Index) :
    structureCoefficient basis bracket pairing i j k =
      -structureCoefficient basis bracket pairing i k j := by
  unfold structureCoefficient
  calc
    pairing (bracket (basis i) (basis j)) (basis k) =
        -pairing (basis j) (bracket (basis i) (basis k)) :=
      hadInvariant (basis i) (basis j) (basis k)
    _ = -pairing (bracket (basis i) (basis k)) (basis j) :=
      congrArg (fun value : R => -value)
        (hsymmetric (basis j) (bracket (basis i) (basis k)))

/-! ## A concrete antisymmetric bracket where pairing symmetry is insufficient -/

abbrev Plane := ℝ × ℝ

def planeBracket (x y : Plane) : Plane :=
  (0, x.1 * y.2 - y.1 * x.2)

def planePairing (x y : Plane) : ℝ :=
  x.1 * y.1 + x.2 * y.2

def planeBasis : Bool → Plane
  | false => (1, 0)
  | true => (0, 1)

theorem planeBracket_antisymmetric (x y : Plane) :
    planeBracket x y = -planeBracket y x := by
  apply Prod.ext
  · simp [planeBracket]
  · change x.1 * y.2 - y.1 * x.2 =
      -(y.1 * x.2 - x.1 * y.2)
    ring

theorem planePairing_symmetric :
    IsSymmetricPairing planePairing := by
  intro x y
  unfold planePairing
  ring

theorem planeBracket_pairing_not_adInvariant :
    ¬ IsAdInvariant planeBracket planePairing := by
  intro h
  have hbad := h (planeBasis false) (planeBasis true) (planeBasis true)
  norm_num [planeBasis, planeBracket, planePairing] at hbad

/-- Even an antisymmetric bracket and a symmetric pairing do not force the structural coefficient
skewness used in Corollary 4.7; ad-invariance is the missing hypothesis. -/
theorem plane_structureCoefficient_not_skew_last :
    ¬ ∀ i j k : Bool,
      structureCoefficient planeBasis planeBracket planePairing i j k =
        -structureCoefficient planeBasis planeBracket planePairing i k j := by
  intro h
  have hbad := h false true true
  norm_num [structureCoefficient, planeBasis, planeBracket, planePairing] at hbad

end QYM.StructuralSkewCore


/-!
# Mass coercivity, relative absorption, form domination, and truncation uniformity

This module isolates the scalar logic used by Axioms A3.M/A3.V/A3.R, Hypotheses 4.20/4.22/4.24,
and their Appendix aliases.  It proves the valid implications from explicit quantitative bounds and
gives concrete countermodels to attempts to infer strict or uniform constants from nonnegativity,
pointwise finiteness, or pointwise positivity alone.

No paper-specific mass functional, Hessian, transform tail, Mosco convergence, or resolvent
convergence is constructed.  Those remain supplier obligations rather than hidden fields.
-/

namespace QYM.MassAbsorptionTruncationCore

/-! ## Strict coercivity on an explicit admissible predicate -/

/-- Strict coercivity of `energy` against `size` on the explicitly supplied predicate. -/
def CoerciveOn
    {State : Type*} (admissible : State → Prop)
    (energy size : State → ℝ) (constant : ℝ) : Prop :=
  0 < constant ∧
    ∀ state : State, admissible state →
      constant * size state ≤ energy state

theorem coerciveOn_constant_pos
    {State : Type*} {admissible : State → Prop}
    {energy size : State → ℝ} {constant : ℝ}
    (h : CoerciveOn admissible energy size constant) :
    0 < constant :=
  h.1

theorem coerciveOn_bound
    {State : Type*} {admissible : State → Prop}
    {energy size : State → ℝ} {constant : ℝ}
    (h : CoerciveOn admissible energy size constant)
    {state : State} (hstate : admissible state) :
    constant * size state ≤ energy state :=
  h.2 state hstate

theorem coerciveOn_weaken_constant
    {State : Type*} {admissible : State → Prop}
    {energy size : State → ℝ} {constant smaller : ℝ}
    (h : CoerciveOn admissible energy size constant)
    (hsmaller : 0 < smaller) (hle : smaller ≤ constant)
    (hsize : ∀ state, admissible state → 0 ≤ size state) :
    CoerciveOn admissible energy size smaller := by
  refine ⟨hsmaller, ?_⟩
  intro state hstate
  exact
    (mul_le_mul_of_nonneg_right hle (hsize state hstate)).trans
      (h.2 state hstate)

/-- Zero mass is nonnegative but cannot be strictly coercive against the square size on `ℝ`. -/
theorem zeroEnergy_not_coerciveOn_square (constant : ℝ) :
    ¬ CoerciveOn (fun _ : ℝ => True)
      (fun _ => 0) (fun x => x ^ 2) constant := by
  intro h
  have hbound := h.2 1 trivial
  norm_num at hbound
  linarith [h.1]

/-- Nonnegativity alone does not produce an existential positive coercivity constant. -/
theorem nonnegative_does_not_imply_strictCoercivity :
    ¬ ∀ (energy size : ℝ → ℝ),
      (∀ x, 0 ≤ energy x) →
      (∀ x, 0 ≤ size x) →
        ∃ constant : ℝ,
          CoerciveOn (fun _ : ℝ => True) energy size constant := by
  intro hinference
  obtain ⟨constant, hconstant⟩ :=
    hinference (fun _ => 0) (fun x => x ^ 2)
      (by intro x; norm_num)
      (by intro x; positivity)
  exact zeroEnergy_not_coerciveOn_square constant hconstant

/-! ## Relative absorption -/

/-- A two-control absolute relative bound with every coefficient displayed. -/
def AbsorbableBy
    {State : Type*} (control remainder correction : State → ℝ)
    (a b : ℝ) : Prop :=
  ∀ state : State,
    |correction state| ≤ a * control state + b * remainder state

/-- Exact lower-bound arithmetic for one relatively absorbable correction. -/
theorem control_add_correction_lower_bound
    {State : Type*} {control remainder correction : State → ℝ}
    {a b : ℝ} (h : AbsorbableBy control remainder correction a b)
    (state : State) :
    (1 - a) * control state - b * remainder state ≤
      control state + correction state := by
  have hneg : -correction state ≤ |correction state| := neg_le_abs _
  have hbound := h state
  linarith

/-- Relative bounds add with the sums of their displayed coefficients. -/
theorem absorbableBy_add
    {State : Type*}
    {control remainder correction₁ correction₂ : State → ℝ}
    {a₁ b₁ a₂ b₂ : ℝ}
    (h₁ : AbsorbableBy control remainder correction₁ a₁ b₁)
    (h₂ : AbsorbableBy control remainder correction₂ a₂ b₂) :
    AbsorbableBy control remainder
      (fun state => correction₁ state + correction₂ state)
      (a₁ + a₂) (b₁ + b₂) := by
  intro state
  calc
    |correction₁ state + correction₂ state| ≤
        |correction₁ state| + |correction₂ state| := abs_add_le _ _
    _ ≤ (a₁ * control state + b₁ * remainder state) +
        (a₂ * control state + b₂ * remainder state) :=
      add_le_add (h₁ state) (h₂ state)
    _ = (a₁ + a₂) * control state +
        (b₁ + b₂) * remainder state := by ring

def growingCorrection (n : ℕ) : ℝ :=
  n

theorem growingCorrection_pointwise_bounded (n : ℕ) :
    ∃ bound : ℝ, |growingCorrection n| ≤ bound :=
  ⟨|growingCorrection n|, le_rfl⟩

/-- Pointwise existence of a finite bound does not supply coefficients uniform in the state. -/
theorem growingCorrection_not_uniformlyAbsorbable :
    ¬ ∃ a b : ℝ,
      AbsorbableBy (fun _ : ℕ => 1) (fun _ : ℕ => 0)
        growingCorrection a b := by
  rintro ⟨a, b, hbound⟩
  obtain ⟨n, hn⟩ := exists_nat_gt a
  have h := hbound n
  simp [growingCorrection] at h
  exact (not_lt_of_ge h) hn

/-- The universal pointwise-to-uniform absorption inference is false. -/
theorem pointwise_bounds_do_not_imply_uniformAbsorption :
    ¬ ∀ correction : ℕ → ℝ,
      (∀ n, ∃ bound : ℝ, |correction n| ≤ bound) →
        ∃ a b : ℝ,
          AbsorbableBy (fun _ : ℕ => 1) (fun _ : ℕ => 0)
            correction a b := by
  intro hinference
  exact growingCorrection_not_uniformlyAbsorbable
    (hinference growingCorrection growingCorrection_pointwise_bounded)

/-! ## Form domination -/

/-- Pointwise domination with an explicit scalar coefficient. -/
def Dominates
    {State : Type*} (upper lower : State → ℝ) (constant : ℝ) : Prop :=
  ∀ state : State, constant * lower state ≤ upper state

theorem dominates_trans
    {State : Type*} {upper middle lower : State → ℝ}
    {c d : ℝ} (hc : 0 ≤ c)
    (hupper : Dominates upper middle c)
    (hmiddle : Dominates middle lower d) :
    Dominates upper lower (c * d) := by
  intro state
  calc
    (c * d) * lower state = c * (d * lower state) := by ring
    _ ≤ c * middle state :=
      mul_le_mul_of_nonneg_left (hmiddle state) hc
    _ ≤ upper state := hupper state

theorem zeroForm_not_positiveDominates_square (constant : ℝ) (hconstant : 0 < constant) :
    ¬ Dominates (fun _ : ℝ => 0) (fun x => x ^ 2) constant := by
  intro h
  have hbad := h 1
  norm_num at hbad
  linarith

/-- Separate nonnegativity of two forms does not produce a positive domination coefficient. -/
theorem nonnegative_forms_do_not_imply_positiveDomination :
    ¬ ∀ (upper lower : ℝ → ℝ),
      (∀ x, 0 ≤ upper x) →
      (∀ x, 0 ≤ lower x) →
        ∃ constant : ℝ, 0 < constant ∧ Dominates upper lower constant := by
  intro hinference
  obtain ⟨constant, hconstant, hdomination⟩ :=
    hinference (fun _ => 0) (fun x => x ^ 2)
      (by intro x; norm_num)
      (by intro x; positivity)
  exact zeroForm_not_positiveDominates_square constant hconstant hdomination

/-! ## Pointwise versus uniform truncation positivity -/

def PointwisePositive (constant : ℕ → ℝ) : Prop :=
  ∀ n : ℕ, 0 < constant n

def UniformlyPositive (constant : ℕ → ℝ) : Prop :=
  ∃ lower : ℝ, 0 < lower ∧ ∀ n : ℕ, lower ≤ constant n

def reciprocalTruncationConstant (n : ℕ) : ℝ :=
  1 / (n + 1 : ℝ)

theorem reciprocalTruncationConstant_pos :
    PointwisePositive reciprocalTruncationConstant := by
  intro n
  unfold reciprocalTruncationConstant
  positivity

theorem reciprocalTruncationConstant_not_uniformlyPositive :
    ¬ UniformlyPositive reciprocalTruncationConstant := by
  rintro ⟨lower, hlower, hbound⟩
  obtain ⟨n, hn⟩ : ∃ n : ℕ, 1 / (n + 1 : ℝ) < lower :=
    exists_nat_one_div_lt hlower
  exact (not_lt_of_ge (hbound n)) hn

/-- Positivity at every finite truncation does not imply one positive constant uniform in the
truncation parameter. -/
theorem pointwisePositive_does_not_imply_uniformlyPositive :
    ¬ ∀ constant : ℕ → ℝ,
      PointwisePositive constant → UniformlyPositive constant := by
  intro hinference
  exact reciprocalTruncationConstant_not_uniformlyPositive
    (hinference reciprocalTruncationConstant reciprocalTruncationConstant_pos)

end QYM.MassAbsorptionTruncationCore


/-!
# Paper-normalized locality, invariance, admissibility, and structural skewness

The statements in this file attach the exact abstract cores to Proposition 2.2, Axiom A3.T,
Lemma 3.3, Definitions 3.1 and 4.1, and Corollary 4.7.  They are closed propositions with all
restriction maps, actions, constraints, updates, brackets, and pairings quantified explicitly.

They do not construct the paper's sheaf, Sobolev gauge slice, scalar trace integral, or field
algebra.  In particular, the refutations target only the overstrong inferences that equivariance
alone forces scalar invariance or that bracket antisymmetry plus pairing symmetry forces the
structural skew identity.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Proposition 2.2: abstract curvature locality -/

def prop2_2_abstractCurvatureLocalityStatement : Prop :=
  ∀ (Connection LocalConnection Form LocalForm : Type)
      (restrictConnection : Connection → LocalConnection)
      (restrictForm : Form → LocalForm)
      (dGlobal : Connection → Form) (dLocal : LocalConnection → LocalForm)
      (wedgeGlobal : Connection → Connection → Form)
      (wedgeLocal : LocalConnection → LocalConnection → LocalForm)
      (addGlobal : Form → Form → Form)
      (addLocal : LocalForm → LocalForm → LocalForm),
    QYM.LocalityCore.CommutesWithRestriction
        restrictConnection restrictForm dGlobal dLocal →
    (∀ A B : Connection,
      restrictForm (wedgeGlobal A B) =
        wedgeLocal (restrictConnection A) (restrictConnection B)) →
    (∀ u v : Form,
      restrictForm (addGlobal u v) =
        addLocal (restrictForm u) (restrictForm v)) →
    QYM.LocalityCore.CommutesWithRestriction restrictConnection restrictForm
      (fun A => addGlobal (dGlobal A) (wedgeGlobal A A))
      (fun A => addLocal (dLocal A) (wedgeLocal A A))

theorem prop2_2_abstractCurvatureLocalityStatement_holds :
    prop2_2_abstractCurvatureLocalityStatement := by
  intro Connection LocalConnection Form LocalForm
