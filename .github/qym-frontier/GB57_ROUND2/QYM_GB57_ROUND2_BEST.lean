@[simp]
theorem actualStageSectorDiscriminantPotentialOperator_ofBackgroundHolonomy
    (phase : QYM.FullCertification.P1NotationFirewall.UnitaryHolonomy) (Y : ℝ) :
    actualStageSectorDiscriminantPotentialOperator
      (QYM.FullCertification.P1NotationFirewall.QSector.ofBackgroundHolonomy phase) Y = 0 := by
  rw [actualStageSectorDiscriminantPotentialOperator,
    QYM.FullCertification.P1AdmissibleBackgroundExtension.sectorPotentialCoefficient_ofBackgroundHolonomy]
  exact zero_smul ℂ _

/-! ## 6. Conjunction certificates -/

/-- A compact theorem collecting the unconditional analytic facts for the
uncoupled actual-stage multiplier. -/
theorem actualStageDiscriminantPotentialCertificate (Y : ℝ) :
    Continuous (actualStageDiscriminantPotential Y) ∧
      (∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, 0 < actualStageDiscriminantPotential Y x) ∧
      (∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y,
        actualStageDiscriminantPotential Y x ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) ∧
      ‖actualStageDiscriminantPotentialOperator Y‖ ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound ∧
      (∀ u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
        inner ℂ (actualStageDiscriminantPotentialOperator Y u) v =
          inner ℂ u (actualStageDiscriminantPotentialOperator Y v)) ∧
      (∀ u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
        0 ≤ (actualStageDiscriminantForm Y u u).re) := by
  exact
    ⟨actualStageDiscriminantPotential_continuous Y,
      actualStageDiscriminantPotential_pos Y,
      actualStageDiscriminantPotential_le_uniformBound Y,
      norm_actualStageDiscriminantPotentialOperator_le Y,
      actualStageDiscriminantPotentialOperator_inner_symmetric Y,
      actualStageDiscriminantForm_self_re_nonneg Y⟩

/-- The corresponding sector certificate is uniform over every physical
sector and uses no sign assumption on a real coupling. -/
theorem actualStageSectorDiscriminantPotentialCertificate
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    Continuous (actualStageSectorDiscriminantPotential sector Y) ∧
      (∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y,
        0 ≤ actualStageSectorDiscriminantPotential sector Y x) ∧
      (∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y,
        actualStageSectorDiscriminantPotential sector Y x ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound) ∧
      ‖actualStageSectorDiscriminantPotentialOperator sector Y‖ ≤
        Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound ∧
      (∀ u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
        inner ℂ
            (actualStageSectorDiscriminantPotentialOperator sector Y u) v =
          inner ℂ u
            (actualStageSectorDiscriminantPotentialOperator sector Y v)) ∧
      (∀ u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
        0 ≤ (actualStageSectorDiscriminantForm sector Y u u).re) := by
  exact
    ⟨actualStageSectorDiscriminantPotential_continuous sector Y,
      actualStageSectorDiscriminantPotential_nonneg sector Y,
      actualStageSectorDiscriminantPotential_le_uniformBound sector Y,
      norm_actualStageSectorDiscriminantPotentialOperator_le sector Y,
      actualStageSectorDiscriminantPotentialOperator_inner_symmetric sector Y,
      actualStageSectorDiscriminantForm_self_re_nonneg sector Y⟩

end QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension

