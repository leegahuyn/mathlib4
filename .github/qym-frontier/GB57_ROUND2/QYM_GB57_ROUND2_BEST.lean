open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhaseGraphCompletion








/-!
# A product-collar stored first-order trace model

The actual cusp collar is already an open product band, and `H` constructs
the genuine three-cusp fractional boundary Hilbert space.  What is still
absent from the dependency is a Bochner `H^1` theory on that collar together
with point evaluation at its central slice.  This file therefore does not
rename an arbitrary completion as a classical weak Sobolev space.

Instead, it constructs the following precise stored-energy model.  Its first
coordinate is the central `H^(1/2)` boundary profile.  Its second and third
coordinates are independent zero-trace value and radial-derivative energy
slots.  The `WithLp 2` norm is the exact Hilbert sum of these three slots.
The constant radial profile is represented by putting both zero-trace slots
equal to zero.  Consequently central trace has an explicit norm-preserving
right inverse, every vector has a canonical orthogonal profile/remainder
decomposition, and the profile-plus-zero-trace algebraic core is onto.

This model is deliberately called *stored first-order energy*: no theorem
identifies the derivative slot with the derivative of the value slot.  The
final section gives an exact equivalence isolating the estimate still needed
to extend the actual smooth trace from the pre-existing bulk graph
completion.
-/

/-! ## 1. The actual boundary coefficient and stored energy slots -/

/-- The genuine three-cusp fractional boundary Hilbert space already
constructed from the inverse-eta transition laws. -/
abbrev ActualFixedPhaseCollarBoundary
    (n : ℤ) (Y : ℝ) :=
  QYM.FullCertification.P2ClassicalHhalfTraceExtension.ActualFixedPhaseThreeCuspBoundaryHhalf n Y

/-- Two independent zero-trace first-order energy slots.  The first stores a
radial value fluctuation coefficient and the second stores a radial
derivative coefficient.  This is a coefficient model, not an equality
between a weak derivative and a supplied second coordinate. -/
abbrev ActualFixedPhaseCollarZeroTraceStoredEnergy
    (n : ℤ) (Y : ℝ) :=
  WithLp 2
    (ActualFixedPhaseCollarBoundary n Y ×
      ActualFixedPhaseCollarBoundary n Y)

/-- Exact Hilbert product used for the stored product-collar first-order
energy.  Coordinates are `(central trace, value fluctuation, derivative
fluctuation)`. -/
abbrev ActualFixedPhaseProductCollarStoredEnergy
    (n : ℤ) (Y : ℝ) :=
  WithLp 2
    (ActualFixedPhaseCollarBoundary n Y ×
      ActualFixedPhaseCollarZeroTraceStoredEnergy n Y)

/-- The stored product-collar carrier is a genuine complex Hilbert space by
the nested `WithLp 2` product construction. -/
noncomputable def actualFixedPhaseProductCollarStoredEnergyHilbertSpace
    (n : ℤ) (Y : ℝ) :
    HilbertSpace ℂ (ActualFixedPhaseProductCollarStoredEnergy n Y) :=
  ⟨⟩

set_option synthInstance.maxHeartbeats 100000 in
noncomputable local instance actualFixedPhaseCollarZeroTraceStoredEnergy_inner_inst
    (n : ℤ) (Y : ℝ) :
    InnerProductSpace ℂ (ActualFixedPhaseCollarZeroTraceStoredEnergy n Y) :=
  inferInstance

set_option synthInstance.maxHeartbeats 100000 in
noncomputable local instance actualFixedPhaseProductCollarStoredEnergy_normed_inst
    (n : ℤ) (Y : ℝ) :
    NormedSpace ℂ (ActualFixedPhaseProductCollarStoredEnergy n Y) :=
  inferInstance

set_option synthInstance.maxHeartbeats 100000 in
noncomputable local instance actualFixedPhaseProductCollarStoredEnergy_inner_inst
    (n : ℤ) (Y : ℝ) :
    InnerProductSpace ℂ (ActualFixedPhaseProductCollarStoredEnergy n Y) :=
  inferInstance

/-- Central boundary-coordinate projection. -/
noncomputable def actualFixedPhaseProductCollarCentralTrace
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarStoredEnergy n Y →L[ℂ]
      ActualFixedPhaseCollarBoundary n Y :=
  WithLp.fstL 2 ℂ
    (ActualFixedPhaseCollarBoundary n Y)
    (ActualFixedPhaseCollarZeroTraceStoredEnergy n Y)

/-- Projection to both zero-trace stored-energy slots. -/
noncomputable def actualFixedPhaseProductCollarZeroTraceEnergy
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarStoredEnergy n Y →L[ℂ]
      ActualFixedPhaseCollarZeroTraceStoredEnergy n Y :=
  WithLp.sndL 2 ℂ
    (ActualFixedPhaseCollarBoundary n Y)
    (ActualFixedPhaseCollarZeroTraceStoredEnergy n Y)

/-- Stored radial-value fluctuation coefficient. -/
noncomputable def actualFixedPhaseProductCollarValueFluctuation
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarStoredEnergy n Y →L[ℂ]
      ActualFixedPhaseCollarBoundary n Y :=
  (WithLp.fstL 2 ℂ
      (ActualFixedPhaseCollarBoundary n Y)
      (ActualFixedPhaseCollarBoundary n Y)).comp
    (actualFixedPhaseProductCollarZeroTraceEnergy n Y)

/-- Stored radial-derivative fluctuation coefficient. -/
noncomputable def actualFixedPhaseProductCollarDerivativeFluctuation
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarStoredEnergy n Y →L[ℂ]
      ActualFixedPhaseCollarBoundary n Y :=
  (WithLp.sndL 2 ℂ
      (ActualFixedPhaseCollarBoundary n Y)
      (ActualFixedPhaseCollarBoundary n Y)).comp
    (actualFixedPhaseProductCollarZeroTraceEnergy n Y)

@[simp]
theorem actualFixedPhaseProductCollarCentralTrace_apply
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    actualFixedPhaseProductCollarCentralTrace n Y x = x.fst := by
  rfl

@[simp]
theorem actualFixedPhaseProductCollarZeroTraceEnergy_apply
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    actualFixedPhaseProductCollarZeroTraceEnergy n Y x = x.snd := by
  rfl

@[simp]
theorem actualFixedPhaseProductCollarValueFluctuation_apply
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    actualFixedPhaseProductCollarValueFluctuation n Y x = x.snd.fst := by
  rfl

@[simp]
theorem actualFixedPhaseProductCollarDerivativeFluctuation_apply
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    actualFixedPhaseProductCollarDerivativeFluctuation n Y x = x.snd.snd := by
  rfl

/-! ## 2. Explicit constant-profile right inverse -/

/-- The normalized constant radial profile represented by a boundary
coefficient: both zero-trace fluctuation slots vanish. -/
noncomputable def actualFixedPhaseProductCollarProfileExtension
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCollarBoundary n Y →L[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y :=
  (WithLp.prodContinuousLinearEquiv 2 ℂ
      (ActualFixedPhaseCollarBoundary n Y)
      (ActualFixedPhaseCollarZeroTraceStoredEnergy n Y)).symm.toContinuousLinearMap.comp
    ((ContinuousLinearMap.id ℂ
        (ActualFixedPhaseCollarBoundary n Y)).prod
      (0 : ActualFixedPhaseCollarBoundary n Y →L[ℂ]
        ActualFixedPhaseCollarZeroTraceStoredEnergy n Y))

@[simp]
theorem actualFixedPhaseProductCollarProfileExtension_fst
    (n : ℤ) (Y : ℝ)
    (b : ActualFixedPhaseCollarBoundary n Y) :
    (actualFixedPhaseProductCollarProfileExtension n Y b).fst = b := by
  rfl

@[simp]
theorem actualFixedPhaseProductCollarProfileExtension_snd
    (n : ℤ) (Y : ℝ)
    (b : ActualFixedPhaseCollarBoundary n Y) :
    (actualFixedPhaseProductCollarProfileExtension n Y b).snd = 0 := by
  rfl

@[simp]
theorem actualFixedPhaseProductCollarCentralTrace_profileExtension
    (n : ℤ) (Y : ℝ)
    (b : ActualFixedPhaseCollarBoundary n Y) :
    actualFixedPhaseProductCollarCentralTrace n Y
        (actualFixedPhaseProductCollarProfileExtension n Y b) = b := by
  rfl

theorem actualFixedPhaseProductCollarProfileExtension_rightInverse
    (n : ℤ) (Y : ℝ) :
    Function.RightInverse
      (actualFixedPhaseProductCollarProfileExtension n Y)
      (actualFixedPhaseProductCollarCentralTrace n Y) :=
  actualFixedPhaseProductCollarCentralTrace_profileExtension n Y

theorem actualFixedPhaseProductCollarProfileExtension_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective
      (actualFixedPhaseProductCollarProfileExtension n Y) :=
  (actualFixedPhaseProductCollarProfileExtension_rightInverse n Y).injective

theorem actualFixedPhaseProductCollarCentralTrace_surjective
    (n : ℤ) (Y : ℝ) :
    Function.Surjective
      (actualFixedPhaseProductCollarCentralTrace n Y) := by
  intro b
  exact ⟨actualFixedPhaseProductCollarProfileExtension n Y b,
    actualFixedPhaseProductCollarCentralTrace_profileExtension n Y b⟩

/-- The profile extension is norm preserving in the stored-energy norm. -/
theorem actualFixedPhaseProductCollarProfileExtension_norm
    (n : ℤ) (Y : ℝ)
    (b : ActualFixedPhaseCollarBoundary n Y) :
    ‖actualFixedPhaseProductCollarProfileExtension n Y b‖ = ‖b‖ := by
  have hsq := WithLp.prod_norm_sq_eq_of_L2
    (actualFixedPhaseProductCollarProfileExtension n Y b)
  simp only [actualFixedPhaseProductCollarProfileExtension_fst,
    actualFixedPhaseProductCollarProfileExtension_snd, norm_zero,
    zero_pow, add_zero] at hsq
  nlinarith [norm_nonneg
    (actualFixedPhaseProductCollarProfileExtension n Y b), norm_nonneg b]

/-- Central trace is contractive. -/
theorem actualFixedPhaseProductCollarCentralTrace_norm_le
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    ‖actualFixedPhaseProductCollarCentralTrace n Y x‖ ≤ ‖x‖ := by
  change ‖x.fst‖ ≤ ‖x‖
  exact WithLp.norm_fst_le
    (ActualFixedPhaseCollarBoundary n Y) x

theorem actualFixedPhaseProductCollarCentralTrace_opNorm_le
    (n : ℤ) (Y : ℝ) :
    ‖actualFixedPhaseProductCollarCentralTrace n Y‖ ≤ 1 := by
  refine (actualFixedPhaseProductCollarCentralTrace n Y).opNorm_le_bound
    zero_le_one ?_
  intro x
  simpa only [one_mul] using
    actualFixedPhaseProductCollarCentralTrace_norm_le n Y x

theorem actualFixedPhaseProductCollarProfileExtension_opNorm_le
    (n : ℤ) (Y : ℝ) :
    ‖actualFixedPhaseProductCollarProfileExtension n Y‖ ≤ 1 := by
  refine (actualFixedPhaseProductCollarProfileExtension n Y).opNorm_le_bound
    zero_le_one ?_
  intro b
  rw [actualFixedPhaseProductCollarProfileExtension_norm]
  simp

/-! ## 3. The literal radial profile on the actual collar coordinate -/

/-- Boundary-Hilbert-valued constant radial profile.  Angular dependence is
already carried by the boundary Hilbert vector `b`; only the collar-height
coordinate is constant here. -/
def actualFixedPhaseConstantRadialProfile
    {n : ℤ} {Y : ℝ}
    (b : ActualFixedPhaseCollarBoundary n Y) :
    ℝ → ActualFixedPhaseCollarBoundary n Y :=
  fun _ => b

@[simp]
theorem actualFixedPhaseConstantRadialProfile_apply
    {n : ℤ} {Y h : ℝ}
    (b : ActualFixedPhaseCollarBoundary n Y) :
    actualFixedPhaseConstantRadialProfile b h = b := by
  rfl

theorem actualFixedPhaseConstantRadialProfile_continuous
    {n : ℤ} {Y : ℝ}
    (b : ActualFixedPhaseCollarBoundary n Y) :
    Continuous (actualFixedPhaseConstantRadialProfile b) :=
  continuous_const

theorem actualFixedPhaseConstantRadialProfile_hasFDerivAt
    {n : ℤ} {Y h : ℝ}
    (b : ActualFixedPhaseCollarBoundary n Y) :
    HasFDerivAt (actualFixedPhaseConstantRadialProfile b)
      (0 : ℝ →L[ℝ] ActualFixedPhaseCollarBoundary n Y) h := by
  exact hasFDerivAt_const b h

/-- The constant profile is evaluated on the actual central slice of the
radius-`1/2` collar, while the geometric collar chart sends the selected
cusp circle to that same slice. -/
theorem actualFixedPhaseProductCollar_geometricCenter
    (q : GammaTwoRightCoset) {n : ℤ} {Y : ℝ}
    (hY : 2 ≤ gammaTwoCuspLevel Y)
    (theta : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle)
    (b : ActualFixedPhaseCollarBoundary n Y) :
    QYM.FullCertification.P2CuspCollarClosureExtension.cuspCollarHomeomorph q hY
        (QYM.FullCertification.P2SmoothQuotientAtlasExtension.selectedCuspCircle q Y theta) =
      (theta, gammaTwoCuspLevel Y) ∧
    actualFixedPhaseConstantRadialProfile b
        (gammaTwoCuspLevel Y) = b := by
  exact ⟨QYM.FullCertification.P2CuspCollarClosureExtension.cuspCollarHomeomorph_selectedCuspCircle q hY theta, rfl⟩

/-! ## 4. Kernel and canonical profile/remainder decomposition -/

/-- Closed zero-central-trace subspace. -/
noncomputable def actualFixedPhaseProductCollarZeroTraceSubspace
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseProductCollarStoredEnergy n Y) :=
  (actualFixedPhaseProductCollarCentralTrace n Y).ker

theorem actualFixedPhaseProductCollarZeroTraceSubspace_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      ((actualFixedPhaseProductCollarZeroTraceSubspace n Y :
          Submodule ℂ
            (ActualFixedPhaseProductCollarStoredEnergy n Y)) :
        Set (ActualFixedPhaseProductCollarStoredEnergy n Y)) :=
  (actualFixedPhaseProductCollarCentralTrace n Y).isClosed_ker

/-- Remove the normalized constant profile selected by central trace. -/
def actualFixedPhaseProductCollarZeroTraceRemainder
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    ActualFixedPhaseProductCollarStoredEnergy n Y :=
  x - actualFixedPhaseProductCollarProfileExtension n Y
    (actualFixedPhaseProductCollarCentralTrace n Y x)

theorem actualFixedPhaseProductCollarZeroTraceRemainder_mem
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    actualFixedPhaseProductCollarZeroTraceRemainder n Y x ∈
      actualFixedPhaseProductCollarZeroTraceSubspace n Y := by
  change actualFixedPhaseProductCollarCentralTrace n Y
      (x - actualFixedPhaseProductCollarProfileExtension n Y
        (actualFixedPhaseProductCollarCentralTrace n Y x)) = 0
  simp

/-- Exact profile plus zero-trace remainder decomposition. -/
theorem actualFixedPhaseProductCollar_decomposition
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    x =
      actualFixedPhaseProductCollarProfileExtension n Y
          (actualFixedPhaseProductCollarCentralTrace n Y x) +
        actualFixedPhaseProductCollarZeroTraceRemainder n Y x := by
  simp only [actualFixedPhaseProductCollarZeroTraceRemainder]
  abel

/-- Range of the normalized constant-profile extension. -/
noncomputable def actualFixedPhaseProductCollarProfileRange
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseProductCollarStoredEnergy n Y) :=
  LinearMap.range
    (actualFixedPhaseProductCollarProfileExtension n Y).toLinearMap

/-- Constant profiles are orthogonal to all zero-central-trace stored
fluctuations. -/
theorem actualFixedPhaseProductCollarProfileRange_le_orthogonal
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseProductCollarProfileRange n Y ≤
      (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ := by
  intro x hx
  rcases hx with ⟨b, rfl⟩
  rw [Submodule.mem_orthogonal]
  intro z hz
  have hzfst :
      (z : ActualFixedPhaseProductCollarStoredEnergy n Y).fst = 0 := by
    change actualFixedPhaseProductCollarCentralTrace n Y z = 0 at hz
    simpa using hz
  rw [WithLp.prod_inner_apply]
  simp [hzfst]

/-- The normalized constant-profile range is exactly the orthogonal
complement of the zero-central-trace subspace.  Thus the stored split is not
merely algebraic: it is the Hilbert orthogonal decomposition. -/
theorem actualFixedPhaseProductCollarProfileRange_eq_orthogonal
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseProductCollarProfileRange n Y =
      (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ := by
  apply le_antisymm
  · exact actualFixedPhaseProductCollarProfileRange_le_orthogonal n Y
  · intro x hx
    have hp :
        actualFixedPhaseProductCollarProfileExtension n Y
            (actualFixedPhaseProductCollarCentralTrace n Y x) ∈
          (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ :=
      actualFixedPhaseProductCollarProfileRange_le_orthogonal n Y
        ⟨actualFixedPhaseProductCollarCentralTrace n Y x, rfl⟩
    have hrOrth :
        actualFixedPhaseProductCollarZeroTraceRemainder n Y x ∈
          (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ := by
      change x -
          actualFixedPhaseProductCollarProfileExtension n Y
            (actualFixedPhaseProductCollarCentralTrace n Y x) ∈
        (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ
      exact
        ((actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ).sub_mem
          hx hp
    have hrInf :
        actualFixedPhaseProductCollarZeroTraceRemainder n Y x ∈
          actualFixedPhaseProductCollarZeroTraceSubspace n Y ⊓
            (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ :=
      ⟨actualFixedPhaseProductCollarZeroTraceRemainder_mem n Y x,
        hrOrth⟩
    have hrBot :
        actualFixedPhaseProductCollarZeroTraceRemainder n Y x ∈
          (⊥ : Submodule ℂ
            (ActualFixedPhaseProductCollarStoredEnergy n Y)) := by
      rw [← (actualFixedPhaseProductCollarZeroTraceSubspace n Y).inf_orthogonal_eq_bot]
      exact hrInf
    have hrZero :
        actualFixedPhaseProductCollarZeroTraceRemainder n Y x = 0 := by
      simpa using hrBot
    refine ⟨actualFixedPhaseProductCollarCentralTrace n Y x, ?_⟩
    have hDecomp := actualFixedPhaseProductCollar_decomposition n Y x
    rw [hrZero, add_zero] at hDecomp
    exact hDecomp.symm

/-- The canonical remainder is orthogonal to its constant-profile part. -/
theorem actualFixedPhaseProductCollar_remainder_inner_profile
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    inner ℂ
        (actualFixedPhaseProductCollarZeroTraceRemainder n Y x)
        (actualFixedPhaseProductCollarProfileExtension n Y
          (actualFixedPhaseProductCollarCentralTrace n Y x)) = 0 := by
  have hp :
      actualFixedPhaseProductCollarProfileExtension n Y
          (actualFixedPhaseProductCollarCentralTrace n Y x) ∈
        (actualFixedPhaseProductCollarZeroTraceSubspace n Y)ᗮ :=
    actualFixedPhaseProductCollarProfileRange_le_orthogonal n Y
      ⟨actualFixedPhaseProductCollarCentralTrace n Y x, rfl⟩
  rw [Submodule.mem_orthogonal] at hp
  exact hp _
    (actualFixedPhaseProductCollarZeroTraceRemainder_mem n Y x)

set_option maxHeartbeats 2000000 in
/-- Exact Pythagorean identity for the stored profile/remainder split. -/
theorem actualFixedPhaseProductCollar_norm_sq_decomposition
    (n : ℤ) (Y : ℝ)
    (x : ActualFixedPhaseProductCollarStoredEnergy n Y) :
    ‖x‖ ^ 2 =
      ‖actualFixedPhaseProductCollarCentralTrace n Y x‖ ^ 2 +
        ‖actualFixedPhaseProductCollarZeroTraceRemainder n Y x‖ ^ 2 := by
  have hinner :
      inner ℂ
          (actualFixedPhaseProductCollarProfileExtension n Y
            (actualFixedPhaseProductCollarCentralTrace n Y x))
          (actualFixedPhaseProductCollarZeroTraceRemainder n Y x) = 0 := by
    exact inner_eq_zero_symm.mpr
      (actualFixedPhaseProductCollar_remainder_inner_profile n Y x)
  calc
    ‖x‖ ^ 2 =
        ‖actualFixedPhaseProductCollarProfileExtension n Y
              (actualFixedPhaseProductCollarCentralTrace n Y x) +
            actualFixedPhaseProductCollarZeroTraceRemainder n Y x‖ ^ 2 := by
      exact congrArg (fun z => ‖z‖ ^ 2)
        (actualFixedPhaseProductCollar_decomposition n Y x)
    _ =
        ‖actualFixedPhaseProductCollarProfileExtension n Y
            (actualFixedPhaseProductCollarCentralTrace n Y x)‖ ^ 2 +
          ‖actualFixedPhaseProductCollarZeroTraceRemainder n Y x‖ ^ 2 := by
      simpa only [pow_two] using
        norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ hinner
    _ =
        ‖actualFixedPhaseProductCollarCentralTrace n Y x‖ ^ 2 +
          ‖actualFixedPhaseProductCollarZeroTraceRemainder n Y x‖ ^ 2 := by
      rw [actualFixedPhaseProductCollarProfileExtension_norm]

/-! ## 5. An onto algebraic profile-plus-zero-trace core -/

/-- Algebraic inputs consisting of an arbitrary boundary profile and an
arbitrary zero-central-trace stored fluctuation. -/
abbrev ActualFixedPhaseProductCollarAlgebraicCore
    (n : ℤ) (Y : ℝ) :=
  ActualFixedPhaseCollarBoundary n Y ×
    actualFixedPhaseProductCollarZeroTraceSubspace n Y

set_option maxHeartbeats 2000000 in
/-- Synthesize a stored collar vector from its profile and zero-trace
remainder. -/
noncomputable def actualFixedPhaseProductCollarCoreSynthesis
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarAlgebraicCore n Y →ₗ[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y where
  toFun p :=
    actualFixedPhaseProductCollarProfileExtension n Y p.1 + p.2.1
  map_add' p q := by
    simp only [Prod.fst_add, Prod.snd_add, map_add, Submodule.coe_add]
    abel
  map_smul' c p := by
    change
      actualFixedPhaseProductCollarProfileExtension n Y (c • p.1) +
          c • p.2.1 =
        c • (actualFixedPhaseProductCollarProfileExtension n Y p.1 + p.2.1)
    rw [map_smul]
    exact (smul_add c _ _).symm

set_option maxHeartbeats 2000000 in
@[simp]
theorem actualFixedPhaseProductCollarCoreSynthesis_trace
    (n : ℤ) (Y : ℝ)
    (p : ActualFixedPhaseProductCollarAlgebraicCore n Y) :
    actualFixedPhaseProductCollarCentralTrace n Y
        (actualFixedPhaseProductCollarCoreSynthesis n Y p) = p.1 := by
  change actualFixedPhaseProductCollarCentralTrace n Y
      (actualFixedPhaseProductCollarProfileExtension n Y p.1 + p.2.1) = p.1
  have hz : actualFixedPhaseProductCollarCentralTrace n Y p.2.1 = 0 :=
    p.2.property
  rw [map_add,
    actualFixedPhaseProductCollarCentralTrace_profileExtension, hz, add_zero]

set_option maxHeartbeats 2000000 in
theorem actualFixedPhaseProductCollarCoreSynthesis_surjective
    (n : ℤ) (Y : ℝ) :
    Function.Surjective
      (actualFixedPhaseProductCollarCoreSynthesis n Y) := by
  intro x
  let z : actualFixedPhaseProductCollarZeroTraceSubspace n Y :=
    ⟨actualFixedPhaseProductCollarZeroTraceRemainder n Y x,
      actualFixedPhaseProductCollarZeroTraceRemainder_mem n Y x⟩
  refine ⟨(actualFixedPhaseProductCollarCentralTrace n Y x, z), ?_⟩
  change
    actualFixedPhaseProductCollarProfileExtension n Y
        (actualFixedPhaseProductCollarCentralTrace n Y x) +
      actualFixedPhaseProductCollarZeroTraceRemainder n Y x = x
  exact (actualFixedPhaseProductCollar_decomposition n Y x).symm

/-- The algebraic profile-plus-zero-trace core is dense; in fact its
synthesis map is onto.  No smooth-density assertion is inferred here. -/
theorem actualFixedPhaseProductCollarCoreSynthesis_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseProductCollarCoreSynthesis n Y) :=
  (actualFixedPhaseProductCollarCoreSynthesis_surjective n Y).denseRange

/-! ## 6. Exact comparison with the old bulk graph completion -/

/-- The actual smooth-core trace inserted as a normalized constant collar
profile. -/
noncomputable def actualFixedPhaseSmoothCoreToProductCollarProfile
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y :=
  (actualFixedPhaseProductCollarProfileExtension n Y).toLinearMap.comp
    (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y)

@[simp]
theorem actualFixedPhaseSmoothCoreToProductCollarProfile_apply
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseSmoothCoreToProductCollarProfile n Y u =
      actualFixedPhaseProductCollarProfileExtension n Y
        (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y u) := by
  rfl

/-- The exact norm estimate needed to extend the actual smooth constant
profile from the pre-existing bulk graph completion. -/
def ActualFixedPhaseProductCollarCoreBounded
    (n : ℤ) (Y : ℝ) : Prop :=
  ∃ C : ℝ, ∀ u : InverseEtaFixedPhaseCore n,
    ‖actualFixedPhaseSmoothCoreToProductCollarProfile n Y u‖ ≤
      C * ‖coreMap n u‖

/-- A continuous map on the old graph completion has the prescribed actual
smooth constant-profile values. -/
def ExtendsActualFixedPhaseProductCollarCore
    (n : ℤ) (Y : ℝ)
    (T : GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y) : Prop :=
  ∀ u : InverseEtaFixedPhaseCore n,
    T (coreMap n u) =
      actualFixedPhaseSmoothCoreToProductCollarProfile n Y u

/-- Dense extension candidate.  Its identification on the literal smooth
core is used only under the exact core bound below. -/
noncomputable def actualFixedPhaseOldGraphToProductCollarExtension
    (n : ℤ) (Y : ℝ) :
    GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  exact (actualFixedPhaseSmoothCoreToProductCollarProfile n Y).extendOfNorm (coreMap n)

theorem actualFixedPhaseOldGraphToProductCollarExtension_core
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseProductCollarCoreBounded n Y)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseOldGraphToProductCollarExtension n Y
        (coreMap n u) =
      actualFixedPhaseSmoothCoreToProductCollarProfile n Y u := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  rcases hBound with ⟨C0, hC0⟩
  exact LinearMap.extendOfNorm_eq
    (denseRange_coreMap n) ⟨C0, hC0⟩ u

set_option maxHeartbeats 8000000 in
/-- A concrete smooth-core constant also controls the dense extension on the
whole old graph completion. -/
theorem actualFixedPhaseOldGraphToProductCollarExtension_norm_le
    (n : ℤ) (Y : ℝ) (C0 : ℝ)
    (hC0 : ∀ u : InverseEtaFixedPhaseCore n,
      ‖actualFixedPhaseSmoothCoreToProductCollarProfile n Y u‖ ≤
        C0 * ‖coreMap n u‖)
    (x : GraphSobolevCompletion n) :
    ‖actualFixedPhaseOldGraphToProductCollarExtension n Y x‖ ≤
      C0 * ‖x‖ := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  exact LinearMap.norm_extendOfNorm_apply_le
    (f := actualFixedPhaseSmoothCoreToProductCollarProfile n Y)
    (e := coreMap n)
    (denseRange_coreMap n) C0 hC0 x

/-- Under the exact core estimate, the dense extension is the unique
continuous map with the prescribed actual smooth constant-profile values. -/
theorem actualFixedPhaseOldGraphToProductCollarExtension_unique
    (n : ℤ) (Y : ℝ)
    (hBound : ActualFixedPhaseProductCollarCoreBounded n Y)
    (T : GraphSobolevCompletion n →L[ℂ]
      ActualFixedPhaseProductCollarStoredEnergy n Y)
    (hT : ExtendsActualFixedPhaseProductCollarCore n Y T) :
    actualFixedPhaseOldGraphToProductCollarExtension n Y = T := by
  letI : Module ℂ (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreModule n
  letI : AddCommGroup (InverseEtaFixedPhaseCore n) :=
    DefinitionOneSobolev.FixedPhaseGraphCompletion.fixedPhaseGraphCoreAddCommGroup n
  rcases hBound with ⟨C0, hC0⟩
  have hComp : T.toLinearMap.comp (coreMap n) =
      actualFixedPhaseSmoothCoreToProductCollarProfile n Y := by
    ext u
    exact hT u
  exact LinearMap.extendOfNorm_unique
    (denseRange_coreMap n) C0 hC0 T hComp

/-- The stored product-collar core estimate is equivalent to existence of a
continuous extension on the old graph completion. -/
theorem actualFixedPhaseProductCollarCoreBounded_iff_exists_extension
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarCoreBounded n Y ↔
      ∃ T : GraphSobolevCompletion n →L[ℂ]
          ActualFixedPhaseProductCollarStoredEnergy n Y,
        ExtendsActualFixedPhaseProductCollarCore n Y T := by
  constructor
  · intro hBound
    exact ⟨actualFixedPhaseOldGraphToProductCollarExtension n Y,
      actualFixedPhaseOldGraphToProductCollarExtension_core n Y hBound⟩
  · rintro ⟨T, hT⟩
    refine ⟨‖T‖, fun u => ?_⟩
    rw [← hT u]
    exact T.le_opNorm (coreMap n u)

/-- Because the normalized profile extension is an isometry, the new core
bound is exactly the previously exposed genuine `H^(1/2)` trace estimate;
there is no additional hidden collar constant. -/
theorem actualFixedPhaseProductCollarCoreBounded_iff_hhalfCoreBounded
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarCoreBounded n Y ↔
      ∃ C0 : ℝ, ∀ u : InverseEtaFixedPhaseCore n,
        ‖QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y u‖ ≤
          C0 * ‖coreMap n u‖ := by
  constructor
  · rintro ⟨C0, hC0⟩
    refine ⟨C0, fun u => ?_⟩
    rw [← actualFixedPhaseProductCollarProfileExtension_norm n Y
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y u)]
    simpa only [actualFixedPhaseSmoothCoreToProductCollarProfile_apply] using
      hC0 u
  · rintro ⟨C0, hC0⟩
    refine ⟨C0, fun u => ?_⟩
    rw [actualFixedPhaseSmoothCoreToProductCollarProfile_apply,
      actualFixedPhaseProductCollarProfileExtension_norm]
    exact hC0 u

/-- Exact residual reduction to the old graph-to-`H^(1/2)` trace theorem.
The right side asks for a theorem-derived continuous map, not a structure
field. -/
theorem actualFixedPhaseProductCollarResidual_iff_oldHhalfTraceExtension
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseProductCollarCoreBounded n Y ↔
      ∃ T : GraphSobolevCompletion n →L[ℂ]
          ActualFixedPhaseCollarBoundary n Y,
        ∀ u : InverseEtaFixedPhaseCore n,
          T (coreMap n u) =
            QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y u := by
  exact
    (actualFixedPhaseProductCollarCoreBounded_iff_hhalfCoreBounded n Y).trans
      (QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseHhalfTraceBound_iff_exists_extension n Y)

/-- If the exact old-graph estimate fails, no continuous map can realize the
actual smooth constant profiles on that completion. -/
theorem no_actualFixedPhaseOldGraphToProductCollarExtension
    (n : ℤ) (Y : ℝ)
    (hNotBounded : ¬ ActualFixedPhaseProductCollarCoreBounded n Y) :
    ¬ ∃ T : GraphSobolevCompletion n →L[ℂ]
        ActualFixedPhaseProductCollarStoredEnergy n Y,
      ExtendsActualFixedPhaseProductCollarCore n Y T := by
  exact fun hExists => hNotBounded
    ((actualFixedPhaseProductCollarCoreBounded_iff_exists_extension n Y).2
      hExists)

/-! ## 7. Compact endpoint certificate -/

/-- Unconditional stored-collar endpoint together with the exact remaining
old-graph comparison boundary. -/
theorem actualFixedPhaseProductCollarStoredEnergyCertificate
    (n : ℤ) (Y : ℝ) :
    Function.Surjective
        (actualFixedPhaseProductCollarCentralTrace n Y) ∧
      Function.RightInverse
        (actualFixedPhaseProductCollarProfileExtension n Y)
        (actualFixedPhaseProductCollarCentralTrace n Y) ∧
      (∀ b : ActualFixedPhaseCollarBoundary n Y,
        ‖actualFixedPhaseProductCollarProfileExtension n Y b‖ = ‖b‖) ∧
      IsClosed
        ((actualFixedPhaseProductCollarZeroTraceSubspace n Y :
            Submodule ℂ
              (ActualFixedPhaseProductCollarStoredEnergy n Y)) :
          Set (ActualFixedPhaseProductCollarStoredEnergy n Y)) ∧
      DenseRange (actualFixedPhaseProductCollarCoreSynthesis n Y) ∧
      (ActualFixedPhaseProductCollarCoreBounded n Y ↔
        ∃ T : GraphSobolevCompletion n →L[ℂ]
            ActualFixedPhaseCollarBoundary n Y,
          ∀ u : InverseEtaFixedPhaseCore n,
            T (coreMap n u) =
              QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseThreeCuspTraceToHhalfFull n Y u) := by
  exact ⟨actualFixedPhaseProductCollarCentralTrace_surjective n Y,
    actualFixedPhaseProductCollarProfileExtension_rightInverse n Y,
    actualFixedPhaseProductCollarProfileExtension_norm n Y,
    actualFixedPhaseProductCollarZeroTraceSubspace_isClosed n Y,
    actualFixedPhaseProductCollarCoreSynthesis_denseRange n Y,
    actualFixedPhaseProductCollarResidual_iff_oldHhalfTraceExtension n Y⟩

end QYM.FullCertification.P2CollarTraceExtension

