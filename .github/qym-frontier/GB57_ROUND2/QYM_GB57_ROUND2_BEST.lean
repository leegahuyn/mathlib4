          actualInverseEtaProjectionHamiltonianEnergy hY u = ‖u‖ ^ 2) ∧
      ∀ r : ℝ,
        r ∈ resolventSet ℝ
            ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ) →
          ¬ IsCompactOperator
            ((resolvent
              ((actualInverseEtaProjectionHamiltonian hY).restrictScalars ℝ) r :
                QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℝ]
                  QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
                QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →
                  QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) := by
  exact
    ⟨actualInverseEtaProjectionHamiltonian_isIdempotent hY,
