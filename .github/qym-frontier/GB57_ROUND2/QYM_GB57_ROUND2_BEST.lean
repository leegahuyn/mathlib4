/-!
# The explicit outward hyperbolic unit normal

For the actual regular edge velocity `v`, let `s` be the stored boundary
orientation sign and put `w = s v`.  The outward normal is the right normal
to this oriented tangent,

`(y / ||w||) * (-I) * w`.

The preceding producer proves `v != 0`, so this formula has no singularity on
the regular parameter set.  We prove, without a geometric certificate input,
that it has hyperbolic length one, is orthogonal to the old actual velocity,
and lies on the strict right/outward side of the stored orientation.

The second half proves the paired negative-normal law for the already
available real-chart derivative `d1`.  The old proposition
`N.HasOppositePairedNormalPushforward` was deliberately stated with the
manifold derivative `mfderiv`.  Its value on this actual normal is shown to be
equivalent to one explicit chart-compatibility equality.  Thus no equality
between two derivative APIs is silently assumed.
-/

/-! ## 1. Oriented tangent and right-normal algebra -/

/-- The actual tangent multiplied by the frozen boundary-orientation sign. -/
def orientedActualEdgeVelocity (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℂ :=
  (((e.orientationSign : ℝ) : ℂ) * QYM.FullCertification.P2NormalGreenExtension.actualEdgeVelocity e t)

/-- The oriented actual tangent is nonzero at every regular parameter. -/
theorem orientedActualEdgeVelocity_ne_zero
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e) :
    orientedActualEdgeVelocity e t ≠ 0 := by
  apply mul_ne_zero
  · rcases e with ⟨q, k⟩
    cases k <;>
      norm_num [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.orientationSign]
  · exact QYM.FullCertification.P2ExplicitEdgeVelocityExtension.actualEdgeVelocity_ne_zero e ht

/-- Euclidean right normal rescaled to have hyperbolic length one at height
`y`.  It is used only when `w` is nonzero. -/
def hyperbolicRightNormal (y : ℝ) (w : ℂ) : ℂ :=
  (((y / ‖w‖ : ℝ) : ℂ) * (-Complex.I)) * w

/-- Its Euclidean norm is exactly `y`; hence its hyperbolic norm is one. -/
theorem norm_hyperbolicRightNormal {y : ℝ} (hy : 0 ≤ y)
    {w : ℂ} (hw : w ≠ 0) :
    ‖hyperbolicRightNormal y w‖ = y := by
  have hn : 0 < ‖w‖ := norm_pos_iff.mpr hw
  rw [hyperbolicRightNormal, norm_mul, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (div_nonneg hy hn.le),
    norm_neg, Complex.norm_I, mul_one, div_mul_cancel₀ y hn.ne']

/-- Rotation by `-I` is orthogonal to the original vector. -/
theorem conj_mul_hyperbolicRightNormal_re (y : ℝ) (w : ℂ) :
    (star w * hyperbolicRightNormal y w).re = 0 := by
  rw [hyperbolicRightNormal,
    show star w * ((((y / ‖w‖ : ℝ) : ℂ) * (-Complex.I)) * w) =
        (((y / ‖w‖ : ℝ) : ℂ) * (-Complex.I)) *
          (star w * w) by ring]
  simp [Complex.mul_re] <;> ring_nf <;> simp

/-- The same right normal is orthogonal to `v` when the oriented vector is
any real multiple `s v`. -/
theorem conj_mul_hyperbolicRightNormal_realMultiple_re
    (y s : ℝ) (v : ℂ) :
    (star v *
      hyperbolicRightNormal y (((s : ℝ) : ℂ) * v)).re = 0 := by
  by_cases hs : s = 0
  · subst s
    simp [hyperbolicRightNormal]
  · have horth :=
      conj_mul_hyperbolicRightNormal_re y (((s : ℝ) : ℂ) * v)
    have hstar :
        star (((s : ℝ) : ℂ) * v) = ((s : ℝ) : ℂ) * star v := by
      simp [map_mul, Complex.star_def, mul_comm]
    rw [hstar] at horth
    have hscaled :
        s * (star v *
          hyperbolicRightNormal y (((s : ℝ) : ℂ) * v)).re = 0 := by
      simpa [Complex.mul_re, mul_assoc] using horth
    exact (mul_eq_zero.mp hscaled).resolve_left hs

/-- Exact signed-area formula for the right normal. -/
theorem conj_mul_hyperbolicRightNormal_im {y : ℝ} {w : ℂ}
    (hw : w ≠ 0) :
    (star w * hyperbolicRightNormal y w).im =
      -y * ‖w‖ := by
  have hn : ‖w‖ ≠ 0 := norm_ne_zero_iff.mpr hw
  have hstar : star w * w = (Complex.normSq w : ℂ) := by
    simpa [Complex.star_def] using
      (Complex.normSq_eq_conj_mul_self (z := w)).symm
  rw [hyperbolicRightNormal,
    show star w * ((((y / ‖w‖ : ℝ) : ℂ) * (-Complex.I)) * w) =
        (((y / ‖w‖ : ℝ) : ℂ) * (-Complex.I)) *
          (star w * w) by ring,
    hstar]
  simp [Complex.mul_re, Complex.mul_im]
  rw [Complex.normSq_eq_norm_sq]
  field_simp [hn] <;> ring

/-! ## 2. The actual geometric normal and its three unconditional laws -/

/-- Concrete outward hyperbolic unit normal on every actual polygon edge.
Only its values at regular parameters are advertised. -/
def actualOutwardHyperbolicUnitNormal : QYM.FullCertification.P2NormalGreenExtension.EdgeNormalField :=
  fun e t => hyperbolicRightNormal (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im
    (orientedActualEdgeVelocity e t)

/-- Strict right-side condition relative to the stored boundary orientation.
For a positively oriented planar boundary, this is the outward side. -/
def IsStrictlyOutwardForStoredOrientation
    (normal : QYM.FullCertification.P2NormalGreenExtension.EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e →
      (star (orientedActualEdgeVelocity e t) * normal e t).im < 0

/-- The concrete field has hyperbolic unit length. -/
theorem actualOutwardHyperbolicUnitNormal_isHyperbolicUnit :
    QYM.FullCertification.P2NormalGreenExtension.IsHyperbolicUnitEdgeField actualOutwardHyperbolicUnitNormal := by
  intro e t ht
  exact norm_hyperbolicRightNormal
    (le_of_lt (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im_pos)
    (orientedActualEdgeVelocity_ne_zero e ht)

/-- The concrete field is orthogonal to the exact `derivWithin` velocity. -/
theorem actualOutwardHyperbolicUnitNormal_isOrthogonal :
    QYM.FullCertification.P2NormalGreenExtension.IsOrthogonalToActualEdgeVelocity
      actualOutwardHyperbolicUnitNormal := by
  intro e t ht
  exact conj_mul_hyperbolicRightNormal_realMultiple_re
    (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im (e.orientationSign : ℝ)
      (QYM.FullCertification.P2NormalGreenExtension.actualEdgeVelocity e t)

/-- The concrete field is strictly on the right/outward side of every stored
oriented edge. -/
theorem actualOutwardHyperbolicUnitNormal_isStrictlyOutward :
    IsStrictlyOutwardForStoredOrientation
      actualOutwardHyperbolicUnitNormal := by
  intro e t ht
  change
    (star (orientedActualEdgeVelocity e t) *
      hyperbolicRightNormal
        (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im
        (orientedActualEdgeVelocity e t)).im < 0
  rw [conj_mul_hyperbolicRightNormal_im
    (orientedActualEdgeVelocity_ne_zero e ht)]
  have hp := mul_pos (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im_pos
    (norm_pos_iff.mpr (orientedActualEdgeVelocity_ne_zero e ht))
  nlinarith

/-! ## 3. Conformal scale under the exact paired-edge map -/

/-- The `d1` formula under the Green-boundary name. -/
theorem d1_gammaTwoActionCoordinate
    (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate γ) z ξ =
      ξ / inverseEtaPaperOrbitDenom γ z ^ 2 := by
  change d1 (gammaTwoMoebiusCoordinate γ) z ξ =
    ξ / inverseEtaPaperOrbitDenom γ z ^ 2
  exact d1_gammaTwoMoebiusCoordinate γ z ξ

/-- The paired point has the usual exact Möbius height scale. -/
theorem paired_actualEdgePoint_im
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.edgeParameterSet e) :
    (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e.paired (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)).im =
      (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
        Complex.normSq
          (inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)) := by
  rw [← QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint_pairing e ht]
  simpa [inverseEtaPaperOrbitDenom] using
    (ModularGroup.im_smul_eq_div_normSq
      (e.pairingElement : SL(2, ℤ)) (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t))

/-- The norm of the stored-oriented velocity equals the norm of the raw
actual velocity: every stored orientation sign is `+1` or `-1`. -/
theorem norm_orientedActualEdgeVelocity
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    ‖orientedActualEdgeVelocity e t‖ = ‖QYM.FullCertification.P2NormalGreenExtension.actualEdgeVelocity e t‖ := by
  rcases e with ⟨q, k⟩
  cases k <;>
    simp [orientedActualEdgeVelocity,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.orientationSign,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.orientationSign]

/-- The norm of the paired raw velocity has the same conformal scale as
height. -/
theorem paired_actualEdgeVelocity_norm
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e) :
    ‖QYM.FullCertification.P2NormalGreenExtension.actualEdgeVelocity e.paired (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)‖ =
      ‖QYM.FullCertification.P2NormalGreenExtension.actualEdgeVelocity e t‖ /
        Complex.normSq
          (inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)) := by
  have hChain := QYM.FullCertification.P2ExplicitEdgeVelocityExtension.pairedEdgeVelocityChainRuleAt e ht
  unfold QYM.FullCertification.P2NormalGreenExtension.PairedEdgeVelocityChainRuleAt at hChain
  rw [d1_gammaTwoActionCoordinate] at hChain
  have hNorm := congrArg norm hChain
  rcases e with ⟨q, k⟩
  cases k <;>
    simpa [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
      Complex.normSq_eq_norm_sq, norm_div] using hNorm.symm

/-- The same norm formula for the stored-oriented velocities. -/
theorem paired_orientedActualEdgeVelocity_norm
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e) :
    ‖orientedActualEdgeVelocity e.paired
        (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)‖ =
      ‖orientedActualEdgeVelocity e t‖ /
        Complex.normSq
          (inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)) := by
  rw [norm_orientedActualEdgeVelocity,
    norm_orientedActualEdgeVelocity]
  exact paired_actualEdgeVelocity_norm e ht

/-- Height divided by oriented tangent norm is invariant under edge pairing. -/
theorem paired_hyperbolicNormalScale
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e) :
    (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e.paired (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)).im /
        ‖orientedActualEdgeVelocity e.paired
          (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)‖ =
      (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
        ‖orientedActualEdgeVelocity e t‖ := by
  rw [paired_actualEdgePoint_im e ht.1,
    paired_orientedActualEdgeVelocity_norm e ht]
  have hDenom :
      inverseEtaPaperOrbitDenom e.pairingElement
        (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) ≠ 0 :=
    inverseEtaPaperOrbitDenom_ne_zero e.pairingElement
      (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)
  have hQ :
      Complex.normSq
        (inverseEtaPaperOrbitDenom e.pairingElement
          (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)) ≠ 0 :=
    (Complex.normSq_pos.mpr hDenom).ne'
  have hV : ‖orientedActualEdgeVelocity e t‖ ≠ 0 :=
    norm_ne_zero_iff.mpr (orientedActualEdgeVelocity_ne_zero e ht)
  field_simp [hQ, hV]
  <;> ring

/-! ## 4. The negative paired-normal law in the existing `d1` chart -/

/-- `d1` is real-linear in its direction argument. -/
theorem d1_real_smul_direction
    (f : ℍ → ℂ) (z : ℍ) (a : ℝ) (ξ : ℂ) :
    d1 f z (((a : ℝ) : ℂ) * ξ) =
      ((a : ℝ) : ℂ) * d1 f z ξ := by
  change fderiv ℝ (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.upperLift f) (z : ℂ) (a • ξ) =
    a • fderiv ℝ (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.upperLift f) (z : ℂ) ξ
  exact map_smul (fderiv ℝ (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.upperLift f) (z : ℂ)) a ξ

@[simp]
theorem d1_neg_direction
    (f : ℍ → ℂ) (z : ℍ) (ξ : ℂ) :
    d1 f z (-ξ) = -d1 f z ξ := by
  unfold d1
  exact map_neg (fderiv ℝ (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.upperLift f) (z : ℂ)) ξ

/-- The oriented tangent, unlike the raw parameter tangent, always pushes
forward to the negative oriented tangent on the paired side. -/
theorem d1_orientedActualEdgeVelocity_pairing
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ}
    (ht : t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e) :
    d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
        (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) (orientedActualEdgeVelocity e t) =
      -orientedActualEdgeVelocity e.paired
        (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t) := by
  have h := QYM.FullCertification.P2ExplicitEdgeVelocityExtension.pairedEdgeVelocityChainRuleAt e ht
  unfold QYM.FullCertification.P2NormalGreenExtension.PairedEdgeVelocityChainRuleAt at h
  rcases e with ⟨q, k⟩
  cases k with
  | circularArc =>
      simpa [orientedActualEdgeVelocity,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired] using h
  | leftVerticalSegment =>
      have hn := congrArg (fun z : ℂ => -z) h
      simpa [orientedActualEdgeVelocity,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired] using hn
  | rightVerticalSegment =>
      simpa [orientedActualEdgeVelocity,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.orientationSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired] using h

/-- Pointwise negative-normal law stated with the already computed `d1`. -/
def D1OppositePairedNormalPushforwardAt
    (normal : QYM.FullCertification.P2NormalGreenExtension.EdgeNormalField) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : Prop :=
  d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
      (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) (normal e t) =
    -normal e.paired (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)

/-- Global regular-edge version of the `d1` normal law. -/
def HasD1OppositePairedNormalPushforward
    (normal : QYM.FullCertification.P2NormalGreenExtension.EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e →
      D1OppositePairedNormalPushforwardAt normal e t

/-- The concrete outward unit normal satisfies the negative paired law in
the real upper-half-plane chart unconditionally. -/
theorem actualOutwardHyperbolicUnitNormal_hasD1OppositePushforward :
    HasD1OppositePairedNormalPushforward
      actualOutwardHyperbolicUnitNormal := by
  intro e t ht
  unfold D1OppositePairedNormalPushforwardAt
  rw [d1_gammaTwoActionCoordinate]
  have hW :
      orientedActualEdgeVelocity e t /
          inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) ^ 2 =
        -orientedActualEdgeVelocity e.paired
          (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t) := by
    simpa only [d1_gammaTwoActionCoordinate] using
      (d1_orientedActualEdgeVelocity_pairing e ht)
  simp only [actualOutwardHyperbolicUnitNormal, hyperbolicRightNormal]
  rw [paired_hyperbolicNormalScale e ht]
  simp only [div_eq_mul_inv]
  calc
    ((((QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
          ‖orientedActualEdgeVelocity e t‖ : ℝ) : ℂ) * (-Complex.I) *
        orientedActualEdgeVelocity e t) *
          (inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) ^ 2)⁻¹ =
      (((QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
          ‖orientedActualEdgeVelocity e t‖ : ℝ) : ℂ) * (-Complex.I) *
        (orientedActualEdgeVelocity e t /
          inverseEtaPaperOrbitDenom e.pairingElement
            (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t) ^ 2) := by
              simp only [div_eq_mul_inv]
              ring
    _ = (((QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
          ‖orientedActualEdgeVelocity e t‖ : ℝ) : ℂ) * (-Complex.I) *
        (-orientedActualEdgeVelocity e.paired
          (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)) := by rw [hW]
    _ = -((((QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t).im /
          ‖orientedActualEdgeVelocity e t‖ : ℝ) : ℂ) * (-Complex.I) *
        orientedActualEdgeVelocity e.paired
          (QYM.FullCertification.P2NormalGreenExtension.edgeParameterTransport e t)) := by ring

/-- One theorem-valued package for the complete chart-level normal result. -/
theorem actualOutwardHyperbolicUnitNormal_chartCertificate :
    QYM.FullCertification.P2NormalGreenExtension.IsHyperbolicUnitEdgeField actualOutwardHyperbolicUnitNormal ∧
      QYM.FullCertification.P2NormalGreenExtension.IsOrthogonalToActualEdgeVelocity actualOutwardHyperbolicUnitNormal ∧
      IsStrictlyOutwardForStoredOrientation
        actualOutwardHyperbolicUnitNormal ∧
      HasD1OppositePairedNormalPushforward
        actualOutwardHyperbolicUnitNormal := by
  exact ⟨actualOutwardHyperbolicUnitNormal_isHyperbolicUnit,
    actualOutwardHyperbolicUnitNormal_isOrthogonal,
    actualOutwardHyperbolicUnitNormal_isStrictlyOutward,
    actualOutwardHyperbolicUnitNormal_hasD1OppositePushforward⟩

/-! ## 5. Exact boundary between `d1` and the manifold derivative -/

/-- The only compatibility still required for the old manifold-derivative
normal proposition, restricted to the actual normal and actual regular edges.
This is not asserted merely because the two expressions have the same paper
formula. -/
def ActualNormalManifoldD1Compatibility : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ QYM.FullCertification.P2NormalGreenExtension.regularEdgeParameterSet e →
      manifoldDeckDerivative e.pairingElement (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)
          (actualOutwardHyperbolicUnitNormal e t) =
        d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
          (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)
          (actualOutwardHyperbolicUnitNormal e t)

/-- For this concrete normal, the old `mfderiv` pushforward law is *exactly*
equivalent to the displayed chart-compatibility residual. -/
theorem actualNormal_hasOppositePushforward_iff_manifoldD1Compatibility :
    QYM.FullCertification.P2NormalGreenExtension.HasOppositePairedNormalPushforward
        actualOutwardHyperbolicUnitNormal ↔
      ActualNormalManifoldD1Compatibility := by
  constructor
  · intro hPush e t ht
    have hM := hPush e t ht
    unfold QYM.FullCertification.P2NormalGreenExtension.OppositePairedNormalPushforwardAt at hM
    have hD :=
      actualOutwardHyperbolicUnitNormal_hasD1OppositePushforward e t ht
    unfold D1OppositePairedNormalPushforwardAt at hD
    exact hM.trans hD.symm
  · intro hCompat e t ht
    unfold QYM.FullCertification.P2NormalGreenExtension.OppositePairedNormalPushforwardAt
    rw [hCompat e t ht]
    exact actualOutwardHyperbolicUnitNormal_hasD1OppositePushforward e t ht

/-- A global coordinate theorem is a sufficient, reusable way to discharge
the exact compatibility residual. -/
def ManifoldDeckDerivativeD1Compatibility : Prop :=
  ∀ (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ),
    manifoldDeckDerivative γ z ξ =
      d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate γ) z ξ

theorem actualNormal_manifoldD1Compatibility_of_global
    (h : ManifoldDeckDerivativeD1Compatibility) :
    ActualNormalManifoldD1Compatibility := by
  intro e t ht
  exact h e.pairingElement (QYM.FullCertification.P2NormalGreenExtension.actualEdgePoint e t)
    (actualOutwardHyperbolicUnitNormal e t)

theorem actualOutwardHyperbolicUnitNormal_hasOppositePushforward_of_global
    (h : ManifoldDeckDerivativeD1Compatibility) :
    QYM.FullCertification.P2NormalGreenExtension.HasOppositePairedNormalPushforward
      actualOutwardHyperbolicUnitNormal :=
  actualNormal_hasOppositePushforward_iff_manifoldD1Compatibility.mpr
    (actualNormal_manifoldD1Compatibility_of_global h)

/-! The bare old pushforward proposition alone is weak: the zero field always
satisfies it, but is not the geometric unit normal.  This theorem prevents an
existence-only use of that proposition from being mistaken for the result
above. -/

def zeroEdgeNormalField : QYM.FullCertification.P2NormalGreenExtension.EdgeNormalField := fun _ _ => 0

theorem zeroEdgeNormalField_hasOppositePushforward :
    QYM.FullCertification.P2NormalGreenExtension.HasOppositePairedNormalPushforward zeroEdgeNormalField := by
  intro e t ht
  simp [QYM.FullCertification.P2NormalGreenExtension.OppositePairedNormalPushforwardAt, zeroEdgeNormalField]

/-! ## 6. Axiom audits -/

#print axioms actualOutwardHyperbolicUnitNormal_isHyperbolicUnit
#print axioms actualOutwardHyperbolicUnitNormal_isOrthogonal
