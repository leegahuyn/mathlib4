/-!
# A coercive-form Friedrichs workaround with a genuine `LinearPMap` resolvent

This file proves the real-Hilbert-space first-representation argument that is
missing as a single packaged theorem in Mathlib.  The form space `V` and the
ambient space `H` are complete, and `j : V →L[ℝ] H` is an injective dense
continuous embedding.  Starting from a bounded symmetric form `B` and a
transparent positive-shift Gårding bound, we:

* build `C(u,v) = B(u,v) + μ ⟪j u, j v⟫` as an actual bounded bilinear form;
* prove that `C` is coercive and use Mathlib's actual Lax--Milgram equivalence;
* construct the ambient solution map `j ∘ C⁻¹ ∘ j†`;
* prove that its values belong to the representable form domain;
* prove that it is the two-sided inverse of `A + μ`, where `A` is the genuine
  `LinearPMap` form realization;
* derive density of the operator domain, the reverse adjoint inclusion, and
  actual self-adjointness of `A`;
* construct genuine resolvent data at `-μ`; and
* prove compactness of that resolvent when `j` itself is compact.

No density, self-adjointness, inverse identity, or compact-resolvent conclusion
is included in an input certificate.  The only analytic lower-bound supplier
is the displayed Gårding inequality below.
-/

namespace QYM.CoerciveFormFriedrichsExtension

open InnerProductSpace Set
open scoped InnerProduct RealInnerProductSpace

variable {V H : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℝ V]
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-! ## The shifted bounded form and its transparent lower bound -/

/-- Pull the ambient inner product back along the form embedding. -/
def pullbackInnerForm (j : V →L[ℝ] H) : V →L[ℝ] V →L[ℝ] ℝ :=
  ContinuousLinearMap.bilinearComp (innerSL ℝ) j j

@[simp]
theorem pullbackInnerForm_apply (j : V →L[ℝ] H) (u v : V) :
    pullbackInnerForm j u v = ⟪j u, j v⟫_ℝ :=
  rfl

/-- The form shifted by the ambient `H` inner product. -/
def shiftedForm
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) (μ : ℝ) :
    V →L[ℝ] V →L[ℝ] ℝ :=
  B + μ • pullbackInnerForm j

@[simp]
theorem shiftedForm_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ : ℝ) (u v : V) :
    shiftedForm B j μ u v = B u v + μ * ⟪j u, j v⟫_ℝ := by
  simp only [shiftedForm, pullbackInnerForm_apply,
    ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]

/-- A displayed Gårding lower bound.  Unlike an assumed `IsCoercive` result,
this predicate exposes the coefficient and every term of the inequality. -/
def HasShiftedCoercivityBound
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) : Prop :=
  ∀ u : V,
    c * ‖u‖ * ‖u‖ ≤ B u u + μ * ‖j u‖ * ‖j u‖

/-- The complete transparent hypothesis for a positive coercive shift. -/
def IsPositiveCoerciveShift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) : Prop :=
  0 < μ ∧ 0 < c ∧ HasShiftedCoercivityBound B j μ c

theorem IsPositiveCoerciveShift.shift_pos
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    0 < μ :=
  h.1

theorem IsPositiveCoerciveShift.coercivityConstant_pos
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    0 < c :=
  h.2.1

/-- The displayed Gårding bound is exactly a coercivity-constant bound for
the shifted bounded form. -/
theorem IsPositiveCoerciveShift.hasCoercivityConstant
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    QYM.LaxMilgramFormExtension.HasCoercivityConstant (shiftedForm B j μ) c := by
  intro u
  calc
    c * ‖u‖ * ‖u‖ ≤ B u u + μ * ‖j u‖ * ‖j u‖ := h.2.2 u
    _ = shiftedForm B j μ u u := by
      simp only [shiftedForm_apply, real_inner_self_eq_norm_sq, pow_two] <;> ring

/-- Coercivity is derived through the actual Mathlib predicate. -/
theorem IsPositiveCoerciveShift.isCoercive
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    IsCoercive (shiftedForm B j μ) :=
  QYM.LaxMilgramFormExtension.isCoercive_of_hasCoercivityConstant
    h.coercivityConstant_pos h.hasCoercivityConstant

/-! ## The actual Lax--Milgram solution map from `H` to `V` -/

section CompleteSpaces

variable [CompleteSpace V] [CompleteSpace H]

/-- The variational solution map `C⁻¹ ∘ j† : H →L[ℝ] V`. -/
def solutionMap
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[ℝ] V :=
  (QYM.LaxMilgramFormExtension.representationEquiv (shiftedForm B j μ) hShift.isCoercive).symm.toContinuousLinearMap.comp
    j.adjoint

@[simp]
theorem solutionMap_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) (h : H) :
    solutionMap B j μ c hShift h =
      (QYM.LaxMilgramFormExtension.representationEquiv (shiftedForm B j μ) hShift.isCoercive).symm
        (j.adjoint h) :=
  rfl

/-- The solution map satisfies the shifted variational equation for every
ambient datum. -/
theorem solutionMap_spec
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) (v : V) :
    shiftedForm B j μ (solutionMap B j μ c hShift h) v =
      ⟪h, j v⟫_ℝ := by
  let e : V ≃L[ℝ] V :=
    QYM.LaxMilgramFormExtension.representationEquiv (shiftedForm B j μ) hShift.isCoercive
  calc
    shiftedForm B j μ (solutionMap B j μ c hShift h) v =
        ⟪e (solutionMap B j μ c hShift h), v⟫_ℝ :=
      (QYM.LaxMilgramFormExtension.representationEquiv_inner_apply
        (shiftedForm B j μ) hShift.isCoercive
        (solutionMap B j μ c hShift h) v).symm
    _ = ⟪j.adjoint h, v⟫_ℝ := by
      change ⟪e (e.symm (j.adjoint h)), v⟫_ℝ = ⟪j.adjoint h, v⟫_ℝ
      rw [e.apply_symm_apply]
    _ = ⟪h, j v⟫_ℝ := j.adjoint_inner_left v h

/-- Subtracting the shift shows that the variational solution is in the
unshifted ambient representability domain. -/
theorem solutionMap_represents
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    QYM.FormDomainRealizationExtension.Represents B j (solutionMap B j μ c hShift h)
      (h - μ • j (solutionMap B j μ c hShift h)) := by
  intro v
  have hEquation := solutionMap_spec B j μ c hShift h v
  rw [shiftedForm_apply] at hEquation
  calc
    B (solutionMap B j μ c hShift h) v =
        ⟪h, j v⟫_ℝ -
          μ * ⟪j (solutionMap B j μ c hShift h), j v⟫_ℝ := by
      linarith
    _ = ⟪h - μ • j (solutionMap B j μ c hShift h), j v⟫_ℝ := by
      rw [inner_sub_left, real_inner_smul_left]

/-- The variational solution bundled with its proved form-domain membership. -/
def solutionFormDomain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : QYM.FormDomainRealizationExtension.formDomain B j :=
  ⟨solutionMap B j μ c hShift h,
    ⟨h - μ • j (solutionMap B j μ c hShift h),
      solutionMap_represents B j μ c hShift h⟩⟩

@[simp]
theorem coe_solutionFormDomain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    (solutionFormDomain B j μ c hShift h : V) =
      solutionMap B j μ c hShift h :=
  rfl

/-! ## The actual `A + μ` map and its Lax--Milgram inverse -/

/-- The algebraic positive shift on the genuine domain of a `LinearPMap`. -/
def positiveShift (A : H →ₗ.[ℝ] H) (μ : ℝ) : A.domain →ₗ[ℝ] H :=
  A.toFun + μ • A.domain.subtype

@[simp]
theorem positiveShift_apply
    (A : H →ₗ.[ℝ] H) (μ : ℝ) (x : A.domain) :
    positiveShift A μ x = A x + μ • (x : H) :=
  rfl

/-- The Lax--Milgram solution embedded into the actual realization domain. -/
def solutionDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain :=
  QYM.FormDomainRealizationExtension.domainEquiv B j hj (solutionFormDomain B j μ c hShift h)

@[simp]
theorem coe_solutionDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    ((solutionDomainLift B j hj hjDense μ c hShift h :
        (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain) : H) =
      j (solutionMap B j μ c hShift h) := by
  exact QYM.FormDomainRealizationExtension.coe_domainEquiv_apply B j hj
    (solutionFormDomain B j μ c hShift h)

/-- The realization value of the Lax--Milgram solution is the unshifted
representing vector obtained above. -/
theorem realization_solutionDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    QYM.FormDomainRealizationExtension.realization B j hj hjDense
        (solutionDomainLift B j hj hjDense μ c hShift h) =
      h - μ • j (solutionMap B j μ c hShift h) := by
  calc
    QYM.FormDomainRealizationExtension.realization B j hj hjDense
        (solutionDomainLift B j hj hjDense μ c hShift h) =
        QYM.FormDomainRealizationExtension.representingVector B j
          (solutionFormDomain B j μ c hShift h) := by
      exact QYM.FormDomainRealizationExtension.realization_apply_domainEquiv B j hj hjDense
        (solutionFormDomain B j μ c hShift h)
    _ = h - μ • j (solutionMap B j μ c hShift h) :=
      QYM.FormDomainRealizationExtension.representingVector_eq_of_represents hjDense
        (solutionFormDomain B j μ c hShift h)
        (solutionMap_represents B j μ c hShift h)

/-- `A + μ` sends the constructed domain lift back to the prescribed datum. -/
@[simp]
theorem positiveShift_solutionDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ
        (solutionDomainLift B j hj hjDense μ c hShift h) = h := by
  rw [positiveShift_apply, realization_solutionDomainLift,
    coe_solutionDomainLift]
  module

/-- The embedded continuous inverse of `A + μ`. -/
def positiveInverse
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[ℝ] H :=
  j.comp (solutionMap B j μ c hShift)

@[simp]
theorem positiveInverse_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveInverse B j μ c hShift h =
      j (solutionMap B j μ c hShift h) :=
  rfl

theorem positiveInverse_mem_domain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveInverse B j μ c hShift h ∈
      (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain := by
  change j (solutionMap B j μ c hShift h) ∈
    (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain
  have hmem := (solutionDomainLift B j hj hjDense μ c hShift h).property
  simpa only [coe_solutionDomainLift] using hmem

/-- The shifted form evaluated at the coordinate of a domain vector equals
the ambient pairing with `(A + μ)x`. -/
theorem shiftedForm_domainCoordinate
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ : ℝ) (x : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain)
    (v : V) :
    shiftedForm B j μ
        (((QYM.FormDomainRealizationExtension.domainEquiv B j hj).symm x : QYM.FormDomainRealizationExtension.formDomain B j) : V) v =
      ⟪positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x, j v⟫_ℝ := by
  let u : QYM.FormDomainRealizationExtension.formDomain B j := (QYM.FormDomainRealizationExtension.domainEquiv B j hj).symm x
  have hRep := QYM.FormDomainRealizationExtension.realization_represents B j hj hjDense x
  have hCoe : j (u : V) = (x : H) :=
    QYM.FormDomainRealizationExtension.coe_domainEquiv_symm B j hj x
  calc
    shiftedForm B j μ (u : V) v =
        B (u : V) v + μ * ⟪j (u : V), j v⟫_ℝ :=
      shiftedForm_apply B j μ (u : V) v
    _ = ⟪QYM.FormDomainRealizationExtension.realization B j hj hjDense x, j v⟫_ℝ +
        μ * ⟪(x : H), j v⟫_ℝ := by
      rw [hRep v, hCoe]
    _ = ⟪QYM.FormDomainRealizationExtension.realization B j hj hjDense x + μ • (x : H), j v⟫_ℝ := by
      rw [inner_add_left, real_inner_smul_left]
    _ = ⟪positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x, j v⟫_ℝ := by
      rw [positiveShift_apply]

/-- Applying the variational solution map to `(A + μ)x` recovers the form
coordinate of `x`. -/
theorem solutionMap_positiveShift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain) :
    solutionMap B j μ c hShift
        (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x) =
      (((QYM.FormDomainRealizationExtension.domainEquiv B j hj).symm x : QYM.FormDomainRealizationExtension.formDomain B j) : V) := by
  let e : V ≃L[ℝ] V :=
    QYM.LaxMilgramFormExtension.representationEquiv (shiftedForm B j μ) hShift.isCoercive
  apply e.injective
  apply ext_inner_right ℝ
  intro v
  rw [QYM.LaxMilgramFormExtension.representationEquiv_inner_apply,
    QYM.LaxMilgramFormExtension.representationEquiv_inner_apply]
  calc
    shiftedForm B j μ
        (solutionMap B j μ c hShift
          (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x)) v =
        ⟪positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x, j v⟫_ℝ :=
      solutionMap_spec B j μ c hShift
        (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x) v
    _ = shiftedForm B j μ
        (((QYM.FormDomainRealizationExtension.domainEquiv B j hj).symm x : QYM.FormDomainRealizationExtension.formDomain B j) : V) v :=
      (shiftedForm_domainCoordinate B j hj hjDense μ x v).symm

/-- The continuous ambient inverse is also a left inverse on the genuine
operator domain. -/
@[simp]
theorem positiveInverse_positiveShift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain) :
    positiveInverse B j μ c hShift
        (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x) =
      (x : H) := by
  rw [positiveInverse_apply, solutionMap_positiveShift]
  exact QYM.FormDomainRealizationExtension.coe_domainEquiv_symm B j hj x

theorem positiveShift_injective
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Injective
      (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ) := by
  intro x y hxy
  apply Subtype.ext
  calc
    (x : H) = positiveInverse B j μ c hShift
        (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ x) :=
      (positiveInverse_positiveShift B j hj hjDense μ c hShift x).symm
    _ = positiveInverse B j μ c hShift
        (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ y) := by rw [hxy]
    _ = (y : H) :=
      positiveInverse_positiveShift B j hj hjDense μ c hShift y

theorem positiveShift_surjective
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Surjective
      (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ) := by
  intro h
  exact ⟨solutionDomainLift B j hj hjDense μ c hShift h,
    positiveShift_solutionDomainLift B j hj hjDense μ c hShift h⟩

theorem positiveShift_bijective
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Bijective
      (positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ) :=
  ⟨positiveShift_injective B j hj hjDense μ c hShift,
    positiveShift_surjective B j hj hjDense μ c hShift⟩

/-! ## Density supplied by the adjoint range, not assumed -/

/-- Injectivity of a bounded Hilbert-space map makes the range of its adjoint
dense. -/
theorem denseRange_adjoint_of_injective
    (j : V →L[ℝ] H) (hj : Function.Injective j) :
    DenseRange j.adjoint := by
  change Dense ((j.adjoint).range : Set V)
  rw [Submodule.dense_iff_topologicalClosure_eq_top]
  rw [← j.orthogonal_ker, LinearMap.ker_eq_bot.mpr hj]
  exact Submodule.bot_orthogonal_eq_top

/-- The variational solution map has dense range in the form space. -/
theorem solutionMap_denseRange
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    DenseRange (solutionMap B j μ c hShift) := by
  let e : V ≃L[ℝ] V :=
    QYM.LaxMilgramFormExtension.representationEquiv (shiftedForm B j μ) hShift.isCoercive
  have he : DenseRange (e.symm : V → V) :=
    e.symm.surjective.denseRange
  have hjAdj : DenseRange (j.adjoint : H → V) :=
    denseRange_adjoint_of_injective j hj
  have hcomp : DenseRange ((e.symm : V → V) ∘ (j.adjoint : H → V)) :=
    he.comp hjAdj e.symm.continuous
  change DenseRange (fun h : H => e.symm (j.adjoint h))
  change DenseRange (fun h : H => e.symm (j.adjoint h)) at hcomp
  exact hcomp

/-- Lax--Milgram proves density of the representable form domain. -/
theorem formDomain_dense
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Dense (QYM.FormDomainRealizationExtension.formDomain B j : Set V) := by
  apply (solutionMap_denseRange B j hj μ c hShift).mono
  rintro u ⟨h, rfl⟩
  exact (solutionFormDomain B j μ c hShift h).property

/-- Consequently the actual realization domain is dense in the ambient
Hilbert space. -/
theorem realization_domain_dense
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Dense ((QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain : Set H) :=
  QYM.FormDomainRealizationExtension.realization_domain_dense B j hj hjDense
    (formDomain_dense B j hj μ c hShift)

/-! ## Maximal symmetry from surjectivity of a real shift -/

/-- A symmetric partial operator has a symmetric positive shift on its actual
domain. -/
theorem inner_positiveShift_swap
    {A : H →ₗ.[ℝ] H} (hA : A.IsFormalAdjoint A)
    (μ : ℝ) (x y : A.domain) :
    ⟪positiveShift A μ x, (y : H)⟫_ℝ =
      ⟪(x : H), positiveShift A μ y⟫_ℝ := by
  simp only [positiveShift_apply, inner_add_left, inner_add_right,
    real_inner_smul_left, real_inner_smul_right]
  rw [hA x y]

/-- For an adjoint-domain vector, surjectivity of `A + μ` produces a domain
vector with the same ambient value.  This is the key maximality argument. -/
theorem adjointDomain_eq_domainWitness_of_positiveShift_surjective
    {A : H →ₗ.[ℝ] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ))
    (y : A.adjoint.domain) :
    ∃ x : A.domain,
      (x : H) = (y : H) ∧
        positiveShift A μ x = A.adjoint y + μ • (y : H) := by
  obtain ⟨x, hx⟩ := hSurj (A.adjoint y + μ • (y : H))
  refine ⟨x, ?_, hx⟩
  apply ext_inner_right ℝ
  intro h
  obtain ⟨v, hv⟩ := hSurj h
  have hAdjoint : A.adjoint.IsFormalAdjoint A :=
    LinearPMap.adjoint_isFormalAdjoint hDense
  calc
    ⟪(x : H), h⟫_ℝ = ⟪(x : H), positiveShift A μ v⟫_ℝ := by rw [hv]
    _ = ⟪positiveShift A μ x, (v : H)⟫_ℝ :=
      (inner_positiveShift_swap hSymm μ x v).symm
    _ = ⟪A.adjoint y + μ • (y : H), (v : H)⟫_ℝ := by rw [hx]
    _ = ⟪A.adjoint y, (v : H)⟫_ℝ +
        μ * ⟪(y : H), (v : H)⟫_ℝ := by
      rw [inner_add_left, real_inner_smul_left]
    _ = ⟪(y : H), A v⟫_ℝ +
        μ * ⟪(y : H), (v : H)⟫_ℝ := by rw [hAdjoint y v]
    _ = ⟪(y : H), A v + μ • (v : H)⟫_ℝ := by
      rw [inner_add_right, real_inner_smul_right]
    _ = ⟪(y : H), positiveShift A μ v⟫_ℝ := by rw [positiveShift_apply]
    _ = ⟪(y : H), h⟫_ℝ := by rw [hv]

/-- The reverse adjoint inclusion follows from dense symmetry and surjectivity
of one real shift. -/
theorem adjoint_le_of_positiveShift_surjective
    {A : H →ₗ.[ℝ] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ)) :
    A.adjoint ≤ A := by
  refine ⟨?_, ?_⟩
  · intro y hy
    obtain ⟨x, hxy, _⟩ :=
      adjointDomain_eq_domainWitness_of_positiveShift_surjective
        hDense hSymm hSurj ⟨y, hy⟩
    have hxmem : (x : H) ∈ A.domain := x.property
    rw [hxy] at hxmem
    exact hxmem
  · intro y z hyz
    obtain ⟨x, hxy, hShift⟩ :=
      adjointDomain_eq_domainWitness_of_positiveShift_surjective
        hDense hSymm hSurj y
    have hxz : x = z := by
      apply Subtype.ext
      exact hxy.trans hyz
    have hExpanded :
        A z + μ • (z : H) = A.adjoint y + μ • (z : H) := by
      calc
        A z + μ • (z : H) = positiveShift A μ z :=
          (positiveShift_apply A μ z).symm
        _ = positiveShift A μ x := congrArg (positiveShift A μ) hxz.symm
        _ = A.adjoint y + μ • (y : H) := hShift
        _ = A.adjoint y + μ • (z : H) := by rw [hyz]
    exact (add_right_cancel hExpanded).symm

/-- Dense symmetry plus surjectivity of a real shift proves genuine
self-adjointness. -/
theorem isSelfAdjoint_of_positiveShift_surjective
    {A : H →ₗ.[ℝ] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ)) :
    IsSelfAdjoint A := by
  have hForward : A ≤ A.adjoint :=
    LinearPMap.IsFormalAdjoint.le_adjoint hDense hSymm
  have hReverse : A.adjoint ≤ A :=
    adjoint_le_of_positiveShift_surjective hDense hSymm hSurj
  exact LinearPMap.isSelfAdjoint_def.mpr (le_antisymm hReverse hForward)

/-- The coercive symmetric form realization is actually self-adjoint; the
reverse inclusion is no longer an external Friedrichs supplier. -/
theorem realization_isSelfAdjoint
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hSymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
    {μ c : ℝ} (hShift : IsPositiveCoerciveShift B j μ c) :
    IsSelfAdjoint (QYM.FormDomainRealizationExtension.realization B j hj hjDense) := by
  apply isSelfAdjoint_of_positiveShift_surjective
    (realization_domain_dense B j hj hjDense μ c hShift)
    (QYM.FormDomainRealizationExtension.realization_isFormalAdjoint hj hjDense hSymm)
    (positiveShift_surjective B j hj hjDense μ c hShift)

/-! ## Genuine resolvent data at `-μ` -/

/-- The resolvent candidate at `-μ` is `-j ∘ C⁻¹ ∘ j†`. -/
def negativeShiftResolventInverse
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[ℝ] H :=
  -positiveInverse B j μ c hShift

@[simp]
theorem negativeShiftResolventInverse_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    negativeShiftResolventInverse B j μ c hShift h =
      -j (solutionMap B j μ c hShift h) := by
  rfl

/-- The shift convention in `ResolventData` is `z - A`; at `z=-μ` it is the
negative of `A+μ`. -/
@[simp]
theorem unboundedShift_neg_eq_neg_positiveShift
    (A : H →ₗ.[ℝ] H) (μ : ℝ) (x : A.domain) :
    QYM.UnboundedResolventDataExtension.shifted A (-μ) x = -positiveShift A μ x := by
  rw [QYM.UnboundedResolventDataExtension.shifted_apply, positiveShift_apply]
  module

/-- The resolvent inverse bundled into the actual operator domain. -/
def negativeShiftResolventDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain :=
  -solutionDomainLift B j hj hjDense μ c hShift h

@[simp]
theorem coe_negativeShiftResolventDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    ((negativeShiftResolventDomainLift B j hj hjDense μ c hShift h :
        (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain) : H) =
      negativeShiftResolventInverse B j μ c hShift h := by
  simp only [negativeShiftResolventDomainLift,
    negativeShiftResolventInverse_apply, Submodule.coe_neg,
    coe_solutionDomainLift]

@[simp]
theorem shifted_negativeShiftResolventDomainLift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    QYM.UnboundedResolventDataExtension.shifted (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ)
        (negativeShiftResolventDomainLift B j hj hjDense μ c hShift h) = h := by
  rw [unboundedShift_neg_eq_neg_positiveShift]
  change -positiveShift (QYM.FormDomainRealizationExtension.realization B j hj hjDense) μ
      (-solutionDomainLift B j hj hjDense μ c hShift h) = h
  rw [map_neg, positiveShift_solutionDomainLift]
  simp only [neg_neg]

@[simp]
theorem negativeShiftResolventDomainLift_shifted
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain) :
    negativeShiftResolventDomainLift B j hj hjDense μ c hShift
        (QYM.UnboundedResolventDataExtension.shifted (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ) x) = x := by
  apply Subtype.ext
  rw [coe_negativeShiftResolventDomainLift,
    negativeShiftResolventInverse_apply,
    unboundedShift_neg_eq_neg_positiveShift, map_neg]
  simpa only [positiveInverse_apply, map_neg, neg_neg] using
    positiveInverse_positiveShift B j hj hjDense μ c hShift x

/-- Genuine two-sided continuous resolvent data for the constructed
`LinearPMap` at `-μ`. -/
def negativeShiftResolventData
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    QYM.UnboundedResolventDataExtension.ResolventData (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ) where
  inverse := negativeShiftResolventInverse B j μ c hShift
  mapsToDomain := by
    intro h
    have hmem := (negativeShiftResolventDomainLift
      B j hj hjDense μ c hShift h).property
    simpa only [coe_negativeShiftResolventDomainLift] using hmem
  left_inverse := by
    intro x
    simpa only [coe_negativeShiftResolventDomainLift] using
      congrArg Subtype.val
        (negativeShiftResolventDomainLift_shifted
          B j hj hjDense μ c hShift x)
  right_inverse := by
    intro h
    let x : (QYM.FormDomainRealizationExtension.realization B j hj hjDense).domain :=
      ⟨negativeShiftResolventInverse B j μ c hShift h,
        by
          have hmem := (negativeShiftResolventDomainLift
            B j hj hjDense μ c hShift h).property
          simpa only [coe_negativeShiftResolventDomainLift] using hmem⟩
    have hx : x = negativeShiftResolventDomainLift
        B j hj hjDense μ c hShift h := by
      apply Subtype.ext
      exact (coe_negativeShiftResolventDomainLift
        B j hj hjDense μ c hShift h).symm
    change QYM.UnboundedResolventDataExtension.shifted (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ) x = h
    rw [hx]
    exact shifted_negativeShiftResolventDomainLift
      B j hj hjDense μ c hShift h

theorem realization_hasResolventAt_negShift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    QYM.UnboundedResolventDataExtension.HasResolventAt (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ) :=
  ⟨negativeShiftResolventData B j hj hjDense μ c hShift⟩

/-! ## Compact embedding gives a compact genuine resolvent -/

/-- Compactness of the form embedding passes through the bounded
Lax--Milgram solution map. -/
theorem positiveInverse_isCompact
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    IsCompactOperator (positiveInverse B j μ c hShift : H → H) := by
  simpa only [positiveInverse, ContinuousLinearMap.coe_comp'] using
    hjCompact.comp_clm (solutionMap B j μ c hShift)

theorem negativeShiftResolventInverse_isCompact
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    IsCompactOperator
      (negativeShiftResolventInverse B j μ c hShift : H → H) := by
  simpa only [negativeShiftResolventInverse, ContinuousLinearMap.coe_neg'] using
    (positiveInverse_isCompact B j μ c hShift hjCompact).neg

theorem negativeShiftResolventData_isCompact
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    (negativeShiftResolventData B j hj hjDense μ c hShift).IsCompactResolvent :=
  negativeShiftResolventInverse_isCompact B j μ c hShift hjCompact

/-- A compact form embedding supplies a genuine compact resolvent at `-μ`. -/
theorem realization_hasCompactResolventAt_negShift
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt (QYM.FormDomainRealizationExtension.realization B j hj hjDense) (-μ) :=
  QYM.UnboundedResolventDataExtension.hasCompactResolventAt_of_supplier
    (negativeShiftResolventData B j hj hjDense μ c hShift)
    (negativeShiftResolventData_isCompact
      B j hj hjDense μ c hShift hjCompact)

end CompleteSpaces

end QYM.CoerciveFormFriedrichsExtension

/-!
# Paper-normalized coercive-form Friedrichs realization

These closed propositions attach the constructive real-Hilbert-space form
realization to Lemmas 4.13, 4.16, and 4.18 and Proposition 4.23.  The only
nonstructural analytic hypothesis is the displayed positive Gårding bound
`IsPositiveCoerciveShift`.  Density, self-adjointness, inverse equations, and
compact resolvent are conclusions of the actual Lax--Milgram construction.
-/

namespace QYM.FullCertification.PaperNormalized

open Set
open QYM.CoerciveFormFriedrichsExtension
open scoped InnerProduct RealInnerProductSpace

/-! ## Lemma 4.13: genuine self-adjoint form realization -/

/-- A complete form space, an injective dense continuous embedding, a bounded
symmetric form, and a displayed positive Gårding shift produce a densely
defined self-adjoint `LinearPMap`; its positive shift is genuinely bijective. -/
def lemma4_13_coerciveFriedrichsRealizationStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hSymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c),
    let A := QYM.FormDomainRealizationExtension.realization B j hj hjDense
    Dense (A.domain : Set H) ∧
      IsSelfAdjoint A ∧
        Function.Bijective (positiveShift A μ)

theorem lemma4_13_coerciveFriedrichsRealizationStatement_holds :
    lemma4_13_coerciveFriedrichsRealizationStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense hSymm μ c hShift
  dsimp only
  exact
    ⟨realization_domain_dense B j hj hjDense μ c hShift,
      realization_isSelfAdjoint hj hjDense hSymm hShift,
      positiveShift_bijective B j hj hjDense μ c hShift⟩

/-! ## Lemma 4.16: exact shifted solvability on the actual domain -/

/-- Every ambient datum has a unique solution in the genuine operator domain
to `(A + μ)x = h`; no abstract inverse supplier is assumed. -/
def lemma4_16_coerciveShiftUniqueSolutionStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
      (h : H),
    let A := QYM.FormDomainRealizationExtension.realization B j hj hjDense
    ∃! x : A.domain, positiveShift A μ x = h

theorem lemma4_16_coerciveShiftUniqueSolutionStatement_holds :
    lemma4_16_coerciveShiftUniqueSolutionStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense μ c hShift h
  dsimp only
  refine ⟨solutionDomainLift B j hj hjDense μ c hShift h,
    positiveShift_solutionDomainLift B j hj hjDense μ c hShift h, ?_⟩
  intro x hx
  exact positiveShift_injective B j hj hjDense μ c hShift
    (hx.trans (positiveShift_solutionDomainLift
      B j hj hjDense μ c hShift h).symm)

/-! ## Lemma 4.18: a genuine resolvent of the self-adjoint realization -/

/-- At `z=-μ` the constructed `LinearPMap` has explicit two-sided continuous
resolvent data; its inverse range is the actual operator domain and the
operator is closed and self-adjoint. -/
def lemma4_18_coerciveFriedrichsResolventStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hSymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c),
    let A := QYM.FormDomainRealizationExtension.realization B j hj hjDense
    ∃ ρ : QYM.UnboundedResolventDataExtension.ResolventData A (-μ),
      ρ.inverse = negativeShiftResolventInverse B j μ c hShift ∧
        Set.range ρ.inverse = (A.domain : Set H) ∧
          A.IsClosed ∧ IsSelfAdjoint A

theorem lemma4_18_coerciveFriedrichsResolventStatement_holds :
    lemma4_18_coerciveFriedrichsResolventStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense hSymm μ c hShift
  dsimp only
  let ρ := negativeShiftResolventData B j hj hjDense μ c hShift
  refine ⟨ρ, rfl, ρ.range_inverse_eq_domain, ρ.isClosed, ?_⟩
  exact realization_isSelfAdjoint hj hjDense hSymm hShift

/-! ## Proposition 4.23: compact embedding gives compact resolvent -/

/-- If the actual form embedding is compact, the explicit resolvent at
`-μ` is compact and hence supplies `HasCompactResolventAt`. -/
def prop4_23_coerciveFormCompactResolventStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
      (hjCompact : IsCompactOperator (j : V → H)),
    let A := QYM.FormDomainRealizationExtension.realization B j hj hjDense
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt A (-μ) ∧
      (negativeShiftResolventData
        B j hj hjDense μ c hShift).IsCompactResolvent

theorem prop4_23_coerciveFormCompactResolventStatement_holds :
    prop4_23_coerciveFormCompactResolventStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense μ c hShift hjCompact
  dsimp only
  exact
    ⟨realization_hasCompactResolventAt_negShift
        B j hj hjDense μ c hShift hjCompact,
      negativeShiftResolventData_isCompact
        B j hj hjDense μ c hShift hjCompact⟩

end QYM.FullCertification.PaperNormalized

/-!
# Typed evidence for the constructive coercive-form realization

This eighth independent registry records the four exact paper-normalized propositions proved by
the shifted coercive-form/Lax--Milgram construction.  The propositions construct density,
self-adjointness, the genuine `LinearPMap` resolvent, and compact resolvent from the displayed
Gårding inequality and (for compactness) an actual compact form embedding.  They do not assert
that the paper's concrete q--Yang--Mills form has already supplied those analytic hypotheses.
-/

namespace QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension

open QYM.FullCertification.Registry

inductive EvidenceId where
  | coerciveFriedrichsRealization
  | coerciveShiftUniqueSolution
  | coerciveFriedrichsResolvent
  | coerciveFormCompactResolvent
  deriving DecidableEq, Repr

/-- The exact closed proposition carried by each evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .coerciveFriedrichsRealization =>
      QYM.FullCertification.PaperNormalized.lemma4_13_coerciveFriedrichsRealizationStatement.{0, 0}
  | .coerciveShiftUniqueSolution =>
      QYM.FullCertification.PaperNormalized.lemma4_16_coerciveShiftUniqueSolutionStatement.{0, 0}
  | .coerciveFriedrichsResolvent =>
      QYM.FullCertification.PaperNormalized.lemma4_18_coerciveFriedrichsResolventStatement.{0, 0}
  | .coerciveFormCompactResolvent =>
      QYM.FullCertification.PaperNormalized.prop4_23_coerciveFormCompactResolventStatement.{0, 0}

theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | coerciveFriedrichsRealization =>
      exact
        QYM.FullCertification.PaperNormalized.lemma4_13_coerciveFriedrichsRealizationStatement_holds
  | coerciveShiftUniqueSolution =>
      exact
        QYM.FullCertification.PaperNormalized.lemma4_16_coerciveShiftUniqueSolutionStatement_holds
  | coerciveFriedrichsResolvent =>
      exact
        QYM.FullCertification.PaperNormalized.lemma4_18_coerciveFriedrichsResolventStatement_holds
  | coerciveFormCompactResolvent =>
      exact
        QYM.FullCertification.PaperNormalized.prop4_23_coerciveFormCompactResolventStatement_holds

structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement id

def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

def allEvidence : List EvidenceId :=
  [.coerciveFriedrichsRealization,
   .coerciveShiftUniqueSolution,
   .coerciveFriedrichsResolvent,
   .coerciveFormCompactResolvent]

def allCertificates : List Certificate :=
  allEvidence.map certificate

theorem allEvidence_length : allEvidence.length = 4 := by
  decide

theorem allCertificates_length : allCertificates.length = 4 := by
  decide

theorem allEvidence_nodup : allEvidence.Nodup := by
  decide

theorem allEvidence_complete (evidence : EvidenceId) :
    evidence ∈ allEvidence := by
  cases evidence <;> simp [allEvidence]

theorem allCertificates_ids :
    allCertificates.map Certificate.id = allEvidence := by
  simp only [allCertificates, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) allEvidence = allEvidence
  rfl

def evidenceForClaim : ClaimId → List EvidenceId
  | .lemma4_13 => [.coerciveFriedrichsRealization]
  | .lemma4_16 => [.coerciveShiftUniqueSolution]
  | .lemma4_18 => [.coerciveFriedrichsResolvent]
  | .prop4_23 => [.coerciveFormCompactResolvent]
  | _ => []

def certificatesForClaim (claim : ClaimId) : List Certificate :=
  (evidenceForClaim claim).map certificate

theorem certificatesForClaim_ids (claim : ClaimId) :
    (certificatesForClaim claim).map Certificate.id = evidenceForClaim claim := by
  simp only [certificatesForClaim, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) (evidenceForClaim claim) =
    evidenceForClaim claim
  cases claim <;> rfl

theorem linkedEvidence_sound {claim : ClaimId} {evidence : EvidenceId}
    (_h : evidence ∈ evidenceForClaim claim) : EvidenceStatement evidence :=
  evidenceSound evidence

theorem evidenceForClaim_nodup (claim : ClaimId) :
    (evidenceForClaim claim).Nodup := by
  cases claim <;> decide

def claimsWithEvidence : List ClaimId :=
  allClaims.filter fun claim => !(evidenceForClaim claim).isEmpty

theorem claimsWithEvidence_length : claimsWithEvidence.length = 4 := by
  decide

def evidencePairs : List (ClaimId × EvidenceId) :=
  allClaims.flatMap fun claim =>
    (evidenceForClaim claim).map fun evidence => (claim, evidence)

theorem evidencePairs_length : evidencePairs.length = 4 := by
  decide

theorem allEvidence_used (evidence : EvidenceId) :
    ∃ claim : ClaimId, evidence ∈ evidenceForClaim claim := by
  cases evidence with
  | coerciveFriedrichsRealization => exact ⟨.lemma4_13, by simp [evidenceForClaim]⟩
  | coerciveShiftUniqueSolution => exact ⟨.lemma4_16, by simp [evidenceForClaim]⟩
  | coerciveFriedrichsResolvent => exact ⟨.lemma4_18, by simp [evidenceForClaim]⟩
  | coerciveFormCompactResolvent => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩

end QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension

open Set

/-!
# Bounded self-adjoint perturbations of genuine partial Hilbert operators

This file supplies the operator-level part of the bounded shadow regime.  The unbounded
operator is a Mathlib `LinearPMap`; the perturbation is an everywhere-defined
`ContinuousLinearMap`.  No self-adjointness or domain conclusion is stored in an input
certificate.

The proof is deliberately split at the adjoint-domain step.  If `S = A + B` and
`y ∈ dom(S†)`, then `S†y - By` represents the functional induced by `A` at `y`.  Hence
`y ∈ dom(A†) = dom(A)`.  This gives the difficult reverse inclusion `S† ≤ S`.
-/

namespace QYM.BoundedSelfAdjointPMapPerturbationExtension

variable {𝕜 H : Type*}
variable [RCLike 𝕜]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

/-- Add an everywhere-defined linear map to a partial operator without changing its domain. -/
def addEverywhere (B : H →ₗ[𝕜] H) (A : H →ₗ.[𝕜] H) : H →ₗ.[𝕜] H :=
  B +ᵥ A

@[simp]
theorem addEverywhere_domain (B : H →ₗ[𝕜] H) (A : H →ₗ.[𝕜] H) :
    (addEverywhere B A).domain = A.domain :=
  rfl

@[simp]
theorem addEverywhere_apply (B : H →ₗ[𝕜] H) (A : H →ₗ.[𝕜] H)
    (x : (addEverywhere B A).domain) :
    addEverywhere B A x = B (x : H) + A x :=
  rfl

/-- Density is preserved because an everywhere-defined summand does not shrink the domain. -/
theorem addEverywhere_domain_dense
    (B : H →ₗ[𝕜] H) {A : H →ₗ.[𝕜] H}
    (hA : Dense (A.domain : Set H)) :
    Dense ((addEverywhere B A).domain : Set H) := by
  simpa [addEverywhere] using hA

/-- The sum of a symmetric partial operator and a symmetric everywhere-defined operator is
again symmetric on the unchanged partial domain. -/
theorem addEverywhere_isFormalAdjoint
    {B : H →ₗ[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : B.IsSymmetric) (hA : A.IsFormalAdjoint A) :
    (addEverywhere B A).IsFormalAdjoint (addEverywhere B A) := by
  intro x y
  rw [addEverywhere_apply, addEverywhere_apply, inner_add_left, inner_add_right]
  rw [hB (x : H) (y : H), hA x y]

/-- A self-adjoint partial operator is symmetric, written here as a reusable formal-adjoint
statement rather than hidden behind rewriting of the star operation. -/
theorem selfAdjoint_isFormalAdjoint
    {A : H →ₗ.[𝕜] H} (hA : IsSelfAdjoint A) :
    A.IsFormalAdjoint A := by
  have hformal : A.adjoint.IsFormalAdjoint A :=
    LinearPMap.adjoint_isFormalAdjoint hA.dense_domain
  rw [LinearPMap.isSelfAdjoint_def.mp hA] at hformal
  exact hformal

/-- The crucial reverse domain inclusion for bounded perturbations.

For `y ∈ dom((B + A)†)`, the vector `(B + A)† y - B y` is an ambient representer for
`x ↦ ⟪y, A x⟫`.  Self-adjointness of `A` therefore puts `y` back in `dom(A)`.
-/
theorem adjoint_domain_le_base_domain
    {B : H →ₗ[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : B.IsSymmetric) (hA : IsSelfAdjoint A) :
    (addEverywhere B A).adjoint.domain ≤ A.domain := by
  intro y hy
  let yAdj : (addEverywhere B A).adjoint.domain := ⟨y, hy⟩
  have hDense : Dense ((addEverywhere B A).domain : Set H) :=
    addEverywhere_domain_dense B hA.dense_domain
  have hAdjFormal :
      (addEverywhere B A).adjoint.IsFormalAdjoint (addEverywhere B A) :=
    LinearPMap.adjoint_isFormalAdjoint hDense
  have hyAdjoint : y ∈ A.adjoint.domain := by
    apply LinearPMap.mem_adjoint_domain_of_exists y
    refine ⟨(addEverywhere B A).adjoint yAdj - B y, ?_⟩
    intro x
    calc
      ⟪(addEverywhere B A).adjoint yAdj - B y, (x : H)⟫ =
          ⟪(addEverywhere B A).adjoint yAdj, (x : H)⟫ - ⟪B y, (x : H)⟫ := by
            rw [inner_sub_left]
      _ = ⟪y, addEverywhere B A x⟫ - ⟪y, B (x : H)⟫ := by
            rw [hAdjFormal yAdj x, hB y (x : H)]
      _ = ⟪y, A x⟫ := by
            change
              ⟪y, B (x : H) + A x⟫ - ⟪y, B (x : H)⟫ = ⟪y, A x⟫
            rw [inner_add_right]
            exact add_sub_cancel_left _ _
  have hAdjointEq : A.adjoint = A :=
    LinearPMap.isSelfAdjoint_def.mp hA
  rw [hAdjointEq] at hyAdjoint
  exact hyAdjoint

/-- Reverse operator inclusion: the adjoint of the perturbed operator contains no new domain
vectors and agrees with the original sum on that domain. -/
theorem adjoint_le_addEverywhere
    {B : H →ₗ[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : B.IsSymmetric) (hA : IsSelfAdjoint A) :
    (addEverywhere B A).adjoint ≤ addEverywhere B A := by
  have hDense : Dense ((addEverywhere B A).domain : Set H) :=
    addEverywhere_domain_dense B hA.dense_domain
  have hSymm :
      (addEverywhere B A).IsFormalAdjoint (addEverywhere B A) :=
    addEverywhere_isFormalAdjoint hB (selfAdjoint_isFormalAdjoint hA)
  refine ⟨?_, ?_⟩
  · intro y hy
    show y ∈ A.domain
    exact adjoint_domain_le_base_domain hB hA hy
  · intro y x hxy
    apply LinearPMap.adjoint_apply_eq hDense y
    intro u
    rw [hxy]
    exact hSymm x u

/-- **Bounded perturbation theorem for genuine unbounded operators.**  Adding an
everywhere-defined symmetric linear map to a self-adjoint `LinearPMap` preserves
self-adjointness and preserves its domain exactly. -/
theorem addEverywhere_isSelfAdjoint
    {B : H →ₗ[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : B.IsSymmetric) (hA : IsSelfAdjoint A) :
    IsSelfAdjoint (addEverywhere B A) := by
  rw [LinearPMap.isSelfAdjoint_def]
  apply le_antisymm
  · exact adjoint_le_addEverywhere hB hA
  · exact
      LinearPMap.IsFormalAdjoint.le_adjoint
        (addEverywhere_domain_dense B hA.dense_domain)
        (addEverywhere_isFormalAdjoint hB (selfAdjoint_isFormalAdjoint hA))

/-- Version matching the paper's bounded self-adjoint multiplier hypothesis. -/
theorem addContinuous_isSelfAdjoint
    {B : H →L[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : IsSelfAdjoint B) (hA : IsSelfAdjoint A) :
    IsSelfAdjoint (addEverywhere B.toLinearMap A) :=
  addEverywhere_isSelfAdjoint hB.isSymmetric hA

/-- The complete structural output used by the bounded shadow regime: same domain, dense
domain, self-adjointness, and closed graph. -/
theorem boundedPerturbation_bundle
    {B : H →L[𝕜] H} {A : H →ₗ.[𝕜] H}
    (hB : IsSelfAdjoint B) (hA : IsSelfAdjoint A) :
    (addEverywhere B.toLinearMap A).domain = A.domain ∧
      Dense ((addEverywhere B.toLinearMap A).domain : Set H) ∧
      IsSelfAdjoint (addEverywhere B.toLinearMap A) ∧
      (addEverywhere B.toLinearMap A).IsClosed := by
  have hSelf : IsSelfAdjoint (addEverywhere B.toLinearMap A) :=
    addContinuous_isSelfAdjoint hB hA
  exact ⟨rfl, addEverywhere_domain_dense B.toLinearMap hA.dense_domain,
    hSelf, hSelf.isClosed⟩

/-! ## Quantitative lower-bound transfer in the real Hilbert case -/

/-- The diagonal matrix coefficient of a bounded real Hilbert operator is controlled by its
operator norm.  Symmetry is not needed for this estimate. -/
theorem abs_inner_apply_self_le_opNorm
    {H₀ : Type*} [NormedAddCommGroup H₀] [InnerProductSpace ℝ H₀]
    (B : H₀ →L[ℝ] H₀) (x : H₀) :
    |inner ℝ (B x) x| ≤ ‖B‖ * ‖x‖ ^ 2 := by
  calc
    |inner ℝ (B x) x| ≤ ‖B x‖ * ‖x‖ :=
      abs_real_inner_le_norm (B x) x
    _ ≤ (‖B‖ * ‖x‖) * ‖x‖ :=
      mul_le_mul_of_nonneg_right (B.le_opNorm x) (norm_nonneg x)
    _ = ‖B‖ * ‖x‖ ^ 2 := by
      simp only [pow_two, mul_assoc]

/-- A lower form bound for a self-adjoint unbounded operator loses at most the operator norm of
an added bounded term.  This is the precise lower-boundedness assertion used in the paper's B1
regime. -/
theorem real_lowerBound_addContinuous
    {H₀ : Type*}
    [NormedAddCommGroup H₀] [InnerProductSpace ℝ H₀] [CompleteSpace H₀]
    {A : H₀ →ₗ.[ℝ] H₀} (B : H₀ →L[ℝ] H₀) (c : ℝ)
    (hLower : ∀ x : A.domain,
      c * ‖(x : H₀)‖ ^ 2 ≤ inner ℝ (A x) (x : H₀))
    (x : (addEverywhere B.toLinearMap A).domain) :
    (c - ‖B‖) * ‖(x : H₀)‖ ^ 2 ≤
      inner ℝ (addEverywhere B.toLinearMap A x) (x : H₀) := by
  calc
    (c - ‖B‖) * ‖(x : H₀)‖ ^ 2 =
        c * ‖(x : H₀)‖ ^ 2 - ‖B‖ * ‖(x : H₀)‖ ^ 2 := by
          rw [sub_mul]
    _ ≤ inner ℝ (A x) (x : H₀) - |inner ℝ (B (x : H₀)) (x : H₀)| :=
      sub_le_sub (hLower x) (abs_inner_apply_self_le_opNorm B (x : H₀))
    _ ≤ inner ℝ (A x) (x : H₀) + inner ℝ (B (x : H₀)) (x : H₀) := by
      rw [sub_eq_add_neg]
      exact add_le_add_right
        (neg_abs_le (inner ℝ (B (x : H₀)) (x : H₀)))
        (inner ℝ (A x) (x : H₀))
    _ = inner ℝ (addEverywhere B.toLinearMap A x) (x : H₀) := by
      change
        inner ℝ (A x) (x : H₀) + inner ℝ (B (x : H₀)) (x : H₀) =
          inner ℝ (B (x : H₀) + A x) (x : H₀)
      rw [inner_add_left, add_comm]

end QYM.BoundedSelfAdjointPMapPerturbationExtension

/-!
# Paper-normalized bounded shadow statement

These closed propositions formalize B1 operator-theoretic components associated with Definition
4.8 and Lemma 4.30.  They quantify over actual Hilbert spaces, an actual self-adjoint `LinearPMap`,
and an actual bounded self-adjoint `ContinuousLinearMap`; they do not claim statement-level
equivalence to the full paper rows.
-/

namespace QYM.FullCertification.PaperNormalized

/-- In the bounded regime, the operator sum has exactly the original unbounded domain and is
dense, self-adjoint, and closed. -/
def lemma4_30_boundedLinearPMapPerturbationB1ComponentStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (A : H →ₗ.[𝕜] H) (B : H →L[𝕜] H),
    IsSelfAdjoint A →
    IsSelfAdjoint B →
      (QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
          B.toLinearMap A).domain = A.domain ∧
        Dense
          ((QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
              B.toLinearMap A).domain : Set H) ∧
        IsSelfAdjoint
          (QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
            B.toLinearMap A) ∧
        (QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
          B.toLinearMap A).IsClosed

theorem lemma4_30_boundedLinearPMapPerturbationB1ComponentStatement_holds :
    lemma4_30_boundedLinearPMapPerturbationB1ComponentStatement := by
  intro 𝕜 H instRCLike instNormed instInner instComplete A B hA hB
  exact
    QYM.BoundedSelfAdjointPMapPerturbationExtension.boundedPerturbation_bundle hB hA

/-- The real lower-bound part of Lemma 4.30(B1): a bounded correction lowers the displayed
quadratic-form constant by no more than its operator norm. -/
def lemma4_30_boundedLinearPMapLowerBoundB1ComponentStatement : Prop :=
  ∀ (H : Type*)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (A : H →ₗ.[ℝ] H) (B : H →L[ℝ] H) (c : ℝ),
    (∀ x : A.domain,
      c * ‖(x : H)‖ ^ 2 ≤ inner ℝ (A x) (x : H)) →
      ∀ x :
          (QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
            B.toLinearMap A).domain,
        (c - ‖B‖) * ‖(x : H)‖ ^ 2 ≤
          inner ℝ
            (QYM.BoundedSelfAdjointPMapPerturbationExtension.addEverywhere
              B.toLinearMap A x)
            (x : H)

theorem lemma4_30_boundedLinearPMapLowerBoundB1ComponentStatement_holds :
    lemma4_30_boundedLinearPMapLowerBoundB1ComponentStatement := by
  intro H instNormed instInner instComplete A B c hLower x
  exact
    QYM.BoundedSelfAdjointPMapPerturbationExtension.real_lowerBound_addContinuous
      B c hLower x

end QYM.FullCertification.PaperNormalized

/-!
# Form-small perturbations of an actual Friedrichs `LinearPMap`

This file is an operator-level, real-Hilbert-space KLMN-style layer on top of
`FormDomainRealizationExtension` and `CoerciveFormFriedrichsExtension`.

For a bounded base form `B`, a bounded perturbing form `E`, and an embedding
`j : V →L[ℝ] H`, put

`C(u,v) = B(u,v) + μ ⟪j u, j v⟫_ℝ`.

The relative diagonal hypothesis used below is

`|E(u,u)| ≤ a C(u,u) + b ‖j u‖²`.

If `0 ≤ a < 1`, `0 ≤ b`, and `C(u,u) ≥ c ‖u‖²`, then no coercivity of the
perturbed form is assumed: it is proved, with the explicit residual estimate

`(B+E)(u,u) + (μ+b) ‖j u‖² ≥ (1-a)c ‖u‖²`.

That estimate is fed into the existing Lax--Milgram/Friedrichs construction.
Consequently the file constructs an actual Mathlib `LinearPMap`, proves its
dense domain and self-adjointness (with symmetry of both forms as a separate
hypothesis), and constructs genuine two-sided resolvent data.  Compactness of
`j` then proves compactness of the genuine resolvent.

The final scalar countermodel has `a = 1`: its perturbation cancels the full
base shifted form.  Thus the relative estimate still holds but every positive
residual coercivity bound fails.  This makes the strict threshold, or an
equivalent direct positive residual estimate, logically indispensable.
-/

namespace QYM.FormSmallOperatorPerturbationExtension

open InnerProductSpace Set
open scoped InnerProduct RealInnerProductSpace

variable {V H : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℝ V]
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

abbrev BilinearForm (V : Type*)
    [NormedAddCommGroup V] [InnerProductSpace ℝ V] :=
  V →L[ℝ] V →L[ℝ] ℝ

/-! ## Bounded perturbed forms and symmetry -/

/-- The bounded form obtained by adding the perturbation. -/
def perturbedForm (B E : BilinearForm V) : BilinearForm V :=
  B + E

@[simp]
theorem perturbedForm_apply (B E : BilinearForm V) (u v : V) :
    perturbedForm B E u v = B u v + E u v := by
  simp only [perturbedForm, ContinuousLinearMap.add_apply]

/-- Symmetry is deliberately required of the perturbation separately from
its diagonal relative bound. -/
theorem perturbedForm_isSymmetric
    {B E : BilinearForm V}
    (hB : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
    (hE : QYM.FormDomainRealizationExtension.IsSymmetricForm E) :
    QYM.FormDomainRealizationExtension.IsSymmetricForm (perturbedForm B E) := by
  intro u v
  rw [perturbedForm_apply, perturbedForm_apply, hB u v, hE u v]

/-! ## Relative diagonal form-smallness -/

/-- A transparent form-relative diagonal estimate.  The reference form is
the *shifted* base form, and the lower-order remainder is measured in the
ambient norm through `j`. -/
def HasRelativeDiagonalBound
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (μ a b : ℝ) : Prop :=
  ∀ u : V,
    |E u u| ≤
      a * QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u +
        b * ‖j u‖ * ‖j u‖

theorem HasRelativeDiagonalBound.lower
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ a b : ℝ}
    (hE : HasRelativeDiagonalBound B E j μ a b) (u : V) :
    -(a * QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u +
        b * ‖j u‖ * ‖j u‖) ≤ E u u := by
  calc
    -(a * QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u +
        b * ‖j u‖ * ‖j u‖) ≤ -|E u u| := neg_le_neg (hE u)
    _ ≤ E u u := neg_abs_le (E u u)

/-- Exact algebra behind the new shift `μ+b`. -/
theorem shifted_perturbed_identity
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (μ b : ℝ) (u v : V) :
    QYM.CoerciveFormFriedrichsExtension.shiftedForm
        (perturbedForm B E) j (μ + b) u v =
      QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u v +
        E u v + b * ⟪j u, j v⟫_ℝ := by
  rw [QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
    QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
    perturbedForm_apply]
  ring

/-- The relative estimate leaves the fraction `1-a` of the base shifted
form.  This is the central KLMN arithmetic step. -/
theorem relativeBound_residual_shifted_lowerBound
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ c a b : ℝ}
    (ha : a < 1)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b)
    (u : V) :
    (1 - a) * c * ‖u‖ * ‖u‖ ≤
      QYM.CoerciveFormFriedrichsExtension.shiftedForm
        (perturbedForm B E) j (μ + b) u u := by
  have hBaseLower :
      c * ‖u‖ * ‖u‖ ≤
        QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u :=
    hBase.hasCoercivityConstant u
  have hResidualNonnegative : 0 ≤ 1 - a := sub_nonneg.mpr (le_of_lt ha)
  have hScaled :
      (1 - a) * (c * ‖u‖ * ‖u‖) ≤
        (1 - a) *
          QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u :=
    mul_le_mul_of_nonneg_left hBaseLower hResidualNonnegative
  have hPerturbationLower := hE.lower u
  rw [shifted_perturbed_identity]
  calc
    (1 - a) * c * ‖u‖ * ‖u‖ =
        (1 - a) * (c * ‖u‖ * ‖u‖) := by ring
    _ ≤ (1 - a) *
        QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u := hScaled
    _ ≤ QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u +
        E u u + b * ⟪j u, j u⟫_ℝ := by
      rw [real_inner_self_eq_norm_sq, pow_two]
      linarith

/-- The residual lower bound as Mathlib's displayed coercivity-constant
predicate. -/
theorem relativeBound_hasCoercivityConstant
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ c a b : ℝ}
    (ha : a < 1)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    QYM.LaxMilgramFormExtension.HasCoercivityConstant
      (QYM.CoerciveFormFriedrichsExtension.shiftedForm
        (perturbedForm B E) j (μ + b)) ((1 - a) * c) := by
  intro u
  exact relativeBound_residual_shifted_lowerBound ha hBase hE u

/-- The same residual estimate in the transparent shifted-bound vocabulary
used by the Friedrichs layer. -/
theorem relativeBound_hasShiftedCoercivityBound
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ c a b : ℝ}
    (ha : a < 1)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    QYM.CoerciveFormFriedrichsExtension.HasShiftedCoercivityBound
      (perturbedForm B E) j (μ + b) ((1 - a) * c) := by
  intro u
  calc
    (1 - a) * c * ‖u‖ * ‖u‖ ≤
        QYM.CoerciveFormFriedrichsExtension.shiftedForm
          (perturbedForm B E) j (μ + b) u u :=
      relativeBound_residual_shifted_lowerBound ha hBase hE u
    _ = perturbedForm B E u u + (μ + b) * ‖j u‖ * ‖j u‖ := by
      rw [QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
        real_inner_self_eq_norm_sq, pow_two, mul_assoc]

/-- The shift and residual constant are both strictly positive under the
displayed side conditions. -/
theorem relativeBound_isPositiveCoerciveShift
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      (perturbedForm B E) j (μ + b) ((1 - a) * c) := by
  exact ⟨add_pos_of_pos_of_nonneg hBase.shift_pos hb,
    mul_pos (sub_pos.mpr ha1) hBase.coercivityConstant_pos,
    relativeBound_hasShiftedCoercivityBound ha1 hBase hE⟩

/-- In particular the perturbed shifted bounded form is actually coercive;
this is a conclusion, not an input. -/
theorem relativeBound_isCoercive
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    IsCoercive
      (QYM.CoerciveFormFriedrichsExtension.shiftedForm
        (perturbedForm B E) j (μ + b)) :=
  (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE).isCoercive

/-! ## An alternative direct residual-coercivity supplier -/

/-- A direct displayed residual estimate for the perturbed shifted form. -/
def HasResidualShiftedCoercivityBound
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (ν κ : ℝ) : Prop :=
  ∀ u : V,
    κ * ‖u‖ * ‖u‖ ≤
      perturbedForm B E u u + ν * ‖j u‖ * ‖j u‖

/-- A direct positive residual estimate is exactly enough to enter the
Friedrichs construction, independently of how it was obtained. -/
theorem directResidual_isPositiveCoerciveShift
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    {ν κ : ℝ}
    (hν : 0 < ν) (hκ : 0 < κ)
    (hResidual : HasResidualShiftedCoercivityBound B E j ν κ) :
    QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      (perturbedForm B E) j ν κ :=
  ⟨hν, hκ, hResidual⟩

/-! ## The actual perturbed `LinearPMap` -/

/-- The genuine partial operator constructed from the bounded perturbed
form.  Its domain is the ambiently representable form domain; it is not an
assumed operator certificate. -/
def perturbedRealization
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    H →ₗ.[ℝ] H :=
  QYM.FormDomainRealizationExtension.realization
    (perturbedForm B E) j hj hjDense

@[simp]
theorem perturbedRealization_domain
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    (perturbedRealization B E j hj hjDense).domain =
      QYM.FormDomainRealizationExtension.operatorDomain
        (perturbedForm B E) j :=
  rfl

theorem pair_mem_perturbedRealization_graph_iff
    (B E : BilinearForm V) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : V) (f : H) :
    (j u, f) ∈ (perturbedRealization B E j hj hjDense).graph ↔
      QYM.FormDomainRealizationExtension.Represents
        (perturbedForm B E) j u f := by
  exact QYM.FormDomainRealizationExtension.pair_mem_realization_graph_iff
    (perturbedForm B E) j hj hjDense u f

section CompleteSpaces

variable [CompleteSpace V] [CompleteSpace H]

/-! ## Relative-bound route to density and self-adjointness -/

theorem perturbedRealization_domain_dense
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    Dense ((perturbedRealization B E j hj hjDense).domain : Set H) := by
  exact QYM.CoerciveFormFriedrichsExtension.realization_domain_dense
    (perturbedForm B E) j hj hjDense (μ + b) ((1 - a) * c)
      (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE)

/-- Symmetry is used here, and not in the coercivity calculation. -/
theorem perturbedRealization_isSelfAdjoint
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hBsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
    (hEsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm E)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    IsSelfAdjoint (perturbedRealization B E j hj hjDense) := by
  exact QYM.CoerciveFormFriedrichsExtension.realization_isSelfAdjoint
    hj hjDense (perturbedForm_isSymmetric hBsymm hEsymm)
      (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE)

/-- The positive shifted perturbed operator is genuinely bijective on its
actual domain. -/
theorem perturbedPositiveShift_bijective
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    Function.Bijective
      (QYM.CoerciveFormFriedrichsExtension.positiveShift
        (perturbedRealization B E j hj hjDense) (μ + b)) := by
  exact QYM.CoerciveFormFriedrichsExtension.positiveShift_bijective
    (perturbedForm B E) j hj hjDense (μ + b) ((1 - a) * c)
      (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE)

/-! ## Quantitative lower-bound transfer to the actual operator -/

/-- The full residual lower bound on an actual operator-domain vector.  The
first norm is the unique form-domain coordinate of that vector. -/
theorem perturbedRealization_quantitativeLowerBound
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b)
    (x : (perturbedRealization B E j hj hjDense).domain) :
    (1 - a) * c *
          ‖(((QYM.FormDomainRealizationExtension.domainEquiv
              (perturbedForm B E) j hj).symm x :
                QYM.FormDomainRealizationExtension.formDomain
                  (perturbedForm B E) j) : V)‖ *
          ‖(((QYM.FormDomainRealizationExtension.domainEquiv
              (perturbedForm B E) j hj).symm x :
                QYM.FormDomainRealizationExtension.formDomain
                  (perturbedForm B E) j) : V)‖ -
        (μ + b) * ‖(x : H)‖ * ‖(x : H)‖ ≤
      ⟪perturbedRealization B E j hj hjDense x, (x : H)⟫_ℝ := by
  let u : QYM.FormDomainRealizationExtension.formDomain
      (perturbedForm B E) j :=
    (QYM.FormDomainRealizationExtension.domainEquiv
      (perturbedForm B E) j hj).symm x
  have hShift := relativeBound_isPositiveCoerciveShift
    ha0 ha1 hb hBase hE
  have hLower := hShift.2.2 (u : V)
  have hCoe : j (u : V) = (x : H) :=
    QYM.FormDomainRealizationExtension.coe_domainEquiv_symm
      (perturbedForm B E) j hj x
  have hNorm : ‖j (u : V)‖ = ‖(x : H)‖ := congrArg norm hCoe
  rw [hNorm] at hLower
  unfold perturbedRealization
  rw [QYM.FormDomainRealizationExtension.inner_realization_self
    (perturbedForm B E) j hj hjDense x]
  change (1 - a) * c * ‖(u : V)‖ * ‖(u : V)‖ -
      (μ + b) * ‖(x : H)‖ * ‖(x : H)‖ ≤
        perturbedForm B E (u : V) (u : V)
  linarith

/-- Dropping the nonnegative residual term gives the ambient semibound
`A ≥ -(μ+b)`. -/
theorem perturbedRealization_ambientLowerBound
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b)
    (x : (perturbedRealization B E j hj hjDense).domain) :
    -(μ + b) * ‖(x : H)‖ * ‖(x : H)‖ ≤
      ⟪perturbedRealization B E j hj hjDense x, (x : H)⟫_ℝ := by
  have hFull := perturbedRealization_quantitativeLowerBound
    hj hjDense ha0 ha1 hb hBase hE x
  have hResidual :
      0 ≤ (1 - a) * c *
        ‖(((QYM.FormDomainRealizationExtension.domainEquiv
            (perturbedForm B E) j hj).symm x :
              QYM.FormDomainRealizationExtension.formDomain
                (perturbedForm B E) j) : V)‖ *
        ‖(((QYM.FormDomainRealizationExtension.domainEquiv
            (perturbedForm B E) j hj).symm x :
              QYM.FormDomainRealizationExtension.formDomain
                (perturbedForm B E) j) : V)‖ := by
    have hCoefficient : 0 ≤ (1 - a) * c :=
      le_of_lt (mul_pos (sub_pos.mpr ha1) hBase.coercivityConstant_pos)
    exact mul_nonneg
      (mul_nonneg hCoefficient (norm_nonneg _)) (norm_nonneg _)
  linarith

/-! ## Genuine and compact resolvent -/

/-- Explicit two-sided resolvent data at `-(μ+b)`. -/
def perturbedNegativeShiftResolventData
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    QYM.UnboundedResolventDataExtension.ResolventData
      (perturbedRealization B E j hj hjDense) (-(μ + b)) :=
  QYM.CoerciveFormFriedrichsExtension.negativeShiftResolventData
    (perturbedForm B E) j hj hjDense (μ + b) ((1 - a) * c)
      (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE)

theorem perturbedRealization_hasResolventAt
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b) :
    QYM.UnboundedResolventDataExtension.HasResolventAt
      (perturbedRealization B E j hj hjDense) (-(μ + b)) :=
  ⟨perturbedNegativeShiftResolventData
    hj hjDense ha0 ha1 hb hBase hE⟩

theorem perturbedNegativeShiftResolventData_isCompact
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b)
    (hjCompact : IsCompactOperator (j : V → H)) :
    (perturbedNegativeShiftResolventData
      hj hjDense ha0 ha1 hb hBase hE).IsCompactResolvent := by
  exact QYM.CoerciveFormFriedrichsExtension.negativeShiftResolventData_isCompact
    (perturbedForm B E) j hj hjDense (μ + b) ((1 - a) * c)
      (relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE)
      hjCompact

/-- Compactness of the embedding proves compactness of the genuine
resolvent; compact resolvent is not an assumed field. -/
theorem perturbedRealization_hasCompactResolventAt
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {μ c a b : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) (hb : 0 ≤ b)
    (hBase : QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      B j μ c)
    (hE : HasRelativeDiagonalBound B E j μ a b)
    (hjCompact : IsCompactOperator (j : V → H)) :
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (perturbedRealization B E j hj hjDense) (-(μ + b)) :=
  QYM.UnboundedResolventDataExtension.hasCompactResolventAt_of_supplier
    (perturbedNegativeShiftResolventData
      hj hjDense ha0 ha1 hb hBase hE)
    (perturbedNegativeShiftResolventData_isCompact
      hj hjDense ha0 ha1 hb hBase hE hjCompact)

/-! ## Direct-residual route to the same actual operator conclusions -/

theorem directResidual_perturbedRealization_domain_dense
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {ν κ : ℝ} (hν : 0 < ν) (hκ : 0 < κ)
    (hResidual : HasResidualShiftedCoercivityBound B E j ν κ) :
    Dense ((perturbedRealization B E j hj hjDense).domain : Set H) := by
  exact QYM.CoerciveFormFriedrichsExtension.realization_domain_dense
    (perturbedForm B E) j hj hjDense ν κ
      (directResidual_isPositiveCoerciveShift hν hκ hResidual)

theorem directResidual_perturbedRealization_isSelfAdjoint
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hBsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
    (hEsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm E)
    {ν κ : ℝ} (hν : 0 < ν) (hκ : 0 < κ)
    (hResidual : HasResidualShiftedCoercivityBound B E j ν κ) :
    IsSelfAdjoint (perturbedRealization B E j hj hjDense) := by
  exact QYM.CoerciveFormFriedrichsExtension.realization_isSelfAdjoint
    hj hjDense (perturbedForm_isSymmetric hBsymm hEsymm)
      (directResidual_isPositiveCoerciveShift hν hκ hResidual)

theorem directResidual_perturbedRealization_hasCompactResolventAt
    {B E : BilinearForm V} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    {ν κ : ℝ} (hν : 0 < ν) (hκ : 0 < κ)
    (hResidual : HasResidualShiftedCoercivityBound B E j ν κ)
    (hjCompact : IsCompactOperator (j : V → H)) :
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (perturbedRealization B E j hj hjDense) (-ν) := by
  exact QYM.CoerciveFormFriedrichsExtension.realization_hasCompactResolventAt_negShift
    (perturbedForm B E) j hj hjDense ν κ
      (directResidual_isPositiveCoerciveShift hν hκ hResidual)
      hjCompact

end CompleteSpaces

/-! ## Sharp no-go at the threshold `a = 1` -/

/-- Identity embedding of the one-dimensional real Hilbert space. -/
def scalarEmbedding : ℝ →L[ℝ] ℝ :=
  ContinuousLinearMap.id ℝ ℝ

@[simp]
theorem scalarEmbedding_apply (x : ℝ) : scalarEmbedding x = x := by
  simp [scalarEmbedding]

theorem scalarEmbedding_injective : Function.Injective scalarEmbedding := by
  intro x y hxy
  simpa using hxy

theorem scalarEmbedding_denseRange : DenseRange scalarEmbedding := by
  have hSurjective : Function.Surjective scalarEmbedding := by
    intro y
    exact ⟨y, by simp⟩
  exact hSurjective.denseRange

theorem scalarEmbedding_isCompact :
    IsCompactOperator (scalarEmbedding : ℝ → ℝ) :=
  isCompactOperator_of_locallyCompactSpace_dom scalarEmbedding

/-- The zero base form. -/
def scalarBaseForm : BilinearForm ℝ := 0

@[simp]
theorem scalarBaseForm_apply (x y : ℝ) : scalarBaseForm x y = 0 := by
  rfl

theorem scalarBaseForm_isSymmetric :
    QYM.FormDomainRealizationExtension.IsSymmetricForm scalarBaseForm := by
  intro x y
  simp

/-- The perturbation which cancels the full shift at `μ=1`. -/
def scalarCancellationPerturbation : BilinearForm ℝ :=
  -QYM.CoerciveFormFriedrichsExtension.pullbackInnerForm scalarEmbedding

@[simp]
theorem scalarCancellationPerturbation_apply (x y : ℝ) :
    scalarCancellationPerturbation x y = -⟪x, y⟫_ℝ := by
  simp [scalarCancellationPerturbation]

theorem scalarCancellationPerturbation_isSymmetric :
    QYM.FormDomainRealizationExtension.IsSymmetricForm
      scalarCancellationPerturbation := by
  intro x y
  rw [scalarCancellationPerturbation_apply,
    scalarCancellationPerturbation_apply, real_inner_comm]

theorem scalarBase_positiveShift :
    QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      scalarBaseForm scalarEmbedding 1 1 := by
  exact ⟨by norm_num, by norm_num, by
    intro u
    simp [scalarBaseForm, scalarEmbedding,
      real_inner_self_eq_norm_sq, pow_two]⟩

theorem scalarCancellation_relativeBound_at_one :
    HasRelativeDiagonalBound scalarBaseForm scalarCancellationPerturbation
      scalarEmbedding 1 1 0 := by
  intro u
  rw [scalarCancellationPerturbation_apply, abs_neg]
  have hInner : 0 ≤ ⟪u, u⟫_ℝ := by
    rw [real_inner_self_eq_norm_sq]
    positivity
  rw [abs_of_nonneg hInner]
  simp [QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
    scalarBaseForm, scalarEmbedding, real_inner_self_eq_norm_sq, pow_two]

theorem scalarCancellation_zeroResidualBound :
    HasResidualShiftedCoercivityBound
      scalarBaseForm scalarCancellationPerturbation scalarEmbedding 1 0 := by
  intro u
  simp [HasResidualShiftedCoercivityBound, perturbedForm_apply,
    QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
    scalarBaseForm, scalarEmbedding, real_inner_self_eq_norm_sq, pow_two]

/-- At `a=1` the perturbed shifted form is identically zero, so no positive
coercivity constant exists. -/
theorem scalarCancellation_no_positiveResidual :
    ¬ ∃ κ : ℝ, 0 < κ ∧
      QYM.CoerciveFormFriedrichsExtension.HasShiftedCoercivityBound
        (perturbedForm scalarBaseForm scalarCancellationPerturbation)
          scalarEmbedding 1 κ := by
  rintro ⟨κ, hκ, hBound⟩
  have hAtOne := hBound (1 : ℝ)
  have hκNonpositive : κ ≤ 0 := by
    simpa [perturbedForm_apply,
      QYM.CoerciveFormFriedrichsExtension.shiftedForm_apply,
      scalarBaseForm, scalarEmbedding,
      real_inner_self_eq_norm_sq, pow_two] using hAtOne
  exact (not_le_of_gt hκ) hκNonpositive

/-- Closed countermodel: the relative estimate with `a=1`, and even a zero
residual estimate, do not imply any positive residual coercivity. -/
theorem relativeThreshold_one_countermodel :
    Function.Injective scalarEmbedding ∧
      DenseRange scalarEmbedding ∧
      IsCompactOperator (scalarEmbedding : ℝ → ℝ) ∧
      QYM.FormDomainRealizationExtension.IsSymmetricForm scalarBaseForm ∧
      QYM.FormDomainRealizationExtension.IsSymmetricForm
        scalarCancellationPerturbation ∧
      QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
        scalarBaseForm scalarEmbedding 1 1 ∧
      HasRelativeDiagonalBound scalarBaseForm scalarCancellationPerturbation
        scalarEmbedding 1 1 0 ∧
      HasResidualShiftedCoercivityBound
        scalarBaseForm scalarCancellationPerturbation scalarEmbedding 1 0 ∧
      ¬ ∃ κ : ℝ, 0 < κ ∧
        QYM.CoerciveFormFriedrichsExtension.HasShiftedCoercivityBound
          (perturbedForm scalarBaseForm scalarCancellationPerturbation)
            scalarEmbedding 1 κ :=
  ⟨scalarEmbedding_injective,
    scalarEmbedding_denseRange,
    scalarEmbedding_isCompact,
    scalarBaseForm_isSymmetric,
    scalarCancellationPerturbation_isSymmetric,
    scalarBase_positiveShift,
    scalarCancellation_relativeBound_at_one,
    scalarCancellation_zeroResidualBound,
    scalarCancellation_no_positiveResidual⟩

end QYM.FormSmallOperatorPerturbationExtension

/-!
# Paper-normalized operator form-small perturbation statements

These closed propositions expose B2 components and operator prerequisites associated with
Definition 4.8, Lemma 4.30, Theorem 4.31, and Corollary 4.32.  They do not claim
statement-level equivalence to those full paper rows.  They quantify
over actual real Hilbert spaces, actual bounded bilinear forms, an actual
injective dense compact embedding, Mathlib's actual `LinearPMap`, and genuine
two-sided resolvent data.

The diagonal relative estimate proves coercivity only.  Symmetry of `B` and
`E` is therefore kept as a separate premise exactly where self-adjointness is
concluded.  No operator, dense-domain, self-adjointness, inverse, or
compact-resolvent certificate occurs among the hypotheses.
-/

namespace QYM.FullCertification.PaperNormalized

open InnerProductSpace Set
open QYM.FormSmallOperatorPerturbationExtension
open scoped InnerProduct RealInnerProductSpace

/-! ## Definition 4.8: B2 shifted-relative-bound component -/

def def4_8_operatorRelativeFormSmallB2ComponentStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (μ a b : ℝ),
    HasRelativeDiagonalBound B E j μ a b ↔
      ∀ u : V,
        |E u u| ≤
          a * QYM.CoerciveFormFriedrichsExtension.shiftedForm B j μ u u +
            b * ‖j u‖ * ‖j u‖

theorem def4_8_operatorRelativeFormSmallB2ComponentStatement_holds :
    def4_8_operatorRelativeFormSmallB2ComponentStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH
    B E j μ a b
  rfl

/-! ## Lemma 4.30: the strict-threshold residual estimate -/

/-- The strict relative threshold derives, rather than assumes, the exact
new shift and residual coercivity constant. -/
def lemma4_30_operatorRelativeResidualCoercivityB2ComponentStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (μ c a b : ℝ),
    0 ≤ a → a < 1 → 0 ≤ b →
      QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
        B j μ c →
      HasRelativeDiagonalBound B E j μ a b →
        QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
            (perturbedForm B E) j (μ + b) ((1 - a) * c) ∧
          ∀ u : V,
            (1 - a) * c * ‖u‖ * ‖u‖ ≤
              QYM.CoerciveFormFriedrichsExtension.shiftedForm
                (perturbedForm B E) j (μ + b) u u

theorem lemma4_30_operatorRelativeResidualCoercivityB2ComponentStatement_holds :
    lemma4_30_operatorRelativeResidualCoercivityB2ComponentStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH
    B E j μ c a b ha0 ha1 hb hBase hE
  exact
    ⟨relativeBound_isPositiveCoerciveShift ha0 ha1 hb hBase hE,
      relativeBound_residual_shifted_lowerBound ha1 hBase hE⟩

/-- An independently supplied positive residual inequality is an alternative
honest entry point to the same Friedrichs construction. -/
def lemma4_30_operatorDirectResidualPrerequisiteStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (ν κ : ℝ),
    0 < ν → 0 < κ →
      HasResidualShiftedCoercivityBound B E j ν κ →
        QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
          (perturbedForm B E) j ν κ

theorem lemma4_30_operatorDirectResidualPrerequisiteStatement_holds :
    lemma4_30_operatorDirectResidualPrerequisiteStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH
    B E j ν κ hν hκ hResidual
  exact directResidual_isPositiveCoerciveShift hν hκ hResidual

/-! ## Lemma 4.30: actual perturbed self-adjoint realization -/

/-- Under the strict relative bound and separate symmetry hypotheses, the
bounded perturbed form constructs a densely defined self-adjoint
`LinearPMap`.  Its positive shift is bijective and the explicitly constructed
resolvent at `-(μ+b)` is a genuine compact resolvent. -/
def lemma4_30_operatorFormSmallFriedrichsB2ComponentStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hjCompact : IsCompactOperator (j : V → H))
      (hBsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm B)
      (hEsymm : QYM.FormDomainRealizationExtension.IsSymmetricForm E)
      (μ c a b : ℝ),
    0 ≤ a → a < 1 → 0 ≤ b →
      QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
        B j μ c →
      HasRelativeDiagonalBound B E j μ a b →
        let A := perturbedRealization B E j hj hjDense
        Dense (A.domain : Set H) ∧
          IsSelfAdjoint A ∧
            Function.Bijective
              (QYM.CoerciveFormFriedrichsExtension.positiveShift
                A (μ + b)) ∧
              ∃ ρ : QYM.UnboundedResolventDataExtension.ResolventData
                  A (-(μ + b)),
                ρ.IsCompactResolvent ∧
                  QYM.UnboundedResolventDataExtension.HasCompactResolventAt
                    A (-(μ + b))

theorem lemma4_30_operatorFormSmallFriedrichsB2ComponentStatement_holds :
    lemma4_30_operatorFormSmallFriedrichsB2ComponentStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B E j hj hjDense hjCompact hBsymm hEsymm
    μ c a b ha0 ha1 hb hBase hE
  dsimp only
  let ρ := perturbedNegativeShiftResolventData
    hj hjDense ha0 ha1 hb hBase hE
  exact
    ⟨perturbedRealization_domain_dense
        hj hjDense ha0 ha1 hb hBase hE,
      perturbedRealization_isSelfAdjoint
        hj hjDense hBsymm hEsymm ha0 ha1 hb hBase hE,
      perturbedPositiveShift_bijective
        hj hjDense ha0 ha1 hb hBase hE,
      ρ,
      perturbedNegativeShiftResolventData_isCompact
        hj hjDense ha0 ha1 hb hBase hE hjCompact,
      perturbedRealization_hasCompactResolventAt
        hj hjDense ha0 ha1 hb hBase hE hjCompact⟩

/-! ## Theorem 4.31: operator prerequisite for the min--max statement -/

/-- This is deliberately named a *prerequisite* statement.  The paper's
Theorem 4.31 is an eigenvalue interval obtained after a separate min--max
argument.  The proposition here proves only the quantitative operator lower
bound which that argument consumes; it does not claim an eigenvalue interval. -/
def theorem4_31_operatorPrerequisiteLowerBoundStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (μ c a b : ℝ),
    0 ≤ a → a < 1 → 0 ≤ b →
      QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
        B j μ c →
      HasRelativeDiagonalBound B E j μ a b →
        let A := perturbedRealization B E j hj hjDense
        (∀ x : A.domain,
          (1 - a) * c *
                ‖(((QYM.FormDomainRealizationExtension.domainEquiv
                    (perturbedForm B E) j hj).symm x :
                      QYM.FormDomainRealizationExtension.formDomain
                        (perturbedForm B E) j) : V)‖ *
                ‖(((QYM.FormDomainRealizationExtension.domainEquiv
                    (perturbedForm B E) j hj).symm x :
                      QYM.FormDomainRealizationExtension.formDomain
                        (perturbedForm B E) j) : V)‖ -
              (μ + b) * ‖(x : H)‖ * ‖(x : H)‖ ≤
            ⟪A x, (x : H)⟫_ℝ) ∧
          ∀ x : A.domain,
            -(μ + b) * ‖(x : H)‖ * ‖(x : H)‖ ≤
              ⟪A x, (x : H)⟫_ℝ

theorem theorem4_31_operatorPrerequisiteLowerBoundStatement_holds :
    theorem4_31_operatorPrerequisiteLowerBoundStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B E j hj hjDense μ c a b ha0 ha1 hb hBase hE
  dsimp only
  exact
    ⟨perturbedRealization_quantitativeLowerBound
        hj hjDense ha0 ha1 hb hBase hE,
      perturbedRealization_ambientLowerBound
        hj hjDense ha0 ha1 hb hBase hE⟩

/-! ## Corollary 4.32: compact-resolvent prerequisite for gap stability -/

/-- This proposition proves the compact-resolvent operator input used before
any gap-stability argument.  It intentionally makes no eigenvalue-ordering or
gap conclusion; those require the paper's separate min--max/spectral layer. -/
def cor4_32_operatorPrerequisiteCompactResolventStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B E : BilinearForm V) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hjCompact : IsCompactOperator (j : V → H))
      (μ c a b : ℝ),
    0 ≤ a → a < 1 → 0 ≤ b →
      QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
        B j μ c →
      HasRelativeDiagonalBound B E j μ a b →
        let A := perturbedRealization B E j hj hjDense
        QYM.UnboundedResolventDataExtension.HasCompactResolventAt
          A (-(μ + b)) ∧
          ∃ ρ : QYM.UnboundedResolventDataExtension.ResolventData
              A (-(μ + b)),
            ρ.IsCompactResolvent

theorem cor4_32_operatorPrerequisiteCompactResolventStatement_holds :
    cor4_32_operatorPrerequisiteCompactResolventStatement := by
  intro V H instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B E j hj hjDense hjCompact μ c a b ha0 ha1 hb hBase hE
  dsimp only
  exact
    ⟨perturbedRealization_hasCompactResolventAt
        hj hjDense ha0 ha1 hb hBase hE hjCompact,
      perturbedNegativeShiftResolventData
        hj hjDense ha0 ha1 hb hBase hE,
      perturbedNegativeShiftResolventData_isCompact
        hj hjDense ha0 ha1 hb hBase hE hjCompact⟩

/-! ## Sharpness: the strict threshold cannot be removed -/

/-- At `a=1`, the scalar cancellation perturbation satisfies the normalized
relative estimate but the residual shifted form is zero, so no positive
coercivity constant can exist. -/
def lemma4_30_operatorFormSmallThresholdNoGoStatement : Prop :=
  Function.Injective scalarEmbedding ∧
    DenseRange scalarEmbedding ∧
    IsCompactOperator (scalarEmbedding : ℝ → ℝ) ∧
    QYM.FormDomainRealizationExtension.IsSymmetricForm scalarBaseForm ∧
    QYM.FormDomainRealizationExtension.IsSymmetricForm
      scalarCancellationPerturbation ∧
    QYM.CoerciveFormFriedrichsExtension.IsPositiveCoerciveShift
      scalarBaseForm scalarEmbedding 1 1 ∧
    HasRelativeDiagonalBound scalarBaseForm scalarCancellationPerturbation
      scalarEmbedding 1 1 0 ∧
    HasResidualShiftedCoercivityBound
      scalarBaseForm scalarCancellationPerturbation scalarEmbedding 1 0 ∧
    ¬ ∃ κ : ℝ, 0 < κ ∧
      QYM.CoerciveFormFriedrichsExtension.HasShiftedCoercivityBound
        (perturbedForm scalarBaseForm scalarCancellationPerturbation)
          scalarEmbedding 1 κ

theorem lemma4_30_operatorFormSmallThresholdNoGoStatement_holds :
    lemma4_30_operatorFormSmallThresholdNoGoStatement :=
  relativeThreshold_one_countermodel

end QYM.FullCertification.PaperNormalized

/-!
# Coercive sesquilinear forms over an `RCLike` field

Mathlib's packaged Lax--Milgram theorem is presently stated only for real
bilinear forms.  This file proves the corresponding `RCLike` construction
without assuming a complex solution operator.  For a bounded sesquilinear
form

`B : V →L⋆[𝕜] V →L[𝕜] 𝕜`,

the first variable is conjugate-linear and the second variable is linear,
matching the convention `B u v = ⟪A u, j v⟫_𝕜`.  We restrict the real part of
the shifted form to the underlying real Hilbert space, apply Mathlib's actual
real Lax--Milgram theorem, and recover the full scalar equation by testing at
both `v` and `RCLike.I • v`.  The sign is isolated in
`eq_of_re_eq_of_re_I_mul_eq`.

The resulting solution is proved to be `𝕜`-linear by variational uniqueness.
It then gives an actual densely defined self-adjoint `LinearPMap`, genuine
two-sided `ResolventData` at the negative real shift, and compact resolvent
when the form embedding is compact.  No density, maximality, inverse, or
compactness conclusion is copied into an input certificate.
-/

namespace QYM.RCLikeCoerciveFormFriedrichsExtension

open InnerProductSpace Set
open scoped ComplexConjugate InnerProduct

variable {𝕜 V H : Type*}
variable [RCLike 𝕜]
variable [NormedAddCommGroup V] [InnerProductSpace 𝕜 V]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

local instance instRealInnerV : InnerProductSpace ℝ V :=
  InnerProductSpace.rclikeToReal 𝕜 V

local instance instRealInnerH : InnerProductSpace ℝ H :=
  InnerProductSpace.rclikeToReal 𝕜 H

local instance instRealScalarTowerV : IsScalarTower ℝ 𝕜 V :=
  RestrictScalars.isScalarTower _ _ _

local instance instRealScalarTowerH : IsScalarTower ℝ 𝕜 H :=
  RestrictScalars.isScalarTower _ _ _

/-- Continuous forms conjugate-linear in the first variable and linear in
the second variable. -/
abbrev SesqForm (𝕜 V : Type*) [RCLike 𝕜]
    [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] :=
  V →L⋆[𝕜] V →L[𝕜] 𝕜

/-! ## Scalar recovery from the realified equation -/

/-- The sign used by the realification argument:
`re (I * z) = -im z`. -/
theorem re_I_mul_eq_neg_im (z : 𝕜) :
    RCLike.re (RCLike.I * z) = -RCLike.im z :=
  RCLike.I_mul_re z

/-- Equality of real parts at `z` and at `I*z` determines an `RCLike`
scalar.  This simultaneously covers `ℝ` (where `I = 0` and every imaginary
part is zero) and `ℂ`. -/
theorem eq_of_re_eq_of_re_I_mul_eq {z w : 𝕜}
    (hre : RCLike.re z = RCLike.re w)
    (hI : RCLike.re (RCLike.I * z) =
      RCLike.re (RCLike.I * w)) :
    z = w := by
  apply RCLike.ext hre
  simpa only [re_I_mul_eq_neg_im, neg_inj] using hI

/-- The real part alone is not injective over `ℂ`; the extra `I` test above
is mathematically necessary. -/
theorem complex_realPart_only_noGo :
    ∃ z w : ℂ, z.re = w.re ∧ z ≠ w :=
  ⟨Complex.I, 0, by simp, Complex.I_ne_zero⟩

/-- A real-part identity for all test vectors recovers the complete
sesquilinear identity.  The `I` test is in the second, linear variable, so no
conjugation sign is introduced there. -/
theorem sesq_eq_of_re_eq
    (C : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (u : V) (h : H)
    (hRe : ∀ v : V,
      RCLike.re (C u v) = RCLike.re (inner 𝕜 h (j v))) :
    ∀ v : V, C u v = inner 𝕜 h (j v) := by
  intro v
  apply eq_of_re_eq_of_re_I_mul_eq (hRe v)
  have hIv := hRe ((RCLike.I : 𝕜) • v)
  simpa only [map_smul, inner_smul_right, smul_eq_mul] using hIv

/-! ## The actual form-domain realization -/

/-- `f` represents the form functional `B u` through the embedding `j`.
The orientation makes the selected representing vector linear in `u`. -/
def Represents
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (u : V) (f : H) : Prop :=
  ∀ v : V, B u v = inner 𝕜 f (j v)

theorem Represents.zero
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) :
    Represents B j 0 0 := by
  intro v
  simp [Represents]

theorem Represents.add
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    {u w : V} {f g : H}
    (hf : Represents B j u f) (hg : Represents B j w g) :
    Represents B j (u + w) (f + g) := by
  intro v
  calc
    B (u + w) v = B u v + B w v := by
      simp only [ContinuousLinearMap.map_add₂]
    _ = inner 𝕜 f (j v) + inner 𝕜 g (j v) := by
      rw [hf v, hg v]
    _ = inner 𝕜 (f + g) (j v) := (inner_add_left f g (j v)).symm

theorem Represents.smul
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    {u : V} {f : H} (hf : Represents B j u f) (a : 𝕜) :
    Represents B j (a • u) (a • f) := by
  intro v
  calc
    B (a • u) v = star a * B u v := by
      simp only [ContinuousLinearMap.map_smulₛₗ₂, starRingEnd_apply,
        smul_eq_mul]
    _ = star a * inner 𝕜 f (j v) := by rw [hf v]
    _ = inner 𝕜 (a • f) (j v) := (inner_smul_left f (j v) a).symm

/-- The form vectors whose functionals have ambient representing vectors. -/
def formDomain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) :
    Submodule 𝕜 V where
  carrier := {u | ∃ f : H, Represents B j u f}
  zero_mem' := ⟨0, Represents.zero B j⟩
  add_mem' := by
    rintro u w ⟨f, hf⟩ ⟨g, hg⟩
    exact ⟨f + g, hf.add hg⟩
  smul_mem' := by
    rintro a u ⟨f, hf⟩
    exact ⟨a • f, hf.smul a⟩

theorem mem_formDomain_iff
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) (u : V) :
    u ∈ formDomain B j ↔ ∃ f : H, Represents B j u f :=
  Iff.rfl

/-- Density of `j V` makes representing vectors unique. -/
theorem representingVector_unique
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    (hjDense : DenseRange j) {u : V} {f g : H}
    (hf : Represents B j u f) (hg : Represents B j u g) :
    f = g := by
  apply hjDense.eq_of_inner_left 𝕜
  intro v
  exact (hf v).symm.trans (hg v)

/-- The unique representing vector selected on `formDomain`. -/
noncomputable def representingVector
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (u : formDomain B j) : H :=
  Classical.choose u.property

theorem representingVector_spec
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (u : formDomain B j) :
    Represents B j (u : V) (representingVector B j u) :=
  Classical.choose_spec u.property

/-- The representative is a genuine complex/RCLike-linear map; its
linearity follows from the conjugate-linear first-variable convention and
uniqueness. -/
noncomputable def representingLinearMap
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hjDense : DenseRange j) :
    formDomain B j →ₗ[𝕜] H where
  toFun := representingVector B j
  map_add' u w :=
    representingVector_unique hjDense
      (representingVector_spec B j (u + w))
      ((representingVector_spec B j u).add
        (representingVector_spec B j w))
  map_smul' a u :=
    representingVector_unique hjDense
      (representingVector_spec B j (a • u))
      ((representingVector_spec B j u).smul a)

@[simp]
theorem representingLinearMap_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hjDense : DenseRange j) (u : formDomain B j) :
    representingLinearMap B j hjDense u = representingVector B j u :=
  rfl

theorem representingVector_eq_of_represents
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    (hjDense : DenseRange j) (u : formDomain B j) {f : H}
    (hf : Represents B j (u : V) f) :
    representingVector B j u = f :=
  representingVector_unique hjDense (representingVector_spec B j u) hf

/-- The embedding restricted to representable form vectors. -/
def formEmbedding
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) :
    formDomain B j →L[𝕜] H :=
  j.comp (Submodule.subtypeL (formDomain B j))

@[simp]
theorem formEmbedding_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (u : formDomain B j) :
    formEmbedding B j u = j (u : V) :=
  rfl

theorem formEmbedding_injective
    (B : SesqForm 𝕜 V) {j : V →L[𝕜] H}
    (hj : Function.Injective j) :
    Function.Injective (formEmbedding B j) := by
  intro u w huw
  apply Subtype.ext
  apply hj
  simpa only [formEmbedding_apply] using huw

/-- The ambient domain of the realized partial operator. -/
def operatorDomain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) :
    Submodule 𝕜 H :=
  LinearMap.range (formEmbedding B j).toLinearMap

/-- Coordinates between representable form vectors and their ambient image. -/
noncomputable def domainEquiv
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) :
    formDomain B j ≃ₗ[𝕜] operatorDomain B j :=
  LinearEquiv.ofInjective (formEmbedding B j).toLinearMap
    (formEmbedding_injective B hj)

@[simp]
theorem coe_domainEquiv_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (u : formDomain B j) :
    ((domainEquiv B j hj u : operatorDomain B j) : H) = j (u : V) := by
  change formEmbedding B j u = j (u : V)
  exact formEmbedding_apply B j u

theorem coe_domainEquiv_symm
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (x : operatorDomain B j) :
    j (((domainEquiv B j hj).symm x : formDomain B j) : V) = (x : H) := by
  calc
    j (((domainEquiv B j hj).symm x : formDomain B j) : V) =
        (((domainEquiv B j hj)
          ((domainEquiv B j hj).symm x) : operatorDomain B j) : H) :=
      (coe_domainEquiv_apply B j hj ((domainEquiv B j hj).symm x)).symm
    _ = (x : H) := congrArg Subtype.val
      ((domainEquiv B j hj).apply_symm_apply x)

/-- An embedded vector is in the actual operator domain exactly when its
form functional has an ambient representer. -/
theorem embed_mem_operatorDomain_iff
    (B : SesqForm 𝕜 V) {j : V →L[𝕜] H}
    (hj : Function.Injective j) (u : V) :
    j u ∈ operatorDomain B j ↔ ∃ f : H, Represents B j u f := by
  constructor
  · rintro ⟨w, hw⟩
    have hwu : (w : V) = u := by
      apply hj
      change formEmbedding B j w = j u at hw
      exact hw
    rcases w.property with ⟨f, hf⟩
    exact ⟨f, by simpa only [hwu] using hf⟩
  · intro hu
    refine ⟨⟨u, hu⟩, ?_⟩
    exact formEmbedding_apply B j ⟨u, hu⟩

/-- The actual `RCLike`-linear partial operator associated to `(B,j)`. -/
noncomputable def realization
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    H →ₗ.[𝕜] H where
  domain := operatorDomain B j
  toFun := (representingLinearMap B j hjDense).comp
    (domainEquiv B j hj).symm.toLinearMap

@[simp]
theorem realization_domain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    (realization B j hj hjDense).domain = operatorDomain B j :=
  rfl

theorem realization_apply_domainEquiv
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : formDomain B j) :
    realization B j hj hjDense (domainEquiv B j hj u) =
      representingVector B j u := by
  change representingLinearMap B j hjDense
      ((domainEquiv B j hj).symm (domainEquiv B j hj u)) = _
  rw [LinearEquiv.symm_apply_apply]
  rfl

theorem realization_represents
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (x : operatorDomain B j) :
    Represents B j
      (((domainEquiv B j hj).symm x : formDomain B j) : V)
      (realization B j hj hjDense x) := by
  let u : formDomain B j := (domainEquiv B j hj).symm x
  have hx : domainEquiv B j hj u = x :=
    (domainEquiv B j hj).apply_symm_apply x
  rw [← hx]
  simpa only [LinearEquiv.symm_apply_apply,
    realization_apply_domainEquiv] using representingVector_spec B j u

/-- The graph of the actual `LinearPMap` is precisely the form
representation relation. -/
theorem pair_mem_realization_graph_iff
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : V) (f : H) :
    (j u, f) ∈ (realization B j hj hjDense).graph ↔
      Represents B j u f := by
  constructor
  · intro hGraph
    rw [LinearPMap.mem_graph_iff] at hGraph
    rcases hGraph with ⟨x, hx, hValue⟩
    have hCoordinate :
        (((domainEquiv B j hj).symm x : formDomain B j) : V) = u := by
      apply hj
      exact (coe_domainEquiv_symm B j hj x).trans hx
    have hRep := realization_represents B j hj hjDense x
    intro v
    simpa only [hCoordinate, hValue] using hRep v
  · intro hRep
    let uD : formDomain B j := ⟨u, ⟨f, hRep⟩⟩
    let x : operatorDomain B j := domainEquiv B j hj uD
    rw [LinearPMap.mem_graph_iff]
    refine ⟨x, ?_, ?_⟩
    · simpa only [x, uD] using coe_domainEquiv_apply B j hj uD
    · calc
        realization B j hj hjDense x = representingVector B j uD := by
          simpa only [x] using
            realization_apply_domainEquiv B j hj hjDense uD
        _ = f := representingVector_unique hjDense
          (representingVector_spec B j uD) hRep

/-- Hermitian symmetry in the convention conjugate-linear in the first
variable. -/
def IsHermitianForm (B : SesqForm 𝕜 V) : Prop :=
  ∀ u v : V, B u v = star (B v u)

/-- A Hermitian form produces a genuinely symmetric `LinearPMap`. -/
theorem realization_isFormalAdjoint
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hB : IsHermitianForm B) :
    (realization B j hj hjDense).IsFormalAdjoint
      (realization B j hj hjDense) := by
  intro x y
  let u : formDomain B j := (domainEquiv B j hj).symm x
  let v : formDomain B j := (domainEquiv B j hj).symm y
  have hxRep := realization_represents B j hj hjDense x
  have hyRep := realization_represents B j hj hjDense y
  have hxCoe : j (u : V) = (x : H) := coe_domainEquiv_symm B j hj x
  have hyCoe : j (v : V) = (y : H) := coe_domainEquiv_symm B j hj y
  calc
    inner 𝕜 (realization B j hj hjDense x) (y : H) =
        inner 𝕜 (realization B j hj hjDense x) (j (v : V)) := by
      rw [hyCoe]
    _ = B (u : V) (v : V) := (hxRep (v : V)).symm
    _ = star (B (v : V) (u : V)) := hB (u : V) (v : V)
    _ = star (inner 𝕜 (realization B j hj hjDense y) (j (u : V))) := by
      rw [hyRep (u : V)]
    _ = inner 𝕜 (j (u : V)) (realization B j hj hjDense y) :=
      inner_conj_symm _ _
    _ = inner 𝕜 (x : H) (realization B j hj hjDense y) := by
      rw [hxCoe]

/-- Density of the abstract form domain and of `j` gives density of the
restricted embedding. -/
theorem formEmbedding_denseRange
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V)) :
    DenseRange (formEmbedding B j) := by
  have hcomp : DenseRange (j ∘ fun u : formDomain B j => (u : V)) :=
    hjDense.comp hFormDense.denseRange_val j.continuous
  change DenseRange (fun u : formDomain B j => j (u : V))
  change DenseRange (fun u : formDomain B j => j (u : V)) at hcomp
  exact hcomp

/-- Dense representable form vectors give a dense operator domain. -/
theorem realization_domain_dense_of_formDomain_dense
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V)) :
    Dense ((realization B j hj hjDense).domain : Set H) := by
  change Dense (operatorDomain B j : Set H)
  change Dense (Set.range (formEmbedding B j))
  exact formEmbedding_denseRange B j hjDense hFormDense

/-! ## Shifted form and its real coercivity -/

/-- Pull the ambient inner product back along `j`. -/
def pullbackInnerForm (j : V →L[𝕜] H) : SesqForm 𝕜 V :=
  (innerSL 𝕜).bilinearComp j j

@[simp]
theorem pullbackInnerForm_apply (j : V →L[𝕜] H) (u v : V) :
    pullbackInnerForm j u v = inner 𝕜 (j u) (j v) :=
  rfl

/-- The form shifted by a real multiple of the ambient inner product. -/
def shiftedForm
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H) (μ : ℝ) :
    SesqForm 𝕜 V :=
  B + (μ : 𝕜) • pullbackInnerForm j

@[simp]
theorem shiftedForm_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ : ℝ) (u v : V) :
    shiftedForm B j μ u v =
      B u v + (μ : 𝕜) * inner 𝕜 (j u) (j v) := by
  simp only [shiftedForm, pullbackInnerForm_apply,
    ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    smul_eq_mul]

/-- The underlying real bilinear form `re (C u v)`. -/
noncomputable def realPartForm (C : SesqForm 𝕜 V) :
    V →L[ℝ] V →L[ℝ] ℝ :=
  LinearMap.mkContinuous₂
    (LinearMap.mk₂ ℝ
      (fun u v => RCLike.re (C u v))
      (fun u w v => by
        rw [map_add, add_apply, map_add])
      (fun r u v => by
        change RCLike.re (C (r • u) v) = r * RCLike.re (C u v)
        rw [RCLike.real_smul_eq_coe_smul (K := 𝕜) r u, map_smulₛₗ,
          smul_apply, RCLike.conj_ofReal,
          smul_eq_mul, RCLike.re_ofReal_mul])
      (fun u v w => by rw [map_add, map_add])
      (fun r u v => by
        change RCLike.re (C u (r • v)) = r * RCLike.re (C u v)
        rw [RCLike.real_smul_eq_coe_smul (K := 𝕜) r v, map_smul,
          smul_eq_mul, RCLike.re_ofReal_mul]))
    ‖C‖
    (fun u v => by
      calc
        ‖RCLike.re (C u v)‖ ≤ ‖C u v‖ := RCLike.norm_re_le_norm _
        _ ≤ ‖C‖ * ‖u‖ * ‖v‖ := C.le_opNorm₂ u v)

@[simp]
theorem realPartForm_apply (C : SesqForm 𝕜 V) (u v : V) :
    realPartForm C u v = RCLike.re (C u v) :=
  rfl

theorem realPartForm_shifted_diagonal
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ : ℝ) (u : V) :
    realPartForm (shiftedForm B j μ) u u =
      RCLike.re (B u u) + μ * ‖j u‖ ^ 2 := by
  calc
    realPartForm (shiftedForm B j μ) u u =
        RCLike.re (shiftedForm B j μ u u) := rfl
    _ = RCLike.re
        (B u u + (μ : 𝕜) * inner 𝕜 (j u) (j u)) := by
      rw [shiftedForm_apply]
    _ = RCLike.re (B u u) +
        μ * RCLike.re (inner 𝕜 (j u) (j u)) := by
      rw [map_add, RCLike.re_ofReal_mul]
    _ = RCLike.re (B u u) + μ * ‖j u‖ ^ 2 := by
      rw [← norm_sq_eq_re_inner]

/-- A displayed real Gårding bound for the shifted sesquilinear form. -/
def HasShiftedCoercivityBound
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) : Prop :=
  ∀ u : V,
    c * ‖u‖ ^ 2 ≤ RCLike.re (B u u) + μ * ‖j u‖ ^ 2

/-- Transparent positivity and coercivity data. -/
def IsPositiveCoerciveShift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) : Prop :=
  0 < μ ∧ 0 < c ∧ HasShiftedCoercivityBound B j μ c

theorem IsPositiveCoerciveShift.shift_pos
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    0 < μ :=
  h.1

theorem IsPositiveCoerciveShift.constant_pos
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    0 < c :=
  h.2.1

/-- The displayed bound supplies exactly Mathlib's real `IsCoercive`
predicate after realification. -/
theorem IsPositiveCoerciveShift.realPart_isCoercive
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    {μ c : ℝ} (h : IsPositiveCoerciveShift B j μ c) :
    IsCoercive (realPartForm (shiftedForm B j μ)) := by
  refine ⟨c, h.constant_pos, ?_⟩
  intro u
  rw [realPartForm_shifted_diagonal]
  simpa only [pow_two, mul_assoc] using h.2.2 u

/-! ## Real Lax--Milgram and recovery of the complex equation -/

section CompleteSpaces

variable [CompleteSpace V] [CompleteSpace H]

/-- The solution furnished by Mathlib's actual real Lax--Milgram theorem,
viewed first as an `ℝ`-linear map. -/
noncomputable def realSolutionMap
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[ℝ] V :=
  (hShift.realPart_isCoercive.continuousLinearEquivOfBilin).symm.toContinuousLinearMap.comp
    (j.restrictScalars ℝ).adjoint

@[simp]
theorem realSolutionMap_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    realSolutionMap B j μ c hShift h =
      (hShift.realPart_isCoercive.continuousLinearEquivOfBilin).symm
        ((j.restrictScalars ℝ).adjoint h) :=
  rfl

/-- The exact real-part variational equation returned by real
Lax--Milgram. -/
theorem realSolutionMap_real_spec
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) (v : V) :
    realPartForm (shiftedForm B j μ)
        (realSolutionMap B j μ c hShift h) v =
      RCLike.re (inner 𝕜 h (j v)) := by
  let e : V ≃L[ℝ] V :=
    hShift.realPart_isCoercive.continuousLinearEquivOfBilin
  calc
    realPartForm (shiftedForm B j μ)
        (realSolutionMap B j μ c hShift h) v =
        inner ℝ (e (realSolutionMap B j μ c hShift h)) v :=
      (hShift.realPart_isCoercive.continuousLinearEquivOfBilin_apply
        (realSolutionMap B j μ c hShift h) v).symm
    _ = inner ℝ ((j.restrictScalars ℝ).adjoint h) v := by
      change inner ℝ (e (e.symm ((j.restrictScalars ℝ).adjoint h))) v = _
      rw [e.apply_symm_apply]
    _ = inner ℝ h (j v) :=
      (j.restrictScalars ℝ).adjoint_inner_left v h
    _ = RCLike.re (inner 𝕜 h (j v)) :=
      real_inner_eq_re_inner 𝕜 h (j v)

/-- Testing the real equation at `v` and `I • v` recovers the full
sesquilinear equation. -/
theorem realSolutionMap_complex_spec
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) (v : V) :
    shiftedForm B j μ (realSolutionMap B j μ c hShift h) v =
      inner 𝕜 h (j v) := by
  exact sesq_eq_of_re_eq (shiftedForm B j μ) j
    (realSolutionMap B j μ c hShift h) h
    (realSolutionMap_real_spec B j μ c hShift h) v

/-- Uniqueness is derived from injectivity of the actual real
Lax--Milgram equivalence. -/
theorem realSolutionMap_unique
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) {u : V}
    (hu : ∀ v : V, shiftedForm B j μ u v = inner 𝕜 h (j v)) :
    u = realSolutionMap B j μ c hShift h := by
  let e : V ≃L[ℝ] V :=
    hShift.realPart_isCoercive.continuousLinearEquivOfBilin
  apply e.injective
  apply ext_inner_right ℝ
  intro v
  rw [hShift.realPart_isCoercive.continuousLinearEquivOfBilin_apply,
    hShift.realPart_isCoercive.continuousLinearEquivOfBilin_apply]
  calc
    realPartForm (shiftedForm B j μ) u v =
        RCLike.re (shiftedForm B j μ u v) := rfl
    _ = RCLike.re (inner 𝕜 h (j v)) := congrArg RCLike.re (hu v)
    _ = realPartForm (shiftedForm B j μ)
        (realSolutionMap B j μ c hShift h) v :=
      (realSolutionMap_real_spec B j μ c hShift h v).symm

/-- The real solution commutes with arbitrary `RCLike` scalar
multiplication.  This is proved by variational uniqueness, not assumed as a
field in the realification data. -/
theorem realSolutionMap_smul
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (a : 𝕜) (h : H) :
    realSolutionMap B j μ c hShift (a • h) =
      a • realSolutionMap B j μ c hShift h := by
  symm
  apply realSolutionMap_unique B j μ c hShift (a • h)
  intro v
  simp only [ContinuousLinearMap.map_smulₛₗ₂, starRingEnd_apply,
    smul_eq_mul, realSolutionMap_complex_spec, inner_smul_left]

/-- The recovered solution as a genuine `𝕜`-continuous linear map. -/
noncomputable def solutionMap
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[𝕜] V :=
  ContinuousLinearMap.mk
    { toFun := realSolutionMap B j μ c hShift
      map_add' := (realSolutionMap B j μ c hShift).map_add
      map_smul' := realSolutionMap_smul B j μ c hShift }
    (realSolutionMap B j μ c hShift).continuous

@[simp]
theorem solutionMap_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    solutionMap B j μ c hShift h =
      realSolutionMap B j μ c hShift h :=
  rfl

/-- The genuine complex/RCLike variational equation. -/
theorem solutionMap_spec
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) (v : V) :
    shiftedForm B j μ (solutionMap B j μ c hShift h) v =
      inner 𝕜 h (j v) :=
  realSolutionMap_complex_spec B j μ c hShift h v

/-- Subtracting the real shift proves membership in the unshifted
representable form domain. -/
theorem solutionMap_represents
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    Represents B j (solutionMap B j μ c hShift h)
      (h - (μ : 𝕜) • j (solutionMap B j μ c hShift h)) := by
  intro v
  have hEquation := solutionMap_spec B j μ c hShift h v
  rw [shiftedForm_apply] at hEquation
  calc
    B (solutionMap B j μ c hShift h) v =
        inner 𝕜 h (j v) -
          (μ : 𝕜) * inner 𝕜 (j (solutionMap B j μ c hShift h)) (j v) := by
      exact eq_sub_iff_add_eq.mpr hEquation
    _ = inner 𝕜
        (h - (μ : 𝕜) • j (solutionMap B j μ c hShift h)) (j v) := by
      rw [inner_sub_left, inner_smul_left, RCLike.conj_ofReal]

/-- The variational solution bundled with proved form-domain membership. -/
def solutionFormDomain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : formDomain B j :=
  ⟨solutionMap B j μ c hShift h,
    ⟨h - (μ : 𝕜) • j (solutionMap B j μ c hShift h),
      solutionMap_represents B j μ c hShift h⟩⟩

@[simp]
theorem coe_solutionFormDomain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    (solutionFormDomain B j μ c hShift h : V) =
      solutionMap B j μ c hShift h :=
  rfl

/-! ## The actual positive shift and its two-sided inverse -/

/-- `A + μ` on the genuine domain of an `RCLike` `LinearPMap`. -/
def positiveShift (A : H →ₗ.[𝕜] H) (μ : ℝ) :
    A.domain →ₗ[𝕜] H :=
  A.toFun + (μ : 𝕜) • A.domain.subtype

@[simp]
theorem positiveShift_apply
    (A : H →ₗ.[𝕜] H) (μ : ℝ) (x : A.domain) :
    positiveShift A μ x = A x + (μ : 𝕜) • (x : H) :=
  rfl

/-- Lift the Lax--Milgram solution into the actual operator domain. -/
def solutionDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : (realization B j hj hjDense).domain :=
  domainEquiv B j hj (solutionFormDomain B j μ c hShift h)

@[simp]
theorem coe_solutionDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    ((solutionDomainLift B j hj hjDense μ c hShift h :
        (realization B j hj hjDense).domain) : H) =
      j (solutionMap B j μ c hShift h) :=
  coe_domainEquiv_apply B j hj (solutionFormDomain B j μ c hShift h)

theorem realization_solutionDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    realization B j hj hjDense
        (solutionDomainLift B j hj hjDense μ c hShift h) =
      h - (μ : 𝕜) • j (solutionMap B j μ c hShift h) := by
  calc
    realization B j hj hjDense
        (solutionDomainLift B j hj hjDense μ c hShift h) =
        representingVector B j (solutionFormDomain B j μ c hShift h) :=
      realization_apply_domainEquiv B j hj hjDense
        (solutionFormDomain B j μ c hShift h)
    _ = h - (μ : 𝕜) • j (solutionMap B j μ c hShift h) :=
      representingVector_eq_of_represents hjDense
        (solutionFormDomain B j μ c hShift h)
        (solutionMap_represents B j μ c hShift h)

@[simp]
theorem positiveShift_solutionDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveShift (realization B j hj hjDense) μ
        (solutionDomainLift B j hj hjDense μ c hShift h) = h := by
  rw [positiveShift_apply, realization_solutionDomainLift,
    coe_solutionDomainLift]
  exact sub_add_cancel _ _

/-- The continuous ambient inverse of `A + μ`. -/
def positiveInverse
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[𝕜] H :=
  j.comp (solutionMap B j μ c hShift)

@[simp]
theorem positiveInverse_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveInverse B j μ c hShift h =
      j (solutionMap B j μ c hShift h) :=
  rfl

theorem positiveInverse_mem_domain
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    positiveInverse B j μ c hShift h ∈
      (realization B j hj hjDense).domain := by
  have hmem := (solutionDomainLift
    B j hj hjDense μ c hShift h).property
  simpa only [positiveInverse_apply, coe_solutionDomainLift] using hmem

/-- The shifted form of a domain coordinate is the ambient pairing with
`(A + μ)x`. -/
theorem shiftedForm_domainCoordinate
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ : ℝ) (x : (realization B j hj hjDense).domain)
    (v : V) :
    shiftedForm B j μ
        (((domainEquiv B j hj).symm x : formDomain B j) : V) v =
      inner 𝕜 (positiveShift (realization B j hj hjDense) μ x) (j v) := by
  let u : formDomain B j := (domainEquiv B j hj).symm x
  have hRep := realization_represents B j hj hjDense x
  have hCoe : j (u : V) = (x : H) :=
    coe_domainEquiv_symm B j hj x
  calc
    shiftedForm B j μ (u : V) v =
        B (u : V) v + (μ : 𝕜) * inner 𝕜 (j (u : V)) (j v) :=
      shiftedForm_apply B j μ (u : V) v
    _ = inner 𝕜 (realization B j hj hjDense x) (j v) +
        (μ : 𝕜) * inner 𝕜 (x : H) (j v) := by
      rw [hRep v, hCoe]
    _ = inner 𝕜
        (realization B j hj hjDense x + (μ : 𝕜) • (x : H)) (j v) := by
      rw [inner_add_left, inner_smul_left, RCLike.conj_ofReal]
    _ = inner 𝕜 (positiveShift (realization B j hj hjDense) μ x) (j v) := by
      rw [positiveShift_apply]

/-- Applying the variational solution to `(A + μ)x` recovers the domain
coordinate. -/
theorem solutionMap_positiveShift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (realization B j hj hjDense).domain) :
    solutionMap B j μ c hShift
        (positiveShift (realization B j hj hjDense) μ x) =
      (((domainEquiv B j hj).symm x : formDomain B j) : V) := by
  rw [solutionMap_apply]
  exact (realSolutionMap_unique B j μ c hShift
    (positiveShift (realization B j hj hjDense) μ x)
    (fun v => shiftedForm_domainCoordinate B j hj hjDense μ x v)).symm

/-- The ambient inverse is a left inverse on the genuine domain. -/
@[simp]
theorem positiveInverse_positiveShift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (realization B j hj hjDense).domain) :
    positiveInverse B j μ c hShift
        (positiveShift (realization B j hj hjDense) μ x) =
      (x : H) := by
  rw [positiveInverse_apply, solutionMap_positiveShift]
  exact coe_domainEquiv_symm B j hj x

theorem positiveShift_injective
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Injective (positiveShift (realization B j hj hjDense) μ) := by
  intro x y hxy
  apply Subtype.ext
  calc
    (x : H) = positiveInverse B j μ c hShift
        (positiveShift (realization B j hj hjDense) μ x) :=
      (positiveInverse_positiveShift B j hj hjDense μ c hShift x).symm
    _ = positiveInverse B j μ c hShift
        (positiveShift (realization B j hj hjDense) μ y) := by rw [hxy]
    _ = (y : H) :=
      positiveInverse_positiveShift B j hj hjDense μ c hShift y

theorem positiveShift_surjective
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Surjective (positiveShift (realization B j hj hjDense) μ) := by
  intro h
  exact ⟨solutionDomainLift B j hj hjDense μ c hShift h,
    positiveShift_solutionDomainLift B j hj hjDense μ c hShift h⟩

theorem positiveShift_bijective
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Function.Bijective (positiveShift (realization B j hj hjDense) μ) :=
  ⟨positiveShift_injective B j hj hjDense μ c hShift,
    positiveShift_surjective B j hj hjDense μ c hShift⟩

/-! ## Density derived from the real adjoint range -/

/-- Injectivity of a real bounded Hilbert map makes its adjoint range dense. -/
theorem denseRange_realAdjoint_of_injective
    (J : V →L[ℝ] H) (hJ : Function.Injective J) :
    DenseRange J.adjoint := by
  change Dense ((J.adjoint).range : Set V)
  rw [Submodule.dense_iff_topologicalClosure_eq_top]
  rw [← J.orthogonal_ker, LinearMap.ker_eq_bot.mpr hJ]
  exact Submodule.bot_orthogonal_eq_top

/-- The realified solution has dense range. -/
theorem realSolutionMap_denseRange
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    DenseRange (realSolutionMap B j μ c hShift) := by
  let e : V ≃L[ℝ] V :=
    hShift.realPart_isCoercive.continuousLinearEquivOfBilin
  have he : DenseRange (e.symm : V → V) :=
    e.symm.surjective.denseRange
  have hjReal : Function.Injective (j.restrictScalars ℝ) := hj
  have hjAdj : DenseRange ((j.restrictScalars ℝ).adjoint : H → V) :=
    denseRange_realAdjoint_of_injective (j.restrictScalars ℝ) hjReal
  have hcomp :
      DenseRange ((e.symm : V → V) ∘
        ((j.restrictScalars ℝ).adjoint : H → V)) :=
    he.comp hjAdj e.symm.continuous
  change DenseRange (fun x : H =>
    e.symm ((j.restrictScalars ℝ).adjoint x))
  exact hcomp

/-- The recovered `𝕜`-linear solution has the same dense range. -/
theorem solutionMap_denseRange
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    DenseRange (solutionMap B j μ c hShift) := by
  change DenseRange (realSolutionMap B j μ c hShift)
  exact realSolutionMap_denseRange B j hj μ c hShift

/-- Lax--Milgram therefore supplies density of the representable form
domain. -/
theorem formDomain_dense
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Dense (formDomain B j : Set V) := by
  apply (solutionMap_denseRange B j hj μ c hShift).mono
  rintro u ⟨h, rfl⟩
  exact (solutionFormDomain B j μ c hShift h).property

/-- Consequently the realized `LinearPMap` is densely defined. -/
theorem realization_domain_dense
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    Dense ((realization B j hj hjDense).domain : Set H) :=
  realization_domain_dense_of_formDomain_dense B j hj hjDense
    (formDomain_dense B j hj μ c hShift)

/-! ## Maximal symmetry from surjectivity of a real shift -/

/-- A symmetric partial operator has a symmetric positive real shift. -/
theorem inner_positiveShift_swap
    {A : H →ₗ.[𝕜] H} (hA : A.IsFormalAdjoint A)
    (μ : ℝ) (x y : A.domain) :
    inner 𝕜 (positiveShift A μ x) (y : H) =
      inner 𝕜 (x : H) (positiveShift A μ y) := by
  simp only [positiveShift_apply, inner_add_left, inner_add_right,
    inner_smul_left, inner_smul_right, RCLike.conj_ofReal]
  rw [hA x y]

/-- Surjectivity of `A + μ` realizes every adjoint-domain vector by a true
domain vector. -/
theorem adjointDomain_eq_domainWitness_of_positiveShift_surjective
    {A : H →ₗ.[𝕜] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ))
    (y : A.adjoint.domain) :
    ∃ x : A.domain,
      (x : H) = (y : H) ∧
        positiveShift A μ x = A.adjoint y + (μ : 𝕜) • (y : H) := by
  obtain ⟨x, hx⟩ := hSurj (A.adjoint y + (μ : 𝕜) • (y : H))
  refine ⟨x, ?_, hx⟩
  apply ext_inner_right 𝕜
  intro h
  obtain ⟨v, hv⟩ := hSurj h
  have hAdjoint : A.adjoint.IsFormalAdjoint A :=
    LinearPMap.adjoint_isFormalAdjoint hDense
  calc
    inner 𝕜 (x : H) h =
        inner 𝕜 (x : H) (positiveShift A μ v) := by rw [hv]
    _ = inner 𝕜 (positiveShift A μ x) (v : H) :=
      (inner_positiveShift_swap hSymm μ x v).symm
    _ = inner 𝕜 (A.adjoint y + (μ : 𝕜) • (y : H)) (v : H) := by
      rw [hx]
    _ = inner 𝕜 (A.adjoint y) (v : H) +
        (μ : 𝕜) * inner 𝕜 (y : H) (v : H) := by
      rw [inner_add_left, inner_smul_left, RCLike.conj_ofReal]
    _ = inner 𝕜 (y : H) (A v) +
        (μ : 𝕜) * inner 𝕜 (y : H) (v : H) := by
      rw [hAdjoint y v]
    _ = inner 𝕜 (y : H) (A v + (μ : 𝕜) • (v : H)) := by
      rw [inner_add_right, inner_smul_right]
    _ = inner 𝕜 (y : H) (positiveShift A μ v) := by
      rw [positiveShift_apply]
    _ = inner 𝕜 (y : H) h := by rw [hv]

/-- The reverse adjoint inclusion is a conclusion of shift surjectivity. -/
theorem adjoint_le_of_positiveShift_surjective
    {A : H →ₗ.[𝕜] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ)) :
    A.adjoint ≤ A := by
  refine ⟨?_, ?_⟩
  · intro y hy
    obtain ⟨x, hxy, _⟩ :=
      adjointDomain_eq_domainWitness_of_positiveShift_surjective
        hDense hSymm hSurj ⟨y, hy⟩
    have hxmem : (x : H) ∈ A.domain := x.property
    rw [hxy] at hxmem
    exact hxmem
  · intro y z hyz
    obtain ⟨x, hxy, hShiftEq⟩ :=
      adjointDomain_eq_domainWitness_of_positiveShift_surjective
        hDense hSymm hSurj y
    have hxz : x = z := by
      apply Subtype.ext
      exact hxy.trans hyz
    have hExpanded :
        A z + (μ : 𝕜) • (z : H) =
          A.adjoint y + (μ : 𝕜) • (z : H) := by
      calc
        A z + (μ : 𝕜) • (z : H) = positiveShift A μ z :=
          (positiveShift_apply A μ z).symm
        _ = positiveShift A μ x := congrArg (positiveShift A μ) hxz.symm
        _ = A.adjoint y + (μ : 𝕜) • (y : H) := hShiftEq
        _ = A.adjoint y + (μ : 𝕜) • (z : H) := by rw [hyz]
    exact (add_right_cancel hExpanded).symm

/-- Dense symmetry plus one surjective real shift gives self-adjointness. -/
theorem isSelfAdjoint_of_positiveShift_surjective
    {A : H →ₗ.[𝕜] H} {μ : ℝ}
    (hDense : Dense (A.domain : Set H))
    (hSymm : A.IsFormalAdjoint A)
    (hSurj : Function.Surjective (positiveShift A μ)) :
    IsSelfAdjoint A := by
  have hForward : A ≤ A.adjoint :=
    LinearPMap.IsFormalAdjoint.le_adjoint hDense hSymm
  have hReverse : A.adjoint ≤ A :=
    adjoint_le_of_positiveShift_surjective hDense hSymm hSurj
  exact LinearPMap.isSelfAdjoint_def.mpr (le_antisymm hReverse hForward)

/-- The Hermitian coercive form realization is genuinely self-adjoint. -/
theorem realization_isSelfAdjoint
    {B : SesqForm 𝕜 V} {j : V →L[𝕜] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hHerm : IsHermitianForm B)
    {μ c : ℝ} (hShift : IsPositiveCoerciveShift B j μ c) :
    IsSelfAdjoint (realization B j hj hjDense) := by
  apply isSelfAdjoint_of_positiveShift_surjective
    (realization_domain_dense B j hj hjDense μ c hShift)
    (realization_isFormalAdjoint hj hjDense hHerm)
    (positiveShift_surjective B j hj hjDense μ c hShift)

/-! ## Genuine resolvent data at the negative real shift -/

/-- The resolvent candidate at `z = -μ` is the negative of the inverse of
`A + μ`. -/
def negativeShiftResolventInverse
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    H →L[𝕜] H :=
  -positiveInverse B j μ c hShift

@[simp]
theorem negativeShiftResolventInverse_apply
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    negativeShiftResolventInverse B j μ c hShift h =
      -j (solutionMap B j μ c hShift h) :=
  rfl

/-- The resolvent convention is `z - A`; at the negative real shift it is
the negative of `A + μ`. -/
@[simp]
theorem unboundedShift_neg_eq_neg_positiveShift
    (A : H →ₗ.[𝕜] H) (μ : ℝ) (x : A.domain) :
    QYM.UnboundedResolventDataExtension.shifted A (-(μ : 𝕜)) x =
      -positiveShift A μ x := by
  rw [QYM.UnboundedResolventDataExtension.shifted_apply,
    positiveShift_apply]
  module

/-- The resolvent inverse bundled in the actual operator domain. -/
def negativeShiftResolventDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) : (realization B j hj hjDense).domain :=
  -solutionDomainLift B j hj hjDense μ c hShift h

@[simp]
theorem coe_negativeShiftResolventDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    ((negativeShiftResolventDomainLift B j hj hjDense μ c hShift h :
        (realization B j hj hjDense).domain) : H) =
      negativeShiftResolventInverse B j μ c hShift h := by
  simp only [negativeShiftResolventDomainLift,
    negativeShiftResolventInverse_apply, Submodule.coe_neg,
    coe_solutionDomainLift]

@[simp]
theorem shifted_negativeShiftResolventDomainLift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (h : H) :
    QYM.UnboundedResolventDataExtension.shifted
        (realization B j hj hjDense) (-(μ : 𝕜))
        (negativeShiftResolventDomainLift
          B j hj hjDense μ c hShift h) = h := by
  rw [unboundedShift_neg_eq_neg_positiveShift]
  change -positiveShift (realization B j hj hjDense) μ
      (-solutionDomainLift B j hj hjDense μ c hShift h) = h
  rw [map_neg, positiveShift_solutionDomainLift]
  simp only [neg_neg]

@[simp]
theorem negativeShiftResolventDomainLift_shifted
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (x : (realization B j hj hjDense).domain) :
    negativeShiftResolventDomainLift B j hj hjDense μ c hShift
        (QYM.UnboundedResolventDataExtension.shifted
          (realization B j hj hjDense) (-(μ : 𝕜)) x) = x := by
  apply Subtype.ext
  rw [coe_negativeShiftResolventDomainLift,
    negativeShiftResolventInverse_apply,
    unboundedShift_neg_eq_neg_positiveShift, map_neg]
  simpa only [positiveInverse_apply, map_neg, neg_neg] using
    positiveInverse_positiveShift B j hj hjDense μ c hShift x

/-- Genuine two-sided continuous resolvent data for the actual
`LinearPMap`. -/
def negativeShiftResolventData
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    QYM.UnboundedResolventDataExtension.ResolventData
      (realization B j hj hjDense) (-(μ : 𝕜)) where
  inverse := negativeShiftResolventInverse B j μ c hShift
  mapsToDomain := by
    intro h
    have hmem := (negativeShiftResolventDomainLift
      B j hj hjDense μ c hShift h).property
    simpa only [coe_negativeShiftResolventDomainLift] using hmem
  left_inverse := by
    intro x
    simpa only [coe_negativeShiftResolventDomainLift] using
      congrArg Subtype.val
        (negativeShiftResolventDomainLift_shifted
          B j hj hjDense μ c hShift x)
  right_inverse := by
    intro h
    let x : (realization B j hj hjDense).domain :=
      ⟨negativeShiftResolventInverse B j μ c hShift h,
        by
          have hmem := (negativeShiftResolventDomainLift
            B j hj hjDense μ c hShift h).property
          simpa only [coe_negativeShiftResolventDomainLift] using hmem⟩
    have hx : x = negativeShiftResolventDomainLift
        B j hj hjDense μ c hShift h := by
      apply Subtype.ext
      exact (coe_negativeShiftResolventDomainLift
        B j hj hjDense μ c hShift h).symm
    change QYM.UnboundedResolventDataExtension.shifted
      (realization B j hj hjDense) (-(μ : 𝕜)) x = h
    rw [hx]
    exact shifted_negativeShiftResolventDomainLift
      B j hj hjDense μ c hShift h

theorem realization_hasResolventAt_negShift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c) :
    QYM.UnboundedResolventDataExtension.HasResolventAt
      (realization B j hj hjDense) (-(μ : 𝕜)) :=
  ⟨negativeShiftResolventData B j hj hjDense μ c hShift⟩

/-! ## Compact form embedding gives compact genuine resolvent -/

/-- Compactness passes through the bounded solution map. -/
theorem positiveInverse_isCompact
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    IsCompactOperator (positiveInverse B j μ c hShift : H → H) := by
  simpa only [positiveInverse, ContinuousLinearMap.coe_comp'] using
    hjCompact.comp_clm (solutionMap B j μ c hShift)

theorem negativeShiftResolventInverse_isCompact
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    IsCompactOperator
      (negativeShiftResolventInverse B j μ c hShift : H → H) := by
  simpa only [negativeShiftResolventInverse,
    ContinuousLinearMap.coe_neg'] using
    (positiveInverse_isCompact B j μ c hShift hjCompact).neg

theorem negativeShiftResolventData_isCompact
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    (negativeShiftResolventData
      B j hj hjDense μ c hShift).IsCompactResolvent :=
  negativeShiftResolventInverse_isCompact B j μ c hShift hjCompact

/-- A compact form embedding supplies `HasCompactResolventAt` at the
constructed negative shift. -/
theorem realization_hasCompactResolventAt_negShift
    (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
    (hjCompact : IsCompactOperator (j : V → H)) :
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt
      (realization B j hj hjDense) (-(μ : 𝕜)) :=
  QYM.UnboundedResolventDataExtension.hasCompactResolventAt_of_supplier
    (negativeShiftResolventData B j hj hjDense μ c hShift)
    (negativeShiftResolventData_isCompact
      B j hj hjDense μ c hShift hjCompact)

end CompleteSpaces

end QYM.RCLikeCoerciveFormFriedrichsExtension

/-!
# Paper-normalized `RCLike` coercive-form realization

These closed propositions record constructive realification and sesquilinear Friedrichs
prerequisite components associated with Lemmas 4.13, 4.16 and 4.18, and supply
the compact-resolvent prerequisite used before Proposition 4.23.  The form-side coercivity
supplier is the displayed Gårding bound `IsPositiveCoerciveShift`; structural inputs are the
injective dense embedding, Hermitianity, and, for the compact conclusion, compactness of that
embedding.  Density of the realized operator domain, complex linearity, self-adjointness,
inverse equations, and compact resolvent are conclusions from those displayed inputs.  These
wrappers do not claim statement-level equivalence to the full paper lemmas: paper-specific
closedness/nonnegativity, regularity and distributional identification, and the later pure
discreteness/eigenbasis conclusions remain separate obligations.
-/

namespace QYM.FullCertification.PaperNormalized

open Set
open QYM.RCLikeCoerciveFormFriedrichsExtension
open scoped ComplexConjugate InnerProduct

/-! ## Lemma 4.13 prerequisites: realification and abstract self-adjoint realization -/

/-- Mathlib's real Lax--Milgram theorem, followed by the `I • v` test,
solves the complete `RCLike` sesquilinear variational equation. -/
def lemma4_13_rclikeRealificationPrerequisiteStatement : Prop :=
  ∀ (𝕜 V H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
      (h : H),
    ∃! u : V,
      ∀ v : V, shiftedForm B j μ u v = inner 𝕜 h (j v)

theorem lemma4_13_rclikeRealificationPrerequisiteStatement_holds :
    lemma4_13_rclikeRealificationPrerequisiteStatement := by
  intro 𝕜 V H instRCLike
    instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j μ c hShift h
  refine ⟨solutionMap B j μ c hShift h,
    solutionMap_spec B j μ c hShift h, ?_⟩
  intro u hu
  simpa only [solutionMap_apply] using
    (realSolutionMap_unique B j μ c hShift h hu)

/-- A complete form space, injective dense embedding, Hermitian bounded form,
and displayed positive Gårding shift produce a densely defined self-adjoint
`RCLike` `LinearPMap`. -/
def lemma4_13_rclikeCoerciveFriedrichsPrerequisiteStatement : Prop :=
  ∀ (𝕜 V H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hHerm : IsHermitianForm B)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c),
    let A := realization B j hj hjDense
    Dense (A.domain : Set H) ∧
      IsSelfAdjoint A ∧
        Function.Bijective (positiveShift A μ)

theorem lemma4_13_rclikeCoerciveFriedrichsPrerequisiteStatement_holds :
    lemma4_13_rclikeCoerciveFriedrichsPrerequisiteStatement := by
  intro 𝕜 V H instRCLike
    instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense hHerm μ c hShift
  dsimp only
  exact
    ⟨realization_domain_dense B j hj hjDense μ c hShift,
      realization_isSelfAdjoint hj hjDense hHerm hShift,
      positiveShift_bijective B j hj hjDense μ c hShift⟩

/-! ## Lemma 4.16 prerequisite: exact shifted solvability -/

/-- Every ambient datum has a unique solution in the genuine operator domain
to `(A + μ)x = h`. -/
def lemma4_16_rclikeShiftSolvabilityPrerequisiteStatement : Prop :=
  ∀ (𝕜 V H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
      (h : H),
    let A := realization B j hj hjDense
    ∃! x : A.domain, positiveShift A μ x = h

theorem lemma4_16_rclikeShiftSolvabilityPrerequisiteStatement_holds :
    lemma4_16_rclikeShiftSolvabilityPrerequisiteStatement := by
  intro 𝕜 V H instRCLike
    instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense μ c hShift h
  dsimp only
  refine ⟨solutionDomainLift B j hj hjDense μ c hShift h,
    positiveShift_solutionDomainLift B j hj hjDense μ c hShift h, ?_⟩
  intro x hx
  exact positiveShift_injective B j hj hjDense μ c hShift
    (hx.trans (positiveShift_solutionDomainLift
      B j hj hjDense μ c hShift h).symm)

/-! ## Lemma 4.18 prerequisite: genuine resolvent data -/

/-- At `z = -μ` the constructed partial operator has explicit two-sided
continuous resolvent data; the inverse range is exactly the actual domain. -/
def lemma4_18_rclikeResolventPrerequisiteStatement : Prop :=
  ∀ (𝕜 V H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (hHerm : IsHermitianForm B)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c),
    let A := realization B j hj hjDense
    ∃ ρ : QYM.UnboundedResolventDataExtension.ResolventData
        A (-(μ : 𝕜)),
      ρ.inverse = negativeShiftResolventInverse B j μ c hShift ∧
        Set.range ρ.inverse = (A.domain : Set H) ∧
          A.IsClosed ∧ IsSelfAdjoint A

theorem lemma4_18_rclikeResolventPrerequisiteStatement_holds :
    lemma4_18_rclikeResolventPrerequisiteStatement := by
  intro 𝕜 V H instRCLike
    instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense hHerm μ c hShift
  dsimp only
  let ρ := negativeShiftResolventData B j hj hjDense μ c hShift
  refine ⟨ρ, rfl, ρ.range_inverse_eq_domain, ρ.isClosed, ?_⟩
  exact realization_isSelfAdjoint hj hjDense hHerm hShift

/-! ## Proposition 4.23: compact-resolvent prerequisite only -/

/-- Compactness of the actual form embedding supplies the compact-resolvent
prerequisite used before Proposition 4.23.  This statement deliberately does
not claim Proposition 4.23's later mass-gap lower bound: that conclusion also
needs the separate spectral-ordering and ground-sector hypotheses. -/
def prop4_23_rclikeCompactResolventPrerequisiteStatement : Prop :=
  ∀ (𝕜 V H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup V] [InnerProductSpace 𝕜 V] [CompleteSpace V]
      [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
      (B : SesqForm 𝕜 V) (j : V →L[𝕜] H)
      (hj : Function.Injective j) (hjDense : DenseRange j)
      (μ c : ℝ) (hShift : IsPositiveCoerciveShift B j μ c)
      (hjCompact : IsCompactOperator (j : V → H)),
    let A := realization B j hj hjDense
    QYM.UnboundedResolventDataExtension.HasCompactResolventAt
        A (-(μ : 𝕜)) ∧
      (negativeShiftResolventData
        B j hj hjDense μ c hShift).IsCompactResolvent

theorem prop4_23_rclikeCompactResolventPrerequisiteStatement_holds :
    prop4_23_rclikeCompactResolventPrerequisiteStatement := by
  intro 𝕜 V H instRCLike
    instNormedV instInnerV instCompleteV
    instNormedH instInnerH instCompleteH
    B j hj hjDense μ c hShift hjCompact
  dsimp only
  exact
    ⟨realization_hasCompactResolventAt_negShift
        B j hj hjDense μ c hShift hjCompact,
      negativeShiftResolventData_isCompact
        B j hj hjDense μ c hShift hjCompact⟩

end QYM.FullCertification.PaperNormalized

/-!
# Spectral mapping for a genuine unbounded operator with compact resolvent

This file supplies the layer which cannot be obtained by applying the bounded algebraic spectrum
API directly to an unbounded operator.  The operator is an actual `LinearPMap`; its eigenspace is
defined in the ambient Hilbert space as the inverse image of its graph under
`x ↦ (x, lambda • x)`.  Consequently the domain condition is part of the definition.

For genuine resolvent data `ρ` at `z` we prove the exact submodule identity

`operatorEigenspace T lambda = eigenspace ρ.inverse (z - lambda)⁻¹`,

provided `z ≠ lambda`.  This gives eigenvector and eigenvalue equivalences and transfers finite
multiplicity from a compact inverse without choosing an eigenbasis.  We also prove that a real
resolvent point of a self-adjoint `LinearPMap` has a bounded self-adjoint inverse.

The final selection theorem deliberately separates the one compact-operator theorem not presently
packaged by Mathlib: finiteness of the point spectrum away from zero.  In particular,
`Mathlib.Analysis.Normed.Operator.FredholmAlternative` proves that the nonzero spectrum equals the
nonzero point spectrum, but does not package its finiteness outside every ball about zero.  The
exact supplier used here is
`CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite`.  From it and the spectral map we
derive local finiteness of positive unbounded eigenvalues, and only then select a least off-ground
level.  Neither an enumeration nor the desired gap is assumed.
-/

open Module End Set

namespace QYM.UnboundedCompactSpectralMappingExtension

variable {𝕜 H : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

abbrev ResolventData (T : H →ₗ.[𝕜] H) (z : 𝕜) :=
  QYM.UnboundedResolventDataExtension.ResolventData T z

/-! ## Ambient eigenspaces for a genuine partial operator -/

/-- The linear map `x ↦ (x, lambda • x)` used to test membership in the operator graph. -/
def graphEigenEmbedding (lambda : 𝕜) : H →ₗ[𝕜] H × H :=
  (LinearMap.id : H →ₗ[𝕜] H).prod (lambda • (LinearMap.id : H →ₗ[𝕜] H))

@[simp]
theorem graphEigenEmbedding_apply (lambda : 𝕜) (x : H) :
    graphEigenEmbedding (H := H) lambda x = (x, lambda • x) := by
  rfl

/-- The ambient eigenspace of a `LinearPMap`.  Membership includes membership in `T.domain`. -/
def operatorEigenspace (T : H →ₗ.[𝕜] H) (lambda : 𝕜) : Submodule 𝕜 H :=
  T.graph.comap (graphEigenEmbedding (H := H) lambda)

theorem mem_operatorEigenspace_iff
    {T : H →ₗ.[𝕜] H} {lambda : 𝕜} {x : H} :
    x ∈ operatorEigenspace T lambda ↔
      ∃ hx : x ∈ T.domain, T ⟨x, hx⟩ = lambda • x := by
  rw [operatorEigenspace, Submodule.mem_comap, LinearPMap.mem_graph_iff]
  simp only [graphEigenEmbedding_apply, Prod.fst, Prod.snd]
  constructor
  · rintro ⟨y, hy, hTy⟩
    subst x
    exact ⟨y.property, by simpa using hTy⟩
  · rintro ⟨hx, hTx⟩
    exact ⟨⟨x, hx⟩, rfl, hTx⟩

/-- A nonzero ambient vector in the genuine partial-operator eigenspace. -/
def HasPMapEigenvector (T : H →ₗ.[𝕜] H) (lambda : 𝕜) (x : H) : Prop :=
  x ∈ operatorEigenspace T lambda ∧ x ≠ 0

/-- The genuine partial-operator eigenspace is nontrivial. -/
def HasPMapEigenvalue (T : H →ₗ.[𝕜] H) (lambda : 𝕜) : Prop :=
  operatorEigenspace T lambda ≠ ⊥

theorem hasPMapEigenvalue_iff
    {T : H →ₗ.[𝕜] H} {lambda : 𝕜} :
    HasPMapEigenvalue T lambda ↔ ∃ x : H, HasPMapEigenvector T lambda x := by
  rw [HasPMapEigenvalue, Submodule.ne_bot_iff]
  rfl

theorem HasPMapEigenvalue.exists_hasPMapEigenvector
    {T : H →ₗ.[𝕜] H} {lambda : 𝕜} (hlambda : HasPMapEigenvalue T lambda) :
    ∃ x : H, HasPMapEigenvector T lambda x :=
  hasPMapEigenvalue_iff.mp hlambda

theorem hasPMapEigenvector_iff_domain_eigen_equation
    {T : H →ₗ.[𝕜] H} {lambda : 𝕜} {x : H} :
    HasPMapEigenvector T lambda x ↔
      ∃ hx : x ∈ T.domain, T ⟨x, hx⟩ = lambda • x ∧ x ≠ 0 := by
  rw [HasPMapEigenvector, mem_operatorEigenspace_iff]
  aesop

/-! ## Exact resolvent/eigenpair correspondence -/

/-- The forward eigenvector equation.  This is the scalar calculation at the heart of spectral
mapping; no compactness or self-adjointness is involved. -/
theorem resolvent_apply_of_mem_operatorEigenspace
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hzlambda : z ≠ lambda) {x : H}
    (hx : x ∈ operatorEigenspace T lambda) :
    ρ.inverse x = (z - lambda)⁻¹ • x := by
  obtain ⟨hxDomain, hTx⟩ := mem_operatorEigenspace_iff.mp hx
  let xd : T.domain := ⟨x, hxDomain⟩
  have hshift :
      QYM.UnboundedResolventDataExtension.shifted T z xd = (z - lambda) • x := by
    rw [QYM.UnboundedResolventDataExtension.shifted_apply, hTx, sub_smul]
  have hleft := ρ.left_inverse xd
  rw [hshift, map_smul] at hleft
  have hscaled := congrArg (fun y : H => (z - lambda)⁻¹ • y) hleft
  simpa only [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hzlambda), one_smul] using hscaled

/-- The converse eigenvector equation.  The proof first recovers the domain condition from the
range of the resolvent and then uses injectivity of the resolvent inverse. -/
theorem mem_operatorEigenspace_of_resolvent_eigen_equation
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hzlambda : z ≠ lambda) {x : H}
    (hx : ρ.inverse x = (z - lambda)⁻¹ • x) :
    x ∈ operatorEigenspace T lambda := by
  have hne : z - lambda ≠ 0 := sub_ne_zero.mpr hzlambda
  have hscale : (z - lambda) • ρ.inverse x = x := by
    rw [hx, smul_smul, mul_inv_cancel₀ hne, one_smul]
  have hxDomain : x ∈ T.domain := by
    rw [← hscale]
    exact T.domain.smul_mem (z - lambda) (ρ.mapsToDomain x)
  let xd : T.domain := ⟨x, hxDomain⟩
  have hshift :
      QYM.UnboundedResolventDataExtension.shifted T z xd = (z - lambda) • x := by
    apply ρ.inverse_injective
    calc
      ρ.inverse (QYM.UnboundedResolventDataExtension.shifted T z xd) = x :=
        ρ.left_inverse xd
      _ = (z - lambda) • ((z - lambda)⁻¹ • x) := by
        rw [smul_smul, mul_inv_cancel₀ hne, one_smul]
      _ = (z - lambda) • ρ.inverse x := by rw [hx]
      _ = ρ.inverse ((z - lambda) • x) := by rw [map_smul]
  apply mem_operatorEigenspace_iff.mpr
  refine ⟨hxDomain, ?_⟩
  rw [QYM.UnboundedResolventDataExtension.shifted_apply, sub_smul] at hshift
  exact sub_right_inj.mp hshift

/-- Exact equality of the genuine unbounded eigenspace and the corresponding bounded resolvent
eigenspace. -/
theorem operatorEigenspace_eq_resolventEigenspace
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hzlambda : z ≠ lambda) :
    operatorEigenspace T lambda =
      eigenspace (ρ.inverse : Module.End 𝕜 H) (z - lambda)⁻¹ := by
  ext x
  rw [mem_eigenspace_iff]
  constructor
  · exact resolvent_apply_of_mem_operatorEigenspace ρ hzlambda
  · exact mem_operatorEigenspace_of_resolvent_eigen_equation ρ hzlambda

/-- Eigenvectors correspond with the same ambient vector; no basis or normalization is chosen. -/
theorem hasPMapEigenvector_iff_resolvent_hasEigenvector
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hzlambda : z ≠ lambda) {x : H} :
    HasPMapEigenvector T lambda x ↔
      HasEigenvector (ρ.inverse : Module.End 𝕜 H) (z - lambda)⁻¹ x := by
  rw [HasPMapEigenvector, hasEigenvector_iff,
    operatorEigenspace_eq_resolventEigenspace ρ hzlambda]

/-- Point eigenvalues correspond under `lambda ↦ (z - lambda)⁻¹`. -/
theorem hasPMapEigenvalue_iff_resolvent_hasEigenvalue
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hzlambda : z ≠ lambda) :
    HasPMapEigenvalue T lambda ↔
      HasEigenvalue (ρ.inverse : Module.End 𝕜 H) (z - lambda)⁻¹ := by
  rw [HasPMapEigenvalue, hasEigenvalue_iff,
    operatorEigenspace_eq_resolventEigenspace ρ hzlambda]

/-- Conversely, every nonzero inverse eigenvalue `ν` gives the unbounded eigenvalue
`z - ν⁻¹`. -/
theorem resolvent_hasEigenvector_iff_pmap_hasEigenvector
    {T : H →ₗ.[𝕜] H} {z ν : 𝕜}
    (ρ : ResolventData T z) (hν : ν ≠ 0) {x : H} :
    HasEigenvector (ρ.inverse : Module.End 𝕜 H) ν x ↔
      HasPMapEigenvector T (z - ν⁻¹) x := by
  have hdiff : z - (z - ν⁻¹) = ν⁻¹ := by ring
  have hz : z ≠ z - ν⁻¹ := by
    apply sub_ne_zero.mp
    rw [hdiff]
    exact inv_ne_zero hν
  have hscalar : (z - (z - ν⁻¹))⁻¹ = ν := by
    rw [hdiff, inv_inv]
  rw [hasPMapEigenvector_iff_resolvent_hasEigenvector ρ hz, hscalar]

/-- Eigenvalue-level inverse direction for every nonzero resolvent eigenvalue. -/
theorem resolvent_hasEigenvalue_iff_pmap_hasEigenvalue
    {T : H →ₗ.[𝕜] H} {z ν : 𝕜}
    (ρ : ResolventData T z) (hν : ν ≠ 0) :
    HasEigenvalue (ρ.inverse : Module.End 𝕜 H) ν ↔
      HasPMapEigenvalue T (z - ν⁻¹) := by
  have hdiff : z - (z - ν⁻¹) = ν⁻¹ := by ring
  have hz : z ≠ z - ν⁻¹ := by
    apply sub_ne_zero.mp
    rw [hdiff]
    exact inv_ne_zero hν
  have hscalar : (z - (z - ν⁻¹))⁻¹ = ν := by
    rw [hdiff, inv_inv]
  rw [hasPMapEigenvalue_iff_resolvent_hasEigenvalue ρ hz, hscalar]

/-! ## Resolvent points, kernels, and finite multiplicity -/

/-- A resolvent parameter cannot itself be a point eigenvalue of the partial operator. -/
theorem operatorEigenspace_at_resolvent_eq_bot
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    operatorEigenspace T z = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x hx
  obtain ⟨hxDomain, hTx⟩ := mem_operatorEigenspace_iff.mp hx
  let xd : T.domain := ⟨x, hxDomain⟩
  have hshift : QYM.UnboundedResolventDataExtension.shifted T z xd = 0 := by
    rw [QYM.UnboundedResolventDataExtension.shifted_apply, hTx, sub_self]
  have hleft := ρ.left_inverse xd
  rw [hshift, map_zero] at hleft
  exact hleft.symm

theorem not_hasPMapEigenvalue_at_resolvent
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    ¬ HasPMapEigenvalue T z := by
  intro h
  exact h (operatorEigenspace_at_resolvent_eq_bot ρ)

/-- The inverse has zero kernel because genuine resolvent data are two-sided. -/
theorem inverse_zero_eigenspace_eq_bot
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    eigenspace (ρ.inverse : Module.End 𝕜 H) 0 = ⊥ := by
  rw [Module.End.eigenspace_zero]
  exact LinearMap.ker_eq_bot.mpr ρ.inverse_injective

theorem inverse_has_no_zero_eigenvalue
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    ¬ HasEigenvalue (ρ.inverse : Module.End 𝕜 H) 0 := by
  intro h
  exact h (inverse_zero_eigenspace_eq_bot ρ)

/-- At a nonzero resolvent point the complete kernel of `T` corresponds to the inverse eigenspace
at `z⁻¹`.  This does not choose, or assume simplicity of, a ground vector. -/
theorem operatorKernel_eq_resolventEigenspace
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hz : z ≠ 0) :
    operatorEigenspace T 0 =
      eigenspace (ρ.inverse : Module.End 𝕜 H) z⁻¹ := by
  simpa using operatorEigenspace_eq_resolventEigenspace ρ hz

/-- A compact genuine resolvent gives finite multiplicity for every partial-operator eigenvalue.
The exceptional parameter `z` is not an eigenvalue at all. -/
theorem operatorEigenspace_finiteDimensional_of_compactResolvent
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z lambda : 𝕜}
    (ρ : ResolventData T z) (hcompact : ρ.IsCompactResolvent)
    (hzlambda : z ≠ lambda) :
    FiniteDimensional 𝕜 (operatorEigenspace T lambda) := by
  rw [operatorEigenspace_eq_resolventEigenspace ρ hzlambda]
  apply ContinuousLinearMap.finite_dimensional_eigenspace hcompact
  exact inv_ne_zero (sub_ne_zero.mpr hzlambda)

/-- Every eigenspace has finite multiplicity.  At the resolvent parameter the eigenspace is
trivial; all other levels are transferred to nonzero eigenspaces of the compact inverse. -/
theorem every_operatorEigenspace_finiteDimensional_of_compactResolvent
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hcompact : ρ.IsCompactResolvent)
    (lambda : 𝕜) :
    FiniteDimensional 𝕜 (operatorEigenspace T lambda) := by
  by_cases hzlambda : z = lambda
  · subst lambda
    rw [operatorEigenspace_at_resolvent_eq_bot ρ]
    infer_instance
  · exact operatorEigenspace_finiteDimensional_of_compactResolvent ρ hcompact hzlambda

/-! ## Self-adjointness passes to a real resolvent inverse -/

theorem pmap_isFormalAdjoint_of_selfAdjoint
    [CompleteSpace H] {T : H →ₗ.[𝕜] H} (hT : IsSelfAdjoint T) :
    T.IsFormalAdjoint T := by
  have hformal : T.adjoint.IsFormalAdjoint T :=
    LinearPMap.adjoint_isFormalAdjoint hT.dense_domain
  rw [LinearPMap.isSelfAdjoint_def.mp hT] at hformal
  exact hformal

/-- A self-adjoint `LinearPMap` has a symmetric resolvent inverse at a star-fixed parameter. -/
theorem resolvent_inverse_isSymmetric
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hT : IsSelfAdjoint T) (hz : star z = z) :
    (ρ.inverse : H →ₗ[𝕜] H).IsSymmetric := by
  have hsymm := pmap_isFormalAdjoint_of_selfAdjoint hT
  change (starRingEnd 𝕜) z = z at hz
  intro x y
  calc
    inner 𝕜 (ρ.inverse x) y =
        inner 𝕜 (ρ.domainLift x : H)
          (QYM.UnboundedResolventDataExtension.shifted T z (ρ.domainLift y)) := by
      rw [ρ.shifted_domainLift y]
      rfl
    _ = inner 𝕜
          (QYM.UnboundedResolventDataExtension.shifted T z (ρ.domainLift x))
          (ρ.domainLift y : H) := by
      rw [QYM.UnboundedResolventDataExtension.shifted_apply,
        QYM.UnboundedResolventDataExtension.shifted_apply,
        inner_sub_right, inner_smul_right, inner_sub_left, inner_smul_left,
        hz, hsymm]
    _ = inner 𝕜 x (ρ.inverse y) := by
      rw [ρ.shifted_domainLift x]
      rfl

/-- Hence the bounded inverse is genuinely self-adjoint. -/
theorem resolvent_inverse_isSelfAdjoint
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hT : IsSelfAdjoint T) (hz : star z = z) :
    IsSelfAdjoint ρ.inverse :=
  (resolvent_inverse_isSymmetric ρ hT hz).isSelfAdjoint

/-- The actual compact self-adjoint spectral package for a genuine unbounded resolvent inverse. -/
theorem compact_resolvent_spectral_package
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    IsSelfAdjoint ρ.inverse ∧
      (⨆ ν : 𝕜, eigenspace (ρ.inverse : Module.End 𝕜 H) ν)ᗮ = ⊥ ∧
      ∀ ν : 𝕜, ν ≠ 0 →
        FiniteDimensional 𝕜 (eigenspace (ρ.inverse : Module.End 𝕜 H) ν) := by
  have hself := resolvent_inverse_isSelfAdjoint ρ hT hz
  exact ⟨hself,
    QYM.CompactSelfAdjointGapExtension.compact_selfAdjoint_spectral_package
      hcompact hself⟩

/-- The genuine unbounded eigenspaces span densely.  Completeness is transported from the compact
self-adjoint inverse, including the fact that the inverse zero eigenspace is trivial. -/
theorem operatorEigenspaces_complete_of_compactResolvent
    [CompleteSpace H]
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hT : IsSelfAdjoint T) (hz : star z = z)
    (hcompact : ρ.IsCompactResolvent) :
    (⨆ lambda : 𝕜, operatorEigenspace T lambda)ᗮ = ⊥ := by
  have hselfInverse := resolvent_inverse_isSelfAdjoint ρ hT hz
  have hinverseComplete :
      (⨆ ν : 𝕜, eigenspace (ρ.inverse : Module.End 𝕜 H) ν)ᗮ = ⊥ :=
    QYM.CompactSelfAdjointGapExtension.eigenspaces_complete hcompact hselfInverse
  have hspan :
      (⨆ ν : 𝕜, eigenspace (ρ.inverse : Module.End 𝕜 H) ν) ≤
        ⨆ lambda : 𝕜, operatorEigenspace T lambda := by
    refine iSup_le ?_
    intro ν
    by_cases hν : ν = 0
    · subst ν
      rw [inverse_zero_eigenspace_eq_bot ρ]
      exact bot_le
    · have hdiff : z - (z - ν⁻¹) = ν⁻¹ := by ring
      have hzν : z ≠ z - ν⁻¹ := by
        apply sub_ne_zero.mp
        rw [hdiff]
        exact inv_ne_zero hν
      have heq :
          operatorEigenspace T (z - ν⁻¹) =
            eigenspace (ρ.inverse : Module.End 𝕜 H) ν := by
        simpa only [hdiff, inv_inv] using
          operatorEigenspace_eq_resolventEigenspace ρ hzν
      rw [← heq]
      exact le_iSup (operatorEigenspace T) (z - ν⁻¹)
  apply le_antisymm
  · exact (Submodule.orthogonal_le hspan).trans_eq hinverseComplete
  · exact bot_le

/-! ## Multiplicity-safe coercive bounds on the unbounded operator -/

/-- Quadratic nonnegativity on the actual operator domain. -/
def IsQuadraticallyNonnegative (T : H →ₗ.[𝕜] H) : Prop :=
  ∀ x : T.domain, 0 ≤ RCLike.re (inner 𝕜 (x : H) (T x))

/-- A lower form bound on the orthogonal complement of the complete zero eigenspace. -/
def HasGroundComplementCoercivity (T : H →ₗ.[𝕜] H) (c : ℝ) : Prop :=
  ∀ x : T.domain, (x : H) ∈ (operatorEigenspace T 0)ᗮ →
    c * ‖(x : H)‖ ^ 2 ≤ RCLike.re (inner 𝕜 (x : H) (T x))

/-- Every eigenvalue of a symmetric genuine partial operator is real. -/
theorem pmap_eigenvalue_is_real
    {T : H →ₗ.[𝕜] H} (hsymm : T.IsFormalAdjoint T)
    {lambda : 𝕜} (hlambda : HasPMapEigenvalue T lambda) :
    star lambda = lambda := by
  obtain ⟨x, hxMem, hxne⟩ := hlambda.exists_hasPMapEigenvector
  obtain ⟨hxDomain, hxEq⟩ := mem_operatorEigenspace_iff.mp hxMem
  let xd : T.domain := ⟨x, hxDomain⟩
  have hxd : T xd = lambda • (xd : H) := by
    simpa only [xd] using hxEq
  have hinner : inner 𝕜 x x ≠ 0 := inner_self_ne_zero.mpr hxne
  apply mul_right_cancel₀ hinner
  simpa only [xd, hxd, inner_smul_left, inner_smul_right,
    starRingEnd_apply] using hsymm xd xd

/-- A nonzero eigenvector of a symmetric partial operator is orthogonal to the entire zero
eigenspace, not merely to a selected ground vector. -/
theorem pmap_eigenvector_mem_ground_orthogonal
    {T : H →ₗ.[𝕜] H} (hsymm : T.IsFormalAdjoint T)
    {lambda : 𝕜} {x : H} (hx : HasPMapEigenvector T lambda x) (hlambda : lambda ≠ 0) :
    x ∈ (operatorEigenspace T 0)ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro y hy
  obtain ⟨hyDomain, hyEq⟩ := mem_operatorEigenspace_iff.mp hy
  obtain ⟨hxMem, _⟩ := hx
  obtain ⟨hxDomain, hxEq⟩ := mem_operatorEigenspace_iff.mp hxMem
  let yd : T.domain := ⟨y, hyDomain⟩
  let xd : T.domain := ⟨x, hxDomain⟩
  have hyZero : T yd = 0 := by simpa using hyEq
  have hs := hsymm yd xd
  rw [hyZero, hxEq, inner_zero_left, inner_smul_right] at hs
  exact (mul_eq_zero.mp hs.symm).resolve_left hlambda

/-- A real nonzero eigenvalue is bounded below by the ground-complement coercivity constant. -/
theorem real_pmap_eigenvalue_ge_of_groundComplementCoercivity
    {T : H →ₗ.[𝕜] H} (hsymm : T.IsFormalAdjoint T)
    {c lambda : ℝ} {x : H}
    (hcoercive : HasGroundComplementCoercivity T c)
    (hlambda : lambda ≠ 0) (hx : HasPMapEigenvector T (lambda : 𝕜) x) :
    c ≤ lambda := by
  obtain ⟨hxMem, hxne⟩ := hx
  obtain ⟨hxDomain, hxEq⟩ := mem_operatorEigenspace_iff.mp hxMem
  let xd : T.domain := ⟨x, hxDomain⟩
  have hlambdaK : (lambda : 𝕜) ≠ 0 := by exact_mod_cast hlambda
  have hxorth : x ∈ (operatorEigenspace T 0)ᗮ :=
    pmap_eigenvector_mem_ground_orthogonal hsymm ⟨hxMem, hxne⟩ hlambdaK
  have hbound := hcoercive xd hxorth
  have hnorm : 0 < ‖x‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hxne)
  have hinner :
      inner 𝕜 x (T xd) = (lambda : 𝕜) * (‖x‖ : 𝕜) ^ 2 := by
    rw [hxEq, inner_smul_right, inner_self_eq_norm_sq_to_K]
  have heigenform :
      RCLike.re (inner 𝕜 x (T xd)) = lambda * ‖x‖ ^ 2 :=
    mod_cast congrArg RCLike.re hinner
  rw [heigenform] at hbound
  nlinarith

theorem real_pmap_eigenvalue_pos_of_groundComplementCoercivity
    {T : H →ₗ.[𝕜] H} (hsymm : T.IsFormalAdjoint T)
    {c lambda : ℝ} (hc : 0 < c)
    (hcoercive : HasGroundComplementCoercivity T c)
    (hlambda : lambda ≠ 0) (hlambdaEigen : HasPMapEigenvalue T (lambda : 𝕜)) :
    0 < lambda := by
  obtain ⟨x, hx⟩ := hlambdaEigen.exists_hasPMapEigenvector
  exact lt_of_lt_of_le hc
    (real_pmap_eigenvalue_ge_of_groundComplementCoercivity
      hsymm hcoercive hlambda hx)

/-- Quadratic nonnegativity makes every real point eigenvalue nonnegative. -/
theorem real_pmap_eigenvalue_nonnegative
    {T : H →ₗ.[𝕜] H} (hnonnegative : IsQuadraticallyNonnegative T)
    {lambda : ℝ} (hlambdaEigen : HasPMapEigenvalue T (lambda : 𝕜)) :
    0 ≤ lambda := by
  obtain ⟨x, hxMem, hxne⟩ := hlambdaEigen.exists_hasPMapEigenvector
  obtain ⟨hxDomain, hxEq⟩ := mem_operatorEigenspace_iff.mp hxMem
  let xd : T.domain := ⟨x, hxDomain⟩
  have hnorm : 0 < ‖x‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hxne)
  have hinner :
      inner 𝕜 x (T xd) = (lambda : 𝕜) * (‖x‖ : 𝕜) ^ 2 := by
    rw [hxEq, inner_smul_right, inner_self_eq_norm_sq_to_K]
  have heigenform :
      RCLike.re (inner 𝕜 x (T xd)) = lambda * ‖x‖ ^ 2 :=
    mod_cast congrArg RCLike.re hinner
  have hbound := hnonnegative xd
  rw [heigenform] at hbound
  nlinarith

/-! ## The exact nonzero-accumulation boundary and least-level selection -/

/-- Positive real point eigenvalues below a prescribed upper bound. -/
def positivePointSpectrumBelow (T : H →ₗ.[𝕜] H) (b : ℝ) : Set ℝ :=
  {lambda : ℝ | 0 < lambda ∧ HasPMapEigenvalue T (lambda : 𝕜) ∧ lambda ≤ b}

/-- The minimal local-finiteness input needed to choose a first positive level.  Below we derive it
from the standard away-from-zero compact point-spectrum supplier for a negative resolvent. -/
structure PositivePointSpectrumLocallyFinite (T : H →ₗ.[𝕜] H) : Prop where
  finite_below : ∀ b : ℝ, (positivePointSpectrumBelow T b).Finite

/-- A finite positive point spectrum below each bound has a least positive level whenever it is
nonempty.  The conclusion is constructed from a finite set and does not assume a gap. -/
theorem exists_least_positive_pmap_eigenvalue
    {T : H →ₗ.[𝕜] H} (hlocal : PositivePointSpectrumLocallyFinite T)
    (hexists : ∃ lambda : ℝ, 0 < lambda ∧ HasPMapEigenvalue T (lambda : 𝕜)) :
    ∃ gap : ℝ,
      0 < gap ∧
      HasPMapEigenvalue T (gap : 𝕜) ∧
      ∀ lambda : ℝ, 0 < lambda → HasPMapEigenvalue T (lambda : 𝕜) → gap ≤ lambda := by
  obtain ⟨b, hb, hbEigen⟩ := hexists
  let S := positivePointSpectrumBelow T b
  have hSfinite : S.Finite := hlocal.finite_below b
  have hSne : S.Nonempty := ⟨b, hb, hbEigen, le_rfl⟩
  obtain ⟨gap, hgapS, hminimal⟩ :=
    Set.exists_min_image S id hSfinite hSne
  refine ⟨gap, hgapS.1, hgapS.2.1, ?_⟩
  intro lambda hlambda hlambdaEigen
  by_cases hlambdab : lambda ≤ b
  · simpa only [id_eq] using hminimal lambda ⟨hlambda, hlambdaEigen, hlambdab⟩
  · exact hgapS.2.2.trans (le_of_lt (lt_of_not_ge hlambdab))

end QYM.UnboundedCompactSpectralMappingExtension

namespace QYM.UnboundedCompactSpectralMappingExtension

section RealNegativeResolvent

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The standard away-from-zero point-spectrum fact for the compact inverse implies the precise
local finiteness needed to select positive eigenvalues of `T`.  This theorem is the only place
where the explicit missing compact-spectrum supplier is consumed. -/
theorem positivePointSpectrumLocallyFinite_of_negative_resolvent
    {T : H →ₗ.[ℝ] H} {μ : ℝ} (hμ : 0 < μ)
    (ρ : ResolventData T (-μ))
    (hAway :
      QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite ρ.inverse) :
    PositivePointSpectrumLocallyFinite T := by
  constructor
  intro b
  by_cases hb : 0 < b
  · let r : ℝ := (μ + b)⁻¹
    have hr : 0 < r := inv_pos.mpr (add_pos hμ hb)
    have hfinite := hAway.finite_away_from_zero r hr
    have himage :
        (fun lambda : ℝ => (-μ - lambda)⁻¹) '' positivePointSpectrumBelow T b ⊆
          {ν : ℝ |
            HasEigenvalue (ρ.inverse : Module.End ℝ H) ν ∧ r ≤ ‖ν‖} := by
      rintro ν ⟨lambda, hlambda, rfl⟩
      rcases hlambda with ⟨hlambdapos, hlambdaEigen, hlambdab⟩
      have hzlambda : (-μ : ℝ) ≠ lambda := by linarith
      refine ⟨(hasPMapEigenvalue_iff_resolvent_hasEigenvalue ρ hzlambda).mp hlambdaEigen, ?_⟩
      have hdenlambda : 0 < μ + lambda := add_pos hμ hlambdapos
      have hdenb : 0 < μ + b := add_pos hμ hb
      have habs : |(-μ - lambda : ℝ)| = μ + lambda := by
        rw [abs_of_neg (by linarith)]
        ring
      dsimp only [r]
      rw [Real.norm_eq_abs, abs_inv, habs]
      exact (inv_le_inv₀ hdenb hdenlambda).2 (by linarith)
    have hinjective :
        Set.InjOn (fun lambda : ℝ => (-μ - lambda)⁻¹)
          (positivePointSpectrumBelow T b) := by
      intro a _ b _ hab
      have hden := inv_injective hab
      linarith
    exact (hfinite.subset himage).of_finite_image hinjective
  · apply Set.finite_empty.subset
    intro lambda hlambda
    exact (hb (lt_of_lt_of_le hlambda.1 hlambda.2.2)).elim

/-- A genuine least off-ground level for a self-adjoint operator with compact negative resolvent.
The full zero eigenspace is retained, every nonzero level is bounded by `c`, and the selected
eigenspace has finite multiplicity.  The only supplier beyond current Mathlib is stated explicitly
as `hAway`; the theorem assumes neither a spectral enumeration nor the resulting `gap`. -/
theorem exists_multiplicitySafe_least_offGround_level
    [CompleteSpace H]
    {T : H →ₗ.[ℝ] H} {μ c : ℝ}
    (hμ : 0 < μ) (hc : 0 < c)
    (hT : IsSelfAdjoint T)
    (ρ : ResolventData T (-μ))
    (hcompact : ρ.IsCompactResolvent)
    (hAway :
      QYM.CompactSelfAdjointGapExtension.AwayFromZeroPointSpectrumFinite ρ.inverse)
    (hcoercive : HasGroundComplementCoercivity T c)
    (hzero : HasPMapEigenvalue T 0)
    (hnonzero : ∃ lambda : ℝ, lambda ≠ 0 ∧ HasPMapEigenvalue T lambda) :
    ∃ gap : ℝ,
      HasPMapEigenvalue T 0 ∧
      FiniteDimensional ℝ (operatorEigenspace T 0) ∧
      c ≤ gap ∧
      0 < gap ∧
      HasPMapEigenvalue T gap ∧
      FiniteDimensional ℝ (operatorEigenspace T gap) ∧
      ∀ lambda : ℝ, lambda ≠ 0 → HasPMapEigenvalue T lambda → gap ≤ lambda := by
  have hsymm : T.IsFormalAdjoint T := pmap_isFormalAdjoint_of_selfAdjoint hT
  have hlocal : PositivePointSpectrumLocallyFinite T :=
    positivePointSpectrumLocallyFinite_of_negative_resolvent hμ ρ hAway
  obtain ⟨lambda, hlambdane, hlambdaEigen⟩ := hnonzero
  have hlambdapos : 0 < lambda :=
    real_pmap_eigenvalue_pos_of_groundComplementCoercivity
      hsymm hc hcoercive hlambdane hlambdaEigen
  obtain ⟨gap, hgappos, hgapEigen, hgapLeastPositive⟩ :=
    exists_least_positive_pmap_eigenvalue hlocal ⟨lambda, hlambdapos, hlambdaEigen⟩
  have hgapne : gap ≠ 0 := hgappos.ne'
  have hgapLower : c ≤ gap := by
    obtain ⟨x, hx⟩ := hgapEigen.exists_hasPMapEigenvector
    exact real_pmap_eigenvalue_ge_of_groundComplementCoercivity
      hsymm hcoercive hgapne hx
  have hzGap : (-μ : ℝ) ≠ gap := by linarith
  have hgapFinite : FiniteDimensional ℝ (operatorEigenspace T gap) :=
    operatorEigenspace_finiteDimensional_of_compactResolvent ρ hcompact hzGap
  have hzZero : (-μ : ℝ) ≠ 0 := by linarith
  have hgroundFinite : FiniteDimensional ℝ (operatorEigenspace T 0) :=
    operatorEigenspace_finiteDimensional_of_compactResolvent ρ hcompact hzZero
  refine ⟨gap, hzero, hgroundFinite, hgapLower, hgappos, hgapEigen, hgapFinite, ?_⟩
  intro ν hνne hνEigen
  have hνpos : 0 < ν :=
    real_pmap_eigenvalue_pos_of_groundComplementCoercivity
      hsymm hc hcoercive hνne hνEigen
  exact hgapLeastPositive ν hνpos hνEigen

end RealNegativeResolvent

end QYM.UnboundedCompactSpectralMappingExtension

/-!
# Paper-normalized unbounded compact-resolvent spectral mapping

These wrappers isolate the precise operator-theoretic content needed by Proposition 4.23,
Appendix Theorem A.7, and Corollary 4.25.  In particular:

* the operator is a genuine `LinearPMap` and every eigenspace retains the domain condition;
* spectral mapping is an equality of submodules, so multiplicities are preserved;
* the ground space is the complete zero eigenspace, with no simplicity hypothesis;
* a least positive level is constructed only after local finiteness is supplied;
* the currently missing Mathlib fact that compact point spectrum is finite away from zero appears
  as an explicit hypothesis, never as a hidden enumeration or as the desired mass gap.

Mathlib's `FredholmAlternative` identifies nonzero spectrum with nonzero point spectrum for a
compact operator, but it does not itself provide the away-from-zero finiteness statement consumed
by the selection wrapper below.  This intermediate wrapper therefore exposes `hAway`; the
subsequent `CompactSelfAdjointAwayFromZeroExtension` proves that fact from compactness and
self-adjointness and supplies corrected wrappers with no `hAway` premise.

The declarations carrying the `prop4_23_` prefix are **prerequisite bridges**, not a claim that
Proposition 4.23's mass-gap conclusion follows from compact resolvent alone.  In typed evidence they
must therefore be classified as conditional/prerequisite bridges.  The least-gap wrapper for
Theorem A.7 separately exposes `hAway`, ground-complement coercivity, and nonempty off-ground point
spectrum.
-/

