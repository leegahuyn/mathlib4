namespace QYM.FullCertification.P3ActualStageL2SectionsExtension












/-!
# P3: the actual finite-stage inverse-eta `L²` section space

The preceding producers construct two genuinely geometric objects:

* the compact intrinsic stage `I.X Y = I.XSet Y` inside the literal orbit
  quotient `Gamma(2) \ H`; and
* the actual inverse-eta quotient line bundle, together with its proved
  eta-coordinate trivialization.

This file joins them.  The measure on `I.X Y` is the pullback of the canonical
quotient hyperbolic measure along the subtype inclusion.  It is finite because
`I.XSet Y` is compact and the quotient measure is locally finite.  The stage
section Hilbert space is then the genuine `L²` space in the proved eta
coordinate.  Every value of an `L²` representative is reconstructed as an
element of the actual quotient fibre; the projection law and the fibrewise
Hermitian/Petersson integral identity are proved below.

No supplier field, closedness hypothesis, or abstract Hilbert carrier occurs
in this construction.
-/

/-! ## 1. Canonical quotient and stage measures -/

/-- The quotient hyperbolic measure attached to the proved six-tile
`Gamma(2)` fundamental domain. -/
noncomputable def actualQuotientHyperbolicMeasure :
    Measure Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain.quotientMeasure

/-- The canonical quotient measure is locally finite. -/
noncomputable instance actualQuotientHyperbolicMeasure_isLocallyFinite :
    IsLocallyFiniteMeasure actualQuotientHyperbolicMeasure := by
  unfold actualQuotientHyperbolicMeasure
  infer_instance

/-- The canonical quotient measure is positive on every nonempty open set. -/
noncomputable instance actualQuotientHyperbolicMeasure_isOpenPos :
    Measure.IsOpenPosMeasure actualQuotientHyperbolicMeasure := by
  unfold actualQuotientHyperbolicMeasure
  infer_instance

/-- The inclusion of the measurable intrinsic stage into the quotient is a
measurable embedding. -/
theorem actualStageSubtype_measurableEmbedding (Y : ℝ) :
    MeasurableEmbedding
      (Subtype.val : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y -> Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :=
  MeasurableEmbedding.subtype_coe (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable Y)

/-- The actual measure on the compact stage.  `Measure.comap` is the canonical
measure on a measurable subtype; it does not count boundary points twice. -/
noncomputable def actualStageMeasure (Y : ℝ) : Measure (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :=
  Measure.comap
    (Subtype.val : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y -> Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)
    actualQuotientHyperbolicMeasure

/-- Pushing the stage measure back to the ambient quotient gives restriction
to the intrinsic stage exactly. -/
theorem map_actualStageMeasure_subtypeVal (Y : ℝ) :
    (actualStageMeasure Y).map
        (Subtype.val : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y -> Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) =
      actualQuotientHyperbolicMeasure.restrict (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
  ext s hs
  rw [Measure.map_apply
      (actualStageSubtype_measurableEmbedding Y).measurable hs,
    actualStageMeasure,
    Measure.comap_apply _
      (actualStageSubtype_measurableEmbedding Y).injective
      (actualStageSubtype_measurableEmbedding Y).measurableSet_image'
      _ ((actualStageSubtype_measurableEmbedding Y).measurable hs),
    Measure.restrict_apply hs, Set.image_preimage_eq_inter_range,
    Subtype.range_coe]

/-- The total mass of the subtype measure is exactly the quotient measure of
the compact intrinsic stage. -/
theorem actualStageMeasure_univ (Y : ℝ) :
    actualStageMeasure Y Set.univ =
      actualQuotientHyperbolicMeasure (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
  rw [actualStageMeasure,
    Measure.comap_apply _
      (actualStageSubtype_measurableEmbedding Y).injective
      (actualStageSubtype_measurableEmbedding Y).measurableSet_image'
      _ MeasurableSet.univ]
  simp only [Set.image_univ, Subtype.range_coe]

/-- Compactness of the actual stage supplies finite quotient mass. -/
theorem actualStageMeasure_univ_lt_top (Y : ℝ) :
    actualStageMeasure Y Set.univ < (∞ : ℝ≥0∞) := by
  rw [actualStageMeasure_univ]
  exact (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isCompact Y).measure_lt_top

/-- Each actual stage therefore carries a finite measure, with no finiteness
certificate supplied by the caller. -/
noncomputable instance actualStageMeasure_isFinite (Y : ℝ) :
    IsFiniteMeasure (actualStageMeasure Y) :=
  ⟨actualStageMeasure_univ_lt_top Y⟩

/-- If the stage has nonempty interior, its canonical measure is strictly
positive.  This isolates the exact topological input needed to rule out the
zero `L²` space. -/
theorem actualStageMeasure_univ_pos_of_interior_nonempty
    {Y : ℝ} (hY : (interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)).Nonempty) :
    0 < actualStageMeasure Y Set.univ := by
  rw [actualStageMeasure_univ]
  exact lt_of_lt_of_le
    (isOpen_interior.measure_pos actualQuotientHyperbolicMeasure hY)
    (measure_mono interior_subset)

/-- As soon as the normalized cutoff is strictly above one, an explicit
selected high-cusp point lies in the stage interior. -/
theorem actualStageInterior_nonempty_of_one_lt_level
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)).Nonempty := by
  let q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset :=
    Quotient.mk'' (1 : SL(2, ℤ))
  let h : QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight :=
    ⟨(1 + Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) / 2, by
      change 1 < (1 + Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) / 2
      linarith⟩
  let p : ℝ × QYM.FullCertification.P2CuspCollarClosureExtension.HighHeight := (0, h)
  have hp : p.2.1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y := by
    dsimp only [p, h]
    linarith
  have hzInterior :=
    QYM.FullCertification.P2StageManifoldWithBoundaryExtension.selectedHighPoint_mem_interior_saturatedXStage_of_height_lt
      q p hp
  have hQuotientInterior :=
    (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff Y
      (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q p)).2 hzInterior
  exact ⟨Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk (QYM.FullCertification.P2CuspCollarClosureExtension.selectedHighPoint q p),
    hQuotientInterior⟩

/-- Paper-range cutoffs satisfy the preceding strict inequality. -/
theorem actualStageInterior_nonempty_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)).Nonempty :=
  actualStageInterior_nonempty_of_one_lt_level
    (lt_of_lt_of_le one_lt_two hY)

/-- Every stage with normalized cutoff strictly above one has positive mass.
-/
theorem actualStageMeasure_univ_pos_of_one_lt_level
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    0 < actualStageMeasure Y Set.univ :=
  actualStageMeasure_univ_pos_of_interior_nonempty
    (actualStageInterior_nonempty_of_one_lt_level hY)

/-- Hence every paper-range stage has strictly positive canonical mass. -/
theorem actualStageMeasure_univ_pos_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    0 < actualStageMeasure Y Set.univ :=
  actualStageMeasure_univ_pos_of_one_lt_level
    (lt_of_lt_of_le one_lt_two hY)

theorem actualStageMeasure_ne_zero_of_one_lt_level
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageMeasure Y ≠ 0 := by
  intro hZero
  have hPos := actualStageMeasure_univ_pos_of_one_lt_level hY
  rw [hZero] at hPos
  simpa using hPos

theorem actualStageMeasure_ne_zero_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageMeasure Y ≠ 0 :=
  actualStageMeasure_ne_zero_of_one_lt_level
    (lt_of_lt_of_le one_lt_two hY)

/-! ## 2. The actual finite-stage scalar and bundle-section Hilbert spaces -/

/-- The concrete scalar `L²` carrier on the intrinsic compact quotient stage. -/
abbrev ActualStageScalarL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (actualStageMeasure Y)

/-- The inverse-eta bundle `L²` section carrier.

This is definitionally the scalar `L²` carrier because the preceding producer
proved a global eta-coordinate homeomorphism of the *actual* quotient total
space.  The definitions below reconstruct the literal fibre value and prove
that this coordinate presentation is exact. -/
abbrev ActualStageInverseEtaL2Section (Y : ℝ) :=
  ActualStageScalarL2 Y

/-- The point of the raw Mock2 quotient canonically corresponding to one point
of the faithful P2 stage. -/
noncomputable def actualStageBasePoint
    {Y : ℝ}
    (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaBase :=
  QYM.FullCertification.P3GammaTwoQuotientBridgeExtension.effectiveToOriginal
    (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient)

theorem actualStageBasePoint_measurable (Y : ℝ) :
    Measurable (actualStageBasePoint (Y := Y)) :=
  QYM.FullCertification.P3GammaTwoQuotientBridgeExtension.effectiveToOriginal_measurable.comp
    measurable_subtype_coe

/-- Reconstruct the actual quotient-total-space value of an `L²` section from
its eta coordinate. -/
noncomputable def actualStageBundleValue
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaTotal :=
  QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar
    (actualStageBasePoint x) (u x)

/-- The chosen point representative of every stage `L²` class reconstructs
an almost-everywhere measurable actual total-space representative.  The
statement is deliberately a.e.-measurability, since an `L²` class has no
canonical everywhere-measurable point representative. -/
theorem actualStageBundleValue_aemeasurable
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) :
    AEMeasurable (actualStageBundleValue u) (actualStageMeasure Y) := by
  have hPair : AEMeasurable
      (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
        (actualStageBasePoint x, (u x : ℂ)))
      (actualStageMeasure Y) :=
    (actualStageBasePoint_measurable Y).aemeasurable.prodMk
      (MeasureTheory.Lp.aestronglyMeasurable u).aemeasurable
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar_continuous.measurable.comp_aemeasurable hPair

/-- The reconstructed value lies over the requested quotient point exactly. -/
@[simp] theorem actualStageBundleValue_projection
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection (actualStageBundleValue u x) =
      actualStageBasePoint x := by
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection_totalOfBaseScalar _ _

/-- The same value, now typed in the actual fibre over `x`. -/
noncomputable def actualStageFibreValue
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaFibre
      (actualStageBasePoint x) :=
  ⟨actualStageBundleValue u x,
    actualStageBundleValue_projection u x⟩

/-- Eta trivialization recovers the original `L²` representative pointwise. -/
@[simp] theorem actualStageFibreValue_coordinate
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinate (actualStageFibreValue u x) = u x := by
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.etaTrivializedCoordinate_totalOfBaseScalar _ _

/-- Equality of reconstructed values at one point is exactly equality of the
chosen `L²` representatives at that point.  No false point-evaluation
injectivity statement for `L²` equivalence classes is asserted. -/
theorem actualStageFibreValue_eq_iff
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageFibreValue u x = actualStageFibreValue v x ↔
      u x = v x := by
  constructor
  · intro huv
    have hCoordinate := congrArg QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinate huv
    simpa only [actualStageFibreValue_coordinate] using hCoordinate
  · intro huv
    apply (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinateEquiv
      (actualStageBasePoint x)).injective
    simpa only [actualStageFibreValue_coordinate] using huv

/-! ## 3. Descended Hermitian metric and the Petersson pairing -/

/-- The actual fibrewise inverse-eta Hermitian pairing of two stage section
representatives. -/
noncomputable def actualStagePointwiseHermitian
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y)
    (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℂ :=
  QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreHermitian
    (actualStageFibreValue u x) (actualStageFibreValue v x)

/-- In the proved eta coordinate the descended fibre metric is the standard
complex inner product. -/
@[simp] theorem actualStagePointwiseHermitian_eq_inner
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y)
    (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStagePointwiseHermitian u v x = inner ℂ (u x) (v x) := by
  rw [actualStagePointwiseHermitian, QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreHermitian]
  simp only [actualStageFibreValue_coordinate]

/-- The actual descended fibrewise Hermitian pairing is Bochner integrable
for every pair of stage `L²` sections. -/
theorem actualStagePointwiseHermitian_integrable
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y) :
    Integrable (actualStagePointwiseHermitian u v)
      (actualStageMeasure Y) := by
  exact (MeasureTheory.L2.integrable_inner u v).congr
    (Filter.Eventually.of_forall fun x =>
      (actualStagePointwiseHermitian_eq_inner u v x).symm)

/-- The finite-stage Petersson inner product is the Hilbert inner product on
the concrete `L²` carrier. -/
noncomputable def actualStagePeterssonInner
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y) : ℂ :=
  inner ℂ u v

/-- The Hilbert inner product is exactly integration of the actual descended
fibrewise Hermitian metric. -/
theorem actualStagePeterssonInner_eq_integral
    {Y : ℝ} (u v : ActualStageInverseEtaL2Section Y) :
    actualStagePeterssonInner u v =
      ∫ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, actualStagePointwiseHermitian u v x
        ∂actualStageMeasure Y := by
  rw [actualStagePeterssonInner, MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards with x
  exact (actualStagePointwiseHermitian_eq_inner u v x).symm

/-- Positivity of the concrete Petersson form. -/
theorem actualStagePeterssonInner_self_re_nonneg
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) :
    0 ≤ (actualStagePeterssonInner u u).re := by
  unfold actualStagePeterssonInner
  exact inner_self_nonneg (𝕜 := ℂ)

/-- Definiteness of the concrete Petersson form. -/
theorem actualStagePeterssonInner_self_re_eq_zero_iff
    {Y : ℝ} (u : ActualStageInverseEtaL2Section Y) :
    (actualStagePeterssonInner u u).re = 0 ↔ u = 0 := by
  unfold actualStagePeterssonInner
  rw [inner_self_eq_norm_sq_to_K]
  change ‖u‖ ^ 2 = 0 ↔ u = 0
  rw [sq_eq_zero_iff, norm_eq_zero]

/-! ## 4. Restriction of genuine quotient sections -/

/-- Eta coordinate of a genuine quotient section after restriction to the
intrinsic stage. -/
noncomputable def actualStageSectionCoordinate
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y -> ℂ :=
  fun x =>
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.etaTrivializedCoordinate
      (s (actualStageBasePoint x))

/-- The actual global inverse-eta quotient section obtained by descending
the proved covariant inverse-eta lift. -/
noncomputable def distinguishedInverseEtaQuotientSection :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection :=
  QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift

@[simp]
theorem distinguishedInverseEtaQuotientSection_coordinate
    (x : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaBase) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.etaTrivializedCoordinate
        (distinguishedInverseEtaQuotientSection x) = 1 := by
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaSection_coordinate x

/-- The distinguished quotient section is literally reconstruction from
base point and constant eta coordinate one. -/
theorem distinguishedInverseEtaQuotientSection_eq_totalOfBaseScalar
    (x : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaBase) :
    distinguishedInverseEtaQuotientSection x =
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar x 1 := by
  calc
    distinguishedInverseEtaQuotientSection x =
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar
          (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection
            (distinguishedInverseEtaQuotientSection x))
          (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.etaTrivializedCoordinate
            (distinguishedInverseEtaQuotientSection x)) :=
      (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar_projection_coordinate _).symm
    _ = QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar x 1 := by
      rw [distinguishedInverseEtaQuotientSection_coordinate,
        distinguishedInverseEtaQuotientSection.projection_toFun]

/-- Unlike an arbitrary set-theoretic quotient section, the distinguished
inverse-eta quotient section is continuous. -/
theorem distinguishedInverseEtaQuotientSection_continuous :
    Continuous distinguishedInverseEtaQuotientSection.toFun := by
  rw [show distinguishedInverseEtaQuotientSection.toFun =
      (fun x : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaBase =>
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar x 1) by
    funext x
    exact distinguishedInverseEtaQuotientSection_eq_totalOfBaseScalar x]
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar_continuous.comp
    (continuous_id.prodMk continuous_const)

theorem distinguishedInverseEtaQuotientSection_measurable :
    Measurable distinguishedInverseEtaQuotientSection.toFun :=
  distinguishedInverseEtaQuotientSection_continuous.measurable

@[simp]
theorem actualStageSectionCoordinate_distinguished
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageSectionCoordinate Y
        distinguishedInverseEtaQuotientSection x = 1 := by
  exact distinguishedInverseEtaQuotientSection_coordinate
    (actualStageBasePoint x)

/-- A measurable quotient section has measurable eta coordinate on every
actual stage. -/
theorem actualStageSectionCoordinate_measurable
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection)
    (hs : Measurable s.toFun) :
    Measurable (actualStageSectionCoordinate Y s) := by
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.etaTrivializedCoordinate_continuous.measurable.comp
    (hs.comp (actualStageBasePoint_measurable Y))

/-- Exact square-integrability predicate for a genuine quotient section on the
actual stage.  Unlike an abstract certificate, this is `MemLp` of its explicit
eta-coordinate function. -/
def IsSquareIntegrableOnActualStage
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection) : Prop :=
  MemLp (actualStageSectionCoordinate Y s) 2 (actualStageMeasure Y)

/-- The genuine global distinguished quotient section is square integrable
on every compact stage because its actual eta coordinate is exactly one. -/
theorem distinguishedInverseEtaQuotientSection_isSquareIntegrable
    (Y : ℝ) :
    IsSquareIntegrableOnActualStage Y
      distinguishedInverseEtaQuotientSection := by
  unfold IsSquareIntegrableOnActualStage
  have hCoordinate :
      actualStageSectionCoordinate Y
          distinguishedInverseEtaQuotientSection =
        (fun _ : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (1 : ℂ)) := by
    funext x
    exact actualStageSectionCoordinate_distinguished Y x
  rw [hCoordinate]
  exact memLp_const (1 : ℂ)

/-- A genuinely square-integrable quotient section determines an element of
the concrete stage Hilbert space. -/
noncomputable def quotientSectionToActualStageL2
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection)
    (hs : IsSquareIntegrableOnActualStage Y s) :
    ActualStageInverseEtaL2Section Y :=
  MeasureTheory.MemLp.toLp (actualStageSectionCoordinate Y s) hs

/-- The `L²` representative agrees almost everywhere with the explicit eta
coordinate of the original section. -/
theorem quotientSectionToActualStageL2_coeFn_ae
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection)
    (hs : IsSquareIntegrableOnActualStage Y s) :
    ((quotientSectionToActualStageL2 Y s hs :
        ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y -> ℂ) =ᵐ[
          actualStageMeasure Y]
      actualStageSectionCoordinate Y s := by
  exact hs.coeFn_toLp

/-- Reconstructing actual fibre values from the restricted `L²` coordinate
recovers the original quotient section almost everywhere. -/
theorem quotientSectionToActualStageL2_bundleValue_ae
    (Y : ℝ) (s : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection)
    (hs : IsSquareIntegrableOnActualStage Y s) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      actualStageBundleValue
        (quotientSectionToActualStageL2 Y s hs) x) =ᵐ[
          actualStageMeasure Y]
      (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => s (actualStageBasePoint x)) := by
  filter_upwards [quotientSectionToActualStageL2_coeFn_ae Y s hs]
    with x hx
  rw [actualStageBundleValue, hx, actualStageSectionCoordinate]
  rw [← s.projection_toFun (actualStageBasePoint x)]
  exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.totalOfBaseScalar_projection_coordinate
    (s (actualStageBasePoint x))

/-! ## 5. The distinguished inverse-eta `L²` section -/

/-- The distinguished inverse-eta section on the actual stage.  Its proved eta
coordinate is the constant `1`, which is in `L²` because the stage measure is
finite. -/
noncomputable def actualStageDistinguishedInverseEtaSection (Y : ℝ) :
    ActualStageInverseEtaL2Section Y :=
  MeasureTheory.Lp.const 2 (actualStageMeasure Y) (1 : ℂ)

/-- Restriction of the genuine global distinguished quotient section agrees
exactly, as an `L²` class, with the independently defined constant-one stage
section. -/
theorem quotientDistinguishedInverseEtaSection_toActualStageL2
    (Y : ℝ) :
    quotientSectionToActualStageL2 Y
        distinguishedInverseEtaQuotientSection
        (distinguishedInverseEtaQuotientSection_isSquareIntegrable Y) =
      actualStageDistinguishedInverseEtaSection Y := by
  change quotientSectionToActualStageL2 Y
      distinguishedInverseEtaQuotientSection
      (distinguishedInverseEtaQuotientSection_isSquareIntegrable Y) =
    MeasureTheory.Lp.const 2 (actualStageMeasure Y) (1 : ℂ)
  rw [MeasureTheory.Lp.ext_iff]
  filter_upwards
    [quotientSectionToActualStageL2_coeFn_ae Y
      distinguishedInverseEtaQuotientSection
      (distinguishedInverseEtaQuotientSection_isSquareIntegrable Y),
    MeasureTheory.Lp.coeFn_const
      (α := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (p := (2 : ℝ≥0∞))
      (μ := actualStageMeasure Y) (c := (1 : ℂ))]
    with x hxSection hxConst
  calc
    quotientSectionToActualStageL2 Y
          distinguishedInverseEtaQuotientSection
          (distinguishedInverseEtaQuotientSection_isSquareIntegrable Y) x =
        actualStageSectionCoordinate Y
          distinguishedInverseEtaQuotientSection x := hxSection
    _ = 1 := actualStageSectionCoordinate_distinguished Y x
    _ = MeasureTheory.Lp.const 2
          (actualStageMeasure Y) (1 : ℂ) x := by
      simpa only [Function.const_apply] using hxConst.symm

/-- Fibre reconstruction from the constant-one stage `L²` class recovers
the genuine global inverse-eta quotient section almost everywhere. -/
theorem actualStageDistinguishedInverseEtaSection_bundleValue_ae
    (Y : ℝ) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      actualStageBundleValue
        (actualStageDistinguishedInverseEtaSection Y) x) =ᵐ[
          actualStageMeasure Y]
      (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
        distinguishedInverseEtaQuotientSection
          (actualStageBasePoint x)) := by
  simpa only [quotientDistinguishedInverseEtaSection_toActualStageL2] using
    (quotientSectionToActualStageL2_bundleValue_ae Y
      distinguishedInverseEtaQuotientSection
      (distinguishedInverseEtaQuotientSection_isSquareIntegrable Y))

/-- The actual fibre coordinate of the distinguished section is one almost
everywhere. -/
theorem actualStageDistinguishedInverseEtaSection_coordinate_ae
    (Y : ℝ) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinate
        (actualStageFibreValue
          (actualStageDistinguishedInverseEtaSection Y) x)) =ᵐ[
            actualStageMeasure Y]
      (fun _ : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (1 : ℂ)) := by
  filter_upwards [MeasureTheory.Lp.coeFn_const
      (α := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (p := (2 : ℝ≥0∞))
      (μ := actualStageMeasure Y) (c := (1 : ℂ))]
    with x hx
  simpa only [actualStageDistinguishedInverseEtaSection,
    actualStageFibreValue_coordinate, Function.const_apply] using hx

/-- The descended Hermitian norm of the distinguished stage section is one
almost everywhere. -/
theorem actualStageDistinguishedInverseEtaSection_norm_ae
    (Y : ℝ) :
    (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreHermitianNorm
        (actualStageFibreValue
          (actualStageDistinguishedInverseEtaSection Y) x)) =ᵐ[
            actualStageMeasure Y]
      (fun _ : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (1 : ℝ)) := by
  filter_upwards
    [actualStageDistinguishedInverseEtaSection_coordinate_ae Y]
    with x hx
  rw [QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreHermitianNorm, hx, norm_one]

/-- Exact norm of the distinguished section on a positive paper-range
stage.  The right side is the square root power of the actual stage mass. -/
theorem actualStageDistinguishedInverseEtaSection_norm
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ‖actualStageDistinguishedInverseEtaSection Y‖ =
      (actualStageMeasure Y).real Set.univ ^
        (1 / (2 : ℝ≥0∞).toReal) := by
  letI : NeZero (actualStageMeasure Y) :=
    ⟨actualStageMeasure_ne_zero_of_one_lt_level hY⟩
  simpa only [actualStageDistinguishedInverseEtaSection,
    norm_one, one_mul] using
    (MeasureTheory.Lp.norm_const
      (α := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) (p := (2 : ℝ≥0∞))
      (μ := actualStageMeasure Y) (c := (1 : ℂ)) (by norm_num))

/-- The distinguished inverse-eta stage section is genuinely nonzero for
every cutoff in the certified paper range. -/
theorem actualStageDistinguishedInverseEtaSection_ne_zero
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualStageDistinguishedInverseEtaSection Y ≠ 0 := by
  letI : NeZero (actualStageMeasure Y) :=
    ⟨actualStageMeasure_ne_zero_of_one_lt_level hY⟩
  apply norm_pos_iff.mp
  rw [actualStageDistinguishedInverseEtaSection_norm hY]
  exact Real.rpow_pos_of_pos measureReal_univ_pos _

/-! ## 6. Aggregate unconditional endpoint -/

/-- The finite-stage inverse-eta `L²` endpoint.  Every component is a theorem
about the concrete quotient, concrete compact stage, canonical quotient
measure, and actual quotient line bundle. -/
theorem actualStageInverseEtaL2Certificate (Y : ℝ) :
    actualStageMeasure Y Set.univ < (∞ : ℝ≥0∞) ∧
      (∀ (u : ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y),
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection (actualStageBundleValue u x) =
          actualStageBasePoint x) ∧
      (∀ u v : ActualStageInverseEtaL2Section Y,
        actualStagePeterssonInner u v =
          ∫ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, actualStagePointwiseHermitian u v x
            ∂actualStageMeasure Y) ∧
      (∀ u : ActualStageInverseEtaL2Section Y,
        (actualStagePeterssonInner u u).re = 0 ↔ u = 0) ∧
      ((fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaFibreCoordinate
          (actualStageFibreValue
            (actualStageDistinguishedInverseEtaSection Y) x)) =ᵐ[
              actualStageMeasure Y]
        (fun _ : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y => (1 : ℂ))) := by
  exact
    ⟨actualStageMeasure_univ_lt_top Y,
      actualStageBundleValue_projection,
      actualStagePeterssonInner_eq_integral,
      actualStagePeterssonInner_self_re_eq_zero_iff,
      actualStageDistinguishedInverseEtaSection_coordinate_ae Y⟩

/-- Positive-mass refinement above the normalized height-one threshold,
including genuine
nontriviality and compatibility with the descended global quotient section.
-/
theorem actualStageInverseEtaL2PositiveCertificate
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    0 < actualStageMeasure Y Set.univ ∧
      actualStageDistinguishedInverseEtaSection Y ≠ 0 ∧
      (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
        actualStageBundleValue
          (actualStageDistinguishedInverseEtaSection Y) x) =ᵐ[
            actualStageMeasure Y]
        (fun x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y =>
          distinguishedInverseEtaQuotientSection
            (actualStageBasePoint x)) := by
  exact ⟨actualStageMeasure_univ_pos_of_one_lt_level hY,
    actualStageDistinguishedInverseEtaSection_ne_zero hY,
    actualStageDistinguishedInverseEtaSection_bundleValue_ae Y⟩

end QYM.FullCertification.P3ActualStageL2SectionsExtension

