namespace QYM.FullCertification.P12ActualInverseEtaProjectionHamiltonianExtension








/-!
# P12: the bounded inverse-eta projection Hamiltonian

On every actual finite stage in the paper range, the normalized inverse-eta
rank-one projection `P_Y` is already constructed without an abstract carrier.
This file forms the bounded complementary projection

`Hproj_Y = 1 - P_Y`.

Its complete two-block algebra is proved directly: the full ground space is
the distinguished inverse-eta line, the level-one space is its entire
orthogonal complement, and the quadratic energy on that complement is
exactly the squared norm.  In particular, the off-ground coercivity constant
is exactly one and does not depend on an ordering of eigenvalues or on ground
multiplicity.

The final no-go theorem is equally important.  The actual stage carrier is
infinite dimensional, so this everywhere-defined bounded complementary
projection cannot have compact resolvent at any real resolvent point.  Thus
`Hproj_Y` is a rigorous bounded surrogate and is not identified with the
paper's genuinely unbounded compact-resolvent Hamiltonian.
-/

/-! ## 1. Paper-range normalization and the complementary projection -/

/-- The paper cutoff implies the strict height inequality needed to
normalize the actual inverse-eta test vector. -/
theorem paperRange_one_lt_gammaTwoCuspLevel
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y :=
  lt_of_lt_of_le one_lt_two hY

/-- The normalized actual inverse-eta projection at a paper-range stage. -/
noncomputable def actualPaperRangeInverseEtaProjection
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℂ]
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y :=
  QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaProjection
    (paperRange_one_lt_gammaTwoCuspLevel hY)

@[simp]
theorem actualPaperRangeInverseEtaProjection_apply
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    actualPaperRangeInverseEtaProjection hY u =
      inner ℂ
          (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaTestVector
            (paperRange_one_lt_gammaTwoCuspLevel hY)) u •
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaTestVector
          (paperRange_one_lt_gammaTwoCuspLevel hY) := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaProjection_apply
    (paperRange_one_lt_gammaTwoCuspLevel hY) u

/-- The bounded projection surrogate `Hproj_Y = 1 - P_Y`. -/
noncomputable def actualInverseEtaProjectionHamiltonian
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y →L[ℂ]
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y :=
  1 - actualPaperRangeInverseEtaProjection hY

@[simp]
theorem actualInverseEtaProjectionHamiltonian_apply
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    actualInverseEtaProjectionHamiltonian hY u =
      u - actualPaperRangeInverseEtaProjection hY u := by
  rw [actualInverseEtaProjectionHamiltonian,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.one_apply]

/-- Fully expanded pointwise formula for the bounded surrogate. -/
theorem actualInverseEtaProjectionHamiltonian_apply_expanded
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y) :
    actualInverseEtaProjectionHamiltonian hY u =
      u - inner ℂ
          (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaTestVector
            (paperRange_one_lt_gammaTwoCuspLevel hY)) u •
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualNormalizedInverseEtaTestVector
          (paperRange_one_lt_gammaTwoCuspLevel hY) := by
  rw [actualInverseEtaProjectionHamiltonian_apply,
    actualPaperRangeInverseEtaProjection_apply]

/-! ## 2. Projection identities and exact block action -/

theorem actualPaperRangeInverseEtaProjection_isIdempotent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    IsIdempotentElem (actualPaperRangeInverseEtaProjection hY) :=
