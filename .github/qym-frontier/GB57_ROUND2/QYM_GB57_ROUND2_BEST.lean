  nlinarith

/-- The obstruction is not peculiar to the displayed rank-one map: a compact
analysis operator on the actual infinite-dimensional off-test carrier cannot
satisfy the same two-sided package on the whole carrier. -/
theorem actualOffGround_compactAnalysis_no_twoSidedFrameEnergyEstimate
    {K : Type*} [NormedAddCommGroup K] [NormedSpace ℂ K]
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →L[ℂ] K)
    (hCompact : IsCompactOperator T)
    (a : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y → ℝ)
    (lambda0 : ℝ) :
