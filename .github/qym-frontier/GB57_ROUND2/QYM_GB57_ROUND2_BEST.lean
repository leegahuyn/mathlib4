theorem actualCutoffEscapeHamiltonian_escapeWitness_eq_self
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n
