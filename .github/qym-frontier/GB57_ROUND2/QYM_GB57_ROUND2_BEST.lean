open Function Set Topology
open scoped MatrixGroups UpperHalfPlane

namespace QYM.FullCertification.P2ConnectedCuspComponentsExtension










open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# Connected named-cusp boundary components

This producer removes the last connectedness premise in the exact-three-cusp
boundary theorem at normalized level at least two.

For a selected tile `q`, the map

`t ↦ gammaTwoQuotientMk (gammaTwoSelectedHorocycleParam q Y t)`

is a continuous real-line loop in the effective quotient.  Two selected
tiles with the same mod-two cusp label have the same loop range: modulo two,
their matrices differ by at most one right multiplication by `T`, which only
translates the real parameter.

The substantive geometric direction is that the whole loop is represented
by the genuine active frontier.  Move a loop point into the selected closed
carrier and write it as `r • w`, with `w` in the standard closed modular
domain.  At height at least two, a modular matrix with nonzero lower-left
entry sends the point to height at most `1 / level ≤ 1 / 2`, whereas every
point of the standard domain has height strictly greater than `1 / 2`.
Thus the relative matrix is upper triangular, preserves the cutoff height,
and preserves the mod-two cusp label.  The resulting point is an actual
member of `activeTileCuspPart`.

No connectedness assumption, certificate field, or custom axiom occurs in
this file.
-/

/-! ## 1. The concrete quotient horocycle loop -/

/-- The selected-tile cutoff horocycle, now regarded as a map into the
effective quotient. -/
noncomputable def selectedCuspQuotientLoop
    (q : GammaTwoRightCoset) (Y t : ℝ) : GammaTwoQuotient :=
  gammaTwoQuotientMk (gammaTwoSelectedHorocycleParam q Y t)

/-- The horizontal point used by the trace producer is exactly the base point
inside `gammaTwoSelectedHorocycleParam`. -/
theorem selectedHorocycleParam_eq_traceHorizontal
    (q : GammaTwoRightCoset) (Y t : ℝ) :
    gammaTwoSelectedHorocycleParam q Y t =
      gammaTwoCosetRep q •
        QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t := by
  unfold gammaTwoSelectedHorocycleParam
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHeight
  apply congrArg (fun z : ℍ ↦ gammaTwoCosetRep q • z)
  rw [UpperHalfPlane.ext_iff]
  apply Complex.ext <;> simp

/-- A unit modular translation advances the concrete horizontal parameter by
one. -/
theorem modular_T_smul_traceHorizontal
    (Y t : ℝ) :
    ModularGroup.T • QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t =
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y (t + 1) := by
  rw [UpperHalfPlane.modular_T_smul, UpperHalfPlane.ext_iff]
  apply Complex.ext <;>
    simp [QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint,
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHeight, UpperHalfPlane.coe_vadd, add_comm]

/-- The upstairs selected horocycle parametrization is continuous. -/
theorem gammaTwoSelectedHorocycleParam_continuous
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Continuous (gammaTwoSelectedHorocycleParam q Y) := by
  rw [show gammaTwoSelectedHorocycleParam q Y =
      fun t : ℝ ↦ gammaTwoCosetRep q •
        QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t by
    funext t
    exact selectedHorocycleParam_eq_traceHorizontal q Y t]
  have hRepContinuous :
      Continuous (fun z : ℍ => gammaTwoCosetRep q • z) := by
    change Continuous
      (fun z : ℍ =>
        (gammaTwoCosetRep q : GL (Fin 2) ℝ) • z)
    exact continuous_const_smul
      (gammaTwoCosetRep q : GL (Fin 2) ℝ)
  exact hRepContinuous.comp
    (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_continuous Y)

/-- The concrete quotient loop is continuous. -/
theorem selectedCuspQuotientLoop_continuous
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Continuous (selectedCuspQuotientLoop q Y) :=
  gammaTwoQuotientMk_isOpenQuotientMap.continuous.comp
    (gammaTwoSelectedHorocycleParam_continuous q Y)

/-- Consequently every selected quotient-loop range is connected. -/
theorem selectedCuspQuotientLoop_range_isConnected
    (q : GammaTwoRightCoset) (Y : ℝ) :
    IsConnected (Set.range (selectedCuspQuotientLoop q Y)) :=
  isConnected_range (selectedCuspQuotientLoop_continuous q Y)

/-! ## 2. Same mod-two cusp class means the same quotient loop -/

/-- Coefficient reduction modulo two. -/
def reductionModTwo : SL(2, ℤ) →* SL(2, ZMod 2) :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod 2))

/-- Cusp label read directly from a matrix over `ZMod 2`. -/
def modTwoCuspClass (A : SL(2, ZMod 2)) : GammaTwoCusp :=
  if A 1 0 = 0 then
    .atInfinity
  else if A 0 0 = 0 then
    .zero
  else
    .one

/-- The selected-tile cusp label is literally the label of the reduced
selected representative. -/
theorem gammaTwoTileCuspClass_eq_modTwoCuspClass
    (q : GammaTwoRightCoset) :
    gammaTwoTileCuspClass q =
      modTwoCuspClass (reductionModTwo (gammaTwoCosetRep q)) := by
  rfl

/-- In `SL(2, ZMod 2)`, matrices with the same cusp label differ by at most
one right multiplication by `T`.  This is a kernel-checked decision proof on
the six-element special linear group. -/
theorem modTwoCuspClass_eq_cases
    (A C : SL(2, ZMod 2))
    (hClass : modTwoCuspClass A = modTwoCuspClass C) :
    A = C ∨ A = C * reductionModTwo ModularGroup.T := by
  revert A C
  decide

/-- Same-class selected representatives differ, up to a `Gamma(2)` element
on the left, by either `1` or one unit translation on the right. -/
theorem exists_gamma_rep_eq_or_rep_mul_T_of_cuspClass_eq
    (q r : GammaTwoRightCoset)
    (hClass : gammaTwoTileCuspClass r = gammaTwoTileCuspClass q) :
    (∃ gamma : GammaTwo,
      gammaTwoCosetRep r =
        (gamma : SL(2, ℤ)) * gammaTwoCosetRep q) ∨
    (∃ gamma : GammaTwo,
      gammaTwoCosetRep r =
        (gamma : SL(2, ℤ)) * gammaTwoCosetRep q * ModularGroup.T) := by
  have hModClass :
      modTwoCuspClass (reductionModTwo (gammaTwoCosetRep r)) =
        modTwoCuspClass (reductionModTwo (gammaTwoCosetRep q)) := by
    rw [← gammaTwoTileCuspClass_eq_modTwoCuspClass r,
      ← gammaTwoTileCuspClass_eq_modTwoCuspClass q]
    exact hClass
  rcases modTwoCuspClass_eq_cases
      (reductionModTwo (gammaTwoCosetRep r))
      (reductionModTwo (gammaTwoCosetRep q)) hModClass with
    hRed | hRed
  · let delta : SL(2, ℤ) :=
      gammaTwoCosetRep r * (gammaTwoCosetRep q)⁻¹
    have hDeltaRed : reductionModTwo delta = 1 := by
      simp [delta, hRed]
    have hDeltaMem : delta ∈ GammaTwo := by
      rw [CongruenceSubgroup.Gamma_mem']
      change reductionModTwo delta = 1
      exact hDeltaRed
    left
    refine ⟨⟨delta, hDeltaMem⟩, ?_⟩
    change gammaTwoCosetRep r = delta * gammaTwoCosetRep q
    simp [delta, mul_assoc]
  · let delta : SL(2, ℤ) :=
      gammaTwoCosetRep r *
        (gammaTwoCosetRep q * ModularGroup.T)⁻¹
    have hDeltaRed : reductionModTwo delta = 1 := by
      simp [delta, hRed]
    have hDeltaMem : delta ∈ GammaTwo := by
      rw [CongruenceSubgroup.Gamma_mem']
      change reductionModTwo delta = 1
      exact hDeltaRed
    right
    refine ⟨⟨delta, hDeltaMem⟩, ?_⟩
    change gammaTwoCosetRep r =
      delta * gammaTwoCosetRep q * ModularGroup.T
    simp [delta, mul_assoc]

/-- One same-class selected quotient-loop range is contained in the other. -/
theorem selectedCuspQuotientLoop_range_subset_of_cuspClass_eq
    (Y : ℝ) (q r : GammaTwoRightCoset)
    (hClass : gammaTwoTileCuspClass r = gammaTwoTileCuspClass q) :
    Set.range (selectedCuspQuotientLoop r Y) ⊆
      Set.range (selectedCuspQuotientLoop q Y) := by
  intro x hx
  rcases hx with ⟨t, rfl⟩
  rcases exists_gamma_rep_eq_or_rep_mul_T_of_cuspClass_eq
      q r hClass with ⟨gamma, hRep⟩ | ⟨gamma, hRep⟩
  · refine ⟨t, ?_⟩
    unfold selectedCuspQuotientLoop
    rw [selectedHorocycleParam_eq_traceHorizontal,
      selectedHorocycleParam_eq_traceHorizontal]
    symm
    calc
      gammaTwoQuotientMk
          (gammaTwoCosetRep r •
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t) =
        gammaTwoQuotientMk
          ((gamma : SL(2, ℤ)) •
            (gammaTwoCosetRep q •
              QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t)) := by
                rw [hRep, mul_smul]
      _ = gammaTwoQuotientMk
          (gammaTwoCosetRep q •
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t) := by
              exact gammaTwoQuotientMk_gamma_smul gamma
                (gammaTwoCosetRep q •
                  QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t)
  · refine ⟨t + 1, ?_⟩
    unfold selectedCuspQuotientLoop
    rw [selectedHorocycleParam_eq_traceHorizontal,
      selectedHorocycleParam_eq_traceHorizontal]
    symm
    calc
      gammaTwoQuotientMk
          (gammaTwoCosetRep r •
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t) =
        gammaTwoQuotientMk
          ((gamma : SL(2, ℤ)) •
            (gammaTwoCosetRep q •
              (ModularGroup.T •
                QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t))) := by
                  rw [hRep, mul_smul, mul_smul]
      _ = gammaTwoQuotientMk
          (gammaTwoCosetRep q •
            (ModularGroup.T •
              QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t)) := by
                exact gammaTwoQuotientMk_gamma_smul gamma
                  (gammaTwoCosetRep q •
                    (ModularGroup.T •
                      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t))
      _ = gammaTwoQuotientMk
          (gammaTwoCosetRep q •
            QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y (t + 1)) := by
              rw [modular_T_smul_traceHorizontal]

/-- Selected quotient-loop ranges depend only on the mod-two cusp class. -/
theorem selectedCuspQuotientLoop_ranges_eq_of_cuspClass_eq
    (Y : ℝ) (q r : GammaTwoRightCoset)
    (hClass : gammaTwoTileCuspClass r = gammaTwoTileCuspClass q) :
    Set.range (selectedCuspQuotientLoop r Y) =
      Set.range (selectedCuspQuotientLoop q Y) := by
  apply Set.Subset.antisymm
  · exact selectedCuspQuotientLoop_range_subset_of_cuspClass_eq
      Y q r hClass
  · exact selectedCuspQuotientLoop_range_subset_of_cuspClass_eq
      Y r q hClass.symm

/-! ## 3. High horocycles reduce only through an upper-triangular bridge -/

/-- If the lower-left entry is nonzero, a modular transformation sends a
point to height at most the reciprocal of its original height. -/
theorem modular_im_smul_le_inv_im_of_lowerLeft_ne_zero
    (g : SL(2, ℤ)) (z : ℍ) (hc : g 1 0 ≠ 0) :
    (g • z).im ≤ 1 / z.im := by
  rw [ModularGroup.im_smul_eq_div_normSq,
    ModularGroup.denom_apply]
  have hcSq : (1 : ℝ) ≤ g 1 0 ^ 2 :=
    mod_cast (one_le_sq_iff_one_le_abs _).mpr (Int.one_le_abs hc)
  rw [show 1 / z.im = z.im / z.im ^ 2 by field_simp]
  gcongr
  rw [show Complex.normSq
      ((g 1 0) * z + (g 1 1)) =
        ((g 1 0) * z.re + (g 1 1)) ^ 2 +
          (g 1 0) ^ 2 * z.im ^ 2 by
    simp [Complex.normSq_apply]
    ring]
  nlinarith [sq_nonneg
    (((g 1 0 : ℤ) : ℝ) * z.re + ((g 1 1 : ℤ) : ℝ))]

/-- A point at height at least two cannot be sent into the standard closed
modular domain by a matrix with nonzero lower-left entry. -/
theorem modular_lowerLeft_eq_zero_of_two_le_of_smul_mem_fd
    (g : SL(2, ℤ)) (z : ℍ)
    (hz : 2 ≤ z.im) (hfd : g • z ∈ ModularGroup.fd) :
    g 1 0 = 0 := by
  by_contra hc
  have hUpper : (g • z).im ≤ 1 / z.im :=
    modular_im_smul_le_inv_im_of_lowerLeft_ne_zero g z hc
  have hInvLe : 1 / z.im ≤ (1 : ℝ) / 2 := by
    rw [div_le_iff₀ z.im_pos]
    nlinarith
  have hFdInv := QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.one_div_im_lt_two_of_mem_fd hfd
  have hHalfLt : (1 : ℝ) / 2 < (g • z).im := by
    rw [div_lt_iff₀ (UpperHalfPlane.im_pos (g • z))] at hFdInv
    nlinarith
  exact (not_lt_of_ge (hUpper.trans hInvLe)) hHalfLt

/-- An integral upper-triangular special-linear matrix preserves hyperbolic
height exactly. -/
theorem modular_im_smul_eq_of_lowerLeft_eq_zero
    (g : SL(2, ℤ)) (z : ℍ) (hc : g 1 0 = 0) :
    (g • z).im = z.im := by
  have hdet : g 0 0 * g 1 1 = 1 := by
    have h := g.det_coe
    rw [Matrix.det_fin_two, hc, mul_zero, sub_zero] at h
    exact h
  have hdiag := Int.mul_eq_one_iff_eq_one_or_neg_one.mp hdet
  have hden :
      Complex.normSq (UpperHalfPlane.denom g z) = 1 := by
    rcases hdiag with hdiag | hdiag
    · rw [modular_normSq_denom_eq_lowerRowQuadratic, hc, hdiag.2]
      norm_num
    · rw [modular_normSq_denom_eq_lowerRowQuadratic, hc, hdiag.2]
      norm_num
  rw [ModularGroup.im_smul_eq_div_normSq, hden, div_one]

/-! ## 4. Every full loop point has an active selected representative -/

/-- At normalized level at least two, an arbitrary point of the full selected
horocycle loop has a representative on an actual active frontier arc of the
same cusp class. -/
theorem exists_activeTileCuspPart_rep_of_loop
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) (t : ℝ) :
    ∃ (r : GammaTwoRightCoset) (u : ℍ),
      gammaTwoTileCuspClass r = gammaTwoTileCuspClass q ∧
      u ∈ QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.activeTileCuspPart Y r ∧
      gammaTwoQuotientMk u = selectedCuspQuotientLoop q Y t := by
  let base : ℍ := QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint Y t
  let z : ℍ := gammaTwoCosetRep q • base
  rcases gammaTwoClosedTileCarrier_orbit_covers z with
    ⟨a, haCarrier⟩
  let u : ℍ := a • z
  have huCarrier : u ∈ gammaTwoClosedTileCarrier := by
    simpa only [u] using haCarrier
  rcases mem_gammaTwoClosedTileCarrier_iff.mp huCarrier with
    ⟨r, w, hwfd, hrew⟩
  rcases effective_exists_gamma a with ⟨gamma, hgamma⟩
  let bridge : SL(2, ℤ) :=
    (gammaTwoCosetRep r)⁻¹ * (gamma : SL(2, ℤ)) *
      gammaTwoCosetRep q
  have hgammaZ : (gamma : SL(2, ℤ)) • z = u := by
    change gamma • z = u
    simpa only [u] using (hgamma z).symm
  have hbridgeMove : bridge • base = w := by
    calc
      bridge • base =
          (gammaTwoCosetRep r)⁻¹ •
            ((gamma : SL(2, ℤ)) •
              (gammaTwoCosetRep q • base)) := by
                simp only [bridge, mul_smul]
      _ = (gammaTwoCosetRep r)⁻¹ • u := by
            rw [show gammaTwoCosetRep q • base = z by rfl,
              hgammaZ]
      _ = w := by rw [← hrew, inv_smul_smul]
  have hbaseHeight : base.im = gammaTwoCuspLevel Y := by
    simpa only [base] using
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint_im Y t
  have hbaseTwo : 2 ≤ base.im := by
    rw [hbaseHeight]
    exact hY
  have hLower : bridge 1 0 = 0 :=
    modular_lowerLeft_eq_zero_of_two_le_of_smul_mem_fd
      bridge base hbaseTwo (hbridgeMove.symm ▸ hwfd)
  have hwHeight : w.im = gammaTwoCuspLevel Y := by
    calc
      w.im = (bridge • base).im := by rw [hbridgeMove]
      _ = base.im :=
        modular_im_smul_eq_of_lowerLeft_eq_zero bridge base hLower
      _ = gammaTwoCuspLevel Y := hbaseHeight
  have hClass :
      gammaTwoTileCuspClass r = gammaTwoTileCuspClass q := by
    exact QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.upperTriangularGammaBridge_preserves_tileCuspClass
      r q gamma (by simpa only [bridge] using hLower)
  have huStage : u ∈ gammaTwoThreeCuspTruncation Y := by
    refine ⟨huCarrier, ?_⟩
    intro _kappa s _hs
    calc
      gammaTwoTileHeight s u =
          (((gammaTwoCosetRep s)⁻¹ * gammaTwoCosetRep r) • w).im := by
            simp only [gammaTwoTileHeight, ← hrew, mul_smul]
      _ ≤ gammaTwoModularHeightEnvelope w :=
        modular_im_smul_le_heightEnvelope
          ((gammaTwoCosetRep s)⁻¹ * gammaTwoCosetRep r) w
      _ ≤ gammaTwoCuspLevel Y :=
        QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.modularHeightEnvelope_le_level_of_mem_fd
          hY hwfd hwHeight.le
  have huCurve : u ∈ gammaTwoSelectedHorocycleCurve r Y := by
    apply mem_gammaTwoSelectedHorocycleCurve_iff.mpr
    calc
      gammaTwoTileHeight r u = w.im := by
        unfold gammaTwoTileHeight
        rw [← hrew, inv_smul_smul]
      _ = gammaTwoCuspLevel Y := hwHeight
  have huActive : u ∈ QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.activeTileCuspPart Y r :=
    ⟨huStage, huCurve⟩
  have hQuotient :
      gammaTwoQuotientMk u = selectedCuspQuotientLoop q Y t := by
    calc
      gammaTwoQuotientMk u = gammaTwoQuotientMk z := by
        simpa only [u] using gammaTwoQuotientMk_smul a z
      _ = selectedCuspQuotientLoop q Y t := by
        unfold selectedCuspQuotientLoop
        rw [selectedHorocycleParam_eq_traceHorizontal]
  exact ⟨r, u, hClass, huActive, hQuotient⟩

/-! ## 5. Exact range identification and unconditional connectedness -/

/-- At level at least two, the genuine quotient cusp piece is exactly the
range of any selected real-line loop carrying that cusp label. -/
theorem quotientCuspBoundaryPiece_eq_selectedLoop_range
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y)
    (q : GammaTwoRightCoset) :
    QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y (gammaTwoTileCuspClass q) =
      Set.range (selectedCuspQuotientLoop q Y) := by
  apply Set.Subset.antisymm
  · intro x hx
    rw [QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.quotientCuspBoundaryPiece_eq_iUnion_image_activeTileCuspPart]
      at hx
    rcases Set.mem_iUnion.mp hx with ⟨r, hx⟩
    rcases hx with ⟨z, hzActive, rfl⟩
    have hzCurve : z ∈ gammaTwoSelectedHorocycleCurve r.1 Y :=
      hzActive.2
    rw [← gammaTwoSelectedHorocycleParam_range r.1 Y] at hzCurve
    rcases hzCurve with ⟨t, rfl⟩
    have hInRange :
        selectedCuspQuotientLoop r.1 Y t ∈
          Set.range (selectedCuspQuotientLoop r.1 Y) :=
      ⟨t, rfl⟩
    have hRanges :=
      selectedCuspQuotientLoop_ranges_eq_of_cuspClass_eq
        Y q r.1 r.2
    rw [hRanges] at hInRange
    simpa only [selectedCuspQuotientLoop] using hInRange
  · intro x hx
    rcases hx with ⟨t, rfl⟩
    rcases exists_activeTileCuspPart_rep_of_loop hY q t with
      ⟨r, u, hClass, huActive, hQuotient⟩
    unfold QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece
    refine ⟨u, ?_, hQuotient⟩
    rw [QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.literalCuspFrontierPart_eq_iUnion_activeTileCuspPart]
    let r' : {s : GammaTwoRightCoset //
        gammaTwoTileCuspClass s = gammaTwoTileCuspClass q} :=
      ⟨r, hClass⟩
    exact Set.mem_iUnion.2 ⟨r', huActive⟩

/-- The final connectedness input is now an unconditional theorem at every
normalized level at least two. -/
theorem cuspBoundaryPiecesConnectedAt_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y := by
  intro kappa
  rcases QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.gammaTwoTileCuspClass_surjective kappa with ⟨q, hq⟩
  rw [← hq, quotientCuspBoundaryPiece_eq_selectedLoop_range hY q]
  exact selectedCuspQuotientLoop_range_isConnected q Y

/-- Raw-cutoff spelling of quotient-cusp connectedness. -/
theorem cuspBoundaryPiecesConnectedAt_of_two_le_cutoff
    {Y : ℝ} (hY : 2 ≤ Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y := by
  have hLevel : 2 ≤ gammaTwoCuspLevel Y := by
    rw [gammaTwoCuspLevel_of_one_le (le_trans (by norm_num) hY)]
    exact hY
  exact cuspBoundaryPiecesConnectedAt_of_two_le_level hLevel

/-- Premise-free exact-three boundary decomposition at normalized level at
least two. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_level
    {Y : ℝ} (hY : 2 ≤ gammaTwoCuspLevel Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y :=
  QYM.FullCertification.P2ExactBoundaryInhabitantsExtension.exactThreeCuspBoundaryDecomposition_of_two_le_level_from_connectedness
    hY (cuspBoundaryPiecesConnectedAt_of_two_le_level hY)

/-- Raw-cutoff spelling of the premise-free exact-three theorem. -/
theorem exactThreeCuspBoundaryDecomposition_of_two_le_cutoff
    {Y : ℝ} (hY : 2 ≤ Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hLevel : 2 ≤ gammaTwoCuspLevel Y := by
    rw [gammaTwoCuspLevel_of_one_le (le_trans (by norm_num) hY)]
    exact hY
  exact exactThreeCuspBoundaryDecomposition_of_two_le_level hLevel

end QYM.FullCertification.P2ConnectedCuspComponentsExtension

