/-!
# P12 bridge: an unconditional noncoercivity witness

The preceding P12 producer proves that the elementary rank-one inverse-eta
test `|psi_Y><psi_Y|` cannot be coercive on the full orthogonal complement as
soon as that complement contains a nonzero vector.  The P4 nonconstant-core
producer constructs exactly such a vector from two literal cusp-collar
points, Urysohn separation, continuous-to-`L²` injection, and explicit
orthogonalization.

This file joins those two unconditional constructions.  For every paper-range
stage and every right-coset label it exhibits the concrete separating vector,
proves that the P12 rank-one energy vanishes on it, and refutes every positive
coercivity constant.

This is a deliberate semantic firewall: the elementary inverse-eta rank-one
baseline is **not** the paper's mock/Poincare or Rankin--Selberg operator.  The
theorems below show why the latter cannot be replaced by this rank-one
baseline in a spectral-gap argument.
-/

/-! ## 1. The explicit P4 witness in the P12 off-test space -/

/-- The concrete nonconstant-core vector, now named as the P12 off-test
witness. -/
noncomputable def actualInverseEtaOffTestWitness
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y :=
  QYM.FullCertification.P4ActualStageNonconstantCoreExtension.actualStageSeparatingOrthogonalL2 q hY

/-- The bridge identifies P4's distinguished-line complement with P12's
off-test subspace exactly. -/
theorem actualInverseEtaOffTestWitness_mem
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaOffTestWitness q hY ∈
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y := by
  change
    QYM.FullCertification.P4ActualStageNonconstantCoreExtension.actualStageSeparatingOrthogonalL2 q hY ∈
      QYM.FullCertification.P4ActualStageNonconstantCoreExtension.ActualStageDistinguishedComplement Y
  exact
    QYM.FullCertification.P4ActualStageNonconstantCoreExtension.actualStageSeparatingOrthogonalL2_mem_complement q hY

/-- The explicit off-test witness is genuinely nonzero. -/
theorem actualInverseEtaOffTestWitness_ne_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaOffTestWitness q hY ≠ 0 := by
  simpa only [actualInverseEtaOffTestWitness] using
    QYM.FullCertification.P4ActualStageNonconstantCoreExtension.actualStageSeparatingOrthogonalL2_ne_zero q hY

/-- Hence the P12 full off-test subspace is nontrivial on every paper-range
stage, now without a supplied witness premise. -/
theorem actualInverseEtaOffTestSubspace_nontrivial
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ∃ w : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
      w ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧ w ≠ 0 :=
  ⟨actualInverseEtaOffTestWitness q hY,
    actualInverseEtaOffTestWitness_mem q hY,
    actualInverseEtaOffTestWitness_ne_zero q hY⟩

theorem actualInverseEtaOffTestSubspace_ne_bot
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ≠ ⊥ := by
  intro hBot
  have hMem := actualInverseEtaOffTestWitness_mem q hY
  rw [hBot, Submodule.mem_bot] at hMem
  exact actualInverseEtaOffTestWitness_ne_zero q hY hMem

/-! ## 2. Exact vanishing of the elementary rank-one test -/

/-- The explicit witness is annihilated by the bounded inverse-eta analysis
functional. -/
theorem actualInverseEtaAnalysisFunctional_witness_eq_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaAnalysisFunctional Y
        (actualInverseEtaOffTestWitness q hY) = 0 := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.mem_actualInverseEtaOffTestSubspace_iff.mp
    (actualInverseEtaOffTestWitness_mem q hY)

/-- The rank-one operator itself kills the explicit witness. -/
theorem actualInverseEtaTestOperator_witness_eq_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestOperator Y
        (actualInverseEtaOffTestWitness q hY) = 0 := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestOperator_zero_of_mem_offTest
    (actualInverseEtaOffTestWitness_mem q hY)

/-- The elementary inverse-eta rank-one quadratic energy is exactly zero on
the concrete nonzero P4 witness. -/
theorem actualInverseEtaTestEnergy_witness_eq_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y
        (actualInverseEtaOffTestWitness q hY) = 0 := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy_zero_of_mem_offTest
    (actualInverseEtaOffTestWitness_mem q hY)

/-! ## 3. Unconditional paper-range noncoercivity -/

/-- Every positive proposed coercivity constant already fails at the explicit
P4 witness. -/
theorem actualInverseEtaTest_no_positive_bound_at_witness
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {c : ℝ} (hc : 0 < c) :
    ¬ c * ‖actualInverseEtaOffTestWitness q hY‖ ^ 2 ≤
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y
        (actualInverseEtaOffTestWitness q hY) := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.no_positive_coercivity_at_offTest_witness
    (actualInverseEtaOffTestWitness_mem q hY)
    (actualInverseEtaOffTestWitness_ne_zero q hY) hc

/-- For every positive constant, coercivity on the entire off-test subspace
is false.  No external witness premise remains. -/
theorem actualInverseEtaTest_no_positive_coercivity
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {c : ℝ} (hc : 0 < c) :
    ¬ (∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
        c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u) := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.no_positive_coercivity_on_offTest_of_witness
    (actualInverseEtaOffTestWitness q hY)
    (actualInverseEtaOffTestWitness_mem q hY)
    (actualInverseEtaOffTestWitness_ne_zero q hY) hc

/-- Main unconditional no-go theorem: on every paper-range stage there does
not exist any positive coercivity constant for the elementary inverse-eta
rank-one baseline on the full orthogonal complement. -/
theorem actualInverseEtaTest_no_exists_positive_coercivity
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
        u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
          c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u := by
  exact QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.no_exists_positive_coercivity_on_offTest_of_witness
    (actualInverseEtaOffTestWitness q hY)
    (actualInverseEtaOffTestWitness_mem q hY)
    (actualInverseEtaOffTestWitness_ne_zero q hY)

/-! ## 4. Aggregate unconditional endpoint -/

/-- Aggregate bridge certificate.  It records the concrete nonzero witness,
exact rank-one vanishing, and the fully unconditional paper-range no-go in one
statement. -/
theorem actualInverseEtaTestNoncoercivityBridgeCertificate
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaOffTestWitness q hY ∈
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧
      actualInverseEtaOffTestWitness q hY ≠ 0 ∧
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaAnalysisFunctional Y
          (actualInverseEtaOffTestWitness q hY) = 0 ∧
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestOperator Y
          (actualInverseEtaOffTestWitness q hY) = 0 ∧
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y
          (actualInverseEtaOffTestWitness q hY) = 0 ∧
      (∀ c : ℝ, 0 < c →
        ¬ (∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
          u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
            c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u)) ∧
      ¬ ∃ c : ℝ, 0 < c ∧
        ∀ u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y,
          u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y →
            c * ‖u‖ ^ 2 ≤ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.actualInverseEtaTestEnergy Y u := by
  exact
    ⟨actualInverseEtaOffTestWitness_mem q hY,
      actualInverseEtaOffTestWitness_ne_zero q hY,
      actualInverseEtaAnalysisFunctional_witness_eq_zero q hY,
      actualInverseEtaTestOperator_witness_eq_zero q hY,
      actualInverseEtaTestEnergy_witness_eq_zero q hY,
      fun c hc => actualInverseEtaTest_no_positive_coercivity q hY hc,
      actualInverseEtaTest_no_exists_positive_coercivity q hY⟩

end QYM.FullCertification.P12ActualInverseEtaTestNoncoercivityBridgeExtension

