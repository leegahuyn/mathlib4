open scoped BigOperators

/-!
# Finite-support diagonal quadratic forms

This module replaces the raw sequence carrier used by the earlier diagonal sign model with the
genuine finite-support space `ℕ →₀ ℝ`.  Its squared norm and both diagonal energies are finite sums
over the actual support of the state.

The standard finitely supported sequences are the usual algebraic core underlying a dense subspace
of `ℓ²`.  The theorems below show, already on this algebraic-core surrogate, that a diagonal
`-Δ + V` sign pattern with bounded-above potential cannot have a quadratic-form lower bound, while
the corrected `+Δ + V` pattern does have one when the potential is bounded below.  This file does
not construct the embedding into `ℓ²`, prove density there, define a closed or closable Hilbert
form, identify a differential Laplacian, or construct a self-adjoint operator.
-/

namespace QYM.FinsuppDiagonalQuadraticForm

/-- Algebraic states with genuinely finite support. -/
abbrev State := ℕ →₀ ℝ

/-- Squared Euclidean length, summed only over the finite support. -/
def normSq (x : State) : ℝ :=
  ∑ n ∈ x.support, x n ^ 2

/-- Diagonal quadratic form with the sign pattern `-n + vₙ`. -/
def wrongSignEnergy (v : ℕ → ℝ) (x : State) : ℝ :=
  ∑ n ∈ x.support, (-(n : ℝ) + v n) * x n ^ 2

/-- Diagonal quadratic form with the corrected sign pattern `n + vₙ`. -/
def correctedEnergy (v : ℕ → ℝ) (x : State) : ℝ :=
  ∑ n ∈ x.support, ((n : ℝ) + v n) * x n ^ 2

/-- A form lower bound measured against the finite-support squared norm. -/
def HasFormLowerBound (energy : State → ℝ) : Prop :=
  ∃ C : ℝ, ∀ x : State, C * normSq x ≤ energy x

theorem normSq_nonneg (x : State) : 0 ≤ normSq x := by
  unfold normSq
  exact Finset.sum_nonneg fun n _hn => sq_nonneg (x n)

/-! ## Exact single-support formulas -/

/-- Exact squared norm of an arbitrary one-coordinate state. -/
theorem normSq_single (n : ℕ) (a : ℝ) :
    normSq (Finsupp.single n a) = a ^ 2 := by
  by_cases ha : a = 0
  · subst a
    simp [normSq]
  · simp [normSq, Finsupp.support_single_ne_zero n ha]

/-- Exact wrong-sign energy of an arbitrary one-coordinate state. -/
theorem wrongSignEnergy_single (v : ℕ → ℝ) (n : ℕ) (a : ℝ) :
    wrongSignEnergy v (Finsupp.single n a) =
      (-(n : ℝ) + v n) * a ^ 2 := by
  by_cases ha : a = 0
  · subst a
    simp [wrongSignEnergy]
  · simp [wrongSignEnergy, Finsupp.support_single_ne_zero n ha]

/-- Exact corrected energy of an arbitrary one-coordinate state. -/
theorem correctedEnergy_single (v : ℕ → ℝ) (n : ℕ) (a : ℝ) :
    correctedEnergy v (Finsupp.single n a) =
      ((n : ℝ) + v n) * a ^ 2 := by
  by_cases ha : a = 0
  · subst a
    simp [correctedEnergy]
  · simp [correctedEnergy, Finsupp.support_single_ne_zero n ha]

/-- The unit state supported at coordinate `n`. -/
def basis (n : ℕ) : State := Finsupp.single n 1

@[simp]
theorem normSq_basis (n : ℕ) : normSq (basis n) = 1 := by
  simpa [basis] using normSq_single n 1

@[simp]
theorem wrongSignEnergy_basis (v : ℕ → ℝ) (n : ℕ) :
    wrongSignEnergy v (basis n) = -(n : ℝ) + v n := by
  simpa [basis] using wrongSignEnergy_single v n 1

@[simp]
theorem correctedEnergy_basis (v : ℕ → ℝ) (n : ℕ) :
    correctedEnergy v (basis n) = (n : ℝ) + v n := by
  simpa [basis] using correctedEnergy_single v n 1

/-! ## The wrong-sign form is not semibounded -/

/-- If `vₙ ≤ M`, unit basis states have wrong-sign energy below every prescribed real level. -/
theorem exists_basis_wrongSignEnergy_lt_of_potential_boundedAbove
    (v : ℕ → ℝ) (M C : ℝ) (hv : ∀ n, v n ≤ M) :
    ∃ n : ℕ, wrongSignEnergy v (basis n) < C := by
  obtain ⟨n, hn⟩ := exists_nat_gt (M - C)
  refine ⟨n, ?_⟩
  rw [wrongSignEnergy_basis]
  linarith [hv n]

/-- A bounded-above potential cannot make the `-n + vₙ` form bounded below, even on finitely
supported states. -/
theorem wrongSignEnergy_not_hasFormLowerBound_of_potential_boundedAbove
    (v : ℕ → ℝ) (M : ℝ) (hv : ∀ n, v n ≤ M) :
    ¬ HasFormLowerBound (wrongSignEnergy v) := by
  rintro ⟨C, hC⟩
  obtain ⟨n, henergy⟩ :=
    exists_basis_wrongSignEnergy_lt_of_potential_boundedAbove v M C hv
  have hbound := hC (basis n)
  rw [normSq_basis, mul_one] at hbound
  exact (not_lt_of_ge hbound) henergy

/-- The same obstruction under the usual stronger two-sided bounded-potential hypothesis. -/
theorem wrongSignEnergy_not_hasFormLowerBound_of_potential_abs_bounded
    (v : ℕ → ℝ) (M : ℝ) (hv : ∀ n, |v n| ≤ M) :
    ¬ HasFormLowerBound (wrongSignEnergy v) := by
  apply wrongSignEnergy_not_hasFormLowerBound_of_potential_boundedAbove v M
  intro n
  exact (le_abs_self (v n)).trans (hv n)

/-! ## The corrected form inherits a lower bound -/

/-- A lower bound on the potential is also a lower bound on every corrected diagonal
coefficient. -/
theorem correctedCoefficient_lower
    (v : ℕ → ℝ) (m : ℝ) (hv : ∀ n, m ≤ v n) (n : ℕ) :
    m ≤ (n : ℝ) + v n := by
  have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
  linarith [hv n]

/-- Termwise coefficient comparison gives the corrected quadratic-form inequality. -/
theorem correctedEnergy_lower
    (v : ℕ → ℝ) (m : ℝ) (hv : ∀ n, m ≤ v n) (x : State) :
    m * normSq x ≤ correctedEnergy v x := by
  rw [normSq, correctedEnergy, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n _hn
  exact mul_le_mul_of_nonneg_right
    (correctedCoefficient_lower v m hv n) (sq_nonneg (x n))

/-- A potential bounded below by `m` gives the corrected form the lower bound `m`. -/
theorem correctedEnergy_hasFormLowerBound_of_potential_boundedBelow
    (v : ℕ → ℝ) (m : ℝ) (hv : ∀ n, m ≤ v n) :
    HasFormLowerBound (correctedEnergy v) := by
  exact ⟨m, correctedEnergy_lower v m hv⟩

end QYM.FinsuppDiagonalQuadraticForm

/-!
# Finite spectral-window stability under a uniform eigenvalue error

This module isolates the unconditional finite counting statement behind a window-stability
argument.  It assumes only a pointwise error bound between two finite real spectra and proves
both pointwise window transfer and the corresponding cardinality inequalities.

It does not construct the spectra, prove compact resolvent, or supply the uniform error estimate.
-/

namespace QYM.SpectralWindowStability

/-- Membership in the closed energy window with displayed center and radius. -/
def InWindow (center radius value : ℝ) : Prop :=
  |value - center| ≤ radius

theorem inWindow_iff (center radius value : ℝ) :
    InWindow center radius value ↔ |value - center| ≤ radius := Iff.rfl

/-- A perturbed value in a radius-`η` window lies in the reference radius-`η + ε` window. -/
theorem reference_mem_expanded_window
    {reference perturbed center η ε : ℝ}
    (herror : |perturbed - reference| ≤ ε)
    (hperturbed : InWindow center η perturbed) :
    InWindow center (η + ε) reference := by
  unfold InWindow at hperturbed ⊢
  calc
    |reference - center| = |(reference - perturbed) + (perturbed - center)| := by ring_nf
    _ ≤ |reference - perturbed| + |perturbed - center| := abs_add_le _ _
    _ ≤ ε + η := by
      exact add_le_add (by simpa [abs_sub_comm] using herror) hperturbed
    _ = η + ε := add_comm _ _

/-- A reference value in the contracted radius-`η - ε` window lies in the perturbed
radius-`η` window. -/
theorem perturbed_mem_of_reference_mem_contracted_window
    {reference perturbed center η ε : ℝ}
    (herror : |perturbed - reference| ≤ ε)
    (href : InWindow center (η - ε) reference) :
    InWindow center η perturbed := by
  unfold InWindow at href ⊢
  calc
    |perturbed - center| = |(perturbed - reference) + (reference - center)| := by ring_nf
    _ ≤ |perturbed - reference| + |reference - center| := abs_add_le _ _
    _ ≤ ε + (η - ε) := add_le_add herror href
    _ = η := by ring

/-- Indices whose spectral values lie in one closed window. -/
def windowIndices {n : ℕ} (spectrum : Fin n → ℝ) (center radius : ℝ) : Finset (Fin n) := by
  classical
  exact Finset.univ.filter fun i => InWindow center radius (spectrum i)

theorem mem_windowIndices_iff {n : ℕ} (spectrum : Fin n → ℝ)
    (center radius : ℝ) (i : Fin n) :
    i ∈ windowIndices spectrum center radius ↔ InWindow center radius (spectrum i) := by
  simp [windowIndices]

/-- Every perturbed-window index belongs to the expanded reference window. -/
theorem perturbed_window_subset_expanded_reference_window
    {n : ℕ} (reference perturbed : Fin n → ℝ) (center η ε : ℝ)
    (herror : ∀ i, |perturbed i - reference i| ≤ ε) :
    windowIndices perturbed center η ⊆ windowIndices reference center (η + ε) := by
  intro i hi
  rw [mem_windowIndices_iff] at hi ⊢
  exact reference_mem_expanded_window (herror i) hi

/-- Every contracted-reference-window index belongs to the perturbed window. -/
theorem contracted_reference_window_subset_perturbed_window
    {n : ℕ} (reference perturbed : Fin n → ℝ) (center η ε : ℝ)
    (herror : ∀ i, |perturbed i - reference i| ≤ ε) :
    windowIndices reference center (η - ε) ⊆ windowIndices perturbed center η := by
  intro i hi
  rw [mem_windowIndices_iff] at hi ⊢
  exact perturbed_mem_of_reference_mem_contracted_window (herror i) hi

/-- The perturbed count is bounded above by the expanded reference count. -/
theorem perturbed_window_card_le_expanded_reference_window_card
    {n : ℕ} (reference perturbed : Fin n → ℝ) (center η ε : ℝ)
    (herror : ∀ i, |perturbed i - reference i| ≤ ε) :
    (windowIndices perturbed center η).card ≤
      (windowIndices reference center (η + ε)).card :=
  Finset.card_le_card
    (perturbed_window_subset_expanded_reference_window reference perturbed center η ε herror)

/-- Two-sided finite window-count stability.  No ordering or multiplicity convention beyond the
indexing function is needed: repeated values are counted through distinct indices. -/
theorem window_count_stability
    {n : ℕ} (reference perturbed : Fin n → ℝ) (center η ε : ℝ)
    (herror : ∀ i, |perturbed i - reference i| ≤ ε) :
    (windowIndices reference center (η - ε)).card ≤
        (windowIndices perturbed center η).card ∧
      (windowIndices perturbed center η).card ≤
        (windowIndices reference center (η + ε)).card := by
  constructor
  · exact Finset.card_le_card
      (contracted_reference_window_subset_perturbed_window
        reference perturbed center η ε herror)
  · exact perturbed_window_card_le_expanded_reference_window_card
      reference perturbed center η ε herror

end QYM.SpectralWindowStability



