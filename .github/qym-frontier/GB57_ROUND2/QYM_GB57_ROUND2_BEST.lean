namespace QYM.FullCertification.P2ManifoldD1BridgeExtension










open Mock2FA.PaperCorrections.AutomorphicSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfIntegralMultiplier
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators
open QYM.Mock2EtaCovariantDerivativeExtension
open QYM.Mock2EtaCovariantDerivativeExtension.Geometry

/-!
# The manifold-derivative / real-chart derivative bridge

The complex manifold structure on `UpperHalfPlane` is the singleton chart
induced by its open embedding into `ℂ`.  Consequently the preferred extended
chart is the inclusion, its inverse is `UpperHalfPlane.ofComplex`, and the
deck map written in those charts is exactly the already differentiated
`gammaTwoMoebiusChart`.

This file makes that identification explicit before comparing derivatives.
In particular, it does not identify `mfderiv` and the real `fderiv`-based
operator `d1` merely from their types.
-/

/-! ## 1. The singleton upper-half-plane chart -/

/-- The preferred extended chart on `UpperHalfPlane` is its inclusion into
`ℂ`.  The base point only selects the unique singleton chart. -/
@[simp]
theorem extChartAt_upperHalfPlane_apply (x y : ℍ) :
    extChartAt 𝓘(ℂ) x y = (y : ℂ) := by
  rfl

/-- The inverse of the preferred extended chart is the total section
`UpperHalfPlane.ofComplex` used by the real-coordinate API. -/
@[simp]
theorem extChartAt_upperHalfPlane_symm_apply (x : ℍ) (w : ℂ) :
    (extChartAt 𝓘(ℂ) x).symm w = UpperHalfPlane.ofComplex w := by
  rfl

/-- A deck transformation written in the preferred complex manifold charts
is literally the Möbius chart already used to compute `d1`. -/
theorem writtenInExtChartAt_manifoldDeckMap
    (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    writtenInExtChartAt 𝓘(ℂ) 𝓘(ℂ) z (manifoldDeckMap γ) =
      gammaTwoMoebiusChart γ := by
  funext w
  simp only [writtenInExtChartAt, Function.comp_apply,
    extChartAt_upperHalfPlane_apply,
    extChartAt_upperHalfPlane_symm_apply, manifoldDeckMap,
    gammaTwoMoebiusChart, gammaTwoMoebiusCoordinate]
  rfl

/-! ## 2. Exact value of the genuine manifold derivative -/

/-- The genuine complex manifold derivative is the complex-linear map given
by multiplication by the classical Möbius derivative `1 / (c z + d)^2`. -/
theorem manifoldDeckDerivative_eq_toSpanSingleton
    (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) :
    manifoldDeckDerivative γ z =
      ContinuousLinearMap.toSpanSingleton ℂ
        (1 / inverseEtaPaperOrbitDenom γ z ^ 2) := by
  have hMD :
      MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) (manifoldDeckMap γ) z :=
    (manifoldDeckMap_smooth γ).mdifferentiable (by simp) z
  have hF :
      fderiv ℂ (gammaTwoMoebiusChart γ) (z : ℂ) =
        ContinuousLinearMap.toSpanSingleton ℂ
          (1 / inverseEtaPaperOrbitDenom γ z ^ 2) :=
    (gammaTwoMoebiusChart_hasStrictDerivAt γ z).hasDerivAt.hasFDerivAt.fderiv
  rw [manifoldDeckDerivative, hMD.mfderiv,
    writtenInExtChartAt_manifoldDeckMap]
  simpa only [modelWithCornersSelf_coe, range_id,
    extChartAt_upperHalfPlane_apply, fderivWithin_univ] using hF

/-- Pointwise form of the same genuine manifold derivative. -/
theorem manifoldDeckDerivative_apply
    (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    manifoldDeckDerivative γ z ξ =
      ξ / inverseEtaPaperOrbitDenom γ z ^ 2 := by
  rw [manifoldDeckDerivative_eq_toSpanSingleton]
  simp only [ContinuousLinearMap.toSpanSingleton_apply,
    smul_eq_mul, div_eq_mul_inv, one_mul]

/-! ## 3. Unconditional bridge and the closed normal law -/

/-- The genuine complex manifold derivative and the real directional
derivative `d1` agree for every `Gamma(2)` deck transformation. -/
theorem manifoldDeckDerivative_eq_d1
    (γ : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (ξ : ℂ) :
    manifoldDeckDerivative γ z ξ =
      d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate γ) z ξ := by
  rw [manifoldDeckDerivative_apply,
    QYM.FullCertification.P2ExplicitEdgeNormalExtension.d1_gammaTwoActionCoordinate]

/-- Unconditional inhabitant of the exact compatibility residual isolated by
the explicit-normal producer. -/
theorem actualManifoldDeckDerivativeD1Compatibility :
    QYM.FullCertification.P2ExplicitEdgeNormalExtension.ManifoldDeckDerivativeD1Compatibility := by
  intro γ z ξ
  exact manifoldDeckDerivative_eq_d1 γ z ξ

/-- The concrete outward hyperbolic unit normal therefore satisfies the old
manifold-derivative paired-normal law without any remaining hypothesis. -/
