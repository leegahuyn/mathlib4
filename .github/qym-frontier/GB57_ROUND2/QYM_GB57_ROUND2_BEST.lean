      0 < QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.actualGlobalQuotientMeasure.real
        (actualCutoffEscapeOpenSet n) :=
    ENNReal.toReal_pos hMeasurePos.ne' hMeasureFinite.ne
  apply norm_ne_zero_iff.mp
  unfold actualCutoffEscapeWitness
  rw [MeasureTheory.norm_indicatorConstLp'
    (by norm_num : (2 : ℝ≥0∞) ≠ 0)
    hMeasurePos.ne']
  simp only [norm_one, one_mul]
  exact (Real.rpow_pos_of_pos hMeasureRealPos _).ne'

/-- The `n`-th global stage projection kills the escape-band indicator. -/
theorem globalStageProjection_escapeWitness_eq_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection n
      (actualCutoffEscapeWitness q n) = 0 := by
  have hWitnessCoe :
      ((actualCutoffEscapeWitness q n : ActualGlobalL2) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[
            QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.actualGlobalQuotientMeasure]
        (actualCutoffEscapeOpenSet n).indicator (fun _ => (1 : ℂ)) := by
    simpa only [actualCutoffEscapeWitness] using
      (MeasureTheory.indicatorConstLp_coeFn
        (p := (2 : ℝ≥0∞))
        (μ := QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.actualGlobalQuotientMeasure)
        (s := actualCutoffEscapeOpenSet n) (c := (1 : ℂ)))
  apply MeasureTheory.Lp.ext
  filter_upwards
    [QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjection_coeFn_ae n
      (actualCutoffEscapeWitness q n),
      hWitnessCoe,
      MeasureTheory.Lp.coeFn_zero ℂ 2
        QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.actualGlobalQuotientMeasure]
    with x hProjection hWitness hZero
  rw [hProjection, hZero,
    QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionRepresentative]
  by_cases hx : x ∈ QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.naturalStageSet n
  · rw [Set.indicator_of_mem hx, hWitness]
