namespace QYM.FullCertification.P2SmoothCuspBoundaryExtension






/-!
# Smooth closed segments on the three actual cusp horocycles

The trace and arclength layers already use the literal curve

`x ↦ sigma_kappa • (x + i * gammaTwoCuspLevel Y)`.

This file proves the missing regularity and embeddedness facts for its
restriction to `[0,2]`.  Smoothness is stated in the ambient complex
coordinate.  This is the honest real-smooth notion available for a real
curve in Mathlib's upper-half-plane model: the latter carries a complex
manifold chart, while the parameter is real.

The normal below is deliberately called the *local-scaling-chart* normal.
It is not silently identified with an ambient Euclidean normal after a
Möbius transformation.  In the inverse scaling coordinate, the truncated
side is `im z <= gammaTwoCuspLevel Y`; consequently the positive imaginary
normal is genuinely outward.  Its hyperbolic norm is calculated exactly.
-/

/-! ## 1. The actual width-two closed segment -/

/-- The compact parameter interval used by every width-two cusp component. -/
abbrev WidthTwoClosedParameter : Type := Set.Icc (0 : ℝ) 2

/-- Restriction of the already defined actual named-cusp curve to `[0,2]`. -/
def actualFixedPhaseNamedCuspSegment
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    WidthTwoClosedParameter → ℍ :=
  fun x => QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x.1

/-- The restricted actual cusp curve is continuous. -/
theorem actualFixedPhaseNamedCuspSegment_continuous
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    Continuous (actualFixedPhaseNamedCuspSegment kappa Y) := by
  change Continuous
    (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y ∘
      Subtype.val)
  exact
    (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_continuous kappa Y).comp
      continuous_subtype_val

/-- The restricted actual cusp curve has no self-intersection. -/
theorem actualFixedPhaseNamedCuspSegment_injective
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    Function.Injective (actualFixedPhaseNamedCuspSegment kappa Y) := by
  intro x y hxy
  apply Subtype.ext
  exact QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_injective kappa Y hxy

/-- A continuous injection from the compact interval into the Hausdorff
upper half-plane is a closed topological embedding. -/
theorem actualFixedPhaseNamedCuspSegment_isClosedEmbedding
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsClosedEmbedding (actualFixedPhaseNamedCuspSegment kappa Y) :=
  (actualFixedPhaseNamedCuspSegment_continuous kappa Y).isClosedEmbedding
    (actualFixedPhaseNamedCuspSegment_injective kappa Y)

/-- In particular, the image of the actual width-two segment is closed. -/
theorem actualFixedPhaseNamedCuspSegment_range_isClosed
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsClosed (Set.range (actualFixedPhaseNamedCuspSegment kappa Y)) :=
  (actualFixedPhaseNamedCuspSegment_isClosedEmbedding kappa Y).isClosed_range

/-- The segment lands on the already defined named-cusp horocycle. -/
theorem actualFixedPhaseNamedCuspSegment_mem_actualHorocycle
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ)
    (x : WidthTwoClosedParameter) :
    actualFixedPhaseNamedCuspSegment kappa Y x ∈
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspHorocycle kappa (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) := by
  simpa only [actualFixedPhaseNamedCuspSegment] using
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_mem kappa Y x.1

/-! ## 2. Real `C-infinity` ambient coordinate -/

/-- The ambient complex coordinate of the full actual named-cusp curve. -/
def actualFixedPhaseNamedCuspAmbientCoordinate
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) (x : ℝ) : ℂ :=
  ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)

/-- The actual named-cusp coordinate is real `C-infinity`.  The proof is a
direct rational-map calculation.  The Möbius denominator is nonzero because
the input lies in the upper half-plane. -/
theorem actualFixedPhaseNamedCuspAmbientCoordinate_contDiff
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    ContDiff ℝ ∞
      (actualFixedPhaseNamedCuspAmbientCoordinate kappa Y) := by
  change ContDiff ℝ ∞
    (fun x : ℝ =>
      ((QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint
        kappa Y x : ℍ) : ℂ))
  exact
    QYM.FullCertification.P2ClassicalHhalfTraceExtension.actualFixedPhaseCuspHorocyclePoint_coe_contDiff
      kappa Y

/-- The smooth ambient extension agrees exactly with the restricted segment. -/
theorem actualFixedPhaseNamedCuspAmbientCoordinate_restrict
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ)
    (x : WidthTwoClosedParameter) :
    actualFixedPhaseNamedCuspAmbientCoordinate kappa Y x.1 =
      ((actualFixedPhaseNamedCuspSegment kappa Y x : ℍ) : ℂ) :=
  rfl

/-- A certificate which combines topological closed embeddedness with an
actual real-smooth ambient coordinate extension.  The name intentionally
says `Coordinate`: it does not pretend that a real parameter has become a
complex parameter in Mathlib's complex-manifold API. -/
structure IsSmoothCoordinateClosedEmbeddedSegment
    (f : WidthTwoClosedParameter → ℍ) (F : ℝ → ℂ) : Prop where
  continuous : Continuous f
  injective : Function.Injective f
  closedEmbedding : IsClosedEmbedding f
  coordinateContDiff : ContDiff ℝ ∞ F
  coordinateRestricts : ∀ x, F x.1 = ((f x : ℍ) : ℂ)

/-- Unconditional smooth-coordinate closed-embedding certificate for every
named cusp and every truncation parameter. -/
theorem actualFixedPhaseNamedCuspSmoothEmbeddedSegment
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsSmoothCoordinateClosedEmbeddedSegment
      (actualFixedPhaseNamedCuspSegment kappa Y)
      (actualFixedPhaseNamedCuspAmbientCoordinate kappa Y) := by
  exact
    ⟨actualFixedPhaseNamedCuspSegment_continuous kappa Y,
      actualFixedPhaseNamedCuspSegment_injective kappa Y,
      actualFixedPhaseNamedCuspSegment_isClosedEmbedding kappa Y,
      actualFixedPhaseNamedCuspAmbientCoordinate_contDiff kappa Y,
      actualFixedPhaseNamedCuspAmbientCoordinate_restrict kappa Y⟩

/-- The three concrete cusp names are simultaneously certified. -/
theorem actualFixedPhaseThreeNamedCuspsSmoothEmbeddedSegments (Y : ℝ) :
    IsSmoothCoordinateClosedEmbeddedSegment
        (actualFixedPhaseNamedCuspSegment .atInfinity Y)
        (actualFixedPhaseNamedCuspAmbientCoordinate .atInfinity Y) ∧
      IsSmoothCoordinateClosedEmbeddedSegment
        (actualFixedPhaseNamedCuspSegment .zero Y)
        (actualFixedPhaseNamedCuspAmbientCoordinate .zero Y) ∧
      IsSmoothCoordinateClosedEmbeddedSegment
        (actualFixedPhaseNamedCuspSegment .one Y)
        (actualFixedPhaseNamedCuspAmbientCoordinate .one Y) := by
  exact
    ⟨actualFixedPhaseNamedCuspSmoothEmbeddedSegment .atInfinity Y,
      actualFixedPhaseNamedCuspSmoothEmbeddedSegment .zero Y,
      actualFixedPhaseNamedCuspSmoothEmbeddedSegment .one Y⟩

/-! ## 3. Exact local scaling coordinate and its tangent -/

/-- Pull the actual named-cusp curve back by its chosen scaling matrix. -/
def actualFixedPhaseNamedCuspLocalScalingCoordinate
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) (x : ℝ) : ℂ :=
  (((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspScaling kappa)⁻¹ •
      QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y x : ℍ) : ℂ)

/-- In the inverse scaling chart the actual curve is literally horizontal. -/
@[simp]
theorem actualFixedPhaseNamedCuspLocalScalingCoordinate_eq
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x =
      (x : ℂ) + (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) * Complex.I := by
  simp [actualFixedPhaseNamedCuspLocalScalingCoordinate,
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint,
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseHorizontalHorocyclePoint,
    QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHeight]

/-- The local scaling coordinate has the exact real derivative `ofRealCLM`. -/
theorem actualFixedPhaseNamedCuspLocalScalingCoordinate_hasFDerivAt
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    HasFDerivAt
      (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y)
      Complex.ofRealCLM x := by
  have hfun :
      actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y =
        fun t : ℝ =>
          (t : ℂ) + (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) * Complex.I := by
    funext t
    exact actualFixedPhaseNamedCuspLocalScalingCoordinate_eq kappa Y t
  rw [hfun]
  exact Complex.ofRealCLM.hasFDerivAt.add_const
    ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) * Complex.I)

/-- Exact Fréchet derivative of the local coordinate. -/
theorem actualFixedPhaseNamedCuspLocalScalingCoordinate_fderiv
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    fderiv ℝ
      (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y) x =
      Complex.ofRealCLM :=
  (actualFixedPhaseNamedCuspLocalScalingCoordinate_hasFDerivAt
    kappa Y x).fderiv

/-- The positively oriented horizontal tangent in the local chart. -/
def actualFixedPhaseNamedCuspLocalHorizontalTangent : ℂ :=
  1

/-- Applying the actual local Fréchet derivative to the unit parameter
velocity gives the exact horizontal tangent `1`. -/
theorem actualFixedPhaseNamedCuspLocalTangent_eq_one
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    fderiv ℝ
        (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y) x 1 =
      actualFixedPhaseNamedCuspLocalHorizontalTangent := by
  rw [actualFixedPhaseNamedCuspLocalScalingCoordinate_fderiv]
  simp [actualFixedPhaseNamedCuspLocalHorizontalTangent]

/-- The derivative of the local parametrization is injective, hence the
curve is regular in the scaling chart. -/
theorem actualFixedPhaseNamedCuspLocalScalingCoordinate_fderiv_injective
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    Function.Injective
      (fderiv ℝ
        (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y) x) := by
  rw [actualFixedPhaseNamedCuspLocalScalingCoordinate_fderiv]
  intro a b hab
  have hre := congrArg Complex.re hab
  simpa using hre

/-! ## 4. The genuine outward normal in the local truncation chart -/

/-- The local truncated side bounded by the horocycle. -/
def actualFixedPhaseNamedCuspLocalTruncatedSide (Y : ℝ) : Set ℂ :=
  {z | z.im ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y}

/-- The actual curve lies on the boundary-level equation in the local chart. -/
theorem actualFixedPhaseNamedCuspLocalScalingCoordinate_im
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x).im =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y := by
  rw [actualFixedPhaseNamedCuspLocalScalingCoordinate_eq]
  simp

/-- The upward local-chart vector with exact hyperbolic unit length. -/
def actualFixedPhaseNamedCuspLocalOutwardNormal (Y : ℝ) : ℂ :=
  Complex.I * (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ)

/-- The local outward vector is exactly `I * level(Y)`. -/
theorem actualFixedPhaseNamedCuspLocalOutwardNormal_eq
    (Y : ℝ) :
    actualFixedPhaseNamedCuspLocalOutwardNormal Y =
      Complex.I * (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) :=
  rfl

/-- The chosen normal has strictly positive imaginary component. -/
theorem actualFixedPhaseNamedCuspLocalOutwardNormal_im_pos
    (Y : ℝ) :
    0 < (actualFixedPhaseNamedCuspLocalOutwardNormal Y).im := by
  have hlevel : 0 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y :=
    lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)
  simpa [actualFixedPhaseNamedCuspLocalOutwardNormal] using hlevel

/-- Moving one normal vector from a boundary point strictly increases the
local height. -/
theorem actualFixedPhaseNamedCuspLocalCoordinate_add_normal_im_gt
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y <
      (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x +
        actualFixedPhaseNamedCuspLocalOutwardNormal Y).im := by
  have hlevel : 0 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y :=
    lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)
  rw [actualFixedPhaseNamedCuspLocalScalingCoordinate_eq]
  simp only [actualFixedPhaseNamedCuspLocalOutwardNormal,
    Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.I_re,
    Complex.I_im, Complex.ofReal_re, zero_mul, one_mul, add_zero]
  linarith

/-- Thus the positive imaginary normal really leaves the locally truncated
side; `outward` is a proved orientation statement, not merely a name. -/
theorem actualFixedPhaseNamedCuspLocalCoordinate_add_normal_not_mem
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x +
        actualFixedPhaseNamedCuspLocalOutwardNormal Y ∉
      actualFixedPhaseNamedCuspLocalTruncatedSide Y := by
  change ¬
    (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x +
      actualFixedPhaseNamedCuspLocalOutwardNormal Y).im ≤
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y
  exact not_le_of_gt
    (actualFixedPhaseNamedCuspLocalCoordinate_add_normal_im_gt
      kappa Y x)

/-! ## 5. Hyperbolic orthogonality and exact unit norm -/

/-- Hyperbolic tangent inner product at the horizontal level used by the
actual cusp truncation. -/
def actualFixedPhaseNamedCuspLocalHyperbolicInner
    (Y : ℝ) (v w : ℂ) : ℝ :=
  (star v * w).re / (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) ^ 2

/-- Hyperbolic vector norm at that same level. -/
def actualFixedPhaseNamedCuspLocalHyperbolicNorm
    (Y : ℝ) (v : ℂ) : ℝ :=
  ‖v‖ / Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y

/-- The horizontal tangent and the upward normal are hyperbolically
orthogonal. -/
theorem actualFixedPhaseNamedCuspLocal_tangent_orthogonal_normal
    (Y : ℝ) :
    actualFixedPhaseNamedCuspLocalHyperbolicInner Y
        actualFixedPhaseNamedCuspLocalHorizontalTangent
        (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 0 := by
  simp [actualFixedPhaseNamedCuspLocalHyperbolicInner,
    actualFixedPhaseNamedCuspLocalHorizontalTangent,
    actualFixedPhaseNamedCuspLocalOutwardNormal]

/-- The local outward vector has exact hyperbolic norm one. -/
theorem actualFixedPhaseNamedCuspLocalOutwardNormal_hyperbolicNorm
    (Y : ℝ) :
    actualFixedPhaseNamedCuspLocalHyperbolicNorm Y
        (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 1 := by
  have hlevel : 0 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y :=
    lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)
  change
    ‖Complex.I * (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ)‖ /
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y = 1
  rw [norm_mul, Complex.norm_I, one_mul, Complex.norm_real,
    Real.norm_of_nonneg hlevel.le, div_self hlevel.ne']

/-- One theorem-valued package for all requested local-chart identities. -/
theorem actualFixedPhaseNamedCuspLocalGeometryCertificate
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y x : ℝ) :
    fderiv ℝ
        (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y) x 1 =
        1 ∧
      actualFixedPhaseNamedCuspLocalOutwardNormal Y =
        Complex.I * (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y : ℂ) ∧
      0 < (actualFixedPhaseNamedCuspLocalOutwardNormal Y).im ∧
      actualFixedPhaseNamedCuspLocalHyperbolicInner Y
        actualFixedPhaseNamedCuspLocalHorizontalTangent
        (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 0 ∧
      actualFixedPhaseNamedCuspLocalHyperbolicNorm Y
        (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 1 ∧
      actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x +
          actualFixedPhaseNamedCuspLocalOutwardNormal Y ∉
        actualFixedPhaseNamedCuspLocalTruncatedSide Y := by
  exact
    ⟨by simpa [actualFixedPhaseNamedCuspLocalHorizontalTangent] using
        actualFixedPhaseNamedCuspLocalTangent_eq_one kappa Y x,
      actualFixedPhaseNamedCuspLocalOutwardNormal_eq Y,
      actualFixedPhaseNamedCuspLocalOutwardNormal_im_pos Y,
      actualFixedPhaseNamedCuspLocal_tangent_orthogonal_normal Y,
      actualFixedPhaseNamedCuspLocalOutwardNormal_hyperbolicNorm Y,
      actualFixedPhaseNamedCuspLocalCoordinate_add_normal_not_mem
        kappa Y x⟩

/-- Final all-cusp endpoint: every named width-two segment is closed embedded
and coordinate-smooth, and every point has the exact regular tangent and
unit outward local-chart normal described above. -/
theorem actualFixedPhaseAllNamedCuspSmoothBoundaryCertificate (Y : ℝ) :
    (∀ kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp,
      IsSmoothCoordinateClosedEmbeddedSegment
        (actualFixedPhaseNamedCuspSegment kappa Y)
        (actualFixedPhaseNamedCuspAmbientCoordinate kappa Y)) ∧
      (∀ (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (x : ℝ),
        fderiv ℝ
            (actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y) x 1 =
            1 ∧
          0 < (actualFixedPhaseNamedCuspLocalOutwardNormal Y).im ∧
          actualFixedPhaseNamedCuspLocalHyperbolicInner Y
            actualFixedPhaseNamedCuspLocalHorizontalTangent
            (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 0 ∧
          actualFixedPhaseNamedCuspLocalHyperbolicNorm Y
            (actualFixedPhaseNamedCuspLocalOutwardNormal Y) = 1 ∧
          actualFixedPhaseNamedCuspLocalScalingCoordinate kappa Y x +
              actualFixedPhaseNamedCuspLocalOutwardNormal Y ∉
            actualFixedPhaseNamedCuspLocalTruncatedSide Y) := by
  constructor
  · exact fun kappa =>
      actualFixedPhaseNamedCuspSmoothEmbeddedSegment kappa Y
  · intro kappa x
    exact
      ⟨by simpa [actualFixedPhaseNamedCuspLocalHorizontalTangent] using
          actualFixedPhaseNamedCuspLocalTangent_eq_one kappa Y x,
        actualFixedPhaseNamedCuspLocalOutwardNormal_im_pos Y,
        actualFixedPhaseNamedCuspLocal_tangent_orthogonal_normal Y,
        actualFixedPhaseNamedCuspLocalOutwardNormal_hyperbolicNorm Y,
        actualFixedPhaseNamedCuspLocalCoordinate_add_normal_not_mem
          kappa Y x⟩

end QYM.FullCertification.P2SmoothCuspBoundaryExtension

