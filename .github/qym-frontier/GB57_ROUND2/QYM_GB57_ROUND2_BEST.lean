#print axioms all_orientedEdgeFluxIntegrals_eq_zero
#print axioms fixedPhase_allOrientedEdgeGreenFluxIntegrals_eq_zero
#print axioms etaTwistedOneForm_hasActualPairedNormalDerivative
#print axioms selectedHorocycleCoordinate_hasDerivAt
#print axioms truncatedOrientedEdgeFluxIntegral_eq_full_of_tail
#print axioms selectedHorocycleLiteralCornerParameters_finite
#print axioms selectedFrontierHorocycleFluxIntegralAwayFromCorners_eq
#print axioms selectedFrontierHorocycleFluxIntegral_eq_zero_of_tail
#print axioms selectedFrontierHorocycleFluxSum_eq_zero_of_trace
#print axioms fixedPhase_selectedFrontierHorocycleFluxSum_eq_zero_of_leftDirichlet
#print axioms fixedPhase_selectedFrontierHorocycleFluxSum_eq_zero_of_rightDirichlet
#print axioms actualTruncatedTileBoundaryFluxSum_eq_zero
#print axioms exists_zero_actualTruncatedTileBoundaryFluxSum
#print axioms gammaTwoPairedPolygonFluxStokes_iff_actualHighCutoffBoundaryEqualityResidual
