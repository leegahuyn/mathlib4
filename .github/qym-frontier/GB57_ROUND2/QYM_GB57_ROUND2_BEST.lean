#print axioms QYM.FullCertification.P4ActualStageL2InfiniteDimensionalExtension.actualStageL2InfiniteDimensionalCertificate

end P4ActualStageL2InfiniteDimensionalAxiomAudit

open Function Set Topology MeasureTheory
open scoped ComplexConjugate InnerProductSpace ENNReal MatrixGroups

namespace QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension






/-!
# P12: the actual inverse-eta rank-one test baseline

This file constructs the most elementary bounded test available on the
genuine finite-stage inverse-eta `L²` Hilbert carrier: pairing with the
distinguished inverse-eta section `psi_Y`, followed by the rank-one operator
`|psi_Y><psi_Y|`.

This operator is **not** identified with the paper's mock/Poincare,
Rankin--Selberg, or mass operator.  Quite the opposite: the exact kernel and
no-go theorems below form a firewall.  A single inverse-eta rank-one test
vanishes on the entire orthogonal complement of its test line, so it cannot
establish the Paper-I off-ground coercivity estimate whenever that complement
contains a nonzero vector.

No abstract carrier, supplied boundedness certificate, or spectral premise is
used.  The only geometric input is the already constructed actual stage
Hilbert space and its distinguished constant-one eta-coordinate section.
-/

/-! ## 1. Concrete test vector and bounded analysis functional -/

/-- Short name for the actual finite-stage inverse-eta `L²` carrier. -/
abbrev ActualInverseEtaTestSpace (Y : ℝ) :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y

/-- The actual inverse-eta test vector on the finite stage. -/
noncomputable def actualInverseEtaTestVector (Y : ℝ) :
    ActualInverseEtaTestSpace Y :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection Y

/-- Above normalized cusp height one, the actual inverse-eta test vector is
genuinely nonzero. -/
theorem actualInverseEtaTestVector_ne_zero
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaTestVector Y ≠ 0 := by
  simpa only [actualInverseEtaTestVector] using
    QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageDistinguishedInverseEtaSection_ne_zero hY

/-- The explicit bounded analysis functional `u |-> <psi_Y,u>`. -/
noncomputable def actualInverseEtaAnalysisFunctional (Y : ℝ) :
    ActualInverseEtaTestSpace Y →L[ℂ] ℂ :=
  innerSL ℂ (actualInverseEtaTestVector Y)

@[simp]
theorem actualInverseEtaAnalysisFunctional_apply
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    actualInverseEtaAnalysisFunctional Y u =
      inner ℂ (actualInverseEtaTestVector Y) u := by
  exact innerSL_apply_apply ℂ _ _

/-- The operator norm of the analysis functional is exactly the norm of its
actual inverse-eta test vector. -/
theorem actualInverseEtaAnalysisFunctional_norm (Y : ℝ) :
    ‖actualInverseEtaAnalysisFunctional Y‖ =
      ‖actualInverseEtaTestVector Y‖ := by
  exact innerSL_apply_norm ℂ (actualInverseEtaTestVector Y)

/-- The bounded analysis functional is nonzero on every certified
positive-mass stage. -/
theorem actualInverseEtaAnalysisFunctional_ne_zero
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaAnalysisFunctional Y ≠ 0 := by
  intro hZero
  have hNorm := congrArg norm hZero
  rw [actualInverseEtaAnalysisFunctional_norm, norm_zero] at hNorm
  exact actualInverseEtaTestVector_ne_zero hY
    (norm_eq_zero.mp hNorm)

/-- Pointwise boundedness of the analysis functional, with its sharp
Cauchy--Schwarz constant displayed. -/
theorem actualInverseEtaAnalysisFunctional_apply_norm_le
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    ‖actualInverseEtaAnalysisFunctional Y u‖ ≤
      ‖actualInverseEtaTestVector Y‖ * ‖u‖ := by
  rw [actualInverseEtaAnalysisFunctional_apply]
  exact norm_inner_le_norm _ _

/-! ## 2. The positive symmetric rank-one baseline -/

/-- The actual inverse-eta rank-one test operator `|psi_Y><psi_Y|`.

The name deliberately says `TestOperator`: no identification with the
paper-specific Rankin--Selberg or mock/Poincare operator is made. -/
noncomputable def actualInverseEtaTestOperator (Y : ℝ) :
    ActualInverseEtaTestSpace Y →L[ℂ] ActualInverseEtaTestSpace Y :=
  InnerProductSpace.rankOne ℂ
    (actualInverseEtaTestVector Y) (actualInverseEtaTestVector Y)

@[simp]
theorem actualInverseEtaTestOperator_apply
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    actualInverseEtaTestOperator Y u =
      actualInverseEtaAnalysisFunctional Y u •
        actualInverseEtaTestVector Y := by
  rw [actualInverseEtaTestOperator,
    InnerProductSpace.rankOne_apply,
    actualInverseEtaAnalysisFunctional_apply]

/-- Exact operator norm of the unnormalized rank-one test. -/
theorem actualInverseEtaTestOperator_norm (Y : ℝ) :
    ‖actualInverseEtaTestOperator Y‖ =
      ‖actualInverseEtaTestVector Y‖ ^ 2 := by
  rw [actualInverseEtaTestOperator, InnerProductSpace.norm_rankOne, pow_two]

/-- The actual rank-one operator itself is nonzero above height one. -/
theorem actualInverseEtaTestOperator_ne_zero
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualInverseEtaTestOperator Y ≠ 0 := by
  unfold actualInverseEtaTestOperator
  exact InnerProductSpace.rankOne_ne_zero
    (actualInverseEtaTestVector_ne_zero hY)
    (actualInverseEtaTestVector_ne_zero hY)

/-- The actual rank-one test operator is symmetric. -/
theorem actualInverseEtaTestOperator_isSymmetric (Y : ℝ) :
    (actualInverseEtaTestOperator Y).IsSymmetric := by
  exact InnerProductSpace.isSymmetric_rankOne_self
    (actualInverseEtaTestVector Y)

/-- The actual rank-one test operator is positive. -/
theorem actualInverseEtaTestOperator_isPositive (Y : ℝ) :
    (actualInverseEtaTestOperator Y).IsPositive := by
  exact InnerProductSpace.isPositive_rankOne_self
    (actualInverseEtaTestVector Y)

/-- The real quadratic energy of the actual inverse-eta rank-one test. -/
noncomputable def actualInverseEtaTestEnergy
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) : ℝ :=
  (inner ℂ (actualInverseEtaTestOperator Y u) u).re

/-- Before taking real parts, the quadratic pairing is the squared modulus of
the explicit analysis coefficient. -/
theorem actualInverseEtaTestOperator_inner_self
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    inner ℂ (actualInverseEtaTestOperator Y u) u =
      ((‖actualInverseEtaAnalysisFunctional Y u‖ ^ 2 : ℝ) : ℂ) := by
  rw [actualInverseEtaTestOperator_apply, inner_smul_left]
  rw [actualInverseEtaAnalysisFunctional_apply]
  simpa only [Complex.ofReal_pow] using
    (Complex.conj_mul'
      (inner ℂ (actualInverseEtaTestVector Y) u))

/-- Exact nonnegative quadratic-energy formula. -/
@[simp]
theorem actualInverseEtaTestEnergy_eq_norm_sq
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    actualInverseEtaTestEnergy Y u =
      ‖actualInverseEtaAnalysisFunctional Y u‖ ^ 2 := by
  unfold actualInverseEtaTestEnergy
  rw [actualInverseEtaTestOperator_inner_self]
  exact Complex.ofReal_re _

theorem actualInverseEtaTestEnergy_nonneg
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    0 ≤ actualInverseEtaTestEnergy Y u := by
  rw [actualInverseEtaTestEnergy_eq_norm_sq]
  positivity

/-! ## 3. Exact test line, orthogonal complement, kernel, and range -/

/-- The entire complex line generated by the actual inverse-eta test vector.
-/
abbrev ActualInverseEtaTestLine (Y : ℝ) :
    Submodule ℂ (ActualInverseEtaTestSpace Y) :=
  ℂ ∙ actualInverseEtaTestVector Y

/-- The entire orthogonal complement of the actual inverse-eta test line. -/
abbrev ActualInverseEtaOffTestSubspace (Y : ℝ) :
    Submodule ℂ (ActualInverseEtaTestSpace Y) :=
  (ActualInverseEtaTestLine Y)ᗮ

/-- Membership in the test line is exactly scalar collinearity with the
actual inverse-eta section. -/
theorem mem_actualInverseEtaTestLine_iff
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y} :
    u ∈ ActualInverseEtaTestLine Y ↔
      ∃ c : ℂ, c • actualInverseEtaTestVector Y = u := by
  exact Submodule.mem_span_singleton

/-- Membership in the full off-test subspace is exactly annihilation by the
bounded analysis functional. -/
theorem mem_actualInverseEtaOffTestSubspace_iff
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y} :
    u ∈ ActualInverseEtaOffTestSubspace Y ↔
      actualInverseEtaAnalysisFunctional Y u = 0 := by
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right,
    actualInverseEtaAnalysisFunctional_apply]

/-- The kernel of the bounded analysis functional is exactly the full
off-test subspace. -/
theorem actualInverseEtaAnalysisFunctional_ker (Y : ℝ) :
    (actualInverseEtaAnalysisFunctional Y).toLinearMap.ker =
      ActualInverseEtaOffTestSubspace Y := by
  ext u
  rw [LinearMap.mem_ker]
  exact mem_actualInverseEtaOffTestSubspace_iff.symm

/-- The entire off-test subspace is closed in the actual stage Hilbert
space. -/
theorem actualInverseEtaOffTestSubspace_isClosed (Y : ℝ) :
    IsClosed (ActualInverseEtaOffTestSubspace Y :
      Set (ActualInverseEtaTestSpace Y)) := by
  exact Submodule.isClosed_orthogonal (ActualInverseEtaTestLine Y)

/-- The unnormalized rank-one test vanishes exactly on the full orthogonal
complement, including the degenerate zero-vector case. -/
theorem actualInverseEtaTestOperator_eq_zero_iff
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y} :
    actualInverseEtaTestOperator Y u = 0 ↔
      u ∈ ActualInverseEtaOffTestSubspace Y := by
  rw [mem_actualInverseEtaOffTestSubspace_iff,
    actualInverseEtaTestOperator_apply]
  by_cases hpsi : actualInverseEtaTestVector Y = 0
  · simp [hpsi, actualInverseEtaAnalysisFunctional_apply]
  · exact smul_eq_zero_iff_left hpsi

/-- Consequently the linear-map kernel is literally the full orthogonal
complement, not a merely included subspace. -/
theorem actualInverseEtaTestOperator_ker (Y : ℝ) :
    (actualInverseEtaTestOperator Y).toLinearMap.ker =
      ActualInverseEtaOffTestSubspace Y := by
  ext u
  rw [LinearMap.mem_ker]
  exact actualInverseEtaTestOperator_eq_zero_iff

/-- Every output of the rank-one test lies in the exact inverse-eta test
line. -/
theorem actualInverseEtaTestOperator_apply_mem_line
    (Y : ℝ) (u : ActualInverseEtaTestSpace Y) :
    actualInverseEtaTestOperator Y u ∈
      ActualInverseEtaTestLine Y := by
  rw [actualInverseEtaTestOperator_apply]
  exact Submodule.smul_mem _ _
    (Submodule.mem_span_singleton_self
      (actualInverseEtaTestVector Y))

/-- Above height one the range of the unnormalized rank-one test is exactly
the entire inverse-eta test line. -/
theorem actualInverseEtaTestOperator_range
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaTestOperator Y).toLinearMap.range =
      ActualInverseEtaTestLine Y := by
  apply le_antisymm
  · rintro u ⟨v, rfl⟩
    exact actualInverseEtaTestOperator_apply_mem_line Y v
  · intro u hu
    obtain ⟨c, rfl⟩ :=
      (mem_actualInverseEtaTestLine_iff.mp hu)
    have hpsi : actualInverseEtaTestVector Y ≠ 0 :=
      actualInverseEtaTestVector_ne_zero hY
    have hinner : inner ℂ (actualInverseEtaTestVector Y)
        (actualInverseEtaTestVector Y) ≠ 0 :=
      inner_self_ne_zero.mpr hpsi
    refine ⟨(c / inner ℂ (actualInverseEtaTestVector Y)
      (actualInverseEtaTestVector Y)) • actualInverseEtaTestVector Y, ?_⟩
    change actualInverseEtaTestOperator Y
      ((c / inner ℂ (actualInverseEtaTestVector Y)
        (actualInverseEtaTestVector Y)) • actualInverseEtaTestVector Y) =
        c • actualInverseEtaTestVector Y
    rw [actualInverseEtaTestOperator_apply,
      actualInverseEtaAnalysisFunctional_apply, inner_smul_right,
      div_mul_cancel₀ c hinner]

/-- Zero quadratic energy is equivalent to membership in the full off-test
subspace. -/
theorem actualInverseEtaTestEnergy_eq_zero_iff
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y} :
    actualInverseEtaTestEnergy Y u = 0 ↔
      u ∈ ActualInverseEtaOffTestSubspace Y := by
  rw [actualInverseEtaTestEnergy_eq_norm_sq, sq_eq_zero_iff,
    norm_eq_zero]
  exact mem_actualInverseEtaOffTestSubspace_iff.symm

@[simp]
theorem actualInverseEtaTestOperator_zero_of_mem_offTest
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y}
    (hu : u ∈ ActualInverseEtaOffTestSubspace Y) :
    actualInverseEtaTestOperator Y u = 0 :=
  actualInverseEtaTestOperator_eq_zero_iff.mpr hu

@[simp]
theorem actualInverseEtaTestEnergy_zero_of_mem_offTest
    {Y : ℝ} {u : ActualInverseEtaTestSpace Y}
    (hu : u ∈ ActualInverseEtaOffTestSubspace Y) :
    actualInverseEtaTestEnergy Y u = 0 :=
  actualInverseEtaTestEnergy_eq_zero_iff.mpr hu

/-! ## 4. Actual normalization and the orthogonal projection -/

/-- The actual inverse-eta test vector normalized by its genuine `L²` norm.
It is defined only after supplying the proved paper-range height inequality.
-/
noncomputable def actualNormalizedInverseEtaTestVector
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualInverseEtaTestSpace Y :=
  (((‖actualInverseEtaTestVector Y‖⁻¹ : ℝ) : ℂ) •
    actualInverseEtaTestVector Y)

/-- The normalized actual inverse-eta test vector has norm one. -/
@[simp]
theorem actualNormalizedInverseEtaTestVector_norm
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ‖actualNormalizedInverseEtaTestVector hY‖ = 1 := by
  have hpsi : actualInverseEtaTestVector Y ≠ 0 :=
    actualInverseEtaTestVector_ne_zero hY
  have hnorm : ‖actualInverseEtaTestVector Y‖ ≠ 0 :=
    norm_ne_zero_iff.mpr hpsi
  simp only [actualNormalizedInverseEtaTestVector, norm_smul,
    Complex.norm_real,
    Real.norm_of_nonneg (inv_nonneg.mpr
      (norm_nonneg (actualInverseEtaTestVector Y))),
    inv_mul_cancel₀ hnorm]

theorem actualNormalizedInverseEtaTestVector_ne_zero
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    actualNormalizedInverseEtaTestVector hY ≠ 0 := by
  apply norm_ne_zero_iff.mp
  rw [actualNormalizedInverseEtaTestVector_norm hY]
  exact one_ne_zero

/-- Normalization does not change the complex test line. -/
theorem normalizedInverseEtaTestLine_eq
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ℂ ∙ actualNormalizedInverseEtaTestVector hY =
      ActualInverseEtaTestLine Y := by
  let r : ℂ := ((‖actualInverseEtaTestVector Y‖⁻¹ : ℝ) : ℂ)
  have hpsi : actualInverseEtaTestVector Y ≠ 0 :=
    actualInverseEtaTestVector_ne_zero hY
  have hr : r ≠ 0 := by
    exact Complex.ofReal_ne_zero.mpr
      (inv_ne_zero (norm_ne_zero_iff.mpr hpsi))
  change ℂ ∙ r • actualInverseEtaTestVector Y =
    ℂ ∙ actualInverseEtaTestVector Y
  exact Submodule.span_singleton_smul_eq
    (isUnit_iff_ne_zero.mpr hr) (actualInverseEtaTestVector Y)

/-- Orthogonal projection onto the actual inverse-eta test line, constructed
as the rank-one operator of the normalized genuine test vector. -/
noncomputable def actualNormalizedInverseEtaProjection
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualInverseEtaTestSpace Y →L[ℂ] ActualInverseEtaTestSpace Y :=
  InnerProductSpace.rankOne ℂ
    (actualNormalizedInverseEtaTestVector hY)
    (actualNormalizedInverseEtaTestVector hY)

@[simp]
theorem actualNormalizedInverseEtaProjection_apply
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : ActualInverseEtaTestSpace Y) :
    actualNormalizedInverseEtaProjection hY u =
      inner ℂ (actualNormalizedInverseEtaTestVector hY) u •
        actualNormalizedInverseEtaTestVector hY := by
  exact InnerProductSpace.rankOne_apply _ _ _

@[simp]
theorem actualNormalizedInverseEtaProjection_norm
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ‖actualNormalizedInverseEtaProjection hY‖ = 1 := by
  rw [actualNormalizedInverseEtaProjection,
    InnerProductSpace.norm_rankOne,
    actualNormalizedInverseEtaTestVector_norm hY, one_mul]

theorem actualNormalizedInverseEtaProjection_isIdempotent
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    IsIdempotentElem (actualNormalizedInverseEtaProjection hY) := by
  exact InnerProductSpace.isIdempotentElem_rankOne_self
    (actualNormalizedInverseEtaTestVector_norm hY)

/-- Pointwise form of normalized idempotence. -/
theorem actualNormalizedInverseEtaProjection_apply_apply
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (u : ActualInverseEtaTestSpace Y) :
    actualNormalizedInverseEtaProjection hY
        (actualNormalizedInverseEtaProjection hY u) =
      actualNormalizedInverseEtaProjection hY u := by
  calc
    actualNormalizedInverseEtaProjection hY
          (actualNormalizedInverseEtaProjection hY u) =
        inner ℂ (actualNormalizedInverseEtaTestVector hY)
            (actualNormalizedInverseEtaProjection hY u) •
          actualNormalizedInverseEtaTestVector hY :=
      actualNormalizedInverseEtaProjection_apply hY _
    _ = inner ℂ (actualNormalizedInverseEtaTestVector hY)
          (inner ℂ (actualNormalizedInverseEtaTestVector hY) u •
            actualNormalizedInverseEtaTestVector hY) •
          actualNormalizedInverseEtaTestVector hY := by
      rw [actualNormalizedInverseEtaProjection_apply]
    _ = inner ℂ (actualNormalizedInverseEtaTestVector hY) u •
          actualNormalizedInverseEtaTestVector hY := by
      rw [inner_smul_right, inner_self_eq_norm_sq_to_K,
        actualNormalizedInverseEtaTestVector_norm hY]
      simp only [one_pow, RCLike.ofReal_one, mul_one]
    _ = actualNormalizedInverseEtaProjection hY u :=
      (actualNormalizedInverseEtaProjection_apply hY u).symm

theorem actualNormalizedInverseEtaProjection_isSymmetricProjection
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).IsSymmetricProjection := by
  exact InnerProductSpace.isSymmetricProjection_rankOne_self
    (actualNormalizedInverseEtaTestVector_norm hY)

theorem actualNormalizedInverseEtaProjection_isPositive
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).IsPositive := by
  exact InnerProductSpace.isPositive_rankOne_self
    (actualNormalizedInverseEtaTestVector hY)

/-- The normalized projection fixes every vector in its normalized line. -/
theorem actualNormalizedInverseEtaProjection_apply_eq_self_of_mem
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : ActualInverseEtaTestSpace Y}
    (hu : u ∈ ℂ ∙ actualNormalizedInverseEtaTestVector hY) :
    actualNormalizedInverseEtaProjection hY u = u := by
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hu
  rw [actualNormalizedInverseEtaProjection_apply, inner_smul_right,
    inner_self_eq_norm_sq_to_K,
    actualNormalizedInverseEtaTestVector_norm hY]
  simp only [one_pow, RCLike.ofReal_one, mul_one]

/-- The normalized projection has exactly the normalized test line as its
range. -/
theorem actualNormalizedInverseEtaProjection_range_normalized
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).toLinearMap.range =
      ℂ ∙ actualNormalizedInverseEtaTestVector hY := by
  apply le_antisymm
  · rintro u ⟨v, rfl⟩
    change actualNormalizedInverseEtaProjection hY v ∈
      ℂ ∙ actualNormalizedInverseEtaTestVector hY
    rw [actualNormalizedInverseEtaProjection_apply]
    exact Submodule.smul_mem _ _
      (Submodule.mem_span_singleton_self
        (actualNormalizedInverseEtaTestVector hY))
  · intro u hu
    exact ⟨u,
      actualNormalizedInverseEtaProjection_apply_eq_self_of_mem hY hu⟩

/-- Therefore the normalized projection range is the original actual
inverse-eta test line. -/
theorem actualNormalizedInverseEtaProjection_range
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).toLinearMap.range =
      ActualInverseEtaTestLine Y := by
  rw [actualNormalizedInverseEtaProjection_range_normalized,
    normalizedInverseEtaTestLine_eq hY]

/-- The normalized projection kernel is the orthogonal complement of its
normalized line. -/
theorem actualNormalizedInverseEtaProjection_ker_normalized
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).toLinearMap.ker =
      (ℂ ∙ actualNormalizedInverseEtaTestVector hY)ᗮ := by
  ext u
  change actualNormalizedInverseEtaProjection hY u = 0 ↔
    u ∈ (ℂ ∙ actualNormalizedInverseEtaTestVector hY)ᗮ
  rw [actualNormalizedInverseEtaProjection_apply,
    smul_eq_zero_iff_left
      (actualNormalizedInverseEtaTestVector_ne_zero hY),
    Submodule.mem_orthogonal_singleton_iff_inner_right]

/-- The normalized projection kernel is exactly the same full off-test
subspace as for the unnormalized operator. -/
theorem actualNormalizedInverseEtaProjection_ker
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualNormalizedInverseEtaProjection hY).toLinearMap.ker =
      ActualInverseEtaOffTestSubspace Y := by
  rw [actualNormalizedInverseEtaProjection_ker_normalized,
    normalizedInverseEtaTestLine_eq hY]

/-- The test line and its full orthogonal complement form an exact algebraic
complementary pair. -/
theorem actualInverseEtaTestLine_isCompl_offTest
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    IsCompl (ActualInverseEtaTestLine Y)
      (ActualInverseEtaOffTestSubspace Y) := by
  have hCompl :=
    LinearMap.IsIdempotentElem.isCompl
      (ContinuousLinearMap.IsIdempotentElem.toLinearMap
        (actualNormalizedInverseEtaProjection_isIdempotent hY))
  rw [actualNormalizedInverseEtaProjection_range hY,
    actualNormalizedInverseEtaProjection_ker hY] at hCompl
  exact hCompl

theorem actualInverseEtaTestLine_inf_offTest_eq_bot
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualInverseEtaTestLine Y ⊓
        ActualInverseEtaOffTestSubspace Y = ⊥ := by
  exact (actualInverseEtaTestLine_isCompl_offTest hY).disjoint.eq_bot

theorem actualInverseEtaTestLine_sup_offTest_eq_top
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ActualInverseEtaTestLine Y ⊔
        ActualInverseEtaOffTestSubspace Y = ⊤ := by
  exact (actualInverseEtaTestLine_isCompl_offTest hY).codisjoint.eq_top

/-! ## 5. Exact no-go for Paper-I coercivity from one rank-one test -/

/-- At any nonzero off-test witness, every proposed positive coercivity
constant fails for this rank-one baseline. -/
theorem no_positive_coercivity_at_offTest_witness
    {Y : ℝ} {w : ActualInverseEtaTestSpace Y}
    (hw : w ∈ ActualInverseEtaOffTestSubspace Y) (hw0 : w ≠ 0)
    {c : ℝ} (hc : 0 < c) :
    ¬ c * ‖w‖ ^ 2 ≤ actualInverseEtaTestEnergy Y w := by
  rw [actualInverseEtaTestEnergy_zero_of_mem_offTest hw]
  exact not_le_of_gt
    (mul_pos hc (pow_pos (norm_pos_iff.mpr hw0) 2))

/-- A supplied nonzero vector in the entire off-test subspace refutes a
uniform coercivity estimate for every positive constant. -/
theorem no_positive_coercivity_on_offTest_of_witness
    {Y : ℝ} (w : ActualInverseEtaTestSpace Y)
    (hw : w ∈ ActualInverseEtaOffTestSubspace Y) (hw0 : w ≠ 0)
    {c : ℝ} (hc : 0 < c) :
    ¬ (∀ u : ActualInverseEtaTestSpace Y,
      u ∈ ActualInverseEtaOffTestSubspace Y →
        c * ‖u‖ ^ 2 ≤ actualInverseEtaTestEnergy Y u) := by
  intro hCoercive
  exact no_positive_coercivity_at_offTest_witness hw hw0 hc
    (hCoercive w hw)

/-- Existential form of the firewall: a nonzero off-test witness rules out
the existence of *any* positive coercivity constant for this baseline. -/
theorem no_exists_positive_coercivity_on_offTest_of_witness
    {Y : ℝ} (w : ActualInverseEtaTestSpace Y)
    (hw : w ∈ ActualInverseEtaOffTestSubspace Y) (hw0 : w ≠ 0) :
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ u : ActualInverseEtaTestSpace Y,
        u ∈ ActualInverseEtaOffTestSubspace Y →
          c * ‖u‖ ^ 2 ≤ actualInverseEtaTestEnergy Y u := by
  rintro ⟨c, hc, hCoercive⟩
  exact no_positive_coercivity_on_offTest_of_witness
    w hw hw0 hc hCoercive

/-! ## 6. Aggregate unconditional endpoint -/

/-- Concrete finite-stage rank-one baseline certificate.  The last clause is
the explicit firewall separating this elementary inverse-eta test from the
paper's genuinely stronger Paper-I coercivity input. -/
theorem actualInverseEtaTestOperatorCertificate
    {Y : ℝ} (hY : 1 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ‖actualInverseEtaAnalysisFunctional Y‖ =
        ‖actualInverseEtaTestVector Y‖ ∧
      ‖actualInverseEtaTestOperator Y‖ =
        ‖actualInverseEtaTestVector Y‖ ^ 2 ∧
      (actualInverseEtaTestOperator Y).IsSymmetric ∧
      (actualInverseEtaTestOperator Y).IsPositive ∧
      (actualInverseEtaTestOperator Y).toLinearMap.ker =
        ActualInverseEtaOffTestSubspace Y ∧
      (actualInverseEtaTestOperator Y).toLinearMap.range =
        ActualInverseEtaTestLine Y ∧
      IsIdempotentElem (actualNormalizedInverseEtaProjection hY) ∧
      (actualNormalizedInverseEtaProjection hY).toLinearMap.range =
        ActualInverseEtaTestLine Y ∧
      (actualNormalizedInverseEtaProjection hY).toLinearMap.ker =
        ActualInverseEtaOffTestSubspace Y ∧
      ∀ (w : ActualInverseEtaTestSpace Y),
        w ∈ ActualInverseEtaOffTestSubspace Y → w ≠ 0 →
          ¬ ∃ c : ℝ, 0 < c ∧
            ∀ u : ActualInverseEtaTestSpace Y,
              u ∈ ActualInverseEtaOffTestSubspace Y →
                c * ‖u‖ ^ 2 ≤ actualInverseEtaTestEnergy Y u := by
  exact
    ⟨actualInverseEtaAnalysisFunctional_norm Y,
      actualInverseEtaTestOperator_norm Y,
      actualInverseEtaTestOperator_isSymmetric Y,
      actualInverseEtaTestOperator_isPositive Y,
      actualInverseEtaTestOperator_ker Y,
      actualInverseEtaTestOperator_range hY,
      actualNormalizedInverseEtaProjection_isIdempotent hY,
      actualNormalizedInverseEtaProjection_range hY,
      actualNormalizedInverseEtaProjection_ker hY,
      fun w hw hw0 =>
        no_exists_positive_coercivity_on_offTest_of_witness w hw hw0⟩

end QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension

