/-!
# A real form-domain realization as an actual `LinearPMap`

Let `V` be a real Hilbert form space, `H` an ambient real Hilbert space, and
`j : V →L[ℝ] H` a continuous injective map with dense range.  For a bounded
bilinear form `B : V →L[ℝ] V →L[ℝ] ℝ`, this file defines the vectors `u : V`
whose functional `B u` is represented by an ambient vector against `j V`.
Those vectors form a submodule.  Density of `j V` makes the ambient
representer unique, hence linear in `u`.

The image under `j` of the representable submodule is then used as the actual
domain of a Mathlib `LinearPMap H H`.  Its value is the unique ambient
representer.  Thus the domain, action, graph, linearity, symmetry transfer,
and nonnegativity transfer are all definitions or proved theorems, rather than
fields of an assumed realization certificate.

This is an honest workaround for the absence of a general Friedrichs
representation API in Mathlib.  The hypotheses in this file do *not* imply
that the representable submodule is dense, nor that the resulting operator is
self-adjoint.  With density of the representable submodule one obtains a
dense symmetric closable operator.  The final theorem identifies the exact
remaining self-adjointness boundary as the reverse adjoint inclusion.
-/

namespace QYM.FormDomainRealizationExtension

open Set
open scoped RealInnerProductSpace

variable {V H : Type*}
variable [NormedAddCommGroup V] [InnerProductSpace ℝ V]
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-! ## Ambient representability and its linear submodule -/

/-- `f : H` represents the form functional `B u` through the embedding `j`.
The orientation is chosen so that the represented operator satisfies
`B u v = ⟪A (j u), j v⟫_ℝ`. -/
def Represents
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (u : V) (f : H) : Prop :=
  ∀ v : V, B u v = ⟪f, j v⟫_ℝ

theorem Represents.zero
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) :
    Represents B j 0 0 := by
  intro v
  simp [Represents]

theorem Represents.add
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {u w : V} {f g : H}
    (hf : Represents B j u f) (hg : Represents B j w g) :
    Represents B j (u + w) (f + g) := by
  intro v
  simp only [Represents] at hf hg ⊢
  calc
    B (u + w) v = B u v + B w v := by
      simp only [map_add, ContinuousLinearMap.add_apply]
    _ = ⟪f, j v⟫_ℝ + ⟪g, j v⟫_ℝ := by rw [hf v, hg v]
    _ = ⟪f + g, j v⟫_ℝ := (inner_add_left f g (j v)).symm

theorem Represents.smul
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    {u : V} {f : H} (hf : Represents B j u f) (a : ℝ) :
    Represents B j (a • u) (a • f) := by
  intro v
  simp only [Represents] at hf ⊢
  calc
    B (a • u) v = a * B u v := by
      simp only [map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
    _ = a * ⟪f, j v⟫_ℝ := by rw [hf v]
    _ = ⟪a • f, j v⟫_ℝ := (real_inner_smul_left f (j v) a).symm

/-- The form vectors having an ambient representing vector. -/
def formDomain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) :
    Submodule ℝ V where
  carrier := {u | ∃ f : H, Represents B j u f}
  zero_mem' := ⟨0, Represents.zero B j⟩
  add_mem' := by
    rintro u w ⟨f, hf⟩ ⟨g, hg⟩
    exact ⟨f + g, hf.add hg⟩
  smul_mem' := by
    rintro a u ⟨f, hf⟩
    exact ⟨a • f, hf.smul a⟩

theorem mem_formDomain_iff
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) (u : V) :
    u ∈ formDomain B j ↔ ∃ f : H, Represents B j u f :=
  Iff.rfl

/-- Density of `j V` makes ambient representing vectors unique. -/
theorem representingVector_unique
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hjDense : DenseRange j) {u : V} {f g : H}
    (hf : Represents B j u f) (hg : Represents B j u g) :
    f = g := by
  apply hjDense.eq_of_inner_left ℝ
  intro v
  exact (hf v).symm.trans (hg v)

/-- The unique representing vector, selected only after existence has been
encoded by membership in `formDomain`. -/
noncomputable def representingVector
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (u : formDomain B j) : H :=
  Classical.choose u.property

theorem representingVector_spec
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (u : formDomain B j) :
    Represents B j (u : V) (representingVector B j u) :=
  Classical.choose_spec u.property

/-- The representative depends linearly on a representable form vector.
Linearity is proved from density/uniqueness, not included in the definition of
the representability predicate. -/
noncomputable def representingLinearMap
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hjDense : DenseRange j) :
    formDomain B j →ₗ[ℝ] H where
  toFun := representingVector B j
  map_add' u w :=
    representingVector_unique hjDense
      (representingVector_spec B j (u + w))
      ((representingVector_spec B j u).add
        (representingVector_spec B j w))
  map_smul' a u :=
    representingVector_unique hjDense
      (representingVector_spec B j (a • u))
      ((representingVector_spec B j u).smul a)

@[simp]
theorem representingLinearMap_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hjDense : DenseRange j) (u : formDomain B j) :
    representingLinearMap B j hjDense u = representingVector B j u :=
  rfl

theorem representingVector_eq_of_represents
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hjDense : DenseRange j) (u : formDomain B j) {f : H}
    (hf : Represents B j (u : V) f) :
    representingVector B j u = f :=
  representingVector_unique hjDense (representingVector_spec B j u) hf

/-! ## The actual ambient domain and its coordinate equivalence -/

/-- The continuous embedding restricted to the representable form vectors. -/
def formEmbedding
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) :
    formDomain B j →L[ℝ] H :=
  j.comp (Submodule.subtypeL (formDomain B j))

@[simp]
theorem formEmbedding_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (u : formDomain B j) :
    formEmbedding B j u = j (u : V) :=
  rfl

theorem formEmbedding_injective
    (B : V →L[ℝ] V →L[ℝ] ℝ) {j : V →L[ℝ] H}
    (hj : Function.Injective j) :
    Function.Injective (formEmbedding B j) := by
  intro u w huw
  apply Subtype.ext
  apply hj
  simpa only [formEmbedding_apply] using huw

/-- The ambient operator domain is exactly the range of the restricted
embedding. -/
def operatorDomain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H) :
    Submodule ℝ H :=
  LinearMap.range (formEmbedding B j).toLinearMap

/-- Injectivity of `j` identifies the abstract form-domain subtype with its
ambient image. -/
noncomputable def domainEquiv
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) :
    formDomain B j ≃ₗ[ℝ] operatorDomain B j :=
  LinearEquiv.ofInjective (formEmbedding B j).toLinearMap
    (formEmbedding_injective B hj)

@[simp]
theorem coe_domainEquiv_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (u : formDomain B j) :
    ((domainEquiv B j hj u : operatorDomain B j) : H) = j (u : V) := by
  change formEmbedding B j u = j (u : V)
  exact formEmbedding_apply B j u

theorem coe_domainEquiv_symm
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (x : operatorDomain B j) :
    j (((domainEquiv B j hj).symm x : formDomain B j) : V) = (x : H) := by
  calc
    j (((domainEquiv B j hj).symm x : formDomain B j) : V) =
        (((domainEquiv B j hj)
          ((domainEquiv B j hj).symm x) : operatorDomain B j) : H) :=
      (coe_domainEquiv_apply B j hj ((domainEquiv B j hj).symm x)).symm
    _ = (x : H) := congrArg Subtype.val
      ((domainEquiv B j hj).apply_symm_apply x)

/-- An embedded vector is in the operator domain exactly when its form
functional has an ambient representer. -/
theorem embed_mem_operatorDomain_iff
    (B : V →L[ℝ] V →L[ℝ] ℝ) {j : V →L[ℝ] H}
    (hj : Function.Injective j) (u : V) :
    j u ∈ operatorDomain B j ↔ ∃ f : H, Represents B j u f := by
  constructor
  · rintro ⟨w, hw⟩
    have hwu : (w : V) = u := by
      apply hj
      change formEmbedding B j w = j u at hw
      exact hw
    have hwrep : ∃ f : H, Represents B j (w : V) f := w.property
    simpa only [hwu] using hwrep
  · intro hu
    refine ⟨⟨u, hu⟩, ?_⟩
    exact formEmbedding_apply B j ⟨u, hu⟩

/-- If the representable form vectors are dense in `V`, then their embedded
image is dense in `H`.  This is the explicit dense-domain supplier; it is not
derivable from boundedness of `B` alone. -/
theorem formEmbedding_denseRange
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V)) :
    DenseRange (formEmbedding B j) := by
  have hcomp :
      DenseRange (j ∘ ((↑) : formDomain B j → V)) :=
    hjDense.comp hFormDense.denseRange_val j.continuous
  change DenseRange (fun u : formDomain B j => j (u : V))
  change DenseRange (fun u : formDomain B j => j (u : V)) at hcomp
  exact hcomp

theorem operatorDomain_dense
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V)) :
    Dense (operatorDomain B j : Set H) := by
  change Dense (Set.range (formEmbedding B j))
  exact formEmbedding_denseRange B j hjDense hFormDense

/-! ## Construction and graph of the ambient `LinearPMap` -/

/-- The actual partially defined ambient operator associated with `(B,j)`.
Its domain is `j (formDomain B j)`, and its action is the unique ambient
representing vector. -/
noncomputable def realization
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    H →ₗ.[ℝ] H where
  domain := operatorDomain B j
  toFun := (representingLinearMap B j hjDense).comp
    (domainEquiv B j hj).symm.toLinearMap

@[simp]
theorem realization_domain
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    (realization B j hj hjDense).domain = operatorDomain B j :=
  rfl

theorem realization_apply_domainEquiv
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : formDomain B j) :
    realization B j hj hjDense (domainEquiv B j hj u) =
      representingVector B j u := by
  change representingLinearMap B j hjDense
      ((domainEquiv B j hj).symm (domainEquiv B j hj u)) = _
  rw [LinearEquiv.symm_apply_apply]
  rfl

theorem realization_represents_domainEquiv
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : formDomain B j) :
    Represents B j (u : V)
      (realization B j hj hjDense (domainEquiv B j hj u)) := by
  rw [realization_apply_domainEquiv]
  exact representingVector_spec B j u

/-- Every domain point is decoded to its unique form-domain coordinate, and
the operator value represents that coordinate's form functional. -/
theorem realization_represents
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (x : operatorDomain B j) :
    Represents B j
      (((domainEquiv B j hj).symm x : formDomain B j) : V)
      (realization B j hj hjDense x) := by
  let u : formDomain B j := (domainEquiv B j hj).symm x
  have hx : domainEquiv B j hj u = x :=
    (domainEquiv B j hj).apply_symm_apply x
  rw [← hx]
  simpa only [LinearEquiv.symm_apply_apply] using
    realization_represents_domainEquiv B j hj hjDense u

/-- The graph of the constructed `LinearPMap` is exactly the form
representation relation. -/
theorem pair_mem_realization_graph_iff
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (u : V) (f : H) :
    (j u, f) ∈ (realization B j hj hjDense).graph ↔
      Represents B j u f := by
  constructor
  · intro hgraph
    rw [LinearPMap.mem_graph_iff] at hgraph
    rcases hgraph with ⟨x, hx, hvalue⟩
    have hcoordinate :
        (((domainEquiv B j hj).symm x : formDomain B j) : V) = u := by
      apply hj
      exact (coe_domainEquiv_symm B j hj x).trans hx
    have hrep := realization_represents B j hj hjDense x
    intro v
    simpa only [hcoordinate, hvalue] using hrep v
  · intro hrep
    let uD : formDomain B j := ⟨u, ⟨f, hrep⟩⟩
    let x : operatorDomain B j := domainEquiv B j hj uD
    rw [LinearPMap.mem_graph_iff]
    refine ⟨x, ?_, ?_⟩
    · simpa only [x, uD] using coe_domainEquiv_apply B j hj uD
    · calc
        realization B j hj hjDense x = representingVector B j uD := by
          simpa only [x] using
            realization_apply_domainEquiv B j hj hjDense uD
        _ = f := representingVector_unique hjDense
          (representingVector_spec B j uD) hrep

/-! ## Explicit linearity on the actual domain -/

@[simp]
theorem realization_map_zero
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j) :
    realization B j hj hjDense
      (0 : (realization B j hj hjDense).domain) = 0 :=
  LinearPMap.map_zero _

theorem realization_map_add
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (x y : (realization B j hj hjDense).domain) :
    realization B j hj hjDense (x + y) =
      realization B j hj hjDense x + realization B j hj hjDense y :=
  LinearPMap.map_add _ x y

theorem realization_map_smul
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (a : ℝ) (x : (realization B j hj hjDense).domain) :
    realization B j hj hjDense (a • x) =
      a • realization B j hj hjDense x :=
  LinearPMap.map_smul _ a x

/-! ## Transfer of symmetry and nonnegativity -/

/-- Symmetry of the bounded form on `V`. -/
def IsSymmetricForm (B : V →L[ℝ] V →L[ℝ] ℝ) : Prop :=
  ∀ u v : V, B u v = B v u

/-- Diagonal nonnegativity of the bounded form on `V`. -/
def IsNonnegativeForm (B : V →L[ℝ] V →L[ℝ] ℝ) : Prop :=
  ∀ u : V, 0 ≤ B u u

/-- A symmetric form produces a genuinely symmetric `LinearPMap`. -/
theorem realization_isFormalAdjoint
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hB : IsSymmetricForm B) :
    (realization B j hj hjDense).IsFormalAdjoint
      (realization B j hj hjDense) := by
  intro x y
  let u : formDomain B j := (domainEquiv B j hj).symm x
  let v : formDomain B j := (domainEquiv B j hj).symm y
  have hxrep := realization_represents B j hj hjDense x
  have hyrep := realization_represents B j hj hjDense y
  have hxcoe : j (u : V) = (x : H) := coe_domainEquiv_symm B j hj x
  have hycoe : j (v : V) = (y : H) := coe_domainEquiv_symm B j hj y
  calc
    ⟪realization B j hj hjDense x, (y : H)⟫_ℝ =
        ⟪realization B j hj hjDense x, j (v : V)⟫_ℝ :=
      congrArg (fun z : H => ⟪realization B j hj hjDense x, z⟫_ℝ)
        hycoe.symm
    _ = B (u : V) (v : V) := (hxrep (v : V)).symm
    _ = B (v : V) (u : V) := hB (u : V) (v : V)
    _ = ⟪realization B j hj hjDense y, j (u : V)⟫_ℝ :=
      hyrep (u : V)
    _ = ⟪j (u : V), realization B j hj hjDense y⟫_ℝ :=
      real_inner_comm _ _
    _ = ⟪(x : H), realization B j hj hjDense y⟫_ℝ :=
      congrArg (fun z : H => ⟪z, realization B j hj hjDense y⟫_ℝ) hxcoe

/-- The diagonal operator pairing is exactly the diagonal form value in the
decoded form-domain coordinate. -/
theorem inner_realization_self
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (x : operatorDomain B j) :
    ⟪realization B j hj hjDense x, (x : H)⟫_ℝ =
      B (((domainEquiv B j hj).symm x : formDomain B j) : V)
        (((domainEquiv B j hj).symm x : formDomain B j) : V) := by
  let u : formDomain B j := (domainEquiv B j hj).symm x
  have hxcoe : j (u : V) = (x : H) := coe_domainEquiv_symm B j hj x
  have hxrep := realization_represents B j hj hjDense x
  calc
    ⟪realization B j hj hjDense x, (x : H)⟫_ℝ =
        ⟪realization B j hj hjDense x, j (u : V)⟫_ℝ :=
      congrArg (fun z : H => ⟪realization B j hj hjDense x, z⟫_ℝ)
        hxcoe.symm
    _ = B (u : V) (u : V) := (hxrep (u : V)).symm

theorem realization_inner_nonnegative
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hB : IsNonnegativeForm B)
    (x : (realization B j hj hjDense).domain) :
    0 ≤ ⟪realization B j hj hjDense x, (x : H)⟫_ℝ := by
  rw [inner_realization_self B j hj hjDense x]
  exact hB _

/-! ## Dense symmetric realization, closability, and the exact boundary -/

theorem realization_domain_dense
    (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V)) :
    Dense ((realization B j hj hjDense).domain : Set H) := by
  change Dense (operatorDomain B j : Set H)
  exact operatorDomain_dense B j hjDense hFormDense

/-- A dense symmetric form-domain realization is closable through Mathlib's
actual Hilbert adjoint: symmetry gives `A ≤ A†`, and `A†` is closed. -/
theorem realization_isClosable
    [CompleteSpace H]
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V))
    (hB : IsSymmetricForm B) :
    (realization B j hj hjDense).IsClosable := by
  let A : H →ₗ.[ℝ] H := realization B j hj hjDense
  have hDense : Dense (A.domain : Set H) :=
    realization_domain_dense B j hj hjDense hFormDense
  have hSymm : A.IsFormalAdjoint A :=
    realization_isFormalAdjoint hj hjDense hB
  have hle : A ≤ A.adjoint :=
    LinearPMap.IsFormalAdjoint.le_adjoint hDense hSymm
  exact (LinearPMap.adjoint_isClosed hDense).isClosable.leIsClosable hle

theorem realization_closure_isClosed
    [CompleteSpace H]
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V))
    (hB : IsSymmetricForm B) :
    (realization B j hj hjDense).closure.IsClosed :=
  (realization_isClosable hj hjDense hFormDense hB).closure_isClosed

/-- Under the proved dense-symmetry hypotheses, self-adjointness is equivalent
to the one inclusion not furnished by the form-domain construction.  This is
the precise source-level boundary left by the missing Friedrichs/maximality
API; the reverse inclusion is not stored in the input data above. -/
theorem realization_selfAdjoint_iff_adjoint_le
    [CompleteSpace H]
    {B : V →L[ℝ] V →L[ℝ] ℝ} {j : V →L[ℝ] H}
    (hj : Function.Injective j) (hjDense : DenseRange j)
    (hFormDense : Dense (formDomain B j : Set V))
    (hB : IsSymmetricForm B) :
    IsSelfAdjoint (realization B j hj hjDense) ↔
      (realization B j hj hjDense).adjoint ≤
        realization B j hj hjDense := by
  let A : H →ₗ.[ℝ] H := realization B j hj hjDense
  have hDense : Dense (A.domain : Set H) :=
    realization_domain_dense B j hj hjDense hFormDense
  have hSymm : A.IsFormalAdjoint A :=
    realization_isFormalAdjoint hj hjDense hB
  have hle : A ≤ A.adjoint :=
    LinearPMap.IsFormalAdjoint.le_adjoint hDense hSymm
  constructor
  · intro hA
    exact (LinearPMap.isSelfAdjoint_def.mp hA).le
  · intro hmax
    exact LinearPMap.isSelfAdjoint_def.mpr (le_antisymm hmax hle)

end QYM.FormDomainRealizationExtension

/-!
# Paper-normalized real form-domain realization boundary

The propositions below expose the new form-domain construction at the labels
of Lemmas 4.13 and 4.16.  They quantify over actual real Hilbert spaces, an
actual continuous injective dense embedding, an actual bounded bilinear form,
and Mathlib's actual `LinearPMap` domain, graph, adjoint, closure, and
self-adjointness predicates.

The first two propositions require no assumed operator.  They construct the
operator from the form representation relation and prove its exact graph,
symmetry, and nonnegativity properties.  The third derives density and
closability from the explicit supplier that the representable form vectors
are dense.  The last proposition records the precise remaining Friedrichs
boundary: under the proved dense-symmetry hypotheses, self-adjointness is
equivalent to the reverse adjoint inclusion.  No self-adjointness or compact
resolvent conclusion is hidden in the construction inputs.
-/

namespace QYM.FullCertification.PaperNormalized

open Set
open QYM.FormDomainRealizationExtension
open scoped RealInnerProductSpace

/-! ## Lemma 4.13: construction, domain, and exact graph -/

/-- A bounded real form and an injective dense form embedding define an actual
ambient `LinearPMap`.  Its domain membership and graph are characterized
exactly by ambient representability of the form functional. -/
def lemma4_13_realFormDomainRealizationStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j),
        ∃ A : H →ₗ.[ℝ] H,
          A.domain = operatorDomain B j ∧
            (∀ u : V,
              j u ∈ A.domain ↔ ∃ f : H, Represents B j u f) ∧
              ∀ (u : V) (f : H),
                (j u, f) ∈ A.graph ↔ Represents B j u f

theorem lemma4_13_realFormDomainRealizationStatement_holds :
    lemma4_13_realFormDomainRealizationStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH B j hj hjDense
  refine ⟨realization B j hj hjDense, realization_domain B j hj hjDense, ?_, ?_⟩
  · intro u
    exact embed_mem_operatorDomain_iff B hj u
  · intro u f
    exact pair_mem_realization_graph_iff B j hj hjDense u f

/-! ## Lemma 4.13: symmetry and nonnegativity transfer -/

/-- Symmetry and diagonal nonnegativity of the form transfer to the actual
ambient operator pairing on its actual domain. -/
def lemma4_13_realFormSymmetryPositivityStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j),
        IsSymmetricForm B →
          IsNonnegativeForm B →
            let A := realization B j hj hjDense
            A.IsFormalAdjoint A ∧
              ∀ x : A.domain, 0 ≤ ⟪A x, (x : H)⟫_ℝ

theorem lemma4_13_realFormSymmetryPositivityStatement_holds :
    lemma4_13_realFormSymmetryPositivityStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH
    B j hj hjDense hSymm hNonnegative
  dsimp only
  exact
    ⟨realization_isFormalAdjoint hj hjDense hSymm,
      realization_inner_nonnegative hj hjDense hNonnegative⟩

/-! ## Lemma 4.16: the dense symmetric closable realization -/

/-- Density of the representable vectors is the additional analytic supplier
needed to turn the constructed symmetric operator into a densely defined
closable operator.  Its Mathlib closure is then an actual closed extension. -/
def lemma4_16_realFormDenseClosableStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j),
        Dense (formDomain B j : Set V) →
          IsSymmetricForm B →
            let A := realization B j hj hjDense
            Dense (A.domain : Set H) ∧
              A.IsFormalAdjoint A ∧
                A.IsClosable ∧
                  A.closure.IsClosed ∧ A ≤ A.closure

theorem lemma4_16_realFormDenseClosableStatement_holds :
    lemma4_16_realFormDenseClosableStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH instCompleteH
    B j hj hjDense hFormDense hSymm
  dsimp only
  exact
    ⟨realization_domain_dense B j hj hjDense hFormDense,
      realization_isFormalAdjoint hj hjDense hSymm,
      realization_isClosable hj hjDense hFormDense hSymm,
      realization_closure_isClosed hj hjDense hFormDense hSymm,
      LinearPMap.le_closure (realization B j hj hjDense)⟩

/-! ## Lemma 4.16: exact self-adjointness boundary -/

/-- Once density and symmetry have been proved, the form-domain construction
already gives `A ≤ A†`.  Consequently self-adjointness is equivalent to the
reverse inclusion `A† ≤ A`.  Establishing that reverse inclusion is the
maximality/Friedrichs step still absent from the generic Mathlib API. -/
def lemma4_16_realFormSelfAdjointBoundaryStatement : Prop :=
  ∀ (V H : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (j : V →L[ℝ] H)
      (hj : Function.Injective j) (hjDense : DenseRange j),
        Dense (formDomain B j : Set V) →
          IsSymmetricForm B →
            let A := realization B j hj hjDense
            IsSelfAdjoint A ↔ A.adjoint ≤ A

theorem lemma4_16_realFormSelfAdjointBoundaryStatement_holds :
    lemma4_16_realFormSelfAdjointBoundaryStatement := by
  intro V H instNormedV instInnerV instNormedH instInnerH instCompleteH
    B j hj hjDense hFormDense hSymm
  dsimp only
  exact realization_selfAdjoint_iff_adjoint_le hj hjDense hFormDense hSymm

end QYM.FullCertification.PaperNormalized

/-!
# Resolvent data for genuine `LinearPMap` operators

Mathlib's algebraic `resolvent` API applies to bounded endomorphisms.  This file supplies the
missing definition-level bridge for an actual partially defined operator
`T : H →ₗ.[𝕜] H`.  A `ResolventData T z` consists of a continuous ambient inverse and the two
inverse identities on the *actual* domain of `T`.

No compactness, density, symmetry, self-adjointness, or spectral conclusion is stored in the
structure.  Compact resolvent is a separate predicate on the supplied inverse.  In particular,
the positive compactness lemmas below always expose the exact compact-operator supplier they use.
-/

namespace QYM.UnboundedResolventDataExtension

open Set

variable {𝕜 H : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup H] [NormedSpace 𝕜 H]

/-! ## The shifted operator on the genuine domain -/

/-- The algebraic map `x ↦ z • x - T x`, with source exactly `T.domain`. -/
def shifted (T : H →ₗ.[𝕜] H) (z : 𝕜) : T.domain →ₗ[𝕜] H :=
  z • T.domain.subtype - T.toFun

@[simp]
theorem shifted_apply (T : H →ₗ.[𝕜] H) (z : 𝕜) (x : T.domain) :
    shifted T z x = z • (x : H) - T x := by
  rfl

@[simp]
theorem shifted_zero (T : H →ₗ.[𝕜] H) (z : 𝕜) :
    shifted T z 0 = 0 :=
  (shifted T z).map_zero

theorem shifted_add (T : H →ₗ.[𝕜] H) (z : 𝕜) (x y : T.domain) :
    shifted T z (x + y) = shifted T z x + shifted T z y :=
  (shifted T z).map_add x y

theorem shifted_smul (T : H →ₗ.[𝕜] H) (z a : 𝕜) (x : T.domain) :
    shifted T z (a • x) = a • shifted T z x :=
  (shifted T z).map_smul a x

/-- Difference of two shifts on a common domain vector. -/
theorem shifted_change_parameter
    (T : H →ₗ.[𝕜] H) (z w : 𝕜) (x : T.domain) :
    shifted T w x = shifted T z x + (w - z) • (x : H) := by
  simp only [shifted_apply]
  module

/-! ## Transparent resolvent data -/

/--
Genuine resolvent data for a partial operator.

`inverse` is continuous on the ambient space, `mapsToDomain` says that it really lands in the
operator domain, and the last two fields are the two inverse equations for `z - T`.  None of the
analytic conclusions later derived from these equations is copied into this structure.
-/
structure ResolventData (T : H →ₗ.[𝕜] H) (z : 𝕜) where
  inverse : H →L[𝕜] H
  mapsToDomain : ∀ y : H, inverse y ∈ T.domain
  left_inverse : ∀ x : T.domain,
    inverse (shifted T z x) = (x : H)
  right_inverse : ∀ y : H,
    shifted T z ⟨inverse y, mapsToDomain y⟩ = y

/-- The inverse with its codomain restricted to the actual operator domain. -/
def ResolventData.domainLift
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    H →ₗ[𝕜] T.domain :=
  ρ.inverse.toLinearMap.codRestrict T.domain ρ.mapsToDomain

@[simp]
theorem ResolventData.coe_domainLift
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) (y : H) :
    (ρ.domainLift y : H) = ρ.inverse y := by
  rfl

@[simp]
theorem ResolventData.domainLift_shifted
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) (x : T.domain) :
    ρ.domainLift (shifted T z x) = x := by
  apply Subtype.ext
  exact ρ.left_inverse x

@[simp]
theorem ResolventData.shifted_domainLift
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) (y : H) :
    shifted T z (ρ.domainLift y) = y := by
  exact ρ.right_inverse y

theorem ResolventData.leftInverse_domainLift_shifted
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.LeftInverse ρ.domainLift (shifted T z) :=
  ρ.domainLift_shifted

theorem ResolventData.rightInverse_domainLift_shifted
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.RightInverse ρ.domainLift (shifted T z) :=
  ρ.shifted_domainLift

/-! ## Exact injectivity, surjectivity, and range consequences -/

theorem ResolventData.shifted_injective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Injective (shifted T z) :=
  ρ.leftInverse_domainLift_shifted.injective

theorem ResolventData.shifted_surjective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Surjective (shifted T z) :=
  ρ.rightInverse_domainLift_shifted.surjective

theorem ResolventData.shifted_bijective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Bijective (shifted T z) :=
  ⟨ρ.shifted_injective, ρ.shifted_surjective⟩

theorem ResolventData.domainLift_injective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Injective ρ.domainLift :=
  ρ.rightInverse_domainLift_shifted.injective

theorem ResolventData.domainLift_surjective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Surjective ρ.domainLift :=
  ρ.leftInverse_domainLift_shifted.surjective

theorem ResolventData.domainLift_bijective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Bijective ρ.domainLift :=
  ⟨ρ.domainLift_injective, ρ.domainLift_surjective⟩

theorem ResolventData.inverse_injective
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Injective ρ.inverse := by
  intro y₁ y₂ h
  apply ρ.domainLift_injective
  apply Subtype.ext
  exact h

/-- The ambient range of a resolvent inverse is exactly the actual `LinearPMap` domain. -/
theorem ResolventData.range_inverse_eq_domain
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Set.range ρ.inverse = (T.domain : Set H) := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact ρ.mapsToDomain y
  · intro hx
    let xd : T.domain := ⟨x, hx⟩
    refine ⟨shifted T z xd, ?_⟩
    exact ρ.left_inverse xd

/-- Ambient surjectivity of the inverse occurs precisely when the partial operator has full
domain.  A genuine unbounded resolvent should not silently assert this stronger statement. -/
theorem ResolventData.inverse_surjective_iff_domain_eq_top
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    Function.Surjective ρ.inverse ↔ T.domain = ⊤ := by
  constructor
  · intro hsurj
    apply le_antisymm le_top
    intro x _
    obtain ⟨y, hy⟩ := hsurj x
    rw [← hy]
    exact ρ.mapsToDomain y
  · intro hdomain x
    have hx : x ∈ T.domain := by
      rw [hdomain]
      exact Submodule.mem_top
    let xd : T.domain := ⟨x, hx⟩
    exact ⟨shifted T z xd, ρ.left_inverse xd⟩

/-! ## Uniqueness -/

/-- The continuous inverse is uniquely determined by the two inverse equations. -/
theorem resolvent_inverse_unique
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ σ : ResolventData T z) :
    ρ.inverse = σ.inverse := by
  ext y
  let x : T.domain := ρ.domainLift y
  calc
    ρ.inverse y = (x : H) := by rfl
    _ = σ.inverse (shifted T z x) := (σ.left_inverse x).symm
    _ = σ.inverse y := by rw [ρ.shifted_domainLift y]

/-! ## Closedness supplied by the continuous inverse -/

/-- Graph membership is an ambient fixed-point equation for the continuous inverse. -/
theorem ResolventData.mem_graph_iff_fixedPoint
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) (x y : H) :
    (x, y) ∈ T.graph ↔ ρ.inverse (z • x - y) = x := by
  constructor
  · intro hxy
    rw [LinearPMap.mem_graph_iff] at hxy
    rcases hxy with ⟨u, hu, hTu⟩
    calc
      ρ.inverse (z • x - y) = ρ.inverse (shifted T z u) := by
        apply congrArg ρ.inverse
        simp only [shifted_apply]
        rw [hu, hTu]
      _ = (u : H) := ρ.left_inverse u
      _ = x := hu
  · intro hfixed
    have hxDomain : x ∈ T.domain := by
      rw [← hfixed]
      exact ρ.mapsToDomain _
    let u : T.domain := ⟨x, hxDomain⟩
    have hu : ρ.domainLift (z • x - y) = u := by
      apply Subtype.ext
      simpa only [ResolventData.coe_domainLift] using hfixed
    have hshift : shifted T z u = z • x - y := by
      rw [← hu]
      exact ρ.shifted_domainLift _
    have hTu : T u = y := by
      have heq : z • x - T u = z • x - y := by
        simpa only [shifted_apply] using hshift
      exact sub_right_inj.mp heq
    exact (LinearPMap.image_iff hxDomain).mp hTu.symm

/-- Existence of the genuine continuous resolvent implies that the partial operator is closed. -/
theorem ResolventData.isClosed
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    T.IsClosed := by
  rw [LinearPMap.IsClosed]
  have hgraph :
      (T.graph : Set (H × H)) =
        {p | ρ.inverse (z • p.1 - p.2) = p.1} := by
    ext p
    exact ρ.mem_graph_iff_fixedPoint p.1 p.2
  rw [hgraph]
  exact
    isClosed_eq
      (ρ.inverse.continuous.comp ((continuous_fst.const_smul z).sub continuous_snd))
      continuous_fst

theorem ResolventData.isClosable
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    T.IsClosable :=
  ρ.isClosed.isClosable

/-! ## First resolvent identity on an actual `LinearPMap` -/

/-- The first resolvent identity for two supplied resolvent points of the same partial operator. -/
theorem first_resolvent_identity
    {T : H →ₗ.[𝕜] H} {z w : 𝕜}
    (ρz : ResolventData T z) (ρw : ResolventData T w) :
    ρz.inverse - ρw.inverse =
      (w - z) • (ρz.inverse.comp ρw.inverse) := by
  ext y
  let x : T.domain := ρw.domainLift y
  have hx : (x : H) = ρw.inverse y := by rfl
  calc
    (ρz.inverse - ρw.inverse) y =
        ρz.inverse y - ρw.inverse y := by
      rw [ContinuousLinearMap.sub_apply]
    _ = ρz.inverse (shifted T w x) - ρw.inverse y := by
      rw [ρw.shifted_domainLift y]
    _ = ρz.inverse (shifted T z x + (w - z) • (x : H)) -
        ρw.inverse y := by
      rw [shifted_change_parameter]
    _ = (ρz.inverse (shifted T z x) +
          (w - z) • ρz.inverse (x : H)) - ρw.inverse y := by
      rw [map_add, map_smul]
    _ = ((x : H) + (w - z) • ρz.inverse (x : H)) -
        ρw.inverse y := by
      rw [ρz.left_inverse x]
    _ = (w - z) • ρz.inverse (ρw.inverse y) := by
      rw [hx]
      module
    _ = ((w - z) • (ρz.inverse.comp ρw.inverse)) y := by
      rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply]

/-! ## Compact resolvent is a separate, exact supplier -/

/-- Compactness of one supplied resolvent inverse. -/
def ResolventData.IsCompactResolvent
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) : Prop :=
  IsCompactOperator (ρ.inverse : H → H)

/-- Existence of genuine resolvent data whose ambient inverse is compact. -/
def HasCompactResolventAt (T : H →ₗ.[𝕜] H) (z : 𝕜) : Prop :=
  ∃ ρ : ResolventData T z, ρ.IsCompactResolvent

/-- Existence of resolvent data, without a compactness assertion. -/
def HasResolventAt (T : H →ₗ.[𝕜] H) (z : 𝕜) : Prop :=
  Nonempty (ResolventData T z)

theorem ResolventData.isCompactResolvent_iff
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (ρ : ResolventData T z) :
    ρ.IsCompactResolvent ↔ IsCompactOperator (ρ.inverse : H → H) :=
  Iff.rfl

theorem hasResolventAt_iff_exact_supplier
    (T : H →ₗ.[𝕜] H) (z : 𝕜) :
    HasResolventAt T z ↔
      ∃ (R : H →L[𝕜] H) (hR : ∀ y : H, R y ∈ T.domain),
        (∀ x : T.domain, R (shifted T z x) = (x : H)) ∧
          (∀ y : H, shifted T z ⟨R y, hR y⟩ = y) := by
  constructor
  · rintro ⟨ρ⟩
    exact ⟨ρ.inverse, ρ.mapsToDomain, ρ.left_inverse, ρ.right_inverse⟩
  · rintro ⟨R, hR, hleft, hright⟩
    exact ⟨⟨R, hR, hleft, hright⟩⟩

theorem hasCompactResolventAt_iff_exact_supplier
    (T : H →ₗ.[𝕜] H) (z : 𝕜) :
    HasCompactResolventAt T z ↔
      ∃ (R : H →L[𝕜] H) (hR : ∀ y : H, R y ∈ T.domain),
        (∀ x : T.domain, R (shifted T z x) = (x : H)) ∧
          (∀ y : H, shifted T z ⟨R y, hR y⟩ = y) ∧
            IsCompactOperator (R : H → H) := by
  constructor
  · rintro ⟨ρ, hcompact⟩
    exact
      ⟨ρ.inverse, ρ.mapsToDomain, ρ.left_inverse, ρ.right_inverse, hcompact⟩
  · rintro ⟨R, hR, hleft, hright, hcompact⟩
    let ρ : ResolventData T z := ⟨R, hR, hleft, hright⟩
    exact ⟨ρ, hcompact⟩

theorem hasCompactResolventAt_of_supplier
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hcompact : IsCompactOperator (ρ.inverse : H → H)) :
    HasCompactResolventAt T z :=
  ⟨ρ, hcompact⟩

theorem HasCompactResolventAt.hasResolventAt
    {T : H →ₗ.[𝕜] H} {z : 𝕜} (h : HasCompactResolventAt T z) :
    HasResolventAt T z := by
  rcases h with ⟨ρ, _⟩
  exact ⟨ρ⟩

/-- Compactness of a genuine resolvent is independent of the supplied resolvent point. -/
theorem compact_resolvent_transfer
    {T : H →ₗ.[𝕜] H} {z w : 𝕜}
    (ρz : ResolventData T z) (ρw : ResolventData T w)
    (hz : ρz.IsCompactResolvent) :
    ρw.IsCompactResolvent := by
  change IsCompactOperator (ρz.inverse : H → H) at hz
  change IsCompactOperator (ρw.inverse : H → H)
  have hcomposition :
      IsCompactOperator
        ((ρz.inverse.comp ρw.inverse : H →L[𝕜] H) : H → H) := by
    simpa only [ContinuousLinearMap.coe_comp'] using
      hz.comp_clm ρw.inverse
  have hscaled :
      IsCompactOperator
        (((w - z) • (ρz.inverse.comp ρw.inverse) : H →L[𝕜] H) : H → H) := by
    simpa only [ContinuousLinearMap.coe_smul'] using
      hcomposition.smul (w - z)
  have hidentity := first_resolvent_identity ρz ρw
  have hformula :
      ρw.inverse =
        ρz.inverse - (w - z) • (ρz.inverse.comp ρw.inverse) := by
    rw [← hidentity]
    module
  rw [hformula]
  simpa only [ContinuousLinearMap.coe_sub'] using hz.sub hscaled

/-! ## Sharp boundaries and no-go statements -/

/-- The partial zero operator with bottom domain.  This is different from the full-domain zero
`LinearPMap`. -/
def bottomOperator : H →ₗ.[𝕜] H :=
  (⊥ : H →ₗ.[𝕜] H)

@[simp]
theorem bottomOperator_domain :
    (bottomOperator : H →ₗ.[𝕜] H).domain = ⊥ := by
  rfl

/-- A bottom-domain operator on a nontrivial space has no resolvent point. -/
theorem no_resolvent_of_domain_eq_bot
    [Nontrivial H] {T : H →ₗ.[𝕜] H} (hT : T.domain = ⊥) (z : 𝕜) :
    ¬ HasResolventAt T z := by
  rintro ⟨ρ⟩
  obtain ⟨y, hy⟩ : ∃ y : H, y ≠ 0 := exists_ne 0
  obtain ⟨x, hx⟩ := ρ.shifted_surjective y
  have hxMem : (x : H) ∈ (⊥ : Submodule 𝕜 H) := by
    rw [← hT]
    exact x.property
  have hxZero : x = 0 := by
    apply Subtype.ext
    exact (Submodule.mem_bot 𝕜).mp hxMem
  apply hy
  rw [← hx, hxZero]
  exact shifted_zero T z

theorem bottomOperator_hasNoResolvent
    [Nontrivial H] (z : 𝕜) :
    ¬ HasResolventAt (bottomOperator : H →ₗ.[𝕜] H) z :=
  no_resolvent_of_domain_eq_bot bottomOperator_domain z

/-- Explicit resolvent data for the full-domain zero operator at `1`. -/
def zeroOneResolventData :
    ResolventData (0 : H →ₗ.[𝕜] H) (1 : 𝕜) where
  inverse := ContinuousLinearMap.id 𝕜 H
  mapsToDomain := by
    intro y
    exact Submodule.mem_top
  left_inverse := by
    intro x
    change (1 : 𝕜) • (x : H) - 0 = (x : H)
    simp
  right_inverse := by
    intro y
    change (1 : 𝕜) • y - 0 = y
    simp

/-- A two-sided continuous inverse does not imply compactness: on an infinite-dimensional space
the zero operator has resolvent inverse `id` at `1`, and that inverse is not compact. -/
theorem zeroOneResolventData_not_compact
    (hinfinite : ¬ FiniteDimensional 𝕜 H) :
    ¬ (zeroOneResolventData
      (𝕜 := 𝕜) (H := H)).IsCompactResolvent := by
  intro hcompact
  apply hinfinite
  apply FiniteDimensional.of_isCompactOperator_id
  change
    IsCompactOperator
      ((ContinuousLinearMap.id 𝕜 H : H →L[𝕜] H) : H → H) at hcompact
  simpa only [ContinuousLinearMap.coe_id'] using hcompact

/-- If a compact genuine resolvent is accompanied by a bounded ambient extension of `z - T`,
then the ambient space is finite-dimensional. -/
theorem finiteDimensional_of_compactResolvent_of_boundedShift
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (ρ : ResolventData T z) (hcompact : ρ.IsCompactResolvent)
    (A : H →L[𝕜] H)
    (hA : ∀ x : T.domain, A (x : H) = shifted T z x) :
    FiniteDimensional 𝕜 H := by
  change IsCompactOperator (ρ.inverse : H → H) at hcompact
  have hcomposition :
      IsCompactOperator ((A.comp ρ.inverse : H →L[𝕜] H) : H → H) := by
    simpa only [ContinuousLinearMap.coe_comp'] using
      hcompact.clm_comp A
  have hid : A.comp ρ.inverse = ContinuousLinearMap.id 𝕜 H := by
    ext y
    calc
      (A.comp ρ.inverse) y = A (ρ.inverse y) := by
        rw [ContinuousLinearMap.comp_apply]
      _ = shifted T z (ρ.domainLift y) := hA (ρ.domainLift y)
      _ = y := ρ.shifted_domainLift y
      _ = (ContinuousLinearMap.id 𝕜 H) y := by rfl
  have hcompactId :
      IsCompactOperator
        ((ContinuousLinearMap.id 𝕜 H : H →L[𝕜] H) : H → H) := by
    rw [← hid]
    exact hcomposition
  apply FiniteDimensional.of_isCompactOperator_id
  simpa only [ContinuousLinearMap.coe_id'] using hcompactId

/-- Hence, on an infinite-dimensional space, a compact resolvent forces `z - T` to remain
genuinely unbounded: no bounded ambient extension can agree with it on the operator domain. -/
theorem no_boundedShift_of_compactResolvent_in_infiniteDimension
    {T : H →ₗ.[𝕜] H} {z : 𝕜}
    (hinfinite : ¬ FiniteDimensional 𝕜 H)
    (ρ : ResolventData T z) (hcompact : ρ.IsCompactResolvent) :
    ¬ ∃ A : H →L[𝕜] H,
        ∀ x : T.domain, A (x : H) = shifted T z x := by
  rintro ⟨A, hA⟩
  exact hinfinite
    (finiteDimensional_of_compactResolvent_of_boundedShift ρ hcompact A hA)

end QYM.UnboundedResolventDataExtension

/-!
# Paper-normalized genuine unbounded resolvent boundary

These closed propositions attach the actual `LinearPMap` resolvent construction to Lemma 4.18,
Proposition 4.23, and Hypothesis 4.24.  Every positive statement quantifies an explicit
`ResolventData` supplier.  Compactness is a separate premise on its continuous inverse; it is
never a field copied into an operator-realization record.

The negative propositions record two sharp boundaries needed for unconditional certification:
a compact resolvent on an infinite-dimensional space cannot come from a bounded ambient shift,
and a two-sided continuous resolvent need not be compact.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Lemma 4.18: actual inverse equations and closedness -/

/-- A supplied genuine `LinearPMap` resolvent makes `z - T` bijective from the actual domain to
the ambient space, identifies the inverse range with that domain, and proves that `T` is closed. -/
def lemma4_18_linearPMapResolventBoundaryStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    Function.Bijective
        (QYM.UnboundedResolventDataExtension.shifted T z) ∧
      Function.Injective ρ.inverse ∧
        Set.range ρ.inverse = (T.domain : Set H) ∧
          T.IsClosed

theorem lemma4_18_linearPMapResolventBoundaryStatement_holds :
    lemma4_18_linearPMapResolventBoundaryStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z ρ
  exact
    ⟨ρ.shifted_bijective,
      ρ.inverse_injective,
      ρ.range_inverse_eq_domain,
      ρ.isClosed⟩

/-- The continuous inverse is unique at a fixed resolvent point. -/
def lemma4_18_linearPMapResolventUniquenessStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ σ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    ρ.inverse = σ.inverse

theorem lemma4_18_linearPMapResolventUniquenessStatement_holds :
    lemma4_18_linearPMapResolventUniquenessStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z ρ σ
  exact QYM.UnboundedResolventDataExtension.resolvent_inverse_unique ρ σ

/-! ## Lemma 4.18: first identity and compactness-point transfer -/

/-- First resolvent identity for two actual resolvent-data suppliers of one partial operator. -/
def lemma4_18_linearPMapFirstResolventIdentityStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z w : 𝕜)
      (ρz : QYM.UnboundedResolventDataExtension.ResolventData T z)
      (ρw : QYM.UnboundedResolventDataExtension.ResolventData T w),
    ρz.inverse - ρw.inverse =
      (w - z) • (ρz.inverse.comp ρw.inverse)

theorem lemma4_18_linearPMapFirstResolventIdentityStatement_holds :
    lemma4_18_linearPMapFirstResolventIdentityStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z w ρz ρw
  exact
    QYM.UnboundedResolventDataExtension.first_resolvent_identity ρz ρw

/-- Compactness at one supplied genuine resolvent point transfers to another supplied point. -/
def lemma4_18_linearPMapCompactResolventTransferStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z w : 𝕜)
      (ρz : QYM.UnboundedResolventDataExtension.ResolventData T z)
      (ρw : QYM.UnboundedResolventDataExtension.ResolventData T w),
    ρz.IsCompactResolvent → ρw.IsCompactResolvent

theorem lemma4_18_linearPMapCompactResolventTransferStatement_holds :
    lemma4_18_linearPMapCompactResolventTransferStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z w ρz ρw hcompact
  exact
    QYM.UnboundedResolventDataExtension.compact_resolvent_transfer
      ρz ρw hcompact

/-! ## Proposition 4.23: the genuinely unbounded boundary -/

/-- If a compact genuine resolvent and a bounded ambient realization of `z - T` coexist, the
ambient space is finite-dimensional. -/
def prop4_23_linearPMapCompactResolventBoundedShiftBoundaryStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    ρ.IsCompactResolvent →
      ∀ A : H →L[𝕜] H,
        (∀ x : T.domain,
          A (x : H) = QYM.UnboundedResolventDataExtension.shifted T z x) →
            FiniteDimensional 𝕜 H

theorem prop4_23_linearPMapCompactResolventBoundedShiftBoundaryStatement_holds :
    prop4_23_linearPMapCompactResolventBoundedShiftBoundaryStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z ρ hcompact A hA
  exact
    QYM.UnboundedResolventDataExtension.finiteDimensional_of_compactResolvent_of_boundedShift
      ρ hcompact A hA

/-- Negative form: in infinite dimension, the shifted partial operator of a compact-resolvent
supplier has no bounded ambient extension. -/
def prop4_23_infiniteDimensionalLinearPMapUnboundednessStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H]
      (T : H →ₗ.[𝕜] H) (z : 𝕜)
      (ρ : QYM.UnboundedResolventDataExtension.ResolventData T z),
    (¬ FiniteDimensional 𝕜 H) →
    ρ.IsCompactResolvent →
      ¬ ∃ A : H →L[𝕜] H,
          ∀ x : T.domain,
            A (x : H) = QYM.UnboundedResolventDataExtension.shifted T z x

theorem prop4_23_infiniteDimensionalLinearPMapUnboundednessStatement_holds :
    prop4_23_infiniteDimensionalLinearPMapUnboundednessStatement := by
  intro 𝕜 H instRCLike instNormed instSpace T z ρ hinfinite hcompact
  exact
    QYM.UnboundedResolventDataExtension.no_boundedShift_of_compactResolvent_in_infiniteDimension
      hinfinite ρ hcompact

/-! ## Hypothesis 4.24: compactness and domain are genuine extra suppliers -/

/-- Even an actual two-sided continuous resolvent is not automatically compact: the full-domain
zero operator at `1` has inverse `id`, which is noncompact in infinite dimension. -/
def hyp4_24_linearPMapCompactnessSupplierBoundaryStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H],
    (¬ FiniteDimensional 𝕜 H) →
      QYM.UnboundedResolventDataExtension.HasResolventAt
          (0 : H →ₗ.[𝕜] H) (1 : 𝕜) ∧
        ¬ (QYM.UnboundedResolventDataExtension.zeroOneResolventData
            (𝕜 := 𝕜) (H := H)).IsCompactResolvent

theorem hyp4_24_linearPMapCompactnessSupplierBoundaryStatement_holds :
    hyp4_24_linearPMapCompactnessSupplierBoundaryStatement := by
  intro 𝕜 H instRCLike instNormed instSpace hinfinite
  exact
    ⟨⟨QYM.UnboundedResolventDataExtension.zeroOneResolventData⟩,
      QYM.UnboundedResolventDataExtension.zeroOneResolventData_not_compact
        hinfinite⟩

/-- A nontrivial bottom-domain partial operator has no resolvent point.  Domain surjectivity is
therefore indispensable and cannot be inferred from a formal operator symbol. -/
def hyp4_24_bottomDomainNoResolventBoundaryStatement : Prop :=
  ∀ (𝕜 H : Type*)
      [RCLike 𝕜]
      [NormedAddCommGroup H] [NormedSpace 𝕜 H] [Nontrivial H]
      (z : 𝕜),
    ¬ QYM.UnboundedResolventDataExtension.HasResolventAt
        (QYM.UnboundedResolventDataExtension.bottomOperator : H →ₗ.[𝕜] H) z

theorem hyp4_24_bottomDomainNoResolventBoundaryStatement_holds :
    hyp4_24_bottomDomainNoResolventBoundaryStatement := by
  intro 𝕜 H instRCLike instNormed instSpace instNontrivial z
  exact
    QYM.UnboundedResolventDataExtension.bottomOperator_hasNoResolvent z

end QYM.FullCertification.PaperNormalized

/-!
# Compact self-adjoint spectral data and a multiplicity-safe ground gap

This module uses the actual `ContinuousLinearMap` spectral API.  It proves:

* the compact self-adjoint spectral resolution supplied by Mathlib;
* finite-dimensionality of every nonzero eigenspace;
* orthogonality of every nonzero eigenvector to the complete zero eigenspace;
* a quantitative off-ground eigenvalue bound from a quadratic lower bound on that orthogonal
  complement, with no simplicity assumption on the ground state;
* in finite dimension, existence of a least positive eigenvalue by minimizing the finite list
  produced by `LinearMap.IsSymmetric.eigenvalues`;
* a compactness no-go: a compact operator on an infinite-dimensional complete space cannot be
  bounded below in norm, hence an injective compact operator cannot satisfy a positive global
  ground-complement coercivity estimate;
* a concrete family of positive compact self-adjoint scalar operators showing that positivity
  alone supplies no prescribed quantitative gap.

Mathlib currently exposes finite multiplicity of nonzero eigenvalues but no theorem packaging the
standard statement that the nonzero point spectrum of a compact operator is finite away from zero.
`AwayFromZeroPointSpectrumFinite` records that missing supplier transparently; no theorem below
pretends to derive it from compactness.
-/

open Module End Set

namespace QYM.CompactSelfAdjointGapExtension

variable {𝕜 E : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

/-! ## Operator-level predicates -/

/-- The complete zero eigenspace.  It is deliberately a subspace rather than a selected vector. -/
abbrev groundSpace (T : E →L[𝕜] E) : Submodule 𝕜 E :=
  eigenspace (T : Module.End 𝕜 E) 0

/-- Nonnegativity of the real part of the quadratic form. -/
def IsQuadraticallyNonnegative (T : E →L[𝕜] E) : Prop :=
  ∀ x : E, 0 ≤ RCLike.re ⟪x, T x⟫

/-- Pointwise strict positivity; this is weaker than a uniform coercive lower bound. -/
def IsQuadraticallyPositive (T : E →L[𝕜] E) : Prop :=
  ∀ x : E, x ≠ 0 → 0 < RCLike.re ⟪x, T x⟫

/-- A quadratic lower bound on the orthogonal complement of the entire ground space. -/
def HasGroundComplementCoercivity (T : E →L[𝕜] E) (c : ℝ) : Prop :=
  ∀ x : E, x ∈ (groundSpace T)ᗮ →
    c * ‖x‖ ^ 2 ≤ RCLike.re ⟪x, T x⟫

/-- A norm lower bound.  This predicate is useful for the compactness obstruction below. -/
def HasNormLowerBound (T : E →L[𝕜] E) (c : ℝ) : Prop :=
  ∀ x : E, c * ‖x‖ ≤ ‖T x‖

theorem groundSpace_eq_ker (T : E →L[𝕜] E) :
    groundSpace T = LinearMap.ker (T : Module.End 𝕜 E) := by
  exact Module.End.eigenspace_zero (T : Module.End 𝕜 E)

/-- Compactness does not make the zero eigenspace finite-dimensional: for the zero operator it is
the whole space. -/
theorem zero_groundSpace_eq_top :
    groundSpace (0 : E →L[𝕜] E) = ⊤ := by
  rw [groundSpace_eq_ker]
  simp

/-! ## Actual compact self-adjoint spectral theorems -/

section Complete

variable [CompleteSpace E]
variable {T : E →L[𝕜] E}

/-- Mathlib's compact self-adjoint spectral theorem, stated for an actual bounded operator. -/
theorem eigenspaces_complete
    (hcompact : IsCompactOperator T) (hself : IsSelfAdjoint T) :
    (⨆ μ : 𝕜, eigenspace (T : Module.End 𝕜 E) μ)ᗮ = ⊥ :=
  ContinuousLinearMap.orthogonalComplement_iSup_eigenspaces_eq_bot
    hcompact hself.isSymmetric

/-- Every nonzero eigenspace of an actual compact operator is finite-dimensional. -/
theorem nonzero_eigenspace_finiteDimensional
    (hcompact : IsCompactOperator T) (μ : 𝕜) (hμ : μ ≠ 0) :
    FiniteDimensional 𝕜 (eigenspace (T : Module.End 𝕜 E) μ) :=
  ContinuousLinearMap.finite_dimensional_eigenspace hcompact μ hμ

/-- The strongest compact self-adjoint package currently available directly from Mathlib. -/
theorem compact_selfAdjoint_spectral_package
    (hcompact : IsCompactOperator T) (hself : IsSelfAdjoint T) :
    (⨆ μ : 𝕜, eigenspace (T : Module.End 𝕜 E) μ)ᗮ = ⊥ ∧
      ∀ μ : 𝕜, μ ≠ 0 →
        FiniteDimensional 𝕜 (eigenspace (T : Module.End 𝕜 E) μ) := by
  refine ⟨eigenspaces_complete hcompact hself, ?_⟩
  intro μ hμ
  exact nonzero_eigenspace_finiteDimensional hcompact μ hμ

/-- Self-adjoint eigenvalues are real, expressed without choosing a real enumeration. -/
theorem eigenvalue_is_real
    (hself : IsSelfAdjoint T) {μ : 𝕜}
    (hμ : HasEigenvalue (T : Module.End 𝕜 E) μ) :
    star μ = μ :=
  hself.isSymmetric.conj_eigenvalue_eq_self hμ

/-- A nonzero eigenvector is orthogonal to every ground-state vector.  The proof uses the whole
zero eigenspace and therefore does not assume a simple ground state. -/
theorem eigenvector_mem_groundSpace_orthogonal
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {μ : 𝕜} {x : E}
    (hx : HasEigenvector (T : Module.End 𝕜 E) μ x)
    (hμ : μ ≠ 0) :
    x ∈ (groundSpace T)ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro y hy
  exact hsymm.orthogonalFamily_eigenspaces.pairwise hμ hx.1 y hy

/-- A real nonzero eigenvalue is bounded below by a quadratic ground-complement coercivity
constant.  No eigenvalue enumeration and no ground-state simplicity assumption is used. -/
theorem real_eigenvalue_ge_of_groundComplementCoercivity
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {c μ : ℝ} {x : E}
    (hcoercive : HasGroundComplementCoercivity T c)
    (hμ : μ ≠ 0)
    (hx : HasEigenvector (T : Module.End 𝕜 E) (μ : 𝕜) x) :
    c ≤ μ := by
  have hμK : (μ : 𝕜) ≠ 0 := by
    exact_mod_cast hμ
  have hxorth : x ∈ (groundSpace T)ᗮ :=
    eigenvector_mem_groundSpace_orthogonal hsymm hx hμK
  have hbound := hcoercive x hxorth
  have hnorm : 0 < ‖x‖ ^ 2 := by
    exact sq_pos_of_pos (norm_pos_iff.mpr hx.2)
  have heigenform :
      RCLike.re ⟪x, T x⟫ = μ * ‖x‖ ^ 2 := by
    exact_mod_cast congr_arg RCLike.re
      (inner_product_apply_eigenvector hx.apply_eq_smul)
  rw [heigenform] at hbound
  nlinarith

/-- Positive ground-complement coercivity yields a strict off-ground eigenvalue bound. -/
theorem real_eigenvalue_pos_of_groundComplementCoercivity
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {c μ : ℝ} {x : E}
    (hcoercive : HasGroundComplementCoercivity T c)
    (hc : 0 < c) (hμ : μ ≠ 0)
    (hx : HasEigenvector (T : Module.End 𝕜 E) (μ : 𝕜) x) :
    0 < μ :=
  lt_of_lt_of_le hc
    (real_eigenvalue_ge_of_groundComplementCoercivity
      hsymm hcoercive hμ hx)

/-- Eigenvalue-level form of the preceding theorem. -/
theorem every_nonzero_real_eigenvalue_ge
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {c : ℝ} (hcoercive : HasGroundComplementCoercivity T c) :
    ∀ μ : ℝ,
      μ ≠ 0 → HasEigenvalue (T : Module.End 𝕜 E) (μ : 𝕜) → c ≤ μ := by
  intro μ hμ heigen
  obtain ⟨x, hx⟩ := heigen.exists_hasEigenvector
  exact real_eigenvalue_ge_of_groundComplementCoercivity
    hsymm hcoercive hμ hx

/-- Nonnegativity puts every real eigenvalue in the nonnegative half-line. -/
theorem real_eigenvalue_nonnegative
    (hnonneg : IsQuadraticallyNonnegative T)
    {μ : ℝ} (hμ : HasEigenvalue (T : Module.End 𝕜 E) (μ : 𝕜)) :
    0 ≤ μ :=
  eigenvalue_nonneg_of_nonneg hμ hnonneg

end Complete

/-! ## The exact arithmetic correction to Proposition 4.23 / Theorem A.7 -/

/-- An upper bound on the ground energy, together with a lower bound on the off-ground energy,
gives the advertised gap.  A lower bound on the ground energy has the wrong direction. -/
theorem gap_of_ground_upper_and_offGround_lower
    {ground offGround β margin : ℝ}
    (hground : ground ≤ β)
    (hoffGround : margin + β ≤ offGround) :
    margin ≤ offGround - ground := by
  linarith

theorem strict_gap_of_ground_upper_and_offGround_lower
    {ground offGround β margin : ℝ}
    (hmargin : 0 < margin)
    (hground : ground ≤ β)
    (hoffGround : margin + β ≤ offGround) :
    0 < offGround - ground :=
  lt_of_lt_of_le hmargin
    (gap_of_ground_upper_and_offGround_lower hground hoffGround)

/-- Concrete arithmetic countermodel: the two lower bounds printed in Proposition 4.23 do not by
themselves imply the claimed gap estimate. -/
theorem lower_bounds_alone_do_not_force_gap :
    ∃ (margin β ground offGround : ℝ),
      0 < margin ∧
      β ≤ ground ∧
      margin + β ≤ offGround ∧
      ¬ margin ≤ offGround - ground := by
  refine ⟨2, 0, 3, 4, by norm_num, by norm_num, by norm_num, ?_⟩
  norm_num

/-! ## Finite-dimensional spectral selection without assuming a gap -/

section FiniteDimensional

variable [FiniteDimensional 𝕜 E]
variable {T : E →L[𝕜] E}

/-- The finite set of distinct real eigenvalues obtained from Mathlib's multiplicity-retaining
finite-dimensional eigenvalue list. -/
def finiteRealLevels
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric) : Finset ℝ :=
  Finset.univ.image (hsymm.eigenvalues (n := Module.finrank 𝕜 E) rfl)

theorem mem_finiteRealLevels_iff
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric) (r : ℝ) :
    r ∈ finiteRealLevels hsymm ↔
      HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜) := by
  constructor
  · intro hr
    obtain ⟨i, _hi, hir⟩ := Finset.mem_image.mp hr
    have hi := hsymm.hasEigenvalue_eigenvalues
      (n := Module.finrank 𝕜 E) rfl i
    have hirK : ((hsymm.eigenvalues (n := Module.finrank 𝕜 E) rfl i : ℝ) : 𝕜) =
        (r : 𝕜) := by
      exact_mod_cast hir
    rw [hirK] at hi
    exact hi
  · intro hr
    obtain ⟨i, hi⟩ := hsymm.exists_eigenvalues_eq
      (n := Module.finrank 𝕜 E) rfl hr
    have hir : hsymm.eigenvalues (n := Module.finrank 𝕜 E) rfl i = r := by
      exact_mod_cast hi
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, hir⟩

/-- Mathlib's finite list retains algebraic multiplicity, exactly equal to eigenspace dimension for
self-adjoint operators. -/
theorem eigenvalue_multiplicity_count
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric) (r : ℝ) :
    Finset.card
        {i : Fin (Module.finrank 𝕜 E) |
          ((hsymm.eigenvalues (n := Module.finrank 𝕜 E) rfl i : ℝ) : 𝕜) =
            (r : 𝕜)} =
      Module.finrank 𝕜 (eigenspace (T : Module.End 𝕜 E) (r : 𝕜)) :=
  hsymm.card_filter_eigenvalues_eq
    (n := Module.finrank 𝕜 E) rfl (r : 𝕜)

/-- The strictly positive part of the finite real spectrum. -/
def positiveLevels
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric) : Finset ℝ :=
  (finiteRealLevels hsymm).filter (0 < ·)

/-- The least positive eigenvalue.  Its only input is nonemptiness of the positive spectral part,
not a numerical gap assumption. -/
def firstPositiveLevel
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hne : (positiveLevels hsymm).Nonempty) : ℝ :=
  (positiveLevels hsymm).min' hne

theorem firstPositiveLevel_mem
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hne : (positiveLevels hsymm).Nonempty) :
    firstPositiveLevel hsymm hne ∈ positiveLevels hsymm :=
  Finset.min'_mem (positiveLevels hsymm) hne

theorem firstPositiveLevel_pos
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hne : (positiveLevels hsymm).Nonempty) :
    0 < firstPositiveLevel hsymm hne :=
  (Finset.mem_filter.mp (firstPositiveLevel_mem hsymm hne)).2

theorem firstPositiveLevel_hasEigenvalue
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hne : (positiveLevels hsymm).Nonempty) :
    HasEigenvalue (T : Module.End 𝕜 E)
      ((firstPositiveLevel hsymm hne : ℝ) : 𝕜) := by
  apply (mem_finiteRealLevels_iff hsymm _).mp
  exact (Finset.mem_filter.mp (firstPositiveLevel_mem hsymm hne)).1

theorem firstPositiveLevel_le
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hne : (positiveLevels hsymm).Nonempty)
    {r : ℝ} (hrpos : 0 < r)
    (hr : HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜)) :
    firstPositiveLevel hsymm hne ≤ r := by
  apply Finset.min'_le
  exact Finset.mem_filter.mpr
    ⟨(mem_finiteRealLevels_iff hsymm r).mpr hr, hrpos⟩

/-- Existence of a positive eigenvalue produces, rather than assumes, a least positive eigenvalue. -/
theorem exists_least_positive_eigenvalue
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hexists : ∃ r : ℝ,
      0 < r ∧ HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜)) :
    ∃ gap : ℝ,
      0 < gap ∧
      HasEigenvalue (T : Module.End 𝕜 E) (gap : 𝕜) ∧
      ∀ r : ℝ,
        0 < r →
        HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜) →
        gap ≤ r := by
  obtain ⟨r, hrpos, hr⟩ := hexists
  have hne : (positiveLevels hsymm).Nonempty := by
    exact ⟨r, Finset.mem_filter.mpr
      ⟨(mem_finiteRealLevels_iff hsymm r).mpr hr, hrpos⟩⟩
  refine ⟨firstPositiveLevel hsymm hne,
    firstPositiveLevel_pos hsymm hne,
    firstPositiveLevel_hasEigenvalue hsymm hne, ?_⟩
  intro s hspos hs
  exact firstPositiveLevel_le hsymm hne hspos hs

/-- If the operator is nonnegative and zero is a ground eigenvalue, the finite-dimensional
spectrum has a genuine first off-ground level whenever any nonzero eigenvalue exists.  The zero
eigenspace may have arbitrary finite multiplicity. -/
theorem exists_first_offGround_gap
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    (hnonneg : IsQuadraticallyNonnegative T)
    (hzero : HasEigenvalue (T : Module.End 𝕜 E) 0)
    (hnonzero : ∃ r : ℝ,
      r ≠ 0 ∧ HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜)) :
    ∃ gap : ℝ,
      HasEigenvalue (T : Module.End 𝕜 E) 0 ∧
      0 < gap ∧
      HasEigenvalue (T : Module.End 𝕜 E) (gap : 𝕜) ∧
      ∀ r : ℝ,
        r ≠ 0 →
        HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜) →
        gap ≤ r := by
  obtain ⟨r, hrne, hr⟩ := hnonzero
  have hrnonneg : 0 ≤ r := eigenvalue_nonneg_of_nonneg hr hnonneg
  have hrpos : 0 < r := lt_of_le_of_ne hrnonneg (Ne.symm hrne)
  obtain ⟨gap, hgap, hgapEigen, hleast⟩ :=
    exists_least_positive_eigenvalue hsymm ⟨r, hrpos, hr⟩
  refine ⟨gap, hzero, hgap, hgapEigen, ?_⟩
  intro s hsne hs
  have hsnonneg : 0 ≤ s := eigenvalue_nonneg_of_nonneg hs hnonneg
  have hspos : 0 < s := lt_of_le_of_ne hsnonneg (Ne.symm hsne)
  exact hleast s hspos hs

end FiniteDimensional

/-! ## The missing nonzero-accumulation supplier -/

/-- Transparent supplier for the standard compact-operator fact not currently packaged by
Mathlib: for every radius `r > 0`, only finitely many eigenvalues have norm at least `r`. -/
structure AwayFromZeroPointSpectrumFinite (T : E →L[𝕜] E) : Prop where
  finite_away_from_zero :
    ∀ r : ℝ, 0 < r →
      Set.Finite
        {μ : 𝕜 |
          HasEigenvalue (T : Module.End 𝕜 E) μ ∧ r ≤ ‖μ‖}

theorem finite_pointSpectrum_away_from_zero
    {T : E →L[𝕜] E}
    (h : AwayFromZeroPointSpectrumFinite T)
    {r : ℝ} (hr : 0 < r) :
    Set.Finite
      {μ : 𝕜 |
        HasEigenvalue (T : Module.End 𝕜 E) μ ∧ r ≤ ‖μ‖} :=
  h.finite_away_from_zero r hr

/-! ## Compactness obstruction to a uniform lower bound -/

section CompactNoGo

variable [CompleteSpace E]
variable {T : E →L[𝕜] E}

theorem antilipschitz_of_normLowerBound
    {c : ℝ} (hc : 0 < c) (hlower : HasNormLowerBound T c) :
    AntilipschitzWith ⟨c⁻¹, inv_nonneg.mpr hc.le⟩ T := by
  apply AntilipschitzWith.of_le_mul_dist
  intro x y
  change dist x y ≤ c⁻¹ * dist (T x) (T y)
  simp only [dist_eq_norm_sub, ← map_sub]
  calc
    ‖x - y‖ = c⁻¹ * (c * ‖x - y‖) := by
      rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
    _ ≤ c⁻¹ * ‖T (x - y)‖ :=
      mul_le_mul_of_nonneg_left (hlower (x - y)) (inv_nonneg.mpr hc.le)

/-- A compact operator with a positive norm lower bound has finite-dimensional domain. -/
theorem finiteDimensional_of_compact_normLowerBound
    (hcompact : IsCompactOperator T)
    {c : ℝ} (hc : 0 < c) (hlower : HasNormLowerBound T c) :
    FiniteDimensional 𝕜 E := by
  have hanti := antilipschitz_of_normLowerBound hc hlower
  have hemb : Topology.IsClosedEmbedding T :=
    hanti.isClosedEmbedding T.uniformContinuous
  obtain ⟨K, hKcompact, hsubset⟩ :=
    hcompact.image_closedBall_subset_compact 1
  have himageClosed : IsClosed (T '' Metric.closedBall (0 : E) 1) :=
    hemb.isClosedMap _ Metric.isClosed_closedBall
  have himageCompact : IsCompact (T '' Metric.closedBall (0 : E) 1) :=
    hKcompact.of_isClosed_subset himageClosed hsubset
  have hballCompact : IsCompact (Metric.closedBall (0 : E) 1) :=
    hemb.isEmbedding.isCompact_iff.mpr himageCompact
  exact FiniteDimensional.of_isCompact_closedBall 𝕜 zero_lt_one hballCompact

/-- On a genuinely infinite-dimensional complete space, no compact operator is bounded below by
a positive norm constant. -/
theorem compact_infiniteDimensional_no_positive_normLowerBound
    (hinfinite : ¬ FiniteDimensional 𝕜 E)
    (hcompact : IsCompactOperator T) :
    ¬ ∃ c : ℝ, 0 < c ∧ HasNormLowerBound T c := by
  rintro ⟨c, hc, hlower⟩
  exact hinfinite
    (finiteDimensional_of_compact_normLowerBound hcompact hc hlower)

/-- For an injective operator, ground-complement quadratic coercivity is a global norm lower
bound. -/
theorem normLowerBound_of_injective_groundComplementCoercivity
    (hinjective : Function.Injective T)
    {c : ℝ} (hc : 0 < c)
    (hcoercive : HasGroundComplementCoercivity T c) :
    HasNormLowerBound T c := by
  intro x
  by_cases hx : x = 0
  · subst x
    simp
  · have hker : LinearMap.ker (T : Module.End 𝕜 E) = ⊥ :=
      LinearMap.ker_eq_bot.mpr hinjective
    have hground : groundSpace T = ⊥ := by
      rw [groundSpace_eq_ker, hker]
    have hxorth : x ∈ (groundSpace T)ᗮ := by
      rw [hground, Submodule.bot_orthogonal_eq_top]
      exact Submodule.mem_top
    have hquad := hcoercive x hxorth
    have hcs := re_inner_le_norm (𝕜 := 𝕜) x (T x)
    have hxnorm : 0 < ‖x‖ := norm_pos_iff.mpr hx
    have hmul : ‖x‖ * (c * ‖x‖) ≤ ‖x‖ * ‖T x‖ := by
      calc
        ‖x‖ * (c * ‖x‖) = c * ‖x‖ ^ 2 := by ring
        _ ≤ RCLike.re ⟪x, T x⟫ := hquad
        _ ≤ ‖x‖ * ‖T x‖ := hcs
    by_contra hnot
    have hlt : ‖T x‖ < c * ‖x‖ := lt_of_not_ge hnot
    have hmul_lt : ‖x‖ * ‖T x‖ < ‖x‖ * (c * ‖x‖) :=
      mul_lt_mul_of_pos_left hlt hxnorm
    exact (not_lt_of_ge hmul) hmul_lt

/-- Consequently, an injective compact operator on an infinite-dimensional complete space cannot
carry a positive ground-complement coercivity constant.  This is the operator-level reason that
pointwise positivity by itself is not a mass-gap proof. -/
theorem compact_infiniteDimensional_injective_no_groundComplementCoercivity
    (hinfinite : ¬ FiniteDimensional 𝕜 E)
    (hcompact : IsCompactOperator T)
    (hinjective : Function.Injective T) :
    ¬ ∃ c : ℝ, 0 < c ∧ HasGroundComplementCoercivity T c := by
  rintro ⟨c, hc, hcoercive⟩
  apply compact_infiniteDimensional_no_positive_normLowerBound
    hinfinite hcompact
  exact ⟨c, hc,
    normLowerBound_of_injective_groundComplementCoercivity
      hinjective hc hcoercive⟩

end CompactNoGo

/-! ## Pointwise positivity is not a uniform spectral gap -/

/-- A strictly positive scalar spectral family converging to zero. -/
def reciprocalPositiveLevel (n : ℕ) : ℝ :=
  1 / (n + 1 : ℝ)

theorem reciprocalPositiveLevel_pos (n : ℕ) :
    0 < reciprocalPositiveLevel n := by
  unfold reciprocalPositiveLevel
  positivity

/-- Strict positivity of every displayed level does not imply a single positive lower bound. -/
theorem pointwise_positivity_does_not_imply_uniform_gap :
    (∀ n : ℕ, 0 < reciprocalPositiveLevel n) ∧
      ¬ ∃ c : ℝ, 0 < c ∧ ∀ n : ℕ, c ≤ reciprocalPositiveLevel n := by
  refine ⟨reciprocalPositiveLevel_pos, ?_⟩
  rintro ⟨c, hc, hbound⟩
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hc
  exact (not_le_of_gt hn) (by simpa [reciprocalPositiveLevel] using hbound n)

/-! ## A concrete positive compact self-adjoint family with arbitrarily small eigenvalue -/

/-- Scalar multiplication by `a` on the one-dimensional real Hilbert space. -/
def smallPositiveOperator (a : ℝ) : ℝ →L[ℝ] ℝ :=
  a • ContinuousLinearMap.id ℝ ℝ

@[simp]
theorem smallPositiveOperator_apply (a x : ℝ) :
    smallPositiveOperator a x = a • x := by
  simp [smallPositiveOperator]

theorem smallPositiveOperator_symmetric (a : ℝ) :
    (smallPositiveOperator a : ℝ →ₗ[ℝ] ℝ).IsSymmetric := by
  intro x y
  simp [smallPositiveOperator, real_inner_smul_left, real_inner_smul_right]
  ring

theorem smallPositiveOperator_selfAdjoint (a : ℝ) :
    IsSelfAdjoint (smallPositiveOperator a) :=
  (smallPositiveOperator_symmetric a).isSelfAdjoint

theorem smallPositiveOperator_compact (a : ℝ) :
    IsCompactOperator (smallPositiveOperator a) :=
  isCompactOperator_of_locallyCompactSpace_dom (smallPositiveOperator a)

theorem smallPositiveOperator_nonnegative {a : ℝ} (ha : 0 ≤ a) :
    IsQuadraticallyNonnegative (smallPositiveOperator a) := by
  intro x
  rw [smallPositiveOperator_apply, real_inner_smul_self_right]
  exact mul_nonneg ha (mul_self_nonneg ‖x‖)

theorem smallPositiveOperator_positive {a : ℝ} (ha : 0 < a) :
    IsQuadraticallyPositive (smallPositiveOperator a) := by
  intro x hx
  rw [smallPositiveOperator_apply, real_inner_smul_self_right]
  exact mul_pos ha (mul_self_pos.mpr (norm_ne_zero_iff.mpr hx))

theorem smallPositiveOperator_hasEigenvector (a : ℝ) :
    HasEigenvector
      (smallPositiveOperator a : Module.End ℝ ℝ) a (1 : ℝ) := by
  refine ⟨?_, one_ne_zero⟩
  rw [mem_eigenspace_iff]
  simp

theorem smallPositiveOperator_hasEigenvalue (a : ℝ) :
    HasEigenvalue (smallPositiveOperator a : Module.End ℝ ℝ) a :=
  hasEigenvalue_of_hasEigenvector (smallPositiveOperator_hasEigenvector a)

/-- Even strict quadratic positivity, compactness, and self-adjointness do not select any
operator-independent positive gap: below every prescribed `c > 0` there is an actual positive
compact self-adjoint operator with a positive eigenvalue smaller than `c`. -/
theorem positivity_does_not_force_prescribed_gap :
    ∀ c : ℝ, 0 < c →
      ∃ (T : ℝ →L[ℝ] ℝ) (μ : ℝ),
        IsCompactOperator T ∧
        IsSelfAdjoint T ∧
        IsQuadraticallyPositive T ∧
        0 < μ ∧ μ < c ∧
        HasEigenvalue (T : Module.End ℝ ℝ) μ := by
  intro c hc
  refine ⟨smallPositiveOperator (c / 2), c / 2,
    smallPositiveOperator_compact (c / 2),
    smallPositiveOperator_selfAdjoint (c / 2),
    smallPositiveOperator_positive (half_pos hc),
    half_pos hc, half_lt_self hc,
    smallPositiveOperator_hasEigenvalue (c / 2)⟩

end QYM.CompactSelfAdjointGapExtension

/-!
# Paper-normalized compact self-adjoint and corrected gap statements

These wrappers distinguish three logically different claims around Proposition 4.23 and Appendix
Theorem A.7:

1. actual compact self-adjoint spectral resolution and finite nonzero multiplicity;
2. a multiplicity-safe off-ground bound obtained from coercivity of the shifted operator on the
   orthogonal complement of its complete ground eigenspace;
3. the arithmetic defect in the printed inference: lower bounds for both the ground and excited
   levels do not bound their difference.  An upper bound on the ground level, or equivalently a
   coercive estimate for the shifted operator, is required.

The finite-dimensional wrapper constructs the first positive eigenvalue from Mathlib's finite
spectral list.  Thus it does not assume the desired gap.  The uniform-family wrapper is the
operator-level input for Corollary 4.25; passage to `liminf` remains the independent order-theoretic
step already formalized elsewhere.
-/

open Module End Set

namespace QYM.FullCertification.PaperNormalized

/-! ## Proposition 4.23: actual compact self-adjoint spectral data -/

def prop4_23_compactSelfAdjointSpectralPackageStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →L[𝕜] E),
    IsCompactOperator T →
    IsSelfAdjoint T →
      (⨆ μ : 𝕜, eigenspace (T : Module.End 𝕜 E) μ)ᗮ = ⊥ ∧
        ∀ μ : 𝕜, μ ≠ 0 →
          FiniteDimensional 𝕜 (eigenspace (T : Module.End 𝕜 E) μ)

theorem prop4_23_compactSelfAdjointSpectralPackageStatement_holds :
    prop4_23_compactSelfAdjointSpectralPackageStatement := by
  intro 𝕜 E _ _ _ _ T hcompact hself
  exact
    QYM.CompactSelfAdjointGapExtension.compact_selfAdjoint_spectral_package
      hcompact hself

/-! ## Proposition 4.23: corrected multiplicity-safe gap -/

def prop4_23_groundComplementCoerciveGapStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →L[𝕜] E) (c μ : ℝ) (x : E),
    IsSelfAdjoint T →
    QYM.CompactSelfAdjointGapExtension.HasGroundComplementCoercivity T c →
    0 < c →
    μ ≠ 0 →
    HasEigenvector (T : Module.End 𝕜 E) (μ : 𝕜) x →
      c ≤ μ ∧ 0 < μ

theorem prop4_23_groundComplementCoerciveGapStatement_holds :
    prop4_23_groundComplementCoerciveGapStatement := by
  intro 𝕜 E _ _ _ _ T c μ x hself hcoercive hc hμ hx
  have hge :=
    QYM.CompactSelfAdjointGapExtension.real_eigenvalue_ge_of_groundComplementCoercivity
      hself.isSymmetric hcoercive hμ hx
  exact ⟨hge, lt_of_lt_of_le hc hge⟩

/-! ## Proposition 4.23: finite-dimensional first off-ground level -/

def prop4_23_finiteDimensionalFirstOffGroundStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
      [FiniteDimensional 𝕜 E]
      (T : E →L[𝕜] E),
    (T : Module.End 𝕜 E).IsSymmetric →
    QYM.CompactSelfAdjointGapExtension.IsQuadraticallyNonnegative T →
    HasEigenvalue (T : Module.End 𝕜 E) 0 →
    (∃ r : ℝ,
      r ≠ 0 ∧ HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜)) →
      ∃ gap : ℝ,
        HasEigenvalue (T : Module.End 𝕜 E) 0 ∧
        0 < gap ∧
        HasEigenvalue (T : Module.End 𝕜 E) (gap : 𝕜) ∧
        ∀ r : ℝ,
          r ≠ 0 →
          HasEigenvalue (T : Module.End 𝕜 E) (r : 𝕜) →
          gap ≤ r

theorem prop4_23_finiteDimensionalFirstOffGroundStatement_holds :
    prop4_23_finiteDimensionalFirstOffGroundStatement := by
  intro 𝕜 E _ _ _ _ T hsymm hnonneg hzero hnonzero
  exact
    QYM.CompactSelfAdjointGapExtension.exists_first_offGround_gap
      hsymm hnonneg hzero hnonzero

/-! ## Proposition 4.23: the printed lower-bound inference is invalid -/

def prop4_23_lowerBoundsAloneNoGoStatement : Prop :=
  ∃ (margin β ground offGround : ℝ),
    0 < margin ∧
    β ≤ ground ∧
    margin + β ≤ offGround ∧
    ¬ margin ≤ offGround - ground

theorem prop4_23_lowerBoundsAloneNoGoStatement_holds :
    prop4_23_lowerBoundsAloneNoGoStatement :=
  QYM.CompactSelfAdjointGapExtension.lower_bounds_alone_do_not_force_gap

def prop4_23_correctedGroundUpperBoundStatement : Prop :=
  ∀ {margin β ground offGround : ℝ},
    ground ≤ β →
    margin + β ≤ offGround →
      margin ≤ offGround - ground

theorem prop4_23_correctedGroundUpperBoundStatement_holds :
    prop4_23_correctedGroundUpperBoundStatement := by
  intro margin β ground offGround hground hoffGround
  exact
    QYM.CompactSelfAdjointGapExtension.gap_of_ground_upper_and_offGround_lower
      hground hoffGround

/-! ## Compact infinite-dimensional boundary -/

def prop4_23_compactInjectiveGroundGapNoGoStatement : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →L[𝕜] E),
    (¬ FiniteDimensional 𝕜 E) →
    IsCompactOperator T →
    Function.Injective T →
      ¬ ∃ c : ℝ,
        0 < c ∧
        QYM.CompactSelfAdjointGapExtension.HasGroundComplementCoercivity T c

theorem prop4_23_compactInjectiveGroundGapNoGoStatement_holds :
    prop4_23_compactInjectiveGroundGapNoGoStatement := by
  intro 𝕜 E _ _ _ _ T hinfinite hcompact hinjective
  exact
    QYM.CompactSelfAdjointGapExtension.compact_infiniteDimensional_injective_no_groundComplementCoercivity
      hinfinite hcompact hinjective

/-! ## Positivity alone does not supply a quantitative gap -/

def prop4_23_positivityNoPrescribedGapStatement : Prop :=
  ∀ c : ℝ, 0 < c →
    ∃ (T : ℝ →L[ℝ] ℝ) (μ : ℝ),
      IsCompactOperator T ∧
      IsSelfAdjoint T ∧
      QYM.CompactSelfAdjointGapExtension.IsQuadraticallyPositive T ∧
      0 < μ ∧ μ < c ∧
      HasEigenvalue (T : Module.End ℝ ℝ) μ

theorem prop4_23_positivityNoPrescribedGapStatement_holds :
    prop4_23_positivityNoPrescribedGapStatement :=
  QYM.CompactSelfAdjointGapExtension.positivity_does_not_force_prescribed_gap

def prop4_23_pointwisePositiveSequenceNoGapStatement : Prop :=
  (∀ n : ℕ,
      0 < QYM.CompactSelfAdjointGapExtension.reciprocalPositiveLevel n) ∧
    ¬ ∃ c : ℝ, 0 < c ∧
      ∀ n : ℕ,
        c ≤ QYM.CompactSelfAdjointGapExtension.reciprocalPositiveLevel n

theorem prop4_23_pointwisePositiveSequenceNoGapStatement_holds :
    prop4_23_pointwisePositiveSequenceNoGapStatement :=
  QYM.CompactSelfAdjointGapExtension.pointwise_positivity_does_not_imply_uniform_gap

/-! ## Appendix Theorem A.7 aliases the same corrected boundary -/

def theoremA_7_groundComplementCoerciveGapStatement : Prop :=
  prop4_23_groundComplementCoerciveGapStatement.{0, 0}

theorem theoremA_7_groundComplementCoerciveGapStatement_holds :
    theoremA_7_groundComplementCoerciveGapStatement :=
  prop4_23_groundComplementCoerciveGapStatement_holds

def theoremA_7_lowerBoundsAloneNoGoStatement : Prop :=
  prop4_23_lowerBoundsAloneNoGoStatement

theorem theoremA_7_lowerBoundsAloneNoGoStatement_holds :
    theoremA_7_lowerBoundsAloneNoGoStatement :=
  prop4_23_lowerBoundsAloneNoGoStatement_holds

def theoremA_7_correctedGroundUpperBoundStatement : Prop :=
  prop4_23_correctedGroundUpperBoundStatement

theorem theoremA_7_correctedGroundUpperBoundStatement_holds :
    theoremA_7_correctedGroundUpperBoundStatement :=
  prop4_23_correctedGroundUpperBoundStatement_holds

/-! ## Corollary 4.25: uniform operator-level input before the liminf step -/

def cor4_25_uniformGroundComplementGapStatement : Prop :=
  ∀ (Y 𝕜 E : Type*) [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : Y → E →L[𝕜] E) (c : ℝ)
      (μ : Y → ℝ) (x : Y → E),
    0 < c →
    (∀ y, IsSelfAdjoint (T y)) →
    (∀ y,
      QYM.CompactSelfAdjointGapExtension.HasGroundComplementCoercivity
        (T y) c) →
    (∀ y, μ y ≠ 0) →
    (∀ y,
      HasEigenvector (T y : Module.End 𝕜 E) (μ y : 𝕜) (x y)) →
      ∀ y, c ≤ μ y ∧ 0 < μ y

theorem cor4_25_uniformGroundComplementGapStatement_holds :
    cor4_25_uniformGroundComplementGapStatement := by
  intro Y 𝕜 E _ _ _ _ T c μ x hc hself hcoercive hμ heigen y
  have hge :=
    QYM.CompactSelfAdjointGapExtension.real_eigenvalue_ge_of_groundComplementCoercivity
      (hself y).isSymmetric (hcoercive y) (hμ y) (heigen y)
  exact ⟨hge, lt_of_lt_of_le hc hge⟩

end QYM.FullCertification.PaperNormalized

