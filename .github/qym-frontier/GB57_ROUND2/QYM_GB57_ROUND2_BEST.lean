/-! ## Proof-carrying certificates and exhaustive enumeration -/

/-- A dependent evidence object retaining the exact proposition proved by its identifier. -/
structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement id

/-- Canonical proof-carrying certificate for one identifier. -/
def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

/-- Complete source-ordered list of the twenty-three identifiers. -/
def allEvidence : List EvidenceId :=
  [.prop2_2Locality,
   .axiomA3MMassCoercivityNoGo,
   .axiomA3VAbsorptionNoGo,
   .axiomA3RTailUniformityNoGo,
   .axiomA3TScalarInvarianceNoGo,
   .lemma3_3InvariantEnergy,
   .def3_1AdmissibleSubtype,
   .assumption3_5ActionDefinedness,
   .assumption3_6CoercivitySuppliers,
   .assumption3_8CuspTrace,
   .def4_1AdmissibleVariation,
   .axiom4_4CuspIBP,
   .cor4_7StructuralSkew,
   .assumption4_8SobolevBilinear,
   .lemma4_13ClosedGraphAndForm,
