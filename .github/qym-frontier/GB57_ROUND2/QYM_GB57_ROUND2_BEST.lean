/-! ## 2. Unconditional closure of the genuine eta derivative graph -/

/-- The scalar coordinate of the closed actual eta-derivative graph. -/
noncomputable def etaClosedGraphBaseCoordinate (Y : ℝ) :
    QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y →L[ℂ]
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y :=
  (WithLp.fstL 2 ℂ
      (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y)
      (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y)).comp
    (Submodule.subtypeL
      ((QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphRange Y).topologicalClosure))

/-- The genuine `eta^-1 dg` coordinate of the closed graph Hilbert space.
This map is bounded because the graph norm contains the derivative norm.  It
is not claimed to be bounded in the ambient scalar `L2` norm. -/
noncomputable def etaClosedGraphDerivativeCoordinate (Y : ℝ) :
    QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y →L[ℂ]
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y :=
  (WithLp.sndL 2 ℂ
      (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y)
      (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y)).comp
    (Submodule.subtypeL
      ((QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphRange Y).topologicalClosure))

@[simp]
theorem etaClosedGraphBaseCoordinate_apply
    (Y : ℝ) (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y) :
    etaClosedGraphBaseCoordinate Y u =
      (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).fst := by
  rfl

@[simp]
theorem etaClosedGraphDerivativeCoordinate_apply
    (Y : ℝ) (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y) :
    etaClosedGraphDerivativeCoordinate Y u =
      (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).snd := by
  rfl

/-- The original smooth eta core surjects onto its algebraic graph range. -/
noncomputable def etaH1CoreGraphRangeMap (Y : ℝ) :
    QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y →ₗ[ℂ] QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphCoreImage Y :=
  (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphMap Y).rangeRestrict

theorem etaH1CoreGraphRangeMap_surjective (Y : ℝ) :
    Function.Surjective (etaH1CoreGraphRangeMap Y) := by
  rintro ⟨x, g, rfl⟩
  exact ⟨g, rfl⟩

/-- Canonical dense map from the genuine smooth eta core into its closed
two-coordinate graph. -/
noncomputable def etaH1CoreToClosedGraph (Y : ℝ) :
    QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y →ₗ[ℂ] QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y :=
  (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphCoreImageInclusion Y).toLinearMap.comp
    (etaH1CoreGraphRangeMap Y)

theorem etaH1CoreToClosedGraph_denseRange (Y : ℝ) :
    DenseRange (etaH1CoreToClosedGraph Y) := by
  have hs : DenseRange (etaH1CoreGraphRangeMap Y) :=
    (etaH1CoreGraphRangeMap_surjective Y).denseRange
  have hc :=
    (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphCoreImageInclusion_denseRange Y).comp
      hs (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1GraphCoreImageInclusion Y).continuous
  simpa [etaH1CoreToClosedGraph, Function.comp_def] using hc

/-- On the genuine smooth core, the base coordinate is exactly the actual
inverse-eta section's restricted-measure `L2` class. -/
@[simp]
theorem etaClosedGraphBaseCoordinate_core
    (Y : ℝ) (g : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y) :
    etaClosedGraphBaseCoordinate Y (etaH1CoreToClosedGraph Y g) =
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1CoreScalarToL2 Y g := by
  rfl

/-- On the same core, the derivative coordinate is exactly the `L2` class of
the genuine manifold derivative `eta^-1 dg`. -/
@[simp]
theorem etaClosedGraphDerivativeCoordinate_core
    (Y : ℝ) (g : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y) :
    etaClosedGraphDerivativeCoordinate Y (etaH1CoreToClosedGraph Y g) =
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1CoreOneFormToL2 Y g := by
  rfl

/-- Pointwise identification with the genuine bundle-valued eta covariant
derivative.  Thus the graph coordinate is not a fresh formal symbol: on the
smooth core it is evaluation at `1` of
`etaCovariantDerivativeLinear (g / eta)`. -/
theorem etaGaugeOneFormCoefficient_eq_etaCovariantDerivative
    (Y : ℝ) (g : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y) (tau : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.H) :
    QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaGaugeOneFormCoefficient g.1 tau =
      (QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaCovariantDerivativeLinear
        (QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaSectionLinear g.1)).1 tau 1 := by
  change QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaGaugeDifferential g.1 tau 1 =
    (QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaCovariantDerivativeLinear
      (QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaSectionLinear g.1)).1 tau 1
  exact (congrArg
    (fun A : QYM.Mock2EtaCovariantDerivativeExtension.Geometry.EtaTwistedOneForm => A.1 tau 1)
    (QYM.Mock2EtaCovariantDerivativeExtension.Geometry.etaCovariantDerivative_etaSection g.1)).symm

/-- The closed derivative coordinate has the literal eta-gauge manifold
derivative coefficient as an almost-everywhere representative on every
smooth core vector. -/
theorem etaClosedGraphDerivativeCoordinate_core_ae
    (Y : ℝ) (g : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1Core Y) :
    ((etaClosedGraphDerivativeCoordinate Y
        (etaH1CoreToClosedGraph Y g) :
          QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y) :
        QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.H → ℂ) =ᵐ[QYM.FullCertification.Mock2EtaPeterssonCarrierExtension.truncatedHyperbolicMeasure Y]
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaGaugeOneFormCoefficient g.1 := by
  rw [etaClosedGraphDerivativeCoordinate_core]
  exact QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.etaH1CoreOneFormToL2_coeFn_ae Y g

/-- The two coordinates together remain injective: the graph completion is
an honest closed subspace of `L2 + L2`, even before single-valuedness over the
first coordinate is proved. -/
theorem etaClosedGraphCoordinates_injective (Y : ℝ) :
    Function.Injective
      (fun u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y =>
        (etaClosedGraphBaseCoordinate Y u,
          etaClosedGraphDerivativeCoordinate Y u)) := by
  intro u v huv
  have hBase := congrArg Prod.fst huv
  have hDerivative := congrArg Prod.snd huv
  change (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).fst =
    (v : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).fst at hBase
  change (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).snd =
    (v : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1GraphAmbient Y).snd at hDerivative
  apply Subtype.ext
  apply WithLp.ofLp_injective 2
  exact Prod.ext hBase hDerivative

/-- Exact, intentionally unresolved single-valuedness predicate.  It says
that the closed eta graph is the graph of an operator over its scalar `L2`
coordinate.  Merely knowing that the graph subspace itself is closed does not
prove this injectivity. -/
def EtaClosedGraphIsSingleValuedOverL2 (Y : ℝ) : Prop :=
  Function.Injective (etaClosedGraphBaseCoordinate Y)

theorem etaClosedGraphIsSingleValuedOverL2_iff_verticalKernel_eq_bot
    (Y : ℝ) :
    EtaClosedGraphIsSingleValuedOverL2 Y ↔
      LinearMap.ker (etaClosedGraphBaseCoordinate Y).toLinearMap = ⊥ := by
  change Function.Injective
      (etaClosedGraphBaseCoordinate Y).toLinearMap ↔ _
  exact LinearMap.ker_eq_bot.symm

/-- Failure of single-valuedness is exactly a nonzero vertical graph vector:
zero scalar `L2` coordinate but nonzero eta-derivative coordinate. -/
theorem not_etaClosedGraphIsSingleValuedOverL2_iff_exists_vertical
    (Y : ℝ) :
    ¬ EtaClosedGraphIsSingleValuedOverL2 Y ↔
      ∃ u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y,
        etaClosedGraphBaseCoordinate Y u = 0 ∧
          etaClosedGraphDerivativeCoordinate Y u ≠ 0 := by
  constructor
  · intro hNotSingle
    by_contra hNoVertical
    apply hNotSingle
    show Function.Injective (etaClosedGraphBaseCoordinate Y)
    intro u v hBase
    have hBaseZero :
        etaClosedGraphBaseCoordinate Y (u - v) = 0 := by
      rw [map_sub, hBase, sub_self]
    have hDerivativeZero :
        etaClosedGraphDerivativeCoordinate Y (u - v) = 0 := by
      by_contra hDerivativeNe
      exact hNoVertical ⟨u - v, hBaseZero, hDerivativeNe⟩
    apply etaClosedGraphCoordinates_injective Y
    apply Prod.ext
    · exact hBase
    · have hSub :
          etaClosedGraphDerivativeCoordinate Y u -
              etaClosedGraphDerivativeCoordinate Y v = 0 := by
        simpa only [map_sub] using hDerivativeZero
      exact sub_eq_zero.mp hSub
  · rintro ⟨u, hBase, hDerivative⟩ hSingle
    change Function.Injective (etaClosedGraphBaseCoordinate Y) at hSingle
    have hu : u = 0 := hSingle (by simpa using hBase)
    apply hDerivative
    rw [hu]
    exact map_zero _

/-- Set-theoretic graph of the bounded derivative coordinate on the graph
Hilbert source. -/
def etaClosedGraphDerivativeCoordinateGraph (Y : ℝ) :
    Set (QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y ×
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y) :=
  {p | etaClosedGraphDerivativeCoordinate Y p.1 = p.2}

/-- The derivative coordinate is an unconditional closed operator on the
*graph Hilbert space*.  This is not an assertion that it is already a
single-valued unbounded operator on ambient scalar `L2`. -/
theorem etaClosedGraphDerivativeCoordinate_graph_isClosed (Y : ℝ) :
    IsClosed (etaClosedGraphDerivativeCoordinateGraph Y) := by
  unfold etaClosedGraphDerivativeCoordinateGraph
  exact isClosed_eq
    ((etaClosedGraphDerivativeCoordinate Y).continuous.comp continuous_fst)
    continuous_snd

/-- A vertical vector forbids even a set-theoretic ambient-`L2` operator from
representing every pair in the closed eta relation. -/
theorem verticalVector_forbids_ambientL2_operator
    (Y : ℝ) (u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y)
    (hBase : etaClosedGraphBaseCoordinate Y u = 0)
    (hDerivative : etaClosedGraphDerivativeCoordinate Y u ≠ 0) :
    ¬ ∃ T : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y →
        QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y,
      ∀ z : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y,
        T (etaClosedGraphBaseCoordinate Y z) =
          etaClosedGraphDerivativeCoordinate Y z := by
  rintro ⟨T, hT⟩
  have hu := hT u
  rw [hBase] at hu
  have hzero : T 0 = 0 := by
    simpa using hT (0 : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y)
  exact hDerivative (hu.symm.trans hzero)

/-- Consequently, failure of the exact injectivity residual rules out any
ambient scalar-`L2` operator whose graph contains the entire closed eta
relation. -/
theorem not_singleValued_forbids_ambientL2_operator
    (Y : ℝ) (hNotSingle : ¬ EtaClosedGraphIsSingleValuedOverL2 Y) :
    ¬ ∃ T : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y →
        QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y,
      ∀ z : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y,
        T (etaClosedGraphBaseCoordinate Y z) =
          etaClosedGraphDerivativeCoordinate Y z := by
  rcases
      (not_etaClosedGraphIsSingleValuedOverL2_iff_exists_vertical Y).mp
        hNotSingle with
    ⟨u, hBase, hDerivative⟩
  exact verticalVector_forbids_ambientL2_operator
    Y u hBase hDerivative

/-- Conversely, any function representing the full closed relation forces
the scalar projection to be injective.  Thus the displayed residual is a
necessary theorem, not optional packaging. -/
theorem ambientL2_operator_implies_singleValued
    (Y : ℝ)
    (T : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaScalarL2 Y →
      QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.TruncatedEtaOneFormL2 Y)
    (hT : ∀ z : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y,
      T (etaClosedGraphBaseCoordinate Y z) =
        etaClosedGraphDerivativeCoordinate Y z) :
    EtaClosedGraphIsSingleValuedOverL2 Y := by
  show Function.Injective (etaClosedGraphBaseCoordinate Y)
  intro u v hBase
  apply etaClosedGraphCoordinates_injective Y
  apply Prod.ext
  · exact hBase
  · change etaClosedGraphDerivativeCoordinate Y u =
      etaClosedGraphDerivativeCoordinate Y v
    calc
      etaClosedGraphDerivativeCoordinate Y u =
          T (etaClosedGraphBaseCoordinate Y u) := (hT u).symm
      _ = T (etaClosedGraphBaseCoordinate Y v) := congrArg T hBase
      _ = etaClosedGraphDerivativeCoordinate Y v := hT v

/-! ## 3. Exact aggregate boundaries -/

/-- Unconditional certificate for everything that is actually closed in
items 2--3 without installing the missing curvilinear theorem as data. -/
theorem etaClosedRelationAndStokesBoundaryCertificate :
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.GammaTwoCompactFluxStokes ↔
      QYM.FullCertification.P2GreenBoundaryStokesReductionExtension.ActualHighCutoffDivergenceBoundaryEqualityResidual) ∧
    (∀ Y : ℝ, DenseRange (etaH1CoreToClosedGraph Y)) ∧
    (∀ Y : ℝ, IsClosed (etaClosedGraphDerivativeCoordinateGraph Y)) ∧
    (∀ Y : ℝ,
      (¬ EtaClosedGraphIsSingleValuedOverL2 Y ↔
        ∃ u : QYM.FullCertification.Mock2EtaH1GraphCompletionExtension.EtaH1Completion Y,
          etaClosedGraphBaseCoordinate Y u = 0 ∧
            etaClosedGraphDerivativeCoordinate Y u ≠ 0)) := by
  exact ⟨gammaTwoCompactFluxStokes_iff_actualHighCutoffBoundaryEqualityResidual,
    etaH1CoreToClosedGraph_denseRange,
    etaClosedGraphDerivativeCoordinate_graph_isClosed,
    not_etaClosedGraphIsSingleValuedOverL2_iff_exists_vertical⟩

/-- Once the one explicit curvilinear theorem is later proved, the existing
dense physical tower immediately yields Green identities, closable
raising/lowering/joint operators, and closed canonical graph closures.  The
preceding Stokes theorem gives the exact `iff`; this theorem records the
operator-theoretic forward implication and does not claim that the residual
has already been inhabited. -/
theorem actualHighCutoffResidual_closes_fixedPhaseTower
    (hResidual :
      QYM.FullCertification.P2GreenBoundaryStokesReductionExtension.ActualHighCutoffDivergenceBoundaryEqualityResidual) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.PhysicalGreenIdentity ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.physicalRaise n).IsClosable) ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.physicalLowerFromSucc n).IsClosable) ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.physicalJointFromSucc n).IsClosable) ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.closedRaise n).IsClosed) ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.closedLowerFromSucc n).IsClosed) ∧
      (∀ n : ℤ, (Mock2FA.PaperCorrections.AutomorphicSobolev.FixedPhaseClosedOperators.closedJointFromSucc n).IsClosed) := by
  exact
    ⟨physicalGreenIdentity_of_actualHighCutoffBoundaryEqualityResidual hResidual,
      physicalRaise_isClosable_of_actualHighCutoffBoundaryEqualityResidual
        hResidual,
      physicalLowerFromSucc_isClosable_of_actualHighCutoffBoundaryEqualityResidual
        hResidual,
      physicalJointFromSucc_isClosable_of_actualHighCutoffBoundaryEqualityResidual
        hResidual,
      closedRaise_isClosed_of_actualHighCutoffBoundaryEqualityResidual
        hResidual,
      closedLowerFromSucc_isClosed_of_actualHighCutoffBoundaryEqualityResidual
        hResidual,
      closedJointFromSucc_isClosed_of_actualHighCutoffBoundaryEqualityResidual
        hResidual⟩

