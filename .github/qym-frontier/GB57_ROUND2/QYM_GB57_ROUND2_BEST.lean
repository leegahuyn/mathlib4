/-!
# P2 concrete cusp geometry and intrinsic compact quotient stages

The following two audited producer bodies connect the explicit effective
`Gamma(2)` geometry to QYM and then construct the intrinsic compact stages
`X_Y`.  They deliberately distinguish selected-carrier compactness from the
false stronger full-preimage assertion, and quotient topology from the still
unconstructed smooth quotient atlas.
-/

open Function Set Topology
open MeasureTheory
open scoped MatrixGroups UpperHalfPlane

namespace QYM.FullCertification.P2ConcreteCuspGeometryExtension

/-!
# P2.1--P2.2 concrete `Gamma(2)` cusp-geometry facade

This file is deliberately a thin facade over the unconditional geometry in
`Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry` and the
proved compact-flux tail theorem in
`GammaTwoQuotientGreenBoundary`.  It does not replace those proofs by new
hypotheses and it does not promote the still-missing oriented polygonal
Stokes theorem to a certificate.

The original arithmetic action has the central kernel `±1`.  Consequently
the quotient used below is formed with the faithful permutation image of
`Gamma(2)`.  This changes no orbit.  Compact-preimage properness is asserted
only after intersecting with the selected closed six-tile carrier; the
strictly stronger raw full-preimage statement is named at the end of this
file, but is intentionally not inhabited or included in the certificate.
-/

open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry
open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary

/-! ## Public carrier aliases -/

/-- The paper's arithmetic congruence subgroup. -/
abbrev ArithmeticGroup := GammaTwo

/-- The faithful image of the arithmetic action in `Equiv.Perm ℍ`. -/
abbrev EffectiveGroup : Type := GammaTwoEffective

/-- The orbit quotient by the faithful effective action. -/
abbrev EffectiveQuotient : Type := GammaTwoQuotient

/-- The canonical effective-orbit projection. -/
abbrev quotientProjection : ℍ → EffectiveQuotient :=
  gammaTwoQuotientMk

/-- The selected closed six-tile carrier. -/
abbrev closedCarrier : Set ℍ := gammaTwoClosedTileCarrier

/-- The literal simultaneous three-cusp truncation. -/
abbrev literalTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoThreeCuspTruncation Y

/-- The relative truncation inside the chosen closed polygon subtype. -/
abbrev relativeTruncation (Y : ℝ) : Set GammaTwoChosenPolygon :=
  gammaTwoRelativeTruncation Y

/-- The selected-polygon representatives of a quotient set. -/
abbrev relativeQuotientPreimage
    (K : Set EffectiveQuotient) : Set GammaTwoChosenPolygon :=
  gammaTwoRelativeQuotientPreimage K

/-- The canonical compact-lift exhaustion indexed by a real parameter. -/
abbrev topologicalTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoTopologicalTruncation Y

/-- The literal cusp core augmented by a global compact lift stage. -/
abbrev globalCuspTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoGlobalCuspTruncation Y

/-- The hyperbolic measure `dx dy / y²` used by the geometry. -/
abbrev hyperbolicArea : Measure ℍ := hyperbolicMeasure

/-! ## Three explicit cusp charts -/

/-- The finite type of the three named level-two cusp classes. -/
abbrev Cusp : Type := GammaTwoCusp

/-- The explicit integral matrix carrying infinity to a named cusp. -/
abbrev cuspScaling : Cusp → SL(2, ℤ) := gammaTwoCuspScaling

/-- The declared positive cusp width. -/
abbrev cuspWidth : Cusp → ℕ := gammaTwoCuspWidth

/-- The full width-two parabolic at a named cusp. -/
abbrev cuspTranslation (κ : Cusp) (n : ℤ) : SL(2, ℤ) :=
  gammaTwoCuspTranslation κ n

/-- Local height in the coordinate determined by the scaling matrix. -/
abbrev cuspHeight (κ : Cusp) (z : ℍ) : ℝ :=
  gammaTwoCuspHeight κ z

/-- Every named cusp label is one of infinity, zero, or one.  This is a
statement about the concrete finite label type, not a separately supplied
classification of all rational projective cusp orbits. -/
theorem cusp_eq_infinity_or_zero_or_one (κ : Cusp) :
    κ = .atInfinity ∨ κ = .zero ∨ κ = .one := by
  cases κ <;> simp

@[simp]
theorem cuspScaling_atInfinity :
    cuspScaling .atInfinity = 1 :=
  gammaTwoCuspScaling_atInfinity

@[simp]
theorem cuspScaling_zero :
    cuspScaling .zero = ModularGroup.S :=
  gammaTwoCuspScaling_zero

@[simp]
theorem cuspScaling_one :
    cuspScaling .one = ModularGroup.T * ModularGroup.S :=
  gammaTwoCuspScaling_one

/-- Every concrete cusp has exact width two. -/
@[simp]
theorem cuspWidth_eq_two (κ : Cusp) : cuspWidth κ = 2 :=
  gammaTwoCuspWidth_eq_two κ

/-- Every integral power of the width-two parabolic belongs to `Gamma(2)`. -/
theorem cuspTranslation_mem (κ : Cusp) (n : ℤ) :
    cuspTranslation κ n ∈ ArithmeticGroup :=
  gammaTwoCuspTranslation_mem κ n

/-- Width two is minimal among positive natural translation lengths. -/
theorem cuspWidth_minimal (κ : Cusp) (n : ℕ)
    (hn : 0 < n) (hnw : n < cuspWidth κ) :
    cuspScaling κ * ModularGroup.T ^ n * (cuspScaling κ)⁻¹ ∉
      ArithmeticGroup :=
  gammaTwoCuspWidth_minimal κ n hn hnw

/-- Local cusp height is strictly positive. -/
theorem cuspHeight_pos (κ : Cusp) (z : ℍ) :
    0 < cuspHeight κ z :=
  gammaTwoCuspHeight_pos κ z

/-- Every local cusp-height function is continuous. -/
theorem cuspHeight_continuous (κ : Cusp) :
    Continuous (cuspHeight κ) :=
  gammaTwoCuspHeight_continuous κ

/-- Every local cusp-height function is measurable. -/
theorem cuspHeight_measurable (κ : Cusp) :
    Measurable (cuspHeight κ) :=
  gammaTwoCuspHeight_measurable κ

/-- Local height is invariant under the full width-two cusp stabilizer. -/
theorem cuspHeight_translation (κ : Cusp) (n : ℤ) (z : ℍ) :
    cuspHeight κ (cuspTranslation κ n • z) = cuspHeight κ z :=
  gammaTwoCuspHeight_translation κ n z

/-! ## Effective action and quotient topology -/

/-- The effective group is definitionally the range of the permutation
representation of the arithmetic group. -/
theorem effectiveGroup_eq_permutationRange :
    EffectiveGroup =
      (MulAction.toPermHom ArithmeticGroup ℍ).range :=
  rfl

/-- Inclusion of the effective group into the permutation group is faithful.
This is the type-level reason that the central action kernel has disappeared.
-/
theorem effectivePermutation_injective :
    Injective (fun g : EffectiveGroup => (g.1 : Equiv.Perm ℍ)) :=
  Subtype.val_injective

/-- Every effective transformation is induced by an arithmetic matrix. -/
theorem effectiveElement_has_arithmeticRepresentative
    (g : EffectiveGroup) :
    ∃ γ : ArithmeticGroup, ∀ z : ℍ, g • z = γ • z :=
  effective_exists_gamma g

/-- The arithmetic-to-effective map acts pointwise exactly as the original
matrix. -/
theorem effectiveElement_smul
    (γ : ArithmeticGroup) (z : ℍ) :
    gammaTwoEffectiveElement γ • z = γ • z :=
  gammaTwoEffectiveElement_smul γ z

/-- The original arithmetic action is proper. -/
theorem arithmeticAction_proper : ProperSMul ArithmeticGroup ℍ :=
  inferInstance

/-- The original arithmetic action is properly discontinuous. -/
theorem arithmeticAction_properlyDiscontinuous :
    ProperlyDiscontinuousSMul ArithmeticGroup ℍ :=
  inferInstance

/-- The effective action is proper. -/
theorem effectiveAction_proper : ProperSMul EffectiveGroup ℍ :=
  inferInstance

/-- The effective action is properly discontinuous. -/
theorem effectiveAction_properlyDiscontinuous :
    ProperlyDiscontinuousSMul EffectiveGroup ℍ :=
  inferInstance

/-- Only finitely many effective translates of one compact set meet another
compact set. -/
theorem finite_compact_translate_overlaps
    {K L : Set ℍ} (hK : IsCompact K) (hL : IsCompact L) :
    {g : EffectiveGroup |
      (((g • ·) '' K) ∩ L).Nonempty}.Finite :=
  gammaTwoEffective_finite_translates_inter_compact hK hL

/-- Every effective stabilizer is finite. -/
theorem finite_effective_stabilizer (z : ℍ) :
    (MulAction.stabilizer EffectiveGroup z : Set EffectiveGroup).Finite :=
  gammaTwoEffective_stabilizer_finite z

/-- The effective orbit quotient is Hausdorff. -/
theorem effectiveQuotient_t2 : T2Space EffectiveQuotient :=
  inferInstance

/-- The orbit projection is simultaneously open, continuous, surjective,
and a quotient map. -/
theorem quotientProjection_isOpenQuotientMap :
    IsOpenQuotientMap quotientProjection :=
  gammaTwoQuotientMk_isOpenQuotientMap

/-! ## Literal three-cusp truncations -/

/-- Every literal truncation is closed upstairs. -/
theorem literalTruncation_isClosed (Y : ℝ) :
    IsClosed (literalTruncation Y) :=
  gammaTwoThreeCuspTruncation_isClosed Y

/-- Every literal truncation is measurable. -/
theorem literalTruncation_measurable (Y : ℝ) :
    MeasurableSet (literalTruncation Y) :=
  gammaTwoThreeCuspTruncation_measurable Y

/-- Every literal truncation is compact. -/
theorem literalTruncation_isCompact (Y : ℝ) :
    IsCompact (literalTruncation Y) :=
  gammaTwoThreeCuspTruncation_isCompact Y

/-- Literal cusp stages are monotone in the cutoff. -/
theorem literalTruncation_monotone : Monotone literalTruncation :=
  gammaTwoThreeCuspTruncation_monotone

/-- Every orbit has a representative in a literal truncation at some cutoff
strictly larger than one. -/
theorem literalTruncation_orbit_exhausts (z : ℍ) :
    ∃ Y : ℝ, 1 < Y ∧ ∃ w : ℍ,
      w ∈ literalTruncation Y ∧
        quotientProjection w = quotientProjection z :=
  gammaTwoThreeCuspTruncation_orbit_exhausts z

/-! ## Boundary nullity, finite pieces, and side pairing -/

/-- The frontier of every literal truncation is hyperbolic-null. -/
theorem literalTruncation_frontier_null (Y : ℝ) :
    hyperbolicArea (frontier (literalTruncation Y)) = 0 :=
  gammaTwoThreeCuspTruncation_frontier_null Y

/-- The three-cusp corner locus is hyperbolic-null. -/
theorem literalTruncation_corners_null (Y : ℝ) :
    hyperbolicArea (gammaTwoThreeCuspCorners Y) = 0 :=
  gammaTwoThreeCuspCorners_null Y

/-- The genuine literal-frontier corner locus is a finite set. -/
theorem literalFrontierCorners_finite (Y : ℝ) :
    (gammaTwoLiteralFrontierCorners Y).Finite :=
  gammaTwoLiteralFrontierCorners_finite Y

/-- The typed collection of circular, vertical, and horocycle boundary
pieces is finite. -/
theorem truncationBoundaryPiece_univ_finite :
    (Set.univ : Set GammaTwoTruncationBoundaryPiece).Finite :=
  gammaTwoTruncationBoundaryPiece_univ_finite

/-- The finite standard-edge pairing is an involution. -/
theorem standardEdge_pairing_involutive
    (e : GammaTwoStandardEdge) :
    e.paired.paired = e :=
  GammaTwoStandardEdge.paired_paired e

/-- Every standard paired edge has the opposite boundary orientation. -/
theorem standardEdge_pairing_reverses_orientation
    (e : GammaTwoStandardEdge) :
    e.paired.orientationSign = -e.orientationSign :=
  GammaTwoStandardEdge.pairing_reverses_orientation e

/-- The paired-side and horocycle pieces, after deleting their common corner
locus, are disjoint. -/
theorem literalBoundaryPieces_disjoint (Y : ℝ) :
    Disjoint (gammaTwoThreeCuspPairedSideAwayFromCorners Y)
      (gammaTwoThreeCuspHorocycleAwayFromCorners Y) :=
  gammaTwoThreeCuspBoundaryPieces_disjoint Y

/-! ## Proper selected preimages and compact cofinality -/

/-- The inverse image of a compact quotient set is compact after selecting
the closed six-tile carrier.  This is the exact proper-reduction theorem used
by the compact-support and flux-tail arguments. -/
theorem closedCarrier_inter_compactPreimage_isCompact
    (K : Set EffectiveQuotient) (hK : IsCompact K) :
    IsCompact (closedCarrier ∩ quotientProjection ⁻¹' K) :=
  gammaTwoClosedCarrier_inter_preimage_isCompact K hK

/-- The literal three-cusp stages are cofinal among compact quotient sets. -/
theorem compact_subset_literalTruncation_image
    (K : Set EffectiveQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ quotientProjection '' literalTruncation Y :=
  gammaTwoThreeCuspCompactCofinal_unconditional K hK

/-- Every compact quotient set is captured strictly inside a relative
truncation of the selected closed polygon. -/
theorem compact_relativePreimage_subset_truncationInterior
    (K : Set EffectiveQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      relativeQuotientPreimage K ⊆
        interior (relativeTruncation Y) :=
  compact_relativeQuotientPreimage_subset_truncationInterior K hK

/-! ## Global compact exhaustions -/

/-- Each canonical compact-lift stage is compact. -/
theorem topologicalTruncation_isCompact (Y : ℝ) :
    IsCompact (topologicalTruncation Y) :=
  gammaTwoTopologicalTruncation_isCompact Y

/-- The canonical compact-lift stages are monotone. -/
theorem topologicalTruncation_monotone :
    Monotone topologicalTruncation :=
  gammaTwoTopologicalTruncation_monotone

/-- Canonical compact-lift stages capture every compact quotient set. -/
theorem topologicalTruncation_exhausts_compacts
    (K : Set EffectiveQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ quotientProjection '' topologicalTruncation Y :=
  gammaTwoTopologicalTruncation_exhausts_compacts K hK

/-- Each augmented global cusp stage is compact. -/
theorem globalCuspTruncation_isCompact (Y : ℝ) :
    IsCompact (globalCuspTruncation Y) :=
  gammaTwoGlobalCuspTruncation_isCompact Y

/-- Each augmented global cusp stage is measurable. -/
theorem globalCuspTruncation_measurable (Y : ℝ) :
    MeasurableSet (globalCuspTruncation Y) :=
  gammaTwoGlobalCuspTruncation_measurable Y

/-- Augmented global cusp stages are monotone. -/
theorem globalCuspTruncation_monotone :
    Monotone globalCuspTruncation :=
  gammaTwoGlobalCuspTruncation_monotone

/-- Augmented global cusp stages capture every compact quotient set. -/
theorem globalCuspTruncation_exhausts_compacts
    (K : Set EffectiveQuotient) (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧
      K ⊆ quotientProjection '' globalCuspTruncation Y :=
  gammaTwoGlobalCuspTruncation_exhausts_compacts K hK

/-- The already-constructed global cusp exhaustion package. -/
noncomputable def globalOrbitTruncationExhaustion :
    GammaTwoOrbitTruncationExhaustion :=
  chosenGammaTwoGlobalCuspTruncationExhaustion

/-! ## Quotient-compact flux tails -/

/-- Smooth quotient-compact invariant flux data vanish identically beyond
one literal three-cusp stage in the selected closed carrier.  This is the
proved tail theorem; it is not the still-missing oriented polygonal Stokes
identity. -/
theorem quotientCompactFlux_hasZeroThreeCuspTail :
    GammaTwoQuotientCompactFluxTailTightness :=
  gammaTwoQuotientCompactFluxTailTightness

/-! ## One bundled unconditional P2 certificate -/

/-- A proposition-only bundle of the already-proved P2.1--P2.2 geometry.
No field is a hypothesis for a later result: the inhabitant below is built
entirely from imported unconditional theorems. -/
structure ConcreteP2GeometryCertificate : Prop where
  cuspCases :
    ∀ κ : Cusp, κ = .atInfinity ∨ κ = .zero ∨ κ = .one
  scalingAtInfinity : cuspScaling .atInfinity = 1
  scalingAtZero : cuspScaling .zero = ModularGroup.S
  scalingAtOne : cuspScaling .one = ModularGroup.T * ModularGroup.S
  widthTwo : ∀ κ : Cusp, cuspWidth κ = 2
  widthMinimal :
    ∀ (κ : Cusp) (n : ℕ), 0 < n → n < cuspWidth κ →
      cuspScaling κ * ModularGroup.T ^ n * (cuspScaling κ)⁻¹ ∉
        ArithmeticGroup
  cuspTranslations :
    ∀ (κ : Cusp) (n : ℤ), cuspTranslation κ n ∈ ArithmeticGroup
  heightPositive : ∀ (κ : Cusp) (z : ℍ), 0 < cuspHeight κ z
  heightContinuous : ∀ κ : Cusp, Continuous (cuspHeight κ)
  heightTranslationInvariant :
    ∀ (κ : Cusp) (n : ℤ) (z : ℍ),
      cuspHeight κ (cuspTranslation κ n • z) = cuspHeight κ z
  effectiveRepresentative :
    ∀ g : EffectiveGroup,
      ∃ γ : ArithmeticGroup, ∀ z : ℍ, g • z = γ • z
  effectivePermutationFaithful :
    Injective (fun g : EffectiveGroup => (g.1 : Equiv.Perm ℍ))
  arithmeticProper : ProperSMul ArithmeticGroup ℍ
  arithmeticProperlyDiscontinuous :
    ProperlyDiscontinuousSMul ArithmeticGroup ℍ
  effectiveProper : ProperSMul EffectiveGroup ℍ
  effectiveProperlyDiscontinuous :
    ProperlyDiscontinuousSMul EffectiveGroup ℍ
  finiteCompactOverlaps :
    ∀ {K L : Set ℍ}, IsCompact K → IsCompact L →
      {g : EffectiveGroup |
        (((g • ·) '' K) ∩ L).Nonempty}.Finite
  quotientT2 : T2Space EffectiveQuotient
  quotientOpen : IsOpenQuotientMap quotientProjection
  literalClosed : ∀ Y : ℝ, IsClosed (literalTruncation Y)
  literalMeasurable : ∀ Y : ℝ, MeasurableSet (literalTruncation Y)
  literalCompact : ∀ Y : ℝ, IsCompact (literalTruncation Y)
  literalMonotone : Monotone literalTruncation
  literalOrbitExhaustion :
    ∀ z : ℍ, ∃ Y : ℝ, 1 < Y ∧ ∃ w : ℍ,
      w ∈ literalTruncation Y ∧
        quotientProjection w = quotientProjection z
  frontierNull :
    ∀ Y : ℝ, hyperbolicArea (frontier (literalTruncation Y)) = 0
  cornersNull :
    ∀ Y : ℝ, hyperbolicArea (gammaTwoThreeCuspCorners Y) = 0
  cornersFinite :
    ∀ Y : ℝ, (gammaTwoLiteralFrontierCorners Y).Finite
  finiteBoundaryLabels :
    (Set.univ : Set GammaTwoTruncationBoundaryPiece).Finite
  standardPairingInvolutive :
    ∀ e : GammaTwoStandardEdge, e.paired.paired = e
  standardPairingOrientation :
    ∀ e : GammaTwoStandardEdge,
      e.paired.orientationSign = -e.orientationSign
  boundaryPiecesDisjoint :
    ∀ Y : ℝ,
      Disjoint (gammaTwoThreeCuspPairedSideAwayFromCorners Y)
        (gammaTwoThreeCuspHorocycleAwayFromCorners Y)
  closedCarrierCompactPreimage :
    ∀ (K : Set EffectiveQuotient), IsCompact K →
      IsCompact (closedCarrier ∩ quotientProjection ⁻¹' K)
  compactCofinal :
    ∀ (K : Set EffectiveQuotient), IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧
        K ⊆ quotientProjection '' literalTruncation Y
  interiorCapture :
    ∀ (K : Set EffectiveQuotient), IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧
        relativeQuotientPreimage K ⊆
          interior (relativeTruncation Y)
  globalCompact : ∀ Y : ℝ, IsCompact (globalCuspTruncation Y)
  globalMeasurable :
    ∀ Y : ℝ, MeasurableSet (globalCuspTruncation Y)
  globalMonotone : Monotone globalCuspTruncation
  globalCompactExhaustion :
    ∀ (K : Set EffectiveQuotient), IsCompact K →
      ∃ Y : ℝ, 1 < Y ∧
        K ⊆ quotientProjection '' globalCuspTruncation Y
  fluxTail : GammaTwoQuotientCompactFluxTailTightness

/-- Unconditional inhabitant of `ConcreteP2GeometryCertificate`. -/
theorem concreteP2GeometryCertificate :
    ConcreteP2GeometryCertificate where
  cuspCases := cusp_eq_infinity_or_zero_or_one
  scalingAtInfinity := cuspScaling_atInfinity
  scalingAtZero := cuspScaling_zero
  scalingAtOne := cuspScaling_one
  widthTwo := cuspWidth_eq_two
  widthMinimal := cuspWidth_minimal
  cuspTranslations := cuspTranslation_mem
  heightPositive := cuspHeight_pos
  heightContinuous := cuspHeight_continuous
  heightTranslationInvariant := cuspHeight_translation
  effectiveRepresentative := effectiveElement_has_arithmeticRepresentative
  effectivePermutationFaithful := effectivePermutation_injective
  arithmeticProper := arithmeticAction_proper
  arithmeticProperlyDiscontinuous := arithmeticAction_properlyDiscontinuous
  effectiveProper := effectiveAction_proper
  effectiveProperlyDiscontinuous := effectiveAction_properlyDiscontinuous
  finiteCompactOverlaps := finite_compact_translate_overlaps
  quotientT2 := effectiveQuotient_t2
  quotientOpen := quotientProjection_isOpenQuotientMap
  literalClosed := literalTruncation_isClosed
  literalMeasurable := literalTruncation_measurable
  literalCompact := literalTruncation_isCompact
  literalMonotone := literalTruncation_monotone
  literalOrbitExhaustion := literalTruncation_orbit_exhausts
  frontierNull := literalTruncation_frontier_null
  cornersNull := literalTruncation_corners_null
  cornersFinite := literalFrontierCorners_finite
  finiteBoundaryLabels := truncationBoundaryPiece_univ_finite
  standardPairingInvolutive := standardEdge_pairing_involutive
  standardPairingOrientation := standardEdge_pairing_reverses_orientation
  boundaryPiecesDisjoint := literalBoundaryPieces_disjoint
  closedCarrierCompactPreimage :=
    closedCarrier_inter_compactPreimage_isCompact
  compactCofinal := compact_subset_literalTruncation_image
  interiorCapture :=
    compact_relativePreimage_subset_truncationInterior
  globalCompact := globalCuspTruncation_isCompact
  globalMeasurable := globalCuspTruncation_measurable
  globalMonotone := globalCuspTruncation_monotone
  globalCompactExhaustion := globalCuspTruncation_exhausts_compacts
  fluxTail := quotientCompactFlux_hasZeroThreeCuspTail

/-! ## Explicit logical boundary -/

/-- The stronger *raw full-preimage compactness* assertion.  It is named so
downstream code cannot accidentally confuse it with selected closed-carrier
properness.  No inhabitant is provided, and this proposition is deliberately
absent from `ConcreteP2GeometryCertificate`: the imported development proves
compactness of `closedCarrier ∩ quotientProjection ⁻¹' K`, not compactness of
the full inverse image containing every deck translate. -/
def RawFullQuotientPreimageCompactness : Prop :=
  ∀ (K : Set EffectiveQuotient), IsCompact K →
    IsCompact (quotientProjection ⁻¹' K)

end QYM.FullCertification.P2ConcreteCuspGeometryExtension


open Function Set Topology
open scoped MatrixGroups UpperHalfPlane

namespace QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension

open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# P2.3: intrinsic compact cusp truncations of the effective `Gamma(2)` quotient

The upstairs literal truncation `gammaTwoThreeCuspTruncation Y` is a subset
of a chosen closed six-tile carrier.  It is therefore not itself invariant
under changing an upper-half-plane representative.  The intrinsic object is
its image in the effective orbit quotient.  This module names that image,
uses the subtype topology and measurable structure already inherited from the
Hausdorff quotient, and proves all representative-independent and exhaustion
claims below without choosing a section of the quotient map.

No smooth-manifold or boundary-component structure is asserted here.  Those
claims require an effective quotient atlas and a separate side-cancellation
theorem for the saturated truncation.
-/

/-! ## The intrinsic stage -/

/-- The intrinsic closed cusp truncation as a subset of the effective orbit
quotient.  Membership means that the orbit has at least one representative in
the literal closed-polygon stage. -/
def XSet (Y : ℝ) : Set GammaTwoQuotient :=
  gammaTwoQuotientMk '' gammaTwoThreeCuspTruncation Y

/-- The intrinsic truncated quotient, equipped with the subtype topology and
the subtype measurable space inherited from `GammaTwoQuotient`. -/
abbrev X (Y : ℝ) : Type :=
  XSet Y

/-- Membership in `XSet Y` is exactly existence of a representative in the
literal upstairs stage.  This formulation contains no selected quotient
representative. -/
theorem mem_XSet_iff_exists_representative (Y : ℝ)
    (x : GammaTwoQuotient) :
    x ∈ XSet Y ↔
      ∃ z : ℍ, z ∈ gammaTwoThreeCuspTruncation Y ∧
        gammaTwoQuotientMk z = x := by
  rfl

/-- Representative-level version of `mem_XSet_iff_exists_representative`.
It deliberately does *not* claim that the chosen representative `z` itself
lies in the closed polygon. -/
theorem quotientMk_mem_XSet_iff_exists_representative (Y : ℝ) (z : ℍ) :
    gammaTwoQuotientMk z ∈ XSet Y ↔
      ∃ w : ℍ, w ∈ gammaTwoThreeCuspTruncation Y ∧
        gammaTwoQuotientMk w = gammaTwoQuotientMk z :=
  mem_XSet_iff_exists_representative Y (gammaTwoQuotientMk z)

/-- Every point of the literal upstairs stage projects to the intrinsic
stage. -/
theorem quotientMk_mem_XSet_of_mem (Y : ℝ) {z : ℍ}
    (hz : z ∈ gammaTwoThreeCuspTruncation Y) :
    gammaTwoQuotientMk z ∈ XSet Y :=
  ⟨z, hz, rfl⟩

/-- Membership is independent of the chosen upper-half-plane representative,
expressed for arbitrary representatives with equal quotient classes. -/
theorem quotientMk_mem_XSet_congr (Y : ℝ) {z w : ℍ}
    (hzw : gammaTwoQuotientMk z = gammaTwoQuotientMk w) :
    gammaTwoQuotientMk z ∈ XSet Y ↔
      gammaTwoQuotientMk w ∈ XSet Y := by
  rw [hzw]

/-- Membership is unchanged by every effective deck transformation. -/
@[simp]
theorem quotientMk_smul_mem_XSet_iff (Y : ℝ)
    (g : GammaTwoEffective) (z : ℍ) :
    gammaTwoQuotientMk (g • z) ∈ XSet Y ↔
      gammaTwoQuotientMk z ∈ XSet Y := by
  rw [gammaTwoQuotientMk_smul]

/-- The same representative-independence statement for the original
`Gamma(2)` matrix action. -/
@[simp]
theorem quotientMk_gamma_smul_mem_XSet_iff (Y : ℝ)
    (gamma : GammaTwo) (z : ℍ) :
    gammaTwoQuotientMk (gamma • z) ∈ XSet Y ↔
      gammaTwoQuotientMk z ∈ XSet Y := by
  rw [gammaTwoQuotientMk_gamma_smul]

/-- The full inverse image of the intrinsic stage is the orbit saturation of
the literal polygon stage.  This is the precise replacement for the false
statement `z ∈ F_Y ↔ quotientMk z ∈ X_Y`. -/
theorem preimage_XSet_eq_saturation (Y : ℝ) :
    gammaTwoQuotientMk ⁻¹' XSet Y =
      ⋃ g : GammaTwoEffective,
        (g • ·) '' gammaTwoThreeCuspTruncation Y := by
  change
    (Quotient.mk'' : ℍ → GammaTwoQuotient) ⁻¹'
        ((Quotient.mk'' : ℍ → GammaTwoQuotient) ''
          gammaTwoThreeCuspTruncation Y) =
      ⋃ g : GammaTwoEffective,
        (g • ·) '' gammaTwoThreeCuspTruncation Y
  exact MulAction.quotient_preimage_image_eq_union_mul
    (gammaTwoThreeCuspTruncation Y) (G := GammaTwoEffective)

/-- For the open orbit projection, a quotient point is interior to the
intrinsic stage exactly when any chosen representative is interior to its
full saturated inverse image.  This is the precise topological reduction of
the paired-side interior problem. -/
theorem quotientMk_mem_interior_XSet_iff (Y : ℝ) (z : ℍ) :
    gammaTwoQuotientMk z ∈ interior (XSet Y) ↔
      z ∈ interior (gammaTwoQuotientMk ⁻¹' XSet Y) := by
  constructor
  · intro hz
    exact
      (interior_maximal
        (Set.preimage_mono interior_subset)
        (isOpen_interior.preimage
          gammaTwoQuotientMk_isOpenQuotientMap.continuous)) hz
  · intro hz
    let U : Set ℍ := interior (gammaTwoQuotientMk ⁻¹' XSet Y)
    have hUOpen : IsOpen U := isOpen_interior
    have hImageOpen : IsOpen (gammaTwoQuotientMk '' U) :=
      gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap U hUOpen
    have hImageSubset : gammaTwoQuotientMk '' U ⊆ XSet Y := by
      rintro x ⟨w, hw, rfl⟩
      change w ∈ gammaTwoQuotientMk ⁻¹' XSet Y
      exact interior_subset hw
    exact (interior_maximal hImageSubset hImageOpen)
      ⟨z, hz, rfl⟩

/-- Interior membership expressed entirely in the explicit union of deck
translates of the literal polygon stage.  A local two-tile filling theorem
for paired sides can target the right-hand side without choosing a quotient
section. -/
theorem quotientMk_mem_interior_XSet_iff_saturation
    (Y : ℝ) (z : ℍ) :
    gammaTwoQuotientMk z ∈ interior (XSet Y) ↔
      z ∈ interior
        (⋃ g : GammaTwoEffective,
          (g • ·) '' gammaTwoThreeCuspTruncation Y) := by
  rw [quotientMk_mem_interior_XSet_iff,
    preimage_XSet_eq_saturation]

/-! ## Compactness, closedness, and measurability -/

/-- The intrinsic quotient stage is compact as the continuous image of the
literal compact truncation. -/
theorem XSet_isCompact (Y : ℝ) : IsCompact (XSet Y) :=
  (gammaTwoThreeCuspTruncation_isCompact Y).image
    gammaTwoQuotientMk_isOpenQuotientMap.continuous

/-- Since the effective quotient is Hausdorff, every intrinsic compact stage
is closed. -/
theorem XSet_isClosed (Y : ℝ) : IsClosed (XSet Y) :=
  (XSet_isCompact Y).isClosed

/-- The intrinsic stage is measurable in the quotient measurable space.  The
proof uses the exact measurable-image theorem for orbit saturation rather
than the generally false principle that continuous images are measurable. -/
theorem XSet_measurable (Y : ℝ) : MeasurableSet (XSet Y) :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoFundamentalDomain.quotientImage_measurable
    (gammaTwoThreeCuspTruncation_measurable Y)

/-- The subtype `X Y` is an actual compact space. -/
noncomputable instance X_compactSpace (Y : ℝ) : CompactSpace (X Y) :=
  isCompact_iff_compactSpace.mp (XSet_isCompact Y)

/-! ## Quotient topology from the compact polygon stage -/

/-- The literal compact upstairs stage as a subtype. -/
abbrev UpstairsX (Y : ℝ) : Type :=
  gammaTwoThreeCuspTruncation Y

/-- The restricted orbit projection from the literal compact stage onto the
intrinsic stage. -/
def stageProjection (Y : ℝ) : UpstairsX Y → X Y :=
  fun z => ⟨gammaTwoQuotientMk z.1, ⟨z.1, z.2, rfl⟩⟩

@[simp]
theorem stageProjection_coe (Y : ℝ) (z : UpstairsX Y) :
    ((stageProjection Y z : X Y) : GammaTwoQuotient) =
      gammaTwoQuotientMk z.1 :=
  rfl

/-- The restricted projection is continuous for the inherited subtype
topologies. -/
theorem stageProjection_continuous (Y : ℝ) :
    Continuous (stageProjection Y) :=
  (gammaTwoQuotientMk_isOpenQuotientMap.continuous.comp
    continuous_subtype_val).subtype_mk _

/-- The intrinsic image definition makes the restricted projection
surjective. -/
theorem stageProjection_surjective (Y : ℝ) :
    Surjective (stageProjection Y) := by
  rintro ⟨x, hx⟩
  rcases hx with ⟨z, hz, rfl⟩
  exact ⟨⟨z, hz⟩, rfl⟩

/-- The literal upstairs stage is compact. -/
noncomputable instance UpstairsX_compactSpace (Y : ℝ) :
    CompactSpace (UpstairsX Y) :=
  isCompact_iff_compactSpace.mp
    (gammaTwoThreeCuspTruncation_isCompact Y)

/-- The inherited topology on `X Y` is exactly the quotient topology of the
restricted compact-polygon projection.  Compact-to-Hausdorff is the key
point: no representative choice enters the topology. -/
theorem stageProjection_isQuotientMap (Y : ℝ) :
    IsQuotientMap (stageProjection Y) :=
  IsQuotientMap.of_surjective_continuous
    (stageProjection_surjective Y)
    (stageProjection_continuous Y)

/-! ## Monotone inclusions -/

/-- The intrinsic quotient stages increase with the cutoff. -/
theorem XSet_monotone : Monotone XSet := by
  intro Y Z hYZ
  exact Set.image_mono
    (gammaTwoThreeCuspTruncation_monotone hYZ)

/-- Canonical inclusion between intrinsic stages. -/
def XInclusion {Y Z : ℝ} (hYZ : Y ≤ Z) : X Y → X Z :=
  Set.inclusion (XSet_monotone hYZ)

@[simp]
theorem XInclusion_coe {Y Z : ℝ} (hYZ : Y ≤ Z) (x : X Y) :
    ((XInclusion hYZ x : X Z) : GammaTwoQuotient) =
      (x : GammaTwoQuotient) :=
  rfl

/-- Inclusion at an equal cutoff is the identity. -/
theorem XInclusion_refl (Y : ℝ) :
    XInclusion (Y := Y) (Z := Y) le_rfl = id := by
  funext x
  apply Subtype.ext
  rfl

/-- Canonical inclusions compose coherently. -/
theorem XInclusion_trans {Y Z W : ℝ}
    (hYZ : Y ≤ Z) (hZW : Z ≤ W) :
    XInclusion hZW ∘ XInclusion hYZ =
      XInclusion (hYZ.trans hZW) := by
  funext x
  apply Subtype.ext
  rfl

/-- The inclusion is a topological embedding, so the smaller stage carries
exactly the subspace topology induced from the larger stage. -/
theorem XInclusion_isEmbedding {Y Z : ℝ} (hYZ : Y ≤ Z) :
    IsEmbedding (XInclusion hYZ) :=
  Topology.IsEmbedding.inclusion (XSet_monotone hYZ)

/-- In particular every stage inclusion is injective. -/
theorem XInclusion_injective {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Injective (XInclusion hYZ) :=
  (XInclusion_isEmbedding hYZ).injective

/-- Every stage inclusion is continuous. -/
theorem XInclusion_continuous {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Continuous (XInclusion hYZ) :=
  continuous_inclusion (XSet_monotone hYZ)

/-- Every stage inclusion is measurable for the inherited quotient
measurable spaces. -/
theorem XInclusion_measurable {Y Z : ℝ} (hYZ : Y ≤ Z) :
    Measurable (XInclusion hYZ) :=
  measurable_inclusion (XSet_monotone hYZ)

/-! ## Exhaustion and compact cofinality -/

/-- Every quotient point lies in a literal intrinsic stage with cutoff
strictly greater than one. -/
theorem exists_gt_one_mem_XSet (x : GammaTwoQuotient) :
    ∃ Y : ℝ, 1 < Y ∧ x ∈ XSet Y := by
  obtain ⟨z, rfl⟩ :=
    gammaTwoQuotientMk_isOpenQuotientMap.surjective x
  rcases gammaTwoThreeCuspTruncation_orbit_exhausts z with
    ⟨Y, hY, w, hw, hqw⟩
  exact ⟨Y, hY, ⟨w, hw, hqw⟩⟩

/-- The intrinsic real-indexed stages exhaust the whole quotient. -/
theorem iUnion_XSet_eq_univ :
    (⋃ Y : ℝ, XSet Y) = (Set.univ : Set GammaTwoQuotient) := by
  apply Set.eq_univ_of_forall
  intro x
  rcases exists_gt_one_mem_XSet x with ⟨Y, _hY, hx⟩
  exact Set.mem_iUnion.2 ⟨Y, hx⟩

/-- Even the subsystem indexed only by cutoffs `Y > 1` exhausts the quotient.
-/
theorem iUnion_gt_one_XSet_eq_univ :
    (⋃ Y : {Y : ℝ // 1 < Y}, XSet Y.1) =
      (Set.univ : Set GammaTwoQuotient) := by
  apply Set.eq_univ_of_forall
  intro x
  rcases exists_gt_one_mem_XSet x with ⟨Y, hY, hx⟩
  exact Set.mem_iUnion.2 ⟨⟨Y, hY⟩, hx⟩

/-- The literal intrinsic stages are cofinal among compact subsets of the
quotient, a stronger uniform statement than pointwise union exhaustion. -/
theorem compact_subset_XSet {K : Set GammaTwoQuotient}
    (hK : IsCompact K) :
    ∃ Y : ℝ, 1 < Y ∧ K ⊆ XSet Y :=
  gammaTwoThreeCuspCompactCofinal_unconditional K hK

/-! ## Corrected status of an unclipped raw cutoff -/

/-- The unclipped analogue of the three-cusp height truncation.  This is the
relevant model for a raw definition that uses `height ≤ Y` instead of the
normalized cutoff `height ≤ max 1 Y` used by `gammaTwoThreeCuspTruncation`.
-/
def rawUnclippedThreeCuspTruncation (Y : ℝ) : Set ℍ :=
  gammaTwoClosedTileCarrier ∩
    {z : ℍ | ∀ kappa : GammaTwoCusp, ∀ q : GammaTwoRightCoset,
      gammaTwoTileCuspClass q = kappa → gammaTwoTileHeight q z ≤ Y}

/-- A nonpositive raw cutoff is empty because every selected tile height is
strictly positive. -/
theorem rawUnclippedThreeCuspTruncation_eq_empty_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    rawUnclippedThreeCuspTruncation Y = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.2
  intro z hz
  let q : GammaTwoRightCoset :=
    Quotient.mk'' (1 : SL(2, ℤ))
  have hq : gammaTwoTileHeight q z ≤ Y :=
    hz.2 (gammaTwoTileCuspClass q) q rfl
  exact (not_lt_of_ge (hq.trans hY))
    (gammaTwoTileHeight_pos q z)

/-- The corresponding intrinsic raw quotient stage. -/
def rawUnclippedXSet (Y : ℝ) : Set GammaTwoQuotient :=
  gammaTwoQuotientMk '' rawUnclippedThreeCuspTruncation Y

/-- A nonpositive raw quotient stage is empty as well. -/
theorem rawUnclippedXSet_eq_empty_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    rawUnclippedXSet Y = ∅ := by
  simp [rawUnclippedXSet,
    rawUnclippedThreeCuspTruncation_eq_empty_of_nonpos hY]

/-- Hence the intrinsic raw quotient boundary is empty at a nonpositive
cutoff. -/
theorem frontier_rawUnclippedXSet_eq_empty_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    frontier (rawUnclippedXSet Y) = ∅ := by
  rw [rawUnclippedXSet_eq_empty_of_nonpos hY]
  exact frontier_empty

/-- Consequently the topological frontier of a nonpositive raw stage is
empty. -/
theorem frontier_rawUnclippedThreeCuspTruncation_eq_empty_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    frontier (rawUnclippedThreeCuspTruncation Y) = ∅ := by
  rw [rawUnclippedThreeCuspTruncation_eq_empty_of_nonpos hY]
  exact frontier_empty

/-- Thus a theorem claiming three nonempty boundary pieces for *every* real
raw cutoff is already impossible.  An exact three-component theorem must at
least impose a positive regular cutoff and still requires quotient-side
cancellation, connectedness, and component-separation proofs. -/
theorem rawUnclippedThreeCuspTruncation_not_three_nonempty_boundary_pieces
    {Y : ℝ} (hY : Y ≤ 0) :
    ¬ ∃ pieces : Fin 3 → Set ℍ,
        (∀ i, (pieces i).Nonempty) ∧
          (⋃ i, pieces i) =
            frontier (rawUnclippedThreeCuspTruncation Y) := by
  rintro ⟨pieces, hNonempty, hCover⟩
  rcases hNonempty 0 with ⟨z, hz⟩
  have hzUnion : z ∈ ⋃ i, pieces i :=
    Set.mem_iUnion.2 ⟨0, hz⟩
  rw [hCover,
    frontier_rawUnclippedThreeCuspTruncation_eq_empty_of_nonpos hY]
    at hzUnion
  exact hzUnion

/-- The same obstruction stated on the intrinsic quotient: at a nonpositive
raw cutoff its boundary cannot even be covered by three nonempty pieces, so
it cannot have exactly three nonempty connected components. -/
theorem rawUnclippedXSet_not_three_nonempty_boundary_pieces
    {Y : ℝ} (hY : Y ≤ 0) :
    ¬ ∃ pieces : Fin 3 → Set GammaTwoQuotient,
        (∀ i, (pieces i).Nonempty) ∧
          (⋃ i, pieces i) = frontier (rawUnclippedXSet Y) := by
  rintro ⟨pieces, hNonempty, hCover⟩
  rcases hNonempty 0 with ⟨x, hx⟩
  have hxUnion : x ∈ ⋃ i, pieces i :=
    Set.mem_iUnion.2 ⟨0, hx⟩
  rw [hCover, frontier_rawUnclippedXSet_eq_empty_of_nonpos hY]
    at hxUnion
  exact hxUnion

/-! ## Aggregate certificate -/

/-- Compactness, representative-independence, coherent inclusion, and
exhaustion collected in one theorem without any unproved boundary or smooth
manifold conclusion. -/
theorem intrinsic_truncated_quotient_certificate :
    (∀ Y : ℝ, IsCompact (XSet Y)) ∧
      Monotone XSet ∧
      (∀ Y : ℝ, ∀ g : GammaTwoEffective, ∀ z : ℍ,
        (gammaTwoQuotientMk (g • z) ∈ XSet Y ↔
          gammaTwoQuotientMk z ∈ XSet Y)) ∧
      (⋃ Y : ℝ, XSet Y) =
        (Set.univ : Set GammaTwoQuotient) := by
  exact ⟨XSet_isCompact, XSet_monotone,
    quotientMk_smul_mem_XSet_iff, iUnion_XSet_eq_univ⟩

end QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension


/-!
# P2 path-B polygon, horocycle, and stored-trace graph layer

This audited producer uses the explicit finite polygon API.  Its graph
completion stores a horizontal restriction coordinate; it does not identify
that coordinate with the boundary of the older closed-ball bulk carrier or
with a classical fractional Sobolev trace.
-/

open Function Set MeasureTheory
open scoped ENNReal MatrixGroups UpperHalfPlane Manifold ContDiff

namespace QYM.FullCertification.PolygonTraceExtension

open Mock2FA.PaperCorrections.AutomorphicSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfIntegralMultiplier
open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators
open QYM.FullCertification.Mock2EtaH1GraphCompletionExtension
open QYM.Mock2EtaCovariantDerivativeExtension
open QYM.Mock2EtaCovariantDerivativeExtension.Geometry

-- The `work.continuation` import makes this producer readable in isolation.
-- The integration script removes work imports after placing this body behind
-- the already integrated eta H1 declarations.

/-!
# Finite polygon traces and a trace-enhanced graph completion

This module is the unconditional path-B boundary tranche.  It uses the actual
six-tile `Gamma(2)` polygon API from `Mock2_FunctionalAnalysis_Integrated`.
The edge labels below are finite bookkeeping labels; no pairwise-disjointness
of labels along internal selected-tile seams is asserted.

There are two different trace statements in this file.

* On the smooth automorphic core, paired-edge traces agree pointwise with the
  exact half-integral multiplier.  This follows from the already proved
  covariance law and the exact polygon pairing parametrization.
* For the concrete eta H1 core, restriction to a width-two horizontal
  horocycle gives an actual element of a finite-measure parameter `L2` space.
  We include this coordinate in a larger graph norm and close the graph.  The
  horizontal-restriction projection from that stronger completion is bounded by
  construction.

The second construction is deliberately **not** called the classical Sobolev
trace theorem.  In particular, this module does not identify its parameter
`L2` target with `H^(1/2)` of a quotient boundary and does not construct a
bounded map from the previously defined `EtaH1Completion`.  Such a map would
require a genuine trace estimate in the old H1 graph norm.

There is also an important carrier distinction.  The previously constructed
`etaH1Core Y` uses a closed hyperbolic ball, whereas the horizontal curve below
uses the modular cusp level `gammaTwoCuspLevel Y`.  This file does not identify
that curve as the topological boundary of the old closed-ball carrier or of an
intrinsic quotient manifold-with-boundary.  It constructs the restriction and
its stronger graph completion, which is the safe input for a later comparison
theorem with the literal cusp-truncated carrier.

The `L2` target uses the fixed parameter measure `dx` on `[0,2]`.  The module
also computes the hyperbolic arclength `2/H`, but does not conflate the two
measures or claim an isometry to arclength `L2` without inserting the constant
density factor `1/H`.
-/

/-! ## 1. Re-exported finite polygon certificate -/

/-- The finite label type for the three sides of each selected right-coset
tile. -/
abbrev PolygonEdge := GammaTwoActualPolygonEdge

/-- The exact real parameter subtype attached to a polygon edge. -/
abbrev PolygonEdgeParameter (e : PolygonEdge) :=
  modularTileEdgeParameterSet e.2

/-- The actual geometric set represented by a finite edge label. -/
noncomputable def polygonEdgeSet (e : PolygonEdge) : Set ℍ :=
  gammaTwoActualPolygonEdgeSet e

/-- The actual, surjective parametrization of a selected polygon edge. -/
noncomputable def polygonEdgeParam
    (e : PolygonEdge) (t : PolygonEdgeParameter e) : ℍ :=
  gammaTwoActualPolygonEdgeParam e t

/-- There are only finitely many selected polygon-edge labels. -/
theorem polygonEdge_univ_finite :
    (Set.univ : Set PolygonEdge).Finite := by
  exact Set.finite_univ

/-- Every point of the labelled edge is obtained by its exact parameter. -/
theorem polygonEdgeParam_range (e : PolygonEdge) :
    Set.range (polygonEdgeParam e) = polygonEdgeSet e := by
  change Set.range (gammaTwoActualPolygonEdgeParam e) =
    gammaTwoActualPolygonEdgeSet e
  exact gammaTwoActualPolygonEdgeParam_range e

/-- The transported `Gamma(2)` element carries each source parameter to the
declared parameter on the paired edge. -/
theorem polygonEdge_pairing_param
    (e : PolygonEdge) (t : PolygonEdgeParameter e) :
    (e.pairingElement : SL(2, ℤ)) • polygonEdgeParam e t =
      polygonEdgeParam e.paired (e.pairedParameter t) := by
  exact gammaTwoActualPolygonEdgePairing_param e t

open scoped Pointwise

/-- The transported pairing carries the whole labelled edge onto its paired
labelled edge. -/
theorem polygonEdge_pairing_set (e : PolygonEdge) :
    ((e.pairingElement : SL(2, ℤ)) • polygonEdgeSet e : Set ℍ) =
      polygonEdgeSet e.paired := by
  exact gammaTwoActualPolygonEdgePairing_set e

/-- Pairing reverses the declared boundary orientation, including the sign of
the real parameter change. -/
theorem polygonEdge_pairing_reverses_orientation (e : PolygonEdge) :
    e.paired.orientationSign * e.2.parameterSign =
      -e.orientationSign := by
  exact e.pairing_reverses_orientation

/-- Genuine height-dependent corners on the literal truncation frontier form
a finite set. -/
theorem polygonLiteralCorners_finite (Y : ℝ) :
    (gammaTwoLiteralFrontierCorners Y).Finite :=
  gammaTwoLiteralFrontierCorners_finite Y

/-- The same literal corner locus is hyperbolic-area null.  This is useful for
area integrals only; it is not a Stokes theorem or a boundary-flux argument. -/
theorem polygonLiteralCorners_null (Y : ℝ) :
    hyperbolicMeasure (gammaTwoLiteralFrontierCorners Y) = 0 := by
  exact measure_mono_null Set.inter_subset_right
    (gammaTwoThreeCuspCorners_null Y)

/-- Removing every genuine literal-corner parameter leaves the full finite
edge sum unchanged. -/
theorem polygonEdges_sum_integral_remove_literalCorners
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (F : PolygonEdge → ℍ → E) :
    (∑ e : PolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet \
              gammaTwoActualEdgeLiteralCornerRealParameters Y e,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t)) =
      ∑ e : PolygonEdge,
        ∫ t in
            (gammaTwoActualPolygonEdgeBoundaryParametrization e).parameterSet,
          F e ((gammaTwoActualPolygonEdgeBoundaryParametrization e).point t) := by
  exact gammaTwoActualPolygonEdges_sum_integral_remove_literalCorners Y F

/-- A compact theorem-valued audit surface for the finite polygon data.  All
members are consequences, rather than fields supplied by a certificate. -/
theorem finitePolygonBoundaryCertificate (Y : ℝ) :
    (Set.univ : Set PolygonEdge).Finite ∧
      (∀ e : PolygonEdge,
        Set.range (polygonEdgeParam e) = polygonEdgeSet e) ∧
      (∀ (e : PolygonEdge) (t : PolygonEdgeParameter e),
        (e.pairingElement : SL(2, ℤ)) • polygonEdgeParam e t =
          polygonEdgeParam e.paired (e.pairedParameter t)) ∧
      (∀ e : PolygonEdge,
        e.paired.orientationSign * e.2.parameterSign =
          -e.orientationSign) ∧
      (gammaTwoLiteralFrontierCorners Y).Finite ∧
      hyperbolicMeasure (gammaTwoLiteralFrontierCorners Y) = 0 := by
  exact ⟨polygonEdge_univ_finite,
    polygonEdgeParam_range,
    polygonEdge_pairing_param,
    polygonEdge_pairing_reverses_orientation,
    polygonLiteralCorners_finite Y,
    polygonLiteralCorners_null Y⟩

/-! ## 2. Exact multiplier matching on paired smooth-core traces -/

/-- Pointwise multiplier matching on every exact paired-edge parameter. -/
def HasMultiplierMatchedPolygonTrace {k : ℤ}
    (M : HalfIntegralMultiplier GammaTwo k) (u : ℍ → ℂ) : Prop :=
  ∀ (e : PolygonEdge) (t : PolygonEdgeParameter e),
    u (polygonEdgeParam e.paired (e.pairedParameter t)) =
      M.factor e.pairingElement (polygonEdgeParam e t) *
        u (polygonEdgeParam e t)

/-- Any exact covariance law restricts to the exact multiplier matching law
on paired polygon edges.  The only geometric input is the already proved
pairing-parameter identity. -/
theorem hasMultiplierMatchedPolygonTrace_of_covariance {k : ℤ}
    (M : HalfIntegralMultiplier GammaTwo k) (u : ℍ → ℂ)
    (hcov : ∀ (γ : GammaTwo) (z : ℍ),
      u ((γ : SL(2, ℤ)) • z) = M.factor γ z * u z) :
    HasMultiplierMatchedPolygonTrace M u := by
  intro e t
  rw [← polygonEdge_pairing_param]
  exact hcov e.pairingElement (polygonEdgeParam e t)

/-- The genuine smooth quotient-compact automorphic core has matched paired
traces; no trace value is supplied as an assumption. -/
theorem smoothCompactWeightCore_hasMultiplierMatchedPolygonTrace
    {k : ℤ} {M : HalfIntegralMultiplier GammaTwo k}
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore M) :
    HasMultiplierMatchedPolygonTrace M
      (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore.toSection u) := by
  apply hasMultiplierMatchedPolygonTrace_of_covariance M
    (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore.toSection u)
  intro γ z
  have hCov :=
    Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore.covariance u γ z
  rw [← Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoToSL2Real_smul] at hCov
  rw [show
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoToSL2Real γ • z =
      Matrix.SpecialLinearGroup.toGL
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoToSL2Real γ) • z by rfl] at hCov
  simpa [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoToSL2Real] using hCov

/-- Concrete inverse-eta specialization of the preceding theorem. -/
theorem inverseEtaCore_hasMultiplierMatchedPolygonTrace
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore
      (inverseEtaMultiplier GammaTwo)) :
    HasMultiplierMatchedPolygonTrace
      (inverseEtaMultiplier GammaTwo)
      (Mock2FA.PaperCorrections.AutomorphicSobolev.SmoothCompactCoreGeometry.SmoothCompactWeightCore.toSection u) :=
  smoothCompactWeightCore_hasMultiplierMatchedPolygonTrace u

/-- The concrete Mock2 eta-gauge section satisfies the same paired-edge law,
written with Mock2's constructed eta ratio. -/
theorem etaSection_polygonPairing
    (g : QYM.Mock2EtaCovariantDerivativeExtension.Geometry.SmoothInvariantScalar)
    (e : PolygonEdge)
    (t : PolygonEdgeParameter e) :
    etaSection g
        (polygonEdgeParam e.paired (e.pairedParameter t)) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (polygonEdgeParam e t) *
        etaSection g (polygonEdgeParam e t) := by
  rw [← polygonEdge_pairing_param]
  exact etaSection_covariant g e.pairingElement
    (polygonEdgeParam e t)

/-- The actual eta H1 smooth core therefore has pointwise matched traces
before passage to any completion. -/
theorem etaH1Core_polygonPairing
    (Y : ℝ) (g : etaH1Core Y) (e : PolygonEdge)
    (t : PolygonEdgeParameter e) :
    etaSection g.1
        (polygonEdgeParam e.paired (e.pairedParameter t)) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (polygonEdgeParam e t) *
        etaSection g.1 (polygonEdgeParam e t) :=
  etaSection_polygonPairing g.1 e t

/-! ### Twisted one-form pullback on a paired edge -/

/-- Evaluation of the exact eta-twisted pullback law on a polygon pairing.
The tangent vector is transported by Mathlib's genuine manifold derivative
of the deck transformation.  This is the coordinate-free conormal matching
available before choosing and comparing outward unit normals on both sides. -/
theorem etaTwistedOneForm_polygonPairing_eval
    (A : EtaTwistedOneForm) (e : PolygonEdge)
    (t : PolygonEdgeParameter e) (v : ℂ) :
    A.1 (polygonEdgeParam e.paired (e.pairedParameter t))
        (manifoldDeckDerivative e.pairingElement
          (polygonEdgeParam e t) v) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (polygonEdgeParam e t) *
        A.1 (polygonEdgeParam e t) v := by
  have h := congrArg (fun L : ScalarOneFormValue => L v)
    (A.property e.pairingElement (polygonEdgeParam e t))
  change
    A.1 ((e.pairingElement : SL(2, ℤ)) • polygonEdgeParam e t)
        (manifoldDeckDerivative e.pairingElement
          (polygonEdgeParam e t) v) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (polygonEdgeParam e t) *
        A.1 (polygonEdgeParam e t) v at h
  rw [polygonEdge_pairing_param] at h
  exact h

/-- Concrete specialization to the genuine eta-gauge differential
`eta⁻¹ dg`. -/
theorem etaGaugeDifferential_polygonPairing_eval
    (g : QYM.Mock2EtaCovariantDerivativeExtension.Geometry.SmoothInvariantScalar)
    (e : PolygonEdge)
    (t : PolygonEdgeParameter e) (v : ℂ) :
    etaGaugeDifferential g
        (polygonEdgeParam e.paired (e.pairedParameter t))
        (manifoldDeckDerivative e.pairingElement
          (polygonEdgeParam e t) v) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (polygonEdgeParam e t) *
        etaGaugeDifferential g (polygonEdgeParam e t) v := by
  exact etaTwistedOneForm_polygonPairing_eval
    (covariantDerivativeLinear g) e t v

/-! ### Parameter-oriented derivative traces

The following scalar is the algebraic orientation factor attached to the
proved edge parametrization.  It is useful for checking the sign in a Green
boundary sum.  It is not yet the evaluation of a covector on a geometrically
constructed outward unit normal: that stronger interpretation additionally
requires a theorem identifying the pushforward of the source normal with the
negative target normal.
-/

/-- Algebraic, parameter-oriented derivative trace on an exact polygon edge. -/
def algebraicNormalOrientedTrace
    (Du : ℍ → ℂ) (e : PolygonEdge) (t : PolygonEdgeParameter e) : ℂ :=
  (e.orientationSign : ℂ) * Du (polygonEdgeParam e t)

/-- Covariance of a derivative-like function implies the exact sign relation
forced by the paired-edge orientation and parameter sign.  No normal-vector
pushforward statement is assumed or concluded. -/
theorem pairedEdge_algebraicNormalOrientedTrace_of_covariance
    {k : ℤ} (M' : HalfIntegralMultiplier GammaTwo k)
    (Du : ℍ → ℂ)
    (hcov : ∀ (γ : GammaTwo) (z : ℍ),
      Du ((γ : SL(2, ℤ)) • z) = M'.factor γ z * Du z)
    (e : PolygonEdge) (t : PolygonEdgeParameter e) :
    (e.2.parameterSign : ℂ) *
        algebraicNormalOrientedTrace Du e.paired
          (e.pairedParameter t) =
      -(M'.factor e.pairingElement (polygonEdgeParam e t)) *
        algebraicNormalOrientedTrace Du e t := by
  have hDu :
      Du (polygonEdgeParam e.paired (e.pairedParameter t)) =
        M'.factor e.pairingElement (polygonEdgeParam e t) *
          Du (polygonEdgeParam e t) := by
    rw [← polygonEdge_pairing_param]
    exact hcov e.pairingElement (polygonEdgeParam e t)
  have horientation :
      (e.paired.orientationSign : ℂ) *
          (e.2.parameterSign : ℂ) =
        -(e.orientationSign : ℂ) := by
    exact_mod_cast polygonEdge_pairing_reverses_orientation e
  change
    (e.2.parameterSign : ℂ) *
        ((e.paired.orientationSign : ℂ) *
          Du (polygonEdgeParam e.paired (e.pairedParameter t))) =
      -(M'.factor e.pairingElement (polygonEdgeParam e t)) *
        ((e.orientationSign : ℂ) * Du (polygonEdgeParam e t))
  rw [hDu]
  calc
    (e.2.parameterSign : ℂ) *
        ((e.paired.orientationSign : ℂ) *
          (M'.factor e.pairingElement (polygonEdgeParam e t) *
            Du (polygonEdgeParam e t))) =
      ((e.paired.orientationSign : ℂ) *
          (e.2.parameterSign : ℂ)) *
        (M'.factor e.pairingElement (polygonEdgeParam e t) *
          Du (polygonEdgeParam e t)) := by ring
    _ = (-(e.orientationSign : ℂ)) *
        (M'.factor e.pairingElement (polygonEdgeParam e t) *
          Du (polygonEdgeParam e t)) := by rw [horientation]
    _ = -(M'.factor e.pairingElement (polygonEdgeParam e t)) *
        ((e.orientationSign : ℂ) * Du (polygonEdgeParam e t)) := by
      ring

/-- The underlying scalar function obtained after applying a concrete finite
fixed-phase `R/L` word. -/
noncomputable def fixedPhaseWordFunction
    (n : ℤ) (word : FixedPhaseDifferentialWord)
    (f : SmoothQuotientCompactFunction) : ℍ → ℂ :=
  fun z => (FixedPhaseDifferentialWord.eval n word f :
    SmoothQuotientCompactFunction) z

/-- The previously proved all-word covariance theorem, exposed in the exact
function form needed by the paired-edge sign lemma. -/
theorem fixedPhaseWordFunction_covariance
    (word : FixedPhaseDifferentialWord) {n : ℤ}
    {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (γ : GammaTwo) (z : ℍ) :
    fixedPhaseWordFunction n word f ((γ : SL(2, ℤ)) • z) =
      (inverseEtaPaperOrbitMultiplier GammaTwo
        (FixedPhaseDifferentialWord.targetIndex n word)).factor γ z *
      fixedPhaseWordFunction n word f z := by
  simpa only [fixedPhaseWordFunction] using
    (FixedPhaseDifferentialWord.eval_covariant word hf γ z)

/-- Concrete parameter-orientation sign relation for every finite word in
the actual fixed-phase raising/lowering tower.  As above, this is not named a
geometric outward-normal theorem until normal pushforward is separately
proved. -/
theorem fixedPhaseWord_pairedEdge_algebraicNormalOrientedTrace
    (word : FixedPhaseDifferentialWord) {n : ℤ}
    {f : SmoothQuotientCompactFunction}
    (hf : IsInverseEtaPaperOrbitCovariant n f)
    (e : PolygonEdge) (t : PolygonEdgeParameter e) :
    (e.2.parameterSign : ℂ) *
        algebraicNormalOrientedTrace
          (fixedPhaseWordFunction n word f) e.paired
          (e.pairedParameter t) =
      -((inverseEtaPaperOrbitMultiplier GammaTwo
          (FixedPhaseDifferentialWord.targetIndex n word)).factor
            e.pairingElement (polygonEdgeParam e t)) *
        algebraicNormalOrientedTrace
          (fixedPhaseWordFunction n word f) e t := by
  exact pairedEdge_algebraicNormalOrientedTrace_of_covariance
    (inverseEtaPaperOrbitMultiplier GammaTwo
      (FixedPhaseDifferentialWord.targetIndex n word))
    (fixedPhaseWordFunction n word f)
    (fixedPhaseWordFunction_covariance word hf) e t

/-! ## 3. Horizontal horocycle regularity and its hyperbolic normal model -/

/-- The horizontal height-`H` horocycle as an upper-half-plane curve. -/
def horizontalHorocyclePoint
    (H : ℝ) (hH : 0 < H) (x : ℝ) : ℍ :=
  ⟨(x : ℂ) + (H : ℂ) * Complex.I, by simpa using hH⟩

@[simp]
theorem horizontalHorocyclePoint_re
    (H : ℝ) (hH : 0 < H) (x : ℝ) :
    (horizontalHorocyclePoint H hH x).re = x := by
  simp [horizontalHorocyclePoint]

@[simp]
theorem horizontalHorocyclePoint_im
    (H : ℝ) (hH : 0 < H) (x : ℝ) :
    (horizontalHorocyclePoint H hH x).im = H := by
  simp [horizontalHorocyclePoint]

/-- A horizontal horocycle has no repeated real parameters. -/
theorem horizontalHorocyclePoint_injective
    (H : ℝ) (hH : 0 < H) :
    Function.Injective (horizontalHorocyclePoint H hH) := by
  intro x y hxy
  have hre := congrArg UpperHalfPlane.re hxy
  simpa using hre

/-- The ambient complex curve underlying the horizontal horocycle. -/
def horizontalHorocycleAmbientCurve (H x : ℝ) : ℂ :=
  (x : ℂ) + (H : ℂ) * Complex.I

/-- The ambient horizontal curve is injective, as witnessed by its real
coordinate. -/
theorem horizontalHorocycleAmbientCurve_injective (H : ℝ) :
    Function.Injective (horizontalHorocycleAmbientCurve H) := by
  intro x y hxy
  have hre := congrArg Complex.re hxy
  simpa [horizontalHorocycleAmbientCurve] using hre

/-- Translation of the canonical real-axis embedding is an isometry.  Thus
the displayed horizontal curve is a topological embedding, not merely an
injective immersion. -/
theorem horizontalHorocycleAmbientCurve_isometry (H : ℝ) :
    Isometry (horizontalHorocycleAmbientCurve H) := by
  apply Isometry.of_dist_eq
  intro x y
  calc
    dist (horizontalHorocycleAmbientCurve H x)
        (horizontalHorocycleAmbientCurve H y) =
      dist ((H : ℂ) * Complex.I + (x : ℂ))
        ((H : ℂ) * Complex.I + (y : ℂ)) := by
          simp only [horizontalHorocycleAmbientCurve, add_comm]
    _ = dist (x : ℂ) (y : ℂ) := by rw [dist_add_left]
    _ = dist x y := Complex.isometry_ofReal.dist_eq x y

/-- The ambient horizontal curve is a genuine topological embedding. -/
theorem horizontalHorocycleAmbientCurve_isEmbedding (H : ℝ) :
    IsEmbedding (horizontalHorocycleAmbientCurve H) :=
  (horizontalHorocycleAmbientCurve_isometry H).isEmbedding

/-- Its derivative is the nonzero horizontal tangent `1`. -/
theorem hasDerivAt_horizontalHorocycleAmbientCurve
    (H x : ℝ) :
    HasDerivAt (horizontalHorocycleAmbientCurve H) 1 x := by
  have hreal : HasDerivAt (⇑Complex.ofRealCLM) 1 x :=
    (Complex.ofRealCLM.hasFDerivAt (x := x)).hasDerivAt
  have hfun : (⇑Complex.ofRealCLM : ℝ → ℂ) =
      (fun t : ℝ => (t : ℂ)) := by
    funext t
    rfl
  rw [hfun] at hreal
  change HasDerivAt
    (fun t : ℝ => (t : ℂ) + (H : ℂ) * Complex.I) 1 x
  exact hreal.add_const ((H : ℂ) * Complex.I)

/-- The ambient horizontal curve is smooth to every finite order. -/
theorem contDiff_horizontalHorocycleAmbientCurve (H : ℝ) :
    ContDiff ℝ ∞ (horizontalHorocycleAmbientCurve H) := by
  change ContDiff ℝ (↑(⊤ : ℕ∞))
    (fun x : ℝ => (x : ℂ) + (H : ℂ) * Complex.I)
  simpa [Complex.ofRealCLM_apply] using
    Complex.ofRealCLM.contDiff.add contDiff_const

/-- Proof bundle for the explicitly constructed horizontal smooth embedding
data.
Unlike an assumption record, this structure is inhabited below from proved
theorems for the displayed curve.  Its fields state exactly smoothness,
topological embedding, injectivity, derivative `1`, and nonvanishing of that
tangent. -/
structure SmoothEmbeddedHorizontalHorocycleCertificate (H : ℝ) : Prop where
  contDiff : ContDiff ℝ ∞ (horizontalHorocycleAmbientCurve H)
  isEmbedding : IsEmbedding (horizontalHorocycleAmbientCurve H)
  injective : Function.Injective (horizontalHorocycleAmbientCurve H)
  hasDerivAt_one : ∀ x : ℝ,
    HasDerivAt (horizontalHorocycleAmbientCurve H) 1 x
  tangent_ne_zero : (1 : ℂ) ≠ 0

/-- Unconditional certificate for every real height.  Positive height is
needed only when the same ambient curve is lifted to `ℍ`. -/
def smoothEmbeddedHorizontalHorocycleCertificate (H : ℝ) :
    SmoothEmbeddedHorizontalHorocycleCertificate H where
  contDiff := contDiff_horizontalHorocycleAmbientCurve H
  isEmbedding := horizontalHorocycleAmbientCurve_isEmbedding H
  injective := horizontalHorocycleAmbientCurve_injective H
  hasDerivAt_one := hasDerivAt_horizontalHorocycleAmbientCurve H
  tangent_ne_zero := one_ne_zero

/-- The proof bundle is unconditionally inhabited at every height. -/
instance smoothEmbeddedHorizontalHorocycleCertificate_inhabited (H : ℝ) :
    Inhabited (SmoothEmbeddedHorizontalHorocycleCertificate H) :=
  ⟨smoothEmbeddedHorizontalHorocycleCertificate H⟩

/-- The selected-tile horizontal parametrization is injective as well: the
selected modular transformation is a group action and hence invertible. -/
theorem gammaTwoSelectedHorocycleParam_injective
    (q : GammaTwoRightCoset) (Y : ℝ) :
    Function.Injective (gammaTwoSelectedHorocycleParam q Y) := by
  intro x y hxy
  have hbase := congrArg
    (fun z : ℍ => (gammaTwoCosetRep q)⁻¹ • z) hxy
  simp only [gammaTwoSelectedHorocycleParam, inv_smul_smul] at hbase
  have hre := congrArg UpperHalfPlane.re hbase
  simpa using hre

/-- The real hyperbolic inner product at height `H`, written in the standard
complex tangent coordinate. -/
def horizontalHyperbolicInner
    (H : ℝ) (v w : ℂ) : ℝ :=
  (star v * w).re / H ^ 2

/-- Squared hyperbolic norm at height `H`. -/
def horizontalHyperbolicNormSq (H : ℝ) (v : ℂ) : ℝ :=
  Complex.normSq v / H ^ 2

/-- Positively oriented hyperbolic unit tangent to the height-`H` line. -/
def horizontalHyperbolicUnitTangent (H : ℝ) : ℂ :=
  (H : ℂ)

/-- Outward hyperbolic unit normal for the truncated region `im z ≤ H`. -/
def horizontalHyperbolicOutwardUnitNormal (H : ℝ) : ℂ :=
  (H : ℂ) * Complex.I

/-- The displayed tangent has hyperbolic squared norm one. -/
theorem horizontalHyperbolicUnitTangent_normSq
    {H : ℝ} (hH : 0 < H) :
    horizontalHyperbolicNormSq H
      (horizontalHyperbolicUnitTangent H) = 1 := by
  simp [horizontalHyperbolicNormSq,
    horizontalHyperbolicUnitTangent, Complex.normSq_ofReal,
    pow_two, hH.ne']

/-- The displayed outward normal has hyperbolic squared norm one. -/
theorem horizontalHyperbolicOutwardUnitNormal_normSq
    {H : ℝ} (hH : 0 < H) :
    horizontalHyperbolicNormSq H
      (horizontalHyperbolicOutwardUnitNormal H) = 1 := by
  rw [horizontalHyperbolicNormSq,
    horizontalHyperbolicOutwardUnitNormal,
    Complex.normSq_mul, Complex.normSq_ofReal,
    Complex.normSq_I]
  simp [pow_two, hH.ne']

/-- Tangent and outward normal are orthogonal for the explicit hyperbolic
inner product. -/
theorem horizontalHyperbolic_tangent_inner_normal
    {H : ℝ} (hH : 0 < H) :
    horizontalHyperbolicInner H
      (horizontalHyperbolicUnitTangent H)
      (horizontalHyperbolicOutwardUnitNormal H) = 0 := by
  simp [horizontalHyperbolicInner,
    horizontalHyperbolicUnitTangent,
    horizontalHyperbolicOutwardUnitNormal,
    Complex.mul_re, hH.ne']

/-- The chosen normal points toward increasing height, hence outward from
the standard truncated region `im z ≤ H`. -/
theorem horizontalHyperbolicOutwardUnitNormal_im_pos
    {H : ℝ} (hH : 0 < H) :
    0 < (horizontalHyperbolicOutwardUnitNormal H).im := by
  simpa [horizontalHyperbolicOutwardUnitNormal] using hH

/-! ## 4. The width-two parameter measure and exact arclength -/

/-- Lebesgue measure restricted to one closed width-two cusp parameter
interval.  This module fixes `Icc 0 2`; it does not silently identify a
separately defined endpoint convention. -/
noncomputable def widthTwoParameterMeasure : Measure ℝ :=
  (volume : Measure ℝ).restrict (Set.Icc 0 2)

/-- The width-two parameter measure is finite. -/
noncomputable instance widthTwoParameterMeasure_isFinite :
    IsFiniteMeasure widthTwoParameterMeasure := by
  apply MeasureTheory.isFiniteMeasure_restrict.mpr
  exact (measure_Icc_lt_top :
    (volume : Measure ℝ) (Set.Icc 0 2) < (∞ : ℝ≥0∞)).ne

/-- The total parameter mass is exactly two. -/
theorem widthTwoParameterMeasure_univ :
    widthTwoParameterMeasure Set.univ = 2 := by
  simp [widthTwoParameterMeasure, Real.volume_Icc]

/-- The total algebraic `dx / H` density on the horizontal width-two
segment.  For `0 < H` this is its hyperbolic arclength; the definition is
kept total on `ℝ` so that the identity below has no artificial case split. -/
noncomputable def widthTwoHorizontalHyperbolicArclength (H : ℝ) : ℝ :=
  ∫ _x in (0 : ℝ)..2, H⁻¹

/-- Exact width-two arclength: `2 / H`. -/
theorem widthTwoHorizontalHyperbolicArclength_eq
    (H : ℝ) :
    widthTwoHorizontalHyperbolicArclength H = 2 / H := by
  simp [widthTwoHorizontalHyperbolicArclength, div_eq_mul_inv]

/-- Concrete complex `L2` carrier for one width-two horizontal cusp
parameter.  Calling this a quotient-boundary `L2` space would require the
missing manifold-with-boundary identification. -/
abbrev WidthTwoBoundaryL2 :=
  MeasureTheory.Lp ℂ 2 widthTwoParameterMeasure

/-! ## 5. A concrete eta trace on the smooth core -/

/-- Continuity of the upper-half-plane horizontal parametrization. -/
theorem horizontalHorocyclePoint_continuous
    (H : ℝ) (hH : 0 < H) :
    Continuous (horizontalHorocyclePoint H hH) := by
  have hambient : Continuous
      (fun x : ℝ => (x : ℂ) + (H : ℂ) * Complex.I) :=
    Complex.continuous_ofReal.add continuous_const
  change Continuous (fun x : ℝ =>
    (⟨(x : ℂ) + (H : ℂ) * Complex.I, by simpa using hH⟩ : ℍ))
  exact hambient.upperHalfPlaneMk _

/-- The raw eta-section trace on the standard width-two horizontal
horocycle.  The graph radius and the chosen height use the same real
parameter through the already defined positive cutoff
`gammaTwoCuspLevel Y = max 1 Y`. -/
noncomputable def etaHorizontalTraceRepresentative
    (Y : ℝ) (g : etaH1Core Y) (x : ℝ) : ℂ :=
  etaSection g.1
    (horizontalHorocyclePoint (gammaTwoCuspLevel Y)
      (lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)) x)

/-- Every smooth-core horizontal trace representative is continuous. -/
theorem etaHorizontalTraceRepresentative_continuous
    (Y : ℝ) (g : etaH1Core Y) :
    Continuous (etaHorizontalTraceRepresentative Y g) := by
  exact (etaSection_smooth g.1).continuous.comp
    (horizontalHorocyclePoint_continuous
      (gammaTwoCuspLevel Y)
      (lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)))

/-- A continuous smooth-core trace on the compact width-two interval is in
the concrete finite-measure parameter `L2` space. -/
theorem etaHorizontalTraceRepresentative_memLp
    (Y : ℝ) (g : etaH1Core Y) :
    MemLp (etaHorizontalTraceRepresentative Y g) 2
      widthTwoParameterMeasure := by
  have hcont := etaHorizontalTraceRepresentative_continuous Y g
  have hBounded :
      BddAbove
        ((fun x : ℝ => ‖etaHorizontalTraceRepresentative Y g x‖) ''
          Set.Icc 0 2) :=
    isCompact_Icc.bddAbove_image hcont.norm.continuousOn
  rcases hBounded with ⟨C, hC⟩
  refine MemLp.of_bound
    (p := (2 : ℝ≥0∞)) (μ := widthTwoParameterMeasure)
    hcont.aestronglyMeasurable C ?_
  change ∀ᵐ x ∂((volume : Measure ℝ).restrict (Set.Icc 0 2)),
    ‖etaHorizontalTraceRepresentative Y g x‖ ≤ C
  exact (ae_restrict_mem measurableSet_Icc).mono
    (fun x hx => hC ⟨x, hx, rfl⟩)

/-- The a.e. class of the actual smooth horizontal trace. -/
noncomputable def etaHorizontalTraceToL2
    (Y : ℝ) (g : etaH1Core Y) : WidthTwoBoundaryL2 :=
  (etaHorizontalTraceRepresentative_memLp Y g).toLp
    (etaHorizontalTraceRepresentative Y g)

/-- The concrete horizontal restriction is complex linear on the eta H1
smooth core. -/
noncomputable def etaHorizontalTraceToL2Linear (Y : ℝ) :
    etaH1Core Y →ₗ[ℂ] WidthTwoBoundaryL2 where
  toFun := etaHorizontalTraceToL2 Y
  map_add' g h := by
    have hfun :
        etaHorizontalTraceRepresentative Y (g + h) =
          etaHorizontalTraceRepresentative Y g +
            etaHorizontalTraceRepresentative Y h := by
      funext x
      simp only [etaHorizontalTraceRepresentative, Submodule.coe_add,
        etaSection_add, Pi.add_apply]
    simpa only [etaHorizontalTraceToL2, hfun] using
      (MemLp.toLp_add
        (etaHorizontalTraceRepresentative_memLp Y g)
        (etaHorizontalTraceRepresentative_memLp Y h))
  map_smul' c g := by
    have hfun :
        etaHorizontalTraceRepresentative Y (c • g) =
          c • etaHorizontalTraceRepresentative Y g := by
      funext x
      simp only [etaHorizontalTraceRepresentative, Submodule.coe_smul,
        etaSection_smul, Pi.smul_apply]
    simpa only [etaHorizontalTraceToL2, hfun, RingHom.id_apply] using
      (MemLp.toLp_const_smul c
        (etaHorizontalTraceRepresentative_memLp Y g))

@[simp]
theorem etaHorizontalTraceToL2Linear_apply
    (Y : ℝ) (g : etaH1Core Y) :
    etaHorizontalTraceToL2Linear Y g =
      etaHorizontalTraceToL2 Y g := by
  rfl

/-! ## 6. The trace-enhanced graph closure -/

/-- The old closed-ball eta graph together with the actual width-two
horizontal-cusp `L2` coordinate. -/
abbrev EtaTraceGraphAmbient (Y : ℝ) :=
  WithLp 2 (EtaH1GraphAmbient Y × WidthTwoBoundaryL2)

/-- The strengthened graph map
`g ↦ (old eta H1 graph g, horizontal boundary trace g)`. -/
noncomputable def etaTraceGraphMap (Y : ℝ) :
    etaH1Core Y →ₗ[ℂ] EtaTraceGraphAmbient Y :=
  (WithLp.linearEquiv 2 ℂ
      (EtaH1GraphAmbient Y × WidthTwoBoundaryL2)).symm.toLinearMap.comp
    ((etaH1GraphMap Y).prod (etaHorizontalTraceToL2Linear Y))

@[simp]
theorem etaTraceGraphMap_fst
    (Y : ℝ) (g : etaH1Core Y) :
    (etaTraceGraphMap Y g).fst = etaH1GraphMap Y g := by
  rfl

@[simp]
theorem etaTraceGraphMap_snd
    (Y : ℝ) (g : etaH1Core Y) :
    (etaTraceGraphMap Y g).snd = etaHorizontalTraceToL2 Y g := by
  rfl

/-- The algebraic image of the strengthened smooth graph. -/
noncomputable def etaTraceGraphRange (Y : ℝ) :
    Submodule ℂ (EtaTraceGraphAmbient Y) :=
  LinearMap.range (etaTraceGraphMap Y)

/-- The smooth graph image as a subtype. -/
abbrev EtaTraceGraphCoreImage (Y : ℝ) :=
  etaTraceGraphRange Y

/-- The trace-enhanced completion.  Its norm includes the boundary `L2`
coordinate, so it is stronger than the previously defined eta H1 graph norm
unless an independent trace inequality is later proved. -/
abbrev EtaTraceEnhancedCompletion (Y : ℝ) :=
  (etaTraceGraphRange Y).topologicalClosure

/-- Project-local name for the completion of the automorphic smooth core with
one stored horizontal boundary coordinate.  It means precisely the closure
of the concrete bulk-plus-boundary graph above.  In particular, the name does
not assert that paired-side trace operators have already been extended to
every limiting element, nor identify this carrier with a separately
constructed classical `H1` space on a quotient manifold. -/
abbrev PolygonMatchingSobolev (Y : ℝ) :=
  EtaTraceEnhancedCompletion Y

/-- The path-B name and the trace-enhanced graph closure are definitionally
the same Hilbert carrier. -/
noncomputable def polygonMatchingSobolevEquivTraceEnhanced (Y : ℝ) :
    PolygonMatchingSobolev Y ≃ₗᵢ[ℂ]
      EtaTraceEnhancedCompletion Y :=
  LinearIsometryEquiv.refl ℂ _

@[simp]
theorem polygonMatchingSobolevEquivTraceEnhanced_apply
    (Y : ℝ) (u : PolygonMatchingSobolev Y) :
    polygonMatchingSobolevEquivTraceEnhanced Y u = u := by
  rfl

theorem polygonMatchingSobolevEquivTraceEnhanced_bijective (Y : ℝ) :
    Function.Bijective
      (polygonMatchingSobolevEquivTraceEnhanced Y) :=
  (polygonMatchingSobolevEquivTraceEnhanced Y).bijective

/-- The strengthened graph range lies in its topological closure. -/
theorem etaTraceGraphRange_le_completion (Y : ℝ) :
    etaTraceGraphRange Y ≤
      (etaTraceGraphRange Y).topologicalClosure :=
  Submodule.le_topologicalClosure (etaTraceGraphRange Y)

/-- The trace-enhanced completion is an actual closed subspace. -/
theorem etaTraceEnhancedCompletion_isClosed (Y : ℝ) :
    IsClosed
      ((EtaTraceEnhancedCompletion Y :
        Submodule ℂ (EtaTraceGraphAmbient Y)) :
        Set (EtaTraceGraphAmbient Y)) :=
  Submodule.isClosed_topologicalClosure (etaTraceGraphRange Y)

/-- Isometric inclusion of the smooth graph image into its closure. -/
noncomputable def etaTraceGraphCoreImageInclusion (Y : ℝ) :
    EtaTraceGraphCoreImage Y →ₗᵢ[ℂ]
      EtaTraceEnhancedCompletion Y where
  toFun f :=
    ⟨(f : EtaTraceGraphAmbient Y),
      etaTraceGraphRange_le_completion Y f.property⟩
  map_add' f g := by rfl
  map_smul' c f := by rfl
  norm_map' f := by rfl

/-- Density is obtained from the definition by topological closure; it is not
stored in an input certificate. -/
theorem etaTraceGraphCoreImageInclusion_denseRange (Y : ℝ) :
    DenseRange (etaTraceGraphCoreImageInclusion Y) := by
  change Dense
    (Set.range (fun f : EtaTraceGraphCoreImage Y =>
      etaTraceGraphCoreImageInclusion Y f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : EtaTraceGraphAmbient Y) ∈
      closure
        (Subtype.val ''
          Set.range (fun f : EtaTraceGraphCoreImage Y =>
            etaTraceGraphCoreImageInclusion Y f))
  have hImage :
      Subtype.val ''
          Set.range (fun f : EtaTraceGraphCoreImage Y =>
            etaTraceGraphCoreImageInclusion Y f) =
        ((etaTraceGraphRange Y :
          Submodule ℂ (EtaTraceGraphAmbient Y)) :
          Set (EtaTraceGraphAmbient Y)) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : EtaTraceGraphCoreImage Y := ⟨z, hz⟩
      exact ⟨etaTraceGraphCoreImageInclusion Y f, ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- Continuous projection to the old bulk graph coordinate. -/
noncomputable def etaTraceBulkProjection (Y : ℝ) :
    EtaTraceEnhancedCompletion Y →L[ℂ] EtaH1GraphAmbient Y :=
  (WithLp.fstL 2 ℂ (EtaH1GraphAmbient Y) WidthTwoBoundaryL2).comp
    (Submodule.subtypeL
      ((etaTraceGraphRange Y).topologicalClosure))

/-- Continuous projection to the stored width-two horizontal-cusp `L2`
coordinate.  It is a boundary projection only relative to this strengthened
graph definition, not yet a trace on a proved quotient boundary. -/
noncomputable def etaTraceBoundaryProjection (Y : ℝ) :
    EtaTraceEnhancedCompletion Y →L[ℂ] WidthTwoBoundaryL2 :=
  (WithLp.sndL 2 ℂ (EtaH1GraphAmbient Y) WidthTwoBoundaryL2).comp
    (Submodule.subtypeL
      ((etaTraceGraphRange Y).topologicalClosure))

@[simp]
theorem etaTraceBulkProjection_apply
    (Y : ℝ) (u : EtaTraceEnhancedCompletion Y) :
    etaTraceBulkProjection Y u =
      (u : EtaTraceGraphAmbient Y).fst := by
  rfl

@[simp]
theorem etaTraceBoundaryProjection_apply
    (Y : ℝ) (u : EtaTraceEnhancedCompletion Y) :
    etaTraceBoundaryProjection Y u =
      (u : EtaTraceGraphAmbient Y).snd := by
  rfl

/-- The boundary projection is contractive. -/
theorem etaTraceBoundaryProjection_norm_le
    (Y : ℝ) (u : EtaTraceEnhancedCompletion Y) :
    ‖etaTraceBoundaryProjection Y u‖ ≤ ‖u‖ := by
  change ‖(u : EtaTraceGraphAmbient Y).snd‖ ≤
    ‖(u : EtaTraceGraphAmbient Y)‖
  exact WithLp.norm_snd_le (EtaH1GraphAmbient Y)
    (u : EtaTraceGraphAmbient Y)

/-- The closed zero-horizontal-restriction subspace of the stronger
completion. -/
noncomputable def etaTraceZeroBoundarySubspace (Y : ℝ) :
    Submodule ℂ (EtaTraceEnhancedCompletion Y) :=
  (etaTraceBoundaryProjection Y).ker

/-- The zero-horizontal-restriction subspace is closed because it is the
kernel of the actual continuous stored-coordinate projection. -/
theorem etaTraceZeroBoundarySubspace_isClosed (Y : ℝ) :
    IsClosed
      ((etaTraceZeroBoundarySubspace Y :
        Submodule ℂ (EtaTraceEnhancedCompletion Y)) :
        Set (EtaTraceEnhancedCompletion Y)) :=
  (etaTraceBoundaryProjection Y).isClosed_ker

/-- The trace-enhanced closure is complete. -/
noncomputable def etaTraceEnhancedCompletionCompleteSpace (Y : ℝ) :
    CompleteSpace (EtaTraceEnhancedCompletion Y) :=
  inferInstance

/-- The trace-enhanced closure inherits the complex Hilbert structure of the
`L2` product ambient. -/
noncomputable def etaTraceEnhancedCompletionInnerProductSpace (Y : ℝ) :
    InnerProductSpace ℂ (EtaTraceEnhancedCompletion Y) :=
  inferInstance

/-- The theorem-valued endpoint of the safe trace-enhanced construction. -/
theorem etaTraceEnhancedCompletionCertificate (Y : ℝ) :
    IsClosed
      ((EtaTraceEnhancedCompletion Y :
        Submodule ℂ (EtaTraceGraphAmbient Y)) :
        Set (EtaTraceGraphAmbient Y)) ∧
      DenseRange (etaTraceGraphCoreImageInclusion Y) ∧
      IsClosed
        ((etaTraceZeroBoundarySubspace Y :
          Submodule ℂ (EtaTraceEnhancedCompletion Y)) :
          Set (EtaTraceEnhancedCompletion Y)) ∧
      ∀ u : EtaTraceEnhancedCompletion Y,
        ‖etaTraceBoundaryProjection Y u‖ ≤ ‖u‖ := by
  exact ⟨etaTraceEnhancedCompletion_isClosed Y,
    etaTraceGraphCoreImageInclusion_denseRange Y,
    etaTraceZeroBoundarySubspace_isClosed Y,
    etaTraceBoundaryProjection_norm_le Y⟩

/-!
## Exact remaining boundary

The construction above supplies a genuine bounded map

`EtaTraceEnhancedCompletion Y →L[ℂ] WidthTwoBoundaryL2`.

It does not supply a map from `EtaH1Completion Y`, because the stronger graph
stores the horizontal restriction coordinate in its norm.  Factoring the graph relation
through the old bulk coordinate would require a proved estimate of the form

`norm (etaHorizontalTraceToL2 Y g) ≤ C * etaH1GraphNorm Y g`.

Nor does it prove that this horizontal coordinate is the boundary trace of
the old closed-ball bulk carrier: that comparison must first replace or
identify the old carrier with the literal three-cusp truncation.

Likewise, identifying the target with a classical fractional Sobolev
`H^(1/2)` space would require a separate construction of that space and a
trace/extension theorem on the quotient polygon.  Neither conclusion is
encoded as a field, a postulate, or an opaque certificate here.
-/

end QYM.FullCertification.PolygonTraceExtension


/-!
# P2 actual fixed-phase three-cusp stored-restriction graph

This audited producer strengthens the auxiliary closed-ball model by using
the actual smooth quotient-compact fixed-phase core, all three named scaling
charts, and the pre-existing three-coordinate graph completion.
-/

open Function Set MeasureTheory
open scoped ENNReal MatrixGroups UpperHalfPlane

namespace QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension

open Mock2FA.PaperCorrections.AutomorphicSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry
open Mock2FA.PaperCorrections.AutomorphicSobolev.HalfWeightDifferentialOperators
open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev
open Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhaseGraphCompletion

/-!
# A literal-cusp trace graph on the actual fixed-phase automorphic core

This file replaces the auxiliary closed-ball bulk used by the earlier eta
trace construction with the paper's actual smooth quotient-compact carrier
`InverseEtaFixedPhaseCore n` and its already constructed three-coordinate
graph completion `GraphSobolevCompletion n`.

For every orbit index `n` and truncation parameter `Y`, a core section is
restricted to the standard width-two horizontal line at the literal normalized
cusp height `gammaTwoCuspLevel Y`.  Continuity of the actual smooth section
makes this restriction an element of `L2([0,2], dx)`.  We then close

`u |-> (coreMap n u, horizontalRestriction u)`

inside the Hilbert product of the existing graph completion and that concrete
parameter `L2` space.  The stored restriction coordinate therefore extends to
a bounded projection, its zero-coordinate kernel is closed, and the original
smooth quotient-compact fixed-phase core has dense image by construction.

This is deliberately a trace-*enhanced graph closure*.  It is not claimed to
be a classical `H^(1/2)` trace theorem, and the parameter interval is not
identified here with the topological boundary of a quotient
manifold-with-boundary.  Such identifications require additional quotient
charts and a trace estimate in the pre-existing graph norm.
-/

/-! ## 1. The literal width-two horocycle -/

/-- Positive height used by the literal normalized three-cusp truncation. -/
def actualFixedPhaseCuspHeight (Y : ℝ) : ℝ :=
  gammaTwoCuspLevel Y

theorem actualFixedPhaseCuspHeight_pos (Y : ℝ) :
    0 < actualFixedPhaseCuspHeight Y :=
  lt_of_lt_of_le zero_lt_one (one_le_gammaTwoCuspLevel Y)

/-- Standard horizontal width-two cusp parametrization at the very same
height used by `gammaTwoThreeCuspTruncation Y`. -/
def actualFixedPhaseHorizontalHorocyclePoint
    (Y : ℝ) (x : ℝ) : ℍ :=
  ⟨(x : ℂ) + (actualFixedPhaseCuspHeight Y : ℂ) * Complex.I,
    by simpa using actualFixedPhaseCuspHeight_pos Y⟩

@[simp]
theorem actualFixedPhaseHorizontalHorocyclePoint_re
    (Y x : ℝ) :
    (actualFixedPhaseHorizontalHorocyclePoint Y x).re = x := by
  simp [actualFixedPhaseHorizontalHorocyclePoint]

@[simp]
theorem actualFixedPhaseHorizontalHorocyclePoint_im
    (Y x : ℝ) :
    (actualFixedPhaseHorizontalHorocyclePoint Y x).im =
      gammaTwoCuspLevel Y := by
  simp [actualFixedPhaseHorizontalHorocyclePoint,
    actualFixedPhaseCuspHeight]

theorem actualFixedPhaseHorizontalHorocyclePoint_injective
    (Y : ℝ) :
    Function.Injective (actualFixedPhaseHorizontalHorocyclePoint Y) := by
  intro x y hxy
  have hre := congrArg UpperHalfPlane.re hxy
  simpa using hre

theorem actualFixedPhaseHorizontalHorocyclePoint_continuous
    (Y : ℝ) :
    Continuous (actualFixedPhaseHorizontalHorocyclePoint Y) := by
  have hambient : Continuous
      (fun x : ℝ =>
        (x : ℂ) + (actualFixedPhaseCuspHeight Y : ℂ) * Complex.I) :=
    Complex.continuous_ofReal.add continuous_const
  change Continuous (fun x : ℝ =>
    (⟨(x : ℂ) + (actualFixedPhaseCuspHeight Y : ℂ) * Complex.I,
      by simpa using actualFixedPhaseCuspHeight_pos Y⟩ : ℍ))
  exact hambient.upperHalfPlaneMk _

/-! ## 2. A concrete finite-measure boundary-coordinate carrier -/

/-- Lebesgue measure restricted to the literal width-two parameter interval.
No quotient-boundary interpretation is built into this definition. -/
noncomputable def actualFixedPhaseWidthTwoParameterMeasure : Measure ℝ :=
  (volume : Measure ℝ).restrict (Set.Icc 0 2)

noncomputable instance actualFixedPhaseWidthTwoParameterMeasure_isFinite :
    IsFiniteMeasure actualFixedPhaseWidthTwoParameterMeasure := by
  apply MeasureTheory.isFiniteMeasure_restrict.mpr
  exact (measure_Icc_lt_top :
    (volume : Measure ℝ) (Set.Icc 0 2) < (∞ : ℝ≥0∞)).ne

theorem actualFixedPhaseWidthTwoParameterMeasure_univ :
    actualFixedPhaseWidthTwoParameterMeasure Set.univ = 2 := by
  simp [actualFixedPhaseWidthTwoParameterMeasure, Real.volume_Icc]

/-- Concrete parameter `L2` target for one standard width-two horizontal
restriction. -/
abbrev ActualFixedPhaseWidthTwoL2 :=
  MeasureTheory.Lp ℂ 2 actualFixedPhaseWidthTwoParameterMeasure

/-! ## 3. Restriction of the actual quotient-compact fixed-phase core -/

/-- Pointwise horizontal restriction of an actual fixed-phase smooth
quotient-compact section at the literal cusp height. -/
noncomputable def actualFixedPhaseHorizontalTraceRepresentative
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n)
    (x : ℝ) : ℂ :=
  (u : SmoothQuotientCompactFunction)
    (actualFixedPhaseHorizontalHorocyclePoint Y x)

/-- Smoothness stored in `InverseEtaFixedPhaseCore n` gives continuity of the
literal horizontal restriction. -/
theorem actualFixedPhaseHorizontalTraceRepresentative_continuous
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    Continuous (actualFixedPhaseHorizontalTraceRepresentative n Y u) := by
  exact (u : SmoothQuotientCompactFunction).1.2.continuous.comp
    (actualFixedPhaseHorizontalHorocyclePoint_continuous Y)

/-- A continuous restriction on `[0,2]` defines an actual finite-measure
`L2` coordinate. -/
theorem actualFixedPhaseHorizontalTraceRepresentative_memLp
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    MemLp (actualFixedPhaseHorizontalTraceRepresentative n Y u) 2
      actualFixedPhaseWidthTwoParameterMeasure := by
  have hcont :=
    actualFixedPhaseHorizontalTraceRepresentative_continuous n Y u
  have hBounded :
      BddAbove
        ((fun x : ℝ =>
            ‖actualFixedPhaseHorizontalTraceRepresentative n Y u x‖) ''
          Set.Icc 0 2) :=
    isCompact_Icc.bddAbove_image hcont.norm.continuousOn
  rcases hBounded with ⟨C, hC⟩
  refine MemLp.of_bound
    (p := (2 : ℝ≥0∞))
    (μ := actualFixedPhaseWidthTwoParameterMeasure)
    hcont.aestronglyMeasurable C ?_
  change ∀ᵐ x
      ∂((volume : Measure ℝ).restrict (Set.Icc 0 2)),
    ‖actualFixedPhaseHorizontalTraceRepresentative n Y u x‖ ≤ C
  exact (ae_restrict_mem measurableSet_Icc).mono
    (fun x hx => hC ⟨x, hx, rfl⟩)

/-- The a.e. class of the actual fixed-phase horizontal restriction. -/
noncomputable def actualFixedPhaseHorizontalTraceToL2
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    ActualFixedPhaseWidthTwoL2 :=
  (actualFixedPhaseHorizontalTraceRepresentative_memLp n Y u).toLp
    (actualFixedPhaseHorizontalTraceRepresentative n Y u)

/-- Horizontal restriction is complex-linear on the actual fixed-phase
smooth core. -/
noncomputable def actualFixedPhaseHorizontalTraceToL2Linear
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] ActualFixedPhaseWidthTwoL2 where
  toFun := actualFixedPhaseHorizontalTraceToL2 n Y
  map_add' u v := by
    have hfun :
        actualFixedPhaseHorizontalTraceRepresentative n Y (u + v) =
          actualFixedPhaseHorizontalTraceRepresentative n Y u +
            actualFixedPhaseHorizontalTraceRepresentative n Y v := by
      funext x
      simp only [actualFixedPhaseHorizontalTraceRepresentative,
        InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction,
        Submodule.coe_add, Pi.add_apply]
    simpa only [actualFixedPhaseHorizontalTraceToL2, hfun] using
      (MemLp.toLp_add
        (actualFixedPhaseHorizontalTraceRepresentative_memLp n Y u)
        (actualFixedPhaseHorizontalTraceRepresentative_memLp n Y v))
  map_smul' c u := by
    have hfun :
        actualFixedPhaseHorizontalTraceRepresentative n Y (c • u) =
          c • actualFixedPhaseHorizontalTraceRepresentative n Y u := by
      funext x
      simp only [actualFixedPhaseHorizontalTraceRepresentative,
        InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction,
        Submodule.coe_smul, Pi.smul_apply]
    simpa only [actualFixedPhaseHorizontalTraceToL2, hfun,
      RingHom.id_apply] using
      (MemLp.toLp_const_smul c
        (actualFixedPhaseHorizontalTraceRepresentative_memLp n Y u))

@[simp]
theorem actualFixedPhaseHorizontalTraceToL2Linear_apply
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseHorizontalTraceToL2Linear n Y u =
      actualFixedPhaseHorizontalTraceToL2 n Y u := by
  rfl

/-! ## 4. All three named cusp charts -/

/-- The literal horizontal curve transported by the fixed scaling matrix for
the named cusp `kappa`.  The direction is `sigma_kappa * (x + iH)`, because
`gammaTwoCuspHeight kappa z` is defined using `sigma_kappa^(-1) * z`. -/
def actualFixedPhaseCuspHorocyclePoint
    (kappa : GammaTwoCusp) (Y : ℝ) (x : ℝ) : ℍ :=
  gammaTwoCuspScaling kappa •
    actualFixedPhaseHorizontalHorocyclePoint Y x

/-- The transported curve has exactly the requested local height in its named
scaling chart. -/
@[simp]
theorem gammaTwoCuspHeight_actualFixedPhaseCuspHorocyclePoint
    (kappa : GammaTwoCusp) (Y x : ℝ) :
    gammaTwoCuspHeight kappa
        (actualFixedPhaseCuspHorocyclePoint kappa Y x) =
      gammaTwoCuspLevel Y := by
  simp [actualFixedPhaseCuspHorocyclePoint, gammaTwoCuspHeight]

/-- Every parameter value lies on the already defined named-cusp horocycle at
the literal normalized truncation height. -/
theorem actualFixedPhaseCuspHorocyclePoint_mem
    (kappa : GammaTwoCusp) (Y x : ℝ) :
    actualFixedPhaseCuspHorocyclePoint kappa Y x ∈
      gammaTwoCuspHorocycle kappa (gammaTwoCuspLevel Y) := by
  simpa [gammaTwoCuspHorocycle] using
    gammaTwoCuspHeight_actualFixedPhaseCuspHorocyclePoint kappa Y x

theorem actualFixedPhaseCuspHorocyclePoint_continuous
    (kappa : GammaTwoCusp) (Y : ℝ) :
    Continuous (actualFixedPhaseCuspHorocyclePoint kappa Y) := by
  change Continuous (fun x : ℝ =>
    (gammaTwoCuspScaling kappa : GL (Fin 2) ℝ) •
      actualFixedPhaseHorizontalHorocyclePoint Y x)
  exact
    (continuous_const_smul
      (gammaTwoCuspScaling kappa : GL (Fin 2) ℝ)).comp
      (actualFixedPhaseHorizontalHorocyclePoint_continuous Y)

theorem actualFixedPhaseCuspHorocyclePoint_injective
    (kappa : GammaTwoCusp) (Y : ℝ) :
    Function.Injective (actualFixedPhaseCuspHorocyclePoint kappa Y) := by
  intro x y hxy
  apply actualFixedPhaseHorizontalHorocyclePoint_injective Y
  have hback := congrArg
    (fun z : ℍ => (gammaTwoCuspScaling kappa)⁻¹ • z) hxy
  simpa [actualFixedPhaseCuspHorocyclePoint] using hback

/-- Pointwise restriction in the actual named cusp chart. -/
noncomputable def actualFixedPhaseNamedCuspTraceRepresentative
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) (x : ℝ) : ℂ :=
  (u : SmoothQuotientCompactFunction)
    (actualFixedPhaseCuspHorocyclePoint kappa Y x)

theorem actualFixedPhaseNamedCuspTraceRepresentative_continuous
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    Continuous
      (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u) := by
  exact (u : SmoothQuotientCompactFunction).1.2.continuous.comp
    (actualFixedPhaseCuspHorocyclePoint_continuous kappa Y)

theorem actualFixedPhaseNamedCuspTraceRepresentative_memLp
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    MemLp (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u) 2
      actualFixedPhaseWidthTwoParameterMeasure := by
  have hcont :=
    actualFixedPhaseNamedCuspTraceRepresentative_continuous n kappa Y u
  have hBounded :
      BddAbove
        ((fun x : ℝ =>
            ‖actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u x‖) ''
          Set.Icc 0 2) :=
    isCompact_Icc.bddAbove_image hcont.norm.continuousOn
  rcases hBounded with ⟨C, hC⟩
  refine MemLp.of_bound
    (p := (2 : ℝ≥0∞))
    (μ := actualFixedPhaseWidthTwoParameterMeasure)
    hcont.aestronglyMeasurable C ?_
  change ∀ᵐ x
      ∂((volume : Measure ℝ).restrict (Set.Icc 0 2)),
    ‖actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u x‖ ≤ C
  exact (ae_restrict_mem measurableSet_Icc).mono
    (fun x hx => hC ⟨x, hx, rfl⟩)

/-- The actual named-cusp width-two restriction as an `L2` a.e. class. -/
noncomputable def actualFixedPhaseNamedCuspTraceToL2
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) : ActualFixedPhaseWidthTwoL2 :=
  (actualFixedPhaseNamedCuspTraceRepresentative_memLp n kappa Y u).toLp
    (actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u)

/-- Named-cusp restriction is complex-linear on the actual fixed-phase core. -/
noncomputable def actualFixedPhaseNamedCuspTraceToL2Linear
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ] ActualFixedPhaseWidthTwoL2 where
  toFun := actualFixedPhaseNamedCuspTraceToL2 n kappa Y
  map_add' u v := by
    have hfun :
        actualFixedPhaseNamedCuspTraceRepresentative n kappa Y (u + v) =
          actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u +
            actualFixedPhaseNamedCuspTraceRepresentative n kappa Y v := by
      funext x
      simp only [actualFixedPhaseNamedCuspTraceRepresentative,
        InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction,
        Submodule.coe_add, Pi.add_apply]
    simpa only [actualFixedPhaseNamedCuspTraceToL2, hfun] using
      (MemLp.toLp_add
        (actualFixedPhaseNamedCuspTraceRepresentative_memLp n kappa Y u)
        (actualFixedPhaseNamedCuspTraceRepresentative_memLp n kappa Y v))
  map_smul' c u := by
    have hfun :
        actualFixedPhaseNamedCuspTraceRepresentative n kappa Y (c • u) =
          c • actualFixedPhaseNamedCuspTraceRepresentative n kappa Y u := by
      funext x
      simp only [actualFixedPhaseNamedCuspTraceRepresentative,
        InverseEtaFixedPhaseCore.toSmoothQuotientCompactFunction,
        Submodule.coe_smul, Pi.smul_apply]
    simpa only [actualFixedPhaseNamedCuspTraceToL2, hfun,
      RingHom.id_apply] using
      (MemLp.toLp_const_smul c
        (actualFixedPhaseNamedCuspTraceRepresentative_memLp n kappa Y u))

@[simp]
theorem actualFixedPhaseNamedCuspTraceToL2Linear_apply
    (n : ℤ) (kappa : GammaTwoCusp) (Y : ℝ)
    (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseNamedCuspTraceToL2Linear n kappa Y u =
      actualFixedPhaseNamedCuspTraceToL2 n kappa Y u := by
  rfl

/-- The standard unscaled horizontal trace is the named infinity-cusp trace. -/
theorem actualFixedPhaseNamedCuspTraceRepresentative_atInfinity
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseNamedCuspTraceRepresentative
        n .atInfinity Y u =
      actualFixedPhaseHorizontalTraceRepresentative n Y u := by
  funext x
  simp [actualFixedPhaseNamedCuspTraceRepresentative,
    actualFixedPhaseHorizontalTraceRepresentative,
    actualFixedPhaseCuspHorocyclePoint]

/-- Hilbert direct sum of the three named-cusp parameter `L2` coordinates,
ordered as infinity, zero, and one. -/
abbrev ActualFixedPhaseThreeCuspBoundaryL2 :=
  WithLp 2
    (ActualFixedPhaseWidthTwoL2 ×
      WithLp 2
        (ActualFixedPhaseWidthTwoL2 × ActualFixedPhaseWidthTwoL2))

noncomputable def actualFixedPhaseZeroOneCuspTraceToL2Linear
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      WithLp 2
        (ActualFixedPhaseWidthTwoL2 × ActualFixedPhaseWidthTwoL2) :=
  (WithLp.linearEquiv 2 ℂ
      (ActualFixedPhaseWidthTwoL2 ×
        ActualFixedPhaseWidthTwoL2)).symm.toLinearMap.comp
    ((actualFixedPhaseNamedCuspTraceToL2Linear n .zero Y).prod
      (actualFixedPhaseNamedCuspTraceToL2Linear n .one Y))

/-- Simultaneous Hilbert-valued restriction to all three named cusp charts. -/
noncomputable def actualFixedPhaseThreeCuspTraceToL2Linear
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2 :=
  (WithLp.linearEquiv 2 ℂ
      (ActualFixedPhaseWidthTwoL2 ×
        WithLp 2
          (ActualFixedPhaseWidthTwoL2 ×
            ActualFixedPhaseWidthTwoL2))).symm.toLinearMap.comp
    ((actualFixedPhaseNamedCuspTraceToL2Linear n .atInfinity Y).prod
      (actualFixedPhaseZeroOneCuspTraceToL2Linear n Y))

@[simp]
theorem actualFixedPhaseThreeCuspTraceToL2Linear_atInfinity
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseThreeCuspTraceToL2Linear n Y u).fst =
      actualFixedPhaseNamedCuspTraceToL2 n .atInfinity Y u := by
  rfl

@[simp]
theorem actualFixedPhaseThreeCuspTraceToL2Linear_zero
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseThreeCuspTraceToL2Linear n Y u).snd.fst =
      actualFixedPhaseNamedCuspTraceToL2 n .zero Y u := by
  rfl

@[simp]
theorem actualFixedPhaseThreeCuspTraceToL2Linear_one
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseThreeCuspTraceToL2Linear n Y u).snd.snd =
      actualFixedPhaseNamedCuspTraceToL2 n .one Y u := by
  rfl

/-! ## 5. Product with the existing actual graph completion -/

/-- Hilbert ambient containing the already completed base/raising/lowering
graph and one stored literal-cusp horizontal restriction. -/
abbrev ActualFixedPhaseCuspTraceAmbient (n : ℤ) :=
  WithLp 2
    (GraphSobolevCompletion n × ActualFixedPhaseThreeCuspBoundaryL2)

/-- The strengthened graph map uses the genuine fixed-phase `coreMap` as its
first coordinate; it does not substitute the earlier closed-ball eta graph. -/
noncomputable def actualFixedPhaseCuspTraceGraphMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseCuspTraceAmbient n :=
  (WithLp.linearEquiv 2 ℂ
      (GraphSobolevCompletion n ×
        ActualFixedPhaseThreeCuspBoundaryL2)).symm.toLinearMap.comp
    ((coreMap n).prod (actualFixedPhaseThreeCuspTraceToL2Linear n Y))

@[simp]
theorem actualFixedPhaseCuspTraceGraphMap_fst
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseCuspTraceGraphMap n Y u).fst =
      coreMap n u := by
  rfl

@[simp]
theorem actualFixedPhaseCuspTraceGraphMap_snd
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    (actualFixedPhaseCuspTraceGraphMap n Y u).snd =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u := by
  rfl

/-- The strengthened graph is faithful because its bulk coordinate is the
already injective actual fixed-phase graph-core map. -/
theorem actualFixedPhaseCuspTraceGraphMap_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseCuspTraceGraphMap n Y) := by
  intro u v huv
  apply coreMap_injective n
  simpa using congrArg WithLp.fst huv

/-- Algebraic range of the actual smooth bulk-plus-cusp graph. -/
noncomputable def actualFixedPhaseCuspTraceGraphRange
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseCuspTraceAmbient n) :=
  LinearMap.range (actualFixedPhaseCuspTraceGraphMap n Y)

/-- The trace-enhanced fixed-phase space is the closure of the actual smooth
graph in the product Hilbert space. -/
abbrev ActualFixedPhaseCuspTraceCompletion
    (n : ℤ) (Y : ℝ) :=
  (actualFixedPhaseCuspTraceGraphRange n Y).topologicalClosure

theorem actualFixedPhaseCuspTraceGraphRange_le_completion
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseCuspTraceGraphRange n Y ≤
      (actualFixedPhaseCuspTraceGraphRange n Y).topologicalClosure :=
  Submodule.le_topologicalClosure
    (actualFixedPhaseCuspTraceGraphRange n Y)

theorem actualFixedPhaseCuspTraceCompletion_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      ((ActualFixedPhaseCuspTraceCompletion n Y :
        Submodule ℂ (ActualFixedPhaseCuspTraceAmbient n)) :
        Set (ActualFixedPhaseCuspTraceAmbient n)) :=
  Submodule.isClosed_topologicalClosure
    (actualFixedPhaseCuspTraceGraphRange n Y)

/-! ## 6. The dense map from the literal smooth fixed-phase core -/

/-- Surjection from the original smooth core to its algebraic strengthened
graph range. -/
noncomputable def actualFixedPhaseCuspTraceRangeMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      actualFixedPhaseCuspTraceGraphRange n Y :=
  (actualFixedPhaseCuspTraceGraphMap n Y).rangeRestrict

theorem actualFixedPhaseCuspTraceRangeMap_surjective
    (n : ℤ) (Y : ℝ) :
    Function.Surjective (actualFixedPhaseCuspTraceRangeMap n Y) := by
  rintro ⟨x, u, rfl⟩
  exact ⟨u, rfl⟩

/-- Isometric inclusion of the smooth graph range in its closed completion. -/
noncomputable def actualFixedPhaseCuspTraceRangeInclusion
    (n : ℤ) (Y : ℝ) :
    actualFixedPhaseCuspTraceGraphRange n Y →ₗᵢ[ℂ]
      ActualFixedPhaseCuspTraceCompletion n Y where
  toFun f :=
    ⟨(f : ActualFixedPhaseCuspTraceAmbient n),
      actualFixedPhaseCuspTraceGraphRange_le_completion n Y f.property⟩
  map_add' f g := by rfl
  map_smul' c f := by rfl
  norm_map' f := by rfl

/-- The algebraic graph range is dense in its closure. -/
theorem actualFixedPhaseCuspTraceRangeInclusion_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseCuspTraceRangeInclusion n Y) := by
  change Dense
    (Set.range (fun f : actualFixedPhaseCuspTraceGraphRange n Y =>
      actualFixedPhaseCuspTraceRangeInclusion n Y f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : ActualFixedPhaseCuspTraceAmbient n) ∈
      closure
        (Subtype.val ''
          Set.range
            (fun f : actualFixedPhaseCuspTraceGraphRange n Y =>
              actualFixedPhaseCuspTraceRangeInclusion n Y f))
  have hImage :
      Subtype.val ''
          Set.range
            (fun f : actualFixedPhaseCuspTraceGraphRange n Y =>
              actualFixedPhaseCuspTraceRangeInclusion n Y f) =
        ((actualFixedPhaseCuspTraceGraphRange n Y :
          Submodule ℂ (ActualFixedPhaseCuspTraceAmbient n)) :
          Set (ActualFixedPhaseCuspTraceAmbient n)) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : actualFixedPhaseCuspTraceGraphRange n Y := ⟨z, hz⟩
      exact
        ⟨actualFixedPhaseCuspTraceRangeInclusion n Y f,
          ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- Canonical map of the actual smooth quotient-compact fixed-phase core into
the trace-enhanced closure. -/
noncomputable def actualFixedPhaseCuspTraceCoreMap
    (n : ℤ) (Y : ℝ) :
    InverseEtaFixedPhaseCore n →ₗ[ℂ]
      ActualFixedPhaseCuspTraceCompletion n Y :=
  (actualFixedPhaseCuspTraceRangeInclusion n Y).toLinearMap.comp
    (actualFixedPhaseCuspTraceRangeMap n Y)

/-- The *original smooth fixed-phase core itself*, not merely a renamed range
subtype, has dense image in the enhanced completion. -/
theorem actualFixedPhaseCuspTraceCoreMap_denseRange
    (n : ℤ) (Y : ℝ) :
    DenseRange (actualFixedPhaseCuspTraceCoreMap n Y) := by
  have hs : DenseRange (actualFixedPhaseCuspTraceRangeMap n Y) :=
    (actualFixedPhaseCuspTraceRangeMap_surjective n Y).denseRange
  have hc :=
    (actualFixedPhaseCuspTraceRangeInclusion_denseRange n Y).comp
      hs (actualFixedPhaseCuspTraceRangeInclusion n Y).continuous
  simpa [actualFixedPhaseCuspTraceCoreMap, Function.comp_def] using hc

/-! ## 7. Bounded stored coordinates and the closed zero-trace kernel -/

/-- Bounded projection to the already existing actual graph completion. -/
noncomputable def actualFixedPhaseCuspTraceBulkProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      GraphSobolevCompletion n :=
  (WithLp.fstL 2 ℂ
      (GraphSobolevCompletion n) ActualFixedPhaseThreeCuspBoundaryL2).comp
    (Submodule.subtypeL
      ((actualFixedPhaseCuspTraceGraphRange n Y).topologicalClosure))

/-- Bounded projection to the stored literal-cusp width-two `L2` coordinate. -/
noncomputable def actualFixedPhaseCuspTraceBoundaryProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseThreeCuspBoundaryL2 :=
  (WithLp.sndL 2 ℂ
      (GraphSobolevCompletion n) ActualFixedPhaseThreeCuspBoundaryL2).comp
    (Submodule.subtypeL
      ((actualFixedPhaseCuspTraceGraphRange n Y).topologicalClosure))

/-- Bounded stored coordinate for the infinity cusp. -/
noncomputable def actualFixedPhaseInfinityCuspTraceProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  (WithLp.fstL 2 ℂ
      ActualFixedPhaseWidthTwoL2
      (WithLp 2
        (ActualFixedPhaseWidthTwoL2 ×
          ActualFixedPhaseWidthTwoL2))).comp
    (actualFixedPhaseCuspTraceBoundaryProjection n Y)

/-- Bounded stored coordinate for the zero cusp. -/
noncomputable def actualFixedPhaseZeroCuspTraceProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  (WithLp.fstL 2 ℂ
      ActualFixedPhaseWidthTwoL2 ActualFixedPhaseWidthTwoL2).comp
    ((WithLp.sndL 2 ℂ
        ActualFixedPhaseWidthTwoL2
        (WithLp 2
          (ActualFixedPhaseWidthTwoL2 ×
            ActualFixedPhaseWidthTwoL2))).comp
      (actualFixedPhaseCuspTraceBoundaryProjection n Y))

/-- Bounded stored coordinate for the one cusp. -/
noncomputable def actualFixedPhaseOneCuspTraceProjection
    (n : ℤ) (Y : ℝ) :
    ActualFixedPhaseCuspTraceCompletion n Y →L[ℂ]
      ActualFixedPhaseWidthTwoL2 :=
  (WithLp.sndL 2 ℂ
      ActualFixedPhaseWidthTwoL2 ActualFixedPhaseWidthTwoL2).comp
    ((WithLp.sndL 2 ℂ
        ActualFixedPhaseWidthTwoL2
        (WithLp 2
          (ActualFixedPhaseWidthTwoL2 ×
            ActualFixedPhaseWidthTwoL2))).comp
      (actualFixedPhaseCuspTraceBoundaryProjection n Y))

@[simp]
theorem actualFixedPhaseCuspTraceBulkProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseCuspTraceBulkProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      coreMap n u := by
  rfl

@[simp]
theorem actualFixedPhaseCuspTraceBoundaryProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseCuspTraceBoundaryProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      actualFixedPhaseThreeCuspTraceToL2Linear n Y u := by
  rfl

@[simp]
theorem actualFixedPhaseInfinityCuspTraceProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseInfinityCuspTraceProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      actualFixedPhaseNamedCuspTraceToL2 n .atInfinity Y u := by
  rfl

@[simp]
theorem actualFixedPhaseZeroCuspTraceProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseZeroCuspTraceProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      actualFixedPhaseNamedCuspTraceToL2 n .zero Y u := by
  rfl

@[simp]
theorem actualFixedPhaseOneCuspTraceProjection_core
    (n : ℤ) (Y : ℝ) (u : InverseEtaFixedPhaseCore n) :
    actualFixedPhaseOneCuspTraceProjection n Y
        (actualFixedPhaseCuspTraceCoreMap n Y u) =
      actualFixedPhaseNamedCuspTraceToL2 n .one Y u := by
  rfl

/-- Faithfulness of the old bulk graph makes the new dense smooth-core map
faithful as well. -/
theorem actualFixedPhaseCuspTraceCoreMap_injective
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseCuspTraceCoreMap n Y) := by
  intro u v huv
  apply coreMap_injective n
  have hbulk := congrArg
    (actualFixedPhaseCuspTraceBulkProjection n Y) huv
  simpa using hbulk

/-- The stored literal-cusp coordinate is contractive in the strengthened
graph norm. -/
theorem actualFixedPhaseCuspTraceBoundaryProjection_norm_le
    (n : ℤ) (Y : ℝ)
    (u : ActualFixedPhaseCuspTraceCompletion n Y) :
    ‖actualFixedPhaseCuspTraceBoundaryProjection n Y u‖ ≤ ‖u‖ := by
  change
    ‖(u : ActualFixedPhaseCuspTraceAmbient n).snd‖ ≤
      ‖(u : ActualFixedPhaseCuspTraceAmbient n)‖
  exact WithLp.norm_snd_le (GraphSobolevCompletion n)
    (u : ActualFixedPhaseCuspTraceAmbient n)

/-- Closed zero-horizontal-coordinate subspace of the strengthened actual
fixed-phase completion. -/
noncomputable def actualFixedPhaseCuspTraceZeroBoundarySubspace
    (n : ℤ) (Y : ℝ) :
    Submodule ℂ (ActualFixedPhaseCuspTraceCompletion n Y) :=
  (actualFixedPhaseCuspTraceBoundaryProjection n Y).ker

theorem actualFixedPhaseCuspTraceZeroBoundarySubspace_isClosed
    (n : ℤ) (Y : ℝ) :
    IsClosed
      ((actualFixedPhaseCuspTraceZeroBoundarySubspace n Y :
        Submodule ℂ (ActualFixedPhaseCuspTraceCompletion n Y)) :
        Set (ActualFixedPhaseCuspTraceCompletion n Y)) :=
  (actualFixedPhaseCuspTraceBoundaryProjection n Y).isClosed_ker

/-- The enhanced space is complete as a closed subspace of the Hilbert
product ambient. -/
noncomputable def actualFixedPhaseCuspTraceCompletionCompleteSpace
    (n : ℤ) (Y : ℝ) :
    CompleteSpace (ActualFixedPhaseCuspTraceCompletion n Y) :=
  inferInstance

/-- The enhanced space inherits the complex inner-product structure of the
Hilbert product ambient. -/
noncomputable def actualFixedPhaseCuspTraceCompletionInnerProductSpace
    (n : ℤ) (Y : ℝ) :
    InnerProductSpace ℂ (ActualFixedPhaseCuspTraceCompletion n Y) :=
  inferInstance

/-- The theorem-valued unconditional endpoint of this safe graph closure. -/
theorem actualFixedPhaseCuspTraceGraphCertificate
    (n : ℤ) (Y : ℝ) :
    Function.Injective (actualFixedPhaseCuspTraceCoreMap n Y) ∧
      DenseRange (actualFixedPhaseCuspTraceCoreMap n Y) ∧
      IsClosed
        ((ActualFixedPhaseCuspTraceCompletion n Y :
          Submodule ℂ (ActualFixedPhaseCuspTraceAmbient n)) :
          Set (ActualFixedPhaseCuspTraceAmbient n)) ∧
      IsClosed
        ((actualFixedPhaseCuspTraceZeroBoundarySubspace n Y :
          Submodule ℂ (ActualFixedPhaseCuspTraceCompletion n Y)) :
          Set (ActualFixedPhaseCuspTraceCompletion n Y)) ∧
      ∀ u : ActualFixedPhaseCuspTraceCompletion n Y,
        ‖actualFixedPhaseCuspTraceBoundaryProjection n Y u‖ ≤ ‖u‖ := by
  exact ⟨actualFixedPhaseCuspTraceCoreMap_injective n Y,
    actualFixedPhaseCuspTraceCoreMap_denseRange n Y,
    actualFixedPhaseCuspTraceCompletion_isClosed n Y,
    actualFixedPhaseCuspTraceZeroBoundarySubspace_isClosed n Y,
    actualFixedPhaseCuspTraceBoundaryProjection_norm_le n Y⟩

/-!
## Exact remaining comparison theorem

The new norm contains the actual boundary-coordinate norm.  A bounded map

`GraphSobolevCompletion n -> ActualFixedPhaseThreeCuspBoundaryL2`

would require an estimate on the smooth core of the form

`norm (actualFixedPhaseThreeCuspTraceToL2Linear n Y u)
  <= C * norm (coreMap n u)`.

No such estimate is inferred from continuity of individual smooth functions.
Likewise, the target above is parameter `L2([0,2], dx)`, not a constructed
fractional Sobolev `H^(1/2)` space on a proved quotient boundary.
-/

end QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension


/-!
# P2 intrinsic boundary-component reduction

This audited producer proves unconditional frontier containments and exact
topological reductions.  It exposes, rather than assumes away, the local
filling, horocycle-survival, nonemptiness, separation, and connectedness
obligations needed for an exact three-component theorem.
-/

open Function Set Topology
open scoped MatrixGroups UpperHalfPlane


namespace QYM.FullCertification.P2BoundaryComponentReduction






open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# P2.3 boundary-component reduction

The intrinsic compact stage is `I.XSet Y`.  The dependency proves an exact
finite parametrization of the *upstairs* literal frontier, but it does not
prove that paired polygon sides fill an open quotient neighbourhood, nor
that the three quotient horocycle images are nonempty, connected, and
pairwise separated.  This file therefore does two things without inserting
any conclusion as a structure field:

* it proves the exact open-quotient reduction of the paired-side problem;
* it decomposes the assertion "the quotient boundary has exactly three
  connected components" into explicit propositions and proves that these
  propositions really imply the corresponding `connectedComponentIn`
  classification.

The cusp pieces below are deliberately intersected with the genuine literal
frontier before projecting.  Thus they are an honest boundary *model*; no
equality with the quotient topological frontier is built into a definition.
-/

/-! ## Genuine upstairs pieces and their quotient images -/

/-- The part of the genuine literal frontier carrying a selected polygon
side label.  Internal seams can have more than one label, so no disjointness
between edge labels is claimed. -/
noncomputable def literalSideFrontierPart (Y : ℝ) : Set ℍ :=
  frontier (gammaTwoThreeCuspTruncation Y) ∩
    gammaTwoPairedSideBoundary

/-- The genuine literal-frontier portion lying on a height curve belonging
to the named cusp class `kappa`. -/
noncomputable def literalCuspFrontierPart
    (Y : ℝ) (kappa : GammaTwoCusp) : Set ℍ :=
  frontier (gammaTwoThreeCuspTruncation Y) ∩
    gammaTwoCuspClassHorocycleBoundary kappa Y

/-- Image of the paired-side part.  Proving that this set lies in the
interior of `I.XSet Y` is exactly the missing local two-tile filling step. -/
noncomputable def quotientSideSeamImage (Y : ℝ) : Set GammaTwoQuotient :=
  gammaTwoQuotientMk '' literalSideFrontierPart Y

/-- One named cusp-boundary candidate in the intrinsic quotient. -/
noncomputable def quotientCuspBoundaryPiece
    (Y : ℝ) (kappa : GammaTwoCusp) : Set GammaTwoQuotient :=
  gammaTwoQuotientMk '' literalCuspFrontierPart Y kappa

/-- A point of the frontier of the closed literal stage belongs to that
stage. -/
theorem mem_truncation_of_mem_frontier {Y : ℝ} {z : ℍ}
    (hz : z ∈ frontier (gammaTwoThreeCuspTruncation Y)) :
    z ∈ gammaTwoThreeCuspTruncation Y := by
  have hzClosure := frontier_subset_closure hz
  simpa only [(gammaTwoThreeCuspTruncation_isClosed Y).closure_eq] using
    hzClosure

open scoped Pointwise

/-- Every selected cusp-class horocycle union is closed.  Finiteness of the
right-coset type is essential here. -/
theorem cuspClassHorocycleBoundary_isClosed
    (Y : ℝ) (kappa : GammaTwoCusp) :
    IsClosed (gammaTwoCuspClassHorocycleBoundary kappa Y) := by
  classical
  unfold gammaTwoCuspClassHorocycleBoundary
  exact isClosed_iUnion_of_finite fun q ↦ by
    change IsClosed
      ((gammaTwoCosetRep q.1 : GL (Fin 2) ℝ) •
        {z : ℍ | z.im = gammaTwoCuspLevel Y})
    exact
      (isClosed_eq UpperHalfPlane.continuous_im continuous_const).smul
        (gammaTwoCosetRep q.1 : GL (Fin 2) ℝ)

theorem literalCuspFrontierPart_isClosed
    (Y : ℝ) (kappa : GammaTwoCusp) :
    IsClosed (literalCuspFrontierPart Y kappa) :=
  isClosed_frontier.inter (cuspClassHorocycleBoundary_isClosed Y kappa)

/-- Each genuine upstairs cusp piece is compact. -/
theorem literalCuspFrontierPart_isCompact
    (Y : ℝ) (kappa : GammaTwoCusp) :
    IsCompact (literalCuspFrontierPart Y kappa) := by
  apply (gammaTwoThreeCuspTruncation_isCompact Y).of_isClosed_subset
    (literalCuspFrontierPart_isClosed Y kappa)
  intro z hz
  exact mem_truncation_of_mem_frontier hz.1

/-- Each quotient cusp candidate is compact. -/
theorem quotientCuspBoundaryPiece_isCompact
    (Y : ℝ) (kappa : GammaTwoCusp) :
    IsCompact (quotientCuspBoundaryPiece Y kappa) :=
  (literalCuspFrontierPart_isCompact Y kappa).image
    gammaTwoQuotientMk_isOpenQuotientMap.continuous

/-- The effective quotient is Hausdorff, hence every quotient cusp candidate
is closed. -/
theorem quotientCuspBoundaryPiece_isClosed
    (Y : ℝ) (kappa : GammaTwoCusp) :
    IsClosed (quotientCuspBoundaryPiece Y kappa) :=
  (quotientCuspBoundaryPiece_isCompact Y kappa).isClosed

/-! ## What continuity and openness of the orbit projection prove -/

/-- The frontier of the compact quotient image is contained in the image of
the literal upstairs frontier.  The converse is intentionally absent:
paired sides of a fundamental polygon should project to interior points. -/
theorem frontier_XSet_subset_image_literal_frontier (Y : ℝ) :
    frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ⊆
      gammaTwoQuotientMk ''
        frontier (gammaTwoThreeCuspTruncation Y) := by
  intro x hx
  have hxStage : x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y := by
    have hxClosure := frontier_subset_closure hx
    simpa only [(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_isClosed Y).closure_eq] using hxClosure
  rcases hxStage with ⟨z, hzStage, rfl⟩
  refine ⟨z, ?_, rfl⟩
  rw [(gammaTwoThreeCuspTruncation_isClosed Y).frontier_eq]
  refine ⟨hzStage, ?_⟩
  intro hzInterior
  have hImageOpen :
      IsOpen
        (gammaTwoQuotientMk ''
          interior (gammaTwoThreeCuspTruncation Y)) :=
    gammaTwoQuotientMk_isOpenQuotientMap.isOpenMap _ isOpen_interior
  have hImageSubset :
      gammaTwoQuotientMk ''
          interior (gammaTwoThreeCuspTruncation Y) ⊆ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y :=
    Set.image_mono interior_subset
  have hzQuotientInterior :
      gammaTwoQuotientMk z ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
    interior_maximal hImageSubset hImageOpen ⟨z, hzInterior, rfl⟩
  exact
    ((mem_frontier_iff_notMem_interior
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp hx)
      hzQuotientInterior

/-- Before the side-filling theorem is supplied, the strongest unconditional
quotient-frontier statement is containment in the side-seam image together
with the three cusp candidates. -/
theorem frontier_XSet_subset_sideSeam_union_cuspPieces (Y : ℝ) :
    frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) ⊆
      quotientSideSeamImage Y ∪
        ⋃ kappa : GammaTwoCusp, quotientCuspBoundaryPiece Y kappa := by
  intro x hx
  rcases frontier_XSet_subset_image_literal_frontier Y hx with
    ⟨z, hzFrontier, rfl⟩
  rcases gammaTwoThreeCuspTruncation_frontier_subset Y hzFrontier with
    hzSide | hzHorocycle
  · exact Or.inl ⟨z, ⟨hzFrontier, hzSide⟩, rfl⟩
  · right
    unfold gammaTwoThreeCuspHorocycleBoundary at hzHorocycle
    rcases Set.mem_iUnion.mp hzHorocycle with ⟨kappa, hzKappa⟩
    exact Set.mem_iUnion.2
      ⟨kappa, ⟨z, ⟨hzFrontier, hzKappa⟩, rfl⟩⟩

/-! ## Exact reduction of the paired-side and horocycle obligations -/

/-- Quotient formulation of the missing paired-side theorem. -/
def PairedSidesBecomeInteriorAt (Y : ℝ) : Prop :=
  ∀ z : ℍ, z ∈ literalSideFrontierPart Y →
    gammaTwoQuotientMk z ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)

/-- Upstairs formulation: every genuine paired-side point has a neighbourhood
filled by the saturation of the literal stage.  This is the precise local
two-tile (or finite-star at a vertex) statement that remains to be proved. -/
def LocalSaturationFillsPairedSidesAt (Y : ℝ) : Prop :=
  ∀ z : ℍ, z ∈ literalSideFrontierPart Y →
    z ∈ interior
      (⋃ g : GammaTwoEffective,
        (g • ·) '' gammaTwoThreeCuspTruncation Y)

/-- Openness of the orbit projection makes the quotient and upstairs local
filling formulations exactly equivalent. -/
theorem pairedSidesBecomeInterior_iff_localSaturationFilling (Y : ℝ) :
    PairedSidesBecomeInteriorAt Y ↔
      LocalSaturationFillsPairedSidesAt Y := by
  constructor
  · intro h z hz
    exact
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mp
        (h z hz)
  · intro h z hz
    exact
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mpr
        (h z hz)

/-- A genuine cusp-frontier point remains a boundary point after projection.
This is not automatic from continuity: it excludes another translated tile
from filling the outward side of the horocycle. -/
def HorocyclesRemainBoundaryAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp, ∀ z : ℍ,
    z ∈ literalCuspFrontierPart Y kappa →
      gammaTwoQuotientMk z ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)

/-- Equivalent non-interiority formulation of the horocycle obligation. -/
def HorocyclesRemainNonInteriorAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp, ∀ z : ℍ,
    z ∈ literalCuspFrontierPart Y kappa →
      gammaTwoQuotientMk z ∉ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)

theorem horocyclesRemainBoundary_iff_nonInterior (Y : ℝ) :
    HorocyclesRemainBoundaryAt Y ↔
      HorocyclesRemainNonInteriorAt Y := by
  constructor
  · intro h kappa z hz
    have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
      mem_truncation_of_mem_frontier hz.1
    exact
      (mem_frontier_iff_notMem_interior
        (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp
        (h kappa z hz)
  · intro h kappa z hz
    have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
      mem_truncation_of_mem_frontier hz.1
    exact
      (mem_frontier_iff_notMem_interior
        (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mpr
        (h kappa z hz)

/-- Under local side filling, the projected side seam is disjoint from the
quotient topological frontier. -/
theorem quotientSideSeamImage_disjoint_frontier
    {Y : ℝ} (hSide : PairedSidesBecomeInteriorAt Y) :
    Disjoint (quotientSideSeamImage Y)
      (frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) := by
  refine Set.disjoint_left.mpr ?_
  intro x hxSide hxFrontier
  rcases hxSide with ⟨z, hzSide, rfl⟩
  have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
    mem_truncation_of_mem_frontier hzSide.1
  exact
    ((mem_frontier_iff_notMem_interior
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp hxFrontier)
      (hSide z hzSide)

/-- Under horocycle survival, all three cusp candidates are contained in the
quotient topological frontier. -/
theorem iUnion_cuspPieces_subset_frontier_XSet
    {Y : ℝ} (hHorocycle : HorocyclesRemainBoundaryAt Y) :
    (⋃ kappa : GammaTwoCusp, quotientCuspBoundaryPiece Y kappa) ⊆
      frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) := by
  intro x hx
  rcases Set.mem_iUnion.mp hx with ⟨kappa, hxKappa⟩
  rcases hxKappa with ⟨z, hz, rfl⟩
  exact hHorocycle kappa z hz

/-- Once the two genuinely missing local statements are proved, paired sides
disappear from the quotient frontier and the frontier is exactly the union
of the three honest cusp candidates. -/
theorem frontier_XSet_eq_iUnion_cuspPieces
    {Y : ℝ}
    (hSide : PairedSidesBecomeInteriorAt Y)
    (hHorocycle : HorocyclesRemainBoundaryAt Y) :
    frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
      ⋃ kappa : GammaTwoCusp, quotientCuspBoundaryPiece Y kappa := by
  apply Set.Subset.antisymm
  · intro x hx
    rcases frontier_XSet_subset_image_literal_frontier Y hx with
      ⟨z, hzFrontier, rfl⟩
    rcases gammaTwoThreeCuspTruncation_frontier_subset Y hzFrontier with
      hzSide | hzHorocycle
    · have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
        mem_truncation_of_mem_frontier hzFrontier
      exact False.elim
        (((mem_frontier_iff_notMem_interior
          (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp hx)
          (hSide z ⟨hzFrontier, hzSide⟩))
    · unfold gammaTwoThreeCuspHorocycleBoundary at hzHorocycle
      rcases Set.mem_iUnion.mp hzHorocycle with ⟨kappa, hzKappa⟩
      exact Set.mem_iUnion.2
        ⟨kappa, ⟨z, ⟨hzFrontier, hzKappa⟩, rfl⟩⟩
  · intro x hx
    exact iUnion_cuspPieces_subset_frontier_XSet hHorocycle hx

/-! ## The four geometric obligations for an exact three-cusp boundary -/

def CuspBoundaryPiecesNonemptyAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp,
    (quotientCuspBoundaryPiece Y kappa).Nonempty

def CuspBoundaryPiecesPairwiseDisjointAt (Y : ℝ) : Prop :=
  ∀ kappa lambda : GammaTwoCusp, kappa ≠ lambda →
    Disjoint (quotientCuspBoundaryPiece Y kappa)
      (quotientCuspBoundaryPiece Y lambda)

def CuspBoundaryPiecesConnectedAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp,
    IsConnected (quotientCuspBoundaryPiece Y kappa)

def CuspBoundaryPiecesCoverFrontierAt (Y : ℝ) : Prop :=
  frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
    ⋃ kappa : GammaTwoCusp, quotientCuspBoundaryPiece Y kappa

/-- This is a proposition, not a certificate structure with hidden fields.
It states the four independent assertions required before the phrase
"three cusp boundary pieces" is justified. -/
def ExactThreeCuspBoundaryDecompositionAt (Y : ℝ) : Prop :=
  CuspBoundaryPiecesNonemptyAt Y ∧
    CuspBoundaryPiecesPairwiseDisjointAt Y ∧
    CuspBoundaryPiecesConnectedAt Y ∧
    CuspBoundaryPiecesCoverFrontierAt Y

theorem exactThreeCuspBoundaryDecomposition_iff (Y : ℝ) :
    ExactThreeCuspBoundaryDecompositionAt Y ↔
      CuspBoundaryPiecesNonemptyAt Y ∧
        CuspBoundaryPiecesPairwiseDisjointAt Y ∧
        CuspBoundaryPiecesConnectedAt Y ∧
        CuspBoundaryPiecesCoverFrontierAt Y :=
  Iff.rfl

/-- The two local quotient statements discharge only the frontier-equality
part.  Nonemptiness, class separation, and connectedness remain explicit
geometric goals. -/
theorem exactThreeCuspBoundaryDecomposition_of_geometric_obligations
    {Y : ℝ}
    (hSide : PairedSidesBecomeInteriorAt Y)
    (hHorocycle : HorocyclesRemainBoundaryAt Y)
    (hNonempty : CuspBoundaryPiecesNonemptyAt Y)
    (hDisjoint : CuspBoundaryPiecesPairwiseDisjointAt Y)
    (hConnected : CuspBoundaryPiecesConnectedAt Y) :
    ExactThreeCuspBoundaryDecompositionAt Y := by
  exact ⟨hNonempty, hDisjoint, hConnected,
    frontier_XSet_eq_iUnion_cuspPieces hSide hHorocycle⟩

theorem cuspBoundaryLabel_eq_of_mem
    {Y : ℝ}
    (hDisjoint : CuspBoundaryPiecesPairwiseDisjointAt Y)
    {kappa lambda : GammaTwoCusp} {x : GammaTwoQuotient}
    (hxKappa : x ∈ quotientCuspBoundaryPiece Y kappa)
    (hxLambda : x ∈ quotientCuspBoundaryPiece Y lambda) :
    kappa = lambda := by
  by_contra hne
  exact Set.disjoint_left.mp (hDisjoint kappa lambda hne)
    hxKappa hxLambda

/-- Under an exact decomposition every quotient-boundary point has a unique
cusp label. -/
theorem existsUnique_cuspBoundaryLabel
    {Y : ℝ}
    (hExact : ExactThreeCuspBoundaryDecompositionAt Y)
    {x : GammaTwoQuotient}
    (hx : x ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) :
    ∃! kappa : GammaTwoCusp,
      x ∈ quotientCuspBoundaryPiece Y kappa := by
  rcases hExact with ⟨_hNonempty, hDisjoint, _hConnected, hCover⟩
  have hxUnion :
      x ∈ ⋃ kappa : GammaTwoCusp,
        quotientCuspBoundaryPiece Y kappa := by
    rw [← hCover]
    exact hx
  rcases Set.mem_iUnion.mp hxUnion with ⟨kappa, hxKappa⟩
  refine ⟨kappa, hxKappa, ?_⟩
  intro lambda hxLambda
  exact
    (cuspBoundaryLabel_eq_of_mem hDisjoint hxKappa hxLambda).symm

/-! ## Connected-component classification from the four obligations -/

/-- General finite closed-partition lemma used below.  It verifies that the
four obligations are strong enough to identify actual connected components,
not merely a set-theoretic labelling. -/
theorem connectedComponentIn_eq_piece_of_finite_closed_partition
    {Alpha Iota : Type*} [TopologicalSpace Alpha] [Fintype Iota]
    (s : Set Alpha) (pieces : Iota → Set Alpha)
    (hClosed : ∀ i, IsClosed (pieces i))
    (hDisjoint : ∀ i j, i ≠ j → Disjoint (pieces i) (pieces j))
    (hCover : s = ⋃ i, pieces i)
    (hConnected : ∀ i, IsConnected (pieces i))
    (i : Iota) {x : Alpha} (hx : x ∈ pieces i) :
    connectedComponentIn s x = pieces i := by
  classical
  let others : Set Alpha :=
    ⋃ j : {j : Iota // j ≠ i}, pieces j.1
  have hOthersClosed : IsClosed others := by
    dsimp only [others]
    exact isClosed_iUnion_of_finite fun j ↦ hClosed j.1
  have hxS : x ∈ s := by
    rw [hCover]
    exact Set.mem_iUnion.2 ⟨i, hx⟩
  have hComponentCover :
      connectedComponentIn s x ⊆ pieces i ∪ others := by
    intro y hy
    have hyS := connectedComponentIn_subset s x hy
    rw [hCover] at hyS
    rcases Set.mem_iUnion.mp hyS with ⟨j, hyj⟩
    by_cases hji : j = i
    · left
      simpa only [hji] using hyj
    · right
      exact Set.mem_iUnion.2 ⟨⟨j, hji⟩, hyj⟩
  have hIntersectionEmpty :
      connectedComponentIn s x ∩ (pieces i ∩ others) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.2
    intro y hy
    have hyOthers :
        y ∈ ⋃ j : {j : Iota // j ≠ i}, pieces j.1 := by
      simpa only [others] using hy.2.2
    rcases Set.mem_iUnion.mp hyOthers with ⟨j, hyj⟩
    exact Set.disjoint_left.mp
      (hDisjoint i j.1 (Ne.symm j.2)) hy.2.1 hyj
  have hCases :
      connectedComponentIn s x ⊆ pieces i ∨
        connectedComponentIn s x ⊆ others :=
    (isPreconnected_iff_subset_of_disjoint_closed.mp
      isPreconnected_connectedComponentIn)
      (pieces i) others (hClosed i) hOthersClosed
      hComponentCover hIntersectionEmpty
  have hComponentSubset : connectedComponentIn s x ⊆ pieces i := by
    rcases hCases with hLeft | hRight
    · exact hLeft
    · have hxOther := hRight (mem_connectedComponentIn hxS)
      have hxOthers :
          x ∈ ⋃ j : {j : Iota // j ≠ i}, pieces j.1 := by
        simpa only [others] using hxOther
      rcases Set.mem_iUnion.mp hxOthers with ⟨j, hxj⟩
      exact False.elim
        (Set.disjoint_left.mp
          (hDisjoint i j.1 (Ne.symm j.2)) hx hxj)
  have hPieceSubset : pieces i ⊆ connectedComponentIn s x :=
    (hConnected i).isPreconnected.subset_connectedComponentIn hx (by
      intro y hy
      rw [hCover]
      exact Set.mem_iUnion.2 ⟨i, hy⟩)
  exact Set.Subset.antisymm hComponentSubset hPieceSubset

/-- Hence each named cusp piece is the actual connected component in the
quotient frontier of each of its points. -/
theorem connectedComponentIn_frontier_eq_cuspBoundaryPiece
    {Y : ℝ}
    (hExact : ExactThreeCuspBoundaryDecompositionAt Y)
    (kappa : GammaTwoCusp) {x : GammaTwoQuotient}
    (hx : x ∈ quotientCuspBoundaryPiece Y kappa) :
    connectedComponentIn (frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) x =
      quotientCuspBoundaryPiece Y kappa := by
  rcases hExact with
    ⟨_hNonempty, hDisjoint, hConnected, hCover⟩
  exact connectedComponentIn_eq_piece_of_finite_closed_partition
    (frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y))
    (quotientCuspBoundaryPiece Y)
    (quotientCuspBoundaryPiece_isClosed Y)
    hDisjoint hCover hConnected kappa hx

/-- Exact classification of every connected component of the quotient
frontier by one and only one of the three cusp classes. -/
theorem existsUnique_cuspComponent
    {Y : ℝ}
    (hExact : ExactThreeCuspBoundaryDecompositionAt Y)
    {x : GammaTwoQuotient}
    (hx : x ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) :
    ∃! kappa : GammaTwoCusp,
      connectedComponentIn (frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)) x =
        quotientCuspBoundaryPiece Y kappa := by
  rcases existsUnique_cuspBoundaryLabel hExact hx with
    ⟨kappa, hxKappa, hUnique⟩
  refine ⟨kappa,
    connectedComponentIn_frontier_eq_cuspBoundaryPiece
      hExact kappa hxKappa, ?_⟩
  intro lambda hLambda
  apply hUnique lambda
  rw [← hLambda]
  exact mem_connectedComponentIn hx

/-! ## The raw-cutoff obstruction and the necessary regularity condition -/

/-- A raw exact-three assertion, stated without a certificate structure. -/
def RawExactThreeCuspBoundaryDecompositionAt (Y : ℝ) : Prop :=
  ∃ pieces : GammaTwoCusp → Set GammaTwoQuotient,
    (∀ kappa, (pieces kappa).Nonempty) ∧
      (∀ kappa lambda, kappa ≠ lambda →
        Disjoint (pieces kappa) (pieces lambda)) ∧
      (∀ kappa, IsConnected (pieces kappa)) ∧
      frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.rawUnclippedXSet Y) = ⋃ kappa, pieces kappa

/-- At a nonpositive raw cutoff the stage and its frontier are empty, so an
exact decomposition into three nonempty pieces is impossible. -/
theorem not_rawExactThreeCuspBoundaryDecomposition_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    ¬ RawExactThreeCuspBoundaryDecompositionAt Y := by
  rintro ⟨pieces, hNonempty, _hDisjoint, _hConnected, hCover⟩
  rcases hNonempty GammaTwoCusp.atInfinity with ⟨x, hx⟩
  have hxUnion : x ∈ ⋃ kappa, pieces kappa :=
    Set.mem_iUnion.2 ⟨GammaTwoCusp.atInfinity, hx⟩
  rw [← hCover,
    QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.frontier_rawUnclippedXSet_eq_empty_of_nonpos hY] at hxUnion
  exact hxUnion

/-- Therefore positivity of an unclipped raw height is a logically necessary
condition for any exact-three boundary theorem.  It is not sufficient: local
side filling, horocycle survival, nonemptiness, separation, and connectedness
still have to be proved. -/
theorem zero_lt_of_rawExactThreeCuspBoundaryDecomposition
    {Y : ℝ}
    (hExact : RawExactThreeCuspBoundaryDecompositionAt Y) :
    0 < Y := by
  by_contra hNotPositive
  exact
    (not_rawExactThreeCuspBoundaryDecomposition_of_nonpos
      (le_of_not_gt hNotPositive)) hExact

end QYM.FullCertification.P2BoundaryComponentReduction

