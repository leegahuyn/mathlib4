/-!
# Actual paired normals and finite Green-seam cancellation

This producer advances path B without calling a stored conclusion a proof.
The frozen geometry already gives the actual finite edge labels, exact edge
points, the parameter changes `t |-> -t` or `t |-> t`, orientation signs,
the genuine deck differential, the invariant Green one-form, and finite
corner deletion.  It does **not** yet differentiate the transported edge
parametrizations or identify an outward normal on the selected six-tile
carrier.

Accordingly the two residual geometric statements below are transparent
equalities, not fields of a certificate:

* `ActualPairedEdgeVelocityChainRule` says that the concrete `derivWithin`
  of the displayed edge curve obeys the derivative of the proved parameter
  identity;
* `HasOppositePairedNormalPushforward` says that a proposed normal field is
  carried to the negative normal on the glued edge.

Everything after either equality is proved.  In particular, parameter
change in the one-dimensional Bochner integral, deletion of vertices and
literal horocycle corners, eta-twisted normal-derivative matching, and
cancellation of every finite family of paired seam blocks are not assumed.

The seam-block sum is deliberately distinguished from the raw sum over all
edge labels.  The actual label-pairing map is proved involutive below by a
right-coset calculation, and hence reindexes `Finset.univ` bijectively.
-/

/-! ## 1. Exact real parameter transport -/

/-- The parameter domain of one actual selected-tile edge. -/
abbrev edgeParameterSet (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : Set ℝ :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet e.2

/-- The declared finite endpoint set on the real parameter axis. -/
noncomputable abbrev edgeEndpointSet (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : Set ℝ :=
  (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints e.2 : Set ℝ)

/-- Parameters at which the displayed curve has no finite-vertex issue. -/
noncomputable def regularEdgeParameterSet (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : Set ℝ :=
  edgeParameterSet e \ edgeEndpointSet e

/-- The exact real parameter change attached to a paired edge. -/
def edgeParameterTransport (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℝ :=
  (e.2.parameterSign : ℝ) * t

/-- The real transport is literally the coercion of the existing dependent
paired-parameter map. -/
theorem edgeParameterTransport_eq_pairedParameter
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : QYM.FullCertification.PolygonTraceExtension.PolygonEdgeParameter e) :
    edgeParameterTransport e (t : ℝ) =
      (e.pairedParameter t : ℝ) := by
  cases e.2 <;>
    simp [edgeParameterTransport,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.pairedParameter]

/-- A source parameter is transported to the exact target parameter set. -/
theorem edgeParameterTransport_mem
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ} (ht : t ∈ edgeParameterSet e) :
    edgeParameterTransport e t ∈ edgeParameterSet e.paired := by
  let u : QYM.FullCertification.PolygonTraceExtension.PolygonEdgeParameter e := ⟨t, ht⟩
  rw [edgeParameterTransport_eq_pairedParameter e u]
  exact (e.pairedParameter u).property

/-- Parameter-set membership is preserved in both directions. -/
theorem edgeParameterTransport_mem_iff
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    edgeParameterTransport e t ∈ edgeParameterSet e.paired ↔
      t ∈ edgeParameterSet e := by
  rcases e with ⟨q, e⟩
  cases e with
  | circularArc =>
      simp only [edgeParameterTransport, edgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired,
        Int.cast_neg, Int.cast_one, neg_one_mul, Set.mem_Icc]
      constructor
      · rintro ⟨h₁, h₂⟩
        exact ⟨by linarith, by linarith⟩
      · rintro ⟨h₁, h₂⟩
        exact ⟨by linarith, by linarith⟩
  | leftVerticalSegment =>
      simp [edgeParameterTransport, edgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired]
  | rightVerticalSegment =>
      simp [edgeParameterTransport, edgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired]

/-- The finite endpoint set is transported exactly to the paired endpoint
set. -/
theorem edgeParameterTransport_mem_endpoints_iff
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    edgeParameterTransport e t ∈ edgeEndpointSet e.paired ↔
      t ∈ edgeEndpointSet e := by
  rcases e with ⟨q, e⟩
  cases e <;>
    simp [edgeParameterTransport, edgeEndpointSet,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired]
  constructor
  · rintro (h | h)
    · exact Or.inr h
    · exact Or.inl (by linarith)
  · rintro (h | h)
    · exact Or.inr (by linarith)
    · exact Or.inl h

/-- Hence regular parameters are transported to regular parameters. -/
theorem edgeParameterTransport_mem_regular_iff
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    edgeParameterTransport e t ∈ regularEdgeParameterSet e.paired ↔
      t ∈ regularEdgeParameterSet e := by
  simp only [regularEdgeParameterSet, Set.mem_diff,
    edgeParameterTransport_mem_iff,
    edgeParameterTransport_mem_endpoints_iff]

theorem edgeParameterSet_measurable (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    MeasurableSet (edgeParameterSet e) := by
  rcases e with ⟨q, e⟩
  cases e <;>
    simp [edgeParameterSet, Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet]

theorem regularEdgeParameterSet_measurable (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    MeasurableSet (regularEdgeParameterSet e) := by
  exact (edgeParameterSet_measurable e).diff
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints e.2).measurableSet

/-- The circular substitution `t |-> -t` and the two identity substitutions
preserve the exact edge set integral.  This theorem is valid even in the
nonintegrable branch of the Bochner integral definition. -/
theorem edgeParameterTransport_setIntegral
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (f : ℝ → ℂ) :
    (∫ t in edgeParameterSet e, f (edgeParameterTransport e t)) =
      ∫ t in edgeParameterSet e.paired, f t := by
  rcases e with ⟨q, e⟩
  cases e with
  | circularArc =>
      have h :=
        (Homeomorph.neg ℝ).measurableEmbedding.setIntegral_map
          (μ := (volume : Measure ℝ)) f (Set.Icc (-1 : ℝ) 1)
      change
        (∫ y in Set.Icc (-1 : ℝ) 1, f y
            ∂Measure.map Neg.neg (volume : Measure ℝ)) = _ at h
      rw [Measure.map_neg_eq_self (volume : Measure ℝ)] at h
      simpa [edgeParameterSet, edgeParameterTransport,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired,
        neg_preimage, neg_Icc] using h.symm
  | leftVerticalSegment =>
      simp [edgeParameterSet, edgeParameterTransport,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired]
  | rightVerticalSegment =>
      simp [edgeParameterSet, edgeParameterTransport,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoActualPolygonEdge.paired_second,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeParameterSet,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired]

/-! ## 2. The concrete real-parameter edge curve and its velocity -/

/-- Total real-axis extension of the already constructed exact edge
parametrization.  Only values in `edgeParameterSet e` are subsequently used.
-/
noncomputable def actualEdgePoint
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℍ := by
  classical
  exact if ht : t ∈ edgeParameterSet e then
    QYM.FullCertification.PolygonTraceExtension.polygonEdgeParam e ⟨t, ht⟩
  else UpperHalfPlane.I

@[simp]
theorem actualEdgePoint_of_mem
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ} (ht : t ∈ edgeParameterSet e) :
    actualEdgePoint e t = QYM.FullCertification.PolygonTraceExtension.polygonEdgeParam e ⟨t, ht⟩ := by
  simp [actualEdgePoint, ht]

/-- The total extension agrees with the point field of the existing measured
boundary parametrization. -/
theorem actualEdgePoint_eq_boundaryParametrization_point
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    actualEdgePoint e t =
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoActualPolygonEdgeBoundaryParametrization e).point t := by
  rfl

/-- Exact point pairing in nondependent real-parameter form. -/
theorem actualEdgePoint_pairing
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) {t : ℝ} (ht : t ∈ edgeParameterSet e) :
    (e.pairingElement : SL(2, ℤ)) • actualEdgePoint e t =
      actualEdgePoint e.paired (edgeParameterTransport e t) := by
  have ht' : edgeParameterTransport e t ∈ edgeParameterSet e.paired :=
    edgeParameterTransport_mem e ht
  rw [actualEdgePoint_of_mem e ht,
    actualEdgePoint_of_mem e.paired ht']
  let u : QYM.FullCertification.PolygonTraceExtension.PolygonEdgeParameter e := ⟨t, ht⟩
  have hu :
      (⟨edgeParameterTransport e t, ht'⟩ :
          QYM.FullCertification.PolygonTraceExtension.PolygonEdgeParameter e.paired) =
        e.pairedParameter u := by
    apply Subtype.ext
    exact edgeParameterTransport_eq_pairedParameter e u
  rw [hu]
  exact QYM.FullCertification.PolygonTraceExtension.polygonEdge_pairing_param e u

/-- The actual complex coordinate curve used by the boundary integral. -/
noncomputable def actualEdgeCoordinate
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℝ → ℂ :=
  fun t => (actualEdgePoint e t : ℂ)

/-- Concrete within-derivative of the displayed edge curve.  At a finite
endpoint this value is not advertised as a one-sided geometric tangent; all
chain-rule and cancellation statements below delete the finite endpoint set.
-/
noncomputable def actualEdgeVelocity
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℂ :=
  derivWithin (actualEdgeCoordinate e) (edgeParameterSet e) t

/-- The exact derivative equality still missing from the frozen polygon API,
at one regular parameter. -/
def PairedEdgeVelocityChainRuleAt
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : Prop :=
  d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
      (actualEdgePoint e t) (actualEdgeVelocity e t) =
    ((e.2.parameterSign : ℝ) : ℂ) *
      actualEdgeVelocity e.paired (edgeParameterTransport e t)

/-- Global version of the missing derivative equality, only away from the
finite endpoint sets where both displayed curves have ordinary tangents. -/
def ActualPairedEdgeVelocityChainRule : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      PairedEdgeVelocityChainRuleAt e t

/-- The velocity equality is exactly equivalent to equality after every
continuous real-linear covector; it is not merely a sufficient certificate.
-/
theorem pairedEdgeVelocityChainRuleAt_iff_all_realCovectors
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    PairedEdgeVelocityChainRuleAt e t ↔
      ∀ L : ℂ →L[ℝ] ℂ,
        L (d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
            (actualEdgePoint e t) (actualEdgeVelocity e t)) =
          L (((e.2.parameterSign : ℝ) : ℂ) *
            actualEdgeVelocity e.paired (edgeParameterTransport e t)) := by
  constructor
  · intro h L
    rw [h]
  · intro h
    simpa [PairedEdgeVelocityChainRuleAt] using
      h (ContinuousLinearMap.id ℝ ℂ)

/-- If the geometric velocity chain rule fails, the identity real covector
already witnesses the failure. -/
theorem exists_realCovector_witness_of_velocityChainRuleAt_failure
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ)
    (hFail : ¬ PairedEdgeVelocityChainRuleAt e t) :
    ∃ L : ℂ →L[ℝ] ℂ,
      L (d1 (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.gammaTwoActionCoordinate e.pairingElement)
          (actualEdgePoint e t) (actualEdgeVelocity e t)) ≠
        L (((e.2.parameterSign : ℝ) : ℂ) *
          actualEdgeVelocity e.paired (edgeParameterTransport e t)) := by
  refine ⟨ContinuousLinearMap.id ℝ ℂ, ?_⟩
  simpa [PairedEdgeVelocityChainRuleAt] using hFail

/-! ## 3. Paired normal pushforward and eta normal derivatives -/

/-- A proposed complex-coordinate normal direction on every regular edge.
No outwardness or unit-length claim is hidden in this type alias. -/
abbrev EdgeNormalField := QYM.FullCertification.PolygonTraceExtension.PolygonEdge → ℝ → ℂ

/-- Hyperbolic unit length for a proposed normal: in upper-half-plane
coordinates this is the exact equality `norm N = y`. -/
def IsHyperbolicUnitEdgeField (N : EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      ‖N e t‖ = (actualEdgePoint e t).im

/-- Conformal orthogonality to the concrete edge velocity. -/
def IsOrthogonalToActualEdgeVelocity (N : EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      (star (actualEdgeVelocity e t) * N e t).re = 0

/-- Exact negative-normal pushforward at one paired parameter. -/
def OppositePairedNormalPushforwardAt
    (N : EdgeNormalField) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : Prop :=
  manifoldDeckDerivative e.pairingElement (actualEdgePoint e t) (N e t) =
    -N e.paired (edgeParameterTransport e t)

/-- The genuine residual outward-normal statement.  Unit length and
orthogonality are kept as separate propositions because neither implies the
choice of outward side. -/
def HasOppositePairedNormalPushforward (N : EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      OppositePairedNormalPushforwardAt N e t

/-- As for velocity, the normal equality is equivalent to testing it against
every complex-linear covector. -/
theorem oppositePairedNormalPushforwardAt_iff_all_complexCovectors
    (N : EdgeNormalField) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) :
    OppositePairedNormalPushforwardAt N e t ↔
      ∀ L : ℂ →L[ℂ] ℂ,
        L (manifoldDeckDerivative e.pairingElement
            (actualEdgePoint e t) (N e t)) =
          -L (N e.paired (edgeParameterTransport e t)) := by
  constructor
  · intro h L
    rw [h, map_neg]
  · intro h
    simpa [OppositePairedNormalPushforwardAt] using
      h (ContinuousLinearMap.id ℂ ℂ)

/-- A failed normal pushforward always has an explicit separating covector:
the identity. -/
theorem exists_complexCovector_witness_of_normalPushforwardAt_failure
    (N : EdgeNormalField) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ)
    (hFail : ¬ OppositePairedNormalPushforwardAt N e t) :
    ∃ L : ℂ →L[ℂ] ℂ,
      L (manifoldDeckDerivative e.pairingElement
          (actualEdgePoint e t) (N e t)) ≠
        -L (N e.paired (edgeParameterTransport e t)) := by
  refine ⟨ContinuousLinearMap.id ℂ ℂ, ?_⟩
  simpa [OppositePairedNormalPushforwardAt] using hFail

/-- Evaluation of an actual eta-twisted one-form in a proposed edge-normal
direction. -/
def etaNormalDerivativeTrace
    (A : EtaTwistedOneForm) (N : EdgeNormalField)
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℂ :=
  A.1 (actualEdgePoint e t) (N e t)

/-- Exact inverse-eta multiplier matching required of paired normal
derivatives. -/
def HasEtaPairedNormalDerivative
    (A : EtaTwistedOneForm) (N : EdgeNormalField) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      etaNormalDerivativeTrace A N e.paired
          (edgeParameterTransport e t) =
        -(Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
            e.pairingElement (actualEdgePoint e t) *
          etaNormalDerivativeTrace A N e t)

/-- Genuine deck pullback plus negative-normal pushforward gives the exact
paired normal-derivative multiplier and sign. -/
theorem etaTwistedOneForm_hasPairedNormalDerivative
    (A : EtaTwistedOneForm) (N : EdgeNormalField)
    (hNormal : HasOppositePairedNormalPushforward N) :
    HasEtaPairedNormalDerivative A N := by
  intro e t ht
  have hEval := congrArg (fun L : ScalarOneFormValue => L (N e t))
    (A.property e.pairingElement (actualEdgePoint e t))
  change
    A.1 ((e.pairingElement : SL(2, ℤ)) • actualEdgePoint e t)
        (manifoldDeckDerivative e.pairingElement
          (actualEdgePoint e t) (N e t)) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
          e.pairingElement (actualEdgePoint e t) *
        A.1 (actualEdgePoint e t) (N e t) at hEval
  rw [actualEdgePoint_pairing e ht.1,
    hNormal e t ht] at hEval
  have hNeg := congrArg Neg.neg hEval
  simpa [etaNormalDerivativeTrace] using hNeg

/-- Concrete specialization to the genuine covariant differential
`eta⁻¹ dg`; this is the normal-derivative counterpart of the already proved
tangential pullback theorem on paired polygon edges. -/
theorem etaGaugeDifferential_hasPairedNormalDerivative
    (g : SmoothInvariantScalar) (N : EdgeNormalField)
    (hNormal : HasOppositePairedNormalPushforward N) :
    ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
      t ∈ regularEdgeParameterSet e →
        etaGaugeDifferential g
            (actualEdgePoint e.paired (edgeParameterTransport e t))
            (N e.paired (edgeParameterTransport e t)) =
          -(Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
              e.pairingElement (actualEdgePoint e t) *
            etaGaugeDifferential g (actualEdgePoint e t) (N e t)) := by
  simpa [HasEtaPairedNormalDerivative, etaNormalDerivativeTrace,
    covariantDerivativeLinear] using
    (etaTwistedOneForm_hasPairedNormalDerivative
      (covariantDerivativeLinear g) N hNormal)

/-- Edgewise injectivity is the exact nondegeneracy needed for one chosen
eta-twisted one-form to recover a vector normal from its scalar derivative.
-/
def EtaOneFormSeparatesPairedNormals (A : EtaTwistedOneForm) : Prop :=
  ∀ (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ),
    t ∈ regularEdgeParameterSet e →
      Function.Injective
        (A.1 (actualEdgePoint e.paired (edgeParameterTransport e t)))

/-- For an edgewise nondegenerate eta one-form, paired normal-derivative
matching is not weaker than the negative-normal pushforward: the two are
equivalent. -/
theorem hasEtaPairedNormalDerivative_iff_normalPushforward
    (A : EtaTwistedOneForm) (N : EdgeNormalField)
    (hSeparates : EtaOneFormSeparatesPairedNormals A) :
    HasEtaPairedNormalDerivative A N ↔
      HasOppositePairedNormalPushforward N := by
  constructor
  · intro hMatch e t ht
    apply hSeparates e t ht
    have hEval := congrArg (fun L : ScalarOneFormValue => L (N e t))
      (A.property e.pairingElement (actualEdgePoint e t))
    change
      A.1 ((e.pairingElement : SL(2, ℤ)) • actualEdgePoint e t)
          (manifoldDeckDerivative e.pairingElement
            (actualEdgePoint e t) (N e t)) =
        Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
            e.pairingElement (actualEdgePoint e t) *
          A.1 (actualEdgePoint e t) (N e t) at hEval
    rw [actualEdgePoint_pairing e ht.1] at hEval
    have hMatch' := hMatch e t ht
    change
      A.1 (actualEdgePoint e.paired (edgeParameterTransport e t))
          (N e.paired (edgeParameterTransport e t)) =
        -(Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
            e.pairingElement (actualEdgePoint e t) *
          A.1 (actualEdgePoint e t) (N e t)) at hMatch'
    calc
      A.1 (actualEdgePoint e.paired (edgeParameterTransport e t))
          (manifoldDeckDerivative e.pairingElement
            (actualEdgePoint e t) (N e t)) =
          Mock2.Definition15Geometry.EtaHalfWeight.etaRatio
              e.pairingElement (actualEdgePoint e t) *
            A.1 (actualEdgePoint e t) (N e t) := hEval
      _ = -A.1 (actualEdgePoint e.paired (edgeParameterTransport e t))
            (N e.paired (edgeParameterTransport e t)) := by
          rw [hMatch']
          simp
      _ = A.1 (actualEdgePoint e.paired (edgeParameterTransport e t))
            (-N e.paired (edgeParameterTransport e t)) := by
          rw [map_neg]
  · exact etaTwistedOneForm_hasPairedNormalDerivative A N

/-- Consequently a nondegenerate eta one-form cannot satisfy the desired
normal matching when the actual negative-normal pushforward fails. -/
theorem not_hasEtaPairedNormalDerivative_of_not_normalPushforward
    (A : EtaTwistedOneForm) (N : EdgeNormalField)
    (hSeparates : EtaOneFormSeparatesPairedNormals A)
    (hFail : ¬ HasOppositePairedNormalPushforward N) :
    ¬ HasEtaPairedNormalDerivative A N := by
  exact fun hMatch => hFail
    ((hasEtaPairedNormalDerivative_iff_normalPushforward
      A N hSeparates).mp hMatch)

/-! ## 4. Pointwise invariant-flux cancellation -/

/-- The flux one-form is real-linear in its tangent direction. -/
theorem fluxOneFormValue_real_smul
    (X Y : ℍ → ℂ) (z : ℍ) (r : ℝ) (ξ : ℂ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y z (((r : ℂ) * ξ)) =
      (r : ℂ) * Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y z ξ := by
  simp [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue, Complex.mul_re, Complex.mul_im]
  ring

/-- Every edge parameter sign has square one. -/
theorem edgeParameterSign_sq (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    ((e.2.parameterSign : ℝ) : ℂ) *
        ((e.2.parameterSign : ℝ) : ℂ) = 1 := by
  cases e.2 <;>
    norm_num [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.parameterSign]

/-- Flux density with the actual declared boundary orientation. -/
noncomputable def orientedEdgeFluxDensity
    (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ) : ℂ :=
  (e.orientationSign : ℂ) *
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y (actualEdgePoint e t)
      (actualEdgeVelocity e t)

/-- The actual velocity chain rule, the already-proved invariant one-form
law, and the proved orientation sign force opposite paired densities. -/
theorem orientedEdgeFluxDensity_pair
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) (t : ℝ)
    (ht : t ∈ edgeParameterSet e)
    (hVelocity : PairedEdgeVelocityChainRuleAt e t) :
    orientedEdgeFluxDensity X Y e.paired
        (edgeParameterTransport e t) =
      -orientedEdgeFluxDensity X Y e t := by
  have hFlux := hInv e.pairingElement (actualEdgePoint e t)
    (actualEdgeVelocity e t)
  rw [actualEdgePoint_pairing e ht, hVelocity,
    fluxOneFormValue_real_smul] at hFlux
  have hOrientation :
      (e.paired.orientationSign : ℂ) *
          ((e.2.parameterSign : ℝ) : ℂ) =
        -(e.orientationSign : ℂ) := by
    exact_mod_cast QYM.FullCertification.PolygonTraceExtension.polygonEdge_pairing_reverses_orientation e
  unfold orientedEdgeFluxDensity
  calc
    (e.paired.orientationSign : ℂ) *
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
          (actualEdgePoint e.paired (edgeParameterTransport e t))
          (actualEdgeVelocity e.paired (edgeParameterTransport e t)) =
      ((e.paired.orientationSign : ℂ) *
          ((e.2.parameterSign : ℝ) : ℂ)) *
        (((e.2.parameterSign : ℝ) : ℂ) *
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
            (actualEdgePoint e.paired (edgeParameterTransport e t))
            (actualEdgeVelocity e.paired
              (edgeParameterTransport e t))) := by
        calc
          (e.paired.orientationSign : ℂ) *
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
                (actualEdgePoint e.paired (edgeParameterTransport e t))
                (actualEdgeVelocity e.paired
                  (edgeParameterTransport e t)) =
            (e.paired.orientationSign : ℂ) *
              (1 * Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
                (actualEdgePoint e.paired (edgeParameterTransport e t))
                (actualEdgeVelocity e.paired
                  (edgeParameterTransport e t))) := by ring
          _ = (e.paired.orientationSign : ℂ) *
              ((((e.2.parameterSign : ℝ) : ℂ) *
                  ((e.2.parameterSign : ℝ) : ℂ)) *
                Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
                  (actualEdgePoint e.paired (edgeParameterTransport e t))
                  (actualEdgeVelocity e.paired
                    (edgeParameterTransport e t))) := by
                rw [edgeParameterSign_sq]
          _ = ((e.paired.orientationSign : ℂ) *
                ((e.2.parameterSign : ℝ) : ℂ)) *
              (((e.2.parameterSign : ℝ) : ℂ) *
                Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y
                  (actualEdgePoint e.paired (edgeParameterTransport e t))
                  (actualEdgeVelocity e.paired
                    (edgeParameterTransport e t))) := by ring
    _ = ((e.paired.orientationSign : ℂ) *
          ((e.2.parameterSign : ℝ) : ℂ)) *
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y (actualEdgePoint e t)
          (actualEdgeVelocity e t) := by
        rw [hFlux]
    _ = -((e.orientationSign : ℂ) *
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.fluxOneFormValue X Y (actualEdgePoint e t)
          (actualEdgeVelocity e t)) := by
        rw [hOrientation]
        ring

/-! ## 5. One-dimensional seam integrals and finite cancellation -/

/-- Oriented one-dimensional flux integral over one complete edge parameter
domain. -/
noncomputable def orientedEdgeFluxIntegral
    (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  ∫ t in edgeParameterSet e, orientedEdgeFluxDensity X Y e t

/-- Removing the finite ordinary vertex set does not change one edge flux. -/
theorem orientedEdgeFluxIntegral_remove_endpoints
    (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    (∫ t in regularEdgeParameterSet e,
        orientedEdgeFluxDensity X Y e t) =
      orientedEdgeFluxIntegral X Y e := by
  exact Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.setIntegral_diff_finset_eq
    (orientedEdgeFluxDensity X Y e)
    (edgeParameterSet e) (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints e.2)

/-- Exact paired-edge integral cancellation.  No integrability hypothesis is
needed: parameter transport and finite deletion are identities for the full
Bochner integral, including its nonintegrable-zero branch. -/
theorem orientedEdgeFluxIntegral_pair
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    orientedEdgeFluxIntegral X Y e.paired =
      -orientedEdgeFluxIntegral X Y e := by
  calc
    orientedEdgeFluxIntegral X Y e.paired =
        ∫ t in edgeParameterSet e,
          orientedEdgeFluxDensity X Y e.paired
            (edgeParameterTransport e t) := by
      exact (edgeParameterTransport_setIntegral e
        (orientedEdgeFluxDensity X Y e.paired)).symm
    _ = ∫ t in regularEdgeParameterSet e,
          orientedEdgeFluxDensity X Y e.paired
            (edgeParameterTransport e t) := by
      exact (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.setIntegral_diff_finset_eq
        (fun t => orientedEdgeFluxDensity X Y e.paired
          (edgeParameterTransport e t))
        (edgeParameterSet e) (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints e.2)).symm
    _ = ∫ t in regularEdgeParameterSet e,
          -orientedEdgeFluxDensity X Y e t := by
      apply setIntegral_congr_fun (regularEdgeParameterSet_measurable e)
      intro t ht
      exact orientedEdgeFluxDensity_pair hInv e t ht.1
        (hVelocity e t ht)
    _ = ∫ t in edgeParameterSet e,
          -orientedEdgeFluxDensity X Y e t :=
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.setIntegral_diff_finset_eq
        (fun t => -orientedEdgeFluxDensity X Y e t)
        (edgeParameterSet e) (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.modularTileEdgeEndpoints e.2)
    _ = -orientedEdgeFluxIntegral X Y e := by
      rw [integral_neg, orientedEdgeFluxIntegral]

/-- One paired seam block.  It records both orientations explicitly. -/
noncomputable def pairedSeamFluxBlock
    (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  orientedEdgeFluxIntegral X Y e +
    orientedEdgeFluxIntegral X Y e.paired

theorem pairedSeamFluxBlock_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    pairedSeamFluxBlock X Y e = 0 := by
  rw [pairedSeamFluxBlock,
    orientedEdgeFluxIntegral_pair hInv hVelocity e]
  exact add_neg_cancel _

/-- Every finite family of actual paired seam blocks cancels. -/
theorem finite_pairedSeamFluxBlocks_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (s : Finset QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    (∑ e ∈ s, pairedSeamFluxBlock X Y e) = 0 := by
  apply Finset.sum_eq_zero
  intro e he
  exact pairedSeamFluxBlock_eq_zero hInv hVelocity e

/-- In particular, the finite sum indexed by every actual selected-tile edge
label cancels when written as paired seam blocks. -/
theorem all_pairedSeamFluxBlocks_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, pairedSeamFluxBlock X Y e) = 0 := by
  simpa using finite_pairedSeamFluxBlocks_eq_zero hInv hVelocity
    (Finset.univ : Finset QYM.FullCertification.PolygonTraceExtension.PolygonEdge)

/-! ## 6. Literal horocycle-corner deletion -/

/-- One edge integral after deleting every genuine intersection with the
literal cusp-horocycle frontier. -/
noncomputable def orientedEdgeFluxIntegralAwayFromLiteralCorners
    (Ycut : ℝ) (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  ∫ t in edgeParameterSet e \
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoActualEdgeLiteralCornerRealParameters Ycut e,
    orientedEdgeFluxDensity X Y e t

/-- Literal corners form a finite subset of the **one-dimensional parameter
axis**, so their deletion preserves the edge flux. -/
theorem orientedEdgeFluxIntegralAwayFromLiteralCorners_eq
    (Ycut : ℝ) (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e =
      orientedEdgeFluxIntegral X Y e := by
  apply Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.setIntegral_diff_null_eq
  exact (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoActualEdgeLiteralCornerRealParameters_finite
    Ycut e).measure_zero volume

/-- A paired seam block after deleting genuine literal corners. -/
noncomputable def pairedSeamFluxBlockAwayFromLiteralCorners
    (Ycut : ℝ) (X Y : ℍ → ℂ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e +
    orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e.paired

theorem pairedSeamFluxBlockAwayFromLiteralCorners_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (Ycut : ℝ) (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    pairedSeamFluxBlockAwayFromLiteralCorners Ycut X Y e = 0 := by
  rw [pairedSeamFluxBlockAwayFromLiteralCorners,
    orientedEdgeFluxIntegralAwayFromLiteralCorners_eq,
    orientedEdgeFluxIntegralAwayFromLiteralCorners_eq,
    orientedEdgeFluxIntegral_pair hInv hVelocity e]
  exact add_neg_cancel _

/-- Finite corner-deleted paired seam sums cancel as well. -/
theorem finite_pairedSeamFluxBlocksAwayFromLiteralCorners_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (Ycut : ℝ) (s : Finset QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    (∑ e ∈ s,
      pairedSeamFluxBlockAwayFromLiteralCorners Ycut X Y e) = 0 := by
  apply Finset.sum_eq_zero
  intro e he
  exact pairedSeamFluxBlockAwayFromLiteralCorners_eq_zero
    hInv hVelocity Ycut e

/-! ## 7. Exact reindexing from seam blocks to the raw all-edge sum -/

/-- Right multiplication preserves equality of the selected `Gamma(2)`
right-coset classes.  This isolates the representative-independence needed
for the actual edge-pairing computation. -/
theorem gammaTwoRightCoset_mk_mul_congr_right
    {a b m : SL(2, ℤ)}
    (h : (Quotient.mk'' a : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) =
      (Quotient.mk'' b : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset)) :
    (Quotient.mk'' (a * m) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) =
      (Quotient.mk'' (b * m) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) := by
  apply Quotient.sound'
  rw [QuotientGroup.rightRel_apply]
  have hmem :
      b * a⁻¹ ∈ CongruenceSubgroup.Gamma 2 :=
    QuotientGroup.rightRel_apply.mp (Quotient.exact' h)
  simpa [mul_assoc] using hmem

/-- The full-modular pairing matrices cancel in the selected right-coset
space.  On the vertical sides this is literal inverse cancellation.  On the
circular side `S⁻² = -1`, and the residual central matrix belongs to
`Gamma(2)`. -/
theorem gammaTwoRightCoset_pairingMatrices_cancel
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (edge : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge) :
    (Quotient.mk''
      ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * edge.pairingMatrix⁻¹) *
        edge.paired.pairingMatrix⁻¹) : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) = q := by
  cases edge with
  | circularArc =>
      have hSS :
          ModularGroup.S * ModularGroup.S = (-1 : SL(2, ℤ)) := by
        apply Subtype.ext
        exact ModularGroup.S_mul_S_eq
      have hSinvSinv :
          ModularGroup.S⁻¹ * ModularGroup.S⁻¹ =
            (-1 : SL(2, ℤ)) := by
        have h := congrArg (fun g : SL(2, ℤ) ↦ g⁻¹) hSS
        simpa using h
      have hCircularMatrix :
          ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * ModularGroup.S⁻¹) *
              ModularGroup.S⁻¹) =
            -Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q := by
        calc
          ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * ModularGroup.S⁻¹) *
                ModularGroup.S⁻¹) =
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q *
                (ModularGroup.S⁻¹ * ModularGroup.S⁻¹) := by
                  rw [mul_assoc]
          _ = Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * (-1 : SL(2, ℤ)) := by
                rw [hSinvSinv]
          _ = -Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q := by simp
      calc
        (Quotient.mk''
            ((Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q *
                Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.circularArc.pairingMatrix⁻¹) *
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.circularArc.paired.pairingMatrix⁻¹) :
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) =
            (Quotient.mk'' (-Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q) :
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) := by
                exact congrArg
                  (fun g : SL(2, ℤ) ↦
                    (Quotient.mk'' g : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset))
                  (by
                    simpa [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.pairingMatrix,
                      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired] using
                        hCircularMatrix)
        _ = (Quotient.mk'' (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q) :
              Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) := by
                apply Quotient.sound'
                rw [QuotientGroup.rightRel_apply]
                simpa using Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.neg_one_mem_gammaTwo
        _ = q := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep_mk q
  | leftVerticalSegment =>
      simpa [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.pairingMatrix,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired, mul_assoc] using
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep_mk q
  | rightVerticalSegment =>
      simpa [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.pairingMatrix,
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired, mul_assoc] using
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep_mk q

/-- The actual finite edge-pairing operation is an involution.  The proof
does not assume any compatibility of the chosen representatives: that
compatibility is supplied by `gammaTwoRightCoset_mk_mul_congr_right`. -/
theorem actualPolygonEdge_pairing_involutive
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : e.paired.paired = e := by
  rcases e with ⟨q, edge⟩
  let q' : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset :=
    (Quotient.mk''
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * edge.pairingMatrix⁻¹) :
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset)
  have hRep :
      (Quotient.mk'' (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q') :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) =
        (Quotient.mk''
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * edge.pairingMatrix⁻¹) :
            Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) := by
    calc
      (Quotient.mk'' (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q') :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) = q' := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep_mk q'
      _ = (Quotient.mk''
          (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q * edge.pairingMatrix⁻¹) :
            Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) := rfl
  have hFirst :
      (Quotient.mk''
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q' * edge.paired.pairingMatrix⁻¹) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) = q :=
    (gammaTwoRightCoset_mk_mul_congr_right
      (m := edge.paired.pairingMatrix⁻¹) hRep).trans
        (gammaTwoRightCoset_pairingMatrices_cancel q edge)
  apply Prod.ext
  · change
      (Quotient.mk''
        (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCosetRep q' * edge.paired.pairingMatrix⁻¹) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) = q
    exact hFirst
  · change edge.paired.paired = edge
    exact Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoModularTileEdge.paired_paired edge

/-- The finite actual label-pairing map is bijective. -/
def ActualPolygonEdgePairingBijective : Prop :=
  Function.Bijective (fun e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge => e.paired)

/-- An involution proof is sufficient for the exact finite reindexing. -/
theorem actualPolygonEdgePairingBijective_of_involutive
    (hInvolutive : ∀ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, e.paired.paired = e) :
    ActualPolygonEdgePairingBijective := by
  constructor
  · intro e f hef
    calc
      e = e.paired.paired := (hInvolutive e).symm
      _ = f.paired.paired := congrArg (fun x => x.paired) hef
      _ = f := hInvolutive f
  · intro e
    exact ⟨e.paired, hInvolutive e⟩

/-- Unconditional bijectivity of the concrete actual edge pairing. -/
theorem actualPolygonEdgePairing_bijective :
    ActualPolygonEdgePairingBijective :=
  actualPolygonEdgePairingBijective_of_involutive
    actualPolygonEdge_pairing_involutive

/-- Under a supplied exact finite reindexing, pairwise cancellation upgrades
from the doubled seam-block sum to the raw sum with every edge label appearing
once. -/
theorem all_orientedEdgeFluxIntegrals_eq_zero_of_bijective
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (hPairing : ActualPolygonEdgePairingBijective) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) = 0 := by
  have hReindex :
      (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
        orientedEdgeFluxIntegral X Y e.paired) =
      ∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e := by
    exact hPairing.sum_comp (orientedEdgeFluxIntegral X Y)
  have hNeg :
      (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
        orientedEdgeFluxIntegral X Y e.paired) =
      -(∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) := by
    calc
      (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
          orientedEdgeFluxIntegral X Y e.paired) =
        ∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
          -orientedEdgeFluxIntegral X Y e := by
            apply Finset.sum_congr rfl
            intro e he
            exact orientedEdgeFluxIntegral_pair hInv hVelocity e
      _ = -(∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
          orientedEdgeFluxIntegral X Y e) := by
            rw [Finset.sum_neg_distrib]
  have hSelfNeg :
      (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) =
        -(∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
          orientedEdgeFluxIntegral X Y e) :=
    hReindex.symm.trans hNeg
  have hDouble :
      (2 : ℂ) *
          (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) = 0 := by
    have hAdd :
        (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) +
          (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) = 0 :=
      (eq_neg_iff_add_eq_zero.mp hSelfNeg)
    simpa [two_mul] using hAdd
  exact (mul_eq_zero.mp hDouble).resolve_left (by norm_num)

/-- The raw actual-edge sum vanishes with no label-pairing hypothesis: the
required reindexing is the concrete involution proved above. -/
theorem all_orientedEdgeFluxIntegrals_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e) = 0 :=
  all_orientedEdgeFluxIntegrals_eq_zero_of_bijective
    hInv hVelocity actualPolygonEdgePairing_bijective

/-- The same exact raw-edge conclusion after deleting genuine literal
corners. -/
theorem all_orientedEdgeFluxIntegralsAwayFromLiteralCorners_eq_zero
    {X Y : ℍ → ℂ} (hInv : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGreenBoundary.IsGammaTwoInvariantFlux X Y)
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (Ycut : ℝ) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
      orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e) = 0 := by
  calc
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
        orientedEdgeFluxIntegralAwayFromLiteralCorners Ycut X Y e) =
      ∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge, orientedEdgeFluxIntegral X Y e := by
        apply Finset.sum_congr rfl
        intro e he
        exact orientedEdgeFluxIntegralAwayFromLiteralCorners_eq
          Ycut X Y e
    _ = 0 := all_orientedEdgeFluxIntegrals_eq_zero
      hInv hVelocity

/-! ## 8. Specialization to the actual fixed-phase Green flux -/

/-- Actual oriented edge flux for the concrete fixed-phase Petersson Green
one-form. -/
noncomputable def fixedPhaseOrientedEdgeGreenFluxIntegral
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) : ℂ :=
  orientedEdgeFluxIntegral
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) e

/-- The concrete Green flux cancels on every paired actual seam once the
single geometric edge-velocity chain rule is supplied. -/
theorem fixedPhaseOrientedEdgeGreenFluxIntegral_pair
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    fixedPhaseOrientedEdgeGreenFluxIntegral n u v e.paired =
      -fixedPhaseOrientedEdgeGreenFluxIntegral n u v e := by
  exact orientedEdgeFluxIntegral_pair
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFlux_invariant n u v) hVelocity e

/-- Every finite family of paired blocks for the actual Green flux cancels.
-/
theorem fixedPhase_finitePairedGreenSeamBlocks_eq_zero
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (s : Finset QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    (∑ e ∈ s,
      pairedSeamFluxBlock
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) e) = 0 :=
  finite_pairedSeamFluxBlocks_eq_zero
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFlux_invariant n u v) hVelocity s

/-- Genuine literal corners can be deleted from the same concrete finite
Green-seam cancellation. -/
theorem fixedPhase_finitePairedGreenSeamBlocksAwayFromCorners_eq_zero
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (Ycut : ℝ) (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1))
    (s : Finset QYM.FullCertification.PolygonTraceExtension.PolygonEdge) :
    (∑ e ∈ s,
      pairedSeamFluxBlockAwayFromLiteralCorners Ycut
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxX n u v)
        (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFluxY n u v) e) = 0 :=
  finite_pairedSeamFluxBlocksAwayFromLiteralCorners_eq_zero
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFlux_invariant n u v) hVelocity Ycut s

/-- With exact finite label reindexing, the raw all-edge Green flux itself
vanishes.  This is still a boundary statement; it is not a divergence
theorem equating the area integral to that boundary sum. -/
theorem fixedPhase_allOrientedEdgeGreenFluxIntegrals_eq_zero
    (hVelocity : ActualPairedEdgeVelocityChainRule)
    (n : ℤ) (u : InverseEtaFixedPhaseCore n)
    (v : InverseEtaFixedPhaseCore (n + 1)) :
    (∑ e : QYM.FullCertification.PolygonTraceExtension.PolygonEdge,
      fixedPhaseOrientedEdgeGreenFluxIntegral n u v e) = 0 := by
  exact all_orientedEdgeFluxIntegrals_eq_zero
    (Mock2FA.PaperCorrections.AutomorphicSobolev.DefinitionOneSobolev.FixedPhasePeterssonCoordinates.fixedPhaseGreenFlux_invariant n u v) hVelocity

