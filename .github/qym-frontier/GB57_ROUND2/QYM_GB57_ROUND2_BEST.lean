/-! ## 6. The distinguished smooth inverse-eta section -/

/-- The distinguished inverse-eta quotient section becomes `(x, 1)` under
the global trivialization. -/
theorem distinguishedInverseEtaSection_trivialization
    (x : InverseEtaBase) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph
        (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift x) =
      (x, 1) := by
  apply Prod.ext
  · calc
      (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph
          (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift x)).1 =
          QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection
            (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift x) :=
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph_fst _
      _ = x :=
        (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection
          QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift).projection_toFun x
  · exact QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaSection_coordinate x

/-- Reconstruction of the distinguished section from the constant-one
product section. -/
theorem distinguishedInverseEtaSection_eq_symm_prodOne
    (x : InverseEtaBase) :
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift x =
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.symm (x, 1) := by
  apply QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.injective
  rw [QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.apply_symm_apply]
  exact distinguishedInverseEtaSection_trivialization x

/-- The actual distinguished quotient section is smooth for the transported
atlas. -/
theorem distinguishedInverseEtaSection_contMDiff :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    ContMDiff 𝓘(ℂ) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift).toFun := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    inverseEtaTotalTransportedChartedSpace
  have hPair : ContMDiff 𝓘(ℂ) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      (fun x : InverseEtaBase => (x, (1 : ℂ))) :=
    contMDiff_id.prodMk contMDiff_const
  exact
    (inverseEtaTotalTrivialization_symm_contMDiff.comp hPair).congr
      distinguishedInverseEtaSection_eq_symm_prodOne

/-- The distinguished inverse-eta section as an inhabitant of the smooth
section API. -/
noncomputable def distinguishedSmoothInverseEtaQuotientSection :
    SmoothInverseEtaQuotientSection where
  toQuotientSection :=
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.covariantToSection QYM.FullCertification.P3InverseEtaQuotientBundleExtension.distinguishedInverseEtaLift
  contMDiff_toFun := distinguishedInverseEtaSection_contMDiff

