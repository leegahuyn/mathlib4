namespace QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension










/-!
# P14: global `L²` stage projections and strong exhaustion

The global carrier in this file is the actual quotient `L²` space for the
measure already constructed in P3 from the chosen proved fundamental domain.
For the cofinal natural cutoffs `Y_n = n + 2`, multiplication by the
measurable indicator of `I.XSet Y_n` gives an everywhere-defined bounded
orthogonal projection `P_n`.

The first part of the file constructs the projection directly from
representatives and proves its algebraic, support, range, and self-adjointness
API.  The final part proves strong convergence `P_n u → u` from the literal
pointwise exhaustion and dominated convergence.  No form convergence,
resolvent convergence, or compact-resolvent statement is asserted.
-/

/-! ## 1. The actual global quotient measure and `L²` carrier -/

/-- The global quotient measure used throughout the existing actual-stage
construction.  It is definitionally the quotient measure of the chosen
proved `Gamma(2)` fundamental domain. -/
noncomputable def actualGlobalQuotientMeasure :
    Measure Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure

@[simp]
theorem actualGlobalQuotientMeasure_eq_actualQuotientHyperbolicMeasure :
    actualGlobalQuotientMeasure = QYM.FullCertification.P3ActualStageL2SectionsExtension.actualQuotientHyperbolicMeasure :=
  rfl

/-- Expanded geometric identity for the global measure. -/
theorem actualGlobalQuotientMeasure_eq_chosen_quotientMeasure :
    actualGlobalQuotientMeasure =
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain.quotientMeasure :=
  rfl

/-- The actual global scalar `L²` carrier. -/
abbrev ActualGlobalQuotientL2 :=
  MeasureTheory.Lp ℂ 2 actualGlobalQuotientMeasure

/-- The actual quotient measure is locally finite. -/
noncomputable instance actualGlobalQuotientMeasure_isLocallyFinite :
    IsLocallyFiniteMeasure actualGlobalQuotientMeasure := by
  unfold actualGlobalQuotientMeasure
  infer_instance

/-- The actual quotient measure is positive on every nonempty open set. -/
noncomputable instance actualGlobalQuotientMeasure_isOpenPos :
    Measure.IsOpenPosMeasure actualGlobalQuotientMeasure := by
  unfold actualGlobalQuotientMeasure
  infer_instance

/-! ## 2. A cofinal natural exhaustion -/

/-- The natural paper-range cutoff `Y_n = n + 2`. -/
def naturalStageCutoff (n : ℕ) : ℝ :=
  (n : ℝ) + 2

@[simp]
theorem naturalStageCutoff_apply (n : ℕ) :
    naturalStageCutoff n = (n : ℝ) + 2 :=
  rfl

/-- Every natural cutoff lies strictly above one. -/
theorem one_lt_naturalStageCutoff (n : ℕ) :
    1 < naturalStageCutoff n := by
  unfold naturalStageCutoff
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  linarith

/-- Natural cutoffs are monotone. -/
theorem naturalStageCutoff_monotone : Monotone naturalStageCutoff := by
  intro m n hmn
  unfold naturalStageCutoff
  have hcast := add_le_add_right
    (Nat.cast_le.mpr hmn : (m : ℝ) ≤ (n : ℝ)) 2
  simpa only [add_comm] using hcast

/-- The measurable quotient set at the `n`-th natural cutoff. -/
def naturalStageSet (n : ℕ) : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet (naturalStageCutoff n)

@[simp]
theorem naturalStageSet_apply (n : ℕ) :
    naturalStageSet n = QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet (naturalStageCutoff n) :=
  rfl

/-- Every natural stage set is measurable. -/
theorem naturalStageSet_measurable (n : ℕ) :
    MeasurableSet (naturalStageSet n) :=
  QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_measurable (naturalStageCutoff n)

/-- The natural stage sets form a monotone sequence. -/
theorem naturalStageSet_monotone : Monotone naturalStageSet := by
  intro m n hmn
  exact QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone (naturalStageCutoff_monotone hmn)

/-- Every quotient point belongs to at least one natural stage.  The proof is
the real-indexed geometric exhaustion followed by the Archimedean property of
the natural numbers. -/
theorem exists_mem_naturalStageSet (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    ∃ n : ℕ, x ∈ naturalStageSet n := by
  obtain ⟨Y, _hY, hx⟩ := QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.exists_gt_one_mem_XSet x
  obtain ⟨n, hn⟩ := exists_nat_ge Y
  have hYcut : Y ≤ naturalStageCutoff n := by
    exact hn.trans (by
      unfold naturalStageCutoff
      exact le_add_of_nonneg_right (by norm_num))
  exact ⟨n, QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet_monotone hYcut hx⟩

/-- Membership in the natural exhaustion is eventually permanent. -/
theorem eventually_mem_naturalStageSet (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    ∀ᶠ n in atTop, x ∈ naturalStageSet n := by
  obtain ⟨N, hN⟩ := exists_mem_naturalStageSet x
  filter_upwards [eventually_ge_atTop N] with n hn
  exact naturalStageSet_monotone hn hN

/-- The natural subsystem already exhausts the entire quotient. -/
theorem iUnion_naturalStageSet_eq_univ :
    (⋃ n : ℕ, naturalStageSet n) =
      (Set.univ : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) := by
  apply Set.eq_univ_of_forall
  intro x
  obtain ⟨n, hn⟩ := exists_mem_naturalStageSet x
  exact Set.mem_iUnion.2 ⟨n, hn⟩

/-! ## 3. Representative-level indicator projection -/

/-- Literal representative of the `n`-th global stage projection. -/
def globalStageProjectionRepresentative
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ :=
  (naturalStageSet n).indicator
    (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ)

@[simp]
theorem globalStageProjectionRepresentative_apply
    (n : ℕ) (u : ActualGlobalQuotientL2)
    (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    globalStageProjectionRepresentative n u x =
      (naturalStageSet n).indicator
        (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) x :=
  rfl

/-- Indicator multiplication preserves global square integrability. -/
theorem globalStageProjectionRepresentative_memLp
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    MemLp (globalStageProjectionRepresentative n u) 2
      actualGlobalQuotientMeasure := by
  exact (MeasureTheory.Lp.memLp u).indicator
    (naturalStageSet_measurable n)

/-- The `L²` class obtained from the literal indicator representative. -/
noncomputable def globalStageProjection
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    ActualGlobalQuotientL2 :=
  (globalStageProjectionRepresentative_memLp n u).toLp
    (globalStageProjectionRepresentative n u)

/-- Exact a.e. coefficient formula for the global stage projection. -/
theorem globalStageProjection_coeFn_ae
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    ((globalStageProjection n u : ActualGlobalQuotientL2) :
      Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[actualGlobalQuotientMeasure]
        globalStageProjectionRepresentative n u :=
  (globalStageProjectionRepresentative_memLp n u).coeFn_toLp

/-- On the stage, `P_n u` agrees a.e. with `u`. -/
theorem globalStageProjection_eq_ae_on_stage
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    ∀ᵐ x ∂actualGlobalQuotientMeasure,
      x ∈ naturalStageSet n → globalStageProjection n u x = u x := by
  filter_upwards [globalStageProjection_coeFn_ae n u] with x hx hmem
  rw [hx, globalStageProjectionRepresentative,
    Set.indicator_of_mem hmem]

/-- Off the stage, `P_n u` vanishes a.e. -/
theorem globalStageProjection_eq_zero_ae_off_stage
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    ∀ᵐ x ∂actualGlobalQuotientMeasure,
      x ∉ naturalStageSet n → globalStageProjection n u x = 0 := by
  filter_upwards [globalStageProjection_coeFn_ae n u] with x hx hnot
  rw [hx, globalStageProjectionRepresentative,
    Set.indicator_of_notMem hnot]

/-- Indicator multiplication is contractive in global `L²`. -/
theorem globalStageProjection_norm_le
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    ‖globalStageProjection n u‖ ≤ ‖u‖ := by
  rw [globalStageProjection, MeasureTheory.Lp.norm_toLp,
    MeasureTheory.Lp.norm_def]
  exact ENNReal.toReal_mono (MeasureTheory.Lp.eLpNorm_ne_top u)
    (eLpNorm_indicator_le
      (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ))

/-- Additivity of the indicator projection. -/
theorem globalStageProjection_add
    (n : ℕ) (u v : ActualGlobalQuotientL2) :
    globalStageProjection n (u + v) =
      globalStageProjection n u + globalStageProjection n v := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [globalStageProjection_coeFn_ae n (u + v),
      globalStageProjection_coeFn_ae n u,
      globalStageProjection_coeFn_ae n v,
      MeasureTheory.Lp.coeFn_add u v,
      MeasureTheory.Lp.coeFn_add
        (globalStageProjection n u) (globalStageProjection n v)]
    with x hsum hu hv huv hout
  rw [hsum, hout, Pi.add_apply, hu, hv]
  by_cases hx : x ∈ naturalStageSet n
  · change x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx,
      Set.indicator_of_mem hx]
    simpa only [Pi.add_apply] using huv
  · change x ∉ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx,
      Set.indicator_of_notMem hx]
    simp

/-- Complex homogeneity of the indicator projection. -/
/-- Complex homogeneity of the indicator projection. -/
theorem globalStageProjection_smul
    (n : ℕ) (c : ℂ) (u : ActualGlobalQuotientL2) :
    globalStageProjection n (c • u) =
      c • globalStageProjection n u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [globalStageProjection_coeFn_ae n (c • u),
      globalStageProjection_coeFn_ae n u,
      MeasureTheory.Lp.coeFn_smul c u,
      MeasureTheory.Lp.coeFn_smul c (globalStageProjection n u)]
    with x hleft hu hcu hright
  rw [hleft, hright, Pi.smul_apply, hu]
  by_cases hx : x ∈ naturalStageSet n
  · change x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
    simpa only [Pi.smul_apply, smul_eq_mul] using hcu
  · change x ∉ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
    simp

/-! ## 4. The bounded global projection operator -/
/-! ## 4. The bounded global projection operator -/

/-- Algebraic linear map underlying the `n`-th global projection. -/
noncomputable def globalStageProjectionLinearMap (n : ℕ) :
    ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2 where
  toFun := globalStageProjection n
  map_add' := globalStageProjection_add n
  map_smul' := globalStageProjection_smul n

@[simp]
theorem globalStageProjectionLinearMap_apply
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjectionLinearMap n u = globalStageProjection n u :=
  rfl

/-- The `n`-th global stage projection as a bounded complex-linear
contraction. -/
noncomputable def globalStageProjectionCLM (n : ℕ) :
    ActualGlobalQuotientL2 →L[ℂ] ActualGlobalQuotientL2 :=
  (globalStageProjectionLinearMap n).mkContinuous 1 (fun u => by
    simpa only [one_mul, globalStageProjectionLinearMap_apply] using
      globalStageProjection_norm_le n u)

@[simp]
theorem globalStageProjectionCLM_apply
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjectionCLM n u = globalStageProjection n u :=
  rfl

/-- Operator norm at most one. -/
theorem globalStageProjectionCLM_norm_le_one (n : ℕ) :
    ‖globalStageProjectionCLM n‖ ≤ 1 := by
  exact LinearMap.mkContinuous_norm_le _ zero_le_one (fun u => by
    simpa only [one_mul, globalStageProjectionLinearMap_apply] using
      globalStageProjection_norm_le n u)

/-! ## 5. Orthogonal-projection algebra -/

/-- Indicator multiplication is idempotent at the `L²` class level. -/
theorem globalStageProjection_idempotent
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjection n (globalStageProjection n u) =
      globalStageProjection n u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [globalStageProjection_coeFn_ae n (globalStageProjection n u),
      globalStageProjection_coeFn_ae n u]
    with x houter hinner
  rw [houter]
  by_cases hx : x ∈ naturalStageSet n
  · rw [globalStageProjectionRepresentative,
      Set.indicator_of_mem hx]
  · rw [globalStageProjectionRepresentative,
      Set.indicator_of_notMem hx, hinner,
      globalStageProjectionRepresentative,
      Set.indicator_of_notMem hx]

/-- Operator-level idempotence. -/
theorem globalStageProjectionCLM_comp_self (n : ℕ) :
    (globalStageProjectionCLM n).comp (globalStageProjectionCLM n) =
      globalStageProjectionCLM n := by
  apply ContinuousLinearMap.ext
  intro u
  rw [ContinuousLinearMap.comp_apply,
    globalStageProjectionCLM_apply,
    globalStageProjectionCLM_apply,
    globalStageProjection_idempotent]

/-- The indicator multiplier is symmetric in the global `L²` inner
product. -/
theorem globalStageProjectionCLM_inner_symmetric
    (n : ℕ) (u v : ActualGlobalQuotientL2) :
    inner ℂ (globalStageProjectionCLM n u) v =
      inner ℂ u (globalStageProjectionCLM n v) := by
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards
    [globalStageProjection_coeFn_ae n u,
      globalStageProjection_coeFn_ae n v]
    with x hu hv
  rw [globalStageProjectionCLM_apply, globalStageProjectionCLM_apply,
    hu, hv]
  by_cases hx : x ∈ naturalStageSet n
  · simp only [globalStageProjectionRepresentative, hx,
      Set.indicator_of_mem]
  · rw [globalStageProjectionRepresentative,
      Set.indicator_of_notMem hx, globalStageProjectionRepresentative,
      Set.indicator_of_notMem hx, inner_zero_left, inner_zero_right]

/-- Exact `LinearMap.IsSymmetric` packaging. -/
theorem globalStageProjectionCLM_isSymmetric (n : ℕ) :
    (globalStageProjectionCLM n :
      ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2).IsSymmetric := by
  intro u v
  exact globalStageProjectionCLM_inner_symmetric n u v

/-- The adjoint of the global stage projection is itself. -/
theorem globalStageProjectionCLM_adjoint_eq (n : ℕ) :
    (globalStageProjectionCLM n)† = globalStageProjectionCLM n :=
  (globalStageProjectionCLM_isSymmetric n).clm_adjoint_eq

/-- Every `P_n` is a bounded self-adjoint projection. -/
theorem globalStageProjectionCLM_isSelfAdjoint (n : ℕ) :
    IsSelfAdjoint (globalStageProjectionCLM n) :=
  (globalStageProjectionCLM_isSymmetric n).isSelfAdjoint

/-! ## 6. Support, fixed-space, and range characterizations -/

/-- A global `L²` class is supported in the `n`-th natural stage when it
vanishes a.e. off that stage. -/
def SupportedInNaturalStage
    (n : ℕ) (u : ActualGlobalQuotientL2) : Prop :=
  ∀ᵐ x ∂actualGlobalQuotientMeasure,
    x ∉ naturalStageSet n → u x = 0

/-- Every projected vector has the advertised support. -/
theorem globalStageProjection_supported
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    SupportedInNaturalStage n (globalStageProjection n u) :=
  globalStageProjection_eq_zero_ae_off_stage n u

/-- Support in the stage is equivalent to being fixed by the indicator
projection. -/
theorem globalStageProjection_eq_self_iff_supported
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjection n u = u ↔ SupportedInNaturalStage n u := by
  constructor
  · intro h
    simpa only [h] using globalStageProjection_supported n u
  · intro hSupport
    apply MeasureTheory.Lp.ext
    filter_upwards
      [globalStageProjection_coeFn_ae n u, hSupport]
      with x hprojection hs
    rw [hprojection]
    by_cases hx : x ∈ naturalStageSet n
    · simp only [globalStageProjectionRepresentative, hx,
        Set.indicator_of_mem]
    · rw [globalStageProjectionRepresentative,
        Set.indicator_of_notMem hx, hs hx]

/-- Fixed-space formulation for the bundled operator. -/
theorem globalStageProjectionCLM_eq_self_iff_supported
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjectionCLM n u = u ↔ SupportedInNaturalStage n u := by
  rw [globalStageProjectionCLM_apply,
    globalStageProjection_eq_self_iff_supported]

/-- The linear range is exactly the subspace of classes supported in the
natural stage. -/
theorem mem_globalStageProjectionCLM_range_iff_supported
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    u ∈ LinearMap.range
        (globalStageProjectionCLM n :
          ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2) ↔
      SupportedInNaturalStage n u := by
  constructor
  · rintro ⟨v, rfl⟩
    exact globalStageProjection_supported n v
  · intro hu
    refine ⟨u, ?_⟩
    exact (globalStageProjectionCLM_eq_self_iff_supported n u).2 hu

/-! ## 7. Compatibility along the natural exhaustion -/

/-- A smaller projection absorbs a larger projection on the left. -/
theorem globalStageProjection_absorb_left
    {m n : ℕ} (hmn : m ≤ n) (u : ActualGlobalQuotientL2) :
    globalStageProjection m (globalStageProjection n u) =
      globalStageProjection m u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [globalStageProjection_coeFn_ae m (globalStageProjection n u),
      globalStageProjection_coeFn_ae n u,
      globalStageProjection_coeFn_ae m u]
    with x houter hinner hdirect
  rw [houter, hdirect]
  by_cases hxm : x ∈ naturalStageSet m
  · have hxn : x ∈ naturalStageSet n :=
      naturalStageSet_monotone hmn hxm
    simp only [globalStageProjectionRepresentative,
      Set.indicator_of_mem hxm, Set.indicator_of_mem hxn, hinner]
  · simp only [globalStageProjectionRepresentative,
      Set.indicator_of_notMem hxm]

/-- A smaller projection is also absorbed by a larger projection on the
right. -/
theorem globalStageProjection_absorb_right
    {m n : ℕ} (hmn : m ≤ n) (u : ActualGlobalQuotientL2) :
    globalStageProjection n (globalStageProjection m u) =
      globalStageProjection m u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [globalStageProjection_coeFn_ae n (globalStageProjection m u),
      globalStageProjection_coeFn_ae m u]
    with x houter hinner
  rw [houter]
  by_cases hxn : x ∈ naturalStageSet n
  · rw [globalStageProjectionRepresentative,
      Set.indicator_of_mem hxn]
  · have hxm : x ∉ naturalStageSet m :=
      fun hx => hxn (naturalStageSet_monotone hmn hx)
    rw [globalStageProjectionRepresentative,
      Set.indicator_of_notMem hxn, hinner,
      globalStageProjectionRepresentative,
      Set.indicator_of_notMem hxm]

/-- Operator-level absorption on the left. -/
theorem globalStageProjectionCLM_comp_of_le
    {m n : ℕ} (hmn : m ≤ n) :
    (globalStageProjectionCLM m).comp (globalStageProjectionCLM n) =
      globalStageProjectionCLM m := by
  apply ContinuousLinearMap.ext
  intro u
  rw [ContinuousLinearMap.comp_apply,
    globalStageProjectionCLM_apply,
    globalStageProjectionCLM_apply,
    globalStageProjectionCLM_apply,
    globalStageProjection_absorb_left hmn]

/-- Operator-level absorption in the reverse composition order. -/
theorem globalStageProjectionCLM_reverse_comp_of_le
    {m n : ℕ} (hmn : m ≤ n) :
    (globalStageProjectionCLM n).comp (globalStageProjectionCLM m) =
      globalStageProjectionCLM m := by
  apply ContinuousLinearMap.ext
  intro u
  rw [ContinuousLinearMap.comp_apply,
    globalStageProjectionCLM_apply,
    globalStageProjectionCLM_apply,
    globalStageProjection_absorb_right hmn]

/-- All projections in the natural exhaustion commute. -/
theorem globalStageProjectionCLM_commute (m n : ℕ) :
    (globalStageProjectionCLM m).comp (globalStageProjectionCLM n) =
      (globalStageProjectionCLM n).comp (globalStageProjectionCLM m) := by
  rcases le_total m n with hmn | hnm
  · rw [globalStageProjectionCLM_comp_of_le hmn,
      globalStageProjectionCLM_reverse_comp_of_le hmn]
  · rw [globalStageProjectionCLM_reverse_comp_of_le hnm,
      globalStageProjectionCLM_comp_of_le hnm]

/-- The ranges form a monotone sequence of submodules. -/
theorem globalStageProjectionCLM_range_mono :
    Monotone (fun n : ℕ =>
      LinearMap.range
        (globalStageProjectionCLM n :
          ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2)) := by
  intro m n hmn u hu
  rw [mem_globalStageProjectionCLM_range_iff_supported] at hu ⊢
  filter_upwards [hu] with x hx hnot
  exact hx (fun hmem => hnot (naturalStageSet_monotone hmn hmem))

/-! ## 8. Literal pointwise convergence -/

/-- At every quotient point the representative sequence is eventually
constant and equal to the original representative. -/
theorem globalStageProjectionRepresentative_tendsto_pointwise
    (u : ActualGlobalQuotientL2) (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    Tendsto (fun n => globalStageProjectionRepresentative n u x)
      atTop (𝓝 (u x)) := by
  obtain ⟨N, hN⟩ := exists_mem_naturalStageSet x
  apply tendsto_atTop_of_eventually_const (i₀ := N)
  intro n hn
  have hx : x ∈ naturalStageSet n :=
    naturalStageSet_monotone hn hN
  rw [globalStageProjectionRepresentative,
    Set.indicator_of_mem hx]

/-- The preceding pointwise convergence holds almost everywhere, with no
exceptional set needed. -/
theorem globalStageProjectionRepresentative_tendsto_ae
    (u : ActualGlobalQuotientL2) :
    ∀ᵐ x ∂actualGlobalQuotientMeasure,
      Tendsto (fun n => globalStageProjectionRepresentative n u x)
        atTop (𝓝 (u x)) :=
  Filter.Eventually.of_forall
    (globalStageProjectionRepresentative_tendsto_pointwise u)

/-! ## 9. Dominated convergence for the literal `L²` error -/

/-- The canonical representative of every projected class is strongly
measurable.  This permits the measurable, rather than merely a.e.-measurable,
form of dominated convergence below. -/
theorem globalStageProjectionRepresentative_stronglyMeasurable
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    StronglyMeasurable (globalStageProjectionRepresentative n u) := by
  unfold globalStageProjectionRepresentative
  exact (MeasureTheory.Lp.stronglyMeasurable u).indicator
    (naturalStageSet_measurable n)

/-- The pointwise square-error density for the `n`-th cutoff. -/
def globalStageProjectionErrorDensity
    (n : ℕ) (u : ActualGlobalQuotientL2)
    (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) : ℝ≥0∞ :=
  ‖globalStageProjectionRepresentative n u x - u x‖ₑ ^
    (2 : ℝ≥0∞).toReal

/-- The fixed global square-integrable dominating density. -/
def globalL2DominatingDensity
    (u : ActualGlobalQuotientL2)
    (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) : ℝ≥0∞ :=
  ‖u x‖ₑ ^ (2 : ℝ≥0∞).toReal

/-- Each cutoff error density is measurable. -/
theorem globalStageProjectionErrorDensity_measurable
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    Measurable (globalStageProjectionErrorDensity n u) := by
  unfold globalStageProjectionErrorDensity
  exact
    ((((globalStageProjectionRepresentative_stronglyMeasurable n u).sub
      (MeasureTheory.Lp.stronglyMeasurable u)).measurable).enorm.pow_const _)

/-- The cutoff error density is pointwise bounded by the global `L²`
density, with constant exactly one. -/
theorem globalStageProjectionErrorDensity_le
    (n : ℕ) (u : ActualGlobalQuotientL2)
    (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    globalStageProjectionErrorDensity n u x ≤
      globalL2DominatingDensity u x := by
  by_cases hx : x ∈ naturalStageSet n
  · change x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [globalStageProjectionErrorDensity, globalL2DominatingDensity,
      globalStageProjectionRepresentative, Set.indicator_of_mem hx]
    simp
  · change x ∉ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
      ((n : ℝ) + 2) at hx
    rw [globalStageProjectionErrorDensity, globalL2DominatingDensity,
      globalStageProjectionRepresentative, Set.indicator_of_notMem hx]
    simp

/-- The global dominating density has finite nonnegative integral
/-- The global dominating density has finite nonnegative integral, exactly
because `u` belongs to the actual global `L²` carrier. -/
theorem globalL2DominatingDensity_lintegral_ne_top
    (u : ActualGlobalQuotientL2) :
    (∫⁻ x, globalL2DominatingDensity u x
      ∂actualGlobalQuotientMeasure) ≠ (∞ : ℝ≥0∞) := by
  unfold globalL2DominatingDensity
  exact
    (lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (p := (2 : ℝ≥0∞))
      (by norm_num) (by norm_num)
      (MeasureTheory.Lp.eLpNorm_lt_top u)).ne

/-- At every quotient point the error density is eventually identically
zero.  This is stronger than the a.e. convergence required by dominated
convergence. -/
theorem globalStageProjectionErrorDensity_eventually_zero
    (u : ActualGlobalQuotientL2) (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    ∀ᶠ n in atTop, globalStageProjectionErrorDensity n u x = 0 := by
  filter_upwards [eventually_mem_naturalStageSet x] with n hn
  change x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
    ((n : ℝ) + 2) at hn
  rw [globalStageProjectionErrorDensity,
    globalStageProjectionRepresentative, Set.indicator_of_mem hn]
  simp

/-- Pointwise convergence of the square-error densities to zero. -/
theorem globalStageProjectionErrorDensity_tendsto_pointwise
    (u : ActualGlobalQuotientL2) (x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) :
    Tendsto (fun n => globalStageProjectionErrorDensity n u x)
      atTop (𝓝 0) := by
  obtain ⟨N, hN⟩ := exists_mem_naturalStageSet x
  apply tendsto_atTop_of_eventually_const (i₀ := N)
  intro n hn
  have hx : x ∈ naturalStageSet n :=
    naturalStageSet_monotone hn hN
  change x ∈ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
    ((n : ℝ) + 2) at hx
  rw [globalStageProjectionErrorDensity,
    globalStageProjectionRepresentative, Set.indicator_of_mem hx]
  simp

/-- Dominated convergence for the integrals of the actual cutoff error
densities. -/
theorem globalStageProjectionErrorDensity_lintegral_tendsto_zero
    (u : ActualGlobalQuotientL2) :
    Tendsto
      (fun n => ∫⁻ x, globalStageProjectionErrorDensity n u x
        ∂actualGlobalQuotientMeasure)
      atTop (𝓝 0) := by
  simpa only [lintegral_zero] using
    (tendsto_lintegral_of_dominated_convergence
      (globalL2DominatingDensity u)
      (fun n => globalStageProjectionErrorDensity_measurable n u)
      (fun n => Filter.Eventually.of_forall
        (globalStageProjectionErrorDensity_le n u))
      (globalL2DominatingDensity_lintegral_ne_top u)
      (Filter.Eventually.of_forall
        (globalStageProjectionErrorDensity_tendsto_pointwise u)))

/-- The representative errors converge to zero in the literal global
`eLpNorm` at exponent two. -/
theorem globalStageProjectionRepresentative_tendsto_eLpNorm
    (u : ActualGlobalQuotientL2) :
    Tendsto
      (fun n => eLpNorm
        (globalStageProjectionRepresentative n u -
          (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ))
        2 actualGlobalQuotientMeasure)
      atTop (𝓝 0) := by
  suffices hIntegral :
      Tendsto
        (fun n => ∫⁻ x,
          ‖globalStageProjectionRepresentative n u x - u x‖ₑ ^
            (2 : ℝ≥0∞).toReal
          ∂actualGlobalQuotientMeasure)
        atTop (𝓝 0) by
    simp only [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      (by norm_num : (2 : ℝ≥0∞) ≠ (∞ : ℝ≥0∞))]
    convert!
      ENNReal.continuous_rpow_const.continuousAt.tendsto.comp hIntegral
    simp
  simpa only [globalStageProjectionErrorDensity] using
    globalStageProjectionErrorDensity_lintegral_tendsto_zero u

/-! ## 10. Strong operator convergence and dense union of ranges -/

/-- For every actual global `L²` vector, the literal cutoff projections
converge in the `L²` norm topology to that vector. -/
theorem globalStageProjection_tendsto_strong
    (u : ActualGlobalQuotientL2) :
    Tendsto (fun n => globalStageProjection n u) atTop (𝓝 u) := by
  have h :=
    (MeasureTheory.Lp.tendsto_Lp_iff_tendsto_eLpNorm''
      (fun n : ℕ => globalStageProjectionRepresentative n u)
      (fun n => globalStageProjectionRepresentative_memLp n u)
      (u : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ)
      (MeasureTheory.Lp.memLp u)).2
      (globalStageProjectionRepresentative_tendsto_eLpNorm u)
  simpa only [globalStageProjection,
    MeasureTheory.Lp.toLp_coeFn] using h

/-- Bundled continuous-linear-map formulation of strong convergence to the
identity. -/
theorem globalStageProjectionCLM_tendsto_strong
    (u : ActualGlobalQuotientL2) :
    Tendsto (fun n => globalStageProjectionCLM n u)
      atTop (𝓝 u) := by
  simpa only [globalStageProjectionCLM_apply] using
    globalStageProjection_tendsto_strong u

/-- Equivalent norm-error formulation of strong convergence. -/
theorem globalStageProjectionCLM_norm_sub_tendsto_zero
    (u : ActualGlobalQuotientL2) :
    Tendsto (fun n => ‖globalStageProjectionCLM n u - u‖)
      atTop (𝓝 0) :=
  (tendsto_iff_norm_sub_tendsto_zero.mp
    (globalStageProjectionCLM_tendsto_strong u))

/-- Every approximant lies in the range of its own projection. -/
theorem globalStageProjectionCLM_apply_mem_range
    (n : ℕ) (u : ActualGlobalQuotientL2) :
    globalStageProjectionCLM n u ∈
      LinearMap.range
        (globalStageProjectionCLM n :
          ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2) :=
  ⟨u, rfl⟩

/-- The literal union of the natural-stage projection ranges. -/
def globalNaturalStageRangeUnion : Set ActualGlobalQuotientL2 :=
  ⋃ n : ℕ,
    (LinearMap.range
      (globalStageProjectionCLM n :
        ActualGlobalQuotientL2 →ₗ[ℂ] ActualGlobalQuotientL2) :
      Set ActualGlobalQuotientL2)

/-- Every global vector belongs to the closure of the union of stage
ranges. -/
theorem mem_closure_globalNaturalStageRangeUnion
    (u : ActualGlobalQuotientL2) :
    u ∈ closure globalNaturalStageRangeUnion := by
  apply mem_closure_of_tendsto
    (globalStageProjectionCLM_tendsto_strong u)
  filter_upwards [] with n
  exact Set.mem_iUnion.2
    ⟨n, globalStageProjectionCLM_apply_mem_range n u⟩

/-- The natural-stage ranges have dense union in the actual global quotient
`L²` carrier. -/
theorem globalNaturalStageRangeUnion_dense :
    Dense globalNaturalStageRangeUnion := by
  intro u
  exact mem_closure_globalNaturalStageRangeUnion u

/-- Closure equality form of density, useful to downstream form-core APIs. -/
theorem closure_globalNaturalStageRangeUnion_eq_univ :
    closure globalNaturalStageRangeUnion =
      (Set.univ : Set ActualGlobalQuotientL2) :=
  globalNaturalStageRangeUnion_dense.closure_eq

/-! ## 11. Aggregate unconditional certificate and exact boundary -/

/-- Aggregate certificate for the actual global quotient `L²` exhaustion.

Every component is instantiated above from the chosen quotient measure and
the literal measurable sets `I.XSet (n + 2)`.  In particular, neither the
measurability, the integrable dominator, the pointwise exhaustion, nor the
strong convergence conclusion is supplied as a premise. -/
theorem actualGlobalL2ProjectionConvergenceCertificate :
    actualGlobalQuotientMeasure =
        Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.chosenGammaTwoFundamentalDomain.quotientMeasure ∧
      (∀ n : ℕ, naturalStageCutoff n = (n : ℝ) + 2) ∧
      (∀ n : ℕ, 1 < naturalStageCutoff n) ∧
      (∀ n : ℕ, MeasurableSet (naturalStageSet n)) ∧
      (⋃ n : ℕ, naturalStageSet n) =
        (Set.univ : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient) ∧
      (∀ x : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient,
        ∀ᶠ n in atTop, x ∈ naturalStageSet n) ∧
      (∀ (n : ℕ) (u : ActualGlobalQuotientL2),
        ((globalStageProjection n u : ActualGlobalQuotientL2) :
          Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient → ℂ) =ᵐ[actualGlobalQuotientMeasure]
            globalStageProjectionRepresentative n u) ∧
      (∀ (n : ℕ) (u : ActualGlobalQuotientL2),
        ‖globalStageProjectionCLM n u‖ ≤ ‖u‖) ∧
      (∀ n : ℕ, IsSelfAdjoint (globalStageProjectionCLM n)) ∧
      (∀ (n : ℕ) (u : ActualGlobalQuotientL2),
        globalStageProjectionCLM n (globalStageProjectionCLM n u) =
          globalStageProjectionCLM n u) ∧
      (∀ (n : ℕ) (u : ActualGlobalQuotientL2),
        globalStageProjectionCLM n u = u ↔
          SupportedInNaturalStage n u) ∧
      (∀ ⦃m n : ℕ⦄, m ≤ n →
        (globalStageProjectionCLM m).comp
            (globalStageProjectionCLM n) =
              globalStageProjectionCLM m ∧
        (globalStageProjectionCLM n).comp
            (globalStageProjectionCLM m) =
              globalStageProjectionCLM m) ∧
      (∀ u : ActualGlobalQuotientL2,
        Tendsto (fun n => globalStageProjectionCLM n u)
          atTop (𝓝 u)) ∧
      Dense globalNaturalStageRangeUnion := by
  exact
    ⟨actualGlobalQuotientMeasure_eq_chosen_quotientMeasure,
      naturalStageCutoff_apply,
      one_lt_naturalStageCutoff,
      naturalStageSet_measurable,
      iUnion_naturalStageSet_eq_univ,
      eventually_mem_naturalStageSet,
      globalStageProjection_coeFn_ae,
      fun n u => by
        simpa only [globalStageProjectionCLM_apply] using
          globalStageProjection_norm_le n u,
      globalStageProjectionCLM_isSelfAdjoint,
      fun n u => by
        simpa only [globalStageProjectionCLM_apply] using
          globalStageProjection_idempotent n u,
      globalStageProjectionCLM_eq_self_iff_supported,
      fun m n hmn =>
        ⟨globalStageProjectionCLM_comp_of_le hmn,
          globalStageProjectionCLM_reverse_comp_of_le hmn⟩,
      globalStageProjectionCLM_tendsto_strong,
      globalNaturalStageRangeUnion_dense⟩

