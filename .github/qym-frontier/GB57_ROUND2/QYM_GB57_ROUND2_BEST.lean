    (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_continuous kappa Y)

theorem namedCuspHorocycleImage_isClosed
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsClosed (namedCuspHorocycleImage kappa Y) :=
  (namedCuspHorocycleImage_isCompact kappa Y).isClosed

/-- The parametrized hyperbolic boundary measure in one named scaling
chart.  It is the pushforward of `level(Y)⁻¹ dx`; Möbius invariance is encoded
by transporting the parameter measure rather than by assigning an ambient
two-dimensional density to the curve. -/
noncomputable def namedCuspHorocycleMeasure
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) : Measure ℍ :=
  (widthTwoHyperbolicParameterMeasure (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)).map
    (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint kappa Y)

noncomputable instance namedCuspHorocycleMeasure_isFinite
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsFiniteMeasure (namedCuspHorocycleMeasure kappa Y) :=
  Measure.isFiniteMeasure_map _ _

theorem namedCuspHorocycleMeasure_univ
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    namedCuspHorocycleMeasure kappa Y Set.univ =
      ENNReal.ofReal (2 / Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) := by
  have hLevel : 0 < Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y :=
    lt_of_lt_of_le zero_lt_one (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.one_le_gammaTwoCuspLevel Y)
  rw [namedCuspHorocycleMeasure,
    Measure.map_apply
      (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_continuous
        kappa Y).measurable
      MeasurableSet.univ,
    Set.preimage_univ,
    widthTwoHyperbolicParameterMeasure_univ_of_pos hLevel]

theorem namedCuspHorocycleMeasure_compl_image
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    namedCuspHorocycleMeasure kappa Y
        (namedCuspHorocycleImage kappa Y)ᶜ = 0 := by
  rw [namedCuspHorocycleMeasure,
    Measure.map_apply
      (QYM.FullCertification.P2ActualFixedPhaseCuspTraceGraphExtension.actualFixedPhaseCuspHorocyclePoint_continuous
        kappa Y).measurable
      (namedCuspHorocycleImage_isClosed kappa Y).measurableSet.compl]
  apply measure_mono_null
    (μ := widthTwoHyperbolicParameterMeasure (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y))
    (t := (Set.Icc (0 : ℝ) 2)ᶜ)
  · intro x hx hxIcc
    exact hx ⟨x, hxIcc, rfl⟩
  · exact widthTwoHyperbolicParameterMeasure_compl_Icc
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)

/-- Projected named-cusp segment in the effective quotient. -/
def quotientNamedCuspHorocycleImage
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) : Set Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk '' namedCuspHorocycleImage kappa Y

theorem quotientNamedCuspHorocycleImage_isCompact
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsCompact (quotientNamedCuspHorocycleImage kappa Y) :=
  (namedCuspHorocycleImage_isCompact kappa Y).image
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.continuous

theorem quotientNamedCuspHorocycleImage_isClosed
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsClosed (quotientNamedCuspHorocycleImage kappa Y) :=
  (quotientNamedCuspHorocycleImage_isCompact kappa Y).isClosed

/-- Pushforward of the named-cusp parametrized measure to the effective
quotient. -/
noncomputable def quotientNamedCuspHorocycleMeasure
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) : Measure Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient :=
  (namedCuspHorocycleMeasure kappa Y).map Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk

noncomputable instance quotientNamedCuspHorocycleMeasure_isFinite
    (kappa : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoCusp) (Y : ℝ) :
    IsFiniteMeasure (quotientNamedCuspHorocycleMeasure kappa Y) :=
