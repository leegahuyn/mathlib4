namespace QYM.FullCertification.Mock2EtaPeterssonCarrierExtension

/-!
# A concrete inverse-eta Petersson carrier on hyperbolic closed-ball truncations

This file connects the concrete `Γ(2)` inverse-eta multiplier constructed in
`PrimalitySheafVerification.Mock2` to Mathlib's actual invariant hyperbolic
measure on `ℍ`.

The truncation used here is deliberately called a *hyperbolic closed-ball
truncation*.  It is not asserted to be a fundamental polygon for `Γ(2)`, and
the restricted measure below is not asserted to be a quotient measure.  This
distinction is important: no measurable fundamental-domain theorem is present
in the imported development.

The construction is nevertheless fully concrete:

* the base is Mathlib's upper half-plane;
* the group is the principal congruence subgroup `Γ(2)`;
* the multiplier is Mock2's unconditional inverse-eta multiplier;
* the measure is `dx dy / y^2`, restricted to a compact hyperbolic ball;
* the smooth automorphic `L²` core is an actual complex submodule;
* the Petersson carrier is the closure of the actual core image in `L²`;
* the core image embeds isometrically with dense range in that closure.
-/

/-- Mathlib's upper half-plane, as used by Mock2's Definition 15 geometry. -/
abbrev H := Mock2.Definition15Geometry.H

/-- The concrete principal congruence subgroup `Γ(2)`. -/
abbrev Gamma2 := Mock2.Definition15Geometry.Gamma2

/-- The literal orbit quotient `Γ(2) \ ℍ` already constructed in Mock2. -/
abbrev Gamma2Quotient := Mock2.Definition15Geometry.X

/-- The concrete eta multiplier system from Mock2. -/
noncomputable abbrev etaMultiplier :=
  Mock2.Definition15Geometry.EtaHalfWeight.multiplier

/-- The associated half-integral automorphic line bundle in orbit-quotient
presentation. -/
noncomputable abbrev EtaAutomorphicLineBundle :=
  Mock2.Definition15Geometry.LHalfNu etaMultiplier

/-! ## The explicit multiplier and its covariance law -/

/-- The complex-valued automorphy factor of the inverse-eta multiplier. -/
noncomputable def etaAutomorphyFactor (gamma : Gamma2) (tau : H) : ℂ :=
  (etaMultiplier.automorphyFactor gamma tau : ℂ)

/-- The automorphy factor is exactly the eta quotient
`eta(tau) / eta(gamma * tau)`. -/
@[simp] theorem etaAutomorphyFactor_eq_etaRatio (gamma : Gamma2) (tau : H) :
    etaAutomorphyFactor gamma tau =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio gamma tau := by
  simp [etaAutomorphyFactor,
    Mock2.Definition15Geometry.EtaHalfWeight.multiplier_automorphyFactor]

/-- The explicit eta factor is nowhere zero. -/
theorem etaAutomorphyFactor_ne_zero (gamma : Gamma2) (tau : H) :
    etaAutomorphyFactor gamma tau ≠ 0 := by
  rw [etaAutomorphyFactor_eq_etaRatio]
  exact Mock2.Definition15Geometry.EtaHalfWeight.etaRatio_ne_zero gamma tau

/-- The explicit eta factor satisfies the group cocycle law. -/
theorem etaAutomorphyFactor_mul (gamma delta : Gamma2) (tau : H) :
    etaAutomorphyFactor (gamma * delta) tau =
      etaAutomorphyFactor gamma (delta • tau) *
        etaAutomorphyFactor delta tau := by
  simp only [etaAutomorphyFactor_eq_etaRatio]
  exact Mock2.Definition15Geometry.EtaHalfWeight.etaRatio_mul gamma delta tau

/-- Exact covariance for a scalar lift of a section of the associated
inverse-eta line bundle. -/
def EtaCovariant (f : H → ℂ) : Prop :=
  ∀ (gamma : Gamma2) (tau : H),
    f (gamma • tau) = etaAutomorphyFactor gamma tau * f tau

/-- Covariance is compatible with the identity element. -/
theorem etaCovariant_identity_factor (tau : H) :
    etaAutomorphyFactor (1 : Gamma2) tau = 1 := by
  simp

/-! ## A concrete smooth inverse-eta section -/

/-- The scalar lift `1 / eta(tau)`.  This is the natural section for the
cocycle orientation used by Mock2's `lineSmul`. -/
noncomputable def inverseEtaSection (tau : H) : ℂ :=
  (Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau)⁻¹

/-- The inverse-eta lift is pointwise nonzero. -/
theorem inverseEtaSection_ne_zero (tau : H) : inverseEtaSection tau ≠ 0 := by
  exact inv_ne_zero
    (Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero tau)

/-- The inverse-eta lift is globally smooth on the actual upper half-plane. -/
theorem inverseEtaSection_contMDiff :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ inverseEtaSection := by
  exact
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue_contMDiff.inv₀
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero

/-- Continuity, exposed separately for the compact-truncation argument. -/
theorem inverseEtaSection_continuous : Continuous inverseEtaSection :=
  inverseEtaSection_contMDiff.continuous

/-- The inverse-eta lift satisfies the concrete multiplier covariance law. -/
theorem inverseEtaSection_covariant : EtaCovariant inverseEtaSection := by
  intro gamma tau
  rw [etaAutomorphyFactor_eq_etaRatio]
  change
    (Mock2.Definition15Geometry.EtaHalfWeight.etaValue (gamma • tau))⁻¹ =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio gamma tau *
        (Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau)⁻¹
  rw [Mock2.Definition15Geometry.EtaHalfWeight.etaRatio]
  field_simp [Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero]

/-- Applying the line-bundle action to the inverse-eta graph gives the graph
over the transformed base point. -/
theorem inverseEtaSection_lineSmul (gamma : Gamma2) (tau : H) :
    Mock2.Definition15Geometry.lineSmul etaMultiplier gamma
        (tau, inverseEtaSection tau) =
      (gamma • tau, inverseEtaSection (gamma • tau)) := by
  apply Prod.ext
  · rfl
  · exact (inverseEtaSection_covariant gamma tau).symm

/-- The inverse-eta graph, mapped into the actual associated quotient bundle. -/
noncomputable def inverseEtaBundleLift (tau : H) :
    EtaAutomorphicLineBundle.Total :=
  Mock2.Definition15Geometry.lineBundleMk etaMultiplier
    (tau, inverseEtaSection tau)

/-- The bundle lift projects to the orbit of its upper-half-plane point. -/
@[simp] theorem inverseEtaBundleLift_projection (tau : H) :
    EtaAutomorphicLineBundle.projection (inverseEtaBundleLift tau) =
      Mock2.Definition15Geometry.quotientMap tau := by
  rfl

/-- The bundle-valued inverse-eta lift is invariant under every deck
transformation, hence is honest descent data for the associated bundle. -/
theorem inverseEtaBundleLift_invariant (gamma : Gamma2) (tau : H) :
    inverseEtaBundleLift (gamma • tau) = inverseEtaBundleLift tau := by
  rw [inverseEtaBundleLift, inverseEtaBundleLift]
  rw [← inverseEtaSection_lineSmul gamma tau]
  exact Mock2.Definition15Geometry.lineBundleMk_lineSmul
    etaMultiplier gamma (tau, inverseEtaSection tau)

/-! ## Hyperbolic closed-ball truncations and their finite measures -/

/-- The concrete hyperbolic closed ball of radius `Y`, centered at `i`.

This is an exhaustion cell in the Poincare metric.  It is intentionally not
called a `Γ(2)` fundamental domain. -/
def hyperbolicClosedBallTruncation (Y : ℝ) : Set H :=
  Metric.closedBall UpperHalfPlane.I Y

/-- Every hyperbolic closed-ball truncation is compact because `ℍ` is a proper
metric space in Mathlib's Poincare metric. -/
theorem hyperbolicClosedBallTruncation_isCompact (Y : ℝ) :
    IsCompact (hyperbolicClosedBallTruncation Y) := by
  exact isCompact_closedBall UpperHalfPlane.I Y

/-- The truncation is a Borel-measurable set. -/
theorem hyperbolicClosedBallTruncation_measurable (Y : ℝ) :
    MeasurableSet (hyperbolicClosedBallTruncation Y) := by
  exact Metric.isClosed_closedBall.measurableSet

/-- Closed-ball truncations are monotone in the radius. -/
theorem hyperbolicClosedBallTruncation_mono {Y Z : ℝ} (hYZ : Y ≤ Z) :
    hyperbolicClosedBallTruncation Y ⊆
      hyperbolicClosedBallTruncation Z := by
  exact Metric.closedBall_subset_closedBall hYZ

/-- The center `i` belongs to every nonnegative-radius truncation. -/
theorem UpperHalfPlane_I_mem_hyperbolicClosedBallTruncation {Y : ℝ}
    (hY : 0 ≤ Y) :
    UpperHalfPlane.I ∈ hyperbolicClosedBallTruncation Y := by
  exact Metric.mem_closedBall_self hY

/-- The countable sequence of natural-radius truncations exhausts `ℍ`. -/
theorem hyperbolicClosedBallTruncation_nat_iUnion :
    (⋃ n : ℕ, hyperbolicClosedBallTruncation (n : ℝ)) = Set.univ := by
  exact Metric.iUnion_closedBall_nat UpperHalfPlane.I

/-- Mathlib's invariant hyperbolic volume `dx dy / y^2`, restricted to the
closed-ball truncation. -/
noncomputable def truncatedHyperbolicMeasure (Y : ℝ) : Measure H :=
  (volume : Measure H).restrict (hyperbolicClosedBallTruncation Y)

/-- The restricted measure evaluates by intersecting with the truncation. -/
theorem truncatedHyperbolicMeasure_apply (Y : ℝ) {s : Set H}
    (hs : MeasurableSet s) :
    truncatedHyperbolicMeasure Y s =
      (volume : Measure H) (s ∩ hyperbolicClosedBallTruncation Y) := by
  exact Measure.restrict_apply hs

/-- The restricted hyperbolic measure is finite for every real radius. -/
noncomputable instance truncatedHyperbolicMeasure_isFinite (Y : ℝ) :
    IsFiniteMeasure (truncatedHyperbolicMeasure Y) := by
  apply MeasureTheory.isFiniteMeasure_restrict.mpr
  exact (MeasureTheory.measure_closedBall_lt_top
    (μ := (volume : Measure H))).ne

/-- The finiteness statement as an explicit inequality. -/
theorem truncatedHyperbolicMeasure_univ_lt_top (Y : ℝ) :
    truncatedHyperbolicMeasure Y Set.univ < (∞ : ℝ≥0∞) := by
  exact MeasureTheory.measure_lt_top (truncatedHyperbolicMeasure Y) Set.univ

/-- Increasing the truncation radius increases the restricted measure. -/
theorem truncatedHyperbolicMeasure_mono {Y Z : ℝ} (hYZ : Y ≤ Z) :
    truncatedHyperbolicMeasure Y ≤ truncatedHyperbolicMeasure Z := by
  exact Measure.restrict_mono_set (volume : Measure H)
    (hyperbolicClosedBallTruncation_mono hYZ)

/-- The actual complex `L²` carrier for a fixed closed-ball truncation. -/
abbrev TruncatedPeterssonL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (truncatedHyperbolicMeasure Y)

/-! ## The smooth automorphic `L²` core -/

/-- Smooth inverse-eta-covariant functions which are square integrable for
the restricted hyperbolic measure.  This is an actual complex submodule of the
function space `ℍ → ℂ`.

The functions are globally smooth and globally automorphic.  Their norm is
truncated by the measure; they are not falsely asserted to have compact support
on `ℍ`. -/
noncomputable def etaSmoothAutomorphicCore (Y : ℝ) :
    Submodule ℂ (H → ℂ) where
  carrier f :=
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ f ∧
      EtaCovariant f ∧
        MeasureTheory.MemLp f 2 (truncatedHyperbolicMeasure Y)
  zero_mem' := by
    refine ⟨contMDiff_const, ?_, MeasureTheory.MemLp.zero⟩
    intro gamma tau
    simp [etaAutomorphyFactor]
  add_mem' := by
    intro f g hf hg
    rcases hf with ⟨hfSmooth, hfCovariant, hfLp⟩
    rcases hg with ⟨hgSmooth, hgCovariant, hgLp⟩
    refine ⟨hfSmooth.add hgSmooth, ?_, hfLp.add hgLp⟩
    intro gamma tau
    change
      f (gamma • tau) + g (gamma • tau) =
        etaAutomorphyFactor gamma tau * (f tau + g tau)
    rw [hfCovariant gamma tau, hgCovariant gamma tau, mul_add]
  smul_mem' := by
    intro c f hf
    rcases hf with ⟨hfSmooth, hfCovariant, hfLp⟩
    refine ⟨?_, ?_, hfLp.const_smul c⟩
    · change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun tau : H => c * f tau)
      exact contMDiff_const.mul hfSmooth
    · intro gamma tau
      change
        c * f (gamma • tau) =
          etaAutomorphyFactor gamma tau * (c * f tau)
      rw [hfCovariant gamma tau]
      ac_rfl

/-- Membership in the smooth automorphic core, exposed without unfolding a
submodule record at use sites. -/
theorem mem_etaSmoothAutomorphicCore_iff (Y : ℝ) (f : H → ℂ) :
    f ∈ etaSmoothAutomorphicCore Y ↔
      ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ f ∧
        EtaCovariant f ∧
          MeasureTheory.MemLp f 2 (truncatedHyperbolicMeasure Y) := by
  rfl

/-- The inverse-eta section is `L²` on every compact hyperbolic closed-ball
truncation.  The proof obtains a uniform norm bound from compactness and then
uses finiteness of the restricted hyperbolic measure. -/
theorem inverseEtaSection_memLp (Y : ℝ) :
    MeasureTheory.MemLp inverseEtaSection 2
      (truncatedHyperbolicMeasure Y) := by
  have hBounded :
      BddAbove
        ((fun tau : H => ‖inverseEtaSection tau‖) ''
          hyperbolicClosedBallTruncation Y) :=
    (hyperbolicClosedBallTruncation_isCompact Y).bddAbove_image
      inverseEtaSection_continuous.norm.continuousOn
  rcases hBounded with ⟨C, hC⟩
  refine MeasureTheory.MemLp.of_bound
    (p := (2 : ℝ≥0∞)) (μ := truncatedHyperbolicMeasure Y)
    inverseEtaSection_continuous.aestronglyMeasurable C ?_
  exact
    (MeasureTheory.ae_restrict_mem
      (hyperbolicClosedBallTruncation_measurable Y)).mono
      (fun tau htau => hC ⟨tau, htau, rfl⟩)

/-- Hence the concrete inverse-eta section is an actual element of every
truncated smooth automorphic core. -/
noncomputable def inverseEtaCoreElement (Y : ℝ) :
    etaSmoothAutomorphicCore Y :=
  ⟨inverseEtaSection,
    inverseEtaSection_contMDiff,
    inverseEtaSection_covariant,
    inverseEtaSection_memLp Y⟩

@[simp] theorem inverseEtaCoreElement_apply (Y : ℝ) (tau : H) :
    (inverseEtaCoreElement Y : H → ℂ) tau = inverseEtaSection tau := by
  rfl

/-- Every smooth automorphic core element defines a lift into the concrete
associated eta line bundle. -/
noncomputable def etaCoreBundleLift (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (tau : H) :
    EtaAutomorphicLineBundle.Total :=
  Mock2.Definition15Geometry.lineBundleMk etaMultiplier (tau, (f : H → ℂ) tau)

/-- The core lift lies over the orbit of the chosen upper-half-plane point. -/
@[simp] theorem etaCoreBundleLift_projection (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (tau : H) :
    EtaAutomorphicLineBundle.projection (etaCoreBundleLift Y f tau) =
      Mock2.Definition15Geometry.quotientMap tau := by
  rfl

/-- Every core lift is invariant under the deck group, by the stored explicit
eta covariance equation. -/
theorem etaCoreBundleLift_invariant (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (gamma : Gamma2) (tau : H) :
    etaCoreBundleLift Y f (gamma • tau) = etaCoreBundleLift Y f tau := by
  have hLine :
      Mock2.Definition15Geometry.lineSmul etaMultiplier gamma (tau, (f : H → ℂ) tau) =
        (gamma • tau, (f : H → ℂ) (gamma • tau)) := by
    apply Prod.ext
    · rfl
    · exact (f.property.2.1 gamma tau).symm
  rw [etaCoreBundleLift, etaCoreBundleLift, ← hLine]
  exact Mock2.Definition15Geometry.lineBundleMk_lineSmul
    etaMultiplier gamma (tau, (f : H → ℂ) tau)

/-! ## Passage to the actual `L²` a.e.-quotient -/

/-- Send a smooth automorphic core function to its `L²` almost-everywhere
equivalence class. -/
noncomputable def etaCoreToL2 (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) : TruncatedPeterssonL2 Y :=
  f.property.2.2.toLp (f : H → ℂ)

/-- The `L²` realization is complex linear. -/
noncomputable def etaCoreToL2Linear (Y : ℝ) :
    etaSmoothAutomorphicCore Y →ₗ[ℂ] TruncatedPeterssonL2 Y where
  toFun := etaCoreToL2 Y
  map_add' f g := by
    simpa [etaCoreToL2] using
      (MeasureTheory.MemLp.toLp_add f.property.2.2 g.property.2.2)
  map_smul' c f := by
    simpa [etaCoreToL2] using
      (MeasureTheory.MemLp.toLp_const_smul c f.property.2.2)

@[simp] theorem etaCoreToL2Linear_apply (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    etaCoreToL2Linear Y f = etaCoreToL2 Y f := by
  rfl

/-- The pointwise representative of a core element agrees almost everywhere
with its `L²` realization. -/
theorem etaCoreToL2_coeFn_ae (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    ((etaCoreToL2 Y f : TruncatedPeterssonL2 Y) : H → ℂ) =ᵐ[
        truncatedHyperbolicMeasure Y]
      (f : H → ℂ) := by
  exact f.property.2.2.coeFn_toLp

/-- The actual truncated Petersson pairing on smooth automorphic core
functions. -/
noncomputable def truncatedPeterssonInner (Y : ℝ)
    (f g : etaSmoothAutomorphicCore Y) : ℂ :=
  ∫ tau : H, inner ℂ ((f : H → ℂ) tau) ((g : H → ℂ) tau) ∂truncatedHyperbolicMeasure Y

/-- Mathlib's `L²` inner product is exactly the truncated Petersson integral
of the smooth automorphic representatives. -/
theorem etaCoreToL2_inner_eq_truncatedPeterssonInner (Y : ℝ)
    (f g : etaSmoothAutomorphicCore Y) :
    inner ℂ (etaCoreToL2 Y f) (etaCoreToL2 Y g) =
      truncatedPeterssonInner Y f g := by
  rw [MeasureTheory.L2.inner_def]
  unfold truncatedPeterssonInner
  refine integral_congr_ae ?_
  filter_upwards [etaCoreToL2_coeFn_ae Y f, etaCoreToL2_coeFn_ae Y g]
    with tau hf hg
  rw [hf, hg]

/-! ## Compactly supported `L²` representatives on the truncation -/

/-- Hard restriction of a core function to the closed ball.  This is used only
as an `L²` representative; no boundary smoothness is claimed. -/
noncomputable def closedBallL2Representative (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) : H → ℂ :=
  (hyperbolicClosedBallTruncation Y).indicator (f : H → ℂ)

/-- The hard-truncated representative has compact support. -/
theorem closedBallL2Representative_hasCompactSupport (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    HasCompactSupport (closedBallL2Representative Y f) := by
  rw [HasCompactSupport, tsupport]
  exact
    (hyperbolicClosedBallTruncation_isCompact Y).of_isClosed_subset
      isClosed_closure
      (closure_minimal Set.support_indicator_subset
        Metric.isClosed_closedBall)

/-- The hard-truncated representative is square integrable for the restricted
measure. -/
theorem closedBallL2Representative_memLp (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    MeasureTheory.MemLp (closedBallL2Representative Y f) 2
      (truncatedHyperbolicMeasure Y) := by
  exact MeasureTheory.MemLp.indicator
    (hyperbolicClosedBallTruncation_measurable Y) f.property.2.2

/-- Hard truncation does not change the `L²` class for the already-restricted
measure. -/
theorem closedBallL2Representative_toLp (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    (closedBallL2Representative_memLp Y f).toLp
        (closedBallL2Representative Y f) =
      etaCoreToL2 Y f := by
  apply MeasureTheory.MemLp.toLp_congr
  filter_upwards [
    MeasureTheory.ae_restrict_mem
      (hyperbolicClosedBallTruncation_measurable Y)] with tau htau
  exact Set.indicator_of_mem htau _

/-! ## The core image, its closure, and the dense isometric inclusion -/

/-- The a.e.-quotiented smooth automorphic core as an actual subspace of the
truncated `L²` Hilbert space. -/
noncomputable def etaPeterssonCoreRange (Y : ℝ) :
    Submodule ℂ (TruncatedPeterssonL2 Y) :=
  LinearMap.range (etaCoreToL2Linear Y)

/-- The core after quotienting by equality almost everywhere. -/
abbrev EtaPeterssonCoreImage (Y : ℝ) := etaPeterssonCoreRange Y

/-- The concrete Petersson completion: the closed subspace generated by the
actual smooth automorphic core image in truncated `L²`. -/
abbrev EtaPeterssonCompletion (Y : ℝ) :=
  (etaPeterssonCoreRange Y).topologicalClosure

/-- The core range is contained in its Petersson completion. -/
theorem etaPeterssonCoreRange_le_completion (Y : ℝ) :
    etaPeterssonCoreRange Y ≤
      (etaPeterssonCoreRange Y).topologicalClosure := by
  exact Submodule.le_topologicalClosure (etaPeterssonCoreRange Y)

/-- The Petersson completion is a closed subspace of the actual `L²` Hilbert
space. -/
theorem etaPeterssonCompletion_isClosed (Y : ℝ) :
    IsClosed
      ((EtaPeterssonCompletion Y :
          Submodule ℂ (TruncatedPeterssonL2 Y)) :
        Set (TruncatedPeterssonL2 Y)) := by
  exact Submodule.isClosed_topologicalClosure (etaPeterssonCoreRange Y)

/-- The closure equality which defines the concrete completion. -/
theorem etaPeterssonCompletion_coe (Y : ℝ) :
    ((EtaPeterssonCompletion Y :
        Submodule ℂ (TruncatedPeterssonL2 Y)) :
      Set (TruncatedPeterssonL2 Y)) =
      closure
        ((etaPeterssonCoreRange Y :
            Submodule ℂ (TruncatedPeterssonL2 Y)) :
          Set (TruncatedPeterssonL2 Y)) := by
  rfl

/-- The canonical inclusion of the a.e.-quotiented core image into its closed
Petersson completion. -/
noncomputable def etaCoreImageInclusion (Y : ℝ) :
    EtaPeterssonCoreImage Y →ₗᵢ[ℂ] EtaPeterssonCompletion Y where
  toFun f :=
    ⟨(f : TruncatedPeterssonL2 Y),
      etaPeterssonCoreRange_le_completion Y f.property⟩
  map_add' f g := by
    rfl
  map_smul' c f := by
    rfl
  norm_map' f := by
    rfl

/-- The canonical core inclusion is injective. -/
theorem etaCoreImageInclusion_injective (Y : ℝ) :
    Function.Injective (etaCoreImageInclusion Y) :=
  (etaCoreImageInclusion Y).injective

/-- The actual core image is dense in the concrete Petersson completion.  No
density certificate is an input: this follows from the definition as a
topological closure. -/
theorem etaCoreImageInclusion_denseRange (Y : ℝ) :
    DenseRange (etaCoreImageInclusion Y) := by
  change Dense
    (Set.range (fun f : EtaPeterssonCoreImage Y =>
      etaCoreImageInclusion Y f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : TruncatedPeterssonL2 Y) ∈
      closure
        (Subtype.val ''
          Set.range (fun f : EtaPeterssonCoreImage Y =>
            etaCoreImageInclusion Y f))
  have hImage :
      Subtype.val ''
          Set.range (fun f : EtaPeterssonCoreImage Y =>
            etaCoreImageInclusion Y f) =
        ((etaPeterssonCoreRange Y :
            Submodule ℂ (TruncatedPeterssonL2 Y)) :
          Set (TruncatedPeterssonL2 Y)) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : EtaPeterssonCoreImage Y := ⟨z, hz⟩
      exact ⟨etaCoreImageInclusion Y f, ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- The concrete Petersson completion carries the inherited complete-space
structure. -/
noncomputable def etaPeterssonCompletionCompleteSpace (Y : ℝ) :
    CompleteSpace (EtaPeterssonCompletion Y) :=
  inferInstance

/-- The concrete Petersson completion carries the inherited complex Hilbert
space structure. -/
noncomputable def etaPeterssonCompletionInnerProductSpace (Y : ℝ) :
    InnerProductSpace ℂ (EtaPeterssonCompletion Y) :=
  inferInstance

/-- A single unconditional presentation theorem collecting the concrete
carrier, inverse-eta inhabitant, Petersson pairing, closed completion, and dense
isometric core inclusion. -/
theorem concrete_inverseEta_petersson_carrier (Y : ℝ) :
    IsCompact (hyperbolicClosedBallTruncation Y) ∧
      truncatedHyperbolicMeasure Y Set.univ < (∞ : ℝ≥0∞) ∧
      inverseEtaSection ∈ etaSmoothAutomorphicCore Y ∧
      (∀ f g : etaSmoothAutomorphicCore Y,
        inner ℂ (etaCoreToL2 Y f) (etaCoreToL2 Y g) =
          truncatedPeterssonInner Y f g) ∧
      IsClosed
        ((EtaPeterssonCompletion Y :
            Submodule ℂ (TruncatedPeterssonL2 Y)) :
          Set (TruncatedPeterssonL2 Y)) ∧
      Function.Injective (etaCoreImageInclusion Y) ∧
      DenseRange (etaCoreImageInclusion Y) := by
  exact
    ⟨hyperbolicClosedBallTruncation_isCompact Y,
      truncatedHyperbolicMeasure_univ_lt_top Y,
      (inverseEtaCoreElement Y).property,
      etaCoreToL2_inner_eq_truncatedPeterssonInner Y,
      etaPeterssonCompletion_isClosed Y,
      etaCoreImageInclusion_injective Y,
      etaCoreImageInclusion_denseRange Y⟩

end QYM.FullCertification.Mock2EtaPeterssonCarrierExtension


open Function
open scoped MatrixGroups UpperHalfPlane Manifold ContDiff

/-!
# The eta-gauge derivative on smooth Gamma(2)-invariant scalars

This file connects the concrete eta multiplier constructed in
`Mock2.Definition15Geometry.EtaHalfWeight` to an actual manifold derivative on the upper
half-plane.

The construction is deliberately precise about its scope.  It is the holomorphic (complex-smooth)
eta-gauge derivative

`D_eta (g / eta) = eta⁻¹ dg`

for a smooth `Gamma(2)`-invariant scalar `g`.  Here `dg` is Mathlib's genuine `mfderiv` on the
complex manifold `UpperHalfPlane`.  The target covariance is proved from the manifold chain rule,
using the actual manifold derivative of the deck transformation.  No Green identity, real-smooth
de Rham differential, formal adjoint, or closed-operator assertion is made in this module.
-/

namespace QYM.Mock2EtaCovariantDerivativeExtension

abbrev H := Mock2.Definition15Geometry.H
abbrev Gamma2 := Mock2.Definition15Geometry.Gamma2
abbrev ScalarOneFormValue := ℂ →L[ℂ] ℂ

namespace Geometry

open Mock2.Definition15Geometry

/-! ## Smooth invariant scalars and inverse-eta sections -/

/-- Literal invariance of a scalar function under the actual `Gamma(2)` action. -/
def IsGamma2Invariant (g : H → ℂ) : Prop :=
  ∀ (γ : Gamma2) (τ : H), g (γ • τ) = g τ

/-- The concrete eta-ratio covariance carried by a local line-bundle section. -/
def IsEtaCovariant (f : H → ℂ) : Prop :=
  ∀ (γ : Gamma2) (τ : H),
    f (γ • τ) = EtaHalfWeight.etaRatio γ τ * f τ

/-- Complex-smooth invariant scalar functions form a genuine complex submodule. -/
noncomputable def smoothInvariantScalars : Submodule ℂ (H → ℂ) where
  carrier g :=
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ g ∧ IsGamma2Invariant g
  zero_mem' := by
    constructor
    · exact contMDiff_const
    · intro γ τ
      rfl
  add_mem' := by
    intro g h hg hh
    constructor
    · exact hg.1.add hh.1
    · intro γ τ
      change g (γ • τ) + h (γ • τ) = g τ + h τ
      rw [hg.2 γ τ, hh.2 γ τ]
  smul_mem' := by
    intro c g hg
    constructor
    · change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun tau : H => c * g tau)
      exact contMDiff_const.mul hg.1
    · intro γ τ
      change c • g (γ • τ) = c • g τ
      rw [hg.2 γ τ]

/-- Complex-smooth inverse-eta covariant sections form a complex submodule. -/
noncomputable def smoothEtaCovariantSections : Submodule ℂ (H → ℂ) where
  carrier f :=
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ f ∧ IsEtaCovariant f
  zero_mem' := by
    constructor
    · exact contMDiff_const
    · intro γ τ
      simp [IsEtaCovariant]
  add_mem' := by
    intro f h hf hh
    constructor
    · exact hf.1.add hh.1
    · intro γ τ
      change
        f (γ • τ) + h (γ • τ) =
          EtaHalfWeight.etaRatio γ τ * (f τ + h τ)
      rw [hf.2 γ τ, hh.2 γ τ, mul_add]
  smul_mem' := by
    intro c f hf
    constructor
    · change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun tau : H => c * f tau)
      exact contMDiff_const.mul hf.1
    · intro γ τ
      change
        c * f (γ • τ) =
          EtaHalfWeight.etaRatio γ τ * (c * f τ)
      rw [hf.2 γ τ]
      ring

abbrev SmoothInvariantScalar := smoothInvariantScalars
abbrev SmoothEtaCovariantSection := smoothEtaCovariantSections

theorem SmoothInvariantScalar.smooth (g : SmoothInvariantScalar) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ g.1 :=
  g.property.1

theorem SmoothInvariantScalar.invariant
    (g : SmoothInvariantScalar) (γ : Gamma2) (τ : H) :
    g.1 (γ • τ) = g.1 τ :=
  g.property.2 γ τ

theorem SmoothEtaCovariantSection.smooth (f : SmoothEtaCovariantSection) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ f.1 :=
  f.property.1

theorem SmoothEtaCovariantSection.covariant
    (f : SmoothEtaCovariantSection) (γ : Gamma2) (τ : H) :
    f.1 (γ • τ) = EtaHalfWeight.etaRatio γ τ * f.1 τ :=
  f.property.2 γ τ

/-- The section represented by an invariant eta-gauge scalar: `s = g / eta`. -/
noncomputable def etaSection (g : SmoothInvariantScalar) (τ : H) : ℂ :=
  g.1 τ / EtaHalfWeight.etaValue τ

theorem etaSection_smooth (g : SmoothInvariantScalar) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (etaSection g) := by
  exact (SmoothInvariantScalar.smooth g).div₀ EtaHalfWeight.etaValue_contMDiff
    (fun τ => EtaHalfWeight.etaValue_ne_zero τ)

/-- Exact inverse-eta covariance, with the orientation of `lineSmul`. -/
theorem etaSection_covariant
    (g : SmoothInvariantScalar) (γ : Gamma2) (τ : H) :
    etaSection g (γ • τ) =
      EtaHalfWeight.etaRatio γ τ * etaSection g τ := by
  rw [etaSection, etaSection, SmoothInvariantScalar.invariant g γ τ, EtaHalfWeight.etaRatio]
  field_simp [EtaHalfWeight.etaValue_ne_zero]
  <;> ring

/-- The same covariance written with Mock2's constructed half-weight multiplier. -/
theorem etaSection_multiplier_covariant
    (g : SmoothInvariantScalar) (γ : Gamma2) (τ : H) :
    etaSection g (γ • τ) =
      (EtaHalfWeight.multiplier.automorphyFactor γ τ : ℂ) *
        etaSection g τ := by
  simpa using etaSection_covariant g γ τ

/-- Division by eta is a linear map into the actual smooth covariant-section submodule. -/
noncomputable def etaSectionLinear :
    SmoothInvariantScalar →ₗ[ℂ] SmoothEtaCovariantSection where
  toFun g :=
    ⟨etaSection g, etaSection_smooth g, etaSection_covariant g⟩
  map_add' g h := by
    apply Subtype.ext
    funext τ
    simp only [etaSection, Submodule.coe_add, Pi.add_apply, add_div]
  map_smul' c g := by
    apply Subtype.ext
    funext τ
    simp only [etaSection, Submodule.coe_smul, Pi.smul_apply, smul_eq_mul,
      RingHom.id_apply]
    ring

/-- Eta-gauge trivialization of a covariant section: `g = eta * s`. -/
noncomputable def etaTrivialization
    (f : SmoothEtaCovariantSection) (τ : H) : ℂ :=
  EtaHalfWeight.etaValue τ * f.1 τ

theorem etaTrivialization_smooth (f : SmoothEtaCovariantSection) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (etaTrivialization f) := by
  exact EtaHalfWeight.etaValue_contMDiff.mul (SmoothEtaCovariantSection.smooth f)

theorem etaTrivialization_invariant
    (f : SmoothEtaCovariantSection) (γ : Gamma2) (τ : H) :
    etaTrivialization f (γ • τ) = etaTrivialization f τ := by
  rw [etaTrivialization, etaTrivialization,
    SmoothEtaCovariantSection.covariant f γ τ, EtaHalfWeight.etaRatio]
  field_simp [EtaHalfWeight.etaValue_ne_zero]
  <;> ring

/-- Multiplication by eta is linear and lands in the invariant gauge. -/
noncomputable def etaTrivializationLinear :
    SmoothEtaCovariantSection →ₗ[ℂ] SmoothInvariantScalar where
  toFun f :=
    ⟨etaTrivialization f, etaTrivialization_smooth f,
      etaTrivialization_invariant f⟩
  map_add' f h := by
    apply Subtype.ext
    funext τ
    simp only [etaTrivialization, Submodule.coe_add, Pi.add_apply]
    ring
  map_smul' c f := by
    apply Subtype.ext
    funext τ
    simp only [etaTrivialization, Submodule.coe_smul, Pi.smul_apply, smul_eq_mul,
      RingHom.id_apply]
    ring

@[simp] theorem etaTrivialization_etaSection
    (g : SmoothInvariantScalar) :
    etaTrivializationLinear (etaSectionLinear g) = g := by
  apply Subtype.ext
  funext τ
  change EtaHalfWeight.etaValue τ *
    (g.1 τ / EtaHalfWeight.etaValue τ) = g.1 τ
  exact mul_div_cancel₀ _ (EtaHalfWeight.etaValue_ne_zero τ)

@[simp] theorem etaSection_etaTrivialization
    (f : SmoothEtaCovariantSection) :
    etaSectionLinear (etaTrivializationLinear f) = f := by
  apply Subtype.ext
  funext τ
  change (EtaHalfWeight.etaValue τ * f.1 τ) /
    EtaHalfWeight.etaValue τ = f.1 τ
  exact mul_div_cancel_left₀ _ (EtaHalfWeight.etaValue_ne_zero τ)

/-- The eta gauge is an actual linear equivalence, not an assumed identification. -/
noncomputable def etaGaugeEquiv :
    SmoothInvariantScalar ≃ₗ[ℂ] SmoothEtaCovariantSection where
  toLinearMap := etaSectionLinear
  invFun := etaTrivializationLinear
  left_inv := etaTrivialization_etaSection
  right_inv := etaSection_etaTrivialization

/-! ## Actual manifold derivative and deck pullback -/

/-- The actual deck map on the upper-half-plane manifold. -/
def manifoldDeckMap (γ : Gamma2) : H → H :=
  fun τ => γ • τ

/-- The genuine manifold derivative of a deck transformation. -/
noncomputable def manifoldDeckDerivative
    (γ : Gamma2) (τ : H) : ScalarOneFormValue :=
  mfderiv 𝓘(ℂ) 𝓘(ℂ) (manifoldDeckMap γ) τ

theorem manifoldDeckMap_smooth (γ : Gamma2) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (manifoldDeckMap γ) := by
  change ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (fun τ : H => γ • τ)
  exact deckAction_contMDiff γ

/-- Pullback of a scalar one-form by the genuine manifold derivative of a deck map. -/
noncomputable def manifoldDeckPullback
    (γ : Gamma2) (A : H → ScalarOneFormValue) (τ : H) :
    ScalarOneFormValue :=
  (A (γ • τ)).comp (manifoldDeckDerivative γ τ)

/-- The genuine manifold differential of an invariant scalar. -/
noncomputable def rawDifferential
    (g : SmoothInvariantScalar) (τ : H) : ScalarOneFormValue :=
  mvfderiv 𝓘(ℂ) g.1 τ

/-- Chain-rule invariance of `dg`: `deckPullback(dg) = dg`. -/
theorem rawDifferential_deck_comp
    (g : SmoothInvariantScalar) (γ : Gamma2) (τ : H) :
    (rawDifferential g (γ • τ)).comp (manifoldDeckDerivative γ τ) =
      rawDifferential g τ := by
  have hgAt : MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) g.1 (γ • τ) :=
    ((SmoothInvariantScalar.smooth g).mdifferentiable (by simp)) (γ • τ)
  have hdeckAt :
      MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) (manifoldDeckMap γ) τ :=
    (manifoldDeckMap_smooth γ).mdifferentiable (by simp) τ
  have hfun : g.1 ∘ manifoldDeckMap γ = g.1 := by
    funext σ
    exact SmoothInvariantScalar.invariant g γ σ
  have hchain :
      (rawDifferential g (γ • τ)).comp (manifoldDeckDerivative γ τ) =
        (mvfderiv 𝓘(ℂ) (g.1 ∘ manifoldDeckMap γ) τ :
          ScalarOneFormValue) := by
    symm
    apply ContinuousLinearMap.ext
    intro v
    change
      NormedSpace.fromTangentSpace (g.1 (γ • τ))
          (mfderiv 𝓘(ℂ) 𝓘(ℂ) (g.1 ∘ manifoldDeckMap γ) τ v) =
        NormedSpace.fromTangentSpace (g.1 (γ • τ))
          (mfderiv 𝓘(ℂ) 𝓘(ℂ) g.1 (γ • τ)
            (mfderiv 𝓘(ℂ) 𝓘(ℂ) (manifoldDeckMap γ) τ v))
    exact congrArg
      (NormedSpace.fromTangentSpace (g.1 (γ • τ)))
      (mfderiv_comp_apply τ hgAt hdeckAt v)
  have htransport :
      (mvfderiv 𝓘(ℂ) (g.1 ∘ manifoldDeckMap γ) τ :
        ScalarOneFormValue) = rawDifferential g τ := by
    simpa only [rawDifferential, hfun]
  exact hchain.trans htransport

theorem rawDifferential_add
    (g h : SmoothInvariantScalar) (τ : H) :
    rawDifferential (g + h) τ =
      rawDifferential g τ + rawDifferential h τ := by
  have hg : MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) g.1 τ :=
    ((SmoothInvariantScalar.smooth g).mdifferentiable (by simp)) τ
  have hh : MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) h.1 τ :=
    ((SmoothInvariantScalar.smooth h).mdifferentiable (by simp)) τ
  change mvfderiv 𝓘(ℂ) (g.1 + h.1) τ =
    mvfderiv 𝓘(ℂ) g.1 τ + mvfderiv 𝓘(ℂ) h.1 τ
  exact mvfderiv_add hg hh

theorem rawDifferential_smul
    (c : ℂ) (g : SmoothInvariantScalar) (τ : H) :
    rawDifferential (c • g) τ = c • rawDifferential g τ := by
  have hg : MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ) g.1 τ :=
    ((SmoothInvariantScalar.smooth g).mdifferentiable (by simp)) τ
  have hc : MDifferentiableAt 𝓘(ℂ) 𝓘(ℂ)
      (fun _ : H => c) τ :=
    mdifferentiableAt_const
  change mvfderiv 𝓘(ℂ) ((fun _ : H => c) * g.1) τ =
    c • mvfderiv 𝓘(ℂ) g.1 τ
  simpa [mvfderiv_const] using
    (mvfderiv_smul hc hg)

/-! ## Eta-twisted one-forms and the covariant derivative -/

/-- Exact eta-twisted one-form covariance under the actual manifold pullback. -/
def IsEtaTwistedOneForm (A : H → ScalarOneFormValue) : Prop :=
  ∀ (γ : Gamma2) (τ : H),
    manifoldDeckPullback γ A τ =
      EtaHalfWeight.etaRatio γ τ • A τ

/-- Eta-twisted one-forms form a complex submodule.  Smoothness of a target one-form is not
bundled here; this carrier records exactly the covariance proved by the manifold chain rule. -/
noncomputable def etaTwistedOneForms :
    Submodule ℂ (H → ScalarOneFormValue) where
  carrier A := IsEtaTwistedOneForm A
  zero_mem' := by
    intro γ τ
    apply ContinuousLinearMap.ext
    intro v
    simp [manifoldDeckPullback]
  add_mem' := by
    intro A B hA hB γ τ
    apply ContinuousLinearMap.ext
    intro v
    have hAv := congrArg (fun L : ScalarOneFormValue => L v) (hA γ τ)
    have hBv := congrArg (fun L : ScalarOneFormValue => L v) (hB γ τ)
    change
      A (γ • τ) (manifoldDeckDerivative γ τ v) +
          B (γ • τ) (manifoldDeckDerivative γ τ v) =
        EtaHalfWeight.etaRatio γ τ * (A τ v + B τ v)
    change
      A (γ • τ) (manifoldDeckDerivative γ τ v) =
        EtaHalfWeight.etaRatio γ τ * A τ v at hAv
    change
      B (γ • τ) (manifoldDeckDerivative γ τ v) =
        EtaHalfWeight.etaRatio γ τ * B τ v at hBv
    rw [hAv, hBv, mul_add]
  smul_mem' := by
    intro c A hA γ τ
    apply ContinuousLinearMap.ext
    intro v
    have hAv := congrArg (fun L : ScalarOneFormValue => L v) (hA γ τ)
    change
      c * A (γ • τ) (manifoldDeckDerivative γ τ v) =
        EtaHalfWeight.etaRatio γ τ * (c * A τ v)
    change
      A (γ • τ) (manifoldDeckDerivative γ τ v) =
        EtaHalfWeight.etaRatio γ τ * A τ v at hAv
    rw [hAv]
    ring

abbrev EtaTwistedOneForm := etaTwistedOneForms

/-- The scalar identity converting the eta factor at `γτ` to the eta-ratio cocycle. -/
theorem etaValue_inv_smul_factor
    (γ : Gamma2) (τ : H) :
    (EtaHalfWeight.etaValue (γ • τ))⁻¹ =
      EtaHalfWeight.etaRatio γ τ *
        (EtaHalfWeight.etaValue τ)⁻¹ := by
  rw [EtaHalfWeight.etaRatio]
  field_simp [EtaHalfWeight.etaValue_ne_zero]
  <;> ring

/-- The eta-gauge differential `eta⁻¹ dg`. -/
noncomputable def etaGaugeDifferential
    (g : SmoothInvariantScalar) (τ : H) : ScalarOneFormValue :=
  (EtaHalfWeight.etaValue τ)⁻¹ • rawDifferential g τ

/-- The target one-form satisfies the exact multiplier covariance.  The proof uses the actual
`mfderiv` chain rule, not a formally assigned weight shift. -/
theorem etaGaugeDifferential_covariant
    (g : SmoothInvariantScalar) :
    IsEtaTwistedOneForm (etaGaugeDifferential g) := by
  intro γ τ
  apply ContinuousLinearMap.ext
  intro v
  have hdiff := congrArg (fun L : ScalarOneFormValue => L v)
    (rawDifferential_deck_comp g γ τ)
  change
    rawDifferential g (γ • τ) (manifoldDeckDerivative γ τ v) =
      rawDifferential g τ v at hdiff
  change
    (EtaHalfWeight.etaValue (γ • τ))⁻¹ *
        rawDifferential g (γ • τ) (manifoldDeckDerivative γ τ v) =
      EtaHalfWeight.etaRatio γ τ *
        ((EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential g τ v)
  rw [hdiff, etaValue_inv_smul_factor]
  ring

/-- The same target covariance written using Mock2's concrete multiplier system. -/
theorem etaGaugeDifferential_multiplier_covariant
    (g : SmoothInvariantScalar) (γ : Gamma2) (τ : H) :
    manifoldDeckPullback γ (etaGaugeDifferential g) τ =
      (EtaHalfWeight.multiplier.automorphyFactor γ τ : ℂ) •
        etaGaugeDifferential g τ := by
  simpa using etaGaugeDifferential_covariant g γ τ

/-- `g ↦ eta⁻¹ dg` is a linear map into the eta-twisted one-form module. -/
noncomputable def covariantDerivativeLinear :
    SmoothInvariantScalar →ₗ[ℂ] EtaTwistedOneForm where
  toFun g := ⟨etaGaugeDifferential g, etaGaugeDifferential_covariant g⟩
  map_add' g h := by
    apply Subtype.ext
    funext τ
    apply ContinuousLinearMap.ext
    intro v
    change
      (EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential (g + h) τ v =
        (EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential g τ v +
          (EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential h τ v
    rw [rawDifferential_add]
    simp only [ContinuousLinearMap.add_apply]
    ring
  map_smul' c g := by
    apply Subtype.ext
    funext τ
    apply ContinuousLinearMap.ext
    intro v
    change
      (EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential (c • g) τ v =
        c * ((EtaHalfWeight.etaValue τ)⁻¹ * rawDifferential g τ v)
    rw [rawDifferential_smul]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring

/-- The covariant derivative on inverse-eta sections, defined by first entering the invariant
eta gauge and then applying `eta⁻¹ d`. -/
noncomputable def etaCovariantDerivativeLinear :
    SmoothEtaCovariantSection →ₗ[ℂ] EtaTwistedOneForm :=
  covariantDerivativeLinear.comp etaTrivializationLinear

/-- The requested exact formula `D_eta(g / eta) = eta⁻¹ mfderiv(g)`. -/
theorem etaCovariantDerivative_etaSection
    (g : SmoothInvariantScalar) :
    etaCovariantDerivativeLinear (etaSectionLinear g) =
      covariantDerivativeLinear g := by
  change
    covariantDerivativeLinear
        (etaTrivializationLinear (etaSectionLinear g)) =
      covariantDerivativeLinear g
  rw [etaTrivialization_etaSection]

theorem etaCovariantDerivative_etaSection_apply
    (g : SmoothInvariantScalar) (τ : H) :
    (etaCovariantDerivativeLinear (etaSectionLinear g)).1 τ =
      (EtaHalfWeight.etaValue τ)⁻¹ •
        mfderiv 𝓘(ℂ) 𝓘(ℂ) g.1 τ := by
  change (etaCovariantDerivativeLinear (etaSectionLinear g)).1 τ =
    (covariantDerivativeLinear g).1 τ
  exact congrArg (fun A : EtaTwistedOneForm => A.1 τ)
    (etaCovariantDerivative_etaSection g)

end Geometry

end QYM.Mock2EtaCovariantDerivativeExtension


open Function Set MeasureTheory
open scoped ENNReal MatrixGroups UpperHalfPlane Manifold ContDiff

namespace QYM.FullCertification.Mock2EtaH1GraphCompletionExtension

open QYM.FullCertification.Mock2EtaPeterssonCarrierExtension
open QYM.Mock2EtaCovariantDerivativeExtension
open QYM.Mock2EtaCovariantDerivativeExtension.Geometry

/-!
# The concrete inverse-eta H1 graph completion on a hyperbolic truncation

This file joins two previously concrete constructions:

* the restricted hyperbolic measure and inverse-eta Petersson `L²` carrier;
* the genuine manifold derivative `g ↦ eta⁻¹ dg` in the invariant eta gauge.

For a fixed closed-ball radius `Y`, the core consists exactly of the globally
smooth `Gamma(2)`-invariant scalars `g` for which both `g / eta` and the
coefficient of `eta⁻¹ dg` are in the actual restricted-measure `L²` space.
Its graph is placed in the Hilbert sum

`WithLp 2 (L²_scalar × L²_oneForm)`.

The H1 completion and the derivative graph completion below are definitionally
the same closed subspace: the topological closure of this actual graph range.
Consequently their equivalence is an honest reflexive linear isometry, rather
than a certificate supplied as an input.

No identification with a classical weak Sobolev space, Green identity,
closability statement, or formal-adjoint assertion is made here.  Those need
additional boundary and real-smooth integration-by-parts theorems.
-/

/-- The upper half-plane used by both concrete producer modules. -/
abbrev H := Mock2.Definition15Geometry.H

/-- The smooth invariant eta-gauge scalar carrier. -/
abbrev SmoothInvariantScalar :=
  QYM.Mock2EtaCovariantDerivativeExtension.Geometry.SmoothInvariantScalar

/-! ## A lossless scalar coordinate for complex one-forms -/

/-- A complex-linear one-form on the one-dimensional complex tangent model is
determined by its value at `1`. -/
theorem scalarOneFormValue_apply_eq_mul_evalOne
    (A : ScalarOneFormValue) (z : ℂ) :
    A z = z * A 1 := by
  simpa only [smul_eq_mul, mul_one] using A.map_smul z (1 : ℂ)

/-- Evaluation at `1` is injective on the concrete complex one-form fiber. -/
theorem scalarOneFormValue_ext_evalOne
    {A B : ScalarOneFormValue} (h : A 1 = B 1) :
    A = B := by
  apply ContinuousLinearMap.ext
  intro z
  calc
    A z = z * A 1 := scalarOneFormValue_apply_eq_mul_evalOne A z
    _ = z * B 1 := by rw [h]
    _ = B z := (scalarOneFormValue_apply_eq_mul_evalOne B z).symm

/-- Evaluation at `1` also preserves the operator norm on the concrete
one-dimensional complex one-form fiber. -/
theorem scalarOneFormValue_norm_eq_norm_evalOne
    (A : ScalarOneFormValue) :
    ‖A‖ = ‖A 1‖ := by
  apply le_antisymm
  · refine A.opNorm_le_bound (norm_nonneg (A 1)) ?_
    intro z
    rw [scalarOneFormValue_apply_eq_mul_evalOne, norm_mul]
    exact le_of_eq (mul_comm ‖z‖ ‖A 1‖)
  · simpa only [norm_one, mul_one] using A.le_opNorm (1 : ℂ)

/-- The lossless scalar coefficient of the actual eta-gauge one-form
`eta⁻¹ dg`. -/
noncomputable def etaGaugeOneFormCoefficient
    (g : SmoothInvariantScalar) (tau : H) : ℂ :=
  etaGaugeDifferential g tau 1

/-- The coefficient function is additive because the actual eta-gauge
derivative is additive. -/
theorem etaGaugeOneFormCoefficient_add
    (g h : SmoothInvariantScalar) :
    etaGaugeOneFormCoefficient (g + h) =
      etaGaugeOneFormCoefficient g + etaGaugeOneFormCoefficient h := by
  funext tau
  simp only [etaGaugeOneFormCoefficient, etaGaugeDifferential,
    rawDifferential_add, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.add_apply, Pi.add_apply, smul_eq_mul]
  ring

/-- The coefficient function respects complex scalar multiplication. -/
theorem etaGaugeOneFormCoefficient_smul
    (c : ℂ) (g : SmoothInvariantScalar) :
    etaGaugeOneFormCoefficient (c • g) =
      c • etaGaugeOneFormCoefficient g := by
  funext tau
  simp only [etaGaugeOneFormCoefficient, etaGaugeDifferential,
    rawDifferential_smul, ContinuousLinearMap.smul_apply, Pi.smul_apply,
    smul_eq_mul]
  ring

/-- The coefficient of the zero eta-gauge derivative is the zero function. -/
theorem etaGaugeOneFormCoefficient_zero :
    etaGaugeOneFormCoefficient (0 : SmoothInvariantScalar) = 0 := by
  simpa only [zero_smul] using
    (etaGaugeOneFormCoefficient_smul (0 : ℂ)
      (0 : SmoothInvariantScalar))

/-! ## Linearity of the eta-gauge section representative -/

/-- Division by eta sends the zero invariant scalar to the zero section. -/
theorem etaSection_zero :
    etaSection (0 : SmoothInvariantScalar) = 0 := by
  funext tau
  simp only [etaSection, Submodule.coe_zero, Pi.zero_apply, zero_div,
    Pi.zero_apply]

/-- Division by eta is additive on invariant gauge scalars. -/
theorem etaSection_add (g h : SmoothInvariantScalar) :
    etaSection (g + h) = etaSection g + etaSection h := by
  funext tau
  simp only [etaSection, Submodule.coe_add, Pi.add_apply, Pi.add_apply,
    add_div]

/-- Division by eta respects complex scalar multiplication. -/
theorem etaSection_smul (c : ℂ) (g : SmoothInvariantScalar) :
    etaSection (c • g) = c • etaSection g := by
  funext tau
  simp only [etaSection, Submodule.coe_smul, Pi.smul_apply, Pi.smul_apply,
    smul_eq_mul, mul_div_assoc]

/-! ## The actual restricted-measure H1 core -/

/-- Smooth invariant eta-gauge scalars whose section and genuine eta-gauge
derivative coefficient are both square integrable on the hyperbolic
closed-ball truncation. -/
noncomputable def etaH1Core (Y : ℝ) :
    Submodule ℂ SmoothInvariantScalar where
  carrier g :=
    MemLp (etaSection g) 2 (truncatedHyperbolicMeasure Y) ∧
      MemLp (etaGaugeOneFormCoefficient g) 2
        (truncatedHyperbolicMeasure Y)
  zero_mem' := by
    constructor
    · rw [etaSection_zero]
      exact MemLp.zero
    · rw [etaGaugeOneFormCoefficient_zero]
      exact MemLp.zero
  add_mem' := by
    intro g h hg hh
    constructor
    · rw [etaSection_add]
      exact hg.1.add hh.1
    · rw [etaGaugeOneFormCoefficient_add]
      exact hg.2.add hh.2
  smul_mem' := by
    intro c g hg
    constructor
    · rw [etaSection_smul]
      exact hg.1.const_smul c
    · rw [etaGaugeOneFormCoefficient_smul]
      exact hg.2.const_smul c

/-- Membership in the concrete H1 core, without unfolding its submodule
record. -/
theorem mem_etaH1Core_iff (Y : ℝ) (g : SmoothInvariantScalar) :
    g ∈ etaH1Core Y ↔
      MemLp (etaSection g) 2 (truncatedHyperbolicMeasure Y) ∧
        MemLp (etaGaugeOneFormCoefficient g) 2
          (truncatedHyperbolicMeasure Y) := by
  rfl

/-! ## A concrete inverse-eta inhabitant with zero derivative -/

/-- The globally constant invariant eta-gauge scalar `g = 1`. -/
noncomputable def constantOneInvariant : SmoothInvariantScalar :=
  ⟨fun _ => 1, contMDiff_const, by
    intro gamma tau
    rfl⟩

@[simp] theorem constantOneInvariant_apply (tau : H) :
    (constantOneInvariant : H → ℂ) tau = 1 := by
  rfl

/-- The section represented by `g = 1` is exactly the concrete inverse-eta
section from the Petersson carrier producer. -/
theorem etaSection_constantOne :
    etaSection constantOneInvariant = inverseEtaSection := by
  funext tau
  simp only [etaSection, constantOneInvariant_apply, inverseEtaSection,
    one_div]

/-- The genuine manifold differential of the constant invariant scalar is
zero. -/
theorem rawDifferential_constantOne (tau : H) :
    rawDifferential constantOneInvariant tau = 0 := by
  change mvfderiv 𝓘(ℂ) (fun _ : H => (1 : ℂ)) tau = 0
  exact mvfderiv_const (I := 𝓘(ℂ)) (c := (1 : ℂ)) (x := tau)

/-- Hence the actual eta-gauge derivative coefficient of the inverse-eta
section is identically zero. -/
theorem etaGaugeOneFormCoefficient_constantOne :
    etaGaugeOneFormCoefficient constantOneInvariant = 0 := by
  funext tau
  simp only [etaGaugeOneFormCoefficient, etaGaugeDifferential,
    rawDifferential_constantOne, ContinuousLinearMap.smul_apply,
    smul_zero, ContinuousLinearMap.zero_apply, Pi.zero_apply]

/-- The inverse-eta section, with its proved zero derivative, is an actual
element of the H1 core for every truncation radius. -/
noncomputable def inverseEtaH1CoreElement (Y : ℝ) : etaH1Core Y :=
  ⟨constantOneInvariant, by
    constructor
    · rw [etaSection_constantOne]
      exact inverseEtaSection_memLp Y
    · rw [etaGaugeOneFormCoefficient_constantOne]
      exact MemLp.zero⟩

@[simp] theorem inverseEtaH1CoreElement_apply
    (Y : ℝ) (tau : H) :
    ((inverseEtaH1CoreElement Y : SmoothInvariantScalar) : H → ℂ) tau = 1 := by
  rfl

/-! ## The two actual `L²` coordinates of the graph -/

/-- The scalar-section `L²` carrier. -/
abbrev TruncatedEtaScalarL2 (Y : ℝ) := TruncatedPeterssonL2 Y

/-- The `L²` carrier of the lossless one-form coefficient.  The preceding
fiber theorem proves that this coefficient has exactly the operator norm of
the original complex one-form. -/
abbrev TruncatedEtaOneFormL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (truncatedHyperbolicMeasure Y)

/-- Send an H1-core scalar to the a.e. class of its inverse-eta section. -/
noncomputable def etaH1CoreScalarToL2 (Y : ℝ)
    (g : etaH1Core Y) : TruncatedEtaScalarL2 Y :=
  g.property.1.toLp (etaSection g.1)

/-- The scalar `L²` coordinate agrees almost everywhere with its smooth
inverse-eta representative. -/
theorem etaH1CoreScalarToL2_coeFn_ae (Y : ℝ)
    (g : etaH1Core Y) :
    ((etaH1CoreScalarToL2 Y g : TruncatedEtaScalarL2 Y) : H → ℂ) =ᵐ[
        truncatedHyperbolicMeasure Y]
      etaSection g.1 := by
  exact g.property.1.coeFn_toLp

/-- The scalar coordinate of the graph is complex linear. -/
noncomputable def etaH1CoreScalarToL2Linear (Y : ℝ) :
    etaH1Core Y →ₗ[ℂ] TruncatedEtaScalarL2 Y where
  toFun := etaH1CoreScalarToL2 Y
  map_add' g h := by
    simpa only [etaH1CoreScalarToL2, Submodule.coe_add, etaSection_add] using
      (MemLp.toLp_add g.property.1 h.property.1)
  map_smul' c g := by
    simpa only [etaH1CoreScalarToL2, Submodule.coe_smul, etaSection_smul,
      RingHom.id_apply] using
      (MemLp.toLp_const_smul c g.property.1)

@[simp] theorem etaH1CoreScalarToL2Linear_apply
    (Y : ℝ) (g : etaH1Core Y) :
    etaH1CoreScalarToL2Linear Y g = etaH1CoreScalarToL2 Y g := by
  rfl

/-- Send an H1-core scalar to the a.e. class of its actual eta-gauge
one-form coefficient. -/
noncomputable def etaH1CoreOneFormToL2 (Y : ℝ)
    (g : etaH1Core Y) : TruncatedEtaOneFormL2 Y :=
  g.property.2.toLp (etaGaugeOneFormCoefficient g.1)

/-- The derivative `L²` coordinate agrees almost everywhere with the
lossless coefficient of the actual smooth eta-gauge one-form. -/
theorem etaH1CoreOneFormToL2_coeFn_ae (Y : ℝ)
    (g : etaH1Core Y) :
    ((etaH1CoreOneFormToL2 Y g : TruncatedEtaOneFormL2 Y) : H → ℂ) =ᵐ[
        truncatedHyperbolicMeasure Y]
      etaGaugeOneFormCoefficient g.1 := by
  exact g.property.2.coeFn_toLp

/-- The one-form coordinate of the graph is complex linear. -/
noncomputable def etaH1CoreOneFormToL2Linear (Y : ℝ) :
    etaH1Core Y →ₗ[ℂ] TruncatedEtaOneFormL2 Y where
  toFun := etaH1CoreOneFormToL2 Y
  map_add' g h := by
    simpa only [etaH1CoreOneFormToL2, Submodule.coe_add,
      etaGaugeOneFormCoefficient_add] using
      (MemLp.toLp_add g.property.2 h.property.2)
  map_smul' c g := by
    simpa only [etaH1CoreOneFormToL2, Submodule.coe_smul,
      etaGaugeOneFormCoefficient_smul, RingHom.id_apply] using
      (MemLp.toLp_const_smul c g.property.2)

@[simp] theorem etaH1CoreOneFormToL2Linear_apply
    (Y : ℝ) (g : etaH1Core Y) :
    etaH1CoreOneFormToL2Linear Y g = etaH1CoreOneFormToL2 Y g := by
  rfl

/-! ## The actual Hilbert graph and its norm -/

/-- The `L²` Hilbert sum of the section and one-form coordinates. -/
abbrev EtaH1GraphAmbient (Y : ℝ) :=
  WithLp 2 (TruncatedEtaScalarL2 Y × TruncatedEtaOneFormL2 Y)

/-- The actual derivative graph map `g ↦ (g / eta, eta⁻¹ dg)`, with both
coordinates interpreted as restricted-measure a.e. classes. -/
noncomputable def etaH1GraphMap (Y : ℝ) :
    etaH1Core Y →ₗ[ℂ] EtaH1GraphAmbient Y :=
  (WithLp.linearEquiv 2 ℂ
      (TruncatedEtaScalarL2 Y × TruncatedEtaOneFormL2 Y)).symm.toLinearMap.comp
    ((etaH1CoreScalarToL2Linear Y).prod
      (etaH1CoreOneFormToL2Linear Y))

@[simp] theorem etaH1GraphMap_fst (Y : ℝ) (g : etaH1Core Y) :
    (etaH1GraphMap Y g).fst = etaH1CoreScalarToL2 Y g := by
  rfl

@[simp] theorem etaH1GraphMap_snd (Y : ℝ) (g : etaH1Core Y) :
    (etaH1GraphMap Y g).snd = etaH1CoreOneFormToL2 Y g := by
  rfl

/-- The graph norm is the genuine `L²` product norm supplied by `WithLp 2`. -/
noncomputable def etaH1GraphNorm (Y : ℝ) (g : etaH1Core Y) : ℝ :=
  ‖etaH1GraphMap Y g‖

/-- Exact graph norm-square identity, with no norm-equivalence constants or
certificate fields. -/
theorem etaH1GraphNorm_sq (Y : ℝ) (g : etaH1Core Y) :
    etaH1GraphNorm Y g ^ 2 =
      ‖etaH1CoreScalarToL2 Y g‖ ^ 2 +
        ‖etaH1CoreOneFormToL2 Y g‖ ^ 2 := by
  simpa only [etaH1GraphNorm, etaH1GraphMap_fst, etaH1GraphMap_snd] using
    (WithLp.prod_norm_sq_eq_of_L2 (etaH1GraphMap Y g))

/-! ## The graph image, its closure, and its dense isometric inclusion -/

/-- The a.e.-quotiented range of the actual eta-gauge derivative graph. -/
noncomputable def etaH1GraphRange (Y : ℝ) :
    Submodule ℂ (EtaH1GraphAmbient Y) :=
  LinearMap.range (etaH1GraphMap Y)

/-- The actual graph core image after quotienting both coordinates by almost
everywhere equality. -/
abbrev EtaH1GraphCoreImage (Y : ℝ) := etaH1GraphRange Y

/-- The derivative graph completion: the closed subspace generated by the
actual graph image. -/
abbrev EtaDerivativeGraphCompletion (Y : ℝ) :=
  (etaH1GraphRange Y).topologicalClosure

/-- The concrete H1 completion.  It is deliberately the same actual graph
closure as `EtaDerivativeGraphCompletion`. -/
abbrev EtaH1Completion (Y : ℝ) :=
  (etaH1GraphRange Y).topologicalClosure

/-- The graph range is contained in its completion. -/
theorem etaH1GraphRange_le_completion (Y : ℝ) :
    etaH1GraphRange Y ≤
      (etaH1GraphRange Y).topologicalClosure := by
  exact Submodule.le_topologicalClosure (etaH1GraphRange Y)

/-- The concrete derivative graph completion is closed in the Hilbert graph
ambient space. -/
theorem etaDerivativeGraphCompletion_isClosed (Y : ℝ) :
    IsClosed
      ((EtaDerivativeGraphCompletion Y :
          Submodule ℂ (EtaH1GraphAmbient Y)) :
        Set (EtaH1GraphAmbient Y)) := by
  exact Submodule.isClosed_topologicalClosure (etaH1GraphRange Y)

/-- Its carrier set is literally the topological closure of the actual graph
range. -/
theorem etaDerivativeGraphCompletion_coe (Y : ℝ) :
    ((EtaDerivativeGraphCompletion Y :
        Submodule ℂ (EtaH1GraphAmbient Y)) :
      Set (EtaH1GraphAmbient Y)) =
      closure
        ((etaH1GraphRange Y :
            Submodule ℂ (EtaH1GraphAmbient Y)) :
          Set (EtaH1GraphAmbient Y)) := by
  rfl

/-- Canonical inclusion of the a.e.-quotiented graph core image into its
closed graph completion. -/
noncomputable def etaH1GraphCoreImageInclusion (Y : ℝ) :
    EtaH1GraphCoreImage Y →ₗᵢ[ℂ] EtaDerivativeGraphCompletion Y where
  toFun f :=
    ⟨(f : EtaH1GraphAmbient Y),
      etaH1GraphRange_le_completion Y f.property⟩
  map_add' f g := by
    rfl
  map_smul' c f := by
    rfl
  norm_map' f := by
    rfl

/-- The graph-core inclusion is injective. -/
theorem etaH1GraphCoreImageInclusion_injective (Y : ℝ) :
    Function.Injective (etaH1GraphCoreImageInclusion Y) :=
  (etaH1GraphCoreImageInclusion Y).injective

/-- The actual graph core image is dense in its completion, directly from
the definition by topological closure. -/
theorem etaH1GraphCoreImageInclusion_denseRange (Y : ℝ) :
    DenseRange (etaH1GraphCoreImageInclusion Y) := by
  change Dense
    (Set.range (fun f : EtaH1GraphCoreImage Y =>
      etaH1GraphCoreImageInclusion Y f))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : EtaH1GraphAmbient Y) ∈
      closure
        (Subtype.val ''
          Set.range (fun f : EtaH1GraphCoreImage Y =>
            etaH1GraphCoreImageInclusion Y f))
  have hImage :
      Subtype.val ''
          Set.range (fun f : EtaH1GraphCoreImage Y =>
            etaH1GraphCoreImageInclusion Y f) =
        ((etaH1GraphRange Y :
            Submodule ℂ (EtaH1GraphAmbient Y)) :
          Set (EtaH1GraphAmbient Y)) := by
    ext z
    constructor
    · rintro ⟨w, ⟨f, rfl⟩, rfl⟩
      exact f.property
    · intro hz
      let f : EtaH1GraphCoreImage Y := ⟨z, hz⟩
      exact ⟨etaH1GraphCoreImageInclusion Y f, ⟨f, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-! ## Complete Hilbert structures and equality of the two completions -/

/-- The graph closure inherits a complete-space structure from the actual
`L² ⊕₂ L²` ambient Hilbert space. -/
noncomputable def etaDerivativeGraphCompletionCompleteSpace (Y : ℝ) :
    CompleteSpace (EtaDerivativeGraphCompletion Y) :=
  inferInstance

/-- The graph closure inherits the complex inner-product structure of the
actual `L² ⊕₂ L²` ambient space. -/
noncomputable def etaDerivativeGraphCompletionInnerProductSpace (Y : ℝ) :
    InnerProductSpace ℂ (EtaDerivativeGraphCompletion Y) :=
  inferInstance

/-- The identically implemented H1 completion is complete as well. -/
noncomputable def etaH1CompletionCompleteSpace (Y : ℝ) :
    CompleteSpace (EtaH1Completion Y) :=
  inferInstance

/-- The identically implemented H1 completion is a complex Hilbert space. -/
noncomputable def etaH1CompletionInnerProductSpace (Y : ℝ) :
    InnerProductSpace ℂ (EtaH1Completion Y) :=
  inferInstance

/-- Equality of the two named closed submodules is definitional: both are the
closure of the same actual derivative graph range. -/
theorem etaH1Completion_eq_derivativeGraphCompletion (Y : ℝ) :
    (EtaH1Completion Y : Submodule ℂ (EtaH1GraphAmbient Y)) =
      EtaDerivativeGraphCompletion Y := by
  rfl

/-- The H1 completion and derivative graph completion are the same concrete
closed subspace, hence canonically linearly isometric. -/
noncomputable def etaH1CompletionEquivDerivativeGraphCompletion (Y : ℝ) :
    EtaH1Completion Y ≃ₗᵢ[ℂ] EtaDerivativeGraphCompletion Y :=
  LinearIsometryEquiv.refl ℂ _

@[simp] theorem etaH1CompletionEquivDerivativeGraphCompletion_apply
    (Y : ℝ) (u : EtaH1Completion Y) :
    etaH1CompletionEquivDerivativeGraphCompletion Y u = u := by
  rfl

/-- A single unconditional presentation theorem collecting the actual H1
core inhabitant, exact graph norm, closed completion, dense core-image
inclusion, and equality of the H1 and graph completions. -/
theorem concrete_inverseEta_H1_graph_completion (Y : ℝ) :
    constantOneInvariant ∈ etaH1Core Y ∧
      etaGaugeOneFormCoefficient constantOneInvariant = 0 ∧
      (∀ g : etaH1Core Y,
        etaH1GraphNorm Y g ^ 2 =
          ‖etaH1CoreScalarToL2 Y g‖ ^ 2 +
            ‖etaH1CoreOneFormToL2 Y g‖ ^ 2) ∧
      IsClosed
        ((EtaDerivativeGraphCompletion Y :
            Submodule ℂ (EtaH1GraphAmbient Y)) :
          Set (EtaH1GraphAmbient Y)) ∧
      Function.Injective (etaH1GraphCoreImageInclusion Y) ∧
      DenseRange (etaH1GraphCoreImageInclusion Y) ∧
      Function.Bijective
        (etaH1CompletionEquivDerivativeGraphCompletion Y) := by
  exact
    ⟨(inverseEtaH1CoreElement Y).property,
      etaGaugeOneFormCoefficient_constantOne,
      etaH1GraphNorm_sq Y,
      etaDerivativeGraphCompletion_isClosed Y,
      etaH1GraphCoreImageInclusion_injective Y,
      etaH1GraphCoreImageInclusion_denseRange Y,
      (etaH1CompletionEquivDerivativeGraphCompletion Y).bijective⟩

end QYM.FullCertification.Mock2EtaH1GraphCompletionExtension


open Function Set MeasureTheory
open scoped ENNReal MatrixGroups UpperHalfPlane Manifold ContDiff

namespace QYM.FullCertification.Mock2EtaQuotientMeasureExtension

open QYM.FullCertification.Mock2EtaPeterssonCarrierExtension

/-!
# The actual Gamma(2) quotient with a closed-ball pushforward measure

This module adds a measurable and `L²` layer on the literal orbit quotient

`Gamma(2) \ UpperHalfPlane`.

The measure used below is deliberately the pushforward of the hyperbolic
volume restricted to the closed ball from the preceding carrier module.  It
is not asserted to be the canonical invariant quotient volume, and the closed
ball is not asserted to be a fundamental domain.  In particular, different
closed-ball radii can count different collections of orbit representatives.

Mathlib already equips a `Quotient` of a measurable type with the measurable
space `MeasurableSpace.map Quotient.mk'`: a set downstairs is measurable
exactly when its full preimage is measurable upstairs.  We use that existing
instance instead of installing a competing measurable-space instance.

There are two distinct descent statements in this file.

* An invariant scalar function descends to an ordinary quotient function and
  hence to quotient `L²`.
* An eta-covariant scalar lift does not descend to an ordinary scalar
  function.  It descends to an honest section of Mock2's associated
  automorphic line-bundle quotient.  Multiplication by `eta` trivializes its
  covariance and produces an invariant scalar which does descend to quotient
  `L²`.
-/

/-- The actual upper half-plane used by Mock2. -/
abbrev H := Mock2.Definition15Geometry.H

/-- The actual principal congruence subgroup `Gamma(2)`. -/
abbrev Gamma2 := Mock2.Definition15Geometry.Gamma2

/-- Mock2's literal orbit quotient `Gamma(2) \ UpperHalfPlane`. -/
abbrev Gamma2Quotient := Mock2.Definition15Geometry.X

/-- The literal quotient projection used in Mock2. -/
abbrev quotientMap : H → Gamma2Quotient :=
  Mock2.Definition15Geometry.quotientMap

/-! ## The quotient measurable space and quotient projection -/

/-- The existing measurable space on the quotient is definitionally the
coinduced measurable space `MeasurableSpace.map quotientMap`. -/
theorem gamma2Quotient_measurableSpace_eq_map :
    (inferInstance : MeasurableSpace Gamma2Quotient) =
      ((inferInstance : MeasurableSpace H).map quotientMap) := by
  rfl

/-- A quotient set is measurable exactly when its full preimage is measurable
on the upper half-plane. -/
theorem measurableSet_gamma2Quotient_iff (s : Set Gamma2Quotient) :
    MeasurableSet s ↔ MeasurableSet (quotientMap ⁻¹' s) := by
  rfl

/-- The literal quotient projection is measurable for the existing coinduced
measurable structure. -/
theorem quotientMap_measurable : Measurable quotientMap := by
  change Measurable
    (@Quotient.mk' H (MulAction.orbitRel Gamma2 H))
  exact
    @measurable_quotient_mk' H _
      (MulAction.orbitRel Gamma2 H)

/-- The same quotient projection is continuous for Mock2's quotient topology. -/
theorem quotientMap_continuous : Continuous quotientMap :=
  Mock2.Definition15Geometry.quotientMapContinuous.continuous

/-- Every orbit class has an upper-half-plane representative. -/
theorem quotientMap_surjective : Function.Surjective quotientMap := by
  change Function.Surjective
    (@Quotient.mk' H (MulAction.orbitRel Gamma2 H))
  exact
    @Quotient.mk'_surjective H
      (MulAction.orbitRel Gamma2 H)

/-! ## The chosen closed-ball pushforward measure -/

/-- Push the finite closed-ball-restricted hyperbolic measure to the literal
orbit quotient.

This is a chosen truncation pushforward, not a claim that the ball is a
fundamental domain or that this is the canonical quotient-invariant measure. -/
noncomputable def truncatedQuotientMeasure (Y : ℝ) :
    Measure Gamma2Quotient :=
  Measure.map quotientMap (truncatedHyperbolicMeasure Y)

/-- Evaluation of the pushforward on a measurable quotient set. -/
theorem truncatedQuotientMeasure_apply (Y : ℝ)
    {s : Set Gamma2Quotient} (hs : MeasurableSet s) :
    truncatedQuotientMeasure Y s =
      truncatedHyperbolicMeasure Y (quotientMap ⁻¹' s) := by
  unfold truncatedQuotientMeasure
  exact Measure.map_apply quotientMap_measurable hs

/-- The pushforward can be evaluated directly as hyperbolic volume of the
part of the closed ball lying over the chosen quotient set. -/
theorem truncatedQuotientMeasure_apply_eq_volume (Y : ℝ)
    {s : Set Gamma2Quotient} (hs : MeasurableSet s) :
    truncatedQuotientMeasure Y s =
      (volume : Measure H)
        ((quotientMap ⁻¹' s) ∩ hyperbolicClosedBallTruncation Y) := by
  calc
    truncatedQuotientMeasure Y s =
        truncatedHyperbolicMeasure Y (quotientMap ⁻¹' s) :=
      truncatedQuotientMeasure_apply Y hs
    _ = (volume : Measure H)
          ((quotientMap ⁻¹' s) ∩ hyperbolicClosedBallTruncation Y) :=
      truncatedHyperbolicMeasure_apply Y (quotientMap_measurable hs)

/-- Pushforward preserves the total mass of the chosen restricted measure. -/
theorem truncatedQuotientMeasure_univ (Y : ℝ) :
    truncatedQuotientMeasure Y Set.univ =
      truncatedHyperbolicMeasure Y Set.univ := by
  calc
    truncatedQuotientMeasure Y Set.univ =
        truncatedHyperbolicMeasure Y (quotientMap ⁻¹' Set.univ) :=
      truncatedQuotientMeasure_apply Y MeasurableSet.univ
    _ = truncatedHyperbolicMeasure Y Set.univ := by
      rw [Set.preimage_univ]

/-- The chosen quotient pushforward is a finite measure for every real
closed-ball radius. -/
noncomputable instance truncatedQuotientMeasure_isFinite (Y : ℝ) :
    IsFiniteMeasure (truncatedQuotientMeasure Y) :=
  Measure.isFiniteMeasure_map (truncatedHyperbolicMeasure Y) quotientMap

/-- Explicit finiteness of the total quotient mass. -/
theorem truncatedQuotientMeasure_univ_lt_top (Y : ℝ) :
    truncatedQuotientMeasure Y Set.univ < (∞ : ℝ≥0∞) := by
  exact MeasureTheory.measure_lt_top (truncatedQuotientMeasure Y) Set.univ

/-- Increasing the closed-ball radius increases its quotient pushforward. -/
theorem truncatedQuotientMeasure_mono {Y Z : ℝ} (hYZ : Y ≤ Z) :
    truncatedQuotientMeasure Y ≤ truncatedQuotientMeasure Z := by
  exact Measure.map_mono (truncatedHyperbolicMeasure_mono hYZ)
    quotientMap_measurable

/-- By construction, the quotient projection is measure preserving from the
chosen restricted measure to its pushforward. -/
noncomputable def quotientMap_measurePreserving (Y : ℝ) :
    MeasurePreserving quotientMap
      (truncatedHyperbolicMeasure Y) (truncatedQuotientMeasure Y) where
  measurable := quotientMap_measurable
  map_eq := rfl

/-- Bochner integration against the chosen quotient pushforward is exactly
integration of the pullback against the chosen closed-ball measure. -/
theorem integral_truncatedQuotientMeasure
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Y : ℝ) (F : Gamma2Quotient → E)
    (hF : AEStronglyMeasurable F (truncatedQuotientMeasure Y)) :
    (∫ x : Gamma2Quotient, F x ∂truncatedQuotientMeasure Y) =
      ∫ tau : H, F (quotientMap tau) ∂truncatedHyperbolicMeasure Y := by
  change
    (∫ x : Gamma2Quotient, F x
        ∂Measure.map quotientMap (truncatedHyperbolicMeasure Y)) = _
  exact MeasureTheory.integral_map
    quotientMap_measurable.aemeasurable hF

/-! ## The quotient `L²` carrier and its exact pullback -/

/-- The ordinary complex `L²` space on the chosen quotient pushforward. -/
abbrev TruncatedQuotientPeterssonL2 (Y : ℝ) :=
  MeasureTheory.Lp ℂ 2 (truncatedQuotientMeasure Y)

/-- Pullback along the measure-preserving quotient projection is a complex
linear isometry from quotient `L²` into the closed-ball `L²` upstairs. -/
noncomputable def quotientPullbackL2 (Y : ℝ) :
    TruncatedQuotientPeterssonL2 Y →ₗᵢ[ℂ] TruncatedPeterssonL2 Y :=
  MeasureTheory.Lp.compMeasurePreservingₗᵢ ℂ quotientMap
    (quotientMap_measurePreserving Y)

/-- A quotient `L²` representative pulls back almost everywhere by literal
composition with the quotient projection. -/
theorem quotientPullbackL2_coeFn_ae (Y : ℝ)
    (F : TruncatedQuotientPeterssonL2 Y) :
    ((quotientPullbackL2 Y F : TruncatedPeterssonL2 Y) : H → ℂ) =ᵐ[
        truncatedHyperbolicMeasure Y]
      fun tau => F (quotientMap tau) := by
  change
    MeasureTheory.Lp.compMeasurePreserving quotientMap
        (quotientMap_measurePreserving Y) F =ᵐ[
          truncatedHyperbolicMeasure Y]
      fun tau => F (quotientMap tau)
  simpa only [Function.comp_def] using
    (MeasureTheory.Lp.coeFn_compMeasurePreserving F
      (quotientMap_measurePreserving Y))

/-- Pullback preserves the exact `L²` norm. -/
theorem quotientPullbackL2_norm (Y : ℝ)
    (F : TruncatedQuotientPeterssonL2 Y) :
    ‖quotientPullbackL2 Y F‖ = ‖F‖ :=
  (quotientPullbackL2 Y).norm_map F

/-- Pullback preserves the exact `L²` inner product. -/
theorem quotientPullbackL2_inner (Y : ℝ)
    (F G : TruncatedQuotientPeterssonL2 Y) :
    inner ℂ (quotientPullbackL2 Y F) (quotientPullbackL2 Y G) =
      inner ℂ F G :=
  (quotientPullbackL2 Y).inner_map_map F G

/-- The quotient `L²` pullback is injective. -/
theorem quotientPullbackL2_injective (Y : ℝ) :
    Function.Injective (quotientPullbackL2 Y) :=
  (quotientPullbackL2 Y).injective

/-! ## Ordinary invariant scalar descent -/

/-- Literal invariance of an upstairs scalar-valued function. -/
def IsGamma2Invariant {E : Type*} (f : H → E) : Prop :=
  ∀ (gamma : Gamma2) (tau : H), f (gamma • tau) = f tau

/-- An invariant function descends through the literal orbit quotient. -/
def descendInvariant {E : Type*} (f : H → E)
    (hf : IsGamma2Invariant f) : Gamma2Quotient → E := by
  refine Quotient.lift f ?_
  intro tau sigma hOrbit
  change tau ∈ MulAction.orbit Gamma2 sigma at hOrbit
  rcases hOrbit with ⟨gamma, hgamma⟩
  rw [← hgamma]
  exact hf gamma sigma

/-- Pulling an invariant descent back along the quotient map returns the
original function pointwise. -/
@[simp] theorem descendInvariant_quotientMap {E : Type*}
    (f : H → E) (hf : IsGamma2Invariant f) (tau : H) :
    descendInvariant f hf (quotientMap tau) = f tau := by
  rfl

/-- A measurable invariant function has a measurable quotient descent. -/
theorem descendInvariant_measurable {E : Type*} [MeasurableSpace E]
    (f : H → E) (hf : IsGamma2Invariant f) (hfm : Measurable f) :
    Measurable (descendInvariant f hf) := by
  rw [measurable_from_quotient]
  change Measurable f
  exact hfm

/-- For a measurable invariant complex function, quotient `L^p` membership is
equivalent to upstairs `L^p` membership for the chosen pushforward measure. -/
theorem descendInvariant_memLp_iff (Y : ℝ) {p : ℝ≥0∞}
    (f : H → ℂ) (hf : IsGamma2Invariant f) (hfm : Measurable f) :
    MemLp (descendInvariant f hf) p (truncatedQuotientMeasure Y) ↔
      MemLp f p (truncatedHyperbolicMeasure Y) := by
  have hDescStrong :
      AEStronglyMeasurable (descendInvariant f hf)
        (Measure.map quotientMap (truncatedHyperbolicMeasure Y)) :=
    (descendInvariant_measurable f hf hfm).aestronglyMeasurable
  have hMap :
      MemLp (descendInvariant f hf) p
          (Measure.map quotientMap (truncatedHyperbolicMeasure Y)) ↔
        MemLp ((descendInvariant f hf) ∘ quotientMap) p
          (truncatedHyperbolicMeasure Y) :=
    memLp_map_measure_iff hDescStrong quotientMap_measurable.aemeasurable
  simpa only [truncatedQuotientMeasure, Function.comp_def,
    descendInvariant_quotientMap] using hMap

/-! ## Eta trivialization and a genuine quotient scalar `L²` class -/

/-- Multiplication by eta converts an eta-covariant scalar lift into an
ordinary invariant scalar. -/
noncomputable def etaTrivializedScalar (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (tau : H) : ℂ :=
  Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * (f : H → ℂ) tau

/-- The eta-trivialized scalar remains globally smooth. -/
theorem etaTrivializedScalar_contMDiff (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    ContMDiff 𝓘(ℂ) 𝓘(ℂ) ∞ (etaTrivializedScalar Y f) := by
  exact Mock2.Definition15Geometry.EtaHalfWeight.etaValue_contMDiff.mul
    f.property.1

/-- The eta-trivialized scalar is continuous. -/
theorem etaTrivializedScalar_continuous (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    Continuous (etaTrivializedScalar Y f) :=
  (etaTrivializedScalar_contMDiff Y f).continuous

/-- The exact eta quotient cancels the exact covariance factor, so the
trivialized scalar is genuinely `Gamma(2)`-invariant. -/
theorem etaTrivializedScalar_invariant (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    IsGamma2Invariant (etaTrivializedScalar Y f) := by
  intro gamma tau
  change
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue (gamma • tau) *
        (f : H → ℂ) (gamma • tau) =
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * (f : H → ℂ) tau
  rw [f.property.2.1 gamma tau, etaAutomorphyFactor_eq_etaRatio]
  rw [Mock2.Definition15Geometry.EtaHalfWeight.etaRatio]
  field_simp [Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero] <;>
    ring

/-- On a compact closed-ball truncation, multiplication by eta preserves
`L²`.  The bound is obtained from continuity of eta on the actual compact
ball, not supplied as a hypothesis. -/
theorem etaTrivializedScalar_memLp (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    MemLp (etaTrivializedScalar Y f) 2
      (truncatedHyperbolicMeasure Y) := by
  have hEtaContinuous : Continuous
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue :=
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue_contMDiff.continuous
  have hBounded :
      BddAbove
        ((fun tau : H =>
            ‖Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau‖) ''
          hyperbolicClosedBallTruncation Y) :=
    (hyperbolicClosedBallTruncation_isCompact Y).bddAbove_image
      hEtaContinuous.norm.continuousOn
  rcases hBounded with ⟨C, hC⟩
  refine MemLp.of_le_mul (c := C) f.property.2.2
    (etaTrivializedScalar_continuous Y f).aestronglyMeasurable ?_
  exact
    (ae_restrict_mem
      (hyperbolicClosedBallTruncation_measurable Y)).mono
      (fun tau htau => by
        rw [etaTrivializedScalar, norm_mul]
        exact mul_le_mul_of_nonneg_right
          (hC ⟨tau, htau, rfl⟩)
            (norm_nonneg ((f : H → ℂ) tau)))

/-- The eta-trivialized scalar descended to an ordinary quotient function. -/
noncomputable def descendedEtaTrivializedScalar (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) : Gamma2Quotient → ℂ :=
  descendInvariant (etaTrivializedScalar Y f)
    (etaTrivializedScalar_invariant Y f)

/-- Exact pullback formula for the descended eta trivialization. -/
@[simp] theorem descendedEtaTrivializedScalar_quotientMap (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (tau : H) :
    descendedEtaTrivializedScalar Y f (quotientMap tau) =
      etaTrivializedScalar Y f tau := by
  rfl

/-- The descended eta trivialization is measurable. -/
theorem descendedEtaTrivializedScalar_measurable (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    Measurable (descendedEtaTrivializedScalar Y f) := by
  exact descendInvariant_measurable
    (etaTrivializedScalar Y f)
    (etaTrivializedScalar_invariant Y f)
    (etaTrivializedScalar_continuous Y f).measurable

/-- The descended eta trivialization is an actual member of quotient `L²`. -/
theorem descendedEtaTrivializedScalar_memLp (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    MemLp (descendedEtaTrivializedScalar Y f) 2
      (truncatedQuotientMeasure Y) := by
  exact
    (descendInvariant_memLp_iff Y
      (etaTrivializedScalar Y f)
      (etaTrivializedScalar_invariant Y f)
      (etaTrivializedScalar_continuous Y f).measurable).2
      (etaTrivializedScalar_memLp Y f)

/-- The actual quotient `L²` class of the eta-trivialized core section. -/
noncomputable def etaTrivializedQuotientL2 (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    TruncatedQuotientPeterssonL2 Y :=
  (descendedEtaTrivializedScalar_memLp Y f).toLp
    (descendedEtaTrivializedScalar Y f)

/-- Pulling the quotient `L²` class upstairs recovers the eta-trivialized
scalar almost everywhere. -/
theorem quotientPullback_etaTrivializedQuotientL2_ae (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    ((quotientPullbackL2 Y (etaTrivializedQuotientL2 Y f) :
        TruncatedPeterssonL2 Y) : H → ℂ) =ᵐ[
          truncatedHyperbolicMeasure Y]
      etaTrivializedScalar Y f := by
  have hPull := quotientPullbackL2_coeFn_ae Y
    (etaTrivializedQuotientL2 Y f)
  have hToLpDown :
      ((etaTrivializedQuotientL2 Y f :
          TruncatedQuotientPeterssonL2 Y) :
        Gamma2Quotient → ℂ) =ᵐ[truncatedQuotientMeasure Y]
          descendedEtaTrivializedScalar Y f :=
    (descendedEtaTrivializedScalar_memLp Y f).coeFn_toLp
  have hToLpUp :
      (((etaTrivializedQuotientL2 Y f :
          TruncatedQuotientPeterssonL2 Y) :
          Gamma2Quotient → ℂ) ∘ quotientMap) =ᵐ[
            truncatedHyperbolicMeasure Y]
        (descendedEtaTrivializedScalar Y f ∘ quotientMap) :=
    (quotientMap_measurePreserving Y).quasiMeasurePreserving.ae_eq hToLpDown
  filter_upwards [hPull, hToLpUp] with tau hPullTau hToLpTau
  calc
    (quotientPullbackL2 Y (etaTrivializedQuotientL2 Y f) :
        TruncatedPeterssonL2 Y) tau =
        etaTrivializedQuotientL2 Y f (quotientMap tau) := hPullTau
    _ = descendedEtaTrivializedScalar Y f (quotientMap tau) := hToLpTau
    _ = etaTrivializedScalar Y f tau :=
      descendedEtaTrivializedScalar_quotientMap Y f tau

/-- For the inverse-eta core element, eta trivialization is pointwise the
constant scalar `1`. -/
@[simp] theorem etaTrivializedScalar_inverseEta (Y : ℝ) (tau : H) :
    etaTrivializedScalar Y (inverseEtaCoreElement Y) tau = 1 := by
  simp [etaTrivializedScalar, inverseEtaCoreElement_apply,
    inverseEtaSection,
    Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero]

/-- Accordingly, the ordinary quotient scalar associated to inverse eta in
the eta frame is exactly the constant function `1`. -/
@[simp] theorem descendedEtaTrivializedScalar_inverseEta (Y : ℝ)
    (x : Gamma2Quotient) :
    descendedEtaTrivializedScalar Y (inverseEtaCoreElement Y) x = 1 := by
  obtain ⟨tau, rfl⟩ := quotientMap_surjective x
  rw [descendedEtaTrivializedScalar_quotientMap]
  exact etaTrivializedScalar_inverseEta Y tau

/-! ## Descent to the actual associated eta line bundle -/

/-- Re-expose the measurable structure of the exact associated-orbit
quotient before stating measurable bundle-valued maps. -/
noncomputable local instance etaAutomorphicLineBundleTotalMeasurableSpace :
    MeasurableSpace EtaAutomorphicLineBundle.Total := by
  change MeasurableSpace
    (Quotient (Mock2.Definition15Geometry.lineOrbitRel etaMultiplier))
  infer_instance

/-- The inverse-eta bundle lift is measurable as a map to Mock2's actual
associated-orbit quotient total space. -/
theorem inverseEtaBundleLift_measurable :
    Measurable inverseEtaBundleLift := by
  change Measurable
    (fun tau : H =>
      (@Quotient.mk' (H × ℂ)
        (Mock2.Definition15Geometry.lineOrbitRel etaMultiplier)
        (tau, inverseEtaSection tau)))
  exact
    (@measurable_quotient_mk' (H × ℂ) _
      (Mock2.Definition15Geometry.lineOrbitRel etaMultiplier)).comp
      (measurable_id.prodMk inverseEtaSection_continuous.measurable)

/-- The deck-invariant inverse-eta bundle lift descends to a genuine section
of the associated quotient bundle. -/
noncomputable def descendedInverseEtaBundleSection :
    Gamma2Quotient → EtaAutomorphicLineBundle.Total := by
  refine Quotient.lift inverseEtaBundleLift ?_
  intro tau sigma hOrbit
  change tau ∈ MulAction.orbit Gamma2 sigma at hOrbit
  rcases hOrbit with ⟨gamma, hgamma⟩
  rw [← hgamma]
  exact inverseEtaBundleLift_invariant gamma sigma

/-- Exact pullback formula for the descended inverse-eta bundle section. -/
@[simp] theorem descendedInverseEtaBundleSection_quotientMap (tau : H) :
    descendedInverseEtaBundleSection (quotientMap tau) =
      inverseEtaBundleLift tau := by
  rfl

/-- The descended inverse-eta lift is an actual section of the bundle
projection. -/
theorem descendedInverseEtaBundleSection_projection
    (x : Gamma2Quotient) :
    EtaAutomorphicLineBundle.projection
        (descendedInverseEtaBundleSection x) = x := by
  refine Quotient.inductionOn x ?_
  intro tau
  exact inverseEtaBundleLift_projection tau

/-- The descended inverse-eta bundle section is measurable for the quotient
measurable structures on the base and total space. -/
theorem descendedInverseEtaBundleSection_measurable :
    Measurable descendedInverseEtaBundleSection := by
  rw [measurable_from_quotient]
  change Measurable inverseEtaBundleLift
  exact inverseEtaBundleLift_measurable

/-- Every smooth eta-automorphic core lift is measurable as a map into the
actual associated bundle total space. -/
theorem etaCoreBundleLift_measurable (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    Measurable (etaCoreBundleLift Y f) := by
  change Measurable
    (fun tau : H =>
      (@Quotient.mk' (H × ℂ)
        (Mock2.Definition15Geometry.lineOrbitRel etaMultiplier)
        (tau, (f : H → ℂ) tau)))
  exact
    (@measurable_quotient_mk' (H × ℂ) _
      (Mock2.Definition15Geometry.lineOrbitRel etaMultiplier)).comp
      (measurable_id.prodMk f.property.1.continuous.measurable)

/-- Every eta-covariant core element descends to an actual associated-bundle
section; it is not incorrectly coerced to an ordinary quotient scalar. -/
noncomputable def descendedEtaCoreBundleSection (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    Gamma2Quotient → EtaAutomorphicLineBundle.Total := by
  refine Quotient.lift (etaCoreBundleLift Y f) ?_
  intro tau sigma hOrbit
  change tau ∈ MulAction.orbit Gamma2 sigma at hOrbit
  rcases hOrbit with ⟨gamma, hgamma⟩
  rw [← hgamma]
  exact etaCoreBundleLift_invariant Y f gamma sigma

/-- Exact pullback formula for a descended eta-core bundle section. -/
@[simp] theorem descendedEtaCoreBundleSection_quotientMap (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (tau : H) :
    descendedEtaCoreBundleSection Y f (quotientMap tau) =
      etaCoreBundleLift Y f tau := by
  rfl

/-- The descended eta-core lift is an actual section of the bundle
projection. -/
theorem descendedEtaCoreBundleSection_projection (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) (x : Gamma2Quotient) :
    EtaAutomorphicLineBundle.projection
        (descendedEtaCoreBundleSection Y f x) = x := by
  refine Quotient.inductionOn x ?_
  intro tau
  exact etaCoreBundleLift_projection Y f tau

/-- Every descended eta-core bundle section is measurable. -/
theorem descendedEtaCoreBundleSection_measurable (Y : ℝ)
    (f : etaSmoothAutomorphicCore Y) :
    Measurable (descendedEtaCoreBundleSection Y f) := by
  rw [measurable_from_quotient]
  change Measurable (etaCoreBundleLift Y f)
  exact etaCoreBundleLift_measurable Y f

/-- The general bundle descent specializes exactly to the inverse-eta bundle
section. -/
theorem descendedEtaCoreBundleSection_inverseEta (Y : ℝ) :
    descendedEtaCoreBundleSection Y (inverseEtaCoreElement Y) =
      descendedInverseEtaBundleSection := by
  funext x
  refine Quotient.inductionOn x ?_
  intro tau
  rfl

/-! ## Unconditional summary theorem -/

/-- A single theorem collecting the concrete measurable quotient layer. -/
theorem concrete_truncated_eta_quotient_layer (Y : ℝ) :
    Function.Surjective quotientMap ∧
      truncatedQuotientMeasure Y Set.univ =
        truncatedHyperbolicMeasure Y Set.univ ∧
      truncatedQuotientMeasure Y Set.univ < (∞ : ℝ≥0∞) ∧
      Function.Injective (quotientPullbackL2 Y) ∧
      (∀ f : etaSmoothAutomorphicCore Y,
        MemLp (descendedEtaTrivializedScalar Y f) 2
          (truncatedQuotientMeasure Y)) ∧
      (∀ f : etaSmoothAutomorphicCore Y,
        ∀ x : Gamma2Quotient,
          EtaAutomorphicLineBundle.projection
              (descendedEtaCoreBundleSection Y f x) = x) := by
  exact
    ⟨quotientMap_surjective,
      truncatedQuotientMeasure_univ Y,
      truncatedQuotientMeasure_univ_lt_top Y,
      quotientPullbackL2_injective Y,
      descendedEtaTrivializedScalar_memLp Y,
      descendedEtaCoreBundleSection_projection Y⟩

end QYM.FullCertification.Mock2EtaQuotientMeasureExtension


open scoped MatrixGroups UpperHalfPlane

/-!
# Exact truncation and boundary-direction obstructions

This module turns two geometric defects in the printed analytic setup into kernel-checked
propositions, using the concrete `Gamma(2)` element already constructed in `Mock2.Definition11`.

* The height sublevel `{tau | Im tau <= 1/2}` is not stable under `Gamma(2)`.  Consequently it
  cannot be the inverse image of a subset of the orbit quotient.  Thus the expression
  `Gamma(2) \ {Im tau <= Y}` needs a chosen fundamental-domain/cusp truncation or an orbit-saturated
  replacement before it denotes a quotient truncation.
* On a horizontal boundary the first coordinate is tangential and the second coordinate is
  normal.  The printed `partial_x` boundary expression therefore cannot be used as the normal
  derivative without an additional convention changing the geometry.

The statements below do not assume a Sobolev trace theorem or Green's formula.
-/

namespace QYM.FullCertification.Mock2PaperGeometryNoGoExtension

abbrev H := Mock2.Definition11.H
abbrev Gamma2 := Mock2.Definition11.Gamma2
abbrev Gamma2Quotient := Mock2.Definition11.Gamma2Quotient

/-! ## The naive height truncation does not descend -/

/-- The literal upper-half-plane height sublevel used by the naive truncation notation. -/
def naiveHeightSublevel (Y : ℝ) : Set H :=
  {tau | tau.im <= Y}

/-- Stability of a set under every concrete `Gamma(2)` deck transformation. -/
def IsGamma2InvariantSet (s : Set H) : Prop :=
  ∀ (gamma : Gamma2) (tau : H), tau ∈ s → gamma • tau ∈ s

/-- A subset of the orbit quotient pulls back to a deck-invariant subset of the upper half-plane. -/
theorem invariant_of_isQuotientPreimage (s : Set H)
    (hs : ∃ S : Set Gamma2Quotient,
      ∀ tau : H, tau ∈ s ↔ Mock2.Definition11.quotientMk tau ∈ S) :
    IsGamma2InvariantSet s := by
  rcases hs with ⟨S, hS⟩
  intro gamma tau htau
  rw [hS]
  rw [Mock2.Definition11.quotientMk_smul]
  exact (hS tau).mp htau

/-- The concrete point obtained from `i` by the lower-unipotent witness. -/
def lowPoint : H :=
  Mock2.Definition11.gammaLowerInGamma2 • UpperHalfPlane.I

@[simp] theorem lowPoint_im : lowPoint.im = (1 / 5 : ℝ) := by
  exact Mock2.Definition11.gammaLowerInGamma2_smul_I_im

/-- The concrete witness lies in the height-`1/2` sublevel. -/
theorem lowPoint_mem_halfSublevel :
    lowPoint ∈ naiveHeightSublevel (1 / 2 : ℝ) := by
  change lowPoint.im <= (1 / 2 : ℝ)
  rw [lowPoint_im]
  norm_num

/-- Acting by the inverse deck transformation sends the witness back to `i`. -/
@[simp] theorem gammaLower_inv_smul_lowPoint :
    (Mock2.Definition11.gammaLowerInGamma2)⁻¹ • lowPoint =
      UpperHalfPlane.I := by
  simpa only [lowPoint, inv_smul_smul]

/-- The literal height sublevel is not invariant under the actual deck group. -/
theorem naiveHeightSublevel_half_not_invariant :
    ¬ IsGamma2InvariantSet (naiveHeightSublevel (1 / 2 : ℝ)) := by
  intro hInvariant
  have hImage := hInvariant
    (Mock2.Definition11.gammaLowerInGamma2)⁻¹
    lowPoint
    lowPoint_mem_halfSublevel
  change
    ((Mock2.Definition11.gammaLowerInGamma2)⁻¹ • lowPoint).im <=
      (1 / 2 : ℝ) at hImage
  rw [gammaLower_inv_smul_lowPoint, UpperHalfPlane.I_im] at hImage
  norm_num at hImage

/-- Therefore the height-`1/2` sublevel cannot be the pullback of any subset of
`Gamma(2) \ H`. -/
theorem naiveHeightSublevel_half_not_quotientPreimage :
    ¬ (∃ S : Set Gamma2Quotient,
      ∀ tau : H,
        tau ∈ naiveHeightSublevel (1 / 2 : ℝ) ↔
          Mock2.Definition11.quotientMk tau ∈ S) := by
  intro hDescends
  exact naiveHeightSublevel_half_not_invariant
    (invariant_of_isQuotientPreimage
      (naiveHeightSublevel (1 / 2 : ℝ)) hDescends)

/-! ## Horizontal tangent and normal directions -/

/-- A coordinate gradient `(partial_x u, partial_y u)` along a horizontal boundary. -/
abbrev CoordinateGradient := ℝ × ℝ

/-- The derivative in the horizontal tangent direction. -/
def horizontalTangentialDerivative (gradient : CoordinateGradient) : ℝ :=
  gradient.1

/-- The derivative in the vertical normal direction. -/
def horizontalNormalDerivative (gradient : CoordinateGradient) : ℝ :=
  gradient.2

/-- The two boundary derivatives are different linear coordinate functionals. -/
theorem horizontal_tangential_ne_normal :
    horizontalTangentialDerivative ≠ horizontalNormalDerivative := by
  intro h
  have hw := congrFun h ((1 : ℝ), (0 : ℝ))
  norm_num [horizontalTangentialDerivative, horizontalNormalDerivative] at hw

/-- Explicitly, the printed `partial_x` direction can be nonzero while the true horizontal
normal derivative is zero. -/
theorem printed_partial_x_not_horizontal_normal_witness :
    horizontalTangentialDerivative ((1 : ℝ), (0 : ℝ)) = 1 ∧
      horizontalNormalDerivative ((1 : ℝ), (0 : ℝ)) = 0 := by
  norm_num [horizontalTangentialDerivative, horizontalNormalDerivative]

/-! ## A type-corrected first-order differential interface -/

/-- A type-corrected interface for a first-order differential whose derivative and interaction
both land in a two-tensor/two-form target.  The projection is deliberately a target projection;
using a one-form Coulomb projection here would be ill-typed. -/
structure CorrectedFirstOrderData
    (Source Target : Type*)
    [AddCommGroup Source] [Module ℂ Source]
    [AddCommGroup Target] [Module ℂ Target] where
  derivative : Source →ₗ[ℂ] Target
  interaction : Source →ₗ[ℂ] Target
  targetProjection : Target →ₗ[ℂ] Target

/-- The type-corrected differential: project only after both summands have entered the common
target type. -/
def CorrectedFirstOrderData.delta
    {Source Target : Type*}
    [AddCommGroup Source] [Module ℂ Source]
    [AddCommGroup Target] [Module ℂ Target]
    (D : CorrectedFirstOrderData Source Target) : Source →ₗ[ℂ] Target :=
  D.targetProjection.comp (D.derivative + D.interaction)

@[simp] theorem CorrectedFirstOrderData.delta_apply
    {Source Target : Type*}
    [AddCommGroup Source] [Module ℂ Source]
    [AddCommGroup Target] [Module ℂ Target]
    (D : CorrectedFirstOrderData Source Target) (u : Source) :
    D.delta u = D.targetProjection (D.derivative u + D.interaction u) := by
  rfl

end QYM.FullCertification.Mock2PaperGeometryNoGoExtension


/-!
# The ground-shifted correction to the paper's gap inference

The lower bounds printed in Proposition 4.23 and Theorem A.7 have the wrong orientation at the
ground level.  Bounds

`h x ≥ alpha * M x + beta * ‖x‖²`, `M x ≥ c * ‖x‖²` on `Nᗮ`, and
`lambda0 ≥ beta`

only put an off-ground level above `alpha * c + beta`; they do not put the ground level below
`beta`.  Consequently they do not imply `lambdaOff - lambda0 ≥ alpha * c`.

The first section gives a two-dimensional diagonal countermodel in which the matched null-space
is already the complete, simple ground space.  Thus this obstruction is independent of ground
multiplicity.

The positive results use the corrected hypothesis

`delta * ‖x‖² ≤ re ⟪x, H x⟫ - lambda0 * ‖x‖²`

on the orthogonal complement of the *entire* `lambda0` eigenspace.  They prove the gap estimate
for every distinct point eigenvalue, first for an actual bounded operator and then for Mathlib's
genuine `LinearPMap`.  No eigenvalue enumeration and no simplicity assumption occurs.
-/

open Module End Set

namespace QYM.PaperGroundShiftedGapCorrectionExtension

/-! ## A finite-dimensional countermodel to the beta-baseline inference -/

namespace BetaBaselineCountermodel

/-- The explicit two-dimensional real carrier. -/
abbrev Vec2 := ℝ × ℝ

theorem model_finiteDimensional : FiniteDimensional ℝ Vec2 := by
  infer_instance

/-- The Euclidean norm-square used in the finite quadratic-form model. -/
def modelNormSq (x : Vec2) : ℝ :=
  x.1 ^ 2 + x.2 ^ 2

/-- The positive Euclidean pairing whose orthogonal complement is used below. -/
def modelPair (x y : Vec2) : ℝ :=
  x.1 * y.1 + x.2 * y.2

theorem modelNormSq_eq_selfPair (x : Vec2) :
    modelNormSq x = modelPair x x := by
  simp [modelNormSq, modelPair, pow_two]

theorem modelNormSq_eq_zero_iff (x : Vec2) :
    modelNormSq x = 0 ↔ x = 0 := by
  constructor
  · intro h
    simp only [modelNormSq] at h
    have hx1sq : x.1 ^ 2 = 0 := by
      nlinarith [sq_nonneg x.1, sq_nonneg x.2]
    have hx2sq : x.2 ^ 2 = 0 := by
      nlinarith [sq_nonneg x.1, sq_nonneg x.2]
    apply Prod.ext
    · exact sq_eq_zero_iff.mp hx1sq
    · exact sq_eq_zero_iff.mp hx2sq
  · intro h
    subst x
    simp [modelNormSq]

/-- The matched mass form.  It vanishes precisely in the first coordinate direction. -/
def modelMassForm (x : Vec2) : ℝ :=
  x.2 ^ 2

/-- The diagonal Hamiltonian form with levels `100` and `201 / 2`. -/
def modelHamiltonianForm (x : Vec2) : ℝ :=
  100 * x.1 ^ 2 + ((201 : ℝ) / 2) * x.2 ^ 2

/-- Membership in the matched null-space `span (1,0)`. -/
def InMatchedNullSpace (x : Vec2) : Prop :=
  x.2 = 0

/-- Membership in the Euclidean orthogonal complement `span (0,1)`. -/
def InMatchedOrthogonal (x : Vec2) : Prop :=
  x.1 = 0

/-- The coordinate predicate really is the full orthogonal complement of the matched null-space
for `modelPair`; it is not merely a selected excited vector. -/
theorem inMatchedOrthogonal_iff_pair_zero_on_matchedNull (x : Vec2) :
    InMatchedOrthogonal x ↔
      ∀ y : Vec2, InMatchedNullSpace y → modelPair y x = 0 := by
  constructor
  · intro hx y hy
    change x.1 = 0 at hx
    change y.2 = 0 at hy
    simp [modelPair, hx, hy]
  · intro h
    have htest := h (1, 0) (by simp [InMatchedNullSpace])
    simpa [InMatchedOrthogonal, modelPair] using htest

def modelAlpha : ℝ := 1
def modelC : ℝ := 1
def modelBeta : ℝ := 0
def modelGroundLevel : ℝ := 100
def modelOffGroundLevel : ℝ := (201 : ℝ) / 2

/-- The actual diagonal linear operator underlying the two displayed levels. -/
def modelHamiltonian : Vec2 →ₗ[ℝ] Vec2 where
  toFun x := (modelGroundLevel * x.1, modelOffGroundLevel * x.2)
  map_add' x y := by
    ext <;> simp [modelGroundLevel, modelOffGroundLevel] <;> ring
  map_smul' r x := by
    ext <;> simp [modelGroundLevel, modelOffGroundLevel] <;> ring

@[simp]
theorem modelHamiltonian_apply (x : Vec2) :
    modelHamiltonian x =
      (modelGroundLevel * x.1, modelOffGroundLevel * x.2) :=
  rfl

/-- The displayed Hamiltonian form is exactly the quadratic form of the diagonal operator for the
Euclidean pairing. -/
theorem modelHamiltonianForm_eq_pair_apply (x : Vec2) :
    modelHamiltonianForm x = modelPair x (modelHamiltonian x) := by
  simp [modelHamiltonianForm, modelPair, modelHamiltonian,
    modelGroundLevel, modelOffGroundLevel, pow_two]
  ring

def modelGroundVector : Vec2 := (1, 0)
def modelOffGroundVector : Vec2 := (0, 1)

theorem modelGroundVector_ne_zero : modelGroundVector ≠ 0 := by
  norm_num [modelGroundVector]

theorem modelOffGroundVector_ne_zero : modelOffGroundVector ≠ 0 := by
  norm_num [modelOffGroundVector]

/-- Every vector in the matched null-space has the exact ground eigenvalue. -/
theorem modelHamiltonian_eq_ground_smul_of_memMatchedNull
    {x : Vec2} (hx : InMatchedNullSpace x) :
    modelHamiltonian x = modelGroundLevel • x := by
  change x.2 = 0 at hx
  ext <;>
    simp [modelHamiltonian, modelGroundLevel, modelOffGroundLevel,
      InMatchedNullSpace, hx]

/-- Conversely, the matched null-space is the complete ground eigenspace of the diagonal model. -/
theorem inMatchedNull_iff_ground_eigen_equation (x : Vec2) :
    InMatchedNullSpace x ↔
      modelHamiltonian x = modelGroundLevel • x := by
  constructor
  · exact modelHamiltonian_eq_ground_smul_of_memMatchedNull
  · intro hx
    have hsnd := congrArg Prod.snd hx
    simp [modelHamiltonian, modelGroundLevel, modelOffGroundLevel] at hsnd
    norm_num at hsnd
    change x.2 = 0
    exact hsnd

/-- Every vector in the coordinate complement has the exact off-ground eigenvalue. -/
theorem modelHamiltonian_eq_offGround_smul_of_memMatchedOrthogonal
    {x : Vec2} (hx : InMatchedOrthogonal x) :
    modelHamiltonian x = modelOffGroundLevel • x := by
  change x.1 = 0 at hx
  ext <;>
    simp [modelHamiltonian, modelGroundLevel, modelOffGroundLevel,
      InMatchedOrthogonal, hx]

theorem modelGroundVector_eigenpair :
    modelGroundVector ≠ 0 ∧
      modelHamiltonian modelGroundVector =
        modelGroundLevel • modelGroundVector := by
  exact ⟨modelGroundVector_ne_zero,
    modelHamiltonian_eq_ground_smul_of_memMatchedNull
      (by simp [modelGroundVector, InMatchedNullSpace])⟩

theorem modelOffGroundVector_eigenpair :
    modelOffGroundVector ≠ 0 ∧
      modelHamiltonian modelOffGroundVector =
        modelOffGroundLevel • modelOffGroundVector := by
  exact ⟨modelOffGroundVector_ne_zero,
    modelHamiltonian_eq_offGround_smul_of_memMatchedOrthogonal
      (by simp [modelOffGroundVector, InMatchedOrthogonal])⟩

theorem modelNormSq_nonnegative (x : Vec2) :
    0 ≤ modelNormSq x := by
  simp only [modelNormSq]
  positivity

/-- The paper's global form domination holds with `alpha = 1` and `beta = 0`. -/
theorem model_form_domination (x : Vec2) :
    modelAlpha * modelMassForm x + modelBeta * modelNormSq x ≤
      modelHamiltonianForm x := by
  simp only [modelAlpha, modelMassForm, modelBeta, modelNormSq,
    modelHamiltonianForm]
  nlinarith [sq_nonneg x.1, sq_nonneg x.2]

/-- The mass form has coercivity constant one on the matched complement. -/
theorem model_mass_coercive_on_matchedOrthogonal
    {x : Vec2} (hx : InMatchedOrthogonal x) :
    modelC * modelNormSq x ≤ modelMassForm x := by
  change x.1 = 0 at hx
  simp [modelC, modelNormSq, modelMassForm, hx]

/-- The only ground information used by the paper, `beta ≤ lambda0`, also holds. -/
theorem model_beta_le_ground :
    modelBeta ≤ modelGroundLevel := by
  norm_num [modelBeta, modelGroundLevel]

theorem model_alpha_positive : 0 < modelAlpha := by
  norm_num [modelAlpha]

theorem model_c_positive : 0 < modelC := by
  norm_num [modelC]

/-- Nevertheless the claimed `alpha * c` lower bound for the spectral gap fails: the true gap is
`1 / 2`, whereas `alpha * c = 1`. -/
theorem model_claimed_gap_bound_fails :
    ¬ modelAlpha * modelC ≤ modelOffGroundLevel - modelGroundLevel := by
  norm_num [modelAlpha, modelC, modelOffGroundLevel, modelGroundLevel]

/-- The complete concrete package: all three printed lower-bound premises hold, with positive
`alpha` and `c`, but their advertised gap conclusion does not. -/
theorem beta_baseline_countermodel :
    (∀ x : Vec2,
      modelAlpha * modelMassForm x + modelBeta * modelNormSq x ≤
        modelHamiltonianForm x) ∧
    (∀ x : Vec2, InMatchedOrthogonal x →
      modelC * modelNormSq x ≤ modelMassForm x) ∧
    modelBeta ≤ modelGroundLevel ∧
    0 < modelAlpha ∧
    0 < modelC ∧
    ¬ modelAlpha * modelC ≤ modelOffGroundLevel - modelGroundLevel := by
  exact ⟨model_form_domination,
    fun _ hx => model_mass_coercive_on_matchedOrthogonal hx,
    model_beta_le_ground, model_alpha_positive, model_c_positive,
    model_claimed_gap_bound_fails⟩

/-- The invalid implication isolated as a proposition on the fixed concrete model. -/
def PrintedBetaGapInference : Prop :=
  (∀ x : Vec2,
      modelAlpha * modelMassForm x + modelBeta * modelNormSq x ≤
        modelHamiltonianForm x) →
  (∀ x : Vec2, InMatchedOrthogonal x →
      modelC * modelNormSq x ≤ modelMassForm x) →
  modelBeta ≤ modelGroundLevel →
  0 < modelAlpha →
  0 < modelC →
  modelAlpha * modelC ≤ modelOffGroundLevel - modelGroundLevel

/-- Proposition 4.23's beta-baseline inference is refuted even in this simple two-level model. -/
theorem printedBetaGapInference_refuted :
    ¬ PrintedBetaGapInference := by
  intro h
  have hclaimed := h model_form_domination
    (fun _ hx => model_mass_coercive_on_matchedOrthogonal hx)
    model_beta_le_ground model_alpha_positive model_c_positive
  exact model_claimed_gap_bound_fails hclaimed

end BetaBaselineCountermodel

/-! ## Corrected theorem for actual bounded operators -/

section BoundedOperator

variable {𝕜 E : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

/-- The complete eigenspace at the proposed ground level.  No basis vector is selected. -/
abbrev fullGroundEigenspace
    (T : E →L[𝕜] E) (lambda0 : ℝ) : Submodule 𝕜 E :=
  eigenspace (T : Module.End 𝕜 E) (lambda0 : 𝕜)

/-- The literal ground-shifted quadratic form
`re ⟪x, T x⟫ - lambda0 * ‖x‖²`. -/
def groundShiftedQuadraticForm
    (T : E →L[𝕜] E) (lambda0 : ℝ) (x : E) : ℝ :=
  RCLike.re ⟪x, T x⟫ - lambda0 * ‖x‖ ^ 2

/-- Coercivity of `T - lambda0` on the orthogonal complement of the entire ground eigenspace. -/
def HasGroundShiftedComplementCoercivity
    (T : E →L[𝕜] E) (lambda0 delta : ℝ) : Prop :=
  ∀ x : E, x ∈ (fullGroundEigenspace T lambda0)ᗮ →
    delta * ‖x‖ ^ 2 ≤ groundShiftedQuadraticForm T lambda0 x

/-- An eigenvector at a distinct level is orthogonal to the complete `lambda0` eigenspace. -/
theorem eigenvector_mem_fullGroundEigenspace_orthogonal
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {lambda0 mu : ℝ} {x : E}
    (hx : HasEigenvector (T : Module.End 𝕜 E) (mu : 𝕜) x)
    (hmu : mu ≠ lambda0) :
    x ∈ (fullGroundEigenspace T lambda0)ᗮ := by
  have hmuK : (mu : 𝕜) ≠ (lambda0 : 𝕜) := by
    exact_mod_cast hmu
  rw [Submodule.mem_orthogonal]
  intro y hy
  exact hsymm.orthogonalFamily_eigenspaces.pairwise
    hmuK hx.1 y hy

/-- Ground-shifted complement coercivity bounds the difference from every distinct real point
eigenvalue.  It is insensitive to the dimension of the ground eigenspace. -/
theorem real_eigenvalue_gap_ge_of_groundShiftedComplementCoercivity
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {lambda0 delta mu : ℝ} {x : E}
    (hcoercive : HasGroundShiftedComplementCoercivity T lambda0 delta)
    (hmu : mu ≠ lambda0)
    (hx : HasEigenvector (T : Module.End 𝕜 E) (mu : 𝕜) x) :
    delta ≤ mu - lambda0 := by
  have hxorth : x ∈ (fullGroundEigenspace T lambda0)ᗮ :=
    eigenvector_mem_fullGroundEigenspace_orthogonal hsymm hx hmu
  have hbound := hcoercive x hxorth
  have hnorm : 0 < ‖x‖ ^ 2 := by
    exact sq_pos_of_pos (norm_pos_iff.mpr hx.2)
  have heigenform :
      RCLike.re ⟪x, T x⟫ = mu * ‖x‖ ^ 2 := by
    exact_mod_cast congr_arg RCLike.re
      (inner_product_apply_eigenvector hx.apply_eq_smul)
  simp only [groundShiftedQuadraticForm, heigenform] at hbound
  nlinarith

/-- Eigenvalue-level form of the corrected theorem.  The quantifier ranges over every off-ground
point eigenvalue, so repeated copies of `lambda0` in an enumeration are never mislabeled as the
first excitation. -/
theorem every_offGround_real_eigenvalue_gap_ge
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {lambda0 delta : ℝ}
    (hcoercive : HasGroundShiftedComplementCoercivity T lambda0 delta) :
    ∀ mu : ℝ,
      mu ≠ lambda0 →
      HasEigenvalue (T : Module.End 𝕜 E) (mu : 𝕜) →
      delta ≤ mu - lambda0 := by
  intro mu hmu heigen
  obtain ⟨x, hx⟩ := heigen.exists_hasEigenvector
  exact real_eigenvalue_gap_ge_of_groundShiftedComplementCoercivity
    hsymm hcoercive hmu hx

/-- With a positive shifted coercivity constant, every distinct point eigenvalue lies strictly
above the ground level. -/
theorem every_offGround_real_eigenvalue_strictly_above
    {T : E →L[𝕜] E}
    (hsymm : (T : Module.End 𝕜 E).IsSymmetric)
    {lambda0 delta : ℝ} (hdelta : 0 < delta)
    (hcoercive : HasGroundShiftedComplementCoercivity T lambda0 delta)
    {mu : ℝ} (hmu : mu ≠ lambda0)
    (heigen : HasEigenvalue (T : Module.End 𝕜 E) (mu : 𝕜)) :
    lambda0 < mu := by
  have hgap := every_offGround_real_eigenvalue_gap_ge
    hsymm hcoercive mu hmu heigen
  linarith

end BoundedOperator

/-! ## The same correction for a genuine unbounded `LinearPMap` -/

section PartialOperator

variable {H : Type*} [NormedAddCommGroup H]
variable [InnerProductSpace ℝ H] [CompleteSpace H]

abbrev PMapOperatorEigenspace (T : H →ₗ.[ℝ] H) (lambda : ℝ) :
    Submodule ℝ H :=
  QYM.UnboundedCompactSpectralMappingExtension.operatorEigenspace T lambda

abbrev HasPMapEigenvector (T : H →ₗ.[ℝ] H) (lambda : ℝ) (x : H) : Prop :=
  QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvector T lambda x

abbrev HasPMapEigenvalue (T : H →ₗ.[ℝ] H) (lambda : ℝ) : Prop :=
  QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue T lambda

/-- The ground-shifted quadratic form on the actual partial-operator domain. -/
def pmapGroundShiftedQuadraticForm
    (T : H →ₗ.[ℝ] H) (lambda0 : ℝ) (x : T.domain) : ℝ :=
  inner ℝ (x : H) (T x) - lambda0 * ‖(x : H)‖ ^ 2

/-- Ground-shifted coercivity on the complement of the complete genuine partial-operator
eigenspace. -/
def HasPMapGroundShiftedComplementCoercivity
    (T : H →ₗ.[ℝ] H) (lambda0 delta : ℝ) : Prop :=
  ∀ x : T.domain, (x : H) ∈ (PMapOperatorEigenspace T lambda0)ᗮ →
    delta * ‖(x : H)‖ ^ 2 ≤
      pmapGroundShiftedQuadraticForm T lambda0 x

/-- Distinct real eigenspaces of a symmetric `LinearPMap` are orthogonal.  Domain membership is
unpacked from the actual graph-based eigenspace. -/
theorem pmap_eigenvector_mem_fullGroundEigenspace_orthogonal
    {T : H →ₗ.[ℝ] H} (hsymm : T.IsFormalAdjoint T)
    {lambda0 mu : ℝ} {x : H}
    (hx : HasPMapEigenvector T mu x) (hmu : mu ≠ lambda0) :
    x ∈ (PMapOperatorEigenspace T lambda0)ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro y hy
  obtain ⟨hyDomain, hyEq⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.mem_operatorEigenspace_iff.mp hy
  obtain ⟨hxMem, _⟩ := hx
  obtain ⟨hxDomain, hxEq⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.mem_operatorEigenspace_iff.mp hxMem
  let yd : T.domain := ⟨y, hyDomain⟩
  let xd : T.domain := ⟨x, hxDomain⟩
  have hyApply : T yd = lambda0 • y := by
    exact hyEq
  have hxApply : T xd = mu • x := by
    exact hxEq
  have hs := hsymm yd xd
  rw [hyApply, hxApply, real_inner_smul_left, real_inner_smul_right] at hs
  have hmul : (lambda0 - mu) * inner ℝ y x = 0 := by
    calc
      (lambda0 - mu) * inner ℝ y x =
          lambda0 * inner ℝ y x - mu * inner ℝ y x := by ring
      _ = 0 := sub_eq_zero.mpr hs
  exact (mul_eq_zero.mp hmul).resolve_left
    (sub_ne_zero.mpr hmu.symm)

/-- The genuine `LinearPMap` version of the ground-shifted eigenvalue-gap theorem. -/
theorem pmap_real_eigenvalue_gap_ge_of_groundShiftedComplementCoercivity
    {T : H →ₗ.[ℝ] H} (hsymm : T.IsFormalAdjoint T)
    {lambda0 delta mu : ℝ} {x : H}
    (hcoercive : HasPMapGroundShiftedComplementCoercivity T lambda0 delta)
    (hmu : mu ≠ lambda0)
    (hx : HasPMapEigenvector T mu x) :
    delta ≤ mu - lambda0 := by
  obtain ⟨hxMem, hxne⟩ := hx
  obtain ⟨hxDomain, hxEq⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.mem_operatorEigenspace_iff.mp hxMem
  let xd : T.domain := ⟨x, hxDomain⟩
  have hxApply : T xd = mu • x := by
    exact hxEq
  have hxorth : x ∈ (PMapOperatorEigenspace T lambda0)ᗮ :=
    pmap_eigenvector_mem_fullGroundEigenspace_orthogonal
      hsymm ⟨hxMem, hxne⟩ hmu
  have hbound := hcoercive xd hxorth
  have hnorm : 0 < ‖x‖ ^ 2 :=
    sq_pos_of_pos (norm_pos_iff.mpr hxne)
  have heigenform :
      inner ℝ x (T xd) = mu * ‖x‖ ^ 2 := by
    rw [hxApply, real_inner_smul_right, real_inner_self_eq_norm_sq]
  simp only [pmapGroundShiftedQuadraticForm, heigenform] at hbound
  nlinarith

/-- Every distinct real point eigenvalue of a symmetric partial operator satisfies the corrected
gap bound. -/
theorem pmap_every_offGround_real_eigenvalue_gap_ge
    {T : H →ₗ.[ℝ] H} (hsymm : T.IsFormalAdjoint T)
    {lambda0 delta : ℝ}
    (hcoercive : HasPMapGroundShiftedComplementCoercivity T lambda0 delta) :
    ∀ mu : ℝ,
      mu ≠ lambda0 → HasPMapEigenvalue T mu → delta ≤ mu - lambda0 := by
  intro mu hmu heigen
  obtain ⟨x, hx⟩ :=
    QYM.UnboundedCompactSpectralMappingExtension.HasPMapEigenvalue.exists_hasPMapEigenvector heigen
  exact pmap_real_eigenvalue_gap_ge_of_groundShiftedComplementCoercivity
    hsymm hcoercive hmu hx

/-- Self-adjoint wrapper for the actual `LinearPMap` API. -/
theorem pmap_every_offGround_real_eigenvalue_gap_ge_of_selfAdjoint
    {T : H →ₗ.[ℝ] H} (hT : IsSelfAdjoint T)
    {lambda0 delta : ℝ}
    (hcoercive : HasPMapGroundShiftedComplementCoercivity T lambda0 delta) :
    ∀ mu : ℝ,
      mu ≠ lambda0 → HasPMapEigenvalue T mu → delta ≤ mu - lambda0 := by
  exact pmap_every_offGround_real_eigenvalue_gap_ge
    (QYM.UnboundedCompactSpectralMappingExtension.pmap_isFormalAdjoint_of_selfAdjoint hT)
    hcoercive

end PartialOperator

/-! ## Explicit ground-multiplicity regression -/

/-- In the existing `(0,0,1)` diagonal model, the adjacent multiplicity-counted ground gap is
zero. -/
theorem repeatedGround_adjacent_gap_zero :
    QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 1 -
      QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 0 = 0 :=
  QYM.SpectralFlowCore.GroundMultiplicityCounterexample.adjacent_ground_gap_zero

/-- The same model has a genuine unit gap to the first level outside the complete ground block. -/
theorem repeatedGround_first_offGround_gap_one :
    QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 2 -
      QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 0 = 1 :=
  QYM.SpectralFlowCore.GroundMultiplicityCounterexample.first_offGround_gap

/-- The two facts coexist: ground multiplicity kills `lambda1-lambda0` without killing the
first-off-ground separation. -/
theorem repeatedGround_multiplicity_safe_regression :
    QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 1 -
        QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 0 = 0 ∧
      QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 2 -
        QYM.SpectralFlowCore.GroundMultiplicityCounterexample.eigenvalue 0 = 1 :=
  ⟨repeatedGround_adjacent_gap_zero,
    repeatedGround_first_offGround_gap_one⟩

end QYM.PaperGroundShiftedGapCorrectionExtension


/-!
# P1.1 — A notation firewall between modular cusp coordinates and QYM sectors

The letter `q` has two incompatible uses in the informal source: the local
Fourier coordinate `exp (2 π i τ)` and a physical sector label.  This file
makes the distinction structural.

* `LocalCuspParameter` is a point of the open complex unit disk, tagged by a
  cusp of `Γ(2)`.
* `QSector` is physical input.  Its constructors explicitly say whether the
  input is a residue charge, a real coupling, or a unitary background
  holonomy.
* `Parameter` is a disjoint sum.  Its constructor-disjointness theorems are
  the machine-checkable notation firewall.

The three standard cusps of `Γ(2)` have width two.  We use actual
`SL(2, ℤ)` scaling matrices, so the inverse-scaled point remains in the upper
half-plane by type.  No analytic conclusion is stored in a data structure.
The strict unit-disk estimate is proved from Mathlib's `qParam` theorem.
-/


namespace QYM.FullCertification.P1NotationFirewall

open Matrix
open scoped MatrixGroups UpperHalfPlane

abbrev H := Mock2.Definition11.H
abbrev Gamma2 := Mock2.Definition11.Gamma2
abbrev Gamma2Quotient := Mock2.Definition11.Gamma2Quotient

/-! ## Physical sector data -/

/-- A concrete residue-class charge.  Positivity rules out the degenerate
`ZMod 0` convention from the physical sector API. -/
structure ResidueCharge where
  modulus : ℕ
  modulus_pos : 0 < modulus
  residue : ZMod modulus

/-- A unitary one-dimensional background holonomy. -/
abbrev UnitaryHolonomy := {z : ℂ // ‖z‖ = 1}

namespace UnitaryHolonomy

/-- The neutral background holonomy. -/
def one : UnitaryHolonomy :=
  ⟨1, norm_one⟩

@[simp] theorem coe_one : ((one : UnitaryHolonomy) : ℂ) = 1 :=
  rfl

@[simp] theorem norm_coe (u : UnitaryHolonomy) : ‖(u : ℂ)‖ = 1 :=
  u.2

theorem coe_ne_zero (u : UnitaryHolonomy) : (u : ℂ) ≠ 0 := by
  intro hu
  have hzero : ‖(u : ℂ)‖ = 0 := by simp [hu]
  linarith [u.2, hzero]

end UnitaryHolonomy

/--
The physical/gauge sector type.

The constructors are intentionally disjoint:

* `ofCharge` means a residue class modulo a positive modulus;
* `ofCoupling` means a real coupling constant;
* `ofBackgroundHolonomy` means a unitary background phase.

Thus a theorem cannot silently reinterpret a cusp coordinate as a sector.
-/
inductive QSector where
  | ofCharge (charge : ResidueCharge)
  | ofCoupling (strength : ℝ)
  | ofBackgroundHolonomy (phase : UnitaryHolonomy)

namespace QSector

/-- Friendly constructor for a positive-modulus residue charge. -/
def charge (modulus : ℕ) (hmodulus : 0 < modulus)
    (residue : ZMod modulus) : QSector :=
  .ofCharge ⟨modulus, hmodulus, residue⟩

/-- Friendly constructor for a real coupling sector. -/
def couplingSector (strength : ℝ) : QSector :=
  .ofCoupling strength

/-- Friendly constructor for a unitary holonomy sector. -/
def backgroundHolonomy (phase : UnitaryHolonomy) : QSector :=
  .ofBackgroundHolonomy phase

/-- Exact, tag-sensitive residue-charge accessor. -/
def charge? : QSector → Option ResidueCharge
  | .ofCharge charge => some charge
  | .ofCoupling _ => none
  | .ofBackgroundHolonomy _ => none

/-- Exact, tag-sensitive coupling accessor. -/
def coupling? : QSector → Option ℝ
  | .ofCharge _ => none
  | .ofCoupling strength => some strength
  | .ofBackgroundHolonomy _ => none

/-- Exact, tag-sensitive background-holonomy accessor. -/
def backgroundHolonomy? : QSector → Option UnitaryHolonomy
  | .ofCharge _ => none
  | .ofCoupling _ => none
  | .ofBackgroundHolonomy phase => some phase

/-- Total coupling used by the first safe potential family.  Non-coupling
sectors have the neutral value zero.  The exact tag is always recoverable by
`coupling?`; this total projection does not identify the constructors. -/
def coupling : QSector → ℝ
  | .ofCharge _ => 0
  | .ofCoupling strength => strength
  | .ofBackgroundHolonomy _ => 0

@[simp] theorem charge?_charge (modulus : ℕ) (hmodulus : 0 < modulus)
    (residue : ZMod modulus) :
    (charge modulus hmodulus residue).charge? =
      some ⟨modulus, hmodulus, residue⟩ :=
  rfl

@[simp] theorem charge?_ofCharge (charge : ResidueCharge) :
    (QSector.ofCharge charge).charge? = some charge :=
  rfl

@[simp] theorem charge?_ofCoupling (strength : ℝ) :
    (QSector.ofCoupling strength).charge? = none :=
  rfl

@[simp] theorem charge?_ofBackgroundHolonomy (phase : UnitaryHolonomy) :
    (QSector.ofBackgroundHolonomy phase).charge? = none :=
  rfl

@[simp] theorem coupling?_couplingSector (strength : ℝ) :
    (couplingSector strength).coupling? = some strength :=
  rfl

@[simp] theorem coupling?_ofCharge (charge : ResidueCharge) :
    (QSector.ofCharge charge).coupling? = none :=
  rfl

@[simp] theorem coupling?_ofBackgroundHolonomy (phase : UnitaryHolonomy) :
    (QSector.ofBackgroundHolonomy phase).coupling? = none :=
  rfl

@[simp] theorem backgroundHolonomy?_backgroundHolonomy
    (phase : UnitaryHolonomy) :
    (backgroundHolonomy phase).backgroundHolonomy? = some phase :=
  rfl

@[simp] theorem backgroundHolonomy?_ofCharge (charge : ResidueCharge) :
    (QSector.ofCharge charge).backgroundHolonomy? = none :=
  rfl

@[simp] theorem backgroundHolonomy?_ofCoupling (strength : ℝ) :
    (QSector.ofCoupling strength).backgroundHolonomy? = none :=
  rfl

@[simp] theorem coupling_ofCoupling (strength : ℝ) :
    coupling (.ofCoupling strength) = strength :=
  rfl

@[simp] theorem coupling_ofCharge (charge : ResidueCharge) :
    coupling (.ofCharge charge) = 0 :=
  rfl

@[simp] theorem coupling_ofBackgroundHolonomy (phase : UnitaryHolonomy) :
    coupling (.ofBackgroundHolonomy phase) = 0 :=
  rfl

theorem ofCharge_ne_ofCoupling (charge : ResidueCharge) (strength : ℝ) :
    QSector.ofCharge charge ≠ QSector.ofCoupling strength := by
  intro h
  cases h

theorem ofCharge_ne_ofBackgroundHolonomy
    (charge : ResidueCharge) (phase : UnitaryHolonomy) :
    QSector.ofCharge charge ≠ QSector.ofBackgroundHolonomy phase := by
  intro h
  cases h

theorem ofCoupling_ne_ofBackgroundHolonomy
    (strength : ℝ) (phase : UnitaryHolonomy) :
    QSector.ofCoupling strength ≠ QSector.ofBackgroundHolonomy phase := by
  intro h
  cases h

theorem ofCharge_injective : Function.Injective QSector.ofCharge := by
  intro a b h
  cases h
  rfl

theorem ofCoupling_injective : Function.Injective QSector.ofCoupling := by
  intro a b h
  cases h
  rfl

theorem ofBackgroundHolonomy_injective :
    Function.Injective QSector.ofBackgroundHolonomy := by
  intro a b h
  cases h
  rfl

end QSector

noncomputable instance instDecidableEqResidueCharge : DecidableEq ResidueCharge :=
  Classical.decEq _

noncomputable instance instDecidableEqQSector : DecidableEq QSector :=
  Classical.decEq _

/-! ## The three standard Γ(2) cusp charts -/

/-- Labels for the three standard cusp representatives of the principal
level-two modular curve.  Exhaustiveness of cusp orbits is deliberately not
smuggled into this finite datatype. -/
inductive CuspLabel where
  | infinityCusp
  | zeroCusp
  | oneCusp
  deriving DecidableEq, Repr

namespace CuspLabel

/-- An inverse scaling matrix for each standard cusp.  The matrices send,
respectively, `∞`, `0`, and `1` to the standard cusp at infinity. -/
def sigmaInvMatrix : CuspLabel → SL(2, ℤ)
  | .infinityCusp => 1
  | .zeroCusp =>
      ⟨!![0, -1; 1, 0], by
        norm_num [Matrix.det_fin_two_of]⟩
  | .oneCusp =>
      ⟨!![0, -1; 1, -1], by
        norm_num [Matrix.det_fin_two_of]⟩

/-- The actual inverse-scaled upper-half-plane point. -/
def sigmaInv (κ : CuspLabel) (τ : H) : H :=
  κ.sigmaInvMatrix • τ

/-- The selected positive natural translation width is two at each of the
three standard `Γ(2)` charts.  This is chart data; this file does not claim a
separate stabilizer-minimality theorem for that value. -/
def width (_κ : CuspLabel) : ℕ :=
  2

@[simp] theorem width_eq_two (κ : CuspLabel) : κ.width = 2 :=
  rfl

theorem width_pos (κ : CuspLabel) : 0 < κ.width := by
  simp [width]

theorem width_ne_zero (κ : CuspLabel) : κ.width ≠ 0 :=
  ne_of_gt κ.width_pos

end CuspLabel

/-- Pure geometric data for a cusp chart.  The only proposition field is the
positivity required of a width; no spectral or analytic theorem is smuggled
into this record. -/
structure CuspLocalData where
  label : CuspLabel
  sigmaInv : H → H
  width : ℕ
  width_pos : 0 < width

/-- The standard cusp datum attached to a label.  Its width is the explicit
chart period above, not an analytic or spectral hypothesis. -/
def standardCuspData (κ : CuspLabel) : CuspLocalData where
  label := κ
  sigmaInv := κ.sigmaInv
  width := κ.width
  width_pos := κ.width_pos

/-- The standard datum at the cusp at infinity. -/
def infinityCuspData : CuspLocalData :=
  standardCuspData .infinityCusp

/-- The standard datum at the cusp represented by zero. -/
def zeroCuspData : CuspLocalData :=
  standardCuspData .zeroCusp

/-- The standard datum at the cusp represented by one. -/
def oneCuspData : CuspLocalData :=
  standardCuspData .oneCusp

@[simp] theorem standardCuspData_label (κ : CuspLabel) :
    (standardCuspData κ).label = κ :=
  rfl

@[simp] theorem standardCuspData_width (κ : CuspLabel) :
    (standardCuspData κ).width = 2 :=
  rfl

@[simp] theorem standardCuspData_sigmaInv (κ : CuspLabel) (τ : H) :
    (standardCuspData κ).sigmaInv τ = κ.sigmaInv τ :=
  rfl

@[simp] theorem infinityCuspData_label :
    infinityCuspData.label = .infinityCusp :=
  rfl

@[simp] theorem zeroCuspData_label : zeroCuspData.label = .zeroCusp :=
  rfl

@[simp] theorem oneCuspData_label : oneCuspData.label = .oneCusp :=
  rfl

@[simp] theorem infinityCuspData_width : infinityCuspData.width = 2 :=
  rfl

@[simp] theorem zeroCuspData_width : zeroCuspData.width = 2 :=
  rfl

@[simp] theorem oneCuspData_width : oneCuspData.width = 2 :=
  rfl

/-! ## Cusp-local q parameters -/

/-- The local parameter
`q_κ(τ) = exp (2 π i σ_κ⁻¹ τ / w_κ)`.

For `Γ(2)`, `w_κ = 2` at all three standard cusps. -/
def localCuspParameter (κ : CuspLabel) (τ : H) : ℂ :=
  Function.Periodic.qParam (standardCuspData κ).width
    ((standardCuspData κ).sigmaInv τ : ℂ)

theorem localCuspParameter_formula (κ : CuspLabel) (τ : H) :
    localCuspParameter κ τ =
      Complex.exp
        (2 * Real.pi * Complex.I *
          ((standardCuspData κ).sigmaInv τ : ℂ) /
          (((standardCuspData κ).width : ℝ) : ℂ)) :=
  by
    simp [localCuspParameter, Function.Periodic.qParam]

theorem localCuspParameter_ne_zero (κ : CuspLabel) (τ : H) :
    localCuspParameter κ τ ≠ 0 := by
  simp [localCuspParameter, Function.Periodic.qParam]

theorem localCuspParameter_norm_pos (κ : CuspLabel) (τ : H) :
    0 < ‖localCuspParameter κ τ‖ :=
  norm_pos_iff.mpr (localCuspParameter_ne_zero κ τ)

/-- Every cusp-local coordinate lies strictly inside the unit disk. -/
theorem localCuspParameter_norm_lt_one (κ : CuspLabel) (τ : H) :
    ‖localCuspParameter κ τ‖ < 1 := by
  letI : NeZero (standardCuspData κ).width :=
    ⟨ne_of_gt (standardCuspData κ).width_pos⟩
  simpa [localCuspParameter] using
    UpperHalfPlane.norm_qParam_lt_one
      (standardCuspData κ).width ((standardCuspData κ).sigmaInv τ)

theorem localCuspParameter_norm_ne_one (κ : CuspLabel) (τ : H) :
    ‖localCuspParameter κ τ‖ ≠ 1 :=
  ne_of_lt (localCuspParameter_norm_lt_one κ τ)

/-- Hence `|q_κ| = 1` is not a geometric boundary contained in `ℍ`. -/
theorem no_upperHalfPlane_point_with_local_norm_one (κ : CuspLabel) :
    ¬ ∃ τ : H, ‖localCuspParameter κ τ‖ = 1 := by
  rintro ⟨τ, hτ⟩
  exact (localCuspParameter_norm_ne_one κ τ) hτ

/-- A cusp-tagged point of the open complex unit disk. -/
structure LocalCuspParameter where
  cusp : CuspLabel
  value : ℂ
  norm_pos : 0 < ‖value‖
  norm_lt_one : ‖value‖ < 1

/-- Package the concrete local parameter with its proved disk bounds. -/
def localCuspParameterPoint (κ : CuspLabel) (τ : H) :
    LocalCuspParameter where
  cusp := κ
  value := localCuspParameter κ τ
  norm_pos := localCuspParameter_norm_pos κ τ
  norm_lt_one := localCuspParameter_norm_lt_one κ τ

@[simp] theorem localCuspParameterPoint_cusp (κ : CuspLabel) (τ : H) :
    (localCuspParameterPoint κ τ).cusp = κ :=
  rfl

@[simp] theorem localCuspParameterPoint_value (κ : CuspLabel) (τ : H) :
    (localCuspParameterPoint κ τ).value = localCuspParameter κ τ :=
  rfl

theorem localCuspParameterPoint_not_on_unitCircle
    (p : LocalCuspParameter) : ‖p.value‖ ≠ 1 :=
  ne_of_lt p.norm_lt_one

/-! ## Type-level separation from physical sectors -/

/-- The only common container for the two parameter kinds is an explicitly
tagged disjoint sum. -/
inductive Parameter where
  | local (parameter : LocalCuspParameter)
  | sector (sector : QSector)

/-- Embed a cusp-local coordinate using the local tag. -/
def Parameter.ofLocal (κ : CuspLabel) (τ : H) : Parameter :=
  .local (localCuspParameterPoint κ τ)

/-- Embed physical input using the sector tag. -/
def Parameter.ofSector (sector : QSector) : Parameter :=
  .sector sector

/-- The constructor disjointness is the formal notation firewall. -/
theorem Parameter.local_ne_sector
    (parameter : LocalCuspParameter) (sector : QSector) :
    Parameter.local parameter ≠ Parameter.sector sector := by
  intro h
  cases h

theorem Parameter.ofLocal_ne_ofSector
    (κ : CuspLabel) (τ : H) (sector : QSector) :
    Parameter.ofLocal κ τ ≠ Parameter.ofSector sector :=
  Parameter.local_ne_sector _ _

theorem Parameter.sector_ne_local
    (sector : QSector) (parameter : LocalCuspParameter) :
    Parameter.sector sector ≠ Parameter.local parameter := by
  intro h
  cases h

/-! ## The global-coordinate no-go inherited from Mock2 Definition 11 -/

/-- The standard `exp (2πiτ)` also lies strictly inside the unit disk at every
upper-half-plane point. -/
theorem standardQ_norm_lt_one (τ : H) :
    ‖Mock2.Definition11.qParameter τ‖ < 1 := by
  simpa [Mock2.Definition11.qRadius] using
    Mock2.Definition11.qRadius_lt_one τ

theorem standardQ_norm_ne_one (τ : H) :
    ‖Mock2.Definition11.qParameter τ‖ ≠ 1 :=
  ne_of_lt (standardQ_norm_lt_one τ)

theorem no_upperHalfPlane_point_with_standardQ_norm_one :
    ¬ ∃ τ : H, ‖Mock2.Definition11.qParameter τ‖ = 1 := by
  rintro ⟨τ, hτ⟩
  exact (standardQ_norm_ne_one τ) hτ

/-- The standard q-radius is not invariant under the full `Γ(2)` action. -/
theorem standardQRadius_not_Gamma2_invariant :
    ¬ ∀ (g : Gamma2) (τ : H),
      Mock2.Definition11.qRadius (g • τ) =
        Mock2.Definition11.qRadius τ := by
  intro hinvariant
  exact Mock2.Definition11.qRadius_gammaLower_ne
    (hinvariant Mock2.Definition11.gammaLowerInGamma2 UpperHalfPlane.I)

/-- Exact reuse of Mock2's unconditional quotient-descent counterexample.
Consequently `exp (2πiτ)` cannot be used as a global coordinate on
`Γ(2) \ ℍ`. -/
theorem standardQRadius_does_not_descend_to_Gamma2Quotient :
    ¬ Mock2.Definition11.OriginalPiWellDefined :=
  Mock2.Definition11.originalPi_not_wellDefined

/-- A direct formulation of the forbidden global complex coordinate: the
standard upper-half-plane parameter itself would have to factor through the
literal orbit quotient. -/
def StandardQParameterWellDefined : Prop :=
  ∃ qBar : Mock2.Definition11.Gamma2Quotient → ℂ,
    ∀ tau : H,
      qBar (Mock2.Definition11.quotientMk tau) =
        Mock2.Definition11.qParameter tau

/-- The complex-valued standard parameter does not descend either.  If it
did, its norm would be invariant under every deck transformation, contrary to
the explicit lower-unipotent witness in Mock2. -/
theorem standardQParameter_does_not_descend_to_Gamma2Quotient :
    ¬ StandardQParameterWellDefined := by
  rintro ⟨qBar, hqBar⟩
  apply standardQRadius_not_Gamma2_invariant
  intro gamma tau
  have hParameter :
      Mock2.Definition11.qParameter (gamma • tau) =
        Mock2.Definition11.qParameter tau := by
    calc
      Mock2.Definition11.qParameter (gamma • tau) =
          qBar (Mock2.Definition11.quotientMk (gamma • tau)) :=
        (hqBar _).symm
      _ = qBar (Mock2.Definition11.quotientMk tau) :=
        congrArg qBar (Mock2.Definition11.quotientMk_smul gamma tau)
      _ = Mock2.Definition11.qParameter tau := hqBar tau
  change
    ‖Mock2.Definition11.qParameter (gamma • tau)‖ =
      ‖Mock2.Definition11.qParameter tau‖
  exact congrArg (fun z : ℂ => ‖z‖) hParameter

/-- A compact certificate collecting the P1.1 firewall results without
turning any analytic assertion into an input field. -/
structure Certificate : Prop where
  local_parameters_in_open_disk :
    ∀ (κ : CuspLabel) (τ : H), ‖localCuspParameter κ τ‖ < 1
  local_unit_circle_absent :
    ∀ κ : CuspLabel, ¬ ∃ τ : H, ‖localCuspParameter κ τ‖ = 1
  standard_unit_circle_absent :
    ¬ ∃ τ : H, ‖Mock2.Definition11.qParameter τ‖ = 1
  standard_radius_not_invariant :
    ¬ ∀ (g : Gamma2) (τ : H),
      Mock2.Definition11.qRadius (g • τ) =
        Mock2.Definition11.qRadius τ
  standard_radius_no_quotient_descent :
    ¬ Mock2.Definition11.OriginalPiWellDefined
  standard_parameter_no_quotient_descent :
    ¬ StandardQParameterWellDefined
  local_sector_tags_disjoint :
    ∀ (parameter : LocalCuspParameter) (sector : QSector),
      Parameter.local parameter ≠ Parameter.sector sector

/-- Unconditional inhabitant of the P1.1 certificate. -/
def certificate : Certificate where
  local_parameters_in_open_disk := localCuspParameter_norm_lt_one
  local_unit_circle_absent := no_upperHalfPlane_point_with_local_norm_one
  standard_unit_circle_absent := no_upperHalfPlane_point_with_standardQ_norm_one
  standard_radius_not_invariant := standardQRadius_not_Gamma2_invariant
  standard_radius_no_quotient_descent :=
    standardQRadius_does_not_descend_to_Gamma2Quotient
  standard_parameter_no_quotient_descent :=
    standardQParameter_does_not_descend_to_Gamma2Quotient
  local_sector_tags_disjoint := Parameter.local_ne_sector

end QYM.FullCertification.P1NotationFirewall


open Function Set MeasureTheory
open scoped ENNReal MatrixGroups UpperHalfPlane Manifold ContDiff

namespace QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension

open QYM.FullCertification.Mock2EtaPeterssonCarrierExtension
open QYM.FullCertification.Mock2EtaH1GraphCompletionExtension

/-!
# P1.2--P1.3: matter/gauge and boundary-condition firewalls

This file installs two type-level firewalls before any Hamiltonian is named.

* A half-weight matter field is an element of the concrete inverse-eta `H1`
  graph completion.
* The first gauge *cover carrier* is a complexified adjoint-valued real
  one-form coefficient in restricted `L2`.  Its two real-cotangent components
  are represented by a Hilbert `L2` fiber.  This alone is not yet a proof of
  Gamma(2)-descent to `Omega^1(X_Y; ad P)`: a later quotient-geometry producer
  must construct the deck-covariant subspace.  A Coulomb slice is the kernel
  of an explicitly supplied continuous divergence map, and the word
  `Coulomb` occurs only in the gauge API.
* The provisional coupled state is the Hilbert direct sum of those two
  different types.
  Typed interaction blocks cannot silently treat a matter section as a gauge
  one-form.

For the first finite-truncation endpoint, the cusp trace is an explicit
`ContinuousLinearMap`.  The Dirichlet domain is its kernel.  An interior
compactly-supported smooth core is supplied as a submodule by the geometric
producer, and its Dirichlet completion is *defined* to be its topological
closure.  Thus density follows from the definition; no trace theorem is
stored as a structure field or asserted without an input trace map.

Neumann, Robin, relative, and absolute boundary operators are separate typed
constructors.  A Robin coefficient is real by construction.  Lower
semiboundedness is a separate proposition to be proved for a concrete energy;
it is not hidden in boundary data.
-/

/-! ## Concrete, disjoint bundle and state types -/

/-- The upper half-plane used by the concrete inverse-eta construction. -/
abbrev H := Mock2.Definition15Geometry.H

/-- The actual total space of the half-integral inverse-eta associated bundle.
This is deliberately not the gauge one-form bundle below. -/
noncomputable abbrev HalfWeightMatterBundleTotal :=
  EtaAutomorphicLineBundle.Total

/-- The smooth matter core before graph completion. -/
abbrev SmoothHalfWeightMatterCore (Y : ℝ) := etaH1Core Y

/-- The completed half-weight matter state on the finite truncation. -/
abbrev MatterField (Y : ℝ) := EtaH1Completion Y

/-- A complexified abelian adjoint-valued one-form has two real-cotangent
components.  `WithLp 2` gives those components their Hilbert fiber norm. -/
abbrev ComplexifiedAdjointOneFormFiber := WithLp 2 (ℂ × ℂ)

/-- A transparent total-space presentation of the trivial complexified
adjoint one-form bundle over the upper half-plane.  The named fields make it
impossible to confuse this record with the associated half-weight bundle. -/
structure ComplexifiedAdjointOneFormBundleTotal where
  base : H
  fiber : ComplexifiedAdjointOneFormFiber

/-- The unconstrained `L2` gauge-fluctuation carrier on the upper-half-plane
cover.  It does not, by itself, certify deck covariance or quotient descent. -/
abbrev GaugeFluctuationCoverL2 (Y : ℝ) :=
  MeasureTheory.Lp ComplexifiedAdjointOneFormFiber 2
    (truncatedHyperbolicMeasure Y)

/-- Compatibility name for the cover carrier used by the typed firewall.
Every theorem in this file that uses it remains a cover-space theorem until a
separate deck-covariant submodule is supplied. -/
abbrev GaugeFluctuation (Y : ℝ) := GaugeFluctuationCoverL2 Y

/-- The scalar target in which a supplied gauge divergence is measured. -/
abbrev GaugeDivergenceTarget (Y : ℝ) := TruncatedPeterssonL2 Y

/-- Algebraic coherence required before a Gamma(2)-indexed family of linear
maps may be called a left deck-pullback representation.  This obligation is
separate from the family itself. -/
def IsGaugeDeckPullbackRepresentation (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y) : Prop :=
  (∀ a : GaugeFluctuation Y, deckPullback 1 a = a) ∧
    ∀ (gamma delta : Mock2.Definition15Geometry.Gamma2)
      (a : GaugeFluctuation Y),
      deckPullback (gamma * delta) a =
        deckPullback gamma (deckPullback delta a)

theorem IsGaugeDeckPullbackRepresentation.one
    {Y : ℝ}
    {deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y}
    (hDeck : IsGaugeDeckPullbackRepresentation Y deckPullback)
    (a : GaugeFluctuation Y) :
    deckPullback 1 a = a :=
  hDeck.1 a

theorem IsGaugeDeckPullbackRepresentation.mul
    {Y : ℝ}
    {deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y}
    (hDeck : IsGaugeDeckPullbackRepresentation Y deckPullback)
    (gamma delta : Mock2.Definition15Geometry.Gamma2)
    (a : GaugeFluctuation Y) :
    deckPullback (gamma * delta) a =
      deckPullback gamma (deckPullback delta a) :=
  hDeck.2 gamma delta a

/-- Given an explicitly constructed deck pullback on the cover carrier, this
is the submodule fixed by every Gamma(2) pullback.  The present file does not
invent that pullback from the restricted ball measure. -/
def GaugeDeckCovariantSubmodule (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y) :
    Submodule ℂ (GaugeFluctuation Y) where
  carrier a := ∀ gamma, deckPullback gamma a = a
  zero_mem' := by
    intro gamma
    exact (deckPullback gamma).map_zero
  add_mem' := by
    intro a b ha hb gamma
    rw [(deckPullback gamma).map_add, ha gamma, hb gamma]
  smul_mem' := by
    intro c a ha gamma
    rw [(deckPullback gamma).map_smul, ha gamma]

/-- Transparent name for the deck-covariant gauge carrier once the pullback
has actually been supplied. -/
abbrev DeckCovariantGaugeFluctuation (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y) :=
  GaugeDeckCovariantSubmodule Y deckPullback

theorem mem_gaugeDeckCovariantSubmodule_iff (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y)
    (a : GaugeFluctuation Y) :
    a ∈ GaugeDeckCovariantSubmodule Y deckPullback ↔
      ∀ gamma, deckPullback gamma a = a := by
  rfl

/-- A Coulomb gauge slice is used only for gauge fluctuations: it is the
kernel of a concrete continuous divergence operator supplied by the gauge
geometry layer. -/
abbrev CoulombGaugeSlice (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) :=
  divergence.ker

/-- The quotient-ready Coulomb slice: first restrict to the supplied
deck-covariant submodule, then take the kernel of a divergence defined on that
submodule.  Producing the concrete `deckPullback` remains an explicit geometric
obligation. -/
abbrev DeckCovariantCoulombGaugeSlice (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y)
    (divergence : DeckCovariantGaugeFluctuation Y deckPullback →L[ℂ]
      GaugeDivergenceTarget Y) :=
  divergence.ker

theorem mem_deckCovariantCoulombGaugeSlice_iff (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y)
    (divergence : DeckCovariantGaugeFluctuation Y deckPullback →L[ℂ]
      GaugeDivergenceTarget Y)
    (a : DeckCovariantGaugeFluctuation Y deckPullback) :
    a ∈ DeckCovariantCoulombGaugeSlice Y deckPullback divergence ↔
      divergence a = 0 := by
  rfl

theorem mem_coulombGaugeSlice_iff (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (a : GaugeFluctuation Y) :
    a ∈ CoulombGaugeSlice Y divergence ↔ divergence a = 0 := by
  rfl

/-- A closed Coulomb slice inherits completeness from the ambient gauge
`L2` space. -/
noncomputable def coulombGaugeSliceCompleteSpace (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) :
    CompleteSpace (CoulombGaugeSlice Y divergence) :=
  inferInstance

/-- The two field species used by the typed coupled theory. -/
inductive FieldKind where
  | matter
  | gaugeFluctuation
  deriving DecidableEq

/-- The first Hamiltonian endpoint is deliberately the half-weight matter
Hamiltonian.  A coupled or gauge Hamiltonian is a later, separately typed
endpoint. -/
def FirstEndpointFieldKind : FieldKind := .matter

@[simp] theorem firstEndpointFieldKind_eq_matter :
    FirstEndpointFieldKind = .matter := by
  rfl

/-- The carrier selected by a field tag.  This dependent family is the
compile-time firewall between a half-weight section and a gauge one-form. -/
def FieldCarrier (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) :
    FieldKind → Type
  | .matter => MatterField Y
  | .gaugeFluctuation => CoulombGaugeSlice Y divergence

/-- The simultaneous matter-plus-gauge Hilbert direct sum at the type-firewall
layer.  The gauge summand is still the explicitly documented cover carrier. -/
abbrev CoupledState (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) :=
  WithLp 2
    (FieldCarrier Y divergence .matter ×
      FieldCarrier Y divergence .gaugeFluctuation)

@[simp] theorem coupledState_matter_type (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (u : CoupledState Y divergence) :
    u.fst ∈ (⊤ : Submodule ℂ (MatterField Y)) := by
  change True
  trivial

@[simp] theorem coupledState_gauge_type (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (u : CoupledState Y divergence) :
    u.snd ∈ (⊤ : Submodule ℂ (CoulombGaugeSlice Y divergence)) := by
  change True
  trivial

/-! ## Typed interaction blocks -/

/-- Interaction data are four explicitly typed linear blocks.  In particular,
an off-diagonal matter-to-gauge term and a gauge-to-matter term have different
source and target types.  This structure contains no analytic theorem. -/
structure TypedInteraction (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) where
  matterToMatter : MatterField Y →ₗ[ℂ] MatterField Y
  matterToGauge :
    MatterField Y →ₗ[ℂ] CoulombGaugeSlice Y divergence
  gaugeToMatter :
    CoulombGaugeSlice Y divergence →ₗ[ℂ] MatterField Y
  gaugeToGauge :
    CoulombGaugeSlice Y divergence →ₗ[ℂ]
      CoulombGaugeSlice Y divergence

@[simp] theorem TypedInteraction.matterToGauge_zero (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (V : TypedInteraction Y divergence) :
    V.matterToGauge 0 = 0 := by
  exact V.matterToGauge.map_zero

@[simp] theorem TypedInteraction.gaugeToMatter_zero (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (V : TypedInteraction Y divergence) :
    V.gaugeToMatter 0 = 0 := by
  exact V.gaugeToMatter.map_zero

theorem TypedInteraction.matterToGauge_add (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (V : TypedInteraction Y divergence) (u v : MatterField Y) :
    V.matterToGauge (u + v) =
      V.matterToGauge u + V.matterToGauge v := by
  exact V.matterToGauge.map_add u v

theorem TypedInteraction.gaugeToMatter_smul (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (V : TypedInteraction Y divergence) (c : ℂ)
    (a : CoulombGaugeSlice Y divergence) :
    V.gaugeToMatter (c • a) = c • V.gaugeToMatter a := by
  exact V.gaugeToMatter.map_smul c a

/-- A matter Hamiltonian is typed only on the half-weight matter carrier.
There is no divergence or Coulomb-slice field in this data. -/
structure MatterHamiltonianOperator (Y : ℝ) where
  operator : MatterField Y →ₗ[ℂ] MatterField Y

/-- A gauge Hamiltonian is typed only on the explicitly supplied Coulomb
slice.  It cannot be applied to a half-weight matter section. -/
structure GaugeHamiltonianOperator (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) where
  operator :
    CoulombGaugeSlice Y divergence →ₗ[ℂ]
      CoulombGaugeSlice Y divergence

/-- Quotient-ready gauge Hamiltonian type.  Unlike the cover-level wrapper,
its carrier first satisfies the explicitly supplied Gamma(2) deck covariance. -/
structure DeckCovariantGaugeHamiltonianOperator (Y : ℝ)
    (deckPullback : Mock2.Definition15Geometry.Gamma2 →
      GaugeFluctuation Y →ₗ[ℂ] GaugeFluctuation Y)
    (divergence : DeckCovariantGaugeFluctuation Y deckPullback →L[ℂ]
      GaugeDivergenceTarget Y) where
  operator :
    DeckCovariantCoulombGaugeSlice Y deckPullback divergence →ₗ[ℂ]
      DeckCovariantCoulombGaugeSlice Y deckPullback divergence

@[simp] theorem MatterHamiltonianOperator.map_zero (Y : ℝ)
    (Hmatter : MatterHamiltonianOperator Y) :
    Hmatter.operator 0 = 0 := by
  exact Hmatter.operator.map_zero

@[simp] theorem GaugeHamiltonianOperator.map_zero (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
    (Hgauge : GaugeHamiltonianOperator Y divergence) :
    Hgauge.operator 0 = 0 := by
  exact Hgauge.operator.map_zero

/-! ## Paired sides and the actual Gamma(2) quotient equality -/

/-- Finite paired-side gluing data.  Each source side is identified with its
target side by an actual equivalence of point subtypes; it is not treated as a
physical boundary component. -/
structure PairedSideQuotientData (Point : Type*) where
  PairIndex : Type
  pairIndexFintype : Fintype PairIndex
  sourceSide : PairIndex → Set Point
  targetSide : PairIndex → Set Point
  identify : (i : PairIndex) →
    {x : Point // x ∈ sourceSide i} ≃
      {x : Point // x ∈ targetSide i}

/-- A finite-truncation boundary presentation separates quotient-paired sides
from the genuine cusp horocycle boundary and from the interior. -/
structure FiniteTruncationBoundaryPresentation (Point : Type*) where
  pairedSides : PairedSideQuotientData Point
  interior : Set Point
  cuspHorocycle : Set Point

/-- Validity of the set-theoretic boundary separation is a proposition to be
proved for a concrete polygon; it is not smuggled into the presentation data. -/
def FiniteTruncationBoundaryPresentation.BoundarySeparated
    {Point : Type*} (P : FiniteTruncationBoundaryPresentation Point) : Prop :=
  Disjoint P.interior P.cuspHorocycle

/-- The actual Mock2 quotient projection identifies every Gamma(2)-paired
point.  This is the equality that handles paired polygon sides. -/
@[simp] theorem gamma2_quotientMap_identifies_paired_sides
    (gamma : Mock2.Definition15Geometry.Gamma2) (tau : H) :
    Mock2.Definition15Geometry.quotientMap (gamma • tau) =
      Mock2.Definition15Geometry.quotientMap tau := by
  exact Mock2.Definition15Geometry.quotientMap_smul gamma tau

/-! ## Boundary kinds and endpoint labels -/

/-- Matter boundary conditions.  Robin data carry a real coefficient at the
constructor, so a complex boundary coefficient cannot be inserted silently. -/
inductive BoundaryKind where
  | dirichlet
  | neumann
  | robin (coefficient : ℝ)
  deriving DecidableEq

/-- Gauge-field boundary conditions, kept separate from scalar matter
boundary conditions. -/
inductive GaugeBoundaryKind where
  | relative
  | absolute
  deriving DecidableEq

/-- A boundary-labelled matter Hamiltonian name.  There is intentionally no
`Coulomb` field in this record. -/
structure MatterHamiltonianBoundaryLabel (Sector : Type*) where
  sector : Sector
  truncationHeight : ℝ
  boundary : BoundaryKind

/-- The first safe matter endpoint: finite truncation with Dirichlet cusp
boundary, written in ASCII as `HD sector Y`. -/
def HD {Sector : Type*} (sector : Sector) (Y : ℝ) :
    MatterHamiltonianBoundaryLabel Sector :=
  ⟨sector, Y, .dirichlet⟩

/-- A separately named Neumann endpoint. -/
def HN {Sector : Type*} (sector : Sector) (Y : ℝ) :
    MatterHamiltonianBoundaryLabel Sector :=
  ⟨sector, Y, .neumann⟩

/-- A separately named Robin endpoint with an explicitly real coefficient. -/
def HR {Sector : Type*} (sector : Sector) (Y rho : ℝ) :
    MatterHamiltonianBoundaryLabel Sector :=
  ⟨sector, Y, .robin rho⟩

@[simp] theorem HD_boundary {Sector : Type*} (sector : Sector) (Y : ℝ) :
    (HD sector Y).boundary = .dirichlet := by
  rfl

@[simp] theorem HN_boundary {Sector : Type*} (sector : Sector) (Y : ℝ) :
    (HN sector Y).boundary = .neumann := by
  rfl

@[simp] theorem HR_boundary {Sector : Type*} (sector : Sector)
    (Y rho : ℝ) :
    (HR sector Y rho).boundary = .robin rho := by
  rfl

/-- Gauge Hamiltonian labels use relative/absolute gauge boundary conditions
and are not interchangeable with matter labels. -/
structure GaugeHamiltonianBoundaryLabel (Sector : Type*) where
  sector : Sector
  truncationHeight : ℝ
  boundary : GaugeBoundaryKind

/-- The first gauge endpoint uses the relative boundary condition. -/
def HGRelative {Sector : Type*} (sector : Sector) (Y : ℝ) :
    GaugeHamiltonianBoundaryLabel Sector :=
  ⟨sector, Y, .relative⟩

/-- The absolute gauge endpoint is a separate extension. -/
def HGAbsolute {Sector : Type*} (sector : Sector) (Y : ℝ) :
    GaugeHamiltonianBoundaryLabel Sector :=
  ⟨sector, Y, .absolute⟩

@[simp] theorem HGRelative_boundary {Sector : Type*}
    (sector : Sector) (Y : ℝ) :
    (HGRelative sector Y).boundary = .relative := by
  rfl

@[simp] theorem HGAbsolute_boundary {Sector : Type*}
    (sector : Sector) (Y : ℝ) :
    (HGAbsolute sector Y).boundary = .absolute := by
  rfl

/-! ## Explicit continuous traces and boundary domains -/

section MatterBoundaryOperators

variable {E B : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]
variable [NormedAddCommGroup B] [NormedSpace ℂ B]

/-- The Dirichlet domain is exactly the kernel of the supplied continuous cusp
trace.  Existence or boundedness of a trace is never concluded here. -/
def DirichletDomain (cuspTrace : E →L[ℂ] B) : Submodule ℂ E :=
  cuspTrace.ker

theorem mem_dirichletDomain_iff (cuspTrace : E →L[ℂ] B) (u : E) :
    u ∈ DirichletDomain cuspTrace ↔ cuspTrace u = 0 := by
  rfl

/-- The trace-kernel Dirichlet domain is closed. -/
theorem dirichletDomain_isClosed (cuspTrace : E →L[ℂ] B) :
    IsClosed ((DirichletDomain cuspTrace : Submodule ℂ E) : Set E) := by
  exact cuspTrace.isClosed_ker

/-- The Neumann domain is the kernel of a separately supplied continuous
conormal trace. -/
def NeumannDomain (conormalTrace : E →L[ℂ] B) : Submodule ℂ E :=
  conormalTrace.ker

theorem mem_neumannDomain_iff (conormalTrace : E →L[ℂ] B) (u : E) :
    u ∈ NeumannDomain conormalTrace ↔ conormalTrace u = 0 := by
  rfl

/-- The conormal-trace Neumann domain is closed. -/
theorem neumannDomain_isClosed (conormalTrace : E →L[ℂ] B) :
    IsClosed ((NeumannDomain conormalTrace : Submodule ℂ E) : Set E) := by
  exact conormalTrace.isClosed_ker

/-- Robin boundary operator `normalTrace + rho * trace`, with `rho : R`. -/
def robinBoundaryOperator (cuspTrace conormalTrace : E →L[ℂ] B)
    (rho : ℝ) : E →L[ℂ] B :=
  conormalTrace + (rho : ℂ) • cuspTrace

@[simp] theorem robinBoundaryOperator_apply
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ) (u : E) :
    robinBoundaryOperator cuspTrace conormalTrace rho u =
      conormalTrace u + (rho : ℂ) • cuspTrace u := by
  rfl

/-- Robin domain, defined only from its explicitly constructed operator. -/
def RobinDomain (cuspTrace conormalTrace : E →L[ℂ] B)
    (rho : ℝ) : Submodule ℂ E :=
  (robinBoundaryOperator cuspTrace conormalTrace rho).ker

theorem mem_robinDomain_iff
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ) (u : E) :
    u ∈ RobinDomain cuspTrace conormalTrace rho ↔
      conormalTrace u + (rho : ℂ) • cuspTrace u = 0 := by
  rfl

/-- The explicitly constructed Robin domain is closed. -/
theorem robinDomain_isClosed
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ) :
    IsClosed ((RobinDomain cuspTrace conormalTrace rho :
      Submodule ℂ E) : Set E) := by
  exact (robinBoundaryOperator cuspTrace conormalTrace rho).isClosed_ker

/-- Uniform boundary-domain dispatcher.  The three cases remain visibly
different constructors. -/
def matterBoundaryDomain (cuspTrace conormalTrace : E →L[ℂ] B) :
    BoundaryKind → Submodule ℂ E
  | .dirichlet => DirichletDomain cuspTrace
  | .neumann => NeumannDomain conormalTrace
  | .robin rho => RobinDomain cuspTrace conormalTrace rho

@[simp] theorem matterBoundaryDomain_dirichlet
    (cuspTrace conormalTrace : E →L[ℂ] B) :
    matterBoundaryDomain cuspTrace conormalTrace .dirichlet =
      DirichletDomain cuspTrace := by
  rfl

@[simp] theorem matterBoundaryDomain_neumann
    (cuspTrace conormalTrace : E →L[ℂ] B) :
    matterBoundaryDomain cuspTrace conormalTrace .neumann =
      NeumannDomain conormalTrace := by
  rfl

@[simp] theorem matterBoundaryDomain_robin
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ) :
    matterBoundaryDomain cuspTrace conormalTrace (.robin rho) =
      RobinDomain cuspTrace conormalTrace rho := by
  rfl

end MatterBoundaryOperators

/-! ## Dirichlet core as an actual topological closure -/

section DirichletCoreClosure

variable {E B : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]
variable [NormedAddCommGroup B] [NormedSpace ℂ B]

/-- A geometric producer supplies a candidate submodule in the chosen Hilbert
ambient space.  The alias alone does not assert smoothness or support; the
separate predicate `IsInteriorCompactSmoothCore` below records exactly the
certification obligation. -/
abbrev InteriorCompactSmoothCore := Submodule ℂ E

/-- Explicit certification predicate for a supplied core.  The two geometric
predicates are arguments, not names masquerading as proofs.  A concrete
quotient/truncation module must instantiate `isSmooth` and
`hasCompactSupportInInterior` and prove this proposition. -/
def IsInteriorCompactSmoothCore
    (isSmooth hasCompactSupportInInterior : E → Prop)
    (interiorCore : InteriorCompactSmoothCore (E := E)) : Prop :=
  ∀ u : E, u ∈ interiorCore →
    isSmooth u ∧ hasCompactSupportInInterior u

theorem IsInteriorCompactSmoothCore.smooth
    {isSmooth hasCompactSupportInInterior : E → Prop}
    {interiorCore : InteriorCompactSmoothCore (E := E)}
    (hCore : IsInteriorCompactSmoothCore isSmooth
      hasCompactSupportInInterior interiorCore)
    {u : E} (hu : u ∈ interiorCore) :
    isSmooth u :=
  (hCore u hu).1

theorem IsInteriorCompactSmoothCore.compactSupportInInterior
    {isSmooth hasCompactSupportInInterior : E → Prop}
    {interiorCore : InteriorCompactSmoothCore (E := E)}
    (hCore : IsInteriorCompactSmoothCore isSmooth
      hasCompactSupportInInterior interiorCore)
    {u : E} (hu : u ∈ interiorCore) :
    hasCompactSupportInInterior u :=
  (hCore u hu).2

/-- The Dirichlet core completion is definitionally the topological closure of
the supplied core.  Calling it the geometric `C_c^infty` Dirichlet core also
requires an `IsInteriorCompactSmoothCore` proof from the supplier. -/
def DirichletCore
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    Submodule ℂ E :=
  interiorCore.topologicalClosure

theorem interiorCore_le_dirichletCore
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    interiorCore ≤ DirichletCore interiorCore := by
  exact Submodule.le_topologicalClosure interiorCore

theorem dirichletCore_isClosed
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    IsClosed ((DirichletCore interiorCore : Submodule ℂ E) : Set E) := by
  exact Submodule.isClosed_topologicalClosure interiorCore

/-- In a complete ambient space the closed core presentation is itself a
complete normed space, justifying the word completion at the analytic API
boundary. -/
noncomputable def dirichletCoreCompleteSpace
    [CompleteSpace E]
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    CompleteSpace (DirichletCore interiorCore) := by
  change CompleteSpace interiorCore.topologicalClosure
  infer_instance

/-- If the supplied interior core has zero cusp trace, its closure lies in the
Dirichlet trace kernel.  The trace and the core-to-kernel proof are explicit
arguments; this theorem does not manufacture a trace theorem. -/
theorem dirichletCore_le_traceKernel
    (cuspTrace : E →L[ℂ] B)
    (interiorCore : InteriorCompactSmoothCore (E := E))
    (hTraceZero : interiorCore ≤ DirichletDomain cuspTrace) :
    DirichletCore interiorCore ≤ DirichletDomain cuspTrace := by
  exact Submodule.topologicalClosure_minimal interiorCore hTraceZero
    cuspTrace.isClosed_ker

/-- The core image as a normed subspace before completion. -/
abbrev DirichletCoreImage
    (interiorCore : InteriorCompactSmoothCore (E := E)) :=
  interiorCore

/-- Canonical isometric inclusion of the supplied interior core into its
Dirichlet closure. -/
noncomputable def dirichletCoreImageInclusion
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    DirichletCoreImage interiorCore →ₗᵢ[ℂ] DirichletCore interiorCore where
  toFun u :=
    ⟨(u : E), interiorCore_le_dirichletCore interiorCore u.property⟩
  map_add' u v := by
    rfl
  map_smul' c u := by
    rfl
  norm_map' u := by
    rfl

@[simp] theorem dirichletCoreImageInclusion_coe
    (interiorCore : InteriorCompactSmoothCore (E := E))
    (u : DirichletCoreImage interiorCore) :
    ((dirichletCoreImageInclusion interiorCore u :
        DirichletCore interiorCore) : E) = u := by
  rfl

/-- Density is proved from the closure definition itself.  This theorem proves
topological density, not the supplier's geometric smooth/support predicates. -/
theorem dirichletCoreImageInclusion_denseRange
    (interiorCore : InteriorCompactSmoothCore (E := E)) :
    DenseRange (dirichletCoreImageInclusion interiorCore) := by
  change Dense
    (Set.range (fun u : DirichletCoreImage interiorCore =>
      dirichletCoreImageInclusion interiorCore u))
  refine (IsEmbedding.subtypeVal.isInducing.dense_iff).2 ?_
  intro x
  change
    (x : E) ∈
      closure
        (Subtype.val ''
          Set.range (fun u : DirichletCoreImage interiorCore =>
            dirichletCoreImageInclusion interiorCore u))
  have hImage :
      Subtype.val ''
          Set.range (fun u : DirichletCoreImage interiorCore =>
            dirichletCoreImageInclusion interiorCore u) =
        ((interiorCore : Submodule ℂ E) : Set E) := by
    ext z
    constructor
    · rintro ⟨_, ⟨u, rfl⟩, rfl⟩
      exact u.property
    · intro hz
      let u : DirichletCoreImage interiorCore := ⟨z, hz⟩
      exact ⟨dirichletCoreImageInclusion interiorCore u,
        ⟨u, rfl⟩, rfl⟩
  rw [hImage]
  exact x.property

/-- Under an explicit trace-zero proof, the dense core inclusion also lands in
the trace-kernel presentation of the Dirichlet domain. -/
noncomputable def dirichletCoreToDomain
    (cuspTrace : E →L[ℂ] B)
    (interiorCore : InteriorCompactSmoothCore (E := E))
    (hTraceZero : interiorCore ≤ DirichletDomain cuspTrace) :
    DirichletCore interiorCore →ₗ[ℂ] DirichletDomain cuspTrace where
  toFun u :=
    ⟨(u : E), dirichletCore_le_traceKernel cuspTrace interiorCore
      hTraceZero u.property⟩
  map_add' u v := by
    rfl
  map_smul' c u := by
    rfl

@[simp] theorem dirichletCoreToDomain_coe
    (cuspTrace : E →L[ℂ] B)
    (interiorCore : InteriorCompactSmoothCore (E := E))
    (hTraceZero : interiorCore ≤ DirichletDomain cuspTrace)
    (u : DirichletCore interiorCore) :
    ((dirichletCoreToDomain cuspTrace interiorCore hTraceZero u :
        DirichletDomain cuspTrace) : E) = u := by
  rfl

end DirichletCoreClosure

/-! ## Concrete matter specializations, still with explicit trace input -/

section ConcreteMatterBoundary

variable (Y : ℝ)
variable {BoundaryFiber : Type*}
variable [NormedAddCommGroup BoundaryFiber]
variable [NormedSpace ℂ BoundaryFiber]

/-- Matter Dirichlet domain on the actual inverse-eta graph completion.  No
Coulomb terminology occurs in this definition. -/
abbrev MatterDirichletDomain
    (cuspTrace : MatterField Y →L[ℂ] BoundaryFiber) :=
  DirichletDomain cuspTrace

/-- Matter Neumann domain on the same actual carrier. -/
abbrev MatterNeumannDomain
    (conormalTrace : MatterField Y →L[ℂ] BoundaryFiber) :=
  NeumannDomain conormalTrace

/-- Matter Robin domain with an explicitly real coefficient. -/
abbrev MatterRobinDomain
    (cuspTrace conormalTrace : MatterField Y →L[ℂ] BoundaryFiber)
    (rho : ℝ) :=
  RobinDomain cuspTrace conormalTrace rho

end ConcreteMatterBoundary

/-! ## Lower semiboundedness is a separate proof obligation -/

section LowerSemiboundedness

variable {E : Type*}
variable [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- A real energy is lower semibounded on a specified domain. -/
def IsLowerSemiboundedOn (domain : Submodule ℂ E)
    (energy : E → ℝ) : Prop :=
  ∃ lowerBound : ℝ, ∀ u : E, u ∈ domain →
    lowerBound * ‖u‖ ^ 2 ≤ energy u

theorem IsLowerSemiboundedOn.mono {domain₁ domain₂ : Submodule ℂ E}
    {energy : E → ℝ} (h : IsLowerSemiboundedOn domain₂ energy)
    (hDomain : domain₁ ≤ domain₂) :
    IsLowerSemiboundedOn domain₁ energy := by
  rcases h with ⟨lowerBound, hLower⟩
  exact ⟨lowerBound, fun u hu => hLower u (hDomain hu)⟩

/-- Every pointwise nonnegative energy is lower semibounded on every
submodule, with the explicit lower bound zero. -/
theorem isLowerSemiboundedOn_of_nonnegative
    (domain : Submodule ℂ E) (energy : E → ℝ)
    (hEnergy : ∀ u : E, 0 ≤ energy u) :
    IsLowerSemiboundedOn domain energy := by
  refine ⟨0, ?_⟩
  intro u _hu
  simpa only [zero_mul] using hEnergy u

variable {B : Type*}
variable [NormedAddCommGroup B] [NormedSpace ℂ B]

/-- The exact lower-semiboundedness obligation for a Robin endpoint.  It is a
predicate, not a field of `BoundaryKind` or of a background structure. -/
def RobinLowerSemiboundedRequirement
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ)
    (energy : E → ℝ) : Prop :=
  IsLowerSemiboundedOn
    (RobinDomain cuspTrace conormalTrace rho) energy

/-- A nonnegative energy discharges the Robin lower-semiboundedness
requirement without storing the conclusion in boundary data. -/
theorem robinLowerSemiboundedRequirement_of_nonnegative
    (cuspTrace conormalTrace : E →L[ℂ] B) (rho : ℝ)
    (energy : E → ℝ) (hEnergy : ∀ u : E, 0 ≤ energy u) :
    RobinLowerSemiboundedRequirement cuspTrace conormalTrace rho energy := by
  unfold RobinLowerSemiboundedRequirement
  exact isLowerSemiboundedOn_of_nonnegative
    (RobinDomain cuspTrace conormalTrace rho) energy hEnergy

end LowerSemiboundedness

/-! ## Gauge relative/absolute domains and compatibility -/

section GaugeBoundary

variable {G B P : Type*}
variable [NormedAddCommGroup G] [NormedSpace ℂ G]
variable [NormedAddCommGroup B] [NormedSpace ℂ B]
variable [NormedAddCommGroup P] [NormedSpace ℂ P]

/-- Relative and absolute traces are separate continuous maps. -/
structure GaugeBoundaryTraces where
  relativeTrace : G →L[ℂ] B
  absoluteTrace : G →L[ℂ] B

/-- Gauge-parameter traces are likewise separated by boundary kind. -/
structure GaugeParameterBoundaryTraces where
  relativeParameterTrace : P →L[ℂ] B
  absoluteParameterTrace : P →L[ℂ] B

/-- Relative or absolute gauge-field boundary domain. -/
def gaugeBoundaryDomain (traces : GaugeBoundaryTraces (G := G) (B := B)) :
    GaugeBoundaryKind → Submodule ℂ G
  | .relative => traces.relativeTrace.ker
  | .absolute => traces.absoluteTrace.ker

@[simp] theorem mem_gaugeBoundaryDomain_relative
    (traces : GaugeBoundaryTraces (G := G) (B := B)) (a : G) :
    a ∈ gaugeBoundaryDomain traces .relative ↔
      traces.relativeTrace a = 0 := by
  rfl

@[simp] theorem mem_gaugeBoundaryDomain_absolute
    (traces : GaugeBoundaryTraces (G := G) (B := B)) (a : G) :
    a ∈ gaugeBoundaryDomain traces .absolute ↔
      traces.absoluteTrace a = 0 := by
  rfl

/-- Compatibility says that a gauge transformation generated by a parameter
obeying the selected parameter boundary condition preserves the selected
field boundary condition.  All maps are explicit inputs.  This generic
predicate does not construct concrete traces, a gauge action, or a proof of
compatibility for the modular truncation. -/
def GaugeBoundaryCompatible
    (kind : GaugeBoundaryKind)
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (parameterTraces : GaugeParameterBoundaryTraces (P := P) (B := B))
    (gaugeAction : P →L[ℂ] G) : Prop :=
  match kind with
  | .relative =>
      ∀ epsilon : P,
        parameterTraces.relativeParameterTrace epsilon = 0 →
          fieldTraces.relativeTrace (gaugeAction epsilon) = 0
  | .absolute =>
      ∀ epsilon : P,
        parameterTraces.absoluteParameterTrace epsilon = 0 →
          fieldTraces.absoluteTrace (gaugeAction epsilon) = 0

/-- Canonical parameter traces obtained by pulling the field traces back
along the infinitesimal gauge action.  With this construction compatibility
is a theorem, rather than an additional certificate input. -/
def inducedGaugeParameterBoundaryTraces
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeParameterBoundaryTraces (P := P) (B := B) where
  relativeParameterTrace := fieldTraces.relativeTrace.comp gaugeAction
  absoluteParameterTrace := fieldTraces.absoluteTrace.comp gaugeAction

@[simp] theorem inducedGaugeParameterBoundaryTraces_relative_apply
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) (epsilon : P) :
    (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction).relativeParameterTrace epsilon =
      fieldTraces.relativeTrace (gaugeAction epsilon) :=
  rfl

@[simp] theorem inducedGaugeParameterBoundaryTraces_absolute_apply
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) (epsilon : P) :
    (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction).absoluteParameterTrace epsilon =
      fieldTraces.absoluteTrace (gaugeAction epsilon) :=
  rfl

/-- Relative compatibility for the canonical pulled-back parameter trace. -/
theorem inducedGaugeParameterBoundaryTraces_relative_compatible
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeBoundaryCompatible .relative fieldTraces
      (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction)
      gaugeAction := by
  intro epsilon hEpsilon
  simpa only [inducedGaugeParameterBoundaryTraces_relative_apply] using
    hEpsilon

/-- Absolute compatibility for the canonical pulled-back parameter trace. -/
theorem inducedGaugeParameterBoundaryTraces_absolute_compatible
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeBoundaryCompatible .absolute fieldTraces
      (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction)
      gaugeAction := by
  intro epsilon hEpsilon
  simpa only [inducedGaugeParameterBoundaryTraces_absolute_apply] using
    hEpsilon

/-- Both gauge boundary conventions have an unconditional compatible
parameter-trace construction for every supplied field trace and gauge action. -/
theorem canonicalGaugeBoundaryCompatibility
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeBoundaryCompatible .relative fieldTraces
        (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction)
        gaugeAction ∧
      GaugeBoundaryCompatible .absolute fieldTraces
        (inducedGaugeParameterBoundaryTraces fieldTraces gaugeAction)
        gaugeAction :=
  ⟨inducedGaugeParameterBoundaryTraces_relative_compatible
      fieldTraces gaugeAction,
    inducedGaugeParameterBoundaryTraces_absolute_compatible
      fieldTraces gaugeAction⟩

theorem gaugeBoundaryCompatible_relative_iff
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (parameterTraces : GaugeParameterBoundaryTraces (P := P) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeBoundaryCompatible .relative fieldTraces parameterTraces
        gaugeAction ↔
      ∀ epsilon : P,
        parameterTraces.relativeParameterTrace epsilon = 0 →
          fieldTraces.relativeTrace (gaugeAction epsilon) = 0 := by
  rfl

theorem gaugeBoundaryCompatible_absolute_iff
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (parameterTraces : GaugeParameterBoundaryTraces (P := P) (B := B))
    (gaugeAction : P →L[ℂ] G) :
    GaugeBoundaryCompatible .absolute fieldTraces parameterTraces
        gaugeAction ↔
      ∀ epsilon : P,
        parameterTraces.absoluteParameterTrace epsilon = 0 →
          fieldTraces.absoluteTrace (gaugeAction epsilon) = 0 := by
  rfl

/-- Compatibility gives preservation of the relative field domain. -/
theorem gaugeAction_maps_relative_parameter_kernel
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (parameterTraces : GaugeParameterBoundaryTraces (P := P) (B := B))
    (gaugeAction : P →L[ℂ] G)
    (hCompatible : GaugeBoundaryCompatible .relative fieldTraces
      parameterTraces gaugeAction)
    {epsilon : P}
    (hEpsilon :
      epsilon ∈ parameterTraces.relativeParameterTrace.ker) :
    gaugeAction epsilon ∈ gaugeBoundaryDomain fieldTraces .relative := by
  exact hCompatible epsilon hEpsilon

/-- Compatibility gives preservation of the absolute field domain. -/
theorem gaugeAction_maps_absolute_parameter_kernel
    (fieldTraces : GaugeBoundaryTraces (G := G) (B := B))
    (parameterTraces : GaugeParameterBoundaryTraces (P := P) (B := B))
    (gaugeAction : P →L[ℂ] G)
    (hCompatible : GaugeBoundaryCompatible .absolute fieldTraces
      parameterTraces gaugeAction)
    {epsilon : P}
    (hEpsilon :
      epsilon ∈ parameterTraces.absoluteParameterTrace.ker) :
    gaugeAction epsilon ∈ gaugeBoundaryDomain fieldTraces .absolute := by
  exact hCompatible epsilon hEpsilon

end GaugeBoundary

/-! ## Concrete gauge-slice boundary specialization -/

section ConcreteGaugeBoundary

variable (Y : ℝ)
variable (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y)
variable {BoundaryFiber : Type*}
variable [NormedAddCommGroup BoundaryFiber]
variable [NormedSpace ℂ BoundaryFiber]

/-- Boundary traces on the cover-level Coulomb gauge slice.  The analogous
quotient-ready endpoint uses `DeckCovariantCoulombGaugeSlice`. -/
abbrev CoulombSliceBoundaryTraces :=
  GaugeBoundaryTraces
    (G := CoulombGaugeSlice Y divergence) (B := BoundaryFiber)

/-- The relative endpoint for the cover-level gauge slice. -/
def RelativeGaugeHamiltonianDomain
    (traces : CoulombSliceBoundaryTraces Y divergence
      (BoundaryFiber := BoundaryFiber)) :
    Submodule ℂ (CoulombGaugeSlice Y divergence) :=
  gaugeBoundaryDomain traces .relative

/-- The absolute endpoint for the cover-level gauge slice. -/
def AbsoluteGaugeHamiltonianDomain
    (traces : CoulombSliceBoundaryTraces Y divergence
      (BoundaryFiber := BoundaryFiber)) :
    Submodule ℂ (CoulombGaugeSlice Y divergence) :=
  gaugeBoundaryDomain traces .absolute

end ConcreteGaugeBoundary

/-! ## Consolidated type-firewall statement -/

/-- The headline is deliberately structural: the matter carrier, typed cover
gauge carrier, Dirichlet endpoint label, and actual Gamma(2) quotient side
identification all exist without asserting a missing trace or gauge-descent
theorem. -/
theorem matter_gauge_dirichlet_firewall
    {Sector : Type*} (sector : Sector) (Y : ℝ)
    (divergence : GaugeFluctuation Y →L[ℂ] GaugeDivergenceTarget Y) :
    (HD sector Y).boundary = .dirichlet ∧
      (HGRelative sector Y).boundary = .relative ∧
      Nonempty (MatterField Y →ₗ[ℂ]
        CoulombGaugeSlice Y divergence) := by
  refine ⟨rfl, rfl, ?_⟩
  exact ⟨0⟩

end QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension


open scoped ComplexConjugate InnerProduct

namespace QYM.FullCertification.P1AdmissibleBackgroundExtension

open QYM.FullCertification.P1NotationFirewall
open QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension
open QYM.FullCertification.Mock2EtaPeterssonCarrierExtension
open QYM.Mock2EtaCovariantDerivativeExtension
open QYM.Mock2EtaCovariantDerivativeExtension.Geometry

/-- Local aliases avoid relying on precedence between several opened producer
namespaces which expose definitionally equal `H` and `Gamma2` abbreviations. -/
abbrev H := Mock2.Definition15Geometry.H
abbrev Gamma2 := Mock2.Definition15Geometry.Gamma2

/-!
# P1.4: a data-only admissible-background family

This module deliberately separates *background data* from analytic theorems.
`AdmissibleBackground sector Y` contains only:

* a matter-only type tag/proof;
* an actual automorphic line-bundle identity;
* fibrewise Hermitian-pairing data;
* connection data;
* a bounded potential operator (boundedness is carried by the
  `ContinuousLinearMap` type, not by an assumed proposition field);
* a boundary-condition kind, from which the indexed endpoint label is
  derived definitionally.

In particular the record has no closedness, self-adjointness, compactness,
coercivity, resolvent, eigenvalue, or spectral-gap field.  Such facts must be
proved later from the concrete data.

The first inhabitant uses Mock2's genuine inverse-eta bundle and its genuine
eta-gauge derivative.  Its safe potential is

`g(sector) V_Delta`,  where `V_Delta = id` and
`g(sector) = min (QSector.coupling sector)^2 1`.

Thus `g` is real, continuous as a function of the real coupling coordinate,
nonnegative, and bounded by one.  Here `V_Delta = id` is a deliberately safe
baseline chosen for P1; it is not identified with the paper's still-assumed
augmented-energy Hessian `V_q`.  This first model has a Dirichlet *label*.
The inverse-eta distinguished lift is bundle data; it is not asserted to
satisfy a Dirichlet trace condition.
-/

/-! ## Bundle identity and its explicit inverse-eta inhabitant -/

/-- Data identifying a matter line bundle by its actual quotient bundle,
automorphy factor, and a distinguished local lift.  Covariance is intentionally
proved outside this record rather than inserted as an analytic certificate. -/
structure MatterBundleData where
  bundle : Mock2.Definition15Geometry.AutomorphicLineBundle
  automorphyFactor : Gamma2 → H → ℂ
  distinguishedLift : H → ℂ

/-- The actual inverse-eta automorphic bundle data already constructed from
Mock2's concrete multiplier. -/
noncomputable def inverseEtaMatterBundleData : MatterBundleData where
  bundle := EtaAutomorphicLineBundle
  automorphyFactor := etaAutomorphyFactor
  distinguishedLift := inverseEtaSection

@[simp] theorem inverseEtaMatterBundleData_bundle :
    inverseEtaMatterBundleData.bundle = EtaAutomorphicLineBundle :=
  rfl

@[simp] theorem inverseEtaMatterBundleData_factor
    (gamma : Gamma2) (tau : H) :
    inverseEtaMatterBundleData.automorphyFactor gamma tau =
      etaAutomorphyFactor gamma tau :=
  rfl

@[simp] theorem inverseEtaMatterBundleData_lift (tau : H) :
    inverseEtaMatterBundleData.distinguishedLift tau = inverseEtaSection tau :=
  rfl

/-- The bundle datum is tied to Mock2's explicit eta quotient, not to an
uninterpreted multiplier symbol. -/
theorem inverseEtaMatterBundleData_factor_eq_etaRatio
    (gamma : Gamma2) (tau : H) :
    inverseEtaMatterBundleData.automorphyFactor gamma tau =
      Mock2.Definition15Geometry.EtaHalfWeight.etaRatio gamma tau := by
  exact etaAutomorphyFactor_eq_etaRatio gamma tau

/-- The distinguished inverse-eta lift is nowhere zero. -/
theorem inverseEtaMatterBundleData_lift_ne_zero (tau : H) :
    inverseEtaMatterBundleData.distinguishedLift tau ≠ 0 := by
  exact inverseEtaSection_ne_zero tau

/-- Exact inverse-eta covariance for the distinguished lift. -/
theorem inverseEtaMatterBundleData_covariant
    (gamma : Gamma2) (tau : H) :
    inverseEtaMatterBundleData.distinguishedLift (gamma • tau) =
      inverseEtaMatterBundleData.automorphyFactor gamma tau *
        inverseEtaMatterBundleData.distinguishedLift tau := by
  exact inverseEtaSection_covariant gamma tau

/-! ## Hermitian metric data -/

/-- Fibrewise Hermitian-pairing data in a local upper-half-plane chart.  The algebraic laws of the concrete
inhabitant are theorems below; they are not assumptions stored in the
background record. -/
structure HermitianMetricData where
  pairing : H → ℂ → ℂ → ℂ

/-- The standard Hermitian metric on the one-dimensional complex fibre. -/
def standardHermitianMetricData : HermitianMetricData where
  pairing _tau z w := ⟪z, w⟫_ℂ

@[simp] theorem standardHermitianMetricData_pairing (tau : H) (z w : ℂ) :
    standardHermitianMetricData.pairing tau z w = ⟪z, w⟫_ℂ :=
  rfl

theorem standardHermitianMetricData_conj_symm (tau : H) (z w : ℂ) :
    conj (standardHermitianMetricData.pairing tau w z) =
      standardHermitianMetricData.pairing tau z w := by
  exact inner_conj_symm z w

theorem standardHermitianMetricData_self_nonneg (tau : H) (z : ℂ) :
    0 ≤ (standardHermitianMetricData.pairing tau z z).re := by
  exact inner_self_nonneg (𝕜 := ℂ) (x := z)

theorem standardHermitianMetricData_self_eq_norm_sq (tau : H) (z : ℂ) :
    (standardHermitianMetricData.pairing tau z z).re = ‖z‖ ^ 2 := by
  exact inner_self_eq_norm_sq (𝕜 := ℂ) z

/-- The inverse-eta bundle metric.  In the eta trivialization it measures a
local fibre coordinate `z` by the standard norm of `eta(tau) * z`.  This
base-dependent factor is essential: the bare standard metric is not invariant
under the non-unitary half-weight automorphy factor. -/
noncomputable def inverseEtaHermitianMetricData : HermitianMetricData where
  pairing tau z w :=
    ⟪Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z,
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * w⟫_ℂ

@[simp] theorem inverseEtaHermitianMetricData_pairing
    (tau : H) (z w : ℂ) :
    inverseEtaHermitianMetricData.pairing tau z w =
      ⟪Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z,
        Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * w⟫_ℂ :=
  rfl

theorem inverseEtaHermitianMetricData_conj_symm
    (tau : H) (z w : ℂ) :
    conj (inverseEtaHermitianMetricData.pairing tau w z) =
      inverseEtaHermitianMetricData.pairing tau z w := by
  exact inner_conj_symm _ _

theorem inverseEtaHermitianMetricData_self_nonneg
    (tau : H) (z : ℂ) :
    0 ≤ (inverseEtaHermitianMetricData.pairing tau z z).re := by
  exact inner_self_nonneg (𝕜 := ℂ)
    (x := Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z)

theorem inverseEtaHermitianMetricData_self_pos
    (tau : H) {z : ℂ} (hz : z ≠ 0) :
    0 < (inverseEtaHermitianMetricData.pairing tau z z).re := by
  change
    0 <
      (⟪Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z,
        Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * z⟫_ℂ).re
  exact (re_inner_self_pos (𝕜 := ℂ)).2
    (mul_ne_zero
      (Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero tau) hz)

/-- Multiplying a fibre coordinate by the eta automorphy factor is an
isometry for the base-dependent inverse-eta Hermitian metric. -/
theorem inverseEtaHermitianMetricData_transition_isometry
    (gamma : Gamma2) (tau : H) (z w : ℂ) :
    inverseEtaHermitianMetricData.pairing (gamma • tau)
        (etaAutomorphyFactor gamma tau * z)
        (etaAutomorphyFactor gamma tau * w) =
      inverseEtaHermitianMetricData.pairing tau z w := by
  have htransport (a : ℂ) :
      Mock2.Definition15Geometry.EtaHalfWeight.etaValue (gamma • tau) *
          (etaAutomorphyFactor gamma tau * a) =
        Mock2.Definition15Geometry.EtaHalfWeight.etaValue tau * a := by
    rw [etaAutomorphyFactor_eq_etaRatio]
    simp only [Mock2.Definition15Geometry.EtaHalfWeight.etaRatio]
    field_simp [Mock2.Definition15Geometry.EtaHalfWeight.etaValue_ne_zero]
    <;> ring
  simp only [inverseEtaHermitianMetricData_pairing, htransport]

/-! ## Connection data -/

/-- A connection datum from smooth eta-covariant matter sections to the
correct eta-twisted one-form module.  This type prevents accidental use as a
connection on the separate gauge-fluctuation carrier. -/
structure MatterConnectionData where
  derivative : SmoothEtaCovariantSection →ₗ[ℂ] EtaTwistedOneForm

/-- The actual eta-gauge derivative constructed from Mathlib's `mfderiv`. -/
noncomputable def inverseEtaConnectionData : MatterConnectionData where
  derivative := etaCovariantDerivativeLinear

@[simp] theorem inverseEtaConnectionData_apply
    (f : SmoothEtaCovariantSection) :
    inverseEtaConnectionData.derivative f = etaCovariantDerivativeLinear f :=
  rfl

/-- On an invariant scalar `g`, the connection is exactly the concrete
`eta⁻¹ · mfderiv g` derivative supplied by the derivative producer.  Keeping
the target as `covariantDerivativeLinear g` avoids restating the manifold
model-with-corners arguments at this API boundary. -/
theorem inverseEtaConnectionData_etaSection
    (g : SmoothInvariantScalar) :
    inverseEtaConnectionData.derivative (etaSectionLinear g) =
      covariantDerivativeLinear g := by
  exact etaCovariantDerivative_etaSection g

/-! ## A first safe bounded potential -/

/-- The concrete matter Hilbert carrier on which the first safe potential
acts.  This is the inverse-eta `H1` graph completion selected by the P1.2
matter/gauge firewall, not the gauge-fluctuation carrier. -/
abbrev EtaMatterCarrier (Y : ℝ) := MatterField Y

/-- A bounded, nonnegative coupling profile.  Squaring removes the sign of a
real coupling, and `min _ 1` gives a uniform bound without adding hypotheses to
`QSector`. -/
def safeCouplingProfile (r : ℝ) : ℝ :=
  min (r ^ 2) 1

theorem safeCouplingProfile_nonneg (r : ℝ) :
    0 ≤ safeCouplingProfile r := by
  exact le_min (sq_nonneg r) zero_le_one

theorem safeCouplingProfile_le_one (r : ℝ) :
    safeCouplingProfile r ≤ 1 := by
  exact min_le_right _ _

theorem safeCouplingProfile_mem_Icc (r : ℝ) :
    safeCouplingProfile r ∈ Set.Icc (0 : ℝ) 1 :=
  ⟨safeCouplingProfile_nonneg r, safeCouplingProfile_le_one r⟩

/-- Continuity of the safe profile as a genuine real function. -/
theorem continuous_safeCouplingProfile : Continuous safeCouplingProfile := by
  exact (continuous_id.pow 2).min continuous_const

/-- The physical-sector coefficient.  Non-coupling sector tags are sent to
the neutral real coupling by `QSector.coupling`; the original tag remains
recoverable through `QSector.coupling?`. -/
def sectorPotentialCoefficient (sector : QSector) : ℝ :=
  safeCouplingProfile sector.coupling

theorem sectorPotentialCoefficient_nonneg (sector : QSector) :
    0 ≤ sectorPotentialCoefficient sector :=
  safeCouplingProfile_nonneg sector.coupling

theorem sectorPotentialCoefficient_le_one (sector : QSector) :
    sectorPotentialCoefficient sector ≤ 1 :=
  safeCouplingProfile_le_one sector.coupling

@[simp] theorem sectorPotentialCoefficient_ofCoupling (r : ℝ) :
    sectorPotentialCoefficient (.ofCoupling r) = safeCouplingProfile r :=
  rfl

/-- Continuity along the actual real-coupling constructor.  We intentionally
do not install an arbitrary topology on the disjoint tagged type `QSector`. -/
theorem continuous_sectorPotentialCoefficient_along_coupling :
    Continuous
      (fun r : ℝ => sectorPotentialCoefficient (QSector.ofCoupling r)) := by
  simpa only [sectorPotentialCoefficient_ofCoupling] using
    continuous_safeCouplingProfile

@[simp] theorem sectorPotentialCoefficient_ofCharge (q : ResidueCharge) :
    sectorPotentialCoefficient (.ofCharge q) = 0 := by
  simp [sectorPotentialCoefficient, safeCouplingProfile]

@[simp] theorem sectorPotentialCoefficient_ofBackgroundHolonomy
    (h : UnitaryHolonomy) :
    sectorPotentialCoefficient (.ofBackgroundHolonomy h) = 0 := by
  simp [sectorPotentialCoefficient, safeCouplingProfile]

/-- `V_Delta` for the first safe model: the identity on the concrete matter
carrier.  It is not a gauge-field operator. -/
noncomputable def deltaMatterPotential (Y : ℝ) :
    EtaMatterCarrier Y →L[ℂ] EtaMatterCarrier Y :=
  ContinuousLinearMap.id ℂ (EtaMatterCarrier Y)

@[simp] theorem deltaMatterPotential_apply (Y : ℝ)
    (u : EtaMatterCarrier Y) :
    deltaMatterPotential Y u = u :=
  rfl

theorem deltaMatterPotential_norm_le_one (Y : ℝ) :
    ‖deltaMatterPotential Y‖ ≤ 1 :=
  ContinuousLinearMap.norm_id_le

/-- The actual safe potential `g(sector) V_Delta`. -/
noncomputable def safeMatterPotential (sector : QSector) (Y : ℝ) :
    EtaMatterCarrier Y →L[ℂ] EtaMatterCarrier Y :=
  (sectorPotentialCoefficient sector : ℂ) • deltaMatterPotential Y

@[simp] theorem safeMatterPotential_apply (sector : QSector) (Y : ℝ)
    (u : EtaMatterCarrier Y) :
    safeMatterPotential sector Y u =
      (sectorPotentialCoefficient sector : ℂ) • u := by
  rfl

/-- The fixed-sector potential is bounded by its explicit real coefficient. -/
theorem safeMatterPotential_norm_le_coefficient
    (sector : QSector) (Y : ℝ) :
    ‖safeMatterPotential sector Y‖ ≤ sectorPotentialCoefficient sector := by
  calc
    ‖safeMatterPotential sector Y‖ ≤
        ‖(sectorPotentialCoefficient sector : ℂ)‖ *
          ‖deltaMatterPotential Y‖ := by
      simpa only [safeMatterPotential] using
        (ContinuousLinearMap.opNorm_smul_le
          (sectorPotentialCoefficient sector : ℂ)
          (deltaMatterPotential Y))
    _ ≤ ‖(sectorPotentialCoefficient sector : ℂ)‖ * 1 :=
      mul_le_mul_of_nonneg_left (deltaMatterPotential_norm_le_one Y)
        (norm_nonneg _)
    _ = sectorPotentialCoefficient sector := by
      simp [abs_of_nonneg (sectorPotentialCoefficient_nonneg sector)]

/-- Uniform operator-norm bound for the safe potential family. -/
theorem safeMatterPotential_norm_le_one (sector : QSector) (Y : ℝ) :
    ‖safeMatterPotential sector Y‖ ≤ 1 :=
  (safeMatterPotential_norm_le_coefficient sector Y).trans
    (sectorPotentialCoefficient_le_one sector)

/-- Explicit pointwise norm formula. -/
theorem norm_safeMatterPotential_apply (sector : QSector) (Y : ℝ)
    (u : EtaMatterCarrier Y) :
    ‖safeMatterPotential sector Y u‖ =
      sectorPotentialCoefficient sector * ‖u‖ := by
  rw [safeMatterPotential_apply, norm_smul]
  simp [abs_of_nonneg (sectorPotentialCoefficient_nonneg sector)]

/-- The safe potential has nonnegative quadratic value.  This is proved from
the explicit scalar operator; it is not an `AdmissibleBackground` field. -/
theorem safeMatterPotential_inner_nonneg (sector : QSector) (Y : ℝ)
    (u : EtaMatterCarrier Y) :
    0 ≤ (⟪u, safeMatterPotential sector Y u⟫_ℂ).re := by
  rw [safeMatterPotential_apply]
  have hinner :
      ⟪u, (sectorPotentialCoefficient sector : ℂ) • u⟫_ℂ =
        (sectorPotentialCoefficient sector : ℂ) * ⟪u, u⟫_ℂ :=
    inner_smul_right u u (sectorPotentialCoefficient sector : ℂ)
  rw [hinner]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  exact mul_nonneg (sectorPotentialCoefficient_nonneg sector)
    (inner_self_nonneg (𝕜 := ℂ) (x := u))

/-- The real quadratic energy of the safe baseline potential. -/
noncomputable def safeMatterPotentialEnergy
    (sector : QSector) (Y : ℝ) (u : EtaMatterCarrier Y) : ℝ :=
  (⟪u, safeMatterPotential sector Y u⟫_ℂ).re

@[simp] theorem safeMatterPotentialEnergy_nonneg
    (sector : QSector) (Y : ℝ) (u : EtaMatterCarrier Y) :
    0 ≤ safeMatterPotentialEnergy sector Y u :=
  safeMatterPotential_inner_nonneg sector Y u

/-- For every real Robin coefficient and every supplied pair of continuous
traces, the safe nonnegative *potential energy* is lower semibounded on the
Robin domain, with lower bound zero.  This is not a claim about the missing
kinetic/Green-identity part of a Robin Hamiltonian. -/
theorem safeMatterPotentialEnergy_robinLowerSemibounded
    {B : Type*} [NormedAddCommGroup B] [NormedSpace ℂ B]
    (sector : QSector) (Y : ℝ)
    (cuspTrace conormalTrace : EtaMatterCarrier Y →L[ℂ] B)
    (rho : ℝ) :
    RobinLowerSemiboundedRequirement cuspTrace conormalTrace rho
      (safeMatterPotentialEnergy sector Y) :=
  robinLowerSemiboundedRequirement_of_nonnegative
    cuspTrace conormalTrace rho (safeMatterPotentialEnergy sector Y)
    (safeMatterPotentialEnergy_nonneg sector Y)

/-- Potential data is typed specifically on the inverse-eta matter carrier. -/
structure MatterPotentialData (sector : QSector) (Y : ℝ) where
  operator : EtaMatterCarrier Y →L[ℂ] EtaMatterCarrier Y

noncomputable def safeMatterPotentialData (sector : QSector) (Y : ℝ) :
    MatterPotentialData sector Y where
  operator := safeMatterPotential sector Y

@[simp] theorem safeMatterPotentialData_operator
    (sector : QSector) (Y : ℝ) :
    (safeMatterPotentialData sector Y).operator = safeMatterPotential sector Y :=
  rfl

/-! ## The data-only background record and inverse-eta inhabitant -/

/-- Background input for the first concrete matter Hamiltonian family.

The declaration body is an audit firewall: it contains only data.  In
particular there are no fields asserting self-adjointness, closedness,
compactness, lower bounds, coercivity, or a spectral gap. -/
structure AdmissibleBackground (sector : QSector) (Y : ℝ) where
  fieldKind : {kind : FieldKind // kind = .matter}
  bundle : MatterBundleData
  hermitianMetric : HermitianMetricData
  connection : MatterConnectionData
  potential : MatterPotentialData sector Y
  boundaryCondition : BoundaryKind

/-- The indexed Hamiltonian label derived from a background.  Because the
sector and truncation height come from the record indices, a background cannot
silently carry a label for a different endpoint. -/
def AdmissibleBackground.hamiltonianBoundaryLabel
    {sector : QSector} {Y : ℝ} (background : AdmissibleBackground sector Y) :
    MatterHamiltonianBoundaryLabel QSector where
  sector := sector
  truncationHeight := Y
  boundary := background.boundaryCondition

@[simp] theorem AdmissibleBackground.hamiltonianBoundaryLabel_sector
    {sector : QSector} {Y : ℝ} (background : AdmissibleBackground sector Y) :
    background.hamiltonianBoundaryLabel.sector = sector :=
  rfl

@[simp] theorem AdmissibleBackground.hamiltonianBoundaryLabel_height
    {sector : QSector} {Y : ℝ} (background : AdmissibleBackground sector Y) :
    background.hamiltonianBoundaryLabel.truncationHeight = Y :=
  rfl

@[simp] theorem AdmissibleBackground.hamiltonianBoundaryLabel_boundary
    {sector : QSector} {Y : ℝ} (background : AdmissibleBackground sector Y) :
    background.hamiltonianBoundaryLabel.boundary =
      background.boundaryCondition :=
  rfl

/-- The explicit inverse-eta matter background with Dirichlet horocycle
boundary label and safe bounded potential. -/
noncomputable def inverseEtaDirichletBackground
    (sector : QSector) (Y : ℝ) : AdmissibleBackground sector Y where
  fieldKind := ⟨.matter, rfl⟩
  bundle := inverseEtaMatterBundleData
  hermitianMetric := inverseEtaHermitianMetricData
  connection := inverseEtaConnectionData
  potential := safeMatterPotentialData sector Y
  boundaryCondition := .dirichlet

@[simp] theorem inverseEtaDirichletBackground_fieldKind
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).fieldKind.1 = .matter :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_bundle
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).bundle =
      inverseEtaMatterBundleData :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_hermitianMetric
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).hermitianMetric =
      inverseEtaHermitianMetricData :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_connection
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).connection.derivative =
      etaCovariantDerivativeLinear :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_potential
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).potential.operator =
      safeMatterPotential sector Y :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_boundary
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).boundaryCondition = .dirichlet :=
  rfl

@[simp] theorem inverseEtaDirichletBackground_hamiltonianBoundaryLabel
    (sector : QSector) (Y : ℝ) :
    (inverseEtaDirichletBackground sector Y).hamiltonianBoundaryLabel =
      HD sector Y :=
  rfl

/-- The background's local bundle lift retains the exact eta covariance. -/
theorem inverseEtaDirichletBackground_bundle_covariant
    (sector : QSector) (Y : ℝ) (gamma : Gamma2) (tau : H) :
    (inverseEtaDirichletBackground sector Y).bundle.distinguishedLift
        (gamma • tau) =
      (inverseEtaDirichletBackground sector Y).bundle.automorphyFactor
          gamma tau *
        (inverseEtaDirichletBackground sector Y).bundle.distinguishedLift tau := by
  exact inverseEtaMatterBundleData_covariant gamma tau

/-- The Hermitian metric stored in the background is compatible with the
actual inverse-eta transition function. -/
theorem inverseEtaDirichletBackground_metric_transition_isometry
    (sector : QSector) (Y : ℝ) (gamma : Gamma2) (tau : H) (z w : ℂ) :
    (inverseEtaDirichletBackground sector Y).hermitianMetric.pairing
        (gamma • tau)
        ((inverseEtaDirichletBackground sector Y).bundle.automorphyFactor
          gamma tau * z)
        ((inverseEtaDirichletBackground sector Y).bundle.automorphyFactor
          gamma tau * w) =
      (inverseEtaDirichletBackground sector Y).hermitianMetric.pairing
        tau z w := by
  exact inverseEtaHermitianMetricData_transition_isometry gamma tau z w

/-- Positivity of the concrete background metric is likewise derived from
the explicit eta trivialization. -/
theorem inverseEtaDirichletBackground_metric_self_nonneg
    (sector : QSector) (Y : ℝ) (tau : H) (z : ℂ) :
    0 ≤
      ((inverseEtaDirichletBackground sector Y).hermitianMetric.pairing
        tau z z).re := by
  exact inverseEtaHermitianMetricData_self_nonneg tau z

theorem inverseEtaDirichletBackground_metric_self_pos
    (sector : QSector) (Y : ℝ) (tau : H) {z : ℂ} (hz : z ≠ 0) :
    0 <
      ((inverseEtaDirichletBackground sector Y).hermitianMetric.pairing
        tau z z).re := by
  exact inverseEtaHermitianMetricData_self_pos tau hz

/-- The background's potential has the uniform norm bound, derived rather
than postulated. -/
theorem inverseEtaDirichletBackground_potential_norm_le_one
    (sector : QSector) (Y : ℝ) :
    ‖(inverseEtaDirichletBackground sector Y).potential.operator‖ ≤ 1 := by
  exact safeMatterPotential_norm_le_one sector Y

/-! ## A tag for later mock-natural potentials -/

/-- Names the intended future extension without asserting that a
Rankin--Selberg or mock-theta Hessian has already been constructed. -/
inductive PotentialExtensionTag where
  | safeDelta
  | futureMockNatural
  deriving DecidableEq, Repr

/-- The present concrete background uses only the safe Delta potential. -/
def inverseEtaBackgroundPotentialTag : PotentialExtensionTag :=
  .safeDelta

@[simp] theorem inverseEtaBackgroundPotentialTag_eq_safeDelta :
    inverseEtaBackgroundPotentialTag = .safeDelta :=
  rfl

/-! ## Consolidated P1 model-and-notation certificate -/

/-- Proof-carrying summary of exactly the P1 firewall established here.  This
record is not an input to `AdmissibleBackground`: the inhabitant below is
constructed from the preceding definitions and theorems.  It deliberately
contains no self-adjointness, trace, compactness, or spectral conclusion. -/
structure ModelNotationFirewallCertificate
    (sector : QSector) (Y : ℝ) : Prop where
  standard_q_not_global : ¬ StandardQParameterWellDefined
  local_unit_circle_absent :
    ∀ kappa : CuspLabel,
      ¬ ∃ tau : H, ‖localCuspParameter kappa tau‖ = 1
  local_sector_disjoint :
    ∀ (parameter : LocalCuspParameter) (physicalSector : QSector),
      Parameter.local parameter ≠ Parameter.sector physicalSector
  first_endpoint_is_matter : FirstEndpointFieldKind = .matter
  background_is_matter :
    (inverseEtaDirichletBackground sector Y).fieldKind.1 = .matter
  background_is_dirichlet :
    (inverseEtaDirichletBackground sector Y).boundaryCondition = .dirichlet
  indexed_endpoint_is_HD :
    (inverseEtaDirichletBackground sector Y).hamiltonianBoundaryLabel =
      HD sector Y
  potential_norm_le_one :
    ‖(inverseEtaDirichletBackground sector Y).potential.operator‖ ≤ 1
  potential_energy_nonnegative :
    ∀ u : EtaMatterCarrier Y,
      0 ≤
        (⟪u,
          (inverseEtaDirichletBackground sector Y).potential.operator u⟫_ℂ).re
  present_potential_tag_is_safe :
    inverseEtaBackgroundPotentialTag = .safeDelta

/-- Unconditional inhabitant of the consolidated P1 firewall certificate. -/
noncomputable def modelNotationFirewallCertificate
    (sector : QSector) (Y : ℝ) :
    ModelNotationFirewallCertificate sector Y where
  standard_q_not_global :=
    standardQParameter_does_not_descend_to_Gamma2Quotient
  local_unit_circle_absent :=
    no_upperHalfPlane_point_with_local_norm_one
  local_sector_disjoint := Parameter.local_ne_sector
  first_endpoint_is_matter := firstEndpointFieldKind_eq_matter
  background_is_matter := inverseEtaDirichletBackground_fieldKind sector Y
  background_is_dirichlet := inverseEtaDirichletBackground_boundary sector Y
  indexed_endpoint_is_HD :=
    inverseEtaDirichletBackground_hamiltonianBoundaryLabel sector Y
  potential_norm_le_one :=
    inverseEtaDirichletBackground_potential_norm_le_one sector Y
  potential_energy_nonnegative := by
    intro u
    simpa only [inverseEtaDirichletBackground_potential] using
      safeMatterPotential_inner_nonneg sector Y u
  present_potential_tag_is_safe :=
    inverseEtaBackgroundPotentialTag_eq_safeDelta

end QYM.FullCertification.P1AdmissibleBackgroundExtension

/-!
# Aggregate proof-carrying evidence accounting

The ten typed registries deliberately use separate identifier types so later tranches do not
invalidate earlier public constructors.  This namespace records exact aggregate source counts and
proves that their claim-row links cover all 58 manual identifiers.  Link coverage still does not
assign a terminal paper-certification status or discharge the paper-specific analytic suppliers.
-/

namespace QYM.FullCertification.EvidenceAccounting

open QYM.FullCertification.Registry

/-- Total number of proof-carrying evidence tags across the ten independent registries. -/
def totalEvidenceTagCount : ℕ :=
  QYM.FullCertification.TypedEvidence.allEvidence.length +
    QYM.FullCertification.TypedEvidenceB2DirectExtension.allEvidence.length +
      QYM.FullCertification.TypedEvidenceVariationTailSignExtension.allEvidence.length +
        QYM.FullCertification.TypedEvidenceFullClaimExtension.allEvidence.length +
          QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension.allEvidence.length +
            QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension.allEvidence.length +
              QYM.FullCertification.TypedEvidenceFormResolventSpectralExtension.allEvidence.length +
                QYM.FullCertification.TypedEvidenceCoerciveFriedrichsExtension.allEvidence.length +
                  QYM.FullCertification.TypedEvidenceUnconditionalFunctionalAnalysisExtension.allEvidence.length +
                    QYM.FullCertification.TypedEvidenceClosedPureDiscreteGapExtension.allEvidence.length

