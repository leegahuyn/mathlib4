      (QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian_tendsto_strong u)
  simpa only [actualCutoffEscapeEnergy, norm_zero,
    zero_pow (by norm_num : (2 : ℕ) ≠ 0)] using hNorm.pow 2

/-- No nonzero fixed vector lies in every moving off-ground block.  The
increasing ground projections converge strongly to the identity, so the
intersection of the moving complements is trivial. -/
theorem mem_every_actualCutoffMovingOffGround_implies_zero
    (u : ActualGlobalL2)
    (hu : ∀ n : ℕ, u ∈ QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffMovingOffGround n) :
    u = 0 := by
  have hProjectionZero :
      ∀ n : ℕ, QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u = 0 := by
    intro n
    have huKer :
        u ∈ LinearMap.ker
          (QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n :
            ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2) := by
      rw [← QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffMovingOffGround_eq_stageProjection_ker n]
      exact hu n
    exact LinearMap.mem_ker.mp huKer
  have hStrong := QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM_tendsto_strong u
  have hZeroSequence :
      (fun n => QYM.FullCertification.P14ActualGlobalL2ProjectionConvergenceExtension.globalStageProjectionCLM n u) =
        (fun _ : ℕ => (0 : ActualGlobalL2)) := by
    funext n
    exact hProjectionZero n
  rw [hZeroSequence] at hStrong
  exact tendsto_nhds_unique hStrong tendsto_const_nhds

/-- Ground block of the zero limiting Hamiltonian. -/
def actualCutoffLimitGroundBlock : Submodule ℂ ActualGlobalL2 :=
  LinearMap.ker (0 : ActualGlobalL2 →ₗ[ℂ] ActualGlobalL2)

/-- Orthogonal complement of the complete limiting ground block. -/
def actualCutoffLimitOffGroundBlock : Submodule ℂ ActualGlobalL2 :=
  (actualCutoffLimitGroundBlock)ᗮ

theorem actualCutoffLimitGroundBlock_eq_top :
    actualCutoffLimitGroundBlock = ⊤ := by
  rw [actualCutoffLimitGroundBlock]
  exact LinearMap.ker_zero

theorem actualCutoffLimitOffGroundBlock_eq_bot :
    actualCutoffLimitOffGroundBlock = ⊥ := by
  rw [actualCutoffLimitOffGroundBlock,
    actualCutoffLimitGroundBlock_eq_top]
  exact Submodule.top_orthogonal_eq_bot

/-- There is no nonzero first-off-ground vector for the zero limit. -/
theorem actualCutoffLimit_has_no_nonzero_offGroundVector :
    ¬ ∃ u : ActualGlobalL2,
      u ∈ actualCutoffLimitOffGroundBlock ∧ u ≠ 0 := by
  rintro ⟨u, hu, hne⟩
  rw [actualCutoffLimitOffGroundBlock_eq_bot] at hu
  exact hne ((Submodule.mem_bot ℂ).mp hu)

/-! ## 4. Uniform-gap acceptance package is incompatible with this surrogate -/

/-- A deliberately strong acceptance predicate for the cutoff surrogate:
it asks for a positive stage-uniform coercivity constant, operator-norm
resolvent convergence, and persistent nontrivial moving excitation blocks.
The persistence clause prevents a vacuous positive estimate on bottom. -/
