open scoped BigOperators

/-!
# Corrected functional and finite spectral logic

This module records unconditional implications that remain after separating the paper's missing
analytic suppliers from its elementary functional logic.  It does not assert that the paper's
action blocks, Sobolev spaces, operators, spectra, or test kernels have been constructed.

The hypotheses below are transparent predicates on functions.  They expose, rather than hide,
the exact invariance, size, positivity, and majorant inputs used by each conclusion.
-/

namespace QYM.FullCertification.Corrected.FunctionalLogic

/-! ## Invariance of composite functionals -/

/-- A scalar- or vector-valued functional is invariant under the displayed transformation. -/
def InvariantUnder {G X Y : Type*} (transform : G → X → X) (functional : X → Y) : Prop :=
  ∀ g x, functional (transform g x) = functional x

theorem invariantUnder_const {G X Y : Type*} (transform : G → X → X) (c : Y) :
    InvariantUnder transform (fun _ : X => c) := by
  intro g x
  rfl

theorem invariantUnder_add {G X Y : Type*} [Add Y]
    {transform : G → X → X} {F H : X → Y}
    (hF : InvariantUnder transform F) (hH : InvariantUnder transform H) :
    InvariantUnder transform (fun x => F x + H x) := by
  intro g x
  change F (transform g x) + H (transform g x) = F x + H x
  rw [hF g x, hH g x]

theorem invariantUnder_neg {G X Y : Type*} [Neg Y]
    {transform : G → X → X} {F : X → Y}
    (hF : InvariantUnder transform F) :
    InvariantUnder transform (fun x => -F x) := by
  intro g x
  change -F (transform g x) = -F x
  rw [hF g x]

theorem invariantUnder_sub {G X Y : Type*} [Sub Y]
    {transform : G → X → X} {F H : X → Y}
    (hF : InvariantUnder transform F) (hH : InvariantUnder transform H) :
    InvariantUnder transform (fun x => F x - H x) := by
  intro g x
  change F (transform g x) - H (transform g x) = F x - H x
  rw [hF g x, hH g x]

/-- Four invariant action blocks have an invariant sum. -/
theorem invariantUnder_sum_four {G X Y : Type*} [AddSemigroup Y]
    {transform : G → X → X} {F₁ F₂ F₃ F₄ : X → Y}
    (h₁ : InvariantUnder transform F₁)
    (h₂ : InvariantUnder transform F₂)
    (h₃ : InvariantUnder transform F₃)
    (h₄ : InvariantUnder transform F₄) :
    InvariantUnder transform (fun x => ((F₁ x + F₂ x) + F₃ x) + F₄ x) := by
  exact invariantUnder_add (invariantUnder_add (invariantUnder_add h₁ h₂) h₃) h₄

/-! ## Weak criticality -/

/-- A corrected weak critical point: the state is admissible and its displayed first variation
vanishes on every displayed admissible variation. -/
def IsWeakCriticalAt {X V : Type*}
    (isAdmissible : X → Prop)
    (isVariation : X → V → Prop)
    (firstVariation : X → V → ℝ)
    (state : X) : Prop :=
  isAdmissible state ∧
    ∀ variation : V, isVariation state variation → firstVariation state variation = 0

theorem isWeakCriticalAt_iff {X V : Type*}
    (isAdmissible : X → Prop)
    (isVariation : X → V → Prop)
    (firstVariation : X → V → ℝ)
    (state : X) :
    IsWeakCriticalAt isAdmissible isVariation firstVariation state ↔
      isAdmissible state ∧
        ∀ variation : V,
          isVariation state variation → firstVariation state variation = 0 := Iff.rfl

theorem IsWeakCriticalAt.firstVariation_eq_zero {X V : Type*}
    {isAdmissible : X → Prop}
    {isVariation : X → V → Prop}
    {firstVariation : X → V → ℝ}
    {state : X}
    (hcritical : IsWeakCriticalAt isAdmissible isVariation firstVariation state)
    {variation : V} (hvariation : isVariation state variation) :
    firstVariation state variation = 0 :=
  hcritical.2 variation hvariation

theorem isWeakCriticalAt_congr_firstVariation {X V : Type*}
    {isAdmissible : X → Prop} {isVariation : X → V → Prop}
    {firstVariation₁ firstVariation₂ : X → V → ℝ} {state : X}
    (hfirst : ∀ variation, isVariation state variation →
      firstVariation₁ state variation = firstVariation₂ state variation) :
    IsWeakCriticalAt isAdmissible isVariation firstVariation₁ state ↔
      IsWeakCriticalAt isAdmissible isVariation firstVariation₂ state := by
  constructor
  · rintro ⟨hstate, hcritical⟩
    refine ⟨hstate, ?_⟩
    intro variation hvariation
    rw [← hfirst variation hvariation]
    exact hcritical variation hvariation
  · rintro ⟨hstate, hcritical⟩
    refine ⟨hstate, ?_⟩
    intro variation hvariation
    rw [hfirst variation hvariation]
    exact hcritical variation hvariation

/-! ## Abstract duality and triple-product bounds -/

/-- A transparent duality estimate with an explicit constant and size functions. -/
def HasDualityBound {D P : Type*}
    (pairing : D → P → ℝ) (dualSize : D → ℝ) (primalSize : P → ℝ) (C : ℝ) : Prop :=
  0 ≤ C ∧ ∀ d p, |pairing d p| ≤ C * dualSize d * primalSize p

/-- A transparent bilinear size estimate. -/
def HasBilinearSizeBound {P D : Type*}
    (bilinear : P → P → D) (primalSize : P → ℝ) (dualSize : D → ℝ) (K : ℝ) : Prop :=
  0 ≤ K ∧ ∀ x y, dualSize (bilinear x y) ≤ K * primalSize x * primalSize y

theorem tripleProduct_bound {P D : Type*}
    (pairing : D → P → ℝ) (bilinear : P → P → D)
    (primalSize : P → ℝ) (dualSize : D → ℝ)
    (C K : ℝ)
    (hsize : ∀ x, 0 ≤ primalSize x)
    (hpair : HasDualityBound pairing dualSize primalSize C)
    (hbilinear : HasBilinearSizeBound bilinear primalSize dualSize K)
    (x y z : P) :
    |pairing (bilinear x y) z| ≤
      (C * K) * primalSize x * primalSize y * primalSize z := by
  calc
    |pairing (bilinear x y) z| ≤
        C * dualSize (bilinear x y) * primalSize z := hpair.2 _ _
    _ ≤ C * (K * primalSize x * primalSize y) * primalSize z := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hbilinear.2 x y) hpair.1) (hsize z)
    _ = (C * K) * primalSize x * primalSize y * primalSize z := by ring

/-! ## Low-lying gap and nonnegative ground mass -/

/-- Adjacent low-lying gap of an explicitly indexed real spectrum. -/
def lowLyingGap (eigenvalue : ℕ → ℝ) (n : ℕ) : ℝ :=
  eigenvalue (n + 1) - eigenvalue n

theorem lowLyingGap_eq (eigenvalue : ℕ → ℝ) (n : ℕ) :
    lowLyingGap eigenvalue n = eigenvalue (n + 1) - eigenvalue n := rfl

theorem lowLyingGap_pos_of_lower_bound
    (eigenvalue : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (hδ : 0 < δ) (hgap : δ ≤ lowLyingGap eigenvalue n) :
    0 < lowLyingGap eigenvalue n :=
  lt_of_lt_of_le hδ hgap

/-- Ground mass defined only through the nonnegative square-root convention. -/
def groundMass (eigenvalue : ℕ → ℝ) : ℝ :=
  Real.sqrt (eigenvalue 0)

theorem groundMass_nonneg (eigenvalue : ℕ → ℝ) :
    0 ≤ groundMass eigenvalue :=
  Real.sqrt_nonneg _

theorem groundMass_sq {eigenvalue : ℕ → ℝ} (hground : 0 ≤ eigenvalue 0) :
    groundMass eigenvalue ^ 2 = eigenvalue 0 := by
  exact Real.sq_sqrt hground

theorem exists_nonneg_mass_with_square_eq {eigenvalue : ℕ → ℝ}
    (hground : 0 ≤ eigenvalue 0) :
    ∃ mass : ℝ, 0 ≤ mass ∧ mass ^ 2 = eigenvalue 0 :=
  ⟨groundMass eigenvalue, groundMass_nonneg eigenvalue, groundMass_sq hground⟩

/-! ## Bounded shadow corrections -/

/-- A pointwise bounded real correction on an indexed spectrum. -/
def IsBoundedShadowCorrection {ι : Type*}
    (correction : ι → ℝ) (ε : ℝ) : Prop :=
  ∀ i, |correction i| ≤ ε

/-- Corrected indexed eigenvalue in the elementary bounded regime. -/
def correctedEigenvalue {ι : Type*}
    (eigenvalue correction : ι → ℝ) (i : ι) : ℝ :=
  eigenvalue i + correction i

theorem correctedEigenvalue_sub {ι : Type*}
    (eigenvalue correction : ι → ℝ) (i : ι) :
    correctedEigenvalue eigenvalue correction i - eigenvalue i = correction i := by
  simp [correctedEigenvalue]

theorem correctedEigenvalue_error {ι : Type*}
    (eigenvalue correction : ι → ℝ) (ε : ℝ)
    (hcorrection : IsBoundedShadowCorrection correction ε) (i : ι) :
    |correctedEigenvalue eigenvalue correction i - eigenvalue i| ≤ ε := by
  rw [correctedEigenvalue_sub]
  exact hcorrection i

/-! ## Smoothed finite counts and window majorants -/

/-- Finite smoothed counting functional centered at `center`. -/
def smoothedCount {n : ℕ}
    (spectrum : Fin n → ℝ) (weight : ℝ → ℝ) (center : ℝ) : ℝ :=
  ∑ i : Fin n, weight (spectrum i - center)

/-- Real-valued finite window count, written as a sum of zero-one indicators. -/
def realWindowCount {n : ℕ}
    (spectrum : Fin n → ℝ) (center radius : ℝ) : ℝ :=
  ∑ i : Fin n, if |spectrum i - center| ≤ radius then 1 else 0

theorem smoothedCount_nonneg {n : ℕ}
    (spectrum : Fin n → ℝ) (weight : ℝ → ℝ) (center : ℝ)
    (hweight : ∀ t, 0 ≤ weight t) :
    0 ≤ smoothedCount spectrum weight center := by
  unfold smoothedCount
  exact Finset.sum_nonneg fun i _hi => hweight _

/-- A nonnegative smoothed majorant that is at least one on the window bounds the exact finite
zero-one window count. -/
theorem realWindowCount_le_smoothedCount {n : ℕ}
    (spectrum : Fin n → ℝ) (weight : ℝ → ℝ) (center radius : ℝ)
    (hweight_nonneg : ∀ t, 0 ≤ weight t)
    (hmajorant : ∀ i : Fin n,
      |spectrum i - center| ≤ radius → 1 ≤ weight (spectrum i - center)) :
    realWindowCount spectrum center radius ≤ smoothedCount spectrum weight center := by
  unfold realWindowCount smoothedCount
  apply Finset.sum_le_sum
  intro i _hi
  by_cases hi : |spectrum i - center| ≤ radius
  · simp only [hi, if_true]
    exact hmajorant i hi
  · simp only [hi, if_false]
    exact hweight_nonneg _

end QYM.FullCertification.Corrected.FunctionalLogic




