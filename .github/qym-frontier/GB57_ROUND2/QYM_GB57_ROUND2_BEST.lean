open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# Corrected exact-three boundary reduction

The first P2 boundary reduction intentionally exposed a local side-filling
obligation.  A static cross-audit reveals an important refinement: a point
where a paired side meets a truncation horocycle must remain on the quotient
boundary, so side filling may only be required *away from the horocycle
corner locus*.  Requiring every paired-side point to become interior is
incompatible with horocycle survival whenever a genuine corner exists.

This file states and proves the corrected reduction.  It also gives exact
reductions of the three remaining geometric inputs:

* nonemptiness is exactly nonemptiness of the genuine upstairs cusp part;
* quotient pairwise separation is exactly absence of a cross-cusp orbit;
* connectedness follows from connectedness of each genuine upstairs part.

None of those primitive geometric facts is present in the frozen dependency.
In particular, finiteness of edge/horocycle incidence does not imply that a
cusp part is nonempty or connected, and planar nullity does not imply orbit
separation.
-/

/-! ## Correct side filling: delete the horocycle corner locus -/

/-- Genuine paired-side frontier points which are not on any selected cusp
horocycle. -/
noncomputable def literalPairedSideAwayFromHorocycles (Y : ℝ) : Set ℍ :=
  QYM.FullCertification.P2BoundaryComponentReduction.literalSideFrontierPart Y \
    gammaTwoThreeCuspHorocycleBoundary Y

/-- Correct quotient-side filling statement.  Horocycle corners are excluded
because they belong to the physical boundary rather than the glued seam. -/
def PairedSidesAwayFromHorocyclesBecomeInteriorAt (Y : ℝ) : Prop :=
  ∀ z : ℍ, z ∈ literalPairedSideAwayFromHorocycles Y →
    gammaTwoQuotientMk z ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y)

/-- Exact upstairs formulation of the corrected local filling statement. -/
def LocalSaturationFillsPairedSidesAwayFromHorocyclesAt
    (Y : ℝ) : Prop :=
  ∀ z : ℍ, z ∈ literalPairedSideAwayFromHorocycles Y →
    z ∈ interior
      (⋃ g : GammaTwoEffective,
        (g • ·) '' gammaTwoThreeCuspTruncation Y)

/-- What the frozen dependency *does* prove unconditionally: after deleting
all height-equality points, a paired-side point is in the relative interior
of the literal stage inside the chosen closed polygon.  The missing theorem
is precisely the promotion from this one-sided relative neighbourhood to an
open neighbourhood in the saturated upper half-plane. -/
theorem literalPairedSideAway_has_relativeInterior_lift
    {Y : ℝ} {z : ℍ}
    (hz : z ∈ literalPairedSideAwayFromHorocycles Y) :
    ∃ p : GammaTwoChosenPolygon,
      (p : ℍ) = z ∧ p ∈ interior (gammaTwoRelativeTruncation Y) := by
  have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
    QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hz.1.1
  let p : GammaTwoChosenPolygon :=
    ⟨z, gammaTwoThreeCuspTruncation_subset_chosenCarrier Y hzStage⟩
  have hpStrict : p ∈ gammaTwoRelativeStrictHeightSublevel Y := by
    change z ∈ gammaTwoThreeCuspStrictHeightSublevel Y
    intro q
    have hle :=
      hzStage.2 (gammaTwoTileCuspClass q) q rfl
    have hne :
        gammaTwoTileHeight q z ≠ gammaTwoCuspLevel Y := by
      intro heq
      apply hz.2
      rw [gammaTwoThreeCuspHorocycleBoundary_eq_iUnion_selectedCurves]
      exact Set.mem_iUnion.2
        ⟨q, (mem_gammaTwoSelectedHorocycleCurve_iff).mpr heq⟩
    exact lt_of_le_of_ne hle hne
  exact ⟨p, rfl,
    gammaTwoRelativeStrictHeightSublevel_subset_interior Y hpStrict⟩

theorem pairedSidesAwayFromHorocyclesBecomeInterior_iff_localSaturation
    (Y : ℝ) :
    PairedSidesAwayFromHorocyclesBecomeInteriorAt Y ↔
      LocalSaturationFillsPairedSidesAwayFromHorocyclesAt Y := by
  constructor
  · intro h z hz
    exact
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mp
        (h z hz)
  · intro h z hz
    exact
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mpr
        (h z hz)

/-! ## Why the uncorrected side condition is too strong -/

/-- If every paired-side point were interior while every cusp-horocycle point
remained boundary, the genuine side/horocycle corner locus would have to be
empty.  The dependency proves that this locus is finite, not that it is
empty. -/
theorem literalFrontierCorners_eq_empty_of_strongSide_and_horocycle
    {Y : ℝ}
    (hStrongSide : QYM.FullCertification.P2BoundaryComponentReduction.PairedSidesBecomeInteriorAt Y)
    (hHorocycle : QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y) :
    gammaTwoLiteralFrontierCorners Y = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.2
  intro z hz
  change z ∈
      frontier (gammaTwoThreeCuspTruncation Y) ∩
        (gammaTwoPairedSideBoundary ∩
          gammaTwoThreeCuspHorocycleBoundary Y) at hz
  unfold gammaTwoThreeCuspHorocycleBoundary at hz
  rcases Set.mem_iUnion.mp hz.2.2 with ⟨kappa, hzKappa⟩
  have hzInterior :
      gammaTwoQuotientMk z ∈ interior (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
    hStrongSide z ⟨hz.1, hz.2.1⟩
  have hzBoundary :
      gammaTwoQuotientMk z ∈ frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) :=
    hHorocycle kappa z ⟨hz.1, hzKappa⟩
  have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
    QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hz.1
  exact
    ((mem_frontier_iff_notMem_interior
      (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp hzBoundary)
      hzInterior

theorem not_strongSide_and_horocycle_of_literalCorner_nonempty
    {Y : ℝ}
    (hCorner : (gammaTwoLiteralFrontierCorners Y).Nonempty) :
    ¬ (QYM.FullCertification.P2BoundaryComponentReduction.PairedSidesBecomeInteriorAt Y ∧
      QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y) := by
  rintro ⟨hSide, hHorocycle⟩
  rw [literalFrontierCorners_eq_empty_of_strongSide_and_horocycle
    hSide hHorocycle] at hCorner
  exact Set.not_nonempty_empty hCorner

/-! ## Horocycle survival as an exact saturation non-interiority statement -/

/-- Primitive upstairs exterior condition at the genuine cusp frontier. -/
def CuspSaturationRemainsNonInteriorAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp, ∀ z : ℍ,
    z ∈ QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa →
      z ∉ interior
        (⋃ g : GammaTwoEffective,
          (g • ·) '' gammaTwoThreeCuspTruncation Y)

theorem horocyclesRemainBoundary_iff_cuspSaturationNonInterior
    (Y : ℝ) :
    QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y ↔
      CuspSaturationRemainsNonInteriorAt Y := by
  constructor
  · intro hBoundary kappa z hz hzSaturation
    have hNonInterior :=
      (QYM.FullCertification.P2BoundaryComponentReduction.horocyclesRemainBoundary_iff_nonInterior Y).mp
        hBoundary kappa z hz
    exact hNonInterior
      ((QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mpr
        hzSaturation)
  · intro hSaturation
    apply (QYM.FullCertification.P2BoundaryComponentReduction.horocyclesRemainBoundary_iff_nonInterior Y).mpr
    intro kappa z hz hzInterior
    exact hSaturation kappa z hz
      ((QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_interior_XSet_iff_saturation Y z).mp
        hzInterior)

/-! ## Correct frontier equality -/

/-- Side filling away from corners plus horocycle survival gives the exact
quotient frontier.  At a corner the horocycle branch is selected first, so no
false interior assertion is used. -/
theorem frontier_XSet_eq_iUnion_cuspPieces_corrected
    {Y : ℝ}
    (hSide : PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hHorocycle : QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y) :
    frontier (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y) =
      ⋃ kappa : GammaTwoCusp,
        QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y kappa := by
  apply Set.Subset.antisymm
  · intro x hx
    rcases QYM.FullCertification.P2BoundaryComponentReduction.frontier_XSet_subset_image_literal_frontier Y hx with
      ⟨z, hzFrontier, rfl⟩
    by_cases hzHorocycle :
        z ∈ gammaTwoThreeCuspHorocycleBoundary Y
    · unfold gammaTwoThreeCuspHorocycleBoundary at hzHorocycle
      rcases Set.mem_iUnion.mp hzHorocycle with ⟨kappa, hzKappa⟩
      exact Set.mem_iUnion.2
        ⟨kappa, ⟨z, ⟨hzFrontier, hzKappa⟩, rfl⟩⟩
    · rcases gammaTwoThreeCuspTruncation_frontier_subset Y hzFrontier with
        hzSide | hzHorocycle'
      · have hzStage : z ∈ gammaTwoThreeCuspTruncation Y :=
          QYM.FullCertification.P2BoundaryComponentReduction.mem_truncation_of_mem_frontier hzFrontier
        exact False.elim
          (((mem_frontier_iff_notMem_interior
            (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.quotientMk_mem_XSet_of_mem Y hzStage)).mp hx)
            (hSide z ⟨⟨hzFrontier, hzSide⟩, hzHorocycle⟩))
      · exact False.elim (hzHorocycle hzHorocycle')
  · exact QYM.FullCertification.P2BoundaryComponentReduction.iUnion_cuspPieces_subset_frontier_XSet hHorocycle

/-! ## Exact reductions of nonemptiness, separation, and connectedness -/

/-- Nonemptiness stated before quotienting. -/
def UpstairsCuspFrontierPartsNonemptyAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp,
    (QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa).Nonempty

theorem quotientCuspPieces_nonempty_iff_upstairs (Y : ℝ) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesNonemptyAt Y ↔
      UpstairsCuspFrontierPartsNonemptyAt Y := by
  constructor
  · intro h kappa
    have hImage := h kappa
    change
      (gammaTwoQuotientMk ''
        QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa).Nonempty at hImage
    exact Set.image_nonempty.mp hImage
  · intro h kappa
    change
      (gammaTwoQuotientMk ''
        QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa).Nonempty
    exact Set.image_nonempty.mpr (h kappa)

/-- Exact orbit-separation statement.  Distinct cusp labels must never have
representatives with the same effective quotient class. -/
def NoCrossCuspOrbitAt (Y : ℝ) : Prop :=
  ∀ kappa lambda : GammaTwoCusp, kappa ≠ lambda →
    ∀ z ∈ QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa,
      ∀ w ∈ QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y lambda,
        gammaTwoQuotientMk z ≠ gammaTwoQuotientMk w

theorem quotientCuspPieces_pairwiseDisjoint_iff_noCrossOrbit
    (Y : ℝ) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesPairwiseDisjointAt Y ↔
      NoCrossCuspOrbitAt Y := by
  constructor
  · intro hDisjoint kappa lambda hne z hz w hw hEq
    have hzImage :
        gammaTwoQuotientMk z ∈
          QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y kappa :=
      ⟨z, hz, rfl⟩
    have hwImage :
        gammaTwoQuotientMk z ∈
          QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y lambda :=
      ⟨w, hw, hEq.symm⟩
    exact Set.disjoint_left.mp (hDisjoint kappa lambda hne)
      hzImage hwImage
  · intro hOrbit kappa lambda hne
    refine Set.disjoint_left.mpr ?_
    intro x hxKappa hxLambda
    rcases hxKappa with ⟨z, hz, hzx⟩
    rcases hxLambda with ⟨w, hw, hwx⟩
    exact hOrbit kappa lambda hne z hz w hw
      (hzx.trans hwx.symm)

/-- A sufficient connectedness input before quotienting.  Proving this
requires an actual interval/arc description with its paired endpoints; no
such description is supplied by mere finite frontier parametrization. -/
def UpstairsCuspFrontierPartsConnectedAt (Y : ℝ) : Prop :=
  ∀ kappa : GammaTwoCusp,
    IsConnected (QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa)

theorem quotientCuspPieces_connected_of_upstairs
    {Y : ℝ}
    (hConnected : UpstairsCuspFrontierPartsConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt Y := by
  intro kappa
  change IsConnected
    (gammaTwoQuotientMk '' QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa)
  exact (hConnected kappa).image gammaTwoQuotientMk
    gammaTwoQuotientMk_isOpenQuotientMap.continuous.continuousOn

theorem quotientCuspPieces_nonempty_of_upstairsConnected
    {Y : ℝ}
    (hConnected : UpstairsCuspFrontierPartsConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesNonemptyAt Y := by
  intro kappa
  exact (quotientCuspPieces_connected_of_upstairs hConnected kappa).nonempty

/-- Strongest exact-three reduction obtainable from the frozen API.  Each
hypothesis is a concrete geometric proposition; none is hidden in a
certificate structure. -/
theorem exactThreeCuspBoundaryDecomposition_of_corrected_inputs
    {Y : ℝ}
    (hSide : PairedSidesAwayFromHorocyclesBecomeInteriorAt Y)
    (hCuspExterior : CuspSaturationRemainsNonInteriorAt Y)
    (hOrbitSeparation : NoCrossCuspOrbitAt Y)
    (hUpstairsConnected : UpstairsCuspFrontierPartsConnectedAt Y) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y := by
  have hHorocycle : QYM.FullCertification.P2BoundaryComponentReduction.HorocyclesRemainBoundaryAt Y :=
    (horocyclesRemainBoundary_iff_cuspSaturationNonInterior Y).mpr
      hCuspExterior
  exact
    ⟨quotientCuspPieces_nonempty_of_upstairsConnected hUpstairsConnected,
      (quotientCuspPieces_pairwiseDisjoint_iff_noCrossOrbit Y).mpr
        hOrbitSeparation,
      quotientCuspPieces_connected_of_upstairs hUpstairsConnected,
      frontier_XSet_eq_iUnion_cuspPieces_corrected hSide hHorocycle⟩

/-! ## The normalized cutoff freezes below one -/

/-- For comparison, the genuinely unclipped raw convention has an empty
frontier at every nonpositive cutoff, so its exact-three assertion is
impossible there. -/
theorem not_rawExactThreeCuspBoundaryDecomposition_of_nonpos
    {Y : ℝ} (hY : Y ≤ 0) :
    ¬ QYM.FullCertification.P2BoundaryComponentReduction.RawExactThreeCuspBoundaryDecompositionAt Y :=
  QYM.FullCertification.P2BoundaryComponentReduction.not_rawExactThreeCuspBoundaryDecomposition_of_nonpos hY

theorem rawExactThreeCuspBoundaryDecomposition_requires_positive
    {Y : ℝ}
    (hExact : QYM.FullCertification.P2BoundaryComponentReduction.RawExactThreeCuspBoundaryDecompositionAt Y) :
    0 < Y :=
  QYM.FullCertification.P2BoundaryComponentReduction.zero_lt_of_rawExactThreeCuspBoundaryDecomposition hExact

/-- The implemented truncation uses `max 1 Y`, so every cutoff at or below
one has exactly level one. -/
theorem gammaTwoCuspLevel_eq_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) :
    gammaTwoCuspLevel Y = 1 :=
  max_eq_left hY

/-- Consequently all normalized literal stages with `Y ≤ 1` are the same
stage.  This is why a theorem about an *unclipped* cutoff cannot silently be
stated for the normalized implementation. -/
theorem threeCuspTruncation_eq_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) :
    gammaTwoThreeCuspTruncation Y =
      gammaTwoThreeCuspTruncation 1 := by
  ext z
  rw [mem_gammaTwoThreeCuspTruncation_iff,
    mem_gammaTwoThreeCuspTruncation_iff,
    gammaTwoCuspLevel_eq_one_of_le_one hY,
    gammaTwoCuspLevel_of_one_le (Y := (1 : ℝ)) le_rfl]

theorem XSet_eq_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) :
    QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet Y = QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet 1 := by
  unfold QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.XSet
  rw [threeCuspTruncation_eq_at_one_of_le_one hY]

theorem cuspClassHorocycleBoundary_eq_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) (kappa : GammaTwoCusp) :
    gammaTwoCuspClassHorocycleBoundary kappa Y =
      gammaTwoCuspClassHorocycleBoundary kappa 1 := by
  unfold gammaTwoCuspClassHorocycleBoundary
  rw [gammaTwoCuspLevel_eq_one_of_le_one hY,
    gammaTwoCuspLevel_of_one_le (Y := (1 : ℝ)) le_rfl]

theorem literalCuspFrontierPart_eq_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) (kappa : GammaTwoCusp) :
    QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart Y kappa =
      QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart 1 kappa := by
  unfold QYM.FullCertification.P2BoundaryComponentReduction.literalCuspFrontierPart
  rw [threeCuspTruncation_eq_at_one_of_le_one hY,
    cuspClassHorocycleBoundary_eq_at_one_of_le_one hY kappa]

theorem quotientCuspBoundaryPiece_eq_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) (kappa : GammaTwoCusp) :
    QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece Y kappa =
      QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece 1 kappa := by
  unfold QYM.FullCertification.P2BoundaryComponentReduction.quotientCuspBoundaryPiece
  rw [literalCuspFrontierPart_eq_at_one_of_le_one hY kappa]

/-- The whole exact-three proposition is constant throughout the normalized
range `Y ≤ 1`.  Positivity or regularity for an unclipped raw cutoff must be
handled separately; the raw nonpositive no-go theorem cannot be transferred
by pretending the two conventions coincide. -/
theorem exactThreeCuspBoundaryDecomposition_iff_at_one_of_le_one
    {Y : ℝ} (hY : Y ≤ 1) :
    QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt Y ↔
      QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt 1 := by
  unfold QYM.FullCertification.P2BoundaryComponentReduction.ExactThreeCuspBoundaryDecompositionAt
  unfold QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesNonemptyAt
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesPairwiseDisjointAt
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesConnectedAt
    QYM.FullCertification.P2BoundaryComponentReduction.CuspBoundaryPiecesCoverFrontierAt
  simp_rw [quotientCuspBoundaryPiece_eq_at_one_of_le_one hY]
  rw [XSet_eq_at_one_of_le_one hY]

end QYM.FullCertification.P2ExactThreeBoundaryExtension

