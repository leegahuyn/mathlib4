/-- The literal `L2` indicator of the open escape band. -/
noncomputable def actualCutoffEscapeWitness
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) : ActualGlobalL2 :=
  MeasureTheory.indicatorConstLp 2
    (actualCutoffEscapeOpenSet_isOpen n).measurableSet
    (actualCutoffEscapeOpenSet_measure_lt_top n).ne
    (1 : ℂ)

theorem actualCutoffEscapeWitness_ne_zero
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) (n : ℕ) :
    actualCutoffEscapeWitness q n ≠ 0 := by
  have hMeasurePos := actualCutoffEscapeOpenSet_measure_pos q n
