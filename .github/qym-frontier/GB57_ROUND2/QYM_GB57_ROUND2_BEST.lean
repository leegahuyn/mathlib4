   .hypA_4MassCoercivityNoGo,
   .hypA_6FormDominationNoGo]

/-- Canonical certificates for all identifiers. -/
def allCertificates : List Certificate :=
  allEvidence.map certificate

theorem allEvidence_length : allEvidence.length = 23 := by
  decide

theorem allCertificates_length : allCertificates.length = 23 := by
  decide

theorem allEvidence_nodup : allEvidence.Nodup := by
  decide

theorem allEvidence_complete (evidence : EvidenceId) :
    evidence ∈ allEvidence := by
  cases evidence <;> simp [allEvidence]

theorem allCertificates_ids :
    allCertificates.map Certificate.id = allEvidence := by
  simp only [allCertificates, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) allEvidence = allEvidence
  rfl

/-! ## Non-terminal links to the twenty-three claim rows -/

/-- Each previously unlinked row receives exactly one identifier.  An identifier may package
several compatible positive and negative boundary facts in its exact proposition. -/
def evidenceForClaim : ClaimId → List EvidenceId
  | .prop2_2 => [.prop2_2Locality]
  | .axiomA3M => [.axiomA3MMassCoercivityNoGo]
  | .axiomA3V => [.axiomA3VAbsorptionNoGo]
  | .axiomA3R => [.axiomA3RTailUniformityNoGo]
