      (QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaDirichletBackground sector cutoff).boundaryCondition =
        .dirichlet ∧
      (a ∈ QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.DeckCovariantCoulombGaugeSlice
          cutoff deckPullback divergence ↔ divergence a = 0) ∧
      (QYM.FullCertification.P2GreenBoundaryStokesReductionExtension.ActualHighCutoffDivergenceBoundaryEqualityResidual ↔
        ActualCompactFluxBulkDivergenceZero) := by
  exact
    ⟨QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaDirichletBackground_fieldKind sector cutoff,
      QYM.FullCertification.P1AdmissibleBackgroundExtension.inverseEtaDirichletBackground_boundary sector cutoff,
      QYM.FullCertification.P1MatterGaugeDirichletFirewallExtension.mem_deckCovariantCoulombGaugeSlice_iff
        cutoff deckPullback divergence a,
      actualHighCutoffResidual_iff_everyCompactFluxBulkDivergence_zero⟩

