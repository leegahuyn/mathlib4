namespace QYM.FullCertification.P2GammaTwoFreeActionExtension




/-!
# Freeness of the effective `Gamma(2)` action

The principal congruence subgroup `Gamma(2)` contains the central matrices
`±1`, so its raw action on the upper half-plane is not free.  The effective
group used by the project is the image of that action in `Equiv.Perm ℍ`; the
two central matrices have therefore already been identified.

This file proves the missing arithmetic fact rather than storing it as a
certificate.  The proof moves a fixed point into Mathlib's closed modular
fundamental domain, conjugates inside the normal subgroup `Gamma(2)`, uses
Mathlib's complete finite list `cases_of_mem_fd_smul_mem_fd`, and eliminates
every noncentral entry of that list by reduction modulo two.  It follows
that the effective action is free and hence that the orbit projection is a
genuine global covering map and local homeomorphism.
-/

abbrev EffectiveGroup : Type := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoEffective

abbrev EffectiveQuotient : Type := Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoQuotient

/-! ## 1. Stabilizers inside the closed modular fundamental domain -/

/-- A level-two matrix fixing a point of the closed modular fundamental
domain is central.  All exceptional elliptic alternatives in the modular
stabilizer classification have a matrix entry different from the identity
modulo two. -/
theorem gammaTwo_matrix_eq_one_or_neg_one_of_mem_fd_fixed
    {gamma : SL(2, ℤ)} {z : ℍ}
    (hGamma : gamma ∈ CongruenceSubgroup.Gamma 2)
    (hz : z ∈ ModularGroup.fd)
    (hfix : gamma • z = z) :
    gamma = 1 ∨ gamma = -1 := by
  have hentries :
      ((gamma 0 0 : ℤ) : ZMod 2) = 1 ∧
        ((gamma 0 1 : ℤ) : ZMod 2) = 0 ∧
          ((gamma 1 0 : ℤ) : ZMod 2) = 0 ∧
            ((gamma 1 1 : ℤ) : ZMod 2) = 1 :=
    CongruenceSubgroup.Gamma_mem.mp hGamma
  rcases ModularGroup.cases_of_mem_fd_smul_mem_fd hz (hfix ▸ hz) with
    hcentral | hT | hTinv | hS | hTS | hTinvSTinv |
      hSTinv | hST | hTST | hTinvS
  · exact hcentral
  all_goals
    rcases ‹(_ ∨ _) ∧ _› with ⟨hMatrix, _⟩
    rcases hMatrix with rfl | rfl
    all_goals
      norm_num [ModularGroup.coe_S, ModularGroup.coe_T,
        ModularGroup.coe_T_inv, Matrix.SpecialLinearGroup.coe_neg,
        Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply,
        Fin.sum_univ_two] at hentries

/-! ## 2. Arbitrary fixed points -/

/-- Every level-two matrix fixing an arbitrary upper-half-plane point is
`1` or `-1`.  Normality of the principal congruence subgroup is essential:
the matrix used to move the point into the modular fundamental domain need
not itself belong to `Gamma(2)`. -/
theorem gammaTwo_matrix_eq_one_or_neg_one_of_fixed
    (gamma : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwo) (z : ℍ) (hfix : gamma • z = z) :
    (gamma : SL(2, ℤ)) = 1 ∨ (gamma : SL(2, ℤ)) = -1 := by
  obtain ⟨a, ha⟩ := ModularGroup.exists_smul_mem_fd z
  let delta : SL(2, ℤ) := a * (gamma : SL(2, ℤ)) * a⁻¹
  have hDeltaGamma :
      delta ∈ CongruenceSubgroup.Gamma 2 := by
    exact (CongruenceSubgroup.Gamma_normal 2).conj_mem
      (gamma : SL(2, ℤ)) gamma.property a
  have hfix' : (gamma : SL(2, ℤ)) • z = z := by
    change gamma • z = z
    exact hfix
  have hDeltaFix : delta • (a • z) = a • z := by
    simp [delta, mul_smul, hfix', mul_assoc]
  rcases gammaTwo_matrix_eq_one_or_neg_one_of_mem_fd_fixed
      hDeltaGamma ha hDeltaFix with hDelta | hDelta
  · left
    have h := congrArg (fun x : SL(2, ℤ) ↦ a⁻¹ * x * a) hDelta
    simpa [delta, mul_assoc] using h
  · right
    have h := congrArg (fun x : SL(2, ℤ) ↦ a⁻¹ * x * a) hDelta
    simpa [delta, mul_assoc] using h

/-! ## 3. Freeness after passing to the faithful permutation image -/

/-- An effective transformation fixing one upper-half-plane point is the
identity permutation.  The two possible arithmetic representatives `±1`
act identically, exactly as required by the effective-image construction.
-/
theorem gammaTwoEffective_eq_one_of_smul_eq
    (g : EffectiveGroup) (z : ℍ) (hfix : g • z = z) :
    g = 1 := by
  rcases Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.effective_exists_gamma g with ⟨gamma, hRepresentative⟩
  have hGammaFix : gamma • z = z := by
    calc
      gamma • z = g • z := (hRepresentative z).symm
      _ = z := hfix
  rcases gammaTwo_matrix_eq_one_or_neg_one_of_fixed
      gamma z hGammaFix with hOne | hNegOne
  · apply Subtype.ext
    apply Equiv.ext
    intro w
    change g • w = w
    have hgw : g • w = (gamma : SL(2, ℤ)) • w :=
      hRepresentative w
    calc
      g • w = (gamma : SL(2, ℤ)) • w := hgw
      _ = (1 : SL(2, ℤ)) • w := by rw [hOne]
      _ = w := one_smul _ _
  · apply Subtype.ext
    apply Equiv.ext
    intro w
    change g • w = w
    have hgw : g • w = (gamma : SL(2, ℤ)) • w :=
      hRepresentative w
    calc
      g • w = (gamma : SL(2, ℤ)) • w := hgw
      _ = (-1 : SL(2, ℤ)) • w := by rw [hNegOne]
      _ = (1 : SL(2, ℤ)) • w :=
        ModularGroup.SL_neg_smul (g := (1 : SL(2, ℤ))) (z := w)
      _ = w := one_smul _ _

/-- The faithful effective level-two action is genuinely free. -/
noncomputable instance gammaTwoEffective_isCancelSMul :
    IsCancelSMul EffectiveGroup ℍ :=
  isCancelSMul_iff_eq_one_of_smul_eq.mpr
    gammaTwoEffective_eq_one_of_smul_eq

/-- Every effective stabilizer is trivial, globally rather than only on a
regular locus. -/
theorem gammaTwoEffective_stabilizer_eq_bot (z : ℍ) :
    MulAction.stabilizer EffectiveGroup z = ⊥ :=
  IsCancelSMul.stabilizer_eq_bot z

/-! ## 4. Global covering consequences -/

/-- The actual effective orbit projection is a global covering map. -/
theorem gammaTwoQuotientMk_isCoveringMap :
    IsCoveringMap Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk := by
  simpa only [Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk, Quotient.mk''_eq_mk] using
    (isQuotientCoveringMap_quotientMk_of_properlyDiscontinuousSMul
      (G := EffectiveGroup) (E := ℍ)).isCoveringMap

/-- Consequently the orbit projection is a global local homeomorphism. -/
theorem gammaTwoQuotientMk_isLocalHomeomorph :
    IsLocalHomeomorph Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk :=
  gammaTwoQuotientMk_isCoveringMap.isLocalHomeomorph

/-- Every quotient point has an evenly covered neighbourhood. -/
theorem gammaTwoQuotientMk_evenlyCovered
    (x : EffectiveQuotient) :
    IsEvenlyCovered Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk x
      (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ⁻¹' {x}) :=
  gammaTwoQuotientMk_isCoveringMap x

/-! ## 5. An actual quotient atlas at the topological charted-space level -/

/-- A chosen upper-half-plane lift of a quotient point.  Every use is tied
to the proved equation below, so no representative-dependent theorem is
introduced. -/
noncomputable def quotientLift (x : EffectiveQuotient) : ℍ :=
  Classical.choose
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.surjective x)

@[simp]
theorem quotientLift_spec (x : EffectiveQuotient) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk (quotientLift x) = x :=
  Classical.choose_spec
    (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk_isOpenQuotientMap.surjective x)

/-- The local homeomorphism supplied by the proved global covering at one
chosen upstairs point. -/
noncomputable def upstairsLocalHomeomorphAt (z : ℍ) :
    OpenPartialHomeomorph ℍ EffectiveQuotient :=
  Classical.choose (gammaTwoQuotientMk_isLocalHomeomorph z)

theorem upstairsLocalHomeomorphAt_mem_source (z : ℍ) :
    z ∈ (upstairsLocalHomeomorphAt z).source :=
  (Classical.choose_spec
    (gammaTwoQuotientMk_isLocalHomeomorph z)).1

theorem upstairsLocalHomeomorphAt_eq_projection (z : ℍ) :
    Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk = upstairsLocalHomeomorphAt z :=
  (Classical.choose_spec
    (gammaTwoQuotientMk_isLocalHomeomorph z)).2

/-- The inverse of a covering sheet at a chosen lift is a genuine quotient
chart into the upper half-plane. -/
noncomputable def quotientChartAtH (x : EffectiveQuotient) :
    OpenPartialHomeomorph EffectiveQuotient ℍ :=
  (upstairsLocalHomeomorphAt (quotientLift x)).symm

/-- The centre belongs to the source of its chosen quotient chart. -/
theorem mem_quotientChartAtH_source (x : EffectiveQuotient) :
    x ∈ (quotientChartAtH x).source := by
  change x ∈
    (upstairsLocalHomeomorphAt (quotientLift x)).target
  have hMap :=
    (upstairsLocalHomeomorphAt (quotientLift x)).map_source
      (upstairsLocalHomeomorphAt_mem_source (quotientLift x))
  rw [← upstairsLocalHomeomorphAt_eq_projection (quotientLift x)] at hMap
  simpa using hMap

/-- The covering sheets form a concrete topological atlas modelled on `ℍ`.
This is a `ChartedSpace` construction, not yet a claim that all chart
transitions have been certified smooth. -/
noncomputable def gammaTwoQuotientChartedSpaceH :
    ChartedSpace ℍ EffectiveQuotient where
  atlas := Set.range quotientChartAtH
  chartAt := quotientChartAtH
  mem_chart_source := mem_quotientChartAtH_source
  chart_mem_atlas x := ⟨x, rfl⟩

/-- Register the actual covering-sheet atlas on the effective quotient. -/
noncomputable instance gammaTwoQuotient_chartedSpaceH :
    ChartedSpace ℍ EffectiveQuotient :=
  gammaTwoQuotientChartedSpaceH

/-- Composing the covering-sheet charts with Mathlib's existing complex
atlas on `ℍ` gives an explicit complex-modelled topological atlas. -/
noncomputable instance gammaTwoQuotient_chartedSpaceComplex :
    ChartedSpace ℂ EffectiveQuotient :=
  ChartedSpace.comp ℂ ℍ EffectiveQuotient

/-- The chosen chart really maps its centre to its chosen lift. -/
theorem quotientChartAtH_apply_center (x : EffectiveQuotient) :
    quotientChartAtH x x = quotientLift x := by
  apply (upstairsLocalHomeomorphAt (quotientLift x)).injOn
  · exact (quotientChartAtH x).map_source
      (mem_quotientChartAtH_source x)
  · exact upstairsLocalHomeomorphAt_mem_source (quotientLift x)
  · change
      (upstairsLocalHomeomorphAt (quotientLift x))
          ((upstairsLocalHomeomorphAt (quotientLift x)).symm x) =
        (upstairsLocalHomeomorphAt (quotientLift x)) (quotientLift x)
    rw [(upstairsLocalHomeomorphAt (quotientLift x)).right_inv
        (mem_quotientChartAtH_source x)]
    rw [← upstairsLocalHomeomorphAt_eq_projection (quotientLift x)]
    exact (quotientLift_spec x).symm

/-- Aggregate arithmetic/topological endpoint. -/
theorem gammaTwoEffectiveFreeCoveringCertificate :
    IsCancelSMul EffectiveGroup ℍ ∧
      (∀ z : ℍ, MulAction.stabilizer EffectiveGroup z = ⊥) ∧
      IsCoveringMap Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk ∧
      IsLocalHomeomorph Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoQuotientMk := by
  exact ⟨inferInstance, gammaTwoEffective_stabilizer_eq_bot,
    gammaTwoQuotientMk_isCoveringMap,
    gammaTwoQuotientMk_isLocalHomeomorph⟩

end QYM.FullCertification.P2GammaTwoFreeActionExtension

