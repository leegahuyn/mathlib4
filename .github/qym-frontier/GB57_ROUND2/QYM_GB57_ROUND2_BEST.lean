  exact ⟨quotientNamedCuspHorocycleImage_isCompact kappa Y,
    quotientNamedCuspHorocycleMeasure_univ kappa Y,
    quotientNamedCuspHorocycleMeasure_compl_image kappa Y⟩

/-- Aggregate unconditional measure endpoint. -/
theorem quotientWidthTwoHorocycleMeasureCertificate
    (H : ℝ) (hH : 0 < H) :
