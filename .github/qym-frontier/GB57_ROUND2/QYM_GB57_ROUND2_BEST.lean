open Function Set Topology
open scoped MatrixGroups UpperHalfPlane


namespace QYM.FullCertification.P2RawFullPreimageNogoExtension






open Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry

/-!
# The raw quotient preimage cannot be compact

The concrete cusp-geometry certificate deliberately proves compactness only
after intersecting a quotient preimage with its selected closed tile carrier.
This file proves that this restriction is logically necessary: the full
inverse image of even one quotient point contains all width-two parabolic
translates of `UpperHalfPlane.I`, hence has an unbounded real coordinate and
cannot be compact.

The argument uses only the explicit `Gamma(2)` cusp translation already
constructed in the frozen dependency and elementary compactness in `ℝ`.
-/

/-! ## The explicit deck-translation orbit -/

/-- The width-two translation at infinity, bundled as an element of
`Gamma(2)`. -/
def infinityDeckTranslation (n : ℤ) : GammaTwo :=
  ⟨gammaTwoCuspTranslation .atInfinity n,
    gammaTwoCuspTranslation_mem .atInfinity n⟩

/-- At the infinity cusp the chosen scaling matrix is the identity, so the
cusp translation is exactly `T^(2n)`. -/
theorem gammaTwoCuspTranslation_atInfinity_eq_T_zpow (n : ℤ) :
    gammaTwoCuspTranslation .atInfinity n =
      ModularGroup.T ^ (2 * n) := by
  simp [gammaTwoCuspTranslation]

/-- Forgetting the subgroup proof recovers the concrete cusp translation. -/
@[simp]
theorem coe_infinityDeckTranslation (n : ℤ) :
    ((infinityDeckTranslation n : GammaTwo) : SL(2, ℤ)) =
      gammaTwoCuspTranslation .atInfinity n :=
  rfl

/-- The bundled and unbundled translations induce the same action on the
upper half-plane. -/
theorem infinityDeckTranslation_smul (n : ℤ) (z : ℍ) :
    infinityDeckTranslation n • z =
      gammaTwoCuspTranslation .atInfinity n • z :=
  rfl

/-- The real part of the translated base point is exactly the width-two
integer displacement. -/
theorem infinityDeckTranslation_re_I (n : ℤ) :
    (infinityDeckTranslation n • UpperHalfPlane.I).re =
      ((2 * n : ℤ) : ℝ) := by
  rw [infinityDeckTranslation_smul,
    gammaTwoCuspTranslation_atInfinity_eq_T_zpow,
    UpperHalfPlane.modular_T_zpow_smul]
  simp

/-- Natural-number form of `infinityDeckTranslation_re_I`, convenient for
the Archimedean contradiction below. -/
theorem infinityDeckTranslation_nat_re_I (n : ℕ) :
    (infinityDeckTranslation (n : ℤ) • UpperHalfPlane.I).re =
      2 * (n : ℝ) := by
  simpa only [Int.cast_mul, Int.cast_ofNat, Int.cast_natCast] using
    infinityDeckTranslation_re_I (n : ℤ)

/-! ## Every translate lies above one quotient point -/

/-- The singleton quotient orbit used in the counterexample. -/
def baseOrbitSingleton : Set GammaTwoQuotient :=
  {gammaTwoQuotientMk UpperHalfPlane.I}

/-- Every width-two translate of `I` belongs to the full inverse image of the
single quotient point represented by `I`. -/
theorem infinityDeckTranslation_mem_baseOrbitPreimage (n : ℤ) :
    infinityDeckTranslation n • UpperHalfPlane.I ∈
      gammaTwoQuotientMk ⁻¹' baseOrbitSingleton := by
  change gammaTwoQuotientMk
      (infinityDeckTranslation n • UpperHalfPlane.I) =
    gammaTwoQuotientMk UpperHalfPlane.I
  exact gammaTwoQuotientMk_gamma_smul
    (infinityDeckTranslation n) UpperHalfPlane.I

/-- Consequently every even natural number occurs in the real-coordinate
image of the singleton orbit preimage. -/
theorem two_mul_nat_mem_re_image_baseOrbitPreimage (n : ℕ) :
    2 * (n : ℝ) ∈
      (fun z : ℍ => z.re) ''
        (gammaTwoQuotientMk ⁻¹' baseOrbitSingleton) := by
  exact ⟨infinityDeckTranslation (n : ℤ) • UpperHalfPlane.I,
    infinityDeckTranslation_mem_baseOrbitPreimage (n : ℤ),
    infinityDeckTranslation_nat_re_I n⟩

/-! ## Compactness contradiction -/

/-- The real-coordinate image of the singleton full preimage is unbounded.
This is the precise elementary obstruction behind failure of raw properness. -/
theorem not_isBounded_re_image_baseOrbitPreimage :
    ¬ Bornology.IsBounded
      ((fun z : ℍ => z.re) ''
        (gammaTwoQuotientMk ⁻¹' baseOrbitSingleton)) := by
  intro hBounded
  obtain ⟨R, hR⟩ :=
    (Metric.isBounded_iff_subset_ball (0 : ℝ)).mp hBounded
  obtain ⟨n : ℕ, hn⟩ := exists_nat_gt R
  have hball :
      2 * (n : ℝ) ∈ Metric.ball (0 : ℝ) R :=
    hR (two_mul_nat_mem_re_image_baseOrbitPreimage n)
  have htwoNonneg : 0 ≤ 2 * (n : ℝ) :=
    mul_nonneg (by norm_num) (Nat.cast_nonneg n)
  have htwoLt : 2 * (n : ℝ) < R := by
    simpa only [Metric.mem_ball, Real.dist_eq, sub_zero,
      abs_of_nonneg htwoNonneg] using hball
  have hnNonneg : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
  linarith

/-- The full inverse image of the singleton base orbit is not compact. -/
theorem baseOrbitPreimage_not_isCompact :
    ¬ IsCompact (gammaTwoQuotientMk ⁻¹' baseOrbitSingleton) := by
  intro hCompact
  have hImageCompact :
      IsCompact
        ((fun z : ℍ => z.re) ''
          (gammaTwoQuotientMk ⁻¹' baseOrbitSingleton)) :=
    hCompact.image UpperHalfPlane.continuous_re
  exact not_isBounded_re_image_baseOrbitPreimage hImageCompact.isBounded

/-! ## Public no-go theorem -/

/-- Raw compact-preimage properness is false for the actual effective
`Gamma(2)` quotient.  In particular this proposition must never be added as
an input to the unconditional P2 certificate. -/
theorem not_rawFullQuotientPreimageCompactness :
    ¬ QYM.FullCertification.P2ConcreteCuspGeometryExtension.RawFullQuotientPreimageCompactness := by
  intro hRaw
  have hCompact :
      IsCompact (gammaTwoQuotientMk ⁻¹' baseOrbitSingleton) :=
    hRaw baseOrbitSingleton isCompact_singleton
  exact baseOrbitPreimage_not_isCompact hCompact

end QYM.FullCertification.P2RawFullPreimageNogoExtension

