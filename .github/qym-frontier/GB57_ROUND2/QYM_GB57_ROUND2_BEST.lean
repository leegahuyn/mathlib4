open Function Set Topology
open scoped Manifold ContDiff UpperHalfPlane

namespace QYM.FullCertification.P3InverseEtaSmoothTrivializationClosureExtension








/-!
# P3 closure: a transported smooth structure on the inverse-eta total space

This file closes the smooth-trivialization residual by making the atlas on the
total space explicit.  The construction is deliberately a *transported*
atlas.  First the global homeomorphism

`P3.inverseEtaTotalTrivializationHomeomorph :
    P3.InverseEtaTotal ≃ₜ P3.InverseEtaBase × ℂ`

is installed as a one-chart atlas with intermediate model
`P3.InverseEtaBase × ℂ`.  This is then composed, using
`ChartedSpace.comp`, with the product of the P2 smooth quotient atlas and the
standard complex atlas.  Therefore the preferred chart on the total space is
literally the global trivialization followed by the preferred product chart.

The two smoothness proofs below are not assumptions.  In the corresponding
extended charts their coordinate representatives agree locally with the
identity; `writtenInExtChartAt_chartAt_comp` and its inverse version are the
exact Mathlib lemmas which express those identities.

Semantic boundary: no theorem in this file claims that this transported
atlas agrees with any independently proposed smooth atlas on the quotient
total space.  Such a compatibility theorem would be a separate result.
-/

/-! ## 1. The unconditional P2 base atlas -/

/-- The inverse-eta base is definitionally the effective `Gamma(2)` quotient
constructed in P2. -/
abbrev InverseEtaBase := QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaBase

/-- The actual inverse-eta orbit-quotient total space. -/
abbrev InverseEtaTotal := QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaTotal

/-- The P2 all-covering-sheets atlas before composition with the standard
complex atlas of the upper half-plane. -/
noncomputable def inverseEtaBaseChartedSpaceH :
    ChartedSpace ℍ InverseEtaBase :=
  QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheetsChartedSpaceH

/-- The chosen complex smooth atlas on the inverse-eta base. -/
noncomputable def inverseEtaBaseChartedSpaceComplex :
    ChartedSpace ℂ InverseEtaBase := by
  letI : ChartedSpace ℍ InverseEtaBase :=
    inverseEtaBaseChartedSpaceH
  exact ChartedSpace.comp ℂ ℍ InverseEtaBase

/-- The chosen P2 base atlas has the ordinary smooth structure groupoid. -/
theorem inverseEtaBase_hasGroupoid :
    letI : ChartedSpace ℍ InverseEtaBase :=
      inverseEtaBaseChartedSpaceH
    letI : HasGroupoid InverseEtaBase
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid
        QYM.FullCertification.P2SmoothTransitionClosureExtension.smoothTransitionResidual
    letI : ChartedSpace ℂ InverseEtaBase :=
      ChartedSpace.comp ℂ ℍ InverseEtaBase
    HasGroupoid InverseEtaBase
      (contDiffGroupoid ∞ 𝓘(ℂ)) :=
  QYM.FullCertification.P2SmoothTransitionClosureExtension.allCoveringSheets_hasComplexGroupoid

/-- The chosen P2 base atlas is an unconditional complex smooth manifold. -/
theorem inverseEtaBase_isManifold :
    letI : ChartedSpace ℍ InverseEtaBase :=
      inverseEtaBaseChartedSpaceH
    letI : HasGroupoid InverseEtaBase
        QYM.FullCertification.P2SmoothQuotientAtlasExtension.upperHalfPlaneSmoothGroupoid :=
      QYM.FullCertification.P2SmoothQuotientAtlasExtension.allCoveringSheets_hasGroupoid
        QYM.FullCertification.P2SmoothTransitionClosureExtension.smoothTransitionResidual
    letI : ChartedSpace ℂ InverseEtaBase :=
      ChartedSpace.comp ℂ ℍ InverseEtaBase
    IsManifold 𝓘(ℂ) ∞ InverseEtaBase :=
  QYM.FullCertification.P2SmoothTransitionClosureExtension.gammaTwoQuotient_isManifold

/-! ## 2. The explicitly transported atlas on the total space -/

/-- The global trivialization, regarded as the unique intermediate chart.
Its source is all of the actual quotient total space. -/
noncomputable def inverseEtaTotalSingletonProductChartedSpace :
    ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
  QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.toOpenPartialHomeomorph
    |>.singletonChartedSpace (by simp)

/-- Compose the one-chart product atlas with the chosen product complex
atlas.  This is the transported smooth atlas used throughout this file. -/
noncomputable def inverseEtaTotalTransportedChartedSpace :
    ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
    inverseEtaTotalSingletonProductChartedSpace
  exact ChartedSpace.comp
    (ModelProd ℂ ℂ) (InverseEtaBase × ℂ) InverseEtaTotal

/-- The intermediate preferred chart is exactly the global homeomorphism. -/
@[simp] theorem inverseEtaTotalSingletonProduct_chartAt
    (u : InverseEtaTotal) :
    @chartAt (InverseEtaBase × ℂ) _ InverseEtaTotal _
        inverseEtaTotalSingletonProductChartedSpace u =
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.toOpenPartialHomeomorph :=
  rfl

/-- Exact preferred-chart formula for the transported atlas. -/
theorem inverseEtaTotalTransported_chartAt
    (u : InverseEtaTotal) :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    @chartAt (ModelProd ℂ ℂ) _ InverseEtaTotal _
        inverseEtaTotalTransportedChartedSpace u =
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.toOpenPartialHomeomorph.trans
        (chartAt (ModelProd ℂ ℂ)
          (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph u)) := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
    inverseEtaTotalSingletonProductChartedSpace
  rfl

/-- The target of a transported extended chart is exactly the target of the
corresponding product extended chart.  The extra intermediate chart imposes
no restriction because it is a global homeomorphism. -/
theorem inverseEtaTotalTransported_extChartAt_target
    (u : InverseEtaTotal) :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target =
      (extChartAt (𝓘(ℂ).prod 𝓘(ℂ))
        (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph u)).target := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
    inverseEtaTotalSingletonProductChartedSpace
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    ChartedSpace.comp
      (ModelProd ℂ ℂ) (InverseEtaBase × ℂ) InverseEtaTotal
  rw [extChartAt_comp]
  simp only [PartialEquiv.trans_target,
    Homeomorph.toOpenPartialHomeomorph_target,
    preimage_univ, inter_univ]

/-! ## 3. The forward and inverse coordinate identities -/

/-- On the target of every transported extended chart, the forward global
trivialization is represented by the identity map. -/
theorem inverseEta_forward_writtenInExtChartAt_eq_id
    (u : InverseEtaTotal) {z : ℂ × ℂ}
    (hz :
      letI : ChartedSpace ℂ InverseEtaBase :=
        inverseEtaBaseChartedSpaceComplex
      letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
        inverseEtaTotalTransportedChartedSpace
      z ∈ (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target) :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    writtenInExtChartAt (𝓘(ℂ).prod 𝓘(ℂ))
        (𝓘(ℂ).prod 𝓘(ℂ)) u
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph z = z := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
    inverseEtaTotalSingletonProductChartedSpace
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    ChartedSpace.comp
      (ModelProd ℂ ℂ) (InverseEtaBase × ℂ) InverseEtaTotal
  exact writtenInExtChartAt_chartAt_comp u hz

/-- On the same chart target, the inverse global trivialization is also
represented by the identity map. -/
theorem inverseEta_inverse_writtenInExtChartAt_eq_id
    (u : InverseEtaTotal) {z : ℂ × ℂ}
    (hz :
      letI : ChartedSpace ℂ InverseEtaBase :=
        inverseEtaBaseChartedSpaceComplex
      letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
        inverseEtaTotalTransportedChartedSpace
      z ∈ (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target) :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    writtenInExtChartAt (𝓘(ℂ).prod 𝓘(ℂ))
        (𝓘(ℂ).prod 𝓘(ℂ))
        (QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph u)
        QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.symm z = z := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (InverseEtaBase × ℂ) InverseEtaTotal :=
    inverseEtaTotalSingletonProductChartedSpace
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    ChartedSpace.comp
      (ModelProd ℂ ℂ) (InverseEtaBase × ℂ) InverseEtaTotal
  exact writtenInExtChartAt_chartAt_symm_comp u hz

/-! ## 4. Unconditional smoothness and the residual inhabitant -/

/-- The forward global trivialization is smooth for the transported atlas. -/
theorem inverseEtaTotalTrivialization_contMDiff :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    ContMDiff (𝓘(ℂ).prod 𝓘(ℂ)) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    inverseEtaTotalTransportedChartedSpace
  intro u
  rw [contMDiffAt_iff]
  refine
    ⟨QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.continuous.continuousAt,
      ?_⟩
  apply contDiffWithinAt_id.congr_of_eventuallyEq
  · filter_upwards
      [extChartAt_target_mem_nhdsWithin u] with z hz
    exact inverseEta_forward_writtenInExtChartAt_eq_id u hz
  · exact inverseEta_forward_writtenInExtChartAt_eq_id u (by simp)

/-- The inverse global trivialization is smooth for the transported atlas. -/
theorem inverseEtaTotalTrivialization_symm_contMDiff :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    ContMDiff (𝓘(ℂ).prod 𝓘(ℂ)) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.symm := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    inverseEtaTotalTransportedChartedSpace
  intro p
  rw [contMDiffAt_iff]
  refine
    ⟨QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.symm.continuous.continuousAt,
      ?_⟩
  let u : InverseEtaTotal :=
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.symm p
  have hup : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph u = p :=
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.apply_symm_apply p
  have htarget :
      (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target =
        (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) p).target := by
    simpa only [hup] using
      inverseEtaTotalTransported_extChartAt_target u
  apply contDiffWithinAt_id.congr_of_eventuallyEq
  · filter_upwards
      [extChartAt_target_mem_nhdsWithin p] with z hz
    have hzu : z ∈
        (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target := by
      rwa [htarget]
    simpa only [u, hup] using
      inverseEta_inverse_writtenInExtChartAt_eq_id u hzu
  · have hzu : extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) p p ∈
        (extChartAt (𝓘(ℂ).prod 𝓘(ℂ)) u).target := by
      rw [htarget]
      simp
    simpa only [u, hup] using
      inverseEta_inverse_writtenInExtChartAt_eq_id u hzu

/-- The residual left by P3 is unconditionally inhabited once its total
space is equipped with the explicitly transported atlas above. -/
theorem inverseEtaSmoothGlobalTrivializationResidual :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaSmoothGlobalTrivializationResidual :=
  ⟨inverseEtaTotalTrivialization_contMDiff,
    inverseEtaTotalTrivialization_symm_contMDiff⟩

/-- The actual quotient total space is smoothly equivalent to the trivial
product for the chosen transported atlas. -/
noncomputable def inverseEtaTotalTrivializationDiffeomorph :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    InverseEtaTotal ≃ₘ⟮𝓘(ℂ).prod 𝓘(ℂ), 𝓘(ℂ).prod 𝓘(ℂ)⟯
      (InverseEtaBase × ℂ) where
  toEquiv := QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph.toEquiv
  contMDiff_toFun := inverseEtaTotalTrivialization_contMDiff
  contMDiff_invFun := inverseEtaTotalTrivialization_symm_contMDiff

/-! ## 5. Minimal smooth bundle API -/

/-- The actual quotient projection is smooth for the transported atlas. -/
theorem inverseEtaProjection_contMDiff :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    ContMDiff (𝓘(ℂ).prod 𝓘(ℂ)) 𝓘(ℂ) ∞
      QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaProjection := by
  letI : ChartedSpace ℂ InverseEtaBase :=
    inverseEtaBaseChartedSpaceComplex
  letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
    inverseEtaTotalTransportedChartedSpace
  simpa only [Function.comp_apply,
    QYM.FullCertification.P3InverseEtaQuotientBundleExtension.inverseEtaTotalTrivializationHomeomorph_fst] using
    (contMDiff_fst.comp inverseEtaTotalTrivialization_contMDiff)

/-- A quotient section together with smoothness for the chosen transported
atlas.  The section law is inherited from P3's actual quotient-section type. -/
structure SmoothInverseEtaQuotientSection where
  toQuotientSection : QYM.FullCertification.P3InverseEtaQuotientBundleExtension.InverseEtaQuotientSection
  contMDiff_toFun :
    letI : ChartedSpace ℂ InverseEtaBase :=
      inverseEtaBaseChartedSpaceComplex
    letI : ChartedSpace (ModelProd ℂ ℂ) InverseEtaTotal :=
      inverseEtaTotalTransportedChartedSpace
    ContMDiff 𝓘(ℂ) (𝓘(ℂ).prod 𝓘(ℂ)) ∞
      toQuotientSection.toFun

namespace SmoothInverseEtaQuotientSection

instance : CoeFun SmoothInverseEtaQuotientSection
