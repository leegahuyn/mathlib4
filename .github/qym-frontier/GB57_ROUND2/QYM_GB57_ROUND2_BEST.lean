/-!
# P4: the actual finite-stage `L²` carrier is not finite dimensional

The actual compact stage still contains an open one-sided cusp collar.  Its
height interval is a nondegenerate real `Ioc`, hence infinite.  We embed an
arbitrary finite index type `Fin n` into this literal collar and then into the
actual quotient stage.  Normality of the compact Hausdorff stage supplies
continuous Urysohn functions with Kronecker evaluation on those points.

These functions form a linearly independent family in `C(I.X Y, ℂ)`.  The
already proved full-support injectivity of the continuous-to-`L²` map sends
them to an equally large linearly independent family in the genuine
Petersson `L²` carrier.  Choosing `n = finrank + 1` refutes finite
dimensionality without any dimension or compactness premise.

The final section instantiates the bounded compact-resolvent no-go.  Thus a
bounded multiplication operator such as the actual discriminant potential
cannot itself be the paper's compact-resolvent Hamiltonian on this carrier;
that claim necessarily belongs to a genuinely unbounded realization.
-/

/-! ## 1. Arbitrarily many distinct points in the literal stage collar -/

/-- The one-sided real height interval is infinite because its endpoints are
separated by the proved positive collar radius. -/
theorem actualStageOneSidedHeightBand_infinite (Y : ℝ) :
    Infinite (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y) := by
  exact Set.Ioc.infinite
    (sub_lt_self (Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) QYM.FullCertification.P2CuspCollarClosureExtension.collarRadius_pos)

/-- A fixed injection of the natural numbers into the actual one-sided
height interval. -/
noncomputable def actualStageHeightNatEmbedding (Y : ℝ) :
    ℕ ↪ QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y := by
  letI : Infinite (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y) :=
    actualStageOneSidedHeightBand_infinite Y
  exact Infinite.natEmbedding (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.OneSidedHeightBand Y)

theorem actualStageHeightNatEmbedding_injective (Y : ℝ) :
    Function.Injective (actualStageHeightNatEmbedding Y) :=
  (actualStageHeightNatEmbedding Y).injective

/-- The fixed angle used to turn the height injection into actual stage
points. -/
def actualStageInterpolationAngle : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle :=
  ((0 : ℝ) : QYM.FullCertification.P2SmoothQuotientAtlasExtension.WidthTwoCircle)

/-- For every `n`, an explicit embedding of `Fin n` into the literal actual
stage through one selected cusp collar. -/
noncomputable def actualStagePointEmbedding
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ) :
    Fin n ↪ QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y where
  toFun i :=
    QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap q hY
      (actualStageInterpolationAngle,
        actualStageHeightNatEmbedding Y i.1)
  inj' := by
    intro i j hij
    have hParameters :=
      (QYM.FullCertification.P2StageManifoldWithBoundaryExtension.stageCuspBandMap_isEmbedding q hY).injective hij
    have hHeights :
        actualStageHeightNatEmbedding Y i.1 =
          actualStageHeightNatEmbedding Y j.1 :=
      congrArg Prod.snd hParameters
    exact Fin.ext
      ((actualStageHeightNatEmbedding Y).injective hHeights)

/-- The `i`-th actual interpolation point. -/
noncomputable def actualStageInterpolationPoint
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y :=
  actualStagePointEmbedding q hY n i

theorem actualStageInterpolationPoint_injective
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ) :
    Function.Injective (actualStageInterpolationPoint q hY n) :=
  (actualStagePointEmbedding q hY n).injective

theorem actualStageInterpolationPoint_ne
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) {n : ℕ}
    {i j : Fin n} (hij : i ≠ j) :
    actualStageInterpolationPoint q hY n i ≠
      actualStageInterpolationPoint q hY n j := by
  exact fun hEq => hij
    (actualStageInterpolationPoint_injective q hY n hEq)

/-! ## 2. Finite Urysohn interpolation on the actual stage -/

/-- All interpolation points other than the `i`-th one. -/
def actualStageOtherInterpolationPoints
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) : Set (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :=
  actualStageInterpolationPoint q hY n '' {j : Fin n | j ≠ i}

theorem actualStageOtherInterpolationPoints_finite
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    (actualStageOtherInterpolationPoints q hY n i).Finite := by
  exact (Set.toFinite {j : Fin n | j ≠ i}).image
    (actualStageInterpolationPoint q hY n)

theorem actualStageOtherInterpolationPoints_isClosed
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    IsClosed (actualStageOtherInterpolationPoints q hY n i) :=
  (actualStageOtherInterpolationPoints_finite q hY n i).isClosed

/-- The other-point set and the selected singleton are disjoint, by the
literal collar-point embedding. -/
theorem actualStageOtherInterpolationPoints_disjoint_singleton
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    Disjoint (actualStageOtherInterpolationPoints q hY n i)
      {actualStageInterpolationPoint q hY n i} := by
  rw [Set.disjoint_left]
  intro x hxOther hxSelf
  have hxEq : x = actualStageInterpolationPoint q hY n i :=
    Set.mem_singleton_iff.mp hxSelf
  subst x
  rcases hxOther with ⟨j, hj, hji⟩
  exact hj
    (actualStageInterpolationPoint_injective q hY n hji)

/-- Urysohn interpolation: zero on every other selected point and one at the
chosen point. -/
theorem exists_actualStageDeltaReal
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    ∃ f : C(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, ℝ),
      EqOn f 0 (actualStageOtherInterpolationPoints q hY n i) ∧
      EqOn f 1 {actualStageInterpolationPoint q hY n i} ∧
      ∀ x, f x ∈ Set.Icc (0 : ℝ) 1 := by
  exact exists_continuous_zero_one_of_isClosed
    (actualStageOtherInterpolationPoints_isClosed q hY n i)
    isClosed_singleton
    (actualStageOtherInterpolationPoints_disjoint_singleton q hY n i)

/-- A chosen real Urysohn interpolation function. -/
noncomputable def actualStageDeltaReal
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) : C(QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, ℝ) :=
  Classical.choose (exists_actualStageDeltaReal q hY n i)

theorem actualStageDeltaReal_spec
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    EqOn (actualStageDeltaReal q hY n i) 0
        (actualStageOtherInterpolationPoints q hY n i) ∧
      EqOn (actualStageDeltaReal q hY n i) 1
        {actualStageInterpolationPoint q hY n i} ∧
      ∀ x, actualStageDeltaReal q hY n i x ∈
        Set.Icc (0 : ℝ) 1 :=
  Classical.choose_spec (exists_actualStageDeltaReal q hY n i)

@[simp]
theorem actualStageDeltaReal_self
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    actualStageDeltaReal q hY n i
        (actualStageInterpolationPoint q hY n i) = 1 := by
  exact (actualStageDeltaReal_spec q hY n i).2.1
    (Set.mem_singleton _)

@[simp]
theorem actualStageDeltaReal_other
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    {i j : Fin n} (hji : j ≠ i) :
    actualStageDeltaReal q hY n i
        (actualStageInterpolationPoint q hY n j) = 0 := by
  exact (actualStageDeltaReal_spec q hY n i).1
    ⟨j, hji, rfl⟩

/-- Complexification of the real Kronecker interpolation function. -/
noncomputable def actualStageDeltaComplex
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) : QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousInverseEtaSection Y :=
  ⟨fun x => (actualStageDeltaReal q hY n i x : ℂ),
    Complex.continuous_ofReal.comp
      (actualStageDeltaReal q hY n i).continuous⟩

@[simp]
theorem actualStageDeltaComplex_self
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) :
    actualStageDeltaComplex q hY n i
        (actualStageInterpolationPoint q hY n i) = 1 := by
  change
    ((actualStageDeltaReal q hY n i
      (actualStageInterpolationPoint q hY n i) : ℝ) : ℂ) = 1
  rw [actualStageDeltaReal_self]
  norm_num

@[simp]
theorem actualStageDeltaComplex_other
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    {i j : Fin n} (hji : j ≠ i) :
    actualStageDeltaComplex q hY n i
        (actualStageInterpolationPoint q hY n j) = 0 := by
  change
    ((actualStageDeltaReal q hY n i
      (actualStageInterpolationPoint q hY n j) : ℝ) : ℂ) = 0
  rw [actualStageDeltaReal_other q hY n hji]
  norm_num

/-- Exact Kronecker evaluation matrix of the complex interpolation family.
-/
theorem actualStageDeltaComplex_kronecker
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i j : Fin n) :
    actualStageDeltaComplex q hY n i
        (actualStageInterpolationPoint q hY n j) =
      if j = i then 1 else 0 := by
  by_cases hji : j = i
  · subst j
    rw [actualStageDeltaComplex_self]
    simp only [ite_true]
  · rw [actualStageDeltaComplex_other q hY n hji]
    simp only [hji, ite_false]

/-! ## 3. Arbitrarily large linearly independent continuous and `L²` families -/

/-- The Kronecker interpolation family is complex-linearly independent in
the exact continuous eta-coordinate core. -/
theorem actualStageDeltaComplex_linearIndependent
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ) :
    LinearIndependent ℂ (actualStageDeltaComplex q hY n) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro c hSum i
  have hEval := congrArg
    (fun f : QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousInverseEtaSection Y =>
      f (actualStageInterpolationPoint q hY n i)) hSum
  simpa [actualStageDeltaComplex_kronecker, eq_comm] using hEval

/-- The actual `L²` realization of the Kronecker interpolation family. -/
noncomputable def actualStageL2DeltaFamily
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ)
    (i : Fin n) : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y
    (actualStageDeltaComplex q hY n i)

/-- Full-support injectivity transfers every finite Kronecker family to an
equally large linearly independent family in the actual Petersson `L²`
carrier. -/
theorem actualStageL2DeltaFamily_linearIndependent
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ) :
    LinearIndependent ℂ (actualStageL2DeltaFamily q hY n) := by
  have hMapped :=
    (actualStageDeltaComplex_linearIndependent q hY n).map'
      (QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y).toLinearMap
      (QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_ker_eq_bot hY)
  change LinearIndependent ℂ
    (fun i : Fin n =>
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y
        (actualStageDeltaComplex q hY n i))
  change LinearIndependent ℂ
    (fun i : Fin n =>
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y
        (actualStageDeltaComplex q hY n i)) at hMapped
  exact hMapped

/-- Arbitrarily large finite independent families, stated as a direct
certificate rather than as a hidden dimension field. -/
theorem exists_actualStageL2_linearIndependent_fin
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) (n : ℕ) :
    ∃ v : Fin n → QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
      LinearIndependent ℂ v :=
  ⟨actualStageL2DeltaFamily q hY n,
    actualStageL2DeltaFamily_linearIndependent q hY n⟩

/-! ## 4. Direct contradiction to finite dimensionality -/

/-- For a fixed actual cusp collar, finite dimensionality over `ℂ` is
impossible: use the explicit family indexed by `Fin (finrank + 1)`. -/
theorem actualStageInverseEtaL2_not_finiteDimensional_of_coset
    (q : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset) {Y : ℝ}
    (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ FiniteDimensional ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  intro hFinite
  letI : FiniteDimensional ℂ
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := hFinite
  let n : ℕ :=
    Module.finrank ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) + 1
  have hIndependent : LinearIndependent ℂ
      (actualStageL2DeltaFamily q hY n) :=
    actualStageL2DeltaFamily_linearIndependent q hY n
  have hCard := hIndependent.fintype_card_le_finrank
  have hImpossible :
      Module.finrank ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) + 1 ≤
        Module.finrank ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
    simpa only [Fintype.card_fin, n] using hCard
  exact (Nat.not_succ_le_self _) hImpossible

/-- A canonical right-coset label used to remove the irrelevant collar-label
argument from the final carrier theorem. -/
def canonicalGammaTwoRightCoset : Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.GammaTwoRightCoset :=
  Quotient.mk'' (1 : SL(2, ℤ))

/-- The genuine finite-stage inverse-eta Petersson `L²` carrier is not
finite dimensional over `ℂ` at every paper-range cutoff. -/
theorem actualStageInverseEtaL2_not_finiteDimensional
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ FiniteDimensional ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :=
  actualStageInverseEtaL2_not_finiteDimensional_of_coset
    canonicalGammaTwoRightCoset hY

/-- Finite dimensionality over `ℝ` would imply finite generation over
`ℂ` by scalar extension, contradicting the preceding theorem. -/
theorem actualStageInverseEtaL2_not_finiteDimensional_real
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    ¬ FiniteDimensional ℝ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  intro hRealFinite
  letI : FiniteDimensional ℝ
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := hRealFinite
  letI : FiniteDimensional ℂ
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :=
    Module.Finite.of_restrictScalars_finite ℝ ℂ
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)
  exact actualStageInverseEtaL2_not_finiteDimensional hY inferInstance

/-! ## 5. Actual bounded compact-resolvent no-go -/

/-- No bounded real-linear endomorphism of the actual stage carrier can have
a compact resolvent at a real resolvent point. -/
theorem actualStage_bounded_not_compact_resolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)
    {r : ℝ} (hr : r ∈ resolventSet ℝ T) :
    ¬ IsCompactOperator
      ((resolvent T r : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  exact QYM.CompactResolventLogicExtension.not_compact_resolvent_of_not_finiteDimensional
      (actualStageInverseEtaL2_not_finiteDimensional_real hY) T hr

/-- Complex-linear bounded operators are covered after their canonical
restriction to real scalars. -/
theorem actualStage_complexBounded_not_compact_realResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    (T : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)
    {r : ℝ}
    (hr : r ∈ resolventSet ℝ (T.restrictScalars ℝ)) :
    ¬ IsCompactOperator
      ((resolvent (T.restrictScalars ℝ) r :
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  exact actualStage_bounded_not_compact_resolvent hY
    (T.restrictScalars ℝ) hr

/-- In particular, the genuine bounded discriminant-potential
multiplication operator cannot have compact real resolvent on the actual
stage carrier. -/
theorem actualStageDiscriminantPotential_not_compact_realResolvent
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {r : ℝ}
    (hr : r ∈ resolventSet ℝ
      ((QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y).restrictScalars ℝ)) :
    ¬ IsCompactOperator
      ((resolvent
        ((QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y).restrictScalars ℝ)
        r : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  exact actualStage_complexBounded_not_compact_realResolvent hY
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y) hr

/-! ## 6. Aggregate unconditional endpoint -/

/-- Aggregate infinite-dimensionality and bounded-resolvent boundary
certificate for the actual stage carrier. -/
theorem actualStageL2InfiniteDimensionalCertificate
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (∀ n : ℕ,
      ∃ v : Fin n → QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y,
        LinearIndependent ℂ v) ∧
      ¬ FiniteDimensional ℂ
        (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) ∧
      ¬ FiniteDimensional ℝ
        (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) ∧
      ∀ (T : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (r : ℝ),
        r ∈ resolventSet ℝ T →
          ¬ IsCompactOperator
            ((resolvent T r : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℝ]
                QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
              QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →
                QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) := by
  exact
    ⟨fun n => exists_actualStageL2_linearIndependent_fin
        canonicalGammaTwoRightCoset hY n,
      actualStageInverseEtaL2_not_finiteDimensional hY,
      actualStageInverseEtaL2_not_finiteDimensional_real hY,
      fun T r hr => actualStage_bounded_not_compact_resolvent hY T hr⟩

