namespace QYM.FullCertification.P8ActualStagePotentialSelfAdjointExtension














/-!
# P8: self-adjoint realization and square root of the actual stage potential

This file upgrades the concrete bounded multiplication operator constructed in
P6 to the exact bounded-operator and partial-linear-map APIs used by Mathlib.
Nothing in this file is a compact-resolvent assertion.  The results proved here
are precisely the consequences of bounded real multiplication:

* symmetry, equality with the Hilbert adjoint, and self-adjointness;
* an everywhere-defined `LinearPMap` realization with dense domain and closed
  graph;
* a concrete pointwise square-root multiplier `S_Y` and the factorization
  `M_{V,Y} = S_Y \circ S_Y`;
* an actual positive minimum on the compact stage, and the resulting
  coercivity and injectivity estimates.

The operator called `actualStageDiscriminantSqrtOperator` below is the square
root of the bounded *potential*.  It is not the kinetic covariant derivative
and is never used as a replacement for that differential operator.
-/

/-! ## 1. Bounded-operator symmetry, adjointness, and self-adjointness -/

/-- The P6 inner-product identity is exactly Mathlib's algebraic symmetry
predicate for the underlying everywhere-defined linear map. -/
theorem actualStageDiscriminantPotentialOperator_isSymmetric (Y : ℝ) :
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y).IsSymmetric := by
  intro u v
  exact QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator_inner_symmetric Y u v

/-- The Hilbert-space adjoint of the actual bounded multiplier is itself. -/
theorem actualStageDiscriminantPotentialOperator_adjoint_eq (Y : ℝ) :
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y)† =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y :=
  (actualStageDiscriminantPotentialOperator_isSymmetric Y).clm_adjoint_eq

/-- The actual finite-stage discriminant multiplier is self-adjoint as a
bounded operator. -/
theorem actualStageDiscriminantPotentialOperator_isSelfAdjoint (Y : ℝ) :
    IsSelfAdjoint (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y) :=
  (actualStageDiscriminantPotentialOperator_isSymmetric Y).isSelfAdjoint

/-- Every member of the safe sector family is algebraically symmetric. -/
theorem actualStageSectorDiscriminantPotentialOperator_isSymmetric
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y).IsSymmetric := by
  intro u v
  exact
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator_inner_symmetric
      sector Y u v

/-- Adjoint equality for every safe physical sector. -/
theorem actualStageSectorDiscriminantPotentialOperator_adjoint_eq
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y)† =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y :=
  (actualStageSectorDiscriminantPotentialOperator_isSymmetric sector Y).clm_adjoint_eq

/-- Bounded self-adjointness for the complete sector family. -/
theorem actualStageSectorDiscriminantPotentialOperator_isSelfAdjoint
    (sector : QYM.FullCertification.P1NotationFirewall.QSector) (Y : ℝ) :
    IsSelfAdjoint
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageSectorDiscriminantPotentialOperator sector Y) :=
  (actualStageSectorDiscriminantPotentialOperator_isSymmetric sector Y).isSelfAdjoint

/-! ## 2. Full-domain `LinearPMap` realization -/

/-- The canonical everywhere-defined partial-linear-map realization of the
actual bounded multiplier. -/
noncomputable def actualStageDiscriminantPotentialFullDomainPMap (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ.[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y).toPMap ⊤

/-- Its domain is definitionally the whole actual stage Hilbert space. -/
@[simp]
theorem actualStageDiscriminantPotentialFullDomainPMap_domain (Y : ℝ) :
    (actualStageDiscriminantPotentialFullDomainPMap Y).domain = ⊤ :=
  rfl

/-- A vector together with its canonical proof of full-domain membership. -/
noncomputable def actualStageDiscriminantPotentialFullDomainArgument
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    (actualStageDiscriminantPotentialFullDomainPMap Y).domain :=
  ⟨u, by simp⟩

@[simp]
theorem actualStageDiscriminantPotentialFullDomainArgument_coe
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    (actualStageDiscriminantPotentialFullDomainArgument Y u :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) = u :=
  rfl

/-- Evaluation of the partial map is exactly evaluation of the P6 bounded
operator. -/
@[simp]
theorem actualStageDiscriminantPotentialFullDomainPMap_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialFullDomainPMap Y
        (actualStageDiscriminantPotentialFullDomainArgument Y u) =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u :=
  rfl

/-- The top submodule is dense; it is stated explicitly because it is the
hypothesis needed by the exact `ContinuousLinearMap`/`LinearPMap` adjoint
bridge. -/
theorem actualStageDiscriminantPotentialTop_dense (Y : ℝ) :
    Dense
      (((⊤ : Submodule ℂ (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) :
        Set (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y))) := by
  simpa using
    (dense_univ : Dense
      (Set.univ : Set (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)))

/-- The partial-map adjoint is the same full-domain realization. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_adjoint_eq
    (Y : ℝ) :
    (actualStageDiscriminantPotentialFullDomainPMap Y).adjoint =
      actualStageDiscriminantPotentialFullDomainPMap Y := by
  unfold actualStageDiscriminantPotentialFullDomainPMap
  rw [ContinuousLinearMap.toPMap_adjoint_eq_adjoint_toPMap_of_dense
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y)
      (actualStageDiscriminantPotentialTop_dense Y),
    actualStageDiscriminantPotentialOperator_adjoint_eq]

/-- Self-adjointness in Mathlib's unbounded/partial operator API. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_isSelfAdjoint
    (Y : ℝ) :
    IsSelfAdjoint (actualStageDiscriminantPotentialFullDomainPMap Y) := by
  rw [LinearPMap.isSelfAdjoint_def]
  exact actualStageDiscriminantPotentialFullDomainPMap_adjoint_eq Y

/-- Density also follows from the general self-adjoint partial-map theorem. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_dense_domain
    (Y : ℝ) :
    Dense
      ((actualStageDiscriminantPotentialFullDomainPMap Y).domain :
        Set (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) :=
  (actualStageDiscriminantPotentialFullDomainPMap_isSelfAdjoint Y).dense_domain

/-- The full-domain realization is a closed operator. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_isClosed
    (Y : ℝ) :
    (actualStageDiscriminantPotentialFullDomainPMap Y).IsClosed :=
  (actualStageDiscriminantPotentialFullDomainPMap_isSelfAdjoint Y).isClosed

/-- Set-level closedness of the concrete graph. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_graph_isClosed
    (Y : ℝ) :
    _root_.IsClosed
      ((actualStageDiscriminantPotentialFullDomainPMap Y).graph :
        Set
          (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y ×
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) :=
  actualStageDiscriminantPotentialFullDomainPMap_isClosed Y

/-- The closed full-domain operator agrees with its graph closure. -/
theorem actualStageDiscriminantPotentialFullDomainPMap_closure_eq
    (Y : ℝ) :
    (actualStageDiscriminantPotentialFullDomainPMap Y).closure =
      actualStageDiscriminantPotentialFullDomainPMap Y := by
  let hClosed :=
    actualStageDiscriminantPotentialFullDomainPMap_isClosed Y
  let hClosable := hClosed.isClosable
  apply LinearPMap.eq_of_eq_graph
  rw [← hClosable.graph_closure_eq_closure_graph]
  exact hClosed.submodule_topologicalClosure_eq

/-- The graph carrier, equipped with the inherited product norm. -/
abbrev ActualStageDiscriminantPotentialGraph (Y : ℝ) :=
  (actualStageDiscriminantPotentialFullDomainPMap Y).graph

/-- Closed-graph completeness of the actual potential realization. -/
noncomputable instance actualStageDiscriminantPotentialGraph_completeSpace
    (Y : ℝ) :
    CompleteSpace (ActualStageDiscriminantPotentialGraph Y) :=
  (actualStageDiscriminantPotentialFullDomainPMap_graph_isClosed Y).completeSpace_coe

/-! ## 3. The actual positive minimum on a compact stage -/

/-- Compactness and pointwise strict positivity produce a genuine positive
lower bound.  This is an extremal construction, not a supplied certificate. -/
theorem exists_actualStageDiscriminantPotentialPositiveLowerBound (Y : ℝ) :
    ∃ c : ℝ, 0 < c ∧
      ∀ x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y, c ≤ QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential Y x := by
  obtain ⟨c, hc, hLower⟩ :=
    (isCompact_univ : IsCompact (Set.univ : Set (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y))).exists_forall_le'
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_continuous Y).continuousOn
      (fun x _ => QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_pos Y x)
  exact ⟨c, hc, fun x => hLower x (Set.mem_univ x)⟩

/-- The selected positive minimum-scale constant for the actual compact
stage. -/
noncomputable def actualStageDiscriminantPotentialLowerBound (Y : ℝ) : ℝ :=
  Classical.choose
    (exists_actualStageDiscriminantPotentialPositiveLowerBound Y)

/-- The selected lower bound is strictly positive. -/
theorem actualStageDiscriminantPotentialLowerBound_pos (Y : ℝ) :
    0 < actualStageDiscriminantPotentialLowerBound Y :=
  (Classical.choose_spec
    (exists_actualStageDiscriminantPotentialPositiveLowerBound Y)).1

/-- The selected constant lies below the actual pointwise potential. -/
theorem actualStageDiscriminantPotentialLowerBound_le
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantPotentialLowerBound Y ≤
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential Y x :=
  (Classical.choose_spec
    (exists_actualStageDiscriminantPotentialPositiveLowerBound Y)).2 x

/-- The positive minimum is bounded above by the paper's global potential
constant. -/
theorem actualStageDiscriminantPotentialLowerBound_le_uniformBound
    (Y : ℝ) [Nonempty (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y)] :
    actualStageDiscriminantPotentialLowerBound Y ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  let x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y :=
    Classical.choice (inferInstance : Nonempty (QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y))
  exact
    (actualStageDiscriminantPotentialLowerBound_le Y x).trans
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_le_uniformBound Y x)

/-! ## 4. The pointwise square root of the discriminant potential -/

/-- The literal real square root of the actual discriminant potential.  This
is the potential square root, not a differential or kinetic operator. -/
noncomputable def actualStageDiscriminantSqrtPotential
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℝ :=
  Real.sqrt (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential Y x)

@[simp]
theorem actualStageDiscriminantSqrtPotential_apply
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantSqrtPotential Y x =
      Real.sqrt (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential Y x) :=
  rfl

/-- The square-root potential is continuous on the actual compact stage. -/
theorem actualStageDiscriminantSqrtPotential_continuous (Y : ℝ) :
    Continuous (actualStageDiscriminantSqrtPotential Y) := by
  exact (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_continuous Y).sqrt

/-- Pointwise nonnegativity of the principal square root. -/
theorem actualStageDiscriminantSqrtPotential_nonneg
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    0 ≤ actualStageDiscriminantSqrtPotential Y x :=
  Real.sqrt_nonneg _

/-- Strict positivity follows from strict positivity of the potential. -/
theorem actualStageDiscriminantSqrtPotential_pos
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    0 < actualStageDiscriminantSqrtPotential Y x := by
  exact Real.sqrt_pos.2 (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_pos Y x)

/-- Squaring the principal square root recovers the actual potential. -/
theorem actualStageDiscriminantSqrtPotential_mul_self
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantSqrtPotential Y x *
        actualStageDiscriminantSqrtPotential Y x =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential Y x := by
  exact Real.mul_self_sqrt
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_nonneg Y x)

/-- The global potential bound gives an explicit global square-root bound. -/
theorem actualStageDiscriminantSqrtPotential_le_sqrt_uniformBound
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantSqrtPotential Y x ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  exact Real.sqrt_le_sqrt
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotential_le_uniformBound Y x)

/-- The compact-stage lower bound survives square roots. -/
theorem sqrt_lowerBound_le_actualStageDiscriminantSqrtPotential
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) ≤
      actualStageDiscriminantSqrtPotential Y x := by
  exact Real.sqrt_le_sqrt
    (actualStageDiscriminantPotentialLowerBound_le Y x)

/-- Complex scalar used by the square-root multiplication operator. -/
noncomputable def actualStageDiscriminantSqrtPotentialComplex
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℂ :=
  (actualStageDiscriminantSqrtPotential Y x : ℂ)

@[simp]
theorem actualStageDiscriminantSqrtPotentialComplex_apply
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantSqrtPotentialComplex Y x =
      (actualStageDiscriminantSqrtPotential Y x : ℂ) :=
  rfl

/-- Continuity of the complex-valued square-root scalar. -/
theorem actualStageDiscriminantSqrtPotentialComplex_continuous (Y : ℝ) :
    Continuous (actualStageDiscriminantSqrtPotentialComplex Y) := by
  exact Complex.continuous_ofReal.comp
    (actualStageDiscriminantSqrtPotential_continuous Y)

/-- Strong measurability in the actual stage measure. -/
theorem actualStageDiscriminantSqrtPotentialComplex_aestronglyMeasurable
    (Y : ℝ) :
    AEStronglyMeasurable
      (actualStageDiscriminantSqrtPotentialComplex Y)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) :=
  (actualStageDiscriminantSqrtPotentialComplex_continuous Y).aestronglyMeasurable

/-- The complex norm of the real nonnegative square root is the same real
number. -/
@[simp]
theorem norm_actualStageDiscriminantSqrtPotentialComplex
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantSqrtPotentialComplex Y x‖ =
      actualStageDiscriminantSqrtPotential Y x := by
  rw [actualStageDiscriminantSqrtPotentialComplex, Complex.norm_real,
    Real.norm_of_nonneg
      (actualStageDiscriminantSqrtPotential_nonneg Y x)]

/-- Explicit pointwise norm bound for the square-root scalar. -/
theorem norm_actualStageDiscriminantSqrtPotentialComplex_le
    (Y : ℝ) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantSqrtPotentialComplex Y x‖ ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  rw [norm_actualStageDiscriminantSqrtPotentialComplex]
  exact actualStageDiscriminantSqrtPotential_le_sqrt_uniformBound Y x

/-! ## 5. Representative-level square-root multiplication -/

/-- Literal pointwise square-root product before quotienting by a.e.
equality. -/
noncomputable def actualStageDiscriminantSqrtProduct
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) : ℂ :=
  actualStageDiscriminantSqrtPotentialComplex Y x * u x

@[simp]
theorem actualStageDiscriminantSqrtProduct_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    actualStageDiscriminantSqrtProduct Y u x =
      actualStageDiscriminantSqrtPotentialComplex Y x * u x :=
  rfl

/-- The literal square-root product is strongly measurable. -/
theorem actualStageDiscriminantSqrtProduct_aestronglyMeasurable
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    AEStronglyMeasurable
      (actualStageDiscriminantSqrtProduct Y u)
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  exact
    (actualStageDiscriminantSqrtPotentialComplex_aestronglyMeasurable Y).mul
      (MeasureTheory.Lp.aestronglyMeasurable u)

/-- Pointwise bound used to preserve `L²`. -/
theorem norm_actualStageDiscriminantSqrtProduct_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) (x : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y) :
    ‖actualStageDiscriminantSqrtProduct Y u x‖ ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u x‖ := by
  rw [actualStageDiscriminantSqrtProduct, norm_mul,
    norm_actualStageDiscriminantSqrtPotentialComplex]
  exact mul_le_mul_of_nonneg_right
    (actualStageDiscriminantSqrtPotential_le_sqrt_uniformBound Y x)
    (norm_nonneg _)

/-- Multiplication by the bounded square-root scalar preserves `L²`. -/
theorem actualStageDiscriminantSqrtProduct_memLp
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    MemLp (actualStageDiscriminantSqrtProduct Y u) 2
      (QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y) := by
  exact (MeasureTheory.Lp.memLp u).of_le_mul
    (actualStageDiscriminantSqrtProduct_aestronglyMeasurable Y u)
    (Filter.Eventually.of_forall
      (norm_actualStageDiscriminantSqrtProduct_le Y u))

/-- The actual `L²` class of the pointwise square-root product. -/
noncomputable def actualStageDiscriminantSqrtMul
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (actualStageDiscriminantSqrtProduct_memLp Y u).toLp
    (actualStageDiscriminantSqrtProduct Y u)

/-- A.e. representative formula for the square-root product class. -/
theorem actualStageDiscriminantSqrtMul_coeFn_ae
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ((actualStageDiscriminantSqrtMul Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      actualStageDiscriminantSqrtProduct Y u :=
  (actualStageDiscriminantSqrtProduct_memLp Y u).coeFn_toLp

/-- Additivity at the `L²` class level. -/
theorem actualStageDiscriminantSqrtMul_add
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtMul Y (u + v) =
      actualStageDiscriminantSqrtMul Y u +
        actualStageDiscriminantSqrtMul Y v := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageDiscriminantSqrtMul_coeFn_ae Y (u + v),
      actualStageDiscriminantSqrtMul_coeFn_ae Y u,
      actualStageDiscriminantSqrtMul_coeFn_ae Y v,
      MeasureTheory.Lp.coeFn_add u v,
      MeasureTheory.Lp.coeFn_add
        (actualStageDiscriminantSqrtMul Y u)
        (actualStageDiscriminantSqrtMul Y v)]
    with x hsum hu hv huv hout
  rw [hsum, hout, actualStageDiscriminantSqrtProduct_apply, huv,
    Pi.add_apply, Pi.add_apply, hu,
    actualStageDiscriminantSqrtProduct_apply, hv,
    actualStageDiscriminantSqrtProduct_apply, mul_add]

/-- Complex homogeneity at the `L²` class level. -/
theorem actualStageDiscriminantSqrtMul_smul
    (Y : ℝ) (c : ℂ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtMul Y (c • u) =
      c • actualStageDiscriminantSqrtMul Y u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageDiscriminantSqrtMul_coeFn_ae Y (c • u),
      actualStageDiscriminantSqrtMul_coeFn_ae Y u,
      MeasureTheory.Lp.coeFn_smul c u,
      MeasureTheory.Lp.coeFn_smul c
        (actualStageDiscriminantSqrtMul Y u)]
    with x hleft hu hcu hright
  rw [hleft, hright, actualStageDiscriminantSqrtProduct_apply, hcu,
    Pi.smul_apply, Pi.smul_apply, hu,
    actualStageDiscriminantSqrtProduct_apply]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- The `L²` norm estimate inherited from the pointwise bound. -/
theorem norm_actualStageDiscriminantSqrtMul_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageDiscriminantSqrtMul Y u‖ ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ := by
  apply MeasureTheory.Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [actualStageDiscriminantSqrtMul_coeFn_ae Y u] with x hx
  rw [hx]
  exact norm_actualStageDiscriminantSqrtProduct_le Y u x

/-! ## 6. The bounded potential-square-root operator -/

/-- Algebraic linear map underlying pointwise square-root multiplication. -/
noncomputable def actualStageDiscriminantSqrtLinearMap (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y where
  toFun := actualStageDiscriminantSqrtMul Y
  map_add' := actualStageDiscriminantSqrtMul_add Y
  map_smul' := actualStageDiscriminantSqrtMul_smul Y

@[simp]
theorem actualStageDiscriminantSqrtLinearMap_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtLinearMap Y u =
      actualStageDiscriminantSqrtMul Y u :=
  rfl

/-- The actual bounded potential-square-root operator `S_Y`. -/
noncomputable def actualStageDiscriminantSqrtOperator (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →L[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (actualStageDiscriminantSqrtLinearMap Y).mkContinuous
    (Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound)
    (norm_actualStageDiscriminantSqrtMul_le Y)

@[simp]
theorem actualStageDiscriminantSqrtOperator_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtOperator Y u =
      actualStageDiscriminantSqrtMul Y u :=
  rfl

/-- A.e. pointwise formula for `S_Y`. -/
theorem actualStageDiscriminantSqrtOperator_coeFn_ae
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ((actualStageDiscriminantSqrtOperator Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) : QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      fun x => actualStageDiscriminantSqrtPotentialComplex Y x * u x := by
  change
    ((actualStageDiscriminantSqrtMul Y u :
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
      QYM.FullCertification.P2IntrinsicTruncatedQuotientExtension.X Y → ℂ) =ᵐ[
        QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStageMeasure Y]
      actualStageDiscriminantSqrtProduct Y u
  exact actualStageDiscriminantSqrtMul_coeFn_ae Y u

/-- Apply-norm estimate for the potential square root. -/
theorem norm_actualStageDiscriminantSqrtOperator_apply_le
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    ‖actualStageDiscriminantSqrtOperator Y u‖ ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound * ‖u‖ :=
  norm_actualStageDiscriminantSqrtMul_le Y u

/-- Operator-norm estimate for the potential square root. -/
theorem norm_actualStageDiscriminantSqrtOperator_le (Y : ℝ) :
    ‖actualStageDiscriminantSqrtOperator Y‖ ≤
      Real.sqrt Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound := by
  exact LinearMap.mkContinuous_norm_le
    (actualStageDiscriminantSqrtLinearMap Y)
    (Real.sqrt_nonneg Mock2FA.PaperCorrections.AutomorphicSobolev.ExplicitDiscriminantPotential.uniformBound)
    (norm_actualStageDiscriminantSqrtMul_le Y)

/-- `S_Y` is symmetric because its pointwise multiplier is real. -/
theorem actualStageDiscriminantSqrtOperator_inner_symmetric
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    inner ℂ (actualStageDiscriminantSqrtOperator Y u) v =
      inner ℂ u (actualStageDiscriminantSqrtOperator Y v) := by
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards
    [actualStageDiscriminantSqrtOperator_coeFn_ae Y u,
      actualStageDiscriminantSqrtOperator_coeFn_ae Y v]
    with x hu hv
  rw [hu, hv]
  simpa only [actualStageDiscriminantSqrtPotentialComplex_apply,
    smul_eq_mul] using
    (show
      inner ℂ
          ((actualStageDiscriminantSqrtPotential Y x : ℂ) • u x) (v x) =
        inner ℂ (u x)
          ((actualStageDiscriminantSqrtPotential Y x : ℂ) • v x) by
      rw [inner_smul_left, inner_smul_right, starRingEnd_apply,
        Complex.star_def, Complex.conj_ofReal])

/-- Algebraic symmetry in the exact Mathlib predicate. -/
theorem actualStageDiscriminantSqrtOperator_isSymmetric (Y : ℝ) :
    (actualStageDiscriminantSqrtOperator Y :
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
        QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y).IsSymmetric := by
  intro u v
  exact actualStageDiscriminantSqrtOperator_inner_symmetric Y u v

/-- The potential square root equals its Hilbert adjoint. -/
theorem actualStageDiscriminantSqrtOperator_adjoint_eq (Y : ℝ) :
    (actualStageDiscriminantSqrtOperator Y)† =
      actualStageDiscriminantSqrtOperator Y :=
  (actualStageDiscriminantSqrtOperator_isSymmetric Y).clm_adjoint_eq

/-- The potential square root is itself a bounded self-adjoint operator. -/
theorem actualStageDiscriminantSqrtOperator_isSelfAdjoint (Y : ℝ) :
    IsSelfAdjoint (actualStageDiscriminantSqrtOperator Y) :=
  (actualStageDiscriminantSqrtOperator_isSymmetric Y).isSelfAdjoint

/-! ## 7. Exact square-root factorization and form representation -/

/-- Applying the pointwise square-root multiplier twice is exactly
multiplication by the original discriminant potential. -/
theorem actualStageDiscriminantSqrtOperator_apply_twice
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtOperator Y
        (actualStageDiscriminantSqrtOperator Y u) =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u := by
  apply MeasureTheory.Lp.ext
  filter_upwards
    [actualStageDiscriminantSqrtOperator_coeFn_ae Y
      (actualStageDiscriminantSqrtOperator Y u),
      actualStageDiscriminantSqrtOperator_coeFn_ae Y u,
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator_coeFn_ae Y u]
    with x houter hinner hpotential
  rw [houter, hinner, hpotential]
  simp only [actualStageDiscriminantSqrtPotentialComplex_apply,
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialComplex_apply]
  rw [← mul_assoc, ← Complex.ofReal_mul,
    actualStageDiscriminantSqrtPotential_mul_self]

/-- Operator-level factorization `M_{V,Y} = S_Y ∘ S_Y`. -/
theorem actualStageDiscriminantPotentialOperator_eq_sqrt_comp_sqrt
    (Y : ℝ) :
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y =
      (actualStageDiscriminantSqrtOperator Y).comp
        (actualStageDiscriminantSqrtOperator Y) := by
  apply ContinuousLinearMap.ext
  intro u
  rw [ContinuousLinearMap.comp_apply]
  exact (actualStageDiscriminantSqrtOperator_apply_twice Y u).symm

/-- The equivalent orientation `S_Y ∘ S_Y = M_{V,Y}`. -/
theorem actualStageDiscriminantSqrt_comp_sqrt_eq_potentialOperator
    (Y : ℝ) :
    (actualStageDiscriminantSqrtOperator Y).comp
        (actualStageDiscriminantSqrtOperator Y) =
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y :=
  (actualStageDiscriminantPotentialOperator_eq_sqrt_comp_sqrt Y).symm

/-- The P6 form is represented by the inner product of the two concrete
potential-square-root images. -/
theorem actualStageDiscriminantForm_eq_sqrt_inner
    (Y : ℝ) (u v : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u v =
      inner ℂ (actualStageDiscriminantSqrtOperator Y u)
        (actualStageDiscriminantSqrtOperator Y v) := by
  calc
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u v =
        inner ℂ u (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y v) :=
      rfl
    _ = inner ℂ u
        (actualStageDiscriminantSqrtOperator Y
          (actualStageDiscriminantSqrtOperator Y v)) := by
      rw [actualStageDiscriminantSqrtOperator_apply_twice]
    _ = inner ℂ (actualStageDiscriminantSqrtOperator Y u)
        (actualStageDiscriminantSqrtOperator Y v) :=
      (actualStageDiscriminantSqrtOperator_inner_symmetric Y u
        (actualStageDiscriminantSqrtOperator Y v)).symm

/-- On the diagonal, the form is exactly the squared `L²` norm of the
potential-square-root image. -/
theorem actualStageDiscriminantForm_self_re_eq_sqrt_norm_sq
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u u).re =
      ‖actualStageDiscriminantSqrtOperator Y u‖ ^ 2 := by
  rw [actualStageDiscriminantForm_eq_sqrt_inner]
  exact inner_self_eq_norm_sq (𝕜 := ℂ) _

/-- The diagonal form itself is the real complex scalar given by the squared
square-root norm. -/
theorem actualStageDiscriminantForm_self_eq_ofReal_sqrt_norm_sq
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u u =
      ((‖actualStageDiscriminantSqrtOperator Y u‖ ^ 2 : ℝ) : ℂ) := by
  apply Complex.ext
  · simpa only [Complex.ofReal_re] using
      actualStageDiscriminantForm_self_re_eq_sqrt_norm_sq Y u
  · simpa only [Complex.ofReal_im] using
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm_self_im_eq_zero Y u

/-! ## 8. Full-domain closed realization of the square root -/

/-- Full-domain `LinearPMap` realization of the bounded potential square
root. -/
noncomputable def actualStageDiscriminantSqrtFullDomainPMap (Y : ℝ) :
    QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ.[ℂ]
      QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y :=
  (actualStageDiscriminantSqrtOperator Y).toPMap ⊤

@[simp]
theorem actualStageDiscriminantSqrtFullDomainPMap_domain (Y : ℝ) :
    (actualStageDiscriminantSqrtFullDomainPMap Y).domain = ⊤ :=
  rfl

/-- Canonical full-domain argument for the square-root partial map. -/
noncomputable def actualStageDiscriminantSqrtFullDomainArgument
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    (actualStageDiscriminantSqrtFullDomainPMap Y).domain :=
  ⟨u, by simp⟩

@[simp]
theorem actualStageDiscriminantSqrtFullDomainPMap_apply
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantSqrtFullDomainPMap Y
        (actualStageDiscriminantSqrtFullDomainArgument Y u) =
      actualStageDiscriminantSqrtOperator Y u :=
  rfl

/-- The partial-map adjoint of the potential square root is itself. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_adjoint_eq (Y : ℝ) :
    (actualStageDiscriminantSqrtFullDomainPMap Y).adjoint =
      actualStageDiscriminantSqrtFullDomainPMap Y := by
  unfold actualStageDiscriminantSqrtFullDomainPMap
  rw [ContinuousLinearMap.toPMap_adjoint_eq_adjoint_toPMap_of_dense
      (actualStageDiscriminantSqrtOperator Y)
      (actualStageDiscriminantPotentialTop_dense Y),
    actualStageDiscriminantSqrtOperator_adjoint_eq]

/-- Self-adjointness of the full-domain potential-square-root partial map. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_isSelfAdjoint (Y : ℝ) :
    IsSelfAdjoint (actualStageDiscriminantSqrtFullDomainPMap Y) := by
  rw [LinearPMap.isSelfAdjoint_def]
  exact actualStageDiscriminantSqrtFullDomainPMap_adjoint_eq Y

/-- The potential-square-root partial map has dense full domain. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_dense_domain (Y : ℝ) :
    Dense
      ((actualStageDiscriminantSqrtFullDomainPMap Y).domain :
        Set (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) :=
  (actualStageDiscriminantSqrtFullDomainPMap_isSelfAdjoint Y).dense_domain

/-- The potential-square-root partial map is closed. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_isClosed (Y : ℝ) :
    (actualStageDiscriminantSqrtFullDomainPMap Y).IsClosed :=
  (actualStageDiscriminantSqrtFullDomainPMap_isSelfAdjoint Y).isClosed

/-- Set-level closedness of the potential-square-root graph. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_graph_isClosed (Y : ℝ) :
    _root_.IsClosed
      ((actualStageDiscriminantSqrtFullDomainPMap Y).graph :
        Set
          (QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y ×
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y)) :=
  actualStageDiscriminantSqrtFullDomainPMap_isClosed Y

/-- The square-root graph carrier. -/
abbrev ActualStageDiscriminantSqrtGraph (Y : ℝ) :=
  (actualStageDiscriminantSqrtFullDomainPMap Y).graph

/-- Completeness of the graph of the actual potential square root. -/
noncomputable instance actualStageDiscriminantSqrtGraph_completeSpace
    (Y : ℝ) :
    CompleteSpace (ActualStageDiscriminantSqrtGraph Y) :=
  (actualStageDiscriminantSqrtFullDomainPMap_graph_isClosed Y).completeSpace_coe

/-- The closed square-root realization equals its closure. -/
theorem actualStageDiscriminantSqrtFullDomainPMap_closure_eq (Y : ℝ) :
    (actualStageDiscriminantSqrtFullDomainPMap Y).closure =
      actualStageDiscriminantSqrtFullDomainPMap Y := by
  let hClosed := actualStageDiscriminantSqrtFullDomainPMap_isClosed Y
  let hClosable := hClosed.isClosable
  apply LinearPMap.eq_of_eq_graph
  rw [← hClosable.graph_closure_eq_closure_graph]
  exact hClosed.submodule_topologicalClosure_eq

/-! ## 9. Quantitative lower estimates on the unscaled potential -/

/-- The pointwise lower bound for `sqrt(V)` gives a global lower `L²` norm
estimate for the concrete square-root multiplier. -/
theorem sqrt_lowerBound_mul_norm_le_sqrtOperator_norm
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖ ≤
      ‖actualStageDiscriminantSqrtOperator Y u‖ := by
  have hLp :
      ‖((Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) : ℂ) • u)‖ ≤
        ‖actualStageDiscriminantSqrtOperator Y u‖ := by
    apply MeasureTheory.Lp.norm_le_norm_of_ae_le
    filter_upwards
      [MeasureTheory.Lp.coeFn_smul
        (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) : ℂ) u,
        actualStageDiscriminantSqrtOperator_coeFn_ae Y u]
      with x hleft hright
    rw [hleft, hright, Pi.smul_apply, norm_smul, norm_mul,
      Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _),
      norm_actualStageDiscriminantSqrtPotentialComplex]
    exact mul_le_mul_of_nonneg_right
      (sqrt_lowerBound_le_actualStageDiscriminantSqrtPotential Y x)
      (norm_nonneg _)
  simpa only [norm_smul, Complex.norm_real,
    Real.norm_of_nonneg (Real.sqrt_nonneg _)] using hLp

/-- Exact coercivity of the concrete P6 form by the positive compact-stage
minimum. -/
theorem actualStageDiscriminantForm_coercive
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialLowerBound Y * ‖u‖ ^ 2 ≤
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u u).re := by
  have hNorm := sqrt_lowerBound_mul_norm_le_sqrtOperator_norm Y u
  have hSquare :
      (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) *
          (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) ≤
        ‖actualStageDiscriminantSqrtOperator Y u‖ *
          ‖actualStageDiscriminantSqrtOperator Y u‖ :=
    mul_self_le_mul_self
      (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg u)) hNorm
  calc
    actualStageDiscriminantPotentialLowerBound Y * ‖u‖ ^ 2 =
        (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) *
          (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) := by
      calc
        actualStageDiscriminantPotentialLowerBound Y * ‖u‖ ^ 2 =
            (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y)) ^ 2 * ‖u‖ ^ 2 := by
          rw [Real.sq_sqrt
            (actualStageDiscriminantPotentialLowerBound_pos Y).le]
        _ = (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) *
              (Real.sqrt (actualStageDiscriminantPotentialLowerBound Y) * ‖u‖) := by
          ring
    _ ≤ ‖actualStageDiscriminantSqrtOperator Y u‖ *
        ‖actualStageDiscriminantSqrtOperator Y u‖ := hSquare
    _ = ‖actualStageDiscriminantSqrtOperator Y u‖ ^ 2 := by ring
    _ = (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantForm Y u u).re :=
      (actualStageDiscriminantForm_self_re_eq_sqrt_norm_sq Y u).symm

/-- The same coercivity statement written directly with the operator
pairing. -/
theorem actualStageDiscriminantPotentialOperator_pairing_coercive
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialLowerBound Y * ‖u‖ ^ 2 ≤
      (inner ℂ u (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u)).re :=
  actualStageDiscriminantForm_coercive Y u

/-- Pointwise multiplication by `V` is bounded below in the actual `L²`
norm by the same compact-stage minimum. -/
theorem lowerBound_mul_norm_le_potentialOperator_norm
    (Y : ℝ) (u : QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) :
    actualStageDiscriminantPotentialLowerBound Y * ‖u‖ ≤
      ‖QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u‖ := by
  have hLp :
      ‖((actualStageDiscriminantPotentialLowerBound Y : ℂ) • u)‖ ≤
        ‖QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u‖ := by
    apply MeasureTheory.Lp.norm_le_norm_of_ae_le
    filter_upwards
      [MeasureTheory.Lp.coeFn_smul
        (actualStageDiscriminantPotentialLowerBound Y : ℂ) u,
        QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator_coeFn_ae Y u]
      with x hleft hright
    rw [hleft, hright, Pi.smul_apply, norm_smul, norm_mul,
      Complex.norm_real, Real.norm_of_nonneg
        (actualStageDiscriminantPotentialLowerBound_pos Y).le,
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.norm_actualStageDiscriminantPotentialComplex]
    exact mul_le_mul_of_nonneg_right
      (actualStageDiscriminantPotentialLowerBound_le Y x)
      (norm_nonneg _)
  simpa only [norm_smul, Complex.norm_real,
    Real.norm_of_nonneg
      (actualStageDiscriminantPotentialLowerBound_pos Y).le] using hLp

/-- The actual bounded discriminant multiplier has trivial kernel. -/
theorem actualStageDiscriminantPotentialOperator_injective (Y : ℝ) :
    Function.Injective (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y) := by
  intro u v huv
  have hLower :=
    lowerBound_mul_norm_le_potentialOperator_norm Y (u - v)
  have hImage :
      QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y (u - v) = 0 := by
    rw [map_sub, huv, sub_self]
  rw [hImage, norm_zero] at hLower
  have hProduct :
      actualStageDiscriminantPotentialLowerBound Y * ‖u - v‖ = 0 :=
    le_antisymm hLower
      (mul_nonneg
        (actualStageDiscriminantPotentialLowerBound_pos Y).le
        (norm_nonneg _))
  have hNorm : ‖u - v‖ = 0 :=
    (mul_eq_zero.mp hProduct).resolve_left
      (ne_of_gt (actualStageDiscriminantPotentialLowerBound_pos Y))
  exact sub_eq_zero.mp (norm_eq_zero.mp hNorm)

/-- Kernel formulation of injectivity. -/
theorem actualStageDiscriminantPotentialOperator_ker_eq_bot (Y : ℝ) :
    LinearMap.ker
        (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y :
          QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y →ₗ[ℂ]
            QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y) =
      ⊥ := by
  exact LinearMap.ker_eq_bot.mpr
    (actualStageDiscriminantPotentialOperator_injective Y)

/-- The reciprocal of the positive lower constant as a nonnegative real
number; it is the antilipschitz constant for the multiplier. -/
noncomputable def actualStageDiscriminantPotentialLowerBoundReciprocalNNReal
    (Y : ℝ) : ℝ≥0 :=
  ⟨(actualStageDiscriminantPotentialLowerBound Y)⁻¹,
    inv_nonneg.mpr
      (actualStageDiscriminantPotentialLowerBound_pos Y).le⟩

@[simp]
theorem actualStageDiscriminantPotentialLowerBoundReciprocalNNReal_coe
    (Y : ℝ) :
    (actualStageDiscriminantPotentialLowerBoundReciprocalNNReal Y : ℝ) =
      (actualStageDiscriminantPotentialLowerBound Y)⁻¹ :=
  rfl

/-- The lower norm estimate is exactly an antilipschitz estimate. -/
theorem actualStageDiscriminantPotentialOperator_antilipschitz
    (Y : ℝ) :
    AntilipschitzWith
      (actualStageDiscriminantPotentialLowerBoundReciprocalNNReal Y)
      (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y) := by
  apply AntilipschitzWith.of_le_mul_dist
  intro u v
  rw [dist_eq_norm, dist_eq_norm]
  change ‖u - v‖ ≤
    (actualStageDiscriminantPotentialLowerBound Y)⁻¹ *
      ‖QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y u -
        QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y v‖
  rw [← map_sub, inv_mul_eq_div]
  apply (le_div_iff₀
    (actualStageDiscriminantPotentialLowerBound_pos Y)).2
  simpa only [mul_comm] using
    (lowerBound_mul_norm_le_potentialOperator_norm Y (u - v))

/-- The range is closed, as a quantitative consequence of the actual positive
lower bound and completeness of the stage Hilbert space. -/
theorem actualStageDiscriminantPotentialOperator_range_isClosed (Y : ℝ) :
    _root_.IsClosed
      (Set.range (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y)) :=
  (actualStageDiscriminantPotentialOperator_antilipschitz Y).isClosed_range
    (QYM.FullCertification.P6ActualStageDiscriminantPotentialExtension.actualStageDiscriminantPotentialOperator Y).uniformContinuous

