    Tendsto (fun n => QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffNegativeOneResolvent n)
      atTop (𝓝 QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffLimitNegativeOneResolvent) ∧
    (¬ ∀ᶠ n in atTop, QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffMovingOffGround n = ⊥)

/-- The current cutoff family cannot meet the nonvacuous uniform-gap
acceptance predicate.  Its stagewise unit identity does not repair the
norm-resolvent/persistent-excitation incompatibility. -/
theorem not_hasStableNontrivialUniformCutoffGap :
    ¬ HasStableNontrivialUniformCutoffGap := by
  rintro ⟨delta, hdelta, hCoercive, hNorm, hPersistent⟩
  exact actualCutoff_normResolvent_and_persistentExcitation_incompatible
    ⟨hNorm, hPersistent⟩

