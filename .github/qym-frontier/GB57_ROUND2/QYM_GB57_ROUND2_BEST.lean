      (actualInverseEtaProjectionHamiltonian hY - 1).toLinearMap.ker =
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y ∧
      IsCompl (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y)
        (QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y) ∧
