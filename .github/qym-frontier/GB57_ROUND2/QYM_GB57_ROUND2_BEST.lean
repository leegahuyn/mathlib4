          QYM.FullCertification.PaperNormalized.prop4_23_boundedCompactResolventFiniteDimensionalBoundaryStatement_holds,
          QYM.FullCertification.PaperNormalized.prop4_23_infiniteDimensionalBoundedCompactResolventNoGoStatement_holds,
          QYM.FullCertification.PaperNormalized.hyp4_24_zeroBoundedSurrogateCountermodelStatement_holds⟩
