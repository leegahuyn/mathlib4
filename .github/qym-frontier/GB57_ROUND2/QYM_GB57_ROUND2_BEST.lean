open Function Set Topology
open scoped InnerProductSpace

namespace QYM.FullCertification.P6ActualStageContinuousPivotExtension








/-!
# P6: the actual continuous-core pivot and its anti-dual embedding

This file records the unconditional Gelfand-type data already available on
the concrete finite stage.  The strong space here is the Banach space of
continuous eta coordinates with the uniform norm; it is **not** renamed as a
Sobolev space.  The pivot is the actual Petersson `L²` Hilbert space.

For every paper-range cutoff, the canonical map `j : C(X_Y, ℂ) -> L²(X_Y)`
is continuous, injective, and has dense range.  The Petersson pairing gives
the faithful conjugate-linear map

`h |-> (v |-> <h, j v>)`

from the pivot into the continuous dual of the strong space.  The
conjugate-linearity is stated explicitly; treating this map as complex-linear
would reverse the Hilbert-space convention.

This closes the pivot/anti-dual API at continuous-core regularity.  It does
not assert the still-stronger weak-derivative `H¹`, trace, Rellich, or compact
embedding statements.
-/

/-! ## 1. Concrete strong and pivot spaces -/

/-- The actual continuous eta-coordinate Banach space. -/
abbrev ActualStageContinuousFormDomain (Y : ℝ) :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.ActualStageContinuousInverseEtaSection Y

/-- The actual finite-stage Petersson pivot Hilbert space. -/
abbrev ActualStagePivotHilbert (Y : ℝ) :=
  QYM.FullCertification.P3ActualStageL2SectionsExtension.ActualStageInverseEtaL2Section Y

/-- Canonical continuous embedding from the continuous core to the pivot. -/
noncomputable def actualStageContinuousPivotEmbedding (Y : ℝ) :
    ActualStageContinuousFormDomain Y →L[ℂ]
      ActualStagePivotHilbert Y :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y

@[simp]
theorem actualStageContinuousPivotEmbedding_apply
    (Y : ℝ) (v : ActualStageContinuousFormDomain Y) :
    actualStageContinuousPivotEmbedding Y v =
      QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2 Y v :=
  rfl

/-- The embedding is injective in the proved paper cutoff range. -/
theorem actualStageContinuousPivotEmbedding_injective
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Function.Injective (actualStageContinuousPivotEmbedding Y) :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_injective hY

/-- Its range is dense for every cutoff. -/
theorem actualStageContinuousPivotEmbedding_denseRange (Y : ℝ) :
    DenseRange (actualStageContinuousPivotEmbedding Y) :=
  QYM.FullCertification.P4ActualStageContinuousDensityExtension.actualStageContinuousToL2_denseRange Y

/-- Kernel form of injectivity. -/
theorem actualStageContinuousPivotEmbedding_ker_eq_bot
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualStageContinuousPivotEmbedding Y).ker = ⊥ := by
  exact LinearMap.ker_eq_bot.mpr
    (actualStageContinuousPivotEmbedding_injective hY)

/-! ## 2. The Petersson anti-dual embedding -/

/-- A pivot vector defines a continuous linear functional on the strong
space by testing against its `L²` image. -/
noncomputable def actualStagePivotToContinuousAntiDual
    (Y : ℝ) (h : ActualStagePivotHilbert Y) :
    ActualStageContinuousFormDomain Y →L[ℂ] ℂ :=
  (innerSL ℂ h).comp (actualStageContinuousPivotEmbedding Y)

@[simp]
theorem actualStagePivotToContinuousAntiDual_apply
    (Y : ℝ) (h : ActualStagePivotHilbert Y)
    (v : ActualStageContinuousFormDomain Y) :
    actualStagePivotToContinuousAntiDual Y h v =
      inner ℂ h (actualStageContinuousPivotEmbedding Y v) :=
  rfl

@[simp]
theorem actualStagePivotToContinuousAntiDual_zero (Y : ℝ) :
    actualStagePivotToContinuousAntiDual Y
      (0 : ActualStagePivotHilbert Y) = 0 := by
  apply ContinuousLinearMap.ext
  intro v
  simp only [actualStagePivotToContinuousAntiDual_apply,
    inner_zero_left, ContinuousLinearMap.zero_apply]

@[simp]
theorem actualStagePivotToContinuousAntiDual_add
    (Y : ℝ) (h k : ActualStagePivotHilbert Y) :
    actualStagePivotToContinuousAntiDual Y (h + k) =
      actualStagePivotToContinuousAntiDual Y h +
        actualStagePivotToContinuousAntiDual Y k := by
  apply ContinuousLinearMap.ext
  intro v
  simp only [actualStagePivotToContinuousAntiDual_apply,
    ContinuousLinearMap.add_apply, inner_add_left]

/-- The pivot-to-dual map is conjugate-linear in the pivot vector. -/
@[simp]
theorem actualStagePivotToContinuousAntiDual_smul
    (Y : ℝ) (c : ℂ) (h : ActualStagePivotHilbert Y) :
    actualStagePivotToContinuousAntiDual Y (c • h) =
      (starRingEnd ℂ c) •
        actualStagePivotToContinuousAntiDual Y h := by
  apply ContinuousLinearMap.ext
  intro v
  change
    inner ℂ (c • h) (actualStageContinuousPivotEmbedding Y v) =
      (starRingEnd ℂ c) *
        inner ℂ h (actualStageContinuousPivotEmbedding Y v)
  exact inner_smul_left h
    (actualStageContinuousPivotEmbedding Y v) c

/-! ## 3. Quantitative continuity and faithfulness -/

/-- Pointwise Cauchy--Schwarz and the operator norm of `j` give the exact
continuous-dual bound. -/
theorem norm_actualStagePivotToContinuousAntiDual_apply_le
    (Y : ℝ) (h : ActualStagePivotHilbert Y)
    (v : ActualStageContinuousFormDomain Y) :
    ‖actualStagePivotToContinuousAntiDual Y h v‖ ≤
      (‖h‖ * ‖actualStageContinuousPivotEmbedding Y‖) * ‖v‖ := by
  calc
    ‖actualStagePivotToContinuousAntiDual Y h v‖ =
        ‖inner ℂ h (actualStageContinuousPivotEmbedding Y v)‖ := rfl
    _ ≤ ‖h‖ * ‖actualStageContinuousPivotEmbedding Y v‖ :=
      norm_inner_le_norm _ _
    _ ≤ ‖h‖ *
        (‖actualStageContinuousPivotEmbedding Y‖ * ‖v‖) :=
      mul_le_mul_of_nonneg_left
        ((actualStageContinuousPivotEmbedding Y).le_opNorm v)
        (norm_nonneg h)
    _ = (‖h‖ * ‖actualStageContinuousPivotEmbedding Y‖) * ‖v‖ := by
      ring

/-- Operator-norm version of the preceding estimate. -/
theorem norm_actualStagePivotToContinuousAntiDual_le
    (Y : ℝ) (h : ActualStagePivotHilbert Y) :
    ‖actualStagePivotToContinuousAntiDual Y h‖ ≤
      ‖h‖ * ‖actualStageContinuousPivotEmbedding Y‖ := by
  exact (actualStagePivotToContinuousAntiDual Y h).opNorm_le_bound
    (mul_nonneg (norm_nonneg h)
      (norm_nonneg (actualStageContinuousPivotEmbedding Y)))
    (norm_actualStagePivotToContinuousAntiDual_apply_le Y h)

/-- Density of the continuous core makes the Petersson anti-dual pairing
faithful.  This is independent of the stronger pointwise injectivity of `j`.
-/
theorem actualStagePivotToContinuousAntiDual_injective (Y : ℝ) :
    Function.Injective (actualStagePivotToContinuousAntiDual Y) := by
  intro h k hEq
  apply (InnerProductSpace.toDualMap ℂ
    (ActualStagePivotHilbert Y)).injective
  apply ContinuousLinearMap.ext_on
    (s := Set.range (actualStageContinuousPivotEmbedding Y))
    ((actualStageContinuousPivotEmbedding_denseRange Y).mono
      Submodule.subset_span)
  intro x hx
  rcases hx with ⟨v, rfl⟩
  simpa only [InnerProductSpace.toDualMap_apply_apply,
    actualStagePivotToContinuousAntiDual_apply] using
      congrArg
        (fun L : ActualStageContinuousFormDomain Y →L[ℂ] ℂ => L v)
        hEq

/-! ## 4. Pairing compatibility with the actual Petersson form -/

theorem actualStagePivotToContinuousAntiDual_eq_petersson
    (Y : ℝ) (h : ActualStagePivotHilbert Y)
    (v : ActualStageContinuousFormDomain Y) :
    actualStagePivotToContinuousAntiDual Y h v =
      QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStagePeterssonInner h
        (actualStageContinuousPivotEmbedding Y v) := by
  rfl

/-- Aggregate continuous-core pivot certificate. -/
theorem actualStageContinuousPivotCertificate
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    Function.Injective (actualStageContinuousPivotEmbedding Y) ∧
      DenseRange (actualStageContinuousPivotEmbedding Y) ∧
      (actualStageContinuousPivotEmbedding Y).ker = ⊥ ∧
      Function.Injective (actualStagePivotToContinuousAntiDual Y) ∧
      (∀ (h : ActualStagePivotHilbert Y)
          (v : ActualStageContinuousFormDomain Y),
        actualStagePivotToContinuousAntiDual Y h v =
          QYM.FullCertification.P3ActualStageL2SectionsExtension.actualStagePeterssonInner h
            (actualStageContinuousPivotEmbedding Y v)) := by
  exact
    ⟨actualStageContinuousPivotEmbedding_injective hY,
      actualStageContinuousPivotEmbedding_denseRange Y,
      actualStageContinuousPivotEmbedding_ker_eq_bot hY,
      actualStagePivotToContinuousAntiDual_injective Y,
      actualStagePivotToContinuousAntiDual_eq_petersson Y⟩

end QYM.FullCertification.P6ActualStageContinuousPivotExtension

