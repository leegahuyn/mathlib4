/-- A syntactic metadata classification: a nonempty human-maintained list of declaration-name
strings yields `sourceCandidate`.  This does not resolve those names or compare their theorem
statements with the corresponding PDF claim. -/
def currentMaturity (claim : ClaimId) : EvidenceMaturity :=
  if (supportingDeclarations claim).isEmpty then .inventoryOnly else .sourceCandidate

/-- Every one of the 58 manual rows now has at least one source-level declaration lead.  The
separate typed registries below are what turn selected leads into actual propositions and proofs. -/
theorem supportingDeclarations_nonempty (claim : ClaimId) :
    supportingDeclarations claim ≠ [] := by
  cases claim <;> decide

theorem currentMaturity_sourceCandidate (claim : ClaimId) :
    currentMaturity claim = .sourceCandidate := by
  cases claim <;> decide

/-- Terminal status is deliberately unearned for every row in this metadata registry. -/
def earnedTerminal (_claim : ClaimId) : Option TerminalClass := none

theorem no_terminal_status_earned (claim : ClaimId) : earnedTerminal claim = none := rfl

/-- One row of the auditable registry. -/
structure AuditRecord where
  id : ClaimId
  planned : TerminalClass
  maturity : EvidenceMaturity
  support : List String
  earned : Option TerminalClass
  deriving Repr

def record (claim : ClaimId) : AuditRecord where
  id := claim
  planned := plannedClass claim
  maturity := currentMaturity claim
  support := supportingDeclarations claim
  earned := earnedTerminal claim

def auditRegistry : List AuditRecord := allClaims.map record

theorem auditRegistry_length : auditRegistry.length = 58 := by decide

theorem auditRegistry_ids : auditRegistry.map AuditRecord.id = allClaims := by
  simp only [auditRegistry, List.map_map]
  change List.map (fun claim : ClaimId => claim) allClaims = allClaims
  rfl

theorem auditRegistry_has_no_earned_terminal :
    ∀ row ∈ auditRegistry, row.earned = none := by
  intro row hrow
  rcases List.mem_map.mp hrow with ⟨claim, _hclaim, rfl⟩
  rfl

end QYM.FullCertification.Registry

/-!
# A type-correct finite primal/dual gradient flow

The paper writes a negative-Sobolev gradient as though it could be added directly to a primal
velocity.  This finite model keeps the primal vector and its algebraic dual in different Lean
types.  An explicit Euclidean Riesz raise map is inserted before the flow equation, and the dual
pairing then gives the expected dissipation identity.
-/

namespace QYM.FiniteDualRieszFlow

abbrev Primal := Fin 2 → ℝ
abbrev Dual := Primal →ₗ[ℝ] ℝ

/-- Euclidean bilinear pairing on the primal coordinates. -/
def dot (x y : Primal) : ℝ := x 0 * y 0 + x 1 * y 1

/-- The first coordinate vector. -/
def basis0 : Primal := fun i => if i = 0 then 1 else 0

/-- The second coordinate vector. -/
def basis1 : Primal := fun i => if i = 1 then 1 else 0

/-- Every two-coordinate vector has its explicit standard-basis decomposition. -/
theorem standardBasis_decomposition (x : Primal) :
    x = x 0 • basis0 + x 1 • basis1 := by
  funext i
  fin_cases i <;> simp [basis0, basis1]

/-- Lower a primal vector to the dual using the Euclidean pairing. -/
def lower (x : Primal) : Dual where
  toFun y := dot x y
  map_add' y z := by
    simp [dot]
    ring
  map_smul' c y := by
    simp [dot]
    ring

@[simp]
theorem lower_apply (x y : Primal) : lower x y = dot x y := rfl

/-- Raise a dual functional by reading off its values on the standard basis. -/
def raise (f : Dual) : Primal := fun i => if i = 0 then f basis0 else f basis1

@[simp]
theorem raise_apply_zero (f : Dual) : raise f 0 = f basis0 := by
  simp [raise]

@[simp]
theorem raise_apply_one (f : Dual) : raise f 1 = f basis1 := by
  simp [raise]

/-- Every algebraic dual functional on this finite coordinate space is dot product with its
raised vector. -/
theorem dual_apply_eq_dot_raise (f : Dual) (x : Primal) :
    f x = dot (raise f) x := by
  calc
    f x = f (x 0 • basis0 + x 1 • basis1) := by
      rw [← standardBasis_decomposition x]
    _ = x 0 • f basis0 + x 1 • f basis1 := by
      rw [f.map_add, f.map_smul, f.map_smul]
    _ = x 0 * f basis0 + x 1 * f basis1 := by
      simp only [smul_eq_mul]
    _ = dot (raise f) x := by
      simp [dot]
      ring

/-- Raising after lowering is the identity on primal vectors. -/
theorem raise_lower (x : Primal) : raise (lower x) = x := by
  funext i
  fin_cases i <;> simp [raise, lower, dot, basis0, basis1]

/-- Lowering after raising is the identity on the algebraic dual. -/
theorem lower_raise (f : Dual) : lower (raise f) = f := by
  apply LinearMap.ext
  intro x
  change dot (raise f) x = f x
  exact (dual_apply_eq_dot_raise f x).symm

/-- Squared Euclidean norm of a primal vector. -/
def normSq (x : Primal) : ℝ := dot x x

theorem normSq_nonneg (x : Primal) : 0 ≤ normSq x := by
  simp only [normSq, dot]
  exact add_nonneg (mul_self_nonneg (x 0)) (mul_self_nonneg (x 1))

/-- Type-correct dual gradient flow: a dual gradient is raised before addition to velocity. -/
def SatisfiesDualGradientFlow (velocity : Primal) (gradient : Dual) : Prop :=
  velocity + raise gradient = 0

/-- The duality pairing of gradient with velocity is minus the squared Riesz-gradient norm. -/
theorem dualGradientFlow_dissipation
    {velocity : Primal} {gradient : Dual}
    (hflow : SatisfiesDualGradientFlow velocity gradient) :
    gradient velocity = -normSq (raise gradient) := by
  change velocity + raise gradient = 0 at hflow
  have hvelocity : velocity = -raise gradient :=
    eq_neg_of_add_eq_zero_left hflow
  rw [dual_apply_eq_dot_raise, hvelocity]
  simp [normSq, dot]
  ring

theorem dualGradientFlow_pairing_nonpos
    {velocity : Primal} {gradient : Dual}
    (hflow : SatisfiesDualGradientFlow velocity gradient) :
    gradient velocity ≤ 0 := by
  rw [dualGradientFlow_dissipation hflow]
  exact neg_nonpos.mpr (normSq_nonneg (raise gradient))

/-- If a separately established chain rule identifies the scalar energy derivative with the
primal/dual pairing, the derivative is nonpositive. -/
theorem energyDerivative_nonpos
    {velocity : Primal} {gradient : Dual} {energyDerivative : ℝ}
    (hchain : energyDerivative = gradient velocity)
    (hflow : SatisfiesDualGradientFlow velocity gradient) :
    energyDerivative ≤ 0 := by
  rw [hchain]
  exact dualGradientFlow_pairing_nonpos hflow

end QYM.FiniteDualRieszFlow




/-!
# Explicit diagonal perturbations of the finite two-level Hamiltonian

This is an operator-level finite model for the elementary two-eigenvalue perturbation estimate.
It makes no claim about perturbations of an unbounded continuum operator.
-/

namespace QYM.FiniteHamiltonian.DiagonalPerturbation

open QYM.FiniteHamiltonian

/-- Diagonal perturbation with shifts `δ₀` and `δ₁`. -/
def perturbation (δ₀ δ₁ : ℝ) : Vec2 →ₗ[ℝ] Vec2 where
  toFun x i := if i = 0 then δ₀ * x 0 else δ₁ * x 1
  map_add' x y := by
    funext i
    fin_cases i <;> simp [mul_add]
  map_smul' c x := by
    funext i
    fin_cases i <;> simp <;> ring

/-- The perturbed concrete Hamiltonian. -/
def perturbedHamiltonian (δ₀ δ₁ : ℝ) : Vec2 →ₗ[ℝ] Vec2 :=
  hamiltonian + perturbation δ₀ δ₁

@[simp]
theorem perturbedHamiltonian_apply_zero (δ₀ δ₁ : ℝ) (x : Vec2) :
    perturbedHamiltonian δ₀ δ₁ x 0 = (groundEigenvalue + δ₀) * x 0 := by
  simp [perturbedHamiltonian, perturbation, hamiltonian, groundEigenvalue]
  ring

@[simp]
theorem perturbedHamiltonian_apply_one (δ₀ δ₁ : ℝ) (x : Vec2) :
    perturbedHamiltonian δ₀ δ₁ x 1 = (excitedEigenvalue + δ₁) * x 1 := by
  simp [perturbedHamiltonian, perturbation, hamiltonian, excitedEigenvalue]
  ring

def perturbedGroundLevel (δ₀ : ℝ) : ℝ := groundEigenvalue + δ₀

def perturbedExcitedLevel (δ₁ : ℝ) : ℝ := excitedEigenvalue + δ₁

theorem basis0_perturbed_eigenpair (δ₀ δ₁ : ℝ) :
    basis0 ≠ 0 ∧
      perturbedHamiltonian δ₀ δ₁ basis0 = perturbedGroundLevel δ₀ • basis0 := by
  refine ⟨basis0_ne_zero, ?_⟩
  funext i
  fin_cases i <;>
    simp [perturbedHamiltonian, perturbation, hamiltonian, perturbedGroundLevel,
      groundEigenvalue, basis0]

theorem basis1_perturbed_eigenpair (δ₀ δ₁ : ℝ) :
    basis1 ≠ 0 ∧
      perturbedHamiltonian δ₀ δ₁ basis1 = perturbedExcitedLevel δ₁ • basis1 := by
  refine ⟨basis1_ne_zero, ?_⟩
  funext i
  fin_cases i <;>
    simp [perturbedHamiltonian, perturbation, hamiltonian, perturbedExcitedLevel,
      excitedEigenvalue, basis1]

/-- Every eigenvalue of the perturbed diagonal map is one of its two displayed levels. -/
theorem perturbed_eigenvalue_classification
    (δ₀ δ₁ : ℝ) {lambda : ℝ} {x : Vec2}
    (hx : x ≠ 0)
    (heigen : perturbedHamiltonian δ₀ δ₁ x = lambda • x) :
    lambda = perturbedGroundLevel δ₀ ∨ lambda = perturbedExcitedLevel δ₁ := by
  have hcoord : x 0 ≠ 0 ∨ x 1 ≠ 0 := by
    by_contra h
    push_neg at h
    apply hx
    funext i
    fin_cases i
    · exact h.1
    · exact h.2
  rcases hcoord with h0 | h1
  · left
    have heq : (groundEigenvalue + δ₀) * x 0 = lambda * x 0 := by
      simpa using congrFun heigen (0 : Fin 2)
    have hcancel : x 0 * (groundEigenvalue + δ₀) = x 0 * lambda := by
      calc
        x 0 * (groundEigenvalue + δ₀) = (groundEigenvalue + δ₀) * x 0 := mul_comm _ _
        _ = lambda * x 0 := heq
        _ = x 0 * lambda := mul_comm _ _
    simpa [perturbedGroundLevel] using (mul_left_cancel₀ h0 hcancel).symm
  · right
    have heq : (excitedEigenvalue + δ₁) * x 1 = lambda * x 1 := by
      simpa using congrFun heigen (1 : Fin 2)
    have hcancel : x 1 * (excitedEigenvalue + δ₁) = x 1 * lambda := by
      calc
        x 1 * (excitedEigenvalue + δ₁) = (excitedEigenvalue + δ₁) * x 1 := mul_comm _ _
        _ = lambda * x 1 := heq
        _ = x 1 * lambda := mul_comm _ _
    simpa [perturbedExcitedLevel] using (mul_left_cancel₀ h1 hcancel).symm

/-- Difference of the two displayed perturbed levels. -/
def perturbedGap (δ₀ δ₁ : ℝ) : ℝ :=
  perturbedExcitedLevel δ₁ - perturbedGroundLevel δ₀

theorem perturbedGap_formula (δ₀ δ₁ : ℝ) :
    perturbedGap δ₀ δ₁ = (1 / 2 : ℝ) + (δ₁ - δ₀) := by
  simp [perturbedGap, perturbedExcitedLevel, perturbedGroundLevel,
    excitedEigenvalue, groundEigenvalue]
  ring

/-- Two coordinate shifts of absolute size at most `ε` can shrink the displayed gap by at most
`2ε`. -/
theorem perturbedGap_lower_bound
    {δ₀ δ₁ ε : ℝ} (hδ₀ : |δ₀| ≤ ε) (hδ₁ : |δ₁| ≤ ε) :
    (1 / 2 : ℝ) - 2 * ε ≤ perturbedGap δ₀ δ₁ := by
  have hδ₀_upper : δ₀ ≤ ε := (abs_le.mp hδ₀).2
  have hδ₁_lower : -ε ≤ δ₁ := (abs_le.mp hδ₁).1
  rw [perturbedGap_formula]
  linarith

/-- If `ε < 1/4`, the two displayed perturbed eigenlevels remain strictly separated. -/
theorem perturbedGap_pos
    {δ₀ δ₁ ε : ℝ} (hε : ε < (1 / 4 : ℝ))
    (hδ₀ : |δ₀| ≤ ε) (hδ₁ : |δ₁| ≤ ε) :
    0 < perturbedGap δ₀ δ₁ := by
  have hbound := perturbedGap_lower_bound hδ₀ hδ₁
  linarith

end QYM.FiniteHamiltonian.DiagonalPerturbation




open scoped ComplexOrder

/-!
# A concrete nontrivial inner-modular weighted-trace witness

The scalar map `Y ↦ qY` cannot be a unital algebra automorphism for `q ≠ 1`.  The corrected finite
model instead uses the inner automorphism `Y ↦ ρ⁻¹Yρ`.  It can have nontrivial eigenvectors: for
`ρ = diag(2,1)`, the matrix unit `e₀₁` has eigenvalue `1/2`.

This is a finite matrix-algebra witness only.  It does not construct the paper's global analytic
weight, Hilbert-space modular operator, or modular spectral theory.
-/

namespace QYM.WeightedTraceCore.SkewAdjointCounterexample

/-! The inner twist has the algebra laws that the impossible global scalar map lacks. -/

theorem modularTwist_eq_gconj {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) (X : Square n) :
    modularTwist rho X = gconj rho X := rfl

theorem modularTwist_add {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) (X Y : Square n) :
    modularTwist rho (X + Y) = modularTwist rho X + modularTwist rho Y := by
  change gconj rho (X + Y) = gconj rho X + gconj rho Y
  exact gconj_add rho X Y

theorem modularTwist_mul {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) (X Y : Square n) :
    modularTwist rho (X * Y) = modularTwist rho X * modularTwist rho Y := by
  change gconj rho (X * Y) = gconj rho X * gconj rho Y
  exact gconj_mul rho X Y

theorem modularTwist_one {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) :
    modularTwist rho 1 = 1 := by
  simp [modularTwist, Matrix.mul_assoc]

theorem modularTwist_inverse_apply {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) (X : Square n) :
    modularTwist rho⁻¹ (modularTwist rho X) = X := by
  simp [modularTwist, Matrix.mul_assoc]

/-- The inner twist bundled as an actual ring automorphism. -/
def modularTwistRingEquiv {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) : Square n ≃+* Square n where
  toFun := modularTwist rho
  invFun := modularTwist rho⁻¹
  left_inv := modularTwist_inverse_apply rho
  right_inv X := by
    simpa using modularTwist_inverse_apply rho⁻¹ X
  map_add' := modularTwist_add rho
  map_mul' := modularTwist_mul rho

theorem modularTwist_injective {n : Type*} [Fintype n] [DecidableEq n]
    (rho : (Square n)ˣ) :
    Function.Injective (modularTwist rho) := by
  exact (modularTwistRingEquiv rho).injective

theorem e01_ne_zero : e01 ≠ 0 := by
  intro h
  have h01 := congrFun (congrFun h (0 : Fin 2)) (1 : Fin 2)
  norm_num [e01] at h01

/-- The inner modular twist is genuinely nontrivial on `e₀₁`. -/
theorem modularTwist_e01 :
    modularTwist positiveDiagonalDensity e01 = (1 / 2 : ℂ) • e01 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [modularTwist, positiveDiagonalDensity, e01,
      Matrix.mul_apply, Fin.sum_univ_two]

theorem modularTwistRingEquiv_e01 :
    modularTwistRingEquiv positiveDiagonalDensity e01 = (1 / 2 : ℂ) • e01 :=
  modularTwist_e01

theorem half_complex_ne_one : (1 / 2 : ℂ) ≠ 1 := by
  norm_num

theorem modularTwist_e01_ne_e01 :
    modularTwist positiveDiagonalDensity e01 ≠ e01 := by
  rw [modularTwist_e01]
  intro h
  have h01 := congrFun (congrFun h (0 : Fin 2)) (1 : Fin 2)
  norm_num [e01] at h01

/-- The weighted trace is nonzero in the same concrete model. -/
theorem weightedTrace_e00 : weightedTrace positiveDiagonalDensity e00 = 2 := by
  norm_num [weightedTrace, positiveDiagonalDensity, e00,
    Matrix.trace_fin_two, Matrix.mul_apply, Fin.sum_univ_two]

theorem weightedTrace_e00_ne_zero :
    weightedTrace positiveDiagonalDensity e00 ≠ 0 := by
  rw [weightedTrace_e00]
  norm_num

/-- A single finite certificate collecting nonemptiness, nontrivial modular eigenvalue, nonzero
weighted trace, and positive-definite density.  The eigenvalue equation is only for the displayed
matrix vector; it does not turn scalar multiplication by `1/2` into a unital automorphism.
-/
theorem concrete_nontrivial_innerModular_certificate :
    e01 ≠ 0 ∧
      (1 / 2 : ℂ) ≠ 1 ∧
      modularTwist positiveDiagonalDensity e01 = (1 / 2 : ℂ) • e01 ∧
      weightedTrace positiveDiagonalDensity e00 ≠ 0 ∧
      ((positiveDiagonalDensity : Mat2)).PosDef := by
  exact ⟨e01_ne_zero, half_complex_ne_one, modularTwist_e01,
    weightedTrace_e00_ne_zero, positiveDiagonalDensity_posDef⟩

end QYM.WeightedTraceCore.SkewAdjointCounterexample



/-!
# Correct real scalar parameter charts above and below the quarter threshold

The formula `lambda = 1/4 + t²` with real `t` covers only `lambda ≥ 1/4`.  The complementary real chart is
`lambda = 1/4 - κ²`.  These elementary construction theorems make that split explicit.

They classify arbitrary real numbers relative to `1/4`; they do not construct an eigenvalue,
spectral operator, automorphic spectrum, or the paper's analytic spectral parametrization.
-/

namespace QYM.FullCertification.Corrected.SpectralParameter

/-- Every level at or above `1/4` has a nonnegative real oscillatory parameter. -/
theorem exists_real_parameter_above_quarter
    {lambda : ℝ} (hlambda : (1 / 4 : ℝ) ≤ lambda) :
    ∃ t : ℝ, 0 ≤ t ∧ lambda = (1 / 4 : ℝ) + t ^ 2 := by
  let t := Real.sqrt (lambda - (1 / 4 : ℝ))
  have hnonneg : 0 ≤ lambda - (1 / 4 : ℝ) := sub_nonneg.mpr hlambda
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = lambda - (1 / 4 : ℝ) := by
    simpa [t] using Real.sq_sqrt hnonneg
  exact ⟨t, ht_nonneg, by linarith⟩

/-- Every level at or below `1/4` has a nonnegative real decay parameter. -/
theorem exists_decay_parameter_below_quarter
    {lambda : ℝ} (hlambda : lambda ≤ (1 / 4 : ℝ)) :
    ∃ kappa : ℝ, 0 ≤ kappa ∧ lambda = (1 / 4 : ℝ) - kappa ^ 2 := by
  let kappa := Real.sqrt ((1 / 4 : ℝ) - lambda)
  have hnonneg : 0 ≤ (1 / 4 : ℝ) - lambda := sub_nonneg.mpr hlambda
  have hkappa_nonneg : 0 ≤ kappa := Real.sqrt_nonneg _
  have hkappa_sq : kappa ^ 2 = (1 / 4 : ℝ) - lambda := by
    simpa [kappa] using Real.sq_sqrt hnonneg
  exact ⟨kappa, hkappa_nonneg, by linarith⟩

/-- Strictly above the threshold gives a strictly positive oscillatory parameter. -/
theorem exists_pos_real_parameter_above_quarter
    {lambda : ℝ} (hlambda : (1 / 4 : ℝ) < lambda) :
    ∃ t : ℝ, 0 < t ∧ lambda = (1 / 4 : ℝ) + t ^ 2 := by
  let t := Real.sqrt (lambda - (1 / 4 : ℝ))
  have hpos : 0 < lambda - (1 / 4 : ℝ) := sub_pos.mpr hlambda
  have ht_pos : 0 < t := by
    simpa [t] using Real.sqrt_pos.2 hpos
  have ht_sq : t ^ 2 = lambda - (1 / 4 : ℝ) := by
    simpa [t] using Real.sq_sqrt hpos.le
  exact ⟨t, ht_pos, by linarith⟩

/-- Strictly below the threshold gives a strictly positive decay parameter. -/
theorem exists_pos_decay_parameter_below_quarter
    {lambda : ℝ} (hlambda : lambda < (1 / 4 : ℝ)) :
    ∃ kappa : ℝ, 0 < kappa ∧ lambda = (1 / 4 : ℝ) - kappa ^ 2 := by
  let kappa := Real.sqrt ((1 / 4 : ℝ) - lambda)
  have hpos : 0 < (1 / 4 : ℝ) - lambda := sub_pos.mpr hlambda
  have hkappa_pos : 0 < kappa := by
    simpa [kappa] using Real.sqrt_pos.2 hpos
  have hkappa_sq : kappa ^ 2 = (1 / 4 : ℝ) - lambda := by
    simpa [kappa] using Real.sq_sqrt hpos.le
  exact ⟨kappa, hkappa_pos, by linarith⟩

/-- Every real number lies in at least one of the two scalar threshold charts. -/
theorem real_parameter_chart_split (lambda : ℝ) :
    (∃ t : ℝ, 0 ≤ t ∧ lambda = (1 / 4 : ℝ) + t ^ 2) ∨
      (∃ kappa : ℝ, 0 ≤ kappa ∧ lambda = (1 / 4 : ℝ) - kappa ^ 2) := by
  rcases le_total (1 / 4 : ℝ) lambda with habove | hbelow
  · exact Or.inl (exists_real_parameter_above_quarter habove)
  · exact Or.inr (exists_decay_parameter_below_quarter hbelow)

end QYM.FullCertification.Corrected.SpectralParameter

namespace QYM.InfiniteDiagonalHamiltonian

/-- Any nonzero eigenvector of the corrected diagonal map has an eigenvalue equal to one of its
displayed diagonal coefficients. -/
theorem corrected_eigenvalue_eq_coefficient
    (v : ℕ → ℝ) {lambda : ℝ} {x : State}
    (hx : x ≠ 0)
    (heigen : correctedHamiltonian v x = lambda • x) :
    ∃ n : ℕ, x n ≠ 0 ∧ lambda = (n : ℝ) + v n := by
  have hcoord : ∃ n : ℕ, x n ≠ 0 := by
    by_contra hcoord
    apply hx
    funext n
    by_contra hn
    exact hcoord ⟨n, hn⟩
  obtain ⟨n, hn⟩ := hcoord
  refine ⟨n, hn, ?_⟩
  have heq : ((n : ℝ) + v n) * x n = lambda * x n := by
    simpa using congrFun heigen n
  have hcancel : x n * ((n : ℝ) + v n) = x n * lambda := by
    calc
      x n * ((n : ℝ) + v n) = ((n : ℝ) + v n) * x n := mul_comm _ _
      _ = lambda * x n := heq
      _ = x n * lambda := mul_comm _ _
  exact (mul_left_cancel₀ hn hcancel).symm

/-- With the corrected kinetic sign, a potential bounded below yields an eigenvalue lower bound
for every nonzero algebraic eigenpair of the diagonal model. -/
theorem corrected_hasEigenvalueLowerBound_of_potential_boundedBelow
    (v : ℕ → ℝ) (m : ℝ) (hv : ∀ n, m ≤ v n) :
    HasEigenvalueLowerBound (correctedHamiltonian v) := by
  refine ⟨m, ?_⟩
  intro lambda x hx heigen
  obtain ⟨n, _hxn, hlambda⟩ :=
    corrected_eigenvalue_eq_coefficient v hx heigen
  have hn_nonneg : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
  rw [hlambda]
  linarith [hv n]

end QYM.InfiniteDiagonalHamiltonian

/-!
# Constant ring-valued forms in two dimensions

This module is a concrete degree-by-degree model of constant forms with coefficients in an
arbitrary, possibly noncommutative, ring.  Degree zero is `R`, degree one is `R × R`, and degree
two is `R`.  The differentials vanish because the coefficients are constant, while the exterior
product of one-forms is the explicit determinant expression
`A₁ * B₂ - A₂ * B₁`.

This is not a construction on the paper's quotient, Sobolev space, gauge slice, or differential
graded algebra of fields.  The conjugations below use one constant ring unit, so there is no
inhomogeneous `g⁻¹ dg` term.  No analytic or paper-specific conclusion is stored in an assumption.
-/

namespace QYM.ConstantTwoDimensionalDGA

abbrev Form0 (R : Type*) := R
abbrev Form1 (R : Type*) := R × R
abbrev Form2 (R : Type*) := R

section RingCoefficients

variable {R : Type*} [Ring R]

/-! ## Constant differential complex -/

/-- The differential of a constant zero-form. -/
def d0 : Form0 R →+ Form1 R := 0

/-- The differential of a constant one-form. -/
def d1 : Form1 R →+ Form2 R := 0

@[simp]
theorem d0_apply (a : Form0 R) : d0 a = (0 : Form1 R) := rfl

@[simp]
theorem d1_apply (A : Form1 R) : d1 A = (0 : Form2 R) := rfl

/-- The only nontrivial consecutive composite in degrees `0,1,2` is zero. -/
theorem d_squared_zero (a : Form0 R) : d1 (d0 a) = (0 : Form2 R) := by
  simp

/-- The same `d² = 0` statement at the level of bundled additive homomorphisms. -/
theorem d1_comp_d0 :
    (d1 (R := R)).comp (d0 (R := R)) = 0 := by
  ext a
  simp

/-! ## Explicit truncated exterior products -/

def wedge00 (a b : Form0 R) : Form0 R := a * b

def wedge01 (a : Form0 R) (A : Form1 R) : Form1 R :=
  (a * A.1, a * A.2)

def wedge10 (A : Form1 R) (a : Form0 R) : Form1 R :=
  (A.1 * a, A.2 * a)

def wedge02 (a : Form0 R) (F : Form2 R) : Form2 R := a * F

def wedge20 (F : Form2 R) (a : Form0 R) : Form2 R := F * a

/-- Exterior product of two constant one-forms in the oriented coordinate basis. -/
def wedge11 (A B : Form1 R) : Form2 R :=
  A.1 * B.2 - A.2 * B.1

theorem wedge01_assoc (a b : Form0 R) (A : Form1 R) :
    wedge01 (wedge00 a b) A = wedge01 a (wedge01 b A) := by
  ext <;> simp [wedge00, wedge01, mul_assoc]

theorem wedge10_assoc (A : Form1 R) (a b : Form0 R) :
    wedge10 (wedge10 A a) b = wedge10 A (wedge00 a b) := by
  ext <;> simp [wedge00, wedge10, mul_assoc]

/-- A zero-form can be moved through the balanced tensor position between two one-forms. -/
theorem wedge11_balanced (A B : Form1 R) (a : Form0 R) :
    wedge11 (wedge10 A a) B = wedge11 A (wedge01 a B) := by
  simp [wedge01, wedge10, wedge11, mul_assoc]

theorem wedge11_left_action (a : Form0 R) (A B : Form1 R) :
    wedge02 a (wedge11 A B) = wedge11 (wedge01 a A) B := by
  simp [wedge01, wedge02, wedge11, mul_sub, mul_assoc]

theorem wedge11_right_action (A B : Form1 R) (a : Form0 R) :
    wedge20 (wedge11 A B) a = wedge11 A (wedge10 B a) := by
  simp [wedge10, wedge20, wedge11, sub_mul, mul_assoc]

/-! The following are the graded Leibniz identities whose outputs remain in degrees at most two. -/

theorem leibniz00 (a b : Form0 R) :
    d0 (wedge00 a b) = wedge10 (d0 a) b + wedge01 a (d0 b) := by
  ext <;> simp [d0, wedge00, wedge01, wedge10]

theorem leibniz01 (a : Form0 R) (A : Form1 R) :
    d1 (wedge01 a A) = wedge11 (d0 a) A + wedge02 a (d1 A) := by
  simp [d0, d1, wedge01, wedge02, wedge11]

/-- The minus sign is the degree-one sign in the graded Leibniz rule. -/
theorem leibniz10 (A : Form1 R) (a : Form0 R) :
    d1 (wedge10 A a) = wedge20 (d1 A) a - wedge11 A (d0 a) := by
  simp [d0, d1, wedge10, wedge20, wedge11]

/-! ## Explicit nontriviality -/

def dx (R : Type*) [Ring R] : Form1 R := (1, 0)

def dy (R : Type*) [Ring R] : Form1 R := (0, 1)

@[simp]
theorem wedge11_dx_dy : wedge11 (dx R) (dy R) = (1 : Form2 R) := by
  simp [dx, dy, wedge11]

@[simp]
theorem wedge11_dy_dx : wedge11 (dy R) (dx R) = (-1 : Form2 R) := by
  simp [dx, dy, wedge11]

@[simp]
theorem wedge11_dx_dx : wedge11 (dx R) (dx R) = (0 : Form2 R) := by
  simp [dx, wedge11]

/-- In every nontrivial coefficient ring the one-form exterior product is genuinely nonzero. -/
theorem exists_wedge11_ne_zero [Nontrivial R] :
    ∃ A B : Form1 R, wedge11 A B ≠ 0 := by
  refine ⟨dx R, dy R, ?_⟩
  simpa using (one_ne_zero : (1 : R) ≠ 0)

/-! ## Constant unit conjugation and covariance -/

/-- Conjugation of a coefficient by one constant ring unit. -/
def conj0 (g : Rˣ) (a : Form0 R) : Form0 R :=
  (↑g⁻¹ : R) * a * (↑g : R)

/-- Componentwise conjugation of a constant one-form. -/
def conj1 (g : Rˣ) (A : Form1 R) : Form1 R :=
  (conj0 g A.1, conj0 g A.2)

/-- Conjugation of a constant top-degree coefficient. -/
def conj2 (g : Rˣ) (F : Form2 R) : Form2 R := conj0 g F

theorem conj0_add (g : Rˣ) (a b : Form0 R) :
    conj0 g (a + b) = conj0 g a + conj0 g b := by
  simp only [conj0, mul_add, add_mul]

theorem conj0_sub (g : Rˣ) (a b : Form0 R) :
    conj0 g (a - b) = conj0 g a - conj0 g b := by
  simp only [conj0, mul_sub, sub_mul]

theorem conj0_mul (g : Rˣ) (a b : Form0 R) :
    conj0 g (a * b) = conj0 g a * conj0 g b := by
  simp only [conj0, mul_assoc, Units.mul_inv_cancel_left]

@[simp]
theorem d0_conj0 (g : Rˣ) (a : Form0 R) :
    d0 (conj0 g a) = conj1 g (d0 a) := by
  ext <;> simp [d0, conj0, conj1]

@[simp]
theorem d1_conj1 (g : Rˣ) (A : Form1 R) :
    d1 (conj1 g A) = conj2 g (d1 A) := by
  simp [d1, conj0, conj2]

/-- The explicit one-form wedge is covariant under constant componentwise conjugation. -/
theorem wedge11_covariant (g : Rˣ) (A B : Form1 R) :
    conj2 g (wedge11 A B) = wedge11 (conj1 g A) (conj1 g B) := by
  change
    conj0 g (A.1 * B.2 - A.2 * B.1) =
      conj0 g A.1 * conj0 g B.2 - conj0 g A.2 * conj0 g B.1
  calc
    conj0 g (A.1 * B.2 - A.2 * B.1) =
        conj0 g (A.1 * B.2) - conj0 g (A.2 * B.1) := conj0_sub g _ _
    _ = conj0 g A.1 * conj0 g B.2 - conj0 g A.2 * conj0 g B.1 := by
      rw [conj0_mul, conj0_mul]

/-! ## Constant curvature and the degree-one graded bracket -/

/-- Constant curvature `dA + A ∧ A`; here `dA = 0` definitionally. -/
def curvature (A : Form1 R) : Form2 R :=
  d1 A + wedge11 A A

@[simp]
theorem curvature_eq_wedge11 (A : Form1 R) : curvature A = wedge11 A A := by
  simp [curvature]

theorem curvature_eq_commutator (A : Form1 R) :
    curvature A = A.1 * A.2 - A.2 * A.1 := by
  simp [curvature, wedge11]

/-- Constant curvature transforms homogeneously under constant unit conjugation. -/
theorem curvature_covariant (g : Rˣ) (A : Form1 R) :
    curvature (conj1 g A) = conj2 g (curvature A) := by
  simpa only [curvature_eq_wedge11] using (wedge11_covariant g A A).symm

/-- For degree-one inputs, the graded commutator uses a plus sign:
`[A,B] = A ∧ B - (-1)^(1*1) B ∧ A = A ∧ B + B ∧ A`. -/
def gradedBracket11 (A B : Form1 R) : Form2 R :=
  wedge11 A B + wedge11 B A

theorem gradedBracket11_self_eq_double (A : Form1 R) :
    gradedBracket11 A A = wedge11 A A + wedge11 A A := rfl

/-- Sound normalization over every ring; no division by two is used. -/
theorem gradedBracket11_self_eq_two_mul (A : Form1 R) :
    gradedBracket11 A A = (2 : R) * wedge11 A A := by
  rw [gradedBracket11_self_eq_double]
  exact (two_mul (wedge11 A A)).symm

theorem gradedBracket11_self_curvature (A : Form1 R) :
    gradedBracket11 A A = (2 : R) * curvature A := by
  rw [gradedBracket11_self_eq_two_mul, curvature_eq_wedge11]

end RingCoefficients

/-! ## Explicit noncommutative matrix-valued curvature -/

namespace MatrixWitness

abbrev Mat2 := Matrix (Fin 2) (Fin 2) ℤ

def e01 : Mat2 := !![(0 : ℤ), 1; 0, 0]

def e10 : Mat2 := !![(0 : ℤ), 0; 1, 0]

def connection : Form1 Mat2 := (e01, e10)

def expectedCurvature : Mat2 := !![(1 : ℤ), 0; 0, -1]

/-- The self-wedge of the displayed matrix-valued one-form is the nonzero commutator
`diag(1,-1)`. -/
theorem curvature_connection : curvature connection = expectedCurvature := by
  rw [curvature_eq_wedge11]
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [wedge11, connection, e01, e10, expectedCurvature,
      Matrix.mul_apply, Fin.sum_univ_two]

theorem curvature_connection_ne_zero : curvature connection ≠ 0 := by
  intro h
  rw [curvature_connection] at h
  have h00 := congrFun (congrFun h (0 : Fin 2)) (0 : Fin 2)
  norm_num [expectedCurvature] at h00

end MatrixWitness

end QYM.ConstantTwoDimensionalDGA

/-!
# Explicit projection and two-level Rayleigh bounds

This finite module constructs the orthogonal projection onto the exact ground eigenspace of the
concrete two-level Hamiltonian.  It proves idempotence, symmetry, orthogonal decomposition,
Hamiltonian commutation, and the lower/upper Rayleigh bounds on the algebraic unit sphere.

These results are finite-dimensional coordinate theorems.  They do not construct the paper's
Coulomb projection, unbounded operator, or continuum min--max principle.
-/

namespace QYM.FiniteHamiltonian.Projection

open QYM.FiniteHamiltonian

/-- Coordinate projection onto the first-axis ground eigenspace. -/
def projection0 : Vec2 →ₗ[ℝ] Vec2 where
  toFun x i := if i = 0 then x 0 else 0
  map_add' x y := by
    funext i
    fin_cases i <;> simp
  map_smul' c x := by
    funext i
    fin_cases i <;> simp

@[simp]
theorem projection0_apply_zero (x : Vec2) : projection0 x 0 = x 0 := by
  simp [projection0]

@[simp]
theorem projection0_apply_one (x : Vec2) : projection0 x 1 = 0 := by
  simp [projection0]

theorem projection0_idempotent (x : Vec2) :
    projection0 (projection0 x) = projection0 x := by
  funext i
  fin_cases i <;> simp

theorem projection0_fixed_iff (x : Vec2) :
    projection0 x = x ↔ x 1 = 0 := by
  constructor
  · intro h
    have h1 := congrFun h (1 : Fin 2)
    simpa using h1.symm
  · intro h1
    funext i
    fin_cases i <;> simp [h1]

theorem projection0_eq_zero_iff (x : Vec2) :
    projection0 x = 0 ↔ x 0 = 0 := by
  constructor
  · intro h
    have h0 := congrFun h (0 : Fin 2)
    simpa using h0
  · intro h0
    funext i
    fin_cases i <;> simp [h0]

/-- The coordinate projection is symmetric for the explicit Euclidean dot product. -/
theorem projection0_dot_symmetric (x y : Vec2) :
    dot (projection0 x) y = dot x (projection0 y) := by
  simp [dot, projection0]

/-- The projection commutes with the concrete diagonal Hamiltonian. -/
theorem projection0_commutes_hamiltonian (x : Vec2) :
    projection0 (hamiltonian x) = hamiltonian (projection0 x) := by
  funext i
  fin_cases i <;> simp [projection0, hamiltonian]

/-- The projected vector lies in the complete ground eigenspace. -/
theorem projection0_is_ground_eigenvector (x : Vec2) :
    hamiltonian (projection0 x) = groundEigenvalue • projection0 x := by
  rw [ground_eigenvector_iff]
  simp

theorem normSq_nonneg (x : Vec2) : 0 ≤ normSq x := by
  rw [normSq_formula]
  exact add_nonneg (sq_nonneg (x 0)) (sq_nonneg (x 1))

theorem normSq_eq_zero_iff (x : Vec2) : normSq x = 0 ↔ x = 0 := by
  rw [normSq_formula]
  constructor
  · intro h
    have h0sq : x 0 ^ 2 = 0 := by
      nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
    have h1sq : x 1 ^ 2 = 0 := by
      nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
    have h0 : x 0 = 0 := sq_eq_zero_iff.mp h0sq
    have h1 : x 1 = 0 := sq_eq_zero_iff.mp h1sq
    funext i
    fin_cases i
    · exact h0
    · exact h1
  · rintro rfl
    simp [normSq, dot]

theorem normSq_pos_of_ne_zero {x : Vec2} (hx : x ≠ 0) : 0 < normSq x := by
  have hnonneg := normSq_nonneg x
  have hne : normSq x ≠ 0 := by
    intro hzero
    exact hx ((normSq_eq_zero_iff x).mp hzero)
  exact lt_of_le_of_ne hnonneg (Ne.symm hne)

theorem normSq_projection0 (x : Vec2) :
    normSq (projection0 x) = x 0 ^ 2 := by
  simp [normSq, dot, projection0, pow_two]

theorem projection0_normSq_le (x : Vec2) :
    normSq (projection0 x) ≤ normSq x := by
  rw [normSq_projection0, normSq_formula]
  nlinarith [sq_nonneg (x 1)]

/-- The projected part is orthogonal to the discarded coordinate. -/
theorem projection0_orthogonal_remainder (x : Vec2) :
    dot (projection0 x) (x - projection0 x) = 0 := by
  simp [dot, projection0]

/-- Exact Pythagorean decomposition for the projection. -/
theorem projection0_pythagoras (x : Vec2) :
    normSq x = normSq (projection0 x) + normSq (x - projection0 x) := by
  simp [normSq, dot, projection0]

/-- Upper quadratic-form bound by the excited eigenlevel. -/
theorem energy_upper (x : Vec2) :
    energy x ≤ excitedEigenvalue * normSq x := by
  rw [energy_formula, normSq_formula]
  unfold excitedEigenvalue
  nlinarith [sq_nonneg (x 0)]

theorem energy_eq_excited_mul_normSq_iff (x : Vec2) :
    energy x = excitedEigenvalue * normSq x ↔ x 0 = 0 := by
  rw [energy_formula, normSq_formula]
  unfold excitedEigenvalue
  constructor
  · intro h
    have hsq : x 0 ^ 2 = 0 := by
      nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
    exact sq_eq_zero_iff.mp hsq
  · intro h0
    rw [h0]
    ring

/-- Rayleigh quotient of a nonzero vector; it is defined on all vectors for convenience, while
the bounds below require a nonzero denominator. -/
def rayleighQuotient (x : Vec2) : ℝ := energy x / normSq x

theorem rayleighQuotient_lower {x : Vec2} (hx : x ≠ 0) :
    groundEigenvalue ≤ rayleighQuotient x := by
  rw [rayleighQuotient]
  exact (le_div_iff₀ (normSq_pos_of_ne_zero hx)).2 (ground_energy_lower x)

theorem rayleighQuotient_upper {x : Vec2} (hx : x ≠ 0) :
    rayleighQuotient x ≤ excitedEigenvalue := by
  rw [rayleighQuotient]
  exact (div_le_iff₀ (normSq_pos_of_ne_zero hx)).2 (energy_upper x)

theorem rayleighQuotient_bounds {x : Vec2} (hx : x ≠ 0) :
    groundEigenvalue ≤ rayleighQuotient x ∧
      rayleighQuotient x ≤ excitedEigenvalue :=
  ⟨rayleighQuotient_lower hx, rayleighQuotient_upper hx⟩

def IsAlgebraicUnit (x : Vec2) : Prop := normSq x = 1

theorem basis0_isAlgebraicUnit : IsAlgebraicUnit basis0 := by
  norm_num [IsAlgebraicUnit, normSq, dot, basis0]

theorem basis1_isAlgebraicUnit : IsAlgebraicUnit basis1 := by
  norm_num [IsAlgebraicUnit, normSq, dot, basis1]

theorem energy_basis0 : energy basis0 = groundEigenvalue := by
  norm_num [energy, dot, hamiltonian, basis0, groundEigenvalue]

theorem energy_basis1 : energy basis1 = excitedEigenvalue := by
  norm_num [energy, dot, hamiltonian, basis1, excitedEigenvalue]

/-- Exact two-sided Rayleigh bounds on the algebraic unit sphere. -/
theorem unit_energy_bounds {x : Vec2} (hx : IsAlgebraicUnit x) :
    groundEigenvalue ≤ energy x ∧ energy x ≤ excitedEigenvalue := by
  constructor
  · have h := ground_energy_lower x
    rw [hx, mul_one] at h
    exact h
  · have h := energy_upper x
    rw [hx, mul_one] at h
    exact h

/-- `basis0` realizes the minimum of the energy on the algebraic unit sphere. -/
theorem basis0_minimizes_unit_energy :
    IsAlgebraicUnit basis0 ∧
      ∀ x : Vec2, IsAlgebraicUnit x → energy basis0 ≤ energy x := by
  refine ⟨basis0_isAlgebraicUnit, ?_⟩
  intro x hx
  rw [energy_basis0]
  exact (unit_energy_bounds hx).1

/-- `basis1` realizes the maximum of the energy on the algebraic unit sphere. -/
theorem basis1_maximizes_unit_energy :
    IsAlgebraicUnit basis1 ∧
      ∀ x : Vec2, IsAlgebraicUnit x → energy x ≤ energy basis1 := by
  refine ⟨basis1_isAlgebraicUnit, ?_⟩
  intro x hx
  rw [energy_basis1]
  exact (unit_energy_bounds hx).2

end QYM.FiniteHamiltonian.Projection

/-!
# A concrete dissipative two-mode Galerkin vector field

The cubic term below is a scalar multiple of the skew coordinate rotation, so its Euclidean
pairing with the state vanishes identically.  Adding it to the negative concrete Hamiltonian gives
an exact finite energy-dissipation identity and a unique equilibrium.

This is an algebraic finite vector field.  It does not prove existence of the paper's PDE flow or
convergence of a Galerkin scheme to that PDE.
-/

namespace QYM.FiniteGalerkinDissipation

open QYM.FiniteHamiltonian
open QYM.FiniteHamiltonian.Projection

/-- The standard skew rotation `(x₀,x₁) ↦ (-x₁,x₀)`. -/
def rotation : Vec2 →ₗ[ℝ] Vec2 where
  toFun x i := if i = 0 then -x 1 else x 0
  map_add' x y := by
    funext i
    fin_cases i <;> simp <;> ring
  map_smul' c x := by
    funext i
    fin_cases i <;> simp <;> ring

@[simp]
theorem rotation_apply_zero (x : Vec2) : rotation x 0 = -x 1 := by
  simp [rotation]

@[simp]
theorem rotation_apply_one (x : Vec2) : rotation x 1 = x 0 := by
  simp [rotation]

/-- Skewness on the diagonal: the rotation does no radial work. -/
theorem dot_rotation_self_zero (x : Vec2) : dot x (rotation x) = 0 := by
  simp [dot, rotation]
  ring

/-- A concrete cubic energy-preserving nonlinearity. -/
def cubicNonlinearity (x : Vec2) : Vec2 :=
  normSq x • rotation x

theorem cubicNonlinearity_apply_zero (x : Vec2) :
    cubicNonlinearity x 0 = -(normSq x * x 1) := by
  simp [cubicNonlinearity]

theorem cubicNonlinearity_apply_one (x : Vec2) :
    cubicNonlinearity x 1 = normSq x * x 0 := by
  simp [cubicNonlinearity]

/-- Exact nonlinear cancellation in the Euclidean energy pairing. -/
theorem dot_cubicNonlinearity_zero (x : Vec2) :
    dot x (cubicNonlinearity x) = 0 := by
  simp [dot, cubicNonlinearity, rotation]
  ring

/-- Negative Hamiltonian drift plus the conservative cubic term. -/
def vectorField (x : Vec2) : Vec2 :=
  -hamiltonian x + cubicNonlinearity x

/-- Algebraic directional derivative of squared Euclidean length. -/
def normSqDirectionalDerivative (x velocity : Vec2) : ℝ :=
  2 * dot x velocity

/-- The conservative cubic term drops out of the squared-norm derivative. -/
theorem normSqDirectionalDerivative_vectorField (x : Vec2) :
    normSqDirectionalDerivative x (vectorField x) = -2 * energy x := by
  simp [normSqDirectionalDerivative, vectorField, cubicNonlinearity,
    normSq, energy, dot, rotation, hamiltonian]
  ring

/-- Quantitative dissipation from the exact ground quadratic-form bound. -/
theorem normSqDirectionalDerivative_le_ground (x : Vec2) :
    normSqDirectionalDerivative x (vectorField x) ≤
      -2 * groundEigenvalue * normSq x := by
  rw [normSqDirectionalDerivative_vectorField]
  have hlower := ground_energy_lower x
  nlinarith

theorem energy_pos_of_ne_zero {x : Vec2} (hx : x ≠ 0) : 0 < energy x := by
  have hnorm : 0 < normSq x := normSq_pos_of_ne_zero hx
  have hlower := ground_energy_lower x
  have hground : 0 < groundEigenvalue := by norm_num [groundEigenvalue]
  have hproduct : 0 < groundEigenvalue * normSq x := mul_pos hground hnorm
  exact lt_of_lt_of_le hproduct hlower

/-- Every nonzero state has strictly negative squared-norm derivative. -/
theorem normSqDirectionalDerivative_neg {x : Vec2} (hx : x ≠ 0) :
    normSqDirectionalDerivative x (vectorField x) < 0 := by
  rw [normSqDirectionalDerivative_vectorField]
  have henergy := energy_pos_of_ne_zero hx
  linarith

/-- The concrete dissipative vector field has no nonzero equilibrium. -/
theorem vectorField_eq_zero_iff (x : Vec2) : vectorField x = 0 ↔ x = 0 := by
  constructor
  · intro hfield
    by_contra hx
    have hneg := normSqDirectionalDerivative_neg hx
    rw [hfield] at hneg
    simp [normSqDirectionalDerivative, dot] at hneg
  · rintro rfl
    funext i
    fin_cases i <;>
      norm_num [vectorField, cubicNonlinearity, normSq, dot, rotation, hamiltonian]

end QYM.FiniteGalerkinDissipation

open scoped ComplexOrder

/-!
# Faithful positivity of the concrete weighted Hermitian square

For the already certified density `ρ = diag(2,1)`, this file studies

`q(X) = weightedTrace ρ (Xᴴ * X)`.

The conjugate transpose in the first factor is essential.  Thus `q` is a Hermitian
sesquilinear square; it is not the diagonal of the existing complex-bilinear
`weightedPairing`.  The result is an explicit finite `2 × 2` certificate only.  It does not
construct an infinite-dimensional faithful normal weight or the analytic pairing claimed in the
paper.
-/

namespace QYM.WeightedTraceCore.SkewAdjointCounterexample

/-- The weighted Hermitian square for the concrete density `diag(2,1)`. -/
def weightedHermitianSquare (X : Mat2) : ℂ :=
  weightedTrace positiveDiagonalDensity (Matrix.conjTranspose X * X)

/-- The real coordinate expression underlying `weightedHermitianSquare`.

The coefficient `2` weights the first column because
`trace (ρ * (Xᴴ * X)) = 2 * (Xᴴ * X)₀₀ + (Xᴴ * X)₁₁`.
-/
def weightedHermitianCoordinateEnergy (X : Mat2) : ℝ :=
  2 * (Complex.normSq (X 0 0) + Complex.normSq (X 1 0)) +
    (Complex.normSq (X 0 1) + Complex.normSq (X 1 1))

/-- Direct matrix-coordinate expansion before replacing conjugate products by real norm squares. -/
theorem weightedHermitianSquare_raw_formula (X : Mat2) :
    weightedHermitianSquare X =
      (2 : ℂ) *
          (star (X 0 0) * X 0 0 + star (X 1 0) * X 1 0) +
        (star (X 0 1) * X 0 1 + star (X 1 1) * X 1 1) := by
  norm_num [weightedHermitianSquare, weightedTrace,
    positiveDiagonalDensity_coe_eq_diagonal,
    Matrix.trace_fin_two, Matrix.mul_apply, Fin.sum_univ_two,
    Matrix.diagonal_apply, Matrix.conjTranspose_apply, Complex.star_def] <;>
    ring

/-- Exact coordinate formula: the complex-valued square is the coercion of a sum of four
nonnegative real norm squares. -/
theorem weightedHermitianSquare_formula (X : Mat2) :
    weightedHermitianSquare X = (weightedHermitianCoordinateEnergy X : ℂ) := by
  simp [weightedHermitianSquare, weightedHermitianCoordinateEnergy, weightedTrace,
    positiveDiagonalDensity_coe_eq_diagonal, Matrix.trace_fin_two, Matrix.mul_apply,
    Fin.sum_univ_two, Matrix.diagonal_apply, Matrix.conjTranspose_apply, Complex.star_def,
    ← Complex.normSq_eq_conj_mul_self] <;>
    ring

/-- The weighted Hermitian square is real-valued. -/
theorem weightedHermitianSquare_im (X : Mat2) :
    (weightedHermitianSquare X).im = 0 := by
  simpa using congrArg Complex.im (weightedHermitianSquare_formula X)

/-- Its real part is exactly the displayed coordinate energy. -/
theorem weightedHermitianSquare_re (X : Mat2) :
    (weightedHermitianSquare X).re = weightedHermitianCoordinateEnergy X := by
  simpa using congrArg Complex.re (weightedHermitianSquare_formula X)

/-- The coordinate energy is nonnegative. -/
theorem weightedHermitianCoordinateEnergy_nonneg (X : Mat2) :
    0 ≤ weightedHermitianCoordinateEnergy X := by
  unfold weightedHermitianCoordinateEnergy
  exact add_nonneg
    (mul_nonneg (by norm_num)
      (add_nonneg (Complex.normSq_nonneg (X 0 0)) (Complex.normSq_nonneg (X 1 0))))
    (add_nonneg (Complex.normSq_nonneg (X 0 1)) (Complex.normSq_nonneg (X 1 1)))

/-- Vanishing of the coordinate energy forces every matrix entry to vanish. -/
theorem weightedHermitianCoordinateEnergy_eq_zero_iff (X : Mat2) :
    weightedHermitianCoordinateEnergy X = 0 ↔ X = 0 := by
  constructor
  · intro henergy
    have h00_nonneg := Complex.normSq_nonneg (X 0 0)
    have h10_nonneg := Complex.normSq_nonneg (X 1 0)
    have h01_nonneg := Complex.normSq_nonneg (X 0 1)
    have h11_nonneg := Complex.normSq_nonneg (X 1 1)
    have hleft_nonneg :
        0 ≤ 2 * (Complex.normSq (X 0 0) + Complex.normSq (X 1 0)) :=
      mul_nonneg (by norm_num) (add_nonneg h00_nonneg h10_nonneg)
    have hright_nonneg :
        0 ≤ Complex.normSq (X 0 1) + Complex.normSq (X 1 1) :=
      add_nonneg h01_nonneg h11_nonneg
    unfold weightedHermitianCoordinateEnergy at henergy
    obtain ⟨hleft, hright⟩ :=
      (add_eq_zero_iff_of_nonneg hleft_nonneg hright_nonneg).mp henergy
    have hfirstColumn :
        Complex.normSq (X 0 0) + Complex.normSq (X 1 0) = 0 :=
      (mul_eq_zero.mp hleft).resolve_left (by norm_num)
    obtain ⟨h00_sq, h10_sq⟩ :=
      (add_eq_zero_iff_of_nonneg h00_nonneg h10_nonneg).mp hfirstColumn
    obtain ⟨h01_sq, h11_sq⟩ :=
      (add_eq_zero_iff_of_nonneg h01_nonneg h11_nonneg).mp hright
    have h00 : X 0 0 = 0 := Complex.normSq_eq_zero.mp h00_sq
    have h10 : X 1 0 = 0 := Complex.normSq_eq_zero.mp h10_sq
    have h01 : X 0 1 = 0 := Complex.normSq_eq_zero.mp h01_sq
    have h11 : X 1 1 = 0 := Complex.normSq_eq_zero.mp h11_sq
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h00, h10, h01, h11]
  · rintro rfl
    simp [weightedHermitianCoordinateEnergy, Complex.normSq_zero]

/-- The coordinate energy is strictly positive on every nonzero matrix. -/
theorem weightedHermitianCoordinateEnergy_pos {X : Mat2} (hX : X ≠ 0) :
    0 < weightedHermitianCoordinateEnergy X := by
  by_contra hpos
  have hle : weightedHermitianCoordinateEnergy X ≤ 0 := le_of_not_gt hpos
  have hzero : weightedHermitianCoordinateEnergy X = 0 :=
    le_antisymm hle (weightedHermitianCoordinateEnergy_nonneg X)
  exact hX ((weightedHermitianCoordinateEnergy_eq_zero_iff X).mp hzero)

/-- Nonnegativity in Mathlib's scoped partial order on `ℂ`.  The real-part theorem below is the
primary order-free formulation. -/
theorem weightedHermitianSquare_nonneg (X : Mat2) :
    (0 : ℂ) ≤ weightedHermitianSquare X := by
  rw [weightedHermitianSquare_formula]
  exact Complex.zero_le_real.mpr (weightedHermitianCoordinateEnergy_nonneg X)

/-- Strict positivity in Mathlib's scoped partial order on `ℂ` for a nonzero matrix. -/
theorem weightedHermitianSquare_pos {X : Mat2} (hX : X ≠ 0) :
    (0 : ℂ) < weightedHermitianSquare X := by
  rw [weightedHermitianSquare_formula]
  exact Complex.zero_lt_real.mpr (weightedHermitianCoordinateEnergy_pos hX)

/-- Nonnegativity of the real part of the concrete weighted Hermitian square. -/
theorem weightedHermitianSquare_re_nonneg (X : Mat2) :
    0 ≤ (weightedHermitianSquare X).re := by
  rw [weightedHermitianSquare_re]
  exact weightedHermitianCoordinateEnergy_nonneg X

/-- Faithfulness: the real part vanishes exactly at the zero matrix. -/
theorem weightedHermitianSquare_re_eq_zero_iff (X : Mat2) :
    (weightedHermitianSquare X).re = 0 ↔ X = 0 := by
  rw [weightedHermitianSquare_re]
  exact weightedHermitianCoordinateEnergy_eq_zero_iff X

/-- Equivalent complex-valued faithfulness statement. -/
theorem weightedHermitianSquare_eq_zero_iff (X : Mat2) :
    weightedHermitianSquare X = 0 ↔ X = 0 := by
  rw [weightedHermitianSquare_formula, Complex.ofReal_eq_zero]
  exact weightedHermitianCoordinateEnergy_eq_zero_iff X

/-- Strict positivity of the real part on every nonzero matrix. -/
theorem weightedHermitianSquare_re_pos {X : Mat2} (hX : X ≠ 0) :
    0 < (weightedHermitianSquare X).re := by
  rw [weightedHermitianSquare_re]
  exact weightedHermitianCoordinateEnergy_pos hX

/-- The precise bridge to the old bilinear pairing.  The minus sign cancels the sign built into
`weightedPairing`, while the conjugate transpose supplies the conjugate-linear first argument.
This is not the assertion that `weightedPairing positiveDiagonalDensity X X` is positive. -/
theorem weightedHermitianSquare_eq_neg_weightedPairing_conjTranspose_self (X : Mat2) :
    weightedHermitianSquare X =
      -weightedPairing positiveDiagonalDensity (Matrix.conjTranspose X) X := by
  simp [weightedHermitianSquare, weightedPairing]

end QYM.WeightedTraceCore.SkewAdjointCounterexample

open scoped ComplexOrder

/-!
# The concrete weighted Hermitian pairing

For the certified density `ρ = diag(2,1)`, this module defines
`⟪X,Y⟫ρ = weightedTrace ρ (Xᴴ * Y)` and proves its elementary sesquilinear, Hermitian,
positive, and nondegenerate laws by coordinates.  It is deliberately distinct from the old
complex-bilinear `weightedPairing`, whose stronger skew identity has a counterexample.

This is a finite `2 × 2` construction.  It is not a normal weight, an infinite-dimensional
Hilbert completion, or the paper's global analytic pairing.
-/

namespace QYM.WeightedTraceCore.SkewAdjointCounterexample

/-- The concrete weighted Hermitian pairing associated with `diag(2,1)`. -/
def weightedHermitianPairing (X Y : Mat2) : ℂ :=
  weightedTrace positiveDiagonalDensity (Matrix.conjTranspose X * Y)

/-- Exact four-coordinate formula for the pairing. -/
theorem weightedHermitianPairing_formula (X Y : Mat2) :
    weightedHermitianPairing X Y =
      (2 : ℂ) *
          (star (X 0 0) * Y 0 0 + star (X 1 0) * Y 1 0) +
        (star (X 0 1) * Y 0 1 + star (X 1 1) * Y 1 1) := by
  norm_num [weightedHermitianPairing, weightedTrace,
    positiveDiagonalDensity_coe_eq_diagonal,
    Matrix.trace_fin_two, Matrix.mul_apply, Fin.sum_univ_two,
    Matrix.diagonal_apply, Matrix.conjTranspose_apply, Complex.star_def] <;>
    ring

@[simp]
theorem weightedHermitianPairing_zero_left (Y : Mat2) :
    weightedHermitianPairing 0 Y = 0 := by
  rw [weightedHermitianPairing_formula]
  simp

@[simp]
theorem weightedHermitianPairing_zero_right (X : Mat2) :
    weightedHermitianPairing X 0 = 0 := by
  rw [weightedHermitianPairing_formula]
  simp

theorem weightedHermitianPairing_add_left (X₁ X₂ Y : Mat2) :
    weightedHermitianPairing (X₁ + X₂) Y =
      weightedHermitianPairing X₁ Y + weightedHermitianPairing X₂ Y := by
  rw [weightedHermitianPairing_formula,
    weightedHermitianPairing_formula, weightedHermitianPairing_formula]
  simp only [Matrix.add_apply, star_add]
  ring

theorem weightedHermitianPairing_add_right (X Y₁ Y₂ : Mat2) :
    weightedHermitianPairing X (Y₁ + Y₂) =
      weightedHermitianPairing X Y₁ + weightedHermitianPairing X Y₂ := by
  rw [weightedHermitianPairing_formula,
    weightedHermitianPairing_formula, weightedHermitianPairing_formula]
  simp only [Matrix.add_apply]
  ring

/-- Conjugate homogeneity in the first argument. -/
theorem weightedHermitianPairing_smul_left (c : ℂ) (X Y : Mat2) :
    weightedHermitianPairing (c • X) Y =
      star c * weightedHermitianPairing X Y := by
  rw [weightedHermitianPairing_formula, weightedHermitianPairing_formula]
  simp only [Matrix.smul_apply, smul_eq_mul, star_mul]
  ring

/-- Complex linearity in the second argument. -/
theorem weightedHermitianPairing_smul_right (c : ℂ) (X Y : Mat2) :
    weightedHermitianPairing X (c • Y) =
      c * weightedHermitianPairing X Y := by
  rw [weightedHermitianPairing_formula, weightedHermitianPairing_formula]
  simp only [Matrix.smul_apply, smul_eq_mul]
  ring

/-- Hermitian conjugate symmetry. -/
theorem weightedHermitianPairing_conj_symm (X Y : Mat2) :
    weightedHermitianPairing X Y = star (weightedHermitianPairing Y X) := by
  have hstar_two : star (2 : ℂ) = 2 := by
    norm_num [Complex.star_def]
  rw [weightedHermitianPairing_formula, weightedHermitianPairing_formula]
  simp only [star_add, star_mul, hstar_two, star_star]
  ring

/-- The diagonal of the pairing is exactly the previously certified Hermitian square. -/
theorem weightedHermitianPairing_self (X : Mat2) :
    weightedHermitianPairing X X = weightedHermitianSquare X := rfl

theorem weightedHermitianPairing_self_nonneg (X : Mat2) :
    (0 : ℂ) ≤ weightedHermitianPairing X X := by
  rw [weightedHermitianPairing_self]
  exact weightedHermitianSquare_nonneg X

theorem weightedHermitianPairing_self_eq_zero_iff (X : Mat2) :
    weightedHermitianPairing X X = 0 ↔ X = 0 := by
  rw [weightedHermitianPairing_self]
  exact weightedHermitianSquare_eq_zero_iff X

/-- Left nondegeneracy, obtained by testing against the same matrix. -/
theorem weightedHermitianPairing_left_nondegenerate (X : Mat2) :
    (∀ Y : Mat2, weightedHermitianPairing X Y = 0) ↔ X = 0 := by
  constructor
  · intro hzero
    exact (weightedHermitianPairing_self_eq_zero_iff X).mp (hzero X)
  · rintro rfl
    intro Y
    exact weightedHermitianPairing_zero_left Y

/-- Right nondegeneracy, again obtained by testing on the diagonal. -/
theorem weightedHermitianPairing_right_nondegenerate (Y : Mat2) :
    (∀ X : Mat2, weightedHermitianPairing X Y = 0) ↔ Y = 0 := by
  constructor
  · intro hzero
    exact (weightedHermitianPairing_self_eq_zero_iff Y).mp (hzero Y)
  · rintro rfl
    intro X
    exact weightedHermitianPairing_zero_right X

/-- One proof-carrying summary of the concrete finite Hermitian-pairing laws. -/
theorem concrete_weightedHermitianPairing_certificate :
    (∀ X : Mat2, (0 : ℂ) ≤ weightedHermitianPairing X X) ∧
      (∀ X : Mat2, weightedHermitianPairing X X = 0 ↔ X = 0) ∧
      (∀ X Y : Mat2,
        weightedHermitianPairing X Y = star (weightedHermitianPairing Y X)) := by
  exact ⟨weightedHermitianPairing_self_nonneg,
    weightedHermitianPairing_self_eq_zero_iff,
    weightedHermitianPairing_conj_symm⟩

end QYM.WeightedTraceCore.SkewAdjointCounterexample

