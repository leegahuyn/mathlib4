      ‖actualCutoffNegativeOneResolventError n‖ < (1 / 4 : ℝ) ∧
        QYM.FullCertification.Mock3ActualMockRSResolventUniformGapExtension.actualCutoffEscapeHamiltonian n ≠ 0 := by
    by_contra h
    push_neg at h
    apply hPersistent
    filter_upwards [hSmall] with n hn
    exact h n hn
  obtain ⟨n, hnSmall, hnNonzero⟩ := hStage
  have hnLarge :=
    actualCutoffNegativeOneResolventError_norm_ge_half hnNonzero
  linarith

/-- For the actual natural-stage exhaustion, the explicit common-`-1`
resolvents unconditionally fail to converge in operator norm.  The escape
band constructed above makes every `Q_n` nonzero, so the norm error never
