/-!
# Bounded Hilbert-operator and quadratic-form extension

This file supplies the strongest unconditional operator/form consequences presently available
from Mathlib's bounded Hilbert-space API.  Unlike a record whose fields simply repeat desired
conclusions, every predicate below is transparent and every conclusion is derived from the
displayed hypotheses.

The main source APIs used here are:

* `ContinuousLinearMap.toSesqForm`, `ContinuousLinearMap.IsPositive`, and
  `ContinuousLinearMap.IsPositive.isSelfAdjoint`;
* `ContinuousLinearMap.antilipschitz_of_forall_le_inner_map` and
  `ContinuousLinearMap.isUnit_of_forall_le_norm_inner_map`;
* `LinearMap.IsSymmetric.restrict_invariant` and `IsCompactOperator.restrict`;
* `isCompactOperator_of_locallyCompactSpace_rng` (despite the suffix, the theorem is the
  "map from a locally compact domain" result) together with the finite-dimensional
  `ProperSpace` instance.

Mathlib also has partially defined operators (`LinearPMap`), graph closure, an unbounded adjoint,
and the implication that an unbounded self-adjoint operator is closed.  It does **not** presently
provide a single packaged bridge taking the paper's concrete dense closed semibounded form to all
of its advertised operator conclusions.  Accordingly this namespace proves bounded-operator
results only; later continuation namespaces construct abstract real and `RCLike` Friedrichs
bridges from displayed hypotheses without disguising a Friedrichs or KLMN conclusion as input.
-/

namespace QYM.HilbertOperatorFormExtension

open Bornology Set
open scoped InnerProductSpace NNReal

/-! ## The operator form and its quadratic energy -/

section OperatorForm

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Mathlib's bundled continuous sesquilinear form associated to `T`.

For a real Hilbert space its value at `x,y` is `⟪x, T y⟫_ℝ`.  We retain this bundled definition
alongside the transparent scalar-valued spelling `operatorForm` used in elementary estimates. -/
noncomputable def bundledOperatorForm (T : H →L[ℝ] H) :=
  ContinuousLinearMap.toSesqForm T

/-- The real operator form in the argument order used by `ContinuousLinearMap.toSesqForm`. -/
def operatorForm (T : H →L[ℝ] H) (x y : H) : ℝ :=
  ⟪x, T y⟫_ℝ

@[simp]
theorem bundledOperatorForm_apply (T : H →L[ℝ] H) (x y : H) :
    bundledOperatorForm T x y = operatorForm T x y := by
  rfl

/-- The diagonal quadratic energy associated to a bounded operator. -/
def quadraticEnergy (T : H →L[ℝ] H) (x : H) : ℝ :=
  operatorForm T x x

@[simp]
theorem quadraticEnergy_eq_inner_right (T : H →L[ℝ] H) (x : H) :
    quadraticEnergy T x = ⟪x, T x⟫_ℝ :=
  rfl

/-- On a real Hilbert space the two conventional diagonal argument orders coincide. -/
theorem quadraticEnergy_eq_inner_map_self (T : H →L[ℝ] H) (x : H) :
    quadraticEnergy T x = ⟪T x, x⟫_ℝ := by
  exact real_inner_comm (T x) x

@[simp]
theorem quadraticEnergy_zero (x : H) :
    quadraticEnergy (0 : H →L[ℝ] H) x = 0 := by
  simp [quadraticEnergy, operatorForm]

theorem quadraticEnergy_add (T B : H →L[ℝ] H) (x : H) :
    quadraticEnergy (T + B) x = quadraticEnergy T x + quadraticEnergy B x := by
  simp [quadraticEnergy, operatorForm, inner_add_right]

theorem quadraticEnergy_sub (T B : H →L[ℝ] H) (x : H) :
    quadraticEnergy (T - B) x = quadraticEnergy T x - quadraticEnergy B x := by
  simp [quadraticEnergy, operatorForm, inner_sub_right]

theorem quadraticEnergy_neg (T : H →L[ℝ] H) (x : H) :
    quadraticEnergy (-T) x = -quadraticEnergy T x := by
  simp [quadraticEnergy, operatorForm]

/-- Symmetry of an operator gives symmetry of its associated real form. -/
theorem operatorForm_symmetric_of_isSymmetric
    {T : H →L[ℝ] H}
    (hT : (T : H →ₗ[ℝ] H).IsSymmetric) (x y : H) :
    operatorForm T x y = operatorForm T y x := by
  calc
    operatorForm T x y = ⟪T x, y⟫_ℝ := (hT x y).symm
    _ = ⟪y, T x⟫_ℝ := real_inner_comm y (T x)
    _ = operatorForm T y x := rfl

theorem operatorForm_symmetric_of_positive
    {T : H →L[ℝ] H} (hT : T.IsPositive) (x y : H) :
    operatorForm T x y = operatorForm T y x :=
  operatorForm_symmetric_of_isSymmetric hT.isSymmetric x y

theorem operatorForm_symmetric_of_selfAdjoint
    [CompleteSpace H] {T : H →L[ℝ] H} (hT : IsSelfAdjoint T) (x y : H) :
    operatorForm T x y = operatorForm T y x :=
  operatorForm_symmetric_of_isSymmetric hT.isSymmetric x y

/-- Positivity in Mathlib implies nonnegativity of the actual quadratic energy. -/
theorem quadraticEnergy_nonnegative_of_positive
    {T : H →L[ℝ] H} (hT : T.IsPositive) (x : H) :
    0 ≤ quadraticEnergy T x := by
  simpa [quadraticEnergy, operatorForm] using hT.inner_nonneg_right x

/-- A bounded positive operator on a Hilbert space is genuinely self-adjoint. -/
theorem selfAdjoint_of_positive
    [CompleteSpace H] {T : H →L[ℝ] H} (hT : T.IsPositive) :
    IsSelfAdjoint T :=
  hT.isSelfAdjoint

end OperatorForm

/-! ## Coercive lower bounds, kernels, closed range, and the resolvent point zero -/

section Coercivity

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- A transparent quadratic lower-bound predicate.  It contains no kernel, inverse, range, or
spectrum conclusion. -/
def HasQuadraticLowerBound (T : H →L[ℝ] H) (c : ℝ) : Prop :=
  ∀ x : H, c * ‖x‖ ^ 2 ≤ quadraticEnergy T x

/-- A transparent diagonal form bound for a perturbation. -/
def HasQuadraticPerturbationBound (B : H →L[ℝ] H) (ε : ℝ) : Prop :=
  ∀ x : H, |quadraticEnergy B x| ≤ ε * ‖x‖ ^ 2

theorem HasQuadraticLowerBound.mono
    {T : H →L[ℝ] H} {c d : ℝ}
    (hT : HasQuadraticLowerBound T c) (hdc : d ≤ c) :
    HasQuadraticLowerBound T d := by
  intro x
  exact
    (mul_le_mul_of_nonneg_right hdc (sq_nonneg ‖x‖)).trans
      (hT x)

theorem quadraticEnergy_nonnegative_of_lowerBound
    {T : H →L[ℝ] H} {c : ℝ}
    (hc : 0 ≤ c) (hT : HasQuadraticLowerBound T c) (x : H) :
    0 ≤ quadraticEnergy T x := by
  exact (mul_nonneg hc (sq_nonneg ‖x‖)).trans (hT x)

/-- A strictly positive quadratic lower bound kills every vector in the operator kernel. -/
theorem eq_zero_of_apply_eq_zero_of_quadraticLowerBound
    {T : H →L[ℝ] H} {c : ℝ}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T c)
    {x : H} (hx : T x = 0) :
    x = 0 := by
  have hmul : c * ‖x‖ ^ 2 ≤ 0 := by
    simpa [quadraticEnergy, operatorForm, hx] using hT x
  have hsquare_le : ‖x‖ ^ 2 ≤ 0 := by
    by_contra hnot
    have hsquare_pos : 0 < ‖x‖ ^ 2 := lt_of_not_ge hnot
    have hprod_pos : 0 < c * ‖x‖ ^ 2 := mul_pos hc hsquare_pos
    exact (not_lt_of_ge hmul) hprod_pos
  have hsquare : ‖x‖ ^ 2 = 0 :=
    le_antisymm hsquare_le (sq_nonneg ‖x‖)
  have hnorm : ‖x‖ = 0 :=
    sq_eq_zero_iff.mp hsquare
  exact norm_eq_zero.mp hnorm

theorem ker_eq_bot_of_quadraticLowerBound
    {T : H →L[ℝ] H} {c : ℝ}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T c) :
    LinearMap.ker (T : H →ₗ[ℝ] H) = ⊥ := by
  rw [LinearMap.ker_eq_bot']
  intro x hx
  exact eq_zero_of_apply_eq_zero_of_quadraticLowerBound hc hT hx

theorem injective_of_quadraticLowerBound
    {T : H →L[ℝ] H} {c : ℝ}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T c) :
    Function.Injective T :=
  LinearMap.ker_eq_bot.mp (ker_eq_bot_of_quadraticLowerBound hc hT)

/-- The lower bound in the exact form expected by Mathlib's anti-Lipschitz theorem. -/
theorem norm_inner_map_lowerBound
    {T : H →L[ℝ] H} {c : ℝ≥0}
    (hT : HasQuadraticLowerBound T (c : ℝ)) :
    ∀ x : H, ‖x‖ ^ 2 * (c : ℝ) ≤ ‖⟪T x, x⟫_ℝ‖ := by
  intro x
  calc
    ‖x‖ ^ 2 * (c : ℝ) = (c : ℝ) * ‖x‖ ^ 2 := mul_comm _ _
    _ ≤ quadraticEnergy T x := hT x
    _ = ⟪T x, x⟫_ℝ := quadraticEnergy_eq_inner_map_self T x
    _ ≤ ‖⟪T x, x⟫_ℝ‖ := Real.le_norm_self _

/-- Quantitative coercivity gives an anti-Lipschitz bound, hence injectivity with a metric
constant rather than only a kernel calculation. -/
theorem antilipschitz_of_quadraticLowerBound
    {T : H →L[ℝ] H} {c : ℝ≥0}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T (c : ℝ)) :
    AntilipschitzWith c⁻¹ T :=
  ContinuousLinearMap.antilipschitz_of_forall_le_inner_map
    T hc (norm_inner_map_lowerBound hT)

/-- On a complete Hilbert space the anti-Lipschitz estimate gives a genuinely closed range. -/
theorem isClosed_range_of_quadraticLowerBound
    [CompleteSpace H] {T : H →L[ℝ] H} {c : ℝ≥0}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T (c : ℝ)) :
    IsClosed (Set.range T) := by
  exact
    (antilipschitz_of_quadraticLowerBound hc hT).isClosed_range
      T.uniformContinuous

/-- Mathlib's Hilbert-space coercivity theorem is stronger than injectivity: it produces a unit
in the Banach algebra of bounded endomorphisms. -/
theorem isUnit_of_quadraticLowerBound
    [CompleteSpace H] {T : H →L[ℝ] H} {c : ℝ≥0}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T (c : ℝ)) :
    IsUnit T :=
  ContinuousLinearMap.isUnit_of_forall_le_norm_inner_map
    T hc (norm_inner_map_lowerBound hT)

theorem bijective_of_quadraticLowerBound
    [CompleteSpace H] {T : H →L[ℝ] H} {c : ℝ≥0}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T (c : ℝ)) :
    Function.Bijective T :=
  ContinuousLinearMap.isUnit_iff_bijective.mp
    (isUnit_of_quadraticLowerBound hc hT)

/-- A strict bounded-operator quadratic gap excludes zero from the actual algebraic spectrum. -/
theorem zero_not_mem_spectrum_of_quadraticLowerBound
    [CompleteSpace H] {T : H →L[ℝ] H} {c : ℝ≥0}
    (hc : 0 < c) (hT : HasQuadraticLowerBound T (c : ℝ)) :
    (0 : ℝ) ∉ spectrum ℝ T :=
  spectrum.zero_notMem ℝ (isUnit_of_quadraticLowerBound hc hT)

end Coercivity

/-! ## Transfer of lower bounds under diagonal form-small perturbations -/

section Perturbation

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

theorem quadraticLowerBound_add_of_perturbationBound
    {T B : H →L[ℝ] H} {c ε : ℝ}
    (hT : HasQuadraticLowerBound T c)
    (hB : HasQuadraticPerturbationBound B ε) :
    HasQuadraticLowerBound (T + B) (c - ε) := by
  intro x
  rw [quadraticEnergy_add]
  have hbase := hT x
  have hpert := hB x
  have hnegative := neg_abs_le (quadraticEnergy B x)
  nlinarith

theorem quadraticLowerBound_sub_of_perturbationBound
    {T B : H →L[ℝ] H} {c ε : ℝ}
    (hT : HasQuadraticLowerBound T c)
    (hB : HasQuadraticPerturbationBound B ε) :
    HasQuadraticLowerBound (T - B) (c - ε) := by
  intro x
  rw [quadraticEnergy_sub]
  have hbase := hT x
  have hpert := hB x
  have hpositive := le_abs_self (quadraticEnergy B x)
  nlinarith

theorem injective_add_of_perturbationBound
    {T B : H →L[ℝ] H} {c ε : ℝ}
    (hgap : ε < c)
    (hT : HasQuadraticLowerBound T c)
    (hB : HasQuadraticPerturbationBound B ε) :
    Function.Injective (T + B) :=
  injective_of_quadraticLowerBound
    (sub_pos.mpr hgap)
    (quadraticLowerBound_add_of_perturbationBound hT hB)

theorem injective_sub_of_perturbationBound
    {T B : H →L[ℝ] H} {c ε : ℝ}
    (hgap : ε < c)
    (hT : HasQuadraticLowerBound T c)
    (hB : HasQuadraticPerturbationBound B ε) :
    Function.Injective (T - B) :=
  injective_of_quadraticLowerBound
    (sub_pos.mpr hgap)
    (quadraticLowerBound_sub_of_perturbationBound hT hB)

end Perturbation

/-! ## Invariant-subspace restrictions -/

section InvariantRestriction

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The algebraic restriction of `T` to a supplied invariant submodule. -/
def invariantLinearRestriction
    (T : H →L[ℝ] H) (V : Submodule ℝ H)
    (hV : ∀ v : H, v ∈ V → T v ∈ V) :
    V →ₗ[ℝ] V :=
  (T : H →ₗ[ℝ] H).restrict hV

@[simp]
theorem invariantLinearRestriction_apply_coe
    (T : H →L[ℝ] H) (V : Submodule ℝ H)
    (hV : ∀ v : H, v ∈ V → T v ∈ V) (v : V) :
    ((invariantLinearRestriction T V hV v : V) : H) = T (v : H) :=
  rfl

/-- The invariant restriction is still bounded; its construction uses the ambient operator norm. -/
def invariantContinuousRestriction
    (T : H →L[ℝ] H) (V : Submodule ℝ H)
    (hV : ∀ v : H, v ∈ V → T v ∈ V) :
    V →L[ℝ] V :=
  (invariantLinearRestriction T V hV).mkContinuous ‖T‖ (by
    intro v
    simpa [invariantLinearRestriction] using T.le_opNorm (v : H))

@[simp]
theorem invariantContinuousRestriction_toLinearMap
    (T : H →L[ℝ] H) (V : Submodule ℝ H)
    (hV : ∀ v : H, v ∈ V → T v ∈ V) :
    (invariantContinuousRestriction T V hV : V →ₗ[ℝ] V) =
      invariantLinearRestriction T V hV :=
  rfl

@[simp]
theorem invariantContinuousRestriction_apply_coe
    (T : H →L[ℝ] H) (V : Submodule ℝ H)
    (hV : ∀ v : H, v ∈ V → T v ∈ V) (v : V) :
    ((invariantContinuousRestriction T V hV v : V) : H) = T (v : H) :=
  rfl

theorem invariantLinearRestriction_isSymmetric
    {T : H →L[ℝ] H} {V : Submodule ℝ H}
    {hV : ∀ v : H, v ∈ V → T v ∈ V}
    (hT : (T : H →ₗ[ℝ] H).IsSymmetric) :
    (invariantLinearRestriction T V hV).IsSymmetric := by
  exact hT.restrict_invariant hV

/-- Positivity survives restriction to an invariant subspace. -/
theorem invariantContinuousRestriction_isPositive
    {T : H →L[ℝ] H} {V : Submodule ℝ H}
    {hV : ∀ v : H, v ∈ V → T v ∈ V}
    (hT : T.IsPositive) :
    (invariantContinuousRestriction T V hV).IsPositive := by
  rw [ContinuousLinearMap.isPositive_iff]
  constructor
  · change (invariantLinearRestriction T V hV).IsSymmetric
    exact invariantLinearRestriction_isSymmetric hT.isSymmetric
  · intro v
    change 0 ≤ ⟪T (v : H), (v : H)⟫_ℝ
    exact hT.inner_nonneg_left (v : H)

/-- Once completeness of the subspace is available (in particular from closedness), the positive
restriction is self-adjoint. -/
theorem invariantContinuousRestriction_isSelfAdjoint
    {T : H →L[ℝ] H} {V : Submodule ℝ H}
    [CompleteSpace V]
    {hV : ∀ v : H, v ∈ V → T v ∈ V}
    (hT : T.IsPositive) :
    IsSelfAdjoint (invariantContinuousRestriction T V hV) :=
  (invariantContinuousRestriction_isPositive hT).isSelfAdjoint

/-- A closed submodule of a complete ambient Hilbert space supplies the completeness instance
needed by the preceding self-adjointness theorem. -/
noncomputable def completeSpaceOfClosedSubspace
    [CompleteSpace H] (V : Submodule ℝ H) (hclosed : IsClosed (V : Set H)) :
    CompleteSpace V :=
  hclosed.isComplete.completeSpace_coe

/-- Compactness survives restriction to a closed invariant subspace. -/
theorem invariantContinuousRestriction_isCompact
    {T : H →L[ℝ] H} {V : Submodule ℝ H}
    {hV : ∀ v : H, v ∈ V → T v ∈ V}
    (hcompact : IsCompactOperator (T : H → H))
    (hclosed : IsClosed (V : Set H)) :
    IsCompactOperator (invariantContinuousRestriction T V hV : V → V) := by
  change IsCompactOperator (((T : H →ₗ[ℝ] H).restrict hV : V →ₗ[ℝ] V) : V → V)
  exact
    IsCompactOperator.restrict
      (f := (T : H →ₗ[ℝ] H)) hcompact hV hclosed

/-- An existential supplier packaging the actual restriction together with the properties proved
above.  None of the properties is an input field. -/
theorem exists_positive_compact_invariantRestriction
    {T : H →L[ℝ] H} {V : Submodule ℝ H}
    {hV : ∀ v : H, v ∈ V → T v ∈ V}
    (hT : T.IsPositive)
    (hcompact : IsCompactOperator (T : H → H))
    (hclosed : IsClosed (V : Set H)) :
    ∃ R : V →L[ℝ] V,
      R.IsPositive ∧
        IsCompactOperator (R : V → V) ∧
          ∀ v : V, ((R v : V) : H) = T (v : H) := by
  refine ⟨invariantContinuousRestriction T V hV, ?_, ?_, ?_⟩
  · exact invariantContinuousRestriction_isPositive hT
  · exact invariantContinuousRestriction_isCompact hcompact hclosed
  · intro v
    exact invariantContinuousRestriction_apply_coe T V hV v

end InvariantRestriction

/-! ## Compact images and finite-dimensional compactness -/

section CompactImages

variable {H K : Type*}
  [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup K] [NormedSpace ℝ K]

theorem compact_closure_image_of_bounded
    {T : H →L[ℝ] K}
    (hT : IsCompactOperator (T : H → K))
    {S : Set H} (hS : Bornology.IsBounded S) :
    IsCompact (closure (T '' S)) :=
  hT.isCompact_closure_image_of_bounded hS

theorem image_bounded_subset_compact
    {T : H →L[ℝ] K}
    (hT : IsCompactOperator (T : H → K))
    {S : Set H} (hS : Bornology.IsBounded S) :
    ∃ C : Set K, IsCompact C ∧ T '' S ⊆ C :=
  hT.image_subset_compact_of_bounded hS

theorem compact_closure_image_closedBall
    {T : H →L[ℝ] K}
    (hT : IsCompactOperator (T : H → K)) (r : ℝ) :
    IsCompact (closure (T '' Metric.closedBall (0 : H) r)) :=
  hT.isCompact_closure_image_closedBall r

end CompactImages

section FiniteDimension

variable {H K : Type*}
  [NormedAddCommGroup H] [NormedSpace ℝ H] [FiniteDimensional ℝ H]
  [NormedAddCommGroup K] [NormedSpace ℝ K]

/-- Every bounded map *from* a finite-dimensional real normed space is compact. -/
theorem finiteDimensional_operator_isCompact (T : H →L[ℝ] K) :
    IsCompactOperator (T : H → K) :=
  isCompactOperator_of_locallyCompactSpace_rng T

/-- Closed balls in a finite-dimensional real normed space are compact. -/
theorem finiteDimensional_closedBall_isCompact (x : H) (r : ℝ) :
    IsCompact (Metric.closedBall x r) :=
  isCompact_closedBall x r

end FiniteDimension

end QYM.HilbertOperatorFormExtension

/-!
# Paper-normalized bounded Hilbert-operator consequences

These closed propositions expose a bounded-operator tranche that can be kernel-checked using the
current Mathlib API.  They are useful for the bounded self-adjoint potential and for corrected
bounded/Galerkin surrogates of the paper's Hamiltonian claims.

They are **not** a normalization of the full Friedrichs claims in Lemmas 4.13 and 4.16.  In
particular, none of the propositions below constructs the paper's Sobolev/gauge form domain,
proves that its projected derivative is closed and densely defined, represents a closed form by an
unbounded self-adjoint operator, or proves compactness of an unbounded resolvent.  Mathlib's
`LinearPMap` graph/adjoint layer does not currently supply that missing form-representation bridge.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Bounded positive operators -/

/-- A bounded positive operator has symmetric form, nonnegative energy, and is self-adjoint on a
complete real Hilbert space. -/
def boundedPositiveOperatorEnergyStatement : Prop :=
  ∀ (H : Type)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (T : H →L[ℝ] H),
    T.IsPositive →
      IsSelfAdjoint T ∧
        (∀ x : H,
          0 ≤ QYM.HilbertOperatorFormExtension.quadraticEnergy T x) ∧
        (∀ x y : H,
          QYM.HilbertOperatorFormExtension.operatorForm T x y =
            QYM.HilbertOperatorFormExtension.operatorForm T y x)

theorem boundedPositiveOperatorEnergyStatement_holds :
    boundedPositiveOperatorEnergyStatement := by
  intro H instNormed instInner instComplete T hT
  refine ⟨hT.isSelfAdjoint, ?_, ?_⟩
  · intro x
    exact
      QYM.HilbertOperatorFormExtension.quadraticEnergy_nonnegative_of_positive
        hT x
  · intro x y
    exact
      QYM.HilbertOperatorFormExtension.operatorForm_symmetric_of_positive
        hT x y

/-! ## Coercivity as a genuine bounded spectral statement -/

/-- A strict quadratic lower bound for a bounded Hilbert-space operator gives injectivity, closed
range, bijectivity, and exclusion of zero from the algebraic spectrum.  The lower bound is the
analytic premise; none of these four consequences is stored inside it. -/
def boundedCoerciveOperatorConsequencesStatement : Prop :=
  ∀ (H : Type)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (T : H →L[ℝ] H) (c : NNReal),
    0 < c →
      QYM.HilbertOperatorFormExtension.HasQuadraticLowerBound T (c : ℝ) →
        Function.Injective T ∧
          IsClosed (Set.range T) ∧
            Function.Bijective T ∧
              (0 : ℝ) ∉ spectrum ℝ T

theorem boundedCoerciveOperatorConsequencesStatement_holds :
    boundedCoerciveOperatorConsequencesStatement := by
  intro H instNormed instInner instComplete T c hc hlower
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact
      QYM.HilbertOperatorFormExtension.injective_of_quadraticLowerBound
        (NNReal.coe_pos.mpr hc) hlower
  · exact
      QYM.HilbertOperatorFormExtension.isClosed_range_of_quadraticLowerBound
        hc hlower
  · exact
      QYM.HilbertOperatorFormExtension.bijective_of_quadraticLowerBound
        hc hlower
  · exact
      QYM.HilbertOperatorFormExtension.zero_not_mem_spectrum_of_quadraticLowerBound
        hc hlower

/-! ## Form-small bounded perturbations -/

/-- A diagonal perturbation bounded by `ε ‖x‖²` transfers a lower bound `c` to `c-ε`; if
`ε<c`, the perturbed bounded operator is injective. -/
def boundedPerturbationGapTransferStatement : Prop :=
  ∀ (H : Type)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (T B : H →L[ℝ] H) (c ε : ℝ),
    ε < c →
      QYM.HilbertOperatorFormExtension.HasQuadraticLowerBound T c →
        QYM.HilbertOperatorFormExtension.HasQuadraticPerturbationBound B ε →
          QYM.HilbertOperatorFormExtension.HasQuadraticLowerBound (T + B) (c - ε) ∧
            Function.Injective (T + B)

theorem boundedPerturbationGapTransferStatement_holds :
    boundedPerturbationGapTransferStatement := by
  intro H instNormed instInner T B c ε hgap hT hB
  exact
    ⟨QYM.HilbertOperatorFormExtension.quadraticLowerBound_add_of_perturbationBound
        hT hB,
      QYM.HilbertOperatorFormExtension.injective_add_of_perturbationBound
        hgap hT hB⟩

/-! ## Closed invariant restrictions -/

/-- A positive compact bounded operator preserving a closed subspace has an explicitly supplied
positive compact bounded restriction. -/
def closedInvariantRestrictionSupplierStatement : Prop :=
  ∀ (H : Type)
      [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (T : H →L[ℝ] H) (V : Submodule ℝ H)
      (hV : ∀ v : H, v ∈ V → T v ∈ V),
    T.IsPositive →
      IsCompactOperator (T : H → H) →
        IsClosed (V : Set H) →
          ∃ R : V →L[ℝ] V,
            R.IsPositive ∧
              IsCompactOperator (R : V → V) ∧
                ∀ v : V, ((R v : V) : H) = T (v : H)

theorem closedInvariantRestrictionSupplierStatement_holds :
    closedInvariantRestrictionSupplierStatement := by
  intro H instNormed instInner T V hV hpositive hcompact hclosed
  exact
    QYM.HilbertOperatorFormExtension.exists_positive_compact_invariantRestriction
      (hV := hV) hpositive hcompact hclosed

/-! ## Compact images and finite-dimensional compactness -/

/-- Every bounded linear map from a finite-dimensional real normed space is a compact operator. -/
def finiteDimensionalBoundedOperatorCompactStatement : Prop :=
  ∀ (H K : Type)
      [NormedAddCommGroup H] [NormedSpace ℝ H] [FiniteDimensional ℝ H]
      [NormedAddCommGroup K] [NormedSpace ℝ K]
      (T : H →L[ℝ] K),
    IsCompactOperator (T : H → K)

theorem finiteDimensionalBoundedOperatorCompactStatement_holds :
    finiteDimensionalBoundedOperatorCompactStatement := by
  intro H K instNormedH instSpaceH instFiniteH instNormedK instSpaceK T
  exact
    QYM.HilbertOperatorFormExtension.finiteDimensional_operator_isCompact T

/-- A compact bounded operator maps every bounded set into a set with compact closure. -/
def compactOperatorBoundedImageStatement : Prop :=
  ∀ (H K : Type)
      [NormedAddCommGroup H] [NormedSpace ℝ H]
      [NormedAddCommGroup K] [NormedSpace ℝ K]
      (T : H →L[ℝ] K) (S : Set H),
    IsCompactOperator (T : H → K) →
      Bornology.IsBounded S →
        IsCompact (closure (T '' S))

theorem compactOperatorBoundedImageStatement_holds :
    compactOperatorBoundedImageStatement := by
  intro H K instNormedH instSpaceH instNormedK instSpaceK T S hcompact hbounded
  exact
    QYM.HilbertOperatorFormExtension.compact_closure_image_of_bounded
      hcompact hbounded

end QYM.FullCertification.PaperNormalized

/-!
# Complex root-exponential coefficient bounds

This file refines the scalar logical core for Theorem 4.26 to coefficient sequences
`a : ℕ → ℂ`.  The displayed estimate is imposed on the complex norm.  No phase, multiplier,
Kloosterman sum, or Rademacher main term is invented.

The one-term interface therefore takes an arbitrary complex `mainTerm` together with two genuinely
analytic suppliers: a root-exponential norm envelope for `mainTerm`, and an explicit norm bound for
`a - mainTerm` on the smaller `n⁻¹ exp (α √n)` scale.

An eventual estimate controls no prescribed finite prefix with the *same* constant.  Nevertheless,
every finite prefix has an explicit recursively constructed `max` constant.  Thus a positive tail
constant can be enlarged to a global constant.  A complex initial-spike countermodel records why
the enlargement is essential.
-/

namespace QYM.ComplexRootExponentialExtension

open Filter

/-! ## Norm-valued all-index and eventual laws -/

/-- The real envelope used to bound the norm of a complex coefficient. -/
def complexRootExponentialEnvelope (C α : ℝ) (n : ℕ) : ℝ :=
  C / Real.sqrt (n : ℝ) * Real.exp (α * Real.sqrt (n : ℝ))

/-- The complex norm envelope is definitionally the scalar envelope from the earlier logic core. -/
theorem complexRootExponentialEnvelope_eq_scalarEnvelope
    (C α : ℝ) (n : ℕ) :
    complexRootExponentialEnvelope C α n =
      QYM.RootExpWeylLogicCore.rootExponentialEnvelope C α n := by
  rfl

/-- Nonnegativity of the envelope when its coefficient is nonnegative. -/
theorem complexRootExponentialEnvelope_nonneg
    {C α : ℝ} (hC : 0 ≤ C) (n : ℕ) :
    0 ≤ complexRootExponentialEnvelope C α n := by
  exact
    mul_nonneg
      (div_nonneg hC (Real.sqrt_nonneg _))
      (Real.exp_nonneg _)

/-- Increasing the scalar coefficient increases the envelope. -/
theorem complexRootExponentialEnvelope_mono_constant
    {C₁ C₂ α : ℝ} (hC : C₁ ≤ C₂) (n : ℕ) :
    complexRootExponentialEnvelope C₁ α n ≤
      complexRootExponentialEnvelope C₂ α n := by
  exact
    mul_le_mul_of_nonneg_right
      (div_le_div_of_nonneg_right hC (Real.sqrt_nonneg _))
      (Real.exp_nonneg _)

/-- A complex norm estimate beginning at an explicit index. -/
def HasComplexRootExponentialEstimateFrom
    (a : ℕ → ℂ) (C α : ℝ) (N : ℕ) : Prop :=
  ∀ n : ℕ, N ≤ n →
    ‖a n‖ ≤ complexRootExponentialEnvelope C α n

/-- The all-index complex norm law, including positivity of both displayed constants. -/
def HasComplexRootExponentialBound
    (a : ℕ → ℂ) (C α : ℝ) : Prop :=
  0 < C ∧ 0 < α ∧ HasComplexRootExponentialEstimateFrom a C α 1

/-- Existence of some all-index constants for a complex coefficient sequence. -/
def HasSomeComplexRootExponentialBound (a : ℕ → ℂ) : Prop :=
  ∃ C α : ℝ, HasComplexRootExponentialBound a C α

/-- The same norm inequality asserted only eventually. -/
def HasEventualComplexRootExponentialEstimate
    (a : ℕ → ℂ) (C α : ℝ) : Prop :=
  ∀ᶠ n : ℕ in atTop,
    ‖a n‖ ≤ complexRootExponentialEnvelope C α n

/-- Projection of the all-index complex norm estimate. -/
theorem coefficient_norm_le_of_complexRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α)
    {n : ℕ} (hn : 1 ≤ n) :
    ‖a n‖ ≤ complexRootExponentialEnvelope C α n :=
  hbound.2.2 n hn

/-- An all-index law yields the corresponding eventual law with the same constants. -/
theorem complexRootExponentialBound_implies_eventual
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α) :
    HasEventualComplexRootExponentialEstimate a C α := by
  filter_upwards [eventually_ge_atTop (1 : ℕ)] with n hn
  exact coefficient_norm_le_of_complexRootExponentialBound hbound hn

/-- Increasing the constant preserves a tail estimate. -/
theorem complexRootExponentialEstimateFrom_mono_constant
    {a : ℕ → ℂ} {C₁ C₂ α : ℝ} {N : ℕ}
    (hC : C₁ ≤ C₂)
    (hbound : HasComplexRootExponentialEstimateFrom a C₁ α N) :
    HasComplexRootExponentialEstimateFrom a C₂ α N := by
  intro n hn
  exact
    (hbound n hn).trans
      (complexRootExponentialEnvelope_mono_constant hC n)

/-! ## Two-sided scalar consequences -/

/-- The real part lies in the exact two-sided interval supplied by the norm envelope. -/
theorem coefficient_re_twoSided_of_complexRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α)
    {n : ℕ} (hn : 1 ≤ n) :
    -complexRootExponentialEnvelope C α n ≤ (a n).re ∧
      (a n).re ≤ complexRootExponentialEnvelope C α n := by
  apply abs_le.mp
  exact
    (Complex.abs_re_le_norm (a n)).trans
      (coefficient_norm_le_of_complexRootExponentialBound hbound hn)

/-- The imaginary part lies in the same exact two-sided interval. -/
theorem coefficient_im_twoSided_of_complexRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α)
    {n : ℕ} (hn : 1 ≤ n) :
    -complexRootExponentialEnvelope C α n ≤ (a n).im ∧
      (a n).im ≤ complexRootExponentialEnvelope C α n := by
  apply abs_le.mp
  exact
    (Complex.abs_im_le_norm (a n)).trans
      (coefficient_norm_le_of_complexRootExponentialBound hbound hn)

/-- Both scalar components are controlled without selecting a complex phase. -/
theorem coefficient_components_twoSided_of_complexRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α)
    {n : ℕ} (hn : 1 ≤ n) :
    (-complexRootExponentialEnvelope C α n ≤ (a n).re ∧
      (a n).re ≤ complexRootExponentialEnvelope C α n) ∧
    (-complexRootExponentialEnvelope C α n ≤ (a n).im ∧
      (a n).im ≤ complexRootExponentialEnvelope C α n) :=
  ⟨coefficient_re_twoSided_of_complexRootExponentialBound hbound hn,
    coefficient_im_twoSided_of_complexRootExponentialBound hbound hn⟩

/-- The real-part sequence satisfies the existing scalar all-index predicate with the same
constants. -/
theorem realPart_has_scalarRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α) :
    QYM.RootExpWeylLogicCore.HasRootExponentialBound
      (fun n => (a n).re) C α := by
  refine ⟨hbound.1, hbound.2.1, ?_⟩
  intro n hn
  have hre : |(a n).re| ≤ complexRootExponentialEnvelope C α n :=
    (Complex.abs_re_le_norm (a n)).trans (hbound.2.2 n hn)
  simpa [complexRootExponentialEnvelope,
    QYM.RootExpWeylLogicCore.rootExponentialEnvelope] using hre

/-- The imaginary-part sequence satisfies the same scalar all-index predicate. -/
theorem imaginaryPart_has_scalarRootExponentialBound
    {a : ℕ → ℂ} {C α : ℝ}
    (hbound : HasComplexRootExponentialBound a C α) :
    QYM.RootExpWeylLogicCore.HasRootExponentialBound
      (fun n => (a n).im) C α := by
  refine ⟨hbound.1, hbound.2.1, ?_⟩
  intro n hn
  have him : |(a n).im| ≤ complexRootExponentialEnvelope C α n :=
    (Complex.abs_im_le_norm (a n)).trans (hbound.2.2 n hn)
  simpa [complexRootExponentialEnvelope,
    QYM.RootExpWeylLogicCore.rootExponentialEnvelope] using him

/-! ## A genuine finite-prefix `max` constant -/

/-- The coefficient normalized so that an upper bound on this quantity is an envelope constant. -/
def normalizedComplexCoefficient
    (a : ℕ → ℂ) (α : ℝ) (n : ℕ) : ℝ :=
  ‖a n‖ * Real.sqrt (n : ℝ) /
    Real.exp (α * Real.sqrt (n : ℝ))

theorem normalizedComplexCoefficient_nonneg
    (a : ℕ → ℂ) (α : ℝ) (n : ℕ) :
    0 ≤ normalizedComplexCoefficient a α n := by
  exact
    div_nonneg
      (mul_nonneg (norm_nonneg _) (Real.sqrt_nonneg _))
      (Real.exp_nonneg _)

/-- Recursive maximum of the normalized coefficients at indices `0, ..., N - 1`. -/
def finitePrefixRootExponentialConstant
    (a : ℕ → ℂ) (α : ℝ) : ℕ → ℝ
  | 0 => 0
  | N + 1 =>
      max (finitePrefixRootExponentialConstant a α N)
        (normalizedComplexCoefficient a α N)

theorem finitePrefixRootExponentialConstant_nonneg
    (a : ℕ → ℂ) (α : ℝ) (N : ℕ) :
    0 ≤ finitePrefixRootExponentialConstant a α N := by
  induction N with
  | zero => simp [finitePrefixRootExponentialConstant]
  | succ N ih =>
      rw [finitePrefixRootExponentialConstant]
      exact ih.trans (le_max_left _ _)

/-- Every normalized coefficient in the prefix is bounded by the recursive maximum. -/
theorem normalizedComplexCoefficient_le_finitePrefixConstant
    (a : ℕ → ℂ) (α : ℝ) {N n : ℕ} (hn : n < N) :
    normalizedComplexCoefficient a α n ≤
      finitePrefixRootExponentialConstant a α N := by
  induction N generalizing n with
  | zero => omega
  | succ N ih =>
      rw [finitePrefixRootExponentialConstant]
      by_cases hlt : n < N
      · exact (ih hlt).trans (le_max_left _ _)
      · have heq : n = N := by omega
        subst n
        exact le_max_right _ _

/-- Reversing the normalization recovers the desired envelope inequality at every positive index. -/
theorem norm_le_complexRootExponentialEnvelope_of_normalized_le
    {a : ℕ → ℂ} {C α : ℝ} {n : ℕ}
    (hn : 1 ≤ n)
    (hnormalized : normalizedComplexCoefficient a α n ≤ C) :
    ‖a n‖ ≤ complexRootExponentialEnvelope C α n := by
  have hnReal : (0 : ℝ) < (n : ℝ) := by
    have hnNat : 0 < n := by omega
    exact_mod_cast hnNat
  have hsqrt : 0 < Real.sqrt (n : ℝ) :=
    Real.sqrt_pos.2 hnReal
  have hexp : 0 < Real.exp (α * Real.sqrt (n : ℝ)) :=
    Real.exp_pos _
  have hmul :
      ‖a n‖ * Real.sqrt (n : ℝ) ≤
        C * Real.exp (α * Real.sqrt (n : ℝ)) := by
    have hnormalized' :
        ‖a n‖ * Real.sqrt (n : ℝ) /
            Real.exp (α * Real.sqrt (n : ℝ)) ≤ C := by
      simpa [normalizedComplexCoefficient] using hnormalized
    exact (div_le_iff₀ hexp).1 hnormalized'
  calc
    ‖a n‖ ≤
        (C * Real.exp (α * Real.sqrt (n : ℝ))) /
          Real.sqrt (n : ℝ) :=
      (le_div_iff₀ hsqrt).2 hmul
    _ = complexRootExponentialEnvelope C α n := by
      simp only [complexRootExponentialEnvelope]
      ring

/-- Every finite positive prefix has an actual, explicitly defined envelope constant. -/
theorem finitePrefix_norm_le_finitePrefixConstant
    (a : ℕ → ℂ) (α : ℝ) {N n : ℕ}
    (hnOne : 1 ≤ n) (hnN : n < N) :
    ‖a n‖ ≤
      complexRootExponentialEnvelope
        (finitePrefixRootExponentialConstant a α N) α n := by
  apply norm_le_complexRootExponentialEnvelope_of_normalized_le hnOne
  exact normalizedComplexCoefficient_le_finitePrefixConstant a α hnN

/-! ## Tail plus prefix gives a global law with an enlarged constant -/

/-- A supplied prefix constant and a supplied tail constant combine by `max`. -/
theorem complexRootExponentialBound_of_prefix_and_tail_max
    {a : ℕ → ℂ} {Ctail Cprefix α : ℝ} {N : ℕ}
    (hCtail : 0 < Ctail) (hα : 0 < α)
    (hprefix : ∀ n : ℕ, 1 ≤ n → n < N →
      ‖a n‖ ≤ complexRootExponentialEnvelope Cprefix α n)
    (htail : HasComplexRootExponentialEstimateFrom a Ctail α N) :
    HasComplexRootExponentialBound a (max Ctail Cprefix) α := by
  refine ⟨hCtail.trans_le (le_max_left _ _), hα, ?_⟩
  intro n hnOne
  by_cases hnN : n < N
  · exact
      (hprefix n hnOne hnN).trans
        (complexRootExponentialEnvelope_mono_constant
          (le_max_right _ _) n)
  · exact
      (htail n (Nat.le_of_not_gt hnN)).trans
        (complexRootExponentialEnvelope_mono_constant
          (le_max_left _ _) n)

/-- No prefix supplier is needed for existence: the recursive finite maximum supplies it. -/
theorem complexRootExponentialBound_of_tail_and_finitePrefix
    {a : ℕ → ℂ} {C α : ℝ} {N : ℕ}
    (hC : 0 < C) (hα : 0 < α)
    (htail : HasComplexRootExponentialEstimateFrom a C α N) :
    HasComplexRootExponentialBound a
      (max C (finitePrefixRootExponentialConstant a α N)) α := by
  refine complexRootExponentialBound_of_prefix_and_tail_max hC hα ?_ htail
  intro n hnOne hnN
  exact finitePrefix_norm_le_finitePrefixConstant a α hnOne hnN

/-- An eventual estimate has an explicit tail starting index. -/
theorem exists_complexRootExponentialEstimateFrom_of_eventual
    {a : ℕ → ℂ} {C α : ℝ}
    (heventual : HasEventualComplexRootExponentialEstimate a C α) :
    ∃ N : ℕ, HasComplexRootExponentialEstimateFrom a C α N := by
  simpa [HasEventualComplexRootExponentialEstimate,
    HasComplexRootExponentialEstimateFrom] using
      (eventually_atTop.1 heventual)

/-- Eventual control with positive constants yields a global law after enlarging only `C`. -/
theorem exists_global_complexRootExponentialBound_of_eventual
    {a : ℕ → ℂ} {C α : ℝ}
    (hC : 0 < C) (hα : 0 < α)
    (heventual : HasEventualComplexRootExponentialEstimate a C α) :
    ∃ Cglobal : ℝ, C ≤ Cglobal ∧
      HasComplexRootExponentialBound a Cglobal α := by
  rcases exists_complexRootExponentialEstimateFrom_of_eventual heventual with
    ⟨N, htail⟩
  refine
    ⟨max C (finitePrefixRootExponentialConstant a α N),
      le_max_left _ _, ?_⟩
  exact complexRootExponentialBound_of_tail_and_finitePrefix hC hα htail

/-! ## Phase-free one-term norm and remainder suppliers -/

/-- Norm control on an arbitrary complex main term.  This does not select or assert its phase. -/
def HasComplexMainTermNormEnvelopeFrom
    (mainTerm : ℕ → ℂ) (A α : ℝ) (N : ℕ) : Prop :=
  0 ≤ A ∧
    ∀ n : ℕ, N ≤ n →
      ‖mainTerm n‖ ≤ complexRootExponentialEnvelope A α n

/-- The explicit `n⁻¹ exp (α √n)` scale for a complex norm remainder. -/
def complexOneTermRemainderEnvelope
    (D α : ℝ) (n : ℕ) : ℝ :=
  D / (n : ℝ) * Real.exp (α * Real.sqrt (n : ℝ))

/-- A phase-free remainder supplier for `a - mainTerm`. -/
def HasComplexOneTermRemainderFrom
    (a mainTerm : ℕ → ℂ) (D α : ℝ) (N : ℕ) : Prop :=
  1 ≤ N ∧ 0 ≤ D ∧
    ∀ n : ℕ, N ≤ n →
      ‖a n - mainTerm n‖ ≤ complexOneTermRemainderEnvelope D α n

/-- Both analytic inputs needed to deduce a tail bound, without a manufactured main-term phase. -/
def HasComplexOneTermNormSuppliersFrom
    (a mainTerm : ℕ → ℂ) (A D α : ℝ) (N : ℕ) : Prop :=
  HasComplexMainTermNormEnvelopeFrom mainTerm A α N ∧
    HasComplexOneTermRemainderFrom a mainTerm D α N

/-- On positive indices, the explicit remainder scale is bounded by the root-exponential scale. -/
theorem complexOneTermRemainderEnvelope_le_rootExponentialEnvelope
    {D α : ℝ} (hD : 0 ≤ D) {n : ℕ} (hn : 1 ≤ n) :
    complexOneTermRemainderEnvelope D α n ≤
      complexRootExponentialEnvelope D α n := by
  have hnReal : (1 : ℝ) ≤ (n : ℝ) := by
    exact_mod_cast hn
  have hnRealPos : (0 : ℝ) < (n : ℝ) :=
    zero_lt_one.trans_le hnReal
  have hsqrtPos : 0 < Real.sqrt (n : ℝ) :=
    Real.sqrt_pos.2 hnRealPos
  have hsqrtLe : Real.sqrt (n : ℝ) ≤ (n : ℝ) := by
    rw [Real.sqrt_le_iff]
    exact ⟨hnRealPos.le, by nlinarith⟩
  have hdiv : D / (n : ℝ) ≤ D / Real.sqrt (n : ℝ) :=
    div_le_div_of_nonneg_left hD hsqrtPos hsqrtLe
  exact
    mul_le_mul_of_nonneg_right hdiv (Real.exp_nonneg _)

/-- Triangle inequality with the arbitrary main term and explicit remainder kept separate. -/
theorem coefficient_norm_le_main_add_remainder
    {a mainTerm : ℕ → ℂ} {A D α : ℝ} {N n : ℕ}
    (hsuppliers : HasComplexOneTermNormSuppliersFrom
      a mainTerm A D α N)
    (hn : N ≤ n) :
    ‖a n‖ ≤
      complexRootExponentialEnvelope A α n +
        complexOneTermRemainderEnvelope D α n := by
  rcases hsuppliers with ⟨hmain, hremainder⟩
  have hdecomposition :
      a n = mainTerm n + (a n - mainTerm n) := by
    ring
  rw [hdecomposition]
  exact
    (norm_add_le _ _).trans
      (add_le_add (hmain.2 n hn) (hremainder.2.2 n hn))

/-- The two phase-free suppliers imply a root-exponential tail with constant `A + D`. -/
theorem complexOneTermNormSuppliers_imply_tailEstimate
    {a mainTerm : ℕ → ℂ} {A D α : ℝ} {N : ℕ}
    (hsuppliers : HasComplexOneTermNormSuppliersFrom
      a mainTerm A D α N) :
    HasComplexRootExponentialEstimateFrom a (A + D) α N := by
  intro n hn
  have hnOne : 1 ≤ n := hsuppliers.2.1.trans hn
  calc
    ‖a n‖ ≤
        complexRootExponentialEnvelope A α n +
          complexOneTermRemainderEnvelope D α n :=
      coefficient_norm_le_main_add_remainder hsuppliers hn
    _ ≤ complexRootExponentialEnvelope A α n +
        complexRootExponentialEnvelope D α n :=
      add_le_add_right
        (complexOneTermRemainderEnvelope_le_rootExponentialEnvelope
          hsuppliers.2.2.1 hnOne) _
    _ = complexRootExponentialEnvelope (A + D) α n := by
      simp only [complexRootExponentialEnvelope]
      ring

/-- The one-term suppliers give an all-index law after adding a positive tail floor and absorbing
the finite prefix into its recursive maximum. -/
theorem exists_global_complexRootExponentialBound_of_oneTermSuppliers
    {a mainTerm : ℕ → ℂ} {A D α : ℝ} {N : ℕ}
    (hα : 0 < α)
    (hsuppliers : HasComplexOneTermNormSuppliersFrom
      a mainTerm A D α N) :
    ∃ Cglobal : ℝ, HasComplexRootExponentialBound a Cglobal α := by
  let Ctail : ℝ := max 1 (A + D)
  have hCtail : 0 < Ctail :=
    zero_lt_one.trans_le (le_max_left _ _)
  have htailAD :
      HasComplexRootExponentialEstimateFrom a (A + D) α N :=
    complexOneTermNormSuppliers_imply_tailEstimate hsuppliers
  have htail : HasComplexRootExponentialEstimateFrom a Ctail α N :=
    complexRootExponentialEstimateFrom_mono_constant
      (le_max_right _ _) htailAD
  refine
    ⟨max Ctail (finitePrefixRootExponentialConstant a α N), ?_⟩
  exact complexRootExponentialBound_of_tail_and_finitePrefix hCtail hα htail

/-! ## Fixed-constant no-go model -/

/-- A single complex coefficient larger than the fixed envelope, followed by a zero tail. -/
def complexInitialSpikeSequence
    (C α : ℝ) (n : ℕ) : ℂ :=
  if n = 1 then
    ((complexRootExponentialEnvelope C α 1 + 1 : ℝ) : ℂ)
  else 0

theorem complexInitialSpikeSequence_has_eventualEstimate
    {C α : ℝ} (hC : 0 ≤ C) :
    HasEventualComplexRootExponentialEstimate
      (complexInitialSpikeSequence C α) C α := by
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with n hn
  have hnOne : n ≠ 1 := by omega
  simp only [complexInitialSpikeSequence, if_neg hnOne, norm_zero]
  exact complexRootExponentialEnvelope_nonneg hC n

theorem complexInitialSpikeSequence_not_fixedAllIndexBound
    (C α : ℝ) :
    ¬ HasComplexRootExponentialBound
      (complexInitialSpikeSequence C α) C α := by
  intro hbound
  have hAtOne :=
    coefficient_norm_le_of_complexRootExponentialBound
      hbound (n := 1) (by omega)
  have hEnvelopeNonneg :
      0 ≤ complexRootExponentialEnvelope C α 1 :=
    complexRootExponentialEnvelope_nonneg hbound.1.le 1
  have hSumNonneg :
      0 ≤ complexRootExponentialEnvelope C α 1 + 1 := by
    linarith
  have hValue :
      complexInitialSpikeSequence C α 1 =
        ((complexRootExponentialEnvelope C α 1 + 1 : ℝ) : ℂ) := by
    simp [complexInitialSpikeSequence]
  rw [hValue, Complex.norm_of_nonneg hSumNonneg] at hAtOne
  linarith

/-- Positive complex countermodel to eventual-to-all-index inference at a fixed constant. -/
theorem fixedConstant_eventual_allIndex_countermodel :
    ∃ (a : ℕ → ℂ) (C α : ℝ),
      0 < C ∧ 0 < α ∧
        HasEventualComplexRootExponentialEstimate a C α ∧
          ¬ HasComplexRootExponentialBound a C α := by
  exact
    ⟨complexInitialSpikeSequence 1 1, 1, 1,
      zero_lt_one, zero_lt_one,
      complexInitialSpikeSequence_has_eventualEstimate zero_le_one,
      complexInitialSpikeSequence_not_fixedAllIndexBound 1 1⟩

theorem fixedConstant_eventual_does_not_imply_allIndex :
    ¬ (∀ (a : ℕ → ℂ) (C α : ℝ),
      0 < C → 0 < α →
        HasEventualComplexRootExponentialEstimate a C α →
          HasComplexRootExponentialBound a C α) := by
  intro hinference
  exact
    complexInitialSpikeSequence_not_fixedAllIndexBound 1 1
      (hinference (complexInitialSpikeSequence 1 1) 1 1
        zero_lt_one zero_lt_one
        (complexInitialSpikeSequence_has_eventualEstimate zero_le_one))

/-! ## Finite-modification invariance after allowing the constant to enlarge -/

/-- Two complex sequences agree after an explicit index. -/
def ComplexCoefficientsAgreeFrom
    (a b : ℕ → ℂ) (N : ℕ) : Prop :=
  ∀ n : ℕ, N ≤ n → a n = b n

theorem eventuallyEq_of_complexCoefficientsAgreeFrom
    {a b : ℕ → ℂ} {N : ℕ}
    (hagree : ComplexCoefficientsAgreeFrom a b N) :
    a =ᶠ[atTop] b := by
  filter_upwards [eventually_ge_atTop N] with n hn
  exact hagree n hn

/-- Eventual equality transports an eventual estimate without changing its constants. -/
theorem eventualEstimate_of_eventuallyEq
    {a b : ℕ → ℂ} {C α : ℝ}
    (hagree : a =ᶠ[atTop] b)
    (hbound : HasEventualComplexRootExponentialEstimate b C α) :
    HasEventualComplexRootExponentialEstimate a C α := by
  filter_upwards [hagree, hbound] with n hn hestimate
  simpa [hn] using hestimate

/-- At a fixed exponent, existence of some global constant is invariant under finite changes. -/
theorem exists_constant_at_exponent_congr_eventually
    {a b : ℕ → ℂ} {α : ℝ}
    (hagree : a =ᶠ[atTop] b) :
    (∃ C : ℝ, HasComplexRootExponentialBound a C α) ↔
      ∃ C : ℝ, HasComplexRootExponentialBound b C α := by
  constructor
  · rintro ⟨C, hbound⟩
    have haEventual :=
      complexRootExponentialBound_implies_eventual hbound
    have hbEventual :=
      eventualEstimate_of_eventuallyEq hagree.symm haEventual
    rcases exists_global_complexRootExponentialBound_of_eventual
        hbound.1 hbound.2.1 hbEventual with
      ⟨Cglobal, _hCglobal, hglobal⟩
    exact ⟨Cglobal, hglobal⟩
  · rintro ⟨C, hbound⟩
    have hbEventual :=
      complexRootExponentialBound_implies_eventual hbound
    have haEventual :=
      eventualEstimate_of_eventuallyEq hagree hbEventual
    rcases exists_global_complexRootExponentialBound_of_eventual
        hbound.1 hbound.2.1 haEventual with
      ⟨Cglobal, _hCglobal, hglobal⟩
    exact ⟨Cglobal, hglobal⟩

/-- Explicit finite-prefix modification invariance, preserving the exponent and allowing `C` to
absorb the modified prefix. -/
theorem exists_constant_at_exponent_invariant_under_finiteModification
    {a b : ℕ → ℂ} {α : ℝ} {N : ℕ}
    (hagree : ComplexCoefficientsAgreeFrom a b N) :
    (∃ C : ℝ, HasComplexRootExponentialBound a C α) ↔
      ∃ C : ℝ, HasComplexRootExponentialBound b C α :=
  exists_constant_at_exponent_congr_eventually
    (eventuallyEq_of_complexCoefficientsAgreeFrom hagree)

/-- Existence of both constants is invariant under a finite modification. -/
theorem hasSomeComplexRootExponentialBound_invariant_under_finiteModification
    {a b : ℕ → ℂ} {N : ℕ}
    (hagree : ComplexCoefficientsAgreeFrom a b N) :
    HasSomeComplexRootExponentialBound a ↔
      HasSomeComplexRootExponentialBound b := by
  have heq := eventuallyEq_of_complexCoefficientsAgreeFrom hagree
  constructor
  · rintro ⟨C, α, hbound⟩
    rcases (exists_constant_at_exponent_congr_eventually
        (α := α) heq).mp ⟨C, hbound⟩ with
      ⟨Cglobal, hglobal⟩
    exact ⟨Cglobal, α, hglobal⟩
  · rintro ⟨C, α, hbound⟩
    rcases (exists_constant_at_exponent_congr_eventually
        (α := α) heq).mpr ⟨C, hbound⟩ with
      ⟨Cglobal, hglobal⟩
    exact ⟨Cglobal, α, hglobal⟩

end QYM.ComplexRootExponentialExtension

/-!
# Paper-normalized complex fidelity layer for Theorem 4.26

The paper's coefficient is naturally allowed to be complex.  These closed propositions retain its
norm-valued root-exponential content while refusing to manufacture a complex phase or a concrete
Rademacher main term.

The positive propositions are conditional consequences of explicit norm and remainder suppliers.
They do not establish the missing Paper-I hypotheses, a Rademacher expansion, or the actual mock
coefficient estimate.  The fixed-constant countermodel separates the PDF's all-index quantifier
from a merely eventual estimate.  Enlarging the constant absorbs a finite prefix.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Norm and scalar-component consequences -/

/-- An all-index complex norm supplier controls the norm and both scalar components. -/
def theorem4_26_complexNormAndComponentsStatement : Prop :=
  ∀ (a : ℕ → ℂ) (C α : ℝ),
    QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
        a C α →
      ∀ n : ℕ, 1 ≤ n →
        ‖a n‖ ≤
            QYM.ComplexRootExponentialExtension.complexRootExponentialEnvelope C α n ∧
          (-QYM.ComplexRootExponentialExtension.complexRootExponentialEnvelope C α n ≤
              (a n).re ∧
            (a n).re ≤
              QYM.ComplexRootExponentialExtension.complexRootExponentialEnvelope C α n) ∧
          (-QYM.ComplexRootExponentialExtension.complexRootExponentialEnvelope C α n ≤
              (a n).im ∧
            (a n).im ≤
              QYM.ComplexRootExponentialExtension.complexRootExponentialEnvelope C α n)

theorem theorem4_26_complexNormAndComponentsStatement_holds :
    theorem4_26_complexNormAndComponentsStatement := by
  intro a C α hbound n hn
  exact
    ⟨QYM.ComplexRootExponentialExtension.coefficient_norm_le_of_complexRootExponentialBound
        hbound hn,
      QYM.ComplexRootExponentialExtension.coefficient_components_twoSided_of_complexRootExponentialBound
        hbound hn⟩

/-! ## Eventual plus finite prefix, with a genuinely enlarged constant -/

/-- Eventual norm control gives an all-index law after the recursive finite-prefix maximum is
absorbed into a new constant. -/
def theorem4_26_complexEventualToEnlargedGlobalStatement : Prop :=
  ∀ (a : ℕ → ℂ) (C α : ℝ),
    0 < C → 0 < α →
      QYM.ComplexRootExponentialExtension.HasEventualComplexRootExponentialEstimate
          a C α →
        ∃ Cglobal : ℝ, C ≤ Cglobal ∧
          QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
            a Cglobal α

theorem theorem4_26_complexEventualToEnlargedGlobalStatement_holds :
    theorem4_26_complexEventualToEnlargedGlobalStatement := by
  intro a C α hC hα heventual
  exact
    QYM.ComplexRootExponentialExtension.exists_global_complexRootExponentialBound_of_eventual
      hC hα heventual

/-! ## Phase-free one-term supplier consequence -/

/-- An arbitrary complex main term with a norm envelope, together with an explicit norm remainder,
implies existence of an all-index constant.  No phase formula is part of the statement. -/
def theorem4_26_complexOneTermNormSupplierStatement : Prop :=
  ∀ (a mainTerm : ℕ → ℂ) (A D α : ℝ) (N : ℕ),
    0 < α →
      QYM.ComplexRootExponentialExtension.HasComplexOneTermNormSuppliersFrom
          a mainTerm A D α N →
        ∃ Cglobal : ℝ,
          QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
            a Cglobal α

theorem theorem4_26_complexOneTermNormSupplierStatement_holds :
    theorem4_26_complexOneTermNormSupplierStatement := by
  intro a mainTerm A D α N hα hsuppliers
  exact
    QYM.ComplexRootExponentialExtension.exists_global_complexRootExponentialBound_of_oneTermSuppliers
      hα hsuppliers

/-! ## Fixed-constant no-go and concrete complex countermodel -/

/-- The overstrong inference that an eventual estimate works globally with exactly the same `C`. -/
def theorem4_26_complexFixedConstantEventualInferenceStatement : Prop :=
  ∀ (a : ℕ → ℂ) (C α : ℝ),
    0 < C → 0 < α →
      QYM.ComplexRootExponentialExtension.HasEventualComplexRootExponentialEstimate
          a C α →
        QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
          a C α

theorem theorem4_26_complexFixedConstantEventualInferenceStatement_refuted :
    ¬ theorem4_26_complexFixedConstantEventualInferenceStatement :=
  QYM.ComplexRootExponentialExtension.fixedConstant_eventual_does_not_imply_allIndex

/-- A positive-constant complex spike countermodel to the fixed-constant inference. -/
def theorem4_26_complexInitialSpikeCountermodelStatement : Prop :=
  ∃ (a : ℕ → ℂ) (C α : ℝ),
    0 < C ∧ 0 < α ∧
      QYM.ComplexRootExponentialExtension.HasEventualComplexRootExponentialEstimate
          a C α ∧
        ¬ QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
          a C α

theorem theorem4_26_complexInitialSpikeCountermodelStatement_holds :
    theorem4_26_complexInitialSpikeCountermodelStatement :=
  QYM.ComplexRootExponentialExtension.fixedConstant_eventual_allIndex_countermodel

/-! ## Finite-modification invariance -/

/-- Changing only a finite prefix preserves existence of a constant at each fixed exponent, while
the actual constant is allowed to enlarge. -/
def theorem4_26_complexFiniteModificationInvarianceStatement : Prop :=
  ∀ (a b : ℕ → ℂ) (α : ℝ) (N : ℕ),
    QYM.ComplexRootExponentialExtension.ComplexCoefficientsAgreeFrom a b N →
      ((∃ C : ℝ,
          QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
            a C α) ↔
        ∃ C : ℝ,
          QYM.ComplexRootExponentialExtension.HasComplexRootExponentialBound
            b C α)

theorem theorem4_26_complexFiniteModificationInvarianceStatement_holds :
    theorem4_26_complexFiniteModificationInvarianceStatement := by
  intro a b α N hagree
  exact
    QYM.ComplexRootExponentialExtension.exists_constant_at_exponent_invariant_under_finiteModification
      hagree

end QYM.FullCertification.PaperNormalized

/-!
# Quantitative truncation and low-gap stability

This module isolates the finite-index quantitative content required by Hypothesis 4.24 and
Corollary 4.25.  It does not manufacture a Mosco limit, norm-resolvent convergence, a compact
resolvent, or an eigenvalue enumeration.  Instead it proves exactly what follows once equally
indexed truncation eigenvalues and their error radii are supplied.

The final moving-spike family separates pointwise convergence at every fixed index from one
uniform-in-index estimate.  This is the same quantifier distinction that an admissible exhaustion
must settle before a truncation argument can be used uniformly across a growing spectrum.
-/

namespace QYM.TruncationGapStabilityCore

/-! ## Indexed gaps and uniform truncation errors -/

/-- Difference of two selected levels of an indexed real family. -/
def gap {Index : Type*} (spectrum : Index → ℝ) (lower upper : Index) : ℝ :=
  spectrum upper - spectrum lower

/-- At truncation height `Y`, every matched level lies in the displayed additive error radius. -/
def UniformEigenvalueError
    {Index : Type*} (approximation : ℕ → Index → ℝ)
    (limit : Index → ℝ) (radius : ℕ → ℝ) : Prop :=
  ∀ Y index, |approximation Y index - limit index| ≤ radius Y

theorem uniformEigenvalueError_iff
    {Index : Type*} (approximation : ℕ → Index → ℝ)
    (limit : Index → ℝ) (radius : ℕ → ℝ) :
    UniformEigenvalueError approximation limit radius ↔
      ∀ Y index, |approximation Y index - limit index| ≤ radius Y :=
  Iff.rfl

/-- Two matched eigenvalue errors give twice the radius for every selected gap. -/
theorem gap_error_le_two_radius
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) :
    |gap (approximation Y) lower upper - gap limit lower upper| ≤
      2 * radius Y := by
  obtain ⟨hlowerLeft, hlowerRight⟩ := abs_le.mp (herror Y lower)
  obtain ⟨hupperLeft, hupperRight⟩ := abs_le.mp (herror Y upper)
  apply abs_le.mpr
  constructor <;> simp only [gap] <;> linarith

/-- A reference lower gap loses at most twice the matched eigenvalue error. -/
theorem truncatedGap_lower_bound
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) {delta : ℝ}
    (hgap : delta ≤ gap limit lower upper) :
    delta - 2 * radius Y ≤ gap (approximation Y) lower upper := by
  have hbound := gap_error_le_two_radius herror Y lower upper
  have hlowerError := (abs_le.mp hbound).1
  linarith

/-- The paper's quarter-error threshold retains at least half of a supplied reference gap. -/
theorem half_gap_of_radius_le_quarter
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) {delta : ℝ}
    (hgap : delta ≤ gap limit lower upper)
    (hquarter : radius Y ≤ delta / 4) :
    delta / 2 ≤ gap (approximation Y) lower upper := by
  have hlower := truncatedGap_lower_bound herror Y lower upper hgap
  linarith

theorem truncatedGap_pos_of_radius_lt_half
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) {delta : ℝ}
    (hgap : delta ≤ gap limit lower upper)
    (hsmall : 2 * radius Y < delta) :
    0 < gap (approximation Y) lower upper := by
  have hlower := truncatedGap_lower_bound herror Y lower upper hgap
  linarith

/-! ## Vanishing radii and eventual low-gap stability -/

/-- Elementary epsilon-tail formulation of convergence of the nonnegative error scale to zero. -/
def RadiusTendsToZero (radius : ℕ → ℝ) : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y → radius Y ≤ epsilon

/-- A positive limiting gap and a vanishing uniform error radius give an eventual half-gap. -/
theorem eventually_half_gap_of_radius_tendsToZero
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (hradius : RadiusTendsToZero radius)
    (lower upper : Index) {delta : ℝ}
    (hdelta : 0 < delta) (hgap : delta ≤ gap limit lower upper) :
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      delta / 2 ≤ gap (approximation Y) lower upper := by
  obtain ⟨Y0, hY0⟩ := hradius (delta / 4) (by linarith)
  refine ⟨Y0, ?_⟩
  intro Y hY
  exact half_gap_of_radius_le_quarter herror Y lower upper hgap (hY0 Y hY)

/-- Uniformly positive calibrated form bounds transfer through a truncation error. -/
theorem calibrated_truncatedGap_lower_bound
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius alpha radial : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) {delta : ℝ}
    (hproduct : delta ≤ alpha Y * radial Y)
    (hcalibration : alpha Y * radial Y ≤ gap limit lower upper) :
    delta - 2 * radius Y ≤ gap (approximation Y) lower upper :=
  truncatedGap_lower_bound herror Y lower upper (hproduct.trans hcalibration)

/-- Quarter-small truncation error preserves half of a calibrated coercivity product. -/
theorem half_calibratedGap_of_radius_le_quarter
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius alpha radial : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (Y : ℕ) (lower upper : Index) {delta : ℝ}
    (hproduct : delta ≤ alpha Y * radial Y)
    (hcalibration : alpha Y * radial Y ≤ gap limit lower upper)
    (hquarter : radius Y ≤ delta / 4) :
    delta / 2 ≤ gap (approximation Y) lower upper :=
  half_gap_of_radius_le_quarter herror Y lower upper
    (hproduct.trans hcalibration) hquarter

/-- A uniform positive calibrated lower bound and a vanishing matched-eigenvalue error give an
eventual quantitative truncation gap.  This is the exact extra spectral approximation supplier
needed to turn the product bound in Hypothesis 4.24 into a statement about truncated levels. -/
theorem eventually_half_calibratedGap_of_radius_tendsToZero
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ} {radius alpha radial : ℕ → ℝ}
    (herror : UniformEigenvalueError approximation limit radius)
    (hradius : RadiusTendsToZero radius)
    (lower upper : Index) {delta : ℝ}
    (hdelta : 0 < delta)
    (hproduct : ∀ Y, delta ≤ alpha Y * radial Y)
    (hcalibration : ∀ Y, alpha Y * radial Y ≤ gap limit lower upper) :
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      delta / 2 ≤ gap (approximation Y) lower upper := by
  obtain ⟨Y0, hY0⟩ := hradius (delta / 4) (by linarith)
  refine ⟨Y0, ?_⟩
  intro Y hY
  exact half_calibratedGap_of_radius_le_quarter herror Y lower upper
    (hproduct Y) (hcalibration Y) (hY0 Y hY)

/-! ## Pointwise convergence and the fixed low-gap consequence -/

/-- Epsilon-tail convergence at every fixed spectral index. -/
def PointwiseEigenvalueConvergence
    {Index : Type*} (approximation : ℕ → Index → ℝ)
    (limit : Index → ℝ) : Prop :=
  ∀ index epsilon, 0 < epsilon →
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      |approximation Y index - limit index| ≤ epsilon

/-- Pointwise convergence at the two selected indices yields convergence of that fixed gap. -/
theorem fixedGap_error_eventually
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ}
    (hpointwise : PointwiseEigenvalueConvergence approximation limit)
    (lower upper : Index) {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      |gap (approximation Y) lower upper - gap limit lower upper| ≤
        2 * epsilon := by
  obtain ⟨Ylower, hYlower⟩ := hpointwise lower epsilon hepsilon
  obtain ⟨Yupper, hYupper⟩ := hpointwise upper epsilon hepsilon
  refine ⟨max Ylower Yupper, ?_⟩
  intro Y hY
  have hlower := hYlower Y ((Nat.le_max_left _ _).trans hY)
  have hupper := hYupper Y ((Nat.le_max_right _ _).trans hY)
  obtain ⟨hlowerLeft, hlowerRight⟩ := abs_le.mp hlower
  obtain ⟨hupperLeft, hupperRight⟩ := abs_le.mp hupper
  apply abs_le.mpr
  constructor <;> simp only [gap] <;> linarith

/-- Pointwise convergence is enough for one fixed positive low-lying gap. -/
theorem eventually_half_fixedGap_of_pointwise
    {Index : Type*} {approximation : ℕ → Index → ℝ}
    {limit : Index → ℝ}
    (hpointwise : PointwiseEigenvalueConvergence approximation limit)
    (lower upper : Index) {delta : ℝ}
    (hdelta : 0 < delta) (hgap : delta ≤ gap limit lower upper) :
    ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      delta / 2 ≤ gap (approximation Y) lower upper := by
  obtain ⟨Y0, hY0⟩ :=
    fixedGap_error_eventually hpointwise lower upper (show 0 < delta / 4 by linarith)
  refine ⟨Y0, ?_⟩
  intro Y hY
  have hbound := hY0 Y hY
  have hlowerError := (abs_le.mp hbound).1
  linarith

/-! ## Moving-index obstruction to uniform convergence -/

/-- A unit spike whose index moves with the truncation height. -/
def movingIndexSpike (Y index : ℕ) : ℝ :=
  if index = Y then 1 else 0

def zeroSpectrum (_index : ℕ) : ℝ := 0

theorem movingIndexSpike_pointwise_converges :
    PointwiseEigenvalueConvergence movingIndexSpike zeroSpectrum := by
  intro index epsilon hepsilon
  refine ⟨index + 1, ?_⟩
  intro Y hY
  have hne : index ≠ Y := by
    intro heq
    subst Y
    omega
  simp [movingIndexSpike, zeroSpectrum, hne, le_of_lt hepsilon]

/-- At every height the moving index retains unit error. -/
theorem movingIndexSpike_error_at_diagonal (Y : ℕ) :
    |movingIndexSpike Y Y - zeroSpectrum Y| = 1 := by
  simp [movingIndexSpike, zeroSpectrum]

/-- Pointwise convergence does not supply an eventual uniform error smaller than one half. -/
theorem movingIndexSpike_not_eventually_uniform_half :
    ¬ ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      ∀ index : ℕ,
        |movingIndexSpike Y index - zeroSpectrum index| ≤ (1 / 2 : ℝ) := by
  rintro ⟨Y0, hY0⟩
  have hbad := hY0 Y0 le_rfl Y0
  norm_num [movingIndexSpike, zeroSpectrum] at hbad

/-- The adjacent gap at the moving spike differs from the zero-spectrum gap by one. -/
theorem movingIndexSpike_movingGap_error (Y : ℕ) :
    |gap (movingIndexSpike Y) Y (Y + 1) -
        gap zeroSpectrum Y (Y + 1)| = 1 := by
  simp [gap, movingIndexSpike, zeroSpectrum]

/-- Closed package separating fixed-index convergence from uniform-in-index gap stability. -/
theorem pointwise_convergence_coexists_with_no_uniform_error :
    PointwiseEigenvalueConvergence movingIndexSpike zeroSpectrum ∧
      (¬ ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
        ∀ index : ℕ,
          |movingIndexSpike Y index - zeroSpectrum index| ≤ (1 / 2 : ℝ)) :=
  ⟨movingIndexSpike_pointwise_converges,
    movingIndexSpike_not_eventually_uniform_half⟩

end QYM.TruncationGapStabilityCore

/-!
# Paper-normalized truncation and low-gap statements

These statements refine the quantitative part of Hypothesis 4.24 and Corollary 4.25.  They do not
assert Mosco convergence or construct the paper's truncations.  Positive statements expose either
a uniform matched-eigenvalue error or pointwise convergence at the two fixed low indices.  The
countermodel refutes only the stronger passage from pointwise convergence to uniform-in-index
control.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Hypothesis 4.24: quantitative stability supplier -/

def hyp4_24_uniformTruncationGapTransferStatement : Prop :=
  ∀ (Index : Type) (approximation : ℕ → Index → ℝ)
      (limit : Index → ℝ) (radius : ℕ → ℝ)
      (lower upper : Index) (Y : ℕ) (delta : ℝ),
    QYM.TruncationGapStabilityCore.UniformEigenvalueError
        approximation limit radius →
    delta ≤ QYM.TruncationGapStabilityCore.gap limit lower upper →
    radius Y ≤ delta / 4 →
      delta / 2 ≤
        QYM.TruncationGapStabilityCore.gap (approximation Y) lower upper

theorem hyp4_24_uniformTruncationGapTransferStatement_holds :
    hyp4_24_uniformTruncationGapTransferStatement := by
  intro Index approximation limit radius lower upper Y delta herror hgap hquarter
  exact
    QYM.TruncationGapStabilityCore.half_gap_of_radius_le_quarter
      herror Y lower upper hgap hquarter

/-- Supplier-complete version of the uniform-in-truncation conclusion: the paper's positive
coercivity product is accompanied by an explicit matched-eigenvalue approximation radius tending
to zero. -/
def hyp4_24_eventualCalibratedGapStatement : Prop :=
  ∀ (Index : Type) (approximation : ℕ → Index → ℝ)
      (limit : Index → ℝ) (radius alpha radial : ℕ → ℝ)
      (lower upper : Index) (delta : ℝ),
    QYM.TruncationGapStabilityCore.UniformEigenvalueError
        approximation limit radius →
    QYM.TruncationGapStabilityCore.RadiusTendsToZero radius →
    0 < delta →
    (∀ Y, delta ≤ alpha Y * radial Y) →
    (∀ Y, alpha Y * radial Y ≤
      QYM.TruncationGapStabilityCore.gap limit lower upper) →
      ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
        delta / 2 ≤
          QYM.TruncationGapStabilityCore.gap (approximation Y) lower upper

theorem hyp4_24_eventualCalibratedGapStatement_holds :
    hyp4_24_eventualCalibratedGapStatement := by
  intro Index approximation limit radius alpha radial lower upper delta
    herror hradius hdelta hproduct hcalibration
  exact
    QYM.TruncationGapStabilityCore.eventually_half_calibratedGap_of_radius_tendsToZero
      herror hradius lower upper hdelta hproduct hcalibration

def hyp4_24_pointwiseToUniformInferenceStatement : Prop :=
  ∀ (approximation : ℕ → ℕ → ℝ) (limit : ℕ → ℝ),
    QYM.TruncationGapStabilityCore.PointwiseEigenvalueConvergence approximation limit →
      ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
        ∀ index : ℕ,
          |approximation Y index - limit index| ≤ (1 / 2 : ℝ)

theorem hyp4_24_pointwiseToUniformInferenceStatement_refuted :
    ¬ hyp4_24_pointwiseToUniformInferenceStatement := by
  intro hinference
  exact
    QYM.TruncationGapStabilityCore.movingIndexSpike_not_eventually_uniform_half
      (hinference
        QYM.TruncationGapStabilityCore.movingIndexSpike
        QYM.TruncationGapStabilityCore.zeroSpectrum
        QYM.TruncationGapStabilityCore.movingIndexSpike_pointwise_converges)

def hyp4_24_movingIndexCountermodelStatement : Prop :=
  QYM.TruncationGapStabilityCore.PointwiseEigenvalueConvergence
      QYM.TruncationGapStabilityCore.movingIndexSpike
      QYM.TruncationGapStabilityCore.zeroSpectrum ∧
    ¬ ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
      ∀ index : ℕ,
        |QYM.TruncationGapStabilityCore.movingIndexSpike Y index -
            QYM.TruncationGapStabilityCore.zeroSpectrum index| ≤ (1 / 2 : ℝ)

theorem hyp4_24_movingIndexCountermodelStatement_holds :
    hyp4_24_movingIndexCountermodelStatement :=
  QYM.TruncationGapStabilityCore.pointwise_convergence_coexists_with_no_uniform_error

/-! ## Corollary 4.25: fixed low-gap passage -/

def cor4_25_pointwiseFixedGapStatement : Prop :=
  ∀ (Index : Type) (approximation : ℕ → Index → ℝ)
      (limit : Index → ℝ) (lower upper : Index) (delta : ℝ),
    QYM.TruncationGapStabilityCore.PointwiseEigenvalueConvergence approximation limit →
    0 < delta →
    delta ≤ QYM.TruncationGapStabilityCore.gap limit lower upper →
      ∃ Y0 : ℕ, ∀ Y : ℕ, Y0 ≤ Y →
        delta / 2 ≤
          QYM.TruncationGapStabilityCore.gap (approximation Y) lower upper

theorem cor4_25_pointwiseFixedGapStatement_holds :
    cor4_25_pointwiseFixedGapStatement := by
  intro Index approximation limit lower upper delta hpointwise hdelta hgap
  exact
    QYM.TruncationGapStabilityCore.eventually_half_fixedGap_of_pointwise
      hpointwise lower upper hdelta hgap

/-! ## Proposition 4.23: calibrated supplier with truncation error -/

def prop4_23_calibratedTruncationGapStatement : Prop :=
  ∀ (Index : Type) (approximation : ℕ → Index → ℝ)
      (limit : Index → ℝ) (radius alpha radial : ℕ → ℝ)
      (lower upper : Index) (Y : ℕ) (delta : ℝ),
    QYM.TruncationGapStabilityCore.UniformEigenvalueError
        approximation limit radius →
    delta ≤ alpha Y * radial Y →
    alpha Y * radial Y ≤
      QYM.TruncationGapStabilityCore.gap limit lower upper →
      delta - 2 * radius Y ≤
        QYM.TruncationGapStabilityCore.gap (approximation Y) lower upper

theorem prop4_23_calibratedTruncationGapStatement_holds :
    prop4_23_calibratedTruncationGapStatement := by
  intro Index approximation limit radius alpha radial lower upper Y delta
    herror hproduct hcalibration
  exact
    QYM.TruncationGapStabilityCore.calibrated_truncatedGap_lower_bound
      herror Y lower upper hproduct hcalibration

end QYM.FullCertification.PaperNormalized

/-!
# Typed evidence for bounded Hilbert, complex coefficient, and truncation bridges

This fifth independent registry records the exact propositions proved by the three analytic bridge
tranches.  A link is deliberately non-terminal: bounded-operator statements do not become a
Friedrichs theorem, and supplier implications do not manufacture the paper's coefficient or
truncation convergence hypotheses.
-/

namespace QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension

open QYM.FullCertification.Registry

inductive EvidenceId where
  | boundedPositiveEnergy
  | boundedCoerciveSpectrum
  | boundedPerturbationGap
  | closedInvariantRestriction
  | finiteDimensionalCompactness
  | complexRootExponential
  | complexFixedConstantNoGo
  | truncationUniformTransfer
  | truncationPointwiseNoGo
  | fixedLowGapTransfer
  | calibratedTruncationGap
  deriving DecidableEq, Repr

/-- The exact proposition carried by each new evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .boundedPositiveEnergy =>
      QYM.FullCertification.PaperNormalized.boundedPositiveOperatorEnergyStatement
  | .boundedCoerciveSpectrum =>
      QYM.FullCertification.PaperNormalized.boundedCoerciveOperatorConsequencesStatement
  | .boundedPerturbationGap =>
      QYM.FullCertification.PaperNormalized.boundedPerturbationGapTransferStatement
  | .closedInvariantRestriction =>
      QYM.FullCertification.PaperNormalized.closedInvariantRestrictionSupplierStatement
  | .finiteDimensionalCompactness =>
      QYM.FullCertification.PaperNormalized.finiteDimensionalBoundedOperatorCompactStatement ∧
        QYM.FullCertification.PaperNormalized.compactOperatorBoundedImageStatement
  | .complexRootExponential =>
      QYM.FullCertification.PaperNormalized.theorem4_26_complexNormAndComponentsStatement ∧
        QYM.FullCertification.PaperNormalized.theorem4_26_complexEventualToEnlargedGlobalStatement ∧
          QYM.FullCertification.PaperNormalized.theorem4_26_complexOneTermNormSupplierStatement ∧
            QYM.FullCertification.PaperNormalized.theorem4_26_complexFiniteModificationInvarianceStatement
  | .complexFixedConstantNoGo =>
      ¬ QYM.FullCertification.PaperNormalized.theorem4_26_complexFixedConstantEventualInferenceStatement ∧
        QYM.FullCertification.PaperNormalized.theorem4_26_complexInitialSpikeCountermodelStatement
  | .truncationUniformTransfer =>
      QYM.FullCertification.PaperNormalized.hyp4_24_uniformTruncationGapTransferStatement ∧
        QYM.FullCertification.PaperNormalized.hyp4_24_eventualCalibratedGapStatement
  | .truncationPointwiseNoGo =>
      ¬ QYM.FullCertification.PaperNormalized.hyp4_24_pointwiseToUniformInferenceStatement ∧
        QYM.FullCertification.PaperNormalized.hyp4_24_movingIndexCountermodelStatement
  | .fixedLowGapTransfer =>
      QYM.FullCertification.PaperNormalized.cor4_25_pointwiseFixedGapStatement
  | .calibratedTruncationGap =>
      QYM.FullCertification.PaperNormalized.prop4_23_calibratedTruncationGapStatement

theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | boundedPositiveEnergy =>
      exact QYM.FullCertification.PaperNormalized.boundedPositiveOperatorEnergyStatement_holds
  | boundedCoerciveSpectrum =>
      exact QYM.FullCertification.PaperNormalized.boundedCoerciveOperatorConsequencesStatement_holds
  | boundedPerturbationGap =>
      exact QYM.FullCertification.PaperNormalized.boundedPerturbationGapTransferStatement_holds
  | closedInvariantRestriction =>
      exact QYM.FullCertification.PaperNormalized.closedInvariantRestrictionSupplierStatement_holds
  | finiteDimensionalCompactness =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.finiteDimensionalBoundedOperatorCompactStatement_holds,
          QYM.FullCertification.PaperNormalized.compactOperatorBoundedImageStatement_holds⟩
  | complexRootExponential =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.theorem4_26_complexNormAndComponentsStatement_holds,
          QYM.FullCertification.PaperNormalized.theorem4_26_complexEventualToEnlargedGlobalStatement_holds,
          QYM.FullCertification.PaperNormalized.theorem4_26_complexOneTermNormSupplierStatement_holds,
          QYM.FullCertification.PaperNormalized.theorem4_26_complexFiniteModificationInvarianceStatement_holds⟩
  | complexFixedConstantNoGo =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.theorem4_26_complexFixedConstantEventualInferenceStatement_refuted,
          QYM.FullCertification.PaperNormalized.theorem4_26_complexInitialSpikeCountermodelStatement_holds⟩
  | truncationUniformTransfer =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.hyp4_24_uniformTruncationGapTransferStatement_holds,
          QYM.FullCertification.PaperNormalized.hyp4_24_eventualCalibratedGapStatement_holds⟩
  | truncationPointwiseNoGo =>
      exact
        ⟨QYM.FullCertification.PaperNormalized.hyp4_24_pointwiseToUniformInferenceStatement_refuted,
          QYM.FullCertification.PaperNormalized.hyp4_24_movingIndexCountermodelStatement_holds⟩
  | fixedLowGapTransfer =>
      exact QYM.FullCertification.PaperNormalized.cor4_25_pointwiseFixedGapStatement_holds
  | calibratedTruncationGap =>
      exact QYM.FullCertification.PaperNormalized.prop4_23_calibratedTruncationGapStatement_holds

structure Certificate where
  id : EvidenceId
  proof : EvidenceStatement id

def certificate (evidence : EvidenceId) : Certificate where
  id := evidence
  proof := evidenceSound evidence

def allEvidence : List EvidenceId :=
  [.boundedPositiveEnergy,
   .boundedCoerciveSpectrum,
   .boundedPerturbationGap,
   .closedInvariantRestriction,
   .finiteDimensionalCompactness,
   .complexRootExponential,
   .complexFixedConstantNoGo,
   .truncationUniformTransfer,
   .truncationPointwiseNoGo,
   .fixedLowGapTransfer,
   .calibratedTruncationGap]

def allCertificates : List Certificate :=
  allEvidence.map certificate

theorem allEvidence_length : allEvidence.length = 11 := by
  decide

theorem allCertificates_length : allCertificates.length = 11 := by
  decide

theorem allEvidence_nodup : allEvidence.Nodup := by
  decide

theorem allEvidence_complete (evidence : EvidenceId) :
    evidence ∈ allEvidence := by
  cases evidence <;> simp [allEvidence]

theorem allCertificates_ids :
    allCertificates.map Certificate.id = allEvidence := by
  simp only [allCertificates, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) allEvidence = allEvidence
  rfl

/-! ## Non-terminal links to the existing paper claim inventory -/

def evidenceForClaim : ClaimId → List EvidenceId
  | .lemma4_13 => [.boundedPositiveEnergy]
  | .prop4_14 => [.boundedPositiveEnergy, .boundedPerturbationGap]
  | .lemma4_16 => [.boundedPositiveEnergy, .closedInvariantRestriction]
  | .lemma4_17 => [.boundedCoerciveSpectrum]
  | .lemma4_18 => [.closedInvariantRestriction, .finiteDimensionalCompactness]
  | .hyp4_20 => [.boundedCoerciveSpectrum]
  | .prop4_23 => [.calibratedTruncationGap]
  | .hyp4_24 => [.truncationUniformTransfer, .truncationPointwiseNoGo]
  | .cor4_25 => [.fixedLowGapTransfer]
  | .theorem4_26 => [.complexRootExponential, .complexFixedConstantNoGo]
  | .lemma4_30 => [.boundedPerturbationGap]
  | .theorem4_31 => [.boundedPerturbationGap]
  | .cor4_32 => [.boundedPerturbationGap, .truncationUniformTransfer]
  | _ => []

def certificatesForClaim (claim : ClaimId) : List Certificate :=
  (evidenceForClaim claim).map certificate

theorem certificatesForClaim_ids (claim : ClaimId) :
    (certificatesForClaim claim).map Certificate.id = evidenceForClaim claim := by
  simp only [certificatesForClaim, List.map_map]
  change List.map (fun evidence : EvidenceId => evidence) (evidenceForClaim claim) =
    evidenceForClaim claim
  cases claim <;> rfl

theorem linkedEvidence_sound {claim : ClaimId} {evidence : EvidenceId}
    (_h : evidence ∈ evidenceForClaim claim) : EvidenceStatement evidence :=
  evidenceSound evidence

theorem evidenceForClaim_nodup (claim : ClaimId) :
    (evidenceForClaim claim).Nodup := by
  cases claim <;> decide

def claimsWithEvidence : List ClaimId :=
  allClaims.filter fun claim => !(evidenceForClaim claim).isEmpty

theorem claimsWithEvidence_length : claimsWithEvidence.length = 13 := by
  decide

def evidencePairs : List (ClaimId × EvidenceId) :=
  allClaims.flatMap fun claim =>
    (evidenceForClaim claim).map fun evidence => (claim, evidence)

theorem evidencePairs_length : evidencePairs.length = 19 := by
  decide

theorem allEvidence_used (evidence : EvidenceId) :
    ∃ claim : ClaimId, evidence ∈ evidenceForClaim claim := by
  cases evidence with
  | boundedPositiveEnergy => exact ⟨.lemma4_13, by simp [evidenceForClaim]⟩
  | boundedCoerciveSpectrum => exact ⟨.lemma4_17, by simp [evidenceForClaim]⟩
  | boundedPerturbationGap => exact ⟨.lemma4_30, by simp [evidenceForClaim]⟩
  | closedInvariantRestriction => exact ⟨.lemma4_16, by simp [evidenceForClaim]⟩
  | finiteDimensionalCompactness => exact ⟨.lemma4_18, by simp [evidenceForClaim]⟩
  | complexRootExponential => exact ⟨.theorem4_26, by simp [evidenceForClaim]⟩
  | complexFixedConstantNoGo => exact ⟨.theorem4_26, by simp [evidenceForClaim]⟩
  | truncationUniformTransfer => exact ⟨.hyp4_24, by simp [evidenceForClaim]⟩
  | truncationPointwiseNoGo => exact ⟨.hyp4_24, by simp [evidenceForClaim]⟩
  | fixedLowGapTransfer => exact ⟨.cor4_25, by simp [evidenceForClaim]⟩
  | calibratedTruncationGap => exact ⟨.prop4_23, by simp [evidenceForClaim]⟩

end QYM.FullCertification.TypedEvidenceAnalyticBridgeExtension

/-!
# Unbounded operators through Mathlib's `LinearPMap` API

This file records the part of the analytic boundary of Lemmas 4.13 and 4.16 that can be expressed
and proved with Mathlib's actual partially defined linear-map API.  In particular, the domain,
graph, graph closure, unbounded adjoint, closedness, closability, and self-adjointness below are
Mathlib objects; they are not Boolean fields in a paper-specific record.

The file intentionally stops before a Friedrichs representation theorem.  Current Mathlib has no
API constructing a self-adjoint `LinearPMap` from the paper's densely defined, closed,
semibounded form.  Thus no declaration below assumes an operator together with a field saying
that it is the desired Friedrichs realization, and no compact-resolvent conclusion is smuggled
into a premise.
-/

namespace QYM.UnboundedLinearPMapExtension

open Filter Set Topology
open scoped InnerProductSpace

variable {𝕜 E F : Type*} [RCLike 𝕜]
variable [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
variable [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]

/-! ## Transparent domain, symmetry, and graph-norm predicates -/

/-- A partially defined operator is densely defined precisely when its actual Mathlib domain is
dense in the ambient space. -/
def IsDenselyDefined (T : E →ₗ.[𝕜] F) : Prop :=
  Dense (T.domain : Set E)

/-- The unbounded-operator symmetry identity, expressed through Mathlib's formal-adjoint
relation.  This stores no adjoint inclusion or closedness conclusion. -/
def IsSymmetricOperator (T : E →ₗ.[𝕜] E) : Prop :=
  T.IsFormalAdjoint T

/-- The standard sum graph norm on the actual domain subtype.  It is kept as a scalar function
instead of installing a second global norm instance on `T.domain`. -/
def graphNorm (T : E →ₗ.[𝕜] F) (x : T.domain) : ℝ :=
  ‖(x : E)‖ + ‖T x‖

@[simp]
theorem graphNorm_zero (T : E →ₗ.[𝕜] F) :
    graphNorm T (0 : T.domain) = 0 := by
  simp [graphNorm]

theorem graphNorm_nonnegative (T : E →ₗ.[𝕜] F) (x : T.domain) :
    0 ≤ graphNorm T x := by
  exact add_nonneg (norm_nonneg _) (norm_nonneg _)

theorem domain_norm_le_graphNorm (T : E →ₗ.[𝕜] F) (x : T.domain) :
    ‖(x : E)‖ ≤ graphNorm T x := by
  exact le_add_of_nonneg_right (norm_nonneg _)

theorem image_norm_le_graphNorm (T : E →ₗ.[𝕜] F) (x : T.domain) :
    ‖T x‖ ≤ graphNorm T x := by
  exact le_add_of_nonneg_left (norm_nonneg _)

theorem graphNorm_eq_zero_iff (T : E →ₗ.[𝕜] F) (x : T.domain) :
    graphNorm T x = 0 ↔ x = 0 := by
  constructor
  · intro h
    have hxle : ‖(x : E)‖ ≤ 0 := by
      have hTx : 0 ≤ ‖T x‖ := norm_nonneg _
      dsimp [graphNorm] at h
      linarith
    have hxnorm : ‖(x : E)‖ = 0 :=
      le_antisymm hxle (norm_nonneg _)
    exact Subtype.ext (norm_eq_zero.mp hxnorm)
  · intro hx
    simpa [hx] using graphNorm_zero T

theorem graphNorm_add_le (T : E →ₗ.[𝕜] F) (x y : T.domain) :
    graphNorm T (x + y) ≤ graphNorm T x + graphNorm T y := by
  have hdomain := norm_add_le (x : E) (y : E)
  have himage := norm_add_le (T x) (T y)
  simp only [graphNorm, Submodule.coe_add, LinearPMap.map_add]
  linarith

theorem graphNorm_smul (T : E →ₗ.[𝕜] F) (a : 𝕜) (x : T.domain) :
    graphNorm T (a • x) = ‖a‖ * graphNorm T x := by
  simp [graphNorm, norm_smul, LinearPMap.map_smul, mul_add]

/-- The canonical map from the domain subtype to the operator graph. -/
def graphMap (T : E →ₗ.[𝕜] F) (x : T.domain) : E × F :=
  ((x : E), T x)

theorem graphMap_injective (T : E →ₗ.[𝕜] F) :
    Function.Injective (graphMap T) := by
  intro x y hxy
  apply Subtype.ext
  exact congrArg Prod.fst hxy

theorem range_graphMap_eq_graph (T : E →ₗ.[𝕜] F) :
    Set.range (graphMap T) = (T.graph : Set (E × F)) := by
  ext z
  constructor
  · rintro ⟨x, rfl⟩
    exact T.mem_graph x
  · intro hz
    rcases (LinearPMap.mem_graph_iff T).mp hz with ⟨x, hxFirst, hxSecond⟩
    refine ⟨x, ?_⟩
    exact Prod.ext hxFirst hxSecond

theorem isSymmetricOperator_iff_inner (T : E →ₗ.[𝕜] E) :
    IsSymmetricOperator T ↔
      ∀ x y : T.domain,
        inner 𝕜 (T x) (y : E) = inner 𝕜 (x : E) (T y) := by
  rfl

/-! ## Restriction and formal-adjoint monotonicity -/

/-- Restricting both sides of a formal-adjoint pair preserves the formal-adjoint identity. -/
theorem IsFormalAdjoint.mono
    {A A' : E →ₗ.[𝕜] F} {B B' : F →ₗ.[𝕜] E}
    (h : A.IsFormalAdjoint B) (hA : A' ≤ A) (hB : B' ≤ B) :
    A'.IsFormalAdjoint B' := by
  intro x y
  let xa : A.domain := ⟨(x : E), hA.1 x.property⟩
  let yb : B.domain := ⟨(y : F), hB.1 y.property⟩
  have hAx : A' x = A xa := hA.2 rfl
  have hBy : B' y = B yb := hB.2 rfl
  calc
    inner 𝕜 (A' x) (y : F) = inner 𝕜 (A xa) (y : F) :=
      congrArg (fun z : F => inner 𝕜 z (y : F)) hAx
    _ = inner 𝕜 (A xa) (yb : F) := by rfl
    _ = inner 𝕜 (xa : E) (B yb) := h xa yb
    _ = inner 𝕜 (x : E) (B yb) := by rfl
    _ = inner 𝕜 (x : E) (B' y) :=
      congrArg (fun z : E => inner 𝕜 (x : E) z) hBy.symm

theorem domRestrict_domain_eq
    (T : E →ₗ.[𝕜] F) (S : Submodule 𝕜 E) (hS : S ≤ T.domain) :
    (T.domRestrict S).domain = S := by
  rw [LinearPMap.domRestrict_domain, inf_eq_left.mpr hS]

theorem domRestrict_isDenselyDefined
    (T : E →ₗ.[𝕜] F) (S : Submodule 𝕜 E)
    (hS : S ≤ T.domain) (hDense : Dense (S : Set E)) :
    IsDenselyDefined (T.domRestrict S) := by
  rw [IsDenselyDefined, domRestrict_domain_eq T S hS]
  exact hDense

theorem domRestrict_isSymmetric
    {T : E →ₗ.[𝕜] E} (hT : IsSymmetricOperator T) (S : Submodule 𝕜 E) :
    IsSymmetricOperator (T.domRestrict S) := by
  exact IsFormalAdjoint.mono hT LinearPMap.domRestrict_le LinearPMap.domRestrict_le

/-! ## Closure as the least closed extension -/

theorem isClosed_iff_graph_isClosed (T : E →ₗ.[𝕜] F) :
    T.IsClosed ↔ _root_.IsClosed (T.graph : Set (E × F)) := by
  rfl

/-- The closure operation fixes an already closed partially defined operator. -/
theorem closure_eq_self_of_isClosed {T : E →ₗ.[𝕜] F} (hT : T.IsClosed) :
    T.closure = T := by
  apply LinearPMap.eq_of_eq_graph
  rw [← hT.isClosable.graph_closure_eq_closure_graph]
  exact hT.submodule_topologicalClosure_eq

theorem closure_isClosed {T : E →ₗ.[𝕜] F} (hT : T.IsClosable) :
    T.closure.IsClosed :=
  hT.closure_isClosed

theorem closure_isClosable {T : E →ₗ.[𝕜] F} (hT : T.IsClosable) :
    T.closure.IsClosable :=
  hT.closureIsClosable

theorem closure_idempotent_of_isClosable {T : E →ₗ.[𝕜] F} (hT : T.IsClosable) :
    T.closure.closure = T.closure :=
  closure_eq_self_of_isClosed hT.closure_isClosed

theorem le_closure (T : E →ₗ.[𝕜] F) :
    T ≤ T.closure :=
  T.le_closure

theorem domain_le_closure_domain (T : E →ₗ.[𝕜] F) :
    T.domain ≤ T.closure.domain :=
  T.le_closure.1

theorem graph_le_closure_graph (T : E →ₗ.[𝕜] F) :
    T.graph ≤ T.closure.graph :=
  LinearPMap.le_graph_of_le T.le_closure

theorem closure_apply_on_domain (T : E →ₗ.[𝕜] F) (x : T.domain) :
    T.closure (Submodule.inclusion T.le_closure.1 x) = T x :=
  (LinearPMap.apply_comp_inclusion T.le_closure x).symm

theorem closure_graph_eq_topologicalClosure
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosable) :
    T.closure.graph = T.graph.topologicalClosure :=
  hT.graph_closure_eq_closure_graph.symm

/-- The closure is below every closed extension.  Closedness of the target is used to prove that
its own closure is itself; it is not stored in an extension record. -/
theorem closure_le_of_le_isClosed
    {T S : E →ₗ.[𝕜] F} (hS : S.IsClosed) (hTS : T ≤ S) :
    T.closure ≤ S := by
  have hmono : T.closure ≤ S.closure :=
    hS.isClosable.closure_mono hTS
  rwa [closure_eq_self_of_isClosed hS] at hmono

theorem isClosable_iff_exists_actual_closed_extension (T : E →ₗ.[𝕜] F) :
    T.IsClosable ↔ ∃ S : E →ₗ.[𝕜] F, S.IsClosed ∧ T ≤ S :=
  LinearPMap.isClosable_iff_exists_closed_extension

theorem closure_domain_dense
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T) :
    IsDenselyDefined T.closure := by
  exact Dense.mono (fun _ hx => T.le_closure.1 hx) hDense

section CompleteGraph

variable [CompleteSpace E] [CompleteSpace F]

/-- Closedness gives completeness of the actual graph as a subset of the complete product
space. -/
theorem IsClosed.graph_isComplete
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosed) :
    IsComplete (T.graph : Set (E × F)) :=
  hT.isComplete

theorem IsClosable.closure_graph_isComplete
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosable) :
    IsComplete (T.closure.graph : Set (E × F)) :=
  hT.closure_isClosed.isComplete

end CompleteGraph

/-! ## Closed-graph and closability limit tests -/

/-- A closed operator contains the limit of every convergent graph-valued net. -/
theorem IsClosed.limit_mem_graph
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosed)
    {ι : Type*} {l : Filter ι} [NeBot l]
    (u : ι → T.domain) (x : E) (y : F)
    (hx : Tendsto (fun i => (u i : E)) l (𝓝 x))
    (hy : Tendsto (fun i => T (u i)) l (𝓝 y)) :
    (x, y) ∈ T.graph := by
  apply hT.mem_of_tendsto (hx.prodMk_nhds hy)
  exact Filter.Eventually.of_forall (fun i => T.mem_graph (u i))

theorem IsClosed.limit_mem_domain_and_apply
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosed)
    {ι : Type*} {l : Filter ι} [NeBot l]
    (u : ι → T.domain) (x : E) (y : F)
    (hx : Tendsto (fun i => (u i : E)) l (𝓝 x))
    (hy : Tendsto (fun i => T (u i)) l (𝓝 y)) :
    ∃ hxDomain : x ∈ T.domain, T ⟨x, hxDomain⟩ = y := by
  have hgraph : (x, y) ∈ T.graph :=
    IsClosed.limit_mem_graph hT u x y hx hy
  have hxDomain : x ∈ T.domain :=
    LinearPMap.mem_domain_of_mem_graph hgraph
  refine ⟨hxDomain, ?_⟩
  exact ((LinearPMap.image_iff hxDomain).mpr hgraph).symm

/-- The standard zero-limit test that follows from actual closability: if domain vectors tend to
zero while their images tend to `y`, then `y = 0`. -/
theorem IsClosable.limit_zero
    {T : E →ₗ.[𝕜] F} (hT : T.IsClosable)
    {ι : Type*} {l : Filter ι} [NeBot l]
    (u : ι → T.domain) (y : F)
    (hx : Tendsto (fun i => (u i : E)) l (𝓝 0))
    (hy : Tendsto (fun i => T (u i)) l (𝓝 y)) :
    y = 0 := by
  have hmem : (0, y) ∈ T.graph.topologicalClosure := by
    apply T.graph.isClosed_topologicalClosure.mem_of_tendsto (hx.prodMk_nhds hy)
    exact Filter.Eventually.of_forall
      (fun i => subset_closure (T.mem_graph (u i)))
  rw [hT.graph_closure_eq_closure_graph] at hmem
  exact T.closure.graph_fst_eq_zero_snd hmem rfl

/-! ## The genuine unbounded Hilbert adjoint -/

section Adjoint

variable [CompleteSpace E]

theorem mem_adjoint_domain_iff_continuous
    (T : E →ₗ.[𝕜] F) (y : F) :
    y ∈ T.adjoint.domain ↔
      Continuous ((innerₛₗ 𝕜 y).comp T.toFun) :=
  LinearPMap.mem_adjoint_domain_iff T y

theorem mem_adjoint_domain_of_representer
    {T : E →ₗ.[𝕜] F} (y : F) (w : E)
    (h : ∀ x : T.domain,
      inner 𝕜 w (x : E) = inner 𝕜 y (T x)) :
    y ∈ T.adjoint.domain := by
  exact LinearPMap.mem_adjoint_domain_of_exists y ⟨w, h⟩

theorem adjoint_apply_eq_representer
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T)
    (y : T.adjoint.domain) (w : E)
    (h : ∀ x : T.domain,
      inner 𝕜 w (x : E) = inner 𝕜 (y : F) (T x)) :
    T.adjoint y = w :=
  LinearPMap.adjoint_apply_eq hDense y h

theorem adjoint_isClosed
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T) :
    T.adjoint.IsClosed :=
  LinearPMap.adjoint_isClosed hDense

theorem adjoint_isClosable
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T) :
    T.adjoint.IsClosable :=
  (adjoint_isClosed hDense).isClosable

theorem adjoint_closure_eq_self
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T) :
    T.adjoint.closure = T.adjoint :=
  closure_eq_self_of_isClosed (adjoint_isClosed hDense)

theorem formalAdjoint_le_adjoint
    {T : E →ₗ.[𝕜] F} {S : F →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hTS : T.IsFormalAdjoint S) :
    S ≤ T.adjoint :=
  LinearPMap.IsFormalAdjoint.le_adjoint hDense hTS

theorem adjoint_isFormalAdjoint
    {T : E →ₗ.[𝕜] F} (hDense : IsDenselyDefined T) :
    T.adjoint.IsFormalAdjoint T :=
  LinearPMap.adjoint_isFormalAdjoint hDense

theorem symmetric_le_adjoint
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hSymm : IsSymmetricOperator T) :
    T ≤ T.adjoint :=
  formalAdjoint_le_adjoint hDense hSymm

theorem symmetric_iff_le_adjoint
    {T : E →ₗ.[𝕜] E} (hDense : IsDenselyDefined T) :
    IsSymmetricOperator T ↔ T ≤ T.adjoint := by
  constructor
  · exact symmetric_le_adjoint hDense
  · intro hle
    exact
      IsFormalAdjoint.mono
        (adjoint_isFormalAdjoint hDense) hle (le_refl T)

/-- A densely defined symmetric operator is closable because its genuine adjoint is a closed
extension. -/
theorem symmetric_isClosable
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hSymm : IsSymmetricOperator T) :
    T.IsClosable := by
  exact
    (adjoint_isClosed hDense).isClosable.leIsClosable
      (symmetric_le_adjoint hDense hSymm)

theorem symmetric_closure_le_adjoint
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hSymm : IsSymmetricOperator T) :
    T.closure ≤ T.adjoint := by
  exact
    closure_le_of_le_isClosed
      (adjoint_isClosed hDense)
      (symmetric_le_adjoint hDense hSymm)

theorem symmetric_closure_isClosed
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hSymm : IsSymmetricOperator T) :
    T.closure.IsClosed :=
  (symmetric_isClosable hDense hSymm).closure_isClosed

theorem symmetric_closure_isDenselyDefined
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) :
    IsDenselyDefined T.closure :=
  closure_domain_dense hDense

theorem symmetric_limit_zero
    {T : E →ₗ.[𝕜] E}
    (hDense : IsDenselyDefined T) (hSymm : IsSymmetricOperator T)
    {ι : Type*} {l : Filter ι} [NeBot l]
    (u : ι → T.domain) (y : E)
    (hx : Tendsto (fun i => (u i : E)) l (𝓝 0))
    (hy : Tendsto (fun i => T (u i)) l (𝓝 y)) :
    y = 0 :=
  IsClosable.limit_zero (symmetric_isClosable hDense hSymm) u y hx hy

/-! ## Self-adjoint operators -/

theorem selfAdjoint_isDenselyDefined
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    IsDenselyDefined T :=
  hT.dense_domain

theorem selfAdjoint_isClosed
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    T.IsClosed :=
  hT.isClosed

theorem selfAdjoint_isClosable
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    T.IsClosable :=
  hT.isClosed.isClosable

theorem selfAdjoint_isSymmetric
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    IsSymmetricOperator T := by
  have hformal : T.adjoint.IsFormalAdjoint T :=
    adjoint_isFormalAdjoint hT.dense_domain
  rw [LinearPMap.isSelfAdjoint_def.mp hT] at hformal
  exact hformal

theorem selfAdjoint_closure_eq_self
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    T.closure = T :=
  closure_eq_self_of_isClosed hT.isClosed

theorem selfAdjoint_limit_mem_domain_and_apply
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T)
    {ι : Type*} {l : Filter ι} [NeBot l]
    (u : ι → T.domain) (x y : E)
    (hx : Tendsto (fun i => (u i : E)) l (𝓝 x))
    (hy : Tendsto (fun i => T (u i)) l (𝓝 y)) :
    ∃ hxDomain : x ∈ T.domain, T ⟨x, hxDomain⟩ = y :=
  IsClosed.limit_mem_domain_and_apply hT.isClosed u x y hx hy

theorem selfAdjoint_boundary_bundle
    {T : E →ₗ.[𝕜] E} (hT : IsSelfAdjoint T) :
    IsDenselyDefined T ∧
      IsSymmetricOperator T ∧
        T.IsClosed ∧ T.IsClosable ∧ T.closure = T := by
  exact
    ⟨selfAdjoint_isDenselyDefined hT,
      selfAdjoint_isSymmetric hT,
      selfAdjoint_isClosed hT,
      selfAdjoint_isClosable hT,
      selfAdjoint_closure_eq_self hT⟩

end Adjoint

/-! ## A boundary countermodel: symmetry alone does not give self-adjointness -/

/-- The zero operator with only the zero vector in its domain. -/
def zeroBottomOperator : ℝ →ₗ.[ℝ] ℝ where
  domain := ⊥
  toFun := 0

theorem zeroBottomOperator_isSymmetric :
    IsSymmetricOperator zeroBottomOperator := by
  intro x y
  change inner ℝ (0 : ℝ) (y : ℝ) = inner ℝ (x : ℝ) (0 : ℝ)
  simp

theorem zeroBottomOperator_not_denselyDefined :
    ¬IsDenselyDefined zeroBottomOperator := by
  intro hDense
  change Dense ((⊥ : Submodule ℝ ℝ) : Set ℝ) at hDense
  have hclosure :
      (⊥ : Submodule ℝ ℝ).topologicalClosure = ⊤ :=
    Submodule.dense_iff_topologicalClosure_eq_top.mp hDense
  have hbotClosed :
      _root_.IsClosed (((⊥ : Submodule ℝ ℝ) : Set ℝ)) := by
    change _root_.IsClosed ({0} : Set ℝ)
    exact isClosed_singleton
  have hbotClosure :
      (⊥ : Submodule ℝ ℝ).topologicalClosure = ⊥ :=
    hbotClosed.submodule_topologicalClosure_eq
  have hfalse : (⊥ : Submodule ℝ ℝ) = ⊤ :=
    hbotClosure.symm.trans hclosure
  exact (bot_ne_top : (⊥ : Submodule ℝ ℝ) ≠ ⊤) hfalse

theorem zeroBottomOperator_not_selfAdjoint :
    ¬IsSelfAdjoint zeroBottomOperator := by
  intro hSelf
  exact zeroBottomOperator_not_denselyDefined hSelf.dense_domain

end QYM.UnboundedLinearPMapExtension

/-!
# Paper-normalized `LinearPMap` boundary for Lemmas 4.13 and 4.16

These closed propositions state the genuine unbounded-operator consequences available from
Mathlib after the paper has supplied an actual densely defined symmetric operator or an actual
self-adjoint operator.  The quantifiers range over Mathlib `LinearPMap`s, their real domains,
graphs, graph closures, and Hilbert adjoints.

They do not assert that the q--Yang--Mills form has been constructed, is closed, or has a
Friedrichs representative.  In particular, no proposition below contains an existential
"Friedrichs realization" premise whose fields simply repeat self-adjointness or compact
resolvent.  The missing form-to-operator bridge therefore remains explicit.
-/

namespace QYM.FullCertification.PaperNormalized

open Filter Set Topology

/-! ## Lemma 4.13: closure and the closed-extension universal property -/

/-- For every actually closable partial operator, its Mathlib closure is a closed extension, its
graph is the topological closure of the original graph, and it is below every closed extension. -/
def lemma4_13_linearPMapClosureBoundaryStatement : Prop :=
  ∀ (𝕜 E F : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
      [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
      (T : E →ₗ.[𝕜] F),
    T.IsClosable →
      T ≤ T.closure ∧
        T.closure.IsClosed ∧
          T.closure.graph = T.graph.topologicalClosure ∧
            ∀ S : E →ₗ.[𝕜] F, S.IsClosed → T ≤ S → T.closure ≤ S

theorem lemma4_13_linearPMapClosureBoundaryStatement_holds :
    lemma4_13_linearPMapClosureBoundaryStatement := by
  intro 𝕜 E F instRCLike instNormedE instInnerE instNormedF instInnerF T hT
  refine
    ⟨QYM.UnboundedLinearPMapExtension.le_closure T,
      QYM.UnboundedLinearPMapExtension.closure_isClosed hT,
      QYM.UnboundedLinearPMapExtension.closure_graph_eq_topologicalClosure hT,
      ?_⟩
  intro S hS hTS
  exact
    QYM.UnboundedLinearPMapExtension.closure_le_of_le_isClosed hS hTS

/-! ## Lemma 4.13: the actual Hilbert-adjoint domain -/

/-- Membership in the genuine unbounded adjoint domain is continuity of the induced functional;
an ambient representing vector is a sufficient condition. -/
def lemma4_13_adjointDomainBoundaryStatement : Prop :=
  ∀ (𝕜 E F : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
      (T : E →ₗ.[𝕜] F) (y : F),
    (y ∈ T.adjoint.domain ↔
      Continuous ((innerₛₗ 𝕜 y).comp T.toFun)) ∧
      ∀ w : E,
        (∀ x : T.domain,
          inner 𝕜 w (x : E) = inner 𝕜 y (T x)) →
          y ∈ T.adjoint.domain

theorem lemma4_13_adjointDomainBoundaryStatement_holds :
    lemma4_13_adjointDomainBoundaryStatement := by
  intro 𝕜 E F instRCLike instNormedE instInnerE instCompleteE
    instNormedF instInnerF T y
  refine
    ⟨QYM.UnboundedLinearPMapExtension.mem_adjoint_domain_iff_continuous T y, ?_⟩
  intro w h
  exact
    QYM.UnboundedLinearPMapExtension.mem_adjoint_domain_of_representer
      y w h

/-! ## Lemma 4.13: the dense symmetric operator boundary -/

/-- A genuinely densely defined symmetric `LinearPMap` is closable; it and its closure are
contained in its genuine Hilbert adjoint, and the closure is closed and still densely defined. -/
def lemma4_13_denseSymmetricAdjointBoundaryStatement : Prop :=
  ∀ (𝕜 E : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →ₗ.[𝕜] E),
    QYM.UnboundedLinearPMapExtension.IsDenselyDefined T →
      QYM.UnboundedLinearPMapExtension.IsSymmetricOperator T →
        T.IsClosable ∧
          T ≤ T.adjoint ∧
            T.closure ≤ T.adjoint ∧
              T.closure.IsClosed ∧
                QYM.UnboundedLinearPMapExtension.IsDenselyDefined T.closure ∧
                  IsComplete (T.closure.graph : Set (E × E))

theorem lemma4_13_denseSymmetricAdjointBoundaryStatement_holds :
    lemma4_13_denseSymmetricAdjointBoundaryStatement := by
  intro 𝕜 E instRCLike instNormed instInner instComplete T hDense hSymm
  exact
    ⟨QYM.UnboundedLinearPMapExtension.symmetric_isClosable hDense hSymm,
      QYM.UnboundedLinearPMapExtension.symmetric_le_adjoint hDense hSymm,
      QYM.UnboundedLinearPMapExtension.symmetric_closure_le_adjoint hDense hSymm,
      QYM.UnboundedLinearPMapExtension.symmetric_closure_isClosed hDense hSymm,
      QYM.UnboundedLinearPMapExtension.symmetric_closure_isDenselyDefined hDense,
      QYM.UnboundedLinearPMapExtension.IsClosable.closure_graph_isComplete
        (QYM.UnboundedLinearPMapExtension.symmetric_isClosable hDense hSymm)⟩

/-! ## Lemma 4.13: graph-norm algebra on the actual domain -/

/-- The sum graph norm is nonnegative, separates zero, dominates both coordinate norms, obeys the
triangle inequality, and is homogeneous.  This is a norm calculation on `T.domain`; it does not
assert completeness of that domain. -/
def lemma4_13_graphNormBoundaryStatement : Prop :=
  ∀ (𝕜 E F : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
      [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
      (T : E →ₗ.[𝕜] F) (x y : T.domain) (a : 𝕜),
    0 ≤ QYM.UnboundedLinearPMapExtension.graphNorm T x ∧
      ‖(x : E)‖ ≤ QYM.UnboundedLinearPMapExtension.graphNorm T x ∧
        ‖T x‖ ≤ QYM.UnboundedLinearPMapExtension.graphNorm T x ∧
          (QYM.UnboundedLinearPMapExtension.graphNorm T x = 0 ↔ x = 0) ∧
            QYM.UnboundedLinearPMapExtension.graphNorm T (x + y) ≤
              QYM.UnboundedLinearPMapExtension.graphNorm T x +
                QYM.UnboundedLinearPMapExtension.graphNorm T y ∧
              QYM.UnboundedLinearPMapExtension.graphNorm T (a • x) =
                ‖a‖ * QYM.UnboundedLinearPMapExtension.graphNorm T x

theorem lemma4_13_graphNormBoundaryStatement_holds :
    lemma4_13_graphNormBoundaryStatement := by
  intro 𝕜 E F instRCLike instNormedE instInnerE instNormedF instInnerF T x y a
  exact
    ⟨QYM.UnboundedLinearPMapExtension.graphNorm_nonnegative T x,
      QYM.UnboundedLinearPMapExtension.domain_norm_le_graphNorm T x,
      QYM.UnboundedLinearPMapExtension.image_norm_le_graphNorm T x,
      QYM.UnboundedLinearPMapExtension.graphNorm_eq_zero_iff T x,
      QYM.UnboundedLinearPMapExtension.graphNorm_add_le T x y,
      QYM.UnboundedLinearPMapExtension.graphNorm_smul T a x⟩

/-! ## Lemma 4.16: self-adjointness gives the full graph boundary -/

/-- An actual self-adjoint `LinearPMap` has dense domain, is symmetric, closed and closable, and
is fixed by graph closure. -/
def lemma4_16_selfAdjointLinearPMapBoundaryStatement : Prop :=
  ∀ (𝕜 E : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
      (T : E →ₗ.[𝕜] E),
    IsSelfAdjoint T →
      QYM.UnboundedLinearPMapExtension.IsDenselyDefined T ∧
        QYM.UnboundedLinearPMapExtension.IsSymmetricOperator T ∧
          T.IsClosed ∧ T.IsClosable ∧ T.closure = T

theorem lemma4_16_selfAdjointLinearPMapBoundaryStatement_holds :
    lemma4_16_selfAdjointLinearPMapBoundaryStatement := by
  intro 𝕜 E instRCLike instNormed instInner instComplete T hT
  exact QYM.UnboundedLinearPMapExtension.selfAdjoint_boundary_bundle hT

/-! ## Lemma 4.16: the closability zero-limit test -/

/-- The net form of the closability test: graph vectors whose first coordinates tend to zero
cannot have a nonzero limit in the second coordinate. -/
def lemma4_16_closableZeroLimitBoundaryStatement : Prop :=
  ∀ (𝕜 E F ι : Type)
      [RCLike 𝕜]
      [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
      [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
      (l : Filter ι) [NeBot l]
      (T : E →ₗ.[𝕜] F) (u : ι → T.domain) (y : F),
    T.IsClosable →
      Tendsto (fun i => (u i : E)) l (𝓝 0) →
        Tendsto (fun i => T (u i)) l (𝓝 y) → y = 0

theorem lemma4_16_closableZeroLimitBoundaryStatement_holds :
    lemma4_16_closableZeroLimitBoundaryStatement := by
  intro 𝕜 E F ι instRCLike instNormedE instInnerE instNormedF instInnerF
    l instNeBot T u y hClosable hx hy
  exact
    QYM.UnboundedLinearPMapExtension.IsClosable.limit_zero
      hClosable u y hx hy

/-! ## Explicit boundary obstruction -/

/-- Symmetry without the dense-domain hypothesis does not imply self-adjointness.  The witness is
the actual zero `LinearPMap` on the bottom domain in `ℝ`. -/
def lemma4_13_symmetryAloneNoGoStatement : Prop :=
  QYM.UnboundedLinearPMapExtension.IsSymmetricOperator
      QYM.UnboundedLinearPMapExtension.zeroBottomOperator ∧
    ¬QYM.UnboundedLinearPMapExtension.IsDenselyDefined
      QYM.UnboundedLinearPMapExtension.zeroBottomOperator ∧
      ¬IsSelfAdjoint QYM.UnboundedLinearPMapExtension.zeroBottomOperator

theorem lemma4_13_symmetryAloneNoGoStatement_holds :
    lemma4_13_symmetryAloneNoGoStatement := by
  exact
    ⟨QYM.UnboundedLinearPMapExtension.zeroBottomOperator_isSymmetric,
      QYM.UnboundedLinearPMapExtension.zeroBottomOperator_not_denselyDefined,
      QYM.UnboundedLinearPMapExtension.zeroBottomOperator_not_selfAdjoint⟩

end QYM.FullCertification.PaperNormalized

/-!
# A genuine bounded-form Lax--Milgram bridge

This file works with Mathlib's actual real bounded bilinear forms
`V →L[ℝ] V →L[ℝ] ℝ` and its actual predicate `IsCoercive`.  No kernel, range,
inverse, or solvability conclusion is stored in a certificate structure.  The associated
operator is `InnerProductSpace.continuousLinearMapOfBilin`, and all qualitative consequences
are obtained from the theorems in `Mathlib.Analysis.InnerProductSpace.LaxMilgram`.

The final section also keeps a displayed coercivity constant.  This gives the sharp lower
operator estimate, the standard `‖u‖ ≤ ‖f‖ / c` a-priori estimate, and stability under a
diagonal form perturbation.  These are derived from transparent inequalities.

This namespace is a bounded-form theorem.  It does not by itself construct a Friedrichs realization of an
unbounded closed form and therefore does not by itself close the unbounded assertions of
Lemmas 4.13 or 4.16 of the paper.
-/

namespace QYM.LaxMilgramFormExtension

open InnerProductSpace LinearMap Set
open scoped NNReal RealInnerProductSpace

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-! ## The operator represented by a bounded real bilinear form -/

section RieszRepresentation

variable [CompleteSpace V]

/-- The canonical bounded operator represented by a bounded real bilinear form. -/
noncomputable def associatedOperator (B : V →L[ℝ] V →L[ℝ] ℝ) : V →L[ℝ] V :=
  InnerProductSpace.continuousLinearMapOfBilin B

/-- The defining Riesz representation identity for the associated operator. -/
@[simp]
theorem inner_associatedOperator_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (u v : V) :
    ⟪associatedOperator B u, v⟫_ℝ = B u v := by
  exact InnerProductSpace.continuousLinearMapOfBilin_apply B u v

/-- A vector representing the functional `B u` is forced to be the associated-operator value.
This uniqueness statement does not need coercivity; completeness is used only to construct the
Riesz-associated operator. -/
theorem unique_representingVector
    (B : V →L[ℝ] V →L[ℝ] ℝ) {u f : V}
    (hf : ∀ v : V, ⟪f, v⟫_ℝ = B u v) :
    f = associatedOperator B u := by
  simpa only [associatedOperator] using
    (InnerProductSpace.unique_continuousLinearMapOfBilin B hf)

end RieszRepresentation

/-! ## Consequences of Mathlib's actual `IsCoercive` predicate -/

section Complete

variable [CompleteSpace V]

/-- The bounded-below conclusion supplied by Mathlib's Lax--Milgram development. -/
theorem exists_associatedOperator_boundedBelow
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    ∃ c : ℝ, 0 < c ∧ ∀ u : V, c * ‖u‖ ≤ ‖associatedOperator B u‖ := by
  simpa only [associatedOperator] using hB.bounded_below

/-- The anti-Lipschitz estimate supplied by Mathlib. -/
theorem exists_associatedOperator_antilipschitz
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    ∃ c : ℝ≥0, 0 < c ∧ AntilipschitzWith c (associatedOperator B) := by
  simpa only [associatedOperator] using hB.antilipschitz

/-- Coercivity kills the kernel of the represented bounded operator. -/
theorem associatedOperator_ker_eq_bot
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    (associatedOperator B).ker = ⊥ := by
  simpa only [associatedOperator] using hB.ker_eq_bot

/-- Coercivity gives a closed range before surjectivity is invoked. -/
theorem associatedOperator_isClosed_range
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    IsClosed ((associatedOperator B).range : Set V) := by
  simpa only [associatedOperator] using hB.isClosed_range

/-- The orthogonal-complement argument in Mathlib upgrades the closed range to the whole space. -/
theorem associatedOperator_range_eq_top
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    (associatedOperator B).range = ⊤ := by
  simpa only [associatedOperator] using hB.range_eq_top

theorem associatedOperator_injective
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    Function.Injective (associatedOperator B) :=
  LinearMap.ker_eq_bot.mp (associatedOperator_ker_eq_bot hB)

theorem associatedOperator_surjective
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    Function.Surjective (associatedOperator B) :=
  LinearMap.range_eq_top.mp (associatedOperator_range_eq_top hB)

theorem associatedOperator_bijective
    {B : V →L[ℝ] V →L[ℝ] ℝ} (hB : IsCoercive B) :
    Function.Bijective (associatedOperator B) :=
  ⟨associatedOperator_injective hB, associatedOperator_surjective hB⟩

/-- Mathlib's Lax--Milgram continuous linear equivalence, kept as a named bridge. -/
noncomputable def representationEquiv
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) : V ≃L[ℝ] V :=
  hB.continuousLinearEquivOfBilin

@[simp]
theorem representationEquiv_inner_apply
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (u v : V) :
    ⟪representationEquiv B hB u, v⟫_ℝ = B u v := by
  exact hB.continuousLinearEquivOfBilin_apply u v

/-- Mathlib's coercive-form uniqueness theorem, exposed without replacing its conclusion by an
assumption. -/
theorem unique_representationEquiv
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) {u f : V}
    (hf : ∀ v : V, ⟪f, v⟫_ℝ = B u v) :
    f = representationEquiv B hB u := by
  simpa only [representationEquiv] using
    (hB.unique_continuousLinearEquivOfBilin hf)

/-- The Lax--Milgram equivalence has exactly the same underlying action as the canonical
associated operator.  This is proved from uniqueness of the representing vector. -/
theorem representationEquiv_apply_eq_associatedOperator
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (u : V) :
    representationEquiv B hB u = associatedOperator B u := by
  exact unique_representingVector B (representationEquiv_inner_apply B hB u)

/-- The variational solution of `B u v = ⟪f,v⟫` is the inverse Lax--Milgram map. -/
noncomputable def solve
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f : V) : V :=
  (representationEquiv B hB).symm f

/-- Applying the associated operator to the variational solution recovers the datum. -/
@[simp]
theorem associatedOperator_solve
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f : V) :
    associatedOperator B (solve B hB f) = f := by
  rw [← representationEquiv_apply_eq_associatedOperator B hB]
  exact (representationEquiv B hB).apply_symm_apply f

/-- Solving with the datum produced by the associated operator recovers the vector. -/
@[simp]
theorem solve_associatedOperator
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (u : V) :
    solve B hB (associatedOperator B u) = u := by
  rw [← representationEquiv_apply_eq_associatedOperator B hB]
  exact (representationEquiv B hB).symm_apply_apply u

/-- Existence: the inverse equivalence satisfies the variational equation. -/
theorem solve_spec
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f v : V) :
    B (solve B hB f) v = ⟪f, v⟫_ℝ := by
  rw [← inner_associatedOperator_apply]
  simp only [associatedOperator_solve]

/-- Uniqueness of the variational solution, derived from Mathlib's unique-representative API. -/
theorem solve_unique
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f : V) {u : V}
    (hu : ∀ v : V, B u v = ⟪f, v⟫_ℝ) :
    u = solve B hB f := by
  apply associatedOperator_injective hB
  rw [associatedOperator_solve]
  exact (unique_representingVector B (fun v => (hu v).symm)).symm

/-- Full existence and uniqueness in the orientation used for weak form equations. -/
theorem existsUnique_variationalSolution
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f : V) :
    ∃! u : V, ∀ v : V, B u v = ⟪f, v⟫_ℝ := by
  refine ⟨solve B hB f, solve_spec B hB f, ?_⟩
  intro u hu
  exact solve_unique B hB f hu

@[simp]
theorem solve_zero (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) :
    solve B hB 0 = 0 := by
  exact (representationEquiv B hB).symm.map_zero

theorem solve_add
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (f g : V) :
    solve B hB (f + g) = solve B hB f + solve B hB g := by
  exact (representationEquiv B hB).symm.map_add f g

theorem solve_smul
    (B : V →L[ℝ] V →L[ℝ] ℝ) (hB : IsCoercive B) (a : ℝ) (f : V) :
    solve B hB (a • f) = a • solve B hB f := by
  exact (representationEquiv B hB).symm.map_smul a f

end Complete

/-! ## A displayed coercivity constant and quantitative estimates -/

/-- A transparent lower form inequality with a specified constant.  Positivity of the constant
is deliberately kept as a separate theorem hypothesis. -/
def HasCoercivityConstant (B : V →L[ℝ] V →L[ℝ] ℝ) (c : ℝ) : Prop :=
  ∀ u : V, c * ‖u‖ * ‖u‖ ≤ B u u

/-- A transparent absolute diagonal bound for a bounded perturbing form. -/
def HasDiagonalPerturbationBound
    (E : V →L[ℝ] V →L[ℝ] ℝ) (δ : ℝ) : Prop :=
  ∀ u : V, |E u u| ≤ δ * ‖u‖ * ‖u‖

theorem isCoercive_of_hasCoercivityConstant
    {B : V →L[ℝ] V →L[ℝ] ℝ} {c : ℝ}
    (hc : 0 < c) (hB : HasCoercivityConstant B c) :
    IsCoercive B :=
  ⟨c, hc, hB⟩

/- The specified coercivity constant gives the corresponding sharp operator lower bound. -/
section SpecifiedConstantLowerBound

variable [CompleteSpace V]

theorem specifiedConstant_operator_lowerBound
    {B : V →L[ℝ] V →L[ℝ] ℝ} {c : ℝ}
    (hB : HasCoercivityConstant B c) (u : V) :
    c * ‖u‖ ≤ ‖associatedOperator B u‖ := by
  by_cases hu : 0 < ‖u‖
  · refine (mul_le_mul_iff_left₀ hu).mp ?_
    calc
      c * ‖u‖ * ‖u‖ ≤ B u u := hB u
      _ = ⟪associatedOperator B u, u⟫_ℝ :=
        (inner_associatedOperator_apply B u u).symm
      _ ≤ ‖associatedOperator B u‖ * ‖u‖ :=
        real_inner_le_norm (associatedOperator B u) u
  · have hzero : u = 0 := by simpa using hu
    simp [hzero]

end SpecifiedConstantLowerBound

section QuantitativeComplete

variable [CompleteSpace V]

/-- A priori estimate for the unique solution with the displayed coercivity constant. -/
theorem norm_solve_le_div
    {B : V →L[ℝ] V →L[ℝ] ℝ} {c : ℝ}
    (hc : 0 < c) (hB : HasCoercivityConstant B c) (f : V) :
    ‖solve B (isCoercive_of_hasCoercivityConstant hc hB) f‖ ≤ ‖f‖ / c := by
  apply (le_div_iff₀ hc).2
  have hlower := specifiedConstant_operator_lowerBound hB
    (solve B (isCoercive_of_hasCoercivityConstant hc hB) f)
  rw [associatedOperator_solve] at hlower
  simpa only [mul_comm] using hlower

/-- Quantitative existence and uniqueness, with the estimate proved rather than included in an
input record. -/
theorem existsUnique_variationalSolution_with_norm_bound
    {B : V →L[ℝ] V →L[ℝ] ℝ} {c : ℝ}
    (hc : 0 < c) (hB : HasCoercivityConstant B c) (f : V) :
    ∃! u : V,
      (∀ v : V, B u v = ⟪f, v⟫_ℝ) ∧ ‖u‖ ≤ ‖f‖ / c := by
  let hcoercive : IsCoercive B := isCoercive_of_hasCoercivityConstant hc hB
  refine ⟨solve B hcoercive f, ⟨solve_spec B hcoercive f, ?_⟩, ?_⟩
  · exact norm_solve_le_div hc hB f
  · intro u hu
    exact solve_unique B hcoercive f hu.1

end QuantitativeComplete

/-! ## Stability under a diagonal form-small bounded perturbation -/

/-- A diagonal perturbation of size `δ` lowers a displayed form bound from `c` to `c - δ`. -/
theorem hasCoercivityConstant_add_of_diagonalPerturbation
    {B E : V →L[ℝ] V →L[ℝ] ℝ} {c δ : ℝ}
    (hB : HasCoercivityConstant B c)
    (hE : HasDiagonalPerturbationBound E δ) :
    HasCoercivityConstant (B + E) (c - δ) := by
  intro u
  have hbase := hB u
  have habs := hE u
  have hlowerPerturbation : -(δ * ‖u‖ * ‖u‖) ≤ E u u := by
    calc
      -(δ * ‖u‖ * ‖u‖) ≤ -|E u u| := neg_le_neg habs
      _ ≤ E u u := neg_abs_le (E u u)
  calc
    (c - δ) * ‖u‖ * ‖u‖ =
        c * ‖u‖ * ‖u‖ + (-(δ * ‖u‖ * ‖u‖)) := by ring
    _ ≤ B u u + E u u := add_le_add hbase hlowerPerturbation
    _ = (B + E) u u := by
      simp only [ContinuousLinearMap.add_apply]

/-- If `δ < c`, the perturbed bounded form is genuinely coercive with residual constant
`c - δ`. -/
theorem isCoercive_add_of_diagonalPerturbation
    {B E : V →L[ℝ] V →L[ℝ] ℝ} {c δ : ℝ}
    (hδc : δ < c)
    (hB : HasCoercivityConstant B c)
    (hE : HasDiagonalPerturbationBound E δ) :
    IsCoercive (B + E) :=
  isCoercive_of_hasCoercivityConstant (sub_pos.mpr hδc)
    (hasCoercivityConstant_add_of_diagonalPerturbation hB hE)

section PerturbationComplete

variable [CompleteSpace V]

/-- The perturbed variational equation has a unique solution by the actual Lax--Milgram API. -/
theorem existsUnique_perturbedVariationalSolution
    {B E : V →L[ℝ] V →L[ℝ] ℝ} {c δ : ℝ}
    (hδc : δ < c)
    (hB : HasCoercivityConstant B c)
    (hE : HasDiagonalPerturbationBound E δ) (f : V) :
    ∃! u : V, ∀ v : V, (B + E) u v = ⟪f, v⟫_ℝ := by
  exact existsUnique_variationalSolution (B + E)
    (isCoercive_add_of_diagonalPerturbation hδc hB hE) f

/-- The perturbed solution obeys the residual-coercivity estimate. -/
theorem norm_perturbedSolve_le_div
    {B E : V →L[ℝ] V →L[ℝ] ℝ} {c δ : ℝ}
    (hδc : δ < c)
    (hB : HasCoercivityConstant B c)
    (hE : HasDiagonalPerturbationBound E δ) (f : V) :
    ‖solve (B + E) (isCoercive_add_of_diagonalPerturbation hδc hB hE) f‖ ≤
      ‖f‖ / (c - δ) := by
  exact norm_solve_le_div (sub_pos.mpr hδc)
    (hasCoercivityConstant_add_of_diagonalPerturbation hB hE) f

end PerturbationComplete

end QYM.LaxMilgramFormExtension

/-!
# Paper-normalized bounded Lax--Milgram statements

The propositions below isolate the bounded coercive-form content that is genuinely available for
the variational steps surrounding Lemmas 4.13 and 4.16.  Their proofs use Mathlib's real
`IsCoercive`/Lax--Milgram implementation through
`QYM.LaxMilgramFormExtension`; no conclusion is copied into an input structure.

These statements are deliberately labelled `boundedRealForm`.  The forms in the PDF have
Sobolev/gauge domains and are intended to produce unbounded Friedrichs operators.  The present
wrappers do not assert that those concrete domains are dense or closed, do not construct a
Friedrichs extension, and do not prove compact resolvent.  They are rigorous bounded-form bridges
that can be reused once a paper-specific bounded or graph-norm realization has been supplied.
-/

namespace QYM.FullCertification.PaperNormalized

open QYM.LaxMilgramFormExtension
open scoped RealInnerProductSpace

/-! ## Lemma 4.13: the bounded form-to-operator bridge -/

/-- A bounded coercive real bilinear form is represented by a bounded operator with trivial
kernel, closed and full range, and hence a bijective underlying function. -/
def lemma4_13_boundedRealFormOperatorBridgeStatement : Prop :=
  ∀ (V : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      (B : V →L[ℝ] V →L[ℝ] ℝ),
    IsCoercive B →
      ∃ A : V →L[ℝ] V,
        (∀ u v : V, ⟪A u, v⟫_ℝ = B u v) ∧
          A.ker = ⊥ ∧
            IsClosed (A.range : Set V) ∧
              A.range = ⊤ ∧
                Function.Bijective A

theorem lemma4_13_boundedRealFormOperatorBridgeStatement_holds :
    lemma4_13_boundedRealFormOperatorBridgeStatement := by
  intro V instNormed instInner instComplete B hB
  refine ⟨associatedOperator B, ?_, ?_, ?_, ?_, ?_⟩
  · exact inner_associatedOperator_apply B
  · exact associatedOperator_ker_eq_bot hB
  · exact associatedOperator_isClosed_range hB
  · exact associatedOperator_range_eq_top hB
  · exact associatedOperator_bijective hB

/-- The same bridge in the stronger bundled form provided by Lax--Milgram: a continuous linear
equivalence whose action is proved to equal the canonical Riesz-associated operator. -/
def lemma4_13_boundedRealFormEquivalenceStatement : Prop :=
  ∀ (V : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      (B : V →L[ℝ] V →L[ℝ] ℝ),
    IsCoercive B →
      ∃ e : V ≃L[ℝ] V,
        (∀ u v : V, ⟪e u, v⟫_ℝ = B u v) ∧
          ∀ u : V, e u = associatedOperator B u

theorem lemma4_13_boundedRealFormEquivalenceStatement_holds :
    lemma4_13_boundedRealFormEquivalenceStatement := by
  intro V instNormed instInner instComplete B hB
  refine ⟨representationEquiv B hB, ?_, ?_⟩
  · exact representationEquiv_inner_apply B hB
  · exact representationEquiv_apply_eq_associatedOperator B hB

/-! ## Lemma 4.16: unique weak solutions in the bounded setting -/

/-- Every vector datum has exactly one weak solution for a bounded coercive form. -/
def lemma4_16_boundedRealFormUniqueSolutionStatement : Prop :=
  ∀ (V : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      (B : V →L[ℝ] V →L[ℝ] ℝ),
    IsCoercive B →
      ∀ f : V, ∃! u : V, ∀ v : V, B u v = ⟪f, v⟫_ℝ

theorem lemma4_16_boundedRealFormUniqueSolutionStatement_holds :
    lemma4_16_boundedRealFormUniqueSolutionStatement := by
  intro V instNormed instInner instComplete B hB f
  exact existsUnique_variationalSolution B hB f

/-- With a displayed coercivity constant, the unique solution satisfies the usual sharp
Lax--Milgram a-priori estimate. -/
def lemma4_16_boundedRealFormQuantitativeSolutionStatement : Prop :=
  ∀ (V : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      (B : V →L[ℝ] V →L[ℝ] ℝ) (c : ℝ),
    0 < c →
      HasCoercivityConstant B c →
        ∀ f : V,
          ∃! u : V,
            (∀ v : V, B u v = ⟪f, v⟫_ℝ) ∧
              ‖u‖ ≤ ‖f‖ / c

theorem lemma4_16_boundedRealFormQuantitativeSolutionStatement_holds :
    lemma4_16_boundedRealFormQuantitativeSolutionStatement := by
  intro V instNormed instInner instComplete B c hc hB f
  exact existsUnique_variationalSolution_with_norm_bound hc hB f

/-! ## Form-small perturbations -/

/-- A diagonally form-small bounded perturbation preserves coercivity with constant `c - δ` and
gives a unique perturbed weak solution with the residual a-priori estimate. -/
def lemma4_16_boundedRealFormPerturbationStatement : Prop :=
  ∀ (V : Type*)
      [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
      (B E : V →L[ℝ] V →L[ℝ] ℝ) (c δ : ℝ),
    0 < c →
      δ < c →
        HasCoercivityConstant B c →
          HasDiagonalPerturbationBound E δ →
            HasCoercivityConstant (B + E) (c - δ) ∧
              IsCoercive (B + E) ∧
                ∀ f : V,
                  ∃! u : V,
                    (∀ v : V, (B + E) u v = ⟪f, v⟫_ℝ) ∧
                      ‖u‖ ≤ ‖f‖ / (c - δ)

theorem lemma4_16_boundedRealFormPerturbationStatement_holds :
    lemma4_16_boundedRealFormPerturbationStatement := by
  intro V instNormed instInner instComplete B E c δ _hc hδc hB hE
  have hResidual : HasCoercivityConstant (B + E) (c - δ) :=
    hasCoercivityConstant_add_of_diagonalPerturbation hB hE
  refine ⟨hResidual, isCoercive_add_of_diagonalPerturbation hδc hB hE, ?_⟩
  intro f
  exact existsUnique_variationalSolution_with_norm_bound
    (sub_pos.mpr hδc) hResidual f

end QYM.FullCertification.PaperNormalized

/-!
# Compact-resolvent logic without an unbounded-operator fiction

This module records the algebraic resolvent identities that Mathlib can prove for an element of
an algebra, their genuine compact-operator consequences for bounded endomorphisms, and the
compact-embedding supplier needed to make coercive energy sublevels precompact.

The bounded theory has an important sharp boundary: on an infinite-dimensional normed space no
bounded endomorphism can have a compact resolvent at even one resolvent point.  Indeed, composing
that compact inverse with the bounded shifted operator would make the identity compact.  Thus the
paper's compact-resolvent claim must ultimately be about a genuinely unbounded realization; it
cannot be certified by silently replacing that realization with a bounded operator.
-/

namespace QYM.CompactResolventLogicExtension

open Bornology Set

/-! ## Algebraic two-sided inverse and resolvent identity -/

section AlgebraicResolvent

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- At a resolvent point the Mathlib resolvent is a left inverse of the shifted element. -/
theorem resolvent_mul_shift_eq_one
    {a : A} {r : R} (hr : r ∈ resolventSet R a) :
    resolvent a r * (algebraMap R A r - a) = 1 := by
  calc
    resolvent a r * (algebraMap R A r - a) =
        (↑(hr.unit⁻¹) : A) * (algebraMap R A r - a) :=
      congrArg (fun x : A => x * (algebraMap R A r - a))
        (spectrum.resolvent_eq hr)
    _ = (↑(hr.unit⁻¹) : A) * (↑hr.unit : A) :=
      congrArg (fun x : A => (↑(hr.unit⁻¹) : A) * x) hr.unit_spec.symm
    _ = 1 := hr.unit.inv_mul

/-- At a resolvent point the Mathlib resolvent is also a right inverse of the shifted element. -/
theorem shift_mul_resolvent_eq_one
    {a : A} {r : R} (hr : r ∈ resolventSet R a) :
    (algebraMap R A r - a) * resolvent a r = 1 := by
  calc
    (algebraMap R A r - a) * resolvent a r =
        (algebraMap R A r - a) * (↑(hr.unit⁻¹) : A) :=
      congrArg (fun x : A => (algebraMap R A r - a) * x)
        (spectrum.resolvent_eq hr)
    _ = (↑hr.unit : A) * (↑(hr.unit⁻¹) : A) :=
      congrArg (fun x : A => x * (↑(hr.unit⁻¹) : A)) hr.unit_spec.symm
    _ = 1 := hr.unit.mul_inv

/-- The first resolvent identity in a possibly noncommutative algebra.

The scalar difference is deliberately retained between the two resolvents, so the proof needs no
unadvertised commutativity assumption on `A`. -/
theorem first_resolvent_identity
    {a : A} {r s : R}
    (hr : r ∈ resolventSet R a) (hs : s ∈ resolventSet R a) :
    resolvent a r - resolvent a s =
      resolvent a r * algebraMap R A (s - r) * resolvent a s := by
  calc
    resolvent a r - resolvent a s =
        resolvent a r * 1 - 1 * resolvent a s := by simp
    _ = resolvent a r *
          ((algebraMap R A s - a) * resolvent a s) -
        (resolvent a r * (algebraMap R A r - a)) * resolvent a s := by
      rw [shift_mul_resolvent_eq_one hs, resolvent_mul_shift_eq_one hr]
    _ = resolvent a r * algebraMap R A (s - r) * resolvent a s := by
      rw [map_sub]
      noncomm_ring

end AlgebraicResolvent

section ZeroResolvent

variable {𝕜 A : Type*} [Field 𝕜] [Ring A] [Algebra 𝕜 A]

/-- The resolvent of the zero algebra element at a nonzero scalar is the inverse scalar. -/
theorem resolvent_zero_eq_algebraMap_inv
    {r : 𝕜} (hr : r ≠ 0) :
    resolvent (0 : A) r = algebraMap 𝕜 A r⁻¹ := by
  have hmem : r ∈ resolventSet 𝕜 (0 : A) := by
    rw [spectrum.mem_resolventSet_iff]
    simpa using (hr.isUnit.map (algebraMap 𝕜 A))
  have hright := resolvent_mul_shift_eq_one hmem
  have hright' :
      resolvent (0 : A) r * algebraMap 𝕜 A r = 1 := by
    simpa using hright
  calc
    resolvent (0 : A) r = resolvent (0 : A) r * 1 := by rw [mul_one]
    _ = resolvent (0 : A) r *
        (algebraMap 𝕜 A r * algebraMap 𝕜 A r⁻¹) := by
      rw [← map_mul, mul_inv_cancel₀ hr, map_one]
    _ = (resolvent (0 : A) r * algebraMap 𝕜 A r) *
        algebraMap 𝕜 A r⁻¹ := by rw [mul_assoc]
    _ = algebraMap 𝕜 A r⁻¹ := by rw [hright', one_mul]

@[simp]
theorem resolvent_zero_one :
    resolvent (0 : A) (1 : 𝕜) = 1 := by
  simpa using
    (resolvent_zero_eq_algebraMap_inv (A := A) (𝕜 := 𝕜) one_ne_zero)

end ZeroResolvent

/-! ## Compactness transfer for bounded endomorphism resolvents -/

section BoundedResolventCompactness

variable {𝕜 H : Type*}
  [NontriviallyNormedField 𝕜]
  [NormedAddCommGroup H] [NormedSpace 𝕜 H]

/-- Compactness of the resolvent of a bounded endomorphism is independent of the chosen
resolvent point.  This is a direct compact-ideal consequence of the first resolvent identity. -/
theorem compact_resolvent_at_of_compact_resolvent_at
    (T : H →L[𝕜] H) {r s : 𝕜}
    (hr : r ∈ resolventSet 𝕜 T) (hs : s ∈ resolventSet 𝕜 T)
    (hcompact :
      IsCompactOperator ((resolvent T r : H →L[𝕜] H) : H → H)) :
    IsCompactOperator ((resolvent T s : H →L[𝕜] H) : H → H) := by
  let scalarDifference : H →L[𝕜] H :=
    algebraMap 𝕜 (H →L[𝕜] H) (s - r)
  have hleft :
      IsCompactOperator
        ((resolvent T r * scalarDifference : H →L[𝕜] H) : H → H) := by
    change IsCompactOperator
      (⇑(resolvent T r) ∘ ⇑scalarDifference)
    exact hcompact.comp_clm scalarDifference
  have hproduct :
      IsCompactOperator
        (((resolvent T r * scalarDifference) * resolvent T s : H →L[𝕜] H) :
          H → H) := by
    change IsCompactOperator
      (⇑(resolvent T r * scalarDifference) ∘ ⇑(resolvent T s))
    exact hleft.comp_clm (resolvent T s)
  have hidentity :
      resolvent T r - resolvent T s =
        (resolvent T r * scalarDifference) * resolvent T s := by
    simpa only [scalarDifference] using first_resolvent_identity hr hs
  have hsFormula :
      resolvent T s =
        resolvent T r -
          (resolvent T r * scalarDifference) * resolvent T s := by
    calc
      resolvent T s =
          resolvent T r - (resolvent T r - resolvent T s) := by
        noncomm_ring
      _ = resolvent T r -
          (resolvent T r * scalarDifference) * resolvent T s := by
        rw [hidentity]
  rw [hsFormula]
  simpa only [ContinuousLinearMap.coe_sub'] using hcompact.sub hproduct

/-- Specialization of the algebraic zero-resolvent formula to bounded endomorphisms. -/
@[simp]
theorem zeroOperator_resolvent_one :
    resolvent (0 : H →L[𝕜] H) (1 : 𝕜) = 1 :=
  resolvent_zero_one

end BoundedResolventCompactness

section BoundedResolventNoGo

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]

/-- A compact resolvent of a bounded endomorphism forces the underlying space to be finite
dimensional.  This is the exact obstruction to using bounded surrogates for the paper's
infinite-dimensional compact-resolvent Hamiltonian. -/
theorem finiteDimensional_of_bounded_compact_resolvent
    (T : H →L[ℝ] H) {r : ℝ}
    (hr : r ∈ resolventSet ℝ T)
    (hcompact : IsCompactOperator ((resolvent T r : H →L[ℝ] H) : H → H)) :
    FiniteDimensional ℝ H := by
  have hcomposition :
      IsCompactOperator
        (((algebraMap ℝ (H →L[ℝ] H) r - T) * resolvent T r : H →L[ℝ] H) :
          H → H) := by
    change IsCompactOperator
      (⇑(algebraMap ℝ (H →L[ℝ] H) r - T) ∘ ⇑(resolvent T r))
    exact hcompact.clm_comp (algebraMap ℝ (H →L[ℝ] H) r - T)
  have hinverse :
      (algebraMap ℝ (H →L[ℝ] H) r - T) * resolvent T r = 1 :=
    shift_mul_resolvent_eq_one hr
  have hone : IsCompactOperator ((1 : H →L[ℝ] H) : H → H) := by
    simpa only [hinverse] using hcomposition
  have hone_eq_id : ((1 : H →L[ℝ] H) : H → H) = id := by
    funext x
    exact ContinuousLinearMap.one_apply x
  rw [hone_eq_id] at hone
  exact FiniteDimensional.of_isCompactOperator_id hone

/-- No bounded endomorphism on an infinite-dimensional normed space has a compact resolvent at a
resolvent point. -/
theorem not_compact_resolvent_of_not_finiteDimensional
    (hinfinite : ¬ FiniteDimensional ℝ H)
    (T : H →L[ℝ] H) {r : ℝ}
    (hr : r ∈ resolventSet ℝ T) :
    ¬ IsCompactOperator ((resolvent T r : H →L[ℝ] H) : H → H) := by
  intro hcompact
  exact hinfinite (finiteDimensional_of_bounded_compact_resolvent T hr hcompact)

/-- Concrete zero-operator countermodel: the bounded operator itself is compact, `1` is a
resolvent point, but its resolvent is not compact on an infinite-dimensional space. -/
theorem zeroOperator_compact_but_resolvent_not_compact
    (hinfinite : ¬ FiniteDimensional ℝ H) :
    IsCompactOperator ((0 : H →L[ℝ] H) : H → H) ∧
      (1 : ℝ) ∈ resolventSet ℝ (0 : H →L[ℝ] H) ∧
      ¬ IsCompactOperator
        ((resolvent (0 : H →L[ℝ] H) (1 : ℝ) : H →L[ℝ] H) : H → H) := by
  have hresolvent :
      (1 : ℝ) ∈ resolventSet ℝ (0 : H →L[ℝ] H) := by
    rw [spectrum.mem_resolventSet_iff]
    simpa using (isUnit_one : IsUnit (1 : H →L[ℝ] H))
  exact
    ⟨isCompactOperator_zero, hresolvent,
      not_compact_resolvent_of_not_finiteDimensional
        hinfinite (0 : H →L[ℝ] H) hresolvent⟩

end BoundedResolventNoGo

/-! ## Coercive sublevels and a genuine compact-embedding supplier -/

section CoerciveSublevel

variable {H K : Type*}
  [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup K] [NormedSpace ℝ K]

/-- Energy sublevel at height `c`. -/
def energySublevel (energy : H → ℝ) (c : ℝ) : Set H :=
  {x | energy x ≤ c}

@[simp]
theorem mem_energySublevel_iff
    (energy : H → ℝ) (c : ℝ) (x : H) :
    x ∈ energySublevel energy c ↔ energy x ≤ c :=
  Iff.rfl

/-- Transparent quadratic coercivity supplier. -/
def HasQuadraticCoerciveLowerBound
    (energy : H → ℝ) (a : ℝ) : Prop :=
  ∀ x : H, a * ‖x‖ ^ 2 ≤ energy x

/-- A quadratic coercivity estimate and an explicit budget put an energy sublevel in a norm
ball. -/
theorem energySublevel_subset_closedBall
    {energy : H → ℝ} {a c R : ℝ}
    (ha : 0 < a) (hR : 0 ≤ R)
    (hcoercive : HasQuadraticCoerciveLowerBound energy a)
    (hbudget : c ≤ a * R ^ 2) :
    energySublevel energy c ⊆ Metric.closedBall 0 R := by
  intro x hx
  change energy x ≤ c at hx
  have hmul : a * ‖x‖ ^ 2 ≤ a * R ^ 2 :=
    (hcoercive x).trans (hx.trans hbudget)
  have hsquares : ‖x‖ ^ 2 ≤ R ^ 2 := by
    by_contra hnot
    have hsquares_lt : R ^ 2 < ‖x‖ ^ 2 := lt_of_not_ge hnot
    have hmul_lt := mul_lt_mul_of_pos_left hsquares_lt ha
    exact (not_lt_of_ge hmul) hmul_lt
  have hnorm : ‖x‖ ≤ R := by
    nlinarith [norm_nonneg x]
  simpa [Metric.mem_closedBall, dist_zero_right] using hnorm

/-- A genuinely compact embedding maps a quadratically coercive energy sublevel to a set with
compact closure.  Compactness is concluded from the explicit embedding premise, not inferred from
coercivity alone. -/
theorem compact_closure_image_energySublevel
    (T : H →L[ℝ] K) {energy : H → ℝ} {a c R : ℝ}
    (hcompact : IsCompactOperator (T : H → K))
    (ha : 0 < a) (hR : 0 ≤ R)
    (hcoercive : HasQuadraticCoerciveLowerBound energy a)
    (hbudget : c ≤ a * R ^ 2) :
    IsCompact (closure (T '' energySublevel energy c)) := by
  exact
    hcompact.isCompact_closure_image_of_bounded
      (Metric.isBounded_closedBall.subset
        (energySublevel_subset_closedBall ha hR hcoercive hbudget))

/-- Total-boundedness formulation of the same precompactness conclusion. -/
theorem totallyBounded_image_energySublevel
    (T : H →L[ℝ] K) {energy : H → ℝ} {a c R : ℝ}
    (hcompact : IsCompactOperator (T : H → K))
    (ha : 0 < a) (hR : 0 ≤ R)
    (hcoercive : HasQuadraticCoerciveLowerBound energy a)
    (hbudget : c ≤ a * R ^ 2) :
    TotallyBounded (T '' energySublevel energy c) := by
  exact
    (compact_closure_image_energySublevel
      T hcompact ha hR hcoercive hbudget).totallyBounded.subset subset_closure

/-- The norm-square energy used in the coercivity-only counterexample. -/
def normSquareEnergy (x : H) : ℝ :=
  ‖x‖ ^ 2

/-- Its unit sublevel is exactly the closed unit ball. -/
theorem normSquareEnergy_unitSublevel_eq_closedBall :
    energySublevel (normSquareEnergy : H → ℝ) 1 =
      Metric.closedBall (0 : H) 1 := by
  ext x
  simp only [energySublevel, normSquareEnergy, Set.mem_setOf_eq,
    Metric.mem_closedBall, dist_zero_right]
  constructor
  · intro hx
    nlinarith [norm_nonneg x]
  · intro hx
    nlinarith [norm_nonneg x]

/-- Coercivity by itself does not make sublevels compact in infinite dimension.  The preceding
compact-embedding hypothesis is therefore substantive rather than bookkeeping. -/
theorem normSquareEnergy_unitSublevel_not_compact
    (hinfinite : ¬ FiniteDimensional ℝ H) :
    ¬ IsCompact (energySublevel (normSquareEnergy : H → ℝ) 1) := by
  rw [normSquareEnergy_unitSublevel_eq_closedBall]
  intro hcompact
  exact
    hinfinite
      (FiniteDimensional.of_isCompact_closedBall ℝ zero_lt_one hcompact)

end CoerciveSublevel

end QYM.CompactResolventLogicExtension

/-!
# Paper-normalized compact-resolvent supplier and no-go layer

The positive propositions below expose only conclusions supported by Mathlib's actual bounded
algebra and compact-operator APIs.  In particular, the Lemma 4.18 sublevel conclusion starts with
a genuinely compact embedding, while the resolvent statements concern bounded endomorphisms.

The bounded no-go statements are essential fidelity data for Proposition 4.23 and Hypothesis
4.24: on an infinite-dimensional space a bounded endomorphism cannot have a compact resolvent.
Consequently these declarations do not pretend to construct the paper's missing unbounded
Friedrichs realization, its compact resolvent, a spectral enumeration, or an exhaustion theorem.
-/

namespace QYM.FullCertification.PaperNormalized

/-! ## Lemma 4.18: algebraic identity and compactness-point transfer -/

/-- Closed real-algebra spelling of the first resolvent identity. -/
def lemma4_18_firstResolventIdentityStatement : Prop :=
  ∀ (A : Type) [Ring A] [Algebra ℝ A]
      (a : A) (r s : ℝ),
    r ∈ resolventSet ℝ a →
    s ∈ resolventSet ℝ a →
      resolvent a r - resolvent a s =
        resolvent a r * algebraMap ℝ A (s - r) * resolvent a s

theorem lemma4_18_firstResolventIdentityStatement_holds :
    lemma4_18_firstResolventIdentityStatement := by
  intro A instRing instAlgebra a r s hr hs
  exact
    QYM.CompactResolventLogicExtension.first_resolvent_identity hr hs

/-- For a bounded endomorphism, compactness at one supplied resolvent point transfers to every
other supplied resolvent point. -/
def lemma4_18_boundedResolventCompactnessTransferStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [NormedSpace ℝ H]
      (T : H →L[ℝ] H) (r s : ℝ),
    r ∈ resolventSet ℝ T →
    s ∈ resolventSet ℝ T →
    IsCompactOperator ((resolvent T r : H →L[ℝ] H) : H → H) →
      IsCompactOperator ((resolvent T s : H →L[ℝ] H) : H → H)

theorem lemma4_18_boundedResolventCompactnessTransferStatement_holds :
    lemma4_18_boundedResolventCompactnessTransferStatement := by
  intro H instNormed instSpace T r s hr hs hcompact
  exact
    QYM.CompactResolventLogicExtension.compact_resolvent_at_of_compact_resolvent_at
      T hr hs hcompact

/-! ## Lemma 4.18: coercive sublevel plus an actual compact embedding -/

/-- Quadratic coercivity first bounds the sublevel in the form-domain norm; an explicitly compact
embedding then makes its image precompact. -/
def lemma4_18_coerciveSublevelCompactEmbeddingStatement : Prop :=
  ∀ (H K : Type)
      [NormedAddCommGroup H] [NormedSpace ℝ H]
      [NormedAddCommGroup K] [NormedSpace ℝ K]
      (T : H →L[ℝ] K) (energy : H → ℝ) (a c R : ℝ),
    IsCompactOperator (T : H → K) →
    0 < a →
    0 ≤ R →
    QYM.CompactResolventLogicExtension.HasQuadraticCoerciveLowerBound energy a →
    c ≤ a * R ^ 2 →
      IsCompact
          (closure
            (T '' QYM.CompactResolventLogicExtension.energySublevel energy c)) ∧
        TotallyBounded
          (T '' QYM.CompactResolventLogicExtension.energySublevel energy c)

theorem lemma4_18_coerciveSublevelCompactEmbeddingStatement_holds :
    lemma4_18_coerciveSublevelCompactEmbeddingStatement := by
  intro H K instNormedH instSpaceH instNormedK instSpaceK
    T energy a c R hcompact ha hR hcoercive hbudget
  exact
    ⟨QYM.CompactResolventLogicExtension.compact_closure_image_energySublevel
        T hcompact ha hR hcoercive hbudget,
      QYM.CompactResolventLogicExtension.totallyBounded_image_energySublevel
        T hcompact ha hR hcoercive hbudget⟩

/-- Coercivity alone is not a replacement for the compact-embedding premise: in every
infinite-dimensional real normed space the norm-square unit sublevel is noncompact. -/
def lemma4_18_coercivityAloneNoGoStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [NormedSpace ℝ H],
    (¬ FiniteDimensional ℝ H) →
      ¬ IsCompact
        (QYM.CompactResolventLogicExtension.energySublevel
          (QYM.CompactResolventLogicExtension.normSquareEnergy : H → ℝ) 1)

theorem lemma4_18_coercivityAloneNoGoStatement_holds :
    lemma4_18_coercivityAloneNoGoStatement := by
  intro H instNormed instSpace hinfinite
  exact
    QYM.CompactResolventLogicExtension.normSquareEnergy_unitSublevel_not_compact
      hinfinite

/-! ## Proposition 4.23 boundary: bounded compact resolvent forces finite dimension -/

/-- A compact resolvent for a bounded endomorphism is possible only in finite dimension.  Thus a
bounded replacement cannot certify the paper's infinite-dimensional compact-resolvent input. -/
def prop4_23_boundedCompactResolventFiniteDimensionalBoundaryStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [NormedSpace ℝ H]
      (T : H →L[ℝ] H) (r : ℝ),
    r ∈ resolventSet ℝ T →
    IsCompactOperator ((resolvent T r : H →L[ℝ] H) : H → H) →
      FiniteDimensional ℝ H

theorem prop4_23_boundedCompactResolventFiniteDimensionalBoundaryStatement_holds :
    prop4_23_boundedCompactResolventFiniteDimensionalBoundaryStatement := by
  intro H instNormed instSpace T r hr hcompact
  exact
    QYM.CompactResolventLogicExtension.finiteDimensional_of_bounded_compact_resolvent
      T hr hcompact

/-- Equivalent negative form on an explicitly infinite-dimensional supplier. -/
def prop4_23_infiniteDimensionalBoundedCompactResolventNoGoStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [NormedSpace ℝ H]
      (T : H →L[ℝ] H) (r : ℝ),
    (¬ FiniteDimensional ℝ H) →
    r ∈ resolventSet ℝ T →
      ¬ IsCompactOperator ((resolvent T r : H →L[ℝ] H) : H → H)

theorem prop4_23_infiniteDimensionalBoundedCompactResolventNoGoStatement_holds :
    prop4_23_infiniteDimensionalBoundedCompactResolventNoGoStatement := by
  intro H instNormed instSpace T r hinfinite hr
  exact
    QYM.CompactResolventLogicExtension.not_compact_resolvent_of_not_finiteDimensional
      hinfinite T hr

/-! ## Hypothesis 4.24 boundary: a compact bounded operator need not have compact resolvent -/

/-- The zero bounded operator is compact, and `1` is a resolvent point, but its resolvent is the
noncompact identity on every infinite-dimensional space.  Operator compactness therefore cannot
stand in for the missing compact-resolvent/exhaustion supplier. -/
def hyp4_24_zeroBoundedSurrogateCountermodelStatement : Prop :=
  ∀ (H : Type) [NormedAddCommGroup H] [NormedSpace ℝ H],
    (¬ FiniteDimensional ℝ H) →
      IsCompactOperator ((0 : H →L[ℝ] H) : H → H) ∧
        (1 : ℝ) ∈ resolventSet ℝ (0 : H →L[ℝ] H) ∧
        ¬ IsCompactOperator
          ((resolvent (0 : H →L[ℝ] H) (1 : ℝ) : H →L[ℝ] H) : H → H)

theorem hyp4_24_zeroBoundedSurrogateCountermodelStatement_holds :
    hyp4_24_zeroBoundedSurrogateCountermodelStatement := by
  intro H instNormed instSpace hinfinite
  exact
    QYM.CompactResolventLogicExtension.zeroOperator_compact_but_resolvent_not_compact
      hinfinite

end QYM.FullCertification.PaperNormalized

/-!
# Typed evidence for unbounded operators, coercive forms, and resolvent logic

This sixth independent registry records the exact propositions proved by the genuine
`LinearPMap`, bounded Lax--Milgram, and bounded compact-resolvent tranches.  Its links are
deliberately non-terminal: none of them manufactures the paper-specific Sobolev form, a
Friedrichs realization, or an exhaustion theorem.  The negative bounded-resolvent evidence is
kept as proof-carrying data because it prevents an invalid bounded surrogate for the intended
unbounded operator.
-/

namespace QYM.FullCertification.TypedEvidenceUnboundedFormResolventExtension

open QYM.FullCertification.Registry

inductive EvidenceId where
  | linearPMapClosureBoundary
  | linearPMapAdjointBoundary
  | denseSymmetricBoundary
  | graphNormBoundary
  | selfAdjointBoundary
  | closabilityAndSymmetryNoGo
  | laxMilgramOperatorBridge
  | laxMilgramUniqueSolution
  | laxMilgramPerturbation
  | algebraicResolventIdentity
  | boundedCompactResolventNoGo
  | compactEmbeddingSublevel
  deriving DecidableEq, Repr

/-- The exact proposition carried by each new evidence identifier. -/
def EvidenceStatement : EvidenceId → Prop
  | .linearPMapClosureBoundary =>
      QYM.FullCertification.PaperNormalized.lemma4_13_linearPMapClosureBoundaryStatement
  | .linearPMapAdjointBoundary =>
      QYM.FullCertification.PaperNormalized.lemma4_13_adjointDomainBoundaryStatement
  | .denseSymmetricBoundary =>
      QYM.FullCertification.PaperNormalized.lemma4_13_denseSymmetricAdjointBoundaryStatement
  | .graphNormBoundary =>
      QYM.FullCertification.PaperNormalized.lemma4_13_graphNormBoundaryStatement
  | .selfAdjointBoundary =>
      QYM.FullCertification.PaperNormalized.lemma4_16_selfAdjointLinearPMapBoundaryStatement
  | .closabilityAndSymmetryNoGo =>
      QYM.FullCertification.PaperNormalized.lemma4_16_closableZeroLimitBoundaryStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_13_symmetryAloneNoGoStatement
  | .laxMilgramOperatorBridge =>
      QYM.FullCertification.PaperNormalized.lemma4_13_boundedRealFormOperatorBridgeStatement.{0} ∧
        QYM.FullCertification.PaperNormalized.lemma4_13_boundedRealFormEquivalenceStatement.{0}
  | .laxMilgramUniqueSolution =>
      QYM.FullCertification.PaperNormalized.lemma4_16_boundedRealFormUniqueSolutionStatement.{0} ∧
        QYM.FullCertification.PaperNormalized.lemma4_16_boundedRealFormQuantitativeSolutionStatement.{0}
  | .laxMilgramPerturbation =>
      QYM.FullCertification.PaperNormalized.lemma4_16_boundedRealFormPerturbationStatement.{0}
  | .algebraicResolventIdentity =>
      QYM.FullCertification.PaperNormalized.lemma4_18_firstResolventIdentityStatement
  | .boundedCompactResolventNoGo =>
      QYM.FullCertification.PaperNormalized.lemma4_18_boundedResolventCompactnessTransferStatement ∧
        QYM.FullCertification.PaperNormalized.prop4_23_boundedCompactResolventFiniteDimensionalBoundaryStatement ∧
          QYM.FullCertification.PaperNormalized.prop4_23_infiniteDimensionalBoundedCompactResolventNoGoStatement ∧
            QYM.FullCertification.PaperNormalized.hyp4_24_zeroBoundedSurrogateCountermodelStatement
  | .compactEmbeddingSublevel =>
      QYM.FullCertification.PaperNormalized.lemma4_18_coerciveSublevelCompactEmbeddingStatement ∧
        QYM.FullCertification.PaperNormalized.lemma4_18_coercivityAloneNoGoStatement

theorem evidenceSound (evidence : EvidenceId) : EvidenceStatement evidence := by
  cases evidence with
  | linearPMapClosureBoundary =>
      exact
        QYM.FullCertification.PaperNormalized.lemma4_13_linearPMapClosureBoundaryStatement_holds
  | linearPMapAdjointBoundary =>
      exact
        QYM.FullCertification.PaperNormalized.lemma4_13_adjointDomainBoundaryStatement_holds
  | denseSymmetricBoundary =>
