/-!
# Abstract real quadratic-form sign algebra

This module isolates the order algebra used when a real form is written as a kinetic part plus a
perturbation, or as the negative of a kinetic part plus a perturbation.  Every hypothesis is an
explicit inequality for a displayed function.  In particular, the unbounded-below theorem assumes
an explicit normalized test sequence, arbitrarily large kinetic values along that sequence, and an
explicit upper bound for the perturbation.

These statements do not construct a Hilbert space, a closed or closable form, a Friedrichs
extension, a KLMN perturbation, a self-adjoint operator, compact resolvent, or spectral data.  They
are unconditional logical consequences of the quantified real inequalities appearing in their
statements.
-/

namespace QYM.AbstractFormSign

variable {State : Type*}

/-! ## Transparent bound predicates -/

/-- `c` is a lower bound for `energy` relative to the displayed squared-size function. -/
def FormLowerBoundBy (normSq energy : State → ℝ) (c : ℝ) : Prop :=
  ∀ x : State, c * normSq x ≤ energy x

/-- `c` is an upper bound for `energy` relative to the displayed squared-size function. -/
def FormUpperBoundBy (normSq energy : State → ℝ) (c : ℝ) : Prop :=
  ∀ x : State, energy x ≤ c * normSq x

/-- Existence of a lower form bound relative to the displayed squared-size function. -/
def HasFormLowerBound (normSq energy : State → ℝ) : Prop :=
  ∃ c : ℝ, FormLowerBoundBy normSq energy c

/-- Existence of an upper form bound relative to the displayed squared-size function. -/
def HasFormUpperBound (normSq energy : State → ℝ) : Prop :=
  ∃ c : ℝ, FormUpperBoundBy normSq energy c

/-- A two-sided absolute form bound with an explicitly displayed constant. -/
def FormAbsBoundBy (normSq energy : State → ℝ) (c : ℝ) : Prop :=
  ∀ x : State, |energy x| ≤ c * normSq x

/-- Pointwise sum of a kinetic form and a perturbation form. -/
def plusForm (kinetic potential : State → ℝ) (x : State) : ℝ :=
  kinetic x + potential x

/-- Pointwise form with the opposite kinetic sign. -/
def wrongSignForm (kinetic potential : State → ℝ) (x : State) : ℝ :=
  -kinetic x + potential x

theorem formLowerBoundBy_of_absBoundBy
    {normSq energy : State → ℝ} {c : ℝ}
    (habs : FormAbsBoundBy normSq energy c) :
    FormLowerBoundBy normSq energy (-c) := by
  unfold FormAbsBoundBy at habs
  unfold FormLowerBoundBy
  intro x
  have hlower := (abs_le.mp (habs x)).1
  simpa only [neg_mul] using hlower

theorem formUpperBoundBy_of_absBoundBy
    {normSq energy : State → ℝ} {c : ℝ}
    (habs : FormAbsBoundBy normSq energy c) :
    FormUpperBoundBy normSq energy c := by
  unfold FormAbsBoundBy at habs
  unfold FormUpperBoundBy
  intro x
  exact (abs_le.mp (habs x)).2

/-! ## Addition of explicitly bounded components -/

/-- Explicit component lower bounds add for the pointwise sum form. -/
theorem plusForm_lowerBoundBy
    {normSq kinetic potential : State → ℝ} {kineticBound potentialBound : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic kineticBound)
    (hpotential : FormLowerBoundBy normSq potential potentialBound) :
    FormLowerBoundBy normSq (plusForm kinetic potential) (kineticBound + potentialBound) := by
  unfold FormLowerBoundBy at hkinetic hpotential ⊢
  intro x
  unfold plusForm
  calc
    (kineticBound + potentialBound) * normSq x =
        kineticBound * normSq x + potentialBound * normSq x := by ring
    _ ≤ kinetic x + potential x := add_le_add (hkinetic x) (hpotential x)

/-- Explicit component upper bounds add for the pointwise sum form. -/
theorem plusForm_upperBoundBy
    {normSq kinetic potential : State → ℝ} {kineticBound potentialBound : ℝ}
    (hkinetic : FormUpperBoundBy normSq kinetic kineticBound)
    (hpotential : FormUpperBoundBy normSq potential potentialBound) :
    FormUpperBoundBy normSq (plusForm kinetic potential) (kineticBound + potentialBound) := by
  unfold FormUpperBoundBy at hkinetic hpotential ⊢
  intro x
  unfold plusForm
  calc
    kinetic x + potential x ≤
        kineticBound * normSq x + potentialBound * normSq x :=
      add_le_add (hkinetic x) (hpotential x)
    _ = (kineticBound + potentialBound) * normSq x := by ring

/-- Existential lower bounds are preserved by pointwise addition, with their witnesses added. -/
theorem plusForm_hasFormLowerBound
    {normSq kinetic potential : State → ℝ}
    (hkinetic : HasFormLowerBound normSq kinetic)
    (hpotential : HasFormLowerBound normSq potential) :
    HasFormLowerBound normSq (plusForm kinetic potential) := by
  rcases hkinetic with ⟨kineticBound, hkinetic⟩
  rcases hpotential with ⟨potentialBound, hpotential⟩
  exact ⟨kineticBound + potentialBound, plusForm_lowerBoundBy hkinetic hpotential⟩

/-- A kinetic lower bound `a` and a perturbation lower bound `-b` give the sum the lower bound
`a - b`. -/
theorem plusForm_lowerBoundBy_of_negativePerturbation
    {normSq kinetic potential : State → ℝ} {a b : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic a)
    (hpotential : FormLowerBoundBy normSq potential (-b)) :
    FormLowerBoundBy normSq (plusForm kinetic potential) (a - b) := by
  simpa only [sub_eq_add_neg] using
    (plusForm_lowerBoundBy
      (normSq := normSq) (kinetic := kinetic) (potential := potential)
      hkinetic hpotential)

/-- An absolute perturbation bound supplies the negative perturbation bound needed above. -/
theorem plusForm_lowerBoundBy_of_absPerturbation
    {normSq kinetic potential : State → ℝ} {a b : ℝ}
    (hkinetic : FormLowerBoundBy normSq kinetic a)
    (hpotential : FormAbsBoundBy normSq potential b) :
    FormLowerBoundBy normSq (plusForm kinetic potential) (a - b) := by
  exact plusForm_lowerBoundBy_of_negativePerturbation hkinetic
    (formLowerBoundBy_of_absBoundBy hpotential)

/-! ## An explicit normalized sequence detects the wrong kinetic sign -/

/-- Every member of the displayed sequence has squared size exactly one. -/
def IsUnitSequence (normSq : State → ℝ) (u : ℕ → State) : Prop :=
  ∀ n : ℕ, normSq (u n) = 1

/-- The displayed form takes values above every real threshold along the sequence. -/
def ArbitrarilyLargeAlong (energy : State → ℝ) (u : ℕ → State) : Prop :=
  ∀ threshold : ℝ, ∃ n : ℕ, threshold < energy (u n)

/-- The displayed form is bounded above by a scalar along the sequence. -/
def BoundedAboveAlong (energy : State → ℝ) (u : ℕ → State) (bound : ℝ) : Prop :=
  ∀ n : ℕ, energy (u n) ≤ bound

/-- A relative form upper bound becomes an ordinary scalar bound on a unit sequence. -/
theorem boundedAboveAlong_of_formUpperBoundBy_of_unitSequence
    {normSq energy : State → ℝ} {u : ℕ → State} {bound : ℝ}
    (hupper : FormUpperBoundBy normSq energy bound)
    (hunit : IsUnitSequence normSq u) :
    BoundedAboveAlong energy u bound := by
  unfold FormUpperBoundBy at hupper
  unfold IsUnitSequence at hunit
  unfold BoundedAboveAlong
  intro n
  simpa [hunit n] using hupper (u n)

/-- Arbitrarily large kinetic values and an upper-bounded perturbation produce wrong-sign values
below every prescribed real level. -/
theorem exists_wrongSignForm_lt_of_arbitrarilyLargeAlong
    {kinetic potential : State → ℝ} {u : ℕ → State} {bound : ℝ}
    (hkinetic : ArbitrarilyLargeAlong kinetic u)
    (hpotential : BoundedAboveAlong potential u bound)
    (level : ℝ) :
    ∃ n : ℕ, wrongSignForm kinetic potential (u n) < level := by
  obtain ⟨n, hlarge⟩ := hkinetic (bound - level)
  refine ⟨n, ?_⟩
  unfold wrongSignForm
  have hupper := hpotential n
  linarith

/-- A normalized sequence with arbitrarily large kinetic energy and upper-bounded perturbation
rules out every form lower bound for the wrong-sign sum. -/
theorem wrongSignForm_not_hasFormLowerBound_of_unitSequence
    {normSq kinetic potential : State → ℝ} {u : ℕ → State} {bound : ℝ}
    (hunit : IsUnitSequence normSq u)
    (hkinetic : ArbitrarilyLargeAlong kinetic u)
    (hpotential : BoundedAboveAlong potential u bound) :
    ¬ HasFormLowerBound normSq (wrongSignForm kinetic potential) := by
  intro hlower
  rcases hlower with ⟨lowerBound, hlower⟩
  obtain ⟨n, hbelow⟩ :=
    exists_wrongSignForm_lt_of_arbitrarilyLargeAlong hkinetic hpotential lowerBound
  have hlowerAtUnit := hlower (u n)
  have hnorm : normSq (u n) = 1 := hunit n
  rw [hnorm, mul_one] at hlowerAtUnit
  exact (not_lt_of_ge hlowerAtUnit) hbelow

/-- The same obstruction when the perturbation is globally upper-bounded relative to the
squared-size function. -/
theorem wrongSignForm_not_hasFormLowerBound_of_formUpperBoundBy
    {normSq kinetic potential : State → ℝ} {u : ℕ → State} {bound : ℝ}
    (hunit : IsUnitSequence normSq u)
    (hkinetic : ArbitrarilyLargeAlong kinetic u)
    (hpotential : FormUpperBoundBy normSq potential bound) :
    ¬ HasFormLowerBound normSq (wrongSignForm kinetic potential) := by
  exact wrongSignForm_not_hasFormLowerBound_of_unitSequence hunit hkinetic
    (boundedAboveAlong_of_formUpperBoundBy_of_unitSequence hpotential hunit)

end QYM.AbstractFormSign

/-!
## Bridge to the finite-support diagonal model

The following declarations merely identify the generic bound predicate with the already explicit
finite-support predicate and expose its standard basis as a unit, high-kinetic sequence.  They do
not add any completion or operator-theoretic structure to that model.
-/

namespace QYM.FinsuppDiagonalQuadraticForm

/-- The finite-support lower-bound predicate is definitionally the abstract predicate specialized
to its displayed squared norm. -/
theorem hasFormLowerBound_iff_abstract (energy : State → ℝ) :
    HasFormLowerBound energy ↔
      QYM.AbstractFormSign.HasFormLowerBound normSq energy := Iff.rfl

/-- The standard finite-support basis is a unit sequence for the explicit squared norm. -/
theorem basis_isAbstractUnitSequence :
    QYM.AbstractFormSign.IsUnitSequence normSq basis := by
  intro n
  exact normSq_basis n

/-- The positive diagonal kinetic form, obtained by setting the potential to zero, is arbitrarily
large on the standard basis. -/
theorem correctedZero_arbitrarilyLargeAlong_basis :
    QYM.AbstractFormSign.ArbitrarilyLargeAlong
      (correctedEnergy (fun _ => 0)) basis := by
  intro threshold
  obtain ⟨n, hn⟩ := exists_nat_gt threshold
  refine ⟨n, ?_⟩
  simpa using hn

/-- The zero perturbation has relative upper bound zero. -/
theorem zeroForm_abstractUpperBoundBy :
    QYM.AbstractFormSign.FormUpperBoundBy normSq (fun _ : State => 0) 0 := by
  intro x
  simp

/-- Direct specialization of the abstract wrong-sign theorem to the finite-support carrier and
its standard basis. -/
theorem abstractNegativeCorrectedZero_not_hasFormLowerBound :
    ¬ QYM.AbstractFormSign.HasFormLowerBound normSq
      (QYM.AbstractFormSign.wrongSignForm
        (correctedEnergy (fun _ => 0)) (fun _ : State => 0)) := by
  exact QYM.AbstractFormSign.wrongSignForm_not_hasFormLowerBound_of_formUpperBoundBy
    basis_isAbstractUnitSequence correctedZero_arbitrarilyLargeAlong_basis
    zeroForm_abstractUpperBoundBy

/-- Existing wrong-sign finite-support certificates transfer without changing their proposition. -/
theorem wrongSignEnergy_abstract_not_hasFormLowerBound_of_potential_boundedAbove
    (v : ℕ → ℝ) (M : ℝ) (hv : ∀ n, v n ≤ M) :
    ¬ QYM.AbstractFormSign.HasFormLowerBound normSq (wrongSignEnergy v) := by
  intro habstract
  have hconcrete : HasFormLowerBound (wrongSignEnergy v) :=
    (hasFormLowerBound_iff_abstract (wrongSignEnergy v)).mpr habstract
  exact (wrongSignEnergy_not_hasFormLowerBound_of_potential_boundedAbove v M hv) hconcrete

/-- Existing corrected-sign finite-support certificates transfer to the abstract predicate. -/
theorem correctedEnergy_abstract_hasFormLowerBound_of_potential_boundedBelow
    (v : ℕ → ℝ) (m : ℝ) (hv : ∀ n, m ≤ v n) :
    QYM.AbstractFormSign.HasFormLowerBound normSq (correctedEnergy v) := by
  exact (hasFormLowerBound_iff_abstract (correctedEnergy v)).mp
    (correctedEnergy_hasFormLowerBound_of_potential_boundedBelow v m hv)

end QYM.FinsuppDiagonalQuadraticForm




/-!
# Ground multiplicity and the first off-ground gap

This concrete self-contained `Fin 3` diagonal model separates the adjacent-index gap from the
first gap outside a ground-state block.  Two independent basis vectors have eigenvalue zero and a
third has eigenvalue one.  Thus the complement level is separated by one while `lambda₁ - lambda₀ = 0`.

The model is finite and algebraic.  It refutes only the index inference that ignores ground
multiplicity; it does not construct the paper's continuum Hamiltonian.
-/

namespace QYM.SpectralFlowCore.GroundMultiplicityCounterexample

abbrev Vec3 := Fin 3 → ℝ

/-- Diagonal eigenvalue list `(0,0,1)`. -/
def eigenvalue (i : Fin 3) : ℝ :=
  if i = 2 then 1 else 0

/-- Concrete diagonal linear map with a two-dimensional zero eigenspace. -/
def hamiltonian : Vec3 →ₗ[ℝ] Vec3 where
  toFun x i := eigenvalue i * x i
  map_add' x y := by
    funext i
    simp [mul_add]
  map_smul' c x := by
    funext i
    simp
    ring

/-- Coordinate basis vector. -/
def basis (k : Fin 3) : Vec3 :=
  fun i => if i = k then 1 else 0

theorem basis_ne_zero (k : Fin 3) : basis k ≠ 0 := by
  intro hzero
  have hk := congrFun hzero k
  simp [basis] at hk

/-- Every coordinate basis vector is an exact eigenvector. -/
theorem hamiltonian_basis (k : Fin 3) :
    hamiltonian (basis k) = eigenvalue k • basis k := by
  funext i
  by_cases hik : i = k
  · subst i
    simp [hamiltonian, basis]
  · simp [hamiltonian, basis, hik]

@[simp]
theorem eigenvalue_zero : eigenvalue 0 = 0 := by
  have h : (0 : Fin 3) ≠ 2 := by decide
  simp only [eigenvalue, if_neg h]

@[simp]
theorem eigenvalue_one : eigenvalue 1 = 0 := by
  have h : (1 : Fin 3) ≠ 2 := by decide
  simp only [eigenvalue, if_neg h]

@[simp]
theorem eigenvalue_two : eigenvalue 2 = 1 := by
  norm_num [eigenvalue]

theorem basis_zero_eigenpair :
    basis 0 ≠ 0 ∧ hamiltonian (basis 0) = (0 : ℝ) • basis 0 := by
  exact ⟨basis_ne_zero 0, by simpa using hamiltonian_basis 0⟩

theorem basis_one_eigenpair :
    basis 1 ≠ 0 ∧ hamiltonian (basis 1) = (0 : ℝ) • basis 1 := by
  exact ⟨basis_ne_zero 1, by simpa using hamiltonian_basis 1⟩

theorem basis_two_eigenpair :
    basis 2 ≠ 0 ∧ hamiltonian (basis 2) = (1 : ℝ) • basis 2 := by
  exact ⟨basis_ne_zero 2, by simpa using hamiltonian_basis 2⟩

/-- The first two enumerated levels have zero adjacent gap. -/
theorem adjacent_ground_gap_zero : eigenvalue 1 - eigenvalue 0 = 0 := by
  norm_num

theorem adjacent_ground_gap_not_pos : ¬ 0 < eigenvalue 1 - eigenvalue 0 := by
  rw [adjacent_ground_gap_zero]
  norm_num

/-- Ground-block membership consists of the first two indices. -/
def IsGroundIndex (i : Fin 3) : Prop := i ≠ 2

theorem zero_isGround : IsGroundIndex 0 := by
  change (0 : Fin 3) ≠ 2
  decide

theorem one_isGround : IsGroundIndex 1 := by
  change (1 : Fin 3) ≠ 2
  decide

theorem two_not_isGround : ¬ IsGroundIndex 2 := by
  simp [IsGroundIndex]

theorem eigenvalue_eq_zero_of_isGround
    (i : Fin 3) (hi : IsGroundIndex i) : eigenvalue i = 0 := by
  change i ≠ (2 : Fin 3) at hi
  simp only [eigenvalue, if_neg hi]

theorem eigenvalue_ge_one_of_not_isGround
    (i : Fin 3) (hi : ¬ IsGroundIndex i) :
    (1 : ℝ) ≤ eigenvalue i := by
  have hi2 : i = 2 := by
    by_contra hne
    exact hi hne
  subst i
  norm_num

/-- The first level outside the ground block is separated from either ground basis level by one. -/
theorem first_offGround_gap : eigenvalue 2 - eigenvalue 0 = 1 := by
  norm_num

/-- Complement separation by one does not imply a unit adjacent-index gap when the ground block
has multiplicity two. -/
theorem complement_separation_does_not_imply_adjacent_gap :
    (∀ i : Fin 3, IsGroundIndex i → eigenvalue i = 0) ∧
      (∀ i : Fin 3, ¬ IsGroundIndex i → (1 : ℝ) ≤ eigenvalue i) ∧
      ¬ (1 : ℝ) ≤ eigenvalue 1 - eigenvalue 0 := by
  refine ⟨eigenvalue_eq_zero_of_isGround,
    eigenvalue_ge_one_of_not_isGround, ?_⟩
  rw [adjacent_ground_gap_zero]
  norm_num

/-- Corrected indexing: compare a marked ground index with a marked off-ground index. -/
theorem corrected_gap_to_first_offGround :
    (1 : ℝ) ≤ eigenvalue 2 - eigenvalue 0 := by
  rw [first_offGround_gap]

end QYM.SpectralFlowCore.GroundMultiplicityCounterexample




