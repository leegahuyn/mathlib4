/-! ## 3. Exact ground and level-one eigenspaces -/

/-- The bounded surrogate vanishes precisely on the complete distinguished
inverse-eta line. -/
theorem actualInverseEtaProjectionHamiltonian_eq_zero_iff
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y} :
    actualInverseEtaProjectionHamiltonian hY u = 0 ↔
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y := by
  constructor
  · intro hu
    rw [actualInverseEtaProjectionHamiltonian_apply] at hu
    have hEq : u = actualPaperRangeInverseEtaProjection hY u :=
      sub_eq_zero.mp hu
    have hpMem : actualPaperRangeInverseEtaProjection hY u ∈
        QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y := by
      rw [← actualPaperRangeInverseEtaProjection_range hY]
      exact ⟨u, rfl⟩
    rw [hEq]
    exact hpMem
  · intro hu
    rw [actualInverseEtaProjectionHamiltonian_apply,
      actualPaperRangeInverseEtaProjection_eq_self_of_mem_line hY hu,
      sub_self]

/-- The kernel is the full ground block, with no simplicity premise. -/
theorem actualInverseEtaProjectionHamiltonian_ker
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).toLinearMap.ker =
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestLine Y := by
  ext u
  rw [LinearMap.mem_ker]
  exact actualInverseEtaProjectionHamiltonian_eq_zero_iff hY

/-- Being fixed by `Hproj_Y` is equivalent to belonging to the entire
off-test subspace. -/
theorem actualInverseEtaProjectionHamiltonian_eq_self_iff
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y)
    {u : QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaTestSpace Y} :
    actualInverseEtaProjectionHamiltonian hY u = u ↔
      u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y := by
  constructor
  · intro hu
    rw [actualInverseEtaProjectionHamiltonian_apply] at hu
    have hpZero : actualPaperRangeInverseEtaProjection hY u = 0 :=
      sub_eq_self.mp hu
    exact (actualPaperRangeInverseEtaProjection_eq_zero_iff hY).1 hpZero
  · exact actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY

/-- The range is the complete off-test block. -/
theorem actualInverseEtaProjectionHamiltonian_range
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY).toLinearMap.range =
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y := by
  apply le_antisymm
  · rintro u ⟨v, rfl⟩
    exact actualInverseEtaProjectionHamiltonian_apply_mem_offTest hY v
  · intro u hu
    exact ⟨u,
      actualInverseEtaProjectionHamiltonian_eq_self_of_mem_offTest hY hu⟩

/-- The complete level-one eigenspace, expressed without choosing or
enumerating eigenvectors, is the full off-test subspace. -/
theorem actualInverseEtaProjectionHamiltonian_levelOneEigenspace
    {Y : ℝ} (hY : 2 ≤ Mock2FA.PaperCorrections.AutomorphicSobolev.GammaTwoQuotientGeometry.gammaTwoCuspLevel Y) :
    (actualInverseEtaProjectionHamiltonian hY - 1).toLinearMap.ker =
      QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y := by
  ext u
  rw [LinearMap.mem_ker]
  change actualInverseEtaProjectionHamiltonian hY u - u = 0 ↔
    u ∈ QYM.FullCertification.P12ActualInverseEtaTestOperatorExtension.ActualInverseEtaOffTestSubspace Y
  rw [sub_eq_zero]
  exact actualInverseEtaProjectionHamiltonian_eq_self_iff hY

